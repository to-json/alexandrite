# A `case` or `if` whose value isn't used is a statement: its arms may be
# of different types. Used as a value, they must agree.
struct Reminders { now: Str, hints: [Str], count: Int }

def word(line: Str) -> Str { line.split(" ")[0] }

def read(lines: [Str]) -> Reminders {
  r = Reminders.new(now: "", hints: [], count: 0)
  lines.each { |line|
    v = line.split(" ")[1]
    case word(line) {
      "now" => r.now = v           # Str
      "hint" => r.hints << v       # nil
      "count" => r.count += v.to_i # Int
      _ => {}
    }
  }
  r
}

r = read(["now tea", "hint cups", "count 2", "hint pot", "noise x", "count 3"])
puts r.now
puts r.hints
puts r.count

# In a loop, not last; with nested statements in an arm.
log: [Str] = []
i = 0
while i < 4 {
  case i % 3 {
    0 => log << "zero"
    1 => {
      case i {
        1 => log << "one"
        _ => i += 0
      }
      i * 10
    }
    _ => "ignored"
  }
  i += 1
}
puts log

# `if` / `elsif` chains as statements.
n = 0
names: [Str] = []
[1, 5, 12].each { |x|
  if x > 10 {
    n += x
  } elsif x > 3 {
    names << "mid #{x}"
  } else {
    "small"
  }
}
puts n
puts names

# Used as values, arms and branches agree.
def size_of(x: Int) -> Str {
  case x {
    0 => "none"
    1 | 2 => "few"
    _ => "many"
  }
}
puts size_of(2)
label = if n > 5 { "big" } else { "small" }
puts label
k = case {
  n > 100 => 1
  _ => 2
}
puts k

# A def without a declared return type: a trailing `if` or `case` whose
# arms disagree is a statement, and the def returns nothing.
struct Buf { data: [Int], off: Int }
def reset(b: Buf, n: Int) {
  if n == 0 { b.data[0] = 0 } else { b.off += n }
}
def note(x: Int) {
  case x {
    0 => puts "zero"
    _ => x * 2
  }
}
buf = Buf.new(data: [7], off: 0)
reset(buf, 0)
puts buf.data
note(0)
note(4)
