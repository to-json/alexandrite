# #[derive(Asn1)] (D59): Go's encoding/asn1 struct tags as field attributes.
import "encoding/asn1"
import "encoding/hex"
import "math/big"
import "time"

#[derive(Asn1)]
struct AlgorithmIdentifier {
  algorithm: asn1.ObjectIdentifier
  #[field(asn1: "optional")] parameters: asn1.RawValue
}

#[derive(Asn1)]
#[asn1(set)]
struct Names {
  names: [Str]
}

#[derive(Asn1)]
struct Record {
  #[field(asn1: "optional,explicit,default:0,tag:0")] version: Int
  serial: big.Int
  alg: AlgorithmIdentifier
  #[field(asn1: "ia5")] email: Str
  when: time.Time
  #[field(asn1: "tag:1,optional")] flags: asn1.BitString
  names: Names
  #[field(asn1: "explicit,tag:2")] note: Str?
  #[field(asn1: "flag,tag:3,optional")] critical: Bool
  small: I32
}

r = Record.new(
  version: 2,
  serial: big.new_int(-1234567890123),
  alg: AlgorithmIdentifier.new(algorithm: asn1.oid([1, 2, 840, 113549, 1, 1, 11]), parameters: asn1.null_raw_value()),
  email: "a@example.com",
  when: time.date(2024, 2, 29, 12, 30, 0, 0, time.utc()),
  flags: asn1.BitString.new(bytes: [0xa0], bit_length: 3),
  names: Names.new(names: ["b", "aa", "zz"]),
  note: "hi",
  critical: true,
  small: -7
)
der = r.to_asn1.unwrap
puts hex.encode_to_string(der)
back, rest = Record.from_asn1(der).unwrap
puts rest.size
puts back.version
puts back.serial
puts back.alg.algorithm
puts back.email
puts back.when
puts "#{back.flags.at(0)}#{back.flags.at(1)}#{back.flags.at(2)}"
puts back.names.names
puts back.note || "-"
puts back.critical
puts back.small
puts back.to_asn1.unwrap == der ? "round trip" : "differs"

# The version is omitted when it is the default; the note when none.
r.version = 0
r.note = none
r.critical = false
d2 = r.to_asn1.unwrap
puts hex.encode_to_string(d2)
puts Record.from_asn1(d2).unwrap[0].note.none?

# Errors are Go's.
e = Record.from_asn1(hex.decode_string("3003020101").unwrap)
puts e.err?.message || ""
puts asn1.marshal_str_with_params("é", "ia5").err?.message || ""
