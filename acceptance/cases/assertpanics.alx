# S4: `assert_panics { ... }` runs the block as a task and fails unless it
# panicked; `assert_panics("part") { ... }` also needs the panic message to
# contain "part". A failure panics with the location, like `assert_eq`.

def at(xs: [Int], i: Int) -> Int { xs[i] }

def checked_div(a: Int, b: Int) -> Int {
  panic("divide by zero: #{a} / #{b}") if b == 0
  a / b
}

xs = [1, 2, 3]
assert_panics { at(xs, 5) }
assert_panics("index out of bounds") { at(xs, 3) }
assert_panics("divide by zero: 7 / 0") { checked_div(7, 0) }
assert_panics { panic("plain") }
# The same slice works in the next assertion (the task is over by then).
assert_panics { at(xs, -1) }
puts "passed"

# The block gets copies of the locals it uses (spawn's rules): assigning
# one doesn't reach the caller; element writes through a slice do.
n = 1
assert_panics {
  n += 1
  xs[0] = 9
  at(xs, n + 10)
}
puts n
puts xs[0]

# A panicking task inside releases its locks as usual.
mu = Mutex.new(0)
assert_panics("Mutex poisoned") {
  assert_panics { mu.lock { |v| at([], v) } }
  mu.lock { |v| v }
}
puts mu.poisoned?

# Failures (each in a task, so its panic becomes the task's error).
t1 = spawn {
  assert_panics { at([1], 0) }
  0
}
puts t1.wait.err
t2 = spawn {
  assert_panics("division") { at([1], 7) }
  0
}
puts t2.wait.err
