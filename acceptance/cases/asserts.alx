# M8: assert and assert_eq. A failure panics with the condition's source text
# (or both values) and the location; a panic ends only its task.

def check(n: Int) -> Int {
  assert n > 0
  n
}

puts check(2)
assert_eq check(1) + 1, 2

t = spawn { check(-1) }
puts t.wait.err

t2 = spawn {
  assert_eq check(1) + 1, 5
  0
}
puts t2.wait.err

t3 = spawn {
  assert_eq "ab", "a" + "c"
  0
}
puts t3.wait.err

t4 = spawn {
  assert_eq 2.5, 2.0 + 1.0
  0
}
puts t4.wait.err

# Output capture and the clock (what `alx test` builds on).
start = Time.now_ns
Test.begin_capture
puts "captured"
puts 42
s = Test.end_capture
puts s.size
puts Time.now_ns >= start
