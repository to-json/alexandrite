# A def without a declared return type that has a bare `return` and ends in
# an assignment returns nothing (the checker used to call the tail an Int).
struct S { n: Int }
struct T {
  st: [S]
  def trunc!(n: Int) {
    if n == 0 {
      return
    }
    self.st[0].n = n
  }
}
t = T.new(st: [S.new(n: 0)])
t.trunc!(3)
puts t.st[0].n
