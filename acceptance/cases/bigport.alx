# Language additions made for the math/big port: a package may declare its
# own Int / Float (pkgs/num), F64 names the builtin Float, `__mulhi` is the
# high word of a 128-bit product, and big.Int / big.Rat work as fields of a
# type that derives Json.
import "pkgs/num"
import "math/big"
import "encoding/json"

#[derive(Json)]
struct Account {
  name: Str
  balance: big.Int
  rate: big.Rat
}

# A source for big.Int.rand!: anything with `uint32!`, sharing its state.
struct Counter {
  st: [U32]

  def uint32! -> U32 {
    self.st[0] = st[0] *% 1664525 +% 1013904223
    st[0]
  }
}

x = num.make(21).twice
puts x
puts num.half(x)
n: Int = 7
f: F64 = 1.5
puts n + 1
puts f * 2.0
b = big.Int.new
b.set_string!("123456789012345678901234567890", 10)
a = Account.new(name: "x", balance: b, rate: big.new_rat(1, 3))
s = a.to_json.unwrap
puts s
back = Account.from_json(s).unwrap
puts back.balance.cmp(b)
puts back.rate
lim = big.Int.new
lim.lsh!(big.new_int(1), 100)
z = big.Int.new
z.rand!(Counter.new(st: [1]), lim)
puts z.bit_len <= 100
w: U64 = 0xffffffffffffffff
puts w.__mulhi(w)
