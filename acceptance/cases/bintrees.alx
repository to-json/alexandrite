# Memory benchmark: binary trees (the Benchmarks Game program, max depth 14).
# Short-lived trees churn through a pool each; one long-lived tree stays.
struct Node {
  left: @Node?
  right: @Node?
}

def make(p: Pool[Node], d: Int) -> @Node {
  return p.add(Node.new(left: none, right: none)) if d == 0
  l = make(p, d - 1)
  r = make(p, d - 1)
  p.add(Node.new(left: l, right: r))
}

def check(p: Pool[Node], h: @Node) -> Int {
  n = p[h]
  if l = n.left {
    if r = n.right {
      return 1 + check(p, l) + check(p, r)
    }
  }
  1
}

min_depth = 4
max_depth = 14
stretch = Pool[Node].new
puts "stretch tree of depth #{max_depth + 1} check: #{check(stretch, make(stretch, max_depth + 1))}"
long = Pool[Node].new
long_root = make(long, max_depth)
d = min_depth
while d <= max_depth {
  iters = 1 << (max_depth - d + min_depth)
  total = 0
  for _ in 0...iters {
    p = Pool[Node].new
    total += check(p, make(p, d))
  }
  puts "#{iters} trees of depth #{d} check: #{total}"
  d += 2
}
puts "long lived tree of depth #{max_depth} check: #{check(long, long_root)}"
