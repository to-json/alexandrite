# Str#byteindex(sub, from = 0): Ruby's String#byteindex, a byte offset or
# -1 (Ruby: nil). std/regexp uses it for its literal-prefix search.
s = "héllo wörld, hello"
puts s.byteindex("l")
puts s.byteindex("l", 4)
puts s.byteindex("hello")
puts s.byteindex("ö")
puts s.byteindex("xyz")
puts s.byteindex("")
puts s.byteindex("", 5)
puts s.byteindex("o", 100)
puts s.byteindex("h", -3)
long = "ab" * 1000 + "abc"
puts long.byteindex("abc")

# A `!` call's arguments run before the receiver is read: an argument that
# changes the receiver (here, appends to it) is seen by the call.
struct Nodes {
  xs: [Int]

  def add!(v: Int) -> Int {
    self.xs << v
    xs.size - 1
  }

  def get!(i: Int) -> Int { xs[i] }
}

n = Nodes.new(xs: [])
puts n.get!(n.add!(7))
puts n.get!(n.add!(n.get!(0) + 1))
