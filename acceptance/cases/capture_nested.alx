# A variable declared inside a lambda (or a lambda's parameter) and changed
# by a lambda nested in it lives in a cell (R5) made at the start of the
# outer lambda's body: the outer lambda is a function of its own (port-issues
# #240: the cell was made in the enclosing def, so the lambda indexed an
# empty slice).
def run(f: (Int) -> Unit) {
  f.call(5)
}

def each(xs: [Str], f: (Str) -> Unit) {
  for x in xs { f.call(x) }
}

def try_each(xs: [Str], f: (Str) -> ~Unit) -> ~Unit {
  for x in xs { ~f.call(x) }
}

run { |x|
  n = 0
  each(["a", "b", "a"]) { |_p| n += 1 }
  puts n
  m: Map[Str, Int] = {}
  each(["a", "b", "a"]) { |p| m[p] += 1 }
  puts m
  xs: [Str] = []
  each(["c", "d"]) { |p| xs << p }
  puts xs
  # The parameter's cell starts with its value.
  each(["e"]) { |_p| x += 10 }
  puts x
  # Two levels down.
  total = 0
  r = try_each(["x"]) { |_p|
    inner = 1
    each(["y", "z"]) { |_q|
      inner += 1
      total += inner
    }
  }
  puts r.ok?
  puts total
}
