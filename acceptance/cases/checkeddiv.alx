# M5: `/` and `%` under `~`: a zero divisor and MIN / -1 are ArithErrors;
# every other quotient succeeds.
MIN = -(1 << 63)
fn half(a: Int) -> ~Int { ~(a / 2) }
fn odd(a: Int) -> ~Int { ~(a % 2) }
fn half1(a: Int) -> ~Int { ~(a / 2 + 1) }
fn d(a: Int, b: Int) -> ~Int { ~(a / b) }
fn r(a: Int, b: Int) -> ~Int { ~(a % b) }
fn days(m: Int, d: Int) -> ~Int { ~((153 * m + 2) / 5 + d - 1) }
fn d8(a: U8, b: U8) -> ~U8 { ~(a / b) }
fn i8d(a: I8, b: I8) -> ~I8 { ~(a / b) }
fn i32d(a: I32, b: I32) -> ~I32 { ~(a / b + a % b) }
fn u32d(a: U32, b: U32) -> ~U32 { ~(a / b) }
fn u64d(a: U64, b: U64) -> ~U64 { ~(a % b) }
def civil(y: Int, m: Int, d: Int) -> ~Int {
  e = ~(y / 400)
  ~(e * 146097 + (153 * m + 2) / 5 + d - 719468 + y % 4)
}
def per(total: Int, n: Int) -> ~Int {
  each = ~(total / n)
  ~(each * n + total % n)
}

puts half(10).ok?
puts odd(11).unwrap
puts half1(10).err
puts half(-7).unwrap
puts d(10, 3).unwrap
puts d(-7, 2).unwrap
puts d(10, 0).err
puts d(MIN, -1).err
puts d(MIN, 1).unwrap
puts r(10, 3).unwrap
puts r(-7, 2).unwrap
puts r(10, 0).err
puts r(MIN, -1).unwrap
puts days(3, 1).unwrap
puts civil(2026, 7, 2).unwrap
puts per(100, 7).unwrap
puts per(100, 0).err
puts d8(200, 7).unwrap
puts d8(1, 0).err
puts i8d(-128, -1).err
puts i8d(-128, 2).unwrap
puts i32d(100, 7).unwrap
puts u32d(100, 0).err
puts u64d(100, 7).unwrap
