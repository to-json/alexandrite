#![overflow(promote)]
# M5: `/` and `%` under `~` on promoted Ints: only a zero divisor fails;
# MIN / -1 promotes.
MIN = -(1 << 63)
fn half(a: Int) -> ~Int { ~(a / 2) }
fn d(a: Int, b: Int) -> ~Int { ~(a / b) }
fn r(a: Int, b: Int) -> ~Int { ~(a % b) }
fn days(m: Int, d: Int) -> ~Int { ~((153 * m + 2) / 5 + d - 1) }
fn i32d(a: I32, b: I32) -> ~I32 { ~(a / b + a % b) }
fn i8d(a: I8, b: I8) -> ~I8 { ~(a / b) }
def per(total: Int, n: Int) -> ~Int {
  each = ~(total / n)
  ~(each * n + total % n)
}

puts half(10).unwrap
puts d(-7, 2).unwrap
puts d(10, 0).err
puts d(MIN, -1).unwrap
puts r(-7, 2).unwrap
puts r(10, 0).err
puts days(3, 1).unwrap
puts per(100, 7).unwrap
puts per(100, 0).err
puts i32d(100, 7).unwrap
puts i8d(-128, -1).err
