#![overflow(wrap)]
# M5: `/` and `%` under `~` in a wrap file: a zero divisor fails; MIN / -1
# wraps to MIN (as Go), like every other overflow in this file.
MIN = -(1 << 63)
fn half(a: Int) -> ~Int { ~(a / 2) }
fn d(a: Int, b: Int) -> ~Int { ~(a / b) }
fn r(a: Int, b: Int) -> ~Int { ~(a % b) }
fn days(m: Int, d: Int) -> ~Int { ~((153 * m + 2) / 5 + d - 1) }
fn i8d(a: I8, b: I8) -> ~I8 { ~(a / b) }

puts half(10).unwrap
puts d(-7, 2).unwrap
puts d(10, 0).err
puts d(MIN, -1).unwrap
puts r(MIN, -1).unwrap
puts r(10, 0).err
puts days(3, 1).unwrap
puts i8d(-128, -1).unwrap
