# R4: lambdas capture variables, not copies (Go's closures).
count = 0
inc = -> {count += 1}
inc()
inc()
inc()
puts count
def counter -> (Int) -> Int {
  n = 0
  ->(by: Int) {
    n += by
    n
  }
}
c = counter()
c(5)
puts c(10)
log = []
add = ->(s: Str) { log << s }
add("a")
add("b")
puts log
name = "before"
show = -> {"name is #{name}"}
name = "after"
puts show()
