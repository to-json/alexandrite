# M3: collections and absence.
N = 4
struct Board { cells: [Int; 3], name: Str }
struct User { name: Str, boss: Str? }
struct Inv { counts: Map[Str, Int] }

def bump(xs: [Int]) { xs[0] = 99 } # slices share storage
def bump_fixed(xs: [Int; 3]) -> Int { # fixed arrays are values
  xs[0] = 99
  xs[0]
}
def tally(m: Map[Str, Int], words: [Str]) { # maps are shared too
  for w in words { m[w] += 1 }              # a missing key reads as 0
}
def find_even(xs: [Int]) -> Int? {
  for x in xs { return x if x.even? }
  none
}
def pick(n: Int) -> Int? {
  case n {
    0 => none
    1 => 10
    _ => n * 2
  }
}

# --- slices: [T]
a = [1, 2, 3, 4, 5]
b = a
b[0] = 10
puts a[0]
bump(a)
puts a[0]
s = a[1..3]
puts s.size
s[0] = 20
puts a[1]
puts a[2..].sum
puts a[...2].size
t = a[1...1]
t << 7 # a subslice has no spare capacity: appending copies
puts a[1]
c = a.dup
c[4] = 0
puts a[4]
dst = [0, 0, 0]
puts copy(dst, a)
puts dst[2]
puts copy(a[1..], a) # overlapping: like memmove
puts a[4]

# --- fixed arrays: [T; N]
f: [Int; 3] = [1, 2, 3]
g = f
g[0] = 50
puts f[0]
puts bump_fixed(f)
puts f[0]
puts f.size
puts f.sum
z: [Int; N] = [0; N]
z[3] = 8
puts z.sum
grid: [[Int; 3]; 2] = [[0; 3]; 2]
grid[1][2] = 5
g2 = grid
g2[1][2] = 6
puts grid[1][2]
puts g2[1][2]
bd = Board.new(name: "x")
bd.cells[1] = 4
bd2 = bd
bd2.cells[1] = 9
puts bd.cells[1]
puts bd2.cells[1]
rows = [[0; 2]; 3] # each row is its own slice
rows[0][0] = 1
puts rows[1][0]
for x in f { puts x }

# --- strings: bytes and runes
str = "héllo, 世界"
puts str.size
puts str.runes.count
puts str.runes.to_a[7]
puts str[1]
byte: Byte = str[0]
puts byte
puts str[0..2] + "!"
puts str[7..]
bs: [Byte] = [104, 105]
bs << 33
puts Str.from_bytes(bs)
raw = str.bytes.to_a
raw[0] = 72
puts Str.from_bytes(raw[0..4])

# --- maps: Map[K, V], in insertion order
ages = {"ada" => 36, "bob" => 25}
ages["cy"] = 41
puts ages.size
puts ages
if age = ages["bob"] { puts "bob is #{age}" }
puts ages["zed"] || -1
puts ages.key?("cy")
puts ages.delete("bob")
puts ages.delete("bob")
ages["bob"] = 26
puts ages
puts ages.keys.size
puts ages.values.sum
counts: Map[Str, Int] = {}
tally(counts, "the cat and the hat and the bat".split(" "))
puts counts
for k, v in counts { puts "#{k}: #{v}" if v > 1 }
puts counts.select { |k, v| v == 1 }.count
puts counts.fetch("nope", 7)
sq = {}
(1..1000).each { sq[it] = it * it }
(1..1000).each { sq.delete(it) if it % 3 != 0 }
puts sq.size
puts sq[999] || 0
puts sq[998] || 0
cp = counts.dup
cp["zebra"] = 1
puts counts.key?("zebra")
inv = Inv.new
inv.counts["x"] += 2
puts inv.counts
flags = {on: true, off: false}
puts flags

# --- absence: T?
u = User.new(name: "ada")
v = User.new(name: "bob", boss: "ada")
puts u.boss || "nobody"
puts v.boss?.size || 0
if e = find_even([3, 5, 8, 9]) { puts "found #{e}" }
puts find_even([1, 3]).none?
puts find_even([7]).unwrap_or(-1)
puts [3, 8, 5, 12].find { it > 4 }
puts [3, 8].find { it > 100 }
puts pick(0)
puts pick(5)
