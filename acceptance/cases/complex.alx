# Complex numbers (D53): Go's complex128 as the builtin `Complex`.
# Every line matches Go's fmt.Println output for the same program.

def bits(x: Float) -> U64 { x.__bits }

# A value with each part's sign visible.
def show(c: Complex) -> Str {
  "#{c} #{bits(c.real) >> 63}#{bits(c.imag) >> 63}"
}

struct Pole {
  name: Str
  at: Complex
}

def mandel(c: Complex, limit: Int) -> Int {
  z = Complex.new(0, 0)
  n = 0
  while n < limit && z.real * z.real + z.imag * z.imag <= 4.0 {
    z = z * z + c
    n += 1
  }
  n
}

def sum(xs: [Complex]) -> Complex {
  s: Complex = 0
  for x in xs { s = s + x }
  s
}

one = 1.0
zero = 0.0
inf = one / zero
nan = inf - inf

# Literals and constants.
a = 1 + 2i
b = Complex.new(3.0, -4.0)
puts a
puts b
puts 2i
puts -2i
puts 1.5e3i
puts 0i
puts a.real
puts a.imag

# Arithmetic.
puts a + b
puts a - b
puts a * b
puts a / b
puts -a
puts a * 2
puts 2 * a
puts a + 1
puts 1 - a
puts a / 2
puts 1 / a
puts a * 1i

# Equality: both parts, IEEE (NaN != NaN, -0 == 0).
puts a == 1 + 2i
puts a != b
puts a == 1
puts Complex.new(nan, 0) == Complex.new(nan, 0)
puts Complex.new(-zero, 0) == Complex.new(zero, 0)

# Go's division: Smith's algorithm and C99's infinity fixups.
puts a / Complex.new(0, 0)
puts Complex.new(0, 0) / Complex.new(0, 0)
puts Complex.new(inf, 1) / Complex.new(2, 3)
puts Complex.new(1, inf) / Complex.new(2, 3)
puts Complex.new(2, 3) / Complex.new(inf, 1)
puts Complex.new(2, 3) / Complex.new(-inf, inf)
puts Complex.new(nan, 1) / Complex.new(2, 3)
puts Complex.new(1e300, 1e300) / Complex.new(1e-300, 1e-300)
puts Complex.new(1, 1) / Complex.new(1e308, 1e308)
puts Complex.new(-1, 0) / Complex.new(0, 0)

# Multiplication is the plain formula (no recovery of infinities).
puts Complex.new(inf, 0) * Complex.new(1, 1)
puts Complex.new(1, inf) * 2

# Signs of zero.
puts show(-Complex.new(0, 0))
puts show(Complex.new(-zero, -zero) + Complex.new(0, 0))
puts show(Complex.new(0, 0) * Complex.new(-1, 0))

# Printing special values (fmt's %v).
puts Complex.new(inf, -inf)
puts Complex.new(-inf, nan)
puts Complex.new(nan, nan)
puts Complex.new(1e21, 1e-7)
puts Complex.new(-zero, -zero)
puts "z = #{Complex.new(0.5, -0.25)}"
puts format("%v and %v", a, [a, b])

# Complex in data structures and functions.
xs = [1 + 1i, 2.5i, 3]
puts xs
puts sum(xs)
p = Pole.new(name: "p", at: -1 - 1i)
puts p
puts p.at.imag
m: Map[Str, Complex] = {}
m["i"] = 1i
v = m["i"] || 0
m["i"] = v * v
puts m
t = (a, 2i)
puts t[0] * t[1]
puts mandel(Complex.new(-0.75, 0.1), 1000)
puts mandel(Complex.new(0.3, 0.5), 1000)
