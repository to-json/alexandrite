# M7: tasks and channels. spawn, wait, Chan, select; a panic ends only its task.

def produce(ch: Chan[Int], n: Int) {
  (1..n).each { ch << it }
  ch.close
}

# A pipeline: producer -> squarer -> main.
nums = Chan[Int].new(4)
squares = Chan[Int].new
spawn produce(nums, 10)
sq = spawn {
  for v in nums { squares << v * v }
  squares.close
  "squarer done"
}
total = 0
for s in squares { total += s }
puts total
puts sq.wait.unwrap

# Worker pool: results come back in any order; sum them.
jobs = Chan[Int].new(100)
results = Chan[Int].new(100)
(1..100).each { jobs << it }
jobs.close
workers = (1..4).map { |w|
  spawn {
    n = 0
    for j in jobs {
      results << j * w
      n += 1
    }
    n
  }
}.to_a
handled = workers.sum { it.wait.unwrap }
results.close
puts handled
puts results.count > 0

# A panic ends only its task; wait reports it.
bad = spawn {
  xs = [1, 2, 3]
  xs[7]
}
r = bad.wait
puts r.ok?
if e = r.err { puts e }

# Errors inside a task come back through wait.
def check(n: Int) -> ~Int {
  fail "negative: #{n}" if n < 0
  n
}
t = spawn { ~check(-5) }
puts t.wait.err

# select: ready cases, default, closed channels.
a = Chan[Str].new(1)
b = Chan[Str].new(1)
b << "from b"
select {
  when v = a.recv => puts "a: #{v}"
  when v = b.recv => puts "b: #{v}"
}
select {
  when v = a.recv => puts "a: #{v}"
  else => puts "nothing ready"
}
a.close
select {
  when v = a.recv => puts "a closed: #{v}"
}
out = Chan[Int].new(1)
select {
  when out.send(42) => puts "sent"
}
puts out.recv
