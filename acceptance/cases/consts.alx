# Array constants: literals of constants, slices and fixed arrays, nested,
# exported. Each use as a value is a fresh array, so nothing changes a
# constant; reading an element (`C[i]`) reads it in place.
import "pkgs/cal"

PRIMES = [2, 3, 5, 7, 11]
SCALE = [1, 2.5, 4] # an Int among Floats is a Float
GRID = [[1, 2, 3], [4, 5, 6]]
WIDTH = 3
ROW = [WIDTH, WIDTH * 2, 1 << WIDTH] # other constants and operators
EMPTY: [Str] = []
ZEROS = [0; 4]
SMALL: [I32; 3] = [-1, 0, 1]
FLAGS = [true, false]

def nth_prime(i: Int) -> Int { PRIMES[i] }

# Reads in a loop: in place, nothing allocated per lookup.
total = 0
(0...1000).each { |i| total += nth_prime(i % 5) + GRID[i % 2][i % 3] }
puts total

# A copy is the program's own: changing it leaves the constant alone.
xs = PRIMES
xs[0] = 100
xs << 13
puts xs
puts PRIMES
row = GRID[1]
row[0] = 40
puts GRID
def bump(a: [Int]) { a[0] += 1 }
bump(PRIMES)
puts PRIMES[0]

puts PRIMES.size
puts PRIMES.sum
puts PRIMES.select { it > 4 }
puts SCALE
puts ROW
puts EMPTY.size
puts ZEROS
puts SMALL[0] * 2
puts FLAGS[1]
for p in PRIMES {
  puts p if p > 6
}

# From a package.
puts cal.name(3)
puts cal.MONTHS[11]
puts cal.MONTHS.size
puts cal.day_of_year(3, 1)
puts cal.DAYS[1]
ms = cal.MONTHS
ms[0] = "January"
puts ms[0]
puts cal.name(1)
