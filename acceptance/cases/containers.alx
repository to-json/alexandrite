# The container, math/bits and cmp ports used from another package: generic
# instances find their package's private types (list's Node), and heap's
# generic functions call the caller's own (non-pub) methods.
import "container/list"
import "container/ring"
import "container/heap"
import "math/bits"
import "cmp"

struct H {
  st: [[Int]]
  def len -> Int { st[0].size }
  def less(i: Int, j: Int) -> Bool { st[0][i] < st[0][j] }
  def swap!(i: Int, j: Int) {
    s = st[0]
    s[i], s[j] = s[j], s[i]
  }
  def push!(x: Int) { self.st[0] << x }
  def pop! -> Int {
    s = st[0]
    x = s[s.size - 1]
    self.st[0] = s[0...s.size - 1]
    x
  }
}

l = list.List[Int].new
e = l.push_back!(1)
l.push_front!(0)
l.insert_after!(5, e)
l.move_to_front!(e)
puts l.values
puts l.remove!(e).unwrap
o = list.List[Int].new
o.push_back!(9)
puts l.remove!(o.front.unwrap).none?
puts l.values

r = ring.new(4, 0).unwrap
for i in 0...4 {
  r.set_value!(i * i)
  r = r.next
}
s = ring.new(2, 7).unwrap
r.link!(s)
sum = 0
r.do { |v| sum += v }
puts sum
puts r.len

h = H.new(st: [[5, 3, 8, 1]])
heap.init(h)
heap.push(h, 0)
out: [Int] = []
while h.len > 0 {
  out << heap.pop(h)
}
puts out

puts bits.leading_zeros64(1)
hi, lo = bits.mul64(0xffffffffffffffff, 3)
puts hi
puts lo
q, rm = bits.div64(1, 0, 3)
puts q
puts rm
puts cmp.compare("a", "b")
puts cmp.or([0, 0, 4])
