# std/context's deadline task cancels a context another task made, while
# tasks of the same thread park inside calls that allocate only for
# themselves (port-issues #237: the cancel locked memory such a call had
# handed out again).
import "context"
import "time"

def label(i: Int) -> Str {
  xs = [i, i + 1]
  t = "#{xs[0]}"
  "task " + t
}

def nap(i: Int) -> Int {
  s = "nap #{i}"
  time.sleep(time.millisecond)
  s.size
}

bad = Atomic.new(0)
ts = (0...200).map { |i|
  spawn {
    name = label(i)
    ctx, _cancel = context.with_timeout(context.background, time.millisecond * 2)
    n = nap(i)
    junk: [Str] = []
    (0...20).each { junk << "junk #{it} #{n} ................................" }
    ctx.done.recv
    bad.add(1) if name != "task #{i}" || ctx.err == none
    junk.size
  }
}.to_a
puts ts.sum { it.wait.unwrap }
puts bad.load
