# What the crypto port (crypto, crypto/hmac, hkdf, pbkdf2, sha*) needed:
#  - a generic def takes its type parameters from a function argument's
#    parameter and result types (`def new[H](h: () -> H)`, hmac.new);
#  - an enum variant without fields can be a constant (`pub SHA256 =
#    Hash.SHA256`, so `crypto.SHA256.size` reads like Go);
#  - a `case` with an arm that panics still has the other arms' value;
#  - shifts by a constant count fold their checks at compile time (the JIT
#    made a branch per shift), with Go's results for counts past the width.
import "crypto"

enum Algo {
  Fast
  Slow
  Custom(rounds: Int)

  def rounds -> Int {
    case self {
      Fast => 1
      Slow => 100
      Custom(r) => r
    }
  }

  def label -> Str {
    case self {
      Fast => "fast"
      Slow => "slow"
      _ => panic("no label")
    }
  }
}

DEFAULT = Algo.Slow
ALIAS = DEFAULT

struct Box[T] {
  v: T

  def get -> T { v }
}

def make_box[T](f: () -> T) -> Box[T] { Box.new(v: f()) }

def apply_twice[A](f: (A) -> A, x: A) -> A { f(f(x)) }

def first_of[A, B](p: (A, B)) -> A { p[0] }

def pick(n: Int) -> [Int] {
  case n {
    1 => [1]
    2 => panic("two is not allowed")
    _ => [n, n]
  }
}

b = make_box(->() -> Str { "boxed" })
puts b.get
puts apply_twice(->(x: Int) -> Int { x * 3 }, 7)
puts first_of((5, "five"))
puts DEFAULT.rounds
puts ALIAS.label
puts Algo.Fast.label
puts pick(1)
puts pick(3)
puts crypto.SHA256.size
puts crypto.SHA3_512.to_s
puts crypto.MD5.available?

x: U32 = 0xdeadbeef
puts x << 4
puts x << 32
puts x << 40
puts x >> 28
puts x >> 33
y = -12345
puts y >> 3
puts y >> 64
puts y >> 100
puts y << 70
z: U64 = 0xffffffffffffffff
puts z >> 63
puts z >> 64
w: I8 = -100
puts w >> 2
puts w << 1
