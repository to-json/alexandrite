# `defer { ... }`: a block of statements run when the function returns, last
# deferred first; the block's last value (here an Int) is discarded.
def note(s: Str) -> Int {
  puts s
  s.size
}

def work(fail_early: Bool) -> Int {
  defer { note("first deferred") }
  defer {
    note("second deferred")
    note("  (two statements)")
  }
  note("body")
  return 1 if fail_early
  note("body end")
  2
}

puts work(false)
puts work(true)

def counted -> Int {
  n = [0]
  defer { puts "deferred sees #{n[0]}" }
  n[0] = 5
  n[0]
}

puts counted()
