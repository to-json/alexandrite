# A `return` inside a loop whose body allocates per iteration, in a function
# with a `defer` whose code has scopes of its own (an `if`): leaving runs
# the deferred code, then frees the loop's iteration region once. (The
# deferred code's own scopes used to free it too: a double free that later
# made two regions share memory.)
def find(words: [Str], want: Str, log: [Int]) -> Int {
  defer {
    if log.size > 0 {
      log[0] = log[0] + 1
    } else {
      puts "no log"
    }
    0
  }
  i = 0
  for w in words {
    s = w + "!" + w
    return i if s == want + "!" + want
    i += 1
  }
  -1
}

log = [0]
words = ["alpha", "beta", "gamma", "delta"]
total = 0
for k in 0...2000 {
  total += find(words, words[k % 4], log)
}
puts total
puts log[0]

# Allocation-heavy work afterwards (a corrupted region pool made this hang
# or crash).
counts: Map[Str, Int] = {}
for j in 0...20000 {
  key = "k#{j % 7}"
  counts[key] = (counts[key] || 0) + 1
}
puts counts["k0"] || 0
