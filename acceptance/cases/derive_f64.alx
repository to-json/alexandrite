# derive(Json) takes F64 (Float's other name) and I64 as Float and Int: a
# package that declares its own Int/Float (expvar) spells the builtins so.
import "encoding/json"

#[derive(Json)]
struct Reading {
  at: I64
  value: F64
  #[json(omit_empty)] spread: F64
}

r = Reading.new(at: 3, value: 2.5)
s = r.to_json.unwrap
puts s
back = Reading.from_json("{\"at\":4,\"value\":0.125,\"spread\":1}").unwrap
puts "#{back.at} #{back.value} #{back.spread}"
