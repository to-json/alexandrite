# A `.dup` of an expression that reads a caller's value is a fresh copy:
# it may go into a Mutex (another task's reach) directly (log/slog port).
struct State {
  names: [Str]
}

def wrap(names: [Str], extra: Str) -> Mutex[State] {
  Mutex.new(State.new(names: (names + [extra]).dup))
}

def wrap2(names: [Str]) -> Mutex[State] {
  Mutex.new(State.new(names: names).dup)
}

xs = ["a", "b"]
m = wrap(xs, "c")
m.lock { |s| s.names << "d" }
puts xs
puts m.lock { |s| s.names }
m2 = wrap2(xs)
m2.lock { |s| s.names[0] = "z" }
puts xs
puts m2.lock { |s| s.names }
