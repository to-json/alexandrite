# L3: a TCP echo server and 50 clients in one process, on loopback. Every
# accept, read and write parks its task on the runtime's poller.
import "net"

ln = net.listen("tcp", "127.0.0.1:0").unwrap
addr = ln.addr

def serve(c: net.Conn) {
  conn = c
  buf: [Byte] = [0; 256]
  loop {
    n = conn.read!(buf).unwrap_or(0)
    break if n == 0
    conn.write!(buf[0...n]).unwrap
  }
  conn.close!
}

server_ln = ln
server = spawn {
  l = server_ln
  served = 0
  while served < 50 {
    c = l.accept.unwrap
    spawn { serve(c) }
    served += 1
  }
  served
}

clients = (1..50).map { |i|
  spawn {
    conn = net.dial("tcp", addr).unwrap
    msg = "hello #{i}"
    conn.write_string!(msg).unwrap
    buf: [Byte] = [0; 64]
    got = 0
    while got < msg.size {
      n = conn.read!(buf).unwrap_or(0)
      break if n == 0
      got += n
    }
    conn.close!
    got
  }
}.to_a
total = clients.sum { it.wait.unwrap }
puts total
puts server.wait.unwrap
