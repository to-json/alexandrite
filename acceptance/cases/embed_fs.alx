# #[embed] (D59, Go's //go:embed): files read at compile time into
# constants of type Str, [Byte] and embed.FS.
import "embed"

#[embed("embed_data/hello.txt")]
HELLO: Str

#[embed("embed_data/bin.dat")]
BIN: [Byte]

#[embed("embed_data/bin.dat")]
BIN_STR: Str

#[embed("embed_data")]
FILES: embed.FS

#[embed("all:embed_data")]
ALL: embed.FS

#[embed("embed_data/sub/*.txt", "embed_data/hello.txt")]
GLOBBED: embed.FS

def show(f: embed.FS, dir: Str) -> ~Unit {
  for e in f.~read_dir(dir) {
    if e.is_dir {
      puts "#{dir}/#{e.name}/"
      ~show(f, "#{dir}/#{e.name}")
    } else {
      data = Str.from_bytes(f.~read_file("#{dir}/#{e.name}"))
      puts "#{dir}/#{e.name}: #{data.size} bytes"
    }
  }
}

def main -> ~Unit {
  print HELLO
  puts BIN
  puts BIN_STR.size
  puts BIN_STR.bytes.to_a == BIN
  b = BIN
  b[0] = 0
  puts BIN[0]
  ~show(FILES, "embed_data")
  puts "--"
  ~show(ALL, "embed_data")
  puts "--"
  ~show(GLOBBED, "embed_data")
  puts Str.from_bytes(FILES.~read_file("embed_data/sub/b.txt")).strip
  r = FILES.read_file("embed_data/.secret/s.txt")
  puts r.err.unwrap.message
}

~main()
