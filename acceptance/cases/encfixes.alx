# Fixes found while porting Go's encoding packages.

# A trailing `if`/`else` whose value is discarded may have branches of
# different types: here an Error? field assignment and an Int compound
# assignment. Joining them used to coerce the Int branch to Error?.
struct S {
  err: Error?
  eof: Bool
  n: Int
}

def g(x: Int) -> ~Int {
  fail "boom" if x > 10
  x
}

struct T {
  st: [S]

  def step!(k: Int) -> Int {
    while st[0].n < 5 && st[0].err.none? {
      r = g(st[0].n + k)
      if e = r.err {
        self.st[0].err = e
      } else {
        got = r.unwrap
        self.st[0].eof = true if got == 0
        self.st[0].n += got
      }
    }
    st[0].n
  }
}

t = T.new(st: [S.new(err: none, eof: false, n: 0)])
puts t.step!(2)
t2 = T.new(st: [S.new(err: none, eof: false, n: 0)])
puts t2.step!(11)
puts t2.st[0].err?.message || "none"

# `s * n` builds the result by doubling (it appended s n times, quadratic:
# encoding/pem's test repeats a 12-byte line ten million times; quadratic, this takes minutes).
puts "ab" * 5
puts ("x" * 0).size
puts ("xyz" * 1).size
big = "-----BEGIN \n" * 1000000
puts big.size
puts big[big.size - 12...big.size] == "-----BEGIN \n"
