# Port issues #260-#262 (found by the context port): `==` on Error values
# (Go's `err == ErrX`, S13: the same error type and equal values of it;
# neither wrap context nor where they were raised count; also Error? against an error
# type's value); an interface value shown with "#{v}" prints through its
# implementors' (or the interface's default) `to_s`; `dup` on an interface
# value (a deep copy, as the spawn check suggests); a def without a declared
# result, a bare `return` and a valued last line (#263).
error CtxErr {
  Canceled
  Other(n: Int, why: Error?)

  def message -> Str {
    case self {
      Canceled => "canceled"
      Other(n, _w) => "other #{n}"
    }
  }
}

def mk(s: Str) -> Error { Failure.Msg(s) }

def cx -> Error { CtxErr.Canceled }

x = mk("boom")
puts x == mk("boom")
puts x != mk("bang")
o: Error? = cx
puts o == CtxErr.Canceled
puts o != CtxErr.Other(n: 1, why: none)
n: Error? = none
puts n != CtxErr.Canceled
puts x.wrap("ctx") == x
puts x.wrap("ctx") == x.wrap("ctx")
e1: Error = CtxErr.Other(n: 1, why: x)
e2: Error = CtxErr.Other(n: 1, why: mk("boom"))
e3: Error = CtxErr.Other(n: 1, why: mk("bang"))
puts e1 == e2
puts e1 != e3
puts [x, cx] == [mk("boom"), CtxErr.Canceled]

interface Named {
  def name -> Str
  def to_s -> Str { "named #{name}" }
}

struct Dog {
  def name -> Str { "dog" }
  def to_s -> Str { "Dog!" }
}

struct Wrap {
  inner: Named
  tags: [Str]

  def name -> Str { "wrap(#{inner.name})" }
}

interface Plain {
  def id -> Int
}

struct P {
  n: Int

  def id -> Int { n }
  pub def to_s -> Str { "P#{n}" }
}

d: Named = Dog.new
w: Named = Wrap.new(inner: d, tags: ["a"])
puts "#{d} #{w}"
ps: [Plain] = [P.new(n: 1), P.new(n: 2)]
puts "#{ps}"
w2 = w.dup
t = spawn { "#{w2}" }
puts t.wait.unwrap

def tail(x: Int) {
  return if x == 0
  puts x
  _ = x + 1
}

tail(0)
tail(7)
