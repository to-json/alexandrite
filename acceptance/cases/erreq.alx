# `==` on Error values, Go's optional error methods (unwrap, is?) and
# package-qualified variant patterns (errors port).
import "os"
import "io/fs"
import fsx "io/fs"

error MyErr {
  A
  B(n: Int)
}

error Wrap {
  W(msg: Str, err: Error?)

  def message -> Str {
    case self {
      W(m, _) => m
    }
  }

  def unwrap -> Error? {
    case self {
      W(_, e) => e
    }
  }
}

error Multi {
  M(errs: [Error])

  def unwrap -> [Error] {
    case self {
      M(es) => es
    }
  }
}

error Any {
  X

  def is?(target: Error) -> Bool { true }
}

error FnErr {
  F(f: (Int) -> Int)

  def message -> Str { "fn" }
}

def kind(e: Error) -> Str {
  case e {
    os.FsError.NotExist(at) => "os #{at.path}"
    fs.FsError.Closed => "fs closed"
    _ => "other"
  }
}

def kind2(e: Error) -> Str {
  case e {
    fsx.FsError.Closed => "fsx closed"
    _ => "other"
  }
}

def main {
  e: Error = MyErr.B(n: 3)
  f: Error = MyErr.B(n: 3)
  g: Error = MyErr.B(n: 4)
  puts e == f
  puts e == g
  puts e != g
  puts e == MyErr.B(n: 3)
  puts e.wrap("ctx") == f
  puts e == Failure.Msg("B(3)")
  puts Failure.Msg("a") == Failure.Msg("a")
  o: Error? = none
  puts o == none
  puts o == e
  p: Error? = e
  puts p == f
  h: Error = FnErr.F(f: ->(x: Int) -> Int { x })
  puts h == h
  w: Error = Wrap.W(msg: "w", err: e)
  puts w.unwrap == e
  puts e.unwrap == none
  m: Error = Multi.M(errs: [e, w])
  puts m.unwrap == none
  puts m.unwrap_all.size
  puts w.unwrap_all.size
  puts m == Multi.M(errs: [f, w])
  x: Error = Any.X
  puts x.matches?(e)
  puts e.matches?(x)
  puts kind(os.FsError.NotExist(os.FsFailure.new(op: "open", path: "/no/such/file", code: 2)))
  puts kind(fs.FsError.Closed)
  puts kind(e)
  puts kind2(fs.FsError.Closed)
}

main()
