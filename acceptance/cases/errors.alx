# M5: errors as values: `error` types, `fail`, `~` propagation, declared sets, Results.
error ParseError {
  Empty
  BadDigit(at: Int, ch: Str)

  def message -> Str {
    case self {
      Empty => "empty input"
      BadDigit(at, ch) => "bad digit `#{ch}` at #{at}"
    }
  }
}

error Shrug { Meh }

def parse(s: Str) -> ~Int<ParseError | ArithError> {
  fail ParseError.Empty if s.size == 0
  n = 0
  i = 0
  for c in s.chars {
    d = c.to_i
    fail ParseError.BadDigit(at: i, ch: c) if d == 0 && c != "0"
    n = ~(n * 10 + d)
    i += 1
  }
  n
}

def sum_all(xs: [Str]) -> ~Int {
  total = 0
  for x in xs { total += ~parse(x) }
  total
}

def checked(s: Str) -> ~Int<Error> {
  v = ~parse(s)
  fail "too big: #{v}" if v > 1000
  fail Shrug.Meh if v == 7
  v
}

puts sum_all(["12", "30"]).unwrap
r = sum_all(["12", "x3"])
puts r.ok?
puts r.unwrap_or(-1)
if e = r.err { puts e }
puts parse("").err
v = parse("42").rescue { |e| 0 }
puts v
w = parse("4z").rescue { |e| -1 }
puts w
for s in ["5", "", "9x", "2000", "7", "99999999999999999999"] {
  r = checked(s)
  if x = r.ok {
    puts "ok #{x}"
  } else if e = r.err {
    case e {
      Empty => puts "empty!"
      BadDigit(at, _) => puts "bad at #{at}"
      Overflow => puts "overflow"
      Failure => puts "failure: #{e}"
      _ => puts "other: #{e}"
    }
  }
}
e2 = parse("").err
if e = e2 { puts e.wrap("reading config") }
puts ~parse("123")
