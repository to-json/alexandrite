# S7: a held result keeps its error set. `r = f()` where f is declared
# `~T<E>`: `r.err` is an `E?` (its variants' fields and E's methods are
# there directly, `case` over it is exhaustive without `_`), and `~r`
# re-raises within a def declared `~T<E>` or a wider set. Code treating
# `r.err` as an Error keeps working: E converts (message, wrap, `#{}`,
# Error? parameters).
error ParseErr {
  Bad(pos: Int, why: Str)
  Empty

  def code -> Int {
    case self {
      Bad(p, _) => p
      Empty => -1
    }
  }

  def message -> Str {
    case self {
      Bad(p, why) => "bad input at #{p}: #{why}"
      Empty => "empty input"
    }
  }
}

error Other {
  Boom
}

def parse(t: Str) -> ~Int<ParseErr> {
  fail ParseErr.Empty if t == ""
  fail ParseErr.Bad(pos: t.size, why: "x") if t.start_with?("x")
  t.size
}

# Re-raising a held result in a def with the same set (port-issues #104).
def again(t: Str) -> ~Int<ParseErr> {
  r = parse(t)
  if e = r.err {
    puts "  again sees code #{e.code}"
  }
  ~r
}

# ... and in one with a wider set.
def wider(t: Str) -> ~Int<ParseErr | Other> {
  r = parse(t)
  fail Other.Boom if t == "boom"
  ~r
}

# An open Error? still takes it.
def text(e: Error?) -> Str {
  if x = e {
    return x.message
  }
  "none"
}

# A `!` method's held result keeps its set too.
struct Total {
  n: Int

  def add!(t: Str) -> ~Int<ParseErr> {
    self.n += ~parse(t)
    n
  }
}

for t in ["ab", "", "xyz"] {
  puts "[#{t}]:"
  r = parse(t)
  if e = r.err {
    # E's methods and an exhaustive case, no `_` arm.
    puts "  code #{e.code}"
    w = case e {
      Bad(p, why) => "bad #{p} #{why}"
      Empty => "empty"
    }
    puts "  #{w}"
    # Error's view still works.
    puts "  #{e.message} / #{e.wrap("ctx").message} / #{e} / #{r.err} / #{text(r.err)}"
  } else {
    puts "  ok #{r.unwrap}"
  }
  puts "  again ok? #{again(t).ok?}"
  w2 = wider(t)
  puts "  wider: #{w2.err?.message || "ok"}"
}
puts "boom: #{text(wider("boom").err)}"
tot = Total.new
r2 = tot.add!("xy")
if e = r2.err {
  puts "add!: #{e.code}"
}
puts parse("").err.unwrap.code
