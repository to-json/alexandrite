# L2: the C foreign function interface (`extern def`).
extern def getpid -> I32
extern def strlen(s: Str) -> Int
extern def write(fd: I32, buf: [Byte], n: Int) -> Int
extern def read(fd: I32, buf: [Byte], n: Int) -> Int
extern def close(fd: I32) -> I32
extern def unlink(path: Str) -> I32
extern def usleep(us: U32) -> I32 = "usleep"
extern def labs_(x: Int) -> Int = "labs"
extern def abs(x: I32) -> I32
extern def toupper(c: I32) -> I32
extern def malloc(n: Int) -> Ptr
extern def free(p: Ptr)
extern def memset(p: Ptr, c: I32, n: Int) -> Ptr
extern def getenv(name: Str) -> Ptr
extern def setenv(name: Str, value: Str, overwrite: I32) -> I32
extern def sqrt(x: Float) -> Float
extern def isatty_(fd: I32) -> Bool = "isatty"
# Variadic libc functions go through the runtime's plain wrappers.
extern def alx_sys_open(path: Str, flags: I32, mode: I32) -> I32
extern def alx_sys_const(name: Str) -> Int

pub extern def exported_strlen(s: Str) -> Int = "strlen"

def c(name: Str) -> Int { alx_sys_const(name) }

# scalars
pid = getpid
puts C.errno # zeroed before each call
puts pid > 0
puts strlen("héllo")
puts strlen("")
puts abs(-42)
puts toupper(97)
puts labs_(-9000000000)
puts sqrt(2.0) > 1.41
puts usleep(1000)
puts exported_strlen("abc")

# write to fd 1: our own buffered output is flushed first, so order holds
puts "before"
msg = "from write(2)\n".bytes.to_a
n = write(1, msg, msg.size)
puts "wrote #{n}"
puts "after"

# a file: open / write / close / open / read / close through the shims
path = "/tmp/alx_ffi_test_#{pid}.txt"
fd = alx_sys_open(path, (c("O_WRONLY") | c("O_CREAT") | c("O_TRUNC")).to_i32, 420)
puts fd >= 0
data = "hello, file\n".bytes.to_a
puts write(fd, data, data.size)
puts close(fd)
fd = alx_sys_open(path, c("O_RDONLY").to_i32, 0)
zero: Byte = 0
buf = Array.new(64, zero)
got = read(fd, buf, 64)
puts got
puts Str.from_bytes(buf[0...got])
puts close(fd)
puts unlink(path)
puts alx_sys_open(path, c("O_RDONLY").to_i32, 0)
puts C.errno == c("ENOENT")
puts C.strerror(C.errno)

# errno after a failing call
puts close(-1)
puts C.errno == c("EBADF")
puts C.strerror(c("EBADF"))
puts c("NOT_A_CONSTANT")

# pointers
puts Ptr.null.null?
p = malloc(64)
puts p.null?
puts p == Ptr.null
memset(p, 0, 64)
memset(p, 66, 3)
puts Str.from_cstr(p)
puts Str.from_ptr(p, 2)
free(p)
puts getenv("ALX_FFI_SURELY_UNSET").null?
puts setenv("ALX_FFI_VAR", "héllo", 1)
puts Str.from_cstr(getenv("ALX_FFI_VAR"))
puts Str.from_cstr(Ptr.null).size
