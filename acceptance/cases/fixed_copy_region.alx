# port-issues #120 (found by the encoding/gob port): a fixed array copied
# into a local (`v = ys`) lives where the array it copies lives. It used to
# be allocated in the current region, which a loop iteration frees, while
# `xs[i] = v` / `r.n = v` kept it: the next iteration's arrays overwrote it.
struct D {
  st: [Int]
  def chk!(n: Int) -> ~Unit {
    fail "neg" if n < 0
  }
  def int! -> ~Int {
    self.st[0] += 1
    self.st[0]
  }
}

def fill(d0: D) -> ~[[Int; 2]; 2] {
  d = d0
  xs: [[Int; 2]; 2] = [[0; 2]; 2]
  for i in 0...2 {
    d.~chk!(2)
    v: [Int; 2] = [0; 2]
    ys: [Int; 2] = [0; 2]
    for j in 0...2 {
      ys[j] = d.~int!
    }
    v = ys
    xs[i] = v
  }
  xs
}

struct S {
  n: [Float; 3]?
  m: [Str; 2]?
}

def opt_fill(d0: D) -> ~S {
  d = d0
  r = S.new
  for k in 0...2 {
    d.~chk!(k)
    if k == 0 {
      a: [Float; 3] = [0.0; 3]
      for i in 0...3 {
        a[i] = d.~int!.to_f
      }
      b = a
      r.n = b
    } else {
      c: [Str; 2] = [""; 2]
      for i in 0...2 {
        c[i] = "s#{d.~int!}"
      }
      e = c
      r.m = e
    }
  }
  r
}

puts fill(D.new(st: [0])).unwrap
s = opt_fill(D.new(st: [0])).unwrap
puts s.n || [0.0; 3]
puts s.m || [""; 2]
# value semantics still hold
a: [Int; 2] = [5; 2]
b = a
b[0] = 9
puts a
puts b
