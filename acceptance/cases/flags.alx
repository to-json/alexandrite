# L2: package flag (Go's flag) over a fixed argument list.
import "flag"

struct Level {
  n: Int
  def set!(s: Str) -> Str? {
    case s {
      "low" => {self.n = 1}
      "high" => {self.n = 2}
      _ => {return "want low or high"}
    }
    none
  }
  def to_s -> Str { n == 0 ? "" : (n == 1 ? "low" : "high") }
}

def build -> flag.FlagSet {
  fs = flag.new_set("demo")
  fs.int!("n", 5, "how many")
  fs.bool!("v", false, "verbose")
  fs.str!("name", "world", "who to greet")
  fs.float!("ratio", 0.5, "the `ratio` to use")
  fs.strs!("I", "include dir (repeatable)")
  fs.var!("level", Level.new(n: 1), "log `level`: low or high")
  fs
}

def show(fs: flag.FlagSet) {
  puts "n=#{fs.get_int("n")} v=#{fs.get_bool("v")} name=#{fs.get_str("name")} ratio=#{fs.get_float("ratio")}"
  puts "I=#{fs.get_strs("I")} level=#{fs.get_value("level").to_s}"
  puts "args=#{fs.args} (#{fs.nargs})"
  puts "n set? #{fs.set?("n")}, name set? #{fs.set?("name")}"
}

fs = build
r = fs.parse!(["-n", "0x10", "--name=Ada", "-v", "-I", "a", "--I=b", "-ratio", "2.5", "-level", "high", "file.txt", "-n", "99"])
puts r.ok?
show(fs)

# defaults, and the terminator
fs = build
r = fs.parse!(["-v=false", "--", "-v", "x"])
puts r.ok?
show(fs)

# errors
def try_parse(args: [Str]) {
  fs = build
  r = fs.parse!(args)
  if e = r.err {
    puts "error: #{e.message}"
  } else {
    puts "ok"
  }
}
try_parse(["-bogus"])
try_parse(["-n"])
try_parse(["-n", "abc"])
try_parse(["-n=99999999999999999999"])
try_parse(["-v=maybe"])
try_parse(["-level=mid"])
try_parse(["---v"])

# -h gives the usage text
fs = build
r = fs.parse!(["-h"])
if e = r.err {
  case e {
    Help(u) => print u
    _ => puts "unexpected"
  }
}

puts flag.args_of_program.size >= 0
