# L1: Go's fmt — verbs with flags, widths and precisions; sprint/println
# spacing; errorf.
import "fmt"

struct P {
  x: Int
  y: Int
}

fmt.printf("[%5d|%-5d|%05d|%+d|% d]\n", 42, 42, -42, 7, 7)
fmt.printf("[%8s|%-8s|%q|%T|%T]\n", "héllo", "ab", "tab\there \"q\"\n", 3.5, [1, 2])
fmt.printf("[%e|%.2E|%10.3f|%+.1f|%x|%08.3f]\n", 1234.5678, 0.000123, 3.14159, 2.0, 255, -3.14159)
puts fmt.sprint("a", 1, 2, "b", "c")
fmt.println("x", 1, true, [1, 2], P.new(x: 1, y: 2))
fmt.print("no newline")
fmt.print("\n")
e = fmt.errorf("bad %d of %s", 5, "seven")
puts e
puts fmt.sprintf("%v %v %v", {"a" => 1}, 1.5, "s")
puts fmt.sprintf("%6.2f%%", 99.5)
