# Go's fmt directives (D68): flags, widths, precisions, `*`, indexes, per
# element formatting, Stringer/error/GoStringer/Formatter, %w, scanning.
import "fmt"

struct P {
  a: Int
  s: Str
}

struct Temp {
  c: Float
  def to_s -> Str { format("%.1f°C", c) }
}

struct G {
  v: Int
  def go_string -> Str { format("G(%d)", v) }
}

error Oops {
  Bad(code: Int)
  def message -> Str {
    case self {
      Bad(code) => "bad code #{code}"
    }
  }
}

enum Shape {
  Circle(Float)
  Dot
}

puts format("%5d|%-5d|%05d|%x|%#x|%+d|%o|%#o|%b|%U|%#U", 42, 42, -42, 255, 255, 3, 8, 8, 5, 0x1F600, 0x1F600)
puts format("%q|%+q|%#q|%x|% X|%8.3s|%-6s|%06s", "héllo\n", "héllo", "ab", "hi", "hi", "abcdef", "ab", "ab")
puts format("%g|%.3g|%e|%10.2f|%x|%b|%G|%v|%#g|%+.2e", 1234567.0, 3.14159, 1e21, 3.14159, 1.0, 1.0, 1e-7, 2.5, 1.0, -0.000123)
puts format("%v|%+v|%#v|%d|%x|%5.1f", P.new(a: 1, s: "x"), P.new(a: 1, s: "x"), P.new(a: 1, s: "x"), [1, 2], [10, 255], [1.25, -2.5])
puts format("%c|%q|%*d|%-*d|%.*f", 0x4E16, 0x4E16, 5, 1, 4, 2, 2, 3.14159)
puts format("%[2]d %[1]d %d", 7, 8)
m: Map[Str, Int] = {"b" => 2, "a" => 1}
o: Int? = none
puts format("%v|%5v|%d|%v|%t|%6.2v|%#v", m, o, [3], 1 + 2i, true, 1 + 2i, m)
puts format("%v|%s|%10v|%x|%#v|%v", Temp.new(c: 21.5), Temp.new(c: -3.0), Temp.new(c: 0.0), Temp.new(c: 1.0), G.new(v: 7), Shape.Circle(2.0))
e: Error = Oops.Bad(code: 3)
w = fmt.errorf("loading %s: %w", "x.cfg", e)
puts w.message
matched = case w {
  Oops.Bad(code) => code
  _ => -1
}
puts matched
puts fmt.sprint("a", 1, 2, "b", 3.5, true) + fmt.sprintln(1, "x")
bs = fmt.appendf("n=".bytes.to_a, "%03d", 7)
puts Str.from_bytes(bs)
a = 0
s = ""
f = 0.0
n = fmt.sscan("42 word 2.5e3", a, s, f)
puts "#{n.unwrap} #{a} #{s} #{f}"
x: I8 = 0
y: U16 = 0
r = fmt.sscanf("v=-5, 0x1f", "v=%d, %v", x, y)
puts "#{r.unwrap} #{x} #{y}"
puts fmt.sscan("", a).err.unwrap.message
puts fmt.sscan("300", x).err.unwrap.message
puts "#{Shape.Dot} #{Shape.Circle(1.5)}"
