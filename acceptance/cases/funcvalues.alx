import "slices"
# Functions as values: a named def where a function is wanted; a block for
# a last parameter of function type (also through method sugar).
def by_len(a: Str, b: Str) -> Int {
  a.size - b.size
}
def apply(f: (Int) -> Int, x: Int) -> Int {
  f(x)
}
def twice(x: Int) -> Int {
  x * 2
}
xs = ["ccc", "a", "bb"]
slices.sort_func(xs, by_len)
puts xs
puts apply(twice, 21)
g: (Int) -> Int = twice
puts g(5)
zs = [3, 8, 5, 12]
puts slices.index_func(zs) { |x| x > 4 }
puts slices.index_func(zs) { it > 10 }
ws = ["bb", "a", "ccc"]
slices.sort_func(ws) { |a, b| a.size - b.size }
puts ws
xs2 = [3, 8, 5, 12]
puts xs2.index_func { it > 6 }
puts xs2.contains_func { |x| x == 5 }
