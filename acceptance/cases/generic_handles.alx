# Pools of generic nodes (the std container ports need them): `@Node[T]`
# handles, `pool.get(h)` (a T? that is none for removed handles), keyword
# method names (`e.next`), blocks on a generic type's methods, lambdas that
# end in a panic, and a generic type's zero value through a literal.

struct Node[T] {
  value: T
  nxt: @Node[T]?
}

struct Chain[T] {
  nodes: Pool[Node[T]]
  head: @Node[T]?

  def push!(v: T) -> @Node[T] {
    h = nodes.add(Node[T].new(value: v, nxt: head))
    self.head = h
    h
  }

  # A keyword as a method name: `c.next(h)` reads fine, and so does `def next`.
  def next(h: @Node[T]) -> @Node[T]? {
    if n = nodes.get(h) {
      return n.nxt
    }
    none
  }

  def each(f: (T) -> Unit) {
    p = head
    while p.present? {
      n = nodes[p.unwrap]
      f(n.value)
      p = n.nxt
    }
  }
}

# T is bound from a handle parameter.
def value_at[T](c: Chain[T], h: @Node[T]) -> T {
  c.nodes[h].value
}

struct Zero[T] {
  v: T
}

def zero_like[T](x: T) -> T {
  Zero[T].new.v
}

c = Chain[Str].new
a = c.push!("a")
b = c.push!("b")
puts value_at(c, a)
puts c.next(b).unwrap == a
puts c.next(a).none?
out = ""
c.each { |s| out += s } # T comes from the receiver
puts out

# get: present for a live handle, none once removed or for another pool's.
puts c.nodes.get(a).unwrap.value
c.nodes.remove(a)
puts c.nodes.get(a).none?
d = Chain[Str].new
puts d.nodes.get(b).none?
e = c.push!("e") # reuses a's slot, with a new generation
puts c.nodes.get(a).none?
puts c.nodes.get(e).unwrap.value

# A lambda whose last expression is a panic, after early returns.
check = ->(x: Int) -> Int {
  return x if x > 0
  panic("not positive")
}
puts check(5)

puts zero_like(42)
puts zero_like("x").size
puts zero_like(2.5)
