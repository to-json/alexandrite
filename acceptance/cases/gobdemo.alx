# S4/D72: encoding/gob with #[derive(Gob)]: Go's bytes, structs, enums as
# interfaces, streams, decoding into another type, math/big through the
# gob protocol, the package-level registry.
import "bytes"
import "encoding/gob"
import "encoding/hex"
import "math/big"

#[derive(Gob)]
struct Inner {
  a: Int
}

#[derive(Gob)]
struct Rect {
  w: Float
  h: Float
}

#[derive(Gob)]
enum Shape {
  Circle(Float)
  Rect(Rect)
  Named(name: Str, n: I8)
  Dot
}

#[derive(Gob)]
struct W {
  x: Int
  name: Str
  xs: [Int]
  inner: Inner
  ins: [Inner]
  m: Map[Str, Int]
  p: Inner?
  s: Shape
  arr: [U8; 3]
  big: big.Int?
}

#[derive(Gob)]
struct Small {
  #[field(gob: "Name")] title: Str
  arr: [U8; 3]
}

def show(s: Shape) -> Str {
  case s {
    Circle(r) => "circle #{r}"
    Rect(r) => "rect #{r.w}x#{r.h}"
    Named(n, k) => "named #{n} #{k}"
    Dot => "dot"
  }
}

w = W.new(x: 7, name: "hi", xs: [1, 2], inner: Inner.new(a: 3), ins: [Inner.new(a: 4)], m: {"k" => 1}, p: Inner.new(a: 5), s: Shape.Named(name: "n", n: -3), arr: [1, 2, 3], big: big.new_int(5))
buf = bytes.new_buffer([])
enc = gob.new_encoder(buf)
enc.encode!(w).unwrap
h = hex.encode_to_string(buf.bytes)
# what Go 1.27's encoder writes for the same value (a fresh process)
go = ""
puts h == go

dec = gob.new_decoder(buf)
w2 = dec.decode!(W.new).unwrap
puts "#{w2.x} #{w2.name} #{w2.xs} #{w2.inner.a} #{w2.ins.size} #{w2.m["k"] || 0} #{(w2.p || Inner.new).a}"
puts show(w2.s)
puts w2.arr
puts (w2.big || big.new_int(0)).to_s

# a stream: types go once
for s in [Shape.Circle(1.5), Shape.Rect(Rect.new(w: 2.0, h: 3.0)), Shape.Dot] {
  enc.encode!(s).unwrap
}
for _i in 0...3 {
  puts show(dec.decode!(Shape.Dot).unwrap)
}
puts dec.decode!(Shape.Dot).err?.message || "no error"

# into another type: fields by name, the rest skipped
buf2 = bytes.new_buffer([])
e2 = gob.new_encoder(buf2)
e2.encode!(w).unwrap
d2 = gob.new_decoder(buf2)
sm = d2.decode!(Small.new(title: "kept")).unwrap
puts "#{sm.title} #{sm.arr}"

# Go's errors
buf3 = bytes.new_buffer([])
e3 = gob.new_encoder(buf3)
e3.encode!(300).unwrap
d3 = gob.new_decoder(buf3)
puts d3.decode!("").err?.message || ""

# the registry: a variant sent under another name
gob.register_name("circle", Shape.Circle(0.0))
buf4 = bytes.new_buffer([])
e4 = gob.new_encoder(buf4)
e4.encode!(Shape.Circle(2.5)).unwrap
puts hex.encode_to_string(buf4.bytes)[0...20]
d4 = gob.new_decoder(buf4)
puts show(d4.decode!(Shape.Dot).unwrap)
