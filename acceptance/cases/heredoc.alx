# Heredocs follow Ruby (GO-VS-RUBY T11): `<<~ID` and `<<~"ID"` read like a
# double-quoted string (escapes and `#{}`); `<<~'ID'` is raw. The common
# indent is measured on the source text, before escapes.
import "fmt"

x = 3

# Escapes and interpolation.
a = <<~EOS
  tab:\tend
  quote: \" backslash: \\ hash: \# rune: é hex: \x41
  x is #{x}, \#{x} is not
EOS
fmt.printf("%q\n", a)

# The quoted form is the same.
b = <<~"EOS"
  one\ntwo #{x + 1}
EOS
fmt.printf("%q\n", b)

# Raw: no escapes, no interpolation.
c = <<~'EOS'
  a\tb \\ #{x} \#{x}
    kept indent
EOS
fmt.printf("%q\n", c)

# Indent is computed before escapes: `\t` at the start of a line is text,
# not indentation, so nothing is stripped here.
d = <<~EOS
\tfirst
  second
EOS
fmt.printf("%q\n", d)

# A `\` ending a line joins the next one (whose indent is still stripped).
e = <<~EOS
  joined \
    here
  next
EOS
fmt.printf("%q\n", e)

# Interpolated code may hold strings with their own escapes.
f = <<~EOS
  #{"a\tb"} and #{[1, 2].map { it * x }}
EOS
fmt.printf("%q\n", f)

# Two heredocs on one line.
fmt.printf("%q %q\n", <<~ONE, <<~'TWO')
  1\n
ONE
  2\n
TWO
