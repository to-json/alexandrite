# Interface default methods (D62): a `!` default is called on a variable
# like any `!` method, and when two interfaces offer a default of the same
# name, the one declared first wins (it was HashMap order).

interface Setter {
  def set!(n: Int)
  def set_twice!(n: Int) {
    self.set!(n)
    self.set!(n * 2)
  }
}

interface Loud {
  def shout -> Str
  def render -> Str { "LOUD #{shout}" }
}

interface Quiet {
  def whisper -> Str
  def render -> Str { "quiet #{whisper}" }
}

struct Counter {
  n: Int
  def set!(k: Int) { self.n += k }
}

struct Both {
  def shout -> Str { "HEY" }
  def whisper -> Str { "hey" }
}

struct OnlyQuiet {
  def whisper -> Str { "psst" }
}

struct Holder {
  c: Counter
}

c = Counter.new
c.set_twice!(3)
puts c.n
cs = [Counter.new, Counter.new(n: 1)]
cs[1].set_twice!(2)
puts cs[1].n
h = Holder.new
x = h.c
x.set_twice!(5)
h.c = x
puts h.c.n
puts Both.new.render
puts OnlyQuiet.new.render
