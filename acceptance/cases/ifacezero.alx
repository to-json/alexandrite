# Found by the crypto/ecdsa port: an enum with an interface-typed field in one
# variant can build its other variants (their slots hold the interface's
# zero, all-zero storage).
import "io"
import "bytes"

enum Src {
  Rd(r: io.Reader)
  Num(n: Int)
}

s = Src.Num(3)
case s {
  Rd(_) => puts "reader"
  Num(n) => puts n
}
b = bytes.Buffer.new
t = Src.Rd(b)
case t {
  Rd(_) => puts "reader"
  Num(n) => puts n
}
