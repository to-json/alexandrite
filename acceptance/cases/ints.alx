# M1: Go's integer types, exact constants and bit operations.
BIG = 1 << 100
SHIFTED = BIG >> 98          # exact constant arithmetic: 4
THIRD: Float = 1.0 / 3
KB: U32 = 1024

struct Pix { r: U8, g: U8, b: U8, a: U8 }

puts 0.1 + 0.2               # constants fold exactly: 0.3
puts SHIFTED
puts THIRD
puts KB * 4
a: U8 = 200
b: U8 = 55
puts a + b
puts a +% b +% 1
puts a -% 201
puts a *% 2
c: I8 = -128
puts c -% 1
x = 0xff_ff
puts x
puts x & 0x0f0f
puts x | 0x10000
puts x ^ 0xffff
puts x &^ 0xff
puts ^0
puts ^a
puts 1 << 62
n = 64
puts 1 << n
puts -1 >> n
puts 0b1011 >> 1
u: U64 = 18_446_744_073_709_551_615
puts u
puts u / 3
puts u % 10
puts u > 1
puts u >> 60
puts u.as_i64
puts u.to_f
m: I32 = -7
puts m / 2
puts m % 2
puts m.to_i
puts m.as_u32
puts 300.as_u8
puts 3.7.to_i8
puts format("%x %X %o %b %d %c", 255, 255, 8, 5, -42, 9731)
puts format("%x %d", -255, u)
bytes: [U8] = [1, 2, 250]
bytes[1] = bytes[2] +% 10
puts bytes[1]
total = 0
bytes.each { total += it.to_i }
puts total
p = Pix.new(r: 255, a: 128)
p.g = p.r -% 1
puts format("%d %d %d %d", p.r, p.g, p.b, p.a)
h: U32 = 2166136261          # FNV-1a over "go"
"go".bytes.each { h = (h ^ it.as_u32) *% 16777619 }
puts h
