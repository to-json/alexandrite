# L3: encoding/json on compile-time derives (S3). No reflection: `#[derive(Json)]`
# writes to_json / from_json into the type.
import "encoding/json"

#[derive(Json)]
struct Address {
  city: Str
  #[json("zip-code")] zip: Int
}

#[derive(Json)]
enum Event {
  Started
  Moved(Address)
  Scored(Int, Float)
  Resized(w: Int, h: Int)
}

#[derive(Json)]
struct User {
  name: Str
  age: U8
  email: Str?
  tags: [Str]
  scores: Map[Str, Float]
  home: Address
  last: (Int, Str)
  events: [Event]
  #[json(omit_empty)] nick: Str
  #[json(skip)] cache: Int
}

def run -> ~Int {
  u = User.new(name: "Ann <ann@x.org>", age: 41, email: "ann@x.org", tags: ["a", "b"], scores: {"math" => 9.5, "art" => 7.0}, home: Address.new(city: "Köln", zip: 50667), last: (3, "three"), events: [Event.Started, Event.Moved(Address.new(city: "Bonn", zip: 53111)), Event.Scored(2, 0.5), Event.Resized(w: 640, h: 480)], cache: 99)
  s = ~u.to_json
  puts s
  puts ~u.to_json_indent("", "  ")

  back = ~User.from_json(s)
  puts back.name
  puts back.home.city
  puts back.events.size
  puts back.cache
  puts (~back.to_json) == s

  # Unknown fields are ignored, absent ones are zero, null is none.
  partial = ~User.from_json("{\"name\": \"Bob\", \"age\": 7, \"email\": null, \"extra\": [1, {\"x\": true}], \"home\": {\"zip-code\": 1}}")
  puts partial.name
  puts partial.email.none?
  puts partial.home.zip
  puts partial.tags.size

  # Errors say what and where, like Go's.
  puts User.from_json("{\"name\": 5}").err?.message || ""
  puts User.from_json("{\"age\": 300}").err?.message || ""
  puts User.from_json("{\"name\": \"x\",}").err?.message || ""
  puts User.from_json("{\"events\": [\"Nope\"]}").err?.message || ""
  puts User.from_json("").err?.message || ""

  # Dynamic documents.
  v = ~json.parse("{\"users\": [{\"id\": 1, \"ok\": true}, {\"id\": 2, \"ok\": false}], \"total\": 2}")
  puts v.get("total").unwrap.as_int || 0
  v.get("users").unwrap.values.each { |x| puts "#{x.get("id").unwrap.as_int || 0} #{x.get("ok").unwrap.as_bool || false}" }
  puts v.keys.join(",")
  puts ~json.indent(v.to_s, "", "\t")
  puts json.quote("tab\t \"quoted\" <b>")
  puts json.valid("[1, 2,]")
  0
}

puts run.ok
