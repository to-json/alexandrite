# D62: encoding/json/v2 and jsontext through #[derive(Json)]: options,
# omitzero/omitempty, `string`, embedded fields and fallbacks, enums,
# transparent structs, errors with Go's text, a marshal function (type
# switch, D65), and the same type through v1. The signature of `names` is
# `~[Str]?<Error>` (fmt keeps `?<` tight).
import json "encoding/json/v2"
import "encoding/json/jsontext"

#[derive(Json)]
struct Point {
  x: Int
  y: Int
}

#[derive(Json)]
enum Shape {
  Dot
  Circle(Float)
  Rect(w: Float, h: Float)
}

#[derive(Json)]
struct Meta {
  #[field(json: "kind")] kind: Str
}

#[derive(Json)]
struct Doc {
  #[field(json: "title")] title: Str
  #[field(json: "n,omitzero")] n: Int
  #[field(json: "id,string")] id: U64
  #[field(json: "tags,omitempty")] tags: [Str]
  #[field(json: "at")] at: Point?
  #[field(json: "shapes")] shapes: [Shape]
  #[field(json: "raw")] raw: [Byte]
  #[field(json: ",embed")] meta: Meta
  #[field(json: ",embed")] rest: Map[Str, jsontext.Value]
}

#[derive(Json)]
#[json(transparent)]
struct Nums {
  v: Map[Int, Float]
}

def s(b: [Byte]) -> Str { Str.from_bytes(b) }

def names(d: Doc) -> ~[Str]?<Error> {
  return none if d.title == ""
  [d.title, d.meta.kind]
}

d = Doc.new(title: "t", id: 42, at: Point.new(x: 1, y: 2), shapes: [Shape.Dot, Shape.Circle(1.5), Shape.Rect(w: 2.0, h: 3.0)], raw: [1, 2, 3], meta: Meta.new(kind: "k"), rest: {"zz" => jsontext.Value.of("[true]")})
b = json.marshal(d, []).unwrap
puts s(b)
puts s(json.marshal(d, [jsontext.multiline(true), jsontext.with_indent("  ")]).unwrap).lines.size
d2: Doc = json.unmarshal(b, []).unwrap
puts d2.shapes[2]
puts "#{d2.title} #{d2.id} #{d2.at?.y || 0} #{d2.shapes.size} #{d2.raw} #{d2.meta.kind} #{d2.rest.size}"
puts names(d2).unwrap || ["none"]
puts s(json.marshal(Nums.new(v: {2 => 0.5, 1 => 1.0}), [json.deterministic(true)]).unwrap)
r: ~Doc = json.unmarshal("{\"title\":\"a\",\"title\":\"b\"}".bytes, [])
puts r.err?.message || ""
r2: ~Doc = json.unmarshal("{\"id\":7}".bytes, [])
puts r2.err?.message || ""
r3: ~Doc = json.unmarshal("{\"TITLE\":\"x\"}".bytes, [json.match_case_insensitive_names(true)])
puts r3.unwrap.title
m = json.marshal_func(->(p: Point) -> ~[Byte] { "\"#{p.x},#{p.y}\"".bytes.to_a })
puts s(json.marshal(d, [json.with_marshalers(m)]).unwrap).include?("\"at\":\"1,2\"")
# v1 has no encoding for jsontext.Value: in a v2 file that fails at run time.
puts d.to_json.err?.message || ""
puts Point.new(x: 3, y: 4).to_json.unwrap
