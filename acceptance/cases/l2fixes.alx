# Language fixes found while writing std L2: a loop that only returns,
# Array#join, interface wrappers made generic, bounds from packages, and
# structs wider than 12 fields (the Rust oracle).
import "io"
def f(n: Int) -> Int {
  i = 0
  loop {
    return i if i * i >= n
    i += 1
  }
}
puts f(10)
puts ["a", "b"].join(",")
puts [1, 2, 3].join("-")
puts ["x", "y"].join
e: [Str] = []
puts e.join(",").size
interface ByteSource {
  def read!(p: [Byte]) -> ~Int
}
struct Src {
  n: Int
  def read!(p: [Byte]) -> ~Int {
    return 0 if n == 0
    p[0] = 65
    self.n -= 1
    1
  }
}
struct Lim[T] {
  r: T
  left: Int
  def read!(p: [Byte]) -> ~Int {
    return 0 if left == 0
    got = r.~read!(p)
    self.left -= got
    got
  }
}
def drain(x: ByteSource) -> Int {
  y = x
  total = 0
  buf: [Byte] = [0]
  loop {
    n = y.read!(buf).unwrap_or(0)
    break if n == 0
    total += n
  }
  total
}
puts drain(Lim.new(r: Src.new(n: 10), left: 3))
puts drain(Src.new(n: 4))
def count_bytes[T: io.Reader](x: T) -> Int {
  y = x
  buf: [Byte] = [0, 0, 0, 0]
  total = 0
  loop {
    n = y.read!(buf).unwrap_or(0)
    break if n == 0
    total += n
  }
  total
}
struct Src2 {
  n: Int
  def read!(p: [Byte]) -> ~Int {
    return 0 if n == 0
    self.n -= 1
    1
  }
}
b = Src2.new(n: 11)
puts count_bytes(b)
struct Big {
  a: Int
  b: Int
  c: Int
  d: Int
  e: Int
  f: Int
  g: Int
  h: Int
  i: Int
  j: Int
  k: Int
  l: Int
  m: Str
  n: Int
}
x = Big.new(a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10, k: 11, l: 12, m: "thirteen", n: 14)
y = x
y.n = 99
puts x.n + y.n
puts x.m
puts x == y

# A struct holding a slice, returned through two fallible calls in a row
# (the inner call once allocated in the outer frame).
struct Fd {
  cell: [Int]
  def fd -> Int {
    cell[0]
  }
}
def mk_fd(fd: Int) -> Fd {
  cell: [Int] = [fd]
  Fd.new(cell: cell)
}
def open_fd(n: Str) -> ~Fd {
  fail "bad" if n.size == 0
  mk_fd(3)
}
def create_fd(n: Str) -> ~Fd {
  ~open_fd(n)
}
f = create_fd("x").unwrap
puts f.fd
a2 = [1, 2, 3, 4, 5, 6, 7, 8]
b2 = [9, 9, 9, 9]
puts f.fd
puts a2.size + b2.size

# Two defers, one a ! call: the frame is released once.
struct Closer2 {
  n: Int
  def close! -> ~Unit {
    fail "closed" if n < 0
    self.n = -1
  }
}
def done2(x: Int) -> Unit {
  puts "done #{x}"
}
def run_defers(k: Closer2) {
  defer done2(1)
  defer k.close!
  puts "body #{k.n}"
}
run_defers(Closer2.new(n: 3))
