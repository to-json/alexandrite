# Learn Ruby in Y minutes (learnxinyminutes.com), the parts that carry over.
# Not ported: symbols, `unless`, classes with inheritance, mixins, exceptions
# (alx has error values: see the errors example).

# --- numbers and arithmetic
puts 1 + 1
puts 8 - 1
puts 10 * 2
puts 35 / 5
puts 2 ** 5
puts 5 % 3
puts 3 & 5
puts 3 | 5
puts 3 ^ 5
puts 1.0 / 3

# --- booleans and comparison (only Bool is truthy)
puts !true
puts 1 == 1
puts 1 != 1
puts 1 < 10
puts 2 >= 2

# --- strings
placeholder = "use string interpolation"
puts "I can #{placeholder} when using double quoted strings"
puts "hello " + "world"
puts "hello " * 3
puts "hello world".include?("world")
puts "hello world".reverse
puts "hello world".split(" ")

# --- arrays
array = [1, 2, 3, 4, 5]
puts array[0]
puts array[array.size - 1]
puts array[2..3]
puts array.reverse
puts array.include?(3)
array << 6
puts array.size

# --- hashes (insertion-ordered maps)
hash = {"color" => "green", "number" => "five"}
puts hash["color"]
puts hash.keys
puts hash.values.size
puts hash.key?("number")
puts hash["nothing here"] || "absent"

# --- control structures
x = 7
if x > 10 {
  puts "big"
} else if x > 5 {
  puts "medium"
} else {
  puts "small"
}
(1..3).each { |counter| puts "iteration #{counter}" }
for counter in 1..3 { puts "for #{counter}" }
counter = 1
while counter <= 3 {
  puts "while #{counter}"
  counter += 1
}
for food, i in ["quiche", "salad"].each_with_index { puts "#{food} is ##{i}" }
puts array.map { it * 2 }
puts array.select(&:even?)
puts array.reduce(0) { |a, b| a + b }

grade = "B"
puts case grade {
  "A" => "Way to go kiddo"
  "B" => "Better luck next time"
  _ => "Alternative grading system, eh?"
}
puts case 82 {
  90..100 => "Hooray!"
  80...90 => "OK job"
  _ => "You failed!"
}

# --- methods: the last expression is the result
def double(x: Int) -> Int { x * 2 }
puts double(2)
def sum(x: Int, y: Int) -> Int { x + y }
puts sum(3, 4)
puts sum(sum(3, 4), 5)

# blocks and lambdas
def surround(f: (Str) -> Str) -> Str { "{ #{f("hello")} }" }
puts surround(->(s: Str) { s.reverse })

# --- structs in place of classes
struct Human {
  name: Str
  age: Int
  def say(msg: Str) -> Str { "#{name}: #{msg}" }
  def birthday! { self.age += 1 }
}
jim = Human.new(name: "Jim Halpert", age: 30)
puts jim.say("hello")
jim.birthday!
puts jim.age
