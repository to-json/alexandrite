# A def whose frame is a mark in its caller's region (it returns nothing
# and takes nothing with storage) allocating an argument in its frame while
# the call it is passed to makes its result in the program region:
# `bytes.new_buffer([])` with the buffer then written through an
# io.Writer. The frame's region variable was only set in defs with loops,
# so `[]` was made in a null region (a crash on every backend).

import "bytes"
import "io"

def put(w: io.Writer, n: Int) -> ~Unit {
  p: [Byte] = [0; n]
  ~io.write_all(w, p)
}

def run(n: Int) {
  buf = bytes.new_buffer([])
  put(buf, n).unwrap
  puts "wrote #{buf.len}"
}

run(3)
run(20000)
