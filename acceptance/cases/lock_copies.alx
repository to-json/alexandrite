# Copies share the locks they hold (port-issues #202): a Mutex reached
# through a copy must live as long as the copy, with no task involved.

# An error is copied out of the def that fails with it; its Mutex isn't.
error Held {
  Locked(m: Mutex[Int])

  def message -> Str { "locked" }
}

def make(n: Int) -> ~Int {
  m = Mutex.new(n)
  fail Held.Locked(m: m) if n > 0
  0
}

r = make(41)
junk: [Str] = []
(0...2000).each { junk << "junk #{it} ................................" }
if e = r.err {
  case e {
    Held.Locked(m) => puts m.lock { |v| v += 1; v }
    _ => puts "other"
  }
}
puts junk.size

# A map that churns in a loop gets a region of its own, compacted by
# copying its live entries (R3); entries holding a Mutex can't be copied
# away from it, so such a map isn't compacted.
struct Entry {
  note: Str
  hits: Mutex[Int]
}

cache: Map[Str, Entry] = {}
i = 0
while i < 20000 {
  key = i < 5 ? "keep#{i}" : "user#{i % 10}"
  cache[key] = Entry.new(note: "report #{i} for #{key} ........................................", hits: Mutex.new(i))
  i += 1
}
total = 0
cache.each { |k, en| total += en.hits.lock { |v| v } + k.size }
puts total
puts cache.size
