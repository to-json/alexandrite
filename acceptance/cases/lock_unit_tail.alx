# A lock block whose last expression is a Unit call (time's Ticker.stop: the C
# backend assigned the void call to a temporary), and a blank import (Go's
# `import _ "pkg"`, for a package's initializers alone: not an unused import).
import _ "strings"

def note(x: Int) {
  puts "note #{x}" if x > 1
}

m = Mutex.new(0)
m.lock { |s|
  s += 1
  note(s)
}
m.lock { |s|
  s += 1
  note(s)
}
m.lock { |s| note(s) }
puts m.lock { |s| s }
