# L1: the math package (libm intrinsics in every backend).
import "math"

# Values are rounded for printing: libm may differ in the last digit.
def r(x: Float) -> Str { format("%.9f", x) }

puts r(math.sin(1.0))
puts r(math.cos(1.0))
puts r(math.tan(1.0))
puts r(math.asin(0.5))
puts r(math.acos(0.5))
puts r(math.atan(1.0))
puts r(math.atan2(1.0, -1.0))
puts r(math.sinh(1.0))
puts r(math.cosh(1.0))
puts r(math.tanh(1.0))
puts r(math.asinh(1.0))
puts r(math.acosh(2.0))
puts r(math.atanh(0.5))
puts r(math.exp(1.0))
puts r(math.exp2(0.5))
puts r(math.expm1(1.0))
puts r(math.log(10.0))
puts r(math.log2(10.0))
puts r(math.log10(2.0))
puts r(math.log1p(1.0))
puts r(math.pow(2.0, 0.5))
puts r(math.cbrt(2.0))
puts r(math.hypot(3.0, 4.0))
puts r(math.erf(0.5))
puts r(math.erfc(0.5))
puts r(math.gamma(4.5))
puts r(math.lgamma(0.5)[0])
puts math.lgamma(-0.5)[1]
puts r(math.fma(2.0, 3.0, 1.0))
puts r(math.mod(-7.5, 2.0))
puts r(math.remainder(7.0, 3.0))
puts math.ceil(1.2)
puts math.floor(-1.2)
puts math.trunc(-1.9)
puts math.round(2.5)
puts math.round_to_even(2.5)
puts math.max(1.0, 2.0)
puts math.min(math.nan, 2.0)
puts math.inf(1)
puts math.inf(-1)
puts math.is_nan(math.nan)
puts math.is_inf(math.inf(-1), -1)
puts math.signbit(-0.0 * 1.0)
puts math.float64bits(1.5)
puts math.float64frombits(0x4009_21FB_5444_2D18)
puts math.frexp(12.0)[1]
puts math.ldexp(0.75, 4)
puts math.modf(-3.25)[1]
puts math.PI
puts math.MAX_INT
puts math.MAX_FLOAT64
puts 2.0.pow(10.0)
puts 0.5.sin > 0.47
puts math.dim(3.0, 5.0)
puts math.nextafter(1.0, 2.0) > 1.0
puts math.ilogb(8.0)
