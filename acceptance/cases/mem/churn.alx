# R3: a long-lived cache that keeps replacing its entries. Its contents
# live in its own region, compacted when garbage outweighs live data.
cache: Map[Str, Str] = {}
i = 0
while i < 300000 {
  key = "user#{i % 100}"
  cache[key] = "report #{i} for #{key}"
  i += 1
}
puts cache.size
puts cache["user42"] || "?"
