# R3 (port-issues #273): running child processes in a loop runs in bounded
# memory. Each shape used to leave 20-85 KB per run in the program region:
# a Cmd built by a helper from its parameters (the language server's
# shape), with an environment and a timeout; inline capture; output.
import "os"
import "os/exec"
import "time"

N = 1000

struct Request {
  prog: Str
  word: Str
}

def command(req: Request, env: Bool) -> exec.Cmd {
  args = ["-c", "echo #{req.word}; echo err >&2"]
  c = exec.command(req.prog, args)
  c.check = false
  c.env = os.environ + ["ALX_MEM_EXEC=#{req.word}"] if env
  c
}

def run(c: exec.Cmd) -> ~exec.Captured {
  c.timeout = time.Duration.new(20000000000)
  c.~capture
}

total = 0
for i in 0...N {
  req = Request.new(prog: "sh", word: "w#{i % 7}")
  r = run(command(req, i % 2 == 0))
  cap = r.unwrap
  total += cap.stdout.size + cap.stderr.size + cap.state.exit_code
  out = exec.command("true", []).capture.unwrap
  total += out.stdout.size
  total += exec.command("echo", ["x"]).output.unwrap.size
}
puts total
