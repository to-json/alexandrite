# R7: `alx explain mem` names each allocation's region and why.
log: [Str] = []
cache: Map[Int, Str] = {}
i = 0
while i < 1000 {
  line = "line #{i}"
  cache[i % 10] = "value #{i}"
  if i % 100 == 0 {
    log << line
  }
  t = spawn { "task #{i}" }
  puts t.wait.unwrap.size
  i += 1
}
puts log.size
