# R2: a helper stores into its caller's container; the stored values live
# where the container does (here, one loop iteration), not forever.
def tally(m: Map[Str, Int], n: Int) {
  (1..20).each { m["word #{it % 7} of #{n}"] += 1 }
}

total = 0
i = 0
while i < 20000 {
  counts: Map[Str, Int] = {}
  tally(counts, i)
  total += counts.size
  i += 1
}
puts total
