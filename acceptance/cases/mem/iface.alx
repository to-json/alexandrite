# R3 (port-issues #178): a loop that hands each request to a client through
# a generic `[C: Client]` parameter and through an interface value keeps its
# result map bounded, though the client keeps part of every request: what
# the client returns is new (an interpolation, a copy), not the request.
LAST = Atomic.new("")

struct Request {
  alx: Str
  file: Str
}

struct Outcome {
  report: Str
  failure: Str
}

interface Client {
  def check!(req: Request) -> Outcome
}

struct Remote {
  calls: Int

  def check!(req: Request) -> Outcome {
    LAST.store(req.alx)
    self.calls += 1
    Outcome.new(report: "r" * 20000 + "#{req.file.size}", failure: "cannot run #{req.alx}")
  }
}

def serve[C: Client](client0: C, n: Int) -> Int {
  results: Map[Str, Str] = {}
  client = client0
  i = 0
  total = 0
  while i < n {
    req = Request.new(alx: "alx#{i % 3}", file: "f#{i}")
    out = client.check!(req)
    results["k#{i % 5}"] = out.report
    total += out.failure.size + (results["k1"] || "").size
    i += 1
  }
  total
}

def serve_iface(client: Client, n: Int) -> Int {
  results: Map[Str, Str] = {}
  i = 0
  total = 0
  while i < n {
    req = Request.new(alx: "alx#{i % 3}", file: "f#{i}")
    out = client.check!(req)
    results["k#{i % 5}"] = out.report
    total += out.failure.size + (results["k1"] || "").size
    i += 1
  }
  total
}

puts serve(Remote.new(calls: 0), 3000) + serve_iface(Remote.new(calls: 0), 3000)
