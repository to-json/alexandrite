total = 0
i = 0
while i < 200000 {
  s = "line #{i} of the log"
  parts = s.split(" ")
  total += parts.size
  i += 1
}
puts total
(1..200000).each {
  t = "x#{it}" + "y"
  total += t.size
  next if it % 2 == 0
  total += 1
}
puts total
for k in 1..200000 {
  u = "k#{k}"
  break if k == 150000
  total += u.size
}
puts total
def find_first(n: Int) -> Str {
  i = 0
  while i < n {
    w = "w#{i}"
    return w if i == n - 1
    i += 1
  }
  "none"
}
puts find_first(50000)
keep = ""
(1..3).each { keep = "k#{it}" } # loop-carried: must survive
puts keep
last = "start"
i = 0
while i < 3 {
  if i == 1 { last = "middle #{i}" } # conditionally carried
  i += 1
}
puts last
