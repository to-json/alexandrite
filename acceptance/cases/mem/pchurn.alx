# R3: a pool that churns (add one, remove the oldest) stays bounded:
# freed slots are reused and the contents' region is compacted.
struct Job {
  name: Str
  out: Str
}

jobs = Pool[Job].new
ring: [@Job] = []
i = 0
while i < 200000 {
  h = jobs.add(Job.new(name: "job#{i}", out: "result of job #{i} for #{i % 7}"))
  if ring.size < 50 {
    ring << h
  } else {
    jobs.remove(ring[i % 50])
    ring[i % 50] = h
  }
  i += 1
}
puts jobs.size
