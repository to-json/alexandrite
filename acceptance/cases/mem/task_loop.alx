# R1 in a task (port-issues #277): what each pass of a loop in a `spawn`
# body makes is freed with the pass, as in a def's loop; what the body makes
# outside its loops lives in the task's frame, freed when the task ends.
# Before the fix every allocation of a task body went to the program region
# (2M passes of `time.now()`: 34 MB, against 1.8 MB on the main thread).
import "strings"
import "time"

def count(n: Int) -> Task[Int] {
  spawn {
    sep = strings.repeat(",", 2)
    s = 0
    i = 0
    loop {
      break if i >= n
      t = time.now()
      parts = "#{i}#{sep}#{t.nanosecond % 7}".split(sep)
      s += parts.size
      i += 1
    }
    s
  }
}

# A task's result (and what it returns) outlives it.
def words(n: Int) -> [Str] {
  t = spawn {
    out: [Str] = []
    for i in 0...n {
      w = "w#{i}"
      out << "#{w}!" if w.size == 2
    }
    out
  }
  t.wait.unwrap
}

total = 0
for _k in 0...4 {
  total += count(500000).wait.unwrap
}
puts total
puts words(1000000).join(" ")
