# R5: 100000 tasks in a daisy chain. Each receives from its left channel,
# adds 1 and sends right; main feeds 0 in and reads 100000 out.
n = 100000
first = Chan[Int].new
left = first
i = 0
while i < n {
  right = Chan[Int].new
  l = left
  spawn { right << (l.recv || 0) + 1 }
  left = right
  i += 1
}
first << 0
puts left.recv
