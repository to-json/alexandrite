# R3 (port-issues #177): a document map replaced 3,000 times with 20 KB
# texts stays bounded while helpers index it by key arguments, named locals
# hold what is read from it within one iteration, and its keys are iterated.
import "strings"

N = 3000

def text(i: Int) -> Str {
  strings.repeat("x", 20000) + "#{i}"
}

def size_of(m: Map[Str, Str], k: Str) -> Int {
  (m[k] || "").size
}

def get_or(m: Map[Str, Str], k: Str) -> Str {
  m[k] || ""
}

def serve -> Int {
  docs: Map[Str, Str] = {}
  i = 0
  total = 0
  while i < N {
    uri = "file#{i % 10}"
    docs[uri] = text(i)
    total += size_of(docs, "file#{i % 7}") + get_or(docs, uri).size
    if i % 2 == 0 {
      t = docs["file1"] || ""
      total += t.size
    }
    if old = docs["file2"] {
      total += old[0...4].size
    }
    if i % 100 == 0 {
      for k in docs.keys {
        total += (docs[k] || "").size
      }
      for k, v in docs {
        total += k.size + v.size
      }
    }
    i += 1
  }
  total
}

puts serve
