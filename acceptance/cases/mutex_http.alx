# A Mutex captured by an HTTP handler stays shared across the request tasks
# the handler is copied into (port-issues #65).
import "net"
import "net/http"

hits = Mutex.new(0)
mux = http.new_serve_mux
mux.handle_func("/inc") { |w, r|
  hits.lock { |v| v += 1 }
  w.write_string!("ok")
}
srv = http.new_server(mux)
ln = net.listen("tcp", "127.0.0.1:0").unwrap
base = "http://127.0.0.1:#{ln.port}"
serving = spawn { srv.serve(ln) }
for i in 0...5 { http.get(base + "/inc").unwrap }
srv.shutdown
serving.wait
puts hits.lock { |v| v }
