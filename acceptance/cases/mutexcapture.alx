# A Mutex captured by a lambda stays shared when the lambda is copied into
# other tasks (port-issues #65): out of a Mutex-held table, via .dup, and as
# an HTTP handler run in each request's task.
import "net"
import "net/http"

struct Routes {
  hs: [() -> Unit]
}

count = Mutex.new(0)
table = Mutex.new(Routes.new(hs: []))
h = -> () -> Unit {
  count.lock { |v| v += 1 }
  nil
}
table.lock { |r| r.hs << h }
ts: [Task[Unit]] = []
for i in 0...4 {
  f = table.lock { |r| r.hs[0] }
  ts << spawn { f.call }
}
for t in ts { t.~wait }
puts count.lock { |v| v }

mu = Mutex.new(0)
g0 = -> () { mu.lock { |v| v += 1 } }
ts2 = (0...4).map { |i|
  g = g0.dup
  spawn { g.call }
}.to_a
for t in ts2 { t.~wait }
puts mu.lock { |v| v }

hits = Mutex.new(0)
mux = http.new_serve_mux
mux.handle_func("/inc") { |w, r|
  hits.lock { |v| v += 1 }
  w.write_string!("ok")
}
srv = http.new_server(mux)
ln = net.listen("tcp", "127.0.0.1:0").unwrap
base = "http://127.0.0.1:#{ln.port}"
serving = spawn { srv.serve(ln) }
for i in 0...5 { http.get(base + "/inc").unwrap }
srv.shutdown
serving.wait
puts hits.lock { |v| v }
