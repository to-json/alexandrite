# The Computer Language Benchmarks Game: n-body (single-threaded), 1,000,000 steps.
struct Body {
  x: Float, y: Float, z: Float
  vx: Float, vy: Float, vz: Float
  mass: Float
}

def energy(bodies: [Body]) -> Float {
  e = 0.0
  bodies.each_with_index.each { |b, i|
    e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
    (i + 1...bodies.size).each { |j|
      b2 = bodies[j]
      dx = b.x - b2.x
      dy = b.y - b2.y
      dz = b.z - b2.z
      e -= b.mass * b2.mass / Math.sqrt(dx * dx + dy * dy + dz * dz)
    }
  }
  e
}

pi = 3.141592653589793
solar_mass = 4 * pi * pi
days_per_year = 365.24

bodies = [
  Body.new(mass: solar_mass), # sun
  Body.new( # jupiter
    x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01,
    vx: 1.66007664274403694e-03 * days_per_year, vy: 7.69901118419740425e-03 * days_per_year, vz: -6.90460016972063023e-05 * days_per_year,
    mass: 9.54791938424326609e-04 * solar_mass,
  ),
  Body.new( # saturn
    x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01,
    vx: -2.76742510726862411e-03 * days_per_year, vy: 4.99852801234917238e-03 * days_per_year, vz: 2.30417297573763929e-05 * days_per_year,
    mass: 2.85885980666130812e-04 * solar_mass,
  ),
  Body.new( # uranus
    x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01,
    vx: 2.96460137564761618e-03 * days_per_year, vy: 2.37847173959480950e-03 * days_per_year, vz: -2.96589568540237556e-05 * days_per_year,
    mass: 4.36624404335156298e-05 * solar_mass,
  ),
  Body.new( # neptune
    x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01,
    vx: 2.68067772490389322e-03 * days_per_year, vy: 1.62824170038242295e-03 * days_per_year, vz: -9.51592254519715870e-05 * days_per_year,
    mass: 5.15138902046611451e-05 * solar_mass,
  ),
]

# Offset the sun's momentum so the system's total is zero.
px = py = pz = 0.0
bodies.each { |b|
  px += b.vx * b.mass
  py += b.vy * b.mass
  pz += b.vz * b.mass
}
bodies[0].vx = -px / solar_mass
bodies[0].vy = -py / solar_mass
bodies[0].vz = -pz / solar_mass

puts format("%.9f", energy(bodies))
dt = 0.01
n = bodies.size
(1..1_000_000).each {
  (0...n).each { |i|
    (i + 1...n).each { |j|
      dx = bodies[i].x - bodies[j].x
      dy = bodies[i].y - bodies[j].y
      dz = bodies[i].z - bodies[j].z
      d2 = dx * dx + dy * dy + dz * dz
      mag = dt / (d2 * Math.sqrt(d2))
      bodies[i].vx -= dx * bodies[j].mass * mag
      bodies[i].vy -= dy * bodies[j].mass * mag
      bodies[i].vz -= dz * bodies[j].mass * mag
      bodies[j].vx += dx * bodies[i].mass * mag
      bodies[j].vy += dy * bodies[i].mass * mag
      bodies[j].vz += dz * bodies[i].mass * mag
    }
  }
  (0...n).each { |i|
    bodies[i].x += dt * bodies[i].vx
    bodies[i].y += dt * bodies[i].vy
    bodies[i].z += dt * bodies[i].vz
  }
}
puts format("%.9f", energy(bodies))
