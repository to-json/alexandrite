# Struct layouts that nest the same fields differently must stay distinct
# types in C: G[W] is ((A), Int, Int) and Holder is ((A, Int, Int)); both
# flattened to the same C name before tuple names carried their arity
# (found by the crypto/cipher port: Gcm[Wrapper] and GcmWithRandomNonce).

struct A {
  a: Int
  b: [Int]

  def size -> Int { a + b.size }
}

struct W {
  inner: A

  def size -> Int { inner.size * 2 }
}

struct G[B] {
  b: B
  n: Int
  m: Int

  def total -> Int { n + m + b.size }
}

struct Holder {
  g: G[A]

  def total -> Int { g.total }
}

w = G.new(b: W.new(inner: A.new(a: 1, b: [7])), n: 1, m: 1)
puts w.total
h = Holder.new(g: G.new(b: A.new(a: 5, b: [1, 2]), n: 12, m: 16))
puts h.total
puts h.g.b.b[1]
