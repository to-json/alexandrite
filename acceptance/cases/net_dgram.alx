# UDP and Unix-domain sockets through std/net (the runtime's alx_sock_open /
# alx_sock_recvfrom, from the log/syslog port).
import "net"
import "os"

def b(s: Str) -> [Byte] { s.bytes.to_a }

pc = net.listen_packet("udp", "127.0.0.1:0").unwrap
c = net.dial("udp", pc.local_addr).unwrap
c.write!(b("over udp")).unwrap
buf: [Byte] = [0; 64]
n, from = pc.read_from!(buf).unwrap
puts Str.from_bytes(buf[0...n])
puts from == c.local_addr
c.close!.unwrap
pc.close!.unwrap

dir = os.mkdir_temp("", "").unwrap
path = dir + "/g"
g = net.listen_packet("unixgram", path).unwrap
gc = net.dial("unixgram", path).unwrap
gc.write!(b("over unixgram")).unwrap
n2, _ = g.read_from!(buf).unwrap
puts Str.from_bytes(buf[0...n2])
gc.close!.unwrap
g.close!.unwrap

spath = dir + "/s"
l = net.listen("unix", spath).unwrap
t = spawn {
  s = l.accept.unwrap
  k = s.read!(buf).unwrap
  s.write!(buf[0...k]).unwrap
  s.close!.unwrap
}
sc = net.dial("unix", spath).unwrap
sc.write!(b("over unix")).unwrap
back: [Byte] = [0; 64]
k2 = sc.read!(back).unwrap
puts Str.from_bytes(back[0...k2])
t.wait
sc.close!.unwrap
l.close!.unwrap
puts os.stat(spath).ok?
puts net.dial("unix", spath).err?
os.remove_all(dir).unwrap
