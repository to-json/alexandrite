# Compiler fixes found while porting net/mail and net/smtp.
import "bytes"
import "io"
import "mime/quotedprintable"

# 1. A generic function whose parameter is another package's generic type
# (`quotedprintable.Reader[R]`) binds R from the argument: the instance's
# base name is qualified by the import path (`mime/quotedprintable.Reader`).
# 2. Inside that package, a generic constructor (`Reader.new(st: st)` with
# `st: [ReaderState[T]]`) infers T when called from another package's
# generic function.
def drain[R](r: quotedprintable.Reader[R]) -> Str {
  Str.from_bytes(io.read_all(r).unwrap)
}

def wrap[R: io.Reader](src: R) -> quotedprintable.Reader[R] {
  quotedprintable.new_reader(src)
}

puts drain(quotedprintable.new_reader(bytes.new_buffer_string("caf=C3=A9")))
puts drain(wrap(bytes.new_buffer_string("a=3Db")))
