# Compiler fixes found while porting net/rpc (S3).
import "encoding/json"

#[derive(Json)]
struct Args {
  a: Int
  b: Int
}

#[derive(Json)]
struct Reply {
  c: Int
}

# 1. A static method called on a type parameter: `T` is the concrete type
# of the instance (`Args.from_json`).
def decode[T](s: Str) -> ~T {
  ~T.from_json(s)
}

x: Args = decode("{\"a\":1,\"b\":2}").unwrap
puts x

# 2. A fallible def passed where a fallible function is wanted (it was
# wrapped in a lambda whose body didn't propagate).
def mul(a: Args) -> ~Reply {
  fail "negative" if a.a < 0
  Reply.new(c: a.a * a.b)
}

def apply[A, R](f: (A) -> ~R, a: A) -> ~R {
  ~f(a)
}

def run(f: (Args) -> ~Reply, a: Args) -> ~Reply {
  ~f(a)
}

puts run(mul, Args.new(a: 6, b: 7)).unwrap.c
puts apply(mul, Args.new(a: 2, b: 3)).unwrap.c
puts apply(mul, Args.new(a: -1, b: 3)).err.unwrap.message

# 3. A type parameter taken only from a held `~T` the result is wanted as.
struct Holder {
  text: Str

  def get[R] -> ~R {
    ~R.from_json(text)
  }
}

h = Holder.new(text: "{\"c\":5}")
r: ~Reply = h.get
puts r.unwrap.c

# 4. Type parameters bound through Mutex / Chan / Atomic fields and through
# another package's generic types.
struct Cell[T] {
  m: Mutex[T]
}

def cell[T](v: T) -> Cell[T] {
  Cell.new(m: Mutex.new(v))
}

c = cell(41)
puts c.m.lock { |v| v + 1 }
