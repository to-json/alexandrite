# Language fixes from the net/http subpackage ports (S3).
import "container/list"

# A type parameter binds through another package's generic struct
# (`list.List[T]`): it named the instance by its full path and didn't match.
def size_of[T](l: list.List[T]) -> Int {
  l.len
}

def first_or[T](l: list.List[T], d: T) -> T {
  if e = l.front {
    return e.value
  }
  d
}

l = list.List[Int].new
l.push_back!(4)
l.push_back!(5)
puts size_of(l)
puts first_or(l, 0)
s = list.List[Str].new
puts first_or(s, "empty")
