# An optional function type is written in parentheses: `((A) -> R)?`
# (mime.WordDecoder's charset_reader). Also: a main-file type named like a
# type of an imported package (bufio's Reader) doesn't capture the package's
# own uses of that name.
import "bufio"
import "bytes"

struct Reader {
  name: Str
}

struct Conv {
  f: ((Str, Int) -> ~Str)?

  def run(s: Str, n: Int) -> ~Str {
    if g = f {
      return ~g(s, n)
    }
    "plain #{s}"
  }
}

def apply(f: ((Int) -> Int)?, x: Int) -> Int {
  if g = f {
    return g(x)
  }
  x
}

c = Conv.new
puts c.run("a", 1).unwrap
c.f = ->(s: Str, n: Int) -> ~Str {
  fail "too many" if n > 2
  s * n
}
puts c.run("ab", 2).unwrap
puts c.run("ab", 3).err.unwrap.message
d = Conv.new(f: none)
puts d.run("x", 0).unwrap
puts apply(->(x: Int) -> Int { x * 10 }, 4)
puts apply(none, 4)
t: (Int) = 5
puts t

r = Reader.new(name: "mine")
br = bufio.new_reader(bytes.new_buffer_string("line one\nline two\n"))
puts r.name
puts br.read_line!.unwrap || ""
