# M6: packages. Directories are packages; `pub` exports.
import "pkgs/geom"
import sh "pkgs/shapes"

p = geom.Point.new(x: 3.0, y: 4.0)
puts p.norm
p.shift!(1.0)
puts p.x
puts geom.dist(p, geom.origin)
puts geom.ORIGIN_NAME
s = geom.Stack[Int].new
s.push!(5)
puts s.size
a = ~sh.circle(0.0, 0.0, 1.0)
b = ~sh.circle(3.0, 4.0, 2.0)
puts a.area + b.area
puts sh.spread([a, b])
r = sh.circle(0.0, 0.0, -1.0)
if e = r.err { puts e }
pt: geom.Point = geom.origin
puts pt
