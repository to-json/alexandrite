# Command literals in a file that imports os/exec itself use that import, so
# it counts as used (run with --strict: no warning). A local that hides the
# name doesn't break them.
import "os/exec"

out = `echo hi`.~output
print out
puts "#{`echo nested`.~output.strip} in a string"

def hidden -> ~Str {
  exec = 1
  `echo #{exec}`.~output
}

print hidden.unwrap
