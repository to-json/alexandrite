# Parser and lexer fixes (docs/notes/parser-lexer-review.md). Run with
# --strict too: no warning may appear (a backtick inside `#{...}` used to
# add an unused os/exec import).

error Oops {
  Bad(n: Int)
  def message -> Str { "oops" }
}

# A keyword names a field or a method.
struct Job {
  fail: Int
  def spawn -> Str { "job.spawn #{self.fail}" }
}

struct T {
  name: Str
  def fail -> Str { "#{name}.fail" }
}

def check(n: Int) -> ~Int<Oops> {
  fail(Oops.Bad(n: n)) if n < 0 # `fail(e)` is `fail (e)`
  n
}

def find(xs: [Int]) -> Int? {
  return none if xs.size == 0
  xs[0]
}

def first(xs: [Int]) -> ~Int {
  v = find(xs) || fail(Oops.Bad(n: 0))
  v
}

TABLE = [10, 20, 30]

x = 3
# A backtick in a string inside `#{...}` is not a command literal.
puts "tick #{ "`" }"
# A `#` comment inside `#{...}` runs to the end of its line.
puts "a#{ x # the } here doesn't close it
}b"
# Strings with their own `#{}` and braces nest.
puts "#{ "in{#{x + 1}}" }"

# Heredocs interpolate; `\#{` stays literal.
doc = <<~EOS
  x is #{x}, \#{x} is not
    #{[1, 2].map { it * 10 }} indented
  done
EOS
print doc

# A line starting with `.` or `?.` continues the expression.
ys = [1, 2, 3, 4]
  .map { it * 2 }
  # a comment between the steps
  .select { it > 2 }
puts ys
o: Int? = 7
s = o
  ?.to_s
puts s || "none"
n = "42"
  .size
puts n
puts check(5)
  .unwrap

# The right side of `=` (and `op=`, `a, b =`) may start on the next line.
w =
  1 + 2
w +=
  4
a, b =
  5, 6
puts w + a + b
ys[0] =
  100
puts ys

j = Job.new(fail: 9)
puts j.fail + 1
puts j.spawn
puts T.new(name: "t").fail

r = check(-1)
puts r.err?.message || "ok"
puts first([]).err?.message || "ok"
t = spawn { 1 + 1 }
puts t.~wait

# Contextual words stay usable as locals.
pub = 2
import = 3
puts pub + import
puts TABLE[1]
