# pe012: the first triangle number with over 500 divisors
def divisors(n: Int) -> Int {
  count = 1
  m = n
  p = 2
  while p * p <= m {
    e = 0
    while m % p == 0 {
      m /= p
      e += 1
    }
    count *= e + 1
    p += 1
  }
  m > 1 ? count * 2 : count
}

n = 1
loop {
  # n(n+1)/2 with coprime halves
  d = n.even? ? divisors(n / 2) * divisors(n + 1) : divisors(n) * divisors((n + 1) / 2)
  if d > 500 {
    puts n * (n + 1) / 2
    break
  }
  n += 1
}
