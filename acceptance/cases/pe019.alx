# pe019: Sundays on the first of the month, 1901-2000
def days_in(month: Int, year: Int) -> Int {
  case month {
    2 => (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 ? 29 : 28
    4 | 6 | 9 | 11 => 30
    _ => 31
  }
}

dow = 1 # 1 Jan 1900 was a Monday (0 = Sunday)
sundays = 0
for year in 1900..2000 {
  for month in 1..12 {
    sundays += 1 if year >= 1901 && dow == 0
    dow = (dow + days_in(month, year)) % 7
  }
}
puts sundays
