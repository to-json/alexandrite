# pe023: the sum of numbers that aren't the sum of two abundant numbers
LIMIT = 28123
sums = [0; LIMIT + 1]
for i in 1..LIMIT / 2 {
  j = i * 2
  while j <= LIMIT {
    sums[j] += i
    j += i
  }
}
abundant = (12..LIMIT).select { sums[it] > it }.to_a
expressible = [false; LIMIT + 1]
for a in abundant {
  for b in abundant {
    break if a + b > LIMIT
    expressible[a + b] = true
  }
}
puts (1..LIMIT).select { !expressible[it] }.sum
