# pe200: the 200th prime-proof sqube (p^2 q^3, p and q distinct primes)
# containing "200". Squbes up to a bound, sorted; the bound doubles until
# there are enough.
import "slices"
import "strings"

# a * b mod m for a, b < m < 2^40, without overflowing: b in two halves.
def mulmod(a: Int, b: Int, m: Int) -> Int {
  hi = a * (b >> 20) % m
  (hi * (1 << 20) + a * (b & ((1 << 20) - 1))) % m
}

def powmod(b: Int, e: Int, m: Int) -> Int {
  r = 1
  x = b % m
  k = e
  while k > 0 {
    r = mulmod(r, x, m) if k & 1 == 1
    x = mulmod(x, x, m)
    k >>= 1
  }
  r
}

# Deterministic Miller-Rabin below 3.4 * 10^14.
def prime?(n: Int) -> Bool {
  return false if n < 2
  for p in [2, 3, 5, 7, 11, 13, 17] {
    return n == p if n % p == 0
  }
  d = n - 1
  s = 0
  while d % 2 == 0 {
    d /= 2
    s += 1
  }
  for a in [2, 3, 5, 7, 11, 13, 17] {
    x = powmod(a, d, n)
    next if x == 1 || x == n - 1
    composite = true
    for _ in 1...s {
      x = mulmod(x, x, n)
      if x == n - 1 {
        composite = false
        break
      }
    }
    return false if composite
  }
  true
}

# No single-digit change (keeping the leading digit nonzero) makes a prime.
def prime_proof?(n: Int) -> Bool {
  s = n.to_s
  for i in 0...s.size {
    place = 1
    for _ in 0...s.size - 1 - i { place *= 10 }
    d = (n / place) % 10
    base = n - d * place
    for nd in 0..9 {
      next if nd == d || (i == 0 && nd == 0)
      return false if prime?(base + nd * place)
    }
  }
  true
}

def primes_to(n: Int) -> [Int] {
  sieve = [true; n + 1]
  out: [Int] = []
  for i in 2..n {
    next if !sieve[i]
    out << i
    j = i * i
    while j <= n {
      sieve[j] = false
      j += i
    }
  }
  out
}

bound = 1_000_000_000
loop {
  ps = primes_to(Int.sqrt(bound / 8) + 1)
  squbes: [Int] = []
  for q in ps {
    q3 = q * q * q
    break if q3 * 4 > bound
    for p in ps {
      break if p * p * q3 > bound
      squbes << p * p * q3 if p != q
    }
  }
  slices.sort(squbes)
  found = 0
  for n in squbes {
    if strings.contains(n.to_s, "200") && prime_proof?(n) {
      found += 1
      if found == 200 {
        puts n
        break
      }
    }
  }
  break if found == 200
  bound *= 2
}
