# pe300: the average number of H-H contacts in an optimal 2D folding of a
# random H/P string of length 15.
#
# A folding is a self-avoiding walk on the square lattice. Its contacts are
# pairs (i, j), i < j, of elements that end up adjacent (neighbours in the
# chain always are); on a square lattice j - i is odd, so for n = 15 there
# are only 56 possible pairs and a folding's contacts fit in one Int as a
# bitmask. Many walks share a mask,
# and a mask inside another one never scores more, so only the maximal ones
# are kept. A string then scores the most H-H pairs any mask holds.
import "slices"

def popcount(x: Int) -> Int {
  v = x
  n = 0
  while v != 0 {
    v &= v - 1
    n += 1
  }
  n
}

# Pair (i, j)'s bit, or -1 if it can't be a contact.
def pair_bits(n: Int) -> [[Int]] {
  bits = [[-1; n]; n]
  k = 0
  for i in 0...n {
    j = i + 1
    while j < n {
      bits[i][j] = k
      k += 1
      j += 2
    }
  }
  bits
}

# Every folding's contact mask (walks from the origin, first step east, first
# turn north: rotations and reflections fold the same way).
def contact_masks(n: Int) -> [Int] {
  bits = pair_bits(n)
  size = 2 * n + 1
  at = [-1; size * size] # element index at each cell, -1 empty
  xs = [0; n]
  ys = [0; n]
  masks: Map[Int, Bool] = {}
  dx = [1, 0, -1, 0]
  dy = [0, 1, 0, -1]
  # An explicit stack: the direction tried next at each depth.
  next_dir = [0; n]
  xs[0] = n
  ys[0] = n
  at[n * size + n] = 0
  xs[1] = n + 1
  ys[1] = n
  at[n * size + n + 1] = 1
  depth = 2
  next_dir[2] = 0
  turned = [false; n + 1]
  while depth >= 2 {
    if depth == n {
      # A full folding: its contacts.
      m = 0
      for i in 0...n {
        for d in 0...4 {
          nx = xs[i] + dx[d]
          ny = ys[i] + dy[d]
          j = at[ny * size + nx]
          m |= 1 << bits[i][j] if j > i && bits[i][j] >= 0
        }
      }
      masks[m] = true
      depth -= 1
      at[ys[depth] * size + xs[depth]] = -1
      next
    }
    d = next_dir[depth]
    if d == 4 {
      depth -= 1
      at[ys[depth] * size + xs[depth]] = -1 if depth >= 2
      next
    }
    next_dir[depth] = d + 1
    # Before the first turn, only east (straight) or north.
    if !turned[depth - 1] && d != 0 && d != 1 {
      next
    }
    nx = xs[depth - 1] + dx[d]
    ny = ys[depth - 1] + dy[d]
    next if at[ny * size + nx] >= 0
    xs[depth] = nx
    ys[depth] = ny
    at[ny * size + nx] = depth
    turned[depth] = turned[depth - 1] || d == 1
    depth += 1
    next_dir[depth] = 0 if depth < n
  }
  ms = masks.keys
  slices.sort(ms)
  ms.reverse!
  # Keep the maximal masks.
  kept: [Int] = []
  for m in ms {
    kept << m if !kept.any? { |k| k & m == m }
  }
  kept
}

# The exact average as a decimal: total / 2^n terminates.
def exact(total: Int, n: Int) -> Str {
  den = 1 << n
  s = (total / den).to_s + "."
  r = total % den
  while r != 0 {
    r *= 10
    s += (r / den).to_s
    r %= den
  }
  s[s.size - 1] == 46 ? s[0...s.size - 1] : s
}

def average(n: Int) -> Str {
  masks = contact_masks(n)
  bits = pair_bits(n)
  total = 0
  for h in 0...(1 << n) {
    # The pairs whose ends are both H.
    hh = 0
    for i in 0...n {
      next if (h >> i) & 1 == 0
      j = i + 1
      while j < n {
        hh |= 1 << bits[i][j] if (h >> j) & 1 == 1
        j += 2
      }
    }
    best = 0
    for m in masks {
      c = popcount(m & hh)
      best = c if c > best
    }
    total += best
  }
  exact(total, n)
}

puts average(8)
puts average(15)
