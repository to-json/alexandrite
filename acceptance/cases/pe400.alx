# pe400: the first player's winning moves on the Fibonacci tree T(10000),
# last 18 digits. Taking a node removes its subtree, taking the root loses:
# by the colon principle a tree's Grundy value is the xor over its children
# of (child's value + 1), so G(k) = (G(k-1) + 1) xor (G(k-2) + 1).
# C(k)[g] counts the moves inside T(k) (not its root) that leave the whole
# tree at value g. A move in the left subtree T(k-1) either takes its root
# (that side then contributes 0) or leaves it at some x (contributing x + 1);
# likewise on the right. Winning moves leave value 0: f(k) = C(k)[0].
MOD = 1_000_000_000_000_000_000

# a + b mod MOD for a, b < MOD (no overflow: MOD < 2^60).
def addm(a: Int, b: Int) -> Int {
  s = a + b
  s >= MOD ? s - MOD : s
}

# Room for every value (x + 1) ^ c with x < n and c <= m: the next power of
# two above both.
def width(n: Int, m: Int) -> Int {
  w = 1
  while w <= n || w <= m { w *= 2 }
  w
}

# The used length of c: up to its last nonzero entry.
def used(c: [Int], n: Int) -> Int {
  e = n
  while e > 1 && c[e - 1] == 0 { e -= 1 }
  e
}

def f(n: Int) -> Int {
  return 0 if n < 3
  g = [0; n + 1]
  g[2] = 1
  for k in 3..n { g[k] = (g[k - 1] + 1) ^ (g[k - 2] + 1) }
  # Three buffers in rotation: C(k-2), C(k-1) and the one being made, each
  # with its used length. C(1) is empty; C(2): only T(1) can go -> value 0.
  size = 1024
  bufs = [[0; size], [0; size], [0; size]]
  lens = [1, 1, 0]
  bufs[1][0] = 1
  a, b, c = 0, 1, 2
  for k in 3..n {
    cl = g[k - 1] + 1
    cr = g[k - 2] + 1
    w = width(lens[a] > lens[b] ? lens[a] : lens[b], cl > cr ? cl : cr)
    if w > size {
      while size < w { size *= 2 }
      for i in 0...3 {
        grown = [0; size]
        copy(grown, bufs[i])
        bufs[i] = grown
      }
    }
    out = bufs[c]
    for i in 0...lens[c] { out[i] = 0 }
    out[cr] = addm(out[cr], 1) # take the left child's root
    out[cl] = addm(out[cl], 1) # take the right child's root
    left = bufs[b]
    for x in 0...lens[b] {
      if left[x] != 0 {
        y = (x + 1) ^ cr
        out[y] = addm(out[y], left[x])
      }
    }
    right = bufs[a]
    for x in 0...lens[a] {
      if right[x] != 0 {
        y = (x + 1) ^ cl
        out[y] = addm(out[y], right[x])
      }
    }
    lens[c] = used(out, w)
    a, b, c = b, c, a
  }
  bufs[b][0]
}

puts f(5)
puts f(10)
puts f(10_000)
