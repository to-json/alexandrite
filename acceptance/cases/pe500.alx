# pe500: the smallest number with 2^500500 divisors, mod 500500507.
# Each factor p^(2^k - 1) doubles the divisor count when it becomes
# p^(2^(k+1) - 1): multiply by p^(2^k). Greedily take the 500500 smallest
# such multipliers: the primes, then their squares, fourth powers, ...
MOD = 500500507
N = 500500
LIMIT = 7_400_000 # the 500500th prime is 7376507

sieve = [true; LIMIT + 1]
primes: [Int] = []
for i in 2..LIMIT {
  next if !sieve[i]
  primes << i
  break if primes.size == N
  j = i * i
  while j <= LIMIT {
    sieve[j] = false
    j += i
  }
}
top = primes[N - 1]

# A min-heap of the squares waiting (primes come in order from `primes`).
heap: [Int] = []
def heap_push(h: [Int], v: Int) -> [Int] {
  a = h
  a << v
  i = a.size - 1
  while i > 0 && a[(i - 1) / 2] > a[i] {
    a[(i - 1) / 2], a[i] = a[i], a[(i - 1) / 2]
    i = (i - 1) / 2
  }
  a
}
def heap_pop(h: [Int]) -> [Int] {
  a = h
  a[0] = a[a.size - 1]
  a = a[0...a.size - 1]
  i = 0
  loop {
    l = 2 * i + 1
    break if l >= a.size
    m = l + 1 < a.size && a[l + 1] < a[l] ? l + 1 : l
    break if a[i] <= a[m]
    a[i], a[m] = a[m], a[i]
    i = m
  }
  a
}

answer = 1
next_prime = 0
for _ in 0...N {
  x = 0
  if heap.size > 0 && heap[0] < primes[next_prime] {
    x = heap[0]
    heap = heap_pop(heap)
  } else {
    x = primes[next_prime]
    next_prime += 1
  }
  answer = answer * (x % MOD) % MOD
  # (Squares past the largest prime would never be taken.)
  heap = heap_push(heap, x * x) if x <= top / x
}
puts answer
