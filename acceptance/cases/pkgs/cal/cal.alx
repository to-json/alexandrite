# Array constants exported from a package.
pub MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
pub DAYS: [U8; 12] = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

pub def name(m: Int) -> Str { MONTHS[m - 1] }
pub def day_of_year(m: Int, d: Int) -> Int { (0...m - 1).sum { DAYS[it].to_i } + d }
