# A package: every file in pkgs/geom/ is package `geom`.
pub ORIGIN_NAME = "origin"

pub struct Point {
  x: Float
  y: Float
  pub def norm -> Float { (x * x + y * y).sqrt }
  pub def shift!(dx: Float) { self.x += dx }
  def secret -> Float { 42.0 }
}

pub def origin -> Point { Point.new(x: 0.0, y: 0.0) }
pub def dist(a: Point, b: Point) -> Float { Point.new(x: a.x - b.x, y: a.y - b.y).norm }
def helper -> Int { 7 }

# A refinement: active only where `using geom.Units` is in effect.
pub refine Units for Float {
  pub def cm -> Float { self * 100.0 }
}

# A private constant used as a method receiver inside its package
# (hash/crc32 needed it: `MAGIC.bytes` was "no method").
TAG = "geom"

pub def tag_bytes -> Int { TAG.bytes.to_a.size }
