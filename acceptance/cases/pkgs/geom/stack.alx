pub struct Stack[T] {
  items: [T]
  pub def push!(x: T) { self.items << x }
  pub def size -> Int { items.size }
}

# A generic built from a generic field type, instantiated from another
# package (inference matches the package-qualified instance).
struct Cell[T] {
  v: T
}

pub struct Boxed[T] {
  cells: [Cell[T]]
  pub def get -> T { cells[0].v }
}

pub def boxed[T](v: T) -> Boxed[T] {
  cs: [Cell[T]] = [Cell.new(v: v)]
  Boxed.new(cells: cs)
}
