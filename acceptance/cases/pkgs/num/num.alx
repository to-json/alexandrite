# A package declaring types named like the builtins Int and Float (as
# math/big does): inside it they mean its own types, the builtins are I64
# and F64.
pub struct Int {
  v: I64

  pub def twice -> Int { Int.new(v: v * 2) }

  pub def to_s -> Str { "Int(#{v})" }
}

pub struct Float {
  f: F64

  pub def to_s -> Str { "Float(#{f})" }
}

pub def make(v: I64) -> Int { Int.new(v: v) }

pub def half(x: Int) -> Float { Float.new(f: x.v.to_f / 2.0) }
