# R11: package-level state, only behind Atomic[T] or Mutex[T].
pub struct Level {
  name: Str
  n: Int
}

# Declared before what it reads: initialized after it all the same.
pub GREETING = Atomic.new(greeting_for(LEVEL.load))
pub LEVEL = Atomic.new(Level.new(name: "info", n: 1))
pub HITS: Atomic[Int] = Atomic.new(0)
SEEN = Mutex[[Str]].new([])

def greeting_for(l: Level) -> Str { "hello at #{l.name} (#{l.n})" }

pub def note(s: Str) {
  SEEN.lock { |xs| xs << s }
  HITS.add(1)
}

pub def seen -> [Str] { SEEN.lock { |xs| xs } }

pub def set_level(name: Str, n: Int) {
  LEVEL.store(Level.new(name: name, n: n))
}
