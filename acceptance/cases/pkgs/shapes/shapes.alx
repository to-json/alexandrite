import "pkgs/geom"

pub error ShapeError { Degenerate(why: Str) }

pub struct Circle {
  center: geom.Point
  r: Float
  pub def area -> Float { 3.0 * r * r }
}

pub def circle(x: Float, y: Float, r: Float) -> ~Circle<ShapeError> {
  fail ShapeError.Degenerate("radius #{r}") if r <= 0.0
  Circle.new(center: geom.Point.new(x: x, y: y), r: r)
}

pub def spread(cs: [Circle]) -> Float {
  geom.dist(cs[0].center, cs[cs.size - 1].center)
}
