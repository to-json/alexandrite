# S8 / S12 helpers for acceptance/cases/sugar_defaults.alx.

LEVEL = 2 # private: a default may still use it

pub struct Attr {
  key: Str
  val: Str
}

# S12: this package's own `print` and `sprintf` shadow the builtins here.
pub def print(s: Str) { puts "[sugar] #{s}" }
pub def sprintf(f: Str, n: Int) -> Str { "sugar.sprintf(#{f}, #{n})" }

pub def hello(name: Str) {
  print("hello #{name}") # sugar.print, not the builtin
  puts sprintf("x", 1)
}

# S8: defaults resolve in this package (LEVEL, Attr), evaluated per call.
pub def info(msg: Str, attrs: [Attr] = [], level: Int = LEVEL) -> Str {
  s = "#{msg} level=#{level}"
  for a in attrs {
    s += " #{a.key}=#{a.val}"
  }
  s
}
