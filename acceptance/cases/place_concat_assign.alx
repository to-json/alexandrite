# `+=` on a Str or array place (a field, an element) concatenates.
struct H {
  flag: Byte
  name: Str
  parts: [Int]

  def grow!(s: Str) {
    self.name += s
    self.parts += [name.size]
  }
}

def f(s: Str) -> H {
  h = H.new(name: s)
  h.name += "/"
  h.parts += [1, 2]
  h
}

h = f("dir")
puts h.name
puts h.parts
h.grow!("x")
h.grow!("yz")
puts h.name
puts h.parts

names = ["a", "b"]
names[1] += "c"
puts names

grid: [[Int]] = [[1], [2]]
grid[0] += [3, 4]
puts grid

hs = [H.new(name: "p")]
i = 0
while i < 3 {
  hs[0].name += i.to_s
  i += 1
}
puts hs[0].name
