# `op=` on a field place whose type isn't a scalar (archive/zip's
# `h.name += "/"`): the backends applied the operator as integer
# arithmetic (the JIT panicked, C called alx_add on strings).

struct In {
  name: Str
  tags: [Int]
  n: Int
}

struct Out {
  header: In
  list: [In]
}

o = Out.new(header: In.new(name: "a", tags: [1], n: 1), list: [In.new(name: "x", tags: [], n: 0)])
o.header.name += "/"
o.header.name += "b"
o.header.tags += [2, 3]
o.header.n += 41
o.list[0].name += "y"
puts o.header.name
puts o.header.tags
puts o.header.n
puts o.list[0].name
i = In.new(name: "b", tags: [], n: 0)
i.name += "/"
i.name *= 2
puts i.name
