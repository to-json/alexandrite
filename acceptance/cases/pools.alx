# R4: recursive data through @T handles into a Pool (a binary search tree).
struct Node {
  key: Int
  left: @Node?
  right: @Node?
}

def insert(nodes: Pool[Node], root: @Node?, key: Int) -> @Node {
  if r = root {
    n = nodes[r]
    if key < n.key {
      nodes[r] = Node.new(key: n.key, left: insert(nodes, n.left, key), right: n.right)
    } else {
      nodes[r] = Node.new(key: n.key, left: n.left, right: insert(nodes, n.right, key))
    }
    return r
  }
  nodes.add(Node.new(key: key))
}

def walk(nodes: Pool[Node], at: @Node?, out: [Int]) -> [Int] {
  acc = out
  if h = at {
    n = nodes[h]
    acc = walk(nodes, n.left, acc)
    acc << n.key
    acc = walk(nodes, n.right, acc)
  }
  acc
}

nodes = Pool[Node].new
root: @Node? = none
for k in [50, 30, 70, 20, 40, 60, 80] {
  root = insert(nodes, root, k)
}
puts walk(nodes, root, [])
puts nodes.size
first = nodes.add(Node.new(key: 1))
puts first
gone = nodes.remove(first)
puts gone?.key || -1
puts nodes.size
puts nodes.remove(first)?.key || -1
puts nodes.count
puts nodes.sum { |h, n| n.key }
