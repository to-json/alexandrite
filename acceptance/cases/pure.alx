# Pure code is proven or fallible: every builtin that could panic is either
# proven safe from constants or written under `~(...)` in a `fn -> ~T`,
# where its failure becomes an error (IndexError, ArithError).

# Proven: these can't fail.
fn whole(xs: [Str]) -> [Str] { xs[0..] }
fn tri -> Int { (1..100).sum }
fn biggest -> Int { [3, 9, 4].max }
fn widen(b: U8) -> Int { b.to_i }

# Fallible: each panicking builtin, under `~`.
fn at(xs: [Int], i: Int) -> ~Int { ~(xs[i]) }
fn byte(s: Str, i: Int) -> ~U8 { ~(s[i]) }
fn tail(xs: [Str], i: Int) -> ~Int { ~(xs[i..].size) }
fn sub(s: Str, i: Int, j: Int) -> ~Str { ~(s[i...j]) }
fn head(xs: [Str]) -> ~Str { ~(xs.first) }
fn final(xs: [Int]) -> ~Int { ~(xs.last) }
fn total(xs: [Int]) -> ~Int { ~(xs.sum) }
fn top(xs: [Int]) -> ~Int { ~(xs.max) }
fn low(xs: [Int]) -> ~Int { ~(xs.min_by { -it }) }
fn prod(xs: [Int]) -> ~Int { ~(xs.reduce { |a, b| a * b }) }
fn big(xs: [Int]) -> ~Int { ~(xs.find { it > 2 }.unwrap) }
fn small(x: Int) -> ~U8 { ~(x.to_u8) }
fn trunc(x: Float) -> ~Int { ~(x.to_i) }
fn ndigits(x: Int) -> ~Int { ~(x.digits.size) }
fn root(x: Int) -> ~Int { ~(Int.sqrt(x)) }
fn zeros(n: Int) -> ~Int { ~(Array.new(n, 0).size) }
fn pow(x: Int, n: Int) -> ~Int { ~(x ** n) }
fn shl(x: Int, n: Int) -> ~Int { ~(x << n) }
fn put(xs: [Int], i: Int) -> ~Int {
  ys = xs.dup
  ~(ys[i] = 7)
  zs = ys[0..]
  ~(zs[i])
}
fn cell(xs: [[Int]], i: Int, j: Int) -> ~Int { ~(xs[i][j] + 1) }
# Call arguments are under the `~` too.
fn hop(xs: [Int], i: Int) -> ~Int { ~at(xs, ~(xs[i])) }
# Without parentheses, `~` on a name takes its index and dotted chain too.
fn first_byte(s: Str) -> ~U8 { ~s[0] }
struct Acc {
  a: Int

  fn plus(n: Int) -> ~Int { ~(a + n) }
}
fn add_at(ps: [Acc], i: Int, xs: [Int]) -> ~Int { ~ps[i].plus(xs[i]) }
# A declared set: indexing fails with IndexError.
fn pick(xs: [Str], i: Int) -> ~Str<IndexError> { ~(xs[i]) }

def show(r) { if r.ok? { puts r.unwrap } else { puts "error: #{r.err.unwrap.message}" } }

puts whole(["a", "b"]).size
puts tri
puts biggest
puts widen(200.to_u8)
show(at([1, 2, 3], 1))
show(at([1, 2, 3], 3))
show(at([1, 2, 3], -1))
show(byte("abc", 0))
show(byte("abc", 5))
show(tail(["a", "b"], 1))
show(tail(["a", "b"], 5))
show(sub("hello", 1, 3))
show(sub("hello", 3, 1))
show(head(["x"]))
show(head([]))
show(final([4, 5]))
show(final([]))
show(total([1, 2]))
show(total([9223372036854775807, 1]))
show(top([3, 9, 2]))
show(top([]))
show(low([3, 9, 2]))
show(low([]))
show(prod([2, 3, 4]))
show(prod([]))
show(prod([4611686018427387904, 2]))
show(big([1, 5]))
show(big([1]))
show(small(200))
show(small(300))
show(trunc(2.5))
z = 0.0
show(trunc(z / z))
show(trunc(1e300))
show(ndigits(123))
show(ndigits(-1))
show(root(17))
show(root(-1))
show(zeros(3))
show(zeros(-3))
show(pow(3, 4))
show(pow(2, 63))
show(pow(2, -1))
show(pow(1, 1000000000000))
show(shl(1, 3))
show(shl(1, -3))
show(put([1, 2, 3], 1))
show(put([1, 2, 3], 3))
show(cell([[1, 2], [3]], 1, 0))
show(cell([[1, 2], [3]], 1, 1))
show(cell([[1, 2], [3]], 2, 0))
show(hop([0, 1], 1))
show(hop([0, 5], 1))
show(hop([0, 1], 9))
r = pick(["a"], 4)
case r.err.unwrap {
  OutOfBounds => puts "matched OutOfBounds"
  _ => puts "other"
}
show(pick(["a"], 0))
show(first_byte("A"))
show(first_byte(""))
ps = [Acc.new(a: 1)]
show(add_at(ps, 0, [5]))
show(add_at(ps, 1, [5]))
show(add_at(ps, 0, []))
show(add_at([Acc.new(a: 9223372036854775807)], 0, [1]))
