# A package function used as a value (`bufio.scan_words`), as a bare
# name is in its own package: Go's `scanner.Split(bufio.ScanWords)`.
import "bufio"
import "bytes"
import "slices"
import "strings"

def apply(f: (Str) -> Str, s: Str) -> Str {
  f.call(s)
}

def apply2(f: ([Byte], Bool) -> ~(Int, [Byte]?, Bool), d: [Byte]) -> ~Int {
  n, _t, _f = ~f.call(d, true)
  n
}

sc = bufio.new_scanner(bytes.new_reader("one two  three\n".bytes.to_a))
sc.split!(bufio.scan_words)
words: [Str] = []
while sc.scan! {
  words << sc.text
}
puts words
puts apply(strings.to_upper, "shout")
f = strings.trim_space
puts "[#{f.call("  x  ")}]"
xs = ["b", "a", "c"]
slices.sort_func(xs, strings.compare)
puts xs
puts apply2(bufio.scan_lines, "ab\ncd".bytes.to_a).unwrap
