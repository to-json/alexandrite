# #[derive(Arbitrary)] (testing/quick's generators for a type) and `==` on
# maps, which quick.check_equal uses.
import "math/rand"
import "testing/quick"

#[derive(Arbitrary)]
struct Point {
  x: I16
  y: I16
  tags: [Str]
  meta: Map[Int, Bool]
  label: Str?
}

#[derive(Arbitrary)]
enum Shape {
  Dot
  Circle(center: Point, r: U8)
  Poly([Point])
}

#[derive(Arbitrary)]
struct Scene {
  shapes: [Shape]
  pair: (Int, Bool)
}

def seeded -> quick.Config {
  quick.Config.new(max_count: 50, rand: rand.new(rand.new_source(42)))
}

def kind(s: Shape) -> Int {
  case s {
    Dot => 0
    Circle(_, _) => 1
    Poly(_) => 2
  }
}

def main -> ~Unit {
  # The same seed gives the same values.
  r1 = rand.new(rand.new_source(7))
  r2 = rand.new(rand.new_source(7))
  a = quick.value(quick.Arb[Scene].gen, r1)
  b = quick.value(quick.Arb[Scene].gen, r2)
  puts a == b
  # Every variant comes up.
  seen = [false, false, false]
  sr = rand.new(rand.new_source(3))
  for _i in 0...60 {
    seen[kind(quick.value(quick.Arb[Shape].gen, sr))] = true
  }
  puts seen
  # Properties over derived values.
  ~quick.check(quick.Arb[Point].gen, seeded) { |p| p.tags.size < 50 && p.meta.size < 50 }
  ~quick.check_equal(quick.Arb[Point].gen, seeded, ->(p: Point) -> Map[Int, Bool] { p.meta }, ->(p: Point) -> Map[Int, Bool] { p.meta.dup })
  r = quick.check(quick.Arb[Point].gen, seeded) { |p| p.x < 100 }
  puts r.err?
  # Map equality: the same entries in any order.
  m1: Map[Str, Int] = {"a" => 1, "b" => 2}
  m2: Map[Str, Int] = {"b" => 2, "a" => 1}
  m3: Map[Str, Int] = {"a" => 1, "b" => 3}
  puts m1 == m2
  puts m1 != m3
  nested1: Map[Int, Map[Str, Int]] = {1 => m1}
  nested2: Map[Int, Map[Str, Int]] = {1 => m2}
  puts nested1 == nested2
}

~main()
