# The zero value of a struct whose field names a type defined in terms of
# it (R12): V holds a VOuter? and VOuter holds a V, so `VOuter.new` needs
# the zero of V, named inside its own definition.
struct V {
  n: Int
  o: VOuter?
}

struct VOuter {
  v: V
  k: Str
}

x = VOuter.new(k: "a")
puts x.v.n
puts x.v.o.none?
y = V.new(o: VOuter.new)
puts y.o.unwrap.v.o.none?
