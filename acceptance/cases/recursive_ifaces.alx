# R13: an implementor may hold the interface it implements (decorators,
# multi-handlers); that interface's values are boxed. And `==` on interface
# values (port-issues #108): the same implementor, and equal values of it.

interface Reader {
  def read -> Str
}

struct Text {
  s: Str
  def read -> Str { s }
}

struct Brackets {
  inner: Reader
  def read -> Str { "[" + inner.read + "]" }
}

struct Twice {
  inner: Reader
  def read -> Str {
    r = inner.read
    r + r
  }
}

# A Reader wrapping a Reader wrapping a Reader.
r: Reader = Brackets.new(inner: Twice.new(inner: Brackets.new(inner: Text.new(s: "ab"))))
puts r.read
puts r

def wrap(r: Reader, n: Int) -> Reader {
  return r if n == 0
  wrap(Brackets.new(inner: r), n - 1)
}

puts wrap(Text.new(s: "x"), 5).read
case r {
  Brackets(b) => puts "brackets around #{b.inner.read}"
  _ => puts "something else"
}
if t = r.as(Brackets) { puts "as: #{t.inner.read}" }

# A zero interface value (an omitted field): the first implementor's zero.
z = Brackets.new()
puts z.read

# ---- handlers holding handlers
interface Handler {
  def handle(msg: Str) -> Int
  def name -> Str
}

struct Leaf {
  tag: Str
  def handle(msg: Str) -> Int {
    puts "  #{tag} got #{msg}"
    1
  }
  def name -> Str { tag }
}

struct Multi {
  hs: [Handler]
  def handle(msg: Str) -> Int {
    n = 0
    for h in hs { n += h.handle(msg) }
    n
  }
  def name -> Str { "multi(" + hs.map { it.name }.to_a.join(",") + ")" }
}

struct Filter {
  inner: Handler
  min: Int
  def handle(msg: Str) -> Int { msg.size >= min ? inner.handle(msg) : 0 }
  def name -> Str { "filter(#{inner.name})" }
}

inner: [Handler] = [Leaf.new(tag: "b"), Filter.new(inner: Leaf.new(tag: "c"), min: 3)]
outer: [Handler] = [Leaf.new(tag: "a"), Multi.new(hs: inner)]
m: Handler = Multi.new(hs: outer)
puts m.name
puts m.handle("hi")
puts m.handle("hello")

# A generic wrapper over an interface value is one too.
struct Counted[H] {
  inner: H
  def handle(msg: Str) -> Int { 10 * inner.handle(msg) }
  def name -> Str { "counted" }
}

cm: Handler = Counted[Handler].new(inner: m)
puts cm.handle("hey")

# ---- `!` methods through a boxed interface
interface Source {
  def next! -> Int
}

struct Counter {
  n: Int
  def next! -> Int {
    self.n += 1
    n
  }
}

struct Limit {
  src: Source
  left: Int
  def next! -> Int {
    return -1 if left == 0
    self.left -= 1
    src.next!
  }
}

l = Limit.new(src: Counter.new(n: 10), left: 2)
src: Source = l
puts src.next!
puts src.next!
puts src.next!

# ---- `==` on interface values
a: Reader = Text.new(s: "q")
b: Reader = Text.new(s: "q")
c: Reader = Brackets.new(inner: Text.new(s: "q"))
d: Reader = Brackets.new(inner: Text.new(s: "q"))
puts a == b
puts a == c
puts c == d
puts c != Brackets.new(inner: Text.new(s: "z"))
puts a == Text.new(s: "q")

# Structs and slices holding interface values compare them too.
struct Pair {
  k: Str
  v: Reader
}
puts Pair.new(k: "x", v: c) == Pair.new(k: "x", v: d)
puts Pair.new(k: "x", v: c) == Pair.new(k: "x", v: a)
xs: [Reader] = [a, c]
ys: [Reader] = [b, d]
puts xs == ys
ys[1] = a
puts xs == ys
