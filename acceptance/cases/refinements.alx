# M6: refinements. Methods on existing types, active only under `using`.
refine Shouty for Str {
  def shout -> Str { self + "!" }
  def twice -> Str { self.shout + self.shout }
}
refine Shouty for Int {
  def shout -> Str { "#{self}!" }
}
refine Metric for Float {
  def km -> Float { self * 1000.0 }
}

struct Box { w: Int, def area -> Int { w * w } }
refine Weird for Box {
  def area -> Int { -1 }
}

def before -> Str { "ok" }

using Shouty

def after -> Str { "hey".twice }

puts "hi".shout
puts 42.shout
puts after
def scoped -> Float {
  if true {
    using Metric
    return 1.5.km
  }
  0.0
}
puts scoped
b = Box.new(w: 3)
puts b.area
def weird(b: Box) -> Int {
  using Weird
  b.area
}
puts weird(b)
puts b.area
