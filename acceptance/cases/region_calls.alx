# R3 (port-issues #178): a call through an interface value or a generic
# `[C: Iface]` parameter refers to what its implementors' results may refer
# to, and an interpolation is a new string, so a map local to a loop keeps
# its compacting region when such calls read it; and loses it whenever their
# result really is (part of) the map. Run under ASan, a value compacted away
# too early is a crash; the checksums catch a reused block.
N = 1500

def val(i: Int) -> Str {
  "v#{i}:" + "abcdefgh" * 250
}

def sum(s: Str) -> Int {
  t = 0
  for b in s.bytes {
    t = (t * 31 + b.to_i) % 1000003
  }
  t
}

interface Source {
  def get(m: Map[Str, Str], k: Str) -> Str
}

# Returns a new string: the map stays the loop's.
struct Measure {
  n: Int

  def get(m: Map[Str, Str], k: Str) -> Str {
    "#{k}=#{(m[k] || "").size}"
  }
}

# Returns the map's own value.
struct Lookup {
  n: Int

  def get(m: Map[Str, Str], k: Str) -> Str {
    m[k] || ""
  }
}

def generic[S: Source](src: S) -> Int {
  docs: Map[Str, Str] = {}
  i = 0
  total = 0
  while i < N {
    docs["f#{i % 10}"] = val(i)
    total = (total + sum(src.get(docs, "f#{i % 7}"))) % 1000003
    i += 1
  }
  total
}

def iface(src: Source) -> Int {
  docs: Map[Str, Str] = {}
  i = 0
  total = 0
  while i < N {
    docs["f#{i % 10}"] = val(i)
    t = src.get(docs, "f#{i % 7}")
    total = (total + sum(t)) % 1000003
    i += 1
  }
  total
}

# Safety: the results kept across iterations, through a generic instance
# and through an interface value whose implementors include Lookup.
def kept_generic[S: Source](src: S) -> Int {
  docs: Map[Str, Str] = {}
  keep: [Str] = []
  i = 0
  while i < N {
    docs["f#{i % 10}"] = val(i)
    keep << src.get(docs, "f#{i % 10}") if i % 300 == 0
    i += 1
  }
  t = 0
  for s in keep {
    t = (t + sum(s)) % 1000003
  }
  t
}

def kept_iface(src: Source) -> Int {
  docs: Map[Str, Str] = {}
  keep: [Str] = []
  i = 0
  while i < N {
    docs["f#{i % 10}"] = val(i)
    keep << src.get(docs, "f#{i % 10}") if i % 300 == 0
    i += 1
  }
  t = 0
  for s in keep {
    t = (t + sum(s)) % 1000003
  }
  t
}

# Safety: `"#{a}#{b}"` is `b` when `a` is empty.
def kept_format -> Int {
  docs: Map[Str, Str] = {}
  keep: [Str] = []
  none_yet = ""
  i = 0
  while i < N {
    docs["f#{i % 10}"] = val(i)
    keep << "#{none_yet}#{docs["f#{i % 10}"] || ""}" if i % 300 == 0
    i += 1
  }
  t = 0
  for s in keep {
    t = (t + sum(s)) % 1000003
  }
  t
}

struct Entry {
  text: Str
  n: Int
}

# Safety: a struct holding a string read from the map, kept.
def kept_struct -> Int {
  docs: Map[Str, Str] = {}
  keep: [Entry] = []
  i = 0
  while i < N {
    docs["f#{i % 10}"] = val(i)
    keep << Entry.new(text: docs["f#{i % 10}"] || "", n: i) if i % 300 == 0
    i += 1
  }
  t = 0
  for e in keep {
    t = (t + sum(e.text) + e.n) % 1000003
  }
  t
}

# Safety: one string both stored into the map and kept outside it: the map
# keeps its region, the string doesn't go into it.
def kept_shared -> Int {
  docs: Map[Str, Str] = {}
  keep: [Str] = []
  i = 0
  while i < N {
    s = val(i)
    docs["f#{i % 10}"] = s
    keep << s if i % 300 == 0
    i += 1
  }
  t = 0
  for x in keep {
    t = (t + sum(x)) % 1000003
  }
  t
}

puts generic(Measure.new(n: 0))
puts generic(Lookup.new(n: 0))
puts iface(Measure.new(n: 0))
puts iface(Lookup.new(n: 0))
puts kept_generic(Lookup.new(n: 0))
puts kept_iface(Lookup.new(n: 0))
puts kept_iface(Measure.new(n: 0))
puts kept_format
puts kept_struct
puts kept_shared
