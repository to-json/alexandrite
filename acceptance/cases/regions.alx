# R1: regions. Every way a value can leave a call or a loop iteration;
# run under ASan, a value freed too early is a crash.
struct Box { label: Str, items: [Str] }
error Bad { Why(msg: Str) }

def make(n: Int) -> Str { "made #{n}" }                                   # returned
def wrap(n: Int) -> Box { Box.new(label: make(n), items: [make(n + 1)]) } # nested in a struct
def add_to(xs: [Str], n: Int) { xs << "added #{n}" }                      # stored into a param (no return)
def fill!(b: [Box], n: Int) { b[0].items << "filled #{n}" }               # through a param's field
def slice_of(s: Str) -> Str { s[0..2] }                                   # a view of the argument
def pick(xs: [Str]) -> Str { xs[xs.size - 1] }                            # an element of the argument
def fails(n: Int) -> ~Int<Bad> {
  fail Bad.Why("bad #{n}") if n > 2
  n
}
def keyed(m: Map[Str, Str], n: Int) { m["k#{n}"] = "v#{n}" } # into a param map
def lam(n: Int) -> (Int) -> Str {
  pre = "p#{n}"
  ->(x: Int) { pre + "#{x}" } # captured by an escaping lambda
}
def gen_strs(n: Int) -> [Str] {
  out = []
  (1..n).each { out << "g#{it}" } # growth of a returned array
  out
}

keep = []
(1..3).each { keep << make(it) }
b = wrap(5)
add_to(keep, 9)
boxes = [Box.new(label: "x", items: [])]
fill!(boxes, 4)
puts keep
puts b.label
puts b.items
puts boxes[0].items
puts slice_of(make(77))
puts pick(gen_strs(4))
r = fails(5)
if e = r.err { puts e }
m: Map[Str, Str] = {}
(1..3).each { keyed(m, it) }
puts m
f = lam(1)
puts f(2)
ch = Chan[Str].new(3)
t = spawn { ch << make(100); ch.close; 0 }
for s in ch { puts s }
puts t.wait.unwrap
def deep(n: Int) -> Str {
  return make(n) if n == 0
  inner = deep(n - 1)
  inner + "<#{n}"
}
puts deep(5)
puts ~fails(1)
x = fails(9)
puts x.unwrap_or(-1)
