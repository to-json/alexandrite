# `r.rescue { |e| fail ... }` whose value isn't a scalar (a tuple, a Str,
# an array, an enum): the block fails, so there's no value to store after
# it (C and the Rust oracle used to get an assignment of nothing).
error Bad {
  Wrapped(inner: Str)

  def message -> Str {
    case self {
      Wrapped(s) => "wrapped: #{s}"
    }
  }
}

enum Color {
  Red
  Green
}

def pair(ok: Bool) -> ~(Int, Str) {
  fail Bad.Wrapped("pair") unless ok
  (1, "one")
}

def text(ok: Bool) -> ~Str {
  fail Bad.Wrapped("text") unless ok
  "text"
}

def bytes(ok: Bool) -> ~[Byte] {
  fail Bad.Wrapped("bytes") unless ok
  [1, 2, 3]
}

def color(ok: Bool) -> ~Color {
  fail Bad.Wrapped("color") unless ok
  Color.Green
}

def all(ok: Bool) -> ~Str {
  n, s = pair(ok).rescue { |e| fail Bad.Wrapped("in " + e.message) }
  t = text(ok).rescue { |e| fail Bad.Wrapped("in " + e.message) }
  b = bytes(ok).rescue { |e| fail Bad.Wrapped("in " + e.message) }
  c = color(ok).rescue { |e| fail Bad.Wrapped("in " + e.message) }
  "#{n} #{s} #{t} #{b.size} #{c == Color.Green}"
}

puts all(true).unwrap
puts all(false).err.unwrap.message
