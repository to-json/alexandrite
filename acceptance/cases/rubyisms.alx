#![overflow(promote)]
# E2: the Ruby conveniences the Euler and scripting work found missing.

# Str#to_i in promote mode: any number of digits.
puts "37107287533902102798797998220837590246510135740250".to_i * 2
puts " -42xyz".to_i

# Range#step (and on any Enumerable: every n-th element).
puts (1..10).step(3).to_a
puts (0...20).step(5).map { it * it }.to_a
puts ["a", "b", "c", "d"].step(2).to_a

# Array#reverse makes a new slice.
xs = [1, 2, 3]
ys = xs.reverse
ys[0] = 9
puts "#{xs} #{ys}"

# reduce(init) accumulates in the start value's type.
puts "12345".bytes.reduce(0) { |n, b| n * 10 + (b.to_i - 48) }
puts (1..4).reduce("") { |s, i| s + i.to_s }

# == compares slices (and structs holding them) element by element.
struct Tagged {
  name: Str
  tags: [Str]
}
puts [[1], [2, 3]] == [[1], [2, 3]]
puts ["a"] != ["b"]
puts Tagged.new(name: "x", tags: ["y"]) == Tagged.new(name: "x", tags: ["y"])

# print writes no newline.
print "no "
print "newline"
puts ""

# String conveniences.
puts "[" + "  padded \n".strip + "]"
puts "notes.txt".end_with?(".txt") && "notes.txt".start_with?("no") && "notes".include?("ote")
puts "a\nb\n".lines
puts "=" * 5
