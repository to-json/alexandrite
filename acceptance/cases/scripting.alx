# S1: shell scripting without a shell. Command literals (each #{} is one
# argument, | and redirects parsed by alx), os/exec, and the sh package.
import "os/exec"
import "path"
import "sh"
import "strings"

dir = ".alx-cache/scripting-work"
sh.~rm_rf(dir)
sh.~mkdir_p("#{dir}/src/deep")
sh.~write("#{dir}/src/a.txt", "alpha\nbeta\ngamma\n")
sh.~write("#{dir}/src/deep/b.txt", "error one\nok\nerror two\n")
sh.~write("#{dir}/src/.hidden.txt", "x\n")

# Globs: ** for any depth, hidden files only by name.
files = sh.~glob("#{dir}/src/**/*.txt")
puts files.map { path.base(it) }.to_a.join(" ")

# A pipeline with an interpolated path containing a space.
spaced = "#{dir}/with space.txt"
sh.~cp("#{dir}/src/deep/b.txt", spaced)
puts strings.trim_space(`cat #{spaced} | grep -c error`.~output)

# #{*xs} splices a list as separate arguments.
puts `printf '[%s]' #{*["a b", "c"]}`.~output

# Redirects, applied left to right; the literal runs in dir.
w = `sh -c 'echo out; echo err >&2' > both.log 2>&1`
w.dir = dir
w.~run
puts sh.~read_lines("#{dir}/both.log").join(",")

# set -e by default: a failing command is an error with its stderr.
r = `ls #{dir}/missing`.output
if e = r.err { puts e.message.split(":")[0] }

# capture never fails on a nonzero exit; it has the status and resources.
c = `sh -c 'exit 3'`.~capture
puts "#{c.state.exit_code} #{c.state.success} #{c.state.max_rss > 0}"

# pipefail, except a writer killed by SIGPIPE.
puts `false | cat`.~capture.state.success
puts strings.trim_space(`yes | head -n 2`.~output).split("\n").size

# The Go API, with stdin.
cmd = exec.command("tr", ["a-z", "A-Z"])
cmd.stdin = "shout"
puts cmd.~output

# Scoped directory and environment.
sh.~in_dir(dir) { puts strings.trim_space(`ls src`.~output).split("\n").join(",") }
sh.~with_env(["S1_GREETING=hello"]) { puts strings.trim_space(`sh -c 'echo $S1_GREETING'`.~output) }

# Fallible blocks, run in parallel with a limit.
sizes = sh.~glob("#{dir}/src/**/*.txt")
res = sh.parallel(sizes, 2) { |f| `test -s #{f}`.~run }
puts res.ok?
bad = sh.parallel(["1", "0"], 2) { |n| `test #{n} -eq 1`.~run }
puts bad.ok?

sh.~mv("#{dir}/src", "#{dir}/moved")
puts "#{sh.exists?("#{dir}/src")} #{sh.dir?("#{dir}/moved/deep")}"
sh.~rm_rf(dir)
puts sh.exists?(dir)
