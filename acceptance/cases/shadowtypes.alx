# A main-package type with the name of a package's type: inside the package,
# its own type wins (hash/maphash's Hash vs package hash's Hash).
import "pkgs/geom"

interface Point {
  def norm -> Float
}

p = geom.origin
p.shift!(3.0)
puts p.norm
puts geom.dist(p, geom.origin)
q: Point = p
puts q.norm
