# R6: values handed to another task (spawn, channels) aren't used here
# afterwards; a copy, a fresh value per iteration, or reassignment is fine.
def total(xs: [Int]) -> Int {
  xs.sum
}

ts: [Task[Int]] = []
(1..3).each { |w|
  part = [w, w * 2]
  ts << spawn { total(part) }
}
puts ts.sum { it.wait.unwrap }

data = [1, 2, 3]
copy = data.dup
t = spawn { copy.sum }
data << 4
puts t.wait.unwrap + data.size

ch = Chan[[Int]].new(2)
buf = [1]
ch << buf
buf = [2]
buf << 3
puts ch.recv.unwrap_or([]).size + buf.size

# the result comes back through wait: the task's value is ours again
grown = spawn {
  acc: [Int] = []
  (1..5).each { acc << it * it }
  acc
}
sq = grown.wait.unwrap
sq << 36
puts sq.sum
