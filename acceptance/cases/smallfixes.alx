QUOTE = 34
s = "a.\"b.c"
puts s.bytes.count { it == 46 }
puts [1, 2, 3, 4].count(&:even?)
puts (1..10).count { it.even? }
puts [1, 2, 3, 4].count { it > 1 }
puts s.bytes.include?(QUOTE)
puts s.bytes.include?(46)
puts s.bytes.include?(7)
x = ["a"].find { it == "z" }
y = ["a"].find { it == "a" }
puts x.some?
puts y.some?
puts x.none?
puts y.none?
