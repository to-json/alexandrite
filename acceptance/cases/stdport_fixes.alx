# Compiler fixes found while porting encoding/csv, text/tabwriter and
# text/scanner.
import "bufio"
import "bytes"
import "strconv"

# 1. A main-file type with the name of a package's private type: the package
# still sees its own (bufio has a private ReaderState).
struct ReaderState {
  x: Int
}

r = bufio.new_reader(bytes.new_buffer_string("hi\n"))
puts r.read_line!.unwrap.unwrap
puts ReaderState.new(x: 7).x

# 2. A generic struct instantiated with a struct of no fields: its zero
# value in C starts with an empty aggregate.
struct Nothing {
  def write!(p: [Byte]) -> Int { p.size }
}

struct Box[T] {
  inner: T
  n: Int
}

def zeroed[T](v: T) -> Box[T] {
  b = Box[T].new(inner: v)
  b.n += 1
  b
}

puts zeroed(Nothing.new).n

# 3. A closure stored in a struct, called from a `!` method whose frame
# region is freed on return: what the closure stores into a captured
# variable must outlive that frame.
struct Ev {
  msg: Str
  n: Int
}

struct Fire {
  st: [Int]
  cb: [(Ev) -> Unit]

  def fire!(m: Str) {
    self.st[0] = st[0] + 1
    e = Ev.new(msg: m, n: st[0])
    for f in cb {
      f(e)
    }
  }
}

def collect -> Str {
  out: [Str] = []
  s = Fire.new(st: [0], cb: [])
  s.cb = [->(e: Ev) {
    out << "#{e.msg}@#{e.n} "
  }]
  i = 0
  while i < 4 {
    s.fire!("step #{i}")
    i += 1
  }
  out.join("")
}

puts collect

# Qualified variant patterns bind their fields (Type.Variant, pkg.Type.Variant).
bad = strconv.atoi("x1")
if e = bad.err {
  case e {
    strconv.NumError.ErrSyntax(func_name, num) => puts "#{func_name}: #{num}"
    _ => puts "?"
  }
}

# A parenthesized type groups: an optional function.
struct Hook {
  cb: ((Int) -> Int)?
}
h = Hook.new(cb: ->(x: Int) -> Int { x * 2 })
if f = h.cb { puts f(21) }
puts Hook.new(cb: none).cb.none?

# Invalid UTF-8 decodes as U+FFFD a byte at a time, as in Go.
bad_utf8: [Byte] = [128, 65, 237, 160, 128, 244, 144, 128, 128, 228, 184, 150]
puts Str.from_bytes(bad_utf8).runes.to_a

# Array literals coerce element by element: constants to a sized-int slice,
# structs to an interface slice.
puts Str.from_bytes([104, 105])
interface Area {
  def area -> Float
}
struct Sq {
  s: Float
  def area -> Float { s * s }
}
struct Ci {
  r: Float
  def area -> Float { 3.0 * r * r }
}
def total_area(xs: [Area]) -> Float { xs.sum { it.area } }
puts total_area([Sq.new(s: 2.0), Ci.new(r: 1.0)])
# == on optionals (#12)
oa: Int? = 3
ob: Int? = none
oc: Int? = 3
os: Str? = "x"
puts [oa == ob, ob == none, oa == oc, oa != none, os == "x", "y" == os]
# integer precision (#9)
puts format("[%.2d] [%.3d] [%5.3d] [%-6.3d] [%05.3d] [%.0d] [%.0d] [%.4x] [%+.3d]", 7, -7, 42, 5, 9, 0, 3, 255, 4)
# `opt?.field || none` keeps the optional type (#8); a keyword names a field
struct Nd {
  next: Nd2?
  def after -> Int { self.next?.v || 0 }
}
struct Nd2 {
  v: Int
}
def next_of(n: Nd?) -> Nd2? {
  n?.next || none
}
puts next_of(none)
puts next_of(Nd.new(next: Nd2.new(v: 3)))?.v
puts Nd.new(next: Nd2.new(v: 8)).after
# static methods on generic types (#10); type arguments from the wanted result (#11)
struct Rg[T] {
  xs: [T]
  def self.make(n: Int, v: T) -> Rg[T] { Rg[T].new(xs: [v; n]) }
  def self.empty -> Rg[T] { Rg[T].new(xs: []) }
  def self.join(a: Rg[T], b: Rg[T]) -> Rg[T] { Rg[T].new(xs: a.xs + b.xs) }
  def twice -> Rg[T] { Rg.join(self, self) }
}
def none_of[T](n: Int) -> [T] {
  out: [T] = []
  out
}
def floats(xs: [Float]) -> Int { xs.size }
puts Rg.make(2, "a").twice.xs
eg: Rg[Int] = Rg.empty
puts eg.xs.size
puts Rg[Byte].make(2, 7).xs
puts Rg[Str].empty.xs.size
ns: [Str] = none_of(2)
puts [ns.size, floats(none_of(1))]
# covariant interface results (#13): `def grow -> Sqr` satisfies `def grow -> Shp`
interface Shp {
  def area -> Int
  def grow -> Shp
}
struct Sqr {
  s: Int
  def area -> Int { s * s }
  def grow -> Sqr { Sqr.new(s: s + 1) }
}
struct Rct {
  w: Int
  h: Int
  def area -> Int { w * h }
  def grow -> Shp { Sqr.new(s: w) }
}
shapes: [Shp] = [Sqr.new(s: 2), Rct.new(w: 3, h: 1)]
for x in shapes {
  g = x.grow
  puts [x.area, g.area, g.grow.area]
}
