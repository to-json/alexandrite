# Compiler fixes found while porting encoding/csv, text/tabwriter and
# text/scanner.
import "bufio"
import "bytes"
import "strconv"

# 1. A main-file type with the name of a package's private type: the package
# still sees its own (bufio has a private ReaderState).
struct ReaderState {
  x: Int
}

r = bufio.new_reader(bytes.new_buffer_string("hi\n"))
puts r.read_line!.unwrap.unwrap
puts ReaderState.new(x: 7).x

# 2. A generic struct instantiated with a struct of no fields: its zero
# value in C starts with an empty aggregate.
struct Nothing {
  def write!(p: [Byte]) -> Int { p.size }
}

struct Box[T] {
  inner: T
  n: Int
}

def zeroed[T](v: T) -> Box[T] {
  b = Box[T].new(inner: v)
  b.n += 1
  b
}

puts zeroed(Nothing.new).n

# 3. A closure stored in a struct, called from a `!` method whose frame
# region is freed on return: what the closure stores into a captured
# variable must outlive that frame.
struct Ev {
  msg: Str
  n: Int
}

struct Fire {
  st: [Int]
  cb: [(Ev) -> Unit]

  def fire!(m: Str) {
    self.st[0] = st[0] + 1
    e = Ev.new(msg: m, n: st[0])
    for f in cb {
      f(e)
    }
  }
}

def collect -> Str {
  out: [Str] = []
  s = Fire.new(st: [0], cb: [])
  s.cb = [->(e: Ev) {
    out << "#{e.msg}@#{e.n} "
  }]
  i = 0
  while i < 4 {
    s.fire!("step #{i}")
    i += 1
  }
  out.join("")
}

puts collect

# Qualified variant patterns bind their fields (Type.Variant, pkg.Type.Variant).
bad = strconv.atoi("x1")
if e = bad.err {
  case e {
    strconv.NumError.ErrSyntax(func_name, num) => puts "#{func_name}: #{num}"
    _ => puts "?"
  }
}

# A parenthesized type groups: an optional function.
struct Hook {
  cb: ((Int) -> Int)?
}
h = Hook.new(cb: ->(x: Int) -> Int { x * 2 })
if f = h.cb { puts f(21) }
puts Hook.new(cb: none).cb.none?
