# Memory benchmark: build 200,000 lines, join them, split them again, and
# total the lengths of every field.
lines: [Str] = []
for i in 0...200_000 {
  lines << "item #{i}: #{i * i} #{i % 7 == 0 ? "lucky" : "plain"}"
}
text = lines.join("\n")
total = 0
for line in text.split("\n") {
  for f in line.split(" ") { total += f.size }
}
puts text.size
puts total
