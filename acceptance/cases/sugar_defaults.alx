# S8: default parameter values and keyword arguments; S12: a package's
# (and the main file's) own defs shadow builtins.
import "pkgs/sugar"

LIMIT = 3

def info(msg: Str, tags: [Str] = [], level: Int = LIMIT) -> Str {
  "#{msg} L#{level} [#{tags.join(",")}]"
}

struct Logger {
  prefix: Str
  count: Int
  def log(msg: Str, n: Int = 1) -> Str { "#{prefix}#{msg}x#{n}" }
  def bump!(by: Int = 1) { self.count += by }
  def self.make(prefix: Str = "> ") -> Logger { Logger.new(prefix: prefix) }
}

enum Shape {
  Sq(side: Int)
  def scaled(k: Int = 2) -> Int {
    case self { Sq(s) => s * k }
  }
}

# A block fills a last function parameter after the defaults.
def each_n(n: Int = 2, f: (Int) -> Unit) {
  for i in 0...n { f.call(i) }
}

def pick[T](xs: [T], i: Int = 0) -> T { xs[i] }

def count[T](x: T, extra: [T] = []) -> Int { 1 + extra.size }

struct Stack[T] {
  items: [T]
  def push_all!(xs: [T] = []) { xs.each { |v| self.items << v } }
  def size_plus(n: Int = 10) -> Int { items.size + n }
}

def seed -> Int {
  puts "seed evaluated"
  7
}

# Evaluated per call, only when the call leaves it out; a def whose
# parameters all have defaults is called by its bare name.
def show(n: Int = seed()) -> Int { n }

def fallible(n: Int, strict: Bool = false) -> ~Int {
  fail StrErr.New(m: "strict") if strict
  n
}

pub error StrErr {
  New(m: Str)
  def message -> Str { case self { New(m) => m } }
}

# S12 in the main file: its own `copy` wins.
def copy(a: Int, b: Int) -> Int { a * 100 + b }

def main_ {
  puts info("a")
  puts info("b", ["x", "y"])
  puts info("c", level: 9)
  puts info("d", level: 1, tags: ["k"])
  puts info(msg: "e")
  l = Logger.make
  puts l.log("hi")
  puts l.log("hi", n: 4)
  l.bump!
  l.bump!(by: 5)
  puts l.count
  puts Logger.make(prefix: "# ").log("z")
  puts Shape.Sq(side: 3).scaled
  puts Shape.Sq(side: 3).scaled(k: 5)
  each_n { |i| puts "i=#{i}" }
  each_n(3) { |i| puts "j=#{i}" }
  puts pick([5, 6])
  puts pick(["a", "b"], i: 1)
  puts count(1)
  puts count("a")
  puts count(2.5, [1.0, 2.0])
  s = Stack[Int].new(items: [])
  s.push_all!
  s.push_all!([1, 2])
  puts s.size_plus
  puts s.size_plus(n: 0)
  puts show
  puts show
  puts show(1)
  puts fallible(4).unwrap
  puts fallible(4, strict: true).err.unwrap.message
  puts sugar.info("pkg")
  puts sugar.info("pkg", level: 0, attrs: [sugar.Attr.new(key: "k", val: "v")])
  sugar.hello("bob")
  puts copy(1, 2)
  print("builtin print\n")
}

main_()
