# S8: `opt || return/fail/break/next` (the optional's value, else the jump)
# and bare jumps as `case` arms.
error E {
  Bad(s: Str)
  def message -> Str { case self { Bad(s) => "bad #{s}" } }
}

def find(k: Str) -> Int? {
  return none if k == ""
  k.size
}

def first(k: Str) -> Int {
  n = find(k) || return -1
  n * 10
}

def must(k: Str) -> ~Int {
  n = find(k) || fail E.Bad(s: "empty")
  n + 1
}

def sum(xs: [Str]) -> Int {
  t = 0
  for x in xs {
    n = find(x) || next
    t += n
  }
  t
}

def until_empty(xs: [Str]) -> Int {
  t = 0
  for x in xs {
    t += find(x) || break
  }
  t
}

def kind(n: Int) -> Str {
  case n {
    0 => return "zero"
    1 => "one"
    _ => "many"
  }
}

def check(n: Int) -> ~Str {
  s = case n {
    0 => fail E.Bad(s: "zero")
    _ => "ok #{n}"
  }
  s
}

def loopy(xs: [Int]) -> Int {
  t = 0
  for x in xs {
    case x {
      0 => next
      9 => break
      _ => t += x
    }
  }
  t
}

def nothing(k: Str) {
  _n = find(k) || return
  puts "found #{k}"
}

def chain(a: Str, b: Str) -> Int {
  n = find(a) || find(b) || return 0
  n
}

def arg_pos(k: Str) -> Str {
  "len #{(find(k) || return "none") + 1}"
}

def multi(k: Str) -> Int {
  v = find(k) ||
    return -2
  v
}

def scan(xs: [Int]) -> Int {
  i = 0
  total = 0
  while i < xs.size {
    x = xs[i]
    i += 1
    r = case x {
      0 => next
      -1 => break
      _ => x * 2
    }
    total += r
  }
  total
}

puts first("ab")
puts first("")
puts must("abc").unwrap
puts must("").err.unwrap.message
puts sum(["a", "", "abc"])
puts until_empty(["a", "bb", "", "ccc"])
puts kind(0)
puts kind(1)
puts check(0).err.unwrap.message
puts check(5).unwrap
puts loopy([1, 0, 2, 9, 5])
nothing("")
nothing("x")
puts chain("", "abc")
puts chain("", "")
puts arg_pos("ab")
puts arg_pos("")
puts multi("")
puts scan([1, 0, 2, -1, 9])
