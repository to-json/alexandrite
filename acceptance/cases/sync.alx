# R6: a Mutex guards a value shared between tasks; Atomic Int/Bool cells.
struct Stats {
  hits: Int
  names: [Str]
}

m = Mutex.new(Stats.new(hits: 0, names: []))
hits = Atomic.new(0)
done = Atomic.new(false)
ts = (1..4).map { |w|
  spawn {
    (1..250).each { |i|
      m.lock { |s|
        s.hits += 1
        if i % 100 == 0 {
          s.names << "w#{w}-#{i}"
        }
      }
      hits.add(1)
    }
    w
  }
}.to_a
puts ts.sum { it.wait.unwrap }
done.store(true)
total = m.lock { |s| s.hits }
names = m.lock { |s| s.names.sort }
puts total
puts hits.load
puts names.size
puts names[0]
puts done.load
puts hits.swap(7)
puts hits.compare_and_swap(7, 9)
puts hits.compare_and_swap(7, 10)
puts hits.load
