# M2: everyday syntax.
fn half(x: Int) -> Int { x / 2 }         # fn = a pure def (can't fail: proven)
ƒ area(r: Float) -> Float { 3.14159 * r * r }   # so is ƒ

def classify(n: Int) -> Str {
  case n {
    0 => "zero"
    1 | 2 | 3 => "small"
    4...10 => "medium"
    _ => "large"
  }
}

def sign(x: Float) -> Str {
  case {
    x < 0 => "negative"
    x == 0 => "zero"
    _ => "positive"
  }
}

def grade(score: Int) -> Str {
  if score >= 90 { "A" } else if score >= 80 { "B" } else { "C" }
}

def countdown(n: Int) {
  defer puts "liftoff"
  i = n
  while i > 0 {
    puts "#{i}..."
    i -= 1
  }
}

def early(x: Int) -> Int {
  defer puts "cleanup early(#{x})"
  return 0 if x < 0
  x * 2
}

puts half(-7)
puts area(2)
for n in [0, 2, 7, 42] { puts "#{n} is #{classify(n)}" }
puts sign(-2.5)
puts sign(0.0)
puts grade(85)
names = ["ada", "go", "ruby"]
for name, i in names.each_with_index { puts "#{i}: #{name} (#{name.size} bytes)" }
total = 0
for i in 0...10 {
  next if i.odd?
  break if i > 6
  total += i
}
puts "total #{total}"
pi = 3.14159
puts "pi is about #{pi}, #{format("%.2f", pi)} to two places"
puts "escaped \#{not interpolated}"
countdown(3)
for i in 1..2 {
  defer puts "  end of iteration #{i}"
  puts "iteration #{i}"
}
puts early(-1)
puts early(5)
mood = case grade(95) { "A" => "great", _ => "fine" }
puts mood
size = if names.size > 2 { "many" } else { "few" }
puts size
