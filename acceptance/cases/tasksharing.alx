# Tasks and the values they carry: a Mutex captured by a lambda stays shared
# when the lambda is copied into other tasks (port-issues #65: out of a
# Mutex-held table, and via .dup); a task whose result is itself a task handle
# (#66, which needed a zero task handle).
struct Routes {
  hs: [() -> Unit]
}

count = Mutex.new(0)
table = Mutex.new(Routes.new(hs: []))
h = -> () -> Unit {
  count.lock { |v| v += 1 }
  nil
}
table.lock { |r| r.hs << h }
ts: [Task[Unit]] = []
for i in 0...4 {
  f = table.lock { |r| r.hs[0] }
  ts << spawn { f.call }
}
for t in ts { t.~wait }
puts count.lock { |v| v }

mu = Mutex.new(0)
g0 = -> () { mu.lock { |v| v += 1 } }
ts2 = (0...4).map { |i|
  g = g0.dup
  spawn { g.call }
}.to_a
for t in ts2 { t.~wait }
puts mu.lock { |v| v }

def starts_one {
  spawn { 1 }
}
def nested -> ~Int {
  inner = spawn { 20 }
  inner.~wait + 1
}
outer = spawn { starts_one() }
outer.~wait
t2 = spawn { ~nested() }
puts t2.~wait
