# A small package: tests in calc_test.alx share its namespace.

pub def add(a: Int, b: Int) -> Int {
  a + b
}

pub def clamp(x: Int, lo: Int, hi: Int) -> Int {
  return lo if x < lo
  return hi if x > hi
  x
}

# Private: only the package (and its tests) can call it.
def double(x: Int) -> Int {
  x * 2
}

def checked_div(a: Int, b: Int) -> ~Int {
  fail "division by zero" if b == 0
  a / b
}
