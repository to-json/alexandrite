import "util"

test "add" {
  assert_eq add(2, 3), 5
  assert add(1, 1) == 2
}

test "clamp" {
  assert_eq clamp(15, 0, 10), 10
  assert_eq clamp(-4, 0, 10), 0
  assert_eq clamp(7, 0, 10), 7
}

# Tests see private defs, unqualified.
test "private double" {
  assert_eq double(21), 42
}

# A `~` that reaches the top of a test fails it; a handled error doesn't.
test "errors" {
  assert_eq ~checked_div(10, 2), 5
  r = checked_div(1, 0)
  assert r.ok? == false
}

test "imports work" {
  assert_eq util.triple(4), 12
}

test "strings and bools" {
  assert_eq "a" + "b", "ab"
  assert_eq add(1, 2) == 3, true
}

example "printing" {
  puts "hello"
  puts add(2, 2)
} outputs "hello\n4"

example "heredoc" {
  puts "a"
  puts "b"
} outputs <<~EOS
  a
  b
EOS

bench "add" {
  assert_eq add(1, 2), 3
}
