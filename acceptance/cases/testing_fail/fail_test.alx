test "passes" {
  assert_eq inc(1), 2
}

test "assert fails" {
  x = inc(1)
  assert x == 5
}

test "assert_eq fails" {
  assert_eq inc(1), 3
}

test "string mismatch" {
  assert_eq "go" + "pher", "gofer"
}

test "error reaches the top" {
  n = ~boom(3)
  assert_eq n, 0
}

test "panics" {
  xs = [1, 2, 3]
  i = inc(5)
  assert_eq xs[i], 0
}

example "wrong output" {
  puts "got this"
} outputs "want that"

test "after the failures" {
  assert inc(0) == 1
}
