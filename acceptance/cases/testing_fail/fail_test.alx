test "passes" {
  assert_eq inc(1), 2
}

test "assert fails" {
  x = inc(1)
  assert x == 5
}

test "assert_eq fails" {
  assert_eq inc(1), 3
}

test "string mismatch" {
  assert_eq "go" + "pher", "gofer"
}

test "error reaches the top" {
  n = ~boom(3)
  assert_eq n, 0
}

test "panics" {
  xs = [1, 2, 3]
  i = inc(5)
  assert_eq xs[i], 0
}

example "wrong output" {
  puts "got this"
} outputs "want that"

test "after the failures" {
  assert inc(0) == 1
}

# S9: a #[track_caller] helper's failures point at its caller, in both
# t.error's `file:line:` and the builtin asserts.
#[track_caller]
def check_inc(t: testing.T, x: Int, want: Int) {
  t.error("inc(#{x}) = #{inc(x)}, want #{want}") if inc(x) != want
}

#[track_caller]
def assert_inc(x: Int, want: Int) { assert_eq inc(x), want }

test "helper failures" { |t|
  check_inc(t, 1, 2)
  check_inc(t, 2, 4)
}

test "assert helper" {
  assert_inc(7, 9)
}
