# Compiler fixes from the text/template and html/template ports (S3), and
# #[derive(Data)] with #[field(...)] tags (S5).

import "dyn"
import "encoding/json"
import "text/template"

# 1. Mutually recursive `!` methods with declared error sets: a call to a
# `!` method still being checked is covered by the caller's declaration,
# and a def whose failures all come from such calls fails with its
# declared set (it used to be the open Error: "can fail with Error, which
# its `~T<PErr>` doesn't list").
error PErr {
  Bad(at: Int)

  def message -> Str {
    case self {
      Bad(at) => "bad input at #{at}"
    }
  }
}

struct P {
  s: Str
  pos: Int

  def term! -> ~Int<PErr> {
    fail PErr.Bad(at: pos) if pos >= s.size
    c = s[pos]
    self.pos += 1
    if c == 40 {
      v = self.~sum!
      fail PErr.Bad(at: pos) if pos >= s.size || s[pos] != 41
      self.pos += 1
      return v
    }
    fail PErr.Bad(at: pos - 1) if c < 48 || c > 57
    (c - 48).to_i
  }

  def paren! -> ~Int<PErr> { self.~term! }

  def sum! -> ~Int<PErr> {
    v = self.~paren!
    while pos < s.size && s[pos] == 43 {
      self.pos += 1
      v += self.~paren!
    }
    v
  }
}

def eval(s: Str) -> Str {
  p = P.new(s: s)
  r = p.sum!
  if e = r.err {
    return e.message
  }
  "#{r.unwrap}"
}

puts eval("1+2+(3+4)")
puts eval("1+(2+")
puts eval("((9))+x")

# 2. #[derive(Data)] (S5, D59): the generated conversion and Data protocol on
# every backend. The derive gives all its tokens the declaration's span; two
# lambdas in one generated def (two function fields here, and the FuncMap
# of the methods) used to collide (lambdas were known by their span; now by
# their block's id).
#[derive(Data)]
#[data("main.Pet")]
struct Pet {
  #[field(data: "Name")] name: Str
  age: Int
  tags: [Str]
  owner: Str?
  greet: (Str) -> Str
  shout: (Str) -> Str

  #[data("Describe")]
  pub def describe(prefix: Str, n: Int) -> Str { "#{prefix}#{name} (#{age * n})" }

  pub def check(n: Int) -> ~Int {
    fail Failure.Msg("too old") if n > age
    n
  }

  pub def to_s -> Str { "Pet<#{name}>" }
}

pet = Pet.new(name: "Rex", age: 3, tags: ["good", "dog"], greet: ->(s: Str) -> Str { "hi " + s }, shout: ->(s: Str) -> Str { s + "!" })
text = "{{.Name}} {{.age}} {{range $i, $t := .tags}}{{$i}}:{{$t}} {{end}}{{.owner}} {{call .greet .Name}} {{call .shout `woof`}} {{.Describe `a ` 2}} {{Describe `b ` 3}} {{check 2}} {{.}} {{printf `%T %v %q` . .tags .Name}}"
t = template.new("pet").funcs(pet.data_funcs).parse(text).unwrap
puts t.execute_str(pet).unwrap
puts template.new("e").funcs(pet.data_funcs).parse("{{check 9}}").unwrap.execute_str(pet).err?.message || ""

# 3. #[derive(Data)] both ways (S5): to_data / from_data through every field
# kind and one #[field(...)] carrying several derives' tags. (Function
# fields only go to data: Pet above has no from_data.)
#[derive(Data)]
enum Shape {
  Dot
  Circle(r: Float)
  #[data("Rect")] Box(w: Int, h: Int)
}

#[derive(Data)]
struct Drawing {
  #[field(data: "Title")] title: Str
  #[field(data: "-")] scratch: Int
  shapes: [Shape]
  layers: Map[Str, I16]
  origin: [Int; 2]
  parent: Layer?
}

#[derive(Data, Json)]
struct Layer {
  #[field(json: "nm,omitempty", data: "Name", xml: "n,attr")] name: Str
  #[json(skip)] depth: U8
}

d = Drawing.new(title: "plan", scratch: 7, shapes: [Shape.Dot, Shape.Circle(1.5), Shape.Box(2, 3)], layers: {"bg" => 1, "fg" => -2}, origin: [4, 5], parent: Layer.new(name: "base", depth: 2))
v = d.to_data
puts template.new("d").parse("{{.Title}} {{.shapes}} {{.layers}} {{.origin}} {{.parent.Name}}").unwrap.execute_str(v).unwrap
back = Drawing.from_data(v).unwrap
puts "#{back.title} #{back.scratch} #{back.shapes.size} #{back.shapes[2] == Shape.Box(2, 3)} #{back.layers["fg"].unwrap} #{back.origin[1]} #{back.parent.unwrap.name}"
puts Layer.from_data(Layer.new(name: "x", depth: 9).to_data.ptr).unwrap.depth
puts Layer.from_data(dyn.Value.from_json(json.parse("{\"Name\": \"js\", \"depth\": 4}").unwrap)).unwrap.depth
puts Layer.from_data(dyn.Value.int(3)).err?.message || ""
puts Shape.from_data(dyn.Value.str("Hexagon")).err?.message || ""
puts Layer.new(name: "j", depth: 1).to_json.unwrap
puts Layer.new(name: "", depth: 1).to_json.unwrap
