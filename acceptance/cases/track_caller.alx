# S9: #[track_caller] defs receive their call site as a hidden argument;
# caller_location reads it. Nested tracked defs pass their own caller on
# (Rust's semantics); log, testing and slog use it.
import "bytes"
import "log"
import "log/slog"
import "os"

#[track_caller]
def where_am_i -> Str {
  c = caller_location
  "#{c.function} at #{c.file}:#{c.line}:#{c.col}"
}

# Tracked too: where_am_i reports *this* def's caller.
#[track_caller]
def outer -> Str { where_am_i }

# Not tracked: where_am_i reports the line in here.
def plain -> Str { where_am_i }

# Interface methods can be tracked; implementations must match.
interface Checker {
  #[track_caller]
  def check(ok: Bool) -> Str
}

struct Strict {
  name: Str

  #[track_caller]
  def check(ok: Bool) -> Str { "#{name}: #{ok} (#{caller_location})" }
}

# The builtin asserts inside a tracked def report its caller.
#[track_caller]
def must_be_even(n: Int) { assert n % 2 == 0, "odd #{n}" }

#[track_caller]
pub def generic_site[T](x: T) -> Str { "#{x} @ #{caller_location.line}" }

puts where_am_i
puts outer
puts plain
puts caller_location.to_s
c: Checker = Strict.new(name: "via interface")
puts c.check(true)
puts Strict.new(name: "direct").check(false)
f = ->() -> Str { outer }
puts f.call
[1, 2].each { |i| puts "block #{i}: #{where_am_i}" }
puts generic_site(7)
puts generic_site("s")
must_be_even(4)
r = spawn { must_be_even(3) }
puts r.wait.err.unwrap.message

# log: LSHORTFILE / LLONGFILE name the logging call.
b = bytes.new_buffer([])
l = log.new(b, "p: ", log.LSHORTFILE)
l.print("short")
l.set_flags(log.LLONGFILE | log.LMSGPREFIX)
l.println("long")
print l.writer.string

# slog: add_source records the call site.

opts = slog.HandlerOptions.new(add_source: true, replace_attr: ->(gs: [Str], a: slog.Attr) -> slog.Attr {
  return slog.Attr.new if a.key == slog.TIME_KEY
  a
})
logger = slog.new(slog.new_text_handler(os.stdout, opts))
logger.info("hello", [slog.int("n", 1)])
logger.with([slog.string("k", "v")]).warn("again", [])
