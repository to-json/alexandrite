# S9 in std: log's file flags and slog's add_source name the logging call.
import "bytes"
import "log"
import "log/slog"
import "os"

# A wrapper reporting its own caller (Go: Output(2, s)).
#[track_caller]
def info(l: log.Logger[bytes.Buffer], s: Str) { l.output(2, s).unwrap }

b = bytes.new_buffer([])
l = log.new(b, "p: ", log.LSHORTFILE)
l.print("short")
info(l, "wrapped")
l.set_flags(log.LLONGFILE | log.LMSGPREFIX)
l.println("long")
print l.writer.string

opts = slog.HandlerOptions.new(add_source: true, replace_attr: ->(gs: [Str], a: slog.Attr) -> slog.Attr {
  return slog.Attr.new if a.key == slog.TIME_KEY
  a
})
logger = slog.new(slog.new_text_handler(os.stdout, opts))
logger.info("hello", [slog.int("n", 1)])
logger.with([slog.string("k", "v")]).warn("again", [])
slog.new(slog.new_json_handler(os.stdout, opts)).error("json", [])
