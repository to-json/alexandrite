struct P {
  a: Int

  fn twice -> ~Int { ~(a * 2) }
  fn plus(n: Int) -> ~Int { ~(a + n) }
  fn a_twice -> ~Int { ~twice }
  fn b_twice -> ~Int { ~self.twice }
  fn c_twice -> ~Int { ~self.twice() }
  fn d_plus -> ~Int { ~self.plus(1) }
  fn e_twice -> ~Int { ~(self.twice) }
}

fn via(p: P) -> ~Int { ~p.twice }
fn via_plus(p: P) -> ~Int { ~p.plus(5) }

p = P.new(a: 4)
puts p.a_twice.rescue { |e| 0 }
puts p.b_twice.rescue { |e| 0 }
puts p.c_twice.rescue { |e| 0 }
puts p.d_plus.rescue { |e| 0 }
puts p.e_twice.rescue { |e| 0 }
puts via(p).rescue { |e| 0 }
puts via_plus(p).rescue { |e| 0 }
