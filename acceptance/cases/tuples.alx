# Tuples: Go's multiple results as values — `(A, B)` types, `(a, b)` literals,
# `return a, b`, `a, b = pair`, `t[0]`, `(A, B)?`.
def divmod(a: Int, b: Int) -> (Int, Int) {
  return a / b, a % b
}
def cut(s: Str, sep: Str) -> (Str, Str)? {
  return none if sep.size == 0
  ("x#{s}", sep)
}
q, r = divmod(17, 5)
puts q
puts r
p = divmod(9, 4)
puts p.first + p.last
puts p
if c = cut("a", ",") {
  b, a = c
  puts b + a
}
puts cut("a", "") || ("none", "!")
small: (I32, Str) = (3, "s")
puts small
t3 = (1, "a", 2.5)
puts t3[1]
puts t3[2] + 1.0
puts t3[0] == 1
