# M4: types. Methods, operators, enums, interfaces, generics, lambdas.

struct Point {
  x: Float
  y: Float

  def norm -> Float { (x * x + y * y).sqrt } # fields read bare
  def move!(dx: Float, dy: Float) { # `!`: changes the receiver
    self.x += dx
    self.y += dy
  }
  def reset! { move!(-x, -y) }
}

struct Body {
  pos: Point
  def drift! { pos.move!(1.0, 1.0) } # through a field
}

struct V2 {
  x: Int
  y: Int
  def +(o: V2) -> V2 { V2.new(x: x + o.x, y: y + o.y) }
  def *(k: Int) -> V2 { V2.new(x: x * k, y: y * k) }
  def <=>(o: V2) -> Int { (x * x + y * y) - (o.x * o.x + o.y * o.y) }
  def to_s -> Str { "(#{x}, #{y})" } # puts and "#{}" use it
}

enum Shape {
  Circle(r: Float)
  Rect(w: Float, h: Float)
  Empty

  def area -> Float {
    case self {
      Circle(r) => 3.0 * r * r
      Rect(w, h) => w * h
      Empty => 0.0
    }
  }
}

enum Color { Red, Green, Blue }

interface Named {
  def name -> Str
  def greeting -> Str { "hello, #{name}" } # a default method
}

struct Dog {
  def name -> Str { "dog" }
}

struct Robot {
  id: Int
  def name -> Str { "robot #{id}" }
  def greeting -> Str { "BEEP #{id}" }
}

struct Stack[T] {
  items: [T]
  def push!(x: T) { self.items << x }
  def pop! -> T? {
    return none if items.size == 0
    x = items[items.size - 1]
    self.items = items[...items.size - 1]
    x
  }
}

def largest[T](xs: [T]) -> T {
  best = xs[0]
  for x in xs { best = x if x > best }
  best
}

def sum_all[N: like Int](xs: [N]) -> N {
  total: N = 0
  for x in xs { total += x }
  total
}

def apply_twice(f: (Int) -> Int, x: Int) -> Int { f(f(x)) }
def make_adder(n: Int) -> (Int) -> Int { ->(x: Int) { x + n } }

# --- methods
p = Point.new(x: 3.0, y: 4.0)
puts p.norm
p.move!(1.0, 1.0)
puts p.x
p.reset!
puts p.x
b = Body.new(pos: p)
b.drift!
puts b.pos.x
ps = [Point.new(x: 1.0, y: 0.0), Point.new(x: 2.0, y: 0.0)]
ps[1].move!(10.0, 0.0)
puts ps[1].x

# --- operators and equality
a = V2.new(x: 1, y: 2)
c = a + V2.new(x: 3, y: 4) * 2
puts c
puts a < c
puts a == V2.new(x: 1, y: 2)
puts p
puts [a, c]

# --- enums
shapes = [Shape.Circle(1.0), Shape.Rect(w: 2.0, h: 3.0), Shape.Empty]
puts shapes.sum { it.area }
puts shapes
puts Color.Blue
puts Color.Blue.to_i
puts Shape.Circle(1.0) == Shape.Circle(1.0)
case Color.Green {
  Red => puts "red"
  Green | Blue => puts "not red"
}

# --- interfaces
named: [Named] = [Dog.new, Robot.new(id: 7)]
named.each { puts it.greeting }
puts Dog.new.greeting

# --- generics
s = Stack[Int].new
s.push!(1)
s.push!(2)
puts s.pop!
puts s.items
words = Stack.new(items: ["a"])
words.push!("b")
puts words.pop! || "?"
puts largest([3, 9, 2])
puts largest(["b", "c", "a"])
puts sum_all([1, 2, 3])

# --- lambdas
double = ->(x: Int) -> Int { x * 2 }
puts double(5)
puts apply_twice(double, 3)
puts apply_twice(make_adder(100), 1)
puts apply_twice(->(x) { x - 1 }, 10)
ops: [(Int, Int) -> Int] = [->(a, b) { a + b }, ->(a, b) { a * b }]
ops.each { puts it(6, 7) }
