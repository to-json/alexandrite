# D65: a `case` over an interface value matches its implementors (Go's type
# switch), also with a type parameter as the pattern; and a def or lambda
# returning T? whose last `case` returns in every arm (it used to wrap the
# Never value as present, which the JIT rejected).
interface Named {
  def name -> Str
}

struct Dog {
  def name -> Str { "dog" }
}

struct Bot {
  id: Int

  def name -> Str { "bot" }
}

enum Shape {
  Circle(r: Float)
  Square(s: Float)

  def name -> Str { "shape" }
}

def id_of(n: Named) -> Int {
  case n {
    Bot(b) => b.id
    Dog => -1
    Shape(s) => {
      case s {
        Circle(_r) => -2
        Square(_s) => -3
      }
    }
    _ => 0
  }
}

def pick[T](n: Named, d: T) -> T {
  case n {
    T(v) => v
    _ => d
  }
}

struct Hook {
  f: (Named) -> Str?
}

def hook_for[T](g: (T) -> Str) -> Hook {
  Hook.new(f: ->(n: Named) -> Str? {
    case n {
      T(v) => {return g(v)}
      _ => {return none}
    }
  })
}

def first(n: Int) -> Str? {
  case n {
    1 => {return "one"}
    _ => {return none}
  }
}

def describe(xs: [Named], hs: [Hook]) -> ~Str<Error> {
  out = ""
  for x in xs {
    got = "none"
    for h in hs {
      if r = h.f.call(x) {
        got = r
        break
      }
    }
    out = out + got + ";"
  }
  out
}

puts id_of(Bot.new(id: 3))
puts id_of(Dog.new)
puts id_of(Shape.Square(1.0))
puts pick(Bot.new(id: 9), Bot.new(id: 0)).id
puts pick(Dog.new, Bot.new(id: 4)).id
puts pick(Shape.Square(2.5), Shape.Circle(0.0))
hs = [hook_for(->(b: Bot) -> Str { "bot #{b.id}" }), hook_for(->(c: Shape) -> Str { "a shape" })]
xs: [Named] = [Bot.new(id: 7), Shape.Circle(2.0), Dog.new]
puts describe(xs, hs).unwrap
puts first(1) || "-"
puts first(2) || "-"
