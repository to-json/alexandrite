# Packages Go's std vendors are std packages under their own import paths
# (the path's first element contains a dot): golang.org/x/crypto/cryptobyte.
import "golang.org/x/crypto/cryptobyte"
import cbasn1 "golang.org/x/crypto/cryptobyte/asn1"

b = cryptobyte.new_builder([])
b.add_asn1!(cbasn1.SEQUENCE) { |c|
  c.add_asn1_int64!(-129)
  c.add_u8_length_prefixed! { |d| d.add_bytes!("hi".bytes) }
  c.add_asn1_boolean!(true)
}
der = b.bytes.unwrap
puts der

s = cryptobyte.string(der)
if inner0 = s.read_asn1!(cbasn1.SEQUENCE) {
  inner = inner0
  puts inner.read_asn1_int64! || 0
  skipped = inner.skip!(3)
  puts skipped
  puts inner.read_asn1_boolean! || false
  puts inner.empty?
}
puts s.empty?
bad = cryptobyte.string([0x30.as_u8, 0x81, 0x01, 0x00])
puts bad.read_asn1!(cbasn1.SEQUENCE).none?
