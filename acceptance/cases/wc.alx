# L2: `wc` of this very file, through os, io and bufio.
import "os"
import "io"
import "bufio"

path = "wc.alx"
f = ~os.open(path)

# Lines and the longest one: a Scanner reads the file in big buffered chunks.
lines = 0
longest = 0
sc = bufio.new_scanner(f)
while sc.scan! {
  lines += 1
  longest = sc.bytes.size if sc.bytes.size > longest
}
puts "scan error: #{sc.err.none?}"

# The descriptor is shared with the scanner: rewind it and count words.
f.~seek!(0, io.SEEK_START)
words = 0
ws = bufio.new_scanner(f)
ws.split!(bufio.scan_words)
while ws.scan! {
  words += 1
}

info = ~os.stat(path)
f.~close!

# Output through a buffered writer over os.stdout.
out = bufio.new_writer(os.stdout)
out.~write_string!("#{lines} #{words} #{info.size} #{info.name}\n")
out.~write_string!("longest line: #{longest} bytes\n")
out.~write_string!("regular file: #{info.is_regular}\n")
out.~flush!

# A missing file fails with Go's message.
missing = os.open("no-such-file.txt")
puts missing.err.unwrap.message
puts os.is_not_exist(missing.err.unwrap)
puts os.args.size >= 1
