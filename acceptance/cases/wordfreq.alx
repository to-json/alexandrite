# Memory benchmark: count 1,000,000 words drawn from a 20,000-word vocabulary
# (a Map[Str, Int] and a string per word), then print the 5 most common.
import "slices"

def word(n: Int) -> Str {
  letters = "etaoinshrdlucmfwypvbgkjqxz"
  s = ""
  x = n
  loop {
    s += letters[x % 26...x % 26 + 1]
    x /= 26
    break if x == 0
  }
  s
}

counts: Map[Str, Int] = {}
seed = 42
for _ in 0...1_000_000 {
  seed = (seed * 1103515245 + 12345) % 2147483648
  w = word(seed % 20000)
  counts[w] = (counts[w] || 0) + 1
}
pairs: [(Str, Int)] = []
for k in counts.keys { pairs << (k, counts[k] || 0) }
slices.sort_func(pairs) { |a, b|
  a[1] != b[1] ? b[1] - a[1] : (a[0] < b[0] ? -1 : (a[0] > b[0] ? 1 : 0))
}
puts counts.size
for p in pairs[0...5] { puts "#{p[0]} #{p[1]}" }
