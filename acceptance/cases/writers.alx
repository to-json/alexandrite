# R4: `!` methods through interfaces (Go's pointer receivers): io.Writer-style.
interface Writer {
  def write!(s: Str) -> Int
  def written -> Str
}

struct Buffer {
  data: Str
  def write!(s: Str) -> Int {
    self.data = data + s
    s.size
  }
  def written -> Str { data }
}

struct Counter {
  n: Int
  def write!(s: Str) -> Int {
    self.n += s.size
    s.size
  }
  def written -> Str { "#{n} bytes" }
}

def emit(w: Writer, lines: [Str]) -> Writer {
  out = w
  for l in lines { out.write!(l + "\n") }
  out
}

ws: [Writer] = [Buffer.new, Counter.new]
ws = ws.map { emit(it, ["a", "bb", "ccc"]) }.to_a
for w in ws { puts w.written }
b: Writer = Buffer.new
total = 0
(1..3).each { total += b.write!("x#{it}") }
puts total
puts b.written

# A fallible ! method: through an interface the call is a held ~T; `~` on a
# direct call propagates after the receiver is written back.
interface Setter {
  def set!(s: Str) -> ~Int
}
struct LenSetter {
  x: Int
  def set!(s: Str) -> ~Int {
    fail "empty" if s.size == 0
    self.x = s.size
    self.x
  }
}
setters: [Setter] = [LenSetter.new(x: 0)]
sr = setters[0].set!("")
puts sr.err?
sx = setters[0].set!("abcd")
puts sx.unwrap
struct Acc {
  n: Int
  def add!(k: Int) -> ~Int {
    fail "neg" if k < 0
    self.n += k
    self.n
  }
}
def twice_add(t: Acc) -> ~Int {
  u = t
  a = u.~add!(2)
  b = ~u.add!(3)
  a + b + u.n
}
puts twice_add(Acc.new(n: 0)).unwrap
