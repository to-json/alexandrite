# Compiler fixes from the x509 port.
#
# 1. Slice `==` inside the arguments of a `~` call isn't a possible
#    IndexError (its element reads are in range by construction).
error E {
  Bad
  def message -> Str { "bad" }
}

def check(ok: Bool) -> ~Unit<E> {
  fail E.Bad if !ok
}

def magic -> [Byte] { [5.as_u8, 0] }

def f(a: [Byte]) -> ~Int<E> {
  ~check(a == magic())
  ~check(a != [1.as_u8])
  a.size
}

puts f([5.as_u8, 0]).ok?
puts f([5.as_u8]).ok?
puts f([5.as_u8, 1]).ok?
puts f([]).err?.message || ""
