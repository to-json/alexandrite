# Compiler fixes from the x509 port.
#
# 1. Slice `==` inside the arguments of a `~` call isn't a possible
#    IndexError (its element reads are in range by construction).
# 2. A constant right shift of a narrow unsigned value is emitted on the
#    narrow value, so clang recognises rotations (U32 rotates: ChaCha20
#    1.5x, SHA-256 2x faster in --release).
error E {
  Bad
  def message -> Str { "bad" }
}

def check(ok: Bool) -> ~Unit<E> {
  fail E.Bad if !ok
}

def magic -> [Byte] { [5.as_u8, 0] }

def f(a: [Byte]) -> ~Int<E> {
  ~check(a == magic())
  ~check(a != [1.as_u8])
  a.size
}

puts f([5.as_u8, 0]).ok?
puts f([5.as_u8]).ok?
puts f([5.as_u8, 1]).ok?
puts f([]).err?.message || ""

def rotl32(x: U32, k: Int) -> U32 { (x << k) | (x >> (32 - k)) }
def rot16(x: U32) -> U32 { (x << 16) | (x >> 16) }
def rot3(x: U8) -> U8 { (x << 3) | (x >> 5) }
a: U32 = 0x80000001
puts rot16(a)
puts rotl32(a, 7)
puts rot3(0x81.as_u8)
b: U16 = 0xff00
puts b >> 4
puts (b >> 15)
