# #[derive(Xml)] (D65): Go's encoding/xml struct tags at compile time, a
# hand-written Marshaler / TextMarshaler through interface defaults, the
# token API.
import "encoding/xml"
import "strings"

#[derive(Xml)]
struct Addr {
  #[field(xml: "City")] city: Str
  #[field(xml: "zip,attr,omitempty")] zip: Int
}

# Text form only: the protocol comes from xml.TextMarshaler's defaults.
struct Level {
  n: Int
  pub def marshal_text -> ~[Byte] { "L#{n}".bytes }
  pub def unmarshal_text!(b: [Byte]) -> ~Unit {
    s = Str.from_bytes(b)
    fail "bad level #{s}" if !s.start_with?("L")
    self.n = s[1...s.size].to_i
    nil
  }
}

#[derive(Xml)]
struct Person {
  #[field(xml: "urn:p person")] xml_name: xml.Name
  #[field(xml: "id,attr")] id: Int
  #[field(xml: "name>first")] first: Str
  #[field(xml: "name>last")] last: Str
  #[field(xml: "nick,omitempty")] nick: Str?
  #[field(xml: "tag")] tags: [Str]
  #[field(xml: "level")] level: Level
  #[field(xml: ",embed")] addr: Addr
  #[field(xml: ",comment")] note: Str
  #[field(xml: "-")] cache: Int
}

p = Person.new(id: 7, first: "Ada", last: "L<ovelace>", tags: ["a", "b&c"], level: Level.new(n: 3), addr: Addr.new(city: "London", zip: 0), note: " hi ", cache: 99)
s = p.to_xml.unwrap
puts s
q = Person.from_xml(s).unwrap
puts "#{q.first} #{q.last} #{q.tags.size} #{q.level.n} #{q.addr.city} #{q.cache} #{q.xml_name.space}"
puts p.to_xml_indent("", " ").unwrap
r = Person.from_xml("<person xmlns='urn:p' id='x'/>")
puts r.err?.message || "ok"
r2 = Person.from_xml("<other xmlns='urn:p'/>")
puts r2.err?.message || "ok"
r3 = Person.from_xml("<person xmlns='urn:p'><level>Q</level></person>")
puts r3.err?.message || "ok"

d = xml.new_string_decoder("<a x='1'><b>t&amp;u</b><!--c--></a>")
loop {
  t = d.token!.unwrap
  break if t.none?
  case t || xml.char_data("") {
    StartElement(e) => puts "start #{e.name.local} #{e.attr.size}"
    EndElement(e) => puts "end #{e.name.local}"
    CharData(b) => puts "text #{Str.from_bytes(b)}"
    Comment(b) => puts "comment #{Str.from_bytes(b)}"
    _ => nil
  }
}
puts strings.contains(xml.escape_str("<&>", true), "&lt;")
