#![test(external)]
# External tests: the package as a user sees it.
import "example.com/shapes"
import "example.com/shapes/shapetest"

#[track_caller]
def check_square(t: testing.T, n: Int, want: Int) {
  t.error("square(#{n}).area = #{shapes.square(n).area}, want #{want}") if shapes.square(n).area != want
}

test "public API" { |t|
  check_square(t, 3, 9)
  t.log("checked")
  ~shapetest.check_area(shapes.doubled(shapes.square(2)), 8)
  assert_eq shapes.scale_for_tests(5), 10
}

example "user view" {
  puts shapes.square(4).area
} outputs "16"
