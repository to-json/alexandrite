# A package with both kinds of tests (S11): shapes_test.alx is part of
# the package; api_test.alx is an external test, a package of its own
# that imports this one (and shapetest, which imports it too).

pub struct Rect {
  w: Int
  h: Int

  pub def area -> Int { w * h }
}

pub def square(n: Int) -> Rect { Rect.new(w: n, h: n) }

# Private: only the in-package tests see it.
def scale(x: Int) -> Int { x * 2 }

pub def doubled(r: Rect) -> Rect { Rect.new(w: scale(r.w), h: r.h) }
