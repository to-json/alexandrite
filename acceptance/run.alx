# Acceptance harness for ACCEPTANCE.md (A1–A6) and every milestone since.
#
# usage: alx run acceptance/run.alx [-k FILTER]
#
# Builds the compiler (release), then for every case:
#   1. debug   `alx run`: stdout, edit-to-answer budget
#   2. release `alx build --release`: stdout, run time vs the Rust reference
#   3. safety  ASan/UBSan build, and the Rust oracle (rustc must accept it,
#              and its output must match)
#   4. negative cases: the first error (message + file:line:col) must match
# plus the A3 promote-overhead check, the A6 workflow checks, the module,
# memory, std and `alx test` checks and the runtime license manifest. Exit
# status 0 iff everything passes.

import "fmt"
import "os"
import "os/exec"
import "path"
import "sh"
import "slices"
import "strings"

struct Check {
  group: Str
  name: Str
  ok: Bool
  detail: Str
}

# A finished command: what it printed, how it ended, how long it took.
struct Ran {
  stdout: Str
  stderr: Str
  code: Int    # exit status; -signal if killed
  ms: Float
  rss: Int     # peak resident bytes
}

# ------------------------------------------------------------------ helpers

# Runs argv in dir with extra "KEY=value" variables.
def run_in(argv: [Str], dir: Str, extra: [Str]) -> ~Ran {
  c = exec.command(argv[0], argv[1...argv.size])
  c.dir = dir
  c.env = merged_env(extra) if extra.size > 0
  r = c.~capture
  st = r.state
  Ran.new(stdout: r.stdout, stderr: r.stderr, code: st.signal != 0 ? -st.signal : st.exit_code, ms: st.wall_ns.to_f / 1e6, rss: st.max_rss)
}

# This process's environment with these "KEY=value" entries set.
def merged_env(extra: [Str]) -> [Str] {
  keys: [Str] = []
  for kv in extra { keys << kv[0...strings.index(kv, "=")] }
  out: [Str] = []
  for kv in os.environ {
    i = strings.index(kv, "=")
    out << kv if i < 0 || !slices.contains(keys, kv[0...i])
  }
  out + extra
}

def median(xs: [Float]) -> Float {
  ys = xs.dup
  slices.sort(ys)
  n = ys.size
  return ys[n / 2] if n % 2 == 1
  (ys[n / 2 - 1] + ys[n / 2]) / 2.0
}

def trim(s: Str) -> Str { strings.trim_space(s) }

def first_n(s: Str, n: Int) -> Str { s.size <= n ? s : s[0...n] }

def last_n(s: Str, n: Int) -> Str { s.size <= n ? s : s[s.size - n...s.size] }

# The Int after `key` in text (`alx-allocs: 12` with key "alx-allocs: ",
# `peak=4096` with key "peak="), or -1.
def int_after(text: Str, key: Str) -> Int {
  i = strings.index(text, key)
  return -1 if i < 0
  j = i + key.size
  k = j
  while k < text.size && text[k] >= 48 && text[k] <= 57 { k += 1 }
  return -1 if k == j
  text[j...k].to_i
}

def digits_at(s: Str, i: Int) -> Int {
  k = i
  while k < s.size && s[k] >= 48 && s[k] <= 57 { k += 1 }
  k - i
}

# Timings vary: `(0.12s)` and a line's final ` 0.123s` become constants.
def norm_test_output(text: Str) -> Str {
  out: [Str] = []
  for line in text.split("\n") {
    b = ""
    i = 0
    while i < line.size {
      # (D+.DDs)
      if line[i] == 40 {
        d = digits_at(line, i + 1)
        j = i + 1 + d
        if d > 0 && j + 4 < line.size + 1 && j < line.size && line[j] == 46 && digits_at(line, j + 1) == 2 && j + 4 < line.size && line[j + 3] == 115 && line[j + 4] == 41 {
          b += "(0.00s)"
          i = j + 5
          next
        }
      }
      b += line[i...i + 1]
      i += 1
    }
    # trailing " D+.DDDs"
    sp = strings.last_index(b, " ")
    if sp >= 0 && strings.has_suffix(b, "s") {
      tail = b[sp + 1...b.size - 1]
      dot = strings.index(tail, ".")
      if dot > 0 && digits_at(tail, 0) == dot && digits_at(tail, dot + 1) == 3 && tail.size == dot + 4 {
        b = b[0...sp] + " 0.000s"
      }
    }
    out << b
  }
  out.join("\n")
}

# A line `Benchmarkadd <n> <x> ns/op`.
def has_bench_line(text: Str) -> Bool {
  for line in text.split("\n") {
    ws: [Str] = []
    for w in line.split(" ") { ws << w if w != "" }
    if ws.size == 4 && ws[0] == "Benchmarkadd" && digits_at(ws[1], 0) == ws[1].size && ws[3] == "ns/op" {
      return true
    }
  }
  false
}

# ------------------------------------------------------------------ the harness

struct H {
  root: Str
  cases: Str
  refs: Str
  alx: Str
  work: Str
  results: [Check]

  def check!(group: Str, name: Str, ok: Bool, detail: Str) {
    results << Check.new(group: group, name: name, ok: ok, detail: detail)
    mark = ok ? "PASS" : "FAIL"
    puts "  [#{mark}] #{group} #{name}" + (detail != "" ? ": #{detail}" : "")
  }

  def run(argv: [Str]) -> ~Ran { ~run_in(argv, cases, []) }

  def best_ms(argv: [Str], n: Int, dir: Str, extra: [Str]) -> ~Float {
    b = 1.0e18
    k = 0
    while k < n {
      r = ~run_in(argv, dir, extra)
      b = r.ms if r.ms < b
      k += 1
    }
    b
  }
}

def budget(h: H, c: Str) -> ~Map[Str, Float] {
  b: Map[Str, Float] = {}
  p = "#{h.cases}/#{c}.budget"
  return b if !sh.exists?(p)
  for line in ~sh.read_lines(p) {
    ws: [Str] = []
    for w in line.split(" ") { ws << w if w != "" }
    b[ws[0]] = ~strconv_float(ws[1]) if ws.size == 2
  }
  b
}

def strconv_float(s: Str) -> ~Float {
  dot = strings.index(s, ".")
  return s.to_i.to_f if dot < 0
  whole = s[0...dot].to_i.to_f
  frac = s[dot + 1...s.size]
  scale = 1.0
  for _ in 0...frac.size { scale *= 10.0 }
  whole + frac.to_i.to_f / scale
}

