# Declarations every program sees: the compiler parses this file with the
# program (front::add_builtins), so each backend compiles them like user
# code and they behave identically everywhere.

# Complex: Go's complex128 (GO-VS-RUBY D53). `Complex.new(r, i)` is Go's
# complex(r, i), `c.real` / `c.imag` are real(c) / imag(c); `2i` is an
# imaginary literal; numeric constants adapt to Complex (`c * 2`, `1 + 2i`).
# The arithmetic is Go's: `*` is the plain formula (no C99 Annex G
# recovery), `/` is the Go runtime's complex128div (Smith's algorithm with
# C99's infinity fixups), `==` compares both parts (NaN != NaN, -0 == 0).
# Printing is fmt's `%v`: `(1+2i)`, `(NaN+Infi)`.
struct Complex {
  real: Float
  imag: Float

  pub def +(o: Complex) -> Complex { Complex.new(real + o.real, imag + o.imag) }

  pub def -(o: Complex) -> Complex { Complex.new(real - o.real, imag - o.imag) }

  pub def *(o: Complex) -> Complex {
    Complex.new(real * o.real - imag * o.imag, real * o.imag + imag * o.real)
  }

  # Go's runtime.complex128div.
  pub def /(m: Complex) -> Complex {
    a = real
    b = imag
    c = m.real
    d = m.imag
    e = 0.0
    f = 0.0
    if c.abs >= d.abs {
      ratio = d / c
      denom = c + ratio * d
      e = (a + b * ratio) / denom
      f = (b - a * ratio) / denom
    } else {
      ratio = c / d
      denom = d + ratio * c
      e = (a * ratio + b) / denom
      f = (b * ratio - a) / denom
    }
    if e != e && f != f {
      inf = 0x7FF0000000000000.as_u64.__from_bits
      if c == 0.0 && d == 0.0 && (a == a || b == b) {
        e = inf.__copysign(c) * a
        f = inf.__copysign(c) * b
      } else if (Complex.__inf?(a) || Complex.__inf?(b)) && Complex.__finite?(c) && Complex.__finite?(d) {
        a = Complex.__inf2one(a)
        b = Complex.__inf2one(b)
        e = inf * (a * c + b * d)
        f = inf * (b * c - a * d)
      } else if (Complex.__inf?(c) || Complex.__inf?(d)) && Complex.__finite?(a) && Complex.__finite?(b) {
        c = Complex.__inf2one(c)
        d = Complex.__inf2one(d)
        e = 0.0 * (a * c + b * d)
        f = 0.0 * (b * c - a * d)
      }
    }
    Complex.new(e, f)
  }

  # -c (Go negates both parts).
  pub def __neg -> Complex { Complex.new(-real, -imag) }

  # fmt's %v: the real part, then the imaginary part with its sign, then `i`.
  pub def to_s -> Str {
    im = imag.to_s
    im = "+" + im if im[0] != 45 && im[0] != 43
    "(" + real.to_s + im + "i)"
  }

  # The imaginary literal `2i`.
  pub def self.__imag(v: Float) -> Complex { Complex.new(0.0, v) }

  pub def self.__inf?(x: Float) -> Bool { x - x != x - x && x == x }

  pub def self.__finite?(x: Float) -> Bool { x - x == x - x }

  # A signed 1 if x is an infinity, else a signed 0 (the sign of x).
  pub def self.__inf2one(x: Float) -> Float {
    g = 0.0
    g = 1.0 if Complex.__inf?(x)
    g.__copysign(x)
  }
}

# `a == b` on maps (Go's reflect.DeepEqual for maps): the same keys, with
# equal values (`==` on the values, maps among them).
pub def __map_eq[K, V](a: Map[K, V], b: Map[K, V]) -> Bool {
  return false if a.size != b.size
  for k in a.keys {
    v = b[k]
    return false if v == none
    return false if a[k] != v
  }
  true
}

# ------------------------------------------------------------- fmt engine

# Go's fmt formatting (fmt/format.go and the scalar cases of fmt/print.go),
# which `format`, `fmt.sprintf` and friends call for any directive with
# flags, a width or a precision, and for the verbs the runtime doesn't do
# itself (GO-VS-RUBY D65). The checker turns `%-+# 0w.pV` into
# (verb, flags, width, precision); flags are bits:
#   1 minus, 2 plus, 4 sharp, 8 space, 16 zero, 32 width present,
#   64 precision present, 128 plusV (%+v), 256 sharpV (%#v).
# Verbs are their character codes. `pub` so that packages' formats reach
# them.

pub def __fmt_runes(s: Str) -> Int {
  n = 0
  i = 0
  while i < s.size {
    c = s[i]
    if c < 0x80 {
      i += 1
    } else {
      w = __fmt_rune_len_at(s, i)
      i += w
    }
    n += 1
  }
  n
}

# The byte length of the (possibly invalid) UTF-8 sequence at s[i]: 1 for
# an invalid byte, as Go's decoder counts it.
pub def __fmt_rune_len_at(s: Str, i: Int) -> Int {
  c = s[i].to_i
  return 1 if c < 0x80
  n = c >= 0xF0 ? 4 : (c >= 0xE0 ? 3 : (c >= 0xC2 ? 2 : 0))
  return 1 if n == 0 || c > 0xF4 || i + n > s.size
  k = 1
  while k < n {
    return 1 if s[i + k] & 0xC0 != 0x80
    k += 1
  }
  b1 = s[i + 1].to_i
  return 1 if n == 3 && c == 0xE0 && b1 < 0xA0
  return 1 if n == 3 && c == 0xED && b1 >= 0xA0
  return 1 if n == 4 && c == 0xF0 && b1 < 0x90
  return 1 if n == 4 && c == 0xF4 && b1 >= 0x90
  n
}

# The rune at s[i] (U+FFFD for an invalid byte) and its length.
pub def __fmt_rune_at(s: Str, i: Int) -> (Int, Int) {
  c = s[i].to_i
  return (c, 1) if c < 0x80
  n = __fmt_rune_len_at(s, i)
  return (0xFFFD, 1) if n == 1
  r = c & (n == 2 ? 0x1F : (n == 3 ? 0x0F : 0x07))
  k = 1
  while k < n {
    r = r << 6 | (s[i + k].to_i & 0x3F)
    k += 1
  }
  (r, n)
}

# Go's writePadding: n bytes of padding, zeros only on the left.
pub def __fmt_padding(n: Int, flags: Int) -> Str {
  return "" if n <= 0
  flags & 16 != 0 && flags & 1 == 0 ? "0" * n : " " * n
}

# Go's pad / padString: s padded to the width (in runes).
pub def __fmt_pad(s: Str, flags: Int, wid: Int) -> Str {
  return s if flags & 32 == 0 || wid == 0
  n = wid - __fmt_runes(s)
  return s if n <= 0
  p = __fmt_padding(n, flags)
  flags & 1 == 0 ? p + s : s + p
}

# Go's pad without zero padding (the caller already placed any zeros).
pub def __fmt_pad_spaces(s: Str, flags: Int, wid: Int) -> Str {
  __fmt_pad(s, flags &^ 16, wid)
}

# Go's fmtInteger: u in base, with the sign, precision, zero padding and
# the `#` prefixes (0b, 0, 0x / 0X); `O` adds 0o.
pub def __fmt_integer(u0: U64, base: Int, signed: Bool, verb: Int, upper: Bool, flags: Int, wid: Int, prec0: Int) -> Str {
  negative = signed && u0.as_i64 < 0
  u = u0
  u = 0.as_u64 -% u if negative
  digits = upper ? "0123456789ABCDEFX" : "0123456789abcdefx"
  prec = 0
  if flags & 64 != 0 {
    prec = prec0
    # Precision 0 and value 0 means "print nothing" but padding.
    return __fmt_padding(wid, flags &^ 16) if prec == 0 && u == 0 && flags & 32 != 0
    return "" if prec == 0 && u == 0
  } elsif flags & 16 != 0 && flags & 1 == 0 && flags & 32 != 0 {
    prec = wid
    prec -= 1 if negative || flags & 2 != 0 || flags & 8 != 0
  }
  out: [Byte] = []
  b = base.as_u64
  loop {
    out << digits[(u % b).to_i]
    u = u / b
    break if u == 0
  }
  while out.size < prec {
    out << 48.as_u8
  }
  if flags & 4 != 0 {
    if base == 2 {
      out << 98.as_u8
      out << 48.as_u8
    } elsif base == 8 {
      out << 48.as_u8 if out[out.size - 1] != 48
    } elsif base == 16 {
      out << digits[16]
      out << 48.as_u8
    }
  }
  if verb == 79 {
    out << 111.as_u8
    out << 48.as_u8
  }
  if negative {
    out << 45.as_u8
  } elsif flags & 2 != 0 {
    out << 43.as_u8
  } elsif flags & 8 != 0 {
    out << 32.as_u8
  }
  out.reverse!
  __fmt_pad_spaces(Str.from_bytes(out), flags, wid)
}

# Go's fmtC: the character with code c (U+FFFD past the last code point).
pub def __fmt_c(c: U64, flags: Int, wid: Int) -> Str {
  r = c > 0x10FFFF ? 0xFFFD : c.to_i
  __fmt_pad(__fmt_rune_str(r), flags, wid)
}

# The UTF-8 encoding of r (U+FFFD for a surrogate or past the last code point).
pub def __fmt_rune_str(r0: Int) -> Str {
  r = r0
  r = 0xFFFD if r < 0 || r > 0x10FFFF || (r >= 0xD800 && r <= 0xDFFF)
  out: [Byte] = []
  if r < 0x80 {
    out << r.as_u8
  } elsif r < 0x800 {
    out << (0xC0 | r >> 6).as_u8
    out << (0x80 | r & 0x3F).as_u8
  } elsif r < 0x10000 {
    out << (0xE0 | r >> 12).as_u8
    out << (0x80 | r >> 6 & 0x3F).as_u8
    out << (0x80 | r & 0x3F).as_u8
  } else {
    out << (0xF0 | r >> 18).as_u8
    out << (0x80 | r >> 12 & 0x3F).as_u8
    out << (0x80 | r >> 6 & 0x3F).as_u8
    out << (0x80 | r & 0x3F).as_u8
  }
  Str.from_bytes(out)
}

# Go's fmtQc: a single-quoted Go character literal (%+q: ASCII only).
pub def __fmt_qc(c: U64, flags: Int, wid: Int) -> Str {
  r = c > 0x10FFFF ? 0xFFFD : c.to_i
  __fmt_pad(__fmt_quote_rune(r, flags & 2 != 0), flags, wid)
}

# Go's fmtUnicode: U+0078, or with `#` U+0078 'x'.
pub def __fmt_unicode(u0: U64, flags: Int, wid: Int, prec0: Int) -> Str {
  prec = 4
  prec = prec0 if flags & 64 != 0 && prec0 > 4
  hex = "0123456789ABCDEF"
  out: [Byte] = []
  u = u0
  loop {
    out << hex[(u & 15).to_i]
    u = u >> 4
    break if u == 0
  }
  while out.size < prec {
    out << 48.as_u8
  }
  out << 43.as_u8
  out << 85.as_u8
  out.reverse!
  s = Str.from_bytes(out)
  if flags & 4 != 0 && u0 <= 0x10FFFF && __fmt_is_print(u0.to_i) {
    s = s + " '" + __fmt_rune_str(u0.to_i) + "'"
  }
  __fmt_pad_spaces(s, flags, wid)
}

# fmt's integer verbs (print.go's fmtInteger): v d b o O x X c q U.
pub def __fmt_int[T: like Int](v: T, signed: Bool, verb: Int, flags: Int, wid: Int, prec: Int) -> Str {
  u = v.as_u64
  case verb {
    118 => {
      # %#v of an unsigned integer is 0x hex (Go's fmt0x64).
      return __fmt_integer(u, 16, false, verb, false, flags | 4, wid, prec) if flags & 256 != 0 && !signed
      __fmt_integer(u, 10, signed, verb, false, flags, wid, prec)
    }
    100 => __fmt_integer(u, 10, signed, verb, false, flags, wid, prec)
    98 => __fmt_integer(u, 2, signed, verb, false, flags, wid, prec)
    111 | 79 => __fmt_integer(u, 8, signed, verb, false, flags, wid, prec)
    120 => __fmt_integer(u, 16, signed, verb, false, flags, wid, prec)
    88 => __fmt_integer(u, 16, signed, verb, true, flags, wid, prec)
    99 => __fmt_c(u, flags, wid)
    113 => __fmt_qc(u, flags, wid)
    _ => __fmt_unicode(u, flags, wid, prec)
  }
}

# fmt's Bool verbs: t v.
pub def __fmt_bool(b: Bool, flags: Int, wid: Int) -> Str {
  __fmt_pad(b ? "true" : "false", flags, wid)
}

# Go's truncateString: the first prec runes.
pub def __fmt_truncate(s: Str, flags: Int, prec: Int) -> Str {
  return s if flags & 64 == 0
  n = prec
  i = 0
  while i < s.size {
    n -= 1
    return s[0...i] if n < 0
    i += s[i] < 0x80 ? 1 : __fmt_rune_len_at(s, i)
  }
  s
}

# Go's fmtSbx: the bytes in hex (`% x` spaces them, `#` adds 0x).
pub def __fmt_sbx(s: Str, upper: Bool, flags: Int, wid: Int, prec: Int) -> Str {
  digits = upper ? "0123456789ABCDEFX" : "0123456789abcdefx"
  length = s.size
  length = prec if flags & 64 != 0 && prec < length
  width = 2 * length
  if width > 0 {
    if flags & 8 != 0 {
      width *= 2 if flags & 4 != 0
      width += length - 1
    } elsif flags & 4 != 0 {
      width += 2
    }
  } else {
    return flags & 32 != 0 ? __fmt_padding(wid, flags) : ""
  }
  out: [Byte] = []
  if flags & 32 != 0 && wid > width && flags & 1 == 0 {
    for b in __fmt_padding(wid - width, flags).bytes {
      out << b
    }
  }
  if flags & 4 != 0 {
    out << 48.as_u8
    out << digits[16]
  }
  i = 0
  while i < length {
    if flags & 8 != 0 && i > 0 {
      out << 32.as_u8
      if flags & 4 != 0 {
        out << 48.as_u8
        out << digits[16]
      }
    }
    c = s[i]
    out << digits[(c >> 4).to_i]
    out << digits[(c & 15).to_i]
    i += 1
  }
  if flags & 32 != 0 && wid > width && flags & 1 != 0 {
    for b in __fmt_padding(wid - width, flags).bytes {
      out << b
    }
  }
  Str.from_bytes(out)
}

# Go's fmtQ: a double-quoted Go string literal; `#` a raw (backquoted) one
# when strconv.CanBackquote, `+` ASCII only.
pub def __fmt_q(s0: Str, flags: Int, wid: Int, prec: Int) -> Str {
  s = __fmt_truncate(s0, flags, prec)
  if flags & 4 != 0 && __fmt_can_backquote(s) {
    return __fmt_pad("`" + s + "`", flags, wid)
  }
  __fmt_pad(__fmt_quote(s, flags & 2 != 0), flags, wid)
}

# fmt's Str verbs: v s x X q (print.go's fmtString).
pub def __fmt_str(s: Str, verb: Int, flags: Int, wid: Int, prec: Int) -> Str {
  case verb {
    118 => flags & 256 != 0 ? __fmt_q(s, flags &^ 4, wid, prec) : __fmt_pad(__fmt_truncate(s, flags, prec), flags, wid)
    115 => __fmt_pad(__fmt_truncate(s, flags, prec), flags, wid)
    120 => __fmt_sbx(s, false, flags, wid, prec)
    88 => __fmt_sbx(s, true, flags, wid, prec)
    _ => __fmt_q(s, flags, wid, prec)
  }
}

# ---------------------------------------------------------------- quoting

# Go's strconv.IsPrint (its own tables, ALXFMT_* below).
pub def __fmt_is_print(r: Int) -> Bool {
  if r <= 0xFF {
    return true if 0x20 <= r && r <= 0x7E
    return r != 0xAD if 0xA1 <= r && r <= 0xFF
    return false
  }
  if 0 <= r && r < 0x10000 {
    i = __fmt_search16(ALXFMT_PRINT16, r)
    return false if i >= ALXFMT_PRINT16.size || r < ALXFMT_PRINT16[i &^ 1].to_i || ALXFMT_PRINT16[i | 1].to_i < r
    j = __fmt_search16(ALXFMT_NOT_PRINT16, r)
    return j >= ALXFMT_NOT_PRINT16.size || ALXFMT_NOT_PRINT16[j].to_i != r
  }
  i = __fmt_search32(ALXFMT_PRINT32, r)
  return false if i >= ALXFMT_PRINT32.size || r < ALXFMT_PRINT32[i &^ 1].to_i || ALXFMT_PRINT32[i | 1].to_i < r
  return true if r >= 0x20000
  x = r - 0x10000
  j = __fmt_search16(ALXFMT_NOT_PRINT32, x)
  j >= ALXFMT_NOT_PRINT32.size || ALXFMT_NOT_PRINT32[j].to_i != x
}

# The first index of a sorted table holding a value >= x.
pub def __fmt_search16(t: [U16], x: Int) -> Int {
  i = 0
  j = t.size
  while i < j {
    h = (i + j) / 2
    if t[h].to_i < x {
      i = h + 1
    } else {
      j = h
    }
  }
  i
}

pub def __fmt_search32(t: [U32], x: Int) -> Int {
  i = 0
  j = t.size
  while i < j {
    h = (i + j) / 2
    if t[h].to_i < x {
      i = h + 1
    } else {
      j = h
    }
  }
  i
}

# Go's appendEscapedRune.
pub def __fmt_escape_rune(out: [Byte], r: Int, quote: Int, ascii: Bool) -> [Byte] {
  hex = "0123456789abcdef"
  o = out
  if r == quote || r == 92 {
    o << 92.as_u8
    o << r.as_u8
    return o
  }
  if ascii {
    if r < 0x80 && __fmt_is_print(r) {
      o << r.as_u8
      return o
    }
  } elsif __fmt_is_print(r) {
    for b in __fmt_rune_str(r).bytes {
      o << b
    }
    return o
  }
  esc = case r {
    7 => "\\a"
    8 => "\\b"
    12 => "\\f"
    10 => "\\n"
    13 => "\\r"
    9 => "\\t"
    11 => "\\v"
    _ => ""
  }
  if esc != "" {
    for b in esc.bytes {
      o << b
    }
    return o
  }
  rr = r
  if rr < 32 || rr == 0x7F {
    o << 92.as_u8
    o << 120.as_u8
    o << hex[(rr >> 4) & 15]
    o << hex[rr & 15]
    return o
  }
  rr = 0xFFFD if rr > 0x10FFFF || (rr >= 0xD800 && rr <= 0xDFFF)
  if rr < 0x10000 {
    o << 92.as_u8
    o << 117.as_u8
    s = 12
    while s >= 0 {
      o << hex[(rr >> s) & 15]
      s -= 4
    }
  } else {
    o << 92.as_u8
    o << 85.as_u8
    s = 28
    while s >= 0 {
      o << hex[(rr >> s) & 15]
      s -= 4
    }
  }
  o
}

# Go's strconv.Quote (ascii: QuoteToASCII).
pub def __fmt_quote(s: Str, ascii: Bool) -> Str {
  hex = "0123456789abcdef"
  out: [Byte] = [34]
  i = 0
  while i < s.size {
    c = s[i]
    if c < 0x80 {
      out = __fmt_escape_rune(out, c.to_i, 34, ascii)
      i += 1
    } else {
      r, w = __fmt_rune_at(s, i)
      if w == 1 {
        out << 92.as_u8
        out << 120.as_u8
        out << hex[(c >> 4).to_i]
        out << hex[(c & 15).to_i]
      } else {
        out = __fmt_escape_rune(out, r, 34, ascii)
      }
      i += w
    }
  }
  out << 34.as_u8
  Str.from_bytes(out)
}

# Go's strconv.QuoteRune (ascii: QuoteRuneToASCII).
pub def __fmt_quote_rune(r0: Int, ascii: Bool) -> Str {
  r = r0
  r = 0xFFFD if r < 0 || r > 0x10FFFF || (r >= 0xD800 && r <= 0xDFFF)
  out: [Byte] = [39]
  out = __fmt_escape_rune(out, r, 39, ascii)
  out << 39.as_u8
  Str.from_bytes(out)
}

# Go's strconv.CanBackquote: one line, no control characters but tab, no
# backquote, valid UTF-8, no byte order mark.
pub def __fmt_can_backquote(s: Str) -> Bool {
  i = 0
  while i < s.size {
    c = s[i]
    if c < 0x80 {
      return false if c == 96 || c == 0x7F || (c < 32 && c != 9)
      i += 1
    } else {
      r, w = __fmt_rune_at(s, i)
      return false if w == 1 || r == 0xFEFF
      i += w
    }
  }
  true
}

# ----------------------------------------------------------------- floats

# The decimal digits of |v| and the decimal point position (Go's
# decimalSlice d, dp: v = 0.d * 10^dp), rounded to n significant digits
# (n < 0: the shortest that reads back). No trailing zeros.
pub def __fmt_digits(v: Float, n: Int) -> (Str, Int) {
  a = v < 0.0 ? -v : v
  a = 0.0 if a == 0.0
  return ("", 0) if a == 0.0 && n >= 0
  e = n < 0 ? __fmt_shortest_e(a) : a.__ffmt_e(n == 0 ? 0 : n - 1)
  # e = d[.ddd]e[+-]XX
  k = e.byteindex("e")
  mant = e[0...k]
  ex = e[k + 1...e.size].to_i
  ds: [Byte] = []
  for b in mant.bytes {
    ds << b if b != 46
  }
  while ds.size > 0 && ds[ds.size - 1] == 48 {
    ds = ds[0...ds.size - 1]
  }
  return ("", 0) if ds.size == 0
  (Str.from_bytes(ds), ex + 1)
}

# |a| in shortest exponent form, d.ddde+XX, from Go's %v text.
pub def __fmt_shortest_e(a: Float) -> Str {
  s = a.to_s
  k = s.byteindex("e")
  if k >= 0 {
    return s
  }
  # Decimal form: digits and point.
  p = s.byteindex(".")
  ip = p < 0 ? s : s[0...p]
  fp = p < 0 ? "" : s[p + 1...s.size]
  all = ip + fp
  # Skip leading zeros.
  z = 0
  while z < all.size - 1 && all[z] == 48 {
    z += 1
  }
  ds = all[z...all.size]
  exp = ip.size - 1 - z
  m = ds.size > 1 ? ds[0...1] + "." + ds[1...ds.size] : ds
  m + "e" + exp.to_s
}

# Go's fmtE over digits d (decimal point after dp): prec digits after the
# point, exponent with at least two digits.
pub def __fmt_e(neg: Bool, d: Str, dp: Int, prec: Int, ch: Int) -> Str {
  out: [Byte] = []
  out << 45.as_u8 if neg
  out << (d.size == 0 ? 48.as_u8 : d[0])
  if prec > 0 {
    out << 46.as_u8
    i = 1
    m = d.size < prec + 1 ? d.size : prec + 1
    while i < m {
      out << d[i]
      i += 1
    }
    while i <= prec {
      out << 48.as_u8
      i += 1
    }
  }
  out << ch.as_u8
  exp = d.size == 0 ? 0 : dp - 1
  if exp < 0 {
    out << 45.as_u8
    exp = -exp
  } else {
    out << 43.as_u8
  }
  if exp < 10 {
    out << 48.as_u8
    out << (48 + exp).as_u8
  } elsif exp < 100 {
    out << (48 + exp / 10).as_u8
    out << (48 + exp % 10).as_u8
  } else {
    out << (48 + exp / 100).as_u8
    out << (48 + exp / 10 % 10).as_u8
    out << (48 + exp % 10).as_u8
  }
  Str.from_bytes(out)
}

# Go's fmtF over digits d: integer part, then prec digits after the point.
pub def __fmt_f(neg: Bool, d: Str, dp: Int, prec: Int) -> Str {
  out: [Byte] = []
  out << 45.as_u8 if neg
  if dp > 0 {
    m = d.size < dp ? d.size : dp
    i = 0
    while i < m {
      out << d[i]
      i += 1
    }
    while i < dp {
      out << 48.as_u8
      i += 1
    }
  } else {
    out << 48.as_u8
  }
  if prec > 0 {
    out << 46.as_u8
    i = 1
    while i <= prec {
      j = dp + i - 1
      out << (j < 0 || j >= d.size ? 48.as_u8 : d[j])
      i += 1
    }
  }
  Str.from_bytes(out)
}

# Go's fmtB: mantissa p exponent (both decimal).
pub def __fmt_fb(v: Float) -> Str {
  bits = v.__bits
  neg = bits >> 63 != 0
  exp = (bits >> 52 & 0x7FF).to_i
  mant = bits & ((1.as_u64 << 52) - 1)
  if exp == 0 {
    exp += 1
  } else {
    mant = mant | (1.as_u64 << 52)
  }
  exp += -1023 - 52
  out = neg ? "-" : ""
  out += mant.to_s + "p"
  out += "+" if exp >= 0
  out + exp.to_s
}

# Go's fmtX: hexadecimal mantissa and binary exponent, prec hex digits
# (prec < 0: as many as needed).
pub def __fmt_fx(v: Float, prec: Int, upper: Bool) -> Str {
  bits = v.__bits
  neg = bits >> 63 != 0
  exp = (bits >> 52 & 0x7FF).to_i
  mant = bits & ((1.as_u64 << 52) - 1)
  if exp == 0 {
    exp += 1
  } else {
    mant = mant | (1.as_u64 << 52)
  }
  exp += -1023
  exp = 0 if mant == 0
  one60 = 1.as_u64 << 60
  mant = mant << 8
  while mant != 0 && mant & one60 == 0 {
    mant = mant << 1
    exp -= 1
  }
  if prec >= 0 && prec < 15 {
    shift = (prec * 4).to_u64
    extra = (mant << shift) & (one60 - 1)
    mant = mant >> (60.as_u64 - shift)
    mant += 1 if extra | (mant & 1) > (1.as_u64 << 59)
    mant = mant << (60.as_u64 - shift)
    if mant & (1.as_u64 << 61) != 0 {
      mant = mant >> 1
      exp += 1
    }
  }
  hex = upper ? "0123456789ABCDEF" : "0123456789abcdef"
  out: [Byte] = []
  out << 45.as_u8 if neg
  out << 48.as_u8
  out << (upper ? 88 : 120).as_u8
  out << (48 + (mant >> 60 & 1).to_i).as_u8
  mant = mant << 4
  if prec < 0 && mant != 0 {
    out << 46.as_u8
    while mant != 0 {
      out << hex[(mant >> 60 & 15).to_i]
      mant = mant << 4
    }
  } elsif prec > 0 {
    out << 46.as_u8
    i = 0
    while i < prec {
      out << hex[(mant >> 60 & 15).to_i]
      mant = mant << 4
      i += 1
    }
  }
  out << (upper ? 80 : 112).as_u8
  if exp < 0 {
    out << 45.as_u8
    exp = -exp
  } else {
    out << 43.as_u8
  }
  if exp < 100 {
    out << (48 + exp / 10).as_u8
    out << (48 + exp % 10).as_u8
  } elsif exp < 1000 {
    out << (48 + exp / 100).as_u8
    out << (48 + exp / 10 % 10).as_u8
    out << (48 + exp % 10).as_u8
  } else {
    out << (48 + exp / 1000).as_u8
    out << (48 + exp / 100 % 10).as_u8
    out << (48 + exp / 10 % 10).as_u8
    out << (48 + exp % 10).as_u8
  }
  Str.from_bytes(out)
}

# Go's strconv.FormatFloat(v, verb, prec, 64): verb b e E f g G x X.
pub def __fmt_ftoa(v: Float, verb: Int, prec0: Int) -> Str {
  return "NaN" if v != v
  return "+Inf" if v > 1.7976931348623157e308
  return "-Inf" if v < -1.7976931348623157e308
  return __fmt_fb(v) if verb == 98
  return __fmt_fx(v, prec0, verb == 88) if verb == 120 || verb == 88
  neg = v.__bits >> 63 != 0
  prec = prec0
  shortest = prec < 0
  if verb == 102 && !shortest {
    s = v.__ffmt_f(prec)
    return neg && !s.start_with?("-") ? "-" + s : s
  }
  if (verb == 101 || verb == 69) && !shortest {
    s = v.__ffmt_e(prec)
    s = __fmt_upper_e(s) if verb == 69
    return neg && !s.start_with?("-") ? "-" + s : s
  }
  # %g, %G, and the shortest forms.
  n = shortest ? -1 : prec
  n = 1 if (verb == 103 || verb == 71) && n == 0
  d, dp = __fmt_digits(v, n)
  dp = 1 if d == ""
  if shortest {
    prec = case verb {
      101 | 69 => d.size - 1
      102 => d.size > dp ? d.size - dp : 0
      _ => d.size
    }
    prec = 1 if d == "" && verb != 101 && verb != 69 && verb != 102
    prec = 0 if d == "" && (verb == 101 || verb == 69 || verb == 102)
  }
  return __fmt_e(neg, d, dp, prec, verb) if verb == 101 || verb == 69
  return __fmt_f(neg, d, dp, prec) if verb == 102
  # %g / %G.
  nd = d == "" ? 1 : d.size
  eprec = prec
  eprec = nd if eprec > nd && nd >= dp
  eprec = 6 if shortest
  exp = dp - 1
  if exp < -4 || exp >= eprec {
    p = prec
    p = nd if p > nd
    return __fmt_e(neg, d, dp, p - 1, verb == 71 ? 69 : 101)
  }
  p = prec
  p = nd if p > dp
  q = p - dp
  __fmt_f(neg, d, dp, q > 0 ? q : 0)
}

# fmt's Float verbs (print.go's fmtFloat and format.go's fmtFloat):
# v b g G x X f F e E, with Go's default precisions.
pub def __fmt_float(v: Float, verb0: Int, flags0: Int, wid: Int, prec0: Int) -> Str {
  flags = flags0
  verb = verb0
  prec = -1
  case verb0 {
    118 => verb = 103
    102 | 101 | 69 => prec = 6
    70 => {
      verb = 102
      prec = 6
    }
    _ => {}
  }
  prec = prec0 if flags & 64 != 0
  num = __fmt_ftoa(v, verb, prec)
  # A sign in front: num is then "+..." or "-...".
  num = "+" + num if !num.start_with?("-") && !num.start_with?("+")
  num = " " + num[1...num.size] if flags & 8 != 0 && num[0] == 43 && flags & 2 == 0
  # Infinities and NaN aren't padded with zeros.
  if num[1] == 73 || num[1] == 78 {
    num = num[1...num.size] if num[1] == 78 && flags & 8 == 0 && flags & 2 == 0
    return __fmt_pad(num, flags &^ 16, wid)
  }
  # `#` keeps a decimal point and trailing zeros.
  if flags & 4 != 0 && verb != 98 {
    digits = 0
    if verb == 118 || verb == 103 || verb == 71 || verb == 120 {
      digits = prec
      digits = 6 if digits == -1
    }
    tail = ""
    body: [Byte] = []
    saw_point = false
    saw_nonzero = false
    i = 1
    stop = false
    while i < num.size && !stop {
      c = num[i]
      if c == 46 {
        saw_point = true
        body << c
      } elsif c == 112 || c == 80 {
        tail = num[i...num.size]
        stop = true
      } elsif (c == 101 || c == 69) && verb != 120 && verb != 88 {
        tail = num[i...num.size]
        stop = true
      } else {
        saw_nonzero = true if c != 48
        digits -= 1 if saw_nonzero
        body << c
      }
      i += 1
    }
    if !saw_point {
      digits -= 1 if body.size == 1 && body[0] == 48
      body << 46.as_u8
    }
    while digits > 0 {
      body << 48.as_u8
      digits -= 1
    }
    num = num[0...1] + Str.from_bytes(body) + tail
  }
  if flags & 2 != 0 || num[0] != 43 {
    if flags & 16 != 0 && flags & 1 == 0 && flags & 32 != 0 && wid > num.size {
      return num[0...1] + "0" * (wid - num.size) + num[1...num.size]
    }
    return __fmt_pad(num, flags, wid)
  }
  __fmt_pad(num[1...num.size], flags, wid)
}

# fmt's Complex verbs: (real, imaginary with a sign, i).
pub def __fmt_complex(c: Complex, verb: Int, flags: Int, wid: Int, prec: Int) -> Str {
  "(" + __fmt_float(c.real, verb, flags, wid, prec) + __fmt_float(c.imag, verb, flags | 2, wid, prec) + "i)"
}

# Go's `*` width and precision: a negative width means `-` (and no zero
# padding); a negative precision means none.
pub def __fmt_star(flags: Int, w: Int, wstar: Bool, p: Int, pstar: Bool) -> Int {
  f = flags
  f = (f | 1) &^ 16 if wstar && w < 0
  f = f &^ 64 if pstar && p < 0
  f
}

pub def __fmt_upper_e(s: Str) -> Str {
  out: [Byte] = []
  for b in s.bytes {
    out << (b == 101 ? 69.as_u8 : b)
  }
  Str.from_bytes(out)
}

# A map's entries, each shown by f: `map[k:v k:v]`, or `{k => v, ...}`
# for %#v. In insertion order (D8; Go sorts the keys).
pub def __fmt_map[K, V](m: Map[K, V], sharp: Bool, f: (K, V) -> Str) -> Str {
  out = sharp ? "{" : "map["
  i = 0
  for k in m.keys {
    if v = m[k] {
      out += (sharp ? ", " : " ") if i > 0
      out += f(k, v)
      i += 1
    }
  }
  out + (sharp ? "}" : "]")
}

