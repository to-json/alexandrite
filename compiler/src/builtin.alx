# Declarations every program sees: the compiler parses this file with the
# program (front::add_builtins), so each backend compiles them like user
# code and they behave identically everywhere.

# Complex: Go's complex128 (GO-VS-RUBY D53). `Complex.new(r, i)` is Go's
# complex(r, i), `c.real` / `c.imag` are real(c) / imag(c); `2i` is an
# imaginary literal; numeric constants adapt to Complex (`c * 2`, `1 + 2i`).
# The arithmetic is Go's: `*` is the plain formula (no C99 Annex G
# recovery), `/` is the Go runtime's complex128div (Smith's algorithm with
# C99's infinity fixups), `==` compares both parts (NaN != NaN, -0 == 0).
# Printing is fmt's `%v`: `(1+2i)`, `(NaN+Infi)`.
struct Complex {
  real: Float
  imag: Float

  pub def +(o: Complex) -> Complex { Complex.new(real + o.real, imag + o.imag) }

  pub def -(o: Complex) -> Complex { Complex.new(real - o.real, imag - o.imag) }

  pub def *(o: Complex) -> Complex {
    Complex.new(real * o.real - imag * o.imag, real * o.imag + imag * o.real)
  }

  # Go's runtime.complex128div.
  pub def /(m: Complex) -> Complex {
    a = real
    b = imag
    c = m.real
    d = m.imag
    e = 0.0
    f = 0.0
    if c.abs >= d.abs {
      ratio = d / c
      denom = c + ratio * d
      e = (a + b * ratio) / denom
      f = (b - a * ratio) / denom
    } else {
      ratio = c / d
      denom = d + ratio * c
      e = (a * ratio + b) / denom
      f = (b * ratio - a) / denom
    }
    if e != e && f != f {
      inf = 0x7FF0000000000000.as_u64.__from_bits
      if c == 0.0 && d == 0.0 && (a == a || b == b) {
        e = inf.__copysign(c) * a
        f = inf.__copysign(c) * b
      } else if (Complex.__inf?(a) || Complex.__inf?(b)) && Complex.__finite?(c) && Complex.__finite?(d) {
        a = Complex.__inf2one(a)
        b = Complex.__inf2one(b)
        e = inf * (a * c + b * d)
        f = inf * (b * c - a * d)
      } else if (Complex.__inf?(c) || Complex.__inf?(d)) && Complex.__finite?(a) && Complex.__finite?(b) {
        c = Complex.__inf2one(c)
        d = Complex.__inf2one(d)
        e = 0.0 * (a * c + b * d)
        f = 0.0 * (b * c - a * d)
      }
    }
    Complex.new(e, f)
  }

  # -c (Go negates both parts).
  pub def __neg -> Complex { Complex.new(-real, -imag) }

  # fmt's %v: the real part, then the imaginary part with its sign, then `i`.
  pub def to_s -> Str {
    im = imag.to_s
    im = "+" + im if im[0] != 45 && im[0] != 43
    "(" + real.to_s + im + "i)"
  }

  # The imaginary literal `2i`.
  pub def self.__imag(v: Float) -> Complex { Complex.new(0.0, v) }

  pub def self.__inf?(x: Float) -> Bool { x - x != x - x && x == x }

  pub def self.__finite?(x: Float) -> Bool { x - x == x - x }

  # A signed 1 if x is an infinity, else a signed 0 (the sign of x).
  pub def self.__inf2one(x: Float) -> Float {
    g = 0.0
    g = 1.0 if Complex.__inf?(x)
    g.__copysign(x)
  }
}
