import "bufio"
import "io"
import "os"
import "strconv"
import "strings"

N = 10000
SIZE = 100000

def feed -> ~Unit {
  w = bufio.new_writer(os.stdout)
  body = strings.repeat("x", SIZE)
  for i in 0...N {
    b = "#{i}" + body
    ~w.write_string!("Content-Length: #{b.size}\r\n\r\n")
    ~w.write_string!(b)
  }
  ~w.flush!
}

def read_msg(r: bufio.Reader) -> ~Str? {
  n = -1
  loop {
    line = ~r.read_line! || return none
    line = strings.trim_space(line)
    break if line == ""
    if line.start_with?("Content-Length: ") {
      n = ~strconv.atoi(line[16...line.size])
    }
  }
  buf: [Byte] = [0; n]
  ~io.read_full(r, buf)
  Str.from_bytes(buf)
}

def serve_chan -> ~Unit {
  r = bufio.new_reader(os.stdin)
  ch = Chan[Str].new(4)
  t = spawn {
    loop {
      m = ~read_msg(r) || break
      ch << m
    }
    ch.close
  }
  docs: Map[Str, Str] = {}
  count = 0
  loop {
    m = ch.recv || break
    docs["f"] = m
    count += 1
  }
  t.~wait
  puts "chan: #{count}"
}

def serve_loop -> ~Unit {
  r = bufio.new_reader(os.stdin)
  docs: Map[Str, Str] = {}
  count = 0
  loop {
    m = ~read_msg(r) || break
    docs["f"] = m
    count += 1
  }
  puts "loop: #{count}"
}

case os.args[1] {
  "feed" => ~feed
  "chan" => ~serve_chan
  "loop" => ~serve_loop
  _ => puts "usage"
}
