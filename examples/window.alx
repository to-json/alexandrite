import "raylib"

raylib.init_window(640, 480, "Alexandrite Raylib Window Proof")
raylib.set_target_fps(60)

frames = 0
while frames < 10 && !raylib.window_should_close? {
  raylib.begin_drawing
  raylib.clear_background(raylib.raywhite)

  raylib.draw_rectangle(120, 100, 400, 200, raylib.lightgray)
  raylib.draw_rectangle_lines(120, 100, 400, 200, raylib.darkgray)
  raylib.draw_circle(320, 200, 45.0, raylib.maroon)

  raylib.draw_text("Raylib in Alexandrite!", 160, 280, 24, raylib.darkblue)
  raylib.draw_fps(10, 10)

  raylib.end_drawing
  frames += 1
}

raylib.close_window
puts "Raylib window proof completed: #{frames} frames rendered!"
