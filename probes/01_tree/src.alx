# Probe 01: a value escapes the scope that built it.

enum Tree
  Leaf(Int)
  Node(Tree, Tree)
end

DEPTH = 10

def build(depth: Int) -> Tree
  return Leaf(1) if depth == 0
  Node(build(depth - 1), build(depth - 1))
end

# `t` is borrowed read-only (Hylo `let`). The result escapes to the caller.
def doubled(t: Tree) -> Tree
  case t
  in Leaf(n)    then Leaf(n * 2)
  in Node(l, r) then Node(doubled(l), doubled(r))
  end
end

def sum(t: Tree) -> Int
  case t
  in Leaf(n)    then n
  in Node(l, r) then sum(l) + sum(r)
  end
end

def main
  t = build(DEPTH)
  d = doubled(t)
  puts sum(d)
end
