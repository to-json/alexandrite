# Probe 02: allocation inside a loop. Scratch must die per iteration;
# survivors must outlive the loop.

def main(n: Int)
  keep = []
  lines(n).each { |line|
    s = line.strip.upcase          # scratch
    t = s.tr("A", "4")             # scratch
    keep << t if t.include?("7")   # escapes the block -> copy into keep's pool
  }
  puts keep.size
  puts keep.last
end

def lines(n: Int) = (0...n).map { |i| "   line #{i} alpha #{i * 7 % 100}   " }
