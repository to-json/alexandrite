# Probe 03: cycles. Value semantics can't express "this road leads back to
# that city" -- a copy of a city is a different city. Identity has to be
# spelled somehow. Sketch: `@City` = a handle into the City pool of the
# enclosing region. Plain `City` would still mean a value.

struct City
  name: Str
  roads: [@City]
end

def main
  cities = pool(City, 6)            # comptime-known size -> 2x headroom
  a = cities << City("Ashby")
  b = cities << City("Bree")
  c = cities << City("Crick")
  d = cities << City("Dunmore")
  e = cities << City("Eastfold")
  f = cities << City("Fallow")      # unreachable from a

  road(a, b); road(b, c); road(c, a)    # cycle a-b-c
  road(c, d); road(d, e); road(e, c)    # cycle c-d-e
  road(f, a)

  puts reachable(a).map(&:name).join(" ")
  puts hops(a, e)

  cities.remove(d)                  # what happens to roads into d?
  puts reachable(a).map(&:name).join(" ")
  puts hops(a, e) || "unreachable"
end

def road(from: @City, to: @City) = from.roads << to

def reachable(start: @City) -> [@City]
  seen = {start}
  queue = [start]
  while (c = queue.shift)
    c.roads.each { |n| queue << n if seen.add?(n) }
  end
  seen.to_a
end

def hops(from: @City, to: @City) -> Int?
  # BFS distance
end
