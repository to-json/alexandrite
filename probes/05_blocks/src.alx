# Probe 05: blocks with non-local control flow. `return`, `?`, `break` and
# `next` inside a block mean what they mean in the enclosing method.

struct Order
  id: Int
  customer: Str
  total: Int
end

# `?` inside the block leaves parse_all with the error.
def parse_all(lines: [Str]) -> Result[[Order], ParseError]
  Ok(lines.map { parse(it)? })
end

# `return` inside a nested block leaves the method.
def first_big_spender(orders: [Order], limit: Int) -> Str?
  orders.group_by(&:customer).each { |customer, os|
    return customer if os.sum(&:total) > limit
  }
  nil
end

# A fused chain: no intermediate arrays, stops after 3.
def top_totals(orders: [Order]) -> [Int]
  orders.select { it.total > 100 }.map(&:total).take(3)
end

# `next` and `break` with a value.
def first_gap(orders: [Order]) -> Int?
  orders.each_cons(2) { |a, b|
    next if b.id == a.id + 1
    break a.id + 1
  }
end
