# Probe 06 bodies. Nothing here mentions destinations; the compiler does.

def sum(xs) = xs.sum
def doubled(xs) = xs.map { it.to_i64 * 2 }
def parse_digits(s) = s.chars.map { try it.digit }     # `try` propagates failure
def mirror(t) = case t
  in Leaf(n)    then Leaf(n)
  in Node(l, r) then Node(mirror(r), mirror(l))
end
def average(xs) = (xs.sum(as: I128) / xs.size).to_i32
def median(xs) = xs.sorted[xs.size / 2]               # `sorted` is scratch
