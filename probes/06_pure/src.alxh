# Probe 06 header. `#[pure]` = destination-passing, no allocator, no I/O,
# no globals, args read-only, no panics: proven or fallible (`!`).

#[pure] def sum(xs: [I64]) -> I64!                 # overflow: not provable
#[pure] def doubled(xs: [I32]) -> [I64]
  size out == size xs
#[pure] def parse_digits(s: Str) -> [U8]!          # bad char: fallible by domain
  size out <= size s
#[pure] def mirror(t: Tree) -> Tree
  size out == size t
#[pure] def average(xs: NonEmpty[I32]) -> I32      # needs relational proof
#[pure] def median(xs: NonEmpty[I32]) -> I32       # needs scratch
