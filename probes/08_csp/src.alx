# Probe 08: CSP. Nothing is marked async; the compiler infers it.

struct Order
  id: Int
  customer: Str
  total: Int
end

#[pure] def parse(line: Str) -> Order!          # pure => never async

def fetch(i: Int) -> Str                        # does I/O => async
  sleep(1.ms)
  "#{i}, #{CUSTOMERS[i % 3]}, #{i * 10}"
end

def producer(n: Int, out: Chan[Str])            # sends => async
  (0...n).each { |i| out << fetch(i) }
end

def parser(inp: Chan[Str], out: Chan[Order])
  inp.each { |line| out << try parse(line) }    # recv + send => async
end

# Builds a pool and sends the WHOLE pool: a channel send is a boundary.
def tally(inp: Chan[Order]) -> Rooted[Totals]
  totals = pool(Total, 3)
  inp.each { |o| totals.add(o.customer, o.total) }
  totals
end

def main
  lines = chan(Str, 16)
  orders = chan(Order, 16)
  spawn { producer(30, lines) }
  spawn { parser(lines, orders) }
  t = spawn { tally(orders) }.join
  puts t.report

  # CPU-parallel pure work: threads, not tasks.
  puts (1..8).to_a.pmap { |x| collatz_steps(x * 1000) }

  # Concurrent, not parallel: both blocks borrow `t` without spawning.
  concurrently { a = t.max } { b = t.min }

  # Recursive iterator: can't inline -> gen block fallback.
  puts tree.leaves.find { it > 5 }
end
