# Probe 09: Enumerable compilation decisions.

# 1. Fusion is legal only for pure blocks.
xs = (1..6).to_a
xs.map { puts "map #{it}"; it * 2 }.take(3)   # impure: materialize (6 lines printed)
xs.map { it * 2 }.take(3)                      # pure: fuse (3 calls)
xs.lazy.map { puts "map #{it}"; it * 2 }.take(3)  # forced: fuse anyway (3 lines)
xs.map { puts "a" }.lazy.map { puts "b" }.take(3) # stage a eager, b onward lazy
e = xs.lazy.map { it * 2 }     # unforced, stored: block escapes -> lambda rules

# 2. Size rules pre-size destinations.
big = (0...100_000).to_a
big.select { it % 3 == 0 }.map { it * 3 }      # size <= size big
big.select { it % 3 == 0 }.take(10)            # size <= min(10, size big)
big.flat_map { [it, it] }                      # unknown -> 2x headroom
big.flat_map { [it, it, it] }                  # unknown -> 2x headroom, spills

# 3. Ownership mode from what the block does.
orders.sum(&:total)                 # reads    -> iter
orders.each { it.total += 1 }       # mutates  -> iter_mut
orders.each { archive << it }       # consumes -> into_iter
puts orders.size                    # error: orders was consumed above
