# Probe 11: error sets. Braces everywhere, no `end`.

error ParseError { BadDigit(U8), Empty }
error IoError { NotFound(Str), Denied }
error ConfigError { Missing(Str), Invalid }

#[pure] def digit(b: U8) -> U8! {              # inferred: {BadDigit}
  fail BadDigit(b) unless b.digit?
  b - '0'
}

#[pure] def parse(s: Str) -> Int! {            # inferred: {Empty, BadDigit, Overflow}
  fail Empty if s.empty?
  s.bytes.reduce(0) { |acc, b| try (acc * 10 + try digit(b)) }   # unproven arithmetic -> Overflow
}

def read(path: Str) -> Str!IoError { … }       # explicit

def load(path: Str) -> Int! {                  # inferred: IoError ∪ parse's set
  try parse(try read(path))
}

def eval(e: Expr) -> Int! {                    # recursive: solved by fixpoint
  case e {
    in Num(s)    => try parse(s)
    in Add(a, b) => try eval(a) + try eval(b)
    in Load(p)   => try load(p)
  }
}

# Exported (in the header): set must be explicit, and must cover the body.
pub def config(p: Str) -> Int!ConfigError {
  n = load(p) rescue { |e|                     # handle: map inner errors
    case e {
      in NotFound(f) => fail Missing(f)
      in _           => fail Invalid
    }
  }
  n
}

# Rejected: exported with an inferred set.
pub def leaky(p: Str) -> Int! { try load(p) }

# Rejected: explicit set doesn't cover the body.
def narrow(s: Str) -> Int!ParseError { try parse(s) }   # missing Overflow
