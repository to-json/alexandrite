# Probe 12: lazy, type-aware macros. Braces everywhere.

struct User derive(Eq, Show, Json) {
  id: Int
  name: Str
  #[json(rename: "email_address")]
  email: Str
}

struct Order derive(Eq, Json) {     # Json(Order) needs User#to_json:
  id: Int                           #   forces User's expansion mid-way
  user: User
  total: Int
}

struct Audit derive(Show) {         # never used: must never expand
  note: Str
}

# Fields come from a declared input (build manifest: inputs: ["schema/*.json"]).
model Account from "schema/account.json" with finders

struct A derive(Mirror(B)) { }      # Mirror(A) needs B's members and
struct B derive(Mirror(A)) { }      #   Mirror(B) needs A's: dependency loop

model Leaky from "secrets.json"     # not a declared input: rejected

def main {
  puts User.new(1, "ann", "a@x") == User.new(1, "ann", "a@x")
  puts order.to_json
  Account.find_by_email("a@x")      # generated by compile-time method_missing
  Account.find_by_phone("555")      # no `phone` field yet: compile error
  A.new.mirror_x
  Leaky.new
}
