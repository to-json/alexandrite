# Probe 13: generics and traits. Inferred bounds inside, explicit at headers.

trait Sum { def sum -> Int }
trait Shape { def area -> Float; def name -> Str }
trait Show { def to_s -> Str }
trait Sized2 { def size -> Int }
trait Collection { def size -> Int }

struct Circle { r: Float }
impl Shape for Circle { def area { PI * r * r }; def name { "circle" } }
impl Show for Circle { def to_s { "Circle(#{r})" } }
impl Circle { def radius { r } }                  # inherent: no trait

struct Square { s: Float }
impl Show for Square { def to_s { "Square(#{s})" } }   # NOT a Shape

pub def total(xs) { xs.sum }                    # -> pub def total[T: Sum]
pub def describe(s) { "#{s.name}: #{s.area}" }  # -> [T: Shape]
pub def show_all(x) { "#{x.to_s} #{x.area}" }   # -> [T: Show + Shape]
def radius_of(x) { x.radius }                   # inherent: fine internally
pub def radius_pub(x) { x.radius }              # inherent: can't be exported
pub def amb(x) { x.size }                       # two traits: can't be exported

def main {
  describe(Circle(1.0))                         # ok
  describe(Square(2.0))                         # error: Square isn't a Shape
  radius_of(Circle(1.0))                        # ok
  shapes = [Circle(1.0), Rect(2.0, 3.0)]        # inferred dyn: common trait from use
  shapes.sum { it.area }                        #   -> Shape; closed set -> tagged union
}
