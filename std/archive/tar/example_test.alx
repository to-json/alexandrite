# Go's example_test.go.

import "bytes"
import "io"
import "os"

example "minimal" {
  # Create and add some files to the archive.
  buf = bytes.new_buffer([])
  tw = new_writer(buf)
  files = [
    ("readme.txt", "This archive contains some text files."),
    ("gopher.txt", "Gopher names:\nGeorge\nGeoffrey\nGonzo"),
    ("todo.txt", "Get animal handling license."),
  ]
  for file in files {
    hdr = Header.new(name: file[0], mode: 0o600, size: file[1].size)
    tw.write_header!(hdr).unwrap
    tw.write!(file[1].bytes.to_a).unwrap
  }
  tw.close!.unwrap

  # Open and iterate through the files in the archive.
  tr = new_reader(buf)
  loop {
    h = tr.next!.unwrap
    break if h.none?
    puts "Contents of #{h.unwrap.name}:"
    io.copy(os.stdout, tr).unwrap
    puts ""
  }
} outputs "Contents of readme.txt:\nThis archive contains some text files.\nContents of gopher.txt:\nGopher names:\nGeorge\nGeoffrey\nGonzo\nContents of todo.txt:\nGet animal handling license.\n"
