import "bytes"
import "io"

test "smoke" {
  b = bytes.new_buffer([])
  tw = new_writer(b)
  tw.~write_header!(Header.new(name: "a.txt", size: 5, mode: 0o644, typeflag: TYPE_REG))
  tw.~write!("hello".bytes.to_a)
  tw.~close!
  tr = new_reader(b)
  h = tr.~next!.unwrap
  assert_eq h.name, "a.txt"
  assert_eq Str.from_bytes(io.~read_all(tr)), "hello"
  assert tr.~next!.none?, "end"
}
