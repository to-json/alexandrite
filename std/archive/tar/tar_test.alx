# Go's archive/tar tar_test.go.

import "bytes"
import "io"
import "io/fs"
import "os"
import "path"
import "strings"
import "time"




test "sparse entries" {
  vectors = [
    (no_sp, 0, true, no_sp, [sp(0, 0)]),
    (no_sp, 5000, true, no_sp, [sp(0, 5000)]),
    ([sp(0, 5000)], 5000, true, [sp(0, 5000)], [sp(5000, 0)]),
    ([sp(1000, 4000)], 5000, true, [sp(1024, 3976)], [sp(0, 1000), sp(5000, 0)]),
    ([sp(0, 3000)], 5000, true, [sp(0, 2560)], [sp(3000, 2000)]),
    ([sp(3000, 2000)], 5000, true, [sp(3072, 1928)], [sp(0, 3000), sp(5000, 0)]),
    ([sp(2000, 2000)], 5000, true, [sp(2048, 1536)], [sp(0, 2000), sp(4000, 1000)]),
    ([sp(0, 2000), sp(8000, 2000)], 10000, true, [sp(0, 1536), sp(8192, 1808)], [sp(2000, 6000), sp(10000, 0)]),
    ([sp(0, 2000), sp(2000, 2000), sp(4000, 0), sp(4000, 3000), sp(7000, 1000), sp(8000, 0), sp(8000, 2000)], 10000, true, [sp(0, 1536), sp(2048, 1536), sp(4096, 2560), sp(7168, 512), sp(8192, 1808)], [sp(10000, 0)]),
    ([sp(0, 0), sp(1000, 0), sp(2000, 0), sp(3000, 0), sp(4000, 0), sp(5000, 0)], 5000, true, no_sp, [sp(0, 5000)]),
    ([sp(1, 0)], 0, false, no_sp, no_sp),
    ([sp(-1, 0)], 100, false, no_sp, no_sp),
    ([sp(0, -1)], 100, false, no_sp, no_sp),
    ([sp(0, 0)], -100, false, no_sp, no_sp),
    ([sp(MAX_I64, 3), sp(6, -5)], 35, false, no_sp, no_sp),
    ([sp(1, 3), sp(6, -5)], 35, false, no_sp, no_sp),
    ([sp(MAX_I64, MAX_I64)], MAX_I64, false, no_sp, no_sp),
    ([sp(3, 3)], 5, false, no_sp, no_sp),
    ([sp(2, 0), sp(1, 0), sp(0, 0)], 3, false, no_sp, no_sp),
    ([sp(1, 3), sp(2, 2)], 10, false, no_sp, no_sp),
  ]
  i = 0
  for v in vectors {
    assert_eq validate_sparse_entries(v[0], v[1]), v[2]
    if v[2] {
      assert_eq sp_str(align_sparse_entries(v[0].dup, v[1])), sp_str(v[3])
      assert_eq sp_str(invert_sparse_entries(v[0].dup, v[1])), sp_str(v[4])
    }
    i += 1
  }
}

test "file info header" {
  fi = fs.dir_fs("testdata").~stat("small.txt")
  h = ~file_info_header(fi, "")
  assert_eq h.name, "small.txt"
  assert_eq h.mode, fi.mode.perm.bits.to_i
  assert_eq h.size, 5
  assert h.mod_time == fi.mod_time, "mod_time"
}

test "file info header dir" {
  fi = fs.dir_fs(".").~stat("testdata")
  h = ~file_info_header(fi, "")
  assert_eq h.name, "testdata/"
  # Ignoring C_ISGID for golang.org/issue/4867.
  assert_eq h.mode & (-1 ^ C_ISGID), fi.mode.perm.bits.to_i
  assert_eq h.size, 0
  assert h.mod_time == fi.mod_time, "mod_time"
}

test "file info header symlink" {
  tmpdir = os.~mkdir_temp("", "tar-symlink")
  defer os.remove_all(tmpdir)
  link = path.join([tmpdir, "link"])
  os.~symlink(tmpdir, link)
  fi = fs.dir_fs(tmpdir).~lstat("link")
  h = ~file_info_header(fi, tmpdir)
  assert_eq h.name, fi.name
  assert_eq h.linkname, tmpdir
  assert_eq h.typeflag, TYPE_SYMLINK
}

test "round trip" {
  data = "some file contents".bytes.to_a
  b = bytes.new_buffer([])
  tw = new_writer(b)
  hdr = Header.new(name: "file.txt", uid: 1 << 21, size: data.size, mod_time: time.now.round(time.second), pax_records: {"uid" => "2097152"}, format: FORMAT_PAX, typeflag: TYPE_REG)
  tw.~write_header!(hdr)
  tw.~write!(data)
  tw.~close!
  tr = new_reader(b)
  r_hdr = tr.~next!.unwrap
  assert_eq header_diff(r_hdr, hdr), ""
  assert_eq io.~read_all(tr), data
}

test "header round trip" {
  vectors: [(Header, U32)] = [
    (Header.new(name: "test.txt", mode: 0o644, size: 12, mod_time: time.unix(1360600916, 0), typeflag: TYPE_REG), 0o644),
    (Header.new(name: "link.txt", mode: 0o777, size: 0, mod_time: time.unix(1360600852, 0), typeflag: TYPE_SYMLINK), 0o777 | fs.MODE_SYMLINK),
    (Header.new(name: "dev/null", mode: 0o666, size: 0, mod_time: time.unix(1360578951, 0), typeflag: TYPE_CHAR), 0o666 | fs.MODE_DEVICE | fs.MODE_CHAR_DEVICE),
    (Header.new(name: "dev/sda", mode: 0o660, size: 0, mod_time: time.unix(1360578954, 0), typeflag: TYPE_BLOCK), 0o660 | fs.MODE_DEVICE),
    (Header.new(name: "dir/", mode: 0o755, size: 0, mod_time: time.unix(1360601116, 0), typeflag: TYPE_DIR), 0o755 | fs.MODE_DIR),
    (Header.new(name: "dev/initctl", mode: 0o600, size: 0, mod_time: time.unix(1360578949, 0), typeflag: TYPE_FIFO), 0o600 | fs.MODE_NAMED_PIPE),
    (Header.new(name: "bin/su", mode: 0o755 | C_ISUID, size: 23232, mod_time: time.unix(1355405093, 0), typeflag: TYPE_REG), 0o755 | fs.MODE_SETUID),
    (Header.new(name: "group.txt", mode: 0o750 | C_ISGID, size: 0, mod_time: time.unix(1360602346, 0), typeflag: TYPE_REG), 0o750 | fs.MODE_SETGID),
    (Header.new(name: "sticky.txt", mode: 0o600 | C_ISVTX, size: 7, mod_time: time.unix(1360602540, 0), typeflag: TYPE_REG), 0o600 | fs.MODE_STICKY),
    (Header.new(name: "hard.txt", mode: 0o644, size: 0, linkname: "file.txt", mod_time: time.unix(1360600916, 0), typeflag: TYPE_LINK), 0o644),
    (Header.new(name: "info.txt", mode: 0o600, size: 0, uid: 1000, gid: 1000, mod_time: time.unix(1360602540, 0), uname: "slartibartfast", gname: "users", typeflag: TYPE_REG), 0o600),
  ]
  i = 0
  for v in vectors {
    h = v[0]
    fi = h.file_info
    h2 = ~file_info_header_sys(fi, "", h)
    assert !strings.contains(fi.name, "/"), "file_info of #{h.name} contains a slash: #{fi.name}"
    name = path.base(h.name)
    name += "/" if fi.is_dir
    assert_eq h2.name, name
    assert_eq h2.size, h.size
    assert_eq h2.uid, h.uid
    assert_eq h2.gid, h.gid
    assert_eq h2.uname, h.uname
    assert_eq h2.gname, h.gname
    assert_eq h2.linkname, h.linkname
    assert_eq h2.typeflag, h.typeflag
    assert_eq h2.mode, h.mode
    assert_eq fi.mode.bits, v[1]
    assert h2.access_time == h.access_time, "i=#{i}: access_time"
    assert h2.change_time == h.change_time, "i=#{i}: change_time"
    assert h2.mod_time == h.mod_time, "i=#{i}: mod_time"
    i += 1
  }
}

test "header allowed formats" {
  vectors = [
    (Header.new(), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(size: 0o77777777777), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(size: 0o77777777777, format: FORMAT_USTAR), empty_map, FORMAT_USTAR),
    (Header.new(size: 0o77777777777, format: FORMAT_PAX), empty_map, FORMAT_USTAR | FORMAT_PAX),
    (Header.new(size: 0o77777777777, format: FORMAT_GNU), empty_map, FORMAT_GNU),
    (Header.new(size: 0o77777777777 + 1), {PAX_SIZE => "8589934592"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(size: 0o77777777777 + 1, format: FORMAT_PAX), {PAX_SIZE => "8589934592"}, FORMAT_PAX),
    (Header.new(size: 0o77777777777 + 1, format: FORMAT_GNU), {PAX_SIZE => "8589934592"}, FORMAT_GNU),
    (Header.new(mode: 0o7777777), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(mode: 0o7777777 + 1), empty_map, FORMAT_GNU),
    (Header.new(devmajor: -123), empty_map, FORMAT_GNU),
    (Header.new(devmajor: (1 << 56) - 1), empty_map, FORMAT_GNU),
    (Header.new(devmajor: (1 << 56)), empty_map, FORMAT_UNKNOWN),
    (Header.new(devmajor: (-1 << 56)), empty_map, FORMAT_GNU),
    (Header.new(devmajor: (-1 << 56) - 1), empty_map, FORMAT_UNKNOWN),
    (Header.new(name: "用戶名", devmajor: (-1 << 56)), empty_map, FORMAT_GNU),
    (Header.new(size: MAX_I64), {PAX_SIZE => "9223372036854775807"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(size: MIN_I64), {PAX_SIZE => "-9223372036854775808"}, FORMAT_UNKNOWN),
    (Header.new(uname: "0123456789abcdef0123456789abcdef"), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(uname: "0123456789abcdef0123456789abcdefx"), {PAX_UNAME => "0123456789abcdef0123456789abcdefx"}, FORMAT_PAX),
    (Header.new(name: "foobar"), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(name: strings.repeat("a", NAME_SIZE)), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(name: strings.repeat("a", NAME_SIZE+1)), {PAX_PATH => strings.repeat("a", NAME_SIZE+1)}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(linkname: "用戶名"), {PAX_LINKPATH => "用戶名"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(linkname: strings.repeat("用戶名\x00", NAME_SIZE)), {PAX_LINKPATH => strings.repeat("用戶名\x00", NAME_SIZE)}, FORMAT_UNKNOWN),
    (Header.new(linkname: "\x00hello"), {PAX_LINKPATH => "\x00hello"}, FORMAT_UNKNOWN),
    (Header.new(uid: 0o7777777), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(uid: 0o7777777 + 1), {PAX_UID => "2097152"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(xattrs: {}), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(xattrs: {"foo" => "bar"}), {PAX_SCHILY_XATTR + "foo" => "bar"}, FORMAT_PAX),
    (Header.new(xattrs: {"foo" => "bar"}, format: FORMAT_GNU), {PAX_SCHILY_XATTR + "foo" => "bar"}, FORMAT_UNKNOWN),
    (Header.new(xattrs: {"用戶名" => "\x00hello"}), {PAX_SCHILY_XATTR + "用戶名" => "\x00hello"}, FORMAT_PAX),
    (Header.new(xattrs: {"foo=bar" => "baz"}), empty_map, FORMAT_UNKNOWN),
    (Header.new(xattrs: {"foo" => ""}), {PAX_SCHILY_XATTR + "foo" => ""}, FORMAT_PAX),
    (Header.new(mod_time: time.unix(0, 0)), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(mod_time: time.unix(0o77777777777, 0)), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(mod_time: time.unix(0o77777777777+1, 0)), {PAX_MTIME => "8589934592"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(mod_time: time.unix(MAX_I64, 0)), {PAX_MTIME => "9223372036854775807"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(mod_time: time.unix(MAX_I64, 0), format: FORMAT_USTAR), {PAX_MTIME => "9223372036854775807"}, FORMAT_UNKNOWN),
    (Header.new(mod_time: time.unix(-1, 0)), {PAX_MTIME => "-1"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(mod_time: time.unix(1, 500)), {PAX_MTIME => "1.0000005"}, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(mod_time: time.unix(1, 0)), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(mod_time: time.unix(1, 0), format: FORMAT_PAX), empty_map, FORMAT_USTAR | FORMAT_PAX),
    (Header.new(mod_time: time.unix(1, 500), format: FORMAT_USTAR), {PAX_MTIME => "1.0000005"}, FORMAT_USTAR),
    (Header.new(mod_time: time.unix(1, 500), format: FORMAT_PAX), {PAX_MTIME => "1.0000005"}, FORMAT_PAX),
    (Header.new(mod_time: time.unix(1, 500), format: FORMAT_GNU), {PAX_MTIME => "1.0000005"}, FORMAT_GNU),
    (Header.new(mod_time: time.unix(-1, 500)), {PAX_MTIME => "-0.9999995"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(mod_time: time.unix(-1, 500), format: FORMAT_GNU), {PAX_MTIME => "-0.9999995"}, FORMAT_GNU),
    (Header.new(access_time: time.unix(0, 0)), {PAX_ATIME => "0"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(access_time: time.unix(0, 0), format: FORMAT_USTAR), {PAX_ATIME => "0"}, FORMAT_UNKNOWN),
    (Header.new(access_time: time.unix(0, 0), format: FORMAT_PAX), {PAX_ATIME => "0"}, FORMAT_PAX),
    (Header.new(access_time: time.unix(0, 0), format: FORMAT_GNU), {PAX_ATIME => "0"}, FORMAT_GNU),
    (Header.new(access_time: time.unix(-123, 0)), {PAX_ATIME => "-123"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(access_time: time.unix(-123, 0), format: FORMAT_PAX), {PAX_ATIME => "-123"}, FORMAT_PAX),
    (Header.new(change_time: time.unix(123, 456)), {PAX_CTIME => "123.000000456"}, FORMAT_PAX | FORMAT_GNU),
    (Header.new(change_time: time.unix(123, 456), format: FORMAT_USTAR), {PAX_CTIME => "123.000000456"}, FORMAT_UNKNOWN),
    (Header.new(change_time: time.unix(123, 456), format: FORMAT_GNU), {PAX_CTIME => "123.000000456"}, FORMAT_GNU),
    (Header.new(change_time: time.unix(123, 456), format: FORMAT_PAX), {PAX_CTIME => "123.000000456"}, FORMAT_PAX),
    (Header.new(name: "foo/", typeflag: TYPE_DIR), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
    (Header.new(name: "foo/", typeflag: TYPE_REG), empty_map, FORMAT_UNKNOWN),
    (Header.new(name: "foo/", typeflag: TYPE_SYMLINK), empty_map, FORMAT_USTAR | FORMAT_PAX | FORMAT_GNU),
  ]
  i = 0
  for v in vectors {
    formats, pax_hdrs, err = v[0].allowed_formats
    assert formats == v[2], "test #{i}, allowed_formats: got #{format_string(formats)}, want #{format_string(v[2])}"
    if formats & FORMAT_PAX > 0 {
      assert map_eq?(pax_hdrs, v[1]), "test #{i}, allowed_formats: got #{map_str(pax_hdrs)}, want #{map_str(v[1])}"
    }
    assert !(formats != FORMAT_UNKNOWN && err.some?), "test #{i}, unexpected error"
    assert !(formats == FORMAT_UNKNOWN && err.none?), "test #{i}, want an error"
    i += 1
  }
}
