    Header.new(typeflag: 48, name: "gnu-uid", mode: 0o644, uid: 1099511627776, mod_time: time.unix(1700000000, 0), format: 8),
    Header.new(typeflag: 51, name: "dev", mod_time: time.unix(1700000000, 0), devmajor: -1, devminor: 1099511627776, format: 8),
  ]
  sums: [Str] = ["00000000", "00000000", "00000000"]
  ~check_readback("big numbers", "11e1d08a67b5335726b52720ad83ff50e7d469db4df5e4c05ff8b1ad0af8ab84", want, sums)
}

test "readback global header" {
