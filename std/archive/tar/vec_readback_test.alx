# Generated from Go's archive/tar (its Reader over archives written by alx's Writer, readback_test.alx); do not edit by hand.
import "strings"
import "time"

test "readback add_fs" {
  want: [Header] = [
    Header.new(typeflag: 53, name: "a/", mode: 0o555, mod_time: time.unix(0, 0), format: 2),
    Header.new(typeflag: 53, name: "a/b/", mode: 0o555, mod_time: time.unix(0, 0), format: 2),
    Header.new(typeflag: 48, name: "a/b/two.txt", size: 4000, mode: 0o600, mod_time: time.unix(1600000000, 0), format: 2),
    Header.new(typeflag: 48, name: "a/one.txt", size: 4, mod_time: time.unix(1700000000, 0), format: 2),
    Header.new(typeflag: 50, name: "link", linkname: "a/one.txt", mode: 0o777, mod_time: time.unix(1700000000, 0), format: 2),
  ]
  sums: [Str] = ["00000000", "00000000", "5dd66ef2", "f817a89f", "00000000"]
  ~check_readback("add_fs", "f278de554f81090965ca919928d962c3fcd35fb86a00644621d7b960f50393eb", want, sums)
}

test "readback big numbers" {
  want: [Header] = [
