    Header.new(typeflag: 103, name: "GlobalHead.0.0", pax_records: {"comment" => "global", "mtime" => "1234567890.5"}, format: 4),
    Header.new(typeflag: 48, name: "after-global", size: 4, mode: 0o644, mod_time: time.unix(1700000000, 0), format: 2),
    Header.new(typeflag: 103, name: "named-global", pax_records: {"comment" => "second"}, format: 4),
  ]
  sums: [Str] = ["00000000", "adf3f363", "00000000"]
  ~check_readback("global header", "28f8540fa2fa90e8f9059254fc68e50a29abbabebccc4f4e77a751d59a2e80fd", want, sums)
}

