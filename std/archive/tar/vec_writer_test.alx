test "writer empty archive" {
  es: [WEntry] = [
  ]
  errs: [Str] = []
  ~check_writer(es, errs, true, "", "5f70bf18a086007016e948b04aed3b82103a36bea41755b6cddfaf10ace3c6ef", 1024)
}

