test "fs" {
  for t in [("testdata/unix.zip", ["hello", "dir/bar", "readonly"]), ("testdata/subdir.zip", ["a/b/c"])] {
    z = ~open_reader(t[0])
    r = fstest.test_fs(z, t[1])
    if e = r.err {
      assert false, e.message
    }
    z.~close!
  }
}

test "fs walk" {
  tests = [("testdata/unix.zip", [".", "dir", "dir/bar", "dir/empty", "hello", "readonly"], false), ("testdata/subdir.zip", [".", "a", "a/b", "a/b/c"], false), ("testdata/dupdir.zip", [], true)]
  for t in tests {
    z = ~open_reader(t[0])
    files: [Str] = []
    saw_err = [false]
    r = fs.walk_dir(z, ".") { |p, d, err|
      if e = err {
        assert t[2], "#{p}: #{e.message}"
        saw_err[0] = true
        return
      }
      files << p
    }
    assert r.ok?, "walk_dir error"
    assert_eq saw_err[0], t[2]
    assert_eq files, t[1] if !t[2]
    z.~close!
  }
}

test "fs walk bad file" {
  buf = bytes.new_buffer([])
  zw = new_writer(buf)
  hdr = FileHeader.new(name: ".")
  hdr.set_mode!(fs.mode(fs.MODE_DIR | 0o755))
  w = zw.~create_header!(hdr)
  w.~write!(b("some data"))
  zw.~close!
  data = buf.bytes
  zr = ~new_reader(bytes.new_reader(data), data.size)
  count = [0]
  r = fs.walk_dir(zr, ".") { |p, d, err|
    count[0] += 1
    fail ZipError.Format if count[0] > 2
    if e = err {
      fail e
    }
  }
  assert !r.ok?, "expected error from invalid file name"
  assert r.err.unwrap.message != "zip: not a valid zip file", "repeated call to path"
}

test "fs mod time" {
  z = ~open_reader("testdata/subdir.zip")
  for t in [("a", at(2021, 4, 19, 12, 29, 56, 0, tz(-7)).utc), ("a/b/c", at(2021, 4, 19, 12, 29, 59, 0, tz(-7)).utc)] {
    fi = fs.~stat(z, t[0])
    assert fi.mod_time.equal(t[1]), "#{t[0]}: got modtime #{fi.mod_time}, want #{t[1]}"
  }
  z.~close!
}

test "cve 2021 27919" {
  data = cve202127919_data
  r = ~new_reader(bytes.new_reader(data), data.size)
  assert_eq r.check_paths.err.unwrap.message, "zip: insecure file path"
  assert r.open("test.txt").ok?, "error reading file"
  assert_eq r.file.size, 1
  assert_eq r.file[0].header.name, "../test.txt"
  assert r.file[0].open.ok?, "error opening file"
}

test "open reader insecure path" {
  data = cve202127919_data
  name = ~os.mkdir_temp("", "zip") + "/test.zip"
  ~os.write_file(name, data, 0o644)
  r = ~open_reader(name)
  assert_eq r.check_paths.err.unwrap.message, "zip: insecure file path"
  assert r.open("test.txt").ok?, "error reading file"
  assert_eq r.file.size, 1
  assert_eq r.file[0].header.name, "../test.txt"
  assert r.file[0].open.ok?, "error opening file"
  r.~close!
}

test "cve 2021 33196" {
  data = cve202133196_data
  assert_eq new_reader(bytes.new_reader(data), data.size).err.unwrap.message, "zip: not a valid zip file"
  # A handful of empty files is fine.
  buf = bytes.new_buffer([])
  w = new_writer(buf)
  for _i in 0...5 {
    w.~create!("")
  }
  w.~close!
  d = buf.bytes
  r = ~new_reader(bytes.new_reader(d), d.size)
  assert_eq r.file.size, 5
}

test "cve 2021 39293" {
  data = cve202139293_data
  assert_eq new_reader(bytes.new_reader(data), data.size).err.unwrap.message, "zip: not a valid zip file"
}

test "cve 2021 41772" {
  data = cve202141772_data
  r = ~new_reader(bytes.new_reader(data), data.size)
  assert_eq r.check_paths.err.unwrap.message, "zip: insecure file path"
  names: [Str] = []
  for f in r.file {
    names << f.header.name
    assert f.open.ok?, "error opening #{f.header.name}"
    assert !r.open(f.header.name).ok?, "opening #{f.header.name} with fs.FS API succeeded"
  }
  assert_eq names, ["/", "//", "\\", "/test.txt"]
  assert !r.open("").ok?, "opening \"\" succeeded"
  assert r.open("test.txt").ok?, "error opening test.txt"
  entries = fs.~read_dir(r, ".")
  assert_eq entries.size, 1
  assert_eq entries[0].name, "test.txt"
  info = entries[0].~info
  assert_eq info.name, "test.txt"
}

test "under size" {
  z = ~open_reader("testdata/readme.zip")
  for i in 0...z.file.size {
    z.file[i].header.uncompressed_size64 = 1
  }
  for f in z.file {
    rd = f.~open
    res = io.copy(io.Discard.new(), rd)
    assert_eq res.err.unwrap.message, "zip: not a valid zip file"
  }
  z.~close!
}

test "issue 54801" {
  for input in ["testdata/readme.zip", "testdata/dd.zip"] {
    z = ~open_reader(input)
    for f in z.file {
      g = f
      g.header.name += "/"
      rd = g.~open
      res = io.copy(io.Discard.new(), rd)
      assert_eq res.err.unwrap.message, "zip: not a valid zip file"
    }
    z.~close!
  }
}

test "insecure paths" {
  for p in ["../foo", "/foo", "a/b/../../../c", "a\\b"] {
    buf = bytes.new_buffer([])
    zw = new_writer(buf)
    zw.~create!(p)
    zw.~close!
    d = buf.bytes
    zr = ~new_reader(bytes.new_reader(d), d.size)
    assert_eq zr.check_paths.err.unwrap.message, "zip: insecure file path"
    assert_eq zr.file.map { it.header.name }.to_a, [p]
  }
}

test "disable insecure path check" {
  buf = bytes.new_buffer([])
  zw = new_writer(buf)
  zw.~create!("/foo")
  zw.~close!
  d = buf.bytes
  zr = ~new_reader(bytes.new_reader(d), d.size)
  assert_eq zr.file.map { it.header.name }.to_a, ["/foo"]
}

test "compressed directory" {
  data = compressed_directory_data
  r = ~new_reader(bytes.new_reader(data), data.size)
  for f in r.file {
    rc = f.~open
    io.~copy(io.Discard.new(), rc)
  }
}

test "base offset plus overflow" {
  data = base_offset_plus_overflow_data
  # Must not panic.
  new_reader(bytes.new_reader(data), data.size + 1875)
}
