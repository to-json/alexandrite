def vec_case(i: Int) -> ~[Byte] {
  case i {
    0 => ~vec_case_0
    1 => ~vec_case_1
    2 => ~vec_case_2
    3 => ~vec_case_3
    4 => ~vec_case_4
    5 => ~vec_case_5
    6 => ~vec_case_6
    7 => ~vec_case_7
    8 => ~vec_case_8
    9 => ~vec_case_9
    10 => ~vec_case_10
    11 => ~vec_case_11
    12 => ~vec_case_12
    13 => ~vec_case_13
    14 => ~vec_case_14
    15 => ~vec_case_15
    16 => ~vec_case_16
    17 => ~vec_case_17
    18 => ~vec_case_18
    19 => ~vec_case_19
    20 => ~vec_case_20
    21 => ~vec_case_21
    22 => ~vec_case_22
    23 => ~vec_case_23
    24 => ~vec_case_24
    25 => ~vec_case_25
    26 => ~vec_case_26
    27 => ~vec_case_27
    28 => ~vec_case_28
    29 => ~vec_case_29
    30 => ~vec_case_30
    31 => ~vec_case_31
    32 => ~vec_case_32
    33 => ~vec_case_33
    34 => ~vec_case_34
    35 => ~vec_case_35
    36 => ~vec_case_36
    37 => ~vec_case_37
    38 => ~vec_case_38
    39 => ~vec_case_39
    40 => ~vec_case_40
    41 => ~vec_case_41
    42 => ~vec_case_42
    43 => ~vec_case_43
    44 => ~vec_case_44
    45 => ~vec_case_45
