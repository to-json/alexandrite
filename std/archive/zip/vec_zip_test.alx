    60 => ~vec_case_60
    61 => ~vec_case_61
    62 => ~vec_case_62
    63 => ~vec_case_63
    _ => []
  }
}

# What Go's Reader saw in one file of an archive.
struct VecFile {
  name: Str
  comment: Str
  non_utf8: Bool
  method: U16
  flags: U16
  creator_version: U16
  reader_version: U16
  crc32: U32
  external_attrs: U32
  compressed_size64: U64
  uncompressed_size64: U64
  modified: Int
  zone_offset: Int
  mode: U32
  content_crc: U32
  content_len: Int
  err: Str
}

def check_vec_case(i: Int, size: Int, sha: Str, comment: Str, files: [VecFile]) -> ~Unit {
  data = ~vec_case(i)
  assert_eq data.size, size
  assert_eq hex.encode_to_string(sha256.sum256(data).to_a), sha
  r = ~new_reader(bytes.new_reader(data), data.size)
  assert_eq r.comment, comment
  assert_eq r.file.size, files.size
  for k in 0...files.size {
    want = files[k]
    h = r.file[k].header
    assert_eq h.name, want.name
    assert_eq h.comment, want.comment
    assert_eq h.non_utf8, want.non_utf8
    assert_eq h.method, want.method
    assert_eq h.flags, want.flags
    assert_eq h.creator_version, want.creator_version
    assert_eq h.reader_version, want.reader_version
    assert_eq h.crc32, want.crc32
    assert_eq h.external_attrs, want.external_attrs
    assert_eq h.compressed_size64, want.compressed_size64
    assert_eq h.uncompressed_size64, want.uncompressed_size64
    assert_eq h.modified.unix, want.modified
    assert_eq h.modified.zone_info[1], want.zone_offset
    assert_eq r.file[k].mode.bits, want.mode
    rc = r.file[k].~open
    got = io.read_all(rc)
    if e = got.err {
      assert_eq e.message, want.err
    } else {
      assert_eq want.err, ""
      assert_eq got.unwrap.size, want.content_len
      assert_eq crc32.checksum_ieee(got.unwrap), want.content_crc
    }
  }
}

test "go vectors 0" {
  f0: [VecFile] = []
