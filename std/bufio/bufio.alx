# Package bufio: Go's bufio — buffered I/O over io.Reader / io.Writer.
#
# Shape (differences from Go; see also io's header):
#  - End of input is not an error: `read_byte!`, `read_rune!`, `read_bytes!`,
#    `read_string!` and `read_line!` return none when nothing is left (the
#    last, unterminated line is returned normally). Their type is `~T?`: they
#    fail on an I/O error, are none at the end, else hold the value.
#    `read_string!(delim)` includes the delimiter, `read_line!` drops "\n" or
#    "\r\n".
#  - A Reader, Writer or Scanner is a value with state: call its `!` methods
#    on a variable. The io.Reader / io.Writer it wraps is held by value, so
#    wrap handles whose state lives outside the value (`os.File`, `os.stdin`)
#    or objects you won't touch again.
#  - A bufio.Reader is not itself an io.Reader (it holds one, and a closed
#    sum can't contain itself): read from it with its own methods.
#  - A Writer must be `flush!`ed; nothing happens at exit.
#  - Scanner has no custom split functions: `split!(Split.Lines)` (default),
#    `Words`, `Runes` or `Bytes`. Tokens longer than `max_token` (64 KiB by
#    default, `buffer!(n)` changes it) stop the scan with BufioError.TooLong.
#    `err` is none after a normal end of input.

import "errors"
import "io"
import "unicode"
import "unicode/utf8"

DEFAULT_SIZE = 4096
pub MAX_SCAN_TOKEN_SIZE = 65536

pub error BufioError {
  # A buffer is full: the data wanted doesn't fit.
  BufferFull
  # A token is longer than the scanner's limit.
  TooLong
  # Nothing to unread, or the last operation can't be undone.
  InvalidUnread
  NegativeCount

  def message -> Str {
    case self {
      BufferFull => "bufio: buffer full"
      TooLong => "bufio.Scanner: token too long"
      InvalidUnread => "bufio: invalid use of unread"
      NegativeCount => "bufio: negative count"
    }
  }
}

def zeros(n: Int) -> [Byte] {
  b: [Byte] = [0; n]
  b
}

# ---------------------------------------------------------------------- Reader

pub struct Reader {
  rd: io.Reader
  buf: [Byte]
  r: Int
  w: Int
  last: Int

  # Slides the unread bytes to the front and reads once more; returns the
  # number of bytes read (0 at the end of input).
  def fill! -> ~Int {
    if r > 0 {
      copy(buf[0...w - r], buf[r...w])
      self.w = w - r
      self.r = 0
    }
    fail BufioError.BufferFull if w >= buf.size
    n = self.rd.~read!(buf[w...buf.size])
    self.w = w + n
    n
  }

  # Reads into p from the buffer, refilling at most once; 0 at the end.
  pub def read!(p: [Byte]) -> ~Int {
    return 0 if p.size == 0
    if r == w {
      if p.size >= buf.size {
        got = self.rd.~read!(p)
        self.last = p[got - 1].to_i if got > 0
        return got
      }
      self.r = 0
      self.w = 0
      n = self.rd.~read!(buf)
      return 0 if n == 0
      self.w = n
    }
    n = w - r
    n = p.size if n > p.size
    copy(p[0...n], buf[r...r + n])
    self.r = r + n
    self.last = buf[r - 1].to_i
    n
  }

  # The next byte, or none at the end of input.
  pub def read_byte! -> ~Byte? {
    while r == w {
      n = self.~fill!
      return none if n == 0
    }
    c = buf[r]
    self.r = r + 1
    self.last = c.to_i
    c
  }

  # Undoes the last read_byte! (or the last byte of a read).
  pub def unread_byte! -> ~Unit {
    fail BufioError.InvalidUnread if last < 0 || (r == 0 && w > 0)
    if r > 0 {
      self.r = r - 1
    } else {
      self.w = 1
    }
    self.buf[r] = last.as_u8
    self.last = -1
  }

  # The next rune and its width in bytes (invalid UTF-8 reads as U+FFFD, 1),
  # or none at the end of input.
  pub def read_rune! -> ~(Rune, Int)? {
    while w - r < 4 && !(r < w && utf8.full_rune(buf[r...w])) {
      n = self.~fill!
      break if n == 0
    }
    return none if r == w
    c = buf[r]
    if c < 0x80 {
      self.r = r + 1
      self.last = c.to_i
      return (c.as_i32, 1)
    }
    e = w
    e = r + 4 if e > r + 4
    rr, size = utf8.decode_rune(buf[r...e])
    self.r = r + size
    self.last = buf[r - 1].to_i
    (rr, size)
  }

  # The next n bytes without consuming them (fewer at the end of input). Valid
  # until the next read. Fails with BufferFull if n exceeds the buffer.
  pub def peek!(n: Int) -> ~[Byte] {
    fail BufioError.NegativeCount if n < 0
    fail BufioError.BufferFull if n > buf.size
    while w - r < n {
      got = self.~fill!
      break if got == 0
    }
    e = r + n
    e = w if e > w
    buf[r...e]
  }

  # Skips n bytes; returns how many were skipped (fewer at the end).
  pub def discard!(n: Int) -> ~Int {
    fail BufioError.NegativeCount if n < 0
    left = n
    while left > 0 {
      if r == w {
        got = self.~fill!
        break if got == 0
      }
      k = w - r
      k = left if k > left
      self.r = r + k
      left -= k
    }
    n - left
  }

  # Unread bytes in the buffer.
  pub def buffered -> Int { w - r }

  # The buffer's size.
  pub def size -> Int { buf.size }

  # Discards buffered data and reads from rd2 instead.
  pub def reset!(rd2: io.Reader) {
    self.rd = rd2
    self.r = 0
    self.w = 0
    self.last = -1
  }

  # Index of the first delim in buf[from...w], or -1.
  def index_delim(delim: Byte, from: Int) -> Int {
    i = from
    while i < w {
      return i if buf[i] == delim
      i += 1
    }
    -1
  }

  # Everything through the first delim (included), or to the end of input;
  # none if nothing was left.
  pub def read_bytes!(delim: Byte) -> ~[Byte]? {
    i = index_delim(delim, r)
    if i >= 0 {
      out = zeros(i + 1 - r)
      copy(out, buf[r...i + 1])
      self.r = i + 1
      self.last = delim.to_i
      return out
    }
    acc: [Byte] = []
    loop {
      k = r
      while k < w {
        acc << buf[k]
        k += 1
      }
      self.r = w
      n = self.~fill!
      break if n == 0
      i = index_delim(delim, r)
      if i >= 0 {
        k = r
        while k <= i {
          acc << buf[k]
          k += 1
        }
        self.r = i + 1
        break
      }
    }
    return none if acc.size == 0
    self.last = acc[acc.size - 1].to_i
    acc
  }

  # Like read_bytes!, as a string.
  pub def read_string!(delim: Byte) -> ~Str? {
    i = index_delim(delim, r)
    if i >= 0 {
      s = Str.from_bytes(buf[r...i + 1])
      self.r = i + 1
      self.last = delim.to_i
      return s
    }
    b = self.~read_bytes!(delim)
    if x = b {
      return Str.from_bytes(x)
    }
    none
  }

  # The next line without its "\n" or "\r\n" ending; none at the end of input.
  # An unterminated last line is returned as it is.
  pub def read_line! -> ~Str? {
    i = index_delim(10, r)
    if i >= 0 {
      e = i
      e = i - 1 if e > r && buf[e - 1] == 13
      s = Str.from_bytes(buf[r...e])
      self.r = i + 1
      self.last = 10
      return s
    }
    line = self.~read_string!(10)
    if s = line {
      n = s.size
      n -= 1 if n > 0 && s[n - 1] == 10
      n -= 1 if n > 0 && s[n - 1] == 13
      return s[0...n]
    }
    none
  }
}

# A Reader over rd with a buffer of `size` bytes (at least 16).
pub def new_reader_size(rd: io.Reader, size: Int) -> Reader {
  n = size
  n = 16 if n < 16
  Reader.new(rd: rd, buf: zeros(n), r: 0, w: 0, last: -1)
}

pub def new_reader(rd: io.Reader) -> Reader {
  new_reader_size(rd, DEFAULT_SIZE)
}

# ---------------------------------------------------------------------- Writer

pub struct Writer {
  wr: io.Writer
  buf: [Byte]
  n: Int

  # Writes all buffered data to the underlying writer.
  pub def flush! -> ~Unit {
    off = 0
    while off < n {
      m = self.wr.~write!(buf[off...n])
      fail io.StreamError.ShortWrite if m <= 0
      off += m
    }
    self.n = 0
  }

  # Buffers p (writing through when it is larger than the buffer); returns
  # p.size.
  pub def write!(p: [Byte]) -> ~Int {
    off = 0
    while off < p.size {
      if n == 0 && p.size - off >= buf.size {
        m = self.wr.~write!(p[off...p.size])
        fail io.StreamError.ShortWrite if m <= 0
        off += m
      } else {
        k = buf.size - n
        k = p.size - off if k > p.size - off
        copy(buf[n...n + k], p[off...off + k])
        self.n = n + k
        off += k
        if n == buf.size {
          self.~flush!
        }
      }
    }
    p.size
  }

  pub def write_string!(s: Str) -> ~Int {
    off = 0
    while off < s.size {
      k = buf.size - n
      k = s.size - off if k > s.size - off
      i = 0
      while i < k {
        self.buf[n + i] = s[off + i]
        i += 1
      }
      self.n = n + k
      off += k
      if n == buf.size {
        self.~flush!
      }
    }
    s.size
  }

  pub def write_byte!(c: Byte) -> ~Unit {
    if n == buf.size {
      self.~flush!
    }
    self.buf[n] = c
    self.n = n + 1
  }

  # Writes r as UTF-8; returns the byte count.
  pub def write_rune!(r: Rune) -> ~Int {
    enc = utf8.encode_rune(r)
    self.~write!(enc)
  }

  # Bytes buffered and not yet flushed.
  pub def buffered -> Int { n }

  # Free space in the buffer.
  pub def available -> Int { buf.size - n }

  pub def size -> Int { buf.size }

  # Drops unflushed data and writes to wr2 instead.
  pub def reset!(wr2: io.Writer) {
    self.wr = wr2
    self.n = 0
  }
}

pub def new_writer_size(wr: io.Writer, size: Int) -> Writer {
  k = size
  k = 1 if k < 1
  Writer.new(wr: wr, buf: zeros(k), n: 0)
}

pub def new_writer(wr: io.Writer) -> Writer {
  new_writer_size(wr, DEFAULT_SIZE)
}

# --------------------------------------------------------------------- Scanner

# How a Scanner cuts its input into tokens.
pub enum Split {
  # Lines without their "\n" / "\r\n" (the default).
  Lines
  # Runs of non-space characters (Unicode spaces).
  Words
  # UTF-8 encoded runes (invalid bytes become U+FFFD tokens of one byte).
  Runes
  # Single bytes.
  Bytes
}

pub struct Scanner {
  src: io.Reader
  buf: [Byte]
  start: Int
  stop: Int
  ts: Int
  te: Int
  mode: Int
  max_tok: Int
  eof: Bool
  fail_kind: Int
  fail_msg: Str

  # Sets the mode (before the first scan!).
  pub def split!(how: Split) {
    self.mode = case how {
      Lines => 0
      Words => 1
      Runes => 2
      Bytes => 3
    }
  }

  # The largest token allowed (and so the largest buffer), at least 16.
  pub def buffer!(max: Int) {
    self.max_tok = max < 16 ? 16 : max
  }

  # Advances to the next token; false at the end of input or on an error (see
  # `err`).
  pub def scan! -> Bool {
    return false if fail_kind != 0
    res = false
    loop {
      if stop > start || eof {
        st, a, b, ns = cut_token(buf, start, stop, eof, mode)
        self.start = ns
        if st == 1 {
          self.ts = a
          self.te = b
          res = true
          break
        }
        break if st == 2
        # st == 0: more data is needed (or a delimiter was skipped).
      }
      break if eof
      # Make room: slide, then grow.
      if start > 0 && (stop == buf.size || start > buf.size / 2) {
        copy(buf[0...stop - start], buf[start...stop])
        self.stop = stop - start
        self.start = 0
      }
      if stop == buf.size {
        if buf.size >= max_tok {
          self.fail_kind = 1
          break
        }
        nb = buf.size * 2
        nb = max_tok if nb > max_tok
        bigger = zeros(nb)
        copy(bigger[0...stop], buf[0...stop])
        self.buf = bigger
      }
      got = self.src.read!(buf[stop...buf.size])
      if got.err? {
        self.fail_kind = 2
        self.fail_msg = got.err.unwrap.message
        break
      }
      n = got.unwrap
      if n == 0 {
        self.eof = true
      } else {
        self.stop = stop + n
      }
    }
    res
  }

  # The current token as a string (a copy).
  pub def text -> Str {
    Str.from_bytes(buf[ts...te])
  }

  # The current token's bytes, aliasing the scanner's buffer: valid until the
  # next scan!.
  pub def bytes -> [Byte] {
    buf[ts...te]
  }

  # The error that stopped the scan, if any (none after a normal end). A
  # failure of the underlying reader comes back as a Failure carrying its
  # message (the scanner keeps the text, not the value, to stay small: it is
  # copied on every call).
  pub def err -> Error? {
    return none if fail_kind == 0
    return BufioError.TooLong if fail_kind == 1
    errors.new(fail_msg)
  }
}

# Looks for a token in buf[start...stop]. Returns (status, token start, token
# end, new start): status 1 is a token, 2 no more tokens, 0 more data is
# needed (the new start may skip delimiters). A plain function, not a `!`
# method: no copy of the scanner is made per token.
def cut_token(buf: [Byte], start: Int, stop: Int, eof: Bool, mode: Int) -> (Int, Int, Int, Int) {
  return 2, 0, 0, start if start == stop && eof
  return 0, 0, 0, start if start == stop
  if mode == 0 {
    i = start
    while i < stop && buf[i] != 10 {
      i += 1
    }
    if i < stop {
      e = i
      e = i - 1 if i > start && buf[i - 1] == 13
      return 1, start, e, i + 1
    }
    if eof {
      e = stop
      e = stop - 1 if stop > start && buf[stop - 1] == 13
      return 1, start, e, stop
    }
    return 0, 0, 0, start
  }
  if mode == 3 {
    return 1, start, start + 1, start + 1
  }
  if mode == 2 {
    c = buf[start]
    return 1, start, start + 1, start + 1 if c < 0x80
    e = stop
    e = start + 4 if e > start + 4
    return 0, 0, 0, start if !eof && !utf8.full_rune(buf[start...e])
    _, size = utf8.decode_rune(buf[start...e])
    return 1, start, start + size, start + size
  }
  # Words: skip leading spaces.
  i = start
  while i < stop {
    c = buf[i]
    if c < 0x80 {
      break if !(c == 32 || (c >= 9 && c <= 13))
      i += 1
    } else {
      e = stop
      e = i + 4 if e > i + 4
      break if !eof && !utf8.full_rune(buf[i...e])
      rr, size = utf8.decode_rune(buf[i...e])
      break if !unicode.is_space(rr)
      i += size
    }
  }
  # The word ends at the next space.
  j = i
  while j < stop {
    c = buf[j]
    if c < 0x80 {
      return 1, i, j, j + 1 if c == 32 || (c >= 9 && c <= 13)
      j += 1
    } else {
      e = stop
      e = j + 4 if e > j + 4
      break if !eof && !utf8.full_rune(buf[j...e])
      rr, size = utf8.decode_rune(buf[j...e])
      return 1, i, j, j + size if unicode.is_space(rr)
      j += size
    }
  }
  return 1, i, j, j if eof && j > i
  return 2, 0, 0, i if eof
  (0, 0, 0, i)
}

pub def new_scanner(src: io.Reader) -> Scanner {
  Scanner.new(src: src, buf: zeros(DEFAULT_SIZE), start: 0, stop: 0, ts: 0, te: 0, mode: 0, max_tok: MAX_SCAN_TOKEN_SIZE, eof: false, fail_kind: 0, fail_msg: "")
}
