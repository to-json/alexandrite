#![test(external)]
# Go's example_test.go. ExampleScanner_lines reads standard input (no
# output to check): it is here as a function, compiled but not run.

import "bufio"
import "bytes"
import "os"
import "strconv"

example "Writer" {
  w = bufio.new_writer(os.stdout)
  w.write_string!("Hello, ").unwrap
  w.write_string!("world!").unwrap
  # Don't forget to flush!
  w.flush!.unwrap
} outputs "Hello, world!"

example "Writer_AvailableBuffer" {
  w = bufio.new_writer(os.stdout)
  for i in [1, 2, 3, 4] {
    b = w.available_buffer
    b = b + strconv.itoa(i).bytes.to_a
    b << 32
    w.write!(b).unwrap
  }
  w.flush!.unwrap
} outputs "1 2 3 4 "

example "Writer_ReadFrom" {
  buf = bytes.new_buffer([])
  writer = bufio.new_writer(buf)
  data = "Hello, world!\nThis is a ReadFrom example."
  reader = bytes.new_reader(data.bytes.to_a)
  r = writer.read_from!(reader)
  if e = r.err {
    puts "ReadFrom Error: #{e.message}"
  } else if e2 = writer.flush!.err {
    puts "Flush Error: #{e2.message}"
  } else {
    puts "Bytes written: #{r.unwrap}"
    puts "Buffer contents: #{buf.string}"
  }
} outputs <<~'EOS'
  Bytes written: 41
  Buffer contents: Hello, world!
  This is a ReadFrom example.
EOS

# Go's ExampleScanner_lines.
def scanner_lines {
  scanner = bufio.new_scanner(os.stdin)
  while scanner.scan! {
    # puts adds back the final "\n".
    puts scanner.text
  }
  if e = scanner.err {
    eprint("reading standard input: #{e.message}\n")
  }
}

example "Scanner_Bytes" {
  scanner = bufio.new_scanner(bytes.new_reader("gopher".bytes.to_a))
  while scanner.scan! {
    puts scanner.bytes.size == 6
  }
  if _e = scanner.err {
    eprint("shouldn't see an error scanning a string\n")
  }
} outputs "true\n"

example "Scanner_words" {
  # An artificial input source.
  input = "Now is the winter of our discontent,\nMade glorious summer by this sun of York.\n"
  scanner = bufio.new_scanner(bytes.new_reader(input.bytes.to_a))
  # Set the split function for the scanning operation.
  scanner.split!(bufio.scan_words)
  # Count the words.
  count = 0
  while scanner.scan! {
    count += 1
  }
  if e = scanner.err {
    eprint("reading input: #{e.message}\n")
  }
  puts count
} outputs "15\n"

example "Scanner_custom" {
  # An artificial input source.
  input = "1234 5678 1234567901234567890"
  scanner = bufio.new_scanner(bytes.new_reader(input.bytes.to_a))
  # A custom split function wrapping scan_words.
  split = ->(data: [Byte], at_eof: Bool) -> ~(Int, [Byte]?, Bool) {
    advance, token, final = ~bufio.scan_words(data, at_eof)
    if t = token {
      ~strconv.parse_int(Str.from_bytes(t), 10, 32)
    }
    (advance, token, final)
  }
  # Set the split function for the scanning operation.
  scanner.split!(split)
  # Validate the input.
  while scanner.scan! {
    puts scanner.text
  }
  if e = scanner.err {
    print "Invalid input: #{e.message}"
  }
} outputs "1234\n5678\nInvalid input: strconv.parse_int: parsing \"1234567901234567890\": value out of range"

example "Scanner_emptyFinalToken" {
  # Comma-separated list; the last entry is empty.
  input = "1,2,3,4,"
  scanner = bufio.new_scanner(bytes.new_reader(input.bytes.to_a))
  # A split function that separates on commas.
  on_comma = ->(data: [Byte], at_eof: Bool) -> ~(Int, [Byte]?, Bool) {
    i = 0
    while i < data.size {
      return (i + 1, data[0...i], false) if data[i] == 44
      i += 1
    }
    return (0, none, false) if !at_eof
    # There is one final token to be delivered, which may be the empty
    # string. `final` (Go's ErrFinalToken) tells scan! there are no more
    # tokens after this, without an error.
    (0, data, true)
  }
  scanner.split!(on_comma)
  while scanner.scan! {
    print format("%q ", scanner.text)
  }
  if e = scanner.err {
    eprint("reading input: #{e.message}\n")
  }
} outputs "\"1\" \"2\" \"3\" \"4\" \"\" "

example "Scanner_earlyStop" {
  on_comma = ->(data: [Byte], at_eof: Bool) -> ~(Int, [Byte]?, Bool) {
    i = bytes.index_byte(data, 44)
    if i == -1 {
      return (0, none, false) if !at_eof
      # At the end, return the last token.
      return (0, data, true)
    }
    # If the token is "STOP", stop the scanning and ignore the rest.
    return (i + 1, none, true) if Str.from_bytes(data[0...i]) == "STOP"
    # Otherwise, return the token before the comma.
    (i + 1, data[0...i], false)
  }
  input = "1,2,STOP,4,"
  scanner = bufio.new_scanner(bytes.new_reader(input.bytes.to_a))
  scanner.split!(on_comma)
  while scanner.scan! {
    puts format("Got a token %q", scanner.text)
  }
  if e = scanner.err {
    eprint("reading input: #{e.message}\n")
  }
} outputs "Got a token \"1\"\nGot a token \"2\"\n"

# Writes s to standard error.
def eprint(s: Str) {
  e = os.stderr
  e.write_string!(s).unwrap
}
