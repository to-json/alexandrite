# Go's export_test.go: hooks into the package for the external tests.

pub DEFAULT_BUF_SIZE = DEFAULT_SIZE

pub def is_space(r: Rune) -> Bool {
  space?(r)
}

# Go's (*Scanner).MaxTokenSize.
pub def max_token_size(s: Scanner, n: Int) {
  panic "bad max token size" if n < utf8.UTF_MAX || n > 1000000000
  sc = s
  sc.cell[0].buf = zeros(n) if n < sc.cell[0].buf.size
  sc.cell[0].max_token_size = n
}

# Go's (*Scanner).ErrOrEOF: the error, or "EOF" at the end of input, or "".
pub def err_or_eof(s: Scanner) -> Str {
  if e = s.cell[0].err {
    return e.message
  }
  s.cell[0].eof ? "EOF" : ""
}
