# Generated from Go's bufio (`go run` in a scratch directory); do not edit by hand.
# The input arrives in chunks of the given size; split kinds: 0 lines, 1 words,
# 2 runes, 3 bytes. A read_line_prefix! result is "+" (a prefix) or "-" and
# the line.

struct VecChunkReader {
  st: [Str]
  chunk: Int

  def read!(p: [Byte]) -> ~Int {
    s = st[0]
    n = chunk
    n = p.size if n > p.size
    n = s.size if n > s.size
    i = 0
    while i < n {
      p[i] = s[i]
      i += 1
    }
    self.st[0] = s[n...s.size]
    n
  }
}

def vec_reader(s: Str, chunk: Int) -> VecChunkReader {
  VecChunkReader.new(st: [s], chunk: chunk)
}

#[track_caller]
def chk_scan(kind: Int, input: Str, chunk: Int, max: Int, want: [Str], want_err: Str) {
  s = new_scanner(vec_reader(input, chunk))
  case kind {
    0 => s.split!(scan_lines)
    1 => s.split!(scan_words)
    2 => s.split!(scan_runes)
    _ => s.split!(scan_bytes)
  }
  s.buffer!([], max)
  got: [Str] = []
  while s.scan! {
    got << s.text
  }
  assert got == want, format("scan %d of %q (chunk %d, max %d) = %v, want %v at %s", kind, input, chunk, max, got, want, caller_location)
  e = s.err
  assert_eq e?.message || "", want_err
}

#[track_caller]
def chk_read_line_prefix(input: Str, size: Int, chunk: Int, want: [Str]) {
  b = new_reader_size(vec_reader(input, chunk), size)
  got: [Str] = []
  loop {
    line, pre = b.read_line_prefix!.unwrap || break
    got << (pre ? "+" : "-") + Str.from_bytes(line)
  }
  assert got == want, format("read_line_prefix! of %q (size %d, chunk %d) = %v, want %v at %s", input, size, chunk, got, want, caller_location)
}

#[track_caller]
def chk_read_string(input: Str, size: Int, chunk: Int, delim: Byte, want: [Str]) {
  b = new_reader_size(vec_reader(input, chunk), size)
  got: [Str] = []
  loop {
    piece = b.read_string!(delim).unwrap || break
    got << piece
  }
  assert got == want, format("read_string!(%d) of %q (size %d, chunk %d) = %v, want %v at %s", delim, input, size, chunk, got, want, caller_location)
}

#[track_caller]
def chk_read_runes(input: Str, size: Int, chunk: Int, want: Str) {
  b = new_reader_size(vec_reader(input, chunk), size)
  got: [Str] = []
  loop {
    rr, n = b.read_rune!.unwrap || break
    got << "#{rr}/#{n}"
  }
  g = got.join(" ")
  assert g == want, format("read_rune! of %q (size %d, chunk %d) = %q, want %q at %s", input, size, chunk, g, want, caller_location)
}

#[track_caller]
def chk_writer(size: Int, ops: [Str], want: Str, want_buffered: Int) {
  sink: [[Byte]] = [[]]
  out = VecSink.new(st: sink)
  w = new_writer_size(out, size)
  for op in ops {
    arg = op[1...op.size]
    case op[0] {
      115 => w.write_string!(arg).unwrap
      114 => w.write_rune!(arg.to_i.as_i32).unwrap
      _ => w.write_byte!(arg.to_i.as_u8).unwrap
    }
  }
  assert_eq w.buffered, want_buffered
  w.flush!.unwrap
  assert Str.from_bytes(sink[0]) == want, format("writer(%d) %v = %q, want %q at %s", size, ops, Str.from_bytes(sink[0]), want, caller_location)
}

struct VecSink {
  st: [[Byte]]

  def write!(p: [Byte]) -> ~Int {
    self.st[0] = st[0] + p
    p.size
  }
}

test "scanner 1" {
  chk_scan(0, "a", 2, 16, ["a"], "")
  chk_scan(1, "a", 3, 16, ["a"], "")
  chk_scan(2, "a", 7, 64, ["a"], "")
  chk_scan(3, "a", 2, 16, ["a"], "")
  chk_scan(0, "aa", 2, 64, ["aa"], "")
  chk_scan(1, "aa", 7, 65536, ["aa"], "")
  chk_scan(2, "aa", 4096, 16, ["a", "a"], "")
  chk_scan(3, "aa", 1, 65536, ["a", "a"], "")
  chk_scan(0, "aab", 2, 64, ["aab"], "")
  chk_scan(1, "aab", 3, 65536, ["aab"], "")
  chk_scan(2, "aab", 7, 65536, ["a", "a", "b"], "")
  chk_scan(3, "aab", 2, 16, ["a", "a", "b"], "")
  chk_scan(0, "a\n", 7, 16, ["a"], "")
  chk_scan(1, "a\n", 1, 65536, ["a"], "")
  chk_scan(2, "a\n", 3, 64, ["a", "\n"], "")
  chk_scan(3, "a\n", 7, 64, ["a", "\n"], "")
  chk_scan(0, "b", 7, 65536, ["b"], "")
  chk_scan(1, "b", 4096, 16, ["b"], "")
  chk_scan(2, "b", 7, 65536, ["b"], "")
  chk_scan(3, "b", 4096, 65536, ["b"], "")
  chk_scan(0, "bb", 4096, 65536, ["bb"], "")
  chk_scan(1, "bb", 4096, 65536, ["bb"], "")
  chk_scan(2, "bb", 1, 65536, ["b", "b"], "")
  chk_scan(3, "bb", 3, 65536, ["b", "b"], "")
  chk_scan(0, "abb", 4096, 16, ["abb"], "")
  chk_scan(1, "abb", 1, 64, ["abb"], "")
  chk_scan(2, "abb", 4096, 16, ["a", "b", "b"], "")
  chk_scan(3, "abb", 1, 65536, ["a", "b", "b"], "")
  chk_scan(0, "b\n", 4096, 65536, ["b"], "")
  chk_scan(1, "b\n", 4096, 16, ["b"], "")
  chk_scan(2, "b\n", 3, 64, ["b", "\n"], "")
  chk_scan(3, "b\n", 3, 64, ["b", "\n"], "")
  chk_scan(0, "ab", 3, 16, ["ab"], "")
  chk_scan(1, "ab", 1, 16, ["ab"], "")
  chk_scan(2, "ab", 7, 65536, ["a", "b"], "")
  chk_scan(3, "ab", 2, 65536, ["a", "b"], "")
  chk_scan(0, "abab", 7, 16, ["abab"], "")
  chk_scan(1, "abab", 1, 65536, ["abab"], "")
  chk_scan(2, "abab", 1, 65536, ["a", "b", "a", "b"], "")
  chk_scan(3, "abab", 1, 16, ["a", "b", "a", "b"], "")
  chk_scan(0, "aabb", 4096, 64, ["aabb"], "")
  chk_scan(1, "aabb", 7, 16, ["aabb"], "")
  chk_scan(2, "aabb", 3, 65536, ["a", "a", "b", "b"], "")
  chk_scan(3, "aabb", 4096, 16, ["a", "a", "b", "b"], "")
  chk_scan(0, "ab\n", 1, 64, ["ab"], "")
  chk_scan(1, "ab\n", 2, 65536, ["ab"], "")
  chk_scan(2, "ab\n", 4096, 64, ["a", "b", "\n"], "")
  chk_scan(3, "ab\n", 4096, 16, ["a", "b", "\n"], "")
  chk_scan(0, "xyz", 3, 16, ["xyz"], "")
  chk_scan(1, "xyz", 7, 64, ["xyz"], "")
  chk_scan(2, "xyz", 3, 16, ["x", "y", "z"], "")
  chk_scan(3, "xyz", 7, 64, ["x", "y", "z"], "")
  chk_scan(0, "xyzxyz", 4096, 64, ["xyzxyz"], "")
  chk_scan(1, "xyzxyz", 7, 16, ["xyzxyz"], "")
  chk_scan(2, "xyzxyz", 7, 16, ["x", "y", "z", "x", "y", "z"], "")
  chk_scan(3, "xyzxyz", 3, 16, ["x", "y", "z", "x", "y", "z"], "")
  chk_scan(0, "axyzb", 4096, 16, ["axyzb"], "")
  chk_scan(1, "axyzb", 4096, 64, ["axyzb"], "")
  chk_scan(2, "axyzb", 7, 16, ["a", "x", "y", "z", "b"], "")
  chk_scan(3, "axyzb", 1, 16, ["a", "x", "y", "z", "b"], "")
  chk_scan(0, "xyz\n", 2, 65536, ["xyz"], "")
  chk_scan(1, "xyz\n", 7, 64, ["xyz"], "")
  chk_scan(2, "xyz\n", 2, 64, ["x", "y", "z", "\n"], "")
  chk_scan(3, "xyz\n", 7, 16, ["x", "y", "z", "\n"], "")
  chk_scan(0, " ", 7, 16, [" "], "")
  chk_scan(1, " ", 2, 65536, [], "")
  chk_scan(2, " ", 7, 16, [" "], "")
  chk_scan(3, " ", 7, 16, [" "], "")
  chk_scan(0, "  ", 3, 65536, ["  "], "")
  chk_scan(1, "  ", 3, 16, [], "")
  chk_scan(2, "  ", 7, 64, [" ", " "], "")
  chk_scan(3, "  ", 1, 64, [" ", " "], "")
  chk_scan(0, "a b", 4096, 64, ["a b"], "")
  chk_scan(1, "a b", 2, 64, ["a", "b"], "")
  chk_scan(2, "a b", 3, 64, ["a", " ", "b"], "")
  chk_scan(3, "a b", 7, 64, ["a", " ", "b"], "")
  chk_scan(0, " \n", 7, 65536, [" "], "")
  chk_scan(1, " \n", 4096, 64, [], "")
  chk_scan(2, " \n", 1, 64, [" ", "\n"], "")
  chk_scan(3, " \n", 1, 16, [" ", "\n"], "")
  chk_scan(0, "  ", 3, 64, ["  "], "")
  chk_scan(1, "  ", 1, 65536, [], "")
  chk_scan(2, "  ", 2, 65536, [" ", " "], "")
  chk_scan(3, "  ", 4096, 64, [" ", " "], "")
  chk_scan(0, "    ", 4096, 16, ["    "], "")
  chk_scan(1, "    ", 2, 65536, [], "")
  chk_scan(2, "    ", 3, 16, [" ", " ", " ", " "], "")
  chk_scan(3, "    ", 2, 65536, [" ", " ", " ", " "], "")
  chk_scan(0, "a  b", 4096, 64, ["a  b"], "")
  chk_scan(1, "a  b", 4096, 64, ["a", "b"], "")
  chk_scan(2, "a  b", 7, 16, ["a", " ", " ", "b"], "")
  chk_scan(3, "a  b", 3, 65536, ["a", " ", " ", "b"], "")
  chk_scan(0, "  \n", 1, 16, ["  "], "")
  chk_scan(1, "  \n", 4096, 16, [], "")
  chk_scan(2, "  \n", 2, 16, [" ", " ", "\n"], "")
  chk_scan(3, "  \n", 2, 65536, [" ", " ", "\n"], "")
  chk_scan(0, "\t", 2, 65536, ["\t"], "")
  chk_scan(1, "\t", 3, 16, [], "")
  chk_scan(2, "\t", 4096, 64, ["\t"], "")
  chk_scan(3, "\t", 1, 16, ["\t"], "")
}

test "scanner 2" {
  chk_scan(0, "\t\t", 4096, 65536, ["\t\t"], "")
  chk_scan(1, "\t\t", 7, 16, [], "")
  chk_scan(2, "\t\t", 2, 65536, ["\t", "\t"], "")
  chk_scan(3, "\t\t", 7, 65536, ["\t", "\t"], "")
  chk_scan(0, "a\tb", 3, 65536, ["a\tb"], "")
  chk_scan(1, "a\tb", 2, 65536, ["a", "b"], "")
  chk_scan(2, "a\tb", 3, 16, ["a", "\t", "b"], "")
  chk_scan(3, "a\tb", 7, 65536, ["a", "\t", "b"], "")
  chk_scan(0, "\t\n", 7, 64, ["\t"], "")
  chk_scan(1, "\t\n", 2, 16, [], "")
  chk_scan(2, "\t\n", 1, 16, ["\t", "\n"], "")
  chk_scan(3, "\t\n", 1, 16, ["\t", "\n"], "")
  chk_scan(0, "\n", 3, 64, [""], "")
  chk_scan(1, "\n", 7, 16, [], "")
  chk_scan(2, "\n", 3, 65536, ["\n"], "")
  chk_scan(3, "\n", 4096, 16, ["\n"], "")
  chk_scan(0, "\n\n", 1, 65536, ["", ""], "")
  chk_scan(1, "\n\n", 3, 64, [], "")
  chk_scan(2, "\n\n", 1, 65536, ["\n", "\n"], "")
  chk_scan(3, "\n\n", 1, 16, ["\n", "\n"], "")
  chk_scan(0, "a\nb", 3, 64, ["a", "b"], "")
  chk_scan(1, "a\nb", 1, 64, ["a", "b"], "")
  chk_scan(2, "a\nb", 4096, 16, ["a", "\n", "b"], "")
  chk_scan(3, "a\nb", 2, 65536, ["a", "\n", "b"], "")
  chk_scan(0, "\n\n", 3, 16, ["", ""], "")
  chk_scan(1, "\n\n", 4096, 64, [], "")
  chk_scan(2, "\n\n", 2, 16, ["\n", "\n"], "")
  chk_scan(3, "\n\n", 4096, 16, ["\n", "\n"], "")
  chk_scan(0, "\n\n", 3, 64, ["", ""], "")
  chk_scan(1, "\n\n", 7, 16, [], "")
  chk_scan(2, "\n\n", 4096, 16, ["\n", "\n"], "")
  chk_scan(3, "\n\n", 1, 65536, ["\n", "\n"], "")
  chk_scan(0, "\n\n\n\n", 2, 64, ["", "", "", ""], "")
  chk_scan(1, "\n\n\n\n", 1, 64, [], "")
  chk_scan(2, "\n\n\n\n", 3, 64, ["\n", "\n", "\n", "\n"], "")
  chk_scan(3, "\n\n\n\n", 4096, 64, ["\n", "\n", "\n", "\n"], "")
  chk_scan(0, "a\n\nb", 3, 65536, ["a", "", "b"], "")
  chk_scan(1, "a\n\nb", 3, 16, ["a", "b"], "")
  chk_scan(2, "a\n\nb", 7, 65536, ["a", "\n", "\n", "b"], "")
  chk_scan(3, "a\n\nb", 7, 64, ["a", "\n", "\n", "b"], "")
  chk_scan(0, "\n\n\n", 1, 64, ["", "", ""], "")
  chk_scan(1, "\n\n\n", 3, 16, [], "")
  chk_scan(2, "\n\n\n", 3, 65536, ["\n", "\n", "\n"], "")
  chk_scan(3, "\n\n\n", 4096, 65536, ["\n", "\n", "\n"], "")
  chk_scan(0, "\x0d", 4096, 16, [""], "")
  chk_scan(1, "\x0d", 4096, 64, [], "")
  chk_scan(2, "\x0d", 2, 64, ["\x0d"], "")
  chk_scan(3, "\x0d", 1, 64, ["\x0d"], "")
  chk_scan(0, "\x0d\x0d", 2, 16, ["\x0d"], "")
  chk_scan(1, "\x0d\x0d", 2, 64, [], "")
  chk_scan(2, "\x0d\x0d", 4096, 64, ["\x0d", "\x0d"], "")
  chk_scan(3, "\x0d\x0d", 3, 65536, ["\x0d", "\x0d"], "")
  chk_scan(0, "a\x0db", 1, 64, ["a\x0db"], "")
  chk_scan(1, "a\x0db", 1, 16, ["a", "b"], "")
  chk_scan(2, "a\x0db", 7, 16, ["a", "\x0d", "b"], "")
  chk_scan(3, "a\x0db", 4096, 16, ["a", "\x0d", "b"], "")
  chk_scan(0, "\x0d\n", 4096, 65536, [""], "")
  chk_scan(1, "\x0d\n", 4096, 64, [], "")
  chk_scan(2, "\x0d\n", 3, 16, ["\x0d", "\n"], "")
  chk_scan(3, "\x0d\n", 3, 65536, ["\x0d", "\n"], "")
  chk_scan(0, "\x0d\n", 3, 16, [""], "")
  chk_scan(1, "\x0d\n", 3, 64, [], "")
  chk_scan(2, "\x0d\n", 4096, 65536, ["\x0d", "\n"], "")
  chk_scan(3, "\x0d\n", 2, 65536, ["\x0d", "\n"], "")
  chk_scan(0, "\x0d\n\x0d\n", 1, 64, ["", ""], "")
  chk_scan(1, "\x0d\n\x0d\n", 4096, 16, [], "")
  chk_scan(2, "\x0d\n\x0d\n", 4096, 64, ["\x0d", "\n", "\x0d", "\n"], "")
  chk_scan(3, "\x0d\n\x0d\n", 2, 16, ["\x0d", "\n", "\x0d", "\n"], "")
  chk_scan(0, "a\x0d\nb", 7, 16, ["a", "b"], "")
  chk_scan(1, "a\x0d\nb", 2, 16, ["a", "b"], "")
  chk_scan(2, "a\x0d\nb", 7, 64, ["a", "\x0d", "\n", "b"], "")
  chk_scan(3, "a\x0d\nb", 1, 64, ["a", "\x0d", "\n", "b"], "")
  chk_scan(0, "\x0d\n\n", 2, 16, ["", ""], "")
  chk_scan(1, "\x0d\n\n", 4096, 16, [], "")
  chk_scan(2, "\x0d\n\n", 7, 16, ["\x0d", "\n", "\n"], "")
  chk_scan(3, "\x0d\n\n", 7, 64, ["\x0d", "\n", "\n"], "")
  chk_scan(0, "\x0b", 2, 64, ["\x0b"], "")
  chk_scan(1, "\x0b", 4096, 64, [], "")
  chk_scan(2, "\x0b", 1, 16, ["\x0b"], "")
  chk_scan(3, "\x0b", 3, 64, ["\x0b"], "")
  chk_scan(0, "\x0b\x0b", 4096, 64, ["\x0b\x0b"], "")
  chk_scan(1, "\x0b\x0b", 4096, 64, [], "")
  chk_scan(2, "\x0b\x0b", 7, 16, ["\x0b", "\x0b"], "")
  chk_scan(3, "\x0b\x0b", 2, 16, ["\x0b", "\x0b"], "")
  chk_scan(0, "a\x0bb", 3, 16, ["a\x0bb"], "")
  chk_scan(1, "a\x0bb", 1, 65536, ["a", "b"], "")
  chk_scan(2, "a\x0bb", 7, 16, ["a", "\x0b", "b"], "")
  chk_scan(3, "a\x0bb", 4096, 64, ["a", "\x0b", "b"], "")
  chk_scan(0, "\x0b\n", 4096, 16, ["\x0b"], "")
  chk_scan(1, "\x0b\n", 1, 64, [], "")
  chk_scan(2, "\x0b\n", 1, 16, ["\x0b", "\n"], "")
  chk_scan(3, "\x0b\n", 4096, 16, ["\x0b", "\n"], "")
  chk_scan(0, "\x0c", 4096, 16, ["\x0c"], "")
  chk_scan(1, "\x0c", 7, 64, [], "")
  chk_scan(2, "\x0c", 1, 65536, ["\x0c"], "")
  chk_scan(3, "\x0c", 2, 16, ["\x0c"], "")
  chk_scan(0, "\x0c\x0c", 4096, 64, ["\x0c\x0c"], "")
  chk_scan(1, "\x0c\x0c", 4096, 16, [], "")
  chk_scan(2, "\x0c\x0c", 7, 16, ["\x0c", "\x0c"], "")
  chk_scan(3, "\x0c\x0c", 3, 65536, ["\x0c", "\x0c"], "")
}

test "scanner 3" {
  chk_scan(0, "a\x0cb", 1, 64, ["a\x0cb"], "")
  chk_scan(1, "a\x0cb", 7, 16, ["a", "b"], "")
  chk_scan(2, "a\x0cb", 1, 65536, ["a", "\x0c", "b"], "")
  chk_scan(3, "a\x0cb", 3, 16, ["a", "\x0c", "b"], "")
  chk_scan(0, "\x0c\n", 4096, 16, ["\x0c"], "")
  chk_scan(1, "\x0c\n", 2, 16, [], "")
  chk_scan(2, "\x0c\n", 3, 64, ["\x0c", "\n"], "")
  chk_scan(3, "\x0c\n", 4096, 16, ["\x0c", "\n"], "")
  chk_scan(0, "\u0085", 3, 16, ["\u0085"], "")
  chk_scan(1, "\u0085", 3, 64, [], "")
  chk_scan(2, "\u0085", 3, 64, ["\u0085"], "")
  chk_scan(3, "\u0085", 1, 64, [Str.from_bytes([194]), Str.from_bytes([133])], "")
  chk_scan(0, "\u0085\u0085", 1, 64, ["\u0085\u0085"], "")
  chk_scan(1, "\u0085\u0085", 2, 65536, [], "")
  chk_scan(2, "\u0085\u0085", 1, 16, ["\u0085", "\u0085"], "")
  chk_scan(3, "\u0085\u0085", 2, 64, [Str.from_bytes([194]), Str.from_bytes([133]), Str.from_bytes([194]), Str.from_bytes([133])], "")
  chk_scan(0, "a\u0085b", 3, 16, ["a\u0085b"], "")
  chk_scan(1, "a\u0085b", 4096, 64, ["a", "b"], "")
  chk_scan(2, "a\u0085b", 2, 16, ["a", "\u0085", "b"], "")
  chk_scan(3, "a\u0085b", 4096, 65536, ["a", Str.from_bytes([194]), Str.from_bytes([133]), "b"], "")
  chk_scan(0, "\u0085\n", 4096, 65536, ["\u0085"], "")
  chk_scan(1, "\u0085\n", 2, 64, [], "")
  chk_scan(2, "\u0085\n", 1, 64, ["\u0085", "\n"], "")
  chk_scan(3, "\u0085\n", 3, 65536, [Str.from_bytes([194]), Str.from_bytes([133]), "\n"], "")
  chk_scan(0, "\u00a0", 4096, 65536, ["\u00a0"], "")
  chk_scan(1, "\u00a0", 3, 64, [], "")
  chk_scan(2, "\u00a0", 2, 16, ["\u00a0"], "")
  chk_scan(3, "\u00a0", 1, 64, [Str.from_bytes([194]), Str.from_bytes([160])], "")
  chk_scan(0, "\u00a0\u00a0", 1, 16, ["\u00a0\u00a0"], "")
  chk_scan(1, "\u00a0\u00a0", 1, 16, [], "")
  chk_scan(2, "\u00a0\u00a0", 3, 16, ["\u00a0", "\u00a0"], "")
  chk_scan(3, "\u00a0\u00a0", 1, 65536, [Str.from_bytes([194]), Str.from_bytes([160]), Str.from_bytes([194]), Str.from_bytes([160])], "")
  chk_scan(0, "a\u00a0b", 1, 65536, ["a\u00a0b"], "")
  chk_scan(1, "a\u00a0b", 4096, 64, ["a", "b"], "")
  chk_scan(2, "a\u00a0b", 3, 65536, ["a", "\u00a0", "b"], "")
  chk_scan(3, "a\u00a0b", 2, 16, ["a", Str.from_bytes([194]), Str.from_bytes([160]), "b"], "")
  chk_scan(0, "\u00a0\n", 1, 64, ["\u00a0"], "")
  chk_scan(1, "\u00a0\n", 1, 64, [], "")
  chk_scan(2, "\u00a0\n", 7, 16, ["\u00a0", "\n"], "")
  chk_scan(3, "\u00a0\n", 4096, 16, [Str.from_bytes([194]), Str.from_bytes([160]), "\n"], "")
  chk_scan(0, "\u1680", 3, 64, ["\u1680"], "")
