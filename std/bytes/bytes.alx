# Package bytes: Go's bytes, for `[Byte]` (S2). The twin of `strings`.
#
# Conventions (as in strings, see GO-VS-RUBY.md S2):
#  - Names are Go's, in snake_case; indexes and sizes are in bytes; "not found"
#    for the index family is -1. (T, bool) pairs are options: `cut` returns
#    `([Byte], [Byte])?`, `cut_prefix` / `cut_suffix` return `[Byte]?`.
#  - Aliasing follows Go. Results Go documents as subslices of the input
#    (split*, fields*, trim*, cut*) share its storage; they have no spare
#    capacity (D6), so appending to one copies. Results Go documents as copies
#    (clone, join, repeat, replace*, map, to_lower, to_upper, to_valid_utf8,
#    runes) never alias their input.
#  - Invalid UTF-8 decodes as U+FFFD with width 1, as in Go.
#  - Case mapping (to_upper, to_lower, to_title, title) and equal_fold use
#    std/unicode's tables: all of Unicode, simple case mapping, as Go's do.
#  - Builtin methods win over method sugar, so a name that is also a builtin
#    array method (`map`, `repeat`...) is called qualified: `bytes.map(f, b)`.
#  - Buffer (Go's bytes.Buffer, buffer.alx) and Reader (Go's bytes.Reader,
#    reader.alx) have their own headers.
#
#   Go                                        alx
#   Clone / Equal / Compare                   clone / equal / compare
#   Contains / ContainsAny / ContainsRune / ContainsFunc   contains / contains_any / contains_rune / contains_func
#   Count / HasPrefix / HasSuffix             count / has_prefix / has_suffix
#   Index / IndexByte / IndexRune / IndexAny / IndexFunc   index / index_byte / index_rune / index_any / index_func
#   LastIndex / LastIndexByte / LastIndexAny / LastIndexFunc   last_index / ... / last_index_func
#   Cut / CutLast (before, after, found)      cut / cut_last -> ([Byte], [Byte])?
#   CutPrefix / CutSuffix (rest, found)       cut_prefix / cut_suffix -> [Byte]?
#   EqualFold                                 equal_fold
#   Split / SplitN / SplitAfter / SplitAfterN split / split_n / split_after / split_after_n
#   Fields / FieldsFunc                       fields / fields_func
#   Lines / SplitSeq / SplitAfterSeq          lines / split_seq / split_after_seq -> [[Byte]]
#   FieldsSeq / FieldsFuncSeq                 fields_seq / fields_func_seq -> [[Byte]]
#   Join / Repeat / Runes                     join / repeat / runes
#   Replace / ReplaceAll / Map                replace / replace_all / map(mapping, s)
#   ToUpper / ToLower / ToTitle / Title       to_upper / to_lower / to_title / title
#   ToUpperSpecial(c, s) ...                  to_upper_special(c, s) / to_lower_special / to_title_special
#   ToValidUTF8                               to_valid_utf8
#   Trim / TrimLeft / TrimRight / TrimSpace   trim / trim_left / trim_right / trim_space
#   TrimFunc / TrimLeftFunc / TrimRightFunc   trim_func / trim_left_func / trim_right_func
#   TrimPrefix / TrimSuffix                   trim_prefix / trim_suffix
#
# Differences from Go:
#  - Go's iterator functions (Lines, SplitSeq, SplitAfterSeq, FieldsSeq,
#    FieldsFuncSeq) return the same pieces as a slice: alx has no iter.Seq.
#  - No nil: functions Go documents as returning nil (Trim of an empty slice,
#    the after of a failed cut) return an empty slice; cut* return none.
#  - repeat panics with "bytes: Repeat: len out of range" for a result over
#    2^48 bytes, where Go's runtime says "makeslice: len out of range".
#  - The *_special functions take any value with Go's SpecialCase methods
#    (to_upper/to_lower/to_title on a Rune), such as unicode.turkish_case.

import "strings"
import "unicode"

BAD = 0xFFFD * 8 + 1

def is_cont(b: Int) -> Bool { b >= 0x80 && b <= 0xBF }

# Decode the rune starting at byte i (i < s.size).
def dec(s: [Byte], i: Int) -> Int {
  n = s.size
  b0 = s[i].to_i
  return b0 * 8 + 1 if b0 < 0x80
  return BAD if b0 < 0xC2 || b0 > 0xF4
  return BAD if i + 1 >= n
  b1 = s[i + 1].to_i
  if b0 < 0xE0 {
    return BAD if !is_cont(b1)
    return (((b0 & 0x1F) << 6) | (b1 & 0x3F)) * 8 + 2
  }
  lo = 0x80
  hi = 0xBF
  if b0 == 0xE0 { lo = 0xA0 }
  if b0 == 0xED { hi = 0x9F }
  if b0 == 0xF0 { lo = 0x90 }
  if b0 == 0xF4 { hi = 0x8F }
  return BAD if b1 < lo || b1 > hi
  return BAD if i + 2 >= n
  b2 = s[i + 2].to_i
  return BAD if !is_cont(b2)
  if b0 < 0xF0 {
    return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)) * 8 + 3
  }
  return BAD if i + 3 >= n
  b3 = s[i + 3].to_i
  return BAD if !is_cont(b3)
  (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)) * 8 + 4
}

# Decode the rune ending just before byte e (e > 0).
def dec_last(s: [Byte], e: Int) -> Int {
  start = e - 1
  b = s[start].to_i
  return b * 8 + 1 if b < 0x80
  lim = e - 4
  lim = 0 if lim < 0
  start -= 1
  while start >= lim {
    break if !is_cont(s[start].to_i)
    start -= 1
  }
  start = lim if start < lim
  v = dec(s, start)
  return BAD if start + (v & 7) != e
  v
}

def valid_rune(c: Int) -> Bool { c >= 0 && c <= 0x10FFFF && !(c >= 0xD800 && c <= 0xDFFF) }

def rune_count(s: [Byte]) -> Int {
  n = s.size
  i = 0
  c = 0
  while i < n {
    i += dec(s, i) & 7
    c += 1
  }
  c
}

def is_space_rune(r: Int) -> Bool {
  if r < 0x100 { return r == 32 || (r >= 9 && r <= 13) || r == 0x85 || r == 0xA0 }
  r == 0x1680 || (r >= 0x2000 && r <= 0x200A) || r == 0x2028 || r == 0x2029 || r == 0x202F || r == 0x205F || r == 0x3000
}

# ------------------------------------------------------------------ building

# out with src[a...b] appended (always use the result).
def app(out: [Byte], src: [Byte], a: Int, b: Int) -> [Byte] {
  res = out
  i = a
  while i < b {
    res << src[i]
    i += 1
  }
  res
}

# out with the UTF-8 encoding of rune value c appended (invalid: U+FFFD).
def put_rune(out: [Byte], c: Int) -> [Byte] {
  res = out
  r = c
  r = 0xFFFD if !valid_rune(r)
  if r < 0x80 {
    res << r.as_u8
  } else if r < 0x800 {
    res << (0xC0 | (r >> 6)).as_u8
    res << (0x80 | (r & 0x3F)).as_u8
  } else if r < 0x10000 {
    res << (0xE0 | (r >> 12)).as_u8
    res << (0x80 | ((r >> 6) & 0x3F)).as_u8
    res << (0x80 | (r & 0x3F)).as_u8
  } else {
    res << (0xF0 | (r >> 18)).as_u8
    res << (0x80 | ((r >> 12) & 0x3F)).as_u8
    res << (0x80 | ((r >> 6) & 0x3F)).as_u8
    res << (0x80 | (r & 0x3F)).as_u8
  }
  res
}

def empty_bytes -> [Byte] {
  out: [Byte] = []
  out
}

# A copy of b with its own storage.
pub def clone(b: [Byte]) -> [Byte] {
  app(empty_bytes, b, 0, b.size)
}

# ------------------------------------------------------------------- search

def match_at(s: [Byte], i: Int, sub: [Byte]) -> Bool {
  m = sub.size
  j = 0
  while j < m {
    return false if s[i + j] != sub[j]
    j += 1
  }
  true
}

def index_from(s: [Byte], sub: [Byte], start: Int) -> Int {
  m = sub.size
  return start if m == 0
  first = sub[0]
  last = s.size - m
  i = start
  while i <= last {
    return i if s[i] == first && match_at(s, i, sub)
    i += 1
  }
  -1
}

# Whether a and b hold the same bytes.
pub def equal(a: [Byte], b: [Byte]) -> Bool {
  return false if a.size != b.size
  match_at(a, 0, b)
}

# Three-way comparison: -1, 0 or +1 (bytewise, shorter first on a common
# prefix).
pub def compare(a: [Byte], b: [Byte]) -> Int {
  n = a.size < b.size ? a.size : b.size
  i = 0
  while i < n {
    return -1 if a[i] < b[i]
    return 1 if a[i] > b[i]
    i += 1
  }
  return -1 if a.size < b.size
  return 1 if a.size > b.size
  0
}

pub def has_prefix(b: [Byte], prefix: [Byte]) -> Bool {
  b.size >= prefix.size && match_at(b, 0, prefix)
}

pub def has_suffix(b: [Byte], suffix: [Byte]) -> Bool {
  b.size >= suffix.size && match_at(b, b.size - suffix.size, suffix)
}

# Index of the first instance of sep in b, or -1.
pub def index(b: [Byte], sep: [Byte]) -> Int { index_from(b, sep, 0) }

# Index of the last instance of sep in b, or -1.
pub def last_index(b: [Byte], sep: [Byte]) -> Int {
  m = sep.size
  return b.size if m == 0
  i = b.size - m
  while i >= 0 {
    return i if b[i] == sep[0] && match_at(b, i, sep)
    i -= 1
  }
  -1
}

pub def index_byte(b: [Byte], c: Byte) -> Int {
  i = 0
  n = b.size
  while i < n {
    return i if b[i] == c
    i += 1
  }
  -1
}

pub def last_index_byte(b: [Byte], c: Byte) -> Int {
  i = b.size - 1
  while i >= 0 {
    return i if b[i] == c
    i -= 1
  }
  -1
}

# Index of the first instance of the rune r, or -1. U+FFFD also matches
# invalid UTF-8 bytes (Go).
pub def index_rune(b: [Byte], r: Rune) -> Int {
  c = r.to_i
  return index_byte(b, c.as_u8) if c >= 0 && c < 0x80
  n = b.size
  if c == 0xFFFD {
    i = 0
    while i < n {
      v = dec(b, i)
      return i if (v >> 3) == 0xFFFD
      i += v & 7
    }
    return -1
  }
  return -1 if !valid_rune(c)
  index(b, put_rune(empty_bytes, c))
}

# Index of the first rune of b for which f is true, or -1.
pub def index_func(b: [Byte], f: (Rune) -> Bool) -> Int {
  n = b.size
  i = 0
  while i < n {
    v = dec(b, i)
    return i if f((v >> 3).as_i32)
    i += v & 7
  }
  -1
}

# Index of the last rune of b for which f is true, or -1.
pub def last_index_func(b: [Byte], f: (Rune) -> Bool) -> Int {
  e = b.size
  while e > 0 {
    v = dec_last(b, e)
    e -= v & 7
    return e if f((v >> 3).as_i32)
  }
  -1
}

# Index of the first rune of b that is in chars, or -1.
pub def index_any(b: [Byte], chars: Str) -> Int {
  return -1 if chars.size == 0
  n = b.size
  i = 0
  while i < n {
    v = dec(b, i)
    return i if strings.index_rune(chars, (v >> 3).as_i32) >= 0
    i += v & 7
  }
  -1
}

# Index of the last rune of b that is in chars, or -1.
pub def last_index_any(b: [Byte], chars: Str) -> Int {
  return -1 if chars.size == 0
  e = b.size
  while e > 0 {
    v = dec_last(b, e)
    e -= v & 7
    return e if strings.index_rune(chars, (v >> 3).as_i32) >= 0
  }
  -1
}

pub def contains(b: [Byte], sub: [Byte]) -> Bool { index(b, sub) >= 0 }
pub def contains_any(b: [Byte], chars: Str) -> Bool { index_any(b, chars) >= 0 }
pub def contains_rune(b: [Byte], r: Rune) -> Bool { index_rune(b, r) >= 0 }
pub def contains_func(b: [Byte], f: (Rune) -> Bool) -> Bool { index_func(b, f) >= 0 }

# Number of non-overlapping instances of sep in b; with an empty sep, the
# number of runes plus one.
pub def count(b: [Byte], sep: [Byte]) -> Int {
  return rune_count(b) + 1 if sep.size == 0
  c = 0
  i = 0
  loop {
    j = index_from(b, sep, i)
    break if j < 0
    c += 1
    i = j + sep.size
  }
  c
}

# Slices b around the first instance of sep (subslices of b); none if absent.
pub def cut(b: [Byte], sep: [Byte]) -> ([Byte], [Byte])? {
  i = index(b, sep)
  return none if i < 0
  (b[0...i], b[i + sep.size...b.size])
}

pub def cut_prefix(b: [Byte], prefix: [Byte]) -> [Byte]? {
  return none if !has_prefix(b, prefix)
  b[prefix.size...b.size]
}

pub def cut_suffix(b: [Byte], suffix: [Byte]) -> [Byte]? {
  return none if !has_suffix(b, suffix)
  b[0...b.size - suffix.size]
}

# Like cut, around the last instance of sep.
pub def cut_last(b: [Byte], sep: [Byte]) -> ([Byte], [Byte])? {
  i = last_index(b, sep)
  return none if i < 0
  (b[0...i], b[i + sep.size...b.size])
}

# Whether a and b, read as UTF-8, are equal under simple Unicode case folding
# (invalid bytes read as U+FFFD).
pub def equal_fold(a: [Byte], b: [Byte]) -> Bool {
  i = 0
  j = 0
  while i < a.size && j < b.size {
    sr = 0
    tr = 0
    if a[i] < 0x80 {
      sr = a[i].to_i
      i += 1
    } else {
      v = dec(a, i)
      sr = v >> 3
      i += v & 7
    }
    if b[j] < 0x80 {
      tr = b[j].to_i
      j += 1
    } else {
      v = dec(b, j)
      tr = v >> 3
      j += v & 7
    }
    next if tr == sr
    if tr < sr {
      t = tr
      tr = sr
      sr = t
    }
    if tr < 0x80 {
      next if sr >= 0x41 && sr <= 0x5A && tr == sr + 32
      return false
    }
    r = unicode.simple_fold(sr.as_i32).to_i
    while r != sr && r < tr {
      r = unicode.simple_fold(r.as_i32).to_i
    }
    next if r == tr
    return false
  }
  i == a.size && j == b.size
}

# ---------------------------------------------------------------- splitting

def explode(s: [Byte], n: Int) -> [[Byte]] {
  out: [[Byte]] = []
  size = s.size
  i = 0
  while i < size {
    if n > 0 && out.size == n - 1 {
      out << s[i...size]
      return out
    }
    w = dec(s, i) & 7
    out << s[i...i + w]
    i += w
  }
  out
}

def gen_split(s: [Byte], sep: [Byte], save: Int, n: Int) -> [[Byte]] {
  out: [[Byte]] = []
  return out if n == 0
  return explode(s, n) if sep.size == 0
  start = 0
  loop {
    break if n > 0 && out.size >= n - 1
    j = index_from(s, sep, start)
    break if j < 0
    out << s[start...j + save]
    start = j + sep.size
  }
  out << s[start...s.size]
  out
}

# Splits s around every instance of sep (subslices of s). An empty sep splits
# into UTF-8 sequences.
pub def split(s: [Byte], sep: [Byte]) -> [[Byte]] { gen_split(s, sep, 0, -1) }
pub def split_after(s: [Byte], sep: [Byte]) -> [[Byte]] { gen_split(s, sep, sep.size, -1) }
# At most n pieces (n < 0: all; n == 0: none); the last holds the remainder.
pub def split_n(s: [Byte], sep: [Byte], n: Int) -> [[Byte]] { gen_split(s, sep, 0, n) }
pub def split_after_n(s: [Byte], sep: [Byte], n: Int) -> [[Byte]] { gen_split(s, sep, sep.size, n) }

# Splits s around runs of runes for which f is true; no empty pieces.
pub def fields_func(s: [Byte], f: (Rune) -> Bool) -> [[Byte]] {
  out: [[Byte]] = []
  n = s.size
  start = -1
  i = 0
  while i < n {
    v = dec(s, i)
    if f((v >> 3).as_i32) {
      if start >= 0 {
        out << s[start...i]
        start = -1
      }
    } else if start < 0 {
      start = i
    }
    i += v & 7
  }
  out << s[start...n] if start >= 0
  out
}

# Splits s around runs of Unicode white space; no empty pieces.
pub def fields(s: [Byte]) -> [[Byte]] {
  out: [[Byte]] = []
  n = s.size
  start = -1
  i = 0
  while i < n {
    v = dec(s, i)
    if is_space_rune(v >> 3) {
      if start >= 0 {
        out << s[start...i]
        start = -1
      }
    } else if start < 0 {
      start = i
    }
    i += v & 7
  }
  out << s[start...n] if start >= 0
  out
}

# Go's iterator forms (iter.Seq), as slices: alx has no iter.Seq, and the
# pieces are the same subslices the iterators yield.

# The newline-terminated lines of s (each keeps its "\n"; a last line without
# one is included; no empty final line).
pub def lines(s: [Byte]) -> [[Byte]] {
  out: [[Byte]] = []
  n = s.size
  start = 0
  while start < n {
    j = index_byte(s[start...n], 10)
    e = j < 0 ? n : start + j + 1
    out << s[start...e]
    start = e
  }
  out
}

pub def split_seq(s: [Byte], sep: [Byte]) -> [[Byte]] { split(s, sep) }
pub def split_after_seq(s: [Byte], sep: [Byte]) -> [[Byte]] { split_after(s, sep) }
pub def fields_seq(s: [Byte]) -> [[Byte]] { fields(s) }
pub def fields_func_seq(s: [Byte], f: (Rune) -> Bool) -> [[Byte]] { fields_func(s, f) }

# A new slice: the elements of s with sep between them.
pub def join(s: [[Byte]], sep: [Byte]) -> [Byte] {
  out = empty_bytes
  i = 0
  while i < s.size {
    out = app(out, sep, 0, sep.size) if i > 0
    out = app(out, s[i], 0, s[i].size)
    i += 1
  }
  out
}

# The largest slice `repeat` makes (Go's runtime limit on an allocation).
MAX_ALLOC = 1 << 48

# b repeated count times (a new slice). Panics if count is negative or the
# result would be too large.
pub def repeat(b: [Byte], count: Int) -> [Byte] {
  return empty_bytes if count == 0
  panic("bytes: negative Repeat count") if count < 0
  n = b.size
  return empty_bytes if n == 0
  panic("bytes: Repeat output length overflow") if count > 0x7FFF_FFFF_FFFF_FFFF / n
  total = n * count
  panic("bytes: Repeat: len out of range") if total > MAX_ALLOC
  out: [Byte] = [0; total]
  copy(out, b)
  done = n
  while done < total {
    k = done
    k = total - done if k > total - done
    copy(out[done...done + k], out[0...k])
    done += k
  }
  out
}

# The runes of s as a slice (invalid bytes become U+FFFD).
pub def runes(s: [Byte]) -> [Rune] {
  out: [Rune] = []
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    out << (v >> 3).as_i32
    i += v & 7
  }
  out
}

# ---------------------------------------------------------------- replacing

# A copy of s with the first n non-overlapping instances of old replaced by
# new (n < 0: all). An empty old matches before every rune and at the end.
pub def replace(s: [Byte], old: [Byte], new: [Byte], n: Int) -> [Byte] {
  m = count(s, old)
  return clone(s) if m == 0 || n == 0
  limit = n
  limit = m if n < 0 || m < n
  out = empty_bytes
  start = 0
  k = 0
  while k < limit {
    j = start
    if old.size == 0 {
      j += dec(s, start) & 7 if k > 0
    } else {
      j = index_from(s, old, start)
    }
    out = app(out, s, start, j)
    out = app(out, new, 0, new.size)
    start = j + old.size
    k += 1
  }
  app(out, s, start, s.size)
}

pub def replace_all(s: [Byte], old: [Byte], new: [Byte]) -> [Byte] { replace(s, old, new, -1) }

# A copy of s with every rune mapped through mapping; runes mapped to a
# negative value are dropped.
pub def map(mapping: (Rune) -> Rune, s: [Byte]) -> [Byte] {
  out = empty_bytes
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    m = mapping((v >> 3).as_i32).to_i
    out = put_rune(out, m) if m >= 0
    i += v & 7
  }
  out
}

# A copy of s with each run of invalid UTF-8 bytes replaced by replacement.
pub def to_valid_utf8(s: [Byte], replacement: [Byte]) -> [Byte] {
  out = empty_bytes
  n = s.size
  i = 0
  bad = false
  while i < n {
    v = dec(s, i)
    w = v & 7
    if v == BAD {
      out = app(out, replacement, 0, replacement.size) if !bad
      bad = true
    } else {
      out = app(out, s, i, i + w)
      bad = false
    }
    i += w
  }
  out
}

# ------------------------------------------------------------------- case

CASE_UP = 0
CASE_LO = 1
CASE_TI = 2

# A copy of s with every rune mapped by unicode.to_upper / to_lower /
# to_title (which); invalid UTF-8 becomes U+FFFD, as in Go's Map.
def map_case(s: [Byte], which: Int) -> [Byte] {
  out = empty_bytes
  n = s.size
  i = 0
  while i < n {
    b = s[i]
    if b < 0x80 {
      c = b
      if which == CASE_LO {
        c = b + 32 if b >= 0x41 && b <= 0x5A
      } else {
        c = b - 32 if b >= 0x61 && b <= 0x7A
      }
      out << c
      i += 1
    } else {
      v = dec(s, i)
      r = (v >> 3).as_i32
      m = r
      if which == CASE_UP {
        m = unicode.to_upper(r)
      } else if which == CASE_LO {
        m = unicode.to_lower(r)
      } else {
        m = unicode.to_title(r)
      }
      out = put_rune(out, m.to_i)
      i += v & 7
    }
  }
  out
}

# A copy of s with every rune upper-cased (Unicode simple case mapping).
pub def to_upper(s: [Byte]) -> [Byte] { map_case(s, CASE_UP) }

# A copy of s with every rune lower-cased.
pub def to_lower(s: [Byte]) -> [Byte] { map_case(s, CASE_LO) }

# A copy of s with every rune mapped to its title case.
pub def to_title(s: [Byte]) -> [Byte] { map_case(s, CASE_TI) }

# Go's ToUpperSpecial / ToLowerSpecial / ToTitleSpecial: c is a special-case
# mapping (Go's unicode.SpecialCase): anything with to_upper / to_lower /
# to_title on a Rune, such as unicode.turkish_case.
pub def to_upper_special[C](c: C, s: [Byte]) -> [Byte] { map(->(r: Rune) -> Rune { c.to_upper(r) }, s) }
pub def to_lower_special[C](c: C, s: [Byte]) -> [Byte] { map(->(r: Rune) -> Rune { c.to_lower(r) }, s) }
pub def to_title_special[C](c: C, s: [Byte]) -> [Byte] { map(->(r: Rune) -> Rune { c.to_title(r) }, s) }

# Whether r separates words for `title` (Go's isSeparator).
def is_separator(r: Rune) -> Bool {
  if r <= 0x7F {
    return false if r >= 0x30 && r <= 0x39
    return false if r >= 0x61 && r <= 0x7A
    return false if r >= 0x41 && r <= 0x5A
    return false if r == 0x5F
    return true
  }
  return false if unicode.is_letter(r) || unicode.is_digit(r)
  unicode.is_space(r)
}

# A copy of s with the first letter of each word mapped to title case
# (deprecated in Go: it doesn't handle Unicode punctuation properly).
pub def title(s: [Byte]) -> [Byte] {
  out = empty_bytes
  prev: Rune = 32
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    r = (v >> 3).as_i32
    m = r
    m = unicode.to_title(r) if is_separator(prev)
    prev = r
    out = put_rune(out, m.to_i)
    i += v & 7
  }
  out
}

# ------------------------------------------------------------------ trimming
# All trims return subslices of the input.

pub def trim_left_func(s: [Byte], f: (Rune) -> Bool) -> [Byte] {
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    break if !f((v >> 3).as_i32)
    i += v & 7
  }
  s[i...n]
}

pub def trim_right_func(s: [Byte], f: (Rune) -> Bool) -> [Byte] {
  e = s.size
  while e > 0 {
    v = dec_last(s, e)
    break if !f((v >> 3).as_i32)
    e -= v & 7
  }
  s[0...e]
}

pub def trim_func(s: [Byte], f: (Rune) -> Bool) -> [Byte] { trim_right_func(trim_left_func(s, f), f) }

pub def trim_left(s: [Byte], cutset: Str) -> [Byte] {
  return s if s.size == 0 || cutset.size == 0
  trim_left_func(s, ->(r: Rune) -> Bool { strings.index_rune(cutset, r) >= 0 })
}

pub def trim_right(s: [Byte], cutset: Str) -> [Byte] {
  return s if s.size == 0 || cutset.size == 0
  trim_right_func(s, ->(r: Rune) -> Bool { strings.index_rune(cutset, r) >= 0 })
}

pub def trim(s: [Byte], cutset: Str) -> [Byte] {
  return s if s.size == 0 || cutset.size == 0
  trim_right(trim_left(s, cutset), cutset)
}

pub def trim_prefix(s: [Byte], prefix: [Byte]) -> [Byte] {
  return s if !has_prefix(s, prefix)
  s[prefix.size...s.size]
}

pub def trim_suffix(s: [Byte], suffix: [Byte]) -> [Byte] {
  return s if !has_suffix(s, suffix)
  s[0...s.size - suffix.size]
}

# s without leading and trailing Unicode white space.
pub def trim_space(s: [Byte]) -> [Byte] {
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    break if !is_space_rune(v >> 3)
    i += v & 7
  }
  e = n
  while e > i {
    v = dec_last(s, e)
    break if !is_space_rune(v >> 3)
    e -= v & 7
  }
  s[i...e]
}
