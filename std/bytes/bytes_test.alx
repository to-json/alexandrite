def bs(xs: [Byte]) -> [Byte] { xs }
def cat(xs: [[Byte]]) -> [Byte] { join(xs, bs([])) }
def b(s: Str) -> [Byte] { s.bytes.to_a }
def s(x: [Byte]) -> Str { Str.from_bytes(x) }
def lst(xs: [[Byte]]) -> Str {
  parts: [Str] = []
  for x in xs { parts << s(x) }
  "#{xs.size}:" + parts.join("|")
}

test "clone is a copy" {
  a = b("hello")
  c = clone(a)
  assert equal(a, c)
  c[0] = 74
  assert_eq s(a), "hello"
  assert_eq s(c), "Jello"
  assert_eq clone(b("")).size, 0
}

test "equal / compare" {
  assert equal(b(""), b(""))
  assert equal(b("ab"), b("ab"))
  assert !equal(b("ab"), b("abc"))
  assert !equal(b("ab"), b("ac"))
  assert_eq compare(b("a"), b("b")), -1
  assert_eq compare(b("b"), b("a")), 1
  assert_eq compare(b("a"), b("a")), 0
  assert_eq compare(b("a"), b("ab")), -1
  assert_eq compare(b("ab"), b("a")), 1
  assert_eq compare(b(""), b("")), 0
  assert_eq compare(b(""), b("a")), -1
}

test "has_prefix / has_suffix" {
  assert has_prefix(b("hello"), b("he"))
  assert !has_prefix(b("hello"), b("lo"))
  assert has_prefix(b(""), b(""))
  assert !has_prefix(b("h"), b("hello"))
  assert has_suffix(b("hello"), b("llo"))
  assert !has_suffix(b("hello"), b("he"))
  assert has_suffix(b("x"), b(""))
  assert !has_suffix(b("o"), b("hello"))
}

test "index family" {
  assert_eq index(b("chicken"), b("ken")), 4
  assert_eq index(b("chicken"), b("dmr")), -1
  assert_eq index(b("abc"), b("")), 0
  assert_eq index(b(""), b("")), 0
  assert_eq index(b(""), b("a")), -1
  assert_eq index(b("aaab"), b("aab")), 1
  assert_eq index(b("a"), b("ab")), -1
  assert_eq last_index(b("go gopher"), b("go")), 3
  assert_eq last_index(b("go gopher"), b("rodent")), -1
  assert_eq last_index(b("abc"), b("")), 3
  assert_eq last_index(b("aaa"), b("aa")), 1
  assert_eq index_byte(b("golang"), 108), 2
  assert_eq index_byte(b("golang"), 120), -1
  assert_eq index_byte(b(""), 120), -1
  assert_eq last_index_byte(b("go gopher"), 111), 4
  assert_eq last_index_byte(b("go gopher"), 120), -1
  assert_eq index_rune(b("chicken"), 107), 4
  assert_eq index_rune(b("héllo"), 233), 1
  assert_eq index_rune(b("日本語"), 26412), 3
  assert_eq index_rune(cat([b("a"), bs([255]), b("b")]), 65533), 1
  assert_eq index_rune(b("abc"), 65533), -1
  assert_eq index_rune(b("abc"), -1), -1
  assert_eq index_rune(b("abc"), 55296), -1
  assert_eq index_rune(b(""), 97), -1
}

test "index_any / last_index_any" {
  assert_eq index_any(b("golang"), "ny"), 4
  assert_eq index_any(b("golang"), "xz"), -1
  assert_eq index_any(b("golang"), ""), -1
  assert_eq index_any(b(""), "a"), -1
  assert_eq index_any(b("héllo"), "éz"), 1
  assert_eq last_index_any(b("go gopher"), "go"), 4
  assert_eq last_index_any(b("go gopher"), "xz"), -1
  assert_eq last_index_any(b("go gopher"), ""), -1
  assert_eq last_index_any(b("héllo"), "é"), 1
  assert contains_any(b("abc"), "xc")
  assert !contains_any(b("abc"), "xy")
}

test "index_func / last_index_func / contains" {
  assert_eq index_func(b("Hello, 世界")) { |r| r > 127 }, 7
  assert_eq index_func(b("abc")) { |r| r == 120 }, -1
  assert_eq index_func(b("")) { |r| true }, -1
  assert_eq last_index_func(b("abc1def")) { |r| r >= 48 && r <= 57 }, 3
  assert_eq last_index_func(b("世界a")) { |r| r > 127 }, 3
  assert_eq last_index_func(b("")) { |r| true }, -1
  assert contains_func(b("abc")) { |r| r == 98 }
  assert !contains_func(b("abc")) { |r| r == 100 }
  assert contains(b("seafood"), b("foo"))
  assert !contains(b("seafood"), b("bar"))
  assert contains(b("seafood"), b(""))
  assert contains(b(""), b(""))
  assert contains_rune(b("héllo"), 233)
  assert !contains_rune(b("hello"), 233)
}

test "count" {
  assert_eq count(b("cheese"), b("e")), 3
  assert_eq count(b("five"), b("")), 5
  assert_eq count(b(""), b("")), 1
  assert_eq count(b("héé"), b("")), 4
  assert_eq count(b("aaaa"), b("aa")), 2
  assert_eq count(b("abc"), b("x")), 0
  assert_eq count(b(""), b("x")), 0
}

test "cut family" {
  r = cut(b("key=value"), b("="))
  assert r.present?
  before, after = r || (b(""), b(""))
  assert_eq s(before), "key"
  assert_eq s(after), "value"
  assert cut(b("novalue"), b("=")).none?
  e = cut(b("a="), b("=")) || (b("x"), b("x"))
  assert_eq e[0].size, 1
  assert_eq e[1].size, 0
  assert_eq s(cut_prefix(b("foobar"), b("foo")) || b("NO")), "bar"
  assert_eq s(cut_prefix(b("foobar"), b("bar")) || b("NO")), "NO"
  assert_eq s(cut_prefix(b("foo"), b("foo")) || b("NO")), ""
  assert_eq s(cut_suffix(b("foobar"), b("bar")) || b("NO")), "foo"
  assert_eq s(cut_suffix(b("foobar"), b("foo")) || b("NO")), "NO"
  assert_eq s(cut_suffix(b("x"), b("")) || b("NO")), "x"
}

test "equal_fold" {
  assert equal_fold(b("Go"), b("GO"))
  assert equal_fold(b("AB"), b("ab"))
  assert !equal_fold(b("foo"), b("bar"))
  assert equal_fold(b(""), b(""))
  assert !equal_fold(b("a"), b("ab"))
  assert equal_fold(b("Привет"), b("ПРИВЕТ"))
  assert equal_fold(b("Σ"), b("ς"))
}

test "split" {
  assert_eq lst(split(b("a,b,c"), b(","))), "3:a|b|c"
  assert_eq lst(split(b("a,,"), b(","))), "3:a||"
  assert_eq lst(split(b(""), b(","))), "1:"
  assert_eq lst(split(b("abc"), b(""))), "3:a|b|c"
  assert_eq lst(split(b("é日"), b(""))), "2:é|日"
  assert_eq lst(split(b(""), b(""))), "0:"
  assert_eq lst(split(b("abc"), b("x"))), "1:abc"
  assert_eq lst(split_after(b("a,b,c"), b(","))), "3:a,|b,|c"
  assert_eq lst(split_n(b("a,b,c,d"), b(","), 2)), "2:a|b,c,d"
  assert_eq lst(split_n(b("a,b,c,d"), b(","), 0)), "0:"
  assert_eq lst(split_n(b("a,b,c,d"), b(","), -1)), "4:a|b|c|d"
  assert_eq lst(split_n(b("abc"), b(""), 2)), "2:a|bc"
  assert_eq lst(split_after_n(b("a,b,c"), b(","), 2)), "2:a,|b,c"
  assert_eq lst(split_after(b("abc"), b(""))), "3:a|b|c"
  parts = split(b("x:y"), b(":"))
  assert_eq parts[1].size, 1
}

test "split pieces share storage but cannot clobber the neighbor" {
  src = b("ab,cd")
  parts = split(src, b(","))
  parts[0][0] = 90
  assert_eq s(src), "Zb,cd"
  first = parts[0]
  first << 33
  assert_eq s(src), "Zb,cd"
  assert_eq s(first), "Zb!"
}

test "fields" {
  assert_eq lst(fields(b("  foo bar  baz   "))), "3:foo|bar|baz"
  assert_eq lst(fields(b(""))), "0:"
  assert_eq lst(fields(b("   "))), "0:"
  assert_eq lst(fields(b("a"))), "1:a"
  assert_eq lst(fields(b("a\tb\nc"))), "3:a|b|c"
  assert_eq lst(fields(cat([b("a"), bs([0xC2, 0xA0]), b("b")]))), "2:a|b"
  assert_eq lst(fields_func(b("a1b22c")) { |r| r >= 48 && r <= 57 }), "3:a|b|c"
  assert_eq lst(fields_func(b("")) { |r| true }), "0:"
  assert_eq lst(fields_func(b("abc")) { |r| false }), "1:abc"
}

test "join" {
  assert_eq s(join([b("a"), b("b"), b("c")], b(", "))), "a, b, c"
  assert_eq s(join([b("a")], b(", "))), "a"
  assert_eq join([], b(",")).size, 0
  one = b("solo")
  j = join([one], b(","))
  j[0] = 83
  assert_eq s(one), "solo"
  assert_eq s(join([b(""), b("")], b("-"))), "-"
}

test "repeat" {
  assert_eq s(repeat(b("ab"), 3)), "ababab"
  assert_eq repeat(b("ab"), 0).size, 0
  assert_eq repeat(b(""), 5).size, 0
  src = b("x")
  r = repeat(src, 1)
  r[0] = 89
  assert_eq s(src), "x"
}

test "runes" {
  rs = runes(b("aé日"))
  assert_eq rs.size, 3
  assert_eq rs[0].to_i, 97
  assert_eq rs[1].to_i, 233
  assert_eq rs[2].to_i, 26085
  assert_eq runes(b("")).size, 0
  bad = runes(bs([255, 97]))
  assert_eq bad[0].to_i, 65533
  assert_eq bad[1].to_i, 97
}

test "replace" {
  assert_eq s(replace(b("oink oink oink"), b("k"), b("ky"), 2)), "oinky oinky oink"
  assert_eq s(replace(b("oink oink oink"), b("oink"), b("moo"), -1)), "moo moo moo"
  assert_eq s(replace_all(b("oink oink"), b("oink"), b("moo"))), "moo moo"
  assert_eq s(replace(b("abc"), b(""), b("-"), -1)), "-a-b-c-"
  assert_eq s(replace(b("abc"), b(""), b("-"), 2)), "-a-bc"
  assert_eq s(replace(b("é"), b(""), b("-"), -1)), "-é-"
  assert_eq s(replace(b("abc"), b("x"), b("y"), -1)), "abc"
  assert_eq s(replace(b("abc"), b("b"), b("y"), 0)), "abc"
  assert_eq s(replace(b("aaa"), b("a"), b(""), -1)), ""
  assert_eq s(replace(b(""), b(""), b("x"), -1)), "x"
}

test "replace always copies" {
  src = b("abc")
  r = replace(src, b("x"), b("y"), -1)
  r[0] = 90
  assert_eq s(src), "abc"
  r2 = replace(src, b("b"), b("b"), -1)
  r2[0] = 90
  assert_eq s(src), "abc"
}

test "map" {
  up = map(->(r: Rune) -> Rune { r >= 97 && r <= 122 ? r - 32 : r }, b("héllo"))
  assert_eq s(up), "HéLLO"
  drop = map(->(r: Rune) -> Rune { r == 108 ? -1 : r }, b("hello"))
  assert_eq s(drop), "heo"
  assert_eq map(->(r: Rune) -> Rune { r }, b("")).size, 0
  wide = map(->(r: Rune) -> Rune { 26085 }, b("ab"))
  assert_eq s(wide), "日日"
}

test "to_valid_utf8" {
  assert_eq s(to_valid_utf8(cat([b("a"), bs([255, 254]), b("b")]), b("?"))), "a?b"
  assert_eq s(to_valid_utf8(cat([b("a"), bs([255]), b("b"), bs([254])]), b("?"))), "a?b?"
  assert_eq s(to_valid_utf8(b("ok"), b("?"))), "ok"
  assert_eq to_valid_utf8(b(""), b("?")).size, 0
  assert_eq s(to_valid_utf8(bs([255]), b(""))), ""
  src = b("ok")
  c = to_valid_utf8(src, b("?"))
  c[0] = 48
  assert_eq s(src), "ok"
}

test "case" {
  assert_eq s(to_upper(b("hello, Wörld"))), "HELLO, WÖRLD"
  assert_eq s(to_lower(b("HELLO, WÖRLD"))), "hello, wörld"
  assert_eq to_upper(b("")).size, 0
  assert_eq s(to_lower(to_upper(b("Привет")))), "привет"
  assert_eq s(to_upper(cat([b("a"), bs([255])]))), "A\uFFFD" # Go: invalid UTF-8 maps to U+FFFD
  src = b("abc")
  u = to_upper(b("ABC"))
  u[0] = 48
  l = to_lower(src)
  l[0] = 48
  assert_eq s(src), "abc"
}

test "trim" {
  assert_eq s(trim(b("¡¡¡Hello, Gophers!!!"), "!¡")), "Hello, Gophers"
  assert_eq s(trim_left(b("xxhixx"), "x")), "hixx"
  assert_eq s(trim_right(b("xxhixx"), "x")), "xxhi"
  assert_eq s(trim(b("hi"), "")), "hi"
  assert_eq s(trim(b(""), "x")), ""
  assert_eq s(trim(b("xxx"), "x")), ""
  assert_eq s(trim(b("éaé"), "é")), "a"
  assert_eq s(trim_func(b("123abc456")) { |r| r >= 48 && r <= 57 }), "abc"
  assert_eq s(trim_left_func(b("123abc456")) { |r| r >= 48 && r <= 57 }), "abc456"
  assert_eq s(trim_right_func(b("123abc456")) { |r| r >= 48 && r <= 57 }), "123abc"
  assert_eq s(trim_func(b("")) { |r| true }), ""
  assert_eq s(trim_prefix(b("foobar"), b("foo"))), "bar"
  assert_eq s(trim_prefix(b("foobar"), b("bar"))), "foobar"
  assert_eq s(trim_suffix(b("foobar"), b("bar"))), "foo"
  assert_eq s(trim_suffix(b("foobar"), b("foo"))), "foobar"
  assert_eq s(trim_suffix(b("foo"), b(""))), "foo"
}

test "trim_space" {
  assert_eq s(trim_space(b("  \t hi there \n "))), "hi there"
  assert_eq trim_space(b("")).size, 0
  assert_eq trim_space(b("   ")).size, 0
  assert_eq s(trim_space(b("x"))), "x"
  assert_eq s(trim_space(cat([bs([0xC2, 0xA0]), b("x"), bs([0xE3, 0x80, 0x80])]))), "x"
  assert_eq s(trim_space(b(" é "))), "é"
}

test "trims are subslices" {
  src = b("  hi  ")
  t = trim_space(src)
  t[0] = 72
  assert_eq s(src), "  Hi  "
  t << 33
  assert_eq s(src), "  Hi  "
}

test "Buffer write and read back" {
  bf = Buffer.new
  assert_eq bf.size, 0
  assert_eq bf.write!(b("hello")), 5
  assert_eq bf.write_string!(", world"), 7
  bf.write_byte!(33)
  assert_eq bf.write_rune!(233), 2
  assert_eq bf.write_rune!(26085), 3
  assert_eq bf.write_rune!(128512), 4
  assert_eq bf.write_rune!(-1), 3
  assert_eq bf.size, 13 + 2 + 3 + 4 + 3
  assert_eq bf.len, bf.size
  assert_eq bf.to_s, "hello, world!é日😀\uFFFD"
  assert_eq bf.string, bf.to_s
  assert_eq s(bf.bytes), bf.to_s
  assert bf.cap >= bf.size
}

test "Buffer read!" {
  bf = new_buffer_string("hello world")
  p: [Byte] = [0.as_u8; 5]
  assert_eq bf.read!(p), 5
  assert_eq s(p), "hello"
  assert_eq bf.size, 6
  assert_eq bf.read!(bs([])), 0
  q: [Byte] = [0.as_u8; 100]
  assert_eq bf.read!(q), 6
  assert_eq s(q[0...6]), " world"
  assert_eq bf.size, 0
  assert_eq bf.read!(q), 0
  bf.write_string!("again")
  assert_eq bf.read!(p), 5
  assert_eq s(p), "again"
}

test "Buffer read_byte! read_rune!" {
  bf = new_buffer_string("aé日")
  assert_eq bf.read_byte! || 0, 97
  r = bf.read_rune! || (0.as_i32, 0)
  assert_eq r[0].to_i, 233
  assert_eq r[1], 2
  r2 = bf.read_rune! || (0.as_i32, 0)
  assert_eq r2[0].to_i, 26085
  assert_eq r2[1], 3
  assert bf.read_rune!.none?
  assert bf.read_byte!.none?
  bad = new_buffer(bs([255, 97]))
  r3 = bad.read_rune! || (0.as_i32, 0)
  assert_eq r3[0].to_i, 65533
  assert_eq r3[1], 1
  assert_eq bad.size, 1
}

test "Buffer read_string! read_bytes!" {
  bf = new_buffer_string("one\ntwo\nthree")
  assert_eq bf.read_string!(10) || "NO", "one\n"
  assert_eq s(bf.read_bytes!(10) || b("NO")), "two\n"
  assert_eq bf.read_string!(10) || "NO", "three"
  assert bf.read_string!(10).none?
  assert bf.read_bytes!(10).none?
  empty = Buffer.new
  assert empty.read_string!(10).none?
  src = new_buffer_string("ab\ncd")
  chunk = src.read_bytes!(10) || b("")
  chunk[0] = 90
  assert_eq src.to_s, "cd"
}

test "Buffer next! truncate! reset! grow!" {
  bf = new_buffer_string("abcdef")
  assert_eq s(bf.next!(2)), "ab"
  assert_eq bf.to_s, "cdef"
  assert_eq s(bf.next!(100)), "cdef"
  assert_eq bf.size, 0
  assert_eq bf.next!(3).size, 0
  bf.write_string!("0123456789")
  bf.next!(3)
  bf.truncate!(4)
  assert_eq bf.to_s, "3456"
  bf.truncate!(4)
  assert_eq bf.to_s, "3456"
  bf.write_string!("x")
  assert_eq bf.to_s, "3456x"
  bf.truncate!(0)
  assert_eq bf.size, 0
  bf.grow!(100)
  bf.write_string!("hi")
  assert_eq bf.to_s, "hi"
  bf.reset!
  assert_eq bf.size, 0
  assert_eq bf.to_s, ""
  assert bf.read_byte!.none?
}

test "Buffer from slices copies" {
  src = b("abc")
  bf = new_buffer(src)
  src[0] = 90
  assert_eq bf.to_s, "abc"
  bf.write!(src)
  assert_eq bf.to_s, "abcZbc"
  bf.write!(bf.bytes)
  assert_eq bf.to_s, "abcZbcabcZbc"
}

test "Buffer round trip" {
  bf = Buffer.new
  for i in 0...200 {
    bf.write_string!("line #{i}\n")
  }
  total = 0
  n = 0
  loop {
    line = bf.read_string!(10)
    break if line.none?
    total += (line || "").size
    n += 1
  }
  assert_eq n, 200
  assert_eq bf.size, 0
  assert_eq total, 1690
}

def fill_buffer(b: Buffer) {
  x = b
  x.write_string!("hello, ")
  x.write_byte!(119)
  x.write_rune!(0x6F.as_i32)
}

def take_one(b: Buffer) -> Str {
  x = b
  out = x.read_string!(44)
  out || ""
}

test "Buffer copies share state" {
  bf = new_buffer([])
  fill_buffer(bf)
  assert_eq bf.string, "hello, wo"
  assert_eq bf.size, 9
  # A callee's reads advance ours.
  assert_eq take_one(bf), "hello,"
  assert_eq bf.string, " wo"
  cp = bf
  assert_eq cp.read_byte!.unwrap, 32
  assert_eq bf.size, 2
  cp.reset!
  assert_eq bf.size, 0
}

test "Buffers held in a slice share state" {
  bf = new_buffer_string("abc")
  holder = [bf, bf]
  holder[0].write_string!("def")
  assert_eq bf.string, "abcdef"
  assert_eq holder[1].size, 6
}

test "zero-value Buffer is empty, then shared once written" {
  z = Buffer.new
  assert_eq z.size, 0
  assert_eq z.string, ""
  assert z.read_byte!.none?
  z.reset!
  z.truncate!(0)
  z.write_string!("a")
  cp = z
  cp.write_string!("b")
  assert_eq z.string, "ab"
}
