#![test(external)]
# Go's example_test.go, translated. ExampleCompare and ExampleCompare_search
# print nothing (they show idioms); ExampleBuffer_Cap's second buffer needs a
# slice with spare capacity (D6): not translated.

import "bytes"
import "encoding/base64"
import "fmt"
import "io"
import "os"
import "strconv"
import "unicode"

def qs(vs: [[Byte]]) -> Str { "[" + vs.map { q(it) }.to_a.join(" ") + "]" }
def put_bytes(v: [Byte]) { print Str.from_bytes(v) }

example "Buffer" {
  bf = bytes.new_buffer([])
  bf.write!(b("Hello "))
  fmt.fprintf(bf, "world!").unwrap
  bf.write_to!(os.stdout).unwrap
} outputs "Hello world!"

example "Buffer_reader" {
  # A Buffer can turn a string or a [Byte] into an io.Reader.
  buf = bytes.new_buffer_string("R29waGVycyBydWxlIQ==")
  dec = base64.new_decoder(base64.std_encoding, buf)
  io.copy(os.stdout, dec).unwrap
} outputs "Gophers rule!"

example "Buffer_Bytes" {
  buf = bytes.Buffer.new
  buf.write!([104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100])
  put_bytes(buf.bytes)
} outputs "hello world"

example "Buffer_AvailableBuffer" {
  buf = bytes.Buffer.new
  for i in 0...4 {
    bb = buf.available_buffer + b(strconv.itoa(i))
    bb << 32
    buf.write!(bb)
  }
  put_bytes(buf.bytes)
} outputs "0 1 2 3 "

example "Buffer_Cap" {
  zeros: [Byte] = [0; 10]
  puts bytes.new_buffer(zeros).cap
} outputs "10\n"

example "Buffer_Grow" {
  bf = bytes.Buffer.new
  bf.grow!(64)
  bf.write!(b("64 bytes or fewer"))
  print q(bf.bytes)
} outputs "\"64 bytes or fewer\""

example "Buffer_Len" {
  bf = bytes.Buffer.new
  bf.grow!(64)
  bf.write!(b("abcde"))
  print bf.len
} outputs "5"

example "Buffer_Next" {
  bf = bytes.Buffer.new
  bf.grow!(64)
  bf.write!(b("abcde"))
  puts Str.from_bytes(bf.next!(2))
  puts Str.from_bytes(bf.next!(2))
  print Str.from_bytes(bf.next!(2))
} outputs "ab\ncd\ne"

example "Buffer_Read" {
  bf = bytes.Buffer.new
  bf.grow!(64)
  bf.write!(b("abcde"))
  rdbuf: [Byte] = [0]
  n = bf.read!(rdbuf)
  puts n
  puts bf.string
  puts Str.from_bytes(rdbuf)
} outputs "1\nbcde\na\n"

example "Buffer_ReadByte" {
  bf = bytes.Buffer.new
  bf.grow!(64)
  bf.write!(b("abcde"))
  c = bf.read_byte!.unwrap
  puts c
  puts bf.string
} outputs "97\nbcde\n"

example "Clone" {
  bb = b("abc")
  clone = bytes.clone(bb)
  puts Str.from_bytes(clone)
  clone[0] = 100
  puts Str.from_bytes(bb)
  puts Str.from_bytes(clone)
} outputs "abc\nabc\ndbc\n"

example "Contains" {
  puts bytes.contains(b("seafood"), b("foo"))
  puts bytes.contains(b("seafood"), b("bar"))
  puts bytes.contains(b("seafood"), b(""))
  puts bytes.contains(b(""), b(""))
} outputs "true\nfalse\ntrue\ntrue\n"

example "ContainsAny" {
  puts bytes.contains_any(b("I like seafood."), "fÄo!")
  puts bytes.contains_any(b("I like seafood."), "去是伟大的.")
  puts bytes.contains_any(b("I like seafood."), "")
  puts bytes.contains_any(b(""), "")
} outputs "true\ntrue\nfalse\nfalse\n"

example "ContainsRune" {
  puts bytes.contains_rune(b("I like seafood."), 0x66)
  puts bytes.contains_rune(b("I like seafood."), 0xF6)
  puts bytes.contains_rune(b("去是伟大的!"), 0x5927)
  puts bytes.contains_rune(b("去是伟大的!"), 0x21)
  puts bytes.contains_rune(b(""), 0x40)
} outputs "true\nfalse\ntrue\ntrue\nfalse\n"

example "ContainsFunc" {
  f = ->(r: Rune) -> Bool { r >= 0x61 && r <= 0x7A }
  puts bytes.contains_func(b("HELLO"), f)
  puts bytes.contains_func(b("World"), f)
} outputs "false\ntrue\n"

example "Count" {
  puts bytes.count(b("cheese"), b("e"))
  puts bytes.count(b("five"), b("")) # before & after each rune
} outputs "3\n5\n"

def show_cut(s: Str, sep: Str) {
  r = bytes.cut(b(s), b(sep))
  before, after, found = (s, "", false)
  if p = r { before, after, found = (Str.from_bytes(p[0]), Str.from_bytes(p[1]), true) }
  puts "Cut(#{strconv.quote(s)}, #{strconv.quote(sep)}) = #{strconv.quote(before)}, #{strconv.quote(after)}, #{found}"
}

example "Cut" {
  show_cut("Gopher", "Go")
  show_cut("Gopher", "ph")
  show_cut("Gopher", "er")
  show_cut("Gopher", "Badger")
} outputs <<~EOS
  Cut("Gopher", "Go") = "", "pher", true
  Cut("Gopher", "ph") = "Go", "er", true
  Cut("Gopher", "er") = "Goph", "", true
  Cut("Gopher", "Badger") = "Gopher", "", false
EOS

example "CutPrefix" {
  for tc in [("Gopher", "Go"), ("Gopher", "ph")] {
    s = tc[0]
    prefix = tc[1]
    r = bytes.cut_prefix(b(s), b(prefix))
    puts "CutPrefix(#{strconv.quote(s)}, #{strconv.quote(prefix)}) = #{q(r || b(s))}, #{r.some?}"
  }
} outputs "CutPrefix(\"Gopher\", \"Go\") = \"pher\", true\nCutPrefix(\"Gopher\", \"ph\") = \"Gopher\", false\n"

example "CutSuffix" {
  for tc in [("Gopher", "Go"), ("Gopher", "er")] {
    s = tc[0]
    suffix = tc[1]
    r = bytes.cut_suffix(b(s), b(suffix))
    puts "CutSuffix(#{strconv.quote(s)}, #{strconv.quote(suffix)}) = #{q(r || b(s))}, #{r.some?}"
  }
} outputs "CutSuffix(\"Gopher\", \"Go\") = \"Gopher\", false\nCutSuffix(\"Gopher\", \"er\") = \"Goph\", true\n"

example "Equal" {
  puts bytes.equal(b("Go"), b("Go"))
  puts bytes.equal(b("Go"), b("C++"))
} outputs "true\nfalse\n"

example "EqualFold" {
  puts bytes.equal_fold(b("Go"), b("go"))
} outputs "true\n"

example "Fields" {
  print "Fields are: #{qs(bytes.fields(b("  foo bar  baz   ")))}"
} outputs "Fields are: [\"foo\" \"bar\" \"baz\"]"

example "FieldsFunc" {
  f = ->(c: Rune) -> Bool { !unicode.is_letter(c) && !unicode.is_number(c) }
  print "Fields are: #{qs(bytes.fields_func(b("  foo1;bar2,baz3..."), f))}"
} outputs "Fields are: [\"foo1\" \"bar2\" \"baz3\"]"

example "HasPrefix" {
  puts bytes.has_prefix(b("Gopher"), b("Go"))
  puts bytes.has_prefix(b("Gopher"), b("C"))
  puts bytes.has_prefix(b("Gopher"), b(""))
} outputs "true\nfalse\ntrue\n"

example "HasSuffix" {
  puts bytes.has_suffix(b("Amigo"), b("go"))
  puts bytes.has_suffix(b("Amigo"), b("O"))
  puts bytes.has_suffix(b("Amigo"), b("Ami"))
  puts bytes.has_suffix(b("Amigo"), b(""))
} outputs "true\nfalse\nfalse\ntrue\n"

example "Index" {
  puts bytes.index(b("chicken"), b("ken"))
  puts bytes.index(b("chicken"), b("dmr"))
} outputs "4\n-1\n"

example "IndexByte" {
  puts bytes.index_byte(b("chicken"), 0x6B)
  puts bytes.index_byte(b("chicken"), 0x67)
} outputs "4\n-1\n"

example "IndexFunc" {
  han = unicode.script("Han").unwrap
  f = ->(c: Rune) -> Bool { unicode.is(han, c) }
  puts bytes.index_func(b("Hello, 世界"), f)
  puts bytes.index_func(b("Hello, world"), f)
} outputs "7\n-1\n"

example "IndexAny" {
  puts bytes.index_any(b("chicken"), "aeiouy")
  puts bytes.index_any(b("crwth"), "aeiouy")
} outputs "2\n-1\n"

example "IndexRune" {
  puts bytes.index_rune(b("chicken"), 0x6B)
  puts bytes.index_rune(b("chicken"), 0x64)
} outputs "4\n-1\n"

example "Join" {
  s = [b("foo"), b("bar"), b("baz")]
  put_bytes(bytes.join(s, b(", ")))
} outputs "foo, bar, baz"

example "LastIndex" {
  puts bytes.index(b("go gopher"), b("go"))
  puts bytes.last_index(b("go gopher"), b("go"))
  puts bytes.last_index(b("go gopher"), b("rodent"))
} outputs "0\n3\n-1\n"

example "LastIndexAny" {
  puts bytes.last_index_any(b("go gopher"), "MüQp")
  puts bytes.last_index_any(b("go 地鼠"), "地大")
  puts bytes.last_index_any(b("go gopher"), "z,!.")
} outputs "5\n3\n-1\n"

example "LastIndexByte" {
  puts bytes.last_index_byte(b("go gopher"), 0x67)
  puts bytes.last_index_byte(b("go gopher"), 0x72)
  puts bytes.last_index_byte(b("go gopher"), 0x7A)
} outputs "3\n8\n-1\n"

example "LastIndexFunc" {
  puts bytes.last_index_func(b("go gopher!"), ->(r: Rune) -> Bool { unicode.is_letter(r) })
  puts bytes.last_index_func(b("go gopher!"), ->(r: Rune) -> Bool { unicode.is_punct(r) })
  puts bytes.last_index_func(b("go gopher!"), ->(r: Rune) -> Bool { unicode.is_number(r) })
} outputs "8\n9\n-1\n"

example "Map" {
  rot13 = ->(r: Rune) -> Rune {
    return 0x41 + (r - 0x41 + 13) % 26 if r >= 0x41 && r <= 0x5A
    return 0x61 + (r - 0x61 + 13) % 26 if r >= 0x61 && r <= 0x7A
    r
  }
  puts Str.from_bytes(bytes.map(rot13, b("'Twas brillig and the slithy gopher...")))
} outputs "'Gjnf oevyyvt naq gur fyvgul tbcure...\n"

example "Reader_Len" {
  puts bytes.new_reader(b("Hi!")).len
  puts bytes.new_reader(b("こんにちは!")).len
} outputs "3\n16\n"

example "Repeat" {
  print "ba#{Str.from_bytes(bytes.repeat(b("na"), 2))}"
} outputs "banana"

example "Replace" {
  puts Str.from_bytes(bytes.replace(b("oink oink oink"), b("k"), b("ky"), 2))
  puts Str.from_bytes(bytes.replace(b("oink oink oink"), b("oink"), b("moo"), -1))
} outputs "oinky oinky oink\nmoo moo moo\n"

example "ReplaceAll" {
  puts Str.from_bytes(bytes.replace_all(b("oink oink oink"), b("oink"), b("moo")))
} outputs "moo moo moo\n"

example "Runes" {
  for r in bytes.runes(b("go gopher")) {
    puts fmt.sprintf("%#U", r)
  }
} outputs <<~EOS
  U+0067 'g'
  U+006F 'o'
  U+0020 ' '
  U+0067 'g'
  U+006F 'o'
  U+0070 'p'
  U+0068 'h'
  U+0065 'e'
  U+0072 'r'
EOS

example "Split" {
  puts qs(bytes.split(b("a,b,c"), b(",")))
  puts qs(bytes.split(b("a man a plan a canal panama"), b("a ")))
  puts qs(bytes.split(b(" xyz "), b("")))
  puts qs(bytes.split(b(""), b("Bernardo O'Higgins")))
} outputs <<~'EOS'
  ["a" "b" "c"]
  ["" "man " "plan " "canal panama"]
  [" " "x" "y" "z" " "]
  [""]
EOS

example "SplitN" {
  puts qs(bytes.split_n(b("a,b,c"), b(","), 2))
  z = bytes.split_n(b("a,b,c"), b(","), 0)
  puts "#{qs(z)} (empty = #{z.size == 0})"
} outputs "[\"a\" \"b,c\"]\n[] (empty = true)\n"

example "SplitAfter" {
  puts qs(bytes.split_after(b("a,b,c"), b(",")))
} outputs "[\"a,\" \"b,\" \"c\"]\n"

example "SplitAfterN" {
  puts qs(bytes.split_after_n(b("a,b,c"), b(","), 2))
} outputs "[\"a,\" \"b,c\"]\n"

example "Title" {
  print Str.from_bytes(bytes.title(b("her royal highness")))
} outputs "Her Royal Highness"

example "ToTitle" {
  puts Str.from_bytes(bytes.to_title(b("loud noises")))
  puts Str.from_bytes(bytes.to_title(b("брат")))
} outputs "LOUD NOISES\nБРАТ\n"

example "ToValidUTF8" {
  puts Str.from_bytes(bytes.to_valid_utf8(b("abc"), b("�")))
  puts Str.from_bytes(bytes.to_valid_utf8([0x61, 0xff, 0x62, 0xC0, 0xAF, 0x63, 0xff], b("")))
  puts Str.from_bytes(bytes.to_valid_utf8([0xed, 0xa0, 0x80], b("abc")))
} outputs "abc\nabc\nabc\n"

example "Trim" {
  print "[#{q(bytes.trim(b(" !!! Achtung! Achtung! !!! "), "! "))}]"
} outputs "[\"Achtung! Achtung\"]"

example "TrimFunc" {
  letter = ->(r: Rune) -> Bool { unicode.is_letter(r) }
  punct = ->(r: Rune) -> Bool { unicode.is_punct(r) }
  number = ->(r: Rune) -> Bool { unicode.is_number(r) }
  puts Str.from_bytes(bytes.trim_func(b("go-gopher!"), letter))
  puts Str.from_bytes(bytes.trim_func(b("\"go-gopher!\""), letter))
  puts Str.from_bytes(bytes.trim_func(b("go-gopher!"), punct))
  puts Str.from_bytes(bytes.trim_func(b("1234go-gopher!567"), number))
} outputs "-gopher!\n\"go-gopher!\"\ngo-gopher\ngo-gopher!\n"

example "TrimLeft" {
  print Str.from_bytes(bytes.trim_left(b("453gopher8257"), "0123456789"))
} outputs "gopher8257"

example "TrimLeftFunc" {
  puts Str.from_bytes(bytes.trim_left_func(b("go-gopher"), ->(r: Rune) -> Bool { unicode.is_letter(r) }))
  puts Str.from_bytes(bytes.trim_left_func(b("go-gopher!"), ->(r: Rune) -> Bool { unicode.is_punct(r) }))
  puts Str.from_bytes(bytes.trim_left_func(b("1234go-gopher!567"), ->(r: Rune) -> Bool { unicode.is_number(r) }))
} outputs "-gopher\ngo-gopher!\ngo-gopher!567\n"

example "TrimPrefix" {
  bb = b("Goodbye,, world!")
  bb = bytes.trim_prefix(bb, b("Goodbye,"))
  bb = bytes.trim_prefix(bb, b("See ya,"))
  print "Hello#{Str.from_bytes(bb)}"
} outputs "Hello, world!"

example "TrimSpace" {
  print Str.from_bytes(bytes.trim_space(b(" \t\n a lone gopher \n\t\r\n")))
} outputs "a lone gopher"

example "TrimSuffix" {
  bb = b("Hello, goodbye, etc!")
  bb = bytes.trim_suffix(bb, b("goodbye, etc!"))
  bb = bytes.trim_suffix(bb, b("gopher"))
  bb = bb + bytes.trim_suffix(b("world!"), b("x!"))
  put_bytes(bb)
} outputs "Hello, world!"

example "TrimRight" {
  print Str.from_bytes(bytes.trim_right(b("453gopher8257"), "0123456789"))
} outputs "453gopher"

example "TrimRightFunc" {
  puts Str.from_bytes(bytes.trim_right_func(b("go-gopher"), ->(r: Rune) -> Bool { unicode.is_letter(r) }))
  puts Str.from_bytes(bytes.trim_right_func(b("go-gopher!"), ->(r: Rune) -> Bool { unicode.is_punct(r) }))
  puts Str.from_bytes(bytes.trim_right_func(b("1234go-gopher!567"), ->(r: Rune) -> Bool { unicode.is_number(r) }))
} outputs "go-\ngo-gopher\n1234go-gopher!\n"

example "ToLower" {
  print Str.from_bytes(bytes.to_lower(b("Gopher")))
} outputs "gopher"

example "ToUpper" {
  print Str.from_bytes(bytes.to_upper(b("Gopher")))
} outputs "GOPHER"

example "Lines" {
  for line in bytes.lines(b("Hello\nWorld\nGo Programming\n")) {
    puts q(line)
  }
} outputs "\"Hello\\n\"\n\"World\\n\"\n\"Go Programming\\n\"\n"

example "SplitSeq" {
  for part in bytes.split_seq(b("a,b,c,d"), b(",")) { puts q(part) }
} outputs "\"a\"\n\"b\"\n\"c\"\n\"d\"\n"

example "SplitAfterSeq" {
  for part in bytes.split_after_seq(b("a,b,c,d"), b(",")) { puts q(part) }
} outputs "\"a,\"\n\"b,\"\n\"c,\"\n\"d\"\n"

example "FieldsSeq" {
  puts "Split byte slice into fields:"
  for word in bytes.fields_seq(b("The quick brown fox")) { puts q(word) }
  puts "\nSplit byte slice with multiple spaces:"
  for word in bytes.fields_seq(b("  lots   of   spaces  ")) { puts q(word) }
} outputs <<~'EOS'
  Split byte slice into fields:
  "The"
  "quick"
  "brown"
  "fox"

  Split byte slice with multiple spaces:
  "lots"
  "of"
  "spaces"
EOS

example "FieldsFuncSeq" {
  puts "Split on whitespace(similar to FieldsSeq):"
  for word in bytes.fields_func_seq(b("The quick brown fox"), ->(r: Rune) -> Bool { unicode.is_space(r) }) { puts q(word) }
  puts "\nSplit on digits:"
  for word in bytes.fields_func_seq(b("abc123def456ghi"), ->(r: Rune) -> Bool { unicode.is_digit(r) }) { puts q(word) }
} outputs <<~'EOS'
  Split on whitespace(similar to FieldsSeq):
  "The"
  "quick"
  "brown"
  "fox"

  Split on digits:
  "abc"
  "def"
  "ghi"
EOS

example "ToTitleSpecial" {
  str = "ahoj vývojári golang".bytes
  totitle = bytes.to_title_special(unicode.azeri_case, str)
  puts "Original : " + Str.from_bytes(str)
  puts "ToTitle : " + Str.from_bytes(totitle)
} outputs "Original : ahoj vývojári golang\nToTitle : AHOJ VÝVOJÁRİ GOLANG\n"

example "ToLowerSpecial" {
  str = "AHOJ VÝVOJÁRİ GOLANG".bytes
  totitle = bytes.to_lower_special(unicode.azeri_case, str)
  puts "Original : " + Str.from_bytes(str)
  puts "ToLower : " + Str.from_bytes(totitle)
} outputs "Original : AHOJ VÝVOJÁRİ GOLANG\nToLower : ahoj vývojári golang\n"

example "ToUpperSpecial" {
  str = "ahoj vývojári golang".bytes
  totitle = bytes.to_upper_special(unicode.azeri_case, str)
  puts "Original : " + Str.from_bytes(str)
  puts "ToUpper : " + Str.from_bytes(totitle)
} outputs "Original : ahoj vývojári golang\nToUpper : AHOJ VÝVOJÁRİ GOLANG\n"
