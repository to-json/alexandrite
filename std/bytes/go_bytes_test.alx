test "Clone" {
  inputs = [[], bytes.clone([]), b("short"), rb(0x61, 42), rb(0x61, 42)[0...0]]
  for input in inputs {
    c = bytes.clone(input)
    assert bytes.equal(c, input), "clone(#{q(input)})"
    if c.size > 0 {
      first = input[0]
      c[0] = 0
      check(input[0], first, "clone shares the input's storage")
    }
  }
}

# ------------------------------------------------------------- compare_test.go

test "Compare" {
  for tc in compare_tests {
    num_shifts = 16
    buffer: [Byte] = [0; tc[1].size + num_shifts]
    # Vary the offset of tc[1].
    for offset in 0..num_shifts {
      shifted = buffer[offset...tc[1].size + offset]
      copy(shifted, tc[1])
      check(bytes.compare(tc[0], shifted), tc[2], "compare(#{q(tc[0])}, #{q(tc[1])}), offset #{offset}")
    }
  }
}

test "CompareIdenticalSlice" {
  bb = b("Hello Gophers!")
  assert_eq bytes.compare(bb, bb), 0
  assert_eq bytes.compare(bb, bb[0...1]), 1
}

test "CompareBytes" {
  lengths = (0..128).to_a + [256, 512, 1024, 1333, 4095, 4096, 4097]
  n = lengths[lengths.size - 1]
  a: [Byte] = [0; n + 1]
  bb: [Byte] = [0; n + 1]
  for len in lengths {
    # Randomish but deterministic data, no 0 or 255.
    for i in 0...len {
      a[i] = (1 + 31 * i % 254).as_u8
      bb[i] = (1 + 31 * i % 254).as_u8
    }
    # The data past the end differs.
    for i in len..n {
      a[i] = 8
      bb[i] = 9
    }
    check(bytes.compare(a[0...len], bb[0...len]), 0, "CompareIdentical(#{len})")
    if len > 0 {
      check(bytes.compare(a[0...len - 1], bb[0...len]), -1, "CompareAshorter(#{len})")
      check(bytes.compare(a[0...len], bb[0...len - 1]), 1, "CompareBshorter(#{len})")
    }
    for k in 0...len {
      bb[k] = a[k] - 1
      check(bytes.compare(a[0...len], bb[0...len]), 1, "CompareAbigger(#{len},#{k})")
      bb[k] = a[k] + 1
      check(bytes.compare(a[0...len], bb[0...len]), -1, "CompareBbigger(#{len},#{k})")
      bb[k] = a[k]
    }
  }
}

test "EndianBaseCompare" {
  max_length = 512
  a: [Byte] = [0; max_length]
  bb: [Byte] = [0; max_length]
  for i in 0...max_length {
    a[i] = (1 + 31 * i % 254).as_u8
    bb[i] = (1 + 31 * i % 254).as_u8
  }
  i = 2
  while i <= max_length {
    for j in 0...i - 1 {
      a[j] = bb[j] - 1
      a[j + 1] = bb[j + 1] + 1
      check(bytes.compare(a[0...i], bb[0...i]), -1, "CompareBbigger(#{i},#{j})")
      a[j] = bb[j] + 1
      a[j + 1] = bb[j + 1] - 1
      check(bytes.compare(a[0...i], bb[0...i]), 1, "CompareAbigger(#{i},#{j})")
      a[j] = bb[j]
      a[j + 1] = bb[j + 1]
    }
    i <<= 1
  }
}
