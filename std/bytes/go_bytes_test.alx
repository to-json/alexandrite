# golang.org/issue/16237
test "RepeatCatchesOverflow" {
  max_int = 0x7FFF_FFFF_FFFF_FFFF
  assert_panics("negative") { bytes.repeat(b("--"), -2147483647) }
  assert_eq bytes.repeat([], max_int).size, 0
  assert_eq bytes.repeat(b("-"), 10).size, 10
  assert_eq bytes.repeat(b("gopher"), 0).size, 0
  assert_panics("negative") { bytes.repeat(b("-"), -1) }
  assert_panics("negative") { bytes.repeat(b("--"), -102) }
  assert_panics("overflow") { bytes.repeat(rb(0, 255), 0xFFFF_FFFF_FFFF_FFFF / 255 + 1) }
  assert_panics("out of range") { bytes.repeat(b("-"), max_int) }
}

test "Runes" {
  for tc in runes_tests {
    a = bytes.runes(tc[0])
    check(a, tc[1], "runes(#{q(tc[0])})")
    assert_eq runes_str(a), s(tc[0]) if !tc[2]
  }
}

# ------------------------------------------------------------- trimming

def trim_by(name: Str, input: [Byte], arg: Str) -> [Byte] {
  case name {
    "Trim" => bytes.trim(input, arg)
    "TrimLeft" => bytes.trim_left(input, arg)
    "TrimRight" => bytes.trim_right(input, arg)
    "TrimPrefix" => bytes.trim_prefix(input, b(arg))
    "TrimSuffix" => bytes.trim_suffix(input, b(arg))
    _ => panic("undefined trim function #{name}")
  }
}

test "Trim" {
  for tc in trim_tests {
    check(s(trim_by(tc[0], tc[1], tc[2])), s(tc[3]), "#{tc[0]}(#{q(tc[1])}, #{strconv.quote(tc[2])})")
  }
  for tc in trim_nil_tests {
    check(trim_by(tc[0], tc[1], tc[2]).size, 0, "#{tc[0]}(#{q(tc[1])}, #{strconv.quote(tc[2])}) returned non-empty value")
  }
}

test "TrimFunc" {
  for tc in trim_func_tests {
    name = tc[0]
    f = ->(r: Rune) -> Bool { holds(name, r) }
    check(s(bytes.trim_func(tc[1], f)), s(tc[2]), "trim_func(#{q(tc[1])}, #{name})")
    check(s(bytes.trim_left_func(tc[1], f)), s(tc[3]), "trim_left_func(#{q(tc[1])}, #{name})")
    check(s(bytes.trim_right_func(tc[1], f)), s(tc[4]), "trim_right_func(#{q(tc[1])}, #{name})")
  }
}

test "IndexFunc" {
  for tc in index_func_tests {
    name = tc[1]
    f = ->(r: Rune) -> Bool { holds(name, r) }
    check(bytes.index_func(tc[0], f), tc[2], "index_func(#{q(tc[0])}, #{name})")
    check(bytes.last_index_func(tc[0], f), tc[3], "last_index_func(#{q(tc[0])}, #{name})")
  }
}

# ------------------------------------------------------------- replacing

test "Replace" {
  for tc in replace_tests {
    input = tc[0]
    out = bytes.replace(input, tc[1], tc[2], tc[3])
    check(s(out), tc[4], "replace(#{q(input)}, #{q(tc[1])}, #{q(tc[2])}, #{tc[3]})")
    # Replace copies.
    if out.size > 0 && input.size > 0 {
      first = input[0]
      out[0] = out[0] +% 1
      check(input[0], first, "replace didn't copy")
    }
    assert_eq s(bytes.replace_all(input, tc[1], tc[2])), tc[4] if tc[3] == -1
  }
}

# FuzzReplace's other implementation, run on its seed corpus.
def replace_other(input: [Byte], old: [Byte], new: [Byte], count: Int) -> [Byte] {
  out = bytes.new_buffer([])
  n = count < 0 ? 0x7FFF_FFFF_FFFF_FFFF : count
  i = 0
  while i < input.size {
    if n == 0 {
      out.write!(input[i...input.size])
      break
    }
    if bytes.has_prefix(input[i...input.size], old) {
      out.write!(new)
      i += old.size
      n -= 1
      next if old.size != 0
      break if i == input.size
    }
    if old.size == 0 {
      _r, length = utf8.decode_rune(input[i...input.size])
      out.write!(input[i...i + length])
      i += length
    } else {
      out.write_byte!(input[i])
      i += 1
    }
  }
  out.write!(new) if old.size == 0 && n != 0
  out.bytes
}

test "FuzzReplace seeds" {
  for tc in replace_tests {
    simple = replace_other(tc[0], tc[1], tc[2], tc[3])
    assert_eq s(simple), s(bytes.replace(tc[0], tc[1], tc[2], tc[3]))
  }
}

