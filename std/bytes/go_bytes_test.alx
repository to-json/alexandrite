def ten_runes(r: Rune) -> Str { runes_str([r; 10]) }

def rot13(r: Rune) -> Rune {
  step: Rune = 13
  return ((r - 97 + step) % 26) + 97 if r >= 97 && r <= 122
  return ((r - 65 + step) % 26) + 65 if r >= 65 && r <= 90
  r
}

test "Map" {
  a = ten_runes(97)
  # 1. Grow.
  m = bytes.map(->(_r: Rune) -> Rune { unicode.MAX_RUNE }, b(a))
  check(s(m), ten_runes(unicode.MAX_RUNE), "growing")
  # 2. Shrink.
  m = bytes.map(->(_r: Rune) -> Rune { 97 }, b(ten_runes(unicode.MAX_RUNE)))
  check(s(m), a, "shrinking")
  # 3. Rot13.
  m = bytes.map(->(r: Rune) -> Rune { rot13(r) }, b("a to zed"))
  assert_eq s(m), "n gb mrq"
  # 4. Rot13^2.
  m = bytes.map(->(r: Rune) -> Rune { rot13(r) }, bytes.map(->(r: Rune) -> Rune { rot13(r) }, b("a to zed")))
  assert_eq s(m), "a to zed"
  # 5. Drop.
  latin = unicode.script("Latin").unwrap
  m = bytes.map(->(r: Rune) -> Rune { unicode.is(latin, r) ? r : -1 }, b("Hello, 세계"))
  assert_eq s(m), "Hello"
  # 6. Invalid rune.
  m = bytes.map(->(_r: Rune) -> Rune { utf8.MAX_RUNE + 1 }, b("x"))
  assert_eq s(m), "\uFFFD"
}

