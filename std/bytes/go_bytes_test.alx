# ------------------------------------------------------------- cutting

# Go's (before, after, found) from an alx cut result.
def cut3(input: [Byte], r: ([Byte], [Byte])?) -> (Str, Str, Bool) {
  if p = r { return (s(p[0]), s(p[1]), true) }
  (s(input), "", false)
}

test "Cut" {
  for tc in cut_tests {
    check(cut3(tc[0], bytes.cut(tc[0], tc[1])), (tc[2], tc[3], tc[4]), "cut(#{q(tc[0])}, #{q(tc[1])})")
  }
}

test "CutLast" {
  for tc in cut_last_tests {
    check(cut3(tc[0], bytes.cut_last(tc[0], tc[1])), (tc[2], tc[3], tc[4]), "cut_last(#{q(tc[0])}, #{q(tc[1])})")
  }
}

def cut2(input: [Byte], r: [Byte]?) -> (Str, Bool) {
  if v = r { return (s(v), true) }
  (s(input), false)
}

test "CutPrefix" {
  for tc in cut_prefix_tests {
    got = cut2(tc[0], bytes.cut_prefix(tc[0], tc[1]))
    check(got, (tc[2], tc[3]), "cut_prefix(#{q(tc[0])}, #{q(tc[1])})")
  }
}

test "CutSuffix" {
  for tc in cut_suffix_tests {
    got = cut2(tc[0], bytes.cut_suffix(tc[0], tc[1]))
    check(got, (tc[2], tc[3]), "cut_suffix(#{q(tc[0])}, #{q(tc[1])})")
