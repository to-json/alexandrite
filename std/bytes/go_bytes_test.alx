#![test(external)]
# Go's bytes_test.go and compare_test.go, translated (their tables are in
# go_tables_test.alx). External tests, as Go's are (package bytes_test).
#
# Not translated, and why:
#  - allocation counts (testing.AllocsPerRun in TestEqual, runIndexTests,
#    TestIndexRune, TestReplace): alx has no allocation counter; the values
#    those tests check are checked.
#  - nil versus empty (runStringTests, trimNilTests, TestTrimFunc, TestClone):
#    alx has no nil slice; the contents are checked.
#  - capacity and backing-array identity (TestSplit's Join copy check,
#    TestReplace's spare-capacity input, TestClone's unsafe.SliceData): no
#    capacity or pointers; copies are checked by writing to the result.
#  - TestEqualExhaustive / TestNotEqual / TestIndexByteBig / TestCompareBytes
#    run at Go's -short sizes (the full sizes take minutes without Go's
#    vectorized kernels).
#  - benchmarks (Benchmark*), bytes_js_wasm_test.go and boundary_test.go
#    (page-boundary reads through syscall.Mmap; alx's functions don't read
#    past the slice).

import "bytes"
import "strconv"
import "unicode"
import "unicode/utf8"

# ---------------------------------------------------------------- helpers

pub def b(t: Str) -> [Byte] { t.bytes.to_a }
pub def x(v: [Byte]) -> [Byte] { v }
pub def s(v: [Byte]) -> Str { Str.from_bytes(v) }
pub def xs(v: [Byte]) -> Str { Str.from_bytes(v) }
pub def rb(c: Byte, n: Int) -> [Byte] {
  out: [Byte] = [0; n]
  i = 0
  while i < n {
    out[i] = c
    i += 1
  }
  out
}
#[track_caller]
pub def check[T](got: T, want: T, what: Str) {
  assert got == want, "#{what} = #{got}, want #{want}"
}
pub def q(v: [Byte]) -> Str { strconv.quote(Str.from_bytes(v)) }
pub def strs(a: [[Byte]]) -> [Str] { a.map { Str.from_bytes(it) } }
def runes_str(rs: [Rune]) -> Str {
  out: [Byte] = []
  for r in rs { out = utf8.append_rune(out, r) }
  Str.from_bytes(out)
}

# Go's predicates by the names its tables give them.
def holds(name: Str, r: Rune) -> Bool {
  return !holds(name[4...name.size], r) if name.start_with?("not ")
  case name {
    "IsSpace" => unicode.is_space(r)
    "IsDigit" => unicode.is_digit(r)
    "IsUpper" => unicode.is_upper(r)
    "IsValidRune" => r != 0xFFFD
    _ => panic("unknown predicate #{name}")
  }
}

# ------------------------------------------------------------- Lines

test "Lines" {
  for tc in lines_tests {
    check(strs(bytes.lines(tc[0])), tc[1], "lines(#{q(tc[0])})")
  }
}

# ------------------------------------------------------------- Equal

test "Equal" {
  for tc in compare_tests {
    check(bytes.equal(tc[0], tc[1]), tc[2] == 0, "equal(#{q(tc[0])}, #{q(tc[1])})")
  }
}

test "EqualExhaustive" {
  size = 32
  a: [Byte] = [0; size]
  bb: [Byte] = [0; size]
  b_init: [Byte] = [0; size]
  for i in 0...size {
    a[i] = (17 * i).as_u8
    b_init[i] = (23 * i + 100).as_u8
  }
  for len in 0..size {
    for xi in 0..size - len {
      for y in 0..size - len {
        copy(bb, b_init)
        copy(bb[y...y + len], a[xi...xi + len])
        ok = bytes.equal(a[xi...xi + len], bb[y...y + len]) && bytes.equal(bb[y...y + len], a[xi...xi + len])
        assert ok, "Equal(#{len}, #{xi}, #{y}) = false"
      }
    }
  }
}

test "NotEqual" {
  size = 32
  a: [Byte] = [0; size]
  bb: [Byte] = [0; size]
  for len in 0..size {
    for xi in 0..size - len {
      for y in 0..size - len {
        for diffpos in xi...xi + len {
          a[diffpos] = 1
          same = bytes.equal(a[xi...xi + len], bb[y...y + len]) || bytes.equal(bb[y...y + len], a[xi...xi + len])
          assert !same, "NotEqual(#{len}, #{xi}, #{y}, #{diffpos}) = true"
          a[diffpos] = 0
        }
      }
    }
  }
}

