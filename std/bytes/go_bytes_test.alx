  # runIndexTests' allocation cases, for their values.
  assert_eq bytes.index(rb(0x30, 64) + b("10000"), rb(0x30, 61) + b("1")), 3
  assert_eq bytes.last_index(rb(0x30, 71) + b("1"), rb(0x30, 66) + b("1")), 5
}

