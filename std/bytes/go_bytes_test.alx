# A larger buffer with different sizes and alignments.
test "IndexByteBig" {
  n = 128
  bb: [Byte] = [0; n]
  for i in 0...n {
    windows = [bb[i...n], bb[0...i], bb[i / 2...n - (i + 1) / 2]]
    for b1 in windows {
      for j in 0...b1.size {
        b1[j] = 120
        assert_eq bytes.index_byte(b1, 120), j
        b1[j] = 0
        assert_eq bytes.index_byte(b1, 120), -1
      }
    }
  }
}

# A small index across all offsets of a buffer bigger than a page.
test "IndexByteSmall" {
  bb: [Byte] = [0; 5015]
  for i in 0..bb.size - 15 {
    for j in 0...15 { bb[i + j] = (100 + j).as_u8 }
    for j in 0...15 {
      assert_eq bytes.index_byte(bb[i...i + 15], (100 + j).as_u8), j
    }
    for j in 0...15 { bb[i + j] = 0 }
  }
  # Matches outside the slice never trigger.
  for i in 0..bb.size - 15 {
    for j in 0...15 { bb[i + j] = 1 }
    for _j in 0...15 {
      assert_eq bytes.index_byte(bb[i...i + 15], 0), -1
    }
    for j in 0...15 { bb[i + j] = 0 }
  }
}

test "IndexRune" {
  for tc in index_rune_tests {
    check(bytes.index_rune(tc[0], tc[1]), tc[2], "index_rune(#{q(tc[0])}, #{tc[1]})")
  }
  haystack = b("test世界")
  assert_eq bytes.index_rune(haystack, 115), 2
  assert_eq bytes.index_rune(haystack, 19990), 4
}

# The count of a single byte across page offsets.
test "CountByte" {
  bb: [Byte] = [0; 5015]
  windows = [1, 2, 3, 4, 15, 16, 17, 31, 32, 33, 63, 64, 65, 128]
  max_wnd = windows[windows.size - 1]
  starts = (0..2 * max_wnd).to_a + (4096 - (max_wnd + 1)...bb.size).to_a
  for i in starts {
    for w in windows {
      window = w
      window = bb.size - i if window > bb.size - i
      for j in 0...window {
        bb[i + j] = 100
        assert_eq bytes.count(bb[i...i + window], [100]), j + 1
      }
      for j in 0...window { bb[i + j] = 0 }
    }
  }
}

# Bytes outside the window are never counted.
test "CountByteNoMatch" {
  bb: [Byte] = [0; 5015]
  windows = [1, 2, 3, 4, 15, 16, 17, 31, 32, 33, 63, 64, 65, 128]
  for i in 0..bb.size {
    for w in windows {
      window = w
      window = bb.size - i if window > bb.size - i
      for j in 0...window { bb[i + j] = 100 }
      assert_eq bytes.count(bb[i...i + window], [0]), 0
      for j in 0...window { bb[i + j] = 0 }
    }
  }
}

# ------------------------------------------------------------- Split, Fields

# Appends 'z' to each piece (as Go's tests do, to check that appending to a
# result can't change the next one); returns the last.
def append_z(a: [[Byte]]) -> [Byte] {
  last: [Byte] = []
  for v in a {
    w = v
    w << 122
    last = w
  }
  last
}

test "Split" {
  for tc in split_tests {
    input = tc[0]
    sep = tc[1]
    n = tc[2]
    want = tc[3]
    a = bytes.split_n(input, sep, n)
    xz = append_z(a)
    result = strs(a)
    check(result, want, "split_n(#{q(input)}, #{q(sep)}, #{n})")
    assert_eq strs(bytes.split_seq(input, sep)), want if n < 0
    next if n == 0 || a.size == 0
    assert_eq s(xz), want[want.size - 1] + "z"
    joined = bytes.join(a, sep)
    check(s(joined), s(input), "join(split(#{q(input)}))")
    assert_eq strs(bytes.split(input, sep)), result if n < 0
    # Join copies: writing to its result leaves the pieces alone.
    if joined.size > 0 && a[0].size > 0 {
      first = a[0][0]
      joined[0] = first +% 1
      check(a[0][0], first, "join didn't copy")
    }
  }
}

test "SplitAfter" {
  for tc in split_after_tests {
    input = tc[0]
    sep = tc[1]
    n = tc[2]
    want = tc[3]
    a = bytes.split_after_n(input, sep, n)
    xz = append_z(a)
    result = strs(a)
    check(result, want, "split_after_n(#{q(input)}, #{q(sep)}, #{n})")
    assert_eq strs(bytes.split_after_seq(input, sep)), want if n < 0
    assert_eq s(xz), want[want.size - 1] + "z"
    assert_eq s(bytes.join(a, [])), s(input)
    assert_eq strs(bytes.split_after(input, sep)), result if n < 0
  }
}

test "Fields" {
  for tc in fields_tests {
    bb = tc[0]
    want = tc[1]
    before = s(bb)
    a = bytes.fields(bb)
    xz = append_z(a)
    check(strs(a), want, "fields(#{strconv.quote(before)})")
    assert_eq strs(bytes.fields_seq(bb)), want
    check(s(bb), before, "slice changed")
    assert_eq s(xz), want[want.size - 1] + "z" if want.size > 0
  }
}

test "FieldsFunc" {
  for tc in fields_tests {
    assert_eq strs(bytes.fields_func(tc[0], ->(r: Rune) -> Bool { unicode.is_space(r) })), tc[1]
  }
  pred = ->(c: Rune) -> Bool { c == 88 }
  for tc in fields_func_tests {
    bb = tc[0]
    want = tc[1]
    before = s(bb)
    a = bytes.fields_func(bb, pred)
    xz = append_z(a)
    check(strs(a), want, "fields_func(#{strconv.quote(before)})")
    assert_eq strs(bytes.fields_func_seq(bb, pred)), want
    check(s(bb), before, "slice changed")
    assert_eq s(xz), want[want.size - 1] + "z" if want.size > 0
  }
}

