    ("Trim", x([0x80, 0x74, 0x65, 0x73, 0x74, 0xff]), xs([0xff]), b("test")),
    ("Trim", b(" Ġ "), " ", b("Ġ")),
    ("Trim", b(" Ġİ0"), "0 ", b("Ġİ")),
    ("Trim", b("abba"), "", b("abba")),
    ("Trim", b(""), "123", b("")),
    ("Trim", b(""), "", b("")),
    ("TrimLeft", b("abba"), "", b("abba")),
    ("TrimLeft", b(""), "123", b("")),
    ("TrimLeft", b(""), "", b("")),
    ("TrimRight", b("abba"), "", b("abba")),
    ("TrimRight", b(""), "123", b("")),
    ("TrimRight", b(""), "", b("")),
    ("TrimRight", x([0xe2, 0x98, 0xba, 0xc0]), "☺", x([0xe2, 0x98, 0xba, 0xc0])),
    ("TrimPrefix", b("aabb"), "a", b("abb")),
    ("TrimPrefix", b("aabb"), "b", b("aabb")),
    ("TrimSuffix", b("aabb"), "a", b("aabb")),
    ("TrimSuffix", b("aabb"), "b", b("aab")),
  ]
}

