def lines_tests -> [([Byte], [Str])] {
  [
    (b("abc\nabc\n"), ["abc\n", "abc\n"]),
    (b("abc\r\nabc"), ["abc\r\n", "abc"]),
    (b("abc\r\n"), ["abc\r\n"]),
    (b("\nabc"), ["\n", "abc"]),
    (b("\nabc\n\n"), ["\n", "abc\n", "\n"]),
  ]
}

