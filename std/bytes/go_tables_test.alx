def equal_fold_tests -> [([Byte], [Byte], Bool)] {
  [
    (b("abc"), b("abc"), true),
    (b("ABcd"), b("ABcd"), true),
    (b("123abc"), b("123ABC"), true),
    (b("αβδ"), b("ΑΒΔ"), true),
    (b("abc"), b("xyz"), false),
    (b("abc"), b("XYZ"), false),
    (b("abcdefghijk"), b("abcdefghijX"), false),
    (b("abcdefghijk"), b("abcdefghijK"), true),
    (b("abcdefghijK"), b("abcdefghijK"), true),
    (b("abcdefghijkz"), b("abcdefghijKy"), false),
    (b("abcdefghijKz"), b("abcdefghijKy"), false),
  ]
}

def cut_tests -> [([Byte], [Byte], Str, Str, Bool)] {
  [
    (b("abc"), b("b"), "a", "c", true),
    (b("abc"), b("a"), "", "bc", true),
    (b("abc"), b("c"), "ab", "", true),
    (b("abc"), b("abc"), "", "", true),
    (b("abc"), b(""), "", "abc", true),
    (b("abc"), b("d"), "abc", "", false),
    (b(""), b("d"), "", "", false),
    (b(""), b(""), "", "", true),
  ]
}

def cut_prefix_tests -> [([Byte], [Byte], Str, Bool)] {
  [
    (b("abc"), b("a"), "bc", true),
    (b("abc"), b("abc"), "", true),
    (b("abc"), b(""), "abc", true),
    (b("abc"), b("d"), "abc", false),
    (b(""), b("d"), "", false),
    (b(""), b(""), "", true),
  ]
}

def cut_suffix_tests -> [([Byte], [Byte], Str, Bool)] {
  [
    (b("abc"), b("bc"), "a", true),
    (b("abc"), b("abc"), "", true),
    (b("abc"), b(""), "abc", true),
    (b("abc"), b("d"), "abc", false),
    (b(""), b("d"), "", false),
    (b(""), b(""), "", true),
  ]
}

