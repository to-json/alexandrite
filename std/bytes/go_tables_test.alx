def split_tests -> [([Byte], [Byte], Int, [Str])] {
  [
    (b(""), b(""), -1, []),
    (b("abcd"), b("a"), 0, []),
    (b("abcd"), b(""), 2, ["a", "bcd"]),
    (b("abcd"), b("a"), -1, ["", "bcd"]),
    (b("abcd"), b("z"), -1, ["abcd"]),
    (b("abcd"), b(""), -1, ["a", "b", "c", "d"]),
    (b("1,2,3,4"), b(","), -1, ["1", "2", "3", "4"]),
    (b("1....2....3....4"), b("..."), -1, ["1", ".2", ".3", ".4"]),
    (b("☺☻☹"), b("☹"), -1, ["☺☻", ""]),
    (b("☺☻☹"), b("~"), -1, ["☺☻☹"]),
    (b("☺☻☹"), b(""), -1, ["☺", "☻", "☹"]),
    (b("1 2 3 4"), b(" "), 3, ["1", "2", "3 4"]),
    (b("1 2"), b(" "), 3, ["1", "2"]),
    (b("123"), b(""), 2, ["1", "23"]),
    (b("123"), b(""), 17, ["1", "2", "3"]),
    (b("bT"), b("T"), 2305843009213693951, ["b", ""]),
    (x([0xff, 0x2d, 0xff]), b(""), -1, [xs([0xff]), "-", xs([0xff])]),
    (x([0xff, 0x2d, 0xff]), b("-"), -1, [xs([0xff]), xs([0xff])]),
  ]
}

