def trim_func_tests -> [(Str, [Byte], [Byte], [Byte], [Byte])] {
  [
    ("IsSpace", b("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000 hello \t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000"), b("hello"), b("hello \t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000"), b("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000 hello")),
    ("IsDigit", b("๐๒12hello34๐๑"), b("hello"), b("hello34๐๑"), b("๐๒12hello")),
    ("IsUpper", b("ⱯⱯⱯⱯABCDhelloEFⱯⱯGHⱯⱯ"), b("hello"), b("helloEFⱯⱯGHⱯⱯ"), b("ⱯⱯⱯⱯABCDhello")),
    ("not IsSpace", b("hello\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000hello"), b("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000"), b("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000hello"), b("hello\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000")),
    ("not IsDigit", b("hello๐๒1234๐๑helo"), b("๐๒1234๐๑"), b("๐๒1234๐๑helo"), b("hello๐๒1234๐๑")),
    ("IsValidRune", x([0x61, 0x62, 0xc0, 0x61, 0xc0, 0x63, 0x64]), x([0xc0, 0x61, 0xc0]), x([0xc0, 0x61, 0xc0, 0x63, 0x64]), x([0x61, 0x62, 0xc0, 0x61, 0xc0])),
    ("not IsValidRune", x([0xc0, 0x61, 0xc0]), b("a"), x([0x61, 0xc0]), x([0xc0, 0x61])),
    ("IsSpace", b(""), b(""), b(""), b("")),
    ("IsSpace", b(" "), b(""), b(""), b("")),
  ]
}

def index_func_tests -> [([Byte], Str, Int, Int)] {
  [
    (b(""), "IsValidRune", -1, -1),
    (b("abc"), "IsDigit", -1, -1),
    (b("0123"), "IsDigit", 0, 3),
    (b("a1b"), "IsDigit", 1, 1),
    (b("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000"), "IsSpace", 0, 12),
    (b("๐๒12hello34๐๑"), "IsDigit", 0, 18),
    (b("ⱯⱯⱯⱯABCDhelloEFⱯⱯGHⱯⱯ"), "IsUpper", 0, 34),
    (b("12๐๒hello34๐๑"), "not IsDigit", 8, 12),
    (x([0x80, 0x31]), "IsDigit", 1, 1),
    (x([0x80, 0x61, 0x62, 0x63]), "IsDigit", -1, -1),
    (x([0xc0, 0x61, 0xc0]), "IsValidRune", 1, 1),
    (x([0xc0, 0x61, 0xc0]), "not IsValidRune", 0, 2),
    (x([0xc0, 0xe2, 0x98, 0xba, 0xc0]), "not IsValidRune", 0, 4),
    (x([0xc0, 0xe2, 0x98, 0xba, 0xc0, 0xc0]), "not IsValidRune", 0, 5),
    (x([0x61, 0x62, 0xc0, 0x61, 0xc0, 0x63, 0x64]), "not IsValidRune", 2, 4),
    (x([0x61, 0xe0, 0x80, 0x63, 0x64]), "not IsValidRune", 1, 2),
  ]
}

def replace_tests -> [([Byte], [Byte], [Byte], Int, Str)] {
  [
    (b("hello"), b("l"), b("L"), 0, "hello"),
    (b("hello"), b("l"), b("L"), -1, "heLLo"),
    (b("hello"), b("x"), b("X"), -1, "hello"),
    (b(""), b("x"), b("X"), -1, ""),
    (b("radar"), b("r"), b("<r>"), -1, "<r>ada<r>"),
    (b(""), b(""), b("<>"), -1, "<>"),
    (b("banana"), b("a"), b("<>"), -1, "b<>n<>n<>"),
    (b("banana"), b("a"), b("<>"), 1, "b<>nana"),
    (b("banana"), b("a"), b("<>"), 1000, "b<>n<>n<>"),
    (b("banana"), b("an"), b("<>"), -1, "b<><>a"),
    (b("banana"), b("ana"), b("<>"), -1, "b<>na"),
    (b("banana"), b(""), b("<>"), -1, "<>b<>a<>n<>a<>n<>a<>"),
    (b("banana"), b(""), b("<>"), 10, "<>b<>a<>n<>a<>n<>a<>"),
    (b("banana"), b(""), b("<>"), 6, "<>b<>a<>n<>a<>n<>a"),
    (b("banana"), b(""), b("<>"), 5, "<>b<>a<>n<>a<>na"),
    (b("banana"), b(""), b("<>"), 1, "<>banana"),
    (b("banana"), b("a"), b("a"), -1, "banana"),
    (b("banana"), b("a"), b("a"), 1, "banana"),
    (b("☺☻☹"), b(""), b("<>"), -1, "<>☺<>☻<>☹<>"),
  ]
}

