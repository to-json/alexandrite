  assert r.read_byte!.none?, "read_byte! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq r.~seek!(8, 0), 8
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq r.~seek!(6, 2), 6
  assert r.read_byte!.none?, "read_byte! at the end"
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq r.unread_rune!.ok?, false
  p = rb(0, 4)
  assert_eq r.~read_at(p, 9), 0
  assert_eq p[0...0], b("")
  assert r.read_rune!.none?, "read_rune! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  assert r.read_rune!.none?, "read_rune! at the end"
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq r.unread_rune!.ok?, false
  assert_eq (r.len, r.size), (0, 0)
  assert_eq r.unread_rune!.ok?, false
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 0
  assert_eq w.bytes, b("")
}

test "reader sequence 5" {
  r = bytes.new_reader(b("0123456789"))
  assert_eq r.read_rune!, (48, 1)
  assert_eq r.read_rune!, (49, 1)
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.unread_byte!.ok?, false
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.read_rune!, (48, 1)
  p = rb(0, 2)
  assert_eq r.read!(p), 2
  assert_eq p[0...2], b("12")
  p = rb(0, 0)
  assert_eq r.~read_at(p, 13), 0
  assert_eq p[0...0], b("")
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  p = rb(0, 1)
  assert_eq r.~read_at(p, 4), 1
  assert_eq p[0...1], b("4")
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.read_rune!, (50, 1)
  assert_eq r.unread_rune!.ok?, true
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.read_byte!, 50
  assert_eq r.read_byte!, 51
  assert_eq (r.len, r.size), (6, 10)
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.read_byte!, 51
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_rune!.ok?, false
  assert_eq (r.len, r.size), (6, 10)
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.read_byte!, 50
  assert_eq r.unread_rune!.ok?, false
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 7
  assert_eq w.bytes, b("3456789")
}

test "reader sequence 6" {
  r = bytes.new_reader(x([0x61, 0xe2, 0x98, 0xba, 0x62, 0xff, 0x63, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac]))
  assert_eq r.read_rune!, (97, 1)
  p = rb(0, 0)
  assert_eq r.~read_at(p, 5), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_byte!.ok?, true
  p = rb(0, 1)
  assert_eq r.~read_at(p, 9), 1
  assert_eq p[0...1], x([0xa5])
  assert_eq r.unread_rune!.ok?, false
  assert_eq (r.len, r.size), (13, 13)
  p = rb(0, 1)
  assert_eq r.~read_at(p, 6), 1
  assert_eq p[0...1], b("c")
  p = rb(0, 1)
  assert_eq r.read!(p), 1
  assert_eq p[0...1], b("a")
  assert_eq (r.len, r.size), (12, 13)
  assert_eq r.read_rune!, (9786, 3)
  p = rb(0, 0)
  assert_eq r.~read_at(p, 7), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(3, 2), 16
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq r.~seek!(9, 2), 22
  p = rb(0, 3)
  assert_eq r.~read_at(p, 6), 3
  assert_eq p[0...3], x([0x63, 0xe6, 0x97])
  assert r.read_byte!.none?, "read_byte! at the end"
  assert r.read_rune!.none?, "read_rune! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  p = rb(0, 4)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_rune!.ok?, false
  p = rb(0, 4)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq (r.len, r.size), (0, 13)
  assert_eq (r.len, r.size), (0, 13)
  assert r.read_rune!.none?, "read_rune! at the end"
  p = rb(0, 1)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  p = rb(0, 0)
  assert_eq r.~read_at(p, 6), 0
  assert_eq p[0...0], b("")
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq r.unread_byte!.ok?, true
  assert_eq (r.len, r.size), (0, 13)
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 0
  assert_eq w.bytes, b("")
}

test "reader sequence 7" {
  r = bytes.new_reader(b("☺x"))
  assert_eq r.unread_rune!.ok?, false
  assert_eq (r.len, r.size), (4, 4)
  assert_eq r.read_rune!, (9786, 3)
  assert_eq r.read_rune!, (120, 1)
  assert_eq (r.len, r.size), (0, 4)
  assert_eq r.~seek!(6, 0), 6
  assert_eq r.seek!(-4, 0).err.unwrap.message, "bytes.Reader.seek!: negative position"
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.unread_rune!.ok?, false
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.~seek!(4, 1), 8
  assert_eq (r.len, r.size), (0, 4)
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.unread_byte!.ok?, true
  assert r.read_rune!.none?, "read_rune! at the end"
  p = rb(0, 4)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_rune!.ok?, false
  assert r.read_rune!.none?, "read_rune! at the end"
  p = rb(0, 2)
  assert_eq r.~read_at(p, 13), 0
  assert_eq p[0...0], b("")
  assert_eq (r.len, r.size), (0, 4)
  assert_eq r.unread_rune!.ok?, false
  assert r.read_rune!.none?, "read_rune! at the end"
  p = rb(0, 3)
  assert_eq r.~read_at(p, 5), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_rune!.ok?, false
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert r.read_byte!.none?, "read_byte! at the end"
  p = rb(0, 2)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(-3, 1), 3
  assert_eq r.~seek!(1, 0), 1
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 3
  assert_eq w.bytes, x([0x98, 0xba, 0x78])
}

test "reader sequence 8" {
  r = bytes.new_reader(b(""))
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq r.unread_byte!.ok?, false
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq (r.len, r.size), (0, 0)
  assert_eq (r.len, r.size), (0, 0)
  assert_eq r.unread_rune!.ok?, false
  assert_eq (r.len, r.size), (0, 0)
  assert r.read_rune!.none?, "read_rune! at the end"
  p = rb(0, 1)
  assert_eq r.~read_at(p, 9), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_byte!.ok?, false
  assert r.read_rune!.none?, "read_rune! at the end"
  assert r.read_rune!.none?, "read_rune! at the end"
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq (r.len, r.size), (0, 0)
  assert_eq r.unread_byte!.ok?, false
  assert_eq r.~seek!(8, 2), 8
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq (r.len, r.size), (0, 0)
  assert r.read_rune!.none?, "read_rune! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq r.~seek!(8, 2), 8
  p = rb(0, 4)
  assert_eq r.~read_at(p, 9), 0
  assert_eq p[0...0], b("")
  p = rb(0, 2)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert r.read_rune!.none?, "read_rune! at the end"
  p = rb(0, 1)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_byte!.ok?, true
  assert r.read_rune!.none?, "read_rune! at the end"
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 0
  assert_eq w.bytes, b("")
}

test "reader sequence 9" {
  r = bytes.new_reader(b("0123456789"))
  assert_eq r.read_byte!, 48
  assert_eq r.read_rune!, (49, 1)
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.unread_rune!.ok?, false
  p = rb(0, 0)
  assert_eq r.~read_at(p, 6), 0
  assert_eq p[0...0], b("")
  assert_eq r.read_byte!, 49
  assert_eq r.read_rune!, (50, 1)
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.seek!(-1, 0).err.unwrap.message, "bytes.Reader.seek!: negative position"
  assert_eq r.read_rune!, (51, 1)
  assert_eq (r.len, r.size), (6, 10)
  assert_eq r.unread_rune!.ok?, true
  assert_eq r.~seek!(3, 1), 6
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.unread_rune!.ok?, false
  p = rb(0, 4)
  assert_eq r.~read_at(p, 10), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_rune!.ok?, false
  p = rb(0, 1)
  assert_eq r.read!(p), 1
  assert_eq p[0...1], b("5")
  assert_eq (r.len, r.size), (4, 10)
  assert_eq r.~seek!(8, 0), 8
  assert_eq r.read_rune!, (56, 1)
  assert_eq (r.len, r.size), (1, 10)
  assert_eq (r.len, r.size), (1, 10)
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.read_rune!, (56, 1)
  assert_eq r.unread_rune!.ok?, true
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.seek!(-2, 0).err.unwrap.message, "bytes.Reader.seek!: negative position"
  assert_eq (r.len, r.size), (3, 10)
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 3
  assert_eq w.bytes, b("789")
}

test "reader sequence 10" {
  r = bytes.new_reader(x([0x61, 0xe2, 0x98, 0xba, 0x62, 0xff, 0x63, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac]))
  assert_eq (r.len, r.size), (13, 13)
  assert_eq r.read_byte!, 97
  assert_eq r.~seek!(2, 1), 3
  assert_eq (r.len, r.size), (10, 13)
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq (r.len, r.size), (10, 13)
  assert_eq r.read_rune!, (65533, 1)
  assert_eq r.unread_rune!.ok?, true
  assert_eq r.read_rune!, (65533, 1)
  assert_eq r.unread_byte!.ok?, true
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(5, 0), 5
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.read_rune!, (98, 1)
  assert_eq r.~seek!(1, 1), 6
  p = rb(0, 3)
  assert_eq r.read!(p), 3
  assert_eq p[0...3], x([0x63, 0xe6, 0x97])
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.~seek!(5, 1), 14
  p = rb(0, 1)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_byte!.ok?, true
  p = rb(0, 2)
  assert_eq r.~read_at(p, 0), 2
  assert_eq p[0...2], x([0x61, 0xe2])
  assert_eq r.~seek!(2, 2), 15
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.~seek!(3, 1), 17
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_byte!.ok?, true
  assert r.read_rune!.none?, "read_rune! at the end"
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 0
  assert_eq w.bytes, b("")
}

test "reader sequence 11" {
  r = bytes.new_reader(b("☺x"))
  assert_eq r.read_rune!, (9786, 3)
  assert_eq r.read_rune!, (120, 1)
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.seek!(-3, 0).err.unwrap.message, "bytes.Reader.seek!: negative position"
  assert_eq (r.len, r.size), (1, 4)
  assert_eq r.~seek!(9, 0), 9
  p = rb(0, 2)
  assert_eq r.~read_at(p, 3), 1
  assert_eq p[0...1], b("x")
  assert_eq r.unread_byte!.ok?, true
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq r.unread_byte!.ok?, true
  p = rb(0, 0)
  assert_eq r.~read_at(p, 1), 0
  assert_eq p[0...0], b("")
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq r.unread_byte!.ok?, true
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  p = rb(0, 2)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(4, 1), 10
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq r.~seek!(8, 1), 18
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.~seek!(9, 0), 9
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  p = rb(0, 4)
  assert_eq r.~read_at(p, 1), 3
  assert_eq p[0...3], x([0x98, 0xba, 0x78])
  assert_eq r.unread_byte!.ok?, true
  assert r.read_rune!.none?, "read_rune! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  p = rb(0, 2)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(1, 2), 5
  assert r.read_byte!.none?, "read_byte! at the end"
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 0
  assert_eq w.bytes, b("")
}
