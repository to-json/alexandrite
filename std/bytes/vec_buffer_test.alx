  assert_eq bf.write_rune!(127), 1
  assert_eq bf.bytes, rb(0x7a, 54) + x([0x6b, 0x2c, 0x2c, 0xe2, 0x98, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x7f])
  bf.grow!(196)
  assert_eq bf.bytes, rb(0x7a, 54) + x([0x6b, 0x2c, 0x2c, 0xe2, 0x98, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x7f])
