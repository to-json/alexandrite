  assert_eq bf.write!(b("hello")), 5
  assert_eq bf.bytes, rb(0x7a, 54) + x([0x6b, 0x2c, 0x2c, 0xe2, 0x98, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x7f, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
  assert_eq bf.write_string!(""), 0
  assert_eq bf.bytes, rb(0x7a, 54) + x([0x6b, 0x2c, 0x2c, 0xe2, 0x98, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x7f, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
  assert_eq bf.next!(4), b("zzzz")
  assert_eq bf.bytes, rb(0x7a, 50) + x([0x6b, 0x2c, 0x2c, 0xe2, 0x98, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x7f, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
  assert_eq bf.read_rune!, (122, 1)
  assert_eq bf.bytes, rb(0x7a, 49) + x([0x6b, 0x2c, 0x2c, 0xe2, 0x98, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x7f, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
  assert_eq bf.unread_rune!.ok?, true
  assert_eq bf.bytes, rb(0x7a, 50) + x([0x6b, 0x2c, 0x2c, 0xe2, 0x98, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x7f, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
  assert_eq bf.read_rune!, (122, 1)
  assert_eq bf.bytes, rb(0x7a, 49) + x([0x6b, 0x2c, 0x2c, 0xe2, 0x98, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x7f, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
  bf.truncate!(36)
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"), 100
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.read_string!(44), "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq bf.bytes, b("")
}

test "buffer sequence 17" {
  bf = bytes.new_buffer([])
  assert_eq bf.next!(3), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(3), b("")
  assert_eq bf.bytes, b("")
  p = rb(0, 2)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("☺x"), 4
  assert_eq bf.bytes, b("☺x")
  assert_eq bf.peek(2), x([0xe2, 0x98])
  assert_eq bf.bytes, b("☺x")
  assert_eq bf.read_rune!, (9786, 3)
  assert_eq bf.bytes, b("x")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, x([0xba, 0x78])
  assert_eq bf.write_string!("line\n"), 5
  assert_eq bf.bytes, x([0xba, 0x78, 0x6c, 0x69, 0x6e, 0x65, 0x0a])
  assert_eq bf.read_string!(44), xs([0xba, 0x78, 0x6c, 0x69, 0x6e, 0x65, 0x0a])
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  p = rb(0, 7)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(3), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(75), 1
  assert_eq bf.bytes, b("K")
  assert_eq bf.write_string!(xs([0xff])), 1
  assert_eq bf.bytes, x([0x4b, 0xff])
  assert_eq bf.write_rune!(1114111), 4
  assert_eq bf.bytes, x([0x4b, 0xff, 0xf4, 0x8f, 0xbf, 0xbf])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, x([0x4b, 0xff, 0xf4, 0x8f, 0xbf, 0xbf])
  p = rb(0, 5)
  assert_eq bf.read!(p), 5
  assert_eq p[0...5], x([0x4b, 0xff, 0xf4, 0x8f, 0xbf])
  assert_eq bf.bytes, x([0xbf])
  assert_eq bf.write_rune!(55296), 3
  assert_eq bf.bytes, x([0xbf, 0xef, 0xbf, 0xbd])
  assert_eq bf.read_byte!, 191
  assert_eq bf.bytes, b("\uFFFD")
  p = rb(0, 5)
  assert_eq bf.read!(p), 3
  assert_eq p[0...3], b("\uFFFD")
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(x([0xff])), 1
  assert_eq bf.bytes, x([0xff])
  assert_eq bf.read_byte!, 255
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("line\n")), 5
  assert_eq bf.bytes, b("line\n")
  p = rb(0, 6)
  assert_eq bf.read!(p), 5
  assert_eq p[0...5], b("line\n")
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(0), b("")
  assert_eq bf.bytes, b("")
  bf.grow!(17)
  assert_eq bf.bytes, b("")
  assert bf.read_string!(44).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("hello"), 5
  assert_eq bf.bytes, b("hello")
  bf.grow!(4)
  assert_eq bf.bytes, b("hello")
  assert_eq bf.write_string!("日本\n語"), 10
  assert_eq bf.bytes, b("hello日本\n語")
  bf.write_byte!(160)
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xa0])
  assert_eq bf.write_string!("hello"), 5
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xa0, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
  assert_eq bf.read_byte!, 104
  assert_eq bf.bytes, x([0x65, 0x6c, 0x6c, 0x6f, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xa0, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
  assert_eq bf.read_rune!, (101, 1)
  assert_eq bf.bytes, x([0x6c, 0x6c, 0x6f, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xa0, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
  bf.write_byte!(14)
  assert_eq bf.bytes, x([0x6c, 0x6c, 0x6f, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xa0, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x0e])
  assert_eq bf.next!(5), x([0x6c, 0x6c, 0x6f, 0xe6, 0x97])
  assert_eq bf.bytes, x([0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xa0, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x0e])
  assert_eq bf.peek(3), x([0xa5, 0xe6, 0x9c])
  assert_eq bf.bytes, x([0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xa0, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x0e])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, x([0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xa0, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x0e])
}

test "buffer sequence 18" {
  bf = bytes.new_buffer([])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  p = rb(0, 4)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("日本\n語")), 10
  assert_eq bf.bytes, b("日本\n語")
  assert_eq bf.read_byte!, 230
  assert_eq bf.bytes, x([0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e])
  assert_eq bf.peek(1), x([0x97])
  assert_eq bf.bytes, x([0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e])
  assert_eq bf.read_string!(44), xs([0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e])
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(1), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("hello"), 5
  assert_eq bf.bytes, b("hello")
  assert_eq bf.write_rune!(9786), 3
  assert_eq bf.bytes, b("hello☺")
  assert_eq bf.write_rune!(1114112), 3
  assert_eq bf.bytes, b("hello☺\uFFFD")
  bf.truncate!(9)
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0xef])
  assert_eq bf.write!(x([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0xef, 0xe2, 0x98])
  assert_eq bf.write_rune!(122), 1
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0xef, 0xe2, 0x98, 0x7a])
  assert_eq bf.read_string!(97), xs([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0xef, 0xe2, 0x98, 0x7a])
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")), 100
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.read_string!(97), "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("日本\n語")), 10
  assert_eq bf.bytes, b("日本\n語")
  assert_eq bf.write_string!("日本\n語"), 10
  assert_eq bf.bytes, b("日本\n語日本\n語")
  bf.truncate!(19)
  assert_eq bf.bytes, x([0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa])
  assert_eq bf.write!(b("☺x")), 4
  assert_eq bf.bytes, x([0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0xe2, 0x98, 0xba, 0x78])
  p = rb(0, 4)
  assert_eq bf.read!(p), 4
  assert_eq p[0...4], x([0xe6, 0x97, 0xa5, 0xe6])
  assert_eq bf.bytes, x([0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0xe2, 0x98, 0xba, 0x78])
  bf.grow!(131)
  assert_eq bf.bytes, x([0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0xe2, 0x98, 0xba, 0x78])
  p = rb(0, 5)
  assert_eq bf.read!(p), 5
  assert_eq p[0...5], x([0x9c, 0xac, 0x0a, 0xe8, 0xaa])
  assert_eq bf.bytes, x([0x9e, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0xe2, 0x98, 0xba, 0x78])
  assert_eq bf.write_string!("line\n"), 5
  assert_eq bf.bytes, x([0x9e, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0xe2, 0x98, 0xba, 0x78, 0x6c, 0x69, 0x6e, 0x65, 0x0a])
  assert_eq bf.write!(b("a")), 1
  assert_eq bf.bytes, x([0x9e, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0xe2, 0x98, 0xba, 0x78, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x61])
  assert_eq bf.read_string!(97), xs([0x9e, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0xe2, 0x98, 0xba, 0x78, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x61])
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")), 100
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.write_rune!(32), 1
  assert_eq bf.bytes, rb(0x7a, 100) + b(" ")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, rb(0x7a, 100) + b(" ")
  assert_eq bf.read_rune!, (122, 1)
  assert_eq bf.bytes, rb(0x7a, 99) + b(" ")
  assert_eq bf.unread_rune!.ok?, true
  assert_eq bf.bytes, rb(0x7a, 100) + b(" ")
  assert_eq bf.read_string!(10), s(rb(0x7a, 100) + b(" "))
  assert_eq bf.bytes, b("")
  p = rb(0, 2)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(""), 0
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(3), b("")
  assert_eq bf.bytes, b("")
}

test "buffer sequence 19" {
  bf = bytes.new_buffer([])
  assert bf.read_string!(255).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("☺x")), 4
  assert_eq bf.bytes, b("☺x")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("☺x")
  p = rb(0, 6)
  assert_eq bf.read!(p), 4
  assert_eq p[0...4], b("☺x")
  assert_eq bf.bytes, b("")
  bf.grow!(170)
  assert_eq bf.bytes, b("")
  assert bf.read_string!(97).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(5), b("")
  assert_eq bf.bytes, b("")
  p = rb(0, 0)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(""), 0
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("☺x"), 4
  assert_eq bf.bytes, b("☺x")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("☺x")
  p = rb(0, 1)
  assert_eq bf.read!(p), 1
  assert_eq p[0...1], x([0xe2])
  assert_eq bf.bytes, x([0x98, 0xba, 0x78])
  bf.grow!(195)
  assert_eq bf.bytes, x([0x98, 0xba, 0x78])
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, x([0x98, 0xba, 0x78])
  p = rb(0, 5)
  assert_eq bf.read!(p), 3
  assert_eq p[0...3], x([0x98, 0xba, 0x78])
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(1), b("")
  assert_eq bf.bytes, b("")
  bf.write_byte!(76)
  assert_eq bf.bytes, b("L")
  bf.grow!(143)
  assert_eq bf.bytes, b("L")
  assert_eq bf.write!(x([0xff])), 1
  assert_eq bf.bytes, x([0x4c, 0xff])
  assert_eq bf.write!(x([0xff])), 1
  assert_eq bf.bytes, x([0x4c, 0xff, 0xff])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, x([0x4c, 0xff, 0xff])
  assert_eq bf.read_string!(97), xs([0x4c, 0xff, 0xff])
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  bf.write_byte!(217)
  assert_eq bf.bytes, x([0xd9])
  p = rb(0, 4)
  assert_eq bf.read!(p), 1
  assert_eq p[0...1], x([0xd9])
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(3), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert bf.read_string!(255).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  bf.grow!(18)
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(1), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(32), 1
  assert_eq bf.bytes, b(" ")
  assert_eq bf.next!(4), b(" ")
  assert_eq bf.bytes, b("")
  bf.grow!(111)
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(1114111), 4
  assert_eq bf.bytes, b("\U0010FFFF")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("\U0010FFFF")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("\U0010FFFF")
}

test "buffer sequence 20" {
  bf = bytes.new_buffer([])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(2), b("")
  assert_eq bf.bytes, b("")
  bf.write_byte!(253)
  assert_eq bf.bytes, x([0xfd])
  assert_eq bf.next!(0), b("")
  assert_eq bf.bytes, x([0xfd])
  assert_eq bf.write_rune!(26085), 3
  assert_eq bf.bytes, x([0xfd, 0xe6, 0x97, 0xa5])
  assert_eq bf.next!(0), b("")
  assert_eq bf.bytes, x([0xfd, 0xe6, 0x97, 0xa5])
  p = rb(0, 7)
  assert_eq bf.read!(p), 4
  assert_eq p[0...4], x([0xfd, 0xe6, 0x97, 0xa5])
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, x([0xa5])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  p = rb(0, 2)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(""), 0
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_string!(97).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(4), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("line\n")), 5
  assert_eq bf.bytes, b("line\n")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("line\n")
  bf.write_byte!(51)
  assert_eq bf.bytes, b("line\n3")
  assert_eq bf.read_byte!, 108
  assert_eq bf.bytes, b("ine\n3")
  bf.write_byte!(245)
  assert_eq bf.bytes, x([0x69, 0x6e, 0x65, 0x0a, 0x33, 0xf5])
  bf.truncate!(3)
  assert_eq bf.bytes, b("ine")
  bf.write_byte!(15)
  assert_eq bf.bytes, b("ine\x0f")
  bf.grow!(124)
  assert_eq bf.bytes, b("ine\x0f")
  assert_eq bf.next!(0), b("")
  assert_eq bf.bytes, b("ine\x0f")
  bf.grow!(143)
  assert_eq bf.bytes, b("ine\x0f")
  bf.truncate!(3)
  assert_eq bf.bytes, b("ine")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("ine")
  assert_eq bf.read_byte!, 105
  assert_eq bf.bytes, b("ne")
  assert_eq bf.read_byte!, 110
  assert_eq bf.bytes, b("e")
  assert_eq bf.write_string!("line\n"), 5
  assert_eq bf.bytes, b("eline\n")
  assert_eq bf.read_byte!, 101
  assert_eq bf.bytes, b("line\n")
  assert_eq bf.peek(0), b("")
  assert_eq bf.bytes, b("line\n")
  assert_eq bf.read_byte!, 108
  assert_eq bf.bytes, b("ine\n")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, b("line\n")
  assert_eq bf.write_rune!(26085), 3
  assert_eq bf.bytes, b("line\n日")
  bf.write_byte!(225)
  assert_eq bf.bytes, x([0x6c, 0x69, 0x6e, 0x65, 0x0a, 0xe6, 0x97, 0xa5, 0xe1])
  bf.grow!(60)
  assert_eq bf.bytes, x([0x6c, 0x69, 0x6e, 0x65, 0x0a, 0xe6, 0x97, 0xa5, 0xe1])
  assert_eq bf.write_string!("☺x"), 4
  assert_eq bf.bytes, x([0x6c, 0x69, 0x6e, 0x65, 0x0a, 0xe6, 0x97, 0xa5, 0xe1, 0xe2, 0x98, 0xba, 0x78])
}

test "buffer sequence 21" {
  bf = bytes.new_buffer([])
  assert_eq bf.write_rune!(0), 1
  assert_eq bf.bytes, b("\x00")
  assert_eq bf.write!(x([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0x00, 0xe2, 0x98])
  bf.grow!(88)
  assert_eq bf.bytes, x([0x00, 0xe2, 0x98])
  assert_eq bf.write_string!(xs([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0x00, 0xe2, 0x98, 0xe2, 0x98])
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(26085), 3
  assert_eq bf.bytes, b("日")
  bf.grow!(97)
  assert_eq bf.bytes, b("日")
  bf.write_byte!(1)
  assert_eq bf.bytes, b("日\x01")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(32), 1
  assert_eq bf.bytes, b(" ")
  bf.write_byte!(242)
  assert_eq bf.bytes, x([0x20, 0xf2])
  assert_eq bf.read_rune!, (32, 1)
  assert_eq bf.bytes, x([0xf2])
  assert_eq bf.peek(0), b("")
  assert_eq bf.bytes, x([0xf2])
  assert_eq bf.write_rune!(9786), 3
  assert_eq bf.bytes, x([0xf2, 0xe2, 0x98, 0xba])
  bf.truncate!(4)
  assert_eq bf.bytes, x([0xf2, 0xe2, 0x98, 0xba])
  assert_eq bf.next!(4), x([0xf2, 0xe2, 0x98, 0xba])
  assert_eq bf.bytes, b("")
  p = rb(0, 6)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("a"), 1
  assert_eq bf.bytes, b("a")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("a")
  assert_eq bf.next!(0), b("")
  assert_eq bf.bytes, b("a")
  assert_eq bf.read_rune!, (97, 1)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, b("a")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("a")
  assert_eq bf.write_rune!(32), 1
  assert_eq bf.bytes, b("a ")
  assert_eq bf.write_rune!(1114112), 3
  assert_eq bf.bytes, b("a \uFFFD")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("a \uFFFD")
  assert_eq bf.peek(3), x([0x61, 0x20, 0xef])
  assert_eq bf.bytes, b("a \uFFFD")
  bf.write_byte!(6)
  assert_eq bf.bytes, b("a \uFFFD\x06")
  bf.grow!(26)
  assert_eq bf.bytes, b("a \uFFFD\x06")
  p = rb(0, 3)
  assert_eq bf.read!(p), 3
  assert_eq p[0...3], x([0x61, 0x20, 0xef])
  assert_eq bf.bytes, x([0xbf, 0xbd, 0x06])
  assert_eq bf.read_string!(97), xs([0xbf, 0xbd, 0x06])
  assert_eq bf.bytes, b("")
  bf.grow!(97)
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(3), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  bf.grow!(39)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(0), 1
  assert_eq bf.bytes, b("\x00")
  bf.grow!(162)
  assert_eq bf.bytes, b("\x00")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("\x00")
}

test "buffer sequence 22" {
  bf = bytes.new_buffer([])
  bf.grow!(124)
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  bf.grow!(121)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(127), 1
  assert_eq bf.bytes, b("\x7f")
  bf.write_byte!(52)
  assert_eq bf.bytes, b("\x7f4")
  assert_eq bf.read_byte!, 127
  assert_eq bf.bytes, b("4")
  bf.write_byte!(131)
  assert_eq bf.bytes, x([0x34, 0x83])
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(2), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(4), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  bf.grow!(23)
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(3), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  bf.write_byte!(2)
  assert_eq bf.bytes, b("\x02")
  assert_eq bf.peek(1), b("\x02")
  assert_eq bf.bytes, b("\x02")
  assert_eq bf.read_string!(10), "\x02"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(44), 1
  assert_eq bf.bytes, b(",")
  assert_eq bf.read_rune!, (44, 1)
  assert_eq bf.bytes, b("")
  p = rb(0, 5)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(2), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("a")), 1
  assert_eq bf.bytes, b("a")
  assert_eq bf.read_string!(44), "a"
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  p = rb(0, 7)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(4), b("")
  assert_eq bf.bytes, b("")
  bf.write_byte!(235)
  assert_eq bf.bytes, x([0xeb])
  assert_eq bf.next!(4), x([0xeb])
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  p = rb(0, 5)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  bf.grow!(108)
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(5), b("")
  assert_eq bf.bytes, b("")
}

test "buffer sequence 23" {
  bf = bytes.new_buffer([])
  assert_eq bf.peek(5), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(8490), 3
  assert_eq bf.bytes, b("K")
  assert_eq bf.peek(5), b("K")
  assert_eq bf.bytes, b("K")
  bf.write_byte!(106)
  assert_eq bf.bytes, b("Kj")
  assert_eq bf.read_byte!, 226
  assert_eq bf.bytes, x([0x84, 0xaa, 0x6a])
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, b("Kj")
  assert_eq bf.read_byte!, 226
  assert_eq bf.bytes, x([0x84, 0xaa, 0x6a])
  assert_eq bf.next!(0), b("")
  assert_eq bf.bytes, x([0x84, 0xaa, 0x6a])
  assert_eq bf.write_string!("☺x"), 4
  assert_eq bf.bytes, x([0x84, 0xaa, 0x6a, 0xe2, 0x98, 0xba, 0x78])
  bf.grow!(101)
  assert_eq bf.bytes, x([0x84, 0xaa, 0x6a, 0xe2, 0x98, 0xba, 0x78])
  assert_eq bf.read_string!(97), xs([0x84, 0xaa, 0x6a, 0xe2, 0x98, 0xba, 0x78])
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(x([0xff])), 1
  assert_eq bf.bytes, x([0xff])
  assert_eq bf.next!(5), x([0xff])
  assert_eq bf.bytes, b("")
  bf.write_byte!(2)
  assert_eq bf.bytes, b("\x02")
  assert_eq bf.peek(5), b("\x02")
  assert_eq bf.bytes, b("\x02")
  assert_eq bf.read_string!(10), "\x02"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  p = rb(0, 5)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(1), b("")
  assert_eq bf.bytes, b("")
  bf.write_byte!(209)
  assert_eq bf.bytes, x([0xd1])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, b("")
  assert bf.read_string!(44).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(3), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(""), 0
  assert_eq bf.bytes, b("")
  bf.grow!(74)
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("日本\n語")), 10
  assert_eq bf.bytes, b("日本\n語")
  assert_eq bf.write_string!(""), 0
  assert_eq bf.bytes, b("日本\n語")
  bf.grow!(92)
  assert_eq bf.bytes, b("日本\n語")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("日本\n語")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("日本\n語")
  assert_eq bf.write_rune!(55296), 3
  assert_eq bf.bytes, b("日本\n語\uFFFD")
  assert_eq bf.peek(2), x([0xe6, 0x97])
  assert_eq bf.bytes, b("日本\n語\uFFFD")
  assert_eq bf.read_byte!, 230
  assert_eq bf.bytes, x([0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xef, 0xbf, 0xbd])
  assert_eq bf.write!(b("line\n")), 5
  assert_eq bf.bytes, x([0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xef, 0xbf, 0xbd, 0x6c, 0x69, 0x6e, 0x65, 0x0a])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, x([0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xef, 0xbf, 0xbd, 0x6c, 0x69, 0x6e, 0x65, 0x0a])
  bf.grow!(52)
  assert_eq bf.bytes, x([0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xef, 0xbf, 0xbd, 0x6c, 0x69, 0x6e, 0x65, 0x0a])
}

test "reader sequence 0" {
  r = bytes.new_reader(b(""))
  assert_eq (r.len, r.size), (0, 0)
  p = rb(0, 1)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.seek!(-4, 0).err.unwrap.message, "bytes.Reader.seek!: negative position"
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_byte!.ok?, false
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq r.unread_byte!.ok?, false
  p = rb(0, 2)
  assert_eq r.~read_at(p, 5), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(1, 0), 1
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.seek!(-4, 2).err.unwrap.message, "bytes.Reader.seek!: negative position"
  assert_eq r.unread_rune!.ok?, false
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  p = rb(0, 1)
  assert_eq r.~read_at(p, 13), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(4, 2), 4
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  p = rb(0, 2)
  assert_eq r.~read_at(p, 13), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(4, 2), 4
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_rune!.ok?, false
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq r.seek!(-4, 0).err.unwrap.message, "bytes.Reader.seek!: negative position"
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.~seek!(1, 1), 4
  p = rb(0, 4)
  assert_eq r.~read_at(p, 6), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(5, 1), 9
  p = rb(0, 1)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 0
  assert_eq w.bytes, b("")
}

test "reader sequence 1" {
  r = bytes.new_reader(b("0123456789"))
  assert_eq r.~seek!(6, 2), 16
  assert_eq r.unread_byte!.ok?, true
  p = rb(0, 4)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(2, 1), 17
  assert r.read_rune!.none?, "read_rune! at the end"
  p = rb(0, 1)
  assert_eq r.~read_at(p, 4), 1
  assert_eq p[0...1], b("4")
  assert_eq r.~seek!(8, 1), 25
  assert_eq (r.len, r.size), (0, 10)
  assert r.read_rune!.none?, "read_rune! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  p = rb(0, 4)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq (r.len, r.size), (0, 10)
  p = rb(0, 4)
  assert_eq r.~read_at(p, 10), 0
  assert_eq p[0...0], b("")
  assert_eq r.seek!(-3, 0).err.unwrap.message, "bytes.Reader.seek!: negative position"
  assert_eq (r.len, r.size), (0, 10)
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  p = rb(0, 4)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_rune!.ok?, false
  assert r.read_byte!.none?, "read_byte! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  p = rb(0, 4)
  assert_eq r.~read_at(p, 2), 4
  assert_eq p[0...4], b("2345")
  p = rb(0, 3)
  assert_eq r.~read_at(p, 12), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_rune!.ok?, false
  assert r.read_byte!.none?, "read_byte! at the end"
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq r.~seek!(7, 2), 17
  assert_eq r.unread_rune!.ok?, false
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 0
  assert_eq w.bytes, b("")
}

test "reader sequence 2" {
  r = bytes.new_reader(x([0x61, 0xe2, 0x98, 0xba, 0x62, 0xff, 0x63, 0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac]))
  p = rb(0, 1)
  assert_eq r.~read_at(p, 10), 1
  assert_eq p[0...1], x([0xe6])
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.read_byte!, 97
  assert_eq r.read_rune!, (9786, 3)
  p = rb(0, 1)
  assert_eq r.~read_at(p, 5), 1
  assert_eq p[0...1], x([0xff])
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.read_byte!, 186
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.read_rune!, (65533, 1)
  assert_eq r.read_byte!, 98
  assert_eq r.read_rune!, (65533, 1)
  assert_eq r.read_byte!, 99
  assert_eq r.read_rune!, (26085, 3)
  assert_eq r.seek!(-4, 0).err.unwrap.message, "bytes.Reader.seek!: negative position"
  assert_eq r.read_rune!, (26412, 3)
  assert_eq r.unread_rune!.ok?, true
  assert_eq (r.len, r.size), (3, 13)
  assert_eq r.read_byte!, 230
  assert_eq r.read_rune!, (65533, 1)
  assert_eq r.seek!(-4, 0).err.unwrap.message, "bytes.Reader.seek!: negative position"
  assert_eq r.read_byte!, 172
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq r.~seek!(9, 1), 22
  assert_eq r.unread_rune!.ok?, false
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq (r.len, r.size), (0, 13)
  assert r.read_rune!.none?, "read_rune! at the end"
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.~seek!(1, 2), 14
  assert_eq (r.len, r.size), (0, 13)
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 0
  assert_eq w.bytes, b("")
}

test "reader sequence 3" {
  r = bytes.new_reader(b("☺x"))
  assert_eq r.read_rune!, (9786, 3)
  p = rb(0, 1)
  assert_eq r.~read_at(p, 8), 0
  assert_eq p[0...0], b("")
  assert_eq r.read_byte!, 120
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.read_rune!, (120, 1)
  assert_eq r.unread_byte!.ok?, true
  assert_eq (r.len, r.size), (1, 4)
  p = rb(0, 4)
  assert_eq r.~read_at(p, 10), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.unread_rune!.ok?, false
  assert_eq r.read_byte!, 120
  assert_eq r.~seek!(0, 0), 0
  assert_eq r.read_byte!, 226
  p = rb(0, 0)
  assert_eq r.~read_at(p, 10), 0
  assert_eq p[0...0], b("")
  assert_eq r.read_rune!, (65533, 1)
  assert_eq r.seek!(-4, 0).err.unwrap.message, "bytes.Reader.seek!: negative position"
  assert_eq r.unread_byte!.ok?, true
  assert_eq (r.len, r.size), (3, 4)
  p = rb(0, 4)
  assert_eq r.~read_at(p, 1), 3
  assert_eq p[0...3], x([0x98, 0xba, 0x78])
  p = rb(0, 2)
  assert_eq r.~read_at(p, 11), 0
  assert_eq p[0...0], b("")
  assert_eq r.unread_byte!.ok?, true
  assert_eq r.read_rune!, (9786, 3)
  assert_eq r.read_rune!, (120, 1)
  assert_eq (r.len, r.size), (0, 4)
  p = rb(0, 3)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  p = rb(0, 0)
  assert_eq r.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq r.~seek!(-1, 2), 3
  assert_eq r.~seek!(6, 1), 9
  assert r.read_byte!.none?, "read_byte! at the end"
  assert_eq (r.len, r.size), (0, 4)
  w = bytes.new_buffer([])
  assert_eq r.~write_to!(w), 0
  assert_eq w.bytes, b("")
}

test "reader sequence 4" {
  r = bytes.new_reader(b(""))
