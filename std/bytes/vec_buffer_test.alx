test "buffer sequence 2" {
  bf = bytes.new_buffer([])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  bf.grow!(125)
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(2), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_string!(44).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_string!(255).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(""), 0
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  bf.write_byte!(171)
  assert_eq bf.bytes, x([0xab])
  assert_eq bf.next!(3), x([0xab])
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, x([0xab])
  bf.grow!(55)
  assert_eq bf.bytes, x([0xab])
  p = rb(0, 4)
  assert_eq bf.read!(p), 1
  assert_eq p[0...1], x([0xab])
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("line\n"), 5
  assert_eq bf.bytes, b("line\n")
  assert_eq bf.read_string!(97), "line\n"
  assert_eq bf.bytes, b("")
  p = rb(0, 2)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  p = rb(0, 2)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(2), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(xs([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0xe2, 0x98])
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  bf.grow!(183)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(xs([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0xe2, 0x98])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, x([0xe2, 0x98])
  bf.truncate!(2)
  assert_eq bf.bytes, x([0xe2, 0x98])
  assert_eq bf.peek(3), x([0xe2, 0x98])
  assert_eq bf.bytes, x([0xe2, 0x98])
  p = rb(0, 7)
  assert_eq bf.read!(p), 2
  assert_eq p[0...2], x([0xe2, 0x98])
  assert_eq bf.bytes, b("")
  assert bf.read_string!(44).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, x([0x98])
  assert_eq bf.next!(3), x([0x98])
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(",,"), 2
  assert_eq bf.bytes, b(",,")
  bf.write_byte!(188)
  assert_eq bf.bytes, x([0x2c, 0x2c, 0xbc])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, x([0x2c, 0x2c, 0xbc])
  assert_eq bf.read_string!(44), ","
  assert_eq bf.bytes, x([0x2c, 0xbc])
  assert_eq bf.read_byte!, 44
  assert_eq bf.bytes, x([0xbc])
}

test "buffer sequence 3" {
  bf = bytes.new_buffer([])
  p = rb(0, 4)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  p = rb(0, 1)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(3), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("hello"), 5
  assert_eq bf.bytes, b("hello")
  assert_eq bf.write!(b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")), 100
  assert_eq bf.bytes, b("hello") + rb(0x7a, 100)
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("hello") + rb(0x7a, 100)
  assert_eq bf.peek(2), b("he")
  assert_eq bf.bytes, b("hello") + rb(0x7a, 100)
  p = rb(0, 5)
  assert_eq bf.read!(p), 5
  assert_eq p[0...5], b("hello")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.write_string!("line\n"), 5
  assert_eq bf.bytes, rb(0x7a, 100) + b("line\n")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, rb(0x7a, 100) + b("line\n")
  bf.truncate!(39)
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  p = rb(0, 0)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.write_rune!(223), 2
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzß")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzß")
  assert_eq bf.next!(4), b("zzzz")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzß")
  assert_eq bf.read_rune!, (122, 1)
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzß")
  assert_eq bf.next!(5), b("zzzzz")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzß")
  assert_eq bf.next!(5), b("zzzzz")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzß")
  assert_eq bf.peek(4), b("zzzz")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzß")
  assert_eq bf.write!(b("hello")), 5
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzßhello")
  assert_eq bf.read_rune!, (122, 1)
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzßhello")
  assert_eq bf.unread_rune!.ok?, true
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzßhello")
  bf.truncate!(22)
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.read_byte!, 122
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.next!(4), b("zzzz")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzz")
  assert_eq bf.peek(2), b("zz")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzz")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzz")
  bf.grow!(95)
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzz")
  assert_eq bf.peek(0), b("")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzz")
  assert_eq bf.write!(b(",,")), 2
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzz,,")
  bf.truncate!(15)
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzz")
  assert_eq bf.write_rune!(65533), 3
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzz\uFFFD")
  assert_eq bf.write!(b("a")), 1
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzz\uFFFDa")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzz\uFFFDa")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzz\uFFFDa")
  bf.write_byte!(171)
  assert_eq bf.bytes, x([0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0xef, 0xbf, 0xbd, 0x61, 0xab])
  assert_eq bf.write_rune!(122), 1
  assert_eq bf.bytes, x([0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0xef, 0xbf, 0xbd, 0x61, 0xab, 0x7a])
}

test "buffer sequence 4" {
  bf = bytes.new_buffer([])
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert bf.read_string!(44).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(xs([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0xe2, 0x98])
  assert_eq bf.read_byte!, 226
  assert_eq bf.bytes, x([0x98])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("hello")), 5
  assert_eq bf.bytes, b("hello")
  assert_eq bf.write!(b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")), 100
  assert_eq bf.bytes, b("hello") + rb(0x7a, 100)
  bf.truncate!(60)
  assert_eq bf.bytes, b("hellozzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  bf.truncate!(48)
  assert_eq bf.bytes, b("hellozzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.read_string!(10), "hellozzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  bf.grow!(150)
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("☺x")), 4
  assert_eq bf.bytes, b("☺x")
  assert_eq bf.write_string!("a"), 1
  assert_eq bf.bytes, b("☺xa")
  assert_eq bf.read_byte!, 226
  assert_eq bf.bytes, x([0x98, 0xba, 0x78, 0x61])
  assert_eq bf.write_string!("a"), 1
  assert_eq bf.bytes, x([0x98, 0xba, 0x78, 0x61, 0x61])
  bf.write_byte!(70)
  assert_eq bf.bytes, x([0x98, 0xba, 0x78, 0x61, 0x61, 0x46])
  assert_eq bf.read_string!(10), xs([0x98, 0xba, 0x78, 0x61, 0x61, 0x46])
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(-1), 3
  assert_eq bf.bytes, b("\uFFFD")
  assert_eq bf.read_string!(10), "\uFFFD"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(2), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(5), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b(",,")), 2
  assert_eq bf.bytes, b(",,")
  bf.write_byte!(196)
  assert_eq bf.bytes, x([0x2c, 0x2c, 0xc4])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, x([0x2c, 0x2c, 0xc4])
  bf.truncate!(2)
  assert_eq bf.bytes, b(",,")
  assert_eq bf.read_rune!, (44, 1)
  assert_eq bf.bytes, b(",")
  bf.grow!(113)
  assert_eq bf.bytes, b(",")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, b(",,")
  assert_eq bf.write_rune!(8490), 3
  assert_eq bf.bytes, b(",,K")
  assert_eq bf.write_string!(xs([0xff])), 1
  assert_eq bf.bytes, x([0x2c, 0x2c, 0xe2, 0x84, 0xaa, 0xff])
  bf.write_byte!(78)
  assert_eq bf.bytes, x([0x2c, 0x2c, 0xe2, 0x84, 0xaa, 0xff, 0x4e])
  bf.truncate!(7)
  assert_eq bf.bytes, x([0x2c, 0x2c, 0xe2, 0x84, 0xaa, 0xff, 0x4e])
  p = rb(0, 1)
  assert_eq bf.read!(p), 1
  assert_eq p[0...1], b(",")
  assert_eq bf.bytes, x([0x2c, 0xe2, 0x84, 0xaa, 0xff, 0x4e])
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, x([0x2c, 0x2c, 0xe2, 0x84, 0xaa, 0xff, 0x4e])
  assert_eq bf.read_string!(10), xs([0x2c, 0x2c, 0xe2, 0x84, 0xaa, 0xff, 0x4e])
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, b("N")
}

test "buffer sequence 5" {
  bf = bytes.new_buffer([])
  assert_eq bf.write_rune!(32), 1
  assert_eq bf.bytes, b(" ")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(3), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("line\n")), 5
  assert_eq bf.bytes, b("line\n")
  assert_eq bf.read_byte!, 108
  assert_eq bf.bytes, b("ine\n")
  bf.truncate!(1)
  assert_eq bf.bytes, b("i")
  p = rb(0, 2)
  assert_eq bf.read!(p), 1
  assert_eq p[0...1], b("i")
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")), 100
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.next!(4), b("zzzz")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  bf.write_byte!(205)
  assert_eq bf.bytes, rb(0x7a, 96) + x([0xcd])
  assert_eq bf.next!(1), b("z")
  assert_eq bf.bytes, rb(0x7a, 95) + x([0xcd])
  assert_eq bf.write!(x([0xe2, 0x98])), 2
  assert_eq bf.bytes, rb(0x7a, 95) + x([0xcd, 0xe2, 0x98])
  bf.write_byte!(28)
  assert_eq bf.bytes, rb(0x7a, 95) + x([0xcd, 0xe2, 0x98, 0x1c])
  p = rb(0, 5)
  assert_eq bf.read!(p), 5
  assert_eq p[0...5], b("zzzzz")
  assert_eq bf.bytes, rb(0x7a, 90) + x([0xcd, 0xe2, 0x98, 0x1c])
  assert_eq bf.write_rune!(75), 1
  assert_eq bf.bytes, rb(0x7a, 90) + x([0xcd, 0xe2, 0x98, 0x1c, 0x4b])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, rb(0x7a, 90) + x([0xcd, 0xe2, 0x98, 0x1c, 0x4b])
  assert_eq bf.write_rune!(57343), 3
  assert_eq bf.bytes, rb(0x7a, 90) + x([0xcd, 0xe2, 0x98, 0x1c, 0x4b, 0xef, 0xbf, 0xbd])
  assert_eq bf.write_rune!(65533), 3
  assert_eq bf.bytes, rb(0x7a, 90) + x([0xcd, 0xe2, 0x98, 0x1c, 0x4b, 0xef, 0xbf, 0xbd, 0xef, 0xbf, 0xbd])
  bf.grow!(23)
  assert_eq bf.bytes, rb(0x7a, 90) + x([0xcd, 0xe2, 0x98, 0x1c, 0x4b, 0xef, 0xbf, 0xbd, 0xef, 0xbf, 0xbd])
  assert_eq bf.read_string!(255), s(rb(0x7a, 90) + x([0xcd, 0xe2, 0x98, 0x1c, 0x4b, 0xef, 0xbf, 0xbd, 0xef, 0xbf, 0xbd]))
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("hello"), 5
  assert_eq bf.bytes, b("hello")
  assert_eq bf.read_byte!, 104
  assert_eq bf.bytes, b("ello")
  assert_eq bf.read_rune!, (101, 1)
  assert_eq bf.bytes, b("llo")
  assert_eq bf.write!(x([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0x6c, 0x6c, 0x6f, 0xe2, 0x98])
  p = rb(0, 6)
  assert_eq bf.read!(p), 5
  assert_eq p[0...5], x([0x6c, 0x6c, 0x6f, 0xe2, 0x98])
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, x([0x98])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(0), b("")
  assert_eq bf.bytes, b("")
  p = rb(0, 4)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  bf.grow!(64)
  assert_eq bf.bytes, b("")
  assert bf.read_string!(255).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(0), b("")
  assert_eq bf.bytes, b("")
  p = rb(0, 3)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("a")), 1
  assert_eq bf.bytes, b("a")
  assert_eq bf.read_rune!, (97, 1)
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(1), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(255), 2
  assert_eq bf.bytes, b("ÿ")
}

test "buffer sequence 6" {
  bf = bytes.new_buffer([])
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  p = rb(0, 6)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"), 100
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.next!(4), b("zzzz")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.write_string!("☺x"), 4
  assert_eq bf.bytes, rb(0x7a, 96) + b("☺x")
  bf.write_byte!(43)
  assert_eq bf.bytes, rb(0x7a, 96) + b("☺x+")
  assert_eq bf.peek(5), b("zzzzz")
  assert_eq bf.bytes, rb(0x7a, 96) + b("☺x+")
  assert_eq bf.read_byte!, 122
  assert_eq bf.bytes, rb(0x7a, 95) + b("☺x+")
  assert_eq bf.read_byte!, 122
  assert_eq bf.bytes, rb(0x7a, 94) + b("☺x+")
  p = rb(0, 3)
  assert_eq bf.read!(p), 3
  assert_eq p[0...3], b("zzz")
  assert_eq bf.bytes, rb(0x7a, 91) + b("☺x+")
  assert_eq bf.read_rune!, (122, 1)
  assert_eq bf.bytes, rb(0x7a, 90) + b("☺x+")
  p = rb(0, 0)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, rb(0x7a, 90) + b("☺x+")
  assert_eq bf.read_string!(255), s(rb(0x7a, 90) + b("☺x+"))
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  bf.write_byte!(150)
  assert_eq bf.bytes, x([0x96])
  bf.write_byte!(75)
  assert_eq bf.bytes, x([0x96, 0x4b])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, x([0x96, 0x4b])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, b("K")
  assert_eq bf.write!(b("")), 0
  assert_eq bf.bytes, b("K")
  assert_eq bf.write_rune!(255), 2
  assert_eq bf.bytes, b("Kÿ")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("Kÿ")
  bf.truncate!(3)
  assert_eq bf.bytes, b("Kÿ")
  bf.truncate!(1)
  assert_eq bf.bytes, b("K")
  assert_eq bf.peek(5), b("K")
  assert_eq bf.bytes, b("K")
  assert_eq bf.write_rune!(1114111), 4
  assert_eq bf.bytes, b("K\U0010FFFF")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("K\U0010FFFF")
  bf.truncate!(3)
  assert_eq bf.bytes, x([0x4b, 0xf4, 0x8f])
  assert_eq bf.next!(2), x([0x4b, 0xf4])
  assert_eq bf.bytes, x([0x8f])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, x([0x8f])
  assert_eq bf.read_byte!, 143
  assert_eq bf.bytes, b("")
  bf.grow!(51)
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(x([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0xe2, 0x98])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, x([0x98])
  bf.write_byte!(51)
  assert_eq bf.bytes, x([0x98, 0x33])
  assert_eq bf.read_string!(255), xs([0x98, 0x33])
  assert_eq bf.bytes, b("")
  bf.write_byte!(31)
  assert_eq bf.bytes, b("\x1f")
  assert_eq bf.read_string!(10), "\x1f"
  assert_eq bf.bytes, b("")
}

test "buffer sequence 7" {
  bf = bytes.new_buffer([])
  assert bf.read_string!(10).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(3), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(xs([0xff])), 1
  assert_eq bf.bytes, x([0xff])
  bf.grow!(102)
  assert_eq bf.bytes, x([0xff])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, x([0xff])
  assert_eq bf.read_string!(44), xs([0xff])
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  bf.write_byte!(167)
  assert_eq bf.bytes, x([0xa7])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, x([0xa7])
  assert_eq bf.peek(2), x([0xa7])
  assert_eq bf.bytes, x([0xa7])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("line\n"), 5
  assert_eq bf.bytes, b("line\n")
  assert_eq bf.write_string!(xs([0xff])), 1
  assert_eq bf.bytes, x([0x6c, 0x69, 0x6e, 0x65, 0x0a, 0xff])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, x([0x6c, 0x69, 0x6e, 0x65, 0x0a, 0xff])
  assert_eq bf.read_string!(97), xs([0x6c, 0x69, 0x6e, 0x65, 0x0a, 0xff])
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_string!(44).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(",,"), 2
  assert_eq bf.bytes, b(",,")
  assert_eq bf.read_byte!, 44
  assert_eq bf.bytes, b(",")
  assert_eq bf.read_byte!, 44
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  p = rb(0, 5)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  bf.grow!(32)
  assert_eq bf.bytes, b("")
  bf.write_byte!(65)
  assert_eq bf.bytes, b("A")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  p = rb(0, 7)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b(",,")), 2
  assert_eq bf.bytes, b(",,")
  assert_eq bf.write!(b("")), 0
  assert_eq bf.bytes, b(",,")
  assert_eq bf.write_rune!(97), 1
  assert_eq bf.bytes, b(",,a")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b(",,a")
  p = rb(0, 2)
  assert_eq bf.read!(p), 2
  assert_eq p[0...2], b(",,")
  assert_eq bf.bytes, b("a")
  bf.grow!(6)
  assert_eq bf.bytes, b("a")
}

test "buffer sequence 8" {
  bf = bytes.new_buffer([])
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  bf.grow!(116)
  assert_eq bf.bytes, b("")
  bf.grow!(55)
  assert_eq bf.bytes, b("")
  assert bf.read_string!(97).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  bf.write_byte!(163)
  assert_eq bf.bytes, x([0xa3])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, true
  assert_eq bf.bytes, x([0xa3])
  bf.grow!(16)
  assert_eq bf.bytes, x([0xa3])
  assert_eq bf.write_string!("a"), 1
  assert_eq bf.bytes, x([0xa3, 0x61])
  assert_eq bf.read_byte!, 163
  assert_eq bf.bytes, b("a")
  assert_eq bf.read_string!(97), "a"
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(3), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")), 100
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  p = rb(0, 4)
  assert_eq bf.read!(p), 4
  assert_eq p[0...4], b("zzzz")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.read_string!(10), "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(5), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(0), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("hello")), 5
  assert_eq bf.bytes, b("hello")
  assert_eq bf.write_string!("line\n"), 5
  assert_eq bf.bytes, b("helloline\n")
  assert_eq bf.read_rune!, (104, 1)
  assert_eq bf.bytes, b("elloline\n")
  assert_eq bf.read_rune!, (101, 1)
  assert_eq bf.bytes, b("lloline\n")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, b("elloline\n")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("elloline\n")
  assert_eq bf.read_byte!, 101
  assert_eq bf.bytes, b("lloline\n")
  assert_eq bf.peek(1), b("l")
  assert_eq bf.bytes, b("lloline\n")
  bf.write_byte!(219)
  assert_eq bf.bytes, x([0x6c, 0x6c, 0x6f, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0xdb])
  bf.write_byte!(161)
  assert_eq bf.bytes, b("lloline\nۡ")
  bf.write_byte!(23)
  assert_eq bf.bytes, b("lloline\nۡ\x17")
  assert_eq bf.write!(b("a")), 1
  assert_eq bf.bytes, b("lloline\nۡ\x17a")
  bf.grow!(195)
  assert_eq bf.bytes, b("lloline\nۡ\x17a")
  bf.truncate!(1)
  assert_eq bf.bytes, b("l")
  p = rb(0, 1)
  assert_eq bf.read!(p), 1
  assert_eq p[0...1], b("l")
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  p = rb(0, 3)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(2), b("")
  assert_eq bf.bytes, b("")
}

test "buffer sequence 9" {
  bf = bytes.new_buffer([])
  assert_eq bf.write!(x([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0xe2, 0x98])
  assert_eq bf.read_byte!, 226
  assert_eq bf.bytes, x([0x98])
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, x([0xe2, 0x98])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, x([0xe2, 0x98])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, x([0xe2, 0x98])
  bf.write_byte!(214)
  assert_eq bf.bytes, x([0xe2, 0x98, 0xd6])
  p = rb(0, 1)
  assert_eq bf.read!(p), 1
  assert_eq p[0...1], x([0xe2])
  assert_eq bf.bytes, x([0x98, 0xd6])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, x([0xd6])
  assert_eq bf.read_string!(97), xs([0xd6])
  assert_eq bf.bytes, b("")
  assert bf.read_string!(10).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("a")), 1
  assert_eq bf.bytes, b("a")
  bf.grow!(77)
  assert_eq bf.bytes, b("a")
  assert_eq bf.next!(0), b("")
  assert_eq bf.bytes, b("a")
  p = rb(0, 5)
  assert_eq bf.read!(p), 1
  assert_eq p[0...1], b("a")
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  bf.grow!(20)
  assert_eq bf.bytes, b("")
  assert bf.read_string!(44).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(1114112), 3
  assert_eq bf.bytes, b("\uFFFD")
  bf.write_byte!(92)
  assert_eq bf.bytes, b("\uFFFD\\")
  assert_eq bf.read_rune!, (65533, 3)
  assert_eq bf.bytes, b("\\")
  assert_eq bf.write_rune!(0), 1
  assert_eq bf.bytes, b("\\\x00")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("\\\x00")
  assert_eq bf.read_string!(10), "\\\x00"
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  p = rb(0, 7)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(4), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("☺x"), 4
  assert_eq bf.bytes, b("☺x")
  bf.grow!(77)
  assert_eq bf.bytes, b("☺x")
}

test "buffer sequence 10" {
  bf = bytes.new_buffer([])
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(128), 2
  assert_eq bf.bytes, b("\u0080")
  assert_eq bf.write_rune!(128), 2
  assert_eq bf.bytes, b("\u0080\u0080")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(3), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("a"), 1
  assert_eq bf.bytes, b("a")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("a")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("a")
  assert_eq bf.write!(x([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0x61, 0xe2, 0x98])
  assert_eq bf.peek(2), x([0x61, 0xe2])
  assert_eq bf.bytes, x([0x61, 0xe2, 0x98])
  assert_eq bf.write_rune!(32), 1
  assert_eq bf.bytes, x([0x61, 0xe2, 0x98, 0x20])
  assert_eq bf.write!(b(",,")), 2
  assert_eq bf.bytes, x([0x61, 0xe2, 0x98, 0x20, 0x2c, 0x2c])
  assert_eq bf.read_string!(255), xs([0x61, 0xe2, 0x98, 0x20, 0x2c, 0x2c])
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(2), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_string!(255).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(2), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_string!(10).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(0), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_string!(97).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(4), b("")
  assert_eq bf.bytes, b("")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  bf.write_byte!(87)
  assert_eq bf.bytes, b("W")
  assert_eq bf.read_rune!, (87, 1)
  assert_eq bf.bytes, b("")
  assert bf.read_string!(255).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(223), 2
  assert_eq bf.bytes, b("ß")
  assert_eq bf.read_byte!, 195
  assert_eq bf.bytes, x([0x9f])
  assert_eq bf.write_string!("line\n"), 5
  assert_eq bf.bytes, x([0x9f, 0x6c, 0x69, 0x6e, 0x65, 0x0a])
  bf.truncate!(4)
  assert_eq bf.bytes, x([0x9f, 0x6c, 0x69, 0x6e])
  p = rb(0, 2)
  assert_eq bf.read!(p), 2
  assert_eq p[0...2], x([0x9f, 0x6c])
  assert_eq bf.bytes, b("in")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, b("lin")
  bf.write_byte!(229)
  assert_eq bf.bytes, x([0x6c, 0x69, 0x6e, 0xe5])
  assert_eq bf.read_string!(97), xs([0x6c, 0x69, 0x6e, 0xe5])
  assert_eq bf.bytes, b("")
  p = rb(0, 7)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(xs([0xff])), 1
  assert_eq bf.bytes, x([0xff])
  assert_eq bf.read_byte!, 255
  assert_eq bf.bytes, b("")
}

test "buffer sequence 11" {
  bf = bytes.new_buffer([])
  assert bf.read_string!(10).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("日本\n語")), 10
  assert_eq bf.bytes, b("日本\n語")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("日本\n語")
  assert_eq bf.write_string!(xs([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x0a, 0xe8, 0xaa, 0x9e, 0xe2, 0x98])
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(0), 1
  assert_eq bf.bytes, b("\x00")
  assert_eq bf.write_rune!(0), 1
  assert_eq bf.bytes, b("\x00\x00")
  bf.write_byte!(156)
  assert_eq bf.bytes, x([0x00, 0x00, 0x9c])
  assert_eq bf.write!(b("a")), 1
  assert_eq bf.bytes, x([0x00, 0x00, 0x9c, 0x61])
  assert_eq bf.read_rune!, (0, 1)
  assert_eq bf.bytes, x([0x00, 0x9c, 0x61])
  p = rb(0, 3)
  assert_eq bf.read!(p), 3
  assert_eq p[0...3], x([0x00, 0x9c, 0x61])
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, b("a")
  assert_eq bf.next!(4), b("a")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  p = rb(0, 1)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("line\n")), 5
  assert_eq bf.bytes, b("line\n")
  bf.grow!(14)
  assert_eq bf.bytes, b("line\n")
  p = rb(0, 6)
  assert_eq bf.read!(p), 5
  assert_eq p[0...5], b("line\n")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(75), 1
  assert_eq bf.bytes, b("K")
  assert_eq bf.write_rune!(1114112), 3
  assert_eq bf.bytes, b("K\uFFFD")
  assert_eq bf.read_rune!, (75, 1)
  assert_eq bf.bytes, b("\uFFFD")
  assert_eq bf.write_string!("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"), 100
  assert_eq bf.bytes, b("\uFFFD") + rb(0x7a, 100)
  assert_eq bf.peek(1), x([0xef])
  assert_eq bf.bytes, b("\uFFFD") + rb(0x7a, 100)
  bf.grow!(192)
  assert_eq bf.bytes, b("\uFFFD") + rb(0x7a, 100)
  assert_eq bf.write_rune!(-1), 3
  assert_eq bf.bytes, b("\uFFFD") + rb(0x7a, 100) + b("\uFFFD")
  bf.grow!(181)
  assert_eq bf.bytes, b("\uFFFD") + rb(0x7a, 100) + b("\uFFFD")
  assert_eq bf.read_string!(255), s(b("\uFFFD") + rb(0x7a, 100) + b("\uFFFD"))
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  bf.grow!(180)
  assert_eq bf.bytes, b("")
  assert bf.read_string!(97).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  bf.grow!(87)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(8490), 3
  assert_eq bf.bytes, b("K")
  assert_eq bf.write_string!("line\n"), 5
  assert_eq bf.bytes, b("Kline\n")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("Kline\n")
  assert_eq bf.read_byte!, 226
  assert_eq bf.bytes, x([0x84, 0xaa, 0x6c, 0x69, 0x6e, 0x65, 0x0a])
  assert_eq bf.write_rune!(44), 1
  assert_eq bf.bytes, x([0x84, 0xaa, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x2c])
  assert_eq bf.read_byte!, 132
  assert_eq bf.bytes, x([0xaa, 0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x2c])
}

test "buffer sequence 12" {
  bf = bytes.new_buffer([])
  bf.write_byte!(113)
  assert_eq bf.bytes, b("q")
  assert_eq bf.write_rune!(127), 1
  assert_eq bf.bytes, b("q\x7f")
  assert_eq bf.read_rune!, (113, 1)
  assert_eq bf.bytes, b("\x7f")
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(2), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"), 100
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.write_rune!(128512), 4
  assert_eq bf.bytes, rb(0x7a, 100) + b("😀")
  assert_eq bf.write_rune!(0), 1
  assert_eq bf.bytes, rb(0x7a, 100) + b("😀\x00")
  assert_eq bf.peek(4), b("zzzz")
  assert_eq bf.bytes, rb(0x7a, 100) + b("😀\x00")
  assert_eq bf.read_byte!, 122
  assert_eq bf.bytes, rb(0x7a, 99) + b("😀\x00")
  assert_eq bf.peek(2), b("zz")
  assert_eq bf.bytes, rb(0x7a, 99) + b("😀\x00")
  assert_eq bf.write_rune!(128512), 4
  assert_eq bf.bytes, rb(0x7a, 99) + b("😀\x00😀")
  bf.write_byte!(68)
  assert_eq bf.bytes, rb(0x7a, 99) + b("😀\x00😀D")
  assert_eq bf.read_byte!, 122
  assert_eq bf.bytes, rb(0x7a, 98) + b("😀\x00😀D")
  assert_eq bf.write_rune!(97), 1
  assert_eq bf.bytes, rb(0x7a, 98) + b("😀\x00😀Da")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, rb(0x7a, 98) + b("😀\x00😀Da")
  bf.grow!(112)
  assert_eq bf.bytes, rb(0x7a, 98) + b("😀\x00😀Da")
  assert_eq bf.read_string!(97), s(rb(0x7a, 98) + b("😀\x00😀Da"))
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(128), 2
  assert_eq bf.bytes, b("\u0080")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("\u0080")
  assert_eq bf.read_string!(97), "\u0080"
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  bf.write_byte!(177)
  assert_eq bf.bytes, x([0xb1])
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  bf.write_byte!(99)
  assert_eq bf.bytes, b("c")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("c")
  assert_eq bf.read_byte!, 99
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(4), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_string!(255).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  bf.write_byte!(152)
  assert_eq bf.bytes, x([0x98])
  bf.grow!(186)
  assert_eq bf.bytes, x([0x98])
  assert_eq bf.write_rune!(55296), 3
  assert_eq bf.bytes, x([0x98, 0xef, 0xbf, 0xbd])
  bf.grow!(67)
  assert_eq bf.bytes, x([0x98, 0xef, 0xbf, 0xbd])
  assert_eq bf.next!(2), x([0x98, 0xef])
  assert_eq bf.bytes, x([0xbf, 0xbd])
  bf.write_byte!(10)
  assert_eq bf.bytes, x([0xbf, 0xbd, 0x0a])
  assert_eq bf.next!(2), x([0xbf, 0xbd])
  assert_eq bf.bytes, b("\n")
  bf.write_byte!(142)
  assert_eq bf.bytes, x([0x0a, 0x8e])
  bf.grow!(80)
  assert_eq bf.bytes, x([0x0a, 0x8e])
  p = rb(0, 6)
  assert_eq bf.read!(p), 2
  assert_eq p[0...2], x([0x0a, 0x8e])
  assert_eq bf.bytes, b("")
}

test "buffer sequence 13" {
  bf = bytes.new_buffer([])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(xs([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0xe2, 0x98])
  assert_eq bf.next!(3), x([0xe2, 0x98])
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(127), 1
  assert_eq bf.bytes, b("\x7f")
  assert_eq bf.write_rune!(1114111), 4
  assert_eq bf.bytes, b("\x7f\U0010FFFF")
  p = rb(0, 0)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("\x7f\U0010FFFF")
  assert_eq bf.read_rune!, (127, 1)
  assert_eq bf.bytes, b("\U0010FFFF")
  p = rb(0, 2)
  assert_eq bf.read!(p), 2
  assert_eq p[0...2], x([0xf4, 0x8f])
  assert_eq bf.bytes, x([0xbf, 0xbf])
  bf.write_byte!(73)
  assert_eq bf.bytes, x([0xbf, 0xbf, 0x49])
  bf.grow!(100)
  assert_eq bf.bytes, x([0xbf, 0xbf, 0x49])
  bf.grow!(91)
  assert_eq bf.bytes, x([0xbf, 0xbf, 0x49])
  bf.write_byte!(120)
  assert_eq bf.bytes, x([0xbf, 0xbf, 0x49, 0x78])
  bf.write_byte!(85)
  assert_eq bf.bytes, x([0xbf, 0xbf, 0x49, 0x78, 0x55])
  p = rb(0, 7)
  assert_eq bf.read!(p), 5
  assert_eq p[0...5], x([0xbf, 0xbf, 0x49, 0x78, 0x55])
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(128), 2
  assert_eq bf.bytes, b("\u0080")
  assert_eq bf.read_rune!, (128, 2)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, true
  assert_eq bf.bytes, b("\u0080")
  assert_eq bf.write_rune!(97), 1
  assert_eq bf.bytes, b("\u0080a")
  assert_eq bf.read_rune!, (128, 2)
  assert_eq bf.bytes, b("a")
  bf.truncate!(1)
  assert_eq bf.bytes, b("a")
  assert_eq bf.read_rune!, (97, 1)
  assert_eq bf.bytes, b("")
  p = rb(0, 7)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(1), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("hello"), 5
  assert_eq bf.bytes, b("hello")
  assert_eq bf.read_rune!, (104, 1)
  assert_eq bf.bytes, b("ello")
  assert_eq bf.read_byte!, 101
  assert_eq bf.bytes, b("llo")
  assert_eq bf.peek(2), b("ll")
  assert_eq bf.bytes, b("llo")
  p = rb(0, 3)
  assert_eq bf.read!(p), 3
  assert_eq p[0...3], b("llo")
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("☺x")), 4
  assert_eq bf.bytes, b("☺x")
  bf.grow!(124)
  assert_eq bf.bytes, b("☺x")
  bf.grow!(12)
  assert_eq bf.bytes, b("☺x")
  bf.grow!(52)
  assert_eq bf.bytes, b("☺x")
  assert_eq bf.read_string!(97), "☺x"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(xs([0xff])), 1
  assert_eq bf.bytes, x([0xff])
  assert_eq bf.read_rune!, (65533, 1)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_byte!.ok?, true
  assert_eq bf.bytes, x([0xff])
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
}

test "buffer sequence 14" {
  bf = bytes.new_buffer([])
  assert_eq bf.write_string!(xs([0xff])), 1
  assert_eq bf.bytes, x([0xff])
  assert_eq bf.read_string!(255), xs([0xff])
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  bf.grow!(20)
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(3), b("")
  assert_eq bf.bytes, b("")
  p = rb(0, 2)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  p = rb(0, 5)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(4), b("")
  assert_eq bf.bytes, b("")
  bf.grow!(11)
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(65533), 3
  assert_eq bf.bytes, b("\uFFFD")
  assert_eq bf.read_string!(10), "\uFFFD"
  assert_eq bf.bytes, b("")
  bf.grow!(87)
  assert_eq bf.bytes, b("")
  bf.write_byte!(146)
  assert_eq bf.bytes, x([0x92])
  assert_eq bf.write!(b("hello")), 5
  assert_eq bf.bytes, x([0x92, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
  assert_eq bf.write_string!("☺x"), 4
  assert_eq bf.bytes, x([0x92, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0x78])
  assert_eq bf.next!(0), b("")
  assert_eq bf.bytes, x([0x92, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0x78])
  bf.write_byte!(77)
  assert_eq bf.bytes, x([0x92, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0x78, 0x4d])
  assert_eq bf.read_byte!, 146
  assert_eq bf.bytes, b("hello☺xM")
  bf.write_byte!(217)
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0x78, 0x4d, 0xd9])
  assert_eq bf.write_string!("a"), 1
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0x78, 0x4d, 0xd9, 0x61])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0x78, 0x4d, 0xd9, 0x61])
  assert_eq bf.write_rune!(97), 1
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0x78, 0x4d, 0xd9, 0x61, 0x61])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0x78, 0x4d, 0xd9, 0x61, 0x61])
  assert_eq bf.peek(5), b("hello")
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xe2, 0x98, 0xba, 0x78, 0x4d, 0xd9, 0x61, 0x61])
  assert_eq bf.next!(5), b("hello")
  assert_eq bf.bytes, x([0xe2, 0x98, 0xba, 0x78, 0x4d, 0xd9, 0x61, 0x61])
  bf.truncate!(5)
  assert_eq bf.bytes, b("☺xM")
  assert_eq bf.read_byte!, 226
  assert_eq bf.bytes, x([0x98, 0xba, 0x78, 0x4d])
  bf.grow!(74)
  assert_eq bf.bytes, x([0x98, 0xba, 0x78, 0x4d])
  assert_eq bf.peek(2), x([0x98, 0xba])
  assert_eq bf.bytes, x([0x98, 0xba, 0x78, 0x4d])
  assert_eq bf.write_string!(xs([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0x98, 0xba, 0x78, 0x4d, 0xe2, 0x98])
  assert_eq bf.peek(4), x([0x98, 0xba, 0x78, 0x4d])
  assert_eq bf.bytes, x([0x98, 0xba, 0x78, 0x4d, 0xe2, 0x98])
  bf.write_byte!(48)
  assert_eq bf.bytes, x([0x98, 0xba, 0x78, 0x4d, 0xe2, 0x98, 0x30])
  bf.truncate!(1)
  assert_eq bf.bytes, x([0x98])
  assert_eq bf.peek(5), x([0x98])
  assert_eq bf.bytes, x([0x98])
  assert_eq bf.next!(2), x([0x98])
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("line\n")), 5
  assert_eq bf.bytes, b("line\n")
  bf.write_byte!(131)
  assert_eq bf.bytes, x([0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x83])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, x([0x6c, 0x69, 0x6e, 0x65, 0x0a, 0x83])
  bf.truncate!(5)
  assert_eq bf.bytes, b("line\n")
  assert_eq bf.read_rune!, (108, 1)
  assert_eq bf.bytes, b("ine\n")
}

test "buffer sequence 15" {
  bf = bytes.new_buffer([])
  assert_eq bf.write!(b("a")), 1
  assert_eq bf.bytes, b("a")
  assert_eq bf.read_rune!, (97, 1)
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, true
  assert_eq bf.bytes, b("a")
  bf.grow!(134)
  assert_eq bf.bytes, b("a")
  bf.write_byte!(5)
  assert_eq bf.bytes, b("a\x05")
  bf.write_byte!(155)
  assert_eq bf.bytes, x([0x61, 0x05, 0x9b])
  assert_eq bf.read_byte!, 97
  assert_eq bf.bytes, x([0x05, 0x9b])
  bf.truncate!(0)
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(3), b("")
  assert_eq bf.bytes, b("")
  bf.write_byte!(170)
  assert_eq bf.bytes, x([0xaa])
  assert_eq bf.next!(3), x([0xaa])
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_rune!(255), 2
  assert_eq bf.bytes, b("ÿ")
  assert_eq bf.next!(4), b("ÿ")
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(2), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, b("")
  assert_eq bf.next!(1), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.write!(b("a")), 1
  assert_eq bf.bytes, b("a")
  assert_eq bf.peek(1), b("a")
  assert_eq bf.bytes, b("a")
  assert_eq bf.write_rune!(97), 1
  assert_eq bf.bytes, b("aa")
  assert_eq bf.write!(b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")), 100
  assert_eq bf.bytes, b("aa") + rb(0x7a, 100)
  assert_eq bf.write_string!(""), 0
  assert_eq bf.bytes, b("aa") + rb(0x7a, 100)
  p = rb(0, 4)
  assert_eq bf.read!(p), 4
  assert_eq p[0...4], b("aazz")
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.read_string!(44), "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!("hello"), 5
  assert_eq bf.bytes, b("hello")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("hello")
  bf.grow!(189)
  assert_eq bf.bytes, b("hello")
  bf.write_byte!(190)
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xbe])
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, x([0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xbe])
  bf.truncate!(2)
  assert_eq bf.bytes, b("he")
  assert_eq bf.read_byte!, 104
  assert_eq bf.bytes, b("e")
  assert_eq bf.peek(1), b("e")
  assert_eq bf.bytes, b("e")
  bf.write_byte!(215)
  assert_eq bf.bytes, x([0x65, 0xd7])
  p = rb(0, 7)
  assert_eq bf.read!(p), 2
  assert_eq p[0...2], x([0x65, 0xd7])
  assert_eq bf.bytes, b("")
  assert bf.read_byte!.none?, "read_byte! at the end"
  assert_eq bf.bytes, b("")
  p = rb(0, 3)
  assert_eq bf.read!(p), 0
  assert_eq p[0...0], b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(3), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_rune!.none?, "read_rune! at the end"
  assert_eq bf.bytes, b("")
  bf.grow!(153)
  assert_eq bf.bytes, b("")
  bf.grow!(81)
  assert_eq bf.bytes, b("")
}

test "buffer sequence 16" {
  bf = bytes.new_buffer([])
  assert_eq bf.peek(0), b("")
  assert_eq bf.bytes, b("")
  assert_eq bf.peek(4), b("")
  assert_eq bf.bytes, b("")
  assert bf.read_string!(44).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert bf.read_string!(255).none?, "read_string! at the end"
  assert_eq bf.bytes, b("")
  assert_eq bf.write_string!(",,"), 2
  assert_eq bf.bytes, b(",,")
  assert_eq bf.write_string!("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"), 100
  assert_eq bf.bytes, b(",,") + rb(0x7a, 100)
  assert_eq bf.write!(b(",,")), 2
  assert_eq bf.bytes, b(",,") + rb(0x7a, 100) + b(",,")
  p = rb(0, 5)
  assert_eq bf.read!(p), 5
  assert_eq p[0...5], b(",,zzz")
  assert_eq bf.bytes, rb(0x7a, 97) + b(",,")
  assert_eq bf.next!(5), b("zzzzz")
  assert_eq bf.bytes, rb(0x7a, 92) + b(",,")
  assert_eq bf.peek(5), b("zzzzz")
  assert_eq bf.bytes, rb(0x7a, 92) + b(",,")
  bf.write_byte!(102)
  assert_eq bf.bytes, rb(0x7a, 92) + b(",,f")
  p = rb(0, 1)
  assert_eq bf.read!(p), 1
  assert_eq p[0...1], b("z")
  assert_eq bf.bytes, rb(0x7a, 91) + b(",,f")
  assert_eq bf.peek(3), b("zzz")
  assert_eq bf.bytes, rb(0x7a, 91) + b(",,f")
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, rb(0x7a, 91) + b(",,f")
  bf.write_byte!(35)
  assert_eq bf.bytes, rb(0x7a, 91) + b(",,f#")
  bf.truncate!(55)
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  assert_eq bf.unread_byte!.ok?, false
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  bf.write_byte!(107)
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzk")
  assert_eq bf.write_string!(",,"), 2
  assert_eq bf.bytes, b("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzk,,")
  assert_eq bf.write_string!(xs([0xe2, 0x98])), 2
  assert_eq bf.bytes, x([0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x6b, 0x2c, 0x2c, 0xe2, 0x98])
  assert_eq bf.unread_rune!.ok?, false
  assert_eq bf.bytes, x([0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x7a, 0x6b, 0x2c, 0x2c, 0xe2, 0x98])
  assert_eq bf.read_rune!, (122, 1)
