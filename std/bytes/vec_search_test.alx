  assert_eq (strs(bytes.split(a, b("\uFFFD"))), strs(bytes.split_after(a, b("\uFFFD")))), (["Привет мир"], ["Привет мир"])
  assert_eq (bytes.replace(a, b("\uFFFD"), b("<>"), -1), bytes.replace(a, b("\uFFFD"), b("<>"), 1), bytes.replace(a, b("\uFFFD"), b("<>"), 2)), (b("Привет мир"), b("Привет мир"), b("Привет мир"))
  assert_eq (bytes.index(a, b("ß")), bytes.last_index(a, b("ß")), bytes.count(a, b("ß")), bytes.has_prefix(a, b("ß")), bytes.has_suffix(a, b("ß"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ß"))), cut3(a, bytes.cut_last(a, b("ß")))), (("Привет мир", "", false), ("Привет мир", "", false))
  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), (["Привет мир"], ["Привет мир"])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (b("Привет мир"), b("Привет мир"), b("Привет мир"))
  assert_eq (bytes.index_any(a, ""), bytes.last_index_any(a, "")), (-1, -1)
  assert_eq (bytes.index_any(a, "a"), bytes.last_index_any(a, "a")), (-1, -1)
  assert_eq (bytes.index_any(a, "ab"), bytes.last_index_any(a, "ab")), (-1, -1)
  assert_eq (bytes.index_any(a, " \t"), bytes.last_index_any(a, " \t")), (12, 12)
  assert_eq (bytes.index_any(a, "abc "), bytes.last_index_any(a, "abc ")), (12, 12)
  assert_eq (bytes.index_any(a, "☺"), bytes.last_index_any(a, "☺")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xff])), bytes.last_index_any(a, xs([0xff]))), (-1, -1)
  assert_eq (bytes.index_any(a, "\uFFFD"), bytes.last_index_any(a, "\uFFFD")), (-1, -1)
  assert_eq (bytes.index_any(a, "aß☺"), bytes.last_index_any(a, "aß☺")), (-1, -1)
  assert_eq (bytes.index_any(a, "日本"), bytes.last_index_any(a, "日本")), (-1, -1)
  assert_eq (bytes.index_any(a, ","), bytes.last_index_any(a, ",")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xe2, 0x98])), bytes.last_index_any(a, xs([0xe2, 0x98]))), (-1, -1)
  assert_eq bytes.index_rune(a, 97), -1
  assert_eq bytes.index_rune(a, 32), 12
  assert_eq bytes.index_rune(a, 65533), -1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (-1, -1)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (-1, -1)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (12, 12)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (3, 18)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (-1, -1)
}
test "search 23" {
  a = b("ß ẞ")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 6, 4, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "ß ẞ", true), ("ß ẞ", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["ß", " ", "ẞ"], ["ß", " ", "ẞ"])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["ß ẞ"], ["ß ẞ"])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), (["ß", " ẞ"], ["ß", " ẞ"])
  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), (["ß", " ", "ẞ"], ["ß", " ", "ẞ"])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<>ß<> <>ẞ<>"), b("<>ß ẞ"), b("<>ß<> ẞ"))
  assert_eq (bytes.index(a, b("a")), bytes.last_index(a, b("a")), bytes.count(a, b("a")), bytes.has_prefix(a, b("a")), bytes.has_suffix(a, b("a"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("a"))), cut3(a, bytes.cut_last(a, b("a")))), (("ß ẞ", "", false), ("ß ẞ", "", false))
  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), (["ß ẞ"], ["ß ẞ"])
  assert_eq (bytes.replace(a, b("a"), b("<>"), -1), bytes.replace(a, b("a"), b("<>"), 1), bytes.replace(a, b("a"), b("<>"), 2)), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.index(a, b(",")), bytes.last_index(a, b(",")), bytes.count(a, b(",")), bytes.has_prefix(a, b(",")), bytes.has_suffix(a, b(","))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b(","))), cut3(a, bytes.cut_last(a, b(",")))), (("ß ẞ", "", false), ("ß ẞ", "", false))
  assert_eq (strs(bytes.split(a, b(","))), strs(bytes.split_after(a, b(",")))), (["ß ẞ"], ["ß ẞ"])
  assert_eq (strs(bytes.split_n(a, b(","), 0)), strs(bytes.split_after_n(a, b(","), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(","), 1)), strs(bytes.split_after_n(a, b(","), 1))), (["ß ẞ"], ["ß ẞ"])
  assert_eq (strs(bytes.split_n(a, b(","), 2)), strs(bytes.split_after_n(a, b(","), 2))), (["ß ẞ"], ["ß ẞ"])
  assert_eq (strs(bytes.split_n(a, b(","), 3)), strs(bytes.split_after_n(a, b(","), 3))), (["ß ẞ"], ["ß ẞ"])
  assert_eq (bytes.replace(a, b(","), b("<>"), -1), bytes.replace(a, b(","), b("<>"), 1), bytes.replace(a, b(","), b("<>"), 2)), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.index(a, b("ab")), bytes.last_index(a, b("ab")), bytes.count(a, b("ab")), bytes.has_prefix(a, b("ab")), bytes.has_suffix(a, b("ab"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ab"))), cut3(a, bytes.cut_last(a, b("ab")))), (("ß ẞ", "", false), ("ß ẞ", "", false))
  assert_eq (strs(bytes.split(a, b("ab"))), strs(bytes.split_after(a, b("ab")))), (["ß ẞ"], ["ß ẞ"])
  assert_eq (bytes.replace(a, b("ab"), b("<>"), -1), bytes.replace(a, b("ab"), b("<>"), 1), bytes.replace(a, b("ab"), b("<>"), 2)), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.index(a, b("☺")), bytes.last_index(a, b("☺")), bytes.count(a, b("☺")), bytes.has_prefix(a, b("☺")), bytes.has_suffix(a, b("☺"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("☺"))), cut3(a, bytes.cut_last(a, b("☺")))), (("ß ẞ", "", false), ("ß ẞ", "", false))
  assert_eq (strs(bytes.split(a, b("☺"))), strs(bytes.split_after(a, b("☺")))), (["ß ẞ"], ["ß ẞ"])
  assert_eq (bytes.replace(a, b("☺"), b("<>"), -1), bytes.replace(a, b("☺"), b("<>"), 1), bytes.replace(a, b("☺"), b("<>"), 2)), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.index(a, x([0xff])), bytes.last_index(a, x([0xff])), bytes.count(a, x([0xff])), bytes.has_prefix(a, x([0xff])), bytes.has_suffix(a, x([0xff]))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, x([0xff]))), cut3(a, bytes.cut_last(a, x([0xff])))), (("ß ẞ", "", false), ("ß ẞ", "", false))
  assert_eq (strs(bytes.split(a, x([0xff]))), strs(bytes.split_after(a, x([0xff])))), (["ß ẞ"], ["ß ẞ"])
  assert_eq (bytes.replace(a, x([0xff]), b("<>"), -1), bytes.replace(a, x([0xff]), b("<>"), 1), bytes.replace(a, x([0xff]), b("<>"), 2)), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.index(a, b("\uFFFD")), bytes.last_index(a, b("\uFFFD")), bytes.count(a, b("\uFFFD")), bytes.has_prefix(a, b("\uFFFD")), bytes.has_suffix(a, b("\uFFFD"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("\uFFFD"))), cut3(a, bytes.cut_last(a, b("\uFFFD")))), (("ß ẞ", "", false), ("ß ẞ", "", false))
  assert_eq (strs(bytes.split(a, b("\uFFFD"))), strs(bytes.split_after(a, b("\uFFFD")))), (["ß ẞ"], ["ß ẞ"])
  assert_eq (bytes.replace(a, b("\uFFFD"), b("<>"), -1), bytes.replace(a, b("\uFFFD"), b("<>"), 1), bytes.replace(a, b("\uFFFD"), b("<>"), 2)), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.index(a, b("ß")), bytes.last_index(a, b("ß")), bytes.count(a, b("ß")), bytes.has_prefix(a, b("ß")), bytes.has_suffix(a, b("ß"))), (0, 0, 1, true, false)
  assert_eq (cut3(a, bytes.cut(a, b("ß"))), cut3(a, bytes.cut_last(a, b("ß")))), (("", " ẞ", true), ("", " ẞ", true))
  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), (["", " ẞ"], ["ß", " ẞ"])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (b("<> ẞ"), b("<> ẞ"), b("<> ẞ"))
  assert_eq (bytes.index_any(a, ""), bytes.last_index_any(a, "")), (-1, -1)
  assert_eq (bytes.index_any(a, "a"), bytes.last_index_any(a, "a")), (-1, -1)
  assert_eq (bytes.index_any(a, "ab"), bytes.last_index_any(a, "ab")), (-1, -1)
  assert_eq (bytes.index_any(a, " \t"), bytes.last_index_any(a, " \t")), (2, 2)
  assert_eq (bytes.index_any(a, "abc "), bytes.last_index_any(a, "abc ")), (2, 2)
  assert_eq (bytes.index_any(a, "☺"), bytes.last_index_any(a, "☺")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xff])), bytes.last_index_any(a, xs([0xff]))), (-1, -1)
  assert_eq (bytes.index_any(a, "\uFFFD"), bytes.last_index_any(a, "\uFFFD")), (-1, -1)
  assert_eq (bytes.index_any(a, "aß☺"), bytes.last_index_any(a, "aß☺")), (0, 0)
  assert_eq (bytes.index_any(a, "日本"), bytes.last_index_any(a, "日本")), (-1, -1)
  assert_eq (bytes.index_any(a, ","), bytes.last_index_any(a, ",")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xe2, 0x98])), bytes.last_index_any(a, xs([0xe2, 0x98]))), (-1, -1)
  assert_eq bytes.index_rune(a, 97), -1
  assert_eq bytes.index_rune(a, 32), 2
  assert_eq bytes.index_rune(a, 223), 0
  assert_eq bytes.index_rune(a, 65533), -1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (-1, -1)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (-1, -1)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (2, 2)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (-1, -1)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (-1, -1)
}
test "search 24" {
  a = b("İı Iı")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 8, 6, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "İı Iı", true), ("İı Iı", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["İ", "ı", " ", "I", "ı"], ["İ", "ı", " ", "I", "ı"])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["İı Iı"], ["İı Iı"])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), (["İ", "ı Iı"], ["İ", "ı Iı"])
