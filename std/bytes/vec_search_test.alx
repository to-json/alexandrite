  assert_eq (cut3(a, bytes.cut(a, b("\uFFFD"))), cut3(a, bytes.cut_last(a, b("\uFFFD")))), (("a", xs([0x62, 0xff, 0x63]), true), ("a", xs([0x62, 0xff, 0x63]), true))
  assert_eq (strs(bytes.split(a, b("\uFFFD"))), strs(bytes.split_after(a, b("\uFFFD")))), (["a", xs([0x62, 0xff, 0x63])], ["a\uFFFD", xs([0x62, 0xff, 0x63])])
