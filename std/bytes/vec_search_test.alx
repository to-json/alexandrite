#![test(external)]
# Generated from Go's bytes (Index, LastIndex, Count, Contains, HasPrefix/Suffix, Cut, CutLast, Split*, Replace, IndexAny, IndexRune, IndexByte, go1.27 on darwin/arm64); do not edit by hand.
# The generator is a throwaway Go program; the helpers are in go_bytes_test.alx.

import "bytes"

