  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", xs([0x61, 0xff, 0x62]), true), (xs([0x61, 0xff, 0x62]), "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["a", xs([0xff]), "b"], ["a", xs([0xff]), "b"])
