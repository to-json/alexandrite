  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (-1, -1)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (-1, -1)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (-1, -1)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (6, 10)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (5, 5)
}
test "search 16" {
  a = b("\u1680a\u2028b\u2029")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 11, 6, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "\u1680a\u2028b\u2029", true), ("\u1680a\u2028b\u2029", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["\u1680", "a", "\u2028", "b", "\u2029"], ["\u1680", "a", "\u2028", "b", "\u2029"])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["\u1680a\u2028b\u2029"], ["\u1680a\u2028b\u2029"])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), (["\u1680", "a\u2028b\u2029"], ["\u1680", "a\u2028b\u2029"])
  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), (["\u1680", "a", "\u2028b\u2029"], ["\u1680", "a", "\u2028b\u2029"])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<>\u1680<>a<>\u2028<>b<>\u2029<>"), b("<>\u1680a\u2028b\u2029"), b("<>\u1680<>a\u2028b\u2029"))
  assert_eq (bytes.index(a, b("a")), bytes.last_index(a, b("a")), bytes.count(a, b("a")), bytes.has_prefix(a, b("a")), bytes.has_suffix(a, b("a"))), (3, 3, 1, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("a"))), cut3(a, bytes.cut_last(a, b("a")))), (("\u1680", "\u2028b\u2029", true), ("\u1680", "\u2028b\u2029", true))
  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), (["\u1680", "\u2028b\u2029"], ["\u1680a", "\u2028b\u2029"])
