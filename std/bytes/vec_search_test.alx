  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), (["", " b  c\td\n"], ["a", " b  c\td\n"])
  assert_eq (bytes.replace(a, b("a"), b("<>"), -1), bytes.replace(a, b("a"), b("<>"), 1), bytes.replace(a, b("a"), b("<>"), 2)), (b("<> b  c\td\n"), b("<> b  c\td\n"), b("<> b  c\td\n"))
