  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), (["1", "2", "3 456"], ["1", "2", "3 456"])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<>1<>2<>3<> <>4<>5<>6<>"), b("<>123 456"), b("<>1<>23 456"))
