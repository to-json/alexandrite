  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), (["123 456"], ["123 456"])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (b("123 456"), b("123 456"), b("123 456"))
