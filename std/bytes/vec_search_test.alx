  assert_eq (cut3(a, bytes.cut(a, b("ab"))), cut3(a, bytes.cut_last(a, b("ab")))), (("\u1680a\u2028b\u2029", "", false), ("\u1680a\u2028b\u2029", "", false))
  assert_eq (strs(bytes.split(a, b("ab"))), strs(bytes.split_after(a, b("ab")))), (["\u1680a\u2028b\u2029"], ["\u1680a\u2028b\u2029"])
  assert_eq (bytes.replace(a, b("ab"), b("<>"), -1), bytes.replace(a, b("ab"), b("<>"), 1), bytes.replace(a, b("ab"), b("<>"), 2)), (b("\u1680a\u2028b\u2029"), b("\u1680a\u2028b\u2029"), b("\u1680a\u2028b\u2029"))
