  assert_eq bytes.index_rune(a, 65533), -1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (0, 0)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (-1, -1)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (1, 4)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (-1, -1)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (-1, -1)
}
test "search 12" {
  a = b("  leading")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 9, 10, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "  leading", true), ("  leading", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), ([" ", " ", "l", "e", "a", "d", "i", "n", "g"], [" ", " ", "l", "e", "a", "d", "i", "n", "g"])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["  leading"], ["  leading"])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), ([" ", " leading"], [" ", " leading"])
  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), ([" ", " ", "leading"], [" ", " ", "leading"])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<> <> <>l<>e<>a<>d<>i<>n<>g<>"), b("<>  leading"), b("<> <> leading"))
  assert_eq (bytes.index(a, b("a")), bytes.last_index(a, b("a")), bytes.count(a, b("a")), bytes.has_prefix(a, b("a")), bytes.has_suffix(a, b("a"))), (4, 4, 1, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("a"))), cut3(a, bytes.cut_last(a, b("a")))), (("  le", "ding", true), ("  le", "ding", true))
  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), (["  le", "ding"], ["  lea", "ding"])
  assert_eq (bytes.replace(a, b("a"), b("<>"), -1), bytes.replace(a, b("a"), b("<>"), 1), bytes.replace(a, b("a"), b("<>"), 2)), (b("  le<>ding"), b("  le<>ding"), b("  le<>ding"))
  assert_eq (bytes.index(a, b(",")), bytes.last_index(a, b(",")), bytes.count(a, b(",")), bytes.has_prefix(a, b(",")), bytes.has_suffix(a, b(","))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b(","))), cut3(a, bytes.cut_last(a, b(",")))), (("  leading", "", false), ("  leading", "", false))
  assert_eq (strs(bytes.split(a, b(","))), strs(bytes.split_after(a, b(",")))), (["  leading"], ["  leading"])
  assert_eq (strs(bytes.split_n(a, b(","), 0)), strs(bytes.split_after_n(a, b(","), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(","), 1)), strs(bytes.split_after_n(a, b(","), 1))), (["  leading"], ["  leading"])
  assert_eq (strs(bytes.split_n(a, b(","), 2)), strs(bytes.split_after_n(a, b(","), 2))), (["  leading"], ["  leading"])
  assert_eq (strs(bytes.split_n(a, b(","), 3)), strs(bytes.split_after_n(a, b(","), 3))), (["  leading"], ["  leading"])
  assert_eq (bytes.replace(a, b(","), b("<>"), -1), bytes.replace(a, b(","), b("<>"), 1), bytes.replace(a, b(","), b("<>"), 2)), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq (bytes.index(a, b("ab")), bytes.last_index(a, b("ab")), bytes.count(a, b("ab")), bytes.has_prefix(a, b("ab")), bytes.has_suffix(a, b("ab"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ab"))), cut3(a, bytes.cut_last(a, b("ab")))), (("  leading", "", false), ("  leading", "", false))
  assert_eq (strs(bytes.split(a, b("ab"))), strs(bytes.split_after(a, b("ab")))), (["  leading"], ["  leading"])
  assert_eq (bytes.replace(a, b("ab"), b("<>"), -1), bytes.replace(a, b("ab"), b("<>"), 1), bytes.replace(a, b("ab"), b("<>"), 2)), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq (bytes.index(a, b("☺")), bytes.last_index(a, b("☺")), bytes.count(a, b("☺")), bytes.has_prefix(a, b("☺")), bytes.has_suffix(a, b("☺"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("☺"))), cut3(a, bytes.cut_last(a, b("☺")))), (("  leading", "", false), ("  leading", "", false))
  assert_eq (strs(bytes.split(a, b("☺"))), strs(bytes.split_after(a, b("☺")))), (["  leading"], ["  leading"])
  assert_eq (bytes.replace(a, b("☺"), b("<>"), -1), bytes.replace(a, b("☺"), b("<>"), 1), bytes.replace(a, b("☺"), b("<>"), 2)), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq (bytes.index(a, x([0xff])), bytes.last_index(a, x([0xff])), bytes.count(a, x([0xff])), bytes.has_prefix(a, x([0xff])), bytes.has_suffix(a, x([0xff]))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, x([0xff]))), cut3(a, bytes.cut_last(a, x([0xff])))), (("  leading", "", false), ("  leading", "", false))
  assert_eq (strs(bytes.split(a, x([0xff]))), strs(bytes.split_after(a, x([0xff])))), (["  leading"], ["  leading"])
  assert_eq (bytes.replace(a, x([0xff]), b("<>"), -1), bytes.replace(a, x([0xff]), b("<>"), 1), bytes.replace(a, x([0xff]), b("<>"), 2)), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq (bytes.index(a, b("\uFFFD")), bytes.last_index(a, b("\uFFFD")), bytes.count(a, b("\uFFFD")), bytes.has_prefix(a, b("\uFFFD")), bytes.has_suffix(a, b("\uFFFD"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("\uFFFD"))), cut3(a, bytes.cut_last(a, b("\uFFFD")))), (("  leading", "", false), ("  leading", "", false))
  assert_eq (strs(bytes.split(a, b("\uFFFD"))), strs(bytes.split_after(a, b("\uFFFD")))), (["  leading"], ["  leading"])
  assert_eq (bytes.replace(a, b("\uFFFD"), b("<>"), -1), bytes.replace(a, b("\uFFFD"), b("<>"), 1), bytes.replace(a, b("\uFFFD"), b("<>"), 2)), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq (bytes.index(a, b("ß")), bytes.last_index(a, b("ß")), bytes.count(a, b("ß")), bytes.has_prefix(a, b("ß")), bytes.has_suffix(a, b("ß"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ß"))), cut3(a, bytes.cut_last(a, b("ß")))), (("  leading", "", false), ("  leading", "", false))
  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), (["  leading"], ["  leading"])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq (bytes.index_any(a, ""), bytes.last_index_any(a, "")), (-1, -1)
  assert_eq (bytes.index_any(a, "a"), bytes.last_index_any(a, "a")), (4, 4)
  assert_eq (bytes.index_any(a, "ab"), bytes.last_index_any(a, "ab")), (4, 4)
  assert_eq (bytes.index_any(a, " \t"), bytes.last_index_any(a, " \t")), (0, 1)
  assert_eq (bytes.index_any(a, "abc "), bytes.last_index_any(a, "abc ")), (0, 4)
  assert_eq (bytes.index_any(a, "☺"), bytes.last_index_any(a, "☺")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xff])), bytes.last_index_any(a, xs([0xff]))), (-1, -1)
  assert_eq (bytes.index_any(a, "\uFFFD"), bytes.last_index_any(a, "\uFFFD")), (-1, -1)
  assert_eq (bytes.index_any(a, "aß☺"), bytes.last_index_any(a, "aß☺")), (4, 4)
  assert_eq (bytes.index_any(a, "日本"), bytes.last_index_any(a, "日本")), (-1, -1)
  assert_eq (bytes.index_any(a, ","), bytes.last_index_any(a, ",")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xe2, 0x98])), bytes.last_index_any(a, xs([0xe2, 0x98]))), (-1, -1)
  assert_eq bytes.index_rune(a, 97), 4
  assert_eq bytes.index_rune(a, 32), 0
  assert_eq bytes.index_rune(a, 65533), -1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (4, 4)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (-1, -1)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (0, 1)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (-1, -1)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (-1, -1)
}
test "search 13" {
  a = b("trailing  ")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 10, 11, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "trailing  ", true), ("trailing  ", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["t", "r", "a", "i", "l", "i", "n", "g", " ", " "], ["t", "r", "a", "i", "l", "i", "n", "g", " ", " "])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["trailing  "], ["trailing  "])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), (["t", "railing  "], ["t", "railing  "])
  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), (["t", "r", "ailing  "], ["t", "r", "ailing  "])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<>t<>r<>a<>i<>l<>i<>n<>g<> <> <>"), b("<>trailing  "), b("<>t<>railing  "))
  assert_eq (bytes.index(a, b("a")), bytes.last_index(a, b("a")), bytes.count(a, b("a")), bytes.has_prefix(a, b("a")), bytes.has_suffix(a, b("a"))), (2, 2, 1, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("a"))), cut3(a, bytes.cut_last(a, b("a")))), (("tr", "iling  ", true), ("tr", "iling  ", true))
  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), (["tr", "iling  "], ["tra", "iling  "])
  assert_eq (bytes.replace(a, b("a"), b("<>"), -1), bytes.replace(a, b("a"), b("<>"), 1), bytes.replace(a, b("a"), b("<>"), 2)), (b("tr<>iling  "), b("tr<>iling  "), b("tr<>iling  "))
  assert_eq (bytes.index(a, b(",")), bytes.last_index(a, b(",")), bytes.count(a, b(",")), bytes.has_prefix(a, b(",")), bytes.has_suffix(a, b(","))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b(","))), cut3(a, bytes.cut_last(a, b(",")))), (("trailing  ", "", false), ("trailing  ", "", false))
  assert_eq (strs(bytes.split(a, b(","))), strs(bytes.split_after(a, b(",")))), (["trailing  "], ["trailing  "])
  assert_eq (strs(bytes.split_n(a, b(","), 0)), strs(bytes.split_after_n(a, b(","), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(","), 1)), strs(bytes.split_after_n(a, b(","), 1))), (["trailing  "], ["trailing  "])
  assert_eq (strs(bytes.split_n(a, b(","), 2)), strs(bytes.split_after_n(a, b(","), 2))), (["trailing  "], ["trailing  "])
  assert_eq (strs(bytes.split_n(a, b(","), 3)), strs(bytes.split_after_n(a, b(","), 3))), (["trailing  "], ["trailing  "])
  assert_eq (bytes.replace(a, b(","), b("<>"), -1), bytes.replace(a, b(","), b("<>"), 1), bytes.replace(a, b(","), b("<>"), 2)), (b("trailing  "), b("trailing  "), b("trailing  "))
  assert_eq (bytes.index(a, b("ab")), bytes.last_index(a, b("ab")), bytes.count(a, b("ab")), bytes.has_prefix(a, b("ab")), bytes.has_suffix(a, b("ab"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ab"))), cut3(a, bytes.cut_last(a, b("ab")))), (("trailing  ", "", false), ("trailing  ", "", false))
  assert_eq (strs(bytes.split(a, b("ab"))), strs(bytes.split_after(a, b("ab")))), (["trailing  "], ["trailing  "])
  assert_eq (bytes.replace(a, b("ab"), b("<>"), -1), bytes.replace(a, b("ab"), b("<>"), 1), bytes.replace(a, b("ab"), b("<>"), 2)), (b("trailing  "), b("trailing  "), b("trailing  "))
  assert_eq (bytes.index(a, b("☺")), bytes.last_index(a, b("☺")), bytes.count(a, b("☺")), bytes.has_prefix(a, b("☺")), bytes.has_suffix(a, b("☺"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("☺"))), cut3(a, bytes.cut_last(a, b("☺")))), (("trailing  ", "", false), ("trailing  ", "", false))
  assert_eq (strs(bytes.split(a, b("☺"))), strs(bytes.split_after(a, b("☺")))), (["trailing  "], ["trailing  "])
  assert_eq (bytes.replace(a, b("☺"), b("<>"), -1), bytes.replace(a, b("☺"), b("<>"), 1), bytes.replace(a, b("☺"), b("<>"), 2)), (b("trailing  "), b("trailing  "), b("trailing  "))
  assert_eq (bytes.index(a, x([0xff])), bytes.last_index(a, x([0xff])), bytes.count(a, x([0xff])), bytes.has_prefix(a, x([0xff])), bytes.has_suffix(a, x([0xff]))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, x([0xff]))), cut3(a, bytes.cut_last(a, x([0xff])))), (("trailing  ", "", false), ("trailing  ", "", false))
  assert_eq (strs(bytes.split(a, x([0xff]))), strs(bytes.split_after(a, x([0xff])))), (["trailing  "], ["trailing  "])
  assert_eq (bytes.replace(a, x([0xff]), b("<>"), -1), bytes.replace(a, x([0xff]), b("<>"), 1), bytes.replace(a, x([0xff]), b("<>"), 2)), (b("trailing  "), b("trailing  "), b("trailing  "))
  assert_eq (bytes.index(a, b("\uFFFD")), bytes.last_index(a, b("\uFFFD")), bytes.count(a, b("\uFFFD")), bytes.has_prefix(a, b("\uFFFD")), bytes.has_suffix(a, b("\uFFFD"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("\uFFFD"))), cut3(a, bytes.cut_last(a, b("\uFFFD")))), (("trailing  ", "", false), ("trailing  ", "", false))
  assert_eq (strs(bytes.split(a, b("\uFFFD"))), strs(bytes.split_after(a, b("\uFFFD")))), (["trailing  "], ["trailing  "])
  assert_eq (bytes.replace(a, b("\uFFFD"), b("<>"), -1), bytes.replace(a, b("\uFFFD"), b("<>"), 1), bytes.replace(a, b("\uFFFD"), b("<>"), 2)), (b("trailing  "), b("trailing  "), b("trailing  "))
  assert_eq (bytes.index(a, b("ß")), bytes.last_index(a, b("ß")), bytes.count(a, b("ß")), bytes.has_prefix(a, b("ß")), bytes.has_suffix(a, b("ß"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ß"))), cut3(a, bytes.cut_last(a, b("ß")))), (("trailing  ", "", false), ("trailing  ", "", false))
  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), (["trailing  "], ["trailing  "])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (b("trailing  "), b("trailing  "), b("trailing  "))
  assert_eq (bytes.index_any(a, ""), bytes.last_index_any(a, "")), (-1, -1)
  assert_eq (bytes.index_any(a, "a"), bytes.last_index_any(a, "a")), (2, 2)
  assert_eq (bytes.index_any(a, "ab"), bytes.last_index_any(a, "ab")), (2, 2)
  assert_eq (bytes.index_any(a, " \t"), bytes.last_index_any(a, " \t")), (8, 9)
  assert_eq (bytes.index_any(a, "abc "), bytes.last_index_any(a, "abc ")), (2, 9)
  assert_eq (bytes.index_any(a, "☺"), bytes.last_index_any(a, "☺")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xff])), bytes.last_index_any(a, xs([0xff]))), (-1, -1)
  assert_eq (bytes.index_any(a, "\uFFFD"), bytes.last_index_any(a, "\uFFFD")), (-1, -1)
  assert_eq (bytes.index_any(a, "aß☺"), bytes.last_index_any(a, "aß☺")), (2, 2)
  assert_eq (bytes.index_any(a, "日本"), bytes.last_index_any(a, "日本")), (-1, -1)
  assert_eq (bytes.index_any(a, ","), bytes.last_index_any(a, ",")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xe2, 0x98])), bytes.last_index_any(a, xs([0xe2, 0x98]))), (-1, -1)
  assert_eq bytes.index_rune(a, 97), 2
  assert_eq bytes.index_rune(a, 32), 8
  assert_eq bytes.index_rune(a, 65533), -1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (2, 2)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (-1, -1)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (8, 9)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (-1, -1)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (-1, -1)
}
test "search 14" {
  a = b(" \t\n\x0b\x0c\r ")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 7, 8, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", " \t\n\x0b\x0c\r ", true), (" \t\n\x0b\x0c\r ", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), ([" ", "\t", "\n", "\x0b", "\x0c", "\r", " "], [" ", "\t", "\n", "\x0b", "\x0c", "\r", " "])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), ([" \t\n\x0b\x0c\r "], [" \t\n\x0b\x0c\r "])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), ([" ", "\t\n\x0b\x0c\r "], [" ", "\t\n\x0b\x0c\r "])
  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), ([" ", "\t", "\n\x0b\x0c\r "], [" ", "\t", "\n\x0b\x0c\r "])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<> <>\t<>\n<>\x0b<>\x0c<>\r<> <>"), b("<> \t\n\x0b\x0c\r "), b("<> <>\t\n\x0b\x0c\r "))
  assert_eq (bytes.index(a, b("a")), bytes.last_index(a, b("a")), bytes.count(a, b("a")), bytes.has_prefix(a, b("a")), bytes.has_suffix(a, b("a"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("a"))), cut3(a, bytes.cut_last(a, b("a")))), ((" \t\n\x0b\x0c\r ", "", false), (" \t\n\x0b\x0c\r ", "", false))
  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), ([" \t\n\x0b\x0c\r "], [" \t\n\x0b\x0c\r "])
  assert_eq (bytes.replace(a, b("a"), b("<>"), -1), bytes.replace(a, b("a"), b("<>"), 1), bytes.replace(a, b("a"), b("<>"), 2)), (b(" \t\n\x0b\x0c\r "), b(" \t\n\x0b\x0c\r "), b(" \t\n\x0b\x0c\r "))
  assert_eq (bytes.index(a, b(",")), bytes.last_index(a, b(",")), bytes.count(a, b(",")), bytes.has_prefix(a, b(",")), bytes.has_suffix(a, b(","))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b(","))), cut3(a, bytes.cut_last(a, b(",")))), ((" \t\n\x0b\x0c\r ", "", false), (" \t\n\x0b\x0c\r ", "", false))
  assert_eq (strs(bytes.split(a, b(","))), strs(bytes.split_after(a, b(",")))), ([" \t\n\x0b\x0c\r "], [" \t\n\x0b\x0c\r "])
  assert_eq (strs(bytes.split_n(a, b(","), 0)), strs(bytes.split_after_n(a, b(","), 0))), ([], [])
