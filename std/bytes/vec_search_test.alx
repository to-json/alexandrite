  assert_eq (cut3(a, bytes.cut(a, b("ß"))), cut3(a, bytes.cut_last(a, b("ß")))), ((xs([0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63]), "", false), (xs([0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63]), "", false))
  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), ([xs([0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63])], [xs([0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63])])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (x([0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63]), x([0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63]), x([0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63]))
  assert_eq (bytes.index_any(a, ""), bytes.last_index_any(a, "")), (-1, -1)
  assert_eq (bytes.index_any(a, "a"), bytes.last_index_any(a, "a")), (0, 0)
  assert_eq (bytes.index_any(a, "ab"), bytes.last_index_any(a, "ab")), (0, 4)
  assert_eq (bytes.index_any(a, " \t"), bytes.last_index_any(a, " \t")), (-1, -1)
  assert_eq (bytes.index_any(a, "abc "), bytes.last_index_any(a, "abc ")), (0, 6)
  assert_eq (bytes.index_any(a, "☺"), bytes.last_index_any(a, "☺")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xff])), bytes.last_index_any(a, xs([0xff]))), (1, 5)
  assert_eq (bytes.index_any(a, "\uFFFD"), bytes.last_index_any(a, "\uFFFD")), (1, 5)
  assert_eq (bytes.index_any(a, "aß☺"), bytes.last_index_any(a, "aß☺")), (0, 0)
  assert_eq (bytes.index_any(a, "日本"), bytes.last_index_any(a, "日本")), (-1, -1)
  assert_eq (bytes.index_any(a, ","), bytes.last_index_any(a, ",")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xe2, 0x98])), bytes.last_index_any(a, xs([0xe2, 0x98]))), (1, 5)
  assert_eq bytes.index_rune(a, 97), 0
  assert_eq bytes.index_rune(a, 65533), 1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (0, 0)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (-1, -1)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (-1, -1)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (-1, -1)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (5, 5)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (-1, -1)
}
test "search 46" {
  a = b("foo-bar_baz.qux")
