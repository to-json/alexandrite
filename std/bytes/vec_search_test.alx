test "search 7" {
  a = b("abcabc")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 6, 7, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "abcabc", true), ("abcabc", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["a", "b", "c", "a", "b", "c"], ["a", "b", "c", "a", "b", "c"])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["abcabc"], ["abcabc"])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), (["a", "bcabc"], ["a", "bcabc"])
  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), (["a", "b", "cabc"], ["a", "b", "cabc"])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<>a<>b<>c<>a<>b<>c<>"), b("<>abcabc"), b("<>a<>bcabc"))
  assert_eq (bytes.index(a, b("a")), bytes.last_index(a, b("a")), bytes.count(a, b("a")), bytes.has_prefix(a, b("a")), bytes.has_suffix(a, b("a"))), (0, 3, 2, true, false)
  assert_eq (cut3(a, bytes.cut(a, b("a"))), cut3(a, bytes.cut_last(a, b("a")))), (("", "bcabc", true), ("abc", "bc", true))
  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), (["", "bc", "bc"], ["a", "bca", "bc"])
  assert_eq (bytes.replace(a, b("a"), b("<>"), -1), bytes.replace(a, b("a"), b("<>"), 1), bytes.replace(a, b("a"), b("<>"), 2)), (b("<>bc<>bc"), b("<>bcabc"), b("<>bc<>bc"))
  assert_eq (bytes.index(a, b(",")), bytes.last_index(a, b(",")), bytes.count(a, b(",")), bytes.has_prefix(a, b(",")), bytes.has_suffix(a, b(","))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b(","))), cut3(a, bytes.cut_last(a, b(",")))), (("abcabc", "", false), ("abcabc", "", false))
  assert_eq (strs(bytes.split(a, b(","))), strs(bytes.split_after(a, b(",")))), (["abcabc"], ["abcabc"])
  assert_eq (strs(bytes.split_n(a, b(","), 0)), strs(bytes.split_after_n(a, b(","), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(","), 1)), strs(bytes.split_after_n(a, b(","), 1))), (["abcabc"], ["abcabc"])
  assert_eq (strs(bytes.split_n(a, b(","), 2)), strs(bytes.split_after_n(a, b(","), 2))), (["abcabc"], ["abcabc"])
  assert_eq (strs(bytes.split_n(a, b(","), 3)), strs(bytes.split_after_n(a, b(","), 3))), (["abcabc"], ["abcabc"])
  assert_eq (bytes.replace(a, b(","), b("<>"), -1), bytes.replace(a, b(","), b("<>"), 1), bytes.replace(a, b(","), b("<>"), 2)), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.index(a, b("ab")), bytes.last_index(a, b("ab")), bytes.count(a, b("ab")), bytes.has_prefix(a, b("ab")), bytes.has_suffix(a, b("ab"))), (0, 3, 2, true, false)
  assert_eq (cut3(a, bytes.cut(a, b("ab"))), cut3(a, bytes.cut_last(a, b("ab")))), (("", "cabc", true), ("abc", "c", true))
  assert_eq (strs(bytes.split(a, b("ab"))), strs(bytes.split_after(a, b("ab")))), (["", "c", "c"], ["ab", "cab", "c"])
  assert_eq (bytes.replace(a, b("ab"), b("<>"), -1), bytes.replace(a, b("ab"), b("<>"), 1), bytes.replace(a, b("ab"), b("<>"), 2)), (b("<>c<>c"), b("<>cabc"), b("<>c<>c"))
  assert_eq (bytes.index(a, b("☺")), bytes.last_index(a, b("☺")), bytes.count(a, b("☺")), bytes.has_prefix(a, b("☺")), bytes.has_suffix(a, b("☺"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("☺"))), cut3(a, bytes.cut_last(a, b("☺")))), (("abcabc", "", false), ("abcabc", "", false))
  assert_eq (strs(bytes.split(a, b("☺"))), strs(bytes.split_after(a, b("☺")))), (["abcabc"], ["abcabc"])
  assert_eq (bytes.replace(a, b("☺"), b("<>"), -1), bytes.replace(a, b("☺"), b("<>"), 1), bytes.replace(a, b("☺"), b("<>"), 2)), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.index(a, x([0xff])), bytes.last_index(a, x([0xff])), bytes.count(a, x([0xff])), bytes.has_prefix(a, x([0xff])), bytes.has_suffix(a, x([0xff]))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, x([0xff]))), cut3(a, bytes.cut_last(a, x([0xff])))), (("abcabc", "", false), ("abcabc", "", false))
  assert_eq (strs(bytes.split(a, x([0xff]))), strs(bytes.split_after(a, x([0xff])))), (["abcabc"], ["abcabc"])
  assert_eq (bytes.replace(a, x([0xff]), b("<>"), -1), bytes.replace(a, x([0xff]), b("<>"), 1), bytes.replace(a, x([0xff]), b("<>"), 2)), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.index(a, b("\uFFFD")), bytes.last_index(a, b("\uFFFD")), bytes.count(a, b("\uFFFD")), bytes.has_prefix(a, b("\uFFFD")), bytes.has_suffix(a, b("\uFFFD"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("\uFFFD"))), cut3(a, bytes.cut_last(a, b("\uFFFD")))), (("abcabc", "", false), ("abcabc", "", false))
  assert_eq (strs(bytes.split(a, b("\uFFFD"))), strs(bytes.split_after(a, b("\uFFFD")))), (["abcabc"], ["abcabc"])
  assert_eq (bytes.replace(a, b("\uFFFD"), b("<>"), -1), bytes.replace(a, b("\uFFFD"), b("<>"), 1), bytes.replace(a, b("\uFFFD"), b("<>"), 2)), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.index(a, b("ß")), bytes.last_index(a, b("ß")), bytes.count(a, b("ß")), bytes.has_prefix(a, b("ß")), bytes.has_suffix(a, b("ß"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ß"))), cut3(a, bytes.cut_last(a, b("ß")))), (("abcabc", "", false), ("abcabc", "", false))
  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), (["abcabc"], ["abcabc"])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.index_any(a, ""), bytes.last_index_any(a, "")), (-1, -1)
  assert_eq (bytes.index_any(a, "a"), bytes.last_index_any(a, "a")), (0, 3)
  assert_eq (bytes.index_any(a, "ab"), bytes.last_index_any(a, "ab")), (0, 4)
  assert_eq (bytes.index_any(a, " \t"), bytes.last_index_any(a, " \t")), (-1, -1)
  assert_eq (bytes.index_any(a, "abc "), bytes.last_index_any(a, "abc ")), (0, 5)
  assert_eq (bytes.index_any(a, "☺"), bytes.last_index_any(a, "☺")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xff])), bytes.last_index_any(a, xs([0xff]))), (-1, -1)
  assert_eq (bytes.index_any(a, "\uFFFD"), bytes.last_index_any(a, "\uFFFD")), (-1, -1)
  assert_eq (bytes.index_any(a, "aß☺"), bytes.last_index_any(a, "aß☺")), (0, 3)
  assert_eq (bytes.index_any(a, "日本"), bytes.last_index_any(a, "日本")), (-1, -1)
  assert_eq (bytes.index_any(a, ","), bytes.last_index_any(a, ",")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xe2, 0x98])), bytes.last_index_any(a, xs([0xe2, 0x98]))), (-1, -1)
  assert_eq bytes.index_rune(a, 97), 0
  assert_eq bytes.index_rune(a, 65533), -1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (0, 3)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (-1, -1)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (-1, -1)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (-1, -1)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (-1, -1)
}
test "search 8" {
  a = b("a,b,,c,")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 7, 8, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "a,b,,c,", true), ("a,b,,c,", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["a", ",", "b", ",", ",", "c", ","], ["a", ",", "b", ",", ",", "c", ","])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["a,b,,c,"], ["a,b,,c,"])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), (["a", ",b,,c,"], ["a", ",b,,c,"])
  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), (["a", ",", "b,,c,"], ["a", ",", "b,,c,"])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<>a<>,<>b<>,<>,<>c<>,<>"), b("<>a,b,,c,"), b("<>a<>,b,,c,"))
  assert_eq (bytes.index(a, b("a")), bytes.last_index(a, b("a")), bytes.count(a, b("a")), bytes.has_prefix(a, b("a")), bytes.has_suffix(a, b("a"))), (0, 0, 1, true, false)
  assert_eq (cut3(a, bytes.cut(a, b("a"))), cut3(a, bytes.cut_last(a, b("a")))), (("", ",b,,c,", true), ("", ",b,,c,", true))
  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), (["", ",b,,c,"], ["a", ",b,,c,"])
  assert_eq (bytes.replace(a, b("a"), b("<>"), -1), bytes.replace(a, b("a"), b("<>"), 1), bytes.replace(a, b("a"), b("<>"), 2)), (b("<>,b,,c,"), b("<>,b,,c,"), b("<>,b,,c,"))
  assert_eq (bytes.index(a, b(",")), bytes.last_index(a, b(",")), bytes.count(a, b(",")), bytes.has_prefix(a, b(",")), bytes.has_suffix(a, b(","))), (1, 6, 4, false, true)
  assert_eq (cut3(a, bytes.cut(a, b(","))), cut3(a, bytes.cut_last(a, b(",")))), (("a", "b,,c,", true), ("a,b,,c", "", true))
  assert_eq (strs(bytes.split(a, b(","))), strs(bytes.split_after(a, b(",")))), (["a", "b", "", "c", ""], ["a,", "b,", ",", "c,", ""])
  assert_eq (strs(bytes.split_n(a, b(","), 0)), strs(bytes.split_after_n(a, b(","), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(","), 1)), strs(bytes.split_after_n(a, b(","), 1))), (["a,b,,c,"], ["a,b,,c,"])
  assert_eq (strs(bytes.split_n(a, b(","), 2)), strs(bytes.split_after_n(a, b(","), 2))), (["a", "b,,c,"], ["a,", "b,,c,"])
  assert_eq (strs(bytes.split_n(a, b(","), 3)), strs(bytes.split_after_n(a, b(","), 3))), (["a", "b", ",c,"], ["a,", "b,", ",c,"])
  assert_eq (bytes.replace(a, b(","), b("<>"), -1), bytes.replace(a, b(","), b("<>"), 1), bytes.replace(a, b(","), b("<>"), 2)), (b("a<>b<><>c<>"), b("a<>b,,c,"), b("a<>b<>,c,"))
  assert_eq (bytes.index(a, b("ab")), bytes.last_index(a, b("ab")), bytes.count(a, b("ab")), bytes.has_prefix(a, b("ab")), bytes.has_suffix(a, b("ab"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ab"))), cut3(a, bytes.cut_last(a, b("ab")))), (("a,b,,c,", "", false), ("a,b,,c,", "", false))
  assert_eq (strs(bytes.split(a, b("ab"))), strs(bytes.split_after(a, b("ab")))), (["a,b,,c,"], ["a,b,,c,"])
  assert_eq (bytes.replace(a, b("ab"), b("<>"), -1), bytes.replace(a, b("ab"), b("<>"), 1), bytes.replace(a, b("ab"), b("<>"), 2)), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.index(a, b("☺")), bytes.last_index(a, b("☺")), bytes.count(a, b("☺")), bytes.has_prefix(a, b("☺")), bytes.has_suffix(a, b("☺"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("☺"))), cut3(a, bytes.cut_last(a, b("☺")))), (("a,b,,c,", "", false), ("a,b,,c,", "", false))
  assert_eq (strs(bytes.split(a, b("☺"))), strs(bytes.split_after(a, b("☺")))), (["a,b,,c,"], ["a,b,,c,"])
  assert_eq (bytes.replace(a, b("☺"), b("<>"), -1), bytes.replace(a, b("☺"), b("<>"), 1), bytes.replace(a, b("☺"), b("<>"), 2)), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.index(a, x([0xff])), bytes.last_index(a, x([0xff])), bytes.count(a, x([0xff])), bytes.has_prefix(a, x([0xff])), bytes.has_suffix(a, x([0xff]))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, x([0xff]))), cut3(a, bytes.cut_last(a, x([0xff])))), (("a,b,,c,", "", false), ("a,b,,c,", "", false))
  assert_eq (strs(bytes.split(a, x([0xff]))), strs(bytes.split_after(a, x([0xff])))), (["a,b,,c,"], ["a,b,,c,"])
  assert_eq (bytes.replace(a, x([0xff]), b("<>"), -1), bytes.replace(a, x([0xff]), b("<>"), 1), bytes.replace(a, x([0xff]), b("<>"), 2)), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.index(a, b("\uFFFD")), bytes.last_index(a, b("\uFFFD")), bytes.count(a, b("\uFFFD")), bytes.has_prefix(a, b("\uFFFD")), bytes.has_suffix(a, b("\uFFFD"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("\uFFFD"))), cut3(a, bytes.cut_last(a, b("\uFFFD")))), (("a,b,,c,", "", false), ("a,b,,c,", "", false))
  assert_eq (strs(bytes.split(a, b("\uFFFD"))), strs(bytes.split_after(a, b("\uFFFD")))), (["a,b,,c,"], ["a,b,,c,"])
  assert_eq (bytes.replace(a, b("\uFFFD"), b("<>"), -1), bytes.replace(a, b("\uFFFD"), b("<>"), 1), bytes.replace(a, b("\uFFFD"), b("<>"), 2)), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.index(a, b("ß")), bytes.last_index(a, b("ß")), bytes.count(a, b("ß")), bytes.has_prefix(a, b("ß")), bytes.has_suffix(a, b("ß"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ß"))), cut3(a, bytes.cut_last(a, b("ß")))), (("a,b,,c,", "", false), ("a,b,,c,", "", false))
  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), (["a,b,,c,"], ["a,b,,c,"])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.index_any(a, ""), bytes.last_index_any(a, "")), (-1, -1)
  assert_eq (bytes.index_any(a, "a"), bytes.last_index_any(a, "a")), (0, 0)
  assert_eq (bytes.index_any(a, "ab"), bytes.last_index_any(a, "ab")), (0, 2)
  assert_eq (bytes.index_any(a, " \t"), bytes.last_index_any(a, " \t")), (-1, -1)
  assert_eq (bytes.index_any(a, "abc "), bytes.last_index_any(a, "abc ")), (0, 5)
  assert_eq (bytes.index_any(a, "☺"), bytes.last_index_any(a, "☺")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xff])), bytes.last_index_any(a, xs([0xff]))), (-1, -1)
  assert_eq (bytes.index_any(a, "\uFFFD"), bytes.last_index_any(a, "\uFFFD")), (-1, -1)
  assert_eq (bytes.index_any(a, "aß☺"), bytes.last_index_any(a, "aß☺")), (0, 0)
  assert_eq (bytes.index_any(a, "日本"), bytes.last_index_any(a, "日本")), (-1, -1)
  assert_eq (bytes.index_any(a, ","), bytes.last_index_any(a, ",")), (1, 6)
  assert_eq (bytes.index_any(a, xs([0xe2, 0x98])), bytes.last_index_any(a, xs([0xe2, 0x98]))), (-1, -1)
  assert_eq bytes.index_rune(a, 97), 0
  assert_eq bytes.index_rune(a, 44), 1
  assert_eq bytes.index_rune(a, 65533), -1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (0, 0)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (1, 6)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (-1, -1)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (-1, -1)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (-1, -1)
}
test "search 9" {
  a = b(",")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 1, 2, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", ",", true), (",", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), ([","], [","])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), ([","], [","])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), ([","], [","])
  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), ([","], [","])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<>,<>"), b("<>,"), b("<>,<>"))
  assert_eq (bytes.index(a, b("a")), bytes.last_index(a, b("a")), bytes.count(a, b("a")), bytes.has_prefix(a, b("a")), bytes.has_suffix(a, b("a"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("a"))), cut3(a, bytes.cut_last(a, b("a")))), ((",", "", false), (",", "", false))
  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), ([","], [","])
