  assert_eq (cut3(a, bytes.cut(a, b("\uFFFD"))), cut3(a, bytes.cut_last(a, b("\uFFFD")))), (("\u1680a\u2028b\u2029", "", false), ("\u1680a\u2028b\u2029", "", false))
  assert_eq (strs(bytes.split(a, b("\uFFFD"))), strs(bytes.split_after(a, b("\uFFFD")))), (["\u1680a\u2028b\u2029"], ["\u1680a\u2028b\u2029"])
  assert_eq (bytes.replace(a, b("\uFFFD"), b("<>"), -1), bytes.replace(a, b("\uFFFD"), b("<>"), 1), bytes.replace(a, b("\uFFFD"), b("<>"), 2)), (b("\u1680a\u2028b\u2029"), b("\u1680a\u2028b\u2029"), b("\u1680a\u2028b\u2029"))
  assert_eq (bytes.index(a, b("ß")), bytes.last_index(a, b("ß")), bytes.count(a, b("ß")), bytes.has_prefix(a, b("ß")), bytes.has_suffix(a, b("ß"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ß"))), cut3(a, bytes.cut_last(a, b("ß")))), (("\u1680a\u2028b\u2029", "", false), ("\u1680a\u2028b\u2029", "", false))
  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), (["\u1680a\u2028b\u2029"], ["\u1680a\u2028b\u2029"])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (b("\u1680a\u2028b\u2029"), b("\u1680a\u2028b\u2029"), b("\u1680a\u2028b\u2029"))
  assert_eq (bytes.index_any(a, ""), bytes.last_index_any(a, "")), (-1, -1)
  assert_eq (bytes.index_any(a, "a"), bytes.last_index_any(a, "a")), (3, 3)
  assert_eq (bytes.index_any(a, "ab"), bytes.last_index_any(a, "ab")), (3, 7)
  assert_eq (bytes.index_any(a, " \t"), bytes.last_index_any(a, " \t")), (-1, -1)
  assert_eq (bytes.index_any(a, "abc "), bytes.last_index_any(a, "abc ")), (3, 7)
  assert_eq (bytes.index_any(a, "☺"), bytes.last_index_any(a, "☺")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xff])), bytes.last_index_any(a, xs([0xff]))), (-1, -1)
  assert_eq (bytes.index_any(a, "\uFFFD"), bytes.last_index_any(a, "\uFFFD")), (-1, -1)
  assert_eq (bytes.index_any(a, "aß☺"), bytes.last_index_any(a, "aß☺")), (3, 3)
  assert_eq (bytes.index_any(a, "日本"), bytes.last_index_any(a, "日本")), (-1, -1)
  assert_eq (bytes.index_any(a, ","), bytes.last_index_any(a, ",")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xe2, 0x98])), bytes.last_index_any(a, xs([0xe2, 0x98]))), (-1, -1)
  assert_eq bytes.index_rune(a, 97), 3
  assert_eq bytes.index_rune(a, 65533), -1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (3, 3)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (-1, -1)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (-1, -1)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (2, 9)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (4, 8)
}
test "search 17" {
  a = b("Hello, World")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 12, 13, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "Hello, World", true), ("Hello, World", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["H", "e", "l", "l", "o", ",", " ", "W", "o", "r", "l", "d"], ["H", "e", "l", "l", "o", ",", " ", "W", "o", "r", "l", "d"])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["Hello, World"], ["Hello, World"])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), (["H", "ello, World"], ["H", "ello, World"])
  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), (["H", "e", "llo, World"], ["H", "e", "llo, World"])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<>H<>e<>l<>l<>o<>,<> <>W<>o<>r<>l<>d<>"), b("<>Hello, World"), b("<>H<>ello, World"))
  assert_eq (bytes.index(a, b("a")), bytes.last_index(a, b("a")), bytes.count(a, b("a")), bytes.has_prefix(a, b("a")), bytes.has_suffix(a, b("a"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("a"))), cut3(a, bytes.cut_last(a, b("a")))), (("Hello, World", "", false), ("Hello, World", "", false))
  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), (["Hello, World"], ["Hello, World"])
  assert_eq (bytes.replace(a, b("a"), b("<>"), -1), bytes.replace(a, b("a"), b("<>"), 1), bytes.replace(a, b("a"), b("<>"), 2)), (b("Hello, World"), b("Hello, World"), b("Hello, World"))
  assert_eq (bytes.index(a, b(",")), bytes.last_index(a, b(",")), bytes.count(a, b(",")), bytes.has_prefix(a, b(",")), bytes.has_suffix(a, b(","))), (5, 5, 1, false, false)
  assert_eq (cut3(a, bytes.cut(a, b(","))), cut3(a, bytes.cut_last(a, b(",")))), (("Hello", " World", true), ("Hello", " World", true))
  assert_eq (strs(bytes.split(a, b(","))), strs(bytes.split_after(a, b(",")))), (["Hello", " World"], ["Hello,", " World"])
  assert_eq (strs(bytes.split_n(a, b(","), 0)), strs(bytes.split_after_n(a, b(","), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(","), 1)), strs(bytes.split_after_n(a, b(","), 1))), (["Hello, World"], ["Hello, World"])
  assert_eq (strs(bytes.split_n(a, b(","), 2)), strs(bytes.split_after_n(a, b(","), 2))), (["Hello", " World"], ["Hello,", " World"])
  assert_eq (strs(bytes.split_n(a, b(","), 3)), strs(bytes.split_after_n(a, b(","), 3))), (["Hello", " World"], ["Hello,", " World"])
  assert_eq (bytes.replace(a, b(","), b("<>"), -1), bytes.replace(a, b(","), b("<>"), 1), bytes.replace(a, b(","), b("<>"), 2)), (b("Hello<> World"), b("Hello<> World"), b("Hello<> World"))
  assert_eq (bytes.index(a, b("ab")), bytes.last_index(a, b("ab")), bytes.count(a, b("ab")), bytes.has_prefix(a, b("ab")), bytes.has_suffix(a, b("ab"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ab"))), cut3(a, bytes.cut_last(a, b("ab")))), (("Hello, World", "", false), ("Hello, World", "", false))
  assert_eq (strs(bytes.split(a, b("ab"))), strs(bytes.split_after(a, b("ab")))), (["Hello, World"], ["Hello, World"])
  assert_eq (bytes.replace(a, b("ab"), b("<>"), -1), bytes.replace(a, b("ab"), b("<>"), 1), bytes.replace(a, b("ab"), b("<>"), 2)), (b("Hello, World"), b("Hello, World"), b("Hello, World"))
  assert_eq (bytes.index(a, b("☺")), bytes.last_index(a, b("☺")), bytes.count(a, b("☺")), bytes.has_prefix(a, b("☺")), bytes.has_suffix(a, b("☺"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("☺"))), cut3(a, bytes.cut_last(a, b("☺")))), (("Hello, World", "", false), ("Hello, World", "", false))
  assert_eq (strs(bytes.split(a, b("☺"))), strs(bytes.split_after(a, b("☺")))), (["Hello, World"], ["Hello, World"])
  assert_eq (bytes.replace(a, b("☺"), b("<>"), -1), bytes.replace(a, b("☺"), b("<>"), 1), bytes.replace(a, b("☺"), b("<>"), 2)), (b("Hello, World"), b("Hello, World"), b("Hello, World"))
  assert_eq (bytes.index(a, x([0xff])), bytes.last_index(a, x([0xff])), bytes.count(a, x([0xff])), bytes.has_prefix(a, x([0xff])), bytes.has_suffix(a, x([0xff]))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, x([0xff]))), cut3(a, bytes.cut_last(a, x([0xff])))), (("Hello, World", "", false), ("Hello, World", "", false))
  assert_eq (strs(bytes.split(a, x([0xff]))), strs(bytes.split_after(a, x([0xff])))), (["Hello, World"], ["Hello, World"])
  assert_eq (bytes.replace(a, x([0xff]), b("<>"), -1), bytes.replace(a, x([0xff]), b("<>"), 1), bytes.replace(a, x([0xff]), b("<>"), 2)), (b("Hello, World"), b("Hello, World"), b("Hello, World"))
  assert_eq (bytes.index(a, b("\uFFFD")), bytes.last_index(a, b("\uFFFD")), bytes.count(a, b("\uFFFD")), bytes.has_prefix(a, b("\uFFFD")), bytes.has_suffix(a, b("\uFFFD"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("\uFFFD"))), cut3(a, bytes.cut_last(a, b("\uFFFD")))), (("Hello, World", "", false), ("Hello, World", "", false))
  assert_eq (strs(bytes.split(a, b("\uFFFD"))), strs(bytes.split_after(a, b("\uFFFD")))), (["Hello, World"], ["Hello, World"])
  assert_eq (bytes.replace(a, b("\uFFFD"), b("<>"), -1), bytes.replace(a, b("\uFFFD"), b("<>"), 1), bytes.replace(a, b("\uFFFD"), b("<>"), 2)), (b("Hello, World"), b("Hello, World"), b("Hello, World"))
  assert_eq (bytes.index(a, b("ß")), bytes.last_index(a, b("ß")), bytes.count(a, b("ß")), bytes.has_prefix(a, b("ß")), bytes.has_suffix(a, b("ß"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ß"))), cut3(a, bytes.cut_last(a, b("ß")))), (("Hello, World", "", false), ("Hello, World", "", false))
  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), (["Hello, World"], ["Hello, World"])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (b("Hello, World"), b("Hello, World"), b("Hello, World"))
  assert_eq (bytes.index_any(a, ""), bytes.last_index_any(a, "")), (-1, -1)
  assert_eq (bytes.index_any(a, "a"), bytes.last_index_any(a, "a")), (-1, -1)
  assert_eq (bytes.index_any(a, "ab"), bytes.last_index_any(a, "ab")), (-1, -1)
  assert_eq (bytes.index_any(a, " \t"), bytes.last_index_any(a, " \t")), (6, 6)
  assert_eq (bytes.index_any(a, "abc "), bytes.last_index_any(a, "abc ")), (6, 6)
  assert_eq (bytes.index_any(a, "☺"), bytes.last_index_any(a, "☺")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xff])), bytes.last_index_any(a, xs([0xff]))), (-1, -1)
  assert_eq (bytes.index_any(a, "\uFFFD"), bytes.last_index_any(a, "\uFFFD")), (-1, -1)
  assert_eq (bytes.index_any(a, "aß☺"), bytes.last_index_any(a, "aß☺")), (-1, -1)
  assert_eq (bytes.index_any(a, "日本"), bytes.last_index_any(a, "日本")), (-1, -1)
  assert_eq (bytes.index_any(a, ","), bytes.last_index_any(a, ",")), (5, 5)
  assert_eq (bytes.index_any(a, xs([0xe2, 0x98])), bytes.last_index_any(a, xs([0xe2, 0x98]))), (-1, -1)
  assert_eq bytes.index_rune(a, 97), -1
  assert_eq bytes.index_rune(a, 44), 5
  assert_eq bytes.index_rune(a, 32), 6
  assert_eq bytes.index_rune(a, 65533), -1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (-1, -1)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (5, 5)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (6, 6)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (-1, -1)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (-1, -1)
}
test "search 18" {
  a = b("hELLO wORLD")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 11, 12, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "hELLO wORLD", true), ("hELLO wORLD", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["h", "E", "L", "L", "O", " ", "w", "O", "R", "L", "D"], ["h", "E", "L", "L", "O", " ", "w", "O", "R", "L", "D"])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["hELLO wORLD"], ["hELLO wORLD"])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), (["h", "ELLO wORLD"], ["h", "ELLO wORLD"])
  assert_eq (strs(bytes.split_n(a, b(""), 3)), strs(bytes.split_after_n(a, b(""), 3))), (["h", "E", "LLO wORLD"], ["h", "E", "LLO wORLD"])
  assert_eq (bytes.replace(a, b(""), b("<>"), -1), bytes.replace(a, b(""), b("<>"), 1), bytes.replace(a, b(""), b("<>"), 2)), (b("<>h<>E<>L<>L<>O<> <>w<>O<>R<>L<>D<>"), b("<>hELLO wORLD"), b("<>h<>ELLO wORLD"))
  assert_eq (bytes.index(a, b("a")), bytes.last_index(a, b("a")), bytes.count(a, b("a")), bytes.has_prefix(a, b("a")), bytes.has_suffix(a, b("a"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("a"))), cut3(a, bytes.cut_last(a, b("a")))), (("hELLO wORLD", "", false), ("hELLO wORLD", "", false))
  assert_eq (strs(bytes.split(a, b("a"))), strs(bytes.split_after(a, b("a")))), (["hELLO wORLD"], ["hELLO wORLD"])
  assert_eq (bytes.replace(a, b("a"), b("<>"), -1), bytes.replace(a, b("a"), b("<>"), 1), bytes.replace(a, b("a"), b("<>"), 2)), (b("hELLO wORLD"), b("hELLO wORLD"), b("hELLO wORLD"))
  assert_eq (bytes.index(a, b(",")), bytes.last_index(a, b(",")), bytes.count(a, b(",")), bytes.has_prefix(a, b(",")), bytes.has_suffix(a, b(","))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b(","))), cut3(a, bytes.cut_last(a, b(",")))), (("hELLO wORLD", "", false), ("hELLO wORLD", "", false))
  assert_eq (strs(bytes.split(a, b(","))), strs(bytes.split_after(a, b(",")))), (["hELLO wORLD"], ["hELLO wORLD"])
  assert_eq (strs(bytes.split_n(a, b(","), 0)), strs(bytes.split_after_n(a, b(","), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(","), 1)), strs(bytes.split_after_n(a, b(","), 1))), (["hELLO wORLD"], ["hELLO wORLD"])
  assert_eq (strs(bytes.split_n(a, b(","), 2)), strs(bytes.split_after_n(a, b(","), 2))), (["hELLO wORLD"], ["hELLO wORLD"])
