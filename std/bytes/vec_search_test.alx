  assert_eq (cut3(a, bytes.cut(a, b(","))), cut3(a, bytes.cut_last(a, b(",")))), (("a b  c\td\n", "", false), ("a b  c\td\n", "", false))
  assert_eq (strs(bytes.split(a, b(","))), strs(bytes.split_after(a, b(",")))), (["a b  c\td\n"], ["a b  c\td\n"])
  assert_eq (strs(bytes.split_n(a, b(","), 0)), strs(bytes.split_after_n(a, b(","), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(","), 1)), strs(bytes.split_after_n(a, b(","), 1))), (["a b  c\td\n"], ["a b  c\td\n"])
  assert_eq (strs(bytes.split_n(a, b(","), 2)), strs(bytes.split_after_n(a, b(","), 2))), (["a b  c\td\n"], ["a b  c\td\n"])
  assert_eq (strs(bytes.split_n(a, b(","), 3)), strs(bytes.split_after_n(a, b(","), 3))), (["a b  c\td\n"], ["a b  c\td\n"])
