  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["ſ", "s", " ", "S"], ["ſ", "s", " ", "S"])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
