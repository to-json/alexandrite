  assert_eq (bytes.replace(a, x([0xff]), b("<>"), -1), bytes.replace(a, x([0xff]), b("<>"), 1), bytes.replace(a, x([0xff]), b("<>"), 2)), (b("a\uFFFDb<>c"), b("a\uFFFDb<>c"), b("a\uFFFDb<>c"))
