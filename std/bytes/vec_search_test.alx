test "search 15" {
  a = b("\u0085\u00A0x\u2000\u3000")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 11, 6, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "\u0085\u00A0x\u2000\u3000", true), ("\u0085\u00A0x\u2000\u3000", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["\u0085", "\u00A0", "x", "\u2000", "\u3000"], ["\u0085", "\u00A0", "x", "\u2000", "\u3000"])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["\u0085\u00A0x\u2000\u3000"], ["\u0085\u00A0x\u2000\u3000"])
  assert_eq (strs(bytes.split_n(a, b(""), 2)), strs(bytes.split_after_n(a, b(""), 2))), (["\u0085", "\u00A0x\u2000\u3000"], ["\u0085", "\u00A0x\u2000\u3000"])
