  assert_eq (cut3(a, bytes.cut(a, x([0xff]))), cut3(a, bytes.cut_last(a, x([0xff])))), (("😀😁 x 😂", "", false), ("😀😁 x 😂", "", false))
  assert_eq (strs(bytes.split(a, x([0xff]))), strs(bytes.split_after(a, x([0xff])))), (["😀😁 x 😂"], ["😀😁 x 😂"])
  assert_eq (bytes.replace(a, x([0xff]), b("<>"), -1), bytes.replace(a, x([0xff]), b("<>"), 1), bytes.replace(a, x([0xff]), b("<>"), 2)), (b("😀😁 x 😂"), b("😀😁 x 😂"), b("😀😁 x 😂"))
  assert_eq (bytes.index(a, b("\uFFFD")), bytes.last_index(a, b("\uFFFD")), bytes.count(a, b("\uFFFD")), bytes.has_prefix(a, b("\uFFFD")), bytes.has_suffix(a, b("\uFFFD"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("\uFFFD"))), cut3(a, bytes.cut_last(a, b("\uFFFD")))), (("😀😁 x 😂", "", false), ("😀😁 x 😂", "", false))
  assert_eq (strs(bytes.split(a, b("\uFFFD"))), strs(bytes.split_after(a, b("\uFFFD")))), (["😀😁 x 😂"], ["😀😁 x 😂"])
  assert_eq (bytes.replace(a, b("\uFFFD"), b("<>"), -1), bytes.replace(a, b("\uFFFD"), b("<>"), 1), bytes.replace(a, b("\uFFFD"), b("<>"), 2)), (b("😀😁 x 😂"), b("😀😁 x 😂"), b("😀😁 x 😂"))
  assert_eq (bytes.index(a, b("ß")), bytes.last_index(a, b("ß")), bytes.count(a, b("ß")), bytes.has_prefix(a, b("ß")), bytes.has_suffix(a, b("ß"))), (-1, -1, 0, false, false)
  assert_eq (cut3(a, bytes.cut(a, b("ß"))), cut3(a, bytes.cut_last(a, b("ß")))), (("😀😁 x 😂", "", false), ("😀😁 x 😂", "", false))
  assert_eq (strs(bytes.split(a, b("ß"))), strs(bytes.split_after(a, b("ß")))), (["😀😁 x 😂"], ["😀😁 x 😂"])
  assert_eq (bytes.replace(a, b("ß"), b("<>"), -1), bytes.replace(a, b("ß"), b("<>"), 1), bytes.replace(a, b("ß"), b("<>"), 2)), (b("😀😁 x 😂"), b("😀😁 x 😂"), b("😀😁 x 😂"))
  assert_eq (bytes.index_any(a, ""), bytes.last_index_any(a, "")), (-1, -1)
  assert_eq (bytes.index_any(a, "a"), bytes.last_index_any(a, "a")), (-1, -1)
  assert_eq (bytes.index_any(a, "ab"), bytes.last_index_any(a, "ab")), (-1, -1)
  assert_eq (bytes.index_any(a, " \t"), bytes.last_index_any(a, " \t")), (8, 10)
  assert_eq (bytes.index_any(a, "abc "), bytes.last_index_any(a, "abc ")), (8, 10)
  assert_eq (bytes.index_any(a, "☺"), bytes.last_index_any(a, "☺")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xff])), bytes.last_index_any(a, xs([0xff]))), (-1, -1)
  assert_eq (bytes.index_any(a, "\uFFFD"), bytes.last_index_any(a, "\uFFFD")), (-1, -1)
  assert_eq (bytes.index_any(a, "aß☺"), bytes.last_index_any(a, "aß☺")), (-1, -1)
  assert_eq (bytes.index_any(a, "日本"), bytes.last_index_any(a, "日本")), (-1, -1)
  assert_eq (bytes.index_any(a, ","), bytes.last_index_any(a, ",")), (-1, -1)
  assert_eq (bytes.index_any(a, xs([0xe2, 0x98])), bytes.last_index_any(a, xs([0xe2, 0x98]))), (-1, -1)
  assert_eq bytes.index_rune(a, 97), -1
  assert_eq bytes.index_rune(a, 32), 8
  assert_eq bytes.index_rune(a, 128512), 0
  assert_eq bytes.index_rune(a, 65533), -1
  assert_eq bytes.index_rune(a, -1), -1
  assert_eq bytes.index_rune(a, 1114112), -1
  assert_eq (bytes.index_byte(a, 0), bytes.last_index_byte(a, 0)), (-1, -1)
  assert_eq (bytes.index_byte(a, 97), bytes.last_index_byte(a, 97)), (-1, -1)
  assert_eq (bytes.index_byte(a, 44), bytes.last_index_byte(a, 44)), (-1, -1)
  assert_eq (bytes.index_byte(a, 32), bytes.last_index_byte(a, 32)), (8, 10)
  assert_eq (bytes.index_byte(a, 128), bytes.last_index_byte(a, 128)), (3, 3)
  assert_eq (bytes.index_byte(a, 255), bytes.last_index_byte(a, 255)), (-1, -1)
  assert_eq (bytes.index_byte(a, 226), bytes.last_index_byte(a, 226)), (-1, -1)
}
test "search 31" {
  a = b("\U0010FFFF\u0080")
  assert_eq (bytes.index(a, b("")), bytes.last_index(a, b("")), bytes.count(a, b("")), bytes.has_prefix(a, b("")), bytes.has_suffix(a, b(""))), (0, 6, 3, true, true)
  assert_eq (cut3(a, bytes.cut(a, b(""))), cut3(a, bytes.cut_last(a, b("")))), (("", "\U0010FFFF\u0080", true), ("\U0010FFFF\u0080", "", true))
  assert_eq (strs(bytes.split(a, b(""))), strs(bytes.split_after(a, b("")))), (["\U0010FFFF", "\u0080"], ["\U0010FFFF", "\u0080"])
  assert_eq (strs(bytes.split_n(a, b(""), 0)), strs(bytes.split_after_n(a, b(""), 0))), ([], [])
  assert_eq (strs(bytes.split_n(a, b(""), 1)), strs(bytes.split_after_n(a, b(""), 1))), (["\U0010FFFF\u0080"], ["\U0010FFFF\u0080"])
