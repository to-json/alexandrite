  assert_eq bytes.runes(b("double-blind words")), [100, 111, 117, 98, 108, 101, 45, 98, 108, 105, 110, 100, 32, 119, 111, 114, 100, 115]
  assert_eq bytes.to_valid_utf8(b("double-blind words"), b("?")), b("double-blind words")
  assert_eq bytes.repeat(b("double-blind words"), 3), b("double-blind wordsdouble-blind wordsdouble-blind words")
  assert_eq (bytes.trim(b("double-blind words"), ""), bytes.trim_left(b("double-blind words"), ""), bytes.trim_right(b("double-blind words"), "")), (b("double-blind words"), b("double-blind words"), b("double-blind words"))
