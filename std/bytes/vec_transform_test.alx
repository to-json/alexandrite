  assert_eq (bytes.trim(b("\U0010FFFF\u0080"), "\uFFFD"), bytes.trim_left(b("\U0010FFFF\u0080"), "\uFFFD"), bytes.trim_right(b("\U0010FFFF\u0080"), "\uFFFD")), (b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080"))
  assert_eq (bytes.trim(b("\U0010FFFF\u0080"), "aß☺"), bytes.trim_left(b("\U0010FFFF\u0080"), "aß☺"), bytes.trim_right(b("\U0010FFFF\u0080"), "aß☺")), (b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080"))
  assert_eq (bytes.trim(b("\U0010FFFF\u0080"), "日本"), bytes.trim_left(b("\U0010FFFF\u0080"), "日本"), bytes.trim_right(b("\U0010FFFF\u0080"), "日本")), (b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080"))
  assert_eq (bytes.trim(b("\U0010FFFF\u0080"), ","), bytes.trim_left(b("\U0010FFFF\u0080"), ","), bytes.trim_right(b("\U0010FFFF\u0080"), ",")), (b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080"))
  assert_eq (bytes.trim(b("\U0010FFFF\u0080"), xs([0xe2, 0x98])), bytes.trim_left(b("\U0010FFFF\u0080"), xs([0xe2, 0x98])), bytes.trim_right(b("\U0010FFFF\u0080"), xs([0xe2, 0x98]))), (b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080"))
  assert_eq bytes.equal_fold(b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080")), true
  assert_eq bytes.equal_fold(b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080")), true
  assert_eq bytes.equal_fold(b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080")), true
  assert_eq bytes.equal_fold(b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080")), true
  assert_eq bytes.equal_fold(b("\U0010FFFF\u0080"), b("\U0010FFFF\u0080x")), false
  assert_eq bytes.equal_fold(b("\U0010FFFF\u0080"), b("x\U0010FFFF\u0080")), false
}

