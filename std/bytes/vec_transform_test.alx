  assert_eq bytes.trim_space(b("Hello, World")), b("Hello, World")
  assert_eq strs(bytes.fields(b("Hello, World"))), ["Hello,", "World"]
  assert_eq strs(bytes.lines(b("Hello, World"))), ["Hello, World"]
  assert_eq bytes.runes(b("Hello, World")), [72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100]
  assert_eq bytes.to_valid_utf8(b("Hello, World"), b("?")), b("Hello, World")
  assert_eq bytes.repeat(b("Hello, World"), 3), b("Hello, WorldHello, WorldHello, World")
  assert_eq (bytes.trim(b("Hello, World"), ""), bytes.trim_left(b("Hello, World"), ""), bytes.trim_right(b("Hello, World"), "")), (b("Hello, World"), b("Hello, World"), b("Hello, World"))
  assert_eq (bytes.trim(b("Hello, World"), "a"), bytes.trim_left(b("Hello, World"), "a"), bytes.trim_right(b("Hello, World"), "a")), (b("Hello, World"), b("Hello, World"), b("Hello, World"))
