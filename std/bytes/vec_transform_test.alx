  assert_eq (bytes.trim(b("☺☻☹"), "a"), bytes.trim_left(b("☺☻☹"), "a"), bytes.trim_right(b("☺☻☹"), "a")), (b("☺☻☹"), b("☺☻☹"), b("☺☻☹"))
}

