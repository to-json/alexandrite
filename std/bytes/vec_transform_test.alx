  assert_eq bytes.compare(b("ab"), b("")), 1
  assert_eq bytes.compare(b("ab"), b("A")), 1
  assert_eq bytes.compare(b("ab"), b("abc")), -1
  assert_eq bytes.compare(b("ab"), b("aaaa")), 1
  assert_eq bytes.compare(b("ab"), b("a,b,,c,")), 1
