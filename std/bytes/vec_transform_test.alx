  assert_eq bytes.compare(b("\uD7FF"), b("\u1680a\u2028b\u2029")), 1
  assert_eq bytes.compare(b("\uD7FF"), b("hELLO wORLD")), 1
  assert_eq bytes.compare(b("\uD7FF"), b("ÜNÏCÖDÉ")), 1
  assert_eq bytes.compare(b("\uD7FF"), b("Привет мир")), 1
  assert_eq bytes.compare(b("\uD7FF"), b("İı Iı")), 1
  assert_eq bytes.compare(b("\uD7FF"), b("KKk")), 1
  assert_eq bytes.compare(b("\uD7FF"), b("☺☻☹")), 1
  assert_eq bytes.compare(b("\uD7FF"), b("😀😁 x 😂")), -1
  assert_eq bytes.compare(b("\uD7FF"), x([0xff])), -1
  assert_eq bytes.compare(b("\uD7FF"), x([0xff, 0xfe, 0xfd])), -1
  assert_eq bytes.compare(b("\uD7FF"), x([0xe2, 0x98])), 1
  assert_eq bytes.compare(b("\uD7FF"), x([0xed, 0xa0, 0x80])), -1
}

test "vectors 19" {
  assert_eq bytes.compare(b("\uD7FF"), b("\U0010FFFF")), -1
