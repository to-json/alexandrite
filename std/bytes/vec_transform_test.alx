  assert_eq bytes.equal_fold(b("with_underscore and\u00A0nbsp"), b("xwith_underscore and\u00A0nbsp")), false
  assert_eq bytes.compare(b(""), b("")), 0
  assert_eq bytes.compare(b(""), b("A")), -1
  assert_eq bytes.compare(b(""), b("abc")), -1
  assert_eq bytes.compare(b(""), b("aaaa")), -1
  assert_eq bytes.compare(b(""), b("a,b,,c,")), -1
