  assert_eq bytes.equal_fold(b("with_underscore and\u00A0nbsp"), b("with_underscore and\u00A0nbsp")), true
  assert_eq bytes.equal_fold(b("with_underscore and\u00A0nbsp"), b("WITH_UNDERSCORE AND\u00A0NBSP")), true
  assert_eq bytes.equal_fold(b("with_underscore and\u00A0nbsp"), b("with_underscore and\u00A0nbsp")), true
  assert_eq bytes.equal_fold(b("with_underscore and\u00A0nbsp"), b("WITH_UNDERSCORE AND\u00A0NBSP")), true
