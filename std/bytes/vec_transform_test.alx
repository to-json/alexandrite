  assert_eq (bytes.trim(b("trailing  "), xs([0xe2, 0x98])), bytes.trim_left(b("trailing  "), xs([0xe2, 0x98])), bytes.trim_right(b("trailing  "), xs([0xe2, 0x98]))), (b("trailing  "), b("trailing  "), b("trailing  "))
  assert_eq bytes.equal_fold(b("trailing  "), b("trailing  ")), true
  assert_eq bytes.equal_fold(b("trailing  "), b("TRAILING  ")), true
  assert_eq bytes.equal_fold(b("trailing  "), b("trailing  ")), true
  assert_eq bytes.equal_fold(b("trailing  "), b("TRAILING  ")), true
  assert_eq bytes.equal_fold(b("trailing  "), b("trailing  x")), false
  assert_eq bytes.equal_fold(b("trailing  "), b("xtrailing  ")), false
  assert_eq bytes.to_upper(b(" \t\n\x0b\x0c\r ")), b(" \t\n\x0b\x0c\r ")
  assert_eq bytes.to_lower(b(" \t\n\x0b\x0c\r ")), b(" \t\n\x0b\x0c\r ")
  assert_eq bytes.to_title(b(" \t\n\x0b\x0c\r ")), b(" \t\n\x0b\x0c\r ")
  assert_eq bytes.title(b(" \t\n\x0b\x0c\r ")), b(" \t\n\x0b\x0c\r ")
  assert_eq bytes.trim_space(b(" \t\n\x0b\x0c\r ")), b("")
  assert_eq strs(bytes.fields(b(" \t\n\x0b\x0c\r "))), []
}

