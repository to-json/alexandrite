  assert_eq bytes.equal_fold(b("a b  c\td\n"), b("a b  c\td\n")), true
  assert_eq bytes.equal_fold(b("a b  c\td\n"), b("A B  C\tD\n")), true
  assert_eq bytes.equal_fold(b("a b  c\td\n"), b("a b  c\td\n")), true
