  assert_eq (bytes.trim(b("double-blind words"), "ab"), bytes.trim_left(b("double-blind words"), "ab"), bytes.trim_right(b("double-blind words"), "ab")), (b("double-blind words"), b("double-blind words"), b("double-blind words"))
