  assert_eq (bytes.trim(b("Hello, World"), xs([0xe2, 0x98])), bytes.trim_left(b("Hello, World"), xs([0xe2, 0x98])), bytes.trim_right(b("Hello, World"), xs([0xe2, 0x98]))), (b("Hello, World"), b("Hello, World"), b("Hello, World"))
}

