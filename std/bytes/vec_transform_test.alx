test "vectors 7" {
  assert_eq bytes.to_valid_utf8(b("ΑΒΓ αβγ"), b("?")), b("ΑΒΓ αβγ")
  assert_eq bytes.repeat(b("ΑΒΓ αβγ"), 3), b("ΑΒΓ αβγΑΒΓ αβγΑΒΓ αβγ")
