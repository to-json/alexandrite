  assert_eq (bytes.trim(b("  leading"), "abc "), bytes.trim_left(b("  leading"), "abc "), bytes.trim_right(b("  leading"), "abc ")), (b("leading"), b("leading"), b("  leading"))
  assert_eq (bytes.trim(b("  leading"), "☺"), bytes.trim_left(b("  leading"), "☺"), bytes.trim_right(b("  leading"), "☺")), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq (bytes.trim(b("  leading"), xs([0xff])), bytes.trim_left(b("  leading"), xs([0xff])), bytes.trim_right(b("  leading"), xs([0xff]))), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq (bytes.trim(b("  leading"), "\uFFFD"), bytes.trim_left(b("  leading"), "\uFFFD"), bytes.trim_right(b("  leading"), "\uFFFD")), (b("  leading"), b("  leading"), b("  leading"))
