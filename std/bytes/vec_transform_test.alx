  assert_eq (bytes.trim(b("Привет мир"), xs([0xff])), bytes.trim_left(b("Привет мир"), xs([0xff])), bytes.trim_right(b("Привет мир"), xs([0xff]))), (b("Привет мир"), b("Привет мир"), b("Привет мир"))
