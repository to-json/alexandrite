test "vectors 12" {
  assert_eq bytes.equal_fold(x([0xed, 0xa0, 0x80]), b("\uFFFD\uFFFD\uFFFD")), true
  assert_eq bytes.equal_fold(x([0xed, 0xa0, 0x80]), x([0xed, 0xa0, 0x80, 0x78])), false
  assert_eq bytes.equal_fold(x([0xed, 0xa0, 0x80]), x([0x78, 0xed, 0xa0, 0x80])), false
  assert_eq bytes.to_upper(b("\uD7FF")), b("\uD7FF")
  assert_eq bytes.to_lower(b("\uD7FF")), b("\uD7FF")
  assert_eq bytes.to_title(b("\uD7FF")), b("\uD7FF")
  assert_eq bytes.title(b("\uD7FF")), b("\uD7FF")
  assert_eq bytes.trim_space(b("\uD7FF")), b("\uD7FF")
  assert_eq strs(bytes.fields(b("\uD7FF"))), ["\uD7FF"]
  assert_eq strs(bytes.lines(b("\uD7FF"))), ["\uD7FF"]
  assert_eq bytes.runes(b("\uD7FF")), [55295]
  assert_eq bytes.to_valid_utf8(b("\uD7FF"), b("?")), b("\uD7FF")
  assert_eq bytes.repeat(b("\uD7FF"), 3), b("\uD7FF\uD7FF\uD7FF")
  assert_eq (bytes.trim(b("\uD7FF"), ""), bytes.trim_left(b("\uD7FF"), ""), bytes.trim_right(b("\uD7FF"), "")), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), "a"), bytes.trim_left(b("\uD7FF"), "a"), bytes.trim_right(b("\uD7FF"), "a")), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), "ab"), bytes.trim_left(b("\uD7FF"), "ab"), bytes.trim_right(b("\uD7FF"), "ab")), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), " \t"), bytes.trim_left(b("\uD7FF"), " \t"), bytes.trim_right(b("\uD7FF"), " \t")), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), "abc "), bytes.trim_left(b("\uD7FF"), "abc "), bytes.trim_right(b("\uD7FF"), "abc ")), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), "☺"), bytes.trim_left(b("\uD7FF"), "☺"), bytes.trim_right(b("\uD7FF"), "☺")), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), xs([0xff])), bytes.trim_left(b("\uD7FF"), xs([0xff])), bytes.trim_right(b("\uD7FF"), xs([0xff]))), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), "\uFFFD"), bytes.trim_left(b("\uD7FF"), "\uFFFD"), bytes.trim_right(b("\uD7FF"), "\uFFFD")), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), "aß☺"), bytes.trim_left(b("\uD7FF"), "aß☺"), bytes.trim_right(b("\uD7FF"), "aß☺")), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), "日本"), bytes.trim_left(b("\uD7FF"), "日本"), bytes.trim_right(b("\uD7FF"), "日本")), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), ","), bytes.trim_left(b("\uD7FF"), ","), bytes.trim_right(b("\uD7FF"), ",")), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq (bytes.trim(b("\uD7FF"), xs([0xe2, 0x98])), bytes.trim_left(b("\uD7FF"), xs([0xe2, 0x98])), bytes.trim_right(b("\uD7FF"), xs([0xe2, 0x98]))), (b("\uD7FF"), b("\uD7FF"), b("\uD7FF"))
  assert_eq bytes.equal_fold(b("\uD7FF"), b("\uD7FF")), true
  assert_eq bytes.equal_fold(b("\uD7FF"), b("\uD7FF")), true
  assert_eq bytes.equal_fold(b("\uD7FF"), b("\uD7FF")), true
  assert_eq bytes.equal_fold(b("\uD7FF"), b("\uD7FF")), true
  assert_eq bytes.equal_fold(b("\uD7FF"), b("\uD7FFx")), false
  assert_eq bytes.equal_fold(b("\uD7FF"), b("x\uD7FF")), false
  assert_eq bytes.to_upper(b("\U0010FFFF")), b("\U0010FFFF")
  assert_eq bytes.to_lower(b("\U0010FFFF")), b("\U0010FFFF")
  assert_eq bytes.to_title(b("\U0010FFFF")), b("\U0010FFFF")
  assert_eq bytes.title(b("\U0010FFFF")), b("\U0010FFFF")
  assert_eq bytes.trim_space(b("\U0010FFFF")), b("\U0010FFFF")
  assert_eq strs(bytes.fields(b("\U0010FFFF"))), ["\U0010FFFF"]
  assert_eq strs(bytes.lines(b("\U0010FFFF"))), ["\U0010FFFF"]
  assert_eq bytes.runes(b("\U0010FFFF")), [1114111]
