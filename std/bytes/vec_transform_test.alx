  assert_eq (bytes.trim(b("Привет мир"), xs([0xe2, 0x98])), bytes.trim_left(b("Привет мир"), xs([0xe2, 0x98])), bytes.trim_right(b("Привет мир"), xs([0xe2, 0x98]))), (b("Привет мир"), b("Привет мир"), b("Привет мир"))
  assert_eq bytes.equal_fold(b("Привет мир"), b("Привет мир")), true
  assert_eq bytes.equal_fold(b("Привет мир"), b("ПРИВЕТ МИР")), true
  assert_eq bytes.equal_fold(b("Привет мир"), b("привет мир")), true
  assert_eq bytes.equal_fold(b("Привет мир"), b("ПРИВЕТ МИР")), true
  assert_eq bytes.equal_fold(b("Привет мир"), b("Привет мирx")), false
  assert_eq bytes.equal_fold(b("Привет мир"), b("xПривет мир")), false
  assert_eq bytes.to_upper(b("ß ẞ")), b("ß ẞ")
  assert_eq bytes.to_lower(b("ß ẞ")), b("ß ß")
  assert_eq bytes.to_title(b("ß ẞ")), b("ß ẞ")
  assert_eq bytes.title(b("ß ẞ")), b("ß ẞ")
  assert_eq bytes.trim_space(b("ß ẞ")), b("ß ẞ")
  assert_eq strs(bytes.fields(b("ß ẞ"))), ["ß", "ẞ"]
  assert_eq strs(bytes.lines(b("ß ẞ"))), ["ß ẞ"]
  assert_eq bytes.runes(b("ß ẞ")), [223, 32, 7838]
  assert_eq bytes.to_valid_utf8(b("ß ẞ"), b("?")), b("ß ẞ")
  assert_eq bytes.repeat(b("ß ẞ"), 3), b("ß ẞß ẞß ẞ")
  assert_eq (bytes.trim(b("ß ẞ"), ""), bytes.trim_left(b("ß ẞ"), ""), bytes.trim_right(b("ß ẞ"), "")), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), "a"), bytes.trim_left(b("ß ẞ"), "a"), bytes.trim_right(b("ß ẞ"), "a")), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), "ab"), bytes.trim_left(b("ß ẞ"), "ab"), bytes.trim_right(b("ß ẞ"), "ab")), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), " \t"), bytes.trim_left(b("ß ẞ"), " \t"), bytes.trim_right(b("ß ẞ"), " \t")), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), "abc "), bytes.trim_left(b("ß ẞ"), "abc "), bytes.trim_right(b("ß ẞ"), "abc ")), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), "☺"), bytes.trim_left(b("ß ẞ"), "☺"), bytes.trim_right(b("ß ẞ"), "☺")), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), xs([0xff])), bytes.trim_left(b("ß ẞ"), xs([0xff])), bytes.trim_right(b("ß ẞ"), xs([0xff]))), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), "\uFFFD"), bytes.trim_left(b("ß ẞ"), "\uFFFD"), bytes.trim_right(b("ß ẞ"), "\uFFFD")), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), "aß☺"), bytes.trim_left(b("ß ẞ"), "aß☺"), bytes.trim_right(b("ß ẞ"), "aß☺")), (b(" ẞ"), b(" ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), "日本"), bytes.trim_left(b("ß ẞ"), "日本"), bytes.trim_right(b("ß ẞ"), "日本")), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), ","), bytes.trim_left(b("ß ẞ"), ","), bytes.trim_right(b("ß ẞ"), ",")), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq (bytes.trim(b("ß ẞ"), xs([0xe2, 0x98])), bytes.trim_left(b("ß ẞ"), xs([0xe2, 0x98])), bytes.trim_right(b("ß ẞ"), xs([0xe2, 0x98]))), (b("ß ẞ"), b("ß ẞ"), b("ß ẞ"))
  assert_eq bytes.equal_fold(b("ß ẞ"), b("ß ẞ")), true
  assert_eq bytes.equal_fold(b("ß ẞ"), b("ß ẞ")), true
  assert_eq bytes.equal_fold(b("ß ẞ"), b("ß ß")), true
  assert_eq bytes.equal_fold(b("ß ẞ"), b("ß ẞ")), true
  assert_eq bytes.equal_fold(b("ß ẞ"), b("ß ẞx")), false
  assert_eq bytes.equal_fold(b("ß ẞ"), b("xß ẞ")), false
  assert_eq bytes.to_upper(b("İı Iı")), b("İI II")
  assert_eq bytes.to_lower(b("İı Iı")), b("iı iı")
  assert_eq bytes.to_title(b("İı Iı")), b("İI II")
  assert_eq bytes.title(b("İı Iı")), b("İı Iı")
  assert_eq bytes.trim_space(b("İı Iı")), b("İı Iı")
  assert_eq strs(bytes.fields(b("İı Iı"))), ["İı", "Iı"]
  assert_eq strs(bytes.lines(b("İı Iı"))), ["İı Iı"]
  assert_eq bytes.runes(b("İı Iı")), [304, 305, 32, 73, 305]
  assert_eq bytes.to_valid_utf8(b("İı Iı"), b("?")), b("İı Iı")
  assert_eq bytes.repeat(b("İı Iı"), 3), b("İı Iıİı Iıİı Iı")
  assert_eq (bytes.trim(b("İı Iı"), ""), bytes.trim_left(b("İı Iı"), ""), bytes.trim_right(b("İı Iı"), "")), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), "a"), bytes.trim_left(b("İı Iı"), "a"), bytes.trim_right(b("İı Iı"), "a")), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), "ab"), bytes.trim_left(b("İı Iı"), "ab"), bytes.trim_right(b("İı Iı"), "ab")), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), " \t"), bytes.trim_left(b("İı Iı"), " \t"), bytes.trim_right(b("İı Iı"), " \t")), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), "abc "), bytes.trim_left(b("İı Iı"), "abc "), bytes.trim_right(b("İı Iı"), "abc ")), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), "☺"), bytes.trim_left(b("İı Iı"), "☺"), bytes.trim_right(b("İı Iı"), "☺")), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), xs([0xff])), bytes.trim_left(b("İı Iı"), xs([0xff])), bytes.trim_right(b("İı Iı"), xs([0xff]))), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), "\uFFFD"), bytes.trim_left(b("İı Iı"), "\uFFFD"), bytes.trim_right(b("İı Iı"), "\uFFFD")), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), "aß☺"), bytes.trim_left(b("İı Iı"), "aß☺"), bytes.trim_right(b("İı Iı"), "aß☺")), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), "日本"), bytes.trim_left(b("İı Iı"), "日本"), bytes.trim_right(b("İı Iı"), "日本")), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), ","), bytes.trim_left(b("İı Iı"), ","), bytes.trim_right(b("İı Iı"), ",")), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq (bytes.trim(b("İı Iı"), xs([0xe2, 0x98])), bytes.trim_left(b("İı Iı"), xs([0xe2, 0x98])), bytes.trim_right(b("İı Iı"), xs([0xe2, 0x98]))), (b("İı Iı"), b("İı Iı"), b("İı Iı"))
  assert_eq bytes.equal_fold(b("İı Iı"), b("İı Iı")), true
  assert_eq bytes.equal_fold(b("İı Iı"), b("İI II")), false
}

test "vectors 8" {
  assert_eq bytes.equal_fold(b("İı Iı"), b("iı iı")), false
  assert_eq bytes.equal_fold(b("İı Iı"), b("İI II")), false
  assert_eq bytes.equal_fold(b("İı Iı"), b("İı Iıx")), false
  assert_eq bytes.equal_fold(b("İı Iı"), b("xİı Iı")), false
  assert_eq bytes.to_upper(b("ǅǆǄ ǈǉǇ")), b("ǄǄǄ ǇǇǇ")
  assert_eq bytes.to_lower(b("ǅǆǄ ǈǉǇ")), b("ǆǆǆ ǉǉǉ")
  assert_eq bytes.to_title(b("ǅǆǄ ǈǉǇ")), b("ǅǅǅ ǈǈǈ")
  assert_eq bytes.title(b("ǅǆǄ ǈǉǇ")), b("ǅǆǄ ǈǉǇ")
  assert_eq bytes.trim_space(b("ǅǆǄ ǈǉǇ")), b("ǅǆǄ ǈǉǇ")
  assert_eq strs(bytes.fields(b("ǅǆǄ ǈǉǇ"))), ["ǅǆǄ", "ǈǉǇ"]
  assert_eq strs(bytes.lines(b("ǅǆǄ ǈǉǇ"))), ["ǅǆǄ ǈǉǇ"]
  assert_eq bytes.runes(b("ǅǆǄ ǈǉǇ")), [453, 454, 452, 32, 456, 457, 455]
  assert_eq bytes.to_valid_utf8(b("ǅǆǄ ǈǉǇ"), b("?")), b("ǅǆǄ ǈǉǇ")
  assert_eq bytes.repeat(b("ǅǆǄ ǈǉǇ"), 3), b("ǅǆǄ ǈǉǇǅǆǄ ǈǉǇǅǆǄ ǈǉǇ")
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), ""), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), ""), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), "")), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), "a"), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), "a"), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), "a")), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), "ab"), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), "ab"), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), "ab")), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), " \t"), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), " \t"), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), " \t")), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), "abc "), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), "abc "), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), "abc ")), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), "☺"), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), "☺"), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), "☺")), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), xs([0xff])), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), xs([0xff])), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), xs([0xff]))), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), "\uFFFD"), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), "\uFFFD"), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), "\uFFFD")), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), "aß☺"), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), "aß☺"), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), "aß☺")), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), "日本"), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), "日本"), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), "日本")), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), ","), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), ","), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), ",")), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq (bytes.trim(b("ǅǆǄ ǈǉǇ"), xs([0xe2, 0x98])), bytes.trim_left(b("ǅǆǄ ǈǉǇ"), xs([0xe2, 0x98])), bytes.trim_right(b("ǅǆǄ ǈǉǇ"), xs([0xe2, 0x98]))), (b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ"))
  assert_eq bytes.equal_fold(b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇ")), true
  assert_eq bytes.equal_fold(b("ǅǆǄ ǈǉǇ"), b("ǄǄǄ ǇǇǇ")), true
  assert_eq bytes.equal_fold(b("ǅǆǄ ǈǉǇ"), b("ǆǆǆ ǉǉǉ")), true
  assert_eq bytes.equal_fold(b("ǅǆǄ ǈǉǇ"), b("ǅǅǅ ǈǈǈ")), true
  assert_eq bytes.equal_fold(b("ǅǆǄ ǈǉǇ"), b("ǅǆǄ ǈǉǇx")), false
  assert_eq bytes.equal_fold(b("ǅǆǄ ǈǉǇ"), b("xǅǆǄ ǈǉǇ")), false
  assert_eq bytes.to_upper(b("KKk")), b("KKK")
  assert_eq bytes.to_lower(b("KKk")), b("kkk")
  assert_eq bytes.to_title(b("KKk")), b("KKK")
  assert_eq bytes.title(b("KKk")), b("KKk")
  assert_eq bytes.trim_space(b("KKk")), b("KKk")
