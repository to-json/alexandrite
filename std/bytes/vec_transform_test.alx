  assert_eq (bytes.trim(b("ΑΒΓ αβγ"), "a"), bytes.trim_left(b("ΑΒΓ αβγ"), "a"), bytes.trim_right(b("ΑΒΓ αβγ"), "a")), (b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"))
  assert_eq (bytes.trim(b("ΑΒΓ αβγ"), "ab"), bytes.trim_left(b("ΑΒΓ αβγ"), "ab"), bytes.trim_right(b("ΑΒΓ αβγ"), "ab")), (b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"))
  assert_eq (bytes.trim(b("ΑΒΓ αβγ"), " \t"), bytes.trim_left(b("ΑΒΓ αβγ"), " \t"), bytes.trim_right(b("ΑΒΓ αβγ"), " \t")), (b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"))
  assert_eq (bytes.trim(b("ΑΒΓ αβγ"), "abc "), bytes.trim_left(b("ΑΒΓ αβγ"), "abc "), bytes.trim_right(b("ΑΒΓ αβγ"), "abc ")), (b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"))
  assert_eq (bytes.trim(b("ΑΒΓ αβγ"), "☺"), bytes.trim_left(b("ΑΒΓ αβγ"), "☺"), bytes.trim_right(b("ΑΒΓ αβγ"), "☺")), (b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"))
  assert_eq (bytes.trim(b("ΑΒΓ αβγ"), xs([0xff])), bytes.trim_left(b("ΑΒΓ αβγ"), xs([0xff])), bytes.trim_right(b("ΑΒΓ αβγ"), xs([0xff]))), (b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"))
  assert_eq (bytes.trim(b("ΑΒΓ αβγ"), "\uFFFD"), bytes.trim_left(b("ΑΒΓ αβγ"), "\uFFFD"), bytes.trim_right(b("ΑΒΓ αβγ"), "\uFFFD")), (b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"))
  assert_eq (bytes.trim(b("ΑΒΓ αβγ"), "aß☺"), bytes.trim_left(b("ΑΒΓ αβγ"), "aß☺"), bytes.trim_right(b("ΑΒΓ αβγ"), "aß☺")), (b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"))
  assert_eq (bytes.trim(b("ΑΒΓ αβγ"), "日本"), bytes.trim_left(b("ΑΒΓ αβγ"), "日本"), bytes.trim_right(b("ΑΒΓ αβγ"), "日本")), (b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"))
