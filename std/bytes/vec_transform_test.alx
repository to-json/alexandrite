  assert_eq (bytes.trim(b("  leading"), "日本"), bytes.trim_left(b("  leading"), "日本"), bytes.trim_right(b("  leading"), "日本")), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq (bytes.trim(b("  leading"), ","), bytes.trim_left(b("  leading"), ","), bytes.trim_right(b("  leading"), ",")), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq (bytes.trim(b("  leading"), xs([0xe2, 0x98])), bytes.trim_left(b("  leading"), xs([0xe2, 0x98])), bytes.trim_right(b("  leading"), xs([0xe2, 0x98]))), (b("  leading"), b("  leading"), b("  leading"))
  assert_eq bytes.equal_fold(b("  leading"), b("  leading")), true
