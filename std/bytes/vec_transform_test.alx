}

test "vectors 4" {
  assert_eq (bytes.trim(b(",,"), "aß☺"), bytes.trim_left(b(",,"), "aß☺"), bytes.trim_right(b(",,"), "aß☺")), (b(",,"), b(",,"), b(",,"))
  assert_eq (bytes.trim(b(",,"), "日本"), bytes.trim_left(b(",,"), "日本"), bytes.trim_right(b(",,"), "日本")), (b(",,"), b(",,"), b(",,"))
  assert_eq (bytes.trim(b(",,"), ","), bytes.trim_left(b(",,"), ","), bytes.trim_right(b(",,"), ",")), (b(""), b(""), b(""))
  assert_eq (bytes.trim(b(",,"), xs([0xe2, 0x98])), bytes.trim_left(b(",,"), xs([0xe2, 0x98])), bytes.trim_right(b(",,"), xs([0xe2, 0x98]))), (b(",,"), b(",,"), b(",,"))
  assert_eq bytes.equal_fold(b(",,"), b(",,")), true
  assert_eq bytes.equal_fold(b(",,"), b(",,")), true
  assert_eq bytes.equal_fold(b(",,"), b(",,")), true
  assert_eq bytes.equal_fold(b(",,"), b(",,")), true
  assert_eq bytes.equal_fold(b(",,"), b(",,x")), false
  assert_eq bytes.equal_fold(b(",,"), b("x,,")), false
  assert_eq bytes.to_upper(b("a b  c\td\n")), b("A B  C\tD\n")
  assert_eq bytes.to_lower(b("a b  c\td\n")), b("a b  c\td\n")
  assert_eq bytes.to_title(b("a b  c\td\n")), b("A B  C\tD\n")
  assert_eq bytes.title(b("a b  c\td\n")), b("A B  C\tD\n")
  assert_eq bytes.trim_space(b("a b  c\td\n")), b("a b  c\td")
  assert_eq strs(bytes.fields(b("a b  c\td\n"))), ["a", "b", "c", "d"]
  assert_eq strs(bytes.lines(b("a b  c\td\n"))), ["a b  c\td\n"]
  assert_eq bytes.runes(b("a b  c\td\n")), [97, 32, 98, 32, 32, 99, 9, 100, 10]
  assert_eq bytes.to_valid_utf8(b("a b  c\td\n"), b("?")), b("a b  c\td\n")
  assert_eq bytes.repeat(b("a b  c\td\n"), 3), b("a b  c\td\na b  c\td\na b  c\td\n")
  assert_eq (bytes.trim(b("a b  c\td\n"), ""), bytes.trim_left(b("a b  c\td\n"), ""), bytes.trim_right(b("a b  c\td\n"), "")), (b("a b  c\td\n"), b("a b  c\td\n"), b("a b  c\td\n"))
  assert_eq (bytes.trim(b("a b  c\td\n"), "a"), bytes.trim_left(b("a b  c\td\n"), "a"), bytes.trim_right(b("a b  c\td\n"), "a")), (b(" b  c\td\n"), b(" b  c\td\n"), b("a b  c\td\n"))
  assert_eq (bytes.trim(b("a b  c\td\n"), "ab"), bytes.trim_left(b("a b  c\td\n"), "ab"), bytes.trim_right(b("a b  c\td\n"), "ab")), (b(" b  c\td\n"), b(" b  c\td\n"), b("a b  c\td\n"))
  assert_eq (bytes.trim(b("a b  c\td\n"), " \t"), bytes.trim_left(b("a b  c\td\n"), " \t"), bytes.trim_right(b("a b  c\td\n"), " \t")), (b("a b  c\td\n"), b("a b  c\td\n"), b("a b  c\td\n"))
  assert_eq (bytes.trim(b("a b  c\td\n"), "abc "), bytes.trim_left(b("a b  c\td\n"), "abc "), bytes.trim_right(b("a b  c\td\n"), "abc ")), (b("\td\n"), b("\td\n"), b("a b  c\td\n"))
  assert_eq (bytes.trim(b("a b  c\td\n"), "☺"), bytes.trim_left(b("a b  c\td\n"), "☺"), bytes.trim_right(b("a b  c\td\n"), "☺")), (b("a b  c\td\n"), b("a b  c\td\n"), b("a b  c\td\n"))
  assert_eq (bytes.trim(b("a b  c\td\n"), xs([0xff])), bytes.trim_left(b("a b  c\td\n"), xs([0xff])), bytes.trim_right(b("a b  c\td\n"), xs([0xff]))), (b("a b  c\td\n"), b("a b  c\td\n"), b("a b  c\td\n"))
  assert_eq (bytes.trim(b("a b  c\td\n"), "\uFFFD"), bytes.trim_left(b("a b  c\td\n"), "\uFFFD"), bytes.trim_right(b("a b  c\td\n"), "\uFFFD")), (b("a b  c\td\n"), b("a b  c\td\n"), b("a b  c\td\n"))
  assert_eq (bytes.trim(b("a b  c\td\n"), "aß☺"), bytes.trim_left(b("a b  c\td\n"), "aß☺"), bytes.trim_right(b("a b  c\td\n"), "aß☺")), (b(" b  c\td\n"), b(" b  c\td\n"), b("a b  c\td\n"))
  assert_eq (bytes.trim(b("a b  c\td\n"), "日本"), bytes.trim_left(b("a b  c\td\n"), "日本"), bytes.trim_right(b("a b  c\td\n"), "日本")), (b("a b  c\td\n"), b("a b  c\td\n"), b("a b  c\td\n"))
  assert_eq (bytes.trim(b("a b  c\td\n"), ","), bytes.trim_left(b("a b  c\td\n"), ","), bytes.trim_right(b("a b  c\td\n"), ",")), (b("a b  c\td\n"), b("a b  c\td\n"), b("a b  c\td\n"))
