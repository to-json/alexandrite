  assert_eq (bytes.trim(b("a,b,,c,"), xs([0xff])), bytes.trim_left(b("a,b,,c,"), xs([0xff])), bytes.trim_right(b("a,b,,c,"), xs([0xff]))), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.trim(b("a,b,,c,"), "\uFFFD"), bytes.trim_left(b("a,b,,c,"), "\uFFFD"), bytes.trim_right(b("a,b,,c,"), "\uFFFD")), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.trim(b("a,b,,c,"), "aß☺"), bytes.trim_left(b("a,b,,c,"), "aß☺"), bytes.trim_right(b("a,b,,c,"), "aß☺")), (b(",b,,c,"), b(",b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.trim(b("a,b,,c,"), "日本"), bytes.trim_left(b("a,b,,c,"), "日本"), bytes.trim_right(b("a,b,,c,"), "日本")), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.trim(b("a,b,,c,"), ","), bytes.trim_left(b("a,b,,c,"), ","), bytes.trim_right(b("a,b,,c,"), ",")), (b("a,b,,c"), b("a,b,,c,"), b("a,b,,c"))
  assert_eq (bytes.trim(b("a,b,,c,"), xs([0xe2, 0x98])), bytes.trim_left(b("a,b,,c,"), xs([0xe2, 0x98])), bytes.trim_right(b("a,b,,c,"), xs([0xe2, 0x98]))), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
  assert_eq bytes.equal_fold(b("a,b,,c,"), b("a,b,,c,")), true
  assert_eq bytes.equal_fold(b("a,b,,c,"), b("A,B,,C,")), true
  assert_eq bytes.equal_fold(b("a,b,,c,"), b("a,b,,c,")), true
  assert_eq bytes.equal_fold(b("a,b,,c,"), b("A,B,,C,")), true
  assert_eq bytes.equal_fold(b("a,b,,c,"), b("a,b,,c,x")), false
  assert_eq bytes.equal_fold(b("a,b,,c,"), b("xa,b,,c,")), false
  assert_eq bytes.to_upper(b(",")), b(",")
  assert_eq bytes.to_lower(b(",")), b(",")
  assert_eq bytes.to_title(b(",")), b(",")
  assert_eq bytes.title(b(",")), b(",")
  assert_eq bytes.trim_space(b(",")), b(",")
  assert_eq strs(bytes.fields(b(","))), [","]
  assert_eq strs(bytes.lines(b(","))), [","]
  assert_eq bytes.runes(b(",")), [44]
  assert_eq bytes.to_valid_utf8(b(","), b("?")), b(",")
  assert_eq bytes.repeat(b(","), 3), b(",,,")
