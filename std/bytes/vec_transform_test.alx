test "vectors 14" {
  assert_eq bytes.equal_fold(x([0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63]), x([0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63, 0x78])), false
  assert_eq bytes.equal_fold(x([0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63]), x([0x78, 0x61, 0xef, 0xbf, 0xbd, 0x62, 0xff, 0x63])), false
  assert_eq bytes.to_upper(b("foo-bar_baz.qux")), b("FOO-BAR_BAZ.QUX")
  assert_eq bytes.to_lower(b("foo-bar_baz.qux")), b("foo-bar_baz.qux")
  assert_eq bytes.to_title(b("foo-bar_baz.qux")), b("FOO-BAR_BAZ.QUX")
  assert_eq bytes.title(b("foo-bar_baz.qux")), b("Foo-Bar_baz.Qux")
  assert_eq bytes.trim_space(b("foo-bar_baz.qux")), b("foo-bar_baz.qux")
  assert_eq strs(bytes.fields(b("foo-bar_baz.qux"))), ["foo-bar_baz.qux"]
  assert_eq strs(bytes.lines(b("foo-bar_baz.qux"))), ["foo-bar_baz.qux"]
  assert_eq bytes.runes(b("foo-bar_baz.qux")), [102, 111, 111, 45, 98, 97, 114, 95, 98, 97, 122, 46, 113, 117, 120]
  assert_eq bytes.to_valid_utf8(b("foo-bar_baz.qux"), b("?")), b("foo-bar_baz.qux")
  assert_eq bytes.repeat(b("foo-bar_baz.qux"), 3), b("foo-bar_baz.quxfoo-bar_baz.quxfoo-bar_baz.qux")
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), ""), bytes.trim_left(b("foo-bar_baz.qux"), ""), bytes.trim_right(b("foo-bar_baz.qux"), "")), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), "a"), bytes.trim_left(b("foo-bar_baz.qux"), "a"), bytes.trim_right(b("foo-bar_baz.qux"), "a")), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), "ab"), bytes.trim_left(b("foo-bar_baz.qux"), "ab"), bytes.trim_right(b("foo-bar_baz.qux"), "ab")), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), " \t"), bytes.trim_left(b("foo-bar_baz.qux"), " \t"), bytes.trim_right(b("foo-bar_baz.qux"), " \t")), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), "abc "), bytes.trim_left(b("foo-bar_baz.qux"), "abc "), bytes.trim_right(b("foo-bar_baz.qux"), "abc ")), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), "☺"), bytes.trim_left(b("foo-bar_baz.qux"), "☺"), bytes.trim_right(b("foo-bar_baz.qux"), "☺")), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), xs([0xff])), bytes.trim_left(b("foo-bar_baz.qux"), xs([0xff])), bytes.trim_right(b("foo-bar_baz.qux"), xs([0xff]))), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), "\uFFFD"), bytes.trim_left(b("foo-bar_baz.qux"), "\uFFFD"), bytes.trim_right(b("foo-bar_baz.qux"), "\uFFFD")), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), "aß☺"), bytes.trim_left(b("foo-bar_baz.qux"), "aß☺"), bytes.trim_right(b("foo-bar_baz.qux"), "aß☺")), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), "日本"), bytes.trim_left(b("foo-bar_baz.qux"), "日本"), bytes.trim_right(b("foo-bar_baz.qux"), "日本")), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), ","), bytes.trim_left(b("foo-bar_baz.qux"), ","), bytes.trim_right(b("foo-bar_baz.qux"), ",")), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq (bytes.trim(b("foo-bar_baz.qux"), xs([0xe2, 0x98])), bytes.trim_left(b("foo-bar_baz.qux"), xs([0xe2, 0x98])), bytes.trim_right(b("foo-bar_baz.qux"), xs([0xe2, 0x98]))), (b("foo-bar_baz.qux"), b("foo-bar_baz.qux"), b("foo-bar_baz.qux"))
  assert_eq bytes.equal_fold(b("foo-bar_baz.qux"), b("foo-bar_baz.qux")), true
  assert_eq bytes.equal_fold(b("foo-bar_baz.qux"), b("FOO-BAR_BAZ.QUX")), true
  assert_eq bytes.equal_fold(b("foo-bar_baz.qux"), b("foo-bar_baz.qux")), true
  assert_eq bytes.equal_fold(b("foo-bar_baz.qux"), b("FOO-BAR_BAZ.QUX")), true
  assert_eq bytes.equal_fold(b("foo-bar_baz.qux"), b("foo-bar_baz.quxx")), false
  assert_eq bytes.equal_fold(b("foo-bar_baz.qux"), b("xfoo-bar_baz.qux")), false
  assert_eq bytes.to_upper(b("123 456")), b("123 456")
  assert_eq bytes.to_lower(b("123 456")), b("123 456")
  assert_eq bytes.to_title(b("123 456")), b("123 456")
  assert_eq bytes.title(b("123 456")), b("123 456")
  assert_eq bytes.trim_space(b("123 456")), b("123 456")
  assert_eq strs(bytes.fields(b("123 456"))), ["123", "456"]
  assert_eq strs(bytes.lines(b("123 456"))), ["123 456"]
  assert_eq bytes.runes(b("123 456")), [49, 50, 51, 32, 52, 53, 54]
  assert_eq bytes.to_valid_utf8(b("123 456"), b("?")), b("123 456")
  assert_eq bytes.repeat(b("123 456"), 3), b("123 456123 456123 456")
  assert_eq (bytes.trim(b("123 456"), ""), bytes.trim_left(b("123 456"), ""), bytes.trim_right(b("123 456"), "")), (b("123 456"), b("123 456"), b("123 456"))
  assert_eq (bytes.trim(b("123 456"), "a"), bytes.trim_left(b("123 456"), "a"), bytes.trim_right(b("123 456"), "a")), (b("123 456"), b("123 456"), b("123 456"))
  assert_eq (bytes.trim(b("123 456"), "ab"), bytes.trim_left(b("123 456"), "ab"), bytes.trim_right(b("123 456"), "ab")), (b("123 456"), b("123 456"), b("123 456"))
  assert_eq (bytes.trim(b("123 456"), " \t"), bytes.trim_left(b("123 456"), " \t"), bytes.trim_right(b("123 456"), " \t")), (b("123 456"), b("123 456"), b("123 456"))
  assert_eq (bytes.trim(b("123 456"), "abc "), bytes.trim_left(b("123 456"), "abc "), bytes.trim_right(b("123 456"), "abc ")), (b("123 456"), b("123 456"), b("123 456"))
