test "vectors 3" {
  assert_eq bytes.to_title(b("abcabc")), b("ABCABC")
  assert_eq bytes.title(b("abcabc")), b("Abcabc")
  assert_eq bytes.trim_space(b("abcabc")), b("abcabc")
  assert_eq strs(bytes.fields(b("abcabc"))), ["abcabc"]
  assert_eq strs(bytes.lines(b("abcabc"))), ["abcabc"]
  assert_eq bytes.runes(b("abcabc")), [97, 98, 99, 97, 98, 99]
  assert_eq bytes.to_valid_utf8(b("abcabc"), b("?")), b("abcabc")
  assert_eq bytes.repeat(b("abcabc"), 3), b("abcabcabcabcabcabc")
  assert_eq (bytes.trim(b("abcabc"), ""), bytes.trim_left(b("abcabc"), ""), bytes.trim_right(b("abcabc"), "")), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.trim(b("abcabc"), "a"), bytes.trim_left(b("abcabc"), "a"), bytes.trim_right(b("abcabc"), "a")), (b("bcabc"), b("bcabc"), b("abcabc"))
  assert_eq (bytes.trim(b("abcabc"), "ab"), bytes.trim_left(b("abcabc"), "ab"), bytes.trim_right(b("abcabc"), "ab")), (b("cabc"), b("cabc"), b("abcabc"))
  assert_eq (bytes.trim(b("abcabc"), " \t"), bytes.trim_left(b("abcabc"), " \t"), bytes.trim_right(b("abcabc"), " \t")), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.trim(b("abcabc"), "abc "), bytes.trim_left(b("abcabc"), "abc "), bytes.trim_right(b("abcabc"), "abc ")), (b(""), b(""), b(""))
  assert_eq (bytes.trim(b("abcabc"), "☺"), bytes.trim_left(b("abcabc"), "☺"), bytes.trim_right(b("abcabc"), "☺")), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.trim(b("abcabc"), xs([0xff])), bytes.trim_left(b("abcabc"), xs([0xff])), bytes.trim_right(b("abcabc"), xs([0xff]))), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.trim(b("abcabc"), "\uFFFD"), bytes.trim_left(b("abcabc"), "\uFFFD"), bytes.trim_right(b("abcabc"), "\uFFFD")), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.trim(b("abcabc"), "aß☺"), bytes.trim_left(b("abcabc"), "aß☺"), bytes.trim_right(b("abcabc"), "aß☺")), (b("bcabc"), b("bcabc"), b("abcabc"))
  assert_eq (bytes.trim(b("abcabc"), "日本"), bytes.trim_left(b("abcabc"), "日本"), bytes.trim_right(b("abcabc"), "日本")), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.trim(b("abcabc"), ","), bytes.trim_left(b("abcabc"), ","), bytes.trim_right(b("abcabc"), ",")), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq (bytes.trim(b("abcabc"), xs([0xe2, 0x98])), bytes.trim_left(b("abcabc"), xs([0xe2, 0x98])), bytes.trim_right(b("abcabc"), xs([0xe2, 0x98]))), (b("abcabc"), b("abcabc"), b("abcabc"))
  assert_eq bytes.equal_fold(b("abcabc"), b("abcabc")), true
  assert_eq bytes.equal_fold(b("abcabc"), b("ABCABC")), true
  assert_eq bytes.equal_fold(b("abcabc"), b("abcabc")), true
  assert_eq bytes.equal_fold(b("abcabc"), b("ABCABC")), true
  assert_eq bytes.equal_fold(b("abcabc"), b("abcabcx")), false
  assert_eq bytes.equal_fold(b("abcabc"), b("xabcabc")), false
  assert_eq bytes.to_upper(b("a,b,,c,")), b("A,B,,C,")
  assert_eq bytes.to_lower(b("a,b,,c,")), b("a,b,,c,")
  assert_eq bytes.to_title(b("a,b,,c,")), b("A,B,,C,")
  assert_eq bytes.title(b("a,b,,c,")), b("A,B,,C,")
  assert_eq bytes.trim_space(b("a,b,,c,")), b("a,b,,c,")
  assert_eq strs(bytes.fields(b("a,b,,c,"))), ["a,b,,c,"]
  assert_eq strs(bytes.lines(b("a,b,,c,"))), ["a,b,,c,"]
  assert_eq bytes.runes(b("a,b,,c,")), [97, 44, 98, 44, 44, 99, 44]
  assert_eq bytes.to_valid_utf8(b("a,b,,c,"), b("?")), b("a,b,,c,")
  assert_eq bytes.repeat(b("a,b,,c,"), 3), b("a,b,,c,a,b,,c,a,b,,c,")
  assert_eq (bytes.trim(b("a,b,,c,"), ""), bytes.trim_left(b("a,b,,c,"), ""), bytes.trim_right(b("a,b,,c,"), "")), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.trim(b("a,b,,c,"), "a"), bytes.trim_left(b("a,b,,c,"), "a"), bytes.trim_right(b("a,b,,c,"), "a")), (b(",b,,c,"), b(",b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.trim(b("a,b,,c,"), "ab"), bytes.trim_left(b("a,b,,c,"), "ab"), bytes.trim_right(b("a,b,,c,"), "ab")), (b(",b,,c,"), b(",b,,c,"), b("a,b,,c,"))
  assert_eq (bytes.trim(b("a,b,,c,"), " \t"), bytes.trim_left(b("a,b,,c,"), " \t"), bytes.trim_right(b("a,b,,c,"), " \t")), (b("a,b,,c,"), b("a,b,,c,"), b("a,b,,c,"))
