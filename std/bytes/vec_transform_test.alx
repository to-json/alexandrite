  assert_eq (bytes.trim(b("ΑΒΓ αβγ"), xs([0xe2, 0x98])), bytes.trim_left(b("ΑΒΓ αβγ"), xs([0xe2, 0x98])), bytes.trim_right(b("ΑΒΓ αβγ"), xs([0xe2, 0x98]))), (b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ"))
  assert_eq bytes.equal_fold(b("ΑΒΓ αβγ"), b("ΑΒΓ αβγ")), true
  assert_eq bytes.equal_fold(b("ΑΒΓ αβγ"), b("ΑΒΓ ΑΒΓ")), true
  assert_eq bytes.equal_fold(b("ΑΒΓ αβγ"), b("αβγ αβγ")), true
  assert_eq bytes.equal_fold(b("ΑΒΓ αβγ"), b("ΑΒΓ ΑΒΓ")), true
  assert_eq bytes.equal_fold(b("ΑΒΓ αβγ"), b("ΑΒΓ αβγx")), false
  assert_eq bytes.equal_fold(b("ΑΒΓ αβγ"), b("xΑΒΓ αβγ")), false
  assert_eq bytes.to_upper(b("Привет мир")), b("ПРИВЕТ МИР")
  assert_eq bytes.to_lower(b("Привет мир")), b("привет мир")
  assert_eq bytes.to_title(b("Привет мир")), b("ПРИВЕТ МИР")
  assert_eq bytes.title(b("Привет мир")), b("Привет Мир")
  assert_eq bytes.trim_space(b("Привет мир")), b("Привет мир")
  assert_eq strs(bytes.fields(b("Привет мир"))), ["Привет", "мир"]
  assert_eq strs(bytes.lines(b("Привет мир"))), ["Привет мир"]
  assert_eq bytes.runes(b("Привет мир")), [1055, 1088, 1080, 1074, 1077, 1090, 32, 1084, 1080, 1088]
  assert_eq bytes.to_valid_utf8(b("Привет мир"), b("?")), b("Привет мир")
  assert_eq bytes.repeat(b("Привет мир"), 3), b("Привет мирПривет мирПривет мир")
  assert_eq (bytes.trim(b("Привет мир"), ""), bytes.trim_left(b("Привет мир"), ""), bytes.trim_right(b("Привет мир"), "")), (b("Привет мир"), b("Привет мир"), b("Привет мир"))
  assert_eq (bytes.trim(b("Привет мир"), "a"), bytes.trim_left(b("Привет мир"), "a"), bytes.trim_right(b("Привет мир"), "a")), (b("Привет мир"), b("Привет мир"), b("Привет мир"))
  assert_eq (bytes.trim(b("Привет мир"), "ab"), bytes.trim_left(b("Привет мир"), "ab"), bytes.trim_right(b("Привет мир"), "ab")), (b("Привет мир"), b("Привет мир"), b("Привет мир"))
