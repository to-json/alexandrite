# Package cmp: Go's cmp, for ordered values (S2).
#
#   Go                              alx
#   cmp.Compare(x, y) int           compare(x, y) -> Int
#   cmp.Less(x, y) bool             less?(x, y) -> Bool
#   cmp.Or(vals...) T               or(vals: [T]) -> T
#   cmp.Ordered                     (no type: see below)
#
# Differences from Go:
#   - `Ordered` is not a declared constraint: alx generics are checked per
#     instance, so `compare` and `less?` take any T with `<` and `==` (the
#     integer types, Float, Str, and types that define `<=>` and `==`).
#   - `or` takes a slice: alx has no variadic parameters (`cmp.or([a, b, c])`).
#     Like Go's, it returns the first value that isn't T's zero value.
#   - `less?` ends in `?` (it answers a question).
#
# NaNs order before every other Float and equal to each other; -0.0 equals
# 0.0. Values of other types can't be NaN (`x != x` is never true for them).

# Holds a T's zero value: `Zero[T].new.v`.
struct Zero[T] {
  v: T
}

def is_nan[T](x: T) -> Bool {
  x != x
}

# -1 if x < y, 0 if x == y, +1 if x > y. A NaN is less than any non-NaN,
# and equal to another NaN.
pub def compare[T](x: T, y: T) -> Int {
  x_nan = is_nan(x)
  y_nan = is_nan(y)
  if x_nan {
    return 0 if y_nan
    return -1
  }
  return 1 if y_nan
  return -1 if x < y
  return 1 if x > y
  0
}

# Whether x < y. A NaN is less than any non-NaN; -0.0 is not less than 0.0.
pub def less?[T](x: T, y: T) -> Bool {
  (is_nan(x) && !is_nan(y)) || x < y
}

# The first of vals that isn't the zero value of T, or the zero value if
# there is none (also for an empty slice).
pub def or[T](vals: [T]) -> T {
  zero = Zero[T].new.v
  for v in vals {
    return v if v != zero
  }
  zero
}
