import "math"
import "slices"
import "sort"
import "strings"

# Go's cmp_test.go, translated. The `any` table becomes one table per type.

def negzero -> Float { math.copysign(0.0, -1.0) }

def int_cases -> [(Int, Int, Int)] {
  [(1, 2, -1), (1, 1, 0), (2, 1, 1)]
}

def str_cases -> [(Str, Str, Int)] {
  [("a", "aa", -1), ("a", "a", 0), ("aa", "a", 1)]
}

def float_cases -> [(Float, Float, Int)] {
  inf = math.inf(1)
  ninf = math.inf(-1)
  nan = math.nan
  nz = negzero
  [
    (1.0, 1.1, -1),
    (1.1, 1.1, 0),
    (1.1, 1.0, 1),
    (inf, inf, 0),
    (ninf, ninf, 0),
    (ninf, 1.0, -1),
    (1.0, ninf, 1),
    (inf, 1.0, 1),
    (1.0, inf, -1),
    (nan, nan, 0),
    (0.0, nan, 1),
    (nan, 0.0, -1),
    (nan, ninf, -1),
    (ninf, nan, 1),
    (0.0, 0.0, 0),
    (nz, nz, 0),
    (nz, 0.0, 0),
    (0.0, nz, 0),
    (nz, 1.0, -1),
    (nz, -1.0, 1),
  ]
}

# Go's uintptr rows: a nil and a non-nil pointer.
def ptr_cases -> [(U64, U64, Int)] {
  nilptr: U64 = 0
  nonnilptr: U64 = 0x7ffee000
  [(nilptr, nonnilptr, -1), (nonnilptr, nilptr, 1), (nonnilptr, nonnilptr, 0)]
}

test "less" {
  for c in int_cases {
    assert_eq less?(c[0], c[1]), c[2] < 0
  }
  for c in str_cases {
    assert_eq less?(c[0], c[1]), c[2] < 0
  }
  for c in float_cases {
    assert less?(c[0], c[1]) == (c[2] < 0), "less?(#{c[0]}, #{c[1]})"
  }
  for c in ptr_cases {
    assert_eq less?(c[0], c[1]), c[2] < 0
  }
}

test "compare" {
  for c in int_cases {
    assert_eq compare(c[0], c[1]), c[2]
  }
  for c in str_cases {
    assert_eq compare(c[0], c[1]), c[2]
  }
  for c in float_cases {
    assert compare(c[0], c[1]) == c[2], "compare(#{c[0]}, #{c[1]})"
  }
  for c in ptr_cases {
    assert_eq compare(c[0], c[1]), c[2]
  }
}

test "compare other widths" {
  assert_eq compare(3.as_i8, -4.as_i8), 1
  assert_eq compare(3.as_u8, 200.as_u8), -1
  assert_eq compare(7.as_i16, 7.as_i16), 0
  assert_eq compare(-1.as_i32, 0.as_i32), -1
  assert_eq compare(0xFFFF.as_u16, 0.as_u16), 1
  assert_eq compare(5.as_u32, 4.as_u32), 1
  assert less?(-9223372036854775808, 9223372036854775807)
  big: U64 = 18446744073709551615
  assert less?(0.as_u64, big)
}

test "sort" {
  # Our comparison is consistent with sort.float64s.
  input = [1.0, 0.0, negzero, math.inf(1), math.inf(-1), math.nan]
  sort.float64s(input)
  for i in 0...input.size - 1 {
    assert !less?(input[i + 1], input[i]), "less? sort mismatch at #{i} in #{input}"
    assert compare(input[i], input[i + 1]) <= 0, "compare sort mismatch at #{i} in #{input}"
  }
}

test "or" {
  cases: [([Int], Int)] = [([], 0), ([0], 0), ([1], 1), ([0, 2], 2), ([3, 0], 3), ([4, 5], 4), ([0, 6, 7], 6)]
  for c in cases {
    assert_eq or(c[0]), c[1]
  }
  assert_eq or(["", "", "x"]), "x"
  assert_eq or([0.0, 2.5]), 2.5
  assert_eq or([false, true]), true
  e: [Str] = []
  assert_eq or(e), ""
}

example "or" {
  # Suppose we have some user input that may or may not be an empty string.
  user_input1 = ""
  user_input2 = "some text"
  puts or([user_input1, "default"])
  puts or([user_input2, "default"])
  puts or([user_input1, user_input2, "default"])
} outputs "default\nsome text\nsome text"

struct Order {
  product: Str
  customer: Str
  price: Float
}

example "or sort" {
  orders = [
    Order.new("foo", "alice", 1.00),
    Order.new("bar", "bob", 3.00),
    Order.new("baz", "carol", 4.00),
    Order.new("foo", "alice", 2.00),
    Order.new("bar", "carol", 1.00),
    Order.new("foo", "bob", 4.00),
  ]
  # Sort by customer first, product second, and last by higher price.
  slices.sort_func(orders) { |a, b|
    or([
      strings.compare(a.customer, b.customer),
      strings.compare(a.product, b.product),
      compare(b.price, a.price),
    ])
  }
  for o in orders {
    puts format("%s %s %.2f", o.product, o.customer, o.price)
  }
} outputs <<~EOS
  foo alice 2.00
  foo alice 1.00
  bar bob 3.00
  foo bob 4.00
  bar carol 1.00
  baz carol 4.00
EOS

example "less" {
  puts less?(1, 2)
  puts less?("a", "aa")
  puts less?(1.0, math.nan)
  puts less?(math.nan, 1.0)
} outputs "true\ntrue\nfalse\ntrue"

example "compare" {
  puts compare(1, 2)
  puts compare("a", "aa")
  puts compare(1.5, 1.5)
  puts compare(math.nan, 1.0)
} outputs "-1\n-1\n0\n-1"
