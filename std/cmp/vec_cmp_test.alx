test "vectors: I8" {
  assert_eq compare(i8(-128), i8(-128)), 0
  assert_eq compare(i8(-128), i8(-127)), -1
  assert_eq compare(i8(-128), i8(-1)), -1
  assert_eq compare(i8(-128), i8(0)), -1
  assert_eq compare(i8(-128), i8(1)), -1
  assert_eq compare(i8(-128), i8(126)), -1
  assert_eq compare(i8(-128), i8(127)), -1
  assert_eq compare(i8(-127), i8(-128)), 1
  assert_eq compare(i8(-127), i8(-127)), 0
  assert_eq compare(i8(-127), i8(-1)), -1
  assert_eq compare(i8(-127), i8(0)), -1
  assert_eq compare(i8(-127), i8(1)), -1
  assert_eq compare(i8(-127), i8(126)), -1
  assert_eq compare(i8(-127), i8(127)), -1
  assert_eq compare(i8(-1), i8(-128)), 1
  assert_eq compare(i8(-1), i8(-127)), 1
  assert_eq compare(i8(-1), i8(-1)), 0
  assert_eq compare(i8(-1), i8(0)), -1
  assert_eq compare(i8(-1), i8(1)), -1
  assert_eq compare(i8(-1), i8(126)), -1
  assert_eq compare(i8(-1), i8(127)), -1
  assert_eq compare(i8(0), i8(-128)), 1
  assert_eq compare(i8(0), i8(-127)), 1
  assert_eq compare(i8(0), i8(-1)), 1
  assert_eq compare(i8(0), i8(0)), 0
  assert_eq compare(i8(0), i8(1)), -1
  assert_eq compare(i8(0), i8(126)), -1
  assert_eq compare(i8(0), i8(127)), -1
  assert_eq compare(i8(1), i8(-128)), 1
  assert_eq compare(i8(1), i8(-127)), 1
  assert_eq compare(i8(1), i8(-1)), 1
  assert_eq compare(i8(1), i8(0)), 1
  assert_eq compare(i8(1), i8(1)), 0
  assert_eq compare(i8(1), i8(126)), -1
  assert_eq compare(i8(1), i8(127)), -1
  assert_eq compare(i8(126), i8(-128)), 1
  assert_eq compare(i8(126), i8(-127)), 1
  assert_eq compare(i8(126), i8(-1)), 1
  assert_eq compare(i8(126), i8(0)), 1
  assert_eq compare(i8(126), i8(1)), 1
  assert_eq compare(i8(126), i8(126)), 0
  assert_eq compare(i8(126), i8(127)), -1
  assert_eq compare(i8(127), i8(-128)), 1
  assert_eq compare(i8(127), i8(-127)), 1
  assert_eq compare(i8(127), i8(-1)), 1
  assert_eq compare(i8(127), i8(0)), 1
  assert_eq compare(i8(127), i8(1)), 1
  assert_eq compare(i8(127), i8(126)), 1
  assert_eq compare(i8(127), i8(127)), 0
}

def fb(b: U64) -> Float { math.float64frombits(b) }

def u(x: U64) -> U64 { x }

def i8(x: I8) -> I8 { x }

