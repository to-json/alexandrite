}

test "vectors: or" {
  e: [Int] = []
  assert_eq or(e), 0
  assert_eq or([0]), 0
  assert_eq or([0, 0]), 0
  assert_eq or([0, 0, 9]), 9
  assert_eq or([-1, 2]), -1
  assert_eq or([0, -3, 4]), -3
  assert_eq or([5, 0]), 5
}
