  assert_eq less?("Ã©", "Ã©"), false
  assert_eq compare("Ã©", "z"), 1
  assert_eq less?("Ã©", "z"), false
  assert_eq compare("Ã©", "æ¥æ¬"), -1
  assert_eq less?("Ã©", "æ¥æ¬"), true
  assert_eq compare("z", ""), 1
  assert_eq less?("z", ""), false
