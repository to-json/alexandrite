# Generated by a throwaway program: inputs compressed by the bzip2 command
# (Go has no bzip2 compressor) and decompressed by Go's compress/bzip2
# (go1.27.1): the size and CRC-32 of Go's output. Do not edit by hand.

test "vec bzip2 0 empty" {
  assert_eq vec_bunzip2(
    "425a683117724538509000000000"
  ), "0 00000000"
  assert_eq vec_bunzip2(
    "425a683917724538509000000000"
  ), "0 00000000"
}

test "vec bzip2 1 one byte" {
  assert_eq vec_bunzip2(
    "425a6831314159265359774bb01400000000800040200021184682ee48a70a120ee9760280"
  ), "1 8cdc1683"
  assert_eq vec_bunzip2(
    "425a6839314159265359774bb01400000000800040200021184682ee48a70a120ee9760280"
  ), "1 8cdc1683"
}

test "vec bzip2 2 hello" {
  assert_eq vec_bunzip2(
    "425a683131415926535954a49784000002d180001040040644908020003100302068620049d4b21f3f17724538509054" +
      "a49784"
  ), "13 f4247453"
  assert_eq vec_bunzip2(
    "425a683931415926535954a49784000002d180001040040644908020003100302068620049d4b21f3f17724538509054" +
      "a49784"
  ), "13 f4247453"
}

