# Benchmarks on about 10 MB of text: the Opticks text 18 times (the copies
# are further apart than the window, so this compresses like 10 MB of
# distinct text). Each run includes building the input (about 1 ms).
import "bytes"
import "io"
import "os"

def ten_mb -> [Byte] {
  bytes.repeat(os.read_file("testdata/Isaac.Newton-Opticks.txt").unwrap, 18)
}

def bench_encode(level: Int) {
  w = new_writer(io.Discard.new, level).unwrap
  w.write!(ten_mb()).unwrap
  w.close!.unwrap
  nil
}

def bench_decode(level: Int) {
  data = ten_mb()
  buf = bytes.new_buffer([])
  w = new_writer(buf, level).unwrap
  w.write!(data).unwrap
  w.close!.unwrap
  r = new_reader(buf)
  sink: [Byte] = [0; 65536]
  loop {
    n = r.read!(sink).unwrap
    break if n == 0
  }
  nil
}

bench "Encode/10MB/Speed" { bench_encode(BEST_SPEED) }

bench "Encode/10MB/Default" { bench_encode(DEFAULT_COMPRESSION) }

bench "Encode/10MB/Best" { bench_encode(BEST_COMPRESSION) }

# Includes compressing at level 6 first.
bench "EncodeDecode/10MB/Default" { bench_decode(DEFAULT_COMPRESSION) }
