# Package flate: Go's compress/flate, the DEFLATE compressed data format
# (RFC 1951). compress/gzip and compress/zlib build on it.
#
# (API table and differences: see the end of this header once complete.)

# Errors of this package.
pub error FlateError {
  # Corrupt input before the given input offset (Go's CorruptInputError).
  CorruptInput(offset: Int)
  # An error in the flate code itself (Go's InternalError).
  Internal(msg: Str)
  # A compression level outside [-2, 9].
  InvalidLevel(level: Int)
  # A write to a closed Writer.
  WriterClosed

  def message -> Str {
    case self {
      CorruptInput(offset) => "flate: corrupt input before offset #{offset}"
      Internal(msg) => "flate: internal error: #{msg}"
      InvalidLevel(level) => "flate: invalid compression level #{level}: want value in range [-2, 9]"
      WriterClosed => "flate: closed writer"
    }
  }
}

# Zeroed slices.
def zbytes(n: Int) -> [Byte] {
  b: [Byte] = [0; n]
  b
}

def zu32(n: Int) -> [U32] {
  b: [U32] = [0; n]
  b
}

def zi32(n: Int) -> [I32] {
  b: [I32] = [0; n]
  b
}
