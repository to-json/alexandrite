# Package flate: Go's compress/flate, the DEFLATE compressed data format
# (RFC 1951). compress/gzip and compress/zlib build on it.
#
#   Go                                      alx
#   NoCompression, BestSpeed,               NO_COMPRESSION, BEST_SPEED,
#   BestCompression, DefaultCompression,    BEST_COMPRESSION, DEFAULT_COMPRESSION,
#   HuffmanOnly                             HUFFMAN_ONLY
#   NewWriter(w, level) (*Writer, error)    new_writer(w, level) -> ~Writer[W]<FlateError>
#   NewWriterDict(w, level, dict)           new_writer_dict(w, level, dict) -> ~Writer[W]<FlateError>
#   w.Write / Flush / Close / Reset(dst)    w.write! / flush! / close! / reset!(dst)
#   NewReader(r) io.ReadCloser              new_reader(r) -> Reader[R]
#   NewReaderDict(r, dict)                  new_reader_dict(r, dict) -> Reader[R]
#   (reader).Read / Close                   r.read! / close!
#   Resetter.Reset(r, dict) error           r.reset!(r, dict)
#   CorruptInputError(offset)               FlateError.CorruptInput(offset)
#   InternalError(msg)                      FlateError.Internal(msg)
#   (fmt.Errorf invalid level)              FlateError.InvalidLevel(level)
#   errWriterClosed                         FlateError.WriterClosed
#   ReadError, WriteError                   not ported (deprecated, never returned)
#
# Additions: new_reader_exact(r) reads the input only as far as the stream
# goes (Go's behaviour when r is an io.ByteReader); Reader.read_input!,
# Reader.restart! and Writer.write_raw! let gzip and zlib read and write
# their headers and trailers around the stream.
#
# Error messages are Go's.
#
# The compressor is Go 1.27's (levels 1-6 the fast encoders of deflatefast.go
# and level1.go ... level6.go, 7-9 lazy matching, -2 Huffman only, 0
# stored), and its output is Go's byte for byte at every level (see
# vec_flate_test.alx), with one exception: Go 1.27 at levels 7-9 with a
# dictionary leaves the dictionary in the first block's input, so when that
# block is stored the output includes the dictionary and doesn't decompress
# to the input (it fails Go's own round trip); this port starts the block
# after the dictionary, so its output there is correct and differs from
# Go's. Go's float32 cost estimate (EstimatedBits) is reproduced exactly as
# arm64 computes it (fused multiply-adds), so output also matches Go on
# arm64 where amd64's rounding would differ.
#
# Differences from Go:
#  - read! returns 0 at the end of the stream (alx's io shape; Go: io.EOF).
#    Input that ends early fails with io.StreamError.UnexpectedEof. Where Go
#    returns data together with an error, read! returns the data and fails
#    on the next call.
#  - Reader and Writer are generic over what they wrap (`Reader[R]`, like
#    Rust's BufReader<R>): an alx interface value contains its implementors,
#    so a type can't both hold an io.Reader and be one. They are io.Reader /
#    io.Writer themselves (except over an io.Reader / io.Writer value), and
#    share their state across copies (D36): make them with the
#    constructors.
#  - The Reader buffers its input (Go does so for a reader that isn't an
#    io.ByteReader), so it may read past the end of the stream; use
#    new_reader_exact when what follows matters.
#  - Writer.write! writes all of p or fails (alx's io.Writer contract).
#  - A nil and an empty dictionary are the same.

# Errors of this package.
pub error FlateError {
  # Corrupt input before the given input offset (Go's CorruptInputError).
  CorruptInput(offset: Int)
  # An error in the flate code itself (Go's InternalError).
  Internal(msg: Str)
  # A compression level outside [-2, 9].
  InvalidLevel(level: Int)
  # A write to a closed Writer.
  WriterClosed

  def message -> Str {
    case self {
      CorruptInput(offset) => "flate: corrupt input before offset #{offset}"
      Internal(msg) => "flate: internal error: #{msg}"
      InvalidLevel(level) => "flate: invalid compression level #{level}: want value in range [-2, 9]"
      WriterClosed => "flate: closed writer"
    }
  }
}

# Zeroed slices.
def zbytes(n: Int) -> [Byte] {
  b: [Byte] = [0; n]
  b
}

def zu32(n: Int) -> [U32] {
  b: [U32] = [0; n]
  b
}

def zi32(n: Int) -> [I32] {
  b: [I32] = [0; n]
  b
}
