# Go's fuzz_test.go: FuzzEncoding's property on fixed inputs (alx has no
# fuzzing). Each level round-trips, also after reset!, and writes the same
# bytes both times.
import "bytes"
import "io"

test "FuzzEncoding" {
  inputs = [b(""), b("a"), rand_bytes(1000, 9, 255), rand_bytes(70000, 10, 7), fox_text(), large_data_chunk()]
  decoder = new_reader(bytes.new_buffer([]))
  for data in inputs {
    level = HUFFMAN_ONLY
    while level <= BEST_COMPRESSION {
      if level == DEFAULT_COMPRESSION {
        level += 1
        next
      }
      buf = bytes.new_buffer([])
      fw = ~new_writer(buf, level)
      ~fw.write!(data)
      ~fw.close!
      compressed = buf.bytes
      decoder.reset!(buf, [])
      assert ~io.read_all(decoder) == data, "level #{level}: decompressed not equal"
      buf2 = bytes.new_buffer([])
      fw.reset!(buf2)
      ~fw.write!(data)
      ~fw.close!
      compressed2 = buf2.bytes
      decoder.reset!(buf2, [])
      assert ~io.read_all(decoder) == data, "level #{level} (reset): decompressed not equal"
      assert compressed == compressed2, "level #{level}: non-deterministic output"
      level += 1
    }
  }
}
