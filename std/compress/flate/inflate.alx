#![overflow(wrap)]
# The decompressor (Go's inflate.go).

import "io"
import mbits "math/bits"

# The longest Huffman code.
MAX_CODE_LEN = 16
# From RFC 1951 3.2.7 (with 3.2.5: distance codes 30 and 31 never occur).
MAX_NUM_LIT = 286
MAX_NUM_DIST = 30
# The codes of the Huffman meta-code.
NUM_CODES = 19

# Huffman decoding tables, as zlib's (doc/algorithm.txt): a lookup table of
# HUFFMAN_CHUNK_BITS bits whose entries for longer codes link to overflow
# tables. A chunk is value << 4 | bit count.
HUFFMAN_CHUNK_BITS = 9
HUFFMAN_NUM_CHUNKS = 1 << HUFFMAN_CHUNK_BITS
HUFFMAN_COUNT_MASK: U32 = 15
HUFFMAN_VALUE_SHIFT = 4

# The size of the input buffer.
INPUT_BUFFER_SIZE = 4096

CODE_ORDER = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]

STEP_NEXT_BLOCK = 0
STEP_HUFFMAN = 1
STEP_COPY_DATA = 2
STATE_INIT = 0
STATE_DICT = 1

def new_huffman_decoder -> HuffmanDecoder {
  ch: [U32] = [0; HUFFMAN_NUM_CHUNKS]
  ls: [[U32]] = []
  HuffmanDecoder.new(min: 0, chunks: ch, links: ls, link_mask: 0)
}

# The decoder of the fixed literal/length table (RFC 1951 3.2.6).
def fixed_huffman_decoder -> HuffmanDecoder {
  lengths: [Int] = [0; 288]
  i = 0
  while i < 288 {
    if i < 144 {
      lengths[i] = 8
    } else if i < 256 {
      lengths[i] = 9
    } else if i < 280 {
      lengths[i] = 7
    } else {
      lengths[i] = 8
    }
    i += 1
  }
  h = new_huffman_decoder()
  h.init!(lengths)
  h
}

struct HuffmanDecoder {
  # The shortest code.
  min: Int
  chunks: [U32]
  links: [[U32]]
  # The width of the link tables, as a mask.
  link_mask: U32

  # Sets up the tables from code lengths. Afterwards the tree is complete
  # (neither over- nor under-subscribed), except for a single code of
  # length 1; an empty tree is allowed (decoding with it fails). False if
  # the lengths don't make a code.
  def init!(lengths: [Int]) -> Bool {
    if min != 0 {
      i = 0
      while i < HUFFMAN_NUM_CHUNKS {
        self.chunks[i] = 0
        i += 1
      }
      self.links = []
      self.link_mask = 0
      self.min = 0
    }
    # The number of codes of each length; the shortest and longest.
    count: [Int] = [0; MAX_CODE_LEN]
    mn = 0
    mx = 0
    for n in lengths {
      next if n == 0
      mn = n if mn == 0 || n < mn
      mx = n if n > mx
      count[n] += 1
    }
    # An empty tree: huff_sym! fails later if it is used.
    return true if mx == 0
    code = 0
    nextcode: [Int] = [0; MAX_CODE_LEN]
    i = mn
    while i <= mx {
      code = code << 1
      nextcode[i] = code
      code += count[i]
      i += 1
    }
    # The coding must be complete (all 2^max bit sequences assigned),
    # except that zlib accepts a single code of length 1.
    return false if code != 1 << mx && !(code == 1 && mx == 1)
    self.min = mn
    if mx > HUFFMAN_CHUNK_BITS {
      num_links = 1 << (mx - HUFFMAN_CHUNK_BITS)
      self.link_mask = (num_links - 1).as_u32
      # The link tables.
      link = nextcode[HUFFMAN_CHUNK_BITS + 1] >> 1
      ls: [[U32]] = []
      j = link
      while j < HUFFMAN_NUM_CHUNKS {
        reverse = mbits.reverse16(j.as_u16).to_i >> (16 - HUFFMAN_CHUNK_BITS)
        off = j - link
        self.chunks[reverse] = ((off << HUFFMAN_VALUE_SHIFT) | (HUFFMAN_CHUNK_BITS + 1)).as_u32
        lt: [U32] = [0; num_links]
        ls << lt
        j += 1
      }
      self.links = ls
    }
    i = 0
    while i < lengths.size {
      n = lengths[i]
      if n == 0 {
        i += 1
        next
      }
      c = nextcode[n]
      nextcode[n] += 1
      chunk = ((i << HUFFMAN_VALUE_SHIFT) | n).as_u32
      reverse = mbits.reverse16(c.as_u16).to_i >> (16 - n)
      if n <= HUFFMAN_CHUNK_BITS {
        off = reverse
        while off < HUFFMAN_NUM_CHUNKS {
          self.chunks[off] = chunk
          off += 1 << n
        }
      } else {
        j = reverse & (HUFFMAN_NUM_CHUNKS - 1)
        value = (chunks[j] >> HUFFMAN_VALUE_SHIFT).to_i
        linktab = links[value]
        reverse = reverse >> HUFFMAN_CHUNK_BITS
        off = reverse
        while off < linktab.size {
          linktab[off] = chunk
          off += 1 << (n - HUFFMAN_CHUNK_BITS)
        }
      }
      i += 1
    }
    true
  }
}

# The state of a Reader (Go's decompressor). The input is read through a
# buffer: Go's NewReader also buffers an io.Reader that isn't an
# io.ByteReader.
struct Inflater[R] {
  r: R
  inbuf: [Byte]
  ipos: Int
  iend: Int
  # The input reported its end, or failed.
  in_eof: Bool
  # Read the input one byte at a time: never past what is used.
  exact: Bool
  # The input's error and the stream's, boxed: an Error is big, and the
  # state is copied in and out of each ! call.
  eb: [ErrState]
  # Input bytes consumed.
  roffset: Int
  # Input bits, in the low nb bits of b.
  b: U32
  nb: Int
  # The decoders for literal/length and distance codes, and the fixed one.
  h1: HuffmanDecoder
  h2: HuffmanDecoder
  fixed: HuffmanDecoder
  # Code lengths.
  bits: [Int]
  codebits: [Int]
  # The output history.
  dict: DictDecoder
  buf: [Byte]
  # The next step and its state.
  step: Int
  step_state: Int
  final: Bool
  # The end of the stream was reached.
  eof: Bool
  to_read: [Byte]
  # The decoders of the current block; no hd: fixed distance codes.
  hl: HuffmanDecoder
  hd: HuffmanDecoder
  has_hd: Bool
  copy_len: Int
  copy_dist: Int

  def get!(p: [Byte]) -> ~Int { self.r.~read!(p) }

  # Refills the input buffer; false at the end of the input or on an error.
  def fill_input! -> Bool {
    return false if in_eof || !eb[0].in_err.none?
    res = get!(exact ? inbuf[0...1] : inbuf)
    if v = res.ok {
      if v == 0 {
        self.in_eof = true
        return false
      }
      self.ipos = 0
      self.iend = v
      return true
    }
    if e = res.err {
      self.eb[0].in_err = e
    }
    false
  }

  # The error for input that ended early (Go's noEOF(err)).
  def input_error -> Error {
    if e = eb[0].in_err {
      return e
    }
    io.StreamError.UnexpectedEof
  }

  # Errors are set out of line: an Error value is big, and building one
  # in a hot function costs on every call.
  def set_corrupt! {
    self.eb[0].err = FlateError.CorruptInput(offset: roffset)
    nil
  }

  def set_input_error! {
    self.eb[0].err = input_error
    nil
  }

  # One more input byte into b; false (with err set) at the end of input.
  def more_bits! -> Bool {
    if ipos == iend && !fill_input! {
      set_input_error!
      return false
    }
    c = inbuf[ipos]
    self.ipos += 1
    self.roffset += 1
    self.b = b | (c.as_u32 << nb)
    self.nb += 8
    true
  }

  # Reads up to p.size raw input bytes; fewer only at the end of the input.
  def read_input!(p: [Byte]) -> Int {
    n = 0
    while n < p.size {
      if ipos == iend {
        break if !fill_input!
      }
      k = copy(p[n...p.size], inbuf[ipos...iend])
      self.ipos += k
      n += k
    }
    self.roffset += n
    n
  }

  def next_block! {
    while nb < 1 + 2 {
      return if !more_bits!
    }
    self.final = b & 1 == 1
    self.b = b >> 1
    typ = b & 3
    self.b = b >> 2
    self.nb -= 1 + 2
    if typ == 0 {
      data_block!
    } else if typ == 1 {
      # Compressed, fixed Huffman tables.
      self.hl = fixed
      self.has_hd = false
      huffman_block!
    } else if typ == 2 {
      # Compressed, dynamic Huffman tables.
      return if !read_huffman!
      self.hl = h1
      self.hd = h2
      self.has_hd = true
      huffman_block!
    } else {
      # 3 is reserved.
      set_corrupt!
    }
    nil
  }

  # Decompresses into p; returns the count, 0 at the end of the stream.
  def read!(p: [Byte]) -> ~Int {
    loop {
      if to_read.size > 0 {
        n = copy(p, to_read)
        self.to_read = to_read[n...to_read.size]
        return n
      }
      return 0 if eof
      if e = eb[0].err {
        fail e
      }
      run_step!
      if (eof || !eb[0].err.none?) && to_read.size == 0 {
        # Flush what's left, in case of an error.
        self.to_read = self.dict.read_flush!
      }
    }
  }

  def run_step! {
    case step {
      STEP_NEXT_BLOCK => next_block!
      STEP_HUFFMAN => huffman_block!
      _ => copy_data!
    }
    nil
  }

  # Reads a dynamic block's code tables (RFC 1951 3.2.7); false on an
  # error (in err).
  def read_huffman! -> Bool {
    # HLIT[5], HDIST[5], HCLEN[4].
    while nb < 5 + 5 + 4 {
      return false if !more_bits!
    }
    nlit = (b & 0x1f).to_i + 257
    if nlit > MAX_NUM_LIT {
      set_corrupt!
      return false
    }
    self.b = b >> 5
    ndist = (b & 0x1f).to_i + 1
    if ndist > MAX_NUM_DIST {
      set_corrupt!
      return false
    }
    self.b = b >> 5
    nclen = (b & 0xf).to_i + 4
    # NUM_CODES is 19, so nclen is always valid.
    self.b = b >> 4
    self.nb -= 5 + 5 + 4
    # (HCLEN + 4) * 3 bits: code lengths in CODE_ORDER.
    i = 0
    while i < nclen {
      while nb < 3 {
        return false if !more_bits!
      }
      self.codebits[CODE_ORDER[i]] = (b & 0x7).to_i
      self.b = b >> 3
      self.nb -= 3
      i += 1
    }
    i = nclen
    while i < CODE_ORDER.size {
      self.codebits[CODE_ORDER[i]] = 0
      i += 1
    }
    if !self.h1.init!(codebits) {
      set_corrupt!
      return false
    }
    # HLIT + 257 code lengths and HDIST + 1, with the code length code.
    i = 0
    n = nlit + ndist
    while i < n {
      x = huff_sym!(h1)
      return false if x < 0
      if x < 16 {
        # An actual length.
        self.bits[i] = x
        i += 1
        next
      }
      # Repeat the previous length or zero.
      rep = 0
      nbits = 0
      bv = 0
      if x == 16 {
        rep = 3
        nbits = 2
        if i == 0 {
          set_corrupt!
          return false
        }
        bv = bits[i - 1]
      } else if x == 17 {
        rep = 3
        nbits = 3
      } else if x == 18 {
        rep = 11
        nbits = 7
      } else {
        self.eb[0].err = FlateError.Internal(msg: "unexpected length code")
        return false
      }
      while nb < nbits {
        return false if !more_bits!
      }
      rep += (b & ((1 << nbits) - 1).as_u32).to_i
      self.b = b >> nbits
      self.nb -= nbits
      if i + rep > n {
        set_corrupt!
        return false
      }
      j = 0
      while j < rep {
        self.bits[i] = bv
        i += 1
        j += 1
      }
    }
    if !self.h1.init!(bits[0...nlit]) || !self.h2.init!(bits[nlit...nlit + ndist]) {
      set_corrupt!
      return false
    }
    # Every block ends with an EOB, so at least its length can be read at
    # a time; no extra bytes are read after the end of the stream.
    self.h1.min = bits[END_BLOCK_MARKER] if h1.min < bits[END_BLOCK_MARKER]
    true
  }

  # Decodes a Huffman block (RFC 1951 3.2.3) until the output buffer
  # fills or the block ends. The hot loop works on locals (the bit buffer,
  # the input position, the window), which stay in registers, and makes
  # no ! calls except to refill the input.
  def huffman_block! {
    inb = inbuf
    ip = ipos
    ie = iend
    bb = b
    nbb = nb
    ro = roffset
    hist = dict.hist
    hsize = hist.size
    wr = dict.wr_pos
    full = dict.full
    l_min = hl.min
    l_chunks = hl.chunks
    l_links = hl.links
    l_mask = hl.link_mask
    fixed_dist = !has_hd
    d_min = hd.min
    d_chunks = hd.chunks
    d_links = hd.links
    d_mask = hd.link_mask
    cl = copy_len
    cd = copy_dist
    in_copy = step_state == STATE_DICT
    # How the loop ended: 1 input error, 2 corrupt input, 3 output full
    # (after a literal), 4 end of block, 5 output full (in a copy).
    exit = 0
    while exit == 0 {
      if !in_copy {
        # A literal, or a (length, distance) pair: Go's huffSym, inline.
        n = l_min
        v = -1
        while v < 0 {
          while nbb < n {
            if ip == ie {
              self.ipos = ip
              self.roffset = ro
              if !fill_input! {
                exit = 1
                break
              }
              ip = ipos
              ie = iend
            }
            bb = bb | (inb[ip].as_u32 << (nbb & 31))
            ip += 1
            ro += 1
            nbb += 8
          }
          break if exit != 0
          chunk = l_chunks[(bb & 511).to_i]
          n = (chunk & HUFFMAN_COUNT_MASK).to_i
          if n > HUFFMAN_CHUNK_BITS {
            chunk = l_links[(chunk >> HUFFMAN_VALUE_SHIFT).to_i][((bb >> HUFFMAN_CHUNK_BITS) & l_mask).to_i]
            n = (chunk & HUFFMAN_COUNT_MASK).to_i
          }
          if n <= nbb {
            if n == 0 {
              exit = 2
              break
            }
            bb = bb >> (n & 31)
            nbb -= n
            v = (chunk >> HUFFMAN_VALUE_SHIFT).to_i
          }
        }
        break if exit != 0
        if v < 256 {
          hist[wr] = v.as_u8
          wr += 1
          exit = 3 if wr == hsize
          next
        }
        if v == 256 {
          exit = 4
          break
        }
        # A reference to older data.
        length = 0
        nx = 0
        if v < 265 {
          length = v - (257 - 3)
        } else if v < 269 {
          length = v * 2 - (265 * 2 - 11)
          nx = 1
        } else if v < 273 {
          length = v * 4 - (269 * 4 - 19)
          nx = 2
        } else if v < 277 {
          length = v * 8 - (273 * 8 - 35)
          nx = 3
        } else if v < 281 {
          length = v * 16 - (277 * 16 - 67)
          nx = 4
        } else if v < 285 {
          length = v * 32 - (281 * 32 - 131)
          nx = 5
        } else if v < MAX_NUM_LIT {
          length = 258
        } else {
          exit = 2
          break
        }
        if nx > 0 {
          while nbb < nx {
            if ip == ie {
              self.ipos = ip
              self.roffset = ro
              if !fill_input! {
                exit = 1
                break
              }
              ip = ipos
              ie = iend
            }
            bb = bb | (inb[ip].as_u32 << (nbb & 31))
            ip += 1
            ro += 1
            nbb += 8
          }
          break if exit != 0
          length += (bb & ((1 << nx) - 1).as_u32).to_i
          bb = bb >> nx
          nbb -= nx
        }
        dist = -1
        if fixed_dist {
          while nbb < 5 {
            if ip == ie {
              self.ipos = ip
              self.roffset = ro
              if !fill_input! {
                exit = 1
                break
              }
              ip = ipos
              ie = iend
            }
            bb = bb | (inb[ip].as_u32 << (nbb & 31))
            ip += 1
            ro += 1
            nbb += 8
          }
          break if exit != 0
          dist = mbits.reverse8(((bb & 0x1f) << 3).as_u8).to_i
          bb = bb >> 5
          nbb -= 5
        } else {
          n = d_min
          while dist < 0 {
            while nbb < n {
              if ip == ie {
                self.ipos = ip
                self.roffset = ro
                if !fill_input! {
                  exit = 1
                  break
                }
                ip = ipos
                ie = iend
              }
              bb = bb | (inb[ip].as_u32 << (nbb & 31))
              ip += 1
              ro += 1
              nbb += 8
            }
            break if exit != 0
            chunk = d_chunks[(bb & 511).to_i]
            n = (chunk & HUFFMAN_COUNT_MASK).to_i
            if n > HUFFMAN_CHUNK_BITS {
              chunk = d_links[(chunk >> HUFFMAN_VALUE_SHIFT).to_i][((bb >> HUFFMAN_CHUNK_BITS) & d_mask).to_i]
              n = (chunk & HUFFMAN_COUNT_MASK).to_i
            }
            if n <= nbb {
              if n == 0 {
                exit = 2
                break
              }
              bb = bb >> (n & 31)
              nbb -= n
              dist = (chunk >> HUFFMAN_VALUE_SHIFT).to_i
            }
          }
          break if exit != 0
        }
        if dist < 4 {
          dist += 1
        } else if dist < MAX_NUM_DIST {
          nbits = (dist - 2) >> 1
          # One bit in the bottom of dist; nbits more.
          extra = (dist & 1) << nbits
          while nbb < nbits {
            if ip == ie {
              self.ipos = ip
              self.roffset = ro
              if !fill_input! {
                exit = 1
                break
              }
              ip = ipos
              ie = iend
            }
            bb = bb | (inb[ip].as_u32 << (nbb & 31))
            ip += 1
            ro += 1
            nbb += 8
          }
          break if exit != 0
          extra = extra | (bb & ((1 << nbits) - 1).as_u32).to_i
          bb = bb >> nbits
          nbb -= nbits
          dist = (1 << (nbits + 1)) + 1 + extra
        } else {
          exit = 2
          break
        }
        # No check on the length: the encoding can be prescient.
        if dist > (full ? hsize : wr) {
          exit = 2
          break
        }
        cl = length
        cd = dist
      }
      in_copy = false
      # A backward copy (RFC 1951 3.2.3); Go's tryWriteCopy, inline.
      endp = wr + cl
      if wr >= cd && endp <= hsize {
        src = wr - cd
        if cl <= 32 || cd < cl {
          # A forward byte copy: overlap repeats, as LZ77 wants.
          i = 0
          while i < cl {
            hist[wr + i] = hist[src + i]
            i += 1
          }
        } else {
          copy(hist[wr...endp], hist[src...src + cl])
        }
        wr = endp
        cl = 0
      } else {
        self.dict.wr_pos = wr
        cnt = self.dict.write_copy!(cd, cl)
        wr = dict.wr_pos
        cl -= cnt
      }
      exit = 5 if wr == hsize || cl > 0
    }
    self.ipos = ip
    self.b = bb
    self.nb = nbb
    self.roffset = ro
    self.dict.wr_pos = wr
    self.copy_len = cl
    self.copy_dist = cd
    if exit == 1 {
      set_input_error!
    } else if exit == 2 {
      set_corrupt!
    } else if exit == 3 {
      self.to_read = self.dict.read_flush!
      self.step = STEP_HUFFMAN
      self.step_state = STATE_INIT
    } else if exit == 4 {
      finish_block!
    } else {
      self.to_read = self.dict.read_flush!
      # More of this work later.
      self.step = STEP_HUFFMAN
      self.step_state = STATE_DICT
    }
    nil
  }

  # A stored block.
  def data_block! {
    # Discard the current half-byte.
    self.nb = 0
    self.b = 0
    # The length, then its ones' complement.
    nr = read_input!(buf[0...4])
    if nr < 4 {
      set_input_error!
      return
    }
    n = buf[0].to_i | (buf[1].to_i << 8)
    nn = buf[2].to_i | (buf[3].to_i << 8)
    if nn != (n ^ 0xffff) {
      set_corrupt!
      return
    }
    if n == 0 {
      self.to_read = self.dict.read_flush!
      finish_block!
      return
    }
    self.copy_len = n
    copy_data!
    nil
  }

  # Copies copy_len input bytes into the history, pausing when it fills.
  def copy_data! {
    bf = dict.write_slice
    bf = bf[0...copy_len] if bf.size > copy_len
    cnt = read_input!(bf)
    self.copy_len -= cnt
    self.dict.write_mark!(cnt)
    if cnt < bf.size {
      set_input_error!
      return
    }
    if dict.avail_write == 0 || copy_len > 0 {
      self.to_read = self.dict.read_flush!
      self.step = STEP_COPY_DATA
      return
    }
    finish_block!
    nil
  }

  def finish_block! {
    if final {
      self.to_read = self.dict.read_flush! if dict.avail_read > 0
      self.eof = true
    }
    self.step = STEP_NEXT_BLOCK
    nil
  }

  # The next symbol, decoded with h; -1 on an error (in err). An empty or
  # single-code tree has zero chunks for invalid sequences, which fail.
  def huff_sym!(h: HuffmanDecoder) -> Int {
    n = h.min
    nbl = nb
    bl = b
    loop {
      while nbl < n {
        if ipos == iend && !fill_input! {
          self.b = bl
          self.nb = nbl
          set_input_error!
          return -1
        }
        c = inbuf[ipos]
        self.ipos += 1
        self.roffset += 1
        bl = bl | (c.as_u32 << (nbl & 31))
        nbl += 8
      }
      chunk = h.chunks[(bl & (HUFFMAN_NUM_CHUNKS - 1).as_u32).to_i]
      n = (chunk & HUFFMAN_COUNT_MASK).to_i
      if n > HUFFMAN_CHUNK_BITS {
        chunk = h.links[(chunk >> HUFFMAN_VALUE_SHIFT).to_i][((bl >> HUFFMAN_CHUNK_BITS) & h.link_mask).to_i]
        n = (chunk & HUFFMAN_COUNT_MASK).to_i
      }
      if n <= nbl {
        if n == 0 {
          self.b = bl
          self.nb = nbl
          set_corrupt!
          return -1
        }
        self.b = bl >> (n & 31)
        self.nb = nbl - n
        return (chunk >> HUFFMAN_VALUE_SHIFT).to_i
      }
    }
  }

  # Starts a new stream from the same input (keeping what is buffered).
  def restart!(dict0: [Byte]) {
    self.roffset = 0
    self.b = 0
    self.nb = 0
    self.step = STEP_NEXT_BLOCK
    self.step_state = STATE_INIT
    self.final = false
    self.eof = false
    self.eb[0].err = none
    self.to_read = []
    self.has_hd = false
    self.copy_len = 0
    self.copy_dist = 0
    self.h1 = new_huffman_decoder()
    self.h2 = new_huffman_decoder()
    self.dict.init!(MAX_MATCH_OFFSET, dict0)
    nil
  }
}

def new_inflater[R](r: R, dict: [Byte]) -> Inflater[R] {
  ib: [Byte] = [0; INPUT_BUFFER_SIZE]
  bs: [Int] = [0; MAX_NUM_LIT + MAX_NUM_DIST]
  cb: [Int] = [0; NUM_CODES]
  b4: [Byte] = [0; 4]
  tr: [Byte] = []
  fixed = fixed_huffman_decoder()
  Inflater[R].new(
    r: r,
    inbuf: ib,
    ipos: 0,
    iend: 0,
    in_eof: false,
    exact: false,
    eb: [ErrState.new(err: none, in_err: none)],
    roffset: 0,
    b: 0,
    nb: 0,
    h1: new_huffman_decoder(),
    h2: new_huffman_decoder(),
    fixed: fixed,
    bits: bs,
    codebits: cb,
    dict: new_dict_decoder(MAX_MATCH_OFFSET, dict),
    buf: b4,
    step: STEP_NEXT_BLOCK,
    step_state: STATE_INIT,
    final: false,
    eof: false,
    to_read: tr,
    hl: fixed,
    hd: fixed,
    has_hd: false,
    copy_len: 0,
    copy_dist: 0
  )
}

# Decompresses what it reads from R (Go's flate.NewReader result).
pub struct Reader[R] {
  st: [Inflater[R]]

  # Decompresses into p; returns the count, 0 at the end of the stream.
  # Corrupt input fails with FlateError.CorruptInput, input that ends early
  # with io.StreamError.UnexpectedEof.
  pub def read!(p: [Byte]) -> ~Int {
    self.st[0].~read!(p)
  }

  # Fails with the stream's error, if any (the end of the stream is not one).
  pub def close! -> ~Unit {
    if e = st[0].eb[0].err {
      fail e
    }
  }

  # Discards the state and starts over on r with the preset dictionary
  # `dict` (empty for none), as new_reader_dict(r, dict) would (Go's
  # Resetter).
  pub def reset!(r: R, dict: [Byte]) {
    self.st[0].r = r
    self.st[0].ipos = 0
    self.st[0].iend = 0
    self.st[0].in_eof = false
    self.st[0].eb[0].in_err = none
    self.st[0].restart!(dict)
    nil
  }

  # Starts a new stream on the same input, keeping the bytes already
  # buffered (gzip's multistream reading).
  pub def restart!(dict: [Byte]) {
    self.st[0].restart!(dict)
    nil
  }

  # Reads up to p.size bytes of raw input (not decompressed) from where the
  # stream left off; fewer only at the end of the input. gzip and zlib
  # read their headers and trailers this way.
  pub def read_input!(p: [Byte]) -> ~Int {
    n = self.st[0].read_input!(p)
    if n < p.size {
      if e = st[0].eb[0].in_err {
        fail e
      }
    }
    n
  }
}

# A Reader decompressing the DEFLATE stream read from r. It reads ahead of
# the stream's end (buffered); data after the final block is ignored.
pub def new_reader[R](r: R) -> Reader[R] {
  e: [Byte] = []
  Reader[R].new(st: [new_inflater(r, e)])
}

# A Reader whose stream starts with the dictionary dict already read, as
# written by new_writer_dict.
pub def new_reader_dict[R](r: R, dict: [Byte]) -> Reader[R] {
  Reader[R].new(st: [new_inflater(r, dict)])
}

# Like new_reader, but reads r only as far as the stream goes, one byte at
# a time: what follows the stream stays in r (Go's behaviour when r is an
# io.ByteReader). Slower than new_reader on an unbuffered r.
pub def new_reader_exact[R](r: R) -> Reader[R] {
  e: [Byte] = []
  f = new_inflater(r, e)
  f.exact = true
  Reader[R].new(st: [f])
}

struct ErrState {
  err: Error?
  in_err: Error?
}
