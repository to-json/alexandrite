test "vec chunked 0 flush=false" {
  assert_eq vec_deflate(rand_bytes(5000, 3, 3), -2, 1000, false, none), "1413 677596f6"
  assert_eq vec_deflate(rand_bytes(5000, 3, 3), 0, 1000, false, none), "5007 8b11063b"
  assert_eq vec_deflate(rand_bytes(5000, 3, 3), 1, 1000, false, none), "1695 293fde48"
  assert_eq vec_deflate(rand_bytes(5000, 3, 3), 2, 1000, false, none), "1680 7c6a820c"
  assert_eq vec_deflate(rand_bytes(5000, 3, 3), 3, 1000, false, none), "1660 24651f36"
  assert_eq vec_deflate(rand_bytes(5000, 3, 3), 4, 1000, false, none), "1691 d285d090"
