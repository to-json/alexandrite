}

test "vec chunked 0 flush=true" {
  assert_eq vec_deflate(rand_bytes(5000, 3, 3), -2, 1000, true, none), "1487 72651a4c"
  assert_eq vec_deflate(rand_bytes(5000, 3, 3), 0, 1000, true, none), "5052 1fe5f2fc"
  assert_eq vec_deflate(rand_bytes(5000, 3, 3), 1, 1000, true, none), "1730 6745270f"
  assert_eq vec_deflate(rand_bytes(5000, 3, 3), 2, 1000, true, none), "1700 7bf105c3"
