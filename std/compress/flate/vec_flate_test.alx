# Generated from Go's compress/flate (go1.27.1) by a throwaway program: the
# compressed output of each input at each level (hex, or size and CRC-32
# when long); vec_deflate also checks the round trip. Do not edit by hand.

test "vec deflate 0" {
  assert_eq vec_deflate(b(""), -2, 0, false, none), "0300"
  assert_eq vec_deflate(b(""), 0, 0, false, none), "0300"
  assert_eq vec_deflate(b(""), 1, 0, false, none), "0300"
  assert_eq vec_deflate(b(""), 2, 0, false, none), "0300"
  assert_eq vec_deflate(b(""), 3, 0, false, none), "0300"
  assert_eq vec_deflate(b(""), 4, 0, false, none), "0300"
  assert_eq vec_deflate(b(""), 5, 0, false, none), "0300"
  assert_eq vec_deflate(b(""), 6, 0, false, none), "0300"
  assert_eq vec_deflate(b(""), 7, 0, false, none), "0300"
  assert_eq vec_deflate(b(""), 8, 0, false, none), "0300"
  assert_eq vec_deflate(b(""), 9, 0, false, none), "0300"
}

test "vec deflate 1" {
  assert_eq vec_deflate(b("a"), -2, 0, false, none), "000100feff610300"
  assert_eq vec_deflate(b("a"), 0, 0, false, none), "000100feff610300"
  assert_eq vec_deflate(b("a"), 1, 0, false, none), "000100feff610300"
  assert_eq vec_deflate(b("a"), 2, 0, false, none), "000100feff610300"
  assert_eq vec_deflate(b("a"), 3, 0, false, none), "000100feff610300"
  assert_eq vec_deflate(b("a"), 4, 0, false, none), "000100feff610300"
  assert_eq vec_deflate(b("a"), 5, 0, false, none), "000100feff610300"
  assert_eq vec_deflate(b("a"), 6, 0, false, none), "000100feff610300"
  assert_eq vec_deflate(b("a"), 7, 0, false, none), "4a040c00"
  assert_eq vec_deflate(b("a"), 8, 0, false, none), "4a040c00"
  assert_eq vec_deflate(b("a"), 9, 0, false, none), "4a040c00"
}

test "vec deflate 2" {
  assert_eq vec_deflate(b("hello, world\n"), -2, 0, false, none), "000d00f2ff68656c6c6f2c20776f726c640a0300"
  assert_eq vec_deflate(b("hello, world\n"), 0, 0, false, none), "000d00f2ff68656c6c6f2c20776f726c640a0300"
  assert_eq vec_deflate(b("hello, world\n"), 1, 0, false, none), "000d00f2ff68656c6c6f2c20776f726c640a0300"
  assert_eq vec_deflate(b("hello, world\n"), 2, 0, false, none), "000d00f2ff68656c6c6f2c20776f726c640a0300"
  assert_eq vec_deflate(b("hello, world\n"), 3, 0, false, none), "000d00f2ff68656c6c6f2c20776f726c640a0300"
  assert_eq vec_deflate(b("hello, world\n"), 4, 0, false, none), "000d00f2ff68656c6c6f2c20776f726c640a0300"
  assert_eq vec_deflate(b("hello, world\n"), 5, 0, false, none), "000d00f2ff68656c6c6f2c20776f726c640a0300"
  assert_eq vec_deflate(b("hello, world\n"), 6, 0, false, none), "000d00f2ff68656c6c6f2c20776f726c640a0300"
  assert_eq vec_deflate(b("hello, world\n"), 7, 0, false, none), "ca48cdc9c9d75128cf2fca49e1020c00"
  assert_eq vec_deflate(b("hello, world\n"), 8, 0, false, none), "ca48cdc9c9d75128cf2fca49e1020c00"
  assert_eq vec_deflate(b("hello, world\n"), 9, 0, false, none), "ca48cdc9c9d75128cf2fca49e1020c00"
}

test "vec deflate 3" {
  assert_eq vec_deflate(b("abc" * 100), -2, 0, false, none), "04c0010100000040a0adf8ff411886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886610f00"
  assert_eq vec_deflate(b("abc" * 100), 0, 0, false, none), "307 85bad5df"
  assert_eq vec_deflate(b("abc" * 100), 1, 0, false, none), "4a4c4a1e454422c000"
  assert_eq vec_deflate(b("abc" * 100), 2, 0, false, none), "4a4c4a1e454422c000"
  assert_eq vec_deflate(b("abc" * 100), 3, 0, false, none), "4a4c4a1e454422c000"
  assert_eq vec_deflate(b("abc" * 100), 4, 0, false, none), "4a4c4a1e454422c000"
  assert_eq vec_deflate(b("abc" * 100), 5, 0, false, none), "4a4c4a1e454422c000"
  assert_eq vec_deflate(b("abc" * 100), 6, 0, false, none), "4a4c4a1e454422c000"
  assert_eq vec_deflate(b("abc" * 100), 7, 0, false, none), "4a4c4a1e454422c000"
  assert_eq vec_deflate(b("abc" * 100), 8, 0, false, none), "4a4c4a1e454422c000"
  assert_eq vec_deflate(b("abc" * 100), 9, 0, false, none), "4a4c4a1e454422c000"
}

test "vec deflate 4" {
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), -2, 0, false, none), "7149 d4d3a877"
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), 0, 0, false, none), "16007 03627551"
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), 1, 0, false, none), "ecc7c109c0200c00c055d27ff7681709f80844747f7010ef797f56f51b5fcf916b3fc1cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc77fa0c00"
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), 2, 0, false, none), "ecc7c109c0200c00c055d27ff7681709f80844747f7010ef797f56f51b5fcf916b3fc1cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc77fa0c00"
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), 3, 0, false, none), "ecc7c109c0200c00c055d27ff7681709f80844747f7010ef797f56f51b5fcf916b3fc1cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc77fa0c00"
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), 4, 0, false, none), "ecc7c109c0200c00c055d27ff7681709f80844747f7010ef797f56f51b5fcf916b3fc1cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc77fa0c00"
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), 5, 0, false, none), "ecc7c109c0200c00c055d27ff7681709f80844747f7010ef797f56f51b5fcf916b3fc1cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc77fa0c00"
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), 6, 0, false, none), "ecc7c109c0200c00c055d27ff7681709f80844747f7010ef797f56f51b5fcf916b3fc1cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc77fa0c00"
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), 7, 0, false, none), "ecc7c109c0200c00c055d27ff7681709f80844747f7010ef797f56f51b5fcf916b3fc1cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc77fa0c00"
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), 8, 0, false, none), "ecc7c109c0200c00c055d27ff7681709f80844747f7010ef797f56f51b5fcf916b3fc1cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc77fa0c00"
  assert_eq vec_deflate(b("Hello, Gophers! " * 1000), 9, 0, false, none), "ecc7c109c0200c00c055d27ff7681709f80844747f7010ef797f56f51b5fcf916b3fc1cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc77fa0c00"
}

