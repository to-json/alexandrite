# Go's fuzz_test.go: FuzzReader's property on its seed inputs (alx has no
# fuzzing): whatever reads without error re-compresses at every level.
import "bytes"
import "encoding/base64"
import "io"
import "os"
import "strings"

test "FuzzReader" {
  inp = b("Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.")
  seeds: [[Byte]] = []
  for level in [BEST_SPEED, BEST_COMPRESSION, DEFAULT_COMPRESSION, HUFFMAN_ONLY] {
    bf = bytes.new_buffer([])
    w = ~new_writer_level(bf, level)
    # Not closed, as in Go: a truncated stream.
    ~w.write!(inp)
    seeds << bf.bytes
  }
  for de in ~os.read_dir("testdata") {
    next if de.is_dir
    data = ~os.read_file("testdata/" + de.name)
    if strings.has_suffix(de.name, ".base64") {
      data = base64.std_encoding().~decode_string(strings.replace_all(Str.from_bytes(data), "\n", ""))
    }
    seeds << data
  }
  for s in seeds {
    for multistream in [true, false] {
      rr = new_reader(slice_reader(s))
      next if rr.err?
      r = rr.unwrap.unwrap_or(Reader[SliceReader].new())
      next if r.st.size == 0
      r.multistream!(multistream)
      decompressed = bytes.new_buffer([])
      next if io.copy(decompressed, r).err?
      next if r.close!.err?
      for level in [NO_COMPRESSION, BEST_SPEED, BEST_COMPRESSION, DEFAULT_COMPRESSION, HUFFMAN_ONLY] {
        w = ~new_writer_level(io.Discard.new, level)
        ~w.write!(decompressed.bytes)
        ~w.flush!
        ~w.close!
      }
    }
  }
}
