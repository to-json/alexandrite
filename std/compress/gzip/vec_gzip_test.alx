# Generated from Go's compress/gzip (go1.27.1) by a throwaway program: the
# output for each input at each level (hex, or size and CRC-32 when long);
# the helper also checks the round trip. Do not edit by hand.

test "vec gzip 0" {
  assert_eq vec_gzip(b(""), -2, false), "1f8b08000000000000ff03000000000000000000"
  assert_eq vec_gzip(b(""), -2, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
  assert_eq vec_gzip(b(""), 0, false), "1f8b08000000000000ff03000000000000000000"
  assert_eq vec_gzip(b(""), 0, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
  assert_eq vec_gzip(b(""), 1, false), "1f8b08000000000004ff03000000000000000000"
  assert_eq vec_gzip(b(""), 1, true), "1f8b081cd202964904ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
  assert_eq vec_gzip(b(""), 2, false), "1f8b08000000000000ff03000000000000000000"
  assert_eq vec_gzip(b(""), 2, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
  assert_eq vec_gzip(b(""), 3, false), "1f8b08000000000000ff03000000000000000000"
  assert_eq vec_gzip(b(""), 3, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
  assert_eq vec_gzip(b(""), 4, false), "1f8b08000000000000ff03000000000000000000"
  assert_eq vec_gzip(b(""), 4, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
  assert_eq vec_gzip(b(""), 5, false), "1f8b08000000000000ff03000000000000000000"
  assert_eq vec_gzip(b(""), 5, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
  assert_eq vec_gzip(b(""), 6, false), "1f8b08000000000000ff03000000000000000000"
  assert_eq vec_gzip(b(""), 6, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
  assert_eq vec_gzip(b(""), 7, false), "1f8b08000000000000ff03000000000000000000"
  assert_eq vec_gzip(b(""), 7, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
  assert_eq vec_gzip(b(""), 8, false), "1f8b08000000000000ff03000000000000000000"
  assert_eq vec_gzip(b(""), 8, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
  assert_eq vec_gzip(b(""), 9, false), "1f8b08000000000002ff03000000000000000000"
  assert_eq vec_gzip(b(""), 9, true), "1f8b081cd202964902ff020078796e616d652e747874006120636f6d6d656e740003000000000000000000"
}

test "vec gzip 1" {
  assert_eq vec_gzip(b("hello, world\n"), -2, false), "1f8b08000000000000ff000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), -2, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e7400000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 0, false), "1f8b08000000000000ff000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 0, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e7400000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 1, false), "1f8b08000000000004ff000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 1, true), "1f8b081cd202964904ff020078796e616d652e747874006120636f6d6d656e7400000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 2, false), "1f8b08000000000000ff000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 2, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e7400000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 3, false), "1f8b08000000000000ff000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 3, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e7400000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 4, false), "1f8b08000000000000ff000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 4, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e7400000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 5, false), "1f8b08000000000000ff000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 5, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e7400000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 6, false), "1f8b08000000000000ff000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 6, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e7400000d00f2ff68656c6c6f2c20776f726c640a0300537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 7, false), "1f8b08000000000000ffca48cdc9c9d75128cf2fca49e1020c00537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 7, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e7400ca48cdc9c9d75128cf2fca49e1020c00537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 8, false), "1f8b08000000000000ffca48cdc9c9d75128cf2fca49e1020c00537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 8, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e7400ca48cdc9c9d75128cf2fca49e1020c00537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 9, false), "1f8b08000000000002ffca48cdc9c9d75128cf2fca49e1020c00537424f40d000000"
  assert_eq vec_gzip(b("hello, world\n"), 9, true), "1f8b081cd202964902ff020078796e616d652e747874006120636f6d6d656e7400ca48cdc9c9d75128cf2fca49e1020c00537424f40d000000"
}

test "vec gzip 2" {
  assert_eq vec_gzip(b("abc" * 100), -2, false), "108 695cd2fa"
  assert_eq vec_gzip(b("abc" * 100), -2, true), "131 aeeac582"
  assert_eq vec_gzip(b("abc" * 100), 0, false), "325 4d441574"
  assert_eq vec_gzip(b("abc" * 100), 0, true), "348 2ae8b4e3"
  assert_eq vec_gzip(b("abc" * 100), 1, false), "1f8b08000000000004ff4a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 1, true), "1f8b081cd202964904ff020078796e616d652e747874006120636f6d6d656e74004a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 2, false), "1f8b08000000000000ff4a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 2, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e74004a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 3, false), "1f8b08000000000000ff4a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 3, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e74004a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 4, false), "1f8b08000000000000ff4a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 4, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e74004a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 5, false), "1f8b08000000000000ff4a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 5, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e74004a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 6, false), "1f8b08000000000000ff4a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 6, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e74004a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 7, false), "1f8b08000000000000ff4a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 7, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e74004a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 8, false), "1f8b08000000000000ff4a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 8, true), "1f8b081cd202964900ff020078796e616d652e747874006120636f6d6d656e74004a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 9, false), "1f8b08000000000002ff4a4c4a1e454422c00084b8c4d02c010000"
  assert_eq vec_gzip(b("abc" * 100), 9, true), "1f8b081cd202964902ff020078796e616d652e747874006120636f6d6d656e74004a4c4a1e454422c00084b8c4d02c010000"
}

test "vec gzip 3" {
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), -2, false), "1025 96ad24a9"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), -2, true), "1048 0a859ffb"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 0, false), "1025 96ad24a9"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 0, true), "1048 0a859ffb"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 1, false), "1025 f1f236b4"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 1, true), "1048 2a9614aa"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 2, false), "1025 96ad24a9"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 2, true), "1048 0a859ffb"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 3, false), "1025 96ad24a9"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 3, true), "1048 0a859ffb"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 4, false), "1025 96ad24a9"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 4, true), "1048 0a859ffb"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 5, false), "1025 96ad24a9"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 5, true), "1048 0a859ffb"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 6, false), "1025 96ad24a9"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 6, true), "1048 0a859ffb"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 7, false), "1025 96ad24a9"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 7, true), "1048 0a859ffb"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 8, false), "1025 96ad24a9"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 8, true), "1048 0a859ffb"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 9, false), "1025 48ba2e87"
  assert_eq vec_gzip(rand_bytes(1000, 2, 255), 9, true), "1048 f734d973"
}

test "vec gzip 4" {
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), -2, false), "35583 f5ac26c9"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), -2, true), "35606 5286cabb"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 0, false), "70030 671e9f02"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 0, true), "70053 bec007ae"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 1, false), "70030 89bd6842"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 1, true), "70053 f9705b9a"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 2, false), "70030 671e9f02"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 2, true), "70053 bec007ae"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 3, false), "37772 6b6a984d"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 3, true), "37795 26e6ad79"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 4, false), "37772 6b6a984d"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 4, true), "37795 26e6ad79"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 5, false), "37772 6b6a984d"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 5, true), "37795 26e6ad79"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 6, false), "38208 2260f5b3"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 6, true), "38231 ea4d952f"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 7, false), "38213 95f83fcf"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 7, true), "38236 899e8a28"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 8, false), "38205 d7b74fe9"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 8, true), "38228 98918a0e"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 9, false), "35813 2248e22c"
  assert_eq vec_gzip(rand_bytes(70000, 4, 15), 9, true), "35836 129480f3"
}

test "vec gzip 5" {
  assert_eq vec_gzip(read("testdata/e.txt"), -2, false), "43717 23e92a80"
  assert_eq vec_gzip(read("testdata/e.txt"), -2, true), "43740 5e5bd8fa"
  assert_eq vec_gzip(read("testdata/e.txt"), 0, false), "100033 e2a63ebc"
  assert_eq vec_gzip(read("testdata/e.txt"), 0, true), "100056 079fe6e0"
  assert_eq vec_gzip(read("testdata/e.txt"), 1, false), "44835 c3eca4e6"
  assert_eq vec_gzip(read("testdata/e.txt"), 1, true), "44858 56f343bf"
  assert_eq vec_gzip(read("testdata/e.txt"), 2, false), "44959 d7a512fd"
  assert_eq vec_gzip(read("testdata/e.txt"), 2, true), "44982 0aaf3704"
  assert_eq vec_gzip(read("testdata/e.txt"), 3, false), "45356 ac379a99"
  assert_eq vec_gzip(read("testdata/e.txt"), 3, true), "45379 afcff5d5"
  assert_eq vec_gzip(read("testdata/e.txt"), 4, false), "49196 9c80cac3"
  assert_eq vec_gzip(read("testdata/e.txt"), 4, true), "49219 70308143"
  assert_eq vec_gzip(read("testdata/e.txt"), 5, false), "49094 e9db249d"
  assert_eq vec_gzip(read("testdata/e.txt"), 5, true), "49117 480da99a"
  assert_eq vec_gzip(read("testdata/e.txt"), 6, false), "49158 a14191dc"
  assert_eq vec_gzip(read("testdata/e.txt"), 6, true), "49181 63fc739f"
  assert_eq vec_gzip(read("testdata/e.txt"), 7, false), "47837 bba6930b"
  assert_eq vec_gzip(read("testdata/e.txt"), 7, true), "47860 e55fb5d8"
  assert_eq vec_gzip(read("testdata/e.txt"), 8, false), "47829 bfcee1d2"
  assert_eq vec_gzip(read("testdata/e.txt"), 8, true), "47852 c502b283"
  assert_eq vec_gzip(read("testdata/e.txt"), 9, false), "44601 8b936dd2"
  assert_eq vec_gzip(read("testdata/e.txt"), 9, true), "44624 d6d8f40a"
}
