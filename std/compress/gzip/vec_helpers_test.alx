# Helpers of the generated vectors (vec_gzip_test.alx).
import "bytes"
import "encoding/hex"
import "fmt"
import "hash/crc32"
import "io"
import "os"
import "time"

def read(file: Str) -> [Byte] { os.read_file(file).unwrap }

# A deterministic byte generator.
def rand_bytes(n: Int, seed: U64, mask: Int) -> [Byte] {
  out: [Byte] = [0; n]
  x = seed
  i = 0
  while i < n {
    x = x *% 6364136223846793005 +% 1442695040888963407
    out[i] = ((x >> 33).to_i & mask).as_u8
    i += 1
  }
  out
}

# Gzips data at level (with a full header if hdr), checks the round trip,
# and returns the output's hex, or its size and CRC-32 when long.
def vec_gzip(data: [Byte], level: Int, hdr: Bool) -> Str {
  buf = bytes.new_buffer([])
  w = new_writer_level(buf, level).unwrap
  if hdr {
    w.header.name = "name.txt"
    w.header.comment = "a comment"
    w.header.extra = b("xy")
    w.header.mod_time = time.unix(1234567890, 0)
  }
  w.write!(data).unwrap
  w.close!.unwrap
  out = buf.bytes
  r = new_reader(slice_reader(out)).unwrap.unwrap
  assert io.read_all(r).unwrap == data, "round trip at level #{level}"
  if hdr {
    assert r.header.name == "name.txt" && r.header.comment == "a comment" && r.header.mod_time.unix == 1234567890, "header round trip"
  }
  return hex.encode_to_string(out) if out.size <= 96
  "#{out.size} #{fmt.sprintf("%08x", crc32.checksum_ieee(out))}"
}
