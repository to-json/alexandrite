# Generated from Go's compress/lzw (go1.27.1) by a throwaway program: the
# output for each input, order and literal width (hex, or size and CRC-32
# when long); vec_lzw also checks the round trip. Do not edit by hand.

test "vec lzw 0" {
  assert_eq vec_lzw(b(""), LSB, 2), "2c"
  assert_eq vec_lzw(b(""), LSB, 3), "98"
  assert_eq vec_lzw(b(""), LSB, 4), "3002"
  assert_eq vec_lzw(b(""), LSB, 5), "6008"
  assert_eq vec_lzw(b(""), LSB, 6), "c020"
  assert_eq vec_lzw(b(""), LSB, 7), "8081"
  assert_eq vec_lzw(b(""), LSB, 8), "000302"
  assert_eq vec_lzw(b(""), MSB, 2), "94"
  assert_eq vec_lzw(b(""), MSB, 3), "89"
  assert_eq vec_lzw(b(""), MSB, 4), "8440"
  assert_eq vec_lzw(b(""), MSB, 5), "8210"
  assert_eq vec_lzw(b(""), MSB, 6), "8104"
  assert_eq vec_lzw(b(""), MSB, 7), "8081"
  assert_eq vec_lzw(b(""), MSB, 8), "804040"
}

test "vec lzw 1" {
  assert_eq vec_lzw(h("00"), LSB, 2), "4401"
  assert_eq vec_lzw(h("00"), LSB, 3), "0809"
  assert_eq vec_lzw(h("00"), LSB, 4), "1044"
  assert_eq vec_lzw(h("00"), LSB, 5), "201002"
  assert_eq vec_lzw(h("00"), LSB, 6), "404010"
  assert_eq vec_lzw(h("00"), LSB, 7), "800081"
  assert_eq vec_lzw(h("00"), LSB, 8), "00010404"
  assert_eq vec_lzw(h("00"), MSB, 2), "8280"
  assert_eq vec_lzw(h("00"), MSB, 3), "8090"
  assert_eq vec_lzw(h("00"), MSB, 4), "8022"
  assert_eq vec_lzw(h("00"), MSB, 5), "800840"
  assert_eq vec_lzw(h("00"), MSB, 6), "800208"
  assert_eq vec_lzw(h("00"), MSB, 7), "800081"
  assert_eq vec_lzw(h("00"), MSB, 8), "80002020"
}

test "vec lzw 2" {
  assert_eq vec_lzw(h("0102030102030102"), LSB, 2), "8c662805"
  assert_eq vec_lzw(h("0102030102030102"), LSB, 3), "1832ca92"
  assert_eq vec_lzw(h("0102030102030102"), LSB, 4), "308821a988"
  assert_eq vec_lzw(h("0102030102030102"), LSB, 5), "60200c222984"
  assert_eq vec_lzw(h("0102030102030102"), LSB, 6), "c0806020240a82"
  assert_eq vec_lzw(h("0102030102030102"), LSB, 7), "8001020382840281"
  assert_eq vec_lzw(h("0102030102030102"), LSB, 8), "000308182090a08080"
  assert_eq vec_lzw(h("0102030102030102"), MSB, 2), "85368250"
  assert_eq vec_lzw(h("0102030102030102"), MSB, 3), "8123ac29"
  assert_eq vec_lzw(h("0102030102030102"), MSB, 4), "8044395051"
  assert_eq vec_lzw(h("0102030102030102"), MSB, 5), "8010838a40a1"
  assert_eq vec_lzw(h("0102030102030102"), MSB, 6), "80041038510141"
  assert_eq vec_lzw(h("0102030102030102"), MSB, 7), "8001020382840281"
  assert_eq vec_lzw(h("0102030102030102"), MSB, 8), "800040403814100501"
}

test "vec lzw 3" {
  assert_eq vec_lzw(rand_bytes(100, 1, 3), LSB, 2), "542032192a80d000613403295834253a3d0df82187b28cd510a6c7d4582bb3214f8a4d05"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), LSB, 3), "280122d3c109c0d800614445317858d360d7149123b338cf990d65bb5c91f6421f33b5dc9500"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), LSB, 4), "500420c4a8c10a40e900c190491c085c605581df96b12b3559d71b0e6d3d7d99786327caa646fa4400"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), LSB, 5), "a01000823094812900243900c1908a2c0c9c7059c2ef9af23bd2c874fac506bde2e895921d5137d2aa487b8500"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), LSB, 6), "40410020100c8a01a30040240e00814152c884028ed06211fa5c26b95be2d078fc4607ddf2f099949e9157e2b24c7d0601"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), LSB, 7), "80020100020203850186020084840300010389828c900087908585908f8b899c9b848386879f91039da5838f8992a78897848ba5948f81"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), LSB, 8), "000504002040c08082010c0a004090e0000001062414c810228083100b1684f87061428e1b090e3478f063c4011d4b0e7c9850e2498417092e2c49f16140"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), MSB, 2), "88822391a204206008da68500ba25344cf3607c81ca2e35438691d3356acc6c83e961314"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), MSB, 3), "8210223d0b8406306008e2aa600f60d3585d34648cc2ce3e764396d2d745abd07cc4ed717240"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), MSB, 4), "80820108750d840a50600436527200178155607db66cad44d65ef843b754df662dd84e50db5487c880"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), MSB, 5), "8020400820e50660809240c0043a62b30027c25970beba7c76911a64efd8837b151af52ca3a86e915c568bd080"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), MSB, 6), "800808004081c503181008910180020e4c29940047a1162d09f2e4dcb7121c68f7e883bb961cf934b3c8af125e5a93e080"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), MSB, 7), "80020100020203850186020084840300010389828c900087908585908f8b899c9b848386879f91039da5838f8992a78897848ba5948f81"
  assert_eq vec_lzw(rand_bytes(100, 1, 3), MSB, 8), "80008020001008070500c1804008241006000080e1302864400107884160b1087c2e131c8dc12070683c7e22038ec96070f84c4a4f088bc1217258a43e02"
}

test "vec lzw 4" {
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), LSB, 2), "1497 7a65b7d9"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), LSB, 3), "1501 ac2ec2ed"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), LSB, 4), "1508 3429cd66"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), LSB, 5), "1520 751cd428"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), LSB, 6), "1540 0b198c85"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), LSB, 7), "1572 3da8fd2d"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), LSB, 8), "1620 54b31d7b"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), MSB, 2), "1497 9ce3316b"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), MSB, 3), "1501 07051540"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), MSB, 4), "1508 76ed0f33"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), MSB, 5), "1520 5d80352c"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), MSB, 6), "1540 f9cc0c1d"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), MSB, 7), "1572 6691b291"
  assert_eq vec_lzw(rand_bytes(5000, 2, 3), MSB, 8), "1620 8f619023"
}

test "vec lzw 5" {
  assert_eq vec_lzw(rand_bytes(20000, 3, 63), LSB, 6), "20449 0915f075"
  assert_eq vec_lzw(rand_bytes(20000, 3, 63), LSB, 7), "20587 eb2948dc"
  assert_eq vec_lzw(rand_bytes(20000, 3, 63), LSB, 8), "20894 2b0db3c9"
  assert_eq vec_lzw(rand_bytes(20000, 3, 63), MSB, 6), "20449 8e85d36b"
  assert_eq vec_lzw(rand_bytes(20000, 3, 63), MSB, 7), "20587 849df2b4"
  assert_eq vec_lzw(rand_bytes(20000, 3, 63), MSB, 8), "20894 2952b2e7"
}

test "vec lzw 6" {
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), LSB, 3), "43961 4410878d"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), LSB, 4), "44049 2a2fb90d"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), LSB, 5), "44098 a414875c"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), LSB, 6), "44303 7342bcf3"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), LSB, 7), "44750 441c3d1d"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), LSB, 8), "45415 d4ea1f84"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), MSB, 3), "43961 71946e07"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), MSB, 4), "44049 ef8abc6b"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), MSB, 5), "44098 210b367f"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), MSB, 6), "44303 22d3a581"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), MSB, 7), "44750 d39af21a"
  assert_eq vec_lzw(rand_bytes(100000, 4, 7), MSB, 8), "45415 c129e1d2"
}

test "vec lzw 7" {
  assert_eq vec_lzw(zbytes(50000), LSB, 2), "298 ee12f1c1"
  assert_eq vec_lzw(zbytes(50000), LSB, 3), "301 8dbe6a5d"
  assert_eq vec_lzw(zbytes(50000), LSB, 4), "306 3dd4c2a4"
  assert_eq vec_lzw(zbytes(50000), LSB, 5), "314 a03bf431"
  assert_eq vec_lzw(zbytes(50000), LSB, 6), "326 2b918b49"
  assert_eq vec_lzw(zbytes(50000), LSB, 7), "342 77a18f9c"
  assert_eq vec_lzw(zbytes(50000), LSB, 8), "366 baf4f843"
  assert_eq vec_lzw(zbytes(50000), MSB, 2), "298 8e4c5659"
  assert_eq vec_lzw(zbytes(50000), MSB, 3), "301 a855bdd3"
  assert_eq vec_lzw(zbytes(50000), MSB, 4), "306 6878702b"
  assert_eq vec_lzw(zbytes(50000), MSB, 5), "314 2ae83665"
  assert_eq vec_lzw(zbytes(50000), MSB, 6), "326 27212b2f"
  assert_eq vec_lzw(zbytes(50000), MSB, 7), "342 edf79b21"
  assert_eq vec_lzw(zbytes(50000), MSB, 8), "366 50c36084"
}

test "vec lzw 8" {
  assert_eq vec_lzw(rand_bytes(30000, 5, 255), LSB, 8), "40984 f634ac59"
  assert_eq vec_lzw(rand_bytes(30000, 5, 255), MSB, 8), "40984 25ded951"
}

test "vec lzw 9" {
  assert_eq vec_lzw(read("testdata/e.txt"), LSB, 6), "49361 b7880ce7"
  assert_eq vec_lzw(read("testdata/e.txt"), LSB, 7), "49732 aa0fc75c"
  assert_eq vec_lzw(read("testdata/e.txt"), LSB, 8), "50608 d09858a8"
  assert_eq vec_lzw(read("testdata/e.txt"), MSB, 6), "49361 354cdbbc"
  assert_eq vec_lzw(read("testdata/e.txt"), MSB, 7), "49732 b44518b2"
  assert_eq vec_lzw(read("testdata/e.txt"), MSB, 8), "50608 7e9078e1"
}
