# Helpers of the generated vectors (vec_zlib_test.alx).
import "bytes"
import "encoding/hex"
import "fmt"
import "hash/crc32"
import "io"
import "os"

def read(file: Str) -> [Byte] { os.read_file(file).unwrap }

# A deterministic byte generator.
def rand_bytes(n: Int, seed: U64, mask: Int) -> [Byte] {
  out: [Byte] = [0; n]
  x = seed
  i = 0
  while i < n {
    x = x *% 6364136223846793005 +% 1442695040888963407
    out[i] = ((x >> 33).to_i & mask).as_u8
    i += 1
  }
  out
}

# Compresses data at level with dict, checks the round trip, and returns
# the output's hex, or its size and CRC-32 when long.
def vec_zlib(data: [Byte], level: Int, dict: Str) -> Str {
  buf = bytes.new_buffer([])
  w = new_writer_level_dict(buf, level, b(dict)).unwrap
  w.write!(data).unwrap
  w.close!.unwrap
  out = buf.bytes
  r = new_reader_dict(slice_reader(out), b(dict)).unwrap
  assert io.read_all(r).unwrap == data, "round trip at level #{level}"
  return hex.encode_to_string(out) if out.size <= 96
  "#{out.size} #{fmt.sprintf("%08x", crc32.checksum_ieee(out))}"
}
