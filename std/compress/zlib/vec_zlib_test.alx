# Generated from Go's compress/zlib (go1.27.1) by a throwaway program: the
# output for each input at each level (hex, or size and CRC-32 when long);
# the helper also checks the round trip. Do not edit by hand.

test "vec zlib 0" {
  assert_eq vec_zlib(b(""), -2, ""), "7801030000000001"
  assert_eq vec_zlib(b(""), -2, "hello, world 0123456789 abc"), "783f792e07fc030000000001"
  assert_eq vec_zlib(b(""), 0, ""), "7801030000000001"
  assert_eq vec_zlib(b(""), 0, "hello, world 0123456789 abc"), "783f792e07fc030000000001"
  assert_eq vec_zlib(b(""), 1, ""), "7801030000000001"
  assert_eq vec_zlib(b(""), 1, "hello, world 0123456789 abc"), "783f792e07fc030000000001"
  assert_eq vec_zlib(b(""), 2, ""), "785e030000000001"
  assert_eq vec_zlib(b(""), 2, "hello, world 0123456789 abc"), "787d792e07fc030000000001"
  assert_eq vec_zlib(b(""), 3, ""), "785e030000000001"
  assert_eq vec_zlib(b(""), 3, "hello, world 0123456789 abc"), "787d792e07fc030000000001"
  assert_eq vec_zlib(b(""), 4, ""), "785e030000000001"
  assert_eq vec_zlib(b(""), 4, "hello, world 0123456789 abc"), "787d792e07fc030000000001"
  assert_eq vec_zlib(b(""), 5, ""), "785e030000000001"
  assert_eq vec_zlib(b(""), 5, "hello, world 0123456789 abc"), "787d792e07fc030000000001"
  assert_eq vec_zlib(b(""), 6, ""), "789c030000000001"
  assert_eq vec_zlib(b(""), 6, "hello, world 0123456789 abc"), "78bb792e07fc030000000001"
  assert_eq vec_zlib(b(""), 7, ""), "78da030000000001"
  assert_eq vec_zlib(b(""), 7, "hello, world 0123456789 abc"), "78f9792e07fc030000000001"
  assert_eq vec_zlib(b(""), 8, ""), "78da030000000001"
  assert_eq vec_zlib(b(""), 8, "hello, world 0123456789 abc"), "78f9792e07fc030000000001"
  assert_eq vec_zlib(b(""), 9, ""), "78da030000000001"
  assert_eq vec_zlib(b(""), 9, "hello, world 0123456789 abc"), "78f9792e07fc030000000001"
}

test "vec zlib 1" {
  assert_eq vec_zlib(b("hello, world\n"), -2, ""), "7801000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), -2, "hello, world 0123456789 abc"), "783f792e07fc000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 0, ""), "7801000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 0, "hello, world 0123456789 abc"), "783f792e07fc000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 1, ""), "7801000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 1, "hello, world 0123456789 abc"), "783f792e07fc000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 2, ""), "785e000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 2, "hello, world 0123456789 abc"), "787d792e07fc000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 3, ""), "785e000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 3, "hello, world 0123456789 abc"), "787d792e07fc000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 4, ""), "785e000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 4, "hello, world 0123456789 abc"), "787d792e07fc000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 5, ""), "785e000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 5, "hello, world 0123456789 abc"), "787d792e07fc000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 6, ""), "789c000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 6, "hello, world 0123456789 abc"), "78bb792e07fc000d00f2ff68656c6c6f2c20776f726c640a030021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 7, ""), "78daca48cdc9c9d75128cf2fca49e1020c0021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 7, "hello, world 0123456789 abc"), "78f9792e07fc4296e2020c0021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 8, ""), "78daca48cdc9c9d75128cf2fca49e1020c0021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 8, "hello, world 0123456789 abc"), "78f9792e07fc4296e2020c0021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 9, ""), "78daca48cdc9c9d75128cf2fca49e1020c0021e70493"
  assert_eq vec_zlib(b("hello, world\n"), 9, "hello, world 0123456789 abc"), "78f9792e07fc4296e2020c0021e70493"
}

test "vec zlib 2" {
  assert_eq vec_zlib(b("abc" * 100), -2, ""), "780104c0010100000040a0adf8ff411886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886611886610f00884d72d9"
  assert_eq vec_zlib(b("abc" * 100), -2, "hello, world 0123456789 abc"), "100 30416b65"
  assert_eq vec_zlib(b("abc" * 100), 0, ""), "313 470f6237"
  assert_eq vec_zlib(b("abc" * 100), 0, "hello, world 0123456789 abc"), "317 1076bf21"
  assert_eq vec_zlib(b("abc" * 100), 1, ""), "78014a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 1, "hello, world 0123456789 abc"), "783f792e07fc1a45c423c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 2, ""), "785e4a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 2, "hello, world 0123456789 abc"), "787d792e07fc1a45c423c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 3, ""), "785e4a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 3, "hello, world 0123456789 abc"), "787d792e07fc1a45c423c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 4, ""), "785e4a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 4, "hello, world 0123456789 abc"), "787d792e07fc1a45c423c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 5, ""), "785e4a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 5, "hello, world 0123456789 abc"), "787d792e07fc1a45c423c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 6, ""), "789c4a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 6, "hello, world 0123456789 abc"), "78bb792e07fc1a45c423c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 7, ""), "78da4a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 7, "hello, world 0123456789 abc"), "78f9792e07fc4a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 8, ""), "78da4a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 8, "hello, world 0123456789 abc"), "78f9792e07fc4a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 9, ""), "78da4a4c4a1e454422c000884d72d9"
  assert_eq vec_zlib(b("abc" * 100), 9, "hello, world 0123456789 abc"), "78f9792e07fc4a4c4a1e454422c000884d72d9"
}

test "vec zlib 3" {
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), -2, ""), "1013 032a1c11"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), -2, "hello, world 0123456789 abc"), "1017 39ea3669"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 0, ""), "1013 032a1c11"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 0, "hello, world 0123456789 abc"), "1017 39ea3669"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 1, ""), "1013 032a1c11"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 1, "hello, world 0123456789 abc"), "1017 39ea3669"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 2, ""), "1013 d757d3b3"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 2, "hello, world 0123456789 abc"), "1017 ddcee979"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 3, ""), "1013 d757d3b3"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 3, "hello, world 0123456789 abc"), "1017 ddcee979"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 4, ""), "1013 d757d3b3"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 4, "hello, world 0123456789 abc"), "1017 ddcee979"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 5, ""), "1013 d757d3b3"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 5, "hello, world 0123456789 abc"), "1017 ddcee979"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 6, ""), "1013 0d182ddd"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 6, "hello, world 0123456789 abc"), "1017 2ad28e08"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 7, ""), "1013 f6697c4f"
  # Go's output (1044 ed48781e) is corrupt: Go 1.27's level 7-9 compressor
  # puts the dictionary in a stored first block (see flate's header).
  assert vec_zlib(rand_bytes(1000, 2, 255), 7, "hello, world 0123456789 abc") != "", "round trip"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 8, ""), "1013 f6697c4f"
  # Go's output (1044 ed48781e) is corrupt: Go 1.27's level 7-9 compressor
  # puts the dictionary in a stored first block (see flate's header).
  assert vec_zlib(rand_bytes(1000, 2, 255), 8, "hello, world 0123456789 abc") != "", "round trip"
  assert_eq vec_zlib(rand_bytes(1000, 2, 255), 9, ""), "1013 f6697c4f"
  # Go's output (1044 ed48781e) is corrupt: Go 1.27's level 7-9 compressor
  # puts the dictionary in a stored first block (see flate's header).
  assert vec_zlib(rand_bytes(1000, 2, 255), 9, "hello, world 0123456789 abc") != "", "round trip"
}

test "vec zlib 4" {
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), -2, ""), "35571 7de2d3f5"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), -2, "hello, world 0123456789 abc"), "35575 d39260fa"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 0, ""), "70018 1e5bfaa9"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 0, "hello, world 0123456789 abc"), "70022 0c2fd621"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 1, ""), "70018 1e5bfaa9"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 1, "hello, world 0123456789 abc"), "70022 0c2fd621"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 2, ""), "70018 98361be6"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 2, "hello, world 0123456789 abc"), "70022 832c078e"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 3, ""), "37760 8266991c"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 3, "hello, world 0123456789 abc"), "37764 3ec285f5"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 4, ""), "37760 8266991c"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 4, "hello, world 0123456789 abc"), "37764 3ec285f5"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 5, ""), "37760 8266991c"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 5, "hello, world 0123456789 abc"), "37764 3ec285f5"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 6, ""), "38196 7bf2bb58"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 6, "hello, world 0123456789 abc"), "38200 ef50ae2e"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 7, ""), "38201 0de6d20d"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 7, "hello, world 0123456789 abc"), "38205 f8f27503"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 8, ""), "38193 541cbf51"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 8, "hello, world 0123456789 abc"), "38197 52be643d"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 9, ""), "35801 04d44aa0"
  assert_eq vec_zlib(rand_bytes(70000, 4, 15), 9, "hello, world 0123456789 abc"), "35805 e2903535"
}

test "vec zlib 5" {
  assert_eq vec_zlib(read("testdata/e.txt"), -2, ""), "43705 ee001900"
  assert_eq vec_zlib(read("testdata/e.txt"), -2, "hello, world 0123456789 abc"), "43709 6162839d"
  assert_eq vec_zlib(read("testdata/e.txt"), 0, ""), "100021 c0ad850c"
  assert_eq vec_zlib(read("testdata/e.txt"), 0, "hello, world 0123456789 abc"), "100025 462aa09a"
  assert_eq vec_zlib(read("testdata/e.txt"), 1, ""), "44823 df85ceb5"
  assert_eq vec_zlib(read("testdata/e.txt"), 1, "hello, world 0123456789 abc"), "44827 0fbc3c2b"
  assert_eq vec_zlib(read("testdata/e.txt"), 2, ""), "44947 10c08f71"
  assert_eq vec_zlib(read("testdata/e.txt"), 2, "hello, world 0123456789 abc"), "44951 b83ed34c"
  assert_eq vec_zlib(read("testdata/e.txt"), 3, ""), "45344 cd080009"
  assert_eq vec_zlib(read("testdata/e.txt"), 3, "hello, world 0123456789 abc"), "45348 31276949"
  assert_eq vec_zlib(read("testdata/e.txt"), 4, ""), "49184 34e045d7"
  assert_eq vec_zlib(read("testdata/e.txt"), 4, "hello, world 0123456789 abc"), "49198 b7990ef2"
  assert_eq vec_zlib(read("testdata/e.txt"), 5, ""), "49082 e1a9506f"
  assert_eq vec_zlib(read("testdata/e.txt"), 5, "hello, world 0123456789 abc"), "49093 5aa58868"
  assert_eq vec_zlib(read("testdata/e.txt"), 6, ""), "49146 4abccd98"
  assert_eq vec_zlib(read("testdata/e.txt"), 6, "hello, world 0123456789 abc"), "49145 b0d1a027"
  assert_eq vec_zlib(read("testdata/e.txt"), 7, ""), "47825 fea49746"
  assert_eq vec_zlib(read("testdata/e.txt"), 7, "hello, world 0123456789 abc"), "47826 2820ab1d"
  assert_eq vec_zlib(read("testdata/e.txt"), 8, ""), "47817 ff78cd51"
  assert_eq vec_zlib(read("testdata/e.txt"), 8, "hello, world 0123456789 abc"), "47818 b5a58b92"
  assert_eq vec_zlib(read("testdata/e.txt"), 9, ""), "44589 3519f8e2"
  assert_eq vec_zlib(read("testdata/e.txt"), 9, "hello, world 0123456789 abc"), "44600 15670105"
}
