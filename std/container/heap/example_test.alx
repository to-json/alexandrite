# Go's example_intheap_test.go and example_pq_test.go, translated.

# An IntHeap is a min-heap of ints. Its slice lives in shared storage
# (`st[0]`), so push!/pop! through a copy change the caller's heap, as Go's
# pointer receivers do.
struct IntHeap {
  st: [[Int]]

  def len -> Int { st[0].size }
  def less(i: Int, j: Int) -> Bool { st[0][i] < st[0][j] }

  def swap!(i: Int, j: Int) {
    s = st[0]
    s[i], s[j] = s[j], s[i]
  }

  def push!(x: Int) { self.st[0] << x }

  def pop! -> Int {
    old = st[0]
    n = old.size
    x = old[n - 1]
    self.st[0] = old[0...n - 1]
    x
  }
}

# This example inserts several ints into an IntHeap, checks the minimum,
# and removes them in order of priority.
example "int heap" {
  h = IntHeap.new(st: [[2, 1, 5]])
  init(h)
  push(h, 3)
  puts format("minimum: %d", h.st[0][0])
  out = ""
  while h.len > 0 {
    out += format("%d ", pop(h))
  }
  puts out
} outputs "minimum: 1\n1 2 3 5 "

# An Item is something we manage in a priority queue. Items live in a Pool,
# and the queue holds their handles: Go's *Item.
struct Item {
  value: Str    # The value of the item; arbitrary.
  priority: Int # The priority of the item in the queue.
  # The index is needed by update and is maintained by the heap.Interface
  # methods.
  index: Int # The index of the item in the heap.
}

# A PriorityQueue implements heap.Interface and holds Items.
struct PriorityQueue {
  items: Pool[Item]
  st: [[@Item]]

  def len -> Int { st[0].size }

  def less(i: Int, j: Int) -> Bool {
    # We want pop to give us the highest, not lowest, priority so we use
    # greater than here.
    items[st[0][i]].priority > items[st[0][j]].priority
  }

  def swap!(i: Int, j: Int) {
    q = st[0]
    q[i], q[j] = q[j], q[i]
    set_index(q[i], i)
    set_index(q[j], j)
  }

  def set_index(h: @Item, i: Int) {
    ps = items
    it = ps[h]
    ps[h] = Item.new(value: it.value, priority: it.priority, index: i)
  }

  def push!(h: @Item) {
    set_index(h, st[0].size)
    self.st[0] << h
  }

  def pop! -> @Item {
    old = st[0]
    n = old.size
    h = old[n - 1]
    set_index(h, -1) # for safety
    self.st[0] = old[0...n - 1]
    h
  }

  # Modifies the priority and value of an Item in the queue.
  def update!(h: @Item, value: Str, priority: Int) {
    ps = items
    i = ps[h].index
    ps[h] = Item.new(value: value, priority: priority, index: i)
    fix(self, i)
  }
}

# This example creates a PriorityQueue with some items, adds and
# manipulates an item, and then removes the items in priority order.
example "priority queue" {
  # Some items and their priorities.
  items = {"banana" => 3, "apple" => 2, "pear" => 4}

  # Create a priority queue, put the items in it, and establish the
  # priority queue (heap) invariants.
  pq = PriorityQueue.new(st: [[]])
  i = 0
  for value, priority in items {
    pq.st[0] << pq.items.add(Item.new(value: value, priority: priority, index: i))
    i += 1
  }
  init(pq)

  # Insert a new item and then modify its priority.
  item = pq.items.add(Item.new(value: "orange", priority: 1))
  push(pq, item)
  pq.update!(item, pq.items[item].value, 5)

  # Take the items out; they arrive in decreasing priority order.
  out = ""
  while pq.len > 0 {
    it = pq.items[pop(pq)]
    # Go writes %.2d; alx's format has no integer precision yet, and %02d
    # prints the same for these non-negative priorities.
    out += format("%02d:%s ", it.priority, it.value)
  }
  puts out
} outputs "05:orange 04:pear 03:banana 02:apple "
