# Package heap: Go's container/heap, heap operations over any type that
# implements `heap.Interface` (S2). A heap is a tree with the property that
# each node is the minimum-valued node in its subtree; the minimum is at
# index 0. A common use is a priority queue (see example_pq_test.alx).
#
#   Go                              alx
#   heap.Interface                  Interface (len, less, swap!) plus push!/pop!
#   heap.Init(h)                    init(h)
#   heap.Push(h, x)                 push(h, x)
#   heap.Pop(h) any                 pop(h) -> T (what h.pop! returns)
#   heap.Remove(h, i) any           remove(h, i) -> T
#   heap.Fix(h, i)                  fix(h, i)
#
# The type is your own: a struct with
#
#   def len -> Int
#   def less(i: Int, j: Int) -> Bool
#   def swap!(i: Int, j: Int)
#   def push!(x: T)          # add x as element len
#   def pop! -> T            # remove and return element len - 1
#
# Interfaces are structural, so declaring the methods is all it takes.
#
# Differences from Go:
#   - Go's Push(x any) / Pop() any are typed here: push!/pop! take and return
#     your element type T. alx interfaces can't be generic, so `Interface`
#     declares only len/less/swap! (Go's sort.Interface part); push! and pop!
#     are checked when push/pop/remove is instantiated for your type, and
#     `pop`/`remove` return what your pop! returns (no type assertion).
#   - The functions receive a copy of h (structs are values), like the
#     `io` functions: keep the heap's storage in a slice field that copies
#     share (GO-VS-RUBY D36), e.g. `struct IntHeap { st: [[Int]] }` with
#     `def push!(x: Int) { self.st[0] << x }`. A heap whose slice field is
#     the elements themselves (`items: [Int]`) works for init/fix (swap! writes
#     through the shared storage) but not for push/pop, which change its length.
#
# The complexity is Go's: init is O(n), push/pop/remove/fix O(log n), with
# n = h.len.

# The ordering half of a heap: Go's sort.Interface. A heap type also has
# `push!(x: T)` and `pop! -> T` (see the header).
pub interface Interface {
  def len -> Int
  def less(i: Int, j: Int) -> Bool
  def swap!(i: Int, j: Int)
}

# Establishes the heap invariants. It may be called whenever the invariants
# may have been invalidated. O(n).
pub def init[H: Interface](h: H) {
  # heapify
  n = h.len
  i = n / 2 - 1
  while i >= 0 {
    down(h, i, n)
    i -= 1
  }
}

# Pushes x onto the heap. O(log n).
pub def push[H: Interface, T](h: H, x: T) {
  h.push!(x)
  up(h, h.len - 1)
}

# Removes and returns the minimum element (according to less) from the heap.
# O(log n). Equivalent to remove(h, 0).
pub def pop[H: Interface](h: H) {
  n = h.len - 1
  h.swap!(0, n)
  down(h, 0, n)
  h.pop!
}

# Removes and returns the element at index i from the heap. O(log n).
pub def remove[H: Interface](h: H, i: Int) {
  n = h.len - 1
  if n != i {
    h.swap!(i, n)
    if !down(h, i, n) {
      up(h, i)
    }
  }
  h.pop!
}

# Re-establishes the heap ordering after the element at index i has changed
# its value. Changing the value of the element at index i and then calling
# fix is equivalent to, but less expensive than, calling remove(h, i)
# followed by a push of the new value. O(log n).
pub def fix[H: Interface](h: H, i: Int) {
  if !down(h, i, h.len) {
    up(h, i)
  }
}

def up[H: Interface](h: H, j0: Int) {
  j = j0
  loop {
    i = (j - 1) / 2 # parent
    break if i == j || !h.less(j, i)
    h.swap!(i, j)
    j = i
  }
}

def down[H: Interface](h: H, i0: Int, n: Int) -> Bool {
  i = i0
  loop {
    j1 = 2 * i + 1
    break if j1 >= n || j1 < 0 # j1 < 0 after int overflow
    j = j1                     # left child
    j2 = j1 + 1
    if j2 < n && h.less(j2, j1) {
      j = j2 # = 2*i + 2  # right child
    }
    break if !h.less(j, i)
    h.swap!(i, j)
    i = j
  }
  i > i0
}
