# Go's heap_test.go, translated. Go's `myHeap []int` with pointer receivers
# becomes a struct whose slice lives in shared storage (D36), so the copies
# the heap functions receive are the same heap.

struct MyHeap {
  st: [[Int]]

  def less(i: Int, j: Int) -> Bool { st[0][i] < st[0][j] }

  def swap!(i: Int, j: Int) {
    s = st[0]
    s[i], s[j] = s[j], s[i]
  }

  def len -> Int { st[0].size }

  def pop! -> Int {
    s = st[0]
    v = s[s.size - 1]
    self.st[0] = s[0...s.size - 1]
    v
  }

  def push!(v: Int) { self.st[0] << v }

  def [](i: Int) -> Int { st[0][i] }

  def set!(i: Int, v: Int) { self.st[0][i] = v }

  def verify(i: Int) -> Unit {
    n = len
    j1 = 2 * i + 1
    j2 = 2 * i + 2
    if j1 < n {
      assert !less(j1, i), "heap invariant invalidated [#{i}] = #{st[0][i]} > [#{j1}] = #{st[0][j1]}"
      verify(j1)
    }
    if j2 < n {
      assert !less(j2, i), "heap invariant invalidated [#{i}] = #{st[0][i]} > [#{j2}] = #{st[0][j2]}"
      verify(j2)
    }
  }
}

def new_heap -> MyHeap {
  MyHeap.new(st: [[]])
}

test "init0" {
  h = new_heap
  for _ in 0...20 {
    h.push!(0) # all elements are the same
  }
  init(h)
  h.verify(0)
  i = 1
  while h.len > 0 {
    x = pop(h)
    h.verify(0)
    assert x == 0, "#{i}.th pop got #{x}; want 0"
    i += 1
  }
}

test "init1" {
  h = new_heap
  i = 20
  while i > 0 {
    h.push!(i) # all elements are different
    i -= 1
  }
  init(h)
  h.verify(0)
  i = 1
  while h.len > 0 {
    x = pop(h)
    h.verify(0)
    assert x == i, "#{i}.th pop got #{x}; want #{i}"
    i += 1
  }
}

test "push pop" {
  h = new_heap
  h.verify(0)
  i = 20
  while i > 10 {
    h.push!(i)
    i -= 1
  }
  init(h)
  h.verify(0)
  i = 10
  while i > 0 {
    push(h, i)
    h.verify(0)
    i -= 1
  }
  i = 1
  while h.len > 0 {
    x = pop(h)
    push(h, 20 + i) if i < 20
    h.verify(0)
    assert x == i, "#{i}.th pop got #{x}; want #{i}"
    i += 1
  }
}

test "remove0" {
  h = new_heap
  for i in 0...10 {
    h.push!(i)
  }
  h.verify(0)
  while h.len > 0 {
    i = h.len - 1
    x = remove(h, i)
    assert x == i, "remove(#{i}) got #{x}; want #{i}"
    h.verify(0)
  }
}

test "remove1" {
  h = new_heap
  for i in 0...10 {
    h.push!(i)
  }
  h.verify(0)
  i = 0
  while h.len > 0 {
    x = remove(h, 0)
    assert x == i, "remove(0) got #{x}; want #{i}"
    h.verify(0)
    i += 1
  }
}

test "remove2" {
  n = 10
  h = new_heap
  for i in 0...n {
    h.push!(i)
  }
  h.verify(0)
  m: Map[Int, Bool] = {}
  while h.len > 0 {
    m[remove(h, (h.len - 1) / 2)] = true
    h.verify(0)
  }
  assert_eq m.size, n
  for i in 0...m.size {
    assert m[i] || false, "m[#{i}] doesn't exist"
  }
}

test "fix" {
  h = new_heap
  h.verify(0)
  i = 200
  while i > 0 {
    push(h, i)
    i -= 10
  }
  h.verify(0)
  assert_eq h[0], 10
  h.set!(0, 210)
  fix(h, 0)
  h.verify(0)
  # Go uses rand.Intn; a fixed LCG keeps the run reproducible.
  seed = 12345
  i = 100
  while i > 0 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    elem = seed % h.len
    if i & 1 == 0 {
      h.set!(elem, h[elem] * 2)
    } else {
      h.set!(elem, h[elem] / 2)
    }
    fix(h, elem)
    h.verify(0)
    i -= 1
  }
}

test "pop order matches sort" {
  # Heap sort: popping everything gives the elements in order.
  h = new_heap
  seed = 7
  want: [Int] = []
  for _ in 0...500 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    v = seed % 1000
    want << v
    push(h, v)
  }
  h.verify(0)
  want = want.sort
  got: [Int] = []
  while h.len > 0 {
    got << pop(h)
  }
  assert got == want
}

bench "dup" {
  n = 10000
  h = new_heap
  for _ in 0...n {
    push(h, 0) # all elements are the same
  }
  while h.len > 0 {
    pop(h)
  }
}
