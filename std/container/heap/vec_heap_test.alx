  assert_eq h.st[0], [19, 38, 69, 76]
  assert_eq pop(h), 19
  assert_eq h.st[0], [38, 76, 69]
  assert_eq pop(h), 38
  assert_eq h.st[0], [69, 76]
  push(h, 31)
  assert_eq h.st[0], [31, 76, 69]
  h.set!(0, 60)
  fix(h, 0)
  assert_eq h.st[0], [60, 76, 69]
