  assert_eq h.st[0], [10, 60, 69, 76]
  assert_eq remove(h, 0), 10
  assert_eq h.st[0], [60, 76, 69]
  h.set!(2, 67)
  fix(h, 2)
  assert_eq h.st[0], [60, 76, 67]
}

test "vectors: sequence 3" {
  h = vh([41, 16, 1, 21, 42, 33, 16])
  init(h)
  assert_eq h.st[0], [1, 16, 16, 21, 42, 33, 41]
  push(h, 62)
  assert_eq h.st[0], [1, 16, 16, 21, 42, 33, 41, 62]
  push(h, 19)
  assert_eq h.st[0], [1, 16, 16, 19, 42, 33, 41, 62, 21]
  assert_eq pop(h), 1
  assert_eq h.st[0], [16, 19, 16, 21, 42, 33, 41, 62]
  h.set!(3, 41)
  fix(h, 3)
  assert_eq h.st[0], [16, 19, 16, 41, 42, 33, 41, 62]
  h.set!(6, 38)
  fix(h, 6)
  assert_eq h.st[0], [16, 19, 16, 41, 42, 33, 38, 62]
  assert_eq remove(h, 0), 16
  assert_eq h.st[0], [16, 19, 33, 41, 42, 62, 38]
  h.set!(2, 6)
  fix(h, 2)
  assert_eq h.st[0], [6, 19, 16, 41, 42, 62, 38]
  h.set!(3, 28)
  fix(h, 3)
  assert_eq h.st[0], [6, 19, 16, 28, 42, 62, 38]
  push(h, 24)
  assert_eq h.st[0], [6, 19, 16, 24, 42, 62, 38, 28]
  assert_eq remove(h, 2), 16
  assert_eq h.st[0], [6, 19, 28, 24, 42, 62, 38]
  assert_eq pop(h), 6
  assert_eq h.st[0], [19, 24, 28, 38, 42, 62]
  push(h, 66)
  assert_eq h.st[0], [19, 24, 28, 38, 42, 62, 66]
  push(h, 17)
  assert_eq h.st[0], [17, 19, 28, 24, 42, 62, 66, 38]
  push(h, 62)
  assert_eq h.st[0], [17, 19, 28, 24, 42, 62, 66, 38, 62]
  assert_eq remove(h, 3), 24
  assert_eq h.st[0], [17, 19, 28, 38, 42, 62, 66, 62]
  h.set!(1, 11)
  fix(h, 1)
  assert_eq h.st[0], [11, 17, 28, 38, 42, 62, 66, 62]
  push(h, -14)
  assert_eq h.st[0], [-14, 11, 28, 17, 42, 62, 66, 62, 38]
  push(h, -20)
  assert_eq h.st[0], [-20, -14, 28, 17, 11, 62, 66, 62, 38, 42]
  assert_eq pop(h), -20
  assert_eq h.st[0], [-14, 11, 28, 17, 42, 62, 66, 62, 38]
  h.set!(0, 33)
  fix(h, 0)
  assert_eq h.st[0], [11, 17, 28, 33, 42, 62, 66, 62, 38]
  assert_eq pop(h), 11
  assert_eq h.st[0], [17, 33, 28, 38, 42, 62, 66, 62]
  h.set!(2, 67)
  fix(h, 2)
  assert_eq h.st[0], [17, 33, 62, 38, 42, 67, 66, 62]
  push(h, 12)
  assert_eq h.st[0], [12, 17, 62, 33, 42, 67, 66, 62, 38]
  push(h, 76)
  assert_eq h.st[0], [12, 17, 62, 33, 42, 67, 66, 62, 38, 76]
  push(h, -11)
  assert_eq h.st[0], [-11, 12, 62, 33, 17, 67, 66, 62, 38, 76, 42]
  assert_eq remove(h, 3), 33
  assert_eq h.st[0], [-11, 12, 62, 38, 17, 67, 66, 62, 42, 76]
  assert_eq remove(h, 0), -11
  assert_eq h.st[0], [12, 17, 62, 38, 76, 67, 66, 62, 42]
  push(h, 64)
  assert_eq h.st[0], [12, 17, 62, 38, 64, 67, 66, 62, 42, 76]
  push(h, 45)
  assert_eq h.st[0], [12, 17, 62, 38, 45, 67, 66, 62, 42, 76, 64]
  push(h, 26)
  assert_eq h.st[0], [12, 17, 26, 38, 45, 62, 66, 62, 42, 76, 64, 67]
  assert_eq remove(h, 3), 38
  assert_eq h.st[0], [12, 17, 26, 42, 45, 62, 66, 62, 67, 76, 64]
  assert_eq pop(h), 12
  assert_eq h.st[0], [17, 42, 26, 62, 45, 62, 66, 64, 67, 76]
  assert_eq remove(h, 4), 45
  assert_eq h.st[0], [17, 42, 26, 62, 76, 62, 66, 64, 67]
  assert_eq remove(h, 8), 67
  assert_eq h.st[0], [17, 42, 26, 62, 76, 62, 66, 64]
  push(h, 56)
  assert_eq h.st[0], [17, 42, 26, 56, 76, 62, 66, 64, 62]
  push(h, 52)
  assert_eq h.st[0], [17, 42, 26, 56, 52, 62, 66, 64, 62, 76]
  assert_eq pop(h), 17
  assert_eq h.st[0], [26, 42, 62, 56, 52, 76, 66, 64, 62]
  assert_eq remove(h, 6), 66
  assert_eq h.st[0], [26, 42, 62, 56, 52, 76, 62, 64]
  assert_eq pop(h), 26
  assert_eq h.st[0], [42, 52, 62, 56, 64, 76, 62]
  assert_eq pop(h), 42
  assert_eq h.st[0], [52, 56, 62, 62, 64, 76]
  h.set!(5, 79)
  fix(h, 5)
  assert_eq h.st[0], [52, 56, 62, 62, 64, 79]
  assert_eq remove(h, 5), 79
  assert_eq h.st[0], [52, 56, 62, 62, 64]
  h.set!(2, 18)
  fix(h, 2)
  assert_eq h.st[0], [18, 56, 52, 62, 64]
  assert_eq pop(h), 18
  assert_eq h.st[0], [52, 56, 64, 62]
  push(h, -1)
  assert_eq h.st[0], [-1, 52, 64, 62, 56]
  assert_eq pop(h), -1
  assert_eq h.st[0], [52, 56, 64, 62]
  assert_eq remove(h, 3), 62
  assert_eq h.st[0], [52, 56, 64]
  h.set!(2, 74)
  fix(h, 2)
  assert_eq h.st[0], [52, 56, 74]
  assert_eq remove(h, 2), 74
  assert_eq h.st[0], [52, 56]
  h.set!(1, 37)
  fix(h, 1)
  assert_eq h.st[0], [37, 52]
  push(h, -10)
