test "vectors: sequence 2" {
  h = vh([40, 39, 28, 42, 45])
  init(h)
  assert_eq h.st[0], [28, 39, 40, 42, 45]
  push(h, 25)
  assert_eq h.st[0], [25, 39, 28, 42, 45, 40]
  assert_eq pop(h), 25
  assert_eq h.st[0], [28, 39, 40, 42, 45]
  push(h, -3)
  assert_eq h.st[0], [-3, 39, 28, 42, 45, 40]
  assert_eq remove(h, 2), 28
  assert_eq h.st[0], [-3, 39, 40, 42, 45]
  assert_eq pop(h), -3
  assert_eq h.st[0], [39, 42, 40, 45]
  push(h, -12)
  assert_eq h.st[0], [-12, 39, 40, 45, 42]
  push(h, 20)
  assert_eq h.st[0], [-12, 39, 20, 45, 42, 40]
  assert_eq pop(h), -12
  assert_eq h.st[0], [20, 39, 40, 45, 42]
  push(h, 76)
  assert_eq h.st[0], [20, 39, 40, 45, 42, 76]
  push(h, 31)
  assert_eq h.st[0], [20, 39, 31, 45, 42, 76, 40]
  assert_eq remove(h, 2), 31
  assert_eq h.st[0], [20, 39, 40, 45, 42, 76]
  push(h, 42)
  assert_eq h.st[0], [20, 39, 40, 45, 42, 76, 42]
  assert_eq remove(h, 6), 42
  assert_eq h.st[0], [20, 39, 40, 45, 42, 76]
  push(h, 9)
  assert_eq h.st[0], [9, 39, 20, 45, 42, 76, 40]
  h.set!(3, -9)
  fix(h, 3)
  assert_eq h.st[0], [-9, 9, 20, 39, 42, 76, 40]
  h.set!(3, -4)
  fix(h, 3)
  assert_eq h.st[0], [-9, -4, 20, 9, 42, 76, 40]
  assert_eq remove(h, 3), 9
  assert_eq h.st[0], [-9, -4, 20, 40, 42, 76]
  push(h, 2)
  assert_eq h.st[0], [-9, -4, 2, 40, 42, 76, 20]
  assert_eq pop(h), -9
  assert_eq h.st[0], [-4, 20, 2, 40, 42, 76]
  assert_eq remove(h, 2), 2
  assert_eq h.st[0], [-4, 20, 76, 40, 42]
  assert_eq remove(h, 4), 42
  assert_eq h.st[0], [-4, 20, 76, 40]
  assert_eq remove(h, 2), 76
  assert_eq h.st[0], [-4, 20, 40]
  assert_eq remove(h, 1), 20
  assert_eq h.st[0], [-4, 40]
  push(h, 9)
  assert_eq h.st[0], [-4, 40, 9]
  h.set!(0, 53)
  fix(h, 0)
  assert_eq h.st[0], [9, 40, 53]
  assert_eq remove(h, 2), 53
  assert_eq h.st[0], [9, 40]
  h.set!(0, 33)
  fix(h, 0)
  assert_eq h.st[0], [33, 40]
  h.set!(1, 8)
  fix(h, 1)
  assert_eq h.st[0], [8, 33]
  assert_eq pop(h), 8
  assert_eq h.st[0], [33]
  assert_eq pop(h), 33
  assert_eq h.st[0], []
  push(h, 58)
  assert_eq h.st[0], [58]
  push(h, -7)
  assert_eq h.st[0], [-7, 58]
  h.set!(0, 76)
  fix(h, 0)
  assert_eq h.st[0], [58, 76]
  push(h, 54)
  assert_eq h.st[0], [54, 76, 58]
  assert_eq remove(h, 2), 58
  assert_eq h.st[0], [54, 76]
  assert_eq pop(h), 54
  assert_eq h.st[0], [76]
  push(h, -17)
  assert_eq h.st[0], [-17, 76]
  assert_eq pop(h), -17
  assert_eq h.st[0], [76]
  assert_eq pop(h), 76
  assert_eq h.st[0], []
  push(h, 39)
  assert_eq h.st[0], [39]
  assert_eq remove(h, 0), 39
  assert_eq h.st[0], []
  push(h, 31)
  assert_eq h.st[0], [31]
  assert_eq remove(h, 0), 31
  assert_eq h.st[0], []
  push(h, 76)
  assert_eq h.st[0], [76]
  assert_eq pop(h), 76
  assert_eq h.st[0], []
  push(h, -7)
  assert_eq h.st[0], [-7]
  push(h, 69)
  assert_eq h.st[0], [-7, 69]
  h.set!(0, 76)
  fix(h, 0)
  assert_eq h.st[0], [69, 76]
  push(h, 38)
  assert_eq h.st[0], [38, 76, 69]
  push(h, 19)
  assert_eq h.st[0], [19, 38, 69, 76]
  push(h, 40)
