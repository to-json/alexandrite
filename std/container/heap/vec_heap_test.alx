# Generated from Go's container/heap (go1.27.1, scratch generator); do not edit by hand.
# Random operation sequences on an int heap; after each one the heap's
# slice must be exactly Go's (same sift order), and so must every result.

def vh(xs: [Int]) -> MyHeap { MyHeap.new(st: [xs]) }

test "vectors: sequence 0" {
  h = vh([37, 18, 0, 23, 45])
  init(h)
  assert_eq h.st[0], [0, 18, 37, 23, 45]
  assert_eq remove(h, 1), 18
  assert_eq h.st[0], [0, 23, 37, 45]
  h.set!(3, 9)
  fix(h, 3)
  assert_eq h.st[0], [0, 9, 37, 23]
  assert_eq remove(h, 3), 23
  assert_eq h.st[0], [0, 9, 37]
  h.set!(2, 33)
  fix(h, 2)
  assert_eq h.st[0], [0, 9, 33]
  push(h, -19)
  assert_eq h.st[0], [-19, 0, 33, 9]
  assert_eq pop(h), -19
  assert_eq h.st[0], [0, 9, 33]
  assert_eq pop(h), 0
  assert_eq h.st[0], [9, 33]
  push(h, 14)
  assert_eq h.st[0], [9, 33, 14]
  assert_eq pop(h), 9
  assert_eq h.st[0], [14, 33]
  assert_eq pop(h), 14
  assert_eq h.st[0], [33]
  assert_eq pop(h), 33
  assert_eq h.st[0], []
  push(h, -18)
  assert_eq h.st[0], [-18]
  h.set!(0, 59)
  fix(h, 0)
  assert_eq h.st[0], [59]
  push(h, -18)
  assert_eq h.st[0], [-18, 59]
  assert_eq pop(h), -18
  assert_eq h.st[0], [59]
  push(h, 9)
  assert_eq h.st[0], [9, 59]
  h.set!(0, 47)
  fix(h, 0)
  assert_eq h.st[0], [47, 59]
  push(h, -13)
  assert_eq h.st[0], [-13, 59, 47]
  assert_eq pop(h), -13
  assert_eq h.st[0], [47, 59]
  assert_eq remove(h, 0), 47
  assert_eq h.st[0], [59]
  push(h, 16)
  assert_eq h.st[0], [16, 59]
  push(h, 74)
  assert_eq h.st[0], [16, 59, 74]
  push(h, 9)
  assert_eq h.st[0], [9, 16, 74, 59]
  h.set!(2, 72)
  fix(h, 2)
  assert_eq h.st[0], [9, 16, 72, 59]
  h.set!(3, 52)
  fix(h, 3)
  assert_eq h.st[0], [9, 16, 72, 52]
  assert_eq remove(h, 2), 72
  assert_eq h.st[0], [9, 16, 52]
  push(h, 66)
  assert_eq h.st[0], [9, 16, 52, 66]
  assert_eq remove(h, 0), 9
  assert_eq h.st[0], [16, 66, 52]
  h.set!(0, 36)
  fix(h, 0)
  assert_eq h.st[0], [36, 66, 52]
  assert_eq pop(h), 36
  assert_eq h.st[0], [52, 66]
  assert_eq pop(h), 52
  assert_eq h.st[0], [66]
  assert_eq remove(h, 0), 66
  assert_eq h.st[0], []
  push(h, 55)
  assert_eq h.st[0], [55]
  assert_eq remove(h, 0), 55
  assert_eq h.st[0], []
  push(h, 67)
  assert_eq h.st[0], [67]
  push(h, -16)
  assert_eq h.st[0], [-16, 67]
  push(h, 64)
  assert_eq h.st[0], [-16, 67, 64]
  push(h, 46)
  assert_eq h.st[0], [-16, 46, 64, 67]
  h.set!(3, -7)
  fix(h, 3)
  assert_eq h.st[0], [-16, -7, 64, 46]
  h.set!(2, 34)
  fix(h, 2)
  assert_eq h.st[0], [-16, -7, 34, 46]
  assert_eq pop(h), -16
  assert_eq h.st[0], [-7, 46, 34]
  assert_eq remove(h, 2), 34
  assert_eq h.st[0], [-7, 46]
  h.set!(0, 78)
  fix(h, 0)
  assert_eq h.st[0], [46, 78]
  push(h, -13)
  assert_eq h.st[0], [-13, 78, 46]
  push(h, 31)
  assert_eq h.st[0], [-13, 31, 46, 78]
  push(h, 55)
  assert_eq h.st[0], [-13, 31, 46, 78, 55]
  assert_eq remove(h, 2), 46
  assert_eq h.st[0], [-13, 31, 55, 78]
  h.set!(0, 8)
  fix(h, 0)
  assert_eq h.st[0], [8, 31, 55, 78]
  assert_eq pop(h), 8
  assert_eq h.st[0], [31, 78, 55]
  h.set!(2, 42)
  fix(h, 2)
  assert_eq h.st[0], [31, 78, 42]
  assert_eq remove(h, 0), 31
  assert_eq h.st[0], [42, 78]
  assert_eq remove(h, 0), 42
  assert_eq h.st[0], [78]
  push(h, 19)
  assert_eq h.st[0], [19, 78]
  h.set!(1, 58)
  fix(h, 1)
  assert_eq h.st[0], [19, 58]
  assert_eq remove(h, 1), 58
  assert_eq h.st[0], [19]
  push(h, 58)
  assert_eq h.st[0], [19, 58]
  push(h, 2)
  assert_eq h.st[0], [2, 58, 19]
  push(h, 28)
  assert_eq h.st[0], [2, 28, 19, 58]
  push(h, 31)
  assert_eq h.st[0], [2, 28, 19, 58, 31]
  assert_eq pop(h), 2
  assert_eq h.st[0], [19, 28, 31, 58]
}

