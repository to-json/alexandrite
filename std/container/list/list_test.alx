import "strconv"

# Go's list_test.go and example_test.go, translated. Go's lists hold `any`
# (the test mixes "a", 2 and "banana"); these hold Str values, and the sum
# reads the numeric ones.

#[track_caller]
def check_list_len(l: List[Str], n: Int) -> Bool {
  assert l.len == n, "l.len = #{l.len}, want #{n}"
  true
}

# Go's checkListPointers: the internal links (through the sentinel) and the
# public next/prev agree with es.
def check_list_pointers(l: List[Str], es: [Element[Str]]) {
  check_list_len(l, es.size)
  if es.size == 0 {
    # zero length lists must be the zero value or properly initialized
    # (sentinel circle)
    if r = l.root_handle {
      assert l.nodes[r].nxt.unwrap == r && l.nodes[r].prv.unwrap == r, "an empty list's sentinel links to itself"
    }
    return
  }
  root = l.root_handle.unwrap
  for i in 0...es.size {
    e = es[i]
    node = l.nodes[e.h.unwrap]
    prev = if i > 0 { es[i - 1].h.unwrap } else { root }
    assert node.prv.unwrap == prev, "elt[#{i}].prv is wrong"
    if i > 0 {
      assert e.prev.unwrap == es[i - 1], "elt[#{i}].prev is wrong"
    } else {
      assert e.prev.none?, "elt[#{i}].prev should be none"
    }
    nxt = if i < es.size - 1 { es[i + 1].h.unwrap } else { root }
    assert node.nxt.unwrap == nxt, "elt[#{i}].nxt is wrong"
    if i < es.size - 1 {
      assert e.next.unwrap == es[i + 1], "elt[#{i}].next is wrong"
    } else {
      assert e.next.none?, "elt[#{i}].next should be none"
    }
  }
}

test "list" {
  l = List[Str].new
  check_list_pointers(l, [])

  # Single element list
  e = l.push_front!("a")
  check_list_pointers(l, [e])
  l.move_to_front!(e)
  check_list_pointers(l, [e])
  l.move_to_back!(e)
  check_list_pointers(l, [e])
  l.remove!(e)
  check_list_pointers(l, [])

  # Bigger list
  e2 = l.push_front!("2")
  e1 = l.push_front!("1")
  e3 = l.push_back!("3")
  e4 = l.push_back!("banana")
  check_list_pointers(l, [e1, e2, e3, e4])

  l.remove!(e2)
  check_list_pointers(l, [e1, e3, e4])

  l.move_to_front!(e3) # move from middle
  check_list_pointers(l, [e3, e1, e4])

  l.move_to_front!(e1)
  l.move_to_back!(e3) # move from middle
  check_list_pointers(l, [e1, e4, e3])

  l.move_to_front!(e3) # move from back
  check_list_pointers(l, [e3, e1, e4])
  l.move_to_front!(e3) # should be no-op
  check_list_pointers(l, [e3, e1, e4])

  l.move_to_back!(e3) # move from front
  check_list_pointers(l, [e1, e4, e3])
  l.move_to_back!(e3) # should be no-op
  check_list_pointers(l, [e1, e4, e3])

  e2 = l.insert_before!("2", e1).unwrap # insert before front
  check_list_pointers(l, [e2, e1, e4, e3])
  l.remove!(e2)
  e2 = l.insert_before!("2", e4).unwrap # insert before middle
  check_list_pointers(l, [e1, e2, e4, e3])
  l.remove!(e2)
  e2 = l.insert_before!("2", e3).unwrap # insert before back
  check_list_pointers(l, [e1, e4, e2, e3])
  l.remove!(e2)

  e2 = l.insert_after!("2", e1).unwrap # insert after front
  check_list_pointers(l, [e1, e2, e4, e3])
  l.remove!(e2)
  e2 = l.insert_after!("2", e4).unwrap # insert after middle
  check_list_pointers(l, [e1, e4, e2, e3])
  l.remove!(e2)
  e2 = l.insert_after!("2", e3).unwrap # insert after back
  check_list_pointers(l, [e1, e4, e3, e2])
  l.remove!(e2)

  # Check standard iteration.
  sum = 0
  it = l.front
  while it.present? {
    x = it.unwrap
    if n = strconv.atoi(x.value).ok {
      sum += n
    }
    it = x.next
  }
  assert sum == 4, "sum over l = #{sum}, want 4"

  # Clear all elements by iterating
  it = l.front
  while it.present? {
    x = it.unwrap
    nx = x.next
    l.remove!(x)
    it = nx
  }
  check_list_pointers(l, [])
}

def check_list(l: List[Int], es: [Int]) {
  assert l.len == es.size, "l.len = #{l.len}, want #{es.size}"
  i = 0
  e = l.front
  while e.present? {
    x = e.unwrap
    assert x.value == es[i], "elt[#{i}].value = #{x.value}, want #{es[i]}"
    i += 1
    e = x.next
  }
  assert_eq l.values, es
}

test "extending" {
  l1 = List[Int].new
  l2 = List[Int].new

  l1.push_back!(1)
  l1.push_back!(2)
  l1.push_back!(3)

  l2.push_back!(4)
  l2.push_back!(5)

  l3 = List[Int].new
  l3.push_back_list!(l1)
  check_list(l3, [1, 2, 3])
  l3.push_back_list!(l2)
  check_list(l3, [1, 2, 3, 4, 5])

  l3 = List[Int].new
  l3.push_front_list!(l2)
  check_list(l3, [4, 5])
  l3.push_front_list!(l1)
  check_list(l3, [1, 2, 3, 4, 5])

  check_list(l1, [1, 2, 3])
  check_list(l2, [4, 5])

  l3 = List[Int].new
  l3.push_back_list!(l1)
  check_list(l3, [1, 2, 3])
  l3.push_back_list!(l3)
  check_list(l3, [1, 2, 3, 1, 2, 3])

  l3 = List[Int].new
  l3.push_front_list!(l1)
  check_list(l3, [1, 2, 3])
  l3.push_front_list!(l3)
  check_list(l3, [1, 2, 3, 1, 2, 3])

  l3 = List[Int].new
  l1.push_back_list!(l3)
  check_list(l1, [1, 2, 3])
  l1.push_front_list!(l3)
  check_list(l1, [1, 2, 3])
}

test "remove" {
  l = List[Str].new
  e1 = l.push_back!("1")
  e2 = l.push_back!("2")
  check_list_pointers(l, [e1, e2])
  e = l.front.unwrap
  assert_eq l.remove!(e).unwrap, "1"
  check_list_pointers(l, [e2])
  # Removing it again leaves the list alone (Go returns e.Value; the value
  # left with its slot, so this gives none).
  assert l.remove!(e).none?
  check_list_pointers(l, [e2])
}

test "issue 4103" {
  l1 = List[Int].new
  l1.push_back!(1)
  l1.push_back!(2)

  l2 = List[Int].new
  l2.push_back!(3)
  l2.push_back!(4)

  e = l1.front.unwrap
  l2.remove!(e) # l2 should not change because e is not an element of l2
  assert l2.len == 2, "l2.len = #{l2.len}, want 2"

  l1.insert_before!(8, e)
  assert l1.len == 3, "l1.len = #{l1.len}, want 3"
  check_list(l1, [8, 1, 2])
  check_list(l2, [3, 4])
}

test "issue 6349" {
  l = List[Int].new
  l.push_back!(1)
  l.push_back!(2)

  e = l.front.unwrap
  # Go checks e.Value after the removal; here remove! hands it back.
  assert_eq l.remove!(e).unwrap, 1
  assert e.next.none?, "e.next != none"
  assert e.prev.none?, "e.prev != none"
}

test "move" {
  l = List[Str].new
  e1 = l.push_back!("1")
  e2 = l.push_back!("2")
  e3 = l.push_back!("3")
  e4 = l.push_back!("4")

  l.move_after!(e3, e3)
  check_list_pointers(l, [e1, e2, e3, e4])
  l.move_before!(e2, e2)
  check_list_pointers(l, [e1, e2, e3, e4])

  l.move_after!(e3, e2)
  check_list_pointers(l, [e1, e2, e3, e4])
  l.move_before!(e2, e3)
  check_list_pointers(l, [e1, e2, e3, e4])

  l.move_before!(e2, e4)
  check_list_pointers(l, [e1, e3, e2, e4])
  e2, e3 = e3, e2

  l.move_before!(e4, e1)
  check_list_pointers(l, [e4, e1, e2, e3])
  e1, e2, e3, e4 = e4, e1, e2, e3

  l.move_after!(e4, e1)
  check_list_pointers(l, [e1, e4, e2, e3])
  e2, e3, e4 = e4, e2, e3

  l.move_after!(e2, e3)
  check_list_pointers(l, [e1, e3, e2, e4])
  assert_eq l.values, ["4", "1", "2", "3"]
}

# Test push_front, push_back, push_front_list, push_back_list with an
# uninitialized List.
test "zero list" {
  l1 = List[Int].new
  l1.push_front!(1)
  check_list(l1, [1])

  l2 = List[Int].new
  l2.push_back!(1)
  check_list(l2, [1])

  l3 = List[Int].new
  l3.push_front_list!(l1)
  check_list(l3, [1])

  l4 = List[Int].new
  l4.push_back_list!(l2)
  check_list(l4, [1])
}

# A list l is not modified when calling insert_before with a mark that is
# not an element of l.
test "insert before unknown mark" {
  l = List[Int].new
  l.push_back!(1)
  l.push_back!(2)
  l.push_back!(3)
  assert l.insert_before!(1, Element[Int].new).none?
  check_list(l, [1, 2, 3])
}

# A list l is not modified when calling insert_after with a mark that is
# not an element of l.
test "insert after unknown mark" {
  l = List[Int].new
  l.push_back!(1)
  l.push_back!(2)
  l.push_back!(3)
  assert l.insert_after!(1, Element[Int].new).none?
  check_list(l, [1, 2, 3])
}

# A list l is not modified when calling move_after or move_before with a
# mark that is not an element of l.
test "move unknown mark" {
  l1 = List[Int].new
  e1 = l1.push_back!(1)

  l2 = List[Int].new
  e2 = l2.push_back!(2)

  l1.move_after!(e1, e2)
  check_list(l1, [1])
  check_list(l2, [2])

  l1.move_before!(e1, e2)
  check_list(l1, [1])
  check_list(l2, [2])
}

# Beyond Go's tests: what the pool representation adds.

test "copies of a list are the same list" {
  l = List[Int].new
  l.push_back!(1)
  m = l
  m.push_back!(2)
  check_list(l, [1, 2])
  e = l.front.unwrap
  assert_eq m.remove!(e).unwrap, 1
  check_list(l, [2])
  # a copy taken before the first insertion shares the pool too
  a = List[Int].new
  b = a
  a.push_back!(7)
  b.push_back!(8)
  check_list(a, [7, 8])
  check_list(b, [7, 8])
}

test "element identity" {
  l1 = List[Int].new
  l2 = List[Int].new
  a = l1.push_back!(1)
  b = l2.push_back!(1)
  # the same handle in different pools is a different element
  assert a.h.unwrap == b.h.unwrap
  assert a != b
  assert a == l1.front.unwrap
  assert Element[Int].new == Element[Int].new
  assert a != Element[Int].new
}

test "slots are reused, stale elements stay stale" {
  l = List[Int].new
  e = l.push_back!(1)
  l.remove!(e)
  f = l.push_back!(2) # reuses e's slot
  assert e != f
  assert l.remove!(e).none?
  check_list(l, [2])
  assert e.next.none?
  # a queue: the pool stays small however many pass through
  for i in 0...1000 {
    l.push_back!(i)
    l.remove!(l.front.unwrap)
  }
  assert_eq l.len, 1
  assert l.nodes.size <= 3
}

test "set_value and init" {
  l = List[Str].new
  e = l.push_back!("x")
  l.push_back!("y")
  e.set_value!("z")
  assert_eq l.front.unwrap.value, "z"
  l.init!
  assert_eq l.len, 0
  assert l.front.none?
  assert l.remove!(e).none?
  l.push_back!("w")
  assert_eq l.values, ["w"]
}

example "list" {
  # Create a new list and put some numbers in it.
  l = List[Int].new
  e4 = l.push_back!(4)
  e1 = l.push_front!(1)
  l.insert_before!(3, e4)
  l.insert_after!(2, e1)

  # Iterate through list and print its contents.
  e = l.front
  while e.present? {
    x = e.unwrap
    puts x.value
    e = x.next
  }
} outputs "1\n2\n3\n4"
