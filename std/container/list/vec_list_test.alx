  assert_eq es[3].prev.unwrap.value, 20
  assert_eq l.len, 10
  assert_eq l.values, [20, 39, 33, 28, 17, 1, 2, 13, 14, 29]
  assert es[12].next.none?
  assert es[12].prev.none?
  assert_eq l.len, 10
