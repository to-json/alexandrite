test "vectors: sequence 2" {
  l = List[Int].new
  o = List[Int].new
  es: [Element[Int]] = []
  o.push_back!(1)
  assert_eq l.len, 0
  assert_eq l.values, []
  o.push_back!(2)
  assert_eq l.len, 0
  assert_eq l.values, []
  es << l.push_back!(3)
  assert_eq l.len, 1
  assert_eq l.values, [3]
  l.move_before!(es[0], es[0])
  assert_eq l.len, 1
  assert_eq l.values, [3]
  assert_eq l.remove!(es[0]).unwrap, 3
  assert_eq l.len, 0
  assert_eq l.values, []
  assert l.insert_before!(4, es[0]).none?
  assert_eq l.len, 0
  assert_eq l.values, []
  es << l.push_back!(5)
  assert_eq l.len, 1
  assert_eq l.values, [5]
  l.move_to_front!(es[0])
  assert_eq l.len, 1
  assert_eq l.values, [5]
  es << l.insert_before!(6, es[1]).unwrap
  assert_eq l.len, 2
  assert_eq l.values, [6, 5]
  assert_eq l.remove!(es[1]).unwrap, 5
  assert_eq l.len, 1
  assert_eq l.values, [6]
  assert_eq backwards(l), [6]
  assert_eq l.remove!(es[2]).unwrap, 6
  assert_eq l.len, 0
  assert_eq l.values, []
  l.move_to_back!(es[0])
  assert_eq l.len, 0
  assert_eq l.values, []
  assert l.remove!(es[1]).none?
  assert_eq l.len, 0
  assert_eq l.values, []
  es << l.push_back!(7)
  assert_eq l.len, 1
  assert_eq l.values, [7]
  assert es[2].next.none?
  assert es[2].prev.none?
