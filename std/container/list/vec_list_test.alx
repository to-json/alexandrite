  assert_eq l.len, 17
  assert_eq l.values, [4, 15, 11, 23, 26, 18, 4, 13, 4, 7, 4, 15, 4, 15, 4, 15, 27]
  es[11].set_value!(30)
  assert_eq es[11].next.unwrap.value, 4
  assert_eq es[11].prev.unwrap.value, 26
  assert_eq l.len, 17
  assert_eq l.values, [4, 15, 11, 23, 26, 30, 4, 13, 4, 7, 4, 15, 4, 15, 4, 15, 27]
  o.push_back!(31)
  assert_eq l.len, 17
  assert_eq l.values, [4, 15, 11, 23, 26, 30, 4, 13, 4, 7, 4, 15, 4, 15, 4, 15, 27]
  assert l.insert_before!(32, es[3]).none?
  assert_eq l.len, 17
  assert_eq l.values, [4, 15, 11, 23, 26, 30, 4, 13, 4, 7, 4, 15, 4, 15, 4, 15, 27]
  es << l.push_front!(33)
  assert_eq l.len, 18
  assert_eq l.values, [33, 4, 15, 11, 23, 26, 30, 4, 13, 4, 7, 4, 15, 4, 15, 4, 15, 27]
  assert es[7].next.none?
  assert es[7].prev.none?
  assert_eq l.len, 18
  assert_eq l.values, [33, 4, 15, 11, 23, 26, 30, 4, 13, 4, 7, 4, 15, 4, 15, 4, 15, 27]
  l.move_to_back!(es[3])
  assert_eq l.len, 18
  assert_eq l.values, [33, 4, 15, 11, 23, 26, 30, 4, 13, 4, 7, 4, 15, 4, 15, 4, 15, 27]
  l.move_after!(es[7], es[2])
  assert_eq l.len, 18
  assert_eq l.values, [33, 4, 15, 11, 23, 26, 30, 4, 13, 4, 7, 4, 15, 4, 15, 4, 15, 27]
  assert_eq backwards(l), [27, 15, 4, 15, 4, 15, 4, 7, 4, 13, 4, 30, 26, 23, 11, 15, 4, 33]
}
