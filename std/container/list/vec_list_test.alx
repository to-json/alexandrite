test "vectors: sequence 1" {
  l = List[Int].new
  o = List[Int].new
  es: [Element[Int]] = []
  es << l.push_front!(1)
  assert_eq l.len, 1
  assert_eq l.values, [1]
  es << l.insert_before!(2, es[0]).unwrap
  assert_eq l.len, 2
  assert_eq l.values, [2, 1]
  l.move_after!(es[0], es[1])
  assert_eq l.len, 2
  assert_eq l.values, [2, 1]
  l.move_after!(es[0], es[1])
  assert_eq l.len, 2
  assert_eq l.values, [2, 1]
  l.move_before!(es[1], es[1])
  assert_eq l.len, 2
  assert_eq l.values, [2, 1]
  es << l.push_back!(3)
  assert_eq l.len, 3
  assert_eq l.values, [2, 1, 3]
  assert_eq l.remove!(es[1]).unwrap, 2
  assert_eq l.len, 2
  assert_eq l.values, [1, 3]
  assert es[1].next.none?
  assert es[1].prev.none?
  assert_eq l.len, 2
  assert_eq l.values, [1, 3]
  o.push_back!(4)
  assert_eq l.len, 2
  assert_eq l.values, [1, 3]
  es[2].set_value!(5)
  assert es[2].next.none?
  assert_eq es[2].prev.unwrap.value, 1
  assert_eq l.len, 2
  assert_eq l.values, [1, 5]
  assert_eq backwards(l), [5, 1]
  es << l.insert_after!(6, es[0]).unwrap
  assert_eq l.len, 3
  assert_eq l.values, [1, 6, 5]
  l.move_before!(es[1], es[0])
  assert_eq l.len, 3
  assert_eq l.values, [1, 6, 5]
  es << l.insert_before!(7, es[3]).unwrap
  assert_eq l.len, 4
  assert_eq l.values, [1, 7, 6, 5]
  assert_eq l.remove!(es[2]).unwrap, 5
  assert_eq l.len, 3
  assert_eq l.values, [1, 7, 6]
  l.move_to_front!(es[2])
  assert_eq l.len, 3
  assert_eq l.values, [1, 7, 6]
  l.move_after!(es[2], es[1])
  assert_eq l.len, 3
  assert_eq l.values, [1, 7, 6]
  l.move_after!(es[0], es[2])
  assert_eq l.len, 3
  assert_eq l.values, [1, 7, 6]
  l.move_before!(es[3], es[0])
  assert_eq l.len, 3
  assert_eq l.values, [6, 1, 7]
  l.move_to_back!(es[2])
  assert_eq l.len, 3
  assert_eq l.values, [6, 1, 7]
  es << l.insert_before!(8, es[0]).unwrap
  assert_eq l.len, 4
  assert_eq l.values, [6, 8, 1, 7]
  assert_eq backwards(l), [7, 1, 8, 6]
  l.move_before!(es[3], es[1])
  assert_eq l.len, 4
  assert_eq l.values, [6, 8, 1, 7]
  l.push_front_list!(o)
  assert_eq l.len, 5
  assert_eq l.values, [4, 6, 8, 1, 7]
  es[4].set_value!(9)
  assert es[4].next.none?
  assert_eq es[4].prev.unwrap.value, 1
  assert_eq l.len, 5
  assert_eq l.values, [4, 6, 8, 1, 9]
  assert_eq l.remove!(es[5]).unwrap, 8
  assert_eq l.len, 4
  assert_eq l.values, [4, 6, 1, 9]
  l.move_to_back!(es[2])
  assert_eq l.len, 4
  assert_eq l.values, [4, 6, 1, 9]
  l.move_after!(es[3], es[0])
  assert_eq l.len, 4
  assert_eq l.values, [4, 1, 6, 9]
  l.push_front_list!(o)
  assert_eq l.len, 5
  assert_eq l.values, [4, 4, 1, 6, 9]
  assert l.remove!(es[1]).none?
  assert_eq l.len, 5
  assert_eq l.values, [4, 4, 1, 6, 9]
  assert l.insert_before!(10, es[5]).none?
  assert_eq l.len, 5
  assert_eq l.values, [4, 4, 1, 6, 9]
  assert l.insert_after!(11, es[5]).none?
  assert_eq l.len, 5
  assert_eq l.values, [4, 4, 1, 6, 9]
  assert_eq backwards(l), [9, 6, 1, 4, 4]
  es[0].set_value!(12)
  assert_eq es[0].next.unwrap.value, 6
  assert_eq es[0].prev.unwrap.value, 4
  assert_eq l.len, 5
  assert_eq l.values, [4, 4, 12, 6, 9]
  l.move_to_back!(es[2])
  assert_eq l.len, 5
  assert_eq l.values, [4, 4, 12, 6, 9]
  l.move_to_back!(es[2])
