  assert_eq l.values, [1]
  l.move_to_back!(es[0])
  assert_eq l.len, 1
  assert_eq l.values, [1]
  assert_eq l.remove!(es[0]).unwrap, 1
  assert_eq l.len, 0
  assert_eq l.values, []
  l.push_back_list!(o)
  assert_eq l.len, 0
  assert_eq l.values, []
  o.push_back!(2)
  assert_eq l.len, 0
  assert_eq l.values, []
