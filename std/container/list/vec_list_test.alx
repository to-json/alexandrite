# Generated from Go's container/list (go1.27.1, scratch generator); do not edit by hand.
# Random operation sequences, on live and on removed elements; after each
# one the list must read like Go's, forwards and backwards.

def backwards(l: List[Int]) -> [Int] {
  out: [Int] = []
  e = l.back
  while e.present? {
    x = e.unwrap
    out << x.value
    e = x.prev
  }
  out
}

test "vectors: sequence 0" {
