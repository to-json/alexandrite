test "vectors: sequence 4" {
  l = List[Int].new
  o = List[Int].new
  es: [Element[Int]] = []
  o.push_back!(1)
  assert_eq l.len, 0
  assert_eq l.values, []
  o.push_back!(2)
  assert_eq l.len, 0
  assert_eq l.values, []
  o.push_back!(3)
  assert_eq l.len, 0
  assert_eq l.values, []
  es << l.push_back!(4)
  assert_eq l.len, 1
  assert_eq l.values, [4]
  l.move_to_back!(es[0])
  assert_eq l.len, 1
  assert_eq l.values, [4]
  l.move_after!(es[0], es[0])
  assert_eq l.len, 1
  assert_eq l.values, [4]
  assert_eq l.remove!(es[0]).unwrap, 4
  assert_eq l.len, 0
  assert_eq l.values, []
  assert l.remove!(es[0]).none?
  assert_eq l.len, 0
  assert_eq l.values, []
  assert l.insert_before!(5, es[0]).none?
  assert_eq l.len, 0
  assert_eq l.values, []
  assert l.insert_after!(6, es[0]).none?
  assert_eq l.len, 0
  assert_eq l.values, []
  assert_eq backwards(l), []
  l.move_to_back!(es[0])
  assert_eq l.len, 0
  assert_eq l.values, []
  assert l.remove!(es[0]).none?
  assert_eq l.len, 0
  assert_eq l.values, []
  es << l.push_back!(7)
  assert_eq l.len, 1
  assert_eq l.values, [7]
  assert l.remove!(es[0]).none?
  assert_eq l.len, 1
  assert_eq l.values, [7]
  es << l.push_back!(8)
  assert_eq l.len, 2
  assert_eq l.values, [7, 8]
  l.push_front_list!(o)
  assert_eq l.len, 5
  assert_eq l.values, [1, 2, 3, 7, 8]
  es << l.insert_after!(9, es[2]).unwrap
  assert_eq l.len, 6
  assert_eq l.values, [1, 2, 3, 7, 8, 9]
  assert l.remove!(es[0]).none?
  assert_eq l.len, 6
  assert_eq l.values, [1, 2, 3, 7, 8, 9]
  assert_eq l.remove!(es[2]).unwrap, 8
  assert_eq l.len, 5
  assert_eq l.values, [1, 2, 3, 7, 9]
  es << l.insert_before!(10, es[3]).unwrap
  assert_eq l.len, 6
  assert_eq l.values, [1, 2, 3, 7, 10, 9]
  assert_eq backwards(l), [9, 10, 7, 3, 2, 1]
  l.move_before!(es[3], es[3])
  assert_eq l.len, 6
  assert_eq l.values, [1, 2, 3, 7, 10, 9]
  es << l.insert_before!(11, es[3]).unwrap
  assert_eq l.len, 7
  assert_eq l.values, [1, 2, 3, 7, 10, 11, 9]
  l.move_to_front!(es[0])
  assert_eq l.len, 7
  assert_eq l.values, [1, 2, 3, 7, 10, 11, 9]
  es << l.insert_before!(12, es[1]).unwrap
  assert_eq l.len, 8
