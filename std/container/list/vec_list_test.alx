  assert_eq l.values, []
  l.move_after!(es[0], es[0])
  assert_eq l.len, 0
  assert_eq l.values, []
  l.move_before!(es[0], es[0])
  assert_eq l.len, 0
  assert_eq l.values, []
  assert l.remove!(es[0]).none?
  assert_eq l.len, 0
  assert_eq l.values, []
  assert l.remove!(es[0]).none?
  assert_eq l.len, 0
  assert_eq l.values, []
  assert_eq backwards(l), []
  assert l.remove!(es[0]).none?
  assert_eq l.len, 0
  assert_eq l.values, []
  assert l.insert_before!(2, es[0]).none?
