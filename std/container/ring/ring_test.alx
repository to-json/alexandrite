# Go's ring_test.go and example_test.go, translated. A nil *Ring is a
# `Ring[Int]?` that is none; values are Ints (Go's `any` holding ints, nil
# counting as 0 in the sums).

# Go's verify: length, iteration, internal links, next/prev and move.
def verify(r0: Ring[Int]?, n: Int, sum: Int) {
  # len
  got_len = if r = r0 { r.len } else { 0 }
  assert got_len == n, "r.len == #{got_len}; expected #{n}"

  # iteration
  k = 0
  s = 0
  if r = r0 {
    r.do { |p|
      k += 1
      s += p
    }
  }
  assert k == n, "number of forward iterations == #{k}; expected #{n}"
  assert sum < 0 || s == sum, "forward ring sum = #{s}; expected #{sum}"

  return if r0.none?
  r = r0.unwrap
  # connections
  if hh = r.h {
    p = hh
    q = r.nxt_of(hh)
    loop {
      assert r.prv_of(q) == p, "prev = #{p}, expected q.prev = #{r.prv_of(q)}"
      break if q == hh
      p = q
      q = r.nxt_of(q)
    }
  }

  # next, prev
  if hh = r.h {
    assert r.next.h.unwrap == r.nxt_of(hh), "r.next != r.nxt"
    assert r.prev.h.unwrap == r.prv_of(hh), "r.prev != r.prv"
  }

  # move
  assert r.move(0) == r, "r.move(0) != r"
  assert r.move(n) == r, "r.move(#{n}) != r"
  assert r.move(-n) == r, "r.move(#{-n}) != r"
  for i in 0...10 {
    ni = n + i
    mi = ni % n
    assert r.move(ni) == r.move(mi), "r.move(#{ni}) != r.move(#{mi})"
    assert r.move(-ni) == r.move(-mi), "r.move(#{-ni}) != r.move(#{-mi})"
  }
}

test "corner cases" {
  r0: Ring[Int]? = none
  r1 = Ring[Int].new
  # Basics
  verify(r0, 0, 0)
  verify(r1, 1, 0)
  # Insert
  r1.link!(r0)
  verify(r0, 0, 0)
  verify(r1, 1, 0)
  # Insert
  r1.link!(r0)
  verify(r0, 0, 0)
  verify(r1, 1, 0)
  # Unlink
  r1.unlink!(0)
  verify(r1, 1, 0)
}

def make_n(n: Int) -> Ring[Int]? {
  r0 = new(n, 0)
  if rr = r0 {
    r = rr
    for i in 1..n {
      r.set_value!(i)
      r = r.next
    }
    return r
  }
  none
}

def sum_n(n: Int) -> Int { (n * n + n) / 2 }

test "new" {
  for i in 0...10 {
    r = new(i, 0)
    verify(r, i, -1)
  }
  for i in 0...10 {
    r = make_n(i)
    verify(r, i, sum_n(i))
  }
}

test "link1" {
  r1a = make_n(1).unwrap
  r1b = Ring[Int].new
  r2a = r1a.link!(r1b)
  verify(r2a, 2, 1)
  assert r2a == r1a, "a) 2-element link failed"

  r2b = r2a.link!(r2a.next)
  verify(r2b, 2, 1)
  assert r2b == r2a.next, "b) 2-element link failed"

  r1c = r2b.link!(r2b)
  verify(r1c, 1, 1)
  verify(r2b, 1, 0)
}

test "link2" {
  r0: Ring[Int]? = none
  r1a = Ring[Int].new
  r1a.set_value!(42)
  r1b = Ring[Int].new
  r1b.set_value!(77)
  r10 = make_n(10).unwrap

  r1a.link!(r0)
  verify(r1a, 1, 42)

  r1a.link!(r1b)
  verify(r1a, 2, 42 + 77)

  r10.link!(r0)
  verify(r10, 10, sum_n(10))

  r10.link!(r1a)
  verify(r10, 12, sum_n(10) + 42 + 77)
}

test "link3" {
  r = Ring[Int].new
  n = 1
  for i in 1...10 {
    n += i
    verify(r.link!(new(i, 0)), n, -1)
  }
}

test "unlink" {
  r10 = make_n(10).unwrap
  s10 = r10.move(6)

  sum10 = sum_n(10)

  verify(r10, 10, sum10)
  verify(s10, 10, sum10)

  r0 = r10.unlink!(0)
  verify(r0, 0, 0)

  r1 = r10.unlink!(1)
  verify(r1, 1, 2)
  verify(r10, 9, sum10 - 2)

  r9 = r10.unlink!(9)
  verify(r9, 9, sum10 - 2)
  verify(r10, 9, sum10 - 2)
}

test "link unlink" {
  for i in 1...4 {
    ri = new(i, 0).unwrap
    for j in 0...i {
      rj = ri.unlink!(j)
      verify(rj, j, -1)
      verify(ri, i - j, -1)
      ri.link!(rj)
      verify(ri, i, -1)
    }
  }
}

# Calling move on an empty (zero) Ring treats it as a one-element ring.
test "move empty ring" {
  r = Ring[Int].new
  r.move(1)
  verify(r, 1, 0)
}

# Beyond Go's tests: what the pool representation adds.

test "linking across pools moves the elements" {
  a = new(3, 1).unwrap
  b = new(2, 10).unwrap
  b_next = b.next
  a.link!(b)
  verify(a, 5, 23)
  # b's old elements were moved; their old handles are gone
  assert b.pool.size == 0
  t = spawn { b_next.value }
  assert t.wait.err?
}

test "rings in one pool link in place" {
  a = new(3, 1).unwrap
  b = a.new_ring(2, 10).unwrap
  a.link!(b)
  verify(a, 5, 23)
  verify(b, 5, 23)
  assert a.next == b
  assert b.value == 10
}

test "identity" {
  a = new(1, 5).unwrap
  b = new(1, 5).unwrap
  assert a.h.unwrap == b.h.unwrap # same handle, different pools
  assert a != b
  assert a == a.next
  assert Ring[Int].new == Ring[Int].new
  assert a != Ring[Int].new
}

example "len" {
  # Create a new ring of size 4
  r = new(4, 0).unwrap
  # Print out its length
  puts r.len
} outputs "4"

example "next" {
  # Create a new ring of size 5
  r = new(5, 0).unwrap
  # Get the length of the ring
  n = r.len
  # Initialize the ring with some integer values
  for i in 0...n {
    r.set_value!(i)
    r = r.next
  }
  # Iterate through the ring and print its contents
  for _ in 0...n {
    puts r.value
    r = r.next
  }
} outputs "0\n1\n2\n3\n4"

example "prev" {
  # Create a new ring of size 5
  r = new(5, 0).unwrap
  n = r.len
  for i in 0...n {
    r.set_value!(i)
    r = r.next
  }
  # Iterate through the ring backwards and print its contents
  for _ in 0...n {
    r = r.prev
    puts r.value
  }
} outputs "4\n3\n2\n1\n0"

example "do" {
  r = new(5, 0).unwrap
  n = r.len
  for i in 0...n {
    r.set_value!(i)
    r = r.next
  }
  # Iterate through the ring and print its contents
  r.do { |p| puts p }
} outputs "0\n1\n2\n3\n4"

example "move" {
  r = new(5, 0).unwrap
  n = r.len
  for i in 0...n {
    r.set_value!(i)
    r = r.next
  }
  # Move the pointer forward by three steps
  r = r.move(3)
  r.do { |p| puts p }
} outputs "3\n4\n0\n1\n2"

example "link" {
  # Create two rings, r and s, of size 2
  r = new(2, 0).unwrap
  s = new(2, 0).unwrap
  # Get the length of the ring
  lr = r.len
  ls = s.len
  # Initialize r with 0s
  for _ in 0...lr {
    r.set_value!(0)
    r = r.next
  }
  # Initialize s with 1s
  for _ in 0...ls {
    s.set_value!(1)
    s = s.next
  }
  # Link ring r and ring s
  rs = r.link!(s)
  # Iterate through the combined ring and print its contents
  rs.do { |p| puts p }
} outputs "0\n0\n1\n1"

example "unlink" {
  # Create a new ring of size 6
  r = new(6, 0).unwrap
  n = r.len
  for i in 0...n {
    r.set_value!(i)
    r = r.next
  }
  # Unlink three elements from r, starting from r.next
  r.unlink!(3)
  # Iterate through the remaining ring and print its contents
  r.do { |p| puts p }
} outputs "0\n4\n5"
