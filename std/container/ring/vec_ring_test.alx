  rs << rs[0].link!(rs[0])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [10, 11, 9, 14, 12]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [24, 25]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [14, 12, 10, 11, 9]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [25, 24]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [26]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [13]
  rs << fill(new(3, 0), [27, 28, 29])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [24, 25]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [14, 12, 10, 11, 9]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [25, 24]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [26]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [13]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [27, 28, 29]
  rs << rs[3].link!(rs[3])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [14, 12, 10, 11, 9]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [25, 24]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [26]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [13]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [27, 28, 29]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [26]
  rs << rs[3].unlink!(4).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [25, 24]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [26]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [13]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [27, 28, 29]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [26]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [13]
  rs << rs[4].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [26]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [13]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [27, 28, 29]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [26]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [13]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [26]
}

test "vectors: sequence 6" {
  rs: [Ring[Int]] = []
  rs << fill(new(4, 0), [1, 2, 3, 4])
  rs << fill(new(1, 0), [5])
  rs << rs[1].move(-5)
  assert_eq rs[2].value, 5
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [1, 2, 3, 4]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [5]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [5]
  rs << rs[0].unlink!(2).unwrap
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 4]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [5]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [5]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [2, 3]
  rs << rs[2].link!(rs[1])
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 4]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [5]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [5]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [2, 3]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [5]
  assert rs[0].unlink!(0).none?
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 4]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [5]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [5]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [2, 3]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [5]
  rs << rs[1].link!(rs[3])
  rs = [rs[0], rs[1], rs[2], rs[4], rs[5]]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 2, 3]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [5, 2, 3]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [5, 2, 3]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [5, 2, 3]
  assert rs[2].unlink!(-1).none?
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 2, 3]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [5, 2, 3]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [5, 2, 3]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [5, 2, 3]
  rs << rs[0].move(-2)
  assert_eq rs[5].value, 1
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 2, 3]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [5, 2, 3]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [5, 2, 3]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [5, 2, 3]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [1, 4]
  assert rs[3].unlink!(-1).none?
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 2, 3]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [5, 2, 3]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [5, 2, 3]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [5, 2, 3]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [1, 4]
  rs << fill(new(4, 0), [6, 7, 8, 9])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [5, 2, 3]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 2, 3]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [5, 2, 3]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [5, 2, 3]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [1, 4]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [6, 7, 8, 9]
  rs << rs[0].link!(rs[5])
  rs = [rs[0], rs[1], rs[2], rs[3], rs[4], rs[6]]
  assert_eq rs[0].len, 7
  assert_eq vals(rs[0]), [5, 6, 7, 8, 9, 2, 3]
  assert_eq rs[1].len, 7
  assert_eq vals(rs[1]), [5, 6, 7, 8, 9, 2, 3]
  assert_eq rs[2].len, 7
  assert_eq vals(rs[2]), [5, 6, 7, 8, 9, 2, 3]
  assert_eq rs[3].len, 7
  assert_eq vals(rs[3]), [5, 6, 7, 8, 9, 2, 3]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [1, 4]
  assert_eq rs[5].len, 7
  assert_eq vals(rs[5]), [2, 3, 5, 6, 7, 8, 9]
  rs << rs[5].move(-4)
  assert_eq rs[6].value, 6
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 7
  assert_eq vals(rs[0]), [5, 6, 7, 8, 9, 2, 3]
  assert_eq rs[1].len, 7
  assert_eq vals(rs[1]), [5, 6, 7, 8, 9, 2, 3]
  assert_eq rs[2].len, 7
  assert_eq vals(rs[2]), [5, 6, 7, 8, 9, 2, 3]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [1, 4]
  assert_eq rs[4].len, 7
  assert_eq vals(rs[4]), [2, 3, 5, 6, 7, 8, 9]
  assert_eq rs[5].len, 7
  assert_eq vals(rs[5]), [6, 7, 8, 9, 2, 3, 5]
  rs << rs[2].move(-4)
  assert_eq rs[6].value, 8
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 7
  assert_eq vals(rs[0]), [5, 6, 7, 8, 9, 2, 3]
  assert_eq rs[1].len, 7
  assert_eq vals(rs[1]), [5, 6, 7, 8, 9, 2, 3]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [1, 4]
  assert_eq rs[3].len, 7
  assert_eq vals(rs[3]), [2, 3, 5, 6, 7, 8, 9]
  assert_eq rs[4].len, 7
  assert_eq vals(rs[4]), [6, 7, 8, 9, 2, 3, 5]
  assert_eq rs[5].len, 7
  assert_eq vals(rs[5]), [8, 9, 2, 3, 5, 6, 7]
  rs << rs[5].move(1)
  assert_eq rs[6].value, 9
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 7
  assert_eq vals(rs[0]), [5, 6, 7, 8, 9, 2, 3]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [1, 4]
  assert_eq rs[2].len, 7
  assert_eq vals(rs[2]), [2, 3, 5, 6, 7, 8, 9]
  assert_eq rs[3].len, 7
  assert_eq vals(rs[3]), [6, 7, 8, 9, 2, 3, 5]
  assert_eq rs[4].len, 7
  assert_eq vals(rs[4]), [8, 9, 2, 3, 5, 6, 7]
  assert_eq rs[5].len, 7
  assert_eq vals(rs[5]), [9, 2, 3, 5, 6, 7, 8]
  rs << rs[2].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 4]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [2, 5, 6, 7, 8, 9]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [6, 7, 8, 9, 2, 5]
  assert_eq rs[3].len, 6
  assert_eq vals(rs[3]), [8, 9, 2, 5, 6, 7]
  assert_eq rs[4].len, 6
  assert_eq vals(rs[4]), [9, 2, 5, 6, 7, 8]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [3]
  rs << rs[3].move(4)
  assert_eq rs[6].value, 6
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 6
  assert_eq vals(rs[0]), [2, 5, 6, 7, 8, 9]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [6, 7, 8, 9, 2, 5]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [8, 9, 2, 5, 6, 7]
  assert_eq rs[3].len, 6
  assert_eq vals(rs[3]), [9, 2, 5, 6, 7, 8]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [3]
  assert_eq rs[5].len, 6
  assert_eq vals(rs[5]), [6, 7, 8, 9, 2, 5]
  rs << rs[2].unlink!(4).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [6, 9, 2, 5]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [8, 7]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [9, 2, 5, 6]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [3]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [6, 9, 2, 5]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [9, 2, 5, 6]
  rs << fill(new(3, 0), [10, 11, 12])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [8, 7]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [9, 2, 5, 6]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [3]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [6, 9, 2, 5]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [9, 2, 5, 6]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [10, 11, 12]
  rs << rs[4].move(1)
  assert_eq rs[6].value, 2
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [9, 2, 5, 6]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [3]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [6, 9, 2, 5]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [9, 2, 5, 6]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [10, 11, 12]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [2, 5, 6, 9]
  assert rs[4].unlink!(0).none?
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [9, 2, 5, 6]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [3]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [6, 9, 2, 5]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [9, 2, 5, 6]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [10, 11, 12]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [2, 5, 6, 9]
  rs << fill(new(4, 0), [13, 14, 15, 16])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [3]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [6, 9, 2, 5]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [9, 2, 5, 6]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [10, 11, 12]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [2, 5, 6, 9]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [13, 14, 15, 16]
  rs << rs[1].move(-6)
  assert_eq rs[6].value, 2
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [6, 9, 2, 5]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [9, 2, 5, 6]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [10, 11, 12]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [2, 5, 6, 9]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [13, 14, 15, 16]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [2, 5, 6, 9]
  rs << rs[1].move(-2)
  assert_eq rs[6].value, 5
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [9, 2, 5, 6]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [10, 11, 12]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [2, 5, 6, 9]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [13, 14, 15, 16]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [2, 5, 6, 9]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [5, 6, 9, 2]
  rs << fill(new(2, 0), [17, 18])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [10, 11, 12]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [2, 5, 6, 9]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [13, 14, 15, 16]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [2, 5, 6, 9]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [5, 6, 9, 2]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [17, 18]
  rs << fill(new(3, 0), [19, 20, 21])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [2, 5, 6, 9]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [13, 14, 15, 16]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [2, 5, 6, 9]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [5, 6, 9, 2]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [17, 18]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [19, 20, 21]
  rs << rs[3].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [13, 14, 15, 16]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [2, 5]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [5, 2]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [17, 18]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [19, 20, 21]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [6, 9]
  rs << rs[0].move(5)
  assert_eq rs[6].value, 14
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [2, 5]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [5, 2]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [17, 18]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [19, 20, 21]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [6, 9]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [14, 15, 16, 13]
  rs << fill(new(3, 0), [22, 23, 24])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [5, 2]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [17, 18]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [19, 20, 21]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [6, 9]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [14, 15, 16, 13]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [22, 23, 24]
  rs << rs[3].move(4)
  assert_eq rs[6].value, 6
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [17, 18]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [19, 20, 21]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [6, 9]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [14, 15, 16, 13]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [22, 23, 24]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [6, 9]
  rs << rs[0].link!(rs[1])
  rs = [rs[0], rs[2], rs[3], rs[4], rs[5], rs[6]]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [17, 19, 20, 21, 18]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [6, 9]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [14, 15, 16, 13]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [22, 23, 24]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [6, 9]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [18, 17, 19, 20, 21]
  rs << rs[1].move(-7)
  assert_eq rs[6].value, 9
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [6, 9]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [14, 15, 16, 13]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [22, 23, 24]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [6, 9]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [18, 17, 19, 20, 21]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [9, 6]
}

test "vectors: sequence 7" {
  rs: [Ring[Int]] = []
  rs << fill(new(5, 0), [1, 2, 3, 4, 5])
  rs << fill(new(5, 0), [6, 7, 8, 9, 10])
  rs << rs[1].move(-6)
  assert_eq rs[2].value, 10
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [1, 2, 3, 4, 5]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [6, 7, 8, 9, 10]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [10, 6, 7, 8, 9]
  rs << rs[0].link!(rs[1])
  rs = [rs[0], rs[3]]
  assert_eq rs[0].len, 10
  assert_eq vals(rs[0]), [1, 6, 7, 8, 9, 10, 2, 3, 4, 5]
  assert_eq rs[1].len, 10
  assert_eq vals(rs[1]), [2, 3, 4, 5, 1, 6, 7, 8, 9, 10]
  rs << rs[1].link!(rs[0])
  assert_eq rs[0].len, 7
  assert_eq vals(rs[0]), [1, 6, 7, 8, 9, 10, 2]
  assert_eq rs[1].len, 7
  assert_eq vals(rs[1]), [2, 1, 6, 7, 8, 9, 10]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [3, 4, 5]
  rs << rs[0].link!(rs[1])
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 2]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [2, 1]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [3, 4, 5]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [6, 7, 8, 9, 10]
  rs << rs[1].move(7)
  assert_eq rs[4].value, 1
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 2]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [2, 1]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [3, 4, 5]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [6, 7, 8, 9, 10]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [1, 2]
  rs << fill(new(3, 0), [11, 12, 13])
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 2]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [2, 1]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [3, 4, 5]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [6, 7, 8, 9, 10]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [1, 2]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [11, 12, 13]
  rs << rs[2].move(-5)
  assert_eq rs[6].value, 4
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [2, 1]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [3, 4, 5]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [6, 7, 8, 9, 10]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [1, 2]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [11, 12, 13]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [4, 5, 3]
  rs << rs[3].unlink!(2).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [3, 4, 5]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [6, 7, 8, 9, 10]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [1, 2]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [11, 12, 13]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [4, 5, 3]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [2, 1]
  assert rs[3].unlink!(0).none?
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [3, 4, 5]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [6, 7, 8, 9, 10]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [1, 2]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [11, 12, 13]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [4, 5, 3]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [2, 1]
  rs << rs[0].move(3)
  assert_eq rs[6].value, 3
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [6, 7, 8, 9, 10]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [1, 2]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [11, 12, 13]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [4, 5, 3]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [2, 1]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [3, 4, 5]
  assert rs[5].unlink!(0).none?
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [6, 7, 8, 9, 10]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [1, 2]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [11, 12, 13]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [4, 5, 3]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [2, 1]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [3, 4, 5]
  rs << rs[0].move(0)
  assert_eq rs[6].value, 6
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 2]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [11, 12, 13]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [4, 5, 3]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [2, 1]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [3, 4, 5]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [6, 7, 8, 9, 10]
  rs << rs[5].move(0)
  assert_eq rs[6].value, 6
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [11, 12, 13]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [4, 5, 3]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [2, 1]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [3, 4, 5]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [6, 7, 8, 9, 10]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [6, 7, 8, 9, 10]
  rs << rs[2].move(3)
  assert_eq rs[6].value, 1
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [4, 5, 3]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [2, 1]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [3, 4, 5]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [6, 7, 8, 9, 10]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [6, 7, 8, 9, 10]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [1, 2]
  rs << rs[0].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [2, 1]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [3, 4]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [6, 7, 8, 9, 10]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [6, 7, 8, 9, 10]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [1, 2]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [5]
  rs << rs[5].unlink!(3).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [3, 4]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [6, 7, 8, 9, 10]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [6, 7, 8, 9, 10]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [1, 2]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [5]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [5]
  rs << rs[4].unlink!(3).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [6, 7, 8, 9, 10]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [6, 7, 8, 9, 10]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [1, 2]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [5]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [5]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [5]
  rs << rs[2].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [6, 7, 8, 9, 10]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [1]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [5]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [5]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [5]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [2]
  rs << rs[1].link!(rs[3])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 5]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [5, 1]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [5, 1]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [5, 1]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [2]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [1, 5]
  rs << fill(new(3, 0), [14, 15, 16])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [5, 1]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [5, 1]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [5, 1]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [2]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [1, 5]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [14, 15, 16]
  assert rs[1].unlink!(0).none?
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [5, 1]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [5, 1]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [5, 1]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [2]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [1, 5]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [14, 15, 16]
  rs << rs[1].move(7)
  assert_eq rs[6].value, 1
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [5, 1]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [5, 1]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [2]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [1, 5]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [14, 15, 16]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [1, 5]
  rs << fill(new(2, 0), [17, 18])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [5, 1]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [2]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [1, 5]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [14, 15, 16]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [1, 5]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [17, 18]
  rs << rs[5].link!(rs[4])
  rs = [rs[1], rs[3], rs[5], rs[6]]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [2]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [14, 15, 16]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [17, 1, 5, 18]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [18, 17, 1, 5]
  rs << rs[1].move(-5)
  assert_eq rs[4].value, 15
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [2]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [14, 15, 16]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [17, 1, 5, 18]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [18, 17, 1, 5]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [15, 16, 14]
  rs << rs[2].move(-7)
  assert_eq rs[5].value, 1
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [2]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [14, 15, 16]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [17, 1, 5, 18]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [18, 17, 1, 5]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [15, 16, 14]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [1, 5, 18, 17]
  rs << rs[2].link!(rs[4])
  rs = [rs[0], rs[2], rs[3], rs[5], rs[6]]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [2]
  assert_eq rs[1].len, 7
  assert_eq vals(rs[1]), [17, 15, 16, 14, 1, 5, 18]
  assert_eq rs[2].len, 7
  assert_eq vals(rs[2]), [18, 17, 15, 16, 14, 1, 5]
  assert_eq rs[3].len, 7
  assert_eq vals(rs[3]), [1, 5, 18, 17, 15, 16, 14]
  assert_eq rs[4].len, 7
  assert_eq vals(rs[4]), [1, 5, 18, 17, 15, 16, 14]
  rs << fill(new(4, 0), [19, 20, 21, 22])
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [2]
  assert_eq rs[1].len, 7
  assert_eq vals(rs[1]), [17, 15, 16, 14, 1, 5, 18]
  assert_eq rs[2].len, 7
  assert_eq vals(rs[2]), [18, 17, 15, 16, 14, 1, 5]
  assert_eq rs[3].len, 7
  assert_eq vals(rs[3]), [1, 5, 18, 17, 15, 16, 14]
  assert_eq rs[4].len, 7
  assert_eq vals(rs[4]), [1, 5, 18, 17, 15, 16, 14]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [19, 20, 21, 22]
  rs << rs[1].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 6
  assert_eq vals(rs[0]), [17, 16, 14, 1, 5, 18]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [18, 17, 16, 14, 1, 5]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [1, 5, 18, 17, 16, 14]
  assert_eq rs[3].len, 6
  assert_eq vals(rs[3]), [1, 5, 18, 17, 16, 14]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [19, 20, 21, 22]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [15]
  rs << rs[5].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 7
  assert_eq vals(rs[0]), [18, 17, 16, 14, 15, 1, 5]
  assert_eq rs[1].len, 7
  assert_eq vals(rs[1]), [1, 5, 18, 17, 16, 14, 15]
  assert_eq rs[2].len, 7
  assert_eq vals(rs[2]), [1, 5, 18, 17, 16, 14, 15]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [19, 20, 21, 22]
  assert_eq rs[4].len, 7
  assert_eq vals(rs[4]), [15, 1, 5, 18, 17, 16, 14]
  assert_eq rs[5].len, 7
  assert_eq vals(rs[5]), [15, 1, 5, 18, 17, 16, 14]
}
