# Generated from Go's container/ring (go1.27.1, scratch generator); do not edit by hand.
# Random link/unlink/move sequences over several rings; after each step
# every ring held must read like Go's. Sequences 0-3 make every ring in
# one pool; 4-7 make each ring in its own pool, so links across pools
# move elements (and the rings that pointed at the moved ones are dropped).

def vals(r: Ring[Int]) -> [Int] {
  out: [Int] = []
  r.do { |v| out << v }
  out
}

def fill(r0: Ring[Int]?, vs: [Int]) -> Ring[Int] {
  r = r0.unwrap
  for v in vs {
    r.set_value!(v)
    r = r.next
  }
  r
}

test "vectors: sequence 0" {
  base = Ring[Int].new
  rs: [Ring[Int]] = []
  rs << fill(base.new_ring(4, 0), [1, 2, 3, 4])
  rs << fill(base.new_ring(3, 0), [5, 6, 7])
  rs << rs[0].unlink!(4).unwrap
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [1, 2, 3, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 6, 7]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [2, 3, 4, 1]
  rs << rs[0].move(5)
  assert_eq rs[3].value, 2
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [1, 2, 3, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 6, 7]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [2, 3, 4, 1]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [2, 3, 4, 1]
  rs << rs[3].link!(rs[2])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 3, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 6, 7]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [2]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [2]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [3, 4, 1]
  rs << fill(base.new_ring(2, 0), [8, 9])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 3, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 6, 7]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [2]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [2]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [3, 4, 1]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [8, 9]
  rs << rs[0].move(1)
  assert_eq rs[6].value, 3
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [5, 6, 7]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [2]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [2]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [3, 4, 1]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [8, 9]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [3, 4, 1]
  rs << rs[2].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [2]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [2]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [3, 4, 1]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [8, 9]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [3, 4, 1]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [2]
  rs << rs[3].link!(rs[1])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [2, 9, 8]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [3, 4, 1]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [8, 2, 9]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [3, 4, 1]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [2, 9, 8]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [9, 8, 2]
  rs << rs[4].move(-6)
  assert_eq rs[6].value, 2
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [3, 4, 1]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [8, 2, 9]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [3, 4, 1]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [2, 9, 8]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [9, 8, 2]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [2, 9, 8]
  rs << rs[3].move(7)
  assert_eq rs[6].value, 9
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [8, 2, 9]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [3, 4, 1]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [2, 9, 8]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [9, 8, 2]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [2, 9, 8]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [9, 8, 2]
  rs << rs[4].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [3, 4, 1]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [2]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [9, 8]
  assert_eq rs[3].len, 1
