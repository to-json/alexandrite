  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [2]
  assert_eq rs[5].len, 8
  assert_eq vals(rs[5]), [4, 6, 3, 12, 13, 14, 10, 1]
  assert rs[1].unlink!(-1).none?
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [11]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [11]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [15, 16, 17]
  assert_eq rs[3].len, 8
  assert_eq vals(rs[3]), [10, 1, 4, 6, 3, 12, 13, 14]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [2]
  assert_eq rs[5].len, 8
  assert_eq vals(rs[5]), [4, 6, 3, 12, 13, 14, 10, 1]
  rs << rs[3].move(0)
  assert_eq rs[6].value, 10
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [11]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [15, 16, 17]
  assert_eq rs[2].len, 8
  assert_eq vals(rs[2]), [10, 1, 4, 6, 3, 12, 13, 14]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [2]
  assert_eq rs[4].len, 8
  assert_eq vals(rs[4]), [4, 6, 3, 12, 13, 14, 10, 1]
  assert_eq rs[5].len, 8
  assert_eq vals(rs[5]), [10, 1, 4, 6, 3, 12, 13, 14]
  rs << rs[1].unlink!(3).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [15, 16, 17]
  assert_eq rs[1].len, 8
  assert_eq vals(rs[1]), [10, 1, 4, 6, 3, 12, 13, 14]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [2]
  assert_eq rs[3].len, 8
  assert_eq vals(rs[3]), [4, 6, 3, 12, 13, 14, 10, 1]
  assert_eq rs[4].len, 8
  assert_eq vals(rs[4]), [10, 1, 4, 6, 3, 12, 13, 14]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [16, 17, 15]
  rs << rs[1].move(-2)
  assert_eq rs[6].value, 13
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 8
  assert_eq vals(rs[0]), [10, 1, 4, 6, 3, 12, 13, 14]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [2]
  assert_eq rs[2].len, 8
  assert_eq vals(rs[2]), [4, 6, 3, 12, 13, 14, 10, 1]
  assert_eq rs[3].len, 8
  assert_eq vals(rs[3]), [10, 1, 4, 6, 3, 12, 13, 14]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [16, 17, 15]
  assert_eq rs[5].len, 8
  assert_eq vals(rs[5]), [13, 14, 10, 1, 4, 6, 3, 12]
  rs << rs[0].move(4)
  assert_eq rs[6].value, 3
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [2]
  assert_eq rs[1].len, 8
  assert_eq vals(rs[1]), [4, 6, 3, 12, 13, 14, 10, 1]
  assert_eq rs[2].len, 8
  assert_eq vals(rs[2]), [10, 1, 4, 6, 3, 12, 13, 14]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [16, 17, 15]
  assert_eq rs[4].len, 8
  assert_eq vals(rs[4]), [13, 14, 10, 1, 4, 6, 3, 12]
  assert_eq rs[5].len, 8
  assert_eq vals(rs[5]), [3, 12, 13, 14, 10, 1, 4, 6]
  rs << fill(new(5, 0), [18, 19, 20, 21, 22])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 8
  assert_eq vals(rs[0]), [4, 6, 3, 12, 13, 14, 10, 1]
  assert_eq rs[1].len, 8
  assert_eq vals(rs[1]), [10, 1, 4, 6, 3, 12, 13, 14]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [16, 17, 15]
  assert_eq rs[3].len, 8
  assert_eq vals(rs[3]), [13, 14, 10, 1, 4, 6, 3, 12]
  assert_eq rs[4].len, 8
  assert_eq vals(rs[4]), [3, 12, 13, 14, 10, 1, 4, 6]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [18, 19, 20, 21, 22]
  rs << fill(new(4, 0), [23, 24, 25, 26])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 8
  assert_eq vals(rs[0]), [10, 1, 4, 6, 3, 12, 13, 14]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [16, 17, 15]
  assert_eq rs[2].len, 8
  assert_eq vals(rs[2]), [13, 14, 10, 1, 4, 6, 3, 12]
  assert_eq rs[3].len, 8
  assert_eq vals(rs[3]), [3, 12, 13, 14, 10, 1, 4, 6]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [18, 19, 20, 21, 22]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [23, 24, 25, 26]
  rs << rs[1].move(5)
  assert_eq rs[6].value, 15
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [16, 17, 15]
  assert_eq rs[1].len, 8
  assert_eq vals(rs[1]), [13, 14, 10, 1, 4, 6, 3, 12]
  assert_eq rs[2].len, 8
  assert_eq vals(rs[2]), [3, 12, 13, 14, 10, 1, 4, 6]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [18, 19, 20, 21, 22]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [23, 24, 25, 26]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [15, 16, 17]
}

test "vectors: sequence 5" {
  rs: [Ring[Int]] = []
  rs << fill(new(4, 0), [1, 2, 3, 4])
  rs << fill(new(2, 0), [5, 6])
  rs << rs[0].link!(rs[0])
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [1]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [5, 6]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [2, 3, 4]
  rs << rs[1].link!(rs[0])
  rs = [rs[1], rs[2], rs[3]]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [5, 1, 6]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [2, 3, 4]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [6, 5, 1]
  assert rs[1].unlink!(-1).none?
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [5, 1, 6]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [2, 3, 4]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [6, 5, 1]
  rs << fill(new(2, 0), [7, 8])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [5, 1, 6]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [2, 3, 4]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [6, 5, 1]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [7, 8]
  rs << rs[2].link!(rs[2])
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [5, 1]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [2, 3, 4]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [6]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [7, 8]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [5, 1]
  rs << rs[4].link!(rs[4])
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [5]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [2, 3, 4]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [6]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [7, 8]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [5]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [1]
  rs << fill(new(3, 0), [9, 10, 11])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [2, 3, 4]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [6]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [7, 8]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [5]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [1]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [9, 10, 11]
  rs << fill(new(3, 0), [12, 13, 14])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [6]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [7, 8]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [5]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [1]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [9, 10, 11]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [12, 13, 14]
  rs << rs[1].link!(rs[1])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [7]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [5]
  assert_eq rs[2].len, 1
