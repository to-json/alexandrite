  assert_eq rs[4].len, 6
  assert_eq vals(rs[4]), [3, 4, 2, 1, 9, 8]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [10, 11]
  rs << rs[4].move(1)
  assert_eq rs[6].value, 4
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 6
  assert_eq vals(rs[0]), [8, 3, 4, 2, 1, 9]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [9, 8, 3, 4, 2, 1]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [1, 9, 8, 3, 4, 2]
  assert_eq rs[3].len, 6
  assert_eq vals(rs[3]), [3, 4, 2, 1, 9, 8]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [10, 11]
  assert_eq rs[5].len, 6
  assert_eq vals(rs[5]), [4, 2, 1, 9, 8, 3]
  rs << rs[3].link!(rs[5])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 6
  assert_eq vals(rs[0]), [9, 8, 3, 4, 2, 1]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [1, 9, 8, 3, 4, 2]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [3, 4, 2, 1, 9, 8]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [10, 11]
  assert_eq rs[4].len, 6
  assert_eq vals(rs[4]), [4, 2, 1, 9, 8, 3]
  assert_eq rs[5].len, 6
  assert_eq vals(rs[5]), [4, 2, 1, 9, 8, 3]
  rs << rs[0].link!(rs[1])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 9]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [3, 4, 2, 8]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [10, 11]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [4, 2, 8, 3]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [4, 2, 8, 3]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [8, 3, 4, 2]
  rs << rs[3].move(7)
  assert_eq rs[6].value, 3
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [3, 4, 2, 8]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [10, 11]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [4, 2, 8, 3]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [4, 2, 8, 3]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [8, 3, 4, 2]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [3, 4, 2, 8]
  rs << fill(base.new_ring(3, 0), [12, 13, 14])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [10, 11]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [4, 2, 8, 3]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [4, 2, 8, 3]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [8, 3, 4, 2]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [3, 4, 2, 8]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [12, 13, 14]
  rs << rs[0].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 6
  assert_eq vals(rs[0]), [4, 2, 8, 3, 11, 10]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [4, 2, 8, 3, 11, 10]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [8, 3, 11, 10, 4, 2]
  assert_eq rs[3].len, 6
  assert_eq vals(rs[3]), [3, 11, 10, 4, 2, 8]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [12, 13, 14]
  assert_eq rs[5].len, 6
  assert_eq vals(rs[5]), [11, 10, 4, 2, 8, 3]
  rs << rs[0].move(4)
  assert_eq rs[6].value, 11
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 6
  assert_eq vals(rs[0]), [4, 2, 8, 3, 11, 10]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [8, 3, 11, 10, 4, 2]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [3, 11, 10, 4, 2, 8]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [12, 13, 14]
  assert_eq rs[4].len, 6
  assert_eq vals(rs[4]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[5].len, 6
  assert_eq vals(rs[5]), [11, 10, 4, 2, 8, 3]
  rs << rs[2].link!(rs[4])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 6
  assert_eq vals(rs[0]), [8, 3, 11, 10, 4, 2]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [3, 11, 10, 4, 2, 8]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [12, 13, 14]
  assert_eq rs[3].len, 6
  assert_eq vals(rs[3]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[4].len, 6
  assert_eq vals(rs[4]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[5].len, 6
  assert_eq vals(rs[5]), [11, 10, 4, 2, 8, 3]
  rs << fill(base.new_ring(3, 0), [15, 16, 17])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 6
  assert_eq vals(rs[0]), [3, 11, 10, 4, 2, 8]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [12, 13, 14]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[3].len, 6
  assert_eq vals(rs[3]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[4].len, 6
  assert_eq vals(rs[4]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [15, 16, 17]
  rs << fill(base.new_ring(5, 0), [18, 19, 20, 21, 22])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [12, 13, 14]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[3].len, 6
  assert_eq vals(rs[3]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [15, 16, 17]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [18, 19, 20, 21, 22]
  rs << fill(base.new_ring(1, 0), [23])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 6
  assert_eq vals(rs[0]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [11, 10, 4, 2, 8, 3]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [15, 16, 17]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [18, 19, 20, 21, 22]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [23]
}

test "vectors: sequence 1" {
  base = Ring[Int].new
  rs: [Ring[Int]] = []
  rs << fill(base.new_ring(1, 0), [1])
  rs << fill(base.new_ring(3, 0), [2, 3, 4])
  rs << rs[0].move(-5)
  assert_eq rs[2].value, 1
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [1]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [2, 3, 4]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [1]
  rs << rs[0].move(-7)
  assert_eq rs[3].value, 1
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [1]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [2, 3, 4]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [1]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [1]
  rs << rs[2].link!(rs[1])
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [1, 2, 3, 4]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [2, 3, 4, 1]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [1, 2, 3, 4]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [1, 2, 3, 4]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [1, 2, 3, 4]
  rs << rs[4].move(2)
  assert_eq rs[5].value, 3
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [1, 2, 3, 4]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [2, 3, 4, 1]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [1, 2, 3, 4]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [1, 2, 3, 4]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [1, 2, 3, 4]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [3, 4, 1, 2]
  rs << rs[3].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [2]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [1, 3, 4]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [1, 3, 4]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [1, 3, 4]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [3, 4, 1]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [2]
  rs << rs[3].move(0)
  assert_eq rs[6].value, 1
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 3, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [1, 3, 4]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [1, 3, 4]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [3, 4, 1]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [2]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [1, 3, 4]
  rs << rs[0].link!(rs[4])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [1, 2, 3, 4]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [1, 2, 3, 4]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [3, 4, 1, 2]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [2, 3, 4, 1]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [1, 2, 3, 4]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [3, 4, 1, 2]
  rs << rs[2].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 4]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [3]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [2, 4, 1]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [1, 2, 4]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [3]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [4, 1, 2]
  rs << rs[1].link!(rs[3])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [3, 1, 2, 4]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [2, 4, 3, 1]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [1, 2, 4, 3]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [3, 1, 2, 4]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [4, 3, 1, 2]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [3, 1, 2, 4]
  assert rs[0].unlink!(0).none?
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [3, 1, 2, 4]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [2, 4, 3, 1]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [1, 2, 4, 3]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [3, 1, 2, 4]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [4, 3, 1, 2]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [3, 1, 2, 4]
  rs << rs[3].move(7)
  assert_eq rs[6].value, 4
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [2, 4, 3, 1]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [1, 2, 4, 3]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [3, 1, 2, 4]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [4, 3, 1, 2]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [3, 1, 2, 4]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [4, 3, 1, 2]
  rs << fill(base.new_ring(4, 0), [5, 6, 7, 8])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [1, 2, 4, 3]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [3, 1, 2, 4]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [4, 3, 1, 2]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [3, 1, 2, 4]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [4, 3, 1, 2]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [5, 6, 7, 8]
  rs << rs[3].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [3, 4]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [4, 3]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [3, 4]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [4, 3]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [5, 6, 7, 8]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [1, 2]
  rs << fill(base.new_ring(5, 0), [9, 10, 11, 12, 13])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [4, 3]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [3, 4]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [4, 3]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [5, 6, 7, 8]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [1, 2]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [9, 10, 11, 12, 13]
  rs << rs[2].move(0)
  assert_eq rs[6].value, 4
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [3, 4]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [4, 3]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [5, 6, 7, 8]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [1, 2]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [9, 10, 11, 12, 13]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [4, 3]
  rs << rs[5].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [4]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [5, 6, 7, 8]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [1, 2]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [9, 10, 11, 12, 13]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [4]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [3]
  rs << rs[4].unlink!(2).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [5, 6, 7, 8]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [1, 2]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [9, 10, 11, 12, 13]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [4]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [3]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [4]
  rs << rs[5].link!(rs[5])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [1, 2]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [9, 10, 11, 12, 13]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [4]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [3]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [4]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [4]
  rs << fill(base.new_ring(2, 0), [14, 15])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [9, 10, 11, 12, 13]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [4]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [3]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [4]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [4]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [14, 15]
  rs << fill(base.new_ring(2, 0), [16, 17])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [4]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [3]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [4]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [4]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [14, 15]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [16, 17]
  rs << fill(base.new_ring(5, 0), [18, 19, 20, 21, 22])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [3]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [4]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [4]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [14, 15]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [16, 17]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [18, 19, 20, 21, 22]
  assert rs[1].unlink!(0).none?
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [3]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [4]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [4]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [14, 15]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [16, 17]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [18, 19, 20, 21, 22]
  rs << rs[4].unlink!(2).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [4]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [4]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [14, 15]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [16, 17]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [18, 19, 20, 21, 22]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [17, 16]
  assert rs[2].unlink!(-1).none?
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [4]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [4]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [14, 15]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [16, 17]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [18, 19, 20, 21, 22]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [17, 16]
  rs << rs[1].link!(rs[5])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [4, 17, 16]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [14, 15]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [16, 4, 17]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [18, 19, 20, 21, 22]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [17, 16, 4]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [4, 17, 16]
  rs << rs[1].link!(rs[1])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [14]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [16, 4, 17]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [18, 19, 20, 21, 22]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [17, 16, 4]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [4, 17, 16]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [15]
  rs << rs[3].link!(rs[0])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [16, 4, 17, 14]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [18, 19, 20, 21, 22]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [17, 14, 16, 4]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [4, 17, 14, 16]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [15]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [16, 4, 17, 14]
  rs << rs[0].move(2)
  assert_eq rs[6].value, 17
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [18, 19, 20, 21, 22]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [17, 14, 16, 4]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [4, 17, 14, 16]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [15]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [16, 4, 17, 14]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [17, 14, 16, 4]
  rs << fill(base.new_ring(5, 0), [23, 24, 25, 26, 27])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [17, 14, 16, 4]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [4, 17, 14, 16]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [15]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [16, 4, 17, 14]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [17, 14, 16, 4]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [23, 24, 25, 26, 27]
  rs << rs[5].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [4, 17, 14, 16]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [15]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [16, 4, 17, 14]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [17, 14, 16, 4]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [23, 25, 26, 27]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [24]
}

test "vectors: sequence 2" {
  base = Ring[Int].new
  rs: [Ring[Int]] = []
  rs << fill(base.new_ring(3, 0), [1, 2, 3])
  rs << fill(base.new_ring(5, 0), [4, 5, 6, 7, 8])
  assert rs[0].unlink!(0).none?
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [4, 5, 6, 7, 8]
  rs << rs[1].move(2)
  assert_eq rs[2].value, 6
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [4, 5, 6, 7, 8]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [6, 7, 8, 4, 5]
  rs << rs[1].unlink!(1).unwrap
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [4, 6, 7, 8]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [6, 7, 8, 4]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [5]
  rs << rs[3].link!(rs[3])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [4, 6, 7, 8]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [6, 7, 8, 4]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [5]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [5]
  rs << rs[1].link!(rs[4])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [4, 5, 6, 7, 8]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [6, 7, 8, 4, 5]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [5, 6, 7, 8, 4]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [5, 6, 7, 8, 4]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [6, 7, 8, 4, 5]
  rs << rs[2].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [4, 5, 7, 8]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [6]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [5, 7, 8, 4]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [5, 7, 8, 4]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [6]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [7, 8, 4, 5]
  rs << rs[5].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [6]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [5, 7]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [5, 7]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [6]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [7, 5]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [8, 4]
  rs << rs[2].link!(rs[4])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [5, 7]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [5, 7]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [6]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [7, 5]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [8, 4]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [7, 5]
  rs << fill(base.new_ring(5, 0), [9, 10, 11, 12, 13])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [5, 7]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [6]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [7, 5]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [8, 4]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [7, 5]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [9, 10, 11, 12, 13]
  rs << rs[5].move(6)
  assert_eq rs[6].value, 10
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [6]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [7, 5]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [8, 4]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [7, 5]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [9, 10, 11, 12, 13]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [10, 11, 12, 13, 9]
  rs << rs[2].link!(rs[0])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [7, 5]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [8, 6, 4]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [7, 5]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [9, 10, 11, 12, 13]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [10, 11, 12, 13, 9]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [4, 8, 6]
  rs << rs[3].move(-2)
  assert_eq rs[6].value, 12
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [8, 6, 4]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [7, 5]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [9, 10, 11, 12, 13]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [10, 11, 12, 13, 9]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [4, 8, 6]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [12, 13, 9, 10, 11]
  rs << rs[5].move(5)
  assert_eq rs[6].value, 12
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [7, 5]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [9, 10, 11, 12, 13]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [10, 11, 12, 13, 9]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [4, 8, 6]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [12, 13, 9, 10, 11]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [12, 13, 9, 10, 11]
  rs << rs[5].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [9, 13]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [10, 11, 12]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [4, 8, 6]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [12, 10, 11]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [12, 10, 11]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [13, 9]
  rs << rs[2].unlink!(4).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [10, 11, 12]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [4, 6]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [12, 10, 11]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [12, 10, 11]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [13, 9]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [8]
  rs << fill(base.new_ring(4, 0), [14, 15, 16, 17])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [4, 6]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [12, 10, 11]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [12, 10, 11]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [13, 9]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [8]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [14, 15, 16, 17]
  rs << fill(base.new_ring(1, 0), [18])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [12, 10, 11]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [12, 10, 11]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [13, 9]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [8]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [14, 15, 16, 17]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [18]
  assert rs[0].unlink!(-1).none?
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [12, 10, 11]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [12, 10, 11]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [13, 9]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [8]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [14, 15, 16, 17]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [18]
  rs << rs[3].move(4)
  assert_eq rs[6].value, 8
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [12, 10, 11]
  assert_eq rs[1].len, 2
  assert_eq vals(rs[1]), [13, 9]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [8]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [14, 15, 16, 17]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [18]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [8]
  rs << fill(base.new_ring(4, 0), [19, 20, 21, 22])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 2
  assert_eq vals(rs[0]), [13, 9]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [8]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [14, 15, 16, 17]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [18]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [8]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [19, 20, 21, 22]
  rs << fill(base.new_ring(1, 0), [23])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [8]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [14, 15, 16, 17]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [18]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [8]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [19, 20, 21, 22]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [23]
  rs << rs[2].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [14, 15, 16, 17]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [18]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [8]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [19, 20, 21, 22]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [23]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [18]
  rs << rs[0].link!(rs[1])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [18, 15, 16, 17, 14]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [8]
  assert_eq rs[2].len, 4
  assert_eq vals(rs[2]), [19, 20, 21, 22]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [23]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [18, 15, 16, 17, 14]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [15, 16, 17, 14, 18]
  rs << rs[0].link!(rs[5])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [8]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [19, 20, 21, 22]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [23]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [18, 15, 16, 17, 14]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [15, 16, 17, 14, 18]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [15, 16, 17, 14, 18]
  rs << rs[1].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [19, 23, 20, 21, 22]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [23, 20, 21, 22, 19]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [18, 15, 16, 17, 14]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [15, 16, 17, 14, 18]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [15, 16, 17, 14, 18]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [20, 21, 22, 19, 23]
  rs << rs[4].link!(rs[1])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 10
  assert_eq vals(rs[0]), [23, 20, 21, 22, 19, 16, 17, 14, 18, 15]
  assert_eq rs[1].len, 10
  assert_eq vals(rs[1]), [18, 15, 23, 20, 21, 22, 19, 16, 17, 14]
  assert_eq rs[2].len, 10
  assert_eq vals(rs[2]), [15, 23, 20, 21, 22, 19, 16, 17, 14, 18]
  assert_eq rs[3].len, 10
  assert_eq vals(rs[3]), [15, 23, 20, 21, 22, 19, 16, 17, 14, 18]
  assert_eq rs[4].len, 10
  assert_eq vals(rs[4]), [20, 21, 22, 19, 16, 17, 14, 18, 15, 23]
  assert_eq rs[5].len, 10
  assert_eq vals(rs[5]), [16, 17, 14, 18, 15, 23, 20, 21, 22, 19]
  rs << fill(base.new_ring(4, 0), [24, 25, 26, 27])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 10
  assert_eq vals(rs[0]), [18, 15, 23, 20, 21, 22, 19, 16, 17, 14]
  assert_eq rs[1].len, 10
  assert_eq vals(rs[1]), [15, 23, 20, 21, 22, 19, 16, 17, 14, 18]
  assert_eq rs[2].len, 10
  assert_eq vals(rs[2]), [15, 23, 20, 21, 22, 19, 16, 17, 14, 18]
  assert_eq rs[3].len, 10
  assert_eq vals(rs[3]), [20, 21, 22, 19, 16, 17, 14, 18, 15, 23]
  assert_eq rs[4].len, 10
  assert_eq vals(rs[4]), [16, 17, 14, 18, 15, 23, 20, 21, 22, 19]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [24, 25, 26, 27]
  rs << rs[2].move(6)
  assert_eq rs[6].value, 16
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 10
  assert_eq vals(rs[0]), [15, 23, 20, 21, 22, 19, 16, 17, 14, 18]
  assert_eq rs[1].len, 10
  assert_eq vals(rs[1]), [15, 23, 20, 21, 22, 19, 16, 17, 14, 18]
  assert_eq rs[2].len, 10
  assert_eq vals(rs[2]), [20, 21, 22, 19, 16, 17, 14, 18, 15, 23]
  assert_eq rs[3].len, 10
  assert_eq vals(rs[3]), [16, 17, 14, 18, 15, 23, 20, 21, 22, 19]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [24, 25, 26, 27]
  assert_eq rs[5].len, 10
  assert_eq vals(rs[5]), [16, 17, 14, 18, 15, 23, 20, 21, 22, 19]
  rs << rs[4].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 10
  assert_eq vals(rs[0]), [15, 23, 20, 21, 22, 19, 16, 17, 14, 18]
  assert_eq rs[1].len, 10
  assert_eq vals(rs[1]), [20, 21, 22, 19, 16, 17, 14, 18, 15, 23]
  assert_eq rs[2].len, 10
  assert_eq vals(rs[2]), [16, 17, 14, 18, 15, 23, 20, 21, 22, 19]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [24, 26, 27]
  assert_eq rs[4].len, 10
  assert_eq vals(rs[4]), [16, 17, 14, 18, 15, 23, 20, 21, 22, 19]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [25]
  rs << rs[2].link!(rs[3])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 13
  assert_eq vals(rs[0]), [20, 21, 22, 19, 16, 24, 26, 27, 17, 14, 18, 15, 23]
  assert_eq rs[1].len, 13
  assert_eq vals(rs[1]), [16, 24, 26, 27, 17, 14, 18, 15, 23, 20, 21, 22, 19]
  assert_eq rs[2].len, 13
  assert_eq vals(rs[2]), [24, 26, 27, 17, 14, 18, 15, 23, 20, 21, 22, 19, 16]
  assert_eq rs[3].len, 13
  assert_eq vals(rs[3]), [16, 24, 26, 27, 17, 14, 18, 15, 23, 20, 21, 22, 19]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [25]
  assert_eq rs[5].len, 13
  assert_eq vals(rs[5]), [17, 14, 18, 15, 23, 20, 21, 22, 19, 16, 24, 26, 27]
}

test "vectors: sequence 3" {
  base = Ring[Int].new
  rs: [Ring[Int]] = []
  rs << fill(base.new_ring(3, 0), [1, 2, 3])
  rs << fill(base.new_ring(4, 0), [4, 5, 6, 7])
  rs << fill(base.new_ring(3, 0), [8, 9, 10])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [4, 5, 6, 7]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [8, 9, 10]
  rs << rs[0].move(5)
  assert_eq rs[3].value, 3
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [4, 5, 6, 7]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [8, 9, 10]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [3, 1, 2]
  rs << fill(base.new_ring(3, 0), [11, 12, 13])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [4, 5, 6, 7]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [8, 9, 10]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [3, 1, 2]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [11, 12, 13]
  rs << fill(base.new_ring(1, 0), [14])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [4, 5, 6, 7]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [8, 9, 10]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [3, 1, 2]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [11, 12, 13]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [14]
  assert rs[1].unlink!(0).none?
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 4
  assert_eq vals(rs[1]), [4, 5, 6, 7]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [8, 9, 10]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [3, 1, 2]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [11, 12, 13]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [14]
  rs << rs[1].move(-1)
  assert_eq rs[6].value, 7
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 4
  assert_eq vals(rs[0]), [4, 5, 6, 7]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [8, 9, 10]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [3, 1, 2]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [11, 12, 13]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [14]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [7, 4, 5, 6]
  rs << rs[4].move(1)
  assert_eq rs[6].value, 14
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [8, 9, 10]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [3, 1, 2]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [11, 12, 13]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [14]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [7, 4, 5, 6]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [14]
  rs << rs[5].move(-7)
  assert_eq rs[6].value, 14
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [3, 1, 2]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [11, 12, 13]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [14]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [7, 4, 5, 6]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [14]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [14]
  rs << rs[3].link!(rs[2])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [11, 12, 13]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [14, 4, 5, 6, 7]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [7, 14, 4, 5, 6]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [14, 4, 5, 6, 7]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [14, 4, 5, 6, 7]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [4, 5, 6, 7, 14]
  rs << fill(base.new_ring(3, 0), [15, 16, 17])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [14, 4, 5, 6, 7]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [7, 14, 4, 5, 6]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [14, 4, 5, 6, 7]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [14, 4, 5, 6, 7]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [4, 5, 6, 7, 14]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [15, 16, 17]
  assert rs[2].unlink!(0).none?
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [14, 4, 5, 6, 7]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [7, 14, 4, 5, 6]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [14, 4, 5, 6, 7]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [14, 4, 5, 6, 7]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [4, 5, 6, 7, 14]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [15, 16, 17]
  rs << rs[4].link!(rs[1])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [7, 14, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [14, 4, 7]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [14, 4, 7]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [4, 7, 14]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [15, 16, 17]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [5, 6]
  rs << rs[5].link!(rs[1])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [14, 4, 7, 6, 5]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [14, 4, 7, 6, 5]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [4, 7, 6, 5, 14]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [15, 16, 17]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [5, 14, 4, 7, 6]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [6, 5, 14, 4, 7]
  rs << fill(base.new_ring(4, 0), [18, 19, 20, 21])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [14, 4, 7, 6, 5]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [4, 7, 6, 5, 14]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [15, 16, 17]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [5, 14, 4, 7, 6]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [6, 5, 14, 4, 7]
  assert_eq rs[5].len, 4
  assert_eq vals(rs[5]), [18, 19, 20, 21]
  rs << rs[3].move(6)
  assert_eq rs[6].value, 14
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [4, 7, 6, 5, 14]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [15, 16, 17]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [5, 14, 4, 7, 6]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [6, 5, 14, 4, 7]
  assert_eq rs[4].len, 4
  assert_eq vals(rs[4]), [18, 19, 20, 21]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [14, 4, 7, 6, 5]
  rs << fill(base.new_ring(1, 0), [22])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [15, 16, 17]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [5, 14, 4, 7, 6]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [6, 5, 14, 4, 7]
  assert_eq rs[3].len, 4
  assert_eq vals(rs[3]), [18, 19, 20, 21]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [14, 4, 7, 6, 5]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [22]
  rs << rs[3].link!(rs[4])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 9
  assert_eq vals(rs[0]), [5, 19, 20, 21, 18, 14, 4, 7, 6]
  assert_eq rs[1].len, 9
  assert_eq vals(rs[1]), [6, 5, 19, 20, 21, 18, 14, 4, 7]
  assert_eq rs[2].len, 9
  assert_eq vals(rs[2]), [18, 14, 4, 7, 6, 5, 19, 20, 21]
  assert_eq rs[3].len, 9
  assert_eq vals(rs[3]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [22]
  assert_eq rs[5].len, 9
  assert_eq vals(rs[5]), [19, 20, 21, 18, 14, 4, 7, 6, 5]
  rs << fill(base.new_ring(5, 0), [23, 24, 25, 26, 27])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 9
  assert_eq vals(rs[0]), [6, 5, 19, 20, 21, 18, 14, 4, 7]
  assert_eq rs[1].len, 9
  assert_eq vals(rs[1]), [18, 14, 4, 7, 6, 5, 19, 20, 21]
  assert_eq rs[2].len, 9
  assert_eq vals(rs[2]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [22]
  assert_eq rs[4].len, 9
  assert_eq vals(rs[4]), [19, 20, 21, 18, 14, 4, 7, 6, 5]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [23, 24, 25, 26, 27]
  rs << fill(base.new_ring(3, 0), [28, 29, 30])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 9
  assert_eq vals(rs[0]), [18, 14, 4, 7, 6, 5, 19, 20, 21]
  assert_eq rs[1].len, 9
  assert_eq vals(rs[1]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [22]
  assert_eq rs[3].len, 9
  assert_eq vals(rs[3]), [19, 20, 21, 18, 14, 4, 7, 6, 5]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [23, 24, 25, 26, 27]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [28, 29, 30]
  rs << rs[0].move(1)
  assert_eq rs[6].value, 14
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 9
  assert_eq vals(rs[0]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [22]
  assert_eq rs[2].len, 9
  assert_eq vals(rs[2]), [19, 20, 21, 18, 14, 4, 7, 6, 5]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [23, 24, 25, 26, 27]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [28, 29, 30]
  assert_eq rs[5].len, 9
  assert_eq vals(rs[5]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert rs[0].unlink!(-1).none?
  assert_eq rs[0].len, 9
  assert_eq vals(rs[0]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [22]
  assert_eq rs[2].len, 9
  assert_eq vals(rs[2]), [19, 20, 21, 18, 14, 4, 7, 6, 5]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [23, 24, 25, 26, 27]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [28, 29, 30]
  assert_eq rs[5].len, 9
  assert_eq vals(rs[5]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  rs << rs[4].unlink!(1).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [22]
  assert_eq rs[1].len, 9
  assert_eq vals(rs[1]), [19, 20, 21, 18, 14, 4, 7, 6, 5]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [23, 24, 25, 26, 27]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [28, 30]
  assert_eq rs[4].len, 9
  assert_eq vals(rs[4]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [29]
  rs << rs[3].move(3)
  assert_eq rs[6].value, 30
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 9
  assert_eq vals(rs[0]), [19, 20, 21, 18, 14, 4, 7, 6, 5]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [23, 24, 25, 26, 27]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [28, 30]
  assert_eq rs[3].len, 9
  assert_eq vals(rs[3]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [29]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [30, 28]
  rs << rs[1].link!(rs[5])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 7
  assert_eq vals(rs[0]), [23, 30, 28, 24, 25, 26, 27]
  assert_eq rs[1].len, 7
  assert_eq vals(rs[1]), [28, 24, 25, 26, 27, 23, 30]
  assert_eq rs[2].len, 9
  assert_eq vals(rs[2]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [29]
  assert_eq rs[4].len, 7
  assert_eq vals(rs[4]), [30, 28, 24, 25, 26, 27, 23]
  assert_eq rs[5].len, 7
  assert_eq vals(rs[5]), [24, 25, 26, 27, 23, 30, 28]
  rs << rs[0].move(-2)
  assert_eq rs[6].value, 26
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 7
  assert_eq vals(rs[0]), [28, 24, 25, 26, 27, 23, 30]
  assert_eq rs[1].len, 9
  assert_eq vals(rs[1]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [29]
  assert_eq rs[3].len, 7
  assert_eq vals(rs[3]), [30, 28, 24, 25, 26, 27, 23]
  assert_eq rs[4].len, 7
  assert_eq vals(rs[4]), [24, 25, 26, 27, 23, 30, 28]
  assert_eq rs[5].len, 7
  assert_eq vals(rs[5]), [26, 27, 23, 30, 28, 24, 25]
  rs << rs[4].move(-5)
  assert_eq rs[6].value, 26
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 9
  assert_eq vals(rs[0]), [14, 4, 7, 6, 5, 19, 20, 21, 18]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [29]
  assert_eq rs[2].len, 7
  assert_eq vals(rs[2]), [30, 28, 24, 25, 26, 27, 23]
  assert_eq rs[3].len, 7
  assert_eq vals(rs[3]), [24, 25, 26, 27, 23, 30, 28]
  assert_eq rs[4].len, 7
  assert_eq vals(rs[4]), [26, 27, 23, 30, 28, 24, 25]
  assert_eq rs[5].len, 7
  assert_eq vals(rs[5]), [26, 27, 23, 30, 28, 24, 25]
  rs << rs[1].unlink!(4).unwrap
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [29]
  assert_eq rs[1].len, 7
  assert_eq vals(rs[1]), [30, 28, 24, 25, 26, 27, 23]
  assert_eq rs[2].len, 7
  assert_eq vals(rs[2]), [24, 25, 26, 27, 23, 30, 28]
  assert_eq rs[3].len, 7
  assert_eq vals(rs[3]), [26, 27, 23, 30, 28, 24, 25]
  assert_eq rs[4].len, 7
  assert_eq vals(rs[4]), [26, 27, 23, 30, 28, 24, 25]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [29]
  rs << rs[3].link!(rs[1])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [30, 28, 24, 25, 26]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [24, 25, 26, 30, 28]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [26, 30, 28, 24, 25]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [26, 30, 28, 24, 25]
  assert_eq rs[4].len, 1
  assert_eq vals(rs[4]), [29]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [27, 23]
  rs << rs[3].move(2)
  assert_eq rs[6].value, 28
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [24, 25, 26, 30, 28]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [26, 30, 28, 24, 25]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [26, 30, 28, 24, 25]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [29]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [27, 23]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [28, 24, 25, 26, 30]
  rs << rs[1].move(3)
  assert_eq rs[6].value, 24
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [26, 30, 28, 24, 25]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [26, 30, 28, 24, 25]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [29]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [27, 23]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [28, 24, 25, 26, 30]
  assert_eq rs[5].len, 5
  assert_eq vals(rs[5]), [24, 25, 26, 30, 28]
}

test "vectors: sequence 4" {
  rs: [Ring[Int]] = []
  rs << fill(new(3, 0), [1, 2, 3])
  rs << fill(new(1, 0), [4])
  rs << fill(new(5, 0), [5, 6, 7, 8, 9])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [4]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [5, 6, 7, 8, 9]
  rs << rs[2].link!(rs[1])
  rs = [rs[0], rs[2], rs[3]]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [5, 4, 6, 7, 8, 9]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [6, 7, 8, 9, 5, 4]
  rs << rs[1].move(-2)
  assert_eq rs[3].value, 8
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 6
  assert_eq vals(rs[1]), [5, 4, 6, 7, 8, 9]
  assert_eq rs[2].len, 6
  assert_eq vals(rs[2]), [6, 7, 8, 9, 5, 4]
  assert_eq rs[3].len, 6
  assert_eq vals(rs[3]), [8, 9, 5, 4, 6, 7]
  rs << rs[2].link!(rs[1])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 4, 6]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [6, 5, 4]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [8, 9, 7]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [7, 8, 9]
  rs << rs[0].move(5)
  assert_eq rs[5].value, 3
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [1, 2, 3]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [5, 4, 6]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [6, 5, 4]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [8, 9, 7]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [7, 8, 9]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [3, 1, 2]
  rs << rs[0].move(4)
  assert_eq rs[6].value, 2
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [5, 4, 6]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [6, 5, 4]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [8, 9, 7]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [7, 8, 9]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [3, 1, 2]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [2, 3, 1]
  rs << rs[1].move(-4)
  assert_eq rs[6].value, 4
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [6, 5, 4]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [8, 9, 7]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [7, 8, 9]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [3, 1, 2]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [2, 3, 1]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [4, 6, 5]
  rs << rs[5].move(-5)
  assert_eq rs[6].value, 6
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [8, 9, 7]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [7, 8, 9]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [3, 1, 2]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [2, 3, 1]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [4, 6, 5]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [6, 5, 4]
  rs << rs[5].link!(rs[4])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [7, 8, 9]
  assert_eq rs[1].len, 3
  assert_eq vals(rs[1]), [3, 1, 2]
  assert_eq rs[2].len, 3
  assert_eq vals(rs[2]), [2, 3, 1]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [4, 6]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [6, 4]
  assert_eq rs[5].len, 1
  assert_eq vals(rs[5]), [5]
  rs << rs[2].link!(rs[3])
  rs = [rs[0], rs[1], rs[2], rs[5], rs[6]]
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [7, 8, 9]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [3, 1, 2, 4, 6]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [2, 4, 6, 3, 1]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [5]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [3, 1, 2, 4, 6]
  rs << fill(new(2, 0), [10, 11])
  assert_eq rs[0].len, 3
  assert_eq vals(rs[0]), [7, 8, 9]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [3, 1, 2, 4, 6]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [2, 4, 6, 3, 1]
  assert_eq rs[3].len, 1
  assert_eq vals(rs[3]), [5]
  assert_eq rs[4].len, 5
  assert_eq vals(rs[4]), [3, 1, 2, 4, 6]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [10, 11]
  rs << fill(new(3, 0), [12, 13, 14])
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [3, 1, 2, 4, 6]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [2, 4, 6, 3, 1]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [5]
  assert_eq rs[3].len, 5
  assert_eq vals(rs[3]), [3, 1, 2, 4, 6]
  assert_eq rs[4].len, 2
  assert_eq vals(rs[4]), [10, 11]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [12, 13, 14]
  rs << rs[5].move(-6)
  assert_eq rs[6].value, 12
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 5
  assert_eq vals(rs[0]), [2, 4, 6, 3, 1]
  assert_eq rs[1].len, 1
  assert_eq vals(rs[1]), [5]
  assert_eq rs[2].len, 5
  assert_eq vals(rs[2]), [3, 1, 2, 4, 6]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [10, 11]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [12, 13, 14]
  assert_eq rs[5].len, 3
  assert_eq vals(rs[5]), [12, 13, 14]
  rs << rs[3].move(-7)
  assert_eq rs[6].value, 11
  rs = rs[rs.size - 6...rs.size]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [5]
  assert_eq rs[1].len, 5
  assert_eq vals(rs[1]), [3, 1, 2, 4, 6]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [10, 11]
  assert_eq rs[3].len, 3
  assert_eq vals(rs[3]), [12, 13, 14]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [12, 13, 14]
  assert_eq rs[5].len, 2
  assert_eq vals(rs[5]), [11, 10]
  rs << rs[1].link!(rs[4])
  rs = [rs[0], rs[1], rs[2], rs[5], rs[6]]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [5]
  assert_eq rs[1].len, 8
  assert_eq vals(rs[1]), [3, 12, 13, 14, 1, 2, 4, 6]
  assert_eq rs[2].len, 2
  assert_eq vals(rs[2]), [10, 11]
  assert_eq rs[3].len, 2
  assert_eq vals(rs[3]), [11, 10]
  assert_eq rs[4].len, 8
  assert_eq vals(rs[4]), [1, 2, 4, 6, 3, 12, 13, 14]
  rs << rs[2].link!(rs[4])
  rs = [rs[0], rs[2], rs[3], rs[5]]
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [5]
  assert_eq rs[1].len, 10
  assert_eq vals(rs[1]), [10, 1, 2, 4, 6, 3, 12, 13, 14, 11]
  assert_eq rs[2].len, 10
  assert_eq vals(rs[2]), [11, 10, 1, 2, 4, 6, 3, 12, 13, 14]
  assert_eq rs[3].len, 10
  assert_eq vals(rs[3]), [11, 10, 1, 2, 4, 6, 3, 12, 13, 14]
  assert rs[0].unlink!(0).none?
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [5]
  assert_eq rs[1].len, 10
  assert_eq vals(rs[1]), [10, 1, 2, 4, 6, 3, 12, 13, 14, 11]
  assert_eq rs[2].len, 10
  assert_eq vals(rs[2]), [11, 10, 1, 2, 4, 6, 3, 12, 13, 14]
  assert_eq rs[3].len, 10
  assert_eq vals(rs[3]), [11, 10, 1, 2, 4, 6, 3, 12, 13, 14]
  rs << fill(new(3, 0), [15, 16, 17])
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [5]
  assert_eq rs[1].len, 10
  assert_eq vals(rs[1]), [10, 1, 2, 4, 6, 3, 12, 13, 14, 11]
  assert_eq rs[2].len, 10
  assert_eq vals(rs[2]), [11, 10, 1, 2, 4, 6, 3, 12, 13, 14]
  assert_eq rs[3].len, 10
  assert_eq vals(rs[3]), [11, 10, 1, 2, 4, 6, 3, 12, 13, 14]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [15, 16, 17]
  assert rs[3].unlink!(0).none?
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [5]
  assert_eq rs[1].len, 10
  assert_eq vals(rs[1]), [10, 1, 2, 4, 6, 3, 12, 13, 14, 11]
  assert_eq rs[2].len, 10
  assert_eq vals(rs[2]), [11, 10, 1, 2, 4, 6, 3, 12, 13, 14]
  assert_eq rs[3].len, 10
  assert_eq vals(rs[3]), [11, 10, 1, 2, 4, 6, 3, 12, 13, 14]
  assert_eq rs[4].len, 3
  assert_eq vals(rs[4]), [15, 16, 17]
  rs << rs[3].link!(rs[2])
  assert_eq rs[0].len, 1
  assert_eq vals(rs[0]), [5]
  assert_eq rs[1].len, 9
  assert_eq vals(rs[1]), [10, 1, 2, 4, 6, 3, 12, 13, 14]
  assert_eq rs[2].len, 1
  assert_eq vals(rs[2]), [11]
