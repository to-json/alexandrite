test "tree 7" {
  c0 = background
  c1, _g1 = with_cancel_cause(c0)
  c2 = with_value(c0, "k0", "v2")
  c3 = with_value(c2, "k1", "v3")
  c4, _g4 = with_cancel_cause(c3)
  c5 = without_cancel(c4)
  assert_eq "#{c0}", "context.Background"
  assert_eq vec_val(c0, "k0"), ""
  assert_eq vec_val(c0, "k1"), ""
  assert_eq "#{c1}", "context.Background.WithCancel"
  assert_eq vec_val(c1, "k0"), ""
  assert_eq vec_val(c1, "k1"), ""
  assert_eq "#{c2}", "context.Background.WithValue(k0, v2)"
  assert_eq vec_val(c2, "k0"), "v2"
  assert_eq vec_val(c2, "k1"), ""
  assert_eq "#{c3}", "context.Background.WithValue(k0, v2).WithValue(k1, v3)"
  assert_eq vec_val(c3, "k0"), "v2"
  assert_eq vec_val(c3, "k1"), "v3"
  assert_eq "#{c4}", "context.Background.WithValue(k0, v2).WithValue(k1, v3).WithCancel"
  assert_eq vec_val(c4, "k0"), "v2"
  assert_eq vec_val(c4, "k1"), "v3"
  assert_eq "#{c5}", "context.Background.WithValue(k0, v2).WithValue(k1, v3).WithCancel.WithoutCancel"
  assert_eq vec_val(c5, "k0"), "v2"
  assert_eq vec_val(c5, "k1"), "v3"
  assert_eq vec_err(c0.err), "none"
  assert_eq vec_err(cause(c0)), "none"
  assert_eq vec_err(c1.err), "none"
  assert_eq vec_err(cause(c1)), "none"
  assert_eq vec_err(c2.err), "none"
  assert_eq vec_err(cause(c2)), "none"
  assert_eq vec_err(c3.err), "none"
  assert_eq vec_err(cause(c3)), "none"
  assert_eq vec_err(c4.err), "none"
  assert_eq vec_err(cause(c4)), "none"
  assert_eq vec_err(c5.err), "none"
  assert_eq vec_err(cause(c5)), "none"
}

