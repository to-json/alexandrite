  c8 = with_value(c7, "k2", "v8")
  assert_eq "#{c0}", "context.TODO"
  assert_eq vec_val(c0, "k2"), ""
  assert_eq "#{c1}", "context.TODO.WithCancel"
  assert_eq vec_val(c1, "k2"), ""
  assert_eq "#{c2}", "context.TODO.WithCancel.WithCancel"
  assert_eq vec_val(c2, "k2"), ""
