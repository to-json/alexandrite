# Generated from Go's context (random trees of derived contexts: String,
# Value, Err and Cause after random cancels; .scratch/genctx); do not edit by hand.

import "errors"
import "time"

def vec_err(e: Error?) -> Str {
  if x = e {
    return "#{x}"
  }
  "none"
}

def vec_val(c: Context, k: Str) -> Str {
  v: Str? = value(c, k)
  v || ""
}

test "tree 0" {
  c0 = todo
  c1, _f1 = with_timeout(c0, time.hour * 1000)
  c2, _f2 = with_cancel(c1)
  c3, _f3 = with_timeout(c2, time.hour * 1000)
  c4 = with_value(c3, "k2", "v4")
  c5, _f5 = with_cancel(c4)
  c6 = with_value(c4, "k0", "v6")
  c7, _g7 = with_cancel_cause(c6)
  c8, _f8 = with_timeout_cause(c7, time.duration(-1000000000), errors.new("late 8"))
  c9, _g9 = with_cancel_cause(c8)
  c10 = without_cancel(c9)
  assert_eq "#{c0}", "context.TODO"
  assert_eq vec_val(c0, "k0"), ""
  assert_eq vec_val(c0, "k2"), ""
  assert_eq vec_val(c1, "k0"), ""
  assert_eq vec_val(c1, "k2"), ""
  assert_eq vec_val(c2, "k0"), ""
  assert_eq vec_val(c2, "k2"), ""
  assert_eq vec_val(c3, "k0"), ""
  assert_eq vec_val(c3, "k2"), ""
  assert_eq vec_val(c4, "k0"), ""
  assert_eq vec_val(c4, "k2"), "v4"
  assert_eq vec_val(c5, "k0"), ""
  assert_eq vec_val(c5, "k2"), "v4"
  assert_eq vec_val(c6, "k0"), "v6"
  assert_eq vec_val(c6, "k2"), "v4"
  assert_eq vec_val(c7, "k0"), "v6"
  assert_eq vec_val(c7, "k2"), "v4"
  assert_eq vec_val(c8, "k0"), "v6"
  assert_eq vec_val(c8, "k2"), "v4"
  assert_eq vec_val(c9, "k0"), "v6"
  assert_eq vec_val(c9, "k2"), "v4"
  assert_eq vec_val(c10, "k0"), "v6"
  assert_eq vec_val(c10, "k2"), "v4"
  assert_eq vec_err(c0.err), "none"
  assert_eq vec_err(cause(c0)), "none"
  assert_eq vec_err(c1.err), "none"
  assert_eq vec_err(cause(c1)), "none"
  assert_eq vec_err(c2.err), "none"
  assert_eq vec_err(cause(c2)), "none"
  assert_eq vec_err(c3.err), "none"
  assert_eq vec_err(cause(c3)), "none"
  assert_eq vec_err(c4.err), "none"
  assert_eq vec_err(cause(c4)), "none"
  assert_eq vec_err(c5.err), "none"
  assert_eq vec_err(cause(c5)), "none"
  assert_eq vec_err(c6.err), "none"
  assert_eq vec_err(cause(c6)), "none"
  assert_eq vec_err(c7.err), "none"
  assert_eq vec_err(cause(c7)), "none"
  assert_eq vec_err(c8.err), "context deadline exceeded"
  assert_eq vec_err(cause(c8)), "late 8"
  assert_eq vec_err(c9.err), "context deadline exceeded"
  assert_eq vec_err(cause(c9)), "late 8"
  assert_eq vec_err(c10.err), "none"
  assert_eq vec_err(cause(c10)), "none"
}

