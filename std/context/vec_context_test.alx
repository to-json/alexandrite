  assert_eq vec_val(c3, "k2"), ""
  assert_eq "#{c4}", "context.TODO.WithCancel.WithCancel.WithoutCancel.WithCancel"
  assert_eq vec_val(c4, "k2"), ""
  assert_eq "#{c5}", "context.TODO.WithCancel.WithCancel.WithoutCancel.WithCancel.WithCancel"
  assert_eq vec_val(c5, "k2"), ""
  assert_eq "#{c6}", "context.TODO.WithCancel.WithCancel.WithoutCancel.WithCancel.WithCancel.WithCancel"
  assert_eq vec_val(c6, "k2"), ""
  assert_eq vec_val(c7, "k2"), ""
  assert_eq vec_val(c8, "k2"), "v8"
  assert_eq vec_err(c0.err), "none"
  assert_eq vec_err(cause(c0)), "none"
  assert_eq vec_err(c1.err), "none"
  assert_eq vec_err(cause(c1)), "none"
  assert_eq vec_err(c2.err), "none"
  assert_eq vec_err(cause(c2)), "none"
  assert_eq vec_err(c3.err), "none"
  assert_eq vec_err(cause(c3)), "none"
  assert_eq vec_err(c4.err), "none"
  assert_eq vec_err(cause(c4)), "none"
  assert_eq vec_err(c5.err), "none"
  assert_eq vec_err(cause(c5)), "none"
  assert_eq vec_err(c6.err), "none"
  assert_eq vec_err(cause(c6)), "none"
  assert_eq vec_err(c7.err), "context deadline exceeded"
  assert_eq vec_err(cause(c7)), "late 7"
  assert_eq vec_err(c8.err), "context deadline exceeded"
  assert_eq vec_err(cause(c8)), "late 7"
  _g5(errors.new("cause 5"))
  assert_eq vec_err(c0.err), "none"
  assert_eq vec_err(cause(c0)), "none"
  assert_eq vec_err(c1.err), "none"
  assert_eq vec_err(cause(c1)), "none"
  assert_eq vec_err(c2.err), "none"
  assert_eq vec_err(cause(c2)), "none"
  assert_eq vec_err(c3.err), "none"
  assert_eq vec_err(cause(c3)), "none"
  assert_eq vec_err(c4.err), "none"
  assert_eq vec_err(cause(c4)), "none"
  assert_eq vec_err(c5.err), "context canceled"
  assert_eq vec_err(cause(c5)), "cause 5"
  assert_eq vec_err(c6.err), "context canceled"
  assert_eq vec_err(cause(c6)), "cause 5"
  assert_eq vec_err(c7.err), "context deadline exceeded"
  assert_eq vec_err(cause(c7)), "late 7"
  assert_eq vec_err(c8.err), "context deadline exceeded"
  assert_eq vec_err(cause(c8)), "late 7"
}

test "tree 58" {
  c0 = todo
