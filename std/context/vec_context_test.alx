  assert_eq "#{c1}", "context.TODO.WithValue(k3, v1)"
  assert_eq vec_val(c1, "k3"), "v1"
  assert_eq vec_val(c1, "k4"), ""
  assert_eq "#{c2}", "context.TODO.WithValue(k3, v1).WithValue(k4, v2)"
  assert_eq vec_val(c2, "k3"), "v1"
  assert_eq vec_val(c2, "k4"), "v2"
  assert_eq "#{c3}", "context.TODO.WithValue(k3, v1).WithValue(k4, v2).WithCancel"
  assert_eq vec_val(c3, "k3"), "v1"
  assert_eq vec_val(c3, "k4"), "v2"
  assert_eq "#{c4}", "context.TODO.WithValue(k3, v1).WithCancel"
  assert_eq vec_val(c4, "k3"), "v1"
  assert_eq vec_val(c4, "k4"), ""
  assert_eq vec_err(c0.err), "none"
  assert_eq vec_err(cause(c0)), "none"
  assert_eq vec_err(c1.err), "none"
