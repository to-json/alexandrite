test "tree 4" {
  c0 = background
  c1 = with_value(c0, "k3", "v1")
  c2 = with_value(c1, "k2", "v2")
  c3, _f3 = with_cancel(c2)
  assert_eq "#{c0}", "context.Background"
  assert_eq vec_val(c0, "k2"), ""
  assert_eq vec_val(c0, "k3"), ""
  assert_eq "#{c1}", "context.Background.WithValue(k3, v1)"
  assert_eq vec_val(c1, "k2"), ""
  assert_eq vec_val(c1, "k3"), "v1"
  assert_eq "#{c2}", "context.Background.WithValue(k3, v1).WithValue(k2, v2)"
  assert_eq vec_val(c2, "k2"), "v2"
  assert_eq vec_val(c2, "k3"), "v1"
  assert_eq "#{c3}", "context.Background.WithValue(k3, v1).WithValue(k2, v2).WithCancel"
  assert_eq vec_val(c3, "k2"), "v2"
  assert_eq vec_val(c3, "k3"), "v1"
  assert_eq vec_err(c0.err), "none"
  assert_eq vec_err(cause(c0)), "none"
  assert_eq vec_err(c1.err), "none"
  assert_eq vec_err(cause(c1)), "none"
  assert_eq vec_err(c2.err), "none"
  assert_eq vec_err(cause(c2)), "none"
  assert_eq vec_err(c3.err), "none"
  assert_eq vec_err(cause(c3)), "none"
  _f3()
  assert_eq vec_err(c0.err), "none"
  assert_eq vec_err(cause(c0)), "none"
  assert_eq vec_err(c1.err), "none"
  assert_eq vec_err(cause(c1)), "none"
  assert_eq vec_err(c2.err), "none"
  assert_eq vec_err(cause(c2)), "none"
  assert_eq vec_err(c3.err), "context canceled"
  assert_eq vec_err(cause(c3)), "context canceled"
}

