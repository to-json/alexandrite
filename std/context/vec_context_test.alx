test "tree 59" {
  c0 = background
  c1 = without_cancel(c0)
  c2, _g2 = with_cancel_cause(c0)
  c3 = without_cancel(c2)
  c4 = without_cancel(c3)
  c5 = with_value(c4, "k0", "v5")
  c6 = with_value(c5, "k1", "v6")
  c7 = with_value(c6, "k1", "v7")
  assert_eq "#{c0}", "context.Background"
  assert_eq vec_val(c0, "k0"), ""
  assert_eq vec_val(c0, "k1"), ""
  assert_eq "#{c1}", "context.Background.WithoutCancel"
  assert_eq vec_val(c1, "k0"), ""
  assert_eq vec_val(c1, "k1"), ""
  assert_eq "#{c2}", "context.Background.WithCancel"
  assert_eq vec_val(c2, "k0"), ""
  assert_eq vec_val(c2, "k1"), ""
  assert_eq "#{c3}", "context.Background.WithCancel.WithoutCancel"
  assert_eq vec_val(c3, "k0"), ""
  assert_eq vec_val(c3, "k1"), ""
  assert_eq "#{c4}", "context.Background.WithCancel.WithoutCancel.WithoutCancel"
  assert_eq vec_val(c4, "k0"), ""
  assert_eq vec_val(c4, "k1"), ""
  assert_eq "#{c5}", "context.Background.WithCancel.WithoutCancel.WithoutCancel.WithValue(k0, v5)"
  assert_eq vec_val(c5, "k0"), "v5"
  assert_eq vec_val(c5, "k1"), ""
  assert_eq "#{c6}", "context.Background.WithCancel.WithoutCancel.WithoutCancel.WithValue(k0, v5).WithValue(k1, v6)"
  assert_eq vec_val(c6, "k0"), "v5"
  assert_eq vec_val(c6, "k1"), "v6"
  assert_eq "#{c7}", "context.Background.WithCancel.WithoutCancel.WithoutCancel.WithValue(k0, v5).WithValue(k1, v6).WithValue(k1, v7)"
  assert_eq vec_val(c7, "k0"), "v5"
  assert_eq vec_val(c7, "k1"), "v7"
  assert_eq vec_err(c0.err), "none"
  assert_eq vec_err(cause(c0)), "none"
  assert_eq vec_err(c1.err), "none"
  assert_eq vec_err(cause(c1)), "none"
  assert_eq vec_err(c2.err), "none"
  assert_eq vec_err(cause(c2)), "none"
  assert_eq vec_err(c3.err), "none"
  assert_eq vec_err(cause(c3)), "none"
  assert_eq vec_err(c4.err), "none"
  assert_eq vec_err(cause(c4)), "none"
  assert_eq vec_err(c5.err), "none"
  assert_eq vec_err(cause(c5)), "none"
  assert_eq vec_err(c6.err), "none"
  assert_eq vec_err(cause(c6)), "none"
  assert_eq vec_err(c7.err), "none"
  assert_eq vec_err(cause(c7)), "none"
}
