import "encoding/hex"

# Go's crypto/aes aes_test.go and crypto/internal/fips140/aes aes_test.go,
# translated. cryptotest.TestAllImplementations runs each test once per
# implementation (assembly, generic); alx has one. cryptotest.TestBlock is
# check_block below (block_test.alx).
#
# Not translated: TestExtraMethods (reflection over the method set);
# cryptotest's BufferOverlap and ShortBlock subtests (they expect panics,
# which an alx test can't catch; ShortBlock's panics are in Block.encrypt).

def h(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

struct CryptTest {
  key: [Byte]
  input: [Byte]
  out: [Byte]
}

# FIPS 197 Appendix B, C: cipher examples.
def encrypt_tests -> [CryptTest] {
  [
    # Appendix B.
    CryptTest.new(key: h("2b7e151628aed2a6abf7158809cf4f3c"), input: h("3243f6a8885a308d313198a2e0370734"), out: h("3925841d02dc09fbdc118597196a0b32")),
    # Appendix C.1. AES-128
    CryptTest.new(key: h("000102030405060708090a0b0c0d0e0f"), input: h("00112233445566778899aabbccddeeff"), out: h("69c4e0d86a7b0430d8cdb78070b4c55a")),
    # Appendix C.2. AES-192
    CryptTest.new(key: h("000102030405060708090a0b0c0d0e0f1011121314151617"), input: h("00112233445566778899aabbccddeeff"), out: h("dda97ca4864cdfe06eaf70a0ec0d7191")),
    # Appendix C.3. AES-256
    CryptTest.new(key: h("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), input: h("00112233445566778899aabbccddeeff"), out: h("8ea2b7ca516745bfeafc49904b496089")),
  ]
}

test "cipher encrypt" {
  for tt in encrypt_tests() {
    c = new_cipher(tt.key).unwrap
    out = [0.as_u8; tt.input.size]
    c.encrypt(out, tt.input)
    assert_eq out, tt.out
  }
}

test "cipher decrypt" {
  for tt in encrypt_tests() {
    c = new_cipher(tt.key).unwrap
    plain = [0.as_u8; tt.input.size]
    c.decrypt(plain, tt.out)
    assert_eq plain, tt.input
  }
}

test "aes block" {
  for keylen in [128, 192, 256] {
    check_block(keylen / 8, ->(key: [Byte]) -> Block { new_cipher(key).unwrap })
  }
}

test "key size error" {
  for n in [0, 1, 15, 17, 23, 25, 31, 33, 64] {
    r = new_cipher([0.as_u8; n])
    assert r.err?, "size #{n} accepted"
    assert_eq r.err.unwrap.message, "crypto/aes: invalid key size #{n}"
  }
}

# crypto/internal/fips140/aes aes_test.go: the tables are what they claim.

test "powx" {
  p = 1
  i = 0
  while i < POWX.size {
    assert_eq POWX[i].to_i, p
    p <<= 1
    p ^= POLY if p & 0x100 != 0
    i += 1
  }
}

POLY = (1 << 8) | (1 << 4) | (1 << 3) | (1 << 1) | 1

# Multiplies b and c as GF(2) polynomials modulo POLY.
def mul(b0: U32, c0: U32) -> U32 {
  b = b0
  c = c0
  i = b
  j = c
  s: U32 = 0
  k: U32 = 1
  while k < 0x100 && j != 0 {
    # Invariant: k == 1<<n, i == b * x^n
    if j & k != 0 {
      # s += i in GF(2); xor in binary
      s ^= i
      j ^= k
    }
    # Make i = b * x^(n+1) mod poly
    i <<= 1
    i ^= POLY.as_u32 if i & 0x100 != 0
    k <<= 1
  }
  s
}

test "mul" {
  i: U32 = 0
  while i < 256 {
    j: U32 = 0
    while j < 256 {
      # Multiply i, j bit by bit.
      s: U32 = 0
      k: U32 = 0
      while k < 8 {
        l: U32 = 0
        while l < 8 {
          if i & (1.as_u32 << k) != 0 && j & (1.as_u32 << l) != 0 {
            s ^= POWX[(k + l).to_i].as_u32
          }
          l += 1
        }
        k += 1
      }
      assert_eq mul(i, j), s
      j += 1
    }
    i += 1
  }
}

test "sboxes" {
  i = 0
  while i < 256 {
    assert_eq SBOX1[SBOX0[i].to_i].to_i, i
    assert_eq SBOX0[SBOX1[i].to_i].to_i, i
    i += 1
  }
}

test "te" {
  i = 0
  while i < 256 {
    s = SBOX0[i].as_u32
    s2 = mul(s, 2)
    s3 = mul(s, 3)
    w = (s2 << 24) | (s << 16) | (s << 8) | s3
    te = [TE0, TE1, TE2, TE3]
    for t in te {
      assert_eq t[i], w
      w = (w << 24) | (w >> 8)
    }
    i += 1
  }
}

test "td" {
  i = 0
  while i < 256 {
    s = SBOX1[i].as_u32
    s9 = mul(s, 0x9)
    sb = mul(s, 0xb)
    sd = mul(s, 0xd)
    se = mul(s, 0xe)
    w = (se << 24) | (s9 << 16) | (sd << 8) | sb
    td = [TD0, TD1, TD2, TD3]
    for t in td {
      assert_eq t[i], w
      w = (w << 24) | (w >> 8)
    }
    i += 1
  }
}

bench "encrypt AES-128" {
  tt = encrypt_tests()[1]
  c = new_cipher(tt.key).unwrap
  out = [0.as_u8; 16]
  i = 0
  while i < 1000 {
    c.encrypt(out, tt.input)
    i += 1
  }
}

bench "decrypt AES-128" {
  tt = encrypt_tests()[1]
  c = new_cipher(tt.key).unwrap
  out = [0.as_u8; 16]
  i = 0
  while i < 1000 {
    c.decrypt(out, tt.out)
    i += 1
  }
}

bench "encrypt AES-256" {
  tt = encrypt_tests()[3]
  c = new_cipher(tt.key).unwrap
  out = [0.as_u8; 16]
  i = 0
  while i < 1000 {
    c.encrypt(out, tt.input)
    i += 1
  }
}

bench "create cipher AES-128" {
  tt = encrypt_tests()[1]
  new_cipher(tt.key).unwrap
}
