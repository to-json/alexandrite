# Go's crypto/internal/cryptotest.TestBlock, for a constructor of
# blocks. Go's random bytes come from a seeded generator; here they are
# gen's bytes. The BufferOverlap and ShortBlock subtests expect panics and
# have no counterpart (an alx test can't catch a panic).

def check_block[B](key_size: Int, mb: ([Byte]) -> B) {
  key = gen(key_size.as_u64, key_size)
  block = mb(key)
  bs = block.block_size
  check_cipher(->(dst: [Byte], src: [Byte]) { block.encrypt(dst, src) }, bs)
  check_cipher(->(dst: [Byte], src: [Byte]) { block.decrypt(dst, src) }, bs)

  # Roundtrip
  before = gen(10, bs)
  ciphertext = [0.as_u8; bs]
  after = [0.as_u8; bs]
  block.encrypt(ciphertext, before)
  block.decrypt(after, ciphertext)
  assert_eq after, before
  before = gen(11, bs)
  plaintext = [0.as_u8; bs]
  after = [0.as_u8; bs]
  block.decrypt(plaintext, before)
  block.encrypt(after, plaintext)
  assert_eq after, before
}

def check_cipher(cipher: ([Byte], [Byte]) -> Unit, bs: Int) {
  # AlterInput
  src = gen(20, bs * 2)
  before = src + []
  dst = [0.as_u8; bs]
  cipher(dst, src)
  assert_eq src, before

  # Aliasing
  buff = gen(21, bs)
  expected = [0.as_u8; bs]
  cipher(expected, buff)
  cipher(buff, buff)
  assert_eq buff, expected

  # OutOfBoundsWrite
  src = gen(22, bs)
  buff = [0.as_u8; bs * 3]
  copy(buff[0...bs], gen(23, bs))
  copy(buff[bs * 2...bs * 3], gen(24, bs))
  init_prefix = buff[0...bs] + []
  init_suffix = buff[bs * 2...bs * 3] + []
  cipher(buff[bs...bs * 2], src)
  assert_eq buff[bs * 2...bs * 3], init_suffix
  assert_eq buff[0...bs], init_prefix
  cipher(buff[bs...bs * 3], src)
  assert_eq buff[bs * 2...bs * 3], init_suffix

  # OutOfBoundsRead
  src = gen(25, bs)
  expected = [0.as_u8; bs]
  cipher(expected, src)
  buff = [0.as_u8; bs * 3]
  copy(buff[bs...bs * 2], src)
  copy(buff[0...bs], gen(26, bs))
  copy(buff[bs * 2...bs * 3], gen(27, bs))
  test_dst = [0.as_u8; bs]
  cipher(test_dst, buff[bs...bs * 2])
  assert_eq test_dst, expected
  cipher(test_dst, buff[bs...bs * 3])
  assert_eq test_dst, expected

  # NonZeroDst
  src = gen(28, bs)
  expected = [0.as_u8; bs]
  cipher(expected, src)
  dst = gen(29, bs * 2)
  expected = expected + dst[bs...bs * 2]
  cipher(dst, src)
  assert_eq dst, expected
}
