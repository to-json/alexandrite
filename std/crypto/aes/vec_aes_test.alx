# Generated from Go's crypto/aes (go1.27.1): one block encrypted and
# decrypted under seeded random keys of every size. Do not edit by hand.
# 900 assertions.

import "encoding/hex"

def vblock(name: Str, seed: U64) -> Block {
  case name {
    "aes-128" => new_cipher(gen(seed, 16)).unwrap
    "aes-192" => new_cipher(gen(seed, 24)).unwrap
    _ => new_cipher(gen(seed, 32)).unwrap
  }
}

# Encrypting and decrypting one seeded block.
def v_block(name: Str, seed: U64, enc: Str, dec: Str) {
  b = vblock(name, seed)
  input = gen(seed + 1, 16)
  out = [0.as_u8; 16]
  b.encrypt(out, input)
  assert_eq hex.encode_to_string(out), enc
  b.decrypt(out, input)
  assert_eq hex.encode_to_string(out), dec
}

