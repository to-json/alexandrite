# Go's crypto/internal/cryptotest.TestBlockMode, for an encrypter and a
# decrypter constructor over a block. Not translated: the BufferOverlap
# subtest (alx slices don't expose addresses, so modes can't detect
# inexact overlap).

def check_block_mode[B, E, D](b: B, enc: (B, [Byte]) -> E, dec: (B, [Byte]) -> D) {
  iv = gen(600, b.block_size)
  check_block_mode_one(b, iv, enc)
  check_block_mode_one(b, iv, dec)

  # Roundtrip
  bs = enc(b, iv).block_size
  assert_eq dec(b, iv).block_size, bs
  before = gen(601, bs * 2)
  dst = [0.as_u8; bs * 2]
  after = [0.as_u8; bs * 2]
  e = enc(b, iv)
  e.crypt_blocks!(dst, before)
  d = dec(b, iv)
  d.crypt_blocks!(after, dst)
  assert_eq after, before
}

def check_block_mode_one[B, M](b: B, iv: [Byte], bm: (B, [Byte]) -> M) {
  bs = bm(b, iv).block_size

  # EmptyInput
  src = [0.as_u8; bs]
  dst = gen(610, bs)
  before = dst + []
  m = bm(b, iv)
  m.crypt_blocks!(dst, src[0...0])
  assert_eq dst, before

  # AlterInput
  src = [0.as_u8; bs * 2]
  dst = [0.as_u8; bs * 2]
  for length in [0, bs, bs * 2] {
    copy(src, gen(611 + length.as_u64, bs * 2))
    before = src + []
    m = bm(b, iv)
    m.crypt_blocks!(dst[0...length], src[0...length])
    assert_eq src, before
  }

  # Aliasing
  buff = [0.as_u8; bs * 2]
  expected = [0.as_u8; bs * 2]
  for length in [0, bs, bs * 2] {
    copy(buff, gen(620 + length.as_u64, bs * 2))
    m = bm(b, iv)
    m.crypt_blocks!(expected[0...length], buff[0...length])
    m = bm(b, iv)
    m.crypt_blocks!(buff[0...length], buff[0...length])
    assert_eq buff[0...length], expected[0...length]
  }

  # OutOfBoundsWrite
  src = gen(630, bs)
  buff = [0.as_u8; bs * 3]
  copy(buff[0...bs], gen(631, bs))
  copy(buff[bs * 2...bs * 3], gen(632, bs))
  init_prefix = buff[0...bs] + []
  init_suffix = buff[bs * 2...bs * 3] + []
  m = bm(b, iv)
  m.crypt_blocks!(buff[bs...bs * 2], src)
  assert_eq buff[bs * 2...bs * 3], init_suffix
  assert_eq buff[0...bs], init_prefix
  m = bm(b, iv)
  m.crypt_blocks!(buff[bs...bs * 3], src)
  assert_eq buff[bs * 2...bs * 3], init_suffix
  # (Issue 21104: a src bigger than dst panics and writes nothing outside dst.)
  copy(buff[bs * 2...bs * 3], init_suffix)
  big_src = gen(633, bs * 3)
  assert_panics("output smaller than input") {
    m = bm(b, iv)
    m.crypt_blocks!(buff[bs...bs * 3], big_src)
  }
  assert_eq buff[0...bs], init_prefix

  # WrongIVLen
  assert_panics("IV length must equal block size") { bm(b, gen(634, bs + 1)) }

  # PartialBlocks
  for size in [bs - 1, bs + 1, bs * 2 - 1, bs * 2 + 1] {
    psrc = [0.as_u8; size]
    pdst = [0.as_u8; bs * 3]
    assert_panics("input not full blocks") {
      m = bm(b, iv)
      m.crypt_blocks!(pdst, psrc)
    }
  }

  # OutOfBoundsRead
  src = gen(640, bs)
  expected = [0.as_u8; bs]
  m = bm(b, iv)
  m.crypt_blocks!(expected, src)
  buff = [0.as_u8; bs * 3]
  copy(buff[bs...bs * 2], src)
  copy(buff[0...bs], gen(641, bs))
  copy(buff[bs * 2...bs * 3], gen(642, bs))
  test_dst = [0.as_u8; bs]
  m = bm(b, iv)
  m.crypt_blocks!(test_dst, buff[bs...bs * 2])
  assert_eq test_dst, expected

  # KeepState
  src = gen(650, bs * 4)
  serial = [0.as_u8; bs * 4]
  composite = [0.as_u8; bs * 4]
  length = 2 * bs
  m = bm(b, iv)
  m.crypt_blocks!(serial, src[0...length])
  m.crypt_blocks!(serial[length...serial.size], src[length...src.size])
  m2 = bm(b, iv)
  m2.crypt_blocks!(composite, src)
  assert_eq serial, composite
}
