#![overflow(wrap)]
# CFB (Cipher Feedback) mode. Deprecated in Go: CFB isn't authenticated
# and doesn't follow XOR semantics; use an AEAD mode (GCM) instead, or CTR
# for an unauthenticated stream.

# A Stream which encrypts with cipher feedback mode, using b. The IV must
# have b's block size.
pub def new_cfb_encrypter[B](b: B, iv: [Byte]) -> Cfb[B] {
  new_cfb(b, iv, false)
}

# A Stream which decrypts with cipher feedback mode, using b. The IV must
# have b's block size.
pub def new_cfb_decrypter[B](b: B, iv: [Byte]) -> Cfb[B] {
  new_cfb(b, iv, true)
}

def new_cfb[B](b: B, iv: [Byte], decrypt: Bool) -> Cfb[B] {
  bs = b.block_size
  panic("cipher.newCFB: IV length must equal block size") if iv.size != bs
  Cfb.new(b: b, nxt: iv + [], out: [0.as_u8; bs], st: [bs], decrypt: decrypt)
}

# CFB mode with a block cipher B (a Stream).
pub struct Cfb[B] {
  b: B
  nxt: [Byte]
  out: [Byte]
  # st[0]: bytes of out used.
  st: [Int]
  decrypt: Bool

  # Encrypts or decrypts src into dst.
  pub def xor_key_stream!(dst: [Byte], src: [Byte]) {
    panic("crypto/cipher: output smaller than input") if dst.size < src.size
    off = 0
    n = src.size
    bs = out.size
    while off < n {
      if st[0] == bs {
        b.encrypt(out, nxt)
        self.st[0] = 0
      }
      used = st[0]
      k = bs - used
      k = n - off if k > n - off
      copy(nxt[used...used + k], src[off...off + k]) if decrypt
      xor_n(dst[off...off + k], src[off...off + k], out[used...used + k], k)
      copy(nxt[used...used + k], dst[off...off + k]) if !decrypt
      off += k
      self.st[0] = used + k
    }
    nil
  }
}
