#![overflow(wrap)]
# Counter (CTR) mode. CTR converts a block cipher into a stream cipher by
# repeatedly encrypting an incrementing counter and xoring the resulting
# stream of data with the input. See NIST SP 800-38A, pp 13-15.

STREAM_BUFFER_SIZE = 512

# A Stream which encrypts/decrypts using b in counter mode. The IV must
# have b's block size; the whole IV is the counter, incremented as a
# big-endian number.
pub def new_ctr[B](b: B, iv: [Byte]) -> Ctr[B] {
  bs = b.block_size
  panic("cipher.new_ctr: IV length must equal block size") if iv.size != bs
  buf_size = STREAM_BUFFER_SIZE < bs ? bs : STREAM_BUFFER_SIZE
  Ctr.new(b: b, bs: bs, ctr: iv + [], out: [0.as_u8; buf_size], st: [0, 0])
}

# CTR mode with a block cipher B (a Stream).
pub struct Ctr[B] {
  b: B
  bs: Int
  # The next counter block.
  ctr: [Byte]
  # Key stream buffer: out[st[1]...st[0]] is unused key stream.
  out: [Byte]
  st: [Int]

  def refill! {
    remain = st[0] - st[1]
    copy(out, out[st[1]...st[0]])
    limit = out.size - bs
    c = ctr
    while remain <= limit {
      b.encrypt(out[remain...remain + bs], c)
      remain += bs
      # Increment the counter.
      i = c.size - 1
      while i >= 0 {
        c[i] = c[i] + 1
        break if c[i] != 0
        i -= 1
      }
    }
    self.st[0] = remain
    self.st[1] = 0
    nil
  }

  # XORs src with the key stream into dst.
  pub def xor_key_stream!(dst: [Byte], src: [Byte]) {
    panic("crypto/cipher: output smaller than input") if dst.size < src.size
    off = 0
    n = src.size
    while off < n {
      refill! if st[1] >= st[0] - bs
      used = st[1]
      k = st[0] - used
      k = n - off if k > n - off
      xor_n(dst[off...off + k], src[off...off + k], out[used...used + k], k)
      off += k
      self.st[1] = used + k
    }
    nil
  }
}
