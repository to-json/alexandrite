# Deterministic test bytes: Go's cryptotest reads from a seeded generator;
# these are the bytes of the splitmix64 sequence from seed (the low byte of
# each value), the same in the Go programs that generated the vectors.
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out = [0.as_u8; n]
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out[i] = z.as_u8
    i += 1
  }
  out
}
