# Stream adapters for io (Go's crypto/cipher io.go).

# An io.Reader that runs everything it reads from R through the stream S.
pub struct StreamReader[S, R] {
  s: S
  r: R

  # Reads into dst from R and XORs what was read with S's key stream.
  pub def read!(dst: [Byte]) -> ~Int {
    n = r.~read!(dst)
    s.xor_key_stream!(dst[0...n], dst[0...n])
    n
  }
}

# An io.Writer that runs everything written to it through the stream S
# and writes the result to W. Any write error leaves S out of step with
# the data written, so the writer can't be used after one.
pub struct StreamWriter[S, W] {
  s: S
  w: W

  # XORs src with S's key stream and writes the result to W.
  pub def write!(src: [Byte]) -> ~Int {
    c = [0.as_u8; src.size]
    s.xor_key_stream!(c, src)
    w.~write!(c)
  }

  # Closes W (W must have a close! method; Go closes W if it is an
  # io.Closer and does nothing otherwise).
  pub def close! -> ~Unit {
    w.~close!
  }
}
