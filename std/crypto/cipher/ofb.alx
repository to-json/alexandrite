#![overflow(wrap)]
# OFB (Output Feedback) mode. Deprecated in Go: OFB isn't authenticated;
# use an AEAD mode (GCM) instead, or CTR for an unauthenticated stream.

# A Stream that encrypts or decrypts using b in output feedback mode. The
# IV must have b's block size.
pub def new_ofb[B](b: B, iv: [Byte]) -> Ofb[B] {
  bs = b.block_size
  panic("cipher.NewOFB: IV length must equal block size") if iv.size != bs
  buf_size = STREAM_BUFFER_SIZE < bs ? bs : STREAM_BUFFER_SIZE
  Ofb.new(b: b, bs: bs, cipher: iv + [], out: [0.as_u8; buf_size], st: [0, 0])
}

# OFB mode with a block cipher B (a Stream).
pub struct Ofb[B] {
  b: B
  bs: Int
  # The last output block (the feedback).
  cipher: [Byte]
  # Key stream buffer: out[st[1]...st[0]] is unused key stream.
  out: [Byte]
  st: [Int]

  def refill! {
    remain = st[0] - st[1]
    return if remain > st[1]
    copy(out, out[st[1]...st[0]])
    limit = out.size - bs
    while remain < limit {
      b.encrypt(cipher, cipher)
      copy(out[remain...remain + bs], cipher)
      remain += bs
    }
    self.st[0] = remain
    self.st[1] = 0
    nil
  }

  # XORs src with the key stream into dst.
  pub def xor_key_stream!(dst: [Byte], src: [Byte]) {
    panic("crypto/cipher: output smaller than input") if dst.size < src.size
    off = 0
    n = src.size
    while off < n {
      refill! if st[1] >= st[0] - bs
      used = st[1]
      k = st[0] - used
      k = n - off if k > n - off
      xor_n(dst[off...off + k], src[off...off + k], out[used...used + k], k)
      off += k
      self.st[1] = used + k
    }
    nil
  }
}
