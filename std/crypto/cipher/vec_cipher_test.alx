# Generated from Go's crypto/cipher (go1.27.1): every mode over AES-128/192/256,
# DES and 3DES with seeded random keys, IVs and plaintexts (gen), streams
# fed in chunks, CTR near counter wrap, GCM with additional data and
# non-standard nonce and tag sizes. Outputs over 256 bytes are compared by
# SHA-256. Do not edit by hand. 1735 assertions.

import "crypto/aes"
import "crypto/des"
import "crypto/sha256"

# (case arms aren't converted to a wanted interface yet: port-issues #23.)
def vaes(key: [Byte]) -> Block { aes.new_cipher(key).unwrap }

def vdes(key: [Byte]) -> Block { des.new_cipher(key).unwrap }

def vtdes(key: [Byte]) -> Block { des.new_triple_des_cipher(key).unwrap }

def vblock(name: Str, seed: U64) -> Block {
  case name {
    "aes-128" => vaes(gen(seed, 16))
    "aes-192" => vaes(gen(seed, 24))
    "aes-256" => vaes(gen(seed, 32))
    "des" => vdes(gen(seed, 8))
    _ => vtdes(gen(seed, 24))
  }
}

def vwant(out: [Byte]) -> Str {
  return "sha256:#{hexs(sha256.sum256(out).to_a)}" if out.size > 256
  hexs(out)
}

def v_cbc(name: Str, seed: U64, n: Int, want: Str) {
  b = vblock(name, seed)
  iv = gen(seed + 1, b.block_size)
  pt = gen(seed + 2, n)
  ct = [0.as_u8; n]
  e = new_cbc_encrypter(b, iv)
  e.crypt_blocks!(ct, pt)
  assert_eq vwant(ct), want
  back = [0.as_u8; n]
  d = new_cbc_decrypter(b, iv)
  d.crypt_blocks!(back, ct)
  assert_eq back, pt
}

# Runs src through s in chunks of chunk bytes (0: one call).
def vstream[S](s: S, src: [Byte], chunk: Int) -> [Byte] {
  out = [0.as_u8; src.size]
  st = s
  if chunk == 0 {
    st.xor_key_stream!(out, src)
    return out
  }
  off = 0
  while off < src.size {
    end = off + chunk
    end = src.size if end > src.size
    st.xor_key_stream!(out[off...end], src[off...end])
    off = end
  }
  out
}

def v_ctr(name: Str, seed: U64, n: Int, chunk: Int, want: Str) {
  b = vblock(name, seed)
  iv = gen(seed + 1, b.block_size)
  pt = gen(seed + 2, n)
  ct = vstream(new_ctr(b, iv), pt, chunk)
  assert_eq vwant(ct), want
  assert_eq vstream(new_ctr(b, iv), ct, chunk), pt
}

def v_ctr_iv(name: Str, seed: U64, iv: Str, want: Str) {
  b = vblock(name, seed)
  pt = gen(seed + 2, 100)
  assert_eq vwant(vstream(new_ctr(b, h(iv)), pt, 0)), want
}

def v_cfb(name: Str, seed: U64, n: Int, chunk: Int, want: Str) {
  b = vblock(name, seed)
  iv = gen(seed + 1, b.block_size)
  pt = gen(seed + 2, n)
  ct = vstream(new_cfb_encrypter(b, iv), pt, chunk)
  assert_eq vwant(ct), want
  assert_eq vstream(new_cfb_decrypter(b, iv), ct, chunk), pt
}

def v_ofb(name: Str, seed: U64, n: Int, chunk: Int, want: Str) {
  b = vblock(name, seed)
  iv = gen(seed + 1, b.block_size)
  pt = gen(seed + 2, n)
  ct = vstream(new_ofb(b, iv), pt, chunk)
  assert_eq vwant(ct), want
  assert_eq vstream(new_ofb(b, iv), ct, chunk), pt
}

def v_gcm(name: Str, seed: U64, ns: Int, ts: Int, pl: Int, al: Int, want: Str) {
  b = vblock(name, seed)
  g = if ts != 16 {
    new_gcm_with_tag_size(b, ts).unwrap
  } else {
    new_gcm_with_nonce_size(b, ns).unwrap
  }
  nonce = gen(seed + 1, ns)
  pt = gen(seed + 2, pl)
  ad = gen(seed + 3, al)
  ct = g.seal([], nonce, pt, ad)
  assert_eq vwant(ct), want
  assert_eq g.open([], nonce, ct, ad).unwrap, pt
}

