# Package crypto: Go's crypto, the constants and interfaces shared by the
# cryptographic packages.
#
#   Go                                  alx
#   crypto.Hash (uint)                  Hash (an enum)
#   crypto.MD5, crypto.SHA256, ...      MD5, SHA256, ... (constants of Hash)
#   h.New() hash.Hash                   h.new -> hash.Hash
#   h.Available() bool                  h.available?
#   h.Size() int                        h.size
#   h.String() string                   h.to_s
#   h.HashFunc() Hash                   h.hash_func
#   crypto.PublicKey / PrivateKey (any) PublicKey / PrivateKey (empty interfaces)
#   crypto.Signer                       Signer (public, sign)
#   crypto.MessageSigner                MessageSigner (public, sign, sign_message)
#   crypto.SignerOpts                   SignerOpts (hash_func)
#   crypto.Decrypter                    Decrypter (public, decrypt)
#   crypto.DecrypterOpts (any)          DecrypterOpts (an empty interface)
#   crypto.SignMessage(s, rand, msg, o) sign_message(s, rand, msg, opts) -> ~[Byte]
#   crypto.Encapsulator / Decapsulator  Encapsulator / Decapsulator
#   crypto.RegisterHash(h, f)           (none: see below)
#
# The interfaces are structural (GO-VS-RUBY F2): a type with the methods is
# one. `crypto.SHA256.new` is a hash.Hash; `sha256.new()` gives the concrete
# sha256.Digest, which also is one.
#
# Differences from Go:
#   - Hash is an enum, so there is no Hash(0) and no unknown value: Go's
#     "opts.HashFunc() == 0" (sign the message itself, unhashed) is
#     `opts.hash_func` returning none here (SignerOpts.hash_func -> Hash?),
#     and String's "unknown hash value N" can't happen. `Hash.from(n)`
#     converts Go's numbers (MD4 = 1 ... MLDSAMu = 20) and `h.value` gives
#     them back.
#   - No RegisterHash: alx has no init functions or mutable package state.
#     The hashes this std implements (MD5, SHA-1, SHA-2, SHA-3) are always
#     available; the others (MD4, MD5+SHA1, RIPEMD-160, BLAKE2, ML-DSA mu)
#     are known by name and size but `available?` is false and `new` panics,
#     as in a Go program that doesn't import their packages.
#   - sign_message can't ask whether the signer also implements
#     MessageSigner (no run-time type assertions): it hashes msg with
#     opts.hash_func (if any) and calls sign. A MessageSigner's own
#     sign_message is called directly.
#   - PublicKey, PrivateKey and DecrypterOpts are interfaces without methods
#     (Go's `any`): any struct or enum converts to them.

import "hash"
import "io"
import "crypto/md5"
import "crypto/sha1"
import "crypto/sha256"
import "crypto/sha512"
import "crypto/sha3"

# A hash function, identified by Go's number for it (see `value`).
pub enum Hash {
  MD4
  MD5
  SHA1
  SHA224
  SHA256
  SHA384
  SHA512
  MD5SHA1
  RIPEMD160
  SHA3_224
  SHA3_256
  SHA3_384
  SHA3_512
  SHA512_224
  SHA512_256
  BLAKE2s_256
  BLAKE2b_256
  BLAKE2b_384
  BLAKE2b_512
  MLDSAMu

  # The hash itself: a Hash is a SignerOpts.
  pub def hash_func -> Hash? { self }

  # Go's name for the hash ("SHA-256").
  pub def to_s -> Str {
    case self {
      MD4 => "MD4"
      MD5 => "MD5"
      SHA1 => "SHA-1"
      SHA224 => "SHA-224"
      SHA256 => "SHA-256"
      SHA384 => "SHA-384"
      SHA512 => "SHA-512"
      MD5SHA1 => "MD5+SHA1"
      RIPEMD160 => "RIPEMD-160"
      SHA3_224 => "SHA3-224"
      SHA3_256 => "SHA3-256"
      SHA3_384 => "SHA3-384"
      SHA3_512 => "SHA3-512"
      SHA512_224 => "SHA-512/224"
      SHA512_256 => "SHA-512/256"
      BLAKE2s_256 => "BLAKE2s-256"
      BLAKE2b_256 => "BLAKE2b-256"
      BLAKE2b_384 => "BLAKE2b-384"
      BLAKE2b_512 => "BLAKE2b-512"
      MLDSAMu => "ML-DSA μ message representative"
    }
  }

  # The length in bytes of a digest from this hash.
  pub def size -> Int {
    case self {
      MD4 => 16
      MD5 => 16
      SHA1 => 20
      SHA224 => 28
      SHA256 => 32
      SHA384 => 48
      SHA512 => 64
      MD5SHA1 => 36
      RIPEMD160 => 20
      SHA3_224 => 28
      SHA3_256 => 32
      SHA3_384 => 48
      SHA3_512 => 64
      SHA512_224 => 28
      SHA512_256 => 32
      BLAKE2s_256 => 32
      BLAKE2b_256 => 32
      BLAKE2b_384 => 48
      BLAKE2b_512 => 64
      MLDSAMu => 64
    }
  }

  # Go's number for the hash (crypto.MD4 == 1, ..., crypto.MLDSAMu == 20).
  pub def value -> Int {
    case self {
      MD4 => 1
      MD5 => 2
      SHA1 => 3
      SHA224 => 4
      SHA256 => 5
      SHA384 => 6
      SHA512 => 7
      MD5SHA1 => 8
      RIPEMD160 => 9
      SHA3_224 => 10
      SHA3_256 => 11
      SHA3_384 => 12
      SHA3_512 => 13
      SHA512_224 => 14
      SHA512_256 => 15
      BLAKE2s_256 => 16
      BLAKE2b_256 => 17
      BLAKE2b_384 => 18
      BLAKE2b_512 => 19
      MLDSAMu => 20
    }
  }

  # Whether `new` can make this hash.
  pub def available? -> Bool {
    case self {
      MD5 => true
      SHA1 => true
      SHA224 => true
      SHA256 => true
      SHA384 => true
      SHA512 => true
      SHA3_224 => true
      SHA3_256 => true
      SHA3_384 => true
      SHA3_512 => true
      SHA512_224 => true
      SHA512_256 => true
      _ => false
    }
  }

  # A new hash.Hash computing this hash. Panics if it isn't available?.
  pub def new -> hash.Hash {
    case self {
      MD5 => as_hash(md5.new())
      SHA1 => as_hash(sha1.new())
      SHA224 => as_hash(sha256.new224())
      SHA256 => as_hash(sha256.new())
      SHA384 => as_hash(sha512.new384())
      SHA512 => as_hash(sha512.new())
      SHA3_224 => as_hash(sha3.new224())
      SHA3_256 => as_hash(sha3.new256())
      SHA3_384 => as_hash(sha3.new384())
      SHA3_512 => as_hash(sha3.new512())
      SHA512_224 => as_hash(sha512.new512_224())
      SHA512_256 => as_hash(sha512.new512_256())
      _ => panic("crypto: requested hash function unavailable: #{to_s}")
    }
  }

  # The Hash with Go's number n (1 to 20), or none.
  pub def self.from(n: Int) -> Hash? {
    for h in all_hashes() {
      return h if h.value == n
    }
    none
  }
}

pub MD4 = Hash.MD4
pub MD5 = Hash.MD5
pub SHA1 = Hash.SHA1
pub SHA224 = Hash.SHA224
pub SHA256 = Hash.SHA256
pub SHA384 = Hash.SHA384
pub SHA512 = Hash.SHA512
pub MD5SHA1 = Hash.MD5SHA1
pub RIPEMD160 = Hash.RIPEMD160
pub SHA3_224 = Hash.SHA3_224
pub SHA3_256 = Hash.SHA3_256
pub SHA3_384 = Hash.SHA3_384
pub SHA3_512 = Hash.SHA3_512
pub SHA512_224 = Hash.SHA512_224
pub SHA512_256 = Hash.SHA512_256
pub BLAKE2s_256 = Hash.BLAKE2s_256
pub BLAKE2b_256 = Hash.BLAKE2b_256
pub BLAKE2b_384 = Hash.BLAKE2b_384
pub BLAKE2b_512 = Hash.BLAKE2b_512
pub MLDSAMu = Hash.MLDSAMu

def all_hashes -> [Hash] {
  [MD4, MD5, SHA1, SHA224, SHA256, SHA384, SHA512, MD5SHA1, RIPEMD160, SHA3_224, SHA3_256, SHA3_384,
    SHA3_512, SHA512_224, SHA512_256, BLAKE2s_256, BLAKE2b_256, BLAKE2b_384, BLAKE2b_512, MLDSAMu]
}

# A public key of an unspecified algorithm (Go's `any`). Go's public keys
# all have `Equal(x crypto.PublicKey) bool`; alx's have `equal?`.
pub interface PublicKey {
}

# A private key of an unspecified algorithm (Go's `any`). Go's private keys
# have `Public() crypto.PublicKey` and `Equal`.
pub interface PrivateKey {
}

# Options for signing with a Signer.
pub interface SignerOpts {
  # The hash used to digest the message before signing, or none if the
  # message is signed as it is (Go's Hash(0)).
  def hash_func -> Hash?
}

# An opaque private key that can sign: the key may live in a hardware
# module, so it isn't readable.
pub interface Signer {
  # The public key of the opaque private key.
  def public -> PublicKey
  # A signature of digest (the message hashed with opts.hash_func, or the
  # message itself) using randomness from rand where the scheme needs it.
  def sign(rand: io.Reader, digest: [Byte], opts: SignerOpts) -> ~[Byte]
}

# A Signer that can also sign a message itself, hashing it internally.
pub interface MessageSigner {
  def public -> PublicKey
  def sign(rand: io.Reader, digest: [Byte], opts: SignerOpts) -> ~[Byte]
  def sign_message(rand: io.Reader, msg: [Byte], opts: SignerOpts) -> ~[Byte]
}

# Options for decryption; their type depends on the Decrypter.
pub interface DecrypterOpts {
}

# An opaque private key that can decrypt.
pub interface Decrypter {
  def public -> PublicKey
  def decrypt(rand: io.Reader, msg: [Byte], opts: DecrypterOpts) -> ~[Byte]
}

# The public half of a KEM key: makes shared keys with their ciphertexts.
pub interface Encapsulator {
  # The encapsulation key, in its standard encoding.
  def bytes -> [Byte]
  # A new shared key and the ciphertext that carries it.
  def encapsulate -> ([Byte], [Byte])
}

# A KEM decapsulation key.
pub interface Decapsulator {
  # The matching encapsulation key.
  def encapsulator -> Encapsulator
  # The shared key carried by ciphertext.
  def decapsulate(ciphertext: [Byte]) -> ~[Byte]
}

# Errors of sign_message.
pub error CryptoError {
  HashUnavailable(h: Hash)

  def message -> Str {
    case self {
      HashUnavailable(h) => "crypto: requested hash function unavailable: #{h.to_s}"
    }
  }
}

# Signs msg with signer: hashes it with opts.hash_func (when there is one)
# and signs the digest.
pub def sign_message(signer: Signer, rand: io.Reader, msg: [Byte], opts: SignerOpts) -> ~[Byte] {
  m = msg
  if h = opts.hash_func {
    fail CryptoError.HashUnavailable(h: h) if !h.available?
    d = h.new
    d.write!(msg)
    m = d.sum([])
  }
  s = signer
  ~s.sign(rand, m, opts)
}

# h as a hash.Hash interface value (gives the arms of Hash.new one type).
def as_hash(h: hash.Hash) -> hash.Hash { h }
