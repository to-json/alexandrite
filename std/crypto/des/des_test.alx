import "encoding/hex"

# Go's crypto/des des_test.go, internal_test.go and example_test.go,
# translated (the tables are in tables_test.alx). cryptotest.TestBlock is
# check_block (block_test.alx).
#
# Not translated: cryptotest's BufferOverlap and ShortBlock subtests (they
# expect panics, which an alx test can't catch).

def h(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

struct CryptTest {
  key: [Byte]
  input: [Byte]
  out: [Byte]
}

def ct(key: Str, input: Str, out: Str) -> CryptTest {
  CryptTest.new(key: h(key), input: h(input), out: h(out))
}

def des_encrypt(key: [Byte], input: [Byte]) -> [Byte] {
  c = new_cipher(key).unwrap
  out = [0.as_u8; input.size]
  c.encrypt(out, input)
  out
}

def tdes(key: [Byte]) -> TripleCipher { new_triple_des_cipher(key).unwrap }

# Use the known weak keys to test DES implementation: encrypting twice with
# a DES weak key should reproduce the original input.
test "weak keys" {
  for tt in weak_key_tests() {
    result = des_encrypt(tt.key, tt.input)
    result = des_encrypt(tt.key, result)
    assert_eq result, tt.input
  }
}

# Encrypting with one member of the semi-weak pair and then encrypting the
# result with the other member should reproduce the original input.
test "semi weak key pairs" {
  for tt in semi_weak_key_tests() {
    result = des_encrypt(tt.key, tt.input)
    result = des_encrypt(tt.out, result)
    assert_eq result, tt.input
  }
}

test "des encrypt block" {
  for tt in encrypt_des_tests() {
    assert_eq des_encrypt(tt.key, tt.input), tt.out
  }
}

test "des decrypt block" {
  for tt in encrypt_des_tests() {
    c = new_cipher(tt.key).unwrap
    plain = [0.as_u8; tt.input.size]
    c.decrypt(plain, tt.out)
    assert_eq plain, tt.input
  }
}

test "encrypt triple des" {
  for tt in encrypt_triple_des_tests() {
    out = [0.as_u8; tt.input.size]
    tdes(tt.key).encrypt(out, tt.input)
    assert_eq out, tt.out
  }
}

test "decrypt triple des" {
  for tt in encrypt_triple_des_tests() {
    plain = [0.as_u8; tt.input.size]
    tdes(tt.key).decrypt(plain, tt.out)
    assert_eq plain, tt.input
  }
}

# Pub 800-20.
test "variable plaintext known answer" {
  c = tdes(table_a1_key())
  for tt in table_a1_tests() {
    out = [0.as_u8; tt.input.size]
    c.encrypt(out, tt.input)
    assert_eq out, tt.out
  }
}

test "variable ciphertext known answer" {
  c = tdes(table_a1_key())
  for tt in table_a1_tests() {
    plain = [0.as_u8; tt.out.size]
    c.decrypt(plain, tt.out)
    assert_eq plain, tt.input
  }
}

# Encrypting the Table A.1 ciphertext with the 0x01... key produces the
# original plaintext.
test "inverse permutation known answer" {
  c = tdes(table_a1_key())
  for tt in table_a1_tests() {
    plain = [0.as_u8; tt.input.size]
    c.encrypt(plain, tt.out)
    assert_eq plain, tt.input
  }
}

# Decrypting the Table A.1 plaintext with the 0x01... key produces the
# corresponding ciphertext.
test "initial permutation known answer" {
  c = tdes(table_a1_key())
  for tt in table_a1_tests() {
    out = [0.as_u8; tt.input.size]
    c.decrypt(out, tt.input)
    assert_eq out, tt.out
  }
}

test "variable key known answer encrypt" {
  for tt in table_a2_tests() {
    out = [0.as_u8; 8]
    tdes(tt.key).encrypt(out, table_a2_plaintext())
    assert_eq out, tt.out
  }
}

test "variable key known answer decrypt" {
  for tt in table_a2_tests() {
    out = [0.as_u8; tt.out.size]
    tdes(tt.key).decrypt(out, tt.out)
    assert_eq out, table_a2_plaintext()
  }
}

test "permutation operation known answer encrypt" {
  for tt in table_a3_tests() {
    out = [0.as_u8; 8]
    tdes(tt.key).encrypt(out, table_a3_plaintext())
    assert_eq out, tt.out
  }
}

test "permutation operation known answer decrypt" {
  for tt in table_a3_tests() {
    out = [0.as_u8; tt.out.size]
    tdes(tt.key).decrypt(out, tt.out)
    assert_eq out, table_a3_plaintext()
  }
}

test "substitution table known answer encrypt" {
  for tt in table_a4_tests() {
    out = [0.as_u8; tt.input.size]
    tdes(tt.key).encrypt(out, tt.input)
    assert_eq out, tt.out
  }
}

test "substitution table known answer decrypt" {
  for tt in table_a4_tests() {
    out = [0.as_u8; tt.out.size]
    tdes(tt.key).decrypt(out, tt.out)
    assert_eq out, tt.input
  }
}

test "des block" {
  check_block(8, ->(key: [Byte]) -> Cipher { new_cipher(key).unwrap })
  check_block(24, ->(key: [Byte]) -> TripleCipher { new_triple_des_cipher(key).unwrap })
}

test "key size error" {
  for n in [0, 7, 9, 16, 24, 32] {
    r = new_cipher([0.as_u8; n])
    if n == 8 {
      assert r.ok?, "8 rejected"
    } else {
      assert_eq r.err.unwrap.message, "crypto/des: invalid key size #{n}"
    }
  }
  for n in [0, 8, 16, 23, 25] {
    r = new_triple_des_cipher([0.as_u8; n])
    assert_eq r.err.unwrap.message, "crypto/des: invalid key size #{n}"
  }
}

# internal_test.go: the bit-twiddling permutations match the tables.
test "initial permute" {
  i: U64 = 0
  while i < 64 {
    bit = 1.as_u64 << i
    assert_eq permute_initial_block(bit), 1.as_u64 << FINAL_PERMUTATION[63 - i.to_i].as_u64
    i += 1
  }
}

test "final permute" {
  i: U64 = 0
  while i < 64 {
    bit = 1.as_u64 << i
    assert_eq permute_final_block(bit), 1.as_u64 << INITIAL_PERMUTATION[63 - i.to_i].as_u64
    i += 1
  }
}

# The permutations by table agree with the bit-twiddling ones.
test "permute block" {
  i: U64 = 0
  while i < 64 {
    x = (1.as_u64 << i) | 0x0123456789abcdef
    assert_eq permute_block(x, INITIAL_PERMUTATION), permute_initial_block(x)
    assert_eq permute_block(x, FINAL_PERMUTATION), permute_final_block(x)
    i += 1
  }
}

# Go's initFeistelBox, against the generated table.
test "feistel box" {
  s = 0
  while s < 8 {
    i = 0
    while i < 4 {
      j = 0
      while j < 16 {
        f = SBOXES[s * 64 + i * 16 + j].as_u64 << (4 * (7 - s)).as_u64
        f = permute_block(f, PERMUTATION_FUNCTION)
        row = ((i & 2) << 4) | (i & 1)
        col = j << 1
        t = row | col
        f = (f << 1) | (f >> 31)
        assert_eq FEISTEL_BOX[s * 64 + t], f.as_u32
        j += 1
      }
      i += 1
    }
    s += 1
  }
}

example "new triple des cipher" {
  # new_triple_des_cipher can also be used when EDE2 is required by
  # duplicating the first 8 bytes of the 16-byte key.
  ede2_key = "example key 1234".bytes.to_a
  triple_des_key = ede2_key[0...16] + ede2_key[0...8]
  c = new_triple_des_cipher(triple_des_key).unwrap
  # See crypto/cipher for how to use a cipher.Block for encryption and
  # decryption.
  puts c.block_size
} outputs "8\n"

bench "encrypt" {
  tt = encrypt_des_tests()[0]
  c = new_cipher(tt.key).unwrap
  out = [0.as_u8; 8]
  i = 0
  while i < 1000 {
    c.encrypt(out, tt.input)
    i += 1
  }
}

bench "tdes encrypt" {
  tt = encrypt_triple_des_tests()[0]
  c = tdes(tt.key)
  out = [0.as_u8; 8]
  i = 0
  while i < 1000 {
    c.encrypt(out, tt.input)
    i += 1
  }
}
