# Generated from Go's crypto/des (go1.27.1): one block encrypted and
# decrypted under seeded random keys of every size. Do not edit by hand.
# 600 assertions.

import "encoding/hex"

# Encrypting and decrypting one seeded block.
def v_block(name: Str, seed: U64, enc: Str, dec: Str) {
  input = gen(seed + 1, 8)
  out = [0.as_u8; 8]
  if name == "des" {
    b = new_cipher(gen(seed, 8)).unwrap
    b.encrypt(out, input)
    assert_eq hex.encode_to_string(out), enc
    b.decrypt(out, input)
    assert_eq hex.encode_to_string(out), dec
  } else {
    t = new_triple_des_cipher(gen(seed, 24)).unwrap
    t.encrypt(out, input)
    assert_eq hex.encode_to_string(out), enc
    t.decrypt(out, input)
    assert_eq hex.encode_to_string(out), dec
  }
}

