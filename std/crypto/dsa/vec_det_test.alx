# Generated from Go's crypto/dsa (GODEBUG=cryptocustomrand=1 with a SHAKE256 stream as rand); do not edit by hand.

test "GenerateParameters vector" {
  check_generate_parameters("dsa params L1024N160", "d2fbf671d47af4dc2d975316531aa47cd7e7f934bf139e12840014a8abfbf0a5d31b19827dd6a640f7c8cd9d08de8b9920d9d64d4e4e018ada0e60cd07cd0aa3be217360834175c431bd3185b4d06e31ac9ea8e561733402f302d1a0c795cec71eb7b027de839d23a9bb8838a1856a6c74e3aa517303f904acfb31002a3f9325", "e8dae3f92b8a9685cb2a7904f7b94f6ed6b9dbe1", "2a8791df6e547b4027e702c80c61fb99875f0632b11967323191af4ded0f6e03f1062d8ac04ee712d44d77c729e90eb14126b888e30589868dbb58695519ebf3c66498705ab921a015f73344bd933a7d43b34ca09fc41eb601c0c284098f1ab5a3801ccb5a8330d2743a2b733a7f4516f850feb9bb508ee71c61a49b1e9bd42c")
}

test "GenerateKey and Sign vectors" {
  k = check_generate_key(params(), "dsa key 0", "b60fcdd4b9de8bfe53c40b67871762e0f65f6735", "b707a714bb793c3951fd7cee6b62cedff300f99825bb77cae9b66a16ec66e4258618c7a0fdd4aa0951d7d8f1c35b8a019cebcfe76e3567eb6c69c535f26cdbf27cb5185f522829e28da4e4256551bbc8836c9fcbe597feec3592c2e48150b1c2a5f568f0afa788ee14bbedf7e2ab2a7c26df201a86f8b9e228c56e71c7f58ad6")
  check_sign(k, "dsa sign 0 0", "", "6b722bfd5097e94d2a0acfb23f15de5d12851d0b", "7bb4967368aad3741c82f4369f19a29bcb5c7b9c")
  check_sign(k, "dsa sign 0 1", "testing", "b4468a71cb833039037b71a50ca939e346106fb", "dabc4c0dd126823446bcb6b242360aacd19c7203")
  check_sign(k, "dsa sign 0 2", "message to be signed, longer than q", "322985094a2524addb0f01c41c30de7291eade73", "bfa46fa375295734c1912971e2abcc694484b140")
  k = check_generate_key(params(), "dsa key 1", "28dd679383eaa7f3ee451e879794600f2dac2cfd", "7db4c617c235cfcb717ebb624b7963c587a46e8484dbafc17ed17b7d3cd793cd846c66d17b934b0dbf3bf72db18a38916a89fe0d0a4115f8aa3eed17a4b19cc5a40e143377667a93c70dddeb42d5f10101291d865fd0d6070a444f91eeab5315002e7ddb185fc3a679dcae089296988e892b22732609db7f1495009519fbb85a")
  check_sign(k, "dsa sign 1 0", "", "32e97c5d2a19a7373c39da7ff747bc4471e7f0a1", "17ab8f1b260fd7ad57d94e16b4cc69037cb60e8")
  check_sign(k, "dsa sign 1 1", "testing", "6614f3835ebbec8f7a304156c1b885f58f42ee12", "bef3efb63c1ec26f8c49ad4580d462517c9edc02")
  check_sign(k, "dsa sign 1 2", "message to be signed, longer than q", "dc6a9ce623be7295451110037bf2ee57d4eea25c", "df2ade0fc909aea56a6d429576f6823b2f8842b0")
