  check_sign(k, "dsa sign 2 0", "", "420b027cd959e5f4b1c6c69504f0ab0d397a3e4c", "a67328433382cc61e64eeabe31a1073566e55331")
  check_sign(k, "dsa sign 2 1", "testing", "93fd30117d4438946f4f8d0de9fb896117b43d86", "80d81c499cdfe46b201dbc114d3058ca7046294d")
