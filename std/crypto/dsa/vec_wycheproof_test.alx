test "Wycheproof dsa_2048_224_sha256 5" {
  k = make_pub("", "baf696a68578f7dfdee7fa67c977c785ef32b233bae580c0bcd5695d", "", "")
  check_wp(k, crypto.SHA256, "54657374", "3006020101020101", true)                                                         # 345
  check_wp(k, crypto.SHA256, "54657374", "3006020101020105", true)                                                         # 346
  check_wp(k, crypto.SHA256, "54657374", "3022020101021d009592121ed12d93197f1ffb863ac63937f28ef4f62f1e009a30aabab1", true) # 347
  check_wp(k, crypto.SHA256, "54657374", "3022020101021d00baf696a68578f7dfdee7fa67c977c785ef32b233bae580c0bcd5695c", true) # 348
}

