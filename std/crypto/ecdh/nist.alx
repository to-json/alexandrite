#![overflow(wrap)]
# Go's crypto/internal/fips140/ecdh/ecdh.go: ECDH over the NIST curves,
# with private keys as fixed-length big-endian scalars (d) and public keys
# as uncompressed nistec point encodings (q). The functions take a curve id
# (224, 256, 384 or 521) where Go is generic over the nistec point type.
import "crypto/internal/fips140/nistec"
import "io"

P224_ORDER: [Byte; 28] = [
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x16, 0xa2,
  0xe0, 0xb8, 0xf0, 0x3e, 0x13, 0xdd, 0x29, 0x45,
  0x5c, 0x5c, 0x2a, 0x3d,
]

P256_ORDER: [Byte; 32] = [
  0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00,
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
  0xbc, 0xe6, 0xfa, 0xad, 0xa7, 0x17, 0x9e, 0x84,
  0xf3, 0xb9, 0xca, 0xc2, 0xfc, 0x63, 0x25, 0x51,
]

P384_ORDER: [Byte; 48] = [
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
  0xc7, 0x63, 0x4d, 0x81, 0xf4, 0x37, 0x2d, 0xdf,
  0x58, 0x1a, 0x0d, 0xb2, 0x48, 0xb0, 0xa7, 0x7a,
  0xec, 0xec, 0x19, 0x6a, 0xcc, 0xc5, 0x29, 0x73,
]

P521_ORDER: [Byte; 66] = [
  0x01, 0xff,
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfa,
  0x51, 0x86, 0x87, 0x83, 0xbf, 0x2f, 0x96, 0x6b,
  0x7f, 0xcc, 0x01, 0x48, 0xf7, 0x09, 0xa5, 0xd0,
  0x3b, 0xb5, 0xc9, 0xb8, 0x89, 0x9c, 0x47, 0xae,
  0xbb, 0x6f, 0xb7, 0x1e, 0x91, 0x38, 0x64, 0x09,
]

# The order N of the curve's group, big-endian (Go's Curve.N).
def nist_order(id: Int) -> [Byte] {
  return P224_ORDER if id == P224_ID
  return P256_ORDER if id == P256_ID
  return P384_ORDER if id == P384_ID
  P521_ORDER
}

# A random private key d read from rand, by rejection sampling (Go's
# GenerateKey; the PCT is a FIPS 140 mode check and is skipped).
def nist_generate_key(id: Int, rand: io.Reader) -> ~[Byte] {
  n = nist_order(id)
  while true {
    key = [0.as_u8; n.size]
    ~io.read_full(rand, key)
    # In tests, rand will return all zeros and NewPrivateKey will reject
    # the zero key as it generates the identity as a public key. This also
    # makes this function consistent with crypto/elliptic.GenerateKey.
    key[1] = key[1] ^ 0x42
    # Mask off any excess bits if the size of the underlying field is not a
    # whole number of bytes, which is only the case for P-521.
    if id == P521_ID && n[0] & 0b1111_1110 == 0 {
      key[0] = key[0] & 0b0000_0001
    }
    r = nist_new_private_key(id, key)
    next if r.err?
    return r.unwrap
  }
  panic("unreachable")
}

# key, checked to be a valid private key: N's length, nonzero, below N (Go's
# NewPrivateKey; the copy is the new d).
def nist_new_private_key(id: Int, key: [Byte]) -> ~[Byte]<EcdhError> {
  n = nist_order(id)
  fail EcdhError.InvalidPrivateKey if key.size != n.size || is_zero(key) || !is_less(key, n)
  clone_bytes(key)
}

# The public key q = d·G of a valid private key (the rest of Go's
# NewPrivateKey).
def nist_public_from_private(id: Int, d: [Byte]) -> ~[Byte] {
  r = nist_scalar_base_mult(id, d)
  panic("crypto/ecdh: internal error: nistec ScalarBaseMult failed for a fixed-size input") if r.err?
  public_key = r.unwrap
  # The key is checked to be less than the order and not zero, so the
  # public key can't be the identity.
  panic("crypto/ecdh: internal error: public key is the identity element") if public_key.size == 1
  public_key
}

def nist_scalar_base_mult(id: Int, s: [Byte]) -> ~[Byte] {
  return nistec.P224Point.~scalar_base_mult(s).bytes if id == P224_ID
  return nistec.P256Point.~scalar_base_mult(s).bytes if id == P256_ID
  return nistec.P384Point.~scalar_base_mult(s).bytes if id == P384_ID
  nistec.P521Point.~scalar_base_mult(s).bytes
}

# Checks that key is an uncompressed encoding of a point on the curve (Go's
# NewPublicKey); fails with Go's errors.
def nist_new_public_key(id: Int, key: [Byte]) -> ~Unit {
  fail EcdhError.InvalidPublicKey if key.size == 0 || key[0] != 4
  if id == P224_ID {
    ~nistec.P224Point.from_bytes(key)
  } else if id == P256_ID {
    ~nistec.P256Point.from_bytes(key)
  } else if id == P384_ID {
    ~nistec.P384Point.from_bytes(key)
  } else {
    ~nistec.P521Point.from_bytes(key)
  }
  nil
}

# The x coordinate of d·peer (Go's ECDH; q is the private key's own public
# key, which Go checks against the identity).
def nist_ecdh(id: Int, d: [Byte], q: [Byte], peer: [Byte]) -> ~[Byte] {
  # This applies the point validity checks on peer. Go's SP 800-56A checks
  # (on curve, not infinity, order) are covered by SetBytes and the prime
  # order of the curves.
  fail EcdhError.IdentityElement if q.size == 1
  if id == P224_ID {
    p224 = ~nistec.P224Point.from_bytes(peer)
    return p224.~scalar_mult(d).~bytes_x
  }
  if id == P256_ID {
    p256 = ~nistec.P256Point.from_bytes(peer)
    return p256.~scalar_mult(d).~bytes_x
  }
  if id == P384_ID {
    p384 = ~nistec.P384Point.from_bytes(peer)
    return p384.~scalar_mult(d).~bytes_x
  }
  p521 = ~nistec.P521Point.from_bytes(peer)
  p521.~scalar_mult(d).~bytes_x
}

# Whether a < b as big-endian numbers of the same length (constant time;
# Go's isLess).
def is_less(a: [Byte], b: [Byte]) -> Bool {
  panic("crypto/ecdh: internal error: mismatched isLess inputs") if a.size != b.size
  # Copy the values into a fixed-size preallocated little-endian buffer.
  # 72 bytes is enough for every scalar in this package, and having a fixed
  # size lets us avoid heap allocations.
  panic("crypto/ecdh: internal error: isLess input too large") if a.size > 72
  buf_a = [0.as_u8; 72]
  buf_b = [0.as_u8; 72]
  i = 0
  while i < a.size {
    buf_a[i] = a[a.size - i - 1]
    buf_b[i] = b[b.size - i - 1]
    i += 1
  }
  # Perform a subtraction with borrow.
  borrow: U64 = 0
  i = 0
  while i < 72 {
    limb_a = le_u64(buf_a, i)
    limb_b = le_u64(buf_b, i)
    d = limb_a - limb_b - borrow
    borrow = ((^limb_a & limb_b) | (^(limb_a ^ limb_b) & d)) >> 63
    i += 8
  }
  # If there is a borrow at the end of the operation, then a < b.
  borrow == 1
}

def le_u64(b: [Byte], i: Int) -> U64 {
  v: U64 = 0
  k = 7
  while k >= 0 {
    v = (v << 8) | b[i + k].as_u64
    k -= 1
  }
  v
}
