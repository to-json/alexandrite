# Go's crypto/ecdh/ecdh_wycheproof_test.go: runECDHWycheproofTest
# (vec_wycheproof_test.alx has the vectors, with shouldPass computed from
# Go's flag tables by the generator).
import "encoding/hex"

def wp(curve: Curve, public: Str, private: Str, shared: Str, should_pass: Bool, invalid: Bool, key_size: Int) {
  pr = curve.new_public_key(hex.decode_string(public).unwrap)
  if pr.err? {
    assert !should_pass, "parsePub: #{pr.err.unwrap.message} (#{public})"
    return nil
  }
  priv_bytes = hex.decode_string(private).unwrap
  kr = curve.new_private_key(priv_bytes)
  if kr.err? {
    assert !(should_pass && priv_bytes.size == key_size), "NewPrivateKey: #{kr.err.unwrap.message}"
    return nil
  }
  xr = kr.unwrap.ecdh(pr.unwrap)
  if xr.err? {
    assert !should_pass, "ECDH: #{xr.err.unwrap.message}"
    return nil
  }
  x = hex.encode_to_string(xr.unwrap)
  if should_pass {
    assert x == shared, "ECDH = #{x}, want #{shared}"
  } else if invalid {
    # For invalid inputs, a correct ECDH result is a test failure.
    assert x != shared, "ECDH = #{x}, want anything else"
  }
  nil
}
