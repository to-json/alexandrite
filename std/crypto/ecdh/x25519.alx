#![overflow(wrap)]
# Go's crypto/ecdh/x25519.go: the X25519 function (RFC 7748) as a Montgomery
# ladder over crypto/internal/fips140/edwards25519/field, with constant-time
# conditional swaps.
import "crypto/internal/fips140/edwards25519/field"

X25519_PUBLIC_KEY_SIZE = 32
X25519_PRIVATE_KEY_SIZE = 32
X25519_SHARED_SECRET_SIZE = 32

# Writes X25519(scalar, point) into dst (32 bytes each).
def x25519_scalar_mult(dst: [Byte], scalar: [Byte], point: [Byte]) {
  e = [0.as_u8; 32]
  copy(e, scalar[0...32])
  e[0] = e[0] & 248
  e[31] = e[31] & 127
  e[31] = e[31] | 64

  x1 = field.set_bytes(point[0...32]).unwrap
  x2 = field.one()
  z2 = field.zero()
  x3 = x1
  z3 = field.one()

  swap = 0
  pos = 254
  while pos >= 0 {
    b = (e[pos / 8] >> (pos & 7)) & 1
    swap = swap ^ b.to_i
    s = field.swap(x2, x3, swap)
    x2 = s[0]
    x3 = s[1]
    s = field.swap(z2, z3, swap)
    z2 = s[0]
    z3 = s[1]
    swap = b.to_i

    tmp0 = x3.subtract(z3)
    tmp1 = x2.subtract(z2)
    x2 = x2.add(z2)
    z2 = x3.add(z3)
    z3 = tmp0.multiply(x2)
    z2 = z2.multiply(tmp1)
    tmp0 = tmp1.square
    tmp1 = x2.square
    x3 = z3.add(z2)
    z2 = z3.subtract(z2)
    x2 = tmp1.multiply(tmp0)
    tmp1 = tmp1.subtract(tmp0)
    z2 = z2.square

    z3 = tmp1.mult_32(121666)
    x3 = x3.square
    tmp0 = tmp0.add(z3)
    z3 = x1.multiply(z2)
    z2 = tmp1.multiply(tmp0)
    pos -= 1
  }

  s = field.swap(x2, x3, swap)
  x2 = s[0]
  s = field.swap(z2, z3, swap)
  z2 = s[0]

  z2 = z2.invert
  x2 = x2.multiply(z2)
  copy(dst, x2.bytes)
  nil
}
