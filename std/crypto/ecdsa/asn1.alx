# The DER encoding of ECDSA signatures, SEQUENCE { INTEGER r, INTEGER s }:
# the part of golang.org/x/crypto/cryptobyte that Go's crypto/ecdsa uses
# (Builder.AddASN1 with SEQUENCE and INTEGER, String.ReadASN1,
# ReadASN1Integer into []byte and *big.Int), with cryptobyte's checks: DER
# lengths only (minimal, at most 4 length octets, no indefinite form), low
# tag numbers only, minimally encoded integers.

import "math/big"

ASN1_INTEGER: Byte = 0x02
ASN1_SEQUENCE: Byte = 0x30

# Go's encodeSignature: the DER signature of the positive integers r and s
# (big-endian, with any number of leading zeros). Fails for a zero.
def encode_signature(r: [Byte], s: [Byte]) -> ~[Byte] {
  body = ~asn1_int_bytes(r) + ~asn1_int_bytes(s)
  asn1_element(ASN1_SEQUENCE, body)
}

# Go's addASN1IntBytes: the INTEGER element of a positive big-endian
# integer with zero or more leading zeroes.
def asn1_int_bytes(b: [Byte]) -> ~[Byte] {
  i = 0
  while i < b.size && b[i] == 0 {
    i += 1
  }
  fail EcdsaError.InvalidInteger if i == b.size
  content: [Byte] = []
  content << 0 if b[i] & 0x80 != 0
  asn1_element(ASN1_INTEGER, content + b[i...b.size])
}

# tag, the DER length of content, content (cryptobyte's flushChild).
def asn1_element(tag: Byte, content: [Byte]) -> [Byte] {
  out = [tag]
  n = content.size
  if n > 0xffffff {
    out = out + [0x84.as_u8, (n >> 24).as_u8, (n >> 16).as_u8, (n >> 8).as_u8, n.as_u8]
  } else if n > 0xffff {
    out = out + [0x83.as_u8, (n >> 16).as_u8, (n >> 8).as_u8, n.as_u8]
  } else if n > 0xff {
    out = out + [0x82.as_u8, (n >> 8).as_u8, n.as_u8]
  } else if n > 0x7f {
    out = out + [0x81.as_u8, n.as_u8]
  } else {
    out << n.as_u8
  }
  out + content
}

# Go's parseSignature: r and s of a DER signature, as big-endian bytes
# without leading zeros (cryptobyte's ReadASN1Integer into []byte, which
# rejects negative integers). Fails with "invalid ASN.1".
def parse_signature(sig: [Byte]) -> ~([Byte], [Byte]) {
  if seq = asn1_read(sig, ASN1_SEQUENCE) {
    if seq[1].size == 0 {
      if r = asn1_read_int_bytes(seq[0]) {
        if s = asn1_read_int_bytes(r[1]) {
          return (r[0], s[0]) if s[1].size == 0
        }
      }
    }
  }
  fail EcdsaError.InvalidAsn1
}

# r and s of a DER signature as big.Ints (ReadASN1Integer into *big.Int,
# which allows negative integers). Fails with "invalid ASN.1 from
# SignASN1".
def parse_signature_big(sig: [Byte]) -> ~(big.Int, big.Int) {
  if seq = asn1_read(sig, ASN1_SEQUENCE) {
    if seq[1].size == 0 {
      if r = asn1_read_big_int(seq[0]) {
        if s = asn1_read_big_int(r[1]) {
          return (r[0], s[0]) if s[1].size == 0
        }
      }
    }
  }
  fail EcdsaError.InvalidAsn1FromSign
}

# cryptobyte's String.ReadASN1: the contents of the DER element at the
# start of s with the given tag, and the rest of s; none if s doesn't start
# with a valid element with that tag.
def asn1_read(s: [Byte], tag: Byte) -> ([Byte], [Byte])? {
  return none if s.size < 2
  t = s[0]
  len_byte = s[1]
  # High-tag-number form (ITU-T X.690 section 8.1.2) isn't supported.
  return none if t & 0x1f == 0x1f
  length = 0
  header_len = 0
  if len_byte & 0x80 == 0 {
    # Short-form length (section 8.1.3.4), encoded in bits 1-7.
    length = len_byte.to_i + 2
    header_len = 2
  } else {
    # Long-form length (section 8.1.3.5). Bits 1-7 encode the number of
    # octets used to encode the length.
    len_len = (len_byte & 0x7f).to_i
    return none if len_len == 0 || len_len > 4 || s.size < 2 + len_len
    len32 = 0
    i = 0
    while i < len_len {
      len32 = (len32 << 8) | s[2 + i].to_i
      i += 1
    }
    # ITU-T X.690 section 10.1 (DER length forms) requires encoding the
    # length with the minimum number of octets.
    return none if len32 < 128
    return none if (len32 >> ((len_len - 1) * 8)) == 0
    header_len = 2 + len_len
    length = header_len + len32
  }
  return none if s.size < length
  return none if t != tag
  (s[header_len...length], s[length...s.size])
}

# cryptobyte's checkASN1Integer: an INTEGER's contents are at least one
# octet and minimally encoded.
def asn1_integer_ok?(b: [Byte]) -> Bool {
  return false if b.size == 0
  return true if b.size == 1
  return false if (b[0] == 0 && b[1] & 0x80 == 0) || (b[0] == 0xff && b[1] & 0x80 == 0x80)
  true
}

# cryptobyte's readASN1Bytes: a non-negative INTEGER as big-endian bytes
# without leading zeros (but at least one byte), and the rest.
def asn1_read_int_bytes(s: [Byte]) -> ([Byte], [Byte])? {
  if e = asn1_read(s, ASN1_INTEGER) {
    b = e[0]
    return none if !asn1_integer_ok?(b)
    return none if b[0] & 0x80 == 0x80
    i = 0
    while b.size - i > 1 && b[i] == 0 {
      i += 1
    }
    return (b[i...b.size], e[1])
  }
  none
}

# cryptobyte's readASN1BigInt: an INTEGER (two's complement) as a big.Int,
# and the rest.
def asn1_read_big_int(s: [Byte]) -> (big.Int, [Byte])? {
  if e = asn1_read(s, ASN1_INTEGER) {
    b = e[0]
    return none if !asn1_integer_ok?(b)
    out = big.Int.new
    if b[0] & 0x80 == 0x80 {
      # Negative number.
      neg = [0.as_u8; b.size]
      i = 0
      while i < b.size {
        neg[i] = ^b[i]
        i += 1
      }
      out.set_bytes!(neg)
      out.add!(out, big.new_int(1))
      out.neg!(out)
    } else {
      out.set_bytes!(b)
    }
    return (out, e[1])
  }
  none
}
