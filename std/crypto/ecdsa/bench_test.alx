import "crypto"
import "crypto/elliptic"

# Go's BenchmarkSign / BenchmarkVerify / BenchmarkGenerateKey on P-256 and
# P-384 (and P-521 for signing). The keys are RFC 6979's (A.2.5, A.2.6,
# A.2.7), built from their components so that the benches time only the
# operation; the signatures are their RFC 6979 signatures of "testing"
# (checked by "bench vectors").

def bench_key(c: elliptic.Curve, d: Str, x: Str, y: Str) -> PrivateKey {
  PrivateKey.new(d: from_hex(d), public_key: PublicKey.new(curve: c, x: from_hex(x), y: from_hex(y)))
}

def p256_key -> PrivateKey {
  bench_key(elliptic.p256(),
    "C9AFA9D845BA75166B5C215767B1D6934E50C3DB36E89B127B8A622B120F6721",
    "60FED4BA255A9D31C961EB74C6356D68C049B8923B61FA6CE669622E60F29FB6",
    "7903FE1008B8BC99A41AE9E95628BC64F2F1B20C2D7E9F5177A3C294D4462299")
}

def p384_key -> PrivateKey {
  bench_key(elliptic.p384(),
    "6B9D3DAD2E1B8C1C05B19875B6659F4DE23C3B667BF297BA9AA47740787137D896D5724E4C70A825F872C9EA60D2EDF5",
    "EC3A4E415B4E19A4568618029F427FA5DA9A8BC4AE92E02E06AAE5286B300C64DEF8F0EA9055866064A254515480BC13",
    "8015D9B72D7D57244EA8EF9AC0C621896708A59367F9DFB9F54CA84B3F1C9DB1288B231C3AE0D4FE7344FD2533264720")
}

def p521_key -> PrivateKey {
  bench_key(elliptic.p521(),
    "0FAD06DAA62BA3B25D2FB40133DA757205DE67F5BB0018FEE8C86E1B68C7E75CAA896EB32F1F47C70855836A6D16FCC1466F6D8FBEC67DB89EC0C08B0E996B83538",
    "1894550D0785932E00EAA23B694F213F8C3121F86DC97A04E5A7167DB4E5BCD371123D46E45DB6B5D5370A7F20FB633155D38FFA16D2BD761DCAC474B9A2F5023A4",
    "0493101C962CD4D2FDDF782285E64584139C2F91B47F87FF82354D6630F746A28A0DB25741B5B34A828008B22ACC23F924FAAFBD4D33F81EA66956DFEAA2BFDFCF5")
}

P256_SIG = "3045022100fc626bf1a002d3b906b3b1ddb5bb644faed739049f6bb4d85c7b1548fbec8b820220167b2974dc136a6221310c79f95ca337b311e949f88c1c342c4bcd88a53c69b0"
P384_SIG = "3065023100f39e569b4e45e430dd228b0e110c104b7f53cda9dea2612c97d7e9e46b1a922303dc09e05f3b428ec8f4d57540999b1002301e2b1e32526161b7f71f51b09c14c81ad4c643c848d9694817a7758677eb73b5b6862db43a981d10f654a769a2fa6cd4"

test "bench vectors" {
  assert_eq to_hex(p256_key().sign_deterministic(digest(crypto.SHA256, "testing".bytes), crypto.SHA256).unwrap), P256_SIG
  assert_eq to_hex(p384_key().sign_deterministic(digest(crypto.SHA384, "testing".bytes), crypto.SHA384).unwrap), P384_SIG
}

bench "Sign P256" {
  sig = sign_asn1(crand(), p256_key(), "testing".bytes).unwrap
  assert sig.size > 0, "bench"
}

bench "Sign P384" {
  sig = sign_asn1(crand(), p384_key(), "testing".bytes).unwrap
  assert sig.size > 0, "bench"
}

bench "Sign P521" {
  sig = sign_asn1(crand(), p521_key(), "testing".bytes).unwrap
  assert sig.size > 0, "bench"
}

bench "Verify P256" {
  ok = verify_asn1(p256_key().public_key, digest(crypto.SHA256, "testing".bytes), unhex(P256_SIG))
  assert ok, "bench"
}

bench "Verify P384" {
  ok = verify_asn1(p384_key().public_key, digest(crypto.SHA384, "testing".bytes), unhex(P384_SIG))
  assert ok, "bench"
}

bench "GenerateKey P256" {
  k = generate_key(elliptic.p256(), crand()).unwrap
  assert k.d.sign > 0, "bench"
}

bench "GenerateKey P384" {
  k = generate_key(elliptic.p384(), crand()).unwrap
  assert k.d.sign > 0, "bench"
}
