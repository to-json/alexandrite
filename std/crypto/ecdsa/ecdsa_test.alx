test "ParseAndBytesRoundTrip" {
  for t in all_curves() {
    next if t[0].end_with?("/Generic") # these methods don't support generic curves
    curve = t[1]
    priv = generate_key(curve, crand()).unwrap

    b = priv.public_key.bytes.unwrap
    assert_eq b[0], 4.as_u8
    p = parse_uncompressed_public_key(curve, b).unwrap
    assert priv.public_key.equal?(p), "#{t[0]}: parsed private key's public key doesn't match original"

    bk = priv.bytes.unwrap
    k = parse_raw_private_key(curve, bk).unwrap
    assert priv.equal?(k), "#{t[0]}: parsed private key doesn't match original"

    if curve.nist_bits != 224 {
      priv_ecdh = priv.ecdh.unwrap
      pp = priv_ecdh.curve.new_public_key(b).unwrap
      assert priv_ecdh.public_key.equal?(pp), "#{t[0]}: parsed ECDH public key doesn't match original"
      assert pp.bytes == b, "#{t[0]}: encoded ECDH public key doesn't match Bytes"
      kk = priv_ecdh.curve.new_private_key(bk).unwrap
      assert priv_ecdh.equal?(kk), "#{t[0]}: parsed ECDH private key doesn't match original"
      assert kk.bytes == bk, "#{t[0]}: encoded ECDH private key doesn't match Bytes"
      assert priv.public_key.ecdh.unwrap.equal?(pp), "#{t[0]}: PublicKey.ECDH"
    } else {
      assert_eq err_text(priv.ecdh), "ecdsa: unsupported curve by crypto/ecdh"
    }
  }
  # The generic curve: Bytes and the parsers reject it.
  g: elliptic.Curve = elliptic.p256().params
  gk = generate_key(g, crand()).unwrap
  assert_eq err_text(gk.public_key.bytes), "ecdsa: curve not supported by PublicKey.bytes"
  assert_eq err_text(gk.bytes), "ecdsa: curve not supported by PrivateKey.bytes"
  assert_eq err_text(parse_raw_private_key(g, gk.d.fill_bytes([0.as_u8; 32]))), "ecdsa: curve not supported by parse_raw_private_key"
}

test "InvalidPublicKeys" {
  for t in all_curves() {
    curve = t[1]
    size = 1 + 2 * ((curve.params.bit_size + 7) / 8)

    # Infinity
    k = PublicKey.new(curve: curve, x: big.new_int(0), y: big.new_int(0))
    assert k.bytes.err?, "#{t[0]}: PublicKey.Bytes accepted infinity"
    assert parse_uncompressed_public_key(curve, [0.as_u8]).err?, "#{t[0]}: ParseUncompressedPublicKey accepted infinity"
    b = [0.as_u8; size]
    b[0] = 4
    assert parse_uncompressed_public_key(curve, b).err?, "#{t[0]}: ParseUncompressedPublicKey accepted infinity"

    # NotOnCurve
    kk = generate_key(curve, crand()).unwrap.public_key
    kk.x.add!(kk.x, big.new_int(1))
    assert kk.bytes.err?, "#{t[0]}: PublicKey.Bytes accepted not on curve"
    b = [0.as_u8; size]
    b[0] = 4
    kk.x.fill_bytes(b[1...1 + b.size / 2])
    kk.y.fill_bytes(b[1 + b.size / 2...b.size])
    assert parse_uncompressed_public_key(curve, b).err?, "#{t[0]}: ParseUncompressedPublicKey accepted not on curve"

    # Compressed
    kc = generate_key(curve, crand()).unwrap.public_key
    bc = elliptic.marshal_compressed(curve, kc.x, kc.y)
    assert parse_uncompressed_public_key(curve, bc).err?, "#{t[0]}: ParseUncompressedPublicKey accepted compressed key"
  }
}

test "InvalidPrivateKeys" {
  for t in all_curves() {
    curve = t[1]
    size = (curve.params.bit_size + 7) / 8

    # Zero
    k = PrivateKey.new(public_key: PublicKey.new(curve: curve, x: big.new_int(0), y: big.new_int(0)), d: big.new_int(0))
    assert k.bytes.err?, "#{t[0]}: PrivateKey.Bytes accepted zero key"
    assert parse_raw_private_key(curve, [0.as_u8; size]).err?, "#{t[0]}: ParseRawPrivateKey accepted zero key"

    # Overflow
    d = big.Int.new
    d.add!(curve.params.n, big.new_int(5))
    xy = curve.scalar_base_mult(d.bytes)
    ko = PrivateKey.new(public_key: PublicKey.new(curve: curve, x: xy[0], y: xy[1]), d: d)
    assert ko.bytes.err?, "#{t[0]}: PrivateKey.Bytes accepted overflow key"
    b = [0.as_u8; size]
    ko.d.fill_bytes(b)
    assert parse_raw_private_key(curve, b).err?, "#{t[0]}: ParseRawPrivateKey accepted overflow key"

    # Length
    assert parse_raw_private_key(curve, [1.as_u8, 2, 3]).err?, "#{t[0]}: ParseRawPrivateKey accepted short key"
    assert parse_raw_private_key(curve, [0.as_u8; size] + [1.as_u8, 2, 3]).err?, "#{t[0]}: ParseRawPrivateKey accepted long key"
  }
}

# ---- Go's equal_test.go ----

def check_equal(c: elliptic.Curve) {
  private = generate_key(c, crand()).unwrap
  public = private.public_key

  assert public.equal?(public), "public key is not equal to itself"
  assert private.equal?(private), "private key is not equal to itself"
  # Go: crypto.Signer(private).Public().(*ecdsa.PublicKey).
  signer: crypto.Signer = private
  _ = signer.public
  assert public.equal?(private.public_key), "private.Public() is not Equal to public"

  # Go round-trips through x509 PKCS#8 (not in alx yet): the raw encodings
  # instead.
  decoded = parse_raw_private_key(c, private.bytes.unwrap).unwrap
  assert public.equal?(decoded.public_key), "public key is not equal to itself after decoding"
  assert private.equal?(decoded), "private key is not equal to itself after decoding"

  other = generate_key(c, crand()).unwrap
  assert !public.equal?(other.public_key), "different public keys are Equal"
  assert !private.equal?(other), "different private keys are Equal"

  # Ensure that keys with the same coordinates but on different curves
  # aren't considered Equal.
  different_curve = public
  if c.nist_bits == 256 {
    different_curve.curve = elliptic.p224()
  } else {
    different_curve.curve = elliptic.p256()
  }
  assert !public.equal?(different_curve), "public keys with different curves are Equal"
}

test "Equal" {
  check_equal(elliptic.p224())
  check_equal(elliptic.p256())
  check_equal(elliptic.p384())
  check_equal(elliptic.p521())
}

# ---- Go's internal ecdsa_test.go and cast.go ----

def check_random_point(c: Curve) {
  # A sequence of all ones will generate 2^N-1, which should be rejected.
  # (Unless, for example, we are masking too many bits.)
  r = PrefixReader.new(st: [[0xff.as_u8; 100]])
  kpl = random_point(c, Source.new(rand: r), false).unwrap
  assert kpl[0].is_zero == 0, "k is zero"
  assert_eq kpl[1][0], 4.as_u8
  assert kpl[2] > 0, "#{c.curve}: overflow was not rejected"

  # A sequence of all zeroes will generate zero, which should be rejected.
  r = PrefixReader.new(st: [[0.as_u8; 100]])
  kpl = random_point(c, Source.new(rand: r), false).unwrap
  assert kpl[0].is_zero == 0, "k is zero"
  assert_eq kpl[1][0], 4.as_u8
  assert kpl[2] > 0, "#{c.curve}: zero was not rejected"

  # P-256 has a 2⁻³² chance of randomly hitting a rejection. For P-224
  # it's 2⁻¹¹², for P-384 it's 2⁻¹⁹⁴, and for P-521 it's 2⁻²⁶², so if we
  # hit in tests, something is horribly wrong. (For example, we are
  # masking the wrong bits.)
  return nil if c.curve == P256_ID
  kpl = random_point(c, Source.new(rand: crand()), false).unwrap
  assert kpl[0].is_zero == 0, "k is zero"
  assert_eq kpl[1][0], 4.as_u8
  assert_eq kpl[2], 0
}

test "RandomPoint" {
  check_random_point(fips_p224())
  check_random_point(fips_p256())
  check_random_point(fips_p384())
  check_random_point(fips_p521())
}

test "HashToNat" {
  for c in [fips_p224(), fips_p256(), fips_p384(), fips_p521()] {
    l = 0
    while l < 600 {
      _ = hash_to_nat(c, [0xff.as_u8; l])
      l += 1
    }
  }
}

# The key and hash of Go's cast.go (RFC 9500, Section 2.3).
def cast_key -> FipsPrivateKey {
  q = unhex("04" + "422548f88fb782ffb5eca3744452c72a1e558fbd6f73be5e48e93232cc45c5b1" +
      "6c4cd10c4cb8d5b8a17139e94882c8992572993425f41419ab7e90a42a494272")
  d = unhex("e6cb5bdd80aa45ae9c95e8c15476679ffec953c16851e711e743939589c64fc1")
  FipsPrivateKey.new(pubk: FipsPublicKey.new(curve: P256_ID, q: q), d: d)
}

def cast_hash -> [Byte] {
  unhex("171b1f5e9f8f8c5c42e806597b54c7b44905a1db3a3c31d3b756458cc2d68862" + "9ed67b9b2568d6c618941efee33378a6e1ce138881260252dfc20af267490a20")
}

test "CAST ECDSA P-256 SHA2-512 sign and verify" {
  k = cast_key()
  z = unhex("0102030405060708090a0b0c0d0e0f10")
  pers = unhex("1112131415161718191a1b1c1d1e1f20")
  hash = cast_hash()
  drbg = new_drbg(sha512_ctor(), z, [], Personalization.Plain(pers))
  got = sign_generic(fips_p256(), k, drbg, hash).unwrap
  assert fips_verify(fips_p256(), k.pubk, hash, got).ok?, "verify"
  assert_eq to_hex(got.r), "336496ff8afeaa0b2c4a1a9777cc84a57e881f162de029f762c23418109c698a"
  assert_eq to_hex(got.s), "97532e136ed09b308adf4fe0548214835e93c7794b18a3f18a60ae5231e42e4e"
}

test "CAST DetECDSA P-256 SHA2-512 sign" {
  k = cast_key()
  hash = cast_hash()
  got = fips_sign_deterministic(fips_p256(), sha512_ctor(), k, hash).unwrap
  assert fips_verify(fips_p256(), k.pubk, hash, got).ok?, "verify"
  assert_eq to_hex(got.r), "9fc383326ed94f8e24a019ef1d3ac355dd4b98ae78a7afd3fdf3221c8bd6117b"
  assert_eq to_hex(got.s), "d652874171bd66d1af6c61ddd8a7bbd2f7d54770e9e4ac0ab9fa0fbd3b9bc2fe"
}

# ---- local: DER encoding, ChaCha8, errors ----

test "signature DER encoding" {
  assert_eq to_hex(encode_signature([0.as_u8, 0, 1], [0x80.as_u8]).unwrap), "3007020101020200" + "80"
  assert_eq err_text(encode_signature([0.as_u8], [1.as_u8])), "invalid integer"
  rs = parse_signature(unhex("3007020101020200" + "80")).unwrap
  assert_eq to_hex(rs[0]), "01"
  assert_eq to_hex(rs[1]), "80"
  # Not minimal, negative, trailing data, BER length, wrong tag.
  assert parse_signature(unhex("300802020001020200" + "80")).err?
  assert parse_signature(unhex("30060201ff020101")).err?
  assert parse_signature(unhex("300602010102010100")).err?
  assert parse_signature(unhex("30810602010102010" + "1")).err?
  assert parse_signature(unhex("310602010102010" + "1")).err?
  big_rs = parse_signature_big(unhex("30060201ff020101")).unwrap
  assert_eq big_rs[0].to_s, "-1"
  # Long-form lengths.
  long = [0x7f.as_u8; 200]
  enc = encode_signature(long, long).unwrap
  assert_eq to_hex(enc[0...4]), "30820196"
  rs2 = parse_signature(enc).unwrap
  assert rs2[0] == long && rs2[1] == long
}

test "ChaCha8 matches Go" {
  # Go: rand.NewChaCha8([32]byte("chacha8 seed for the ecdsa test!")); the
  # first 20 bytes, then 1000 more read in pieces of 7, then 2000 more.
  rng = new_chacha8("chacha8 seed for the ecdsa test!".bytes)
  a = [0.as_u8; 20]
  rng.read!(a)
  assert_eq to_hex(a), "78db992c6670a0ee7d2adf58930d0b42f0a97586"
  all: [Byte] = []
  i = 0
  while i < 1000 {
    p = [0.as_u8; 7]
    rng.read!(p)
    all = all + p
    i += 7
  }
  b = [0.as_u8; 2000]
  rng.read!(b)
  assert_eq to_hex(sha256.sum256(all + b).to_a), "d352071a0a1f27e58aa9d648d35111e233c5f5fb9a628137e9d08fbb2eeb03ee"
}
