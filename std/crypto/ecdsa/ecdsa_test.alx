import "crypto"
import "crypto/elliptic"
import "crypto/sha256"
import "math/big"

# Go's ecdsa_test.go, translated. testAllCurves runs each check on P-256,
# P-224, P-384, P-521 and P-256's CurveParams (the generic path; see
# all_curves). TestVectors (testdata/SigVer.rsp.bz2) is
# vec_sigver_test.alx, TestKeyGenerationVectors (testdata/det-keygen.json)
# is vec_detkeygen_test.alx, ecdsa_wycheproof_test.go is
# vec_wycheproof_test.alx: 1582 of the 8678 tests of the 17 files Go
# reads, all 484 of ecdsa_secp256r1_sha256 and, from each other file, the
# first 4 tests of each (result, flags) kind. vec_det_test.alx and
# vec_hedged_test.alx check keys and signatures byte for byte against Go's
# (RFC 6979 and hedged with GODEBUG=cryptocustomrand=1, including the
# legacy path).
#
# Differences in the translation:
#   - TestEmptyHashRejection / TestSignHashLength: Go's nil opts (no hash
#     check) and nil rand (deterministic) don't exist in alx; nil-rand
#     cases call sign_deterministic, and "opts == nil skips the length
#     check" is sign_asn1 (which has no opts). crypto.Hash(0) is ZeroHash
#     below (hash_func none).
#   - The "%T" of Go's messages and t.Parallel / TestAllImplementations
#     (Go's assembly vs generic implementations; alx has one) are dropped.

# Go's crypto.Hash(0) as SignerOpts: no hash.
struct ZeroHash {
  def hash_func -> crypto.Hash? { none }
}

test "KeyGeneration" {
  for t in all_curves() {
    c = t[1]
    priv = generate_key(c, crand()).unwrap
    assert c.on_curve?(priv.public_key.x, priv.public_key.y), "#{t[0]}: public key invalid"
  }
}

test "SignAndVerify" {
  for t in all_curves() {
    priv = generate_key(t[1], crand()).unwrap
    hashed = "testing".bytes
    rs = sign(crand(), priv, hashed).unwrap
    assert verify(priv.public_key, hashed, rs[0], rs[1]), "#{t[0]}: Verify failed"
    hashed[0] = hashed[0] ^ 0xff
    assert !verify(priv.public_key, hashed, rs[0], rs[1]), "#{t[0]}: Verify always works!"
  }
}

test "SignAndVerifyASN1" {
  for t in all_curves() {
    priv = generate_key(t[1], crand()).unwrap
    hashed = "testing".bytes
    sig = sign_asn1(crand(), priv, hashed).unwrap
    assert verify_asn1(priv.public_key, hashed, sig), "#{t[0]}: VerifyASN1 failed"
    hashed[0] = hashed[0] ^ 0xff
    assert !verify_asn1(priv.public_key, hashed, sig), "#{t[0]}: VerifyASN1 always works!"
  }
}

test "EmptyHashRejection" {
  for t in all_curves() {
    priv = generate_key(t[1], crand()).unwrap
    empty: [Byte] = []

    # SignASN1
    r = sign_asn1(crand(), priv, empty)
    assert r.err?, "SignASN1 with empty hash should fail"
    assert err_text(r).include?("cannot be empty"), "unexpected error: #{err_text(r)}"

    # Sign
    r = priv.sign(crand(), empty, crypto.SHA256)
    assert r.err?, "Sign with empty hash should fail"

    # SignDeterministic
    r = priv.sign_deterministic(empty, crypto.SHA256)
    assert r.err?, "deterministic Sign with empty hash should fail"

    # VerifyASN1
    hash = "test hash".bytes
    sig = sign_asn1(crand(), priv, hash).unwrap
    assert !verify_asn1(priv.public_key, empty, sig), "VerifyASN1 with empty hash should return false"
  }
}

test "SignHashLength" {
  for t in all_curves() {
    priv = generate_key(t[1], crand()).unwrap
    dg = sha256.sum256("message".bytes).to_a

    # Go's opts == nil (no length check): sign_asn1.
    assert sign_asn1(crand(), priv, dg).ok?, "Sign with nil opts"

    # opts with matching hash length succeeds.
    assert priv.sign(crand(), dg, crypto.SHA256).ok?, "Sign with matching hash"

    # opts with mismatched hash length fails.
    assert priv.sign(crand(), dg, crypto.SHA384).err?, "Sign with mismatched hash length should fail"
    assert priv.sign(crand(), dg[0...dg.size - 1], crypto.SHA256).err?, "Sign with short digest should fail"
    assert priv.sign(crand(), [], crypto.SHA256).err?, "Sign with empty digest should fail"

    # opts.HashFunc() == 0 errors cleanly.
    r = priv.sign(crand(), dg, ZeroHash.new)
    assert_eq err_text(r), "ecdsa: sign must be called with a hash, not with crypto.Hash(0)"
  }
}

test "NonceSafety" {
  for t in all_curves() {
    priv = generate_key(t[1], crand()).unwrap
    rs0 = sign(ZeroReader.new, priv, "testing".bytes).unwrap
    rs1 = sign(ZeroReader.new, priv, "testing...".bytes).unwrap
    # This should never happen.
    assert rs0[1].cmp(rs1[1]) != 0, "#{t[0]}: the signatures on two different messages were the same"
    assert rs0[0].cmp(rs1[0]) != 0, "#{t[0]}: the nonce used for two different messages was the same"
  }
}

test "INDCCA" {
  for t in all_curves() {
    priv = generate_key(t[1], crand()).unwrap
    rs0 = sign(crand(), priv, "testing".bytes).unwrap
    rs1 = sign(crand(), priv, "testing".bytes).unwrap
    assert rs0[1].cmp(rs1[1]) != 0, "#{t[0]}: two signatures of the same message produced the same result"
    assert rs0[0].cmp(rs1[0]) != 0, "#{t[0]}: two signatures of the same message produced the same nonce"
  }
}

test "NegativeInputs" {
  for t in all_curves() {
    key = generate_key(t[1], crand()).unwrap
    hash = [0.as_u8; 32]
    r = big.new_int(1)
    r.lsh!(r, 550) # larger than any supported curve
    r.neg!(r)
    assert !verify(key.public_key, hash, r, r), "#{t[0]}: bogus signature accepted"
  }
}

test "ZeroHashSignature" {
  for t in all_curves() {
    zero_hash = [0.as_u8; 64]
    priv = generate_key(t[1], crand()).unwrap
    # Sign a hash consisting of all zeros.
    rs = sign(crand(), priv, zero_hash).unwrap
    # Confirm that it can be verified.
    assert verify(priv.public_key, zero_hash, rs[0], rs[1]), "#{t[0]}: zero hash signature verify failed"
  }
}

test "ZeroSignature" {
  for t in all_curves() {
    priv = generate_key(t[1], crand()).unwrap
    assert !verify(priv.public_key, [0.as_u8; 64], big.new_int(0), big.new_int(0)), "#{t[0]}: Verify with r,s=0 succeeded"
  }
}

test "NegativeSignature" {
  for t in all_curves() {
    zero_hash = [0.as_u8; 64]
    priv = generate_key(t[1], crand()).unwrap
    rs = sign(crand(), priv, zero_hash).unwrap
    r = rs[0]
    r.neg!(r)
    assert !verify(priv.public_key, zero_hash, r, rs[1]), "#{t[0]}: Verify with r=-r succeeded"
  }
}

test "RPlusNSignature" {
  for t in all_curves() {
    zero_hash = [0.as_u8; 64]
    priv = generate_key(t[1], crand()).unwrap
    rs = sign(crand(), priv, zero_hash).unwrap
    r = rs[0]
    r.add!(r, t[1].params.n)
    assert !verify(priv.public_key, zero_hash, r, rs[1]), "#{t[0]}: Verify with r=r+n succeeded"
  }
}

test "RMinusNSignature" {
  for t in all_curves() {
    zero_hash = [0.as_u8; 64]
    priv = generate_key(t[1], crand()).unwrap
    rs = sign(crand(), priv, zero_hash).unwrap
    r = rs[0]
    r.sub!(r, t[1].params.n)
    assert !verify(priv.public_key, zero_hash, r, rs[1]), "#{t[0]}: Verify with r=r-n succeeded"
  }
}

#[track_caller]
def check_rfc6979(curve: elliptic.Curve, d: Str, x: Str, y: Str, msg: Str, r: Str, s: Str) {
  priv = PrivateKey.new(d: from_hex(d), public_key: PublicKey.new(curve: curve, x: from_hex(x), y: from_hex(y)))
  h = sha256.sum256(msg.bytes).to_a
  sig = priv.sign_deterministic(h, crypto.SHA256).unwrap
  expected = test_encode_signature(from_hex(r).bytes, from_hex(s).bytes)
  assert_eq to_hex(sig), to_hex(expected)
}

# Go's test-local encodeSignature (cryptobyte).
def test_encode_signature(r: [Byte], s: [Byte]) -> [Byte] {
  body = test_asn1_int(r) + test_asn1_int(s)
  return [0x30.as_u8, 0x81, body.size.as_u8] + body if body.size > 0x7f
  [0x30.as_u8, body.size.as_u8] + body
}

def test_asn1_int(b: [Byte]) -> [Byte] {
  i = 0
  while b[i] == 0 {
    i += 1
  }
  c = b[i...b.size]
  c = [0.as_u8] + c if c[0] & 0x80 != 0
  [0x02.as_u8, c.size.as_u8] + c
}

test "RFC6979 P-224" {
  check_rfc6979(elliptic.p224(),
    "F220266E1105BFE3083E03EC7A3A654651F45E37167E88600BF257C1",
    "00CF08DA5AD719E42707FA431292DEA11244D64FC51610D94B130D6C",
    "EEAB6F3DEBE455E3DBF85416F7030CBD94F34F2D6F232C69F3C1385A",
    "sample",
    "61AA3DA010E8E8406C656BC477A7A7189895E7E840CDFE8FF42307BA",
    "BC814050DAB5D23770879494F9E0A680DC1AF7161991BDE692B10101")
  check_rfc6979(elliptic.p224(),
    "F220266E1105BFE3083E03EC7A3A654651F45E37167E88600BF257C1",
    "00CF08DA5AD719E42707FA431292DEA11244D64FC51610D94B130D6C",
