import "crypto/elliptic"
import "crypto/rand"
import "crypto/sha256"

# Go's example_test.go. Go's Example has no Output comment (the signature
# is random); here only the verification result is printed.
example "ecdsa" {
  private_key = generate_key(elliptic.p256(), rand.reader()).unwrap

  msg = "hello, world"
  hash = sha256.sum256(msg.bytes).to_a

  sig = sign_asn1(rand.reader(), private_key, hash).unwrap
  _ = sig

  valid = verify_asn1(private_key.public_key, hash, sig)
  puts "signature verified: #{valid}"
} outputs "signature verified: true\n"
