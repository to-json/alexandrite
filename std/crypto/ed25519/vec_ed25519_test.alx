# Generated from Go's crypto/ed25519 (go1.27.1): Ed25519, Ed25519ph and Ed25519ctx signatures for deterministic seeds; do not edit by hand.
import "crypto"
import "crypto/rand"
import "encoding/hex"

def xh(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

def check_variant(seed: Str, pub_hex: Str, msg: Str, ph: Bool, context: Str, sig: Str) {
  priv = new_key_from_seed(xh(seed))
  assert_eq hex.encode_to_string(priv.public_key.bytes), pub_hex
  opts = Options.new(context: context)
  opts = Options.new(hash: crypto.SHA512, context: context) if ph
  got = priv.sign_options(rand.reader(), xh(msg), opts).unwrap
  assert_eq hex.encode_to_string(got), sig
  assert !verify_with_options(PublicKey.new(xh(pub_hex)), xh(msg), got, opts).err?, "verify #{seed}"
}

