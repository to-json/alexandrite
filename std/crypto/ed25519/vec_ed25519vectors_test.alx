# Generated from filippo.io/mostly-harmless/ed25519vectors@v0.0.0-20210322192420-30a2d7243a94 ed25519vectors.json (all 768 vectors; Go's TestEd25519Vectors); do not edit by hand.
#
# A very large set of test vectors that exercise all combinations of
# low-order points, low-order components, and non-canonical encodings. They
# lock in unspecified and spec-divergent behaviors in edge cases that are
# not security relevant in most contexts, but that can cause issues in
# consensus applications if changed. The behavior matches the "classic"
# unwritten verification rules of the "ref10" reference implementation.
# See https://hdevalence.ca/blog/2020-10-04-its-25519am.
#
# Go downloads the JSON from the module proxy at test time; std tests are
# self-contained, so the vectors are inlined. The expected result follows
# Go's test: a vector verifies unless its flags include LowOrderResidue
# (the simplified verification formula doesn't multiply by the cofactor)
# or NonCanonicalR (R is recomputed and compared bytewise against the
# canonical encoding); the generator checked Go agrees on every vector.
import "encoding/hex"

def eh(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

def check_vector(i: Int, a: Str, r: Str, s: Str, m: Str, want: Bool) {
  got = verify(PublicKey.new(eh(a)), eh(m), eh(r) + eh(s))
  assert got == want, "##{i}: verify gave #{got}, want #{want}"
}

