# One of the named curves (Go's unexported nistCurve[Point]): bits (224,
# 256, 384 or 521) selects the nistec point type. Make it with p224(),
# p256(), p384() or p521().
pub struct NistCurve {
  bits: Int
  prm: CurveParams

  # The parameters of the curve.
  pub def params -> CurveParams { prm }

  # The bit size of the named curve (224, 256, 384 or 521).
  pub def nist_bits -> Int { bits }

  # Whether (x, y) is a point on the curve; false for the point at infinity
  # (0, 0) and for coordinates out of range.
  pub def on_curve?(x: big.Int, y: big.Int) -> Bool {
    # IsOnCurve is documented to reject (0, 0), the conventional point at
    # infinity, which however is accepted by point_from_affine.
    return false if x.sign == 0 && y.sign == 0
    enc = point_from_affine(x, y)
    return false if enc == none
    nist_decode(bits, enc.unwrap)
  }

  # (x1, y1) + (x2, y2).
  pub def add(x1: big.Int, y1: big.Int, x2: big.Int, y2: big.Int) -> (big.Int, big.Int) {
    msg = "crypto/elliptic: Add was called on an invalid point"
    b1 = point_from_affine(x1, y1)
    b2 = point_from_affine(x2, y2)
    panic(msg) if b1 == none || b2 == none
    r = nist_add(bits, b1.unwrap, b2.unwrap)
    panic(msg) if r.err?
    point_to_affine(r.unwrap)
  }

  # 2 * (x1, y1).
  pub def double(x1: big.Int, y1: big.Int) -> (big.Int, big.Int) {
    msg = "crypto/elliptic: Double was called on an invalid point"
    b1 = point_from_affine(x1, y1)
    panic(msg) if b1 == none
    r = nist_double(bits, b1.unwrap)
    panic(msg) if r.err?
    point_to_affine(r.unwrap)
  }

  # scalar * (bx, by).
  pub def scalar_mult(bx: big.Int, by: big.Int, scalar: [Byte]) -> (big.Int, big.Int) {
    b1 = point_from_affine(bx, by)
    panic("crypto/elliptic: scalar_mult was called on an invalid point") if b1 == none
    s = normalize_scalar(scalar)
    r = nist_scalar_mult(bits, b1.unwrap, s)
    panic("crypto/elliptic: scalar_mult was called on an invalid point") if r.err?
    point_to_affine(r.unwrap)
  }

  # scalar * G.
  pub def scalar_base_mult(scalar: [Byte]) -> (big.Int, big.Int) {
    s = normalize_scalar(scalar)
    r = nist_scalar_base_mult(bits, s)
    panic("crypto/elliptic: nistec rejected normalized scalar") if r.err?
    point_to_affine(r.unwrap)
  }

  # The uncompressed SEC 1 encoding of (x, y) (one zero byte for (0, 0)), or
  # none for negative or overflowing coordinates (Go's pointFromAffine,
  # before SetBytes).
  def point_from_affine(x: big.Int, y: big.Int) -> [Byte]? {
    # (0, 0) is by convention the point at infinity, which can't be
    # represented in affine coordinates. See Issue 37294.
    return [0.as_u8] if x.sign == 0 && y.sign == 0
    # Reject values that would not get correctly encoded.
    return none if x.sign < 0 || y.sign < 0
    return none if x.bit_len > prm.bit_size || y.bit_len > prm.bit_size
    # Encode the coordinates and let SetBytes reject invalid points.
    byte_len = (prm.bit_size + 7) / 8
    buf = [0.as_u8; 1 + 2 * byte_len]
    buf[0] = 4 # uncompressed point
    x.fill_bytes(buf[1...1 + byte_len])
    y.fill_bytes(buf[1 + byte_len...1 + 2 * byte_len])
    buf
  }

  # The affine coordinates of an encoded point; (0, 0) for infinity.
  def point_to_affine(out: [Byte]) -> (big.Int, big.Int) {
    return (big.Int.new, big.Int.new) if out.size == 1 && out[0] == 0
    byte_len = (prm.bit_size + 7) / 8
    x = big.Int.new
    x.set_bytes!(out[1...1 + byte_len])
    y = big.Int.new
    y.set_bytes!(out[1 + byte_len...out.size])
    (x, y)
  }

  # The scalar as the curve's byte size: reduced modulo N if longer,
  # zero-extended if shorter.
  def normalize_scalar(scalar: [Byte]) -> [Byte] {
    byte_size = (prm.n.bit_len + 7) / 8
    return scalar if scalar.size == byte_size
    s = big.Int.new
    s.set_bytes!(scalar)
    s.mod!(s, prm.n) if scalar.size > byte_size
    s.fill_bytes([0.as_u8; byte_size])
  }
}

# Whether enc decodes to a point of the curve.
def nist_decode(bits: Int, enc: [Byte]) -> Bool {
  return nistec.P224Point.from_bytes(enc).ok? if bits == 224
  return nistec.P256Point.from_bytes(enc).ok? if bits == 256
  return nistec.P384Point.from_bytes(enc).ok? if bits == 384
  nistec.P521Point.from_bytes(enc).ok?
}

def nist_add(bits: Int, b1: [Byte], b2: [Byte]) -> ~[Byte] {
  if bits == 224 {
    p1_224 = ~nistec.P224Point.from_bytes(b1)
    return p1_224.add(~nistec.P224Point.from_bytes(b2)).bytes
  }
  if bits == 256 {
    p1_256 = ~nistec.P256Point.from_bytes(b1)
    return p1_256.add(~nistec.P256Point.from_bytes(b2)).bytes
  }
  if bits == 384 {
    p1_384 = ~nistec.P384Point.from_bytes(b1)
    return p1_384.add(~nistec.P384Point.from_bytes(b2)).bytes
  }
  p1_521 = ~nistec.P521Point.from_bytes(b1)
  p1_521.add(~nistec.P521Point.from_bytes(b2)).bytes
}

def nist_double(bits: Int, b1: [Byte]) -> ~[Byte] {
  return nistec.P224Point.~from_bytes(b1).double.bytes if bits == 224
  return nistec.P256Point.~from_bytes(b1).double.bytes if bits == 256
  return nistec.P384Point.~from_bytes(b1).double.bytes if bits == 384
  nistec.P521Point.~from_bytes(b1).double.bytes
}

def nist_scalar_mult(bits: Int, b1: [Byte], s: [Byte]) -> ~[Byte] {
  if bits == 224 {
    p_224 = ~nistec.P224Point.from_bytes(b1)
    return p_224.~scalar_mult(s).bytes
  }
  if bits == 256 {
    p_256 = ~nistec.P256Point.from_bytes(b1)
    return p_256.~scalar_mult(s).bytes
  }
  if bits == 384 {
    p_384 = ~nistec.P384Point.from_bytes(b1)
    return p_384.~scalar_mult(s).bytes
  }
  p_521 = ~nistec.P521Point.from_bytes(b1)
  p_521.~scalar_mult(s).bytes
}

def nist_scalar_base_mult(bits: Int, s: [Byte]) -> ~[Byte] {
  return nistec.P224Point.~scalar_base_mult(s).bytes if bits == 224
  return nistec.P256Point.~scalar_base_mult(s).bytes if bits == 256
  return nistec.P384Point.~scalar_base_mult(s).bytes if bits == 384
  nistec.P521Point.~scalar_base_mult(s).bytes
}

def big_from_decimal(s: Str) -> big.Int {
  b = big.Int.new
  r = b.set_string!(s, 10)
  panic("crypto/elliptic: internal error: invalid encoding") if r == none
  b
}

def big_from_hex(s: Str) -> big.Int {
  b = big.Int.new
  r = b.set_string!(s, 16)
  panic("crypto/elliptic: internal error: invalid encoding") if r == none
  b
}
