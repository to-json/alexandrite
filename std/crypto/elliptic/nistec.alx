# Go's crypto/elliptic/nistec.go: the named curves over
# crypto/internal/fips140/nistec.
import "crypto/internal/fips140/nistec"
import "math/big"

def p224_params -> CurveParams {
  # See FIPS 186-3, section D.2.2.
  CurveParams.new(
    name: "P-224",
    bit_size: 224,
    p: big_from_decimal("26959946667150639794667015087019630673557916260026308143510066298881"),
    n: big_from_decimal("26959946667150639794667015087019625940457807714424391721682722368061"),
    b: big_from_hex("b4050a850c04b3abf54132565044b0b7d7bfd8ba270b39432355ffb4"),
    gx: big_from_hex("b70e0cbd6bb4bf7f321390b94a03c1d356c21122343280d6115c1d21"),
    gy: big_from_hex("bd376388b5f723fb4c22dfe6cd4375a05a07476444d5819985007e34"),
  )
}

