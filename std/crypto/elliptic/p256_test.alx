# Go's crypto/elliptic/p256_test.go.
import "math/big"

# k, x in, y in, x out, y out (hex).
P256_MULT_TESTS: [[Str; 5]; 2] = [
  [
    "2a265f8bcbdcaf94d58519141e578124cb40d64a501fba9c11847b28965bc737",
    "023819813ac969847059028ea88a1f30dfbcde03fc791d3a252c6b41211882ea",
    "f93e4ae433cc12cf2a43fc0ef26400c0e125508224cdb649380f25479148a4ad",
    "4d4de80f1534850d261075997e3049321a0864082d24a917863366c0724f5ae3",
    "a22d2b7f7818a3563e0f7a76c9bf0921ac55e06e2e4d11795b233824b1db8cc0",
  ],
  [
    "313f72ff9fe811bf573176231b286a3bdb6f1b14e05c40146590727a71c3bccd",
    "cc11887b2d66cbae8f4d306627192522932146b42f01d3c6f92bd5c8ba739b06",
    "a2f08a029cd06b46183085bae9248b0ed15b70280c7ef13a457f5af382426031",
    "831c3f6b5f762d2f461901577af41354ac5f228c2591f84f8a6e51e2e3f17991",
    "93f90934cd0ef2c698cc471c60a93524e87ab31ca2412252337f364513e43684",
  ],
]

def bigh(s: Str) -> big.Int {
  v = big.Int.new
  v.set_string!(s, 16)
  v
}

test "P256 base mult" {
  p256c = p256()
  p256_generic = generic_params_for_curve(p256c)
  scalars: [big.Int] = []
  for e in P224_BASE_MULT_TESTS {
    k = big.Int.new
    k.set_string!(e[0], 10)
    scalars << k
  }
  k = big.Int.new
  k.lsh!(big.new_int(1), 500)
  scalars << k
  i = 0
  for s in scalars {
    x, y = p256c.scalar_base_mult(s.bytes)
    x2, y2 = p256_generic.scalar_base_mult(s.bytes)
    assert x.cmp(x2) == 0 && y.cmp(y2) == 0, "##{i}: got (#{x.text(16)}, #{y.text(16)}), want (#{x2.text(16)}, #{y2.text(16)})"
    i += 1
  }
}

test "P256 mult" {
  p256c = p256()
  i = 0
  for e in P256_MULT_TESTS {
    x = bigh(e[1])
    y = bigh(e[2])
    k = bigh(e[0])
    expected_x = bigh(e[3])
    expected_y = bigh(e[4])
    xx, yy = p256c.scalar_mult(x, y, k.bytes)
    assert xx.cmp(expected_x) == 0 && yy.cmp(expected_y) == 0, "##{i}: got (#{xx.text(16)}, #{yy.text(16)}), want (#{e[3]}, #{e[4]})"
    i += 1
  }
}

test "issue 52075" {
  gx = p256().params.gx
  gy = p256().params.gy
  scalar = [0.as_u8; 33]
  scalar[32] = 1
  x, y = p256().scalar_base_mult(scalar)
  assert x.cmp(gx) == 0 && y.cmp(gy) == 0, "unexpected output (#{x}, #{y})"
  x, y = p256().scalar_mult(gx, gy, scalar)
  assert x.cmp(gx) == 0 && y.cmp(gy) == 0, "unexpected output (#{x}, #{y})"
}
