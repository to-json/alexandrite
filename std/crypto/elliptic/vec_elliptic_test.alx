test "P-256 generic vectors" {
  c: Curve = generic_params_for_curve(p256())
  x, y = c.scalar_base_mult(hex.decode_string("5495eb4bdfe4ee6b11ca6ada7c0af97458ea74443572433d5c796d61325f06").unwrap)
  assert_eq x.text(16), "d42e0b172cd6725c55f1a73e0d2d962a89614ba749ea3786e086620ef0642cbd"
  assert_eq y.text(16), "41cbce26b01f95acbe9d8c8caf45c858158e1d5e72bff382b172fb366dfe2bef"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("8254d61ba6920fc26e2d04c731f778115def75d80a33309f8348007bc0923cb7").unwrap)
  assert_eq qx.text(16), "d6feae60d80be44dde12f72239176938f47cc85bb161a8d4fa7d34152a38c685"
  assert_eq qy.text(16), "7d319ab84baad3e45da3a8fecd0f4363a186db58d05e915d5c68fab7f10e5201"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "899b4b80c1e1df31146fef5ff88038c91ce7d34de3d2ccf57c1dcf63ed5eddec"
  assert_eq ay.text(16), "2dfe9a47c50d52f664a7587d6cc484fb097351713c58f88644d641ee3231f246"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "d96cce314c49b4e451df455b22dc20a4b935fc82ffb54f08e3fa2bbdd52abf20"
  assert_eq dy.text(16), "9fd867bd923c213d6a03ed527617f85984d7064ea5ce0d086542abcd23ad4c77"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "04d6feae60d80be44dde12f72239176938f47cc85bb161a8d4fa7d34152a38c6857d319ab84baad3e45da3a8fecd0f4363a186db58d05e915d5c68fab7f10e5201"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "03d6feae60d80be44dde12f72239176938f47cc85bb161a8d4fa7d34152a38c685"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "d96cce314c49b4e451df455b22dc20a4b935fc82ffb54f08e3fa2bbdd52abf20"
  assert_eq u[1].text(16), "9fd867bd923c213d6a03ed527617f85984d7064ea5ce0d086542abcd23ad4c77"
  x, y = c.scalar_base_mult(hex.decode_string("e1b960401ce0989fa1e6260daeea0ad3fccbcd0edabbaec0779d124fb70cba5c").unwrap)
  assert_eq x.text(16), "552a454077794e4516807bbbf9f0760daa458158ff7f077f6e933241bfc35718"
  assert_eq y.text(16), "b6d35415b5a3b8c0009b2a633e6b20cc7695fdd91f4ab6a910b7ab40c3978b0e"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("31a57df41fe37ba92c2d4fae6175f485f8db50a13b685cc69cf5b45f083da3fd").unwrap)
  assert_eq qx.text(16), "190e2bba7eb48c86206cd2925378eedde59e69fe3a6387ac0dc1ab83be0bc0c5"
  assert_eq qy.text(16), "bb4a9ffd0dccaa1d79bae5dd8eb42f6471f6e7247e4bfa48a98e782e3a400ca8"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "ab058f68d53074d7e370a74f6e75d6da79aca1b466a7911372ab70352914021a"
  assert_eq ay.text(16), "8783b28fd5f9edc02feac7ebcea5f135ca9d782d439319fc2e03f5d9b5d1008d"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "a7558ea1e229ac609c7abac34cf65de427f63f494637bf481454f8cfb3633a18"
  assert_eq dy.text(16), "deff4bb8e532633e4d46f15b5599d857fc017ead3232b0cf2281491d4499e4d9"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "04190e2bba7eb48c86206cd2925378eedde59e69fe3a6387ac0dc1ab83be0bc0c5bb4a9ffd0dccaa1d79bae5dd8eb42f6471f6e7247e4bfa48a98e782e3a400ca8"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "02190e2bba7eb48c86206cd2925378eedde59e69fe3a6387ac0dc1ab83be0bc0c5"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "a7558ea1e229ac609c7abac34cf65de427f63f494637bf481454f8cfb3633a18"
  assert_eq u[1].text(16), "deff4bb8e532633e4d46f15b5599d857fc017ead3232b0cf2281491d4499e4d9"
}

test "P-384 vectors" {
  c: Curve = p384()
  x, y = c.scalar_base_mult(hex.decode_string("dd340d55738f6166079256247d26f138b789742f9a18e1786d181bb6f329f684be4e7e7c977fcf2088f325727fce05").unwrap)
  assert_eq x.text(16), "98af930b57100ce986a47478131b2ba0f3ae1f231572e9ed0b8a8b4beab6a4a860d614a2aba051aa2f0be6cd0bf1b710"
  assert_eq y.text(16), "1ccabcd0d3a12e2740e2036b4d3cb71ba4db6367633c2a922f35fbd42f12b5f66db2ff34a78c45a06acd1c686bc3f2e6"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("5c3856621f54c99d47baa50863d4ad8aa2318c1342b72054fec0cd4df446c53e2e049cbfbc6fc6925ffc22686863ed8c").unwrap)
  assert_eq qx.text(16), "17c63030a4226a9e147bde798f5978e00947b0bd0867e2551f2526827677a6a2d66413a0ee38bd72a556173eeda1f437"
  assert_eq qy.text(16), "1a29b8fd203e093b59b83f476aa8de6b0ba6b4df5283e31b2fcaba088458df3e4611e064838ed48dd77bd32d112e5fb9"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "83ba03c059d3c8700b0268dc3f7073a7154c563040509c5cc4e991fd120c92d0d6d1ee885afe05d7a4fd3760e010e07e"
  assert_eq ay.text(16), "84cb60de3584e12d4abcced7a59b29a4a79ed3e6467159733110202bc3d6853965baf6486935aaf5fdc10e0b21e2bcae"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "27239e0cd13e330893caacf59280deef2b23ec2ca17831fdbb015a338f64b1ee27e7efa311d0e503e50fe52dab992b07"
  assert_eq dy.text(16), "ba1bf23919c0a8031c90dce6f94fa1b3dd6773e813031f9dea04d9fbd101314065cae792db1604eedff0eb1649ab89e7"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "0417c63030a4226a9e147bde798f5978e00947b0bd0867e2551f2526827677a6a2d66413a0ee38bd72a556173eeda1f4371a29b8fd203e093b59b83f476aa8de6b0ba6b4df5283e31b2fcaba088458df3e4611e064838ed48dd77bd32d112e5fb9"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "0317c63030a4226a9e147bde798f5978e00947b0bd0867e2551f2526827677a6a2d66413a0ee38bd72a556173eeda1f437"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "27239e0cd13e330893caacf59280deef2b23ec2ca17831fdbb015a338f64b1ee27e7efa311d0e503e50fe52dab992b07"
  assert_eq u[1].text(16), "ba1bf23919c0a8031c90dce6f94fa1b3dd6773e813031f9dea04d9fbd101314065cae792db1604eedff0eb1649ab89e7"
  x, y = c.scalar_base_mult(hex.decode_string("284796026ffbcde7a663fa644a234ab072e8cd72397f6777465fbe25093d63589c5f969224b430a29d0f0ed9d61cbd14").unwrap)
  assert_eq x.text(16), "dedee9985805270a74df62a0147a93e0a6ffde5f3065a871303eec8b51e34f10eb4e81378e3be4e99367bb9a2fff0c14"
  assert_eq y.text(16), "ce8280694195bd18ba621e77937663b96a14d6535eeb329261bd1261027319f93fc9e5055c8c5bf10d7d2342eef7c5f6"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("40ebd507684cf467b045e3040e0994a34835879d91b44788d7e5af0f02580c7c44135fb8572f20544a70c1430084e6e6").unwrap)
  assert_eq qx.text(16), "3bc9b4ae964efb9c1d279a20012c3c1014df55978311cf222d53bd5386d55f24330bf86551e55d079d86cede1ddf8b5e"
  assert_eq qy.text(16), "ea35c732b920381f817321b6f618fbd6daff203f63cf83fb77eb0f0474c3b6a151ada69a213efbc187adac34c5d15cca"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "e6de8729912404c4422d39d205b986581eeafcd55acdf389b4cfc5257008b345318f665702cdb1aa7a1e4049fe1d8b63"
  assert_eq ay.text(16), "7f4eadcf48668228e4eb33ae61edb5a6517be47026fd7a24ee1b282913b6418047c4e741327cdaddc2333b3971744db3"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "ec90488b50ee980fc4c63594a603b1e7a3f8f5fd8d361de076106ba49a851347394747c73da192daa70976c6e75c59c7"
  assert_eq dy.text(16), "5f3ffce33eae473adcb9dfaa9320538c83e237dcdbcb18068626eafcdd1b9d587ffdd3e42bfdbf38b93950e7b7205b4c"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "043bc9b4ae964efb9c1d279a20012c3c1014df55978311cf222d53bd5386d55f24330bf86551e55d079d86cede1ddf8b5eea35c732b920381f817321b6f618fbd6daff203f63cf83fb77eb0f0474c3b6a151ada69a213efbc187adac34c5d15cca"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "023bc9b4ae964efb9c1d279a20012c3c1014df55978311cf222d53bd5386d55f24330bf86551e55d079d86cede1ddf8b5e"
