test "P-521 vectors" {
  c: Curve = p521()
  x, y = c.scalar_base_mult(hex.decode_string("b03ec8f52257bdcc7e3498bf98a47a6340b5dd1e7937234aa27b0057abb0af2273e8b6bdc8d0b01f5d7854fc2da1916b3075aa2b84e315b97c51fc47143de4456f").unwrap)
  assert_eq x.text(16), "195b473a11832f5789db58fe48fe2f4ce71bb55c7cf5c2967a1a33416534c26abef7c6118945450586c6bd986277c4cf1232424738d1019c5d0ded7d89f5eb9fc"
  assert_eq y.text(16), "1f0c353b9ada75ec6d9a55d39b6cd014e59fe422d3a1b99f9d376bc0c07ed4270b8c0167f91a6fb46eaf608482a90314aa5f48bb8ecab4882be48b8712fc953d13a"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("8d0b9765dd56344837eeb12b4cd31026788dcee6d0a5b97e0ffcdb716ddee2f0f236a344763004a49064c31a3a66df63cdebb97e2d0af55695a361a2b495f3ec5a79").unwrap)
  assert_eq qx.text(16), "e8f85298ca646e6b08edab12352a6fd1412ef6c1e41fcdd255f567ed60a05d84230c91197ee7c8a191fdd9165d6c6e0fd6be3887ce6f5224f01b243a03224b0707"
  assert_eq qy.text(16), "f10acb457d86c75de3fb42e8c08af701e54a79bb51b0f2dc0fda3fe9329f306c00732795574ad55180c52f4f6197a999ee9f3bbccb44b6a95f87ac49198785f546"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "1cfbff56f336e02de9cd727d809fa4cdd8531c028c2bf8f0bf32bd54ed85c014542bab07d32789cccab78183d3ac0e84cd63002f27eece258eef2c423ea510b5ebd"
