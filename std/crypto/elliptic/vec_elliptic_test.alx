  assert_eq qy.text(16), "17df935ec3c82ab58b364440faf8ba2951ed1f4044d7aaf72cea200ae94b223e4a0bf948c633ccb59cddf3d69242a5f71ee3d6efd037f9ec7c913377349f061f0c9"
