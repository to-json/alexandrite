  assert_eq u[1].text(16), "c8af3ef7ca729139735bbc32a78acd44a3610dfb8e00a1013d9d31d2"
}

test "P-224 generic vectors" {
  c: Curve = generic_params_for_curve(p224())
  x, y = c.scalar_base_mult(hex.decode_string("ce63448fcf0bb82c4eded0548f0bf934b1287ff3c6bf83807e5ca9").unwrap)
  assert_eq x.text(16), "7a32e65bac79d2ad48568463d3c1205c7351cb8eb4caca86d343fd02"
  assert_eq y.text(16), "9ea3de6bbc7437d0e352f5ebc3c557413c61446dc1129e3a69f4aaa"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("b25f0852a90f42735c7b05d53a22d2055ade2346c61937517cb75341").unwrap)
  assert_eq qx.text(16), "2d0664d7ef827d9bc31fe87d08b44939ff47b10fbb98558198d751ed"
  assert_eq qy.text(16), "43f073040deec30fec62e0397c3b15c1ea04ee0ddcf4c3487ec9ba6"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "b477d2bafcd13acfe2b23e43de69403a635314960239ae0ada9640a9"
  assert_eq ay.text(16), "c08a99f772715f23b51b43895a0ee22fe78619cd7ddc2e0aa5667"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "f17d393a7b14f5f39f4f34f7c4a5ffb3dc8b0de7c6b17602f559bc85"
  assert_eq dy.text(16), "fc312794b2e25d12944644326515c405419e026e3ebce98f6aab18cd"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "042d0664d7ef827d9bc31fe87d08b44939ff47b10fbb98558198d751ed043f073040deec30fec62e0397c3b15c1ea04ee0ddcf4c3487ec9ba6"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "022d0664d7ef827d9bc31fe87d08b44939ff47b10fbb98558198d751ed"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "f17d393a7b14f5f39f4f34f7c4a5ffb3dc8b0de7c6b17602f559bc85"
  assert_eq u[1].text(16), "fc312794b2e25d12944644326515c405419e026e3ebce98f6aab18cd"
  x, y = c.scalar_base_mult(hex.decode_string("7f51999258f7f8bc339306037aa0ace4da26cf9777794764f26a51e9").unwrap)
  assert_eq x.text(16), "cdfc1899cb4633bdd2523b3573c7c5fb0777c185895c53128ec62385"
  assert_eq y.text(16), "6d53783e368ca8f1865b0c9e55062ff5e35ea92f70daf1e12d8c97ae"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("59384199af480ecbee9db4fbce8d7f90fd3f48bf8dc73990ce88c811").unwrap)
  assert_eq qx.text(16), "80deb36a9a3813ff24c2bf19cc9c9a4c2cf7a251351e6d3ccf4e641a"
  assert_eq qy.text(16), "e174ef43e42e1c3ed9678e8f3d7024ffece807ed7868277813f701e6"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "ff38935ca86baf82db9f4ce8ca85eb318ea7b82ad4b130857c9cdfaa"
  assert_eq ay.text(16), "1c7597a20b89b0f47b4c5694b91d43e62e0835ffa5abca7ddf80d609"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "cb29fb2f6dbcb0ced63f4edd9214a521c3ed4065f92d5d9c760717c1"
  assert_eq dy.text(16), "34e40b0cef6fdfb2157a68f04d2a8edf95452b0ee2b516ee49d913d4"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "0480deb36a9a3813ff24c2bf19cc9c9a4c2cf7a251351e6d3ccf4e641ae174ef43e42e1c3ed9678e8f3d7024ffece807ed7868277813f701e6"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "0280deb36a9a3813ff24c2bf19cc9c9a4c2cf7a251351e6d3ccf4e641a"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "cb29fb2f6dbcb0ced63f4edd9214a521c3ed4065f92d5d9c760717c1"
  assert_eq u[1].text(16), "34e40b0cef6fdfb2157a68f04d2a8edf95452b0ee2b516ee49d913d4"
}

test "P-256 vectors" {
  c: Curve = p256()
  x, y = c.scalar_base_mult(hex.decode_string("4446658d0978673980a8e876891fbcaae8adde7cc8fe3df0571386c327a5b3").unwrap)
  assert_eq x.text(16), "6ca57a6d1f3b46136306df12ea5e78783b69cc512147e0003ae70f291d6db1e8"
  assert_eq y.text(16), "2678015a377533c627580575d8cc43d1514fe462ad483e59b95004d46cc92f1f"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("9eeba272d5437292d4bf1243ccee823afa6a13500390411ea205b0bc3db1db55").unwrap)
  assert_eq qx.text(16), "e06a6d3b830e7a9eb7c83956230132c9aeb8a9ac24370fe68a07b55cbe0172a3"
  assert_eq qy.text(16), "3e145d90dde82ef5ddb47eca699f38466486ce04b9a33df07e5549f4f32552bd"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "acaf17fafc001da1a003877e2c364fe01eec3ae0a59369bda3963f1edc226f30"
  assert_eq ay.text(16), "69546fa65fe12de6f658fe9c2785acb880df03e0722d1de2b4c30694be2af321"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "cc9b042b41e45d6f65922b6543429414bb400370677994b295ce069b66e96dff"
  assert_eq dy.text(16), "f83e38b1ce3df1c4c14d19ce7d1d817d2f9b90e145f1440582b50e752b54a15b"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "04e06a6d3b830e7a9eb7c83956230132c9aeb8a9ac24370fe68a07b55cbe0172a33e145d90dde82ef5ddb47eca699f38466486ce04b9a33df07e5549f4f32552bd"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "03e06a6d3b830e7a9eb7c83956230132c9aeb8a9ac24370fe68a07b55cbe0172a3"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "cc9b042b41e45d6f65922b6543429414bb400370677994b295ce069b66e96dff"
  assert_eq u[1].text(16), "f83e38b1ce3df1c4c14d19ce7d1d817d2f9b90e145f1440582b50e752b54a15b"
  x, y = c.scalar_base_mult(hex.decode_string("8ba8cfc06e43bdf9bd616ff7e90584d96552aebb59fdc2f986724d291dc01d94").unwrap)
  assert_eq x.text(16), "896c478df9498cbb28065521d71039d4c91b62e8a5948781f937ce189c04648d"
  assert_eq y.text(16), "7bc8c08836b83185f3d6bc1edbb3a3c7ca02509d09388dc4930c0eacc9711e0c"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("be64591cd55e196cd333a3543426f8b91bd7efbc46f43f681460b7f2499b1d2d").unwrap)
  assert_eq qx.text(16), "371d3ed853a95ea7c8963585f3818b9dd9b2e9027e908db215a5a966d74ffb52"
  assert_eq qy.text(16), "775684dc111953296abb7049b095d9eda06ed80633ce9874e73009369491f3ba"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "a8d92a523b3365ab0a2027eab2ae381df72fb9e39b16eb07616e147fe631d6a7"
  assert_eq ay.text(16), "e48d692913710e97ea776aa67f3b8708a0200d74ce8562a45af9693c9e3b4a0f"
  dx, dy = c.double(qx, qy)
