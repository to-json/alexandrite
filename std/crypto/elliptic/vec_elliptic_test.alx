  assert_eq u[1].text(16), "614538c1ace519bff61340c9996e4d4ce226210015857bb0f0e72d73c8663f867ecaab6f851280f5870b5c543de8dee43e54ac0e429ae31193c2396fce10ddd450"
}

test "P-521 generic vectors" {
  c: Curve = generic_params_for_curve(p521())
  x, y = c.scalar_base_mult(hex.decode_string("780d84b20d7ae7e6292919399348bdbf96025270136198083fc8a4da398b5ca9387abb7a8517996830920465f97d9f8477293f987257ca834f2c6eecf99de72fc5").unwrap)
  assert_eq x.text(16), "55e4cc747ea74f8f10e6ae6794f9afde2550c5d42fb0921603858077c0f44fcc0cdf16aaac0be50223867c5d3bd6c58004a4ec686595c392513a70c0462b3cc835"
  assert_eq y.text(16), "aba57054ff09d9ec3a5994a3b83edfd7cca5efbe1f259c8d42c44db89f8000b144181f288348a5cf22e6756a7307625f25e7392e4e58e7088d57f1fdc3ef8291d8"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("27037fccea3062ee8ebaea07a9e2bf8dcb6511fd860ae993442aee0c512b8bbfad80187c1a71bd237664c8cb21ad276101f0bee44a77c49c5736114786f988942f60").unwrap)
  assert_eq qx.text(16), "73eae7bef1ffa6032f8bdc8903a1fa4122f35d34cf323aed0b615fa56dacdd2ce659063caf6f76af4aafa57db3307330cd07ae2aaef3b304db369cff3078afbf35"
  assert_eq qy.text(16), "13488bf278e77902fb75611e709cda9015ad1f63b4aa24fcb51d1ff02f309baf7c393d118cf318f4c5b3b116381bfcc0df42c4cf08cf39efb53273bd624e790968e"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "95bde5addb4d14332eef5eeb92ac2dd6a153eeef0f2483436486be08c1be2e196fc2a61b51b900cdd8ebf608249ae8e623b90fe34cef25f235a261100252e62481"
  assert_eq ay.text(16), "1abee313b9f9af04a08f1a0a9a7a9f54d6277a86d9f877aa443cc0d9d39440e534608cdedca635d5aeae41599e180ea4767abe6a260c868d37acb07765f90bdab6e"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "ccf7a0e2298aaff3939eb9a0d303e50fd01c79d08780583df8e9d5d8cdc16db13b9cbbfa8253f1ea7d5fb6e8db1fe8e36034a9fb3f403368c3f59c21b323287b01"
  assert_eq dy.text(16), "b7b915be1b033f71b7897510a6a083213714c2a2c0eef934e41abbb982dd2c0b90f7e4219955329086d289c915705502051b10c69854d12ab26abb788e2dbfbf43"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "040073eae7bef1ffa6032f8bdc8903a1fa4122f35d34cf323aed0b615fa56dacdd2ce659063caf6f76af4aafa57db3307330cd07ae2aaef3b304db369cff3078afbf35013488bf278e77902fb75611e709cda9015ad1f63b4aa24fcb51d1ff02f309baf7c393d118cf318f4c5b3b116381bfcc0df42c4cf08cf39efb53273bd624e790968e"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "020073eae7bef1ffa6032f8bdc8903a1fa4122f35d34cf323aed0b615fa56dacdd2ce659063caf6f76af4aafa57db3307330cd07ae2aaef3b304db369cff3078afbf35"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "ccf7a0e2298aaff3939eb9a0d303e50fd01c79d08780583df8e9d5d8cdc16db13b9cbbfa8253f1ea7d5fb6e8db1fe8e36034a9fb3f403368c3f59c21b323287b01"
  assert_eq u[1].text(16), "b7b915be1b033f71b7897510a6a083213714c2a2c0eef934e41abbb982dd2c0b90f7e4219955329086d289c915705502051b10c69854d12ab26abb788e2dbfbf43"
  x, y = c.scalar_base_mult(hex.decode_string("baea96500997ff5cd6cfd26592a978d6b73d480b4ad33d002499cf0041ac9996af9b6fe9bdaa154b57a16b90780a1c2d0eed913c5d55c1eff7010a5997049e3781e3").unwrap)
  assert_eq x.text(16), "f1edffed989cc04ff3b903d4084a0e93f07c7489aa7cb4d6b6a2f9767a2501461e6cb47402c00a778be6bf32d48dcb4381c3f92c36ee108b49554e866ba0b75d90"
  assert_eq y.text(16), "cdae9fa83e93ae8c3852a9567c393cd69812a0dcf02e6d9b48bb763431b759ed797f88ed362bb79dc1635fd5c97f82295c3a9d19b2c8e61b0e9261864ddc30cfb4"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("fd7275bbea343cb9700fc158597fe6737d8a15b7b31b94a9545fc59eb5899ab19c0c3d3a0d8e2db2f6a35c70a065c6ff6c98dddae3eefab98ea63d644791c3547770").unwrap)
