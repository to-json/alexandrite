test "P-384 generic vectors" {
  c: Curve = generic_params_for_curve(p384())
  x, y = c.scalar_base_mult(hex.decode_string("5f257891ddc2d3c1ea984059ca31227e7c6df93ffbdd3b08d5b2682d928c748266f0c83f901fcf7828f990311d9304").unwrap)
  assert_eq x.text(16), "a5d5fec6a00dab6c13626ba67c99cc713e0da80b433fcf1a45e69aa638318e78758b992c5f4bcecfdeb5fcf412a4d140"
  assert_eq y.text(16), "b23ade3b5a76b8b788c20da16c32e58544e1ac9f22f148a0c9bfce0ec05f09bf82eff31279c87f87451b7ded546a598b"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("bcf3d97680b7d823e292d686c7ce770b4c3ebcc148d6b02888c3d51bed81cac1041ef075f540b228f5d9cef7acc32b6b").unwrap)
  assert_eq qx.text(16), "cf1561303f43d794eae9c5959e9d7336ab926954fdd544bc1aa6c0e1fcad851de8b7a98735393873f395c11c31e6bf99"
  assert_eq qy.text(16), "5cbde8a0f789d7dae968e924fb154d14c1486a2d64eddf7a06be5b5e0640f2e8af082f05527c2e8d7d180c6cc5280b0"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "74496662d802442f6f9bed04679ad20e9b21c06b1106368992929cbbd4521e3fcb13e014ef0ae5ae0299b280fc567feb"
  assert_eq ay.text(16), "35db97b005854ceefbc4be555929ced3e21ccf8825efbae8151686fc1014953540e9ecb2a9fadde7cd90d87e92eb372"
  dx, dy = c.double(qx, qy)
