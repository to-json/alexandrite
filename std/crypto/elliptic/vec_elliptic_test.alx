  assert_eq dy.text(16), "5004a9c54cbd50f4e1e9168829ba9933bf5036d253648feead9a915c60352f67b9ee5d8e2b4f34387349c54901db1515"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "04cf1561303f43d794eae9c5959e9d7336ab926954fdd544bc1aa6c0e1fcad851de8b7a98735393873f395c11c31e6bf9905cbde8a0f789d7dae968e924fb154d14c1486a2d64eddf7a06be5b5e0640f2e8af082f05527c2e8d7d180c6cc5280b0"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "02cf1561303f43d794eae9c5959e9d7336ab926954fdd544bc1aa6c0e1fcad851de8b7a98735393873f395c11c31e6bf99"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "62070f50fdfbf09678ceb1a19f12a8b14627a43762a5c1a7c989ce61f7c081efa34fae6a525f4da250e5ded307ed567e"
