  assert_eq ay.text(16), "10302db2a09bf557840d3186f40915207b3f7876ca0922aad97ccaec3d40df4e767e164fd1312007a0c6f44216aea8975db68d62ae5643245655ed6019eca71b5f3"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "5ea60e52b577d32f7b5155f3551833233a0faecc7892dfb3041144dfc993f9220f3960173e2b93f470a2fc59c4cc0b6a5f6d8fdc373391e7dbe4e84abaf48cf392"
  assert_eq dy.text(16), "2b76f66fe113088e7fedc9fb3814a19d77d1f5e374c5f8efec7e8b264f2f2c0e81b9f5ca47d4a256f4f8bb82bcec91c6aee151a0e3b60032b4d6a9034efb3ac881"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "0400554a202ee0a3d6a56f338eb745a9f8df37e0e325125e7718f1902e8c0acde196d337b1e5829dc1679a446abe05fafa7e5b5bde63406c8f51be2a639bbf813e1e6c017df935ec3c82ab58b364440faf8ba2951ed1f4044d7aaf72cea200ae94b223e4a0bf948c633ccb59cddf3d69242a5f71ee3d6efd037f9ec7c913377349f061f0c9"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "0300554a202ee0a3d6a56f338eb745a9f8df37e0e325125e7718f1902e8c0acde196d337b1e5829dc1679a446abe05fafa7e5b5bde63406c8f51be2a639bbf813e1e6c"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "5ea60e52b577d32f7b5155f3551833233a0faecc7892dfb3041144dfc993f9220f3960173e2b93f470a2fc59c4cc0b6a5f6d8fdc373391e7dbe4e84abaf48cf392"
  assert_eq u[1].text(16), "2b76f66fe113088e7fedc9fb3814a19d77d1f5e374c5f8efec7e8b264f2f2c0e81b9f5ca47d4a256f4f8bb82bcec91c6aee151a0e3b60032b4d6a9034efb3ac881"
}
