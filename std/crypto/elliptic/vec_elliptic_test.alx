# Generated from Go's crypto/elliptic; do not edit by hand.
import "encoding/hex"
import "math/big"

def hexi(s: Str) -> big.Int {
  v = big.Int.new
  v.set_string!(s, 16)
  v
}

test "P-224 vectors" {
  c: Curve = p224()
  x, y = c.scalar_base_mult(hex.decode_string("0cf85fb0545634dfe0a4373382e10a85ab777051c2612dbfa3d1f2").unwrap)
  assert_eq x.text(16), "c75000a61ff73d243852640a3c0054e375e44044144de4b5c74f75c2"
  assert_eq y.text(16), "69755b1f37daa2e5588dca1c55aff4a51955c2601ca8fd43bd980ec9"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("2afa1608b581233dbe11ce6e8967a4b8d1fb1e6662eb7296e929ed62").unwrap)
  assert_eq qx.text(16), "27f0c0d41b461849d554e779181ada751016f845bb1a08b2e1d0d264"
  assert_eq qy.text(16), "c5f56392892bdd3865d59587ef95cc1400bbdaf32ce1351ea88ce91d"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "9529895ae0b81a45d8cc2d72af89077ada6c195a644eb19f98dfd545"
  assert_eq ay.text(16), "27e9eaccd2c620ebe9a86a494642cae9d5d3933434edd21be9d2b8a6"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "993090147984a616e2e10b37cf26860d20b12ca4378cc507f0a0cea1"
  assert_eq dy.text(16), "b539e275b78f9be2d6cd1a88aa66e74723ae364994dc563f295fc8b8"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "0427f0c0d41b461849d554e779181ada751016f845bb1a08b2e1d0d264c5f56392892bdd3865d59587ef95cc1400bbdaf32ce1351ea88ce91d"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "0327f0c0d41b461849d554e779181ada751016f845bb1a08b2e1d0d264"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "993090147984a616e2e10b37cf26860d20b12ca4378cc507f0a0cea1"
  assert_eq u[1].text(16), "b539e275b78f9be2d6cd1a88aa66e74723ae364994dc563f295fc8b8"
  x, y = c.scalar_base_mult(hex.decode_string("8dc7c3a6eadab39203b09cee19168d3f6b10c7ded9b2f4ae1beb62f9").unwrap)
  assert_eq x.text(16), "b32c05d911b5f51835203dbef5b5efa029efadb68b2274e3c395bda0"
  assert_eq y.text(16), "bf0c8c16b023ab500d483ca5ec9737ca91f94e28b48dd4ab5a911b6d"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("ef82c64585d1c0a032a9e650bdfd2d266a7905f2e85b54572144c5b5").unwrap)
  assert_eq qx.text(16), "a8d959c309b154fb9dcc27f11f25f2564c0ec837a27c063cef9794fc"
  assert_eq qy.text(16), "926c2b2b2a242019162657688745978a33a5180ffdcf13ab61bb50c2"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "1414bb715dd19b891729bee79aa9e0c0f8cef112c35c86dd493bf660"
  assert_eq ay.text(16), "4d301ba50c8a14ebc0a9313d7ebfadd05a05fc026afcb62606879c35"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "9e786e74695fbd27aa4e9667521139b52cc81944c1b33bcaae0015f"
  assert_eq dy.text(16), "cf6697a7ab32e61ef3bee4391c898063d4e6056d6e83724e739e5344"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "04a8d959c309b154fb9dcc27f11f25f2564c0ec837a27c063cef9794fc926c2b2b2a242019162657688745978a33a5180ffdcf13ab61bb50c2"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "02a8d959c309b154fb9dcc27f11f25f2564c0ec837a27c063cef9794fc"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "9e786e74695fbd27aa4e9667521139b52cc81944c1b33bcaae0015f"
  assert_eq u[1].text(16), "cf6697a7ab32e61ef3bee4391c898063d4e6056d6e83724e739e5344"
  x, y = c.scalar_base_mult(hex.decode_string("56469d2db9f5116e1fd407d0bb8e932772b0ad929e5957b0fb7b420a6b").unwrap)
  assert_eq x.text(16), "27162c00052c693e54488a68a9ae6a601b886b9c20d95ee3ed6201e3"
  assert_eq y.text(16), "a1936444de63258f5ecf7530ac2b86269c79f29e78f1d3e004571036"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("cc67fc9d8c3b89f4999ba03382076612ffcee4eab34deea75ce6659d").unwrap)
  assert_eq qx.text(16), "f45a2e8004390f3abd030ab95cf75d6c3dae41ef687927230ed93901"
  assert_eq qy.text(16), "7c9d49540ebab251f707d233939f62e2cecd2dd9bb2852f53965cc57"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "9c7c51c3884d3d87de2f7cd987f5e5558d152b2fb9f1bf438a3a1e7a"
  assert_eq ay.text(16), "ae27f2a272a5adb82dd27d648894df88f4c35ff5a1151fbbad491a77"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "e20c53ec67c4461865a353e5a1734ccde8d66f65ce108c4330d39a7d"
  assert_eq dy.text(16), "e93c1b435ebd1865894a14e112409ae3f98b94a1ff2bd404d01d0938"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "04f45a2e8004390f3abd030ab95cf75d6c3dae41ef687927230ed939017c9d49540ebab251f707d233939f62e2cecd2dd9bb2852f53965cc57"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "03f45a2e8004390f3abd030ab95cf75d6c3dae41ef687927230ed93901"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "e20c53ec67c4461865a353e5a1734ccde8d66f65ce108c4330d39a7d"
  assert_eq u[1].text(16), "e93c1b435ebd1865894a14e112409ae3f98b94a1ff2bd404d01d0938"
  x, y = c.scalar_base_mult(hex.decode_string("39041ab364542c9b9fbfc6d8fe822f71ce84999cc541d2578983a4").unwrap)
  assert_eq x.text(16), "dee78209e4ec420c0d46c69d1d52d1f10c49aad9bcf44b7a57a2a6b5"
  assert_eq y.text(16), "af7911ebabffd63eaae6b1f10914fb4c0e7112eb531f0018fbd61073"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("c9a1c95004270ea208046370942b84947035132e51a0af32d0c01fff").unwrap)
  assert_eq qx.text(16), "46c6fb6e8ae325ec92670f8d29dec1cffe1f5db4dfa5323552882d5c"
  assert_eq qy.text(16), "c845d444966af6db4ff04ac714412bf357dade53e15168891be9dcb3"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "7394101ec487de3efd5769fbed631d32b45141822e31fd86a4deca3"
  assert_eq ay.text(16), "c616888aa813ee8b83bde2c431b4c88b66ee2c9e43ad724ccbf85318"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "ace525fbe98341795c2835a906c1e522b81721b1e67e27cd96d3029"
  assert_eq dy.text(16), "f577663a0df6a8a912f4ef7f8c15dd21e5c3755c8661111f8a1b96e1"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "0446c6fb6e8ae325ec92670f8d29dec1cffe1f5db4dfa5323552882d5cc845d444966af6db4ff04ac714412bf357dade53e15168891be9dcb3"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "0346c6fb6e8ae325ec92670f8d29dec1cffe1f5db4dfa5323552882d5c"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "ace525fbe98341795c2835a906c1e522b81721b1e67e27cd96d3029"
  assert_eq u[1].text(16), "f577663a0df6a8a912f4ef7f8c15dd21e5c3755c8661111f8a1b96e1"
  x, y = c.scalar_base_mult(hex.decode_string("1e7015a25602ad25bcbdf23b8641cb1ceadc4d906a79086d21388ff4").unwrap)
  assert_eq x.text(16), "4b0188d2540774695f0759aee98b3ce525e5c39449746a7cd9e32d4"
  assert_eq y.text(16), "b9c94154975dbe02d824893d34651d604ce3de448511ea8ef6ca4e85"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("3605271ff064e6a0fd47220a0a4169130b3fa5cee5d7952bc3f2d380").unwrap)
  assert_eq qx.text(16), "6fe809bf41772e27c2aedb37acc6de4134fe5c430c18fd6fd07c352e"
  assert_eq qy.text(16), "a044312299e4d0d8379804db9ea0c0b0f3934702f79d37264ac71659"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "4203b66f2a4ae71d83509432aac108397b8d4fa1d98f8726df47bd56"
  assert_eq ay.text(16), "470eb0da1c029f1a98dad1ecba2e7d4e1eca229a6a1fc58cc9375a73"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "b08e0d129da78427dd4520c0953a6caa9e51ee73794892eaac84ae01"
  assert_eq dy.text(16), "d382e74164b50a4f50c7deb659166b5535c1a0474aa2755d83b64768"
  assert_eq hex.encode_to_string(marshal(c, qx, qy)), "046fe809bf41772e27c2aedb37acc6de4134fe5c430c18fd6fd07c352ea044312299e4d0d8379804db9ea0c0b0f3934702f79d37264ac71659"
  assert_eq hex.encode_to_string(marshal_compressed(c, qx, qy)), "036fe809bf41772e27c2aedb37acc6de4134fe5c430c18fd6fd07c352e"
  u = unmarshal_compressed(c, marshal_compressed(c, dx, dy)).unwrap
  assert_eq u[0].text(16), "b08e0d129da78427dd4520c0953a6caa9e51ee73794892eaac84ae01"
  assert_eq u[1].text(16), "d382e74164b50a4f50c7deb659166b5535c1a0474aa2755d83b64768"
  x, y = c.scalar_base_mult(hex.decode_string("ef83e2720995b1a2c0076ff26fa7e41bc3ef4902d975c57ea91ba34ad5").unwrap)
  assert_eq x.text(16), "a7301c4a52302c3f3d5978714666b900f92dff05d99d2beba132096f"
  assert_eq y.text(16), "4435d8fea90a803b357af0436f83eb03ff72d25438c25ad8152c6f72"
  qx, qy = c.scalar_mult(x, y, hex.decode_string("21bc6d4ee40052bdf0a6137d82556221247f8db7ae9b13e0588f5e46").unwrap)
  assert_eq qx.text(16), "78254b60df820869707321a424363f8950000d9457d8e76655f5c59e"
  assert_eq qy.text(16), "ce254dbbc58ea2ec5b9684f1b513b083aab7a878612a52987c318a34"
  ax, ay = c.add(x, y, qx, qy)
  assert_eq ax.text(16), "feb6885c78ab9eb084ab2f8f6e9b0b9402832f9e70391f2ff1a091f8"
  assert_eq ay.text(16), "b13d4796d5ea6fe1776b2271663f3bb9855b70af1c7e16e08b121d1d"
  dx, dy = c.double(qx, qy)
  assert_eq dx.text(16), "d7ad1669207268dd0f4b5725a8e8bb0cd6869609e5f337e9a71d8b61"
  assert_eq dy.text(16), "c8af3ef7ca729139735bbc32a78acd44a3610dfb8e00a1013d9d31d2"
