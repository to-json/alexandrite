# Package fips140: Go's crypto/fips140, information about the FIPS 140-3 Go
# Cryptographic Module and FIPS 140-3 mode.
#
#   Go                                  alx
#   fips140.Enabled() bool              enabled? -> Bool (always false)
#   fips140.Version() string            version -> Str ("latest")
#   fips140.Enforced() bool             enforced? -> Bool (always false)
#   fips140.WithoutEnforcement(f)       without_enforcement { ... }
#
# alx has no FIPS 140-3 mode. Go's mode is switched on with GODEBUG=fips140=on
# (or =only, which also makes non-approved algorithms fail) and relies on a
# validated, frozen copy of the module plus a start-up integrity check of
# its object code; alx's crypto packages are ports of that code, but they
# aren't a validated module, there is no GODEBUG, and no integrity check runs.
# So the API reports what a Go program reports without the setting:
#
#   - enabled? is false: the crypto packages never run in FIPS 140-3 mode
#     (no self-tests at first use, no approved-only restrictions, no service
#     indicator).
#   - version is "latest", what Go returns when the program isn't built
#     against a frozen module (GOFIPS140 unset).
#   - enforced? is false: nothing is enforced, so without_enforcement just
#     runs its block (as Go does when enforcement is off).
#
# Differences from Go: none in results for a default Go build; the settings
# that would change them (GODEBUG=fips140, GOFIPS140) don't exist.

# Whether the cryptography libraries are operating in FIPS 140-3 mode:
# never, in alx.
pub def enabled? -> Bool { false }

# The FIPS 140-3 Go Cryptographic Module version the program was built
# against: "latest", meaning no frozen module.
pub def version -> Str { "latest" }

# Whether strict FIPS 140-3 enforcement (Go's GODEBUG=fips140=only) is on:
# never, in alx.
pub def enforced? -> Bool { false }

# Runs f with strict FIPS 140-3 enforcement disabled. Enforcement is never
# on in alx, so this just runs f.
pub def without_enforcement(f: () -> Unit) {
  f()
}
