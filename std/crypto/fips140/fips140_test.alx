# Go's fips140_test.go and enforcement_test.go. TestImmutableGODEBUG sets
# GODEBUG at run time and checks enabled? doesn't change: alx has no GODEBUG,
# so it checks the value stays put across calls. TestWithoutEnforcement needs
# Go's enforcement mode (it reruns the test with GODEBUG=fips140=only and
# checks crypto/des fails): here it checks that the block runs, nested and in
# a spawned task, and that nothing is enforced before, inside or after.

test "immutable enabled" {
  e = enabled?
  i = 0
  while i < 4 {
    assert_eq enabled?, e
    i += 1
  }
  assert !e, "alx has no FIPS 140-3 mode"
}

test "version" {
  assert_eq version, "latest"
}

test "without enforcement" {
  assert !enforced?, "before"
  ran = [0]
  without_enforcement {
    assert !enforced?, "inside"
    ran[0] += 1
  }
  assert !enforced?, "after"
  assert_eq ran[0], 1
}

test "without enforcement nested" {
  ran = [0]
  without_enforcement {
    without_enforcement {
      ran[0] += 1
    }
    ran[0] += 10
  }
  assert_eq ran[0], 11
}

test "without enforcement task" {
  ch = Chan[Bool].new(2)
  without_enforcement {
    t = spawn { ch << enforced? }
    t.wait.unwrap
  }
  assert_eq ch.recv, false
}
