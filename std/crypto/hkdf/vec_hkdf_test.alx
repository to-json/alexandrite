# Generated from Go's crypto/hkdf (go1.27.1): keys from seeded random secrets,
# salts and infos over every hash, at lengths around the hash sizes; do not
# edit by hand.

import "encoding/hex"
import "crypto/md5"
import "crypto/sha1"
import "crypto/sha256"
import "crypto/sha512"
import "crypto/sha3"

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

# gen bytes mapped to printable ASCII (the generator's `text`).
def text(seed: U64, n: Int) -> Str {
  out: [Byte] = []
  for x in gen(seed, n) {
    out << 0x20 + x % 95
  }
  Str.from_bytes(out)
}

# (prk, key) for one hash, by name.
def derive_with[H](h: () -> H, secret: [Byte], salt: [Byte], info: Str, kl: Int) -> ([Byte], [Byte]) {
  prk = extract(h, secret, salt)
  k = key(h, secret, salt, info, kl).unwrap
  assert_eq expand(h, prk, info, kl).unwrap, k
  (prk, k)
}

def derive(name: Str, secret: [Byte], salt: [Byte], info: Str, kl: Int) -> ([Byte], [Byte]) {
  case name {
    "md5" => derive_with(->() -> md5.Digest { md5.new() }, secret, salt, info, kl)
    "sha1" => derive_with(->() -> sha1.Digest { sha1.new() }, secret, salt, info, kl)
    "sha224" => derive_with(->() -> sha256.Digest { sha256.new224() }, secret, salt, info, kl)
    "sha256" => derive_with(->() -> sha256.Digest { sha256.new() }, secret, salt, info, kl)
    "sha384" => derive_with(->() -> sha512.Digest { sha512.new384() }, secret, salt, info, kl)
    "sha512" => derive_with(->() -> sha512.Digest { sha512.new() }, secret, salt, info, kl)
    "sha512_224" => derive_with(->() -> sha512.Digest { sha512.new512_224() }, secret, salt, info, kl)
    "sha512_256" => derive_with(->() -> sha512.Digest { sha512.new512_256() }, secret, salt, info, kl)
    "sha3_224" => derive_with(->() -> sha3.SHA3 { sha3.new224() }, secret, salt, info, kl)
    "sha3_256" => derive_with(->() -> sha3.SHA3 { sha3.new256() }, secret, salt, info, kl)
    "sha3_384" => derive_with(->() -> sha3.SHA3 { sha3.new384() }, secret, salt, info, kl)
    _ => derive_with(->() -> sha3.SHA3 { sha3.new512() }, secret, salt, info, kl)
  }
}

# secret = gen(seed, sl0), salt = gen(seed + 1, sl), info = text(seed + 2, il).
def hk(name: Str, seed: U64, sl0: Int, sl: Int, il: Int, kl: Int, prk: Str, want: Str) {
  r = derive(name, gen(seed, sl0), gen(seed + 1, sl), text(seed + 2, il), kl)
  assert_eq hex.encode_to_string(r[0]), prk
  assert_eq hex.encode_to_string(r[1]), want
}

# Like hk, for long keys: want is the SHA-256 of the key.
def hl(name: Str, seed: U64, sl0: Int, sl: Int, il: Int, kl: Int, prk: Str, want: Str) {
  r = derive(name, gen(seed, sl0), gen(seed + 1, sl), text(seed + 2, il), kl)
  assert_eq hex.encode_to_string(r[0]), prk
  assert_eq r[1].size, kl
  assert_eq hex.encode_to_string(sha256.sum256(r[1]).to_a), want
}

