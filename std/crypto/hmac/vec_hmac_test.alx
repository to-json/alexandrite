# Generated from Go's crypto/hmac (go1.27.1): MACs with seeded random keys of
# lengths around every hash's block size, over seeded random messages; do
# not edit by hand.

import "hash"
import "crypto/md5"
import "crypto/sha1"
import "crypto/sha256"
import "crypto/sha512"
import "crypto/sha3"

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

def hexs(p: [Byte]) -> Str {
  digits = "0123456789abcdef"
  out: [Byte] = []
  for x in p {
    out << digits[(x >> 4).to_i]
    out << digits[(x & 15).to_i]
  }
  Str.from_bytes(out)
}

# The MAC of msg under key, written whole, and written in two pieces after
# a reset.
def mac_of[H](mk: () -> H, key: [Byte], msg: [Byte]) -> [Byte] {
  m = new(mk, key)
  m.write!(msg).unwrap
  whole = m.sum([])
  m.reset!
  half = msg.size / 2
  m.write!(msg[0...half]).unwrap
  m.write!(msg[half...msg.size]).unwrap
  assert_eq m.sum([]), whole
  whole
}

def mac(name: Str, key: [Byte], msg: [Byte]) -> [Byte] {
  case name {
    "md5" => mac_of(->() -> md5.Digest { md5.new() }, key, msg)
    "sha1" => mac_of(->() -> sha1.Digest { sha1.new() }, key, msg)
    "sha224" => mac_of(->() -> sha256.Digest { sha256.new224() }, key, msg)
    "sha256" => mac_of(->() -> sha256.Digest { sha256.new() }, key, msg)
    "sha384" => mac_of(->() -> sha512.Digest { sha512.new384() }, key, msg)
    "sha512" => mac_of(->() -> sha512.Digest { sha512.new() }, key, msg)
    "sha512_224" => mac_of(->() -> sha512.Digest { sha512.new512_224() }, key, msg)
    "sha512_256" => mac_of(->() -> sha512.Digest { sha512.new512_256() }, key, msg)
    "sha3_224" => mac_of(->() -> sha3.SHA3 { sha3.new224() }, key, msg)
    "sha3_256" => mac_of(->() -> sha3.SHA3 { sha3.new256() }, key, msg)
    "sha3_384" => mac_of(->() -> sha3.SHA3 { sha3.new384() }, key, msg)
    _ => mac_of(->() -> sha3.SHA3 { sha3.new512() }, key, msg)
  }
}

# The MAC of gen(seed + 1, ml) under the key gen(seed, kl).
def hv(name: Str, seed: U64, kl: Int, ml: Int, want: Str) {
  assert_eq hexs(mac(name, gen(seed, kl), gen(seed + 1, ml))), want
}

