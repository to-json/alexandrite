# The AEADs HPKE uses (RFC 9180 section 7.3), on the ported packages as in
# Go: AES-128-GCM and AES-256-GCM are crypto/aes with crypto/cipher's GCM,
# ChaCha20-Poly1305 is golang.org/x/crypto/chacha20poly1305. Keys and
# nonces have the sizes the AEAD ids require (checked by the callers).

import "crypto/aes"
import "crypto/cipher"
import "golang.org/x/crypto/chacha20poly1305"

def gcm_for(key: [Byte]) -> cipher.Gcm[aes.Block] {
  cipher.new_gcm(aes.new_cipher(key).unwrap).unwrap
}

def gcm_seal(key: [Byte], nonce: [Byte], plaintext: [Byte], data: [Byte]) -> [Byte] {
  gcm_for(key).seal([], nonce, plaintext, data)
}

# The plaintext, or none if the tag doesn't verify.
def gcm_open(key: [Byte], nonce: [Byte], ciphertext: [Byte], data: [Byte]) -> [Byte]? {
  gcm_for(key).open([], nonce, ciphertext, data).ok
}

def chacha20poly1305_seal(key: [Byte], nonce: [Byte], plaintext: [Byte], data: [Byte]) -> [Byte] {
  chacha20poly1305.new(key).unwrap.seal([], nonce, plaintext, data)
}

# The plaintext, or none if the tag doesn't verify.
def chacha20poly1305_open(key: [Byte], nonce: [Byte], ciphertext: [Byte], data: [Byte]) -> [Byte]? {
  chacha20poly1305.new(key).unwrap.open([], nonce, ciphertext, data).ok
}
