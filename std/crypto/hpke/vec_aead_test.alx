test "chacha20poly1305 vectors" {
  key = hex.decode_string("f3ef9b49dccc462e43bf4500f8637b3e3234f6bef5c0e09f31292999d5165156").unwrap
  nonce = hex.decode_string("d347c7d8f742520a3bdd1ef8").unwrap
  pt = hex.decode_string("").unwrap
  ad = hex.decode_string("").unwrap
  ct = chacha20poly1305_seal(key, nonce, pt, ad)
  assert_eq hex.encode_to_string(ct), "38a7332998e9571bea0183eb2938e028"
  assert_eq chacha20poly1305_open(key, nonce, ct, ad), pt
  key = hex.decode_string("c919eb79b6267e5795d4ec10c906caf53b480a3c99eb7277315cec54b41b138c").unwrap
  nonce = hex.decode_string("867fb768189ff67a6fd3504d").unwrap
  pt = hex.decode_string("d7").unwrap
  ad = hex.decode_string("77").unwrap
  ct = chacha20poly1305_seal(key, nonce, pt, ad)
  assert_eq hex.encode_to_string(ct), "e4b17dfde2c1fd48010b880f7dd5567842"
  assert_eq chacha20poly1305_open(key, nonce, ct, ad), pt
  key = hex.decode_string("83cd1530e02127b53ef66cddd9016318b9100fb8b849179df4b1e15115042398").unwrap
  nonce = hex.decode_string("2fe1aada25f6ef19a8051011").unwrap
  pt = hex.decode_string("f411e2e1f96b8f0aa38d1e8cfc25a1").unwrap
  ad = hex.decode_string("f7c4ee3d7e0113f8957b6e12f8").unwrap
  ct = chacha20poly1305_seal(key, nonce, pt, ad)
  assert_eq hex.encode_to_string(ct), "d1f216a15392761617a6b3c19ff18b14cff606e8992ecf3b8f76fcda0ea55d"
  assert_eq chacha20poly1305_open(key, nonce, ct, ad), pt
  key = hex.decode_string("7494dc7df7ac6702976158ef5c23d8681260f535dc65e90f86e8f9080cb27932").unwrap
  nonce = hex.decode_string("20b5f2d75ffa365677720ed2").unwrap
  pt = hex.decode_string("2b9ae130fc628e71b771464eb0c013cd").unwrap
  ad = hex.decode_string("b00126e5ae38fa5695c0c2668b2ac4c0").unwrap
  ct = chacha20poly1305_seal(key, nonce, pt, ad)
  assert_eq hex.encode_to_string(ct), "4a783ec94f876547ce58e56b2b794e531f1b9617d223e528f33af0d6c0f79a30"
  assert_eq chacha20poly1305_open(key, nonce, ct, ad), pt
  key = hex.decode_string("438b8f2d8ed4dfb986c61a18e627caad51909d572f09e237ad6ee01dc9b5868b").unwrap
  nonce = hex.decode_string("7412ad3ef779c4b936576386").unwrap
