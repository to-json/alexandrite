# Generated from Go's crypto/aes + crypto/cipher GCM and x/crypto chacha20poly1305 (scratch aeadvec); do not edit by hand.

import "encoding/hex"

test "aes-gcm vectors" {
  key = hex.decode_string("3efdf3efea9dfa06d243764ebf608f3e").unwrap
  nonce = hex.decode_string("08526b4f6cfc0ab9a0faa84f").unwrap
  pt = hex.decode_string("").unwrap
  ad = hex.decode_string("").unwrap
  ct = gcm_seal(key, nonce, pt, ad)
  assert_eq hex.encode_to_string(ct), "8ad2d0985b156a7ebbcbefb9ca350206"
  assert_eq gcm_open(key, nonce, ct, ad), pt
  key = hex.decode_string("4bddf4bd7ff3fdfd18a4d11116a24a93").unwrap
  nonce = hex.decode_string("f8e09f80be48917ec5090b42").unwrap
