#![overflow(wrap)]
# Go's benchmarks of nat_test.go (alx test -bench .). Each body repeats the
# operation 1000 times (Exp: 10 times) so the setup is small next to it.

def make_benchmark_modulus -> Modulus { max_modulus(32) }

def make_benchmark_value -> Nat {
  v: U64 = 0xffffffffffffffff
  nat_of([v; 32])
}

def make_benchmark_exponent -> [Byte] {
  e = [0.as_u8; 256]
  i = 0
  while i < 32 {
    e[i] = 0xff
    i += 1
  }
  e
}

bench "ModAdd x1000" {
  x = make_benchmark_value()
  y = make_benchmark_value()
  m = make_benchmark_modulus()
  for _i in 0...1000 {
    x.add!(y, m)
  }
}

bench "ModSub x1000" {
  x = make_benchmark_value()
  y = make_benchmark_value()
  m = make_benchmark_modulus()
  for _i in 0...1000 {
    x.sub!(y, m)
  }
}

bench "MontgomeryRepr x1000" {
  x = make_benchmark_value()
  m = make_benchmark_modulus()
  for _i in 0...1000 {
    x.montgomery_representation!(m)
  }
}

bench "MontgomeryMul x1000" {
  x = make_benchmark_value()
  y = make_benchmark_value()
  out = make_benchmark_value()
  m = make_benchmark_modulus()
  for _i in 0...1000 {
    out.montgomery_mul!(x, y, m)
  }
}

bench "ModMul x1000" {
  x = make_benchmark_value()
  y = make_benchmark_value()
  m = make_benchmark_modulus()
  for _i in 0...1000 {
    x.mul!(y, m)
  }
}

bench "Exp x10" {
  x = make_benchmark_value()
  e = make_benchmark_exponent()
  out = make_benchmark_value()
  m = make_benchmark_modulus()
  for _i in 0...10 {
    out.exp!(x, e, m)
  }
}
