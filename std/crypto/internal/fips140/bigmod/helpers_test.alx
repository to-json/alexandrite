#![overflow(wrap)]
# Go's test helpers of nat_test.go (setBig, asBig, String, natBytes,
# natFromBytes, modulusFromBytes, maxModulus) and a deterministic source
# of test values (Go's tests use testing/quick and crypto/rand).

import "math/big"
import "strings"

# x = n (Go's setBig): the length is n's limb count.
def set_big(x: Nat, n: big.Int) -> Nat {
  y = x
  y.set_bits!(n.bits)
}

# n as a big.Int (Go's asBig).
def as_big(n: Nat) -> big.Int {
  z = big.Int.new
  z.set_bits!(n.limbs)
}

# Go's Nat.String: the limbs in %016X, most significant first.
def nat_string(n: Nat) -> Str {
  parts: [Str] = []
  i = n.limbs.size - 1
  while i >= 0 {
    parts << format("%016X", n.limbs[i])
    i -= 1
  }
  "{" + strings.join(parts, " ") + "}"
}

def nat_of(l: [U64]) -> Nat { Nat.new(limbs: l) }

def nat_bytes(n: Nat) -> [Byte] { n.bytes(max_modulus(n.limbs.size)) }

# Must not use Nat.set_bytes!, which TestSetBytes tests.
def nat_from_bytes(b: [Byte]) -> Nat {
  bb = big.Int.new
  bb.set_bytes!(b)
  set_big(new_nat(), bb)
}

def modulus_from_bytes(b: [Byte]) -> Modulus {
  bb = big.Int.new
  bb.set_bytes!(b)
  new_modulus(bb.bytes).unwrap
}

# The biggest modulus that fits in n limbs.
def max_modulus(n: Int) -> Modulus {
  b = big.new_int(1)
  b.lsh!(b, n * 64)
  b.sub!(b, big.new_int(1))
  new_modulus(b.bytes).unwrap
}

# A deterministic generator (splitmix64) standing in for testing/quick and
# crypto/rand in Go's randomized tests.
struct Gen {
  st: [U64]

  def next_u64! -> U64 {
    self.st[0] += 0x9e3779b97f4a7c15
    z = self.st[0]
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) * 0x94d049bb133111eb
    z ^ (z >> 31)
  }

  def bytes!(n: Int) -> [Byte] {
    out = [0.as_u8; n]
    i = 0
    while i < n {
      out[i] = next_u64!.as_u8
      i += 1
    }
    out
  }

  # Go's Nat.Generate: an even Nat of size limbs (random words with the
  # low bit cleared).
  def even_nat!(size: Int) -> Nat {
    l = [0.as_u64; size]
    i = 0
    while i < size {
      l[i] = next_u64! & 0xfffffffffffffffe
      i += 1
    }
    nat_of(l)
  }
}

def new_gen(seed: U64) -> Gen { Gen.new(st: [seed]) }

# ---- checks for the generated vectors (vec_nat_test.alx) ----

#[track_caller]
def check_exp(m: Str, x: Str, e: Str, want: Str) {
  mm = new_modulus(decode_hex(m)).unwrap
  xv = new_nat()
  xv.set_bytes!(decode_hex(x), mm).unwrap
  out = new_nat()
  out.exp!(xv, decode_hex(e), mm)
  assert_eq out.bytes(mm), decode_hex(want)
}

#[track_caller]
def check_exp_short(m: Str, x: Str, e: U64, want: Str) {
  mm = new_modulus(decode_hex(m)).unwrap
  xv = new_nat()
  xv.set_bytes!(decode_hex(x), mm).unwrap
  out = new_nat()
  out.exp_short_var_time!(xv, e, mm)
  assert_eq out.bytes(mm), decode_hex(want)
}

#[track_caller]
def check_mul_vec(m: Str, x: Str, y: Str, want: Str) {
  mm = new_modulus(decode_hex(m)).unwrap
  xv = new_nat()
  xv.set_bytes!(decode_hex(x), mm).unwrap
  yv = new_nat()
  yv.set_bytes!(decode_hex(y), mm).unwrap
  xv.mul!(yv, mm)
  assert_eq xv.bytes(mm), decode_hex(want)
}

#[track_caller]
def check_mod_vec(m: Str, x: Str, want: Str) {
  mm = new_modulus(decode_hex(m)).unwrap
  out = new_nat()
  out.mod!(nat_from_bytes(decode_hex(x)), mm)
  assert_eq out.bytes(mm), decode_hex(want)
}

#[track_caller]
def check_no_inverse(m: Str, a: Str) {
  mm = new_modulus(decode_hex(m)).unwrap
  av = new_nat()
  av.set_bytes!(decode_hex(a), mm).unwrap
  x = new_nat()
  assert x.inverse_var_time!(av, mm) == none, "#{a} has no inverse mod #{m}"
}
