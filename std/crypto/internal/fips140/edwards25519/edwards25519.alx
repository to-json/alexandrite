#![overflow(wrap)]
import "crypto/internal/fips140/edwards25519/field"

# Package edwards25519: Go's crypto/internal/fips140/edwards25519, group
# logic for the twisted Edwards curve
#
#   -x^2 + y^2 = 1 + -(121665/121666)*x^2*y^2
#
# known as edwards25519 (RFC 7748), and scalars modulo its prime order.
# This is the low-level package under crypto/ed25519 (and X25519 in
# crypto/ecdh); most programs want those.
#
# Go's Point and Scalar are mutated through pointer receivers
# (`v.Add(p, q)` sets v); here both are immutable values and operations
# return new ones, so receivers and arguments can't alias:
#
#   Go                                          alx
#   NewIdentityPoint() / NewGeneratorPoint()    new_identity_point() / new_generator_point()
#   new(Point).SetBytes(x) (*Point, error)      Point.set_bytes(x) -> ~Point<EdwardsError>
#   v.Set(u)                                    v = u
#   v.Bytes() []byte                            v.bytes -> [Byte]
#   v.Add(p, q) / v.Subtract(p, q)              p.add(q) / p.subtract(q)
#   v.Negate(p)                                 p.negate
#   v.Equal(u) int                              v.equal(u) -> Int
#   v.ScalarBaseMult(x)                         scalar_base_mult(x) -> Point
#   v.ScalarMult(x, q)                          scalar_mult(x, q) -> Point
#   v.VarTimeDoubleScalarBaseMult(a, A, b)      var_time_double_scalar_base_mult(a, aa, b) -> Point
#   NewScalar()                                 new_scalar() (or Scalar.new)
#   s.SetUniformBytes(x)                        Scalar.set_uniform_bytes(x) -> ~Scalar<EdwardsError>
#   s.SetCanonicalBytes(x)                      Scalar.set_canonical_bytes(x) -> ~Scalar<EdwardsError>
#   s.SetBytesWithClamping(x)                   Scalar.set_bytes_with_clamping(x) -> ~Scalar<EdwardsError>
#   s.Add / Subtract / Multiply(x, y)           x.add(y) / x.subtract(y) / x.multiply(y)
#   s.Negate(x) / s.MultiplyAdd(x, y, z)        x.negate / x.multiply_add(y, z)
#   s.Bytes() / s.Equal(t)                      s.bytes / s.equal(t) -> Int
#
# Differences from Go:
#   - Values instead of pointer receivers (above). On a failed set_bytes
#     there is no receiver to leave unchanged: the call just fails.
#   - The errors are EdwardsError variants with Go's messages.
#   - Go builds the fixed-base tables (basepointTable, basepointNafTable)
#     lazily at first use with sync.Once. alx has no mutable package state,
#     so they are array constants generated from Go's tables
#     (basepoint_table.alx; GO-VS-RUBY D32: built once before the program
#     starts, element reads don't allocate). tables_test.alx recomputes
#     them and compares. The cached entries are rebuilt from the limbs at
#     each lookup (field.from_limbs), which costs nothing beyond the reads.
#   - The constants d, 2d, the identity and the generator are built from
#     limbs (Go decodes them from bytes at init).
#   - A zero Point (Point.new) is invalid as in Go; using one panics with
#     Go's "edwards25519: use of uninitialized Point". Go makes Point
#     incomparable; alx structs compare with `==` by representation, which
#     is not point equality: use equal.
#   - Go's scalar_fiat.go is translated mechanically (scalar_fiat.alx);
#     the [4]uint64 elements are Scalar values.
#
# Timing: Go's constant-time structure is kept: scalar_base_mult and
# scalar_mult read every table entry with masks (no secret-dependent
# indexing or branches), and the scalar code is fiat-crypto's branch-free
# arithmetic with Go's math/bits carry formulas. var_time_double_scalar_base_mult
# is variable time, as in Go (it's for public inputs: verification). The
# field package's carries are comparisons (see its header). As in
# crypto/subtle, neither alx nor the C compiler behind --release formally
# guarantees branch-free output, as Go's compiler doesn't either.

# Errors of the decoding functions.
pub error EdwardsError {
  InvalidPointEncodingLength
  InvalidPointEncoding
  InvalidUniformBytesLength
  InvalidScalarLength
  InvalidScalarEncoding
  InvalidClampingLength

  def message -> Str {
    case self {
      InvalidPointEncodingLength => "edwards25519: invalid point encoding length"
      InvalidPointEncoding => "edwards25519: invalid point encoding"
      InvalidUniformBytesLength => "edwards25519: invalid SetUniformBytes input length"
      InvalidScalarLength => "invalid scalar length"
      InvalidScalarEncoding => "invalid scalar encoding"
      InvalidClampingLength => "edwards25519: invalid SetBytesWithClamping input length"
    }
  }
}

# Point types.

struct ProjP1xP1 {
  x: field.Element
  y: field.Element
  z: field.Element
  t: field.Element
}

struct ProjP2 {
  x: field.Element
  y: field.Element
  z: field.Element
}

struct ProjCached {
  yplus_x: field.Element
  yminus_x: field.Element
  z: field.Element
  t2d: field.Element
}

struct AffineCached {
  yplus_x: field.Element
  yminus_x: field.Element
  t2d: field.Element
}

# A point on the edwards25519 curve, in extended coordinates (X, Y, Z, T)
# where x = X/Z, y = Y/Z, and xy = T/Z per
# https://eprint.iacr.org/2008/522.
#
# The zero value (Point.new) is NOT valid.
pub struct Point {
  x: field.Element
  y: field.Element
  z: field.Element
  t: field.Element

  # The canonical 32-byte encoding of self, according to RFC 8032,
  # Section 5.1.2.
  pub def bytes -> [Byte] {
    check_initialized(self)
    z_inv = z.invert       # zInv = 1 / Z
    xx = x.multiply(z_inv) # x = X / Z
    yy = y.multiply(z_inv) # y = Y / Z
    out = yy.bytes
    out[31] = out[31] | (xx.is_negative << 7).as_u8
    out
  }

  # self + q.
  pub def add(q: Point) -> Point {
    check_initialized(self)
    check_initialized(q)
    p3_from_p1xp1(p1xp1_add(self, cached_from_p3(q)))
  }

  # self - q.
  pub def subtract(q: Point) -> Point {
    check_initialized(self)
    check_initialized(q)
    p3_from_p1xp1(p1xp1_sub(self, cached_from_p3(q)))
  }

  # -self.
  pub def negate -> Point {
    check_initialized(self)
    Point.new(x.negate, y, z, t.negate)
  }

  # 1 if self is equivalent to u, and 0 otherwise.
  pub def equal(u: Point) -> Int {
    check_initialized(self)
    check_initialized(u)
    t1 = x.multiply(u.z)
    t2 = u.x.multiply(z)
    t3 = y.multiply(u.z)
    t4 = u.y.multiply(z)
    t1.equal(t2) & t3.equal(t4)
  }

  # The point encoded by x (32 bytes). Fails if x does not represent a valid
  # point on the curve.
  #
  # All non-canonical encodings of valid points are accepted: decoding
  # follows most implementations in the ecosystem rather than RFC 8032.
  pub def self.set_bytes(x: [Byte]) -> ~Point<EdwardsError> {
    # The non-canonical encodings that are accepted are
    #   1) the ones where the field element is not reduced (see
    #      field.set_bytes) and
    #   2) the ones where the x-coordinate is zero and the sign bit is set.
    #
    # Read more at https://hdevalence.ca/blog/2020-10-04-its-25519am,
    # specifically the "Canonical A, R" section.
    fail EdwardsError.InvalidPointEncodingLength if x.size != 32
    y = field.set_bytes(x).unwrap

    # -x^2 + y^2 = 1 + dx^2y^2
    # x^2 + dx^2y^2 = x^2(dy^2 + 1) = y^2 - 1
    # x^2 = (y^2 - 1) / (dy^2 + 1)

    # u = y^2 - 1
    y2 = y.square
    u = y2.subtract(field.one())

    # v = dy^2 + 1
    vv = y2.multiply(d).add(field.one())

    # x = +sqrt(u/v)
    r = field.sqrt_ratio(u, vv)
    fail EdwardsError.InvalidPointEncoding if r[1] == 0
    xx = r[0]

    # Select the negative square root if the sign bit is set.
    xx = field.select(xx.negate, xx, (x[31] >> 7).as_i64)

    Point.new(xx, y, field.one(), xx.multiply(y)) # xy = T / Z
  }
}

# Panics if p is the zero value (Go's checkInitialized).
def check_initialized(p: Point) {
  zero = field.zero()
  panic("edwards25519: use of uninitialized Point") if p.x == zero && p.y == zero
}

# The point at infinity.
pub def new_identity_point -> Point { Point.new(field.zero(), field.one(), field.one(), field.zero()) }

# The canonical curve basepoint. See the "generator" test for the
# correspondence of this encoding with the values in RFC 8032.
pub def new_generator_point -> Point {
  Point.new(field.from_limbs(1738742601995546, 1146398526822698, 2070867633025821, 562264141797630, 587772402128613),
    field.from_limbs(1801439850948184, 1351079888211148, 450359962737049, 900719925474099, 1801439850948198),
    field.one(), field.from_limbs(1841354044333475, 16398895984059, 755974180946558, 900171276175154, 1821297809914039))
}

# d is a constant in the curve equation.
def d -> field.Element {
  field.from_limbs(929955233495203, 466365720129213, 1662059464998953, 2033849074728123, 1442794654840575)
}

# 2 * d.
def d2 -> field.Element {
  field.from_limbs(1859910466990425, 932731440258426, 1072319116312658, 1815898335770999, 633789495995903)
}

# Constructors.

def p2_zero -> ProjP2 { ProjP2.new(field.zero(), field.one(), field.one()) }

def cached_zero -> ProjCached { ProjCached.new(field.one(), field.one(), field.one(), field.zero()) }

def affine_zero -> AffineCached { AffineCached.new(field.one(), field.one(), field.zero()) }

# Conversions.

def p2_from_p1xp1(p: ProjP1xP1) -> ProjP2 { ProjP2.new(p.x.multiply(p.t), p.y.multiply(p.z), p.z.multiply(p.t)) }

def p2_from_p3(p: Point) -> ProjP2 { ProjP2.new(p.x, p.y, p.z) }

def p3_from_p1xp1(p: ProjP1xP1) -> Point {
  Point.new(p.x.multiply(p.t), p.y.multiply(p.z), p.z.multiply(p.t), p.x.multiply(p.y))
}

def p3_from_p2(p: ProjP2) -> Point { Point.new(p.x.multiply(p.z), p.y.multiply(p.z), p.z.square, p.x.multiply(p.y)) }

def cached_from_p3(p: Point) -> ProjCached { ProjCached.new(p.y.add(p.x), p.y.subtract(p.x), p.z, p.t.multiply(d2)) }

def affine_from_p3(p: Point) -> AffineCached {
  yplus_x = p.y.add(p.x)
  yminus_x = p.y.subtract(p.x)
  t2d = p.t.multiply(d2)
  inv_z = p.z.invert
  AffineCached.new(yplus_x.multiply(inv_z), yminus_x.multiply(inv_z), t2d.multiply(inv_z))
}

# (Re)addition and subtraction.

def p1xp1_add(p: Point, q: ProjCached) -> ProjP1xP1 {
  yplus_x = p.y.add(p.x)
  yminus_x = p.y.subtract(p.x)

  pp = yplus_x.multiply(q.yplus_x)
  mm = yminus_x.multiply(q.yminus_x)
  tt2d = p.t.multiply(q.t2d)
  zz2 = p.z.multiply(q.z)

  zz2 = zz2.add(zz2)

  ProjP1xP1.new(pp.subtract(mm), pp.add(mm), zz2.add(tt2d), zz2.subtract(tt2d))
}

def p1xp1_sub(p: Point, q: ProjCached) -> ProjP1xP1 {
  yplus_x = p.y.add(p.x)
  yminus_x = p.y.subtract(p.x)

  pp = yplus_x.multiply(q.yminus_x) # flipped sign
  mm = yminus_x.multiply(q.yplus_x) # flipped sign
  tt2d = p.t.multiply(q.t2d)
  zz2 = p.z.multiply(q.z)

  zz2 = zz2.add(zz2)

  ProjP1xP1.new(pp.subtract(mm), pp.add(mm), zz2.subtract(tt2d), zz2.add(tt2d)) # flipped signs
}

def p1xp1_add_affine(p: Point, q: AffineCached) -> ProjP1xP1 {
  yplus_x = p.y.add(p.x)
  yminus_x = p.y.subtract(p.x)

  pp = yplus_x.multiply(q.yplus_x)
  mm = yminus_x.multiply(q.yminus_x)
  tt2d = p.t.multiply(q.t2d)

  z2 = p.z.add(p.z)

  ProjP1xP1.new(pp.subtract(mm), pp.add(mm), z2.add(tt2d), z2.subtract(tt2d))
}

def p1xp1_sub_affine(p: Point, q: AffineCached) -> ProjP1xP1 {
  yplus_x = p.y.add(p.x)
  yminus_x = p.y.subtract(p.x)

  pp = yplus_x.multiply(q.yminus_x) # flipped sign
  mm = yminus_x.multiply(q.yplus_x) # flipped sign
  tt2d = p.t.multiply(q.t2d)

  z2 = p.z.add(p.z)

  ProjP1xP1.new(pp.subtract(mm), pp.add(mm), z2.subtract(tt2d), z2.add(tt2d)) # flipped signs
}

# Doubling.

def p1xp1_double(p: ProjP2) -> ProjP1xP1 {
  xx = p.x.square
  yy = p.y.square
  zz2 = p.z.square
  zz2 = zz2.add(zz2)
  xplus_ysq = p.x.add(p.y).square

  y = yy.add(xx)
  z = yy.subtract(xx)

  ProjP1xP1.new(xplus_ysq.subtract(y), y, z, zz2.subtract(z))
}

# Constant-time operations.

# a if cond == 1 and b if cond == 0.
def cached_select(a: ProjCached, b: ProjCached, cond: Int) -> ProjCached {
  ProjCached.new(field.select(a.yplus_x, b.yplus_x, cond), field.select(a.yminus_x, b.yminus_x, cond),
    field.select(a.z, b.z, cond), field.select(a.t2d, b.t2d, cond))
}

# a if cond == 1 and b if cond == 0.
def affine_select(a: AffineCached, b: AffineCached, cond: Int) -> AffineCached {
  AffineCached.new(field.select(a.yplus_x, b.yplus_x, cond), field.select(a.yminus_x, b.yminus_x, cond),
    field.select(a.t2d, b.t2d, cond))
}

# -v if cond == 1, and v if cond == 0.
def cached_cond_neg(v: ProjCached, cond: Int) -> ProjCached {
  ProjCached.new(field.select(v.yminus_x, v.yplus_x, cond), field.select(v.yplus_x, v.yminus_x, cond), v.z,
    field.select(v.t2d.negate, v.t2d, cond))
}

# -v if cond == 1, and v if cond == 0.
def affine_cond_neg(v: AffineCached, cond: Int) -> AffineCached {
  AffineCached.new(field.select(v.yminus_x, v.yplus_x, cond), field.select(v.yplus_x, v.yminus_x, cond),
    field.select(v.t2d.negate, v.t2d, cond))
}
