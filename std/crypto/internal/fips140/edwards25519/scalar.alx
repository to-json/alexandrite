# An integer modulo
#
#   l = 2^252 + 27742317777372353535851937790883648493
#
# which is the prime order of the edwards25519 group. A value: operations
# return new Scalars. The zero value (Scalar.new) is a valid zero.
pub struct Scalar {
  # The scalar in the Montgomery domain, in the format of the fiat-crypto
  # implementation (little-endian 64-bit limbs).
  s0: U64
  s1: U64
  s2: U64
  s3: U64

  # x * y + z mod l. Equivalent to multiply and then add.
  pub def multiply_add(y: Scalar, z: Scalar) -> Scalar { fiat_scalar_add(fiat_scalar_mul(self, y), z) }

  # self + y mod l.
  pub def add(y: Scalar) -> Scalar { fiat_scalar_add(self, y) }

  # self - y mod l.
  pub def subtract(y: Scalar) -> Scalar { fiat_scalar_sub(self, y) }

  # -self mod l.
  pub def negate -> Scalar { fiat_scalar_opp(self) }

  # self * y mod l.
  pub def multiply(y: Scalar) -> Scalar { fiat_scalar_mul(self, y) }

  # The canonical 32-byte little-endian encoding.
  pub def bytes -> [Byte] {
    ss = fiat_scalar_from_montgomery(self)
    out = [0.as_u8; 32]
    put_le64(out, 0, ss.s0)
    put_le64(out, 8, ss.s1)
    put_le64(out, 16, ss.s2)
    put_le64(out, 24, ss.s3)
    out
  }

  # 1 if self and t are equal, and 0 otherwise.
  pub def equal(t: Scalar) -> Int {
    diff = fiat_scalar_sub(self, t)
    nonzero = diff.s0 | diff.s1 | diff.s2 | diff.s3
    nonzero = nonzero | (nonzero >> 32)
    nonzero = nonzero | (nonzero >> 16)
    nonzero = nonzero | (nonzero >> 8)
    nonzero = nonzero | (nonzero >> 4)
    nonzero = nonzero | (nonzero >> 2)
    nonzero = nonzero | (nonzero >> 1)
    (^nonzero & 1).as_i64
  }

  # A width-w non-adjacent form of this scalar (256 digits). w must be
  # between 2 and 8. Adapted from curve25519-dalek, as in Go:
  # https://github.com/dalek-cryptography/curve25519-dalek/blob/f630041af28e9a405255f98a8a93adca18e4315b/src/scalar.rs#L800-L871
  def non_adjacent_form(w: Int) -> [I8] {
    b = bytes
    panic("scalar has high bit set illegally") if b[31] > 127
    panic("w must be at least 2 by the definition of NAF") if w < 2
    panic("NAF digits must fit in int8") if w > 8

    naf = [0.as_i8; 256]
    digits = [0.as_u64; 5]
    i = 0
    while i < 4 {
      digits[i] = le64(b, i * 8)
      i += 1
    }

    width = (1 << w).as_u64
    window_mask = width - 1

    pos = 0
    carry: U64 = 0
    while pos < 256 {
      index_u64 = pos / 64
      index_bit = pos % 64
      bit_buf: U64 = 0
      if index_bit < 64 - w {
        # This window's bits are contained in a single u64.
        bit_buf = digits[index_u64] >> index_bit
      } else {
        # Combine the current 64 bits with bits from the next 64.
        bit_buf = (digits[index_u64] >> index_bit) | (digits[1 + index_u64] << (64 - index_bit))
      }

      # Add carry into the current window.
      window = carry + (bit_buf & window_mask)

      if window & 1 == 0 {
        # If the window value is even, preserve the carry and continue:
        # if carry == 0 and window & 1 == 0, the next carry should be 0;
        # if carry == 1 and window & 1 == 0, then bit_buf & 1 == 1 so the
        # next carry should be 1.
        pos += 1
        next
      }

      if window < width / 2 {
        carry = 0
        naf[pos] = window.as_i8
      } else {
        carry = 1
        naf[pos] = window.as_i8 -% width.as_i8
      }

      pos += w
    }
    naf
  }

  # The signed radix-16 digits (64 of them, each in [-8, 8)).
  def signed_radix16 -> [I8] {
    b = bytes
    panic("scalar has high bit set illegally") if b[31] > 127

    digits = [0.as_i8; 64]

    # Compute unsigned radix-16 digits:
    i = 0
    while i < 32 {
      digits[2 * i] = (b[i] & 15).as_i8
      digits[2 * i + 1] = ((b[i] >> 4) & 15).as_i8
      i += 1
    }

    # Recenter coefficients:
    i = 0
    while i < 63 {
      carry = (digits[i] + 8) >> 4
      digits[i] = digits[i] - (carry << 4)
      digits[i + 1] = digits[i + 1] + carry
      i += 1
    }
    digits
  }

  # s = x mod l, where x is a 64-byte little-endian integer. Fails if x is
  # not 64 bytes. Gives a uniformly distributed value for 64 uniformly
  # distributed random bytes.
  pub def self.set_uniform_bytes(x: [Byte]) -> ~Scalar<EdwardsError> {
    fail EdwardsError.InvalidUniformBytesLength if x.size != 64
    # x is 512 bits, but fiat_scalar_from_bytes expects an input lower than
    # l, a little over 252 bits. Instead of a reduction function for wider
    # inputs, x is the sum of three shorter values a, b and c:
    #
    #    x = a + b * 2^168 + c * 2^336  mod l
    #
    # and with 2^168 and 2^336 modulo l precomputed, the reduction is two
    # multiplications and two additions.
    s = set_short_bytes(x[0...21])
    t = set_short_bytes(x[21...42])
    s = s.add(t.multiply(scalar_two168))
    t = set_short_bytes(x[42...64])
    s.add(t.multiply(scalar_two336))
  }

  # s = x, where x is the 32-byte little-endian canonical encoding of s.
  # Fails if x is not 32 bytes or not canonical (reduced modulo l).
  pub def self.set_canonical_bytes(x: [Byte]) -> ~Scalar<EdwardsError> {
    fail EdwardsError.InvalidScalarLength if x.size != 32
    fail EdwardsError.InvalidScalarEncoding if !reduced?(x)
    fiat_scalar_to_montgomery(fiat_scalar_from_bytes(x))
  }

  # The scalar from x with the buffer pruning of RFC 8032, Section 5.1.5
  # (clamping) applied. x must be 32 bytes; it is not modified.
  #
  # Scalars are always reduced modulo the prime order of the curve, so the
  # result doesn't keep the cofactor-clearing properties that clamping is
  # meant to provide. It works as expected on points of the prime order
  # subgroup, as in Ed25519, and RFC 8032 requires it for compatibility.
  pub def self.set_bytes_with_clamping(x: [Byte]) -> ~Scalar<EdwardsError> {
    fail EdwardsError.InvalidClampingLength if x.size != 32
    # The wide reduction of set_uniform_bytes is needed, since clamping
    # sets the 2^254 bit, making the value higher than the order.
    wide = [0.as_u8; 64]
    copy(wide, x)
    wide[0] = wide[0] & 248
    wide[31] = wide[31] & 63
    wide[31] = wide[31] | 64
    Scalar.set_uniform_bytes(wide).unwrap
  }
}

# A new zero Scalar.
pub def new_scalar -> Scalar { Scalar.new }

# 2^168 and 2^336 modulo l in the Montgomery domain.
def scalar_two168 -> Scalar { Scalar.new(0x5b8ab432eac74798, 0x38afddd6de59d5d7, 0xa2c131b399411b7c, 0x6329a7ed9ce5a30) }

def scalar_two336 -> Scalar { Scalar.new(0xbd3d108e2b35ecc5, 0x5c3a3718bdf9c90b, 0x63aa97a331b4f2ee, 0x3d217f5be65cb5c) }

# x mod l, where x is a little-endian integer shorter than 32 bytes.
def set_short_bytes(x: [Byte]) -> Scalar {
  panic("edwards25519: internal error: setShortBytes called with a long string") if x.size >= 32
  buf = [0.as_u8; 32]
  copy(buf, x)
  fiat_scalar_to_montgomery(fiat_scalar_from_bytes(buf))
}

# l - 1, little-endian 64-bit words.
SCALAR_MINUS_ONE: [U64; 4] = [0x5812631a5cf5d3ec, 0x14def9dea2f79cd6, 0, 0x1000000000000000]

# Whether the 32-byte little-endian scalar s is reduced modulo l.
def reduced?(s: [Byte]) -> Bool {
  return false if s.size != 32
  # A constant-time subtraction chain (l - 1) - s: a borrow at the end
  # means s > l - 1.
  b: U64 = 0
  i = 0
  while i < 4 {
    x = SCALAR_MINUS_ONE[i]
    y = le64(s, i * 8)
    diff = x - y - b
    b = ((^x & y) | (^(x ^ y) & diff)) >> 63
    i += 1
  }
  b == 0
}

# The fiat-crypto FromBytes: the four little-endian words of x (32 bytes).
def fiat_scalar_from_bytes(x: [Byte]) -> Scalar { Scalar.new(le64(x, 0), le64(x, 8), le64(x, 16), le64(x, 24)) }

def le64(x: [Byte], i: Int) -> U64 {
  x[i].as_u64 | (x[i + 1].as_u64 << 8) | (x[i + 2].as_u64 << 16) | (x[i + 3].as_u64 << 24) |
  (x[i + 4].as_u64 << 32) | (x[i + 5].as_u64 << 40) | (x[i + 6].as_u64 << 48) | (x[i + 7].as_u64 << 56)
}

def put_le64(b: [Byte], i: Int, v: U64) {
  b[i] = v.as_u8
  b[i + 1] = (v >> 8).as_u8
  b[i + 2] = (v >> 16).as_u8
  b[i + 3] = (v >> 24).as_u8
  b[i + 4] = (v >> 32).as_u8
  b[i + 5] = (v >> 40).as_u8
  b[i + 6] = (v >> 48).as_u8
  b[i + 7] = (v >> 56).as_u8
}
