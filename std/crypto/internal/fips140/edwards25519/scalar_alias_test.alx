#![overflow(wrap)]
# Go's scalar_alias_test.go, for values. Go checks that a pointer receiver
# may alias the arguments (v.Add(v, v)); alx Scalars are values and every
# operation returns a new one, so the value equivalent is checked: f with
# the same value passed twice agrees with f on a copy, the results are
# reduced, and the arguments are unchanged afterwards.

test "scalar aliasing" {
  r = new_rng(30)
  i = 0
  while i < 3200 {
    x = gen_scalar(r)
    y = gen_scalar(r)
    fixed = gen_scalar(r)
    x1 = x
    y1 = y
    assert x.negate == x1.negate && reduced?(x.negate.bytes), "negate"
    assert x.multiply(x) == x.multiply(x1) && x.multiply(y) == x1.multiply(y1), "multiply"
    assert reduced?(x.multiply(y).bytes), "multiply reduced"
    assert x.add(x) == x.add(x1) && x.add(y) == x1.add(y1) && reduced?(x.add(y).bytes), "add"
    assert x.subtract(x) == x.subtract(x1) && x.subtract(y) == x1.subtract(y1), "subtract"
    assert reduced?(x.subtract(y).bytes), "subtract reduced"
    assert fixed.multiply_add(x, x) == fixed.multiply_add(x1, x), "multiply_add 1"
    assert x.multiply_add(fixed, x) == x1.multiply_add(fixed, x), "multiply_add 2"
    assert x.multiply_add(x, fixed) == x.multiply_add(x1, fixed), "multiply_add 3"
    assert x.multiply_add(y, fixed) == x.multiply(y).add(fixed), "multiply_add is multiply then add"
    assert x == x1 && y == y1, "arguments modified"
    i += 1
  }
}
