  assert_eq senc(x.subtract(y)), "918bcb8105d767451cb4c368c9bf65616bc7b787d2e3c6d45abbc204e86d590e"
  assert_eq senc(x.negate), "9bc3d9a13725d22f9a650fae916870577be42079a100557f5e13d0e9aedf030d"
  assert_eq senc(x.multiply(y)), "f84fd395e73601b589cdf93429c032d30ae19f6fa3995c5a7e08c17dc6a33402"
  x = vs("ae584696f7c9ea3af61f1c2f62cbe770195427ff8b1be4ab46316d1169b2a204")
