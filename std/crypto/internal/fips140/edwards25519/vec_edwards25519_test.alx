import "encoding/hex"

def vh(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

def vs(s: Str) -> Scalar { Scalar.set_canonical_bytes(vh(s)).unwrap }

def vp(s: Str) -> Point { Point.set_bytes(vh(s)).unwrap }

def enc(p: Point) -> Str { hex.encode_to_string(p.bytes) }

def senc(s: Scalar) -> Str { hex.encode_to_string(s.bytes) }

