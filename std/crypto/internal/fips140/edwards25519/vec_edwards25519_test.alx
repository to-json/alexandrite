test "vec point decoding" {
  assert_eq enc(vp("12418d20aa9917cacf091172b7a5c3035b3036f35c51cb58496a340b2fe8864b")), "12418d20aa9917cacf091172b7a5c3035b3036f35c51cb58496a340b2fe8864b"
  assert_eq enc(vp("3394e3f47b052b84a28b111f118c9c4c6628219755f41413d2f1bc4d2ce3b475")), "3394e3f47b052b84a28b111f118c9c4c6628219755f41413d2f1bc4d2ce3b475"
  assert_eq enc(vp("1359a1804a7477e1b802d17e7f92991dc2026532e6a3101d141bf2e5f8eafbe4")), "1359a1804a7477e1b802d17e7f92991dc2026532e6a3101d141bf2e5f8eafbe4"
  assert Point.set_bytes(vh("176281d2b1587b9c7d3e5969514f15d10064d31ff567a27c77642992acb958e3")).err?, "invalid 3"
  assert Point.set_bytes(vh("6e9e13de64a43d519936117d848e7fe6a38f85e775ccedd0259be0e7d710691b")).err?, "invalid 4"
  assert Point.set_bytes(vh("38be1d62028f5b639cdc906bb973a1355a4d568dcc26e647b16fcb33461c7e1d")).err?, "invalid 5"
  assert Point.set_bytes(vh("5ed7dff0838a06f15fc513d83fb94388937c34ae33b30479164eac6be1e26dc7")).err?, "invalid 6"
  assert Point.set_bytes(vh("2aec55dc306fea336eebe8f8c9f3f9096b906ca8d69a9d295640794f608e446d")).err?, "invalid 7"
  assert Point.set_bytes(vh("59fb7aa23ac58013bfefc2990b3fe8ffa524c99586a4c42d4e78267c2bcdf0ae")).err?, "invalid 8"
  assert Point.set_bytes(vh("c191d1728c794b08cb589aea6533ec4cb1ab378beb249444308e057a3410afe7")).err?, "invalid 9"
  assert Point.set_bytes(vh("3f85775653003f62794f4ca6feb95903d02581c22d4f92936fed82b991047dd2")).err?, "invalid 10"
  assert_eq enc(vp("976c26ba2fe227b32e1bc1a6617baa522570f43ad82ae20da1eb029d413f91e9")), "976c26ba2fe227b32e1bc1a6617baa522570f43ad82ae20da1eb029d413f91e9"
  assert_eq enc(vp("7ca1d3e81bea11962570d44dac168fc081c826b0aa252a31f7d22493058d5c01")), "7ca1d3e81bea11962570d44dac168fc081c826b0aa252a31f7d22493058d5c01"
