test "vec point add subtract negate" {
  p = vp("ff2fba5b12b971b72e5ad58f4590b35b405733e47c0b5a8600d6f2f7e9efd113")
  q = vp("9fb1965a19153be1e6d1a00b72796178367426b6a9de1d63e097ae37fdc50fd3")
  assert_eq enc(p.add(q)), "e8fd5af146e979bfc312343b2e4a246ae8b1d35038dd7e0ee201d426d5aa56b4"
  assert_eq enc(p.subtract(q)), "48da085ee00285fa279d1d99f5d9a2058c39db492e2068e5d6d76ed0d75d66c8"
  assert_eq enc(p.negate), "ff2fba5b12b971b72e5ad58f4590b35b405733e47c0b5a8600d6f2f7e9efd193"
  p = vp("df05b6b1b6466e3924919f6314b35773a4a41e5054daa08e7d192f546d8c935e")
  q = vp("86045d9712e0a82a21455a4e1bef88d56980255848b62068e8e124936429489a")
  assert_eq enc(p.add(q)), "63044db801e3b539d45dbdfc27802cae6b803d629f0e47e35034758c0304cdad"
  assert_eq enc(p.subtract(q)), "982627402c5ddb9eb4e397c20ed0f059bd8c12242382a1992ce5bcaa25924b6e"
  assert_eq enc(p.negate), "df05b6b1b6466e3924919f6314b35773a4a41e5054daa08e7d192f546d8c93de"
  p = vp("f5767aea7e08fdc4f60c1253d0cacc7c61931cd0373dd62771acb480454e653b")
  q = vp("bda4ce2ad62fbb4a533e01f69ca3bac6d6d58a23b63466ae8a5247caa8c62ae6")
  assert_eq enc(p.add(q)), "7e6c09e295688a09f40be93c9b6b7adf471f5c5129bd91e19d13f0b76a8347be"
  assert_eq enc(p.subtract(q)), "a0c89983199db9a5652483fc9bf4a2421117265ba4dc79541ef3583e9853fa95"
