test "vec scalar arithmetic" {
  x = vs("e37d29c86090f6c04c46f9bf3f2d9a8e937c440122f844c145541766e52e9c03")
  y = vs("544cbd7c0c91b39533337d78d56cb49e718e0702fc9a91ed35db61bf42c92d09")
  z = vs("52101cbbe23d40283c37e8f44c916ebd841bdf865effaa80a1ec2f165120fc02")
  assert_eq senc(x.multiply_add(y, z)), "ed04ea469983930d0eaa4279a13501042794ea0274f05a135f3322f345e4aa07"
  assert_eq senc(x.subtract(y)), "7c0562a86e625583efaf73ea48bac40422ee3cff255db3d30f79b5a6a2656e0a"
  assert_eq senc(x.negate), "0a56cc94b9d21b978956fee29ecc44866c83bbfedd07bb3ebaabe8991ad1630c"
  assert_eq senc(x.multiply(y)), "9bf4cd8bb64553e5d1725a8454a49246a2780b7c15f1af92bd46f2dcf4c3ae04"
  x = vs("544cbd7c0c91b39533337d78d56cb49e718e0702fc9a91ed35db61bf42c92d09")
  y = vs("52101cbbe23d40283c37e8f44c916ebd841bdf865effaa80a1ec2f165120fc02")
  z = vs("ae584696f7c9ea3af61f1c2f62cbe770195427ff8b1be4ab46316d1169b2a204")
  assert_eq senc(x.multiply_add(y, z)), "2cd0987be51876c91f5062d221e2468f9c1be528da00ac072df38520b8a2a80a"
  assert_eq senc(x.subtract(y)), "023ca1c12953736df7fb948388db45e1ec72287b9d9be66c94ee31a9f1a83106"
  assert_eq senc(x.negate), "998738e00dd25ec2a2697a2a098d2a768e71f8fd03656e12ca249e40bd36d206"
  assert_eq senc(x.multiply(y)), "7e7752e5ed4e8b8e293046a3bf165f1e83c7bd294ee5c75be6c1180f4ff00506"
  x = vs("52101cbbe23d40283c37e8f44c916ebd841bdf865effaa80a1ec2f165120fc02")
  y = vs("ae584696f7c9ea3af61f1c2f62cbe770195427ff8b1be4ab46316d1169b2a204")
