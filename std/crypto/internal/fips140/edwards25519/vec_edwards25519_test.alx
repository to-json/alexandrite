  assert_eq senc(x.subtract(y)), "e2a9995f96c7bb206c580820c47e14880dafc4fe02ad9e38a56ed9662a12ad02"
  assert_eq senc(x.negate), "e7d0aae4b75f3b48018da6acda5bbb21d016c4a4c092410a687e0d9d7976ee05"
  assert_eq senc(x.multiply(y)), "d12f425356c693012e7af44e63bc6cb8e79835c108167d98f03019e843853c09"
  x = vs("2459b118cc3b1bef68b748d63f1f0f6b223a775c3cc01fbdf21219fc5b776407")
