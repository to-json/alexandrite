# Go's benchmark_test.go: BenchmarkMul and BenchmarkSquare. Each iteration
# does 1000 operations (v = v * v), so ns/op here is 1000x Go's.

bench "mul P224 x1000" {
  v = P224Element.one.add(P224Element.one)
  i = 0
  while i < 1000 {
    v = v.mul(v)
    i += 1
  }
  assert v.is_zero == 0
}

bench "mul P256 x1000" {
  v = P256Element.one.add(P256Element.one)
  i = 0
  while i < 1000 {
    v = v.mul(v)
    i += 1
  }
  assert v.is_zero == 0
}

bench "mul P384 x1000" {
  v = P384Element.one.add(P384Element.one)
  i = 0
  while i < 1000 {
    v = v.mul(v)
    i += 1
  }
  assert v.is_zero == 0
}

bench "mul P521 x1000" {
  v = P521Element.one.add(P521Element.one)
  i = 0
  while i < 1000 {
    v = v.mul(v)
    i += 1
  }
  assert v.is_zero == 0
}

bench "square P224 x1000" {
  v = P224Element.one.add(P224Element.one)
  i = 0
  while i < 1000 {
    v = v.square
    i += 1
  }
  assert v.is_zero == 0
}

bench "square P256 x1000" {
  v = P256Element.one.add(P256Element.one)
  i = 0
  while i < 1000 {
    v = v.square
    i += 1
  }
  assert v.is_zero == 0
}

bench "square P384 x1000" {
  v = P384Element.one.add(P384Element.one)
  i = 0
  while i < 1000 {
    v = v.square
    i += 1
  }
  assert v.is_zero == 0
}

bench "square P521 x1000" {
  v = P521Element.one.add(P521Element.one)
  i = 0
  while i < 1000 {
    v = v.square
    i += 1
  }
  assert v.is_zero == 0
}

bench "invert P256" {
  P256Element.one.add(P256Element.one).invert
}
