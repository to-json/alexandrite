# Go's fiat package has no tests besides benchmark_test.go; these cover the
# wrapper API (vec_fiat_test.alx has the arithmetic vectors).

test "p256 basics" {
  one = P256Element.one
  b = one.bytes
  assert_eq b.size, 32
  assert_eq b[31], 1
  assert_eq one.equal(one), 1
  assert_eq P256Element.new.is_zero, 1
  assert_eq one.is_zero, 0
  two = one.add(one)
  assert_eq two.bytes[31], 2
  assert_eq two.mul(two.invert).equal(one), 1
  assert_eq P256Element.new.sub(one).add(one).is_zero, 1
  assert_eq P256Element.new.invert.is_zero, 1
}

test "select and equal" {
  one = P224Element.one
  two = one.add(one)
  assert_eq P224Element.select(one, two, 1).equal(one), 1
  assert_eq P224Element.select(one, two, 0).equal(two), 1
  assert_eq one.equal(two), 0
  a = P384Element.one
  b = a.add(a)
  assert_eq P384Element.select(a, b, 1).equal(a), 1
  assert_eq P384Element.select(a, b, 0).equal(b), 1
  c = P521Element.one
  d = c.add(c)
  assert_eq P521Element.select(c, d, 1).equal(c), 1
  assert_eq P521Element.select(c, d, 0).equal(d), 1
  assert_eq d.sub(c).equal(c), 1
}

test "from_bytes errors" {
  r = P256Element.from_bytes([0.as_u8; 31])
  assert r.err?
  assert_eq r.err.unwrap.message, "invalid P256Element encoding"
  r2 = P521Element.from_bytes([0xff.as_u8; 66])
  assert_eq r2.err.unwrap.message, "invalid P521Element encoding"
  assert P521Element.from_bytes([0.as_u8; 66]).unwrap.is_zero == 1
}
