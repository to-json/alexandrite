# Subtracts two field elements in the Montgomery domain.
def p224_sub(arg1: P224Element, arg2: P224Element) -> P224Element {
  x1 = arg1.l0 - arg2.l0
  x2 = ((^arg1.l0 & arg2.l0) | (^(arg1.l0 ^ arg2.l0) & x1)) >> 63
  x3 = arg1.l1 - arg2.l1 - x2
  x4 = ((^arg1.l1 & arg2.l1) | (^(arg1.l1 ^ arg2.l1) & x3)) >> 63
  x5 = arg1.l2 - arg2.l2 - x4
  x6 = ((^arg1.l2 & arg2.l2) | (^(arg1.l2 ^ arg2.l2) & x5)) >> 63
  x7 = arg1.l3 - arg2.l3 - x6
  x8 = ((^arg1.l3 & arg2.l3) | (^(arg1.l3 ^ arg2.l3) & x7)) >> 63
  x9 = ((0.as_u64 - x8) & 0xffffffffffffffff) | (^(0.as_u64 - x8) & 0)
