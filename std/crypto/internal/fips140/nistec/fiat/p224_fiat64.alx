}

# Deserializes a field element NOT in the Montgomery domain from bytes in little-endian order (28 bytes).
def p224_from_bytes(arg1: [Byte]) -> P224Element {
  x1 = arg1[27].as_u64 << 24
  x2 = arg1[26].as_u64 << 16
  x3 = arg1[25].as_u64 << 8
  x4 = arg1[24]
  x5 = arg1[23].as_u64 << 56
