# A multi-limb conditional select: arg2 if arg1 == 0, else arg3.
def p224_selectznz(arg1: U64, arg2: P224Element, arg3: P224Element) -> P224Element {
  x1 = ((0.as_u64 - arg1) & arg3.l0) | (^(0.as_u64 - arg1) & arg2.l0)
  x2 = ((0.as_u64 - arg1) & arg3.l1) | (^(0.as_u64 - arg1) & arg2.l1)
  x3 = ((0.as_u64 - arg1) & arg3.l2) | (^(0.as_u64 - arg1) & arg2.l2)
  x4 = ((0.as_u64 - arg1) & arg3.l3) | (^(0.as_u64 - arg1) & arg2.l3)
  P224Element.new(l0: x1, l1: x2, l2: x3, l3: x4)
}

# Serializes a field element NOT in the Montgomery domain to bytes in little-endian order into out1 (28 bytes).
def p224_to_bytes(out1: [Byte], arg1: P224Element) {
  x1 = arg1.l3
  x2 = arg1.l2
  x3 = arg1.l1
  x4 = arg1.l0
