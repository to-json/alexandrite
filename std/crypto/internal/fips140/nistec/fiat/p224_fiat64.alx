  x22 = x20 >> 8
  x23 = x22.as_u8 & 0xff
  x24 = x22 >> 8
  x25 = x24.as_u8 & 0xff
  x26 = x24 >> 8
  x27 = x26.as_u8 & 0xff
  x28 = x26 >> 8
  x29 = x28.as_u8 & 0xff
  x30 = x28 >> 8
  x31 = x30.as_u8 & 0xff
  x32 = (x30 >> 8).as_u8
  x33 = x2.as_u8 & 0xff
  x34 = x2 >> 8
  x35 = x34.as_u8 & 0xff
  x36 = x34 >> 8
  x37 = x36.as_u8 & 0xff
  x38 = x36 >> 8
  x39 = x38.as_u8 & 0xff
  x40 = x38 >> 8
  x41 = x40.as_u8 & 0xff
  x42 = x40 >> 8
  x43 = x42.as_u8 & 0xff
  x44 = x42 >> 8
  x45 = x44.as_u8 & 0xff
  x46 = (x44 >> 8).as_u8
  x47 = x1.as_u8 & 0xff
  x48 = x1 >> 8
  x49 = x48.as_u8 & 0xff
  x50 = x48 >> 8
  x51 = x50.as_u8 & 0xff
  x52 = (x50 >> 8).as_u8
  out1[0] = x5
  out1[1] = x7
  out1[2] = x9
  out1[3] = x11
  out1[4] = x13
  out1[5] = x15
  out1[6] = x17
  out1[7] = x18
  out1[8] = x19
  out1[9] = x21
  out1[10] = x23
  out1[11] = x25
  out1[12] = x27
  out1[13] = x29
  out1[14] = x31
  out1[15] = x32
  out1[16] = x33
  out1[17] = x35
  out1[18] = x37
  out1[19] = x39
  out1[20] = x41
  out1[21] = x43
  out1[22] = x45
  out1[23] = x46
  out1[24] = x47
  out1[25] = x49
  out1[26] = x51
  out1[27] = x52
