  x12 = x3 + (x9 & 0xffffffff00000000) + x11
  x13 = ((x3 & (x9 & 0xffffffff00000000)) | ((x3 | (x9 & 0xffffffff00000000)) &^ x12)) >> 63
  x14 = x5 + x9 + x13
  x15 = ((x5 & x9) | ((x5 | x9) &^ x14)) >> 63
  x16 = x7 + (x9 & 0xffffffff) + x15
  P224Element.new(l0: x10, l1: x12, l2: x14, l3: x16)
}

# The field element one in the Montgomery domain.
def p224_set_one() -> P224Element {
