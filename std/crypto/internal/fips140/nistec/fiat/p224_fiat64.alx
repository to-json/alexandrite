  x6 = x4 >> 8
  x7 = x6.as_u8 & 0xff
  x8 = x6 >> 8
  x9 = x8.as_u8 & 0xff
  x10 = x8 >> 8
  x11 = x10.as_u8 & 0xff
  x12 = x10 >> 8
  x13 = x12.as_u8 & 0xff
  x14 = x12 >> 8
  x15 = x14.as_u8 & 0xff
  x16 = x14 >> 8
  x17 = x16.as_u8 & 0xff
  x18 = (x16 >> 8).as_u8
