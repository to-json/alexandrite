  x9 = ((0.as_u64 - x8) & 0xffffffffffffffff) | (^(0.as_u64 - x8) & 0)
  x10 = x1 + x9
  x11 = ((x1 & x9) | ((x1 | x9) &^ x10)) >> 63
  x12 = x3 + (x9 & 0xffffffff) + x11
  x13 = ((x3 & (x9 & 0xffffffff)) | ((x3 | (x9 & 0xffffffff)) &^ x12)) >> 63
  x14 = x5 + x13
  x15 = ((x5 & 0) | ((x5 | 0) &^ x14)) >> 63
  x16 = x7 + (x9 & 0xffffffff00000001) + x15
  P256Element.new(l0: x10, l1: x12, l2: x14, l3: x16)
}

# The field element one in the Montgomery domain.
def p256_set_one() -> P256Element {
  P256Element.new(l0: 1, l1: 0xffffffff00000000, l2: 0xffffffffffffffff, l3: 0xfffffffe)
}

# Translates a field element out of the Montgomery domain.
def p256_from_montgomery(arg1: P256Element) -> P256Element {
  x1 = arg1.l0
  x2 = x1 * 0xffffffff00000001
  x3 = x1.__mulhi(0xffffffff00000001)
  x4 = x1 * 0xffffffff
  x5 = x1.__mulhi(0xffffffff)
  x6 = x1 * 0xffffffffffffffff
  x7 = x1.__mulhi(0xffffffffffffffff)
  x8 = x7 + x4
  x9 = ((x7 & x4) | ((x7 | x4) &^ x8)) >> 63
  x11_s = x1 + x6
  x11 = ((x1 & x6) | ((x1 | x6) &^ x11_s)) >> 63
  x12 = x8 + x11
  x13 = ((0 & x8) | ((0 | x8) &^ x12)) >> 63
  x14 = x12 + arg1.l1
  x15 = ((x12 & arg1.l1) | ((x12 | arg1.l1) &^ x14)) >> 63
  x16 = x14 * 0xffffffff00000001
  x17 = x14.__mulhi(0xffffffff00000001)
  x18 = x14 * 0xffffffff
  x19 = x14.__mulhi(0xffffffff)
  x20 = x14 * 0xffffffffffffffff
  x21 = x14.__mulhi(0xffffffffffffffff)
  x22 = x21 + x18
  x23 = ((x21 & x18) | ((x21 | x18) &^ x22)) >> 63
  x25_s = x14 + x20
  x25 = ((x14 & x20) | ((x14 | x20) &^ x25_s)) >> 63
  x26 = (x15 + (x13 + (x9 + x5))) + x22 + x25
  x27 = (((x15 + (x13 + (x9 + x5))) & x22) | (((x15 + (x13 + (x9 + x5))) | x22) &^ x26)) >> 63
  x28 = x2 + (x23 + x19) + x27
  x29 = ((x2 & (x23 + x19)) | ((x2 | (x23 + x19)) &^ x28)) >> 63
  x30 = x3 + x16 + x29
  x31 = ((x3 & x16) | ((x3 | x16) &^ x30)) >> 63
  x32 = x26 + arg1.l2
  x33 = ((x26 & arg1.l2) | ((x26 | arg1.l2) &^ x32)) >> 63
  x34 = x28 + x33
  x35 = ((x28 & 0) | ((x28 | 0) &^ x34)) >> 63
  x36 = x30 + x35
  x37 = ((x30 & 0) | ((x30 | 0) &^ x36)) >> 63
  x38 = x32 * 0xffffffff00000001
  x39 = x32.__mulhi(0xffffffff00000001)
  x40 = x32 * 0xffffffff
  x41 = x32.__mulhi(0xffffffff)
  x42 = x32 * 0xffffffffffffffff
  x43 = x32.__mulhi(0xffffffffffffffff)
  x44 = x43 + x40
  x45 = ((x43 & x40) | ((x43 | x40) &^ x44)) >> 63
  x47_s = x32 + x42
  x47 = ((x32 & x42) | ((x32 | x42) &^ x47_s)) >> 63
  x48 = x34 + x44 + x47
  x49 = ((x34 & x44) | ((x34 | x44) &^ x48)) >> 63
  x50 = x36 + (x45 + x41) + x49
  x51 = ((x36 & (x45 + x41)) | ((x36 | (x45 + x41)) &^ x50)) >> 63
  x52 = (x37 + (x31 + x17)) + x38 + x51
  x53 = (((x37 + (x31 + x17)) & x38) | (((x37 + (x31 + x17)) | x38) &^ x52)) >> 63
  x54 = x48 + arg1.l3
  x55 = ((x48 & arg1.l3) | ((x48 | arg1.l3) &^ x54)) >> 63
  x56 = x50 + x55
  x57 = ((x50 & 0) | ((x50 | 0) &^ x56)) >> 63
  x58 = x52 + x57
  x59 = ((x52 & 0) | ((x52 | 0) &^ x58)) >> 63
  x60 = x54 * 0xffffffff00000001
  x61 = x54.__mulhi(0xffffffff00000001)
  x62 = x54 * 0xffffffff
  x63 = x54.__mulhi(0xffffffff)
  x64 = x54 * 0xffffffffffffffff
  x65 = x54.__mulhi(0xffffffffffffffff)
  x66 = x65 + x62
  x67 = ((x65 & x62) | ((x65 | x62) &^ x66)) >> 63
  x69_s = x54 + x64
  x69 = ((x54 & x64) | ((x54 | x64) &^ x69_s)) >> 63
  x70 = x56 + x66 + x69
  x71 = ((x56 & x66) | ((x56 | x66) &^ x70)) >> 63
  x72 = x58 + (x67 + x63) + x71
  x73 = ((x58 & (x67 + x63)) | ((x58 | (x67 + x63)) &^ x72)) >> 63
  x74 = (x59 + (x53 + x39)) + x60 + x73
  x75 = (((x59 + (x53 + x39)) & x60) | (((x59 + (x53 + x39)) | x60) &^ x74)) >> 63
  x76 = x75 + x61
  x77 = x70 - 0xffffffffffffffff
  x78 = ((^x70 & 0xffffffffffffffff) | (^(x70 ^ 0xffffffffffffffff) & x77)) >> 63
  x79 = x72 - 0xffffffff - x78
  x80 = ((^x72 & 0xffffffff) | (^(x72 ^ 0xffffffff) & x79)) >> 63
  x81 = x74 - x80
  x82 = ((^x74 & 0) | (^(x74 ^ 0) & x81)) >> 63
  x83 = x76 - 0xffffffff00000001 - x82
  x84 = ((^x76 & 0xffffffff00000001) | (^(x76 ^ 0xffffffff00000001) & x83)) >> 63
  x86_s = 0.as_u64 - 0 - x84
  x86 = ((^0.as_u64 & 0) | (^(0.as_u64 ^ 0) & x86_s)) >> 63
  x87 = ((0.as_u64 - x86) & x70) | (^(0.as_u64 - x86) & x77)
  x88 = ((0.as_u64 - x86) & x72) | (^(0.as_u64 - x86) & x79)
  x89 = ((0.as_u64 - x86) & x74) | (^(0.as_u64 - x86) & x81)
  x90 = ((0.as_u64 - x86) & x76) | (^(0.as_u64 - x86) & x83)
  P256Element.new(l0: x87, l1: x88, l2: x89, l3: x90)
}

# Translates a field element into the Montgomery domain.
def p256_to_montgomery(arg1: P256Element) -> P256Element {
  x1 = arg1.l1
  x2 = arg1.l2
  x3 = arg1.l3
  x4 = arg1.l0
  x5 = x4 * 0x4fffffffd
  x6 = x4.__mulhi(0x4fffffffd)
  x7 = x4 * 0xfffffffffffffffe
  x8 = x4.__mulhi(0xfffffffffffffffe)
  x9 = x4 * 0xfffffffbffffffff
  x10 = x4.__mulhi(0xfffffffbffffffff)
  x11 = x4 * 3
  x12 = x4.__mulhi(3)
  x13 = x12 + x9
  x14 = ((x12 & x9) | ((x12 | x9) &^ x13)) >> 63
  x15 = x10 + x7 + x14
  x16 = ((x10 & x7) | ((x10 | x7) &^ x15)) >> 63
  x17 = x8 + x5 + x16
  x18 = ((x8 & x5) | ((x8 | x5) &^ x17)) >> 63
  x19 = x11 * 0xffffffff00000001
  x20 = x11.__mulhi(0xffffffff00000001)
  x21 = x11 * 0xffffffff
  x22 = x11.__mulhi(0xffffffff)
  x23 = x11 * 0xffffffffffffffff
  x24 = x11.__mulhi(0xffffffffffffffff)
  x25 = x24 + x21
  x26 = ((x24 & x21) | ((x24 | x21) &^ x25)) >> 63
  x28_s = x11 + x23
  x28 = ((x11 & x23) | ((x11 | x23) &^ x28_s)) >> 63
  x29 = x13 + x25 + x28
  x30 = ((x13 & x25) | ((x13 | x25) &^ x29)) >> 63
  x31 = x15 + (x26 + x22) + x30
  x32 = ((x15 & (x26 + x22)) | ((x15 | (x26 + x22)) &^ x31)) >> 63
  x33 = x17 + x19 + x32
  x34 = ((x17 & x19) | ((x17 | x19) &^ x33)) >> 63
  x35 = (x18 + x6) + x20 + x34
  x36 = (((x18 + x6) & x20) | (((x18 + x6) | x20) &^ x35)) >> 63
  x37 = x1 * 0x4fffffffd
  x38 = x1.__mulhi(0x4fffffffd)
  x39 = x1 * 0xfffffffffffffffe
  x40 = x1.__mulhi(0xfffffffffffffffe)
  x41 = x1 * 0xfffffffbffffffff
  x42 = x1.__mulhi(0xfffffffbffffffff)
  x43 = x1 * 3
  x44 = x1.__mulhi(3)
  x45 = x44 + x41
  x46 = ((x44 & x41) | ((x44 | x41) &^ x45)) >> 63
  x47 = x42 + x39 + x46
  x48 = ((x42 & x39) | ((x42 | x39) &^ x47)) >> 63
  x49 = x40 + x37 + x48
  x50 = ((x40 & x37) | ((x40 | x37) &^ x49)) >> 63
  x51 = x29 + x43
  x52 = ((x29 & x43) | ((x29 | x43) &^ x51)) >> 63
  x53 = x31 + x45 + x52
  x54 = ((x31 & x45) | ((x31 | x45) &^ x53)) >> 63
  x55 = x33 + x47 + x54
  x56 = ((x33 & x47) | ((x33 | x47) &^ x55)) >> 63
  x57 = x35 + x49 + x56
  x58 = ((x35 & x49) | ((x35 | x49) &^ x57)) >> 63
  x59 = x51 * 0xffffffff00000001
  x60 = x51.__mulhi(0xffffffff00000001)
  x61 = x51 * 0xffffffff
  x62 = x51.__mulhi(0xffffffff)
  x63 = x51 * 0xffffffffffffffff
  x64 = x51.__mulhi(0xffffffffffffffff)
  x65 = x64 + x61
  x66 = ((x64 & x61) | ((x64 | x61) &^ x65)) >> 63
  x68_s = x51 + x63
  x68 = ((x51 & x63) | ((x51 | x63) &^ x68_s)) >> 63
  x69 = x53 + x65 + x68
  x70 = ((x53 & x65) | ((x53 | x65) &^ x69)) >> 63
  x71 = x55 + (x66 + x62) + x70
  x72 = ((x55 & (x66 + x62)) | ((x55 | (x66 + x62)) &^ x71)) >> 63
  x73 = x57 + x59 + x72
  x74 = ((x57 & x59) | ((x57 | x59) &^ x73)) >> 63
  x75 = ((x58 + x36) + (x50 + x38)) + x60 + x74
  x76 = ((((x58 + x36) + (x50 + x38)) & x60) | ((((x58 + x36) + (x50 + x38)) | x60) &^ x75)) >> 63
  x77 = x2 * 0x4fffffffd
  x78 = x2.__mulhi(0x4fffffffd)
  x79 = x2 * 0xfffffffffffffffe
  x80 = x2.__mulhi(0xfffffffffffffffe)
  x81 = x2 * 0xfffffffbffffffff
  x82 = x2.__mulhi(0xfffffffbffffffff)
  x83 = x2 * 3
  x84 = x2.__mulhi(3)
  x85 = x84 + x81
  x86 = ((x84 & x81) | ((x84 | x81) &^ x85)) >> 63
  x87 = x82 + x79 + x86
  x88 = ((x82 & x79) | ((x82 | x79) &^ x87)) >> 63
  x89 = x80 + x77 + x88
  x90 = ((x80 & x77) | ((x80 | x77) &^ x89)) >> 63
  x91 = x69 + x83
  x92 = ((x69 & x83) | ((x69 | x83) &^ x91)) >> 63
  x93 = x71 + x85 + x92
  x94 = ((x71 & x85) | ((x71 | x85) &^ x93)) >> 63
  x95 = x73 + x87 + x94
  x96 = ((x73 & x87) | ((x73 | x87) &^ x95)) >> 63
  x97 = x75 + x89 + x96
  x98 = ((x75 & x89) | ((x75 | x89) &^ x97)) >> 63
  x99 = x91 * 0xffffffff00000001
  x100 = x91.__mulhi(0xffffffff00000001)
  x101 = x91 * 0xffffffff
  x102 = x91.__mulhi(0xffffffff)
  x103 = x91 * 0xffffffffffffffff
  x104 = x91.__mulhi(0xffffffffffffffff)
  x105 = x104 + x101
  x106 = ((x104 & x101) | ((x104 | x101) &^ x105)) >> 63
  x108_s = x91 + x103
  x108 = ((x91 & x103) | ((x91 | x103) &^ x108_s)) >> 63
  x109 = x93 + x105 + x108
  x110 = ((x93 & x105) | ((x93 | x105) &^ x109)) >> 63
  x111 = x95 + (x106 + x102) + x110
  x112 = ((x95 & (x106 + x102)) | ((x95 | (x106 + x102)) &^ x111)) >> 63
  x113 = x97 + x99 + x112
  x114 = ((x97 & x99) | ((x97 | x99) &^ x113)) >> 63
  x115 = ((x98 + x76) + (x90 + x78)) + x100 + x114
  x116 = ((((x98 + x76) + (x90 + x78)) & x100) | ((((x98 + x76) + (x90 + x78)) | x100) &^ x115)) >> 63
  x117 = x3 * 0x4fffffffd
  x118 = x3.__mulhi(0x4fffffffd)
  x119 = x3 * 0xfffffffffffffffe
  x120 = x3.__mulhi(0xfffffffffffffffe)
  x121 = x3 * 0xfffffffbffffffff
  x122 = x3.__mulhi(0xfffffffbffffffff)
  x123 = x3 * 3
  x124 = x3.__mulhi(3)
  x125 = x124 + x121
  x126 = ((x124 & x121) | ((x124 | x121) &^ x125)) >> 63
  x127 = x122 + x119 + x126
  x128 = ((x122 & x119) | ((x122 | x119) &^ x127)) >> 63
  x129 = x120 + x117 + x128
  x130 = ((x120 & x117) | ((x120 | x117) &^ x129)) >> 63
  x131 = x109 + x123
  x132 = ((x109 & x123) | ((x109 | x123) &^ x131)) >> 63
  x133 = x111 + x125 + x132
  x134 = ((x111 & x125) | ((x111 | x125) &^ x133)) >> 63
  x135 = x113 + x127 + x134
  x136 = ((x113 & x127) | ((x113 | x127) &^ x135)) >> 63
  x137 = x115 + x129 + x136
  x138 = ((x115 & x129) | ((x115 | x129) &^ x137)) >> 63
  x139 = x131 * 0xffffffff00000001
  x140 = x131.__mulhi(0xffffffff00000001)
  x141 = x131 * 0xffffffff
  x142 = x131.__mulhi(0xffffffff)
  x143 = x131 * 0xffffffffffffffff
  x144 = x131.__mulhi(0xffffffffffffffff)
  x145 = x144 + x141
  x146 = ((x144 & x141) | ((x144 | x141) &^ x145)) >> 63
  x148_s = x131 + x143
  x148 = ((x131 & x143) | ((x131 | x143) &^ x148_s)) >> 63
  x149 = x133 + x145 + x148
  x150 = ((x133 & x145) | ((x133 | x145) &^ x149)) >> 63
  x151 = x135 + (x146 + x142) + x150
  x152 = ((x135 & (x146 + x142)) | ((x135 | (x146 + x142)) &^ x151)) >> 63
  x153 = x137 + x139 + x152
  x154 = ((x137 & x139) | ((x137 | x139) &^ x153)) >> 63
  x155 = ((x138 + x116) + (x130 + x118)) + x140 + x154
  x156 = ((((x138 + x116) + (x130 + x118)) & x140) | ((((x138 + x116) + (x130 + x118)) | x140) &^ x155)) >> 63
  x157 = x149 - 0xffffffffffffffff
  x158 = ((^x149 & 0xffffffffffffffff) | (^(x149 ^ 0xffffffffffffffff) & x157)) >> 63
  x159 = x151 - 0xffffffff - x158
  x160 = ((^x151 & 0xffffffff) | (^(x151 ^ 0xffffffff) & x159)) >> 63
  x161 = x153 - x160
  x162 = ((^x153 & 0) | (^(x153 ^ 0) & x161)) >> 63
  x163 = x155 - 0xffffffff00000001 - x162
  x164 = ((^x155 & 0xffffffff00000001) | (^(x155 ^ 0xffffffff00000001) & x163)) >> 63
  x166_s = x156 - x164
  x166 = ((^x156 & 0) | (^(x156 ^ 0) & x166_s)) >> 63
  x167 = ((0.as_u64 - x166) & x149) | (^(0.as_u64 - x166) & x157)
  x168 = ((0.as_u64 - x166) & x151) | (^(0.as_u64 - x166) & x159)
  x169 = ((0.as_u64 - x166) & x153) | (^(0.as_u64 - x166) & x161)
  x170 = ((0.as_u64 - x166) & x155) | (^(0.as_u64 - x166) & x163)
  P256Element.new(l0: x167, l1: x168, l2: x169, l3: x170)
}

# A multi-limb conditional select: arg2 if arg1 == 0, else arg3.
def p256_selectznz(arg1: U64, arg2: P256Element, arg3: P256Element) -> P256Element {
  x1 = ((0.as_u64 - arg1) & arg3.l0) | (^(0.as_u64 - arg1) & arg2.l0)
  x2 = ((0.as_u64 - arg1) & arg3.l1) | (^(0.as_u64 - arg1) & arg2.l1)
  x3 = ((0.as_u64 - arg1) & arg3.l2) | (^(0.as_u64 - arg1) & arg2.l2)
  x4 = ((0.as_u64 - arg1) & arg3.l3) | (^(0.as_u64 - arg1) & arg2.l3)
  P256Element.new(l0: x1, l1: x2, l2: x3, l3: x4)
}

# Serializes a field element NOT in the Montgomery domain to bytes in little-endian order into out1 (32 bytes).
def p256_to_bytes(out1: [Byte], arg1: P256Element) {
  x1 = arg1.l3
  x2 = arg1.l2
  x3 = arg1.l1
  x4 = arg1.l0
  x5 = x4.as_u8 & 0xff
  x6 = x4 >> 8
  x7 = x6.as_u8 & 0xff
  x8 = x6 >> 8
  x9 = x8.as_u8 & 0xff
  x10 = x8 >> 8
  x11 = x10.as_u8 & 0xff
  x12 = x10 >> 8
  x13 = x12.as_u8 & 0xff
  x14 = x12 >> 8
  x15 = x14.as_u8 & 0xff
  x16 = x14 >> 8
  x17 = x16.as_u8 & 0xff
  x18 = (x16 >> 8).as_u8
  x19 = x3.as_u8 & 0xff
  x20 = x3 >> 8
  x21 = x20.as_u8 & 0xff
  x22 = x20 >> 8
  x23 = x22.as_u8 & 0xff
  x24 = x22 >> 8
  x25 = x24.as_u8 & 0xff
  x26 = x24 >> 8
  x27 = x26.as_u8 & 0xff
  x28 = x26 >> 8
  x29 = x28.as_u8 & 0xff
  x30 = x28 >> 8
  x31 = x30.as_u8 & 0xff
  x32 = (x30 >> 8).as_u8
  x33 = x2.as_u8 & 0xff
  x34 = x2 >> 8
  x35 = x34.as_u8 & 0xff
  x36 = x34 >> 8
  x37 = x36.as_u8 & 0xff
  x38 = x36 >> 8
  x39 = x38.as_u8 & 0xff
  x40 = x38 >> 8
  x41 = x40.as_u8 & 0xff
  x42 = x40 >> 8
  x43 = x42.as_u8 & 0xff
  x44 = x42 >> 8
  x45 = x44.as_u8 & 0xff
  x46 = (x44 >> 8).as_u8
  x47 = x1.as_u8 & 0xff
  x48 = x1 >> 8
  x49 = x48.as_u8 & 0xff
  x50 = x48 >> 8
  x51 = x50.as_u8 & 0xff
  x52 = x50 >> 8
  x53 = x52.as_u8 & 0xff
  x54 = x52 >> 8
  x55 = x54.as_u8 & 0xff
  x56 = x54 >> 8
  x57 = x56.as_u8 & 0xff
  x58 = x56 >> 8
  x59 = x58.as_u8 & 0xff
  x60 = (x58 >> 8).as_u8
  out1[0] = x5
  out1[1] = x7
  out1[2] = x9
  out1[3] = x11
  out1[4] = x13
  out1[5] = x15
  out1[6] = x17
  out1[7] = x18
  out1[8] = x19
  out1[9] = x21
  out1[10] = x23
  out1[11] = x25
  out1[12] = x27
  out1[13] = x29
  out1[14] = x31
  out1[15] = x32
  out1[16] = x33
  out1[17] = x35
  out1[18] = x37
  out1[19] = x39
  out1[20] = x41
  out1[21] = x43
  out1[22] = x45
  out1[23] = x46
  out1[24] = x47
  out1[25] = x49
  out1[26] = x51
  out1[27] = x53
  out1[28] = x55
  out1[29] = x57
  out1[30] = x59
  out1[31] = x60
  nil
}

# Deserializes a field element NOT in the Montgomery domain from bytes in little-endian order (32 bytes).
def p256_from_bytes(arg1: [Byte]) -> P256Element {
  x1 = arg1[31].as_u64 << 56
  x2 = arg1[30].as_u64 << 48
  x3 = arg1[29].as_u64 << 40
  x4 = arg1[28].as_u64 << 32
  x5 = arg1[27].as_u64 << 24
  x6 = arg1[26].as_u64 << 16
  x7 = arg1[25].as_u64 << 8
  x8 = arg1[24]
  x9 = arg1[23].as_u64 << 56
  x10 = arg1[22].as_u64 << 48
  x11 = arg1[21].as_u64 << 40
  x12 = arg1[20].as_u64 << 32
  x13 = arg1[19].as_u64 << 24
  x14 = arg1[18].as_u64 << 16
  x15 = arg1[17].as_u64 << 8
  x16 = arg1[16]
  x17 = arg1[15].as_u64 << 56
  x18 = arg1[14].as_u64 << 48
  x19 = arg1[13].as_u64 << 40
  x20 = arg1[12].as_u64 << 32
  x21 = arg1[11].as_u64 << 24
  x22 = arg1[10].as_u64 << 16
  x23 = arg1[9].as_u64 << 8
  x24 = arg1[8]
  x25 = arg1[7].as_u64 << 56
  x26 = arg1[6].as_u64 << 48
  x27 = arg1[5].as_u64 << 40
  x28 = arg1[4].as_u64 << 32
  x29 = arg1[3].as_u64 << 24
  x30 = arg1[2].as_u64 << 16
  x31 = arg1[1].as_u64 << 8
  x32 = arg1[0]
  x33 = x31 + x32.as_u64
  x34 = x30 + x33
  x35 = x29 + x34
  x36 = x28 + x35
  x37 = x27 + x36
  x38 = x26 + x37
  x39 = x25 + x38
  x40 = x23 + x24.as_u64
  x41 = x22 + x40
  x42 = x21 + x41
  x43 = x20 + x42
  x44 = x19 + x43
  x45 = x18 + x44
  x46 = x17 + x45
  x47 = x15 + x16.as_u64
  x48 = x14 + x47
  x49 = x13 + x48
  x50 = x12 + x49
  x51 = x11 + x50
  x52 = x10 + x51
  x53 = x9 + x52
  x54 = x7 + x8.as_u64
  x55 = x6 + x54
  x56 = x5 + x55
  x57 = x4 + x56
  x58 = x3 + x57
  x59 = x2 + x58
  x60 = x1 + x59
  P256Element.new(l0: x39, l1: x46, l2: x53, l3: x60)
}
