  x21 = ((x7 & x13) | ((x7 | x13) &^ x20)) >> 63
  x22 = x9 + x13 + x21
  x23 = ((x9 & x13) | ((x9 | x13) &^ x22)) >> 63
  x24 = x11 + x13 + x23
  P384Element.new(l0: x14, l1: x16, l2: x18, l3: x20, l4: x22, l5: x24)
}

