  x378 = ((x341 & x365) | ((x341 | x365) &^ x378_s)) >> 63
  x379 = x343 + x367 + x378
  x380 = ((x343 & x367) | ((x343 | x367) &^ x379)) >> 63
  x381 = x345 + x369 + x380
  x382 = ((x345 & x369) | ((x345 | x369) &^ x381)) >> 63
  x383 = x347 + x371 + x382
  x384 = ((x347 & x371) | ((x347 | x371) &^ x383)) >> 63
  x385 = x349 + x373 + x384
  x386 = ((x349 & x373) | ((x349 | x373) &^ x385)) >> 63
  x387 = x351 + x375 + x386
  x388 = ((x351 & x375) | ((x351 | x375) &^ x387)) >> 63
  x389 = (x352 + x324) + (x376 + x356) + x388
  x390 = (((x352 + x324) & (x376 + x356)) | (((x352 + x324) | (x376 + x356)) &^ x389)) >> 63
  x391 = x379 - 0xffffffff
  x392 = ((^x379 & 0xffffffff) | (^(x379 ^ 0xffffffff) & x391)) >> 63
  x393 = x381 - 0xffffffff00000000 - x392
  x394 = ((^x381 & 0xffffffff00000000) | (^(x381 ^ 0xffffffff00000000) & x393)) >> 63
  x395 = x383 - 0xfffffffffffffffe - x394
  x396 = ((^x383 & 0xfffffffffffffffe) | (^(x383 ^ 0xfffffffffffffffe) & x395)) >> 63
  x397 = x385 - 0xffffffffffffffff - x396
  x398 = ((^x385 & 0xffffffffffffffff) | (^(x385 ^ 0xffffffffffffffff) & x397)) >> 63
  x399 = x387 - 0xffffffffffffffff - x398
  x400 = ((^x387 & 0xffffffffffffffff) | (^(x387 ^ 0xffffffffffffffff) & x399)) >> 63
  x401 = x389 - 0xffffffffffffffff - x400
  x402 = ((^x389 & 0xffffffffffffffff) | (^(x389 ^ 0xffffffffffffffff) & x401)) >> 63
  x404_s = x390 - x402
  x404 = ((^x390 & 0) | (^(x390 ^ 0) & x404_s)) >> 63
  x405 = ((0.as_u64 - x404) & x379) | (^(0.as_u64 - x404) & x391)
  x406 = ((0.as_u64 - x404) & x381) | (^(0.as_u64 - x404) & x393)
  x407 = ((0.as_u64 - x404) & x383) | (^(0.as_u64 - x404) & x395)
  x408 = ((0.as_u64 - x404) & x385) | (^(0.as_u64 - x404) & x397)
  x409 = ((0.as_u64 - x404) & x387) | (^(0.as_u64 - x404) & x399)
  x410 = ((0.as_u64 - x404) & x389) | (^(0.as_u64 - x404) & x401)
  P384Element.new(l0: x405, l1: x406, l2: x407, l3: x408, l4: x409, l5: x410)
}

# A multi-limb conditional select: arg2 if arg1 == 0, else arg3.
def p384_selectznz(arg1: U64, arg2: P384Element, arg3: P384Element) -> P384Element {
  x1 = ((0.as_u64 - arg1) & arg3.l0) | (^(0.as_u64 - arg1) & arg2.l0)
  x2 = ((0.as_u64 - arg1) & arg3.l1) | (^(0.as_u64 - arg1) & arg2.l1)
  x3 = ((0.as_u64 - arg1) & arg3.l2) | (^(0.as_u64 - arg1) & arg2.l2)
  x4 = ((0.as_u64 - arg1) & arg3.l3) | (^(0.as_u64 - arg1) & arg2.l3)
  x5 = ((0.as_u64 - arg1) & arg3.l4) | (^(0.as_u64 - arg1) & arg2.l4)
  x6 = ((0.as_u64 - arg1) & arg3.l5) | (^(0.as_u64 - arg1) & arg2.l5)
  P384Element.new(l0: x1, l1: x2, l2: x3, l3: x4, l4: x5, l5: x6)
}

