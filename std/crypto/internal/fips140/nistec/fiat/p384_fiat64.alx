  x6 = ((^arg1.l2 & arg2.l2) | (^(arg1.l2 ^ arg2.l2) & x5)) >> 63
  x7 = arg1.l3 - arg2.l3 - x6
  x8 = ((^arg1.l3 & arg2.l3) | (^(arg1.l3 ^ arg2.l3) & x7)) >> 63
  x9 = arg1.l4 - arg2.l4 - x8
  x10 = ((^arg1.l4 & arg2.l4) | (^(arg1.l4 ^ arg2.l4) & x9)) >> 63
  x11 = arg1.l5 - arg2.l5 - x10
  x12 = ((^arg1.l5 & arg2.l5) | (^(arg1.l5 ^ arg2.l5) & x11)) >> 63
  x13 = ((0.as_u64 - x12) & 0xffffffffffffffff) | (^(0.as_u64 - x12) & 0)
