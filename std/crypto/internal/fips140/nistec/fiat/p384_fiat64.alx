  x75 = x74.as_u8 & 0xff
  x76 = (x74 >> 8).as_u8
  x77 = x1.as_u8 & 0xff
  x78 = x1 >> 8
  x79 = x78.as_u8 & 0xff
  x80 = x78 >> 8
  x81 = x80.as_u8 & 0xff
  x82 = x80 >> 8
  x83 = x82.as_u8 & 0xff
