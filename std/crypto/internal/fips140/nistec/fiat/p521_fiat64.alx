  x545 = ((^x527 & 0xffffffffffffffff) | (^(x527 ^ 0xffffffffffffffff) & x544)) >> 63
  x546 = x529 - 0xffffffffffffffff - x545
  x547 = ((^x529 & 0xffffffffffffffff) | (^(x529 ^ 0xffffffffffffffff) & x546)) >> 63
  x548 = x531 - 0xffffffffffffffff - x547
  x549 = ((^x531 & 0xffffffffffffffff) | (^(x531 ^ 0xffffffffffffffff) & x548)) >> 63
  x550 = x533 - 0xffffffffffffffff - x549
  x551 = ((^x533 & 0xffffffffffffffff) | (^(x533 ^ 0xffffffffffffffff) & x550)) >> 63
  x552 = x535 - 0x1ff - x551
  x553 = ((^x535 & 0x1ff) | (^(x535 ^ 0x1ff) & x552)) >> 63
  x555_s = 0.as_u64 - 0 - x553
  x555 = ((^0.as_u64 & 0) | (^(0.as_u64 ^ 0) & x555_s)) >> 63
  x556 = ((0.as_u64 - x555) & x519) | (^(0.as_u64 - x555) & x536)
  x557 = ((0.as_u64 - x555) & x521) | (^(0.as_u64 - x555) & x538)
  x558 = ((0.as_u64 - x555) & x523) | (^(0.as_u64 - x555) & x540)
  x559 = ((0.as_u64 - x555) & x525) | (^(0.as_u64 - x555) & x542)
  x560 = ((0.as_u64 - x555) & x527) | (^(0.as_u64 - x555) & x544)
  x561 = ((0.as_u64 - x555) & x529) | (^(0.as_u64 - x555) & x546)
  x562 = ((0.as_u64 - x555) & x531) | (^(0.as_u64 - x555) & x548)
  x563 = ((0.as_u64 - x555) & x533) | (^(0.as_u64 - x555) & x550)
  x564 = ((0.as_u64 - x555) & x535) | (^(0.as_u64 - x555) & x552)
  P521Element.new(l0: x556, l1: x557, l2: x558, l3: x559, l4: x560, l5: x561, l6: x562, l7: x563, l8: x564)
}

# A multi-limb conditional select: arg2 if arg1 == 0, else arg3.
def p521_selectznz(arg1: U64, arg2: P521Element, arg3: P521Element) -> P521Element {
  x1 = ((0.as_u64 - arg1) & arg3.l0) | (^(0.as_u64 - arg1) & arg2.l0)
  x2 = ((0.as_u64 - arg1) & arg3.l1) | (^(0.as_u64 - arg1) & arg2.l1)
  x3 = ((0.as_u64 - arg1) & arg3.l2) | (^(0.as_u64 - arg1) & arg2.l2)
  x4 = ((0.as_u64 - arg1) & arg3.l3) | (^(0.as_u64 - arg1) & arg2.l3)
  x5 = ((0.as_u64 - arg1) & arg3.l4) | (^(0.as_u64 - arg1) & arg2.l4)
  x6 = ((0.as_u64 - arg1) & arg3.l5) | (^(0.as_u64 - arg1) & arg2.l5)
  x7 = ((0.as_u64 - arg1) & arg3.l6) | (^(0.as_u64 - arg1) & arg2.l6)
  x8 = ((0.as_u64 - arg1) & arg3.l7) | (^(0.as_u64 - arg1) & arg2.l7)
  x9 = ((0.as_u64 - arg1) & arg3.l8) | (^(0.as_u64 - arg1) & arg2.l8)
  P521Element.new(l0: x1, l1: x2, l2: x3, l3: x4, l4: x5, l5: x6, l6: x7, l7: x8, l8: x9)
}

