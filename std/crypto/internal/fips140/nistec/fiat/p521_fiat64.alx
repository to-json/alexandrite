  x15 = arg1.l7 + arg2.l7 + x14
  x16 = ((arg1.l7 & arg2.l7) | ((arg1.l7 | arg2.l7) &^ x15)) >> 63
  x17 = arg1.l8 + arg2.l8 + x16
  x18 = ((arg1.l8 & arg2.l8) | ((arg1.l8 | arg2.l8) &^ x17)) >> 63
  x19 = x1 - 0xffffffffffffffff
  x20 = ((^x1 & 0xffffffffffffffff) | (^(x1 ^ 0xffffffffffffffff) & x19)) >> 63
  x21 = x3 - 0xffffffffffffffff - x20
  x22 = ((^x3 & 0xffffffffffffffff) | (^(x3 ^ 0xffffffffffffffff) & x21)) >> 63
  x23 = x5 - 0xffffffffffffffff - x22
  x24 = ((^x5 & 0xffffffffffffffff) | (^(x5 ^ 0xffffffffffffffff) & x23)) >> 63
  x25 = x7 - 0xffffffffffffffff - x24
