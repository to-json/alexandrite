  a = h521("01fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffd")
  b = h521("01f0f96d1eb76c3b410a3372631a7e592d090743941b9c1740b20500c8bd1ed688124900affdd50949468a2950a155b129e2f93f5e62f1bf3ca0c1d903d5b3c657c4")
  assert_eq x521(a.add(b)), "01f0f96d1eb76c3b410a3372631a7e592d090743941b9c1740b20500c8bd1ed688124900affdd50949468a2950a155b129e2f93f5e62f1bf3ca0c1d903d5b3c657c2"
