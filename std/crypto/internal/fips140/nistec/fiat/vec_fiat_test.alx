  assert_eq x521(a.add(b)), "013483a912fb838f3d79a6599da19ca212f8edd745d1d6847ce8425ed5a3c75666eb1c6d644b0a4f327de9a7323a922d5f4ce56558cbd299316741011b5bfa674a27"
  assert_eq x521(a.sub(b)), "00cb7c56ed047c70c28659a6625e635ded071228ba2e297b8317bda12a5c38a99914e3929bb4f5b0cd821658cdc56dd2a0b31a9aa7342d66ce98befee4a40598b5d8"
