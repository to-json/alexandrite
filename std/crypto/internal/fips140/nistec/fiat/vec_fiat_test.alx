test "P224 arithmetic 4" {
  a = h224("0d4d8f289201eab6e0971d33b080fcaa5b79fd16c516362c9ec41e4e")
  b = h224("725f1e7a718b692a23e9918888e8ea1190f86f965f7a3a1445572c68")
  assert_eq x224(a.add(b)), "7facada3038d53e10480aebc3969e6bbec726cad24907040e41b4ab6"
  assert_eq x224(a.sub(b)), "9aee70ae2076818cbcad8bab27981297ca818d80659bfc18596cf1e7"
  assert_eq x224(a.mul(b)), "26aed067bd8387f7b931828e1e25a86e9f035ac5e4a21fcef26700d4"
  a = h224("0d4d8f289201eab6e0971d33b080fcaa5b79fd16c516362c9ec41e4e")
  b = h224("00000000000000000000000000000000000000000000000000000002")
  assert_eq x224(a.add(b)), "0d4d8f289201eab6e0971d33b080fcaa5b79fd16c516362c9ec41e50"
  assert_eq x224(a.sub(b)), "0d4d8f289201eab6e0971d33b080fcaa5b79fd16c516362c9ec41e4c"
  assert_eq x224(a.mul(b)), "1a9b1e512403d56dc12e3a676101f954b6f3fa2d8a2c6c593d883c9c"
  a = h224("0d4d8f289201eab6e0971d33b080fcaa5b79fd16c516362c9ec41e4e")
  b = h224("f5d255d08192ba7a551c210c4c1987b155a0ebaadfb2d96aad91b340")
  assert_eq x224(a.add(b)), "031fe4f91394a53135b33e3ffc9a845cb11ae8c1a4c90f974c55d18d"
  assert_eq x224(a.sub(b)), "177b3958106f303c8b7afc27646774f805d9116be5635cc1f1326b0f"
  assert_eq x224(a.mul(b)), "52ee7fd46972e68e7e218b30f345c26b6f957b7838f6140bcf82c162"
  a = h224("0d4d8f289201eab6e0971d33b080fcaa5b79fd16c516362c9ec41e4e")
