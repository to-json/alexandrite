  assert_eq x384(a.sub(b)), "8c18b850e7f1c76ac8d7d7d02f0dac0e1068a0e59f9ab7a04ce7ef70d75abe4f427e8b2bb9a4cc676512dab7b9b7ea63"
  assert_eq x384(a.mul(b)), "e030805f3bc7ca3887dd70f3c7fad5f4bc610af033d91bba591e7195f8abec0d3e1b86d8d17d669cc14022bcab261797"
  a = h384("cb7ab8c2a1444b1edd0eac761f4bd3976ffce6dbd890c362f8f76271dc9803fe11259babac63d4595a1c4a8d995d1e93")
