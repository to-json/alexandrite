  a = h256("6fb339e5363b71ff121d8b75a9db4b7e8fe820df5f4761c8d2504dc9f30b95e4")
  assert_eq x256(a.square), "2540f707fc02f9d91e7812bc162c6eae78fd14f8e33ffad22b9010db7726294c"
  assert_eq x256(a.invert), "73bba3c6c17d6057fa0744cb871c8751089f6db72a130a75b47c9117c5aaf503"
}

