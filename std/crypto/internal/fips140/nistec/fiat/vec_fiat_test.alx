  assert_eq x384(a.add(b)), "2774d4e2300066fd2d947c623488dc2c29810d28073d0db17815b34132b0c4dbe9a2710612fdac2df9ed518d182fdec2"
  assert_eq x384(a.sub(b)), "6f809ca312882f408c88dc8a0a0ecb02b678c08fa9e4791479d911a2867f432138a8c65245c9fc84ba4b438d1a8a5e65"
  assert_eq x384(a.mul(b)), "8291c3da8958d8bd3860e73e3af216cf5c7378628706d2a99f28f8bee7962a0f078c9ceaad3a01111cd4fa600a6e66a7"
  a = h384("cb7ab8c2a1444b1edd0eac761f4bd3976ffce6dbd890c362f8f76271dc9803fe11259babac63d4595a1c4a8d995d1e93")
