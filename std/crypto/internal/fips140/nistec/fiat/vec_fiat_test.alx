  assert_eq x384(a.mul(b)), "3485473d5ebbb4e122f15389e0b42c6890031924276f3c9d07089d8e2367fc00eeda6453539c2ba6a5e3b57366a2e16c"
  a = h384("cb7ab8c2a1444b1edd0eac761f4bd3976ffce6dbd890c362f8f76271dc9803fe11259babac63d4595a1c4a8d995d1e93")
