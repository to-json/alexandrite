# Generated from Go's math/big (field arithmetic modulo the NIST primes, the
# results Go's crypto/internal/fips140/nistec/fiat computes); do not edit by hand.
import "encoding/hex"

def h224(s: Str) -> P224Element { P224Element.from_bytes(hex.decode_string(s).unwrap).unwrap }

def x224(e: P224Element) -> Str { hex.encode_to_string(e.bytes) }

test "P224 arithmetic 0" {
  a = h224("00000000000000000000000000000000000000000000000000000000")
  b = h224("00000000000000000000000000000000000000000000000000000001")
  assert_eq x224(a.add(b)), "00000000000000000000000000000000000000000000000000000001"
  assert_eq x224(a.sub(b)), "ffffffffffffffffffffffffffffffff000000000000000000000000"
  assert_eq x224(a.mul(b)), "00000000000000000000000000000000000000000000000000000000"
  a = h224("00000000000000000000000000000000000000000000000000000000")
  b = h224("a76b2bca6552fff482c19fb09e37166edd2f98dac1ec3926e9beaca5")
  assert_eq x224(a.add(b)), "a76b2bca6552fff482c19fb09e37166edd2f98dac1ec3926e9beaca5"
  assert_eq x224(a.sub(b)), "5894d4359aad000b7d3e604f61c8e99022d067253e13c6d91641535c"
  assert_eq x224(a.mul(b)), "00000000000000000000000000000000000000000000000000000000"
  a = h224("00000000000000000000000000000000000000000000000000000000")
  b = h224("567e0f616e47ca492f89b971a434525416f29eeb255eb748c046c37a")
  assert_eq x224(a.add(b)), "567e0f616e47ca492f89b971a434525416f29eeb255eb748c046c37a"
  assert_eq x224(a.sub(b)), "a981f09e91b835b6d076468e5bcbadaae90d6114daa148b73fb93c87"
  assert_eq x224(a.mul(b)), "00000000000000000000000000000000000000000000000000000000"
  a = h224("00000000000000000000000000000000000000000000000000000000")
  b = h224("d31102b9aa5029a4c2df9518df5199d2b91fc5bd1e619810c9b3d484")
  assert_eq x224(a.add(b)), "d31102b9aa5029a4c2df9518df5199d2b91fc5bd1e619810c9b3d484"
  assert_eq x224(a.sub(b)), "2ceefd4655afd65b3d206ae720ae662c46e03a42e19e67ef364c2b7d"
  assert_eq x224(a.mul(b)), "00000000000000000000000000000000000000000000000000000000"
  a = h224("00000000000000000000000000000000000000000000000000000000")
  b = h224("00000000000000000000000000000000000000000000000000000000")
  assert_eq x224(a.add(b)), "00000000000000000000000000000000000000000000000000000000"
  assert_eq x224(a.sub(b)), "00000000000000000000000000000000000000000000000000000000"
  assert_eq x224(a.mul(b)), "00000000000000000000000000000000000000000000000000000000"
  a = h224("00000000000000000000000000000000000000000000000000000000")
  assert_eq x224(a.square), "00000000000000000000000000000000000000000000000000000000"
  assert_eq x224(a.invert), "00000000000000000000000000000000000000000000000000000000"
  a = h224("00000000000000000000000000000000000000000000000000000001")
  b = h224("00000000000000000000000000000000000000000000000000000002")
  assert_eq x224(a.add(b)), "00000000000000000000000000000000000000000000000000000003"
  assert_eq x224(a.sub(b)), "ffffffffffffffffffffffffffffffff000000000000000000000000"
  assert_eq x224(a.mul(b)), "00000000000000000000000000000000000000000000000000000002"
  a = h224("00000000000000000000000000000000000000000000000000000001")
  b = h224("f5d255d08192ba7a551c210c4c1987b155a0ebaadfb2d96aad91b340")
  assert_eq x224(a.add(b)), "f5d255d08192ba7a551c210c4c1987b155a0ebaadfb2d96aad91b341"
  assert_eq x224(a.sub(b)), "0a2daa2f7e6d4585aae3def3b3e6784daa5f1455204d2695526e4cc2"
  assert_eq x224(a.mul(b)), "f5d255d08192ba7a551c210c4c1987b155a0ebaadfb2d96aad91b340"
  a = h224("00000000000000000000000000000000000000000000000000000001")
  b = h224("1bfcf68120c656b5b5de2187d616aacef7a879ba12e913d47914ff74")
  assert_eq x224(a.add(b)), "1bfcf68120c656b5b5de2187d616aacef7a879ba12e913d47914ff75"
  assert_eq x224(a.sub(b)), "e403097edf39a94a4a21de7829e9553008578645ed16ec2b86eb008e"
  assert_eq x224(a.mul(b)), "1bfcf68120c656b5b5de2187d616aacef7a879ba12e913d47914ff74"
  a = h224("00000000000000000000000000000000000000000000000000000001")
  b = h224("0d4d8f289201eab6e0971d33b080fcaa5b79fd16c516362c9ec41e4e")
  assert_eq x224(a.add(b)), "0d4d8f289201eab6e0971d33b080fcaa5b79fd16c516362c9ec41e4f"
  assert_eq x224(a.sub(b)), "f2b270d76dfe15491f68e2cc4f7f0354a48602e93ae9c9d3613be1b4"
  assert_eq x224(a.mul(b)), "0d4d8f289201eab6e0971d33b080fcaa5b79fd16c516362c9ec41e4e"
  a = h224("00000000000000000000000000000000000000000000000000000001")
  b = h224("00000000000000000000000000000000000000000000000000000001")
  assert_eq x224(a.add(b)), "00000000000000000000000000000000000000000000000000000002"
  assert_eq x224(a.sub(b)), "00000000000000000000000000000000000000000000000000000000"
