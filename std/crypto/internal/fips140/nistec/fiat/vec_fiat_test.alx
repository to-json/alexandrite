  b = h256("c169b5d3601ee29684dcc480564ccc4a61d8f557b7489454fc293f29f884ec1c")
  assert_eq x256(a.add(b)), "c169b5d3601ee29684dcc480564ccc4a61d8f557b7489454fc293f29f884ec1a"
  assert_eq x256(a.sub(b)), "3e964a2b9fe11d6a7b233b7fa9b333b59e270aa948b76bab03d6c0d6077b13e1"
  assert_eq x256(a.mul(b)), "7d2c94573fc23ad4f64676ff5366676b3c4e1552916ed75607ad81ac0ef627c6"
