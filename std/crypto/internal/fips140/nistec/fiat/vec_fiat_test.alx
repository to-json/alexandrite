  b = h224("00000000000000000000000000000000000000000000000000000002")
  assert_eq x224(a.add(b)), "1bfcf68120c656b5b5de2187d616aacef7a879ba12e913d47914ff76"
  assert_eq x224(a.sub(b)), "1bfcf68120c656b5b5de2187d616aacef7a879ba12e913d47914ff72"
  assert_eq x224(a.mul(b)), "37f9ed02418cad6b6bbc430fac2d559def50f37425d227a8f229fee8"
