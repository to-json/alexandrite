test "P224 arithmetic 1" {
  a = h224("a6fee1ce1d7ae8d70c39da58b63beea6a09fbeadf99e48c61a039fb7")
  b = h224("f24faefd6b44f339d12d3d2d1991bb5176e173ec19d4c8901498d22b")
  assert_eq x224(a.add(b)), "994e90cb88bfdc10dd671785cfcda9f91781329a137311562e9c71e1"
  assert_eq x224(a.sub(b)), "b4af32d0b235f59d3b0c9d2b9caa335429be4ac1dfc98036056acd8d"
  assert_eq x224(a.mul(b)), "0b774feb300e8e4654cfa7e50a54ab833430a9af248a4cb5f24b687d"
  a = h224("a6fee1ce1d7ae8d70c39da58b63beea6a09fbeadf99e48c61a039fb7")
  b = h224("ddcef8cfaf1630341b1cf7b4ca2574444fb9f8e4ff05c53e02fc3ac7")
  assert_eq x224(a.add(b)), "84cdda9dcc91190b2756d20d806162ebf059b792f8a40e041cffda7d"
  assert_eq x224(a.sub(b)), "c92fe8fe6e64b8a2f11ce2a3ec167a6150e5c5c8fa988388170764f1"
  assert_eq x224(a.mul(b)), "ec8f1b451ec657936614685abba7d5d64bf3ddd0050019d820428813"
  a = h224("a6fee1ce1d7ae8d70c39da58b63beea6a09fbeadf99e48c61a039fb7")
  b = h224("cc6db87695f617dfa7f92fa327b30d7dff5ac563fca4f530e73b8b6c")
  assert_eq x224(a.add(b)), "736c9a44b37100b6b43309fbddeefc259ffa8411f6433df7013f2b22"
  assert_eq x224(a.sub(b)), "da9129578784d0f76440aab58e88e127a144f949fcf9539532c8144c"
  assert_eq x224(a.mul(b)), "b6ced11d6efe75827d3a4d2c0d7ba0d7d2b67c8d9b479a9ce1ab9b77"
  a = h224("a6fee1ce1d7ae8d70c39da58b63beea6a09fbeadf99e48c61a039fb7")
  b = h224("19e3e93390ac242f9bdb6a2ececcd2fdf51fd6dbbebc4a072195e72a")
  assert_eq x224(a.add(b)), "c0e2cb01ae270d06a81544878508c1a495bf9589b85a92cd3b9986e1"
  assert_eq x224(a.sub(b)), "8d1af89a8ccec4a7705e7029e76f1ba8ab7fe7d23ae1febef86db88d"
  assert_eq x224(a.mul(b)), "4911db5361e564aae4d767da06159542cdda6800efa566d81c505e6f"
  a = h224("a6fee1ce1d7ae8d70c39da58b63beea6a09fbeadf99e48c61a039fb7")
  b = h224("a6fee1ce1d7ae8d70c39da58b63beea6a09fbeadf99e48c61a039fb7")
  assert_eq x224(a.add(b)), "4dfdc39c3af5d1ae1873b4b16c77dd4e413f7d5bf33c918c34073f6d"
  assert_eq x224(a.sub(b)), "00000000000000000000000000000000000000000000000000000000"
  assert_eq x224(a.mul(b)), "2d30d45047d12081b8da2a6968b1d301a1e9fafcbd17700c52670821"
  a = h224("a6fee1ce1d7ae8d70c39da58b63beea6a09fbeadf99e48c61a039fb7")
  assert_eq x224(a.square), "2d30d45047d12081b8da2a6968b1d301a1e9fafcbd17700c52670821"
  assert_eq x224(a.invert), "ede0f40c507454e2bbdd97692b93892958f4bcf63fd94842f2945dde"
  a = h224("f24faefd6b44f339d12d3d2d1991bb5176e173ec19d4c8901498d22b")
