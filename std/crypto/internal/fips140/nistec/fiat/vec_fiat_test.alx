  assert_eq x256(a.sub(b)), "d9f15dfe518ceabcd098b53cd9728274630b1747516d66bc0b3b6070b3a8fa5a"
  assert_eq x256(a.mul(b)), "ba116b3e99692c0ee6148e95511d3d716f61222f42de5e9002dca7ba01f6d6a2"
