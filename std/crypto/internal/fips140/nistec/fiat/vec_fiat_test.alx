  assert_eq x256(a.sub(b)), "0b51d1527ad5daa4b17452754545376ac44c3069f212f812e515be61a860dd23"
  assert_eq x256(a.mul(b)), "16a3a2a4f5abb54962e8a4ea8a8a6ed5889860d3e425f025ca2b7cc350c1ba4a"
