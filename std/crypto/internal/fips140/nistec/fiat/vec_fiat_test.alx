  b = h224("f5d255d08192ba7a551c210c4c1987b155a0ebaadfb2d96aad91b340")
  assert_eq x224(a.add(b)), "11cf4c51a25911300afa4294223032814d496564f29bed3f26a6b2b3"
  assert_eq x224(a.sub(b)), "262aa0b09f339c3b60c2007b89fd231ca2078e0f33363a69cb834c35"
  assert_eq x224(a.mul(b)), "64c6e9055dd3a5ac4488a0ada1515484042c2af8d0fede078a95f692"
  a = h224("1bfcf68120c656b5b5de2187d616aacef7a879ba12e913d47914ff74")
  b = h224("1bfcf68120c656b5b5de2187d616aacef7a879ba12e913d47914ff74")
  assert_eq x224(a.add(b)), "37f9ed02418cad6b6bbc430fac2d559def50f37425d227a8f229fee8"
  assert_eq x224(a.sub(b)), "00000000000000000000000000000000000000000000000000000000"
  assert_eq x224(a.mul(b)), "223779633049ff5f8b8098bf81f6050ce235b74f44f83b4af89d9abe"
  a = h224("1bfcf68120c656b5b5de2187d616aacef7a879ba12e913d47914ff74")
  assert_eq x224(a.square), "223779633049ff5f8b8098bf81f6050ce235b74f44f83b4af89d9abe"
  assert_eq x224(a.invert), "c8d73f33a80d1e969c35f6d5d7ffafd8ca5d8a0fe77b7d202e53fc39"
}

