  assert_eq x224(a.add(b)), "301349b670acdbf72ac2d9575ab39a96ba276814472c98afa999a778"
  assert_eq x224(a.sub(b)), "cfecb6498f532408d53d26a8a54c656845d897ebb8d367505666588d"
  assert_eq x224(a.mul(b)), "6026936ce159b7ee5585b2aeb567352d744ed0288e59315f53334eec"
  a = h224("00000000000000000000000000000000000000000000000000000002")
  b = h224("78893af9b3b8c550bfdf514a13ed908531fe06f80daafa1a474eaf27")
  assert_eq x224(a.add(b)), "78893af9b3b8c550bfdf514a13ed908531fe06f80daafa1a474eaf29"
  assert_eq x224(a.sub(b)), "8776c5064c473aaf4020aeb5ec126f79ce01f907f25505e5b8b150dc"
  assert_eq x224(a.mul(b)), "f11275f367718aa17fbea29427db210a63fc0df01b55f4348e9d5e4e"
  a = h224("00000000000000000000000000000000000000000000000000000002")
  b = h224("725f1e7a718b692a23e9918888e8ea1190f86f965f7a3a1445572c68")
  assert_eq x224(a.add(b)), "725f1e7a718b692a23e9918888e8ea1190f86f965f7a3a1445572c6a"
  assert_eq x224(a.sub(b)), "8da0e1858e7496d5dc166e77771715ed6f079069a085c5ebbaa8d39b"
  assert_eq x224(a.mul(b)), "e4be3cf4e316d25447d3231111d1d42321f0df2cbef474288aae58d0"
  a = h224("00000000000000000000000000000000000000000000000000000002")
  b = h224("00000000000000000000000000000000000000000000000000000002")
  assert_eq x224(a.add(b)), "00000000000000000000000000000000000000000000000000000004"
  assert_eq x224(a.sub(b)), "00000000000000000000000000000000000000000000000000000000"
  assert_eq x224(a.mul(b)), "00000000000000000000000000000000000000000000000000000004"
  a = h224("00000000000000000000000000000000000000000000000000000002")
  assert_eq x224(a.square), "00000000000000000000000000000000000000000000000000000004"
  assert_eq x224(a.invert), "7fffffffffffffffffffffffffffffff800000000000000000000001"
  a = h224("ffffffffffffffffffffffffffffffff000000000000000000000000")
  b = h224("fffffffffffffffffffffffffffffffeffffffffffffffffffffffff")
  assert_eq x224(a.add(b)), "fffffffffffffffffffffffffffffffefffffffffffffffffffffffe"
  assert_eq x224(a.sub(b)), "00000000000000000000000000000000000000000000000000000001"
  assert_eq x224(a.mul(b)), "00000000000000000000000000000000000000000000000000000002"
  a = h224("ffffffffffffffffffffffffffffffff000000000000000000000000")
  b = h224("d7b460f8155e7e1be8eb266495e3076113b0b5ab5bd99559a8634b1a")
  assert_eq x224(a.add(b)), "d7b460f8155e7e1be8eb266495e3076113b0b5ab5bd99559a8634b19"
  assert_eq x224(a.sub(b)), "284b9f07eaa181e41714d99b6a1cf89dec4f4a54a4266aa6579cb4e6"
