  a = h224("ffffffffffffffffffffffffffffffff000000000000000000000000")
  b = h224("8825f010db3015c6593eaebf1d27e3afe51f79d3926f575c582034f7")
  assert_eq x224(a.add(b)), "8825f010db3015c6593eaebf1d27e3afe51f79d3926f575c582034f6"
  assert_eq x224(a.sub(b)), "77da0fef24cfea39a6c15140e2d81c4f1ae0862c6d90a8a3a7dfcb09"
  assert_eq x224(a.mul(b)), "77da0fef24cfea39a6c15140e2d81c4f1ae0862c6d90a8a3a7dfcb0a"
  a = h224("ffffffffffffffffffffffffffffffff000000000000000000000000")
  b = h224("a47216015f64ff59dbcb363955ea38b73c6e87f7c87362aa46b244e7")
  assert_eq x224(a.add(b)), "a47216015f64ff59dbcb363955ea38b73c6e87f7c87362aa46b244e6"
  assert_eq x224(a.sub(b)), "5b8de9fea09b00a62434c9c6aa15c747c3917808378c9d55b94dbb19"
  assert_eq x224(a.mul(b)), "5b8de9fea09b00a62434c9c6aa15c747c3917808378c9d55b94dbb1a"
  a = h224("ffffffffffffffffffffffffffffffff000000000000000000000000")
  b = h224("ffffffffffffffffffffffffffffffff000000000000000000000000")
  assert_eq x224(a.add(b)), "fffffffffffffffffffffffffffffffeffffffffffffffffffffffff"
  assert_eq x224(a.sub(b)), "00000000000000000000000000000000000000000000000000000000"
  assert_eq x224(a.mul(b)), "00000000000000000000000000000000000000000000000000000001"
  a = h224("ffffffffffffffffffffffffffffffff000000000000000000000000")
  assert_eq x224(a.square), "00000000000000000000000000000000000000000000000000000001"
  assert_eq x224(a.invert), "ffffffffffffffffffffffffffffffff000000000000000000000000"
  a = h224("fffffffffffffffffffffffffffffffeffffffffffffffffffffffff")
