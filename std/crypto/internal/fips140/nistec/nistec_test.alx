# Go's crypto/internal/fips140test/nistec_test.go (TestEquivalents,
# TestScalarMult's checkScalar; its scalars are in vec_scalar_test.alx: the
# named ones, and every 3rd bit position, 0..20 and N-64..N+64 sampled, where
# Go runs them all outside -short mode),
# nistec_ordinv_test.go and nistec/p256_table_test.go, plus encoding tests.
# TestNISTECAllocations is not translated: alx has no allocation counter
# (and values here are not heap-allocated in the first place).
import "encoding/hex"

def hx(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

# Go's checkScalar for P224, plus Go's result for [k]G.
def check_scalar_p224(sh: Str, nkh: Str, expect_infinity: Bool, want: Str) {
  scalar = hx(sh)
  g = P224Point.generator
  p1 = P224Point.scalar_base_mult(scalar).unwrap
  p2 = g.scalar_mult(scalar).unwrap
  assert_eq hex.encode_to_string(p1.bytes), want
  assert p1.bytes == p2.bytes, "[k]G != ScalarBaseMult(k)"
  inf = new_p224_point().bytes
  if expect_infinity {
    assert p1.bytes == inf, "ScalarBaseMult(k) != ∞"
    assert p2.bytes == inf, "[k]G != ∞"
  } else {
    assert p1.bytes != inf, "ScalarBaseMult(k) == ∞"
    assert p2.bytes != inf, "[k]G == ∞"
  }
  g1 = P224Point.scalar_base_mult(hx(nkh)).unwrap.add(p1)
  assert g1.bytes == inf, "[N - k]G + [k]G != ∞"
  nil
}

test "P224 equivalents" {
  p = P224Point.generator
  two = [0.as_u8; 28]
  two[28 - 1] = 2
  # N + 2
  n_plus_two = hx("ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3f")
  p1 = p.double
  p2 = p.add(p)
  p3 = p.scalar_mult(two).unwrap
  p4 = P224Point.scalar_base_mult(two).unwrap
  p5 = p.scalar_mult(n_plus_two).unwrap
  p6 = P224Point.scalar_base_mult(n_plus_two).unwrap
  assert p1.bytes == p2.bytes, "P+P != 2*P"
  assert p1.bytes == p3.bytes, "P+P != [2]P"
  assert p1.bytes == p4.bytes, "G+G != [2]G"
  assert p1.bytes == p5.bytes, "P+P != [N+2]P"
  assert p1.bytes == p6.bytes, "G+G != [N+2]G"
}

test "P224 encodings" {
  g = P224Point.generator
  inf = new_p224_point()
  assert_eq inf.bytes, [0.as_u8]
  assert_eq inf.bytes_compressed, [0.as_u8]
  assert_eq inf.bytes_x.err.unwrap.message, "P224 point is the point at infinity"
  assert_eq P224Point.from_bytes([0.as_u8]).unwrap.bytes, [0.as_u8]
  assert_eq P224Point.from_bytes(g.bytes).unwrap.bytes, g.bytes
  assert_eq P224Point.from_bytes(g.bytes_compressed).unwrap.bytes, g.bytes
  neg = P224Point.from_bytes(g.bytes).unwrap.scalar_mult(hx("ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3c")).unwrap
  assert_eq P224Point.from_bytes(neg.bytes_compressed).unwrap.bytes, neg.bytes
  assert neg.bytes_compressed[0] != g.bytes_compressed[0]
  assert_eq neg.add(g).bytes, [0.as_u8]
  # Errors.
  assert_eq P224Point.from_bytes([]).err.unwrap.message, "invalid P224 point encoding"
  assert_eq P224Point.from_bytes([4.as_u8]).err.unwrap.message, "invalid P224 point encoding"
  b = g.bytes
  b[0] = 5
  assert_eq P224Point.from_bytes(b).err.unwrap.message, "invalid P224 point encoding"
  b = g.bytes
  b[b.size - 1] = b[b.size - 1] ^ 1
  assert_eq P224Point.from_bytes(b).err.unwrap.message, "P224 point not on curve"
  b = g.bytes
  assert_eq P224Point.from_bytes(b[0...b.size - 1]).err.unwrap.message, "invalid P224 point encoding"
  # An x coordinate >= p.
  b = [0xff.as_u8; 57]
  b[0] = 4
  assert_eq P224Point.from_bytes(b).err.unwrap.message, "invalid P224Element encoding"
  b = [0xff.as_u8; 29]
  b[0] = 2
  assert_eq P224Point.from_bytes(b).err.unwrap.message, "invalid P224Element encoding"
  assert_eq P224Point.scalar_base_mult([1.as_u8]).err.unwrap.message, "invalid scalar length"
}

bench "P224 scalar mult" {
  P224Point.generator.scalar_mult([0x5a.as_u8; 28]).unwrap
}

bench "P224 scalar base mult" {
  P224Point.scalar_base_mult([0x5a.as_u8; 28]).unwrap
}

