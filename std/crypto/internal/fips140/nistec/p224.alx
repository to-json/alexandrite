# The point at infinity (Go: NewP224Point).
pub def new_p224_point -> P224Point { P224Point.new(x: fiat.P224Element.new, y: fiat.P224Element.one, z: fiat.P224Element.new) }

# x³ - 3x + b.
def p224_polynomial(x: fiat.P224Element) -> fiat.P224Element {
  y2 = x.square.mul(x)
  three_x = x.add(x).add(x)
  y2.sub(three_x).add(p224_b())
}

def p224_check_on_curve(x: fiat.P224Element, y: fiat.P224Element) -> ~Unit<NistecError> {
  # y² = x³ - 3x + b
  rhs = p224_polynomial(x)
  lhs = y.square
  fail NistecError.NotOnCurve(curve: "P224") if rhs.equal(lhs) != 1
  nil
}

# The n-th multiple of the table's base point (table holds [1]P..[15]P),
# selected in constant time by scanning every entry; n must be in [0, 15]
# (Go: p224Table.Select).
def p224_table_select(table: [P224Point], n: U8) -> P224Point {
  panic("nistec: internal error: p224Table called with out-of-bounds value") if n >= 16
  p = new_p224_point()
  i: U8 = 1
  while i < 16 {
    cond = subtle.constant_time_byte_eq(i, n)
    p = P224Point.select(table[(i - 1).to_i], p, cond)
    i += 1
  }
  p
}

# The n-th multiple (n in [0, 15]) of [16^t]G from the precomputed
# generator table t, selected in constant time like p224_table_select.
def p224_generator_table_select(t: Int, n: U8) -> P224Point {
  panic("nistec: internal error: p224Table called with out-of-bounds value") if n >= 16
  p = new_p224_point()
  one = fiat.P224Element.one
  i: U8 = 1
  while i < 16 {
    cond = subtle.constant_time_byte_eq(i, n)
    off = (t * 15 + (i - 1).to_i) * 8
    e = P224Point.new(x: fiat.P224Element.new(l0: P224_GENERATOR_TABLE[off + 0], l1: P224_GENERATOR_TABLE[off + 1], l2: P224_GENERATOR_TABLE[off + 2], l3: P224_GENERATOR_TABLE[off + 3]), y: fiat.P224Element.new(l0: P224_GENERATOR_TABLE[off + 4 + 0], l1: P224_GENERATOR_TABLE[off + 4 + 1], l2: P224_GENERATOR_TABLE[off + 4 + 2], l3: P224_GENERATOR_TABLE[off + 4 + 3]), z: one)
    p = P224Point.select(e, p, cond)
    i += 1
  }
  p
}

# A square root of x, or none if x is not a square.
def p224_sqrt(x: fiat.P224Element) -> fiat.P224Element? {
  candidate = p224_sqrt_candidate(x)
  square = candidate.square
  return none if square.equal(x) != 1
  candidate
}
