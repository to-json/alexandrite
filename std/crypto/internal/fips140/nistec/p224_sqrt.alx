#![overflow(wrap)]
# Go's crypto/internal/fips140/nistec/p224_sqrt.go (the addition chain
# translated by a script, the rest by hand).
import "crypto/internal/fips140/nistec/fiat"

# The constant p224GG element j (g^(2^j)) from P224_GG.
def p224_gg(j: Int) -> fiat.P224Element {
  o = j * 4
  fiat.P224Element.new(l0: P224_GG[o], l1: P224_GG[o + 1], l2: P224_GG[o + 2], l3: P224_GG[o + 3])
}

# A square root candidate for x (Go's p224SqrtCandidate).
def p224_sqrt_candidate(x: fiat.P224Element) -> fiat.P224Element {
  # Since p = 1 mod 4, we can't use the exponentiation by (p + 1) / 4 like
  # for the other primes. Instead, implement a variation of Tonelli–Shanks.
  # The constant-time implementation is adapted from Thomas Pornin's ecGFp5.
  #
  # https://github.com/pornin/ecgfp5/blob/82325b965/rust/src/field.rs#L337-L385
  # p = q*2^n + 1 with q odd -> q = 2^128 - 1 and n = 96
  # g^(2^n) = 1 -> g = 11 ^ q (where 11 is the smallest non-square)
  # GG[j] = g^(2^j) for j = 0 to n-1
  # r <- x^((q+1)/2) = x^(2^127)
  # v <- x^q = x^(2^128-1)
  r = fiat.P224Element.new
  # Compute x^(2^127-1) first.
  #
  # The sequence of 10 multiplications and 126 squarings is derived from the
  # following addition chain generated with github.com/mmcloughlin/addchain v0.4.0.
  #
  #	_10      = 2*1
  #	_11      = 1 + _10
  #	_110     = 2*_11
  #	_111     = 1 + _110
  #	_111000  = _111 << 3
  #	_111111  = _111 + _111000
  #	_1111110 = 2*_111111
  #	_1111111 = 1 + _1111110
  #	x12      = _1111110 << 5 + _111111
  #	x24      = x12 << 12 + x12
  #	i36      = x24 << 7
  #	x31      = _1111111 + i36
  #	x48      = i36 << 17 + x24
  #	x96      = x48 << 48 + x48
  #	return     x96 << 31 + x31
  #
  t0 = fiat.P224Element.new
  t1 = fiat.P224Element.new

  r = x.square
  r = x.mul(r)
  r = r.square
  r = x.mul(r)
  t0 = r.square
  s = 1
  while s < 3 {
    t0 = t0.square
    s += 1
  }
  t0 = r.mul(t0)
  t1 = t0.square
  r = x.mul(t1)
  s = 0
  while s < 5 {
    t1 = t1.square
    s += 1
  }
  t0 = t0.mul(t1)
  t1 = t0.square
  s = 1
  while s < 12 {
    t1 = t1.square
    s += 1
  }
  t0 = t0.mul(t1)
  t1 = t0.square
  s = 1
  while s < 7 {
    t1 = t1.square
    s += 1
  }
  r = r.mul(t1)
  s = 0
  while s < 17 {
    t1 = t1.square
    s += 1
  }
  t0 = t0.mul(t1)
  t1 = t0.square
  s = 1
  while s < 48 {
    t1 = t1.square
    s += 1
  }
  t0 = t0.mul(t1)
  s = 0
  while s < 31 {
    t0 = t0.square
    s += 1
  }
  r = r.mul(t0)

  # v = x^(2^127-1)^2 * x
  v = r.square.mul(x)

  # r = x^(2^127-1) * x
  r = r.mul(x)

  # for i = n-1 down to 1:
  #     w = v^(2^(i-1))
  #     if w == -1 then:
  #         v <- v*GG[n-i]
  #         r <- r*GG[n-i-1]
  p224_minus_one = fiat.P224Element.new.sub(fiat.P224Element.one)
  i = 96 - 1
  while i >= 1 {
    w = v
    j = 0
    while j < i - 1 {
      w = w.square
      j += 1
    }
    cond = w.equal(p224_minus_one)
    v = fiat.P224Element.select(v.mul(p224_gg(96 - i)), v, cond)
    r = fiat.P224Element.select(r.mul(p224_gg(96 - i - 1)), r, cond)
    i -= 1
  }
  r
}
