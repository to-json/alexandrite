#![overflow(wrap)]
# Go's crypto/internal/fips140/nistec/p256.go: the generic (purego) P-256
# implementation; the point formulas and the square root chain are
# translated by a script, the rest by hand.
import "crypto/internal/fips140/nistec/fiat"
import "crypto/subtle"

P256_ELEMENT_LENGTH = 32
P256_UNCOMPRESSED_LENGTH = 1 + 2 * P256_ELEMENT_LENGTH
P256_COMPRESSED_LENGTH = 1 + P256_ELEMENT_LENGTH

# A P-256 point (Go's P256Point). The point is represented in projective
# coordinates (X:Y:Z), where x = X/Z and y = Y/Z; infinity is (0:1:0). The
# coordinates are fiat.P256Elements: base field elements in [0, P-1] in the
# Montgomery domain (with R 2²⁵⁶ and P 2²⁵⁶ - 2²²⁴ + 2¹⁹² + 2⁹⁶ - 1) as four
# limbs in little-endian order. Points are values: every operation returns
# a new point. The zero value (P256Point.new) is NOT valid: start from
# new_p256_point, P256Point.generator or P256Point.from_bytes.
pub struct P256Point {
  x: fiat.P256Element
  y: fiat.P256Element
  z: fiat.P256Element

  # The canonical generator (Go: NewP256Point().SetGenerator()).
  pub def self.generator -> P256Point { P256Point.new(x: p256_gx(), y: p256_gy(), z: fiat.P256Element.one) }

  # The point encoded in b: the compressed, uncompressed, or infinity
  # encoding of SEC 1, Version 2.0, Section 2.3.4 (Go: SetBytes). Fails if
  # the encoding is invalid or the point is not on the curve.
  pub def self.from_bytes(b: [Byte]) -> ~P256Point {
    # Point at infinity.
    return new_p256_point() if b.size == 1 && b[0] == 0
    # Uncompressed form.
    if b.size == P256_UNCOMPRESSED_LENGTH && b[0] == 4 {
      bx = b[1...1 + P256_ELEMENT_LENGTH]
      by = b[1 + P256_ELEMENT_LENGTH...b.size]
      x = ~fiat.P256Element.from_bytes(bx)
      y = ~fiat.P256Element.from_bytes(by)
      ~p256_check_on_curve(x, y)
      return P256Point.new(x: x, y: y, z: fiat.P256Element.one)
    }
    # Compressed form.
    if b.size == P256_COMPRESSED_LENGTH && (b[0] == 2 || b[0] == 3) {
      bx = b[1...b.size]
      x = ~fiat.P256Element.from_bytes(bx)
      # y² = x³ - 3x + b
      y = p256_polynomial(x)
      root = p256_sqrt(y)
      fail NistecError.InvalidCompressedEncoding(curve: "P256") if root == none
      y = root.unwrap
      # Select the positive or negative root, as indicated by the least
      # significant bit, based on the encoding type byte.
      other_root = fiat.P256Element.new.sub(y)
      cond = (y.bytes[P256_ELEMENT_LENGTH - 1] & 1) ^ (b[0] & 1)
      y = fiat.P256Element.select(other_root, y, cond.to_i)
      return P256Point.new(x: x, y: y, z: fiat.P256Element.one)
    }
    fail NistecError.InvalidEncoding(curve: "P256")
  }

  # The uncompressed or infinity encoding of the point, as specified in SEC 1,
  # Version 2.0, Section 2.3.3. The encoding of the point at infinity is
  # shorter than all other encodings.
  pub def bytes -> [Byte] {
    # The SEC 1 representation of the point at infinity is a single zero byte,
    # and only infinity has z = 0.
    return [0.as_u8] if z.is_zero == 1
    zinv = z.invert
    xa = x.mul(zinv)
    ya = y.mul(zinv)
    buf = [4.as_u8]
    buf + xa.bytes + ya.bytes
  }

  # The encoding of the x-coordinate of the point, as specified in SEC 1,
  # Version 2.0, Section 2.3.5; fails for the point at infinity.
  pub def bytes_x -> ~[Byte] {
    fail NistecError.Infinity(curve: "P256") if z.is_zero == 1
    zinv = z.invert
    x.mul(zinv).bytes
  }

  # The compressed or infinity encoding of the point, as specified in SEC 1,
  # Version 2.0, Section 2.3.3. The encoding of the point at infinity is
  # shorter than all other encodings.
  pub def bytes_compressed -> [Byte] {
    return [0.as_u8] if z.is_zero == 1
    zinv = z.invert
    xa = x.mul(zinv)
    ya = y.mul(zinv)
    # Encode the sign of the y coordinate (indicated by the least significant
    # bit) as the encoding type (2 or 3).
    buf = [2.as_u8 | (ya.bytes[P256_ELEMENT_LENGTH - 1] & 1)]
    buf + xa.bytes
  }

  # self + p2 (Go: q.Add(p1, p2)).
  pub def add(p2: P256Point) -> P256Point {
    # Complete addition formula for a = -3 from "Complete addition formulas for
    # prime order elliptic curves" (https://eprint.iacr.org/2015/1060), §A.2.

    t0 = x.mul(p2.x)      # t0 := X1 * X2
    t1 = y.mul(p2.y)      # t1 := Y1 * Y2
    t2 = z.mul(p2.z)      # t2 := Z1 * Z2
    t3 = x.add(y)         # t3 := X1 + Y1
    t4 = p2.x.add(p2.y)   # t4 := X2 + Y2
    t3 = t3.mul(t4)       # t3 := t3 * t4
    t4 = t0.add(t1)       # t4 := t0 + t1
    t3 = t3.sub(t4)       # t3 := t3 - t4
    t4 = y.add(z)         # t4 := Y1 + Z1
    x3 = p2.y.add(p2.z)   # X3 := Y2 + Z2
    t4 = t4.mul(x3)       # t4 := t4 * X3
    x3 = t1.add(t2)       # X3 := t1 + t2
    t4 = t4.sub(x3)       # t4 := t4 - X3
    x3 = x.add(z)         # X3 := X1 + Z1
    y3 = p2.x.add(p2.z)   # Y3 := X2 + Z2
    x3 = x3.mul(y3)       # X3 := X3 * Y3
    y3 = t0.add(t2)       # Y3 := t0 + t2
    y3 = x3.sub(y3)       # Y3 := X3 - Y3
    z3 = p256_b().mul(t2) # Z3 := b * t2
    x3 = y3.sub(z3)       # X3 := Y3 - Z3
    z3 = x3.add(x3)       # Z3 := X3 + X3
    x3 = x3.add(z3)       # X3 := X3 + Z3
    z3 = t1.sub(x3)       # Z3 := t1 - X3
    x3 = t1.add(x3)       # X3 := t1 + X3
    y3 = p256_b().mul(y3) # Y3 := b * Y3
    t1 = t2.add(t2)       # t1 := t2 + t2
    t2 = t1.add(t2)       # t2 := t1 + t2
    y3 = y3.sub(t2)       # Y3 := Y3 - t2
    y3 = y3.sub(t0)       # Y3 := Y3 - t0
    t1 = y3.add(y3)       # t1 := Y3 + Y3
    y3 = t1.add(y3)       # Y3 := t1 + Y3
    t1 = t0.add(t0)       # t1 := t0 + t0
    t0 = t1.add(t0)       # t0 := t1 + t0
    t0 = t0.sub(t2)       # t0 := t0 - t2
    t1 = t4.mul(y3)       # t1 := t4 * Y3
    t2 = t0.mul(y3)       # t2 := t0 * Y3
    y3 = x3.mul(z3)       # Y3 := X3 * Z3
    y3 = y3.add(t2)       # Y3 := Y3 + t2
    x3 = t3.mul(x3)       # X3 := t3 * X3
    x3 = x3.sub(t1)       # X3 := X3 - t1
    z3 = t4.mul(z3)       # Z3 := t4 * Z3
    t1 = t3.mul(t0)       # t1 := t3 * t0
    z3 = z3.add(t1)       # Z3 := Z3 + t1
    P256Point.new(x: x3, y: y3, z: z3)
  }

  # self + self (Go: q.Double(p)).
  pub def double -> P256Point {
    # Complete addition formula for a = -3 from "Complete addition formulas for
    # prime order elliptic curves" (https://eprint.iacr.org/2015/1060), §A.2.

    t0 = x.square         # t0 := X ^ 2
    t1 = y.square         # t1 := Y ^ 2
    t2 = z.square         # t2 := Z ^ 2
    t3 = x.mul(y)         # t3 := X * Y
    t3 = t3.add(t3)       # t3 := t3 + t3
    z3 = x.mul(z)         # Z3 := X * Z
    z3 = z3.add(z3)       # Z3 := Z3 + Z3
    y3 = p256_b().mul(t2) # Y3 := b * t2
    y3 = y3.sub(z3)       # Y3 := Y3 - Z3
    x3 = y3.add(y3)       # X3 := Y3 + Y3
    y3 = x3.add(y3)       # Y3 := X3 + Y3
    x3 = t1.sub(y3)       # X3 := t1 - Y3
    y3 = t1.add(y3)       # Y3 := t1 + Y3
    y3 = x3.mul(y3)       # Y3 := X3 * Y3
    x3 = x3.mul(t3)       # X3 := X3 * t3
    t3 = t2.add(t2)       # t3 := t2 + t2
    t2 = t2.add(t3)       # t2 := t2 + t3
    z3 = p256_b().mul(z3) # Z3 := b * Z3
    z3 = z3.sub(t2)       # Z3 := Z3 - t2
    z3 = z3.sub(t0)       # Z3 := Z3 - t0
    t3 = z3.add(z3)       # t3 := Z3 + Z3
    z3 = z3.add(t3)       # Z3 := Z3 + t3
    t3 = t0.add(t0)       # t3 := t0 + t0
    t0 = t3.add(t0)       # t0 := t3 + t0
    t0 = t0.sub(t2)       # t0 := t0 - t2
    t0 = t0.mul(z3)       # t0 := t0 * Z3
    y3 = y3.add(t0)       # Y3 := Y3 + t0
    t0 = y.mul(z)         # t0 := Y * Z
    t0 = t0.add(t0)       # t0 := t0 + t0
    z3 = t0.mul(z3)       # Z3 := t0 * Z3
    x3 = x3.sub(z3)       # X3 := X3 - Z3
    z3 = t0.mul(t1)       # Z3 := t0 * t1
    z3 = z3.add(z3)       # Z3 := Z3 + Z3
    z3 = z3.add(z3)       # Z3 := Z3 + Z3
    P256Point.new(x: x3, y: y3, z: z3)
  }

  # self + p2 if infinity == 0, and self if infinity == 1 (Go: q.AddAffine(p1,
  # p2, infinity)). p2 can't be the point at infinity as it can't be
  # represented in affine coordinates, instead callers can set p2 to an
  # arbitrary point and set infinity to 1.
  def add_affine(p2: P256AffinePoint, infinity: Int) -> P256Point {
    # Complete mixed addition formula for a = -3 from "Complete addition
    # formulas for prime order elliptic curves"
    # (https://eprint.iacr.org/2015/1060), Algorithm 5.

    t0 = x.mul(p2.x)      # t0 ← X1 · X2
    t1 = y.mul(p2.y)      # t1 ← Y1 · Y2
    t3 = p2.x.add(p2.y)   # t3 ← X2 + Y2
    t4 = x.add(y)         # t4 ← X1 + Y1
    t3 = t3.mul(t4)       # t3 ← t3 · t4
    t4 = t0.add(t1)       # t4 ← t0 + t1
    t3 = t3.sub(t4)       # t3 ← t3 − t4
    t4 = p2.y.mul(z)      # t4 ← Y2 · Z1
    t4 = t4.add(y)        # t4 ← t4 + Y1
    y3 = p2.x.mul(z)      # Y3 ← X2 · Z1
    y3 = y3.add(x)        # Y3 ← Y3 + X1
    z3 = p256_b().mul(z)  # Z3 ← b  · Z1
    x3 = y3.sub(z3)       # X3 ← Y3 − Z3
    z3 = x3.add(x3)       # Z3 ← X3 + X3
    x3 = x3.add(z3)       # X3 ← X3 + Z3
    z3 = t1.sub(x3)       # Z3 ← t1 − X3
    x3 = t1.add(x3)       # X3 ← t1 + X3
    y3 = p256_b().mul(y3) # Y3 ← b  · Y3
    t1 = z.add(z)         # t1 ← Z1 + Z1
    t2 = t1.add(z)        # t2 ← t1 + Z1
    y3 = y3.sub(t2)       # Y3 ← Y3 − t2
    y3 = y3.sub(t0)       # Y3 ← Y3 − t0
    t1 = y3.add(y3)       # t1 ← Y3 + Y3
    y3 = t1.add(y3)       # Y3 ← t1 + Y3
    t1 = t0.add(t0)       # t1 ← t0 + t0
    t0 = t1.add(t0)       # t0 ← t1 + t0
    t0 = t0.sub(t2)       # t0 ← t0 − t2
    t1 = t4.mul(y3)       # t1 ← t4 · Y3
    t2 = t0.mul(y3)       # t2 ← t0 · Y3
    y3 = x3.mul(z3)       # Y3 ← X3 · Z3
    y3 = y3.add(t2)       # Y3 ← Y3 + t2
    x3 = t3.mul(x3)       # X3 ← t3 · X3
    x3 = x3.sub(t1)       # X3 ← X3 − t1
    z3 = t4.mul(z3)       # Z3 ← t4 · Z3
    t1 = t3.mul(t0)       # t1 ← t3 · t0
    z3 = z3.add(t1)       # Z3 ← Z3 + t1
    P256Point.new(x: fiat.P256Element.select(x, x3, infinity), y: fiat.P256Element.select(y, y3, infinity), z: fiat.P256Element.select(z, z3, infinity))
  }

  # -self if cond == 1, and self if cond == 0.
  def negate(cond: Int) -> P256Point {
    neg_y = fiat.P256Element.new.sub(y)
    P256Point.new(x: x, y: fiat.P256Element.select(neg_y, y, cond), z: z)
  }

  # p1 if cond == 1, and p2 if cond == 0 (constant time).
  pub def self.select(p1: P256Point, p2: P256Point, cond: Int) -> P256Point {
    P256Point.new(x: fiat.P256Element.select(p1.x, p2.x, cond), y: fiat.P256Element.select(p1.y, p2.y, cond), z: fiat.P256Element.select(p1.z, p2.z, cond))
  }

  # scalar * self, where scalar is a 32-byte big endian value (Go:
  # p.ScalarMult(q, scalar)). Fails if scalar is not 32 bytes long.
  pub def scalar_mult(scalar: [Byte]) -> ~P256Point {
    s = ~p256_ord_element_from_bytes(scalar)
    # Start scanning the window from the most significant bits. We move by
    # 5 bits at a time and need to finish at -1, so -1 + 5 * 51 = 254.
    index = 254
    sel_sign = booth_w5(p256_ord_rsh(s, index))
    # sign is always zero because the booth_w5 input here is at
    # most two bits long, so the top bit is never set.
    sel = sel_sign[0]

    # Neither select nor add have exceptions for the point at infinity /
    # selector zero, so we don't need to check for it here or in the loop.
    table = p256_table_compute(self)
    p = p256_table_select(table, sel)

    while index >= 4 {
      index -= 5
      p = p.double.double.double.double.double
      if index >= 0 {
        sel_sign = booth_w5(p256_ord_rsh(s, index) & 0b111111)
      } else {
        # Booth encoding considers a virtual zero bit at index -1,
        # so we shift left the least significant limb.
        wvalue = (s[0] << 1) & 0b111111
        sel_sign = booth_w5(wvalue)
      }
      t = p256_table_select(table, sel_sign[0]).negate(sel_sign[1])
      p = p.add(t)
    }
    p
  }

  # scalar * G, where G is the canonical generator and scalar a 32-byte big
  # endian value (Go: ScalarBaseMult). Fails if scalar is not 32 bytes long.
  pub def self.scalar_base_mult(scalar: [Byte]) -> ~P256Point {
    # This function works like scalar_mult above, but the table is fixed and
    # "pre-doubled" for each iteration, so instead of doubling we move to the
    # next table at each iteration.
    s = ~p256_ord_element_from_bytes(scalar)

    # Start scanning the window from the most significant bits. We move by
    # 6 bits at a time and need to finish at -1, so -1 + 6 * 42 = 251.
    index = 251
    sel_sign = booth_w6(p256_ord_rsh(s, index))
    # sign is always zero because the booth_w6 input here is at
    # most five bits long, so the top bit is never set.
    sel = sel_sign[0]
    t = p256_generator_table_select((index + 1) / 6, sel)

    # select's output is undefined if the selector is zero, when it should be
    # the point at infinity (because infinity can't be represented in affine
    # coordinates). Here we conditionally set p to the infinity if sel is zero.
    # In the loop, that's handled by add_affine.
    sel_is_zero = subtle.constant_time_byte_eq(sel, 0)
    p = P256Point.select(new_p256_point(), t.projective, sel_is_zero)

    while index >= 5 {
      index -= 6
      if index >= 0 {
        sel_sign = booth_w6(p256_ord_rsh(s, index) & 0b1111111)
      } else {
        # Booth encoding considers a virtual zero bit at index -1,
        # so we shift left the least significant limb.
        wvalue = (s[0] << 1) & 0b1111111
        sel_sign = booth_w6(wvalue)
      }
      t = p256_generator_table_select((index + 1) / 6, sel_sign[0]).negate(sel_sign[1])
      sel_is_zero = subtle.constant_time_byte_eq(sel_sign[0], 0)
      p = p.add_affine(t, sel_is_zero)
    }
    p
  }
}

# The point at infinity (Go: NewP256Point).
pub def new_p256_point -> P256Point { P256Point.new(x: fiat.P256Element.new, y: fiat.P256Element.one, z: fiat.P256Element.new) }

# x³ - 3x + b.
def p256_polynomial(x: fiat.P256Element) -> fiat.P256Element {
  y2 = x.square.mul(x)
  three_x = x.add(x).add(x)
  y2.sub(three_x).add(p256_b())
}

def p256_check_on_curve(x: fiat.P256Element, y: fiat.P256Element) -> ~Unit<NistecError> {
  # y² = x³ - 3x + b
  rhs = p256_polynomial(x)
  lhs = y.square
  fail NistecError.NotOnCurve(curve: "P256") if rhs.equal(lhs) != 1
  nil
}

# A point in affine coordinates (x, y). x and y are still Montgomery domain
# elements. The point can't be the point at infinity.
struct P256AffinePoint {
  x: fiat.P256Element
  y: fiat.P256Element

  def projective -> P256Point { P256Point.new(x: x, y: y, z: fiat.P256Element.one) }

  # -self if cond == 1, and self if cond == 0.
  def negate(cond: Int) -> P256AffinePoint {
    neg_y = fiat.P256Element.new.sub(y)
    P256AffinePoint.new(x: x, y: fiat.P256Element.select(neg_y, y, cond))
  }
}

# p256OrdElement: a P-256 scalar field element in [0, ord(G)-1] as four U64
# limbs in little-endian order (a 4-element slice).

# The big-endian U64 at b[i...i + 8].
def be_u64(b: [Byte], i: Int) -> U64 {
  v: U64 = 0
  k = 0
  while k < 8 {
    v = (v << 8) | b[i + k].as_u64
    k += 1
  }
  v
}

# The p256OrdElement of the big-endian x, reduced as necessary (Go:
# p256OrdElement.SetBytes). Fails unless x is 32 bytes.
def p256_ord_element_from_bytes(x: [Byte]) -> ~[U64]<NistecError> {
  fail NistecError.InvalidScalarLength if x.size != 32
  s = [be_u64(x, 24), be_u64(x, 16), be_u64(x, 8), be_u64(x, 0)]
  # Ensure s is in the range [0, ord(G)-1]. Since 2 * ord(G) > 2²⁵⁶, we can
  # just conditionally subtract ord(G), keeping the result if it doesn't
  # underflow.
  m: [U64] = [0xf3b9cac2fc632551, 0xbce6faada7179e84, 0xffffffffffffffff, 0xffffffff00000000]
  t = [0.as_u64; 4]
  b: U64 = 0
  i = 0
  while i < 4 {
    d = s[i] - m[i] - b
    b = ((^s[i] & m[i]) | (^(s[i] ^ m[i]) & d)) >> 63
    t[i] = d
    i += 1
  }
  t_mask = b - 1 # zero if subtraction underflowed
  i = 0
  while i < 4 {
    s[i] = s[i] ^ ((t[i] ^ s[i]) & t_mask)
    i += 1
  }
  s
}

# The 64 least significant bits of s >> n. n must be lower than 256. The
# value of n leaks through timing side-channels.
def p256_ord_rsh(s: [U64], n: Int) -> U64 {
  i = n / 64
  sh = n % 64
  res = s[i] >> sh
  # Shift in the more significant limb, if present.
  if i + 1 < s.size {
    res = res | (s[i + 1] << (64 - sh))
  }
  res
}

# The first 16 multiples of q (Go's p256Table.Compute). Points are stored at
# an index offset of -1 so [8]P is at index 7, P is at 0, and [16]P is at 15.
# [0]P is the point at infinity and it's not stored.
def p256_table_compute(q: P256Point) -> [P256Point] {
  table = [q; 16]
  i = 1
  while i < 16 {
    table[i] = table[i / 2].double
    if i + 1 < 16 {
      table[i + 1] = table[i].add(q)
    }
    i += 2
  }
  table
}

# The n-th multiple of the table base point, in constant time. n must be in
# [0, 16]. If n is 0, the result is the identity point.
def p256_table_select(table: [P256Point], n: U8) -> P256Point {
  panic("nistec: internal error: p256Table called with out-of-bounds value") if n > 16
  p = new_p256_point()
  i: U8 = 1
  while i <= 16 {
    cond = subtle.constant_time_byte_eq(i, n)
    p = P256Point.select(table[(i - 1).to_i], p, cond)
    i += 1
  }
  p
}

def booth_w5(inp: U64) -> (U8, Int) {
  s = ^((inp >> 5) - 1)
  d = (1.as_u64 << 6) - inp - 1
  d = (d & s) | (inp & (^s))
  d = (d >> 1) + (d & 1)
  (d.as_u8, (s & 1).as_i64)
}

# The n-th multiple of the base point of P-256 generator table t
# (p256GeneratorTables[t], [1..32]·[2^(6t)]G), in constant time. n can be in
# [0, 32], but (unlike p256_table_select) if n is 0, the result is an
# undefined value (Go's p256AffineTable.Select).
def p256_generator_table_select(t: Int, n: U8) -> P256AffinePoint {
  panic("nistec: internal error: p256AffineTable.Select called with out-of-bounds value") if n > 32
  px = fiat.P256Element.new
  py = fiat.P256Element.new
  i: U8 = 1
  while i <= 32 {
    cond = subtle.constant_time_byte_eq(i, n)
    o = (t * 32 + (i - 1).to_i) * 8
    tx = fiat.P256Element.new(l0: P256_PRECOMPUTED[o], l1: P256_PRECOMPUTED[o + 1], l2: P256_PRECOMPUTED[o + 2], l3: P256_PRECOMPUTED[o + 3])
    ty = fiat.P256Element.new(l0: P256_PRECOMPUTED[o + 4], l1: P256_PRECOMPUTED[o + 5], l2: P256_PRECOMPUTED[o + 6], l3: P256_PRECOMPUTED[o + 7])
    px = fiat.P256Element.select(tx, px, cond)
    py = fiat.P256Element.select(ty, py, cond)
    i += 1
  }
  P256AffinePoint.new(x: px, y: py)
}

def booth_w6(inp: U64) -> (U8, Int) {
  s = ^((inp >> 6) - 1)
  d = (1.as_u64 << 7) - inp - 1
  d = (d & s) | (inp & (^s))
  d = (d >> 1) + (d & 1)
  (d.as_u8, (s & 1).as_i64)
}

# A square root of x, or none if x is not a square (Go's p256Sqrt).
def p256_sqrt(x: fiat.P256Element) -> fiat.P256Element? {
  t0 = fiat.P256Element.new
  t1 = fiat.P256Element.new
  # Since p = 3 mod 4, exponentiation by (p + 1) / 4 yields a square root candidate.
  #
  # The sequence of 7 multiplications and 253 squarings is derived from the
  # following addition chain generated with github.com/mmcloughlin/addchain v0.4.0.
  #
  #	_10       = 2*1
  #	_11       = 1 + _10
  #	_1100     = _11 << 2
  #	_1111     = _11 + _1100
  #	_11110000 = _1111 << 4
  #	_11111111 = _1111 + _11110000
  #	x16       = _11111111 << 8 + _11111111
  #	x32       = x16 << 16 + x16
  #	return      ((x32 << 32 + 1) << 96 + 1) << 94
  #
  t0 = p256_square_n(x, 1)
  t0 = x.mul(t0)
  t1 = p256_square_n(t0, 2)
  t0 = t0.mul(t1)
  t1 = p256_square_n(t0, 4)
  t0 = t0.mul(t1)
  t1 = p256_square_n(t0, 8)
  t0 = t0.mul(t1)
  t1 = p256_square_n(t0, 16)
  t0 = t0.mul(t1)
  t0 = p256_square_n(t0, 32)
  t0 = x.mul(t0)
  t0 = p256_square_n(t0, 96)
  t0 = x.mul(t0)
  t0 = p256_square_n(t0, 94)

  # Check if the candidate t0 is indeed a square root of x.
  t1 = t0.square
  return none if t1.equal(x) != 1
  t0
}

# x squared n times, n >= 1.
def p256_square_n(x: fiat.P256Element, n: Int) -> fiat.P256Element {
  e = x.square
  i = 1
  while i < n {
    e = e.square
    i += 1
  }
  e
}
