    x107 = x2.__mulhi(x4)
    x108 = x107 + x104
    x109 = ((x107 & x104) | ((x107 | x104) &^ x108)) >> 63
    x110 = x105 + x102 + x109
    x111 = ((x105 & x102) | ((x105 | x102) &^ x110)) >> 63
    x112 = x103 + x100 + x111
    x113 = ((x103 & x100) | ((x103 | x100) &^ x112)) >> 63
    x114 = x113 + x101
    x115 = x91 + x106
    x116 = ((x91 & x106) | ((x91 | x106) &^ x115)) >> 63
    x117 = x93 + x108 + x116
    x118 = ((x93 & x108) | ((x93 | x108) &^ x117)) >> 63
    x119 = x95 + x110 + x118
    x120 = ((x95 & x110) | ((x95 | x110) &^ x119)) >> 63
    x121 = x97 + x112 + x120
    x122 = ((x97 & x112) | ((x97 | x112) &^ x121)) >> 63
    x123 = x99 + x114 + x122
