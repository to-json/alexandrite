  x51 = x1 * arg2.l1
  x52 = x1.__mulhi(arg2.l1)
  x53 = x1 * arg2.l0
  x54 = x1.__mulhi(arg2.l0)
  x55 = x54 + x51
  x56 = ((x54 & x51) | ((x54 | x51) &^ x55)) >> 63
  x57 = x52 + x49 + x56
  x58 = ((x52 & x49) | ((x52 | x49) &^ x57)) >> 63
  x59 = x50 + x47 + x58
  x60 = ((x50 & x47) | ((x50 | x47) &^ x59)) >> 63
  x61 = x60 + x48
  x62 = x39 + x53
  x63 = ((x39 & x53) | ((x39 | x53) &^ x62)) >> 63
  x64 = x41 + x55 + x63
  x65 = ((x41 & x55) | ((x41 | x55) &^ x64)) >> 63
  x66 = x43 + x57 + x65
  x67 = ((x43 & x57) | ((x43 | x57) &^ x66)) >> 63
  x68 = x45 + x59 + x67
  x69 = ((x45 & x59) | ((x45 | x59) &^ x68)) >> 63
  x70 = x46 + x61 + x69
  x71 = ((x46 & x61) | ((x46 | x61) &^ x70)) >> 63
  x72 = x62 * 0xccd1c8aaee00bc4f
  x74 = 0.as_u64 - (x72 << 32)
  b74 = ((^0.as_u64 & (x72 << 32)) | (^(0.as_u64 ^ (x72 << 32)) & x74)) >> 63
  x75 = (x72 - (x72 >> 32)) - b74
  x76 = 0.as_u64 - x72
  b76 = ((^0.as_u64 & x72) | (^(0.as_u64 ^ x72) & x76)) >> 63
  x77 = x72 - b76
  x78 = x72 * 0xbce6faada7179e84
  x79 = x72.__mulhi(0xbce6faada7179e84)
  x80 = x72 * 0xf3b9cac2fc632551
