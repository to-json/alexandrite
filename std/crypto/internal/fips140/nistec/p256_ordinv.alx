  x88 = x87 + x75
  x90_s = x62 + x80
  x90 = ((x62 & x80) | ((x62 | x80) &^ x90_s)) >> 63
  x91 = x64 + x82 + x90
  x92 = ((x64 & x82) | ((x64 | x82) &^ x91)) >> 63
  x93 = x66 + x84 + x92
  x94 = ((x66 & x84) | ((x66 | x84) &^ x93)) >> 63
  x95 = x68 + x86 + x94
  x96 = ((x68 & x86) | ((x68 | x86) &^ x95)) >> 63
  x97 = x70 + x88 + x96
  x98 = ((x70 & x88) | ((x70 | x88) &^ x97)) >> 63
  x99 = x98 + x71
  x100 = x2 * arg2.l3
  x101 = x2.__mulhi(arg2.l3)
  x102 = x2 * arg2.l2
  x103 = x2.__mulhi(arg2.l2)
  x104 = x2 * arg2.l1
  x105 = x2.__mulhi(arg2.l1)
  x106 = x2 * arg2.l0
  x107 = x2.__mulhi(arg2.l0)
  x108 = x107 + x104
  x109 = ((x107 & x104) | ((x107 | x104) &^ x108)) >> 63
  x110 = x105 + x102 + x109
  x111 = ((x105 & x102) | ((x105 | x102) &^ x110)) >> 63
  x112 = x103 + x100 + x111
  x113 = ((x103 & x100) | ((x103 | x100) &^ x112)) >> 63
  x114 = x113 + x101
