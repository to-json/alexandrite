#![overflow(wrap)]
# Go's crypto/internal/fips140/nistec/p256_ordinv.go: inversion modulo the
# order of the P-256 group. The fiat-crypto functions are translated by a
# script (as in package fiat), the driver by hand. Constant time.

# A scalar field element in the Montgomery domain (Go's p256OrdMontElement),
# as four U64 limbs in little-endian order. It must be strictly less than
# ord(G) and in Montgomery form (with R 2²⁵⁶). Also used for the plain limbs
# of p256OrdElement in and out of the conversions.
struct P256OrdMont {
  l0: U64
  l1: U64
  l2: U64
  l3: U64
}

# Sets k (four U64 limbs, little-endian, reduced) to its inverse modulo
# ord(G), in place; zero stays zero (Go's P256OrdInverse(k *[4]uint64)).
pub def p256_ord_inverse(k: [U64]) {
  # Inversion is implemented as exponentiation by n - 2, per Fermat's little theorem.
  #
  # The sequence of 38 multiplications and 254 squarings is derived from
  # https://briansmith.org/ecc-inversion-addition-chains-01#p256_scalar_inversion
  # _1
  m1 = p256_ord_to_montgomery(P256OrdMont.new(l0: k[0], l1: k[1], l2: k[2], l3: k[3]))
  x = p256_ord_sqr(m1, 1)       # _10
  m11 = p256_ord_mul(x, m1)     # _11
  m101 = p256_ord_mul(x, m11)   # _101
  m111 = p256_ord_mul(x, m101)  # _111
  x = p256_ord_sqr(m101, 1)     # _1010
  m1111 = p256_ord_mul(m101, x) # _1111

  t = p256_ord_sqr(x, 1)          # _10100
  m10101 = p256_ord_mul(t, m1)    # _10101
  x = p256_ord_sqr(m10101, 1)     # _101010
  m101111 = p256_ord_mul(m101, x) # _101111
  x = p256_ord_mul(m10101, x)     # _111111 = x6
  t = p256_ord_sqr(x, 2)          # _11111100
  t = p256_ord_mul(t, m11)        # _11111111 = x8
  x = p256_ord_sqr(t, 8)          # _ff00
  x = p256_ord_mul(x, t)          # _ffff = x16
  t = p256_ord_sqr(x, 16)         # _ffff0000
  t = p256_ord_mul(t, x)          # _ffffffff = x32

  x = p256_ord_sqr(t, 64)
  x = p256_ord_mul(x, t)
  x = p256_ord_sqr(x, 32)
  x = p256_ord_mul(x, t)

  sqrs = [6, 5, 4, 5, 5, 4, 3, 3, 5, 9, 6, 2, 5, 6, 5, 4, 5, 5, 3, 10, 2, 5, 5, 3, 7, 6]
  muls = [
    m101111, m111, m11, m1111, m10101,
    m101, m101, m101, m111, m101111,
    m1111, m1, m1, m1111, m111,
    m111, m111, m101, m11, m101111,
    m11, m11, m11, m1, m10101, m1111,
  ]
  i = 0
  while i < sqrs.size {
    x = p256_ord_sqr(x, sqrs[i])
    x = p256_ord_mul(x, muls[i])
    i += 1
  }

  r = p256_ord_from_montgomery(x)
  j = k
  j[0] = r.l0
  j[1] = r.l1
  j[2] = r.l2
  j[3] = r.l3
  nil
}

# Multiplies two field elements in the Montgomery domain.
def p256_ord_mul(arg1: P256OrdMont, arg2: P256OrdMont) -> P256OrdMont {
  x1 = arg1.l1
  x2 = arg1.l2
  x3 = arg1.l3
  x4 = arg1.l0
  x5 = x4 * arg2.l3
  x6 = x4.__mulhi(arg2.l3)
  x7 = x4 * arg2.l2
  x8 = x4.__mulhi(arg2.l2)
  x9 = x4 * arg2.l1
  x10 = x4.__mulhi(arg2.l1)
  x11 = x4 * arg2.l0
  x12 = x4.__mulhi(arg2.l0)
  x13 = x12 + x9
  x14 = ((x12 & x9) | ((x12 | x9) &^ x13)) >> 63
  x15 = x10 + x7 + x14
  x16 = ((x10 & x7) | ((x10 | x7) &^ x15)) >> 63
  x17 = x8 + x5 + x16
  x18 = ((x8 & x5) | ((x8 | x5) &^ x17)) >> 63
  x19 = x18 + x6
  x20 = x11 * 0xccd1c8aaee00bc4f
  x22 = 0.as_u64 - (x20 << 32)
  b22 = ((^0.as_u64 & (x20 << 32)) | (^(0.as_u64 ^ (x20 << 32)) & x22)) >> 63
  x23 = (x20 - (x20 >> 32)) - b22
  x24 = 0.as_u64 - x20
  b24 = ((^0.as_u64 & x20) | (^(0.as_u64 ^ x20) & x24)) >> 63
  x25 = x20 - b24
  x26 = x20 * 0xbce6faada7179e84
  x27 = x20.__mulhi(0xbce6faada7179e84)
  x28 = x20 * 0xf3b9cac2fc632551
  x29 = x20.__mulhi(0xf3b9cac2fc632551)
  x30 = x29 + x26
  x31 = ((x29 & x26) | ((x29 | x26) &^ x30)) >> 63
  x32 = x27 + x24 + x31
  x33 = ((x27 & x24) | ((x27 | x24) &^ x32)) >> 63
  x34 = x25 + x22 + x33
  x35 = ((x25 & x22) | ((x25 | x22) &^ x34)) >> 63
  x36 = x35 + x23
  x38_s = x11 + x28
  x38 = ((x11 & x28) | ((x11 | x28) &^ x38_s)) >> 63
  x39 = x13 + x30 + x38
  x40 = ((x13 & x30) | ((x13 | x30) &^ x39)) >> 63
  x41 = x15 + x32 + x40
