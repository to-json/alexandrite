# Squares n times a field element in the Montgomery domain.
def p256_ord_sqr(arg1: P256OrdMont, n: Int) -> P256OrdMont {
  x1 = arg1.l1
  x2 = arg1.l2
  x3 = arg1.l3
  x4 = arg1.l0
  r = 0
  while r < n {
    x5 = x4 * x3
    x6 = x4.__mulhi(x3)
    x7 = x4 * x2
    x8 = x4.__mulhi(x2)
    x9 = x4 * x1
    x10 = x4.__mulhi(x1)
    x11 = x4 * x4
    x12 = x4.__mulhi(x4)
    x13 = x12 + x9
    x14 = ((x12 & x9) | ((x12 | x9) &^ x13)) >> 63
    x15 = x10 + x7 + x14
    x16 = ((x10 & x7) | ((x10 | x7) &^ x15)) >> 63
    x17 = x8 + x5 + x16
    x18 = ((x8 & x5) | ((x8 | x5) &^ x17)) >> 63
    x19 = x18 + x6
    x20 = x11 * 0xccd1c8aaee00bc4f
    x22 = 0.as_u64 - (x20 << 32)
    b22 = ((^0.as_u64 & (x20 << 32)) | (^(0.as_u64 ^ (x20 << 32)) & x22)) >> 63
    x23 = (x20 - (x20 >> 32)) - b22
    x24 = 0.as_u64 - x20
    b24 = ((^0.as_u64 & x20) | (^(0.as_u64 ^ x20) & x24)) >> 63
    x25 = x20 - b24
    x26 = x20 * 0xbce6faada7179e84
    x27 = x20.__mulhi(0xbce6faada7179e84)
    x28 = x20 * 0xf3b9cac2fc632551
    x29 = x20.__mulhi(0xf3b9cac2fc632551)
    x30 = x29 + x26
    x31 = ((x29 & x26) | ((x29 | x26) &^ x30)) >> 63
    x32 = x27 + x24 + x31
    x33 = ((x27 & x24) | ((x27 | x24) &^ x32)) >> 63
    x34 = x25 + x22 + x33
    x35 = ((x25 & x22) | ((x25 | x22) &^ x34)) >> 63
    x36 = x35 + x23
    x38_s = x11 + x28
    x38 = ((x11 & x28) | ((x11 | x28) &^ x38_s)) >> 63
    x39 = x13 + x30 + x38
    x40 = ((x13 & x30) | ((x13 | x30) &^ x39)) >> 63
    x41 = x15 + x32 + x40
    x42 = ((x15 & x32) | ((x15 | x32) &^ x41)) >> 63
    x43 = x17 + x34 + x42
    x44 = ((x17 & x34) | ((x17 | x34) &^ x43)) >> 63
    x45 = x19 + x36 + x44
    x46 = ((x19 & x36) | ((x19 | x36) &^ x45)) >> 63
    x47 = x1 * x3
    x48 = x1.__mulhi(x3)
    x49 = x1 * x2
    x50 = x1.__mulhi(x2)
    x51 = x1 * x1
    x52 = x1.__mulhi(x1)
    x53 = x1 * x4
    x54 = x1.__mulhi(x4)
    x55 = x54 + x51
    x56 = ((x54 & x51) | ((x54 | x51) &^ x55)) >> 63
    x57 = x52 + x49 + x56
    x58 = ((x52 & x49) | ((x52 | x49) &^ x57)) >> 63
    x59 = x50 + x47 + x58
    x60 = ((x50 & x47) | ((x50 | x47) &^ x59)) >> 63
    x61 = x60 + x48
    x62 = x39 + x53
    x63 = ((x39 & x53) | ((x39 | x53) &^ x62)) >> 63
    x64 = x41 + x55 + x63
    x65 = ((x41 & x55) | ((x41 | x55) &^ x64)) >> 63
    x66 = x43 + x57 + x65
    x67 = ((x43 & x57) | ((x43 | x57) &^ x66)) >> 63
