  x128 = (x125 - (x125 >> 32)) - b127
  x129 = 0.as_u64 - x125
  b129 = ((^0.as_u64 & x125) | (^(0.as_u64 ^ x125) & x129)) >> 63
  x130 = x125 - b129
  x131 = x125 * 0xbce6faada7179e84
  x132 = x125.__mulhi(0xbce6faada7179e84)
  x133 = x125 * 0xf3b9cac2fc632551
  x134 = x125.__mulhi(0xf3b9cac2fc632551)
  x135 = x134 + x131
  x136 = ((x134 & x131) | ((x134 | x131) &^ x135)) >> 63
  x137 = x132 + x129 + x136
  x138 = ((x132 & x129) | ((x132 | x129) &^ x137)) >> 63
  x139 = x130 + x127 + x138
  x140 = ((x130 & x127) | ((x130 | x127) &^ x139)) >> 63
  x141 = x140 + x128
  x143_s = x115 + x133
  x143 = ((x115 & x133) | ((x115 | x133) &^ x143_s)) >> 63
  x144 = x117 + x135 + x143
  x145 = ((x117 & x135) | ((x117 | x135) &^ x144)) >> 63
  x146 = x119 + x137 + x145
  x147 = ((x119 & x137) | ((x119 | x137) &^ x146)) >> 63
  x148 = x121 + x139 + x147
  x149 = ((x121 & x139) | ((x121 | x139) &^ x148)) >> 63
  x150 = x123 + x141 + x149
  x151 = ((x123 & x141) | ((x123 | x141) &^ x150)) >> 63
  x152 = x151 + x124
  x153 = x3 * arg2.l3
  x154 = x3.__mulhi(arg2.l3)
  x155 = x3 * arg2.l2
  x156 = x3.__mulhi(arg2.l2)
  x157 = x3 * arg2.l1
  x158 = x3.__mulhi(arg2.l1)
  x159 = x3 * arg2.l0
  x160 = x3.__mulhi(arg2.l0)
  x161 = x160 + x157
  x162 = ((x160 & x157) | ((x160 | x157) &^ x161)) >> 63
  x163 = x158 + x155 + x162
  x164 = ((x158 & x155) | ((x158 | x155) &^ x163)) >> 63
  x165 = x156 + x153 + x164
  x166 = ((x156 & x153) | ((x156 | x153) &^ x165)) >> 63
  x167 = x166 + x154
  x168 = x144 + x159
  x169 = ((x144 & x159) | ((x144 | x159) &^ x168)) >> 63
  x170 = x146 + x161 + x169
  x171 = ((x146 & x161) | ((x146 | x161) &^ x170)) >> 63
  x172 = x148 + x163 + x171
  x173 = ((x148 & x163) | ((x148 | x163) &^ x172)) >> 63
  x174 = x150 + x165 + x173
  x175 = ((x150 & x165) | ((x150 | x165) &^ x174)) >> 63
  x176 = x152 + x167 + x175
  x177 = ((x152 & x167) | ((x152 | x167) &^ x176)) >> 63
  x178 = x168 * 0xccd1c8aaee00bc4f
  x180 = 0.as_u64 - (x178 << 32)
  b180 = ((^0.as_u64 & (x178 << 32)) | (^(0.as_u64 ^ (x178 << 32)) & x180)) >> 63
