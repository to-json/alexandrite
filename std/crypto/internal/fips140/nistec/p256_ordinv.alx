  x117 = x93 + x108 + x116
  x118 = ((x93 & x108) | ((x93 | x108) &^ x117)) >> 63
  x119 = x95 + x110 + x118
  x120 = ((x95 & x110) | ((x95 | x110) &^ x119)) >> 63
