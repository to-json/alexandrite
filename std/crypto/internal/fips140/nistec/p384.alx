# The point at infinity (Go: NewP384Point).
pub def new_p384_point -> P384Point { P384Point.new(x: fiat.P384Element.new, y: fiat.P384Element.one, z: fiat.P384Element.new) }

# x³ - 3x + b.
def p384_polynomial(x: fiat.P384Element) -> fiat.P384Element {
  y2 = x.square.mul(x)
  three_x = x.add(x).add(x)
  y2.sub(three_x).add(p384_b())
}

def p384_check_on_curve(x: fiat.P384Element, y: fiat.P384Element) -> ~Unit<NistecError> {
  # y² = x³ - 3x + b
  rhs = p384_polynomial(x)
  lhs = y.square
  fail NistecError.NotOnCurve(curve: "P384") if rhs.equal(lhs) != 1
  nil
}

# The n-th multiple of the table's base point (table holds [1]P..[15]P),
# selected in constant time by scanning every entry; n must be in [0, 15]
# (Go: p384Table.Select).
def p384_table_select(table: [P384Point], n: U8) -> P384Point {
  panic("nistec: internal error: p384Table called with out-of-bounds value") if n >= 16
  p = new_p384_point()
  i: U8 = 1
  while i < 16 {
    cond = subtle.constant_time_byte_eq(i, n)
    p = P384Point.select(table[(i - 1).to_i], p, cond)
    i += 1
  }
  p
}

# The n-th multiple (n in [0, 15]) of [16^t]G from the precomputed
# generator table t, selected in constant time like p384_table_select.
def p384_generator_table_select(t: Int, n: U8) -> P384Point {
  panic("nistec: internal error: p384Table called with out-of-bounds value") if n >= 16
  p = new_p384_point()
  one = fiat.P384Element.one
  i: U8 = 1
  while i < 16 {
    cond = subtle.constant_time_byte_eq(i, n)
    off = (t * 15 + (i - 1).to_i) * 12
    e = P384Point.new(x: fiat.P384Element.new(l0: P384_GENERATOR_TABLE[off + 0], l1: P384_GENERATOR_TABLE[off + 1], l2: P384_GENERATOR_TABLE[off + 2], l3: P384_GENERATOR_TABLE[off + 3], l4: P384_GENERATOR_TABLE[off + 4], l5: P384_GENERATOR_TABLE[off + 5]), y: fiat.P384Element.new(l0: P384_GENERATOR_TABLE[off + 6 + 0], l1: P384_GENERATOR_TABLE[off + 6 + 1], l2: P384_GENERATOR_TABLE[off + 6 + 2], l3: P384_GENERATOR_TABLE[off + 6 + 3], l4: P384_GENERATOR_TABLE[off + 6 + 4], l5: P384_GENERATOR_TABLE[off + 6 + 5]), z: one)
    p = P384Point.select(e, p, cond)
    i += 1
  }
  p
}

# A square root of x, or none if x is not a square.
def p384_sqrt(x: fiat.P384Element) -> fiat.P384Element? {
  candidate = p384_sqrt_candidate(x)
  square = candidate.square
  return none if square.equal(x) != 1
  candidate
}

# A square root candidate for x (Go's p384SqrtCandidate).
def p384_sqrt_candidate(x: fiat.P384Element) -> fiat.P384Element {
  z = fiat.P384Element.new
  # Since p = 3 mod 4, exponentiation by (p + 1) / 4 yields a square root candidate.
  #
  # The sequence of 14 multiplications and 381 squarings is derived from the
  # following addition chain generated with github.com/mmcloughlin/addchain v0.4.0.
  #
  #	_10      = 2*1
  #	_11      = 1 + _10
  #	_110     = 2*_11
  #	_111     = 1 + _110
  #	_111000  = _111 << 3
  #	_111111  = _111 + _111000
  #	_1111110 = 2*_111111
  #	_1111111 = 1 + _1111110
  #	x12      = _1111110 << 5 + _111111
  #	x24      = x12 << 12 + x12
  #	x31      = x24 << 7 + _1111111
  #	x32      = 2*x31 + 1
  #	x63      = x32 << 31 + x31
  #	x126     = x63 << 63 + x63
  #	x252     = x126 << 126 + x126
  #	x255     = x252 << 3 + _111
  #	return     ((x255 << 33 + x32) << 64 + 1) << 30
  #
  t0 = fiat.P384Element.new
  t1 = fiat.P384Element.new
  t2 = fiat.P384Element.new

  z = x.square
  z = x.mul(z)
  z = z.square
  t0 = x.mul(z)
  z = t0.square
  s = 1
  while s < 3 {
    z = z.square
    s += 1
  }
  t1 = t0.mul(z)
  t2 = t1.square
  z = x.mul(t2)
  s = 0
  while s < 5 {
    t2 = t2.square
    s += 1
  }
  t1 = t1.mul(t2)
  t2 = t1.square
  s = 1
  while s < 12 {
    t2 = t2.square
    s += 1
  }
  t1 = t1.mul(t2)
  s = 0
  while s < 7 {
    t1 = t1.square
    s += 1
  }
  t1 = z.mul(t1)
  z = t1.square
  z = x.mul(z)
  t2 = z.square
  s = 1
  while s < 31 {
    t2 = t2.square
    s += 1
  }
  t1 = t1.mul(t2)
  t2 = t1.square
  s = 1
  while s < 63 {
    t2 = t2.square
    s += 1
  }
  t1 = t1.mul(t2)
  t2 = t1.square
  s = 1
  while s < 126 {
    t2 = t2.square
    s += 1
  }
  t1 = t1.mul(t2)
  s = 0
  while s < 3 {
    t1 = t1.square
    s += 1
  }
  t0 = t0.mul(t1)
  s = 0
  while s < 33 {
    t0 = t0.square
    s += 1
  }
  z = z.mul(t0)
  s = 0
  while s < 64 {
    z = z.square
    s += 1
  }
  z = x.mul(z)
  s = 0
  while s < 30 {
    z = z.square
    s += 1
  }
  z
}
