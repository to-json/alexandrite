    # Compute a table for the base point q.
    table = [new_p384_point(); 15]
    table[0] = q
    i = 1
    while i < 15 {
      table[i] = table[i / 2].double
      table[i + 1] = table[i].add(q)
      i += 2
    }
    # Instead of doing the classic double-and-add chain, we do it with a
    # four-bit window: we double four times, and then add [0-15]P.
    p = new_p384_point()
    k = 0
    while k < scalar.size {
      byte = scalar[k]
      # No need to double on the first iteration, as p is the identity at
      # this point, and [N]∞ = ∞.
      if k != 0 {
        p = p.double.double.double.double
      }
      p = p.add(p384_table_select(table, byte >> 4))
      p = p.double.double.double.double
      p = p.add(p384_table_select(table, byte & 0b1111))
      k += 1
