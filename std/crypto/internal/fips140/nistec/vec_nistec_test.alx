  assert_eq hex.encode_to_string(p.double.bytes), "044eb4ac1f03f423ff22d7d6f41d941230ad73cac9c8a8cdb76fb3003643dc7bd8d3f525869e277589d2a897c90a2bef0631835d5e22f39808"
  p = P224Point.from_bytes(hex.decode_string("04c72c1252f147c7769067401d9596ca6a26d300f2df645d29e7e17fd9bc0f0933ae890b34e6d168050556d3ccb7a2e96d63fabee04be67101").unwrap).unwrap
  assert_eq hex.encode_to_string(p.bytes_compressed), "03c72c1252f147c7769067401d9596ca6a26d300f2df645d29e7e17fd9"
  assert_eq hex.encode_to_string(P224Point.from_bytes(p.bytes_compressed).unwrap.bytes), "04c72c1252f147c7769067401d9596ca6a26d300f2df645d29e7e17fd9bc0f0933ae890b34e6d168050556d3ccb7a2e96d63fabee04be67101"
  assert_eq hex.encode_to_string(p.bytes_x.unwrap), "c72c1252f147c7769067401d9596ca6a26d300f2df645d29e7e17fd9"
  s = hex.decode_string("2ee8e6f396bc1f12b1cacc183c4515d9f775ebd54471b8ab18077af2").unwrap
  assert_eq hex.encode_to_string(p.scalar_mult(s).unwrap.bytes), "0431d33b7a7c1a441d6a47447095784c38fc01f415d062704702ae8ae38881ae563a68d40be3b7635d59d4065e1fc71cb3e5bf15082bedd315"
  assert_eq hex.encode_to_string(P224Point.scalar_base_mult(s).unwrap.bytes), "04cf78b09d10353567ad53aec985fd770ea3f740f79cd81072eed643b8fcad987dc917927f0d83b4406d99a2dc69ed85af3d80898c8026930e"
  assert_eq hex.encode_to_string(p.add(P224Point.scalar_base_mult(s).unwrap).bytes), "04fc634a9ec56ebaeb204c14430fd80d42a34d53dee1a7597c403c08c964bd941ad9b7e4d3089f8480d030117060b8d911a98830a29d515118"
  assert_eq hex.encode_to_string(p.double.bytes), "04ad285ff43197218e54994ed3fc87447a396d624577349e5a92ed4deb393d61558cf9d19e11fb856aa88a4a80c6f42bed470e388ee07f773e"
  assert_eq P224Point.from_bytes(hex.decode_string("0200000000000000000000000000000000000000000000000000000000").unwrap).err.unwrap.message, "invalid P224 compressed point encoding"
  assert_eq hex.encode_to_string(P224Point.from_bytes(hex.decode_string("0300000000000000000000000000000000000000000000000000000003").unwrap).unwrap.bytes), "04000000000000000000000000000000000000000000000000000000038353d9639842aa15eb1000b152101a17b687aeb50eb377054b913fbb"
}

