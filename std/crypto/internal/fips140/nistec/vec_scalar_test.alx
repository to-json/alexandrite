# Generated from Go's crypto/elliptic (nistec underneath) and the scalars of
# crypto/internal/fips140test's TestScalarMult; do not edit by hand.

test "P224 scalar mult 0" {
  # 0
  check_scalar_p224("00000000000000000000000000000000000000000000000000000000", "00000000000000000000000000000000000000000000000000000000", true, "00")
  # 1
  check_scalar_p224("00000000000000000000000000000000000000000000000000000001", "ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3c", false, "04b70e0cbd6bb4bf7f321390b94a03c1d356c21122343280d6115c1d21bd376388b5f723fb4c22dfe6cd4375a05a07476444d5819985007e34")
  # N-1
  check_scalar_p224("ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3c", "00000000000000000000000000000000000000000000000000000001", false, "04b70e0cbd6bb4bf7f321390b94a03c1d356c21122343280d6115c1d2142c89c774a08dc04b3dd201932bc8a5ea5f8b89bbb2a7e667aff81cd")
  # N
  check_scalar_p224("ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3d", "00000000000000000000000000000000000000000000000000000000", true, "00")
  # N+1
  check_scalar_p224("ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3e", "ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3c", false, "04b70e0cbd6bb4bf7f321390b94a03c1d356c21122343280d6115c1d21bd376388b5f723fb4c22dfe6cd4375a05a07476444d5819985007e34")
