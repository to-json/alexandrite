#![overflow(wrap)]
# Package md5: Go's crypto/md5, the MD5 hash algorithm of RFC 1321.
# MD5 is cryptographically broken and should not be used for secure
# applications. Pure alx: the generic (non-assembly) code of Go's crypto/md5.
#
#   Go                                  alx
#   md5.Size / BlockSize                SIZE / BLOCK_SIZE
#   md5.New() hash.Hash                 new() -> Digest
#   md5.Sum(data) [Size]byte            sum(data) -> [Byte; 16]
#   d.Write(p) (int, error)             d.write!(p) -> Int (never fails)
#   d.Sum(b) / Reset / Size / BlockSize d.sum(b) / d.reset! / d.size / d.block_size
#   d.MarshalBinary / AppendBinary      d.marshal_binary / d.append_binary(b) (never fail)
#   d.UnmarshalBinary(b) error          d.unmarshal_binary!(b) -> ~Unit<StateError>
#   d.Clone() (hash.Cloner, error)      d.clone -> Digest
#
# A Digest satisfies hash.Hash structurally.
#
# Differences from Go:
#   - New returns the concrete Digest (Go: hash.Hash; Go's digest type is
#     unexported); it converts to a hash.Hash wherever one is wanted.
#     crypto.MD5.new gives a hash.Hash.
#   - No registration with package crypto at init (alx has no init
#     functions); package crypto knows the hashes it can make.
#   - A Digest keeps its state in shared storage (GO-VS-RUBY D36): copies of
#     a Digest are the same hash, as Go's pointer is; `clone` makes an
#     independent one. Use new: a zero `Digest.new` has no state.
#   - Clone, MarshalBinary and AppendBinary can't fail, so they return plain
#     values. No FIPS 140-only mode (which makes Go's MD5 fail), no assembly.

# The size of an MD5 checksum in bytes.
pub SIZE = 16
# The blocksize of MD5 in bytes.
pub BLOCK_SIZE = 64

MAGIC = "md5\x01"
MARSHALED_SIZE = 4 + 4 * 4 + BLOCK_SIZE + 8

# Errors of Digest.unmarshal_binary!.
pub error StateError {
  InvalidIdentifier
  InvalidSize

  def message -> Str {
    case self {
      InvalidIdentifier => "crypto/md5: invalid hash state identifier"
      InvalidSize => "crypto/md5: invalid hash state size"
    }
  }
}

def append_be32(b: [Byte], v: U32) -> [Byte] {
  out = b
  out << (v >> 24).as_u8
  out << (v >> 16).as_u8
  out << (v >> 8).as_u8
  out << v.as_u8
  out
}

def be32(b: [Byte], i: Int) -> U32 {
  (b[i].as_u32 << 24) | (b[i + 1].as_u32 << 16) | (b[i + 2].as_u32 << 8) | b[i + 3].as_u32
}

# Whether b starts with the bytes of s.
def has_magic(b: [Byte], s: Str) -> Bool {
  return false if b.size < s.size
  i = 0
  while i < s.size {
    return false if b[i] != s[i]
    i += 1
  }
  true
}

# A new MD5 hash.
pub def new -> Digest {
  d = Digest.new(s: [0.as_u32; 4], x: [0.as_u8; BLOCK_SIZE], n: [0.as_u64; 2])
  d.reset!
  d
}

# The MD5 checksum of data.
pub def sum(data: [Byte]) -> [Byte; 16] {
  d = new()
  d.write!(data)
  out: [Byte; 16] = [0; 16]
  copy(out[0...16], d.check_sum)
  out
}

# A running MD5 hash.
pub struct Digest {
  # The chaining state.
  s: [U32]
  # The partial block.
  x: [Byte]
  # n[0]: bytes in x; n[1]: total bytes written.
  n: [U64]

  # The checksum size in bytes: 16.
  pub def size -> Int { SIZE }

  # The block size: 64.
  pub def block_size -> Int { BLOCK_SIZE }

  # Back to the initial state.
  pub def reset! {
    self.s[0] = 0x67452301
    self.s[1] = 0xEFCDAB89
    self.s[2] = 0x98BADCFE
    self.s[3] = 0x10325476
    self.n[0] = 0
    self.n[1] = 0
    nil
  }

  # Adds p to the running hash; returns p.size.
  pub def write!(p: [Byte]) -> Int {
    nn = p.size
    self.n[1] = n[1] + nn.as_u64
    nx = n[0].to_i
    off = 0
    if nx > 0 {
      k = BLOCK_SIZE - nx
      k = nn if k > nn
      copy(x[nx...nx + k], p[0...k])
      nx += k
      if nx == BLOCK_SIZE {
        block(s, x, 0, BLOCK_SIZE)
        nx = 0
      }
      off = k
    }
    rest = nn - off
    if rest >= BLOCK_SIZE {
      m = rest & ^(BLOCK_SIZE - 1)
      block(s, p, off, m)
      off += m
    }
    if off < nn {
      nx = nn - off
      copy(x[0...nx], p[off...nn])
    }
    self.n[0] = nx.as_u64
    nn
  }

  # The padded final digest of a copy of the state (Go's checkSum).
  def check_sum -> [Byte] {
    d = clone
    len = d.n[1]
    tmp = [0.as_u8; 72]
    tmp[0] = 0x80
    pad = ((55 - len) % 64).to_i
    bits = len << 3
    j = 0
    while j < 8 {
      tmp[1 + pad + j] = (bits >> (8 * j).as_u64).as_u8
      j += 1
    }
    d.write!(tmp[0...1 + pad + 8])
    panic("d.nx != 0") if d.n[0] != 0
    out: [Byte] = []
    i = 0
    while i < 4 {
      v = d.s[i]
      out << v.as_u8
      out << (v >> 8).as_u8
      out << (v >> 16).as_u8
      out << (v >> 24).as_u8
      i += 1
    }
    out
  }

  # b with the current hash appended. The state is unchanged.
  pub def sum(b: [Byte]) -> [Byte] {
    b + check_sum
  }

  # An independent copy of the hash in its current state.
  pub def clone -> Digest {
    Digest.new(s: s + [], x: x + [], n: n + [])
  }

  # b with the marshaled state appended (Go's AppendBinary).
  pub def append_binary(b: [Byte]) -> [Byte] {
    out = b + MAGIC.bytes.to_a
    i = 0
    while i < 4 {
      out = append_be32(out, s[i])
      i += 1
    }
    nx = n[0].to_i
    out = out + x[0...nx]
    out = out + [0.as_u8; BLOCK_SIZE - nx]
    out = append_be32(out, (n[1] >> 32).as_u32)
    append_be32(out, n[1].as_u32)
  }

  # The marshaled state (Go's MarshalBinary).
  pub def marshal_binary -> [Byte] {
    append_binary([])
  }

  # Restores a state from marshal_binary.
  pub def unmarshal_binary!(b: [Byte]) -> ~Unit<StateError> {
    fail StateError.InvalidIdentifier if !has_magic(b, MAGIC)
    fail StateError.InvalidSize if b.size != MARSHALED_SIZE
    i = 0
    while i < 4 {
      self.s[i] = be32(b, 4 + 4 * i)
      i += 1
    }
    copy(x, b[20...20 + BLOCK_SIZE])
    len = (be32(b, 84).as_u64 << 32) | be32(b, 88).as_u64
    self.n[1] = len
    self.n[0] = len % BLOCK_SIZE.as_u64
  }
}
