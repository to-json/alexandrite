#![overflow(wrap)]
# The MD5 compression function: Go's blockGeneric (itself generated by
# md5/gen.go), round for round, with bits.RotateLeft32 written out.

def le32(q: [Byte], i: Int) -> U32 {
  q[i].as_u32 | (q[i + 1].as_u32 << 8) | (q[i + 2].as_u32 << 16) | (q[i + 3].as_u32 << 24)
}

# Runs the compression function over the 64-byte blocks of
# p[off...off + n] (n a multiple of 64), updating s.
def block(s: [U32], p: [Byte], off: Int, n: Int) {
  a = s[0]
  b = s[1]
  c = s[2]
  d = s[3]
  i = off
  last = off + n
  while i < last {
    q = p[i...i + 64]
    aa = a
    bb = b
    cc = c
    dd = d
    x0 = le32(q, 0)
    x1 = le32(q, 4)
    x2 = le32(q, 8)
    x3 = le32(q, 12)
    x4 = le32(q, 16)
    x5 = le32(q, 20)
    x6 = le32(q, 24)
    x7 = le32(q, 28)
    x8 = le32(q, 32)
    x9 = le32(q, 36)
    xa = le32(q, 40)
    xb = le32(q, 44)
    xc = le32(q, 48)
    xd = le32(q, 52)
    xe = le32(q, 56)
    xf = le32(q, 60)

    # round 1
    t = (((c ^ d) & b) ^ d) + a + x0 + 0xd76aa478
    a = b + ((t << 7) | (t >> 25))
    t = (((b ^ c) & a) ^ c) + d + x1 + 0xe8c7b756
    d = a + ((t << 12) | (t >> 20))
    t = (((a ^ b) & d) ^ b) + c + x2 + 0x242070db
    c = d + ((t << 17) | (t >> 15))
    t = (((d ^ a) & c) ^ a) + b + x3 + 0xc1bdceee
    b = c + ((t << 22) | (t >> 10))
    t = (((c ^ d) & b) ^ d) + a + x4 + 0xf57c0faf
    a = b + ((t << 7) | (t >> 25))
    t = (((b ^ c) & a) ^ c) + d + x5 + 0x4787c62a
    d = a + ((t << 12) | (t >> 20))
    t = (((a ^ b) & d) ^ b) + c + x6 + 0xa8304613
    c = d + ((t << 17) | (t >> 15))
    t = (((d ^ a) & c) ^ a) + b + x7 + 0xfd469501
    b = c + ((t << 22) | (t >> 10))
    t = (((c ^ d) & b) ^ d) + a + x8 + 0x698098d8
    a = b + ((t << 7) | (t >> 25))
    t = (((b ^ c) & a) ^ c) + d + x9 + 0x8b44f7af
    d = a + ((t << 12) | (t >> 20))
    t = (((a ^ b) & d) ^ b) + c + xa + 0xffff5bb1
    c = d + ((t << 17) | (t >> 15))
    t = (((d ^ a) & c) ^ a) + b + xb + 0x895cd7be
    b = c + ((t << 22) | (t >> 10))
    t = (((c ^ d) & b) ^ d) + a + xc + 0x6b901122
    a = b + ((t << 7) | (t >> 25))
    t = (((b ^ c) & a) ^ c) + d + xd + 0xfd987193
    d = a + ((t << 12) | (t >> 20))
    t = (((a ^ b) & d) ^ b) + c + xe + 0xa679438e
    c = d + ((t << 17) | (t >> 15))
    t = (((d ^ a) & c) ^ a) + b + xf + 0x49b40821
    b = c + ((t << 22) | (t >> 10))

    # round 2
    t = (((b ^ c) & d) ^ c) + a + x1 + 0xf61e2562
    a = b + ((t << 5) | (t >> 27))
    t = (((a ^ b) & c) ^ b) + d + x6 + 0xc040b340
    d = a + ((t << 9) | (t >> 23))
    t = (((d ^ a) & b) ^ a) + c + xb + 0x265e5a51
    c = d + ((t << 14) | (t >> 18))
    t = (((c ^ d) & a) ^ d) + b + x0 + 0xe9b6c7aa
    b = c + ((t << 20) | (t >> 12))
    t = (((b ^ c) & d) ^ c) + a + x5 + 0xd62f105d
    a = b + ((t << 5) | (t >> 27))
    t = (((a ^ b) & c) ^ b) + d + xa + 0x02441453
    d = a + ((t << 9) | (t >> 23))
    t = (((d ^ a) & b) ^ a) + c + xf + 0xd8a1e681
    c = d + ((t << 14) | (t >> 18))
    t = (((c ^ d) & a) ^ d) + b + x4 + 0xe7d3fbc8
    b = c + ((t << 20) | (t >> 12))
    t = (((b ^ c) & d) ^ c) + a + x9 + 0x21e1cde6
    a = b + ((t << 5) | (t >> 27))
    t = (((a ^ b) & c) ^ b) + d + xe + 0xc33707d6
    d = a + ((t << 9) | (t >> 23))
    t = (((d ^ a) & b) ^ a) + c + x3 + 0xf4d50d87
    c = d + ((t << 14) | (t >> 18))
    t = (((c ^ d) & a) ^ d) + b + x8 + 0x455a14ed
    b = c + ((t << 20) | (t >> 12))
    t = (((b ^ c) & d) ^ c) + a + xd + 0xa9e3e905
    a = b + ((t << 5) | (t >> 27))
    t = (((a ^ b) & c) ^ b) + d + x2 + 0xfcefa3f8
    d = a + ((t << 9) | (t >> 23))
    t = (((d ^ a) & b) ^ a) + c + x7 + 0x676f02d9
    c = d + ((t << 14) | (t >> 18))
    t = (((c ^ d) & a) ^ d) + b + xc + 0x8d2a4c8a
    b = c + ((t << 20) | (t >> 12))

    # round 3
    t = (b ^ c ^ d) + a + x5 + 0xfffa3942
    a = b + ((t << 4) | (t >> 28))
    t = (a ^ b ^ c) + d + x8 + 0x8771f681
    d = a + ((t << 11) | (t >> 21))
    t = (d ^ a ^ b) + c + xb + 0x6d9d6122
    c = d + ((t << 16) | (t >> 16))
    t = (c ^ d ^ a) + b + xe + 0xfde5380c
    b = c + ((t << 23) | (t >> 9))
    t = (b ^ c ^ d) + a + x1 + 0xa4beea44
    a = b + ((t << 4) | (t >> 28))
    t = (a ^ b ^ c) + d + x4 + 0x4bdecfa9
    d = a + ((t << 11) | (t >> 21))
    t = (d ^ a ^ b) + c + x7 + 0xf6bb4b60
    c = d + ((t << 16) | (t >> 16))
    t = (c ^ d ^ a) + b + xa + 0xbebfbc70
    b = c + ((t << 23) | (t >> 9))
    t = (b ^ c ^ d) + a + xd + 0x289b7ec6
    a = b + ((t << 4) | (t >> 28))
    t = (a ^ b ^ c) + d + x0 + 0xeaa127fa
    d = a + ((t << 11) | (t >> 21))
    t = (d ^ a ^ b) + c + x3 + 0xd4ef3085
    c = d + ((t << 16) | (t >> 16))
    t = (c ^ d ^ a) + b + x6 + 0x04881d05
    b = c + ((t << 23) | (t >> 9))
    t = (b ^ c ^ d) + a + x9 + 0xd9d4d039
    a = b + ((t << 4) | (t >> 28))
    t = (a ^ b ^ c) + d + xc + 0xe6db99e5
    d = a + ((t << 11) | (t >> 21))
    t = (d ^ a ^ b) + c + xf + 0x1fa27cf8
    c = d + ((t << 16) | (t >> 16))
    t = (c ^ d ^ a) + b + x2 + 0xc4ac5665
    b = c + ((t << 23) | (t >> 9))

    # round 4
    t = (c ^ (b | ^d)) + a + x0 + 0xf4292244
    a = b + ((t << 6) | (t >> 26))
    t = (b ^ (a | ^c)) + d + x7 + 0x432aff97
    d = a + ((t << 10) | (t >> 22))
    t = (a ^ (d | ^b)) + c + xe + 0xab9423a7
    c = d + ((t << 15) | (t >> 17))
    t = (d ^ (c | ^a)) + b + x5 + 0xfc93a039
    b = c + ((t << 21) | (t >> 11))
    t = (c ^ (b | ^d)) + a + xc + 0x655b59c3
    a = b + ((t << 6) | (t >> 26))
    t = (b ^ (a | ^c)) + d + x3 + 0x8f0ccc92
    d = a + ((t << 10) | (t >> 22))
    t = (a ^ (d | ^b)) + c + xa + 0xffeff47d
    c = d + ((t << 15) | (t >> 17))
    t = (d ^ (c | ^a)) + b + x1 + 0x85845dd1
    b = c + ((t << 21) | (t >> 11))
    t = (c ^ (b | ^d)) + a + x8 + 0x6fa87e4f
    a = b + ((t << 6) | (t >> 26))
    t = (b ^ (a | ^c)) + d + xf + 0xfe2ce6e0
    d = a + ((t << 10) | (t >> 22))
    t = (a ^ (d | ^b)) + c + x6 + 0xa3014314
    c = d + ((t << 15) | (t >> 17))
    t = (d ^ (c | ^a)) + b + xd + 0x4e0811a1
    b = c + ((t << 21) | (t >> 11))
    t = (c ^ (b | ^d)) + a + x4 + 0xf7537e82
    a = b + ((t << 6) | (t >> 26))
    t = (b ^ (a | ^c)) + d + xb + 0xbd3af235
    d = a + ((t << 10) | (t >> 22))
    t = (a ^ (d | ^b)) + c + x2 + 0x2ad7d2bb
    c = d + ((t << 15) | (t >> 17))
    t = (d ^ (c | ^a)) + b + x9 + 0xeb86d391
    b = c + ((t << 21) | (t >> 11))

    a += aa
    b += bb
    c += cc
    d += dd
    i += 64
  }
  s[0] = a
  s[1] = b
  s[2] = c
  s[3] = d
  nil
}
