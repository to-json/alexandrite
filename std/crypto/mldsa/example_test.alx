import "crypto/rand"

# Go's crypto/mldsa/example_test.go.

example "mldsa" {
  # The signer generates a new ML-DSA-44 key pair.
  sk = generate_key(mldsa44()).unwrap

  # The signer publishes the public key encoding.
  public_key = sk.public_key.bytes
  puts "public key: #{public_key.size} bytes"

  # The signer signs a message and publishes the signature.
  msg = "hello, world".bytes.to_a
  sig = sk.sign_options(rand.reader(), msg, Options.new(context: "example")).unwrap
  puts "signature: #{sig.size} bytes"

  # The verifier reconstructs the public key and checks the signature. The
  # context string must match the one used by the signer.
  pk = new_public_key(mldsa44(), public_key).unwrap
  verify(pk, msg, sig, Options.new(context: "example")).unwrap
} outputs "public key: 1312 bytes\nsignature: 2420 bytes\n"
