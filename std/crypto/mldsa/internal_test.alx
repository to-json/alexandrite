test "ACVPRejectionKATs" {
  for tc in acvp_cases() {
    priv = new_private_key(tc.params, from_hex(tc.seed)).unwrap
    trace = [0, 0, 0, 0]
    pk = priv.public_key.bytes
    sk = testing_only_private_key_semi_expanded_bytes(priv)
    assert sha256_of(pk + sk) == from_hex(tc.key_hash), "#{tc.name}: key hash"

    pub = new_public_key(tc.params, pk).unwrap
    assert pub.equal?(priv.public_key), "#{tc.name}: parsed public key not equal"
    assert pub == priv.public_key, "#{tc.name}: parsed public key not identical"

    # the table gives a Sign_internal input, part of the pre-image of μ
    h = sha3.new_shake256()
    h.write!(compute_public_key_hash(pk)).unwrap
    h.write!(from_hex(tc.msg)).unwrap
    mu = [0.as_u8; 64]
    h.read!(mu)
    sig = sign_internal(priv, mu, [0.as_u8; 32], trace)
    assert sig == sk_sign_external_mu_det(priv, mu), "#{tc.name}: SignExternalMuDeterministic"
    assert sha256_of(sig) == from_hex(tc.sig_hash), "#{tc.name}: signature hash"
    assert verify_external_mu(priv.public_key, mu, sig).ok?, "#{tc.name}: verify"
    assert verify_external_mu(priv.public_key, [0.as_u8; 64], sig).err?, "#{tc.name}: verify passed on wrong message"

    if strings.has_prefix(tc.name, "Path/") {
      # path coverage: all rejection reasons were hit (ct0 only for ML-DSA-44)
      assert trace[REJECT_Z] > 0, "#{tc.name}: z rejection not hit"
      assert trace[REJECT_R0] > 0, "#{tc.name}: r0 rejection not hit"
      assert trace[REJECT_H] > 0, "#{tc.name}: h rejection not hit"
      if tc.params == mldsa44() {
        assert trace[REJECT_CT0] > 0, "#{tc.name}: ct0 rejection not hit"
      }
    }
  }
}

def sk_sign_external_mu_det(priv: PrivateKey, mu: [Byte]) -> [Byte] {
  priv.sign_deterministic(mu, crypto.MLDSAMu).unwrap
}

test "CASTRejectionPaths" {
  trace = [0, 0, 0, 0]
  fips140_cast(trace).unwrap
  assert trace[REJECT_Z] > 0, "z rejection not hit"
  assert trace[REJECT_R0] > 0, "r0 rejection not hit"
  assert trace[REJECT_CT0] > 0, "ct0 rejection not hit"
  assert trace[REJECT_H] > 0, "h rejection not hit"
}

bench "CAST/ML-DSA-44" {
  fips140_cast([]).unwrap
}

bench "CAST/ML-DSA-65" {
  # TestACVPRejectionKATs's Path/ML-DSA-65/4 inputs, the only one covering
  # all three rejection paths
  seed = from_hex("F215BA2280D86F142012FC05FFC04F2C7D22FF5DD7D69AA0EFB081E3A53E9318")
  mu = from_hex("35cdb7dddbed44af4641bac659f46598ed769ea9693fd4ed2152b84c45811d2e" +
      "66eded1eb20cde1c1f4b82642a330d8e86ac432a2aefaa56cd9b2b5f4affd450")
  sk_hash = from_hex("2e6f5ff659310b8ca1457a65d8b448b297a905dc08e06c1246a97daad0af6f7d")
  sig_hash = from_hex("c027d21b21fa75abe7f35cd84a54e2e83bd352140bc8c49eab2c45004e7268a7")
  priv = new_private_key(mldsa65(), seed).unwrap
  panic("sk hash mismatch") if sha256_of(testing_only_private_key_semi_expanded_bytes(priv)) != sk_hash
  sig = priv.sign_deterministic(mu, crypto.MLDSAMu).unwrap
  panic("sig hash mismatch") if sha256_of(sig) != sig_hash
  verify_external_mu(priv.public_key, mu, sig).unwrap
}
