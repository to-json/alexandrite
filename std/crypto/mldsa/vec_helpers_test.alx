import "bytes"
import "crypto"

# The checks behind vec_mldsa_test.alx (vectors generated from Go's
# crypto/mldsa). Hex arguments; signatures, public keys and semi-expanded
# keys are compared by SHA-256 (sha256_hex, wycheproof_test.alx).

# Key generation from a seed: the public key and the semi-expanded key.
def kg(params: Parameters, seed: Str, pk_hash: Str, sk_hash: Str) {
  k = new_private_key(params, dh(seed)).unwrap
  assert sha256_hex(k.public_key.bytes) == pk_hash, "keygen #{seed}: public key"
  assert sha256_hex(testing_only_private_key_semi_expanded_bytes(k)) == sk_hash, "keygen #{seed}: semi-expanded key"
}

# Deterministic signing with a context, then verification.
def sd(params: Parameters, seed: Str, msg: Str, c: Str, sig_hash: Str) {
  k = new_private_key(params, dh(seed)).unwrap
  opts = Options.new(context: Str.from_bytes(dh(c)))
  sig = k.sign_deterministic_options(dh(msg), opts).unwrap
  assert sha256_hex(sig) == sig_hash, "sign_deterministic #{seed}"
  assert verify(k.public_key, dh(msg), sig, opts).ok?, "verify #{seed}"
}

# Hedged signing with the randomness rnd: through the test hook and
# through sign_options reading rnd from a reader.
def sh(params: Parameters, seed: Str, msg: Str, c: Str, rnd: Str, sig_hash: Str) {
  k = new_private_key(params, dh(seed)).unwrap
  opts = Options.new(context: Str.from_bytes(dh(c)))
  sig = testing_only_sign_with_random(k, dh(msg), opts.context, dh(rnd)).unwrap
  assert sha256_hex(sig) == sig_hash, "sign hedged #{seed}"
  sig = k.sign_options(bytes.new_buffer(dh(rnd)), dh(msg), opts).unwrap
  assert sha256_hex(sig) == sig_hash, "sign_options #{seed}"
  assert verify(k.public_key, dh(msg), sig, opts).ok?, "verify #{seed}"
}

# External μ signing with the randomness rnd (zero: deterministic).
def sm(params: Parameters, seed: Str, mu: Str, rnd: Str, sig_hash: Str) {
  k = new_private_key(params, dh(seed)).unwrap
  sig = testing_only_sign_external_mu_with_random(k, dh(mu), dh(rnd)).unwrap
  assert sha256_hex(sig) == sig_hash, "sign external mu #{seed}"
  sig = k.sign(bytes.new_buffer(dh(rnd)), dh(mu), crypto.MLDSAMu).unwrap
  assert sha256_hex(sig) == sig_hash, "sign(MLDSAMu) #{seed}"
  if dh(rnd) == [0.as_u8; 32] {
    sig = k.sign_deterministic(dh(mu), crypto.MLDSAMu).unwrap
    assert sha256_hex(sig) == sig_hash, "sign_deterministic(MLDSAMu) #{seed}"
  }
  assert verify_external_mu(k.public_key, dh(mu), sig).ok?, "verify external mu #{seed}"
}

# Verification of sig with byte pos xored with x: Go's error ("" if valid).
def vm(pk: PublicKey, sig: [Byte], pos: Int, x: Int, want: Str) {
  m = sig + []
  m[pos] = m[pos] ^ x.as_u8
  r = verify(pk, "verify me".bytes.to_a, m, Options.new)
  got = r.err? ? r.err.unwrap.message : ""
  assert got == want, "verify with byte #{pos} ^ #{x}: got \"#{got}\", want \"#{want}\""
}

# A semi-expanded key with byte pos xored with x: Go's error, or the hash
# of the public key.
def se(sk: [Byte], pos: Int, x: Int, want: Str) {
  m = sk + []
  m[pos] = m[pos] ^ x.as_u8
  r = testing_only_new_private_key_from_semi_expanded(m)
  got = r.err? ? r.err.unwrap.message : sha256_hex(r.unwrap.public_key.bytes)
  assert got == want, "semi-expanded key with byte #{pos} ^ #{x}: got \"#{got}\", want \"#{want}\""
}
