test "Go/semi_expanded_mutated/ML-DSA-87" {
  sk = d64("")
  se(sk, 0, 0, "7c28b97627510b0bde77410db8c36f8b4ee4686eb3c8dfd13ae30621363c2d78")
  se(sk, 10, 220, "mldsa: semi-expanded private key inconsistent with t0")
  se(sk, 24, 53, "mldsa: semi-expanded private key inconsistent with t0")
