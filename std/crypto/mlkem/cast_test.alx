# Go's crypto/internal/fips140/mlkem/cast.go: the known-answer self-test
# Go runs on first use in FIPS 140 mode (a test here).

def seq(from: Int, n: Int) -> [Byte] {
  out: [Byte] = []
  i = 0
  while i < n {
    out << (from + i).as_u8
    i += 1
  }
  out
}

test "CAST ML-KEM-768" {
  d = seq(0x01, 32)
  z = seq(0x21, 32)
  m = seq(0x41, 32)
  want: [Byte] = [
    0x55, 0x01, 0xfc, 0x52, 0x3b, 0x74, 0x5f, 0x41, 0x76, 0x2a, 0x18, 0x8d, 0xe4, 0x4a, 0x59, 0xb9,
    0x20, 0xf4, 0x30, 0x14, 0x62, 0x04, 0xee, 0x4e, 0x79, 0x37, 0x32, 0x39, 0x6d, 0xf7, 0xaa, 0x48
  ]
  dk = kem_key_gen(K768, d, z)
  ke, c = kem_encaps(dk.ek, m)
  kd = kem_decaps(dk, c)
  assert_eq ke, want
  assert_eq kd, want
}
