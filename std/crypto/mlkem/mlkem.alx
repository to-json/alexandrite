#![overflow(wrap)]
# Package mlkem: Go's crypto/mlkem, the quantum-resistant key encapsulation
# method ML-KEM (formerly known as Kyber), as specified in NIST FIPS 203,
# with Go's crypto/internal/fips140/mlkem merged in (field.alx is its
# field.go) and the derandomized entry points of crypto/mlkem/mlkemtest as
# public test hooks. Pure alx.
#
# Most applications should use the ML-KEM-768 parameter set, as implemented
# by DecapsulationKey768 and EncapsulationKey768.
#
#   Go                                        alx
#   mlkem.SharedKeySize / SeedSize            SHARED_KEY_SIZE / SEED_SIZE
#   mlkem.CiphertextSize768 / 1024            CIPHERTEXT_SIZE768 / CIPHERTEXT_SIZE1024
#   mlkem.EncapsulationKeySize768 / 1024      ENCAPSULATION_KEY_SIZE768 / ENCAPSULATION_KEY_SIZE1024
#   GenerateKey768() (*DK768, error)          generate_key768() -> DecapsulationKey768 (never fails)
#   NewDecapsulationKey768(seed) (*DK, error) new_decapsulation_key768(seed) -> ~DecapsulationKey768
#   NewEncapsulationKey768(b) (*EK, error)    new_encapsulation_key768(b) -> ~EncapsulationKey768
#   dk.Bytes() / dk.EncapsulationKey()        dk.bytes / dk.encapsulation_key
#   dk.Encapsulator() crypto.Encapsulator     dk.encapsulator -> crypto.Encapsulator
#   dk.Decapsulate(c) ([]byte, error)         dk.decapsulate(c) -> ~[Byte]
#   ek.Bytes() / ek.Encapsulate() (K, c)      ek.bytes / ek.encapsulate -> ([Byte], [Byte])
#   (the same with 1024)
#   mlkemtest.Encapsulate768(ek, random)      encapsulate768(ek, random) -> ~([Byte], [Byte]) (test hook)
#   mlkemtest.Encapsulate1024(ek, random)     encapsulate1024(ek, random) -> ~([Byte], [Byte]) (test hook)
#   fips140/mlkem.GenerateKeyInternal768(d,z) generate_key_internal768(d, z) (test hook)
#   fips140/mlkem.TestingOnlyExpandedBytes768 testing_only_expanded_bytes768(dk) (test hook)
#   fips140/mlkem.TestingOnlyNewDecapsulationKey768(b)
#                                             testing_only_new_decapsulation_key768(b) (test hook)
#   (the same with 1024)
#
# DecapsulationKey768/1024 are crypto.Decapsulators and EncapsulationKey768/
# 1024 are crypto.Encapsulators (the interfaces are structural; the shapes
# match Go's: bytes, encapsulate -> (shared key, ciphertext), encapsulator,
# decapsulate -> ~[Byte]).
#
# The test hooks are what Go's own tests (and ACVP testing) use; they must
# only be used for known-answer tests. Go keeps them out of the public API
# (an internal package and crypto/mlkem/mlkemtest); alx has no internal
# packages, so they are public functions of this package.
#
# ML-KEM-1024: Go generates mlkem1024.go from mlkem768.go by renaming
# identifiers (generate1024.go), so the two parameter sets have separate but
# identical code with k = 3 or 4 and the ciphertext compression (du, dv) =
# (10, 4) or (11, 5). Here one implementation (EncKey / DecKey and the kem_*
# and pke_* functions) takes k from the key, and the public types for each
# parameter set wrap it. The loops over k were never unrolled in Go either,
# so the only cost is the choice of the du/dv encoders, once per polynomial.
#
# Timing: all operations on secret data are constant time in Go's sense
# (see field.alx's header): implicit rejection in decapsulate selects the
# key with crypto/subtle.constant_time_copy, with no branch on the
# comparison. alx compiles to C or JIT code, which doesn't promise what Go's
# compiler does (see crypto/subtle's header).
#
# Differences from Go:
#   - generate_key768/1024 return the key, not (key, error): they can't
#     fail (Go's error is always nil). They and encapsulate read
#     crypto/rand directly (Go reads its DRBG; Go's API takes no rand).
#   - Keys are structs whose polynomials live in slices (shared storage), so
#     copies of a key share them, like Go's pointers; keys are never
#     modified after they are made.
#   - No FIPS 140 self-test (Go's CAST on first use, cast.go) and no
#     pairwise consistency test after key generation (Go's fips140.PCT, run
#     only in FIPS 140 mode): alx has no FIPS 140 module. cast.go's
#     known-answer test is a test here (mlkem_test.alx), and the PCT is the
#     round trip the tests do. No fips140only mode check in the mlkemtest
#     hooks (alx has none).
#   - mlkemtest's "failed to reconstruct key" error can't happen (it would
#     need an EncapsulationKey whose bytes don't parse), so the hooks
#     encapsulate with the key itself.
#   - testing_only_new_decapsulation_key768/1024 make the unused seed d
#     with crypto/rand, as Go does with its DRBG.
#   - Errors are MlkemError values with Go's messages.
#
# Tests: Go's mlkem_test.go (TestAccumulated with Go's -short count 100
# and default 10000; the -million flag's count is not run), field_test.go
# (random ring elements from crypto/rand: no math/rand/v2), example_test.go
# and cast.go's known answer are translated; BenchmarkRoundTrip's
# Alice/Bob halves are not (they are KeyGen + Decaps and Encaps, which are
# benchmarked). mlkem_wycheproof_test.go's checks run on the Wycheproof
# vectors converted by a generator (vec_wycheproof*_test.alx): all keygen
# and semi-expanded vectors, and a subset of the encaps and decaps ones
# (every kind of invalid vector, fewer valid ones), with large expected
# outputs compared by SHA3-256 and wrong-length inputs kept by length.
# vec_mlkem_test.alx has 200 more known answers generated with Go.

import "crypto"
import "crypto/rand"
import "crypto/sha3"
import "crypto/subtle"

# The size of a shared key produced by ML-KEM.
pub SHARED_KEY_SIZE = 32
# The size of a seed used to generate a decapsulation key.
pub SEED_SIZE = 64
# The size of a ciphertext produced by ML-KEM-768.
pub CIPHERTEXT_SIZE768 = 1088
# The size of an ML-KEM-768 encapsulation key.
pub ENCAPSULATION_KEY_SIZE768 = 1184
# The size of an ML-KEM-1024 ciphertext.
pub CIPHERTEXT_SIZE1024 = 1568
# The size of an ML-KEM-1024 encapsulation key.
pub ENCAPSULATION_KEY_SIZE1024 = 1568

# The expanded NIST encoding of a decapsulation key (Go's
# decapsulationKeySize768/1024): k*384 + (k*384 + 32) + 32 + 32.
DECAPSULATION_KEY_SIZE768 = 2400
DECAPSULATION_KEY_SIZE1024 = 3168

# ML-KEM-768 and ML-KEM-1024's module dimensions.
K768 = 3
K1024 = 4

# Errors of the constructors, decapsulate and the test hooks.
pub error MlkemError {
  InvalidSeedLength
  InvalidEncapsulationKeyLength
  InvalidPolynomialEncoding
  InvalidCiphertextLength
  # mlkemtest's Encapsulate768/1024 with random not 32 bytes long.
  InvalidRandomLength(name: Str)
  # testing_only_new_decapsulation_key768/1024's errors.
  InvalidNistKeyLength
  InvalidSecretKeyEncoding
  InconsistentHash

  def message -> Str {
    case self {
      InvalidSeedLength => "mlkem: invalid seed length"
      InvalidEncapsulationKeyLength => "mlkem: invalid encapsulation key length"
      InvalidPolynomialEncoding => "mlkem: invalid polynomial encoding"
      InvalidCiphertextLength => "mlkem: invalid ciphertext length"
      InvalidRandomLength(name) => "mlkemtest: #{name}: random must be 32 bytes"
      InvalidNistKeyLength => "mlkem: invalid NIST decapsulation key length"
      InvalidSecretKeyEncoding => "mlkem: invalid secret key encoding"
      InconsistentHash => "mlkem: inconsistent H(ek) in encoded bytes"
    }
  }
}

# ---------------------------------------------------------------------------
# ML-KEM-768

# The public key used to produce ciphertexts to be decapsulated by the
# corresponding DecapsulationKey768.
pub struct EncapsulationKey768 {
  key: EncKey

  # The encapsulation key as a byte slice.
  pub def bytes -> [Byte] { key.bytes }

  # A shared key and an associated ciphertext from this encapsulation key,
  # drawing random bytes from crypto/rand. The shared key must be kept
  # secret.
  #
  # For testing, derandomized encapsulation is encapsulate768.
  pub def encapsulate -> ([Byte], [Byte]) { key.encapsulate }
}

# The secret key used to decapsulate a shared key from a ciphertext. It
# includes various precomputed values.
pub struct DecapsulationKey768 {
  key: DecKey

  # The decapsulation key as a 64-byte seed in the "d || z" form. The
  # decapsulation key must be kept secret.
  pub def bytes -> [Byte] { key.bytes }

  # The shared key from a ciphertext. If the ciphertext is not the correct
  # length, it fails. A ciphertext that is the correct length but otherwise
  # invalid gives a shared key that does not match the sender's, according
  # to FIPS 203. The shared key must be kept secret.
  pub def decapsulate(ciphertext: [Byte]) -> ~[Byte] { ~key.decapsulate(ciphertext) }

  # The public encapsulation key necessary to produce ciphertexts.
  pub def encapsulation_key -> EncapsulationKey768 { EncapsulationKey768.new(key: key.ek) }

  # The encapsulation key, like encapsulation_key (crypto.Decapsulator).
  pub def encapsulator -> crypto.Encapsulator { encapsulation_key }
}

# A new decapsulation key, drawing random bytes from crypto/rand. The
# decapsulation key must be kept secret.
pub def generate_key768 -> DecapsulationKey768 {
  DecapsulationKey768.new(key: generate_key(K768))
}

# Expands a decapsulation key from a 64-byte seed in the "d || z" form. The
# seed must be uniformly random.
pub def new_decapsulation_key768(seed: [Byte]) -> ~DecapsulationKey768<MlkemError> {
  DecapsulationKey768.new(key: ~new_key_from_seed(K768, seed))
}

# Parses an encapsulation key from its encoded form; fails if it is not
# valid.
pub def new_encapsulation_key768(encapsulation_key: [Byte]) -> ~EncapsulationKey768<MlkemError> {
  EncapsulationKey768.new(key: ~parse_ek(K768, encapsulation_key))
}

# Test hook (Go's crypto/mlkem/mlkemtest.Encapsulate768): derandomized
# ML-KEM-768 encapsulation (ML-KEM.Encaps_internal from FIPS 203) with ek
# and 32 bytes of randomness. Returns (shared key, ciphertext). It must only
# be used for known-answer tests.
pub def encapsulate768(ek: EncapsulationKey768, random: [Byte]) -> ~([Byte], [Byte])<MlkemError> {
  fail MlkemError.InvalidRandomLength(name: "Encapsulate768") if random.size != 32
  kem_encaps(ek.key, random)
}

# Test hook (Go's fips140/mlkem.GenerateKeyInternal768): a derandomized
# generate_key768, from the 32-byte seeds d and z.
pub def generate_key_internal768(d: [Byte], z: [Byte]) -> DecapsulationKey768 {
  DecapsulationKey768.new(key: kem_key_gen(K768, d, z))
}

# Test hook (Go's fips140/mlkem.TestingOnlyExpandedBytes768): the
# decapsulation key in the full expanded NIST encoding. Only for ACVP
# testing; otherwise use bytes, which returns the (much smaller) seed.
pub def testing_only_expanded_bytes768(dk: DecapsulationKey768) -> [Byte] {
  dk.key.expanded_bytes
}

# Test hook (Go's fips140/mlkem.TestingOnlyNewDecapsulationKey768): parses
# a decapsulation key from its expanded NIST format. `bytes` must not be
# called on the result: it doesn't give the original seed. Only for ACVP
# testing; otherwise use new_decapsulation_key768.
pub def testing_only_new_decapsulation_key768(b: [Byte]) -> ~DecapsulationKey768<MlkemError> {
  DecapsulationKey768.new(key: ~parse_expanded_dk(K768, b))
}

# ---------------------------------------------------------------------------
# ML-KEM-1024

