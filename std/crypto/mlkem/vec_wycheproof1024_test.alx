test "Wycheproof semi-expanded decaps 1024 0" {
  # tcId 1 valid [] Valid decapsulation key and ciphertext
  ~wp_semi1024("", "9f62e8c88195d7ad50b14514fbe94a887554204da7a40dafbe72c5e15d39e969", "", "760a9793cd6c81c3cdeb8c679ae7f5741caaa97452898345fc081fef29069885")
  # tcId 2 invalid [IncorrectCiphertextLength] Ciphertext too short (1567 bytes instead of 1568)
  ~wp_semi_bad_ct1024("", "9f62e8c88195d7ad50b14514fbe94a887554204da7a40dafbe72c5e15d39e969", 1567)
  # tcId 3 invalid [IncorrectCiphertextLength] Ciphertext too long (1569 bytes instead of 1568)
  ~wp_semi_bad_ct1024("", "9f62e8c88195d7ad50b14514fbe94a887554204da7a40dafbe72c5e15d39e969", 1569)
  # tcId 4 invalid [IncorrectDecapsulationKeyLength] Decapsulation key too short (3167 bytes instead of 3168)
  wp_semi_bad_dk_len1024(3167)
  # tcId 5 invalid [IncorrectDecapsulationKeyLength] Decapsulation key too long (3169 bytes instead of 3168)
  wp_semi_bad_dk_len1024(3169)
  # tcId 6 invalid [InvalidDecapsulationKey] Decapsulation key with corrupted hash
  wp_semi_invalid1024("")
  # tcId 7 invalid [InvalidDecapsulationKey] Decapsulation key with corrupted embedded encapsulation key
  wp_semi_invalid1024("")
  # tcId 8 valid [MalleableCiphertext] Decapsulation key with last byte of c1 zeroed that makes decapsulation succeed on faulty c1 re-encryption comparison
  ~wp_semi1024("", "b3cab47589ca2db792411b9616243808e7fe212c60f0df84ad08b4f35a4aa0db", "", "d9d98fbe4d6bbaf87a48b1816e002913c49268e3385316e7bd463ca557579750")
  # tcId 9 valid [MalleableCiphertext] Decapsulation key with last byte of c2 zeroed that makes decapsulation succeed on faulty c2 re-encryption comparison
  ~wp_semi1024("", "6122b11de33af6ae7f7fc992ebe5ec4060e698ceaf0960977635d17de8892ba0", "", "57a213cc4c7696fce8f693ab59942db5fa407dbc11ecb087671fd990db5711f1")
}
