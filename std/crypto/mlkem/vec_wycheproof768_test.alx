test "Wycheproof semi-expanded decaps 768 0" {
  # tcId 1 valid [] Valid decapsulation key and ciphertext
  ~wp_semi768("", "07f81a8b0e266a3ee92d3a63cdae5cff921905544c9dd797a849e1d054180eca", "", "b4d29cd55bab43e16554b74b9098cdfce583996c968bcd2cfd1ad9455e351fbf")
  # tcId 2 invalid [IncorrectCiphertextLength] Ciphertext too short (1087 bytes instead of 1088)
  ~wp_semi_bad_ct768("", "07f81a8b0e266a3ee92d3a63cdae5cff921905544c9dd797a849e1d054180eca", 1087)
  # tcId 3 invalid [IncorrectCiphertextLength] Ciphertext too long (1089 bytes instead of 1088)
  ~wp_semi_bad_ct768("", "07f81a8b0e266a3ee92d3a63cdae5cff921905544c9dd797a849e1d054180eca", 1089)
  # tcId 4 invalid [IncorrectDecapsulationKeyLength] Decapsulation key too short (2399 bytes instead of 2400)
  wp_semi_bad_dk_len768(2399)
  # tcId 5 invalid [IncorrectDecapsulationKeyLength] Decapsulation key too long (2401 bytes instead of 2400)
  wp_semi_bad_dk_len768(2401)
  # tcId 6 invalid [InvalidDecapsulationKey] Decapsulation key with corrupted hash
  wp_semi_invalid768("")
  # tcId 7 invalid [InvalidDecapsulationKey] Decapsulation key with corrupted embedded encapsulation key
  wp_semi_invalid768("")
  # tcId 8 valid [MalleableCiphertext] Decapsulation key with last byte of c1 zeroed that makes decapsulation succeed on faulty c1 re-encryption comparison
  ~wp_semi768("", "aeb1be60330d587992ad3e6cfdeeefc8dcda7fa0cbf60e261187bbe91badc121", "", "d42569896ab22ea9d6d53da67e3628c8d9388b58b8f29bbb48b38fa146e0098c")
  # tcId 9 valid [MalleableCiphertext] Decapsulation key with last byte of c2 zeroed that makes decapsulation succeed on faulty c2 re-encryption comparison
  ~wp_semi768("", "72ca34a9412795ff5b9dd0a03cebfe80f975167a441d890eaa0ee0768e019fc7", "", "1636a6601f2d227addc5c5599cef70b503a94c4226a68924b184deb0cb89423f")
}
