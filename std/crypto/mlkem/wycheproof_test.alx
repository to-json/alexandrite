# Go's crypto/mlkem/mlkem_wycheproof_test.go: the checks of runKeyGenTest,
# runEncapsTest, runDecapsTest and runSemiExpandedDecapsTest, called by the
# generated vec_wycheproof768_test.alx and vec_wycheproof1024_test.alx with
# the Wycheproof vectors (trimmed: see the generator's comments there; large
# expected outputs are compared by their SHA3-256).

import "crypto/sha3"
import "encoding/hex"

def hx(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

def sha(b: [Byte]) -> Str { hex.encode_to_string(sha3.sum256(b).to_a) }

# runKeyGenTest.
def wp_keygen768(seed_hex: Str, ek_hash: Str, dk_hash: Str) -> ~Unit {
  seed = hx(seed_hex)
  dk = ~new_decapsulation_key768(seed)
  assert_eq dk.bytes, seed
  ek = dk.encapsulation_key
  assert_eq sha(ek.bytes), ek_hash
  assert_eq sha(testing_only_expanded_bytes768(dk)), dk_hash
  ek2 = ~new_encapsulation_key768(ek.bytes)
  assert_eq ek2.bytes, ek.bytes
  k, c = ek.encapsulate
  assert_eq ~dk.decapsulate(c), k
}

def wp_keygen1024(seed_hex: Str, ek_hash: Str, dk_hash: Str) -> ~Unit {
  seed = hx(seed_hex)
  dk = ~new_decapsulation_key1024(seed)
  assert_eq dk.bytes, seed
  ek = dk.encapsulation_key
  assert_eq sha(ek.bytes), ek_hash
  assert_eq sha(testing_only_expanded_bytes1024(dk)), dk_hash
  ek2 = ~new_encapsulation_key1024(ek.bytes)
  assert_eq ek2.bytes, ek.bytes
  k, c = ek.encapsulate
  assert_eq ~dk.decapsulate(c), k
}

# runEncapsTest, a vector that should pass.
def wp_encaps768(ek_hex: Str, m_hex: Str, c_hash: Str, k_hex: Str) -> ~Unit {
  ek_bytes = hx(ek_hex)
  ek = ~new_encapsulation_key768(ek_bytes)
  assert_eq ek.bytes, ek_bytes
  k, c = ~encapsulate768(ek, hx(m_hex))
  assert_eq sha(c), c_hash
  assert_eq hex.encode_to_string(k), k_hex
}

def wp_encaps1024(ek_hex: Str, m_hex: Str, c_hash: Str, k_hex: Str) -> ~Unit {
  ek_bytes = hx(ek_hex)
  ek = ~new_encapsulation_key1024(ek_bytes)
  assert_eq ek.bytes, ek_bytes
  k, c = ~encapsulate1024(ek, hx(m_hex))
  assert_eq sha(c), c_hash
  assert_eq hex.encode_to_string(k), k_hex
}

# runEncapsTest, a vector that should fail (all of them fail parsing the
# encapsulation key: its modulus check).
def wp_encaps_invalid768(ek_hex: Str, m_hex: Str) {
  assert hx(m_hex).size == 32, "m"
  assert !new_encapsulation_key768(hx(ek_hex)).ok?, "invalid encapsulation key accepted"
}

def wp_encaps_invalid1024(ek_hex: Str, m_hex: Str) {
  assert hx(m_hex).size == 32, "m"
  assert !new_encapsulation_key1024(hx(ek_hex)).ok?, "invalid encapsulation key accepted"
}

# runDecapsTest, a vector that should pass.
def wp_decaps768(seed_hex: Str, c_hex: Str, k_hex: Str, ek_hash: Str) -> ~Unit {
  seed = hx(seed_hex)
  dk = ~new_decapsulation_key768(seed)
  assert_eq dk.bytes, seed
  assert_eq sha(dk.encapsulation_key.bytes), ek_hash if ek_hash != ""
  k = ~dk.decapsulate(hx(c_hex))
  assert_eq hex.encode_to_string(k), k_hex
  k_fresh, c_fresh = dk.encapsulation_key.encapsulate
  assert_eq ~dk.decapsulate(c_fresh), k_fresh
}

def wp_decaps1024(seed_hex: Str, c_hex: Str, k_hex: Str, ek_hash: Str) -> ~Unit {
  seed = hx(seed_hex)
  dk = ~new_decapsulation_key1024(seed)
  assert_eq dk.bytes, seed
  assert_eq sha(dk.encapsulation_key.bytes), ek_hash if ek_hash != ""
  k = ~dk.decapsulate(hx(c_hex))
  assert_eq hex.encode_to_string(k), k_hex
  k_fresh, c_fresh = dk.encapsulation_key.encapsulate
  assert_eq ~dk.decapsulate(c_fresh), k_fresh
}

# runDecapsTest, a seed of the wrong length.
def wp_decaps_bad_seed768(seed_hex: Str) {
  assert !new_decapsulation_key768(hx(seed_hex)).ok?, "bad seed accepted"
}

def wp_decaps_bad_seed1024(seed_hex: Str) {
  assert !new_decapsulation_key1024(hx(seed_hex)).ok?, "bad seed accepted"
}

# runDecapsTest, a ciphertext of the wrong length (n bytes).
def wp_decaps_bad_ct768(seed_hex: Str, n: Int) -> ~Unit {
  dk = ~new_decapsulation_key768(hx(seed_hex))
  assert !dk.decapsulate([0.as_u8; n]).ok?, "bad ciphertext length accepted"
}

def wp_decaps_bad_ct1024(seed_hex: Str, n: Int) -> ~Unit {
  dk = ~new_decapsulation_key1024(hx(seed_hex))
  assert !dk.decapsulate([0.as_u8; n]).ok?, "bad ciphertext length accepted"
}

# runSemiExpandedDecapsTest, a vector that should pass.
def wp_semi768(dk_hex: Str, ek_hash: Str, c_hex: Str, k_hex: Str) -> ~Unit {
  dk_bytes = hx(dk_hex)
  dk = ~testing_only_new_decapsulation_key768(dk_bytes)
  assert_eq testing_only_expanded_bytes768(dk), dk_bytes
  assert_eq sha(dk.encapsulation_key.bytes), ek_hash
  k = ~dk.decapsulate(hx(c_hex))
  assert_eq hex.encode_to_string(k), k_hex
}

def wp_semi1024(dk_hex: Str, ek_hash: Str, c_hex: Str, k_hex: Str) -> ~Unit {
  dk_bytes = hx(dk_hex)
  dk = ~testing_only_new_decapsulation_key1024(dk_bytes)
  assert_eq testing_only_expanded_bytes1024(dk), dk_bytes
  assert_eq sha(dk.encapsulation_key.bytes), ek_hash
  k = ~dk.decapsulate(hx(c_hex))
  assert_eq hex.encode_to_string(k), k_hex
}

# runSemiExpandedDecapsTest, a key that must not parse.
def wp_semi_invalid768(dk_hex: Str) {
  assert !testing_only_new_decapsulation_key768(hx(dk_hex)).ok?, "invalid key accepted"
}

def wp_semi_invalid1024(dk_hex: Str) {
  assert !testing_only_new_decapsulation_key1024(hx(dk_hex)).ok?, "invalid key accepted"
}

# runSemiExpandedDecapsTest, a key of the wrong length (n bytes).
def wp_semi_bad_dk_len768(n: Int) {
  assert !testing_only_new_decapsulation_key768([0.as_u8; n]).ok?, "bad key length accepted"
}

def wp_semi_bad_dk_len1024(n: Int) {
  assert !testing_only_new_decapsulation_key1024([0.as_u8; n]).ok?, "bad key length accepted"
}

# runSemiExpandedDecapsTest, a ciphertext of the wrong length (n bytes).
def wp_semi_bad_ct768(dk_hex: Str, ek_hash: Str, n: Int) -> ~Unit {
  dk_bytes = hx(dk_hex)
  dk = ~testing_only_new_decapsulation_key768(dk_bytes)
  assert_eq testing_only_expanded_bytes768(dk), dk_bytes
  assert_eq sha(dk.encapsulation_key.bytes), ek_hash
  assert !dk.decapsulate([0.as_u8; n]).ok?, "bad ciphertext length accepted"
}

def wp_semi_bad_ct1024(dk_hex: Str, ek_hash: Str, n: Int) -> ~Unit {
  dk_bytes = hx(dk_hex)
  dk = ~testing_only_new_decapsulation_key1024(dk_bytes)
  assert_eq testing_only_expanded_bytes1024(dk), dk_bytes
  assert_eq sha(dk.encapsulation_key.bytes), ek_hash
  assert !dk.decapsulate([0.as_u8; n]).ok?, "bad ciphertext length accepted"
}
