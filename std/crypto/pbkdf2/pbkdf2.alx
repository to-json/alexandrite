# Package pbkdf2: Go's crypto/pbkdf2, the key derivation function PBKDF2 of
# RFC 8018 (PKCS #5 v2.1). PBKDF2 derives a key from a password with a
# pseudorandom function (here HMAC over a chosen hash) applied `iter` times,
# making brute-force guessing expensive.
#
#   Go                                                  alx
#   pbkdf2.Key(h, password, salt, iter, keyLength)      key(h, password, salt, iter, key_length) -> ~[Byte]<Pbkdf2Error>
#
# h is a constructor of the hash, as in Go (`->() -> sha256.Digest {
# sha256.new() }`); key is generic over its type.
#
# Differences from Go:
#   - No FIPS 140-only mode (whose extra checks on the key length, salt
#     length and hash are the only other errors Go's Key returns).

import "crypto/hmac"

# Errors of key.
pub error Pbkdf2Error {
  KeyLengthNotPositive
  KeyLengthTooLong

  def message -> Str {
    case self {
      KeyLengthNotPositive => "pbkdf2: keyLength must be larger than 0"
      KeyLengthTooLong => "pbkdf2: keyLength too long"
    }
  }
}

MAX_BLOCKS = 0xffffffff
MAX_INT = 0x7fffffffffffffff

# A key of key_length bytes derived from password and salt with iter
# iterations of HMAC over the hash made by h.
pub def key[H](h: () -> H, password: Str, salt: [Byte], iter: Int, key_length: Int) -> ~[Byte]<Pbkdf2Error> {
  fail Pbkdf2Error.KeyLengthNotPositive if key_length <= 0
  prf = hmac.new(h, password.bytes.to_a)
  hash_len = prf.size
  fail Pbkdf2Error.KeyLengthTooLong if key_length > MAX_INT - hash_len
  num_blocks = (key_length + hash_len - 1) / hash_len
  fail Pbkdf2Error.KeyLengthTooLong if num_blocks > MAX_BLOCKS
  dk: [Byte] = []
  u = [0.as_u8; hash_len]
  block = 1
  while block <= num_blocks {
    prf.reset!
    prf.write!(salt)
    prf.write!([(block >> 24).as_u8, (block >> 16).as_u8, (block >> 8).as_u8, block.as_u8])
    t = prf.sum([])
    copy(u, t)
    n = 2
    while n <= iter {
      prf.reset!
      prf.write!(u)
      u = prf.sum([])
      x = 0
      while x < hash_len {
        t[x] = t[x] ^ u[x]
        x += 1
      }
      n += 1
    }
    dk = dk + t
    block += 1
  }
  dk[0...key_length]
}
