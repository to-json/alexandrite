import "crypto/sha1"
import "crypto/sha256"

# Go's pbkdf2_test.go, translated. The tables are in table_test.alx.
#
# Not translated: TestPBKDF2ServiceIndicator (FIPS 140 module mode),
# pbkdf2_wycheproof_test.go (downloads the Wycheproof vectors as a Go module
# at test time; the generated vectors cover random passwords, salts,
# iteration counts and lengths instead).

#[track_caller]
def check_vectors[H](h: () -> H, vectors: [Pbkdf2Test]) {
  for v in vectors {
    o = key(h, v.password, v.salt, v.iter, v.output.size).unwrap
    assert_eq o, v.output
  }
}

test "with hmac sha1" {
  check_vectors(->() -> sha1.Digest { sha1.new() }, sha1_test_vectors())
}

test "with hmac sha256" {
  check_vectors(->() -> sha256.Digest { sha256.new() }, sha256_test_vectors())
}

test "max key length" {
  h = ->() -> sha256.Digest { sha256.new() }
  r = key(h, "password", b("salt"), 1, 0x7fffffffffffffff)
  assert r.err.present?, "expected pbkdf2.Key to fail with extremely large keyLength"
  assert_eq "#{r.err.unwrap}", "pbkdf2: keyLength too long"
  r2 = key(h, "password", b("salt"), 1, 0xffffffff * (sha256.SIZE + 1))
  assert r2.err.present?, "expected pbkdf2.Key to fail with extremely large keyLength"
}

test "zero key length" {
  h = ->() -> sha256.Digest { sha256.new() }
  r = key(h, "password", b("salt"), 1, 0)
  assert_eq "#{r.err.unwrap}", "pbkdf2: keyLength must be larger than 0"
  r2 = key(h, "password", b("salt"), 1, -1)
  assert r2.err.present?, "expected pbkdf2.Key to fail with negative keyLength"
}

def bench_pbkdf2[H](h: () -> H) {
  password = [0.as_u8; h().size]
  salt = [0.as_u8; 8]
  password = key(h, Str.from_bytes(password), salt, 4096, password.size).unwrap
  nil
}

bench "hmac sha1" {
  bench_pbkdf2(->() -> sha1.Digest { sha1.new() })
}

bench "hmac sha256" {
  bench_pbkdf2(->() -> sha256.Digest { sha256.new() })
}
