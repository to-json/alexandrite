# Go's crypto/pbkdf2 test tables, extracted from pbkdf2_test.go (go1.27.1); do not edit by hand.

import "encoding/hex"

struct Pbkdf2Test {
  password: Str
  salt: [Byte]
  iter: Int
  output: [Byte]
}

def b(s: Str) -> [Byte] { s.bytes.to_a }

def hx(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

def sha1_test_vectors -> [Pbkdf2Test] {
  out: [Pbkdf2Test] = []
  out << Pbkdf2Test.new(password: "password", salt: b("salt"), iter: 1, output: hx("0c60c80f961f0e71f3a9b524af6012062fe037a6"))
  out << Pbkdf2Test.new(password: "password", salt: b("salt"), iter: 2, output: hx("ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957"))
  out << Pbkdf2Test.new(password: "password", salt: b("salt"), iter: 4096, output: hx("4b007901b765489abead49d926f721d065a429c1"))
  out << Pbkdf2Test.new(password: "passwordPASSWORDpassword", salt: b("saltSALTsaltSALTsaltSALTsaltSALTsalt"), iter: 4096, output: hx("3d2eec4fe41c849b80c8d83662c0e44a8b291a964cf2f07038"))
  out << Pbkdf2Test.new(password: Str.from_bytes(hx("7061737300776f7264")), salt: hx("7361006c74"), iter: 4096, output: hx("56fa6aa75548099dcc37d7f03425e0c3"))
  out
}

def sha256_test_vectors -> [Pbkdf2Test] {
  out: [Pbkdf2Test] = []
  out << Pbkdf2Test.new(password: "password", salt: b("salt"), iter: 1, output: hx("120fb6cffcf8b32c43e7225256c4f837a86548c9"))
  out << Pbkdf2Test.new(password: "password", salt: b("salt"), iter: 2, output: hx("ae4d0c95af6b46d32d0adff928f06dd02a303f8e"))
  out << Pbkdf2Test.new(password: "password", salt: b("salt"), iter: 4096, output: hx("c5e478d59288c841aa530db6845c4c8d962893a0"))
  out << Pbkdf2Test.new(password: "passwordPASSWORDpassword", salt: b("saltSALTsaltSALTsaltSALTsaltSALTsalt"), iter: 4096, output: hx("348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c"))
  out << Pbkdf2Test.new(password: Str.from_bytes(hx("7061737300776f7264")), salt: hx("7361006c74"), iter: 4096, output: hx("89b69d0516f829893c696226650a8687"))
  out
}
