# Generated from Go's crypto/pbkdf2 (go1.27.1): keys from seeded random secrets,
# salts and infos over every hash, at lengths around the hash sizes; do not
# edit by hand.

import "encoding/hex"
import "crypto/md5"
import "crypto/sha1"
import "crypto/sha256"
import "crypto/sha512"
import "crypto/sha3"

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

# gen bytes mapped to printable ASCII (the generator's `text`).
def text(seed: U64, n: Int) -> Str {
  out: [Byte] = []
  for x in gen(seed, n) {
    out << 0x20 + x % 95
  }
  Str.from_bytes(out)
}

def derive(name: Str, pw: Str, salt: [Byte], iter: Int, kl: Int) -> [Byte] {
  r = case name {
    "md5" => key(->() -> md5.Digest { md5.new() }, pw, salt, iter, kl)
    "sha1" => key(->() -> sha1.Digest { sha1.new() }, pw, salt, iter, kl)
    "sha224" => key(->() -> sha256.Digest { sha256.new224() }, pw, salt, iter, kl)
    "sha256" => key(->() -> sha256.Digest { sha256.new() }, pw, salt, iter, kl)
    "sha384" => key(->() -> sha512.Digest { sha512.new384() }, pw, salt, iter, kl)
    "sha512" => key(->() -> sha512.Digest { sha512.new() }, pw, salt, iter, kl)
    "sha512_224" => key(->() -> sha512.Digest { sha512.new512_224() }, pw, salt, iter, kl)
    "sha512_256" => key(->() -> sha512.Digest { sha512.new512_256() }, pw, salt, iter, kl)
    "sha3_224" => key(->() -> sha3.SHA3 { sha3.new224() }, pw, salt, iter, kl)
    "sha3_256" => key(->() -> sha3.SHA3 { sha3.new256() }, pw, salt, iter, kl)
    "sha3_384" => key(->() -> sha3.SHA3 { sha3.new384() }, pw, salt, iter, kl)
    _ => key(->() -> sha3.SHA3 { sha3.new512() }, pw, salt, iter, kl)
  }
  r.unwrap
}

# password = text(seed, pl), salt = gen(seed + 1, sl).
def pk(name: Str, seed: U64, pl: Int, sl: Int, iter: Int, kl: Int, want: Str) {
  assert_eq hex.encode_to_string(derive(name, text(seed, pl), gen(seed + 1, sl), iter, kl)), want
}

