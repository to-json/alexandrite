# Package rand: Go's crypto/rand, a cryptographically secure random number
# generator. The bytes come from the operating system's CSPRNG
# (getentropy(3): getrandom on Linux, the kernel CSPRNG on macOS and the
# BSDs).
#
#   Go                                  alx
#   rand.Reader (io.Reader)             reader() -> Reader (an io.Reader)
#   rand.Read(b) (n int, err error)     read(b) -> Int (never fails)
#   rand.Text() string                  text() -> Str
#   rand.Int(rand, max *big.Int)        (not yet: needs math/big)
#   rand.Prime(rand, bits)              (not yet: needs math/big)
#
# Differences from Go:
#   - Go's Reader is a package variable that a program (or a test) may
#     replace, and Read then reads from the replacement. alx has no mutable
#     package state: reader() always reads from the operating system, and
#     read(b) is reader().read!(b). Code that wants a different source takes
#     an io.Reader parameter.
#   - Go's Read never returns an error: on failure it crashes the program
#     with "fatal error: crypto/rand: failed to read random data"; read here
#     panics with that message, and returns plain Int.
#   - Go runs the OS bytes through its FIPS 140 DRBG (and reads the OS only
#     to seed it); here every read goes to the OS, which on these systems is
#     itself a ChaCha20 / AES-CTR DRBG.
#   - Int and Prime need arbitrary-precision integers (math/big), which alx's
#     std doesn't have yet; they come with math/big.

extern def c_getentropy(buf: [Byte], n: Int) -> I32 = "getentropy"

# getentropy fills at most this many bytes per call.
MAX_ENTROPY = 256

BASE32_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

# The operating system's random bytes (Go's default rand.Reader). It has no
# state; every Reader reads from the same source.
pub struct Reader {
  # Fills p with random bytes; returns p.size. It never fails: if the
  # operating system can't supply random bytes, the program panics.
  pub def read!(p: [Byte]) -> Int {
    fill(p)
  }
}

# The shared secure random source (Go's rand.Reader).
pub def reader -> Reader { Reader.new }

def fill(b: [Byte]) -> Int {
  off = 0
  while off < b.size {
    n = b.size - off
    n = MAX_ENTROPY if n > MAX_ENTROPY
    chunk = b[off...off + n]
    rc = c_getentropy(chunk, n)
    panic("crypto/rand: failed to read random data (see https://go.dev/issue/66821)") if rc != 0
    off += n
  }
  b.size
}

# Fills b with cryptographically secure random bytes; returns b.size.
pub def read(b: [Byte]) -> Int {
  fill(b)
}

# A cryptographically random string of 26 characters from the standard
# base32 alphabet (A-Z, 2-7): 128 bits of randomness, enough for a key, a
# token or an identifier that must not collide.
pub def text -> Str {
  src = [0.as_u8; 26]
  read(src)
  i = 0
  while i < src.size {
    src[i] = BASE32_ALPHABET[(src[i] % 32).to_i]
    i += 1
  }
  Str.from_bytes(src)
}
