# Package rand: Go's crypto/rand, a cryptographically secure random number
# generator. The bytes come from the operating system's CSPRNG
# (getentropy(3): getrandom on Linux, the kernel CSPRNG on macOS and the
# BSDs).
#
#   Go                                  alx
#   rand.Reader (io.Reader)             reader() -> Reader (an io.Reader)
#   rand.Read(b) (n int, err error)     read(b) -> Int (never fails)
#   rand.Text() string                  text() -> Str
#   rand.Int(rand, max *big.Int)        int(r, max) -> ~big.Int   (r: any reader)
#   rand.Prime(rand, bits)              prime(bits) -> ~big.Int<RandError>
#
# Differences from Go:
#   - Go's Reader is a package variable that a program (or a test) may
#     replace, and Read then reads from the replacement. alx has no mutable
#     package state: reader() always reads from the operating system, and
#     read(b) is reader().read!(b). Code that wants a different source takes
#     an io.Reader parameter.
#   - Go's Read never returns an error: on failure it crashes the program
#     with "fatal error: crypto/rand: failed to read random data"; read here
#     panics with that message, and returns plain Int.
#   - Go runs the OS bytes through its FIPS 140 DRBG (and reads the OS only
#     to seed it); here every read goes to the OS, whose generator is itself
#     a cryptographic DRBG.
#   - Prime takes no reader: since Go 1.26 Prime ignores its Reader
#     argument and always reads the secure source (unless
#     GODEBUG=cryptocustomrand=1, which alx doesn't have). Its error for
#     bits < 2 is RandError.PrimeSize with Go's message.
#   - int(r, max) is generic over the reader (any type with a `read!`
#     returning Int or ~Int), as Go takes any io.Reader; a reader that ends
#     early fails with io's UnexpectedEof (Go's io.ReadFull error). It
#     panics if max <= 0, as Go's does.

import "io"
import "math/big"

extern def c_getentropy(buf: [Byte], n: Int) -> I32 = "getentropy"

# getentropy fills at most this many bytes per call.
MAX_ENTROPY = 256

BASE32_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

# The operating system's random bytes (Go's default rand.Reader). It has no
# state; every Reader reads from the same source.
pub struct Reader {
  # Fills p with random bytes; returns p.size. It never fails: if the
  # operating system can't supply random bytes, the program panics.
  pub def read!(p: [Byte]) -> Int {
    fill(p)
  }
}

# The shared secure random source (Go's rand.Reader).
pub def reader -> Reader { Reader.new }

def fill(b: [Byte]) -> Int {
  off = 0
  while off < b.size {
    n = b.size - off
    n = MAX_ENTROPY if n > MAX_ENTROPY
    chunk = b[off...off + n]
    rc = c_getentropy(chunk, n)
    panic("crypto/rand: failed to read random data (see https://go.dev/issue/66821)") if rc != 0
    off += n
  }
  b.size
}

# Fills b with cryptographically secure random bytes; returns b.size.
pub def read(b: [Byte]) -> Int {
  fill(b)
}

# A cryptographically random string of 26 characters from the standard
# base32 alphabet (A-Z, 2-7): 128 bits of randomness, enough for a key, a
# token or an identifier that must not collide.
pub def text -> Str {
  src = [0.as_u8; 26]
  read(src)
  i = 0
  while i < src.size {
    src[i] = BASE32_ALPHABET[(src[i] % 32).to_i]
    i += 1
  }
  Str.from_bytes(src)
}

# The error of prime.
pub error RandError {
  PrimeSize

  def message -> Str {
    case self {
      PrimeSize => "crypto/rand: prime size must be at least 2-bit"
    }
  }
}

# Fills p from r, failing with io's UnexpectedEof if r ends first.
def read_full[R](r: R, p: [Byte]) -> ~Unit {
  rd = r
  off = 0
  while off < p.size {
    n = rd.~read!(p[off...p.size])
    fail io.StreamError.UnexpectedEof if n == 0
    off += n
  }
}

# A uniform random value in [0, max), from the bytes of r. It panics if
# max <= 0, and fails if reading r does.
pub def int[R](r: R, max: big.Int) -> ~big.Int {
  panic("crypto/rand: argument to Int is <= 0") if max.sign <= 0
  n = big.Int.new
  n.sub!(max, big.new_int(1))
  # bit_len is the maximum bit length needed to encode a value < max.
  bit_len = n.bit_len
  # The only valid result is 0.
  return n if bit_len == 0
  # k is the maximum byte length needed to encode a value < max.
  k = (bit_len + 7) / 8
  # b is the number of bits in the most significant byte of max-1.
  b = bit_len % 8
  b = 8 if b == 0
  buf = [0.as_u8; k]
  while true {
    ~read_full(r, buf)
    # Clear bits in the first byte to increase the probability that the
    # candidate is < max.
    buf[0] = buf[0] & ((1 << b) - 1).as_u8
    n.set_bytes!(buf)
    return n if n.cmp(max) < 0
  }
  n
}

# A number of the given bit length that is prime with high probability,
# made from the secure source. Fails if bits < 2.
pub def prime(bits: Int) -> ~big.Int<RandError> {
  fail RandError.PrimeSize if bits < 2
  prime_from(reader(), bits).unwrap
}

# Go's Prime loop over the bytes of r (what Go 1.25 and earlier, or
# GODEBUG=cryptocustomrand=1, read from the Reader argument); bits >= 2.
def prime_from[R](r: R, bits: Int) -> ~big.Int {
  b = bits % 8
  b = 8 if b == 0
  buf = [0.as_u8; (bits + 7) / 8]
  p = big.Int.new
  while true {
    ~read_full(r, buf)
    # Clear bits in the first byte to make sure the candidate has a size
    # <= bits.
    buf[0] = buf[0] & ((1 << b) - 1).as_u8
    # Don't let the value be too small, i.e, set the most significant two
    # bits. Setting the top two bits, rather than just the top bit, means
    # that when two of these values are multiplied together, the result
    # isn't ever one bit short.
    if b >= 2 {
      buf[0] = buf[0] | (3 << (b - 2)).as_u8
    } else {
      # Here b == 1, because b cannot be zero.
      buf[0] = buf[0] | 1
      buf[1] = buf[1] | 0x80 if buf.size > 1
    }
    # Make the value odd since an even number this large certainly isn't
    # prime.
    buf[buf.size - 1] = buf[buf.size - 1] | 1
    p.set_bytes!(buf)
    return p if p.probably_prime?(20)
  }
  p
}
