import "bytes"
import "math/big"

# Go's util_test.go and the Int/Prime examples, translated.
#
# Not translated: TestIntEmptyMaxPanics and TestIntNegativeMaxPanics (they
# expect panics, which an alx test can't catch). TestPrimeNondeterministic
# runs as Go's does: prime takes no reader, so two calls differ.

test "prime small" {
  n = 2
  while n < 10 {
    p = prime(n).unwrap
    assert_eq p.bit_len, n
    assert p.probably_prime?(32), "#{p.to_s} is not prime"
    n += 1
  }
}

test "prime bits lt 2" {
  r = prime(1)
  assert r.err?, "prime(1) succeeded"
  assert_eq r.err.unwrap.message, "crypto/rand: prime size must be at least 2-bit"
}

test "prime nondeterministic" {
  p0 = prime(32).unwrap
  differs = false
  i = 0
  while i < 128 && !differs {
    differs = prime(32).unwrap.cmp(p0) != 0
    i += 1
  }
  assert differs, "prime always generated the same prime"
}

test "int" {
  # Start at 128 so the case of (max.bit_len % 8) == 0 is covered.
  n = 128
  while n < 140 {
    v = int(reader(), big.new_int(n)).unwrap
    assert v.sign >= 0 && v.cmp(big.new_int(n)) < 0, "out of range"
    n += 1
  }
}

# A reader counting the bytes read (Go's countingReader).
struct CountingReader {
  n: [Int]

  def read!(p: [Byte]) -> Int {
    k = read(p)
    c = n
    c[0] = c[0] + k
    k
  }
}

# Int reads only the bytes it needs for max at each bit length.
test "int reads" {
  i = 0
  while i < 32 {
    r = CountingReader.new(n: [0])
    int(r, big.new_int(1 << i)).unwrap
    assert_eq r.n[0], (i + 7) / 8
    i += 1
  }
}

# Int doesn't mask out valid return values.
test "int mask" {
  max = 1
  while max <= 256 {
    i = 0
    while i < max {
      b = bytes.new_buffer([i.as_u8])
      assert_eq int(b, big.new_int(max)).unwrap.int64, i
      i += 1
    }
    max += 1
  }
}

test "int short reader" {
  r = int(bytes.new_buffer([1.as_u8]), big.new_int(1 << 20))
  assert_eq r.err.unwrap.message, "unexpected EOF"
}

example "int" {
  # int can't fail when reading the secure source.
  a = int(reader(), big.new_int(100)).unwrap
  puts a.int64 < 100
} outputs "true\n"

example "prime" {
  # prime can't fail when bits >= 2.
  a = prime(64).unwrap
  puts a.bit_len
} outputs "64\n"
