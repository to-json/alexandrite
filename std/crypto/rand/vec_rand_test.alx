# Generated from Go's crypto/rand and math/big (go1.27.1): Int over seeded
# random bytes for maxima of many sizes, and Go's Prime loop (as Go 1.25
# ran it on a custom reader; Go's ProbablyPrime(20)) over seeded bytes.
# Do not edit by hand.

import "bytes"
import "math/big"

def v_int(seed: U64, max: Str, want: Str) {
  m = big.Int.new
  m.set_string!(max, 10).unwrap
  assert_eq int(bytes.new_buffer(gen(seed, 4096)), m).unwrap.to_s, want
}

def v_prime(seed: U64, bits: Int, want: Str) {
  p = prime_from(bytes.new_buffer(gen(seed, 1 << 16)), bits).unwrap
  assert_eq p.to_s, want
  assert_eq p.bit_len, bits
}

