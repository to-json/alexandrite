#![overflow(wrap)]
# Package rc4: Go's crypto/rc4, RC4 encryption, as defined in Bruce
# Schneier's Applied Cryptography. Pure alx, Go's code.
#
# RC4 is cryptographically broken and should not be used for secure
# applications.
#
#   Go                                  alx
#   rc4.NewCipher(key) (*Cipher, error) new_cipher(key) -> ~Cipher<KeySizeError>
#   rc4.KeySizeError (int)              KeySizeError.KeySize(size)
#   c.XORKeyStream(dst, src)            c.xor_key_stream!(dst, src)
#   c.Reset()                           c.reset!
#
# A Cipher satisfies cipher.Stream structurally.
#
# Timing: as in Go, the state permutation is indexed by key-dependent
# values (not constant-time).
#
# Differences from Go:
#   - KeySizeError is an error enum with one variant carrying the size (Go:
#     a named int); the message is Go's ("crypto/rc4: invalid key size 0").
#   - A Cipher keeps its state in shared storage (GO-VS-RUBY D36): copies
#     are the same cipher, as Go's *Cipher is. Use new_cipher: a zero
#     `Cipher.new` has no state.
#   - xor_key_stream! can't detect inexact overlap of dst and src (alx
#     slices don't expose addresses), so it doesn't panic with "invalid
#     buffer overlap"; dst == src works, as in Go. It panics (index out of
#     range) if dst is shorter than src, as Go's does.
#   - No FIPS 140-only mode.

# The error of new_cipher: the key isn't 1 to 256 bytes.
pub error KeySizeError {
  KeySize(size: Int)

  def message -> Str {
    case self {
      KeySize(size) => "crypto/rc4: invalid key size #{size}"
    }
  }
}

# An instance of RC4 using a particular key.
pub struct Cipher {
  # The permutation (256 entries) and, in ij, the indexes i and j: shared
  # storage, so copies are the same cipher.
  s: [U32]
  ij: [U8]

  # Zeros the key data and makes the Cipher unusable. Deprecated in Go:
  # Reset can't guarantee that the key will be entirely removed from the
  # process's memory.
  pub def reset! {
    p = s
    i = 0
    while i < p.size {
      p[i] = 0
      i += 1
    }
    q = ij
    q[0] = 0
    q[1] = 0
    nil
  }

  # Sets dst to the result of XORing src with the key stream. dst and src
  # must overlap entirely or not at all.
  pub def xor_key_stream!(dst: [Byte], src: [Byte]) {
    n = src.size
    return if n == 0
    d = dst[0...n]
    p = s
    q = ij
    i = q[0]
    j = q[1]
    k = 0
    while k < n {
      i += 1
      x = p[i.to_i]
      j += x.as_u8
      y = p[j.to_i]
      p[i.to_i] = y
      p[j.to_i] = x
      d[k] = src[k] ^ p[(x + y).as_u8.to_i].as_u8
      k += 1
    }
    q[0] = i
    q[1] = j
    nil
  }
}

# A new Cipher. The key argument should be the RC4 key, at least 1 byte
# and at most 256 bytes.
pub def new_cipher(key: [Byte]) -> ~Cipher<KeySizeError> {
  k = key.size
  fail KeySizeError.KeySize(size: k) if k < 1 || k > 256
  s = [0.as_u32; 256]
  i = 0
  while i < 256 {
    s[i] = i.as_u32
    i += 1
  }
  j: U8 = 0
  i = 0
  while i < 256 {
    j += s[i].as_u8 + key[i % k]
    t = s[i]
    s[i] = s[j.to_i]
    s[j.to_i] = t
    i += 1
  }
  Cipher.new(s: s, ij: [0.as_u8; 2])
}
