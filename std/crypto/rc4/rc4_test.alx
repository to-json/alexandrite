import "encoding/hex"

# Go's crypto/rc4 rc4_test.go, translated. cryptotest.TestStream is
# check_stream (stream_test.alx).

def h(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

struct Rc4Test {
  key: [Byte]
  keystream: [Byte]
}

def golden -> [Rc4Test] {
  [
    # Test vectors from the original cypherpunk posting of ARC4:
    #   https://groups.google.com/group/sci.crypt/msg/10a300c9d21afca0?pli=1
    Rc4Test.new(key: h("0123456789abcdef"), keystream: h("7494c2e7104b0879")),
    Rc4Test.new(key: h("0000000000000000"), keystream: h("de188941a3375d3a")),
    Rc4Test.new(key: h("ef012345"), keystream: h("d6a141a7ec3c38dfbd61")),
    # Test vectors from the Wikipedia page: https://en.wikipedia.org/wiki/RC4
    Rc4Test.new(key: h("4b6579"), keystream: h("eb9f7781b734ca72a719")),
    Rc4Test.new(key: h("57696b69"), keystream: h("6044db6d41b7")),
    Rc4Test.new(key: h("0000000000000000"), keystream: h("de188941a3375d3a8a061e67576e926dc71a7fa3f0cceb97452b4d3227965f9e" + "a8cc75076d9fb9c5417aa5cb30fc22198b34982dbb629ec04b4f8b05a0710850" + "92a0c3584a48e4a30a397b8acd1d009ec87d6811f22cf49ca3e59354b9451535" + "a2187a86426cca7d5e823eba004412671257b8d860ae4cbd4c4906bbc535efe1" + "587f08db33955cdbcbad9b10f53fc4e52c591565518487fe084d0e3f03debcc9" + "da1ce90d085c2d8a19d8373086163692142bd8fc5d7a73496a8e59ee7ecf6b94" + "0663f4a6bee65bd2c85c46986c1bef3490d37b38da85d32e9739cb234a2be740")),
  ]
}

def test_encrypt(c: Cipher, src: [Byte], expect: [Byte]) {
  dst = [0.as_u8; src.size]
  cc = c
  cc.xor_key_stream!(dst, src)
  assert_eq dst, expect
}

test "golden" {
  for g in golden() {
    n = g.keystream.size
    data = [0.as_u8; n]
    expect = [0.as_u8; n]
    i = 0
    while i < n {
      data[i] = i.as_u8
      expect[i] = i.as_u8 ^ g.keystream[i]
      i += 1
    }
    size = 1
    while size <= n {
      c = new_cipher(g.key).unwrap
      off = 0
      while off < n {
        m = n - off
        m = size if m > size
        test_encrypt(c, data[off...off + m], expect[off...off + m])
        off += m
      }
      size += 1
    }
  }
}

test "block" {
  c1a = new_cipher(golden()[0].key).unwrap
  c1b = new_cipher(golden()[1].key).unwrap
  data1 = [0.as_u8; 1 << 20]
  i = 0
  while i < data1.size {
    c1a.xor_key_stream!(data1[i...i + 1], data1[i...i + 1])
    c1b.xor_key_stream!(data1[i...i + 1], data1[i...i + 1])
    i += 1
  }
  c2a = new_cipher(golden()[0].key).unwrap
  c2b = new_cipher(golden()[1].key).unwrap
  data2 = [0.as_u8; 1 << 20]
  c2a.xor_key_stream!(data2, data2)
  c2b.xor_key_stream!(data2, data2)
  assert data1 == data2, "bad block"
}

test "rc4 stream" {
  check_stream(->() -> Cipher { new_cipher(golden()[0].key).unwrap }, false)
}

test "key size error" {
  assert_eq new_cipher([]).err.unwrap.message, "crypto/rc4: invalid key size 0"
  assert_eq new_cipher([0.as_u8; 257]).err.unwrap.message, "crypto/rc4: invalid key size 257"
  assert new_cipher([0.as_u8; 256]).ok?, "256 rejected"
}

test "reset" {
  c = new_cipher(golden()[0].key).unwrap
  c.reset!
  # A reset cipher's state is all zeros: its key stream is zeros.
  out = [1.as_u8; 16]
  c.xor_key_stream!(out, [0.as_u8; 16])
  assert_eq out, [0.as_u8; 16]
}

def bench_rc4(size: Int) {
  buf = [0.as_u8; size]
  c = new_cipher(golden()[0].key).unwrap
  c.xor_key_stream!(buf, buf)
}

bench "rc4 128" { bench_rc4(128) }

bench "rc4 1K" { bench_rc4(1024) }

bench "rc4 8K" { bench_rc4(8096) }
