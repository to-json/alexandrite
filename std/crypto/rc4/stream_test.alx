# Go's crypto/internal/cryptotest.TestStream, for a constructor of
# streams. Not translated: the BufferOverlap subtest (alx slices don't
# expose addresses, so streams can't detect inexact overlap). cfb: skip the XOR
# semantics checks (CFB implements a Stream but isn't an XOR of a key
# stream, as in Go).

def stream_buf_lens -> [Int] { [0, 1, 3, 4, 8, 10, 15, 16, 20, 32, 50, 4096, 5000] }

STREAM_BUF_CAP = 10000

def check_stream[S](ms: () -> S, cfb: Bool) {
  if !cfb {
    # XORSemantics/Roundtrip
    for length in stream_buf_lens() {
      plaintext = gen(100 + length.as_u64, length)
      ciphertext = [0.as_u8; length]
      decrypted = [0.as_u8; length]
      s1 = ms()
      s1.xor_key_stream!(ciphertext, plaintext)
      s2 = ms()
      s2.xor_key_stream!(decrypted, ciphertext)
      assert_eq decrypted, plaintext
    }
    # XORSemantics/DirectXOR
    for length in stream_buf_lens() {
      plaintext = gen(200 + length.as_u64, length)
      stream = [0.as_u8; length]
      direct_xor = [0.as_u8; length]
      s1 = ms()
      s1.xor_key_stream!(stream, stream)
      i = 0
      while i < length {
        direct_xor[i] = stream[i] ^ plaintext[i]
        i += 1
      }
      ciphertext = [0.as_u8; length]
      s2 = ms()
      s2.xor_key_stream!(ciphertext, plaintext)
      assert_eq ciphertext, direct_xor
    }
  }

  # EmptyInput
  src = [0.as_u8; 100]
  dst = gen(300, 100)
  before = dst + []
  s = ms()
  s.xor_key_stream!(dst, src[0...0])
  assert_eq dst, before

  # AlterInput
  src = gen(301, STREAM_BUF_CAP)
  dst = [0.as_u8; STREAM_BUF_CAP]
  for length in stream_buf_lens() {
    before = src + []
    s = ms()
    s.xor_key_stream!(dst[0...length], src[0...length])
    assert_eq src, before
  }

  # OutOfBoundsWrite: a dst shorter than src panics, and nothing past dst
  # changes. (Go's message varies by stream, rc4's is an index panic, so
  # only the panic is checked.)
  plaintext = gen(350, STREAM_BUF_CAP)
  ciphertext = [0.as_u8; STREAM_BUF_CAP]
  for length in stream_buf_lens() {
    next if length >= STREAM_BUF_CAP
    copy(ciphertext, plaintext)
    assert_panics {
      s = ms()
      s.xor_key_stream!(ciphertext[0...length], plaintext)
    }
    assert_eq ciphertext[length...STREAM_BUF_CAP], plaintext[length...STREAM_BUF_CAP]
  }

  # Aliasing
  buff = [0.as_u8; STREAM_BUF_CAP]
  expected = [0.as_u8; STREAM_BUF_CAP]
  for length in stream_buf_lens() {
    copy(buff, gen(400 + length.as_u64, STREAM_BUF_CAP))
    s1 = ms()
    s1.xor_key_stream!(expected[0...length], buff[0...length])
    s2 = ms()
    s2.xor_key_stream!(buff[0...length], buff[0...length])
    assert_eq buff[0...length], expected[0...length]
  }

  # KeepState
  plaintext = gen(500, STREAM_BUF_CAP)
  ciphertext = [0.as_u8; STREAM_BUF_CAP]
  s = ms()
  s.xor_key_stream!(ciphertext, plaintext)
  for step in stream_buf_lens() {
    next if step == 0
    out = [0.as_u8; STREAM_BUF_CAP]
    stream = ms()
    i = 0
    while i + step < plaintext.size {
      stream.xor_key_stream!(out[i...out.size], plaintext[i...i + step])
      i += step
    }
    stream.xor_key_stream!(out[i...out.size], plaintext[i...plaintext.size])
    assert_eq out, ciphertext
  }
}
