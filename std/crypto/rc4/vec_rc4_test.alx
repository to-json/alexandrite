# Generated from Go's crypto/rc4 (go1.27.1): seeded random keys of 1 to 256
# bytes over seeded plaintexts (outputs over 256 bytes compared by SHA-256),
# also fed byte by byte. Do not edit by hand. 238 assertions.

import "crypto/sha256"

def v_rc4(seed: U64, kl: Int, n: Int, want: Str) {
  pt = gen(seed + 1, n)
  ct = [0.as_u8; n]
  c = new_cipher(gen(seed, kl)).unwrap
  c.xor_key_stream!(ct, pt)
  got = n > 256 ? "sha256:#{hex.encode_to_string(sha256.sum256(ct).to_a)}" : hex.encode_to_string(ct)
  assert_eq got, want
  # Byte by byte.
  c2 = new_cipher(gen(seed, kl)).unwrap
  back = [0.as_u8; n]
  i = 0
  while i < n {
    c2.xor_key_stream!(back[i...i + 1], ct[i...i + 1])
    i += 1
  }
  assert_eq back, pt
}

