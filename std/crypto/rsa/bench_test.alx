# Go's rsa_test.go benchmarks (2048-bit; alx test -bench .). Each body
# repeats the operation 10 times (verify and encrypt: 100) so the key setup
# is small next to it.

import "crypto"
import "crypto/sha256"

bench "DecryptPKCS1v15 2048 x10" {
  k = test2048_key()
  m = "Hello Gophers".bytes
  c = encrypt_pkcs1v15(crand(), k.public_key, m).unwrap
  for _i in 0...10 {
    p = decrypt_pkcs1v15(nil_reader(), k, c).unwrap
    assert p == m
  }
}

bench "EncryptPKCS1v15 2048 x100" {
  k = test2048_key()
  m = "Hello Gophers".bytes
  for _i in 0...100 {
    _ = encrypt_pkcs1v15(crand(), k.public_key, m).unwrap
  }
}

bench "DecryptOAEP 2048 x10" {
  k = test2048_key()
  m = "Hello Gophers".bytes
  c = encrypt_oaep(sha256.new(), crand(), k.public_key, m, []).unwrap
  for _i in 0...10 {
    p = decrypt_oaep(sha256.new(), nil_reader(), k, c, []).unwrap
    assert p == m
  }
}

bench "EncryptOAEP 2048 x100" {
  k = test2048_key()
  m = "Hello Gophers".bytes
  for _i in 0...100 {
    _ = encrypt_oaep(sha256.new(), crand(), k.public_key, m, []).unwrap
  }
}

bench "SignPKCS1v15 2048 x10" {
  k = test2048_key()
  hashed = sha256.sum256("testing".bytes).to_a
  for _i in 0...10 {
    _ = sign_pkcs1v15(nil_reader(), k, crypto.SHA256, hashed).unwrap
  }
}

bench "VerifyPKCS1v15 2048 x100" {
  k = test2048_key()
  hashed = sha256.sum256("testing".bytes).to_a
  s = sign_pkcs1v15(nil_reader(), k, crypto.SHA256, hashed).unwrap
  for _i in 0...100 {
    verify_pkcs1v15(k.public_key, crypto.SHA256, hashed, s).unwrap
  }
}

bench "SignPSS 2048 x10" {
  k = test2048_key()
  hashed = sha256.sum256("testing".bytes).to_a
  for _i in 0...10 {
    _ = sign_pss(crand(), k, crypto.SHA256, hashed, none).unwrap
  }
}

bench "VerifyPSS 2048 x100" {
  k = test2048_key()
  hashed = sha256.sum256("testing".bytes).to_a
  s = sign_pss(crand(), k, crypto.SHA256, hashed, none).unwrap
  for _i in 0...100 {
    verify_pss(k.public_key, crypto.SHA256, hashed, s, none).unwrap
  }
}

bench "GenerateKey 2048" {
  _ = generate_key(crand(), 2048).unwrap
}
