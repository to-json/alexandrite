# Go's equal_test.go. The x509 PKCS #8 round trip is left out (no
# crypto/x509 yet).

import "crypto"

def signer_public(s: crypto.Signer) -> crypto.PublicKey { s.public }

test "Equal" {
  private = test512_key()
  public = private.public_key
  assert public.equal?(public), "public key is not equal to itself"
  assert public.equal?(private.public), "private.Public() is not Equal to public"
  _ = signer_public(private)
  assert private.equal?(private), "private key is not equal to itself"

  other = test512_key_two()
  assert !public.equal?(other.public), "different public keys are Equal"
  assert !private.equal?(other), "different private keys are Equal"

  no_precomp = private
  no_precomp.precomputed = PrecomputedValues.new
  assert private.equal?(no_precomp), "private key with no precomputation is not equal to itself"
}
