# Go's example_test.go. Go's examples have no Output comments; the
# deterministic ones check their output here. Left out:
# ExampleGenerateKey (prints a PEM PKCS #8 key: no crypto/x509 yet) and
# the AES-GCM half of ExampleDecryptPKCS1v15SessionKey (no crypto/cipher
# yet).

import "crypto"
import "crypto/rand"
import "crypto/sha256"

example "GenerateKey_testKey" {
  # An insecure, test-only key from RFC 9500, Section 2.1: avoids slow key
  # generation in tests.
  k = test_rfc9500_key()
  puts "Private key bit size: #{k.n.bit_len}"
} outputs "Private key bit size: 2048\n"

example "DecryptPKCS1v15SessionKey" {
  # A hybrid scheme: RSA carries a symmetric key. The random key is used
  # when the RSA message is malformed, so a bad padding isn't revealed.
  key = [0.as_u8; 32]
  rand.read(key)
  rsa_ciphertext = unhex("aabbccddeeff")
  r = decrypt_pkcs1v15_session_key(nil_reader(), test1024_key(), rsa_ciphertext, key)
  # Errors are public: e.g. a key length impossible for the RSA key.
  puts "Error from RSA decryption: #{err_text(r)}" if r.err?
  puts "session key: #{key.size} bytes"
} outputs "session key: 32 bytes\n"

example "SignPKCS1v15" {
  message = "message to be signed".bytes
  # Only small messages can be signed directly: sign the hash.
  hashed = sha256.sum256(message).to_a
  signature = sign_pkcs1v15(nil_reader(), test1024_key(), crypto.SHA256, hashed).unwrap
  puts "Signature: #{to_hex(signature)}"
} outputs "Signature: 1a9590f0219b4e4a3a37ff7da78206f4299e7f0894a8ff59c2cc8ce19cd15540b0218b083c36ab3242d618e789b979e5f6bca01ada4fe1992ad6c6c827e5efbd00727171c97674977a07089a6da38d0de6bde1603f5aea3aed67a026d9a3f7d6f74efd1b1859632a95533fe65ffb2807492e869bf617d88bca1e6138e8318630\n"

example "VerifyPKCS1v15" {
  message = "message to be signed".bytes
  signature = unhex("ad2766728615cc7a746cc553916380ca7bfa4f8983b990913bc69eb0556539a350ff0f8fe65ddfd3ebe91fe1c299c2fac135bc8c61e26be44ee259f2f80c1530")
  hashed = sha256.sum256(message).to_a
  # (Go's example verifies a 512-bit signature with its 1024-bit key, so
  # it reports this error.)
  r = verify_pkcs1v15(test1024_key().public_key, crypto.SHA256, hashed, signature)
  puts "Error from verification: #{err_text(r)}" if r.err?
} outputs "Error from verification: crypto/rsa: verification error\n"

example "EncryptOAEP" {
  secret_message = "send reinforcements, we're going to advance".bytes
  label = "orders".bytes
  # crypto/rand is a good source of entropy for randomizing the encryption.
  ciphertext = encrypt_oaep(sha256.new(), rand.reader(), test2048_key().public_key, secret_message, label).unwrap
  # The ciphertext differs every time.
  plaintext = decrypt_oaep(sha256.new(), nil_reader(), test2048_key(), ciphertext, label).unwrap
  puts "Plaintext: #{Str.from_bytes(plaintext)}"
} outputs "Plaintext: send reinforcements, we're going to advance\n"

example "DecryptOAEP" {
  ciphertext = unhex(
    "",
  )
  label = "orders".bytes
  # (The ciphertext isn't for Go's test2048Key: Go's example, which has no
  # Output comment, reports this error too.)
  r = decrypt_oaep(sha256.new(), nil_reader(), test2048_key(), ciphertext, label)
  if pt = r.ok {
    puts "Plaintext: #{Str.from_bytes(pt)}"
  } else {
    puts "Error from decryption: #{err_text(r)}"
  }
} outputs "Error from decryption: crypto/rsa: decryption error\n"
