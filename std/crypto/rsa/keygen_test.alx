# Go's TestKeyGenerationVectors (rsa_test.go, with the c2sp.org/det-keygen
# vectors of vec_det_keygen_test.alx) and the internal keygen_test.go
# (TestMillerRabin, TestTotient: vec_miller_rabin_test.alx,
# vec_totient_test.alx). The HMAC_DRBG is Go's ecdsa.TestingOnlyNewDRBG
# (SP 800-90A, SHA-256, plain personalization string).

import "crypto/hmac"
import "crypto/internal/fips140/bigmod"
import "crypto/sha1"
import "crypto/sha256"
import "encoding/base64"
import "math/big"

def hmac256(key: [Byte], data: [Byte]) -> [Byte] {
  m = hmac.new(->() -> sha256.Digest { sha256.new() }, key)
  _ = m.write!(data)
  m.sum([])
}

# HMAC_DRBG as an io.Reader, wrapped like Go's keyGenTestReader (one-byte
# reads read nothing).
struct Drbg {
  # (K, V)
  st: [([Byte], [Byte])]

  pub def read!(p: [Byte]) -> Int {
    return 1 if p.size == 1
    k, v = self.st[0]
    t = 0
    while t < p.size {
      v = hmac256(k, v)
      n = v.size
      n = p.size - t if p.size - t < n
      copy(p[t...t + n], v[0...n])
      t += n
    }
    k = hmac256(k, v + [0.as_u8])
    v = hmac256(k, v)
    self.st[0] = (k, v)
    p.size
  }
}

def new_drbg(entropy: [Byte], pers: [Byte]) -> Drbg {
  k = [0.as_u8; 32]
  v = [1.as_u8; 32]
  k = hmac256(k, v + [0.as_u8] + entropy + pers)
  v = hmac256(k, v)
  k = hmac256(k, v + [1.as_u8] + entropy + pers)
  v = hmac256(k, v)
  Drbg.new(st: [(k, v)])
}

def check_det_keygen(bits: Int, seed: Str, n: Str, d: Str, p: Str, q: Str) {
  pers = "det RSA key gen".bytes + [(bits >> 8).as_u8, bits.as_u8]
  rng = new_drbg(base64.std_encoding.decode_string(seed).unwrap, pers)
  priv = generate_key(rng, bits).unwrap
  key_basics(priv, true)
  assert_eq priv.n.text(16), n
  assert_eq priv.d.text(16), d
  assert_eq priv.primes[0].text(16), p
  assert_eq priv.primes[1].text(16), q
}

def check_miller_rabin(w0: Str, b0: Str, expected: Bool) {
  w1 = w0.size % 2 != 0 ? "0" + w0 : w0
  b1 = b0
  while b1.size < w1.size {
    b1 = "0" + b1
  }
  w = unhex(w1)
  # Only candidates = 3 mod 4 (Go skips the others).
  if w.size > 0 && w[w.size - 1] % 4 == 3 {
    mr = miller_rabin_setup(w).unwrap
    assert_eq miller_rabin_iteration(mr, unhex(b1)).unwrap, expected
  }
}

def hex_even(s: Str) -> Str { s.size % 2 != 0 ? "0" + s : s }

def add_one(b: [Byte]) -> [Byte] {
  x = big.Int.new
  x.set_bytes!(b)
  x.add!(x, big.new_int(1))
  x.bytes
}

def trim_zeros(s: Str) -> Str {
  i = 0
  while i < s.size && s[i] == 48 {
    i += 1
  }
  s[i...s.size]
}

def check_totient(gcd: Str, a: Str, b: Str, lcm: Str) {
  # Go skips zero inputs and LCM = 1.
  if a != "0" && b != "0" && lcm != "1" {
    p = bigmod.new_modulus(add_one(unhex(hex_even(a)))).unwrap
    an = bigmod.new_nat()
    an.set_bytes!(unhex(hex_even(a)), p).unwrap
    q = bigmod.new_modulus(add_one(unhex(hex_even(b)))).unwrap
    bn = bigmod.new_nat()
    bn.set_bytes!(unhex(hex_even(b)), q).unwrap
    g = bigmod.new_nat()
    # The GCD needs an odd operand; Go checks it when it succeeds.
    if gr = g.gcd_var_time!(an, bn).ok {
      assert_eq trim_zeros(to_hex(gr.bytes(p))), gcd
    }
    # totient needs a/2 and b/2 odd.
    if an.bits[0] % 4 == 2 && bn.bits[0] % 4 == 2 {
      r = totient(p, q)
      gb = big.Int.new
      gb.set_bytes!(unhex(hex_even(gcd)))
      if gb.bit_len > 32 {
        assert_eq err_text(r), "divisor too large"
      } else {
        l = r.unwrap
        assert_eq trim_zeros(to_hex(l.nat.bytes(l))), lcm
      }
    }
  }
}

# Go's internal pkcs1v15_test.go TestHashPrefixes: the DigestInfo
# prefixes are the DER of SEQUENCE { AlgorithmIdentifier { oid, NULL },
# OCTET STRING } without the digest. Built here from the OIDs' DER bytes
# (no encoding/asn1 yet).
test "HashPrefixes" {
  # (name, OID content octets, digest size)
  oids: [(Str, Str, Int)] = [
    ("MD5", "2a864886f70d0205", 16),
    ("SHA-1", "2b0e03021a", 20),
    ("SHA-224", "608648016503040204", 28),
    ("SHA-256", "608648016503040201", 32),
    ("SHA-384", "608648016503040202", 48),
    ("SHA-512", "608648016503040203", 64),
    ("SHA-512/224", "608648016503040205", 28),
    ("SHA-512/256", "608648016503040206", 32),
    ("SHA3-224", "608648016503040207", 28),
    ("SHA3-256", "608648016503040208", 32),
    ("SHA3-384", "608648016503040209", 48),
    ("SHA3-512", "60864801650304020a", 64),
  ]
  for t in oids {
    oid = unhex(t[1])
    alg = [0x06.as_u8, oid.size.as_u8] + oid + [0x05.as_u8, 0x00]
    alg_seq = [0x30.as_u8, alg.size.as_u8] + alg
    body_len = alg_seq.size + 2 + t[2]
    want = [0x30.as_u8, body_len.as_u8] + alg_seq + [0x04.as_u8, t[2].as_u8]
    assert_eq to_hex(hash_prefix(t[0]).unwrap), to_hex(want)
  }
}

# Go's internal pkcs1v22_test.go: pss-int.txt of RSA's PKCS #1 v2.1
# vectors.
test "EMSAPSS" {
  msg = unhex(
    "859eef2fd78aca00308bdc471193bf55bf9d78db8f8a672b484634f3c9c26e6478ae10260fe0dd8c082e53a5293af2173cd50c6d5d354febf78b26021c25c02712e78cd4694c9f469777e451e7f8e9e04cd3739c6bbfedae487fb55644e9ca74ff77a53cb729802f6ed4a5ffa8ba159890fc",
  )
  salt = unhex("e3b5d5d002c1bce50c2b65ef88a188d83bce7e61")
  expected = unhex(
    "66e4672e836ad121ba244bed6576b867d9a447c28a6e66a5b87dee7fbc7e65af5057f86fae8984d9ba7f969ad6fe02a4d75f7445fefdd85b6d3a477c28d24ba1e3756f792dd1dce8ca94440ecb5279ecd3183a311fc896da1cb39311af37ea4a75e24bdbfd5c1da0de7cecdf1a896f9d8bc816d97cd7a2c43bad546fbe8cfebc",
  )
  h = sha1.new()
  _ = h.write!(msg)
  hashed = h.sum([])
  encoded = emsa_pss_encode(hashed, 1023, salt, sha1.new()).unwrap
  assert_eq to_hex(encoded), to_hex(expected)
  r = emsa_pss_verify(hashed, encoded, 1023, salt.size, sha1.new())
  assert r.ok?, "Bad verification: #{err_text(r)}"
}
