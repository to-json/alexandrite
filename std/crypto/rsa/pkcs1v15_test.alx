# Go's pkcs1v15_test.go. TestEncryptPKCS1v15's testing/quick inputs are
# messages from a fixed SHAKE stream.

import "crypto"
import "crypto/sha1"
import "crypto/sha256"
import "encoding/base64"

def decode_base64(s: Str) -> [Byte] { base64.std_encoding.decode_string(s).unwrap }

# Generated with `openssl rsautl -pkcs -encrypt`.
def decrypt_pkcs1v15_tests -> [(Str, Str)] {
  [
    ("gIcUIoVkD6ATMBk/u/nlCZCCWRKdkfjCgFdo35VpRXLduiKXhNz1XupLLzTXAybEq15juc+EgY5o0DHv/nt3yg==", "x"),
    ("Y7TOCSqofGhkRb+jaVRLzK8xw2cSo1IVES19utzv6hwvx+M8kFsoWQm5DzBeJCZTCVDPkTpavUuEbgp8hnUGDw==", "testing."),
    ("arReP9DJtEVyV2Dg3dDp4c/PSk1O6lxkoJ8HcFupoRorBZG+7+1fDAwT1olNddFnQMjmkb8vxwmNMoTAT/BFjQ==", "testing.\n"),
    ("WtaBXIoGC54+vH0NH0CHHE+dRDOsMc/6BrfFu2lEqcKL9+uDuWaf+Xj9mrbQCjjZcpQuX733zyok/jsnqe/Ftw==", "01234567890123456789012345678901234567890123456789012"),
  ]
}

test "DecryptPKCS1v15" {
  k = test512_key()
  i = 0
  for t in decrypt_pkcs1v15_tests() {
    out = decrypt_pkcs1v15_g(nil_reader(), k, decode_base64(t[0]), false)
    assert out.ok?, "##{i} error decrypting: #{err_text(out)}"
    assert_eq Str.from_bytes(out.unwrap), t[1]
    # Go's test512Key.Decrypt(nil, ciphertext, nil): PKCS1v15DecryptOptions here.
    out = k.decrypt_g(nil_reader(), decode_base64(t[0]), PKCS1v15DecryptOptions.new, false)
    assert out.ok?, "##{i} error decrypting: #{err_text(out)}"
    assert_eq Str.from_bytes(out.unwrap), t[1]
    i += 1
  }
}

test "EncryptPKCS1v15" {
  k = test1024_key()
  size = (k.n.bit_len + 7) / 8
  src = stream("TestEncryptPKCS1v15")
  for n in 0...60 {
    input = [0.as_u8; n * 3]
    src.read!(input)
    input = input[0...size - 11] if input.size > size - 11
    ct = encrypt_pkcs1v15(crand(), k.public_key, input).unwrap
    # Go alternates a nil and a real reader (both ignored).
    pt = decrypt_pkcs1v15(nil_reader(), k, ct).unwrap
    assert_eq decrypt_pkcs1v15(crand(), k, ct).unwrap, input
    assert_eq pt, input
  }
}

# Generated with `openssl rsautl -pkcs -encrypt`.
def decrypt_pkcs1v15_session_key_tests -> [(Str, Str)] {
  [
    ("e6ukkae6Gykq0fKzYwULpZehX+UPXYzMoB5mHQUDEiclRbOTqas4Y0E6nwns1BBpdvEJcilhl5zsox/6DtGsYg==", "1234"),
    ("Dtis4uk/q/LQGGqGk97P59K03hkCIVFMEFZRgVWOAAhxgYpCRG0MX2adptt92l67IqMki6iVQyyt0TtX3IdtEw==", "FAIL"),
    ("LIyFyCYCptPxrvTxpol8F3M7ZivlMsf53zs0vHRAv+rDIh2YsHS69ePMoPMe3TkOMZ3NupiL3takPxIs1sK+dw==", "abcd"),
    ("bafnobel46bKy76JzqU/RIVOH0uAYvzUtauKmIidKgM0sMlvobYVAVQPeUQ/oTGjbIZ1v/6Gyi5AO4DtHruGdw==", "FAIL"),
  ]
}

test "EncryptPKCS1v15SessionKey" {
  k = test512_key()
  for t in decrypt_pkcs1v15_session_key_tests() {
    key = "FAIL".bytes
    r = decrypt_pkcs1v15_session_key_g(nil_reader(), k, decode_base64(t[0]), key, false)
    assert r.ok?, "error decrypting"
    assert_eq Str.from_bytes(key), t[1]
  }
}

test "EncryptPKCS1v15DecrypterSessionKey" {
  k = test512_key()
  for t in decrypt_pkcs1v15_session_key_tests() {
    pt = k.decrypt_g(crand(), decode_base64(t[0]), PKCS1v15DecryptOptions.new(session_key_len: 4), false).unwrap
    assert_eq pt.size, 4
    assert Str.from_bytes(pt) == t[1] || t[1] == "FAIL", "incorrect plaintext"
  }
}

test "NonZeroRandomBytes" {
  b = [0.as_u8; 512]
  non_zero_random_bytes(b, crand()).unwrap
  for x in b {
    assert x != 0, "Zero octet found"
  }
}

# Tested with `openssl rsautl -verify -inkey pk -in signature | hexdump -C`.
def sign_pkcs1v15_tests -> [(Str, Str)] {
  [("Test.\n", "a4f3fa6ea93bcdd0c57be020c1193ecbfd6f200a3d95c409769b029578fa0e336ad9a347600e40d3ae823b8c7e6bad88cc07c1d54c3a1523cbbb6d58efc362ae")]
}

test "SignPKCS1v15" {
  for t in sign_pkcs1v15_tests() {
    h = sha1.new()
    _ = h.write!(t[0].bytes)
    s = sign_pkcs1v15_g(nil_reader(), test512_key(), crypto.SHA1, h.sum([]), false).unwrap
    assert_eq to_hex(s), t[1]
  }
}

test "VerifyPKCS1v15" {
  for t in sign_pkcs1v15_tests() {
    h = sha1.new()
    _ = h.write!(t[0].bytes)
    r = verify_pkcs1v15_g(test512_key().public_key, crypto.SHA1, h.sum([]), unhex(t[1]), false)
    assert r.ok?, err_text(r)
  }
}

test "OverlongMessagePKCS1v15" {
  ct = decode_base64("fjOVdirUzFoLlukv80dBllMLjXythIf22feqPrNo0YoIjzyzyoMFiLjAc/Y4krkeZ11XFThIrEvw\nkRiZcCq5ng==")
  assert decrypt_pkcs1v15_g(nil_reader(), test512_key(), ct, false).err?, "RSA decrypted a message that was too long."
}

test "UnpaddedSignature" {
  msg = "Thu Dec 19 18:06:16 EST 2013\n".bytes
  # `openssl rsautl -sign -inkey key -out /tmp/sig -in /tmp/msg`
  expected = decode_base64("pX4DR8azytjdQ1rtUiC040FjkepuQut5q2ZFX1pTjBrOVKNjgsCDyiJDGZTCNoh9qpXYbhl7iEym30BWWwuiZg==")
  sig = sign_pkcs1v15_g(nil_reader(), test512_key(), none, msg, false).unwrap
  assert_eq sig, expected
  r = verify_pkcs1v15_g(test512_key().public_key, none, msg, sig, false)
  assert r.ok?, "signature failed to verify: #{err_text(r)}"
}

test "ShortSessionKey" {
  # A too-short ciphertext for the key must not read out of bounds.
  k = test1024_key()
  ct = encrypt_pkcs1v15(crand(), k.public_key, [1]).unwrap
  key = [0.as_u8; 32]
  decrypt_pkcs1v15_session_key(nil_reader(), k, ct, key).unwrap
  for v in key {
    assert v == 0, "key was modified when ciphertext was invalid"
  }
}

test "ShortPKCS1v15Signature" {
  sig = unhex("193a310d0dcf64094c6e3a00c8219b80ded70535473acff72c08e1222974bb24a93a535b1dc4c59fc0e65775df7ba2007dd20e9193f4c4025a18a7070aee93")
  h = sha256.sum256("hello".bytes).to_a
  assert verify_pkcs1v15_g(test_short_pub_key(), crypto.SHA256, h, sig, false).err?, "VerifyPKCS1v15 accepted a truncated signature"
}
