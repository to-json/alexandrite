test "SignPSS vectors test512_key" {
  k = test512_key()
  check_sign_pss(k, crypto.SHA1, 0, "pss test512_key 0 0", "4265df826c4a258111169370a4253305f0b258f613907af3fc2c11befe93a9a0a88c3609bba63bb63e46241f7d5030f97cba67e8db1ea1c198789b5ff449cdd2")
  check_sign_pss(k, crypto.SHA1, -1, "pss test512_key 0 -1", "870305eac4bec90579d4210d01b8d03af3217c647d404c68573e41596b8f1030deb223a7cead32ae3336a4973bee874efe96ec76274a60a6097e59906362dc2c")
  check_sign_pss(k, crypto.SHA1, 0, "pss test512_key 0 0", "4265df826c4a258111169370a4253305f0b258f613907af3fc2c11befe93a9a0a88c3609bba63bb63e46241f7d5030f97cba67e8db1ea1c198789b5ff449cdd2")
  check_sign_pss(k, crypto.SHA1, 7, "pss test512_key 0 7", "a320245e1ee63fba903695ffad762171ba010fa6ffb2cf34e6116aa306e53346494c3d5ef9fce07e414d8da2f08e708655115447a66eca1ddc3be7c4cdd739f2")
  check_sign_pss(k, crypto.SHA224, 0, "pss test512_key 1 0", "339c8525765c2712fed0486d675ada7d546931f5c97e087ccfdc7046ffdfc46abc63df705a843fadb16e933582318b733f54015e81e9c6e1d25bade34fb64eff")
  check_sign_pss(k, crypto.SHA224, -1, "pss test512_key 1 -1", "6ca883f12a0a8b961f8eee93e744372cefcdf68b66db39e7ed421572c3e62e0c199dda7bc27ed37f43e836189e8f878c42a3828f0f8aed41e2127930062e62c7")
  check_sign_pss(k, crypto.SHA224, 0, "pss test512_key 1 0", "339c8525765c2712fed0486d675ada7d546931f5c97e087ccfdc7046ffdfc46abc63df705a843fadb16e933582318b733f54015e81e9c6e1d25bade34fb64eff")
  check_sign_pss(k, crypto.SHA224, 7, "pss test512_key 1 7", "3e70fc08882726a0f229741165e42e3fc0fbc75c7f95addc4ccbd480d6bc301d0893c12ad285e536f61f5439a3fc6ada09417763ea4fcb73754feb2643e7b846")
  check_sign_pss(k, crypto.SHA256, 0, "pss test512_key 2 0", "aa8d40178916ac032a7d01086ded6c00ac8b2297692f36afcc88f59ae76713dbb88a1daa889e034015426b568e85746d8c537c6b0ad99d155b96c1de6601c330")
  check_sign_pss_fails(k, crypto.SHA256, -1, "pss test512_key 2 -1", "crypto/rsa: message too long for RSA key size")
  check_sign_pss(k, crypto.SHA256, 0, "pss test512_key 2 0", "aa8d40178916ac032a7d01086ded6c00ac8b2297692f36afcc88f59ae76713dbb88a1daa889e034015426b568e85746d8c537c6b0ad99d155b96c1de6601c330")
  check_sign_pss(k, crypto.SHA256, 7, "pss test512_key 2 7", "3fc0a5eb48dc85512ce81d48b4aa4f1d10022a4cc579728eb43140dba7a395969a0140065e55ce629be0d01da47a5a4e63a37d0f99b6f2e5924fbc6a239614e1")
