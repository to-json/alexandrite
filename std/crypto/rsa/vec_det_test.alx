test "Encrypt vectors test2048_key" {
  k = test2048_key()
  check_encrypt_oaep(k, crypto.SHA1, "oaep test2048_key 0 0 ", "", "", "")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test2048_key 0 0 orders", "", "orders", "")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test2048_key 0 1 ", "a", "", "")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test2048_key 0 1 orders", "a", "orders", "")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test2048_key 0 2 ", "message to be signed", "", "")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test2048_key 0 2 orders", "message to be signed", "orders", "")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test2048_key 0 3 ", "The quick brown fox jumps over the lazy dog", "", "")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test2048_key 0 3 orders", "The quick brown fox jumps over the lazy dog", "orders", "")
  check_encrypt_oaep(k, crypto.SHA256, "oaep test2048_key 1 0 ", "", "", "")
  check_encrypt_oaep(k, crypto.SHA256, "oaep test2048_key 1 0 orders", "", "orders", "")
  check_encrypt_oaep(k, crypto.SHA256, "oaep test2048_key 1 1 ", "a", "", "")
  check_encrypt_oaep(k, crypto.SHA256, "oaep test2048_key 1 1 orders", "a", "orders", "")
  check_encrypt_oaep(k, crypto.SHA256, "oaep test2048_key 1 2 ", "message to be signed", "", "")
  check_encrypt_oaep(k, crypto.SHA256, "oaep test2048_key 1 2 orders", "message to be signed", "orders", "")
  check_encrypt_oaep(k, crypto.SHA256, "oaep test2048_key 1 3 ", "The quick brown fox jumps over the lazy dog", "", "")
  check_encrypt_oaep(k, crypto.SHA256, "oaep test2048_key 1 3 orders", "The quick brown fox jumps over the lazy dog", "orders", "")
  check_encrypt_oaep(k, crypto.SHA512, "oaep test2048_key 2 0 ", "", "", "")
  check_encrypt_oaep(k, crypto.SHA512, "oaep test2048_key 2 0 orders", "", "orders", "")
  check_encrypt_oaep(k, crypto.SHA512, "oaep test2048_key 2 1 ", "a", "", "")
  check_encrypt_oaep(k, crypto.SHA512, "oaep test2048_key 2 1 orders", "a", "orders", "")
  check_encrypt_oaep(k, crypto.SHA512, "oaep test2048_key 2 2 ", "message to be signed", "", "")
  check_encrypt_oaep(k, crypto.SHA512, "oaep test2048_key 2 2 orders", "message to be signed", "orders", "")
  check_encrypt_oaep(k, crypto.SHA512, "oaep test2048_key 2 3 ", "The quick brown fox jumps over the lazy dog", "", "")
  check_encrypt_oaep(k, crypto.SHA512, "oaep test2048_key 2 3 orders", "The quick brown fox jumps over the lazy dog", "orders", "")
  check_encrypt_pkcs1v15(k, "pkcs1 test2048_key 0", "", "")
  check_encrypt_pkcs1v15(k, "pkcs1 test2048_key 1", "a", "")
  check_encrypt_pkcs1v15(k, "pkcs1 test2048_key 2", "message to be signed", "")
  check_encrypt_pkcs1v15(k, "pkcs1 test2048_key 3", "The quick brown fox jumps over the lazy dog", "")
}

test "Encrypt vectors test_p_smaller_than_q_key" {
  k = test_p_smaller_than_q_key()
  check_encrypt_oaep(k, crypto.SHA1, "oaep test_p_smaller_than_q_key 0 0 ", "", "", "34ebcfb5cb7b0ca5b28e171425d485395d2ddc88aa03cd6adb64560a2232ee4506889c40825f54ce740cd0c00fdb5620b746593f212c2e49a89b03ed5e547898")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test_p_smaller_than_q_key 0 0 orders", "", "orders", "63c3dad60c6881d9313331aa32333a9c632464b2b132dd69b495e15cfef3bdc610b05d0d9ef9bc8ab3e7623c2c3dbf46c8c6d1fdc5c3ede4f36a51343cb86419")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test_p_smaller_than_q_key 0 1 ", "a", "", "8a700eb358a2358604c1b6b34798156837bd96bdf34546ad0dfe494fe679a7d9e6ea2f15c4e69ec550751b3926cc3cf068627b3e143042c139f8ad9fc85530ae")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test_p_smaller_than_q_key 0 1 orders", "a", "orders", "51a50d65ad1e8c275f17c8c34874375c012fa32fa0520c582a5c23b8771338e05b0f20f878901b6638303d2aea6283ee50bd90f64caf358c924543ec815bc952")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test_p_smaller_than_q_key 0 2 ", "message to be signed", "", "2857127e89bea2bb6510bd839829e08f62f0f224b7a263ae3a4c3a59f6045c98f7d0d047bc572e735a3ab09477a34b74a4c174ab4c49df8a37935c3a332f156d")
