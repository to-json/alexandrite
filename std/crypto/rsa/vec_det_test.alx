test "SignPKCS1v15 vectors test2048_key" {
  k = test2048_key()
  check_sign_pkcs1v15(k, crypto.MD5, "", "")
  check_sign_pkcs1v15(k, crypto.MD5, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA1, "", "")
  check_sign_pkcs1v15(k, crypto.SHA1, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA224, "", "")
  check_sign_pkcs1v15(k, crypto.SHA224, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA256, "", "")
  check_sign_pkcs1v15(k, crypto.SHA256, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA384, "", "")
  check_sign_pkcs1v15(k, crypto.SHA384, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA512, "", "")
  check_sign_pkcs1v15(k, crypto.SHA512, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA512_224, "", "")
  check_sign_pkcs1v15(k, crypto.SHA512_224, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA512_256, "", "")
  check_sign_pkcs1v15(k, crypto.SHA512_256, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA3_224, "", "")
  check_sign_pkcs1v15(k, crypto.SHA3_224, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA3_256, "", "")
  check_sign_pkcs1v15(k, crypto.SHA3_256, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA3_384, "", "")
  check_sign_pkcs1v15(k, crypto.SHA3_384, "a", "")
  check_sign_pkcs1v15(k, crypto.SHA3_512, "", "")
  check_sign_pkcs1v15(k, crypto.SHA3_512, "a", "")
  check_sign_pkcs1v15_raw(k, "raw message", "")
}

test "SignPKCS1v15 vectors test_p_smaller_than_q_key" {
  k = test_p_smaller_than_q_key()
  check_sign_pkcs1v15(k, crypto.MD5, "", "756b14e62aa5f827101bb340ca6981941d09a0e912cb1506399cfcba62100c4b3f45dcedbe31b4a6b85898f10c80a2d35d142bbd11bb313ad30fa4cdbf9fe8d2")
  check_sign_pkcs1v15(k, crypto.MD5, "a", "4823b8248ef5df903c52eff204ea9f7b794570f41900e23ad95c53a5bdf457f709d86f7921c0431f93899e319b0016f412092771909582d1ad71033ac60cd603")
  check_sign_pkcs1v15(k, crypto.SHA1, "", "a0b5674179dc226dabc88597cc48db414b06959b852454272315054b214582a2185a9b09d366881567364a3cd86477b11dc51b84e5245d3bed7c97315c0005f5")
  check_sign_pkcs1v15(k, crypto.SHA1, "a", "3cd9cd9ca595fcfdd350900eed5488623e12ababc7dc9173859e44b1ff147f2a8acdfcef4b25561cd64068e6183a6e2a8eb97d67e406abce1be29270cf2bf1aa")
  check_sign_pkcs1v15(k, crypto.SHA224, "", "4984696a992c89f32579d1b0187cb509501e5c03f0fa03693ff0a96b10c9b968d9ce64f3fc906a93e18034c9772db4f4cc5e63931918b84ef82e3aec85ff24ce")
  check_sign_pkcs1v15(k, crypto.SHA224, "a", "303e7e65436f5c55e2ad797cfe7c1ed6867d61e65b338f3dde0565309217457e0c8be97341889de988c22e68568cdad4761eee142ad2ea7ced3b18d17a2414f1")
  check_sign_pkcs1v15(k, crypto.SHA256, "", "71bde8ed9e281c55d882b6e797013951f2dbd5d8fa6a28df0ba80e0d46d5c5beec9b065953bdd3d2e38f4f140f8d2abbcca42fe0e816de402175632beb7b081a")
  check_sign_pkcs1v15(k, crypto.SHA256, "a", "18ac0ce38a7d2f5e59b07c3f521c6c0e1073b0ed5a960f24ef793ed4d5c8de068a78a358d5b9f42ec9e5d9d7c9157096c106ae8a5fcf9e7105993c679b4505df")
  check_sign_pkcs1v15_fails(k, crypto.SHA384, "", "crypto/rsa: message too long for RSA key size")
