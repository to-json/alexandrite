# Generated from Go's crypto/rsa (fixed keys; GODEBUG=cryptocustomrand=1 with a SHAKE256 stream as rand); do not edit by hand.

test "SignPKCS1v15 vectors test512_key" {
  k = test512_key()
  check_sign_pkcs1v15(k, crypto.MD5, "", "7b543d560bc35eee8062c90f73fe42d373f0af1da4e6ab6cc17b405e1f500b30ea32757f6394f1b2d203cec5b9f37035550000b3892068e86c2108912ca747b7")
  check_sign_pkcs1v15(k, crypto.MD5, "a", "a7517adf550269442ee3ddb67fac22de450c5523c04ec2df971ba2d82ec9bf8e5196ff6a1a1ec925234be54a3c7a06a7f719e28dea9603aa6456558eec5792f7")
  check_sign_pkcs1v15(k, crypto.SHA1, "", "94c09d9e4766a45c1b0a4ec9de58dc085f933356d25d3430fc4eaa4b3440217701bb57f167b3139951de193da621848391f326e09482b08f46c55aa056eaad39")
  check_sign_pkcs1v15(k, crypto.SHA1, "a", "8f09e2a9f8d1eed9122b38f491f11a2e8ea5f4c942830e3913d3ca242d3ae159e63c203ebbf9e3abe7ede9f223043e4b03d989e87061a2ff6f9ea2b77b6484d7")
  check_sign_pkcs1v15(k, crypto.SHA224, "", "0b12be9455215ee0611006746033f126c1d1b29087b8864ccc3c6fa5edec2db2a47fc03875941b9c38f9a54de01d48ccadf2e1a75c13f5e562777cf8b9b67722")
  check_sign_pkcs1v15(k, crypto.SHA224, "a", "55a8c580b990d3f86daba82daf6fcbaa5843eb9a08f30a599dc3d79c06bc36130b3d8556d2601b2e90a80021105604be07e79269c579a99a78b4fac186c634e7")
  check_sign_pkcs1v15(k, crypto.SHA256, "", "304df493d49e5a286159770be81b14eb70a2361b1fd1c34f6b55a1a5c94d39ea525487c46f3fce0b52b802b4fbd8c041d7286f5c81d361960cdc4e22577c1b0b")
  check_sign_pkcs1v15(k, crypto.SHA256, "a", "2b61b3c0791c026d1087351f8f8b99d0366b6adeca7a377664396722ecddc092172e092e9e2a1ae0fd0b154c087d22f69792545a25c8d58c8ba6aedfdc9aab5a")
  check_sign_pkcs1v15_fails(k, crypto.SHA384, "", "crypto/rsa: message too long for RSA key size")
  check_sign_pkcs1v15_fails(k, crypto.SHA384, "a", "crypto/rsa: message too long for RSA key size")
  check_sign_pkcs1v15_fails(k, crypto.SHA512, "", "crypto/rsa: message too long for RSA key size")
  check_sign_pkcs1v15_fails(k, crypto.SHA512, "a", "crypto/rsa: message too long for RSA key size")
  check_sign_pkcs1v15(k, crypto.SHA512_224, "", "6c9df7e1b5c489f0e387025f9f436782be056ee724b891926495622a39acb4629bd96e1f6b4ae9707cc883a56ac80e845cbdcadda768202509213fcc643a08b7")
  check_sign_pkcs1v15(k, crypto.SHA512_224, "a", "a9eb41f54f6aa12580dd3cf4c6c09d71fb7637e1f232b2e556ed5264a6e370239bb20cd97f285f5f72c08a43daf504dc19c15da83643bce001cfb7a77009ba12")
  check_sign_pkcs1v15(k, crypto.SHA512_256, "", "7f8e3890767cc877fe8ac1bb3ce61bc11ec15b2b621b08b912b75f7ea79283646f6a3107669fc03aac040fbe9a4e4fd657bb1adfdd9b17d09565afce5199a3d1")
  check_sign_pkcs1v15(k, crypto.SHA512_256, "a", "6e0980acb4981b62d23970dff2c847f1c22e96bd6801d53ccf8e3d0a32ed2a772a6a4480972506712bbb75b3afda479420ef20d1aa91ce0e82ddc93d4a18dfa1")
  check_sign_pkcs1v15(k, crypto.SHA3_224, "", "8e23834ecb8ed8aec727911ac4b18897e9ce79f70015b7b2a419b6cdbf1cbe8a02d265c3fce16920dae564ba76f5ddce594becca59c0fd926e067074721472ae")
  check_sign_pkcs1v15(k, crypto.SHA3_224, "a", "73170b24bc77837bd17534559bbffed947bebdaf9c5f800f5271ed2a8a9ffea665dd2e6fd8037b2c6fae7eb82bd29d9105521e50d8125c5e3aa3dfd24605cd79")
  check_sign_pkcs1v15(k, crypto.SHA3_256, "", "31d3922c4ddedef869a03bc66a580c0dc8ed64675b0fa62754333ac6cad91b005a35aa54cecd050462732e5b4f379ecfcfe5234a57c0e40a64119928bd24a04b")
  check_sign_pkcs1v15(k, crypto.SHA3_256, "a", "b0e5bace40e49daabb757c21da8e6d1aafa989736c5e605a15b7fe6d8d30d56d7b6a7b8f890aa57288ffa034997dd99908f8b34b5cb122b92a7686c9a1ceaa3b")
  check_sign_pkcs1v15_fails(k, crypto.SHA3_384, "", "crypto/rsa: message too long for RSA key size")
  check_sign_pkcs1v15_fails(k, crypto.SHA3_384, "a", "crypto/rsa: message too long for RSA key size")
  check_sign_pkcs1v15_fails(k, crypto.SHA3_512, "", "crypto/rsa: message too long for RSA key size")
  check_sign_pkcs1v15_fails(k, crypto.SHA3_512, "a", "crypto/rsa: message too long for RSA key size")
  check_sign_pkcs1v15_raw(k, "raw message", "4a271dc28ce647fc5e3ccb3d8ca8c45d29f623c157c3a74fff1b9dddabf4e1822d68e158c9f078431287be5697c250b404266d9392c00940165f67ee7b2797b1")
}

