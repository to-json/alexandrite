test "Encrypt vectors test512_key" {
  k = test512_key()
  check_encrypt_oaep(k, crypto.SHA1, "oaep test512_key 0 0 ", "", "", "235f858f0726af05d36508aef4410dee0584fb9681d4b13c912e69aefbf63117c714fc084be8f5037b84bcd92e49697684a654072a8438fb3ff94622d8fd1e78")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test512_key 0 0 orders", "", "orders", "00b9b14f0facb5faa89803f21b475badc439da198653d9f4bb6921feb0557fd289983c8537aff46c3cf897bb5c2103004e353a6ab95a39b40a30e5530526cb9d")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test512_key 0 1 ", "a", "", "a2ec6c1c134b428deeb162f7e1d41048b6922c0732e87f9178addd42aee194260a553afc3f9dd99682d8a27e6421d0ddfddcc7b6a66ce76b6c26f80e3265749d")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test512_key 0 1 orders", "a", "orders", "2fc15c512dcdd74a0008a803597e4018552a0bc70fc33498f944ea98d2f2fb27299002ba84edc7b30cdb95e250e4ead3c026dd1ad64087f6179028588a144ec6")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test512_key 0 2 ", "message to be signed", "", "8339b223560705097f75f9c80a3f152851a1df0b096739dfa4615a872f3093dd018ecd298fb3e58e847c480681a52f440991b0a8ce4db81b2d1a745ab0fad0ad")
  check_encrypt_oaep(k, crypto.SHA1, "oaep test512_key 0 2 orders", "message to be signed", "orders", "6de7e85906127242cb16afbe44cbe43277bc4396b3721dd464d24e9d42805ad17539aadb1528d48cb26fe7516f87b2a07c6e32884b5dc8298896ba2fb1469572")
  check_encrypt_oaep_fails(k, crypto.SHA1, "oaep test512_key 0 3 ", "The quick brown fox jumps over the lazy dog", "", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA1, "oaep test512_key 0 3 orders", "The quick brown fox jumps over the lazy dog", "orders", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA256, "oaep test512_key 1 0 ", "", "", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA256, "oaep test512_key 1 0 orders", "", "orders", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA256, "oaep test512_key 1 1 ", "a", "", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA256, "oaep test512_key 1 1 orders", "a", "orders", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA256, "oaep test512_key 1 2 ", "message to be signed", "", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA256, "oaep test512_key 1 2 orders", "message to be signed", "orders", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA256, "oaep test512_key 1 3 ", "The quick brown fox jumps over the lazy dog", "", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA256, "oaep test512_key 1 3 orders", "The quick brown fox jumps over the lazy dog", "orders", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA512, "oaep test512_key 2 0 ", "", "", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA512, "oaep test512_key 2 0 orders", "", "orders", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA512, "oaep test512_key 2 1 ", "a", "", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA512, "oaep test512_key 2 1 orders", "a", "orders", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA512, "oaep test512_key 2 2 ", "message to be signed", "", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA512, "oaep test512_key 2 2 orders", "message to be signed", "orders", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA512, "oaep test512_key 2 3 ", "The quick brown fox jumps over the lazy dog", "", "crypto/rsa: message too long for RSA key size")
  check_encrypt_oaep_fails(k, crypto.SHA512, "oaep test512_key 2 3 orders", "The quick brown fox jumps over the lazy dog", "orders", "crypto/rsa: message too long for RSA key size")
  check_encrypt_pkcs1v15(k, "pkcs1 test512_key 0", "", "08e5bc36ccccf6964c7b14c68b9267419d6e5e9cfd9bac362fcf623d466821fc361a81cdf7866dad2418449735ebdbfc92b7b34ecec598878f646e66dec60448")
  check_encrypt_pkcs1v15(k, "pkcs1 test512_key 1", "a", "0a942399253147073a21f01784a9a814329e6aca0f611b397c6fa105645d923c1fa44336d506562fbadd60352e72f8bf79688c2f1a8be94b29e5df216346159f")
  check_encrypt_pkcs1v15(k, "pkcs1 test512_key 2", "message to be signed", "2cda457c619d9365c6eb6c6c33ce17e0e4affe5e966d754b6b7a3921e7a12765e4a3d66a48bfb17f419f95227a9b836cfc5ba423b28396398ef2e746cff621df")
  check_encrypt_pkcs1v15(k, "pkcs1 test512_key 3", "The quick brown fox jumps over the lazy dog", "9f81566b77c3f22bef0d06e2432bcf893cb7baed24b0cf8a1e0f35751a53c195f7582085a5bc32e3a1f939bf1696cd4c41cd88615ea02d77b7f50c447ca29551")
}

