test "SignPSS vectors test2048_key" {
  k = test2048_key()
  check_sign_pss(k, crypto.SHA1, 0, "pss test2048_key 0 0", "")
  check_sign_pss(k, crypto.SHA1, -1, "pss test2048_key 0 -1", "")
  check_sign_pss(k, crypto.SHA1, 0, "pss test2048_key 0 0", "")
  check_sign_pss(k, crypto.SHA1, 7, "pss test2048_key 0 7", "")
  check_sign_pss(k, crypto.SHA224, 0, "pss test2048_key 1 0", "")
  check_sign_pss(k, crypto.SHA224, -1, "pss test2048_key 1 -1", "")
  check_sign_pss(k, crypto.SHA224, 0, "pss test2048_key 1 0", "")
  check_sign_pss(k, crypto.SHA224, 7, "pss test2048_key 1 7", "")
  check_sign_pss(k, crypto.SHA256, 0, "pss test2048_key 2 0", "")
  check_sign_pss(k, crypto.SHA256, -1, "pss test2048_key 2 -1", "")
  check_sign_pss(k, crypto.SHA256, 0, "pss test2048_key 2 0", "")
  check_sign_pss(k, crypto.SHA256, 7, "pss test2048_key 2 7", "")
  check_sign_pss(k, crypto.SHA384, 0, "pss test2048_key 3 0", "")
  check_sign_pss(k, crypto.SHA384, -1, "pss test2048_key 3 -1", "")
  check_sign_pss(k, crypto.SHA384, 0, "pss test2048_key 3 0", "")
  check_sign_pss(k, crypto.SHA384, 7, "pss test2048_key 3 7", "")
  check_sign_pss(k, crypto.SHA512, 0, "pss test2048_key 4 0", "")
  check_sign_pss(k, crypto.SHA512, -1, "pss test2048_key 4 -1", "")
  check_sign_pss(k, crypto.SHA512, 0, "pss test2048_key 4 0", "")
  check_sign_pss(k, crypto.SHA512, 7, "pss test2048_key 4 7", "")
  check_sign_pss(k, crypto.SHA512_224, 0, "pss test2048_key 5 0", "")
  check_sign_pss(k, crypto.SHA512_224, -1, "pss test2048_key 5 -1", "")
  check_sign_pss(k, crypto.SHA512_224, 0, "pss test2048_key 5 0", "")
  check_sign_pss(k, crypto.SHA512_224, 7, "pss test2048_key 5 7", "")
  check_sign_pss(k, crypto.SHA512_256, 0, "pss test2048_key 6 0", "")
  check_sign_pss(k, crypto.SHA512_256, -1, "pss test2048_key 6 -1", "")
  check_sign_pss(k, crypto.SHA512_256, 0, "pss test2048_key 6 0", "")
  check_sign_pss(k, crypto.SHA512_256, 7, "pss test2048_key 6 7", "")
  check_sign_pss(k, crypto.SHA3_224, 0, "pss test2048_key 7 0", "")
  check_sign_pss(k, crypto.SHA3_224, -1, "pss test2048_key 7 -1", "")
  check_sign_pss(k, crypto.SHA3_224, 0, "pss test2048_key 7 0", "")
  check_sign_pss(k, crypto.SHA3_224, 7, "pss test2048_key 7 7", "")
  check_sign_pss(k, crypto.SHA3_256, 0, "pss test2048_key 8 0", "")
  check_sign_pss(k, crypto.SHA3_256, -1, "pss test2048_key 8 -1", "")
  check_sign_pss(k, crypto.SHA3_256, 0, "pss test2048_key 8 0", "")
  check_sign_pss(k, crypto.SHA3_256, 7, "pss test2048_key 8 7", "")
  check_sign_pss(k, crypto.SHA3_384, 0, "pss test2048_key 9 0", "")
  check_sign_pss(k, crypto.SHA3_384, -1, "pss test2048_key 9 -1", "")
  check_sign_pss(k, crypto.SHA3_384, 0, "pss test2048_key 9 0", "")
  check_sign_pss(k, crypto.SHA3_384, 7, "pss test2048_key 9 7", "")
  check_sign_pss(k, crypto.SHA3_512, 0, "pss test2048_key 10 0", "")
  check_sign_pss(k, crypto.SHA3_512, -1, "pss test2048_key 10 -1", "")
  check_sign_pss(k, crypto.SHA3_512, 0, "pss test2048_key 10 0", "")
  check_sign_pss(k, crypto.SHA3_512, 7, "pss test2048_key 10 7", "")
}

