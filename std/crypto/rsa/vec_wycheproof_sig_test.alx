test "Wycheproof PKCS1 signatures rsa_signature_3072_sha3_384 4" {
  p = make_pub("", 65537)
  check_wp_sig(p, crypto.SHA3_384, "", "", true)                                                                 # 1
  check_wp_sig(p, crypto.SHA3_384, "0000000000000000000000000000000000000000", "", true)                         # 2
  check_wp_sig(p, crypto.SHA3_384, "54657374", "", true)                                                         # 3
  check_wp_sig(p, crypto.SHA3_384, "313233343030", "", true)                                                     # 4
  check_wp_sig(p, crypto.SHA3_384, "4d657373616765", "", true)                                                   # 5
  check_wp_sig(p, crypto.SHA3_384, "61", "", true)                                                               # 6
