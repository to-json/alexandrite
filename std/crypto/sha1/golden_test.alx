# Go's crypto/sha1 test tables, extracted from sha1_test.go (go1.27.1); do not edit by hand.

import "encoding/hex"

struct Golden {
  out: Str
  input: [Byte]
  half_state: [Byte]
}

struct UnmarshalTest {
  state: [Byte]
  sum: Str
}

def b(s: Str) -> [Byte] { s.bytes.to_a }

def hx(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

