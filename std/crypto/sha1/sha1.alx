#![overflow(wrap)]
# Package sha1: Go's crypto/sha1, the SHA-1 hash algorithm of RFC 3174.
# SHA-1 is cryptographically broken and should not be used for secure
# applications. Pure alx: the generic (non-assembly) code of Go's crypto/sha1.
#
#   Go                                  alx
#   sha1.Size / BlockSize               SIZE / BLOCK_SIZE
#   sha1.New() hash.Hash                new() -> Digest
#   sha1.Sum(data) [Size]byte           sum(data) -> [Byte; 20]
#   d.Write(p) (int, error)             d.write!(p) -> Int (never fails)
#   d.Sum(b) / Reset / Size / BlockSize d.sum(b) / d.reset! / d.size / d.block_size
#   d.ConstantTimeSum(b) (unexported)   d.constant_time_sum(b)
#   d.MarshalBinary / AppendBinary      d.marshal_binary / d.append_binary(b) (never fail)
#   d.UnmarshalBinary(b) error          d.unmarshal_binary!(b) -> ~Unit<StateError>
#   d.Clone() (hash.Cloner, error)      d.clone -> Digest
#
# A Digest satisfies hash.Hash structurally.
#
# Differences from Go:
#   - New returns the concrete Digest (Go: hash.Hash; Go's digest type is
#     unexported); it converts to a hash.Hash wherever one is wanted.
#     crypto.SHA1.new gives a hash.Hash.
#   - No registration with package crypto at init (alx has no init
#     functions); package crypto knows the hashes it can make.
#   - A Digest keeps its state in shared storage (GO-VS-RUBY D36): copies of
#     a Digest are the same hash, as Go's pointer is; `clone` makes an
#     independent one. Use new: a zero `Digest.new` has no state.
#   - Clone, MarshalBinary and AppendBinary can't fail, so they return plain
#     values. No BoringCrypto or FIPS 140-only mode, no assembly; the
#     compression function is Go's blockGeneric with its rounds unrolled
#     (sha1block.alx).
#   - constant_time_sum is public (Go's is an unexported method that
#     crypto/tls finds through an interface).

# The size of a SHA-1 checksum in bytes.
pub SIZE = 20
# The blocksize of SHA-1 in bytes.
pub BLOCK_SIZE = 64

CHUNK = 64
MAGIC = "sha\x01"
MARSHALED_SIZE = 4 + 5 * 4 + CHUNK + 8

# Errors of Digest.unmarshal_binary!.
pub error StateError {
  InvalidIdentifier
  InvalidSize

  def message -> Str {
    case self {
      InvalidIdentifier => "crypto/sha1: invalid hash state identifier"
      InvalidSize => "crypto/sha1: invalid hash state size"
    }
  }
}

def append_be32(b: [Byte], v: U32) -> [Byte] {
  out = b
  out << (v >> 24).as_u8
  out << (v >> 16).as_u8
  out << (v >> 8).as_u8
  out << v.as_u8
  out
}

def be32(b: [Byte], i: Int) -> U32 {
  (b[i].as_u32 << 24) | (b[i + 1].as_u32 << 16) | (b[i + 2].as_u32 << 8) | b[i + 3].as_u32
}

# Whether b starts with the bytes of s.
def has_magic(b: [Byte], s: Str) -> Bool {
  return false if b.size < s.size
  i = 0
  while i < s.size {
    return false if b[i] != s[i]
    i += 1
  }
  true
}

# A new SHA-1 hash.
pub def new -> Digest {
  d = Digest.new(h: [0.as_u32; 5], x: [0.as_u8; CHUNK], n: [0.as_u64; 2])
  d.reset!
  d
}

# The SHA-1 checksum of data.
pub def sum(data: [Byte]) -> [Byte; 20] {
  d = new()
  d.write!(data)
  out: [Byte; 20] = [0; 20]
  copy(out[0...20], d.check_sum)
  out
}

# A running SHA-1 hash.
pub struct Digest {
  # The chaining state.
  h: [U32]
  # The partial block.
  x: [Byte]
  # n[0]: bytes in x; n[1]: total bytes written.
  n: [U64]

  # The checksum size in bytes: 20.
  pub def size -> Int { SIZE }

  # The block size: 64.
  pub def block_size -> Int { BLOCK_SIZE }

  # Back to the initial state.
  pub def reset! {
    self.h[0] = 0x67452301
    self.h[1] = 0xEFCDAB89
    self.h[2] = 0x98BADCFE
    self.h[3] = 0x10325476
    self.h[4] = 0xC3D2E1F0
    self.n[0] = 0
    self.n[1] = 0
    nil
  }

  # Adds p to the running hash; returns p.size.
  pub def write!(p: [Byte]) -> Int {
    nn = p.size
    self.n[1] = n[1] + nn.as_u64
    nx = n[0].to_i
    off = 0
    if nx > 0 {
      k = CHUNK - nx
      k = nn if k > nn
      copy(x[nx...nx + k], p[0...k])
      nx += k
      if nx == CHUNK {
        block(h, x, 0, CHUNK)
        nx = 0
      }
      off = k
    }
    rest = nn - off
    if rest >= CHUNK {
      m = rest & ^(CHUNK - 1)
      block(h, p, off, m)
      off += m
    }
    if off < nn {
      nx = nn - off
      copy(x[0...nx], p[off...nn])
    }
    self.n[0] = nx.as_u64
    nn
  }

  # The padded final digest of a copy of the state (Go's checkSum).
  def check_sum -> [Byte] {
    d = clone
    len = d.n[1]
    tmp = [0.as_u8; 72]
    tmp[0] = 0x80
    t = len % 64 < 56 ? 56 - len % 64 : 64 + 56 - len % 64
    ti = t.to_i
    bits = len << 3
    j = 0
    while j < 8 {
      tmp[ti + j] = (bits >> (56 - 8 * j).as_u64).as_u8
      j += 1
    }
    d.write!(tmp[0...ti + 8])
    panic("d.nx != 0") if d.n[0] != 0
    out: [Byte] = []
    i = 0
    while i < 5 {
      out = append_be32(out, d.h[i])
      i += 1
    }
    out
  }

  # b with the current hash appended. The state is unchanged.
  pub def sum(b: [Byte]) -> [Byte] {
    b + check_sum
  }

  # Like sum, but the padding and the final blocks take the same time
  # whatever the length of the data (Go's ConstantTimeSum, for TLS's
  # Lucky13 countermeasures).
  pub def constant_time_sum(b: [Byte]) -> [Byte] {
    d = clone
    b + d.const_sum!
  }

  # Go's constSum: on a copy of the state.
  def const_sum! -> [Byte] {
    length = [0.as_u8; 8]
    l = n[1] << 3
    i = 0
    while i < 8 {
      length[i] = (l >> (56 - 8 * i).as_u64).as_u8
      i += 1
    }
    nx = n[0].as_u8
    t = nx - 56
    mask1b = (t.as_i8 >> 7).as_u8
    separator: Byte = 0x80
    i = 0
    while i < CHUNK {
      mask = (i.as_u8 - nx).as_i8 >> 7
      m = mask.as_u8
      self.x[i] = (^m & separator) | (m & x[i])
      separator &= m
      if i >= 56 {
        self.x[i] = x[i] | (mask1b & length[i - 56])
      }
      i += 1
    }
    block(h, x, 0, CHUNK)
    digest = [0.as_u8; SIZE]
    i = 0
    while i < 5 {
      s = h[i]
      digest[i * 4] = mask1b & (s >> 24).as_u8
      digest[i * 4 + 1] = mask1b & (s >> 16).as_u8
      digest[i * 4 + 2] = mask1b & (s >> 8).as_u8
      digest[i * 4 + 3] = mask1b & s.as_u8
      i += 1
    }
    i = 0
    while i < CHUNK {
      if i < 56 {
        self.x[i] = separator
        separator = 0
      } else {
        self.x[i] = length[i - 56]
      }
      i += 1
    }
    block(h, x, 0, CHUNK)
    i = 0
    while i < 5 {
      s = h[i]
      digest[i * 4] = digest[i * 4] | (^mask1b & (s >> 24).as_u8)
      digest[i * 4 + 1] = digest[i * 4 + 1] | (^mask1b & (s >> 16).as_u8)
      digest[i * 4 + 2] = digest[i * 4 + 2] | (^mask1b & (s >> 8).as_u8)
      digest[i * 4 + 3] = digest[i * 4 + 3] | (^mask1b & s.as_u8)
      i += 1
    }
    digest
  }

  # An independent copy of the hash in its current state.
  pub def clone -> Digest {
    Digest.new(h: h + [], x: x + [], n: n + [])
  }

  # b with the marshaled state appended (Go's AppendBinary).
  pub def append_binary(b: [Byte]) -> [Byte] {
    out = b + MAGIC.bytes.to_a
    i = 0
    while i < 5 {
      out = append_be32(out, h[i])
      i += 1
    }
    nx = n[0].to_i
    out = out + x[0...nx]
    out = out + [0.as_u8; CHUNK - nx]
    out = append_be32(out, (n[1] >> 32).as_u32)
    append_be32(out, n[1].as_u32)
  }

  # The marshaled state (Go's MarshalBinary).
  pub def marshal_binary -> [Byte] {
    append_binary([])
  }

  # Restores a state from marshal_binary.
  pub def unmarshal_binary!(b: [Byte]) -> ~Unit<StateError> {
    fail StateError.InvalidIdentifier if !has_magic(b, MAGIC)
    fail StateError.InvalidSize if b.size != MARSHALED_SIZE
    i = 0
    while i < 5 {
      self.h[i] = be32(b, 4 + 4 * i)
      i += 1
    }
    copy(x, b[24...24 + CHUNK])
    len = (be32(b, 88).as_u64 << 32) | be32(b, 92).as_u64
    self.n[1] = len
    self.n[0] = len % CHUNK.as_u64
  }
}
