    c = ((c << 30) | (c >> 2))
    tmp = w14 ^ w9 ^ w3 ^ w1
    w1 = (tmp << 1) | (tmp >> 31)
    e += ((a << 5) | (a >> 27)) + (b ^ c ^ d) + w1 + 0xCA62C1D6
    b = ((b << 30) | (b >> 2))
    tmp = w15 ^ w10 ^ w4 ^ w2
