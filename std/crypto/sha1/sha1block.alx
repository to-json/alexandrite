#![overflow(wrap)]
# The SHA-1 compression function: Go's blockGeneric with its 80 rounds
# unrolled and the 16-word schedule kept in locals (w0..w15), so the hot
# loop does no array indexing. Each round is Go's loop body; the five
# working variables rotate their roles instead of being shifted.

# Runs the compression function over the 64-byte blocks of
# p[off...off + n] (n a multiple of 64), updating h.
def block(h: [U32], p: [Byte], off: Int, n: Int) {
  h0 = h[0]
  h1 = h[1]
  h2 = h[2]
  h3 = h[3]
  h4 = h[4]
  i = off
  last = off + n
  while i < last {
    q = p[i...i + 64]
    w0 = (q[0].as_u32 << 24) | (q[1].as_u32 << 16) | (q[2].as_u32 << 8) | q[3].as_u32
    w1 = (q[4].as_u32 << 24) | (q[5].as_u32 << 16) | (q[6].as_u32 << 8) | q[7].as_u32
    w2 = (q[8].as_u32 << 24) | (q[9].as_u32 << 16) | (q[10].as_u32 << 8) | q[11].as_u32
    w3 = (q[12].as_u32 << 24) | (q[13].as_u32 << 16) | (q[14].as_u32 << 8) | q[15].as_u32
    w4 = (q[16].as_u32 << 24) | (q[17].as_u32 << 16) | (q[18].as_u32 << 8) | q[19].as_u32
    w5 = (q[20].as_u32 << 24) | (q[21].as_u32 << 16) | (q[22].as_u32 << 8) | q[23].as_u32
    w6 = (q[24].as_u32 << 24) | (q[25].as_u32 << 16) | (q[26].as_u32 << 8) | q[27].as_u32
    w7 = (q[28].as_u32 << 24) | (q[29].as_u32 << 16) | (q[30].as_u32 << 8) | q[31].as_u32
    w8 = (q[32].as_u32 << 24) | (q[33].as_u32 << 16) | (q[34].as_u32 << 8) | q[35].as_u32
    w9 = (q[36].as_u32 << 24) | (q[37].as_u32 << 16) | (q[38].as_u32 << 8) | q[39].as_u32
    w10 = (q[40].as_u32 << 24) | (q[41].as_u32 << 16) | (q[42].as_u32 << 8) | q[43].as_u32
    w11 = (q[44].as_u32 << 24) | (q[45].as_u32 << 16) | (q[46].as_u32 << 8) | q[47].as_u32
    w12 = (q[48].as_u32 << 24) | (q[49].as_u32 << 16) | (q[50].as_u32 << 8) | q[51].as_u32
    w13 = (q[52].as_u32 << 24) | (q[53].as_u32 << 16) | (q[54].as_u32 << 8) | q[55].as_u32
    w14 = (q[56].as_u32 << 24) | (q[57].as_u32 << 16) | (q[58].as_u32 << 8) | q[59].as_u32
    w15 = (q[60].as_u32 << 24) | (q[61].as_u32 << 16) | (q[62].as_u32 << 8) | q[63].as_u32
    a = h0
    b = h1
    c = h2
    d = h3
    e = h4
    e += ((a << 5) | (a >> 27)) + ((b & c) | (^b & d)) + w0 + 0x5A827999
    b = ((b << 30) | (b >> 2))
    d += ((e << 5) | (e >> 27)) + ((a & b) | (^a & c)) + w1 + 0x5A827999
    a = ((a << 30) | (a >> 2))
    c += ((d << 5) | (d >> 27)) + ((e & a) | (^e & b)) + w2 + 0x5A827999
    e = ((e << 30) | (e >> 2))
    b += ((c << 5) | (c >> 27)) + ((d & e) | (^d & a)) + w3 + 0x5A827999
    d = ((d << 30) | (d >> 2))
    a += ((b << 5) | (b >> 27)) + ((c & d) | (^c & e)) + w4 + 0x5A827999
    c = ((c << 30) | (c >> 2))
    e += ((a << 5) | (a >> 27)) + ((b & c) | (^b & d)) + w5 + 0x5A827999
    b = ((b << 30) | (b >> 2))
    d += ((e << 5) | (e >> 27)) + ((a & b) | (^a & c)) + w6 + 0x5A827999
    a = ((a << 30) | (a >> 2))
    c += ((d << 5) | (d >> 27)) + ((e & a) | (^e & b)) + w7 + 0x5A827999
    e = ((e << 30) | (e >> 2))
    b += ((c << 5) | (c >> 27)) + ((d & e) | (^d & a)) + w8 + 0x5A827999
    d = ((d << 30) | (d >> 2))
    a += ((b << 5) | (b >> 27)) + ((c & d) | (^c & e)) + w9 + 0x5A827999
    c = ((c << 30) | (c >> 2))
    e += ((a << 5) | (a >> 27)) + ((b & c) | (^b & d)) + w10 + 0x5A827999
    b = ((b << 30) | (b >> 2))
    d += ((e << 5) | (e >> 27)) + ((a & b) | (^a & c)) + w11 + 0x5A827999
    a = ((a << 30) | (a >> 2))
    c += ((d << 5) | (d >> 27)) + ((e & a) | (^e & b)) + w12 + 0x5A827999
    e = ((e << 30) | (e >> 2))
    b += ((c << 5) | (c >> 27)) + ((d & e) | (^d & a)) + w13 + 0x5A827999
    d = ((d << 30) | (d >> 2))
    a += ((b << 5) | (b >> 27)) + ((c & d) | (^c & e)) + w14 + 0x5A827999
    c = ((c << 30) | (c >> 2))
    e += ((a << 5) | (a >> 27)) + ((b & c) | (^b & d)) + w15 + 0x5A827999
    b = ((b << 30) | (b >> 2))
    tmp = w13 ^ w8 ^ w2 ^ w0
    w0 = (tmp << 1) | (tmp >> 31)
    d += ((e << 5) | (e >> 27)) + ((a & b) | (^a & c)) + w0 + 0x5A827999
    a = ((a << 30) | (a >> 2))
    tmp = w14 ^ w9 ^ w3 ^ w1
    w1 = (tmp << 1) | (tmp >> 31)
    c += ((d << 5) | (d >> 27)) + ((e & a) | (^e & b)) + w1 + 0x5A827999
    e = ((e << 30) | (e >> 2))
    tmp = w15 ^ w10 ^ w4 ^ w2
    w2 = (tmp << 1) | (tmp >> 31)
    b += ((c << 5) | (c >> 27)) + ((d & e) | (^d & a)) + w2 + 0x5A827999
    d = ((d << 30) | (d >> 2))
    tmp = w0 ^ w11 ^ w5 ^ w3
    w3 = (tmp << 1) | (tmp >> 31)
    a += ((b << 5) | (b >> 27)) + ((c & d) | (^c & e)) + w3 + 0x5A827999
    c = ((c << 30) | (c >> 2))
    tmp = w1 ^ w12 ^ w6 ^ w4
    w4 = (tmp << 1) | (tmp >> 31)
    e += ((a << 5) | (a >> 27)) + (b ^ c ^ d) + w4 + 0x6ED9EBA1
    b = ((b << 30) | (b >> 2))
    tmp = w2 ^ w13 ^ w7 ^ w5
    w5 = (tmp << 1) | (tmp >> 31)
    d += ((e << 5) | (e >> 27)) + (a ^ b ^ c) + w5 + 0x6ED9EBA1
    a = ((a << 30) | (a >> 2))
    tmp = w3 ^ w14 ^ w8 ^ w6
    w6 = (tmp << 1) | (tmp >> 31)
    c += ((d << 5) | (d >> 27)) + (e ^ a ^ b) + w6 + 0x6ED9EBA1
    e = ((e << 30) | (e >> 2))
    tmp = w4 ^ w15 ^ w9 ^ w7
    w7 = (tmp << 1) | (tmp >> 31)
    b += ((c << 5) | (c >> 27)) + (d ^ e ^ a) + w7 + 0x6ED9EBA1
    d = ((d << 30) | (d >> 2))
    tmp = w5 ^ w0 ^ w10 ^ w8
    w8 = (tmp << 1) | (tmp >> 31)
    a += ((b << 5) | (b >> 27)) + (c ^ d ^ e) + w8 + 0x6ED9EBA1
    c = ((c << 30) | (c >> 2))
    tmp = w6 ^ w1 ^ w11 ^ w9
    w9 = (tmp << 1) | (tmp >> 31)
    e += ((a << 5) | (a >> 27)) + (b ^ c ^ d) + w9 + 0x6ED9EBA1
    b = ((b << 30) | (b >> 2))
    tmp = w7 ^ w2 ^ w12 ^ w10
    w10 = (tmp << 1) | (tmp >> 31)
    d += ((e << 5) | (e >> 27)) + (a ^ b ^ c) + w10 + 0x6ED9EBA1
    a = ((a << 30) | (a >> 2))
    tmp = w8 ^ w3 ^ w13 ^ w11
    w11 = (tmp << 1) | (tmp >> 31)
    c += ((d << 5) | (d >> 27)) + (e ^ a ^ b) + w11 + 0x6ED9EBA1
    e = ((e << 30) | (e >> 2))
    tmp = w9 ^ w4 ^ w14 ^ w12
    w12 = (tmp << 1) | (tmp >> 31)
    b += ((c << 5) | (c >> 27)) + (d ^ e ^ a) + w12 + 0x6ED9EBA1
    d = ((d << 30) | (d >> 2))
    tmp = w10 ^ w5 ^ w15 ^ w13
    w13 = (tmp << 1) | (tmp >> 31)
    a += ((b << 5) | (b >> 27)) + (c ^ d ^ e) + w13 + 0x6ED9EBA1
    c = ((c << 30) | (c >> 2))
    tmp = w11 ^ w6 ^ w0 ^ w14
    w14 = (tmp << 1) | (tmp >> 31)
    e += ((a << 5) | (a >> 27)) + (b ^ c ^ d) + w14 + 0x6ED9EBA1
    b = ((b << 30) | (b >> 2))
    tmp = w12 ^ w7 ^ w1 ^ w15
    w15 = (tmp << 1) | (tmp >> 31)
    d += ((e << 5) | (e >> 27)) + (a ^ b ^ c) + w15 + 0x6ED9EBA1
    a = ((a << 30) | (a >> 2))
    tmp = w13 ^ w8 ^ w2 ^ w0
    w0 = (tmp << 1) | (tmp >> 31)
    c += ((d << 5) | (d >> 27)) + (e ^ a ^ b) + w0 + 0x6ED9EBA1
    e = ((e << 30) | (e >> 2))
    tmp = w14 ^ w9 ^ w3 ^ w1
    w1 = (tmp << 1) | (tmp >> 31)
    b += ((c << 5) | (c >> 27)) + (d ^ e ^ a) + w1 + 0x6ED9EBA1
    d = ((d << 30) | (d >> 2))
    tmp = w15 ^ w10 ^ w4 ^ w2
    w2 = (tmp << 1) | (tmp >> 31)
    a += ((b << 5) | (b >> 27)) + (c ^ d ^ e) + w2 + 0x6ED9EBA1
    c = ((c << 30) | (c >> 2))
    tmp = w0 ^ w11 ^ w5 ^ w3
    w3 = (tmp << 1) | (tmp >> 31)
    e += ((a << 5) | (a >> 27)) + (b ^ c ^ d) + w3 + 0x6ED9EBA1
    b = ((b << 30) | (b >> 2))
    tmp = w1 ^ w12 ^ w6 ^ w4
    w4 = (tmp << 1) | (tmp >> 31)
    d += ((e << 5) | (e >> 27)) + (a ^ b ^ c) + w4 + 0x6ED9EBA1
    a = ((a << 30) | (a >> 2))
    tmp = w2 ^ w13 ^ w7 ^ w5
    w5 = (tmp << 1) | (tmp >> 31)
    c += ((d << 5) | (d >> 27)) + (e ^ a ^ b) + w5 + 0x6ED9EBA1
    e = ((e << 30) | (e >> 2))
    tmp = w3 ^ w14 ^ w8 ^ w6
    w6 = (tmp << 1) | (tmp >> 31)
    b += ((c << 5) | (c >> 27)) + (d ^ e ^ a) + w6 + 0x6ED9EBA1
    d = ((d << 30) | (d >> 2))
    tmp = w4 ^ w15 ^ w9 ^ w7
    w7 = (tmp << 1) | (tmp >> 31)
    a += ((b << 5) | (b >> 27)) + (c ^ d ^ e) + w7 + 0x6ED9EBA1
    c = ((c << 30) | (c >> 2))
    tmp = w5 ^ w0 ^ w10 ^ w8
    w8 = (tmp << 1) | (tmp >> 31)
    e += ((a << 5) | (a >> 27)) + (((b | c) & d) | (b & c)) + w8 + 0x8F1BBCDC
    b = ((b << 30) | (b >> 2))
    tmp = w6 ^ w1 ^ w11 ^ w9
    w9 = (tmp << 1) | (tmp >> 31)
    d += ((e << 5) | (e >> 27)) + (((a | b) & c) | (a & b)) + w9 + 0x8F1BBCDC
    a = ((a << 30) | (a >> 2))
    tmp = w7 ^ w2 ^ w12 ^ w10
    w10 = (tmp << 1) | (tmp >> 31)
    c += ((d << 5) | (d >> 27)) + (((e | a) & b) | (e & a)) + w10 + 0x8F1BBCDC
    e = ((e << 30) | (e >> 2))
    tmp = w8 ^ w3 ^ w13 ^ w11
    w11 = (tmp << 1) | (tmp >> 31)
    b += ((c << 5) | (c >> 27)) + (((d | e) & a) | (d & e)) + w11 + 0x8F1BBCDC
    d = ((d << 30) | (d >> 2))
    tmp = w9 ^ w4 ^ w14 ^ w12
    w12 = (tmp << 1) | (tmp >> 31)
    a += ((b << 5) | (b >> 27)) + (((c | d) & e) | (c & d)) + w12 + 0x8F1BBCDC
    c = ((c << 30) | (c >> 2))
    tmp = w10 ^ w5 ^ w15 ^ w13
    w13 = (tmp << 1) | (tmp >> 31)
    e += ((a << 5) | (a >> 27)) + (((b | c) & d) | (b & c)) + w13 + 0x8F1BBCDC
    b = ((b << 30) | (b >> 2))
    tmp = w11 ^ w6 ^ w0 ^ w14
    w14 = (tmp << 1) | (tmp >> 31)
    d += ((e << 5) | (e >> 27)) + (((a | b) & c) | (a & b)) + w14 + 0x8F1BBCDC
    a = ((a << 30) | (a >> 2))
    tmp = w12 ^ w7 ^ w1 ^ w15
    w15 = (tmp << 1) | (tmp >> 31)
    c += ((d << 5) | (d >> 27)) + (((e | a) & b) | (e & a)) + w15 + 0x8F1BBCDC
    e = ((e << 30) | (e >> 2))
    tmp = w13 ^ w8 ^ w2 ^ w0
    w0 = (tmp << 1) | (tmp >> 31)
    b += ((c << 5) | (c >> 27)) + (((d | e) & a) | (d & e)) + w0 + 0x8F1BBCDC
    d = ((d << 30) | (d >> 2))
    tmp = w14 ^ w9 ^ w3 ^ w1
    w1 = (tmp << 1) | (tmp >> 31)
    a += ((b << 5) | (b >> 27)) + (((c | d) & e) | (c & d)) + w1 + 0x8F1BBCDC
    c = ((c << 30) | (c >> 2))
    tmp = w15 ^ w10 ^ w4 ^ w2
    w2 = (tmp << 1) | (tmp >> 31)
    e += ((a << 5) | (a >> 27)) + (((b | c) & d) | (b & c)) + w2 + 0x8F1BBCDC
    b = ((b << 30) | (b >> 2))
    tmp = w0 ^ w11 ^ w5 ^ w3
    w3 = (tmp << 1) | (tmp >> 31)
    d += ((e << 5) | (e >> 27)) + (((a | b) & c) | (a & b)) + w3 + 0x8F1BBCDC
    a = ((a << 30) | (a >> 2))
    tmp = w1 ^ w12 ^ w6 ^ w4
    w4 = (tmp << 1) | (tmp >> 31)
    c += ((d << 5) | (d >> 27)) + (((e | a) & b) | (e & a)) + w4 + 0x8F1BBCDC
    e = ((e << 30) | (e >> 2))
    tmp = w2 ^ w13 ^ w7 ^ w5
