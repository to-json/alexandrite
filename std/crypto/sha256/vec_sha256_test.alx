# Generated from Go's crypto/sha256 (go1.27.1): sums of seeded random inputs of
# every length around the block boundaries, chunked writes and marshaled
# states; do not edit by hand.

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

def hexs(p: [Byte]) -> Str {
  digits = "0123456789abcdef"
  out: [Byte] = []
  for x in p {
    out << digits[(x >> 4).to_i]
    out << digits[(x & 15).to_i]
  }
  Str.from_bytes(out)
}

# The sum of gen(seed, n), one-shot and through a Digest.
def v(name: Str, seed: U64, n: Int, want: Str) {
  p = gen(seed, n)
  assert_eq hexs(oneshot(name, p)), want
  d = mk(name)
  d.write!(p)
  assert_eq hexs(d.sum([])), want
}

# The sum of gen(seed, n) written in pieces whose sizes cycle through sizes.
def ch(name: Str, seed: U64, n: Int, sizes: [Int], want: Str) {
  p = gen(seed, n)
  d = mk(name)
  off = 0
  k = 0
  while off < n {
    m = sizes[k % sizes.size]
    m = n - off if m > n - off
    d.write!(p[off...off + m])
    off += m
    k += 1
  }
  assert_eq hexs(d.sum([])), want
}

# The marshaled state after gen(seed, n), and the sum after restoring it
# into a new hash and writing gen(seed + 1, 77).
def ms(name: Str, seed: U64, n: Int, state: Str, want: Str) {
  d = mk(name)
  d.write!(gen(seed, n))
  st = d.marshal_binary
  assert_eq hexs(st), state
  d2 = mk(name)
  d2.unmarshal_binary!(st).unwrap
  d2.write!(gen(seed + 1, 77))
  assert_eq hexs(d2.sum([])), want
}

def mk(name: Str) -> Digest { name == "sha224" ? new224() : new() }

def oneshot(name: Str, p: [Byte]) -> [Byte] { name == "sha224" ? sum224(p).to_a : sum256(p).to_a }

