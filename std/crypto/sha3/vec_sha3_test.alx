# Generated from Go's crypto/sha3 (go1.27.1; legacy Keccak from
# golang.org/x/crypto/sha3): sums and XOF outputs of seeded random inputs
# around the rate boundaries, cSHAKE prefixes and marshaled states; do not
# edit by hand.

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

def hexs(p: [Byte]) -> Str {
  digits = "0123456789abcdef"
  out: [Byte] = []
  for x in p {
    out << digits[(x >> 4).to_i]
    out << digits[(x & 15).to_i]
  }
  Str.from_bytes(out)
}

def mk(name: Str) -> SHA3 {
  return new224() if name == "sha3_224"
  return new256() if name == "sha3_256"
  return new384() if name == "sha3_384"
  return new512() if name == "sha3_512"
  return new_legacy_keccak256() if name == "keccak256"
  new_legacy_keccak512()
}

def mkx(name: Str) -> SHAKE {
  return new_shake128() if name == "shake128"
  return new_shake256() if name == "shake256"
  return new_cshake128(b("N"), b("Email Signature")) if name == "cshake128"
  return new_cshake256(b("TupleHash"), b("")) if name == "cshake256"
  return new_cshake128([], gen(99, 300)) if name == "cshake128s"
  new_cshake256(gen(98, 170), gen(97, 5))
}

# The hash of gen(seed, n), whole and one-shot where there is a sum function.
def hv(name: Str, seed: U64, n: Int, want: Str) {
  p = gen(seed, n)
  d = mk(name)
  d.write!(p)
  assert_eq hexs(d.sum([])), want
  if name == "sha3_256" {
    assert_eq hexs(sum256(p).to_a), want
  } else if name == "sha3_224" {
    assert_eq hexs(sum224(p).to_a), want
  } else if name == "sha3_384" {
    assert_eq hexs(sum384(p).to_a), want
  } else if name == "sha3_512" {
    assert_eq hexs(sum512(p).to_a), want
  }
}

# The state after gen(seed, n), and the hash after restoring it into a new
# hash and writing gen(seed + 1, 50).
def hm(name: Str, seed: U64, n: Int, state: Str, want: Str) {
  d = mk(name)
  d.write!(gen(seed, n))
  st = d.marshal_binary
  assert_eq hexs(st), state
  d2 = mk(name)
  d2.unmarshal_binary!(st).unwrap
  d2.write!(gen(seed + 1, 50))
  assert_eq hexs(d2.sum([])), want
}

# want.size / 2 bytes of output after absorbing gen(seed, n).
def xv(name: Str, seed: U64, n: Int, want: Str) {
  d = mkx(name)
  d.write!(gen(seed, n)).unwrap
  out = [0.as_u8; want.size / 2]
  d.read!(out)
  assert_eq hexs(out), want
}

# Marshaled states while absorbing and while squeezing, restored into new
# XOFs.
def xm(name: Str, seed: U64, n: Int, state: Str, want: Str, state2: Str, want2: Str) {
  d = mkx(name)
  d.write!(gen(seed, n)).unwrap
  st = d.marshal_binary
  assert_eq hexs(st), state
  d2 = mkx(name)
  d2.unmarshal_binary!(st).unwrap
  d2.write!(gen(seed + 1, 50)).unwrap
  out = [0.as_u8; 40]
  d2.read!(out)
  assert_eq hexs(out), want
  st2 = d2.marshal_binary
  assert_eq hexs(st2), state2
  d3 = mkx(name)
  d3.unmarshal_binary!(st2).unwrap
  out2 = [0.as_u8; 300]
  d3.read!(out2)
  assert_eq hexs(out2), want2
}

# cSHAKE with N = gen(seed, nl) and S = gen(seed + 1, sl), over
# gen(seed + 2, 10).
def cs(bits: Int, seed: U64, nl: Int, sl: Int, want: Str) {
  c = bits == 128 ? new_cshake128(gen(seed, nl), gen(seed + 1, sl)) : new_cshake256(gen(seed, nl), gen(seed + 1, sl))
  c.write!(gen(seed + 2, 10)).unwrap
  out = [0.as_u8; 32]
  c.read!(out)
  assert_eq hexs(out), want
}

