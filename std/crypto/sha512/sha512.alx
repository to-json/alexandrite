#![overflow(wrap)]
# Package sha512: Go's crypto/sha512, the SHA-384, SHA-512, SHA-512/224 and
# SHA-512/256 hash algorithms of FIPS 180-4. Pure alx: the generic
# (non-assembly) code of Go's crypto/internal/fips140/sha512.
#
#   Go                                        alx
#   sha512.Size / Size224 / Size256 / Size384 SIZE / SIZE224 / SIZE256 / SIZE384
#   sha512.BlockSize                          BLOCK_SIZE
#   sha512.New() hash.Hash                    new() -> Digest
#   sha512.New384 / New512_224 / New512_256   new384 / new512_224 / new512_256 -> Digest
#   sha512.Sum512(data) [Size]byte            sum512(data) -> [Byte; 64]
#   sha512.Sum384 / Sum512_224 / Sum512_256   sum384 / sum512_224 / sum512_256
#   d.Write(p) (int, error)                   d.write!(p) -> Int (never fails)
#   d.Sum(b) / Reset / Size / BlockSize       d.sum(b) / d.reset! / d.size / d.block_size
#   d.MarshalBinary / AppendBinary            d.marshal_binary / d.append_binary(b) (never fail)
#   d.UnmarshalBinary(b) error                d.unmarshal_binary!(b) -> ~Unit<StateError>
#   d.Clone() (hash.Cloner, error)            d.clone -> Digest
#
# A Digest satisfies hash.Hash structurally.
#
# Differences from Go:
#   - The constructors return the concrete Digest (Go: hash.Hash); it
#     converts to a hash.Hash wherever one is wanted. crypto.SHA512.new etc.
#     give a hash.Hash.
#   - No registration with package crypto at init: package crypto knows the
#     hashes it can make (alx has no init functions or global registries).
#   - A Digest keeps its state in shared storage (GO-VS-RUBY D36): copies of
#     a Digest are the same hash, as Go's pointer is; `clone` makes an
#     independent one. Use the constructors: a zero `Digest.new` has no state.
#   - Clone, MarshalBinary and AppendBinary can't fail, so they return plain
#     values. No BoringCrypto or FIPS 140 module modes, no assembly; the
#     compression function is Go's blockGeneric with its rounds unrolled
#     (sha512block.alx).

# The size of a SHA-512 checksum in bytes.
pub SIZE = 64
# The size of a SHA-512/224 checksum in bytes.
pub SIZE224 = 28
# The size of a SHA-512/256 checksum in bytes.
pub SIZE256 = 32
# The size of a SHA-384 checksum in bytes.
pub SIZE384 = 48
# The block size of SHA-512 and its variants in bytes.
pub BLOCK_SIZE = 128

CHUNK = 128
MAGIC384 = "sha\x04"
MAGIC512_224 = "sha\x05"
MAGIC512_256 = "sha\x06"
MAGIC512 = "sha\x07"
MARSHALED_SIZE = 4 + 8 * 8 + CHUNK + 8

# Errors of Digest.unmarshal_binary!.
pub error StateError {
  InvalidIdentifier
  InvalidSize

  def message -> Str {
    case self {
      InvalidIdentifier => "crypto/sha512: invalid hash state identifier"
      InvalidSize => "crypto/sha512: invalid hash state size"
    }
  }
}

INIT512: [U64; 8] = [0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
  0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179]
INIT224: [U64; 8] = [0x8c3d37c819544da2, 0x73e1996689dcd4d6, 0x1dfab7ae32ff9c82, 0x679dd514582f9fcf,
  0x0f6d2b697bd44da8, 0x77e36f7304c48942, 0x3f9d85a86a1d36c8, 0x1112e6ad91d692a1]
INIT256: [U64; 8] = [0x22312194fc2bf72c, 0x9f555fa3c84c64c2, 0x2393b86b6f53b151, 0x963877195940eabd,
  0x96283ee2a88effe3, 0xbe5e1e2553863992, 0x2b0199fc2c85b8aa, 0x0eb72ddc81c52ca2]
INIT384: [U64; 8] = [0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
  0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4]

def append_be64(b: [Byte], v: U64) -> [Byte] {
  out = b
  out << (v >> 56).as_u8
  out << (v >> 48).as_u8
  out << (v >> 40).as_u8
  out << (v >> 32).as_u8
  out << (v >> 24).as_u8
  out << (v >> 16).as_u8
  out << (v >> 8).as_u8
  out << v.as_u8
  out
}

def be64(b: [Byte], i: Int) -> U64 {
  (b[i].as_u64 << 56) | (b[i + 1].as_u64 << 48) | (b[i + 2].as_u64 << 40) | (b[i + 3].as_u64 << 32) |
  (b[i + 4].as_u64 << 24) | (b[i + 5].as_u64 << 16) | (b[i + 6].as_u64 << 8) | b[i + 7].as_u64
}

# Whether b starts with the bytes of s.
def has_magic(b: [Byte], s: Str) -> Bool {
  return false if b.size < s.size
  i = 0
  while i < s.size {
    return false if b[i] != s[i]
    i += 1
  }
  true
}

def make(size: Int) -> Digest {
  d = Digest.new(h: [0.as_u64; 8], x: [0.as_u8; CHUNK], n: [0.as_u64; 2], size: size)
  d.reset!
  d
}

# A new SHA-512 hash.
pub def new -> Digest { make(SIZE) }

# A new SHA-512/224 hash.
pub def new512_224 -> Digest { make(SIZE224) }

# A new SHA-512/256 hash.
pub def new512_256 -> Digest { make(SIZE256) }

# A new SHA-384 hash.
pub def new384 -> Digest { make(SIZE384) }

# The SHA-512 checksum of data.
pub def sum512(data: [Byte]) -> [Byte; 64] {
  d = new()
  d.write!(data)
  out: [Byte; 64] = [0; 64]
  copy(out[0...64], d.check_sum)
  out
}

# The SHA-384 checksum of data.
pub def sum384(data: [Byte]) -> [Byte; 48] {
  d = new384()
  d.write!(data)
  out: [Byte; 48] = [0; 48]
  copy(out[0...48], d.check_sum)
  out
}

# The SHA-512/224 checksum of data.
pub def sum512_224(data: [Byte]) -> [Byte; 28] {
  d = new512_224()
  d.write!(data)
  out: [Byte; 28] = [0; 28]
  copy(out[0...28], d.check_sum)
  out
}

# The SHA-512/256 checksum of data.
pub def sum512_256(data: [Byte]) -> [Byte; 32] {
  d = new512_256()
  d.write!(data)
  out: [Byte; 32] = [0; 32]
  copy(out[0...32], d.check_sum)
  out
}

# A running SHA-512 (or SHA-384, SHA-512/224, SHA-512/256) hash.
pub struct Digest {
  # The chaining state.
  h: [U64]
  # The partial block.
  x: [Byte]
  # n[0]: bytes in x; n[1]: total bytes written.
  n: [U64]
  # SIZE, SIZE224, SIZE256 or SIZE384: which variant this is.
  size: Int

  # The checksum size in bytes.
  pub def size -> Int { size }

  # The block size: 128.
  pub def block_size -> Int { BLOCK_SIZE }

  def initial -> [U64; 8] {
    return INIT384 if size == SIZE384
    return INIT224 if size == SIZE224
    return INIT256 if size == SIZE256
    panic("unknown size") if size != SIZE
    INIT512
  }

  def magic -> Str {
    return MAGIC384 if size == SIZE384
    return MAGIC512_224 if size == SIZE224
    return MAGIC512_256 if size == SIZE256
    panic("unknown size") if size != SIZE
    MAGIC512
  }

  # Back to the initial state.
  pub def reset! {
    iv = initial
    i = 0
    while i < 8 {
      self.h[i] = iv[i]
      i += 1
    }
    self.n[0] = 0
    self.n[1] = 0
    nil
  }

  # Adds p to the running hash; returns p.size.
  pub def write!(p: [Byte]) -> Int {
    nn = p.size
    self.n[1] = n[1] + nn.as_u64
    nx = n[0].to_i
    off = 0
    if nx > 0 {
      k = CHUNK - nx
      k = nn if k > nn
      copy(x[nx...nx + k], p[0...k])
      nx += k
      if nx == CHUNK {
        block(h, x, 0, CHUNK)
        nx = 0
      }
      off = k
    }
    rest = nn - off
    if rest >= CHUNK {
      m = rest & ^(CHUNK - 1)
      block(h, p, off, m)
      off += m
    }
    if off < nn {
      nx = nn - off
      copy(x[0...nx], p[off...nn])
    }
    self.n[0] = nx.as_u64
    nn
  }

  # The padded final digest of a copy of the state (Go's checkSum), all
  # eight words.
  def check_sum -> [Byte] {
    d = clone
    len = d.n[1]
    tmp = [0.as_u8; 144]
    tmp[0] = 0x80
    t = len % 128 < 112 ? 112 - len % 128 : 128 + 112 - len % 128
    ti = t.to_i
    bits = len << 3
    j = 0
    while j < 8 {
      tmp[ti + 8 + j] = (bits >> (56 - 8 * j).as_u64).as_u8
      j += 1
    }
    d.write!(tmp[0...ti + 16])
    panic("d.nx != 0") if d.n[0] != 0
    out: [Byte] = []
    i = 0
    while i < 8 {
      out = append_be64(out, d.h[i])
      i += 1
    }
    out
  }

  # b with the current hash appended. The state is unchanged.
  pub def sum(b: [Byte]) -> [Byte] {
    b + check_sum[0...size]
  }

  # An independent copy of the hash in its current state.
  pub def clone -> Digest {
    Digest.new(h: h + [], x: x + [], n: n + [], size: size)
  }

  # b with the marshaled state appended (Go's AppendBinary).
  pub def append_binary(b: [Byte]) -> [Byte] {
    out = b + magic.bytes.to_a
    i = 0
    while i < 8 {
      out = append_be64(out, h[i])
      i += 1
    }
    nx = n[0].to_i
    out = out + x[0...nx]
    out = out + [0.as_u8; CHUNK - nx]
    append_be64(out, n[1])
  }

  # The marshaled state (Go's MarshalBinary).
  pub def marshal_binary -> [Byte] {
    append_binary([])
  }

  # Restores a state from marshal_binary. The state must be of the same
  # variant as the hash.
  pub def unmarshal_binary!(b: [Byte]) -> ~Unit<StateError> {
    fail StateError.InvalidIdentifier if !has_magic(b, magic)
    fail StateError.InvalidSize if b.size != MARSHALED_SIZE
    i = 0
    while i < 8 {
      self.h[i] = be64(b, 4 + 8 * i)
      i += 1
    }
    copy(x, b[68...68 + CHUNK])
    len = be64(b, 68 + CHUNK)
    self.n[1] = len
    self.n[0] = len % CHUNK.as_u64
  }
}
