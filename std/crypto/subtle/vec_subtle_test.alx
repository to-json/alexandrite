# Generated from Go's crypto/subtle (go1.27.1): results for random inputs; do not
# edit by hand.

import "encoding/hex"

def hx(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  out: [Byte] = []
  x = seed
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    out << mix(x).as_u8
    i += 1
  }
  out
}

# One splitmix64 output for seed.
def rand64(seed: U64) -> U64 { mix(seed +% 0x9e3779b97f4a7c15) }

def mix(x: U64) -> U64 {
  z = (x ^ (x >> 30)) *% 0xbf58476d1ce4e5b9
  z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
  z ^ (z >> 31)
}

def xo(x: [Byte], y: [Byte], want: [Byte]) {
  n = x.size > y.size ? x.size : y.size
  d = [0.as_u8; n]
  m = xor_bytes(d, x, y)
  assert_eq m, want.size
  assert_eq d[0...m], want
}

def cp(v: Int, x: [Byte], y: [Byte], want: [Byte]) {
  constant_time_copy(v, x, y)
  assert_eq x, want
}

