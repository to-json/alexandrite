# Cipher suites (Go's cipher_suites.go): the public descriptions, the
# implementation tables, and the record protection they make.

import "crypto"
import "crypto/aes"
import "crypto/cipher"
import "crypto/des"
import "crypto/hmac"
import "crypto/rc4"
import "hash"

# A TLS cipher suite (Go's CipherSuite).
pub struct CipherSuite {
  id: U16
  name: Str
  # The TLS versions that can negotiate this cipher suite.
  supported_versions: [U16]
  # Whether the suite has known security issues.
  insecure: Bool
}

def up_to_tls12 -> [U16] { [VERSION_TLS10, VERSION_TLS11, VERSION_TLS12] }
def only_tls12 -> [U16] { [VERSION_TLS12] }
def only_tls13 -> [U16] { [VERSION_TLS13] }

# The cipher suites implemented by this package, excluding those with
# security issues (Go's CipherSuites).
pub def cipher_suites -> [CipherSuite] {
  s = ->(id: U16, n: Str, v: [U16]) -> CipherSuite { CipherSuite.new(id: id, name: n, supported_versions: v, insecure: false) }
  [s.call(TLS_AES_128_GCM_SHA256, "TLS_AES_128_GCM_SHA256", only_tls13()), s.call(TLS_AES_256_GCM_SHA384, "TLS_AES_256_GCM_SHA384", only_tls13()), s.call(TLS_CHACHA20_POLY1305_SHA256, "TLS_CHACHA20_POLY1305_SHA256", only_tls13()), s.call(TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA, "TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA", up_to_tls12()), s.call(TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA, "TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA", up_to_tls12()), s.call(TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA, "TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA", up_to_tls12()), s.call(TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA, "TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA", up_to_tls12()), s.call(TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256", only_tls12()), s.call(TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384, "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384", only_tls12()), s.call(TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256", only_tls12()), s.call(TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384, "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384", only_tls12()), s.call(TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256, "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256", only_tls12()), s.call(TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256, "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256", only_tls12())]
}

# The cipher suites implemented by this package that have security
# issues (Go's InsecureCipherSuites).
pub def insecure_cipher_suites -> [CipherSuite] {
  s = ->(id: U16, n: Str, v: [U16]) -> CipherSuite { CipherSuite.new(id: id, name: n, supported_versions: v, insecure: true) }
  [s.call(TLS_RSA_WITH_RC4_128_SHA, "TLS_RSA_WITH_RC4_128_SHA", up_to_tls12()), s.call(TLS_RSA_WITH_3DES_EDE_CBC_SHA, "TLS_RSA_WITH_3DES_EDE_CBC_SHA", up_to_tls12()), s.call(TLS_RSA_WITH_AES_128_CBC_SHA, "TLS_RSA_WITH_AES_128_CBC_SHA", up_to_tls12()), s.call(TLS_RSA_WITH_AES_256_CBC_SHA, "TLS_RSA_WITH_AES_256_CBC_SHA", up_to_tls12()), s.call(TLS_RSA_WITH_AES_128_CBC_SHA256, "TLS_RSA_WITH_AES_128_CBC_SHA256", only_tls12()), s.call(TLS_RSA_WITH_AES_128_GCM_SHA256, "TLS_RSA_WITH_AES_128_GCM_SHA256", only_tls12()), s.call(TLS_RSA_WITH_AES_256_GCM_SHA384, "TLS_RSA_WITH_AES_256_GCM_SHA384", only_tls12()), s.call(TLS_ECDHE_ECDSA_WITH_RC4_128_SHA, "TLS_ECDHE_ECDSA_WITH_RC4_128_SHA", up_to_tls12()), s.call(TLS_ECDHE_RSA_WITH_RC4_128_SHA, "TLS_ECDHE_RSA_WITH_RC4_128_SHA", up_to_tls12()), s.call(TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA, "TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA", up_to_tls12()), s.call(TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256, "TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256", only_tls12()), s.call(TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256, "TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256", only_tls12())]
}

# The standard name of a cipher suite ("TLS_AES_128_GCM_SHA256"), or
# "0x1234" for an unknown ID.
pub def cipher_suite_name(id: U16) -> Str {
  for c in cipher_suites() {
    return c.name if c.id == id
  }
  for c in insecure_cipher_suites() {
    return c.name if c.id == id
  }
  "0x" + hex4(id.to_i)
}

SUITE_ECDHE = 1
# The key is an ECDSA (or EdDSA) one rather than RSA.
SUITE_EC_SIGN = 2
# TLS 1.2 only.
SUITE_TLS12 = 4
# The PRF uses SHA-384.
SUITE_SHA384 = 8

KA_RSA = 0
KA_ECDHE_RSA = 1
KA_ECDHE_ECDSA = 2

CIPHER_NONE = 0
CIPHER_AES_CBC = 1
CIPHER_3DES_CBC = 2
CIPHER_RC4 = 3
CIPHER_AES_GCM = 4
CIPHER_CHACHA20_POLY1305 = 5

MAC_NONE = 0
MAC_SHA1 = 1
MAC_SHA256 = 2

# The implementation of a TLS 1.0-1.2 suite (Go's cipherSuite).
struct CipherSuiteImpl {
  id: U16
  # the lengths, in bytes, of the key material needed for each component.
  key_len: Int
  mac_len: Int
  iv_len: Int
  ka: Int
  flags: Int
  cipher: Int
  mac: Int

  def aead? -> Bool { cipher == CIPHER_AES_GCM || cipher == CIPHER_CHACHA20_POLY1305 }
}

def suite(id: U16, k: Int, m: Int, iv: Int, ka: Int, flags: Int, c: Int, mac: Int) -> CipherSuiteImpl {
  CipherSuiteImpl.new(id: id, key_len: k, mac_len: m, iv_len: iv, ka: ka, flags: flags, cipher: c, mac: mac)
}

def cipher_suite_impls -> [CipherSuiteImpl] {
  [suite(TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256, 32, 0, 12, KA_ECDHE_RSA, SUITE_ECDHE | SUITE_TLS12, CIPHER_CHACHA20_POLY1305, MAC_NONE), suite(TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256, 32, 0, 12, KA_ECDHE_ECDSA, SUITE_ECDHE | SUITE_EC_SIGN | SUITE_TLS12, CIPHER_CHACHA20_POLY1305, MAC_NONE), suite(TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, 16, 0, 4, KA_ECDHE_RSA, SUITE_ECDHE | SUITE_TLS12, CIPHER_AES_GCM, MAC_NONE), suite(TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, 16, 0, 4, KA_ECDHE_ECDSA, SUITE_ECDHE | SUITE_EC_SIGN | SUITE_TLS12, CIPHER_AES_GCM, MAC_NONE), suite(TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384, 32, 0, 4, KA_ECDHE_RSA, SUITE_ECDHE | SUITE_TLS12 | SUITE_SHA384, CIPHER_AES_GCM, MAC_NONE), suite(TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384, 32, 0, 4, KA_ECDHE_ECDSA, SUITE_ECDHE | SUITE_EC_SIGN | SUITE_TLS12 | SUITE_SHA384, CIPHER_AES_GCM, MAC_NONE), suite(TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256, 16, 32, 16, KA_ECDHE_RSA, SUITE_ECDHE | SUITE_TLS12, CIPHER_AES_CBC, MAC_SHA256), suite(TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA, 16, 20, 16, KA_ECDHE_RSA, SUITE_ECDHE, CIPHER_AES_CBC, MAC_SHA1), suite(TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256, 16, 32, 16, KA_ECDHE_ECDSA, SUITE_ECDHE | SUITE_EC_SIGN | SUITE_TLS12, CIPHER_AES_CBC, MAC_SHA256), suite(TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA, 16, 20, 16, KA_ECDHE_ECDSA, SUITE_ECDHE | SUITE_EC_SIGN, CIPHER_AES_CBC, MAC_SHA1), suite(TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA, 32, 20, 16, KA_ECDHE_RSA, SUITE_ECDHE, CIPHER_AES_CBC, MAC_SHA1), suite(TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA, 32, 20, 16, KA_ECDHE_ECDSA, SUITE_ECDHE | SUITE_EC_SIGN, CIPHER_AES_CBC, MAC_SHA1), suite(TLS_RSA_WITH_AES_128_GCM_SHA256, 16, 0, 4, KA_RSA, SUITE_TLS12, CIPHER_AES_GCM, MAC_NONE), suite(TLS_RSA_WITH_AES_256_GCM_SHA384, 32, 0, 4, KA_RSA, SUITE_TLS12 | SUITE_SHA384, CIPHER_AES_GCM, MAC_NONE), suite(TLS_RSA_WITH_AES_128_CBC_SHA256, 16, 32, 16, KA_RSA, SUITE_TLS12, CIPHER_AES_CBC, MAC_SHA256), suite(TLS_RSA_WITH_AES_128_CBC_SHA, 16, 20, 16, KA_RSA, 0, CIPHER_AES_CBC, MAC_SHA1), suite(TLS_RSA_WITH_AES_256_CBC_SHA, 32, 20, 16, KA_RSA, 0, CIPHER_AES_CBC, MAC_SHA1), suite(TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA, 24, 20, 8, KA_ECDHE_RSA, SUITE_ECDHE, CIPHER_3DES_CBC, MAC_SHA1), suite(TLS_RSA_WITH_3DES_EDE_CBC_SHA, 24, 20, 8, KA_RSA, 0, CIPHER_3DES_CBC, MAC_SHA1), suite(TLS_RSA_WITH_RC4_128_SHA, 16, 20, 0, KA_RSA, 0, CIPHER_RC4, MAC_SHA1), suite(TLS_ECDHE_RSA_WITH_RC4_128_SHA, 16, 20, 0, KA_ECDHE_RSA, SUITE_ECDHE, CIPHER_RC4, MAC_SHA1), suite(TLS_ECDHE_ECDSA_WITH_RC4_128_SHA, 16, 20, 0, KA_ECDHE_ECDSA, SUITE_ECDHE | SUITE_EC_SIGN, CIPHER_RC4, MAC_SHA1)]
}

def cipher_suite_by_id(id: U16) -> CipherSuiteImpl? {
  for c in cipher_suite_impls() {
    return c if c.id == id
  }
  none
}

def mutual_cipher_suite(have: [U16], want: U16) -> CipherSuiteImpl? {
  for id in have {
    return cipher_suite_by_id(id) if id == want
  }
  none
}

# The first suite in ids that is in supported and passes ok.
def select_cipher_suite(ids: [U16], supported: [U16], ok: (CipherSuiteImpl) -> Bool) -> CipherSuiteImpl? {
  for id in ids {
    if candidate = cipher_suite_by_id(id) {
      next if !ok.call(candidate)
      for s in supported {
        return candidate if s == id
      }
    }
  }
  none
}

# A TLS 1.3 suite (Go's cipherSuiteTLS13).
struct CipherSuiteTLS13 {
  id: U16
  key_len: Int
  chacha: Bool
  hash: crypto.Hash

  def new_hash -> hash.Hash { self.hash.new }
}

def cipher_suites_tls13 -> [CipherSuiteTLS13] {
  [CipherSuiteTLS13.new(id: TLS_AES_128_GCM_SHA256, key_len: 16, chacha: false, hash: crypto.Hash.SHA256), CipherSuiteTLS13.new(id: TLS_CHACHA20_POLY1305_SHA256, key_len: 32, chacha: true, hash: crypto.Hash.SHA256), CipherSuiteTLS13.new(id: TLS_AES_256_GCM_SHA384, key_len: 32, chacha: false, hash: crypto.Hash.SHA384)]
}

def cipher_suite_tls13_by_id(id: U16) -> CipherSuiteTLS13? {
  for c in cipher_suites_tls13() {
    return c if c.id == id
  }
  none
}

def mutual_cipher_suite_tls13(have: [U16], want: U16) -> CipherSuiteTLS13? {
  for id in have {
    return cipher_suite_tls13_by_id(id) if id == want
  }
  none
}

# Go's cipherSuitesPreferenceOrder.
def cipher_suites_preference_order -> [U16] {
  [TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384, TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384, TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256, TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256, TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA, TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA, TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA, TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA, TLS_RSA_WITH_AES_128_GCM_SHA256, TLS_RSA_WITH_AES_256_GCM_SHA384, TLS_RSA_WITH_AES_128_CBC_SHA, TLS_RSA_WITH_AES_256_CBC_SHA, TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA, TLS_RSA_WITH_3DES_EDE_CBC_SHA, TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256, TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256, TLS_RSA_WITH_AES_128_CBC_SHA256, TLS_ECDHE_ECDSA_WITH_RC4_128_SHA, TLS_ECDHE_RSA_WITH_RC4_128_SHA, TLS_RSA_WITH_RC4_128_SHA]
}

# Go's cipherSuitesPreferenceOrderNoAES.
def cipher_suites_preference_order_no_aes -> [U16] {
  [TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256, TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384, TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384, TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA, TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA, TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA, TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA, TLS_RSA_WITH_AES_128_GCM_SHA256, TLS_RSA_WITH_AES_256_GCM_SHA384, TLS_RSA_WITH_AES_128_CBC_SHA, TLS_RSA_WITH_AES_256_CBC_SHA, TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA, TLS_RSA_WITH_3DES_EDE_CBC_SHA, TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256, TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256, TLS_RSA_WITH_AES_128_CBC_SHA256, TLS_ECDHE_ECDSA_WITH_RC4_128_SHA, TLS_ECDHE_RSA_WITH_RC4_128_SHA, TLS_RSA_WITH_RC4_128_SHA]
}

# Go's disabledCipherSuites: not offered or accepted unless configured.
def disabled_cipher_suite?(id: U16) -> Bool {
  id == TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256 || id == TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256 || id == TLS_RSA_WITH_AES_128_CBC_SHA256 || id == TLS_ECDHE_ECDSA_WITH_RC4_128_SHA || id == TLS_ECDHE_RSA_WITH_RC4_128_SHA || id == TLS_RSA_WITH_RC4_128_SHA || id == TLS_RSA_WITH_3DES_EDE_CBC_SHA || id == TLS_RSA_WITH_AES_128_CBC_SHA || id == TLS_RSA_WITH_AES_256_CBC_SHA || id == TLS_RSA_WITH_AES_128_GCM_SHA256 || id == TLS_RSA_WITH_AES_256_GCM_SHA384 || id == TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA
}

def aesgcm_cipher?(id: U16) -> Bool {
  id == TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 || id == TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 || id == TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 || id == TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 || id == TLS_AES_128_GCM_SHA256 || id == TLS_AES_256_GCM_SHA384
}

# Whether AES-GCM hardware support is assumed (Go asks the CPU). alx's AES
# is software everywhere, but Go's tests and transcripts assume the amd64
# / arm64 answer, so this is true.
HAS_AES_GCM_HARDWARE_SUPPORT = false

# Go's isAESGCMPreferred: whether the first known suite of the peer's list
# is an AES-GCM one.
def aes_gcm_preferred?(ciphers: [U16]) -> Bool {
  return false if !HAS_AES_GCM_HARDWARE_SUPPORT
  for id in ciphers {
    return aesgcm_cipher?(id) if cipher_suite_by_id(id).some? || cipher_suite_tls13_by_id(id).some?
  }
  false
}

# ---------------------------------------------------------------- record protection

AEAD_NONCE_LENGTH = 12
NONCE_PREFIX_LENGTH = 4

# Go's prefixNonceAEAD (TLS 1.2 AES-GCM: a 4-byte implicit prefix and an
# 8-byte explicit nonce) and xorNonceAEAD (TLS 1.3, and ChaCha20-Poly1305
# in TLS 1.2: the sequence number XORed into a 12-byte mask).
struct RecordAead {
  aead: cipher.AEAD
  nonce: [Byte]
  xor: Bool

  def nonce_size -> Int { 8 }
  def overhead -> Int { aead.overhead }
  def explicit_nonce_len -> Int { xor ? 0 : 8 }

  def full_nonce(n: [Byte]) -> [Byte] {
    out = nonce + []
    i = 0
    while i < n.size {
      if xor {
        out[4 + i] = out[4 + i] ^ n[i]
      } else {
        out[4 + i] = n[i]
      }
      i += 1
    }
    out
  }

  def seal(out: [Byte], n: [Byte], plaintext: [Byte], ad: [Byte]) -> [Byte] { aead.seal(out, self.full_nonce(n), plaintext, ad) }

  def open(out: [Byte], n: [Byte], ciphertext: [Byte], ad: [Byte]) -> ~[Byte] { aead.~open(out, self.full_nonce(n), ciphertext, ad) }
}

def aead_aes_gcm(key: [Byte], nonce_prefix: [Byte]) -> RecordAead {
  panic("tls: internal error: wrong nonce length") if nonce_prefix.size != NONCE_PREFIX_LENGTH
  b = aes.new_cipher(key).unwrap
  g = cipher.new_gcm(b).unwrap
  RecordAead.new(aead: g, nonce: nonce_prefix + [0.as_u8; 8], xor: false)
}

def aead_aes_gcm_tls13(key: [Byte], nonce_mask: [Byte]) -> RecordAead {
  panic("tls: internal error: wrong nonce length") if nonce_mask.size != AEAD_NONCE_LENGTH
  b = aes.new_cipher(key).unwrap
  g = cipher.new_gcm(b).unwrap
  RecordAead.new(aead: g, nonce: nonce_mask + [], xor: true)
}

def aead_chacha20_poly1305(key: [Byte], nonce_mask: [Byte]) -> RecordAead {
  panic("tls: internal error: wrong nonce length") if nonce_mask.size != AEAD_NONCE_LENGTH
  RecordAead.new(aead: new_chacha20_poly1305(key), nonce: nonce_mask + [], xor: true)
}

# A half-connection's cipher (Go's halfConn.cipher, an `any`).
enum RecordCipher {
  Null
  Aead(RecordAead)
  AesCbcEnc(cipher.CbcEncrypter[aes.Block])
  AesCbcDec(cipher.CbcDecrypter[aes.Block])
  DesCbcEnc(cipher.CbcEncrypter[des.TripleCipher])
  DesCbcDec(cipher.CbcDecrypter[des.TripleCipher])
  Rc4(rc4.Cipher)

  def null? -> Bool {
    case self {
      Null => true
      _ => false
    }
  }

  def cbc? -> Bool {
    case self {
      AesCbcEnc(_) => true
      AesCbcDec(_) => true
      DesCbcEnc(_) => true
      DesCbcDec(_) => true
      _ => false
    }
  }

  def block_size -> Int {
    case self {
      AesCbcEnc(_) => 16
      AesCbcDec(_) => 16
      DesCbcEnc(_) => 8
      DesCbcDec(_) => 8
      _ => 0
    }
  }

  def set_iv(iv: [Byte]) {
    case self {
      AesCbcEnc(m) => {
        mm = m
        mm.set_iv!(iv)
      }
      AesCbcDec(m) => {
        mm = m
        mm.set_iv!(iv)
      }
      DesCbcEnc(m) => {
        mm = m
        mm.set_iv!(iv)
      }
      DesCbcDec(m) => {
        mm = m
        mm.set_iv!(iv)
      }
      _ => nil
    }
    nil
  }

  def crypt_blocks(dst: [Byte], src: [Byte]) {
    case self {
      AesCbcEnc(m) => {
        mm = m
        mm.crypt_blocks!(dst, src)
      }
      AesCbcDec(m) => {
        mm = m
        mm.crypt_blocks!(dst, src)
      }
      DesCbcEnc(m) => {
        mm = m
        mm.crypt_blocks!(dst, src)
      }
      DesCbcDec(m) => {
        mm = m
        mm.crypt_blocks!(dst, src)
      }
      Rc4(c) => {
        cc = c
        cc.xor_key_stream!(dst, src)
      }
      _ => nil
    }
    nil
  }
}

# The cipher for a TLS 1.0-1.2 suite (Go's suite.cipher / suite.aead).
def suite_cipher(s: CipherSuiteImpl, key: [Byte], iv: [Byte], is_read: Bool) -> RecordCipher {
  if s.cipher == CIPHER_AES_GCM {
    return RecordCipher.Aead(aead_aes_gcm(key, iv))
  }
  if s.cipher == CIPHER_CHACHA20_POLY1305 {
    return RecordCipher.Aead(aead_chacha20_poly1305(key, iv))
  }
  if s.cipher == CIPHER_AES_CBC {
    b = aes.new_cipher(key).unwrap
    return RecordCipher.AesCbcDec(cipher.new_cbc_decrypter(b, iv)) if is_read
    return RecordCipher.AesCbcEnc(cipher.new_cbc_encrypter(b, iv))
  }
  if s.cipher == CIPHER_3DES_CBC {
    db = des.new_triple_des_cipher(key).unwrap
    return RecordCipher.DesCbcDec(cipher.new_cbc_decrypter(db, iv)) if is_read
    return RecordCipher.DesCbcEnc(cipher.new_cbc_encrypter(db, iv))
  }
  if s.cipher == CIPHER_RC4 {
    return RecordCipher.Rc4(rc4.new_cipher(key).unwrap)
  }
  RecordCipher.Null
}

# A record MAC key (Go's suite.mac: an HMAC hash.Hash), or none.
struct RecordMac {
  hash: crypto.Hash
  key: [Byte]

  def size -> Int { self.hash.size }

  # Go's tls10MAC.
  def compute(seq: [Byte], header: [Byte], data: [Byte]) -> [Byte] {
    m = hmac.new(hash_ctor(self.hash), key)
    m.write!(seq)
    m.write!(header)
    m.write!(data)
    m.sum([])
  }
}

def suite_mac(s: CipherSuiteImpl, key: [Byte]) -> RecordMac? {
  return RecordMac.new(hash: crypto.Hash.SHA1, key: key) if s.mac == MAC_SHA1
  return RecordMac.new(hash: crypto.Hash.SHA256, key: key) if s.mac == MAC_SHA256
  none
}
