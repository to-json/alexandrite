# Go's conn_test.go. Not translated: TestBrokenCertificateSkipped's
# deprecation-warning path, TestHairpinInClose (a net.Conn whose Close
# calls back into the tls.Conn: alx transports are functions, so the
# re-entrancy can't arise the same way), TestRecordBadVersionTLS13 /
# TestKeyUpdateSpamPostHandshakeTLS13 (they inject raw records through a
# custom net.Conn wrapper; covered by the replay harness).

import "net"

test "RoundUp" {
  assert round_up(0, 16) == 0 && round_up(1, 16) == 16 && round_up(15, 16) == 16 && round_up(16, 16) == 16 && round_up(17, 16) == 32, "roundUp broken"
}

test "RemovePadding" {
  bad255 = [0.as_u8; 256]
  good255 = [255.as_u8; 256]
  i = 1
  while i < 256 {
    bad255[i] = 255
    i += 1
  }
  tests: [([Byte], Bool, Int)] = [([1, 2, 3, 4, 0], true, 4), ([1, 2, 3, 4, 0, 1], false, 0), ([1, 2, 3, 4, 99, 99], false, 0), ([1, 2, 3, 4, 1, 1], true, 4), ([1, 2, 3, 2, 2, 2], true, 3), ([1, 2, 3, 3, 3, 3], true, 2), ([1, 2, 3, 4, 3, 3], false, 0), ([1, 4, 4, 4, 4, 4], true, 1), ([5, 5, 5, 5, 5, 5], true, 0), ([6, 6, 6, 6, 6, 6], false, 0), (bad255, false, 0), (good255, true, 0)]
  j = 0
  for t in tests {
    input, good, expected_len = t
    plen, g = extract_padding(input)
    assert g == (good ? 255 : 0), "##{j}: wrong validity"
    assert input.size - plen == expected_len, "##{j}" if g == 255
    j += 1
  }
}

test "CertificateSelection" {
  ex = hx("")
  wild = hx("")
  foo = hx("")
  config = Config.new(certificates: [Certificate.new(certificate: [ex]), Certificate.new(certificate: [wild]), Certificate.new(certificate: [foo])])
  config.build_name_to_certificate!
  index = ->(c: Certificate) -> Int {
    r = -1
    i = 0
    for k in config.certificates {
      r = i if k.certificate[0] == c.certificate[0] && r < 0
      i += 1
    }
    r
  }
  pick = ->(name: Str) -> Int { index.call(config.get_certificate_for(ClientHelloInfo.new(server_name: name)).unwrap) }
  assert_eq pick.call("example.com"), 0
  assert_eq pick.call("bar.example.com"), 1
  assert_eq pick.call("foo.example.com"), 2
  assert_eq pick.call("foo.bar.example.com"), 0
}

# Go's runDynamicRecordSizingTest.
def run_dynamic_record_sizing_test(server_config0: Config) {
  client_conn, server_conn = local_pipe()
  server_config = server_config0
  server_config.dynamic_record_sizing_disabled = false
  tls_conn = server(server_conn, server_config)
  cc = test_config_client()
  cc.min_version = server_config.min_version
  cc.max_version = server_config.max_version
  cc.cipher_suites = server_config.cipher_suites
  ccd = cc.dup
  done = Chan[Bool].new(1)
  task = spawn {
    raw = client_conn
    cli = client(raw, ccd)
    out: [Int] = []
    ok = cli.handshake!.ok?
    done << true
    if ok {
      hdr = [0.as_u8; 5]
      loop {
        r = io_read_full(raw, hdr)
        break if r == 0
        length = (hdr[3].to_i << 8) | hdr[4].to_i
        rec = [0.as_u8; length]
        io_read_full(raw, rec)
        out << RECORD_HEADER_LEN + length
      }
    }
    raw.close!
    (ok, out)
  }
  tls_conn.handshake!.unwrap
  done.recv
  plaintext = ("x" * RECORD_SIZE_BOOST_THRESHOLD).bytes + ("y" * (MAX_PLAINTEXT * 2)).bytes + ("z" * MAX_PLAINTEXT).bytes
  tls_conn.write!(plaintext).unwrap
  tls_conn.close!.unwrap
  ok, sizes0 = task.wait.unwrap
  assert ok, "client handshake failed"
  # The last two records are the close_notify and the client's.
  sizes = sizes0[0...sizes0.size - 1]
  seen_large = false
  i = 0
  for size in sizes {
    if !seen_large {
      assert size <= (i + 1) * TCP_MSS_ESTIMATE, "Record ##{i} has size #{size}, which is too large too soon"
      seen_large = true if size >= MAX_PLAINTEXT
    } else {
      assert size > MAX_PLAINTEXT, "Record ##{i} has size #{size} but should be full sized" if i < sizes.size - 1
    }
    i += 1
  }
  assert seen_large, "No large records observed"
}

# Reads exactly p.size bytes; 0 at a clean EOF.
def io_read_full(c: net.Conn, p: [Byte]) -> Int {
  cc = c
  n = 0
  while n < p.size {
    k = cc.read!(p[n...p.size]).ok || 0
    return n if k == 0
    n += k
  }
  n
}

test "DynamicRecordSizingWithStreamCipher" {
  c = test_config_server()
  c.max_version = VERSION_TLS12
  c.cipher_suites = [TLS_RSA_WITH_RC4_128_SHA]
  run_dynamic_record_sizing_test(c)
}

test "DynamicRecordSizingWithCBC" {
  c = test_config_server()
  c.max_version = VERSION_TLS12
  c.cipher_suites = [TLS_RSA_WITH_AES_256_CBC_SHA]
  run_dynamic_record_sizing_test(c)
}

test "DynamicRecordSizingWithAEAD" {
  c = test_config_server()
  c.max_version = VERSION_TLS12
  c.cipher_suites = [TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256]
  run_dynamic_record_sizing_test(c)
}

test "DynamicRecordSizingWithTLSv13" { run_dynamic_record_sizing_test(test_config_server()) }
