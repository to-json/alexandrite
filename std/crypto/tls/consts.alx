# CurveID: the IANA ID of a key exchange mechanism (named group).
pub CURVE_P256: U16 = 23
pub CURVE_P384: U16 = 24
pub CURVE_P521: U16 = 25
pub X25519: U16 = 29
pub X25519_MLKEM768: U16 = 4588
pub SECP256R1_MLKEM768: U16 = 4587
pub SECP384R1_MLKEM1024: U16 = 4589
pub MLKEM1024: U16 = 514

# Go's CurveID.String().
pub def curve_id_string(c: U16) -> Str {
  return "P256" if c == CURVE_P256
  return "P384" if c == CURVE_P384
  return "P521" if c == CURVE_P521
  return "X25519" if c == X25519
  return "X25519MLKEM768" if c == X25519_MLKEM768
  return "SecP256r1MLKEM768" if c == SECP256R1_MLKEM768
  return "SecP384r1MLKEM1024" if c == SECP384R1_MLKEM1024
  return "MLKEM1024" if c == MLKEM1024
  "CurveID(" + c.to_s + ")"
}

def tls13_only_key_exchange?(c: U16) -> Bool { c == X25519_MLKEM768 || c == SECP256R1_MLKEM768 || c == SECP384R1_MLKEM1024 || c == MLKEM1024 }

def pq_key_exchange?(c: U16) -> Bool { tls13_only_key_exchange?(c) }

PSK_MODE_PLAIN: Byte = 0
PSK_MODE_DHE: Byte = 1

POINT_FORMAT_UNCOMPRESSED: Byte = 0

STATUS_TYPE_OCSP: Byte = 1

CERT_TYPE_RSA_SIGN: Byte = 1
CERT_TYPE_ECDSA_SIGN: Byte = 64

SIGNATURE_PKCS1V15: Byte = 225
SIGNATURE_RSAPSS: Byte = 226
SIGNATURE_ECDSA: Byte = 227
SIGNATURE_ED25519: Byte = 228
SIGNATURE_MLDSA: Byte = 229

# SignatureScheme: a signature algorithm supported by TLS (RFC 8446, 4.2.3).
pub PKCS1_WITH_SHA256: U16 = 0x0401
pub PKCS1_WITH_SHA384: U16 = 0x0501
pub PKCS1_WITH_SHA512: U16 = 0x0601
pub PSS_WITH_SHA256: U16 = 0x0804
pub PSS_WITH_SHA384: U16 = 0x0805
pub PSS_WITH_SHA512: U16 = 0x0806
pub ECDSA_WITH_P256_AND_SHA256: U16 = 0x0403
pub ECDSA_WITH_P384_AND_SHA384: U16 = 0x0503
pub ECDSA_WITH_P521_AND_SHA512: U16 = 0x0603
pub ED25519: U16 = 0x0807
pub MLDSA44: U16 = 0x0904
pub MLDSA65: U16 = 0x0905
pub MLDSA87: U16 = 0x0906
pub PKCS1_WITH_SHA1: U16 = 0x0201
pub ECDSA_WITH_SHA1: U16 = 0x0203

# Go's SignatureScheme.String().
pub def signature_scheme_string(s: U16) -> Str {
  return "PKCS1WithSHA256" if s == PKCS1_WITH_SHA256
  return "PKCS1WithSHA384" if s == PKCS1_WITH_SHA384
  return "PKCS1WithSHA512" if s == PKCS1_WITH_SHA512
  return "PSSWithSHA256" if s == PSS_WITH_SHA256
  return "PSSWithSHA384" if s == PSS_WITH_SHA384
  return "PSSWithSHA512" if s == PSS_WITH_SHA512
  return "ECDSAWithP256AndSHA256" if s == ECDSA_WITH_P256_AND_SHA256
  return "ECDSAWithP384AndSHA384" if s == ECDSA_WITH_P384_AND_SHA384
  return "ECDSAWithP521AndSHA512" if s == ECDSA_WITH_P521_AND_SHA512
  return "Ed25519" if s == ED25519
  return "MLDSA44" if s == MLDSA44
  return "MLDSA65" if s == MLDSA65
  return "MLDSA87" if s == MLDSA87
  return "PKCS1WithSHA1" if s == PKCS1_WITH_SHA1
  return "ECDSAWithSHA1" if s == ECDSA_WITH_SHA1
  "SignatureScheme(" + s.to_s + ")"
}

# ClientAuthType: the server's policy for TLS client authentication.
pub NO_CLIENT_CERT = 0
pub REQUEST_CLIENT_CERT = 1
pub REQUIRE_ANY_CLIENT_CERT = 2
pub VERIFY_CLIENT_CERT_IF_GIVEN = 3
pub REQUIRE_AND_VERIFY_CLIENT_CERT = 4

def requires_client_cert?(c: Int) -> Bool { c == REQUIRE_ANY_CLIENT_CERT || c == REQUIRE_AND_VERIFY_CLIENT_CERT }

# RenegotiationSupport.
pub RENEGOTIATE_NEVER = 0
pub RENEGOTIATE_ONCE_AS_CLIENT = 1
pub RENEGOTIATE_FREELY_AS_CLIENT = 2

# QUIC / ECH are not supported; their constants exist for messages.
INNER_ECH_EXT: Byte = 1

HELLO_RETRY_REQUEST_RANDOM: [Byte] = [0xCF, 0x21, 0xAD, 0x74, 0xE5, 0x9A, 0x61, 0x11, 0xBE, 0x1D, 0x8C, 0x02, 0x1E, 0x65, 0xB8, 0x91, 0xC2, 0xA2, 0x11, 0x16, 0x7A, 0xBB, 0x8C, 0x5E, 0x07, 0x9E, 0x09, 0xE2, 0xC8, 0xA8, 0x33, 0x9C]

DOWNGRADE_CANARY_TLS12 = "DOWNGRD\u0001"
DOWNGRADE_CANARY_TLS11 = "DOWNGRD\u0000"

