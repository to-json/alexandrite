# Protocol constants (Go's common.go and cipher_suites.go).

import "strconv"
import "strings"

pub VERSION_TLS10: U16 = 0x0301
pub VERSION_TLS11: U16 = 0x0302
pub VERSION_TLS12: U16 = 0x0303
pub VERSION_TLS13: U16 = 0x0304
# Deprecated: SSLv3 is cryptographically broken, and is no longer supported.
pub VERSION_SSL30: U16 = 0x0300

# The IANA name of a TLS version ("TLS 1.3"), or "0x0305" if unknown.
pub def version_name(version: U16) -> Str {
  return "SSLv3" if version == VERSION_SSL30
  return "TLS 1.0" if version == VERSION_TLS10
  return "TLS 1.1" if version == VERSION_TLS11
  return "TLS 1.2" if version == VERSION_TLS12
  return "TLS 1.3" if version == VERSION_TLS13
  "0x" + hex4(version.to_i)
}

def hex4(v: Int) -> Str {
  s = strings.to_upper(strconv.format_int(v, 16))
  while s.size < 4 {
    s = "0" + s
  }
  s
}

