# Go's key_schedule_test.go.

import "crypto"

test "ACVPVectors" {
  psk = hx("56288B726C73829F7A3E47B103837C8139ACF552E7530C7A710B35ED41191698")
  dhe = hx("EFFE9EC26AA29FD750DFA6A10B944D74071595B27EE88887D5E11C84590B5CC3")
  hello_client_random = hx("E9137679E582BA7C1DB41CF725F86C6D09C8C05F297BAD9A65B552EAF524FDE4")
  hello_server_random = hx("23ECCFD030790748C8F8D8A656FD98D717F1B62AF3712F97211D2070B499F98A")
  finished_client_random = hx("62A62FA75563ED4FDCAA0BC16567B314871C304ACF06B0FFC3F08C1797594D43")
  finished_server_random = hx("C750EDA6696CD101B142BD79E00E6AC8C5F2C0ABC78DD64F4D991326659E9299")
  transcript = new_transcript(crypto.Hash.SHA256)
  es = new_early_secret(crypto.Hash.SHA256, psk)
  transcript.write!(hello_client_random)
  assert_eq hs(es.client_early_traffic_secret(transcript)), "3272189698c3594d18f58efa3f12b638a249515099be7a2fa9836babe74f0111"
  assert_eq hs(es.early_exporter_master_secret(transcript).secret), "88e078f562cdc930219f6a5e98a1ce8c6e5f3dac5ac516459a96f2ef8f114c66"
  h = es.handshake_secret(dhe)
  transcript.write!(hello_server_random)
  assert_eq hs(h.client_handshake_traffic_secret(transcript)), "b32306c3ce9932c460a1fe6c0f060593974842036b96fa45049b7352e71c2ad2"
  assert_eq hs(h.server_handshake_traffic_secret(transcript)), "22787f8ca269d34bc549ac8ba19f2040938a3aa370d7cc9d60f720882b88d01b"
  ms = h.master_secret
  transcript.write!(finished_server_random)
  assert_eq hs(ms.client_application_traffic_secret(transcript)), "47d7ea08397b5871154b0fe85584bcc30a87c69e84d69b56007c5b21f76493ba"
  assert_eq hs(ms.server_application_traffic_secret(transcript)), "efbdb0c873c0480da57307083839a8984be25b9a8545e4fca029940fe2800565"
  assert_eq hs(ms.exporter_master_secret(transcript).secret), "8a43d787ee3804ead4a2a5b32972f9896b696295645d7222e1fd081ddd939834"
  transcript.write!(finished_client_random)
  assert_eq hs(ms.resumption_master_secret(transcript)), "5f4c961329c91044011acbecb0b289282e0e3fed045cb3ea924dffe5fe654b3d"
}

test "TrafficKey" {
  traffic_secret = hx("b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38")
  c = cipher_suites_tls13()[0]
  key, iv = traffic_key(c, traffic_secret)
  assert_eq hs(key), "3fce516009c21727d0f2e4e86ee403bc"
  assert_eq hs(iv), "5d313eb2671276ee13000b30"
}
