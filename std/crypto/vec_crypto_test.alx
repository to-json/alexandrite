# Generated from Go's crypto (go1.27.1): every Hash's name, size and
# availability (with crypto/md5, sha1, sha256, sha512 and sha3 imported), and
# sums through Hash.New; do not edit by hand.

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

def hexs(p: [Byte]) -> Str {
  digits = "0123456789abcdef"
  out: [Byte] = []
  for x in p {
    out << digits[(x >> 4).to_i]
    out << digits[(x & 15).to_i]
  }
  Str.from_bytes(out)
}

# Hash number n: its name, size and availability.
def info(n: Int, name: Str, size: Int, available: Bool) {
  h = Hash.from(n).unwrap
  assert_eq h.value, n
  assert_eq h.to_s, name
  assert_eq "#{h}", name
  assert_eq h.size, size
  assert_eq h.available?, available
}

# The sum of gen(seed, len) through Hash number n's new.
def sv(n: Int, seed: U64, len: Int, want: Str) {
  h = Hash.from(n).unwrap
  d = h.new
  d.write!(gen(seed, len)).unwrap
  s = d.sum([])
  assert_eq s.size, h.size
  assert_eq hexs(s), want
}

