# Go's cert_pool_test.go, translated. Go's nil *CertPool is the zero
# CertPool (CertPool.new) here.

test "CertPoolEqual" {
  tc = Certificate.new(raw: [1.as_u8, 2, 3], raw_subject: [2.as_u8])
  other_tc = Certificate.new(raw: [9.as_u8, 8, 7], raw_subject: [8.as_u8])
  empty_pool = new_cert_pool()
  non_system_populated = new_cert_pool()
  non_system_populated.add_cert!(tc)
  non_system_populated_alt = new_cert_pool()
  non_system_populated_alt.add_cert!(other_tc)
  empty_system = ~system_cert_pool()
  populated_system = ~system_cert_pool()
  populated_system.add_cert!(tc)
  populated_system_alt = ~system_cert_pool()
  populated_system_alt.add_cert!(other_tc)
  nil_pool = CertPool.new
  tests = [
    ("two empty pools", empty_pool, empty_pool, true),
    ("one empty pool, one populated pool", empty_pool, non_system_populated, false),
    ("two populated pools", non_system_populated, non_system_populated, true),
    ("two populated pools, different content", non_system_populated, non_system_populated_alt, false),
    ("two empty system pools", empty_system, empty_system, true),
    ("one empty system pool, one populated system pool", empty_system, populated_system, false),
    ("two populated system pools", populated_system, populated_system, true),
    ("two populated pools, different content", populated_system, populated_system_alt, false),
    ("two nil pools", nil_pool, nil_pool, true),
    ("one nil pool, one empty pool", nil_pool, empty_pool, false),
  ]
  for t in tests {
    name, a, b, equal = t
    assert a.equal?(b) == equal, "#{name}: got #{a.equal?(b)}, want #{equal}"
  }
}
