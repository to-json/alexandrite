# Go's hybrid_pool_test.go, translated. Go dials google.com:443 for a
# chain and checks it against the platform verifier (windows/darwin only);
# alx has no platform verifier and the test mustn't need the network, so
# the google.com chain is verify_test's (googleLeaf + gtsIntermediate, at
# the time they were valid), checked only when the system roots hold GTS
# Root R1. The rest (a system pool extended with a custom root verifies
# both kinds of chain) is Go's.

import "crypto/ecdsa"
import "crypto/elliptic"
import "crypto/rand"
import "crypto/x509/pkix"
import "math/big"
import "time"

test "HybridPool" {
  root_tmpl = Certificate.new(serial_number: big.new_int(1), subject: pkix.Name.new(common_name: "Go test root"), is_ca: true, basic_constraints_valid: true, not_before: time.now().add(time.hour * -1), not_after: time.now().add(time.hour * 10))
  k = ~ecdsa.generate_key(elliptic.p256(), rand.reader())
  root_der = ~create_certificate(rand.reader(), root_tmpl, root_tmpl, PublicKey.Ecdsa(k.public_key), PrivateKey.Ecdsa(k))
  root = ~parse_certificate(root_der)
  pool = ~system_cert_pool()
  have_gts = false
  for c in pool.certs {
    have_gts = true if c.subject.common_name == "GTS Root R1"
  }
  goog_leaf = ~vt_cert_from_pem(vt_google_leaf())
  goog_inters = new_cert_pool()
  goog_inters.append_certs_from_pem!(vt_gts_intermediate().bytes)
  goog_opts = VerifyOptions.new(roots: pool, intermediates: goog_inters, current_time: time.unix(1677615892, 0))
  if have_gts {
    r1 = goog_leaf.verify(goog_opts)
    assert r1.ok?, "verification failed for google.com chain (system only pool): #{r1.err?.message || ""}"
  }
  pool.add_cert!(root)
  if have_gts {
    r2 = goog_leaf.verify(goog_opts)
    assert r2.ok?, "verification failed for google.com chain (hybrid pool): #{r2.err?.message || ""}"
  }
  cert_tmpl = Certificate.new(serial_number: big.new_int(1), not_before: time.now().add(time.hour * -1), not_after: time.now().add(time.hour * 10), dns_names: ["example.com"])
  cert_der = ~create_certificate(rand.reader(), cert_tmpl, root_tmpl, PublicKey.Ecdsa(k.public_key), PrivateKey.Ecdsa(k))
  cert = ~parse_certificate(cert_der)
  r3 = cert.verify(VerifyOptions.new(roots: pool))
  assert r3.ok?, "verification failed for custom chain (hybrid pool): #{r3.err?.message || ""}"
}
