# Public and private keys as x509 handles them. Go's API passes keys as
# `any` and type-switches on them (*rsa.PublicKey, *ecdsa.PublicKey,
# ed25519.PublicKey, ...); alx has no type switch on interface values
# (D12), so the key types x509 knows are the variants of an enum.

import "crypto"
import "crypto/dsa"
import "crypto/ecdh"
import "crypto/ecdsa"
import "crypto/ed25519"
import "crypto/mldsa"
import "crypto/rsa"
import "io"

# A public key (Go's `any` holding *rsa.PublicKey, *ecdsa.PublicKey,
# ed25519.PublicKey, *ecdh.PublicKey, *dsa.PublicKey or *mldsa.PublicKey).
# None is Go's nil (an unknown algorithm's key).
pub enum PublicKey {
  None
  Rsa(rsa.PublicKey)
  Ecdsa(ecdsa.PublicKey)
  Ed25519(ed25519.PublicKey)
  Ecdh(ecdh.PublicKey)
  Dsa(dsa.PublicKey)
  MlDsa(mldsa.PublicKey)

  # Whether two keys are the same key (Go's pub.Equal(other)).
  pub def equal?(other: PublicKey) -> Bool {
    case self {
      None => other.none?
      Rsa(k) => {
        case other {
          Rsa(o) => k.equal?(o)
          _ => false
        }
      }
      Ecdsa(k) => {
        case other {
          Ecdsa(o) => k.equal?(o)
          _ => false
        }
      }
      Ed25519(k) => {
        case other {
          Ed25519(o) => k.equal?(o)
          _ => false
        }
      }
      Ecdh(k) => {
        case other {
          Ecdh(o) => k.equal?(o)
          _ => false
        }
      }
      Dsa(k) => {
        case other {
          Dsa(o) => k == o
          _ => false
        }
      }
      MlDsa(k) => {
        case other {
          MlDsa(o) => k.equal?(o)
          _ => false
        }
      }
    }
  }

  pub def none? -> Bool {
    case self {
      None => true
      _ => false
    }
  }
}

# A private key (Go's `any` holding *rsa.PrivateKey, *ecdsa.PrivateKey,
# ed25519.PrivateKey, *ecdh.PrivateKey or *mldsa.PrivateKey).
pub enum PrivateKey {
  None
  Rsa(rsa.PrivateKey)
  Ecdsa(ecdsa.PrivateKey)
  Ed25519(ed25519.PrivateKey)
  Ecdh(ecdh.PrivateKey)
  MlDsa(mldsa.PrivateKey)

  # The public half (Go's priv.Public()).
  pub def public -> PublicKey {
    case self {
      None => PublicKey.None
      Rsa(k) => PublicKey.Rsa(k.public_key)
      Ecdsa(k) => PublicKey.Ecdsa(k.public_key)
      Ed25519(k) => PublicKey.Ed25519(k.public_key)
      Ecdh(k) => PublicKey.Ecdh(k.public_key)
      MlDsa(k) => PublicKey.MlDsa(k.public_key)
    }
  }

  # Whether the key can sign (Go's `priv.(crypto.Signer)`).
  pub def signer? -> Bool {
    case self {
      Rsa(_) => true
      Ecdsa(_) => true
      Ed25519(_) => true
      MlDsa(_) => true
      _ => false
    }
  }

  # Go's crypto.Signer.Sign on the key.
  pub def sign(rand: io.Reader, digest: [Byte], opts: crypto.SignerOpts) -> ~[Byte] {
    r: [Byte] = []
    case self {
      Rsa(k) => {
        r = k.~sign(rand, digest, opts)
      }
      Ecdsa(k) => {
        r = k.~sign(rand, digest, opts)
      }
      Ed25519(k) => {
        r = k.~sign(rand, digest, opts)
      }
      MlDsa(k) => {
        r = k.~sign(rand, digest, opts)
      }
      _ => {
        fail X509Error.Msg("x509: certificate private key does not implement crypto.Signer")
      }
    }
    r
  }

  pub def none? -> Bool {
    case self {
      None => true
      _ => false
    }
  }
}
