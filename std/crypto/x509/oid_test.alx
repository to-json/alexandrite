# Go's crypto/x509/oid_test.go.
#
# Go's UnmarshalText / UnmarshalBinary (pointer receivers) are parse_oid /
# oid_from_binary; AppendText / AppendBinary are marshal_text /
# marshal_binary appended to a prefix. The interface assertions
# (encoding.BinaryMarshaler, ...) have no counterpart.

import "encoding/asn1"

struct OidCase {
  raw: [Byte]
  valid: Bool
  str: Str
  # none: Go's nil (the arcs don't fit a uint64).
  ints: [U64]?
}

def oc(raw: [Byte], valid: Bool, str: Str, ints: [U64]?) -> OidCase { OidCase.new(raw: raw, valid: valid, str: str, ints: ints) }

def oid_tests -> [OidCase] {
  e: [Byte] = []
  no: [U64]? = none
  [
    oc(e, false, "", no),
    oc([0x80.as_u8, 0x01], false, "", no),
    oc([0x01.as_u8, 0x80, 0x01], false, "", no),
    oc([1.as_u8, 2, 3], true, "0.1.2.3", [0.as_u64, 1, 2, 3]),
    oc([41.as_u8, 2, 3], true, "1.1.2.3", [1.as_u64, 1, 2, 3]),
    oc([86.as_u8, 2, 3], true, "2.6.2.3", [2.as_u64, 6, 2, 3]),
    oc([41.as_u8, 255, 255, 255, 127], true, "1.1.268435455", [1.as_u64, 1, 268435455]),
    oc([41.as_u8, 0x87, 255, 255, 255, 127], true, "1.1.2147483647", [1.as_u64, 1, 2147483647]),
    oc([41.as_u8, 255, 255, 255, 255, 127], true, "1.1.34359738367", [1.as_u64, 1, 34359738367]),
    oc([42.as_u8, 255, 255, 255, 255, 255, 255, 255, 255, 127], true, "1.2.9223372036854775807", [1.as_u64, 2, 9223372036854775807]),
    oc([43.as_u8, 0x81, 255, 255, 255, 255, 255, 255, 255, 255, 127], true, "1.3.18446744073709551615", [1.as_u64, 3, 18446744073709551615]),
    oc([44.as_u8, 0x83, 255, 255, 255, 255, 255, 255, 255, 255, 127], true, "1.4.36893488147419103231", no),
    oc([85.as_u8, 255, 255, 255, 255, 255, 255, 255, 255, 255, 127], true, "2.5.1180591620717411303423", no),
    oc([85.as_u8, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 127], true, "2.5.19342813113834066795298815", no),
    oc([255.as_u8, 255, 255, 127], true, "2.268435375", [2.as_u64, 268435375]),
    oc([0x87.as_u8, 255, 255, 255, 127], true, "2.2147483567", [2.as_u64, 2147483567]),
    oc([255.as_u8, 127], true, "2.16303", [2.as_u64, 16303]),
    oc([255.as_u8, 255, 255, 255, 127], true, "2.34359738287", [2.as_u64, 34359738287]),
    oc([255.as_u8, 255, 255, 255, 255, 255, 255, 255, 127], true, "2.9223372036854775727", [2.as_u64, 9223372036854775727]),
    oc([0x81.as_u8, 255, 255, 255, 255, 255, 255, 255, 255, 127], true, "2.18446744073709551535", [2.as_u64, 18446744073709551535]),
    oc([0x83.as_u8, 255, 255, 255, 255, 255, 255, 255, 255, 127], true, "2.36893488147419103151", no),
    oc([255.as_u8, 255, 255, 255, 255, 255, 255, 255, 255, 127], true, "2.1180591620717411303343", no),
    oc([255.as_u8, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 127], true, "2.19342813113834066795298735", no),
    oc([41.as_u8, 0x80 | 66, 0x80 | 44, 0x80 | 11, 33], true, "1.1.139134369", [1.as_u64, 1, 139134369]),
    oc([(0x80 | 66).as_u8, 0x80 | 44, 0x80 | 11, 33], true, "2.139134289", [2.as_u64, 139134289])
  ]
}

def must_new_oid_from_ints(ints: [U64]) -> OID { oid_from_ints(ints).unwrap }

test "OID" {
  for v in oid_tests() {
    o = new_oid_from_der(v.raw)
    assert_eq o.some?, v.valid
    oid = o || OID.new
    next if !v.valid
    assert_eq oid.to_s, v.str
    asn1_oid: [Int]? = none
    if ints = v.ints {
      arcs: [Int] = []
      fits = true
      for x in ints {
        if x > 2147483647 {
          fits = false
          break
        }
        arcs << x.to_i
      }
      asn1_oid = arcs if fits
    }
    got = oid.to_asn1_oid
    assert_eq got.some?, asn1_oid.some?
    if a = asn1_oid {
      assert (got || asn1.oid([])).equal?(asn1.oid(a)), "to_asn1_oid of #{v.str}"
    }
    if ints = v.ints {
      oid2 = oid_from_ints(ints).unwrap
      assert oid2.equal?(oid), "oid_from_ints(#{v.str})"
    }
  }
}

test "InvalidOID" {
  cases = [("", []), ("1", [1.as_u64]), ("3", [3.as_u64]), ("3.100.200", [3.as_u64, 100, 200]), ("1.81", [1.as_u64, 81]), ("1.81.200", [1.as_u64, 81, 200])]
  for tt in cases {
    ints: [U64] = tt[1]
    assert !oid_from_ints(ints).ok?, "OIDFromInts(#{tt[0]})"
    assert !parse_oid(tt[0]).ok?, "ParseOID(#{tt[0]})"
  }
}

test "OIDEqual" {
  cases = [
    (must_new_oid_from_ints([1, 2, 3]), must_new_oid_from_ints([1, 2, 3]), true),
    (must_new_oid_from_ints([1, 2, 3]), must_new_oid_from_ints([1, 2, 4]), false),
    (must_new_oid_from_ints([1, 2, 3]), must_new_oid_from_ints([1, 2, 3, 4]), false),
    (must_new_oid_from_ints([2, 33, 22]), must_new_oid_from_ints([2, 33, 23]), false),
    (OID.new, OID.new, true),
    (OID.new, must_new_oid_from_ints([2, 33, 23]), false)
  ]
  for tt in cases {
    assert_eq tt[0].equal?(tt[1]), tt[2]
  }
}

test "OIDMarshal" {
  # (input, output, valid)
  cases: [(Str, OID, Bool)] = []
  for s in ["", "0", "1", ".1", ".1.", "1.", "1..", "1.2.", "1.2.333.", "1.2.333..", "1.2..", "+1.2", "-1.2", "1.-2", "1.2.+333"] {
    cases << (s, OID.new, false)
  }
  for v in oid_tests() {
    if oid = new_oid_from_der(v.raw) {
      cases << (v.str, oid, true)
    }
  }
  for tt in cases {
    r = parse_oid(tt[0])
    assert_eq r.ok?, tt[2]
    if e = r.err {
      assert_eq e.message, "invalid oid"
    }
    next if !tt[2]
    o = r.unwrap
    assert o.equal?(tt[1]), "ParseOID(#{tt[0]}) = #{o.to_s}"
    assert_eq Str.from_bytes(o.marshal_text), tt[0]
    text_append: [Byte] = [0, 0, 0, 0]
    text_append = text_append + o.marshal_text
    assert_eq Str.from_bytes(text_append[4...text_append.size]), tt[0]
    binary = o.marshal_binary
    o3 = oid_from_binary(binary).unwrap
    assert o3.equal?(tt[1]), "UnmarshalBinary(#{binary})"
    binary_append: [Byte] = [0, 0, 0, 0]
    binary_append = binary_append + o.marshal_binary
    o4 = oid_from_binary(binary_append[4...binary_append.size]).unwrap
    assert o4.equal?(tt[1]), "UnmarshalBinary(append)"
  }
}

test "OIDEqualASN1OID" {
  max_int32_plus_one = 2147483647 + 1
  cases = [
    (must_new_oid_from_ints([1, 2, 3]), asn1.oid([1, 2, 3]), true),
    (must_new_oid_from_ints([1, 2, 3]), asn1.oid([1, 2, 4]), false),
    (must_new_oid_from_ints([1, 2, 3]), asn1.oid([1, 2, 3, 4]), false),
    (must_new_oid_from_ints([1, 33, 22]), asn1.oid([1, 33, 23]), false),
    (must_new_oid_from_ints([1, 33, 23]), asn1.oid([1, 33, 22]), false),
    (must_new_oid_from_ints([1, 33, 127]), asn1.oid([1, 33, 127]), true),
    (must_new_oid_from_ints([1, 33, 128]), asn1.oid([1, 33, 127]), false),
    (must_new_oid_from_ints([1, 33, 128]), asn1.oid([1, 33, 128]), true),
    (must_new_oid_from_ints([1, 33, 129]), asn1.oid([1, 33, 129]), true),
    (must_new_oid_from_ints([1, 33, 128]), asn1.oid([1, 33, 129]), false),
    (must_new_oid_from_ints([1, 33, 129]), asn1.oid([1, 33, 128]), false),
    (must_new_oid_from_ints([1, 33, 255]), asn1.oid([1, 33, 255]), true),
    (must_new_oid_from_ints([1, 33, 256]), asn1.oid([1, 33, 256]), true),
    (must_new_oid_from_ints([2, 33, 257]), asn1.oid([2, 33, 256]), false),
    (must_new_oid_from_ints([2, 33, 256]), asn1.oid([2, 33, 257]), false),
    (must_new_oid_from_ints([1, 33]), asn1.oid([1, 33, 2147483647]), false),
    (must_new_oid_from_ints([1, 33, 2147483647]), asn1.oid([1, 33]), false),
    (must_new_oid_from_ints([1, 33, 2147483647]), asn1.oid([1, 33, 2147483647]), true),
    (must_new_oid_from_ints([1, 33, 2147483648]), asn1.oid([1, 33, max_int32_plus_one]), false),
    (must_new_oid_from_ints([1, 33, 256]), asn1.oid([]), false),
    (OID.new, asn1.oid([1, 33, 256]), false),
    (OID.new, asn1.oid([]), false)
  ]
  for tt in cases {
    assert_eq tt[0].equal_asn1_oid?(tt[1]), tt[2]
  }
}

test "OIDUnmarshalBinary" {
  for tt in oid_tests() {
    r = oid_from_binary(tt.raw)
    assert_eq r.ok?, tt.valid
    if e = r.err {
      assert_eq e.message, "invalid oid"
    }
  }
}

bench "OIDMarshalUnmarshalText" {
  oid = must_new_oid_from_ints([1, 2, 3, 9999, 1024])
  text = oid.marshal_text
  parse_oid(Str.from_bytes(text)).unwrap
}

test "OIDFromASN1OID" {
  r = oid_from_asn1_oid(asn1.oid([-1]))
  assert_eq r.err?.message || "", "x509: OID components must be non-negative"
  r2 = oid_from_asn1_oid(asn1.oid([1]))
  assert_eq r2.err?.message || "", "invalid oid"
  r3 = oid_from_asn1_oid(asn1.oid([255, 1]))
  assert_eq r3.err?.message || "", "invalid oid"
  r4 = oid_from_asn1_oid(asn1.oid([1, 255]))
  assert_eq r4.err?.message || "", "invalid oid"
}
