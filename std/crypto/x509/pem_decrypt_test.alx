# Go's crypto/x509/pem_decrypt_test.go. The PEM data is in xc_data_test.alx.

import "crypto/rand"
import "encoding/base64"
import "encoding/pem"

struct PdCase {
  kind: PEMCipher
  password: Str
  pem_data: Str
  plain_der: Str
}

def pd_test_data -> [PdCase] {
  [
    PdCase.new(kind: PEMCipher.DES, password: "asdf", pem_data: xc_pd_pem0(), plain_der: xc_pd_der0()),
    PdCase.new(kind: PEMCipher.TripleDES, password: "asdf", pem_data: xc_pd_pem1(), plain_der: xc_pd_der1()),
    PdCase.new(kind: PEMCipher.AES128, password: "asdf", pem_data: xc_pd_pem2(), plain_der: xc_pd_der2()),
    PdCase.new(kind: PEMCipher.AES192, password: "asdf", pem_data: xc_pd_pem3(), plain_der: xc_pd_der3()),
    PdCase.new(kind: PEMCipher.AES256, password: "asdf", pem_data: xc_pd_pem4(), plain_der: xc_pd_der4()),
    # generated with:
    # openssl genrsa -aes128 -passout pass:asdf -out server.orig.key 128
    PdCase.new(kind: PEMCipher.AES128, password: "asdf", pem_data: xc_pd_pem5(), plain_der: xc_pd_der5())
  ]
}

test "Decrypt" {
  for data in pd_test_data() {
    blk, rest = pem.decode(data.pem_data.bytes)
    assert_eq rest.size, 0
    der = decrypt_pem_block(blk.unwrap, data.password.bytes).unwrap
    assert parse_pkcs1_private_key(der).ok?, "invalid private key (#{data.kind.value})"
    plain_der = base64.std_encoding().decode_string(data.plain_der).unwrap
    assert_eq der, plain_der
  }
}

test "Encrypt" {
  for data in pd_test_data() {
    plain_der = base64.std_encoding().decode_string(data.plain_der).unwrap
    password = "kremvax1".bytes
    blk = encrypt_pem_block(rand.reader(), "RSA PRIVATE KEY", plain_der, password, data.kind).unwrap
    assert is_encrypted_pem_block?(blk), "PEM block does not appear to be encrypted"
    assert_eq blk.type, "RSA PRIVATE KEY"
    assert_eq blk.headers["Proc-Type"] || "", "4,ENCRYPTED"
    der = decrypt_pem_block(blk, password).unwrap
    assert_eq der, plain_der
  }
}

test "IncompleteBlock" {
  # incomplete_block_pem contains ciphertext that is not a multiple of the
  # block size. This previously panicked. See #11215.
  blk, _ = pem.decode(xc_incomplete_block_pem().bytes)
  r = decrypt_pem_block(blk.unwrap, "foo".bytes)
  assert !r.ok?, "Bad PEM data decrypted successfully"
  assert (r.err?.message || "").include?("block size"), "unexpected error: #{r.err?.message || ""}"
}

# Not in Go's tests: the other errors of decrypt_pem_block.
test "DecryptErrors" {
  blk, _ = pem.decode(xc_pd_pem2().bytes)
  b = blk.unwrap
  r = decrypt_pem_block(b, "wrong password".bytes)
  # The legacy format can't always tell: either garbage or this error.
  if e = r.err {
    assert_eq e.message, incorrect_password_error().message
  }
  h: Map[Str, Str] = {}
  r2 = decrypt_pem_block(pem.Block.new(type: "X", headers: h, bytes: b.bytes), "asdf".bytes)
  assert_eq r2.err?.message || "", "x509: no DEK-Info header in block"
  h2: Map[Str, Str] = {"DEK-Info" => "AES-128-CBC"}
  r3 = decrypt_pem_block(pem.Block.new(type: "X", headers: h2, bytes: b.bytes), "asdf".bytes)
  assert_eq r3.err?.message || "", "x509: malformed DEK-Info header"
  h3: Map[Str, Str] = {"DEK-Info" => "ROT13,00"}
  r4 = decrypt_pem_block(pem.Block.new(type: "X", headers: h3, bytes: b.bytes), "asdf".bytes)
  assert_eq r4.err?.message || "", "x509: unknown encryption mode"
  h4: Map[Str, Str] = {"DEK-Info" => "AES-128-CBC,0011"}
  r5 = decrypt_pem_block(pem.Block.new(type: "X", headers: h4, bytes: b.bytes), "asdf".bytes)
  assert_eq r5.err?.message || "", "x509: incorrect IV size"
  assert !is_encrypted_pem_block?(pem.Block.new(type: "X", headers: h, bytes: b.bytes)), "no DEK-Info"
}
