# Go's crypto/x509/pkcs8_test.go. Go checks the key's reflect.Type; here
# the PrivateKey variant (kind_of below) and, for ECDSA, the curve's
# nist_bits (Go compares the Curve with elliptic.P224() etc.).

import "encoding/hex"

def pkcs8_rsa_private_key_hex -> Str { "" }

def pkcs8_p224_private_key_hex -> Str { "3078020100301006072a8648ce3d020106052b810400210461305f020101041cca3d72b3e88fed2684576dad9b80a9180363a5424986900e3abcab3fa13c033a0004f8f2a6372872a4e61263ed893afb919576a4cacfecd6c081a2cbc76873cf4ba8530703c6042b3a00e2205087e87d2435d2e339e25702fae1" }

def pkcs8_p256_private_key_hex -> Str { "308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b0201010420dad6b2f49ca774c36d8ae9517e935226f667c929498f0343d2424d0b9b591b43a14403420004b9c9b90095476afe7b860d8bd43568cab7bcb2eed7b8bf2fa0ce1762dd20b04193f859d2d782b1e4cbfd48492f1f533113a6804903f292258513837f07fda735" }

def pkcs8_p384_private_key_hex -> Str { "" }

def pkcs8_p521_private_key_hex -> Str { "" }

def pkcs8_ed25519_private_key_hex -> Str { "302e020100300506032b657004220420d4ee72dbf913584ad5b6d8f1f769f8ad3afe7c28cbf1d4fbe097a88f44755842" }

def pkcs8_x25519_private_key_hex -> Str { "302e020100300506032b656e0422042068ff93a73c5adefd6d498b24e588fd4daa10924d992afed01b43ca5725025a6b" }

# The variant name of a key (Go's reflect.TypeOf).
def kind_of(k: PrivateKey) -> Str {
  case k {
    None => "<nil>"
    Rsa(_) => "*rsa.PrivateKey"
    Ecdsa(_) => "*ecdsa.PrivateKey"
    Ed25519(_) => "ed25519.PrivateKey"
    Ecdh(_) => "*ecdh.PrivateKey"
    MlDsa(_) => "*mldsa.PrivateKey"
  }
}

test "PKCS8" {
  # (name, hex, type, curve bits)
  tests = [
    ("RSA private key", pkcs8_rsa_private_key_hex(), "*rsa.PrivateKey", 0),
    ("P-224 private key", pkcs8_p224_private_key_hex(), "*ecdsa.PrivateKey", 224),
    ("P-256 private key", pkcs8_p256_private_key_hex(), "*ecdsa.PrivateKey", 256),
    ("P-384 private key", pkcs8_p384_private_key_hex(), "*ecdsa.PrivateKey", 384),
    ("P-521 private key", pkcs8_p521_private_key_hex(), "*ecdsa.PrivateKey", 521),
    ("Ed25519 private key", pkcs8_ed25519_private_key_hex(), "ed25519.PrivateKey", 0),
    ("X25519 private key", pkcs8_x25519_private_key_hex(), "*ecdh.PrivateKey", 0)
  ]
  for test in tests {
    der_bytes = hex.decode_string(test[1]).unwrap
    pr = parse_pkcs8_private_key(der_bytes)
    assert pr.ok?, "#{test[0]}: failed to decode PKCS#8: #{pr.err?.message || ""}"
    priv_key = pr.unwrap
    assert_eq kind_of(priv_key), test[2]
    reserialised = marshal_pkcs8_private_key(priv_key).unwrap
    assert_eq hex.encode_to_string(reserialised), test[1]
    case priv_key {
      Ecdsa(ec_key) => {
        assert_eq ec_key.public_key.curve.nist_bits, test[3]
        r = ec_key.ecdh
        if e = r.err {
          assert_eq test[3], 224
        } else {
          reserialised2 = marshal_pkcs8_private_key(PrivateKey.Ecdh(r.unwrap)).unwrap
          assert_eq hex.encode_to_string(reserialised2), test[1]
        }
      }
      _ => nil
    }
  }
}

def hex_pkcs8_test_pkcs1_key -> Str { "" }

def hex_pkcs8_test_ec_key -> Str { "" }

test "PKCS8MismatchKeyFormat" {
  tests = [(hex_pkcs8_test_ec_key(), "use parse_ec_private_key instead"), (hex_pkcs8_test_pkcs1_key(), "use parse_pkcs1_private_key instead")]
  for test in tests {
    der_bytes = hex.decode_string(test[0]).unwrap
    r = parse_pkcs8_private_key(der_bytes)
    m = r.err?.message || ""
    assert m.include?(test[1]), "expected error containing #{test[1]}, got #{m}"
  }
}
