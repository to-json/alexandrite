test "NISTPKITSPolicy" {
  cert_dir = "testdata/nist-pkits/certs"
  b = ~os.read_file("testdata/nist-pkits/vectors.json")
  vectors = ~PkitsVectors.from_json("{\"cases\": " + Str.from_bytes(b) + "}")
  policy_tests: Map[Str, Bool] = {}
  for n in pkits_policy_tests() {
    policy_tests[n] = true
  }
  ran = 0
  for tc in vectors.cases {
    next if !policy_tests.has_key?(tc.name)
    chain: [Certificate] = []
    for c in tc.cert_path {
      cert_der = ~os.read_file("#{cert_dir}/#{c}")
      chain << ~parse_certificate(cert_der)
    }
    chain.reverse!
    initial_policies: [OID] = []
    for pstr in tc.initial_policy_set {
      policy = nist_test_policy(pstr)
      assert policy.some?, "#{tc.name}: unknown test policy: #{pstr}"
      initial_policies << (policy || any_policy_oid())
    }
    valid = policies_valid?(chain, VerifyOptions.new(certificate_policies: initial_policies, inhibit_policy_mapping: tc.initial_policy_mapping_inhibit, require_explicit_policy: tc.initial_explicit_policy, inhibit_any_policy: tc.initial_any_policy_inhibit))
    assert_eq "#{tc.name}: valid #{valid}", "#{tc.name}: valid #{tc.should_validate}"
    ran += 1
  }
  assert_eq ran, 88
}
