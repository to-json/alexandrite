# Go's crypto/x509/pkits_test.go: the policy subset of the NIST PKI path
# validation test suite (testdata/nist-pkits, copied from Go). The suite
# assumes the path is given, so each case runs policies_valid? on it.
# vectors.json is read with #[derive(Json)].

import "encoding/json"
import "os"

#[derive(Json)]
struct PkitsCase {
  #[json("Name")] name: Str
  #[json("CertPath")] cert_path: [Str]
  #[json("InitialPolicySet")] initial_policy_set: [Str]
  #[json("InitialPolicyMappingInhibit")] initial_policy_mapping_inhibit: Bool
  #[json("InitialExplicitPolicy")] initial_explicit_policy: Bool
  #[json("InitialAnyPolicyInhibit")] initial_any_policy_inhibit: Bool
  #[json("ShouldValidate")] should_validate: Bool
  #[json("Skipped")] skipped: Bool
}

#[derive(Json)]
struct PkitsVectors {
  cases: [PkitsCase]
}

def nist_test_policy(name: Str) -> OID? {
  case name {
    "anyPolicy" => any_policy_oid()
    "NIST-test-policy-1" => oid_from_ints([2, 16, 840, 1, 101, 3, 2, 1, 48, 1]).unwrap
    "NIST-test-policy-2" => oid_from_ints([2, 16, 840, 1, 101, 3, 2, 1, 48, 2]).unwrap
    "NIST-test-policy-3" => oid_from_ints([2, 16, 840, 1, 101, 3, 2, 1, 48, 3]).unwrap
    "NIST-test-policy-6" => oid_from_ints([2, 16, 840, 1, 101, 3, 2, 1, 48, 6]).unwrap
    _ => none
  }
}

