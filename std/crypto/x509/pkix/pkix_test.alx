# crypto/x509/pkix has no tests of its own in Go (its behaviour is tested
# through crypto/x509: TestPKIXNameString, TestRDNSequenceString, ... in
# std/crypto/x509). These check the alx-specific parts: the derived ASN.1
# of the structures, and the string forms against Go-generated vectors
# (vec_pkix_test.alx).

import "encoding/asn1"
import "encoding/hex"
import "math/big"
import "time"

def vt(sec: Int) -> time.Time { time.unix(sec, 0) }

test "RDNSequence escaping" {
  atv = ->(oid: [Int], v: Str) -> RelativeDistinguishedNameSET { RelativeDistinguishedNameSET.new(atvs: [AttributeTypeAndValue.new(type: asn1.oid(oid), value: asn1.Any.Str(v))]) }
  seq = RDNSequence.new(rdns: [atv.call([2, 5, 4, 3], " a,b+c\"d\\e<f>g;h "), atv.call([2, 5, 4, 10], "#x#")])
  assert_eq seq.to_s, "O=\\#x#,CN=\\ a\\,b\\+c\\\"d\\\\e\\<f\\>g\\;h\\ "
  # A non-string value of an unknown type prints as its DER in hex.
  odd = RDNSequence.new(rdns: [RelativeDistinguishedNameSET.new(atvs: [AttributeTypeAndValue.new(type: asn1.oid([1, 2, 3]), value: asn1.Any.Int(5))])])
  assert_eq odd.to_s, "1.2.3=#020105"
  # A multi-valued RDN joins with +.
  multi = RDNSequence.new(rdns: [RelativeDistinguishedNameSET.new(atvs: [AttributeTypeAndValue.new(type: asn1.oid([2, 5, 4, 3]), value: asn1.Any.Str("a")), AttributeTypeAndValue.new(type: asn1.oid([2, 5, 4, 11]), value: asn1.Any.Str("b"))])])
  assert_eq multi.to_s, "CN=a+OU=b"
}

test "Name round trip" {
  n = Name.new(country: ["US"], organization: ["Acme", "Widgets"], common_name: "host.example")
  der = n.to_rdn_sequence.to_asn1.unwrap
  back = RDNSequence.from_asn1(der).unwrap[0]
  p = Name.new
  p.fill_from_rdn_sequence!(back)
  assert_eq p.country, ["US"]
  assert_eq p.organization, ["Acme", "Widgets"]
  assert_eq p.common_name, "host.example"
  assert_eq p.names.size, 4
  assert_eq p.to_s, "CN=host.example,O=Acme+O=Widgets,C=US"
  # extra_names override the fields with the same OID.
  e = Name.new(organization: ["Ignored"], extra_names: [AttributeTypeAndValue.new(type: asn1.oid([2, 5, 4, 10]), value: asn1.Any.Str("Extra"))])
  assert_eq e.to_s, "O=Extra"
}

test "Extension and AlgorithmIdentifier" {
  ext = Extension.new(id: asn1.oid([2, 5, 29, 19]), critical: true, value: [0x30.as_u8, 0])
  der = ext.to_asn1.unwrap
  assert_eq hex.encode_to_string(der), "300c0603551d130101ff04023000"
  assert_eq Extension.from_asn1(der).unwrap[0], ext
  # critical false is omitted (optional, zero).
  assert_eq hex.encode_to_string(Extension.new(id: asn1.oid([2, 5, 29, 19]), value: []).to_asn1.unwrap), "30070603551d130400"
  ai = AlgorithmIdentifier.new(algorithm: asn1.oid([1, 2, 840, 113549, 1, 1, 11]), parameters: asn1.null_raw_value())
  assert_eq hex.encode_to_string(ai.to_asn1.unwrap), "300d06092a864886f70d01010b0500"
  assert_eq hex.encode_to_string(AlgorithmIdentifier.new(algorithm: asn1.oid([1, 3, 101, 112])).to_asn1.unwrap), "300506032b6570"
}

test "RevokedCertificate" {
  rc = RevokedCertificate.new(serial_number: big.new_int(4660), revocation_time: time.date(2020, 1, 2, 3, 4, 5, 0, time.utc()))
  der = rc.to_asn1.unwrap
  assert_eq hex.encode_to_string(der), "30130202123417" + "0d3230303130323033303430355a"
  back = RevokedCertificate.from_asn1(der).unwrap[0]
  assert_eq back.serial_number, big.new_int(4660)
  assert back.revocation_time == rc.revocation_time
}
