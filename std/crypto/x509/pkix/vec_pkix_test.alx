# Generated from Go's crypto/x509/pkix (go1.27.1, .scratch/pkixgen); do not edit by hand.

import "encoding/asn1"
import "encoding/hex"

def vh(b: [Byte]) -> Str { hex.encode_to_string(b) }
def vx(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

test "names 1" {
  n0 = Name.new(country: ["#hash", "quote\"d"], organization: [], organizational_unit: ["#hash", "a,b"], locality: ["back\\slash"], province: [], street_address: ["mid#dle", "<tag>"], postal_code: ["Example Co", "mid#dle"], serial_number: "a,b", common_name: "Example Co", extra_names: [])
  assert_eq vh(n0.to_rdn_sequence.to_asn1.unwrap), ""
  assert_eq n0.to_s, "SERIALNUMBER=a\\,b,CN=Example Co,OU=\\#hash+OU=a\\,b,POSTALCODE=Example Co+POSTALCODE=mid#dle,STREET=mid#dle+STREET=\\<tag\\>,L=back\\\\slash,C=\\#hash+C=quote\\\"d"
  assert_eq RDNSequence.from_asn1(vx("")).unwrap[0].to_s, "SERIALNUMBER=a\\,b,CN=Example Co,OU=a\\,b+OU=\\#hash,POSTALCODE=mid#dle+POSTALCODE=Example Co,STREET=\\<tag\\>+STREET=mid#dle,L=back\\\\slash,C=\\#hash+C=quote\\\"d"
  p0 = Name.new
  p0.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("")).unwrap[0])
  assert_eq p0.to_s, "SERIALNUMBER=a\\,b,CN=Example Co,OU=a\\,b+OU=\\#hash,POSTALCODE=mid#dle+POSTALCODE=Example Co,STREET=\\<tag\\>+STREET=mid#dle,L=back\\\\slash,C=\\#hash+C=quote\\\"d"
  assert_eq p0.common_name, "Example Co"
  assert_eq p0.organization, []
  n1 = Name.new(country: ["Ünïcödé", "Acme"], organization: [], organizational_unit: ["trail ", "#hash"], locality: ["Acme"], province: ["quote\"d"], street_address: [], postal_code: ["<tag>", "Example Co"], serial_number: "trail ", common_name: "", extra_names: [AttributeTypeAndValue.new(type: asn1.oid([1, 2, 3, 5]), value: asn1.Any.Str("back\\slash"))])
  assert_eq vh(n1.to_rdn_sequence.to_asn1.unwrap), ""
  assert_eq n1.to_s, "1.2.3.5=back\\\\slash,SERIALNUMBER=trail\\ ,OU=trail\\ +OU=\\#hash,POSTALCODE=\\<tag\\>+POSTALCODE=Example Co,L=Acme,ST=quote\\\"d,C=Ünïcödé+C=Acme"
  assert_eq RDNSequence.from_asn1(vx("")).unwrap[0].to_s, "1.2.3.5=back\\\\slash,SERIALNUMBER=trail\\ ,OU=\\#hash+OU=trail\\ ,POSTALCODE=\\<tag\\>+POSTALCODE=Example Co,L=Acme,ST=quote\\\"d,C=Acme+C=Ünïcödé"
  p1 = Name.new
  p1.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("")).unwrap[0])
  assert_eq p1.to_s, "SERIALNUMBER=trail\\ ,OU=\\#hash+OU=trail\\ ,POSTALCODE=\\<tag\\>+POSTALCODE=Example Co,L=Acme,ST=quote\\\"d,C=Acme+C=Ünïcödé,1.2.3.5=back\\\\slash"
  assert_eq p1.common_name, ""
  assert_eq p1.organization, []
  n2 = Name.new(country: ["Acme"], organization: ["trail "], organizational_unit: ["日本"], locality: ["Acme", "quote\"d"], province: [], street_address: [], postal_code: ["O=Org", "quote\"d"], serial_number: "semi;colon", common_name: "plain", extra_names: [])
  assert_eq vh(n2.to_rdn_sequence.to_asn1.unwrap), ""
  assert_eq n2.to_s, "SERIALNUMBER=semi\\;colon,CN=plain,OU=日本,O=trail\\ ,POSTALCODE=O=Org+POSTALCODE=quote\\\"d,L=Acme+L=quote\\\"d,C=Acme"
  assert_eq RDNSequence.from_asn1(vx("")).unwrap[0].to_s, "SERIALNUMBER=semi\\;colon,CN=plain,OU=日本,O=trail\\ ,POSTALCODE=O=Org+POSTALCODE=quote\\\"d,L=Acme+L=quote\\\"d,C=Acme"
  p2 = Name.new
  p2.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("")).unwrap[0])
  assert_eq p2.to_s, "SERIALNUMBER=semi\\;colon,CN=plain,OU=日本,O=trail\\ ,POSTALCODE=O=Org+POSTALCODE=quote\\\"d,L=Acme+L=quote\\\"d,C=Acme"
  assert_eq p2.common_name, "plain"
  assert_eq p2.organization, ["trail "]
  n3 = Name.new(country: ["Ünïcödé", "x+y"], organization: ["quote\"d"], organizational_unit: ["plain", "Acme"], locality: ["back\\slash", "plain"], province: ["mid#dle", "Example Co"], street_address: ["semi;colon", "mid#dle"], postal_code: [], serial_number: "#hash", common_name: "back\\slash", extra_names: [])
  assert_eq vh(n3.to_rdn_sequence.to_asn1.unwrap), ""
  assert_eq n3.to_s, "SERIALNUMBER=\\#hash,CN=back\\\\slash,OU=plain+OU=Acme,O=quote\\\"d,STREET=semi\\;colon+STREET=mid#dle,L=back\\\\slash+L=plain,ST=mid#dle+ST=Example Co,C=Ünïcödé+C=x\\+y"
  assert_eq RDNSequence.from_asn1(vx("")).unwrap[0].to_s, "SERIALNUMBER=\\#hash,CN=back\\\\slash,OU=Acme+OU=plain,O=quote\\\"d,STREET=mid#dle+STREET=semi\\;colon,L=plain+L=back\\\\slash,ST=mid#dle+ST=Example Co,C=x\\+y+C=Ünïcödé"
  p3 = Name.new
  p3.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("")).unwrap[0])
  assert_eq p3.to_s, "SERIALNUMBER=\\#hash,CN=back\\\\slash,OU=Acme+OU=plain,O=quote\\\"d,STREET=mid#dle+STREET=semi\\;colon,L=plain+L=back\\\\slash,ST=mid#dle+ST=Example Co,C=x\\+y+C=Ünïcödé"
  assert_eq p3.common_name, "back\\slash"
  assert_eq p3.organization, ["quote\"d"]
  n4 = Name.new(country: ["日本"], organization: ["Ünïcödé"], organizational_unit: ["Ünïcödé", "#hash"], locality: [], province: ["Ünïcödé"], street_address: ["quote\"d"], postal_code: [], serial_number: "<tag>", common_name: "Acme", extra_names: [])
  assert_eq vh(n4.to_rdn_sequence.to_asn1.unwrap), "308192310f300d06035504060c06e697a5e69cac3114301206035504080c0bc39c6ec3af63c3b664c3a93110300e06035504090c0771756f7465226431143012060355040a0c0bc39c6ec3af63c3b664c3a93122300c060355040b0c0523686173683012060355040b0c0bc39c6ec3af63c3b664c3a9310d300b0603550403130441636d65310e300c06035504050c053c7461673e"
  assert_eq n4.to_s, "SERIALNUMBER=\\<tag\\>,CN=Acme,OU=Ünïcödé+OU=\\#hash,O=Ünïcödé,STREET=quote\\\"d,ST=Ünïcödé,C=日本"
  assert_eq RDNSequence.from_asn1(vx("308192310f300d06035504060c06e697a5e69cac3114301206035504080c0bc39c6ec3af63c3b664c3a93110300e06035504090c0771756f7465226431143012060355040a0c0bc39c6ec3af63c3b664c3a93122300c060355040b0c0523686173683012060355040b0c0bc39c6ec3af63c3b664c3a9310d300b0603550403130441636d65310e300c06035504050c053c7461673e")).unwrap[0].to_s, "SERIALNUMBER=\\<tag\\>,CN=Acme,OU=\\#hash+OU=Ünïcödé,O=Ünïcödé,STREET=quote\\\"d,ST=Ünïcödé,C=日本"
  p4 = Name.new
  p4.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("308192310f300d06035504060c06e697a5e69cac3114301206035504080c0bc39c6ec3af63c3b664c3a93110300e06035504090c0771756f7465226431143012060355040a0c0bc39c6ec3af63c3b664c3a93122300c060355040b0c0523686173683012060355040b0c0bc39c6ec3af63c3b664c3a9310d300b0603550403130441636d65310e300c06035504050c053c7461673e")).unwrap[0])
  assert_eq p4.to_s, "SERIALNUMBER=\\<tag\\>,CN=Acme,OU=\\#hash+OU=Ünïcödé,O=Ünïcödé,STREET=quote\\\"d,ST=Ünïcödé,C=日本"
  assert_eq p4.common_name, "Acme"
  assert_eq p4.organization, ["Ünïcödé"]
  n5 = Name.new(country: ["trail "], organization: [], organizational_unit: ["back\\slash", "trail "], locality: ["back\\slash", "mid#dle"], province: [], street_address: [], postal_code: ["trail "], serial_number: "x+y", common_name: "", extra_names: [])
  assert_eq vh(n5.to_rdn_sequence.to_asn1.unwrap), "3079310f300d06035504061306747261696c203123300e06035504070c076d696423646c65301106035504070c0a6261636b5c736c617368310f300d06035504111306747261696c203122300d060355040b1306747261696c203011060355040b0c0a6261636b5c736c617368310c300a06035504051303782b79"
  assert_eq n5.to_s, "SERIALNUMBER=x\\+y,OU=back\\\\slash+OU=trail\\ ,POSTALCODE=trail\\ ,L=back\\\\slash+L=mid#dle,C=trail\\ "
  assert_eq RDNSequence.from_asn1(vx("3079310f300d06035504061306747261696c203123300e06035504070c076d696423646c65301106035504070c0a6261636b5c736c617368310f300d06035504111306747261696c203122300d060355040b1306747261696c203011060355040b0c0a6261636b5c736c617368310c300a06035504051303782b79")).unwrap[0].to_s, "SERIALNUMBER=x\\+y,OU=trail\\ +OU=back\\\\slash,POSTALCODE=trail\\ ,L=mid#dle+L=back\\\\slash,C=trail\\ "
  p5 = Name.new
  p5.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("3079310f300d06035504061306747261696c203123300e06035504070c076d696423646c65301106035504070c0a6261636b5c736c617368310f300d06035504111306747261696c203122300d060355040b1306747261696c203011060355040b0c0a6261636b5c736c617368310c300a06035504051303782b79")).unwrap[0])
  assert_eq p5.to_s, "SERIALNUMBER=x\\+y,OU=trail\\ +OU=back\\\\slash,POSTALCODE=trail\\ ,L=mid#dle+L=back\\\\slash,C=trail\\ "
  assert_eq p5.common_name, ""
  assert_eq p5.organization, []
  n6 = Name.new(country: ["quote\"d"], organization: ["plain", "mid#dle"], organizational_unit: ["a,b"], locality: [], province: [" lead", "quote\"d"], street_address: ["Ünïcödé", "plain"], postal_code: [], serial_number: "semi;colon", common_name: "a,b", extra_names: [])
  assert_eq vh(n6.to_rdn_sequence.to_asn1.unwrap), ""
  assert_eq n6.to_s, "SERIALNUMBER=semi\\;colon,CN=a\\,b,OU=a\\,b,O=plain+O=mid#dle,STREET=Ünïcödé+STREET=plain,ST=\\ lead+ST=quote\\\"d,C=quote\\\"d"
  assert_eq RDNSequence.from_asn1(vx("")).unwrap[0].to_s, "SERIALNUMBER=semi\\;colon,CN=a\\,b,OU=a\\,b,O=plain+O=mid#dle,STREET=plain+STREET=Ünïcödé,ST=\\ lead+ST=quote\\\"d,C=quote\\\"d"
  p6 = Name.new
  p6.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("")).unwrap[0])
  assert_eq p6.to_s, "SERIALNUMBER=semi\\;colon,CN=a\\,b,OU=a\\,b,O=plain+O=mid#dle,STREET=plain+STREET=Ünïcödé,ST=\\ lead+ST=quote\\\"d,C=quote\\\"d"
  assert_eq p6.common_name, "a,b"
  assert_eq p6.organization, ["plain", "mid#dle"]
}

test "names 2" {
  n7 = Name.new(country: [], organization: [], organizational_unit: [" lead", "Example Co"], locality: [], province: [], street_address: ["Acme", "Acme"], postal_code: [" lead", "plain"], serial_number: "#hash", common_name: "a,b", extra_names: [AttributeTypeAndValue.new(type: asn1.oid([1, 2, 3, 26]), value: asn1.Any.Str("日本"))])
  assert_eq vh(n7.to_rdn_sequence.to_asn1.unwrap), "30818c311a300b0603550409130441636d65300b0603550409130441636d65311c300c06035504111305206c656164300c06035504111305706c61696e3121300c060355040b1305206c6561643011060355040b130a4578616d706c6520436f310c300a06035504031303612c62310e300c06035504050c052368617368310f300d06032a031a0c06e697a5e69cac"
  assert_eq n7.to_s, "1.2.3.26=日本,SERIALNUMBER=\\#hash,CN=a\\,b,OU=\\ lead+OU=Example Co,POSTALCODE=\\ lead+POSTALCODE=plain,STREET=Acme+STREET=Acme"
  assert_eq RDNSequence.from_asn1(vx("30818c311a300b0603550409130441636d65300b0603550409130441636d65311c300c06035504111305206c656164300c06035504111305706c61696e3121300c060355040b1305206c6561643011060355040b130a4578616d706c6520436f310c300a06035504031303612c62310e300c06035504050c052368617368310f300d06032a031a0c06e697a5e69cac")).unwrap[0].to_s, "1.2.3.26=日本,SERIALNUMBER=\\#hash,CN=a\\,b,OU=\\ lead+OU=Example Co,POSTALCODE=\\ lead+POSTALCODE=plain,STREET=Acme+STREET=Acme"
  p7 = Name.new
  p7.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("30818c311a300b0603550409130441636d65300b0603550409130441636d65311c300c06035504111305206c656164300c06035504111305706c61696e3121300c060355040b1305206c6561643011060355040b130a4578616d706c6520436f310c300a06035504031303612c62310e300c06035504050c052368617368310f300d06032a031a0c06e697a5e69cac")).unwrap[0])
  assert_eq p7.to_s, "SERIALNUMBER=\\#hash,CN=a\\,b,OU=\\ lead+OU=Example Co,POSTALCODE=\\ lead+POSTALCODE=plain,STREET=Acme+STREET=Acme,1.2.3.26=日本"
  assert_eq p7.common_name, "a,b"
  assert_eq p7.organization, []
  n8 = Name.new(country: [], organization: ["日本"], organizational_unit: ["O=Org", "back\\slash"], locality: [], province: [], street_address: ["a,b"], postal_code: ["O=Org"], serial_number: "Example Co", common_name: "quote\"d", extra_names: [])
  assert_eq vh(n8.to_rdn_sequence.to_asn1.unwrap), "3079310c300a06035504091303612c62310e300c060355041113054f3d4f7267310f300d060355040a0c06e697a5e69cac3121300c060355040b13054f3d4f72673011060355040b0c0a6261636b5c736c6173683110300e06035504030c0771756f74652264311330110603550405130a4578616d706c6520436f"
  assert_eq n8.to_s, "SERIALNUMBER=Example Co,CN=quote\\\"d,OU=O=Org+OU=back\\\\slash,O=日本,POSTALCODE=O=Org,STREET=a\\,b"
  assert_eq RDNSequence.from_asn1(vx("3079310c300a06035504091303612c62310e300c060355041113054f3d4f7267310f300d060355040a0c06e697a5e69cac3121300c060355040b13054f3d4f72673011060355040b0c0a6261636b5c736c6173683110300e06035504030c0771756f74652264311330110603550405130a4578616d706c6520436f")).unwrap[0].to_s, "SERIALNUMBER=Example Co,CN=quote\\\"d,OU=O=Org+OU=back\\\\slash,O=日本,POSTALCODE=O=Org,STREET=a\\,b"
  p8 = Name.new
  p8.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("3079310c300a06035504091303612c62310e300c060355041113054f3d4f7267310f300d060355040a0c06e697a5e69cac3121300c060355040b13054f3d4f72673011060355040b0c0a6261636b5c736c6173683110300e06035504030c0771756f74652264311330110603550405130a4578616d706c6520436f")).unwrap[0])
  assert_eq p8.to_s, "SERIALNUMBER=Example Co,CN=quote\\\"d,OU=O=Org+OU=back\\\\slash,O=日本,POSTALCODE=O=Org,STREET=a\\,b"
  assert_eq p8.common_name, "quote\"d"
  assert_eq p8.organization, ["日本"]
  n9 = Name.new(country: ["mid#dle"], organization: ["O=Org", "back\\slash"], organizational_unit: [], locality: [], province: ["semi;colon", "quote\"d"], street_address: [], postal_code: ["plain", "semi;colon"], serial_number: "back\\slash", common_name: "back\\slash", extra_names: [])
  assert_eq vh(n9.to_rdn_sequence.to_asn1.unwrap), ""
  assert_eq n9.to_s, "SERIALNUMBER=back\\\\slash,CN=back\\\\slash,O=O=Org+O=back\\\\slash,POSTALCODE=plain+POSTALCODE=semi\\;colon,ST=semi\\;colon+ST=quote\\\"d,C=mid#dle"
  assert_eq RDNSequence.from_asn1(vx("")).unwrap[0].to_s, "SERIALNUMBER=back\\\\slash,CN=back\\\\slash,O=O=Org+O=back\\\\slash,POSTALCODE=plain+POSTALCODE=semi\\;colon,ST=quote\\\"d+ST=semi\\;colon,C=mid#dle"
  p9 = Name.new
  p9.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("")).unwrap[0])
  assert_eq p9.to_s, "SERIALNUMBER=back\\\\slash,CN=back\\\\slash,O=O=Org+O=back\\\\slash,POSTALCODE=plain+POSTALCODE=semi\\;colon,ST=quote\\\"d+ST=semi\\;colon,C=mid#dle"
  assert_eq p9.common_name, "back\\slash"
  assert_eq p9.organization, ["O=Org", "back\\slash"]
  n10 = Name.new(country: ["quote\"d", "日本"], organization: [], organizational_unit: ["semi;colon"], locality: ["a,b"], province: ["日本"], street_address: ["日本"], postal_code: ["semi;colon"], serial_number: "back\\slash", common_name: "O=Org", extra_names: [])
  assert_eq vh(n10.to_rdn_sequence.to_asn1.unwrap), ""
  assert_eq n10.to_s, "SERIALNUMBER=back\\\\slash,CN=O=Org,OU=semi\\;colon,POSTALCODE=semi\\;colon,STREET=日本,L=a\\,b,ST=日本,C=quote\\\"d+C=日本"
  assert_eq RDNSequence.from_asn1(vx("")).unwrap[0].to_s, "SERIALNUMBER=back\\\\slash,CN=O=Org,OU=semi\\;colon,POSTALCODE=semi\\;colon,STREET=日本,L=a\\,b,ST=日本,C=日本+C=quote\\\"d"
  p10 = Name.new
  p10.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("")).unwrap[0])
  assert_eq p10.to_s, "SERIALNUMBER=back\\\\slash,CN=O=Org,OU=semi\\;colon,POSTALCODE=semi\\;colon,STREET=日本,L=a\\,b,ST=日本,C=日本+C=quote\\\"d"
  assert_eq p10.common_name, "O=Org"
  assert_eq p10.organization, []
  n11 = Name.new(country: ["plain"], organization: [" lead"], organizational_unit: [], locality: ["O=Org"], province: [], street_address: [], postal_code: ["plain"], serial_number: "trail ", common_name: "Example Co", extra_names: [])
  assert_eq vh(n11.to_rdn_sequence.to_asn1.unwrap), "3066310e300c06035504061305706c61696e310e300c060355040713054f3d4f7267310e300c06035504111305706c61696e310e300c060355040a1305206c656164311330110603550403130a4578616d706c6520436f310f300d06035504051306747261696c20"
  assert_eq n11.to_s, "SERIALNUMBER=trail\\ ,CN=Example Co,O=\\ lead,POSTALCODE=plain,L=O=Org,C=plain"
  assert_eq RDNSequence.from_asn1(vx("3066310e300c06035504061305706c61696e310e300c060355040713054f3d4f7267310e300c06035504111305706c61696e310e300c060355040a1305206c656164311330110603550403130a4578616d706c6520436f310f300d06035504051306747261696c20")).unwrap[0].to_s, "SERIALNUMBER=trail\\ ,CN=Example Co,O=\\ lead,POSTALCODE=plain,L=O=Org,C=plain"
  p11 = Name.new
  p11.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("3066310e300c06035504061305706c61696e310e300c060355040713054f3d4f7267310e300c06035504111305706c61696e310e300c060355040a1305206c656164311330110603550403130a4578616d706c6520436f310f300d06035504051306747261696c20")).unwrap[0])
  assert_eq p11.to_s, "SERIALNUMBER=trail\\ ,CN=Example Co,O=\\ lead,POSTALCODE=plain,L=O=Org,C=plain"
  assert_eq p11.common_name, "Example Co"
  assert_eq p11.organization, [" lead"]
  n12 = Name.new(country: ["mid#dle", "x+y"], organization: [], organizational_unit: [], locality: ["semi;colon", "O=Org"], province: [], street_address: ["x+y"], postal_code: ["Acme"], serial_number: "#hash", common_name: "<tag>", extra_names: [])
  assert_eq vh(n12.to_rdn_sequence.to_asn1.unwrap), "307e311c300a06035504061303782b79300e06035504060c076d696423646c653121300c060355040713054f3d4f7267301106035504070c0a73656d693b636f6c6f6e310c300a06035504091303782b79310d300b0603550411130441636d65310e300c06035504030c053c7461673e310e300c06035504050c052368617368"
  assert_eq n12.to_s, "SERIALNUMBER=\\#hash,CN=\\<tag\\>,POSTALCODE=Acme,STREET=x\\+y,L=semi\\;colon+L=O=Org,C=mid#dle+C=x\\+y"
  assert_eq RDNSequence.from_asn1(vx("307e311c300a06035504061303782b79300e06035504060c076d696423646c653121300c060355040713054f3d4f7267301106035504070c0a73656d693b636f6c6f6e310c300a06035504091303782b79310d300b0603550411130441636d65310e300c06035504030c053c7461673e310e300c06035504050c052368617368")).unwrap[0].to_s, "SERIALNUMBER=\\#hash,CN=\\<tag\\>,POSTALCODE=Acme,STREET=x\\+y,L=O=Org+L=semi\\;colon,C=x\\+y+C=mid#dle"
  p12 = Name.new
