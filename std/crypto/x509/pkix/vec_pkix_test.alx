test "names 24" {
  n161 = Name.new(country: ["Acme", "<tag>"], organization: ["O=Org"], organizational_unit: [], locality: ["quote\"d"], province: ["#hash"], street_address: [], postal_code: ["日本"], serial_number: "trail ", common_name: "O=Org", extra_names: [AttributeTypeAndValue.new(type: asn1.oid([1, 2, 3, 20]), value: asn1.Any.Str("quote\"d"))])
  assert_eq vh(n161.to_rdn_sequence.to_asn1.unwrap), ""
  assert_eq n161.to_s, "1.2.3.20=quote\\\"d,SERIALNUMBER=trail\\ ,CN=O=Org,O=O=Org,POSTALCODE=日本,L=quote\\\"d,ST=\\#hash,C=Acme+C=\\<tag\\>"
  assert_eq RDNSequence.from_asn1(vx("")).unwrap[0].to_s, "1.2.3.20=quote\\\"d,SERIALNUMBER=trail\\ ,CN=O=Org,O=O=Org,POSTALCODE=日本,L=quote\\\"d,ST=\\#hash,C=Acme+C=\\<tag\\>"
