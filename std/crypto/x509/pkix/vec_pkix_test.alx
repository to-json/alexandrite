test "names 15" {
  n98 = Name.new(country: ["日本"], organization: [" lead"], organizational_unit: ["Example Co"], locality: [], province: ["Acme", "<tag>"], street_address: ["<tag>", "x+y"], postal_code: ["Acme", "<tag>"], serial_number: " lead", common_name: "Acme", extra_names: [])
