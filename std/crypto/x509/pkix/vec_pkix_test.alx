  assert_eq p194.to_s, "SERIALNUMBER=Ünïcödé,CN=a\\,b,O=plain+O=Example Co,POSTALCODE=a\\,b,L=plain,1.2.3.36=trail\\ "
  assert_eq p194.common_name, "a,b"
  assert_eq p194.organization, ["plain", "Example Co"]
  n195 = Name.new(country: [], organization: ["Ünïcödé"], organizational_unit: ["#hash"], locality: ["Example Co", " lead"], province: [], street_address: ["a,b"], postal_code: [], serial_number: "Ünïcödé", common_name: "Ünïcödé", extra_names: [])
