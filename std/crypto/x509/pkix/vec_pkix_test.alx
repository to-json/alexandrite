  p50 = Name.new
  p50.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("3065310d300b0603550409130441636d653110300e060355040a0c076d696423646c65311f300a060355040b1303612c623011060355040b130a4578616d706c6520436f3110300e06035504030c0771756f74652264310f300d06035504050c06e697a5e69cac")).unwrap[0])
