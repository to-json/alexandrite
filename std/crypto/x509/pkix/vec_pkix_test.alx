  assert_eq n195.to_s, "SERIALNUMBER=Ünïcödé,CN=Ünïcödé,OU=\\#hash,O=Ünïcödé,STREET=a\\,b,L=Example Co+L=\\ lead"
  assert_eq RDNSequence.from_asn1(vx("3081833121300c06035504071305206c65616430110603550407130a4578616d706c6520436f310c300a06035504091303612c6231143012060355040a0c0bc39c6ec3af63c3b664c3a9310e300c060355040b0c0523686173683114301206035504030c0bc39c6ec3af63c3b664c3a93114301206035504050c0bc39c6ec3af63c3b664c3a9")).unwrap[0].to_s, "SERIALNUMBER=Ünïcödé,CN=Ünïcödé,OU=\\#hash,O=Ünïcödé,STREET=a\\,b,L=\\ lead+L=Example Co"
  p195 = Name.new
  p195.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("3081833121300c06035504071305206c65616430110603550407130a4578616d706c6520436f310c300a06035504091303612c6231143012060355040a0c0bc39c6ec3af63c3b664c3a9310e300c060355040b0c0523686173683114301206035504030c0bc39c6ec3af63c3b664c3a93114301206035504050c0bc39c6ec3af63c3b664c3a9")).unwrap[0])
  assert_eq p195.to_s, "SERIALNUMBER=Ünïcödé,CN=Ünïcödé,OU=\\#hash,O=Ünïcödé,STREET=a\\,b,L=\\ lead+L=Example Co"
  assert_eq p195.common_name, "Ünïcödé"
  assert_eq p195.organization, ["Ünïcödé"]
}

test "names 29" {
  n196 = Name.new(country: [], organization: ["x+y", "Acme"], organizational_unit: ["O=Org"], locality: ["Ünïcödé"], province: ["Ünïcödé"], street_address: ["O=Org"], postal_code: ["#hash"], serial_number: "mid#dle", common_name: "semi;colon", extra_names: [])
  assert_eq vh(n196.to_rdn_sequence.to_asn1.unwrap), ""
  assert_eq n196.to_s, "SERIALNUMBER=mid#dle,CN=semi\\;colon,OU=O=Org,O=x\\+y+O=Acme,POSTALCODE=\\#hash,STREET=O=Org,L=Ünïcödé,ST=Ünïcödé"
  assert_eq RDNSequence.from_asn1(vx("")).unwrap[0].to_s, "SERIALNUMBER=mid#dle,CN=semi\\;colon,OU=O=Org,O=x\\+y+O=Acme,POSTALCODE=\\#hash,STREET=O=Org,L=Ünïcödé,ST=Ünïcödé"
  p196 = Name.new
  p196.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("")).unwrap[0])
  assert_eq p196.to_s, "SERIALNUMBER=mid#dle,CN=semi\\;colon,OU=O=Org,O=x\\+y+O=Acme,POSTALCODE=\\#hash,STREET=O=Org,L=Ünïcödé,ST=Ünïcödé"
  assert_eq p196.common_name, "semi;colon"
  assert_eq p196.organization, ["x+y", "Acme"]
  n197 = Name.new(country: [], organization: ["O=Org"], organizational_unit: ["O=Org", " lead"], locality: [], province: ["trail ", "<tag>"], street_address: [], postal_code: ["Ünïcödé"], serial_number: "a,b", common_name: "semi;colon", extra_names: [])
  assert_eq vh(n197.to_rdn_sequence.to_asn1.unwrap), "308186311d300c06035504080c053c7461673e300d06035504081306747261696c203114301206035504110c0bc39c6ec3af63c3b664c3a9310e300c060355040a13054f3d4f7267311c300c060355040b1305206c656164300c060355040b13054f3d4f72673113301106035504030c0a73656d693b636f6c6f6e310c300a06035504051303612c62"
  assert_eq n197.to_s, "SERIALNUMBER=a\\,b,CN=semi\\;colon,OU=O=Org+OU=\\ lead,O=O=Org,POSTALCODE=Ünïcödé,ST=trail\\ +ST=\\<tag\\>"
  assert_eq RDNSequence.from_asn1(vx("308186311d300c06035504080c053c7461673e300d06035504081306747261696c203114301206035504110c0bc39c6ec3af63c3b664c3a9310e300c060355040a13054f3d4f7267311c300c060355040b1305206c656164300c060355040b13054f3d4f72673113301106035504030c0a73656d693b636f6c6f6e310c300a06035504051303612c62")).unwrap[0].to_s, "SERIALNUMBER=a\\,b,CN=semi\\;colon,OU=\\ lead+OU=O=Org,O=O=Org,POSTALCODE=Ünïcödé,ST=\\<tag\\>+ST=trail\\ "
  p197 = Name.new
  p197.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("308186311d300c06035504080c053c7461673e300d06035504081306747261696c203114301206035504110c0bc39c6ec3af63c3b664c3a9310e300c060355040a13054f3d4f7267311c300c060355040b1305206c656164300c060355040b13054f3d4f72673113301106035504030c0a73656d693b636f6c6f6e310c300a06035504051303612c62")).unwrap[0])
  assert_eq p197.to_s, "SERIALNUMBER=a\\,b,CN=semi\\;colon,OU=\\ lead+OU=O=Org,O=O=Org,POSTALCODE=Ünïcödé,ST=\\<tag\\>+ST=trail\\ "
  assert_eq p197.common_name, "semi;colon"
  assert_eq p197.organization, ["O=Org"]
  n198 = Name.new(country: [], organization: ["x+y"], organizational_unit: ["日本", "back\\slash"], locality: ["Example Co"], province: [" lead", "<tag>"], street_address: ["Acme"], postal_code: [], serial_number: "Ünïcödé", common_name: "Ünïcödé", extra_names: [])
  assert_eq vh(n198.to_rdn_sequence.to_asn1.unwrap), ""
