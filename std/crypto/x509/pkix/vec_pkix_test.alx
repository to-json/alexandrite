  assert_eq RDNSequence.from_asn1(vx("30793110300e06035504060c076d696423646c65310f300d06035504080c06e697a5e69cac3126301106035504090c0a73656d693b636f6c6f6e301106035504090c0a73656d693b636f6c6f6e310c300a060355040b1303782b79310f300d06035504031306747261696c20310d300b0603550405130441636d65")).unwrap[0].to_s, "SERIALNUMBER=Acme,CN=trail\\ ,OU=x\\+y,STREET=semi\\;colon+STREET=semi\\;colon,ST=日本,C=mid#dle"
  p238 = Name.new
  p238.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("30793110300e06035504060c076d696423646c65310f300d06035504080c06e697a5e69cac3126301106035504090c0a73656d693b636f6c6f6e301106035504090c0a73656d693b636f6c6f6e310c300a060355040b1303782b79310f300d06035504031306747261696c20310d300b0603550405130441636d65")).unwrap[0])
  assert_eq p238.to_s, "SERIALNUMBER=Acme,CN=trail\\ ,OU=x\\+y,STREET=semi\\;colon+STREET=semi\\;colon,ST=日本,C=mid#dle"
  assert_eq p238.common_name, "trail "
  assert_eq p238.organization, []
  n239 = Name.new(country: ["quote\"d"], organization: ["<tag>", "Ünïcödé"], organizational_unit: ["quote\"d", "trail "], locality: ["mid#dle"], province: [], street_address: [], postal_code: ["semi;colon", "trail "], serial_number: "#hash", common_name: " lead", extra_names: [])
  assert_eq vh(n239.to_rdn_sequence.to_asn1.unwrap), ""
  assert_eq n239.to_s, "SERIALNUMBER=\\#hash,CN=\\ lead,OU=quote\\\"d+OU=trail\\ ,O=\\<tag\\>+O=Ünïcödé,POSTALCODE=semi\\;colon+POSTALCODE=trail\\ ,L=mid#dle,C=quote\\\"d"
  assert_eq RDNSequence.from_asn1(vx("")).unwrap[0].to_s, "SERIALNUMBER=\\#hash,CN=\\ lead,OU=trail\\ +OU=quote\\\"d,O=\\<tag\\>+O=Ünïcödé,POSTALCODE=trail\\ +POSTALCODE=semi\\;colon,L=mid#dle,C=quote\\\"d"
  p239 = Name.new
  p239.fill_from_rdn_sequence!(RDNSequence.from_asn1(vx("")).unwrap[0])
  assert_eq p239.to_s, "SERIALNUMBER=\\#hash,CN=\\ lead,OU=trail\\ +OU=quote\\\"d,O=\\<tag\\>+O=Ünïcödé,POSTALCODE=trail\\ +POSTALCODE=semi\\;colon,L=mid#dle,C=quote\\\"d"
  assert_eq p239.common_name, " lead"
  assert_eq p239.organization, ["<tag>", "Ünïcödé"]
}

