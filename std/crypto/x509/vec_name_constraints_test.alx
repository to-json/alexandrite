    NameConstraintsTest.new(index: 95, name: "subdomain excluded constraints preclude outer wildcard names", roots: [ConstraintsSpec.new(bad: ["dns:foo.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.example.com"]), expected_error: "\"*.example.com\" is excluded by constraint \"foo.example.com\""),
    NameConstraintsTest.new(index: 96, name: "subdomain excluded constraints do not preclude far outer wildcard names", roots: [ConstraintsSpec.new(bad: ["dns:foo.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.com"])),
    NameConstraintsTest.new(index: 97, name: "subdomain excluded constraints preclude inner wildcard names", roots: [ConstraintsSpec.new(bad: ["dns:foo.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.foo.example.com"]), expected_error: "\"*.foo.example.com\" is excluded by constraint \"foo.example.com\""),
    NameConstraintsTest.new(index: 98, name: "subdomain excluded constraints preclude far inner wildcard names", roots: [ConstraintsSpec.new(bad: ["dns:foo.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.bar.foo.example.com"]), expected_error: "\"*.bar.foo.example.com\" is excluded by constraint \"foo.example.com\""),
    NameConstraintsTest.new(index: 99, name: "outer wildcard names are not matched by subdomain permitted constraints", roots: [ConstraintsSpec.new(ok: ["dns:foo.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.example.com"]), expected_error: "\"*.example.com\" is not permitted"),
    NameConstraintsTest.new(index: 100, name: "far outer wildcard names are not matched by subdomain permitted constraints", roots: [ConstraintsSpec.new(ok: ["dns:foo.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.com"]), expected_error: "\"*.com\" is not permitted"),
    NameConstraintsTest.new(index: 101, name: "inner wildcard names are matched by subdomain permitted constraints", roots: [ConstraintsSpec.new(ok: ["dns:foo.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.foo.example.com"])),
    NameConstraintsTest.new(index: 102, name: "far inner wildcard names are matched by subdomain permitted constraints", roots: [ConstraintsSpec.new(ok: ["dns:foo.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.bar.foo.example.com"])),
    NameConstraintsTest.new(index: 103, name: "cross include should not match", roots: [ConstraintsSpec.new(ok: ["dns:foo.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.bar.example.com"]), expected_error: "\"*.bar.example.com\" is not permitted by any constraint"),
    NameConstraintsTest.new(index: 104, name: "cross exclude should not match", roots: [ConstraintsSpec.new(bad: ["dns:foo.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.bar.example.com"])),
    NameConstraintsTest.new(index: 105, name: "subdomain exclusion blocks uppercase wildcard", roots: [ConstraintsSpec.new(bad: ["dns:sub.example.com"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.EXAMPLE.COM"]), expected_error: "\"*.EXAMPLE.COM\" is excluded by constraint \"sub.example.com\""),
    NameConstraintsTest.new(index: 106, name: "uppercase subdomain exclusion blocks lowercase wildcard", roots: [ConstraintsSpec.new(bad: ["dns:SUB.EXAMPLE.COM"])], intermediates: [[ConstraintsSpec.new()]], leaf: LeafSpec.new(sans: ["dns:*.example.com"]), expected_error: "\"*.example.com\" is excluded by constraint \"sub.example.com\""),
  ]
}

NAME_CONSTRAINTS_TEST_CHUNKS = 6
