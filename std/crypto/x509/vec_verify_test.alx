test "vec Verify 15" {
  assert_eq vt_vec_verify(vt_leaf_with_akid(), [], [vt_root_without_skid()], 1450000000, "bender.local", []), "error: x509: certificate has expired or is not yet valid: current time 2015-12-13T09:46:40Z is before 2019-02-04T23:06:52Z"
  assert_eq vt_vec_verify(vt_leaf_with_akid(), [], [vt_root_without_skid()], 1450000000, "bender.local", [ExtKeyUsage.Any]), "error: x509: certificate has expired or is not yet valid: current time 2015-12-13T09:46:40Z is before 2019-02-04T23:06:52Z"
