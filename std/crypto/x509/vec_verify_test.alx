# Generated from Go's crypto/x509 (Certificate.Verify over verify_test.go's certificates and the policy_*.pem chains; VerifyHostname over a SAN/host table; .scratch/xa/gen); do not edit by hand.

test "vec Verify 0" {
  assert_eq vt_vec_verify(vt_google_leaf(), [vt_gts_intermediate()], [vt_gts_root()], 1677615892, "", []), "chains: CN=www.google.com -> CN=GTS CA 1C3,O=Google Trust Services LLC,C=US -> CN=GTS Root R1,O=Google Trust Services LLC,C=US"
  assert_eq vt_vec_verify(vt_google_leaf(), [vt_gts_intermediate()], [vt_gts_root()], 1677615892, "", [ExtKeyUsage.Any]), "chains: CN=www.google.com -> CN=GTS CA 1C3,O=Google Trust Services LLC,C=US -> CN=GTS Root R1,O=Google Trust Services LLC,C=US"
  assert_eq vt_vec_verify(vt_google_leaf(), [vt_gts_intermediate()], [vt_gts_root()], 1677615892, "", [ExtKeyUsage.EmailProtection]), "error: x509: certificate specifies an incompatible key usage"
  assert_eq vt_vec_verify(vt_google_leaf(), [vt_gts_intermediate()], [vt_gts_root()], 1677615892, "", [ExtKeyUsage.ServerAuth, ExtKeyUsage.ClientAuth]), "chains: CN=www.google.com -> CN=GTS CA 1C3,O=Google Trust Services LLC,C=US -> CN=GTS Root R1,O=Google Trust Services LLC,C=US"
