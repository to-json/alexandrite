  assert_eq vt_vec_hostname(["EXAMPLE.com."], [], "2001:0db8:0::1"), "x509: cannot validate certificate for 2001:db8::1 because it doesn't contain any IP SANs"
  assert_eq vt_vec_hostname(["EXAMPLE.com."], [], "fe80::1%eth0"), "x509: cannot validate certificate for fe80::1 because it doesn't contain any IP SANs"
  assert_eq vt_vec_hostname(["EXAMPLE.com."], [], "10.0.0.1"), "x509: cannot validate certificate for 10.0.0.1 because it doesn't contain any IP SANs"
  assert_eq vt_vec_hostname(["EXAMPLE.com."], [], "10.0.0.2"), "x509: cannot validate certificate for 10.0.0.2 because it doesn't contain any IP SANs"
  assert_eq vt_vec_hostname(["EXAMPLE.com."], [], "::ffff:10.0.0.1"), "x509: cannot validate certificate for 10.0.0.1 because it doesn't contain any IP SANs"
  assert_eq vt_vec_hostname(["EXAMPLE.com."], [], "1.2.3"), "x509: certificate is valid for EXAMPLE.com., not 1.2.3"
  assert_eq vt_vec_hostname(["EXAMPLE.com."], [], "[example.com]"), "x509: certificate is valid for EXAMPLE.com., not [example.com]"
  assert_eq vt_vec_hostname(["EXAMPLE.com."], [], "*.example.com"), "x509: certificate is valid for EXAMPLE.com., not *.example.com"
  assert_eq vt_vec_hostname(["example.com."], [], "example.com"), "x509: certificate is valid for example.com., not example.com"
  assert_eq vt_vec_hostname(["example.com."], [], "EXAMPLE.COM"), "x509: certificate is valid for example.com., not EXAMPLE.COM"
  assert_eq vt_vec_hostname(["example.com."], [], "example.com."), "ok"
  assert_eq vt_vec_hostname(["example.com."], [], "www.example.com"), "x509: certificate is valid for example.com., not www.example.com"
  assert_eq vt_vec_hostname(["example.com."], [], "WWW.Example.Com."), "x509: certificate is valid for example.com., not WWW.Example.Com."
  assert_eq vt_vec_hostname(["example.com."], [], "a.b.example.com"), "x509: certificate is valid for example.com., not a.b.example.com"
  assert_eq vt_vec_hostname(["example.com."], [], "example.org"), "x509: certificate is valid for example.com., not example.org"
  assert_eq vt_vec_hostname(["example.com."], [], "com"), "x509: certificate is valid for example.com., not com"
  assert_eq vt_vec_hostname(["example.com."], [], "label"), "x509: certificate is valid for example.com., not label"
  assert_eq vt_vec_hostname(["example.com."], [], ""), "x509: certificate is valid for example.com., not "
  assert_eq vt_vec_hostname(["example.com."], [], "."), "x509: certificate is valid for example.com., not ."
  assert_eq vt_vec_hostname(["example.com."], [], ".."), "x509: certificate is valid for example.com., not .."
}

