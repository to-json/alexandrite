test "vec Verify 4" {
  assert_eq vt_vec_verify(vt_smime_leaf(), [vt_smime_intermediate()], [vt_smime_root()], 1594673418, "1.2.3.4", []), "error: x509: cannot validate certificate for 1.2.3.4 because it doesn't contain any IP SANs"
  assert_eq vt_vec_verify(vt_smime_leaf(), [vt_smime_intermediate()], [vt_smime_root()], 1594673418, "1.2.3.4", [ExtKeyUsage.Any]), "error: x509: cannot validate certificate for 1.2.3.4 because it doesn't contain any IP SANs"
  assert_eq vt_vec_verify(vt_smime_leaf(), [vt_smime_intermediate()], [vt_smime_root()], 1594673418, "1.2.3.4", [ExtKeyUsage.EmailProtection]), "error: x509: cannot validate certificate for 1.2.3.4 because it doesn't contain any IP SANs"
