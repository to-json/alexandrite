test "vec Verify 1" {
  assert_eq vt_vec_verify(vt_google_leaf(), [], [vt_gts_root()], 1677615892, "www.google.com", []), "error: x509: certificate signed by unknown authority"
  assert_eq vt_vec_verify(vt_google_leaf(), [], [vt_gts_root()], 1677615892, "www.google.com", [ExtKeyUsage.Any]), "error: x509: certificate signed by unknown authority"
  assert_eq vt_vec_verify(vt_google_leaf(), [], [vt_gts_root()], 1677615892, "www.google.com", [ExtKeyUsage.EmailProtection]), "error: x509: certificate signed by unknown authority"
  assert_eq vt_vec_verify(vt_google_leaf(), [], [vt_gts_root()], 1677615892, "www.google.com", [ExtKeyUsage.ServerAuth, ExtKeyUsage.ClientAuth]), "error: x509: certificate signed by unknown authority"
  assert_eq vt_vec_verify(vt_google_leaf(), [], [vt_gts_root()], 1677615892, "example", []), "error: x509: certificate is valid for www.google.com, not example"
  assert_eq vt_vec_verify(vt_google_leaf(), [], [vt_gts_root()], 1677615892, "example", [ExtKeyUsage.Any]), "error: x509: certificate is valid for www.google.com, not example"
