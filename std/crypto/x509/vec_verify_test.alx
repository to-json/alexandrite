test "vec Verify 20" {
  assert_eq vt_vec_verify(vt_google_leaf(), [vt_gts_intermediate()], [vt_smime_root()], 1777615892, "1.2.3.4", []), "error: x509: certificate has expired or is not yet valid: current time 2026-05-01T06:11:32Z is after 2023-03-27T08:19:18Z"
