  assert_eq vt_vec_hostname(["xn--bcher-kva.example"], [], "fe80::1%eth0"), "x509: cannot validate certificate for fe80::1 because it doesn't contain any IP SANs"
  assert_eq vt_vec_hostname(["xn--bcher-kva.example"], [], "10.0.0.1"), "x509: cannot validate certificate for 10.0.0.1 because it doesn't contain any IP SANs"
