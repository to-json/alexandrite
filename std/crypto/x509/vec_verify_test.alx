test "vec Verify 3" {
  assert_eq vt_vec_verify(vt_google_leaf_with_invalid_hash(), [vt_gts_intermediate()], [vt_gts_root()], 1677615892, "foo.example.com", []), "error: x509: certificate is valid for www.google.com, not foo.example.com"
  assert_eq vt_vec_verify(vt_google_leaf_with_invalid_hash(), [vt_gts_intermediate()], [vt_gts_root()], 1677615892, "foo.example.com", [ExtKeyUsage.Any]), "error: x509: certificate is valid for www.google.com, not foo.example.com"
  assert_eq vt_vec_verify(vt_google_leaf_with_invalid_hash(), [vt_gts_intermediate()], [vt_gts_root()], 1677615892, "foo.example.com", [ExtKeyUsage.EmailProtection]), "error: x509: certificate is valid for www.google.com, not foo.example.com"
