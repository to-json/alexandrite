  assert_eq vt_vec_hostname(["xn--bcher-kva.example"], [], "::ffff:10.0.0.1"), "x509: cannot validate certificate for 10.0.0.1 because it doesn't contain any IP SANs"
  assert_eq vt_vec_hostname(["xn--bcher-kva.example"], [], "1.2.3"), "x509: certificate is valid for xn--bcher-kva.example, not 1.2.3"
