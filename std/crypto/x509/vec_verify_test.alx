test "vec VerifyHostname 5" {
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "192.0.2.1"), "ok"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "[192.0.2.1]"), "ok"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "2001:db8::1"), "x509: certificate is valid for 192.0.2.1, not 2001:db8::1"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "[2001:db8::1]"), "x509: certificate is valid for 192.0.2.1, not 2001:db8::1"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "2001:0db8:0::1"), "x509: certificate is valid for 192.0.2.1, not 2001:db8::1"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "fe80::1%eth0"), "x509: certificate is valid for 192.0.2.1, not fe80::1"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "10.0.0.1"), "x509: certificate is valid for 192.0.2.1, not 10.0.0.1"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "10.0.0.2"), "x509: certificate is valid for 192.0.2.1, not 10.0.0.2"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "::ffff:10.0.0.1"), "x509: certificate is valid for 192.0.2.1, not 10.0.0.1"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "1.2.3"), "x509: certificate is not valid for any names, but wanted to match 1.2.3"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "[example.com]"), "x509: certificate is not valid for any names, but wanted to match [example.com]"
  assert_eq vt_vec_hostname([], ["::ffff:192.0.2.1"], "*.example.com"), "x509: certificate is not valid for any names, but wanted to match *.example.com"
}

test "vec Verify policies 0" {
  assert_eq vt_vec_policy("leaf", "intermediate", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate", 946688400, [3]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate", 946688400, [4, 5]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_any", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_any", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_any", 946688400, [3]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_any", 946688400, [4, 5]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped", 946688400, [3]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped", 946688400, [4, 5]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped_any", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped_any", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped_any", 946688400, [3]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped_any", 946688400, [4, 5]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped_oid3", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped_oid3", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped_oid3", 946688400, [3]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_mapped_oid3", 946688400, [4, 5]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_require", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_require", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_require", 946688400, [3]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf", "intermediate_require", 946688400, [4, 5]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf", "intermediate_require1", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_require1", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_require1", 946688400, [3]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf", "intermediate_require1", 946688400, [4, 5]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf", "intermediate_require2", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_require2", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_require2", 946688400, [3]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_require2", 946688400, [4, 5]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf", "intermediate_require_no_policies", 946688400, []), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf", "intermediate_require_no_policies", 946688400, [1]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf", "intermediate_require_no_policies", 946688400, [3]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf", "intermediate_require_no_policies", 946688400, [4, 5]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf_any", "intermediate", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate", 946688400, [3]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate", 946688400, [4, 5]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate_any", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate_any", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate_any", 946688400, [3]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate_any", 946688400, [4, 5]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate_mapped", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate_mapped", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate_mapped", 946688400, [3]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_any", "intermediate_mapped", 946688400, [4, 5]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
