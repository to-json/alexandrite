test "vec Verify 2" {
  assert_eq vt_vec_verify(vt_google_leaf(), [vt_gts_root(), vt_gts_intermediate()], [vt_gts_root()], 1677615892, "example", []), "error: x509: certificate is valid for www.google.com, not example"
