test "vec Verify 12" {
  assert_eq vt_vec_verify(vt_critical_ext_leaf(), [vt_critical_ext_intermediate_with_ext()], [vt_critical_ext_root()], 1386684488, "1.2.3.4", []), "error: x509: certificate has expired or is not yet valid: current time 2013-12-10T14:08:08Z is before 2015-01-01T00:00:00Z"
  assert_eq vt_vec_verify(vt_critical_ext_leaf(), [vt_critical_ext_intermediate_with_ext()], [vt_critical_ext_root()], 1386684488, "1.2.3.4", [ExtKeyUsage.Any]), "error: x509: certificate has expired or is not yet valid: current time 2013-12-10T14:08:08Z is before 2015-01-01T00:00:00Z"
  assert_eq vt_vec_verify(vt_critical_ext_leaf(), [vt_critical_ext_intermediate_with_ext()], [vt_critical_ext_root()], 1386684488, "1.2.3.4", [ExtKeyUsage.EmailProtection]), "error: x509: certificate has expired or is not yet valid: current time 2013-12-10T14:08:08Z is before 2015-01-01T00:00:00Z"
  assert_eq vt_vec_verify(vt_critical_ext_leaf(), [vt_critical_ext_intermediate_with_ext()], [vt_critical_ext_root()], 1386684488, "1.2.3.4", [ExtKeyUsage.ServerAuth, ExtKeyUsage.ClientAuth]), "error: x509: certificate has expired or is not yet valid: current time 2013-12-10T14:08:08Z is before 2015-01-01T00:00:00Z"
  assert_eq vt_vec_verify(vt_critical_ext_leaf(), [vt_critical_ext_intermediate_with_ext()], [vt_critical_ext_root()], 1386684488, "tm.cn", []), "error: x509: certificate has expired or is not yet valid: current time 2013-12-10T14:08:08Z is before 2015-01-01T00:00:00Z"
