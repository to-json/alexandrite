  assert_eq vt_vec_policy("leaf_require1", "intermediate_require", 946688400, [3]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require", 946688400, [4, 5]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require1", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require1", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require1", 946688400, [3]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require1", 946688400, [4, 5]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require2", 946688400, []), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require2", 946688400, [1]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require2", 946688400, [3]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require2", 946688400, [4, 5]), "chains: CN=www.example.com -> CN=Policy Intermediate -> CN=Policy Root"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require_no_policies", 946688400, []), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require_no_policies", 946688400, [1]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require_no_policies", 946688400, [3]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
  assert_eq vt_vec_policy("leaf_require1", "intermediate_require_no_policies", 946688400, [4, 5]), "error: x509: no valid chains built: 1 candidate chains with invalid policies"
}
