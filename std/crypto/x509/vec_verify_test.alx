test "vec Verify 19" {
  assert_eq vt_vec_verify(vt_self_signed_no_common_name_with_org_name(), [], [vt_self_signed_no_common_name_with_org_name()], 1700000000, "foo.example.com", []), "error: x509: certificate has expired or is not yet valid: current time 2023-11-14T22:13:20Z is after 2021-08-27T18:13:48Z"
