test "vec Verify 6" {
  assert_eq vt_vec_verify(vt_trust_asia_leaf(), [vt_trust_asia_sha384_intermediate()], [vt_digicert_root()], 1558051200, "udctest.ads.vt.edu", []), "error: x509: certificate is valid for *.tm.cn, tm.cn, not udctest.ads.vt.edu"
  assert_eq vt_vec_verify(vt_trust_asia_leaf(), [vt_trust_asia_sha384_intermediate()], [vt_digicert_root()], 1558051200, "udctest.ads.vt.edu", [ExtKeyUsage.Any]), "error: x509: certificate is valid for *.tm.cn, tm.cn, not udctest.ads.vt.edu"
  assert_eq vt_vec_verify(vt_trust_asia_leaf(), [vt_trust_asia_sha384_intermediate()], [vt_digicert_root()], 1558051200, "udctest.ads.vt.edu", [ExtKeyUsage.EmailProtection]), "error: x509: certificate is valid for *.tm.cn, tm.cn, not udctest.ads.vt.edu"
  assert_eq vt_vec_verify(vt_trust_asia_leaf(), [vt_trust_asia_sha384_intermediate()], [vt_digicert_root()], 1558051200, "udctest.ads.vt.edu", [ExtKeyUsage.ServerAuth, ExtKeyUsage.ClientAuth]), "error: x509: certificate is valid for *.tm.cn, tm.cn, not udctest.ads.vt.edu"
  assert_eq vt_vec_verify(vt_trust_asia_leaf(), [vt_trust_asia_sha384_intermediate()], [vt_digicert_root()], 1558051200, "bender.local", []), "error: x509: certificate is valid for *.tm.cn, tm.cn, not bender.local"
  assert_eq vt_vec_verify(vt_trust_asia_leaf(), [vt_trust_asia_sha384_intermediate()], [vt_digicert_root()], 1558051200, "bender.local", [ExtKeyUsage.Any]), "error: x509: certificate is valid for *.tm.cn, tm.cn, not bender.local"
  assert_eq vt_vec_verify(vt_trust_asia_leaf(), [vt_trust_asia_sha384_intermediate()], [vt_digicert_root()], 1558051200, "bender.local", [ExtKeyUsage.EmailProtection]), "error: x509: certificate is valid for *.tm.cn, tm.cn, not bender.local"
  assert_eq vt_vec_verify(vt_trust_asia_leaf(), [vt_trust_asia_sha384_intermediate()], [vt_digicert_root()], 1558051200, "bender.local", [ExtKeyUsage.ServerAuth, ExtKeyUsage.ClientAuth]), "error: x509: certificate is valid for *.tm.cn, tm.cn, not bender.local"
