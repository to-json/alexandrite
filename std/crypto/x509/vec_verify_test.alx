test "vec VerifyHostname 1" {
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "WWW.Example.Com."), "ok"
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "a.b.example.com"), "x509: certificate is valid for *.example.com, example.com, not a.b.example.com"
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "example.org"), "x509: certificate is valid for *.example.com, example.com, not example.org"
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "com"), "x509: certificate is valid for *.example.com, example.com, not com"
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "label"), "x509: certificate is valid for *.example.com, example.com, not label"
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], ""), "x509: certificate is valid for *.example.com, example.com, not "
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "."), "x509: certificate is valid for *.example.com, example.com, not ."
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], ".."), "x509: certificate is valid for *.example.com, example.com, not .."
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "foo.bar.example.com"), "x509: certificate is valid for *.example.com, example.com, not foo.bar.example.com"
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "foo.baz.example.com"), "x509: certificate is valid for *.example.com, example.com, not foo.baz.example.com"
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "fx.example.com"), "ok"
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "exa_mple.com"), "x509: certificate is valid for *.example.com, example.com, not exa_mple.com"
  assert_eq vt_vec_hostname(["*.example.com", "example.com"], [], "-bad.example.com"), "x509: certificate is valid for *.example.com, example.com, not -bad.example.com"
