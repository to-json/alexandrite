  assert_eq vt_vec_verify(vt_trust_asia_leaf(), [vt_trust_asia_sha384_intermediate()], [vt_digicert_root()], 1458051200, "www.google.com", [ExtKeyUsage.Any]), "error: x509: certificate has expired or is not yet valid: current time 2016-03-15T14:13:20Z is before 2019-05-17T00:00:00Z"
