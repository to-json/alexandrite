test "vec Verify 18" {
  assert_eq vt_vec_verify(vt_self_signed_with_common_name(), [], [vt_self_signed_with_common_name()], 1700000000, "example", []), "error: x509: certificate has expired or is not yet valid: current time 2023-11-14T22:13:20Z is after 2021-08-27T17:09:18Z"
  assert_eq vt_vec_verify(vt_self_signed_with_common_name(), [], [vt_self_signed_with_common_name()], 1700000000, "example", [ExtKeyUsage.Any]), "error: x509: certificate has expired or is not yet valid: current time 2023-11-14T22:13:20Z is after 2021-08-27T17:09:18Z"
