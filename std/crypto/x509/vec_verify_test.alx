  assert_eq vt_vec_verify(vt_leaf_with_akid(), [], [vt_root_without_skid()], 1450000000, "bender.local", [ExtKeyUsage.ServerAuth, ExtKeyUsage.ClientAuth]), "error: x509: certificate has expired or is not yet valid: current time 2015-12-13T09:46:40Z is before 2019-02-04T23:06:52Z"
  assert_eq vt_vec_verify(vt_leaf_with_akid(), [], [vt_root_without_skid()], 1650000000, "", []), "chains: O=Acme LLC -> O=Acme Co"
  assert_eq vt_vec_verify(vt_leaf_with_akid(), [], [vt_root_without_skid()], 1650000000, "", [ExtKeyUsage.Any]), "chains: O=Acme LLC -> O=Acme Co"
  assert_eq vt_vec_verify(vt_leaf_with_akid(), [], [vt_root_without_skid()], 1650000000, "", [ExtKeyUsage.EmailProtection]), "error: x509: certificate specifies an incompatible key usage"
  assert_eq vt_vec_verify(vt_leaf_with_akid(), [], [vt_root_without_skid()], 1650000000, "", [ExtKeyUsage.ServerAuth, ExtKeyUsage.ClientAuth]), "chains: O=Acme LLC -> O=Acme Co"
