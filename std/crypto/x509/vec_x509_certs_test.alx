  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for mail.sthonorehotelresort.com, ashchsvr.sthonorehotelresort.com, AutoDiscover.sthonorehotelresort.com, AutoDiscover.hotelresort.com, ASHCHSVR, sthonorehotelresort.com, hotelresort.com, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("mail.sthonorehotelresort.com")), ""
  assert_eq vc_err_cert(parse_certificate(ders[75])), "x509: negative serial number"
  assert_eq vc_err_cert(parse_certificate(ders[76])), "x509: certificate contains duplicate extension with OID \"1.2.3\""
  c = parse_certificate(ders[77]).unwrap
