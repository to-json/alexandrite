  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[106]).unwrap
  assert_eq vc_head(c), "v1 serial=17037633275027166996 sig=ECDSA-SHA1 pk=ECDSA"
  assert_eq c.subject.to_s, "O=Internet Widgits Pty Ltd,ST=Some-State,C=AU"
  assert_eq c.issuer.to_s, "O=Internet Widgits Pty Ltd,ST=Some-State,C=AU"
