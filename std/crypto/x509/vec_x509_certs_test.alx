  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.5.29.32.0 pol=2.5.29.32.0 iap=0 iapz=false ipm=0 ipmz=true rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.14,2.5.29.32,2.5.29.36 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), ""
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[134]).unwrap
  assert_eq vc_head(c), "v3 serial=15994519719171511020 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=test-file,O=Golang Tests,ST=Test-State,C=UK"
  assert_eq c.issuer.to_s, "CN=test-file,O=Golang Tests,ST=Test-State,C=UK"
  assert_eq vc_validity(c), "1485993128 1801353128"
  assert_eq vc_usage(c), "ku=0 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=cb4ff45bc9f041fcf6b4ee806768cf904893cef5 aki=cb4ff45bc9f041fcf6b4ee806768cf904893cef5"
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.14,2.5.29.35,2.5.29.19 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), ""
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[135]).unwrap
  assert_eq vc_head(c), "v3 serial=13770598478100206506 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=test-dir,O=Golang Tests,ST=Test-State,C=UK"
  assert_eq c.issuer.to_s, "CN=test-dir,O=Golang Tests,ST=Test-State,C=UK"
  assert_eq vc_validity(c), "1485993027 1801353027"
  assert_eq vc_usage(c), "ku=0 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=cb4ff45bc9f041fcf6b4ee806768cf904893cef5 aki=cb4ff45bc9f041fcf6b4ee806768cf904893cef5"
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.14,2.5.29.35,2.5.29.19 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), ""
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
}
