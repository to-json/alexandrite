  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=c8639b086954c298c8d9cde333b7505ef8c9019b aki=8ff04b7fa82e4524ae4d50fa639a8bdee2dd1bbc"
  assert_eq vc_aia(c), "ocsp=http://ocsp2.globalsign.com/rootr3 ca= crl=http://crl.globalsign.net/root-r3.crl"
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.5.29.32.0 pol=2.5.29.32.0 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.19!,2.5.29.32,2.5.29.14,2.5.29.31,1.3.6.1.5.5.7.1.1,2.5.29.35 unhandled="
