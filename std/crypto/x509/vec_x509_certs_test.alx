test "vec go certs 116-125" {
  ders = vc_load("testdata/vec_go_certs.pem")
  c = parse_certificate(ders[116]).unwrap
  assert_eq vc_head(c), "v3 serial=2 sig=ECDSA-SHA256 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=Policy Intermediate"
  assert_eq c.issuer.to_s, "CN=Policy Root"
  assert_eq vc_validity(c), "946684800 4102444800"
  assert_eq vc_usage(c), "ku=32 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=90d2f7fe0eeea86b088461c2c5eb3d505a806dae aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=1.2.840.113554.4.1.72585.2.1,1.2.840.113554.4.1.72585.2.2 pol=1.2.840.113554.4.1.72585.2.1,1.2.840.113554.4.1.72585.2.2 iap=0 iapz=false ipm=0 ipmz=false rep=2 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.14,2.5.29.32,2.5.29.36 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: ECDSA verification failure"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  assert_eq vc_err_cert(parse_certificate(ders[117])), "x509: invalid certificate policies"
  c = parse_certificate(ders[118]).unwrap
  assert_eq vc_head(c), "v3 serial=2 sig=ECDSA-SHA256 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=Policy Intermediate"
  assert_eq c.issuer.to_s, "CN=Policy Root"
  assert_eq vc_validity(c), "946684800 4102444800"
  assert_eq vc_usage(c), "ku=32 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=90d2f7fe0eeea86b088461c2c5eb3d505a806dae aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=true map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.14,2.5.29.36 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: ECDSA verification failure"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[119]).unwrap
  assert_eq vc_head(c), "v3 serial=3 sig=ECDSA-SHA256 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=www.example.com"
  assert_eq c.issuer.to_s, "CN=Policy Intermediate"
  assert_eq vc_validity(c), "946684800 4102444800"
  assert_eq vc_usage(c), "ku=32 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski= aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns=www.example.com email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=1.2.840.113554.4.1.72585.2.1,1.2.840.113554.4.1.72585.2.2 pol=1.2.840.113554.4.1.72585.2.1,1.2.840.113554.4.1.72585.2.2 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.17,2.5.29.32 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for www.example.com, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("www.example.com")), ""
  c = parse_certificate(ders[120]).unwrap
  assert_eq vc_head(c), "v3 serial=3 sig=ECDSA-SHA256 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=www.example.com"
  assert_eq c.issuer.to_s, "CN=Policy Intermediate"
  assert_eq vc_validity(c), "946684800 4102444800"
  assert_eq vc_usage(c), "ku=32 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski= aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns=www.example.com email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.5.29.32.0 pol=2.5.29.32.0 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.17,2.5.29.32 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for www.example.com, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("www.example.com")), ""
  assert_eq vc_err_cert(parse_certificate(ders[121])), "x509: invalid certificate policies"
  assert_eq vc_err_cert(parse_certificate(ders[122])), "x509: invalid certificate policies"
  c = parse_certificate(ders[123]).unwrap
  assert_eq vc_head(c), "v3 serial=3 sig=ECDSA-SHA256 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=www.example.com"
  assert_eq c.issuer.to_s, "CN=Policy Intermediate"
  assert_eq vc_validity(c), "946684800 4102444800"
  assert_eq vc_usage(c), "ku=32 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski= aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns=www.example.com email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.17 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for www.example.com, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("www.example.com")), ""
  c = parse_certificate(ders[124]).unwrap
  assert_eq vc_head(c), "v3 serial=3 sig=ECDSA-SHA256 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=www.example.com"
  assert_eq c.issuer.to_s, "CN=Policy Intermediate"
  assert_eq vc_validity(c), "946684800 4102444800"
  assert_eq vc_usage(c), "ku=32 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski= aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns=www.example.com email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=1.2.840.113554.4.1.72585.2.1 pol=1.2.840.113554.4.1.72585.2.1 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.17,2.5.29.32 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for www.example.com, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("www.example.com")), ""
  c = parse_certificate(ders[125]).unwrap
  assert_eq vc_head(c), "v3 serial=3 sig=ECDSA-SHA256 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=www.example.com"
  assert_eq c.issuer.to_s, "CN=Policy Intermediate"
  assert_eq vc_validity(c), "946684800 4102444800"
  assert_eq vc_usage(c), "ku=32 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski= aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns=www.example.com email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=1.2.840.113554.4.1.72585.2.2 pol=1.2.840.113554.4.1.72585.2.2 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.17,2.5.29.32 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for www.example.com, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("www.example.com")), ""
}

