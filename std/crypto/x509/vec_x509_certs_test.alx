test "vec go certs 9-15" {
  ders = vc_load("testdata/vec_go_certs.pem")
  c = parse_certificate(ders[9]).unwrap
  assert_eq vc_head(c), "v3 serial=159662320309726417404178440727 sig=SHA384-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=GTS Root R1,O=Google Trust Services LLC,C=US"
  assert_eq c.issuer.to_s, "CN=GTS Root R1,O=Google Trust Services LLC,C=US"
  assert_eq vc_validity(c), "1466553600 2097705600"
  assert_eq vc_usage(c), "ku=97 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=e4af2b26711a2b4827852f52662ceff08913713e aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.19!,2.5.29.14 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), ""
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[10]).unwrap
  assert_eq vc_head(c), "v3 serial=22729631369333306452973303470580059356 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=www.google.com"
  assert_eq c.issuer.to_s, "CN=GTS CA 1C3,O=Google Trust Services LLC,C=US"
  assert_eq vc_validity(c), "1672647559 1679905158"
  assert_eq vc_usage(c), "ku=5 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=19dba23de57fdf976ade28120a3a66d20cafc66e aki=8a747faf85cdee95cd3d9cd0e24614f371351d27"
  assert_eq vc_aia(c), "ocsp=http://ocsp.pki.goog/gts1c3 ca=http://pki.goog/repo/certs/gts1c3.der crl=http://crls.pki.goog/gts1c3/QOvJ0N1sT2A.crl"
  assert_eq vc_san(c), "dns=www.google.com email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.23.140.1.2.1,1.3.6.1.4.1.11129.2.5.3 pol=2.23.140.1.2.1,1.3.6.1.4.1.11129.2.5.3 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.14,2.5.29.35,1.3.6.1.5.5.7.1.1,2.5.29.17,2.5.29.32,2.5.29.31,1.3.6.1.4.1.11129.2.4.2 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for www.google.com, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("www.google.com")), ""
  c = parse_certificate(ders[11]).unwrap
  assert_eq vc_head(c), "v3 serial=22729631369333306452973303470580059356 sig=0 pk=RSA"
  assert_eq c.subject.to_s, "CN=www.google.com"
  assert_eq c.issuer.to_s, "CN=GTS CA 1C3,O=Google Trust Services LLC,C=US"
  assert_eq vc_validity(c), "1672647559 1679905158"
  assert_eq vc_usage(c), "ku=5 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=19dba23de57fdf976ade28120a3a66d20cafc66e aki=8a747faf85cdee95cd3d9cd0e24614f371351d27"
  assert_eq vc_aia(c), "ocsp=http://ocsp.pki.goog/gts1c3 ca=http://pki.goog/repo/certs/gts1c3.der crl=http://crls.pki.goog/gts1c3/QOvJ0N1sT2A.crl"
  assert_eq vc_san(c), "dns=www.google.com email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.23.140.1.2.1,1.3.6.1.4.1.11129.2.5.3 pol=2.23.140.1.2.1,1.3.6.1.4.1.11129.2.5.3 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.14,2.5.29.35,1.3.6.1.5.5.7.1.1,2.5.29.17,2.5.29.32,2.5.29.31,1.3.6.1.4.1.11129.2.4.2 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for www.google.com, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("www.google.com")), ""
  c = parse_certificate(ders[12]).unwrap
  assert_eq vc_head(c), "v3 serial=139241522296952490161462414930551818678 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "SERIALNUMBER=99999989Z,CN=CORPORATIVO FICTICIO ACTIVO,OU=Ziurtagiri korporatiboa-Certificado corporativo+OU=Condiciones de uso en www.izenpe.com nola erabili jakiteko,O=IZENPE,2.5.4.4=FICTICIO,2.5.4.42=CORPORATIVO,2.5.4.46=-dni 99999989Z"
  assert_eq c.issuer.to_s, "CN=EAEko Herri Administrazioen CA - CA AAPP Vascas (2),OU=AZZ Ziurtagiri publikoa - Certificado publico SCA,O=IZENPE S.A.,C=ES"
  assert_eq vc_validity(c), "1499849601 1626080001"
  assert_eq vc_usage(c), "ku=7 eku=[2 4] unk=1.3.6.1.4.1.311.20.2.2"
  assert_eq vc_bc(c), "bcv=false ca=false mpl=0 mplz=false"
  assert_eq vc_ids(c), "ski=c9ea0e0f87207258ca63426facdb97db068540b0 aki=c0a94af7472587ffbcb5a689ce82d246a889eba3"
  assert_eq vc_aia(c), "ocsp=http://ocsp.izenpe.com ca= crl=http://crl.izenpe.com/cgi-bin/crlinterna2"
  assert_eq vc_san(c), "dns= email=ficticio@izenpe.eus ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
