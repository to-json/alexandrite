  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=8ff04b7fa82e4524ae4d50fa639a8bdee2dd1bbc aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.19!,2.5.29.14 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), ""
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[19]).unwrap
  assert_eq vc_head(c), "v3 serial=10944719598952040374951832963794454346 sig=SHA1-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=DigiCert Global Root CA,OU=www.digicert.com,O=DigiCert Inc,C=US"
  assert_eq c.issuer.to_s, "CN=DigiCert Global Root CA,OU=www.digicert.com,O=DigiCert Inc,C=US"
  assert_eq vc_validity(c), "1163116800 1952035200"
  assert_eq vc_usage(c), "ku=97 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=03de503556d14cbb66f0a3e21b1bc397b23dd155 aki=03de503556d14cbb66f0a3e21b1bc397b23dd155"
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.19!,2.5.29.14,2.5.29.35 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: cannot verify signature: insecure algorithm SHA1-RSA"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[20]).unwrap
  assert_eq vc_head(c), "v3 serial=15777963373827510166403699594441911055 sig=SHA384-RSA pk=ECDSA"
  assert_eq c.subject.to_s, "CN=TrustAsia ECC OV TLS Pro CA,O=TrustAsia Technologies\\, Inc.,C=CN"
  assert_eq c.issuer.to_s, "CN=DigiCert Global Root CA,OU=www.digicert.com,O=DigiCert Inc,C=US"
  assert_eq vc_validity(c), "1524832979 1840452179"
  assert_eq vc_usage(c), "ku=97 eku=[1 2] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=0 mplz=true"
  assert_eq vc_ids(c), "ski=2dd472071e87c881fff8b3afb9ec721f9a7fdcfc aki=03de503556d14cbb66f0a3e21b1bc397b23dd155"
  assert_eq vc_aia(c), "ocsp=http://ocsp.digicert-cn.com ca= crl=http://crl.digicert-cn.com/DigiCertGlobalRootCA.crl"
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.16.840.1.114412.1.1,2.23.140.1.2.2,2.23.140.1.2.3 pol=2.16.840.1.114412.1.1,2.23.140.1.2.2,2.23.140.1.2.3 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.14,2.5.29.35,2.5.29.15!,2.5.29.37,2.5.29.19!,1.3.6.1.5.5.7.1.1,2.5.29.31,2.5.29.32 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: signature algorithm specifies an RSA public key, but have public key of type *ecdsa.PublicKey"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[21]).unwrap
  assert_eq vc_head(c), "v3 serial=6526242542230063557177643648700620760 sig=ECDSA-SHA384 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=*.tm.cn,OU=知识产权部,O=厦门叁玖叁科技有限公司,L=厦门市,ST=福建省,C=CN"
  assert_eq c.issuer.to_s, "CN=TrustAsia ECC OV TLS Pro CA,O=TrustAsia Technologies\\, Inc.,C=CN"
  assert_eq vc_validity(c), "1558051200 1595937600"
  assert_eq vc_usage(c), "ku=1 eku=[1 2] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=64f27f969d739b265bc36f0d9cae9a62706512c4 aki=2dd472071e87c881fff8b3afb9ec721f9a7fdcfc"
  assert_eq vc_aia(c), "ocsp=http://ocsp.digicert-cn.com ca=http://cacerts.digicert-cn.com/TrustAsiaECCOVTLSProCA.crt crl=http://crl.digicert-cn.com/TrustAsiaECCOVTLSProCA.crl"
  assert_eq vc_san(c), "dns=*.tm.cn,tm.cn email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.16.840.1.114412.1.1,2.23.140.1.2.2 pol=2.16.840.1.114412.1.1,2.23.140.1.2.2 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.35,2.5.29.14,2.5.29.17,2.5.29.15!,2.5.29.37,2.5.29.31,2.5.29.32,1.3.6.1.5.5.7.1.1,2.5.29.19!,1.3.6.1.4.1.11129.2.4.2 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for *.tm.cn, tm.cn, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("x.tm.cn")), ""
  c = parse_certificate(ders[22]).unwrap
  assert_eq vc_head(c), "v3 serial=230051711444226548542043914722346596601 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "O=Acme Co"
  assert_eq c.issuer.to_s, "O=Acme Co"
  assert_eq vc_validity(c), "1471624427 1503160427"
  assert_eq vc_usage(c), "ku=5 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski= aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns=foo.example email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.17 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for foo.example, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("foo.example")), ""
}

