# Generated from Go's crypto/x509 (the certificates of Go's x509 and tls tests, testdata/vec_go_certs.pem; .scratch/xc/gen/vec); do not edit by hand.

test "vec go certs 0-8" {
  ders = vc_load("testdata/vec_go_certs.pem")
  c = parse_certificate(ders[0]).unwrap
  assert_eq vc_head(c), "v3 serial=146025 sig=SHA1-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=Google Internet Authority G2,O=Google Inc,C=US"
  assert_eq c.issuer.to_s, "CN=GeoTrust Global CA,O=GeoTrust Inc.,C=US"
  assert_eq vc_validity(c), "1365174955 1428160555"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=0 mplz=true"
  assert_eq vc_ids(c), "ski=4add06161bbcf668b576f581b6bb621aba5a812f aki=c07a98688d89fbab05640c117daa7d65b8cacc4e"
  assert_eq vc_aia(c), "ocsp=http://gtglobal-ocsp.geotrust.com ca= crl=http://crl.geotrust.com/crls/gtglobal.crl"
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=1.3.6.1.4.1.11129.2.5.1 pol=1.3.6.1.4.1.11129.2.5.1 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.35,2.5.29.14,2.5.29.19!,2.5.29.15!,2.5.29.31,1.3.6.1.5.5.7.1.1,2.5.29.32 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: cannot verify signature: insecure algorithm SHA1-RSA"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[1]).unwrap
  assert_eq vc_head(c), "v3 serial=1404354960355712309 sig=SHA1-RSA pk=ECDSA"
  assert_eq c.subject.to_s, "CN=mail.google.com,O=Google Inc,L=Mountain View,ST=California,C=US"
  assert_eq c.issuer.to_s, "CN=Google Internet Authority G2,O=Google Inc,C=US"
  assert_eq vc_validity(c), "1391002063 1401321600"
  assert_eq vc_usage(c), "ku=1 eku=[1 2] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=889c6d8a602e4dfc1bf9a52d067e5460aade2af3 aki=4add06161bbcf668b576f581b6bb621aba5a812f"
  assert_eq vc_aia(c), "ocsp=http://clients1.google.com/ocsp ca=http://pki.google.com/GIAG2.crt crl=http://pki.google.com/GIAG2.crl"
  assert_eq vc_san(c), "dns=mail.google.com email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=1.3.6.1.4.1.11129.2.5.1 pol=1.3.6.1.4.1.11129.2.5.1 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.37,2.5.29.17,2.5.29.15,1.3.6.1.5.5.7.1.1,2.5.29.14,2.5.29.19!,2.5.29.35,2.5.29.32,2.5.29.31 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for mail.google.com, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("mail.google.com")), ""
  c = parse_certificate(ders[2]).unwrap
  assert_eq vc_head(c), "v3 serial=92755267400756876025975519437427891162422109922 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=Symantec Class 3 SSP Intermediate CA - G3,OU=Symantec Trust Network,O=Symantec Corporation,C=US"
  assert_eq c.issuer.to_s, "CN=Federal Bridge CA G4,OU=FPKI,O=U.S. Government,C=US"
  assert_eq vc_validity(c), "1603386259 1697994259"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=35267d5095e1a1c1bd05d5c39d7742c70c13968c aki=79f00049eb7f77c25d410265348a90239b1e076f"
  assert_eq vc_aia(c), "ocsp= ca=http://repo.fpki.gov/bridge/caCertsIssuedTofbcag4.p7c crl=http://repo.fpki.gov/bridge/fbcag4.crl"
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.16.840.1.101.3.2.1.3.3,2.16.840.1.101.3.2.1.3.12,2.16.840.1.101.3.2.1.3.14,2.16.840.1.101.3.2.1.3.15,2.16.840.1.101.3.2.1.3.18,2.16.840.1.101.3.2.1.3.19,2.16.840.1.101.3.2.1.3.20,2.16.840.1.101.3.2.1.3.37,2.16.840.1.101.3.2.1.3.38 pol=2.16.840.1.101.3.2.1.3.3,2.16.840.1.101.3.2.1.3.12,2.16.840.1.101.3.2.1.3.14,2.16.840.1.101.3.2.1.3.15,2.16.840.1.101.3.2.1.3.18,2.16.840.1.101.3.2.1.3.19,2.16.840.1.101.3.2.1.3.20,2.16.840.1.101.3.2.1.3.37,2.16.840.1.101.3.2.1.3.38 iap=0 iapz=true ipm=0 ipmz=true rep=0 repz=true map=2.16.840.1.101.3.2.1.3.3>2.16.840.1.113733.1.7.23.3.1.6,2.16.840.1.101.3.2.1.3.12>2.16.840.1.113733.1.7.23.3.1.7,2.16.840.1.101.3.2.1.3.14>2.16.840.1.113733.1.7.23.3.1.14,2.16.840.1.101.3.2.1.3.15>2.16.840.1.113733.1.7.23.3.1.15,2.16.840.1.101.3.2.1.3.18>2.16.840.1.113733.1.7.23.3.1.18,2.16.840.1.101.3.2.1.3.19>2.16.840.1.113733.1.7.23.3.1.17,2.16.840.1.101.3.2.1.3.20>2.16.840.1.113733.1.7.23.3.1.20,2.16.840.1.101.3.2.1.3.37>2.16.840.1.113733.1.7.23.3.1.8,2.16.840.1.101.3.2.1.3.38>2.16.840.1.113733.1.7.23.3.1.36"
  assert_eq vc_ext(c), "2.5.29.14,2.5.29.35,2.5.29.15!,2.5.29.19!,2.5.29.32,2.5.29.33,1.3.6.1.5.5.7.1.11,2.5.29.36,2.5.29.54,1.3.6.1.5.5.7.1.1,2.5.29.31 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "crypto/rsa: verification error"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  assert_eq vc_err_cert(parse_certificate(ders[3])), "x509: invalid basic constraints"
  assert_eq vc_err_cert(parse_certificate(ders[4])), "x509: invalid basic constraints"
  c = parse_certificate(ders[5]).unwrap
  assert_eq vc_head(c), "v3 serial=9682659728846296873 sig=ECDSA-SHA256 pk=ECDSA"
  assert_eq c.subject.to_s, "1.2.840.113554.4.1.72585.2.10=\#0101ff,1.2.840.113554.4.1.72585.2.9=\#170d3235303930323138343331375a,1.2.840.113554.4.1.72585.2.8=\#030500aabbccdd,1.2.840.113554.4.1.72585.2.7=\#060d2a864886f712040184b7090207,1.2.840.113554.4.1.72585.2.6=\#02012a,1.2.840.113554.4.1.72585.2.5=\#30020102,1.2.840.113554.4.1.72585.2.4=\\<nil\\>,1.2.840.113554.4.1.72585.2.3=\#0d050102030405,1.2.840.113554.4.1.72585.2.2=\#040c6f637465742d737472696e67,1.2.840.113554.4.1.72585.2.1=utf8-string🦊"
  assert_eq c.issuer.to_s, "CN=Test"
  assert_eq vc_validity(c), "1756838597 1759430597"
  assert_eq vc_usage(c), "ku=0 eku=[] unk="
  assert_eq vc_bc(c), "bcv=false ca=false mpl=0 mplz=false"
  assert_eq vc_ids(c), "ski= aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), " unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[6]).unwrap
  assert_eq vc_head(c), "v3 serial=87493402998870891108772069816698636114 sig=ECDSA-SHA384 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=ISRG Root X2,O=Internet Security Research Group,C=US"
  assert_eq c.issuer.to_s, "CN=ISRG Root X2,O=Internet Security Research Group,C=US"
  assert_eq vc_validity(c), "1599177600 2231510400"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=7c4296aede4b483bfa92f89e8ccf6d8ba9723795 aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.19!,2.5.29.14 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), ""
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[7]).unwrap
  assert_eq vc_head(c), "v3 serial=172886928669790476064670243504169061120 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=ISRG Root X1,O=Internet Security Research Group,C=US"
  assert_eq c.issuer.to_s, "CN=ISRG Root X1,O=Internet Security Research Group,C=US"
