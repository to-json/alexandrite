  assert_eq vc_validity(c), "1471466167 1503002167"
  assert_eq vc_usage(c), "ku=5 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski= aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns=test.example.com email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.17 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for test.example.com, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("test.example.com")), ""
  c = parse_certificate(ders[57]).unwrap
  assert_eq vc_head(c), "v3 serial=162205419194322223737075335066046766989 sig=Ed25519 pk=Ed25519"
  assert_eq c.subject.to_s, "CN=Ed25519 CRL Test CA"
  assert_eq c.issuer.to_s, "CN=Ed25519 CRL Test CA"
  assert_eq vc_validity(c), "1572398420 253402300799"
  assert_eq vc_usage(c), "ku=97 eku=[2 1 9] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=b717da16eac5ed1f184944d3d2e3a0350a819360 aki=b717da16eac5ed1f184944d3d2e3a0350a819360"
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.14,2.5.29.35 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), ""
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
}

