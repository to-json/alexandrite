  assert_eq c.subject.to_s, "CN=GlobalSign,OU=GlobalSign Root CA - R3,O=GlobalSign"
  assert_eq c.issuer.to_s, "CN=GlobalSign,OU=GlobalSign Root CA - R3,O=GlobalSign"
