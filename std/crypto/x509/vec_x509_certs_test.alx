  assert_eq vc_err_unit(c.verify_hostname("x.google.com")), ""
  assert_eq vc_err_cert(parse_certificate(ders[70])), "x509: inner and outer signature algorithm identifiers don't match"
  assert_eq vc_err_cert(parse_certificate(ders[71])), "x509: inner and outer signature algorithm identifiers don't match"
  c = parse_certificate(ders[72]).unwrap
  assert_eq vc_head(c), "v3 serial=268 sig=SHA1-RSA pk=RSA"
  assert_eq c.subject.to_s, "OU=Starfield Class 2 Certification Authority,O=Starfield Technologies\\, Inc.,C=US"
  assert_eq c.issuer.to_s, "CN=http://www.valicert.com/,OU=ValiCert Class 2 Policy Validation Authority,O=ValiCert\\, Inc.,L=ValiCert Validation Network,1.2.840.113549.1.9.1=info@valicert.com"
  assert_eq vc_validity(c), "1088530756 1719682756"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=bf5fb7d1cedd1f86f45b55acdcd710c20ea988e7 aki="
  assert_eq vc_aia(c), "ocsp=http://ocsp.starfieldtech.com ca= crl=http://certificates.starfieldtech.com/repository/root.crl"
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.5.29.32.0 pol=2.5.29.32.0 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.14,2.5.29.35,2.5.29.19!,1.3.6.1.5.5.7.1.1,2.5.29.31,2.5.29.32,2.5.29.15! unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: cannot verify signature: insecure algorithm SHA1-RSA"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[73]).unwrap
  assert_eq vc_head(c), "v3 serial=290739155725867636363170888374799015938 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "O=Acme Co"
  assert_eq c.issuer.to_s, "O=Acme Co"
  assert_eq vc_validity(c), "1640105967 1671641967"
  assert_eq vc_usage(c), "ku=5 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski= aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns=longOID.example email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=1.3.6.1.4.1.311.21.8.1492336001 pol=1.3.6.1.4.1.311.21.8.1492336001 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.17,2.5.29.32 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for longOID.example, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("longOID.example")), ""
  c = parse_certificate(ders[74]).unwrap
  assert_eq vc_head(c), "v3 serial=3237106092762365331 sig=SHA1-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=mail.sthonorehotelresort.com,OU=sthonorehotelresort,O=sthonorehotelresort,L=Indonesia,ST=jakarta,C=ID"
  assert_eq c.issuer.to_s, "CN=Microsoft Forefront TMG HTTPS Inspection Certification Authority"
  assert_eq vc_validity(c), "1390005660 1447580276"
  assert_eq vc_usage(c), "ku=5 eku=[1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=c002dd447817001d19e91b84c82777a94c7a3b5b aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
