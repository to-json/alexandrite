  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=c0a94af7472587ffbcb5a689ce82d246a889eba3 aki=1d1c650ea8f2257bb491cfe4b1b1e6bd55746c05"
  assert_eq vc_aia(c), "ocsp=http://ocsp.izenpe.com:8094 ca= crl=http://crl.izenpe.com/cgi-bin/arl2"
  assert_eq vc_san(c), "dns= email=info@izenpe.com ip= uri=http://www.izenpe.com"
