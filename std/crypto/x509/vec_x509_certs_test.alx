test "vec go certs 44-50" {
  ders = vc_load("testdata/vec_go_certs.pem")
  c = parse_certificate(ders[44]).unwrap
  assert_eq vc_head(c), "v3 serial=13665170753990374762 sig=ECDSA-SHA256 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=Intermediate,O=Org"
  assert_eq c.issuer.to_s, "CN=Root,O=Org"
  assert_eq vc_validity(c), "1420070400 1735689600"
  assert_eq vc_usage(c), "ku=32 eku=[1 2] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=8c1a68a8b576db5d577b1f8d14b206a3 aki=4037d701fb402fb81c7e5404278c5901"
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.14,2.5.29.35 unhandled="
