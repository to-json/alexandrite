  c = parse_certificate(ders[78]).unwrap
  assert_eq vc_head(c), "v3 serial=123456789012345678901234567890123456789012345678 sig=ML-DSA-65 pk=ML-DSA"
  assert_eq c.subject.to_s, "CN=LAMPS WG,O=IETF"
