  assert_eq vc_pol(c), "ids=2.5.29.32.0 pol=2.5.29.32.0 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.17,2.5.29.19!,2.5.29.15!,2.5.29.14,2.5.29.35,2.5.29.32,1.3.6.1.5.5.7.1.1,2.5.29.31 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "crypto/rsa: verification error"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[14]).unwrap
  assert_eq vc_head(c), "v3 serial=917563065490389241595536686991402621 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=Izenpe.com,O=IZENPE S.A.,C=ES"
  assert_eq c.issuer.to_s, "CN=Izenpe.com,O=IZENPE S.A.,C=ES"
  assert_eq vc_validity(c), "1197551308 2144305645"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=1d1c650ea8f2257bb491cfe4b1b1e6bd55746c05 aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email=info@izenpe.com ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.17,2.5.29.19!,2.5.29.15!,2.5.29.14 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), ""
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[15]).unwrap
  assert_eq vc_head(c), "v3 serial=119959590214702222154971037656115031366 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=udctest.ads.vt.edu,O=Virginia Polytechnic Institute and State University,L=Blacksburg,ST=Virginia,C=US"
  assert_eq c.issuer.to_s, "CN=Virginia Tech Global Qualified Server CA,OU=Global Qualified Server CA,O=Virginia Polytechnic Institute and State University,L=Blacksburg,ST=Virginia,C=US"
  assert_eq vc_validity(c), "1524771953 1575936000"
  assert_eq vc_usage(c), "ku=7 eku=[2 1] unk="
  assert_eq vc_bc(c), "bcv=true ca=false mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=b30cb5de7b4c1b817a55431bc1402a298500d96d aki=bc626027d5e3354817e94bab456ad0c8a877718c"
  assert_eq vc_aia(c), "ocsp=http://vtca.pki.vt.edu:8080/ejbca/publicweb/status/ocsp ca=http://www.pki.vt.edu/globalqualifiedserver/cacert/globalqualifiedserver_sha256.crt crl=http://www.pki.vt.edu/globalqualifiedserver/crl/cacrl.crl"
  assert_eq vc_san(c), "dns=udctest.ads.vt.edu email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=1.3.6.1.4.1.6760.5.2.2.2.1,1.3.6.1.4.1.6760.5.2.2.1.1,1.3.6.1.4.1.6760.5.2.2.3.1 pol=1.3.6.1.4.1.6760.5.2.2.2.1,1.3.6.1.4.1.6760.5.2.2.1.1,1.3.6.1.4.1.6760.5.2.2.3.1 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "1.3.6.1.5.5.7.1.1,2.5.29.14,2.5.29.19!,2.5.29.35,2.5.29.32,2.5.29.31,2.5.29.15!,2.5.29.37,2.5.29.17 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is valid for udctest.ads.vt.edu, not example.com"
  assert_eq vc_err_unit(c.verify_hostname("udctest.ads.vt.edu")), ""
}

test "vec go certs 16-22" {
  ders = vc_load("testdata/vec_go_certs.pem")
  c = parse_certificate(ders[16]).unwrap
  assert_eq vc_head(c), "v3 serial=150728634011625934636986005581 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=Virginia Tech Global Qualified Server CA,OU=Global Qualified Server CA,O=Virginia Polytechnic Institute and State University,L=Blacksburg,ST=Virginia,C=US"
  assert_eq c.issuer.to_s, "CN=Trusted Root CA SHA256 G2,OU=Trusted Root,O=GlobalSign nv-sa,C=BE"
  assert_eq vc_validity(c), "1512518400 1670284800"
  assert_eq vc_usage(c), "ku=96 eku=[1 2] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=0 mplz=true"
  assert_eq vc_ids(c), "ski=bc626027d5e3354817e94bab456ad0c8a877718c aki=c8639b086954c298c8d9cde333b7505ef8c9019b"
  assert_eq vc_aia(c), "ocsp=http://ocsp2.globalsign.com/trustrootsha2g2 ca=http://secure.globalsign.com/cacert/trustrootsha2g2.crt crl=http://crl.globalsign.com/gs/trustrootsha2g2.crl"
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns=bev.net,vcom.edu,vt.edu,vtcgit.com xdns= pip= xip=0.0.0.0/0,::/0 pem=vt.edu xem= puri= xuri="
  assert_eq vc_pol(c), "ids=1.3.6.1.4.1.4146.1.60 pol=1.3.6.1.4.1.4146.1.60 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.14,2.5.29.35,1.3.6.1.5.5.7.1.1,2.5.29.30,2.5.29.31,2.5.29.32 unhandled="
