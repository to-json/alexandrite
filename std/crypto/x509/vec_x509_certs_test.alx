  assert_eq vc_pol(c), "ids=2.23.140.1.2.2,1.3.6.1.4.1.11129.2.5.3 pol=2.23.140.1.2.2,1.3.6.1.4.1.11129.2.5.3 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.15!,2.5.29.37,2.5.29.19!,2.5.29.14,2.5.29.35,1.3.6.1.5.5.7.1.1,2.5.29.17,2.5.29.32,2.5.29.31,1.3.6.1.4.1.11129.2.4.3! unhandled=1.3.6.1.4.1.11129.2.4.3"
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
