test "vec create signed by a CA" {
  ca = parse_certificate(vc_hx("")).unwrap
  k = PrivateKey.Ed25519(ed25519.new_key_from_seed(vc_hx("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")))
  k2 = PrivateKey.Ed25519(ed25519.new_key_from_seed(vc_hx("6465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80818283")))
  kr = PrivateKey.Rsa(xc_rsa_private_key())
  t = Certificate.new(serial_number: vc_big("101"), subject: pkix.Name.new(common_name: "leaf one"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0))
  assert_eq vc_res(create_certificate(rand.reader(), t, ca, k2.public, k)), ""
  assert_eq vc_res(create_certificate(rand.reader(), t, ca, kr.public, k)), ""
  assert_eq vc_res(create_certificate(rand.reader(), t, ca, k2.public, k2)), "error: x509: provided PrivateKey doesn't match parent's PublicKey"
  t = Certificate.new(serial_number: vc_big("102"), subject: pkix.Name.new(common_name: "leaf two"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0), authority_key_id: vc_hx("010101"), dns_names: ["leaf.example"])
  assert_eq vc_res(create_certificate(rand.reader(), t, ca, k2.public, k)), ""
  assert_eq vc_res(create_certificate(rand.reader(), t, ca, kr.public, k)), ""
}

test "vec create errors" {
  k = PrivateKey.Ed25519(ed25519.new_key_from_seed(vc_hx("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")))
  kr = PrivateKey.Rsa(xc_rsa_private_key())
  t = Certificate.new(serial_number: vc_big("-5"), subject: pkix.Name.new(common_name: "negative"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0))
  assert_eq vc_res(create_certificate(rand.reader(), t, t, k.public, k)), "error: x509: serial number must be positive"
  t = Certificate.new(serial_number: vc_big("200"), subject: pkix.Name.new(common_name: "bad pathlen"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0), basic_constraints_valid: true, is_ca: true, max_path_len: -2)
  assert_eq vc_res(create_certificate(rand.reader(), t, t, k.public, k)), "error: x509: invalid MaxPathLen, must be greater or equal to -1"
  t = Certificate.new(serial_number: vc_big("201"), subject: pkix.Name.new(common_name: "leaf pathlen"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0), basic_constraints_valid: true, max_path_len: 2)
  assert_eq vc_res(create_certificate(rand.reader(), t, t, k.public, k)), "error: x509: only CAs are allowed to specify MaxPathLen"
  t = Certificate.new(serial_number: vc_big("202"), subject: pkix.Name.new(common_name: "md5"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0), signature_algorithm: SignatureAlgorithm.MD5WithRSA)
  assert_eq vc_res(create_certificate(rand.reader(), t, t, kr.public, kr)), "error: x509: signing with MD5 is not supported"
  t = Certificate.new(serial_number: vc_big("203"), subject: pkix.Name.new(common_name: "ed with rsa algo"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0), signature_algorithm: SignatureAlgorithm.SHA256WithRSA)
  assert_eq vc_res(create_certificate(rand.reader(), t, t, k.public, k)), "error: x509: requested SignatureAlgorithm does not match private key type"
  t = Certificate.new(serial_number: vc_big("204"), subject: pkix.Name.new(common_name: "rsa with pss algo"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0), signature_algorithm: SignatureAlgorithm.ECDSAWithSHA256)
  assert_eq vc_res(create_certificate(rand.reader(), t, t, kr.public, kr)), "error: x509: requested SignatureAlgorithm does not match private key type"
  t = Certificate.new(serial_number: vc_big("205"), subject: pkix.Name.new(common_name: "ia5"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0), email_addresses: ["ünïcode@example.com"])
  assert_eq vc_res(create_certificate(rand.reader(), t, t, k.public, k)), "error: x509: \"ünïcode@example.com\" cannot be encoded as an IA5String"
  t = Certificate.new(serial_number: vc_big("207"), subject: pkix.Name.new(common_name: "bad ip"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0), ip_addresses: [vc_hx("010203")])
  assert_eq vc_res(create_certificate(rand.reader(), t, t, k.public, k)), ""
  t = Certificate.new(serial_number: vc_big("208"), subject: pkix.Name.new(common_name: "bad ip range"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0), permitted_ip_ranges: [IPNet.new(ip: vc_hx("01020304"), mask: vc_hx("ffff00"))])
  assert_eq vc_res(create_certificate(rand.reader(), t, t, k.public, k)), ""
  t = Certificate.new(serial_number: vc_big("209"), subject: pkix.Name.new(common_name: "bad policy"), not_before: time.unix(1700000000, 0), not_after: time.unix(1900000000, 0), policies: [OID.new])
  assert_eq vc_res(create_certificate(rand.reader(), t, t, k.public, k)), "error: invalid policy object identifier"
}

test "vec create CSRs" {
  k = PrivateKey.Ed25519(ed25519.new_key_from_seed(vc_hx("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")))
  kr = PrivateKey.Rsa(xc_rsa_private_key())
  r = CertificateRequest.new(subject: pkix.Name.new(common_name: "csr"))
  assert_eq vc_res(create_certificate_request(rand.reader(), r, k)), "30818d3041020100300e310c300a06035504031303637372302a300506032b657003210003a107bff3ce10be1d70dd18e74bc09967e4d6309ba50d5f1ddc8664125531b8a000300506032b6570034100e64fa665cf6a63639ea696b9d347a9585b78889e4470f2e5ab71a7f8b9cc1126a00732cec5cfa36c8798a3cd2c602d62041f24de15aa2d54700e2a478bafc401"
  assert_eq vc_err_unit(parse_certificate_request(vc_hx("30818d3041020100300e310c300a06035504031303637372302a300506032b657003210003a107bff3ce10be1d70dd18e74bc09967e4d6309ba50d5f1ddc8664125531b8a000300506032b6570034100e64fa665cf6a63639ea696b9d347a9585b78889e4470f2e5ab71a7f8b9cc1126a00732cec5cfa36c8798a3cd2c602d62041f24de15aa2d54700e2a478bafc401")).unwrap.check_signature), ""
  r = CertificateRequest.new(subject: pkix.Name.new(common_name: "csr"))
  assert_eq vc_res(create_certificate_request(rand.reader(), r, kr)), ""
  assert_eq vc_err_unit(parse_certificate_request(vc_hx("")).unwrap.check_signature), ""
  r = CertificateRequest.new(subject: pkix.Name.new(organization: ["O"], common_name: "csr sans"), dns_names: ["a.example", "b.example"], email_addresses: ["x@example.com"], ip_addresses: [vc_hx("00000000000000000000ffff7f000001"), vc_hx("00000000000000000000000000000001")], uris: [url.parse("https://example.com/").unwrap])
  assert_eq vc_res(create_certificate_request(rand.reader(), r, k)), ""
  assert_eq vc_err_unit(parse_certificate_request(vc_hx("")).unwrap.check_signature), ""
  r = CertificateRequest.new(subject: pkix.Name.new(organization: ["O"], common_name: "csr sans"), dns_names: ["a.example", "b.example"], email_addresses: ["x@example.com"], ip_addresses: [vc_hx("00000000000000000000ffff7f000001"), vc_hx("00000000000000000000000000000001")], uris: [url.parse("https://example.com/").unwrap])
  assert_eq vc_res(create_certificate_request(rand.reader(), r, kr)), ""
  assert_eq vc_err_unit(parse_certificate_request(vc_hx("")).unwrap.check_signature), ""
  r = CertificateRequest.new(subject: pkix.Name.new(common_name: "csr ext"), extra_extensions: [pkix.Extension.new(id: asn1.oid([2, 5, 29, 19]), critical: true, value: vc_hx("30030101ff"))])
  assert_eq vc_res(create_certificate_request(rand.reader(), r, k)), ""
  assert_eq vc_err_unit(parse_certificate_request(vc_hx("")).unwrap.check_signature), ""
  r = CertificateRequest.new(subject: pkix.Name.new(common_name: "csr ext"), extra_extensions: [pkix.Extension.new(id: asn1.oid([2, 5, 29, 19]), critical: true, value: vc_hx("30030101ff"))])
  assert_eq vc_res(create_certificate_request(rand.reader(), r, kr)), ""
  assert_eq vc_err_unit(parse_certificate_request(vc_hx("")).unwrap.check_signature), ""
  r = CertificateRequest.new(subject: pkix.Name.new())
  assert_eq vc_res(create_certificate_request(rand.reader(), r, k)), "307f30330201003000302a300506032b657003210003a107bff3ce10be1d70dd18e74bc09967e4d6309ba50d5f1ddc8664125531b8a000300506032b6570034100fe4fa2c3fed0b7760b354290cac78914c58404ef165ef5a067414719c36c737a85a0171fe90ffc4700c6071380824cd870cf619d82fcec4a541697c2b032ba08"
  assert_eq vc_err_unit(parse_certificate_request(vc_hx("307f30330201003000302a300506032b657003210003a107bff3ce10be1d70dd18e74bc09967e4d6309ba50d5f1ddc8664125531b8a000300506032b6570034100fe4fa2c3fed0b7760b354290cac78914c58404ef165ef5a067414719c36c737a85a0171fe90ffc4700c6071380824cd870cf619d82fcec4a541697c2b032ba08")).unwrap.check_signature), ""
  r = CertificateRequest.new(subject: pkix.Name.new())
  assert_eq vc_res(create_certificate_request(rand.reader(), r, kr)), ""
  assert_eq vc_err_unit(parse_certificate_request(vc_hx("")).unwrap.check_signature), ""
}

test "vec create CRLs" {
  ca = parse_certificate(vc_hx("")).unwrap
  k = PrivateKey.Ed25519(ed25519.new_key_from_seed(vc_hx("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")))
  l = RevocationList.new(number: vc_big("1"), this_update: time.unix(1700000000, 0), next_update: time.unix(1900000000, 0))
  assert_eq vc_res(create_revocation_list(rand.reader(), l, ca, k)), ""
  pl = parse_revocation_list(vc_hx("")).unwrap
  assert_eq vc_err_unit(pl.check_signature_from(ca)), ""
  assert_eq pl.number.to_s, "1"
  assert_eq pl.revoked_certificate_entries.size, 0
  assert_eq vc_h(pl.authority_key_id), "56475aa75463474c0285df5dbf2bcab73da65135"
  assert_eq pl.issuer.to_s, "CN=Test CA"
  l = RevocationList.new(number: vc_big("1234567890123"), this_update: time.unix(1700000000, 0), next_update: time.unix(1900000000, 0), revoked_certificate_entries: [RevocationListEntry.new(serial_number: vc_big("7"), revocation_time: time.unix(1750000000, 0), reason_code: 0), RevocationListEntry.new(serial_number: vc_big("8"), revocation_time: time.unix(1750000000, 0), reason_code: 1), RevocationListEntry.new(serial_number: vc_big("9"), revocation_time: time.unix(1750000000, 0), reason_code: 4, extra_extensions: [pkix.Extension.new(id: asn1.oid([2, 5, 29, 24]), critical: false, value: vc_hx("180f32303235303130313030303030305a"))])])
  assert_eq vc_res(create_revocation_list(rand.reader(), l, ca, k)), ""
  pl = parse_revocation_list(vc_hx("")).unwrap
  assert_eq vc_err_unit(pl.check_signature_from(ca)), ""
  assert_eq pl.number.to_s, "1234567890123"
  assert_eq pl.revoked_certificate_entries.size, 3
  assert_eq pl.revoked_certificate_entries[0].reason_code, 0
  assert_eq pl.revoked_certificate_entries[0].extensions.size, 0
  assert_eq pl.revoked_certificate_entries[1].reason_code, 1
  assert_eq pl.revoked_certificate_entries[1].extensions.size, 1
  assert_eq pl.revoked_certificate_entries[2].reason_code, 4
  assert_eq pl.revoked_certificate_entries[2].extensions.size, 2
  assert_eq vc_h(pl.authority_key_id), "56475aa75463474c0285df5dbf2bcab73da65135"
  assert_eq pl.issuer.to_s, "CN=Test CA"
  l = RevocationList.new(number: vc_big("2"), this_update: time.unix(1700000000, 0), next_update: time.unix(1900000000, 0), extra_extensions: [pkix.Extension.new(id: asn1.oid([2, 5, 29, 27]), critical: true, value: vc_hx("020101"))])
  assert_eq vc_res(create_revocation_list(rand.reader(), l, ca, k)), ""
  pl = parse_revocation_list(vc_hx("")).unwrap
  assert_eq vc_err_unit(pl.check_signature_from(ca)), ""
  assert_eq pl.number.to_s, "2"
  assert_eq pl.revoked_certificate_entries.size, 0
  assert_eq vc_h(pl.authority_key_id), "56475aa75463474c0285df5dbf2bcab73da65135"
  assert_eq pl.issuer.to_s, "CN=Test CA"
  l = RevocationList.new(number: vc_big("3"), this_update: time.unix(1900000000, 0), next_update: time.unix(1700000000, 0))
  assert_eq vc_res(create_revocation_list(rand.reader(), l, ca, k)), "error: x509: template.ThisUpdate is after template.NextUpdate"
  rca = parse_certificate(vc_hx("")).unwrap
  kr = PrivateKey.Rsa(xc_rsa_private_key())
  revoked = [pkix.RevokedCertificate.new(serial_number: vc_big("1"), revocation_time: time.unix(1750000000, 0)), pkix.RevokedCertificate.new(serial_number: vc_big("42"), revocation_time: time.unix(1750000000, 0))]
  assert_eq vc_res(rca.create_crl(rand.reader(), kr, revoked, time.unix(1700000000, 0), time.unix(1900000000, 0))), ""
}
