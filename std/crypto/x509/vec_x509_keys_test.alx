  px = ""
  assert_eq vc_res(marshal_pkix_public_key(parse_pkix_public_key(vc_hx(px)).unwrap)), px
  assert_eq vc_res(marshal_pkix_public_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap.public)), px
  p8 = "3034020100300b0609608648016503040312042280202eb70b880f4d4ee63aba1979ad961396bf487664f9decb25621925f247b8b6dc"
  assert_eq vc_res(marshal_pkcs8_private_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap)), p8
  px = ""
  assert_eq vc_res(marshal_pkix_public_key(parse_pkix_public_key(vc_hx(px)).unwrap)), px
  assert_eq vc_res(marshal_pkix_public_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap.public)), px
  p8 = "3034020100300b0609608648016503040313042280204b20c645bfc1b2bdcfb08094dd58371ec2108f966325a628286cf3a33c7c4216"
  assert_eq vc_res(marshal_pkcs8_private_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap)), p8
  px = ""
  assert_eq vc_res(marshal_pkix_public_key(parse_pkix_public_key(vc_hx(px)).unwrap)), px
  assert_eq vc_res(marshal_pkix_public_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap.public)), px
}
