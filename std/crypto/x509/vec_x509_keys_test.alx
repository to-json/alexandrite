  assert_eq e.public_key.curve.nist_bits, 256
  px = "3059301306072a8648ce3d020106082a8648ce3d03010703420004066f8d24bb2eb031ecf275faf6171c0344e8e34c26923a3e943e6fd9d901817edd2a0e612eb08ce1f04c0150e8c7b6b888d2a585ee4a3ae256f6c5d5a8571d4b"
