  p8 = "302e020100300506032b657004220420a93a37b2c7913fad243fa07e6ea94d2f1bd3d67982ffb7aff5c2e1737a92e720"
  assert_eq vc_res(marshal_pkcs8_private_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap)), p8
  px = "302a300506032b6570032100ff787c0db564b5bc255d61941b9fe99e1e9c232db17924ed933195b8de262978"
  assert_eq vc_res(marshal_pkix_public_key(parse_pkix_public_key(vc_hx(px)).unwrap)), px
  assert_eq vc_res(marshal_pkix_public_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap.public)), px
  assert_eq parse_ec_private_key(vc_hx(p8)).err?.message || "", "x509: failed to parse private key (use ParsePKCS8PrivateKey instead for this key format)"
  p8 = "302e020100300506032b657004220420fa4bedf20e8d29c0d77c4cdf1f6ad59380d28c7acb9088a97bb4765244693560"
  assert_eq vc_res(marshal_pkcs8_private_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap)), p8
  px = "302a300506032b65700321006c1f6cf17a9b1efe6ac68e189dee883ad0d02273313c336cbd8be7e9078892b4"
  assert_eq vc_res(marshal_pkix_public_key(parse_pkix_public_key(vc_hx(px)).unwrap)), px
  assert_eq vc_res(marshal_pkix_public_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap.public)), px
  assert_eq parse_ec_private_key(vc_hx(p8)).err?.message || "", "x509: failed to parse private key (use ParsePKCS8PrivateKey instead for this key format)"
  p8 = "302e020100300506032b6570042204208661161a18a1af72663582b8a14695e1a54c3ce66aca77e12ec28f0d6be5ec90"
  assert_eq vc_res(marshal_pkcs8_private_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap)), p8
  px = "302a300506032b65700321000608b92ff4364ddfae9a11de732e299690008ab07c626a5aeba7d8cd243be920"
  assert_eq vc_res(marshal_pkix_public_key(parse_pkix_public_key(vc_hx(px)).unwrap)), px
  assert_eq vc_res(marshal_pkix_public_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap.public)), px
  assert_eq parse_ec_private_key(vc_hx(p8)).err?.message || "", "x509: failed to parse private key (use ParsePKCS8PrivateKey instead for this key format)"
}

