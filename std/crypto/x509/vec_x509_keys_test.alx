  assert_eq e.public_key.curve.nist_bits, 224
  px = "304e301006072a8648ce3d020106052b81040021033a0004fff0104600cf83d23ef9d2329ece4ee11396c1530a7b4e9bea560dd91d09cb19b3ca443678a96fee64761bb9b8336d32bab8fb2f57845ae5"
  assert_eq vc_res(marshal_pkix_public_key(PublicKey.Ecdsa(e.public_key))), px
  assert_eq vc_res(marshal_pkix_public_key(parse_pkix_public_key(vc_hx(px)).unwrap)), px
  p8 = "3078020100301006072a8648ce3d020106052b810400210461305f020101041c2aabf595b163415b9ac38f821491487c40817ac652fcf53db6fe3e21a13c033a0004fff0104600cf83d23ef9d2329ece4ee11396c1530a7b4e9bea560dd91d09cb19b3ca443678a96fee64761bb9b8336d32bab8fb2f57845ae5"
