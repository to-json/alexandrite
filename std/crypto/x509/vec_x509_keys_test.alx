# Generated from Go's crypto/x509 (PKCS #1, PKCS #8, SEC 1 and PKIX encodings of random keys; .scratch/xc/gen/vec); do not edit by hand.

test "rsa 0 1024" {
  d = ""
  k = parse_pkcs1_private_key(vc_hx(d)).unwrap
  assert_eq vc_h(marshal_pkcs1_private_key(k)), d
  assert_eq k.public_key.e, 65537
  assert_eq k.public_key.n.bit_len, 1024
  p1 = "30818902818100c01e11ee87bdc2323c9b73d202dd25cd1b5ea176de6c5876403362e10337888b38327ba27d72f7fc5846de31da276989e604bba3407e7f21b02d189d9365543050df7e829c29c69b7a28c844bb70c5b52633a928746c2ab748075363f524995bafed53bbb78ec6d8896212aef28e814b5b66e9a1d478a14593b53ceba9a799390203010001"
  assert_eq vc_h(marshal_pkcs1_public_key(k.public_key)), p1
  assert_eq vc_h(marshal_pkcs1_public_key(parse_pkcs1_public_key(vc_hx(p1)).unwrap)), p1
  px = ""
  assert_eq vc_res(marshal_pkix_public_key(PublicKey.Rsa(k.public_key))), px
  assert_eq vc_res(marshal_pkix_public_key(parse_pkix_public_key(vc_hx(px)).unwrap)), px
  p8 = ""
  assert_eq vc_res(marshal_pkcs8_private_key(PrivateKey.Rsa(k))), p8
  assert_eq vc_res(marshal_pkcs8_private_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap)), p8
  assert_eq parse_pkcs8_private_key(vc_hx(d)).err?.message || "", "x509: failed to parse private key (use ParsePKCS1PrivateKey instead for this key format)"
  assert_eq parse_ec_private_key(vc_hx(d)).err?.message || "", "x509: failed to parse private key (use ParsePKCS1PrivateKey instead for this key format)"
  assert_eq parse_pkcs1_private_key(vc_hx(p8)).err?.message || "", "x509: failed to parse private key (use ParsePKCS8PrivateKey instead for this key format)"
  assert_eq parse_pkix_public_key(vc_hx(p1)).err?.message || "", "x509: failed to parse public key (use ParsePKCS1PublicKey instead for this key format)"
  assert_eq parse_pkcs1_public_key(vc_hx(px)).err?.message || "", "x509: failed to parse public key (use ParsePKIXPublicKey instead for this key format)"
}

