test "ecdsa P-224" {
  d = "3068020101041c98a93e09026a314a8e3ebda99dfa246c1cd32885868fe5b7e4d1c463a00706052b81040021a13c033a00044850516c2b60fb86849e18ee99b3d5591a40b0dc952ac73008267bc86f43c68a82eb172ba24415e267b25c42262e4d583e72759a7931db91"
  e = parse_ec_private_key(vc_hx(d)).unwrap
  assert_eq vc_res(marshal_ec_private_key(e)), d
  assert_eq e.public_key.curve.nist_bits, 224
  px = "304e301006072a8648ce3d020106052b81040021033a00044850516c2b60fb86849e18ee99b3d5591a40b0dc952ac73008267bc86f43c68a82eb172ba24415e267b25c42262e4d583e72759a7931db91"
  assert_eq vc_res(marshal_pkix_public_key(PublicKey.Ecdsa(e.public_key))), px
  assert_eq vc_res(marshal_pkix_public_key(parse_pkix_public_key(vc_hx(px)).unwrap)), px
  p8 = "3078020100301006072a8648ce3d020106052b810400210461305f020101041c98a93e09026a314a8e3ebda99dfa246c1cd32885868fe5b7e4d1c463a13c033a00044850516c2b60fb86849e18ee99b3d5591a40b0dc952ac73008267bc86f43c68a82eb172ba24415e267b25c42262e4d583e72759a7931db91"
  assert_eq vc_res(marshal_pkcs8_private_key(PrivateKey.Ecdsa(e))), p8
  assert_eq vc_res(marshal_pkcs8_private_key(parse_pkcs8_private_key(vc_hx(p8)).unwrap)), p8
  assert_eq vc_res(marshal_ec_private_key(vc_pkcs8_ecdsa(vc_hx(p8)))), "3068020101041c98a93e09026a314a8e3ebda99dfa246c1cd32885868fe5b7e4d1c463a00706052b81040021a13c033a00044850516c2b60fb86849e18ee99b3d5591a40b0dc952ac73008267bc86f43c68a82eb172ba24415e267b25c42262e4d583e72759a7931db91"
  assert_eq e.ecdh.err?.message || "", "ecdsa: unsupported curve by crypto/ecdh"
  assert_eq parse_pkcs8_private_key(vc_hx(d)).err?.message || "", "x509: failed to parse private key (use ParseECPrivateKey instead for this key format)"
  assert_eq parse_pkcs1_private_key(vc_hx(d)).err?.message || "", "x509: failed to parse private key (use ParseECPrivateKey instead for this key format)"
  assert_eq parse_ec_private_key(vc_hx(p8)).err?.message || "", "x509: failed to parse private key (use ParsePKCS8PrivateKey instead for this key format)"
