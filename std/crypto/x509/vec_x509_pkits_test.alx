  assert_eq vc_pol(c), "ids=2.16.840.1.101.3.2.1.48.1,2.16.840.1.101.3.2.1.48.2 pol=2.16.840.1.101.3.2.1.48.1,2.16.840.1.101.3.2.1.48.2 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
