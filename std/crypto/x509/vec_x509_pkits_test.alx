test "vec pkits 322-328" {
  c = parse_certificate(os.read_file("testdata/nist-pkits/certs/inhibitPolicyMapping1P12subsubCACert.crt").unwrap).unwrap
  assert_eq vc_head(c), "v3 serial=2 sig=SHA256-RSA pk=RSA"
