test "vec pkits 164-170" {
  c = parse_certificate(os.read_file("testdata/nist-pkits/certs/PoliciesP1234CACert.crt").unwrap).unwrap
  assert_eq vc_head(c), "v3 serial=35 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=Policies P1234 CA,O=Test Certificates 2011,C=US"
  assert_eq c.issuer.to_s, "CN=Trust Anchor,O=Test Certificates 2011,C=US"
  assert_eq vc_validity(c), "1262334600 1924936200"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=f6fda98c262cb4cfd6d3ebd41ead926a1dbb2450 aki=e47d5fd15c9586082c05aebe75b665a7d95da866"
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.16.840.1.101.3.2.1.48.1,2.16.840.1.101.3.2.1.48.2,2.16.840.1.101.3.2.1.48.3,2.16.840.1.101.3.2.1.48.4 pol=2.16.840.1.101.3.2.1.48.1,2.16.840.1.101.3.2.1.48.2,2.16.840.1.101.3.2.1.48.3,2.16.840.1.101.3.2.1.48.4 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=true map="
  assert_eq vc_ext(c), "2.5.29.35,2.5.29.14,2.5.29.15!,2.5.29.19!,2.5.29.36,2.5.29.32 unhandled="
