test "vec pkits 86-92" {
  c = parse_certificate(os.read_file("testdata/nist-pkits/certs/InvalidSelfIssuedrequireExplicitPolicyTest7EE.crt").unwrap).unwrap
  assert_eq vc_head(c), "v3 serial=1 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=Invalid Self-Issued requireExplicitPolicy EE Certificate Test7,O=Test Certificates 2011,C=US"
  assert_eq c.issuer.to_s, "CN=requireExplicitPolicy2 subCA,O=Test Certificates 2011,C=US"
  assert_eq vc_validity(c), "1262334600 1924936200"
  assert_eq vc_usage(c), "ku=15 eku=[] unk="
  assert_eq vc_bc(c), "bcv=false ca=false mpl=0 mplz=false"
  assert_eq vc_ids(c), "ski=1769dd383cbf04423961424df789a114647d602b aki=2077fe4c308de2b3511d8fb0f71c7f1d83980e47"
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.35,2.5.29.14,2.5.29.15! unhandled="
