# Generated from Go's crypto/x509 (the NIST PKITS certificates, testdata/nist-pkits/certs; .scratch/xc/gen/vec); do not edit by hand.

test "vec pkits 0-6" {
  c = parse_certificate(os.read_file("testdata/nist-pkits/certs/AllCertificatesNoPoliciesTest2EE.crt").unwrap).unwrap
  assert_eq vc_head(c), "v3 serial=1 sig=SHA256-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=All Certificates No Policies EE Certificate Test2,O=Test Certificates 2011,C=US"
  assert_eq c.issuer.to_s, "CN=No Policies CA,O=Test Certificates 2011,C=US"
  assert_eq vc_validity(c), "1262334600 1924936200"
  assert_eq vc_usage(c), "ku=15 eku=[] unk="
  assert_eq vc_bc(c), "bcv=false ca=false mpl=0 mplz=false"
  assert_eq vc_ids(c), "ski=da4daff4be645954b1801e5887241e58eac59a7e aki=422403eda54b769c97985c74ea053a1bfc35e49c"
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.35,2.5.29.14,2.5.29.15! unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(os.read_file("testdata/nist-pkits/certs/AllCertificatesSamePoliciesTest10EE.crt").unwrap).unwrap
  assert_eq vc_head(c), "v3 serial=2 sig=SHA256-RSA pk=RSA"
