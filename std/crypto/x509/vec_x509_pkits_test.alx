test "vec pkits 7-13" {
  c = parse_certificate(os.read_file("testdata/nist-pkits/certs/BadSignedCACert.crt").unwrap).unwrap
  assert_eq vc_head(c), "v3 serial=3 sig=SHA256-RSA pk=RSA"
