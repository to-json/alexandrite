  assert_eq vc_pol(c), "ids=2.5.29.32.0 pol=2.5.29.32.0 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "1.3.6.1.5.5.7.1.1,2.5.29.14,2.5.29.19!,2.5.29.35,2.5.29.32,2.5.29.31,2.5.29.15!,2.5.29.17 unhandled="
