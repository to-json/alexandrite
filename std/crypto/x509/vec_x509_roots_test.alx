test "vec roots 15-21" {
  ders = vc_load("testdata/vec_roots.pem")
  c = parse_certificate(ders[15]).unwrap
  assert_eq vc_head(c), "v3 serial=33554617 sig=SHA1-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=Baltimore CyberTrust Root,OU=CyberTrust,O=Baltimore,C=IE"
