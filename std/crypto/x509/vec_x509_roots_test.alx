test "vec roots 127-127" {
  ders = vc_load("testdata/vec_roots.pem")
  c = parse_certificate(ders[127]).unwrap
  assert_eq vc_head(c), "v3 serial=107108908803651509692980124233745014957 sig=SHA1-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=XRamp Global Certification Authority,OU=www.xrampsecurity.com,O=XRamp Security Services Inc,C=US"
  assert_eq c.issuer.to_s, "CN=XRamp Global Certification Authority,OU=www.xrampsecurity.com,O=XRamp Security Services Inc,C=US"
  assert_eq vc_validity(c), "1099329244 2051242639"
  assert_eq vc_usage(c), "ku=97 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=c64fa23d066384099cce62e404ac8d5cb5e9b61b aki="
  assert_eq vc_aia(c), "ocsp= ca= crl=http://crl.xrampsecurity.com/XGCA.crl"
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "1.3.6.1.4.1.311.20.2,2.5.29.15,2.5.29.19!,2.5.29.14,2.5.29.31,1.3.6.1.4.1.311.21.1 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: cannot verify signature: insecure algorithm SHA1-RSA"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
}
