test "vec roots 7-14" {
  ders = vc_load("testdata/vec_roots.pem")
  c = parse_certificate(ders[7]).unwrap
  assert_eq vc_head(c), "v3 serial=7893706540734352110 sig=SHA384-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=AffirmTrust Premium,O=AffirmTrust,C=US"
  assert_eq c.issuer.to_s, "CN=AffirmTrust Premium,O=AffirmTrust,C=US"
  assert_eq vc_validity(c), "1264774236 2240575836"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=9dc067a60c22d926f545aba665521127d845ac63 aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids= pol= iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.14,2.5.29.19!,2.5.29.15! unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), ""
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[8]).unwrap
  assert_eq vc_head(c), "v3 serial=8401224907861490260 sig=ECDSA-SHA384 pk=ECDSA"
  assert_eq c.subject.to_s, "CN=AffirmTrust Premium ECC,O=AffirmTrust,C=US"
  assert_eq c.issuer.to_s, "CN=AffirmTrust Premium ECC,O=AffirmTrust,C=US"
