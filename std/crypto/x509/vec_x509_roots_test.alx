# Generated from Go's crypto/x509 (the macOS /etc/ssl/cert.pem roots, testdata/vec_roots.pem; .scratch/xc/gen/vec); do not edit by hand.

test "vec roots 0-6" {
  ders = vc_load("testdata/vec_roots.pem")
  c = parse_certificate(ders[0]).unwrap
  assert_eq vc_head(c), "v3 serial=6047274297262753887 sig=SHA1-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=Autoridad de Certificacion Firmaprofesional CIF A62634068,C=ES"
  assert_eq c.issuer.to_s, "CN=Autoridad de Certificacion Firmaprofesional CIF A62634068,C=ES"
  assert_eq vc_validity(c), "1242808695 1924936695"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=1 mplz=false"
  assert_eq vc_ids(c), "ski=65cdebab351e003e7ed574c01cb473470e1a642f aki="
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.5.29.32.0 pol=2.5.29.32.0 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.19!,2.5.29.15!,2.5.29.14,2.5.29.32 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: cannot verify signature: insecure algorithm SHA1-RSA"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[1]).unwrap
  assert_eq vc_head(c), "v3 serial=11806822484801597146 sig=SHA1-RSA pk=RSA"
  assert_eq c.subject.to_s, "SERIALNUMBER=A82743287,CN=Chambers of Commerce Root - 2008,O=AC Camerfirma S.A.,L=Madrid (see current address at www.camerfirma.com/address),C=EU"
  assert_eq c.issuer.to_s, "SERIALNUMBER=A82743287,CN=Chambers of Commerce Root - 2008,O=AC Camerfirma S.A.,L=Madrid (see current address at www.camerfirma.com/address),C=EU"
  assert_eq vc_validity(c), "1217593790 2164192190"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=12 mplz=false"
  assert_eq vc_ids(c), "ski=f924ac0fb2b5f879c0fa60881bc4d94d029e1719 aki=f924ac0fb2b5f879c0fa60881bc4d94d029e1719"
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.5.29.32.0 pol=2.5.29.32.0 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.19!,2.5.29.14,2.5.29.35,2.5.29.15!,2.5.29.32 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: cannot verify signature: insecure algorithm SHA1-RSA"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[2]).unwrap
  assert_eq vc_head(c), "v3 serial=14541511773111788494 sig=SHA1-RSA pk=RSA"
  assert_eq c.subject.to_s, "SERIALNUMBER=A82743287,CN=Global Chambersign Root - 2008,O=AC Camerfirma S.A.,L=Madrid (see current address at www.camerfirma.com/address),C=EU"
  assert_eq c.issuer.to_s, "SERIALNUMBER=A82743287,CN=Global Chambersign Root - 2008,O=AC Camerfirma S.A.,L=Madrid (see current address at www.camerfirma.com/address),C=EU"
  assert_eq vc_validity(c), "1217593900 2164192300"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=12 mplz=false"
  assert_eq vc_ids(c), "ski=b909ca9c1edbd36c3a6baeed54f15b9306352e5e aki=b909ca9c1edbd36c3a6baeed54f15b9306352e5e"
  assert_eq vc_aia(c), "ocsp= ca= crl="
  assert_eq vc_san(c), "dns= email= ip= uri="
  assert_eq vc_nc(c), "crit=false pdns= xdns= pip= xip= pem= xem= puri= xuri="
  assert_eq vc_pol(c), "ids=2.5.29.32.0 pol=2.5.29.32.0 iap=0 iapz=false ipm=0 ipmz=false rep=0 repz=false map="
  assert_eq vc_ext(c), "2.5.29.19!,2.5.29.14,2.5.29.35,2.5.29.15!,2.5.29.32 unhandled="
  assert_eq vc_pkix(c), "raw"
  assert_eq vc_err_unit(c.check_signature_from(c)), "x509: cannot verify signature: insecure algorithm SHA1-RSA"
  assert_eq vc_err_unit(c.verify_hostname("example.com")), "x509: certificate is not valid for any names, but wanted to match example.com"
  c = parse_certificate(ders[3]).unwrap
  assert_eq vc_head(c), "v3 serial=6828503384748696800 sig=SHA1-RSA pk=RSA"
  assert_eq c.subject.to_s, "CN=ACCVRAIZ1,OU=PKIACCV,O=ACCV,C=ES"
  assert_eq c.issuer.to_s, "CN=ACCVRAIZ1,OU=PKIACCV,O=ACCV,C=ES"
  assert_eq vc_validity(c), "1304588257 1924940257"
  assert_eq vc_usage(c), "ku=96 eku=[] unk="
  assert_eq vc_bc(c), "bcv=true ca=true mpl=-1 mplz=false"
  assert_eq vc_ids(c), "ski=d287b4e3df37279355f656ea81e536cc8c1e3fbd aki=d287b4e3df37279355f656ea81e536cc8c1e3fbd"
  assert_eq vc_aia(c), "ocsp=http://ocsp.accv.es ca=http://www.accv.es/fileadmin/Archivos/certificados/raizaccv1.crt crl=http://www.accv.es/fileadmin/Archivos/certificados/raizaccv1_der.crl"
  assert_eq vc_san(c), "dns= email=accv@accv.es ip= uri="
