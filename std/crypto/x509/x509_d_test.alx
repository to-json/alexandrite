test "CertificatePolicies" {
  priv = PrivateKey.Rsa(xc_rsa_private_key())
  max_u32_plus_one: U64 = 4294967296
  template = Certificate.new(serial_number: big.new_int(1), subject: pkix.Name.new(common_name: "Cert"), not_before: time.unix(1000, 0), not_after: time.unix(100000, 0), policy_identifiers: [asn1.oid([1, 2, 3])], policies: [xc_must_oid([1, 2, max_u32_plus_one])])
  expect_policies = [xc_must_oid([1, 2, max_u32_plus_one])]
  # Twice in Go: by default and with x509usepolicies=1 (the same here).
  for _i in 0...2 {
    cert_der = create_certificate(rand.reader(), template, template, priv.public, priv).unwrap
    cert = parse_certificate(cert_der).unwrap
    assert_eq cert.policies.size, expect_policies.size
    assert cert.policies[0].equal?(expect_policies[0]), "cert.Policies = #{cert.policies[0].to_s}"
  }
}

def xc_reject_critical(oid: [Int], expected_err: Str) {
  priv = PrivateKey.Rsa(xc_rsa_private_key())
  template = Certificate.new(serial_number: big.new_int(1), subject: pkix.Name.new(common_name: "Cert"), not_before: time.unix(1000, 0), not_after: time.unix(100000, 0), extra_extensions: [pkix.Extension.new(id: asn1.oid(oid), critical: true, value: [1.as_u8, 2, 3])])
  cert_der = create_certificate(rand.reader(), template, template, priv.public, priv).unwrap
  r = parse_certificate(cert_der)
  assert_eq r.err?.message || "", expected_err
}

test "RejectCriticalAKI" { xc_reject_critical([2, 5, 29, 35], "x509: authority key identifier incorrectly marked critical") }

test "RejectCriticalAIA" { xc_reject_critical([1, 3, 6, 1, 5, 5, 7, 1, 1], "x509: authority info access incorrectly marked critical") }

test "RejectCriticalSKI" { xc_reject_critical([2, 5, 29, 14], "x509: subject key identifier incorrectly marked critical") }

test "CreateCertificateNegativeMaxPathLength" {
  priv = PrivateKey.Rsa(xc_rsa_private_key())
  # create_certificate treats -1 in the same way as: max_path_len == 0 &&
  # max_path_len_zero == false.
  template = Certificate.new(serial_number: big.new_int(1), subject: pkix.Name.new(common_name: "TEST"), not_before: time.unix(1000, 0), not_after: time.unix(100000, 0), basic_constraints_valid: true, is_ca: true, max_path_len: -1)
  r = create_certificate(rand.reader(), template, template, priv.public, priv)
  assert r.ok?, "CreateCertificate() unexpected error: #{xc_err(r)}"
  template.max_path_len = -2
  r2 = create_certificate(rand.reader(), template, template, priv.public, priv)
  assert_eq xc_err(r2), "x509: invalid MaxPathLen, must be greater or equal to -1"
}

test "EKUOIDS" {
  # Go's extKeyUsageOIDs table.
  table = [
    (ExtKeyUsage.Any, [2, 5, 29, 37, 0]),
    (ExtKeyUsage.ServerAuth, [1, 3, 6, 1, 5, 5, 7, 3, 1]),
    (ExtKeyUsage.ClientAuth, [1, 3, 6, 1, 5, 5, 7, 3, 2]),
    (ExtKeyUsage.CodeSigning, [1, 3, 6, 1, 5, 5, 7, 3, 3]),
    (ExtKeyUsage.EmailProtection, [1, 3, 6, 1, 5, 5, 7, 3, 4]),
    (ExtKeyUsage.IPSECEndSystem, [1, 3, 6, 1, 5, 5, 7, 3, 5]),
    (ExtKeyUsage.IPSECTunnel, [1, 3, 6, 1, 5, 5, 7, 3, 6]),
    (ExtKeyUsage.IPSECUser, [1, 3, 6, 1, 5, 5, 7, 3, 7]),
    (ExtKeyUsage.TimeStamping, [1, 3, 6, 1, 5, 5, 7, 3, 8]),
    (ExtKeyUsage.OCSPSigning, [1, 3, 6, 1, 5, 5, 7, 3, 9]),
    (ExtKeyUsage.MicrosoftServerGatedCrypto, [1, 3, 6, 1, 4, 1, 311, 10, 3, 3]),
    (ExtKeyUsage.NetscapeServerGatedCrypto, [2, 16, 840, 1, 113730, 4, 1]),
    (ExtKeyUsage.MicrosoftCommercialCodeSigning, [1, 3, 6, 1, 4, 1, 311, 2, 1, 22]),
    (ExtKeyUsage.MicrosoftKernelCodeSigning, [1, 3, 6, 1, 4, 1, 311, 61, 1, 1])
  ]
  for eku in table {
    oid = eku[0].oid
    assert oid.equal_asn1_oid?(asn1.oid(eku[1])), "extKeyUsage #{eku[0].value}: got #{oid.to_s}"
    assert ext_key_usage_from_oid(asn1.oid(eku[1])) == eku[0], "ext_key_usage_from_oid"
  }
}

def xc_test_mldsa(private_key_pem: Str, public_key_pem: Str, cert_pem: Str) {
  priv_key = parse_pkcs8_private_key(xc_pem_der(private_key_pem)).unwrap
  mpriv = case priv_key {
    PrivateKey.MlDsa(k) => k
    _ => panic("ParsePKCS8PrivateKey returned wrong type")
  }
  assert_eq hex.encode_to_string(mpriv.bytes), "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
  got = marshal_pkcs8_private_key(priv_key).unwrap
  assert_eq got, xc_pem_der(private_key_pem)
  pub_key = parse_pkix_public_key(xc_pem_der(public_key_pem)).unwrap
  mpub = case pub_key {
    PublicKey.MlDsa(k) => k
    _ => panic("ParsePKIXPublicKey returned wrong type")
  }
  assert mpub.equal?(mpriv.public_key), "ParsePKIXPublicKey returned public key that does not match private key"
  got2 = marshal_pkix_public_key(pub_key).unwrap
  assert_eq got2, xc_pem_der(public_key_pem)
  cert = parse_certificate(xc_pem_der(cert_pem)).unwrap
  assert cert.public_key.equal?(PublicKey.MlDsa(mpriv.public_key)), "certificate public key does not match private key"
  assert_eq cert.public_key_algorithm, PublicKeyAlgorithm.MLDSA
  p = mpub.parameters
  if p == mldsa.mldsa44() {
    assert_eq cert.signature_algorithm, SignatureAlgorithm.MLDSA44
  } else if p == mldsa.mldsa65() {
    assert_eq cert.signature_algorithm, SignatureAlgorithm.MLDSA65
  } else if p == mldsa.mldsa87() {
    assert_eq cert.signature_algorithm, SignatureAlgorithm.MLDSA87
  } else {
    assert false, "unknown MLDSA parameters"
  }
  r = cert.check_signature_from(cert)
  assert r.ok?, "CheckSignatureFrom failed: #{r.err?.message || ""}"
  got3 = create_certificate(rand.reader(), cert, cert, PublicKey.MlDsa(mpriv.public_key), priv_key).unwrap
  cert2 = parse_certificate(got3).unwrap
  assert cert2.public_key.equal?(PublicKey.MlDsa(mpriv.public_key)), "cert2 public key"
  assert_eq cert2.signature_algorithm, cert.signature_algorithm
  r2 = cert2.check_signature_from(cert2)
  assert r2.ok?, "CheckSignatureFrom failed: #{r2.err?.message || ""}"
  msg = "test message".bytes
  sig = priv_key.sign(rand.reader(), msg, SignOpts.new).unwrap
  cert_params = mpub.parameters
  for tc in [(SignatureAlgorithm.MLDSA44, mldsa.mldsa44(), "ML-DSA-44"), (SignatureAlgorithm.MLDSA65, mldsa.mldsa65(), "ML-DSA-65"), (SignatureAlgorithm.MLDSA87, mldsa.mldsa87(), "ML-DSA-87")] {
    rc = cert.check_signature(tc[0], msg, sig)
    if tc[1] == cert_params {
      assert rc.ok?, "CheckSignature(#{tc[2]}): #{rc.err?.message || ""}"
    } else {
      m = rc.err?.message || ""
      assert m.include?(tc[2]), "CheckSignature(#{tc[2]}) on #{cert_params.to_s} key: got #{m}"
    }
  }
}

test "MLDSA" {
  xc_test_mldsa(xc_mldsa44_priv(), xc_mldsa44_pub(), xc_mldsa44_cert())
  xc_test_mldsa(xc_mldsa65_priv(), xc_mldsa65_pub(), xc_mldsa65_cert())
  xc_test_mldsa(xc_mldsa87_priv(), xc_mldsa87_pub(), xc_mldsa87_cert())
  r = parse_pkcs8_private_key(xc_pem_der(xc_mldsa44_priv_expanded()))
  assert (r.err?.message || "").include?("supported"), "expanded ML-DSA-44 key: #{r.err?.message || "no error"}"
  r2 = parse_pkcs8_private_key(xc_pem_der(xc_mldsa44_priv_both()))
  assert (r2.err?.message || "").include?("openssl"), "seed and expanded ML-DSA-44 key: #{r2.err?.message || "no error"}"
}

test "IPv4MappedIPsParse" {
  for tc in [("SAN", xc_ipv4_mapped_san_cert()), ("constraint", xc_ipv4_mapped_constraint_cert())] {
    der = hex.decode_string(tc[1]).unwrap
    r = parse_certificate(der)
    assert !r.ok?, "#{tc[0]}: expected error when parsing certificate containing IPv4-mapped IPv6 address"
    m = r.err?.message || ""
    assert m.include?("IPv4-mapped IPv6 address"), "#{tc[0]}: unexpected error: #{m}"
  }
}

test "IPv4MappedIPsSANCreate" {
  priv = PrivateKey.Rsa(xc_rsa_private_key())
  tmpl = Certificate.new(serial_number: big.new_int(1), not_before: time.now().add(time.hour() * -24), not_after: time.now().add(time.hour() * 24), dns_names: ["localhost"], ip_addresses: [parse_ip("::ffff:192.0.2.1").unwrap])
  der = create_certificate(rand.reader(), tmpl, tmpl, priv.public, priv).unwrap
  cert = parse_certificate(der).unwrap
  assert_eq cert.ip_addresses.size, 1
  assert_eq cert.ip_addresses[0].size, 4
}

test "IPv4MappedIPsConstraintCreate" {
  priv = PrivateKey.Rsa(xc_rsa_private_key())
  mask: [Byte] = [0xff; 16]
  mapped_network = IPNet.new(ip: parse_ip("::ffff:192.0.2.1").unwrap, mask: mask)
  tmpl = Certificate.new(serial_number: big.new_int(1), not_before: time.now().add(time.hour() * -24), not_after: time.now().add(time.hour() * 24), dns_names: ["localhost"], permitted_ip_ranges: [mapped_network])
  r = create_certificate(rand.reader(), tmpl, tmpl, priv.public, priv)
  assert !r.ok?, "unexpected success creating certificate with IPv4-mapped IPv6 address constraint"
}

bench "CreateCertificate" {
  template = Certificate.new(serial_number: big.new_int(10), dns_names: ["example.com"])
  k = PrivateKey.Ecdsa(ecdsa.generate_key(elliptic.p256(), rand.reader()).unwrap)
  create_certificate(rand.reader(), template, template, k.public, k).unwrap
}

bench "ParseCertificate" {
  parse_certificate(xc_pem_der(xc_bench_ecdsa_leaf())).unwrap
  parse_certificate(xc_pem_der(xc_bench_rsa_leaf())).unwrap
}
