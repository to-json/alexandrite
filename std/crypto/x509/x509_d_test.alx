test "DisableSHA1ForCertOnly" {
  priv = PrivateKey.Rsa(xc_rsa_private_key())
  tmpl = Certificate.new(serial_number: big.new_int(1), not_before: time.now().add(time.hour() * -1), not_after: time.now().add(time.hour()), signature_algorithm: SignatureAlgorithm.SHA1WithRSA, basic_constraints_valid: true, is_ca: true, key_usage: KEY_USAGE_CERT_SIGN | KEY_USAGE_CRL_SIGN)
  cert_der = create_certificate(rand.reader(), tmpl, tmpl, priv.public, priv).unwrap
  cert = parse_certificate(cert_der).unwrap
  r = cert.check_signature_from(cert)
  assert !r.ok?, "expected CheckSignatureFrom to fail"
  if e = r.err {
    is_insecure = case e {
      X509Error.InsecureAlgorithm(_) => true
      _ => false
    }
    assert is_insecure, "expected InsecureAlgorithmError, got #{e.message}"
  }
  crl_der = create_revocation_list(rand.reader(), RevocationList.new(signature_algorithm: SignatureAlgorithm.SHA1WithRSA, number: big.new_int(1), this_update: time.now().add(time.hour() * -1), next_update: time.now().add(time.hour())), cert, priv).unwrap
  crl = parse_revocation_list(crl_der).unwrap
  rc = crl.check_signature_from(cert)
  assert rc.ok?, "unexpected error: #{rc.err?.message || ""}"
  # This is an unrelated OCSP response, which will fail signature
  # verification but shouldn't return an InsecureAlgorithmError, since SHA1
  # should be allowed for OCSP.
  ocsp_tbs = hex.decode_string(xc_ocsp_tbs_hex()).unwrap
  r2 = cert.check_signature(SignatureAlgorithm.SHA1WithRSA, ocsp_tbs, [])
  assert_eq r2.err?.message || "", "crypto/rsa: verification error"
}

test "ParseRevocationList" {
  der_bytes = base64.std_encoding().decode_string(xc_der_crl_base64()).unwrap
  cert_list = parse_revocation_list(der_bytes).unwrap
  assert_eq cert_list.revoked_certificate_entries.size, 88
  assert_eq cert_list.revoked_certificates.size, 88
}

test "RevocationListCheckSignatureFrom" {
  good_key = ecdsa.generate_key(elliptic.p224(), rand.reader()).unwrap
  bad_key = ecdsa.generate_key(elliptic.p224(), rand.reader()).unwrap
  good_pub = PublicKey.Ecdsa(good_key.public_key)
  bad_pub = PublicKey.Ecdsa(bad_key.public_key)
  cannot_sign = "x509: invalid signature: parent certificate cannot sign this kind of certificate"
  tests = [
    ("valid", Certificate.new(version: 3, basic_constraints_valid: true, is_ca: true, public_key_algorithm: PublicKeyAlgorithm.ECDSA, public_key: good_pub), ""),
    ("valid, key usage set", Certificate.new(version: 3, basic_constraints_valid: true, is_ca: true, public_key_algorithm: PublicKeyAlgorithm.ECDSA, public_key: good_pub, key_usage: KEY_USAGE_CRL_SIGN), ""),
    ("invalid issuer, wrong key usage", Certificate.new(version: 3, basic_constraints_valid: true, is_ca: true, public_key_algorithm: PublicKeyAlgorithm.ECDSA, public_key: good_pub, key_usage: KEY_USAGE_CERT_SIGN), cannot_sign),
    ("invalid issuer, no basic constraints/ca", Certificate.new(version: 3, public_key_algorithm: PublicKeyAlgorithm.ECDSA, public_key: good_pub), cannot_sign),
    ("invalid issuer, unsupported public key type", Certificate.new(version: 3, basic_constraints_valid: true, is_ca: true, public_key_algorithm: PublicKeyAlgorithm.UnknownPublicKeyAlgorithm, public_key: good_pub), "x509: cannot verify signature: algorithm unimplemented"),
    ("wrong key", Certificate.new(version: 3, basic_constraints_valid: true, is_ca: true, public_key_algorithm: PublicKeyAlgorithm.ECDSA, public_key: bad_pub), "x509: ECDSA verification failure")
  ]
  crl_issuer = Certificate.new(basic_constraints_valid: true, is_ca: true, public_key_algorithm: PublicKeyAlgorithm.ECDSA, public_key: good_pub, key_usage: KEY_USAGE_CRL_SIGN, subject_key_id: [1.as_u8, 2, 3])
  for tc in tests {
    crl_der = create_revocation_list(rand.reader(), RevocationList.new(number: big.new_int(1)), crl_issuer, PrivateKey.Ecdsa(good_key)).unwrap
    crl = parse_revocation_list(crl_der).unwrap
    r = crl.check_signature_from(tc[1])
    assert_eq r.err?.message || "", tc[2]
  }
}

test "OmitEmptyExtensions" {
  k = PrivateKey.Ecdsa(ecdsa.generate_key(elliptic.p256(), rand.reader()).unwrap)
  tmpl = Certificate.new(serial_number: big.new_int(1), subject: pkix.Name.new(common_name: ":)"), not_after: time.now().add(time.hour()), not_before: time.now().add(time.hour() * -1))
  der = create_certificate(rand.reader(), tmpl, tmpl, k.public, k).unwrap
  empty_ext_seq: [Byte] = [0xa3, 0x02, 0x30, 0x00]
  assert !bytes.contains(der, empty_ext_seq), "DER encoding contains the an empty extensions SEQUENCE"
}

