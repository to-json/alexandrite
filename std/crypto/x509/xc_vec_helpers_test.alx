# Helpers of the generated vec_x509_*_test.alx files: each formats a group
# of a certificate's fields as one line; .scratch/xc/gen/vec/main.go
# formats Go's parsed certificate the same way.

import "crypto/ecdsa"
import "encoding/hex"
import "encoding/pem"
import "math/big"
import "os"

# The DER of every PEM block in the file.
def vc_load(path: Str) -> [[Byte]] {
  rest = os.read_file(path).unwrap
  out: [[Byte]] = []
  loop {
    b, r = pem.decode(rest)
    break if b.none?
    blk = b.unwrap
    out << blk.bytes
    rest = r
  }
  out
}

def vc_hx(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

def vc_h(b: [Byte]) -> Str { hex.encode_to_string(b) }

# A big.Int from its decimal form.
def vc_big(s: Str) -> big.Int {
  b = big.Int.new
  b.set_string!(s, 10).unwrap
  b
}

# The hex of the bytes, or "error: " and the message.
def vc_res(r: ~[Byte]) -> Str {
  if e = r.err {
    return "error: " + e.message
  }
  hex.encode_to_string(r.unwrap)
}

def vc_err_cert(r: ~Certificate) -> Str { r.err?.message || "" }

# The ECDSA key of a PKCS #8 encoding.
def vc_pkcs8_ecdsa(der: [Byte]) -> ecdsa.PrivateKey {
  case parse_pkcs8_private_key(der).unwrap {
    Ecdsa(k) => k
    _ => panic("not an ECDSA key")
  }
}

def vc_err_unit(r: ~Unit) -> Str { r.err?.message || "" }

def vc_head(c: Certificate) -> Str { "v#{c.version} serial=#{c.serial_number.to_s} sig=#{c.signature_algorithm.to_s} pk=#{c.public_key_algorithm.to_s}" }

def vc_validity(c: Certificate) -> Str { "#{c.not_before.unix} #{c.not_after.unix}" }

def vc_usage(c: Certificate) -> Str {
  ekus = c.ext_key_usage.map { it.value }.to_a
  unk = c.unknown_ext_key_usage.map { it.to_s }.to_a
  "ku=#{c.key_usage} eku=#{ekus} unk=#{unk.join(",")}"
}

def vc_bc(c: Certificate) -> Str { "bcv=#{c.basic_constraints_valid} ca=#{c.is_ca} mpl=#{c.max_path_len} mplz=#{c.max_path_len_zero}" }

def vc_ids(c: Certificate) -> Str { "ski=#{hex.encode_to_string(c.subject_key_id)} aki=#{hex.encode_to_string(c.authority_key_id)}" }

def vc_aia(c: Certificate) -> Str { "ocsp=#{c.ocsp_server.join(",")} ca=#{c.issuing_certificate_url.join(",")} crl=#{c.crl_distribution_points.join(",")}" }

def vc_san(c: Certificate) -> Str {
  ips = c.ip_addresses.map { ip_string(it) }.to_a
  uris = c.uris.map { it.to_s }.to_a
  "dns=#{c.dns_names.join(",")} email=#{c.email_addresses.join(",")} ip=#{ips.join(",")} uri=#{uris.join(",")}"
}

def vc_nc(c: Certificate) -> Str {
  pip = c.permitted_ip_ranges.map { it.to_s }.to_a
  xip = c.excluded_ip_ranges.map { it.to_s }.to_a
  "crit=#{c.permitted_dns_domains_critical} pdns=#{c.permitted_dns_domains.join(",")} xdns=#{c.excluded_dns_domains.join(",")} pip=#{pip.join(",")} xip=#{xip.join(",")} pem=#{c.permitted_email_addresses.join(",")} xem=#{c.excluded_email_addresses.join(",")} puri=#{c.permitted_uri_domains.join(",")} xuri=#{c.excluded_uri_domains.join(",")}"
}

def vc_pol(c: Certificate) -> Str {
  ids = c.policy_identifiers.map { it.to_s }.to_a
  pol = c.policies.map { it.to_s }.to_a
  maps = c.policy_mappings.map { "#{it.issuer_domain_policy.to_s}>#{it.subject_domain_policy.to_s}" }.to_a
  "ids=#{ids.join(",")} pol=#{pol.join(",")} iap=#{c.inhibit_any_policy} iapz=#{c.inhibit_any_policy_zero} ipm=#{c.inhibit_policy_mapping} ipmz=#{c.inhibit_policy_mapping_zero} rep=#{c.require_explicit_policy} repz=#{c.require_explicit_policy_zero} map=#{maps.join(",")}"
}

def vc_ext(c: Certificate) -> Str {
  exts = c.extensions.map { it.id.to_s + (it.critical ? "!" : "") }.to_a
  unh = c.unhandled_critical_extensions.map { it.to_s }.to_a
  "#{exts.join(",")} unhandled=#{unh.join(",")}"
}

# The PKIX re-marshalling of the public key: "raw" when it equals
# raw_subject_public_key_info, else the hex or the error.
def vc_pkix(c: Certificate) -> Str {
  r = marshal_pkix_public_key(c.public_key)
  if e = r.err {
    return "error: " + e.message
  }
  b = r.unwrap
  return "raw" if b == c.raw_subject_public_key_info
  hex.encode_to_string(b)
}
