# Value converters (Go's types.go) and the argument protocol: how any alx
# value becomes a driver Value.
#
# Go converts arguments at run time with reflection (DefaultParameterConverter:
# any integer kind to int64, any float to float64, []byte, string, bool,
# time.Time, pointers followed, Valuer called). alexandrite decides it at
# compile time instead: every argument type has a method `sql_value -> ~Value`
# — the builtins through the refinements below (`using` them is private to
# this file; generic code here sees them), and a type of yours by defining it
# (Go's Valuer). The rules are Go's: all integer types become Int (a U64 with
# the high bit set fails, as in Go), floats Float, `[Byte]` Bytes (a copy is
# not made, as in Go), `T?` is the value or Null (Go's nil pointer), and a
# Value or NamedValue passes through.
#
# A query's argument list is any of: `nil` (no arguments), one value, a tuple
# of up to 8 values (each a different type, like Go's `args ...any`), a
# `[Value]` or a `[NamedValue]`. `to_named_values(args)` turns it into the
# NamedValues a driver receives (ordinals from 1).

import "strconv"
import "time"

using VInt
using VFloat
using VBool
using VStr
using VBytes
using VTime
using VValue
using VNamed
using VOpt
using VUnit
using VValues
using VNameds
using VI8
using VI16
using VI32
using VU8
using VU16
using VU32
using VU64
using VTup2
using VTup3
using VTup4
using VTup5
using VTup6
using VTup7
using VTup8

# A value usable as a query argument: Go's Valuer. Implement `sql_value`;
# `sql_arg` and `sql_args` come with it.
pub interface Valuer {
  def sql_value -> ~Value
  def sql_arg(ordinal: Int) -> ~NamedValue { NamedValue.new(name: "", ordinal: ordinal, value: self.~sql_value) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

# The driver Value of any argument value (Go's DefaultParameterConverter,
# Valuer included).
pub def to_value[T](x: T) -> ~Value { x.~sql_value }

# The NamedValues of an argument list (see above).
pub def to_named_values[A](args: A) -> ~[NamedValue] { args.~sql_args }

def positional(v: Value, ordinal: Int) -> NamedValue { NamedValue.new(name: "", ordinal: ordinal, value: v) }

refine VInt for Int {
  def sql_value -> ~Value { Value.Int(self) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VI8 for I8 {
  def sql_value -> ~Value { Value.Int(self.to_i) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VI16 for I16 {
  def sql_value -> ~Value { Value.Int(self.to_i) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VI32 for I32 {
  def sql_value -> ~Value { Value.Int(self.to_i) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VU8 for U8 {
  def sql_value -> ~Value { Value.Int(self.to_i) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VU16 for U16 {
  def sql_value -> ~Value { Value.Int(self.to_i) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VU32 for U32 {
  def sql_value -> ~Value { Value.Int(self.to_i) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VU64 for U64 {
  def sql_value -> ~Value {
    fail "uint64 values with high bit set are not supported" if self >= 1 << 63
    Value.Int(self.as_i64)
  }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VFloat for Float {
  def sql_value -> ~Value { Value.Float(self) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VBool for Bool {
  def sql_value -> ~Value { Value.Bool(self) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VStr for Str {
  def sql_value -> ~Value { Value.Str(self) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VBytes for [Byte] {
  def sql_value -> ~Value { Value.Bytes(self) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VTime for time.Time {
  def sql_value -> ~Value { Value.Time(self) }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VValue for Value {
  def sql_value -> ~Value { self }
  def sql_arg(ordinal: Int) -> ~NamedValue { positional(self.~sql_value, ordinal) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VNamed for NamedValue {
  def sql_value -> ~Value { value }
  def sql_arg(ordinal: Int) -> ~NamedValue { NamedValue.new(name: name, ordinal: ordinal, value: value) }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

refine VOpt[T] for T? {
  def sql_value -> ~Value {
    if x = self {
      return x.~sql_value
    }
    Value.Null
  }
  def sql_arg(ordinal: Int) -> ~NamedValue {
    if x = self {
      return x.~sql_arg(ordinal)
    }
    positional(Value.Null, ordinal)
  }
  def sql_args -> ~[NamedValue] { [self.~sql_arg(1)] }
}

# `nil`: no arguments.
refine VUnit for Unit {
  def sql_args -> ~[NamedValue] { [] }
}

refine VValues for [Value] {
  def sql_args -> ~[NamedValue] {
    out: [NamedValue] = []
    for v in self {
      out << positional(v, out.size + 1)
    }
    out
  }
}

refine VNameds for [NamedValue] {
  def sql_args -> ~[NamedValue] {
    out: [NamedValue] = []
    for v in self {
      out << NamedValue.new(name: v.name, ordinal: out.size + 1, value: v.value)
    }
    out
  }
}

refine VTup2[A, B] for (A, B) {
  def sql_args -> ~[NamedValue] { [~self[0].sql_arg(1), ~self[1].sql_arg(2)] }
}

refine VTup3[A, B, C] for (A, B, C) {
  def sql_args -> ~[NamedValue] { [~self[0].sql_arg(1), ~self[1].sql_arg(2), ~self[2].sql_arg(3)] }
}

refine VTup4[A, B, C, D] for (A, B, C, D) {
  def sql_args -> ~[NamedValue] { [~self[0].sql_arg(1), ~self[1].sql_arg(2), ~self[2].sql_arg(3), ~self[3].sql_arg(4)] }
}

refine VTup5[A, B, C, D, E] for (A, B, C, D, E) {
  def sql_args -> ~[NamedValue] { [~self[0].sql_arg(1), ~self[1].sql_arg(2), ~self[2].sql_arg(3), ~self[3].sql_arg(4), ~self[4].sql_arg(5)] }
}

refine VTup6[A, B, C, D, E, F] for (A, B, C, D, E, F) {
  def sql_args -> ~[NamedValue] { [~self[0].sql_arg(1), ~self[1].sql_arg(2), ~self[2].sql_arg(3), ~self[3].sql_arg(4), ~self[4].sql_arg(5), ~self[5].sql_arg(6)] }
}

refine VTup7[A, B, C, D, E, F, G] for (A, B, C, D, E, F, G) {
  def sql_args -> ~[NamedValue] { [~self[0].sql_arg(1), ~self[1].sql_arg(2), ~self[2].sql_arg(3), ~self[3].sql_arg(4), ~self[4].sql_arg(5), ~self[5].sql_arg(6), ~self[6].sql_arg(7)] }
}

refine VTup8[A, B, C, D, E, F, G, H] for (A, B, C, D, E, F, G, H) {
  def sql_args -> ~[NamedValue] { [~self[0].sql_arg(1), ~self[1].sql_arg(2), ~self[2].sql_arg(3), ~self[3].sql_arg(4), ~self[4].sql_arg(5), ~self[5].sql_arg(6), ~self[6].sql_arg(7), ~self[7].sql_arg(8)] }
}

# ------------------------------------------------------------- converters

# Converts a Value for a column (Go's ValueConverter).
pub interface ValueConverter {
  def convert_value(v: Value) -> ~Value
}

# Go's driver.Bool: booleans, "1"/"0"/"true"/... (strconv.ParseBool) and the
# integers 1 and 0.
pub struct BoolType {
  pub def to_s -> Str { "Bool" }
  pub def convert_value(src: Value) -> ~Value {
    case src {
      Bool(_) => src
      Str(s) => {
        b = strconv.parse_bool(s)
        fail "sql/driver: couldn't convert #{go_quote(s)} into type bool" if b.err?
        Value.Bool(b.unwrap)
      }
      Bytes(bs) => {
        s = Str.from_bytes(bs)
        b = strconv.parse_bool(s)
        fail "sql/driver: couldn't convert #{go_quote(s)} into type bool" if b.err?
        Value.Bool(b.unwrap)
      }
      Int(i) => {
        fail "sql/driver: couldn't convert #{i} into type bool" if i != 1 && i != 0
        Value.Bool(i == 1)
      }
      _ => {fail "sql/driver: couldn't convert #{src} (#{src.go_type}) into type bool"}
    }
  }
}

# Go's driver.Int32: integers that fit 32 bits, and decimal strings.
pub struct Int32Type {
  pub def convert_value(v: Value) -> ~Value {
    case v {
      Int(i) => {
        fail "sql/driver: value #{i} overflows int32" if i > (1 << 31) - 1 || i < -(1 << 31)
        v
      }
      Str(s) => {
        n = strconv.atoi(s)
        fail "sql/driver: value #{go_quote(s)} can't be converted to int32" if n.err?
        Value.Int(n.unwrap)
      }
      _ => {fail "sql/driver: unsupported value #{v} (type #{v.go_type}) converting to int32"}
    }
  }
}

# Go's driver.String: strings and bytes as they are, anything else printed.
pub struct StringType {
  pub def convert_value(v: Value) -> ~Value {
    case v {
      Str(_) => v
      Bytes(_) => v
      _ => Value.Str(v.to_s)
    }
  }
}

# Go's driver.Null: Null passes, anything else goes through the converter.
pub struct Null[C] {
  converter: C
  pub def convert_value(v: Value) -> ~Value {
    return v if v.null?
    converter.~convert_value(v)
  }
}

# Go's driver.NotNull: Null is refused.
pub struct NotNull[C] {
  converter: C
  pub def convert_value(v: Value) -> ~Value {
    fail "nil value not allowed" if v.null?
    converter.~convert_value(v)
  }
}

# Go's DefaultParameterConverter on a Value: every Value already is one.
pub struct DefaultConverter {
  pub def convert_value(v: Value) -> ~Value { v }
}

# Go's driver.Bool, driver.Int32, driver.String, DefaultParameterConverter.
pub def bool -> BoolType { BoolType.new }
pub def int32 -> Int32Type { Int32Type.new }
pub def string -> StringType { StringType.new }
pub def default_parameter_converter -> DefaultConverter { DefaultConverter.new }

# Go's %q of a string.
def go_quote(s: Str) -> Str { strconv.quote(s) }
