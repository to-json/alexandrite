# Package sqlite: a database/sql driver for SQLite, over the system's
# libsqlite3 through the C FFI (`#[link("sqlite3")] extern def`).
#
#   import "database/sql"
#   import "database/sql/sqlite"
#
#   db = ~sql.open_driver(sqlite.Driver.new, "app.db?_busy_timeout=5000")
#   # or: sqlite.register (once), then sql.~open("sqlite3", "app.db")
#   db.~exec("create table people(id integer primary key, name text not null, age int)", nil)
#   res = db.~exec("insert into people(name, age) values(?, ?)", ("ann", 30))
#   id = res.~last_insert_id
#   p: (Int, Str, Int?) = db.query_row("select id, name, age from people where id = ?", id).~scan
#
# Not a Go std package: Go leaves drivers to third parties
# (github.com/mattn/go-sqlite3 is the usual one, and this driver follows its
# conventions: the driver name "sqlite3", DSN parameters, type mapping, time
# formats). It lives under database/sql because that is what it plugs into,
# beside the interface it implements, as std/raylib sits beside the packages
# it serves; the browser backend refuses FFI, so it is native only.
#
# DSN: a file name (or ":memory:", or a "file:" URI), then optionally
# `?key=value&...`:
#   _busy_timeout=MS (also _timeout)   wait for locks this long; default 5000
#   _foreign_keys=1 / 0 (also _fk)     PRAGMA foreign_keys
#   _journal_mode=WAL|DELETE|...       PRAGMA journal_mode
#   _synchronous=OFF|NORMAL|FULL|EXTRA PRAGMA synchronous
#   _txlock=deferred|immediate|exclusive   how `begin` starts a transaction
#   mode=ro|rw|rwc|memory              open read-only / read-write / create
#
# Types. Arguments: Int -> INTEGER, Float -> REAL, Bool -> 0/1, Str -> TEXT,
# [Byte] -> BLOB, time.Time -> TEXT "2006-01-02 15:04:05.999999999-07:00",
# NULL -> NULL. Results by storage class: INTEGER -> Int (Bool when the
# column is declared BOOLEAN/BOOL), REAL -> Float, TEXT -> Str (a time.Time
# when the column is declared DATE, DATETIME or TIMESTAMP and the text parses
# in one of mattn's formats), BLOB -> [Byte], NULL -> Null. database/sql's
# scan converts from there (a TEXT "42" scans into an Int, ...).
#
# Errors are SqliteError.Error(code, extended, msg); the message is
# SQLite's own (`UNIQUE constraint failed: people.name`), as mattn's. `code`
# is the primary result code (CONSTRAINT = 19, BUSY = 5, ...); `extended` the
# extended one (SQLITE_CONSTRAINT_UNIQUE = 2067, ...).
#
# Placeholders: `?`, `?NNN`, `:name`, `@name`, `$name`; named arguments
# (sql.named("name", v)) bind to `:name`, `@name` or `$name`.
#
# Concurrency: database/sql uses a connection from one task at a time; the
# pool gives each task its own connection, and SQLite's locking (with the
# busy timeout) arbitrates between them. A context that ends interrupts the
# running statement (sqlite3_interrupt). For ":memory:" every connection is
# its own database: use `db.set_max_open_conns(1)`, or a shared-cache URI
# ("file::memory:?cache=shared").
#
# Exec runs every statement of a multi-statement string (as mattn's),
# giving each the arguments its placeholders take, in order; a query runs
# the first statement.

import "context"
import "database/sql"
import "database/sql/driver"
import "strconv"
import "strings"
import "time"

# ---------------------------------------------------------------- the C API

#[link("sqlite3")]
extern def sqlite3_libversion -> Ptr
#[link("sqlite3")]
extern def sqlite3_open_v2(name: Str, out: [Byte], flags: I32, vfs: Ptr) -> I32
#[link("sqlite3")]
extern def sqlite3_close_v2(db: Int) -> I32
#[link("sqlite3")]
extern def sqlite3_errmsg(db: Int) -> Ptr
#[link("sqlite3")]
extern def sqlite3_errstr(code: I32) -> Ptr
#[link("sqlite3")]
extern def sqlite3_extended_errcode(db: Int) -> I32
#[link("sqlite3")]
extern def sqlite3_extended_result_codes(db: Int, on: I32) -> I32
#[link("sqlite3")]
extern def sqlite3_busy_timeout(db: Int, ms: I32) -> I32
#[link("sqlite3")]
extern def sqlite3_interrupt(db: Int)
#[link("sqlite3")]
extern def sqlite3_get_autocommit(db: Int) -> I32
#[link("sqlite3")]
extern def sqlite3_changes(db: Int) -> I32
#[link("sqlite3")]
extern def sqlite3_last_insert_rowid(db: Int) -> Int
#[link("sqlite3")]
extern def sqlite3_prepare_v2(db: Int, sql: Int, n: I32, out: [Byte], tail: [Byte]) -> I32
#[link("sqlite3")]
extern def sqlite3_malloc64(n: Int) -> Int
#[link("sqlite3")]
extern def sqlite3_free(p: Int)
#[link("sqlite3")]
extern def sqlite3_finalize(st: Int) -> I32
#[link("sqlite3")]
extern def sqlite3_reset(st: Int) -> I32
#[link("sqlite3")]
extern def sqlite3_clear_bindings(st: Int) -> I32
#[link("sqlite3")]
extern def sqlite3_bind_parameter_count(st: Int) -> I32
#[link("sqlite3")]
extern def sqlite3_bind_parameter_index(st: Int, name: Str) -> I32
#[link("sqlite3")]
extern def sqlite3_bind_null(st: Int, i: I32) -> I32
#[link("sqlite3")]
extern def sqlite3_bind_int64(st: Int, i: I32, v: Int) -> I32
#[link("sqlite3")]
extern def sqlite3_bind_double(st: Int, i: I32, v: Float) -> I32
#[link("sqlite3")]
extern def sqlite3_bind_text(st: Int, i: I32, p: [Byte], n: I32, destructor: Int) -> I32
#[link("sqlite3")]
