# Generated from Go's encoding/ascii85 (go run): encodings of random bytes, decodings of corrupt input; do not edit by hand.
import "bytes"

def bs(xs: [Byte]) -> [Byte] { xs }

def chk_enc(src: [Byte], want: Str) {
  dst: [Byte] = [0; max_encoded_len(src.size)]
  n = encode(dst, src)
  assert_eq Str.from_bytes(dst[0...n]), want
}

# decode into a dst of dst_size bytes: (ndst, nsrc, the bytes) or the error.
def chk_dec(src: Str, flush: Bool, dst_size: Int, ndst: Int, nsrc: Int, want: [Byte], err: Str) {
  dst: [Byte] = [0; dst_size]
  r = decode(dst, src.bytes.to_a, flush)
  if e = r.err {
    assert_eq e.message, err
  } else {
    assert_eq err, ""
    assert_eq r.unwrap, (ndst, nsrc)
    assert_eq dst[0...ndst], want
  }
}

def chk_stream(chunks: [Str], size: Int, want: [Byte], err: Str) {
  d = new_decoder(chunk_reader(chunks))
  out: [Byte] = []
  p: [Byte] = [0; size]
  msg = ""
  loop {
    r = d.read!(p)
    if e = r.err {
      msg = e.message
      break
    }
    n = r.unwrap
    break if n == 0
    out = out + p[0...n]
  }
  assert_eq out, want
  assert_eq msg, err
}

def chk_enc_stream(src: [Byte], chunk: Int, want: Str) {
  buf = bytes.new_buffer([])
  w = new_encoder(buf)
  i = 0
  while i < src.size {
    j = i + chunk
    j = src.size if j > src.size
    assert_eq w.write!(src[i...j]).unwrap, j - i
    i = j
  }
  w.close!.unwrap
  assert_eq buf.to_s, want
}

