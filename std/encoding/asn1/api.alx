# The public Marshal / Unmarshal entry points: generic ones for derived
# types and typed ones for the other values Go's reflection handles.

import "math/big"
import "time"

# What #[derive(Asn1)] writes: the element of a value with field params.
pub interface Marshaler {
  def asn1_enc(p: Params) -> ~[Byte]<Asn1Error>
}

# Go's Marshal for a type that derives Asn1 (same as v.to_asn1).
pub def marshal[T: Marshaler](v: T) -> ~[Byte]<Asn1Error> { v.~asn1_enc(Params.new) }

# Go's MarshalWithParams: params is a field tag ("set", "tag:1,explicit").
pub def marshal_with_params[T: Marshaler](v: T, params: Str) -> ~[Byte]<Asn1Error> { v.~asn1_enc(parse_field_parameters(params)) }

# Go's Unmarshal for a type that derives Asn1 (same as T.from_asn1(b)):
# the value and the bytes after it.
pub def unmarshal[T](b: [Byte]) -> ~(T, [Byte])<Asn1Error> {
  v, off = ~T.asn1_dec(b, 0, Params.new, 0)
  (v, b[off...b.size])
}

# Go's UnmarshalWithParams for a derived type.
pub def unmarshal_with_params[T](b: [Byte], params: Str) -> ~(T, [Byte])<Asn1Error> {
  v, off = ~T.asn1_dec(b, 0, parse_field_parameters(params), 0)
  (v, b[off...b.size])
}

# ---------------------------------------------------------------- typed Marshal

pub def marshal_bool(v: Bool) -> ~[Byte]<Asn1Error> { ~enc_bool(v, Params.new) }
pub def marshal_int(v: Int) -> ~[Byte]<Asn1Error> { ~enc_int(v, Params.new) }
pub def marshal_enumerated(v: Int) -> ~[Byte]<Asn1Error> { ~enc_enumerated(v, Params.new) }
pub def marshal_big(v: big.Int) -> ~[Byte]<Asn1Error> { ~enc_big(v, Params.new) }
pub def marshal_bytes(v: [Byte]) -> ~[Byte]<Asn1Error> { ~enc_bytes(v, Params.new) }
pub def marshal_bit_string(v: BitString) -> ~[Byte]<Asn1Error> { ~enc_bit_string(v, Params.new) }
pub def marshal_oid(v: ObjectIdentifier) -> ~[Byte]<Asn1Error> { ~enc_oid(v, Params.new) }
pub def marshal_time(v: time.Time) -> ~[Byte]<Asn1Error> { ~enc_time(v, Params.new) }
pub def marshal_str(v: Str) -> ~[Byte]<Asn1Error> { ~enc_str(v, Params.new) }
pub def marshal_raw(v: RawValue) -> ~[Byte]<Asn1Error> { ~enc_raw(v, Params.new) }
pub def marshal_any(v: Any) -> ~[Byte]<Asn1Error> { ~enc_any(v, Params.new) }

pub def marshal_bool_with_params(v: Bool, params: Str) -> ~[Byte]<Asn1Error> { ~enc_bool(v, parse_field_parameters(params)) }
pub def marshal_int_with_params(v: Int, params: Str) -> ~[Byte]<Asn1Error> { ~enc_int(v, parse_field_parameters(params)) }
pub def marshal_big_with_params(v: big.Int, params: Str) -> ~[Byte]<Asn1Error> { ~enc_big(v, parse_field_parameters(params)) }
pub def marshal_bytes_with_params(v: [Byte], params: Str) -> ~[Byte]<Asn1Error> { ~enc_bytes(v, parse_field_parameters(params)) }
pub def marshal_oid_with_params(v: ObjectIdentifier, params: Str) -> ~[Byte]<Asn1Error> { ~enc_oid(v, parse_field_parameters(params)) }
pub def marshal_time_with_params(v: time.Time, params: Str) -> ~[Byte]<Asn1Error> { ~enc_time(v, parse_field_parameters(params)) }
pub def marshal_str_with_params(v: Str, params: Str) -> ~[Byte]<Asn1Error> { ~enc_str(v, parse_field_parameters(params)) }

# A SEQUENCE OF (SET OF with params "set") strings / ints.
pub def marshal_strs(v: [Str]) -> ~[Byte]<Asn1Error> { ~marshal_strs_with_params(v, "") }
pub def marshal_strs_with_params(v: [Str], params: Str) -> ~[Byte]<Asn1Error> {
  es: [[Byte]] = []
  for s in v {
    es << ~enc_str(s, Params.new)
  }
  ~enc_list(es, false, parse_field_parameters(params))
}
pub def marshal_ints(v: [Int]) -> ~[Byte]<Asn1Error> { ~marshal_ints_with_params(v, "") }
pub def marshal_ints_with_params(v: [Int], params: Str) -> ~[Byte]<Asn1Error> {
  es: [[Byte]] = []
  for i in v {
    es << ~enc_int(i, Params.new)
  }
  ~enc_list(es, false, parse_field_parameters(params))
}

# ---------------------------------------------------------------- typed Unmarshal

def rest(b: [Byte], off: Int) -> [Byte] { b[off...b.size] }

pub def unmarshal_bool(b: [Byte]) -> ~(Bool, [Byte])<Asn1Error> {
  v, o = ~dec_bool(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_int(b: [Byte]) -> ~(Int, [Byte])<Asn1Error> {
  v, o = ~dec_int(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_int32(b: [Byte]) -> ~(Int, [Byte])<Asn1Error> {
  v, o = ~dec_int32(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_enumerated(b: [Byte]) -> ~(Int, [Byte])<Asn1Error> {
  v, o = ~dec_enumerated(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_big(b: [Byte]) -> ~(big.Int, [Byte])<Asn1Error> {
  v, o = ~dec_big(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_bytes(b: [Byte]) -> ~([Byte], [Byte])<Asn1Error> {
  v, o = ~dec_bytes(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_bit_string(b: [Byte]) -> ~(BitString, [Byte])<Asn1Error> {
  v, o = ~dec_bit_string(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_oid(b: [Byte]) -> ~(ObjectIdentifier, [Byte])<Asn1Error> {
  v, o = ~dec_oid(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_time(b: [Byte]) -> ~(time.Time, [Byte])<Asn1Error> {
  v, o = ~dec_time(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_str(b: [Byte]) -> ~(Str, [Byte])<Asn1Error> {
  v, o = ~dec_str(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_raw(b: [Byte]) -> ~(RawValue, [Byte])<Asn1Error> {
  v, o = ~dec_raw(b, 0, Params.new, 0)
  (v, rest(b, o))
}
pub def unmarshal_any(b: [Byte]) -> ~(Any, [Byte])<Asn1Error> {
  v, o = ~dec_any(b, 0, Params.new, 0)
  (v, rest(b, o))
}

# Typed unmarshal with params (Go's UnmarshalWithParams).
pub def unmarshal_int_with_params(b: [Byte], params: Str) -> ~(Int, [Byte])<Asn1Error> {
  v, o = ~dec_int(b, 0, parse_field_parameters(params), 0)
  (v, rest(b, o))
}
pub def unmarshal_str_with_params(b: [Byte], params: Str) -> ~(Str, [Byte])<Asn1Error> {
  v, o = ~dec_str(b, 0, parse_field_parameters(params), 0)
  (v, rest(b, o))
}
pub def unmarshal_bytes_with_params(b: [Byte], params: Str) -> ~([Byte], [Byte])<Asn1Error> {
  v, o = ~dec_bytes(b, 0, parse_field_parameters(params), 0)
  (v, rest(b, o))
}

# A SEQUENCE OF (or with params "set", SET OF) strings / ints.
pub def unmarshal_strs(b: [Byte]) -> ~([Str], [Byte])<Asn1Error> { ~unmarshal_strs_with_params(b, "") }
pub def unmarshal_strs_with_params(b: [Byte], params: Str) -> ~([Str], [Byte])<Asn1Error> {
  h = ~head(b, 0, parse_field_parameters(params), K_SEQUENCE, "", 0)
  out: [Str] = []
  if h.present {
    inner = b[h.body...h.end]
    ~check_seq_of(inner, K_STR)
    o = 0
    while o < inner.size {
      v, o2 = ~dec_str(inner, o, Params.new, h.depth)
      out << v
      o = o2
    }
  }
  (out, rest(b, h.next))
}
pub def unmarshal_ints(b: [Byte]) -> ~([Int], [Byte])<Asn1Error> { ~unmarshal_ints_with_params(b, "") }
pub def unmarshal_ints_with_params(b: [Byte], params: Str) -> ~([Int], [Byte])<Asn1Error> {
  h = ~head(b, 0, parse_field_parameters(params), K_SEQUENCE, "", 0)
  out: [Int] = []
  if h.present {
    inner = b[h.body...h.end]
    ~check_seq_of(inner, K_INT)
    o = 0
    while o < inner.size {
      v, o2 = ~dec_int(inner, o, Params.new, h.depth)
      out << v
      o = o2
    }
  }
  (out, rest(b, h.next))
}
