# Go's encoding/asn1 tests of the primitive parsers (asn1_test.go). The
# struct-based tests (Unmarshal / Marshal of tagged structs) need the
# derive, which imports this package: they are in derives/derives_test.alx.

import "encoding/hex"
import "math/big"
import "time"

def hx(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

test "ParseBool" {
  data = [([0x00.as_u8], true, false), ([0xff.as_u8], true, true), ([0x00.as_u8, 0x00], false, false), ([0xff.as_u8, 0xff], false, false), ([0x01.as_u8], false, false)]
  for d in data {
    in_, ok, out = d
    r = parse_bool(in_)
    assert_eq r.ok?, ok
    assert_eq r.unwrap, out if ok
  }
}

test "ParseInt64" {
  data = [("00", true, 0), ("7f", true, 127), ("0080", true, 128), ("0100", true, 256), ("80", true, -128), ("ff7f", true, -129), ("ff", true, -1), ("8000000000000000", true, -9223372036854775808), ("800000000000000000", false, 0), ("", false, 0), ("007f", false, 0), ("fff0", false, 0)]
  for d in data {
    in_, ok, out = d
    r = parse_int64(hx(in_))
    assert r.ok? == ok, in_
    assert_eq r.unwrap, out if ok
  }
}

test "ParseInt32" {
  data = [("00", true, 0), ("7f", true, 127), ("0080", true, 128), ("0100", true, 256), ("80", true, -128), ("ff7f", true, -129), ("ff", true, -1), ("80000000", true, -2147483648), ("8000000000", false, 0), ("", false, 0), ("007f", false, 0), ("fff0", false, 0)]
  for d in data {
    in_, ok, out = d
    r = parse_int32(hx(in_))
    assert r.ok? == ok, in_
    assert_eq r.unwrap, out if ok
  }
}

test "ParseBigInt" {
  data = [("ff", true, "-1"), ("00", true, "0"), ("01", true, "1"), ("00ff", true, "255"), ("ff00", true, "-256"), ("0100", true, "256"), ("", false, ""), ("007f", false, ""), ("fff0", false, "")]
  for d in data {
    in_, ok, base10 = d
    r = parse_big_int(hx(in_))
    assert r.ok? == ok, in_
    if ok {
      v = r.unwrap
      assert_eq v.to_s, base10
      assert_eq big_int_bytes(v), hx(in_)
    }
  }
}

test "BitString" {
  data = [("", false, "", 0), ("00", true, "", 0), ("0700", true, "00", 1), ("0701", false, "", 0), ("0740", false, "", 0), ("0800", false, "", 0)]
  for d in data {
    in_, ok, out, bit_length = d
    r = parse_bit_string(hx(in_))
    assert r.ok? == ok, in_
    if ok {
      b = r.unwrap
      assert_eq b.bit_length, bit_length
      assert_eq b.bytes, hx(out)
    }
  }
}

test "BitStringAt" {
  bs = BitString.new(bytes: [0x82, 0x40], bit_length: 16)
  assert_eq bs.at(0), 1
  assert_eq bs.at(1), 0
  assert_eq bs.at(6), 1
  assert_eq bs.at(9), 1
  assert_eq bs.at(-1), 0
  assert_eq bs.at(17), 0
}

test "BitStringRightAlign" {
  data = [("80", 1, "01"), ("8080", 9, "0101"), ("", 0, ""), ("ce", 8, "ce"), ("ce47", 16, "ce47"), ("3450", 12, "0345")]
  for d in data {
    in_, inlen, out = d
    bs = BitString.new(bytes: hx(in_), bit_length: inlen)
    assert_eq bs.right_align, hx(out)
  }
}

test "ObjectIdentifier" {
  data: [(Str, Bool, [Int])] = [("", false, []), ("55", true, [2, 5]), ("5502", true, [2, 5, 2]), ("5502c000", true, [2, 5, 2, 0x2000]), ("813403", true, [2, 100, 3]), ("5502c080808080", false, [])]
  for d in data {
    in_, ok, out = d
    r = parse_object_identifier(hx(in_))
    assert r.ok? == ok, in_
    assert_eq r.unwrap.arcs, out if ok
  }
  assert_eq oid([1, 2, 3, 4]).to_s, "1.2.3.4"
}

test "UTCTime" {
  data = [("910506164540-0700", true, time.date(1991, 5, 6, 16, 45, 40, 0, time.fixed_zone("", -7 * 60 * 60))), ("910506164540+0730", true, time.date(1991, 5, 6, 16, 45, 40, 0, time.fixed_zone("", 7 * 60 * 60 + 30 * 60))), ("910506234540Z", true, time.date(1991, 5, 6, 23, 45, 40, 0, time.utc())), ("9105062345Z", true, time.date(1991, 5, 6, 23, 45, 0, 0, time.utc())), ("5105062345Z", true, time.date(1951, 5, 6, 23, 45, 0, 0, time.utc())), ("a10506234540Z", false, time.Time.new), ("91a506234540Z", false, time.Time.new), ("9105a6234540Z", false, time.Time.new), ("910506a34540Z", false, time.Time.new), ("910506334a40Z", false, time.Time.new), ("91050633444aZ", false, time.Time.new), ("910506334461Z", false, time.Time.new), ("910506334400Za", false, time.Time.new), ("000100000000Z", false, time.Time.new), ("101302030405Z", false, time.Time.new), ("100002030405Z", false, time.Time.new), ("100100030405Z", false, time.Time.new), ("100132030405Z", false, time.Time.new), ("100231030405Z", false, time.Time.new), ("100102240405Z", false, time.Time.new), ("100102036005Z", false, time.Time.new), ("100102030460Z", false, time.Time.new), ("-100102030410Z", false, time.Time.new), ("10-0102030410Z", false, time.Time.new), ("10-0002030410Z", false, time.Time.new), ("1001-02030410Z", false, time.Time.new), ("100102-030410Z", false, time.Time.new), ("10010203-0410Z", false, time.Time.new), ("1001020304-10Z", false, time.Time.new)]
  for d in data {
    in_, ok, out = d
    r = parse_utc_time(in_.bytes)
    assert r.ok? == ok, in_
    if ok {
      # ignore zone name, just offset
      format = "Jan _2 15:04:05 -0700 2006"
      assert_eq r.unwrap.format(format), out.format(format)
    }
  }
}

test "GeneralizedTime" {
  data = [("20100102030405Z", true, time.date(2010, 1, 2, 3, 4, 5, 0, time.utc())), ("20100102030405", false, time.Time.new), ("20100102030405.123456Z", true, time.date(2010, 1, 2, 3, 4, 5, 123456000, time.utc())), ("20100102030405.123456", false, time.Time.new), ("20100102030405.Z", false, time.Time.new), ("20100102030405.", false, time.Time.new), ("20100102030405+0607", true, time.date(2010, 1, 2, 3, 4, 5, 0, time.fixed_zone("", 6 * 60 * 60 + 7 * 60))), ("20100102030405-0607", true, time.date(2010, 1, 2, 3, 4, 5, 0, time.fixed_zone("", -6 * 60 * 60 - 7 * 60))), ("00000100000000Z", false, time.Time.new), ("20101302030405Z", false, time.Time.new), ("20100002030405Z", false, time.Time.new), ("20100100030405Z", false, time.Time.new), ("20100132030405Z", false, time.Time.new), ("20100231030405Z", false, time.Time.new), ("20100102240405Z", false, time.Time.new), ("20100102036005Z", false, time.Time.new), ("20100102030460Z", false, time.Time.new), ("-20100102030410Z", false, time.Time.new), ("2010-0102030410Z", false, time.Time.new), ("2010-0002030410Z", false, time.Time.new), ("201001-02030410Z", false, time.Time.new), ("20100102-030410Z", false, time.Time.new), ("2010010203-0410Z", false, time.Time.new), ("201001020304-10Z", false, time.Time.new)]
  for d in data {
    in_, ok, out = d
    r = parse_generalized_time(in_.bytes)
    assert r.ok? == ok, in_
    if ok {
      got = r.unwrap
      assert got == out, in_
      assert_eq got.zone_info[1], out.zone_info[1]
    }
  }
}

test "ParseTagAndLength" {
  t = ->(c: Int, g: Int, l: Int, k: Bool) -> TagAndLength { TagAndLength.new(class: c, tag: g, length: l, is_compound: k) }
  z = TagAndLength.new
  data = [("8001", true, t.call(2, 0, 1, false)), ("a001", true, t.call(2, 0, 1, true)), ("0200", true, t.call(0, 2, 0, false)), ("fe00", true, t.call(3, 30, 0, true)), ("1f1f00", true, t.call(0, 31, 0, false)), ("1f810000", true, t.call(0, 128, 0, false)), ("1f81800100", true, t.call(0, 0x4001, 0, false)), ("008180", true, t.call(0, 0, 128, false)), ("00820100", true, t.call(0, 0, 256, false)), ("00830100", false, z), ("1f85", false, z), ("3080", false, z), ("a08200ff", false, z), ("a0847fffffff", true, t.call(2, 0, 0x7fffffff, true)), ("a08480000000", false, z), ("a0817f", false, z), ("1f888080800000", false, z), ("1f87ffffff7f00", true, t.call(0, 2147483647, 0, false)), ("1f1e00", false, z)]
  for d in data {
    in_, ok, out = d
    r = parse_tag_and_length(hx(in_), 0)
    assert r.ok? == ok, in_
    assert_eq r.unwrap[0], out if ok
  }
}

test "ParseFieldParameters" {
  data = [("", Params.new), ("ia5", Params.new(string_type: TAG_IA5_STRING)), ("generalized", Params.new(time_type: TAG_GENERALIZED_TIME)), ("utc", Params.new(time_type: TAG_UTC_TIME)), ("printable", Params.new(string_type: TAG_PRINTABLE_STRING)), ("numeric", Params.new(string_type: TAG_NUMERIC_STRING)), ("optional", Params.new(optional: true)), ("explicit", Params.new(explicit: true, tag: 0)), ("application", Params.new(application: true, tag: 0)), ("private", Params.new(private: true, tag: 0)), ("optional,explicit", Params.new(optional: true, explicit: true, tag: 0)), ("default:42", Params.new(default_value: 42)), ("tag:17", Params.new(tag: 17)), ("optional,explicit,default:42,tag:17", Params.new(optional: true, explicit: true, default_value: 42, tag: 17)), ("optional,explicit,default:42,tag:17,rubbish1", Params.new(optional: true, explicit: true, default_value: 42, tag: 17)), ("set", Params.new(set: true))]
  for d in data {
    in_, out = d
    assert parse_field_parameters(in_) == out, in_
  }
}

test "ObjectIdentifierEqual" {
  assert oid([1, 2, 3]).equal?(oid([1, 2, 3]))
  assert !oid([1]).equal?(oid([1, 2, 3]))
  assert !oid([1, 2, 3]).equal?(oid([10, 11, 12]))
}

test "BMPString" {
  data = [("empty string", "", "0000", false), ("rfc7292 example", "Beavis", "0042006500610076006900730000", false), ("letterlike symbols", "\u2115 - Double-struck N", "21150020002d00200044006f00750062006c0065002d00730074007200750063006b0020004e0000", false), ("invalid length", "", "ff", true), ("invalid surrogate", "", "5051d801", true), ("invalid noncharacter 0xfdd1", "", "5051fdd1", true), ("invalid noncharacter 0xffff", "", "5051ffff", true), ("invalid noncharacter 0xfffe", "", "5051fffe", true)]
  for d in data {
    name, decoded, encoded, invalid = d
    r = parse_bmp_string(hx(encoded))
    assert r.ok? == !invalid, name
    assert (r.ok || "") == decoded, name
  }
}

test "NonMinimalEncodedOID" {
  assert !unmarshal_oid(hx("060a2a80864886f70d01010b")).ok?, "accepted non-minimally encoded oid"
}

test "ObjectIdentifierString" {
  assert_eq oid([1, 2, 840, 113549, 1, 1, 1]).string, "1.2.840.113549.1.1.1"
}

test "big ints" {
  assert_eq unmarshal_big(hx("0203123456")).unwrap[0], big.new_int(0x123456)
}
