# Go's encoding/asn1 tests that marshal and unmarshal structs
# (asn1_test.go, marshal_test.go), on #[derive(Asn1)]. Their own package
# because the derived code imports encoding/asn1.
#
# Not translated: TestUnmarshalWithNilOrNonPointer and
# TestUnexportedStructField (Unmarshal's recipient and unexported fields
# are compile-time matters in alx); TestUnmarshalNestingLimitSlice /
# Struct (recursive types can't exist in alx); TestParsingMemoryConsumption's
# allocation measurement (no runtime.MemStats; its error check is here).

import "encoding/asn1"
import "encoding/hex"
import "math/big"
import "strings"
import "time"

def hx(s: Str) -> [Byte] { hex.decode_string(s).unwrap }
def hs(b: [Byte]) -> Str { hex.encode_to_string(b) }

# ---------------------------------------------------------------- asn1_test.go types

#[derive(Asn1)]
struct TestObjectIdentifierStruct {
  oid: asn1.ObjectIdentifier
}

#[derive(Asn1)]
struct TestContextSpecificTags {
  #[asn1(tag: 1)] a: Int
}

#[derive(Asn1)]
struct TestContextSpecificTags2 {
  #[asn1(explicit, tag: 1)] a: Int
  b: Int
}

#[derive(Asn1)]
struct TestContextSpecificTags3 {
  #[asn1(tag: 1, utf8)] s: Str
}

#[derive(Asn1)]
struct TestElementsAfterString {
  s: Str
  a: Int
  b: Int
}

#[derive(Asn1)]
struct TestBigInt {
  x: big.Int
}

#[derive(Asn1)]
struct TestSet {
  #[asn1(set)] ints: [Int]
}

#[derive(Asn1)]
struct Certificate {
  tbs_certificate: TBSCertificate
  signature_algorithm: AlgorithmIdentifier
  signature_value: asn1.BitString
}

#[derive(Asn1)]
struct TBSCertificate {
  #[asn1(optional, explicit, default: 0, tag: 0)] version: Int
  serial_number: asn1.RawValue
  signature_algorithm: AlgorithmIdentifier
  issuer: RDNSequence
  validity: Validity
  subject: RDNSequence
  public_key: PublicKeyInfo
}

#[derive(Asn1)]
struct AlgorithmIdentifier {
  algorithm: asn1.ObjectIdentifier
}

# Go's `type RDNSequence []RelativeDistinguishedNameSET`.
#[derive(Asn1)]
#[asn1(transparent)]
struct RDNSequence {
  rdns: [RelativeDistinguishedNameSET]
}

# Go's `type RelativeDistinguishedNameSET []AttributeTypeAndValue`.
#[derive(Asn1)]
#[asn1(set)]
struct RelativeDistinguishedNameSET {
  atvs: [AttributeTypeAndValue]
}

#[derive(Asn1)]
struct AttributeTypeAndValue {
  type: asn1.ObjectIdentifier
  value: asn1.Any
}

#[derive(Asn1)]
struct Validity {
  not_before: time.Time
  not_after: time.Time
}

#[derive(Asn1)]
struct PublicKeyInfo {
  algorithm: AlgorithmIdentifier
  public_key: asn1.BitString
}

#[derive(Asn1)]
struct RawStructTest {
  #[asn1(raw_content)] raw: [Byte]
  a: Int
}

#[derive(Asn1)]
struct ExplicitTaggedTimeTest {
  #[asn1(explicit, tag: 0)] time: time.Time
}

#[derive(Asn1)]
struct ImplicitTaggedTimeTest {
  #[asn1(tag: 24)] time: time.Time
}

#[derive(Asn1)]
struct TruncatedExplicitTagTest {
  #[asn1(explicit, tag: 0)] test: Int
}

#[derive(Asn1)]
struct InvalidUTF8Test {
  #[asn1(utf8)] str: Str
}

#[derive(Asn1)]
struct AnyHolder {
  v: asn1.Any
}

#[derive(Asn1)]
struct ExplicitTagRawValue {
  #[asn1(optional, explicit, tag: 5)] a: asn1.RawValue
  #[asn1(optional, explicit, tag: 6)] b: [Byte]
}

#[derive(Asn1)]
struct TaggedRawValue {
  #[asn1(tag: 5)] a: asn1.RawValue
}

#[derive(Asn1)]
struct UntaggedRawValue {
  a: asn1.RawValue
}

#[derive(Asn1)]
struct Tagged {
  #[asn1(tag: 1, ia5)] ia5: Str
  #[asn1(tag: 2, printable)] printable: Str
  #[asn1(tag: 3, utf8)] utf8: Str
  #[asn1(tag: 4, numeric)] numeric: Str
  #[asn1(tag: 5, utc)] utc: time.Time
  #[asn1(tag: 6, generalized)] generalized: time.Time
}

#[derive(Asn1)]
struct BombElem {
  id: [Int]
  #[asn1(optional)] critical: Bool
  value: [Byte]
}

#[derive(Asn1)]
#[asn1(transparent)]
struct Bomb {
  elems: [BombElem]
}

# ---------------------------------------------------------------- marshal_test.go types

#[derive(Asn1)]
struct IntStruct {
  a: Int
}

#[derive(Asn1)]
struct TwoIntStruct {
  a: Int
  b: Int
}

#[derive(Asn1)]
struct BigIntStruct {
  a: big.Int
}

#[derive(Asn1)]
struct OptBigIntStruct {
  a: big.Int?
}

#[derive(Asn1)]
struct NestedStruct {
  a: IntStruct
}

#[derive(Asn1)]
struct RawContentsStruct {
  #[asn1(raw_content)] raw: [Byte]
  a: Int
}

# Go's `asn1:"implicit,tag:5"`: "implicit" isn't an option (tags are
# implicit unless explicit); Go ignores it.
#[derive(Asn1)]
struct ImplicitTagTest {
  #[asn1(tag: 5)] a: Int
}

#[derive(Asn1)]
struct ExplicitTagTest {
  #[asn1(explicit, tag: 5)] a: Int
}

#[derive(Asn1)]
struct FlagTest {
  #[asn1(flag, tag: 0, optional)] a: Bool
}

#[derive(Asn1)]
struct GeneralizedTimeTest {
  #[asn1(generalized)] a: time.Time
}

#[derive(Asn1)]
struct Ia5StringTest {
  #[asn1(ia5)] a: Str
}

#[derive(Asn1)]
struct PrintableStringTest {
  #[asn1(printable)] a: Str
}

#[derive(Asn1)]
struct GenericStringTest {
  a: Str
}

#[derive(Asn1)]
struct OptionalRawValueTest {
  #[asn1(optional)] a: asn1.RawValue
}

#[derive(Asn1)]
struct OmitEmptyTest {
  #[asn1(omitempty)] a: [Str]
}

#[derive(Asn1)]
struct DefaultTest {
  #[asn1(optional, default: 1)] a: Int
}

#[derive(Asn1)]
struct ApplicationTest {
  #[asn1(application, tag: 0)] a: Int
  #[asn1(application, tag: 1, explicit)] b: Int
}

#[derive(Asn1)]
struct PrivateTest {
  #[asn1(private, tag: 0)] a: Int
  #[asn1(private, tag: 1, explicit)] b: Int
  # tag size should be 2 octet
  #[asn1(private, tag: 31)] c: Int
  # tag size should be 3 octet
  #[asn1(private, tag: 128)] d: Int
}

#[derive(Asn1)]
struct NumericStringTest {
  #[asn1(numeric)] a: Str
}

# Go's `type testSET []int`.
#[derive(Asn1)]
#[asn1(set)]
struct TestSET {
  ints: [Int]
}

#[derive(Asn1)]
struct SetStrings {
  #[asn1(set)] strings: [Str]
}

# Go's `type testSetSET []string`.
#[derive(Asn1)]
#[asn1(set)]
struct TestSetSET {
  strs: [Str]
}

# Other field types alx adds.
#[derive(Asn1)]
struct Extras {
  small: I8
  mid: I32
  #[asn1(enumerated)] e: Int
  names: [[Str]]
  # Optionals last: as in Go, an explicitly tagged field followed by an
  # empty element fails ("explicit tag has no child") even when optional.
  opt: Str?
  #[asn1(explicit, tag: 3)] opt2: Int?
  #[asn1(skip)] cache: Int
}

def pst -> time.Location { time.fixed_zone("PST", -8 * 60 * 60) }

def far_future -> time.Time { time.parse(time.RFC3339, "2100-04-05T12:01:01Z").unwrap }

def self_signed -> Certificate {
  rdn = ->(oid: [Int], v: Str) -> RelativeDistinguishedNameSET { RelativeDistinguishedNameSET.new(atvs: [AttributeTypeAndValue.new(type: asn1.oid(oid), value: asn1.Any.Str(v))]) }
  name = RDNSequence.new(rdns: [rdn.call([2, 5, 4, 6], "XX"), rdn.call([2, 5, 4, 8], "Some-State"), rdn.call([2, 5, 4, 7], "City"), rdn.call([2, 5, 4, 10], "Internet Widgits Pty Ltd"), rdn.call([2, 5, 4, 3], "false.example.com"), rdn.call([1, 2, 840, 113549, 1, 9, 1], "false@example.com")])
  Certificate.new(
    tbs_certificate: TBSCertificate.new(
      version: 0,
      serial_number: asn1.RawValue.new(class: 0, tag: 2, is_compound: false, bytes: hx("008cc3379210ec2c98"), full_bytes: hx("0209008cc3379210ec2c98")),
      signature_algorithm: AlgorithmIdentifier.new(algorithm: asn1.oid([1, 2, 840, 113549, 1, 1, 5])),
      issuer: name,
      validity: Validity.new(not_before: time.date(2009, 10, 8, 0, 25, 53, 0, time.utc()), not_after: time.date(2010, 10, 8, 0, 25, 53, 0, time.utc())),
      subject: name,
      public_key: PublicKeyInfo.new(algorithm: AlgorithmIdentifier.new(algorithm: asn1.oid([1, 2, 840, 113549, 1, 1, 1])), public_key: asn1.BitString.new(bytes: hx("3048024100cdb7639c3278f006aa277f6eaf42902b592d8cbcbe38a1c92ba4695a331b1deadeadd8e9a5c27e8c4c2fd0a8889657722a4f2af7589cf2c77045dc8fdeec357d0203010001"), bit_length: 592))
    ),
    signature_algorithm: AlgorithmIdentifier.new(algorithm: asn1.oid([1, 2, 840, 113549, 1, 1, 5])),
    signature_value: asn1.BitString.new(bytes: hx("a67b06ec5ece92772ca413cba3ca12568fdc6c7b4511cd40a7f659980402df2b998bb9a4a8cbeb34c0f0a78cf8d91ede14a5ed76bf116fe360aafa8821490435"), bit_length: 512)
  )
}

SELF_SIGNED_HEX = ""

PAYPAL_NUL_HEX = ""

# ---------------------------------------------------------------- Unmarshal

test "Unmarshal" {
  assert_eq asn1.unmarshal_int(hx("020142")).unwrap[0], 0x42
  assert_eq asn1.unmarshal_raw(hx("0500")).unwrap[0], asn1.RawValue.new(class: 0, tag: 5, is_compound: false, bytes: [], full_bytes: hx("0500"))
  assert_eq TestObjectIdentifierStruct.from_asn1(hx("300806062a864886f70d")).unwrap[0].oid.arcs, [1, 2, 840, 113549]
  assert_eq asn1.unmarshal_bit_string(hx("0304066e5dc0")).unwrap[0], asn1.BitString.new(bytes: [110, 93, 192], bit_length: 18)
  assert_eq asn1.unmarshal_ints(hx("3009020101020102020103")).unwrap[0], [1, 2, 3]
  assert_eq asn1.unmarshal_int(hx("020110")).unwrap[0], 16
  assert_eq asn1.unmarshal_str(hx("130474657374")).unwrap[0], "test"
  assert_eq asn1.unmarshal_str(hx("160474657374")).unwrap[0], "test"
  # Ampersand is allowed in PrintableString due to mistakes by major CAs.
  assert_eq asn1.unmarshal_str(hx("13057465737426")).unwrap[0], "test&"
  assert_eq asn1.unmarshal_raw(hx("160474657374")).unwrap[0], asn1.RawValue.new(class: 0, tag: 22, is_compound: false, bytes: "test".bytes, full_bytes: hx("160474657374"))
  assert_eq asn1.unmarshal_raw(hx("040401020304")).unwrap[0], asn1.RawValue.new(class: 0, tag: 4, is_compound: false, bytes: [1, 2, 3, 4], full_bytes: hx("040401020304"))
  assert_eq TestContextSpecificTags.from_asn1(hx("3003810101")).unwrap[0].a, 1
  t2 = TestContextSpecificTags2.from_asn1(hx("3008a103020101020102")).unwrap[0]
  assert_eq (t2.a, t2.b), (1, 2)
  assert_eq TestContextSpecificTags3.from_asn1(hx("3003810140")).unwrap[0].s, "@"
  assert_eq asn1.unmarshal_bool(hx("010100")).unwrap[0], false
  assert_eq asn1.unmarshal_bool(hx("0101ff")).unwrap[0], true
  e = TestElementsAfterString.from_asn1(hx("300b1303666f6f020122020133")).unwrap[0]
  assert_eq (e.s, e.a, e.b), ("foo", 0x22, 0x33)
  assert_eq TestBigInt.from_asn1(hx("30050203123456")).unwrap[0].x, big.new_int(0x123456)
  assert_eq TestSet.from_asn1(hx("300b3109020101020102020103")).unwrap[0].ints, [1, 2, 3]
  assert_eq asn1.unmarshal_str(hx("120b3031323334353637383920")).unwrap[0], "0123456789 "
  assert_eq asn1.unmarshal_str(hx("1403bf613f")).unwrap[0], "¿a?"
}

test "Certificate" {
  # This is a minimal, self-signed certificate that should parse correctly.
  r = Certificate.from_asn1(hx(SELF_SIGNED_HEX))
  assert r.ok?, "#{r.err?.message}"
  cert, rest = r.unwrap
  assert_eq rest.size, 0
  assert cert == self_signed(), "bad result"
  # It doesn't marshal back to the same bytes (the test's types drop the
  # NULL parameters and the IA5String type), but it round-trips.
  assert Certificate.from_asn1(cert.to_asn1.unwrap).unwrap[0] == cert
}

test "CertificateWithNUL" {
  # This is the paypal NUL-hack certificate. It should fail to parse because
  # NUL isn't a permitted character in a PrintableString.
  assert !Certificate.from_asn1(hx(PAYPAL_NUL_HEX)).ok?, "Unmarshal succeeded, should not have"
}

test "RawStructs" {
  input = hx("3003020150")
  s, rest = RawStructTest.from_asn1(input).unwrap
  assert_eq rest.size, 0
  assert_eq s.a, 0x50
  assert_eq s.raw, input
}

test "StringSlice" {
  for test in [["foo", "bar"], ["foo", "\\bar"], ["foo", "\"bar\""], ["foo", "åäö"]] {
    bs = asn1.marshal_strs(test).unwrap
    res = asn1.unmarshal_strs(bs).unwrap[0]
    assert_eq res, test
  }
}

test "ExplicitTaggedTime" {
  # Test that a time.Time will match either tagUTCTime or
  # tagGeneralizedTime.
  data = [(hx("3011a00f170d3931303530363136343534305a"), time.date(1991, 5, 6, 16, 45, 40, 0, time.utc())), (hx("3017a00f181332303130303130323033303430352b30363037"), time.date(2010, 1, 2, 3, 4, 5, 0, time.fixed_zone("", 6 * 60 * 60 + 7 * 60)))]
  for d in data {
    in_, out = d
    got = ExplicitTaggedTimeTest.from_asn1(in_).unwrap[0]
    assert got.time == out
  }
}

test "ImplicitTaggedTime" {
  # An implicitly tagged time value, that happens to have an implicit tag
  # equal to a GENERALIZEDTIME, should still be parsed as a UTCTime.
  # (There's no "timeType" in fieldParameters to determine what type of
  # time should be expected when implicitly tagged.)
  der = hx("300f980d3931303530363136343534305a")
  result = ImplicitTaggedTimeTest.from_asn1(der).unwrap[0]
  assert result.time == time.date(1991, 5, 6, 16, 45, 40, 0, time.utc())
}

test "TruncatedExplicitTag" {
  # This crashed Unmarshal in the past. See #11154.
  der = [0x30.as_u8, 0x02, 0xa0, 0x30]
  assert !TruncatedExplicitTagTest.from_asn1(der).ok?, "Unmarshal returned without error"
}

test "UnmarshalInvalidUTF8" {
  data = Str.from_bytes([0x30, 0x05, 0x0c, 0x03, 0x61, 0xc9, 0x63]).bytes
  r = InvalidUTF8Test.from_asn1(data)
  assert !r.ok?, "Successfully unmarshaled invalid UTF-8 data"
  assert strings.contains(r.err?.message || "", "UTF")
}

test "MarshalNilValue" {
  assert !asn1.marshal_any(asn1.Any.Nil).ok?
  assert !AnyHolder.new.to_asn1.ok?
}

test "Null" {
  marshaled = asn1.marshal_raw(asn1.null_raw_value()).unwrap
  assert_eq marshaled, asn1.null_bytes()
  unmarshaled = asn1.unmarshal_raw(asn1.null_bytes()).unwrap[0]
  unmarshaled.full_bytes = []
  assert_eq unmarshaled, asn1.null_raw_value()
}

test "ExplicitTagRawValueStruct" {
  before = ExplicitTagRawValue.new(b: [1, 2, 3])
  der = before.to_asn1.unwrap
  after, rest = ExplicitTagRawValue.from_asn1(der).unwrap
  assert_eq rest.size, 0
  assert after == before, "DER: #{hs(der)}"
}

test "TaggedRawValue" {
  is_compound = 0x20
  tag = 5
  tests = [(false, [0x30, 3, asn1.TAG_INTEGER, 1, 1]), (true, [0x30, 3, (asn1.CLASS_CONTEXT_SPECIFIC << 6) | tag, 1, 1]), (true, [0x30, 3, (asn1.CLASS_CONTEXT_SPECIFIC << 6) | tag | is_compound, 1, 1]), (false, [0x30, 3, (asn1.CLASS_APPLICATION << 6) | tag | is_compound, 1, 1]), (false, [0x30, 3, (asn1.CLASS_PRIVATE << 6) | tag | is_compound, 1, 1])]
  for t in tests {
    should_match, ints = t
    der = ints.map { it.as_u8 }.to_a
    assert TaggedRawValue.from_asn1(der).ok? == should_match, hs(der)
    # An untagged RawValue should accept anything.
    assert UntaggedRawValue.from_asn1(der).ok?, hs(der)
  }
}

test "ImplicitTypeRoundtrip" {
  now = time.now().utc.truncate(time.second)
  a = Tagged.new(ia5: "ia5", printable: "printable", utf8: "utf8", numeric: "123 456", utc: now, generalized: now)
  enc = a.to_asn1.unwrap
  b = Tagged.from_asn1(enc).unwrap[0]
  assert b == a
  assert_eq b.utc.to_s, a.utc.to_s
}

test "ParsingMemoryConsumption" {
  # Craft a syntatically valid, but empty, ~10 MB DER bomb; parsing must
  # fail with a SyntaxError (Go also checks the allocation; alx has no
  # MemStats).
  der_bomb = [0x30.as_u8, 0x83, 0x98, 0x96, 0x80] + [0x30.as_u8; 10000000]
  r = Bomb.from_asn1(der_bomb)
  assert !r.ok?
  if e = r.err {
    case e {
      asn1.Asn1Error.Syntax(_) => nil
      _ => assert false, "want a SyntaxError, got #{e.message}"
    }
  }
}

# ---------------------------------------------------------------- Marshal

test "Marshal" {
  m = ->(r: ~[Byte]) -> Str { hs(r.unwrap) }
  assert_eq m.call(asn1.marshal_int(10)), "02010a"
  assert_eq m.call(asn1.marshal_int(127)), "02017f"
  assert_eq m.call(asn1.marshal_int(128)), "02020080"
  assert_eq m.call(asn1.marshal_int(-128)), "020180"
  assert_eq m.call(asn1.marshal_int(-129)), "0202ff7f"
  assert_eq m.call(IntStruct.new(a: 64).to_asn1), "3003020140"
  assert_eq m.call(BigIntStruct.new(a: big.new_int(0x123456)).to_asn1), "30050203123456"
  assert_eq m.call(TwoIntStruct.new(a: 64, b: 65).to_asn1), "3006020140020141"
  assert_eq m.call(NestedStruct.new(a: IntStruct.new(a: 127)).to_asn1), "3005300302017f"
  assert_eq m.call(asn1.marshal_bytes([1, 2, 3])), "0403010203"
  assert_eq m.call(ImplicitTagTest.new(a: 64).to_asn1), "3003850140"
  assert_eq m.call(ExplicitTagTest.new(a: 64).to_asn1), "3005a503020140"
  assert_eq m.call(FlagTest.new(a: true).to_asn1), "30028000"
  assert_eq m.call(FlagTest.new(a: false).to_asn1), "3000"
  assert_eq m.call(asn1.marshal_time(time.unix(0, 0).utc)), "170d3730303130313030303030305a"
  assert_eq m.call(asn1.marshal_time(time.unix(1258325776, 0).utc)), "170d3039313131353232353631365a"
  assert_eq m.call(asn1.marshal_time(time.unix(1258325776, 0).in_zone(pst()))), "17113039313131353134353631362d30383030"
  assert_eq m.call(asn1.marshal_time(far_future())), "180f32313030303430353132303130315a"
  assert_eq m.call(GeneralizedTimeTest.new(a: time.unix(1258325776, 0).utc).to_asn1), "3011180f32303039313131353232353631365a"
  assert_eq m.call(asn1.marshal_bit_string(asn1.BitString.new(bytes: [0x80], bit_length: 1))), "03020780"
  assert_eq m.call(asn1.marshal_bit_string(asn1.BitString.new(bytes: [0x81, 0xf0], bit_length: 12))), "03030481f0"
  assert_eq m.call(asn1.marshal_oid(asn1.oid([1, 2, 3, 4]))), "06032a0304"
  assert_eq m.call(asn1.marshal_oid(asn1.oid([1, 2, 840, 133549, 1, 1, 5]))), "06092a864888932d010105"
  assert_eq m.call(asn1.marshal_oid(asn1.oid([2, 100, 3]))), "0603813403"
  assert_eq m.call(asn1.marshal_str("test")), "130474657374"
  assert_eq m.call(asn1.marshal_str("x" * 127)), "137f" + "78" * 127
  assert_eq m.call(asn1.marshal_str("x" * 128)), "138180" + "78" * 128
  assert_eq m.call(Ia5StringTest.new(a: "test").to_asn1), "3006160474657374"
  assert_eq m.call(OptionalRawValueTest.new.to_asn1), "3000"
  assert_eq m.call(PrintableStringTest.new(a: "test").to_asn1), "3006130474657374"
  assert_eq m.call(PrintableStringTest.new(a: "test*").to_asn1), "30071305746573742a"
  assert_eq m.call(GenericStringTest.new(a: "test").to_asn1), "3006130474657374"
  assert_eq m.call(GenericStringTest.new(a: "test*").to_asn1), "30070c05746573742a"
  assert_eq m.call(GenericStringTest.new(a: "test&").to_asn1), "30070c057465737426"
  assert_eq m.call(RawContentsStruct.new(a: 64).to_asn1), "3003020140"
  assert_eq m.call(RawContentsStruct.new(raw: [0x30, 3, 1, 2, 3], a: 64).to_asn1), "3003010203"
  assert_eq m.call(asn1.marshal_raw(asn1.RawValue.new(tag: 1, class: 2, is_compound: false, bytes: [1, 2, 3]))), "8103010203"
  assert_eq m.call(TestSET.new(ints: [10]).to_asn1), "310302010a"
  assert_eq m.call(OmitEmptyTest.new(a: []).to_asn1), "3000"
  assert_eq m.call(OmitEmptyTest.new(a: ["1"]).to_asn1), "30053003130131"
  assert_eq m.call(asn1.marshal_str("Σ")), "0c02cea3"
  assert_eq m.call(DefaultTest.new(a: 0).to_asn1), "3003020100"
  assert_eq m.call(DefaultTest.new(a: 1).to_asn1), "3000"
  assert_eq m.call(DefaultTest.new(a: 2).to_asn1), "3003020102"
  assert_eq m.call(ApplicationTest.new(a: 1, b: 2).to_asn1), "30084001016103020102"
  assert_eq m.call(PrivateTest.new(a: 1, b: 2, c: 3, d: 4).to_asn1), "3011c00101e103020102df1f0103df81000104"
  assert_eq m.call(NumericStringTest.new(a: "1 9").to_asn1), "30051203312039"
}

test "MarshalWithParams" {
  assert_eq hs(IntStruct.new(a: 10).to_asn1_with_params("set").unwrap), "310302010a"
  assert_eq hs(IntStruct.new(a: 10).to_asn1_with_params("application").unwrap), "600302010a"
  assert_eq hs(asn1.marshal_with_params(IntStruct.new(a: 10), "private").unwrap), "e00302010a"
}

test "MarshalError" {
  e = ->(r: ~[Byte]) -> Str { r.err?.message || "" }
  # Go's bigIntStruct{nil}: no nil big.Int in alx; an absent big.Int? field
  # that isn't optional is simply omitted, so this checks the messages
  # of the other three.
  assert strings.contains(e.call(NumericStringTest.new(a: "a").to_asn1), "invalid character")
  assert strings.contains(e.call(Ia5StringTest.new(a: Str.from_bytes([0xb0])).to_asn1), "invalid character")
  assert strings.contains(e.call(PrintableStringTest.new(a: "!").to_asn1), "invalid character")
}

test "InvalidUTF8" {
  assert !asn1.marshal_str(Str.from_bytes([0xff, 0xff])).ok?, "invalid UTF8 string was accepted"
}

test "MarshalOID" {
  # bytes format returns a byte sequence \x04
  assert_eq hs(asn1.marshal_bytes([0x06, 0x01, 0x30]).unwrap), "0403060130"
  assert_eq hs(asn1.marshal_oid(asn1.oid([2, 999, 3])).unwrap), "0603883703"
  # zero OID
  assert_eq hs(asn1.marshal_oid(asn1.oid([0, 0])).unwrap), "060100"
}

test "Issue11130" {
  data = [0x06.as_u8, 0x01, 0x30]
  v = asn1.unmarshal_any(data).unwrap[0]
  case v {
    Oid(_) => nil
    _ => assert false, "marshal OID returned an invalid type"
  }
  data1 = asn1.marshal_any(v).unwrap
  assert_eq data1, data
  v1 = asn1.unmarshal_any(data1).unwrap[0]
  assert v1 == v
}

test "Issue68241" {
  for want in [false, true] {
    data = asn1.marshal_bool(want).unwrap
    got = asn1.unmarshal_any(data).unwrap[0]
    assert got == asn1.Any.Bool(want)
  }
}

test "SetEncoder" {
  test_struct = SetStrings.new(strings: ["a", "aa", "b", "bb", "c", "cc"])
  # Expected ordering of the SET should be: a, b, c, aa, bb, cc
  output = test_struct.to_asn1.unwrap
  result, rest = SetStrings.from_asn1(output).unwrap
  assert_eq rest.size, 0
  assert_eq result.strings, ["a", "b", "c", "aa", "bb", "cc"]
}

test "SetEncoderSETSliceSuffix" {
  test_set = TestSetSET.new(strs: ["a", "aa", "b", "bb", "c", "cc"])
  output = test_set.to_asn1.unwrap
  result, rest = TestSetSET.from_asn1(output).unwrap
  assert_eq rest.size, 0
  assert_eq result.strs, ["a", "b", "c", "aa", "bb", "cc"]
}

# ---------------------------------------------------------------- alx additions

test "optional big.Int" {
  assert_eq hs(OptBigIntStruct.new.to_asn1.unwrap), "3000"
  assert_eq hs(OptBigIntStruct.new(a: big.new_int(-1)).to_asn1.unwrap), "30030201ff"
  r = OptBigIntStruct.from_asn1(hx("3000")).unwrap[0]
  assert r.a.none?
  assert_eq OptBigIntStruct.from_asn1(hx("30030201ff")).unwrap[0].a, big.new_int(-1)
}

test "sized ints, enumerated, optionals, skip, nested lists" {
  x = Extras.new(small: -5, mid: 70000, e: 3, opt: "hi", opt2: 7, cache: 99, names: [["a", "b"], ["c"]])
  der = x.to_asn1.unwrap
  y = Extras.from_asn1(der).unwrap[0]
  assert_eq y.small, -5.as_i8
  assert_eq y.mid, 70000.as_i32
  assert_eq y.e, 3
  assert_eq y.opt, "hi"
  assert_eq y.opt2, 7
  assert_eq y.cache, 0
  assert_eq y.names, [["a", "b"], ["c"]]
  z = Extras.new(small: 1, names: [])
  w = Extras.from_asn1(z.to_asn1.unwrap).unwrap[0]
  assert w.opt.none?
  assert w.opt2.none?
  # An I8 out of range.
  assert !Extras.from_asn1(hx("3003020200ff")).ok?
}

test "tags don't match message" {
  r = IntStruct.from_asn1(hx("3003010100"))
  assert_eq r.err?.message || "", "asn1: structure error: tags don't match (2 vs {class:0 tag:1 length:1 isCompound:false}) {optional:false explicit:false application:false private:false defaultValue:<nil> tag:<nil> stringType:0 timeType:0 set:false omitEmpty:false} int @2"
}
