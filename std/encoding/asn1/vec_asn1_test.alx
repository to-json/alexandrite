  assert_eq unmarshal_oid(vx("060f0785d1f63e8c4a8d865582bed41600")).unwrap[0].to_s, "0.7.11828030.1610.213845.5220886.0"
  assert_eq vh(marshal_str("").unwrap), "1300"
  assert_eq vh(marshal_str_with_params("", "ia5").unwrap), "1600"
  assert_eq vh(marshal_str_with_params("", "printable").unwrap), "1300"
  assert_eq vh(marshal_str_with_params("", "utf8").unwrap), "0c00"
  assert_eq vh(marshal_str_with_params("", "numeric").unwrap), "1200"
  assert_eq vh(marshal_str("").unwrap), "1300"
  assert_eq vh(marshal_str_with_params("", "ia5").unwrap), "1600"
  assert_eq vh(marshal_str_with_params("", "printable").unwrap), "1300"
  assert_eq vh(marshal_str_with_params("", "utf8").unwrap), "0c00"
  assert_eq vh(marshal_str_with_params("", "numeric").unwrap), "1200"
  assert_eq vh(marshal_str("😀1 \u2028:").unwrap), "0c0af09f98803120e280a83a"
  assert !marshal_str_with_params("😀1 \u2028:", "ia5").ok?
  assert !marshal_str_with_params("😀1 \u2028:", "printable").ok?
  assert_eq vh(marshal_str_with_params("😀1 \u2028:", "utf8").unwrap), "0c0af09f98803120e280a83a"
  assert !marshal_str_with_params("😀1 \u2028:", "numeric").ok?
  assert_eq vh(marshal_str("&b\"").unwrap), "0c03266222"
  assert_eq vh(marshal_str_with_params("&b\"", "ia5").unwrap), "1603266222"
  assert !marshal_str_with_params("&b\"", "printable").ok?
  assert_eq vh(marshal_str_with_params("&b\"", "utf8").unwrap), "0c03266222"
  assert !marshal_str_with_params("&b\"", "numeric").ok?
  assert_eq vh(marshal_str("\u2028=aZ)9c").unwrap), "0c09e280a83d615a293963"
  assert !marshal_str_with_params("\u2028=aZ)9c", "ia5").ok?
  assert !marshal_str_with_params("\u2028=aZ)9c", "printable").ok?
  assert_eq vh(marshal_str_with_params("\u2028=aZ)9c", "utf8").unwrap), "0c09e280a83d615a293963"
  assert !marshal_str_with_params("\u2028=aZ)9c", "numeric").ok?
  assert_eq vh(marshal_str(":0").unwrap), "13023a30"
  assert_eq vh(marshal_str_with_params(":0", "ia5").unwrap), "16023a30"
  assert_eq vh(marshal_str_with_params(":0", "printable").unwrap), "13023a30"
  assert_eq vh(marshal_str_with_params(":0", "utf8").unwrap), "0c023a30"
  assert !marshal_str_with_params(":0", "numeric").ok?
  assert_eq vh(marshal_str("XYb\":").unwrap), "0c05585962223a"
  assert_eq vh(marshal_str_with_params("XYb\":", "ia5").unwrap), "1605585962223a"
  assert !marshal_str_with_params("XYb\":", "printable").ok?
  assert_eq vh(marshal_str_with_params("XYb\":", "utf8").unwrap), "0c05585962223a"
  assert !marshal_str_with_params("XYb\":", "numeric").ok?
  assert_eq vh(marshal_str("(:").unwrap), "1302283a"
  assert_eq vh(marshal_str_with_params("(:", "ia5").unwrap), "1602283a"
  assert_eq vh(marshal_str_with_params("(:", "printable").unwrap), "1302283a"
  assert_eq vh(marshal_str_with_params("(:", "utf8").unwrap), "0c02283a"
  assert !marshal_str_with_params("(:", "numeric").ok?
  assert_eq vh(marshal_str("b\"😀é-X**=\u2028").unwrap), "0c106222f09f9880c3a92d582a2a3de280a8"
  assert !marshal_str_with_params("b\"😀é-X**=\u2028", "ia5").ok?
  assert !marshal_str_with_params("b\"😀é-X**=\u2028", "printable").ok?
  assert_eq vh(marshal_str_with_params("b\"😀é-X**=\u2028", "utf8").unwrap), "0c106222f09f9880c3a92d582a2a3de280a8"
  assert !marshal_str_with_params("b\"😀é-X**=\u2028", "numeric").ok?
  assert_eq vh(marshal_str("(").unwrap), "130128"
}

test "vectors 8" {
  assert_eq vh(marshal_str_with_params("(", "ia5").unwrap), "160128"
  assert_eq vh(marshal_str_with_params("(", "printable").unwrap), "130128"
  assert_eq vh(marshal_str_with_params("(", "utf8").unwrap), "0c0128"
  assert !marshal_str_with_params("(", "numeric").ok?
  assert_eq vh(marshal_str("1😀X\u2028=+!/").unwrap), "0c0d31f09f988058e280a83d2b212f"
  assert !marshal_str_with_params("1😀X\u2028=+!/", "ia5").ok?
  assert !marshal_str_with_params("1😀X\u2028=+!/", "printable").ok?
  assert_eq vh(marshal_str_with_params("1😀X\u2028=+!/", "utf8").unwrap), "0c0d31f09f988058e280a83d2b212f"
  assert !marshal_str_with_params("1😀X\u2028=+!/", "numeric").ok?
  assert_eq vh(marshal_str("/1::!a&,Σ").unwrap), "0c0a2f313a3a2161262ccea3"
  assert !marshal_str_with_params("/1::!a&,Σ", "ia5").ok?
  assert !marshal_str_with_params("/1::!a&,Σ", "printable").ok?
  assert_eq vh(marshal_str_with_params("/1::!a&,Σ", "utf8").unwrap), "0c0a2f313a3a2161262ccea3"
  assert !marshal_str_with_params("/1::!a&,Σ", "numeric").ok?
  assert_eq vh(marshal_str("\u2028'").unwrap), "0c04e280a827"
  assert !marshal_str_with_params("\u2028'", "ia5").ok?
