# Generated from Go's encoding/base32 (go run): encodings of random bytes, decodings of corrupt input; do not edit by hand.
import "bytes"

def custom -> Encoding { new_encoding("abcdefghijklmnopqrstuvwxyz012345") }

def bs(xs: [Byte]) -> [Byte] { xs }

def chk_dec(enc: Encoding, s: Str, want: [Byte], err: Str) {
  r = enc.decode_string(s)
  if e = r.err {
    assert_eq e.message, err
    # decode leaves the bytes before the error in dst, as Go does.
    dst: [Byte] = [0; enc.decoded_len(s.size) + 8]
    assert enc.decode(dst, s.bytes.to_a).err?
    assert_eq dst[0...want.size], want
  } else {
    assert_eq err, ""
    assert_eq r.unwrap, want
  }
}

def chk_stream(enc: Encoding, chunks: [Str], size: Int, want: [Byte], err: Str) {
  res = drain(new_decoder(enc, chunk_reader(chunks)), size)
  assert_eq res[0], want
  assert_eq res[1], err
}

def chk_enc_stream(enc: Encoding, src: [Byte], chunk: Int, want: Str) {
  buf = bytes.new_buffer([])
  w = new_encoder(enc, buf)
  i = 0
  while i < src.size {
    j = i + chunk
    j = src.size if j > src.size
    assert_eq w.write!(src[i...j]).unwrap, j - i
    i = j
  }
  w.close!.unwrap
  assert_eq buf.to_s, want
}

test "vectors: encode_to_string / decode_string round trip 1" {
  assert_eq std_encoding.encode_to_string(bs([])), ""
  assert_eq std_encoding.decode_string("").unwrap, bs([])
  assert_eq hex_encoding.encode_to_string(bs([])), ""
  assert_eq hex_encoding.decode_string("").unwrap, bs([])
  assert_eq std_encoding.with_padding(NO_PADDING).encode_to_string(bs([])), ""
  assert_eq std_encoding.with_padding(NO_PADDING).decode_string("").unwrap, bs([])
  assert_eq hex_encoding.with_padding(NO_PADDING).encode_to_string(bs([])), ""
  assert_eq hex_encoding.with_padding(NO_PADDING).decode_string("").unwrap, bs([])
  assert_eq std_encoding.with_padding(64).encode_to_string(bs([])), ""
  assert_eq std_encoding.with_padding(64).decode_string("").unwrap, bs([])
  assert_eq custom.encode_to_string(bs([])), ""
  assert_eq custom.decode_string("").unwrap, bs([])
  assert_eq std_encoding.encode_to_string(bs([251])), "7M======"
  assert_eq std_encoding.decode_string("7M======").unwrap, bs([251])
  assert_eq hex_encoding.encode_to_string(bs([251])), "VC======"
  assert_eq hex_encoding.decode_string("VC======").unwrap, bs([251])
  assert_eq std_encoding.with_padding(NO_PADDING).encode_to_string(bs([251])), "7M"
  assert_eq std_encoding.with_padding(NO_PADDING).decode_string("7M").unwrap, bs([251])
  assert_eq hex_encoding.with_padding(NO_PADDING).encode_to_string(bs([251])), "VC"
  assert_eq hex_encoding.with_padding(NO_PADDING).decode_string("VC").unwrap, bs([251])
  assert_eq std_encoding.with_padding(64).encode_to_string(bs([251])), "7M@@@@@@"
  assert_eq std_encoding.with_padding(64).decode_string("7M@@@@@@").unwrap, bs([251])
  assert_eq custom.encode_to_string(bs([251])), "5m======"
  assert_eq custom.decode_string("5m======").unwrap, bs([251])
  assert_eq std_encoding.encode_to_string(bs([49, 73])), "GFEQ===="
  assert_eq std_encoding.decode_string("GFEQ====").unwrap, bs([49, 73])
  assert_eq hex_encoding.encode_to_string(bs([49, 73])), "654G===="
