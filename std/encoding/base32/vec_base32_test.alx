test "vectors: encode_to_string / decode_string round trip 2" {
  assert_eq std_encoding.with_padding(NO_PADDING).encode_to_string(bs([129, 143, 158, 139, 230, 200, 254, 212])), "QGHZ5C7GZD7NI"
  assert_eq std_encoding.with_padding(NO_PADDING).decode_string("QGHZ5C7GZD7NI").unwrap, bs([129, 143, 158, 139, 230, 200, 254, 212])
  assert_eq hex_encoding.with_padding(NO_PADDING).encode_to_string(bs([129, 143, 158, 139, 230, 200, 254, 212])), "G67PT2V6P3VD8"
  assert_eq hex_encoding.with_padding(NO_PADDING).decode_string("G67PT2V6P3VD8").unwrap, bs([129, 143, 158, 139, 230, 200, 254, 212])
  assert_eq std_encoding.with_padding(64).encode_to_string(bs([129, 143, 158, 139, 230, 200, 254, 212])), "QGHZ5C7GZD7NI@@@"
  assert_eq std_encoding.with_padding(64).decode_string("QGHZ5C7GZD7NI@@@").unwrap, bs([129, 143, 158, 139, 230, 200, 254, 212])
  assert_eq custom.encode_to_string(bs([129, 143, 158, 139, 230, 200, 254, 212])), "qghz3c5gzd5ni==="
  assert_eq custom.decode_string("qghz3c5gzd5ni===").unwrap, bs([129, 143, 158, 139, 230, 200, 254, 212])
  assert_eq std_encoding.encode_to_string(bs([213, 165, 34, 239, 1, 218, 123, 64, 153])), "2WSSF3YB3J5UBGI="
  assert_eq std_encoding.decode_string("2WSSF3YB3J5UBGI=").unwrap, bs([213, 165, 34, 239, 1, 218, 123, 64, 153])
