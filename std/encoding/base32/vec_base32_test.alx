test "vectors: encode_to_string / decode_string round trip 5" {
  assert_eq std_encoding.with_padding(NO_PADDING).encode_to_string(bs([118, 30, 182, 114, 244, 63])), "OYPLM4XUH4"
  assert_eq std_encoding.with_padding(NO_PADDING).decode_string("OYPLM4XUH4").unwrap, bs([118, 30, 182, 114, 244, 63])
  assert_eq hex_encoding.with_padding(NO_PADDING).encode_to_string(bs([118, 30, 182, 114, 244, 63])), "EOFBCSNK7S"
  assert_eq hex_encoding.with_padding(NO_PADDING).decode_string("EOFBCSNK7S").unwrap, bs([118, 30, 182, 114, 244, 63])
  assert_eq std_encoding.with_padding(64).encode_to_string(bs([118, 30, 182, 114, 244, 63])), "OYPLM4XUH4@@@@@@"
  assert_eq std_encoding.with_padding(64).decode_string("OYPLM4XUH4@@@@@@").unwrap, bs([118, 30, 182, 114, 244, 63])
  assert_eq std_encoding.encode_to_string(bs([112, 185, 248, 25, 180, 58])), "OC47QGNUHI======"
  assert_eq std_encoding.decode_string("OC47QGNUHI======").unwrap, bs([112, 185, 248, 25, 180, 58])
  assert_eq std_encoding.with_padding(64).encode_to_string(bs([112, 185, 248, 25, 180, 58])), "OC47QGNUHI@@@@@@"
  assert_eq std_encoding.with_padding(64).decode_string("OC47QGNUHI@@@@@@").unwrap, bs([112, 185, 248, 25, 180, 58])
