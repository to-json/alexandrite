# Package base64: Go's encoding/base64 — base64 encoding as in RFC 4648.
#
#   Go                                        alx
#   StdEncoding, URLEncoding                  std_encoding, url_encoding
#   RawStdEncoding, RawURLEncoding            raw_std_encoding, raw_url_encoding
#   NewEncoding(alphabet) *Encoding           new_encoding(alphabet) -> Encoding
#   enc.WithPadding(r) / enc.Strict()         enc.with_padding(r) / enc.strict
#   StdPadding, NoPadding                     STD_PADDING, NO_PADDING
#   enc.EncodedLen(n) / enc.DecodedLen(n)     enc.encoded_len(n) / enc.decoded_len(n)
#   enc.Encode(dst, src)                      enc.encode(dst, src)
#   enc.AppendEncode(dst, src) []byte         enc.append_encode(dst, src) -> [Byte]
#   enc.EncodeToString(src) string            enc.encode_to_string(src) -> Str
#   enc.Decode(dst, src) (int, error)         enc.decode(dst, src) -> ~Int<Base64Error>
#   enc.AppendDecode(dst, src)                enc.append_decode(dst, src) -> ~[Byte]<Base64Error>
#   enc.DecodeString(s) ([]byte, error)       enc.decode_string(s) -> ~[Byte]<Base64Error>
#   NewEncoder(enc, w) io.WriteCloser         new_encoder(enc, w) -> Encoder[W]  (write!, close!)
#   NewDecoder(enc, r) io.Reader              new_decoder(enc, r) -> Decoder[R]  (read!)
#   CorruptInputError(off)                    Base64Error.CorruptInput(offset)
#
# Messages are Go's ("illegal base64 data at input byte 4").
#
# Differences from Go:
#  - The predefined encodings are functions (alx constants are compile-time
#    values), and an Encoding is a value, not a pointer: with_padding and
#    strict return a modified copy, as Go's do.
#  - A padding character is a Rune; NO_PADDING is -1. Invalid alphabets and
#    paddings panic with Go's messages.
#  - A `~T` carries a value or an error, not both: on corrupt input Go's
#    Decode / DecodeString also return the bytes decoded before the error;
#    alx returns only the error. `decode` has already written those bytes
#    into dst, as Go's does.
#  - Encoder and Decoder are generic over what they wrap (an alx interface
#    value contains its implementors, so a type can't both hold an io.Writer
#    and be one): any writer / reader works, including another Encoder /
#    Decoder or an io.Writer / io.Reader value. They are io.Writer /
#    io.Reader themselves, except one wrapping an io.Writer / io.Reader
#    value (it would contain itself): use its methods directly. They share
#    their state across copies (D36): make them with the constructors.
#  - The Decoder follows io's shape: `read!` returns 0 at the end of the
#    input, and a truncated input fails with io.StreamError.UnexpectedEof.
#    Where Go returns bytes together with an error, `read!` returns the bytes
#    and fails on the next call. Errors (of the input or the data) repeat.
#  - Encoder.write! writes all of p or fails (io.Writer's contract in alx);
#    close! flushes a partial block and must be called.

import "io"

pub STD_PADDING = 61 # '='
pub NO_PADDING = -1

pub error Base64Error {
  # The input isn't valid base64; `offset` is the byte where it goes wrong
  # (Go's CorruptInputError).
  CorruptInput(offset: Int)

  def message -> Str {
    case self {
      CorruptInput(off) => "illegal base64 data at input byte #{off}"
    }
  }
}

def zeros(n: Int) -> [Byte] {
  b: [Byte] = [0; n]
  b
}

# A radix 64 encoding/decoding scheme, defined by a 64-character alphabet.
pub struct Encoding {
  # The alphabet: symbol index to symbol byte.
  alphabet: Str
  # Symbol byte to index, 255 for bytes outside the alphabet.
  decode_map: [Byte]
  pad_char: Int
  strict_mode: Bool

  # A copy of the encoding using `padding` (a byte value, or NO_PADDING). It
  # must not be "\r", "\n", above 0xff, or in the alphabet.
  pub def with_padding(padding: Int) -> Encoding {
    if padding < NO_PADDING || padding == 13 || padding == 10 || padding > 0xff {
      panic "invalid padding"
    }
    if padding != NO_PADDING && decode_map[padding] != 255 {
      panic "padding contained in alphabet"
    }
    e = self
    e.pad_char = padding
    e
  }

  # A copy of the encoding in strict decoding mode: the trailing padding bits
  # must be zero (RFC 4648 section 3.5). Newlines are still ignored.
  pub def strict -> Encoding {
    e = self
    e.strict_mode = true
    e
  }

  # The padding character (NO_PADDING for none).
  pub def padding -> Int { pad_char }

  # Encodes src into encoded_len(src.size) bytes of dst. Unpadded and padded
  # encodings fill dst the same, except for the padding.
  pub def encode(dst: [Byte], src: [Byte]) {
    return if src.size == 0
    a = alphabet
    si = 0
    di = 0
    n = (src.size / 3) * 3
    while si < n {
      val = (src[si].to_i << 16) | (src[si + 1].to_i << 8) | src[si + 2].to_i
      dst[di] = a[(val >> 18) & 0x3f]
      dst[di + 1] = a[(val >> 12) & 0x3f]
      dst[di + 2] = a[(val >> 6) & 0x3f]
      dst[di + 3] = a[val & 0x3f]
      si += 3
      di += 4
    }
    remain = src.size - si
    return if remain == 0
    val = src[si].to_i << 16
    val |= src[si + 1].to_i << 8 if remain == 2
    dst[di] = a[(val >> 18) & 0x3f]
    dst[di + 1] = a[(val >> 12) & 0x3f]
    if remain == 2 {
      dst[di + 2] = a[(val >> 6) & 0x3f]
      dst[di + 3] = pad_char.as_u8 if pad_char != NO_PADDING
    } else if pad_char != NO_PADDING {
      dst[di + 2] = pad_char.as_u8
      dst[di + 3] = pad_char.as_u8
    }
  }

  # Appends the encoding of src to dst and returns the result.
  pub def append_encode(dst: [Byte], src: [Byte]) -> [Byte] {
    buf = zeros(encoded_len(src.size))
    encode(buf, src)
    dst + buf
  }

  # The base64 encoding of src.
  pub def encode_to_string(src: [Byte]) -> Str {
    buf = zeros(encoded_len(src.size))
    encode(buf, src)
    Str.from_bytes(buf)
  }

  # The length in bytes of the encoding of n source bytes.
  pub def encoded_len(n: Int) -> Int {
    return (n / 3) * 4 + ((n % 3) * 8 + 5) / 6 if pad_char == NO_PADDING
    ((n + 2) / 3) * 4
  }

  # The largest length in bytes of the decoding of n bytes of base64 data.
  pub def decoded_len(n: Int) -> Int { decoded_len_pad(n, pad_char) }

  # Decodes one quantum (up to 4 symbols) of src from si into dst: (new si,
  # bytes written, error offset or -1). Newlines are skipped.
  def decode_quantum(dst: [Byte], src: [Byte], si0: Int) -> (Int, Int, Int) {
    si = si0
    dbuf: [Int] = [0, 0, 0, 0]
    dlen = 4
    err = -1
    j = 0
    while j < 4 {
      if src.size == si {
        return (si, 0, -1) if j == 0
        return (si, 0, si - j) if j == 1 || pad_char != NO_PADDING
        dlen = j
        break
      }
      c = src[si]
      si += 1
      out = decode_map[c.to_i]
      if out != 255 {
        dbuf[j] = out.to_i
        j += 1
        next
      }
      next if c == 10 || c == 13
      return (si, 0, si - 1) if c.to_i != pad_char
      # We've reached the end and there's padding.
      return (si, 0, si - 1) if j < 2 # incorrect padding
      if j == 2 {
        # "==" is expected; the first "=" is already consumed. Skip newlines.
        while si < src.size && (src[si] == 10 || src[si] == 13) {
          si += 1
        }
        return (si, 0, src.size) if si == src.size         # not enough padding
        return (si, 0, si - 1) if src[si].to_i != pad_char # incorrect padding
        si += 1
      }
      # Skip over newlines.
      while si < src.size && (src[si] == 10 || src[si] == 13) {
        si += 1
      }
      err = si if si < src.size # trailing garbage
      dlen = j
      break
    }
    # Convert 4x 6-bit source bytes into 3 bytes.
    val = (dbuf[0] << 18) | (dbuf[1] << 12) | (dbuf[2] << 6) | dbuf[3]
    b0 = (val >> 16) & 0xff
    b1 = (val >> 8) & 0xff
    b2 = val & 0xff
    if dlen == 4 {
      dst[2] = b2.as_u8
      b2 = 0
    }
    if dlen >= 3 {
      dst[1] = b1.as_u8
      return (si, 0, si - 1) if strict_mode && b2 != 0
      b1 = 0
    }
    if dlen >= 2 {
      dst[0] = b0.as_u8
      return (si, 0, si - 2) if strict_mode && (b1 != 0 || b2 != 0)
    }
    (si, dlen - 1, err)
  }

  # Decodes src into dst: (bytes written, error offset or -1).
  def decode_core(dst: [Byte], src: [Byte]) -> (Int, Int) {
    n = 0
    si = 0
    while si < src.size {
      q = decode_quantum(dst[n...dst.size], src, si)
      si = q[0]
      n += q[1]
      return (n, q[2]) if q[2] >= 0
    }
    (n, -1)
  }

  # Decodes src into dst (which needs decoded_len(src.size) bytes); returns
  # the number of bytes written. Newlines ("\r", "\n") are ignored. On
  # corrupt input the bytes before the error are already in dst.
  pub def decode(dst: [Byte], src: [Byte]) -> ~Int<Base64Error> {
    r = decode_core(dst, src)
    fail Base64Error.CorruptInput(offset: r[1]) if r[1] >= 0
    r[0]
  }

  # Appends the decoding of src to dst and returns the result.
  pub def append_decode(dst: [Byte], src: [Byte]) -> ~[Byte]<Base64Error> {
    buf = zeros(decoded_len_pad(src.size, NO_PADDING))
    r = decode_core(buf, src)
    fail Base64Error.CorruptInput(offset: r[1]) if r[1] >= 0
    dst + buf[0...r[0]]
  }

  # The bytes represented by the base64 string s.
  pub def decode_string(s: Str) -> ~[Byte]<Base64Error> {
    buf = zeros(decoded_len(s.size))
    r = decode_core(buf, s.bytes.to_a)
    fail Base64Error.CorruptInput(offset: r[1]) if r[1] >= 0
    buf[0...r[0]]
  }
}

def decoded_len_pad(n: Int, pad_char: Int) -> Int {
  # Unpadded data may end with a partial quantum.
  return (n / 4) * 3 + ((n % 4) * 6) / 8 if pad_char == NO_PADDING
  # Padded base64 always has whole quanta.
  (n / 4) * 3
}

# A new padded Encoding defined by the 64-byte alphabet, which must not
# contain "\r", "\n" or duplicates.
pub def new_encoding(encoder: Str) -> Encoding {
  panic "encoding alphabet is not 64-bytes long" if encoder.size != 64
  dm: [Byte] = [255; 256]
  i = 0
  while i < 64 {
    c = encoder[i]
    panic "encoding alphabet contains newline character" if c == 10 || c == 13
    panic "encoding alphabet includes duplicate symbols" if dm[c.to_i] != 255
    dm[c.to_i] = i.as_u8
    i += 1
  }
  Encoding.new(alphabet: encoder, decode_map: dm, pad_char: STD_PADDING, strict_mode: false)
}

STD_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
URL_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

# The standard base64 encoding, as defined in RFC 4648.
pub def std_encoding -> Encoding { new_encoding(STD_ALPHABET) }

# The alternate base64 encoding defined in RFC 4648, used in URLs and file
# names.
pub def url_encoding -> Encoding { new_encoding(URL_ALPHABET) }

# The standard raw, unpadded base64 encoding (RFC 4648 section 3.2).
pub def raw_std_encoding -> Encoding { std_encoding.with_padding(NO_PADDING) }

# The unpadded alternate base64 encoding, for URLs and file names.
pub def raw_url_encoding -> Encoding { url_encoding.with_padding(NO_PADDING) }

# ------------------------------------------------------------------ Encoder

struct EncoderState[W] {
  enc: Encoding
  w: W
  err: Error?
  # Buffered data waiting to be encoded.
  buf: [Byte]
  nbuf: Int
  # Output buffer.
  out: [Byte]
}

# An io.WriteCloser encoding what is written to it into W.
pub struct Encoder[W] {
  st: [EncoderState[W]]

  # A write to W, as a Result whether or not W's write! can fail.
  def put!(p: [Byte]) -> ~Int { self.st[0].w.~write!(p) }

  # Writes p through, or records and fails with W's error.
  def emit!(p: [Byte]) -> ~Unit {
    r = put!(p)
    if e = r.err {
      self.st[0].err = e
      fail e
    }
  }

  # Encodes all of p; returns p.size. A partial block waits for more input
  # or close!.
  pub def write!(p0: [Byte]) -> ~Int {
    if e = st[0].err {
      fail e
    }
    enc = st[0].enc
    p = p0
    # Leading fringe.
    if st[0].nbuf > 0 {
      i = 0
      while i < p.size && st[0].nbuf < 3 {
        self.st[0].buf[st[0].nbuf] = p[i]
        self.st[0].nbuf += 1
        i += 1
      }
      p = p[i...p.size]
      return p0.size if st[0].nbuf < 3
      enc.encode(st[0].out, st[0].buf)
      ~emit!(st[0].out[0...4])
      self.st[0].nbuf = 0
    }
    # Large interior chunks.
    while p.size >= 3 {
      nn = (st[0].out.size / 4) * 3
      if nn > p.size {
        nn = p.size
        nn -= nn % 3
      }
      enc.encode(st[0].out, p[0...nn])
      ~emit!(st[0].out[0...(nn / 3) * 4])
      p = p[nn...p.size]
    }
    # Trailing fringe.
    copy(st[0].buf, p)
    self.st[0].nbuf = p.size
    p0.size
  }

  # Flushes any partial block (with padding, if the encoding has it). Call
  # it when done; later writes are an error only if one already failed.
  pub def close! -> ~Unit {
    if e = st[0].err {
      fail e
    }
    if st[0].nbuf > 0 {
      enc = st[0].enc
      enc.encode(st[0].out, st[0].buf[0...st[0].nbuf])
      n = enc.encoded_len(st[0].nbuf)
      self.st[0].nbuf = 0
      ~emit!(st[0].out[0...n])
    }
  }
}

# A base64 encoder writing to w. Data is written in blocks of 4 bytes, so
# close! the encoder to flush the last partial block.
pub def new_encoder[W](enc: Encoding, w: W) -> Encoder[W] {
  Encoder.new(st: [EncoderState.new(enc: enc, w: w, err: none, buf: zeros(3), nbuf: 0, out: zeros(1024))])
}

# ------------------------------------------------------------------ Decoder

struct DecoderState[R] {
  enc: Encoding
  r: R
  # Sticky failure of the decoder, or the end of its output.
  err: Error?
  eof: Bool
  # What the input reported: a failure, or its end.
  read_err: Error?
  read_eof: Bool
  # Leftover input.
  buf: [Byte]
  nbuf: Int
  # Leftover decoded output (a slice of outbuf).
  out: [Byte]
  outbuf: [Byte]
}

# An io.Reader decoding the base64 read from R.
pub struct Decoder[R] {
  st: [DecoderState[R]]

  # A read from R, as a Result whether or not R's read! can fail.
  def get!(p: [Byte]) -> ~Int { self.st[0].r.~read!(p) }

  # Reads from R with "\r" and "\n" dropped; 0 only at the end of R.
  def read_filtered!(p: [Byte]) -> ~Int {
    loop {
      n = ~get!(p)
      return 0 if n == 0
      off = 0
      i = 0
      while i < n {
        c = p[i]
        if c != 13 && c != 10 {
          p[off] = c
          off += 1
        }
        i += 1
      }
      return off if off > 0
    }
    0
  }

  # Decodes into p; returns the count, 0 at the end of the input.
  pub def read!(p: [Byte]) -> ~Int {
    return 0 if p.size == 0
    loop {
      # Use leftover decoded output from the last read.
      if st[0].out.size > 0 {
        n = copy(p, st[0].out)
        self.st[0].out = st[0].out[n...st[0].out.size]
        return n
      }
      if e = st[0].err {
        fail e
      }
      return 0 if st[0].eof
      enc = st[0].enc
      # Read a chunk: at least one quantum, if the input has it.
      while st[0].nbuf < 4 && st[0].read_err.none? && !st[0].read_eof {
        nn = (p.size / 3) * 4
        nn = 4 if nn < 4
        nn = st[0].buf.size if nn > st[0].buf.size
        r = read_filtered!(st[0].buf[st[0].nbuf...nn])
        if e = r.err {
          self.st[0].read_err = e
        } else {
          got = r.unwrap
          self.st[0].read_eof = true if got == 0
          self.st[0].nbuf += got
        }
      }
      if st[0].nbuf < 4 {
        if enc.pad_char == NO_PADDING && st[0].nbuf > 0 {
          # Decode the final fragment of unpadded input.
          res = enc.decode_core(st[0].outbuf, st[0].buf[0...st[0].nbuf])
          self.st[0].nbuf = 0
          self.st[0].out = st[0].outbuf[0...res[0]]
          self.st[0].err = Base64Error.CorruptInput(offset: res[1]) if res[1] >= 0
          next
        }
        if e = st[0].read_err {
          self.st[0].err = e
          fail e
        }
        if st[0].nbuf > 0 {
          self.st[0].err = io.StreamError.UnexpectedEof
          fail io.StreamError.UnexpectedEof
        }
        self.st[0].eof = true
        return 0
      }
      # Decode whole quanta.
      nr = (st[0].nbuf / 4) * 4
      nw = (st[0].nbuf / 4) * 3
      n = 0
      res = (0, -1)
      if nw > p.size {
        res = enc.decode_core(st[0].outbuf, st[0].buf[0...nr])
        self.st[0].out = st[0].outbuf[0...res[0]]
        n = copy(p, st[0].out)
        self.st[0].out = st[0].out[n...st[0].out.size]
      } else {
        res = enc.decode_core(p, st[0].buf[0...nr])
        n = res[0]
      }
      self.st[0].err = Base64Error.CorruptInput(offset: res[1]) if res[1] >= 0
      left = st[0].nbuf - nr
      copy(st[0].buf[0...left], st[0].buf[nr...st[0].nbuf])
      self.st[0].nbuf = left
      return n if n > 0
    }
    0
  }
}

# A streaming base64 decoder reading from r. Newlines in the input are
# ignored.
pub def new_decoder[R](enc: Encoding, r: R) -> Decoder[R] {
  Decoder[R].new(st: [DecoderState[R].new(enc: enc, r: r, err: none, eof: false, read_err: none, read_eof: false, buf: zeros(1024), nbuf: 0, out: [], outbuf: zeros(768))])
}
