test "vectors: encode_to_string / decode_string round trip 6" {
  assert_eq url_encoding.encode_to_string(bs([248, 247, 186])), "-Pe6"
  assert_eq url_encoding.decode_string("-Pe6").unwrap, bs([248, 247, 186])
  assert_eq raw_std_encoding.encode_to_string(bs([248, 247, 186])), "+Pe6"
  assert_eq raw_std_encoding.decode_string("+Pe6").unwrap, bs([248, 247, 186])
  assert_eq raw_std_encoding.strict.encode_to_string(bs([248, 247, 186])), "+Pe6"
  assert_eq raw_std_encoding.strict.decode_string("+Pe6").unwrap, bs([248, 247, 186])
  assert_eq raw_url_encoding.encode_to_string(bs([74, 174, 86, 107, 175, 82, 184, 142, 202, 147, 201, 237, 134, 20, 22, 195, 5, 34, 10])), "Sq5Wa69SuI7Kk8nthhQWwwUiCg"
