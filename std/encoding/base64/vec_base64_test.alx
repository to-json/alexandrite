test "vectors: decode_string of corrupt input 1" {
  chk_dec(std_encoding, "N=CM-._Z/", bs([]), "illegal base64 data at input byte 1")
  chk_dec(std_encoding.strict, "N=CM-._Z/", bs([]), "illegal base64 data at input byte 1")
  chk_dec(raw_std_encoding.strict, "N=CM-._Z/", bs([]), "illegal base64 data at input byte 1")
  chk_dec(funny, "N=CM-._Z/", bs([]), "illegal base64 data at input byte 1")
  chk_dec(custom, "N=CM-._Z/", bs([]), "illegal base64 data at input byte 1")
  chk_dec(raw_std_encoding, "KTqvLl", bs([41, 58, 175, 46]), "")
  chk_dec(std_encoding.strict, "KTqvLl", bs([41, 58, 175]), "illegal base64 data at input byte 4")
  chk_dec(raw_std_encoding.strict, "KTqvLl", bs([41, 58, 175]), "illegal base64 data at input byte 4")
  chk_dec(funny, "KTqvLl", bs([41, 58, 175]), "illegal base64 data at input byte 4")
  chk_dec(custom, "KTqvLl", bs([89, 253, 187]), "illegal base64 data at input byte 4")
  chk_dec(custom.with_padding(NO_PADDING), "KTqvLl", bs([89, 253, 187, 95]), "")
  chk_dec(url_encoding, "", bs([]), "")
  chk_dec(std_encoding.strict, "", bs([]), "")
  chk_dec(raw_std_encoding.strict, "", bs([]), "")
  chk_dec(std_encoding, "=dePcf9Vj=U", bs([]), "illegal base64 data at input byte 0")
