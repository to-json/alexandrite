test "vectors: encode_to_string / decode_string round trip 10" {
  assert_eq custom.with_padding(NO_PADDING).encode_to_string(bs([201, 229, 55, 25, 34, 221, 29, 174, 2, 22, 96, 36, 145, 136, 240, 138, 129, 8, 133, 153, 213, 208, 69, 205, 217, 118, 0, 90, 252, 9, 54, 53, 160, 4, 238, 146, 186, 134, 41, 84, 35, 36, 234, 19, 180, 146])), "mSIr4G9R5Os03a.YYMXkWc26VNbJo2LBqLM.Kjk7BXKU/CuGicMdJ0AYuVCoYU"
