# Generated from Go's encoding/base64 (go run): encodings of random bytes, decodings of corrupt input; do not edit by hand.
import "bytes"
import "io"

def funny -> Encoding { new_encoding("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/").with_padding(64) }
def custom -> Encoding { new_encoding("./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz") }

def chk_dec(enc: Encoding, s: Str, want: [Byte], err: Str) {
  r = enc.decode_string(s)
  if e = r.err {
    assert_eq e.message, err
    # decode leaves the bytes before the error in dst, as Go does.
    dst: [Byte] = [0; enc.decoded_len(s.size) + 8]
    assert enc.decode(dst, s.bytes.to_a).err?
    assert_eq dst[0...want.size], want
  } else {
    assert_eq err, ""
    assert_eq r.unwrap, want
  }
}

def chk_stream(enc: Encoding, chunks: [Str], chunk: Int, want: [Byte], err: Str) {
  d = new_decoder(enc, chunk_reader(chunks))
  out: [Byte] = []
  p: [Byte] = [0; chunk]
  msg = ""
  loop {
    r = d.read!(p)
    if e = r.err {
      msg = e.message
      break
    }
    n = r.unwrap
    break if n == 0
    out = out + p[0...n]
  }
  assert_eq out, want
  assert_eq msg, err
}

def chk_enc_stream(enc: Encoding, src: [Byte], chunk: Int, want: Str) {
  buf = bytes.new_buffer([])
  w = new_encoder(enc, buf)
  i = 0
  while i < src.size {
    j = i + chunk
    j = src.size if j > src.size
    assert_eq w.write!(src[i...j]).unwrap, j - i
    i = j
  }
  w.close!.unwrap
  assert_eq buf.to_s, want
}

test "vectors: encode_to_string / decode_string round trip 1" {
  assert_eq std_encoding.encode_to_string(bs([])), ""
  assert_eq std_encoding.decode_string("").unwrap, bs([])
  assert_eq url_encoding.encode_to_string(bs([])), ""
