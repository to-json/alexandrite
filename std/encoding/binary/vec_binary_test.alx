# Generated from Go's encoding/binary (go run): byte orders, varints, slices of fixed-size values; do not edit by hand.
import "bytes"
import "math"

def chk_put(order: ByteOrder, v: U64, b16: [Byte], b32: [Byte], b64: [Byte]) {
  buf: [Byte] = [0; 8]
  order.put_uint16(buf, v.as_u16)
  assert_eq buf[0...2], b16
  assert_eq order.uint16(b16), v.as_u16
  order.put_uint32(buf, v.as_u32)
  assert_eq buf[0...4], b32
  assert_eq order.uint32(b32), v.as_u32
  order.put_uint64(buf, v)
  assert_eq buf, b64
  assert_eq order.uint64(b64), v
  lead: [Byte] = [9]
  assert_eq order.append_uint16(lead, v.as_u16), lead + b16
  assert_eq order.append_uint32(lead, v.as_u32), lead + b32
  assert_eq order.append_uint64(lead, v), lead + b64
}

def chk_uvarint(x: U64, enc: [Byte]) {
  buf: [Byte] = [0; MAX_VARINT_LEN64]
  n = put_uvarint(buf, x)
  assert_eq buf[0...n], enc
  assert_eq append_uvarint([], x), enc
  assert_eq uvarint(enc), (x, enc.size)
}

def chk_varint(x: Int, enc: [Byte]) {
  buf: [Byte] = [0; MAX_VARINT_LEN64]
  n = put_varint(buf, x)
  assert_eq buf[0...n], enc
  assert_eq append_varint([], x), enc
  assert_eq varint(enc), (x, enc.size)
}

# uvarint / varint of arbitrary bytes, and read_uvarint ("" = none, else the
# error message) with how many bytes it consumed.
def chk_dec(b: [Byte], ux: U64, un: Int, x: Int, n: Int, rx: U64, rerr: Str, consumed: Int) {
  assert_eq uvarint(b), (ux, un)
  assert_eq varint(b), (x, n)
  rd = bytes.new_buffer(b)
  res = read_uvarint(rd)
  if e = res.err {
    assert_eq e.message, rerr
  } else if v = res.unwrap {
    assert_eq rerr, ""
    assert_eq v, rx
  } else {
    assert_eq rerr, "none"
  }
  assert_eq b.size - rd.size, consumed
}

def chk_data(order: ByteOrder, d: Data, want: [Byte], z: Data) {
  assert_eq size(d), want.size
  assert_eq append([], order, d), want
  buf: [Byte] = [0; want.size]
  assert_eq encode(buf, order, d).unwrap, want.size
  assert_eq buf, want
  assert_eq decode(want, order, z).unwrap, want.size
  assert_eq show(z), show(d)
}

