  chk_dec(bs([161, 154, 245, 134, 162, 21, 255, 35, 255, 130]), 730695814433, 6, -365347907217, 6, 730695814433, "", 6)
  chk_dec(bs([167, 255]), 0, 0, 0, 0, 16295, "unexpected EOF", 2)
  chk_dec(bs([178, 232, 206, 100, 137, 255]), 211006514, 4, 105503257, 4, 211006514, "", 4)
  chk_dec(bs([153, 87, 161, 255, 255, 149]), 11161, 2, -5581, 2, 11161, "", 2)
}

test "vectors: decoding arbitrary bytes 4" {
  chk_dec(bs([184, 131, 255, 73, 255, 255, 45, 229, 223, 255]), 155173304, 4, 77586652, 4, 155173304, "", 4)
  chk_dec(bs([30, 255, 255, 245, 255, 255, 166, 220, 255, 255, 255, 243, 145]), 30, 1, 15, 1, 30, "", 1)
  chk_dec(bs([128, 190, 89, 255, 255, 255, 127, 232, 255, 46, 217, 236]), 1466112, 3, 733056, 3, 1466112, "", 3)
}

