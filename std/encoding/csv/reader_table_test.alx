# Go's readTests and writeTests (encoding/csv reader_test.go, writer_test.go),
# translated by a Go program (scratchpad/gencsv); do not edit by hand. The
# tests using them are in csv_test.alx. Errors: 0 none, 1 BareQuote,
# 2 Quote, 3 FieldCount, 4 InvalidDelim.

def read_tests -> [ReadTest] {
  t: [ReadTest] = []
  t << ReadTest.new(name: "Simple", input: "§a,§b,§c\n", output: [["a", "b", "c"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "CRLF", input: "§a,§b\r\n¶§c,§d\r\n", output: [["a", "b"], ["c", "d"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BareCR", input: "§a,§b\rc,§d\r\n", output: [["a", "b\rc", "d"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "RFC4180test", input: "§#field1,§field2,§field3\n¶§\"aaa\",§\"bb\nb\",§\"ccc\"\n¶§\"a,a\",§\"b\"\"bb\",§\"ccc\"\n¶§zzz,§yyy,§xxx\n", output: [["#field1", "field2", "field3"], ["aaa", "bb\nb", "ccc"], ["a,a", "b\"bb", "ccc"], ["zzz", "yyy", "xxx"]], errors: [], comma: 0, comment: 0, use_fields_per_record: true, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "NoEOLTest", input: "§a,§b,§c", output: [["a", "b", "c"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "Semicolon", input: "§a;§b;§c\n", output: [["a", "b", "c"]], errors: [], comma: 59, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "MultiLine", input: "§\"two\nline\",§\"one line\",§\"three\nline\nfield\"", output: [["two\nline", "one line", "three\nline\nfield"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BlankLine", input: "§a,§b,§c\n\n¶§d,§e,§f\n\n", output: [["a", "b", "c"], ["d", "e", "f"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BlankLineFieldCount", input: "§a,§b,§c\n\n¶§d,§e,§f\n\n", output: [["a", "b", "c"], ["d", "e", "f"]], errors: [], comma: 0, comment: 0, use_fields_per_record: true, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "TrimSpace", input: " §a,  §b,   §c\n", output: [["a", "b", "c"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: true, reuse_record: false)
  t << ReadTest.new(name: "LeadingSpace", input: "§ a,§  b,§   c\n", output: [[" a", "  b", "   c"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "Comment", input: "#1,2,3\n§a,§b,§c\n#comment", output: [["a", "b", "c"]], errors: [], comma: 0, comment: 35, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "NoComment", input: "§#1,§2,§3\n¶§a,§b,§c", output: [["#1", "2", "3"], ["a", "b", "c"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "LazyQuotes", input: "§a \"word\",§\"1\"2\",§a\",§\"b", output: [["a \"word\"", "1\"2", "a\"", "b"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: true, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BareQuotes", input: "§a \"word\",§\"1\"2\",§a\"", output: [["a \"word\"", "1\"2", "a\""]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: true, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BareDoubleQuotes", input: "§a\"\"b,§c", output: [["a\"\"b", "c"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: true, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadDoubleQuotes", input: "§a∑\"\"b,c", output: [], errors: [1], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "TrimQuote", input: " §\"a\",§\" b\",§c", output: [["a", " b", "c"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: true, reuse_record: false)
  t << ReadTest.new(name: "BadBareQuote", input: "§a ∑\"word\",\"b\"", output: [], errors: [1], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadTrailingQuote", input: "§\"a word\",b∑\"", output: [], errors: [1], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "ExtraneousQuote", input: "§\"a ∑\"word\",\"b\"", output: [], errors: [2], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadFieldCount", input: "§a,§b,§c\n¶∑§d,§e", output: [["a", "b", "c"], ["d", "e"]], errors: [0, 3], comma: 0, comment: 0, use_fields_per_record: true, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadFieldCountMultiple", input: "§a,§b,§c\n¶∑§d,§e\n¶∑§f", output: [["a", "b", "c"], ["d", "e"], ["f"]], errors: [0, 3, 3], comma: 0, comment: 0, use_fields_per_record: true, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadFieldCount1", input: "§∑a,§b,§c", output: [["a", "b", "c"]], errors: [3], comma: 0, comment: 0, use_fields_per_record: true, fields_per_record: 2, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "FieldCount", input: "§a,§b,§c\n¶§d,§e", output: [["a", "b", "c"], ["d", "e"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "TrailingCommaEOF", input: "§a,§b,§c,§", output: [["a", "b", "c", ""]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "TrailingCommaEOL", input: "§a,§b,§c,§\n", output: [["a", "b", "c", ""]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "TrailingCommaSpaceEOF", input: "§a,§b,§c, §", output: [["a", "b", "c", ""]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: true, reuse_record: false)
  t << ReadTest.new(name: "TrailingCommaSpaceEOL", input: "§a,§b,§c, §\n", output: [["a", "b", "c", ""]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: true, reuse_record: false)
  t << ReadTest.new(name: "TrailingCommaLine3", input: "§a,§b,§c\n¶§d,§e,§f\n¶§g,§hi,§", output: [["a", "b", "c"], ["d", "e", "f"], ["g", "hi", ""]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: true, reuse_record: false)
  t << ReadTest.new(name: "NotTrailingComma3", input: "§a,§b,§c,§ \n", output: [["a", "b", "c", " "]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "CommaFieldTest", input: "§x,§y,§z,§w\n¶§x,§y,§z,§\n¶§x,§y,§,§\n¶§x,§,§,§\n¶§,§,§,§\n¶§\"x\",§\"y\",§\"z\",§\"w\"\n¶§\"x\",§\"y\",§\"z\",§\"\"\n¶§\"x\",§\"y\",§\"\",§\"\"\n¶§\"x\",§\"\",§\"\",§\"\"\n¶§\"\",§\"\",§\"\",§\"\"\n", output: [["x", "y", "z", "w"], ["x", "y", "z", ""], ["x", "y", "", ""], ["x", "", "", ""], ["", "", "", ""], ["x", "y", "z", "w"], ["x", "y", "z", ""], ["x", "y", "", ""], ["x", "", "", ""], ["", "", "", ""]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "TrailingCommaIneffective1", input: "§a,§b,§\n¶§c,§d,§e", output: [["a", "b", ""], ["c", "d", "e"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: true, reuse_record: false)
  t << ReadTest.new(name: "ReadAllReuseRecord", input: "§a,§b\n¶§c,§d", output: [["a", "b"], ["c", "d"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: true)
  t << ReadTest.new(name: "StartLine1", input: "§a,\"b\nc∑\"d,e", output: [], errors: [2], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "StartLine2", input: "§a,§b\n¶§\"d\n\n,e∑", output: [["a", "b"]], errors: [0, 2], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "CRLFInQuotedField", input: "§A,§\"Hello\r\nHi\",§B\r\n", output: [["A", "Hello\nHi", "B"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BinaryBlobField", input: raw([194, 167, 120, 48, 57, 65, 180, 28, 44, 194, 167, 97, 107, 116, 97, 117]), output: [[raw([120, 48, 57, 65, 180, 28]), "aktau"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "TrailingCR", input: "§field1,§field2\r", output: [["field1", "field2"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "QuotedTrailingCR", input: "§\"field\"\r", output: [["field"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "QuotedTrailingCRCR", input: "§\"field∑\"\r\r", output: [], errors: [2], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "FieldCR", input: "§field\rfield\r", output: [["field\rfield"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "FieldCRCR", input: "§field\r\rfield\r\r", output: [["field\r\rfield\r"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "FieldCRCRLF", input: "§field\r\r\n¶§field\r\r\n", output: [["field\r"], ["field\r"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "FieldCRCRLFCR", input: "§field\r\r\n¶§\rfield\r\r\n\r", output: [["field\r"], ["\rfield\r"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "FieldCRCRLFCRCR", input: "§field\r\r\n¶§\r\rfield\r\r\n¶§\r\r", output: [["field\r"], ["\r\rfield\r"], ["\r"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "MultiFieldCRCRLFCRCR", input: "§field1,§field2\r\r\n¶§\r\rfield1,§field2\r\r\n¶§\r\r,§", output: [["field1", "field2\r"], ["\r\rfield1", "field2\r"], ["\r\r", ""]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "NonASCIICommaAndComment", input: "§a£§b,c£ \t§d,e\n€ comment\n", output: [["a", "b,c", "d,e"]], errors: [], comma: 163, comment: 8364, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: true, reuse_record: false)
  t << ReadTest.new(name: "NonASCIICommaAndCommentWithQuotes", input: "§a€§\"  b,\"€§ c\nλ comment\n", output: [["a", "  b,", " c"]], errors: [], comma: 8364, comment: 955, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "NonASCIICommaConfusion", input: "§\"abθcd\"λ§efθgh", output: [["abθcd", "efθgh"]], errors: [], comma: 955, comment: 8364, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "NonASCIICommentConfusion", input: "§λ\n¶§λ\nθ\n¶§λ\n", output: [["λ"], ["λ"], ["λ"]], errors: [], comma: 0, comment: 952, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "QuotedFieldMultipleLF", input: "§\"\n\n\n\n\"", output: [["\n\n\n\n"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "MultipleCRLF", input: "\r\n\r\n\r\n\r\n", output: [], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "HugeLines", input: strings.repeat("#ignore\n", 10000) + "§" + strings.repeat("@", 5000) + ",§" + strings.repeat("*", 5000), output: [[strings.repeat("@", 5000), strings.repeat("*", 5000)]], errors: [], comma: 0, comment: 35, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "QuoteWithTrailingCRLF", input: "§\"foo∑\"bar\"\r\n", output: [], errors: [2], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "LazyQuoteWithTrailingCRLF", input: "§\"foo\"bar\"\r\n", output: [["foo\"bar"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: true, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "DoubleQuoteWithTrailingCRLF", input: "§\"foo\"\"bar\"\r\n", output: [["foo\"bar"]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "EvenQuotes", input: "§\"\"\"\"\"\"\"\"", output: [["\"\"\""]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "OddQuotes", input: "§\"\"\"\"\"\"\"∑", output: [], errors: [2], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "LazyOddQuotes", input: "§\"\"\"\"\"\"\"", output: [["\"\"\""]], errors: [], comma: 0, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: true, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadComma1", input: "", output: [], errors: [4], comma: 10, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadComma2", input: "", output: [], errors: [4], comma: 13, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadComma3", input: "", output: [], errors: [4], comma: 34, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadComma4", input: "", output: [], errors: [4], comma: 65533, comment: 0, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadComment1", input: "", output: [], errors: [4], comma: 0, comment: 10, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadComment2", input: "", output: [], errors: [4], comma: 0, comment: 13, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadComment3", input: "", output: [], errors: [4], comma: 0, comment: 65533, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t << ReadTest.new(name: "BadCommaComment", input: "", output: [], errors: [4], comma: 88, comment: 88, use_fields_per_record: false, fields_per_record: 0, lazy_quotes: false, trim_leading_space: false, reuse_record: false)
  t
}

def write_tests -> [WriteTest] {
  t: [WriteTest] = []
  t << WriteTest.new(input: [["abc"]], output: "abc\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["abc"]], output: "abc\r\n", error: 0, use_crlf: true, comma: 0)
  t << WriteTest.new(input: [["\"abc\""]], output: "\"\"\"abc\"\"\"\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["a\"b"]], output: "\"a\"\"b\"\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["\"a\"b\""]], output: "\"\"\"a\"\"b\"\"\"\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [[" abc"]], output: "\" abc\"\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["abc,def"]], output: "\"abc,def\"\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["abc", "def"]], output: "abc,def\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["abc"], ["def"]], output: "abc\ndef\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["abc\ndef"]], output: "\"abc\ndef\"\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["abc\ndef"]], output: "\"abc\r\ndef\"\r\n", error: 0, use_crlf: true, comma: 0)
  t << WriteTest.new(input: [["abc\rdef"]], output: "\"abcdef\"\r\n", error: 0, use_crlf: true, comma: 0)
  t << WriteTest.new(input: [["abc\rdef"]], output: "\"abc\rdef\"\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [[""]], output: "\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["", ""]], output: ",\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["", "", ""]], output: ",,\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["", "", "a"]], output: ",,a\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["", "a", ""]], output: ",a,\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["", "a", "a"]], output: ",a,a\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["a", "", ""]], output: "a,,\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["a", "", "a"]], output: "a,,a\n", error: 0, use_crlf: false, comma: 0)
  t << WriteTest.new(input: [["a", "a", ""]], output: "a,a,\n", error: 0, use_crlf: false, comma: 0)
