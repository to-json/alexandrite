  assert_eq write_out([], 9, false), ""
  assert_eq write_out([["θé\rc", "éλ\n", "\n\" x y", "\t\r"]], 44, true), "\"θéc\",\"éλ\r\n\",\"\r\n\"\" x y\",\"\t\"\r\n"
  assert_eq write_out([[",\"x y\""], [",é"]], 59, false), "\",\"\"x y\"\"\"\n,é\n"
  assert_eq write_out([["\n\r\nc\r"], ["b\nλ ", "a\n", "\u3000", "\r"], ["\r\n\rc", "c\né", "\r\né\"\"\r", ""]], 44, false), "\"\n\r\nc\r\"\n\"b\nλ \",\"a\n\",\"\u3000\",\"\r\"\n\"\r\n\rc\",\"c\né\",\"\r\né\"\"\"\"\r\",\n"
  assert_eq write_out([["caab", "\"c ", ";;\n", "\",\"\"a"], ["\r\n\tb\n", "\r\na,", "", ""], ["", "\r\n\"\r"]], 59, true), "caab;\"\"\"c \";\";;\r\n\";\"\"\",\"\"\"\"a\"\r\n\"\r\n\tb\r\n\";\"\r\na,\";;\r\n;\"\r\n\"\"\"\r\n"
  assert_eq write_out([[""], ["\r\ncb,", "\tλ", "\r\n#", " "]], 9, true), "\r\n\"\r\ncb,\"\t\"\tλ\"\t\"\r\n#\"\t\" \"\r\n"
  assert_eq write_out([], 44, false), ""
  assert_eq write_out([["λ x yb", "θλb\t", "\\.", ""]], 44, false), "λ x yb,θλb\t,\"\\.\",\n"
  assert_eq write_out([], 9, false), ""
  assert_eq write_out([["a\n\n\"", "\u3000x yc", "\"", "x yb"], ["\"\"", "x yx y \"", "\""]], 955, false), "\"a\n\n\"\"\"λ\"\u3000x yc\"λ\"\"\"\"λx yb\n\"\"\"\"\"\"λ\"x yx y \"\"\"λ\"\"\"\"\n"
