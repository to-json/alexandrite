test "go write vectors 0" {
  assert_eq write_out([["", "\\.", "\n\u3000b", "λ\r\n,"], ["\nb", "\ra"], ["éb", "", "", ""]], 9, false), "\t\"\\.\"\t\"\n\u3000b\"\t\"λ\r\n,\"\n\"\nb\"\t\"\ra\"\néb\t\t\t\n"
  assert_eq write_out([["", ""], ["\t", "\u3000\r\r\n", "\r,", ",θx y"]], 59, false), ";\n\"\t\";\"\u3000\r\r\n\";\"\r,\";,θx y\n"
  assert_eq write_out([], 59, true), ""
  assert_eq write_out([[""]], 44, true), "\r\n"
  assert_eq write_out([["\n", "", ""]], 955, true), "\"\r\n\"λλ\r\n"
  assert_eq write_out([], 44, true), ""
  assert_eq write_out([], 9, false), ""
  assert_eq write_out([[","]], 32, true), ",\r\n"
  assert_eq write_out([], 955, true), ""
  assert_eq write_out([], 44, false), ""
  assert_eq write_out([["b;θ;", "\u3000", "\n", "θλθ\r"], ["θ#é\r", "#a", ""]], 59, true), "\"b;θ;\";\"\u3000\";\"\r\n\";\"θλθ\"\r\n\"θ#é\";#a;\r\n"
  assert_eq write_out([["\\.", "\n\"\"", "c", ""]], 9, false), "\"\\.\"\t\"\n\"\"\"\"\"\tc\t\n"
  assert_eq write_out([["c", "θ\"\"\u3000,"]], 59, false), "c;\"θ\"\"\"\"\u3000,\"\n"
  assert_eq write_out([["#\u3000"]], 32, true), "#\u3000\r\n"
  assert_eq write_out([["θ\r", "\n\n\"", "x y\t\"\"\"", ",#"], ["c θc", "\nb", "é\nx y"]], 44, true), "\"θ\",\"\r\n\r\n\"\"\",\"x y\t\"\"\"\"\"\"\",\",#\"\r\nc θc,\"\r\nb\",\"é\r\nx y\"\r\n"
  assert_eq write_out([["\u3000", "\u3000c\t;", "\n\""]], 59, false), "\"\u3000\";\"\u3000c\t;\";\"\n\"\"\"\n"
  assert_eq write_out([], 32, false), ""
  assert_eq write_out([["\\.", "\r", "\u3000a\r\n,"], [""]], 955, true), "\"\\.\"λ\"\"λ\"\u3000a\r\n,\"\r\n\r\n"
  assert_eq write_out([["\n"]], 59, false), "\"\n\"\n"
  assert_eq write_out([[" ", ""], ["\\.", ""]], 32, false), "\" \" \n\"\\.\" \n"
  assert_eq write_out([], 44, false), ""
  assert_eq write_out([["\"b", "", ",,λ"]], 59, false), "\"\"\"b\";;,,λ\n"
  assert_eq write_out([], 44, false), ""
  assert_eq write_out([], 9, true), ""
  assert_eq write_out([["\nx y,", "λ"], ["\\."], ["\r\n\"", "\u3000é", ",\n\t", ""]], 44, true), "\"\r\nx y,\",λ\r\n\"\\.\"\r\n\"\r\n\"\"\",\"\u3000é\",\",\r\n\t\",\r\n"
  assert_eq write_out([[",", "\"a,\u3000", "aθ;\"\""], ["θé", "cx y\""], [""]], 9, false), ",\t\"\"\"a,\u3000\"\t\"aθ;\"\"\"\"\"\nθé\t\"cx y\"\"\"\n\n"
  assert_eq write_out([["\n", "λθé"], ["\n\r\"\"\""]], 44, false), "\"\n\",λθé\n\"\n\r\"\"\"\"\"\"\"\n"
  assert_eq write_out([["λé", "c\n"], ["θ\u3000", "\\."]], 9, false), "λé\t\"c\n\"\nθ\u3000\t\"\\.\"\n"
  assert_eq write_out([["λλ\na", "θ", ""], ["\"a\u3000", "é", "", "\n#\u3000;"]], 44, false), "\"λλ\na\",θ,\n\"\"\"a\u3000\",é,,\"\n#\u3000;\"\n"
  assert_eq write_out([["x ya;c"]], 9, true), "x ya;c\r\n"
  assert_eq write_out([["λbx yb", ";\""]], 32, true), "\"λbx yb\" \";\"\"\"\r\n"
  assert_eq write_out([["a\n\"\"\r", "x yθ\"", "\\.", "\n"]], 9, false), "\"a\n\"\"\"\"\r\"\t\"x yθ\"\"\"\t\"\\.\"\t\"\n\"\n"
  assert_eq write_out([["\r\n", ";λ\u3000\t"], [""]], 44, false), "\"\r\n\",;λ\u3000\t\n\n"
  assert_eq write_out([["\"\"", "c;"], ["\nc"]], 955, true), "\"\"\"\"\"\"λc;\r\n\"\r\nc\"\r\n"
  assert_eq write_out([["", "éλ\"\" ", "\r\n"], ["\u3000éé,", ";x y"], [",\t", "bé,"]], 44, false), ",\"éλ\"\"\"\" \",\"\r\n\"\n\"\u3000éé,\",;x y\n\",\t\",\"bé,\"\n"
  assert_eq write_out([["θ\t", ",x yc", "", "\""], ["", ""]], 44, false), "θ\t,\",x yc\",,\"\"\"\"\n,\n"
  assert_eq write_out([["", "\té"], ["", ""], ["\t\u3000", ""]], 9, true), "\t\"\té\"\r\n\t\r\n\"\t\u3000\"\t\r\n"
  assert_eq write_out([["\r\r\n", "éé"], ["", "\" λc", "\"b\"\""], [",x y\u3000\r\n", "\\."]], 955, false), "\"\r\r\n\"λéé\nλ\"\"\" λc\"λ\"\"\"b\"\"\"\"\"\n\",x y\u3000\r\n\"λ\"\\.\"\n"
  assert_eq write_out([["\u3000\""], ["\r\n\"", "c,é", "θ\"\"x y", "\"\"\né"]], 9, true), "\"\u3000\"\"\"\r\n\"\r\n\"\"\"\tc,é\t\"θ\"\"\"\"x y\"\t\"\"\"\"\"\r\né\"\r\n"
  assert_eq write_out([["\t\r\n", "a \"é"]], 44, false), "\"\t\r\n\",\"a \"\"é\"\n"
  assert_eq write_out([[""], ["", "éx y", "\nb\n", "\""]], 44, false), "\n,éx y,\"\nb\n\",\"\"\"\"\n"
  assert_eq write_out([["\"λ", ";\"", "\n", ""], ["bx y", "x y \t", "\r\n\"#"]], 44, true), "\"\"\"λ\",\";\"\"\",\"\r\n\",\r\nbx y,x y \t,\"\r\n\"\"#\"\r\n"
  assert_eq write_out([["\rλx y", "\"\"c", "éc\n\""], ["\t\n\"", ",λ\"", "bc", " ;é"], ["\\.", "\n", "θ"]], 34, true), "err=csv: invalid field or comment delimiter"
  assert_eq write_out([["\\.", "", "", ""]], 32, false), "\"\\.\"   \n"
  assert_eq write_out([], 59, false), ""
  assert_eq write_out([[""], ["x y\n", "\\.", "\"b,c"]], 9, true), "\r\n\"x y\r\n\"\t\"\\.\"\t\"\"\"b,c\"\r\n"
  assert_eq write_out([[""]], 34, false), "err=csv: invalid field or comment delimiter"
  assert_eq write_out([["\"c", "\n", "\\."], ["b", "#", "", "λ\"\n"], ["é\"\"\n", ",\t"]], 59, false), "\"\"\"c\";\"\n\";\"\\.\"\nb;#;;\"λ\"\"\n\"\n\"é\"\"\"\"\n\";,\t\n"
  assert_eq write_out([["x yθ\"\"", ",\ta\n", "\"éc#"]], 955, true), "\"x yθ\"\"\"\"\"λ\",\ta\r\n\"λ\"\"\"éc#\"\r\n"
  assert_eq write_out([["\n\r\n\n,", "\n"]], 59, false), "\"\n\r\n\n,\";\"\n\"\n"
  assert_eq write_out([["cλ\t"], ["a", "\"\n\"\n", "\""]], 955, true), "\"cλ\t\"\r\naλ\"\"\"\r\n\"\"\r\n\"λ\"\"\"\"\r\n"
  assert_eq write_out([], 32, false), ""
  assert_eq write_out([[",\u3000\u3000", "\""], [";;", "\t", "\réc", "é "], [",", "a", "\n", "\"θc"]], 955, false), ",\u3000\u3000λ\"\"\"\"\n;;λ\"\t\"λ\"\réc\"λé \n,λaλ\"\n\"λ\"\"\"θc\"\n"
  assert_eq write_out([[","]], 955, true), ",\r\n"
  assert_eq write_out([[", ", ""]], 955, true), ", λ\r\n"
  assert_eq write_out([["\r", "#\r", "\\."], ["\t\u3000", "\"\"", "\"x y"], [";"]], 9, false), "\"\r\"\t\"#\r\"\t\"\\.\"\n\"\t\u3000\"\t\"\"\"\"\"\"\t\"\"\"x y\"\n;\n"
