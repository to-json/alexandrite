  assert_eq write_out([["#\r\n", "", "θ", "\u3000"], ["\r\nx y", "θθ", ",\n"], ["\n,\t\t", "\\.", "θ\r\n,\u3000", "x y"]], 59, false), "\"#\r\n\";;θ;\"\u3000\"\n\"\r\nx y\";θθ;\",\n\"\n\"\n,\t\t\";\"\\.\";\"θ\r\n,\u3000\";x y\n"
  assert_eq write_out([[",,é"], ["#λ\"\",", "\",", "\"\"x y\n", ""], ["\" \nx y", "", "\n,"]], 44, false), "\",,é\"\n\"#λ\"\"\"\",\",\"\"\",\",\"\"\"\"\"x y\n\",\n\"\"\" \nx y\",,\"\n,\"\n"
