test "go write vectors 3" {
  assert_eq write_out([["\"\"\r\nθ"], [""]], 9, false), "\"\"\"\"\"\r\nθ\"\n\n"
  assert_eq write_out([], 44, true), ""
  assert_eq write_out([[",", ",,\n\u3000", " ,\tb"]], 44, true), "\",\",\",,\r\n\u3000\",\" ,\tb\"\r\n"
