# Package encoding: Go's encoding — the interfaces shared by packages that
# convert data to and from byte-level and textual representations.
#
#   Go                                         alx
#   BinaryMarshaler    MarshalBinary() ([]byte, error)      def marshal_binary -> ~[Byte]
#   BinaryUnmarshaler  UnmarshalBinary([]byte) error        def unmarshal_binary!(data: [Byte]) -> ~Unit
#   BinaryAppender     AppendBinary([]byte) ([]byte, error) def append_binary(b: [Byte]) -> ~[Byte]
#   TextMarshaler      MarshalText() ([]byte, error)        def marshal_text -> ~[Byte]
#   TextUnmarshaler    UnmarshalText([]byte) error          def unmarshal_text!(text: [Byte]) -> ~Unit
#   TextAppender       AppendText([]byte) ([]byte, error)   def append_text(b: [Byte]) -> ~[Byte]
#
# The interfaces are structural (GO-VS-RUBY F2): any type with the method is
# one, and an infallible method satisfies the fallible interface method.
#
# Differences from Go:
#  - The unmarshalers mutate their receiver, so the method ends in `!` and,
#    like every `!` method, needs a variable receiver. Go's pointer receiver
#    becomes the D36 convention when the value must be shared: a type that
#    keeps its state in a one-element slice is updated through every copy.
#  - Go documents that UnmarshalText/UnmarshalBinary must copy the data if
#    they keep it. In alx slices share storage too, so the same rule holds.
#  - Nothing in std consults these interfaces yet: encoding/json uses its own
#    derive protocol (see encoding/json's header), since there is no run-time
#    reflection to discover them.

# A type that can marshal itself into a binary form.
pub interface BinaryMarshaler {
  def marshal_binary -> ~[Byte]
}

# A type that can unmarshal a binary representation of itself. It must copy
# `data` if it wishes to retain it after returning.
pub interface BinaryUnmarshaler {
  def unmarshal_binary!(data: [Byte]) -> ~Unit
}

# A type that can append its binary representation to the end of `b` and
# return the extended slice. It must not mutate the bytes already in `b`.
pub interface BinaryAppender {
  def append_binary(b: [Byte]) -> ~[Byte]
}

# A type that can marshal itself into a textual form (UTF-8).
pub interface TextMarshaler {
  def marshal_text -> ~[Byte]
}

# A type that can unmarshal a textual representation of itself. It must copy
# `text` if it wishes to retain it after returning.
pub interface TextUnmarshaler {
  def unmarshal_text!(text: [Byte]) -> ~Unit
}

# A type that can append its textual representation to the end of `b` and
# return the extended slice. It must not mutate the bytes already in `b`.
pub interface TextAppender {
  def append_text(b: [Byte]) -> ~[Byte]
}
