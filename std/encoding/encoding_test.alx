# Go's encoding package has no tests (it only declares interfaces). These
# check that ordinary types satisfy the interfaces, fallibly or not.

# A 2-D point: binary form is two bytes, text form "x,y".
struct Point {
  st: [(Int, Int)]

  def marshal_binary -> [Byte] {
    out: [Byte] = [st[0][0].as_u8, st[0][1].as_u8]
    out
  }
  def unmarshal_binary!(data: [Byte]) -> ~Unit {
    fail "point: want 2 bytes, got #{data.size}" if data.size != 2
    self.st[0] = (data[0].to_i, data[1].to_i)
  }
  def append_binary(b: [Byte]) -> [Byte] { b + marshal_binary }
  def marshal_text -> ~[Byte] { "#{st[0][0]},#{st[0][1]}".bytes.to_a }
  def unmarshal_text!(text: [Byte]) -> ~Unit {
    s = Str.from_bytes(text)
    parts = s.split(",")
    fail "point: bad text #{s}" if parts.size != 2
    self.st[0] = (parts[0].to_i, parts[1].to_i)
  }
  def append_text(b: [Byte]) -> ~[Byte] { b + ~marshal_text }
}

def new_point(x: Int, y: Int) -> Point { Point.new(st: [(x, y)]) }

def bin(m: BinaryMarshaler) -> ~[Byte] { m.~marshal_binary }
def txt(m: TextMarshaler) -> ~[Byte] { m.~marshal_text }
def set_bin(u: BinaryUnmarshaler, data: [Byte]) -> ~Unit {
  v = u
  v.~unmarshal_binary!(data)
}
def set_txt(u: TextUnmarshaler, data: [Byte]) -> ~Unit {
  v = u
  v.~unmarshal_text!(data)
}
def app_bin(a: BinaryAppender, b: [Byte]) -> ~[Byte] { a.~append_binary(b) }
def app_txt(a: TextAppender, b: [Byte]) -> ~[Byte] { a.~append_text(b) }

test "marshalers through the interfaces" {
  p = new_point(3, 4)
  want: [Byte] = [3, 4]
  assert_eq ~bin(p), want
  assert_eq Str.from_bytes(~txt(p)), "3,4"
  lead: [Byte] = [9]
  want2: [Byte] = [9, 3, 4]
  assert_eq ~app_bin(p, lead), want2
  assert_eq Str.from_bytes(~app_txt(p, "p=".bytes.to_a)), "p=3,4"
}

test "unmarshalers through the interfaces share the receiver" {
  p = new_point(0, 0)
  data: [Byte] = [7, 8]
  ~set_bin(p, data)
  assert_eq Str.from_bytes(~txt(p)), "7,8"
  ~set_txt(p, "12,34".bytes.to_a)
  assert_eq Str.from_bytes(~txt(p)), "12,34"
  bad: [Byte] = [1]
  r = set_bin(p, bad)
  assert_eq r.err?.message || "", "point: want 2 bytes, got 1"
  r2 = set_txt(p, "nope".bytes.to_a)
  assert_eq r2.err?.message || "", "point: bad text nope"
}
