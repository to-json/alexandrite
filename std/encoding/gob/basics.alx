#![overflow(wrap)]
# The gob protocol for the predeclared types, so they can be encoded and
# decoded at the top level (`enc.encode!(42)`, `dec.decode!("")`): Go's
# basic types, slices of them (Go registers the same set for interface
# values) and a few maps. Fields of derived types don't use these: the derive
# writes their code inline, for any element type.
# Generated by a script; edit the script's tables rather than this file.

pub refine Basics for Int {
  def gob_type(b: Types) -> Int {
    t = b
    t.basic!("int")
  }
  def gob_type_name -> Str { "int" }
  def gob_enc(e0: Enc) {
    e = e0
    e.int!(self)
  }
  def gob_top(d0: Dec, w: Int) -> ~Int {
    d = d0
    fail d.mismatch("int", w, false) if w != T_INT
    d.~single!
    d.~int!
  }
}

