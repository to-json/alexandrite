  def gob_type(b: Types) -> Int {
    t = b
    t.slice!(t.basic!("int"))
  }
  def gob_type_name -> Str { "[]int" }
  def gob_enc(e0: Enc) {
    e = e0
    e.uint!(self.size)
    for x in self {
