    fail d.mismatch("[]int", w, false) if d.elem_of(w, K_SLICE) != T_INT
    d.~single!
    n = d.~slice_len!("int")
    out: [Int] = []
    for _i in 0...n {
      d.~elem_check!(n)
      out << d.~int!
    }
    out
  }
}

