#![overflow(wrap)]
# Decoding: Go's decoder.go and decode.go. Derived `gob_dec` methods read
# values through a `Dec`; `Decoder[Rdr]` reads messages from R.

# A received type (Go's wireType, flattened): kind is K_ARRAY, K_SLICE,
# K_STRUCT, K_MAP or 100 + X_GOB / X_BINARY / X_TEXT.
pub struct Wire {
  kind: Int
  name: Str
  id: Int
  elem: Int
  key: Int
  len: Int
  fnames: [Str]
  fids: [Int]
}

MAX_IGNORE_DEPTH = 10000

struct DecState {
  read: ([Byte]) -> ~Int
  # read-ahead from the reader
  rbuf: [Byte]
  rpos: Int
  # the current message
  buf: [Byte]
  pos: Int
  wire: Map[Int, Wire]
  # decoding plans of struct types: "local type#wire id" -> local field per wire field
  plans: Map[Str, [Int]]
  types: Types
  reg: Registry
  depth: Int
  # decoding the top-level value itself (Go names the local type *T then:
  # Decode was given a pointer)
  at_top: Bool
}

BUILTIN_NAMES = ["", "bool", "int", "uint", "float", "bytes", "string", "complex", "interface"]

# What derived `gob_dec` methods read from (one per Decoder; copies share it).
pub struct Dec {
  st: [DecState]

  pub def types -> Types { self.st[0].types }
  pub def registry -> Registry { self.st[0].reg }

  # ---- reading the stream

  # One byte from the reader, or none at its end.
  def read_byte! -> ~Byte? {
    if self.st[0].rpos >= self.st[0].rbuf.size {
      chunk: [Byte] = [0; 4096]
      n = self.st[0].read.~call(chunk)
      return none if n == 0
      self.st[0].rbuf = chunk[0...n]
      self.st[0].rpos = 0
    }
    b = self.st[0].rbuf[self.st[0].rpos]
    self.st[0].rpos += 1
    b
  }

  # Exactly n bytes from the reader (fewer at its end).
  def read_n!(n: Int) -> ~[Byte] {
    out: [Byte] = []
    while out.size < n {
      if self.st[0].rpos >= self.st[0].rbuf.size {
        chunk: [Byte] = [0; 4096]
        k = self.st[0].read.~call(chunk)
        break if k == 0
        self.st[0].rbuf = chunk[0...k]
        self.st[0].rpos = 0
      }
      take = n - out.size
      avail = self.st[0].rbuf.size - self.st[0].rpos
      take = avail if avail < take
      out += self.st[0].rbuf[self.st[0].rpos...self.st[0].rpos + take]
      self.st[0].rpos += take
    }
    out
  }

  # decodeUintReader on the stream: a message's length.
  def read_count! -> ~U64 {
    bo = self.~read_byte!
    fail GobError.Eof if bo == none
    b = bo || 0
    return b.to_u64 if b <= 0x7f
    n = 256 - b.to_i
    fail gerr("gob: encoded unsigned integer out of range") if n > 8
    bs = self.~read_n!(n)
    fail GobError.UnexpectedEof if bs.size < n
    x: U64 = 0
    for c in bs {
      x = (x << 8) | c.to_u64
    }
    x
  }

  # recvMessage: the next message into the buffer.
  def recv_message! -> ~Unit {
    n = self.~read_count!
    fail gerr("invalid message length") if n >= TOO_BIG.to_u64
    bs = self.~read_n!(n.to_i64)
    fail GobError.UnexpectedEof if bs.size < n.to_i64
    self.st[0].buf = bs
    self.st[0].pos = 0
  }

  # Bytes left in the current message.
  pub def remaining -> Int { self.st[0].buf.size - self.st[0].pos }

  # Drop what is left of the current message.
  pub def reset! {
    self.st[0].buf = []
    self.st[0].pos = 0
  }

  # ---- the wire format's numbers

  # decodeUint.
  pub def uint! -> ~U64 {
    p = self.st[0].pos
    buf = self.st[0].buf
    fail GobError.Eof if p >= buf.size
    b = buf[p]
    if b <= 0x7f {
      self.st[0].pos = p + 1
      return b.to_u64
    }
    n = 256 - b.to_i
    fail gerr("gob: encoded unsigned integer out of range") if n > 8
    if buf.size - p - 1 < n {
      fail gerr("gob: invalid uint data length #{n}: exceeds input size #{buf.size - p - 1}")
    }
    x: U64 = 0
    for i in 0...n {
      x = (x << 8) | buf[p + 1 + i].to_u64
    }
    self.st[0].pos = p + 1 + n
    x
  }

  # decodeInt.
  pub def int! -> ~Int { bits_int(self.~uint!) }

  # An unsigned value as an Int (a count, a delta, a length); huge ones wrap
  # negative, as Go's int(x) does.
  pub def count! -> ~Int { self.~uint!.as_i64 }

  pub def bool! -> ~Bool { self.~uint! != 0 }
  pub def float! -> ~Float { bits_float(self.~uint!) }

  pub def complex! -> ~Complex {
    re = bits_float(self.~uint!)
    im = bits_float(self.~uint!)
    Complex.new(re, im)
  }

  # Ints of a size: Go's range checks ("value for \"name\" out of range").
  pub def int_in!(lo: Int, hi: Int, name: Str) -> ~Int {
    v = self.~int!
    fail ovfl(name) if v < lo || v > hi
    v
  }

  pub def uint_in!(hi: U64, name: Str) -> ~U64 {
    v = self.~uint!
    fail ovfl(name) if v > hi
    v
  }

  pub def i8!(name: Str) -> ~I8 { self.~int_in!(-128, 127, name).as_i8 }
  pub def i16!(name: Str) -> ~I16 { self.~int_in!(-32768, 32767, name).as_i16 }
  pub def i32!(name: Str) -> ~I32 { self.~int_in!(-2147483648, 2147483647, name).as_i32 }
  pub def u8!(name: Str) -> ~U8 { self.~uint_in!(0xff, name).as_u8 }
  pub def u16!(name: Str) -> ~U16 { self.~uint_in!(0xffff, name).as_u16 }
  pub def u32!(name: Str) -> ~U32 { self.~uint_in!(0xffffffff, name).as_u32 }

  # getLength: a length that fits the rest of the message, or err.
  def length!(err: GobError) -> ~Int {
    n = self.~count!
    fail err if n < 0 || self.remaining < n || n >= TOO_BIG
    n
  }

  # decString.
  pub def str! -> ~Str {
    n = self.~length!(gerr("gob: bad string slice length: 0"))
    p = self.st[0].pos
    self.st[0].pos = p + n
    Str.from_bytes(self.st[0].buf[p...p + n])
  }

  # decUint8Slice.
  pub def bytes! -> ~[Byte] {
    n = self.~length!(gerr("gob: bad []uint8 slice length: 0"))
    p = self.st[0].pos
    self.st[0].pos = p + n
    out: [Byte] = [0; n]
    copy(out, self.st[0].buf[p...p + n])
    out
  }

  # A GobDecoder's bytes (decodeGobDecoder).
  pub def ext_bytes! -> ~[Byte] {
    n = self.~length!(gerr("gob: GobDecoder: length too large for buffer"))
    p = self.st[0].pos
    self.st[0].pos = p + n
    out: [Byte] = [0; n]
    copy(out, self.st[0].buf[p...p + n])
    out
  }

  # ---- types

  # decodeTypeSequence: type definitions, then the id of the value that
  # follows them.
  pub def type_sequence!(iface: Bool) -> ~Int {
    first = true
    loop {
      if self.remaining == 0 {
        r = self.recv_message!
        if e = r.err {
          fail GobError.UnexpectedEof if !first && e.message == "EOF"
          fail e
        }
      }
      id = self.~int!
      return id if id >= 0
      self.~recv_type!(-id)
      if self.remaining > 0 {
        fail gerr("extra data in buffer") unless iface
        self.~uint!
      }
      first = false
    }
    -1
  }

  # recvType: one wireType.
  def recv_type!(id: Int) -> ~Unit {
    if id < FIRST_USER_ID || self.st[0].wire.key?(id) {
      fail gerr("gob: duplicate type received")
    }
    w = Wire.new(kind: 0, name: "", id: 0, elem: 0, key: 0, len: 0, fnames: [], fids: [])
    f = -1
    while self.remaining > 0 {
      d = self.~count!
      break if d == 0
      fail gerr("gob: bad data: field numbers out of bounds") if d < 0 || f + d > 6
      f += d
      w.kind = case f {
        0 => K_ARRAY
        1 => K_SLICE
        2 => K_STRUCT
        3 => K_MAP
        _ => 100 + f - 3
      }
      # the *Type struct
      g = -1
      while self.remaining > 0 {
        d2 = self.~count!
        break if d2 == 0
        g += d2
        if g == 0 {
          # CommonType
          h = -1
          while self.remaining > 0 {
            d3 = self.~count!
            break if d3 == 0
            h += d3
            if h == 0 {
              w.name = self.~str!
            } elsif h == 1 {
              w.id = self.~int!
            } else {
              fail gerr("gob: bad data: field numbers out of bounds")
            }
          }
        } elsif g == 1 && w.kind == K_STRUCT {
          n = self.~count!
          for _i in 0...n {
            fail gerr("gob: decoding array or slice: length exceeds input size (#{n} elements)") if self.remaining == 0
            fname = ""
            fid = 0
            h = -1
            while self.remaining > 0 {
              d3 = self.~count!
              break if d3 == 0
              h += d3
              if h == 0 {
                fname = self.~str!
              } elsif h == 1 {
                fid = self.~int!
              } else {
                fail gerr("gob: bad data: field numbers out of bounds")
              }
            }
            w.fnames << fname
            w.fids << fid
          }
        } elsif g >= 1 && g <= 2 && w.kind != K_STRUCT && w.kind < 100 {
          v = self.~int!
          if w.kind == K_MAP {
            if g == 1 {
              w.key = v
            } else {
              w.elem = v
            }
          } elsif g == 1 {
            w.elem = v
          } elsif w.kind == K_ARRAY {
            w.len = v
          } else {
            fail gerr("gob: bad data: field numbers out of bounds")
          }
        } else {
          fail gerr("gob: bad data: field numbers out of bounds")
        }
      }
    }
    self.st[0].wire[id] = w
  }

  # The received type with this id, or err.
  def wire_or(w: Int, err: GobError) -> ~Wire {
    if t = self.st[0].wire[w] {
      return t
    }
    fail err
  }

  # The received type with this id.
  pub def wire(id: Int) -> Wire? { self.st[0].wire[id] }

  # Go's typeString(remoteId), for errors.
  pub def type_string(id: Int) -> Str {
    return BUILTIN_NAMES[id] if id >= 0 && id < BUILTIN_NAMES.size
    if w = self.st[0].wire[id] {
      return w.name
    }
    "<nil>"
  }

  # ---- compatibility (Go's compatibleType), for derived code

  # Whether wire type w is an external (GobEncoder ...) one of kind x (0: not).
  pub def ext_kind(w: Int) -> Int {
    if t = self.st[0].wire[w] {
      return t.kind - 100 if t.kind > 100
    }
    0
  }

  pub def elem_of(w: Int, kind: Int) -> Int {
    if t = self.st[0].wire[w] {
      return t.elem if t.kind == kind
    }
    -1
  }

  pub def key_of(w: Int) -> Int {
    if t = self.st[0].wire[w] {
      return t.key if t.kind == K_MAP
    }
    -1
  }

  pub def array_elem(w: Int, n: Int) -> Int {
    if t = self.st[0].wire[w] {
      return t.elem if t.kind == K_ARRAY && t.len == n
    }
    -1
  }

  # A struct's plan, if made: for each wire field, the local field (or -1).
  pub def plan(key: Str, w: Int) -> [Int]? { self.st[0].plans["#{key}##{w}"] }

  pub def store_plan!(key: Str, w: Int, p: [Int]) { self.st[0].plans["#{key}##{w}"] = p }

  # The wire struct for a local struct type (compileDec's checks).
  pub def wire_struct(w: Int, local: Str) -> ~Wire {
    fail gerr("gob: type mismatch in decoder: want struct type #{local}; got non-struct") if w < FIRST_USER_ID
    t = self.~wire_or(w, gerr("gob: unknown type id or corrupted data"))
    fail gerr("gob: type mismatch in decoder: want struct type #{local}; got non-struct") if t.kind != K_STRUCT
    t
  }

  pub def field_id(w: Int, n: Int) -> Int {
    if t = self.st[0].wire[w] {
      return t.fids[n] if n < t.fids.size
    }
    0
  }

  # "wrong type (T) for received field S.F"
  pub def wrong_type(local: Str, w: Int, field: Str) -> GobError {
    sname = self.st[0].wire[w]?.name || ""
    gerr("gob: wrong type (#{local}) for received field #{sname}.#{field}")
  }

  # compileSingle's error.
  pub def mismatch(local0: Str, w: Int, iface: Bool) -> GobError {
    local = self.st[0].at_top ? "*" + local0 : local0
    if iface && w != T_INTERFACE {
      return gerr("gob: local interface type #{local} can only be decoded from remote interface type; received concrete type #{self.type_string(w)}")
    }
    gerr("gob: decoding into local type #{local}, received remote type #{self.type_string(w)}")
  }

  # ---- values

  # The next field number of a struct after `n` (of `count` wire fields),
  # or -1 at its end (decodeStruct's loop).
  pub def next_field!(n: Int, count: Int) -> ~Int {
    return -1 if self.remaining == 0
    d = self.~count!
    fail gerr("gob: decode: corrupted data: negative delta") if d < 0
    return -1 if d == 0
    fail gerr("gob: bad data: field numbers out of bounds") if n >= count - d
    n + d
  }

  # The singleton's field number (always 0).
  pub def single! -> ~Unit {
    fail gerr("gob: decode: corrupted data: non-zero delta for singleton") if self.~uint! != 0
  }

  # A slice's length (decodeSlice).
  pub def slice_len!(elem: Str) -> ~Int {
    n = self.~count!
    fail gerr("gob: #{elem} slice too big: #{n} elements") if n < 0 || n >= TOO_BIG
    n
  }

  # Before each element of an array or slice.
  pub def elem_check!(n: Int) -> ~Unit {
    fail gerr("gob: decoding array or slice: length exceeds input size (#{n} elements)") if self.remaining == 0
  }

  # An array's length, which must be n (decodeArray).
  pub def array_len!(n: Int) -> ~Unit {
    fail gerr("gob: length mismatch in decodeArray") if self.~uint! != n.to_u64
  }

  # An interface value's name ("" for nil).
  pub def iface_name! -> ~Str {
    nr = self.~uint!
    fail gerr("gob: invalid type name length #{nr}") if nr > 1 << 31
    fail gerr("gob: invalid type name length #{nr}: exceeds input size") if nr > self.remaining.to_u64
    n = nr.to_i64
    p = self.st[0].pos
    self.st[0].pos = p + n
    name = Str.from_bytes(self.st[0].buf[p...p + n])
    fail gerr("gob: name too long (#{n} bytes): #{name[0...20]}...") if n > 1024
    name
  }

  # After an interface value's name: its type definitions, its concrete type
  # id, and the length of its data.
  pub def iface_value_id! -> ~Int {
    self.st[0].at_top = false
    id = self.~type_sequence!(true)
    self.~uint!
    id
  }

  pub def not_registered(name: Str) -> GobError { gerr("gob: name not registered for interface: #{gq(name)}") }

  # ---- skipping what the local type doesn't have (decIgnoreOpFor)

  pub def skip!(w: Int) -> ~Unit {
    self.st[0].depth += 1
    r = self.skip_in!(w)
    self.st[0].depth -= 1
    ~r
  }

  def skip_in!(w: Int) -> ~Unit {
    fail gerr("gob: invalid nesting depth") if self.st[0].depth > MAX_IGNORE_DEPTH
    if w == T_BOOL || w == T_INT || w == T_UINT || w == T_FLOAT {
      self.~uint!
      return
    }
    if w == T_BYTES || w == T_STRING {
      n = self.~length!(gerr("gob: slice length too large"))
      self.st[0].pos += n
      return
    }
    if w == T_COMPLEX {
      self.~uint!
      self.~uint!
      return
    }
    if w == T_INTERFACE {
      n = self.~length!(gerr("gob: bad interface encoding: name too large for buffer"))
      self.st[0].pos += n
      self.~type_sequence!(true)
      m = self.~length!(gerr("gob: bad interface encoding: data length too large for buffer"))
      self.st[0].pos += m
      return
    }
    t = self.~wire_or(w, gerr("gob: bad data: undefined type #{self.type_string(w)}"))
    if t.kind == K_ARRAY {
      fail gerr("gob: length mismatch in ignoreArray") if self.~uint! != t.len.to_u64
      for _i in 0...t.len {
        self.~elem_check!(t.len)
        self.~skip!(t.elem)
      }
    } elsif t.kind == K_SLICE {
      n = self.~count!
      for _i in 0...n {
        self.~elem_check!(n)
        self.~skip!(t.elem)
      }
    } elsif t.kind == K_MAP {
      n = self.~count!
      for _i in 0...n {
        self.~skip!(t.key)
        self.~skip!(t.elem)
      }
    } elsif t.kind == K_STRUCT {
      f = -1
      loop {
        f = self.~next_field!(f, t.fids.size)
        break if f < 0
        self.~skip!(t.fids[f])
      }
    } else {
      n = self.~length!(gerr("gob: GobDecoder: length too large for buffer"))
      self.st[0].pos += n
    }
    nil
  }

  # A whole top-level value of wire type w, skipped (Decode(nil)).
  pub def skip_value!(w: Int) -> ~Unit {
    if t = self.st[0].wire[w] {
      if t.kind == K_STRUCT {
        return self.~skip!(w)
      }
    }
    self.~single!
    self.~skip!(w)
  }
}

def ovfl(name: Str) -> GobError { gerr("value for \"#{name}\" out of range") }

pub def new_dec(read: ([Byte]) -> ~Int, reg: Registry) -> Dec {
  Dec.new(st: [DecState.new(read: read, rbuf: [], rpos: 0, buf: [], pos: 0, wire: {}, plans: {}, types: new_types(), reg: reg, depth: 0, at_top: false)])
}

# Go's Decoder: values from a stream of messages on a reader.
pub struct Decoder[Rdr] {
  rs: [Rdr]
  dd: Dec

  # Go's Decode: the next value, decoded into a copy of `into` (Go decodes
  # into the value a pointer points at: fields the stream doesn't have keep
  # their values). `into` is anything with the gob protocol (see
  # Encoder.encode!). At the end of the stream it fails with GobError.Eof.
  pub def decode![T](into: T) -> ~T {
    using Basics
    d = self.dd
    d.reset!
    id = d.~type_sequence!(false)
    d.st[0].at_top = true
    ~into.gob_top(d, id)
  }

  # Go's Decode(nil): read the next value and throw it away.
  pub def skip! -> ~Unit {
    d = self.dd
    d.reset!
    id = d.~type_sequence!(false)
    d.~skip_value!(id)
  }

  pub def registry -> Registry { self.dd.registry }

  # The decoder's state, for hand-written gob_dec methods and tests.
  pub def dec -> Dec { self.dd }
}

# Go's NewDecoder.
pub def new_decoder[Rdr](r: Rdr) -> Decoder[Rdr] { new_decoder_with(r, default_registry()) }

# A Decoder reading interface values' names through `reg`.
pub def new_decoder_with[Rdr](r: Rdr, reg: Registry) -> Decoder[Rdr] {
  rs = [r]
  f = ->(p: [Byte]) -> ~Int { rs[0].~read!(p) }
  Decoder.new(rs: rs, dd: new_dec(f, reg))
}
