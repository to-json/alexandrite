# Go's encoder_test.go, the parts with structs and interfaces (the rest is in
# ../codec_test.alx). Not translated: TestUnsupported, TestChanFuncIgnored
# (chan/func fields: the derive refuses them at compile time),
# TestRecursiveMapType/SliceType, TestIgnoreRecursiveType's encoder half,
# TestNestedInterfaces' recursion, TestGobPtrSlices' Children (recursive
# types are refused), TestValueError, TestCatchInvalidNilValue,
# TestTopLevelNilPointer, TestNilPointerPanics (no nil values or pointers at
# the top level), TestSliceReusesMemory (decoding returns a new value; no
# addresses to compare), TestMarshalFloatMap (Map keys are strings, bools
# and integers), TestTypeToPtrPtrPtrPtrType (one level of `T?`).
import "bytes"
import "encoding/gob"
import "encoding/hex"

#[derive(Gob)]
struct ET0 {
  a: Int
  b: Str
}

#[derive(Gob)]
struct ET2b {
  x: Str
}

#[derive(Gob)]
struct ET1 {
  a: Int
  et2: ET2b?
}

#[derive(Gob)]
struct ET3 {
  a: Int
  et2: ET2b?
  different_next: ET1?
}

#[derive(Gob)]
struct ET4 {
  a: Int
  et2: Float
  next: Int
}

test "TestEncoderDecoder" {
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(ET0.new(a: 7, b: "gobs of fun")).unwrap
  d = gob.new_decoder(buf)
  x = d.decode!(ET0.new).unwrap
  assert_eq x.a, 7
  assert_eq x.b, "gobs of fun"
  assert_eq buf.len, 0
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  d2 = gob.new_decoder(buf2)
  et1 = ET1.new(a: 7, et2: ET2b.new)
  e2.encode!(et1).unwrap
  assert_eq hexof(d2.decode!(ET1.new).unwrap), hexof(et1)
  e2.encode!(et1).unwrap
  assert_eq hexof(d2.decode!(ET1.new).unwrap), hexof(et1)
  assert_eq buf2.len, 0
  e2.encode!(et1).unwrap
  assert d2.decode!(ET2b.new).err != none, "round 3: expected bad type error"
}

def bad_type[T](into: T) -> Bool { enc_dec(ET1.new(a: 7, et2: ET2b.new), into).err != none }

test "TestWrongTypeDecoder" {
  assert bad_type(ET2b.new), "no fields in common"
  assert !bad_type(ET3.new), "different name of field"
  assert bad_type(ET4.new), "different type of field"
}

#[derive(Gob)]
struct Type0 {
  a: Int
}

#[derive(Gob)]
struct HasType0 {
  t: Type0?
}

test "TestTypeToPtrType and TestPtrTypeToType" {
  assert_eq enc_dec(Type0.new(a: 7), Type0.new).unwrap.a, 7
  # (a pointer at the top level is its value; inside a struct it's `T?`)
  assert_eq (enc_dec(HasType0.new(t: Type0.new(a: 17)), HasType0.new).unwrap.t || Type0.new).a, 17
}

#[derive(Gob)]
struct Type3 {
  a: [Str]
}

test "TestSlice" {
  assert_eq enc_dec(Type3.new(a: ["hello", "world"]), Type3.new).unwrap.a, ["hello", "world"]
}

#[derive(Gob)]
struct Type5 {
  a: [Str; 3]
  b: [Byte; 3]
}

#[derive(Gob)]
struct Type6 {
  a: [Str; 2]
}

test "TestArray" {
  t5 = Type5.new(a: ["hello", ",", "world"], b: [1, 2, 3])
  t5p = enc_dec(t5, Type5.new).unwrap
  assert_eq t5p.a, t5.a
  assert_eq t5p.b, t5.b
  assert enc_dec(t5, Type6.new).err != none, "should fail with mismatched array sizes"
}

#[derive(Gob)]
struct Type7 {
  b: [Bool]
  i: [Int]
  s: [Str]
  f: [Float]
}

test "TestDefaultsInArray" {
  t7 = Type7.new(b: [false, false, true], i: [0, 0, 1], s: ["hi", "", "there"], f: [0.0, 0.0, 1.0])
  t7p = enc_dec(t7, Type7.new).unwrap
  assert_eq t7p.b, t7.b
  assert_eq t7p.i, t7.i
  assert_eq t7p.s, t7.s
  assert_eq t7p.f, t7.f
}

#[derive(Gob)]
struct StructA {
  a: Str
}

test "TestStructNonStruct" {
  assert_eq enc_dec(StructA.new(a: "hello"), StructA.new).unwrap.a, "hello"
  assert (enc_dec(StructA.new(a: "hello"), "").err?.message || "").include?("type"), "struct/non-struct"
  assert_eq enc_dec("x", "").unwrap, "x"
  assert (enc_dec("x", StructA.new).err?.message || "").include?("type"), "non-struct/struct"
}

#[derive(Gob)]
struct NewType0 {
  s: Str
}

#[derive(Gob)]
enum Any0 {
  #[field(gob: "*gob.NewType0")] N(NewType0)
  #[field(gob: "string")] S(Str)
  #[field(gob: "int")] I(Int)
}

#[derive(Gob)]
struct Struct0 {
  i: Any0
}

#[derive(Gob)]
struct HasA {
  a: Int
}

#[derive(Gob)]
struct Anys {
  xs: [Any0]
}

# Decoding into nothing (Decode(nil), or a struct with no fields) must keep
# the encoder and decoder in step: the next value still decodes.
def into_nothing[T](v: T, into_empty: Bool) {
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(v).unwrap
  d = gob.new_decoder(buf)
  if into_empty {
    d.decode!(Empty.new).unwrap
  } else {
    d.skip!.unwrap
  }
  e.encode!(NewType0.new(s: "value")).unwrap
  assert_eq d.decode!(NewType0.new).unwrap.s, "value"
}

test "TestDecodeIntoNothing" {
  into_nothing(HasA.new(a: 23), true)
  into_nothing(HasA.new(a: 23), false)
  into_nothing("hello, world", false)
  into_nothing([1, 2, 3, 4], false)
  into_nothing(Struct0.new(i: Any0.N(NewType0.new(s: "value0"))), false)
  into_nothing(Anys.new(xs: [Any0.S("hi"), Any0.N(NewType0.new(s: "value1")), Any0.I(23)]), false)
}

#[derive(Gob)]
struct Bug1Elem {
  name: Str
  id: Int
}

#[derive(Gob)]
struct Bug1StructMap {
  m: Map[Str, Bug1Elem]
}

test "TestMapBug1" {
  in_ = Bug1StructMap.new(m: {"val1" => Bug1Elem.new(name: "elem1", id: 1), "val2" => Bug1Elem.new(name: "elem2", id: 2)})
  out = enc_dec(in_, Bug1StructMap.new).unwrap
  assert_eq out.m.size, 2
  assert_eq (out.m["val2"] || Bug1Elem.new).name, "elem2"
}

#[derive(Gob)]
enum Slices {
  #[field(gob: "[]int")] I0([Int])
  #[field(gob: "[]int8")] I1([I8])
  #[field(gob: "[]uint64")] U4([U64])
  #[field(gob: "[]float64")] F1([Float])
  #[field(gob: "[]complex128")] C1([Complex])
  #[field(gob: "[]bool")] Bo([Bool])
  #[field(gob: "[]string")] St([Str])
}

#[derive(Gob)]
struct MapIface {
  m: Map[Str, Slices]
}

test "TestGobMapInterfaceEncode" {
  m = MapIface.new(m: {"i0" => Slices.I0([-1]), "i1" => Slices.I1([-1]), "u4" => Slices.U4([1]), "f1" => Slices.F1([1.0]), "c1" => Slices.C1([Complex.new(2.0, -2.0)]), "bo" => Slices.Bo([false]), "st" => Slices.St(["s"])})
  hexof(m)
  assert_eq hexof(enc_dec(m, MapIface.new).unwrap), hexof(m)
}

#[derive(Gob)]
struct Bug3 {
  num: Int
}

#[derive(Gob)]
struct Bug3s {
  xs: [Bug3?]
}

test "TestGobPtrSlices" {
  in_ = Bug3s.new(xs: [Bug3.new(num: 1), Bug3.new(num: 2)])
  assert_eq hexof(enc_dec(in_, Bug3s.new).unwrap), hexof(in_)
}

#[derive(Gob)]
enum PtrIface {
  #[field(gob: "*int")] P(Int?)
}

#[derive(Gob)]
struct NilInside {
  i: PtrIface
}

test "TestNilPointerInsideInterface" {
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  msg = e.encode!(NilInside.new(i: PtrIface.P(none))).err?.message || ""
  assert msg.include?("nil pointer") && msg.include?("interface"), msg
}

#[derive(Gob)]
struct Bug4Secret {
  #[field(gob: "-")] a: Int
}

#[derive(Gob)]
struct Bug4Public {
  name: Str
  secret: Bug4Secret
}

test "TestMultipleEncodingsOfBadType" {
  for _i in 0...2 {
    buf = bytes.new_buffer([])
    e = gob.new_encoder(buf)
    msg = e.encode!(Bug4Public.new(name: "name", secret: Bug4Secret.new(a: 1))).err?.message || ""
    assert msg.include?("no exported fields"), msg
  }
}

#[derive(Gob)]
enum ZAny {
  #[field(gob: "gob.Z")] Z(Empty)
}

#[derive(Gob)]
struct Zs {
  xs: [ZAny]
}

test "Test29ElementSlice" {
  src: [ZAny] = []
  for _i in 0...100 {
    src << ZAny.Z(Empty.new)
  }
  assert_eq enc_dec(Zs.new(xs: src), Zs.new).unwrap.xs.size, 100
}

test "TestBadData" {
  cases = [("036e6f77206973207468652074696d6520666f7220616c6c20676f6f64206d656e", "unknown type id"), ("0424666f6f", "field numbers out of bounds")]
  for c in cases {
    d = gob.new_decoder(bytes.new_buffer(hex.decode_string(c[0]).unwrap))
    msg = d.decode!(ET2b.new).err?.message || "no error"
    assert msg.include?(c[1]), "#{c[0]}: want #{c[1]}, got #{msg}"
  }
}

#[derive(Gob)]
struct TestAB {
  a: Str
  b: Int
}

test "TestDecodeErrorMultipleTypes" {
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(TestAB.new(a: "one", b: 1)).unwrap
  d = gob.new_decoder(buf)
  d.decode!(TestAB.new).unwrap
  buf.reset!
  e2 = gob.new_encoder(buf)
  e2.encode!(TestAB.new(a: "two", b: 2)).unwrap
  msg = d.decode!(TestAB.new).err?.message || ""
  assert msg.include?("duplicate type"), msg
}

#[derive(Gob)]
struct TXY {
  x: [Int]
  y: Str
}

test "TestDecodePartial" {
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  t1 = TXY.new(x: [1, 2, 3], y: "foo")
  t2 = TXY.new(x: [4, 5, 6], y: "bar")
  e.encode!(t1).unwrap
  t2start = buf.len
  e.encode!(t2).unwrap
  data = buf.bytes
  for i in 0...data.size + 1 {
    d = gob.new_decoder(bytes.new_buffer(data[0...i].dup))
    r1 = d.decode!(TXY.new)
    err = r1.err
    if err == none {
      err = d.decode!(TXY.new).err
    }
    msg = err?.message || ""
    if i == 0 || i == t2start {
      assert_eq msg, "EOF"
    } elsif i == data.size {
      assert_eq msg, ""
    } else {
      assert_eq msg, "unexpected EOF"
    }
  }
}

#[derive(Gob)]
struct LargeMap {
  m: Map[I16, [Byte; 8192]]
}

test "TestLargeMap" {
  m: Map[I16, [Byte; 8192]] = {}
  for i in 0...2500 {
    m[i.to_i16] = [0; 8192]
  }
  assert_eq enc_dec(LargeMap.new(m: m), LargeMap.new).unwrap.m.size, 2500
}
