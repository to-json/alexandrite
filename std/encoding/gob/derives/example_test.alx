# Go's example_test.go, example_interface_test.go, example_encdec_test.go.
import "bytes"
import "encoding/gob"
import "math"
import "strconv"
import "strings"

#[derive(Gob)]
struct P {
  x: Int
  y: Int
  z: Int
  name: Str
}

#[derive(Gob)]
struct Q {
  x: I32?
  y: I32?
  name: Str
}

example "basic" {
  network = bytes.new_buffer([])
  enc = gob.new_encoder(network)
  dec = gob.new_decoder(network)
  enc.encode!(P.new(x: 3, y: 4, z: 5, name: "Pythagoras")).unwrap
  enc.encode!(P.new(x: 1782, y: 1841, z: 1922, name: "Treehouse")).unwrap
  q = dec.decode!(Q.new).unwrap
  puts "\"#{q.name}\": {#{q.x || 0}, #{q.y || 0}}"
  q = dec.decode!(Q.new).unwrap
  puts "\"#{q.name}\": {#{q.x || 0}, #{q.y || 0}}"
} outputs "\"Pythagoras\": {3, 4}\n\"Treehouse\": {1782, 1841}\n"

#[derive(Gob)]
struct EPoint {
  x: Int
  y: Int
}

# Go's Pythagoras interface: here an enum, its implementations the variants.
#[derive(Gob)]
enum Pythagoras {
  #[field(gob: "gob_test.Point")] Point(EPoint)

  def hypotenuse -> Float {
    case self {
      Point(p) => math.hypot(p.x.to_f, p.y.to_f)
    }
  }
}

example "interface" {
  network = bytes.new_buffer([])
  enc = gob.new_encoder(network)
  for i in 1..3 {
    enc.encode!(Pythagoras.Point(EPoint.new(x: 3 * i, y: 4 * i))).unwrap
  }
  dec = gob.new_decoder(network)
  for _i in 1..3 {
    p = dec.decode!(Pythagoras.Point(EPoint.new)).unwrap
    puts p.hypotenuse
  }
} outputs "5\n10\n15\n"

# A type that marshals itself (Go's Vector with MarshalBinary).
struct Vector {
  x: Int
  y: Int
  z: Int

  def marshal_binary -> ~[Byte] { "#{x} #{y} #{z}\n".bytes }
  def unmarshal_binary!(data: [Byte]) -> ~Unit {
    f = strings.fields(Str.from_bytes(data))
    self.x = strconv.~atoi(f[0])
    self.y = strconv.~atoi(f[1])
    self.z = strconv.~atoi(f[2])
  }
  def self.gob_rtype(b: gob.Types) -> Int {
    t = b
    t.ext!("gob_test.Vector", gob.X_BINARY)
  }
  def gob_type(b: gob.Types) -> Int { Vector.gob_rtype(b) }
  def gob_type_name -> Str { "gob_test.Vector" }
  def self.gob_zero -> Vector { Vector.new }
  def gob_enc(e0: gob.Enc) {
    e = e0
    e.ext!(self.marshal_binary)
  }
  def self.gob_compat(d: gob.Dec, w: Int) -> ~Bool { d.ext_kind(w) == gob.X_BINARY }
  def gob_dec(d0: gob.Dec, w: Int) -> ~Vector {
    d = d0
    raw = d.~ext_bytes!
    out = self
    out.~unmarshal_binary!(raw)
    out
  }
  def gob_top(d0: gob.Dec, w: Int) -> ~Vector {
    d = d0
    fail d.mismatch("gob_test.Vector", w, false) if d.ext_kind(w) != gob.X_BINARY
    d.~single!
    self.~gob_dec(d, w)
  }
}

example "encodeDecode" {
  network = bytes.new_buffer([])
  enc = gob.new_encoder(network)
  enc.encode!(Vector.new(x: 3, y: 4, z: 5)).unwrap
  dec = gob.new_decoder(network)
  v = dec.decode!(Vector.new).unwrap
  puts "{#{v.x} #{v.y} #{v.z}}"
} outputs "{3 4 5}\n"
