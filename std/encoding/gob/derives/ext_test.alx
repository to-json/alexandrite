# Hand-written GobEncoder / BinaryMarshaler types (Go's gobencdec_test.go):
# a type outside the derive joins gob's protocol with these methods.
import "encoding/gob"
import "strconv"

struct ByteStruct {
  a: Byte

  def gob_encode -> ~[Byte] {
    b: [Byte] = [a, a +% 1, a +% 2]
    b
  }
  def gob_decode!(data: [Byte]) -> ~Unit {
    fail "EOF" if data.size == 0
    self.a = data[0]
    for i in 0...data.size {
      fail "invalid data sequence" if data[i] != self.a +% i.as_u8
    }
  }
  def self.gob_rtype(b: gob.Types) -> Int {
    t = b
    t.ext!("main.ByteStruct", gob.X_GOB)
  }
  def gob_type(b: gob.Types) -> Int {
    t = b
    t.ptr!(ByteStruct.gob_rtype(t))
  }
  def gob_type_name -> Str { "*main.ByteStruct" }
  def self.gob_zero -> ByteStruct { ByteStruct.new }
  def gob_enc(e0: gob.Enc) {
    e = e0
    e.ext!(self.gob_encode)
  }
  def self.gob_compat(d: gob.Dec, w: Int) -> ~Bool { d.ext_kind(w) == gob.X_GOB }
  def gob_dec(d0: gob.Dec, w: Int) -> ~ByteStruct {
    d = d0
    raw = d.~ext_bytes!
    z = self
    z.~gob_decode!(raw)
    z
  }
  def gob_top(d0: gob.Dec, w: Int) -> ~ByteStruct {
    d = d0
    fail d.mismatch("main.ByteStruct", w, false) if d.ext_kind(w) != gob.X_GOB
    d.~single!
    self.~gob_dec(d, w)
  }
}

struct StringStruct {
  s: Str

  def gob_encode -> ~[Byte] {
    s.bytes
  }
  def gob_decode!(data: [Byte]) -> ~Unit {
    fail "EOF" if data.size == 0
    a0 = data[0]
    for i in 0...data.size {
      fail "invalid data sequence" if data[i] != a0 +% i.as_u8
    }
    self.s = Str.from_bytes(data)
  }
  def self.gob_rtype(b: gob.Types) -> Int {
    t = b
    t.ext!("main.StringStruct", gob.X_GOB)
  }
  def gob_type(b: gob.Types) -> Int {
    t = b
    t.ptr!(StringStruct.gob_rtype(t))
  }
  def gob_type_name -> Str { "*main.StringStruct" }
  def self.gob_zero -> StringStruct { StringStruct.new }
  def gob_enc(e0: gob.Enc) {
    e = e0
    e.ext!(self.gob_encode)
  }
  def self.gob_compat(d: gob.Dec, w: Int) -> ~Bool { d.ext_kind(w) == gob.X_GOB }
  def gob_dec(d0: gob.Dec, w: Int) -> ~StringStruct {
    d = d0
    raw = d.~ext_bytes!
    z = self
    z.~gob_decode!(raw)
    z
  }
  def gob_top(d0: gob.Dec, w: Int) -> ~StringStruct {
    d = d0
    fail d.mismatch("main.StringStruct", w, false) if d.ext_kind(w) != gob.X_GOB
    d.~single!
    self.~gob_dec(d, w)
  }
}

struct ArrayStruct {
  a: [Byte]

  def gob_encode -> ~[Byte] {
    a
  }
  def gob_decode!(data: [Byte]) -> ~Unit {
    fail "wrong length in array decode" if data.size != 8192
    self.a = data
  }
  def self.gob_rtype(b: gob.Types) -> Int {
    t = b
    t.ext!("main.ArrayStruct", gob.X_GOB)
  }
  def gob_type(b: gob.Types) -> Int {
    t = b
    t.ptr!(ArrayStruct.gob_rtype(t))
  }
  def gob_type_name -> Str { "*main.ArrayStruct" }
  def self.gob_zero -> ArrayStruct { ArrayStruct.new }
  def gob_enc(e0: gob.Enc) {
    e = e0
    e.ext!(self.gob_encode)
  }
  def self.gob_compat(d: gob.Dec, w: Int) -> ~Bool { d.ext_kind(w) == gob.X_GOB }
  def gob_dec(d0: gob.Dec, w: Int) -> ~ArrayStruct {
    d = d0
    raw = d.~ext_bytes!
    z = self
    z.~gob_decode!(raw)
    z
  }
  def gob_top(d0: gob.Dec, w: Int) -> ~ArrayStruct {
    d = d0
    fail d.mismatch("main.ArrayStruct", w, false) if d.ext_kind(w) != gob.X_GOB
    d.~single!
    self.~gob_dec(d, w)
  }
}

struct Gobber {
  v: Int

  def gob_encode -> ~[Byte] {
    "VALUE=#{v}".bytes
  }
  def gob_decode!(data: [Byte]) -> ~Unit {
    t = Str.from_bytes(data)
    fail "bad" unless t.start_with?("VALUE=")
    self.v = strconv.~atoi(t[6...t.size])
  }
  def self.gob_rtype(b: gob.Types) -> Int {
    t = b
    t.ext!("main.Gobber", gob.X_GOB)
  }
  def gob_type(b: gob.Types) -> Int {
    t = b
    t.ptr!(Gobber.gob_rtype(t))
  }
  def gob_type_name -> Str { "*main.Gobber" }
  def self.gob_zero -> Gobber { Gobber.new }
  def gob_enc(e0: gob.Enc) {
    e = e0
    e.ext!(self.gob_encode)
  }
  def self.gob_compat(d: gob.Dec, w: Int) -> ~Bool { d.ext_kind(w) == gob.X_GOB }
  def gob_dec(d0: gob.Dec, w: Int) -> ~Gobber {
    d = d0
    raw = d.~ext_bytes!
    z = self
    z.~gob_decode!(raw)
    z
  }
  def gob_top(d0: gob.Dec, w: Int) -> ~Gobber {
    d = d0
    fail d.mismatch("main.Gobber", w, false) if d.ext_kind(w) != gob.X_GOB
    d.~single!
    self.~gob_dec(d, w)
  }
}

struct BinaryGobber {
  v: Int

  def marshal_binary -> ~[Byte] {
    "VALUE=#{v}".bytes
  }
  def unmarshal_binary!(data: [Byte]) -> ~Unit {
    t = Str.from_bytes(data)
    fail "bad" unless t.start_with?("VALUE=")
    self.v = strconv.~atoi(t[6...t.size])
  }
  def self.gob_rtype(b: gob.Types) -> Int {
    t = b
    t.ext!("main.BinaryGobber", gob.X_BINARY)
  }
  def gob_type(b: gob.Types) -> Int {
    t = b
    t.ptr!(BinaryGobber.gob_rtype(t))
  }
  def gob_type_name -> Str { "*main.BinaryGobber" }
  def self.gob_zero -> BinaryGobber { BinaryGobber.new }
  def gob_enc(e0: gob.Enc) {
    e = e0
    e.ext!(self.marshal_binary)
  }
  def self.gob_compat(d: gob.Dec, w: Int) -> ~Bool { d.ext_kind(w) == gob.X_BINARY }
  def gob_dec(d0: gob.Dec, w: Int) -> ~BinaryGobber {
    d = d0
    raw = d.~ext_bytes!
    z = self
    z.~unmarshal_binary!(raw)
    z
  }
  def gob_top(d0: gob.Dec, w: Int) -> ~BinaryGobber {
    d = d0
    fail d.mismatch("main.BinaryGobber", w, false) if d.ext_kind(w) != gob.X_BINARY
    d.~single!
    self.~gob_dec(d, w)
  }
}

