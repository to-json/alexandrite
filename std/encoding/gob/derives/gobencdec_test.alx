# Go's gobencdec_test.go: types that encode themselves (ext_test.alx).
# Not translated: TextMarshaler types (Go's gob no longer treats them
# specially: they are plain ints/strings, which alx has no named form of),
# TestGobEncoderExtraIndirect / TestGobEncoderIndirect*Field (pointers to
# pointers: alx has one level, `T?`), TestGobEncodeIsZero (time.Time has no
# gob protocol in alx yet), TestGobEncodePtrError (encoding an `error`),
# TestNetIP (net.IP has no gob protocol).
import "bytes"
import "encoding/gob"
import "encoding/hex"

#[derive(Gob)]
struct GobTest0 {
  #[field(gob: "X")] x: Int
  #[field(gob: "G")] g: ByteStruct?
}

#[derive(Gob)]
struct GobTest1 {
  x: Int
  g: StringStruct?
}

#[derive(Gob)]
struct GobTest2 {
  x: Int
  g: Str
}

#[derive(Gob)]
struct GobTest3 {
  x: Int
  g: Gobber?
  b: BinaryGobber?
}

#[derive(Gob)]
struct GobTest4 {
  x: Int
  v: ValueGobber
  bv: BinaryValueGobber
}

#[derive(Gob)]
struct GobTest5 {
  x: Int
  v: ValueGobber?
  bv: BinaryValueGobber?
}

#[derive(Gob)]
struct GobTest6 {
  x: Int
  v: ValueGobber
  w: ValueGobber?
  bv: BinaryValueGobber
  bw: BinaryValueGobber?
}

#[derive(Gob)]
struct GobTestIgnoreEncoder {
  x: Int
}

#[derive(Gob)]
struct GobTestValueEncDec {
  x: Int
  g: StringStruct
}

#[derive(Gob)]
struct GobTestArrayEncDec {
  x: Int
  a: ArrayStruct
}

# Encode a, decode the bytes into b.
def enc_dec[A, B](a: A, b: B) -> ~B {
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.~encode!(a)
  d = gob.new_decoder(buf)
  d.~decode!(b)
}

test "TestGobEncoderField" {
  x = enc_dec(GobTest0.new(x: 17, g: ByteStruct.new(a: 65)), GobTest0.new).unwrap
  assert_eq x.g?.a || 0, 65
  y = enc_dec(GobTest3.new(x: 17, g: Gobber.new(v: 23), b: BinaryGobber.new(v: 24)), GobTest3.new).unwrap
  assert_eq y.g?.v || 0, 23
  assert_eq y.b?.v || 0, 24
}

test "TestGobEncoderValueField" {
  x = enc_dec(GobTestValueEncDec.new(x: 17, g: StringStruct.new(s: "HIJKL")), GobTestValueEncDec.new).unwrap
  assert_eq x.g.s, "HIJKL"
}

test "TestGobEncoderArrayField" {
  a: [Byte] = [0; 8192]
  for i in 0...8192 {
    a[i] = i.as_u8
  }
  x = enc_dec(GobTestArrayEncDec.new(x: 17, a: ArrayStruct.new(a: a)), GobTestArrayEncDec.new).unwrap
  assert_eq x.a.a, a
}

test "TestGobEncoderFieldsOfDifferentType" {
  x = enc_dec(GobTest1.new(x: 17, g: StringStruct.new(s: "ABC")), GobTest0.new).unwrap
  assert_eq x.g?.a || 0, 65
  y = enc_dec(GobTest0.new(x: 17, g: ByteStruct.new(a: 88)), GobTest1.new).unwrap
  assert_eq y.g?.s || "", "XYZ"
}

test "TestGobEncoderValueEncoder" {
  x = enc_dec(GobTest4.new(x: 17, v: ValueGobber.new(v: "hello"), bv: BinaryValueGobber.new(v: "Καλημέρα")), GobTest5.new).unwrap
  assert_eq x.v?.v || "", "hello"
  assert_eq x.bv?.v || "", "Καλημέρα"
}

test "TestGobEncoderValueThenPointer" {
  x = enc_dec(GobTest6.new(x: 42, v: ValueGobber.new(v: "forty-two"), w: ValueGobber.new(v: "six-by-nine"), bv: BinaryValueGobber.new(v: "1nanocentury"), bw: BinaryValueGobber.new(v: "πseconds")), GobTest6.new).unwrap
  assert_eq x.v.v, "forty-two"
  assert_eq x.w?.v || "", "six-by-nine"
  assert_eq x.bv.v, "1nanocentury"
  assert_eq x.bw?.v || "", "πseconds"
}

test "TestGobEncoderFieldTypeError" {
  r = enc_dec(GobTest1.new(x: 17, g: StringStruct.new(s: "ABC")), GobTest2.new)
  assert (r.err?.message || "").include?("type"), "encoder to non-decoder"
  r2 = enc_dec(GobTest2.new(x: 17, g: "ABC"), GobTest1.new)
  assert (r2.err?.message || "").include?("type"), "non-encoder to decoder"
}

test "TestGobEncoderStructSingleton" {
  assert_eq enc_dec(ByteStruct.new(a: 65), ByteStruct.new).unwrap.a, 65
}

test "TestGobEncoderNonStructSingleton" {
  assert_eq enc_dec(Gobber.new(v: 1234), Gobber.new).unwrap.v, 1234
}

test "TestGobEncoderIgnoreStructField" {
  assert_eq enc_dec(GobTest0.new(x: 17, g: ByteStruct.new(a: 65)), GobTestIgnoreEncoder.new).unwrap.x, 17
}

test "TestGobEncoderIgnoreNonStructField" {
  assert_eq enc_dec(GobTest3.new(x: 17, g: Gobber.new(v: 23), b: BinaryGobber.new(v: 24)), GobTestIgnoreEncoder.new).unwrap.x, 17
}

test "TestGobEncoderIgnoreNilEncoder" {
  x = enc_dec(GobTest0.new(x: 18), GobTest0.new).unwrap
  assert_eq x.x, 18
  assert x.g == none, "G is nil"
}

# Go's bytes (go1.27.1) for a struct{F [1][1]...[1]int} 102 arrays deep, and
# a struct nested 102 deep, each decoded into struct{Hello int} with the
# nesting limit at 100.
test "TestIgnoreDepthLimit" {
  for h in [DEEP_ARRAY, DEEP_STRUCT] {
    d = gob.new_decoder(bytes.new_buffer(hex.decode_string(h).unwrap))
    dd = d.dec
    dd.set_max_depth!(100)
    r = d.decode!(GobTestIgnoreEncoder.new)
    assert_eq r.err?.message || "", "invalid nesting depth"
  }
}
