# Types shared by the derive tests and the generated vectors. Each mirrors a
# Go type of the vector generator (package main, so Go's names are main.T).
import "bytes"
import "encoding/gob"
import "encoding/hex"
import "math"
import "math/big"

#[derive(Gob)]
struct S1 {
  a: Int
  b: Str
}

#[derive(Gob)]
struct Scalars {
  i: Int
  i8: I8
  i16: I16
  i32: I32
  u8: U8
  u16: U16
  u32: U32
  u64: U64
  f: Float
  b: Bool
  s: Str
  c: Complex
  bs: [Byte]
}

#[derive(Gob)]
struct Inner {
  a: Int
}

#[derive(Gob)]
struct Outer {
  name: Str
  in_: Inner
  ins: [Inner]
  p: Inner?
  m: Map[Str, Inner]
  arr: [Int; 3]
  grid: [[Int]]
}

#[derive(Gob)]
struct Opts {
  p: Int?
  q: Str?
  r: Inner?
}

#[derive(Gob)]
struct UserRec {
  user_id: Int
  full_name: Str
  tags: [Str]
}

#[derive(Gob)]
struct Renamed {
  #[field(gob: "ID")] id: Int
  #[field(gob: "-")] skip: Int
  x: Int
}

#[derive(Gob)]
struct Empty {
}

#[derive(Gob)]
struct Maps {
  si: Map[Str, Int]
  is_: Map[Int, Str]
  sb: Map[Str, [Byte]]
}

#[derive(Gob)]
struct Bigs {
  i: big.Int?
  f: big.Float?
  r: big.Rat?
  v: big.Int
}

#[derive(Gob)]
struct Rect {
  w: Float
  h: Float
}

#[derive(Gob)]
enum Pet {
  Cat(Str)
}

#[derive(Gob)]
struct Cage {
  pet: Pet
}

#[derive(Gob)]
enum Shape {
  Circle(Float)
  Rect(Rect)
  Named(name: Str, n: I8)
  Dot
  Pair(Int, Str)
  Cage(Cage)
  #[field(gob: "int")] Num(Int)
  #[field(gob: "*big.Int")] Big(big.Int?)
}

#[derive(Gob)]
struct Holder {
  s: Shape
  ss: [Shape]
  opt: Shape?
}

#[derive(Gob)]
struct Arrays {
  a: [U8; 4]
  b: [Str; 2]
  c: [[Int; 2]; 2]
}

#[derive(Gob)]
struct Nested {
  a: [[Str]]
  m: Map[Str, [Int]]
  mm: Map[Str, Map[Str, Int]]
  ps: [Int?]
}

# The bytes of v from a fresh Encoder, as hex.
def hexof[T](v: T) -> Str {
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(v).unwrap
  hex.encode_to_string(buf.bytes)
}

# A Decoder over hex bytes.
def dec_of(h: Str) -> gob.Decoder[bytes.Buffer] { gob.new_decoder(bytes.new_buffer(hex.decode_string(h).unwrap)) }

# h decoded into a copy of zero, encoded again.
def again[T](h: Str, zero: T) -> Str { hexof(dec_of(h).decode!(zero).unwrap) }

# The error decoding h into zero gives ("" if none).
def dec_err[T](h: Str, zero: T) -> Str {
  r = dec_of(h).decode!(zero)
  if e = r.err {
    return e.message
  }
  ""
}

# Typed values for the vectors.
def i64(x: Int) -> Int { x }
def i8(x: I8) -> I8 { x }
def i16(x: I16) -> I16 { x }
def i32(x: I32) -> I32 { x }
def u8(x: U8) -> U8 { x }
def u16(x: U16) -> U16 { x }
def u32(x: U32) -> U32 { x }
def u64(x: U64) -> U64 { x }
def fb(b: U64) -> Float { math.float64frombits(b) }
def bs(x: [Byte]) -> [Byte] { x }
def ints(x: [Int]) -> [Int] { x }
def strs(x: [Str]) -> [Str] { x }
def flts(x: [Float]) -> [Float] { x }
def bools(x: [Bool]) -> [Bool] { x }
def i8s(x: [I8]) -> [I8] { x }
def u32s(x: [U32]) -> [U32] { x }
def cpxs(x: [Complex]) -> [Complex] { x }
def msi(x: Map[Str, Int]) -> Map[Str, Int] { x }
def mss(x: Map[Str, Str]) -> Map[Str, Str] { x }
def mis(x: Map[Int, Str]) -> Map[Int, Str] { x }
def mii(x: Map[Int, Int]) -> Map[Int, Int] { x }
def msf(x: Map[Str, Float]) -> Map[Str, Float] { x }
def msb(x: Map[Str, Bool]) -> Map[Str, Bool] { x }

def bi(s: Str) -> big.Int {
  z = big.new_int(0)
  if r = z.set_string!(s, 10) {
    return r
  }
  z
}
