# Generated from Go's encoding/gob (go1.27.1; encoder and decoder each in a fresh process); do not edit by hand.
# Go encodes a value, then decodes the bytes into a value of another type:
# field matching, conversions, range checks and Go's error messages.
import "fmt"

# What decoding h into a copy of zero gives: the value (%v) or the error.
def dec_show[T](h: Str, zero: T) -> Str {
  d = dec_of(h)
  r = d.decode!(zero)
  if e = r.err {
    return "error: " + e.message
  }
  fmt.sprintf("%v", r.unwrap)
}

# The same, shown by the value's to_s (enums aren't %v-printable).
def dec_show_s[T](h: Str, zero: T) -> Str {
  d = dec_of(h)
  r = d.decode!(zero)
  if e = r.err {
    return "error: " + e.message
  }
  r.unwrap.to_s
}

test "decoding into other types 0-9" {
  # S1 into S1b (by name)
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000008ff80010201017800", S1b.new), "{x 0}"
  # S1 into S1 keeps unsent fields
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000005ff80010200", S1.new(a: 9, b: "keep")), "{1 keep}"
  # S1b into S1
  assert_eq dec_show("1c7f0301010353316201ff80000102010142010c00010143010400000008ff80010162010600", S1.new), "{0 b}"
  # Outer into Small (skips everything else)
  assert_eq dec_show("", Small.new), "{o}"
  # Holder into Small (skips interfaces)
  assert_eq dec_show("", Small.new), "error: gob: type mismatch: no fields matched compiling decoder for Small"
  # Holder into HolderS
  # (Go: {[1.5 {} 2]})
  assert_eq dec_show_s("297f03010106486f6c64657201ff800001030101530110000102537301ff820001034f707401100000001aff810201010c5b5d6d61696e2e536861706501ff8200011000003fff80010b6d61696e2e436972636c650802004001030b6d61696e2e436972636c65080400fef83f086d61696e2e446f74ff8303010103446f7401ff840000000dff84010003696e740402000400", HolderS.new), "{[Circle(1.5) Dot Num(2)]}"
  # Scalars into S1 (no fields match)
  assert_eq dec_show("6f7f030101075363616c61727301ff8000010d010149010400010249380104000103493136010400010349333201040001025538010600010355313601060001035533320106000103553634010600010146010800010142010200010153010c00010143010e0001024273010a00000005ff80010200", S1.new), "error: gob: wrong type (string) for received field Scalars.B"
  # S1 into NoMatch
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000008ff80010201017800", NoMatch.new), "error: gob: type mismatch: no fields matched compiling decoder for NoMatch"
  # empty S1 into NoMatch
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000003ff8000", NoMatch.new), "error: gob: type mismatch: no fields matched compiling decoder for NoMatch"
  # Bigs into Small
  assert_eq dec_show("2d7f030101044269677301ff8000010401014901ff820001014601ff840001015201ff860001015601ff820000000aff81050102ff880000000aff83050102ff8a0000000aff85050102ff8c0000000bff80010202070302020800", Small.new), "error: gob: type mismatch: no fields matched compiling decoder for Small"
}

test "decoding into other types 10-19" {
  # int 100 into int8 field
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000006ff8001ffc800", S1i8.new), "{100 }"
  # int 300 into int8 field
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c0000000aff8001fe025801016200", S1i8.new), "error: value for \"A\" out of range"
  # int -129 into int8 field
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000007ff8001fe010100", S1i8.new), "error: value for \"A\" out of range"
  # int into uint field
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000005ff80010200", S1u.new), "error: gob: wrong type (uint64) for received field S1.A"
  # int into string field
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000005ff80010200", S1s.new), "error: gob: wrong type (string) for received field S1.A"
  # int into float field
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000005ff80010200", S1f.new), "error: gob: wrong type (float64) for received field S1.A"
  # []int into []int8
  assert_eq dec_show("177f03010102587301ff800001010102587301ff8200000013ff81020101055b5d696e7401ff82000104000007ff800102020300", I8s.new), "{[1 -2]}"
  # []int overflowing []int8
  assert_eq dec_show("177f03010102587301ff800001010102587301ff8200000013ff81020101055b5d696e7401ff82000104000009ff80010202fe019000", I8s.new), "error: value for \"element of Xs\" out of range"
  # map int into int8
  assert_eq dec_show("177f030101034d534901ff8000010101014d01ff820000001eff810401010e6d61705b737472696e675d696e7401ff8200010c0104000009ff800101016bffc700", MI8.new), "{map[k:-100]}"
  # map int overflowing int8
  assert_eq dec_show("177f030101034d534901ff8000010101014d01ff820000001eff810401010e6d61705b737472696e675d696e7401ff8200010c010400000aff800101016bfe07d000", MI8.new), "error: value for \"M\" out of range"
}

test "decoding into other types 20-29" {
  # [3]int into [4]int
  assert_eq dec_show("", A4.new), "error: gob: wrong type ([4]int) for received field Outer.Arr"
  # int into string
  assert_eq dec_show("0304000a", ""), "error: gob: decoding into local type *string, received remote type int"
  # string into int
  assert_eq dec_show("040c000173", 0), "error: gob: decoding into local type *int, received remote type string"
  # int into uint64
  assert_eq dec_show("0304000a", u64(0)), "error: gob: decoding into local type *uint64, received remote type int"
  # uint8 into int8
  assert_eq dec_show("03060005", i8(0)), "error: gob: decoding into local type *int8, received remote type uint"
  # int 200 into int8
  assert_eq dec_show("050400fe0190", i8(0)), "error: value for \"*int8\" out of range"
  # S1 into int
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000008ff80010201017800", 0), "error: gob: decoding into local type *int, received remote type S1"
  # int into S1
  assert_eq dec_show("0304000e", S1.new), "error: gob: type mismatch in decoder: want struct type main.S1; got non-struct"
  # []int into S1
  assert_eq dec_show("0b7f020102ff80000104000005ff80000102", S1.new), "error: gob: type mismatch in decoder: want struct type main.S1; got non-struct"
  # []int into []string
  assert_eq dec_show("0b7f020102ff80000104000005ff80000102", strs([])), "error: gob: decoding into local type *[]string, received remote type "
}

test "decoding into other types 30-39" {
  # map into []int
  assert_eq dec_show("0d7f040102ff8000010c0104000007ff800001016102", ints([])), "error: gob: decoding into local type *[]int, received remote type "
  # S1 into Shape
  assert_eq dec_show_s("1b7f03010102533101ff80000102010141010400010142010c00000008ff80010201017800", Shape.Dot), "error: gob: local interface type *main.Shape can only be decoded from remote interface type; received concrete type S1"
  # int into Shape
  assert_eq dec_show_s("03040006", Shape.Dot), "error: gob: local interface type *main.Shape can only be decoded from remote interface type; received concrete type int"
  # Shape into S1
  assert_eq dec_show("1410000b6d61696e2e436972636c65080400fef03f", S1.new), "error: gob: type mismatch in decoder: want struct type main.S1; got non-struct"
  # big.Int into int
  assert_eq dec_show("097f050102ff8200000006ff8000020205", 0), "error: gob: decoding into local type *int, received remote type "
  # int into big.Int
  assert_eq dec_show("0304000a", bi("0")), "error: gob: decoding into local type *big.Int, received remote type int"
  # S1 into big.Int
  assert_eq dec_show("1b7f03010102533101ff80000102010141010400010142010c00000005ff80010200", bi("0")), "error: gob: decoding into local type *big.Int, received remote type S1"
  # unregistered name
  assert_eq dec_show_s("2910000c6d61696e2e556e6b6e6f776e7f03010107556e6b6e6f776e01ff80000101010151010400000006ff8003010200", Shape.Dot), "error: gob: name not registered for interface: \"main.Unknown\""
  # Circle into Shape
  # (Go: 2.5)
  assert_eq dec_show_s("1410000b6d61696e2e436972636c65080400fe0440", Shape.Dot), "Circle(2.5)"
  # nil interface field
  # (Go: {[<nil> 1]})
  assert_eq dec_show_s("297f03010106486f6c64657201ff800001030101530110000102537301ff820001034f707401100000001aff810201010c5b5d6d61696e2e536861706501ff82000110000018ff800202000b6d61696e2e436972636c65080400fef03f00", HolderS.new), "{[Circle(0) Circle(1)]}"
}
