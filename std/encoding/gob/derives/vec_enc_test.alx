  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(S1.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Scalars
  h = ""
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Scalars.new(i: -5, i8: i8(-128), i16: i16(32767), i32: i32(-70000), u8: u8(255), u16: u16(65535), u32: u32(4000000000), u64: u64(18446744073709551615), f: fb(0x3ff4000000000000), b: true, s: "str", c: Complex.new(1.0, -1.0), bs: bs([1, 2, 3]))).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Scalars.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
}

test "vectors 104-111" {
  # Scalars sparse
  h = "6f7f030101075363616c61727301ff8000010d010149010400010249380104000103493136010400010349333201040001025538010600010355313601060001035533320106000103553634010600010146010800010142010200010153010c00010143010e0001024273010a0000000aff8006070600fef03f00"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Scalars.new(u16: u16(7), c: Complex.new(0.0, 1.0))).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Scalars.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Scalars -0.0
  h = "6f7f030101075363616c61727301ff8000010d010149010400010249380104000103493136010400010349333201040001025538010600010355313601060001035533320106000103553634010600010146010800010142010200010153010c00010143010e0001024273010a00000005ff80010200"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Scalars.new(f: fb(0x8000000000000000), i: 1)).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Scalars.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Inner
  h = "187f03010105496e6e657201ff80000101010141010400000005ff80015400"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Inner.new(a: 42)).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Inner.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Outer
  h = ""
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Outer.new(name: "o", in_: Inner.new(a: 1), ins: [Inner.new(a: 2), Inner.new, Inner.new(a: 3)], p: Inner.new(a: 4), m: {"k" => Inner.new(a: 5)}, arr: [1, 0, 3], grid: [[1, 2], [], [3]])).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Outer.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Outer zero
  h = ""
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Outer.new).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Outer.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Outer p zero inner
  h = ""
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Outer.new(p: Inner.new)).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Outer.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Opts all
  h = "247f030101044f70747301ff80000103010150010400010151010c0001015201ff8200000019ff8103010105496e6e657201ff8200010101014101040000000cff80010e0101710101020000"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Opts.new(p: 7, q: "q", r: Inner.new(a: 1))).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Opts.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Opts zero pointees
  h = "247f030101044f70747301ff80000103010150010400010151010c0001015201ff8200000019ff8103010105496e6e657201ff82000101010141010400000005ff80030000"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Opts.new(p: 0, q: "", r: Inner.new)).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Opts.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
}

