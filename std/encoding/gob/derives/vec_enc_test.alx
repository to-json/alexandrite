  h = "191000086d61696e2e446f747f03010103446f7401ff8000000004ff800100"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Shape.Dot).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Shape.Circle(0.0)).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
}

test "vectors 136-143" {
  # iface Pair
  h = "2b1000096d61696e2e506169727f030101045061697201ff800001020102463001040001024631010c0000000dff800a010e0105736576656e00"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Shape.Pair(7, "seven")).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Shape.Dot).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # iface Cage
  h = "251000096d61696e2e436167657f030101044361676501ff800001010103506574011000000015ff801201086d61696e2e4361740c050003746f6d00"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Shape.Cage(Cage.new(pet: Pet.Cat("tom")))).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Shape.Dot).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # iface int
  h = "0a100003696e7404020011"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Shape.Num(-9)).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Shape.Dot).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # iface *big.Int
  h = "141000082a6269672e496e747f050102ff820000000eff800b000902ab54a98ceb1f0ad2"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Shape.Big(bi("12345678901234567890"))).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Shape.Dot).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # iface Circle zero
  h = "1210000b6d61696e2e436972636c6508020000"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Shape.Circle(0.0)).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Shape.Dot).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Holder
  h = ""
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Holder.new(s: Shape.Circle(2.0), ss: [Shape.Dot, Shape.Num(1), Shape.Rect(Rect.new(w: 1.0))], opt: Shape.Pair(1, ""))).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Holder.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Holder nested iface
  h = ""
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Holder.new(s: Shape.Cage(Cage.new(pet: Pet.Cat("a"))), ss: [Shape.Cage(Cage.new(pet: Pet.Cat("b")))])).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Holder.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # Holder zero
  h = "297f03010106486f6c64657201ff800001030101530110000102537301ff820001034f707401100000001aff810201010c5b5d6d61696e2e536861706501ff82000110000014ff80010b6d61696e2e436972636c650802000000"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Holder.new).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Holder.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
}

test "vectors 144-147" {
  # stream S1 S1 int S1
  h = "1b7f03010102533101ff80000102010141010400010142010c00000005ff8001020008ff80020374776f00030400060bff8001080104666f757200"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(S1.new(a: 1)).unwrap
  e.encode!(S1.new(b: "two")).unwrap
  e.encode!(i64(3)).unwrap
  e.encode!(S1.new(a: 4, b: "four")).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(S1.new).unwrap).unwrap
  e2.encode!(d.decode!(S1.new).unwrap).unwrap
  e2.encode!(d.decode!(0).unwrap).unwrap
  e2.encode!(d.decode!(S1.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # stream Outer Inner
  h = ""
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Outer.new(ins: [Inner.new(a: 1)])).unwrap
  e.encode!(Inner.new(a: 2)).unwrap
  e.encode!(Outer.new(name: "x")).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Outer.new).unwrap).unwrap
  e2.encode!(d.decode!(Inner.new).unwrap).unwrap
  e2.encode!(d.decode!(Outer.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # stream ifaces
  h = ""
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(Shape.Rect(Rect.new(w: 1.0))).unwrap
  e.encode!(Shape.Rect(Rect.new(h: 1.0))).unwrap
  e.encode!(Holder.new(s: Shape.Rect(Rect.new))).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(Shape.Dot).unwrap).unwrap
  e2.encode!(d.decode!(Shape.Dot).unwrap).unwrap
  e2.encode!(d.decode!(Holder.new).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # stream mixed basics
  h = "040c0001730b7f020102ff80000104000006ff80000202040eff81040102ff8200010c0104000007ff82000101610204ff800000040a000109"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!("s").unwrap
  e.encode!([1, 2]).unwrap
  e.encode!({"a" => 1}).unwrap
  e.encode!(ints([])).unwrap
  e.encode!(bs([9])).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!("").unwrap).unwrap
  e2.encode!(d.decode!(ints([])).unwrap).unwrap
  e2.encode!(d.decode!(msi({})).unwrap).unwrap
  e2.encode!(d.decode!(ints([])).unwrap).unwrap
  e2.encode!(d.decode!(bs([])).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
}

