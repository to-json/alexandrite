# Generated from Go's encoding/gob (go1.27.1, per case in a fresh process); do not edit by hand.
import "bytes"
import "encoding/gob"
import "encoding/hex"
import "math/big"

test "vectors 0-7" {
  # int 0
  h = "03040000"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(i64(0)).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(0).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # int 1
  h = "03040002"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!(i64(1)).unwrap
