  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(mss({})).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
  # map[int]string
  h = "0d7f040102ff80000104010c000007ff800001050176"
  buf = bytes.new_buffer([])
  e = gob.new_encoder(buf)
  e.encode!({-3 => "v"}).unwrap
  assert_eq hex.encode_to_string(buf.bytes), h
  d = dec_of(h)
  buf2 = bytes.new_buffer([])
  e2 = gob.new_encoder(buf2)
  e2.encode!(d.decode!(mis({})).unwrap).unwrap
  assert_eq hex.encode_to_string(buf2.bytes), h
}

test "vectors 96-103" {
  # map[int]int
  h = "0d7f040102ff800001040104000006ff8000010204"
