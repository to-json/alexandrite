# Generated from Go's encoding/gob (go1.27.1): Go decoding what alx encodes; do not edit by hand.
# Each case: the bytes alx writes (asserted), and what a Go program decoded
# from them (Go's %+v, pointers followed, interface values as type(value)).

test "Go reads alx" {
  # map3: Go decoded {Si:map[a:1 b:2 c:3] Is:map[1:y 3:x] Sb:map[j:[] k:[1]]}
  h = ""
  assert_eq hexof(Maps.new(si: {"a" => 1, "b" => 2, "c" => 3}, is_: {3 => "x", 1 => "y"}, sb: {"k" => bs([1]), "j" => bs([])})), h
  assert_eq again(h, Maps.new), h
  # mapsempty: Go decoded {Si:map[] Is:map[] Sb:map[]}
  h = "297f030101044d61707301ff800001030102536901ff82000102497301ff84000102536201ff860000001eff810401010e6d61705b737472696e675d696e7401ff8200010c010400001eff830401010e6d61705b696e745d737472696e6701ff84000104010c000022ff85040101126d61705b737472696e675d5b5d75696e743801ff8600010c010a000003ff8000"
  assert_eq hexof(Maps.new), h
  assert_eq again(h, Maps.new), h
  # msi4: Go decoded map[a:1 b:2 m:13 z:26]
  h = "0d7f040102ff8000010c0104000010ff800004017a34016102016d1a016204"
  assert_eq hexof({"z" => 26, "a" => 1, "m" => 13, "b" => 2}), h
  assert_eq again(h, msi({})), h
  # outer: Go decoded {Name:o In:{A:1} Ins:[{A:2} {A:0}] P:&{A:4} M:map[k:{A:5} l:{A:0}] Arr:[1 0 3] Grid:[[1 2] [] [3]]}
  h = ""
  assert_eq hexof(Outer.new(name: "o", in_: Inner.new(a: 1), ins: [Inner.new(a: 2), Inner.new], p: Inner.new(a: 4), m: {"k" => Inner.new(a: 5), "l" => Inner.new}, arr: [1, 0, 3], grid: [[1, 2], [], [3]])), h
  assert_eq again(h, Outer.new), h
  # holder: Go decoded {S:main.Named({Name:n N:-3}) Ss:[main.Circle(1.5) main.Pair({F0:2 F1:two}) main.Dot({}) *big.Int(-123456789012345678901234567890) main.Cage({Pet:main.Cat(felix)})] Opt:int(5)}
  h = ""
  assert_eq hexof(Holder.new(s: Shape.Named(name: "n", n: -3), ss: [Shape.Circle(1.5), Shape.Pair(2, "two"), Shape.Dot, Shape.Big(bi("-123456789012345678901234567890")), Shape.Cage(Cage.new(pet: Pet.Cat("felix")))], opt: Shape.Num(5))), h
  assert_eq again(h, Holder.new), h
  # holdernone: Go decoded {S:main.Rect({W:1 H:2}) Ss:[] Opt:nil}
  h = "297f03010106486f6c64657201ff800001030101530110000102537301ff820001034f707401100000001aff810201010c5b5d6d61696e2e536861706501ff8200011000002bff8001096d61696e2e52656374ff83030101045265637401ff8400010201015701080001014801080000000bff840701fef03f01400000"
  assert_eq hexof(Holder.new(s: Shape.Rect(Rect.new(w: 1.0, h: 2.0)))), h
  assert_eq again(h, Holder.new), h
  # shape: Go decoded main.Pair({F0:-1 F1:neg})
  h = "2b1000096d61696e2e506169727f030101045061697201ff800001020102463001040001024631010c0000000bff8008010101036e656700"
  assert_eq hexof(Shape.Pair(-1, "neg")), h
  assert_eq again(h, Shape.Dot), h
  # bigs: Go decoded {I:98765432109876543210 F:3.141592654 R:-5/12 V:-1}
  h = "2d7f030101044269677301ff8000010401014901ff820001014601ff840001015201ff860001015601ff820000000aff81050102ff880000000aff83050102ff8a0000000aff85050102ff8c00000030ff80010a02055aa54d38e5267eea0112010a0000003500000002c90fdaa22168c00001070300000001050c0102030100"
  assert_eq hexof(Bigs.new(i: bi("98765432109876543210"), f: big.new_float(fb(0x400921fb54442d18)), r: big.new_rat(-5, 12), v: bi("-1"))), h
  assert_eq again(h, Bigs.new), h
  # scalars: Go decoded {I:-1 I8:-2 I16:-3 I32:-4 U8:5 U16:6 U32:7 U64:8 F:0.1 B:true S:héllo C:(1-1i) Bs:[0 255]}
  h = ""
  assert_eq hexof(Scalars.new(i: -1, i8: i8(-2), i16: i16(-3), i32: i32(-4), u8: u8(5), u16: u16(6), u32: u32(7), u64: u64(8), f: fb(0x3fb999999999999a), b: true, s: "héllo", c: Complex.new(fb(0x3ff0000000000000), fb(0xbff0000000000000)), bs: bs([0, 255]))), h
  assert_eq again(h, Scalars.new), h
  # user: Go decoded {UserId:99 FullName:Grace Hopper Tags:[navy cobol]}
  h = "367f030101075573657252656301ff800001030106557365724964010400010846756c6c4e616d65010c0001045461677301ff8200000016ff81020101085b5d737472696e6701ff8200010c000021ff8001ffc6010c477261636520486f707065720102046e61767905636f626f6c00"
  assert_eq hexof(UserRec.new(user_id: 99, full_name: "Grace Hopper", tags: ["navy", "cobol"])), h
  assert_eq again(h, UserRec.new), h
  # renamed: Go decoded {ID:7 X:8}
  h = "217f0301010752656e616d656401ff8000010201024944010400010158010400000007ff80010e011000"
  assert_eq hexof(Renamed.new(id: 7, skip: 1, x: 8)), h
  assert_eq again(h, Renamed.new), h
  # nested: Go decoded {A:[[x y] [z]] M:map[one:[1] two:[2 2]] Mm:map[o:map[p:1 q:2]] Ps:[&5 &6]}
  h = ""
  assert_eq hexof(Nested.new(a: [["x", "y"], ["z"]], m: {"one" => [1], "two" => [2, 2]}, mm: {"o" => { "p" => 1, "q" => 2 }}, ps: [5, 6])), h
  assert_eq again(h, Nested.new), h
  # arrays: Go decoded {A:[9 8 7 6] B:[p q] C:[[5 6] [7 8]]}
  h = ""
  assert_eq hexof(Arrays.new(a: [9, 8, 7, 6], b: ["p", "q"], c: [[5, 6], [7, 8]])), h
  assert_eq again(h, Arrays.new), h
  # ints: Go decoded [3 -3 1000000 -9223372036854775808]
  h = "0b7f020102ff80000104000013ff8000040605fd1e8480f8ffffffffffffffff"
  assert_eq hexof([3, -3, 1000000, -9223372036854775808]), h
  assert_eq again(h, ints([])), h
  # strs: Go decoded [ a ☺]
  h = "0b7f020102ff8000010c00000bff80000300016103e298ba"
  assert_eq hexof(["", "a", "☺"]), h
  assert_eq again(h, strs([])), h
}
