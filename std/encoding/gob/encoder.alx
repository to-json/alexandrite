#![overflow(wrap)]
# Encoding: Go's encoder.go and encode.go. The derived `gob_enc` methods
# write values through an `Enc`; `Encoder[Wtr]` frames them into messages on W.

struct EncState {
  types: Types
  reg: Registry
  # Go's enc.sent: the types whose descriptors went out, by Go's String()
  sent: Map[Str, Int]
  # The buffer being written; `stack` holds the ones it interrupted (an
  # interface value's data is a buffer of its own). The writer type
  # descriptors go to is the buffer below the current one, or `out`.
  cur: [Byte]
  stack: [[Byte]]
  # Bytes for the underlying writer.
  out: [Byte]
  err: Error?
}

# What derived `gob_enc` methods write to (one per Encoder; copies share it).
pub struct Enc {
  st: [EncState]

  pub def types -> Types { self.st[0].types }
  pub def registry -> Registry { self.st[0].reg }

  # Keep the first error; the value being encoded is not sent.
  pub def set_error!(e: Error) {
    self.st[0].err = e if self.st[0].err == none
  }

  pub def fail!(msg: Str) { self.set_error!(gerr(msg)) }

  pub def uint!(x: Int) { self.st[0].cur = append_uint(self.st[0].cur, x.as_u64) }
  pub def uint64!(x: U64) { self.st[0].cur = append_uint(self.st[0].cur, x) }
  pub def int!(x: Int) { self.st[0].cur = append_uint(self.st[0].cur, int_bits(x)) }
  pub def bool!(b: Bool) { self.st[0].cur << (b ? 1 : 0).as_u8 }
  pub def float!(f: Float) { self.st[0].cur = append_uint(self.st[0].cur, float_bits(f)) }

  pub def complex!(c: Complex) {
    self.st[0].cur = append_uint(self.st[0].cur, float_bits(c.real))
    self.st[0].cur = append_uint(self.st[0].cur, float_bits(c.imag))
  }

  pub def str!(s: Str) {
    self.st[0].cur = append_uint(self.st[0].cur, s.size.as_u64)
    self.st[0].cur += s.bytes
  }

  pub def bytes!(b: [Byte]) {
    self.st[0].cur = append_uint(self.st[0].cur, b.size.as_u64)
    self.st[0].cur += b
  }

  # A field's number, as the delta from the last one sent (`last`); returns it.
  pub def field!(k: Int, last: Int) -> Int {
    self.uint!(k - last)
    k
  }

  # A GobEncoder's bytes, or its error.
  pub def ext!(r: ~[Byte]) {
    if e = r.err {
      self.set_error!(e)
    } else {
      self.bytes!(r.unwrap)
    }
  }

  # Go's writeMessage(w, cur): the current buffer as a message (its length,
  # then its bytes) on the writer below it; the buffer starts again.
  def write_message! {
    b = self.st[0].cur
    m = append_uint([], b.size.as_u64) + b
    if b.size >= TOO_BIG {
      self.fail!("gob: encoder: message too big")
      m = []
    }
    n = self.st[0].stack.size
    if n == 0 {
      self.st[0].out += m
    } else {
      self.st[0].stack[n - 1] += m
    }
    self.st[0].cur = []
  }

  # sendActualType: the wire type of r's base, then (recursively) the types
  # it is made of.
  def send_actual_type!(r: Int, actual: Int) -> Bool {
    ty = self.types
    astr = ty.str_of(actual)
    return false if self.st[0].sent.key?(astr)
    info = ty.type_info!(r)
    self.int!(-info.id)
    self.st[0].cur += ty.wire_bytes(info)
    self.write_message!
    b = ty.base(r)
    self.st[0].sent[ty.str_of(b)] = info.id
    self.st[0].sent[ty.str_of(r)] = info.id if r != b
    a = ty.rt(actual)
    if a.ext == 0 {
      if a.kind == K_STRUCT {
        for f in a.ftypes {
          self.send_type!(f)
        }
      } elsif a.kind == K_ARRAY || a.kind == K_SLICE {
        self.send_type!(a.elem)
      } elsif a.kind == K_MAP {
        self.send_type!(a.key)
        self.send_type!(a.elem)
      }
    }
    true
  }

  # sendType.
  def send_type!(r: Int) -> Bool {
    ty = self.types
    b = ty.base(r)
    t = ty.rt(b)
    return self.send_actual_type!(r, b) if t.ext != 0
    return false unless t.kind == K_SLICE || t.kind == K_ARRAY || t.kind == K_MAP || t.kind == K_STRUCT
    self.send_actual_type!(r, b)
  }

  # sendTypeDescriptor and sendTypeId: the descriptors r needs, then its id.
  pub def send_type_descriptor!(r: Int) {
    ty = self.types
    b = ty.base(r)
    key = ty.rt(b).ext != 0 ? r : b
    s = ty.str_of(key)
    unless self.st[0].sent.key?(s) {
      unless self.send_type!(key) {
        info = ty.type_info!(r)
        self.st[0].sent[s] = info.id
      }
    }
    self.int!(self.st[0].sent[ty.str_of(b)] || 0)
  }

  # An interface value's concrete part (encodeInterface after the name):
  # the type's descriptors and id, then the value in a buffer of its own.
  # `iface_end!` closes it.
  pub def iface_begin!(r: Int) {
    self.send_type_descriptor!(r)
    self.st[0].stack << self.st[0].cur
    self.st[0].cur = []
  }

  pub def iface_end! {
    self.write_message!
    n = self.st[0].stack.size
    self.st[0].cur = self.st[0].stack[n - 1]
    self.st[0].stack = self.st[0].stack[0...n - 1]
  }

  # Whether r is sent as a struct (else as a singleton: field 0, the value).
  pub def struct?(r: Int) -> Bool {
    t = self.types.rt(self.types.base(r))
    t.kind == K_STRUCT && t.ext == 0
  }

  # The start of a top-level value: descriptors, the type id, and for a
  # non-struct the singleton's field number.
  pub def begin_value!(r: Int) {
    self.st[0].err = none
    self.st[0].cur = []
    self.st[0].stack = []
    self.send_type_descriptor!(r)
    self.uint!(0) unless self.struct?(r)
  }

  # The end of a top-level value: its message, unless encoding failed.
  pub def end_value! {
    if self.st[0].err == none {
      self.write_message!
    }
    self.st[0].cur = []
    self.st[0].stack = []
  }

  # Everything for the underlying writer since the last call.
  pub def take_out! -> [Byte] {
    o = self.st[0].out
    self.st[0].out = []
    o
  }

  pub def err -> Error? { self.st[0].err }
}

pub def new_enc(reg: Registry) -> Enc {
  Enc.new(st: [EncState.new(types: new_types(), reg: reg, sent: {}, cur: [], stack: [], out: [], err: none)])
}

struct EncoderState[Wtr] {
  w: Wtr
}

# Go's Encoder: values to a stream of messages on a writer.
pub struct Encoder[Wtr] {
  st: [EncoderState[Wtr]]
  en: Enc

  # Go's Encode: v's type descriptors (the first time), then v. v is anything
  # with the gob protocol: a type with `#[derive(Gob)]`, math/big's numbers,
  # and the predeclared types (Int, Str, [Byte], [Int], Map[Str, Int], ...;
  # basics.alx). An enum value is sent as an interface value (Go's
  # Encode(&iface)).
  pub def encode![T](v: T) -> ~Unit {
    using Basics
    e = self.en
    r = v.gob_type(e.types)
    e.begin_value!(r)
    v.gob_enc(e)
    e.end_value!
    o = e.take_out!
    if o.size > 0 {
      self.st[0].w.~write!(o)
    }
    if err = e.err {
      fail err
    }
  }

  # The registry the encoder names interface values by.
  pub def registry -> Registry { self.en.registry }

  # The encoder's state, for hand-written gob_enc methods and tests.
  pub def enc -> Enc { self.en }
}

# Go's NewEncoder.
pub def new_encoder[Wtr](w: Wtr) -> Encoder[Wtr] { new_encoder_with(w, default_registry()) }

# An Encoder naming interface values by `reg`.
pub def new_encoder_with[Wtr](w: Wtr, reg: Registry) -> Encoder[Wtr] {
  Encoder.new(st: [EncoderState.new(w: w)], en: new_enc(reg))
}
