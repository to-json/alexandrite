#![overflow(wrap)]
# Type descriptions and type ids: Go's type.go without reflection.
#
# Go builds the wire types from reflect.Type. Here every type that can be
# encoded describes itself as an RType (its Go kind, Go's String() and Name(),
# element / key / field types): `T.gob_rtype(types)` writes it, generated by
# `#[derive(Gob)]` (or written by hand, as math/big's are). On top of the
# RTypes this file is Go's: the `types` map, ids in Go's order (a struct
# takes its id before its fields', a slice/array/map after its elements'),
# typeInfo and the wire type an Encoder sends. Go's tables are per process;
# these are per Encoder, so a fresh Encoder numbers types as a fresh Go
# process does (from 64).

# A local type, as reflection would see it.
pub struct RType {
  kind: Int
  # Go's String() ("main.T", "[]int", "*big.Int") and Name() ("T", "int", "")
  str: Str
  name: Str
  elem: Int
  key: Int
  len: Int
  fnames: [Str]
  ftypes: [Int]
  # X_GOB / X_BINARY when the type encodes itself (GobEncoder, BinaryMarshaler)
  ext: Int
}

# Go's gobType: CommonType plus the kind's fields. kind: 0 (a predefined
# type), K_ARRAY, K_SLICE, K_STRUCT, K_MAP, or -1 (gobEncoderType).
struct GType {
  kind: Int
  name: Str
  id: Int
  elem: Int
  key: Int
  len: Int
  fnames: [Str]
  fids: [Int]
}

# Go's typeInfo: the id, and the wire type (wkind as GType.kind, 100 + x for
# an external encoding; wgt the GType it points to).
struct Info {
  id: Int
  wkind: Int
  wgt: Int
}

struct TypesState {
  rts: [RType]
  rt_by: Map[Str, Int]
  gts: [GType]
  # Go's `types`: reflect type (by String()) -> gobType
  types: Map[Str, Int]
  next_id: Int
  infos: Map[Str, Info]
}

BASIC_NAMES = ["bool", "int", "uint", "float64", "[]uint8", "string", "complex128", "interface {}"]

# The type tables of one Encoder (or of a Decoder, for error messages).
pub struct Types {
  st: [TypesState]

  # ---- describing types (what gob_rtype methods call)

  # The description named by Go's String(), if made already.
  pub def find(str: Str) -> Int? { self.st[0].rt_by[str] }

  def add!(r: RType) -> Int {
    i = self.st[0].rts.size
    self.st[0].rts << r
    self.st[0].rt_by[r.str] = i
    i
  }

  # A predeclared type by its Go name: "bool", "int", "int8" ... "uint64",
  # "uintptr", "float32", "float64", "complex64", "complex128", "string".
  pub def basic!(str: Str) -> Int {
    return self.st[0].rt_by[str] || 0 if self.st[0].rt_by.key?(str)
    k = case str {
      "bool" => K_BOOL
      "string" => K_STRING
      "float32" => K_FLOAT
      "float64" => K_FLOAT
      "complex64" => K_COMPLEX
      "complex128" => K_COMPLEX
      _ => str.start_with?("u") ? K_UINT : K_INT
    }
    self.add!(RType.new(kind: k, str: str, name: str, elem: -1, key: -1, len: 0, fnames: [], ftypes: [], ext: 0))
  }

  # []byte.
  pub def bytes! -> Int {
    return self.st[0].rt_by["[]uint8"] || 0 if self.st[0].rt_by.key?("[]uint8")
    self.add!(RType.new(kind: K_BYTES, str: "[]uint8", name: "", elem: self.basic!("uint8"), key: -1, len: 0, fnames: [], ftypes: [], ext: 0))
  }

  pub def str_of(r: Int) -> Str { self.st[0].rts[r].str }

  # []E.
  pub def slice!(e: Int) -> Int {
    if self.st[0].rts[e].kind == K_UINT && self.st[0].rts[e].str == "uint8" {
      return self.bytes!
    }
    s = "[]" + self.str_of(e)
    return self.st[0].rt_by[s] || 0 if self.st[0].rt_by.key?(s)
    self.add!(RType.new(kind: K_SLICE, str: s, name: "", elem: e, key: -1, len: 0, fnames: [], ftypes: [], ext: 0))
  }

  # [N]E.
  pub def array!(e: Int, n: Int) -> Int {
    s = "[#{n}]" + self.str_of(e)
    return self.st[0].rt_by[s] || 0 if self.st[0].rt_by.key?(s)
    self.add!(RType.new(kind: K_ARRAY, str: s, name: "", elem: e, key: -1, len: n, fnames: [], ftypes: [], ext: 0))
  }

  # map[K]V.
  pub def map!(k: Int, v: Int) -> Int {
    s = "map[" + self.str_of(k) + "]" + self.str_of(v)
    return self.st[0].rt_by[s] || 0 if self.st[0].rt_by.key?(s)
    self.add!(RType.new(kind: K_MAP, str: s, name: "", elem: v, key: k, len: 0, fnames: [], ftypes: [], ext: 0))
  }

  # *E.
  pub def ptr!(e: Int) -> Int {
    s = "*" + self.str_of(e)
    return self.st[0].rt_by[s] || 0 if self.st[0].rt_by.key?(s)
    self.add!(RType.new(kind: K_PTR, str: s, name: "", elem: e, key: -1, len: 0, fnames: [], ftypes: [], ext: 0))
  }

  # A struct type named `str` ("main.T") with the given fields.
  pub def strct!(str: Str, fnames: [Str], ftypes: [Int]) -> Int {
    return self.st[0].rt_by[str] || 0 if self.st[0].rt_by.key?(str)
    self.add!(RType.new(kind: K_STRUCT, str: str, name: short_name(str), elem: -1, key: -1, len: 0, fnames: fnames, ftypes: ftypes, ext: 0))
  }

  # An interface type (an enum, D72).
  pub def iface!(str: Str) -> Int {
    return self.st[0].rt_by[str] || 0 if self.st[0].rt_by.key?(str)
    self.add!(RType.new(kind: K_IFACE, str: str, name: short_name(str), elem: -1, key: -1, len: 0, fnames: [], ftypes: [], ext: 0))
  }

  # A type that encodes itself: x is X_GOB (gob_encode / gob_decode!) or
  # X_BINARY (marshal_binary / unmarshal_binary!). Its methods take a
  # pointer receiver, as math/big's do in Go.
  pub def ext!(str: Str, x: Int) -> Int {
    return self.st[0].rt_by[str] || 0 if self.st[0].rt_by.key?(str)
    self.add!(RType.new(kind: K_STRUCT, str: str, name: short_name(str), elem: -1, key: -1, len: 0, fnames: [], ftypes: [], ext: x))
  }

  pub def rt(i: Int) -> RType { self.st[0].rts[i] }

  # Go's userType(rt).base: the type after all pointers.
  pub def base(r: Int) -> Int {
    b = r
    while self.st[0].rts[b].kind == K_PTR {
      b = self.st[0].rts[b].elem
    }
    b
  }

  # ---- Go's type.go

  def set_type_id!(g: Int) {
    return if self.st[0].gts[g].id != 0
    self.st[0].gts[g].id = self.st[0].next_id
    self.st[0].next_id += 1
    nil
  }

  def new_gtype!(kind: Int, name: Str) -> Int {
    g = self.st[0].gts.size
    self.st[0].gts << GType.new(kind: kind, name: name, id: 0, elem: 0, key: 0, len: 0, fnames: [], fids: [])
    g
  }

  pub def id_of(g: Int) -> Int { self.st[0].gts[g].id }

  # getBaseType(name, rt).
  def get_base_type!(name: Str, r: Int) -> Int { self.get_type!(name, self.base(r)) }

  # getType(name, ut, rt): rt is a base type, or the user type of an
  # external one.
  def get_type!(name: Str, r: Int) -> Int {
    s = self.st[0].rts[r].str
    return self.st[0].types[s] || 0 if self.st[0].types.key?(s)
    g = self.new_type_object!(name, r)
    self.st[0].types[s] = g
    g
  }

  # newTypeObject.
  def new_type_object!(name: Str, r: Int) -> Int {
    t = self.st[0].rts[r]
    if self.st[0].rts[self.base(r)].ext != 0 {
      g = self.new_gtype!(-1, name)
      self.set_type_id!(g)
      return g
    }
    k = t.kind
    return T_BOOL if k == K_BOOL
    return T_INT if k == K_INT
    return T_UINT if k == K_UINT
    return T_FLOAT if k == K_FLOAT
    return T_COMPLEX if k == K_COMPLEX
    return T_STRING if k == K_STRING
    return T_INTERFACE if k == K_IFACE
    return T_BYTES if k == K_BYTES
    if k == K_ARRAY {
      g = self.new_gtype!(K_ARRAY, name)
      self.st[0].types[t.str] = g
      e = self.get_base_type!("", t.elem)
      self.set_type_id!(g)
      self.st[0].gts[g].elem = self.id_of(e)
      self.st[0].gts[g].len = t.len
      return g
    }
    if k == K_MAP {
      g = self.new_gtype!(K_MAP, name)
      self.st[0].types[t.str] = g
      kk = self.get_base_type!("", t.key)
      e = self.get_base_type!("", t.elem)
      self.set_type_id!(g)
      self.st[0].gts[g].key = self.id_of(kk)
      self.st[0].gts[g].elem = self.id_of(e)
      return g
    }
    if k == K_SLICE {
      g = self.new_gtype!(K_SLICE, name)
      self.st[0].types[t.str] = g
      e = self.get_base_type!(self.st[0].rts[t.elem].name, t.elem)
      self.set_type_id!(g)
      self.set_type_id!(e)
      self.st[0].gts[g].elem = self.id_of(e)
      return g
    }
    # a struct
    g = self.new_gtype!(K_STRUCT, name)
    self.set_type_id!(g)
    self.st[0].types[t.str] = g
    for i in 0...t.fnames.size {
      ft = t.ftypes[i]
      fb = self.st[0].rts[self.base(ft)]
      tname = fb.name == "" ? fb.str : fb.name
      gt = self.get_base_type!(tname, ft)
      self.set_type_id!(gt)
      self.st[0].gts[g].fnames << t.fnames[i]
      self.st[0].gts[g].fids << self.id_of(gt)
    }
    g
  }

  # getTypeInfo(userType(r)).
  pub def type_info!(r: Int) -> Info {
    b = self.base(r)
    key = self.st[0].rts[b].ext != 0 ? r : b
    s = self.st[0].rts[key].str
    if i = self.st[0].infos[s] { return i }
    self.build_type_info!(key)
  }

  # buildTypeInfo(ut, rt).
  def build_type_info!(r: Int) -> Info {
    t = self.st[0].rts[r]
    g = self.get_base_type!(t.name, r)
    info = Info.new(id: self.id_of(g), wkind: 0, wgt: 0)
    b = self.base(r)
    x = self.st[0].rts[b].ext
    if x != 0 {
      u = self.get_type!(t.name, r)
      info.wkind = 100 + x
      info.wgt = u
    } else {
      k = self.st[0].rts[b].kind
      if k == K_ARRAY || k == K_MAP || k == K_SLICE || k == K_STRUCT {
        info.wkind = k
        info.wgt = g
      }
    }
    self.st[0].infos[t.str] = info
    info
  }

  # The wireType of an Info, encoded (Go encodes the wireType struct, whose
  # fields are pointers: only the one in use is sent).
  def wire_bytes(info: Info) -> [Byte] {
    out: [Byte] = []
    g = self.st[0].gts[info.wgt]
    field = case info.wkind {
      K_ARRAY => 0
      K_SLICE => 1
      K_STRUCT => 2
      K_MAP => 3
      _ => 4 + info.wkind - 101
    }
    out = append_uint(out, (field + 1).as_u64)
    # CommonType (field 0 of every *Type): always sent, as a struct field is
    out << 1
    if g.name != "" {
      out << 1
      out = append_uint(out, g.name.size.as_u64)
      out += g.name.bytes
      if g.id != 0 {
        out << 1
        out = append_uint(out, int_bits(g.id))
      }
    } elsif g.id != 0 {
      out << 2
      out = append_uint(out, int_bits(g.id))
    }
    out << 0
    if info.wkind == K_ARRAY {
      out = put_int_fields(out, [g.elem, g.len])
    } elsif info.wkind == K_SLICE {
      out = put_int_fields(out, [g.elem])
    } elsif info.wkind == K_MAP {
      out = put_int_fields(out, [g.key, g.elem])
    } elsif info.wkind == K_STRUCT {
      if g.fnames.size > 0 {
        out << 1
        out = append_uint(out, g.fnames.size.as_u64)
        for i in 0...g.fnames.size {
          # fieldType{Name, Id}
          n = g.fnames[i]
          last = 0
          if n != "" {
            out << 1
            out = append_uint(out, n.size.as_u64)
            out += n.bytes
            last = 1
          }
          if g.fids[i] != 0 {
            out = append_uint(out, (2 - last).as_u64)
            out = append_uint(out, int_bits(g.fids[i]))
          }
          out << 0
        }
      }
    }
    out << 0
    out << 0
    out
  }
}

# Integer fields after CommonType (fields 1, 2, ...): only the non-zero ones.
def put_int_fields(b: [Byte], vs: [Int]) -> [Byte] {
  out = b
  last = 0
  for i in 0...vs.size {
    if vs[i] != 0 {
      out = append_uint(out, (i + 1 - last).as_u64)
      out = append_uint(out, int_bits(vs[i]))
      last = i + 1
    }
  }
  out
}

# The part of "pkg.Name" after the package (Go's Name()).
pub def short_name(s: Str) -> Str {
  i = s.size - 1
  while i >= 0 {
    return s[i + 1...s.size] if s[i] == 46
    i -= 1
  }
  s
}

# Empty tables, with Go's predefined types (ids 1-8).
pub def new_types -> Types {
  gts: [GType] = [GType.new(kind: 0, name: "", id: 0, elem: 0, key: 0, len: 0, fnames: [], fids: [])]
  for i in 0...BASIC_NAMES.size {
    gts << GType.new(kind: 0, name: BASIC_NAMES[i], id: i + 1, elem: 0, key: 0, len: 0, fnames: [], fids: [])
  }
  Types.new(st: [TypesState.new(rts: [], rt_by: {}, gts: gts, types: {}, next_id: FIRST_USER_ID, infos: {})])
}
