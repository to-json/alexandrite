test "vectors: InvalidByte messages 1" {
  assert_eq HexError.InvalidByte(b: 0).message, "encoding/hex: invalid byte: U+0000"
  assert_eq HexError.InvalidByte(b: 1).message, "encoding/hex: invalid byte: U+0001"
  assert_eq HexError.InvalidByte(b: 2).message, "encoding/hex: invalid byte: U+0002"
  assert_eq HexError.InvalidByte(b: 3).message, "encoding/hex: invalid byte: U+0003"
  assert_eq HexError.InvalidByte(b: 4).message, "encoding/hex: invalid byte: U+0004"
  assert_eq HexError.InvalidByte(b: 5).message, "encoding/hex: invalid byte: U+0005"
  assert_eq HexError.InvalidByte(b: 6).message, "encoding/hex: invalid byte: U+0006"
  assert_eq HexError.InvalidByte(b: 7).message, "encoding/hex: invalid byte: U+0007"
  assert_eq HexError.InvalidByte(b: 8).message, "encoding/hex: invalid byte: U+0008"
  assert_eq HexError.InvalidByte(b: 9).message, "encoding/hex: invalid byte: U+0009"
  assert_eq HexError.InvalidByte(b: 10).message, "encoding/hex: invalid byte: U+000A"
  assert_eq HexError.InvalidByte(b: 11).message, "encoding/hex: invalid byte: U+000B"
  assert_eq HexError.InvalidByte(b: 12).message, "encoding/hex: invalid byte: U+000C"
  assert_eq HexError.InvalidByte(b: 13).message, "encoding/hex: invalid byte: U+000D"
  assert_eq HexError.InvalidByte(b: 14).message, "encoding/hex: invalid byte: U+000E"
  assert_eq HexError.InvalidByte(b: 15).message, "encoding/hex: invalid byte: U+000F"
  assert_eq HexError.InvalidByte(b: 16).message, "encoding/hex: invalid byte: U+0010"
  assert_eq HexError.InvalidByte(b: 17).message, "encoding/hex: invalid byte: U+0011"
  assert_eq HexError.InvalidByte(b: 18).message, "encoding/hex: invalid byte: U+0012"
  assert_eq HexError.InvalidByte(b: 19).message, "encoding/hex: invalid byte: U+0013"
  assert_eq HexError.InvalidByte(b: 20).message, "encoding/hex: invalid byte: U+0014"
  assert_eq HexError.InvalidByte(b: 21).message, "encoding/hex: invalid byte: U+0015"
  assert_eq HexError.InvalidByte(b: 22).message, "encoding/hex: invalid byte: U+0016"
  assert_eq HexError.InvalidByte(b: 23).message, "encoding/hex: invalid byte: U+0017"
  assert_eq HexError.InvalidByte(b: 24).message, "encoding/hex: invalid byte: U+0018"
  assert_eq HexError.InvalidByte(b: 25).message, "encoding/hex: invalid byte: U+0019"
  assert_eq HexError.InvalidByte(b: 26).message, "encoding/hex: invalid byte: U+001A"
  assert_eq HexError.InvalidByte(b: 27).message, "encoding/hex: invalid byte: U+001B"
  assert_eq HexError.InvalidByte(b: 28).message, "encoding/hex: invalid byte: U+001C"
  assert_eq HexError.InvalidByte(b: 29).message, "encoding/hex: invalid byte: U+001D"
  assert_eq HexError.InvalidByte(b: 30).message, "encoding/hex: invalid byte: U+001E"
  assert_eq HexError.InvalidByte(b: 31).message, "encoding/hex: invalid byte: U+001F"
  assert_eq HexError.InvalidByte(b: 32).message, "encoding/hex: invalid byte: U+0020 ' '"
  assert_eq HexError.InvalidByte(b: 33).message, "encoding/hex: invalid byte: U+0021 '!'"
  assert_eq HexError.InvalidByte(b: 34).message, "encoding/hex: invalid byte: U+0022 '\"'"
  assert_eq HexError.InvalidByte(b: 35).message, "encoding/hex: invalid byte: U+0023 '\#'"
  assert_eq HexError.InvalidByte(b: 36).message, "encoding/hex: invalid byte: U+0024 '$'"
  assert_eq HexError.InvalidByte(b: 37).message, "encoding/hex: invalid byte: U+0025 '%'"
  assert_eq HexError.InvalidByte(b: 38).message, "encoding/hex: invalid byte: U+0026 '&'"
  assert_eq HexError.InvalidByte(b: 39).message, "encoding/hex: invalid byte: U+0027 '''"
  assert_eq HexError.InvalidByte(b: 40).message, "encoding/hex: invalid byte: U+0028 '('"
  assert_eq HexError.InvalidByte(b: 41).message, "encoding/hex: invalid byte: U+0029 ')'"
