test "vectors: decode_string of corrupt input 1" {
  chk_dec("fAb", "err encoding/hex: odd length hex string")
  chk_partial("fAb", "fa")
  chk_dec("2cAbxa3b", "err encoding/hex: invalid byte: U+0078 'x'")
  chk_partial("2cAbxa3b", "2cab")
