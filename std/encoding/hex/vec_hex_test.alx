# Generated from Go's encoding/hex (go run): encodings of random bytes, decodings of corrupt input, dumps; do not edit by hand.
import "bytes"

def chk_dec(s: Str, want: Str) {
  r = decode_string(s)
  got = "?"
  if v = r.ok {
    got = "ok " + encode_to_string(v)
  } else if e = r.err {
    got = "err " + e.message
  }
  assert_eq got, want
}

# decode writes the bytes before an error into dst, as Go's does.
def chk_partial(s: Str, want: Str) {
  dst: [Byte] = [0; s.size]
  assert decode(dst, s.bytes.to_a).err?
  n = want.size / 2
  assert_eq encode_to_string(dst[0...n]), want
}

# Reads in pieces of the given size from a reader handing out the chunks.
def chk_stream(chunks: [Str], size: Int, want: Str) {
  d = new_decoder(chunk_reader(chunks))
  out: [Byte] = []
  p: [Byte] = [0; size]
  got = ""
  loop {
    r = d.read!(p)
    if e = r.err {
      got = "err " + e.message
      break
    }
    n = r.unwrap
    if n == 0 {
      got = "ok " + encode_to_string(out)
      break
    }
    out = out + p[0...n]
  }
  assert_eq got, want
}

test "vectors: encode_to_string / decode_string round trip 1" {
  assert_eq encode_to_string(bs([])), ""
  assert_eq ~decode_string(""), bs([])
  assert_eq encode_to_string(bs([29])), "1d"
  assert_eq ~decode_string("1D"), bs([29])
  assert_eq encode_to_string(bs([114, 149])), "7295"
  assert_eq ~decode_string("7295"), bs([114, 149])
