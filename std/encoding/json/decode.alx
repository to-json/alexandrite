#![overflow(wrap)]
# Decoding: the Decoder that derived `json_dec` methods read from, the syntax
# checker, and the number/string scanners.

import "strconv"
import "unicode/utf8"

MAX_DEPTH = 10000

# Index of the first non-space byte at or after p (JSON's four spaces).
def skip_ws(s: Str, p0: Int) -> Int {
  p = p0
  n = s.size
  while p < n {
    c = s[p]
    break if c != 32 && c != 10 && c != 13 && c != 9
    p += 1
  }
  p
}

def is_digit(c: Byte) -> Bool { c >= 48 && c <= 57 }

# The end of the number token starting at p (s[p] is '-' or a digit), after
# checking JSON's number grammar. Returns the end index.
def number_end(s: Str, p0: Int) -> ~Int<JsonError> {
  n = s.size
  p = p0
  if s[p] == 45 {
    p += 1
    fail err_eof(p) if p >= n
    fail err_char(s[p], "in numeric literal", p) if !is_digit(s[p])
  }
  if s[p] == 48 {
    p += 1
  } else {
    while p < n && is_digit(s[p]) { p += 1 }
  }
  if p < n && s[p] == 46 {
    p += 1
    fail err_eof(p) if p >= n
    fail err_char(s[p], "after decimal point in numeric literal", p) if !is_digit(s[p])
    while p < n && is_digit(s[p]) { p += 1 }
  }
  if p < n && (s[p] == 101 || s[p] == 69) {
    p += 1
    fail err_eof(p) if p >= n
    if s[p] == 43 || s[p] == 45 {
      p += 1
      fail err_eof(p) if p >= n
    }
    fail err_char(s[p], "in exponent of numeric literal", p) if !is_digit(s[p])
    while p < n && is_digit(s[p]) { p += 1 }
  }
  p
}

# Checks that s[p...] starts with the literal word (true, false, null); returns
# the index after it.
def literal_end(s: Str, p: Int, word: Str) -> ~Int<JsonError> {
  n = s.size
  i = 1
  while i < word.size {
    fail err_eof(p + i) if p + i >= n
    if s[p + i] != word[i] {
      fail err_char(s[p + i], "in literal " + word + " (expecting " + quote_char(word[i].to_i) + ")", p + i)
    }
    i += 1
  }
  p + word.size
}

# The kind of value starting at p, as Go names it in type errors.
def kind_word(c: Byte) -> Str {
  return "string" if c == 34
  return "object" if c == 123
  return "array" if c == 91
  return "bool" if c == 116 || c == 102
  return "null" if c == 110
  "number"
}

# Where s[p] (a byte at the start of a value) can't start one.
def begin_value_err(s: Str, p: Int) -> JsonError {
  err_char(s[p], "looking for beginning of value", p)
}

# Parse the 4 hex digits of a \u escape at s[p...p+4]; -1 if not hex (and the
# bad index in `bad[0]` is found by the caller).
def hex4(s: Str, p: Int) -> Int {
  v = 0
  k = 0
  while k < 4 {
    c = s[p + k].to_i
    d = 0
    if c >= 48 && c <= 57 {
      d = c - 48
    } else if c >= 97 && c <= 102 {
      d = c - 87
    } else if c >= 65 && c <= 70 {
      d = c - 55
    } else {
      return -1
    }
    v = v * 16 + d
    k += 1
  }
  v
}

# Skips one value starting at p (after whitespace) while checking its syntax;
# returns the index after it. `depth` counts open arrays and objects.
def skip_value(s: Str, p0: Int, depth: Int) -> ~Int<JsonError> {
  n = s.size
  p = skip_ws(s, p0)
  fail err_eof(p) if p >= n
  c = s[p]
  if c == 34 {
    return ~string_end(s, p)
  }
  if c == 123 {
    fail JsonError.Invalid(msg: "exceeded max depth", offset: p) if depth >= MAX_DEPTH
    p = skip_ws(s, p + 1)
    fail err_eof(p) if p >= n
    if s[p] == 125 {
      return p + 1
    }
    loop {
      fail err_char(s[p], "looking for beginning of object key string", p) if s[p] != 34
      p = ~string_end(s, p)
      p = skip_ws(s, p)
      fail err_eof(p) if p >= n
      fail err_char(s[p], "after object key", p) if s[p] != 58
      p = ~skip_value(s, p + 1, depth + 1)
      p = skip_ws(s, p)
      fail err_eof(p) if p >= n
      if s[p] == 125 {
        return p + 1
      }
      fail err_char(s[p], "after object key:value pair", p) if s[p] != 44
      p = skip_ws(s, p + 1)
      fail err_eof(p) if p >= n
    }
  }
  if c == 91 {
    fail JsonError.Invalid(msg: "exceeded max depth", offset: p) if depth >= MAX_DEPTH
    p = skip_ws(s, p + 1)
    fail err_eof(p) if p >= n
    if s[p] == 93 {
      return p + 1
    }
    loop {
      p = ~skip_value(s, p, depth + 1)
      p = skip_ws(s, p)
      fail err_eof(p) if p >= n
      if s[p] == 93 {
        return p + 1
      }
      fail err_char(s[p], "after array element", p) if s[p] != 44
      p += 1
    }
  }
  if c == 116 {
    return ~literal_end(s, p, "true")
  }
  if c == 102 {
    return ~literal_end(s, p, "false")
  }
  if c == 110 {
    return ~literal_end(s, p, "null")
  }
  if c == 45 || is_digit(c) {
    return ~number_end(s, p)
  }
  fail begin_value_err(s, p)
}

# The index after the string literal starting at p (s[p] is the opening quote),
# checking escapes and control characters.
def string_end(s: Str, p0: Int) -> ~Int<JsonError> {
  n = s.size
  p = p0 + 1
  while p < n {
    c = s[p]
    if c == 34 {
      return p + 1
    }
    if c < 32 {
      fail err_char(c, "in string literal", p)
    }
    if c == 92 {
      p += 1
      fail err_eof(p) if p >= n
      e = s[p]
      if e == 117 {
        k = 1
        while k <= 4 {
          fail err_eof(p + k) if p + k >= n
          h = s[p + k].to_i
          ok = (h >= 48 && h <= 57) || (h >= 97 && h <= 102) || (h >= 65 && h <= 70)
          fail err_char(s[p + k], "in \\u hexadecimal character escape", p + k) if !ok
          k += 1
        }
        p += 4
      } else if !(e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116) {
        fail err_char(e, "in string escape code", p)
      }
    }
    p += 1
  }
  fail err_eof(n)
}

# Is s one valid JSON text? The error says what is wrong and where.
pub def check(s: Str) -> ~Unit<JsonError> {
  p = ~skip_value(s, 0, 0)
  p = skip_ws(s, p)
  fail err_char(s[p], "after top-level value", p) if p < s.size
}

# Go's json.Valid.
pub def valid(s: Str) -> Bool {
  r = check(s)
  r.ok?
}

struct DState {
  pos: Int
  key: Str
  ctx: Str
  wrapped: Bool
  fresh: Bool
}

# The input side. Copies share the position (GO-VS-RUBY D36). Derived
# `json_dec` methods call these in a fixed pattern; each reads the next value
# (spaces before it are skipped) and leaves the position after it.
pub struct Decoder {
  s: Str
  st: [DState]

  pub def pos -> Int { st[0].pos }

  # The key found by the last `next_key!`.
  pub def key -> Str { st[0].key }

  pub def wrapped -> Bool { st[0].wrapped }

  # Names the field being read, for type errors ("User.age").
  pub def at!(ctx: Str) {
    self.st[0].ctx = ctx
  }

  def type_err(p: Int, got: Str, want: Str) -> JsonError {
    JsonError.Type(value: got, want: want, field: st[0].ctx, offset: p)
  }

  # The first byte index of the next value; fails at the end of input.
  def start(want: Str) -> ~Int<JsonError> {
    p = skip_ws(s, st[0].pos)
    fail err_eof(p) if p >= s.size
    p
  }

  # ---- null

  # If the next value is null, consumes it and returns true.
  pub def take_null! -> ~Bool<JsonError> {
    p = skip_ws(s, st[0].pos)
    fail err_eof(p) if p >= s.size
    return false if s[p] != 110
    e = ~literal_end(s, p, "null")
    self.st[0].pos = e
    true
  }

  # ---- scalars (null reads as the zero value, as in Go)

  pub def bool! -> ~Bool<JsonError> {
    p = self.~start("bool")
    c = s[p]
    if c == 116 {
      self.st[0].pos = ~literal_end(s, p, "true")
      return true
    }
    if c == 102 {
      self.st[0].pos = ~literal_end(s, p, "false")
      return false
    }
    if c == 110 {
      self.st[0].pos = ~literal_end(s, p, "null")
      return false
    }
    e = ~skip_value(s, p, 0)
    fail type_err(p, kind_word(c), "Bool")
  }

  # The text of the number at p, checking the type; null gives "".
  def number_text!(p: Int, want: Str) -> ~Str<JsonError> {
    c = s[p]
    if c == 110 {
      self.st[0].pos = ~literal_end(s, p, "null")
      return ""
    }
    if c == 45 || is_digit(c) {
      e = ~number_end(s, p)
      self.st[0].pos = e
      return s[p...e]
    }
    _ = ~skip_value(s, p, 0)
    fail type_err(p, kind_word(c), want)
  }

  # An Int in [lo, hi] given as a decimal integer.
  def int_in!(p: Int, want: Str, neg_lim: U64, pos_lim: U64) -> ~Int<JsonError> {
    txt = ~number_text!(p, want)
    return 0 if txt.size == 0
    i = 0
    neg = false
    if txt[0] == 45 {
      neg = true
      i = 1
    }
    u: U64 = 0
    lim = neg ? neg_lim : pos_lim
    n = txt.size
    while i < n {
      c = txt[i]
      fail type_err(p, "number " + txt, want) if !is_digit(c)
      d = (c - 48).to_u64
      # u * 10 + d must stay <= lim
      fail type_err(p, "number " + txt, want) if u > (lim - d) / 10
      u = u * 10 + d
      i += 1
    }
    return 0 -% u.as_i64 if neg
    u.as_i64
  }

  pub def int! -> ~Int<JsonError> {
    p = self.~start("Int")
    self.~int_in!(p, "Int", 9223372036854775808, 9223372036854775807)
  }

  # A signed integer of `bits` bits (the caller converts with as_i8 ...).
  pub def sint!(bits: Int) -> ~Int<JsonError> {
    p = self.~start("Int")
    one: U64 = 1
    half = one << (bits - 1)
    name = "I" + bits.to_s
    self.~int_in!(p, name, half, half - 1)
  }

  # An unsigned integer of `bits` bits.
  pub def uint!(bits: Int) -> ~U64<JsonError> {
    p = self.~start("Int")
    txt = ~number_text!(p, "U" + bits.to_s)
    return 0 if txt.size == 0
    one: U64 = 1
    lim: U64 = 18446744073709551615
    lim = (one << bits) - 1 if bits < 64
    u: U64 = 0
    i = 0
    n = txt.size
    while i < n {
      c = txt[i]
      fail type_err(p, "number " + txt, "U" + bits.to_s) if !is_digit(c)
      d = (c - 48).to_u64
      fail type_err(p, "number " + txt, "U" + bits.to_s) if u > (lim - d) / 10
      u = u * 10 + d
      i += 1
    }
    u
  }

  pub def float! -> ~Float<JsonError> {
    p = self.~start("Float")
    txt = ~number_text!(p, "Float")
    return 0.0 if txt.size == 0
    f = parse_number(txt)
    fail type_err(p, "number " + txt, "Float") if f.none?
    f || 0.0
  }

  # ---- strings

  # Reads the string literal at p (s[p] is the opening quote); leaves the
  # position after it. Escapes are decoded; invalid UTF-8 becomes U+FFFD.
  def read_string!(p: Int) -> ~Str<JsonError> {
    n = s.size
    i = p + 1
    start = i
    # Fast path: plain ASCII with no escapes.
    while i < n {
      c = s[i]
      if c == 34 {
        self.st[0].pos = i + 1
        return s[start...i]
      }
      break if c == 92 || c >= 128 || c < 32
      i += 1
    }
    b: [Byte] = []
    j = start
    while j < i {
      b << s[j]
      j += 1
    }
    while i < n {
      c = s[i]
      if c == 34 {
        self.st[0].pos = i + 1
        return Str.from_bytes(b)
      }
      if c < 32 {
        fail err_char(c, "in string literal", i)
      }
      if c == 92 {
        i += 1
        fail err_eof(i) if i >= n
        e = s[i]
        if e == 34 || e == 92 || e == 47 {
          b << e
        } else if e == 98 {
          b << 8
        } else if e == 102 {
          b << 12
        } else if e == 110 {
          b << 10
        } else if e == 114 {
          b << 13
        } else if e == 116 {
          b << 9
        } else if e == 117 {
          k = 1
          while k <= 4 {
            fail err_eof(i + k) if i + k >= n
            h = s[i + k].to_i
            ok = (h >= 48 && h <= 57) || (h >= 97 && h <= 102) || (h >= 65 && h <= 70)
            fail err_char(s[i + k], "in \\u hexadecimal character escape", i + k) if !ok
            k += 1
          }
          r = hex4(s, i + 1)
          i += 4
          if r >= 0xD800 && r < 0xDC00 {
            # a high surrogate: needs \uDC00..\uDFFF right after
            if i + 6 < n && s[i + 1] == 92 && s[i + 2] == 117 {
              lo = hex4(s, i + 3)
              if lo >= 0xDC00 && lo < 0xE000 {
                r = 0x10000 + ((r - 0xD800) << 10) + (lo - 0xDC00)
                i += 6
              } else {
                r = 0xFFFD
              }
            } else {
              r = 0xFFFD
            }
          } else if r >= 0xDC00 && r < 0xE000 {
            r = 0xFFFD
          }
          b = push_rune(b, r)
        } else {
          fail err_char(e, "in string escape code", i)
        }
        i += 1
      } else if c < 128 {
        b << c
        i += 1
      } else {
        rr, w = utf8.decode_rune_at(s, i)
        if rr == 0xFFFD && w == 1 {
          b << 0xEF
          b << 0xBF
          b << 0xBD
        } else {
          k = 0
          while k < w {
            b << s[i + k]
            k += 1
          }
        }
        i += w
      }
    }
    fail err_eof(n)
  }

  pub def str! -> ~Str<JsonError> {
    p = self.~start("Str")
    c = s[p]
    return ~read_string!(p) if c == 34
    if c == 110 {
      self.st[0].pos = ~literal_end(s, p, "null")
      return ""
    }
    _ = ~skip_value(s, p, 0)
    fail type_err(p, kind_word(c), "Str")
  }

  # ---- objects

  # Consumes `{`. False if the value was null (then there is nothing to read).
  pub def open_obj! -> ~Bool<JsonError> {
    p = self.~start("object")
    c = s[p]
    if c == 123 {
      self.st[0].pos = p + 1
      self.st[0].fresh = true
      return true
    }
    if c == 110 {
      self.st[0].pos = ~literal_end(s, p, "null")
      return false
    }
    _ = ~skip_value(s, p, 0)
    fail type_err(p, kind_word(c), "object")
  }

  # The next member: reads its key (see `key`) and the colon, leaving the
  # position at the value; false at the closing `}`.
  pub def next_key! -> ~Bool<JsonError> {
    n = s.size
    p = skip_ws(s, st[0].pos)
    fail err_eof(p) if p >= n
    c = s[p]
    if c == 125 {
      self.st[0].pos = p + 1
      self.st[0].fresh = false
      return false
    }
    if !st[0].fresh {
      fail err_char(c, "after object key:value pair", p) if c != 44
      p = skip_ws(s, p + 1)
      fail err_eof(p) if p >= n
    }
    fail err_char(s[p], "looking for beginning of object key string", p) if s[p] != 34
    k = ~read_string!(p)
    q = skip_ws(s, st[0].pos)
    fail err_eof(q) if q >= n
    fail err_char(s[q], "after object key", q) if s[q] != 58
    self.st[0].pos = q + 1
    self.st[0].key = k
    self.st[0].fresh = false
    true
  }

  # ---- arrays

  # Consumes `[`. False if the value was null.
  pub def open_arr! -> ~Bool<JsonError> {
    p = self.~start("array")
    c = s[p]
    if c == 91 {
      self.st[0].pos = p + 1
      self.st[0].fresh = true
      return true
    }
    if c == 110 {
      self.st[0].pos = ~literal_end(s, p, "null")
      return false
    }
    _ = ~skip_value(s, p, 0)
    fail type_err(p, kind_word(c), "array")
  }

  # True if another element follows (the position is then at it); false at `]`.
  pub def more! -> ~Bool<JsonError> {
    n = s.size
    p = skip_ws(s, st[0].pos)
    fail err_eof(p) if p >= n
    c = s[p]
    if c == 93 {
      self.st[0].pos = p + 1
      self.st[0].fresh = false
      return false
    }
    if st[0].fresh {
      self.st[0].fresh = false
      self.st[0].pos = p
      return true
    }
    fail err_char(c, "after array element", p) if c != 44
    self.st[0].pos = p + 1
    true
  }

  # ---- tuples (fixed-length arrays)

  pub def open_tuple! -> ~Unit<JsonError> {
    p = self.~start("array")
    c = s[p]
    if c == 91 {
      self.st[0].pos = p + 1
      self.st[0].fresh = true
      return
    }
    _ = ~skip_value(s, p, 0)
    fail type_err(p, kind_word(c), "tuple")
  }

  # Moves to element k of an n-element tuple.
  pub def tuple_next!(k: Int, n: Int) -> ~Unit<JsonError> {
    len = s.size
    p = skip_ws(s, st[0].pos)
    fail err_eof(p) if p >= len
    c = s[p]
    fail JsonError.Type(value: "array of length " + k.to_s, want: "tuple of length " + n.to_s, field: st[0].ctx, offset: p) if c == 93
    if k > 0 {
      fail err_char(c, "after array element", p) if c != 44
      self.st[0].pos = p + 1
    } else {
      self.st[0].pos = p
    }
  }

  pub def tuple_end!(n: Int) -> ~Unit<JsonError> {
    len = s.size
    p = skip_ws(s, st[0].pos)
    fail err_eof(p) if p >= len
    fail JsonError.Type(value: "array of length more than " + n.to_s, want: "tuple of length " + n.to_s, field: st[0].ctx, offset: p) if s[p] != 93
    self.st[0].pos = p + 1
    self.st[0].fresh = false
  }

  # ---- enums

  # An enum value: a string (a unit variant) or `{"Variant": payload`. Returns
  # the variant's name; `wrapped` says whether a payload follows.
  pub def variant! -> ~Str<JsonError> {
    p = self.~start("enum")
    c = s[p]
    if c == 34 {
      self.st[0].wrapped = false
      return ~read_string!(p)
    }
    if c == 123 {
      q = skip_ws(s, p + 1)
      fail err_eof(q) if q >= s.size
      fail err_char(s[q], "looking for beginning of object key string", q) if s[q] != 34
      k = ~read_string!(q)
      r = skip_ws(s, st[0].pos)
      fail err_eof(r) if r >= s.size
      fail err_char(s[r], "after object key", r) if s[r] != 58
      self.st[0].pos = r + 1
      self.st[0].wrapped = true
      return k
    }
    _ = ~skip_value(s, p, 0)
    fail type_err(p, kind_word(c), "enum")
  }

  # A unit variant may be written `{"V": null}`; anything after the colon is skipped.
  pub def unit_variant!(wrapped: Bool) -> ~Unit<JsonError> {
    if wrapped {
      q = st[0].pos
      self.st[0].pos = ~skip_value(s, q, 0)
    }
  }

  pub def need_payload!(wrapped: Bool) -> ~Unit<JsonError> {
    if !wrapped {
      fail JsonError.Invalid(msg: "variant " + st[0].ctx + " needs a payload: {\"Variant\": ...}", offset: st[0].pos)
    }
  }

  # Closes the `}` of a `{"Variant": payload}`.
  pub def end_variant!(wrapped: Bool) -> ~Unit<JsonError> {
    if wrapped {
      p = skip_ws(s, st[0].pos)
      fail err_eof(p) if p >= s.size
      fail err_char(s[p], "after object key:value pair", p) if s[p] != 125
      self.st[0].pos = p + 1
    }
  }

  pub def bad_variant(owner: Str, name: Str) -> JsonError {
    JsonError.Invalid(msg: "unknown variant " + quote(name) + " for " + owner, offset: st[0].pos)
  }

  pub def missing_field(ctx: Str) -> JsonError {
    JsonError.Invalid(msg: "missing field in " + ctx, offset: st[0].pos)
  }

  # ---- skipping and the end

  # Skips the next value (any), checking its syntax.
  pub def skip! -> ~Unit<JsonError> {
    q = st[0].pos
    self.st[0].pos = ~skip_value(s, q, 0)
  }

  # The input must hold nothing more but spaces.
  pub def done! -> ~Unit<JsonError> {
    p = skip_ws(s, st[0].pos)
    fail err_char(s[p], "after top-level value", p) if p < s.size
  }
}

pub def new_decoder(s: Str) -> Decoder {
  Decoder.new(s: s, st: [DState.new(pos: 0, key: "", ctx: "", wrapped: false, fresh: false)])
}

# ---------------------------------------------------------------- numbers

POW10 = [1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0, 1000000000.0, 10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0, 100000000000000.0, 1000000000000000.0, 10000000000000000.0, 100000000000000000.0, 1000000000000000000.0, 10000000000000000000.0, 100000000000000000000.0, 1000000000000000000000.0, 10000000000000000000000.0]

# The Float of a number token (grammar already checked); none if it is out of
# range. Short decimals take an exact fast path (mantissa below 2^53, power of
# ten up to 22), the rest goes through strconv.
def parse_number(t: Str) -> Float? {
  n = t.size
  i = 0
  neg = false
  if t[0] == 45 {
    neg = true
    i = 1
  }
  mant: U64 = 0
  digits = 0
  frac = 0
  seen_dot = false
  while i < n {
    c = t[i]
    if is_digit(c) {
      if digits < 19 {
        mant = mant * 10 + (c - 48).to_u64
        digits += 1 if mant > 0
        frac += 1 if seen_dot
      } else {
        return slow_number(t)
      }
    } else if c == 46 {
      seen_dot = true
    } else {
      break
    }
    i += 1
  }
  ex = 0
  if i < n {
    # e or E
    i += 1
    eneg = false
    if t[i] == 45 {
      eneg = true
      i += 1
    } else if t[i] == 43 {
      i += 1
    }
    while i < n {
      ex = ex * 10 + (t[i] - 48).to_i
      return slow_number(t) if ex > 100000
      i += 1
    }
    ex = -ex if eneg
  }
  e10 = ex - frac
  limit: U64 = 9007199254740992
  if mant <= limit && e10 >= -22 && e10 <= 22 {
    f = mant.to_i.to_f
    if e10 < 0 {
      f = f / POW10[-e10]
    } else {
      f = f * POW10[e10]
    }
    return neg ? -f : f
  }
  slow_number(t)
}

def slow_number(t: Str) -> Float? {
  r = strconv.parse_float(t)
  return none if r.err?
  r.unwrap
}
