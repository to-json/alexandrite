#![overflow(wrap)]
# Decoding: the Decoder that derived `json_dec` methods read from, the syntax
# checker, and the number/string scanners.
#
# Speed shapes this file. A fallible call returns the program's whole Error sum
# (hundreds of bytes), so nothing on the hot path is fallible: the scanners
# return an index, or a negative error code (see `code`), and the Decoder's
# errors are sticky: the first one is kept, every later call returns at once
# with a zero value, and `done!` (the one fallible method) reports it.

import "bytes"
import "encoding/base64"
import "io"
import "strconv"
import "strings"
import "unicode/utf8"

MAX_DEPTH = 10000

# ---- error codes: -(1 + pos * 64 + kind)
E_EOF = 0
E_NUM = 1
E_DEC = 2
E_EXP = 3
E_STRLIT = 4
E_ESC = 5
E_HEX = 6
E_BEGIN = 7
E_KEY = 8
E_ELEM = 9
E_PAIR = 10
E_KEYSTART = 11
E_TOP = 12
E_DEPTH = 13
# 16 + 5 * word + i: byte i of "true" / "false" / "null" was wrong
E_LIT = 16

def code(pos: Int, kind: Int) -> Int { -(1 + pos * 64 + kind) }

# The error a code stands for (only built on the cold path).
def err_from(s: Str, c: Int) -> JsonError {
  v = -c - 1
  pos = v / 64
  kind = v % 64
  return err_eof(pos) if kind == E_EOF
  return JsonError.Syntax(msg: "exceeded max depth", offset: pos + 1) if kind == E_DEPTH
  return err_escape(s, pos, pos + 2) if kind == E_ESC
  if kind == E_HEX {
    e = pos + 6
    e = s.size if e > s.size
    return err_escape(s, pos, e)
  }
  if kind >= E_LIT {
    w = (kind - E_LIT) / 5
    i = (kind - E_LIT) % 5
    word = w == 0 ? "true" : (w == 1 ? "false" : "null")
    return err_char(s, pos, "in literal " + word + " (expecting " + strconv.quote_rune(word[i].to_i32) + ")")
  }
  ctx = "looking for beginning of value"
  ctx = "in numeric literal" if kind == E_NUM
  ctx = "in string" if kind == E_STRLIT
  ctx = "after object key" if kind == E_KEY
  ctx = "after array element" if kind == E_ELEM
  ctx = "after object key:value pair" if kind == E_PAIR
  ctx = "looking for beginning of object key string" if kind == E_KEYSTART
  ctx = "after top-level value" if kind == E_TOP
  err_char(s, pos, ctx)
}

# Index of the first non-space byte at or after p (JSON's four spaces).
def skip_ws(s: Str, p0: Int) -> Int {
  p = p0
  n = s.size
  while p < n {
    c = s[p]
    break if c != 32 && c != 10 && c != 13 && c != 9
    p += 1
  }
  p
}

def is_digit(c: Byte) -> Bool { c >= 48 && c <= 57 }

# The end of the number token starting at p (s[p] is '-' or a digit), after
# checking JSON's number grammar; or an error code.
def num_end(s: Str, p0: Int) -> Int {
  n = s.size
  p = p0
  if s[p] == 45 {
    p += 1
    return code(p0, E_EOF) if p >= n
    return code(p, E_NUM) if !is_digit(s[p])
  }
  if s[p] == 48 {
    p += 1
  } else {
    while p < n && is_digit(s[p]) { p += 1 }
  }
  if p < n && s[p] == 46 {
    p += 1
    return code(p0, E_EOF) if p >= n
    return code(p, E_NUM) if !is_digit(s[p])
    while p < n && is_digit(s[p]) { p += 1 }
  }
  if p < n && (s[p] == 101 || s[p] == 69) {
    p += 1
    return code(p0, E_EOF) if p >= n
    if s[p] == 43 || s[p] == 45 {
      p += 1
      return code(p0, E_EOF) if p >= n
    }
    return code(p, E_NUM) if !is_digit(s[p])
    while p < n && is_digit(s[p]) { p += 1 }
  }
  p
}

# The end of the literal word (true, false, null) at p; or an error code.
def lit_end(s: Str, p: Int, word: Str) -> Int {
  n = s.size
  w = word.size == 5 ? 1 : (word[0] == 110 ? 2 : 0)
  i = 1
  while i < word.size {
    return code(p + i, E_EOF) if p + i >= n
    return code(p + i, E_LIT + 5 * w + i) if s[p + i] != word[i]
    i += 1
  }
  p + word.size
}

# The kind of value starting with byte c, as Go names it in type errors.
def kind_word(c: Byte) -> Str {
  return "string" if c == 34
  return "object" if c == 123
  return "array" if c == 91
  return "bool" if c == 116 || c == 102
  return "null" if c == 110
  "number"
}

# Parse the 4 hex digits of a \u escape at s[p...p+4] (already checked).
def hex4(s: Str, p: Int) -> Int {
  v = 0
  k = 0
  while k < 4 {
    c = s[p + k].to_i
    d = c - 48
    d = c - 87 if c >= 97
    d = c - 55 if c >= 65 && c <= 70
    v = v * 16 + d
    k += 1
  }
  v
}

def is_hex(h: Int) -> Bool { (h >= 48 && h <= 57) || (h >= 97 && h <= 102) || (h >= 65 && h <= 70) }

# The index after the string literal starting at p (s[p] is the opening quote),
# checking escapes and control characters; or an error code (an escape's code
# is at its backslash).
def str_end(s: Str, p0: Int) -> Int {
  n = s.size
  p = p0 + 1
  while p < n {
    c = s[p]
    return p + 1 if c == 34
    return code(p, E_STRLIT) if c < 32
    if c == 92 {
      return code(p, E_EOF) if p + 1 >= n
      e = s[p + 1]
      if e == 117 {
        k = 2
        while k < 6 {
          # a valid prefix of \uXXXX cut short by the end
          return code(p, E_EOF) if p + k >= n
          return code(p, E_HEX) if !is_hex(s[p + k].to_i)
          k += 1
        }
        p += 5
      } else if !(e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116) {
        return code(p, E_ESC)
      } else {
        p += 1
      }
    }
    p += 1
  }
  code(cut_rune(s, p0), E_EOF)
}

# Where an input that ends inside a string reports its end: before a UTF-8
# sequence the end cut short, else at the end.
def cut_rune(s: Str, p0: Int) -> Int {
  n = s.size
  k = 1
  while k <= 3 && n - k > p0 {
    c = s[n - k]
    if c >= 0xC0 {
      return n - k if !utf8.full_rune_in_string(s[(n - k)...n])
      return n
    }
    return n if c < 0x80
    k += 1
  }
  n
}

# Skips one value starting at p0 (after whitespace) while checking its syntax;
# returns the index after it, or an error code. Iterative (an explicit stack of
# open arrays and objects), so nesting depth is bounded by MAX_DEPTH, not by the
# call stack.
def skip_value(s: Str, p0: Int, depth: Int) -> Int {
  cap = 64
  loop {
    zero: Byte = 0
    r = skip_in(s, p0, depth, Array.new(cap, zero))
    return r if r != E_GROW
    cap = cap * 16
  }
}

# The code skip_in returns when its stack is too small.
E_GROW = -4611686018427387904

# skip_value with the stack of open containers given (its length is the depth it
# can hold). Allocating nothing, so its loop needs no per-iteration region.
def skip_in(s: Str, p0: Int, depth: Int, stack: [Byte]) -> Int {
  n = s.size
  cap = stack.size
  sp = 0
  p = p0
  loop {
    p = skip_ws(s, p)
    return code(p, E_EOF) if p >= n
    c = s[p]
    if c == 123 || c == 91 {
      return code(p, E_DEPTH) if sp + depth >= MAX_DEPTH
      close = c == 123 ? 125 : 93
      p = skip_ws(s, p + 1)
      return code(p, E_EOF) if p >= n
      if s[p].to_i != close {
        return E_GROW if sp >= cap
        stack[sp] = c
        sp += 1
        if c == 123 {
          return code(p, E_KEYSTART) if s[p] != 34
          p = str_end(s, p)
          return p if p < 0
          p = skip_ws(s, p)
          return code(p, E_EOF) if p >= n
          return code(p, E_KEY) if s[p] != 58
          p += 1
        }
        next
      }
      p += 1
    } else if c == 34 {
      p = str_end(s, p)
      return p if p < 0
    } else if c == 116 {
      p = lit_end(s, p, "true")
      return p if p < 0
    } else if c == 102 {
      p = lit_end(s, p, "false")
      return p if p < 0
    } else if c == 110 {
      p = lit_end(s, p, "null")
      return p if p < 0
    } else if c == 45 || is_digit(c) {
      p = num_end(s, p)
      return p if p < 0
    } else {
      return code(p, E_BEGIN)
    }
    # A value ended at p: close containers and find the next value.
    loop {
      return p if sp == 0
      p = skip_ws(s, p)
      return code(p, E_EOF) if p >= n
      top = stack[sp - 1]
      c = s[p]
      if top == 91 {
        if c == 93 {
          sp -= 1
          p += 1
          next
        }
        return code(p, E_ELEM) if c != 44
        p += 1
        break
      }
      if c == 125 {
        sp -= 1
        p += 1
        next
      }
      return code(p, E_PAIR) if c != 44
      p = skip_ws(s, p + 1)
      return code(p, E_EOF) if p >= n
      return code(p, E_KEYSTART) if s[p] != 34
      p = str_end(s, p)
      return p if p < 0
      p = skip_ws(s, p)
      return code(p, E_EOF) if p >= n
      return code(p, E_KEY) if s[p] != 58
      p += 1
      break
    }
  }
}

# Is s one valid JSON text? The error says what is wrong and where.
pub def check(s: Str) -> ~Unit<JsonError> {
  p = skip_value(s, 0, 0)
  fail err_from(s, p) if p < 0
  p = skip_ws(s, p)
  fail err_char(s, p, "after top-level value") if p < s.size
}

# Go's json.Valid.
pub def valid(s: Str) -> Bool {
  p = skip_value(s, 0, 0)
  return false if p < 0
  skip_ws(s, p) >= s.size
}

struct DState {
  pos: Int
  key: Str
  ctx: Str
  wrapped: Bool
  fresh: Bool
  # a syntax error or a failed Unmarshaler: decoding stops
  failed: Bool
  errs: [JsonError]
  # the first type error: decoding goes on (Go's Unmarshal does)
  terr: [JsonError]
  nerr: Int
  # the root type's name, for type errors
  root: Str
  # where the tuple being read starts
  tstart: Int
  root_set: Bool
  # Go's Decoder.UseNumber / DisallowUnknownFields
  use_number: Bool
  disallow: Bool
  # added to the offsets in errors (a value read from a stream)
  base: Int
}

# The input side. Copies share the position and the errors (GO-VS-RUBY D36).
# Derived `json_dec` methods call these in a fixed pattern; each reads the next
# value (spaces before it are skipped) and leaves the position after it. They
# don't fail: a syntax error is remembered (`failed`) and every call after it
# returns at once; a type error (Go's UnmarshalTypeError) is remembered, the
# value skipped and decoding goes on, as Go's Unmarshal does; `done!` reports
# the first. So a hand-written `json_dec` has no error handling to write.
#
# The same type is Go's streaming Decoder: `new_decoder(r)` with an io.Reader
# (stream.alx: decode!, token!, has_more!, buffered, input_offset, use_number!,
# disallow_unknown_fields!).
pub struct Decoder {
  s: Str
  st: [DState]
  ss: [SState]

  pub def pos -> Int { st[0].pos }

  # The key found by the last `next_key!`.
  pub def key -> Str { st[0].key }

  pub def wrapped -> Bool { st[0].wrapped }

  # A syntax error (or a failed Unmarshaler) stopped decoding.
  pub def failed -> Bool { st[0].failed }

  # Go's UseNumber is on: a Number is read for a number in a Value.
  pub def using_number -> Bool { st[0].use_number }

  # Names what is being read, for messages of hand-written decoders.
  pub def at!(ctx: Str) {
    self.st[0].ctx = ctx
  }

  # The root type's name (Go's UnmarshalTypeError.Struct): the first call wins.
  pub def root!(name: Str) {
    if !st[0].root_set {
      self.st[0].root_set = true
      self.st[0].root = name
    }
    nil
  }

  # Records the first error; decoding stops.
  pub def fail!(e: JsonError) {
    if !st[0].failed {
      self.st[0].failed = true
      self.st[0].errs = [e]
    }
    nil
  }

  def bad!(c: Int) {
    fail!(rebase(err_from(s, c), st[0].base))
  }

  # A type error for the value at p (it is skipped): `got` is the JSON value
  # ("string", "number 1.5"), `want` the alx type.
  pub def wrong!(p: Int, got: Str, want: Str, cause: Str = "") {
    e = skip_value(s, p, 0)
    if e < 0 {
      bad!(e)
      return
    }
    c = s[p]
    off = (c == 91 || c == 123) ? p + 1 : e
    type_err!(got, want, off, p, cause)
    self.st[0].pos = e
    nil
  }

  # Records a type error (the first one is kept) for the value at `at`.
  pub def type_err!(got: Str, want: Str, off: Int, at: Int, cause: Str = "") {
    self.st[0].nerr += 1
    if st[0].terr.size == 0 {
      path = path_at(s, at)
      self.st[0].terr << JsonError.Type(value: got, type_name: want, offset: off + st[0].base, struct_name: path == "" ? "" : st[0].root, field: path, cause: cause)
    }
    nil
  }

  # The index of the next value's first byte; -1 (and an error) at the end or after an error.
  def start! -> Int {
    return -1 if st[0].failed
    p = skip_ws(s, st[0].pos)
    if p >= s.size {
      fail!(err_eof(p + st[0].base))
      return -1
    }
    p
  }

  # Skips the value at p.
  def skip_at!(p: Int) {
    e = skip_value(s, p, 0)
    if e < 0 {
      bad!(e)
    } else {
      self.st[0].pos = e
    }
  }

  # Consumes the literal word w at p (true, false, null); false after a syntax error.
  def lit!(p: Int, w: Str) -> Bool {
    e = lit_end(s, p, w)
    if e < 0 {
      bad!(e)
      return false
    }
    self.st[0].pos = e
    true
  }

  # ---- null

  # If the next value is null, consumes it and returns true.
  pub def take_null! -> Bool {
    p = start!
    return false if p < 0
    return false if s[p] != 110
    e = lit_end(s, p, "null")
    if e < 0 {
      bad!(e)
      return false
    }
    self.st[0].pos = e
    true
  }

  # Is the next value null? (Nothing is consumed.)
  pub def peek_null! -> Bool {
    p = start!
    p >= 0 && s[p] == 110
  }

  # The text of the next value, as it is written (Go's RawMessage); "" after an error.
  pub def raw_value! -> Str {
    p = start!
    return "" if p < 0
    e = skip_value(s, p, 0)
    if e < 0 {
      bad!(e)
      return ""
    }
    self.st[0].pos = e
    s[p...e]
  }

  # ---- scalars (null and a type error leave the old value, as in Go)

  pub def bool!(old: Bool = false) -> Bool {
    p = start!
    return old if p < 0
    c = s[p]
    if c == 116 || c == 102 {
      return false if !lit!(p, c == 116 ? "true" : "false")
      return c == 116
    }
    if c == 110 {
      lit!(p, "null")
      return old
    }
    wrong!(p, kind_word(c), "Bool")
    old
  }

  # The number at p as an integer with at most neg_lim / pos_lim magnitude.
  def int_in!(want: Str, neg_lim: U64, pos_lim: U64, old: Int) -> Int {
    p = start!
    return old if p < 0
    c = s[p]
    if c == 110 {
      lit!(p, "null")
      return old
    }
    if !(c == 45 || is_digit(c)) {
      wrong!(p, kind_word(c), want)
      return old
    }
    e = num_end(s, p)
    if e < 0 {
      bad!(e)
      return old
    }
    r = int_text(s[p...e], neg_lim, pos_lim)
    if r.none? {
      wrong!(p, "number " + s[p...e], want)
      return old
    }
    self.st[0].pos = e
    r || 0
  }

  pub def int!(old: Int = 0) -> Int {
    int_in!("Int", 9223372036854775808, 9223372036854775807, old)
  }

  # A signed integer of `bits` bits (the caller converts with as_i8 ...).
  pub def sint!(bits: Int, old: Int = 0) -> Int {
    one: U64 = 1
    half = one << (bits - 1)
    int_in!(bits == 64 ? "Int" : "I" + bits.to_s, half, half - 1, old)
  }

  # An unsigned integer of `bits` bits.
  pub def uint!(bits: Int, old: U64 = 0) -> U64 {
    p = start!
    return old if p < 0
    c = s[p]
    if c == 110 {
      lit!(p, "null")
      return old
    }
    want = "U" + bits.to_s
    if !(c == 45 || is_digit(c)) {
      wrong!(p, kind_word(c), want)
      return old
    }
    e = num_end(s, p)
    if e < 0 {
      bad!(e)
      return old
    }
    r = uint_text(s[p...e], bits)
    if r.none? {
      wrong!(p, "number " + s[p...e], want)
      return old
    }
    self.st[0].pos = e
    r || 0
  }

  pub def float!(old: Float = 0.0) -> Float {
    p = start!
    return old if p < 0
    c = s[p]
    if c == 110 {
      lit!(p, "null")
      return old
    }
    if !(c == 45 || is_digit(c)) {
      wrong!(p, kind_word(c), "Float")
      return old
    }
    e = num_end(s, p)
    if e < 0 {
      bad!(e)
      return old
    }
    f = parse_number(s[p...e])
    if f.none? {
      wrong!(p, "number " + s[p...e], "Float")
      # Go stores the infinity strconv returns, then reports the error
      return s[p] == 45 ? -1.0e308 * 10.0 : 1.0e308 * 10.0
    }
    self.st[0].pos = e
    f || 0.0
  }

  # ---- strings

  # Reads the string literal at p (s[p] is the opening quote); leaves the
  # position after it. Escapes are decoded; invalid UTF-8 becomes U+FFFD.
  def read_string!(p: Int) -> Str {
    n = s.size
    i = p + 1
    start = i
    # Fast path: plain ASCII with no escapes.
    while i < n {
      c = s[i]
      if c == 34 {
        self.st[0].pos = i + 1
        return s[start...i]
      }
      break if c == 92 || c >= 128 || c < 32
      i += 1
    }
    e = str_end(s, p)
    if e < 0 {
      bad!(e)
      return ""
    }
    self.st[0].pos = e
    unquote_slow(s, start, i, e)
  }

  pub def str!(old: Str = "") -> Str {
    p = start!
    return old if p < 0
    c = s[p]
    return read_string!(p) if c == 34
    if c == 110 {
      lit!(p, "null")
      return old
    }
    wrong!(p, kind_word(c), "Str")
    old
  }

  # Go's []byte: a base64 string (or an array of numbers); null is empty.
  pub def bytes!(old: [Byte], want: Str = "[U8]") -> [Byte] {
    p = start!
    return old if p < 0
    c = s[p]
    if c == 110 {
      lit!(p, "null")
      out: [Byte] = []
      return out
    }
    if c == 34 {
      t = read_string!(p)
      return old if st[0].failed
      r = decode_base64(t)
      if err = r.err {
        type_err!("string", want, st[0].pos, p, err.message)
        return old
      }
      return r.unwrap
    }
    if c == 91 {
      out: [Byte] = []
      self.st[0].pos = p + 1
      self.st[0].fresh = true
      while more! {
        out << uint!(8).as_u8
      }
      return out
    }
    wrong!(p, kind_word(c), want)
    old
  }

  # ---- the `,string` option: a scalar inside a JSON string

  # The text inside the string at the decoder's position; none (and the old
  # value stays) for null, "null", and after an error. `num`: the content
  # must be a JSON number (else a type error, value "number <text>").
  def quoted!(want: Str) -> Str? {
    p = start!
    return none if p < 0
    c = s[p]
    if c == 110 {
      lit!(p, "null")
      return none
    }
    if c != 34 {
      wrong!(p, kind_word(c), want)
      return none
    }
    t = read_string!(p)
    return none if st[0].failed || t == "null"
    t
  }

  def num_text?(t: Str) -> Bool {
    t.size > 0 && (t[0] == 45 || is_digit(t[0])) && num_end(t, 0) == t.size
  }

  # Go 1.27 reads a quoted number with Go's syntax (strconv: leading zeros,
  # a sign, hex floats), as v1 did (go.dev/issue/75619).
  pub def qsint!(bits: Int, old: Int = 0) -> Int {
    p = skip_ws(s, st[0].pos)
    want = bits == 64 ? "Int" : "I" + bits.to_s
    t = quoted!(want) || return old
    r = strconv.parse_int(t, 10, bits)
    if r.ok? {
      return r.unwrap
    }
    type_err!("number " + t, want, st[0].pos, p)
    old
  }

  pub def quint!(bits: Int, old: U64 = 0) -> U64 {
    p = skip_ws(s, st[0].pos)
    want = "U" + bits.to_s
    t = quoted!(want) || return old
    r = strconv.parse_uint(t, 10, bits)
    if r.ok? {
      return r.unwrap
    }
    type_err!("number " + t, want, st[0].pos, p)
    old
  }

  pub def qfloat!(old: Float = 0.0) -> Float {
    p = skip_ws(s, st[0].pos)
    t = quoted!("Float") || return old
    r = strconv.parse_float(t)
    if r.ok? {
      return r.unwrap
    }
    type_err!("number " + t, "Float", st[0].pos, p)
    old
  }

  pub def qbool!(old: Bool = false) -> Bool {
    p = skip_ws(s, st[0].pos)
    t = quoted!("Bool") || return old
    return true if t == "true"
    return false if t == "false"
    type_err!("string " + s[p...st[0].pos], "Bool", st[0].pos, p, "invalid syntax")
    old
  }

  pub def qstr!(old: Str = "") -> Str {
    p = skip_ws(s, st[0].pos)
    t = quoted!("Str") || return old
    msg = ""
    if t.size == 0 {
      msg = "unexpected end of JSON input"
    } else if t[0] != 34 {
      msg = err_char(t, 0, "looking for beginning of object key string").message
    } else {
      e = str_end(t, 0)
      if e < 0 {
        msg = err_from(t, e).message
      } else if e < t.size {
        msg = err_char(t, e, "after string value").message
      } else {
        return unquote_at(t, 0)
      }
    }
    type_err!("string", "Str", st[0].pos, p, msg)
    old
  }

  # If the next value is the string "null" (which `,string` reads as null),
  # consumes it and returns true.
  pub def qnull! -> Bool {
    p = start!
    return false if p < 0
    return false if p + 6 > s.size || s[p...(p + 6)] != "\"null\""
    self.st[0].pos = p + 6
    true
  }

  # How many type errors there were (the first is kept): a caller compares
  # before and after reading a value.
  pub def nerr -> Int { st[0].nerr }

  # ---- objects and arrays

  # Consumes `{` (c = 123) or `[` (c = 91): 1; null: 0; another value: -1
  # (a type error naming `want`, the alx type).
  pub def open!(c: Int, want: Str) -> Int {
    p = start!
    return -1 if p < 0
    k = s[p]
    if k.to_i == c {
      self.st[0].pos = p + 1
      self.st[0].fresh = true
      return 1
    }
    if k == 110 {
      lit!(p, "null")
      return 0
    }
    wrong!(p, kind_word(k), want)
    -1
  }

  # Consumes `{`. False if the value was null or not an object.
  pub def open_obj!(want: Str = "object") -> Bool { open!(123, want) == 1 }

  # The next member: reads its key (see `key`) and the colon, leaving the
  # position at the value; false at the closing `}` (or after an error).
  pub def next_key! -> Bool {
    return false if st[0].failed
    n = s.size
    p = skip_ws(s, st[0].pos)
    if p >= n {
      bad!(code(p, E_EOF))
      return false
    }
    c = s[p]
    if c == 125 {
      self.st[0].pos = p + 1
      self.st[0].fresh = false
      return false
    }
    if !st[0].fresh {
      if c != 44 {
        bad!(code(p, E_PAIR))
        return false
      }
      p = skip_ws(s, p + 1)
      if p >= n {
        bad!(code(p, E_EOF))
        return false
      }
    }
    if s[p] != 34 {
      bad!(code(p, E_KEYSTART))
      return false
    }
    k = read_string!(p)
    return false if st[0].failed
    q = skip_ws(s, st[0].pos)
    if q >= n {
      bad!(code(q, E_EOF))
      return false
    }
    if s[q] != 58 {
      bad!(code(q, E_KEY))
      return false
    }
    self.st[0].pos = q + 1
    self.st[0].key = k
    self.st[0].fresh = false
    true
  }

  # A member no field takes: skipped (an error after disallow_unknown_fields!).
  pub def unknown! {
    # Go records the error and goes on, as for a type error
    if st[0].disallow {
      self.st[0].nerr += 1
      self.st[0].terr << JsonError.UnknownField(st[0].key) if st[0].terr.size == 0
    }
    skip!
    nil
  }

  # A map key that should be an integer: the key's text (the position is at
  # the member's value); a type error (Go's, at the key) when it isn't one.
  pub def int_key!(bits: Int, signed: Bool, want: Str) -> I64? {
    k = st[0].key
    ok = num_text?(k)
    if ok {
      if signed {
        one: U64 = 1
        half = one << (bits - 1)
        if v = int_text(k, half, half - 1) {
          return v
        }
      } else if v = uint_text(k, bits) {
        return v.as_i64
      }
    }
    # the key's end: the colon's position
    q = st[0].pos - 1
    while q > 0 && s[q] != 34 { q -= 1 }
    type_err!("number " + k, want, q + 1, st[0].pos)
    skip!
    none
  }

  # Consumes `[`. False if the value was null or not an array.
  pub def open_arr!(want: Str = "array") -> Bool { open!(91, want) == 1 }

  # True if another element follows (the position is then at it); false at `]`
  # (or after an error).
  pub def more! -> Bool {
    return false if st[0].failed
    n = s.size
    p = skip_ws(s, st[0].pos)
    if p >= n {
      bad!(code(p, E_EOF))
      return false
    }
    c = s[p]
    if c == 93 {
      self.st[0].pos = p + 1
      self.st[0].fresh = false
      return false
    }
    if st[0].fresh {
      self.st[0].fresh = false
      self.st[0].pos = p
      return true
    }
    if c != 44 {
      bad!(code(p, E_ELEM))
      return false
    }
    self.st[0].pos = p + 1
    true
  }

  # ---- tuples (fixed-length arrays)

  pub def open_tuple! {
    p = start!
    return if p < 0
    c = s[p]
    if c == 91 {
      self.st[0].pos = p + 1
      self.st[0].fresh = true
      self.st[0].tstart = p
      return
    }
    wrong!(p, kind_word(c), "tuple")
    fail!(st[0].terr[0]) if st[0].terr.size > 0
    nil
  }

  # A tuple of the wrong length: a type error (decoding stops).
  def tuple_err!(got: Str, n: Int, p: Int) {
    path = path_at(s, st[0].tstart)
    fail!(JsonError.Type(value: got, type_name: "tuple of length " + n.to_s, offset: p + st[0].base, struct_name: path == "" ? "" : st[0].root, field: path, cause: ""))
  }

  # Moves to element k of an n-element tuple.
  pub def tuple_next!(k: Int, n: Int) {
    return if st[0].failed
    p = skip_ws(s, st[0].pos)
    if p >= s.size {
      bad!(code(p, E_EOF))
      return
    }
    c = s[p]
    if c == 93 {
      tuple_err!("array of length " + k.to_s, n, p)
      return
    }
    if k > 0 {
      if c != 44 {
        bad!(code(p, E_ELEM))
        return
      }
      self.st[0].pos = p + 1
    } else {
      self.st[0].pos = p
    }
    nil
  }

  pub def tuple_end!(n: Int) {
    return if st[0].failed
    p = skip_ws(s, st[0].pos)
    if p >= s.size {
      bad!(code(p, E_EOF))
      return
    }
    if s[p] != 93 {
      tuple_err!("array of length more than " + n.to_s, n, p)
      return
    }
    self.st[0].pos = p + 1
    self.st[0].fresh = false
    nil
  }

  # ---- enums

  # An enum value: a string (a unit variant) or `{"Variant": payload`. Returns
  # the variant's name; `wrapped` says whether a payload follows.
  pub def variant! -> Str {
    p = start!
    return "" if p < 0
    c = s[p]
    if c == 34 {
      self.st[0].wrapped = false
      return read_string!(p)
    }
    if c == 123 {
      q = skip_ws(s, p + 1)
      if q >= s.size {
        bad!(code(q, E_EOF))
        return ""
      }
      if s[q] != 34 {
        bad!(code(q, E_KEYSTART))
        return ""
      }
      k = read_string!(q)
      return "" if st[0].failed
      r = skip_ws(s, st[0].pos)
      if r >= s.size {
        bad!(code(r, E_EOF))
        return ""
      }
      if s[r] != 58 {
        bad!(code(r, E_KEY))
        return ""
      }
      self.st[0].pos = r + 1
      self.st[0].wrapped = true
      return k
    }
    wrong!(p, kind_word(c), "enum")
    fail!(st[0].terr[0]) if st[0].terr.size > 0
    ""
  }

  # A unit variant may be written `{"V": null}`; anything after the colon is skipped.
  pub def unit_variant!(wrapped: Bool) {
    return if st[0].failed
    if wrapped {
      p = skip_ws(s, st[0].pos)
      skip_at!(p)
    }
    nil
  }

  pub def need_payload!(wrapped: Bool) {
    return if st[0].failed
    if !wrapped {
      fail!(JsonError.Invalid(msg: "variant " + st[0].ctx + " needs a payload: {\"Variant\": ...}", offset: st[0].pos + st[0].base))
    }
    nil
  }

  # Closes the `}` of a `{"Variant": payload}`.
  pub def end_variant!(wrapped: Bool) {
    return if st[0].failed
    if wrapped {
      p = skip_ws(s, st[0].pos)
      if p >= s.size {
        bad!(code(p, E_EOF))
        return
      }
      if s[p] != 125 {
        bad!(code(p, E_PAIR))
        return
      }
      self.st[0].pos = p + 1
    }
    nil
  }

  # Records "unknown variant" for an enum named `owner`.
  pub def bad_variant!(owner: Str, name: Str) {
    fail!(JsonError.Invalid(msg: "unknown variant " + quote(name) + " for " + owner, offset: st[0].pos + st[0].base))
  }

  # ======== Go's streaming Decoder (the state is in ss[0]; stream.alx)

  # ---- reading

  # Reads more input; false at the end (or after a read error, recorded).
  def fill! -> Bool {
    sv = ss[0]
    return false if sv.eof || sv.err.size > 0
    # drop what was read
    if sv.pos > 4096 && sv.pos * 2 > sv.buf.size {
      self.ss[0].off = sv.off + sv.pos
      self.ss[0].buf = sv.buf[sv.pos...sv.buf.size]
      self.ss[0].pos = 0
    }
    p: [Byte] = [0; 4096]
    r = ss[0].r
    res = r.read!(p)
    self.ss[0].r = r
    if err = res.err {
      self.ss[0].err << err
      return false
    }
    n = res.unwrap
    if n == 0 {
      self.ss[0].eof = true
      return false
    }
    self.ss[0].buf = ss[0].buf + Str.from_bytes(p[0...n])
    true
  }

  # The index (in buf) of the next non-space byte, reading as needed; buf.size at the end.
  def peek_ws! -> Int {
    loop {
      b = ss[0].buf
      p = ss[0].pos
      while p < b.size && white?(b[p]) { p += 1 }
      self.ss[0].pos = p
      return p if p < b.size
      return p if !fill!
    }
  }

  # The end (in buf) of the value starting at p, reading until it is
  # complete; or a negative error code (decode.alx) relative to buf.
  def value_end!(p: Int) -> Int {
    loop {
      b = ss[0].buf
      e = skip_value(b, p, ss[0].kinds.size)
      if e >= 0 {
        # a number at the end of the input may go on
        c = b[p]
        return e if !(c == 45 || is_digit(c)) || e < b.size || ss[0].eof
      } else {
        v = -e - 1
        return e if v % 64 != E_EOF || ss[0].eof
      }
      if !fill! {
        return value_end!(p) if ss[0].eof
        return code(b.size, E_EOF)
      }
    }
  }

  # The error a code (relative to buf) stands for, with stream offsets.
  def stream_err(c: Int) -> JsonError {
    rebase(err_from(ss[0].buf, c), ss[0].off)
  }

  # Records a syntax error (sticky); returns it.
  def sfail![E](e: E) -> E {
    self.ss[0].err << e if ss[0].err.size == 0
    e
  }

  # Moves past the separators before the next token: the `,` or `:` the
  # grammar needs there. The position is then at the token (buf.size at the
  # end of input). `close`: a closing delimiter may come instead.
  def separate! -> ~Int<JsonError> {
    p = peek_ws!
    b = ss[0].buf
    k = ss[0].kinds.size
    return p if k == 0 || p >= b.size
    top = ss[0].kinds[k - 1]
    n = ss[0].lens[k - 1]
    c = b[p]
    if top == 123 && n % 2 == 1 {
      fail sfail!(rebase(err_char(b, p, "after object key"), ss[0].off)) if c != 58
      self.ss[0].pos = p + 1
      return peek_ws!
    }
    return p if n == 0
    if c == 44 {
      self.ss[0].pos = p + 1
      q = peek_ws!
      b2 = ss[0].buf
      if q < b2.size && top == 123 && b2[q] != 34 {
        fail sfail!(rebase(err_char(b2, q, "looking for beginning of object key string"), ss[0].off))
      }
      if q < b2.size && top == 91 && (b2[q] == 93 || b2[q] == 125) {
        fail sfail!(rebase(err_char(b2, q, "looking for beginning of value"), ss[0].off))
      }
      return q
    }
    return p if c == 93 || c == 125
    fail sfail!(rebase(err_char(b, p, top == 91 ? "after array element" : "after object key:value pair"), ss[0].off))
  }

  # Counts a token at the current level.
  def count! {
    k = ss[0].kinds.size
    self.ss[0].lens[k - 1] += 1 if k > 0
    nil
  }

  # ---- Go's Decoder API

  # Go's UseNumber: a number read into a Value or as a token is a Number.
  pub def use_number! {
    self.st[0].use_number = true
  }

  # Go's DisallowUnknownFields: an object member no field takes is an error.
  pub def disallow_unknown_fields! {
    self.st[0].disallow = true
  }

  # The text of the next JSON value in the stream (its syntax checked);
  # none at the end of the input.
  pub def read_value! -> ~Str? {
    fail ss[0].err[0] if ss[0].err.size > 0
    p = ~separate!
    b = ss[0].buf
    if p >= b.size {
      fail ss[0].err[0] if ss[0].err.size > 0
      return none if ss[0].kinds.size == 0
      fail sfail!(io.StreamError.UnexpectedEof)
    }
    if ss[0].kinds.size > 0 && (b[p] == 93 || b[p] == 125) {
      fail sfail!(rebase(err_char(b, p, "looking for beginning of value"), ss[0].off))
    }
    e = value_end!(p)
    b = ss[0].buf
    if e < 0 {
      fail ss[0].err[0] if ss[0].err.size > 0
      v2 = -e - 1
      fail sfail!(io.StreamError.UnexpectedEof) if v2 % 64 == E_EOF
      fail sfail!(stream_err(e))
    }
    self.ss[0].pos = e
    self.ss[0].peeked = false
    self.ss[0].had_eof = false
    self.ss[0].vstart = ss[0].off + p
    count!
    b[p...e]
  }

  # Go's Decode exactly: reads the next JSON value into a copy of v (fields
  # the input doesn't name keep v's values) and returns it with the first
  # error: as far as it was decoded after a type error, v itself after a
  # syntax or read error. (none, none) at the end of the input (Go's io.EOF).
  pub def decode_partial![T](v: T) -> (T?, Error?) {
    r = read_value!
    if err = r.err {
      return (v, err)
    }
    text = r.unwrap || return (none, none)
    d = new_decoder(text)
    d.st[0].use_number = st[0].use_number
    d.st[0].disallow = st[0].disallow
    d.st[0].base = ss[0].vstart
    out = dec_val(d, v)
    done = d.done!
    if err = done.err {
      return (out, err)
    }
    (out, none)
  }

  # Go's Decode: reads the next JSON value and decodes it into a copy of v
  # (Go's Unmarshal into &v: fields the input doesn't name keep v's values),
  # returned; none at the end of the input (Go's io.EOF).
  pub def decode![T](v: T) -> ~T? {
    r, err = decode_partial!(v)
    fail err.unwrap if err.some?
    r
  }

  # Go's Token: the next token (separators are implicit); none at the end of
  # the input.
  pub def token! -> ~Token? {
    fail ss[0].err[0] if ss[0].err.size > 0
    a0 = ss[0].off + ss[0].pos
    p = ~separate!
    b = ss[0].buf
    if p >= b.size {
      fail ss[0].err[0] if ss[0].err.size > 0
      # Go: io.EOF when only separators are left; the offset stays after
      # the last token
      self.ss[0].had_eof = true
      self.ss[0].pos = a0 - ss[0].off
      return none
    }
    self.ss[0].peeked = false
    self.ss[0].had_eof = false
    c = b[p]
    k = ss[0].kinds.size
    if c == 123 || c == 91 {
      count!
      self.ss[0].kinds << c.to_i
      self.ss[0].lens << 0
      self.ss[0].pos = p + 1
      return Token.Delim(c.to_i32)
    }
    if c == 125 || c == 93 {
      want = k > 0 ? (ss[0].kinds[k - 1] == 123 ? 125 : 93) : -1
      if c.to_i != want || (want == 125 && ss[0].lens[k - 1] % 2 == 1) {
        where = "looking for beginning of value"
        if k > 0 && ss[0].lens[k - 1] > 0 {
          where = ss[0].kinds[k - 1] == 91 ? "after array element" : "after object key:value pair"
        }
        fail sfail!(rebase(err_char(b, p, where), ss[0].off))
      }
      self.ss[0].kinds = ss[0].kinds[0...(k - 1)]
      self.ss[0].lens = ss[0].lens[0...(k - 1)]
      self.ss[0].pos = p + 1
      return Token.Delim(c.to_i32)
    }
    if k > 0 && ss[0].kinds[k - 1] == 123 && ss[0].lens[k - 1] % 2 == 0 && c != 34 {
      fail sfail!(rebase(err_char(b, p, "looking for beginning of object key string"), ss[0].off))
    }
    e = value_end!(p)
    b = ss[0].buf
    if e < 0 {
      fail ss[0].err[0] if ss[0].err.size > 0
      v2 = -e - 1
      fail sfail!(io.StreamError.UnexpectedEof) if v2 % 64 == E_EOF
      fail sfail!(stream_err(e))
    }
    self.ss[0].pos = e
    count!
    t = b[p...e]
    return Token.String(unquote_at(t, 0)) if c == 34
    return Token.Bool(true) if c == 116
    return Token.Bool(false) if c == 102
    return Token.Null if c == 110
    return Token.Num(Number.new(t)) if st[0].use_number
    if f = parse_number(t) {
      return Token.Float(f)
    }
    fail JsonError.Type(value: "number " + t, type_name: "Float", offset: ss[0].off + e, struct_name: "", field: "", cause: "")
  }

  # Go's More: is there another element in the current array or object (or
  # another value at the top level)?
  pub def has_more! -> Bool {
    self.ss[0].peeked = true
    return false if ss[0].err.size > 0
    # a peek: the position stays after the last token
    a0 = ss[0].off + ss[0].pos
    p = peek_ws!
    b = ss[0].buf
    self.ss[0].pos = a0 - ss[0].off
    return false if p >= b.size
    c = b[p]
    c != 93 && c != 125
  }

  # Go's Buffered: the input read from the reader but not yet decoded.
  pub def buffered -> bytes.Reader {
    b = ss[0].buf
    bytes.new_reader(b[ss[0].pos...b.size].bytes)
  }

  # Go's InputOffset: the offset in the stream after the last token or value.
  pub def input_offset -> Int {
    sv = ss[0]
    off = sv.off + sv.pos
    if sv.peeked || sv.had_eof {
      # the spaces after it count once the next token was looked for
      b = sv.buf
      p = sv.pos
      while p < b.size && white?(b[p]) { p += 1 }
      if p < b.size {
        off = sv.off + p
        off += 1 if sv.had_eof && (b[p] == 44 || b[p] == 58)
      }
    }
    off
  }

  # ---- skipping and the end

  # Skips the next value (any), checking its syntax.
  pub def skip! {
    p = start!
    return if p < 0
    skip_at!(p)
    nil
  }

  # The end: reports the first error, or any text left after the value.
  pub def done! -> ~Unit<JsonError> {
    fail st[0].errs[0] if st[0].failed
    p = skip_ws(s, st[0].pos)
    fail rebase(err_char(s, p, "after top-level value"), st[0].base) if p < s.size
    fail st[0].terr[0] if st[0].terr.size > 0
  }
}

# A decoder reading one JSON document: `s` a Str (what the derived from_json
# and hand-written json_dec use), or, as Go's NewDecoder, an io.Reader
# (stream.alx).
pub def new_decoder[R](r: R) -> Decoder {
  if R is Str {
    Decoder.new(s: r, st: [new_dstate()], ss: [])
  } else {
    Decoder.new(s: "", st: [new_dstate()], ss: [new_sstate(r)])
  }
}

def new_dstate -> DState {
  DState.new(pos: 0, key: "", ctx: "", wrapped: false, fresh: false, failed: false, errs: [], terr: [], nerr: 0, root: "", tstart: 0, root_set: false, use_number: false, disallow: false, base: 0)
}

# e with its offset moved by base (a value read from a stream).
def rebase(e: JsonError, base: Int) -> JsonError {
  return e if base == 0
  case e {
    JsonError.Syntax(m, o) => JsonError.Syntax(msg: m, offset: o + base)
    _ => e
  }
}

# The integer in the number text t (JSON's grammar), if it is one and fits
# in -neg_lim..pos_lim.
def int_text(t: Str, neg_lim: U64, pos_lim: U64) -> Int? {
  i = 0
  neg = false
  if t[0] == 45 {
    neg = true
    i = 1
  }
  u: U64 = 0
  lim = neg ? neg_lim : pos_lim
  while i < t.size {
    d = t[i]
    return none if !is_digit(d)
    dv = (d - 48).to_u64
    return none if u > (lim - dv) / 10
    u = u * 10 + dv
    i += 1
  }
  return 0 -% u.as_i64 if neg
  u.as_i64
}

# The unsigned integer of `bits` bits in the number text t.
def uint_text(t: Str, bits: Int) -> U64? {
  return none if t[0] == 45
  one: U64 = 1
  lim: U64 = 18446744073709551615
  lim = (one << bits) - 1 if bits < 64
  u: U64 = 0
  i = 0
  while i < t.size {
    d = t[i]
    return none if !is_digit(d)
    dv = (d - 48).to_u64
    return none if u > (lim - dv) / 10
    u = u * 10 + dv
    i += 1
  }
  u
}

# The string s[start...e-1] (inside quotes; s[start...i] has no escapes),
# unescaped: \uXXXX with surrogate pairs; a lone surrogate and invalid UTF-8
# become U+FFFD.
def unquote_slow(s: Str, start: Int, i0: Int, e: Int) -> Str {
  b: [Byte] = []
  j = start
  while j < i0 {
    b << s[j]
    j += 1
  }
  i = i0
  while i < e - 1 {
    c = s[i]
    if c == 92 {
      i += 1
      x = s[i]
      if x == 98 {
        b << 8
      } else if x == 102 {
        b << 12
      } else if x == 110 {
        b << 10
      } else if x == 114 {
        b << 13
      } else if x == 116 {
        b << 9
      } else if x == 117 {
        r = hex4(s, i + 1)
        i += 4
        if r >= 0xD800 && r < 0xDC00 {
          # a high surrogate: needs \uDC00..\uDFFF right after
          if i + 6 < e && s[i + 1] == 92 && s[i + 2] == 117 {
            lo = hex4(s, i + 3)
            if lo >= 0xDC00 && lo < 0xE000 {
              r = 0x10000 + ((r - 0xD800) << 10) + (lo - 0xDC00)
              i += 6
            } else {
              r = 0xFFFD
            }
          } else {
            r = 0xFFFD
          }
        } else if r >= 0xDC00 && r < 0xE000 {
          r = 0xFFFD
        }
        b = push_rune(b, r)
      } else {
        b << x
      }
      i += 1
    } else if c < 128 {
      b << c
      i += 1
    } else {
      rr, w = utf8.decode_rune_at(s, i)
      if rr == 0xFFFD && w == 1 {
        b << 0xEF
        b << 0xBF
        b << 0xBD
      } else {
        k = 0
        while k < w {
          b << s[i + k]
          k += 1
        }
      }
      i += w
    }
  }
  Str.from_bytes(b)
}

# The string literal at p (valid): its text.
def unquote_at(s: Str, p: Int) -> Str {
  e = str_end(s, p)
  unquote_slow(s, p + 1, p + 1, e)
}

# One JSON Pointer token, as Go's v1 errors show it (~ as ~0, / as ~1).
def ptr_token(k: Str) -> Str {
  return k if !k.include?("~") && !k.include?("/")
  strings.replace_all(strings.replace_all(k, "~", "~0"), "/", "~1")
}

# The path to the value starting at `at` in the (valid) document s: member
# names and array indices joined with dots (Go's UnmarshalTypeError.Field).
def path_at(s: Str, at: Int) -> Str {
  objs: [Bool] = []
  names: [Str] = []
  idx: [Int] = []
  p = skip_ws(s, 0)
  loop {
    p = skip_ws(s, p)
    return names.join(".") if p >= at || p >= s.size
    c = s[p]
    if c == 123 || c == 91 {
      q = skip_ws(s, p + 1)
      if s[q] == 125 || s[q] == 93 {
        p = q + 1
      } else if c == 123 {
        objs << true
        idx << 0
        names << ptr_token(unquote_at(s, q))
        p = skip_ws(s, str_end(s, q)) + 1
        next
      } else {
        objs << false
        idx << 0
        names << "0"
        p = q
        next
      }
    } else if c == 34 {
      p = str_end(s, p)
    } else if c == 116 || c == 110 {
      p += 4
    } else if c == 102 {
      p += 5
    } else {
      p = num_end(s, p)
    }
    # after a value: commas and closings
    loop {
      return "" if objs.size == 0
      p = skip_ws(s, p)
      c2 = s[p]
      if c2 == 44 {
        p = skip_ws(s, p + 1)
        top = objs.size - 1
        if objs[top] {
          names[top] = ptr_token(unquote_at(s, p))
          p = skip_ws(s, str_end(s, p)) + 1
        } else {
          idx[top] += 1
          names[top] = idx[top].to_s
        }
        break
      }
      # } or ]
      objs = objs[0...(objs.size - 1)]
      names = names[0...(names.size - 1)]
      idx = idx[0...(idx.size - 1)]
      p += 1
    }
  }
}

# Go's case-insensitive field match (after the exact names failed): the
# index of the first name equal to key under Unicode case folding, or -1.
pub def fold_index(key: Str, names: [Str]) -> Int {
  i = 0
  while i < names.size {
    return i if strings.equal_fold(key, names[i])
    i += 1
  }
  -1
}

# Go's []byte from a JSON string: standard base64 (padding required; \r and
# \n are skipped).
def decode_base64(t: Str) -> ~[Byte] {
  u = t
  u = strings.replace_all(strings.replace_all(u, "\r", ""), "\n", "") if u.include?("\r") || u.include?("\n")
  base64.std_encoding.~decode_string(u)
}

# ---------------------------------------------------------------- numbers

POW10 = [1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0, 1000000000.0, 10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0, 100000000000000.0, 1000000000000000.0, 10000000000000000.0, 100000000000000000.0, 1000000000000000000.0, 10000000000000000000.0, 100000000000000000000.0, 1000000000000000000000.0, 10000000000000000000000.0]

# The Float of a number token (grammar already checked); none if it is out of
# range. Short decimals take an exact fast path (mantissa below 2^53, power of
# ten up to 22), the rest goes through strconv.
def parse_number(t: Str) -> Float? {
  n = t.size
  i = 0
  neg = false
  if t[0] == 45 {
    neg = true
    i = 1
  }
  mant: U64 = 0
  digits = 0
  frac = 0
  seen_dot = false
  while i < n {
    c = t[i]
    if is_digit(c) {
      if digits < 19 {
        mant = mant * 10 + (c - 48).to_u64
        digits += 1 if mant > 0
        frac += 1 if seen_dot
      } else {
        return slow_number(t)
      }
    } else if c == 46 {
      seen_dot = true
    } else {
      break
    }
    i += 1
  }
  ex = 0
  if i < n {
    # e or E
    i += 1
    eneg = false
    if t[i] == 45 {
      eneg = true
      i += 1
    } else if t[i] == 43 {
      i += 1
    }
    while i < n {
      ex = ex * 10 + (t[i] - 48).to_i
      return slow_number(t) if ex > 100000
      i += 1
    }
    ex = -ex if eneg
  }
  e10 = ex - frac
  limit: U64 = 9007199254740992
  if mant <= limit && e10 >= -22 && e10 <= 22 {
    f = mant.to_i.to_f
    if e10 < 0 {
      f = f / POW10[-e10]
    } else {
      f = f * POW10[e10]
    }
    return neg ? -f : f
  }
  slow_number(t)
}

def slow_number(t: Str) -> Float? {
  r = strconv.parse_float(t)
  return none if r.err?
  r.unwrap
}
