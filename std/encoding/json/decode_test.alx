#![test(external)]
# Go's decode_test.go (go1.27, the jsonv2-backed build), translated. The
# unmarshalTests table and TestUnmarshal are vec_unmarshal_test.alx (their
# results generated by Go); the types are decode_types_test.alx.
#
# Not translated, and why:
#   TestInterfaceSet: the cases decoding into an interface that holds a
#     pointer (*int, **int, ...): alx has no interface values to decode into;
#     the json.Value cases are below.
#   TestUnmarshalTypeError: the `error` targets (no interface values).
#   TestInvalidUnmarshal: decoding into nil or a non-pointer can't be written
#     in alx (unmarshal returns the value); the net.IP case: net.IP has no
#     TextUnmarshaler in alx.
#   TestUnmarshalEmbeddedUnexported S1 and S5: Go can't allocate an embedded
#     pointer to an unexported struct; alx has no unexported types (the
#     option is allocated, as for an exported one).
#   TestUnmarshalMapWithTextUnmarshalerStringKey, the map half of
#     TestUnmarshalRescanLiteralMangledUnquote, TestStringKind: alx Map keys
#     are integers, Str or Bool (no named string types).
#   TestByteKind, TestSliceOfCustomByte: alx has no named []byte / uint8
#     types (a transparent struct isn't a byte).

import "bytes"
import "encoding/json"
import "math/big"
import "strings"
import "time"

def all_value -> All {
  m: Map[Str, Small] = {"17" => Small.new(tag: "tag17"), "18" => Small.new(tag: "tag18")}
  mp: Map[Str, Small?] = {}
  mp["19"] = Small.new(tag: "tag19")
  mp["20"] = none
  sp: [Small?] = []
  sp << Small.new(tag: "tag22")
  sp << none
  sp << Small.new(tag: "tag23")
  All.new(bool: true, int: 2, int8: 3, int16: 4, int32: 5, int64: 6, uint: 7, uint8: 8, uint16: 9, uint32: 10, uint64: 11, uintptr: 12, float64: 15.1, foo: "foo", foo2: "foo2", int_str: 42, uintptr_str: 44, string: "16", map: m, map_p: mp, slice: [Small.new(tag: "tag20"), Small.new(tag: "tag21")], slice_p: sp, string_slice: ["str24", "str25", "str26"], byte_slice: [27, 28, 29], small: Small.new(tag: "tag30"), p_small: Small.new(tag: "tag31"), interface: json.parse("5.2").unwrap, invalid_embed: 123)
}

def pall_value -> All {
  a = all_value()
  All.new(p_bool: a.bool, p_int: a.int, p_int8: a.int8, p_int16: a.int16, p_int32: a.int32, p_int64: a.int64, p_uint: a.uint, p_uint8: a.uint8, p_uint16: a.uint16, p_uint32: a.uint32, p_uint64: a.uint64, p_uintptr: a.uintptr, p_float64: a.float64, p_string: a.string, p_map: a.map, p_map_p: a.map_p, p_slice: a.slice, p_slice_p: a.slice_p, pp_small: a.p_small, p_interface: a.interface)
}

# Go's allValueCompact / pallValueCompact, without the float32 fields (alx
# has none) and with nil maps and slices written as empty ones (alx has no
# nil).
ALL_VALUE_COMPACT = "{\"Bool\":true,\"Int\":2,\"Int8\":3,\"Int16\":4,\"Int32\":5,\"Int64\":6,\"Uint\":7,\"Uint8\":8,\"Uint16\":9,\"Uint32\":10,\"Uint64\":11,\"Uintptr\":12,\"Float64\":15.1,\"bar\":\"foo\",\"bar2\":\"foo2\",\"IntStr\":\"42\",\"UintptrStr\":\"44\",\"PBool\":null,\"PInt\":null,\"PInt8\":null,\"PInt16\":null,\"PInt32\":null,\"PInt64\":null,\"PUint\":null,\"PUint8\":null,\"PUint16\":null,\"PUint32\":null,\"PUint64\":null,\"PUintptr\":null,\"PFloat64\":null,\"String\":\"16\",\"PString\":null,\"Map\":{\"17\":{\"Tag\":\"tag17\"},\"18\":{\"Tag\":\"tag18\"}},\"MapP\":{\"19\":{\"Tag\":\"tag19\"},\"20\":null},\"PMap\":null,\"PMapP\":null,\"EmptyMap\":{},\"NilMap\":{},\"Slice\":[{\"Tag\":\"tag20\"},{\"Tag\":\"tag21\"}],\"SliceP\":[{\"Tag\":\"tag22\"},null,{\"Tag\":\"tag23\"}],\"PSlice\":null,\"PSliceP\":null,\"EmptySlice\":[],\"NilSlice\":[],\"StringSlice\":[\"str24\",\"str25\",\"str26\"],\"ByteSlice\":\"Gxwd\",\"Small\":{\"Tag\":\"tag30\"},\"PSmall\":{\"Tag\":\"tag31\"},\"PPSmall\":null,\"Interface\":5.2,\"PInterface\":null,\"InvalidEmbed\":123}"

PALL_VALUE_COMPACT = "{\"Bool\":false,\"Int\":0,\"Int8\":0,\"Int16\":0,\"Int32\":0,\"Int64\":0,\"Uint\":0,\"Uint8\":0,\"Uint16\":0,\"Uint32\":0,\"Uint64\":0,\"Uintptr\":0,\"Float64\":0,\"bar\":\"\",\"bar2\":\"\",\"IntStr\":\"0\",\"UintptrStr\":\"0\",\"PBool\":true,\"PInt\":2,\"PInt8\":3,\"PInt16\":4,\"PInt32\":5,\"PInt64\":6,\"PUint\":7,\"PUint8\":8,\"PUint16\":9,\"PUint32\":10,\"PUint64\":11,\"PUintptr\":12,\"PFloat64\":15.1,\"String\":\"\",\"PString\":\"16\",\"Map\":{},\"MapP\":{},\"PMap\":{\"17\":{\"Tag\":\"tag17\"},\"18\":{\"Tag\":\"tag18\"}},\"PMapP\":{\"19\":{\"Tag\":\"tag19\"},\"20\":null},\"EmptyMap\":{},\"NilMap\":{},\"Slice\":[],\"SliceP\":[],\"PSlice\":[{\"Tag\":\"tag20\"},{\"Tag\":\"tag21\"}],\"PSliceP\":[{\"Tag\":\"tag22\"},null,{\"Tag\":\"tag23\"}],\"EmptySlice\":[],\"NilSlice\":[],\"StringSlice\":[],\"ByteSlice\":\"\",\"Small\":{\"Tag\":\"\"},\"PSmall\":null,\"PPSmall\":{\"Tag\":\"tag31\"},\"Interface\":null,\"PInterface\":5.2,\"InvalidEmbed\":0}"

test "TestMarshal" {
  assert_eq json.~marshal(all_value()), ALL_VALUE_COMPACT
  assert_eq json.~marshal(pall_value()), PALL_VALUE_COMPACT
}

test "TestMarshalInvalidUTF8" {
  tests = [
    (Str.from_bytes([104, 101, 108, 108, 111, 255, 119, 111, 114, 108, 100]), "\"hello\ufffdworld\""),
    ("", "\"\""),
    (Str.from_bytes([255]), "\"\ufffd\""),
    (Str.from_bytes([255, 255]), "\"\ufffd\ufffd\""),
    (Str.from_bytes([97, 255, 98]), "\"a\ufffdb\""),
    (Str.from_bytes([0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0xff, 0xaa, 0x9e]), "\"日本\ufffd\ufffd\ufffd\""),
  ]
  for t in tests {
    assert_eq json.~marshal(t[0]), t[1]
  }
}

test "TestMarshalNumberZeroVal" {
  assert_eq json.~marshal(json.Number.json_zero), "0"
}

def embeds_top -> Top {
  Top.new(level0: 1, embed0: Embed0.new(level1b: 2, level1c: 3), embed0a: Embed0a.new(level1a: 5, level1b: 6), embed0b: Embed0b.new(level1a: 8, level1b: 9, level1c: 10, level1d: 11, level1e: 12), loop: Loop.new(loop1: 13, loop2: 14), embed0p: Embed0p.new(point: ImagePoint.new(x: 15, y: 16)), embed0q: Embed0q.new(point: Point.new(z: 17)), embedx: Embedx.new(q: 18))
}

test "TestMarshalEmbeds" {
  # Go's want, with alx's lower-case spelling of the names (decode_types_test.alx)
  want = "{\"level0\":1,\"level1b\":2,\"level1c\":3,\"level1a\":5,\"lEVEL1B\":6,\"e\":{\"level1a\":8,\"level1b\":9,\"level1c\":10,\"level1d\":11,\"x\":12},\"loop1\":13,\"loop2\":14,\"X\":15,\"Y\":16,\"z\":17,\"q\":18}"
  assert_eq json.~marshal(embeds_top()), want
}

test "TestUnmarshalMarshal" {
  big = json_big()
  v = json.~parse(big)
  assert_eq json.~marshal(v), big
}

test "TestNumberAccessors" {
  n = json.Number.new(s: "-1.23e1")
  assert_eq n.to_s, "-1.23e1"
  assert_eq n.int64.err.unwrap.message, "strconv.parse_int: parsing \"-1.23e1\": invalid syntax"
  assert_eq n.~float64, -1.23e1
  n = json.Number.new(s: "-12")
  assert_eq n.~int64, -12
  assert_eq n.~float64, -12.0
  n = json.Number.new(s: "1e1000")
  assert_eq n.int64.err.unwrap.message, "strconv.parse_int: parsing \"1e1000\": invalid syntax"
  assert_eq n.float64.err.unwrap.message, "strconv.parse_float: parsing \"1e1000\": value out of range"
}

#[derive(Json)]
#[json(transparent)]
struct Bytes {
  v: [Byte]
}

test "TestLargeByteSlice" {
  s0: [Byte] = []
  i = 0
  while i < 2000 {
    s0 << i.as_u8
    i += 1
  }
  b = json.~marshal(Bytes.new(v: s0))
  s1 = json.~unmarshal_into(b, Bytes.new(v: []))
  assert s1.v == s0
}

#[derive(Json)]
struct Xint {
  #[json("X")] x: Int
}

test "TestUnmarshalInterface" {
  # Go decodes into the *Xint an `any` holds; alx decodes into the value
  xint = json.~unmarshal_into("{\"X\":1}", Xint.json_zero)
  assert_eq xint.x, 1
}

#[derive(Json)]
#[json(transparent)]
struct XintPtr {
  v: Xint?
}

test "TestUnmarshalPtrPtr" {
  p = json.~unmarshal_into("{\"X\":1}", XintPtr.new(v: Xint.json_zero))
  assert_eq p.v.unwrap.x, 1
}

test "TestEscape" {
  input = "\"foobar\"<html> [\u2028 \u2029]"
  want = "\"\\\"foobar\\\"\\u003chtml\\u003e [\\u2028 \\u2029]\""
  assert_eq json.~marshal(input), want
}

#[derive(Json)]
struct WrongString {
  #[field(json: "result,string")] message: Str
}

test "TestErrorMessageFromMisusedString" {
  tests = [
    ("{\"result\":\"x\"}", "json: cannot unmarshal string into Go struct field WrongString.result of type Str: invalid character 'x' looking for beginning of object key string"),
    ("{\"result\":\"foo\"}", "json: cannot unmarshal string into Go struct field WrongString.result of type Str: invalid character 'f' looking for beginning of object key string"),
    ("{\"result\":\"123\"}", "json: cannot unmarshal string into Go struct field WrongString.result of type Str: invalid character '1' looking for beginning of object key string"),
    ("{\"result\":123}", "json: cannot unmarshal number into Go struct field WrongString.result of type Str"),
    ("{\"result\":\"\\\"\"}", "json: cannot unmarshal string into Go struct field WrongString.result of type Str: unexpected end of JSON input"),
    ("{\"result\":\"\\\"foo\"}", "json: cannot unmarshal string into Go struct field WrongString.result of type Str: unexpected end of JSON input"),
  ]
  for t in tests {
    d = json.new_decoder(bytes.new_reader(t[0].bytes))
    r = d.decode!(WrongString.json_zero)
    assert_eq r.err.unwrap.message, t[1]
  }
}

#[derive(Json)]
struct RefS {
  # Ref is defined in encode_test.alx.
  #[json("R0")] r0: Ref
  #[json("R1")] r1: Ref?
  #[json("R2")] r2: RefText
  #[json("R3")] r3: RefText?
}

test "TestRefUnmarshal" {
  got = json.~unmarshal_into("{\"R0\":\"ref\",\"R1\":\"ref\",\"R2\":\"ref\",\"R3\":\"ref\"}", RefS.json_zero)
  assert_eq got.r0.v, 12
  assert_eq got.r1.unwrap.v, 12
  assert_eq got.r2.v, 13
  assert_eq got.r3.unwrap.v, 13
}

#[derive(Json)]
struct T2 {
  #[field(json: "Number1,string")] number1: Int
  #[field(json: "Number2,string")] number2: Int
}

# Test that the empty string doesn't panic decoding when ,string is specified
# Issue 3450
test "TestEmptyString" {
  d = json.new_decoder(bytes.new_reader("{\"Number1\":\"1\", \"Number2\":\"\"}".bytes))
  got, err = d.decode_partial!(T2.json_zero)
  assert err.some?, "Decode error: got nil, want non-nil"
  assert_eq got.unwrap.number1, 1
}

#[derive(Json)]
struct NullStringT {
  #[field(json: "A,string")] a: Int
  #[field(json: "B,string")] b: Int
  #[field(json: "C,string")] c: Int?
}

# Test that a null for ,string is not replaced with the previous quoted
# string (issue 7046). It should also not be an error (issue 2540, issue 8587).
test "TestNullString" {
  s = NullStringT.new(b: 1, c: 2)
  s = json.~unmarshal_into("{\"A\": \"1\", \"B\": null, \"C\": null}", s)
  assert_eq s.b, 1
  assert s.c.none?
}

#[derive(Json)]
struct XAny {
  #[json("X")] x: json.Value
}

test "TestInterfaceSet" {
  # the cases decoding into an interface value (json.Value here)
  for t in [("\"bar\"", "\"bar\""), ("2", "2"), ("true", "true"), ("null", "null"), ("{}", "{}"), ("[]", "[]")] {
    pre = XAny.new(x: json.parse("\"foo\"").unwrap)
    b = json.~unmarshal_into("{\"X\":" + t[0] + "}", pre)
    assert_eq b.x.to_s, t[1]
  }
}

#[derive(Json)]
struct NullTest {
  #[json("Bool")] bool: Bool
  #[json("Int")] int: Int
  #[json("Int8")] int8: I8
  #[json("Int16")] int16: I16
  #[json("Int32")] int32: I32
  #[json("Int64")] int64: Int
  #[json("Uint")] uint: U64
  #[json("Uint8")] uint8: U8
  #[json("Uint16")] uint16: U16
  #[json("Uint32")] uint32: U32
  #[json("Uint64")] uint64: U64
  #[json("Float64")] float64: Float
  #[json("String")] string: Str
  #[json("PBool")] p_bool: Bool?
  #[json("Map")] map: Map[Str, Str]
  #[json("Slice")] slice: [Str]
  #[json("Interface")] interface: json.Value
  #[json("PRaw")] p_raw: json.RawMessage?
  #[json("PTime")] p_time: time.Time?
  #[json("PBigInt")] p_big_int: big.Int?
  #[json("PText")] p_text: MustNotUnmarshalText?
  #[json("PStruct")] p_struct: Empty?
  #[json("Raw")] raw: json.RawMessage
  #[json("Time")] time: time.Time
  #[json("BigInt")] big_int: big.Int
  #[json("Text")] text: MustNotUnmarshalText
  #[json("Struct")] struct: Empty
}

#[derive(Json)]
struct Empty {
}

# JSON null values should be ignored for primitives and string values
# instead of resulting in an error. Issue 2540
test "TestUnmarshalNulls" {
  data = "{\"Bool\": null, \"Int\": null, \"Int8\": null, \"Int16\": null, \"Int32\": null, \"Int64\": null, \"Uint\": null, \"Uint8\": null, \"Uint16\": null, \"Uint32\": null, \"Uint64\": null, \"Float32\": null, \"Float64\": null, \"String\": null, \"PBool\": null, \"Map\": null, \"Slice\": null, \"Interface\": null, \"PRaw\": null, \"PTime\": null, \"PBigInt\": null, \"PText\": null, \"PBuffer\": null, \"PStruct\": null, \"Raw\": null, \"Time\": null, \"BigInt\": null, \"Text\": null, \"Buffer\": null, \"Struct\": null}"
  t0 = time.unix(123456789, 0)
  nulls = NullTest.new(bool: true, int: 2, int8: 3, int16: 4, int32: 5, int64: 6, uint: 7, uint8: 8, uint16: 9, uint32: 10, uint64: 11, float64: 13.1, string: "14", p_bool: false, map: {}, slice: [], interface: json.parse("{}").unwrap, p_raw: json.RawMessage.json_zero, p_time: time.Time.new, p_big_int: big.new_int(0), p_text: MustNotUnmarshalText.new, p_struct: Empty.new, raw: json.RawMessage.from("123"), time: t0, big_int: big.new_int(123))
  before = nulls.time.to_s
  nulls = json.~unmarshal_into(data, nulls)
  assert nulls.bool && nulls.int == 2 && nulls.int8 == 3 && nulls.int16 == 4 && nulls.int32 == 5 && nulls.int64 == 6, "Unmarshal of null values affected primitives"
  assert nulls.uint == 7 && nulls.uint8 == 8 && nulls.uint16 == 9 && nulls.uint32 == 10 && nulls.uint64 == 11 && nulls.float64 == 13.1 && nulls.string == "14", "Unmarshal of null values affected primitives"
  assert nulls.p_bool.none?, "Unmarshal of null did not clear nulls.PBool"
  assert nulls.interface.null?, "Unmarshal of null did not clear nulls.Interface"
  assert nulls.p_raw.none?, "Unmarshal of null did not clear nulls.PRaw"
  assert nulls.p_time.none?, "Unmarshal of null did not clear nulls.PTime"
  assert nulls.p_big_int.none?, "Unmarshal of null did not clear nulls.PBigInt"
  assert nulls.p_text.none?, "Unmarshal of null did not clear nulls.PText"
  assert nulls.p_struct.none?, "Unmarshal of null did not clear nulls.PStruct"
  assert_eq nulls.raw.to_s, "null"
  assert_eq nulls.time.to_s, before
  assert_eq nulls.big_int.to_s, "123"
}

test "TestUnmarshalTypeError" {
  # issue 4628
  r = json.unmarshal_into("{\"user\": \"name\"}", "")
  case r.err.unwrap {
    json.JsonError.Type(_, _, _, _, _, _) => nil
    _ => assert false, "want a type error"
  }
}

test "TestUnmarshalTypeErrorMessage" {
  tests = [
    ("", "json: cannot unmarshal number 5 into Go struct field Root. of type Int"),
    ("1", "json: cannot unmarshal number 5 into Root.1 of type Int"),
    ("foo", "json: cannot unmarshal number 5 into Go struct field Root.foo of type Int"),
    ("foo.1", "json: cannot unmarshal number 5 into Root.foo.1 of type Int"),
    ("foo.bar", "json: cannot unmarshal number 5 into Go struct field Root.foo.bar of type Int"),
    ("foo.bar.1", "json: cannot unmarshal number 5 into Root.foo.bar.1 of type Int"),
    ("foo.bar.baz", "json: cannot unmarshal number 5 into Go struct field Root.foo.bar.baz of type Int"),
  ]
  for t in tests {
    e = json.JsonError.Type(value: "number 5", type_name: "Int", offset: 1234, struct_name: "Root", field: t[0], cause: "")
    assert_eq e.message, t[1]
  }
}

test "TestUnmarshalSyntax" {
  for s in ["tru", "fals", "nul", "123e", "\"hello", "[1,2,3", "{\"key\":1", "{\"key\":1,"] {
    r = json.unmarshal_into(s, json.Value.json_zero)
    case r.err.unwrap {
      json.JsonError.Syntax(_, _) => nil
      _ => assert false, "want a syntax error for #{s}"
    }
  }
}

# Test handling of unexported fields that should be ignored. Issue 4660
#[derive(Json)]
struct UnexportedFields {
  #[json("Name")] name: Str
  #[json(skip)] m: Map[Str, json.Value]
  #[json(skip)] m2: Map[Str, json.Value]
  #[json(skip)] s: [Int]
}

test "TestUnmarshalUnexported" {
  input = "{\"Name\": \"Bob\", \"m\": {\"x\": 123}, \"m2\": {\"y\": 456}, \"abcd\": {\"z\": 789}, \"s\": [2, 3]}"
  out = json.~unmarshal_into(input, UnexportedFields.json_zero)
  assert_eq out.name, "Bob"
  assert_eq out.m.size + out.m2.size + out.s.size, 0
}

# Time3339 is a time.Time which encodes to and from JSON as an RFC 3339
# time in UTC.
struct Time3339 {
  t: time.Time

  def unmarshal_json!(b: [Byte]) -> ~Unit {
    if b.size < 2 || b[0] != 34 || b[b.size - 1] != 34 {
      fail json.JsonError.Custom(msg: "types: failed to unmarshal non-string value #{Str.from_bytes(b)} as an RFC 3339 time")
    }
    self.t = time.~parse(time.RFC3339, Str.from_bytes(b[1...(b.size - 1)]))
  }
}

test "TestUnmarshalJSONLiteralError" {
  r = json.unmarshal_into("\"0000-00-00T00:00:00Z\"", Time3339.new)
  assert r.err?, "Unmarshal error: got nil, want non-nil"
  assert r.err.unwrap.message.include?("range"), r.err.unwrap.message
}

#[derive(Json)]
#[json(transparent)]
struct Arr0 {
  v: [json.Value; 0]
}

# Test that extra object elements in an array do not result in a "data
# changing underfoot" error. Issue 3717
test "TestSkipArrayObjects" {
  json.~unmarshal_into("[{}]", Arr0.json_zero)
}

#[derive(Json)]
#[json(transparent)]
struct Arr2 {
  v: [Int; 2]
}

# Test semantics of pre-filled data, such as struct fields, map elements,
# slices, and arrays. Issues 4900 and 8837, among others.
test "TestPrefilled" {
  xyz = XYZ.new(x: json.parse("3").unwrap, y: json.parse("4").unwrap, z: json.parse("1.5").unwrap)
  xyz = json.~unmarshal_into("{\"X\": 1, \"Y\": 2}", xyz)
  assert_eq json.~marshal(xyz), "{\"X\":1,\"Y\":2,\"Z\":1.5}"
  m = AnyMap.new(v: {"X" => json.parse("3").unwrap, "Y" => json.parse("4").unwrap, "Z" => json.parse("1.5").unwrap})
  m = json.~unmarshal_into("{\"X\": 1, \"Y\": 2}", m)
  assert_eq json.~marshal(m), "{\"X\":1,\"Y\":2,\"Z\":1.5}"
  s = json.~unmarshal_into("[2]", IntSlice.new(v: [1]))
  assert s.v == [2]
  s = json.~unmarshal_into("[2, 3]", IntSlice.new(v: [1]))
  assert s.v == [2, 3]
  a1 = json.~unmarshal_into("[2, 3]", Arr1.new(v: [1]))
  assert_eq a1.v[0], 2
  a2 = json.~unmarshal_into("[3]", Arr2.new(v: [1, 2]))
  assert_eq a2.v[0], 3
  assert_eq a2.v[1], 0
}

#[derive(Json)]
#[data("")]
struct InvalidStringOption {
  #[field(json: ",string")] t: time.Time
  #[field(json: ",string")] m: Map[Str, Str]
  #[field(json: ",string")] s: [Str]
  #[field(json: ",string")] a: [Str; 1]
  #[field(json: ",string")] i: json.Value
  #[field(json: ",string")] p: Int?
}

# Test that string option is ignored for invalid types. Issue 9812.
test "TestInvalidStringOption" {
  item = InvalidStringOption.new(i: json.parse("0").unwrap, p: 0)
  data = json.~marshal(item)
  json.~unmarshal_into(data, item)
}

# ---- TestUnmarshalEmbeddedUnexported (S1 and S5 aside: see the header)

#[derive(Json)]
struct EmbedQ1 {
  #[json("Q")] q: Int
}

#[derive(Json)]
struct EmbedQ2 {
  #[json("Q")] q: Int
}

#[derive(Json)]
struct EuS2 {
  #[field(json: ",embed")] embed1: EmbedQ1?
  #[json("Q")] q: Int
}

#[derive(Json)]
struct EuS3 {
  #[field(json: ",embed")] embed1: EmbedQ1
  #[json("R")] r: Int
}

#[derive(Json)]
struct EuS4 {
  #[field(json: ",embed")] embed1: EmbedQ1?
  #[field(json: ",embed")] embed2: EmbedQ2
}

#[derive(Json)]
struct EuS6 {
  #[json("embed1")] embed1: EmbedQ1
}

#[derive(Json)]
struct EuS7 {
  #[json("embed1")] embed1: EmbedQ1
  #[field(json: ",embed")] embed2: EmbedQ2
}

#[derive(Json)]
struct EuS8 {
  #[json("embed1")] embed1: EmbedQ1
  #[json("embed2")] embed2: EmbedQ2
  #[json("Q")] q: Int
}

#[derive(Json)]
struct UnexportedWithMethods {
  def f {
  }
}

#[derive(Json)]
struct EuS9 {
  #[json("embed")] e: UnexportedWithMethods
}

test "TestUnmarshalEmbeddedUnexported" {
  # The top level Q field takes precedence.
  s2 = json.~unmarshal_into("{\"Q\":1}", EuS2.json_zero)
  assert_eq s2.q, 1
  assert s2.embed1.none?
  # No issue with non-pointer variant.
  s3 = json.~unmarshal_into("{\"R\":2,\"Q\":1}", EuS3.json_zero)
  assert_eq s3.embed1.q, 1
  assert_eq s3.r, 2
  # No error since both embedded structs have field Q, which annihilate
  # each other. Thus, no attempt is made at setting S4.embed1.
  s4 = json.~unmarshal_into("{\"R\":2}", EuS4.json_zero)
  assert s4.embed1.none?
  # Issue 24152
  s6 = json.~unmarshal_into("{\"embed1\": {\"Q\": 1}}", EuS6.json_zero)
  assert_eq s6.embed1.q, 1
  # Issue 24153
  s7 = json.~unmarshal_into("{\"embed1\": {\"Q\": 1}, \"Q\": 2}", EuS7.json_zero)
  assert_eq s7.embed1.q, 1
  assert_eq s7.embed2.q, 2
  s8 = json.~unmarshal_into("{\"embed1\": {\"Q\": 1}, \"embed2\": {\"Q\": 2}, \"Q\": 3}", EuS8.json_zero)
  assert_eq s8.embed1.q, 1
  assert_eq s8.embed2.q, 2
  assert_eq s8.q, 3
  # Issue 28145
  json.~unmarshal_into("{\"embed\": {}}", EuS9.json_zero)
}

test "TestUnmarshalErrorAfterMultipleJSON" {
  tests = [
    ("1 false null :", "invalid character ':' looking for beginning of value", "1 false null :".size),
    ("1 [] [,]", "invalid character ',' looking for beginning of value", "1 [] [,".size),
    ("1 [] [true:]", "invalid character ':' after array element", "1 [] [true:".size),
    ("1  {}    {\"x\"=}", "invalid character '=' after object key", "1  {}    {\"x\"=".size),
    ("falsetruenul#", "invalid character '#' in literal null (expecting 'l')", "falsetruenul#".size),
  ]
  for t in tests {
    dec = json.new_decoder(bytes.new_reader(t[0].bytes))
    err: Error? = none
    loop {
      _v, e = dec.decode_partial!(json.Value.json_zero)
      if x = e {
        err = x
        break
      }
      break if _v.none?
    }
    case err.unwrap {
      json.JsonError.Syntax(m, o) => {
        assert_eq m, t[1]
        assert_eq o, t[2]
      }
      _ => assert false, "want a syntax error, got #{err.unwrap.message}"
    }
  }
}

struct UnmarshalPanic {
  def unmarshal_json!(data: [Byte]) -> ~Unit {
    panic "0xdead"
  }
}

test "TestUnmarshalPanic" {
  assert_panics("0xdead") { json.unmarshal_into("{}", UnmarshalPanic.new).err? }
}

#[derive(Json)]
struct F1String {
  #[field(json: "F1,string")] f1: Str
}

test "TestUnmarshalRescanLiteralMangledUnquote" {
  # See golang.org/issues/38126 (the map halves: see the header).
  want = F1String.new(f1: "aaa\tbbb")
  b = json.~marshal(want)
  got = json.~unmarshal_into(b, F1String.json_zero)
  assert_eq got.f1, want.f1
}

#[derive(Json)]
struct DepthA {
  a: json.Value
}

#[derive(Json)]
struct DepthB {
  b: json.Value
}

test "TestUnmarshalMaxDepth" {
  tests = [
    ("{\"a\":" + "[" * (10000 - 1) + "]" * (10000 - 1) + "}", false),
    ("{\"a\":" + "[" * 10000 + "]" * 10000 + "}", true),
    ("{\"a\":" + "[" * 3000000 + "]" * 3000000 + "}", true),
    ("{\"a\":" + "{\"a\":" * (10000 - 1) + "0" + "}" * (10000 - 1) + "}", false),
    ("{\"a\":" + "{\"a\":" * 10000 + "0" + "}" * 10000 + "}", true),
    ("{\"a\":" + "{\"a\":" * 3000000 + "0" + "}" * 3000000 + "}", true),
  ]
  for t in tests {
    data, want_err = t
    errs: [Error?] = []
    errs << json.unmarshal_into(data, json.Value.json_zero).err
    errs << json.unmarshal_into(data, DepthA.json_zero).err
    errs << json.unmarshal_into(data, DepthB.json_zero).err
    errs << json.unmarshal_into(data, Unmarshaler.new).err
    for e in errs {
      if want_err {
        assert e.some? && e.unwrap.message.include?("exceeded max depth")
      } else {
        assert e.none?
      }
    }
  }
}
