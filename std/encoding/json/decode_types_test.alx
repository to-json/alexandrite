# TestUnmarshal's check for one case: decode `s` with a stream Decoder (as
# Go's test does) into `zero`; the value's JSON and the error, then the
# round trip (marshal, decode again: the same JSON).
def ut[X](s: Str, zero: X, use_number: Bool, disallow: Bool) -> Str {
  d = json.new_decoder(bytes.new_reader(s.bytes))
  d.use_number! if use_number
  d.disallow_unknown_fields! if disallow
  v, err = d.decode_partial!(zero)
  val = v || zero
  out = res_text(json.marshal(val))
  if e = err {
    out = out + " | " + err_text(e)
  } else if v.none? {
    out = out + " | EOF"
  } else {
    enc = json.marshal(val).unwrap_or("")
    d2 = json.new_decoder(bytes.new_reader(enc.bytes))
    d2.use_number! if use_number
    v2, err2 = d2.decode_partial!(zero)
    if err2.some? || json.marshal(v2 || zero).unwrap_or("?") != enc {
      out = out + " | round trip differs"
    }
  }
  out
}
