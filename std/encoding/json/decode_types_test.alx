#![test(external)]
# The types of Go's decode_test.go, in alx. Go's untagged exported fields
# are alx fields tagged with the Go name (`#[json("X")] x`), so the JSON is
# Go's; Go types that aren't structs (a named byte with methods, a slice or
# map as the top-level value) are one-field transparent structs; anonymous
# struct types are named, with `#[data("")]` so errors show Go's empty name.

import "bytes"
import "encoding/json"
import "strconv"
import "strings"

#[derive(Json)]
struct T {
  #[json("X")] x: Str
  #[json("Y")] y: Int
  #[json(skip)] z: Int
}

#[derive(Json)]
struct U {
  #[json("alpha")] alphabet: Str
}

#[derive(Json)]
struct V {
  #[json("F1")] f1: json.Value
  #[json("F2")] f2: I32
  #[json("F3")] f3: json.Number
  #[json("F4")] f4: VOuter?
}

#[derive(Json)]
struct VOuter {
  #[json("V")] v: V
}

#[derive(Json)]
struct W {
  #[json("S")] s: SS
}

#[derive(Json)]
struct P {
  #[json("PP")] pp: PP
}

#[derive(Json)]
struct PP {
  #[json("T")] t: T
  #[json("Ts")] ts: [T]
}

# Go: type SS string, whose UnmarshalJSON always fails.
#[derive(Json)]
#[json(transparent)]
struct SS {
  s: Str

  def unmarshal_json!(data: [Byte]) -> ~Unit {
    fail json.JsonError.Type(value: "number", type_name: "SS", offset: 0, struct_name: "", field: "", cause: "")
  }
}

# Go: type TAlias T, decoding through Unmarshal into a T.
#[derive(Json)]
struct TAlias {
  #[json("X")] x: Str
  #[json("Y")] y: Int
  #[json(skip)] z: Int

  def unmarshal_json!(data: [Byte]) -> ~Unit {
    t = json.~unmarshal_into(data, T.json_zero)
    self.x = t.x
    self.y = t.y
  }
}

#[derive(Json)]
struct TOuter {
  #[json("T")] t: TAlias
}

# Go: struct { x int } (the field is unexported: not JSON).
#[derive(Json)]
struct Tx {
  #[json(skip)] x: Int
}

# A type that can unmarshal itself.
#[derive(Json)]
struct Unmarshaler {
  #[json("T")] t: Bool

  def unmarshal_json!(b: [Byte]) -> ~Unit {
    self.t = true
  }
}

#[derive(Json)]
struct Ustruct {
  #[json("M")] m: Unmarshaler
}

struct UnmarshalerText {
  a: Str
  b: Str

  def marshal_text -> ~[Byte] { (a + ":" + b).bytes }

  def unmarshal_text!(b: [Byte]) -> ~Unit {
    t = Str.from_bytes(b)
    pos = strings.index(t, ":")
    fail json.JsonError.Custom(msg: "missing separator") if pos < 0
    self.a = t[0...pos]
    self.b = t[(pos + 1)...t.size]
  }
}

#[derive(Json)]
struct UstructText {
  #[json("M")] m: UnmarshalerText
}

# Go: type u8marshal uint8, with MarshalText / UnmarshalText.
struct U8marshal {
  v: U8

  def marshal_text -> ~[Byte] { "u#{v}".bytes }

  def unmarshal_text!(b: [Byte]) -> ~Unit {
    t = Str.from_bytes(b)
    fail json.JsonError.Custom(msg: "missing 'u' prefix") if !t.start_with?("u")
    n = strconv.~atoi(t[1...t.size])
    self.v = n.as_u8
  }
}

# ---- Go's embedding tests (Top, S5, S10). Go's rules depend on which
# names are tags, so these mirrors spell every JSON name (Go's field names
# and tags) with a lower-case first letter, untagged where Go is untagged;
# the cases' JSON gets the same spelling (vec_unmarshal_test.alx).

#[derive(Json)]
struct Point {
  z: Int
}

# Go's image.Point (its X and Y keep Go's spelling: Top has a tag "x")
#[derive(Json)]
struct ImagePoint {
  #[json("X")] x: Int
  #[json("Y")] y: Int
}

#[derive(Json)]
struct Top {
  level0: Int
  #[field(json: ",embed")] embed0: Embed0
  #[field(json: ",embed")] embed0a: Embed0a?
  # treated as named
  #[field(json: "e,omitempty")] embed0b: Embed0b?
  # ignored
  #[json(skip)] embed0c: Embed0c
  #[field(json: ",embed")] loop: Loop
  # has Point with X, Y, used
  #[field(json: ",embed")] embed0p: Embed0p
  # has Point with Z, used
  #[field(json: ",embed")] embed0q: Embed0q
  # Go: an unexported embedded type with an exported field
  #[field(json: ",embed")] embedx: Embedx
}

#[derive(Json)]
struct Embed0 {
  # overridden by Embed0a's level1a with json tag
  level1a: Int
  # used because Embed0a's level1b is renamed
  level1b: Int
  # used because Embed0a's level1c is ignored
  level1c: Int
  # annihilated by Embed0a's level1d
  level1d: Int
  # annihilated by Embed0a.level1f
  #[json("x")] level1e: Int
}

#[derive(Json)]
struct Embed0a {
  #[field(json: "level1a,omitempty")] level1a: Int
  #[field(json: "lEVEL1B,omitempty")] level1b: Int
  #[json(skip)] level1c: Int
  level1d: Int
  #[json("x")] level1f: Int
}

#[derive(Json)]
struct Embed0b {
  level1a: Int
  level1b: Int
  level1c: Int
  level1d: Int
  #[json("x")] level1e: Int
}

#[derive(Json)]
struct Embed0c {
  level1a: Int
  level1b: Int
  level1c: Int
  level1d: Int
  #[json("x")] level1e: Int
}

#[derive(Json)]
struct Embed0p {
  #[field(json: ",embed")] point: ImagePoint
}

#[derive(Json)]
struct Embed0q {
  #[field(json: ",embed")] point: Point
}

#[derive(Json)]
struct Embedx {
  q: Int
}

#[derive(Json)]
struct Loop {
  #[field(json: ",omitempty")] loop1: Int
  #[field(json: ",omitempty")] loop2: Int
  #[field(json: ",embed")] loop: Loop?
}

# From reflect test: the X in S6 and S7 annihilate, but they also block the
# X in S8.S9.
#[derive(Json)]
struct S5 {
  #[field(json: ",embed")] s6: S6
  #[field(json: ",embed")] s7: S7
  #[field(json: ",embed")] s8: S8
}

#[derive(Json)]
struct S6 {
  x: Int
}

#[derive(Json)]
struct S7 {
  x: Int
}

#[derive(Json)]
struct S8 {
  #[field(json: ",embed")] s9: S9
}

#[derive(Json)]
struct S9 {
  x: Int
  y: Int
}

# From reflect test: the X in S11.S6 and S12.S6 annihilate, but they also
# block the X in S13.S8.S9.
#[derive(Json)]
struct S10 {
  #[field(json: ",embed")] s11: S11
  #[field(json: ",embed")] s12: S12
  #[field(json: ",embed")] s13: S13
}

#[derive(Json)]
struct S11 {
  #[field(json: ",embed")] s6: S6
}

#[derive(Json)]
struct S12 {
  #[field(json: ",embed")] s6: S6
}

#[derive(Json)]
struct S13 {
  #[field(json: ",embed")] s8: S8
}

#[derive(Json)]
struct Ambig {
  # Given "hello", the first match should win.
  #[json("HELLO")] first: Int
  #[json("Hello")] second: Int
}

#[derive(Json)]
struct XYZ {
  #[json("X")] x: json.Value
  #[json("Y")] y: json.Value
  #[json("Z")] z: json.Value
}

# Go: type byteWithMarshalJSON byte (and the pointer-method twins, which are
# the same in alx: methods don't care whether the value is addressable).
#[derive(Json)]
#[json(transparent)]
struct ByteWithMarshalJSON {
  v: U8

  def marshal_json -> ~[Byte] { "\"Z#{hex2(v.to_i)}\"".bytes }

  def unmarshal_json!(data: [Byte]) -> ~Unit {
    self.v = ~unhex_quoted(data).as_u8
  }
}

#[derive(Json)]
#[json(transparent)]
struct ByteWithPtrMarshalJSON {
  v: U8

  def marshal_json -> ~[Byte] { "\"Z#{hex2(v.to_i)}\"".bytes }

  def unmarshal_json!(data: [Byte]) -> ~Unit {
    self.v = ~unhex_quoted(data).as_u8
  }
}

#[derive(Json)]
#[json(transparent)]
struct ByteWithMarshalText {
  v: U8

  def marshal_text -> ~[Byte] { "Z#{hex2(v.to_i)}".bytes }

  def unmarshal_text!(data: [Byte]) -> ~Unit {
    self.v = ~unhex_text(data).as_u8
  }
}

#[derive(Json)]
#[json(transparent)]
struct ByteWithPtrMarshalText {
  v: U8

  def marshal_text -> ~[Byte] { "Z#{hex2(v.to_i)}".bytes }

  def unmarshal_text!(data: [Byte]) -> ~Unit {
    self.v = ~unhex_text(data).as_u8
  }
}

#[derive(Json)]
#[json(transparent)]
struct IntWithMarshalJSON {
  v: Int

  def marshal_json -> ~[Byte] { "\"Z#{hex2(v)}\"".bytes }

  def unmarshal_json!(data: [Byte]) -> ~Unit {
    self.v = ~unhex_quoted(data)
  }
}

#[derive(Json)]
#[json(transparent)]
struct IntWithPtrMarshalJSON {
  v: Int

  def marshal_json -> ~[Byte] { "\"Z#{hex2(v)}\"".bytes }

  def unmarshal_json!(data: [Byte]) -> ~Unit {
    self.v = ~unhex_quoted(data)
  }
}

#[derive(Json)]
#[json(transparent)]
struct IntWithMarshalText {
  v: Int

  def marshal_text -> ~[Byte] { "Z#{hex2(v)}".bytes }

  def unmarshal_text!(data: [Byte]) -> ~Unit {
    self.v = ~unhex_text(data)
  }
}

#[derive(Json)]
#[json(transparent)]
struct IntWithPtrMarshalText {
  v: Int

  def marshal_text -> ~[Byte] { "Z#{hex2(v)}".bytes }

  def unmarshal_text!(data: [Byte]) -> ~Unit {
    self.v = ~unhex_text(data)
  }
}

# fmt.Sprintf("%.2x", v)
def hex2(v: Int) -> Str {
  s = strconv.format_int(v, 16)
  s.size < 2 ? "0" + s : s
}

# "Zxx" (quoted) -> the byte: Go's test methods.
def unhex_quoted(data: [Byte]) -> ~Int {
  fail json.JsonError.Custom(msg: "bad quoted string") if data.size != 5 || data[0] != 34 || data[1] != 90 || data[4] != 34
  r = strconv.parse_int(Str.from_bytes(data[2...4]), 16, 8)
  fail json.JsonError.Custom(msg: "bad hex") if r.err?
  r.unwrap
}

def unhex_text(data: [Byte]) -> ~Int {
  fail json.JsonError.Custom(msg: "bad quoted string") if data.size != 3 || data[0] != 90
  r = strconv.parse_int(Str.from_bytes(data[1...3]), 16, 8)
  fail json.JsonError.Custom(msg: "bad hex") if r.err?
  r.unwrap
}

#[derive(Json)]
struct MapStringToStringData {
  #[json("data")] data: Map[Str, Str]
}

#[derive(Json)]
struct B {
  #[field(json: "B,string")] b: Bool
}

# Go: I and J are **int; alx has one level of option.
#[derive(Json)]
struct DoublePtr {
  #[json("I")] i: Int?
  #[json("J")] j: Int?
}

#[derive(Json)]
#[data("")]
struct NestedUnamedF {
  #[json("V")] v: Int
}

#[derive(Json)]
struct NestedUnamed {
  #[json("F")] f: NestedUnamedF
}

#[derive(Json)]
struct Small {
  #[json("Tag")] tag: Str
}

# Go's All (decode_test.go) without its float32 fields: alx has no float32.
# uint and uintptr are U64.
#[derive(Json)]
struct All {
  #[json("Bool")] bool: Bool
  #[json("Int")] int: Int
  #[json("Int8")] int8: I8
  #[json("Int16")] int16: I16
  #[json("Int32")] int32: I32
  #[json("Int64")] int64: Int
  #[json("Uint")] uint: U64
  #[json("Uint8")] uint8: U8
  #[json("Uint16")] uint16: U16
  #[json("Uint32")] uint32: U32
  #[json("Uint64")] uint64: U64
  #[json("Uintptr")] uintptr: U64
  #[json("Float64")] float64: Float
  #[json("bar")] foo: Str
  #[field(json: "bar2,dummyopt")] foo2: Str
  #[field(json: "IntStr,string")] int_str: Int
  #[field(json: "UintptrStr,string")] uintptr_str: U64
  #[json("PBool")] p_bool: Bool?
  #[json("PInt")] p_int: Int?
  #[json("PInt8")] p_int8: I8?
  #[json("PInt16")] p_int16: I16?
  #[json("PInt32")] p_int32: I32?
  #[json("PInt64")] p_int64: Int?
  #[json("PUint")] p_uint: U64?
  #[json("PUint8")] p_uint8: U8?
  #[json("PUint16")] p_uint16: U16?
  #[json("PUint32")] p_uint32: U32?
  #[json("PUint64")] p_uint64: U64?
  #[json("PUintptr")] p_uintptr: U64?
  #[json("PFloat64")] p_float64: Float?
  #[json("String")] string: Str
  #[json("PString")] p_string: Str?
  #[json("Map")] map: Map[Str, Small]
  #[json("MapP")] map_p: Map[Str, Small?]
  #[json("PMap")] p_map: Map[Str, Small]?
  #[json("PMapP")] p_map_p: Map[Str, Small?]?
  #[json("EmptyMap")] empty_map: Map[Str, Small]
  #[json("NilMap")] nil_map: Map[Str, Small]
  #[json("Slice")] slice: [Small]
  #[json("SliceP")] slice_p: [Small?]
  #[json("PSlice")] p_slice: [Small]?
  #[json("PSliceP")] p_slice_p: [Small?]?
  #[json("EmptySlice")] empty_slice: [Small]
  #[json("NilSlice")] nil_slice: [Small]
  #[json("StringSlice")] string_slice: [Str]
  #[json("ByteSlice")] byte_slice: [Byte]
  #[json("Small")] small: Small
  #[json("PSmall")] p_small: Small?
  #[json("PPSmall")] pp_small: Small?
  #[json("Interface")] interface: json.Value
  #[json("PInterface")] p_interface: json.Value?
  # issue #79921: Go ignores the embed option on an int
  #[field(json: "InvalidEmbed,embed")] invalid_embed: Int
  #[json(skip)] unexported: Int
}

# Go: struct{} with an UnmarshalJSON on the value (Go's v2 calls it through
# the pointer).
#[derive(Json)]
struct MustNotUnmarshalJSON {
  def unmarshal_json!(data: [Byte]) -> ~Unit {
    fail json.JsonError.Custom(msg: "MustNotUnmarshalJSON was used")
  }
}

#[derive(Json)]
struct MustNotUnmarshalText {
  def unmarshal_text!(text: [Byte]) -> ~Unit {
    fail json.JsonError.Custom(msg: "MustNotUnmarshalText was used")
  }
}

