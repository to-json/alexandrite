import "encoding/json"
import "strings"

#[derive(Json)]
struct Addr {
  city: Str
  #[json("zip-code")] zip: Int
}

#[derive(Json)]
enum Shape {
  Dot
  Circle(Float)
  Pair(Int, Str)
  Rect(w: Float, h: Float)
  #[json("tri")] Tri(a: Addr)
}

#[derive(Json)]
struct Scalars {
  i: Int
  i8: I8
  i16: I16
  i32: I32
  u8: U8
  u16: U16
  u32: U32
  u64: U64
  f: Float
  b: Bool
  s: Str
}

#[derive(Json)]
struct Big {
  o: Str?
  o2: Int?
  xs: [Int]
  ys: [[Str]]
  m: Map[Str, Int]
  t: (Int, Str)
  a: Addr
  addrs: [Addr]
  sh: Shape
  shs: [Shape]
  #[json(omit_empty)] e: [Int]
  #[json(omit_empty)] z: Int
  #[json(omit_empty)] os: Str?
  #[json(skip)] hidden: Int
  v: json.Value
}

def raw(b: [Byte]) -> Str { Str.from_bytes(b) }

def shown(s: Str) -> ~Str {
  v = ~Shape.from_json(s)
  v.~to_json
}

def enc_err(v: Float) -> Str {
  e = json.new_encoder()
  e.float!(v)
  r = e.finish!
  r.err? ? "error" : r.unwrap_or("")
}

def fl(v: Float) -> Str {
  e = json.new_encoder()
  e.float!(v)
  r = e.finish!
  r.unwrap_or("ERR")
}

test "scalars round trip" {
  s = Scalars.new(i: -9223372036854775807, i8: -128, i16: 32767, i32: -2147483648, u8: 255, u16: 65535, u32: 4294967295, u64: 18446744073709551615, f: 0.25, b: true, s: "tab\there")
  j = ~s.to_json
  assert_eq j, "{\"i\":-9223372036854775807,\"i8\":-128,\"i16\":32767,\"i32\":-2147483648,\"u8\":255,\"u16\":65535,\"u32\":4294967295,\"u64\":18446744073709551615,\"f\":0.25,\"b\":true,\"s\":\"tab\\there\"}"
  t = ~Scalars.from_json(j)
  assert_eq t.u64, 18446744073709551615
  assert_eq t.i, -9223372036854775807
  assert_eq t.i8, -128
  assert_eq t.s, "tab\there"
  assert_eq ~t.to_json, j
}

test "int limits" {
  assert_eq (~Scalars.from_json("{\"i\": -9223372036854775808}")).i, -9223372036854775807 - 1
  assert Scalars.from_json("{\"i\": 9223372036854775808}").err?
  assert Scalars.from_json("{\"u8\": 256}").err?
  assert Scalars.from_json("{\"u8\": -1}").err?
  assert Scalars.from_json("{\"i8\": 128}").err?
  assert Scalars.from_json("{\"i8\": -129}").err?
  assert Scalars.from_json("{\"u64\": 18446744073709551616}").err?
  assert_eq (~Scalars.from_json("{\"u64\": 18446744073709551615}")).u64, 18446744073709551615
  assert Scalars.from_json("{\"i\": 1.5}").err?
  assert Scalars.from_json("{\"i\": 1e2}").err?
  assert_eq (~Scalars.from_json("{\"f\": 1e2}")).f, 100.0
  assert_eq (~Scalars.from_json("{\"f\": -1.25E-2}")).f, -0.0125
  assert_eq (~Scalars.from_json("{\"f\": 123456789012345678901234567890}")).f, 1.2345678901234568e29
}

test "type errors name the field" {
  assert_eq Scalars.from_json("{\"i\": \"x\"}").err?.message || "", "json: cannot unmarshal string into field Scalars.i of type Int"
  assert_eq Scalars.from_json("{\"u8\": 300}").err?.message || "", "json: cannot unmarshal number 300 into field Scalars.u8 of type U8"
  assert_eq Scalars.from_json("{\"b\": 1}").err?.message || "", "json: cannot unmarshal number into field Scalars.b of type Bool"
  assert_eq Scalars.from_json("{\"s\": [1]}").err?.message || "", "json: cannot unmarshal array into field Scalars.s of type Str"
  assert_eq Scalars.from_json("{\"f\": {}}").err?.message || "", "json: cannot unmarshal object into field Scalars.f of type Float"
  assert_eq Scalars.from_json("[1]").err?.message || "", "json: cannot unmarshal array into value of type object"
  assert_eq Scalars.from_json("{\"i\": 1,}").err?.message || "", "invalid character '}' looking for beginning of object key string"
  # a syntax error later in the text wins over an earlier type error
  assert_eq Scalars.from_json("{\"i\": \"x\", \"b\": tru}").err?.message || "", "invalid character '}' in literal true (expecting 'e')"
}

test "unknown fields and nulls" {
  s = ~Scalars.from_json("{\"zzz\": {\"a\": [1, 2, {\"b\": null}]}, \"i\": 7, \"extra\": \"x\", \"s\": null, \"b\": null}")
  assert_eq s.i, 7
  assert_eq s.s, ""
  assert_eq s.b, false
  t = ~Scalars.from_json("  {}  ")
  assert_eq t.i, 0
  u = ~Scalars.from_json("null")
  assert_eq u.i, 0
  w = ~Scalars.from_json("{\"i\": 1, \"i\": 2}")
  assert_eq w.i, 2
}

test "strings and unicode escapes" {
  s = ~Scalars.from_json("{\"s\": \"a\\u00e9\\u4e16\\n\\\"\\\\\\/\\b\\f\\r\\t\"}")
  assert_eq s.s, "aé世\n\"\\/\b\f\r\t"
  p = ~Scalars.from_json("{\"s\": \"\\ud83d\\ude00!\"}")
  assert_eq p.s, "😀!"
  assert_eq p.s.size, 5
  lone = ~Scalars.from_json("{\"s\": \"\\ud83d x\"}")
  assert_eq lone.s, "\ufffd x"
  lone2 = ~Scalars.from_json("{\"s\": \"\\ude00\"}")
  assert_eq lone2.s, "\ufffd"
  bad = ~Scalars.from_json("{\"s\": \"" + raw([97, 255, 98]) + "\"}")
  assert_eq bad.s, "a\ufffdb"
  raw = ~Scalars.from_json("{\"s\": \"héllo 日本\"}")
  assert_eq raw.s, "héllo 日本"
  k = ~Scalars.from_json("{\"\\u0069\": 5}")
  assert_eq k.i, 5
}

test "containers and options" {
  b = Big.new(o: "x", xs: [1, 2, 3], ys: [["a"], []], m: {"k" => 1, "j" => 2}, t: (7, "seven"), a: Addr.new(city: "Z", zip: 9), addrs: [Addr.new(city: "Q", zip: 1)], sh: Shape.Rect(1.5, 2.0), shs: [Shape.Dot, Shape.Circle(2.0), Shape.Pair(1, "p"), Shape.Tri(Addr.new(city: "T", zip: 3))], hidden: 4, v: ~json.parse("[1,{\"a\":null}]"))
  j = ~b.to_json
  assert_eq j, "{\"o\":\"x\",\"o2\":null,\"xs\":[1,2,3],\"ys\":[[\"a\"],[]],\"m\":{\"k\":1,\"j\":2},\"t\":[7,\"seven\"],\"a\":{\"city\":\"Z\",\"zip-code\":9},\"addrs\":[{\"city\":\"Q\",\"zip-code\":1}],\"sh\":{\"Rect\":{\"w\":1.5,\"h\":2}},\"shs\":[\"Dot\",{\"Circle\":2},{\"Pair\":[1,\"p\"]},{\"tri\":{\"a\":{\"city\":\"T\",\"zip-code\":3}}}],\"v\":[1,{\"a\":null}]}"
  c = ~Big.from_json(j)
  assert_eq ~c.to_json, j
  assert_eq c.o || "", "x"
  assert c.o2.none?
  assert_eq c.xs.size, 3
  assert_eq c.ys[0][0], "a"
  assert_eq c.ys[1].size, 0
  assert_eq c.m.size, 2
  assert_eq c.t, (7, "seven")
  assert_eq c.a.zip, 9
  assert_eq c.hidden, 0
  assert_eq c.shs.size, 4
  assert_eq c.v.at(1).unwrap.get("a").unwrap.null?, true
}

test "omit_empty and skip" {
  b = Big.new(o: none, xs: [], ys: [], m: {}, t: (0, ""), a: Addr.new(city: "", zip: 0), addrs: [], sh: Shape.Dot, shs: [], hidden: 5, v: json.Value.new(nodes: [], edges: [], id: 0))
  j = ~b.to_json
  assert_eq j, "{\"o\":null,\"o2\":null,\"xs\":[],\"ys\":[],\"m\":{},\"t\":[0,\"\"],\"a\":{\"city\":\"\",\"zip-code\":0},\"addrs\":[],\"sh\":\"Dot\",\"shs\":[],\"v\":null}"
  b2 = Big.new(o: "q", xs: [], ys: [], m: {}, t: (0, ""), a: Addr.new(city: "", zip: 0), addrs: [], sh: Shape.Dot, shs: [], e: [1], z: 2, os: "z", v: json.Value.new(nodes: [], edges: [], id: 0))
  assert strings.contains(~b2.to_json, "\"e\":[1],\"z\":2,\"os\":\"z\"")
  # hidden is never read back
  c = ~Big.from_json("{\"hidden\": 9, \"t\": [1, \"a\"]}")
  assert_eq c.hidden, 0
}

test "enums" {
  assert_eq Shape.Dot.~to_json, "\"Dot\""
  assert_eq Shape.Circle(1.5).~to_json, "{\"Circle\":1.5}"
  assert_eq Shape.Pair(2, "x").~to_json, "{\"Pair\":[2,\"x\"]}"
  assert_eq Shape.Rect(1.0, 2.0).~to_json, "{\"Rect\":{\"w\":1,\"h\":2}}"
  assert_eq Shape.Tri(Addr.new(city: "c", zip: 1)).~to_json, "{\"tri\":{\"a\":{\"city\":\"c\",\"zip-code\":1}}}"
  assert_eq ~shown("\"Dot\""), "\"Dot\""
  assert_eq ~shown("{\"Circle\": 4}"), "{\"Circle\":4}"
  assert_eq ~shown("{\"Dot\": null}"), "\"Dot\""
  assert_eq ~shown(" { \"Pair\" : [ 3 , \"y\" ] } "), "{\"Pair\":[3,\"y\"]}"
  assert_eq ~shown("{\"Rect\": {\"h\": 5}}"), "{\"Rect\":{\"w\":0,\"h\":5}}"
  assert_eq Shape.from_json("{\"Nope\": 1}").err?.message || "", "json: unknown variant \"Nope\" for Shape"
  assert_eq Shape.from_json("\"Nope\"").err?.message || "", "json: unknown variant \"Nope\" for Shape"
  assert Shape.from_json("\"Circle\"").err?
  assert Shape.from_json("{\"Pair\": [1]}").err?
  assert Shape.from_json("{\"Pair\": [1, \"a\", 2]}").err?
  assert Shape.from_json("5").err?
}

test "tuples" {
  b = ~Big.from_json("{\"t\": [1, \"a\"]}")
  assert_eq b.t, (1, "a")
  assert_eq Big.from_json("{\"t\": [1]}").err?.message || "", "json: cannot unmarshal array of length 1 into field Big.t of type tuple of length 2"
  assert Big.from_json("{\"t\": [1, \"a\", 3]}").err?
  assert Big.from_json("{\"t\": 1}").err?
}

test "to_json_indent" {
  a = Addr.new(city: "X", zip: 5)
  assert_eq ~a.to_json_indent("", "  "), "{\n  \"city\": \"X\",\n  \"zip-code\": 5\n}"
  assert_eq ~json.marshal(a), "{\"city\":\"X\",\"zip-code\":5}"
  assert_eq ~json.marshal_indent(a, ">", "-"), "{\n>-\"city\": \"X\",\n>-\"zip-code\": 5\n>}"
}

test "html escape" {
  assert_eq json.html_escape("{\"a\":\"<b>&\"}"), "{\"a\":\"\\u003cb\\u003e\\u0026\"}"
  a = Addr.new(city: "<&>", zip: 1)
  e = json.new_encoder()
  e.set_escape_html!(false)
  a.json_enc(e)
  assert_eq ~e.finish!, "{\"city\":\"<&>\",\"zip-code\":1}"
}

test "big documents" {
  items = []
  i = 0
  while i < 20000 {
    items << Addr.new(city: "city number #{i}", zip: i * 7)
    i += 1
  }
  e = json.new_encoder()
  e.raw!("[")
  items.each_with_index.each { |a, k|
    e.raw!(",") if k > 0
    a.json_enc(e)
  }
  e.raw!("]")
  w = ~e.finish!
  assert w.size > 600000
  v = ~json.parse(w)
  assert_eq v.size, 20000
  assert_eq v.at(19999).unwrap.get("zip-code").unwrap.as_int || 0, 19999 * 7
  assert json.valid(w)
  assert_eq ~v.to_json, w
}

# Go's struct tag form (GO-VS-RUBY S5): each derive reads its own key; keys
# for other derives (xml, db) are kept for them.
#[derive(Json)]
struct Tagged {
  #[field(json: "id", xml: "id,attr", db: "user_id")] id: Int
  #[field(json: "name,omitempty")] name: Str
  #[field(json: ",omitempty")] note: Str
  #[field(json: "-")] secret: Str
  #[field(data: "Plain")] plain: Int
}

test "field tags" {
  t = Tagged.new(id: 7, name: "", note: "n", secret: "s", plain: 1)
  assert_eq ~t.to_json, "{\"id\":7,\"note\":\"n\",\"plain\":1}"
  t2 = ~Tagged.from_json("{\"id\": 8, \"name\": \"x\", \"secret\": \"no\"}")
  assert_eq t2.id, 8
  assert_eq t2.name, "x"
  assert_eq t2.secret, ""
}
