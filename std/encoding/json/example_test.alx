#![test(external)]
# Go's example_test.go, example_marshaling_test.go and
# example_text_marshaling_test.go (go1.27), translated.

import "bytes"
import "encoding/json"
import "strings"

#[derive(Json)]
struct ColorGroup {
  #[json("ID")] id: Int
  #[json("Name")] name: Str
  #[json("Colors")] colors: [Str]
}

example "Marshal" {
  group = ColorGroup.new(id: 1, name: "Reds", colors: ["Crimson", "Red", "Ruby", "Maroon"])
  b = json.marshal(group)
  if e = b.err {
    puts "error: #{e.message}"
  }
  print b.unwrap_or("")
} outputs "{\"ID\":1,\"Name\":\"Reds\",\"Colors\":[\"Crimson\",\"Red\",\"Ruby\",\"Maroon\"]}"

#[derive(Json)]
struct Animal2 {
  #[json("Name")] name: Str
  #[json("Order")] order: Str
}

#[derive(Json)]
#[json(transparent)]
struct Animals {
  v: [Animal2]
}

example "Unmarshal" {
  json_blob = "[\n\t{\"Name\": \"Platypus\", \"Order\": \"Monotremata\"},\n\t{\"Name\": \"Quoll\",    \"Order\": \"Dasyuromorphia\"}\n]"
  r = json.unmarshal_into(json_blob, Animals.json_zero)
  if e = r.err {
    puts "error: #{e.message}"
  }
  animals = r.unwrap_or(Animals.json_zero).v
  print "[" + animals.map { "{Name:#{it.name} Order:#{it.order}}" }.to_a.join(" ") + "]"
} outputs "[{Name:Platypus Order:Monotremata} {Name:Quoll Order:Dasyuromorphia}]"

#[derive(Json)]
struct Message {
  #[json("Name")] name: Str
  #[json("Text")] text: Str
}

STREAM = "\n\t{\"Name\": \"Ed\", \"Text\": \"Knock knock.\"}\n\t{\"Name\": \"Sam\", \"Text\": \"Who's there?\"}\n\t{\"Name\": \"Ed\", \"Text\": \"Go fmt.\"}\n\t{\"Name\": \"Sam\", \"Text\": \"Go fmt who?\"}\n\t{\"Name\": \"Ed\", \"Text\": \"Go fmt yourself!\"}\n"

# This example uses a Decoder to decode a stream of distinct JSON values.
example "Decoder" {
  dec = json.new_decoder(bytes.new_reader(STREAM.bytes))
  loop {
    m = dec.decode!(Message.json_zero).unwrap || break
    puts "#{m.name}: #{m.text}"
  }
} outputs "Ed: Knock knock.\nSam: Who's there?\nEd: Go fmt.\nSam: Go fmt who?\nEd: Go fmt yourself!\n"

# Go's %T: %v of a token.
def show_token(t: json.Token) -> Str {
  case t {
    json.Token.Delim(r) => "json.Delim: " + json.delim_text(r)
    json.Token.Bool(v) => "bool: #{v}"
    json.Token.Float(v) => "float64: #{v}"
    json.Token.Num(v) => "json.Number: #{v}"
    json.Token.String(v) => "string: " + v
    json.Token.Null => "<nil>: <nil>"
  }
}

# This example uses a Decoder to decode a stream of distinct JSON values.
example "Decoder.token!" {
  stream = "\n\t{\"Message\": \"Hello\", \"Array\": [1, 2, 3], \"Null\": null, \"Number\": 1.234}\n"
  dec = json.new_decoder(bytes.new_reader(stream.bytes))
  loop {
    t = dec.token!.unwrap || break
    print show_token(t)
    print " (more)" if dec.has_more!
    print "\n"
  }
} outputs "json.Delim: { (more)\nstring: Message (more)\nstring: Hello (more)\nstring: Array (more)\njson.Delim: [ (more)\nfloat64: 1 (more)\nfloat64: 2 (more)\nfloat64: 3\njson.Delim: ] (more)\nstring: Null (more)\n<nil>: <nil> (more)\nstring: Number (more)\nfloat64: 1.234\njson.Delim: }\n"

# This example uses a Decoder to decode a streaming array of JSON objects.
example "Decoder.decode! stream" {
  stream = "\n\t[\n\t\t{\"Name\": \"Ed\", \"Text\": \"Knock knock.\"},\n\t\t{\"Name\": \"Sam\", \"Text\": \"Who's there?\"},\n\t\t{\"Name\": \"Ed\", \"Text\": \"Go fmt.\"},\n\t\t{\"Name\": \"Sam\", \"Text\": \"Go fmt who?\"},\n\t\t{\"Name\": \"Ed\", \"Text\": \"Go fmt yourself!\"}\n\t]\n"
  dec = json.new_decoder(bytes.new_reader(stream.bytes))
  # read open bracket
  t = dec.token!.unwrap.unwrap
  puts show_token(t)
  # while the array contains values
  while dec.has_more! {
    # decode an array value (Message)
    m = dec.decode!(Message.json_zero).unwrap.unwrap
    puts "#{m.name}: #{m.text}"
  }
  # read closing bracket
  t = dec.token!.unwrap.unwrap
  puts show_token(t)
} outputs "json.Delim: [\nEd: Knock knock.\nSam: Who's there?\nEd: Go fmt.\nSam: Go fmt who?\nEd: Go fmt yourself!\njson.Delim: ]\n"

#[derive(Json)]
struct Color {
  #[json("Space")] space: Str
  # delay parsing until we know the color space
  #[json("Point")] point: json.RawMessage
}

#[derive(Json)]
#[json(transparent)]
struct Colors {
  v: [Color]
}

#[derive(Json)]
struct RGB {
  #[json("R")] r: U8
  #[json("G")] g: U8
  #[json("B")] b: U8
}

#[derive(Json)]
struct YCbCr {
  #[json("Y")] y: U8
  #[json("Cb")] cb: I8
  #[json("Cr")] cr: I8
}

# This example uses RawMessage to delay parsing part of a JSON message.
example "RawMessage unmarshal" {
  j = "[\n\t{\"Space\": \"YCbCr\", \"Point\": {\"Y\": 255, \"Cb\": 0, \"Cr\": -10}},\n\t{\"Space\": \"RGB\",   \"Point\": {\"R\": 98, \"G\": 218, \"B\": 255}}\n]"
  colors = json.unmarshal_into(j, Colors.json_zero).unwrap.v
  for c in colors {
    if c.space == "RGB" {
      d = json.unmarshal_into(c.point.data, RGB.json_zero).unwrap
      puts "#{c.space} &{#{d.r} #{d.g} #{d.b}}"
    } else if c.space == "YCbCr" {
      y = json.unmarshal_into(c.point.data, YCbCr.json_zero).unwrap
      puts "#{c.space} &{#{y.y} #{y.cb} #{y.cr}}"
    }
  }
} outputs "YCbCr &{255 0 -10}\nRGB &{98 218 255}\n"

#[derive(Json)]
struct WithHeader {
  #[json("header")] header: json.RawMessage?
  #[json("body")] body: Str
}

# This example uses RawMessage to use a precomputed JSON during marshal.
example "RawMessage marshal" {
  h = json.RawMessage.from("{\"precomputed\": true}")
  c = WithHeader.new(header: h, body: "Hello Gophers!")
  b = json.marshal_indent(c, "", "\t")
  if e = b.err {
    puts "error: #{e.message}"
  }
  print b.unwrap_or("")
} outputs "{\n\t\"header\": {\n\t\t\"precomputed\": true\n\t},\n\t\"body\": \"Hello Gophers!\"\n}"

#[derive(Json)]
struct Road {
  #[json("Name")] name: Str
  #[json("Number")] number: Int
}

#[derive(Json)]
#[json(transparent)]
struct Roads {
  v: [Road]
}

example "Indent" {
  roads = Roads.new(v: [Road.new(name: "Diamond Fork", number: 29), Road.new(name: "Sheep Creek", number: 51)])
  b = json.marshal(roads).unwrap
  print json.indent(b, "=", "\t").unwrap
} outputs "[\n=\t{\n=\t\t\"Name\": \"Diamond Fork\",\n=\t\t\"Number\": 29\n=\t},\n=\t{\n=\t\t\"Name\": \"Sheep Creek\",\n=\t\t\"Number\": 51\n=\t}\n=]"

#[derive(Json)]
#[json(transparent)]
struct IntMap {
  v: Map[Str, Int]
}

example "MarshalIndent" {
  data = IntMap.new(v: {"a" => 1, "b" => 2})
  puts json.marshal_indent(data, "<prefix>", "<indent>").unwrap
} outputs "{\n<prefix><indent>\"a\": 1,\n<prefix><indent>\"b\": 2\n<prefix>}\n"

example "Valid" {
  good_json = "{\"example\": 1}"
  bad_json = "{\"example\":2:]}}"
  puts "#{json.valid(good_json)} #{json.valid(bad_json)}"
} outputs "true false\n"

example "HTMLEscape" {
  print json.html_escape("{\"Name\":\"<b>HTML content</b>\"}")
} outputs "{\"Name\":\"\\u003cb\\u003eHTML content\\u003c/b\\u003e\"}"

# ---- example_marshaling_test.go: Go's `type Animal int` with
# UnmarshalJSON / MarshalJSON (alx: a one-field struct)

ANIMAL_UNKNOWN = 0
ANIMAL_GOPHER = 1
ANIMAL_ZEBRA = 2

struct Animal {
  v: Int

  def unmarshal_json!(b: [Byte]) -> ~Unit {
    s = json.~unmarshal_into(b, "")
    self.v = case strings.to_lower(s) {
      "gopher" => ANIMAL_GOPHER
      "zebra" => ANIMAL_ZEBRA
      _ => ANIMAL_UNKNOWN
    }
  }

  def marshal_json -> ~[Byte] {
    s = case v {
      1 => "gopher"
      2 => "zebra"
      _ => "unknown"
    }
    json.~marshal(s).bytes
  }
}

#[derive(Json)]
#[json(transparent)]
struct Zoo {
  v: [Animal]
}

example "custom MarshalJSON" {
  blob = "[\"gopher\",\"armadillo\",\"zebra\",\"unknown\",\"gopher\",\"bee\",\"gopher\",\"zebra\"]"
  zoo = json.unmarshal_into(blob, Zoo.json_zero).unwrap.v
  census: Map[Int, Int] = {}
  for a in zoo {
    census[a.v] = (census[a.v] || 0) + 1
  }
  print "Zoo Census:\n* Gophers: #{census[ANIMAL_GOPHER] || 0}\n* Zebras:  #{census[ANIMAL_ZEBRA] || 0}\n* Unknown: #{census[ANIMAL_UNKNOWN] || 0}\n"
} outputs "Zoo Census:\n* Gophers: 3\n* Zebras:  2\n* Unknown: 3\n"

# ---- example_text_marshaling_test.go: Go's `type Size int` with
# UnmarshalText / MarshalText

SIZE_UNRECOGNIZED = 0
SIZE_SMALL = 1
SIZE_LARGE = 2

struct Size {
  v: Int

  def unmarshal_text!(text: [Byte]) -> ~Unit {
    self.v = case strings.to_lower(Str.from_bytes(text)) {
      "small" => SIZE_SMALL
      "large" => SIZE_LARGE
      _ => SIZE_UNRECOGNIZED
    }
  }

  def marshal_text -> ~[Byte] {
    name = case v {
      1 => "small"
      2 => "large"
      _ => "unrecognized"
    }
    name.bytes
  }
}

#[derive(Json)]
#[json(transparent)]
struct Inventory {
  v: [Size]
}

example "text MarshalJSON" {
  blob = "[\"small\",\"regular\",\"large\",\"unrecognized\",\"small\",\"normal\",\"small\",\"large\"]"
  inventory = json.unmarshal_into(blob, Inventory.json_zero).unwrap.v
  counts: Map[Int, Int] = {}
  for s in inventory {
    counts[s.v] = (counts[s.v] || 0) + 1
  }
  print "Inventory Counts:\n* Small:        #{counts[SIZE_SMALL] || 0}\n* Large:        #{counts[SIZE_LARGE] || 0}\n* Unrecognized: #{counts[SIZE_UNRECOGNIZED] || 0}\n"
} outputs "Inventory Counts:\n* Small:        3\n* Large:        2\n* Unrecognized: 3\n"
