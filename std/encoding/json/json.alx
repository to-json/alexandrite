#![overflow(wrap)]
# Package json: Go's encoding/json (v1), with Go 1.27's behaviour (Go 1.27
# builds v1 on v2: its error texts and offsets, invalid UTF-8 written as a
# raw U+FFFD), on compile-time derives instead of reflection (S3).
#
#   import "encoding/json"
#
#   #[derive(Json)]
#   struct User {
#     name: Str
#     #[field(json: "e-mail,omitempty")] email: Str?
#     #[field(json: "id,string")] id: U64
#     #[field(json: "-")] cache: Int
#   }
#
#   s = ~json.marshal(u)                   # also u.to_json, json.marshal_indent
#   u2: User = ~json.unmarshal(s)          # also User.from_json(s)
#   u3 = ~json.unmarshal_into(s, u2)       # Go's Unmarshal into an existing value
#
# ---- Go's API in alx
#
#   Marshal(v)                   marshal(v) -> ~Str (Str: JSON is UTF-8 text)
#   MarshalIndent(v, p, i)       marshal_indent(v, p, i) -> ~Str
#   Unmarshal(data, &v)          unmarshal(data) -> ~T (a fresh T), unmarshal_into(data, v)
#                                -> ~T (merges into v, as Go does), unmarshal_partial(data, v)
#                                -> (T, JsonError?) (Go exactly: the value as far as it got,
#                                and the first error); data is a Str or [Byte]
#   Valid / Compact / Indent /   valid(s) -> Bool, compact(s) -> ~Str, indent(s, p, i) -> ~Str,
#   HTMLEscape                   html_escape(s) -> Str (Str in and out, not a bytes.Buffer);
#                                check(s) -> ~Unit (Valid with the error)
#   NewEncoder(w)                new_encoder(w) (w an io.Writer; `new_encoder()` without
#                                one is the encoder marshal and the derives use)
#   Encoder.Encode/SetIndent/    encode!(v) -> ~Unit, set_indent!(p, i), set_escape_html!(b)
#   SetEscapeHTML
#   NewDecoder(r)                new_decoder(r) (an io.Reader; a Str gives the decoder
#                                hand-written json_dec methods use)
#   Decoder.Decode               decode!(v) -> ~T? (into a copy of v; none at the end:
#                                Go's io.EOF), decode_partial!(v) -> (T?, Error?) (Go exactly)
#   Decoder.Token / More /       token! -> ~Token? (none at the end), has_more! (`more!` is
#   Buffered / InputOffset /     the protocol's array step), buffered -> bytes.Reader,
#   UseNumber /                  input_offset, use_number!, disallow_unknown_fields!;
#   DisallowUnknownFields        read_value! -> ~Str? (the next value's text)
#   Token, Delim                 enum Token { Delim(Rune), Bool, Float, Num(Number),
#                                String, Null } (to_s is Go's %v); delim_text(r)
#   Number (String/Float64/      Number (to_s, float64 -> ~Float, int64 -> ~Int); valid_number?(s)
#   Int64)
#   RawMessage                   RawMessage (data: [Byte]; RawMessage.from(s), to_s)
#   Marshaler / Unmarshaler      interfaces Marshaler (marshal_json -> ~[Byte]) and
#                                Unmarshaler (unmarshal_json!(data) -> ~Unit), honoured
#                                before the derive's own code; encoding.TextMarshaler /
#                                TextUnmarshaler (marshal_text / unmarshal_text!) too
#   SyntaxError,                 JsonError.Syntax(msg, offset), .Type(value, type_name,
#   UnmarshalTypeError,          offset, struct_name, field, cause), .UnsupportedType,
#   UnsupportedTypeError,        .UnsupportedValue, .Marshaler(type_name, cause,
#   UnsupportedValueError,       source_func), .UnknownField(name) (Go's `json: unknown
#   MarshalerError               field "x"`), .Custom(msg) (an Unmarshaler's own error,
#                                by its text), .Invalid(msg, offset) (alx's: enums)
#
# ---- What `#[derive(Json)]` writes (compiler/src/derive.rs, GO-VS-RUBY D37-D39)
#
#   def json_str(e: Encoder) -> Str, json_enc(e)   the encoding
#   def json_merge(d: Decoder) -> T               decode into a copy of self (structs)
#   def self.json_dec(d: Decoder) -> T, json_zero  decode a fresh value; the zero value
#   def json_is_zero -> Bool                      omitzero; json_mergeable / json_derived
#   def to_json, to_json_indent(p, i), self.from_json(s)   the conveniences
#
# A hand-written type provides json_str (or json_enc) and json_dec / json_zero,
# or Go's Marshaler / Unmarshaler / TextMarshaler methods. Encoding and
# decoding dispatch per type with S6 capability checks (`enc_val`,
# `dec_val`): Str, Bool, the integers and Float as Go writes them; then
# Marshaler, TextMarshaler, the protocol.
#
# ---- Go's struct tags: `#[field(json: "...")]` (or `#[json("name")]`,
# `#[json(omit_empty)]`, `#[json(skip)]`)
#
#   name          the key (Go's rule: letters, digits and !#$%&()*+-./:;<=>?@[]^_{|}~
#                 and space; another name is ignored); "-" leaves the field out, "-,"
#                 names it "-"; the default is the alx field name
#   omitempty     false, 0, "", an empty slice or map, none (and an empty RawMessage /
#                 Number, a null Value)
#   omitzero      the zero value, or the type's IsZero (`zero?`, or `is_zero` as
#                 std/time spells it); a struct is zero when all its fields are
#   string        a number or bool inside a JSON string, a Str JSON-quoted inside one
#                 (Go 1.27: read with Go's syntax, so "-0012" and "0x1p-2" are accepted;
#                 "null" leaves the field)
#   embed         Go's anonymous struct field: the fields of a struct derived in the
#                 same file (or an option of one) are promoted, with Go's dominance rules
#                 (a shallower field wins; at one depth a tagged one; equals vanish);
#                 ignored on other types, as Go ignores options it doesn't know
#
# ---- Decoding (Go 1.27's Unmarshal)
#
#   - The document's syntax is checked first; a type error doesn't stop decoding (the
#     field keeps its value, the others are decoded) and the first one is reported.
#   - Keys match exactly first, then case-insensitively (Unicode folding); the last of
#     a repeated key wins. Unknown keys are skipped (or an UnknownField error).
#   - null leaves a value (Go: no effect), and is none for `T?`, [] for a slice, {} for
#     a map, a null Value.
#   - Maps merge into the existing map; slices are replaced; [T; N] takes the first N
#     elements and zeroes the rest; integer map keys parse the key text.
#   - [Byte] is base64 (standard, padded; \r and \n skipped), or an array of numbers.
#   - Strings: \uXXXX with surrogate pairs; a lone surrogate and invalid UTF-8 become
#     U+FFFD. Numbers into an integer type must be integers in range; a Float out of
#     range is stored as ±Inf and reported.
#   - Errors: Go's texts and offsets (SyntaxError: after the bytes that show the
#     problem; UnmarshalTypeError: after the value, or after `[` / `{`), Struct the root
#     type's name, Field the path with names as written in the input.
#   - Depth: 10000 nested arrays/objects ("exceeded max depth"), any input size.
#
# ---- Encoding
#
#   Int, I8..U64 as numbers; Float in Go's shortest form ('f', or 'e' below 1e-6 /
#   from 1e21; NaN and ±Inf: UnsupportedValue); Str escaped as Go does (<, >, & as
#   <...; U+2028/9; invalid UTF-8 as a raw U+FFFD); T? the value or null; [T] and
#   [T; N] arrays; [Byte] base64; Map objects with the keys sorted (Go's order);
#   tuples arrays; enums (an alx extension: Go has no sum types) "Variant",
#   {"Variant": payload}, a variant's `#[json("name")]` renames it.
#   A Marshaler's output is checked and compacted (HTML-escaped too, by default).
#
# ---- Differences from Go, and why
#
#   - No reflection: marshal and unmarshal take a derived type (or one with the
#     protocol or Go's methods), or a Str, Bool, integer or Float. A top-level slice
#     or map is a one-field `#[json(transparent)]` struct. No `any`: json.Value
#     (`parse(s)`, below) holds any JSON; it keeps an object's member order and a
#     number's text (D40), where Go's map[string]any is written sorted and a float64
#     loses digits.
#   - No nil: an empty slice or map is the zero value, so it is written [] / {} (Go:
#     null for a nil one), and omitzero omits it (Go keeps a non-nil empty one).
#     RawMessage can't tell empty from nil (both null).
#   - Map keys are Str or integers (alx Maps have no struct keys): no TextMarshaler keys.
#   - No float32, uintptr, complex, channels or functions; no named int / []byte types
#     (a transparent struct isn't a byte, so a slice of one isn't base64).
#   - Names in errors are alx's (S10): `of type Int`, `[Byte]`, `Map[Str, Int]`, a
#     derived type by its name (`#[data("")]` hides it, as Go does for an anonymous
#     struct); `marshal_json` / `marshal_text` in MarshalerError. Go's sentence
#     structure ("Go struct field") is kept.
#   - An Unmarshaler's error that isn't a JsonError comes back as JsonError.Custom
#     with its text (an error enum can't hold an open Error).
#   - Decoding into an interface value or through a pointer to a pointer: alx has
#     neither (T? is one level).
#   - The Decoder reads 4096 bytes at a time; Go's InputOffset / Buffered rules are kept.
#
# ---- The dynamic API
#
# `parse(s)` gives a Value (an immutable tree stored in flat arrays, D40).
# `v.kind`, `v.get("key")`, `v.at(i)`, `v.as_str`, `v.as_float`, `v.as_int`,
# `v.as_bool`, `v.size`, `v.keys`, `v.to_s`. A Value can be a field of a derived
# type (like Go's interface{}).
#
# ---- Protocol details for hand-written decoders
#
# The Decoder over a Str keeps the first syntax error (`failed`: decoding stops)
# and the first type error (decoding goes on); `done!` reports them. Nothing on
# the decoding path is fallible, which keeps it fast (D39).
#
# Go tests not translated, by file (the test files' headers say why):
# decode_test.go (interface targets, struct map keys, nil targets),
# encode_test.go (cycles, interface fields, named byte types, float32),
# stream_test.go (MaxBytesReader), fold_test.go and tags_test.go (Go's internal
# foldName / parseTag: the derive parses tags, the vectors cover folding),
# v2_diff_test.go (compares v1 with v2 option by option; v2 is its own alx
# package), bench_test.go (benchmarks over Go's testdata corpus) and
# fuzz_test.go (fuzzing).

import "strconv"
import "unicode/utf8"

# What can go wrong: Go's error types, one variant each. `offset` is a byte
# offset into the input.
pub error JsonError {
  # Go's *SyntaxError: the offset is after the bytes that show the problem.
  Syntax(msg: Str, offset: Int)
  # Go's *UnmarshalTypeError: the JSON value ("string", "number 1.5"), the alx
  # type it could not go into, the offset after the value (after `[` / `{` for
  # an array / object), the root type's name and the path from the root
  # ("a.b.2", names as written in the input), and the cause's text ("" for none).
  Type(value: Str, type_name: Str, offset: Int, struct_name: Str, field: Str, cause: Str)
  # Go's *UnsupportedTypeError
  UnsupportedType(type_name: Str)
  # Go's *UnsupportedValueError ("NaN", "+Inf", "-Inf")
  UnsupportedValue(str: Str)
  # Go's *MarshalerError: a marshal_json / marshal_text method failed (or
  # marshal_json wrote invalid JSON).
  Marshaler(type_name: Str, cause: Str, source_func: Str)
  # Go's `json: unknown field "x"` (Decoder.disallow_unknown_fields!)
  UnknownField(name: Str)
  # alx's own: an unknown enum variant and the like
  Invalid(msg: Str, offset: Int)
  # the error an Unmarshaler returned (Go returns it as it is)
  Custom(msg: Str)

  def message -> Str {
    case self {
      Syntax(m, _) => m
      Type(v, t, _, st, f, c) => type_error_text(v, t, st, f, c)
      UnsupportedType(t) => "json: unsupported type: " + t
      UnsupportedValue(v) => "json: unsupported value: " + v
      Marshaler(t, c, src) => "json: error calling " + (src == "" ? "marshal_json" : src) + " for type " + t + ": " + c
      UnknownField(n) => "json: unknown field " + strconv.quote(n)
      Invalid(m, _) => "json: " + m
      Custom(m) => m
    }
  }

  # The byte offset in the input where the problem was found (0 for encoding errors).
  pub def offset -> Int {
    case self {
      Syntax(_, o) => o
      Type(_, _, o, _, _, _) => o
      Invalid(_, o) => o
      _ => 0
    }
  }
}

# Go's UnmarshalTypeError.Error (Go 1.27): "Go struct field" unless the path
# ends in an array index.
def type_error_text(v: Str, t: Str, st: Str, f: Str, c: Str) -> Str {
  s = ""
  if st != "" || f != "" {
    into = "Go struct field "
    i = f.size
    while i > 0 && f[i - 1] != 46 { i -= 1 }
    digits = i < f.size
    j = i
    while j < f.size {
      digits = false if !is_digit(f[j])
      j += 1
    }
    into = "" if digits
    s = "json: cannot unmarshal " + v + " into " + into + st + "." + f + " of type " + t
  } else {
    s = "json: cannot unmarshal " + v + " into Go value of type " + t
  }
  s = s + ": " + c if c != ""
  s
}

HEX = "0123456789abcdef"

# ------------------------------------------------------------------ helpers

# Go's jsonwire.QuoteRune: the rune at s[p] quoted ('\xff' for a byte that
# isn't UTF-8), and its width.
def quote_rune_at(s: Str, p: Int) -> (Str, Int) {
  r, w = utf8.decode_rune_at(s, p)
  return ("'\\x" + strconv.format_uint(s[p].to_u64, 16) + "'", 1) if r == 0xFFFD && w == 1
  (strconv.quote_rune(r), w)
}

# The invalid character at s[p] (Go 1.27's error, with v1's offset: after it).
def err_char(s: Str, p: Int, ctx: Str) -> JsonError {
  q, w = quote_rune_at(s, p)
  JsonError.Syntax(msg: "invalid character " + q + " " + ctx, offset: p + w)
}

# unicode.IsSpace, without the tables.
def space_rune?(r: Rune) -> Bool {
  return true if (r >= 9 && r <= 13) || r == 32 || r == 0x85 || r == 0xA0 || r == 0x1680
  return true if (r >= 0x2000 && r <= 0x200A) || r == 0x2028 || r == 0x2029 || r == 0x202F || r == 0x205F || r == 0x3000
  false
}

# Go's jsonwire InvalidTextError text for the raw text w.
def what_text(w: Str) -> Str {
  return quote_rune_at(w, 0)[0] if utf8.rune_count_in_string(w) == 1
  esc = false
  i = 0
  while i < w.size {
    r, n = utf8.decode_rune_at(w, i)
    esc = true if r == 96 || r == 0xFFFD || space_rune?(r) || !strconv.is_print(r)
    i += n
  }
  return strconv.quote(w) if esc
  "`" + w + "`"
}

# An invalid escape sequence: the text s[bs...e] (e is also the offset).
def err_escape(s: Str, bs: Int, e: Int) -> JsonError {
  JsonError.Syntax(msg: "invalid escape sequence " + what_text(s[bs...e]) + " in string", offset: e)
}

def err_eof(off: Int) -> JsonError {
  JsonError.Syntax(msg: "unexpected end of JSON input", offset: off)
}

# Appends the UTF-8 encoding of rune r (r must be valid).
def push_rune(buf: [Byte], r: Int) -> [Byte] {
  b = buf
  if r < 0x80 {
    b << r.as_u8
  } else if r < 0x800 {
    b << (0xC0 | (r >> 6)).as_u8
    b << (0x80 | (r & 0x3F)).as_u8
  } else if r < 0x10000 {
    b << (0xE0 | (r >> 12)).as_u8
    b << (0x80 | ((r >> 6) & 0x3F)).as_u8
    b << (0x80 | (r & 0x3F)).as_u8
  } else {
    b << (0xF0 | (r >> 18)).as_u8
    b << (0x80 | ((r >> 12) & 0x3F)).as_u8
    b << (0x80 | ((r >> 6) & 0x3F)).as_u8
    b << (0x80 | (r & 0x3F)).as_u8
  }
  b
}

# Appends s as a JSON string literal, with Go's escaping.
def put_quoted(buf: [Byte], s: Str, html: Bool) -> [Byte] {
  b = buf
  b << 34
  n = s.size
  i = 0
  while i < n {
    c = s[i]
    if c < 0x80 {
      if c >= 0x20 && c != 34 && c != 92 && !(html && (c == 60 || c == 62 || c == 38)) {
        b << c
      } else if c == 34 {
        b << 92
        b << 34
      } else if c == 92 {
        b << 92
        b << 92
      } else if c == 10 {
        b << 92
        b << 110
      } else if c == 13 {
        b << 92
        b << 114
      } else if c == 9 {
        b << 92
        b << 116
      } else if c == 8 {
        b << 92
        b << 98
      } else if c == 12 {
        b << 92
        b << 102
      } else {
        # \u00XX
        b << 92
        b << 117
        b << 48
        b << 48
        b << HEX[(c >> 4).to_i]
        b << HEX[(c & 15).to_i]
      }
      i += 1
    } else {
      r, w = utf8.decode_rune_at(s, i)
      if r == 0xFFFD && w == 1 {
        # invalid UTF-8: a raw U+FFFD (Go 1.27's v2-backed encoder; v1
        # wrote the escape �)
        b << 0xEF
        b << 0xBF
        b << 0xBD
      } else if r == 0x2028 || r == 0x2029 {
        b << 92
        b << 117
        b << 50
        b << 48
        b << 50
        b << HEX[r.to_i - 0x2028 + 8]
      } else {
        j = 0
        while j < w {
          b << s[i + j]
          j += 1
        }
      }
      i += w
    }
  }
  b << 34
  b
}

# s as a JSON string literal, as Go's json.Marshal writes it (<, >, & escaped).
pub def quote(s: Str) -> Str {
  b: [Byte] = []
  b = put_quoted(b, s, true)
  Str.from_bytes(b)
}

# The same, without the HTML escapes (Go's SetEscapeHTML(false)).
pub def quote_raw(s: Str) -> Str {
  b: [Byte] = []
  b = put_quoted(b, s, false)
  Str.from_bytes(b)
}

# s with <, >, & and U+2028/9 in JSON strings escaped (Go's HTMLEscape).
pub def html_escape(s: Str) -> Str {
  b: [Byte] = []
  i = 0
  n = s.size
  while i < n {
    c = s[i]
    if c == 60 || c == 62 || c == 38 {
      b << 92
      b << 117
      b << 48
      b << 48
      b << HEX[(c >> 4).to_i]
      b << HEX[(c & 15).to_i]
      i += 1
    } else if c == 0xE2 && i + 2 < n && s[i + 1] == 0x80 && (s[i + 2] == 0xA8 || s[i + 2] == 0xA9) {
      b << 92
      b << 117
      b << 50
      b << 48
      b << 50
      b << HEX[s[i + 2].to_i - 0xA8 + 8]
      i += 3
    } else {
      b << c
      i += 1
    }
  }
  Str.from_bytes(b)
}
