#![overflow(wrap)]
# Package json: Go's encoding/json, built on compile-time derives (S3).
#
# There is no runtime type information, so a type opts in:
#
#   import "encoding/json"
#
#   #[derive(Json)]
#   struct User {
#     name: Str
#     #[json("e-mail")] email: Str?
#     #[json(omit_empty)] tags: [Str]
#     #[json(skip)] cache: Int
#   }
#
#   s = ~u.to_json                    # {"name":"ann","e-mail":null}
#   u2 = ~User.from_json(s)           # also: u.to_json_indent("", "  ")
#
# What `#[derive(Json)]` writes into the type (the parser expands it to plain
# defs; see compiler/src/derive.rs, GO-VS-RUBY D37-D39):
#
#   def to_json -> ~Str                        compact JSON (Go's Marshal)
#   def to_json_indent(prefix, indent) -> ~Str (Go's MarshalIndent)
#   def self.from_json(s: Str) -> ~T           one whole document (Go's Unmarshal)
#
# and the protocol those are built on, which a hand-written type can provide
# instead of deriving (fields of a derived type are encoded and decoded by it):
#
#   def json_str(e: json.Encoder) -> Str       the JSON text of the value
#   def json_enc(e: json.Encoder)              writes it: e.raw!(json_str(e))
#   def self.json_dec(d: json.Decoder) -> T    reads one value; after an error
#                                              (kept in d) returns json_zero
#   def self.json_zero -> T                    the value to return after an error
#
# `json.marshal(v)` takes anything with a `json_enc` (a derived type, a Value).
#
# ---- Encoding table (Go's, where Go has the concept)
#
#   Int, I8..U64   a number, without a fraction          Bool    true / false
#   Float          Go's shortest form ('f', or 'e' below 1e-6 / from 1e21);
#                  NaN and the infinities fail the encoding (json: unsupported value)
#   Str            a string, escaped as Go does by default: <, >, & as < >
#                  & (see Encoder.set_escape_html!), U+2028/9 as  /9, invalid
#                  UTF-8 as �
#   T?             the value, or null
#   [T]            an array (an empty slice is [] -- there is no nil slice)
#   Map[Str, V]    an object, in insertion order (Go sorts the keys)
#   (A, B)         an array of the elements
#   struct         an object with the fields in order; options on a field:
#                    #[json("name")]       the key
#                    #[json(omit_empty)]   leave out false, 0, "", [], {} and none
#                    #[json(skip)]         leave out of encoding and decoding
#   enum           (an extension: Go has no sum types; serde's "externally tagged")
#                    unit variant         "Red"
#                    Circle(Float)        {"Circle":1.5}
#                    Pair(Int, Str)       {"Pair":[1,"a"]}
#                    Rect(w: Float, h: Float)   {"Rect":{"w":1,"h":2}}
#                  A variant takes `#[json("name")]` to rename it, its named fields
#                  take the field options.
#
# ---- Decoding (Go's Unmarshal rules)
#
#   - The document is checked for syntax first (so a syntax error anywhere beats a
#     type error earlier in the text, as in Go).
#   - Unknown object keys are skipped. Keys match exactly (Go also matches case
#     insensitively). A key given twice: the last wins. Fields absent from the
#     input keep their zero value (an enum field: its first variant).
#   - null leaves a field at its zero value (Go: unchanged), and is none for a `T?`.
#   - Numbers into an Int type must be integers in range: 1.5, 1e2 and 300 into a
#     U8 are type errors. Into a Float: any number that fits.
#   - Strings are unescaped, \uXXXX with surrogate pairs; a lone surrogate and
#     invalid UTF-8 become U+FFFD.
#
# ---- Errors (JsonError; messages are Go's where Go has the same error)
#
#   Syntax      unexpected end of JSON input
#               invalid character 'x' looking for beginning of value
#               (also: after object key, after array element, in string escape
#               code, in literal true (expecting 'r'), in numeric literal, ...)
#   Type        json: cannot unmarshal string into field User.age of type Int
#               (`into value of type` when there is no field, `number 1.5`
#               for a number that is not an integer)
#   Unsupported json: unsupported value: NaN
#   Invalid     json: unknown variant "Pentagon" for Shape
#   A JsonError has `offset` (the byte where it was found) once matched out of
#   an Error: `case e { JsonError.Syntax(msg, off) => ... }`.
#   The Decoder keeps only the first error and returns zero values after it
#   (`d.failed`); `d.~done!` reports it. Nothing on the decoding path is
#   fallible, which keeps it fast (GO-VS-RUBY D39).
#
# ---- The dynamic API
#
# `parse(s)` gives a Value (an immutable tree stored in flat arrays: an enum
# can't contain itself, "`Value` contains itself; it is a value", D40).
# `v.kind`, `v.get("key")`, `v.at(i)`, `v.as_str`, `v.as_float`, `v.as_int`,
# `v.as_bool`, `v.size`, `v.keys`, `v.to_s`. A Value can be a field of a derived
# type (like Go's json.RawMessage / interface{}).
#
# ---- Also
#
#   valid(s) -> Bool          check(s) -> ~Unit   (the error says where)
#   indent(s, prefix, indent) -> ~Str     compact(s) -> ~Str     quote(s) -> Str
#   html_escape(s) -> Str     marshal(v) -> ~Str  marshal_indent(v, prefix, indent)
#   Encoder / Decoder for streaming and for hand-written json_enc / json_dec.

import "strconv"
import "unicode/utf8"

# What can go wrong: Go's error types, one variant each. `offset` is a byte
# offset into the input.
pub error JsonError {
  # Go's *SyntaxError: the offset is after the bytes that show the problem.
  Syntax(msg: Str, offset: Int)
  # Go's *UnmarshalTypeError: the JSON value ("string", "number 1.5"), the alx
  # type it could not go into, the offset after the value (after `[` / `{` for
  # an array / object), the root type's name and the path from the root
  # ("a.b.2", names as written in the input), and the cause's text ("" for none).
  Type(value: Str, type_name: Str, offset: Int, struct_name: Str, field: Str, cause: Str)
  # Go's *UnsupportedTypeError
  UnsupportedType(type_name: Str)
  # Go's *UnsupportedValueError ("NaN", "+Inf", "-Inf")
  UnsupportedValue(str: Str)
  # Go's *MarshalerError: a marshal_json / marshal_text method failed (or
  # marshal_json wrote invalid JSON).
  Marshaler(type_name: Str, cause: Str, source_func: Str)
  # Go's `json: unknown field "x"` (Decoder.disallow_unknown_fields!)
  UnknownField(name: Str)
  # alx's own: an unknown enum variant and the like
  Invalid(msg: Str, offset: Int)
  # the error an Unmarshaler returned (Go returns it as it is)
  Custom(msg: Str)

  def message -> Str {
    case self {
      Syntax(m, _) => m
      Type(v, t, _, st, f, c) => type_error_text(v, t, st, f, c)
      UnsupportedType(t) => "json: unsupported type: " + t
      UnsupportedValue(v) => "json: unsupported value: " + v
      Marshaler(t, c, src) => "json: error calling " + src + " for type " + t + ": " + c
      UnknownField(n) => "json: unknown field " + strconv.quote(n)
      Invalid(m, _) => "json: " + m
      Custom(m) => m
    }
  }

  # The byte offset in the input where the problem was found (0 for encoding errors).
  pub def offset -> Int {
    case self {
      Syntax(_, o) => o
      Type(_, _, o, _, _, _) => o
      Invalid(_, o) => o
      _ => 0
    }
  }
}

# Go's UnmarshalTypeError.Error (Go 1.27): "Go struct field" unless the path
# ends in an array index.
def type_error_text(v: Str, t: Str, st: Str, f: Str, c: Str) -> Str {
  s = ""
  if st != "" || f != "" {
    into = "Go struct field "
    i = f.size
    while i > 0 && f[i - 1] != 46 { i -= 1 }
    digits = i < f.size
    j = i
    while j < f.size {
      digits = false if !is_digit(f[j])
      j += 1
    }
    into = "" if digits
    s = "json: cannot unmarshal " + v + " into " + into + st + "." + f + " of type " + t
  } else {
    s = "json: cannot unmarshal " + v + " into Go value of type " + t
  }
  s = s + ": " + c if c != ""
  s
}

HEX = "0123456789abcdef"

# ------------------------------------------------------------------ helpers

# Go's jsonwire.QuoteRune: the rune at s[p] quoted ('\xff' for a byte that
# isn't UTF-8), and its width.
def quote_rune_at(s: Str, p: Int) -> (Str, Int) {
  r, w = utf8.decode_rune_at(s, p)
  return ("'\\x" + strconv.format_uint(s[p].to_u64, 16) + "'", 1) if r == 0xFFFD && w == 1
  (strconv.quote_rune(r), w)
}

# The invalid character at s[p] (Go 1.27's error, with v1's offset: after it).
def err_char(s: Str, p: Int, ctx: Str) -> JsonError {
  q, w = quote_rune_at(s, p)
  JsonError.Syntax(msg: "invalid character " + q + " " + ctx, offset: p + w)
}

# unicode.IsSpace, without the tables.
def space_rune?(r: Rune) -> Bool {
  return true if (r >= 9 && r <= 13) || r == 32 || r == 0x85 || r == 0xA0 || r == 0x1680
  return true if (r >= 0x2000 && r <= 0x200A) || r == 0x2028 || r == 0x2029 || r == 0x202F || r == 0x205F || r == 0x3000
  false
}

# Go's jsonwire InvalidTextError text for the raw text w.
def what_text(w: Str) -> Str {
  return quote_rune_at(w, 0)[0] if utf8.rune_count_in_string(w) == 1
  esc = false
  i = 0
  while i < w.size {
    r, n = utf8.decode_rune_at(w, i)
    esc = true if r == 96 || r == 0xFFFD || space_rune?(r) || !strconv.is_print(r)
    i += n
  }
  return strconv.quote(w) if esc
  "`" + w + "`"
}

# An invalid escape sequence: the text s[bs...e] (e is also the offset).
def err_escape(s: Str, bs: Int, e: Int) -> JsonError {
  JsonError.Syntax(msg: "invalid escape sequence " + what_text(s[bs...e]) + " in string", offset: e)
}

def err_eof(off: Int) -> JsonError {
  JsonError.Syntax(msg: "unexpected end of JSON input", offset: off)
}

# Appends the UTF-8 encoding of rune r (r must be valid).
def push_rune(buf: [Byte], r: Int) -> [Byte] {
  b = buf
  if r < 0x80 {
    b << r.as_u8
  } else if r < 0x800 {
    b << (0xC0 | (r >> 6)).as_u8
    b << (0x80 | (r & 0x3F)).as_u8
  } else if r < 0x10000 {
    b << (0xE0 | (r >> 12)).as_u8
    b << (0x80 | ((r >> 6) & 0x3F)).as_u8
    b << (0x80 | (r & 0x3F)).as_u8
  } else {
    b << (0xF0 | (r >> 18)).as_u8
    b << (0x80 | ((r >> 12) & 0x3F)).as_u8
    b << (0x80 | ((r >> 6) & 0x3F)).as_u8
    b << (0x80 | (r & 0x3F)).as_u8
  }
  b
}

# Appends s as a JSON string literal, with Go's escaping.
def put_quoted(buf: [Byte], s: Str, html: Bool) -> [Byte] {
  b = buf
  b << 34
  n = s.size
  i = 0
  while i < n {
    c = s[i]
    if c < 0x80 {
      if c >= 0x20 && c != 34 && c != 92 && !(html && (c == 60 || c == 62 || c == 38)) {
        b << c
      } else if c == 34 {
        b << 92
        b << 34
      } else if c == 92 {
        b << 92
        b << 92
      } else if c == 10 {
        b << 92
        b << 110
      } else if c == 13 {
        b << 92
        b << 114
      } else if c == 9 {
        b << 92
        b << 116
      } else if c == 8 {
        b << 92
        b << 98
      } else if c == 12 {
        b << 92
        b << 102
      } else {
        # \u00XX
        b << 92
        b << 117
        b << 48
        b << 48
        b << HEX[(c >> 4).to_i]
        b << HEX[(c & 15).to_i]
      }
      i += 1
    } else {
      r, w = utf8.decode_rune_at(s, i)
      if r == 0xFFFD && w == 1 {
        # invalid UTF-8: a raw U+FFFD (Go 1.27's v2-backed encoder; v1
        # wrote the escape �)
        b << 0xEF
        b << 0xBF
        b << 0xBD
      } else if r == 0x2028 || r == 0x2029 {
        b << 92
        b << 117
        b << 50
        b << 48
        b << 50
        b << HEX[r.to_i - 0x2028 + 8]
      } else {
        j = 0
        while j < w {
          b << s[i + j]
          j += 1
        }
      }
      i += w
    }
  }
  b << 34
  b
}

# s as a JSON string literal, as Go's json.Marshal writes it (<, >, & escaped).
pub def quote(s: Str) -> Str {
  b: [Byte] = []
  b = put_quoted(b, s, true)
  Str.from_bytes(b)
}

# The same, without the HTML escapes (Go's SetEscapeHTML(false)).
pub def quote_raw(s: Str) -> Str {
  b: [Byte] = []
  b = put_quoted(b, s, false)
  Str.from_bytes(b)
}

# s with <, >, & and U+2028/9 in JSON strings escaped (Go's HTMLEscape).
pub def html_escape(s: Str) -> Str {
  b: [Byte] = []
  i = 0
  n = s.size
  while i < n {
    c = s[i]
    if c == 60 || c == 62 || c == 38 {
      b << 92
      b << 117
      b << 48
      b << 48
      b << HEX[(c >> 4).to_i]
      b << HEX[(c & 15).to_i]
      i += 1
    } else if c == 0xE2 && i + 2 < n && s[i + 1] == 0x80 && (s[i + 2] == 0xA8 || s[i + 2] == 0xA9) {
      b << 92
      b << 117
      b << 50
      b << 48
      b << 50
      b << HEX[s[i + 2].to_i - 0xA8 + 8]
      i += 3
    } else {
      b << c
      i += 1
    }
  }
  Str.from_bytes(b)
}
