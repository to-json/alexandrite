# Go's example_test.go: Example_stringReplace. (ExampleEscapeForHTML and
# ExampleMultiline marshal Go structs; they are in encoding/json/v2's tests.)

import "bytes"
import "strings"

example "string replace" {
  input = "{\n\t\t\"title\": \"Golang version 1 is released\",\n\t\t\"author\": \"Andrew Gerrand\",\n\t\t\"date\": \"2012-03-28\",\n\t\t\"text\": \"Today marks a major milestone in the development of the Golang programming language.\",\n\t\t\"otherArticles\": [\n\t\t\t\"Twelve Years of Golang\",\n\t\t\t\"The Laws of Reflection\",\n\t\t\t\"Learn Golang from your browser\"\n\t\t]\n\t}"
  replacements: [Pointer] = []
  dec = new_decoder(bytes.new_buffer_string(input), [])
  out = bytes.new_buffer([])
  enc = new_encoder(out, [multiline(true)])
  while tok = dec.~read_token! {
    t = tok
    if t.kind == Kind.String && t.to_s.include?("Golang") {
      replacements << dec.stack_pointer
      t = string(strings.replace_all(t.to_s, "Golang", "Go"))
    }
    enc.~write_token!(t)
  }
  if replacements.size > 0 {
    puts "Replaced \"Golang\" with \"Go\" in:"
    for w in replacements { puts "\t" + w.s }
    puts ""
  }
  puts "Result: " + out.string
} outputs "Replaced \"Golang\" with \"Go\" in:\n\t/title\n\t/text\n\t/otherArticles/0\n\t/otherArticles/2\n\nResult: {\n\t\"title\": \"Go version 1 is released\",\n\t\"author\": \"Andrew Gerrand\",\n\t\"date\": \"2012-03-28\",\n\t\"text\": \"Today marks a major milestone in the development of the Go programming language.\",\n\t\"otherArticles\": [\n\t\t\"Twelve Years of Go\",\n\t\t\"The Laws of Reflection\",\n\t\t\"Learn Go from your browser\"\n\t]\n}\n\n"
