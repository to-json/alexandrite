import "bytes"

test "smoke" {
  v = Value.of(" { \"b\" : [1, 2.5, \"x\"], \"a\": null } ")
  v.~compact!([])
  assert_eq v.to_s, "{\"b\":[1,2.5,\"x\"],\"a\":null}"
  v.~canonicalize!([])
  assert_eq v.to_s, "{\"a\":null,\"b\":[1,2.5,\"x\"]}"
  v.~indent!([with_indent("  ")])
  assert_eq v.to_s, "{\n  \"a\": null,\n  \"b\": [\n    1,\n    2.5,\n    \"x\"\n  ]\n}"
  d = new_str_decoder("[1, {\"k\": true}]", [])
  toks: [Str] = []
  while t = d.~read_token! {
    toks << t.to_s
  }
  assert_eq toks, ["[", "1", "{", "k", "true", "}", "]"]
  buf = bytes.new_buffer([])
  e = new_encoder(buf, [])
  e.~write_token!(Token.begin_object)
  e.~write_token!(string("a"))
  e.~write_token!(int(-5))
  e.~write_token!(Token.end_object)
  assert_eq buf.string, "{\"a\":-5}\n"
}
