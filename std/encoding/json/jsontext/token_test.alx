# Go's token_test.go: TestTokenAccessors (its table is vec_token_test.alx;
# Float32 tokens and the Float32 accessor are left out: alx has no float32)
# and TestTokenClone. TestTokenStringAllocations measures Go's allocator.

def num_err_kind(e: JsonTextError?) -> Str {
  if x = e {
    case x {
      Num(_a, _v, r) => { return r ? "range" : "syntax" }
      _ => { return "other" }
    }
  }
  ""
}

def check_token(t: Token, s: Str, k: Kind, b: Bool) {
  check_eq(t.to_s, s, "to_s")
  assert t.kind == k, "#{s}: kind #{t.kind}, want #{k}"
  if k == Kind.True || k == Kind.False {
    check_eq(t.bool, b, "#{s}: bool")
  } else {
    assert_panics("invalid JSON token kind") { t.bool }
  }
}

def check_token_float(t: Token, bits: U64, err: Str) {
  r = t.float
  if r.ok? {
    check_eq(math.float64bits(r.unwrap), bits, "#{t.to_s}: float")
    check_eq(err, "", "#{t.to_s}: float error")
  } else {
    v, _ok = t.float_clamped
    check_eq(math.float64bits(v), bits, "#{t.to_s}: float clamped")
    check_eq(err, "range", "#{t.to_s}: float error")
  }
}

def check_token_int(t: Token, want: Int, err: Str) {
  v, e = t.int_clamped
  check_eq(v, want, "#{t.to_s}: int")
  check_eq(num_err_kind(e), err, "#{t.to_s}: int error")
}

def check_token_uint(t: Token, want: U64, err: Str) {
  v, e = t.uint_clamped
  check_eq(v, want, "#{t.to_s}: uint")
  check_eq(num_err_kind(e), err, "#{t.to_s}: uint error")
}

test "token clone" {
  for t in [Token.new, Token.null, Token.false_, Token.true_, Token.begin_object, Token.end_object,
    Token.begin_array, Token.end_array, string("hello, world!"), Token.raw_token("\"hello, world!\""),
    float(3.14159), Token.raw_token("3.14159")] {
    c = t.clone
    assert c == t, "clone of #{t.to_s}"
    check_eq(c.to_s, t.to_s, "clone to_s")
  }
}

test "token errors" {
  check_eq(Token.raw_token("1e1000").float.err?.message || "", "jsontext.Token(1e1000).Float error: value out of range", "float range")
  check_eq(Token.raw_token("1.5").int.err?.message || "", "jsontext.Token(1.5).Int error: invalid syntax", "int syntax")
  check_eq(int(-1).uint.err?.message || "", "jsontext.Token(-1).Uint error: invalid syntax", "uint syntax")
}
