# Generated from Go's encoding/json/internal/jsonwire (decode_test.go, encode_test.go, wire_test.go); do not edit by hand.
import "math"

test "consume whitespace" {
  check_eq(consume_whitespace("".bytes, 0), 0, "")
  check_eq(consume_whitespace("a".bytes, 0), 0, "a")
  check_eq(consume_whitespace(" a".bytes, 0), 1, " a")
  check_eq(consume_whitespace(" a ".bytes, 0), 1, " a ")
  check_eq(consume_whitespace(" \n\r\ta".bytes, 0), 4, " \n\r\ta")
  check_eq(consume_whitespace(" \n\r\t \n\r\t \n\r\t \n\r\t".bytes, 0), 16, " \n\r\t \n\r\t \n\r\t \n\r\t")
  check_eq(consume_whitespace("\u00A0".bytes, 0), 0, "\u00A0")
}

test "consume literal" {
  check_literal("null", "", 0, "unexpected EOF")
  check_literal("null", "n", 1, "unexpected EOF")
  check_literal("null", "nu", 2, "unexpected EOF")
  check_literal("null", "nul", 3, "unexpected EOF")
  check_literal("null", "null", 4, "")
  check_literal("null", "nullx", 4, "")
  check_literal("null", "x", 0, "invalid character 'x' in literal null (expecting 'n')")
  check_literal("null", "nuxx", 2, "invalid character 'x' in literal null (expecting 'l')")
  check_literal("false", "", 0, "unexpected EOF")
  check_literal("false", "f", 1, "unexpected EOF")
  check_literal("false", "fa", 2, "unexpected EOF")
  check_literal("false", "fal", 3, "unexpected EOF")
  check_literal("false", "fals", 4, "unexpected EOF")
  check_literal("false", "false", 5, "")
  check_literal("false", "falsex", 5, "")
  check_literal("false", "x", 0, "invalid character 'x' in literal false (expecting 'f')")
  check_literal("false", "falsx", 4, "invalid character 'x' in literal false (expecting 'e')")
  check_literal("true", "", 0, "unexpected EOF")
  check_literal("true", "t", 1, "unexpected EOF")
  check_literal("true", "tr", 2, "unexpected EOF")
  check_literal("true", "tru", 3, "unexpected EOF")
  check_literal("true", "true", 4, "")
  check_literal("true", "truex", 4, "")
  check_literal("true", "x", 0, "invalid character 'x' in literal true (expecting 't')")
  check_literal("true", "trux", 3, "invalid character 'x' in literal true (expecting 'e')")
}

