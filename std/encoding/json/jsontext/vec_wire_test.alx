  check_string("\"\\uDEAD\\uBEEF\"", 0, 14, 3, "", 1, "invalid surrogate pair `\\uDEAD\\uBEEF` in string", "\uFFFD\uBEEF", "invalid surrogate pair `\\uDEAD\\uBEEF` in string")
