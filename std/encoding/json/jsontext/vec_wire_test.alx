}

test "consume number" {
  check_number("", 0, 0, "unexpected EOF")
  check_number("\"NaN\"", 0, 0, "invalid character '\"' in number (expecting digit)")
  check_number("\"Infinity\"", 0, 0, "invalid character '\"' in number (expecting digit)")
  check_number("\"-Infinity\"", 0, 0, "invalid character '\"' in number (expecting digit)")
  check_number(".0", 0, 0, "invalid character '.' in number (expecting digit)")
  check_number("0", 1, 1, "")
  check_number("-0", 0, 2, "")
  check_number("+0", 0, 0, "invalid character '+' in number (expecting digit)")
  check_number("1", 1, 1, "")
  check_number("-1", 0, 2, "")
  check_number("00", 1, 1, "")
  check_number("-00", 0, 2, "")
  check_number("01", 1, 1, "")
  check_number("-01", 0, 2, "")
  check_number("0i", 1, 1, "")
  check_number("-0i", 0, 2, "")
  check_number("0f", 1, 1, "")
  check_number("-0f", 0, 2, "")
  check_number("9876543210", 10, 10, "")
  check_number("-9876543210", 0, 11, "")
  check_number("9876543210x", 10, 10, "")
  check_number("-9876543210x", 0, 11, "")
  check_number(" 9876543210", 0, 0, "invalid character ' ' in number (expecting digit)")
  check_number("- 9876543210", 0, 1, "invalid character ' ' in number (expecting digit)")
  check_number("9876543210" * 1000, 10000, 10000, "")
  check_number("-" + "9876543210" * 1000, 0, 10001, "")
  check_number("0.", 0, 1, "unexpected EOF")
  check_number("-0.", 0, 2, "unexpected EOF")
  check_number("0e", 0, 1, "unexpected EOF")
  check_number("-0e", 0, 2, "unexpected EOF")
  check_number("0E", 0, 1, "unexpected EOF")
  check_number("-0E", 0, 2, "unexpected EOF")
  check_number("0.0", 0, 3, "")
  check_number("-0.0", 0, 4, "")
  check_number("0e0", 0, 3, "")
  check_number("-0e0", 0, 4, "")
  check_number("0E0", 0, 3, "")
  check_number("-0E0", 0, 4, "")
  check_number("0.0123456789", 0, 12, "")
  check_number("-0.0123456789", 0, 13, "")
  check_number("1.f", 0, 2, "invalid character 'f' in number (expecting digit)")
  check_number("-1.f", 0, 3, "invalid character 'f' in number (expecting digit)")
  check_number("1.e", 0, 2, "invalid character 'e' in number (expecting digit)")
  check_number("-1.e", 0, 3, "invalid character 'e' in number (expecting digit)")
  check_number("1e0", 0, 3, "")
  check_number("-1e0", 0, 4, "")
  check_number("1E0", 0, 3, "")
  check_number("-1E0", 0, 4, "")
  check_number("1Ex", 0, 2, "invalid character 'x' in number (expecting digit)")
  check_number("-1Ex", 0, 3, "invalid character 'x' in number (expecting digit)")
  check_number("1e-0", 0, 4, "")
  check_number("-1e-0", 0, 5, "")
  check_number("1e+0", 0, 4, "")
  check_number("-1e+0", 0, 5, "")
  check_number("1E-0", 0, 4, "")
  check_number("-1E-0", 0, 5, "")
  check_number("1E+0", 0, 4, "")
  check_number("-1E+0", 0, 5, "")
  check_number("1E+00500", 0, 8, "")
  check_number("-1E+00500", 0, 9, "")
  check_number("1E+00500x", 0, 8, "")
  check_number("-1E+00500x", 0, 9, "")
  check_number("9876543210.0123456789e+01234589x", 0, 31, "")
  check_number("-9876543210.0123456789e+01234589x", 0, 32, "")
  check_number("1_000_000", 1, 1, "")
  check_number("0x12ef", 1, 1, "")
  check_number("0x1p-2", 1, 1, "")
}

test "parse hex uint16" {
  check_eq(parse_hex_u16("".bytes), -1, "")
  check_eq(parse_hex_u16("a".bytes), -1, "a")
  check_eq(parse_hex_u16("ab".bytes), -1, "ab")
  check_eq(parse_hex_u16("abc".bytes), -1, "abc")
  check_eq(parse_hex_u16("abcd".bytes), 43981, "abcd")
  check_eq(parse_hex_u16("abcde".bytes), -1, "abcde")
  check_eq(parse_hex_u16("9eA1".bytes), 40609, "9eA1")
  check_eq(parse_hex_u16("gggg".bytes), -1, "gggg")
  check_eq(parse_hex_u16("0000".bytes), 0, "0000")
  check_eq(parse_hex_u16("1234".bytes), 4660, "1234")
}

test "parse uint" {
  check_parse_uint("", 0, false)
  check_parse_uint("0", 0, true)
  check_parse_uint("1", 1, true)
  check_parse_uint("-1", 0, false)
  check_parse_uint("1f", 0, false)
  check_parse_uint("00", 0, false)
  check_parse_uint("01", 0, false)
  check_parse_uint("10", 10, true)
  check_parse_uint("10.9", 0, false)
  check_parse_uint(" 10", 0, false)
  check_parse_uint("10 ", 0, false)
  check_parse_uint("123456789", 123456789, true)
  check_parse_uint("123456789d", 0, false)
  check_parse_uint("18446744073709551614", 18446744073709551614, true)
  check_parse_uint("18446744073709551615", 18446744073709551615, true)
  check_parse_uint("18446744073709551616", 18446744073709551615, false)
  check_parse_uint("18446744073709551620", 18446744073709551615, false)
  check_parse_uint("18446744073709551700", 18446744073709551615, false)
  check_parse_uint("18446744073709552000", 18446744073709551615, false)
  check_parse_uint("18446744073709560000", 18446744073709551615, false)
  check_parse_uint("18446744073709600000", 18446744073709551615, false)
  check_parse_uint("18446744073710000000", 18446744073709551615, false)
  check_parse_uint("18446744073800000000", 18446744073709551615, false)
  check_parse_uint("18446744074000000000", 18446744073709551615, false)
  check_parse_uint("18446744080000000000", 18446744073709551615, false)
  check_parse_uint("18446744100000000000", 18446744073709551615, false)
  check_parse_uint("18446745000000000000", 18446744073709551615, false)
  check_parse_uint("18446750000000000000", 18446744073709551615, false)
  check_parse_uint("18446800000000000000", 18446744073709551615, false)
  check_parse_uint("18447000000000000000", 18446744073709551615, false)
  check_parse_uint("18450000000000000000", 18446744073709551615, false)
  check_parse_uint("18500000000000000000", 18446744073709551615, false)
  check_parse_uint("19000000000000000000", 18446744073709551615, false)
  check_parse_uint("19999999999999999999", 18446744073709551615, false)
  check_parse_uint("20000000000000000000", 18446744073709551615, false)
  check_parse_uint("100000000000000000000", 18446744073709551615, false)
  check_parse_uint("99999999999999999999999999999999", 18446744073709551615, false)
  check_parse_uint("99999999999999999999999999999999f", 0, false)
}

test "quote rune" {
  check_eq(quote_rune_b("x".bytes), "'x'", "x")
  check_eq(quote_rune_b("\n".bytes), "'\\n'", "\n")
  check_eq(quote_rune_b("'".bytes), "'\\''", "'")
  check_eq(quote_rune_b(hs("ff").bytes), "'\\xff'", hs("ff"))
  check_eq(quote_rune_b("\U0001F4A9".bytes), "'\U0001F4A9'", "\U0001F4A9")
  check_eq(quote_rune_b(hs("f0").bytes), "'\\xf0'", hs("f0"))
  check_eq(quote_rune_b("\uFFFF".bytes), "'\\uffff'", "\uFFFF")
  check_eq(quote_rune_b("\U00101234".bytes), "'\\U00101234'", "\U00101234")
}

test "compare utf16" {
  check_eq(compare_utf16("".bytes, "".bytes), 0, "cmp")
  check_eq(compare_utf16("".bytes, "\r".bytes), -1, "cmp")
  check_eq(compare_utf16("".bytes, "1".bytes), -1, "cmp")
  check_eq(compare_utf16("".bytes, hs("66fe").bytes), -1, "cmp")
  check_eq(compare_utf16("".bytes, hs("66feff").bytes), -1, "cmp")
  check_eq(compare_utf16("".bytes, hs("66ff").bytes), -1, "cmp")
  check_eq(compare_utf16("".bytes, "\u0080".bytes), -1, "cmp")
  check_eq(compare_utf16("".bytes, "\u00F6".bytes), -1, "cmp")
  check_eq(compare_utf16("".bytes, "\u20AC".bytes), -1, "cmp")
  check_eq(compare_utf16("".bytes, "\U0001F600".bytes), -1, "cmp")
  check_eq(compare_utf16("".bytes, "\uFB33".bytes), -1, "cmp")
  check_eq(compare_utf16("\r".bytes, "".bytes), 1, "cmp")
  check_eq(compare_utf16("\r".bytes, "\r".bytes), 0, "cmp")
  check_eq(compare_utf16("\r".bytes, "1".bytes), -1, "cmp")
  check_eq(compare_utf16("\r".bytes, hs("66fe").bytes), -1, "cmp")
  check_eq(compare_utf16("\r".bytes, hs("66feff").bytes), -1, "cmp")
  check_eq(compare_utf16("\r".bytes, hs("66ff").bytes), -1, "cmp")
  check_eq(compare_utf16("\r".bytes, "\u0080".bytes), -1, "cmp")
  check_eq(compare_utf16("\r".bytes, "\u00F6".bytes), -1, "cmp")
  check_eq(compare_utf16("\r".bytes, "\u20AC".bytes), -1, "cmp")
  check_eq(compare_utf16("\r".bytes, "\U0001F600".bytes), -1, "cmp")
  check_eq(compare_utf16("\r".bytes, "\uFB33".bytes), -1, "cmp")
  check_eq(compare_utf16("1".bytes, "".bytes), 1, "cmp")
  check_eq(compare_utf16("1".bytes, "\r".bytes), 1, "cmp")
  check_eq(compare_utf16("1".bytes, "1".bytes), 0, "cmp")
  check_eq(compare_utf16("1".bytes, hs("66fe").bytes), -1, "cmp")
  check_eq(compare_utf16("1".bytes, hs("66feff").bytes), -1, "cmp")
  check_eq(compare_utf16("1".bytes, hs("66ff").bytes), -1, "cmp")
  check_eq(compare_utf16("1".bytes, "\u0080".bytes), -1, "cmp")
  check_eq(compare_utf16("1".bytes, "\u00F6".bytes), -1, "cmp")
  check_eq(compare_utf16("1".bytes, "\u20AC".bytes), -1, "cmp")
  check_eq(compare_utf16("1".bytes, "\U0001F600".bytes), -1, "cmp")
  check_eq(compare_utf16("1".bytes, "\uFB33".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, "".bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, "\r".bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, "1".bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, hs("66fe").bytes), 0, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, hs("66feff").bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, hs("66ff").bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, "\u0080".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, "\u00F6".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, "\u20AC".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, "\U0001F600".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66fe").bytes, "\uFB33".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, "".bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, "\r".bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, "1".bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, hs("66fe").bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, hs("66feff").bytes), 0, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, hs("66ff").bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, "\u0080".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, "\u00F6".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, "\u20AC".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, "\U0001F600".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66feff").bytes, "\uFB33".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, "".bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, "\r".bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, "1".bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, hs("66fe").bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, hs("66feff").bytes), 1, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, hs("66ff").bytes), 0, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, "\u0080".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, "\u00F6".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, "\u20AC".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, "\U0001F600".bytes), -1, "cmp")
  check_eq(compare_utf16(hs("66ff").bytes, "\uFB33".bytes), -1, "cmp")
  check_eq(compare_utf16("\u0080".bytes, "".bytes), 1, "cmp")
  check_eq(compare_utf16("\u0080".bytes, "\r".bytes), 1, "cmp")
  check_eq(compare_utf16("\u0080".bytes, "1".bytes), 1, "cmp")
  check_eq(compare_utf16("\u0080".bytes, hs("66fe").bytes), 1, "cmp")
  check_eq(compare_utf16("\u0080".bytes, hs("66feff").bytes), 1, "cmp")
  check_eq(compare_utf16("\u0080".bytes, hs("66ff").bytes), 1, "cmp")
  check_eq(compare_utf16("\u0080".bytes, "\u0080".bytes), 0, "cmp")
  check_eq(compare_utf16("\u0080".bytes, "\u00F6".bytes), -1, "cmp")
  check_eq(compare_utf16("\u0080".bytes, "\u20AC".bytes), -1, "cmp")
  check_eq(compare_utf16("\u0080".bytes, "\U0001F600".bytes), -1, "cmp")
  check_eq(compare_utf16("\u0080".bytes, "\uFB33".bytes), -1, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, "".bytes), 1, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, "\r".bytes), 1, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, "1".bytes), 1, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, hs("66fe").bytes), 1, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, hs("66feff").bytes), 1, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, hs("66ff").bytes), 1, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, "\u0080".bytes), 1, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, "\u00F6".bytes), 0, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, "\u20AC".bytes), -1, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, "\U0001F600".bytes), -1, "cmp")
  check_eq(compare_utf16("\u00F6".bytes, "\uFB33".bytes), -1, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, "".bytes), 1, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, "\r".bytes), 1, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, "1".bytes), 1, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, hs("66fe").bytes), 1, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, hs("66feff").bytes), 1, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, hs("66ff").bytes), 1, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, "\u0080".bytes), 1, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, "\u00F6".bytes), 1, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, "\u20AC".bytes), 0, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, "\U0001F600".bytes), -1, "cmp")
  check_eq(compare_utf16("\u20AC".bytes, "\uFB33".bytes), -1, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, "".bytes), 1, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, "\r".bytes), 1, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, "1".bytes), 1, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, hs("66fe").bytes), 1, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, hs("66feff").bytes), 1, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, hs("66ff").bytes), 1, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, "\u0080".bytes), 1, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, "\u00F6".bytes), 1, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, "\u20AC".bytes), 1, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, "\U0001F600".bytes), 0, "cmp")
  check_eq(compare_utf16("\U0001F600".bytes, "\uFB33".bytes), -1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, "".bytes), 1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, "\r".bytes), 1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, "1".bytes), 1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, hs("66fe").bytes), 1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, hs("66feff").bytes), 1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, hs("66ff").bytes), 1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, "\u0080".bytes), 1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, "\u00F6".bytes), 1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, "\u20AC".bytes), 1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, "\U0001F600".bytes), 1, "cmp")
  check_eq(compare_utf16("\uFB33".bytes, "\uFB33".bytes), 0, "cmp")
}

test "truncate pointer" {
  check_eq(truncate_pointer("hello", 10), "hello", "hello")
  check_eq(truncate_pointer("/a/b/c", 10), "/a/b/c", "/a/b/c")
  check_eq(truncate_pointer("/a/b/c/d/e/f/g", 10), "/a/b/\u2026/f/g", "/a/b/c/d/e/f/g")
  check_eq(truncate_pointer("supercalifragilisticexpialidocious", 10), "super\u2026cious", "supercalifragilisticexpialidocious")
  check_eq(truncate_pointer("/supercalifragilisticexpialidocious/supercalifragilisticexpialidocious", 10), "/supe\u2026/\u2026cious", "/supercalifragilisticexpialidocious/supercalifragilisticexpialidocious")
  check_eq(truncate_pointer("/supercalifragilisticexpialidocious/supercalifragilisticexpialidocious/supercalifragilisticexpialidocious", 10), "/supe\u2026/\u2026/\u2026cious", "/supercalifragilisticexpialidocious/supercalifragilisticexpialidocious/supercalifragilisticexpialidocious")
  check_eq(truncate_pointer("/a/supercalifragilisticexpialidocious/supercalifragilisticexpialidocious", 10), "/a/\u2026/\u2026cious", "/a/supercalifragilisticexpialidocious/supercalifragilisticexpialidocious")
  check_eq(truncate_pointer("/supercalifragilisticexpialidocious/supercalifragilisticexpialidocious/b", 10), "/supe\u2026/\u2026/b", "/supercalifragilisticexpialidocious/supercalifragilisticexpialidocious/b")
  check_eq(truncate_pointer("/fizz/buzz/bazz", 10), "/fizz/\u2026/bazz", "/fizz/buzz/bazz")
  check_eq(truncate_pointer("/fizz/buzz/bazz/razz", 10), "/fizz/\u2026/razz", "/fizz/buzz/bazz/razz")
  check_eq(truncate_pointer("/////////////////////////////", 10), "/////\u2026/////", "/////////////////////////////")
  check_eq(truncate_pointer("/\U0001F384\u2764\uFE0F\u2728/\U0001F381\u2705\U0001F60A/\U0001F385\U0001F525\u2B50", 10), "/\U0001F384\u2026/\u2026/\u2026\u2B50", "/\U0001F384\u2764\uFE0F\u2728/\U0001F381\u2705\U0001F60A/\U0001F385\U0001F525\u2B50")
}

test "append quote" {
  check_quote("", 0x0, "\"\"", "", "\"\"", "")
  check_quote("hello", 0x0, "\"hello\"", "", "\"hello\"", "")
  check_quote("\x00", 0x0, "\"\\u0000\"", "", "\"\\u0000\"", "")
  check_quote("\x1f", 0x0, "\"\\u001f\"", "", "\"\\u001f\"", "")
  check_quote("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", 0x0, "\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\"", "", "\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\"", "")
  check_quote(" !\#$%&'()*+,-./0123456789:;<=>?@[]^_`{|}~\x7f", 0x0, "\" !\#$%&'()*+,-./0123456789:;<=>?@[]^_`{|}~\x7f\"", "", "\" !\#$%&'()*+,-./0123456789:;<=>?@[]^_`{|}~\x7f\"", "")
  check_quote(" !\#$%&'()*+,-./0123456789:;<=>?@[]^_`{|}~\x7f", 0x200, "\" !\#$%\\u0026'()*+,-./0123456789:;\\u003c=\\u003e?@[]^_`{|}~\x7f\"", "", "\" !\#$%\\u0026'()*+,-./0123456789:;\\u003c=\\u003e?@[]^_`{|}~\x7f\"", "")
  check_quote(" !\#$%&'()*+,-./0123456789:;<=>?@[]^_`{|}~\x7f", 0x400, "\" !\#$%&'()*+,-./0123456789:;<=>?@[]^_`{|}~\x7f\"", "", "\" !\#$%&'()*+,-./0123456789:;<=>?@[]^_`{|}~\x7f\"", "")
  check_quote("\u2027\u2028\u2029\u2030", 0x0, "\"\u2027\u2028\u2029\u2030\"", "", "\"\u2027\u2028\u2029\u2030\"", "")
  check_quote("\u2027\u2028\u2029\u2030", 0x200, "\"\u2027\u2028\u2029\u2030\"", "", "\"\u2027\u2028\u2029\u2030\"", "")
  check_quote("\u2027\u2028\u2029\u2030", 0x400, "\"\u2027\\u2028\\u2029\u2030\"", "", "\"\u2027\\u2028\\u2029\u2030\"", "")
  check_quote(hs("7880efbfbd"), 0x0, "\"x\uFFFD\uFFFD\"", "", "\"x\uFFFD\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78ffefbfbd"), 0x0, "\"x\uFFFD\uFFFD\"", "", "\"x\uFFFD\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78c0"), 0x0, "\"x\uFFFD\"", "", "\"x\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78c080"), 0x0, "\"x\uFFFD\uFFFD\"", "", "\"x\uFFFD\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78e0"), 0x0, "\"x\uFFFD\"", "", "\"x\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78e080"), 0x0, "\"x\uFFFD\uFFFD\"", "", "\"x\uFFFD\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78e08080"), 0x0, "\"x\uFFFD\uFFFD\uFFFD\"", "", "\"x\uFFFD\uFFFD\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78f0"), 0x0, "\"x\uFFFD\"", "", "\"x\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78f080"), 0x0, "\"x\uFFFD\uFFFD\"", "", "\"x\uFFFD\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78f08080"), 0x0, "\"x\uFFFD\uFFFD\uFFFD\"", "", "\"x\uFFFD\uFFFD\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78f0808080"), 0x0, "\"x\uFFFD\uFFFD\uFFFD\uFFFD\"", "", "\"x\uFFFD\uFFFD\uFFFD\uFFFD\"", "invalid UTF-8")
  check_quote(hs("78edbaad"), 0x0, "\"x\uFFFD\uFFFD\uFFFD\"", "", "\"x\uFFFD\uFFFD\uFFFD\"", "invalid UTF-8")
  check_quote("\"\\/\x08\x0c\n\r\t", 0x0, "\"\\\"\\\\/\\b\\f\\n\\r\\t\"", "", "\"\\\"\\\\/\\b\\f\\n\\r\\t\"", "")
  check_quote("\u0669(-\u032E\u032E\u0303-\u0303)\u06F6 \u0669(\u25CF\u032E\u032E\u0303\u2022\u0303)\u06F6 \u0669(\u0361\u0E4F\u032F\u0361\u0E4F)\u06F6 \u0669(-\u032E\u032E\u0303\u2022\u0303).", 0x0, "\"\u0669(-\u032E\u032E\u0303-\u0303)\u06F6 \u0669(\u25CF\u032E\u032E\u0303\u2022\u0303)\u06F6 \u0669(\u0361\u0E4F\u032F\u0361\u0E4F)\u06F6 \u0669(-\u032E\u032E\u0303\u2022\u0303).\"", "", "\"\u0669(-\u032E\u032E\u0303-\u0303)\u06F6 \u0669(\u25CF\u032E\u032E\u0303\u2022\u0303)\u06F6 \u0669(\u0361\u0E4F\u032F\u0361\u0E4F)\u06F6 \u0669(-\u032E\u032E\u0303\u2022\u0303).\"", "")
  check_quote("\u0080\u00F6\u20AC\uD799\uE000\uFB33\uFFFD\U0001F602", 0x0, "\"\u0080\u00F6\u20AC\uD799\uE000\uFB33\uFFFD\U0001F602\"", "", "\"\u0080\u00F6\u20AC\uD799\uE000\uFB33\uFFFD\U0001F602\"", "")
  check_quote("\x00\x1f \"&<>\\\x7f\u0080\u2028\u2029\uFFFD\U0001F602", 0x0, "\"\\u0000\\u001f \\\"&<>\\\\\x7f\u0080\u2028\u2029\uFFFD\U0001F602\"", "", "\"\\u0000\\u001f \\\"&<>\\\\\x7f\u0080\u2028\u2029\uFFFD\U0001F602\"", "")
}

test "append number 0" {
  check_float(0x4005bf0a8b145769, "2.7182817", "2.718281828459045")
  check_float(0x400921fb54442d18, "3.1415927", "3.141592653589793")
  check_float(0x36a0000000000000, "1e-45", "1.401298464324817e-45")
  check_float(0x1, "0", "5e-324")
  check_float(0x47efffffe0000000, "3.4028235e+38", "3.4028234663852886e+38")
  check_float(0x7fefffffffffffff, "+Inf", "1.7976931348623157e+308")
  check_float(0x3fbc71c71c71c71c, "0.11111111", "0.1111111111111111")
  check_float(0x3fcc71c71c71c71c, "0.22222222", "0.2222222222222222")
  check_float(0x3fd5555555555555, "0.33333334", "0.3333333333333333")
  check_float(0x3fdc71c71c71c71c, "0.44444445", "0.4444444444444444")
  check_float(0x3fe1c71c71c71c71, "0.5555556", "0.5555555555555555")
  check_float(0x3fe5555555555555, "0.6666667", "0.6666666666666666")
  check_float(0x3fe8e38e38e38e38, "0.7777778", "0.7777777777777777")
  check_float(0x3fec71c71c71c71c, "0.8888889", "0.8888888888888888")
  check_float(0x3fefffffffffffff, "1", "0.9999999999999999")
  check_float(0x0, "0", "0")
  check_float(0x8000000000000000, "-0", "-0")
  check_float(0x1, "0", "5e-324")
  check_float(0x8000000000000001, "-0", "-5e-324")
  check_float(0x7fefffffffffffff, "+Inf", "1.7976931348623157e+308")
  check_float(0xffefffffffffffff, "-Inf", "-1.7976931348623157e+308")
  check_float(0x4340000000000000, "9007199000000000", "9007199254740992")
  check_float(0xc340000000000000, "-9007199000000000", "-9007199254740992")
  check_float(0x4430000000000000, "295147900000000000000", "295147905179352830000")
  check_float(0x44b52d02c7e14af5, "1e+23", "9.999999999999997e+22")
  check_float(0x44b52d02c7e14af6, "1e+23", "1e+23")
  check_float(0x44b52d02c7e14af7, "1e+23", "1.0000000000000001e+23")
  check_float(0x444b1ae4d6e2ef4e, "1e+21", "999999999999999700000")
  check_float(0x444b1ae4d6e2ef4f, "1e+21", "999999999999999900000")
  check_float(0x444b1ae4d6e2ef50, "1e+21", "1e+21")
  check_float(0x3eb0c6f7a0b5ed8c, "0.000001", "9.999999999999997e-7")
  check_float(0x3eb0c6f7a0b5ed8d, "0.000001", "0.000001")
  check_float(0x41b3de4355555553, "333333340", "333333333.3333332")
  check_float(0x41b3de4355555554, "333333340", "333333333.33333325")
  check_float(0x41b3de4355555555, "333333340", "333333333.3333333")
  check_float(0x41b3de4355555556, "333333340", "333333333.3333334")
  check_float(0x41b3de4355555557, "333333340", "333333333.33333343")
  check_float(0xbecbf647612f3696, "-0.0000033333333", "-0.0000033333333333333333")
  check_float(0x43143ff3c1cb0959, "1424953900000000", "1424953923781206.2")
  check_float(0x44b52d02a0000000, "9.999999e+22", "9.999998877476383e+22")
  check_float(0x44b52d02c0000000, "1e+23", "9.999999778196308e+22")
  check_float(0x44b52d02e0000000, "1.0000001e+23", "1.0000000678916234e+23")
  check_float(0x444b1ae4a0000000, "999999900000000000000", "999999879303389000000")
  check_float(0x444b1ae4c0000000, "999999950000000000000", "999999949672133200000")
  check_float(0x444b1ae4e0000000, "1e+21", "1.0000000200408773e+21")
  check_float(0x444b1ae500000000, "1.0000001e+21", "1.0000000904096215e+21")
  check_float(0x3eb0c6f780000000, "9.999999e-7", "9.99999883788405e-7")
  check_float(0x3eb0c6f7a0000000, "0.000001", "9.999999974752427e-7")
  check_float(0x3eb0c6f7c0000000, "0.0000010000001", "0.0000010000001111620804")
}
