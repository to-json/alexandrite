# Go's encoding/json/internal/jsonwire tests: the checks behind the
# generated tables in vec_wire_test.alx (TestConsumeWhitespace,
# TestConsumeLiteral, TestConsumeString, TestConsumeNumber,
# TestParseHexUint16, TestParseUint, TestQuoteRune, TestCompareUTF16,
# TestTruncatePointer, TestAppendQuote, TestAppendNumber).

def cause_text(c: Cause?) -> Str {
  if e = c { return e.message }
  ""
}

def check_literal(lit: Str, input: Str, want: Int, want_err: Str) {
  b = input.bytes
  quick = consume_word(b, 0, lit)
  if want_err == "" {
    check_eq(quick, want, "consume " + lit + " " + input)
  } else {
    check_eq(quick, 0, "consume " + lit + " " + input)
  }
  n, err = consume_literal(b, 0, lit)
  check_eq(n, want, "consume_literal " + input)
  check_eq(cause_text(err), want_err, "consume_literal error " + input)
}

def check_string(input: Str, simple: Int, n1: Int, flags: Int, e1: Str, n2: Int, e2: Str, uq: Str, e3: Str) {
  b = input.bytes
  check_eq(consume_simple_string(b, 0), simple, "simple " + input)
  got1, fl, err1 = consume_string(b, 0, false)
  check_eq(got1, n1, "consume_string " + input)
  check_eq(fl, flags, "consume_string flags " + input)
  check_eq(cause_text(err1), e1, "consume_string error " + input)
  got2, _fl, err2 = consume_string(b, 0, true)
  check_eq(got2, n2, "consume_string utf8 " + input)
  check_eq(cause_text(err2), e2, "consume_string utf8 error " + input)
  u, err3 = unquote_into([], b)
  check_eq(Str.from_bytes(u), uq, "unquote " + input)
  check_eq(cause_text(err3), e3, "unquote error " + input)
}

def check_number(input: Str, simple: Int, want: Int, want_err: Str) {
  b = input.bytes
  check_eq(consume_simple_number(b, 0), simple, "simple number " + input)
  n, err = consume_number(b, 0)
  check_eq(n, want, "consume_number " + input)
  check_eq(cause_text(err), want_err, "consume_number error " + input)
  # Resuming at every split point gives the same result (the decoder relies
  # on it when a number spans reads).
  if want_err == "" && input.size < 100 {
    for split in 0...input.size {
      n1, st1, e1 = consume_number_resumable(b[0...split], 0, 0, NUM_INIT)
      if e1 == Cause.UnexpectedEof || e1.none? {
        n2, _st2, e2 = consume_number_resumable(b, 0, n1, st1)
        check_eq(n2, want, "resumed number " + input + " at " + split.to_s)
        check_eq(cause_text(e2), "", "resumed number error " + input)
      }
    }
  }
}

def check_parse_uint(input: Str, want: U64, ok: Bool) {
  v, got_ok = parse_uint(input.bytes)
  check_eq(v, want, "parse_uint " + input)
  check_eq(got_ok, ok, "parse_uint ok " + input)
}

def check_quote(input: Str, flags: U64, want_allow: Str, err_allow: Str, want: Str, err: Str) {
  o = Options.new
  o.set!(flags, true) if flags != 0
  o.set!(F_ALLOW_INVALID_UTF8, true)
  b, e = append_quote_opts([], input.bytes, o)
  check_eq(Str.from_bytes(b), want_allow, "append_quote " + input)
  check_eq(cause_text(e), err_allow, "append_quote error " + input)
  o.set!(F_ALLOW_INVALID_UTF8, false)
  b2, e2 = append_quote_opts([], input.bytes, o)
  check_eq(Str.from_bytes(b2), want, "append_quote strict " + input)
  check_eq(cause_text(e2), err, "append_quote strict error " + input)
}

def check_float(bits: U64, want32: Str, want64: Str) {
  f = math.float64frombits(bits)
  check_eq(Str.from_bytes(append_float([], f, 64)), want64, "append_float 64 #{want64}")
  check_eq(Str.from_bytes(append_float([], f, 32)), want32, "append_float 32 #{want32}")
}
