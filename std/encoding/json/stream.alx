#![overflow(wrap)]
# Go's streaming Decoder (NewDecoder(r)): values and tokens read from an
# io.Reader, with Go 1.27's semantics (its Decoder is built on jsontext:
# separators between tokens are implicit, several top-level values may follow
# each other, errors are jsontext's in v1's words).

import "io"

# The state of a Decoder reading from a stream.
struct SState {
  r: io.Reader
  # unread input: buf[pos...], buf[0] is at offset `off` of the stream
  buf: Str
  pos: Int
  off: Int
  # the reader is done
  eof: Bool
  # the first read error or syntax error: every call after it fails with it
  err: [Error]
  # open containers: 123 or 91, and how many tokens each has (an object
  # counts names and values)
  kinds: [Int]
  lens: [Int]
  # where the last value read began
  vstart: Int
  # Go's hadPeeked / hadEOF (InputOffset's rules)
  peeked: Bool
  had_eof: Bool
}

def new_sstate(r: io.Reader) -> SState {
  SState.new(r: r, buf: "", pos: 0, off: 0, eof: false, err: [], kinds: [], lens: [], vstart: 0, peeked: false, had_eof: false)
}

# A token (Go's Token: Delim, bool, float64, Number, string or nil).
pub enum Token {
  Delim(r: Rune)
  Bool(v: Bool)
  Float(v: Float)
  Num(v: Number)
  String(v: Str)
  Null

  # Go's %v of the token.
  pub def to_s -> Str {
    case self {
      Delim(r) => Str.from_bytes([r.as_u8])
      Bool(v) => v ? "true" : "false"
      Float(v) => format("%v", v)
      Num(v) => v.to_s
      String(v) => v
      Null => "<nil>"
    }
  }
}

# Go's Delim: `[`, `]`, `{` or `}`; its String is the character.
pub def delim_text(r: Rune) -> Str { Str.from_bytes([r.as_u8]) }

def white?(c: Byte) -> Bool { c == 32 || c == 10 || c == 13 || c == 9 }
