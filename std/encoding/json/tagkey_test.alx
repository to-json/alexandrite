#![test(external)]
# Go's tagkey_test.go and number_test.go (go1.27), translated.
# Go's badFormatTag (`:"BadFormat"`, a struct tag without a key) has no alx
# spelling; the field names are Go's with a lower-case first letter.

import "encoding/json"
import "regexp"

#[derive(Json)]
struct BasicLatin2xTag {
  #[json("$%-/")] v: Str
}

#[derive(Json)]
struct BasicLatin3xTag {
  #[json("0123456789")] v: Str
}

#[derive(Json)]
struct BasicLatin4xTag {
  #[json("ABCDEFGHIJKLMO")] v: Str
}

#[derive(Json)]
struct BasicLatin5xTag {
  #[json("PQRSTUVWXYZ_")] v: Str
}

#[derive(Json)]
struct BasicLatin6xTag {
  #[json("abcdefghijklmno")] v: Str
}

#[derive(Json)]
struct BasicLatin7xTag {
  #[json("pqrstuvwxyz")] v: Str
}

#[derive(Json)]
struct MiscPlaneTag {
  #[json("色は匂へど")] v: Str
}

#[derive(Json)]
struct PercentSlashTag {
  # https://golang.org/issue/2718
  #[json("text/html%")] v: Str
}

#[derive(Json)]
struct PunctuationTag {
  # https://golang.org/issue/3546
  #[json("!#$%&()*+-./:;<=>?@[]^_{|}~ ")] v: Str
}

#[derive(Json)]
struct DashTag {
  #[field(json: "-,")] v: Str
}

#[derive(Json)]
struct EmptyTag {
  w: Str
}

#[derive(Json)]
struct MisnamedTag {
  #[field(jsom: "Misnamed")] x: Str
}

#[derive(Json)]
struct BadCodeTag {
  # not a valid name (quotes): the field keeps its own
  #[field(json: " !\"#&'()*+,.")] z: Str
}

#[derive(Json)]
struct SpaceTag {
  #[json("With space")] q: Str
}

#[derive(Json)]
struct UnicodeTag {
  #[json("Ελλάδα")] w: Str
}

# The one member of the JSON of v (Go decodes it into a map[string]any).
def one_member[X](v: X) -> (Str, Str) {
  b = json.marshal(v).unwrap
  f = json.parse(b).unwrap
  assert_eq f.size, 1
  k = f.keys[0]
  (k, f.get(k).unwrap.as_str || "")
}

test "TestStructTagObjectKey" {
  assert_eq one_member(BasicLatin2xTag.new(v: "2x")), ("$%-/", "2x")
  assert_eq one_member(BasicLatin3xTag.new(v: "3x")), ("0123456789", "3x")
  assert_eq one_member(BasicLatin4xTag.new(v: "4x")), ("ABCDEFGHIJKLMO", "4x")
  assert_eq one_member(BasicLatin5xTag.new(v: "5x")), ("PQRSTUVWXYZ_", "5x")
  assert_eq one_member(BasicLatin6xTag.new(v: "6x")), ("abcdefghijklmno", "6x")
  assert_eq one_member(BasicLatin7xTag.new(v: "7x")), ("pqrstuvwxyz", "7x")
  assert_eq one_member(MiscPlaneTag.new(v: "いろはにほへと")), ("色は匂へど", "いろはにほへと")
  assert_eq one_member(DashTag.new(v: "foo")), ("-", "foo")
  assert_eq one_member(EmptyTag.new(w: "Pour Moi")), ("w", "Pour Moi")
  assert_eq one_member(MisnamedTag.new(x: "Animal Kingdom")), ("x", "Animal Kingdom")
  assert_eq one_member(BadCodeTag.new(z: "Reliable Man")), ("z", "Reliable Man")
  assert_eq one_member(PercentSlashTag.new(v: "brut")), ("text/html%", "brut")
  assert_eq one_member(PunctuationTag.new(v: "Union Rags")), ("!#$%&()*+-./:;<=>?@[]^_{|}~ ", "Union Rags")
  assert_eq one_member(SpaceTag.new(q: "Perreddu")), ("With space", "Perreddu")
  assert_eq one_member(UnicodeTag.new(w: "Loukanikos")), ("Ελλάδα", "Loukanikos")
}

test "TestNumberIsValid" {
  # From: https://stackoverflow.com/a/13340826
  re = regexp.must_compile("^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$")
  valid_tests = ["0", "-0", "1", "-1", "0.1", "-0.1", "1234", "-1234", "12.34", "-12.34", "12E0", "12E1", "12e34", "12E-0", "12e+1", "12e-34", "-12E0", "-12E1", "-12e34", "-12E-0", "-12e+1", "-12e-34", "1.2E0", "1.2E1", "1.2e34", "1.2E-0", "1.2e+1", "1.2e-34", "-1.2E0", "-1.2E1", "-1.2e34", "-1.2E-0", "-1.2e+1", "-1.2e-34", "0E0", "0E1", "0e34", "0E-0", "0e+1", "0e-34", "-0E0", "-0E1", "-0e34", "-0E-0", "-0e+1", "-0e-34"]
  for t in valid_tests {
    assert json.valid_number?(t), "#{t} should be valid"
    assert json.unmarshal_into(t, 0.0).ok?, "#{t} should be valid but Unmarshal failed"
    assert re.match_string?(t), "#{t} should be valid but regexp does not match"
  }
  invalid_tests = ["", "invalid", "1.0.1", "1..1", "-1-2", "012a42", "01.2", "012", "12E12.12", "1e2e3", "1e+-2", "1e--23", "1e", "e1", "1e+", "1ea", "1a", "1.a", "1.", "01", "1.e1"]
  for t in invalid_tests {
    assert !json.valid_number?(t), "#{t} should be invalid"
    assert json.unmarshal_into(t, 0.0).err?, "#{t} should be invalid but unmarshal wrote a value"
    assert !re.match_string?(t), "#{t} should be invalid but matches regexp"
  }
}
