# encoding/json/v2 through #[derive(Json)]: a package of its own, since the
# derived code imports encoding/json/v2.

import json "encoding/json/v2"
import "encoding/json/jsontext"

#[derive(Json)]
struct Point {
  x: Int
  y: Int
}

#[derive(Json)]
struct User {
  #[field(json: "name")] name: Str
  #[field(json: "age,omitzero")] age: Int
  #[field(json: "tags,omitempty")] tags: [Str]
  #[field(json: "id,string")] id: U64
  home: Point?
  scores: Map[Str, Float]
  data: [Byte]
  #[field(json: "-")] cache: Int
}

#[derive(Json)]
enum Shape {
  Dot
  Circle(Float)
  Rect(w: Float, h: Float)
}

def s(b: [Byte]) -> Str { Str.from_bytes(b) }

#[track_caller]
def check_eq[T](got: T, want: T, what: Str) {
  assert got == want, what
}

#[track_caller]
def check_s(got: Str, want: Str, what: Str) {
  assert got == want, "#{what}:\n  got  #{got}\n  want #{want}"
}

test "marshal" {
  u = User.new(name: "ann", id: 7, home: Point.new(x: 1, y: 2), scores: {"b" => 2.5, "a" => 1.0}, data: [1, 2, 3])
  check_s(s(json.marshal(u, []).unwrap), "{\"name\":\"ann\",\"id\":\"7\",\"home\":{\"x\":1,\"y\":2},\"scores\":{\"b\":2.5,\"a\":1},\"data\":\"AQID\"}", "marshal")
  check_s(s(json.marshal(u, [json.deterministic(true)]).unwrap), "{\"name\":\"ann\",\"id\":\"7\",\"home\":{\"x\":1,\"y\":2},\"scores\":{\"a\":1,\"b\":2.5},\"data\":\"AQID\"}", "deterministic")
  check_s(s(json.marshal(Shape.Rect(w: 1.0, h: 2.0), []).unwrap), "{\"Rect\":{\"w\":1,\"h\":2}}", "enum")
  check_s(s(json.marshal(Shape.Dot, []).unwrap), "\"Dot\"", "unit variant")
}

test "unmarshal" {
  u: User = json.unmarshal("{\"name\":\"bob\",\"age\":3,\"id\":\"9\",\"home\":null,\"scores\":{\"z\":1.5},\"data\":\"AQID\",\"zz\":[1]}".bytes, []).unwrap
  check_eq(u.name, "bob", "name")
  check_eq(u.age, 3, "age")
  check_eq(u.id, 9.as_u64, "id")
  check_eq(u.home.none?, true, "home")
  check_eq(u.data, [1.as_u8, 2, 3], "data")
  r: ~User = json.unmarshal("{\"name\":1}".bytes, [])
  check_s(r.err?.message || "", "json: cannot unmarshal JSON number into Go string within \"/name\"", "type error")
  r2: ~User = json.unmarshal("{\"nope\":1}".bytes, [json.reject_unknown_members(true)])
  check_s(r2.err?.message || "", "json: cannot unmarshal JSON string into Go User: unknown object member name \"nope\"", "unknown")
  sh: Shape = json.unmarshal("{\"Circle\":2.5}".bytes, []).unwrap
  check_eq(sh, Shape.Circle(2.5), "enum")
}
