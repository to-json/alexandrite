# Go's TestMarshal and TestUnmarshal (arshal_test.go), translated by a
# generator: Go's test types become alx types deriving Json (vec_*_test.alx),
# values become alx literals, and the expected JSON and error texts are Go's.
# Cases that need what alx doesn't have (interfaces and `any`, methods such
# as MarshalJSON, time types, unexported-field rules, named basic types in
# error texts, Go funcs in WithMarshalers, v1 compatibility flags) are left
# out; the header of each vector file counts them.

import json "encoding/json/v2"
import "encoding/json/jsontext"
import "encoding/hex"

MIN_INT = -9223372036854775808

def hs(h: Str) -> Str { Str.from_bytes(hex.decode_string(h).unwrap) }
def hb(h: Str) -> [Byte] { hex.decode_string(h).unwrap }

def u8(x: U8) -> U8 { x }
def u16(x: U16) -> U16 { x }
def u32(x: U32) -> U32 { x }
def u64(x: U64) -> U64 { x }
def i8(x: I8) -> I8 { x }
def i16(x: I16) -> I16 { x }
def i32(x: I32) -> I32 { x }

def no_opts -> [jsontext.Options] {
  o: [jsontext.Options] = []
  o
}

def err_text(e: Error?) -> Str {
  if x = e { return x.message }
  ""
}

def check_marshal[T](name: Str, opts: [jsontext.Options], v: T, want: Str, want_err: Str, canon: Bool) {
  r = json.marshal(v, opts)
  got_err = err_text(r.err)
  assert got_err == want_err, "#{name}: error\n  got  #{got_err}\n  want #{want_err}"
  if r.ok? {
    got = Str.from_bytes(r.unwrap)
    if canon {
      x = jsontext.Value.of(got)
      x.canonicalize!([])
      got = x.to_s
    }
    assert got == want, "#{name}: output\n  got  #{got}\n  want #{want}"
  }
}

def check_unmarshal[T](name: Str, opts: [jsontext.Options], input: Str, init: T, want: T, want_err: Str) {
  r = json.unmarshal_into(input.bytes, init, opts)
  got_err = err_text(r.err)
  assert got_err == want_err, "#{name}: error\n  got  #{got_err}\n  want #{want_err}"
  if r.ok? {
    cmp = [json.deterministic(true), jsontext.allow_invalid_utf8(true), jsontext.allow_duplicate_names(true)]
    g = json.marshal(r.unwrap, cmp)
    w = json.marshal(want, cmp)
    gs = g.ok? ? Str.from_bytes(g.unwrap) : err_text(g.err)
    ws = w.ok? ? Str.from_bytes(w.unwrap) : err_text(w.err)
    assert gs == ws, "#{name}: value\n  got  #{gs}\n  want #{ws}"
  }
}
