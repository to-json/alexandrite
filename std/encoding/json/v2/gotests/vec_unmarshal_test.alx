  check_unmarshal("Structs/DuplicateName/NoCase/OverwriteExact", no_opts, "{\"AAA\":\"after\"}", StructNoCaseEmbedTextValue.new(f_a_a_a: "before"), StructNoCaseEmbedTextValue.new(f_a_a_a: "after"), "")
  check_unmarshal("Structs/AmbiguousName/NoCase", no_opts, "{\"aaa\":\"aaa\"}", StructNoCaseEmbedTextValue.new(), StructNoCaseEmbedTextValue.new(), "json: cannot unmarshal JSON string into Go json.structNoCaseEmbedTextValue: ambiguous object member name \"aaa\"")
