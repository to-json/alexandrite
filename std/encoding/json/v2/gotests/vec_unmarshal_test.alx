  check_unmarshal("Maps/DuplicateName/Int/AllowDuplicateNames", [jsontext.allow_duplicate_names(true)], "{\"0\":1,\"-0\":-1}", Top62.new, Top62.new(v: {0 => -1}), "")
  check_unmarshal("Maps/DuplicateName/Int/OverwriteExisting", no_opts, "{\"-0\":-1}", Top62.new(v: {0 => 1}), Top62.new(v: {0 => -1}), "")
  check_unmarshal("Maps/Merge", [jsontext.allow_duplicate_names(true)], "{\"k1\":{\"k2\":\"v2\"},\"k2\":{\"k1\":\"v1\"},\"k2\":{\"k2\":\"v2\"}}", Top64.new(v: {"k1" => { "k1" => "v1" }}), Top64.new(v: {"k1" => { "k1" => "v1", "k2" => "v2" }, "k2" => { "k1" => "v1", "k2" => "v2" }}), "")
  check_unmarshal("Maps/Invalid/Bool", no_opts, "true", Top10.new(v: {"key" => "value"}), Top10.new(v: {"key" => "value"}), "json: cannot unmarshal JSON boolean into Go map[string]string")
  check_unmarshal("Maps/Invalid/String", no_opts, "\"\"", Top10.new(v: {"key" => "value"}), Top10.new(v: {"key" => "value"}), "json: cannot unmarshal JSON string into Go map[string]string")
  check_unmarshal("Maps/Invalid/Number", no_opts, "0", Top10.new(v: {"key" => "value"}), Top10.new(v: {"key" => "value"}), "json: cannot unmarshal JSON number into Go map[string]string")
  check_unmarshal("Maps/Invalid/Array", no_opts, "[]", Top10.new(v: {"key" => "value"}), Top10.new(v: {"key" => "value"}), "json: cannot unmarshal JSON array into Go map[string]string")
  check_unmarshal("Structs/Stringified", no_opts, "{\n\t\"Int\": \"-64\",\n\t\"Uint\": \"64\",\n\t\"Float\": \"3.14159\",\n\t\"PointerInt\": \"-64\",\n\t\"PointerUint\": \"64\",\n\t\"PointerFloat\": \"3.14159\"\n}", StructStringified.new(), StructStringified.new(f_int: -64, f_uint: u64(64), f_float: math.float64frombits(0x400921f9f01b866e), f_pointer_int: -64, f_pointer_uint: u64(64), f_pointer_float: math.float64frombits(0x400921f9f01b866e)), "")
  check_unmarshal("Structs/Stringified/Invalid/Bool", no_opts, "{\"Bool\": \"true\"}", StructStringifiedBool.new(), StructStringifiedBool.new(), "json: cannot unmarshal into Go bool within \"/Bool\": invalid use of `string` tag option")
  check_unmarshal("Structs/Stringified/Invalid/String", no_opts, "{\"String\": \"\\\"hello\\\"\"}", StructStringifiedString.new(), StructStringifiedString.new(), "json: cannot unmarshal into Go string within \"/String\": invalid use of `string` tag option")
  check_unmarshal("Structs/Stringified/Invalid/Bytes", no_opts, "{\"Bytes\": \"AQID\"}", StructStringifiedBytes.new(), StructStringifiedBytes.new(), "json: cannot unmarshal into Go []uint8 within \"/Bytes\": invalid use of `string` tag option")
