  check_unmarshal("Structs/Stringified/Invalid/Slice", no_opts, "{\"Slice\": [\"hello\"]}", StructStringifiedSlice.new(), StructStringifiedSlice.new(), "json: cannot unmarshal into Go []string within \"/Slice\": invalid use of `string` tag option")
  check_unmarshal("Structs/Stringified/Invalid/Array", no_opts, "{\"Array\": [\"hello\"]}", StructStringifiedArray.new(), StructStringifiedArray.new(), "json: cannot unmarshal into Go [1]string within \"/Array\": invalid use of `string` tag option")
  check_unmarshal("Structs/Format/Bytes/Unsupported", no_opts, "{}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON object into Go json.structFormatBytes: Go struct field Base16 has unsupported `format` tag option")
  check_unmarshal("Structs/Format/Bytes", [json.experimental_support_format_tag(true)], "{\n\t\"Base16\": \"0123456789abcdef\",\n\t\"Base32\": \"ABCDEFGHIJKLMNOPQRSTUVWXYZ234567\",\n\t\"Base32Hex\": \"0123456789ABCDEFGHIJKLMNOPQRSTUV\",\n\t\"Base64\": \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\",\n\t\"Base64URL\": \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\",\n\t\"Array\": [1, 2, 3, 4]\n}", StructFormatBytes.new(), StructFormatBytes.new(f_base16: hb("0123456789abcdef"), f_base32: hb("00443214c74254b635cf84653a56d7c675be77df"), f_base32_hex: hb("00443214c74254b635cf84653a56d7c675be77df"), f_base64: hb("00108310518720928b30d38f41149351559761969b71d79f8218a39259a7a29aabb2dbafc31cb3d35db7e39ebbf3dfbf"), f_base64_u_r_l: hb("00108310518720928b30d38f41149351559761969b71d79f8218a39259a7a29aabb2dbafc31cb3d35db7e39ebbf3dfbf"), f_array: hb("01020304")), "")
  check_unmarshal("Structs/Format/ArrayBytes", [json.experimental_support_format_tag(true)], "{\n\t\"Base16\": \"01020304\",\n\t\"Base32\": \"AEBAGBA=\",\n\t\"Base32Hex\": \"0410610=\",\n\t\"Base64\": \"AQIDBA==\",\n\t\"Base64URL\": \"AQIDBA==\",\n\t\"Array\": [1, 2, 3, 4],\n\t\"Default\": \"AQIDBA==\"\n}", StructFormatArrayBytes.new(), StructFormatArrayBytes.new(f_base16: [u8(1), u8(2), u8(3), u8(4)], f_base32: [u8(1), u8(2), u8(3), u8(4)], f_base32_hex: [u8(1), u8(2), u8(3), u8(4)], f_base64: [u8(1), u8(2), u8(3), u8(4)], f_base64_u_r_l: [u8(1), u8(2), u8(3), u8(4)], f_array: [u8(1), u8(2), u8(3), u8(4)], f_default: [u8(1), u8(2), u8(3), u8(4)]), "")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base16/WrongKind", [json.experimental_support_format_tag(true)], "{\"Base16\": [1,2,3,4]}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON array into Go []uint8 within \"/Base16\"")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base16/AllPadding", [json.experimental_support_format_tag(true)], "{\"Base16\": \"====\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base16\": encoding/hex: invalid byte: U+003D '='")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base16/EvenPadding", [json.experimental_support_format_tag(true)], "{\"Base16\": \"0123456789abcdef=\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base16\": encoding/hex: invalid byte: U+003D '='")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base16/OddPadding", [json.experimental_support_format_tag(true)], "{\"Base16\": \"0123456789abcdef0=\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base16\": encoding/hex: invalid byte: U+003D '='")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base16/NonAlphabet/LineFeed", [json.experimental_support_format_tag(true)], "{\"Base16\": \"aa\\naa\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base16\": encoding/hex: invalid byte: U+000A")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base16/NonAlphabet/CarriageReturn", [json.experimental_support_format_tag(true)], "{\"Base16\": \"aa\\raa\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base16\": encoding/hex: invalid byte: U+000D")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base16/NonAlphabet/Space", [json.experimental_support_format_tag(true)], "{\"Base16\": \"aa aa\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base16\": encoding/hex: invalid byte: U+0020 ' '")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base32/Padding", [json.experimental_support_format_tag(true)], "[\n\t\t\t{\"Base32\": \"NA======\"},\n\t\t\t{\"Base32\": \"NBSQ====\"},\n\t\t\t{\"Base32\": \"NBSWY===\"},\n\t\t\t{\"Base32\": \"NBSWY3A=\"},\n\t\t\t{\"Base32\": \"NBSWY3DP\"}\n\t\t]", Top65.new, Top65.new(v: [StructFormatBytes.new(f_base32: hb("68")), StructFormatBytes.new(f_base32: hb("6865")), StructFormatBytes.new(f_base32: hb("68656c")), StructFormatBytes.new(f_base32: hb("68656c6c")), StructFormatBytes.new(f_base32: hb("68656c6c6f"))]), "")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base32/Invalid/NoPadding", [json.experimental_support_format_tag(true)], "[\n\t\t\t\t{\"Base32\": \"NA\"},\n\t\t\t\t{\"Base32\": \"NBSQ\"},\n\t\t\t\t{\"Base32\": \"NBSWY\"},\n\t\t\t\t{\"Base32\": \"NBSWY3A\"},\n\t\t\t\t{\"Base32\": \"NBSWY3DP\"}\n\t\t\t]", Top65.new, Top65.new, "json: cannot unmarshal JSON string into Go []uint8 within \"/0/Base32\": illegal base32 data at input byte 0")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base32/WrongAlphabet", [json.experimental_support_format_tag(true)], "{\"Base32\": \"0123456789ABCDEFGHIJKLMNOPQRSTUV\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base32\": illegal base32 data at input byte 0")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base32Hex/WrongAlphabet", [json.experimental_support_format_tag(true)], "{\"Base32Hex\": \"ABCDEFGHIJKLMNOPQRSTUVWXYZ234567\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base32Hex\": illegal base32 data at input byte 22")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base32/NonAlphabet/LineFeed", [json.experimental_support_format_tag(true)], "{\"Base32\": \"AAAA\\nAAAA\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base32\": illegal character '\\n' at offset 4")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base32/NonAlphabet/CarriageReturn", [json.experimental_support_format_tag(true)], "{\"Base32\": \"AAAA\\rAAAA\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base32\": illegal character '\\r' at offset 4")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base32/NonAlphabet/Space", [json.experimental_support_format_tag(true)], "{\"Base32\": \"AAAA AAAA\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base32\": illegal base32 data at input byte 4")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base64/WrongAlphabet", [json.experimental_support_format_tag(true)], "{\"Base64\": \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base64\": illegal base64 data at input byte 62")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base64URL/WrongAlphabet", [json.experimental_support_format_tag(true)], "{\"Base64URL\": \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base64URL\": illegal base64 data at input byte 62")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base64/NonAlphabet/LineFeed", [json.experimental_support_format_tag(true)], "{\"Base64\": \"aa=\\n=\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base64\": illegal character '\\n' at offset 3")
}

test "unmarshal 4" {
  check_unmarshal("Structs/Format/Bytes/Invalid/Base64/NonAlphabet/CarriageReturn", [json.experimental_support_format_tag(true)], "{\"Base64\": \"aa=\\r=\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base64\": illegal character '\\r' at offset 3")
  check_unmarshal("Structs/Format/Bytes/Invalid/Base64/NonAlphabet/Space", [json.experimental_support_format_tag(true)], "{\"Base64\": \"aa= =\"}", StructFormatBytes.new(), StructFormatBytes.new(), "json: cannot unmarshal JSON string into Go []uint8 within \"/Base64\": illegal base64 data at input byte 2")
  check_unmarshal("Structs/Format/Floats", [json.experimental_support_format_tag(true)], "[\n\t{\"NonFinite\": 3.141592653589793, \"PointerNonFinite\": 3.141592653589793},\n\t{\"NonFinite\": \"-Infinity\", \"PointerNonFinite\": \"-Infinity\"},\n\t{\"NonFinite\": \"Infinity\", \"PointerNonFinite\": \"Infinity\"}\n]", Top14.new, Top14.new(v: [StructFormatFloats.new(f_non_finite: math.float64frombits(0x400921fb54442d18), f_pointer_non_finite: math.float64frombits(0x400921fb54442d18)), StructFormatFloats.new(f_non_finite: math.float64frombits(0xfff0000000000000), f_pointer_non_finite: math.float64frombits(0xfff0000000000000)), StructFormatFloats.new(f_non_finite: math.float64frombits(0x7ff0000000000000), f_pointer_non_finite: math.float64frombits(0x7ff0000000000000))]), "")
  check_unmarshal("Structs/Format/Floats/NaN", [json.experimental_support_format_tag(true)], "{\"NonFinite\": \"NaN\"}", StructFormatFloats.new(), StructFormatFloats.new(), "")
  check_unmarshal("Structs/Format/Floats/Invalid/NaN", [json.experimental_support_format_tag(true)], "{\"NonFinite\": \"nan\"}", StructFormatFloats.new(), StructFormatFloats.new(), "json: cannot unmarshal JSON string into Go float64 within \"/NonFinite\"")
  check_unmarshal("Structs/Format/Floats/Invalid/PositiveInfinity", [json.experimental_support_format_tag(true)], "{\"NonFinite\": \"+Infinity\"}", StructFormatFloats.new(), StructFormatFloats.new(), "json: cannot unmarshal JSON string into Go float64 within \"/NonFinite\"")
  check_unmarshal("Structs/Format/Floats/Invalid/NegativeInfinitySpace", [json.experimental_support_format_tag(true)], "{\"NonFinite\": \"-Infinity \"}", StructFormatFloats.new(), StructFormatFloats.new(), "json: cannot unmarshal JSON string into Go float64 within \"/NonFinite\"")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/Noop", no_opts, "{\"A\":1,\"B\":2}", StructEmbedTextValue.new(), StructEmbedTextValue.new(f_a: 1, f_b: 2), "")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/MergeN1/Nil", no_opts, "{\"A\":1,\"fizz\":\"buzz\",\"B\":2}", StructEmbedTextValue.new(), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("7b2266697a7a223a2262757a7a227d")), f_b: 2), "")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/MergeN1/Empty", no_opts, "{\"A\":1,\"fizz\":\"buzz\",\"B\":2}", StructEmbedTextValue.new(f_x: jsontext.Value.new(raw: hb(""))), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("7b2266697a7a223a2262757a7a227d")), f_b: 2), "")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/MergeN1/Whitespace", no_opts, "{\"A\":1,\"fizz\":\"buzz\",\"B\":2}", StructEmbedTextValue.new(f_x: jsontext.Value.new(raw: hb("0a0d0920"))), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb(""))), "json: cannot unmarshal JSON string into Go jsontext.Value within \"/fizz\": embedded raw value must be a JSON object")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/MergeN1/Null", no_opts, "{\"A\":1,\"fizz\":\"buzz\",\"B\":2}", StructEmbedTextValue.new(f_x: jsontext.Value.new(raw: hb("6e756c6c"))), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("6e756c6c"))), "json: cannot unmarshal JSON string into Go jsontext.Value within \"/fizz\": embedded raw value must be a JSON object")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/MergeN1/ObjectN0", no_opts, "{\"A\":1,\"fizz\":\"buzz\",\"B\":2}", StructEmbedTextValue.new(f_x: jsontext.Value.new(raw: hb("207b207d20"))), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("207b2266697a7a223a2262757a7a227d")), f_b: 2), "")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/MergeN2/ObjectN1", no_opts, "{\"A\":1,\"fizz\":\"buzz\",\"B\":2,\"foo\": [ 1 , 2 , 3 ]}", StructEmbedTextValue.new(f_x: jsontext.Value.new(raw: hb("207b202266697a7a22203a202262757a7a22207d20"))), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("207b202266697a7a22203a202262757a7a222c2266697a7a223a2262757a7a222c22666f6f223a5b2031202c2032202c2033205d7d")), f_b: 2), "")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/Merge/EndObject", no_opts, "{\"A\":1,\"fizz\":\"buzz\",\"B\":2}", StructEmbedTextValue.new(f_x: jsontext.Value.new(raw: hb("207d20"))), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("2c2266697a7a223a2262757a7a227d")), f_b: 2), "")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/MergeInvalidValue", no_opts, "{\"A\":1,\"fizz\":nil,\"B\":2}", StructEmbedTextValue.new(), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("7b2266697a7a223a"))), "jsontext: invalid character 'i' in literal null (expecting 'u') within \"/fizz\" after offset 15")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/CaseSensitive", no_opts, "{\"A\":1,\"fizz\":\"buzz\",\"B\":2,\"a\":3}", StructEmbedTextValue.new(), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("7b2266697a7a223a2262757a7a222c2261223a337d")), f_b: 2), "")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/RejectDuplicateNames", [jsontext.allow_duplicate_names(false)], "{\"A\":1,\"fizz\":\"buzz\",\"B\":2,\"fizz\":\"buzz\"}", StructEmbedTextValue.new(), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("7b2266697a7a223a2262757a7a227d")), f_b: 2), "jsontext: duplicate object member name \"fizz\"")
  check_unmarshal("Structs/EmbeddedFallback/TextValue/AllowDuplicateNames", [jsontext.allow_duplicate_names(true)], "{\"A\":1,\"fizz\":\"buzz\",\"B\":2,\"fizz\":\"buzz\"}", StructEmbedTextValue.new(), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("7b2266697a7a223a2262757a7a222c2266697a7a223a2262757a7a227d")), f_b: 2), "")
  check_unmarshal("Structs/EmbeddedFallback/MapStringInt", no_opts, "{\"zero\": 0, \"one\": 1, \"two\": 2}", StructEmbedMapStringInt.new(), StructEmbedMapStringInt.new(f_x: {"one" => 1, "two" => 2, "zero" => 0}), "")
  check_unmarshal("Structs/EmbeddedFallback/MapStringInt/Null", no_opts, "{\"zero\": 0, \"one\": null, \"two\": 2}", StructEmbedMapStringInt.new(), StructEmbedMapStringInt.new(f_x: {"one" => 0, "two" => 2, "zero" => 0}), "")
  check_unmarshal("Structs/EmbeddedFallback/MapStringInt/Invalid", no_opts, "{\"zero\": 0, \"one\": {}, \"two\": 2}", StructEmbedMapStringInt.new(), StructEmbedMapStringInt.new(f_x: {"one" => 0, "zero" => 0}), "json: cannot unmarshal JSON object into Go int within \"/one\"")
  check_unmarshal("Structs/EmbeddedFallback/MapStringInt/StringifiedNumbers", [json.stringify_numbers(true)], "{\"zero\": \"0\", \"one\": \"1\", \"two\": \"2\"}", StructEmbedMapStringInt.new(), StructEmbedMapStringInt.new(f_x: {"one" => 1, "two" => 2, "zero" => 0}), "")
  check_unmarshal("Structs/EmbeddedFallback/MapNamedStringInt", no_opts, "{\"zero\": 0, \"one\": 1, \"two\": 2}", StructEmbedMapNamedStringInt.new(), StructEmbedMapNamedStringInt.new(f_x: {"one" => 1, "two" => 2, "zero" => 0}), "")
  check_unmarshal("Structs/EmbeddedFallback/MapNamedStringInt/Null", no_opts, "{\"zero\": 0, \"one\": null, \"two\": 2}", StructEmbedMapNamedStringInt.new(), StructEmbedMapNamedStringInt.new(f_x: {"one" => 0, "two" => 2, "zero" => 0}), "")
  check_unmarshal("Structs/EmbeddedFallback/RejectUnknownMembers", [json.reject_unknown_members(true)], "{\"A\":1,\"fizz\":\"buzz\",\"B\":2}", StructEmbedTextValue.new(), StructEmbedTextValue.new(f_a: 1, f_x: jsontext.Value.new(raw: hb("7b2266697a7a223a2262757a7a227d")), f_b: 2), "")
  check_unmarshal("Structs/UnexportedIgnored", no_opts, "{\"ignored\":\"unused\"}", StructUnexportedIgnored.new(), StructUnexportedIgnored.new(), "")
  check_unmarshal("Structs/IgnoredUnexportedEmbedded", no_opts, "{\"namedString\":\"unused\"}", StructIgnoredUnexportedEmbedded.new(), StructIgnoredUnexportedEmbedded.new(), "")
  check_unmarshal("Structs/NoCase/Exact", no_opts, "{\"Aaa\":\"Aaa\",\"AA_A\":\"AA_A\",\"AaA\":\"AaA\",\"AAa\":\"AAa\",\"AAA\":\"AAA\"}", StructNoCase.new(), StructNoCase.new(f_aaa: "Aaa", f_a_a__a: "AA_A", f_aa_a: "AaA", f_a_aa: "AAa", f_a_a_a: "AAA"), "")
