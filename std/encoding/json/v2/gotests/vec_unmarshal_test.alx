  check_unmarshal("Structs/NoCase/Merge/AllowDuplicateNames/Ambiguous", [jsontext.allow_duplicate_names(true)], "{\"AaA\":\"AaA\",\"aaa\":\"aaa\",\"aAa\":\"aAa\"}", StructNoCase.new(), StructNoCase.new(f_aa_a: "AaA"), "json: cannot unmarshal JSON string into Go json.structNoCase: ambiguous object member name \"aaa\"")
  check_unmarshal("Structs/NoCase/Merge/RejectDuplicateNames/Ambiguous", [jsontext.allow_duplicate_names(false)], "{\"AaA\":\"AaA\",\"aaa\":\"aaa\"}", StructNoCase.new(), StructNoCase.new(f_aa_a: "AaA"), "json: cannot unmarshal JSON string into Go json.structNoCase: ambiguous object member name \"aaa\"")
  check_unmarshal("Structs/CaseSensitive", no_opts, "{\"BOOL\": true, \"STRING\": \"hello\", \"BYTES\": \"AQID\", \"INT\": -64, \"UINT\": 64, \"FLOAT\": 3.14159}", StructScalars.new(), StructScalars.new(), "")
