  check_unmarshal("Floats/Invalid/Bool", no_opts, "true", Top6.new(v: math.float64frombits(0x405028f5c28f5c29)), Top6.new(v: math.float64frombits(0x405028f5c28f5c29)), "json: cannot unmarshal JSON boolean into Go float64")
  check_unmarshal("Floats/Invalid/String", no_opts, "\"0\"", Top6.new(v: math.float64frombits(0x405028f5c28f5c29)), Top6.new(v: math.float64frombits(0x405028f5c28f5c29)), "json: cannot unmarshal JSON string into Go float64")
  check_unmarshal("Floats/Invalid/Object", no_opts, "{}", Top6.new(v: math.float64frombits(0x405028f5c28f5c29)), Top6.new(v: math.float64frombits(0x405028f5c28f5c29)), "json: cannot unmarshal JSON object into Go float64")
  check_unmarshal("Floats/Invalid/Array", no_opts, "[]", Top6.new(v: math.float64frombits(0x405028f5c28f5c29)), Top6.new(v: math.float64frombits(0x405028f5c28f5c29)), "json: cannot unmarshal JSON array into Go float64")
  check_unmarshal("Maps/Null", no_opts, "null", Top10.new(v: {"key" => "value"}), Top10.new, "")
}

test "unmarshal 3" {
  check_unmarshal("Maps/InvalidKey/Bool", no_opts, "{\"true\":\"false\"}", Top61.new, Top61.new, "json: cannot unmarshal JSON string into Go bool within \"/true\"")
  check_unmarshal("Maps/ValidKey/Int", no_opts, "{\"0\":0,\"-1\":1,\"2\":2,\"-3\":3}", Top62.new, Top62.new(v: {-1 => 1, -3 => 3, 0 => 0, 2 => 2}), "")
  check_unmarshal("Maps/ValidKey/NamedInt", no_opts, "{\"0\":0,\"-1\":1,\"2\":2,\"-3\":3}", Top62.new, Top62.new(v: {-1 => 1, -3 => 3, 0 => 0, 2 => 2}), "")
  check_unmarshal("Maps/ValidKey/Uint", no_opts, "{\"0\":0,\"1\":1,\"2\":2,\"3\":3}", Top63.new, Top63.new(v: {u64(0) => u64(0), u64(1) => u64(1), u64(2) => u64(2), u64(3) => u64(3)}), "")
