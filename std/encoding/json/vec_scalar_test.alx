}

test "marshal scalars 7" {
  assert_eq enc_str_raw("<\n"), "\"<\\n\""
  assert_eq dec_str("\"\\u003c\\n\""), "<\n"
  assert_eq enc_str("a\ta"), "\"a\\ta\""
  assert_eq enc_str_raw("a\ta"), "\"a\\ta\""
  assert_eq dec_str("\"a\\ta\""), "a\ta"
  assert_eq enc_str("a\t😀"), "\"a\\t😀\""
  assert_eq enc_str_raw("a\t😀"), "\"a\\t😀\""
  assert_eq dec_str("\"a\\t😀\""), "a\t😀"
  assert_eq enc_str(Str.from_bytes([226, 92, 10])), "\"�\\\\\\n\""
  assert_eq enc_str_raw(Str.from_bytes([226, 92, 10])), "\"�\\\\\\n\""
  assert_eq dec_str("\"�\\\\\\n\""), "�\\\n"
  assert_eq enc_str("\ta"), "\"\\ta\""
  assert_eq enc_str_raw("\ta"), "\"\\ta\""
  assert_eq dec_str("\"\\ta\""), "\ta"
  assert_eq enc_str("<\\<\\"), "\"\\u003c\\\\\\u003c\\\\\""
  assert_eq enc_str_raw("<\\<\\"), "\"<\\\\<\\\\\""
  assert_eq dec_str("\"\\u003c\\\\\\u003c\\\\\""), "<\\<\\"
  assert_eq enc_str("\x1fé&\""), "\"\\u001fé\\u0026\\\"\""
  assert_eq enc_str_raw("\x1fé&\""), "\"\\u001fé&\\\"\""
  assert_eq dec_str("\"\\u001fé\\u0026\\\"\""), "\x1fé&\""
  assert_eq enc_str(Str.from_bytes([32, 128, 255, 255])), "\" ���\""
  assert_eq enc_str_raw(Str.from_bytes([32, 128, 255, 255])), "\" ���\""
  assert_eq dec_str("\" ���\""), " ���"
  assert_eq enc_str("\u2028"), "\"\\u2028\""
  assert_eq enc_str_raw("\u2028"), "\"\\u2028\""
  assert_eq dec_str("\"\\u2028\""), "\u2028"
  assert_eq enc_str("&\t\\"), "\"\\u0026\\t\\\\\""
  assert_eq enc_str_raw("&\t\\"), "\"&\\t\\\\\""
  assert_eq dec_str("\"\\u0026\\t\\\\\""), "&\t\\"
  assert_eq enc_str(""), "\"\""
  assert_eq enc_str_raw(""), "\"\""
  assert_eq dec_str("\"\""), ""
  assert_eq enc_str(""), "\"\""
  assert_eq enc_str_raw(""), "\"\""
  assert_eq dec_str("\"\""), ""
  assert_eq enc_str(Str.from_bytes([195, 169, 226, 195, 169])), "\"é�é\""
  assert_eq enc_str_raw(Str.from_bytes([195, 169, 226, 195, 169])), "\"é�é\""
  assert_eq dec_str("\"é�é\""), "é�é"
  assert_eq enc_str(Str.from_bytes([31, 128, 34])), "\"\\u001f�\\\"\""
  assert_eq enc_str_raw(Str.from_bytes([31, 128, 34])), "\"\\u001f�\\\"\""
  assert_eq dec_str("\"\\u001f�\\\"\""), "\x1f�\""
  assert_eq enc_str("&é\n"), "\"\\u0026é\\n\""
  assert_eq enc_str_raw("&é\n"), "\"&é\\n\""
  assert_eq dec_str("\"\\u0026é\\n\""), "&é\n"
  assert_eq enc_str("\x1f\n\x7fa"), "\"\\u001f\\n\x7fa\""
  assert_eq enc_str_raw("\x1f\n\x7fa"), "\"\\u001f\\n\x7fa\""
  assert_eq dec_str("\"\\u001f\\n\x7fa\""), "\x1f\n\x7fa"
  assert_eq enc_str(""), "\"\""
  assert_eq enc_str_raw(""), "\"\""
  assert_eq dec_str("\"\""), ""
  assert_eq enc_str(Str.from_bytes([226, 226, 128, 168, 226])), "\"�\\u2028�\""
  assert_eq enc_str_raw(Str.from_bytes([226, 226, 128, 168, 226])), "\"�\\u2028�\""
  assert_eq dec_str("\"�\\u2028�\""), "�\u2028�"
  assert_eq dec_str("\"A\""), "A"
  assert_eq dec_str("\"é\""), "é"
  assert_eq dec_str("\"😀\""), "😀"
  assert_eq dec_str("\"\\ud83d\""), "�"
  assert_eq dec_str("\"\\ude00\""), "�"
  assert_eq dec_str("\"\\ud83dx\""), "�x"
  assert_eq dec_str("\"\\ud83dA\""), "�A"
  assert_eq dec_str("\"\\ud83d\\ud83d\""), "��"
  assert_eq dec_str("\"\\uDFFF\\uD800\""), "��"
  assert_eq dec_str("\"\\/\\b\\f\\n\\r\\t\\\"\\\\\""), "/\x08\x0c\n\r\t\"\\"
  assert_eq dec_str("\"\\u0000\""), "\x00"
  assert_eq dec_str(Str.from_bytes([34, 255, 34])), "�"
  assert_eq dec_str(Str.from_bytes([34, 97, 195, 34])), "a�"
  assert_eq dec_str(Str.from_bytes([34, 237, 160, 128, 34])), "���"
  assert_eq dec_str("\"𝄞\""), "𝄞"
  assert_eq dec_str("\"￿\""), "￿"
  assert_eq enc_float(0.0), "0"
  assert_eq dec_float("0"), 0.0
  assert_eq enc_float(math.float64frombits(9223372036854775808)), "-0"
  assert_eq dec_float("-0"), math.float64frombits(9223372036854775808)
  assert_eq enc_float(1.0), "1"
  assert_eq dec_float("1"), 1.0
  assert_eq enc_float(-1.0), "-1"
  assert_eq dec_float("-1"), -1.0
  assert_eq enc_float(math.float64frombits(4591870180066957722)), "0.1"
  assert_eq dec_float("0.1"), math.float64frombits(4591870180066957722)
  assert_eq enc_float(math.float64frombits(4596373779694328218)), "0.2"
  assert_eq dec_float("0.2"), math.float64frombits(4596373779694328218)
  assert_eq enc_float(math.float64frombits(4609434218613702656)), "1.5"
  assert_eq dec_float("1.5"), math.float64frombits(4609434218613702656)
  assert_eq enc_float(100.0), "100"
  assert_eq dec_float("100"), 100.0
  assert_eq enc_float(1000000.0), "1000000"
  assert_eq dec_float("1000000"), 1000000.0
  assert_eq enc_float(math.float64frombits(4906019910204099648)), "100000000000000000000"
  assert_eq dec_float("100000000000000000000"), math.float64frombits(4906019910204099648)
  assert_eq enc_float(math.float64frombits(4921056587992461136)), "1e+21"
  assert_eq dec_float("1e+21"), math.float64frombits(4921056587992461136)
  assert_eq enc_float(math.float64frombits(4517329193108106637)), "0.000001"
  assert_eq dec_float("0.000001"), math.float64frombits(4517329193108106637)
  assert_eq enc_float(math.float64frombits(4502148214488346440)), "1e-7"
  assert_eq dec_float("1e-7"), math.float64frombits(4502148214488346440)
  assert_eq enc_float(123456789.0), "123456789"
  assert_eq dec_float("123456789"), 123456789.0
  assert_eq enc_float(math.float64frombits(9218868437227405311)), "1.7976931348623157e+308"
  assert_eq dec_float("1.7976931348623157e+308"), math.float64frombits(9218868437227405311)
  assert_eq enc_float(math.float64frombits(1)), "5e-324"
}

