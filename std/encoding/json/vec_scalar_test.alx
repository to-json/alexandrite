  assert_eq dec_ints("{\"i16\":-0.0}"), "error: json: cannot unmarshal number -0.0 into Go struct field Ints.i16 of type I16 @11"
  assert_eq dec_ints("{\"i32\":-0.0}"), "error: json: cannot unmarshal number -0.0 into Go struct field Ints.i32 of type I32 @11"
  assert_eq dec_ints("{\"u8\":-0.0}"), "error: json: cannot unmarshal number -0.0 into Go struct field Ints.u8 of type U8 @10"
}

test "marshal scalars 14" {
