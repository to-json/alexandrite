  assert_eq dec_ints("{\"i32\":18446744073709551615}"), "error: json: cannot unmarshal number 18446744073709551615 into Go struct field Ints.i32 of type I32 @27"
  assert_eq dec_ints("{\"u8\":18446744073709551615}"), "error: json: cannot unmarshal number 18446744073709551615 into Go struct field Ints.u8 of type U8 @26"
  assert_eq dec_ints("{\"u16\":18446744073709551615}"), "error: json: cannot unmarshal number 18446744073709551615 into Go struct field Ints.u16 of type U16 @27"
  assert_eq dec_ints("{\"u32\":18446744073709551615}"), "error: json: cannot unmarshal number 18446744073709551615 into Go struct field Ints.u32 of type U32 @27"
  assert_eq dec_ints("{\"u64\":18446744073709551615}"), "{\"i\":0,\"i8\":0,\"i16\":0,\"i32\":0,\"u8\":0,\"u16\":0,\"u32\":0,\"u64\":18446744073709551615,\"f\":0}"
  assert_eq dec_ints("{\"f\":18446744073709551615}"), "{\"i\":0,\"i8\":0,\"i16\":0,\"i32\":0,\"u8\":0,\"u16\":0,\"u32\":0,\"u64\":0,\"f\":18446744073709552000}"
  assert_eq dec_ints("{\"i\":18446744073709551616}"), "error: json: cannot unmarshal number 18446744073709551616 into Go struct field Ints.i of type Int @25"
  assert_eq dec_ints("{\"i8\":18446744073709551616}"), "error: json: cannot unmarshal number 18446744073709551616 into Go struct field Ints.i8 of type I8 @26"
  assert_eq dec_ints("{\"i16\":18446744073709551616}"), "error: json: cannot unmarshal number 18446744073709551616 into Go struct field Ints.i16 of type I16 @27"
  assert_eq dec_ints("{\"i32\":18446744073709551616}"), "error: json: cannot unmarshal number 18446744073709551616 into Go struct field Ints.i32 of type I32 @27"
  assert_eq dec_ints("{\"u8\":18446744073709551616}"), "error: json: cannot unmarshal number 18446744073709551616 into Go struct field Ints.u8 of type U8 @26"
  assert_eq dec_ints("{\"u16\":18446744073709551616}"), "error: json: cannot unmarshal number 18446744073709551616 into Go struct field Ints.u16 of type U16 @27"
  assert_eq dec_ints("{\"u32\":18446744073709551616}"), "error: json: cannot unmarshal number 18446744073709551616 into Go struct field Ints.u32 of type U32 @27"
}

test "marshal scalars 16" {
  assert_eq dec_ints("{\"u64\":18446744073709551616}"), "error: json: cannot unmarshal number 18446744073709551616 into Go struct field Ints.u64 of type U64 @27"
