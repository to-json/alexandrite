  assert_eq valid("{\"a\":[x,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[,,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @7"
  assert_eq valid("{\"a\":[,,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[],-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '-' looking for beginning of object key string @9"
  assert_eq valid("{\"a\":[],-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[},-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' looking for beginning of value @7"
  assert_eq valid("{\"a\":[},-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[:,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of value @7"
  assert_eq valid("{\"a\":[:,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[\",-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 's' after array element @33"
  assert_eq valid("{\"a\":[\",-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[\",-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 's' after array value @33"
  assert_eq syn("{\"a\":[1"), "unexpected end of JSON input @7"
  assert_eq valid("{\"a\":[1"), false
  assert_eq syn("{\"a\":[1x-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array element @8"
  assert_eq valid("{\"a\":[1x-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1x-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array value @8"
  assert_eq syn("{\"a\":[1]-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '-' after object key:value pair @9"
  assert_eq valid("{\"a\":[1]-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1}-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array element @8"
  assert_eq valid("{\"a\":[1}-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1}-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array value @8"
  assert_eq syn("{\"a\":[1:-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array element @8"
  assert_eq valid("{\"a\":[1:-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1:-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array value @8"
  assert_eq syn("{\"a\":[1\"-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array element @8"
  assert_eq valid("{\"a\":[1\"-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1\"-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array value @8"
  assert_eq syn("{\"a\":[1,"), "unexpected end of JSON input @8"
  assert_eq valid("{\"a\":[1,"), false
  assert_eq syn("{\"a\":[1,x2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of value @9"
  assert_eq valid("{\"a\":[1,x2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
}

test "syntax errors 13" {
  assert_eq syn("{\"a\":[1,,2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @9"
  assert_eq valid("{\"a\":[1,,2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,]2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of value @9"
  assert_eq valid("{\"a\":[1,]2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,}2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' looking for beginning of value @9"
  assert_eq valid("{\"a\":[1,}2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,:2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of value @9"
  assert_eq valid("{\"a\":[1,:2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,\"2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 's' after array element @33"
  assert_eq valid("{\"a\":[1,\"2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,\"2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 's' after array value @33"
  assert_eq syn("{\"a\":[1,-"), "unexpected end of JSON input @8"
  assert_eq valid("{\"a\":[1,-"), false
  assert_eq syn("{\"a\":[1,-x.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' in numeric literal @10"
  assert_eq valid("{\"a\":[1,-x.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-,.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' in numeric literal @10"
  assert_eq valid("{\"a\":[1,-,.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-].5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' in numeric literal @10"
  assert_eq valid("{\"a\":[1,-].5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-}.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' in numeric literal @10"
  assert_eq valid("{\"a\":[1,-}.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-:.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' in numeric literal @10"
  assert_eq valid("{\"a\":[1,-:.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-\".5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' in numeric literal @10"
  assert_eq valid("{\"a\":[1,-\".5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2"), "unexpected end of JSON input @10"
  assert_eq valid("{\"a\":[1,-2"), false
  assert_eq syn("{\"a\":[1,-2x5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array element @11"
  assert_eq valid("{\"a\":[1,-2x5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2x5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array value @11"
  assert_eq syn("{\"a\":[1,-2,5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2,5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), true
