  assert_eq valid("{\"a\":[1,-2.5e3,true,false,}ull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,:ull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of value @27"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,:ull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,\"ull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 's' after array element @33"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,\"ull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,n"), "unexpected end of JSON input @27"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,n"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nxll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' in literal null (expecting 'u') @28"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nxll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,n,ll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' in literal null (expecting 'u') @28"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,n,ll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,n]ll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' in literal null (expecting 'u') @28"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,n]ll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,n}ll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' in literal null (expecting 'u') @28"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,n}ll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,n:ll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' in literal null (expecting 'u') @28"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,n:ll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,n\"ll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' in literal null (expecting 'u') @28"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,n\"ll,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nu"), "unexpected end of JSON input @28"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nu"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nuxl,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' in literal null (expecting 'l') @29"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nuxl,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nu,l,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' in literal null (expecting 'l') @29"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nu,l,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nu]l,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' in literal null (expecting 'l') @29"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nu]l,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nu}l,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' in literal null (expecting 'l') @29"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nu}l,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nu:l,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' in literal null (expecting 'l') @29"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nu:l,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nu\"l,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' in literal null (expecting 'l') @29"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nu\"l,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nul"), "unexpected end of JSON input @29"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nul"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nulx,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' in literal null (expecting 'l') @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nulx,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nul,,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' in literal null (expecting 'l') @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nul,,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nul],\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' in literal null (expecting 'l') @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nul],\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nul},\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' in literal null (expecting 'l') @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nul},\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nul:,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' in literal null (expecting 'l') @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nul:,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nul\",\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' in literal null (expecting 'l') @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nul\",\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null"), "unexpected end of JSON input @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null"), false
}

test "syntax errors 14" {
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nullx\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array element @31"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nullx\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null]\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after object key:value pair @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null]\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null}\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array element @31"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null}\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null:\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array element @31"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null:\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null\"\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array element @31"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null\"\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,"), "unexpected end of JSON input @31"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,xs\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of value @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,xs\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,,s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,,s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,]s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of value @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,]s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,}s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' looking for beginning of value @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,}s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,:s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of value @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,:s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\""), "unexpected end of JSON input @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\""), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"x\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"x\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\",\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\",\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"]\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"]\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"}\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"}\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\":\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
