  assert_eq syn("].::,ee"), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("].::,ee"), false
  assert_eq syn("xe\" a"), "invalid character 'x' looking for beginning of value @1"
  assert_eq valid("xe\" a"), false
  assert_eq syn("\"{\"k\"nx1"), "invalid character 'k' after top-level value @4"
  assert_eq valid("\"{\"k\"nx1"), false
  assert_eq syn("eenull"), "invalid character 'e' looking for beginning of value @1"
  assert_eq valid("eenull"), false
  assert_eq syn("f]\\0"), "invalid character ']' in literal false (expecting 'a') @2"
  assert_eq valid("f]\\0"), false
  assert_eq syn(" .0,,a"), "invalid character '.' looking for beginning of value @2"
  assert_eq valid(" .0,,a"), false
  assert_eq syn("\\[ue"), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\[ue"), false
  assert_eq syn("null\":"), "invalid character '\"' after top-level value @5"
  assert_eq valid("null\":"), false
  assert_eq syn("\\:a:u\"k\"."), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\:a:u\"k\"."), false
  assert_eq syn("nf,f\"k\""), "invalid character 'f' in literal null (expecting 'u') @2"
  assert_eq valid("nf,f\"k\""), false
  assert_eq syn("}xnx"), "invalid character '}' looking for beginning of value @1"
  assert_eq valid("}xnx"), false
  assert_eq syn("ax0[1n"), "invalid character 'a' looking for beginning of value @1"
  assert_eq valid("ax0[1n"), false
  assert_eq syn("x[ [1]0true"), "invalid character 'x' looking for beginning of value @1"
  assert_eq valid("x[ [1]0true"), false
  assert_eq syn("\"},"), "unexpected end of JSON input @3"
  assert_eq valid("\"},"), false
  assert_eq syn("tt11:[["), "invalid character 't' in literal true (expecting 'r') @2"
  assert_eq valid("tt11:[["), false
  assert_eq syn("e\"0auf0"), "invalid character 'e' looking for beginning of value @1"
  assert_eq valid("e\"0auf0"), false
  assert_eq syn("\"k\"null:"), "invalid character 'n' after top-level value @4"
  assert_eq valid("\"k\"null:"), false
  assert_eq syn(".1] "), "invalid character '.' looking for beginning of value @1"
  assert_eq valid(".1] "), false
  assert_eq syn("e{"), "invalid character 'e' looking for beginning of value @1"
  assert_eq valid("e{"), false
  assert_eq syn("-\"k\"ft{u"), "invalid character '\"' in numeric literal @2"
  assert_eq valid("-\"k\"ft{u"), false
  assert_eq syn("\\{{"), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\{{"), false
  assert_eq syn("trueax0t:null"), "invalid character 'a' after top-level value @5"
  assert_eq valid("trueax0t:null"), false
  assert_eq syn("{[\"k\"null"), "invalid character '[' looking for beginning of object key string @2"
  assert_eq valid("{[\"k\"null"), false
  assert_eq syn("\"{-}a[\"k\""), "invalid character 'k' after top-level value @8"
  assert_eq valid("\"{-}a[\"k\""), false
  assert_eq syn("}]\\-,-"), "invalid character '}' looking for beginning of value @1"
  assert_eq valid("}]\\-,-"), false
  assert_eq syn("true 0n"), "invalid character '0' after top-level value @6"
  assert_eq valid("true 0n"), false
  assert_eq syn("\\null:null-"), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\null:null-"), false
  assert_eq syn("\\fx["), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\fx["), false
  assert_eq syn("ua.uatrue"), "invalid character 'u' looking for beginning of value @1"
  assert_eq valid("ua.uatrue"), false
  assert_eq syn("nnx0.nulla"), "invalid character 'n' in literal null (expecting 'u') @2"
  assert_eq valid("nnx0.nulla"), false
  assert_eq syn("{t"), "invalid character 't' looking for beginning of object key string @2"
  assert_eq valid("{t"), false
  assert_eq syn(" .un "), "invalid character '.' looking for beginning of value @2"
  assert_eq valid(" .un "), false
  assert_eq syn(".n\"k\"xnullt"), "invalid character '.' looking for beginning of value @1"
  assert_eq valid(".n\"k\"xnullt"), false
  assert_eq syn("ef]\"}ntf"), "invalid character 'e' looking for beginning of value @1"
  assert_eq valid("ef]\"}ntf"), false
  assert_eq syn("f\"k\"}[:]n\""), "invalid character '\"' in literal false (expecting 'a') @2"
  assert_eq valid("f\"k\"}[:]n\""), false
  assert_eq syn("]u,u]\"k\"{"), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]u,u]\"k\"{"), false
  assert_eq syn("]{0"), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]{0"), false
  assert_eq syn("true{"), "invalid character '{' after top-level value @5"
  assert_eq valid("true{"), false
  assert_eq syn(":nullnull,,"), "invalid character ':' looking for beginning of value @1"
  assert_eq valid(":nullnull,,"), false
  assert_eq syn("-f{true[00,"), "invalid character 'f' in numeric literal @2"
  assert_eq valid("-f{true[00,"), false
  assert_eq syn("null-{"), "invalid character '-' after top-level value @5"
  assert_eq valid("null-{"), false
}

test "syntax errors 12" {
  assert_eq syn("x\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of value @1"
  assert_eq valid("x\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn(",\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @1"
  assert_eq valid(",\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("]\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("}\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' looking for beginning of value @1"
  assert_eq valid("}\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn(":\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of value @1"
  assert_eq valid(":\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("\"\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'a' after top-level value @3"
  assert_eq valid("\"\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{xa\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of object key string @2"
  assert_eq valid("{xa\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{,a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of object key string @2"
  assert_eq valid("{,a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{]a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of object key string @2"
  assert_eq valid("{]a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{}a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'a' after top-level value @3"
  assert_eq valid("{}a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{:a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of object key string @2"
  assert_eq valid("{:a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\""), "unexpected end of JSON input @2"
  assert_eq valid("{\""), false
  assert_eq syn("{\"x\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"x\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\",\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\",\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), true
