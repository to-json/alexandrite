  assert_eq syn("{\"a\":[1,-2.5e3,true,fals},null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' in literal false (expecting 'e') @25"
  assert_eq valid("{\"a\":[1,-2.5e3,true,fals},null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,fals:,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' in literal false (expecting 'e') @25"
