  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b]:{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b}:{\"c\":{}},\"d\":[]}"), "invalid character 'c' after object key @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b}:{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b::{\"c\":{}},\"d\":[]}"), "invalid character 'c' after object key @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b::{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\""), "unexpected end of JSON input @43"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\""), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"x{\"c\":{}},\"d\":[]}"), "invalid character 'x' after object key @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"x{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\",{\"c\":{}},\"d\":[]}"), "invalid character ',' after object key @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\",{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"]{\"c\":{}},\"d\":[]}"), "invalid character ']' after object key @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"]{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"}{\"c\":{}},\"d\":[]}"), "invalid character '}' after object key @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"}{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"\"{\"c\":{}},\"d\":[]}"), "invalid character '\"' after object key @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"\"{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":"), "unexpected end of JSON input @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":x\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of value @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":x\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":,\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":,\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":]\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of value @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":]\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":}\"c\":{}},\"d\":[]}"), "invalid character '}' looking for beginning of value @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":}\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"::\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of value @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"::\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":\"\"c\":{}},\"d\":[]}"), "invalid character 'c' after object key:value pair @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":\"\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{"), "unexpected end of JSON input @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{xc\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of object key string @46"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{xc\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{,c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of object key string @46"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{,c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{]c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of object key string @46"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{]c\":{}},\"d\":[]}"), false
}

test "syntax errors 15" {
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{}c\":{}},\"d\":[]}"), "invalid character 'c' after object key:value pair @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{}c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{:c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of object key string @46"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{:c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\""), "unexpected end of JSON input @46"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\""), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"x\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"x\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\",\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\",\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"]\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"]\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"}\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"}\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\":\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\":\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"\"\":{}},\"d\":[]}"), "invalid character '\"' after object key @48"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"\"\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c"), "unexpected end of JSON input @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"cx:{}},\"d\":[]}"), "invalid character 'd' after object key @55"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"cx:{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c,:{}},\"d\":[]}"), "invalid character 'd' after object key @55"
