  assert_eq valid("{\"a\":x1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":,1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @6"
