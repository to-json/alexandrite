  assert_eq syn_compact("{\"a\":[1,-2.5\"3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array value @13"
  assert_eq syn("{\"a\":[1,-2.5e"), "unexpected end of JSON input @8"
