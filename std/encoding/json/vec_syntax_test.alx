  assert_eq valid("{\"a\":[1,-2.5e:,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e\",true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' in numeric literal @14"
  assert_eq valid("{\"a\":[1,-2.5e\",true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3"), "unexpected end of JSON input @14"
  assert_eq valid("{\"a\":[1,-2.5e3"), false
  assert_eq syn("{\"a\":[1,-2.5e3xtrue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array element @15"
  assert_eq valid("{\"a\":[1,-2.5e3xtrue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3xtrue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array value @15"
  assert_eq syn("{\"a\":[1,-2.5e3]true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 't' after object key:value pair @16"
  assert_eq valid("{\"a\":[1,-2.5e3]true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3}true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array element @15"
  assert_eq valid("{\"a\":[1,-2.5e3}true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3}true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array value @15"
  assert_eq syn("{\"a\":[1,-2.5e3:true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array element @15"
  assert_eq valid("{\"a\":[1,-2.5e3:true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3:true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array value @15"
  assert_eq syn("{\"a\":[1,-2.5e3\"true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array element @15"
  assert_eq valid("{\"a\":[1,-2.5e3\"true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3\"true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array value @15"
  assert_eq syn("{\"a\":[1,-2.5e3,"), "unexpected end of JSON input @15"
  assert_eq valid("{\"a\":[1,-2.5e3,"), false
  assert_eq syn("{\"a\":[1,-2.5e3,xrue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of value @16"
  assert_eq valid("{\"a\":[1,-2.5e3,xrue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,,rue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @16"
  assert_eq valid("{\"a\":[1,-2.5e3,,rue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,]rue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of value @16"
  assert_eq valid("{\"a\":[1,-2.5e3,]rue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
}

test "syntax errors 14" {
  assert_eq syn("{\"a\":[1,-2.5e3,}rue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' looking for beginning of value @16"
  assert_eq valid("{\"a\":[1,-2.5e3,}rue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,:rue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of value @16"
  assert_eq valid("{\"a\":[1,-2.5e3,:rue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,\"rue,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 's' after array element @33"
