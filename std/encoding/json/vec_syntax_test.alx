  assert_eq valid("{\"a\":[1,-2.5e3,tru\",false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true"), "unexpected end of JSON input @19"
