  assert_eq syn("{\"a\":[1,-2.5]3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '3' after object key:value pair @14"
  assert_eq valid("{\"a\":[1,-2.5]3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5}3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array element @13"
  assert_eq valid("{\"a\":[1,-2.5}3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5:3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array element @13"
  assert_eq valid("{\"a\":[1,-2.5:3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5\"3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array element @13"
  assert_eq valid("{\"a\":[1,-2.5\"3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e"), "unexpected end of JSON input @8"
  assert_eq valid("{\"a\":[1,-2.5e"), false
  assert_eq syn("{\"a\":[1,-2.5ex,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' in numeric literal @14"
  assert_eq valid("{\"a\":[1,-2.5ex,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e,,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' in numeric literal @14"
