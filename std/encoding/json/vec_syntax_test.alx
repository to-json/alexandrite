  assert_eq syn("{\"a\":[1,-2"), "unexpected end of JSON input @10"
  assert_eq valid("{\"a\":[1,-2"), false
  assert_eq syn("{\"a\":[1,-2x5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array element @11"
  assert_eq valid("{\"a\":[1,-2x5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2,5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2,5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2]5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '5' after object key:value pair @12"
  assert_eq valid("{\"a\":[1,-2]5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2}5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array element @11"
  assert_eq valid("{\"a\":[1,-2}5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2:5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array element @11"
  assert_eq valid("{\"a\":[1,-2:5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2\"5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array element @11"
  assert_eq valid("{\"a\":[1,-2\"5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2."), "unexpected end of JSON input @8"
  assert_eq valid("{\"a\":[1,-2."), false
  assert_eq syn("{\"a\":[1,-2.xe3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' in numeric literal @12"
  assert_eq valid("{\"a\":[1,-2.xe3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.,e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' in numeric literal @12"
