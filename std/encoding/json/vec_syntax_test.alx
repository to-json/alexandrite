  assert_eq syn("\"k\"null\"[{ "), "invalid character 'n' after top-level value @4"
  assert_eq valid("\"k\"null\"[{ "), false
  assert_eq syn(" \\-["), "invalid character '\\\\' looking for beginning of value @2"
  assert_eq valid(" \\-["), false
  assert_eq syn("\"k\"u1null"), "invalid character 'u' after top-level value @4"
  assert_eq valid("\"k\"u1null"), false
  assert_eq syn(":-ftrue"), "invalid character ':' looking for beginning of value @1"
  assert_eq valid(":-ftrue"), false
  assert_eq syn("n\""), "invalid character '\"' in literal null (expecting 'u') @2"
  assert_eq valid("n\""), false
  assert_eq syn("ntf1n"), "invalid character 't' in literal null (expecting 'u') @2"
  assert_eq valid("ntf1n"), false
  assert_eq syn("n}x\"k\""), "invalid character '}' in literal null (expecting 'u') @2"
  assert_eq valid("n}x\"k\""), false
  assert_eq syn("0\"k\"tte-}."), "invalid character '\"' after top-level value @2"
  assert_eq valid("0\"k\"tte-}."), false
  assert_eq syn("]}[{\\"), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]}[{\\"), false
  assert_eq syn("a \\f"), "invalid character 'a' looking for beginning of value @1"
  assert_eq valid("a \\f"), false
  assert_eq syn(",.t"), "invalid character ',' looking for beginning of value @1"
  assert_eq valid(",.t"), false
  assert_eq syn("true aax"), "invalid character 'a' after top-level value @6"
  assert_eq valid("true aax"), false
  assert_eq syn("00ef"), "invalid character '0' after top-level value @2"
  assert_eq valid("00ef"), false
  assert_eq syn("truenull[-x\",{"), "invalid character 'n' after top-level value @5"
  assert_eq valid("truenull[-x\",{"), false
  assert_eq syn("\\e1x"), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\e1x"), false
  assert_eq syn("]a}-n"), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]a}-n"), false
  assert_eq syn(" unull}null["), "invalid character 'u' looking for beginning of value @2"
  assert_eq valid(" unull}null["), false
  assert_eq syn(",nf:e"), "invalid character ',' looking for beginning of value @1"
  assert_eq valid(",nf:e"), false
  assert_eq syn("a.]\"x\".t"), "invalid character 'a' looking for beginning of value @1"
  assert_eq valid("a.]\"x\".t"), false
  assert_eq syn("-nex1"), "invalid character 'n' in numeric literal @2"
  assert_eq valid("-nex1"), false
  assert_eq syn("a\"null-{0t"), "invalid character 'a' looking for beginning of value @1"
  assert_eq valid("a\"null-{0t"), false
  assert_eq syn("nullnull{x\\"), "invalid character 'n' after top-level value @5"
  assert_eq valid("nullnull{x\\"), false
}

