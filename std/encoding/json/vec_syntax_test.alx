  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"}\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\":\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\":\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"\"\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after object key @43"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"\"\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b"), "unexpected end of JSON input @42"
