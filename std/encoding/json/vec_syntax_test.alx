  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né]],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'b' after array element @42"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né]],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null,\"s\\né]],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'b' after array value @42"
}

test "syntax errors 17" {
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né}],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'b' after array element @42"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né}],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null,\"s\\né}],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'b' after array value @42"
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né:],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'b' after array element @42"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né:],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null,\"s\\né:],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'b' after array value @42"
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\""), "unexpected end of JSON input @38"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\""), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"x,\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array element @39"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"x,\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"x,\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array value @39"
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\",,\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @40"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\",,\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"},\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array element @39"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"},\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"},\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array value @39"
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\":,\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array element @39"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\":,\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\":,\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array value @39"
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"\",\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array element @39"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"\",\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"\",\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array value @39"
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]"), "unexpected end of JSON input @39"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]x\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after object key:value pair @40"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]x\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]]\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' after object key:value pair @40"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]]\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]}\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after top-level value @41"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]}\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]:\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after object key:value pair @40"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]:\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]\"\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after object key:value pair @40"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"]\"\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],"), "unexpected end of JSON input @40"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],xb\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of object key string @41"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],xb\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],,b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of object key string @41"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],,b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],]b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of object key string @41"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],]b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],}b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' looking for beginning of object key string @41"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],}b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],:b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of object key string @41"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],:b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\""), "unexpected end of JSON input @41"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\""), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"x\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"x\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\",\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\",\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"]\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"]\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"}\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"}\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\":\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\":\":{\"c\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"\"\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after object key @43"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"\"\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b"), "unexpected end of JSON input @42"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"bx:{\"c\":{}},\"d\":[]}"), "invalid character 'c' after object key @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"bx:{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b,:{\"c\":{}},\"d\":[]}"), "invalid character 'c' after object key @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b,:{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b]:{\"c\":{}},\"d\":[]}"), "invalid character 'c' after object key @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b]:{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b}:{\"c\":{}},\"d\":[]}"), "invalid character 'c' after object key @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b}:{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b::{\"c\":{}},\"d\":[]}"), "invalid character 'c' after object key @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b::{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\""), "unexpected end of JSON input @43"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\""), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"x{\"c\":{}},\"d\":[]}"), "invalid character 'x' after object key @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"x{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\",{\"c\":{}},\"d\":[]}"), "invalid character ',' after object key @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\",{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"]{\"c\":{}},\"d\":[]}"), "invalid character ']' after object key @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"]{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"}{\"c\":{}},\"d\":[]}"), "invalid character '}' after object key @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"}{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"\"{\"c\":{}},\"d\":[]}"), "invalid character '\"' after object key @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"\"{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":"), "unexpected end of JSON input @44"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":x\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of value @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":x\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":,\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":,\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":]\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of value @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":]\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":}\"c\":{}},\"d\":[]}"), "invalid character '}' looking for beginning of value @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":}\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"::\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of value @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\"::\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":\"\"c\":{}},\"d\":[]}"), "invalid character 'c' after object key:value pair @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":\"\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{"), "unexpected end of JSON input @45"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{xc\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of object key string @46"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{xc\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{,c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of object key string @46"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{,c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{]c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of object key string @46"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{]c\":{}},\"d\":[]}"), false
}

test "syntax errors 18" {
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{}c\":{}},\"d\":[]}"), "invalid character 'c' after object key:value pair @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{}c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{:c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of object key string @46"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{:c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\""), "unexpected end of JSON input @46"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\""), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"x\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"x\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\",\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\",\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"]\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"]\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"}\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"}\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\":\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\":\":{}},\"d\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"\"\":{}},\"d\":[]}"), "invalid character '\"' after object key @48"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"\"\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c"), "unexpected end of JSON input @47"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"cx:{}},\"d\":[]}"), "invalid character 'd' after object key @55"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"cx:{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c,:{}},\"d\":[]}"), "invalid character 'd' after object key @55"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c,:{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c]:{}},\"d\":[]}"), "invalid character 'd' after object key @55"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c]:{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c}:{}},\"d\":[]}"), "invalid character 'd' after object key @55"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c}:{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c::{}},\"d\":[]}"), "invalid character 'd' after object key @55"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c::{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\""), "unexpected end of JSON input @48"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\""), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\"x{}},\"d\":[]}"), "invalid character 'x' after object key @49"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\"x{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\",{}},\"d\":[]}"), "invalid character ',' after object key @49"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\",{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\"]{}},\"d\":[]}"), "invalid character ']' after object key @49"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\"]{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\"}{}},\"d\":[]}"), "invalid character '}' after object key @49"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\"}{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\"\"{}},\"d\":[]}"), "invalid character '\"' after object key @49"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\"\"{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":"), "unexpected end of JSON input @49"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":x}},\"d\":[]}"), "invalid character 'x' looking for beginning of value @50"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":x}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":,}},\"d\":[]}"), "invalid character ',' looking for beginning of value @50"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":,}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":]}},\"d\":[]}"), "invalid character ']' looking for beginning of value @50"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":]}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":}}},\"d\":[]}"), "invalid character '}' looking for beginning of value @50"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":}}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\"::}},\"d\":[]}"), "invalid character ':' looking for beginning of value @50"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\"::}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":\"}},\"d\":[]}"), "invalid character 'd' after object key:value pair @55"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":\"}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{"), "unexpected end of JSON input @50"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{x},\"d\":[]}"), "invalid character 'x' looking for beginning of object key string @51"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{x},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{,},\"d\":[]}"), "invalid character ',' looking for beginning of object key string @51"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{,},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{]},\"d\":[]}"), "invalid character ']' looking for beginning of object key string @51"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{]},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{:},\"d\":[]}"), "invalid character ':' looking for beginning of object key string @51"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{:},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{\"},\"d\":[]}"), "invalid character 'd' after object key @55"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{\"},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}"), "unexpected end of JSON input @51"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}x,\"d\":[]}"), "invalid character 'x' after object key:value pair @52"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}x,\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{},,\"d\":[]}"), "invalid character ',' looking for beginning of object key string @53"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{},,\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}],\"d\":[]}"), "invalid character ']' after object key:value pair @52"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}],\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}:,\"d\":[]}"), "invalid character ':' after object key:value pair @52"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}:,\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}\",\"d\":[]}"), "invalid character '\"' after object key:value pair @52"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}\",\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}"), "unexpected end of JSON input @52"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}x\"d\":[]}"), "invalid character 'x' after object key:value pair @53"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}x\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}]\"d\":[]}"), "invalid character ']' after object key:value pair @53"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}]\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}}\"d\":[]}"), "invalid character '\"' after top-level value @54"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}}\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}:\"d\":[]}"), "invalid character ':' after object key:value pair @53"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}:\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}\"\"d\":[]}"), "invalid character '\"' after object key:value pair @53"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}}\"\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},"), "unexpected end of JSON input @53"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},xd\":[]}"), "invalid character 'x' looking for beginning of object key string @54"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},xd\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},,d\":[]}"), "invalid character ',' looking for beginning of object key string @54"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},,d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},]d\":[]}"), "invalid character ']' looking for beginning of object key string @54"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},]d\":[]}"), false
}

test "syntax errors 19" {
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},}d\":[]}"), "invalid character '}' looking for beginning of object key string @54"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},}d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},:d\":[]}"), "invalid character ':' looking for beginning of object key string @54"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},:d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\""), "unexpected end of JSON input @54"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\""), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"x\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"x\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\",\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\",\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"]\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"]\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"}\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"}\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\":\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\":\":[]}"), true
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"\"\":[]}"), "invalid character '\"' after object key @56"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"\"\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d"), "unexpected end of JSON input @55"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"dx:[]}"), "unexpected end of JSON input @60"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"dx:[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d,:[]}"), "unexpected end of JSON input @60"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d,:[]}"), false
