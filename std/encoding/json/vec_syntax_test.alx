  assert_eq valid("xxtrue{u"), false
  assert_eq syn(" x,\"."), "invalid character 'x' looking for beginning of value @2"
  assert_eq valid(" x,\"."), false
  assert_eq syn("x-:\\"), "invalid character 'x' looking for beginning of value @1"
  assert_eq valid("x-:\\"), false
  assert_eq syn("uu.a,\"n"), "invalid character 'u' looking for beginning of value @1"
  assert_eq valid("uu.a,\"n"), false
  assert_eq syn("xnullx["), "invalid character 'x' looking for beginning of value @1"
  assert_eq valid("xnullx["), false
  assert_eq syn("f0-}{,"), "invalid character '0' in literal false (expecting 'a') @2"
  assert_eq valid("f0-}{,"), false
  assert_eq syn(".:0}-\"]"), "invalid character '.' looking for beginning of value @1"
  assert_eq valid(".:0}-\"]"), false
  assert_eq syn("]e1[t\"\""), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]e1[t\"\""), false
  assert_eq syn("\"k\",]\"k\"{e\\\""), "invalid character ',' after top-level value @4"
  assert_eq valid("\"k\",]\"k\"{e\\\""), false
  assert_eq syn("\\.0"), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\.0"), false
  assert_eq syn("0atrue,x-"), "invalid character 'a' after top-level value @2"
  assert_eq valid("0atrue,x-"), false
  assert_eq syn("fe\"\\ f\""), "invalid character 'e' in literal false (expecting 'a') @2"
  assert_eq valid("fe\"\\ f\""), false
  assert_eq syn("\"a:.}n]f"), "unexpected end of JSON input @8"
  assert_eq valid("\"a:.}n]f"), false
  assert_eq syn(",."), "invalid character ',' looking for beginning of value @1"
  assert_eq valid(",."), false
}

