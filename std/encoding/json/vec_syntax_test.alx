  assert_eq syn("-.null"), "invalid character '.' in numeric literal @2"
  assert_eq valid("-.null"), false
  assert_eq syn("0\"aaa0a"), "invalid character '\"' after top-level value @2"
  assert_eq valid("0\"aaa0a"), false
  assert_eq syn(":.true. ,\\-"), "invalid character ':' looking for beginning of value @1"
  assert_eq valid(":.true. ,\\-"), false
  assert_eq syn("u}true]"), "invalid character 'u' looking for beginning of value @1"
  assert_eq valid("u}true]"), false
  assert_eq syn("{,"), "invalid character ',' looking for beginning of object key string @2"
  assert_eq valid("{,"), false
  assert_eq syn("f] a t"), "invalid character ']' in literal false (expecting 'a') @2"
  assert_eq valid("f] a t"), false
  assert_eq syn("null "), "ok"
  assert_eq valid("null "), true
  assert_eq syn("[true-:]]n"), "invalid character '-' after array element @6"
  assert_eq valid("[true-:]]n"), false
  assert_eq syn_compact("[true-:]]n"), "invalid character '-' after array value @6"
  assert_eq syn(".null"), "invalid character '.' looking for beginning of value @1"
  assert_eq valid(".null"), false
  assert_eq syn("enulln"), "invalid character 'e' looking for beginning of value @1"
  assert_eq valid("enulln"), false
  assert_eq syn("}]x"), "invalid character '}' looking for beginning of value @1"
  assert_eq valid("}]x"), false
  assert_eq syn("true..0xf\"]"), "invalid character '.' after top-level value @5"
  assert_eq valid("true..0xf\"]"), false
  assert_eq syn("}-\\.u"), "invalid character '}' looking for beginning of value @1"
  assert_eq valid("}-\\.u"), false
  assert_eq syn("0]0"), "invalid character ']' after top-level value @2"
  assert_eq valid("0]0"), false
  assert_eq syn("\"k\"null\"k\"ut{"), "invalid character 'n' after top-level value @4"
  assert_eq valid("\"k\"null\"k\"ut{"), false
  assert_eq syn(",[1nulltruef"), "invalid character ',' looking for beginning of value @1"
  assert_eq valid(",[1nulltruef"), false
  assert_eq syn("u\"k\"u\\]"), "invalid character 'u' looking for beginning of value @1"
  assert_eq valid("u\"k\"u\\]"), false
  assert_eq syn("[,null"), "invalid character ',' looking for beginning of value @2"
  assert_eq valid("[,null"), false
  assert_eq syn(".0\"k\"f"), "invalid character '.' looking for beginning of value @1"
  assert_eq valid(".0\"k\"f"), false
  assert_eq syn("nt1e\\true\\"), "invalid character 't' in literal null (expecting 'u') @2"
  assert_eq valid("nt1e\\true\\"), false
  assert_eq syn("an"), "invalid character 'a' looking for beginning of value @1"
  assert_eq valid("an"), false
  assert_eq syn("u\\\"k\"\"t]"), "invalid character 'u' looking for beginning of value @1"
  assert_eq valid("u\\\"k\"\"t]"), false
  assert_eq syn("\\{]fet"), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\{]fet"), false
  assert_eq syn("a\"k\"t"), "invalid character 'a' looking for beginning of value @1"
  assert_eq valid("a\"k\"t"), false
  assert_eq syn("1\"k\"f:"), "invalid character '\"' after top-level value @2"
  assert_eq valid("1\"k\"f:"), false
}

test "syntax errors 12" {
  assert_eq syn("x\"a\":[1,-2.5e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of value @1"
