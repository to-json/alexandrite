  assert_eq syn("\"k\"\\true:\\nullutrue"), "invalid character '\\\\' after top-level value @4"
  assert_eq valid("\"k\"\\true:\\nullutrue"), false
  assert_eq syn("]n00-n{\""), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]n00-n{\""), false
  assert_eq syn("]\"0u\\"), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]\"0u\\"), false
  assert_eq syn("]]}]  x"), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]]}]  x"), false
}

