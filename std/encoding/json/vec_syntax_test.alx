  assert_eq syn("{\"a\":[1,-2.5e3,true,f,lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f,lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,f]lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f]lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,f}lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f}lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,f:lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f:lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,f\"lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f\"lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,fa"), "unexpected end of JSON input @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,fa"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,faxse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' in literal false (expecting 'l') @23"
