  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"\"\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\\\\' after array element @34"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"\"\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null,\"\"\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\\\\' after array value @34"
