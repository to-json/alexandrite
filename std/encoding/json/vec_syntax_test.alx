  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\néx],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'b' after array element @42"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\néx],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null,\"s\\néx],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'b' after array value @42"
