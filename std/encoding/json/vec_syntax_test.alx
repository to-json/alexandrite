  assert_eq valid("{\"a\":[1,-2.5e3,truexfalse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true]false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'f' after object key:value pair @21"
  assert_eq valid("{\"a\":[1,-2.5e3,true]false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true}false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array element @20"
  assert_eq valid("{\"a\":[1,-2.5e3,true}false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
