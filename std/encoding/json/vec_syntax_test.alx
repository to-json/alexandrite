  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nul],\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' in literal null (expecting 'l') @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nul],\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nul},\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' in literal null (expecting 'l') @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nul},\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nul:,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' in literal null (expecting 'l') @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nul:,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nul\",\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' in literal null (expecting 'l') @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nul\",\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null"), "unexpected end of JSON input @30"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null"), false
}

test "syntax errors 16" {
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,nullx\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array element @31"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,nullx\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,nullx\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array value @31"
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null]\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after object key:value pair @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null]\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null}\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array element @31"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null}\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null}\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' after array value @31"
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null:\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array element @31"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null:\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null:\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' after array value @31"
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null\"\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array element @31"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null\"\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,false,null\"\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' after array value @31"
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,"), "unexpected end of JSON input @31"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,xs\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of value @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,xs\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,,s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,,s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,]s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of value @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,]s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,}s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' looking for beginning of value @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,}s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,:s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of value @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,:s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\""), "unexpected end of JSON input @32"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\""), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"x\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "ok"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"x\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), true
