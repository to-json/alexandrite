  assert_eq valid("null}\"k\"\"k\",e-."), false
  assert_eq syn("]u}e1}truen"), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]u}e1}truen"), false
  assert_eq syn("[a"), "invalid character 'a' looking for beginning of value @2"
  assert_eq valid("[a"), false
  assert_eq syn(":0 axa}x"), "invalid character ':' looking for beginning of value @1"
  assert_eq valid(":0 axa}x"), false
  assert_eq syn(".:u\"]0\""), "invalid character '.' looking for beginning of value @1"
  assert_eq valid(".:u\"]0\""), false
}

