  assert_eq valid("{}e:t"), false
  assert_eq syn("fn true"), "invalid character 'n' in literal false (expecting 'a') @2"
  assert_eq valid("fn true"), false
  assert_eq syn("null,nullnf.]\\"), "invalid character ',' after top-level value @5"
  assert_eq valid("null,nullnf.]\\"), false
  assert_eq syn("n n\"k\":.n"), "invalid character ' ' in literal null (expecting 'u') @2"
  assert_eq valid("n n\"k\":.n"), false
  assert_eq syn("\"k\",true"), "invalid character ',' after top-level value @4"
  assert_eq valid("\"k\",true"), false
  assert_eq syn(".]"), "invalid character '.' looking for beginning of value @1"
  assert_eq valid(".]"), false
  assert_eq syn("-tx"), "invalid character 't' in numeric literal @2"
  assert_eq valid("-tx"), false
  assert_eq syn("\\truetrue{ftrue[f"), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\truetrue{ftrue[f"), false
  assert_eq syn("a\"na-\"k\":"), "invalid character 'a' looking for beginning of value @1"
  assert_eq valid("a\"na-\"k\":"), false
  assert_eq syn("t\\f"), "invalid character '\\\\' in literal true (expecting 'r') @2"
  assert_eq valid("t\\f"), false
  assert_eq syn("}nulltruef\"k\","), "invalid character '}' looking for beginning of value @1"
  assert_eq valid("}nulltruef\"k\","), false
  assert_eq syn("null\"f]}1:n"), "invalid character '\"' after top-level value @5"
  assert_eq valid("null\"f]}1:n"), false
  assert_eq syn(",}\"k\",x11"), "invalid character ',' looking for beginning of value @1"
  assert_eq valid(",}\"k\",x11"), false
  assert_eq syn("0:"), "invalid character ':' after top-level value @2"
  assert_eq valid("0:"), false
  assert_eq syn("x}}true-"), "invalid character 'x' looking for beginning of value @1"
  assert_eq valid("x}}true-"), false
  assert_eq syn("f-truextruenull\\e"), "invalid character '-' in literal false (expecting 'a') @2"
  assert_eq valid("f-truextruenull\\e"), false
  assert_eq syn(",t]1tn"), "invalid character ',' looking for beginning of value @1"
  assert_eq valid(",t]1tn"), false
  assert_eq syn("]u\",{"), "invalid character ']' looking for beginning of value @1"
  assert_eq valid("]u\",{"), false
  assert_eq syn("e-au\"true"), "invalid character 'e' looking for beginning of value @1"
  assert_eq valid("e-au\"true"), false
  assert_eq syn("\\nullf"), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\nullf"), false
  assert_eq syn("\"0null"), "unexpected end of JSON input @6"
  assert_eq valid("\"0null"), false
  assert_eq syn("atruennx,"), "invalid character 'a' looking for beginning of value @1"
  assert_eq valid("atruennx,"), false
  assert_eq syn("\"ntrue"), "unexpected end of JSON input @6"
  assert_eq valid("\"ntrue"), false
  assert_eq syn("t:,"), "invalid character ':' in literal true (expecting 'r') @2"
  assert_eq valid("t:,"), false
  assert_eq syn("ntrue{e"), "invalid character 't' in literal null (expecting 'u') @2"
  assert_eq valid("ntrue{e"), false
  assert_eq syn("a]:uanull}"), "invalid character 'a' looking for beginning of value @1"
  assert_eq valid("a]:uanull}"), false
  assert_eq syn("x0\"k\""), "invalid character 'x' looking for beginning of value @1"
  assert_eq valid("x0\"k\""), false
  assert_eq syn("\\[null0tf[null"), "invalid character '\\\\' looking for beginning of value @1"
  assert_eq valid("\\[null0tf[null"), false
  assert_eq syn("  \\ u"), "invalid character '\\\\' looking for beginning of value @3"
  assert_eq valid("  \\ u"), false
}

