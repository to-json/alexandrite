  assert_eq syn("{\"a\":[1,-2.]e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' in numeric literal @12"
  assert_eq valid("{\"a\":[1,-2.]e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.}e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' in numeric literal @12"
  assert_eq valid("{\"a\":[1,-2.}e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.:e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' in numeric literal @12"
  assert_eq valid("{\"a\":[1,-2.:e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.\"e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' in numeric literal @12"
  assert_eq valid("{\"a\":[1,-2.\"e3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5"), "unexpected end of JSON input @12"
  assert_eq valid("{\"a\":[1,-2.5"), false
  assert_eq syn("{\"a\":[1,-2.5x3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' after array element @13"
  assert_eq valid("{\"a\":[1,-2.5x3,true,false,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
