  assert_eq syn("{\"a\":[1,-2.5e3,true,,alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @21"
  assert_eq valid("{\"a\":[1,-2.5e3,true,,alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,]alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of value @21"
  assert_eq valid("{\"a\":[1,-2.5e3,true,]alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,}alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' looking for beginning of value @21"
  assert_eq valid("{\"a\":[1,-2.5e3,true,}alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,:alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' looking for beginning of value @21"
  assert_eq valid("{\"a\":[1,-2.5e3,true,:alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,\"alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 's' after array element @33"
  assert_eq valid("{\"a\":[1,-2.5e3,true,\"alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn_compact("{\"a\":[1,-2.5e3,true,\"alse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 's' after array value @33"
  assert_eq syn("{\"a\":[1,-2.5e3,true,f"), "unexpected end of JSON input @21"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,fxlse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,fxlse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,f,lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f,lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,f]lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f]lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,f}lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f}lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,f:lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f:lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,f\"lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' in literal false (expecting 'a') @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,f\"lse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,fa"), "unexpected end of JSON input @22"
  assert_eq valid("{\"a\":[1,-2.5e3,true,fa"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,faxse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' in literal false (expecting 'l') @23"
  assert_eq valid("{\"a\":[1,-2.5e3,true,faxse,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,fa,se,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' in literal false (expecting 'l') @23"
  assert_eq valid("{\"a\":[1,-2.5e3,true,fa,se,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,fa]se,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' in literal false (expecting 'l') @23"
  assert_eq valid("{\"a\":[1,-2.5e3,true,fa]se,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,fa}se,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '}' in literal false (expecting 'l') @23"
  assert_eq valid("{\"a\":[1,-2.5e3,true,fa}se,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,fa:se,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ':' in literal false (expecting 'l') @23"
  assert_eq valid("{\"a\":[1,-2.5e3,true,fa:se,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
}

test "syntax errors 15" {
  assert_eq syn("{\"a\":[1,-2.5e3,true,fa\"se,null,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character '\"' in literal false (expecting 'l') @23"
