  assert_eq syn("{\"a\":[1,-2.5e3,true,false,xull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character 'x' looking for beginning of value @27"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,xull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,,ull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ',' looking for beginning of value @27"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,,ull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
  assert_eq syn("{\"a\":[1,-2.5e3,true,false,]ull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid character ']' looking for beginning of value @27"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,]ull,\"s\\né\"],\"b\":{\"c\":{}},\"d\":[]}"), false
