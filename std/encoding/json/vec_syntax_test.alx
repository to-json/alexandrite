  assert_eq syn("{\"a\":[1,-2.5e3,true,false,null,\"s\\:é\"],\"b\":{\"c\":{}},\"d\":[]}"), "invalid escape sequence `\\:` in string @35"
  assert_eq valid("{\"a\":[1,-2.5e3,true,false,null,\"s\\:é\"],\"b\":{\"c\":{}},\"d\":[]}"), false
