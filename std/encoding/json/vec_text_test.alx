}

test "compact indent valid 8" {
  assert_eq cmp("{  \t\"\"\n:  [ \"tab\\t\" , \r\n {\t\"k<\" \r\n : true,\t\"é\" \r\n : \r\n [ \r\n \t\"\u2029\",null\t,  true  \t]\n } ,\n[ \r\n  \r\n ]  \t]\t, \r\n \"a\" \r\n :[ \r\n  \r\n null, \r\n \"\\/\" ,\n[]  \n] \r\n }"), "{\"\":[\"tab\\t\",{\"k<\":true,\"é\":[\"\u2029\",null,true]},[]],\"a\":[null,\"\\/\",[]]}"
  assert_eq ind("{  \t\"\"\n:  [ \"tab\\t\" , \r\n {\t\"k<\" \r\n : true,\t\"é\" \r\n : \r\n [ \r\n \t\"\u2029\",null\t,  true  \t]\n } ,\n[ \r\n  \r\n ]  \t]\t, \r\n \"a\" \r\n :[ \r\n  \r\n null, \r\n \"\\/\" ,\n[]  \n] \r\n }", "", "  "), "{\n  \"\": [\n    \"tab\\t\",\n    {\n      \"k<\": true,\n      \"é\": [\n        \"\u2029\",\n        null,\n        true\n      ]\n    },\n    []\n  ],\n  \"a\": [\n    null,\n    \"\\/\",\n    []\n  ]\n}"
  assert_eq valid("{  \t\"\"\n:  [ \"tab\\t\" , \r\n {\t\"k<\" \r\n : true,\t\"é\" \r\n : \r\n [ \r\n \t\"\u2029\",null\t,  true  \t]\n } ,\n[ \r\n  \r\n ]  \t]\t, \r\n \"a\" \r\n :[ \r\n  \r\n null, \r\n \"\\/\" ,\n[]  \n] \r\n }"), true
  assert_eq html_escape("{  \t\"\"\n:  [ \"tab\\t\" , \r\n {\t\"k<\" \r\n : true,\t\"é\" \r\n : \r\n [ \r\n \t\"\u2029\",null\t,  true  \t]\n } ,\n[ \r\n  \r\n ]  \t]\t, \r\n \"a\" \r\n :[ \r\n  \r\n null, \r\n \"\\/\" ,\n[]  \n] \r\n }"), "{  \t\"\"\n:  [ \"tab\\t\" , \r\n {\t\"k\\u003c\" \r\n : true,\t\"é\" \r\n : \r\n [ \r\n \t\"\\u2029\",null\t,  true  \t]\n } ,\n[ \r\n  \r\n ]  \t]\t, \r\n \"a\" \r\n :[ \r\n  \r\n null, \r\n \"\\/\" ,\n[]  \n] \r\n }"
  assert_eq cmp("[ \r\n  0, \r\n \"x\"\n\t]"), "[0,\"x\"]"
  assert_eq ind("[ \r\n  0, \r\n \"x\"\n\t]", ">", "\t"), "[\n>\t0,\n>\t\"x\"\n>]"
  assert_eq valid("[ \r\n  0, \r\n \"x\"\n\t]"), true
  assert_eq html_escape("[ \r\n  0, \r\n \"x\"\n\t]"), "[ \r\n  0, \r\n \"x\"\n\t]"
  assert_eq cmp("1.5"), "1.5"
  assert_eq ind("1.5", "", ""), "1.5"
  assert_eq valid("1.5"), true
  assert_eq html_escape("1.5"), "1.5"
  assert_eq cmp("[   \r\n { \r\n \n\"b\"  :  \"\u2028\" ,\n\"é\"\t:\t\"😀\"\t} , \r\n \"a b\"\n,0.000001 \r\n   ]"), "[{\"b\":\"\u2028\",\"é\":\"😀\"},\"a b\",0.000001]"
  assert_eq ind("[   \r\n { \r\n \n\"b\"  :  \"\u2028\" ,\n\"é\"\t:\t\"😀\"\t} , \r\n \"a b\"\n,0.000001 \r\n   ]", "  ", "-"), "[\n  -{\n  --\"b\": \"\u2028\",\n  --\"é\": \"😀\"\n  -},\n  -\"a b\",\n  -0.000001\n  ]"
  assert_eq valid("[   \r\n { \r\n \n\"b\"  :  \"\u2028\" ,\n\"é\"\t:\t\"😀\"\t} , \r\n \"a b\"\n,0.000001 \r\n   ]"), true
  assert_eq html_escape("[   \r\n { \r\n \n\"b\"  :  \"\u2028\" ,\n\"é\"\t:\t\"😀\"\t} , \r\n \"a b\"\n,0.000001 \r\n   ]"), "[   \r\n { \r\n \n\"b\"  :  \"\\u2028\" ,\n\"é\"\t:\t\"😀\"\t} , \r\n \"a b\"\n,0.000001 \r\n   ]"
  assert_eq cmp("\"\\u2028x\\u2029\""), "\"\\u2028x\\u2029\""
  assert_eq ind("\"\\u2028x\\u2029\"", "", "  "), "\"\\u2028x\\u2029\""
  assert_eq valid("\"\\u2028x\\u2029\""), true
  assert_eq html_escape("\"\\u2028x\\u2029\""), "\"\\u2028x\\u2029\""
