  assert_eq cmp("\n\n{\"a\" : [ 1 , 2 ] , \"b\" : { } }\n\n"), "{\"a\":[1,2],\"b\":{}}"
  assert_eq ind("\n\n{\"a\" : [ 1 , 2 ] , \"b\" : { } }\n\n", "  ", "-"), "{\n  -\"a\": [\n  --1,\n  --2\n  -],\n  -\"b\": {}\n  }\n\n"
