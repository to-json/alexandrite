  assert_eq ind("{\n  \"\"  : [    { \r\n  \r\n } ,{\n\n\"b\" \r\n :\t\"&amp;\"\t, \r\n \"b\"\n:\t[  \t]\t \r\n }   ]\n,\"k<\"\t:{\n\t\"a\"  : \r\n null  \t} \t}", ">", "\t"), "{\n>\t\"\": [\n>\t\t{},\n>\t\t{\n>\t\t\t\"b\": \"&amp;\",\n>\t\t\t\"b\": []\n>\t\t}\n>\t],\n>\t\"k<\": {\n>\t\t\"a\": null\n>\t}\n>}"
  assert_eq valid("{\n  \"\"  : [    { \r\n  \r\n } ,{\n\n\"b\" \r\n :\t\"&amp;\"\t, \r\n \"b\"\n:\t[  \t]\t \r\n }   ]\n,\"k<\"\t:{\n\t\"a\"  : \r\n null  \t} \t}"), true
  assert_eq html_escape("{\n  \"\"  : [    { \r\n  \r\n } ,{\n\n\"b\" \r\n :\t\"&amp;\"\t, \r\n \"b\"\n:\t[  \t]\t \r\n }   ]\n,\"k<\"\t:{\n\t\"a\"  : \r\n null  \t} \t}"), "{\n  \"\"  : [    { \r\n  \r\n } ,{\n\n\"b\" \r\n :\t\"\\u0026amp;\"\t, \r\n \"b\"\n:\t[  \t]\t \r\n }   ]\n,\"k\\u003c\"\t:{\n\t\"a\"  : \r\n null  \t} \t}"
  assert_eq cmp("{  \r\n \"é\":\ntrue ,\t\"é\":  {\n  \"k<\"  : false ,\t\"é\" :\t[]\t, \"\" : \r\n \"a\"\n\t}  }"), "{\"é\":true,\"é\":{\"k<\":false,\"é\":[],\"\":\"a\"}}"
  assert_eq ind("{  \r\n \"é\":\ntrue ,\t\"é\":  {\n  \"k<\"  : false ,\t\"é\" :\t[]\t, \"\" : \r\n \"a\"\n\t}  }", "", ""), "{\n\"é\": true,\n\"é\": {\n\"k<\": false,\n\"é\": [],\n\"\": \"a\"\n}\n}"
  assert_eq valid("{  \r\n \"é\":\ntrue ,\t\"é\":  {\n  \"k<\"  : false ,\t\"é\" :\t[]\t, \"\" : \r\n \"a\"\n\t}  }"), true
  assert_eq html_escape("{  \r\n \"é\":\ntrue ,\t\"é\":  {\n  \"k<\"  : false ,\t\"é\" :\t[]\t, \"\" : \r\n \"a\"\n\t}  }"), "{  \r\n \"é\":\ntrue ,\t\"é\":  {\n  \"k\\u003c\"  : false ,\t\"é\" :\t[]\t, \"\" : \r\n \"a\"\n\t}  }"
