  assert_eq ind("\t\"\"", "", "  "), "\"\""
}

test "compact indent valid 9" {
  assert_eq valid("\t\"\""), true
  assert_eq html_escape("\t\"\""), "\t\"\""
  assert_eq cmp("{    \"a\" \r\n : [\t  \"<b>\"   ]  }"), "{\"a\":[\"<b>\"]}"
  assert_eq ind("{    \"a\" \r\n : [\t  \"<b>\"   ]  }", ">", "\t"), "{\n>\t\"a\": [\n>\t\t\"<b>\"\n>\t]\n>}"
  assert_eq valid("{    \"a\" \r\n : [\t  \"<b>\"   ]  }"), true
  assert_eq html_escape("{    \"a\" \r\n : [\t  \"<b>\"   ]  }"), "{    \"a\" \r\n : [\t  \"\\u003cb\\u003e\"   ]  }"
  assert_eq cmp("  [  [\t\"\u2028\" \r\n  ]\t,[  ] ,\ntrue\t] \r\n "), "[[\"\u2028\"],[],true]"
  assert_eq ind("  [  [\t\"\u2028\" \r\n  ]\t,[  ] ,\ntrue\t] \r\n ", "", ""), "[\n[\n\"\u2028\"\n],\n[],\ntrue\n] \r\n "
  assert_eq valid("  [  [\t\"\u2028\" \r\n  ]\t,[  ] ,\ntrue\t] \r\n "), true
  assert_eq html_escape("  [  [\t\"\u2028\" \r\n  ]\t,[  ] ,\ntrue\t] \r\n "), "  [  [\t\"\\u2028\" \r\n  ]\t,[  ] ,\ntrue\t] \r\n "
  assert_eq cmp("\"é\\n\""), "\"é\\n\""
  assert_eq ind("\"é\\n\"", "  ", "-"), "\"é\\n\""
  assert_eq valid("\"é\\n\""), true
  assert_eq html_escape("\"é\\n\""), "\"é\\n\""
  assert_eq cmp("\t\"&amp;\" "), "\"&amp;\""
  assert_eq ind("\t\"&amp;\" ", "", "  "), "\"&amp;\" "
  assert_eq valid("\t\"&amp;\" "), true
  assert_eq html_escape("\t\"&amp;\" "), "\t\"\\u0026amp;\" "
  assert_eq cmp("{\t }"), "{}"
  assert_eq ind("{\t }", ">", "\t"), "{}"
  assert_eq valid("{\t }"), true
  assert_eq html_escape("{\t }"), "{\t }"
  assert_eq cmp("[ \r\n  \r\n \"\u2029\"\n  ]\n"), "[\"\u2029\"]"
  assert_eq ind("[ \r\n  \r\n \"\u2029\"\n  ]\n", "", ""), "[\n\"\u2029\"\n]\n"
  assert_eq valid("[ \r\n  \r\n \"\u2029\"\n  ]\n"), true
  assert_eq html_escape("[ \r\n  \r\n \"\u2029\"\n  ]\n"), "[ \r\n  \r\n \"\\u2029\"\n  ]\n"
  assert_eq cmp("\"😀\""), "\"😀\""
  assert_eq ind("\"😀\"", "  ", "-"), "\"😀\""
  assert_eq valid("\"😀\""), true
  assert_eq html_escape("\"😀\""), "\"😀\""
  assert_eq cmp("  \"<b>\""), "\"<b>\""
  assert_eq ind("  \"<b>\"", "", "  "), "\"<b>\""
  assert_eq valid("  \"<b>\""), true
  assert_eq html_escape("  \"<b>\""), "  \"\\u003cb\\u003e\""
  assert_eq cmp("\"a b\""), "\"a b\""
  assert_eq ind("\"a b\"", ">", "\t"), "\"a b\""
  assert_eq valid("\"a b\""), true
  assert_eq html_escape("\"a b\""), "\"a b\""
  assert_eq cmp("0.000001"), "0.000001"
  assert_eq ind("0.000001", "", ""), "0.000001"
  assert_eq valid("0.000001"), true
  assert_eq html_escape("0.000001"), "0.000001"
  assert_eq cmp("0.000001"), "0.000001"
  assert_eq ind("0.000001", "  ", "-"), "0.000001"
  assert_eq valid("0.000001"), true
  assert_eq html_escape("0.000001"), "0.000001"
  assert_eq cmp("123456789012345678901"), "123456789012345678901"
  assert_eq ind("123456789012345678901", "", "  "), "123456789012345678901"
  assert_eq valid("123456789012345678901"), true
  assert_eq html_escape("123456789012345678901"), "123456789012345678901"
}

test "compact indent valid 10" {
  assert_eq cmp("[ \r\n   ]"), "[]"
  assert_eq ind("[ \r\n   ]", ">", "\t"), "[]"
  assert_eq valid("[ \r\n   ]"), true
  assert_eq html_escape("[ \r\n   ]"), "[ \r\n   ]"
  assert_eq cmp("\"<&>\""), "\"<&>\""
  assert_eq ind("\"<&>\"", "", ""), "\"<&>\""
  assert_eq valid("\"<&>\""), true
  assert_eq html_escape("\"<&>\""), "\"\\u003c\\u0026\\u003e\""
  assert_eq cmp("-1 "), "-1"
  assert_eq ind("-1 ", "  ", "-"), "-1 "
  assert_eq valid("-1 "), true
  assert_eq html_escape("-1 "), "-1 "
  assert_eq cmp(" \r\n {\t \r\n \"b\"  :\n\"\u2028\"\t,\n\"a\" :  true \r\n ,\t\"a\"\n:\n1.5  }\n"), "{\"b\":\"\u2028\",\"a\":true,\"a\":1.5}"
  assert_eq ind(" \r\n {\t \r\n \"b\"  :\n\"\u2028\"\t,\n\"a\" :  true \r\n ,\t\"a\"\n:\n1.5  }\n", "", "  "), "{\n  \"b\": \"\u2028\",\n  \"a\": true,\n  \"a\": 1.5\n}\n"
  assert_eq valid(" \r\n {\t \r\n \"b\"  :\n\"\u2028\"\t,\n\"a\" :  true \r\n ,\t\"a\"\n:\n1.5  }\n"), true
  assert_eq html_escape(" \r\n {\t \r\n \"b\"  :\n\"\u2028\"\t,\n\"a\" :  true \r\n ,\t\"a\"\n:\n1.5  }\n"), " \r\n {\t \r\n \"b\"  :\n\"\\u2028\"\t,\n\"a\" :  true \r\n ,\t\"a\"\n:\n1.5  }\n"
  assert_eq cmp(" \r\n {\t\"b\":  {\t\"a\" \r\n :\"é\\n\"\t,\t\"a\"  :\t\"\u2028\"\n} \r\n ,\t\"a\" \r\n :\"\\u2028x\\u2029\"\n,  \"b\":\n[\t \r\n \"\\\"q\\\"\" \r\n   ]  \t}"), "{\"b\":{\"a\":\"é\\n\",\"a\":\"\u2028\"},\"a\":\"\\u2028x\\u2029\",\"b\":[\"\\\"q\\\"\"]}"
  assert_eq ind(" \r\n {\t\"b\":  {\t\"a\" \r\n :\"é\\n\"\t,\t\"a\"  :\t\"\u2028\"\n} \r\n ,\t\"a\" \r\n :\"\\u2028x\\u2029\"\n,  \"b\":\n[\t \r\n \"\\\"q\\\"\" \r\n   ]  \t}", ">", "\t"), "{\n>\t\"b\": {\n>\t\t\"a\": \"é\\n\",\n>\t\t\"a\": \"\u2028\"\n>\t},\n>\t\"a\": \"\\u2028x\\u2029\",\n>\t\"b\": [\n>\t\t\"\\\"q\\\"\"\n>\t]\n>}"
  assert_eq valid(" \r\n {\t\"b\":  {\t\"a\" \r\n :\"é\\n\"\t,\t\"a\"  :\t\"\u2028\"\n} \r\n ,\t\"a\" \r\n :\"\\u2028x\\u2029\"\n,  \"b\":\n[\t \r\n \"\\\"q\\\"\" \r\n   ]  \t}"), true
  assert_eq html_escape(" \r\n {\t\"b\":  {\t\"a\" \r\n :\"é\\n\"\t,\t\"a\"  :\t\"\u2028\"\n} \r\n ,\t\"a\" \r\n :\"\\u2028x\\u2029\"\n,  \"b\":\n[\t \r\n \"\\\"q\\\"\" \r\n   ]  \t}"), " \r\n {\t\"b\":  {\t\"a\" \r\n :\"é\\n\"\t,\t\"a\"  :\t\"\\u2028\"\n} \r\n ,\t\"a\" \r\n :\"\\u2028x\\u2029\"\n,  \"b\":\n[\t \r\n \"\\\"q\\\"\" \r\n   ]  \t}"
  assert_eq cmp("false"), "false"
  assert_eq ind("false", "", ""), "false"
  assert_eq valid("false"), true
  assert_eq html_escape("false"), "false"
  assert_eq cmp("\"&amp;\""), "\"&amp;\""
  assert_eq ind("\"&amp;\"", "  ", "-"), "\"&amp;\""
  assert_eq valid("\"&amp;\""), true
  assert_eq html_escape("\"&amp;\""), "\"\\u0026amp;\""
  assert_eq cmp("[   \"😀\", {    }\t ]"), "[\"😀\",{}]"
  assert_eq ind("[   \"😀\", {    }\t ]", "", "  "), "[\n  \"😀\",\n  {}\n]"
  assert_eq valid("[   \"😀\", {    }\t ]"), true
  assert_eq html_escape("[   \"😀\", {    }\t ]"), "[   \"😀\", {    }\t ]"
  assert_eq cmp("\"\u2028\""), "\"\u2028\""
  assert_eq ind("\"\u2028\"", ">", "\t"), "\"\u2028\""
  assert_eq valid("\"\u2028\""), true
  assert_eq html_escape("\"\u2028\""), "\"\\u2028\""
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "", ""), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp("1.5"), "1.5"
  assert_eq ind("1.5", "  ", "-"), "1.5"
  assert_eq valid("1.5"), true
  assert_eq html_escape("1.5"), "1.5"
  assert_eq cmp(" \"tab\\t\"\t"), "\"tab\\t\""
  assert_eq ind(" \"tab\\t\"\t", "", "  "), "\"tab\\t\"\t"
  assert_eq valid(" \"tab\\t\"\t"), true
  assert_eq html_escape(" \"tab\\t\"\t"), " \"tab\\t\"\t"
  assert_eq cmp("\n{  \"é\" :\nnull , \r\n \"b\"  :\n[\t {    \"a\"  :  0  \r\n }\n,  { \r\n \t\"k<\" :\"\\\"q\\\"\" \n}\t\n]\t,  \"k<\" :\t\"<b>\" }"), "{\"é\":null,\"b\":[{\"a\":0},{\"k<\":\"\\\"q\\\"\"}],\"k<\":\"<b>\"}"
  assert_eq ind("\n{  \"é\" :\nnull , \r\n \"b\"  :\n[\t {    \"a\"  :  0  \r\n }\n,  { \r\n \t\"k<\" :\"\\\"q\\\"\" \n}\t\n]\t,  \"k<\" :\t\"<b>\" }", ">", "\t"), "{\n>\t\"é\": null,\n>\t\"b\": [\n>\t\t{\n>\t\t\t\"a\": 0\n>\t\t},\n>\t\t{\n>\t\t\t\"k<\": \"\\\"q\\\"\"\n>\t\t}\n>\t],\n>\t\"k<\": \"<b>\"\n>}"
}

test "compact indent valid 11" {
  assert_eq valid("\n{  \"é\" :\nnull , \r\n \"b\"  :\n[\t {    \"a\"  :  0  \r\n }\n,  { \r\n \t\"k<\" :\"\\\"q\\\"\" \n}\t\n]\t,  \"k<\" :\t\"<b>\" }"), true
  assert_eq html_escape("\n{  \"é\" :\nnull , \r\n \"b\"  :\n[\t {    \"a\"  :  0  \r\n }\n,  { \r\n \t\"k<\" :\"\\\"q\\\"\" \n}\t\n]\t,  \"k<\" :\t\"<b>\" }"), "\n{  \"é\" :\nnull , \r\n \"b\"  :\n[\t {    \"a\"  :  0  \r\n }\n,  { \r\n \t\"k\\u003c\" :\"\\\"q\\\"\" \n}\t\n]\t,  \"k\\u003c\" :\t\"\\u003cb\\u003e\" }"
  assert_eq cmp("\"a b\""), "\"a b\""
  assert_eq ind("\"a b\"", "", ""), "\"a b\""
  assert_eq valid("\"a b\""), true
  assert_eq html_escape("\"a b\""), "\"a b\""
  assert_eq cmp("\"<&>\""), "\"<&>\""
  assert_eq ind("\"<&>\"", "  ", "-"), "\"<&>\""
  assert_eq valid("\"<&>\""), true
  assert_eq html_escape("\"<&>\""), "\"\\u003c\\u0026\\u003e\""
  assert_eq cmp("true \r\n "), "true"
  assert_eq ind("true \r\n ", "", "  "), "true \r\n "
  assert_eq valid("true \r\n "), true
  assert_eq html_escape("true \r\n "), "true \r\n "
  assert_eq cmp("\"tab\\t\""), "\"tab\\t\""
  assert_eq ind("\"tab\\t\"", ">", "\t"), "\"tab\\t\""
  assert_eq valid("\"tab\\t\""), true
  assert_eq html_escape("\"tab\\t\""), "\"tab\\t\""
  assert_eq cmp("\"&amp;\""), "\"&amp;\""
  assert_eq ind("\"&amp;\"", "", ""), "\"&amp;\""
  assert_eq valid("\"&amp;\""), true
  assert_eq html_escape("\"&amp;\""), "\"\\u0026amp;\""
  assert_eq cmp("123456789012345678901"), "123456789012345678901"
  assert_eq ind("123456789012345678901", "  ", "-"), "123456789012345678901"
  assert_eq valid("123456789012345678901"), true
  assert_eq html_escape("123456789012345678901"), "123456789012345678901"
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "", "  "), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp("\n[ \r\n  \r\n {  \"b\" \r\n :  \"x\" \r\n   }\t,[\n\"a b\"  ]\t, \r\n [ \r\n  \r\n [\t \"\"\n,\"\u2028\" \n],\n[ \r\n \t\"é\\n\"\n \r\n ] ,\nnull\n\n]\n]\t"), "[{\"b\":\"x\"},[\"a b\"],[[\"\",\"\u2028\"],[\"é\\n\"],null]]"
  assert_eq ind("\n[ \r\n  \r\n {  \"b\" \r\n :  \"x\" \r\n   }\t,[\n\"a b\"  ]\t, \r\n [ \r\n  \r\n [\t \"\"\n,\"\u2028\" \n],\n[ \r\n \t\"é\\n\"\n \r\n ] ,\nnull\n\n]\n]\t", ">", "\t"), "[\n>\t{\n>\t\t\"b\": \"x\"\n>\t},\n>\t[\n>\t\t\"a b\"\n>\t],\n>\t[\n>\t\t[\n>\t\t\t\"\",\n>\t\t\t\"\u2028\"\n>\t\t],\n>\t\t[\n>\t\t\t\"é\\n\"\n>\t\t],\n>\t\tnull\n>\t]\n>]\t"
  assert_eq valid("\n[ \r\n  \r\n {  \"b\" \r\n :  \"x\" \r\n   }\t,[\n\"a b\"  ]\t, \r\n [ \r\n  \r\n [\t \"\"\n,\"\u2028\" \n],\n[ \r\n \t\"é\\n\"\n \r\n ] ,\nnull\n\n]\n]\t"), true
  assert_eq html_escape("\n[ \r\n  \r\n {  \"b\" \r\n :  \"x\" \r\n   }\t,[\n\"a b\"  ]\t, \r\n [ \r\n  \r\n [\t \"\"\n,\"\u2028\" \n],\n[ \r\n \t\"é\\n\"\n \r\n ] ,\nnull\n\n]\n]\t"), "\n[ \r\n  \r\n {  \"b\" \r\n :  \"x\" \r\n   }\t,[\n\"a b\"  ]\t, \r\n [ \r\n  \r\n [\t \"\"\n,\"\\u2028\" \n],\n[ \r\n \t\"é\\n\"\n \r\n ] ,\nnull\n\n]\n]\t"
  assert_eq cmp("-1"), "-1"
  assert_eq ind("-1", "", ""), "-1"
  assert_eq valid("-1"), true
  assert_eq html_escape("-1"), "-1"
  assert_eq cmp("\"\u2029\""), "\"\u2029\""
  assert_eq ind("\"\u2029\"", "  ", "-"), "\"\u2029\""
  assert_eq valid("\"\u2029\""), true
  assert_eq html_escape("\"\u2029\""), "\"\\u2029\""
  assert_eq cmp("0"), "0"
  assert_eq ind("0", "", "  "), "0"
  assert_eq valid("0"), true
  assert_eq html_escape("0"), "0"
  assert_eq cmp("{ \r\n \"\" \r\n : \r\n null\t}"), "{\"\":null}"
  assert_eq ind("{ \r\n \"\" \r\n : \r\n null\t}", ">", "\t"), "{\n>\t\"\": null\n>}"
  assert_eq valid("{ \r\n \"\" \r\n : \r\n null\t}"), true
  assert_eq html_escape("{ \r\n \"\" \r\n : \r\n null\t}"), "{ \r\n \"\" \r\n : \r\n null\t}"
}

test "compact indent valid 12" {
  assert_eq cmp("\"é\\n\""), "\"é\\n\""
  assert_eq ind("\"é\\n\"", "", ""), "\"é\\n\""
  assert_eq valid("\"é\\n\""), true
  assert_eq html_escape("\"é\\n\""), "\"é\\n\""
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "  ", "-"), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp(" [ \r\n  ]  "), "[]"
  assert_eq ind(" [ \r\n  ]  ", "", "  "), "[]  "
  assert_eq valid(" [ \r\n  ]  "), true
  assert_eq html_escape(" [ \r\n  ]  "), " [ \r\n  ]  "
  assert_eq cmp("1e10"), "1e10"
  assert_eq ind("1e10", ">", "\t"), "1e10"
  assert_eq valid("1e10"), true
  assert_eq html_escape("1e10"), "1e10"
  assert_eq cmp("0.000001"), "0.000001"
  assert_eq ind("0.000001", "", ""), "0.000001"
  assert_eq valid("0.000001"), true
  assert_eq html_escape("0.000001"), "0.000001"
  assert_eq cmp("{  \n\"\":\t{    \"b\" :  \"\"\t}\n,\"k<\"\t: \r\n \"\" , \"b\" \r\n : \r\n \"\u2029\"  }"), "{\"\":{\"b\":\"\"},\"k<\":\"\",\"b\":\"\u2029\"}"
  assert_eq ind("{  \n\"\":\t{    \"b\" :  \"\"\t}\n,\"k<\"\t: \r\n \"\" , \"b\" \r\n : \r\n \"\u2029\"  }", "  ", "-"), "{\n  -\"\": {\n  --\"b\": \"\"\n  -},\n  -\"k<\": \"\",\n  -\"b\": \"\u2029\"\n  }"
  assert_eq valid("{  \n\"\":\t{    \"b\" :  \"\"\t}\n,\"k<\"\t: \r\n \"\" , \"b\" \r\n : \r\n \"\u2029\"  }"), true
  assert_eq html_escape("{  \n\"\":\t{    \"b\" :  \"\"\t}\n,\"k<\"\t: \r\n \"\" , \"b\" \r\n : \r\n \"\u2029\"  }"), "{  \n\"\":\t{    \"b\" :  \"\"\t}\n,\"k\\u003c\"\t: \r\n \"\" , \"b\" \r\n : \r\n \"\\u2029\"  }"
  assert_eq cmp("\"a\""), "\"a\""
  assert_eq ind("\"a\"", "", "  "), "\"a\""
  assert_eq valid("\"a\""), true
  assert_eq html_escape("\"a\""), "\"a\""
  assert_eq cmp("{ \r\n  \"b\" :\n\"\\u2028x\\u2029\" \r\n ,\n\"a\":\n\"&amp;\",\n\"é\" :\t[ \r\n   [  \r\n 0 \r\n ,\tnull\n,  [ \r\n  \"\\\"q\\\"\"  ,\t\"\u2028\" \r\n , \r\n \"<&>\" \r\n ]   ]\n,\n[\n]\t\n] \r\n \n}"), "{\"b\":\"\\u2028x\\u2029\",\"a\":\"&amp;\",\"é\":[[0,null,[\"\\\"q\\\"\",\"\u2028\",\"<&>\"]],[]]}"
  assert_eq ind("{ \r\n  \"b\" :\n\"\\u2028x\\u2029\" \r\n ,\n\"a\":\n\"&amp;\",\n\"é\" :\t[ \r\n   [  \r\n 0 \r\n ,\tnull\n,  [ \r\n  \"\\\"q\\\"\"  ,\t\"\u2028\" \r\n , \r\n \"<&>\" \r\n ]   ]\n,\n[\n]\t\n] \r\n \n}", ">", "\t"), "{\n>\t\"b\": \"\\u2028x\\u2029\",\n>\t\"a\": \"&amp;\",\n>\t\"é\": [\n>\t\t[\n>\t\t\t0,\n>\t\t\tnull,\n>\t\t\t[\n>\t\t\t\t\"\\\"q\\\"\",\n>\t\t\t\t\"\u2028\",\n>\t\t\t\t\"<&>\"\n>\t\t\t]\n>\t\t],\n>\t\t[]\n>\t]\n>}"
  assert_eq valid("{ \r\n  \"b\" :\n\"\\u2028x\\u2029\" \r\n ,\n\"a\":\n\"&amp;\",\n\"é\" :\t[ \r\n   [  \r\n 0 \r\n ,\tnull\n,  [ \r\n  \"\\\"q\\\"\"  ,\t\"\u2028\" \r\n , \r\n \"<&>\" \r\n ]   ]\n,\n[\n]\t\n] \r\n \n}"), true
  assert_eq html_escape("{ \r\n  \"b\" :\n\"\\u2028x\\u2029\" \r\n ,\n\"a\":\n\"&amp;\",\n\"é\" :\t[ \r\n   [  \r\n 0 \r\n ,\tnull\n,  [ \r\n  \"\\\"q\\\"\"  ,\t\"\u2028\" \r\n , \r\n \"<&>\" \r\n ]   ]\n,\n[\n]\t\n] \r\n \n}"), "{ \r\n  \"b\" :\n\"\\u2028x\\u2029\" \r\n ,\n\"a\":\n\"\\u0026amp;\",\n\"é\" :\t[ \r\n   [  \r\n 0 \r\n ,\tnull\n,  [ \r\n  \"\\\"q\\\"\"  ,\t\"\\u2028\" \r\n , \r\n \"\\u003c\\u0026\\u003e\" \r\n ]   ]\n,\n[\n]\t\n] \r\n \n}"
  assert_eq cmp("\"tab\\t\""), "\"tab\\t\""
  assert_eq ind("\"tab\\t\"", "", ""), "\"tab\\t\""
  assert_eq valid("\"tab\\t\""), true
  assert_eq html_escape("\"tab\\t\""), "\"tab\\t\""
  assert_eq cmp("1e10"), "1e10"
  assert_eq ind("1e10", "  ", "-"), "1e10"
  assert_eq valid("1e10"), true
  assert_eq html_escape("1e10"), "1e10"
  assert_eq cmp("\"<b>\""), "\"<b>\""
  assert_eq ind("\"<b>\"", "", "  "), "\"<b>\""
  assert_eq valid("\"<b>\""), true
  assert_eq html_escape("\"<b>\""), "\"\\u003cb\\u003e\""
  assert_eq cmp("  null  "), "null"
  assert_eq ind("  null  ", ">", "\t"), "null  "
  assert_eq valid("  null  "), true
  assert_eq html_escape("  null  "), "  null  "
  assert_eq cmp(" \"\u2029\"\t"), "\"\u2029\""
  assert_eq ind(" \"\u2029\"\t", "", ""), "\"\u2029\"\t"
}

test "compact indent valid 13" {
  assert_eq valid(" \"\u2029\"\t"), true
  assert_eq html_escape(" \"\u2029\"\t"), " \"\\u2029\"\t"
  assert_eq cmp("false"), "false"
  assert_eq ind("false", "  ", "-"), "false"
  assert_eq valid("false"), true
  assert_eq html_escape("false"), "false"
  assert_eq cmp("{    \"a\" :  {   \"b\" \r\n :\n\"&amp;\" }\n,\t\"k<\" :  \"\u2028\" \r\n ,\"a\"  : true\t}"), "{\"a\":{\"b\":\"&amp;\"},\"k<\":\"\u2028\",\"a\":true}"
  assert_eq ind("{    \"a\" :  {   \"b\" \r\n :\n\"&amp;\" }\n,\t\"k<\" :  \"\u2028\" \r\n ,\"a\"  : true\t}", "", "  "), "{\n  \"a\": {\n    \"b\": \"&amp;\"\n  },\n  \"k<\": \"\u2028\",\n  \"a\": true\n}"
  assert_eq valid("{    \"a\" :  {   \"b\" \r\n :\n\"&amp;\" }\n,\t\"k<\" :  \"\u2028\" \r\n ,\"a\"  : true\t}"), true
  assert_eq html_escape("{    \"a\" :  {   \"b\" \r\n :\n\"&amp;\" }\n,\t\"k<\" :  \"\u2028\" \r\n ,\"a\"  : true\t}"), "{    \"a\" :  {   \"b\" \r\n :\n\"\\u0026amp;\" }\n,\t\"k\\u003c\" :  \"\\u2028\" \r\n ,\"a\"  : true\t}"
  assert_eq cmp("-1"), "-1"
  assert_eq ind("-1", ">", "\t"), "-1"
  assert_eq valid("-1"), true
  assert_eq html_escape("-1"), "-1"
  assert_eq cmp("\"é\\n\""), "\"é\\n\""
  assert_eq ind("\"é\\n\"", "", ""), "\"é\\n\""
  assert_eq valid("\"é\\n\""), true
  assert_eq html_escape("\"é\\n\""), "\"é\\n\""
  assert_eq cmp("{  \t}"), "{}"
  assert_eq ind("{  \t}", "  ", "-"), "{}"
  assert_eq valid("{  \t}"), true
  assert_eq html_escape("{  \t}"), "{  \t}"
  assert_eq cmp("\"\\\"q\\\"\""), "\"\\\"q\\\"\""
  assert_eq ind("\"\\\"q\\\"\"", "", "  "), "\"\\\"q\\\"\""
  assert_eq valid("\"\\\"q\\\"\""), true
  assert_eq html_escape("\"\\\"q\\\"\""), "\"\\\"q\\\"\""
  assert_eq cmp("true"), "true"
  assert_eq ind("true", ">", "\t"), "true"
  assert_eq valid("true"), true
  assert_eq html_escape("true"), "true"
  assert_eq cmp("\"&amp;\""), "\"&amp;\""
  assert_eq ind("\"&amp;\"", "", ""), "\"&amp;\""
  assert_eq valid("\"&amp;\""), true
  assert_eq html_escape("\"&amp;\""), "\"\\u0026amp;\""
  assert_eq cmp("123456789012345678901"), "123456789012345678901"
  assert_eq ind("123456789012345678901", "  ", "-"), "123456789012345678901"
  assert_eq valid("123456789012345678901"), true
  assert_eq html_escape("123456789012345678901"), "123456789012345678901"
  assert_eq cmp("\t[\t \r\n ]\n"), "[]"
  assert_eq ind("\t[\t \r\n ]\n", "", "  "), "[]\n"
  assert_eq valid("\t[\t \r\n ]\n"), true
  assert_eq html_escape("\t[\t \r\n ]\n"), "\t[\t \r\n ]\n"
  assert_eq cmp("\"\\u2028x\\u2029\""), "\"\\u2028x\\u2029\""
  assert_eq ind("\"\\u2028x\\u2029\"", ">", "\t"), "\"\\u2028x\\u2029\""
  assert_eq valid("\"\\u2028x\\u2029\""), true
  assert_eq html_escape("\"\\u2028x\\u2029\""), "\"\\u2028x\\u2029\""
  assert_eq cmp("{   }"), "{}"
  assert_eq ind("{   }", "", ""), "{}"
  assert_eq valid("{   }"), true
  assert_eq html_escape("{   }"), "{   }"
}

test "compact indent valid 14" {
  assert_eq cmp("\"<&>\""), "\"<&>\""
  assert_eq ind("\"<&>\"", "  ", "-"), "\"<&>\""
  assert_eq valid("\"<&>\""), true
  assert_eq html_escape("\"<&>\""), "\"\\u003c\\u0026\\u003e\""
  assert_eq cmp("\t{ \t\"a\" \r\n :\n\"\u2029\" \r\n  \r\n }\n"), "{\"a\":\"\u2029\"}"
  assert_eq ind("\t{ \t\"a\" \r\n :\n\"\u2029\" \r\n  \r\n }\n", "", "  "), "{\n  \"a\": \"\u2029\"\n}\n"
  assert_eq valid("\t{ \t\"a\" \r\n :\n\"\u2029\" \r\n  \r\n }\n"), true
  assert_eq html_escape("\t{ \t\"a\" \r\n :\n\"\u2029\" \r\n  \r\n }\n"), "\t{ \t\"a\" \r\n :\n\"\\u2029\" \r\n  \r\n }\n"
  assert_eq cmp("{\n \"\" :  [\t\t\"x\" , { } , \r\n 0 \r\n  \r\n ]  , \"é\" :{ \"a\" :\n\"<&>\"\t\n} \r\n ,\"\" : 0.000001  }"), "{\"\":[\"x\",{},0],\"é\":{\"a\":\"<&>\"},\"\":0.000001}"
  assert_eq ind("{\n \"\" :  [\t\t\"x\" , { } , \r\n 0 \r\n  \r\n ]  , \"é\" :{ \"a\" :\n\"<&>\"\t\n} \r\n ,\"\" : 0.000001  }", ">", "\t"), "{\n>\t\"\": [\n>\t\t\"x\",\n>\t\t{},\n>\t\t0\n>\t],\n>\t\"é\": {\n>\t\t\"a\": \"<&>\"\n>\t},\n>\t\"\": 0.000001\n>}"
  assert_eq valid("{\n \"\" :  [\t\t\"x\" , { } , \r\n 0 \r\n  \r\n ]  , \"é\" :{ \"a\" :\n\"<&>\"\t\n} \r\n ,\"\" : 0.000001  }"), true
  assert_eq html_escape("{\n \"\" :  [\t\t\"x\" , { } , \r\n 0 \r\n  \r\n ]  , \"é\" :{ \"a\" :\n\"<&>\"\t\n} \r\n ,\"\" : 0.000001  }"), "{\n \"\" :  [\t\t\"x\" , { } , \r\n 0 \r\n  \r\n ]  , \"é\" :{ \"a\" :\n\"\\u003c\\u0026\\u003e\"\t\n} \r\n ,\"\" : 0.000001  }"
  assert_eq cmp("1.5"), "1.5"
  assert_eq ind("1.5", "", ""), "1.5"
  assert_eq valid("1.5"), true
  assert_eq html_escape("1.5"), "1.5"
  assert_eq cmp("true"), "true"
  assert_eq ind("true", "  ", "-"), "true"
  assert_eq valid("true"), true
  assert_eq html_escape("true"), "true"
  assert_eq cmp("[ \t{  \t\"a\": [\n\"\u2029\" \r\n ,null ,[\n \r\n false \r\n ,\n\"\u2028\"  ,\t0.000001  ]\n\n]  , \"\"\t:\n{\t\"k<\"\t:\tfalse,\"\" \r\n : \r\n {\n\n\"\" :  \"x\"  , \r\n \"\": false\n,\"\"\t: \"<&>\"\n}\n, \r\n \"a\":\t\"\u2029\" \r\n  }\t}  ,\ttrue  ,\t{ \n\"é\"  : \"\\/\"  \t} \t]"), "[{\"a\":[\"\u2029\",null,[false,\"\u2028\",0.000001]],\"\":{\"k<\":false,\"\":{\"\":\"x\",\"\":false,\"\":\"<&>\"},\"a\":\"\u2029\"}},true,{\"é\":\"\\/\"}]"
  assert_eq ind("[ \t{  \t\"a\": [\n\"\u2029\" \r\n ,null ,[\n \r\n false \r\n ,\n\"\u2028\"  ,\t0.000001  ]\n\n]  , \"\"\t:\n{\t\"k<\"\t:\tfalse,\"\" \r\n : \r\n {\n\n\"\" :  \"x\"  , \r\n \"\": false\n,\"\"\t: \"<&>\"\n}\n, \r\n \"a\":\t\"\u2029\" \r\n  }\t}  ,\ttrue  ,\t{ \n\"é\"  : \"\\/\"  \t} \t]", "", "  "), "[\n  {\n    \"a\": [\n      \"\u2029\",\n      null,\n      [\n        false,\n        \"\u2028\",\n        0.000001\n      ]\n    ],\n    \"\": {\n      \"k<\": false,\n      \"\": {\n        \"\": \"x\",\n        \"\": false,\n        \"\": \"<&>\"\n      },\n      \"a\": \"\u2029\"\n    }\n  },\n  true,\n  {\n    \"é\": \"\\/\"\n  }\n]"
  assert_eq valid("[ \t{  \t\"a\": [\n\"\u2029\" \r\n ,null ,[\n \r\n false \r\n ,\n\"\u2028\"  ,\t0.000001  ]\n\n]  , \"\"\t:\n{\t\"k<\"\t:\tfalse,\"\" \r\n : \r\n {\n\n\"\" :  \"x\"  , \r\n \"\": false\n,\"\"\t: \"<&>\"\n}\n, \r\n \"a\":\t\"\u2029\" \r\n  }\t}  ,\ttrue  ,\t{ \n\"é\"  : \"\\/\"  \t} \t]"), true
  assert_eq html_escape("[ \t{  \t\"a\": [\n\"\u2029\" \r\n ,null ,[\n \r\n false \r\n ,\n\"\u2028\"  ,\t0.000001  ]\n\n]  , \"\"\t:\n{\t\"k<\"\t:\tfalse,\"\" \r\n : \r\n {\n\n\"\" :  \"x\"  , \r\n \"\": false\n,\"\"\t: \"<&>\"\n}\n, \r\n \"a\":\t\"\u2029\" \r\n  }\t}  ,\ttrue  ,\t{ \n\"é\"  : \"\\/\"  \t} \t]"), "[ \t{  \t\"a\": [\n\"\\u2029\" \r\n ,null ,[\n \r\n false \r\n ,\n\"\\u2028\"  ,\t0.000001  ]\n\n]  , \"\"\t:\n{\t\"k\\u003c\"\t:\tfalse,\"\" \r\n : \r\n {\n\n\"\" :  \"x\"  , \r\n \"\": false\n,\"\"\t: \"\\u003c\\u0026\\u003e\"\n}\n, \r\n \"a\":\t\"\\u2029\" \r\n  }\t}  ,\ttrue  ,\t{ \n\"é\"  : \"\\/\"  \t} \t]"
  assert_eq cmp("\"é\\n\""), "\"é\\n\""
  assert_eq ind("\"é\\n\"", ">", "\t"), "\"é\\n\""
  assert_eq valid("\"é\\n\""), true
  assert_eq html_escape("\"é\\n\""), "\"é\\n\""
  assert_eq cmp("{ \r\n   \"a\" \r\n :  {\t\t\"k<\"\t:\n\"<b>\"\t,\"a\"\t:\"x\"   \r\n }  \r\n }"), "{\"a\":{\"k<\":\"<b>\",\"a\":\"x\"}}"
  assert_eq ind("{ \r\n   \"a\" \r\n :  {\t\t\"k<\"\t:\n\"<b>\"\t,\"a\"\t:\"x\"   \r\n }  \r\n }", "", ""), "{\n\"a\": {\n\"k<\": \"<b>\",\n\"a\": \"x\"\n}\n}"
  assert_eq valid("{ \r\n   \"a\" \r\n :  {\t\t\"k<\"\t:\n\"<b>\"\t,\"a\"\t:\"x\"   \r\n }  \r\n }"), true
  assert_eq html_escape("{ \r\n   \"a\" \r\n :  {\t\t\"k<\"\t:\n\"<b>\"\t,\"a\"\t:\"x\"   \r\n }  \r\n }"), "{ \r\n   \"a\" \r\n :  {\t\t\"k\\u003c\"\t:\n\"\\u003cb\\u003e\"\t,\"a\"\t:\"x\"   \r\n }  \r\n }"
  assert_eq cmp("{\t\n\"b\" \r\n :-1\n}\n"), "{\"b\":-1}"
  assert_eq ind("{\t\n\"b\" \r\n :-1\n}\n", "  ", "-"), "{\n  -\"b\": -1\n  }\n"
  assert_eq valid("{\t\n\"b\" \r\n :-1\n}\n"), true
  assert_eq html_escape("{\t\n\"b\" \r\n :-1\n}\n"), "{\t\n\"b\" \r\n :-1\n}\n"
  assert_eq cmp("\"tab\\t\""), "\"tab\\t\""
  assert_eq ind("\"tab\\t\"", "", "  "), "\"tab\\t\""
  assert_eq valid("\"tab\\t\""), true
  assert_eq html_escape("\"tab\\t\""), "\"tab\\t\""
  assert_eq cmp("1e10"), "1e10"
  assert_eq ind("1e10", ">", "\t"), "1e10"
  assert_eq valid("1e10"), true
  assert_eq html_escape("1e10"), "1e10"
  assert_eq cmp("\"😀\""), "\"😀\""
  assert_eq ind("\"😀\"", "", ""), "\"😀\""
  assert_eq valid("\"😀\""), true
  assert_eq html_escape("\"😀\""), "\"😀\""
  assert_eq cmp("{ \r\n  \r\n }"), "{}"
  assert_eq ind("{ \r\n  \r\n }", "  ", "-"), "{}"
}

test "compact indent valid 15" {
  assert_eq valid("{ \r\n  \r\n }"), true
  assert_eq html_escape("{ \r\n  \r\n }"), "{ \r\n  \r\n }"
  assert_eq cmp("{  \t\"é\":[ ],\t\"a\"\n:[ \t[\n ]\t,\nnull\t,  {\t \"a\"  : { \t\"\" \r\n :null\n,  \"é\"  :  1.5, \"a\" :  \"😀\"  \n}  , \r\n \"é\"  :\"\\u2028x\\u2029\" \r\n \t}\n \r\n ]\n,  \"k<\"\n:\n0.000001\n}"), "{\"é\":[],\"a\":[[],null,{\"a\":{\"\":null,\"é\":1.5,\"a\":\"😀\"},\"é\":\"\\u2028x\\u2029\"}],\"k<\":0.000001}"
  assert_eq ind("{  \t\"é\":[ ],\t\"a\"\n:[ \t[\n ]\t,\nnull\t,  {\t \"a\"  : { \t\"\" \r\n :null\n,  \"é\"  :  1.5, \"a\" :  \"😀\"  \n}  , \r\n \"é\"  :\"\\u2028x\\u2029\" \r\n \t}\n \r\n ]\n,  \"k<\"\n:\n0.000001\n}", "", "  "), "{\n  \"é\": [],\n  \"a\": [\n    [],\n    null,\n    {\n      \"a\": {\n        \"\": null,\n        \"é\": 1.5,\n        \"a\": \"😀\"\n      },\n      \"é\": \"\\u2028x\\u2029\"\n    }\n  ],\n  \"k<\": 0.000001\n}"
  assert_eq valid("{  \t\"é\":[ ],\t\"a\"\n:[ \t[\n ]\t,\nnull\t,  {\t \"a\"  : { \t\"\" \r\n :null\n,  \"é\"  :  1.5, \"a\" :  \"😀\"  \n}  , \r\n \"é\"  :\"\\u2028x\\u2029\" \r\n \t}\n \r\n ]\n,  \"k<\"\n:\n0.000001\n}"), true
  assert_eq html_escape("{  \t\"é\":[ ],\t\"a\"\n:[ \t[\n ]\t,\nnull\t,  {\t \"a\"  : { \t\"\" \r\n :null\n,  \"é\"  :  1.5, \"a\" :  \"😀\"  \n}  , \r\n \"é\"  :\"\\u2028x\\u2029\" \r\n \t}\n \r\n ]\n,  \"k<\"\n:\n0.000001\n}"), "{  \t\"é\":[ ],\t\"a\"\n:[ \t[\n ]\t,\nnull\t,  {\t \"a\"  : { \t\"\" \r\n :null\n,  \"é\"  :  1.5, \"a\" :  \"😀\"  \n}  , \r\n \"é\"  :\"\\u2028x\\u2029\" \r\n \t}\n \r\n ]\n,  \"k\\u003c\"\n:\n0.000001\n}"
  assert_eq cmp("1.5"), "1.5"
  assert_eq ind("1.5", ">", "\t"), "1.5"
  assert_eq valid("1.5"), true
  assert_eq html_escape("1.5"), "1.5"
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "", ""), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp("true"), "true"
  assert_eq ind("true", "  ", "-"), "true"
  assert_eq valid("true"), true
  assert_eq html_escape("true"), "true"
  assert_eq cmp("-1"), "-1"
  assert_eq ind("-1", "", "  "), "-1"
  assert_eq valid("-1"), true
  assert_eq html_escape("-1"), "-1"
  assert_eq cmp("\n{ \r\n  \r\n \"\" :true \r\n ,\t\"a\" : {   \r\n \"é\"  :\"x\"  \r\n }  ,\n\"k<\"  :  \"\u2029\"\t}\n"), "{\"\":true,\"a\":{\"é\":\"x\"},\"k<\":\"\u2029\"}"
  assert_eq ind("\n{ \r\n  \r\n \"\" :true \r\n ,\t\"a\" : {   \r\n \"é\"  :\"x\"  \r\n }  ,\n\"k<\"  :  \"\u2029\"\t}\n", ">", "\t"), "{\n>\t\"\": true,\n>\t\"a\": {\n>\t\t\"é\": \"x\"\n>\t},\n>\t\"k<\": \"\u2029\"\n>}\n"
  assert_eq valid("\n{ \r\n  \r\n \"\" :true \r\n ,\t\"a\" : {   \r\n \"é\"  :\"x\"  \r\n }  ,\n\"k<\"  :  \"\u2029\"\t}\n"), true
  assert_eq html_escape("\n{ \r\n  \r\n \"\" :true \r\n ,\t\"a\" : {   \r\n \"é\"  :\"x\"  \r\n }  ,\n\"k<\"  :  \"\u2029\"\t}\n"), "\n{ \r\n  \r\n \"\" :true \r\n ,\t\"a\" : {   \r\n \"é\"  :\"x\"  \r\n }  ,\n\"k\\u003c\"  :  \"\\u2029\"\t}\n"
  assert_eq cmp("{  }"), "{}"
  assert_eq ind("{  }", "", ""), "{}"
  assert_eq valid("{  }"), true
  assert_eq html_escape("{  }"), "{  }"
  assert_eq cmp("\t\"tab\\t\"  "), "\"tab\\t\""
  assert_eq ind("\t\"tab\\t\"  ", "  ", "-"), "\"tab\\t\"  "
  assert_eq valid("\t\"tab\\t\"  "), true
  assert_eq html_escape("\t\"tab\\t\"  "), "\t\"tab\\t\"  "
  assert_eq cmp("  null\t"), "null"
  assert_eq ind("  null\t", "", "  "), "null\t"
  assert_eq valid("  null\t"), true
  assert_eq html_escape("  null\t"), "  null\t"
  assert_eq cmp("1.5"), "1.5"
  assert_eq ind("1.5", ">", "\t"), "1.5"
  assert_eq valid("1.5"), true
  assert_eq html_escape("1.5"), "1.5"
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "", ""), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp("1e10"), "1e10"
  assert_eq ind("1e10", "  ", "-"), "1e10"
  assert_eq valid("1e10"), true
  assert_eq html_escape("1e10"), "1e10"
}

test "compact indent valid 16" {
  assert_eq cmp("[  \"a b\"\t]"), "[\"a b\"]"
  assert_eq ind("[  \"a b\"\t]", "", "  "), "[\n  \"a b\"\n]"
  assert_eq valid("[  \"a b\"\t]"), true
  assert_eq html_escape("[  \"a b\"\t]"), "[  \"a b\"\t]"
  assert_eq cmp("[  false\t]"), "[false]"
  assert_eq ind("[  false\t]", ">", "\t"), "[\n>\tfalse\n>]"
  assert_eq valid("[  false\t]"), true
  assert_eq html_escape("[  false\t]"), "[  false\t]"
  assert_eq cmp("{    \"a\"\t:\n[   ]\t,\n\"k<\"\n: \r\n \"é\\n\"\n,\n\"a\"\n:  {\n  }  \n}"), "{\"a\":[],\"k<\":\"é\\n\",\"a\":{}}"
  assert_eq ind("{    \"a\"\t:\n[   ]\t,\n\"k<\"\n: \r\n \"é\\n\"\n,\n\"a\"\n:  {\n  }  \n}", "", ""), "{\n\"a\": [],\n\"k<\": \"é\\n\",\n\"a\": {}\n}"
  assert_eq valid("{    \"a\"\t:\n[   ]\t,\n\"k<\"\n: \r\n \"é\\n\"\n,\n\"a\"\n:  {\n  }  \n}"), true
  assert_eq html_escape("{    \"a\"\t:\n[   ]\t,\n\"k<\"\n: \r\n \"é\\n\"\n,\n\"a\"\n:  {\n  }  \n}"), "{    \"a\"\t:\n[   ]\t,\n\"k\\u003c\"\n: \r\n \"é\\n\"\n,\n\"a\"\n:  {\n  }  \n}"
  assert_eq cmp(" \r\n \"😀\" \r\n "), "\"😀\""
  assert_eq ind(" \r\n \"😀\" \r\n ", "  ", "-"), "\"😀\" \r\n "
  assert_eq valid(" \r\n \"😀\" \r\n "), true
  assert_eq html_escape(" \r\n \"😀\" \r\n "), " \r\n \"😀\" \r\n "
  assert_eq cmp("false"), "false"
  assert_eq ind("false", "", "  "), "false"
  assert_eq valid("false"), true
  assert_eq html_escape("false"), "false"
  assert_eq cmp("\t0 \r\n "), "0"
  assert_eq ind("\t0 \r\n ", ">", "\t"), "0 \r\n>"
  assert_eq valid("\t0 \r\n "), true
  assert_eq html_escape("\t0 \r\n "), "\t0 \r\n "
  assert_eq cmp("[\n\t]"), "[]"
  assert_eq ind("[\n\t]", "", ""), "[]"
  assert_eq valid("[\n\t]"), true
  assert_eq html_escape("[\n\t]"), "[\n\t]"
  assert_eq cmp("  1.5 "), "1.5"
  assert_eq ind("  1.5 ", "  ", "-"), "1.5 "
  assert_eq valid("  1.5 "), true
  assert_eq html_escape("  1.5 "), "  1.5 "
  assert_eq cmp("{\"b\":  \"a b\" \r\n ,\n\"b\": \"tab\\t\"\t}"), "{\"b\":\"a b\",\"b\":\"tab\\t\"}"
  assert_eq ind("{\"b\":  \"a b\" \r\n ,\n\"b\": \"tab\\t\"\t}", "", "  "), "{\n  \"b\": \"a b\",\n  \"b\": \"tab\\t\"\n}"
  assert_eq valid("{\"b\":  \"a b\" \r\n ,\n\"b\": \"tab\\t\"\t}"), true
  assert_eq html_escape("{\"b\":  \"a b\" \r\n ,\n\"b\": \"tab\\t\"\t}"), "{\"b\":  \"a b\" \r\n ,\n\"b\": \"tab\\t\"\t}"
  assert_eq cmp("false"), "false"
  assert_eq ind("false", ">", "\t"), "false"
  assert_eq valid("false"), true
  assert_eq html_escape("false"), "false"
  assert_eq cmp("\"a b\""), "\"a b\""
  assert_eq ind("\"a b\"", "", ""), "\"a b\""
  assert_eq valid("\"a b\""), true
  assert_eq html_escape("\"a b\""), "\"a b\""
  assert_eq cmp("\"x\""), "\"x\""
  assert_eq ind("\"x\"", "  ", "-"), "\"x\""
  assert_eq valid("\"x\""), true
  assert_eq html_escape("\"x\""), "\"x\""
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "", "  "), "null"
}

test "compact indent valid 17" {
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp("  false "), "false"
  assert_eq ind("  false ", ">", "\t"), "false "
  assert_eq valid("  false "), true
  assert_eq html_escape("  false "), "  false "
  assert_eq cmp("  null"), "null"
  assert_eq ind("  null", "", ""), "null"
  assert_eq valid("  null"), true
  assert_eq html_escape("  null"), "  null"
  assert_eq cmp("-2.5E-3"), "-2.5E-3"
  assert_eq ind("-2.5E-3", "  ", "-"), "-2.5E-3"
  assert_eq valid("-2.5E-3"), true
  assert_eq html_escape("-2.5E-3"), "-2.5E-3"
  assert_eq cmp("  { } \r\n "), "{}"
  assert_eq ind("  { } \r\n ", "", "  "), "{} \r\n "
  assert_eq valid("  { } \r\n "), true
  assert_eq html_escape("  { } \r\n "), "  { } \r\n "
  assert_eq cmp("[  \r\n {\n} \r\n ,\"&amp;\" \r\n ]"), "[{},\"&amp;\"]"
  assert_eq ind("[  \r\n {\n} \r\n ,\"&amp;\" \r\n ]", ">", "\t"), "[\n>\t{},\n>\t\"&amp;\"\n>]"
  assert_eq valid("[  \r\n {\n} \r\n ,\"&amp;\" \r\n ]"), true
  assert_eq html_escape("[  \r\n {\n} \r\n ,\"&amp;\" \r\n ]"), "[  \r\n {\n} \r\n ,\"\\u0026amp;\" \r\n ]"
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "", ""), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp(" \"x\"\t"), "\"x\""
  assert_eq ind(" \"x\"\t", "  ", "-"), "\"x\"\t"
  assert_eq valid(" \"x\"\t"), true
  assert_eq html_escape(" \"x\"\t"), " \"x\"\t"
  assert_eq cmp("0.000001"), "0.000001"
  assert_eq ind("0.000001", "", "  "), "0.000001"
  assert_eq valid("0.000001"), true
  assert_eq html_escape("0.000001"), "0.000001"
  assert_eq cmp("{\n  \"é\": [123456789012345678901\t, \"😀\"\n,  \"a b\" \r\n ] \r\n , \"é\":\n\"<b>\"\t }"), "{\"é\":[123456789012345678901,\"😀\",\"a b\"],\"é\":\"<b>\"}"
  assert_eq ind("{\n  \"é\": [123456789012345678901\t, \"😀\"\n,  \"a b\" \r\n ] \r\n , \"é\":\n\"<b>\"\t }", ">", "\t"), "{\n>\t\"é\": [\n>\t\t123456789012345678901,\n>\t\t\"😀\",\n>\t\t\"a b\"\n>\t],\n>\t\"é\": \"<b>\"\n>}"
  assert_eq valid("{\n  \"é\": [123456789012345678901\t, \"😀\"\n,  \"a b\" \r\n ] \r\n , \"é\":\n\"<b>\"\t }"), true
  assert_eq html_escape("{\n  \"é\": [123456789012345678901\t, \"😀\"\n,  \"a b\" \r\n ] \r\n , \"é\":\n\"<b>\"\t }"), "{\n  \"é\": [123456789012345678901\t, \"😀\"\n,  \"a b\" \r\n ] \r\n , \"é\":\n\"\\u003cb\\u003e\"\t }"
  assert_eq cmp("{  \r\n \"k<\" \r\n :\ntrue\n,\"é\": \r\n null   }"), "{\"k<\":true,\"é\":null}"
  assert_eq ind("{  \r\n \"k<\" \r\n :\ntrue\n,\"é\": \r\n null   }", "", ""), "{\n\"k<\": true,\n\"é\": null\n}"
  assert_eq valid("{  \r\n \"k<\" \r\n :\ntrue\n,\"é\": \r\n null   }"), true
  assert_eq html_escape("{  \r\n \"k<\" \r\n :\ntrue\n,\"é\": \r\n null   }"), "{  \r\n \"k\\u003c\" \r\n :\ntrue\n,\"é\": \r\n null   }"
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "  ", "-"), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp(" [ {\n \"a\"\t:\t[ \r\n \n]   \r\n } \r\n ]  "), "[{\"a\":[]}]"
  assert_eq ind(" [ {\n \"a\"\t:\t[ \r\n \n]   \r\n } \r\n ]  ", "", "  "), "[\n  {\n    \"a\": []\n  }\n]  "
  assert_eq valid(" [ {\n \"a\"\t:\t[ \r\n \n]   \r\n } \r\n ]  "), true
  assert_eq html_escape(" [ {\n \"a\"\t:\t[ \r\n \n]   \r\n } \r\n ]  "), " [ {\n \"a\"\t:\t[ \r\n \n]   \r\n } \r\n ]  "
}

test "compact indent valid 18" {
  assert_eq cmp("[\t [\"\\/\"\t]\t,  123456789012345678901 , \"\\u2028x\\u2029\" ]"), "[[\"\\/\"],123456789012345678901,\"\\u2028x\\u2029\"]"
  assert_eq ind("[\t [\"\\/\"\t]\t,  123456789012345678901 , \"\\u2028x\\u2029\" ]", ">", "\t"), "[\n>\t[\n>\t\t\"\\/\"\n>\t],\n>\t123456789012345678901,\n>\t\"\\u2028x\\u2029\"\n>]"
  assert_eq valid("[\t [\"\\/\"\t]\t,  123456789012345678901 , \"\\u2028x\\u2029\" ]"), true
  assert_eq html_escape("[\t [\"\\/\"\t]\t,  123456789012345678901 , \"\\u2028x\\u2029\" ]"), "[\t [\"\\/\"\t]\t,  123456789012345678901 , \"\\u2028x\\u2029\" ]"
  assert_eq cmp(" \r\n \"<&>\" "), "\"<&>\""
  assert_eq ind(" \r\n \"<&>\" ", "", ""), "\"<&>\" "
  assert_eq valid(" \r\n \"<&>\" "), true
  assert_eq html_escape(" \r\n \"<&>\" "), " \r\n \"\\u003c\\u0026\\u003e\" "
  assert_eq cmp("\"\u2028\""), "\"\u2028\""
  assert_eq ind("\"\u2028\"", "  ", "-"), "\"\u2028\""
  assert_eq valid("\"\u2028\""), true
  assert_eq html_escape("\"\u2028\""), "\"\\u2028\""
  assert_eq cmp("\"\\\"q\\\"\""), "\"\\\"q\\\"\""
  assert_eq ind("\"\\\"q\\\"\"", "", "  "), "\"\\\"q\\\"\""
  assert_eq valid("\"\\\"q\\\"\""), true
  assert_eq html_escape("\"\\\"q\\\"\""), "\"\\\"q\\\"\""
  assert_eq cmp("\"<b>\""), "\"<b>\""
  assert_eq ind("\"<b>\"", ">", "\t"), "\"<b>\""
  assert_eq valid("\"<b>\""), true
  assert_eq html_escape("\"<b>\""), "\"\\u003cb\\u003e\""
  assert_eq cmp("-1"), "-1"
  assert_eq ind("-1", "", ""), "-1"
  assert_eq valid("-1"), true
  assert_eq html_escape("-1"), "-1"
  assert_eq cmp("  1e10  "), "1e10"
  assert_eq ind("  1e10  ", "  ", "-"), "1e10  "
  assert_eq valid("  1e10  "), true
  assert_eq html_escape("  1e10  "), "  1e10  "
  assert_eq cmp("[  false\t]"), "[false]"
  assert_eq ind("[  false\t]", "", "  "), "[\n  false\n]"
  assert_eq valid("[  false\t]"), true
  assert_eq html_escape("[  false\t]"), "[  false\t]"
  assert_eq cmp("\"\\u2028x\\u2029\""), "\"\\u2028x\\u2029\""
  assert_eq ind("\"\\u2028x\\u2029\"", ">", "\t"), "\"\\u2028x\\u2029\""
  assert_eq valid("\"\\u2028x\\u2029\""), true
  assert_eq html_escape("\"\\u2028x\\u2029\""), "\"\\u2028x\\u2029\""
  assert_eq cmp("  {  \"a\"\n:\nnull, \"b\"\t:false \t} "), "{\"a\":null,\"b\":false}"
  assert_eq ind("  {  \"a\"\n:\nnull, \"b\"\t:false \t} ", "", ""), "{\n\"a\": null,\n\"b\": false\n} "
  assert_eq valid("  {  \"a\"\n:\nnull, \"b\"\t:false \t} "), true
  assert_eq html_escape("  {  \"a\"\n:\nnull, \"b\"\t:false \t} "), "  {  \"a\"\n:\nnull, \"b\"\t:false \t} "
  assert_eq cmp("\"x\""), "\"x\""
  assert_eq ind("\"x\"", "  ", "-"), "\"x\""
  assert_eq valid("\"x\""), true
  assert_eq html_escape("\"x\""), "\"x\""
  assert_eq cmp("\"\""), "\"\""
  assert_eq ind("\"\"", "", "  "), "\"\""
  assert_eq valid("\"\""), true
  assert_eq html_escape("\"\""), "\"\""
  assert_eq cmp(" [\n \r\n ] \r\n "), "[]"
  assert_eq ind(" [\n \r\n ] \r\n ", ">", "\t"), "[] \r\n>"
}

test "compact indent valid 19" {
  assert_eq valid(" [\n \r\n ] \r\n "), true
  assert_eq html_escape(" [\n \r\n ] \r\n "), " [\n \r\n ] \r\n "
  assert_eq cmp("[\t {\n\"é\"\t:\nfalse ,  \"a\"\n:\"&amp;\"\n } ,\t\"😀\"\t\n]"), "[{\"é\":false,\"a\":\"&amp;\"},\"😀\"]"
  assert_eq ind("[\t {\n\"é\"\t:\nfalse ,  \"a\"\n:\"&amp;\"\n } ,\t\"😀\"\t\n]", "", ""), "[\n{\n\"é\": false,\n\"a\": \"&amp;\"\n},\n\"😀\"\n]"
  assert_eq valid("[\t {\n\"é\"\t:\nfalse ,  \"a\"\n:\"&amp;\"\n } ,\t\"😀\"\t\n]"), true
  assert_eq html_escape("[\t {\n\"é\"\t:\nfalse ,  \"a\"\n:\"&amp;\"\n } ,\t\"😀\"\t\n]"), "[\t {\n\"é\"\t:\nfalse ,  \"a\"\n:\"\\u0026amp;\"\n } ,\t\"😀\"\t\n]"
  assert_eq cmp("[\t  \"\u2029\" \r\n , \r\n \"x\"\n, false\n]"), "[\"\u2029\",\"x\",false]"
  assert_eq ind("[\t  \"\u2029\" \r\n , \r\n \"x\"\n, false\n]", "  ", "-"), "[\n  -\"\u2029\",\n  -\"x\",\n  -false\n  ]"
  assert_eq valid("[\t  \"\u2029\" \r\n , \r\n \"x\"\n, false\n]"), true
  assert_eq html_escape("[\t  \"\u2029\" \r\n , \r\n \"x\"\n, false\n]"), "[\t  \"\\u2029\" \r\n , \r\n \"x\"\n, false\n]"
  assert_eq cmp("  [\n\t\"&amp;\" ,\n0.000001 , [  \"\\u2028x\\u2029\" , \"😀\"  ]   ] \r\n "), "[\"&amp;\",0.000001,[\"\\u2028x\\u2029\",\"😀\"]]"
  assert_eq ind("  [\n\t\"&amp;\" ,\n0.000001 , [  \"\\u2028x\\u2029\" , \"😀\"  ]   ] \r\n ", "", "  "), "[\n  \"&amp;\",\n  0.000001,\n  [\n    \"\\u2028x\\u2029\",\n    \"😀\"\n  ]\n] \r\n "
  assert_eq valid("  [\n\t\"&amp;\" ,\n0.000001 , [  \"\\u2028x\\u2029\" , \"😀\"  ]   ] \r\n "), true
  assert_eq html_escape("  [\n\t\"&amp;\" ,\n0.000001 , [  \"\\u2028x\\u2029\" , \"😀\"  ]   ] \r\n "), "  [\n\t\"\\u0026amp;\" ,\n0.000001 , [  \"\\u2028x\\u2029\" , \"😀\"  ]   ] \r\n "
  assert_eq cmp("true"), "true"
  assert_eq ind("true", ">", "\t"), "true"
  assert_eq valid("true"), true
  assert_eq html_escape("true"), "true"
  assert_eq cmp("[  \ttrue \r\n ]"), "[true]"
  assert_eq ind("[  \ttrue \r\n ]", "", ""), "[\ntrue\n]"
  assert_eq valid("[  \ttrue \r\n ]"), true
  assert_eq html_escape("[  \ttrue \r\n ]"), "[  \ttrue \r\n ]"
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "  ", "-"), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp("{\n  }"), "{}"
  assert_eq ind("{\n  }", "", "  "), "{}"
  assert_eq valid("{\n  }"), true
  assert_eq html_escape("{\n  }"), "{\n  }"
  assert_eq cmp("\t{ \t}\n"), "{}"
  assert_eq ind("\t{ \t}\n", ">", "\t"), "{}\n"
  assert_eq valid("\t{ \t}\n"), true
  assert_eq html_escape("\t{ \t}\n"), "\t{ \t}\n"
  assert_eq cmp("[   [\n\t]   ]"), "[[]]"
  assert_eq ind("[   [\n\t]   ]", "", ""), "[\n[]\n]"
  assert_eq valid("[   [\n\t]   ]"), true
  assert_eq html_escape("[   [\n\t]   ]"), "[   [\n\t]   ]"
  assert_eq cmp("\"😀\""), "\"😀\""
  assert_eq ind("\"😀\"", "  ", "-"), "\"😀\""
  assert_eq valid("\"😀\""), true
  assert_eq html_escape("\"😀\""), "\"😀\""
  assert_eq cmp("[\n  {\n\n\"é\":\tnull ,\"b\" :\"\\u2028x\\u2029\" \r\n  }\n,[ \r\n ]\t,  { \r\n \n\"a\"  :  \"<&>\" \r\n ,\n\"a\"\t:true\t \r\n }\t\n]"), "[{\"é\":null,\"b\":\"\\u2028x\\u2029\"},[],{\"a\":\"<&>\",\"a\":true}]"
  assert_eq ind("[\n  {\n\n\"é\":\tnull ,\"b\" :\"\\u2028x\\u2029\" \r\n  }\n,[ \r\n ]\t,  { \r\n \n\"a\"  :  \"<&>\" \r\n ,\n\"a\"\t:true\t \r\n }\t\n]", "", "  "), "[\n  {\n    \"é\": null,\n    \"b\": \"\\u2028x\\u2029\"\n  },\n  [],\n  {\n    \"a\": \"<&>\",\n    \"a\": true\n  }\n]"
  assert_eq valid("[\n  {\n\n\"é\":\tnull ,\"b\" :\"\\u2028x\\u2029\" \r\n  }\n,[ \r\n ]\t,  { \r\n \n\"a\"  :  \"<&>\" \r\n ,\n\"a\"\t:true\t \r\n }\t\n]"), true
  assert_eq html_escape("[\n  {\n\n\"é\":\tnull ,\"b\" :\"\\u2028x\\u2029\" \r\n  }\n,[ \r\n ]\t,  { \r\n \n\"a\"  :  \"<&>\" \r\n ,\n\"a\"\t:true\t \r\n }\t\n]"), "[\n  {\n\n\"é\":\tnull ,\"b\" :\"\\u2028x\\u2029\" \r\n  }\n,[ \r\n ]\t,  { \r\n \n\"a\"  :  \"\\u003c\\u0026\\u003e\" \r\n ,\n\"a\"\t:true\t \r\n }\t\n]"
  assert_eq cmp("\"a b\""), "\"a b\""
  assert_eq ind("\"a b\"", ">", "\t"), "\"a b\""
  assert_eq valid("\"a b\""), true
  assert_eq html_escape("\"a b\""), "\"a b\""
}

test "compact indent valid 20" {
  assert_eq cmp("[\t\t1e10 \r\n \n]"), "[1e10]"
  assert_eq ind("[\t\t1e10 \r\n \n]", "", ""), "[\n1e10\n]"
  assert_eq valid("[\t\t1e10 \r\n \n]"), true
  assert_eq html_escape("[\t\t1e10 \r\n \n]"), "[\t\t1e10 \r\n \n]"
  assert_eq cmp("false"), "false"
  assert_eq ind("false", "  ", "-"), "false"
  assert_eq valid("false"), true
  assert_eq html_escape("false"), "false"
  assert_eq cmp("true"), "true"
  assert_eq ind("true", "", "  "), "true"
  assert_eq valid("true"), true
  assert_eq html_escape("true"), "true"
  assert_eq cmp("[]"), "[]"
  assert_eq ind("[]", ">", "\t"), "[]"
  assert_eq valid("[]"), true
  assert_eq html_escape("[]"), "[]"
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "", ""), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp(" \r\n \"😀\""), "\"😀\""
  assert_eq ind(" \r\n \"😀\"", "  ", "-"), "\"😀\""
  assert_eq valid(" \r\n \"😀\""), true
  assert_eq html_escape(" \r\n \"😀\""), " \r\n \"😀\""
  assert_eq cmp("[   \r\n \"&amp;\" \r\n , \"tab\\t\"\n \r\n ]"), "[\"&amp;\",\"tab\\t\"]"
  assert_eq ind("[   \r\n \"&amp;\" \r\n , \"tab\\t\"\n \r\n ]", "", "  "), "[\n  \"&amp;\",\n  \"tab\\t\"\n]"
  assert_eq valid("[   \r\n \"&amp;\" \r\n , \"tab\\t\"\n \r\n ]"), true
  assert_eq html_escape("[   \r\n \"&amp;\" \r\n , \"tab\\t\"\n \r\n ]"), "[   \r\n \"\\u0026amp;\" \r\n , \"tab\\t\"\n \r\n ]"
  assert_eq cmp("\"a\""), "\"a\""
  assert_eq ind("\"a\"", ">", "\t"), "\"a\""
  assert_eq valid("\"a\""), true
  assert_eq html_escape("\"a\""), "\"a\""
  assert_eq cmp(" -2.5E-3\t"), "-2.5E-3"
  assert_eq ind(" -2.5E-3\t", "", ""), "-2.5E-3\t"
  assert_eq valid(" -2.5E-3\t"), true
  assert_eq html_escape(" -2.5E-3\t"), " -2.5E-3\t"
  assert_eq cmp("{\n\n}"), "{}"
  assert_eq ind("{\n\n}", "  ", "-"), "{}"
  assert_eq valid("{\n\n}"), true
  assert_eq html_escape("{\n\n}"), "{\n\n}"
  assert_eq cmp("{ \r\n  \r\n \"k<\" :  [  \r\n [{\n \r\n },  \"a b\"\n\n]\n,{   \"\"\n:\nnul }\n, \r\n true \r\n ]\t, \r\n \"é\" \r\n :\t{ \r\n \"b\"\t:  \"😀\"\n, \"\" \r\n :{\n\"\"  : \"<&>\"\n, \"\"\n:\n{\n\"b\"\t:true ,\n\"é\" \r\n :\ttrue\t\n}\t\n},  \"a\"  :  [\n \r\n ] \r\n  } \r\n ,\n\"b\"\t:\t{ \r\n \"b\": {\t\"k<\"\n:\n\"<b>\"\n}\n, \"\" : \r\n \"x\",  \"é\":  \"<b>\"  \n}\n }"), "error: invalid character ' ' in literal null (expecting 'l') @57"
  assert_eq ind("{ \r\n  \r\n \"k<\" :  [  \r\n [{\n \r\n },  \"a b\"\n\n]\n,{   \"\"\n:\nnul }\n, \r\n true \r\n ]\t, \r\n \"é\" \r\n :\t{ \r\n \"b\"\t:  \"😀\"\n, \"\" \r\n :{\n\"\"  : \"<&>\"\n, \"\"\n:\n{\n\"b\"\t:true ,\n\"é\" \r\n :\ttrue\t\n}\t\n},  \"a\"  :  [\n \r\n ] \r\n  } \r\n ,\n\"b\"\t:\t{ \r\n \"b\": {\t\"k<\"\n:\n\"<b>\"\n}\n, \"\" : \r\n \"x\",  \"é\":  \"<b>\"  \n}\n }", "", "  "), "error: invalid character ' ' in literal null (expecting 'l') @57"
  assert_eq valid("{ \r\n  \r\n \"k<\" :  [  \r\n [{\n \r\n },  \"a b\"\n\n]\n,{   \"\"\n:\nnul }\n, \r\n true \r\n ]\t, \r\n \"é\" \r\n :\t{ \r\n \"b\"\t:  \"😀\"\n, \"\" \r\n :{\n\"\"  : \"<&>\"\n, \"\"\n:\n{\n\"b\"\t:true ,\n\"é\" \r\n :\ttrue\t\n}\t\n},  \"a\"  :  [\n \r\n ] \r\n  } \r\n ,\n\"b\"\t:\t{ \r\n \"b\": {\t\"k<\"\n:\n\"<b>\"\n}\n, \"\" : \r\n \"x\",  \"é\":  \"<b>\"  \n}\n }"), false
  assert_eq html_escape("{ \r\n  \r\n \"k<\" :  [  \r\n [{\n \r\n },  \"a b\"\n\n]\n,{   \"\"\n:\nnul }\n, \r\n true \r\n ]\t, \r\n \"é\" \r\n :\t{ \r\n \"b\"\t:  \"😀\"\n, \"\" \r\n :{\n\"\"  : \"<&>\"\n, \"\"\n:\n{\n\"b\"\t:true ,\n\"é\" \r\n :\ttrue\t\n}\t\n},  \"a\"  :  [\n \r\n ] \r\n  } \r\n ,\n\"b\"\t:\t{ \r\n \"b\": {\t\"k<\"\n:\n\"<b>\"\n}\n, \"\" : \r\n \"x\",  \"é\":  \"<b>\"  \n}\n }"), "{ \r\n  \r\n \"k\\u003c\" :  [  \r\n [{\n \r\n },  \"a b\"\n\n]\n,{   \"\"\n:\nnul }\n, \r\n true \r\n ]\t, \r\n \"é\" \r\n :\t{ \r\n \"b\"\t:  \"😀\"\n, \"\" \r\n :{\n\"\"  : \"\\u003c\\u0026\\u003e\"\n, \"\"\n:\n{\n\"b\"\t:true ,\n\"é\" \r\n :\ttrue\t\n}\t\n},  \"a\"  :  [\n \r\n ] \r\n  } \r\n ,\n\"b\"\t:\t{ \r\n \"b\": {\t\"k\\u003c\"\n:\n\"\\u003cb\\u003e\"\n}\n, \"\" : \r\n \"x\",  \"é\":  \"\\u003cb\\u003e\"  \n}\n }"
  assert_eq cmp("[\tnul \r\n ,1e10\t,\ttrue\t ]"), "error: invalid character ' ' in literal null (expecting 'l') @6"
  assert_eq ind("[\tnul \r\n ,1e10\t,\ttrue\t ]", ">", "\t"), "error: invalid character ' ' in literal null (expecting 'l') @6"
  assert_eq valid("[\tnul \r\n ,1e10\t,\ttrue\t ]"), false
  assert_eq html_escape("[\tnul \r\n ,1e10\t,\ttrue\t ]"), "[\tnul \r\n ,1e10\t,\ttrue\t ]"
  assert_eq cmp("{ \r\n \t\"\" : \"\\/\"  \r\n }"), "{\"\":\"\\/\"}"
  assert_eq ind("{ \r\n \t\"\" : \"\\/\"  \r\n }", "", ""), "{\n\"\": \"\\/\"\n}"
}

test "compact indent valid 21" {
  assert_eq valid("{ \r\n \t\"\" : \"\\/\"  \r\n }"), true
  assert_eq html_escape("{ \r\n \t\"\" : \"\\/\"  \r\n }"), "{ \r\n \t\"\" : \"\\/\"  \r\n }"
  assert_eq cmp("tre"), "error: invalid character 'e' in literal true (expecting 'u') @3"
  assert_eq ind("tre", "  ", "-"), "error: invalid character 'e' in literal true (expecting 'u') @3"
  assert_eq valid("tre"), false
  assert_eq html_escape("tre"), "tre"
  assert_eq cmp("\"x"), "error: unexpected end of JSON input @2"
  assert_eq ind("\"x", "", "  "), "error: unexpected end of JSON input @2"
  assert_eq valid("\"x"), false
  assert_eq html_escape("\"x"), "\"x"
  assert_eq cmp("nll"), "error: invalid character 'l' in literal null (expecting 'u') @2"
  assert_eq ind("nll", ">", "\t"), "error: invalid character 'l' in literal null (expecting 'u') @2"
  assert_eq valid("nll"), false
  assert_eq html_escape("nll"), "nll"
  assert_eq cmp("{\r\n   \"a\" : \r\n \"é\\n\"\n, \r\n \"k<\"  :\n{\t \r\n \"\":\n-1\t,\t\"k<\":\t-1 , \"k<\": \r\n \"\\\"q\\\"\"\t\t}\t\n}"), "{\"a\":\"é\\n\",\"k<\":{\"\":-1,\"k<\":-1,\"k<\":\"\\\"q\\\"\"}}"
  assert_eq ind("{\r\n   \"a\" : \r\n \"é\\n\"\n, \r\n \"k<\"  :\n{\t \r\n \"\":\n-1\t,\t\"k<\":\t-1 , \"k<\": \r\n \"\\\"q\\\"\"\t\t}\t\n}", "", ""), "{\n\"a\": \"é\\n\",\n\"k<\": {\n\"\": -1,\n\"k<\": -1,\n\"k<\": \"\\\"q\\\"\"\n}\n}"
  assert_eq valid("{\r\n   \"a\" : \r\n \"é\\n\"\n, \r\n \"k<\"  :\n{\t \r\n \"\":\n-1\t,\t\"k<\":\t-1 , \"k<\": \r\n \"\\\"q\\\"\"\t\t}\t\n}"), true
  assert_eq html_escape("{\r\n   \"a\" : \r\n \"é\\n\"\n, \r\n \"k<\"  :\n{\t \r\n \"\":\n-1\t,\t\"k<\":\t-1 , \"k<\": \r\n \"\\\"q\\\"\"\t\t}\t\n}"), "{\r\n   \"a\" : \r\n \"é\\n\"\n, \r\n \"k\\u003c\"  :\n{\t \r\n \"\":\n-1\t,\t\"k\\u003c\":\t-1 , \"k\\u003c\": \r\n \"\\\"q\\\"\"\t\t}\t\n}"
  assert_eq cmp("\"a b"), "error: unexpected end of JSON input @4"
  assert_eq ind("\"a b", "  ", "-"), "error: unexpected end of JSON input @4"
  assert_eq valid("\"a b"), false
  assert_eq html_escape("\"a b"), "\"a b"
  assert_eq cmp("1e0"), "1e0"
  assert_eq ind("1e0", "", "  "), "1e0"
  assert_eq valid("1e0"), true
  assert_eq html_escape("1e0"), "1e0"
  assert_eq cmp("\u2028\""), "error: invalid character '\\u2028' looking for beginning of value @3"
  assert_eq ind("\u2028\"", ">", "\t"), "error: invalid character '\\u2028' looking for beginning of value @3"
  assert_eq valid("\u2028\""), false
  assert_eq html_escape("\u2028\""), "\\u2028\""
  assert_eq cmp("tab\\t\""), "error: invalid character 'a' in literal true (expecting 'r') @2"
  assert_eq ind("tab\\t\"", "", ""), "error: invalid character 'a' in literal true (expecting 'r') @2"
  assert_eq valid("tab\\t\""), false
  assert_eq html_escape("tab\\t\""), "tab\\t\""
  assert_eq cmp("[\n\"tab\\t\"  ,\n{\t \r\n \"a\": \r\n 0.000001 , \"k<\" : \r\n[\n] , \r\n \"b\" \r\n : \r\n false    }\n,[  true \r\n ,\"\u2029\"  ,\nfalse\n] \n]"), "[\"tab\\t\",{\"a\":0.000001,\"k<\":[],\"b\":false},[true,\"\u2029\",false]]"
  assert_eq ind("[\n\"tab\\t\"  ,\n{\t \r\n \"a\": \r\n 0.000001 , \"k<\" : \r\n[\n] , \r\n \"b\" \r\n : \r\n false    }\n,[  true \r\n ,\"\u2029\"  ,\nfalse\n] \n]", "  ", "-"), "[\n  -\"tab\\t\",\n  -{\n  --\"a\": 0.000001,\n  --\"k<\": [],\n  --\"b\": false\n  -},\n  -[\n  --true,\n  --\"\u2029\",\n  --false\n  -]\n  ]"
  assert_eq valid("[\n\"tab\\t\"  ,\n{\t \r\n \"a\": \r\n 0.000001 , \"k<\" : \r\n[\n] , \r\n \"b\" \r\n : \r\n false    }\n,[  true \r\n ,\"\u2029\"  ,\nfalse\n] \n]"), true
  assert_eq html_escape("[\n\"tab\\t\"  ,\n{\t \r\n \"a\": \r\n 0.000001 , \"k<\" : \r\n[\n] , \r\n \"b\" \r\n : \r\n false    }\n,[  true \r\n ,\"\u2029\"  ,\nfalse\n] \n]"), "[\n\"tab\\t\"  ,\n{\t \r\n \"a\": \r\n 0.000001 , \"k\\u003c\" : \r\n[\n] , \r\n \"b\" \r\n : \r\n false    }\n,[  true \r\n ,\"\\u2029\"  ,\nfalse\n] \n]"
  assert_eq cmp("{\"a\"  :  false    \"é\" :\n\"😀\"  \t}"), "error: invalid character '\"' after object key:value pair @19"
  assert_eq ind("{\"a\"  :  false    \"é\" :\n\"😀\"  \t}", "", "  "), "error: invalid character '\"' after object key:value pair @19"
  assert_eq valid("{\"a\"  :  false    \"é\" :\n\"😀\"  \t}"), false
  assert_eq html_escape("{\"a\"  :  false    \"é\" :\n\"😀\"  \t}"), "{\"a\"  :  false    \"é\" :\n\"😀\"  \t}"
  assert_eq cmp("{\r\n  }"), "{}"
  assert_eq ind("{\r\n  }", ">", "\t"), "{}"
  assert_eq valid("{\r\n  }"), true
  assert_eq html_escape("{\r\n  }"), "{\r\n  }"
  assert_eq cmp("[\t\n0\n,{\n \"b\": {  \"b\":[ \r\n  \r\n -1 , \"tab\\t\"  ,  null\n \r\n ] \r\n , \r\n \"k<\" :  \"\\\"q\\\"\t}\n\n}\t, \r\n 1e10   ]"), "error: invalid character '\\t' in string @81"
  assert_eq ind("[\t\n0\n,{\n \"b\": {  \"b\":[ \r\n  \r\n -1 , \"tab\\t\"  ,  null\n \r\n ] \r\n , \r\n \"k<\" :  \"\\\"q\\\"\t}\n\n}\t, \r\n 1e10   ]", "", ""), "error: invalid character '\\t' in string @81"
  assert_eq valid("[\t\n0\n,{\n \"b\": {  \"b\":[ \r\n  \r\n -1 , \"tab\\t\"  ,  null\n \r\n ] \r\n , \r\n \"k<\" :  \"\\\"q\\\"\t}\n\n}\t, \r\n 1e10   ]"), false
  assert_eq html_escape("[\t\n0\n,{\n \"b\": {  \"b\":[ \r\n  \r\n -1 , \"tab\\t\"  ,  null\n \r\n ] \r\n , \r\n \"k<\" :  \"\\\"q\\\"\t}\n\n}\t, \r\n 1e10   ]"), "[\t\n0\n,{\n \"b\": {  \"b\":[ \r\n  \r\n -1 , \"tab\\t\"  ,  null\n \r\n ] \r\n , \r\n \"k\\u003c\" :  \"\\\"q\\\"\t}\n\n}\t, \r\n 1e10   ]"
}

test "compact indent valid 22" {
  assert_eq cmp("\"b>\""), "\"b>\""
  assert_eq ind("\"b>\"", "  ", "-"), "\"b>\""
  assert_eq valid("\"b>\""), true
  assert_eq html_escape("\"b>\""), "\"b\\u003e\""
  assert_eq cmp("[\t[\"é\\n\"  , \r\n \"\\u2028x\\u2029\", \r\n {  \t\"a\"\n:\t\"&amp;\"\t, \"é\"  :  null\n, \"<\": \r\n \"é\\n\" \r\n }  ], \r\n \"x\"\t, \r\n { \t}   ]"), "[[\"é\\n\",\"\\u2028x\\u2029\",{\"a\":\"&amp;\",\"é\":null,\"<\":\"é\\n\"}],\"x\",{}]"
  assert_eq ind("[\t[\"é\\n\"  , \r\n \"\\u2028x\\u2029\", \r\n {  \t\"a\"\n:\t\"&amp;\"\t, \"é\"  :  null\n, \"<\": \r\n \"é\\n\" \r\n }  ], \r\n \"x\"\t, \r\n { \t}   ]", "", "  "), "[\n  [\n    \"é\\n\",\n    \"\\u2028x\\u2029\",\n    {\n      \"a\": \"&amp;\",\n      \"é\": null,\n      \"<\": \"é\\n\"\n    }\n  ],\n  \"x\",\n  {}\n]"
  assert_eq valid("[\t[\"é\\n\"  , \r\n \"\\u2028x\\u2029\", \r\n {  \t\"a\"\n:\t\"&amp;\"\t, \"é\"  :  null\n, \"<\": \r\n \"é\\n\" \r\n }  ], \r\n \"x\"\t, \r\n { \t}   ]"), true
  assert_eq html_escape("[\t[\"é\\n\"  , \r\n \"\\u2028x\\u2029\", \r\n {  \t\"a\"\n:\t\"&amp;\"\t, \"é\"  :  null\n, \"<\": \r\n \"é\\n\" \r\n }  ], \r\n \"x\"\t, \r\n { \t}   ]"), "[\t[\"é\\n\"  , \r\n \"\\u2028x\\u2029\", \r\n {  \t\"a\"\n:\t\"\\u0026amp;\"\t, \"é\"  :  null\n, \"\\u003c\": \r\n \"é\\n\" \r\n }  ], \r\n \"x\"\t, \r\n { \t}   ]"
  assert_eq cmp("{\t\"a\"\n:\n\"/\"\n \r\n }"), "{\"a\":\"/\"}"
  assert_eq ind("{\t\"a\"\n:\n\"/\"\n \r\n }", ">", "\t"), "{\n>\t\"a\": \"/\"\n>}"
  assert_eq valid("{\t\"a\"\n:\n\"/\"\n \r\n }"), true
  assert_eq html_escape("{\t\"a\"\n:\n\"/\"\n \r\n }"), "{\t\"a\"\n:\n\"/\"\n \r\n }"
  assert_eq cmp(Str.from_bytes([34, 226, 128, 34])), Str.from_bytes([34, 226, 128, 34])
  assert_eq ind(Str.from_bytes([34, 226, 128, 34]), "", ""), Str.from_bytes([34, 226, 128, 34])
  assert_eq valid(Str.from_bytes([34, 226, 128, 34])), true
  assert_eq html_escape(Str.from_bytes([34, 226, 128, 34])), Str.from_bytes([34, 226, 128, 34])
  assert_eq cmp("\"é\\n"), "error: unexpected end of JSON input @5"
  assert_eq ind("\"é\\n", "  ", "-"), "error: unexpected end of JSON input @5"
  assert_eq valid("\"é\\n"), false
  assert_eq html_escape("\"é\\n"), "\"é\\n"
  assert_eq cmp("[\n[ [ \r\n \t\"<b>\"\t, null  \t]  ,null, {\t  \"\" :\t\"a b\"  , \"\":\"\" \r\n , \"\"\t:  1.5\n  }\n ] , \r\n [ \r\n   ] \r\n  \r\n "), "error: unexpected end of JSON input @102"
  assert_eq ind("[\n[ [ \r\n \t\"<b>\"\t, null  \t]  ,null, {\t  \"\" :\t\"a b\"  , \"\":\"\" \r\n , \"\"\t:  1.5\n  }\n ] , \r\n [ \r\n   ] \r\n  \r\n ", "", "  "), "error: unexpected end of JSON input @102"
  assert_eq valid("[\n[ [ \r\n \t\"<b>\"\t, null  \t]  ,null, {\t  \"\" :\t\"a b\"  , \"\":\"\" \r\n , \"\"\t:  1.5\n  }\n ] , \r\n [ \r\n   ] \r\n  \r\n "), false
  assert_eq html_escape("[\n[ [ \r\n \t\"<b>\"\t, null  \t]  ,null, {\t  \"\" :\t\"a b\"  , \"\":\"\" \r\n , \"\"\t:  1.5\n  }\n ] , \r\n [ \r\n   ] \r\n  \r\n "), "[\n[ [ \r\n \t\"\\u003cb\\u003e\"\t, null  \t]  ,null, {\t  \"\" :\t\"a b\"  , \"\":\"\" \r\n , \"\"\t:  1.5\n  }\n ] , \r\n [ \r\n   ] \r\n  \r\n "
  assert_eq cmp("[\t  {\t\"k<\"\n: \r\n [ \n{ \r\n   \"a\"\n:\t\"😀\",  \"a\"\n:\ttrue  }\t,\t\"x\"  , \r\n { \t\"k<\"\t:\"<b>\"  , \" :\n123456789012345678901\n,  \"a\"\t:  true \r\n \n}\t \r\n ]  }\t, \r\n 123456789012345678901  \r\n ]"), "error: invalid character '\\n' in string @89"
  assert_eq ind("[\t  {\t\"k<\"\n: \r\n [ \n{ \r\n   \"a\"\n:\t\"😀\",  \"a\"\n:\ttrue  }\t,\t\"x\"  , \r\n { \t\"k<\"\t:\"<b>\"  , \" :\n123456789012345678901\n,  \"a\"\t:  true \r\n \n}\t \r\n ]  }\t, \r\n 123456789012345678901  \r\n ]", ">", "\t"), "error: invalid character '\\n' in string @89"
  assert_eq valid("[\t  {\t\"k<\"\n: \r\n [ \n{ \r\n   \"a\"\n:\t\"😀\",  \"a\"\n:\ttrue  }\t,\t\"x\"  , \r\n { \t\"k<\"\t:\"<b>\"  , \" :\n123456789012345678901\n,  \"a\"\t:  true \r\n \n}\t \r\n ]  }\t, \r\n 123456789012345678901  \r\n ]"), false
  assert_eq html_escape("[\t  {\t\"k<\"\n: \r\n [ \n{ \r\n   \"a\"\n:\t\"😀\",  \"a\"\n:\ttrue  }\t,\t\"x\"  , \r\n { \t\"k<\"\t:\"<b>\"  , \" :\n123456789012345678901\n,  \"a\"\t:  true \r\n \n}\t \r\n ]  }\t, \r\n 123456789012345678901  \r\n ]"), "[\t  {\t\"k\\u003c\"\n: \r\n [ \n{ \r\n   \"a\"\n:\t\"😀\",  \"a\"\n:\ttrue  }\t,\t\"x\"  , \r\n { \t\"k\\u003c\"\t:\"\\u003cb\\u003e\"  , \" :\n123456789012345678901\n,  \"a\"\t:  true \r\n \n}\t \r\n ]  }\t, \r\n 123456789012345678901  \r\n ]"
  assert_eq cmp(" \r\n }"), "error: invalid character '}' looking for beginning of value @5"
  assert_eq ind(" \r\n }", "", ""), "error: invalid character '}' looking for beginning of value @5"
  assert_eq valid(" \r\n }"), false
  assert_eq html_escape(" \r\n }"), " \r\n }"
  assert_eq cmp("\"/\""), "\"/\""
  assert_eq ind("\"/\"", "  ", "-"), "\"/\""
  assert_eq valid("\"/\""), true
  assert_eq html_escape("\"/\""), "\"/\""
  assert_eq cmp("{ \n\"k<\"  : \"<b>\"  , \r\n \"a\"\t: { \r\n \n\"a\" \r\n : \"ab\" \r\n ,\t\"k<\"\t:\t\"\\/\"\n\n}, \r\n \"a\"\t:\tnull\t \r\n }"), "{\"k<\":\"<b>\",\"a\":{\"a\":\"ab\",\"k<\":\"\\/\"},\"a\":null}"
  assert_eq ind("{ \n\"k<\"  : \"<b>\"  , \r\n \"a\"\t: { \r\n \n\"a\" \r\n : \"ab\" \r\n ,\t\"k<\"\t:\t\"\\/\"\n\n}, \r\n \"a\"\t:\tnull\t \r\n }", "", "  "), "{\n  \"k<\": \"<b>\",\n  \"a\": {\n    \"a\": \"ab\",\n    \"k<\": \"\\/\"\n  },\n  \"a\": null\n}"
  assert_eq valid("{ \n\"k<\"  : \"<b>\"  , \r\n \"a\"\t: { \r\n \n\"a\" \r\n : \"ab\" \r\n ,\t\"k<\"\t:\t\"\\/\"\n\n}, \r\n \"a\"\t:\tnull\t \r\n }"), true
  assert_eq html_escape("{ \n\"k<\"  : \"<b>\"  , \r\n \"a\"\t: { \r\n \n\"a\" \r\n : \"ab\" \r\n ,\t\"k<\"\t:\t\"\\/\"\n\n}, \r\n \"a\"\t:\tnull\t \r\n }"), "{ \n\"k\\u003c\"  : \"\\u003cb\\u003e\"  , \r\n \"a\"\t: { \r\n \n\"a\" \r\n : \"ab\" \r\n ,\t\"k\\u003c\"\t:\t\"\\/\"\n\n}, \r\n \"a\"\t:\tnull\t \r\n }"
  assert_eq cmp("nll"), "error: invalid character 'l' in literal null (expecting 'u') @2"
  assert_eq ind("nll", ">", "\t"), "error: invalid character 'l' in literal null (expecting 'u') @2"
  assert_eq valid("nll"), false
  assert_eq html_escape("nll"), "nll"
  assert_eq cmp(Str.from_bytes([34, 226, 128, 34])), Str.from_bytes([34, 226, 128, 34])
  assert_eq ind(Str.from_bytes([34, 226, 128, 34]), "", ""), Str.from_bytes([34, 226, 128, 34])
  assert_eq valid(Str.from_bytes([34, 226, 128, 34])), true
  assert_eq html_escape(Str.from_bytes([34, 226, 128, 34])), Str.from_bytes([34, 226, 128, 34])
  assert_eq cmp("-"), "error: unexpected end of JSON input @0"
  assert_eq ind("-", "  ", "-"), "error: unexpected end of JSON input @0"
}

test "compact indent valid 23" {
  assert_eq valid("-"), false
  assert_eq html_escape("-"), "-"
  assert_eq cmp("\"tb\\t\""), "\"tb\\t\""
  assert_eq ind("\"tb\\t\"", "", "  "), "\"tb\\t\""
  assert_eq valid("\"tb\\t\""), true
  assert_eq html_escape("\"tb\\t\""), "\"tb\\t\""
  assert_eq cmp("\"\\u228x\\u2029\""), "error: invalid escape sequence `\\u228x` in string @7"
  assert_eq ind("\"\\u228x\\u2029\"", ">", "\t"), "error: invalid escape sequence `\\u228x` in string @7"
  assert_eq valid("\"\\u228x\\u2029\""), false
  assert_eq html_escape("\"\\u228x\\u2029\""), "\"\\u228x\\u2029\""
  assert_eq cmp("\" b\""), "\" b\""
  assert_eq ind("\" b\"", "", ""), "\" b\""
  assert_eq valid("\" b\""), true
  assert_eq html_escape("\" b\""), "\" b\""
  assert_eq cmp("rue"), "error: invalid character 'r' looking for beginning of value @1"
  assert_eq ind("rue", "  ", "-"), "error: invalid character 'r' looking for beginning of value @1"
  assert_eq valid("rue"), false
  assert_eq html_escape("rue"), "rue"
  assert_eq cmp("\"<>\""), "\"<>\""
  assert_eq ind("\"<>\"", "", "  "), "\"<>\""
  assert_eq valid("\"<>\""), true
  assert_eq html_escape("\"<>\""), "\"\\u003c\\u003e\""
  assert_eq cmp("[ \r\n\n]"), "[]"
  assert_eq ind("[ \r\n\n]", ">", "\t"), "[]"
  assert_eq valid("[ \r\n\n]"), true
  assert_eq html_escape("[ \r\n\n]"), "[ \r\n\n]"
  assert_eq cmp("\"<>\""), "\"<>\""
  assert_eq ind("\"<>\"", "", ""), "\"<>\""
  assert_eq valid("\"<>\""), true
  assert_eq html_escape("\"<>\""), "\"\\u003c\\u003e\""
  assert_eq cmp("[ \r\n  \"\u2029\",  [\t\n],{  \"a\"\n:  { \r\n  \r\n \"k<\"\t:\t[  \"a\" \r\n ,\t\"\\u2028x\\u2029\"  ,  \"\\u2028x\\u2029\"  \t] \r\n  } \n \t}\n]"), "[\"\u2029\",[],{\"a\":{\"k<\":[\"a\",\"\\u2028x\\u2029\",\"\\u2028x\\u2029\"]}}]"
  assert_eq ind("[ \r\n  \"\u2029\",  [\t\n],{  \"a\"\n:  { \r\n  \r\n \"k<\"\t:\t[  \"a\" \r\n ,\t\"\\u2028x\\u2029\"  ,  \"\\u2028x\\u2029\"  \t] \r\n  } \n \t}\n]", "  ", "-"), "[\n  -\"\u2029\",\n  -[],\n  -{\n  --\"a\": {\n  ---\"k<\": [\n  ----\"a\",\n  ----\"\\u2028x\\u2029\",\n  ----\"\\u2028x\\u2029\"\n  ---]\n  --}\n  -}\n  ]"
  assert_eq valid("[ \r\n  \"\u2029\",  [\t\n],{  \"a\"\n:  { \r\n  \r\n \"k<\"\t:\t[  \"a\" \r\n ,\t\"\\u2028x\\u2029\"  ,  \"\\u2028x\\u2029\"  \t] \r\n  } \n \t}\n]"), true
  assert_eq html_escape("[ \r\n  \"\u2029\",  [\t\n],{  \"a\"\n:  { \r\n  \r\n \"k<\"\t:\t[  \"a\" \r\n ,\t\"\\u2028x\\u2029\"  ,  \"\\u2028x\\u2029\"  \t] \r\n  } \n \t}\n]"), "[ \r\n  \"\\u2029\",  [\t\n],{  \"a\"\n:  { \r\n  \r\n \"k\\u003c\"\t:\t[  \"a\" \r\n ,\t\"\\u2028x\\u2029\"  ,  \"\\u2028x\\u2029\"  \t] \r\n  } \n \t}\n]"
  assert_eq cmp("\"&>\""), "\"&>\""
  assert_eq ind("\"&>\"", "", "  "), "\"&>\""
  assert_eq valid("\"&>\""), true
  assert_eq html_escape("\"&>\""), "\"\\u0026\\u003e\""
  assert_eq cmp("tre"), "error: invalid character 'e' in literal true (expecting 'u') @3"
  assert_eq ind("tre", ">", "\t"), "error: invalid character 'e' in literal true (expecting 'u') @3"
  assert_eq valid("tre"), false
  assert_eq html_escape("tre"), "tre"
  assert_eq cmp("x\""), "error: invalid character 'x' looking for beginning of value @1"
  assert_eq ind("x\"", "", ""), "error: invalid character 'x' looking for beginning of value @1"
  assert_eq valid("x\""), false
  assert_eq html_escape("x\""), "x\""
  assert_eq cmp("{\t }"), "{}"
  assert_eq ind("{\t }", "  ", "-"), "{}"
  assert_eq valid("{\t }"), true
  assert_eq html_escape("{\t }"), "{\t }"
}
