  assert_eq html_escape("\n\n{\"a\" : [ 1 , 2 ] , \"b\" : { } }\n\n"), "\n\n{\"a\" : [ 1 , 2 ] , \"b\" : { } }\n\n"
  assert_eq cmp("[\n\t\"tab\\t\"\n, \r\n 1.5 ]"), "[\"tab\\t\",1.5]"
  assert_eq ind("[\n\t\"tab\\t\"\n, \r\n 1.5 ]", "", "  "), "[\n  \"tab\\t\",\n  1.5\n]"
  assert_eq valid("[\n\t\"tab\\t\"\n, \r\n 1.5 ]"), true
  assert_eq html_escape("[\n\t\"tab\\t\"\n, \r\n 1.5 ]"), "[\n\t\"tab\\t\"\n, \r\n 1.5 ]"
  assert_eq cmp("null"), "null"
  assert_eq ind("null", ">", "\t"), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp("null  "), "null"
  assert_eq ind("null  ", "", ""), "null  "
  assert_eq valid("null  "), true
  assert_eq html_escape("null  "), "null  "
  assert_eq cmp("null\t"), "null"
  assert_eq ind("null\t", "  ", "-"), "null\t"
  assert_eq valid("null\t"), true
  assert_eq html_escape("null\t"), "null\t"
  assert_eq cmp("false"), "false"
  assert_eq ind("false", "", "  "), "false"
