  assert_eq ind("\"a b\"", ">", "\t"), "\"a b\""
  assert_eq valid("\"a b\""), true
  assert_eq html_escape("\"a b\""), "\"a b\""
  assert_eq cmp("{\n\"k<\"\t:[ {  }\t  ] }"), "{\"k<\":[{}]}"
  assert_eq ind("{\n\"k<\"\t:[ {  }\t  ] }", "", ""), "{\n\"k<\": [\n{}\n]\n}"
  assert_eq valid("{\n\"k<\"\t:[ {  }\t  ] }"), true
  assert_eq html_escape("{\n\"k<\"\t:[ {  }\t  ] }"), "{\n\"k\\u003c\"\t:[ {  }\t  ] }"
  assert_eq cmp("1e10"), "1e10"
  assert_eq ind("1e10", "  ", "-"), "1e10"
  assert_eq valid("1e10"), true
  assert_eq html_escape("1e10"), "1e10"
  assert_eq cmp("[ \r\n  \r\n \"<b>\"  \n]"), "[\"<b>\"]"
  assert_eq ind("[ \r\n  \r\n \"<b>\"  \n]", "", "  "), "[\n  \"<b>\"\n]"
  assert_eq valid("[ \r\n  \r\n \"<b>\"  \n]"), true
  assert_eq html_escape("[ \r\n  \r\n \"<b>\"  \n]"), "[ \r\n  \r\n \"\\u003cb\\u003e\"  \n]"
  assert_eq cmp("[\t{  \"\" \r\n : { \r\n \t\"b\"\n: \"a\" \r\n , \r\n \"\"\t:  {\t\n\"é\" \r\n : \r\n true\t, \r\n \"é\":\n\"\\\"q\\\"\"\t, \r\n \"b\" : \r\n null   }}  , \"k<\"\n:\t\"<&>\",\n\"\" : \r\n 123456789012345678901\t}\t\t]"), "[{\"\":{\"b\":\"a\",\"\":{\"é\":true,\"é\":\"\\\"q\\\"\",\"b\":null}},\"k<\":\"<&>\",\"\":123456789012345678901}]"
  assert_eq ind("[\t{  \"\" \r\n : { \r\n \t\"b\"\n: \"a\" \r\n , \r\n \"\"\t:  {\t\n\"é\" \r\n : \r\n true\t, \r\n \"é\":\n\"\\\"q\\\"\"\t, \r\n \"b\" : \r\n null   }}  , \"k<\"\n:\t\"<&>\",\n\"\" : \r\n 123456789012345678901\t}\t\t]", ">", "\t"), "[\n>\t{\n>\t\t\"\": {\n>\t\t\t\"b\": \"a\",\n>\t\t\t\"\": {\n>\t\t\t\t\"é\": true,\n>\t\t\t\t\"é\": \"\\\"q\\\"\",\n>\t\t\t\t\"b\": null\n>\t\t\t}\n>\t\t},\n>\t\t\"k<\": \"<&>\",\n>\t\t\"\": 123456789012345678901\n>\t}\n>]"
  assert_eq valid("[\t{  \"\" \r\n : { \r\n \t\"b\"\n: \"a\" \r\n , \r\n \"\"\t:  {\t\n\"é\" \r\n : \r\n true\t, \r\n \"é\":\n\"\\\"q\\\"\"\t, \r\n \"b\" : \r\n null   }}  , \"k<\"\n:\t\"<&>\",\n\"\" : \r\n 123456789012345678901\t}\t\t]"), true
  assert_eq html_escape("[\t{  \"\" \r\n : { \r\n \t\"b\"\n: \"a\" \r\n , \r\n \"\"\t:  {\t\n\"é\" \r\n : \r\n true\t, \r\n \"é\":\n\"\\\"q\\\"\"\t, \r\n \"b\" : \r\n null   }}  , \"k<\"\n:\t\"<&>\",\n\"\" : \r\n 123456789012345678901\t}\t\t]"), "[\t{  \"\" \r\n : { \r\n \t\"b\"\n: \"a\" \r\n , \r\n \"\"\t:  {\t\n\"é\" \r\n : \r\n true\t, \r\n \"é\":\n\"\\\"q\\\"\"\t, \r\n \"b\" : \r\n null   }}  , \"k\\u003c\"\n:\t\"\\u003c\\u0026\\u003e\",\n\"\" : \r\n 123456789012345678901\t}\t\t]"
  assert_eq cmp("[ \n\"<b>\"  \r\n ]"), "[\"<b>\"]"
  assert_eq ind("[ \n\"<b>\"  \r\n ]", "", ""), "[\n\"<b>\"\n]"
  assert_eq valid("[ \n\"<b>\"  \r\n ]"), true
  assert_eq html_escape("[ \n\"<b>\"  \r\n ]"), "[ \n\"\\u003cb\\u003e\"  \r\n ]"
