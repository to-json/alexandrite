test "compact indent valid 1" {
  assert_eq valid("\"<>&\""), true
  assert_eq html_escape("\"<>&\""), "\"\\u003c\\u003e\\u0026\""
  assert_eq cmp("  \t[ ] "), "[]"
  assert_eq ind("  \t[ ] ", ">", "\t"), "[] "
