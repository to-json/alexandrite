  assert_eq ind("\"<b>\"", "", ""), "\"<b>\""
  assert_eq valid("\"<b>\""), true
  assert_eq html_escape("\"<b>\""), "\"\\u003cb\\u003e\""
  assert_eq cmp(" \"&amp;\"\t"), "\"&amp;\""
