  assert_eq cmp("{\t\"é\"\n:[    false\n, null\n ]\t, \"\" \r\n :  {\t \r\n \"\"  : [    [ \r\n \"\"  ,\t\"é\\n\"\n,\t\"\\u2028x\\u2029\"\t\t] \r\n ],  \"k<\" \r\n :  {\t\t} \r\n   }\n  }"), "{\"é\":[false,null],\"\":{\"\":[[\"\",\"é\\n\",\"\\u2028x\\u2029\"]],\"k<\":{}}}"
  assert_eq ind("{\t\"é\"\n:[    false\n, null\n ]\t, \"\" \r\n :  {\t \r\n \"\"  : [    [ \r\n \"\"  ,\t\"é\\n\"\n,\t\"\\u2028x\\u2029\"\t\t] \r\n ],  \"k<\" \r\n :  {\t\t} \r\n   }\n  }", "", ""), "{\n\"é\": [\nfalse,\nnull\n],\n\"\": {\n\"\": [\n[\n\"\",\n\"é\\n\",\n\"\\u2028x\\u2029\"\n]\n],\n\"k<\": {}\n}\n}"
  assert_eq valid("{\t\"é\"\n:[    false\n, null\n ]\t, \"\" \r\n :  {\t \r\n \"\"  : [    [ \r\n \"\"  ,\t\"é\\n\"\n,\t\"\\u2028x\\u2029\"\t\t] \r\n ],  \"k<\" \r\n :  {\t\t} \r\n   }\n  }"), true
  assert_eq html_escape("{\t\"é\"\n:[    false\n, null\n ]\t, \"\" \r\n :  {\t \r\n \"\"  : [    [ \r\n \"\"  ,\t\"é\\n\"\n,\t\"\\u2028x\\u2029\"\t\t] \r\n ],  \"k<\" \r\n :  {\t\t} \r\n   }\n  }"), "{\t\"é\"\n:[    false\n, null\n ]\t, \"\" \r\n :  {\t \r\n \"\"  : [    [ \r\n \"\"  ,\t\"é\\n\"\n,\t\"\\u2028x\\u2029\"\t\t] \r\n ],  \"k\\u003c\" \r\n :  {\t\t} \r\n   }\n  }"
  assert_eq cmp("\"tab\\t\""), "\"tab\\t\""
  assert_eq ind("\"tab\\t\"", "  ", "-"), "\"tab\\t\""
  assert_eq valid("\"tab\\t\""), true
  assert_eq html_escape("\"tab\\t\""), "\"tab\\t\""
  assert_eq cmp("\"tab\\t\""), "\"tab\\t\""
  assert_eq ind("\"tab\\t\"", "", "  "), "\"tab\\t\""
  assert_eq valid("\"tab\\t\""), true
  assert_eq html_escape("\"tab\\t\""), "\"tab\\t\""
  assert_eq cmp("[\t\"\\u2028x\\u2029\"  ]"), "[\"\\u2028x\\u2029\"]"
  assert_eq ind("[\t\"\\u2028x\\u2029\"  ]", ">", "\t"), "[\n>\t\"\\u2028x\\u2029\"\n>]"
