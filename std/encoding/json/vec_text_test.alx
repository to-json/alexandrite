  assert_eq ind("null", "", ""), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp("\"\u2028\""), "\"\u2028\""
  assert_eq ind("\"\u2028\"", "  ", "-"), "\"\u2028\""
  assert_eq valid("\"\u2028\""), true
  assert_eq html_escape("\"\u2028\""), "\"\\u2028\""
  assert_eq cmp("\"x\""), "\"x\""
  assert_eq ind("\"x\"", "", "  "), "\"x\""
  assert_eq valid("\"x\""), true
  assert_eq html_escape("\"x\""), "\"x\""
  assert_eq cmp("[  \r\n null, \r\n {  \"\": \r\n null \n}, {  \r\n \"é\"\t:0  ,\t\"k<\"\n:\n\"é\\n\"\n,\"\"\t:  \"a\"\t  }\n]"), "[null,{\"\":null},{\"é\":0,\"k<\":\"é\\n\",\"\":\"a\"}]"
  assert_eq ind("[  \r\n null, \r\n {  \"\": \r\n null \n}, {  \r\n \"é\"\t:0  ,\t\"k<\"\n:\n\"é\\n\"\n,\"\"\t:  \"a\"\t  }\n]", ">", "\t"), "[\n>\tnull,\n>\t{\n>\t\t\"\": null\n>\t},\n>\t{\n>\t\t\"é\": 0,\n>\t\t\"k<\": \"é\\n\",\n>\t\t\"\": \"a\"\n>\t}\n>]"
  assert_eq valid("[  \r\n null, \r\n {  \"\": \r\n null \n}, {  \r\n \"é\"\t:0  ,\t\"k<\"\n:\n\"é\\n\"\n,\"\"\t:  \"a\"\t  }\n]"), true
  assert_eq html_escape("[  \r\n null, \r\n {  \"\": \r\n null \n}, {  \r\n \"é\"\t:0  ,\t\"k<\"\n:\n\"é\\n\"\n,\"\"\t:  \"a\"\t  }\n]"), "[  \r\n null, \r\n {  \"\": \r\n null \n}, {  \r\n \"é\"\t:0  ,\t\"k\\u003c\"\n:\n\"é\\n\"\n,\"\"\t:  \"a\"\t  }\n]"
  assert_eq cmp("null"), "null"
  assert_eq ind("null", "", ""), "null"
  assert_eq valid("null"), true
  assert_eq html_escape("null"), "null"
  assert_eq cmp(" \r\n {\t  }"), "{}"
  assert_eq ind(" \r\n {\t  }", "  ", "-"), "{}"
  assert_eq valid(" \r\n {\t  }"), true
  assert_eq html_escape(" \r\n {\t  }"), " \r\n {\t  }"
  assert_eq cmp("false"), "false"
  assert_eq ind("false", "", "  "), "false"
  assert_eq valid("false"), true
  assert_eq html_escape("false"), "false"
  assert_eq cmp("{  \"b\" \r\n :  [\n \r\n ] ,  \"é\" \r\n :  \"\\u2028x\\u2029\" \r\n \t}"), "{\"b\":[],\"é\":\"\\u2028x\\u2029\"}"
  assert_eq ind("{  \"b\" \r\n :  [\n \r\n ] ,  \"é\" \r\n :  \"\\u2028x\\u2029\" \r\n \t}", ">", "\t"), "{\n>\t\"b\": [],\n>\t\"é\": \"\\u2028x\\u2029\"\n>}"
  assert_eq valid("{  \"b\" \r\n :  [\n \r\n ] ,  \"é\" \r\n :  \"\\u2028x\\u2029\" \r\n \t}"), true
  assert_eq html_escape("{  \"b\" \r\n :  [\n \r\n ] ,  \"é\" \r\n :  \"\\u2028x\\u2029\" \r\n \t}"), "{  \"b\" \r\n :  [\n \r\n ] ,  \"é\" \r\n :  \"\\u2028x\\u2029\" \r\n \t}"
  assert_eq cmp("[\n\t]"), "[]"
  assert_eq ind("[\n\t]", "", ""), "[]"
  assert_eq valid("[\n\t]"), true
  assert_eq html_escape("[\n\t]"), "[\n\t]"
  assert_eq cmp(" \r\n false"), "false"
  assert_eq ind(" \r\n false", "  ", "-"), "false"
}

test "compact indent valid 7" {
