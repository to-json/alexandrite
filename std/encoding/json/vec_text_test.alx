  assert_eq valid("false"), true
  assert_eq html_escape("false"), "false"
  assert_eq cmp("\t{  \n\"b\" \r\n :\t[   \"😀\"\t,[  { \"\" : \r\n \"é\\n\"\t\n} ,\n\"\u2029\"  \n]\n],  \"a\" :\n{  \"k<\" : \r\n \"\u2028\" ,\n\"k<\" : \r\n [ \tnull\t,\tnull, [\"<b>\" \t]\n\n] } ,\n\"é\":\t{  }\t }\n"), "{\"b\":[\"😀\",[{\"\":\"é\\n\"},\"\u2029\"]],\"a\":{\"k<\":\"\u2028\",\"k<\":[null,null,[\"<b>\"]]},\"é\":{}}"
  assert_eq ind("\t{  \n\"b\" \r\n :\t[   \"😀\"\t,[  { \"\" : \r\n \"é\\n\"\t\n} ,\n\"\u2029\"  \n]\n],  \"a\" :\n{  \"k<\" : \r\n \"\u2028\" ,\n\"k<\" : \r\n [ \tnull\t,\tnull, [\"<b>\" \t]\n\n] } ,\n\"é\":\t{  }\t }\n", ">", "\t"), "{\n>\t\"b\": [\n>\t\t\"😀\",\n>\t\t[\n>\t\t\t{\n>\t\t\t\t\"\": \"é\\n\"\n>\t\t\t},\n>\t\t\t\"\u2029\"\n>\t\t]\n>\t],\n>\t\"a\": {\n>\t\t\"k<\": \"\u2028\",\n>\t\t\"k<\": [\n>\t\t\tnull,\n>\t\t\tnull,\n>\t\t\t[\n>\t\t\t\t\"<b>\"\n>\t\t\t]\n>\t\t]\n>\t},\n>\t\"é\": {}\n>}\n"
  assert_eq valid("\t{  \n\"b\" \r\n :\t[   \"😀\"\t,[  { \"\" : \r\n \"é\\n\"\t\n} ,\n\"\u2029\"  \n]\n],  \"a\" :\n{  \"k<\" : \r\n \"\u2028\" ,\n\"k<\" : \r\n [ \tnull\t,\tnull, [\"<b>\" \t]\n\n] } ,\n\"é\":\t{  }\t }\n"), true
  assert_eq html_escape("\t{  \n\"b\" \r\n :\t[   \"😀\"\t,[  { \"\" : \r\n \"é\\n\"\t\n} ,\n\"\u2029\"  \n]\n],  \"a\" :\n{  \"k<\" : \r\n \"\u2028\" ,\n\"k<\" : \r\n [ \tnull\t,\tnull, [\"<b>\" \t]\n\n] } ,\n\"é\":\t{  }\t }\n"), "\t{  \n\"b\" \r\n :\t[   \"😀\"\t,[  { \"\" : \r\n \"é\\n\"\t\n} ,\n\"\\u2029\"  \n]\n],  \"a\" :\n{  \"k\\u003c\" : \r\n \"\\u2028\" ,\n\"k\\u003c\" : \r\n [ \tnull\t,\tnull, [\"\\u003cb\\u003e\" \t]\n\n] } ,\n\"é\":\t{  }\t }\n"
  assert_eq cmp("  \"x\"\n"), "\"x\""
  assert_eq ind("  \"x\"\n", "", ""), "\"x\"\n"
  assert_eq valid("  \"x\"\n"), true
  assert_eq html_escape("  \"x\"\n"), "  \"x\"\n"
  assert_eq cmp("false"), "false"
