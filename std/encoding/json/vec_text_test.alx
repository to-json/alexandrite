  assert_eq html_escape("false"), "false"
  assert_eq cmp("\"x\"\n"), "\"x\""
  assert_eq ind("\"x\"\n", "", "  "), "\"x\"\n"
  assert_eq valid("\"x\"\n"), true
  assert_eq html_escape("\"x\"\n"), "\"x\"\n"
  assert_eq cmp("\n\"\u2029\" "), "\"\u2029\""
  assert_eq ind("\n\"\u2029\" ", ">", "\t"), "\"\u2029\" "
  assert_eq valid("\n\"\u2029\" "), true
  assert_eq html_escape("\n\"\u2029\" "), "\n\"\\u2029\" "
}

test "compact indent valid 4" {
  assert_eq cmp("\nfalse "), "false"
  assert_eq ind("\nfalse ", "", ""), "false "
  assert_eq valid("\nfalse "), true
  assert_eq html_escape("\nfalse "), "\nfalse "
  assert_eq cmp("\"\\u2028x\\u2029\""), "\"\\u2028x\\u2029\""
  assert_eq ind("\"\\u2028x\\u2029\"", "  ", "-"), "\"\\u2028x\\u2029\""
  assert_eq valid("\"\\u2028x\\u2029\""), true
  assert_eq html_escape("\"\\u2028x\\u2029\""), "\"\\u2028x\\u2029\""
  assert_eq cmp("\"<b>\""), "\"<b>\""
  assert_eq ind("\"<b>\"", "", "  "), "\"<b>\""
  assert_eq valid("\"<b>\""), true
  assert_eq html_escape("\"<b>\""), "\"\\u003cb\\u003e\""
  assert_eq cmp("-1"), "-1"
  assert_eq ind("-1", ">", "\t"), "-1"
  assert_eq valid("-1"), true
  assert_eq html_escape("-1"), "-1"
  assert_eq cmp("[\t\n\"\u2029\"    ]"), "[\"\u2029\"]"
  assert_eq ind("[\t\n\"\u2029\"    ]", "", ""), "[\n\"\u2029\"\n]"
  assert_eq valid("[\t\n\"\u2029\"    ]"), true
  assert_eq html_escape("[\t\n\"\u2029\"    ]"), "[\t\n\"\\u2029\"    ]"
  assert_eq cmp("\t[\t\nnull \t] "), "[null]"
  assert_eq ind("\t[\t\nnull \t] ", "  ", "-"), "[\n  -null\n  ] "
  assert_eq valid("\t[\t\nnull \t] "), true
  assert_eq html_escape("\t[\t\nnull \t] "), "\t[\t\nnull \t] "
  assert_eq cmp("false"), "false"
  assert_eq ind("false", "", "  "), "false"
  assert_eq valid("false"), true
  assert_eq html_escape("false"), "false"
  assert_eq cmp("false"), "false"
  assert_eq ind("false", ">", "\t"), "false"
  assert_eq valid("false"), true
  assert_eq html_escape("false"), "false"
  assert_eq cmp("  [\n true  , \r\n [    [  ]  , null \r\n , \r\n \"<&>\"\n ]\n\n]\n"), "[true,[[],null,\"<&>\"]]"
  assert_eq ind("  [\n true  , \r\n [    [  ]  , null \r\n , \r\n \"<&>\"\n ]\n\n]\n", "", ""), "[\ntrue,\n[\n[],\nnull,\n\"<&>\"\n]\n]\n"
  assert_eq valid("  [\n true  , \r\n [    [  ]  , null \r\n , \r\n \"<&>\"\n ]\n\n]\n"), true
  assert_eq html_escape("  [\n true  , \r\n [    [  ]  , null \r\n , \r\n \"<&>\"\n ]\n\n]\n"), "  [\n true  , \r\n [    [  ]  , null \r\n , \r\n \"\\u003c\\u0026\\u003e\"\n ]\n\n]\n"
  assert_eq cmp("\"\u2028\""), "\"\u2028\""
  assert_eq ind("\"\u2028\"", "  ", "-"), "\"\u2028\""
  assert_eq valid("\"\u2028\""), true
  assert_eq html_escape("\"\u2028\""), "\"\\u2028\""
  assert_eq cmp("\"<b>\""), "\"<b>\""
  assert_eq ind("\"<b>\"", "", "  "), "\"<b>\""
  assert_eq valid("\"<b>\""), true
  assert_eq html_escape("\"<b>\""), "\"\\u003cb\\u003e\""
  assert_eq cmp("{  \"\" \r\n :  {   \"\"  : [\t \r\n [   \"<&>\"   \r\n ] ,null  \n],\t\"\"  : \r\n \"\u2028\"\n  }   }"), "{\"\":{\"\":[[\"<&>\"],null],\"\":\"\u2028\"}}"
  assert_eq ind("{  \"\" \r\n :  {   \"\"  : [\t \r\n [   \"<&>\"   \r\n ] ,null  \n],\t\"\"  : \r\n \"\u2028\"\n  }   }", ">", "\t"), "{\n>\t\"\": {\n>\t\t\"\": [\n>\t\t\t[\n>\t\t\t\t\"<&>\"\n>\t\t\t],\n>\t\t\tnull\n>\t\t],\n>\t\t\"\": \"\u2028\"\n>\t}\n>}"
  assert_eq valid("{  \"\" \r\n :  {   \"\"  : [\t \r\n [   \"<&>\"   \r\n ] ,null  \n],\t\"\"  : \r\n \"\u2028\"\n  }   }"), true
  assert_eq html_escape("{  \"\" \r\n :  {   \"\"  : [\t \r\n [   \"<&>\"   \r\n ] ,null  \n],\t\"\"  : \r\n \"\u2028\"\n  }   }"), "{  \"\" \r\n :  {   \"\"  : [\t \r\n [   \"\\u003c\\u0026\\u003e\"   \r\n ] ,null  \n],\t\"\"  : \r\n \"\\u2028\"\n  }   }"
  assert_eq cmp(" \r\n true"), "true"
  assert_eq ind(" \r\n true", "", ""), "true"
}

test "compact indent valid 5" {
  assert_eq valid(" \r\n true"), true
  assert_eq html_escape(" \r\n true"), " \r\n true"
  assert_eq cmp("\"<&>\""), "\"<&>\""
  assert_eq ind("\"<&>\"", "  ", "-"), "\"<&>\""
  assert_eq valid("\"<&>\""), true
  assert_eq html_escape("\"<&>\""), "\"\\u003c\\u0026\\u003e\""
  assert_eq cmp("\"<b>\""), "\"<b>\""
  assert_eq ind("\"<b>\"", "", "  "), "\"<b>\""
  assert_eq valid("\"<b>\""), true
  assert_eq html_escape("\"<b>\""), "\"\\u003cb\\u003e\""
  assert_eq cmp("\"é\\n\""), "\"é\\n\""
  assert_eq ind("\"é\\n\"", ">", "\t"), "\"é\\n\""
  assert_eq valid("\"é\\n\""), true
  assert_eq html_escape("\"é\\n\""), "\"é\\n\""
  assert_eq cmp(" [ \r\n null  ,\n\"\\u2028x\\u2029\"\t, \r\n \"\u2029\"\t\n] "), "[null,\"\\u2028x\\u2029\",\"\u2029\"]"
  assert_eq ind(" [ \r\n null  ,\n\"\\u2028x\\u2029\"\t, \r\n \"\u2029\"\t\n] ", "", ""), "[\nnull,\n\"\\u2028x\\u2029\",\n\"\u2029\"\n] "
  assert_eq valid(" [ \r\n null  ,\n\"\\u2028x\\u2029\"\t, \r\n \"\u2029\"\t\n] "), true
  assert_eq html_escape(" [ \r\n null  ,\n\"\\u2028x\\u2029\"\t, \r\n \"\u2029\"\t\n] "), " [ \r\n null  ,\n\"\\u2028x\\u2029\"\t, \r\n \"\\u2029\"\t\n] "
  assert_eq cmp("{  \"b\": null\t  }"), "{\"b\":null}"
  assert_eq ind("{  \"b\": null\t  }", "  ", "-"), "{\n  -\"b\": null\n  }"
  assert_eq valid("{  \"b\": null\t  }"), true
  assert_eq html_escape("{  \"b\": null\t  }"), "{  \"b\": null\t  }"
  assert_eq cmp("  null\t"), "null"
  assert_eq ind("  null\t", "", "  "), "null\t"
  assert_eq valid("  null\t"), true
  assert_eq html_escape("  null\t"), "  null\t"
  assert_eq cmp("\"\u2028\""), "\"\u2028\""
  assert_eq ind("\"\u2028\"", ">", "\t"), "\"\u2028\""
  assert_eq valid("\"\u2028\""), true
  assert_eq html_escape("\"\u2028\""), "\"\\u2028\""
  assert_eq cmp("\"\u2029\""), "\"\u2029\""
  assert_eq ind("\"\u2029\"", "", ""), "\"\u2029\""
  assert_eq valid("\"\u2029\""), true
  assert_eq html_escape("\"\u2029\""), "\"\\u2029\""
  assert_eq cmp("{    }"), "{}"
  assert_eq ind("{    }", "  ", "-"), "{}"
  assert_eq valid("{    }"), true
  assert_eq html_escape("{    }"), "{    }"
  assert_eq cmp("{\t}"), "{}"
  assert_eq ind("{\t}", "", "  "), "{}"
  assert_eq valid("{\t}"), true
  assert_eq html_escape("{\t}"), "{\t}"
  assert_eq cmp(" 123456789012345678901\t"), "123456789012345678901"
  assert_eq ind(" 123456789012345678901\t", ">", "\t"), "123456789012345678901\t"
  assert_eq valid(" 123456789012345678901\t"), true
  assert_eq html_escape(" 123456789012345678901\t"), " 123456789012345678901\t"
  assert_eq cmp("1.5"), "1.5"
  assert_eq ind("1.5", "", ""), "1.5"
  assert_eq valid("1.5"), true
  assert_eq html_escape("1.5"), "1.5"
}

test "compact indent valid 6" {
  assert_eq cmp("\"\u2029\""), "\"\u2029\""
  assert_eq ind("\"\u2029\"", "  ", "-"), "\"\u2029\""
  assert_eq valid("\"\u2029\""), true
  assert_eq html_escape("\"\u2029\""), "\"\\u2029\""
  assert_eq cmp(" \r\n null"), "null"
  assert_eq ind(" \r\n null", "", "  "), "null"
  assert_eq valid(" \r\n null"), true
  assert_eq html_escape(" \r\n null"), " \r\n null"
  assert_eq cmp("0"), "0"
  assert_eq ind("0", ">", "\t"), "0"
  assert_eq valid("0"), true
  assert_eq html_escape("0"), "0"
