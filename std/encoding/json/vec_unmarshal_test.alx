test "unmarshalTests 0" {
  assert_eq ut("true", false, false, false), "true"
  assert_eq ut("1", 0, false, false), "1"
  assert_eq ut("1.2", 0.0, false, false), "1.2"
  assert_eq ut("-5", 0.as_i16, false, false), "-5"
  assert_eq ut("2", json.Number.json_zero, true, false), "2"
  assert_eq ut("2", json.Number.json_zero, false, false), "2"
  assert_eq ut("2", json.Value.json_zero, false, false), "2"
  assert_eq ut("2", json.Value.json_zero, true, false), "2"
  assert_eq ut("\"a\\u1234\"", "", false, false), "\"aሴ\""
  assert_eq ut("\"http:\\/\\/\"", "", false, false), "\"http://\""
  assert_eq ut("\"g-clef: \\uD834\\uDD1E\"", "", false, false), "\"g-clef: 𝄞\""
  assert_eq ut("\"invalid: \\uD834x\\uDD1E\"", "", false, false), "\"invalid: �x�\""
  assert_eq ut("null", json.Value.json_zero, false, false), "null"
  assert_eq ut("{\"X\": [1,2,3], \"Y\": 4}", T.json_zero, false, false), "{\"X\":\"\",\"Y\":4} | json: cannot unmarshal array into Go struct field T.X of type Str @7"
  assert_eq ut("{\"X\": 23}", T.json_zero, false, false), "{\"X\":\"\",\"Y\":0} | json: cannot unmarshal number into Go struct field T.X of type Str @8"
  assert_eq ut("{\"x\": 1}", Tx.json_zero, false, false), "{}"
  assert_eq ut("{\"x\": 1}", Tx.json_zero, false, false), "{}"
  assert_eq ut("{\"x\": 1}", Tx.json_zero, false, true), "{} | json: unknown field \"x\""
  assert_eq ut("{\"S\": 23}", W.json_zero, false, false), "{\"S\":\"\"} | json: cannot unmarshal number into Go value of type SS @0"
  assert_eq ut("{\"T\": {\"X\": 23}}", TOuter.json_zero, false, false), "{\"T\":{\"X\":\"\",\"Y\":0}} | json: cannot unmarshal number into Go struct field T.X of type Str @8"
  assert_eq ut("{\"F1\":1,\"F2\":2,\"F3\":3}", V.json_zero, false, false), "{\"F1\":1,\"F2\":2,\"F3\":3,\"F4\":null}"
  assert_eq ut("{\"F1\":1,\"F2\":2,\"F3\":3}", V.json_zero, true, false), "{\"F1\":1,\"F2\":2,\"F3\":3,\"F4\":null}"
  assert_eq ut("{\"k1\":1,\"k2\":\"s\",\"k3\":[1,2.0,3e-3],\"k4\":{\"kk1\":\"s\",\"kk2\":2}}", json.Value.json_zero, true, false), "{\"k1\":1,\"k2\":\"s\",\"k3\":[1,2.0,3e-3],\"k4\":{\"kk1\":\"s\",\"kk2\":2}}"
  assert_eq ut("\n true ", false, false, false), "true"
  assert_eq ut("\t 1 ", 0, false, false), "1"
  assert_eq ut("\r 1.2 ", 0.0, false, false), "1.2"
  assert_eq ut("\t -5 \n", 0.as_i16, false, false), "-5"
  assert_eq ut("\t \"a\\u1234\" \n", "", false, false), "\"aሴ\""
  assert_eq ut("{\"Y\": 1, \"Z\": 2}", T.json_zero, false, false), "{\"X\":\"\",\"Y\":1}"
  assert_eq ut("{\"Y\": 1, \"Z\": 2}", T.json_zero, false, true), "{\"X\":\"\",\"Y\":1} | json: unknown field \"Z\""
  assert_eq ut("{\"alpha\": \"abc\", \"alphabet\": \"xyz\"}", U.json_zero, false, false), "{\"alpha\":\"abc\"}"
  assert_eq ut("{\"alpha\": \"abc\", \"alphabet\": \"xyz\"}", U.json_zero, false, true), "{\"alpha\":\"abc\"} | json: unknown field \"alphabet\""
  assert_eq ut("{\"alpha\": \"abc\"}", U.json_zero, false, false), "{\"alpha\":\"abc\"}"
  assert_eq ut("{\"alphabet\": \"xyz\"}", U.json_zero, false, false), "{\"alpha\":\"\"}"
  assert_eq ut("{\"alphabet\": \"xyz\"}", U.json_zero, false, true), "{\"alpha\":\"\"} | json: unknown field \"alphabet\""
  assert_eq ut("", json.Value.json_zero, false, false), "null | EOF"
  assert_eq ut(" \n\r\t", json.Value.json_zero, false, false), "null | EOF"
  assert_eq ut("[2, 3", json.Value.json_zero, false, false), "null | unexpected EOF"
  assert_eq syn("{\"X\": \"foo\", \"Y\"}"), "invalid character '}' after object key @17"
  assert_eq syn("[1, 2, 3+]"), "invalid character '+' after array element @9"
}

test "unmarshalTests 1" {
  assert_eq syn("{\"X\":12x}"), "invalid character 'x' after object key:value pair @8"
  assert_eq ut("{\"F3\": -}", V.json_zero, false, false), "{\"F1\":null,\"F2\":0,\"F3\":0,\"F4\":null} | invalid character '}' in numeric literal @9"
  assert_eq syn("\x01 42"), "invalid character '\\x01' looking for beginning of value @1"
  assert_eq syn(" 42 \x01"), "invalid character '\\x01' after top-level value @5"
  assert_eq syn("\x01 true"), "invalid character '\\x01' looking for beginning of value @1"
  assert_eq syn(" false \x01"), "invalid character '\\x01' after top-level value @8"
  assert_eq syn("\x01 1.2"), "invalid character '\\x01' looking for beginning of value @1"
  assert_eq syn(" 3.4 \x01"), "invalid character '\\x01' after top-level value @6"
  assert_eq syn("\x01 \"string\""), "invalid character '\\x01' looking for beginning of value @1"
  assert_eq syn(" \"string\" \x01"), "invalid character '\\x01' after top-level value @11"
