  assert_eq ut("{\n\t\"Bool\": false,\n\t\"Int\": 0,\n\t\"Int8\": 0,\n\t\"Int16\": 0,\n\t\"Int32\": 0,\n\t\"Int64\": 0,\n\t\"Uint\": 0,\n\t\"Uint8\": 0,\n\t\"Uint16\": 0,\n\t\"Uint32\": 0,\n\t\"Uint64\": 0,\n\t\"Uintptr\": 0,\n\t\"Float32\": 0,\n\t\"Float64\": 0,\n\t\"bar\": \"\",\n\t\"bar2\": \"\",\n        \"IntStr\": \"0\",\n\t\"UintptrStr\": \"0\",\n\t\"PBool\": true,\n\t\"PInt\": 2,\n\t\"PInt8\": 3,\n\t\"PInt16\": 4,\n\t\"PInt32\": 5,\n\t\"PInt64\": 6,\n\t\"PUint\": 7,\n\t\"PUint8\": 8,\n\t\"PUint16\": 9,\n\t\"PUint32\": 10,\n\t\"PUint64\": 11,\n\t\"PUintptr\": 12,\n\t\"PFloat32\": 14.1,\n\t\"PFloat64\": 15.1,\n\t\"String\": \"\",\n\t\"PString\": \"16\",\n\t\"Map\": null,\n\t\"MapP\": null,\n\t\"PMap\": {\n\t\t\"17\": {\n\t\t\t\"Tag\": \"tag17\"\n\t\t},\n\t\t\"18\": {\n\t\t\t\"Tag\": \"tag18\"\n\t\t}\n\t},\n\t\"PMapP\": {\n\t\t\"19\": {\n\t\t\t\"Tag\": \"tag19\"\n\t\t},\n\t\t\"20\": null\n\t},\n\t\"EmptyMap\": null,\n\t\"NilMap\": null,\n\t\"Slice\": null,\n\t\"SliceP\": null,\n\t\"PSlice\": [\n\t\t{\n\t\t\t\"Tag\": \"tag20\"\n\t\t},\n\t\t{\n\t\t\t\"Tag\": \"tag21\"\n\t\t}\n\t],\n\t\"PSliceP\": [\n\t\t{\n\t\t\t\"Tag\": \"tag22\"\n\t\t},\n\t\tnull,\n\t\t{\n\t\t\t\"Tag\": \"tag23\"\n\t\t}\n\t],\n\t\"EmptySlice\": null,\n\t\"NilSlice\": null,\n\t\"StringSlice\": null,\n\t\"ByteSlice\": null,\n\t\"Small\": {\n\t\t\"Tag\": \"\"\n\t},\n\t\"PSmall\": null,\n\t\"PPSmall\": {\n\t\t\"Tag\": \"tag31\"\n\t},\n\t\"Interface\": null,\n\t\"PInterface\": 5.2,\n\t\"InvalidEmbed\": 0\n}", AllPtr.json_zero, false, false), "{\"Bool\":false,\"Int\":0,\"Int8\":0,\"Int16\":0,\"Int32\":0,\"Int64\":0,\"Uint\":0,\"Uint8\":0,\"Uint16\":0,\"Uint32\":0,\"Uint64\":0,\"Uintptr\":0,\"Float64\":0,\"bar\":\"\",\"bar2\":\"\",\"IntStr\":\"0\",\"UintptrStr\":\"0\",\"PBool\":true,\"PInt\":2,\"PInt8\":3,\"PInt16\":4,\"PInt32\":5,\"PInt64\":6,\"PUint\":7,\"PUint8\":8,\"PUint16\":9,\"PUint32\":10,\"PUint64\":11,\"PUintptr\":12,\"PFloat64\":15.1,\"String\":\"\",\"PString\":\"16\",\"Map\":{},\"MapP\":{},\"PMap\":{\"17\":{\"Tag\":\"tag17\"},\"18\":{\"Tag\":\"tag18\"}},\"PMapP\":{\"19\":{\"Tag\":\"tag19\"},\"20\":null},\"EmptyMap\":{},\"NilMap\":{},\"Slice\":[],\"SliceP\":[],\"PSlice\":[{\"Tag\":\"tag20\"},{\"Tag\":\"tag21\"}],\"PSliceP\":[{\"Tag\":\"tag22\"},null,{\"Tag\":\"tag23\"}],\"EmptySlice\":[],\"NilSlice\":[],\"StringSlice\":[],\"ByteSlice\":\"\",\"Small\":{\"Tag\":\"\"},\"PSmall\":null,\"PPSmall\":{\"Tag\":\"tag31\"},\"Interface\":null,\"PInterface\":5.2,\"InvalidEmbed\":0}"
  assert_eq ut("{\"Bool\":false,\"Int\":0,\"Int8\":0,\"Int16\":0,\"Int32\":0,\"Int64\":0,\"Uint\":0,\"Uint8\":0,\"Uint16\":0,\"Uint32\":0,\"Uint64\":0,\"Uintptr\":0,\"Float32\":0,\"Float64\":0,\"bar\":\"\",\"bar2\":\"\",\"IntStr\":\"0\",\"UintptrStr\":\"0\",\"PBool\":true,\"PInt\":2,\"PInt8\":3,\"PInt16\":4,\"PInt32\":5,\"PInt64\":6,\"PUint\":7,\"PUint8\":8,\"PUint16\":9,\"PUint32\":10,\"PUint64\":11,\"PUintptr\":12,\"PFloat32\":14.1,\"PFloat64\":15.1,\"String\":\"\",\"PString\":\"16\",\"Map\":null,\"MapP\":null,\"PMap\":{\"17\":{\"Tag\":\"tag17\"},\"18\":{\"Tag\":\"tag18\"}},\"PMapP\":{\"19\":{\"Tag\":\"tag19\"},\"20\":null},\"EmptyMap\":null,\"NilMap\":null,\"Slice\":null,\"SliceP\":null,\"PSlice\":[{\"Tag\":\"tag20\"},{\"Tag\":\"tag21\"}],\"PSliceP\":[{\"Tag\":\"tag22\"},null,{\"Tag\":\"tag23\"}],\"EmptySlice\":null,\"NilSlice\":null,\"StringSlice\":null,\"ByteSlice\":null,\"Small\":{\"Tag\":\"\"},\"PSmall\":null,\"PPSmall\":{\"Tag\":\"tag31\"},\"Interface\":null,\"PInterface\":5.2,\"InvalidEmbed\":0}", AllPtr.json_zero, false, false), "{\"Bool\":false,\"Int\":0,\"Int8\":0,\"Int16\":0,\"Int32\":0,\"Int64\":0,\"Uint\":0,\"Uint8\":0,\"Uint16\":0,\"Uint32\":0,\"Uint64\":0,\"Uintptr\":0,\"Float64\":0,\"bar\":\"\",\"bar2\":\"\",\"IntStr\":\"0\",\"UintptrStr\":\"0\",\"PBool\":true,\"PInt\":2,\"PInt8\":3,\"PInt16\":4,\"PInt32\":5,\"PInt64\":6,\"PUint\":7,\"PUint8\":8,\"PUint16\":9,\"PUint32\":10,\"PUint64\":11,\"PUintptr\":12,\"PFloat64\":15.1,\"String\":\"\",\"PString\":\"16\",\"Map\":{},\"MapP\":{},\"PMap\":{\"17\":{\"Tag\":\"tag17\"},\"18\":{\"Tag\":\"tag18\"}},\"PMapP\":{\"19\":{\"Tag\":\"tag19\"},\"20\":null},\"EmptyMap\":{},\"NilMap\":{},\"Slice\":[],\"SliceP\":[],\"PSlice\":[{\"Tag\":\"tag20\"},{\"Tag\":\"tag21\"}],\"PSliceP\":[{\"Tag\":\"tag22\"},null,{\"Tag\":\"tag23\"}],\"EmptySlice\":[],\"NilSlice\":[],\"StringSlice\":[],\"ByteSlice\":\"\",\"Small\":{\"Tag\":\"\"},\"PSmall\":null,\"PPSmall\":{\"Tag\":\"tag31\"},\"Interface\":null,\"PInterface\":5.2,\"InvalidEmbed\":0}"
  assert_eq ut("{\"T\":false}", Unmarshaler.new, false, false), "{\"T\":true}"
  assert_eq ut("{\"T\":false}", UnmarshalerPtr.json_zero, false, false), "{\"T\":true}"
  assert_eq ut("[{\"T\":false}]", UnmarshalerSlice.json_zero, false, false), "[{\"T\":true}]"
  assert_eq ut("[{\"T\":false}]", UnmarshalerSlicePtr.json_zero, false, false), "[{\"T\":true}]"
  assert_eq ut("{\"M\":{\"T\":\"x:y\"}}", Ustruct.json_zero, false, false), "{\"M\":{\"T\":true}}"
  assert_eq ut("\"x:y\"", UnmarshalerText.new, false, false), "\"x:y\""
  assert_eq ut("\"x:y\"", UnmarshalerTextPtr.json_zero, false, false), "\"x:y\""
  assert_eq ut("[\"x:y\"]", UnmarshalerTextSlice.json_zero, false, false), "[\"x:y\"]"
  assert_eq ut("[\"x:y\"]", UnmarshalerTextSlicePtr.json_zero, false, false), "[\"x:y\"]"
  assert_eq ut("{\"M\":\"x:y\"}", UstructText.json_zero, false, false), "{\"M\":\"x:y\"}"
  assert_eq ut("{\"-1\":\"a\",\"0\":\"b\",\"1\":\"c\"}", MapIntStr.json_zero, false, false), "{\"-1\":\"a\",\"0\":\"b\",\"1\":\"c\"}"
  assert_eq ut("{\"0\":\"a\",\"10\":\"c\",\"9\":\"b\"}", MapU8Str.json_zero, false, false), "{\"0\":\"a\",\"10\":\"c\",\"9\":\"b\"}"
  assert_eq ut("{\"-9223372036854775808\":\"min\",\"9223372036854775807\":\"max\"}", MapIntStr.json_zero, false, false), "{\"-9223372036854775808\":\"min\",\"9223372036854775807\":\"max\"}"
  assert_eq ut("{\"18446744073709551615\":\"max\"}", MapU64Str.json_zero, false, false), "{\"18446744073709551615\":\"max\"}"
}

test "unmarshalTests 2" {
  assert_eq ut("{\"0\":false,\"10\":true}", MapU64Bool.json_zero, false, false), "{\"0\":false,\"10\":true}"
  assert_eq ut("{\"abc\":\"abc\"}", MapIntStr.json_zero, false, false), "{} | json: cannot unmarshal number abc into Go struct field .abc of type Int @6"
  assert_eq ut("{\"256\":\"abc\"}", MapU8Str.json_zero, false, false), "{} | json: cannot unmarshal number 256 into .256 of type U8 @6"
  assert_eq ut("{\"128\":\"abc\"}", MapI8Str.json_zero, false, false), "{} | json: cannot unmarshal number 128 into .128 of type I8 @6"
  assert_eq ut("{\"-1\":\"abc\"}", MapU8Str.json_zero, false, false), "{} | json: cannot unmarshal number -1 into Go struct field .-1 of type U8 @5"
  assert_eq ut("{\"F\":{\"a\":2,\"3\":4}}", MapStrMapIntInt.json_zero, false, false), "{\"F\":{\"3\":4}} | json: cannot unmarshal number a into Go struct field .F.a of type Int @9"
  assert_eq ut("{\"F\":{\"a\":2,\"3\":4}}", MapStrMapU64Int.json_zero, false, false), "{\"F\":{\"3\":4}} | json: cannot unmarshal number a into Go struct field .F.a of type U64 @9"
  assert_eq ut("{\n\t\t\t\"level0\": 1,\n\t\t\t\"level1b\": 2,\n\t\t\t\"level1c\": 3,\n\t\t\t\"x\": 4,\n\t\t\t\"level1a\": 5,\n\t\t\t\"lEVEL1B\": 6,\n\t\t\t\"e\": {\n\t\t\t\t\"level1a\": 8,\n\t\t\t\t\"level1b\": 9,\n\t\t\t\t\"level1c\": 10,\n\t\t\t\t\"level1d\": 11,\n\t\t\t\t\"x\": 12\n\t\t\t},\n\t\t\t\"loop1\": 13,\n\t\t\t\"loop2\": 14,\n\t\t\t\"X\": 15,\n\t\t\t\"Y\": 16,\n\t\t\t\"z\": 17,\n\t\t\t\"q\": 18\n\t\t}", Top.json_zero, false, false), "{\"level0\":1,\"level1b\":2,\"level1c\":3,\"level1a\":5,\"lEVEL1B\":6,\"e\":{\"level1a\":8,\"level1b\":9,\"level1c\":10,\"level1d\":11,\"x\":12},\"loop1\":13,\"loop2\":14,\"X\":15,\"Y\":16,\"z\":17,\"q\":18}"
  assert_eq ut("{\"hello\": 1}", Ambig.json_zero, false, false), "{\"HELLO\":1,\"Hello\":0}"
  assert_eq ut("{\"x\": 1,\"y\":2}", S5.json_zero, false, false), "{\"y\":2}"
  assert_eq ut("{\"x\": 1,\"y\":2}", S5.json_zero, false, true), "{\"y\":2} | json: unknown field \"x\""
  assert_eq ut("{\"x\": 1,\"y\":2}", S10.json_zero, false, false), "{\"y\":2}"
  assert_eq ut("{\"x\": 1,\"y\":2}", S10.json_zero, false, true), "{\"y\":2} | json: unknown field \"x\""
  assert_eq ut("{\"I\": 0, \"I\": null, \"J\": null}", DoublePtr.json_zero, false, false), "{\"I\":null,\"J\":null}"
  assert_eq ut(Str.from_bytes([34, 104, 101, 108, 108, 111, 255, 119, 111, 114, 108, 100, 34]), "", false, false), "\"hello�world\""
  assert_eq ut(Str.from_bytes([34, 104, 101, 108, 108, 111, 194, 194, 119, 111, 114, 108, 100, 34]), "", false, false), "\"hello��world\""
  assert_eq ut(Str.from_bytes([34, 104, 101, 108, 108, 111, 194, 255, 119, 111, 114, 108, 100, 34]), "", false, false), "\"hello��world\""
  assert_eq ut("\"hello\\ud800world\"", "", false, false), "\"hello�world\""
  assert_eq ut("\"hello\\ud800\\ud800world\"", "", false, false), "\"hello��world\""
  assert_eq ut("\"hello\\ud800\\ud800world\"", "", false, false), "\"hello��world\""
  assert_eq ut(Str.from_bytes([34, 104, 101, 108, 108, 111, 237, 160, 128, 237, 176, 128, 119, 111, 114, 108, 100, 34]), "", false, false), "\"hello������world\""
  assert_eq ut("[\"Z01\",\"Z02\",\"Z03\"]", ByteWithMarshalJSONSlice.json_zero, false, false), "[\"Z01\",\"Z02\",\"Z03\"]"
  assert_eq ut("[\"Z01\",\"Z02\",\"Z03\"]", ByteWithMarshalTextSlice.json_zero, false, false), "[\"Z01\",\"Z02\",\"Z03\"]"
  assert_eq ut("[\"Z01\",\"Z02\",\"Z03\"]", ByteWithPtrMarshalJSONSlice.json_zero, false, false), "[\"Z01\",\"Z02\",\"Z03\"]"
  assert_eq ut("[\"Z01\",\"Z02\",\"Z03\"]", ByteWithPtrMarshalTextSlice.json_zero, false, false), "[\"Z01\",\"Z02\",\"Z03\"]"
  assert_eq ut("[\"Z01\",\"Z02\",\"Z03\"]", IntWithMarshalJSONSlice.json_zero, false, false), "[\"Z01\",\"Z02\",\"Z03\"]"
  assert_eq ut("[\"Z01\",\"Z02\",\"Z03\"]", IntWithMarshalTextSlice.json_zero, false, false), "[\"Z01\",\"Z02\",\"Z03\"]"
  assert_eq ut("[\"Z01\",\"Z02\",\"Z03\"]", IntWithPtrMarshalJSONSlice.json_zero, false, false), "[\"Z01\",\"Z02\",\"Z03\"]"
  assert_eq ut("[\"Z01\",\"Z02\",\"Z03\"]", IntWithPtrMarshalTextSlice.json_zero, false, false), "[\"Z01\",\"Z02\",\"Z03\"]"
  assert_eq ut("0.000001", 0.0, false, false), "0.000001"
  assert_eq ut("1e-7", 0.0, false, false), "1e-7"
  assert_eq ut("100000000000000000000", 0.0, false, false), "100000000000000000000"
  assert_eq ut("1e+21", 0.0, false, false), "1e+21"
  assert_eq ut("-0.000001", 0.0, false, false), "-0.000001"
  assert_eq ut("-1e-7", 0.0, false, false), "-1e-7"
  assert_eq ut("-100000000000000000000", 0.0, false, false), "-100000000000000000000"
  assert_eq ut("-1e+21", 0.0, false, false), "-1e+21"
  assert_eq ut("999999999999999900000", 0.0, false, false), "999999999999999900000"
  assert_eq ut("9007199254740992", 0.0, false, false), "9007199254740992"
  assert_eq ut("9007199254740993", 0.0, false, false), "9007199254740992"
}

test "unmarshalTests 3" {
  assert_eq ut("{\"V\": {\"F2\": \"hello\"}}", VOuter.json_zero, false, false), "{\"V\":{\"F1\":null,\"F2\":0,\"F3\":0,\"F4\":null}} | json: cannot unmarshal string into Go struct field VOuter.V.F2 of type I32 @20"
  assert_eq ut("{\"V\": {\"F4\": {}, \"F2\": \"hello\"}}", VOuter.json_zero, false, false), "{\"V\":{\"F1\":null,\"F2\":0,\"F3\":0,\"F4\":{\"V\":{\"F1\":null,\"F2\":0,\"F3\":0,\"F4\":null}}}} | json: cannot unmarshal string into Go struct field VOuter.V.F2 of type I32 @30"
  assert_eq ut("{\"level1a\": \"hello\"}", Top.json_zero, false, false), "{\"level0\":0,\"level1b\":0,\"level1c\":0,\"X\":0,\"Y\":0,\"z\":0,\"q\":0} | json: cannot unmarshal string into Go struct field Top.level1a of type Int @19"
  assert_eq ut("{\"B\":\"true\"}", B.json_zero, false, false), "{\"B\":\"true\"}"
  assert_eq ut("{\"B\":\"false\"}", B.json_zero, false, false), "{\"B\":\"false\"}"
  assert_eq ut("{\"B\": \"maybe\"}", B.json_zero, false, false), "{\"B\":\"false\"} | json: cannot unmarshal string \"maybe\" into Go struct field B.B of type Bool: invalid syntax @13"
  assert_eq ut("{\"B\": \"tru\"}", B.json_zero, false, false), "{\"B\":\"false\"} | json: cannot unmarshal string \"tru\" into Go struct field B.B of type Bool: invalid syntax @11"
  assert_eq ut("{\"B\": \"False\"}", B.json_zero, false, false), "{\"B\":\"false\"} | json: cannot unmarshal string \"False\" into Go struct field B.B of type Bool: invalid syntax @13"
  assert_eq ut("{\"B\": \"null\"}", B.json_zero, false, false), "{\"B\":\"false\"}"
  assert_eq ut("{\"B\": \"nul\"}", B.json_zero, false, false), "{\"B\":\"false\"} | json: cannot unmarshal string \"nul\" into Go struct field B.B of type Bool: invalid syntax @11"
  assert_eq ut("{\"B\": [2, 3]}", B.json_zero, false, false), "{\"B\":\"false\"} | json: cannot unmarshal array into Go struct field B.B of type Bool @7"
  assert_eq ut("{\n\t\t\t\"level0\": 1,\n\t\t\t\"level1b\": 2,\n\t\t\t\"level1c\": 3,\n\t\t\t\"x\": 4,\n\t\t\t\"level1a\": 5,\n\t\t\t\"lEVEL1B\": 6,\n\t\t\t\"e\": {\n\t\t\t\t\"level1a\": 8,\n\t\t\t\t\"level1b\": 9,\n\t\t\t\t\"level1c\": 10,\n\t\t\t\t\"level1d\": 11,\n\t\t\t\t\"x\": 12\n\t\t\t},\n\t\t\t\"loop1\": 13,\n\t\t\t\"loop2\": 14,\n\t\t\t\"X\": 15,\n\t\t\t\"Y\": 16,\n\t\t\t\"z\": 17,\n\t\t\t\"q\": 18,\n\t\t\t\"extra\": true\n\t\t}", Top.json_zero, false, true), "{\"level0\":1,\"level1b\":2,\"level1c\":3,\"level1a\":5,\"lEVEL1B\":6,\"e\":{\"level1a\":8,\"level1b\":9,\"level1c\":10,\"level1d\":11,\"x\":12},\"loop1\":13,\"loop2\":14,\"X\":15,\"Y\":16,\"z\":17,\"q\":18} | json: unknown field \"extra\""
  assert_eq ut("{\n\t\t\t\"level0\": 1,\n\t\t\t\"level1b\": 2,\n\t\t\t\"level1c\": 3,\n\t\t\t\"x\": 4,\n\t\t\t\"level1a\": 5,\n\t\t\t\"lEVEL1B\": 6,\n\t\t\t\"e\": {\n\t\t\t\t\"level1a\": 8,\n\t\t\t\t\"level1b\": 9,\n\t\t\t\t\"level1c\": 10,\n\t\t\t\t\"level1d\": 11,\n\t\t\t\t\"x\": 12,\n\t\t\t\t\"extra\": null\n\t\t\t},\n\t\t\t\"loop1\": 13,\n\t\t\t\"loop2\": 14,\n\t\t\t\"X\": 15,\n\t\t\t\"Y\": 16,\n\t\t\t\"z\": 17,\n\t\t\t\"q\": 18\n\t\t}", Top.json_zero, false, true), "{\"level0\":1,\"level1b\":2,\"level1c\":3,\"level1a\":5,\"lEVEL1B\":6,\"e\":{\"level1a\":8,\"level1b\":9,\"level1c\":10,\"level1d\":11,\"x\":12},\"loop1\":13,\"loop2\":14,\"X\":15,\"Y\":16,\"z\":17,\"q\":18} | json: unknown field \"extra\""
  assert_eq ut("{\"data\":{\"test1\": \"bob\", \"test2\": 123}}", MapStringToStringData.json_zero, false, false), "{\"data\":{\"test1\":\"bob\",\"test2\":\"\"}} | json: cannot unmarshal number into Go struct field MapStringToStringData.data.test2 of type Str @37"
  assert_eq ut("{\"data\":{\"test1\": 123, \"test2\": \"bob\"}}", MapStringToStringData.json_zero, false, false), "{\"data\":{\"test1\":\"\",\"test2\":\"bob\"}} | json: cannot unmarshal number into Go struct field MapStringToStringData.data.test1 of type Str @21"
  assert_eq ut("[1, 2, 3]", MustNotUnmarshalText.json_zero, false, false), "{} | json: cannot unmarshal array into Go value of type MustNotUnmarshalText: JSON value must be string type @1"
  assert_eq ut("{\"foo\": \"bar\"}", MustNotUnmarshalText.json_zero, false, false), "{} | json: cannot unmarshal object into Go value of type MustNotUnmarshalText: JSON value must be string type @1"
  assert_eq ut("{\"PP\": {\"T\": {\"Y\": \"bad-type\"}}}", P.json_zero, false, false), "{\"PP\":{\"T\":{\"X\":\"\",\"Y\":0},\"Ts\":[]}} | json: cannot unmarshal string into Go struct field P.PP.T.Y of type Int @29"
  assert_eq ut("{\"Ts\": [{\"Y\": 1}, {\"Y\": 2}, {\"Y\": \"bad-type\"}]}", PP.json_zero, false, false), "{\"T\":{\"X\":\"\",\"Y\":0},\"Ts\":[{\"X\":\"\",\"Y\":1},{\"X\":\"\",\"Y\":2},{\"X\":\"\",\"Y\":0}]} | json: cannot unmarshal string into Go struct field PP.Ts.2.Y of type Int @44"
  assert_eq ut("invalid", json.Number.json_zero, false, false), "0 | invalid character 'i' looking for beginning of value @1"
  assert_eq ut("\"invalid\"", json.Number.json_zero, false, false), "0 | json: cannot unmarshal string \"invalid\" into Go value of type json.Number: invalid syntax @0"
  assert_eq ut("{\"A\":\"invalid\"}", AnonA.json_zero, false, false), "{\"A\":0} | json: cannot unmarshal string \"invalid\" into Go value of type json.Number: invalid syntax @0"
  assert_eq ut("{\"A\":\"invalid\"}", AnonAString.json_zero, false, false), "{\"A\":\"0\"} | json: cannot unmarshal string \"invalid\" into Go value of type json.Number: invalid syntax @0"
  assert_eq ut("{\"A\":\"invalid\"}", MapStrNumber.json_zero, false, false), "{\"A\":0} | json: cannot unmarshal string \"invalid\" into Go value of type json.Number: invalid syntax @0"
  assert_eq ut("5", json.Number.json_zero, false, false), "5"
  assert_eq ut("\"5\"", json.Number.json_zero, false, false), "5"
  assert_eq ut("{\"N\":5}", AnonN.json_zero, false, false), "{\"N\":5}"
  assert_eq ut("{\"N\":\"5\"}", AnonN.json_zero, false, false), "{\"N\":5}"
  assert_eq ut("{\"N\":5}", AnonNString.json_zero, false, false), "{\"N\":\"0\"} | json: cannot unmarshal number into Go value of type json.Number @0"
  assert_eq ut("{\"N\":\"5\"}", AnonNString.json_zero, false, false), "{\"N\":\"5\"}"
  assert_eq ut("[1,2,true,4,5}", IntSlice.json_zero, false, false), "[] | invalid character '}' after array element @14"
  assert_eq ut("[1,2,true,4,5]", IntSlice.json_zero, false, false), "[1,2,0,4,5] | json: cannot unmarshal bool into .2 of type Int @9"
  assert_eq ut("{\"-\":\"hello\"}", DashComma.json_zero, false, false), "{\"-\":\"hello\"}"
  assert_eq ut("{\"-\":\"hello\"}", DashCommaOmitEmpty.json_zero, false, false), "{\"-\":\"hello\"}"
  assert_eq ut("{\"F\":{\"V\":\"s\"}}", NestedUnamed.json_zero, false, false), "{\"F\":{\"V\":0}} | json: cannot unmarshal string into Go struct field NestedUnamed.F.V of type Int @13"
  assert_eq ut("{\"X\": \"-0000123\"}", QuotedInt.json_zero, false, false), "{\"X\":\"-123\"}"
  assert_eq ut("{\"X\": \"123 \"}", QuotedInt.json_zero, false, false), "{\"X\":\"0\"} | json: cannot unmarshal number 123  into Go struct field .X of type Int @12"
  assert_eq ut("{\"X\": \"0000123\"}", QuotedUint.json_zero, false, false), "{\"X\":\"123\"}"
  assert_eq ut("{\"X\": \"0x123\"}", QuotedUint.json_zero, false, false), "{\"X\":\"0\"} | json: cannot unmarshal number 0x123 into Go struct field .X of type U64 @13"
  assert_eq ut("{\"X\": \"0x1_4p-2\"}", QuotedFloat.json_zero, false, false), "{\"X\":\"5\"}"
}

test "unmarshalTests 4" {
  assert_eq ut("{\"X\": \"1.5e1_\"}", QuotedFloat.json_zero, false, false), "{\"X\":\"0\"} | json: cannot unmarshal number 1.5e1_ into Go struct field .X of type Float @14"
  assert_eq ut("{\"A\":\"null\", \"B\":\"null\", \"C\":\"null\", \"D\":\"null\"}", QuotedNull.json_zero, false, false), "{\"A\":\"\\\"\\\"\",\"B\":\"0\",\"C\":\"0\",\"D\":\"false\"}"
}
