#![test(external)]
# The types and helpers the generated vec_*_test.alx files use (each mirrors
# a Go type of the generator; Go's fields carry tags equal to these names).

import "bytes"
import "encoding/json"

# Compact's result: "ok" or "message @offset".
def syn_compact(s: Str) -> Str {
  r = json.compact(s)
  if e = r.err {
    return "#{e.message} @#{e.offset}"
  }
  "ok"
}

# While fixing divergences (CHK=1 .scratch/gen.sh): reports every mismatch.
#[track_caller]
def chk[X](got: X, want: X) {
  puts "MISMATCH #{caller_location}\n  got  #{got}\n  want #{want}" if got != want
}

def valid(s: Str) -> Bool { json.valid(s) }

def html_escape(s: Str) -> Str { json.html_escape(s) }

# A syntax check's result: "ok" or "message @offset".
def syn(s: Str) -> Str {
  r = json.check(s)
  if e = r.err {
    return "#{e.message} @#{e.offset}"
  }
  "ok"
}

# An error as the generator writes it: Go's SyntaxError and
# UnmarshalTypeError with " @<offset>".
def err_text(e: Error) -> Str {
  case e {
    json.JsonError.Syntax(_, o) => e.message + " @" + o.to_s
    json.JsonError.Type(_, _, o, _, _, _) => e.message + " @" + o.to_s
    _ => e.message
  }
}

# "<text>" or "error: <message>".
def res_text(r: ~Str<json.JsonError>) -> Str {
  if e = r.err {
    return "error: " + err_text(e)
  }
  r.unwrap
}

def cmp(s: Str) -> Str { res_text(json.compact(s)) }

def ind(s: Str, prefix: Str, i: Str) -> Str { res_text(json.indent(s, prefix, i)) }

#[derive(Json)]
#[json(transparent)]
struct SV {
  v: Str
}

#[derive(Json)]
#[json(transparent)]
struct FV {
  v: Float
}

def enc_str(s: Str) -> Str { res_text(json.marshal(SV.new(v: s))) }

# Go's Encoder with SetEscapeHTML(false).
def enc_str_raw(s: Str) -> Str {
  b = bytes.new_buffer([])
  e = json.new_encoder(b)
  e.set_escape_html!(false)
  r = e.encode!(SV.new(v: s))
  return "error: " + r.err.unwrap.message if r.err?
  t = b.string
  t[0...(t.size - 1)]
}

def dec_str(s: Str) -> Str {
  r = json.unmarshal_into(s, SV.new(v: ""))
  if e = r.err {
    return "error: " + err_text(e)
  }
  r.unwrap.v
}

def enc_float(f: Float) -> Str { res_text(json.marshal(FV.new(v: f))) }

def dec_float(s: Str) -> Float { json.unmarshal_into(s, FV.new(v: 0.0)).unwrap.v }

#[derive(Json)]
struct Ints {
  i: Int
  i8: I8
  i16: I16
  i32: I32
  u8: U8
  u16: U16
  u32: U32
  u64: U64
  f: Float
}

# The decoded value's JSON, or the error and its offset.
def dec_res[X](s: Str, zero: X) -> Str {
  v, err = json.unmarshal_partial(s, zero)
  out = res_text(json.marshal(v))
  out = out + " | " + err_text(err.unwrap) if err.some?
  out
}

def dec_ints(s: Str) -> Str {
  v, err = json.unmarshal_partial(s, Ints.json_zero)
  if e = err {
    return "error: " + err_text(e)
  }
  res_text(json.marshal(v))
}

#[derive(Json)]
struct VSmall {
  a: Int
  b: Str
}

#[derive(Json)]
struct VAll {
  i: Int
  i8: I8
  u16: U16
  u64: U64
  f: Float
  bo: Bool
  s: Str
  p: Int?
  ps: Str?
  psm: VSmall?
  xs: [Int]
  ss: [Str]
  bs: [Byte]
  arr: [Int; 3]
  m: Map[Str, Int]
  mi: Map[Int, Str]
  mu: Map[U8, Bool]
  ms: Map[Str, VSmall]
  sm: VSmall
  sms: [VSmall]
  raw: json.RawMessage
  n: json.Number
}

def dec_all(s: Str) -> Str { dec_res(s, VAll.json_zero) }

#[derive(Json)]
struct Tags {
  #[field(json: "a,omitempty")] a: Int
  #[field(json: "b,omitempty")] b: Str
  #[field(json: "c,omitempty")] c: [Int]
  #[field(json: "d,omitempty")] d: Map[Str, Int]
  #[field(json: "e,omitempty")] e: Int?
  #[field(json: "f,omitzero")] f: Int
  #[field(json: "g,omitzero")] g: Float
  #[field(json: "h,omitzero")] h: VSmall
  #[field(json: "i,omitempty")] i: VSmall
  #[field(json: "j,string")] j: Int
  #[field(json: "k,string")] k: Bool
  #[field(json: "l,string")] l: Float
  #[field(json: "m,string")] m: Str
  #[field(json: "n,string")] n: Int?
  #[field(json: "o,string")] o: U8
  #[field(json: "-")] skip: Int
  #[field(json: "-,")] dash: Int
  #[field(json: "renamed")] ren: Int
  #[field(json: "a-b_c.d")] odd: Int
  #[field(json: "<x>")] html: Int
  #[field(json: "q,omitempty,string")] q: Bool
  #[field(json: "z,omitempty,omitzero")] z: Int
}

def dec_tags(s: Str) -> Str { dec_res(s, Tags.json_zero) }

# Tags as written in plain JSON (every field under its alx name), encoded.
#[derive(Json)]
struct PlainTags {
  a: Int
  b: Str
  c: [Int]
  d: Map[Str, Int]
  e: Int?
  f: Int
  g: Float
  h: VSmall
  i: VSmall
  j: Int
  k: Bool
  l: Float
  m: Str
  n: Int?
  o: U8
  skip: Int
  dash: Int
  ren: Int
  odd: Int
  html: Int
  q: Bool
  z: Int
}

def enc_tags(src: Str) -> Str {
  p = PlainTags.from_json(src).unwrap
  t = Tags.new(a: p.a, b: p.b, c: p.c, d: p.d, e: p.e, f: p.f, g: p.g, h: p.h, i: p.i, j: p.j, k: p.k, l: p.l, m: p.m, n: p.n, o: p.o, skip: p.skip, dash: p.dash, ren: p.ren, odd: p.odd, html: p.html, q: p.q, z: p.z)
  res_text(json.marshal(t))
}
