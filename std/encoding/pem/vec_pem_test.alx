# Generated from Go's encoding/pem (go test): encodings of random blocks, decodings of mangled input; do not edit by hand.

def chk_encode(blk: Block, want: Str) {
  assert_eq Str.from_bytes(encode_to_memory(blk).unwrap), want
}

def chk_decode(input: Str, want: Str, rest: Str) {
  res = decode(input.bytes.to_a)
  assert_eq show(res[0]), want
  assert_eq Str.from_bytes(res[1]), rest
}

