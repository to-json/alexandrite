import "encoding/xml"

# Helpers for the translated tables: Go's tests marshal and unmarshal any
# value; here every value's type derives Xml (or implements the protocol).

# Go's struct{}: the type of an xml_name field that only carries a tag.
struct E {}

# Marshal's output, or "ERR " and the error.
def mx[T](v: T) -> Str {
  r = xml.marshal(v)
  if e = r.err {
    return "ERR #{e.message}"
  }
  Str.from_bytes(r.unwrap)
}

# MarshalIndent's output, or "ERR " and the error.
def mxi[T](v: T, prefix: Str, indent: Str) -> Str {
  r = xml.marshal_indent(v, prefix, indent)
  if e = r.err {
    return "ERR #{e.message}"
  }
  Str.from_bytes(r.unwrap)
}

# Unmarshal into a new value of v's type (Go's reflect.New of the type);
# panics with the error.
def ux[T](like: T, s: Str) -> T {
  r = T.from_xml(s)
  if e = r.err {
    panic "unmarshal #{s}: #{e.message}"
  }
  r.unwrap
}

# The error of unmarshaling s into a new value of v's type, or "".
def ue[T](like: T, s: Str) -> Str {
  r = T.from_xml(s)
  if e = r.err {
    return e.message
  }
  ""
}

def contains?(s: Str, part: Str) -> Bool {
  return true if part.size == 0
  i = 0
  while i + part.size <= s.size {
    return true if s[i...i + part.size] == part
    i += 1
  }
  false
}
