#[derive(Xml)]
struct MyMarshalerTest {
  def marshal_xml(e: xml.Encoder, start: xml.StartElement) -> ~Unit {
    e.~encode_token!(xml.Token.StartElement(start))
    e.~encode_token!(xml.char_data("hello world"))
    e.~encode_token!(xml.end_token(start.name))
    nil
  }
}

#[derive(Xml)]
struct MyMarshalerAttrTest {
  def marshal_xml_attr(name: xml.Name) -> ~xml.Attr {
    xml.Attr.new(name: name, value: "hello world")
  }
  def unmarshal_xml_attr!(a: xml.Attr) -> ~Unit { nil }
}

#[derive(Xml)]
struct MarshalerStruct {
  #[field(xml: "Foo,attr")] foo: MyMarshalerAttrTest
}

#[derive(Xml)]
struct InnerStruct {
  #[field(xml: "testns outer")] xml_name: xml.Name
}

#[derive(Xml)]
struct OuterStruct {
  #[field(xml: ",embed")] inner: InnerStruct
  #[field(xml: "int,attr")] int_attr: Int
}

#[derive(Xml)]
struct OuterNamedStruct {
  #[field(xml: ",embed")] inner: InnerStruct
  #[field(xml: "outerns test")] xml_name: xml.Name
  #[field(xml: "int,attr")] int_attr: Int
}

#[derive(Xml)]
struct OuterNamedOrderedStruct {
  #[field(xml: "outerns test")] xml_name: xml.Name
  #[field(xml: ",embed")] inner: InnerStruct
  #[field(xml: "int,attr")] int_attr: Int
}

#[derive(Xml)]
struct OuterOuterStruct {
  #[field(xml: ",embed")] outer: OuterStruct
}

