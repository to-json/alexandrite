# Go's anonymous structs in the table, named.
#[derive(Xml)]
struct AnonSpaceTop {
  #[field(xml: "space top")] xml_name: E
  #[field(xml: "x>a")] a: Str
  #[field(xml: "x>b")] b: Str
  #[field(xml: "space x>c")] c: Str
  #[field(xml: "space1 x>c")] c1: Str
  #[field(xml: "space1 x>d")] d1: Str
}

#[derive(Xml)]
struct AnonNameTop {
  xml_name: xml.Name
  #[field(xml: "x>a")] a: Str
  #[field(xml: "x>b")] b: Str
  #[field(xml: "space x>c")] c: Str
  #[field(xml: "space1 x>c")] c1: Str
  #[field(xml: "space1 x>d")] d1: Str
}

#[derive(Xml)]
struct AnonTopB {
  #[field(xml: "top")] xml_name: E
  #[field(xml: "space x>b")] b: Str
  #[field(xml: "space1 x>b")] b1: Str
}

# Mutually recursive types (Go's RecurseA and RecurseB).
#[derive(Xml)]
struct RecurseA {
  #[field(xml: "A")] a: Str
  #[field(xml: "B")] b: RecurseB?
}

#[derive(Xml)]
struct RecurseB {
  #[field(xml: "A")] a: RecurseA?
  #[field(xml: "B")] b: Str
}

# Two-way: marshal gives want, unmarshal of want gives v back.
def both[T](v: T, want: Str) -> Bool {
  ok = mx(v) == want
  puts "marshal: #{mx(v)}\n   want: #{want}" if !ok
  back = ux(v, want)
  ok2 = back == v
  puts "unmarshal mismatch for #{want}" if !ok2
  ok && ok2
}

def parse_time(s: Str) -> time.Time { time.parse(time.RFC3339, s).unwrap }

def sp(s: Str) -> Str? { s }

def b(s: Str) -> [Byte] { s.bytes }

def u8list(s: Str, t: Str) -> dyn.Value {
  xs: [dyn.Value] = []
  for c in s.bytes {
    xs << dyn.Value.uint_of(c.to_u64, "uint8")
  }
  dyn.Value.list_of(xs, t)
}

def ints(xs: [Int], t: Str) -> dyn.Value {
  vs: [dyn.Value] = []
  for x in xs {
    vs << dyn.Value.int(x)
  }
  dyn.Value.list_of(vs, t)
}

def plain(v: dyn.Value) -> Plain { Plain.new(v: v) }

test "marshal: nil and value types" {
  assert_eq Str.from_bytes(xml.~marshal_value(dyn.Value.invalid)), ""
  assert_eq Str.from_bytes(xml.~marshal_value(dyn.Value.nil_of("*xml.Ship"))), ""
  assert_eq mx(plain(dyn.Value.bool(true))), "<Plain><V>true</V></Plain>"
  assert_eq mx(plain(dyn.Value.bool(false))), "<Plain><V>false</V></Plain>"
  assert_eq mx(plain(dyn.Value.int(42))), "<Plain><V>42</V></Plain>"
  assert_eq mx(plain(dyn.Value.int_of(42, "int8"))), "<Plain><V>42</V></Plain>"
  assert_eq mx(plain(dyn.Value.int_of(42, "int16"))), "<Plain><V>42</V></Plain>"
  assert_eq mx(plain(dyn.Value.int_of(42, "int32"))), "<Plain><V>42</V></Plain>"
  assert_eq mx(plain(dyn.Value.uint(42))), "<Plain><V>42</V></Plain>"
  assert_eq mx(plain(dyn.Value.uint_of(42, "uint8"))), "<Plain><V>42</V></Plain>"
  assert_eq mx(plain(dyn.Value.uint_of(42, "uint16"))), "<Plain><V>42</V></Plain>"
  assert_eq mx(plain(dyn.Value.uint_of(42, "uint32"))), "<Plain><V>42</V></Plain>"
  assert_eq mx(plain(dyn.Value.float_of(1.25, "float32"))), "<Plain><V>1.25</V></Plain>"
  assert_eq mx(plain(dyn.Value.float(1.25))), "<Plain><V>1.25</V></Plain>"
  assert_eq mx(plain(dyn.Value.uint_of(0xFFDD, "uintptr"))), "<Plain><V>65501</V></Plain>"
  assert_eq mx(plain(dyn.Value.str("gopher"))), "<Plain><V>gopher</V></Plain>"
  assert_eq mx(plain(u8list("gopher", "[]uint8"))), "<Plain><V>gopher</V></Plain>"
  assert_eq mx(plain(dyn.Value.str("</>"))), "<Plain><V>&lt;/&gt;</V></Plain>"
  assert_eq mx(plain(u8list("</>", "[]uint8"))), "<Plain><V>&lt;/&gt;</V></Plain>"
  assert_eq mx(plain(u8list("</>", "[3]uint8"))), "<Plain><V>&lt;/&gt;</V></Plain>"
  assert_eq mx(plain(dyn.Value.str_of("potato", "xml.NamedType"))), "<Plain><V>potato</V></Plain>"
  assert_eq mx(plain(ints([1, 2, 3], "[]int"))), "<Plain><V>1</V><V>2</V><V>3</V></Plain>"
  assert_eq mx(plain(ints([1, 2, 3], "[3]int"))), "<Plain><V>1</V><V>2</V><V>3</V></Plain>"
  assert_eq Str.from_bytes(xml.~marshal_value(dyn.Value.bool(true).ptr)), "<bool>true</bool>"
}

test "marshal: time" {
  t = time.unix(1000000000, 123456789).utc
  assert_eq mx(PlainTime.new(v: t)), "<PlainTime><V>2001-09-09T01:46:40.123456789Z</V></PlainTime>"
  assert both(Departure.new(when: parse_time("2013-01-09T00:15:00-09:00")), "<departure>2013-01-09T00:15:00-09:00</departure>")
}

test "marshal: presence and bytes" {
  assert both(PresenceTest.new(exists: Empty.new), "<PresenceTest><Exists></Exists></PresenceTest>")
  assert both(PresenceTest.new, "<PresenceTest></PresenceTest>")
  assert_eq ux(Data.new, "<Data></Data>"), Data.new
  assert_eq ux(Data.new, "<Data Attr=\"\"><Bytes></Bytes><Custom></Custom></Data>"), Data.new
  assert both(Data.new(bytes: b("ab"), custom: b("cd"), attr: b("v")), "<Data Attr=\"v\"><Bytes>ab</Bytes><Custom>cd</Custom></Data>")
}

test "marshal: innerxml" {
  a = SecretAgent.new(handle: "007", identity: "James Bond", obfuscate: "<redacted/>")
  assert_eq mx(a), "<agent handle=\"007\"><Identity>James Bond</Identity><redacted/></agent>"
  a2 = SecretAgent.new(handle: "007", identity: "James Bond", obfuscate: "<Identity>James Bond</Identity><redacted/>")
  assert_eq ux(a2, "<agent handle=\"007\"><Identity>James Bond</Identity><redacted/></agent>"), a2
}

test "marshal: structs" {
  assert both(Port.new(typ: "ssl", number: "443"), "<port type=\"ssl\">443</port>")
  assert both(Port.new(number: "443"), "<port>443</port>")
  assert both(Port.new(typ: "<unix>"), "<port type=\"&lt;unix&gt;\"></port>")
  assert both(Port.new(number: "443", comment: "https"), "<port><!--https-->443</port>")
  assert_eq mx(Port.new(number: "443", comment: "add space-")), "<port><!--add space- -->443</port>"
  assert both(Domain.new(name: b("google.com&friends")), "<domain>google.com&amp;friends</domain>")
  assert both(Domain.new(name: b("google.com"), comment: b(" &friends ")), "<domain>google.com<!-- &friends --></domain>")
  assert both(Book.new(title: "Pride & Prejudice"), "<book>Pride &amp; Prejudice</book>")
  assert both(Event.new(year: -3114), "<event>-3114</event>")
  assert both(Movie.new(length: 13440), "<movie>13440</movie>")
  # Go's Approximation is a float32 (3.1415927); alx has no float32.
  assert both(Pi.new(approximation: 3.14159265), "<pi>3.14159265</pi>")
  assert both(Universe.new(visible: 9.3e13), "<universe>9.3e+13</universe>")
  assert both(Particle.new(has_mass: true), "<particle>true</particle>")
}

test "marshal: ship" {
  s = Ship.new(name: "Heart of Gold", pilot: "Computer", age: 1, drive: 1, passenger: [Passenger.new(name: ["Zaphod", "Beeblebrox"], weight: 7.25), Passenger.new(name: ["Trisha", "McMillen"], weight: 5.5), Passenger.new(name: ["Ford", "Prefect"], weight: 7.0), Passenger.new(name: ["Arthur", "Dent"], weight: 6.75)])
  want = "<spaceship name=\"Heart of Gold\" pilot=\"Computer\"><drive>1</drive><age>1</age><passenger><name>Zaphod</name><name>Beeblebrox</name><weight>7.25</weight></passenger><passenger><name>Trisha</name><name>McMillen</name><weight>5.5</weight></passenger><passenger><name>Ford</name><name>Prefect</name><weight>7</weight></passenger><passenger><name>Arthur</name><name>Dent</name><weight>6.75</weight></passenger></spaceship>"
  assert both(s, want)
}

test "marshal: a>b" {
  assert both(NestedItems.new, "<result><Items></Items></result>")
  assert both(NestedItems.new(item1: ["A"]), "<result><Items><item1>A</item1></Items></result>")
  assert both(NestedItems.new(items: ["A", "B"]), "<result><Items><item>A</item><item>B</item></Items></result>")
  assert both(NestedItems.new(items: ["A", "B"], item1: ["C"]), "<result><Items><item>A</item><item>B</item><item1>C</item1></Items></result>")
  assert both(NestedOrder.new(field1: "C", field2: "B", field3: "A"), "<result><parent><c>C</c><b>B</b><a>A</a></parent></result>")
  assert_eq mx(NilTest.new(a: dyn.Value.str("A"), b: dyn.Value.invalid, c: dyn.Value.str("C"))), "<NilTest><parent1><parent2><a>A</a></parent2><parent2><c>C</c></parent2></parent1></NilTest>"
  assert both(MixedNested.new(a: "A", b: "B", c: "C", d: "D"), "<result><parent1><a>A</a></parent1><b>B</b><parent1><parent2><c>C</c></parent2><d>D</d></parent1></result>")
  assert both(Service.new(port: Port.new(number: "80")), "<service><host><port>80</port></host></service>")
  assert both(Service.new, "<service></service>")
  assert_eq mx(Service.new(port: Port.new(number: "80"), extra1: dyn.Value.str("A"), extra2: dyn.Value.str("B"))), "<service><host><port>80</port></host><Extra1>A</Extra1><host><extra2>B</extra2></host></service>"
  assert_eq mx(Service.new(port: Port.new(number: "80"), extra2: dyn.Value.str("example"))), "<service><host><port>80</port></host><host><extra2>example</extra2></host></service>"
  assert both(AnonSpaceTop.new(a: "a", b: "b", c: "c", c1: "c1", d1: "d1"), "<top xmlns=\"space\"><x><a>a</a><b>b</b><c xmlns=\"space\">c</c><c xmlns=\"space1\">c1</c><d xmlns=\"space1\">d1</d></x></top>")
  assert both(AnonNameTop.new(xml_name: xml.name("space0", "top"), a: "a", b: "b", c: "c", c1: "c1", d1: "d1"), "<top xmlns=\"space0\"><x><a>a</a><b>b</b><c xmlns=\"space\">c</c><c xmlns=\"space1\">c1</c><d xmlns=\"space1\">d1</d></x></top>")
  # Go skips the unmarshal half of this one (a TODO in TestUnmarshal).
  assert_eq mx(AnonTopB.new(b: "b", b1: "b1")), "<top><x><b xmlns=\"space\">b</b><b xmlns=\"space1\">b1</b></x></top>"
}

test "marshal: embedding" {
  v = EmbedA.new(embed_c: EmbedC.new(field_b: "A.C.B", field_c: "A.C.C"), embed_b: EmbedB.new(field_b: "A.B.B", embed_c: EmbedC.new(field_a1: "A.B.C.A1", field_a2: "A.B.C.A2", field_c: "A.B.C.C")), field_a: "A.A", embed_d: EmbedD.new(field_e: "A.D.E"))
  assert both(v, "<EmbedA><FieldB>A.C.B</FieldB><FieldC>A.C.C</FieldC><EmbedB><FieldB>A.B.B</FieldB><FieldA><A1>A.B.C.A1</A1><A2>A.B.C.A2</A2></FieldA><FieldC>A.B.C.C</FieldC></EmbedB><FieldA>A.A</FieldA><FieldE>A.D.E</FieldE></EmbedA>")
  assert both(EmbedB.new, "<EmbedB><FieldB></FieldB></EmbedB>")
  assert both(PointerAnonFields.new, "<PointerAnonFields></PointerAnonFields>")
}

test "marshal: names" {
  assert both(NameCasing.new(xy: "mixed", xy2: "upper", xy_a: "mixedA", xy_a2: "upperA"), "<casing Xy=\"mixedA\" XY=\"upperA\"><Xy>mixed</Xy><XY>upper</XY></casing>")
  p = NamePrecedence.new(from_tag: XMLNameWithoutTag.new(value: "A"), from_name_val: XMLNameWithoutTag.new(xml_name: xml.name("", "InXMLName"), value: "B"), from_name_tag: XMLNameWithTag.new(value: "C"), in_field_name: "D")
  assert_eq mx(p), "<Parent><InTag>A</InTag><InXMLName>B</InXMLName><InXMLNameTag>C</InXMLNameTag><InFieldName>D</InFieldName></Parent>"
  p2 = NamePrecedence.new(xml_name: xml.name("", "Parent"), from_tag: XMLNameWithoutTag.new(xml_name: xml.name("", "InTag"), value: "A"), from_name_val: XMLNameWithoutTag.new(xml_name: xml.name("", "FromNameVal"), value: "B"), from_name_tag: XMLNameWithTag.new(xml_name: xml.name("", "InXMLNameTag"), value: "C"), in_field_name: "D")
  assert_eq ux(p2, "<Parent><InTag>A</InTag><FromNameVal>B</FromNameVal><InXMLNameTag>C</InXMLNameTag><InFieldName>D</InFieldName></Parent>"), p2
  assert both(NameInField.new(foo: xml.name("ns", "foo")), "<NameInField><foo xmlns=\"ns\"></foo></NameInField>")
  assert_eq ux(NameInField.new, "<NameInField><foo xmlns=\"ns\"><ignore></ignore></foo></NameInField>"), NameInField.new(foo: xml.name("ns", "foo"))
  assert_eq mx(NameInField.new), "<NameInField><foo xmlns=\"ns\"></foo></NameInField>"
}

test "marshal: attributes" {
  assert both(AttrTest.new(int: 8, named: 9, float: 23.5, uint8: 255, bool: true, str: "str", bytes: b("byt")), "<AttrTest Int=\"8\" int=\"9\" Float=\"23.5\" Uint8=\"255\" Bool=\"true\" Str=\"str\" Bytes=\"byt\"></AttrTest>")
  assert both(AttrTest.new, "<AttrTest Int=\"0\" int=\"0\" Float=\"0\" Uint8=\"0\" Bool=\"false\" Str=\"\" Bytes=\"\"></AttrTest>")
  all = [xml.attr("", "Answer", "42"), xml.attr("", "Int", "8"), xml.attr("", "int", "9"), xml.attr("", "Float", "23.5"), xml.attr("", "Uint8", "255"), xml.attr("", "Bool", "true"), xml.attr("", "Str", "str"), xml.attr("", "Bytes", "byt")]
  assert_eq mx(AttrsTest.new(attrs: all)), "<AttrsTest Answer=\"42\" Int=\"8\" int=\"9\" Float=\"23.5\" Uint8=\"255\" Bool=\"true\" Str=\"str\" Bytes=\"byt\" Int=\"0\" int=\"0\" Float=\"0\" Uint8=\"0\" Bool=\"false\" Str=\"\" Bytes=\"\"></AttrsTest>"
  assert both(AttrsTest.new(attrs: [xml.attr("", "Answer", "42")], int: 8, named: 9, float: 23.5, uint8: 255, bool: true, str: "str", bytes: b("byt")), "<AttrsTest Answer=\"42\" Int=\"8\" int=\"9\" Float=\"23.5\" Uint8=\"255\" Bool=\"true\" Str=\"str\" Bytes=\"byt\"></AttrsTest>")
  zeros = [xml.attr("", "Int", "0"), xml.attr("", "int", "0"), xml.attr("", "Float", "0"), xml.attr("", "Uint8", "0"), xml.attr("", "Bool", "false"), xml.attr("", "Str", ""), xml.attr("", "Bytes", "")]
  assert_eq mx(AttrsTest.new(attrs: zeros)), "<AttrsTest Int=\"0\" int=\"0\" Float=\"0\" Uint8=\"0\" Bool=\"false\" Str=\"\" Bytes=\"\" Int=\"0\" int=\"0\" Float=\"0\" Uint8=\"0\" Bool=\"false\" Str=\"\" Bytes=\"\"></AttrsTest>"
  assert both(OmitAttrTest.new(int: 8, named: 9, float: 23.5, uint8: 255, bool: true, str: "str", bytes: b("byt"), p_str: ""), "<OmitAttrTest Int=\"8\" int=\"9\" Float=\"23.5\" Uint8=\"255\" Bool=\"true\" Str=\"str\" Bytes=\"byt\" PStr=\"\"></OmitAttrTest>")
  assert both(OmitAttrTest.new, "<OmitAttrTest></OmitAttrTest>")
  assert_eq mx(PointerFieldsTest.new(name: "Sarah", age: 12, contents: "lorem ipsum")), "<dummy name=\"Sarah\" age=\"12\">lorem ipsum</dummy>"
  assert_eq mx(ChardataEmptyTest.new), "<test></test>"
}

test "marshal: omitempty fields" {
  assert both(OmitFieldTest.new(int: 8, named: 9, float: 23.5, uint8: 255, bool: true, str: "str", bytes: b("byt"), p_str: "", ptr: PresenceTest.new), "<OmitFieldTest><Int>8</Int><int>9</int><Float>23.5</Float><Uint8>255</Uint8><Bool>true</Bool><Str>str</Str><Bytes>byt</Bytes><PStr></PStr><Ptr></Ptr></OmitFieldTest>")
  assert both(OmitFieldTest.new, "<OmitFieldTest></OmitFieldTest>")
}

test "marshal: any" {
  assert both(AnyTest.new(nested: "known", any_field: AnyHolder.new(xml_name: xml.name("", "other"), xml: "<sub>unknown</sub>")), "<a><nested><value>known</value></nested><other><sub>unknown</sub></other></a>")
  assert both(AnyTest.new(nested: "known", any_field: AnyHolder.new(xml: "<unknown/>", xml_name: xml.name("", "AnyField"))), "<a><nested><value>known</value></nested><AnyField><unknown/></AnyField></a>")
  assert both(AnyOmitTest.new(nested: "b"), "<a><nested><value>b</value></nested></a>")
  assert both(AnySliceTest.new(nested: "b", any_field: [AnyHolder.new(xml_name: xml.name("", "c"), xml: "<d>e</d>"), AnyHolder.new(xml_name: xml.name("f", "g"), xml: "<h>i</h>")]), "<a><nested><value>b</value></nested><c><d>e</d></c><g xmlns=\"f\"><h>i</h></g></a>")
  assert both(AnySliceTest.new(nested: "b"), "<a><nested><value>b</value></nested></a>")
}

test "marshal: recursive types" {
  v = RecurseA.new(a: "a1", b: RecurseB.new(a: RecurseA.new(a: "a2"), b: "b1"))
  assert both(v, "<RecurseA><A>a1</A><B><A><A>a2</A></A><B>b1</B></B></RecurseA>")
}

test "marshal: ignore and escaping" {
  assert both(IgnoreTest.new, "<IgnoreTest></IgnoreTest>")
  assert_eq mx(IgnoreTest.new(public_secret: "can't tell")), "<IgnoreTest></IgnoreTest>"
  assert_eq ux(IgnoreTest.new, "<IgnoreTest><PublicSecret>ignore me</PublicSecret></IgnoreTest>"), IgnoreTest.new
  assert both(AnyTest.new(nested: "dquote: \"; squote: '; ampersand: &; less: <; greater: >;", any_field: AnyHolder.new(xml_name: xml.name("", "empty"))), "<a><nested><value>dquote: &#34;; squote: &#39;; ampersand: &amp;; less: &lt;; greater: &gt;;</value></nested><empty></empty></a>")
  assert both(AnyTest.new(nested: "newline: \n; cr: \r; tab: \t;", any_field: AnyHolder.new(xml_name: xml.name("", "AnyField"))), "<a><nested><value>newline: &#xA;; cr: &#xD;; tab: &#x9;;</value></nested><AnyField></AnyField></a>")
  assert_eq ux(AnyTest.new, "<a><nested><value>1\r2\r\n3\n\r4\n5</value></nested></a>"), AnyTest.new(nested: "1\n2\n3\n\n4\n5")
  assert both(EmbedInt.new(my_int: 42), "<EmbedInt><MyInt>42</MyInt></EmbedInt>")
}

test "marshal: cdata" {
  assert both(CDataTest.new, "<CDataTest></CDataTest>")
  assert both(CDataTest.new(chardata: "http://example.com/tests/1?foo=1&bar=baz"), "<CDataTest><![CDATA[http://example.com/tests/1?foo=1&bar=baz]]></CDataTest>")
  assert both(CDataTest.new(chardata: "Literal <![CDATA[Nested]]>!"), "<CDataTest><![CDATA[Literal <![CDATA[Nested]]]]><![CDATA[>!]]></CDataTest>")
  assert both(CDataTest.new(chardata: "<![CDATA[Nested]]> Literal!"), "<CDataTest><![CDATA[<![CDATA[Nested]]]]><![CDATA[> Literal!]]></CDataTest>")
  assert both(CDataTest.new(chardata: "<![CDATA[Nested]]> Literal! <![CDATA[Nested]]> Literal!"), "<CDataTest><![CDATA[<![CDATA[Nested]]]]><![CDATA[> Literal! <![CDATA[Nested]]]]><![CDATA[> Literal!]]></CDataTest>")
  assert both(CDataTest.new(chardata: "<![CDATA[<![CDATA[Nested]]>]]>"), "<CDataTest><![CDATA[<![CDATA[<![CDATA[Nested]]]]><![CDATA[>]]]]><![CDATA[>]]></CDataTest>")
}

test "marshal: omitempty with a parent chain; marshalers; embedded names" {
  assert both(Strings.new, "<Strings><A></A></Strings>")
  assert both(MyMarshalerTest.new, "<MyMarshalerTest>hello world</MyMarshalerTest>")
  assert both(MarshalerStruct.new, "<MarshalerStruct Foo=\"hello world\"></MarshalerStruct>")
  assert both(OuterStruct.new(int_attr: 10), "<outer xmlns=\"testns\" int=\"10\"></outer>")
  assert both(OuterNamedStruct.new(xml_name: xml.name("outerns", "test"), int_attr: 10), "<test xmlns=\"outerns\" int=\"10\"></test>")
  assert both(OuterNamedOrderedStruct.new(xml_name: xml.name("outerns", "test"), int_attr: 10), "<test xmlns=\"outerns\" int=\"10\"></test>")
  assert both(OuterOuterStruct.new(outer: OuterStruct.new(int_attr: 10)), "<outer xmlns=\"testns\" int=\"10\"></outer>")
  assert both(NestedAndChardata.new(ab: ["", ""], chardata: "test"), "<NestedAndChardata><A><B></B><B></B></A>test</NestedAndChardata>")
  assert both(NestedAndComment.new(ab: ["", ""], comment: "test"), "<NestedAndComment><A><B></B><B></B></A><!--test--></NestedAndComment>")
  assert both(NestedAndCData.new(ab: ["", ""], cdata: "test"), "<NestedAndCData><A><B></B><B></B></A><![CDATA[test]]></NestedAndCData>")
}

test "marshal: indirection in comments, chardata and cdata" {
  assert_eq mx(IndirComment.new(comment: "hi")), "<IndirComment><T1></T1><!--hi--><T2></T2></IndirComment>"
  assert_eq mx(IndirComment.new(comment: "")), "<IndirComment><T1></T1><T2></T2></IndirComment>"
  assert contains?(mx(IndirComment.new), "xml: bad type for comment field of IndirComment")
  assert_eq ux(IndirComment.new, "<IndirComment><T1></T1><!--hi--><T2></T2></IndirComment>"), IndirComment.new
  assert_eq mx(IfaceComment.new(comment: dyn.Value.str("hi"))), "<IfaceComment><T1></T1><!--hi--><T2></T2></IfaceComment>"
  assert_eq ue(IfaceComment.new, "<IfaceComment><T1></T1><!--hi--><T2></T2></IfaceComment>"), ""
  assert contains?(mx(IfaceComment.new), "xml: bad type for comment field of IfaceComment")
  assert_eq ue(IfaceComment.new, "<IfaceComment><T1></T1><T2></T2></IfaceComment>"), ""
  assert both(DirectComment.new(comment: "hi"), "<DirectComment><T1></T1><!--hi--><T2></T2></DirectComment>")
  assert both(DirectComment.new(comment: ""), "<DirectComment><T1></T1><T2></T2></DirectComment>")
  assert both(IndirChardata.new(chardata: "hi"), "<IndirChardata><T1></T1>hi<T2></T2></IndirChardata>")
  assert_eq ux(IndirChardata.new, "<IndirChardata><T1></T1><![CDATA[hi]]><T2></T2></IndirChardata>"), IndirChardata.new(chardata: "hi")
  assert both(IndirChardata.new(chardata: ""), "<IndirChardata><T1></T1><T2></T2></IndirChardata>")
  assert_eq mx(IndirChardata.new), "<IndirChardata><T1></T1><T2></T2></IndirChardata>"
  assert_eq mx(IfaceChardata.new(chardata: dyn.Value.str("hi"))), "<IfaceChardata><T1></T1>hi<T2></T2></IfaceChardata>"
  assert contains?(ue(IfaceChardata.new, "<IfaceChardata><T1></T1>hi<T2></T2></IfaceChardata>"), "cannot unmarshal into interface {}")
  assert contains?(ue(IfaceChardata.new, "<IfaceChardata><T1></T1><![CDATA[hi]]><T2></T2></IfaceChardata>"), "cannot unmarshal into interface {}")
  assert_eq mx(IfaceChardata.new(chardata: dyn.Value.str(""))), "<IfaceChardata><T1></T1><T2></T2></IfaceChardata>"
  assert contains?(ue(IfaceChardata.new, "<IfaceChardata><T1></T1><T2></T2></IfaceChardata>"), "cannot unmarshal into interface {}")
  assert_eq mx(IfaceChardata.new), "<IfaceChardata><T1></T1><T2></T2></IfaceChardata>"
  assert both(DirectChardata.new(chardata: "hi"), "<DirectChardata><T1></T1>hi<T2></T2></DirectChardata>")
  assert_eq ux(DirectChardata.new, "<DirectChardata><T1></T1><![CDATA[hi]]><T2></T2></DirectChardata>"), DirectChardata.new(chardata: "hi")
  assert both(DirectChardata.new(chardata: ""), "<DirectChardata><T1></T1><T2></T2></DirectChardata>")
  assert both(IndirCDATA.new(cdata: "hi"), "<IndirCDATA><T1></T1><![CDATA[hi]]><T2></T2></IndirCDATA>")
  assert_eq ux(IndirCDATA.new, "<IndirCDATA><T1></T1>hi<T2></T2></IndirCDATA>"), IndirCDATA.new(cdata: "hi")
  assert both(IndirCDATA.new(cdata: ""), "<IndirCDATA><T1></T1><T2></T2></IndirCDATA>")
  assert_eq mx(IndirCDATA.new), "<IndirCDATA><T1></T1><T2></T2></IndirCDATA>"
  assert_eq mx(IfaceCDATA.new(cdata: dyn.Value.str("hi"))), "<IfaceCDATA><T1></T1><![CDATA[hi]]><T2></T2></IfaceCDATA>"
  assert contains?(ue(IfaceCDATA.new, "<IfaceCDATA><T1></T1><![CDATA[hi]]><T2></T2></IfaceCDATA>"), "cannot unmarshal into interface {}")
  assert contains?(ue(IfaceCDATA.new, "<IfaceCDATA><T1></T1>hi<T2></T2></IfaceCDATA>"), "cannot unmarshal into interface {}")
  assert_eq mx(IfaceCDATA.new(cdata: dyn.Value.str(""))), "<IfaceCDATA><T1></T1><T2></T2></IfaceCDATA>"
  assert_eq mx(IfaceCDATA.new), "<IfaceCDATA><T1></T1><T2></T2></IfaceCDATA>"
  assert both(DirectCDATA.new(cdata: "hi"), "<DirectCDATA><T1></T1><![CDATA[hi]]><T2></T2></DirectCDATA>")
  assert_eq ux(DirectCDATA.new, "<DirectCDATA><T1></T1>hi<T2></T2></DirectCDATA>"), DirectCDATA.new(cdata: "hi")
  assert both(DirectCDATA.new(cdata: ""), "<DirectCDATA><T1></T1><T2></T2></DirectCDATA>")
}

test "marshal: indirection in innerxml, elements, omitempty and any" {
  assert_eq mx(IndirInnerXML.new(inner_xml: "<hi/>")), "<IndirInnerXML><T1></T1><hi/><T2></T2></IndirInnerXML>"
  assert_eq mx(IndirInnerXML.new(inner_xml: "")), "<IndirInnerXML><T1></T1><T2></T2></IndirInnerXML>"
  assert both(IndirInnerXML.new, "<IndirInnerXML><T1></T1><T2></T2></IndirInnerXML>")
  assert_eq ux(IndirInnerXML.new, "<IndirInnerXML><T1></T1><hi/><T2></T2></IndirInnerXML>"), IndirInnerXML.new
  assert_eq mx(IfaceInnerXML.new(inner_xml: dyn.Value.str("<hi/>"))), "<IfaceInnerXML><T1></T1><hi/><T2></T2></IfaceInnerXML>"
  assert_eq mx(ux(IfaceInnerXML.new, "<IfaceInnerXML><T1></T1><hi/><T2></T2></IfaceInnerXML>")), mx(IfaceInnerXML.new)
  assert both(IfaceInnerXML.new, "<IfaceInnerXML><T1></T1><T2></T2></IfaceInnerXML>")
  assert_eq mx(DirectInnerXML.new(inner_xml: "<hi/>")), "<DirectInnerXML><T1></T1><hi/><T2></T2></DirectInnerXML>"
  assert_eq ux(DirectInnerXML.new, "<DirectInnerXML><T1></T1><hi/><T2></T2></DirectInnerXML>"), DirectInnerXML.new(inner_xml: "<T1></T1><hi/><T2></T2>")
  assert_eq mx(DirectInnerXML.new(inner_xml: "")), "<DirectInnerXML><T1></T1><T2></T2></DirectInnerXML>"
  assert_eq ux(DirectInnerXML.new, "<DirectInnerXML><T1></T1><T2></T2></DirectInnerXML>"), DirectInnerXML.new(inner_xml: "<T1></T1><T2></T2>")
  assert both(IndirElement.new(element: "hi"), "<IndirElement><T1></T1><Element>hi</Element><T2></T2></IndirElement>")
  assert both(IndirElement.new(element: ""), "<IndirElement><T1></T1><Element></Element><T2></T2></IndirElement>")
  assert both(IndirElement.new, "<IndirElement><T1></T1><T2></T2></IndirElement>")
  assert_eq mx(IfaceElement.new(element: dyn.Value.str("hi"))), "<IfaceElement><T1></T1><Element>hi</Element><T2></T2></IfaceElement>"
  assert_eq mx(ux(IfaceElement.new, "<IfaceElement><T1></T1><Element>hi</Element><T2></T2></IfaceElement>")), mx(IfaceElement.new)
  assert both(IfaceElement.new, "<IfaceElement><T1></T1><T2></T2></IfaceElement>")
  assert both(DirectElement.new(element: "hi"), "<DirectElement><T1></T1><Element>hi</Element><T2></T2></DirectElement>")
  assert both(DirectElement.new(element: ""), "<DirectElement><T1></T1><Element></Element><T2></T2></DirectElement>")
  assert both(IndirOmitEmpty.new(omit_empty: "hi"), "<IndirOmitEmpty><T1></T1><OmitEmpty>hi</OmitEmpty><T2></T2></IndirOmitEmpty>")
  assert_eq mx(IndirOmitEmpty.new(omit_empty: "")), "<IndirOmitEmpty><T1></T1><OmitEmpty></OmitEmpty><T2></T2></IndirOmitEmpty>"
  assert_eq ux(IndirOmitEmpty.new, "<IndirOmitEmpty><T1></T1><OmitEmpty></OmitEmpty><T2></T2></IndirOmitEmpty>"), IndirOmitEmpty.new(omit_empty: "")
  assert both(IndirOmitEmpty.new, "<IndirOmitEmpty><T1></T1><T2></T2></IndirOmitEmpty>")
  assert_eq mx(IfaceOmitEmpty.new(omit_empty: dyn.Value.str("hi"))), "<IfaceOmitEmpty><T1></T1><OmitEmpty>hi</OmitEmpty><T2></T2></IfaceOmitEmpty>"
  assert_eq mx(ux(IfaceOmitEmpty.new, "<IfaceOmitEmpty><T1></T1><OmitEmpty>hi</OmitEmpty><T2></T2></IfaceOmitEmpty>")), mx(IfaceOmitEmpty.new)
  assert both(IfaceOmitEmpty.new, "<IfaceOmitEmpty><T1></T1><T2></T2></IfaceOmitEmpty>")
  assert both(DirectOmitEmpty.new(omit_empty: "hi"), "<DirectOmitEmpty><T1></T1><OmitEmpty>hi</OmitEmpty><T2></T2></DirectOmitEmpty>")
  assert both(DirectOmitEmpty.new(omit_empty: ""), "<DirectOmitEmpty><T1></T1><T2></T2></DirectOmitEmpty>")
  assert both(IndirAny.new(any: "hi"), "<IndirAny><T1></T1><any>hi</any><T2></T2></IndirAny>")
  assert both(IndirAny.new(any: ""), "<IndirAny><T1></T1><any></any><T2></T2></IndirAny>")
  assert both(IndirAny.new, "<IndirAny><T1></T1><T2></T2></IndirAny>")
  assert_eq mx(IfaceAny.new(any: dyn.Value.str("hi"))), "<IfaceAny><T1></T1><any>hi</any><T2></T2></IfaceAny>"
  assert_eq mx(ux(IfaceAny.new, "<IfaceAny><T1></T1><any>hi</any><T2></T2></IfaceAny>")), mx(IfaceAny.new)
  assert both(IfaceAny.new, "<IfaceAny><T1></T1><T2></T2></IfaceAny>")
  assert both(DirectAny.new(any: "hi"), "<DirectAny><T1></T1><any>hi</any><T2></T2></DirectAny>")
  assert both(DirectAny.new(any: ""), "<DirectAny><T1></T1><any></any><T2></T2></DirectAny>")
  assert_eq ux(IndirAny.new, "<IndirFoo><T1></T1><Foo>hi</Foo><T2></T2></IndirFoo>"), IndirAny.new(any: "hi")
  assert_eq ux(IndirAny.new, "<IndirFoo><T1></T1><Foo></Foo><T2></T2></IndirFoo>"), IndirAny.new(any: "")
  assert_eq ux(IndirAny.new, "<IndirFoo><T1></T1><T2></T2></IndirFoo>"), IndirAny.new
  assert_eq mx(ux(IfaceAny.new, "<IfaceFoo><T1></T1><Foo>hi</Foo><T2></T2></IfaceFoo>")), mx(IfaceAny.new)
  assert_eq mx(ux(IfaceAny.new, "<IfaceFoo><T1></T1><T2></T2></IfaceFoo>")), mx(IfaceAny.new)
  assert_eq ux(DirectAny.new, "<DirectFoo><T1></T1><Foo>hi</Foo><T2></T2></DirectFoo>"), DirectAny.new(any: "hi")
  assert_eq ux(DirectAny.new, "<DirectFoo><T1></T1><Foo></Foo><T2></T2></DirectFoo>"), DirectAny.new(any: "")
}
