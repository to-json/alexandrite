import "encoding/xml"
import "dyn"
import "time"

# Go's marshal_test.go: the marshalTests table (TestMarshal and
# TestUnmarshal) over the same types, translated. Go's field names are
# capitalized and name elements by default; alx fields are lower case, so
# fields carry their Go name in the tag where Go has none.

#[derive(Xml)]
struct Passenger {
  #[field(xml: "name")] name: [Str]
  #[field(xml: "weight")] weight: Float
}

#[derive(Xml)]
struct Ship {
  #[field(xml: "spaceship")] xml_name: E
  #[field(xml: "name,attr")] name: Str
  #[field(xml: "pilot,attr")] pilot: Str
  #[field(xml: "drive")] drive: Int
  #[field(xml: "age")] age: U64
  #[field(xml: "passenger")] passenger: [Passenger?]
  #[field(xml: "-")] secret: Str
}

#[derive(Xml)]
struct Port {
  #[field(xml: "port")] xml_name: E
  #[field(xml: "type,attr,omitempty")] typ: Str
  #[field(xml: ",comment")] comment: Str
  #[field(xml: ",chardata")] number: Str
}

#[derive(Xml)]
struct Domain {
  #[field(xml: "domain")] xml_name: E
  #[field(xml: "Country,attr,omitempty")] country: Str
  #[field(xml: ",chardata")] name: [Byte]
  #[field(xml: ",comment")] comment: [Byte]
}

#[derive(Xml)]
struct Book {
  #[field(xml: "book")] xml_name: E
  #[field(xml: ",chardata")] title: Str
}

#[derive(Xml)]
struct Event {
  #[field(xml: "event")] xml_name: E
  #[field(xml: ",chardata")] year: Int
}

#[derive(Xml)]
struct Movie {
  #[field(xml: "movie")] xml_name: E
  #[field(xml: ",chardata")] length: U64
}

#[derive(Xml)]
struct Pi {
  #[field(xml: "pi")] xml_name: E
  #[field(xml: ",chardata")] approximation: Float
}

#[derive(Xml)]
struct Universe {
  #[field(xml: "universe")] xml_name: E
  #[field(xml: ",chardata")] visible: Float
}

#[derive(Xml)]
struct Particle {
  #[field(xml: "particle")] xml_name: E
  #[field(xml: ",chardata")] has_mass: Bool
}

#[derive(Xml)]
struct Departure {
  #[field(xml: "departure")] xml_name: E
  #[field(xml: ",chardata")] when: time.Time
}

#[derive(Xml)]
struct SecretAgent {
  #[field(xml: "agent")] xml_name: E
  #[field(xml: "handle,attr")] handle: Str
  #[field(xml: "Identity")] identity: Str
  #[field(xml: ",innerxml")] obfuscate: Str
}

#[derive(Xml)]
struct NestedItems {
  #[field(xml: "result")] xml_name: E
  #[field(xml: "Items>item")] items: [Str]
  #[field(xml: "Items>item1")] item1: [Str]
}

#[derive(Xml)]
struct NestedOrder {
  #[field(xml: "result")] xml_name: E
  #[field(xml: "parent>c")] field1: Str
  #[field(xml: "parent>b")] field2: Str
  #[field(xml: "parent>a")] field3: Str
}

#[derive(Xml)]
struct MixedNested {
  #[field(xml: "result")] xml_name: E
  #[field(xml: "parent1>a")] a: Str
  #[field(xml: "b")] b: Str
  #[field(xml: "parent1>parent2>c")] c: Str
  #[field(xml: "parent1>d")] d: Str
}

#[derive(Xml)]
struct NilTest {
  #[field(xml: "parent1>parent2>a")] a: dyn.Value
  #[field(xml: "parent1>b")] b: dyn.Value
  #[field(xml: "parent1>parent2>c")] c: dyn.Value
}

#[derive(Xml)]
struct Service {
  #[field(xml: "service")] xml_name: E
  #[field(xml: "host>domain")] domain: Domain?
  #[field(xml: "host>port")] port: Port?
  #[field(xml: "Extra1")] extra1: dyn.Value
  #[field(xml: "host>extra2")] extra2: dyn.Value
}

#[derive(Xml)]
struct EmbedA {
  #[field(xml: ",embed")] embed_c: EmbedC
  #[field(xml: "EmbedB")] embed_b: EmbedB
  #[field(xml: "FieldA")] field_a: Str
  #[field(xml: ",embed")] embed_d: EmbedD
}

#[derive(Xml)]
struct EmbedB {
  #[field(xml: "FieldB")] field_b: Str
  #[field(xml: ",embed")] embed_c: EmbedC?
}

#[derive(Xml)]
struct EmbedC {
  #[field(xml: "FieldA>A1")] field_a1: Str
  #[field(xml: "FieldA>A2")] field_a2: Str
  #[field(xml: "FieldB")] field_b: Str
  #[field(xml: "FieldC")] field_c: Str
}

#[derive(Xml)]
struct EmbedD {
  #[field(xml: "-")] field_d: Str
  #[field(xml: "FieldE")] field_e: Str
}

#[derive(Xml)]
struct NameCasing {
  #[field(xml: "casing")] xml_name: E
  #[field(xml: "Xy")] xy: Str
  #[field(xml: "XY")] xy2: Str
  #[field(xml: "Xy,attr")] xy_a: Str
  #[field(xml: "XY,attr")] xy_a2: Str
}

#[derive(Xml)]
struct NamePrecedence {
  #[field(xml: "Parent")] xml_name: xml.Name
  #[field(xml: "InTag")] from_tag: XMLNameWithoutTag
  #[field(xml: "FromNameVal")] from_name_val: XMLNameWithoutTag
  from_name_tag: XMLNameWithTag
  #[field(xml: "InFieldName")] in_field_name: Str
}

#[derive(Xml)]
struct XMLNameWithTag {
  #[field(xml: "InXMLNameTag")] xml_name: xml.Name
  #[field(xml: ",chardata")] value: Str
}

#[derive(Xml)]
struct XMLNameWithoutTag {
  xml_name: xml.Name
  #[field(xml: ",chardata")] value: Str
}

#[derive(Xml)]
struct NameInField {
  #[field(xml: "ns foo")] foo: xml.Name
}

#[derive(Xml)]
struct AttrTest {
  #[field(xml: "Int,attr")] int: Int
  #[field(xml: "int,attr")] named: Int
  #[field(xml: "Float,attr")] float: Float
  #[field(xml: "Uint8,attr")] uint8: U8
  #[field(xml: "Bool,attr")] bool: Bool
  #[field(xml: "Str,attr")] str: Str
  #[field(xml: "Bytes,attr")] bytes: [Byte]
}

#[derive(Xml)]
struct AttrsTest {
  #[field(xml: ",any,attr")] attrs: [xml.Attr]
  #[field(xml: "Int,attr")] int: Int
  #[field(xml: "int,attr")] named: Int
  #[field(xml: "Float,attr")] float: Float
  #[field(xml: "Uint8,attr")] uint8: U8
  #[field(xml: "Bool,attr")] bool: Bool
  #[field(xml: "Str,attr")] str: Str
  #[field(xml: "Bytes,attr")] bytes: [Byte]
}

#[derive(Xml)]
struct OmitAttrTest {
  #[field(xml: "Int,attr,omitempty")] int: Int
  #[field(xml: "int,attr,omitempty")] named: Int
  #[field(xml: "Float,attr,omitempty")] float: Float
  #[field(xml: "Uint8,attr,omitempty")] uint8: U8
  #[field(xml: "Bool,attr,omitempty")] bool: Bool
  #[field(xml: "Str,attr,omitempty")] str: Str
  #[field(xml: "Bytes,attr,omitempty")] bytes: [Byte]
  #[field(xml: "PStr,attr,omitempty")] p_str: Str?
}

#[derive(Xml)]
struct OmitFieldTest {
  #[field(xml: "Int,omitempty")] int: Int
  #[field(xml: "int,omitempty")] named: Int
  #[field(xml: "Float,omitempty")] float: Float
  #[field(xml: "Uint8,omitempty")] uint8: U8
  #[field(xml: "Bool,omitempty")] bool: Bool
  #[field(xml: "Str,omitempty")] str: Str
  #[field(xml: "Bytes,omitempty")] bytes: [Byte]
  #[field(xml: "PStr,omitempty")] p_str: Str?
  #[field(xml: "Ptr,omitempty")] ptr: PresenceTest?
}

#[derive(Xml)]
struct AnyTest {
  #[field(xml: "a")] xml_name: E
  #[field(xml: "nested>value")] nested: Str
  #[field(xml: ",any")] any_field: AnyHolder
}

#[derive(Xml)]
struct AnyOmitTest {
  #[field(xml: "a")] xml_name: E
  #[field(xml: "nested>value")] nested: Str
  #[field(xml: ",any,omitempty")] any_field: AnyHolder?
}

#[derive(Xml)]
struct AnySliceTest {
  #[field(xml: "a")] xml_name: E
  #[field(xml: "nested>value")] nested: Str
  #[field(xml: ",any")] any_field: [AnyHolder]
}

#[derive(Xml)]
struct AnyHolder {
  xml_name: xml.Name
  #[field(xml: ",innerxml")] xml: Str
}

#[derive(Xml)]
struct Empty {}

#[derive(Xml)]
struct PresenceTest {
  #[field(xml: "Exists")] exists: Empty?
}

#[derive(Xml)]
struct IgnoreTest {
  #[field(xml: "-")] public_secret: Str
}

#[derive(Xml)]
struct Data {
  #[field(xml: "Bytes")] bytes: [Byte]
  #[field(xml: "Attr,attr")] attr: [Byte]
