test "Issue20396" {
  attr_err = "XML syntax error on line 1: expected attribute name in element"
  cases = [
    ("<a:te:st xmlns:a=\"abcd\"/>", "XML syntax error on line 1: expected element name after <"),
    ("<a:te=st xmlns:a=\"abcd\"/>", attr_err),
    ("<a:te&st xmlns:a=\"abcd\"/>", attr_err),
    ("<a:test xmlns:a=\"abcd\"/>", ""),
    ("<a:te:st xmlns:a=\"abcd\">1</a:te:st>", "XML syntax error on line 1: expected element name after <"),
    ("<a:te=st xmlns:a=\"abcd\">1</a:te=st>", attr_err),
    ("<a:te&st xmlns:a=\"abcd\">1</a:te&st>", attr_err),
    ("<a:test xmlns:a=\"abcd\">1</a:test>", ""),
  ]
  for c in cases {
    assert_eq ue(StrDest.new, c[0]), c[1]
  }
}

