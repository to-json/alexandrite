import "encoding/xml"
import "dyn"
import "strconv"
import "strings"
import "time"

# Go's read_test.go and atom_test.go, and the derive-using tests of
# xml_test.go and marshal_test.go.

#[derive(Xml)]
struct Feed {
  #[field(xml: "http://www.w3.org/2005/Atom feed")] xml_name: xml.Name
  #[field(xml: "title")] title: Str
  #[field(xml: "id")] id: Str
  #[field(xml: "link")] link: [Link]
  #[field(xml: "updated,attr")] updated: time.Time
  #[field(xml: "author")] author: Person
  #[field(xml: "entry")] entry: [Entry]
}

#[derive(Xml)]
struct Entry {
  #[field(xml: "title")] title: Str
  #[field(xml: "id")] id: Str
  #[field(xml: "link")] link: [Link]
  #[field(xml: "updated")] updated: time.Time
  #[field(xml: "author")] author: Person
  #[field(xml: "summary")] summary: Text
}

#[derive(Xml)]
struct Link {
  #[field(xml: "rel,attr,omitempty")] rel: Str
  #[field(xml: "href,attr")] href: Str
}

#[derive(Xml)]
struct Person {
  #[field(xml: "name")] name: Str
  #[field(xml: "uri")] uri: Str
  #[field(xml: "email")] email: Str
  #[field(xml: ",innerxml")] inner_xml: Str
}

#[derive(Xml)]
struct Text {
  #[field(xml: "type,attr,omitempty")] typ: Str
  #[field(xml: ",chardata")] body: Str
}

def pt(s: Str) -> time.Time { time.parse(time.RFC3339, s).unwrap }

ATOM_FEED_STRING = "\n<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<feed xmlns=\"http://www.w3.org/2005/Atom\" xml:lang=\"en-us\" updated=\"2009-10-04T01:35:58+00:00\"><title>Code Review - My issues</title><link href=\"http://codereview.appspot.com/\" rel=\"alternate\"></link><link href=\"http://codereview.appspot.com/rss/mine/rsc\" rel=\"self\"></link><id>http://codereview.appspot.com/</id><author><name>rietveld&lt;&gt;</name></author><entry><title>rietveld: an attempt at pubsubhubbub\n</title><link href=\"http://codereview.appspot.com/126085\" rel=\"alternate\"></link><updated>2009-10-04T01:35:58+00:00</updated><author><name>email-address-removed</name></author><id>urn:md5:134d9179c41f806be79b3a5f7877d19a</id><summary type=\"html\">\n  An attempt at adding pubsubhubbub support to Rietveld.\nhttp://code.google.com/p/pubsubhubbub\nhttp://code.google.com/p/rietveld/issues/detail?id=155\n\nThe server side of the protocol is trivial:\n  1. add a &amp;lt;link rel=&amp;quot;hub&amp;quot; href=&amp;quot;hub-server&amp;quot;&amp;gt; tag to all\n     feeds that will be pubsubhubbubbed.\n  2. every time one of those feeds changes, tell the hub\n     with a simple POST request.\n\nI have tested this by adding debug prints to a local hub\nserver and checking that the server got the right publish\nrequests.\n\nI can&amp;#39;t quite get the server to work, but I think the bug\nis not in my code.  I think that the server expects to be\nable to grab the feed and see the feed&amp;#39;s actual URL in\nthe link rel=&amp;quot;self&amp;quot;, but the default value for that drops\nthe :port from the URL, and I cannot for the life of me\nfigure out how to get the Atom generator deep inside\ndjango not to do that, or even where it is doing that,\nor even what code is running to generate the Atom feed.\n(I thought I knew but I added some assert False statements\nand it kept running!)\n\nIgnoring that particular problem, I would appreciate\nfeedback on the right way to get the two values at\nthe top of feeds.py marked NOTE(rsc).\n\n\n</summary></entry><entry><title>rietveld: correct tab handling\n</title><link href=\"http://codereview.appspot.com/124106\" rel=\"alternate\"></link><updated>2009-10-03T23:02:17+00:00</updated><author><name>email-address-removed</name></author><id>urn:md5:0a2a4f19bb815101f0ba2904aed7c35a</id><summary type=\"html\">\n  This fixes the buggy tab rendering that can be seen at\nhttp://codereview.appspot.com/116075/diff/1/2\n\nThe fundamental problem was that the tab code was\nnot being told what column the text began in, so it\ndidn&amp;#39;t know where to put the tab stops.  Another problem\nwas that some of the code assumed that string byte\noffsets were the same as column offsets, which is only\ntrue if there are no tabs.\n\nIn the process of fixing this, I cleaned up the arguments\nto Fold and ExpandTabs and renamed them Break and\n_ExpandTabs so that I could be sure that I found all the\ncall sites.  I also wanted to verify that ExpandTabs was\nnot being used from outside intra_region_diff.py.\n\n\n</summary></entry></feed> \t   "

SUMMARY1 = "\n  An attempt at adding pubsubhubbub support to Rietveld.\nhttp://code.google.com/p/pubsubhubbub\nhttp://code.google.com/p/rietveld/issues/detail?id=155\n\nThe server side of the protocol is trivial:\n  1. add a &lt;link rel=&quot;hub&quot; href=&quot;hub-server&quot;&gt; tag to all\n     feeds that will be pubsubhubbubbed.\n  2. every time one of those feeds changes, tell the hub\n     with a simple POST request.\n\nI have tested this by adding debug prints to a local hub\nserver and checking that the server got the right publish\nrequests.\n\nI can&#39;t quite get the server to work, but I think the bug\nis not in my code.  I think that the server expects to be\nable to grab the feed and see the feed&#39;s actual URL in\nthe link rel=&quot;self&quot;, but the default value for that drops\nthe :port from the URL, and I cannot for the life of me\nfigure out how to get the Atom generator deep inside\ndjango not to do that, or even where it is doing that,\nor even what code is running to generate the Atom feed.\n(I thought I knew but I added some assert False statements\nand it kept running!)\n\nIgnoring that particular problem, I would appreciate\nfeedback on the right way to get the two values at\nthe top of feeds.py marked NOTE(rsc).\n\n\n"

SUMMARY2 = "\n  This fixes the buggy tab rendering that can be seen at\nhttp://codereview.appspot.com/116075/diff/1/2\n\nThe fundamental problem was that the tab code was\nnot being told what column the text began in, so it\ndidn&#39;t know where to put the tab stops.  Another problem\nwas that some of the code assumed that string byte\noffsets were the same as column offsets, which is only\ntrue if there are no tabs.\n\nIn the process of fixing this, I cleaned up the arguments\nto Fold and ExpandTabs and renamed them Break and\n_ExpandTabs so that I could be sure that I found all the\ncall sites.  I also wanted to verify that ExpandTabs was\nnot being used from outside intra_region_diff.py.\n\n\n"

def atom_feed -> Feed {
  Feed.new(
    xml_name: xml.name("http://www.w3.org/2005/Atom", "feed"),
    title: "Code Review - My issues",
    link: [Link.new(rel: "alternate", href: "http://codereview.appspot.com/"), Link.new(rel: "self", href: "http://codereview.appspot.com/rss/mine/rsc")],
    id: "http://codereview.appspot.com/",
    updated: pt("2009-10-04T01:35:58+00:00"),
    author: Person.new(name: "rietveld<>", inner_xml: "<name>rietveld&lt;&gt;</name>"),
    entry: [
      Entry.new(title: "rietveld: an attempt at pubsubhubbub\n", link: [Link.new(rel: "alternate", href: "http://codereview.appspot.com/126085")], updated: pt("2009-10-04T01:35:58+00:00"), author: Person.new(name: "email-address-removed", inner_xml: "<name>email-address-removed</name>"), id: "urn:md5:134d9179c41f806be79b3a5f7877d19a", summary: Text.new(typ: "html", body: SUMMARY1)),
      Entry.new(title: "rietveld: correct tab handling\n", link: [Link.new(rel: "alternate", href: "http://codereview.appspot.com/124106")], updated: pt("2009-10-03T23:02:17+00:00"), author: Person.new(name: "email-address-removed", inner_xml: "<name>email-address-removed</name>"), id: "urn:md5:0a2a4f19bb815101f0ba2904aed7c35a", summary: Text.new(typ: "html", body: SUMMARY2)),
    ],
  )
}

test "UnmarshalFeed" {
  f = Feed.~from_xml(ATOM_FEED_STRING)
  want = atom_feed()
  assert_eq f.title, want.title
  assert_eq f.author, want.author
  assert_eq f.entry[0].summary.body, SUMMARY1
  assert f == want, "the feed differs"
}

# atom_test.go
def atom_value -> Feed {
  Feed.new(
    xml_name: xml.name("http://www.w3.org/2005/Atom", "feed"),
    title: "Example Feed",
    link: [Link.new(href: "http://example.org/")],
    updated: pt("2003-12-13T18:30:02Z"),
    author: Person.new(name: "John Doe"),
    id: "urn:uuid:60a76c80-d399-11d9-b93C-0003939e0af6",
    entry: [Entry.new(title: "Atom-Powered Robots Run Amok", link: [Link.new(href: "http://example.org/2003/12/13/atom03")], id: "urn:uuid:1225c695-cfb8-4ebb-aaaa-80da344efa6a", updated: pt("2003-12-13T18:30:02Z"), summary: Text.new(body: "Some text."))],
  )
}

ATOM_XML = "<feed xmlns=\"http://www.w3.org/2005/Atom\" updated=\"2003-12-13T18:30:02Z\"><title>Example Feed</title><id>urn:uuid:60a76c80-d399-11d9-b93C-0003939e0af6</id><link href=\"http://example.org/\"></link><author><name>John Doe</name><uri></uri><email></email></author><entry><title>Atom-Powered Robots Run Amok</title><id>urn:uuid:1225c695-cfb8-4ebb-aaaa-80da344efa6a</id><link href=\"http://example.org/2003/12/13/atom03\"></link><updated>2003-12-13T18:30:02Z</updated><author><name></name><uri></uri><email></email></author><summary>Some text.</summary></entry></feed>"

test "atom value both ways" {
  assert_eq mx(atom_value()), ATOM_XML
  f = Feed.~from_xml(ATOM_XML)
  # Go's TestUnmarshal clears the InnerXML fields before comparing.
  f.author.inner_xml = ""
  es: [Entry] = []
  for e in f.entry {
    x = e
    x.author.inner_xml = ""
    es << x
  }
  f.entry = es
  assert f == atom_value(), "the feed differs"
}

PATH_TEST_STRING = "\n<Result>\n    <Before>1</Before>\n    <Items>\n        <Item1>\n            <Value>A</Value>\n        </Item1>\n        <Item2>\n            <Value>B</Value>\n        </Item2>\n        <Item1>\n            <Value>C</Value>\n            <Value>D</Value>\n        </Item1>\n        <_>\n            <Value>E</Value>\n        </_>\n    </Items>\n    <After>2</After>\n</Result>\n"

#[derive(Xml)]
struct PathTestItem {
  #[field(xml: "Value")] value: Str
}

#[derive(Xml)]
struct PathTestA {
  #[field(xml: "Items>Item1")] items: [PathTestItem]
  #[field(xml: "Before")] before: Str
  #[field(xml: "After")] after: Str
}

#[derive(Xml)]
struct PathTestB {
  #[field(xml: "Items>Item1")] other: [PathTestItem]
  #[field(xml: "Before")] before: Str
  #[field(xml: "After")] after: Str
}

#[derive(Xml)]
struct PathTestC {
  #[field(xml: "Items>Item1>Value")] values1: [Str]
  #[field(xml: "Items>Item2>Value")] values2: [Str]
  #[field(xml: "Before")] before: Str
  #[field(xml: "After")] after: Str
}

#[derive(Xml)]
struct PathTestSet {
  #[field(xml: "Item1")] item1: [PathTestItem]
}

#[derive(Xml)]
struct PathTestD {
  #[field(xml: "Items")] other: PathTestSet
  #[field(xml: "Before")] before: Str
  #[field(xml: "After")] after: Str
}

#[derive(Xml)]
struct PathTestE {
  #[field(xml: "Items>_>Value")] underline: Str
  #[field(xml: "Before")] before: Str
  #[field(xml: "After")] after: Str
}

def items(xs: [Str]) -> [PathTestItem] {
  out: [PathTestItem] = []
  for x in xs {
    out << PathTestItem.new(value: x)
  }
  out
}

test "UnmarshalPaths" {
  assert_eq PathTestA.~from_xml(PATH_TEST_STRING), PathTestA.new(items: items(["A", "D"]), before: "1", after: "2")
  assert_eq PathTestB.~from_xml(PATH_TEST_STRING), PathTestB.new(other: items(["A", "D"]), before: "1", after: "2")
  assert_eq PathTestC.~from_xml(PATH_TEST_STRING), PathTestC.new(values1: ["A", "C", "D"], values2: ["B"], before: "1", after: "2")
  assert_eq PathTestD.~from_xml(PATH_TEST_STRING), PathTestD.new(other: PathTestSet.new(item1: items(["A", "D"])), before: "1", after: "2")
  assert_eq PathTestE.~from_xml(PATH_TEST_STRING), PathTestE.new(underline: "E", before: "1", after: "2")
}

#[derive(Xml)]
struct TestThree {
  #[field(xml: "Test3")] xml_name: xml.Name
  #[field(xml: "Attr,attr")] attr: Str
}

test "UnmarshalWithoutNameType" {
  x = TestThree.~from_xml("\n<?xml version=\"1.0\" charset=\"utf-8\"?>\n<Test3 Attr=\"OK\" />")
  assert_eq x.attr, "OK"
}

#[derive(Xml)]
struct ParamVal {
  #[field(xml: "int,attr")] int: Int
}

#[derive(Xml)]
struct ParamPtr {
  #[field(xml: "int,attr")] int: Int?
}

#[derive(Xml)]
struct ParamStringPtr {
  #[field(xml: "int,attr")] int: Str?
}

test "UnmarshalAttr" {
  x = "<Param int=\"1\" />"
  assert_eq ParamPtr.~from_xml(x).int, 1
  assert_eq ParamVal.~from_xml(x).int, 1
  assert_eq ParamStringPtr.~from_xml(x).int, "1"
}

#[derive(Xml)]
struct Tables {
  #[field(xml: "http://www.w3.org/TR/html4/ table")] h_table: Str
  #[field(xml: "http://www.w3schools.com/furniture table")] f_table: Str
}

def tab(h: Str, f: Str) -> Tables { Tables.new(h_table: h, f_table: f) }

test "UnmarshalNS" {
  cases = [
    ("<Tables><table xmlns=\"http://www.w3.org/TR/html4/\">hello</table><table xmlns=\"http://www.w3schools.com/furniture\">world</table></Tables>", tab("hello", "world"), ""),
    ("<Tables><table xmlns=\"http://www.w3schools.com/furniture\">world</table><table xmlns=\"http://www.w3.org/TR/html4/\">hello</table></Tables>", tab("hello", "world"), ""),
    ("<Tables xmlns:f=\"http://www.w3schools.com/furniture\" xmlns:h=\"http://www.w3.org/TR/html4/\"><f:table>world</f:table><h:table>hello</h:table></Tables>", tab("hello", "world"), ""),
    ("<Tables><table>bogus</table></Tables>", tab("", ""), ""),
    ("<Tables><table>only</table></Tables>", tab("only", ""), "http://www.w3.org/TR/html4/"),
    ("<Tables><table>only</table></Tables>", tab("", "only"), "http://www.w3schools.com/furniture"),
    ("<Tables><table>only</table></Tables>", tab("", ""), "something else entirely"),
  ]
  for c in cases {
    d = xml.new_string_decoder(c[0])
    d.default_space = c[2]
    assert_eq d.~decode!(Tables.new), c[1]
  }
}

test "MarshalNS" {
  assert_eq mx(tab("hello", "world")), "<Tables><table xmlns=\"http://www.w3.org/TR/html4/\">hello</table><table xmlns=\"http://www.w3schools.com/furniture\">world</table></Tables>"
}

#[derive(Xml)]
struct TableAttrs {
  #[field(xml: "TAttr")] t_attr: TAttr
}

#[derive(Xml)]
struct TAttr {
  #[field(xml: "http://www.w3.org/TR/html4/ table,attr")] h_table: Str
  #[field(xml: "http://www.w3schools.com/furniture table,attr")] f_table: Str
  #[field(xml: "http://www.w3.org/XML/1998/namespace lang,attr,omitempty")] lang: Str
  #[field(xml: "http://golang.org/xml/ other,attr,omitempty")] other1: Str
  #[field(xml: "http://golang.org/xmlfoo/ other,attr,omitempty")] other2: Str
  #[field(xml: "http://golang.org/json/ other,attr,omitempty")] other3: Str
  #[field(xml: "http://golang.org/2/json/ other,attr,omitempty")] other4: Str
}

def tattr(h: Str, f: Str) -> TableAttrs { TableAttrs.new(t_attr: TAttr.new(h_table: h, f_table: f)) }

test "UnmarshalNSAttr" {
  cases = [
    ("<TableAttrs xmlns:f=\"http://www.w3schools.com/furniture\" xmlns:h=\"http://www.w3.org/TR/html4/\"><TAttr h:table=\"hello\" f:table=\"world\" /></TableAttrs>", tattr("hello", "world"), ""),
    ("<TableAttrs><TAttr xmlns:f=\"http://www.w3schools.com/furniture\" xmlns:h=\"http://www.w3.org/TR/html4/\" h:table=\"hello\" f:table=\"world\" /></TableAttrs>", tattr("hello", "world"), ""),
    ("<TableAttrs><TAttr h:table=\"hello\" f:table=\"world\" xmlns:f=\"http://www.w3schools.com/furniture\" xmlns:h=\"http://www.w3.org/TR/html4/\" /></TableAttrs>", tattr("hello", "world"), ""),
    ("<TableAttrs xmlns=\"http://www.w3schools.com/furniture\" xmlns:h=\"http://www.w3.org/TR/html4/\"><TAttr h:table=\"hello\" table=\"world\" /></TableAttrs>", tattr("hello", ""), ""),
    ("<TableAttrs xmlns:f=\"http://www.w3schools.com/furniture\"><TAttr xmlns=\"http://www.w3.org/TR/html4/\" table=\"hello\" f:table=\"world\" /></TableAttrs>", tattr("", "world"), ""),
    ("<TableAttrs><TAttr table=\"bogus\" /></TableAttrs>", tattr("", ""), ""),
    ("<TableAttrs xmlns:h=\"http://www.w3.org/TR/html4/\"><TAttr h:table=\"hello\" table=\"world\" /></TableAttrs>", tattr("hello", ""), "http://www.w3schools.com/furniture"),
    ("<TableAttrs xmlns:f=\"http://www.w3schools.com/furniture\"><TAttr table=\"hello\" f:table=\"world\" /></TableAttrs>", tattr("", "world"), "http://www.w3.org/TR/html4/"),
    ("<TableAttrs><TAttr table=\"bogus\" /></TableAttrs>", tattr("", ""), "something else entirely"),
  ]
  for c in cases {
    d = xml.new_string_decoder(c[0])
    d.default_space = c[2]
    assert_eq d.~decode!(TableAttrs.new), c[1]
  }
}

test "MarshalNSAttr" {
  src = TableAttrs.new(t_attr: TAttr.new(h_table: "hello", f_table: "world", lang: "en_US", other1: "other1", other2: "other2", other3: "other3", other4: "other4"))
  data = mx(src)
  assert_eq data, "<TableAttrs><TAttr xmlns:html4=\"http://www.w3.org/TR/html4/\" html4:table=\"hello\" xmlns:furniture=\"http://www.w3schools.com/furniture\" furniture:table=\"world\" xml:lang=\"en_US\" xmlns:_xml=\"http://golang.org/xml/\" _xml:other=\"other1\" xmlns:_xmlfoo=\"http://golang.org/xmlfoo/\" _xmlfoo:other=\"other2\" xmlns:json=\"http://golang.org/json/\" json:other=\"other3\" xmlns:json_1=\"http://golang.org/2/json/\" json_1:other=\"other4\"></TAttr></TableAttrs>"
  assert_eq TableAttrs.~from_xml(data), src
}

# Hand-written Unmarshaler / UnmarshalerAttr (no derive: the protocol comes
# from the interfaces' default methods).
struct MyCharData {
  body: Str

  pub def unmarshal_xml!(d: xml.Decoder, start: xml.StartElement) -> ~Unit {
    loop {
      t = d.~token!
      break if t.none?
      case t || xml.char_data("") {
        CharData(b) => self.body = body + Str.from_bytes(b)
        _ => nil
      }
    }
    nil
  }

  pub def unmarshal_xml_attr!(a: xml.Attr) -> ~Unit {
    panic "must not call"
  }
}

struct MyAttr {
  attr: Str

  pub def unmarshal_xml_attr!(a: xml.Attr) -> ~Unit {
    self.attr = a.value
    nil
  }
}

#[derive(Xml)]
struct MyStruct {
  #[field(xml: "Data")] data: MyCharData?
  #[field(xml: "Attr,attr")] attr: MyAttr?
  #[field(xml: "Data2")] data2: MyCharData
  #[field(xml: "Attr2,attr")] attr2: MyAttr
}

test "Unmarshaler" {
  input = "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n\t\t<MyStruct Attr=\"attr1\" Attr2=\"attr2\">\n\t\t<Data>hello <!-- comment -->world</Data>\n\t\t<Data2>howdy <!-- comment -->world</Data2>\n\t\t</MyStruct>\n\t"
  m = MyStruct.~from_xml(input)
  assert_eq m.data?.body || "<nil>", "hello world"
  assert_eq m.attr?.attr || "<nil>", "attr1"
  assert_eq m.data2.body, "howdy world"
  assert_eq m.attr2.attr, "attr2"
}

#[derive(Xml)]
struct X {
  #[field(xml: ",comment")] d: Str
}

test "MalformedComment" {
  for s in ["<X><!-- a---></X>", "<X><!-- -- --></X>", "<X><!-- a--b --></X>", "<X><!------></X>"] {
    assert ue(X.new, s) != "", "#{s}: unmarshal should reject invalid comments"
  }
}

#[derive(Xml)]
struct IXField {
  #[field(xml: "five")] five: Int
  #[field(xml: ",innerxml")] not_inner_xml: [Str]
}

test "InvalidInnerXMLType" {
  v = IXField.~from_xml("<tag><five>5</five><innertag/></tag>")
  assert_eq v.five, 5
  assert_eq v.not_inner_xml.size, 0
}

#[derive(Xml)]
struct ChildG {
  #[field(xml: "I")] i: Int
}

#[derive(Xml)]
struct Child {
  #[field(xml: "G")] g: ChildG
}

#[derive(Xml)]
struct ChildToEmbed {
  #[field(xml: "X")] x: Bool
}

#[derive(Xml)]
struct Parent {
  #[field(xml: "I")] i: Int
  #[field(xml: "IPtr")] i_ptr: Int?
  #[field(xml: "Is")] is: [Int]
  #[field(xml: "IPtrs")] i_ptrs: [Int?]
  #[field(xml: "F")] f: Float
  #[field(xml: "FPtr")] f_ptr: Float?
  #[field(xml: "Fs")] fs: [Float]
  #[field(xml: "FPtrs")] f_ptrs: [Float?]
  #[field(xml: "B")] b: Bool
  #[field(xml: "BPtr")] b_ptr: Bool?
  #[field(xml: "Bs")] bs: [Bool]
  #[field(xml: "BPtrs")] b_ptrs: [Bool?]
  #[field(xml: "Bytes")] bytes: [Byte]
  #[field(xml: "BytesPtr")] bytes_ptr: [Byte]?
  #[field(xml: "S")] s: Str
  #[field(xml: "SPtr")] s_ptr: Str?
  #[field(xml: "Ss")] ss: [Str]
  #[field(xml: "SPtrs")] s_ptrs: [Str?]
  #[field(xml: "MyI")] my_i: Int
  #[field(xml: "Child")] child: Child
  #[field(xml: "Children")] children: [Child]
  #[field(xml: "ChildPtr")] child_ptr: Child?
  #[field(xml: ",embed")] child_to_embed: ChildToEmbed
}

EMPTY_XML = "\n<Parent>\n    <I></I>\n    <IPtr></IPtr>\n    <Is></Is>\n    <IPtrs></IPtrs>\n    <F></F>\n    <FPtr></FPtr>\n    <Fs></Fs>\n    <FPtrs></FPtrs>\n    <B></B>\n    <BPtr></BPtr>\n    <Bs></Bs>\n    <BPtrs></BPtrs>\n    <Bytes></Bytes>\n    <BytesPtr></BytesPtr>\n    <S></S>\n    <SPtr></SPtr>\n    <Ss></Ss>\n    <SPtrs></SPtrs>\n    <MyI></MyI>\n    <Child></Child>\n    <Children></Children>\n    <ChildPtr></ChildPtr>\n    <X></X>\n</Parent>\n"

test "UnmarshalEmptyValues" {
  v = Parent.~from_xml(EMPTY_XML)
  want = Parent.new(i_ptr: 0, is: [0], i_ptrs: [0], f_ptr: 0.0, fs: [0.0], f_ptrs: [0.0], b_ptr: false, bs: [false], b_ptrs: [false], bytes_ptr: [], s_ptr: "", ss: [""], s_ptrs: [""], children: [Child.new], child_ptr: Child.new)
  assert_eq v, want
  # A pre-populated destination.
  pre = Parent.new(i: 1, i_ptr: 1, is: [1], i_ptrs: [1], f: 1.0, f_ptr: 1.0, fs: [1.0], f_ptrs: [1.0], b: true, b_ptr: true, bs: [true], b_ptrs: [true], bytes: "x".bytes, bytes_ptr: "x".bytes, s: "x", s_ptr: "x", ss: ["x"], s_ptrs: ["x"], my_i: 1, child: Child.new(g: ChildG.new(i: 1)), children: [Child.new(g: ChildG.new(i: 1))], child_ptr: Child.new(g: ChildG.new(i: 1)), child_to_embed: ChildToEmbed.new(x: true))
  got = xml.~unmarshal(EMPTY_XML.bytes, pre)
  want2 = Parent.new(i_ptr: 0, is: [1, 0], i_ptrs: [1, 0], f_ptr: 0.0, fs: [1.0, 0.0], f_ptrs: [1.0, 0.0], b_ptr: false, bs: [true, false], b_ptrs: [true, false], bytes_ptr: [], s_ptr: "", ss: ["x", ""], s_ptrs: ["x", ""], child: Child.new(g: ChildG.new(i: 1)), children: [Child.new(g: ChildG.new(i: 1)), Child.new], child_ptr: Child.new(g: ChildG.new(i: 1)))
  assert_eq got, want2
}

