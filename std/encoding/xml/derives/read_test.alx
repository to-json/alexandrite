# Go's manualNode (plus a depth count): an Unmarshaler that decodes each
# child element with decode_element!, so the elements nest one level per
# call.
struct ManualNode {
  child: ManualNode?
  depth: Int

  pub def unmarshal_xml!(d: xml.Decoder, start: xml.StartElement) -> ~Unit {
    loop {
      t = d.~token!
      case t || xml.char_data("") {
        StartElement(s) => {
          c = d.~decode_element!(ManualNode.new, s)
          self.child = c
          self.depth = c.depth + 1
        }
        EndElement(_) => { return nil }
        _ => nil
      }
      return nil if t.none?
    }
    nil
  }
}

# A derived node whose children go through an Unmarshaler.
#[derive(Xml)]
struct Wrapper {
  #[field(xml: "a")] a: ManualNode?
}

test "RecursiveUnmarshalInterfaceDepth" {
  depth = 200
  payload = "<a>" * depth + "</a>" * depth
  n = xml.~unmarshal(payload.bytes, ManualNode.new)
  assert_eq n.depth, depth - 1
}

struct RawTokenNode {
  pub def unmarshal_xml!(d: xml.Decoder, start: xml.StartElement) -> ~Unit {
    d.~raw_token!
    nil
  }
}

test "UnmarshalXMLRawToken" {
  r = xml.unmarshal("<a></a>".bytes, RawTokenNode.new)
  assert_eq r.err?.message || "", "xml: cannot use raw_token! from unmarshal_xml! method"
}

test "unmarshal depth limit" {
  # Go's maxUnmarshalDepth through an Unmarshaler that recurses with
  # decode_element! (Go's TestRecursiveUnmarshalInterfaceDepth).
  depth = xml.MAX_UNMARSHAL_DEPTH + 1
  payload = "<a>" * depth + "</a>" * depth
  r = xml.unmarshal(payload.bytes, ManualNode.new)
  assert_eq r.err?.message || "", "exceeded max depth"
}

# xml_test.go: TestDecodeEOF and TestDecodeNilToken over token sources.
struct ToksState {
  t: [xml.Token]
  nil_first: Bool
}

struct Toks {
  st: [ToksState]
  pub def token! -> ~xml.Token? {
    return none if st[0].t.size == 0
    x = st[0].t[0]
    self.st[0].t = st[0].t[1...st[0].t.size]
    x
  }
}

#[derive(Xml)]
struct TestElem {
  #[field(xml: "test")] xml_name: xml.Name
}

def syntax?(e: Error?) -> Bool {
  if x = e {
    case x {
      xml.XmlError.Syntax(_, _) => { return true }
      _ => { return false }
    }
  }
  false
}

test "DecodeEOF" {
  start = xml.StartElement.new(name: xml.name("", "test"))
  ok = Toks.new(st: [ToksState.new(t: [xml.Token.StartElement(start), xml.Token.EndElement(start.end)])])
  d0 = xml.new_token_decoder(ok)
  assert d0.decode!(TestElem.new).ok?, "d.Decode: expected nil error"
  bad = Toks.new(st: [ToksState.new(t: [xml.Token.StartElement(start), xml.start_token(xml.name("", "bad"), []), xml.Token.EndElement(start.end)])])
  for strict in [true, false] {
    d = xml.new_token_decoder(bad.dup)
    d.strict = strict
    assert syntax?(d.decode!(TestElem.new).err), "d.Decode: expected syntax error"
  }
}

# xml_test.go: TestTokenUnmarshaler (an endless start-element source must
# not make Decode panic).
struct TokReader {
  pub def token! -> ~xml.Token? { xml.Token.StartElement(xml.StartElement.new) }
}

struct FailureT {
  pub def unmarshal_xml!(d: xml.Decoder, start: xml.StartElement) -> ~Unit { nil }
}

test "TokenUnmarshaler" {
  d = xml.new_token_decoder(TokReader.new)
  _ = d.decode!(FailureT.new)
}

# xml_test.go: TestWrapDecoder (a token source mapping another Decoder's
# tokens; the Decoder holds a closure over a value holding a Decoder).
struct TokenMap {
  d: xml.Decoder
  f: (xml.Token) -> xml.Token
  pub def token! -> ~xml.Token? {
    t = d.~token!
    return none if t == none
    f(t.unwrap)
  }
}

#[derive(Xml)]
struct Blocking {
  #[field(xml: "blocking")] xml_name: xml.Name
  #[field(xml: ",chardata")] chardata: Str
}

def blocking(n: xml.Name) -> xml.Name {
  return n if n.local != "quote"
  xml.name(n.space, "blocking")
}

test "WrapDecoder" {
  d = xml.new_string_decoder("<quote>[Re-enter Clown with a letter, and FABIAN]</quote>")
  m = TokenMap.new(d: d, f: ->(t: xml.Token) -> xml.Token {
    case t {
      StartElement(s) => xml.Token.StartElement(xml.StartElement.new(name: blocking(s.name), attr: s.attr))
      EndElement(e) => xml.Token.EndElement(xml.EndElement.new(name: blocking(e.name)))
      _ => t
    }
  })
  d2 = xml.new_token_decoder(m)
  o = d2.~decode!(Blocking.new)
  assert_eq o.chardata, "[Re-enter Clown with a letter, and FABIAN]"
}

