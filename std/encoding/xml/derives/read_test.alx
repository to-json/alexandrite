# The examples (example_test.go, example_marshaling_test.go,
# example_text_marshaling_test.go).

#[derive(Xml)]
struct Address {
  #[field(xml: "City")] city: Str
  #[field(xml: "State")] state: Str
}

#[derive(Xml)]
struct ExPerson {
  #[field(xml: "person")] xml_name: xml.Name
  #[field(xml: "id,attr")] id: Int
  #[field(xml: "name>first")] first_name: Str
  #[field(xml: "name>last")] last_name: Str
  #[field(xml: "age")] age: Int
  #[field(xml: "height,omitempty")] height: Float
  #[field(xml: "Married")] married: Bool
  #[field(xml: ",embed")] address: Address
  #[field(xml: ",comment")] comment: Str
}

def ex_person -> ExPerson {
  ExPerson.new(id: 13, first_name: "John", last_name: "Doe", age: 42, comment: " Need more details. ", address: Address.new(city: "Hanga Roa", state: "Easter Island"))
}

example "MarshalIndent" {
  out = xml.marshal_indent(ex_person(), "  ", "    ").unwrap
  puts Str.from_bytes(out)
} outputs "  <person id=\"13\">\n      <name>\n          <first>John</first>\n          <last>Doe</last>\n      </name>\n      <age>42</age>\n      <Married>false</Married>\n      <City>Hanga Roa</City>\n      <State>Easter Island</State>\n      <!-- Need more details. -->\n  </person>\n"

struct Stdout {
  pub def write!(p: [Byte]) -> ~Int {
    print Str.from_bytes(p)
    p.size
  }
}

example "Encoder" {
  e = xml.new_encoder(Stdout.new)
  e.indent!("  ", "    ")
  e.encode!(ex_person()).unwrap
  puts ""
} outputs "  <person id=\"13\">\n      <name>\n          <first>John</first>\n          <last>Doe</last>\n      </name>\n      <age>42</age>\n      <Married>false</Married>\n      <City>Hanga Roa</City>\n      <State>Easter Island</State>\n      <!-- Need more details. -->\n  </person>\n"

#[derive(Xml)]
struct Email {
  #[field(xml: "where,attr")] where: Str
  #[field(xml: "Addr")] addr: Str
}

#[derive(Xml)]
struct ExResult {
  #[field(xml: "Person")] xml_name: xml.Name
  #[field(xml: "FullName")] name: Str
  #[field(xml: "Phone")] phone: Str
  #[field(xml: "Email")] email: [Email]
  #[field(xml: "Group>Value")] groups: [Str]
  #[field(xml: ",embed")] address: Address
}

example "Unmarshal" {
  v = ExResult.new(name: "none", phone: "none")
  data = "\n\t\t<Person>\n\t\t\t<FullName>Grace R. Emlin</FullName>\n\t\t\t<Company>Example Inc.</Company>\n\t\t\t<Email where=\"home\">\n\t\t\t\t<Addr>gre@example.com</Addr>\n\t\t\t</Email>\n\t\t\t<Email where='work'>\n\t\t\t\t<Addr>gre@work.com</Addr>\n\t\t\t</Email>\n\t\t\t<Group>\n\t\t\t\t<Value>Friends</Value>\n\t\t\t\t<Value>Squash</Value>\n\t\t\t</Group>\n\t\t\t<City>Hanga Roa</City>\n\t\t\t<State>Easter Island</State>\n\t\t</Person>\n\t"
  v = xml.unmarshal(data.bytes, v).unwrap
  puts "XMLName: xml.Name{Space:#{strconv.quote(v.xml_name.space)}, Local:#{strconv.quote(v.xml_name.local)}}"
  puts "Name: #{strconv.quote(v.name)}"
  puts "Phone: #{strconv.quote(v.phone)}"
  es: [Str] = []
  for e in v.email {
    es << "{#{e.where} #{e.addr}}"
  }
  puts "Email: [#{es.join(" ")}]"
  puts "Groups: [#{v.groups.join(" ")}]"
  puts "Address: {#{v.address.city} #{v.address.state}}"
} outputs "XMLName: xml.Name{Space:\"\", Local:\"Person\"}\nName: \"Grace R. Emlin\"\nPhone: \"none\"\nEmail: [{home gre@example.com} {work gre@work.com}]\nGroups: [Friends Squash]\nAddress: {Hanga Roa Easter Island}\n"

# Animal: a hand-written Marshaler / Unmarshaler (no derive).
ANIMAL_UNKNOWN = 0
GOPHER = 1
ZEBRA = 2

struct Animal {
  kind: Int

  pub def unmarshal_xml!(d: xml.Decoder, start: xml.StartElement) -> ~Unit {
    s = d.~decode_text!(start)
    self.kind = case strings.to_lower(s) {
      "gopher" => GOPHER
      "zebra" => ZEBRA
      _ => ANIMAL_UNKNOWN
    }
    nil
  }

  pub def marshal_xml(e: xml.Encoder, start: xml.StartElement) -> ~Unit {
    s = case kind {
      GOPHER => "gopher"
      ZEBRA => "zebra"
      _ => "unknown"
    }
    e.~encode_text!(s, start)
  }
}

#[derive(Xml)]
struct Zoo {
  #[field(xml: "animal")] animals: [Animal]
}

example "customMarshalXML" {
  blob = "\n\t<animals>\n\t\t<animal>gopher</animal>\n\t\t<animal>armadillo</animal>\n\t\t<animal>zebra</animal>\n\t\t<animal>unknown</animal>\n\t\t<animal>gopher</animal>\n\t\t<animal>bee</animal>\n\t\t<animal>gopher</animal>\n\t\t<animal>zebra</animal>\n\t</animals>"
  zoo = Zoo.from_xml(blob).unwrap
  census = [0, 0, 0]
  for a in zoo.animals {
    census[a.kind] += 1
  }
  puts "Zoo Census:\n* Gophers: #{census[GOPHER]}\n* Zebras:  #{census[ZEBRA]}\n* Unknown: #{census[ANIMAL_UNKNOWN]}"
  puts Zoo.new(animals: [Animal.new(kind: ZEBRA), Animal.new(kind: 7)]).to_xml.unwrap
} outputs "Zoo Census:\n* Gophers: 3\n* Zebras:  2\n* Unknown: 3\n<Zoo><animal>zebra</animal><animal>unknown</animal></Zoo>\n"

# Size: a hand-written TextMarshaler / TextUnmarshaler (no derive).
UNRECOGNIZED = 0
SMALL = 1
LARGE = 2

struct Size {
  v: Int

  pub def unmarshal_text!(text: [Byte]) -> ~Unit {
    self.v = case strings.to_lower(Str.from_bytes(text)) {
      "small" => SMALL
      "large" => LARGE
      _ => UNRECOGNIZED
    }
    nil
  }

  pub def marshal_text -> ~[Byte] {
    name = case v {
      SMALL => "small"
      LARGE => "large"
      _ => "unrecognized"
    }
    name.bytes
  }
}

#[derive(Xml)]
struct Inventory {
  #[field(xml: "size")] sizes: [Size]
  #[field(xml: "best,attr")] best: Size
}

example "textMarshalXML" {
  blob = "\n\t<sizes>\n\t\t<size>small</size>\n\t\t<size>regular</size>\n\t\t<size>large</size>\n\t\t<size>unrecognized</size>\n\t\t<size>small</size>\n\t\t<size>normal</size>\n\t\t<size>small</size>\n\t\t<size>large</size>\n\t</sizes>"
  inv = Inventory.from_xml(blob).unwrap
  counts = [0, 0, 0]
  for s in inv.sizes {
    counts[s.v] += 1
  }
  puts "Inventory Counts:\n* Small:        #{counts[SMALL]}\n* Large:        #{counts[LARGE]}\n* Unrecognized: #{counts[UNRECOGNIZED]}"
  puts Inventory.new(sizes: [Size.new(v: LARGE)], best: Size.new(v: SMALL)).to_xml.unwrap
  puts Inventory.from_xml("<i best='LARGE'/>").unwrap.best.v
} outputs "Inventory Counts:\n* Small:        3\n* Large:        2\n* Unrecognized: 3\n<Inventory best=\"small\"><size>large</size></Inventory>\n2\n"
