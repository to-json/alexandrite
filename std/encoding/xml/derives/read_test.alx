# A writer that fails after `remain` bytes (Go's limitedBytesWriter).
struct LimState {
  buf: [Byte]
  remain: Int
}

struct LimitedBytesWriter {
  st: [LimState]

  pub def write!(p: [Byte]) -> ~Int {
    fail "write limit hit" if st[0].remain <= 0
    if p.size > st[0].remain {
      n = st[0].remain
      self.st[0].buf = st[0].buf + p[0...n]
      self.st[0].remain = 0
      fail "write limit hit"
    }
    self.st[0].buf = st[0].buf + p
    self.st[0].remain -= p.size
    p.size
  }
}

test "MarshalWriteErrors" {
  w = LimitedBytesWriter.new(st: [LimState.new(buf: [], remain: 1024)])
  e = xml.new_encoder(w)
  i = 1
  failed = false
  while i <= 4000 {
    r = e.encode!(Passenger.new(name: ["Alice", "Bob"], weight: 5.0))
    if !r.ok? {
      failed = true
      break
    }
    i += 1
  }
  assert failed, "expected an error"
  assert i < 4000, "expected to fail before the end"
  assert_eq w.st[0].buf.size, 1024
}

struct ErrWriter {
  pub def write!(p: [Byte]) -> ~Int { fail "unwritable" }
}

test "MarshalWriteIOErrors" {
  e = xml.new_encoder(ErrWriter.new)
  r = e.encode!(Passenger.new)
  assert_eq r.err?.message || "", "unwritable"
}

