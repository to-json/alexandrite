  assert_eq mx(VMain.new(xml_name: xml.name("", "other"), a: "x]]>y", b: -2147483648, c: 39, f: 0.1, g: true, s: "", pi: -1, inn: VInner.new(id: -181, note: "hello world"), cm: "", bs: "<tag>".bytes, i16: -1, u32: 2000000, emb: VEmbed.new(e1: "", e2: -41), ns: "a&b")), "<main xmlns=\"urn:v\" a=\"x]]&gt;y\" b=\"-2147483648\" c=\"39\" pi=\"-1\" e2=\"-41\"><f>0.1</f><g>true</g><x><y><s></s></y></x><inner id=\"-181\">hello world</inner><list></list><bs>&lt;tag&gt;</bs><i16>-1</i16><u32>2000000</u32><e1></e1><ns xmlns=\"urn:other\">a&amp;b</ns></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"x]]&gt;y\" b=\"-2147483648\" c=\"39\" pi=\"-1\" e2=\"-41\"><f>0.1</f><g>true</g><x><y><s></s></y></x><inner id=\"-181\">hello world</inner><list></list><bs>&lt;tag&gt;</bs><i16>-1</i16><u32>2000000</u32><e1></e1><ns xmlns=\"urn:other\">a&amp;b</ns></main>"), "<main xmlns=\"urn:v\" a=\"x]]&gt;y\" b=\"-2147483648\" c=\"39\" pi=\"-1\" e2=\"-41\"><f>0.1</f><g>true</g><x><y><s></s></y></x><inner id=\"-181\">hello world</inner><list></list><bs>&lt;tag&gt;</bs><i16>-1</i16><u32>2000000</u32><e1></e1><ns xmlns=\"urn:other\">a&amp;b</ns></main>"
  assert_eq mx(VMain.new(xml_name: xml.name("", ""), a: "dash-", b: (-9223372036854775807 - 1), c: 153, f: 1.0e-06, g: false, s: " nbsp", t: ["]]>", "line\nbreak"], p: "--", pi: 7, inn: VInner.new(id: -2147483648, note: Str.from_bytes([255, 98, 97, 100])), cm: "hello world", bs: "quote \"q\" 'a'".bytes, i16: -715, u32: 0, emb: VEmbed.new(e1: "a", e2: -21), ns: "\uFFFE")), "<main xmlns=\"urn:v\" a=\"dash-\" b=\"-9223372036854775808\" c=\"153\" pi=\"7\" e2=\"-21\"><f>1e-06</f><x><y><s> nbsp</s></y><t>]]&gt;</t><t>line&\#xA;break</t></x><p>--</p><inner id=\"-2147483648\">�bad</inner><list></list><!--hello world--><bs>quote &\#34;q&\#34; &\#39;a&\#39;</bs><i16>-715</i16><e1>a</e1><ns xmlns=\"urn:other\">�</ns></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"dash-\" b=\"-9223372036854775808\" c=\"153\" pi=\"7\" e2=\"-21\"><f>1e-06</f><x><y><s> nbsp</s></y><t>]]&gt;</t><t>line&\#xA;break</t></x><p>--</p><inner id=\"-2147483648\">�bad</inner><list></list><!--hello world--><bs>quote &\#34;q&\#34; &\#39;a&\#39;</bs><i16>-715</i16><e1>a</e1><ns xmlns=\"urn:other\">�</ns></main>"), "<main xmlns=\"urn:v\" a=\"dash-\" b=\"-9223372036854775808\" c=\"153\" pi=\"7\" e2=\"-21\"><f>1e-06</f><x><y><s> nbsp</s></y><t>]]&gt;</t><t>line&\#xA;break</t></x><p>--</p><inner id=\"-2147483648\">�bad</inner><list></list><!--hello world--><bs>quote &\#34;q&\#34; &\#39;a&\#39;</bs><i16>-715</i16><e1>a</e1><ns xmlns=\"urn:other\">�</ns></main>"
  assert_eq mx(VMain.new(xml_name: xml.name("", ""), a: "aZ", b: (-9223372036854775807 - 1), c: 113, f: -2.5e-300, g: false, s: "x]]>y", t: ["hello world", "cr\r\nlf"], p: "é ü 白", pi: -355, inn: VInner.new(id: -1, note: " leading"), ins: [VInner.new(id: -1, note: "&amp;"), VInner.new(id: 7, note: " nbsp")], cm: "", bs: "trailing ".bytes, i16: 42, u32: 0, emb: VEmbed.new(e1: "]]>", e2: 7), ns: "&'Z", any: [VAny.new(xml_name: xml.name("urn:any", "any1"), inner: "<n:q xmlns:n='urn:n'>z</n:q>")])), "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\" pi=\"-355\" e2=\"7\"><f>-2.5e-300</f><x><y><s>x]]&gt;y</s></y><t>hello world</t><t>cr&\#xD;&\#xA;lf</t></x><p>é ü 白</p><inner id=\"-1\"> leading</inner><list><inner id=\"-1\">&amp;amp;</inner><inner id=\"7\"> nbsp</inner></list><bs>trailing </bs><i16>42</i16><e1>]]&gt;</e1><ns xmlns=\"urn:other\">&amp;&\#39;Z</ns><any1 xmlns=\"urn:any\"><n:q xmlns:n='urn:n'>z</n:q></any1></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\" pi=\"-355\" e2=\"7\"><f>-2.5e-300</f><x><y><s>x]]&gt;y</s></y><t>hello world</t><t>cr&\#xD;&\#xA;lf</t></x><p>é ü 白</p><inner id=\"-1\"> leading</inner><list><inner id=\"-1\">&amp;amp;</inner><inner id=\"7\"> nbsp</inner></list><bs>trailing </bs><i16>42</i16><e1>]]&gt;</e1><ns xmlns=\"urn:other\">&amp;&\#39;Z</ns><any1 xmlns=\"urn:any\"><n:q xmlns:n='urn:n'>z</n:q></any1></main>"), "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\" pi=\"-355\" e2=\"7\"><f>-2.5e-300</f><x><y><s>x]]&gt;y</s></y><t>hello world</t><t>cr&\#xD;&\#xA;lf</t></x><p>é ü 白</p><inner id=\"-1\"> leading</inner><list><inner id=\"-1\">&amp;amp;</inner><inner id=\"7\"> nbsp</inner></list><bs>trailing </bs><i16>42</i16><e1>]]&gt;</e1><ns xmlns=\"urn:other\">&amp;&\#39;Z</ns><any1 xmlns=\"urn:any\"><n:q xmlns:n='urn:n'>z</n:q></any1></main>"
  assert_eq mx(VText.new(lang: "de", kind: "", body: "\x01ctl")), "<t xml:lang=\"de\">�ctl</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">�ctl</t>"), "<t xml:lang=\"de\">�ctl</t>"
  assert_eq mx(VCData.new(body: "a&b", n: -2147483648)), "<cd><![CDATA[a&b]]><n>-2147483648</n></cd>"
}

test "marshal vectors 5" {
  assert_eq um(VCData.new, "<cd><![CDATA[a&b]]><n>-2147483648</n></cd>"), "<cd><![CDATA[a&b]]><n>-2147483648</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "")), "<t></t>"
  assert_eq um(VText.new, "<t></t>"), "<t></t>"
  assert_eq mx(VCData.new(body: "\uFFFE", n: (-9223372036854775807 - 1), opt: VText.new(lang: "", kind: "a&b", body: "hello world"))), "<cd><![CDATA[\uFFFE]]><n>-9223372036854775808</n><opt><t xmlns:_=\"urn:k\" _:kind=\"a&amp;b\">hello world</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[\uFFFE]]><n>-9223372036854775808</n><opt><t xmlns:_=\"urn:k\" _:kind=\"a&amp;b\">hello world</t></opt></cd>"), "ERR XML syntax error on line 1: illegal character code U+FFFE"
  assert_eq mx(VText.new(lang: "", kind: "", body: "line\nbreak")), "<t>line&\#xA;break</t>"
  assert_eq um(VText.new, "<t>line&\#xA;break</t>"), "<t>line&\#xA;break</t>"
  assert_eq mx(VCData.new(body: "\uFFFE", n: 2147483648)), "<cd><![CDATA[\uFFFE]]><n>2147483648</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[\uFFFE]]><n>2147483648</n></cd>"), "ERR XML syntax error on line 1: illegal character code U+FFFE"
  assert_eq mx(VText.new(lang: "de", kind: "tab\there", body: " 0<c>")), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\"> 0&lt;c&gt;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\"> 0&lt;c&gt;</t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\"> 0&lt;c&gt;</t>"
  assert_eq mx(VCData.new(body: "a", n: -3114)), "<cd><![CDATA[a]]><n>-3114</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[a]]><n>-3114</n></cd>"), "<cd><![CDATA[a]]><n>-3114</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: ".a<c1", body: "-&'a ")), "<t xmlns:_=\"urn:k\" _:kind=\".a&lt;c1\">-&amp;&\#39;a </t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\".a&lt;c1\">-&amp;&\#39;a </t>"), "<t xmlns:_=\"urn:k\" _:kind=\".a&lt;c1\">-&amp;&\#39;a </t>"
  assert_eq mx(VCData.new(body: ".", n: -1)), "<cd><![CDATA[.]]><n>-1</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[.]]><n>-1</n></cd>"), "<cd><![CDATA[.]]><n>-1</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "\uFFFE")), "<t>�</t>"
  assert_eq um(VText.new, "<t>�</t>"), "<t>�</t>"
  assert_eq mx(VCData.new(body: "c. ", n: 1)), "<cd><![CDATA[c. ]]><n>1</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[c. ]]><n>1</n></cd>"), "<cd><![CDATA[c. ]]><n>1</n></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "a", body: "YX'")), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"a\">YX&\#39;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"a\">YX&\#39;</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"a\">YX&\#39;</t>"
  assert_eq mx(VCData.new(body: "--", n: -433, opt: VText.new(lang: "", kind: "", body: "😀"))), "<cd><![CDATA[--]]><n>-433</n><opt><t>😀</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[--]]><n>-433</n><opt><t>😀</t></opt></cd>"), "<cd><![CDATA[--]]><n>-433</n><opt><t>😀</t></opt></cd>"
  assert_eq mx(VText.new(lang: "de", kind: "", body: "tab\there")), "<t xml:lang=\"de\">tab&\#x9;here</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">tab&\#x9;here</t>"), "<t xml:lang=\"de\">tab&\#x9;here</t>"
  assert_eq mx(VCData.new(body: "\x01ctl", n: -2147483648)), "<cd><![CDATA[\x01ctl]]><n>-2147483648</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[\x01ctl]]><n>-2147483648</n></cd>"), "ERR XML syntax error on line 1: illegal character code U+0001"
  assert_eq mx(VText.new(lang: "", kind: "", body: "x]]>y")), "<t>x]]&gt;y</t>"
  assert_eq um(VText.new, "<t>x]]&gt;y</t>"), "<t>x]]&gt;y</t>"
  assert_eq mx(VCData.new(body: "\uFFFE", n: -152)), "<cd><![CDATA[\uFFFE]]><n>-152</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[\uFFFE]]><n>-152</n></cd>"), "ERR XML syntax error on line 1: illegal character code U+FFFE"
  assert_eq mx(VText.new(lang: "", kind: "", body: "\x01ctl")), "<t>�ctl</t>"
  assert_eq um(VText.new, "<t>�ctl</t>"), "<t>�ctl</t>"
  assert_eq mx(VCData.new(body: "", n: 0)), "<cd><n>0</n></cd>"
  assert_eq um(VCData.new, "<cd><n>0</n></cd>"), "<cd><n>0</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "quote \"q\" 'a'")), "<t>quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t>quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t>quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq mx(VCData.new(body: "1.", n: -394)), "<cd><![CDATA[1.]]><n>-394</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[1.]]><n>-394</n></cd>"), "<cd><![CDATA[1.]]><n>-394</n></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "", body: "0")), "<t xml:lang=\"a&amp;b\">0</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\">0</t>"), "<t xml:lang=\"a&amp;b\">0</t>"
  assert_eq mx(VCData.new(body: "99", n: -3114)), "<cd><![CDATA[99]]><n>-3114</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[99]]><n>-3114</n></cd>"), "<cd><![CDATA[99]]><n>-3114</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "&amp;")), "<t>&amp;amp;</t>"
  assert_eq um(VText.new, "<t>&amp;amp;</t>"), "<t>&amp;amp;</t>"
  assert_eq mx(VCData.new(body: "line\nbreak", n: 7)), "<cd><![CDATA[line\nbreak]]><n>7</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[line\nbreak]]><n>7</n></cd>"), "<cd><![CDATA[line\nbreak]]><n>7</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "a--b")), "<t>a--b</t>"
  assert_eq um(VText.new, "<t>a--b</t>"), "<t>a--b</t>"
  assert_eq mx(VCData.new(body: "Yb0", n: 1, opt: VText.new(lang: "en", kind: "", body: ""))), "<cd><![CDATA[Yb0]]><n>1</n><opt><t xml:lang=\"en\"></t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[Yb0]]><n>1</n><opt><t xml:lang=\"en\"></t></opt></cd>"), "<cd><![CDATA[Yb0]]><n>1</n><opt><t xml:lang=\"en\"></t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: " Y", body: "a&b")), "<t xmlns:_=\"urn:k\" _:kind=\" Y\">a&amp;b</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\" Y\">a&amp;b</t>"), "<t xmlns:_=\"urn:k\" _:kind=\" Y\">a&amp;b</t>"
  assert_eq mx(VCData.new(body: "x]]>y", n: 136)), "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>136</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>136</n></cd>"), "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>136</n></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "", body: "x]]>y")), "<t xml:lang=\"a&amp;b\">x]]&gt;y</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\">x]]&gt;y</t>"), "<t xml:lang=\"a&amp;b\">x]]&gt;y</t>"
  assert_eq mx(VCData.new(body: Str.from_bytes([255, 98, 97, 100]), n: -3114)), Str.from_bytes([60, 99, 100, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 45, 51, 49, 49, 52, 60, 47, 110, 62, 60, 47, 99, 100, 62])
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 45, 51, 49, 49, 52, 60, 47, 110, 62, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 1: invalid UTF-8"
  assert_eq mx(VText.new(lang: "", kind: "dash-", body: "tab\there")), "<t xmlns:_=\"urn:k\" _:kind=\"dash-\">tab&\#x9;here</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"dash-\">tab&\#x9;here</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"dash-\">tab&\#x9;here</t>"
  assert_eq mx(VCData.new(body: "\uFFFE", n: 0)), "<cd><![CDATA[\uFFFE]]><n>0</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[\uFFFE]]><n>0</n></cd>"), "ERR XML syntax error on line 1: illegal character code U+FFFE"
  assert_eq mx(VText.new(lang: "", kind: "hello world", body: ">")), "<t xmlns:_=\"urn:k\" _:kind=\"hello world\">&gt;</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"hello world\">&gt;</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"hello world\">&gt;</t>"
  assert_eq mx(VCData.new(body: "Z11.", n: (-9223372036854775807 - 1), opt: VText.new(lang: "", kind: "", body: "_"))), "<cd><![CDATA[Z11.]]><n>-9223372036854775808</n><opt><t>_</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[Z11.]]><n>-9223372036854775808</n><opt><t>_</t></opt></cd>"), "<cd><![CDATA[Z11.]]><n>-9223372036854775808</n><opt><t>_</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "'\"", body: "a")), "<t xmlns:_=\"urn:k\" _:kind=\"&\#39;&\#34;\">a</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"&\#39;&\#34;\">a</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"&\#39;&\#34;\">a</t>"
  assert_eq mx(VCData.new(body: "", n: 528)), "<cd><n>528</n></cd>"
  assert_eq um(VCData.new, "<cd><n>528</n></cd>"), "<cd><n>528</n></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "", body: "Ya.Z\"")), "<t xml:lang=\"a&amp;b\">Ya.Z&\#34;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\">Ya.Z&\#34;</t>"), "<t xml:lang=\"a&amp;b\">Ya.Z&\#34;</t>"
  assert_eq mx(VCData.new(body: "x]]>y", n: 7, opt: VText.new(lang: "de", kind: "", body: "1"))), "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>7</n><opt><t xml:lang=\"de\">1</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>7</n><opt><t xml:lang=\"de\">1</t></opt></cd>"), "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>7</n><opt><t xml:lang=\"de\">1</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "b\"9 Z")), "<t>b&\#34;9 Z</t>"
  assert_eq um(VText.new, "<t>b&\#34;9 Z</t>"), "<t>b&\#34;9 Z</t>"
  assert_eq mx(VCData.new(body: "a", n: 505, opt: VText.new(lang: "", kind: "", body: "<tag>"))), "<cd><![CDATA[a]]><n>505</n><opt><t>&lt;tag&gt;</t></opt></cd>"
}

test "marshal vectors 6" {
  assert_eq um(VCData.new, "<cd><![CDATA[a]]><n>505</n><opt><t>&lt;tag&gt;</t></opt></cd>"), "<cd><![CDATA[a]]><n>505</n><opt><t>&lt;tag&gt;</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "tab\there", body: "hello world")), "<t xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\">hello world</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\">hello world</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\">hello world</t>"
  assert_eq mx(VCData.new(body: "c&-", n: 2147483648, opt: VText.new(lang: "a&b", kind: "", body: ".>\"<"))), "<cd><![CDATA[c&-]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\">.&gt;&\#34;&lt;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[c&-]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\">.&gt;&\#34;&lt;</t></opt></cd>"), "<cd><![CDATA[c&-]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\">.&gt;&\#34;&lt;</t></opt></cd>"
  assert_eq mx(VText.new(lang: "de", kind: "", body: "&amp;")), "<t xml:lang=\"de\">&amp;amp;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">&amp;amp;</t>"), "<t xml:lang=\"de\">&amp;amp;</t>"
  assert_eq mx(VCData.new(body: "a&b", n: 2147483648, opt: VText.new(lang: "", kind: "\x01ctl", body: "\x01ctl"))), "<cd><![CDATA[a&b]]><n>2147483648</n><opt><t xmlns:_=\"urn:k\" _:kind=\"�ctl\">�ctl</t></opt></cd>"
