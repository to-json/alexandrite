  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"x]]&gt;y\" b=\"-2147483648\" c=\"39\" pi=\"-1\" e2=\"-41\"><!-- c --><?pi x?><f>0.1</f><g>true</g><x><y><s></s></y></x><inner id=\"-181\">hello world</inner><list></list><bs>&lt;tag&gt;</bs><i16>-1</i16><u32>2000000</u32><e1></e1><ns xmlns=\"urn:other\">a&amp;b</ns></main>"), "<main xmlns=\"urn:v\" a=\"x]]&gt;y\" b=\"-2147483648\" c=\"39\" pi=\"-1\" e2=\"-41\"><f>0.1</f><g>true</g><x><y><s></s></y></x><inner id=\"-181\">hello world</inner><list></list><!-- c --><bs>&lt;tag&gt;</bs><i16>-1</i16><u32>2000000</u32><e1></e1><ns xmlns=\"urn:other\">a&amp;b</ns></main>"
}

test "marshal vectors 12" {
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"x]]&gt;y\" b=\"-2147483648\" c=\"39\" pi=\"-1\" e2=\"-41\"><f>0.1</f><g>true</g><x><y><s></s></y></x><inner id=\"-181\">hello world</inner><list></list><bs>&lt;tag&gt;</bs><i16>-1</i16><u32>2000000</u32><e1></e1><ns xmlns=\"ur"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"x]]&gt;y\" b=\"-2147483648\" c=\"39\" pi=\"-1\" e2=\"-41\"><f>0.1</f><g>true</g><x><y><s></s></y></x><inner id=\"-181\">hello world</inner><list></list><bs>&lt;tag&gt;</bs><i16>-1</i16><u32>2000000</u32><e1></e1><ns xmlns=\"urn:other\">a&amp;b=/ns></main>"), "ERR XML syntax error on line 1: element <ns> closed by </main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\" pi=\"-355\" e2=\"7\">\n  <f>-2.5e-300</f>\n  <x>\n  <y>\n  <s>x]]&gt;y</s>\n  </y>\n  <t>hello world</t>\n  <t>cr&\#xD;&\#xA;lf</t>\n  </x>\n  <p>é ü 白</p>\n  <inner id=\"-1\"> leading</inner>\n  <list>\n  <inner id=\"-1\">&amp;amp;</inner>\n  <inner id=\"7\"> nbsp</inner>\n  </list>\n  <bs>trailing </bs>\n  <i16>42</i16>\n  <e1>]]&gt;</e1>\n  <ns xmlns=\"urn:other\">&amp;&\#39;Z</ns>\n  <any1 xmlns=\"urn:any\">\n  <n:q xmlns:n='urn:n'>z</n:q>\n  </any1>\n  </main>"), "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\" pi=\"-355\" e2=\"7\"><f>-2.5e-300</f><x><y><s>x]]&gt;y</s></y><t>hello world</t><t>cr&\#xD;&\#xA;lf</t></x><p>é ü 白</p><inner id=\"-1\"> leading</inner><list><inner id=\"-1\">&amp;amp;</inner><inner id=\"7\"> nbsp</inner></list><bs>trailing </bs><i16>42</i16><e1>]]&gt;</e1><ns xmlns=\"urn:other\">&amp;&\#39;Z</ns><any1 xmlns=\"urn:any\">\n  <n:q xmlns:n='urn:n'>z</n:q>\n  </any1></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\" pi=\"-355\" e2=\"7\" zz=\"1\"><unknown><deep>x</deep></unknown><f>-2.5e-300</f><x><y><s>x]]&gt;y</s></y><t>hello world</t><t>cr&\#xD;&\#xA;lf</t></x><p>é ü 白</p><inner id=\"-1\"> leading</inner><list><inner id=\"-1\">&amp;amp;</inner><inner id=\"7\"> nbsp</inner></list><bs>trailing </bs><i16>42</i16><e1>]]&gt;</e1><ns xmlns=\"urn:other\">&amp;&\#39;Z</ns><any1 xmlns=\"urn:any\"><n:q xmlns:n='urn:n'>z</n:q></any1></main>"), "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\" pi=\"-355\" e2=\"7\"><f>-2.5e-300</f><x><y><s>x]]&gt;y</s></y><t>hello world</t><t>cr&\#xD;&\#xA;lf</t></x><p>é ü 白</p><inner id=\"-1\"> leading</inner><list><inner id=\"-1\">&amp;amp;</inner><inner id=\"7\"> nbsp</inner></list><bs>trailing </bs><i16>42</i16><e1>]]&gt;</e1><ns xmlns=\"urn:other\">&amp;&\#39;Z</ns><unknown xmlns=\"urn:v\"><deep>x</deep></unknown><any1 xmlns=\"urn:any\"><n:q xmlns:n='urn:n'>z</n:q></any1></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\" pi=\"-355\" e2=\"7\"><!-- c --><?pi x?><f>-2.5e-300</f><x><y><s>x]]&gt;y</s></y><t>hello world</t><t>cr&\#xD;&\#xA;lf</t></x><p>é ü 白</p><inner id=\"-1\"> leading</inner><list><inner id=\"-1\">&amp;amp;</inner><inner id=\"7\"> nbsp</inner></list><bs>trailing </bs><i16>42</i16><e1>]]&gt;</e1><ns xmlns=\"urn:other\">&amp;&\#39;Z</ns><any1 xmlns=\"urn:any\"><n:q xmlns:n='urn:n'>z</n:q></any1></main>"), "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\" pi=\"-355\" e2=\"7\"><f>-2.5e-300</f><x><y><s>x]]&gt;y</s></y><t>hello world</t><t>cr&\#xD;&\#xA;lf</t></x><p>é ü 白</p><inner id=\"-1\"> leading</inner><list><inner id=\"-1\">&amp;amp;</inner><inner id=\"7\"> nbsp</inner></list><!-- c --><bs>trailing </bs><i16>42</i16><e1>]]&gt;</e1><ns xmlns=\"urn:other\">&amp;&\#39;Z</ns><any1 xmlns=\"urn:any\"><n:q xmlns:n='urn:n'>z</n:q></any1></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\" pi=\"-355\" e2=\"7\"><f>-2.5e-300</f><x><y><s>x]]&gt;y</s></y><t>hello world</t><t>cr&\#xD;&\#xA;lf</t></x><p>é ü 白</p><inner id=\"-1\"> leading</inner><list><inner id=\"-1\">&amp;amp;</inner><inner i"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"aZ\" b=\"-9223372036854775808\" c=\"113\"<pi=\"-355\" e2=\"7\"><f>-2.5e-300</f><x><y><s>x]]&gt;y</s></y><t>hello world</t><t>cr&\#xD;&\#xA;lf</t></x><p>é ü 白</p><inner id=\"-1\"> leading</inner><list><inner id=\"-1\">&amp;amp;</inner><inner id=\"7\"> nbsp</inner></list><bs>trailing </bs><i16>42</i16><e1>]]&gt;</e1><ns xmlns=\"urn:other\">&amp;&\#39;Z</ns><any1 xmlns=\"urn:any\"><n:q xmlns:n='urn:n'>z</n:q></any1></main>"), "ERR XML syntax error on line 1: expected attribute name in element"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[a&b]]>\n  <n>-2147483648</n>\n  </cd>"), "<cd><![CDATA[\n  a&b\n  \n  ]]><n>-2147483648</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[a&b]]><n>-2147483648</n></cd>"), "<cd><![CDATA[a&b]]><n>-2147483648</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[a&b]]><n>-2147483648</n></cd>"), "<cd><![CDATA[a&b]]><n>-2147483648</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[a&b]]><"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd<<![CDATA[a&b]]><n>-2147483648</n></cd>"), "ERR XML syntax error on line 1: expected attribute name in element"
  assert_eq um(VText.new, "<t>\n  </t>"), "<t>&\#xA;  </t>"
  assert_eq um(VText.new, "<t zz=\"1\"><unknown><deep>x</deep></unknown></t>"), "<t></t>"
  assert_eq um(VText.new, "<t><!-- c --><?pi x?></t>"), "<t></t>"
  assert_eq um(VText.new, "<"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t>>/t>"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t>line&\#xA;break</t>"), "<t>line&\#xA;break</t>"
  assert_eq um(VText.new, "<t zz=\"1\"><unknown><deep>x</deep></unknown>line&\#xA;break</t>"), "<t>line&\#xA;break</t>"
  assert_eq um(VText.new, "<t><!-- c --><?pi x?>line&\#xA;break</t>"), "<t>line&\#xA;break</t>"
  assert_eq um(VText.new, "<t>line&\#xA;break</t"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t>l'ne&\#xA;break</t>"), "<t>l&\#39;ne&\#xA;break</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\"> 0&lt;c&gt;</t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\"> 0&lt;c&gt;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\" zz=\"1\"><unknown><deep>x</deep></unknown> 0&lt;c&gt;</t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\"> 0&lt;c&gt;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\"><!-- c --><?pi x?> 0&lt;c&gt;</t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\"> 0&lt;c&gt;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\""), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"tab&\#x9;here\"> 0&lt;c&gt;<xt>"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[a]]>\n  <n>-3114</n>\n  </cd>"), "<cd><![CDATA[\n  a\n  \n  ]]><n>-3114</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[a]]><n>-3114</n></cd>"), "<cd><![CDATA[a]]><n>-3114</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[a]]><n>-3114</n></cd>"), "<cd><![CDATA[a]]><n>-3114</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[a]]>"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[a]]><n>-311'</n></cd>"), "ERR strconv.parse_int: parsing \"-311'\": invalid syntax"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[.]]>\n  <n>-1</n>\n  </cd>"), "<cd><![CDATA[\n  .\n  \n  ]]><n>-1</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[.]]><n>-1</n></cd>"), "<cd><![CDATA[.]]><n>-1</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[.]]><n>-1</n></cd>"), "<cd><![CDATA[.]]><n>-1</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[.]]><n>-"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[.]]><n>-1</n></cd>"), "<cd><![CDATA[.]]><n>-1</n></cd>"
  assert_eq um(VText.new, "<t>�</t>"), "<t>�</t>"
  assert_eq um(VText.new, "<t zz=\"1\"><unknown><deep>x</deep></unknown>�</t>"), "<t>�</t>"
  assert_eq um(VText.new, "<t><!-- c --><?pi x?>�</t>"), "<t>�</t>"
  assert_eq um(VText.new, "<t>�</t"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t>�</=>"), "ERR XML syntax error on line 1: expected element name after </"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[c. ]]>\n  <n>1</n>\n  </cd>"), "<cd><![CDATA[\n  c. \n  \n  ]]><n>1</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[c. ]]><n>1</n></cd>"), "<cd><![CDATA[c. ]]><n>1</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[c. ]]><n>1</n></cd>"), "<cd><![CDATA[c. ]]><n>1</n></cd>"
  assert_eq um(VCData.new, "<cd>"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[c. ]]><n>1</n>=/cd>"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[\x01ctl]]>\n  <n>-2147483648</n>\n  </cd>"), "ERR XML syntax error on line 2: illegal character code U+0001"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[\x01ctl]]><n>-2147483648</n></cd>"), "ERR XML syntax error on line 1: illegal character code U+0001"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[\x01ctl]]><n>-2147483648</n></cd>"), "ERR XML syntax error on line 1: illegal character code U+0001"
  assert_eq um(VCData.new, "<cd><![CDATA[\x01ct"), "ERR XML syntax error on line 1: unexpected EOF in CDATA section"
  assert_eq um(VCData.new, "<cd><![CDATA[\x01ctl]]><n>-2147483648</n></c\">"), "ERR XML syntax error on line 1: illegal character code U+0001"
  assert_eq um(VText.new, "<t>x]]&gt;y</t>"), "<t>x]]&gt;y</t>"
  assert_eq um(VText.new, "<t zz=\"1\"><unknown><deep>x</deep></unknown>x]]&gt;y</t>"), "<t>x]]&gt;y</t>"
  assert_eq um(VText.new, "<t><!-- c --><?pi x?>x]]&gt;y</t>"), "<t>x]]&gt;y</t>"
  assert_eq um(VText.new, "<t>x]]&gt;y</t"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t'x]]&gt;y</t>"), "ERR XML syntax error on line 1: expected attribute name in element"
  assert_eq um(VText.new, "<t>�ctl</t>"), "<t>�ctl</t>"
  assert_eq um(VText.new, "<t zz=\"1\"><unknown><deep>x</deep></unknown>�ctl</t>"), "<t>�ctl</t>"
  assert_eq um(VText.new, "<t><!-- c --><?pi x?>�ctl</t>"), "<t>�ctl</t>"
  assert_eq um(VText.new, "<t>�ctl"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "-t>�ctl</t>"), "ERR XML syntax error on line 1: unexpected end element </t>"
  assert_eq um(VCData.new, "<cd>\n  <n>0</n>\n  </cd>"), "<cd><![CDATA[\n  \n  ]]><n>0</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><n>0</n></cd>"), "<cd><n>0</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><n>0</n></cd>"), "<cd><n>0</n></cd>"
  assert_eq um(VCData.new, "<cd><n>0<"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><n>0</n>< cd>"), "ERR XML syntax error on line 1: expected element name after <"
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 62, 10, 32, 32, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 10, 32, 32, 60, 110, 62, 45, 51, 49, 49, 52, 60, 47, 110, 62, 10, 32, 32, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 2: invalid UTF-8"
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 32, 122, 122, 61, 34, 49, 34, 62, 60, 117, 110, 107, 110, 111, 119, 110, 62, 60, 100, 101, 101, 112, 62, 120, 60, 47, 100, 101, 101, 112, 62, 60, 47, 117, 110, 107, 110, 111, 119, 110, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 45, 51, 49, 49, 52, 60, 47, 110, 62, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 1: invalid UTF-8"
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 62, 60, 33, 45, 45, 32, 99, 32, 45, 45, 62, 60, 63, 112, 105, 32, 120, 63, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 45, 51, 49, 49, 52, 60, 47, 110, 62, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 1: invalid UTF-8"
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110])), "ERR XML syntax error on line 1: invalid UTF-8"
  assert_eq um(VCData.new, Str.from_bytes([60, 62, 100, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 45, 51, 49, 49, 52, 60, 47, 110, 62, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 1: expected element name after <"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"dash-\">tab&\#x9;here</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"dash-\">tab&\#x9;here</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"dash-\" zz=\"1\"><unknown><deep>x</deep></unknown>tab&\#x9;here</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"dash-\">tab&\#x9;here</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"dash-\"><!-- c --><?pi x?>tab&\#x9;here</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"dash-\">tab&\#x9;here</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:k"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"dash-\">ta&&\#x9;here</t>"), "ERR XML syntax error on line 1: invalid character entity & (no semicolon)"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[\uFFFE]]>\n  <n>0</n>\n  </cd>"), "ERR XML syntax error on line 2: illegal character code U+FFFE"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[\uFFFE]]><n>0</n></cd>"), "ERR XML syntax error on line 1: illegal character code U+FFFE"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[\uFFFE]]><n>0</n></cd>"), "ERR XML syntax error on line 1: illegal character code U+FFFE"
}

test "marshal vectors 13" {
  assert_eq um(VCData.new, "<cd><![CDAT"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><! CDATA[\uFFFE]]><n>0</n></cd>"), "<cd><n>0</n></cd>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[x]]]]>\n  <![CDATA[>y]]>\n  <n>7</n>\n  <opt>\n  <t xml:lang=\"de\">1</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  x]]\n  >y\n  \n  \n  ]]><n>7</n><opt><t xml:lang=\"de\">1</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[x]]]]><![CDATA[>y]]><n>7</n><opt><t xml:lang=\"de\">1</t></opt></cd>"), "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>7</n><opt><t xml:lang=\"de\">1</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[x]]]]><![CDATA[>y]]><n>7</n><opt><t xml:lang=\"de\">1</t></opt></cd>"), "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>7</n><opt><t xml:lang=\"de\">1</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>7</n><o"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>7</n><opt> t xml:lang=\"de\">1</t></opt></cd>"), "ERR XML syntax error on line 1: element <opt> closed by </t>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[c&-]]>\n  <n>2147483648</n>\n  <opt>\n  <t xml:lang=\"a&amp;b\">.&gt;&\#34;&lt;</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  c&-\n  \n  \n  ]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\">.&gt;&\#34;&lt;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[c&-]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\">.&gt;&\#34;&lt;</t></opt></cd>"), "<cd><![CDATA[c&-]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\">.&gt;&\#34;&lt;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[c&-]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\">.&gt;&\#34;&lt;</t></opt></cd>"), "<cd><![CDATA[c&-]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\">.&gt;&\#34;&lt;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[c&-]]><n>2'47483648</n><opt><t xml:lang=\"a&amp;b\">.&gt;&\#34;&lt;</t></opt></cd>"), "ERR strconv.parse_int: parsing \"2'47483648\": invalid syntax"
  assert_eq um(VText.new, "<t xml:lang=\"de\">&amp;amp;</t>"), "<t xml:lang=\"de\">&amp;amp;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" zz=\"1\"><unknown><deep>x</deep></unknown>&amp;amp;</t>"), "<t xml:lang=\"de\">&amp;amp;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\"><!-- c --><?pi x?>&amp;amp;</t>"), "<t xml:lang=\"de\">&amp;amp;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">&a"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lang=\"de\">&amp;a\"p;</t>"), "<t xml:lang=\"de\">&amp;a&\#34;p;</t>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[tab\there]]>\n  <n>255</n>\n  </cd>"), "<cd><![CDATA[\n  tab\there\n  \n  ]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[tab\there]]><n>255</n></cd>"), "<cd><![CDATA[tab\there]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[tab\there]]><n>255</n></cd>"), "<cd><![CDATA[tab\there]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[ta"), "ERR XML syntax error on line 1: unexpected EOF in CDATA section"
  assert_eq um(VCData.new, "<cd><![CDATA[tab\there]]><n>255</n></cd/"), "ERR XML syntax error on line 1: invalid characters between </cd and >"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[a]]>\n  <n>255</n>\n  </cd>"), "<cd><![CDATA[\n  a\n  \n  ]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[a]]><n>255</n></cd>"), "<cd><![CDATA[a]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[a]]><n>255</n></cd>"), "<cd><![CDATA[a]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[a]]><n"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[a]]><n>255</n><'cd>"), "ERR XML syntax error on line 1: expected element name after <"
  assert_eq um(VCData.new, "<cd>\n  <n>-2147483648</n>\n  <opt>\n  <t xmlns:_=\"urn:k\" _:kind=\"�\">�bad</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  \n  \n  ]]><n>-2147483648</n><opt><t xmlns:_=\"urn:k\" _:kind=\"�\">�bad</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><n>-2147483648</n><opt><t xmlns:_=\"urn:k\" _:kind=\"�\">�bad</t></opt></cd>"), "<cd><n>-2147483648</n><opt><t xmlns:_=\"urn:k\" _:kind=\"�\">�bad</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><n>-2147483648</n><opt><t xmlns:_=\"urn:k\" _:kind=\"�\">�bad</t></opt></cd>"), "<cd><n>-2147483648</n><opt><t xmlns:_=\"urn:k\" _:kind=\"�\">�bad</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><n>-2147483648</n><opt><t xmlns:_=\"urn:k\" _:kind=\"�\">�bad</t></opt><"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><n>-2147483648</n><opt><t xmlns:_=\"urn:k\" >:kind=\"�\">�bad</t></opt></cd>"), "<cd><n>-2147483648</n><opt><t>:kind=&\#34;�&\#34;&gt;�bad</t></opt></cd>"
  assert_eq um(VText.new, "<t>&amp;amp;</t>"), "<t>&amp;amp;</t>"
  assert_eq um(VText.new, "<t zz=\"1\"><unknown><deep>x</deep></unknown>&amp;amp;</t>"), "<t>&amp;amp;</t>"
  assert_eq um(VText.new, "<t><!-- c --><?pi x?>&amp;amp;</t>"), "<t>&amp;amp;</t>"
  assert_eq um(VText.new, "<"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t>&amp;amp;<&t>"), "ERR XML syntax error on line 1: expected element name after <"
  assert_eq um(VCData.new, "<cd>\n  <n>9223372036854775807</n>\n  <opt>\n  <t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"hello world\">Z_</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  \n  \n  ]]><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"hello world\">Z_</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"hello world\">Z_</t></opt></cd>"), "<cd><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"hello world\">Z_</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"hello world\">Z_</t></opt></cd>"), "<cd><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"hello world\">Z_</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;=\" xmlns:_=\"urn:k\" _:kind=\"hello world\">Z_</t></opt></cd>"), "<cd><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;=\" xmlns:_=\"urn:k\" _:kind=\"hello world\">Z_</t></opt></cd>"
  assert_eq um(VText.new, "<t xml:lang=\"en\">hello world</t>"), "<t xml:lang=\"en\">hello world</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" zz=\"1\"><unknown><deep>x</deep></unknown>hello world</t>"), "<t xml:lang=\"en\">hello world</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\"><!-- c --><?pi x?>hello world</t>"), "<t xml:lang=\"en\">hello world</t>"
  assert_eq um(VText.new, "<t "), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lang=\"en\">hello wo ld</t>"), "<t xml:lang=\"en\">hello wo ld</t>"
  assert_eq um(VCData.new, "<cd>\n  <n>-771</n>\n  </cd>"), "<cd><![CDATA[\n  \n  ]]><n>-771</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><n>-771</n></cd>"), "<cd><n>-771</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><n>-771</n></cd>"), "<cd><n>-771</n></cd>"
  assert_eq um(VCData.new, "<cd><n>-771</n></"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><n>-771</n><<cd>"), "ERR XML syntax error on line 1: expected element name after <"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" leading\">\n  </t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" leading\">&\#xA;  </t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" leading\" zz=\"1\"><unknown><deep>x</deep></unknown></t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" leading\"></t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" leading\"><!-- c --><?pi x?></t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" leading\"></t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" lea>ing\"></t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" lea&gt;ing\"></t>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[ nbsp]]>\n  <n>-1</n>\n  <opt>\n  <t xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">line&\#xA;break</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n   nbsp\n  \n  \n  ]]><n>-1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">line&\#xA;break</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[ nbsp]]><n>-1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">line&\#xA;break</t></opt></cd>"), "<cd><![CDATA[ nbsp]]><n>-1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">line&\#xA;break</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[ nbsp]]><n>-1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">line&\#xA;break</t></opt></cd>"), "<cd><![CDATA[ nbsp]]><n>-1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">line&\#xA;break</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[ nbsp]"), "ERR XML syntax error on line 1: unexpected EOF in CDATA section"
  assert_eq um(VCData.new, "<cd><![CDATA[ nbsp]]><n>-1</n><opt><t xmlns:_=\"urn:/\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">line&\#xA;break</t></opt></cd>"), "<cd><![CDATA[ nbsp]]><n>-1</n><opt><t>line&\#xA;break</t></opt></cd>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[<0-]]>\n  <n>-9223372036854775808</n>\n  <opt>\n  <t>é ü 白</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  <0-\n  \n  \n  ]]><n>-9223372036854775808</n><opt><t>é ü 白</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[<0-]]><n>-9223372036854775808</n><opt><t>é ü 白</t></opt></cd>"), "<cd><![CDATA[<0-]]><n>-9223372036854775808</n><opt><t>é ü 白</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[<0-]]><n>-9223372036854775808</n><opt><t>é ü 白</t></opt></cd>"), "<cd><![CDATA[<0-]]><n>-9223372036854775808</n><opt><t>é ü 白</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[<0-]]><n>-9223372036854775808</n><opt><t"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[<0-]]><n>-9223372036859775808</n><opt><t>é ü 白</t></opt></cd>"), "ERR strconv.parse_int: parsing \"-9223372036859775808\": value out of range"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\">a</t>"), "<t xml:lang=\"a&amp;b\">a</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" zz=\"1\"><unknown><deep>x</deep></unknown>a</t>"), "<t xml:lang=\"a&amp;b\">a</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\"><!-- c --><?pi x?>a</t>"), "<t xml:lang=\"a&amp;b\">a</t>"
  assert_eq um(VText.new, "<t "), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml\"lang=\"a&amp;b\">a</t>"), "ERR XML syntax error on line 1: attribute name without = in element"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\">\n  </t>"), "<t xml:lang=\"a&amp;b\">&\#xA;  </t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" zz=\"1\"><unknown><deep>x</deep></unknown></t>"), "<t xml:lang=\"a&amp;b\"></t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\"><!-- c --><?pi x?></t>"), "<t xml:lang=\"a&amp;b\"></t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&am"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<= xml:lang=\"a&amp;b\"></t>"), "ERR XML syntax error on line 1: expected element name after <"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[tab\there]]>\n  <n>-3114</n>\n  <opt>\n  <t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"&amp;amp;\">\#{x}</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  tab\there\n  \n  \n  ]]><n>-3114</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"&amp;amp;\">\#{x}</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[tab\there]]><n>-3114</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"&amp;amp;\">\#{x}</t></opt></cd>"), "<cd><![CDATA[tab\there]]><n>-3114</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"&amp;amp;\">\#{x}</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[tab\there]]><n>-3114</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"&amp;amp;\">\#{x}</t></opt></cd>"), "<cd><![CDATA[tab\there]]><n>-3114</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"&amp;amp;\">\#{x}</t></opt></cd>"
}

test "marshal vectors 14" {
  assert_eq um(VCData.new, "<cd><![CD"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[tab\there]]><n>-3114</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"ur-:k\" _:kind=\"&amp;amp;\">\#{x}</t></opt></cd>"), "<cd><![CDATA[tab\there]]><n>-3114</n><opt><t xml:lang=\"a&amp;b\">\#{x}</t></opt></cd>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[trailing ]]>\n  <n>-604</n>\n  <opt>\n  <t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">�bad</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  trailing \n  \n  \n  ]]><n>-604</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">�bad</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[trailing ]]><n>-604</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">�bad</t></opt></cd>"), "<cd><![CDATA[trailing ]]><n>-604</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">�bad</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[trailing ]]><n>-604</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">�bad</t></opt></cd>"), "<cd><![CDATA[trailing ]]><n>-604</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">�bad</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[trailing ]]><n>-604</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trail"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[trailing ]&><n>-604</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">�bad</t></opt></cd>"), "ERR XML syntax error on line 1: unexpected EOF in CDATA section"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[ leading]]>\n  <n>1</n>\n  </cd>"), "<cd><![CDATA[\n   leading\n  \n  ]]><n>1</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[ leading]]><n>1</n></cd>"), "<cd><![CDATA[ leading]]><n>1</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[ leading]]><n>1</n></cd>"), "<cd><![CDATA[ leading]]><n>1</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[>leading]]><n>1</n></cd>"), "<cd><![CDATA[>leading]]><n>1</n></cd>"
  assert_eq um(VText.new, "<t xml:lang=\"en\">--</t>"), "<t xml:lang=\"en\">--</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" zz=\"1\"><unknown><deep>x</deep></unknown>--</t>"), "<t xml:lang=\"en\">--</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\"><!-- c --><?pi x?>--</t>"), "<t xml:lang=\"en\">--</t>"
  assert_eq um(VText.new, "<t "), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "-t xml:lang=\"en\">--</t>"), "ERR XML syntax error on line 1: unexpected end element </t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">line&\#xA;break</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">line&\#xA;break</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\" zz=\"1\"><unknown><deep>x</deep></unknown>line&\#xA;break</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">line&\#xA;break</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\"><!-- c --><?pi x?>line&\#xA;break</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">line&\#xA;break</t>"
  assert_eq um(VText.new, "<t"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\"'xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">line&\#xA;break</t>"), "ERR XML syntax error on line 1: expected attribute name in element"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"--\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"--\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"--\" zz=\"1\"><unknown><deep>x</deep></unknown>quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"--\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"--\"><!-- c --><?pi x?>quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"--\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xml:lan"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<' xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"--\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "ERR XML syntax error on line 1: expected element name after <"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"a\">x]]&gt;y</t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"a\">x]]&gt;y</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"a\" zz=\"1\"><unknown><deep>x</deep></unknown>x]]&gt;y</t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"a\">x]]&gt;y</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"a\"><!-- c --><?pi x?>x]]&gt;y</t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"a\">x]]&gt;y</t>"
  assert_eq um(VText.new, "<t"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"a<>x]]&gt;y</t>"), "ERR XML syntax error on line 1: unescaped < inside quoted string"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[a-&<c]]>\n  <n>-470</n>\n  </cd>"), "<cd><![CDATA[\n  a-&<c\n  \n  ]]><n>-470</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[a-&<c]]><n>-470</n></cd>"), "<cd><![CDATA[a-&<c]]><n>-470</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[a-&<c]]><n>-470</n></cd>"), "<cd><![CDATA[a-&<c]]><n>-470</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[a-&"), "ERR XML syntax error on line 1: unexpected EOF in CDATA section"
  assert_eq um(VCData.new, "<cd><![CDATA[a-&<c]]><n>-490</n></cd>"), "<cd><![CDATA[a-&<c]]><n>-490</n></cd>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\">�bad</t>"), "<t xml:lang=\"a&amp;b\">�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" zz=\"1\"><unknown><deep>x</deep></unknown>�bad</t>"), "<t xml:lang=\"a&amp;b\">�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\"><!-- c --><?pi x?>�bad</t>"), "<t xml:lang=\"a&amp;b\">�bad</t>"
  assert_eq um(VText.new, Str.from_bytes([60, 116, 32, 120, 109, 108, 58, 108, 97, 110, 103, 61, 34, 97, 38, 97, 109, 112, 59, 98, 34, 62, 239, 191])), "ERR XML syntax error on line 1: invalid UTF-8"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\"-�bad</t>"), "ERR XML syntax error on line 1: invalid XML name: -�bad"
  assert_eq um(VText.new, "<t xml:lang=\"en\">\#{x}</t>"), "<t xml:lang=\"en\">\#{x}</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" zz=\"1\"><unknown><deep>x</deep></unknown>\#{x}</t>"), "<t xml:lang=\"en\">\#{x}</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\"><!-- c --><?pi x?>\#{x}</t>"), "<t xml:lang=\"en\">\#{x}</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\">\#{x}</"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lang=\"en\">9{x}</t>"), "<t xml:lang=\"en\">9{x}</t>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[é ü 白]]>\n  <n>-92</n>\n  </cd>"), "<cd><![CDATA[\n  é ü 白\n  \n  ]]><n>-92</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[é ü 白]]><n>-92</n></cd>"), "<cd><![CDATA[é ü 白]]><n>-92</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[é ü 白]]><n>-92</n></cd>"), "<cd><![CDATA[é ü 白]]><n>-92</n></cd>"
  assert_eq um(VCData.new, "<cd><![C"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[é ü 白]]><n>-92 /n></cd>"), "ERR XML syntax error on line 1: element <n> closed by </cd>"
  assert_eq um(VCData.new, "<cd>\n  <n>978</n>\n  <opt>\n  <t xml:lang=\"a&amp;b\">�</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  \n  \n  ]]><n>978</n><opt><t xml:lang=\"a&amp;b\">�</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><n>978</n><opt><t xml:lang=\"a&amp;b\">�</t></opt></cd>"), "<cd><n>978</n><opt><t xml:lang=\"a&amp;b\">�</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><n>978</n><opt><t xml:lang=\"a&amp;b\">�</t></opt></cd>"), "<cd><n>978</n><opt><t xml:lang=\"a&amp;b\">�</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><n>978</n><opt><t xml:lang=\"a&amp;b\">�</t></"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><n>978</n><opt>'t xml:lang=\"a&amp;b\">�</t></opt></cd>"), "ERR XML syntax error on line 1: element <opt> closed by </t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"\#{x}\">tab&\#x9;here</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"\#{x}\">tab&\#x9;here</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"\#{x}\" zz=\"1\"><unknown><deep>x</deep></unknown>tab&\#x9;here</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"\#{x}\">tab&\#x9;here</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"\#{x}\"><!-- c --><?pi x?>tab&\#x9;here</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"\#{x}\">tab&\#x9;here</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"\#{x}\">tab&\#x"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml&s:_=\"urn:k\" _:kind=\"\#{x}\">tab&\#x9;here</t>"), "ERR XML syntax error on line 1: attribute name without = in element"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[trailing ]]>\n  <n>1</n>\n  <opt>\n  <t xmlns:_=\"urn:k\" _:kind=\"a\">9&lt;</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  trailing \n  \n  \n  ]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"a\">9&lt;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[trailing ]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"a\">9&lt;</t></opt></cd>"), "<cd><![CDATA[trailing ]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"a\">9&lt;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[trailing ]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"a\">9&lt;</t></opt></cd>"), "<cd><![CDATA[trailing ]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"a\">9&lt;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[trailing ]]><n>1</n><opt><t xml"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[trailing ]]><n>1</n><op ><t xmlns:_=\"urn:k\" _:kind=\"a\">9&lt;</t></opt></cd>"), "ERR XML syntax error on line 1: element <op> closed by </opt>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[tab\there]]>\n  <n>-59</n>\n  </cd>"), "<cd><![CDATA[\n  tab\there\n  \n  ]]><n>-59</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[tab\there]]><n>-59</n></cd>"), "<cd><![CDATA[tab\there]]><n>-59</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[tab\there]]><n>-59</n></cd>"), "<cd><![CDATA[tab\there]]><n>-59</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[tab\th"), "ERR XML syntax error on line 1: unexpected EOF in CDATA section"
  assert_eq um(VCData.new, "<cd><![CDATA[9ab\there]]><n>-59</n></cd>"), "<cd><![CDATA[9ab\there]]><n>-59</n></cd>"
  assert_eq um(VText.new, "<t>&lt;tag&gt;</t>"), "<t>&lt;tag&gt;</t>"
  assert_eq um(VText.new, "<t zz=\"1\"><unknown><deep>x</deep></unknown>&lt;tag&gt;</t>"), "<t>&lt;tag&gt;</t>"
  assert_eq um(VText.new, "<t><!-- c --><?pi x?>&lt;tag&gt;</t>"), "<t>&lt;tag&gt;</t>"
  assert_eq um(VText.new, "<t>&lt;ta"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t/&lt;tag&gt;</t>"), "ERR XML syntax error on line 1: expected /> in element"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[>]]>\n  <n>93</n>\n  <opt>\n  <t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  >\n  \n  \n  ]]><n>93</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[>]]><n>93</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </t></opt></cd>"), "<cd><![CDATA[>]]><n>93</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[>]]><n>93</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </t></opt></cd>"), "<cd><![CDATA[>]]><n>93</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </t></opt></cd>"
}

test "marshal vectors 15" {
  assert_eq um(VCData.new, "<cd><![CDATA[>]]><n>93</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[>]]><n>93</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </t></opt\"</cd>"), "ERR XML syntax error on line 1: invalid characters between </opt and >"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[b.]]>\n  <n>255</n>\n  </cd>"), "<cd><![CDATA[\n  b.\n  \n  ]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[b.]]><n>255</n></cd>"), "<cd><![CDATA[b.]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[b.]]><n>255</n></cd>"), "<cd><![CDATA[b.]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[b.]]><n>255</n></"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[b.]]><n<255</n></cd>"), "ERR XML syntax error on line 1: expected attribute name in element"
  assert_eq um(VText.new, "<t xml:lang=\"de\">�bad</t>"), "<t xml:lang=\"de\">�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" zz=\"1\"><unknown><deep>x</deep></unknown>�bad</t>"), "<t xml:lang=\"de\">�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\"><!-- c --><?pi x?>�bad</t>"), "<t xml:lang=\"de\">�bad</t>"
  assert_eq um(VText.new, "<t xml:l"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:>ang=\"de\">�bad</t>"), "ERR XML syntax error on line 1: attribute name without = in element"
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 62, 10, 32, 32, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 10, 32, 32, 60, 110, 62, 53, 51, 56, 60, 47, 110, 62, 10, 32, 32, 60, 111, 112, 116, 62, 10, 32, 32, 60, 116, 32, 120, 109, 108, 110, 115, 58, 95, 61, 34, 117, 114, 110, 58, 107, 34, 32, 95, 58, 107, 105, 110, 100, 61, 34, 98, 34, 62, 10, 32, 32, 60, 47, 116, 62, 10, 32, 32, 60, 47, 111, 112, 116, 62, 10, 32, 32, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 2: invalid UTF-8"
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 32, 122, 122, 61, 34, 49, 34, 62, 60, 117, 110, 107, 110, 111, 119, 110, 62, 60, 100, 101, 101, 112, 62, 120, 60, 47, 100, 101, 101, 112, 62, 60, 47, 117, 110, 107, 110, 111, 119, 110, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 53, 51, 56, 60, 47, 110, 62, 60, 111, 112, 116, 62, 60, 116, 32, 120, 109, 108, 110, 115, 58, 95, 61, 34, 117, 114, 110, 58, 107, 34, 32, 95, 58, 107, 105, 110, 100, 61, 34, 98, 34, 62, 60, 47, 116, 62, 60, 47, 111, 112, 116, 62, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 1: invalid UTF-8"
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 62, 60, 33, 45, 45, 32, 99, 32, 45, 45, 62, 60, 63, 112, 105, 32, 120, 63, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 53, 51, 56, 60, 47, 110, 62, 60, 111, 112, 116, 62, 60, 116, 32, 120, 109, 108, 110, 115, 58, 95, 61, 34, 117, 114, 110, 58, 107, 34, 32, 95, 58, 107, 105, 110, 100, 61, 34, 98, 34, 62, 60, 47, 116, 62, 60, 47, 111, 112, 116, 62, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 1: invalid UTF-8"
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93])), "ERR XML syntax error on line 1: unexpected EOF in CDATA section"
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 53, 51, 56, 61, 47, 110, 62, 60, 111, 112, 116, 62, 60, 116, 32, 120, 109, 108, 110, 115, 58, 95, 61, 34, 117, 114, 110, 58, 107, 34, 32, 95, 58, 107, 105, 110, 100, 61, 34, 98, 34, 62, 60, 47, 116, 62, 60, 47, 111, 112, 116, 62, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 1: invalid UTF-8"
  assert_eq um(VText.new, "<t>😀</t>"), "<t>😀</t>"
  assert_eq um(VText.new, "<t zz=\"1\"><unknown><deep>x</deep></unknown>😀</t>"), "<t>😀</t>"
  assert_eq um(VText.new, "<t><!-- c --><?pi x?>😀</t>"), "<t>😀</t>"
  assert_eq um(VText.new, "<t>😀</"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t>😀<=t>"), "ERR XML syntax error on line 1: expected element name after <"
  assert_eq um(VText.new, "<t xml:lang=\"en\">�bad</t>"), "<t xml:lang=\"en\">�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" zz=\"1\"><unknown><deep>x</deep></unknown>�bad</t>"), "<t xml:lang=\"en\">�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\"><!-- c --><?pi x?>�bad</t>"), "<t xml:lang=\"en\">�bad</t>"
  assert_eq um(VText.new, "<t xml"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:la9g=\"en\">�bad</t>"), "<t>�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xml:lang=\"de\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" zz=\"1\"><unknown><deep>x</deep></unknown>quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xml:lang=\"de\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\"><!-- c --><?pi x?>quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xml:lang=\"de\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">quote &\#34;q&\#34;"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lang=\"de\">quote &\#34;q&\#34; &\#3x;a&\#39;</t>"), "ERR XML syntax error on line 1: invalid character entity &\#3 (no semicolon)"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[&<\"]]>\n  <n>2147483648</n>\n  <opt>\n  <t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">\#{x}</t>\n  </opt>\n  </cd>"), "<cd><![CDATA[\n  &<\"\n  \n  \n  ]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">\#{x}</t></opt></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[&<\"]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">\#{x}</t></opt></cd>"), "<cd><![CDATA[&<\"]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">\#{x}</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[&<\"]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">\#{x}</t></opt></cd>"), "<cd><![CDATA[&<\"]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">\#{x}</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[&<\"]]><n>2147483648</n><opt><t xml:lang=\"a&-mp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">\#{x}</t></opt></cd>"), "ERR XML syntax error on line 1: invalid character entity &-mp;"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"--\"> leading</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"--\"> leading</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"--\" zz=\"1\"><unknown><deep>x</deep></unknown> leading</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"--\"> leading</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"--\"><!-- c --><?pi x?> leading</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"--\"> leading</t>"
  assert_eq um(VText.new, "<t"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"--\"> leading</t="), "ERR XML syntax error on line 1: invalid characters between </t and >"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&gt;&lt;\">]]&gt;</t>"), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&gt;&lt;\">]]&gt;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&gt;&lt;\" zz=\"1\"><unknown><deep>x</deep></unknown>]]&gt;</t>"), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&gt;&lt;\">]]&gt;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&gt;&lt;\"><!-- c --><?pi x?>]]&gt;</t>"), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&gt;&lt;\">]]&gt;</t>"
  assert_eq um(VText.new, "<t xml:lang=\""), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlxs:_=\"urn:k\" _:kind=\"&gt;&lt;\">]]&gt;</t>"), "<t xml:lang=\"en\">]]&gt;</t>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[ nbsp]]>\n  <n>-488</n>\n  </cd>"), "<cd><![CDATA[\n   nbsp\n  \n  ]]><n>-488</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[ nbsp]]><n>-488</n></cd>"), "<cd><![CDATA[ nbsp]]><n>-488</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[ nbsp]]><n>-488</n></cd>"), "<cd><![CDATA[ nbsp]]><n>-488</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[ nbsp]]><n>-"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[ nbsp]]><n>-4 8</n></cd>"), "ERR strconv.parse_int: parsing \"-4 8\": invalid syntax"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"]]&gt;\"> leading</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"]]&gt;\"> leading</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"]]&gt;\" zz=\"1\"><unknown><deep>x</deep></unknown> leading</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"]]&gt;\"> leading</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"]]&gt;\"><!-- c --><?pi x?> leading</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"]]&gt;\"> leading</t>"
  assert_eq um(VText.new, "<t xmlns:_=\""), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kixd=\"]]&gt;\"> leading</t>"), "<t> leading</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\" zz=\"1\"><unknown><deep>x</deep></unknown>quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\"><!-- c --><?pi x?>quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\">quote &\#34;q&\#34; &\#39;a"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\">quxte &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\">quxte &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[😀]]>\n  <n>9223372036854775807</n>\n  </cd>"), "<cd><![CDATA[\n  😀\n  \n  ]]><n>9223372036854775807</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[😀]]><n>9223372036854775807</n></cd>"), "<cd><![CDATA[😀]]><n>9223372036854775807</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[😀]]><n>9223372036854775807</n></cd>"), "<cd><![CDATA[😀]]><n>9223372036854775807</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[😀]]><n>922337203685477"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[😀]]><n>922337203685477580=</n></cd>"), "ERR strconv.parse_int: parsing \"922337203685477580=\": invalid syntax"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a--b\">--</t>"), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a--b\">--</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a--b\" zz=\"1\"><unknown><deep>x</deep></unknown>--</t>"), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a--b\">--</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a--b\"><!-- c --><?pi x?>--</t>"), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a--b\">--</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a--b\">"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlnsx_=\"urn:k\" _:kind=\"a--b\">--</t>"), "<t xml:lang=\"en\">--</t>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[--]]>\n  <n>-1</n>\n  </cd>"), "<cd><![CDATA[\n  --\n  \n  ]]><n>-1</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[--]]><n>-1</n></cd>"), "<cd><![CDATA[--]]><n>-1</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[--]]><n>-1</n></cd>"), "<cd><![CDATA[--]]><n>-1</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[--]]><n>-1</n></"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[--]]><n>-1</n></<d>"), "ERR XML syntax error on line 1: expected element name after </"
  assert_eq um(VText.new, "<t xml:lang=\"de\"> nbsp</t>"), "<t xml:lang=\"de\"> nbsp</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" zz=\"1\"><unknown><deep>x</deep></unknown> nbsp</t>"), "<t xml:lang=\"de\"> nbsp</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\"><!-- c --><?pi x?> nbsp</t>"), "<t xml:lang=\"de\"> nbsp</t>"
}

test "marshal vectors 16" {
  assert_eq um(VText.new, "<t xml"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t xml:lxng=\"de\"> nbsp</t>"), "<t> nbsp</t>"
  assert_eq um(VCData.new, "<cd>\n  <![CDATA[&amp;]]>\n  <n>-34</n>\n  </cd>"), "<cd><![CDATA[\n  &amp;\n  \n  ]]><n>-34</n></cd>"
  assert_eq um(VCData.new, "<cd zz=\"1\"><unknown><deep>x</deep></unknown><![CDATA[&amp;]]><n>-34</n></cd>"), "<cd><![CDATA[&amp;]]><n>-34</n></cd>"
  assert_eq um(VCData.new, "<cd><!-- c --><?pi x?><![CDATA[&amp;]]><n>-34</n></cd>"), "<cd><![CDATA[&amp;]]><n>-34</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDAT"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VCData.new, "<cd><![CDATA[&amp;]]>9n>-34</n></cd>"), "ERR XML syntax error on line 1: element <cd> closed by </n>"
  assert_eq um(VText.new, "<t>�</t>"), "<t>�</t>"
  assert_eq um(VText.new, "<t zz=\"1\"><unknown><deep>x</deep></unknown>�</t>"), "<t>�</t>"
  assert_eq um(VText.new, "<t><!-- c --><?pi x?>�</t>"), "<t>�</t>"
  assert_eq um(VText.new, "<t>"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VText.new, "<t>�</t\""), "ERR XML syntax error on line 1: invalid characters between </t and >"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" a=\"1\" c=\"300\"></main>"), "ERR strconv.parse_uint: parsing \"300\": value out of range"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" c=\" 7 \"><i16>40000</i16></main>"), "ERR strconv.parse_int: parsing \"40000\": value out of range"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><i16>abc</i16></main>"), "ERR strconv.parse_int: parsing \"abc\": invalid syntax"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><f>1e400</f></main>"), "ERR strconv.parse_float: parsing \"1e400\": value out of range"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><f> 2.5 </f><g> true </g><u32>-1</u32></main>"), "ERR strconv.parse_uint: parsing \"-1\": invalid syntax"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><g>yes</g></main>"), "ERR strconv.parse_bool: parsing \"yes\": invalid syntax"
  assert_eq um(VMain.new, "<other xmlns=\"urn:v\"></other>"), "ERR expected element type <main> but have <other>"
  assert_eq um(VMain.new, "<main></main>"), "ERR expected element <main> in name space urn:v but have no name space"
  assert_eq um(VMain.new, "<main xmlns=\"urn:w\"></main>"), "ERR expected element <main> in name space urn:v but have urn:w"
  assert_eq um(VMain.new, "<v:main xmlns:v=\"urn:v\" v:a=\"x\" a=\"y\"><v:x><v:y><v:s>deep</v:s></v:y></v:x></v:main>"), "<main xmlns=\"urn:v\" a=\"y\" c=\"0\"><f>0</f><x><y><s>deep</s></y></x><inner id=\"0\"></inner><list></list><bs></bs><i16>0</i16><e1></e1><ns xmlns=\"urn:other\"></ns></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><x><t>1</t><y><s>s</s></y><t>2</t></x><x><t>3</t></x></main>"), "<main xmlns=\"urn:v\" a=\"\" c=\"0\"><f>0</f><x><y><s>s</s></y><t>1</t><t>2</t><t>3</t></x><inner id=\"0\"></inner><list></list><bs></bs><i16>0</i16><e1></e1><ns xmlns=\"urn:other\"></ns></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><list><inner id=\"1\">a</inner><inner id=\"x\">b</inner></list></main>"), "ERR strconv.parse_int: parsing \"x\": invalid syntax"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><list><inner id=\"1\">a<b>bold</b>c</inner><other/></list></main>"), "<main xmlns=\"urn:v\" a=\"\" c=\"0\"><f>0</f><x><y><s></s></y></x><inner id=\"0\"></inner><list><inner id=\"1\">ac</inner></list><bs></bs><i16>0</i16><e1></e1><ns xmlns=\"urn:other\"></ns></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><inner id=\"2\"><![CDATA[<cd>]]>&amp;&\#65;</inner></main>"), "<main xmlns=\"urn:v\" a=\"\" c=\"0\"><f>0</f><x><y><s></s></y></x><inner id=\"2\">&lt;cd&gt;&amp;A</inner><list></list><bs></bs><i16>0</i16><e1></e1><ns xmlns=\"urn:other\"></ns></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><ns xmlns=\"urn:other\">a</ns><ns>b</ns><o:ns xmlns:o=\"urn:other\">c</o:ns></main>"), "<main xmlns=\"urn:v\" a=\"\" c=\"0\"><f>0</f><x><y><s></s></y></x><inner id=\"0\"></inner><list></list><bs></bs><i16>0</i16><e1></e1><ns xmlns=\"urn:other\">c</ns><ns xmlns=\"urn:v\">b</ns></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><p></p><bs>QUJD</bs><e1>1</e1><e1>2</e1></main>"), "<main xmlns=\"urn:v\" a=\"\" c=\"0\"><f>0</f><x><y><s></s></y></x><p></p><inner id=\"0\"></inner><list></list><bs>QUJD</bs><i16>0</i16><e1>2</e1><ns xmlns=\"urn:other\"></ns></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\" e2=\"5\" pi=\"-3\"><q>1<r/>2</q><any1 xmlns=\"urn:any\">z</any1></main>"), "<main xmlns=\"urn:v\" a=\"\" c=\"0\" pi=\"-3\" e2=\"5\"><f>0</f><x><y><s></s></y></x><inner id=\"0\"></inner><list></list><bs></bs><i16>0</i16><e1></e1><ns xmlns=\"urn:other\"></ns><q xmlns=\"urn:v\">1<r/>2</q><any1 xmlns=\"urn:any\">z</any1></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><!--one--><!--two--></main>"), "<main xmlns=\"urn:v\" a=\"\" c=\"0\"><f>0</f><x><y><s></s></y></x><inner id=\"0\"></inner><list></list><!--onetwo--><bs></bs><i16>0</i16><e1></e1><ns xmlns=\"urn:other\"></ns></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"><inner id=\"1\"></inner><inner id=\"2\">second</inner></main>"), "<main xmlns=\"urn:v\" a=\"\" c=\"0\"><f>0</f><x><y><s></s></y></x><inner id=\"2\">second</inner><list></list><bs></bs><i16>0</i16><e1></e1><ns xmlns=\"urn:other\"></ns></main>"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\">"), "ERR XML syntax error on line 1: unexpected EOF"
  assert_eq um(VMain.new, "<main xmlns=\"urn:v\"></mian>"), "ERR XML syntax error on line 1: element <main> closed by </mian>"
  assert_eq um(VMain.new, ""), "ERR EOF"
  assert_eq um(VMain.new, "just text"), "ERR EOF"
  assert_eq um(VMain.new, "<?xml version=\"1.0\"?><!DOCTYPE main><main xmlns=\"urn:v\" a=\"&lt;&gt;\"/>"), "<main xmlns=\"urn:v\" a=\"&lt;&gt;\" c=\"0\"><f>0</f><x><y><s></s></y></x><inner id=\"0\"></inner><list></list><bs></bs><i16>0</i16><e1></e1><ns xmlns=\"urn:other\"></ns></main>"
  assert_eq um(VText.new, "<t xml:lang=\"en\">x</t>"), "<t xml:lang=\"en\">x</t>"
  assert_eq um(VText.new, "<t xmlns:x=\"http://www.w3.org/XML/1998/namespace\" x:lang=\"fr\" lang=\"no\">y</t>"), "<t xml:lang=\"fr\">y</t>"
  assert_eq um(VText.new, "<t kind=\"no\" k:kind=\"yes\" xmlns:k=\"urn:k\">z<a>skip</a>w</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"yes\">zw</t>"
  assert_eq um(VText.new, "<t>&lt;&\#x26;&gt;</t>"), "<t>&lt;&amp;&gt;</t>"
  assert_eq um(VText.new, "<u>wrong</u>"), "ERR expected element type <t> but have <u>"
  assert_eq um(VText.new, "<t><![CDATA[c]]>d<![CDATA[]]>e</t>"), "<t>cde</t>"
  assert_eq um(VCData.new, "<cd><n> 12 </n>text<![CDATA[<x>]]></cd>"), "<cd><![CDATA[text<x>]]><n>12</n></cd>"
  assert_eq um(VCData.new, "<cd><opt><t xml:lang=\"en\">a</t><t>b</t></opt></cd>"), "<cd><n>0</n><opt><t xml:lang=\"en\">b</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><opt><u>a</u></opt><n>1</n><n>2</n></cd>"), "<cd><n>2</n></cd>"
  assert_eq um(VCData.new, "<cd><n>9223372036854775808</n></cd>"), "ERR strconv.parse_int: parsing \"9223372036854775808\": value out of range"
  assert_eq um(VCData.new, "<cd><n>-9223372036854775808</n></cd>"), "<cd><n>-9223372036854775808</n></cd>"
  assert_eq um(VCData.new, "<cd><n>0x10</n></cd>"), "ERR strconv.parse_int: parsing \"0x10\": invalid syntax"
}
