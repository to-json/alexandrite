  assert_eq um(VCData.new, "<cd><n>-771</n></cd>"), "<cd><n>-771</n></cd>"
  assert_eq mx(VText.new(lang: "de", kind: " leading", body: "")), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" leading\"></t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" leading\"></t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" leading\"></t>"
  assert_eq mx(VCData.new(body: "", n: -105)), "<cd><n>-105</n></cd>"
  assert_eq um(VCData.new, "<cd><n>-105</n></cd>"), "<cd><n>-105</n></cd>"
  assert_eq mx(VText.new(lang: "en", kind: "\#{x}", body: " leading")), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"\#{x}\"> leading</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"\#{x}\"> leading</t>"), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"\#{x}\"> leading</t>"
  assert_eq mx(VCData.new(body: " nbsp", n: -1, opt: VText.new(lang: "", kind: "quote \"q\" 'a'", body: "line\nbreak"))), "<cd><![CDATA[ nbsp]]><n>-1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">line&\#xA;break</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[ nbsp]]><n>-1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">line&\#xA;break</t></opt></cd>"), "<cd><![CDATA[ nbsp]]><n>-1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">line&\#xA;break</t></opt></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "", body: "&0")), "<t xml:lang=\"a&amp;b\">&amp;0</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\">&amp;0</t>"), "<t xml:lang=\"a&amp;b\">&amp;0</t>"
  assert_eq mx(VCData.new(body: "<0-", n: (-9223372036854775807 - 1), opt: VText.new(lang: "", kind: "", body: "é ü 白"))), "<cd><![CDATA[<0-]]><n>-9223372036854775808</n><opt><t>é ü 白</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[<0-]]><n>-9223372036854775808</n><opt><t>é ü 白</t></opt></cd>"), "<cd><![CDATA[<0-]]><n>-9223372036854775808</n><opt><t>é ü 白</t></opt></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "", body: "a")), "<t xml:lang=\"a&amp;b\">a</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\">a</t>"), "<t xml:lang=\"a&amp;b\">a</t>"
  assert_eq mx(VCData.new(body: "\uFFFE", n: 255, opt: VText.new(lang: "", kind: "<tag>", body: ""))), "<cd><![CDATA[\uFFFE]]><n>255</n><opt><t xmlns:_=\"urn:k\" _:kind=\"&lt;tag&gt;\"></t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[\uFFFE]]><n>255</n><opt><t xmlns:_=\"urn:k\" _:kind=\"&lt;tag&gt;\"></t></opt></cd>"), "ERR XML syntax error on line 1: illegal character code U+FFFE"
  assert_eq mx(VText.new(lang: "a&b", kind: "", body: "")), "<t xml:lang=\"a&amp;b\"></t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\"></t>"), "<t xml:lang=\"a&amp;b\"></t>"
  assert_eq mx(VCData.new(body: "tab\there", n: -3114, opt: VText.new(lang: "a&b", kind: "&amp;", body: "\#{x}"))), "<cd><![CDATA[tab\there]]><n>-3114</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"&amp;amp;\">\#{x}</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[tab\there]]><n>-3114</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"&amp;amp;\">\#{x}</t></opt></cd>"), "<cd><![CDATA[tab\there]]><n>-3114</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"&amp;amp;\">\#{x}</t></opt></cd>"
  assert_eq mx(VText.new(lang: "en", kind: "'&", body: "")), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&\#39;&amp;\"></t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&\#39;&amp;\"></t>"), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&\#39;&amp;\"></t>"
  assert_eq mx(VCData.new(body: "", n: 1)), "<cd><n>1</n></cd>"
  assert_eq um(VCData.new, "<cd><n>1</n></cd>"), "<cd><n>1</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "--", body: "")), "<t xmlns:_=\"urn:k\" _:kind=\"--\"></t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"--\"></t>"), "<t xmlns:_=\"urn:k\" _:kind=\"--\"></t>"
  assert_eq mx(VCData.new(body: "trailing ", n: -604, opt: VText.new(lang: "a&b", kind: "trailing ", body: Str.from_bytes([255, 98, 97, 100])))), "<cd><![CDATA[trailing ]]><n>-604</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">�bad</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[trailing ]]><n>-604</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">�bad</t></opt></cd>"), "<cd><![CDATA[trailing ]]><n>-604</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">�bad</t></opt></cd>"
  assert_eq mx(VText.new(lang: "de", kind: "Zc'-", body: "\uFFFE")), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"Zc&\#39;-\">�</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"Zc&\#39;-\">�</t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"Zc&\#39;-\">�</t>"
  assert_eq mx(VCData.new(body: "hello world", n: 42, opt: VText.new(lang: "", kind: "", body: " leading"))), "<cd><![CDATA[hello world]]><n>42</n><opt><t> leading</t></opt></cd>"
}

test "marshal vectors 7" {
  assert_eq um(VCData.new, "<cd><![CDATA[hello world]]><n>42</n><opt><t> leading</t></opt></cd>"), "<cd><![CDATA[hello world]]><n>42</n><opt><t> leading</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "trailing ")), "<t>trailing </t>"
  assert_eq um(VText.new, "<t>trailing </t>"), "<t>trailing </t>"
  assert_eq mx(VCData.new(body: " leading", n: 1)), "<cd><![CDATA[ leading]]><n>1</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[ leading]]><n>1</n></cd>"), "<cd><![CDATA[ leading]]><n>1</n></cd>"
  assert_eq mx(VText.new(lang: "en", kind: "", body: "--")), "<t xml:lang=\"en\">--</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\">--</t>"), "<t xml:lang=\"en\">--</t>"
  assert_eq mx(VCData.new(body: "\#{x}", n: 7)), "<cd><![CDATA[\#{x}]]><n>7</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[\#{x}]]><n>7</n></cd>"), "<cd><![CDATA[\#{x}]]><n>7</n></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "cr\r\nlf", body: "line\nbreak")), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">line&\#xA;break</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">line&\#xA;break</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">line&\#xA;break</t>"
  assert_eq mx(VCData.new(body: "Zbc", n: 255)), "<cd><![CDATA[Zbc]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[Zbc]]><n>255</n></cd>"), "<cd><![CDATA[Zbc]]><n>255</n></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "--", body: "quote \"q\" 'a'")), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"--\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"--\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"--\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq mx(VCData.new(body: "--", n: -633)), "<cd><![CDATA[--]]><n>-633</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[--]]><n>-633</n></cd>"), "<cd><![CDATA[--]]><n>-633</n></cd>"
  assert_eq mx(VText.new(lang: "de", kind: "a", body: "x]]>y")), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"a\">x]]&gt;y</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"a\">x]]&gt;y</t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"a\">x]]&gt;y</t>"
  assert_eq mx(VCData.new(body: "a-&<c", n: -470)), "<cd><![CDATA[a-&<c]]><n>-470</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[a-&<c]]><n>-470</n></cd>"), "<cd><![CDATA[a-&<c]]><n>-470</n></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "", body: Str.from_bytes([255, 98, 97, 100]))), "<t xml:lang=\"a&amp;b\">�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\">�bad</t>"), "<t xml:lang=\"a&amp;b\">�bad</t>"
  assert_eq mx(VCData.new(body: "a.'_", n: 9223372036854775807, opt: VText.new(lang: "", kind: "", body: "a&"))), "<cd><![CDATA[a.'_]]><n>9223372036854775807</n><opt><t>a&amp;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[a.'_]]><n>9223372036854775807</n><opt><t>a&amp;</t></opt></cd>"), "<cd><![CDATA[a.'_]]><n>9223372036854775807</n><opt><t>a&amp;</t></opt></cd>"
  assert_eq mx(VText.new(lang: "en", kind: "", body: "\#{x}")), "<t xml:lang=\"en\">\#{x}</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\">\#{x}</t>"), "<t xml:lang=\"en\">\#{x}</t>"
  assert_eq mx(VCData.new(body: "é ü 白", n: -92)), "<cd><![CDATA[é ü 白]]><n>-92</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[é ü 白]]><n>-92</n></cd>"), "<cd><![CDATA[é ü 白]]><n>-92</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "é ü 白", body: "")), "<t xmlns:_=\"urn:k\" _:kind=\"é ü 白\"></t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"é ü 白\"></t>"), "<t xmlns:_=\"urn:k\" _:kind=\"é ü 白\"></t>"
  assert_eq mx(VCData.new(body: "", n: 978, opt: VText.new(lang: "a&b", kind: "", body: "\uFFFE"))), "<cd><n>978</n><opt><t xml:lang=\"a&amp;b\">�</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><n>978</n><opt><t xml:lang=\"a&amp;b\">�</t></opt></cd>"), "<cd><n>978</n><opt><t xml:lang=\"a&amp;b\">�</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "quote \"q\" 'a'")), "<t>quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t>quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t>quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq mx(VCData.new(body: "x]]>y", n: 696, opt: VText.new(lang: "en", kind: "a", body: "\x01ctl"))), "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>696</n><opt><t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a\">�ctl</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>696</n><opt><t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a\">�ctl</t></opt></cd>"), "<cd><![CDATA[x]]]]><![CDATA[>y]]><n>696</n><opt><t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a\">�ctl</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "\#{x}", body: "tab\there")), "<t xmlns:_=\"urn:k\" _:kind=\"\#{x}\">tab&\#x9;here</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"\#{x}\">tab&\#x9;here</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"\#{x}\">tab&\#x9;here</t>"
  assert_eq mx(VCData.new(body: "trailing ", n: 1, opt: VText.new(lang: "", kind: "a", body: "9<"))), "<cd><![CDATA[trailing ]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"a\">9&lt;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[trailing ]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"a\">9&lt;</t></opt></cd>"), "<cd><![CDATA[trailing ]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"a\">9&lt;</t></opt></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "", body: "")), "<t xml:lang=\"a&amp;b\"></t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\"></t>"), "<t xml:lang=\"a&amp;b\"></t>"
  assert_eq mx(VCData.new(body: "tab\there", n: -59)), "<cd><![CDATA[tab\there]]><n>-59</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[tab\there]]><n>-59</n></cd>"), "<cd><![CDATA[tab\there]]><n>-59</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "<tag>")), "<t>&lt;tag&gt;</t>"
  assert_eq um(VText.new, "<t>&lt;tag&gt;</t>"), "<t>&lt;tag&gt;</t>"
  assert_eq mx(VCData.new(body: ">", n: 93, opt: VText.new(lang: "de", kind: "X", body: "trailing "))), "<cd><![CDATA[>]]><n>93</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[>]]><n>93</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </t></opt></cd>"), "<cd><![CDATA[>]]><n>93</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"X\">trailing </t></opt></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "cr\r\nlf", body: "Zb")), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">Zb</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">Zb</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"cr&\#xD;&\#xA;lf\">Zb</t>"
  assert_eq mx(VCData.new(body: "b.", n: 255)), "<cd><![CDATA[b.]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[b.]]><n>255</n></cd>"), "<cd><![CDATA[b.]]><n>255</n></cd>"
  assert_eq mx(VText.new(lang: "de", kind: "", body: Str.from_bytes([255, 98, 97, 100]))), "<t xml:lang=\"de\">�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">�bad</t>"), "<t xml:lang=\"de\">�bad</t>"
  assert_eq mx(VCData.new(body: Str.from_bytes([255, 98, 97, 100]), n: 538, opt: VText.new(lang: "", kind: "b", body: ""))), Str.from_bytes([60, 99, 100, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 53, 51, 56, 60, 47, 110, 62, 60, 111, 112, 116, 62, 60, 116, 32, 120, 109, 108, 110, 115, 58, 95, 61, 34, 117, 114, 110, 58, 107, 34, 32, 95, 58, 107, 105, 110, 100, 61, 34, 98, 34, 62, 60, 47, 116, 62, 60, 47, 111, 112, 116, 62, 60, 47, 99, 100, 62])
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 53, 51, 56, 60, 47, 110, 62, 60, 111, 112, 116, 62, 60, 116, 32, 120, 109, 108, 110, 115, 58, 95, 61, 34, 117, 114, 110, 58, 107, 34, 32, 95, 58, 107, 105, 110, 100, 61, 34, 98, 34, 62, 60, 47, 116, 62, 60, 47, 111, 112, 116, 62, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 1: invalid UTF-8"
  assert_eq mx(VText.new(lang: "", kind: "", body: "😀")), "<t>😀</t>"
  assert_eq um(VText.new, "<t>😀</t>"), "<t>😀</t>"
  assert_eq mx(VCData.new(body: "dash-", n: -752, opt: VText.new(lang: "a&b", kind: "quote \"q\" 'a'", body: "😀"))), "<cd><![CDATA[dash-]]><n>-752</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">😀</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[dash-]]><n>-752</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">😀</t></opt></cd>"), "<cd><![CDATA[dash-]]><n>-752</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"quote &\#34;q&\#34; &\#39;a&\#39;\">😀</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "😀")), "<t>😀</t>"
  assert_eq um(VText.new, "<t>😀</t>"), "<t>😀</t>"
  assert_eq mx(VCData.new(body: "_&", n: -636, opt: VText.new(lang: "a&b", kind: "", body: "quote \"q\" 'a'"))), "<cd><![CDATA[_&]]><n>-636</n><opt><t xml:lang=\"a&amp;b\">quote &\#34;q&\#34; &\#39;a&\#39;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[_&]]><n>-636</n><opt><t xml:lang=\"a&amp;b\">quote &\#34;q&\#34; &\#39;a&\#39;</t></opt></cd>"), "<cd><![CDATA[_&]]><n>-636</n><opt><t xml:lang=\"a&amp;b\">quote &\#34;q&\#34; &\#39;a&\#39;</t></opt></cd>"
  assert_eq mx(VText.new(lang: "de", kind: "", body: Str.from_bytes([255, 98, 97, 100]))), "<t xml:lang=\"de\">�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">�bad</t>"), "<t xml:lang=\"de\">�bad</t>"
  assert_eq mx(VCData.new(body: "--", n: 9223372036854775807, opt: VText.new(lang: "", kind: "9>1", body: ""))), "<cd><![CDATA[--]]><n>9223372036854775807</n><opt><t xmlns:_=\"urn:k\" _:kind=\"9&gt;1\"></t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[--]]><n>9223372036854775807</n><opt><t xmlns:_=\"urn:k\" _:kind=\"9&gt;1\"></t></opt></cd>"), "<cd><![CDATA[--]]><n>9223372036854775807</n><opt><t xmlns:_=\"urn:k\" _:kind=\"9&gt;1\"></t></opt></cd>"
  assert_eq mx(VText.new(lang: "en", kind: "", body: "\uFFFE")), "<t xml:lang=\"en\">�</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\">�</t>"), "<t xml:lang=\"en\">�</t>"
  assert_eq mx(VCData.new(body: "é ü 白", n: 255)), "<cd><![CDATA[é ü 白]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[é ü 白]]><n>255</n></cd>"), "<cd><![CDATA[é ü 白]]><n>255</n></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: " leading", body: "\x01ctl")), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\" leading\">�ctl</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\" leading\">�ctl</t>"), "<t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\" leading\">�ctl</t>"
  assert_eq mx(VCData.new(body: Str.from_bytes([255, 98, 97, 100]), n: 371)), Str.from_bytes([60, 99, 100, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 51, 55, 49, 60, 47, 110, 62, 60, 47, 99, 100, 62])
  assert_eq um(VCData.new, Str.from_bytes([60, 99, 100, 62, 60, 33, 91, 67, 68, 65, 84, 65, 91, 255, 98, 97, 100, 93, 93, 62, 60, 110, 62, 51, 55, 49, 60, 47, 110, 62, 60, 47, 99, 100, 62])), "ERR XML syntax error on line 1: invalid UTF-8"
  assert_eq mx(VText.new(lang: "en", kind: "", body: Str.from_bytes([255, 98, 97, 100]))), "<t xml:lang=\"en\">�bad</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\">�bad</t>"), "<t xml:lang=\"en\">�bad</t>"
  assert_eq mx(VCData.new(body: "hello world", n: -568)), "<cd><![CDATA[hello world]]><n>-568</n></cd>"
}

test "marshal vectors 8" {
  assert_eq um(VCData.new, "<cd><![CDATA[hello world]]><n>-568</n></cd>"), "<cd><![CDATA[hello world]]><n>-568</n></cd>"
  assert_eq mx(VText.new(lang: "de", kind: "", body: "quote \"q\" 'a'")), "<t xml:lang=\"de\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xml:lang=\"de\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq mx(VCData.new(body: "&<\"", n: 2147483648, opt: VText.new(lang: "a&b", kind: "trailing ", body: "\#{x}"))), "<cd><![CDATA[&<\"]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">\#{x}</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[&<\"]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">\#{x}</t></opt></cd>"), "<cd><![CDATA[&<\"]]><n>2147483648</n><opt><t xml:lang=\"a&amp;b\" xmlns:_=\"urn:k\" _:kind=\"trailing \">\#{x}</t></opt></cd>"
  assert_eq mx(VText.new(lang: "de", kind: "", body: "a--b")), "<t xml:lang=\"de\">a--b</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">a--b</t>"), "<t xml:lang=\"de\">a--b</t>"
  assert_eq mx(VCData.new(body: "trailing ", n: -1, opt: VText.new(lang: "", kind: "", body: "quote \"q\" 'a'"))), "<cd><![CDATA[trailing ]]><n>-1</n><opt><t>quote &\#34;q&\#34; &\#39;a&\#39;</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[trailing ]]><n>-1</n><opt><t>quote &\#34;q&\#34; &\#39;a&\#39;</t></opt></cd>"), "<cd><![CDATA[trailing ]]><n>-1</n><opt><t>quote &\#34;q&\#34; &\#39;a&\#39;</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "trailing ", body: "\"")), "<t xmlns:_=\"urn:k\" _:kind=\"trailing \">&\#34;</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"trailing \">&\#34;</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"trailing \">&\#34;</t>"
  assert_eq mx(VCData.new(body: "&", n: -2147483648, opt: VText.new(lang: "de", kind: Str.from_bytes([255, 98, 97, 100]), body: " nbsp"))), "<cd><![CDATA[&]]><n>-2147483648</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"�bad\"> nbsp</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[&]]><n>-2147483648</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"�bad\"> nbsp</t></opt></cd>"), "<cd><![CDATA[&]]><n>-2147483648</n><opt><t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\"�bad\"> nbsp</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "--", body: " leading")), "<t xmlns:_=\"urn:k\" _:kind=\"--\"> leading</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"--\"> leading</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"--\"> leading</t>"
  assert_eq mx(VCData.new(body: "\"1&0&", n: 0, opt: VText.new(lang: "a&b", kind: "", body: "Ya"))), "<cd><![CDATA[\"1&0&]]><n>0</n><opt><t xml:lang=\"a&amp;b\">Ya</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[\"1&0&]]><n>0</n><opt><t xml:lang=\"a&amp;b\">Ya</t></opt></cd>"), "<cd><![CDATA[\"1&0&]]><n>0</n><opt><t xml:lang=\"a&amp;b\">Ya</t></opt></cd>"
  assert_eq mx(VText.new(lang: "de", kind: " nbsp", body: "")), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" nbsp\"></t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" nbsp\"></t>"), "<t xml:lang=\"de\" xmlns:_=\"urn:k\" _:kind=\" nbsp\"></t>"
  assert_eq mx(VCData.new(body: "a", n: -3114)), "<cd><![CDATA[a]]><n>-3114</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[a]]><n>-3114</n></cd>"), "<cd><![CDATA[a]]><n>-3114</n></cd>"
  assert_eq mx(VText.new(lang: "a&b", kind: "", body: "&amp;")), "<t xml:lang=\"a&amp;b\">&amp;amp;</t>"
  assert_eq um(VText.new, "<t xml:lang=\"a&amp;b\">&amp;amp;</t>"), "<t xml:lang=\"a&amp;b\">&amp;amp;</t>"
