  assert_eq um(VCData.new, "<cd><![CDATA[\#{x}]]><n>-133</n></cd>"), "<cd><![CDATA[\#{x}]]><n>-133</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "0")), "<t>0</t>"
  assert_eq um(VText.new, "<t>0</t>"), "<t>0</t>"
  assert_eq mx(VCData.new(body: "&amp;", n: 2147483648, opt: VText.new(lang: "", kind: "", body: "a--b"))), "<cd><![CDATA[&amp;]]><n>2147483648</n><opt><t>a--b</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[&amp;]]><n>2147483648</n><opt><t>a--b</t></opt></cd>"), "<cd><![CDATA[&amp;]]><n>2147483648</n><opt><t>a--b</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "--", body: "--")), "<t xmlns:_=\"urn:k\" _:kind=\"--\">--</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"--\">--</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"--\">--</t>"
  assert_eq mx(VCData.new(body: "", n: 655)), "<cd><n>655</n></cd>"
  assert_eq um(VCData.new, "<cd><n>655</n></cd>"), "<cd><n>655</n></cd>"
