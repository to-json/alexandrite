  assert_eq um(VText.new, "<t xml:lang=\"en\">hello world</t>"), "<t xml:lang=\"en\">hello world</t>"
  assert_eq mx(VCData.new(body: "--", n: 0)), "<cd><![CDATA[--]]><n>0</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[--]]><n>0</n></cd>"), "<cd><![CDATA[--]]><n>0</n></cd>"
