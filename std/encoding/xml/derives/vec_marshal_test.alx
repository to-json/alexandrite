  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&gt;&lt;\">]]&gt;</t>"), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"&gt;&lt;\">]]&gt;</t>"
  assert_eq mx(VCData.new(body: " nbsp", n: -488)), "<cd><![CDATA[ nbsp]]><n>-488</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[ nbsp]]><n>-488</n></cd>"), "<cd><![CDATA[ nbsp]]><n>-488</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "]]>", body: " leading")), "<t xmlns:_=\"urn:k\" _:kind=\"]]&gt;\"> leading</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"]]&gt;\"> leading</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"]]&gt;\"> leading</t>"
  assert_eq mx(VCData.new(body: "_aa>9", n: 1, opt: VText.new(lang: "", kind: "", body: "--"))), "<cd><![CDATA[_aa>9]]><n>1</n><opt><t>--</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[_aa>9]]><n>1</n><opt><t>--</t></opt></cd>"), "<cd><![CDATA[_aa>9]]><n>1</n><opt><t>--</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "é ü 白", body: "")), "<t xmlns:_=\"urn:k\" _:kind=\"é ü 白\"></t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"é ü 白\"></t>"), "<t xmlns:_=\"urn:k\" _:kind=\"é ü 白\"></t>"
  assert_eq mx(VCData.new(body: " leading", n: 2147483648)), "<cd><![CDATA[ leading]]><n>2147483648</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[ leading]]><n>2147483648</n></cd>"), "<cd><![CDATA[ leading]]><n>2147483648</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "'a'Y-")), "<t>&\#39;a&\#39;Y-</t>"
  assert_eq um(VText.new, "<t>&\#39;a&\#39;Y-</t>"), "<t>&\#39;a&\#39;Y-</t>"
  assert_eq mx(VCData.new(body: "--", n: 255)), "<cd><![CDATA[--]]><n>255</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[--]]><n>255</n></cd>"), "<cd><![CDATA[--]]><n>255</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "cXZX1", body: "quote \"q\" 'a'")), "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"cXZX1\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq mx(VCData.new(body: "😀", n: 9223372036854775807)), "<cd><![CDATA[😀]]><n>9223372036854775807</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[😀]]><n>9223372036854775807</n></cd>"), "<cd><![CDATA[😀]]><n>9223372036854775807</n></cd>"
  assert_eq mx(VText.new(lang: "en", kind: "a--b", body: "--")), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a--b\">--</t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a--b\">--</t>"), "<t xml:lang=\"en\" xmlns:_=\"urn:k\" _:kind=\"a--b\">--</t>"
  assert_eq mx(VCData.new(body: "dash-", n: 1, opt: VText.new(lang: "", kind: Str.from_bytes([255, 98, 97, 100]), body: "line\nbreak"))), "<cd><![CDATA[dash-]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"�bad\">line&\#xA;break</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[dash-]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"�bad\">line&\#xA;break</t></opt></cd>"), "<cd><![CDATA[dash-]]><n>1</n><opt><t xmlns:_=\"urn:k\" _:kind=\"�bad\">line&\#xA;break</t></opt></cd>"
  assert_eq mx(VText.new(lang: "en", kind: "", body: "")), "<t xml:lang=\"en\"></t>"
  assert_eq um(VText.new, "<t xml:lang=\"en\"></t>"), "<t xml:lang=\"en\"></t>"
  assert_eq mx(VCData.new(body: "--", n: -1)), "<cd><![CDATA[--]]><n>-1</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[--]]><n>-1</n></cd>"), "<cd><![CDATA[--]]><n>-1</n></cd>"
  assert_eq mx(VText.new(lang: "de", kind: "", body: "\x01ctl")), "<t xml:lang=\"de\">�ctl</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\">�ctl</t>"), "<t xml:lang=\"de\">�ctl</t>"
  assert_eq mx(VCData.new(body: "\x01ctl", n: -922)), "<cd><![CDATA[\x01ctl]]><n>-922</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[\x01ctl]]><n>-922</n></cd>"), "ERR XML syntax error on line 1: illegal character code U+0001"
  assert_eq mx(VText.new(lang: "de", kind: "", body: " nbsp")), "<t xml:lang=\"de\"> nbsp</t>"
  assert_eq um(VText.new, "<t xml:lang=\"de\"> nbsp</t>"), "<t xml:lang=\"de\"> nbsp</t>"
  assert_eq mx(VCData.new(body: "&amp;", n: -34)), "<cd><![CDATA[&amp;]]><n>-34</n></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[&amp;]]><n>-34</n></cd>"), "<cd><![CDATA[&amp;]]><n>-34</n></cd>"
  assert_eq mx(VText.new(lang: "", kind: "a&b", body: "quote \"q\" 'a'")), "<t xmlns:_=\"urn:k\" _:kind=\"a&amp;b\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq um(VText.new, "<t xmlns:_=\"urn:k\" _:kind=\"a&amp;b\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"), "<t xmlns:_=\"urn:k\" _:kind=\"a&amp;b\">quote &\#34;q&\#34; &\#39;a&\#39;</t>"
  assert_eq mx(VCData.new(body: "000 &", n: 9223372036854775807, opt: VText.new(lang: "a&b", kind: "", body: "b.-Y"))), "<cd><![CDATA[000 &]]><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;b\">b.-Y</t></opt></cd>"
  assert_eq um(VCData.new, "<cd><![CDATA[000 &]]><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;b\">b.-Y</t></opt></cd>"), "<cd><![CDATA[000 &]]><n>9223372036854775807</n><opt><t xml:lang=\"a&amp;b\">b.-Y</t></opt></cd>"
  assert_eq mx(VText.new(lang: "", kind: "", body: "\uFFFE")), "<t>�</t>"
  assert_eq um(VText.new, "<t>�</t>"), "<t>�</t>"
  assert_eq mx(VCData.new(body: "", n: (-9223372036854775807 - 1))), "<cd><n>-9223372036854775808</n></cd>"
