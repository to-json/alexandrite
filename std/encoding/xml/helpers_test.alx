import "strconv"

# Test helpers shared by the test files (the generated vectors use dump).

def tok_text(t: Token) -> Str {
  case t {
    StartElement(s) => {
      parts: [Str] = ["S #{s.name.space} #{s.name.local}"]
      for a in s.attr {
        parts << "#{a.name.space}:#{a.name.local}=#{strconv.quote(a.value)}"
      }
      parts.join(" ")
    }
    EndElement(e) => "E #{e.name.space} #{e.name.local}"
    CharData(b) => "C #{strconv.quote(Str.from_bytes(b))}"
    Comment(b) => "M #{strconv.quote(Str.from_bytes(b))}"
    ProcInst(p) => "P #{p.target} #{strconv.quote(Str.from_bytes(p.inst))}"
    Directive(b) => "D #{strconv.quote(Str.from_bytes(b))}"
  }
}

def err_text(e: Error) -> Str {
  case e {
    XmlError.Syntax(m, l) => "ERR syntax #{l}: #{m}"
    _ => "ERR #{e.message}"
  }
}

# The tokens of input, one per line with the decoder's offset and position
# after each, then EOF or the error. mode 0: raw_token!; 1: token!; 2:
# token! with strict off, HTML auto-close and entities.
def dump(input: Str, mode: Int) -> Str {
  d = new_string_decoder(input)
  if mode == 2 {
    d.strict = false
    d.auto_close = HTML_AUTO_CLOSE
    d.entity = html_entity()
  }
  out: [Str] = []
  n = 0
  while n < 1000 {
    r = mode == 0 ? d.raw_token! : d.token!
    if e = r.err {
      out << err_text(e)
      break
    }
    t0 = r.unwrap
    if t = t0 {
      lc = d.input_pos
      out << "#{tok_text(t)} @#{d.input_offset} #{lc[0]}:#{lc[1]}"
    } else {
      out << "EOF"
      break
    }
    n += 1
  }
  out.join("\n")
}

# All the tokens of input (token!), failing on an error.
def all_tokens(input: Str) -> ~[Token] {
  d = new_string_decoder(input)
  out: [Token] = []
  loop {
    t = d.~token!
    if x = t {
      out << x
    } else {
      break
    }
  }
  out
}

# The error that ends reading input with token!, or none.
def token_err(d0: Decoder) -> Error? {
  d = d0
  loop {
    r = d.token!
    if e = r.err {
      return e
    }
    return none if r.unwrap.none?
  }
  none
}

def syntax_msg(e: Error?) -> Str {
  if x = e {
    case x {
      XmlError.Syntax(m, _) => {return m}
      _ => {return "not a syntax error: #{x.message}"}
    }
  }
  "no error"
}

def ssub(s: Str, part: Str) -> Bool { strings_contains(s, part) }

def strings_contains(s: Str, part: Str) -> Bool {
  return true if part.size == 0
  i = 0
  while i + part.size <= s.size {
    return true if s[i...i + part.size] == part
    i += 1
  }
  false
}

def cd(s: Str) -> Token { char_data(s) }
def se(local: Str, attrs: [Attr]) -> Token { start_token(name("", local), attrs) }
def sen(space: Str, local: Str, attrs: [Attr]) -> Token { start_token(name(space, local), attrs) }
def en(local: Str) -> Token { end_token(name("", local)) }
def enn(space: Str, local: Str) -> Token { end_token(name(space, local)) }
def at(space: Str, local: Str, v: Str) -> Attr { attr(space, local, v) }

def toks_text(ts: [Token]) -> Str {
  out: [Str] = []
  for t in ts {
    out << tok_text(t)
  }
  out.join("\n")
}

def ot(t: Token?) -> Str {
  if x = t {
    return tok_text(x)
  }
  "none"
}
