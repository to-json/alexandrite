  assert_eq dump("<!d", 0), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<!d", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<!d", 2), "ERR syntax 1: unexpected EOF"
