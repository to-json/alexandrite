}

test "tokens 10" {
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'><!-- c --><b>t&amp;u</b><![CDATA[q]]><c/></a>", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nM \" c \" @76 1:77\nS  b @79 1:80\nC \"t&u\" @86 1:87\nE  b @90 1:91\nC \"q\" @103 1:104\nS  c @107 1:108\nE  c @107 1:108\nE  a @111 1:112\nEOF"
  assert_eq dump("", 1), "EOF"
  assert_eq dump("<", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a ", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a x", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xm", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xml", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmln", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\"", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" ", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" x", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xm", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xml", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmln", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\"", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" ", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" x", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xm", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xml", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmln", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\"", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" ", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=\"", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=\"1", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=\"1\"", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=\"1\" ", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=\"1\" y", 1), "ERR syntax 1: unexpected EOF"
