  assert_eq dump("<root>\n<?pi\n ?>  <elt\natt\n=\n\"val\">\n<![CDATA[\n]]><!--\n\n--></elt>\n</root>", 2), "S  root @6 1:7\nC \"\\n\" @7 2:1\nP pi \"\" @15 3:4\nC \"  \" @17 3:6\nS  elt :att=\"val\" @34 6:7\nC \"\\n\" @35 7:1\nC \"\\n\" @48 8:4\nM \"\\n\\n\" @57 10:4\nE  elt @63 10:10\nC \"\\n\" @64 11:1\nE  root @71 11:8\nEOF"
  assert_eq dump("<", 0), "ERR syntax 1: unexpected EOF"
