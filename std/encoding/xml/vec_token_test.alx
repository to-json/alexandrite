  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'><!-- c --><b>t&amp;u</b><![CDATA[q]]><c", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nM \" c \" @76 1:77\nS  b @79 1:80\nC \"t&u\" @86 1:87\nE  b @90 1:91\nC \"q\" @103 1:104\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'><!-- c --><b>t&amp;u</b><![CDATA[q]]><c/", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nM \" c \" @76 1:77\nS  b @79 1:80\nC \"t&u\" @86 1:87\nE  b @90 1:91\nC \"q\" @103 1:104\nERR syntax 1: unexpected EOF"
