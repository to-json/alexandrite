  assert_eq dump("<?p", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?p", 2), "ERR syntax 1: unexpected EOF"
}

test "tokens 2" {
  assert_eq dump("<t a", 0), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a", 2), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a=", 0), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a=", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a=", 2), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a='", 0), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a='", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a='", 2), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a=''", 0), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a=''", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t a=''", 2), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<t/><![", 0), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF"
  assert_eq dump("<t/><![", 1), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF"
  assert_eq dump("<t/><![", 2), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF"
  assert_eq dump("<t/><![C", 0), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF"
  assert_eq dump("<t/><![C", 1), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF"
  assert_eq dump("<t/><![C", 2), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF"
  assert_eq dump("<t/><![CDATA[d", 0), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF in CDATA section"
  assert_eq dump("<t/><![CDATA[d", 1), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF in CDATA section"
  assert_eq dump("<t/><![CDATA[d", 2), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF in CDATA section"
  assert_eq dump("<t/><![CDATA[d]", 0), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF in CDATA section"
  assert_eq dump("<t/><![CDATA[d]", 1), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF in CDATA section"
  assert_eq dump("<t/><![CDATA[d]", 2), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF in CDATA section"
  assert_eq dump("<t/><![CDATA[d]]", 0), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF in CDATA section"
  assert_eq dump("<t/><![CDATA[d]]", 1), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF in CDATA section"
  assert_eq dump("<t/><![CDATA[d]]", 2), "S  t @4 1:5\nE  t @4 1:5\nERR syntax 1: unexpected EOF in CDATA section"
  assert_eq dump("<>", 0), "ERR syntax 1: expected element name after <"
  assert_eq dump("<>", 1), "ERR syntax 1: expected element name after <"
  assert_eq dump("<>", 2), "ERR syntax 1: expected element name after <"
  assert_eq dump("<t/a", 0), "ERR syntax 1: expected /> in element"
  assert_eq dump("<t/a", 1), "ERR syntax 1: expected /> in element"
  assert_eq dump("<t/a", 2), "ERR syntax 1: expected /> in element"
  assert_eq dump("<0 />", 0), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("<0 />", 1), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("<0 />", 2), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("<?0 >", 0), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("<?0 >", 1), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("<?0 >", 2), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("</0>", 0), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("</0>", 1), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("</0>", 2), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("<t 0=''>", 0), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("<t 0=''>", 1), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("<t 0=''>", 2), "ERR syntax 1: invalid XML name: 0"
  assert_eq dump("<t a='&'>", 0), "ERR syntax 1: invalid character entity & (no semicolon)"
  assert_eq dump("<t a='&'>", 1), "ERR syntax 1: invalid character entity & (no semicolon)"
  assert_eq dump("<t a='&'>", 2), "S  t :a=\"&\" @9 1:10\nERR syntax 1: unexpected EOF"
  assert_eq dump("<t a='<'>", 0), "ERR syntax 1: unescaped < inside quoted string"
  assert_eq dump("<t a='<'>", 1), "ERR syntax 1: unescaped < inside quoted string"
  assert_eq dump("<t a='<'>", 2), "ERR syntax 1: unescaped < inside quoted string"
  assert_eq dump("<t>&nbspc;</t>", 0), "S  t @3 1:4\nERR syntax 1: invalid character entity &nbspc;"
  assert_eq dump("<t>&nbspc;</t>", 1), "S  t @3 1:4\nERR syntax 1: invalid character entity &nbspc;"
  assert_eq dump("<t>&nbspc;</t>", 2), "S  t @3 1:4\nC \"&nbspc;\" @10 1:11\nE  t @14 1:15\nEOF"
  assert_eq dump("<t a>", 0), "ERR syntax 1: attribute name without = in element"
  assert_eq dump("<t a>", 1), "ERR syntax 1: attribute name without = in element"
  assert_eq dump("<t a>", 2), "S  t :a=\"a\" @5 1:6\nERR syntax 1: unexpected EOF"
  assert_eq dump("<t a=>", 0), "ERR syntax 1: unquoted or missing attribute value in element"
  assert_eq dump("<t a=>", 1), "ERR syntax 1: unquoted or missing attribute value in element"
  assert_eq dump("<t a=>", 2), "S  t :a=\"\" @6 1:7\nERR syntax 1: unexpected EOF"
}

test "tokens 3" {
  assert_eq dump("<t a=v>", 0), "ERR syntax 1: unquoted or missing attribute value in element"
  assert_eq dump("<t a=v>", 1), "ERR syntax 1: unquoted or missing attribute value in element"
  assert_eq dump("<t a=v>", 2), "S  t :a=\"v\" @7 1:8\nERR syntax 1: unexpected EOF"
  assert_eq dump("<t></e>", 0), "S  t @3 1:4\nE  e @7 1:8\nEOF"
  assert_eq dump("<t></e>", 1), "S  t @3 1:4\nERR syntax 1: element <t> closed by </e>"
  assert_eq dump("<t></e>", 2), "S  t @3 1:4\nE  t @7 1:8\nERR syntax 1: unexpected end element </e>"
  assert_eq dump("<t></>", 0), "S  t @3 1:4\nERR syntax 1: expected element name after </"
  assert_eq dump("<t></>", 1), "S  t @3 1:4\nERR syntax 1: expected element name after </"
  assert_eq dump("<t></>", 2), "S  t @3 1:4\nERR syntax 1: expected element name after </"
  assert_eq dump("<t></t!", 0), "S  t @3 1:4\nERR syntax 1: invalid characters between </t and >"
  assert_eq dump("<t></t!", 1), "S  t @3 1:4\nERR syntax 1: invalid characters between </t and >"
  assert_eq dump("<t></t!", 2), "S  t @3 1:4\nERR syntax 1: invalid characters between </t and >"
  assert_eq dump("<t>cdata]]></t>", 0), "S  t @3 1:4\nERR syntax 1: unescaped ]]> not in CDATA section"
  assert_eq dump("<t>cdata]]></t>", 1), "S  t @3 1:4\nERR syntax 1: unescaped ]]> not in CDATA section"
  assert_eq dump("<t>cdata]]></t>", 2), "S  t @3 1:4\nERR syntax 1: unescaped ]]> not in CDATA section"
  assert_eq dump("<!0 >", 0), "D \"0 \" @5 1:6\nEOF"
  assert_eq dump("<!0 >", 1), "D \"0 \" @5 1:6\nEOF"
  assert_eq dump("<!0 >", 2), "D \"0 \" @5 1:6\nEOF"
  assert_eq dump("<![CDATA[d]]>", 0), "C \"d\" @13 1:14\nEOF"
  assert_eq dump("<![CDATA[d]]>", 1), "C \"d\" @13 1:14\nEOF"
  assert_eq dump("<![CDATA[d]]>", 2), "C \"d\" @13 1:14\nEOF"
  assert_eq dump("\x12<doc/>", 0), "ERR syntax 1: illegal character code U+0012"
  assert_eq dump("\x12<doc/>", 1), "ERR syntax 1: illegal character code U+0012"
  assert_eq dump("\x12<doc/>", 2), "ERR syntax 1: illegal character code U+0012"
  assert_eq dump("<?xml version=\"1.0\"?>\x0b<doc/>", 0), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: illegal character code U+000B"
  assert_eq dump("<?xml version=\"1.0\"?>\x0b<doc/>", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: illegal character code U+000B"
  assert_eq dump("<?xml version=\"1.0\"?>\x0b<doc/>", 2), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: illegal character code U+000B"
  assert_eq dump("\uFFFE<doc/>", 0), "ERR syntax 1: illegal character code U+FFFE"
  assert_eq dump("\uFFFE<doc/>", 1), "ERR syntax 1: illegal character code U+FFFE"
  assert_eq dump("\uFFFE<doc/>", 2), "ERR syntax 1: illegal character code U+FFFE"
  assert_eq dump("<?xml version=\"1.0\"?><doc>\r\n<hiya/>\x07<toots/></doc>", 0), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nS  doc @26 1:27\nC \"\\n\" @28 2:1\nS  hiya @35 2:8\nE  hiya @35 2:8\nERR syntax 2: illegal character code U+0007"
  assert_eq dump("<?xml version=\"1.0\"?><doc>\r\n<hiya/>\x07<toots/></doc>", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nS  doc @26 1:27\nC \"\\n\" @28 2:1\nS  hiya @35 2:8\nE  hiya @35 2:8\nERR syntax 2: illegal character code U+0007"
  assert_eq dump("<?xml version=\"1.0\"?><doc>\r\n<hiya/>\x07<toots/></doc>", 2), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nS  doc @26 1:27\nC \"\\n\" @28 2:1\nS  hiya @35 2:8\nE  hiya @35 2:8\nERR syntax 2: illegal character code U+0007"
  assert_eq dump("<?xml version=\"1.0\"?><doc \x12='value'>what's up</doc>", 0), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: expected attribute name in element"
  assert_eq dump("<?xml version=\"1.0\"?><doc \x12='value'>what's up</doc>", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: expected attribute name in element"
  assert_eq dump("<?xml version=\"1.0\"?><doc \x12='value'>what's up</doc>", 2), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: expected attribute name in element"
  assert_eq dump("<doc>&abc\x01;</doc>", 0), "S  doc @5 1:6\nERR syntax 1: invalid character entity &abc (no semicolon)"
  assert_eq dump("<doc>&abc\x01;</doc>", 1), "S  doc @5 1:6\nERR syntax 1: invalid character entity &abc (no semicolon)"
  assert_eq dump("<doc>&abc\x01;</doc>", 2), "S  doc @5 1:6\nERR syntax 1: illegal character code U+0001"
  assert_eq dump("<doc>&\x01;</doc>", 0), "S  doc @5 1:6\nERR syntax 1: invalid character entity & (no semicolon)"
  assert_eq dump("<doc>&\x01;</doc>", 1), "S  doc @5 1:6\nERR syntax 1: invalid character entity & (no semicolon)"
  assert_eq dump("<doc>&\x01;</doc>", 2), "S  doc @5 1:6\nERR syntax 1: illegal character code U+0001"
  assert_eq dump("<doc>&\uFFFE;</doc>", 0), "S  doc @5 1:6\nERR syntax 1: invalid character entity &\uFFFE;"
  assert_eq dump("<doc>&\uFFFE;</doc>", 1), "S  doc @5 1:6\nERR syntax 1: invalid character entity &\uFFFE;"
  assert_eq dump("<doc>&\uFFFE;</doc>", 2), "S  doc @5 1:6\nERR syntax 1: illegal character code U+FFFE"
  assert_eq dump("<doc>&hello;</doc>", 0), "S  doc @5 1:6\nERR syntax 1: invalid character entity &hello;"
  assert_eq dump("<doc>&hello;</doc>", 1), "S  doc @5 1:6\nERR syntax 1: invalid character entity &hello;"
  assert_eq dump("<doc>&hello;</doc>", 2), "S  doc @5 1:6\nC \"&hello;\" @12 1:13\nE  doc @18 1:19\nEOF"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?></foo>", 0), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nE  foo @44 1:45\nEOF"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?></foo>", 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: unexpected end element </foo>"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?></foo>", 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: unexpected end element </foo>"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><x:foo></y:foo>", 0), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nS x foo @45 1:46\nE y foo @53 1:54\nEOF"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><x:foo></y:foo>", 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nS x foo @45 1:46\nERR syntax 1: element <foo> in space x closed by </foo> in space y"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><x:foo></y:foo>", 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nS x foo @45 1:46\nERR syntax 1: element <foo> in space x closed by </foo> in space y"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><? not ok ?>", 0), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: expected target name after <?"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><? not ok ?>", 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: expected target name after <?"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><? not ok ?>", 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: expected target name after <?"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!- not ok -->", 0), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid sequence <!- not part of <!--"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!- not ok -->", 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid sequence <!- not part of <!--"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!- not ok -->", 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid sequence <!- not part of <!--"
}

test "tokens 4" {
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-? not ok -->", 0), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid sequence <!- not part of <!--"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-? not ok -->", 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid sequence <!- not part of <!--"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><!-? not ok -->", 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid sequence <!- not part of <!--"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><![not ok]>", 0), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid <![ sequence"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><![not ok]>", 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid <![ sequence"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><![not ok]>", 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid <![ sequence"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><zzz:foo xmlns:zzz=\"http://example.com\"><bar>baz</bar></foo>", 0), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nS zzz foo xmlns:zzz=\"http://example.com\" @78 1:79\nS  bar @83 1:84\nC \"baz\" @86 1:87\nE  bar @92 1:93\nE  foo @98 1:99\nEOF"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><zzz:foo xmlns:zzz=\"http://example.com\"><bar>baz</bar></foo>", 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nS http://example.com foo xmlns:zzz=\"http://example.com\" @78 1:79\nS  bar @83 1:84\nC \"baz\" @86 1:87\nE  bar @92 1:93\nERR syntax 1: element <foo> in space zzz closed by </foo> in space \"\""
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><zzz:foo xmlns:zzz=\"http://example.com\"><bar>baz</bar></foo>", 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nS http://example.com foo xmlns:zzz=\"http://example.com\" @78 1:79\nS  bar @83 1:84\nC \"baz\" @86 1:87\nE  bar @92 1:93\nERR syntax 1: element <foo> in space zzz closed by </foo> in space \"\""
  assert_eq dump(Str.from_bytes([60, 63, 120, 109, 108, 32, 118, 101, 114, 115, 105, 111, 110, 61, 34, 49, 46, 48, 34, 32, 101, 110, 99, 111, 100, 105, 110, 103, 61, 34, 85, 84, 70, 45, 56, 34, 63, 62, 241]), 0), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid UTF-8"
  assert_eq dump(Str.from_bytes([60, 63, 120, 109, 108, 32, 118, 101, 114, 115, 105, 111, 110, 61, 34, 49, 46, 48, 34, 32, 101, 110, 99, 111, 100, 105, 110, 103, 61, 34, 85, 84, 70, 45, 56, 34, 63, 62, 241]), 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid UTF-8"
  assert_eq dump(Str.from_bytes([60, 63, 120, 109, 108, 32, 118, 101, 114, 115, 105, 111, 110, 61, 34, 49, 46, 48, 34, 32, 101, 110, 99, 111, 100, 105, 110, 103, 61, 34, 85, 84, 70, 45, 56, 34, 63, 62, 241]), 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nERR syntax 1: invalid UTF-8"
  assert_eq dump("<?xml version=\"1.1\" encoding=\"UTF-8\"?>", 0), "ERR xml: unsupported version \"1.1\"; only version 1.0 is supported"
  assert_eq dump("<?xml version=\"1.1\" encoding=\"UTF-8\"?>", 1), "ERR xml: unsupported version \"1.1\"; only version 1.0 is supported"
  assert_eq dump("<?xml version=\"1.1\" encoding=\"UTF-8\"?>", 2), "ERR xml: unsupported version \"1.1\"; only version 1.0 is supported"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><?ok?>", 0), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nP ok \"\" @44 1:45\nEOF"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><?ok?>", 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nP ok \"\" @44 1:45\nEOF"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><?ok?>", 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nP ok \"\" @44 1:45\nEOF"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><?ok version=\"ok\"?>", 0), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nP ok \"version=\\\"ok\\\"\" @57 1:58\nEOF"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><?ok version=\"ok\"?>", 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nP ok \"version=\\\"ok\\\"\" @57 1:58\nEOF"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?><?ok version=\"ok\"?>", 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nP ok \"version=\\\"ok\\\"\" @57 1:58\nEOF"
  assert_eq dump("<item b=']]>'/>", 0), "S  item :b=\"]]>\" @15 1:16\nE  item @15 1:16\nEOF"
  assert_eq dump("<item b=']]>'/>", 1), "S  item :b=\"]]>\" @15 1:16\nE  item @15 1:16\nEOF"
  assert_eq dump("<item b=']]>'/>", 2), "S  item :b=\"]]>\" @15 1:16\nE  item @15 1:16\nEOF"
  assert_eq dump("<tag attr=azAZ09:-_\t>", 0), "ERR syntax 1: unquoted or missing attribute value in element"
  assert_eq dump("<tag attr=azAZ09:-_\t>", 1), "ERR syntax 1: unquoted or missing attribute value in element"
  assert_eq dump("<tag attr=azAZ09:-_\t>", 2), "S  tag :attr=\"azAZ09:-_\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<p nowrap>", 0), "ERR syntax 1: attribute name without = in element"
  assert_eq dump("<p nowrap>", 1), "ERR syntax 1: attribute name without = in element"
  assert_eq dump("<p nowrap>", 2), "S  p :nowrap=\"nowrap\" @10 1:11\nERR syntax 1: unexpected EOF"
  assert_eq dump("<p nowrap >", 0), "ERR syntax 1: attribute name without = in element"
  assert_eq dump("<p nowrap >", 1), "ERR syntax 1: attribute name without = in element"
  assert_eq dump("<p nowrap >", 2), "S  p :nowrap=\"nowrap\" @11 1:12\nERR syntax 1: unexpected EOF"
  assert_eq dump("<input checked/>", 0), "ERR syntax 1: attribute name without = in element"
  assert_eq dump("<input checked/>", 1), "ERR syntax 1: attribute name without = in element"
  assert_eq dump("<input checked/>", 2), "S  input :checked=\"checked\" @16 1:17\nE  input @16 1:17\nEOF"
  assert_eq dump("<input checked />", 0), "ERR syntax 1: attribute name without = in element"
  assert_eq dump("<input checked />", 1), "ERR syntax 1: attribute name without = in element"
  assert_eq dump("<input checked />", 2), "S  input :checked=\"checked\" @17 1:18\nE  input @17 1:18\nEOF"
  assert_eq dump("<P>Foo<P>\n\n<P>Bar</>\n", 0), "S  P @3 1:4\nC \"Foo\" @6 1:7\nS  P @9 1:10\nC \"\\n\\n\" @11 3:1\nS  P @14 3:4\nC \"Bar\" @17 3:7\nERR syntax 3: expected element name after </"
  assert_eq dump("<P>Foo<P>\n\n<P>Bar</>\n", 1), "S  P @3 1:4\nC \"Foo\" @6 1:7\nS  P @9 1:10\nC \"\\n\\n\" @11 3:1\nS  P @14 3:4\nC \"Bar\" @17 3:7\nERR syntax 3: expected element name after </"
  assert_eq dump("<P>Foo<P>\n\n<P>Bar</>\n", 2), "S  P @3 1:4\nC \"Foo\" @6 1:7\nS  P @9 1:10\nC \"\\n\\n\" @11 3:1\nS  P @14 3:4\nC \"Bar\" @17 3:7\nERR syntax 3: expected element name after </"
  assert_eq dump("<FOO></FOO>  ", 0), "S  FOO @5 1:6\nE  FOO @11 1:12\nC \"  \" @13 1:14\nEOF"
  assert_eq dump("<FOO></FOO>  ", 1), "S  FOO @5 1:6\nE  FOO @11 1:12\nC \"  \" @13 1:14\nEOF"
  assert_eq dump("<FOO></FOO>  ", 2), "S  FOO @5 1:6\nE  FOO @11 1:12\nC \"  \" @13 1:14\nEOF"
  assert_eq dump("<test><![CDATA[ &val=foo ]]></test>", 0), "S  test @6 1:7\nC \" &val=foo \" @28 1:29\nE  test @35 1:36\nEOF"
  assert_eq dump("<test><![CDATA[ &val=foo ]]></test>", 1), "S  test @6 1:7\nC \" &val=foo \" @28 1:29\nE  test @35 1:36\nEOF"
  assert_eq dump("<test><![CDATA[ &val=foo ]]></test>", 2), "S  test @6 1:7\nC \" &val=foo \" @28 1:29\nE  test @35 1:36\nEOF"
  assert_eq dump("<root>", 0), "S  root @6 1:7\nEOF"
  assert_eq dump("<root>", 1), "S  root @6 1:7\nERR syntax 1: unexpected EOF"
  assert_eq dump("<root>", 2), "S  root @6 1:7\nERR syntax 1: unexpected EOF"
  assert_eq dump("<root><foo>", 0), "S  root @6 1:7\nS  foo @11 1:12\nEOF"
  assert_eq dump("<root><foo>", 1), "S  root @6 1:7\nS  foo @11 1:12\nERR syntax 1: unexpected EOF"
  assert_eq dump("<root><foo>", 2), "S  root @6 1:7\nS  foo @11 1:12\nERR syntax 1: unexpected EOF"
  assert_eq dump("<root><foo></foo>", 0), "S  root @6 1:7\nS  foo @11 1:12\nE  foo @17 1:18\nEOF"
  assert_eq dump("<root><foo></foo>", 1), "S  root @6 1:7\nS  foo @11 1:12\nE  foo @17 1:18\nERR syntax 1: unexpected EOF"
  assert_eq dump("<root><foo></foo>", 2), "S  root @6 1:7\nS  foo @11 1:12\nE  foo @17 1:18\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml encoding=\"UtF-8\" version=\"1.0\"?><root/>", 0), "P xml \"encoding=\\\"UtF-8\\\" version=\\\"1.0\\\"\" @38 1:39\nS  root @45 1:46\nE  root @45 1:46\nEOF"
  assert_eq dump("<?xml encoding=\"UtF-8\" version=\"1.0\"?><root/>", 1), "P xml \"encoding=\\\"UtF-8\\\" version=\\\"1.0\\\"\" @38 1:39\nS  root @45 1:46\nE  root @45 1:46\nEOF"
  assert_eq dump("<?xml encoding=\"UtF-8\" version=\"1.0\"?><root/>", 2), "P xml \"encoding=\\\"UtF-8\\\" version=\\\"1.0\\\"\" @38 1:39\nS  root @45 1:46\nE  root @45 1:46\nEOF"
}

test "tokens 5" {
  assert_eq dump("<?xml encoding=\"UTF-8\" version=\"1.0\"?><root/>", 0), "P xml \"encoding=\\\"UTF-8\\\" version=\\\"1.0\\\"\" @38 1:39\nS  root @45 1:46\nE  root @45 1:46\nEOF"
  assert_eq dump("<?xml encoding=\"UTF-8\" version=\"1.0\"?><root/>", 1), "P xml \"encoding=\\\"UTF-8\\\" version=\\\"1.0\\\"\" @38 1:39\nS  root @45 1:46\nE  root @45 1:46\nEOF"
  assert_eq dump("<?xml encoding=\"UTF-8\" version=\"1.0\"?><root/>", 2), "P xml \"encoding=\\\"UTF-8\\\" version=\\\"1.0\\\"\" @38 1:39\nS  root @45 1:46\nE  root @45 1:46\nEOF"
  assert_eq dump("<?xml encoding=\"utf-8\" version=\"1.0\"?><root/>", 0), "P xml \"encoding=\\\"utf-8\\\" version=\\\"1.0\\\"\" @38 1:39\nS  root @45 1:46\nE  root @45 1:46\nEOF"
  assert_eq dump("<?xml encoding=\"utf-8\" version=\"1.0\"?><root/>", 1), "P xml \"encoding=\\\"utf-8\\\" version=\\\"1.0\\\"\" @38 1:39\nS  root @45 1:46\nE  root @45 1:46\nEOF"
  assert_eq dump("<?xml encoding=\"utf-8\" version=\"1.0\"?><root/>", 2), "P xml \"encoding=\\\"utf-8\\\" version=\\\"1.0\\\"\" @38 1:39\nS  root @45 1:46\nE  root @45 1:46\nEOF"
  assert_eq dump("<?xml encoding=\"uuu-9\" version=\"1.0\"?><root/>", 0), "ERR xml: encoding \"uuu-9\" declared but Decoder.CharsetReader is nil"
  assert_eq dump("<?xml encoding=\"uuu-9\" version=\"1.0\"?><root/>", 1), "ERR xml: encoding \"uuu-9\" declared but Decoder.CharsetReader is nil"
  assert_eq dump("<?xml encoding=\"uuu-9\" version=\"1.0\"?><root/>", 2), "ERR xml: encoding \"uuu-9\" declared but Decoder.CharsetReader is nil"
  assert_eq dump("<x:book xmlns:x=\"abcd\" xmlns:y=\"abcd\"><unclosetag>one</x:book>", 0), "S x book xmlns:x=\"abcd\" xmlns:y=\"abcd\" @38 1:39\nS  unclosetag @50 1:51\nC \"one\" @53 1:54\nE x book @62 1:63\nEOF"
  assert_eq dump("<x:book xmlns:x=\"abcd\" xmlns:y=\"abcd\"><unclosetag>one</x:book>", 1), "S abcd book xmlns:x=\"abcd\" xmlns:y=\"abcd\" @38 1:39\nS  unclosetag @50 1:51\nC \"one\" @53 1:54\nERR syntax 1: element <unclosetag> closed by </book>"
  assert_eq dump("<x:book xmlns:x=\"abcd\" xmlns:y=\"abcd\"><unclosetag>one</x:book>", 2), "S abcd book xmlns:x=\"abcd\" xmlns:y=\"abcd\" @38 1:39\nS  unclosetag @50 1:51\nC \"one\" @53 1:54\nE  unclosetag @62 1:63\nE abcd book @62 1:63\nEOF"
  assert_eq dump("<x:book xmlns:x=\"abcd\" xmlns:y=\"abcd\">one</x:book>", 0), "S x book xmlns:x=\"abcd\" xmlns:y=\"abcd\" @38 1:39\nC \"one\" @41 1:42\nE x book @50 1:51\nEOF"
  assert_eq dump("<x:book xmlns:x=\"abcd\" xmlns:y=\"abcd\">one</x:book>", 1), "S abcd book xmlns:x=\"abcd\" xmlns:y=\"abcd\" @38 1:39\nC \"one\" @41 1:42\nE abcd book @50 1:51\nEOF"
  assert_eq dump("<x:book xmlns:x=\"abcd\" xmlns:y=\"abcd\">one</x:book>", 2), "S abcd book xmlns:x=\"abcd\" xmlns:y=\"abcd\" @38 1:39\nC \"one\" @41 1:42\nE abcd book @50 1:51\nEOF"
  assert_eq dump("<x:book xmlns:x=\"abcd\" xmlns:y=\"abcd\">one</y:book>", 0), "S x book xmlns:x=\"abcd\" xmlns:y=\"abcd\" @38 1:39\nC \"one\" @41 1:42\nE y book @50 1:51\nEOF"
  assert_eq dump("<x:book xmlns:x=\"abcd\" xmlns:y=\"abcd\">one</y:book>", 1), "S abcd book xmlns:x=\"abcd\" xmlns:y=\"abcd\" @38 1:39\nC \"one\" @41 1:42\nERR syntax 1: element <book> in space x closed by </book> in space y"
  assert_eq dump("<x:book xmlns:x=\"abcd\" xmlns:y=\"abcd\">one</y:book>", 2), "S abcd book xmlns:x=\"abcd\" xmlns:y=\"abcd\" @38 1:39\nC \"one\" @41 1:42\nERR syntax 1: element <book> in space x closed by </book> in space y"
  assert_eq dump("<x:book xmlns:y=\"abcd\" xmlns:x=\"abcd\">one</y:book>", 0), "S x book xmlns:y=\"abcd\" xmlns:x=\"abcd\" @38 1:39\nC \"one\" @41 1:42\nE y book @50 1:51\nEOF"
  assert_eq dump("<x:book xmlns:y=\"abcd\" xmlns:x=\"abcd\">one</y:book>", 1), "S abcd book xmlns:y=\"abcd\" xmlns:x=\"abcd\" @38 1:39\nC \"one\" @41 1:42\nERR syntax 1: element <book> in space x closed by </book> in space y"
  assert_eq dump("<x:book xmlns:y=\"abcd\" xmlns:x=\"abcd\">one</y:book>", 2), "S abcd book xmlns:y=\"abcd\" xmlns:x=\"abcd\" @38 1:39\nC \"one\" @41 1:42\nERR syntax 1: element <book> in space x closed by </book> in space y"
  assert_eq dump("<x:book xmlns:x=\"abcd\">one</y:book>", 0), "S x book xmlns:x=\"abcd\" @23 1:24\nC \"one\" @26 1:27\nE y book @35 1:36\nEOF"
  assert_eq dump("<x:book xmlns:x=\"abcd\">one</y:book>", 1), "S abcd book xmlns:x=\"abcd\" @23 1:24\nC \"one\" @26 1:27\nERR syntax 1: element <book> in space x closed by </book> in space y"
  assert_eq dump("<x:book xmlns:x=\"abcd\">one</y:book>", 2), "S abcd book xmlns:x=\"abcd\" @23 1:24\nC \"one\" @26 1:27\nERR syntax 1: element <book> in space x closed by </book> in space y"
  assert_eq dump("<x:book>one</y:book>", 0), "S x book @8 1:9\nC \"one\" @11 1:12\nE y book @20 1:21\nEOF"
  assert_eq dump("<x:book>one</y:book>", 1), "S x book @8 1:9\nC \"one\" @11 1:12\nERR syntax 1: element <book> in space x closed by </book> in space y"
  assert_eq dump("<x:book>one</y:book>", 2), "S x book @8 1:9\nC \"one\" @11 1:12\nERR syntax 1: element <book> in space x closed by </book> in space y"
  assert_eq dump("<xbook>one</ybook>", 0), "S  xbook @7 1:8\nC \"one\" @10 1:11\nE  ybook @18 1:19\nEOF"
  assert_eq dump("<xbook>one</ybook>", 1), "S  xbook @7 1:8\nC \"one\" @10 1:11\nERR syntax 1: element <xbook> closed by </ybook>"
  assert_eq dump("<xbook>one</ybook>", 2), "S  xbook @7 1:8\nC \"one\" @10 1:11\nE  xbook @18 1:19\nERR syntax 1: unexpected end element </ybook>"
  assert_eq dump("<a:te:st xmlns:a=\"abcd\"/>", 0), "ERR syntax 1: expected element name after <"
  assert_eq dump("<a:te:st xmlns:a=\"abcd\"/>", 1), "ERR syntax 1: expected element name after <"
  assert_eq dump("<a:te:st xmlns:a=\"abcd\"/>", 2), "ERR syntax 1: expected element name after <"
  assert_eq dump("<a:te=st xmlns:a=\"abcd\"/>", 0), "ERR syntax 1: expected attribute name in element"
  assert_eq dump("<a:te=st xmlns:a=\"abcd\"/>", 1), "ERR syntax 1: expected attribute name in element"
  assert_eq dump("<a:te=st xmlns:a=\"abcd\"/>", 2), "ERR syntax 1: expected attribute name in element"
  assert_eq dump("<a:te&st xmlns:a=\"abcd\"/>", 0), "ERR syntax 1: expected attribute name in element"
  assert_eq dump("<a:te&st xmlns:a=\"abcd\"/>", 1), "ERR syntax 1: expected attribute name in element"
  assert_eq dump("<a:te&st xmlns:a=\"abcd\"/>", 2), "ERR syntax 1: expected attribute name in element"
  assert_eq dump("<a:test xmlns:a=\"abcd\"/>", 0), "S a test xmlns:a=\"abcd\" @24 1:25\nE a test @24 1:25\nEOF"
  assert_eq dump("<a:test xmlns:a=\"abcd\"/>", 1), "S abcd test xmlns:a=\"abcd\" @24 1:25\nE abcd test @24 1:25\nEOF"
  assert_eq dump("<a:test xmlns:a=\"abcd\"/>", 2), "S abcd test xmlns:a=\"abcd\" @24 1:25\nE abcd test @24 1:25\nEOF"
  assert_eq dump("<foo abc:=\"x\"></foo>", 0), "S  foo :abc:=\"x\" @14 1:15\nE  foo @20 1:21\nEOF"
  assert_eq dump("<foo abc:=\"x\"></foo>", 1), "S  foo :abc:=\"x\" @14 1:15\nE  foo @20 1:21\nEOF"
  assert_eq dump("<foo abc:=\"x\"></foo>", 2), "S  foo :abc:=\"x\" @14 1:15\nE  foo @20 1:21\nEOF"
  assert_eq dump("<!ENTITY x<!<!-- c1 [ \" -->--x --> > <e></e> <!DOCTYPE xxx [ x<!-- c2 \" -->--x ]>", 0), "D \"ENTITY x<! --x --> \" @36 1:37\nC \" \" @37 1:38\nS  e @40 1:41\nE  e @44 1:45\nC \" \" @45 1:46\nD \"DOCTYPE xxx [ x --x ]\" @81 1:82\nEOF"
  assert_eq dump("<!ENTITY x<!<!-- c1 [ \" -->--x --> > <e></e> <!DOCTYPE xxx [ x<!-- c2 \" -->--x ]>", 1), "D \"ENTITY x<! --x --> \" @36 1:37\nC \" \" @37 1:38\nS  e @40 1:41\nE  e @44 1:45\nC \" \" @45 1:46\nD \"DOCTYPE xxx [ x --x ]\" @81 1:82\nEOF"
  assert_eq dump("<!ENTITY x<!<!-- c1 [ \" -->--x --> > <e></e> <!DOCTYPE xxx [ x<!-- c2 \" -->--x ]>", 2), "D \"ENTITY x<! --x --> \" @36 1:37\nC \" \" @37 1:38\nS  e @40 1:41\nE  e @44 1:45\nC \" \" @45 1:46\nD \"DOCTYPE xxx [ x --x ]\" @81 1:82\nEOF"
  assert_eq dump("<a>&\#x41;&\#65;&\#x1F600;&\#xD800;&\#x110000;&\#0;&\#9;&\#xa;</a>", 0), "S  a @3 1:4\nERR syntax 1: invalid character entity &\#x110000;"
  assert_eq dump("<a>&\#x41;&\#65;&\#x1F600;&\#xD800;&\#x110000;&\#0;&\#9;&\#xa;</a>", 1), "S  a @3 1:4\nERR syntax 1: invalid character entity &\#x110000;"
  assert_eq dump("<a>&\#x41;&\#65;&\#x1F600;&\#xD800;&\#x110000;&\#0;&\#9;&\#xa;</a>", 2), "S  a @3 1:4\nERR syntax 1: illegal character code U+0000"
  assert_eq dump("<a>&\#;&\#x;&\#12a;</a>", 0), "S  a @3 1:4\nERR syntax 1: invalid character entity &\#;"
  assert_eq dump("<a>&\#;&\#x;&\#12a;</a>", 1), "S  a @3 1:4\nERR syntax 1: invalid character entity &\#;"
  assert_eq dump("<a>&\#;&\#x;&\#12a;</a>", 2), "S  a @3 1:4\nC \"&\#;&\#x;&\#12a;\" @16 1:17\nE  a @20 1:21\nEOF"
  assert_eq dump("<a b=\"x\ny\r\nz\rw\">1\r\n2\r3\n</a>", 0), "S  a :b=\"x\\ny\\nz\\nw\" @16 3:6\nC \"1\\n2\\n3\\n\" @23 5:1\nE  a @27 5:5\nEOF"
  assert_eq dump("<a b=\"x\ny\r\nz\rw\">1\r\n2\r3\n</a>", 1), "S  a :b=\"x\\ny\\nz\\nw\" @16 3:6\nC \"1\\n2\\n3\\n\" @23 5:1\nE  a @27 5:5\nEOF"
  assert_eq dump("<a b=\"x\ny\r\nz\rw\">1\r\n2\r3\n</a>", 2), "S  a :b=\"x\\ny\\nz\\nw\" @16 3:6\nC \"1\\n2\\n3\\n\" @23 5:1\nE  a @27 5:5\nEOF"
  assert_eq dump("<a\n  b = 'c'\n/>", 0), "S  a :b=\"c\" @15 3:3\nE  a @15 3:3\nEOF"
  assert_eq dump("<a\n  b = 'c'\n/>", 1), "S  a :b=\"c\" @15 3:3\nE  a @15 3:3\nEOF"
  assert_eq dump("<a\n  b = 'c'\n/>", 2), "S  a :b=\"c\" @15 3:3\nE  a @15 3:3\nEOF"
}

test "tokens 6" {
  assert_eq dump("<a b='1' b='2'/>", 0), "S  a :b=\"1\" :b=\"2\" @16 1:17\nE  a @16 1:17\nEOF"
  assert_eq dump("<a b='1' b='2'/>", 1), "S  a :b=\"1\" :b=\"2\" @16 1:17\nE  a @16 1:17\nEOF"
  assert_eq dump("<a b='1' b='2'/>", 2), "S  a :b=\"1\" :b=\"2\" @16 1:17\nE  a @16 1:17\nEOF"
  assert_eq dump("<:a/>", 0), "S  :a @5 1:6\nE  :a @5 1:6\nEOF"
  assert_eq dump("<:a/>", 1), "S  :a @5 1:6\nE  :a @5 1:6\nEOF"
  assert_eq dump("<:a/>", 2), "S  :a @5 1:6\nE  :a @5 1:6\nEOF"
  assert_eq dump("<a:/>", 0), "S  a: @5 1:6\nE  a: @5 1:6\nEOF"
  assert_eq dump("<a:/>", 1), "S  a: @5 1:6\nE  a: @5 1:6\nEOF"
  assert_eq dump("<a:/>", 2), "S  a: @5 1:6\nE  a: @5 1:6\nEOF"
  assert_eq dump("<a::b/>", 0), "ERR syntax 1: expected element name after <"
  assert_eq dump("<a::b/>", 1), "ERR syntax 1: expected element name after <"
  assert_eq dump("<a::b/>", 2), "ERR syntax 1: expected element name after <"
  assert_eq dump("<_a/>", 0), "S  _a @5 1:6\nE  _a @5 1:6\nEOF"
  assert_eq dump("<_a/>", 1), "S  _a @5 1:6\nE  _a @5 1:6\nEOF"
  assert_eq dump("<_a/>", 2), "S  _a @5 1:6\nE  _a @5 1:6\nEOF"
  assert_eq dump("<-a/>", 0), "ERR syntax 1: invalid XML name: -a"
  assert_eq dump("<-a/>", 1), "ERR syntax 1: invalid XML name: -a"
  assert_eq dump("<-a/>", 2), "ERR syntax 1: invalid XML name: -a"
  assert_eq dump("<.a/>", 0), "ERR syntax 1: invalid XML name: .a"
  assert_eq dump("<.a/>", 1), "ERR syntax 1: invalid XML name: .a"
  assert_eq dump("<.a/>", 2), "ERR syntax 1: invalid XML name: .a"
  assert_eq dump("<a.b-c_d/>", 0), "S  a.b-c_d @10 1:11\nE  a.b-c_d @10 1:11\nEOF"
  assert_eq dump("<a.b-c_d/>", 1), "S  a.b-c_d @10 1:11\nE  a.b-c_d @10 1:11\nEOF"
  assert_eq dump("<a.b-c_d/>", 2), "S  a.b-c_d @10 1:11\nE  a.b-c_d @10 1:11\nEOF"
  assert_eq dump("<é/>", 0), "S  é @5 1:6\nE  é @5 1:6\nEOF"
  assert_eq dump("<é/>", 1), "S  é @5 1:6\nE  é @5 1:6\nEOF"
  assert_eq dump("<é/>", 2), "S  é @5 1:6\nE  é @5 1:6\nEOF"
  assert_eq dump("<a é='1'/>", 0), "S  a :é=\"1\" @11 1:12\nE  a @11 1:12\nEOF"
  assert_eq dump("<a é='1'/>", 1), "S  a :é=\"1\" @11 1:12\nE  a @11 1:12\nEOF"
  assert_eq dump("<a é='1'/>", 2), "S  a :é=\"1\" @11 1:12\nE  a @11 1:12\nEOF"
  assert_eq dump("<a>\x00</a>", 0), "S  a @3 1:4\nERR syntax 1: illegal character code U+0000"
  assert_eq dump("<a>\x00</a>", 1), "S  a @3 1:4\nERR syntax 1: illegal character code U+0000"
  assert_eq dump("<a>\x00</a>", 2), "S  a @3 1:4\nERR syntax 1: illegal character code U+0000"
  assert_eq dump(Str.from_bytes([60, 97, 62, 195, 60, 47, 97, 62]), 0), "S  a @3 1:4\nERR syntax 1: invalid UTF-8"
  assert_eq dump(Str.from_bytes([60, 97, 62, 195, 60, 47, 97, 62]), 1), "S  a @3 1:4\nERR syntax 1: invalid UTF-8"
  assert_eq dump(Str.from_bytes([60, 97, 62, 195, 60, 47, 97, 62]), 2), "S  a @3 1:4\nERR syntax 1: invalid UTF-8"
  assert_eq dump(Str.from_bytes([60, 97, 32, 98, 61, 39, 255, 39, 47, 62]), 0), "ERR syntax 1: invalid UTF-8"
  assert_eq dump(Str.from_bytes([60, 97, 32, 98, 61, 39, 255, 39, 47, 62]), 1), "ERR syntax 1: invalid UTF-8"
  assert_eq dump(Str.from_bytes([60, 97, 32, 98, 61, 39, 255, 39, 47, 62]), 2), "ERR syntax 1: invalid UTF-8"
  assert_eq dump("<a></a><b></b>", 0), "S  a @3 1:4\nE  a @7 1:8\nS  b @10 1:11\nE  b @14 1:15\nEOF"
  assert_eq dump("<a></a><b></b>", 1), "S  a @3 1:4\nE  a @7 1:8\nS  b @10 1:11\nE  b @14 1:15\nEOF"
  assert_eq dump("<a></a><b></b>", 2), "S  a @3 1:4\nE  a @7 1:8\nS  b @10 1:11\nE  b @14 1:15\nEOF"
  assert_eq dump("<a/>trailing", 0), "S  a @4 1:5\nE  a @4 1:5\nC \"trailing\" @12 1:13\nEOF"
  assert_eq dump("<a/>trailing", 1), "S  a @4 1:5\nE  a @4 1:5\nC \"trailing\" @12 1:13\nEOF"
  assert_eq dump("<a/>trailing", 2), "S  a @4 1:5\nE  a @4 1:5\nC \"trailing\" @12 1:13\nEOF"
  assert_eq dump("text only", 0), "C \"text only\" @9 1:10\nEOF"
  assert_eq dump("text only", 1), "C \"text only\" @9 1:10\nEOF"
  assert_eq dump("text only", 2), "C \"text only\" @9 1:10\nEOF"
  assert_eq dump("", 0), "EOF"
  assert_eq dump("", 1), "EOF"
  assert_eq dump("", 2), "EOF"
  assert_eq dump("   ", 0), "C \"   \" @3 1:4\nEOF"
  assert_eq dump("   ", 1), "C \"   \" @3 1:4\nEOF"
  assert_eq dump("   ", 2), "C \"   \" @3 1:4\nEOF"
  assert_eq dump("<a><!----></a>", 0), "S  a @3 1:4\nM \"\" @10 1:11\nE  a @14 1:15\nEOF"
  assert_eq dump("<a><!----></a>", 1), "S  a @3 1:4\nM \"\" @10 1:11\nE  a @14 1:15\nEOF"
  assert_eq dump("<a><!----></a>", 2), "S  a @3 1:4\nM \"\" @10 1:11\nE  a @14 1:15\nEOF"
  assert_eq dump("<a><!-- - --></a>", 0), "S  a @3 1:4\nM \" - \" @13 1:14\nE  a @17 1:18\nEOF"
  assert_eq dump("<a><!-- - --></a>", 1), "S  a @3 1:4\nM \" - \" @13 1:14\nE  a @17 1:18\nEOF"
  assert_eq dump("<a><!-- - --></a>", 2), "S  a @3 1:4\nM \" - \" @13 1:14\nE  a @17 1:18\nEOF"
}

test "tokens 7" {
  assert_eq dump("<a><!-----></a>", 0), "S  a @3 1:4\nERR syntax 1: invalid sequence \"--\" not allowed in comments"
  assert_eq dump("<a><!-----></a>", 1), "S  a @3 1:4\nERR syntax 1: invalid sequence \"--\" not allowed in comments"
  assert_eq dump("<a><!-----></a>", 2), "S  a @3 1:4\nERR syntax 1: invalid sequence \"--\" not allowed in comments"
  assert_eq dump("<a><?pi?></a>", 0), "S  a @3 1:4\nP pi \"\" @9 1:10\nE  a @13 1:14\nEOF"
  assert_eq dump("<a><?pi?></a>", 1), "S  a @3 1:4\nP pi \"\" @9 1:10\nE  a @13 1:14\nEOF"
  assert_eq dump("<a><?pi?></a>", 2), "S  a @3 1:4\nP pi \"\" @9 1:10\nE  a @13 1:14\nEOF"
  assert_eq dump("<a><?pi  x ?></a>", 0), "S  a @3 1:4\nP pi \"x \" @13 1:14\nE  a @17 1:18\nEOF"
  assert_eq dump("<a><?pi  x ?></a>", 1), "S  a @3 1:4\nP pi \"x \" @13 1:14\nE  a @17 1:18\nEOF"
  assert_eq dump("<a><?pi  x ?></a>", 2), "S  a @3 1:4\nP pi \"x \" @13 1:14\nE  a @17 1:18\nEOF"
  assert_eq dump("<?xml?>", 0), "P xml \"\" @7 1:8\nEOF"
  assert_eq dump("<?xml?>", 1), "P xml \"\" @7 1:8\nEOF"
  assert_eq dump("<?xml?>", 2), "P xml \"\" @7 1:8\nEOF"
  assert_eq dump("<?xml version='1.0'?>", 0), "P xml \"version='1.0'\" @21 1:22\nEOF"
  assert_eq dump("<?xml version='1.0'?>", 1), "P xml \"version='1.0'\" @21 1:22\nEOF"
  assert_eq dump("<?xml version='1.0'?>", 2), "P xml \"version='1.0'\" @21 1:22\nEOF"
  assert_eq dump("<?xml version=\"2.0\"?>", 0), "ERR xml: unsupported version \"2.0\"; only version 1.0 is supported"
  assert_eq dump("<?xml version=\"2.0\"?>", 1), "ERR xml: unsupported version \"2.0\"; only version 1.0 is supported"
  assert_eq dump("<?xml version=\"2.0\"?>", 2), "ERR xml: unsupported version \"2.0\"; only version 1.0 is supported"
  assert_eq dump("<a><![CDATA[]]></a>", 0), "S  a @3 1:4\nC \"\" @15 1:16\nE  a @19 1:20\nEOF"
  assert_eq dump("<a><![CDATA[]]></a>", 1), "S  a @3 1:4\nC \"\" @15 1:16\nE  a @19 1:20\nEOF"
  assert_eq dump("<a><![CDATA[]]></a>", 2), "S  a @3 1:4\nC \"\" @15 1:16\nE  a @19 1:20\nEOF"
  assert_eq dump("<a><![CDATA[]]]]></a>", 0), "S  a @3 1:4\nC \"]]\" @17 1:18\nE  a @21 1:22\nEOF"
  assert_eq dump("<a><![CDATA[]]]]></a>", 1), "S  a @3 1:4\nC \"]]\" @17 1:18\nE  a @21 1:22\nEOF"
  assert_eq dump("<a><![CDATA[]]]]></a>", 2), "S  a @3 1:4\nC \"]]\" @17 1:18\nE  a @21 1:22\nEOF"
  assert_eq dump("<a><![CDATA[x]]]></a>", 0), "S  a @3 1:4\nC \"x]\" @17 1:18\nE  a @21 1:22\nEOF"
  assert_eq dump("<a><![CDATA[x]]]></a>", 1), "S  a @3 1:4\nC \"x]\" @17 1:18\nE  a @21 1:22\nEOF"
  assert_eq dump("<a><![CDATA[x]]]></a>", 2), "S  a @3 1:4\nC \"x]\" @17 1:18\nE  a @21 1:22\nEOF"
  assert_eq dump("<a><![CDATA[<b>&amp;</b>]]></a>", 0), "S  a @3 1:4\nC \"<b>&amp;</b>\" @27 1:28\nE  a @31 1:32\nEOF"
  assert_eq dump("<a><![CDATA[<b>&amp;</b>]]></a>", 1), "S  a @3 1:4\nC \"<b>&amp;</b>\" @27 1:28\nE  a @31 1:32\nEOF"
  assert_eq dump("<a><![CDATA[<b>&amp;</b>]]></a>", 2), "S  a @3 1:4\nC \"<b>&amp;</b>\" @27 1:28\nE  a @31 1:32\nEOF"
  assert_eq dump("<a>]]</a>", 0), "S  a @3 1:4\nC \"]]\" @5 1:6\nE  a @9 1:10\nEOF"
  assert_eq dump("<a>]]</a>", 1), "S  a @3 1:4\nC \"]]\" @5 1:6\nE  a @9 1:10\nEOF"
  assert_eq dump("<a>]]</a>", 2), "S  a @3 1:4\nC \"]]\" @5 1:6\nE  a @9 1:10\nEOF"
  assert_eq dump("<a>]></a>", 0), "S  a @3 1:4\nC \"]>\" @5 1:6\nE  a @9 1:10\nEOF"
  assert_eq dump("<a>]></a>", 1), "S  a @3 1:4\nC \"]>\" @5 1:6\nE  a @9 1:10\nEOF"
  assert_eq dump("<a>]></a>", 2), "S  a @3 1:4\nC \"]>\" @5 1:6\nE  a @9 1:10\nEOF"
  assert_eq dump("<a>]]]></a>", 0), "S  a @3 1:4\nERR syntax 1: unescaped ]]> not in CDATA section"
  assert_eq dump("<a>]]]></a>", 1), "S  a @3 1:4\nERR syntax 1: unescaped ]]> not in CDATA section"
  assert_eq dump("<a>]]]></a>", 2), "S  a @3 1:4\nERR syntax 1: unescaped ]]> not in CDATA section"
  assert_eq dump("<a b=\"&lt;&gt;&amp;&apos;&quot;\"/>", 0), "S  a :b=\"<>&'\\\"\" @34 1:35\nE  a @34 1:35\nEOF"
  assert_eq dump("<a b=\"&lt;&gt;&amp;&apos;&quot;\"/>", 1), "S  a :b=\"<>&'\\\"\" @34 1:35\nE  a @34 1:35\nEOF"
  assert_eq dump("<a b=\"&lt;&gt;&amp;&apos;&quot;\"/>", 2), "S  a :b=\"<>&'\\\"\" @34 1:35\nE  a @34 1:35\nEOF"
  assert_eq dump("<a b='&\#60;'/>", 0), "S  a :b=\"<\" @14 1:15\nE  a @14 1:15\nEOF"
  assert_eq dump("<a b='&\#60;'/>", 1), "S  a :b=\"<\" @14 1:15\nE  a @14 1:15\nEOF"
  assert_eq dump("<a b='&\#60;'/>", 2), "S  a :b=\"<\" @14 1:15\nE  a @14 1:15\nEOF"
  assert_eq dump("<a b='&nbsp;'/>", 0), "ERR syntax 1: invalid character entity &nbsp;"
  assert_eq dump("<a b='&nbsp;'/>", 1), "ERR syntax 1: invalid character entity &nbsp;"
  assert_eq dump("<a b='&nbsp;'/>", 2), "S  a :b=\"\\u00a0\" @15 1:16\nE  a @15 1:16\nEOF"
  assert_eq dump("<a>&nbsp;&copy;&euro;&hellip;</a>", 0), "S  a @3 1:4\nERR syntax 1: invalid character entity &nbsp;"
  assert_eq dump("<a>&nbsp;&copy;&euro;&hellip;</a>", 1), "S  a @3 1:4\nERR syntax 1: invalid character entity &nbsp;"
  assert_eq dump("<a>&nbsp;&copy;&euro;&hellip;</a>", 2), "S  a @3 1:4\nC \"\\u00a0©€…\" @29 1:30\nE  a @33 1:34\nEOF"
  assert_eq dump("<A><b></B></a>", 0), "S  A @3 1:4\nS  b @6 1:7\nE  B @10 1:11\nE  a @14 1:15\nEOF"
  assert_eq dump("<A><b></B></a>", 1), "S  A @3 1:4\nS  b @6 1:7\nERR syntax 1: element <b> closed by </B>"
  assert_eq dump("<A><b></B></a>", 2), "S  A @3 1:4\nS  b @6 1:7\nE  b @10 1:11\nE  A @10 1:11\nERR syntax 1: unexpected end element </B>"
  assert_eq dump("<a><b></a>", 0), "S  a @3 1:4\nS  b @6 1:7\nE  a @10 1:11\nEOF"
  assert_eq dump("<a><b></a>", 1), "S  a @3 1:4\nS  b @6 1:7\nERR syntax 1: element <b> closed by </a>"
  assert_eq dump("<a><b></a>", 2), "S  a @3 1:4\nS  b @6 1:7\nE  b @10 1:11\nE  a @10 1:11\nEOF"
  assert_eq dump("<html><body><p>one<p>two</body></html>", 0), "S  html @6 1:7\nS  body @12 1:13\nS  p @15 1:16\nC \"one\" @18 1:19\nS  p @21 1:22\nC \"two\" @24 1:25\nE  body @31 1:32\nE  html @38 1:39\nEOF"
  assert_eq dump("<html><body><p>one<p>two</body></html>", 1), "S  html @6 1:7\nS  body @12 1:13\nS  p @15 1:16\nC \"one\" @18 1:19\nS  p @21 1:22\nC \"two\" @24 1:25\nERR syntax 1: element <p> closed by </body>"
  assert_eq dump("<html><body><p>one<p>two</body></html>", 2), "S  html @6 1:7\nS  body @12 1:13\nS  p @15 1:16\nC \"one\" @18 1:19\nS  p @21 1:22\nC \"two\" @24 1:25\nE  p @31 1:32\nE  p @31 1:32\nE  body @31 1:32\nE  html @38 1:39\nEOF"
}

test "tokens 8" {
  assert_eq dump("<br><br/><img src=x><hr></hr>", 0), "S  br @4 1:5\nS  br @9 1:10\nE  br @9 1:10\nERR syntax 1: unquoted or missing attribute value in element"
  assert_eq dump("<br><br/><img src=x><hr></hr>", 1), "S  br @4 1:5\nS  br @9 1:10\nE  br @9 1:10\nERR syntax 1: unquoted or missing attribute value in element"
  assert_eq dump("<br><br/><img src=x><hr></hr>", 2), "S  br @4 1:5\nE  br @9 1:10\nS  br @9 1:10\nE  br @9 1:10\nS  img :src=\"x\" @20 1:21\nE  img @24 1:25\nS  hr @24 1:25\nE  hr @29 1:30\nEOF"
  assert_eq dump("<BR><Img>", 0), "S  BR @4 1:5\nS  Img @9 1:10\nEOF"
  assert_eq dump("<BR><Img>", 1), "S  BR @4 1:5\nS  Img @9 1:10\nERR syntax 1: unexpected EOF"
  assert_eq dump("<BR><Img>", 2), "S  BR @4 1:5\nE  BR @9 1:10\nS  Img @9 1:10\nERR syntax 1: unexpected EOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=\"1\" y=\"2\"><p:b q:z=\"3\"><c xmlns=\"d2\" xmlns:p=\"u3\"><p:d/></c><p:e xml:lang=\"en\"/></p:b><q:f xmlns:q=\"\"/></a>", 0), "S  a :xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=\"1\" :y=\"2\" @54 1:55\nS p b q:z=\"3\" @67 1:68\nS  c :xmlns=\"d2\" xmlns:p=\"u3\" @94 1:95\nS p d @100 1:101\nE p d @100 1:101\nE  c @104 1:105\nS p e xml:lang=\"en\" @124 1:125\nE p e @124 1:125\nE p b @130 1:131\nS q f xmlns:q=\"\" @147 1:148\nE q f @147 1:148\nE  a @151 1:152\nEOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=\"1\" y=\"2\"><p:b q:z=\"3\"><c xmlns=\"d2\" xmlns:p=\"u3\"><p:d/></c><p:e xml:lang=\"en\"/></p:b><q:f xmlns:q=\"\"/></a>", 1), "S d1 a :xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" u1:x=\"1\" :y=\"2\" @54 1:55\nS u1 b u2:z=\"3\" @67 1:68\nS d2 c :xmlns=\"d2\" xmlns:p=\"u3\" @94 1:95\nS u3 d @100 1:101\nE u3 d @100 1:101\nE d2 c @104 1:105\nS u1 e http://www.w3.org/XML/1998/namespace:lang=\"en\" @124 1:125\nE u1 e @124 1:125\nE u1 b @130 1:131\nS  f xmlns:q=\"\" @147 1:148\nE  f @147 1:148\nE d1 a @151 1:152\nEOF"
  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=\"1\" y=\"2\"><p:b q:z=\"3\"><c xmlns=\"d2\" xmlns:p=\"u3\"><p:d/></c><p:e xml:lang=\"en\"/></p:b><q:f xmlns:q=\"\"/></a>", 2), "S d1 a :xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" u1:x=\"1\" :y=\"2\" @54 1:55\nS u1 b u2:z=\"3\" @67 1:68\nS d2 c :xmlns=\"d2\" xmlns:p=\"u3\" @94 1:95\nS u3 d @100 1:101\nE u3 d @100 1:101\nE d2 c @104 1:105\nS u1 e http://www.w3.org/XML/1998/namespace:lang=\"en\" @124 1:125\nE u1 e @124 1:125\nE u1 b @130 1:131\nS  f xmlns:q=\"\" @147 1:148\nE  f @147 1:148\nE d1 a @151 1:152\nEOF"
  assert_eq dump("", 1), "EOF"
  assert_eq dump("<", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?x", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xm", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml ", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml v", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml ve", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml ver", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml vers", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml versi", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml versio", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?", 1), "ERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?>", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nEOF"
  assert_eq dump("<?xml version=\"1.0\"?><", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!D", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DO", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOC", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCT", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTY", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYP", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE ", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d ", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!E", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!EN", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENT", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTI", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTIT", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY ", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e ", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\"", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nERR syntax 1: unexpected EOF"
}

test "tokens 9" {
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]>", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nEOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a ", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\"", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" ", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y=", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'>", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'><", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'><!", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'><!-", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'><!--", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'><!-- ", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'><!-- c", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nERR syntax 1: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\"?><!DOCTYPE d [<!ENTITY e \"x\">]><a x=\"1\" y='2'><!-- c ", 1), "P xml \"version=\\\"1.0\\\"\" @21 1:22\nD \"DOCTYPE d [<!ENTITY e \\\"x\\\">]\" @51 1:52\nS  a :x=\"1\" :y=\"2\" @66 1:67\nERR syntax 1: unexpected EOF"
