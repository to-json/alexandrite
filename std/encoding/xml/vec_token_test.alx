# Generated from Go's encoding/xml (1.27.1, the tokenizer over many inputs); do not edit by hand.
# Each case: dump(input, mode) as Go's Decoder reads it (mode 0 RawToken, 1 Token, 2 Token with
# Strict off and HTML auto-close/entities): tokens with InputOffset and InputPos, then EOF or the error.

test "tokens 1" {
  assert_eq dump("\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\"\n  \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<body xmlns:foo=\"ns1\" xmlns=\"ns2\" xmlns:tag=\"ns3\" \r\n\t  >\n  <hello lang=\"en\">World &lt;&gt;&apos;&quot; &\#x767d;&\#40300;翔</hello>\n  <query>&amp; &lt;</query>\n  <goodbye />\n  <outer foo:attr=\"value\" xmlns:tag=\"ns4\">\n    <inner/>\n  </outer>\n  <tag:name>\n    <![CDATA[Some text here.]]>\n  </tag:name>\n</body><!-- missing final newline -->", 0), "C \"\\n\" @1 2:1\nP xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @39 2:39\nC \"\\n\" @40 3:1\nD \"DOCTYPE html PUBLIC \\\"-//W3C//DTD XHTML 1.0 Transitional//EN\\\"\\n  \\\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\\"\" @163 4:61\nC \"\\n\" @164 5:1\nS  body xmlns:foo=\"ns1\" :xmlns=\"ns2\" xmlns:tag=\"ns3\" @220 6:5\nC \"\\n  \" @223 7:3\nS  hello :lang=\"en\" @240 7:20\nC \"World <>'\\\" 白鵬翔\" @286 7:66\nE  hello @294 7:74\nC \"\\n  \" @297 8:3\nS  query @304 8:10\nC \"& <\" @314 8:20\nE  query @322 8:28\nC \"\\n  \" @325 9:3\nS  goodbye @336 9:14\nE  goodbye @336 9:14\nC \"\\n  \" @339 10:3\nS  outer foo:attr=\"value\" xmlns:tag=\"ns4\" @379 10:43\nC \"\\n    \" @384 11:5\nS  inner @392 11:13\nE  inner @392 11:13\nC \"\\n  \" @395 12:3\nE  outer @403 12:11\nC \"\\n  \" @406 13:3\nS tag name @416 13:13\nC \"\\n    \" @421 14:5\nC \"Some text here.\" @448 14:32\nC \"\\n  \" @451 15:3\nE tag name @462 15:14\nC \"\\n\" @463 16:1\nE  body @470 16:8\nM \" missing final newline \" @500 16:38\nEOF"
  assert_eq dump("\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\"\n  \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<body xmlns:foo=\"ns1\" xmlns=\"ns2\" xmlns:tag=\"ns3\" \r\n\t  >\n  <hello lang=\"en\">World &lt;&gt;&apos;&quot; &\#x767d;&\#40300;翔</hello>\n  <query>&amp; &lt;</query>\n  <goodbye />\n  <outer foo:attr=\"value\" xmlns:tag=\"ns4\">\n    <inner/>\n  </outer>\n  <tag:name>\n    <![CDATA[Some text here.]]>\n  </tag:name>\n</body><!-- missing final newline -->", 1), "C \"\\n\" @1 2:1\nP xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @39 2:39\nC \"\\n\" @40 3:1\nD \"DOCTYPE html PUBLIC \\\"-//W3C//DTD XHTML 1.0 Transitional//EN\\\"\\n  \\\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\\"\" @163 4:61\nC \"\\n\" @164 5:1\nS ns2 body xmlns:foo=\"ns1\" :xmlns=\"ns2\" xmlns:tag=\"ns3\" @220 6:5\nC \"\\n  \" @223 7:3\nS ns2 hello :lang=\"en\" @240 7:20\nC \"World <>'\\\" 白鵬翔\" @286 7:66\nE ns2 hello @294 7:74\nC \"\\n  \" @297 8:3\nS ns2 query @304 8:10\nC \"& <\" @314 8:20\nE ns2 query @322 8:28\nC \"\\n  \" @325 9:3\nS ns2 goodbye @336 9:14\nE ns2 goodbye @336 9:14\nC \"\\n  \" @339 10:3\nS ns2 outer ns1:attr=\"value\" xmlns:tag=\"ns4\" @379 10:43\nC \"\\n    \" @384 11:5\nS ns2 inner @392 11:13\nE ns2 inner @392 11:13\nC \"\\n  \" @395 12:3\nE ns2 outer @403 12:11\nC \"\\n  \" @406 13:3\nS ns3 name @416 13:13\nC \"\\n    \" @421 14:5\nC \"Some text here.\" @448 14:32\nC \"\\n  \" @451 15:3\nE ns3 name @462 15:14\nC \"\\n\" @463 16:1\nE ns2 body @470 16:8\nM \" missing final newline \" @500 16:38\nEOF"
  assert_eq dump("\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\"\n  \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<body xmlns:foo=\"ns1\" xmlns=\"ns2\" xmlns:tag=\"ns3\" \r\n\t  >\n  <hello lang=\"en\">World &lt;&gt;&apos;&quot; &\#x767d;&\#40300;翔</hello>\n  <query>&amp; &lt;</query>\n  <goodbye />\n  <outer foo:attr=\"value\" xmlns:tag=\"ns4\">\n    <inner/>\n  </outer>\n  <tag:name>\n    <![CDATA[Some text here.]]>\n  </tag:name>\n</body><!-- missing final newline -->", 2), "C \"\\n\" @1 2:1\nP xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @39 2:39\nC \"\\n\" @40 3:1\nD \"DOCTYPE html PUBLIC \\\"-//W3C//DTD XHTML 1.0 Transitional//EN\\\"\\n  \\\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\\"\" @163 4:61\nC \"\\n\" @164 5:1\nS ns2 body xmlns:foo=\"ns1\" :xmlns=\"ns2\" xmlns:tag=\"ns3\" @220 6:5\nC \"\\n  \" @223 7:3\nS ns2 hello :lang=\"en\" @240 7:20\nC \"World <>'\\\" 白鵬翔\" @286 7:66\nE ns2 hello @294 7:74\nC \"\\n  \" @297 8:3\nS ns2 query @304 8:10\nC \"& <\" @314 8:20\nE ns2 query @322 8:28\nC \"\\n  \" @325 9:3\nS ns2 goodbye @336 9:14\nE ns2 goodbye @336 9:14\nC \"\\n  \" @339 10:3\nS ns2 outer ns1:attr=\"value\" xmlns:tag=\"ns4\" @379 10:43\nC \"\\n    \" @384 11:5\nS ns2 inner @392 11:13\nE ns2 inner @392 11:13\nC \"\\n  \" @395 12:3\nE ns2 outer @403 12:11\nC \"\\n  \" @406 13:3\nS ns3 name @416 13:13\nC \"\\n    \" @421 14:5\nC \"Some text here.\" @448 14:32\nC \"\\n  \" @451 15:3\nE ns3 name @462 15:14\nC \"\\n\" @463 16:1\nE ns2 body @470 16:8\nM \" missing final newline \" @500 16:38\nEOF"
  assert_eq dump("\n<tag>non&entity</tag>\n<tag>&unknown;entity</tag>\n<tag>&\#123</tag>\n<tag>&\#zzz;</tag>\n<tag>&なまえ3;</tag>\n<tag>&lt-gt;</tag>\n<tag>&;</tag>\n<tag>&0a;</tag>\n", 0), "C \"\\n\" @1 2:1\nS  tag @6 2:6\nERR syntax 2: invalid character entity &entity (no semicolon)"
  assert_eq dump("\n<tag>non&entity</tag>\n<tag>&unknown;entity</tag>\n<tag>&\#123</tag>\n<tag>&\#zzz;</tag>\n<tag>&なまえ3;</tag>\n<tag>&lt-gt;</tag>\n<tag>&;</tag>\n<tag>&0a;</tag>\n", 1), "C \"\\n\" @1 2:1\nS  tag @6 2:6\nERR syntax 2: invalid character entity &entity (no semicolon)"
  assert_eq dump("\n<tag>non&entity</tag>\n<tag>&unknown;entity</tag>\n<tag>&\#123</tag>\n<tag>&\#zzz;</tag>\n<tag>&なまえ3;</tag>\n<tag>&lt-gt;</tag>\n<tag>&;</tag>\n<tag>&0a;</tag>\n", 2), "C \"\\n\" @1 2:1\nS  tag @6 2:6\nC \"non&entity\" @16 2:16\nE  tag @22 2:22\nC \"\\n\" @23 3:1\nS  tag @28 3:6\nC \"&unknown;entity\" @43 3:21\nE  tag @49 3:27\nC \"\\n\" @50 4:1\nS  tag @55 4:6\nC \"&\#123\" @60 4:11\nE  tag @66 4:17\nC \"\\n\" @67 5:1\nS  tag @72 5:6\nC \"&\#zzz;\" @78 5:12\nE  tag @84 5:18\nC \"\\n\" @85 6:1\nS  tag @90 6:6\nC \"&なまえ3;\" @102 6:18\nE  tag @108 6:24\nC \"\\n\" @109 7:1\nS  tag @114 7:6\nC \"&lt-gt;\" @121 7:13\nE  tag @127 7:19\nC \"\\n\" @128 8:1\nS  tag @133 8:6\nC \"&;\" @135 8:8\nE  tag @141 8:14\nC \"\\n\" @142 9:1\nS  tag @147 9:6\nC \"&0a;\" @151 9:10\nE  tag @157 9:16\nC \"\\n\" @158 10:1\nEOF"
  assert_eq dump("\n<!DOCTYPE [<!ENTITY rdf \"http://www.w3.org/1999/02/22-rdf-syntax-ns\#\">]>\n<!DOCTYPE [<!ENTITY xlt \">\">]>\n<!DOCTYPE [<!ENTITY xlt \"<\">]>\n<!DOCTYPE [<!ENTITY xlt '>'>]>\n<!DOCTYPE [<!ENTITY xlt '<'>]>\n<!DOCTYPE [<!ENTITY xlt '\">'>]>\n<!DOCTYPE [<!ENTITY xlt \"'<\">]>\n", 0), "C \"\\n\" @1 2:1\nD \"DOCTYPE [<!ENTITY rdf \\\"http://www.w3.org/1999/02/22-rdf-syntax-ns\#\\\">]\" @73 2:73\nC \"\\n\" @74 3:1\nD \"DOCTYPE [<!ENTITY xlt \\\">\\\">]\" @104 3:31\nC \"\\n\" @105 4:1\nD \"DOCTYPE [<!ENTITY xlt \\\"<\\\">]\" @135 4:31\nC \"\\n\" @136 5:1\nD \"DOCTYPE [<!ENTITY xlt '>'>]\" @166 5:31\nC \"\\n\" @167 6:1\nD \"DOCTYPE [<!ENTITY xlt '<'>]\" @197 6:31\nC \"\\n\" @198 7:1\nD \"DOCTYPE [<!ENTITY xlt '\\\">'>]\" @229 7:32\nC \"\\n\" @230 8:1\nD \"DOCTYPE [<!ENTITY xlt \\\"'<\\\">]\" @261 8:32\nC \"\\n\" @262 9:1\nEOF"
  assert_eq dump("\n<!DOCTYPE [<!ENTITY rdf \"http://www.w3.org/1999/02/22-rdf-syntax-ns\#\">]>\n<!DOCTYPE [<!ENTITY xlt \">\">]>\n<!DOCTYPE [<!ENTITY xlt \"<\">]>\n<!DOCTYPE [<!ENTITY xlt '>'>]>\n<!DOCTYPE [<!ENTITY xlt '<'>]>\n<!DOCTYPE [<!ENTITY xlt '\">'>]>\n<!DOCTYPE [<!ENTITY xlt \"'<\">]>\n", 1), "C \"\\n\" @1 2:1\nD \"DOCTYPE [<!ENTITY rdf \\\"http://www.w3.org/1999/02/22-rdf-syntax-ns\#\\\">]\" @73 2:73\nC \"\\n\" @74 3:1\nD \"DOCTYPE [<!ENTITY xlt \\\">\\\">]\" @104 3:31\nC \"\\n\" @105 4:1\nD \"DOCTYPE [<!ENTITY xlt \\\"<\\\">]\" @135 4:31\nC \"\\n\" @136 5:1\nD \"DOCTYPE [<!ENTITY xlt '>'>]\" @166 5:31\nC \"\\n\" @167 6:1\nD \"DOCTYPE [<!ENTITY xlt '<'>]\" @197 6:31\nC \"\\n\" @198 7:1\nD \"DOCTYPE [<!ENTITY xlt '\\\">'>]\" @229 7:32\nC \"\\n\" @230 8:1\nD \"DOCTYPE [<!ENTITY xlt \\\"'<\\\">]\" @261 8:32\nC \"\\n\" @262 9:1\nEOF"
  assert_eq dump("\n<!DOCTYPE [<!ENTITY rdf \"http://www.w3.org/1999/02/22-rdf-syntax-ns\#\">]>\n<!DOCTYPE [<!ENTITY xlt \">\">]>\n<!DOCTYPE [<!ENTITY xlt \"<\">]>\n<!DOCTYPE [<!ENTITY xlt '>'>]>\n<!DOCTYPE [<!ENTITY xlt '<'>]>\n<!DOCTYPE [<!ENTITY xlt '\">'>]>\n<!DOCTYPE [<!ENTITY xlt \"'<\">]>\n", 2), "C \"\\n\" @1 2:1\nD \"DOCTYPE [<!ENTITY rdf \\\"http://www.w3.org/1999/02/22-rdf-syntax-ns\#\\\">]\" @73 2:73\nC \"\\n\" @74 3:1\nD \"DOCTYPE [<!ENTITY xlt \\\">\\\">]\" @104 3:31\nC \"\\n\" @105 4:1\nD \"DOCTYPE [<!ENTITY xlt \\\"<\\\">]\" @135 4:31\nC \"\\n\" @136 5:1\nD \"DOCTYPE [<!ENTITY xlt '>'>]\" @166 5:31\nC \"\\n\" @167 6:1\nD \"DOCTYPE [<!ENTITY xlt '<'>]\" @197 6:31\nC \"\\n\" @198 7:1\nD \"DOCTYPE [<!ENTITY xlt '\\\">'>]\" @229 7:32\nC \"\\n\" @230 8:1\nD \"DOCTYPE [<!ENTITY xlt \\\"'<\\\">]\" @261 8:32\nC \"\\n\" @262 9:1\nEOF"
  assert_eq dump("\n<!DOCTYPE [<!-- a comment --><!ENTITY rdf \"http://www.w3.org/1999/02/22-rdf-syntax-ns\#\">]>\n<!DOCTYPE [<!ENTITY go \"Golang\"><!-- a comment-->]>\n<!DOCTYPE <!-> <!> <!----> <!-->--> <!--->--> [<!ENTITY go \"Golang\"><!-- a comment-->]>\n", 0), "C \"\\n\" @1 2:1\nD \"DOCTYPE [ <!ENTITY rdf \\\"http://www.w3.org/1999/02/22-rdf-syntax-ns\#\\\">]\" @91 2:91\nC \"\\n\" @92 3:1\nD \"DOCTYPE [<!ENTITY go \\\"Golang\\\"> ]\" @143 3:52\nC \"\\n\" @144 4:1\nD \"DOCTYPE <!-> <!>       [<!ENTITY go \\\"Golang\\\"> ]\" @231 4:88\nC \"\\n\" @232 5:1\nEOF"
  assert_eq dump("\n<!DOCTYPE [<!-- a comment --><!ENTITY rdf \"http://www.w3.org/1999/02/22-rdf-syntax-ns\#\">]>\n<!DOCTYPE [<!ENTITY go \"Golang\"><!-- a comment-->]>\n<!DOCTYPE <!-> <!> <!----> <!-->--> <!--->--> [<!ENTITY go \"Golang\"><!-- a comment-->]>\n", 1), "C \"\\n\" @1 2:1\nD \"DOCTYPE [ <!ENTITY rdf \\\"http://www.w3.org/1999/02/22-rdf-syntax-ns\#\\\">]\" @91 2:91\nC \"\\n\" @92 3:1\nD \"DOCTYPE [<!ENTITY go \\\"Golang\\\"> ]\" @143 3:52\nC \"\\n\" @144 4:1\nD \"DOCTYPE <!-> <!>       [<!ENTITY go \\\"Golang\\\"> ]\" @231 4:88\nC \"\\n\" @232 5:1\nEOF"
