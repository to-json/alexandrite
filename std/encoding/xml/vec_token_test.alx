  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<br>\n<br/><br/>\n<br><br>\n<br></br>\n<BR>\n<BR/><BR/>\n<Br></Br>\n<BR><span id=\"test\">abc</span><br/><br/>", 1), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nC \"\\n\" @39 2:1\nS  br @43 2:5\nC \"\\n\" @44 3:1\nS  br @49 3:6\nE  br @49 3:6\nS  br @54 3:11\nE  br @54 3:11\nC \"\\n\" @55 4:1\nS  br @59 4:5\nS  br @63 4:9\nC \"\\n\" @64 5:1\nS  br @68 5:5\nE  br @73 5:10\nC \"\\n\" @74 6:1\nS  BR @78 6:5\nC \"\\n\" @79 7:1\nS  BR @84 7:6\nE  BR @84 7:6\nS  BR @89 7:11\nE  BR @89 7:11\nC \"\\n\" @90 8:1\nS  Br @94 8:5\nE  Br @99 8:10\nC \"\\n\" @100 9:1\nS  BR @104 9:5\nS  span :id=\"test\" @120 9:21\nC \"abc\" @123 9:24\nE  span @130 9:31\nS  br @135 9:36\nE  br @135 9:36\nS  br @140 9:41\nE  br @140 9:41\nERR syntax 9: unexpected EOF"
  assert_eq dump("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<br>\n<br/><br/>\n<br><br>\n<br></br>\n<BR>\n<BR/><BR/>\n<Br></Br>\n<BR><span id=\"test\">abc</span><br/><br/>", 2), "P xml \"version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"\" @38 1:39\nC \"\\n\" @39 2:1\nS  br @43 2:5\nE  br @44 3:1\nC \"\\n\" @44 3:1\nS  br @49 3:6\nE  br @49 3:6\nS  br @54 3:11\nE  br @54 3:11\nC \"\\n\" @55 4:1\nS  br @59 4:5\nE  br @63 4:9\nS  br @63 4:9\nE  br @64 5:1\nC \"\\n\" @64 5:1\nS  br @68 5:5\nE  br @73 5:10\nC \"\\n\" @74 6:1\nS  BR @78 6:5\nE  BR @79 7:1\nC \"\\n\" @79 7:1\nS  BR @84 7:6\nE  BR @84 7:6\nS  BR @89 7:11\nE  BR @89 7:11\nC \"\\n\" @90 8:1\nS  Br @94 8:5\nE  Br @99 8:10\nC \"\\n\" @100 9:1\nS  BR @104 9:5\nE  BR @120 9:21\nS  span :id=\"test\" @120 9:21\nC \"abc\" @123 9:24\nE  span @130 9:31\nS  br @135 9:36\nE  br @135 9:36\nS  br @140 9:41\nE  br @140 9:41\nEOF"
  assert_eq dump("<root>\n<?pi\n ?>  <elt\natt\n=\n\"val\">\n<![CDATA[\n]]><!--\n\n--></elt>\n</root>", 0), "S  root @6 1:7\nC \"\\n\" @7 2:1\nP pi \"\" @15 3:4\nC \"  \" @17 3:6\nS  elt :att=\"val\" @34 6:7\nC \"\\n\" @35 7:1\nC \"\\n\" @48 8:4\nM \"\\n\\n\" @57 10:4\nE  elt @63 10:10\nC \"\\n\" @64 11:1\nE  root @71 11:8\nEOF"
