  assert_eq dump("<a xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" p:x=\"1\" y=\"2\"><p:b q:z=\"3\"><c xmlns=\"d2\" xmlns:p=\"u3\"><p:d/></c><p:e xml:lang=\"en\"/></p:b><q:f xmlns:q=\"\"x></a>", 1), "S d1 a :xmlns=\"d1\" xmlns:p=\"u1\" xmlns:q=\"u2\" u1:x=\"1\" :y=\"2\" @54 1:55\nS u1 b u2:z=\"3\" @67 1:68\nS d2 c :xmlns=\"d2\" xmlns:p=\"u3\" @94 1:95\nS u3 d @100 1:101\nE u3 d @100 1:101\nE d2 c @104 1:105\nS u1 e http://www.w3.org/XML/1998/namespace:lang=\"en\" @124 1:125\nE u1 e @124 1:125\nE u1 b @130 1:131\nERR syntax 1: attribute name without = in element"
