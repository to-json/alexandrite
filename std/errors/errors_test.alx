def check(n: Int) -> ~Int {
  fail new("too small: #{n}") if n < 3
  n
}

test "new" {
  assert_eq new("boom").message, "boom"
  assert_eq "#{new("x").wrap("ctx")}", "ctx: x"
}

test "failing with it" {
  e = check(1).err || new("none")
  assert_eq e.message, "too small: 1"
  case e {
    Failure => assert true
    _ => assert false, "not a Failure"
  }
  assert_eq check(5).unwrap, 5
}

# Go's errors_test.go. TestNewEqual's first case is inverted: `==` compares
# values, so two errors.new with one text are equal (see the header).
test "NewEqual" {
  assert new("abc") == new("abc")
  assert new("abc") != new("xyz")
  e = new("jkl")
  assert e == e
}

test "ErrorMethod" {
  assert_eq new("abc").message, "abc"
}

test "ERR_UNSUPPORTED" {
  assert_eq "#{ERR_UNSUPPORTED}", "unsupported operation"
  e = new("x")
  assert is?(join([e, ERR_UNSUPPORTED]), ERR_UNSUPPORTED)
  assert !is?(e, ERR_UNSUPPORTED)
}
