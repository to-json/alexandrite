#![test(external)]
# Go's errors/example_test.go, translated. Differences: ExampleNew_unique
# prints true for the distinct errors.new calls (`==` compares values, see
# the header); ExampleUnwrap's fmt.Errorf("error2: [%w]") adds context to
# the same error, so there is no chain to unwrap (a Wrapped type stands in);
# ExampleAs_custom_match / ExampleAsType_custom_match need Go's As method,
# which has no counterpart (`as` takes a block), and print %T. os's
# errors aren't io/fs's sentinels (fs.ErrNotExist): ExampleIs and ExampleAs
# match os.FsError.NotExist instead (port-issues).
import "errors"
import "fmt"
import "io/fs"
import "os"
import "time"

error MyError {
  At(when: time.Time, what: Str)

  def message -> Str {
    case self {
      At(w, s) => "#{w}: #{s}"
    }
  }
}

def oops() -> ~Unit {
  fail MyError.At(when: time.date(1989, 3, 15, 22, 30, 0, 0, time.utc), what: "the file system has gone away")
}

example "errors" {
  if e = oops().err {
    puts e
  }
} outputs "1989-03-15 22:30:00 +0000 UTC: the file system has gone away\n"

example "New" {
  e = errors.new("emit macho dwarf: elf header corrupted")
  print e
} outputs "emit macho dwarf: elf header corrupted"

example "New_unique" {
  err1 = errors.new("an error")
  err2 = errors.new("an error")
  puts "Errors using distinct errors.New calls:"
  puts fmt.sprintf("Is(%q, %q) = %v", err1.message, err2.message, errors.is?(err1, err2))
} outputs "Errors using distinct errors.New calls:\nIs(\"an error\", \"an error\") = true\n"

example "New_errorf" {
  name = "bimmler"
  id = 17
  e = fmt.errorf("user %q (id %d) not found", name, id)
  print e
} outputs "user \"bimmler\" (id 17) not found"

example "Join" {
  err1 = errors.new("err1")
  err2 = errors.new("err2")
  e = errors.join([err1, err2])
  puts e?.message || ""
  puts "err is err1" if errors.is?(e, err1)
  puts "err is err2" if errors.is?(e, err2)
  if j = e {
    puts j.unwrap_all.map { it.message }.to_a
  }
} outputs "err1\nerr2\nerr is err1\nerr is err2\n[err1 err2]\n"

example "Is" {
  if e = os.open("non-existing").err {
    not_exist = errors.as(e) { |x|
      case x {
        os.FsError.NotExist => true
        _ => none
      }
    }
    if not_exist || false {
      puts "file does not exist"
    } else {
      puts e
    }
  }
} outputs "file does not exist\n"

error MyIsError {
  E(err: Str)

  def message -> Str {
    case self {
      E(s) => s
    }
  }

  def is?(target: Error) -> Bool {
    target == fs.FsError.Permission
  }
}

example "Is_custom_match" {
  e: Error = MyIsError.E(err: "an error")
  puts "Error equals fs.ErrPermission: #{e == fs.FsError.Permission}"
  puts "Error is fs.ErrPermission: #{errors.is?(e, fs.FsError.Permission)}"
} outputs "Error equals fs.ErrPermission: false\nError is fs.ErrPermission: true\n"

example "As" {
  if e = os.open("non-existing").err {
    path = errors.as(e) { |x|
      case x {
        os.FsError.NotExist(at) => at.path
        _ => none
      }
    }
    if p = path {
      puts "Failed at path: #{p}"
    } else {
      puts e
    }
  }
} outputs "Failed at path: non-existing\n"

error Wrapped2 {
  W(msg: Str, err: Error)

  def message -> Str {
    case self {
      W(m, e) => "#{m}: [#{e}]"
    }
  }

  def unwrap -> Error? {
    case self {
      W(_, e) => e
    }
  }
}

example "Unwrap" {
  err1 = errors.new("error1")
  err2: Error = Wrapped2.W(msg: "error2", err: err1)
  puts err2
  puts errors.unwrap(err2) || errors.new("none")
} outputs "error2: [error1]\nerror1\n"
