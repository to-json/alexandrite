#![test(external)]
# Go's errors/join_test.go, translated. Not translated: the len == cap
# check of Unwrap's result (no capacity to observe).
import "errors"

error MultiErr3 {
  Multi(errs: [Error])

  def message -> Str { "multiError" }

  def unwrap -> [Error] {
    case self {
      Multi(es) => es
    }
  }
}

test "JoinReturnsNil" {
  assert errors.join([]) == none
  assert errors.join([none]) == none
  assert errors.join([none, none]) == none
}

#[track_caller]
def check_join(errs: [Error?], want: [Error]) {
  j = errors.join(errs) || return assert(false, "Join(#{errs}) = none at #{caller_location}")
  got = j.unwrap_all
  assert got == want, "Join(#{errs}).unwrap_all = #{got}; want #{want} at #{caller_location}"
}

test "Join" {
  err1 = errors.new("err1")
  err2 = errors.new("err2")
  merr: Error = MultiErr3.Multi(errs: [errors.new("err3")])
  check_join([err1], [err1])
  check_join([err1, err2], [err1, err2])
  check_join([err1, none, err2], [err1, err2])
  check_join([merr], [merr])
}

test "JoinErrorMethod" {
  err1 = errors.new("err1")
  err2 = errors.new("err2")
  assert_eq errors.join([err1])?.message, "err1"
  assert_eq errors.join([err1, err2])?.message, "err1\nerr2"
  assert_eq errors.join([err1, none, err2])?.message, "err1\nerr2"
}

test "Join is walked by is? and as" {
  err1 = errors.new("err1")
  j = errors.join([errors.new("a"), errors.join([err1])])
  assert errors.is?(j, err1)
  assert !errors.is?(j, errors.new("b"))
  assert errors.unwrap(j) == none
}
