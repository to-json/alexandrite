test "trees 1" {
  e = s(6)
  assert_eq e.message, "s6"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == true
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = j([w("empty", join([none])), w("w93", w("empty", join([none])))])
  assert_eq e.message, "empty\nw93"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = w("empty", join([none]))
  assert_eq e.message, "empty"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = s(4)
  assert_eq e.message, "日本語"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == true
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = s(3)
  assert_eq e.message, "a\nb"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == true
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = j([s(7), j([w("w66", s(5)), w("empty", join([none])), none]), s(6)])
  assert_eq e.message, "\u2028\nw66\nempty\ns6"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == true
  assert is?(e, s(6)) == true
  assert is?(e, s(7)) == true
  assert unwrap(e) == none
  e = w("w-nil", none)
  assert_eq e.message, "w-nil"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = w("w16", j([w("w31", j([s(3), s(7)])), s(0)]))
  assert_eq e.message, "w16"
  assert is?(e, s(0)) == true
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == true
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == true
  assert_eq unwrap(e)?.message, "w31\ns0"
  e = w("empty", join([none, none]))
  assert_eq e.message, "empty"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = j([s(5), j([j([s(2), s(5), s(1)]), w("empty", join([none, none]))]), none])
  assert_eq e.message, "tab\there\nhéllo\ntab\there\n\nempty"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == true
  assert is?(e, s(2)) == true
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == true
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = w("w-nil", none)
  assert_eq e.message, "w-nil"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = w("w31", j([s(4), none]))
  assert_eq e.message, "w31"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == true
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert_eq unwrap(e)?.message, "日本語"
  e = w("w72", w("w73", s(2)))
  assert_eq e.message, "w72"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == true
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert_eq unwrap(e)?.message, "w73"
  e = s(6)
  assert_eq e.message, "s6"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == true
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = w("empty", join([none]))
  assert_eq e.message, "empty"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = j([w("w32", s(3))])
  assert_eq e.message, "w32"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == true
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
  assert unwrap(e) == none
  e = j([s(2), j([s(1), none])])
  assert_eq e.message, "héllo\n"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == true
  assert is?(e, s(2)) == true
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == false
