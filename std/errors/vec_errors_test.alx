# Generated from Go's errors (Join, Is, Unwrap over random error trees); do not edit by hand.

error VecWrapped {
  W(msg: Str, err: Error?)

  def message -> Str {
    case self {
      W(m, _) => m
    }
  }

  def unwrap -> Error? {
    case self {
      W(_, e) => e
    }
  }
}

def s(i: Int) -> Error {
  texts = ["s0", "", "héllo", "a\nb", "日本語", "tab\there", "s6", "\u2028"]
  new(texts[i])
}

def w(m: Str, e: Error?) -> Error { VecWrapped.W(msg: m, err: e) }

def j(es: [Error?]) -> Error { join(es) || new("unreachable") }

test "trees 0" {
  e = s(7)
  assert_eq e.message, "\u2028"
  assert is?(e, s(0)) == false
  assert is?(e, s(1)) == false
  assert is?(e, s(2)) == false
  assert is?(e, s(3)) == false
  assert is?(e, s(4)) == false
  assert is?(e, s(5)) == false
  assert is?(e, s(6)) == false
  assert is?(e, s(7)) == true
  assert unwrap(e) == none
  e = j([j([w("empty", join([none]))]), s(2), j([w("w90", j([none, s(7), s(0)])), s(0)])])
  assert_eq e.message, "empty\nhéllo\nw90\ns0"
  assert is?(e, s(0)) == true
  assert is?(e, s(1)) == false
