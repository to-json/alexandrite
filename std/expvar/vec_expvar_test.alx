# Generated from Go's expvar (Int/Float/String/Map String(), Map.Add/AddFloat/Set/Delete, the handler's JSON); do not edit by hand.
import "math"

def b(xs: [Byte]) -> Str { Str.from_bytes(xs) }
def fb(x: U64) -> F64 { math.float64frombits(x) }

test "int 1" {
  v = make_int
  v.set(0)
  assert_eq v.to_s, "0"
  v.add(7)
  assert_eq v.to_s, "7"
  v = make_int
  v.set(1)
  assert_eq v.to_s, "1"
  v.add(7)
  assert_eq v.to_s, "8"
  v = make_int
  v.set(-1)
  assert_eq v.to_s, "-1"
  v.add(7)
  assert_eq v.to_s, "6"
  v = make_int
  v.set(42)
  assert_eq v.to_s, "42"
  v.add(7)
  assert_eq v.to_s, "49"
  v = make_int
  v.set(-2)
  assert_eq v.to_s, "-2"
  v.add(7)
  assert_eq v.to_s, "5"
  v = make_int
  v.set(9223372036854775807)
  assert_eq v.to_s, "9223372036854775807"
  v.add(7)
  assert_eq v.to_s, "-9223372036854775802"
  v = make_int
  v.set(-9223372036854775808)
  assert_eq v.to_s, "-9223372036854775808"
  v.add(7)
  assert_eq v.to_s, "-9223372036854775801"
  v = make_int
  v.set(1099511627776)
  assert_eq v.to_s, "1099511627776"
  v.add(7)
  assert_eq v.to_s, "1099511627783"
  v = make_int
  v.set(1000000)
  assert_eq v.to_s, "1000000"
  v.add(7)
  assert_eq v.to_s, "1000007"
}

test "float 2" {
  v = make_float
  v.set(fb(0x0))
  assert_eq v.to_s, "0"
  v.add(0.5)
  assert_eq v.to_s, "0.5"
  v = make_float
  v.set(fb(0x8000000000000000))
  assert_eq v.to_s, "-0"
  v.add(0.5)
  assert_eq v.to_s, "0.5"
  v = make_float
  v.set(fb(0x3ff0000000000000))
  assert_eq v.to_s, "1"
  v.add(0.5)
  assert_eq v.to_s, "1.5"
  v = make_float
  v.set(fb(0xbff0000000000000))
  assert_eq v.to_s, "-1"
  v.add(0.5)
  assert_eq v.to_s, "-0.5"
  v = make_float
  v.set(fb(0x3fb999999999999a))
  assert_eq v.to_s, "0.1"
  v.add(0.5)
  assert_eq v.to_s, "0.6"
  v = make_float
  v.set(fb(0x3fd5555555555555))
  assert_eq v.to_s, "0.3333333333333333"
  v.add(0.5)
  assert_eq v.to_s, "0.8333333333333333"
  v = make_float
  v.set(fb(0x4006000000000000))
  assert_eq v.to_s, "2.75"
  v.add(0.5)
  assert_eq v.to_s, "3.25"
  v = make_float
  v.set(fb(0x4415af1d78b58c40))
  assert_eq v.to_s, "1e+20"
  v.add(0.5)
  assert_eq v.to_s, "1e+20"
  v = make_float
  v.set(fb(0x444b1ae4d6e2ef50))
  assert_eq v.to_s, "1e+21"
  v.add(0.5)
  assert_eq v.to_s, "1e+21"
  v = make_float
  v.set(fb(0x3eb0c6f7a0b5ed8d))
  assert_eq v.to_s, "1e-06"
  v.add(0.5)
  assert_eq v.to_s, "0.500001"
  v = make_float
  v.set(fb(0x3e7ad7f29abcaf48))
  assert_eq v.to_s, "1e-07"
  v.add(0.5)
  assert_eq v.to_s, "0.5000001"
  v = make_float
  v.set(fb(0x419d6f3454000000))
  assert_eq v.to_s, "1.23456789e+08"
  v.add(0.5)
  assert_eq v.to_s, "1.234567895e+08"
  v = make_float
  v.set(fb(0x7e41eb2d66005835))
  assert_eq v.to_s, "1.5e+300"
  v.add(0.5)
  assert_eq v.to_s, "1.5e+300"
  v = make_float
  v.set(fb(0x7fefffffffffffff))
  assert_eq v.to_s, "1.7976931348623157e+308"
  v.add(0.5)
  assert_eq v.to_s, "1.7976931348623157e+308"
  v = make_float
  v.set(fb(0x1))
  assert_eq v.to_s, "5e-324"
  v.add(0.5)
  assert_eq v.to_s, "0.5"
  v = make_float
  v.set(fb(0x7ff0000000000000))
  assert_eq v.to_s, "+Inf"
  v.add(0.5)
  assert_eq v.to_s, "+Inf"
  v = make_float
  v.set(fb(0xfff0000000000000))
  assert_eq v.to_s, "-Inf"
  v.add(0.5)
  assert_eq v.to_s, "-Inf"
  v = make_float
  v.set(fb(0x7ff8000000000001))
  assert_eq v.to_s, "NaN"
  v.add(0.5)
  assert_eq v.to_s, "NaN"
  v = make_float
  v.set(fb(0x4059000000000000))
  assert_eq v.to_s, "100"
  v.add(0.5)
  assert_eq v.to_s, "100.5"
  v = make_float
  v.set(fb(0x412e848000000000))
  assert_eq v.to_s, "1e+06"
  v.add(0.5)
  assert_eq v.to_s, "1.0000005e+06"
  v = make_float
  v.set(fb(0x41678c29dccccccd))
  assert_eq v.to_s, "1.23456789e+07"
  v.add(0.5)
  assert_eq v.to_s, "1.23456794e+07"
  v = make_float
  v.set(fb(0xbf201f31f46ed246))
  assert_eq v.to_s, "-0.000123"
  v.add(0.5)
  assert_eq v.to_s, "0.499877"
  v = make_float
  v.set(fb(0x4010800000000000))
  assert_eq v.to_s, "4.125"
  v.add(0.5)
  assert_eq v.to_s, "4.625"
}

