  assert_eq m.to_s, b([123, 34, 102, 34, 58, 32, 125])
  p = P.new(x: -1, y: fb(0xfff0000000000000), name: b([119, 4]), tags: [b([34, 226, 130, 172, 110, 29, 30]), b([62, 127, 127, 97, 121, 63, 120])])
