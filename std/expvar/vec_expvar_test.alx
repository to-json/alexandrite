  assert_eq m.to_s, b([123, 34, 102, 34, 58, 32, 123, 34, 120, 34, 58, 49, 48, 48, 48, 48, 48, 48, 44, 34, 121, 34, 58, 49, 48, 48, 48, 48, 48, 48, 44, 34, 110, 97, 109, 101, 34, 58, 34, 101, 195, 169, 34, 44, 34, 116, 97, 103, 115, 34, 58, 91, 93, 125, 125])
