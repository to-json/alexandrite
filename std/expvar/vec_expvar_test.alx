test "map 9" {
  reg = new_empty_registry
  m = reg.make_map
  m.delete("10")
  assert_eq m.to_s, "{}"
  iv = make_int
  iv.set(1)
  m.set("b", iv)
  assert_eq m.to_s, b([123, 34, 98, 34, 58, 32, 49, 125])
  m.delete("")
  assert_eq m.to_s, b([123, 34, 98, 34, 58, 32, 49, 125])
