# Go's export_test.go: helpers for the external tests (flag_go_test.alx).
import "io"

# Clears COMMAND_LINE (CONTINUE_ON_ERROR, output discarded) and sets the
# package's usage function (Go's ResetForTesting; none is DefaultUsage).
pub def reset_for_testing(u: (() -> Unit)?) {
  fs = new_flag_set(program_name, CONTINUE_ON_ERROR)
  fs.set_output!(io.Discard.new)
  fs.st.lock { |s| s.global_usage = true }
  COMMAND_LINE.store(fs)
  set_usage(u)
}
