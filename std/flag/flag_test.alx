struct Level {
  n: Int
  def set!(s: Str) -> Str? {
    case s {
      "low" => {self.n = 1}
      "high" => {self.n = 2}
      _ => {return "want low or high"}
    }
    none
  }
  def to_s -> Str { n == 0 ? "" : (n == 1 ? "low" : "high") }
}

def j(xs: [Str]) -> Str {
  out = ""
  for x in xs { out += "|" + x }
  out
}

def mk -> FlagSet {
  fs = new_set("prog")
  fs.int!("n", 5, "how many")
  fs.bool!("v", false, "verbose")
  fs.str!("name", "x", "who")
  fs.float!("ratio", 0.5, "the `ratio` to use")
  fs.strs!("I", "include dir")
  fs
}

test "defaults" {
  fs = mk
  assert fs.parse!([]).ok?
  assert_eq fs.get_int("n"), 5
  assert_eq fs.get_bool("v"), false
  assert_eq fs.get_str("name"), "x"
  assert_eq fs.get_float("ratio"), 0.5
  assert_eq fs.get_strs("I").size, 0
  assert !fs.set?("n")
}

test "forms" {
  fs = mk
  assert fs.parse!(["-n", "7", "--name=bob", "-v", "-I", "a", "--I=b", "-ratio", "2.5", "rest", "-n", "9"]).ok?
  assert_eq fs.get_int("n"), 7
  assert_eq fs.get_str("name"), "bob"
  assert fs.get_bool("v")
  assert fs.set?("v")
  assert_eq j(fs.get_strs("I")), j(["a", "b"])
  assert_eq fs.get_float("ratio"), 2.5
  assert_eq j(fs.args), j(["rest", "-n", "9"])
  assert_eq fs.nargs, 3
  assert_eq fs.arg(0).unwrap, "rest"
  assert fs.arg(5).none?
}

test "bool forms" {
  fs = mk
  assert fs.parse!(["-v=false", "x"]).ok?
  assert_eq fs.get_bool("v"), false
  assert fs.set?("v")
  assert_eq j(fs.args), j(["x"])
  fs2 = mk
  assert fs2.parse!(["-v", "false"]).ok?
  assert fs2.get_bool("v")
  assert_eq j(fs2.args), j(["false"])
}

test "terminator and lone dash" {
  fs = mk
  assert fs.parse!(["-n=1", "--", "-v", "a"]).ok?
  assert_eq j(fs.args), j(["-v", "a"])
  assert !fs.get_bool("v")
  fs2 = mk
  assert fs2.parse!(["-", "-v"]).ok?
  assert_eq j(fs2.args), j(["-", "-v"])
}

test "integer syntax" {
  fs = mk
  assert fs.parse!(["-n", "0x1F"]).ok?
  assert_eq fs.get_int("n"), 31
  fs = mk
  assert fs.parse!(["-n", "1_000"]).ok?
  assert_eq fs.get_int("n"), 1000
  fs = mk
  assert fs.parse!(["-n=-0o17"]).ok?
  assert_eq fs.get_int("n"), -15
}

def msg(args: [Str]) -> Str {
  fs = mk
  r = fs.parse!(args)
  if e = r.err { return e.message }
  "ok"
}

test "errors" {
  assert_eq msg(["-zzz"]), "flag provided but not defined: -zzz"
  assert_eq msg(["-n"]), "flag needs an argument: -n"
  assert_eq msg(["-n", "abc"]), "invalid value \"abc\" for flag -n: parse error"
  assert_eq msg(["-n=99999999999999999999"]), "invalid value \"99999999999999999999\" for flag -n: value out of range"
  assert_eq msg(["-v=maybe"]), "invalid value \"maybe\" for flag -v: parse error"
  assert_eq msg(["--ratio=x"]), "invalid value \"x\" for flag -ratio: parse error"
  assert_eq msg(["---v"]), "bad flag syntax: ---v"
  assert_eq msg(["-=v"]), "bad flag syntax: -=v"
  assert msg(["-h"]).has_prefix("Usage of prog:")
  assert msg(["--help"]).has_prefix("Usage of prog:")
}

test "help is a Help error" {
  fs = mk
  r = fs.parse!(["-h"])
  e = r.err
  assert e.present?
  if err = e {
    case err {
      Help(u) => assert_eq u, fs.usage
      _ => assert false
    }
  }
}

test "usage text" {
  fs = mk
  want = "Usage of prog:\n  -I string\n    \tinclude dir\n  -n int\n    \thow many (default 5)\n  -name string\n    \twho (default \"x\")\n  -ratio ratio\n    \tthe ratio to use (default 0.5)\n  -v\tverbose\n"
  assert_eq fs.usage, want
  assert_eq j(fs.names), j(["I", "n", "name", "ratio", "v"])
}

test "custom value" {
  fs = new_set("p")
  fs.var!("level", Level.new(n: 0), "set `level`")
  assert fs.parse!(["-level", "high"]).ok?
  assert_eq fs.get_value("level").to_s, "high"
  fs2 = new_set("p")
  fs2.var!("level", Level.new(n: 1), "level")
  r = fs2.parse!(["-level=mid"])
  if e = r.err {
    assert_eq e.message, "invalid value \"mid\" for flag -level: want low or high"
  } else {
    assert false
  }
  assert_eq fs2.get_value("level").to_s, "low"
}

test "program args" {
  assert args_of_program.size >= 0
}

def define(fs: FlagSet) {
  x = fs
  x.int!("count", 1, "how many")
  x.bool!("loud", false, "shout")
}

def run_parse(fs: FlagSet, args: [Str]) {
  x = fs
  x.parse!(args).unwrap
}

test "a FlagSet passed to functions shares its flags and results" {
  fs = new_set("shared")
  define(fs)
  run_parse(fs, ["-count=7", "-loud", "rest"])
  assert_eq fs.get_int("count"), 7
  assert fs.get_bool("loud")
  assert fs.parsed?
  assert_eq fs.args.size, 1
  assert_eq fs.args[0], "rest"
}
