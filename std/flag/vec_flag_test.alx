  assert_eq vec_parse(["-b=false", "-n", "-l=bad"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=0 s=x u=7 u64=0 verbose=true|b|||invalid value \"-l=bad\" for flag -n: parse error|invalid value \"-l=bad\" for flag -n: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-b=false", "-n", "-verbose"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=0 s=x u=7 u64=0 verbose=true|b|||invalid value \"-verbose\" for flag -n: parse error|invalid value \"-verbose\" for flag -n: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-b=false", "-n", "--fn=z"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=0 s=x u=7 u64=0 verbose=true|b|||invalid value \"--fn=z\" for flag -n: parse error|invalid value \"--fn=z\" for flag -n: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-b=false", "-s", "-b=false"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=-b=false u=7 u64=0 verbose=true|b,s||||"
  assert_eq vec_parse(["-b=false", "-s", "-n"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=-n u=7 u64=0 verbose=true|b,s||||"
}

test "vectors 3" {
  assert_eq vec_parse(["-b=false", "-s", "-s"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=-s u=7 u64=0 verbose=true|b,s||||"
  assert_eq vec_parse(["-b=false", "-s", "-"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=- u=7 u64=0 verbose=true|b,s||||"
  assert_eq vec_parse(["-b=false", "-s", "-l=bad"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=-l=bad u=7 u64=0 verbose=true|b,s||||"
  assert_eq vec_parse(["-b=false", "-s", "-verbose"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=-verbose u=7 u64=0 verbose=true|b,s||||"
  assert_eq vec_parse(["-b=false", "-s", "--fn=z"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=--fn=z u=7 u64=0 verbose=true|b,s||||"
  assert_eq vec_parse(["-b=false", "-", "-b=false"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b|-,-b=false|||"
  assert_eq vec_parse(["-b=false", "-", "-n"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b|-,-n|||"
  assert_eq vec_parse(["-b=false", "-", "-s"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b|-,-s|||"
  assert_eq vec_parse(["-b=false", "-", "-"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b|-,-|||"
  assert_eq vec_parse(["-b=false", "-", "-l=bad"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b|-,-l=bad|||"
  assert_eq vec_parse(["-b=false", "-", "-verbose"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b|-,-verbose|||"
