test "vectors 5" {
  assert_eq vec_parse(["-l=bad", "-s", "--fn=z"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-s,--fn=z||invalid value \"bad\" for flag -l: bad item|invalid value \"bad\" for flag -l: bad item\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
