# Generated from Go's flag (go1.27, .scratch/flagvec/main.go); do not edit by hand.
# Each line: every flag's value, the flags set, the arguments left, the Func calls,
# the error and what parse printed (Go's FlagSet, ContinueOnError).

import "bytes"
import "time"

def bytes_sink -> bytes.Buffer { bytes.new_buffer_string("") }

def sink_text(b: bytes.Buffer) -> Str { b.to_s }

# Go's list Value of the generator: a []string, refusing "bad".
struct VecList {
  st: [[Str]]

  pub def to_s -> Str { st.size == 0 ? "[]" : "#{st[0]}" }
  pub def set!(s: Str) -> ~Unit {
    fail "bad item" if s == "bad"
    self.st[0] << s
  }
}

def vec_join(xs: [Str], sep: Str) -> Str {
  s = ""
  i = 0
  while i < xs.size {
    s += sep if i > 0
    s += xs[i]
    i += 1
  }
  s
}

def vec_parse(args: [Str]) -> Str {
  sb = bytes_sink()
  fs = new_flag_set("vec", CONTINUE_ON_ERROR)
  fs.set_output!(sb)
  fs.bool!("b", false, "a bool")
  fs.bool!("verbose", true, "be `loud`")
  fs.int!("n", 5, "how many")
  fs.int64!("i64", 0, "an int64")
  fs.uint!("u", 7, "a uint")
  fs.uint64!("u64", 0, "a uint64")
  fs.string!("s", "x", "a string\nover lines")
  fs.float64!("f", 0.5, "a float")
  fs.duration!("d", time.second, "a duration")
  calls: [Str] = []
  fs.func!("fn", "a func") { |s|
    fail "func says no" if s == "no"
    calls << "fn=" + s
  }
  fs.bool_func!("bf", "a bool func") { |s| calls << "bf=" + s }
  e: [Str] = []
  fs.var!(VecList.new(st: [e]), "l", "a `list`")
  r = fs.parse!(args)
  parts: [Str] = []
  fs.visit_all { |f| parts << f.name + "=" + f.value.to_s }
  set: [Str] = []
  fs.visit { |f| set << f.name }
  err = ""
  if x = r.err {
    err = x.message
  }
  vec_join(parts, " ") + "|" + vec_join(set, ",") + "|" + vec_join(fs.args, ",") + "|" + vec_join(calls, ",") + "|" + err + "|" + sink_text(sb)
}

def vec_defaults(kind: Str, name: Str, zero: Bool, usage: Str) -> Str {
  sb = bytes_sink()
  fs = new_flag_set("d", CONTINUE_ON_ERROR)
  fs.set_output!(sb)
  case kind {
    "bool" => { _a = fs.bool!(name, !zero, usage) }
    "int" => { _b = fs.int!(name, zero ? 0 : -12, usage) }
    "uint" => {
      v: U64 = zero ? 0 : 12
      _c = fs.uint!(name, v, usage)
    }
    "string" => { _d = fs.string!(name, zero ? "" : "say \"hi\"", usage) }
    "float" => { _e = fs.float64!(name, zero ? 0.0 : 1.25e-7, usage) }
    _ => { _f = fs.duration!(name, zero ? time.Duration.new(0) : time.minute * 90, usage) }
  }
  fs.print_defaults
  sink_text(sb)
}

test "vectors 1" {
  assert_eq vec_parse([]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|||||"
  assert_eq vec_parse(["-b"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["--b"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["-b=true"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["-b=false"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["-b=0"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["-b=1"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["-b=T"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["-b=F"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["-b=TRUE"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["-b=yes"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||invalid boolean value \"yes\" for -b: parse error|invalid boolean value \"yes\" for -b: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-b", "false"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b|false|||"
  assert_eq vec_parse(["-verbose=false"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=false|verbose||||"
  assert_eq vec_parse(["-verbose"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|verbose||||"
  assert_eq vec_parse(["-n", "3"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=3 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n=3"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=3 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["--n=3"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=3 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||flag needs an argument: -n|flag needs an argument: -n\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-n", "x"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=0 s=x u=7 u64=0 verbose=true||||invalid value \"x\" for flag -n: parse error|invalid value \"x\" for flag -n: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-n=0x1f"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=31 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n=0o17"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=15 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n=0b101"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n=017"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=15 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n=1_000"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=1000 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n=-5"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=-5 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n=+5"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n=9223372036854775807"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=9223372036854775807 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n=9223372036854775808"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=9223372036854775807 s=x u=7 u64=0 verbose=true||||invalid value \"9223372036854775808\" for flag -n: value out of range|invalid value \"9223372036854775808\" for flag -n: value out of range\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-n=-9223372036854775808"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=-9223372036854775808 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n="]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=0 s=x u=7 u64=0 verbose=true||||invalid value \"\" for flag -n: parse error|invalid value \"\" for flag -n: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-n", ""]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=0 s=x u=7 u64=0 verbose=true||||invalid value \"\" for flag -n: parse error|invalid value \"\" for flag -n: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-i64=-1"]), "b=false bf= d=1s f=0.5 fn= i64=-1 l=[] n=5 s=x u=7 u64=0 verbose=true|i64||||"
  assert_eq vec_parse(["-u=3"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=3 u64=0 verbose=true|u||||"
  assert_eq vec_parse(["-u=-3"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=0 u64=0 verbose=true||||invalid value \"-3\" for flag -u: parse error|invalid value \"-3\" for flag -u: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-u=0x10"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=16 u64=0 verbose=true|u||||"
  assert_eq vec_parse(["-u64=18446744073709551615"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=18446744073709551615 verbose=true|u64||||"
  assert_eq vec_parse(["-u64=18446744073709551616"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=18446744073709551615 verbose=true||||invalid value \"18446744073709551616\" for flag -u64: value out of range|invalid value \"18446744073709551616\" for flag -u64: value out of range\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-s", "hi"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=hi u=7 u64=0 verbose=true|s||||"
  assert_eq vec_parse(["-s="]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s= u=7 u64=0 verbose=true|s||||"
  assert_eq vec_parse(["-s=a=b"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=a=b u=7 u64=0 verbose=true|s||||"
  assert_eq vec_parse(["-s", "-n"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=-n u=7 u64=0 verbose=true|s||||"
  assert_eq vec_parse(["-s", "--"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=-- u=7 u64=0 verbose=true|s||||"
  assert_eq vec_parse(["-f=1e3"]), "b=false bf= d=1s f=1000 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|f||||"
  assert_eq vec_parse(["-f=2718e28"]), "b=false bf= d=1s f=2.718e+31 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|f||||"
  assert_eq vec_parse(["-f=.5"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|f||||"
  assert_eq vec_parse(["-f=inf"]), "b=false bf= d=1s f=+Inf fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|f||||"
  assert_eq vec_parse(["-f=-Inf"]), "b=false bf= d=1s f=-Inf fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|f||||"
  assert_eq vec_parse(["-f=NaN"]), "b=false bf= d=1s f=NaN fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|f||||"
  assert_eq vec_parse(["-f=1e400"]), "b=false bf= d=1s f=+Inf fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||invalid value \"1e400\" for flag -f: value out of range|invalid value \"1e400\" for flag -f: value out of range\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-f=0x1p-2"]), "b=false bf= d=1s f=0.25 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|f||||"
  assert_eq vec_parse(["-f=1_0.5"]), "b=false bf= d=1s f=10.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|f||||"
  assert_eq vec_parse(["-f=x"]), "b=false bf= d=1s f=0 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||invalid value \"x\" for flag -f: parse error|invalid value \"x\" for flag -f: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-d=1h2m3s"]), "b=false bf= d=1h2m3s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|d||||"
  assert_eq vec_parse(["-d=1.5s"]), "b=false bf= d=1.5s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|d||||"
  assert_eq vec_parse(["-d=-2ms"]), "b=false bf= d=-2ms f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|d||||"
  assert_eq vec_parse(["-d=300"]), "b=false bf= d=0s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||invalid value \"300\" for flag -d: parse error|invalid value \"300\" for flag -d: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-d=0"]), "b=false bf= d=0s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|d||||"
  assert_eq vec_parse(["-d=x"]), "b=false bf= d=0s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||invalid value \"x\" for flag -d: parse error|invalid value \"x\" for flag -d: parse error\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-d=1µs"]), "b=false bf= d=1µs f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|d||||"
  assert_eq vec_parse(["-fn", "a"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|fn||fn=a||"
  assert_eq vec_parse(["-fn=b"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|fn||fn=b||"
  assert_eq vec_parse(["-fn", "no"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||invalid value \"no\" for flag -fn: func says no|invalid value \"no\" for flag -fn: func says no\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-fn"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||flag needs an argument: -fn|flag needs an argument: -fn\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-bf"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|bf||bf=true||"
  assert_eq vec_parse(["-bf=x"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|bf||bf=x||"
  assert_eq vec_parse(["-bf", "x"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|bf|x|bf=true||"
  assert_eq vec_parse(["-l", "a"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[a] n=5 s=x u=7 u64=0 verbose=true|l||||"
  assert_eq vec_parse(["-l=bad"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||invalid value \"bad\" for flag -l: bad item|invalid value \"bad\" for flag -l: bad item\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-l", "a", "-l", "b"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[a b] n=5 s=x u=7 u64=0 verbose=true|l||||"
  assert_eq vec_parse(["-zzz"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||flag provided but not defined: -zzz|flag provided but not defined: -zzz\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["--zzz=1"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||flag provided but not defined: -zzz|flag provided but not defined: -zzz\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-h"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||flag: help requested|Usage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-help"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||flag: help requested|Usage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["--help"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||||flag: help requested|Usage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["---b"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||---b||bad flag syntax: ---b|bad flag syntax: ---b\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-=b"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-=b||bad flag syntax: -=b|bad flag syntax: -=b\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["--=b"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||--=b||bad flag syntax: --=b|bad flag syntax: --=b\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-|||"
  assert_eq vec_parse(["--"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|||||"
  assert_eq vec_parse(["--", "-b"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-b|||"
  assert_eq vec_parse(["x", "-b"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||x,-b|||"
  assert_eq vec_parse(["-b", "x", "-n", "3"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b|x,-n,3|||"
  assert_eq vec_parse(["-n", "1", "-n", "2"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=2 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-b", "-verbose=0", "-n=1", "-s", "q", "--", "rest"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=1 s=q u=7 u64=0 verbose=false|b,n,s,verbose|rest|||"
  assert_eq vec_parse(["-b", "-b"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["-b", "-n", "4"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=x u=7 u64=0 verbose=true|b,n||||"
  assert_eq vec_parse(["-b", "-s=z"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=z u=7 u64=0 verbose=true|b,s||||"
  assert_eq vec_parse(["-b", "--"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b||||"
  assert_eq vec_parse(["-b", "arg"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b|arg|||"
  assert_eq vec_parse(["-b", "-u=1"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=1 u64=0 verbose=true|b,u||||"
  assert_eq vec_parse(["-b", "-f", "2"]), "b=true bf= d=1s f=2 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b,f||||"
  assert_eq vec_parse(["-b", "-bf"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b,bf||bf=true||"
  assert_eq vec_parse(["-b", "-x"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b|||flag provided but not defined: -x|flag provided but not defined: -x\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-b", "-d=1m"]), "b=true bf= d=1m0s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true|b,d||||"
  assert_eq vec_parse(["-n", "4", "-b"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=x u=7 u64=0 verbose=true|b,n||||"
  assert_eq vec_parse(["-n", "4", "-n", "4"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n", "4", "-s=z"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=z u=7 u64=0 verbose=true|n,s||||"
  assert_eq vec_parse(["-n", "4", "--"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=x u=7 u64=0 verbose=true|n||||"
  assert_eq vec_parse(["-n", "4", "arg"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=x u=7 u64=0 verbose=true|n|arg|||"
  assert_eq vec_parse(["-n", "4", "-u=1"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=x u=1 u64=0 verbose=true|n,u||||"
}

test "vectors 2" {
  assert_eq vec_parse(["-n", "4", "-f", "2"]), "b=false bf= d=1s f=2 fn= i64=0 l=[] n=4 s=x u=7 u64=0 verbose=true|f,n||||"
  assert_eq vec_parse(["-n", "4", "-bf"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=x u=7 u64=0 verbose=true|bf,n||bf=true||"
  assert_eq vec_parse(["-n", "4", "-x"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=x u=7 u64=0 verbose=true|n|||flag provided but not defined: -x|flag provided but not defined: -x\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-n", "4", "-d=1m"]), "b=false bf= d=1m0s f=0.5 fn= i64=0 l=[] n=4 s=x u=7 u64=0 verbose=true|d,n||||"
  assert_eq vec_parse(["-s=z", "-b"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=z u=7 u64=0 verbose=true|b,s||||"
  assert_eq vec_parse(["-s=z", "-n", "4"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=z u=7 u64=0 verbose=true|n,s||||"
  assert_eq vec_parse(["-s=z", "-s=z"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=z u=7 u64=0 verbose=true|s||||"
  assert_eq vec_parse(["-s=z", "--"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=z u=7 u64=0 verbose=true|s||||"
  assert_eq vec_parse(["-s=z", "arg"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=z u=7 u64=0 verbose=true|s|arg|||"
  assert_eq vec_parse(["-s=z", "-u=1"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=z u=1 u64=0 verbose=true|s,u||||"
  assert_eq vec_parse(["-s=z", "-f", "2"]), "b=false bf= d=1s f=2 fn= i64=0 l=[] n=5 s=z u=7 u64=0 verbose=true|f,s||||"
  assert_eq vec_parse(["-s=z", "-bf"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=z u=7 u64=0 verbose=true|bf,s||bf=true||"
  assert_eq vec_parse(["-s=z", "-x"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=z u=7 u64=0 verbose=true|s|||flag provided but not defined: -x|flag provided but not defined: -x\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
  assert_eq vec_parse(["-s=z", "-d=1m"]), "b=false bf= d=1m0s f=0.5 fn= i64=0 l=[] n=5 s=z u=7 u64=0 verbose=true|d,s||||"
  assert_eq vec_parse(["--", "-b"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-b|||"
  assert_eq vec_parse(["--", "-n", "4"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-n,4|||"
  assert_eq vec_parse(["--", "-s=z"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-s=z|||"
  assert_eq vec_parse(["--", "--"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||--|||"
  assert_eq vec_parse(["--", "arg"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg|||"
  assert_eq vec_parse(["--", "-u=1"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-u=1|||"
  assert_eq vec_parse(["--", "-f", "2"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-f,2|||"
  assert_eq vec_parse(["--", "-bf"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-bf|||"
  assert_eq vec_parse(["--", "-x"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-x|||"
  assert_eq vec_parse(["--", "-d=1m"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||-d=1m|||"
  assert_eq vec_parse(["arg", "-b"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg,-b|||"
  assert_eq vec_parse(["arg", "-n", "4"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg,-n,4|||"
  assert_eq vec_parse(["arg", "-s=z"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg,-s=z|||"
  assert_eq vec_parse(["arg", "--"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg,--|||"
  assert_eq vec_parse(["arg", "arg"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg,arg|||"
  assert_eq vec_parse(["arg", "-u=1"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg,-u=1|||"
  assert_eq vec_parse(["arg", "-f", "2"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg,-f,2|||"
  assert_eq vec_parse(["arg", "-bf"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg,-bf|||"
  assert_eq vec_parse(["arg", "-x"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg,-x|||"
  assert_eq vec_parse(["arg", "-d=1m"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=7 u64=0 verbose=true||arg,-d=1m|||"
  assert_eq vec_parse(["-u=1", "-b"]), "b=true bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=1 u64=0 verbose=true|b,u||||"
  assert_eq vec_parse(["-u=1", "-n", "4"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=4 s=x u=1 u64=0 verbose=true|n,u||||"
  assert_eq vec_parse(["-u=1", "-s=z"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=z u=1 u64=0 verbose=true|s,u||||"
  assert_eq vec_parse(["-u=1", "--"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=1 u64=0 verbose=true|u||||"
  assert_eq vec_parse(["-u=1", "arg"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=1 u64=0 verbose=true|u|arg|||"
  assert_eq vec_parse(["-u=1", "-u=1"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=1 u64=0 verbose=true|u||||"
  assert_eq vec_parse(["-u=1", "-f", "2"]), "b=false bf= d=1s f=2 fn= i64=0 l=[] n=5 s=x u=1 u64=0 verbose=true|f,u||||"
  assert_eq vec_parse(["-u=1", "-bf"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=1 u64=0 verbose=true|bf,u||bf=true||"
  assert_eq vec_parse(["-u=1", "-x"]), "b=false bf= d=1s f=0.5 fn= i64=0 l=[] n=5 s=x u=1 u64=0 verbose=true|u|||flag provided but not defined: -x|flag provided but not defined: -x\nUsage of vec:\n  -b\ta bool\n  -bf\n    \ta bool func\n  -d duration\n    \ta duration (default 1s)\n  -f float\n    \ta float (default 0.5)\n  -fn value\n    \ta func\n  -i64 int\n    \tan int64\n  -l list\n    \ta list\n  -n int\n    \thow many (default 5)\n  -s string\n    \ta string\n    \tover lines (default \"x\")\n  -u uint\n    \ta uint (default 7)\n  -u64 uint\n    \ta uint64\n  -verbose loud\n    \tbe loud (default true)\n"
