  assert_eq vec_defaults("duration", "xy", true, "un`closed"), "  -xy duration\n    \tun`closed\n"
  assert_eq vec_defaults("duration", "xy", false, ""), "  -xy duration\n    \t (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "xy", false, "plain usage"), "  -xy duration\n    \tplain usage (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "xy", false, "a `name` here"), "  -xy name\n    \ta name here (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "xy", false, "two\nlines"), "  -xy duration\n    \ttwo\n    \tlines (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "xy", false, "`only`"), "  -xy only\n    \tonly (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "xy", false, "un`closed"), "  -xy duration\n    \tun`closed (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "long_name", true, ""), "  -long_name duration\n    \t\n"
  assert_eq vec_defaults("duration", "long_name", true, "plain usage"), "  -long_name duration\n    \tplain usage\n"
  assert_eq vec_defaults("duration", "long_name", true, "a `name` here"), "  -long_name name\n    \ta name here\n"
  assert_eq vec_defaults("duration", "long_name", true, "two\nlines"), "  -long_name duration\n    \ttwo\n    \tlines\n"
  assert_eq vec_defaults("duration", "long_name", true, "`only`"), "  -long_name only\n    \tonly\n"
  assert_eq vec_defaults("duration", "long_name", true, "un`closed"), "  -long_name duration\n    \tun`closed\n"
  assert_eq vec_defaults("duration", "long_name", false, ""), "  -long_name duration\n    \t (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "long_name", false, "plain usage"), "  -long_name duration\n    \tplain usage (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "long_name", false, "a `name` here"), "  -long_name name\n    \ta name here (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "long_name", false, "two\nlines"), "  -long_name duration\n    \ttwo\n    \tlines (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "long_name", false, "`only`"), "  -long_name only\n    \tonly (default 1h30m0s)\n"
  assert_eq vec_defaults("duration", "long_name", false, "un`closed"), "  -long_name duration\n    \tun`closed (default 1h30m0s)\n"
}
