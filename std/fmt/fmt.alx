# Package fmt: Go's formatted printing. Its functions are compiler builtins,
# because they take any number of arguments of any type and check each
# against its verb at compile time:
#
#   fmt.sprintf(format, args...) -> Str     fmt.printf(format, args...)
#   fmt.sprint(args...) -> Str              fmt.print(args...)
#   fmt.sprintln(args...) -> Str            fmt.println(args...)
#   fmt.errorf(format, args...) -> Error
#
# Verbs: %v %d %s %q %t %f %e %E %x %X %o %b %c %T %%, with flags `-+0 `, a
# width and a precision (`%-8s`, `%05d`, `%+.2f`, `%10.3e`). `sprint` puts
# spaces between operands when neither is a Str; `sprintln` always does
# and ends with a newline.

# The verbs this package understands (for reference).
pub def verbs() -> Str {
  "%v %d %s %q %t %f %e %E %x %X %o %b %c %T %%"
}
