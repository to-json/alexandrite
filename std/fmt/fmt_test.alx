# Go's fmt tests that aren't tables of values (fmt_test.go, errors_test.go,
# stringer_test.go, scan_test.go), translated. The tables are the
# generated vec_*_test.alx.

import "bytes"
import "fmt"
import "math"

# ------------------------------------------------------------ fmt_test.go

test "ComplexFormatting" { |t|
  values = [1.0, 0.0, -1.0, math.inf(1), math.inf(-1), math.nan]
  for re in values {
    for im in values {
      c = Complex.new(re, im)
      # Each part formatted by the verb, the imaginary part always signed.
      pairs = [
        (fmt.sprintf("%10.2f", c), "(" + fmt.sprintf("%10.2f", re) + fmt.sprintf("%+10.2f", im) + "i)"),
        (fmt.sprintf("%+010.2e", c), "(" + fmt.sprintf("%+010.2e", re) + fmt.sprintf("%+010.2e", im) + "i)"),
        (fmt.sprintf("% 10.2G", c), "(" + fmt.sprintf("% 10.2G", re) + fmt.sprintf("%+10.2G", im) + "i)"),
        (fmt.sprintf("%0 +10.2F", c), "(" + fmt.sprintf("%0 +10.2F", re) + fmt.sprintf("%0+10.2F", im) + "i)"),
      ]
      for p in pairs {
        t.error("#{p[0]} != #{p[1]}") if p[0] != p[1]
      }
    }
  }
}

# Go's flagPrinter: a Formatter showing the flags, width and precision it got.
struct FlagPrinter {
  def format(f: fmt.State, c: Rune) {
    s = "%"
    i = 0
    while i < 128 {
      s += __fmt_rune_str(i) if f.flag?(i)
      i += 1
    }
    if w = f.width {
      s += fmt.sprintf("%d", w)
    }
    if p = f.precision {
      s += fmt.sprintf(".%d", p)
    }
    s += __fmt_rune_str(c.to_i)
    ff = f
    ff.write!("[#{s}]".bytes.to_a)
  }
}

test "FlagParser" {
  fp = FlagPrinter.new
  # Go's verb is `a`, which alx refuses for other types; a Formatter takes any verb.
  assert_eq fmt.sprintf("%a", fp), "[%a]"
  assert_eq fmt.sprintf("%-a", fp), "[%-a]"
  assert_eq fmt.sprintf("%+a", fp), "[%+a]"
  assert_eq fmt.sprintf("%#a", fp), "[%#a]"
  assert_eq fmt.sprintf("% a", fp), "[% a]"
  assert_eq fmt.sprintf("%0a", fp), "[%0a]"
  assert_eq fmt.sprintf("%1.2a", fp), "[%1.2a]"
  assert_eq fmt.sprintf("%-1.2a", fp), "[%-1.2a]"
  assert_eq fmt.sprintf("%+1.2a", fp), "[%+1.2a]"
  assert_eq fmt.sprintf("%-+1.2a", fp), "[%+-1.2a]"
  assert_eq fmt.sprintf("%-+1.2abc", fp), "[%+-1.2a]bc"
  assert_eq fmt.sprintf("%-1.2abc", fp), "[%-1.2a]bc"
  assert_eq fmt.sprintf("%-0abc", fp), "[%-0a]bc"
}

struct T3 {
  a: Str
  b: Str
  c: Int
}

test "StructPrinter" {
  s = T3.new(a: "abc", b: "def", c: 123)
  assert_eq fmt.sprintf("%v", s), "{abc def 123}"
  assert_eq fmt.sprintf("%+v", s), "{a:abc b:def c:123}"
  # Go: fmt_test.T{a:"abc", b:"def", c:123}; alx syntax here.
  assert_eq fmt.sprintf("%#v", s), "T3.new(a: \"abc\", b: \"def\", c: 123)"
}

test "SlicePrinter" {
  slice: [Int] = []
  assert_eq fmt.sprint(slice), "[]"
  slice = [1, 2, 3]
  assert_eq fmt.sprint(slice), "[1 2 3]"
}

test "MapPrinter" {
  m0: Map[Int, Str] = {}
  assert_eq fmt.sprint(m0), "map[]"
  m1: Map[Int, Str] = {1 => "one", 2 => "two", 3 => "three"}
  # Insertion order (Go sorts; these keys are sorted either way).
  assert_eq fmt.sprintf("%v", m1), "map[1:one 2:two 3:three]"
  assert_eq fmt.sprint(m1), "map[1:one 2:two 3:three]"
}

test "EmptyMap" {
  m: Map[Str, Int] = {}
  assert_eq fmt.sprint(m), "map[]"
}

test "Blank" {
  assert_eq fmt.sprint("<", 1, ">:", 1, 2, 3, "!"), "<1>:1 2 3!"
}

test "Blankln" {
  assert_eq fmt.sprintln("<", 1, ">:", 1, 2, 3, "!"), "< 1 >: 1 2 3 !\n"
}

# Go's F: a Formatter.
struct F {
  v: Int

  def format(s: fmt.State, c: Rune) {
    ss = s
    _n = fmt.fprintf(ss, "<%c=F(%d)>", c, v)
  }
}

test "FormatterPrintln" {
  f = F.new(v: 1)
  expect = "<v=F(1)>\n"
  assert_eq fmt.sprint(f, "\n"), expect
  assert_eq fmt.sprintln(f), expect
  assert_eq fmt.sprintf("%v\n", f), expect
}

test "WidthAndPrecision" {
  assert_eq fmt.sprintf("%*d", 4, 42), "  42"
  assert_eq fmt.sprintf("%-*d", 4, 42), "42  "
  assert_eq fmt.sprintf("%*d", -4, 42), "42  "
  assert_eq fmt.sprintf("%-*d", -4, 42), "42  "
  assert_eq fmt.sprintf("%.*d", 4, 42), "0042"
  assert_eq fmt.sprintf("%*.*d", 8, 4, 42), "    0042"
  assert_eq fmt.sprintf("%0*d", 4, 42), "0042"
  w: U64 = 4
  assert_eq fmt.sprintf("%0*d", w, 42), "0042"
  r: Rune = 4
  assert_eq fmt.sprintf("%0*d", r, 42), "0042"
  # A negative precision is none (Go also writes %!(BADPREC)).
  assert_eq fmt.sprintf("%*% %d", 20, 5), "% 5"
}

test "IsSpace" {
  # Go's isSpace agrees with unicode.IsSpace.
  r = 0
  while r < 0x3001 {
    want = r >= 9 && r <= 13 || r == 32 || r == 0x85 || r == 0xA0 || r == 0x1680 || r >= 0x2000 && r <= 0x200A || r == 0x2028 || r == 0x2029 || r == 0x202F || r == 0x205F || r == 0x3000
    assert_eq is_space(r), want
    r += 1
  }
}

# Go's formatterFlagTests: a Formatter still gets Go's flags (here through
# sprintf of the flags it sees).
test "FormatterFlags" {
  fp = FlagPrinter.new
  assert_eq fmt.sprintf("%#v", fp), "[%#v]"
  assert_eq fmt.sprintf("%+v", fp), "[%+v]"
  assert_eq fmt.sprintf("%010.3x", fp), "[%010.3x]"
}

test "Appendf" {
  b = "hello ".bytes.to_a
  got = fmt.appendf(b, "world, %d", 23)
  assert_eq Str.from_bytes(got), "hello world, 23"
}

test "Append" {
  b = "hello ".bytes.to_a
  got = fmt.append(b, "world", ", ", 23)
  assert_eq Str.from_bytes(got), "hello world, 23"
}

test "Appendln" {
  b = "hello ".bytes.to_a
  got = fmt.appendln(b, "world,", 23)
  assert_eq Str.from_bytes(got), "hello world, 23\n"
}

test "Fprint" {
  buf = bytes.new_buffer([])
  n = ~fmt.fprintf(buf, "%d-%s", 5, "x")
  assert_eq n, 3
  ~fmt.fprint(buf, 1, 2, "a")
  ~fmt.fprintln(buf, "end", 7)
  assert_eq buf.string, "5-x1 2aend 7\n"
}

# Go's Sprintf of the reorder table's valid entries is in the vectors; these
# are its compile errors in alx (Go prints %!d(BADINDEX) and friends).
test "Reorder" {
  assert_eq fmt.sprintf("%d %d %d %#[1]o %#o %#o", 11, 12, 13), "11 12 13 013 014 015"
  assert_eq fmt.sprintf("%[3]*.[2]*[1]f", 12.0, 2, 6), " 12.00"
}

# --------------------------------------------------------- errors_test.go

error TestErr {
  Inner
  Str1(s: Str)

  def message -> Str {
    case self {
      Inner => "inner error"
      Str1(s) => s
    }
  }
}

test "Errorf" {
  wrapped: Error = TestErr.Inner
  e1 = fmt.errorf("%w", wrapped)
  assert_eq e1.message, "inner error"
  e2 = fmt.errorf("added context: %w", wrapped)
  assert_eq e2.message, "added context: inner error"
  # The wrapped error is still underneath: it matches its variant.
  inner = case e2 {
    TestErr.Inner => true
    _ => false
  }
  assert inner
  assert_eq fmt.errorf("%w with added context", wrapped).message, "inner error with added context"
  assert_eq fmt.errorf("%s %w %v", "prefix", wrapped, "suffix").message, "prefix inner error suffix"
  assert_eq fmt.errorf("%[2]s: %[1]w", wrapped, "positional verb").message, "positional verb: inner error"
  assert_eq fmt.errorf("%v", wrapped).message, "inner error"
  assert_eq fmt.errorf("added context: %v", wrapped).message, "added context: inner error"
  assert_eq fmt.errorf("no verbs").message, "no verbs"
  assert_eq fmt.errorf("wrapped two errors: %w %w", TestErr.Str1("1"), TestErr.Str1("2")).message, "wrapped two errors: 1 2"
  assert_eq fmt.errorf("wrapped errors out of order: %[3]w %[2]w %[1]w", TestErr.Str1("1"), TestErr.Str1("2"), TestErr.Str1("3")).message, "wrapped errors out of order: 3 2 1"
  assert_eq fmt.errorf("wrapped several times: %[1]w %[1]w %[2]w %[1]w", TestErr.Str1("1"), TestErr.Str1("2")).message, "wrapped several times: 1 1 2 1"
}

# ------------------------------------------------------- stringer_test.go

struct TI {
  v: Int
  def to_s -> Str { fmt.sprintf("I: %d", v) }
}

struct TU8 {
  v: U8
  def to_s -> Str { fmt.sprintf("U8: %d", v) }
}

struct TF {
  v: Float
  def to_s -> Str { fmt.sprintf("F: %f", v) }
}

struct TB {
  v: Bool
  def to_s -> Str { fmt.sprintf("B: %t", v) }
}

struct TS {
  v: Str
  def to_s -> Str { fmt.sprintf("S: %q", v) }
}

test "Stringer" {
  assert_eq fmt.sprintf("%v", TI.new(v: 0)), "I: 0"
  assert_eq fmt.sprintf("%v", TU8.new(v: 4)), "U8: 4"
  assert_eq fmt.sprintf("%v", TF.new(v: 1.0)), "F: 1.000000"
  assert_eq fmt.sprintf("%v", TB.new(v: true)), "B: true"
  assert_eq fmt.sprintf("%v", TS.new(v: "x")), "S: \"x\""
  # %s, %q and %x use the text too; other verbs see the fields.
  assert_eq fmt.sprintf("%s|%q|%x|%10v|", TI.new(v: 1), TI.new(v: 1), TI.new(v: 1), TI.new(v: 2)), "I: 1|\"I: 1\"|493a2031|      I: 2|"
  assert_eq fmt.sprintf("%d", TI.new(v: 3)), "{3}"
}

# GoStringer: %#v uses go_string.
struct G {
  v: Int
  def go_string -> Str { fmt.sprintf("GoString(%d)", v) }
}

test "GoStringer" {
  assert_eq fmt.sprintf("%#v", G.new(v: 7)), "GoString(7)"
  assert_eq fmt.sprintf("%v", G.new(v: 7)), "{7}"
}

# ---------------------------------------------------------- scan_test.go

test "ScanMultiple" { |t|
  a = 0
  s = ""
  n = ~fmt.sscan("123abc", a, s)
  assert_eq n, 2
  assert a == 123 && s == "abc", "Sscan wrong values: got (#{a} #{s})"
  r = fmt.sscan("asdf", s, a)
  assert r.err?
  assert_eq s, "asdf"
  t.log("after the error: s=#{s}")
}

test "ScanEmpty" {
  s1 = ""
  s2 = ""
  r = fmt.sscan("abc", s1, s2)
  assert r.err?
  assert_eq s1, "abc"
  r = fmt.sscan("", s1, s2)
  assert r.err?
  # Quoted empty string is OK.
  assert_eq fmt.sscanf("\"\"", "%q", s1).unwrap, 1
  assert_eq s1, ""
}

test "ScanlnNoNewline" {
  a = 0
  r = fmt.sscanln("1 x\n", a)
  assert r.err.unwrap.message.include?("newline")
}

test "ScanlnWithMiddleNewline" {
  r = bytes.new_reader("123\n456\n".bytes.to_a)
  a = 0
  b = 0
  res = fmt.fscanln(r, a, b)
  assert_eq res.err.unwrap.message, "unexpected newline"
}

test "EOF" {
  ec = bytes.new_reader("123\n".bytes.to_a)
  n = 0
  assert_eq fmt.fscanln(ec, n).unwrap, 1
  assert_eq n, 123
  # Nothing left: Go's io.EOF.
  assert_eq fmt.fscanln(ec, n).err.unwrap.message, "EOF"
}

test "EOFAtEndOfInput" {
  i = 0
  j = 0
  assert_eq fmt.sscanf("23", "%d %d", i, j).err.unwrap.message, "EOF"
  assert_eq i, 23
  assert_eq fmt.sscan("234", i, j).err.unwrap.message, "EOF"
  assert_eq i, 234
  # Trailing space is tougher.
  assert_eq fmt.sscan("234 ", i, j).err.unwrap.message, "EOF"
  assert_eq i, 234
}

test "EOFAllTypes" {
  i = 0
  f = 0.0
  s = ""
  b = false
  c = Complex.new(0.0, 0.0)
  bs: [Byte] = []
  for msg in [fmt.sscan("", i).err.unwrap.message, fmt.sscan("", f).err.unwrap.message, fmt.sscan("", s).err.unwrap.message, fmt.sscan("", b).err.unwrap.message, fmt.sscan("", c).err.unwrap.message, fmt.sscan("", bs).err.unwrap.message] {
    assert_eq msg, "EOF"
  }
  for msg in [fmt.sscan("   ", i).err.unwrap.message, fmt.sscan("   ", s).err.unwrap.message] {
    assert_eq msg, "EOF"
  }
}

test "MultiLine" {
  input = "abc\ndef\nghi\n"
  a = ""
  b = ""
  c = ""
  assert_eq fmt.sscan(input, a, b, c).unwrap, 3
  assert_eq a + b + c, "abcdefghi"
  # Scanln stops at the first newline.
  r = fmt.sscanln(input, a, b, c)
  assert_eq r.err.unwrap.message, "unexpected newline"
  assert_eq a, "abc"
}

test "LineByLineFscanf" {
  r = bytes.new_reader("1\n2\n".bytes.to_a)
  i = 0
  k = 0
  assert_eq fmt.fscanf(r, "%v\n", i).unwrap, 1
  assert_eq fmt.fscanf(r, "%v\n", k).unwrap, 1
  assert i == 1 && k == 2
  r2 = fmt.fscanf(r, "%v\n", i)
  assert r2.err?
}

test "ScanInts" {
  # Go scans a long run of ints from one reader.
  text = ""
  for i in 0...800 {
    text += "#{i} "
  }
  r = bytes.new_reader(text.bytes.to_a)
  i = 0
  for want in 0...800 {
    assert_eq fmt.fscan(r, i).unwrap, 1
    assert_eq i, want
  }
}

test "HexBytes" {
  a: [Byte] = []
  b: [Byte] = []
  want: [Byte] = [0, 1, 2, 3]
  assert_eq fmt.sscanf("00010203", "%x", a).unwrap, 1
  assert_eq a, want
  assert_eq fmt.sscanf("00010203 00010203", "%x %x", a, b).unwrap, 2
  assert a == want && b == want
  assert_eq fmt.sscanf("00010203:", "%x", a).unwrap, 1
  assert_eq a, want
  assert_eq fmt.sscanf("00010203:00010203", "%x:%x", a, b).unwrap, 2
  assert a == want && b == want
  # A hex digit after the data: an odd number of them.
  assert fmt.sscanf("000102034:", "%x", a).err?
  assert_eq fmt.sscanf("xyz", "%x", a).err.unwrap.message, "no hex data for %x string"
}

test "NaN and Inf" {
  for s in ["nan", "NAN", "NaN"] {
    f = 0.0
    ~fmt.sscan(s, f)
    assert f != f
  }
  for s in ["inf", "+inf", "-inf", "INF", "-INF", "+INF", "Inf", "-Inf", "+Inf"] {
    f = 0.0
    ~fmt.sscan(s, f)
    assert_eq f, s[0] == 45 ? math.inf(-1) : math.inf(1)
  }
}

# ------------------------------------------------------- example_test.go

example "Errorf" {
  e = fmt.errorf("user %q (id %d) not found", "bueller", 17)
  puts e.message
} outputs "user \"bueller\" (id 17) not found"

example "Fscanf" {
  i = 0
  b = false
  s = ""
  r = bytes.new_reader("5 true gophers".bytes.to_a)
  n = fmt.fscanf(r, "%d %t %s", i, b, s)
  if e = n.err {
    puts "Fscanf: #{e.message}"
  }
  puts "#{i} #{b} #{s}"
} outputs "5 true gophers"

example "Fscanln" {
  s = "dmr 1771 1.61803398875\nken 271828 3.14159"
  r = bytes.new_reader(s.bytes.to_a)
  a = ""
  b = 0
  c = 0.0
  loop {
    res = fmt.fscanln(r, a, b, c)
    break if res.err?
    fmt.printf("%d: %s, %d, %f\n", res.unwrap, a, b, c)
  }
} outputs "3: dmr, 1771, 1.618034\n3: ken, 271828, 3.141590"

example "Sscanf" {
  name = ""
  age = 0
  ~fmt.sscanf("Kim is 22 years old", "%s is %d years old", name, age)
  fmt.printf("%d\n", age)
  puts name
} outputs "22\nKim"

example "Sprint" {
  name = "Kim"
  age = 22
  s = fmt.sprint(name, " is ", age, " years old.\n")
  print s
} outputs "Kim is 22 years old."

example "Println" {
  n = 22
  fmt.println("Kim", "is", n, "years old.")
} outputs "Kim is 22 years old."

example "Sprintf" {
  s = fmt.sprintf("%s is %d years old.\n", "Kim", 22)
  print s
} outputs "Kim is 22 years old."

example "Fprint" {
  buf = bytes.new_buffer([])
  n = ~fmt.fprint(buf, "Kim", " is ", 22, " years old.\n")
  print buf.string
  print fmt.sprint(n, " bytes written.\n")
} outputs "Kim is 22 years old.\n21 bytes written."

example "Printf" {
  # Go's ExamplePrintf, line by line.
  integer = 23
  fmt.printf("%v %d\n", integer, integer)
  fmt.printf("%t %v\n", true, true)
  fmt.printf("%v %d %x %o %b\n", integer, integer, integer, integer, integer)
  pi = math.PI
  fmt.printf("%v %g %.2f (%6.2f) %e\n", pi, pi, pi, pi, pi)
  fmt.printf("%v %.3g %.3e\n", Complex.new(1.0, 2.0), Complex.new(1.0, 2.0), Complex.new(1.0, 2.0))
  smile = 0x1F600
  fmt.printf("%c %q %U %#U\n", smile, smile, smile, smile)
  placeholders = "foo \"bar\""
  fmt.printf("%v %q %#q\n", placeholders, placeholders, placeholders)
  slice = [3, 4, 5, 6, 7]
  fmt.printf("%v %d %x\n", slice, slice, slice)
  greats = [1.0, 2.5, 3.33]
  fmt.printf("%v %.1f\n", greats, greats)
  cmd = "ls -l"
  fmt.printf("%v %x %X % x\n", cmd, cmd, cmd, cmd)
  sb = "hello".bytes.to_a
  fmt.printf("%s %q %x\n", sb, sb, sb)
} outputs "23 23\ntrue true\n23 23 17 27 10111\n3.141592653589793 3.141592653589793 3.14 (  3.14) 3.141593e+00\n(1+2i) (1+2i) (1.000e+00+2.000e+00i)\n😀 '😀' U+1F600 U+1F600 '😀'\nfoo \"bar\" \"foo \\\"bar\\\"\" `foo \"bar\"`\n[3 4 5 6 7] [3 4 5 6 7] [3 4 5 6 7]\n[1 2.5 3.33] [1.0 2.5 3.3]\nls -l 6c73202d6c 6C73202D6C 6c 73 20 2d 6c\nhello \"hello\" 68656c6c6f"

# Go's TestPanics: Go catches a panic in a String, Error or Format method
# and prints `%!v(PANIC=String method: ...)`; alx has no recover, so the
# panic goes on (the difference, checked).
struct Panicky {
  msg: Str
  def to_s -> Str { panic(msg) }
}

test "Panics" {
  p = Panicky.new(msg: "boom")
  assert_panics("boom") { fmt.sprintf("%v", p) }
  assert_panics("boom") { fmt.sprintf("%s|%10v", p, p) }
  assert_panics("boom") { fmt.sprintln(p) }
}
