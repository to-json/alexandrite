  assert_eq format("%12.0U", u16(65535)), "      U+FFFF"
  assert_eq format("%12.3U", u16(65535)), "      U+FFFF"
  assert_eq format("%-.3U", u16(65535)), "U+FFFF"
  assert_eq format("%-5U", u16(65535)), "U+FFFF"
  assert_eq format("%+.3U", u16(65535)), "U+FFFF"
  assert_eq format("%+5U", u16(65535)), "U+FFFF"
}

