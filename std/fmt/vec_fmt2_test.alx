test "fmt vectors 53" {
  assert_eq format("%+ .3v", fb(0x400921fb54442d11)), " 3.14"
  assert_eq format("%+ 5v", fb(0x400921fb54442d11)), " 3.14159265358979"
  assert_eq format("%\#0.3v", fb(0x400921fb54442d11)), "3.14"
  assert_eq format("%\#05v", fb(0x400921fb54442d11)), "3.14159265358979"
  assert_eq format("%-\#.3v", fb(0x400921fb54442d11)), "3.14"
  assert_eq format("%-\#5v", fb(0x400921fb54442d11)), "3.14159265358979"
  assert_eq format("%v", fb(0xbe90c6f7a0b5ed8d)), "-2.5e-07"
  assert_eq format("%.0v", fb(0xbe90c6f7a0b5ed8d)), "-2e-07"
