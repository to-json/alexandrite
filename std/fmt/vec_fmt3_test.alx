  assert_eq format("%12.3g", fb(0x1)), "   4.94e-324"
  assert_eq format("%-.3g", fb(0x1)), "4.94e-324"
  assert_eq format("%-5g", fb(0x1)), "5e-324"
  assert_eq format("%+.3g", fb(0x1)), "+4.94e-324"
  assert_eq format("%+5g", fb(0x1)), "+5e-324"
  assert_eq format("%\#.3g", fb(0x1)), "4.94e-324"
  assert_eq format("%\#5g", fb(0x1)), "5.00000e-324"
  assert_eq format("% .3g", fb(0x1)), " 4.94e-324"
  assert_eq format("% 5g", fb(0x1)), " 5e-324"
}

