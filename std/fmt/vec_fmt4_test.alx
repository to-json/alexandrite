  assert_eq format("%+05x", bs([0, 127])), "0007f"
  assert_eq format("%\# .3x", bs([0, 127])), "0x00 0x7f"
  assert_eq format("%\# 5x", bs([0, 127])), "0x00 0x7f"
  assert_eq format("%+ .3x", bs([0, 127])), "00 7f"
  assert_eq format("%+ 5x", bs([0, 127])), "00 7f"
  assert_eq format("%\#0.3x", bs([0, 127])), "0x007f"
  assert_eq format("%\#05x", bs([0, 127])), "0x007f"
  assert_eq format("%-\#.3x", bs([0, 127])), "0x007f"
  assert_eq format("%-\#5x", bs([0, 127])), "0x007f"
  assert_eq format("%x", "日本語"), "e697a5e69cace8aa9e"
  assert_eq format("%.0x", "日本語"), ""
  assert_eq format("%.3x", "日本語"), "e697a5"
  assert_eq format("%1.10x", "日本語"), "e697a5e69cace8aa9e"
  assert_eq format("%5x", "日本語"), "e697a5e69cace8aa9e"
  assert_eq format("%5.0x", "日本語"), "     "
}

