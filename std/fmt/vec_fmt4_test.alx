  assert_eq format("%+05v", "abc"), "00abc"
  assert_eq format("%\# .3v", "abc"), "\"abc\""
  assert_eq format("%\# 5v", "abc"), "\"abc\""
  assert_eq format("%+ .3v", "abc"), "abc"
  assert_eq format("%+ 5v", "abc"), "  abc"
  assert_eq format("%\#0.3v", "abc"), "\"abc\""
  assert_eq format("%\#05v", "abc"), "\"abc\""
}

