test "fmt vectors 117" {
  assert_eq format("%-.3d", u8s([104, 105])), "[104 105]"
  assert_eq format("%-5d", u8s([104, 105])), "[104   105  ]"
  assert_eq format("%+.3d", u8s([104, 105])), "[+104 +105]"
  assert_eq format("%+5d", u8s([104, 105])), "[ +104  +105]"
  assert_eq format("%\#.3d", u8s([104, 105])), "[104 105]"
  assert_eq format("%\#5d", u8s([104, 105])), "[  104   105]"
  assert_eq format("% .3d", u8s([104, 105])), "[ 104  105]"
  assert_eq format("% 5d", u8s([104, 105])), "[  104   105]"
  assert_eq format("%0.3d", u8s([104, 105])), "[104 105]"
  assert_eq format("%05d", u8s([104, 105])), "[00104 00105]"
