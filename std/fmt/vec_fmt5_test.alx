  assert_eq format("%\#05g", fls([fb(0x3ff8000000000000), fb(0xbfd0000000000000)])), "[1.50000 -0.250000]"
  assert_eq format("%-\#.3g", fls([fb(0x3ff8000000000000), fb(0xbfd0000000000000)])), "[1.50 -0.250]"
  assert_eq format("%-\#5g", fls([fb(0x3ff8000000000000), fb(0xbfd0000000000000)])), "[1.50000 -0.250000]"
}
