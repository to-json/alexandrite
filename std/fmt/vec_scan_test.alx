  assert_eq r14.unwrap, 1
  assert_eq v14_0, 16
  v15_0: Int = 0
  r15 = fmt.sscan("0x_1_0\n", v15_0)
  assert_eq r15.unwrap, 1
  assert_eq v15_0, 16
  v16_0: Int = 0
  r16 = fmt.sscanln("0x_1_0\n", v16_0)
  assert_eq r16.unwrap, 1
  assert_eq v16_0, 16
  v17_0: Int = 0
  r17 = fmt.sscan("-0x10\n", v17_0)
  assert_eq r17.unwrap, 1
  assert_eq v17_0, -16
  v18_0: Int = 0
  r18 = fmt.sscanln("-0x10\n", v18_0)
  assert_eq r18.unwrap, 1
  assert_eq v18_0, -16
  v19_0: Int = 0
  r19 = fmt.sscan("0377\n", v19_0)
  assert_eq r19.unwrap, 1
  assert_eq v19_0, 255
  v20_0: Int = 0
  r20 = fmt.sscanln("0377\n", v20_0)
  assert_eq r20.unwrap, 1
  assert_eq v20_0, 255
  v21_0: Int = 0
