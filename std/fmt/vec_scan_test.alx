  assert_eq r68.unwrap, 1
  assert_eq v68_0, 24
  v69_0: I64 = 0
  r69 = fmt.sscan("+25\n", v69_0)
  assert_eq r69.unwrap, 1
  assert_eq v69_0, 25
  v70_0: I64 = 0
  r70 = fmt.sscanln("+25\n", v70_0)
  assert_eq r70.unwrap, 1
  assert_eq v70_0, 25
  v71_0: I8 = 0
  r71 = fmt.sscan("+127\n", v71_0)
  assert_eq r71.unwrap, 1
  assert_eq v71_0, 127
  v72_0: I8 = 0
  r72 = fmt.sscanln("+127\n", v72_0)
  assert_eq r72.unwrap, 1
  assert_eq v72_0, 127
  v73_0: U64 = 0
  r73 = fmt.sscan("26\n", v73_0)
  assert_eq r73.unwrap, 1
