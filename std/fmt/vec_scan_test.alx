  assert_eq r24.unwrap, 1
  assert_eq v24_0, 255
  v25_0: Int = 0
  r25 = fmt.sscan("0o_3_7_7\n", v25_0)
  assert_eq r25.unwrap, 1
  assert_eq v25_0, 255
  v26_0: Int = 0
  r26 = fmt.sscanln("0o_3_7_7\n", v26_0)
  assert_eq r26.unwrap, 1
  assert_eq v26_0, 255
  v27_0: Int = 0
  r27 = fmt.sscan("-0377\n", v27_0)
  assert_eq r27.unwrap, 1
  assert_eq v27_0, -255
  v28_0: Int = 0
