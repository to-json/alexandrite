  v76_0: U8 = 0
  r76 = fmt.sscanln("27\n", v76_0)
  assert_eq r76.unwrap, 1
  assert_eq v76_0, 27
  v77_0: U16 = 0
  r77 = fmt.sscan("28\n", v77_0)
  assert_eq r77.unwrap, 1
  assert_eq v77_0, 28
  v78_0: U16 = 0
  r78 = fmt.sscanln("28\n", v78_0)
  assert_eq r78.unwrap, 1
  assert_eq v78_0, 28
  v79_0: U32 = 0
  r79 = fmt.sscan("29\n", v79_0)
  assert_eq r79.unwrap, 1
  assert_eq v79_0, 29
  v80_0: U32 = 0
  r80 = fmt.sscanln("29\n", v80_0)
  assert_eq r80.unwrap, 1
  assert_eq v80_0, 29
  v81_0: U64 = 0
  r81 = fmt.sscan("30\n", v81_0)
  assert_eq r81.unwrap, 1
  assert_eq v81_0, 30
  v82_0: U64 = 0
  r82 = fmt.sscanln("30\n", v82_0)
  assert_eq r82.unwrap, 1
  assert_eq v82_0, 30
  v83_0: U8 = 0
  r83 = fmt.sscan("255\n", v83_0)
  assert_eq r83.unwrap, 1
  assert_eq v83_0, 255
  v84_0: U8 = 0
  r84 = fmt.sscanln("255\n", v84_0)
  assert_eq r84.unwrap, 1
  assert_eq v84_0, 255
  v85_0: I16 = 0
  r85 = fmt.sscan("32767\n", v85_0)
  assert_eq r85.unwrap, 1
  assert_eq v85_0, 32767
  v86_0: I16 = 0
  r86 = fmt.sscanln("32767\n", v86_0)
  assert_eq r86.unwrap, 1
  assert_eq v86_0, 32767
  v87_0: Float = 0.0
  r87 = fmt.sscan("2.3\n", v87_0)
  assert_eq r87.unwrap, 1
  assert_eq v87_0, fb(0x4002666666666666)
  v88_0: Float = 0.0
  r88 = fmt.sscanln("2.3\n", v88_0)
  assert_eq r88.unwrap, 1
  assert_eq v88_0, fb(0x4002666666666666)
  v89_0: Float = 0.0
  r89 = fmt.sscan("2.3e2\n", v89_0)
  assert_eq r89.unwrap, 1
  assert_eq v89_0, fb(0x406cc00000000000)
  v90_0: Float = 0.0
  r90 = fmt.sscanln("2.3e2\n", v90_0)
  assert_eq r90.unwrap, 1
  assert_eq v90_0, fb(0x406cc00000000000)
  v91_0: Float = 0.0
  r91 = fmt.sscan("2.3p2\n", v91_0)
  assert_eq r91.unwrap, 1
  assert_eq v91_0, fb(0x4022666666666666)
  v92_0: Float = 0.0
  r92 = fmt.sscanln("2.3p2\n", v92_0)
  assert_eq r92.unwrap, 1
  assert_eq v92_0, fb(0x4022666666666666)
  v93_0: Float = 0.0
  r93 = fmt.sscan("2.3p+2\n", v93_0)
  assert_eq r93.unwrap, 1
  assert_eq v93_0, fb(0x4022666666666666)
  v94_0: Float = 0.0
  r94 = fmt.sscanln("2.3p+2\n", v94_0)
  assert_eq r94.unwrap, 1
  assert_eq v94_0, fb(0x4022666666666666)
  v95_0: Float = 0.0
  r95 = fmt.sscan("2.3p+66\n", v95_0)
  assert_eq r95.unwrap, 1
  assert_eq v95_0, fb(0x4422666666666666)
  v96_0: Float = 0.0
  r96 = fmt.sscanln("2.3p+66\n", v96_0)
  assert_eq r96.unwrap, 1
  assert_eq v96_0, fb(0x4422666666666666)
  v97_0: Float = 0.0
  r97 = fmt.sscan("2.3p-66\n", v97_0)
  assert_eq r97.unwrap, 1
  assert_eq v97_0, fb(0x3be2666666666666)
  v98_0: Float = 0.0
  r98 = fmt.sscanln("2.3p-66\n", v98_0)
  assert_eq r98.unwrap, 1
  assert_eq v98_0, fb(0x3be2666666666666)
  v99_0: Float = 0.0
  r99 = fmt.sscan("0x2.3p-66\n", v99_0)
  assert_eq r99.unwrap, 1
  assert_eq v99_0, fb(0x3be1800000000000)
  v100_0: Float = 0.0
  r100 = fmt.sscanln("0x2.3p-66\n", v100_0)
  assert_eq r100.unwrap, 1
  assert_eq v100_0, fb(0x3be1800000000000)
  v101_0: Float = 0.0
  r101 = fmt.sscan("2_3.4_5\n", v101_0)
  assert_eq r101.unwrap, 1
  assert_eq v101_0, fb(0x4037733333333333)
  v102_0: Float = 0.0
  r102 = fmt.sscanln("2_3.4_5\n", v102_0)
  assert_eq r102.unwrap, 1
  assert_eq v102_0, fb(0x4037733333333333)
  v103_0: Str = ""
  r103 = fmt.sscan("2.35\n", v103_0)
  assert_eq r103.unwrap, 1
  assert_eq v103_0, "2.35"
  v104_0: Str = ""
  r104 = fmt.sscanln("2.35\n", v104_0)
  assert_eq r104.unwrap, 1
  assert_eq v104_0, "2.35"
  v105_0: [Byte] = []
  r105 = fmt.sscan("2345678\n", v105_0)
  assert_eq r105.unwrap, 1
  assert_eq v105_0, "2345678".bytes.to_a
  v106_0: [Byte] = []
  r106 = fmt.sscanln("2345678\n", v106_0)
  assert_eq r106.unwrap, 1
  assert_eq v106_0, "2345678".bytes.to_a
  v107_0: Complex = Complex.new(0.0, 0.0)
  r107 = fmt.sscan("(3.4e1-2i)\n", v107_0)
  assert_eq r107.unwrap, 1
  assert_eq v107_0, Complex.new(fb(0x4041000000000000), fb(0xc000000000000000))
  v108_0: Complex = Complex.new(0.0, 0.0)
  r108 = fmt.sscanln("(3.4e1-2i)\n", v108_0)
  assert_eq r108.unwrap, 1
  assert_eq v108_0, Complex.new(fb(0x4041000000000000), fb(0xc000000000000000))
  v109_0: Complex = Complex.new(0.0, 0.0)
  r109 = fmt.sscan("-.45e1-1e2i\n", v109_0)
  assert_eq r109.unwrap, 1
  assert_eq v109_0, Complex.new(fb(0xc012000000000000), fb(0xc059000000000000))
  v110_0: Complex = Complex.new(0.0, 0.0)
  r110 = fmt.sscanln("-.45e1-1e2i\n", v110_0)
  assert_eq r110.unwrap, 1
  assert_eq v110_0, Complex.new(fb(0xc012000000000000), fb(0xc059000000000000))
  v111_0: Complex = Complex.new(0.0, 0.0)
  r111 = fmt.sscan("-.4_5e1-1E2i\n", v111_0)
  assert_eq r111.unwrap, 1
  assert_eq v111_0, Complex.new(fb(0xc012000000000000), fb(0xc059000000000000))
  v112_0: Complex = Complex.new(0.0, 0.0)
  r112 = fmt.sscanln("-.4_5e1-1E2i\n", v112_0)
  assert_eq r112.unwrap, 1
  assert_eq v112_0, Complex.new(fb(0xc012000000000000), fb(0xc059000000000000))
  v113_0: Complex = Complex.new(0.0, 0.0)
  r113 = fmt.sscan("0x1.0p1+0x1.0P2i\n", v113_0)
  assert_eq r113.unwrap, 1
  assert_eq v113_0, Complex.new(fb(0x4000000000000000), fb(0x4010000000000000))
  v114_0: Complex = Complex.new(0.0, 0.0)
  r114 = fmt.sscanln("0x1.0p1+0x1.0P2i\n", v114_0)
  assert_eq r114.unwrap, 1
  assert_eq v114_0, Complex.new(fb(0x4000000000000000), fb(0x4010000000000000))
  v115_0: Complex = Complex.new(0.0, 0.0)
  r115 = fmt.sscan("-0x1p1-0x1p2i\n", v115_0)
  assert_eq r115.unwrap, 1
  assert_eq v115_0, Complex.new(fb(0xc000000000000000), fb(0xc010000000000000))
  v116_0: Complex = Complex.new(0.0, 0.0)
  r116 = fmt.sscanln("-0x1p1-0x1p2i\n", v116_0)
  assert_eq r116.unwrap, 1
  assert_eq v116_0, Complex.new(fb(0xc000000000000000), fb(0xc010000000000000))
  v117_0: Complex = Complex.new(0.0, 0.0)
  r117 = fmt.sscan("-0x1ep-1-0x1p2i\n", v117_0)
  assert_eq r117.unwrap, 1
  assert_eq v117_0, Complex.new(fb(0xc02e000000000000), fb(0xc010000000000000))
  v118_0: Complex = Complex.new(0.0, 0.0)
  r118 = fmt.sscanln("-0x1ep-1-0x1p2i\n", v118_0)
  assert_eq r118.unwrap, 1
  assert_eq v118_0, Complex.new(fb(0xc02e000000000000), fb(0xc010000000000000))
  v119_0: Complex = Complex.new(0.0, 0.0)
  r119 = fmt.sscan("-0x1_Ep-1-0x1p0_2i\n", v119_0)
  assert_eq r119.unwrap, 1
  assert_eq v119_0, Complex.new(fb(0xc02e000000000000), fb(0xc010000000000000))
  v120_0: Complex = Complex.new(0.0, 0.0)
  r120 = fmt.sscanln("-0x1_Ep-1-0x1p0_2i\n", v120_0)
  assert_eq r120.unwrap, 1
  assert_eq v120_0, Complex.new(fb(0xc02e000000000000), fb(0xc010000000000000))
}

test "scan vectors 3" {
  v121_0: Str = ""
  r121 = fmt.sscan("hello\n", v121_0)
  assert_eq r121.unwrap, 1
  assert_eq v121_0, "hello"
  v122_0: Str = ""
  r122 = fmt.sscanln("hello\n", v122_0)
  assert_eq r122.unwrap, 1
  assert_eq v122_0, "hello"
  v123_0: Str = ""
