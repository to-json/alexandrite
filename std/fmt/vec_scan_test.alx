#![test(external)]
# Generated from Go's fmt scan tests (scan_test.go's scanTests, scanfTests,
# overflowTests, multiTests and newline tables), scanned by Go; do not
# edit by hand. Each scan fills fresh variables of the operands' types.
# An external test (S11): it uses fmt as a user does (fb and bs below are
# vec_fmt1_test.alx's, which this package doesn't see).

import "fmt"

def fb(x: U64) -> Float { x.__from_bits }
def bs(xs: [Int]) -> Str { Str.from_bytes(xs.map { |x| x.as_u8 }.to_a) }

test "scan vectors 1" {
  v1_0: Bool = false
  r1 = fmt.sscan("T\n", v1_0)
  assert_eq r1.unwrap, 1
  assert_eq v1_0, true
  v2_0: Bool = false
  r2 = fmt.sscanln("T\n", v2_0)
  assert_eq r2.unwrap, 1
  assert_eq v2_0, true
  v3_0: Bool = false
  r3 = fmt.sscan("F\n", v3_0)
  assert_eq r3.unwrap, 1
  assert_eq v3_0, false
  v4_0: Bool = false
  r4 = fmt.sscanln("F\n", v4_0)
  assert_eq r4.unwrap, 1
  assert_eq v4_0, false
  v5_0: Int = 0
  r5 = fmt.sscan("21\n", v5_0)
  assert_eq r5.unwrap, 1
  assert_eq v5_0, 21
  v6_0: Int = 0
  r6 = fmt.sscanln("21\n", v6_0)
  assert_eq r6.unwrap, 1
  assert_eq v6_0, 21
  v7_0: Int = 0
  r7 = fmt.sscan("2_1\n", v7_0)
  assert_eq r7.unwrap, 1
  assert_eq v7_0, 21
  v8_0: Int = 0
  r8 = fmt.sscanln("2_1\n", v8_0)
  assert_eq r8.unwrap, 1
  assert_eq v8_0, 21
  v9_0: Int = 0
  r9 = fmt.sscan("0\n", v9_0)
  assert_eq r9.unwrap, 1
  assert_eq v9_0, 0
  v10_0: Int = 0
  r10 = fmt.sscanln("0\n", v10_0)
  assert_eq r10.unwrap, 1
  assert_eq v10_0, 0
  v11_0: Int = 0
  r11 = fmt.sscan("000\n", v11_0)
  assert_eq r11.unwrap, 1
  assert_eq v11_0, 0
  v12_0: Int = 0
