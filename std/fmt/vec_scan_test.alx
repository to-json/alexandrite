test "scan vectors 5" {
  v241_0: Int = 0
  r241 = fmt.sscanf(" X27X", "X%dX", v241_0)
  assert_eq r241.err.unwrap.message, "input does not match format"
  assert_eq v241_0, 0
  v242_0: Int = 0
  r242 = fmt.sscanf(" X27X ", "X%dX", v242_0)
  assert_eq r242.err.unwrap.message, "input does not match format"
  assert_eq v242_0, 0
  v243_0: Int = 0
  r243 = fmt.sscanf("X27X", "X%dX\n", v243_0)
  assert_eq r243.unwrap, 1
  assert_eq v243_0, 27
  v244_0: Int = 0
  r244 = fmt.sscanf("X27X ", "X%dX \n", v244_0)
  assert_eq r244.unwrap, 1
  assert_eq v244_0, 27
  v245_0: Int = 0
  r245 = fmt.sscanf("X27X\n", "X%dX\n", v245_0)
  assert_eq r245.unwrap, 1
  assert_eq v245_0, 27
  v246_0: Int = 0
  r246 = fmt.sscanf("X27X \n", "X%dX\n", v246_0)
