  assert_eq r34.unwrap, 1
  assert_eq v34_0, 0
  v35_0: U64 = 0
  r35 = fmt.sscan("0x10\n", v35_0)
  assert_eq r35.unwrap, 1
  assert_eq v35_0, 16
  v36_0: U64 = 0
  r36 = fmt.sscanln("0x10\n", v36_0)
  assert_eq r36.unwrap, 1
  assert_eq v36_0, 16
  v37_0: U64 = 0
  r37 = fmt.sscan("0377\n", v37_0)
  assert_eq r37.unwrap, 1
  assert_eq v37_0, 255
  v38_0: U64 = 0
  r38 = fmt.sscanln("0377\n", v38_0)
  assert_eq r38.unwrap, 1
  assert_eq v38_0, 255
  v39_0: I8 = 0
  r39 = fmt.sscan("22\n", v39_0)
