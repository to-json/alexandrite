test "scan vectors 2" {
  v61_0: Int = 0
  r61 = fmt.sscan("+21\n", v61_0)
  assert_eq r61.unwrap, 1
  assert_eq v61_0, 21
  v62_0: Int = 0
  r62 = fmt.sscanln("+21\n", v62_0)
  assert_eq r62.unwrap, 1
  assert_eq v62_0, 21
  v63_0: I8 = 0
  r63 = fmt.sscan("+22\n", v63_0)
  assert_eq r63.unwrap, 1
  assert_eq v63_0, 22
  v64_0: I8 = 0
  r64 = fmt.sscanln("+22\n", v64_0)
  assert_eq r64.unwrap, 1
  assert_eq v64_0, 22
  v65_0: I16 = 0
  r65 = fmt.sscan("+23\n", v65_0)
  assert_eq r65.unwrap, 1
  assert_eq v65_0, 23
