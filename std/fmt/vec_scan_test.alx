  assert_eq v249_0, 27
  v250_0: Int = 0
  r250 = fmt.sscanf("X27X \n", "X%dX \n", v250_0)
  assert_eq r250.unwrap, 1
  assert_eq v250_0, 27
  v251_0: I32 = 0
  r251 = fmt.sscanf("X\n", "X%c", v251_0)
  assert_eq r251.unwrap, 1
  assert_eq v251_0, 10
  v252_0: I32 = 0
  r252 = fmt.sscanf("X \n", "X%c", v252_0)
  assert_eq r252.unwrap, 1
  assert_eq v252_0, 32
  v253_0: I32 = 0
  r253 = fmt.sscanf("X!", "X %c", v253_0)
  assert_eq r253.err.unwrap.message, "expected space in input to match format"
  assert_eq v253_0, 0
  v254_0: I32 = 0
  r254 = fmt.sscanf("X\n", "X %c", v254_0)
  assert_eq r254.err.unwrap.message, "newline in input does not match format"
  assert_eq v254_0, 0
  v255_0: I32 = 0
  r255 = fmt.sscanf("X !", "X %c", v255_0)
  assert_eq r255.unwrap, 1
  assert_eq v255_0, 33
  v256_0: I32 = 0
  r256 = fmt.sscanf("X \n", "X %c", v256_0)
  assert_eq r256.unwrap, 1
  assert_eq v256_0, 10
  v257_0: Int = 0
  r257 = fmt.sscanf("X27X", " X%dX", v257_0)
  assert_eq r257.err.unwrap.message, "expected space in input to match format"
  assert_eq v257_0, 0
  v258_0: Int = 0
  r258 = fmt.sscanf("X27X ", " X%dX", v258_0)
  assert_eq r258.err.unwrap.message, "expected space in input to match format"
  assert_eq v258_0, 0
  v259_0: Int = 0
  r259 = fmt.sscanf(" X27X", " X%dX", v259_0)
  assert_eq r259.unwrap, 1
  assert_eq v259_0, 27
  v260_0: Int = 0
  r260 = fmt.sscanf(" X27X ", " X%dX", v260_0)
  assert_eq r260.unwrap, 1
  assert_eq v260_0, 27
  v261_0: Int = 0
  r261 = fmt.sscanf("X27X", "X%dX ", v261_0)
  assert_eq r261.unwrap, 1
  assert_eq v261_0, 27
  v262_0: Int = 0
  r262 = fmt.sscanf("X27X ", "X%dX ", v262_0)
  assert_eq r262.unwrap, 1
  assert_eq v262_0, 27
  v263_0: Int = 0
  r263 = fmt.sscanf(" X27X", "X%dX ", v263_0)
  assert_eq r263.err.unwrap.message, "input does not match format"
  assert_eq v263_0, 0
  v264_0: Int = 0
  r264 = fmt.sscanf(" X27X ", "X%dX ", v264_0)
  assert_eq r264.err.unwrap.message, "input does not match format"
  assert_eq v264_0, 0
  v265_0: Int = 0
  r265 = fmt.sscanf("X27X", " X%dX ", v265_0)
  assert_eq r265.err.unwrap.message, "expected space in input to match format"
  assert_eq v265_0, 0
  v266_0: Int = 0
  r266 = fmt.sscanf("X27X ", " X%dX ", v266_0)
  assert_eq r266.err.unwrap.message, "expected space in input to match format"
  assert_eq v266_0, 0
  v267_0: Int = 0
  r267 = fmt.sscanf(" X27X", " X%dX ", v267_0)
  assert_eq r267.unwrap, 1
  assert_eq v267_0, 27
  v268_0: Int = 0
  r268 = fmt.sscanf(" X27X ", " X%dX ", v268_0)
  assert_eq r268.unwrap, 1
  assert_eq v268_0, 27
  v269_0: Int = 0
  r269 = fmt.sscanf("27\nX", "%d\nX", v269_0)
  assert_eq r269.unwrap, 1
  assert_eq v269_0, 27
  v270_0: Int = 0
  r270 = fmt.sscanf("27X\n X", "%dX\n X", v270_0)
  assert_eq r270.unwrap, 1
  assert_eq v270_0, 27
  v271_0: I8 = 0
  r271 = fmt.sscan("128", v271_0)
  assert_eq r271.err.unwrap.message, "integer overflow on token 128"
  assert_eq v271_0, 0
  v272_0: I16 = 0
  r272 = fmt.sscan("32768", v272_0)
  assert_eq r272.err.unwrap.message, "integer overflow on token 32768"
  assert_eq v272_0, 0
  v273_0: I8 = 0
  r273 = fmt.sscan("-129", v273_0)
  assert_eq r273.err.unwrap.message, "integer overflow on token -129"
  assert_eq v273_0, 0
  v274_0: I16 = 0
  r274 = fmt.sscan("-32769", v274_0)
  assert_eq r274.err.unwrap.message, "integer overflow on token -32769"
  assert_eq v274_0, 0
  v275_0: U8 = 0
  r275 = fmt.sscan("256", v275_0)
  assert_eq r275.err.unwrap.message, "unsigned integer overflow on token 256"
  assert_eq v275_0, 0
  v276_0: U16 = 0
  r276 = fmt.sscan("65536", v276_0)
  assert_eq r276.err.unwrap.message, "unsigned integer overflow on token 65536"
  assert_eq v276_0, 0
  v277_0: Float = 0.0
  r277 = fmt.sscan("1e500", v277_0)
  assert_eq r277.err.unwrap.message, "strconv.parse_float: parsing \"1e500\": value out of range"
  assert_eq v277_0, fb(0x0)
  v278_0: Complex = Complex.new(0.0, 0.0)
  r278 = fmt.sscan("(1-1e500i)", v278_0)
  assert_eq r278.err.unwrap.message, "strconv.parse_float: parsing \"-1e500\": value out of range"
  assert_eq v278_0, Complex.new(fb(0x0), fb(0x0))
  r279 = fmt.sscanf("", "")
  assert_eq r279.unwrap, 0
  v280_0: Int = 0
  r280 = fmt.sscanf("23", "%d", v280_0)
  assert_eq r280.unwrap, 1
  assert_eq v280_0, 23
  v281_0: Str = ""
  v281_1: Str = ""
  r281 = fmt.sscanf("22333", "%2s%3s", v281_0, v281_1)
  assert_eq r281.unwrap, 2
  assert_eq v281_0, "22"
  assert_eq v281_1, "333"
  v282_0: Int = 0
  v282_1: Int = 0
  r282 = fmt.sscanf("44555", "%2d%3d", v282_0, v282_1)
  assert_eq r282.unwrap, 2
  assert_eq v282_0, 44
  assert_eq v282_1, 555
  v283_0: Int = 0
  v283_1: Int = 0
  r283 = fmt.sscanf("66.777", "%2d.%3d", v283_0, v283_1)
  assert_eq r283.unwrap, 2
  assert_eq v283_0, 66
  assert_eq v283_1, 777
  v284_0: Int = 0
  v284_1: Int = 0
  r284 = fmt.sscanf("23, 18", "%d, %d", v284_0, v284_1)
  assert_eq r284.unwrap, 2
  assert_eq v284_0, 23
  assert_eq v284_1, 18
  v285_0: Int = 0
  v285_1: Int = 0
  r285 = fmt.sscanf("33322333", "%3d22%3d", v285_0, v285_1)
  assert_eq r285.unwrap, 2
  assert_eq v285_0, 333
  assert_eq v285_1, 333
  v286_0: Complex = Complex.new(0.0, 0.0)
  v286_1: Float = 0.0
  r286 = fmt.sscanf("3+2iX=2.5Y", "%6vX=%3fY", v286_0, v286_1)
  assert_eq r286.unwrap, 2
  assert_eq v286_0, Complex.new(fb(0x4008000000000000), fb(0x4000000000000000))
  assert_eq v286_1, fb(0x4004000000000000)
  v287_0: Int = 0
  v287_1: Str = ""
  r287 = fmt.sscanf("123abc", "%d%s", v287_0, v287_1)
  assert_eq r287.unwrap, 2
  assert_eq v287_0, 123
  assert_eq v287_1, "abc"
  v288_0: I32 = 0
  v288_1: I32 = 0
  v288_2: I32 = 0
  r288 = fmt.sscanf("2僂X", "%c%c%c", v288_0, v288_1, v288_2)
  assert_eq r288.unwrap, 3
  assert_eq v288_0, 50
  assert_eq v288_1, 20674
  assert_eq v288_2, 88
  v289_0: Str = ""
  v289_1: Int = 0
  r289 = fmt.sscanf(" 1234567 ", "%5s%d", v289_0, v289_1)
  assert_eq r289.unwrap, 2
  assert_eq v289_0, "12345"
  assert_eq v289_1, 67
  v290_0: Str = ""
  v290_1: Int = 0
  r290 = fmt.sscanf(" 12 34 567 ", "%5s%d", v290_0, v290_1)
  assert_eq r290.unwrap, 2
  assert_eq v290_0, "12"
  assert_eq v290_1, 34
  v291_0: Int = 0
  r291 = fmt.sscanf("23 18", "%t", v291_0)
  assert_eq r291.err.unwrap.message, "bad verb '%t' for integer"
  assert_eq v291_0, 0
  v292_0: Int = 0
  v292_1: Int = 0
  r292 = fmt.sscanf("23 18", "%d %d %d", v292_0, v292_1)
  assert_eq r292.err.unwrap.message, "too few operands for format '%d'"
  assert_eq v292_0, 23
  assert_eq v292_1, 18
  v293_0: Int = 0
  v293_1: Int = 0
  v293_2: Int = 0
  r293 = fmt.sscanf("23 18 27", "%d %d", v293_0, v293_1, v293_2)
  assert_eq r293.err.unwrap.message, "too many operands"
  assert_eq v293_0, 23
  assert_eq v293_1, 18
  assert_eq v293_2, 0
  v294_0: I8 = 0
  r294 = fmt.sscanf("Ā", "%c", v294_0)
  assert_eq r294.err.unwrap.message, "overflow on character value Ā"
  assert_eq v294_0, 0
  v295_0: Int = 0
  r295 = fmt.sscanf("10X", "X%d", v295_0)
  assert_eq r295.err.unwrap.message, "input does not match format"
  assert_eq v295_0, 0
  v296_0: Int = 0
  r296 = fmt.sscanf("42%", "%d%", v296_0)
  assert_eq r296.err.unwrap.message, "missing verb: % at end of format string"
  assert_eq v296_0, 42
  v297_0: Int = 0
  r297 = fmt.sscanf("42%", "%d% ", v297_0)
  assert_eq r297.err.unwrap.message, "too few operands for format '% '"
  assert_eq v297_0, 42
  v298_0: Int = 0
  r298 = fmt.sscanf("xxx 42", "%%%d", v298_0)
  assert_eq r298.err.unwrap.message, "missing literal %"
  assert_eq v298_0, 0
  v299_0: Int = 0
  r299 = fmt.sscanf("x42", "%%%d", v299_0)
  assert_eq r299.err.unwrap.message, "missing literal %"
  assert_eq v299_0, 0
  v300_0: Int = 0
  r300 = fmt.sscanf("42", "%%%d", v300_0)
  assert_eq r300.err.unwrap.message, "missing literal %"
  assert_eq v300_0, 0
}

test "scan vectors 6" {
  v301_0: I32 = 0
  v301_1: I32 = 0
  v301_2: I32 = 0
  r301 = fmt.sscanf(bs([194, 88, 194]), "%c%c%c", v301_0, v301_1, v301_2)
  assert_eq r301.unwrap, 3
  assert_eq v301_0, 65533
  assert_eq v301_1, 88
  assert_eq v301_2, 65533
  v302_0: Bool = false
  v302_1: Int = 0
  r302 = fmt.sscanf("FALSE23", "%v%v", v302_0, v302_1)
  assert_eq r302.unwrap, 2
  assert_eq v302_0, false
  assert_eq v302_1, 23
  v303_0: Int = 0
  v303_1: Int = 0
  r303 = fmt.sscan("1\n2\n", v303_0, v303_1)
  assert_eq r303.unwrap, 2
  assert_eq v303_0, 1
  assert_eq v303_1, 2
  v304_0: Int = 0
  v304_1: Int = 0
  r304 = fmt.sscan("1\n2", v304_0, v304_1)
  assert_eq r304.unwrap, 2
  assert_eq v304_0, 1
  assert_eq v304_1, 2
  v305_0: Int = 0
  v305_1: Int = 0
  r305 = fmt.sscan("1  \n  2  \n", v305_0, v305_1)
  assert_eq r305.unwrap, 2
  assert_eq v305_0, 1
  assert_eq v305_1, 2
  v306_0: Int = 0
  v306_1: Int = 0
  r306 = fmt.sscan("1  \n  2", v306_0, v306_1)
  assert_eq r306.unwrap, 2
  assert_eq v306_0, 1
  assert_eq v306_1, 2
  v307_0: Int = 0
  v307_1: Int = 0
  r307 = fmt.sscanln("1\n", v307_0, v307_1)
  assert_eq r307.err.unwrap.message, "unexpected newline"
  assert_eq v307_0, 1
  assert_eq v307_1, 0
  v308_0: Int = 0
  v308_1: Int = 0
  r308 = fmt.sscanln("   1 2    \n", v308_0, v308_1)
