# golang.org/x/crypto/chacha20poly1305's tests (chacha20poly1305_test.go);
# the vectors of chacha20poly1305_vectors_test.go are in
# vec_chacha20poly1305_test.alx, checked by check_vector (TestVectors).

import "crypto/cipher"
import "crypto/rand"
import "encoding/hex"
import mrand "math/rand"

def hd(s: Str) -> [Byte] { hex.decode_string(s).unwrap }

# An AEAD for the nonce's size, as a cipher.AEAD interface value.
def aead_for(key: [Byte], nonce_size: Int) -> cipher.AEAD {
  return new(key).unwrap if nonce_size == NONCE_SIZE
  new_x(key).unwrap
}

# Go's TestVectors body (and TestRandom's checks) for one case.
def check(key: [Byte], nonce: [Byte], plaintext: [Byte], ad: [Byte], want: Str?, rnd: mrand.Rand) {
  r = rnd
  aead = aead_for(key, nonce.size)
  ct = aead.seal([], nonce, plaintext, ad)
  if w = want {
    assert_eq hex.encode_to_string(ct), w
  }
  plaintext2 = aead.open([], nonce, ct, ad)
  assert plaintext2.ok?, "Open failed"
  assert_eq plaintext2.unwrap, plaintext
  if ad.size > 0 {
    i = r.intn!(ad.size)
    ad[i] = ad[i] ^ 0x80
    assert !aead.open([], nonce, ct, ad).ok?, "Open was successful after altering additional data"
    ad[i] = ad[i] ^ 0x80
  }
  i = r.intn!(aead.nonce_size)
  nonce[i] = nonce[i] ^ 0x80
  assert !aead.open([], nonce, ct, ad).ok?, "Open was successful after altering nonce"
  nonce[i] = nonce[i] ^ 0x80
  i = r.intn!(ct.size)
  ct[i] = ct[i] ^ 0x80
  assert !aead.open([], nonce, ct, ad).ok?, "Open was successful after altering ciphertext"
  ct[i] = ct[i] ^ 0x80
  nil
}

def check_vector(plaintext: Str, aad: Str, key: Str, nonce: Str, out: Str) {
  check(hd(key), hd(nonce), hd(plaintext), hd(aad), out, mrand.new(mrand.new_source(out.size)))
}

def random_bytes(n: Int) -> [Byte] {
  b = [0.as_u8; n]
  rand.read(b)
  b
}

test "Random" {
  # Some random tests to verify Open(Seal) == Plaintext
  r = mrand.new(mrand.new_source(1))
  for nonce_size in [NONCE_SIZE, NONCE_SIZE_X] {
    i = 0
    while i < 256 {
      al = r.intn!(128)
      pl = r.intn!(16384)
      check(random_bytes(32), random_bytes(nonce_size), random_bytes(pl), random_bytes(al), none, r)
      i += 1
    }
  }
}

test "errors" {
  assert_eq new([0.as_u8; 31]).err?.message || "", "chacha20poly1305: bad key length"
  assert_eq new_x([0.as_u8; 33]).err?.message || "", "chacha20poly1305: bad key length"
  a = new([0.as_u8; 32]).unwrap
  assert_eq a.open([], [0.as_u8; 12], [0.as_u8; 15], []).err?.message || "", "chacha20poly1305: message authentication failed"
  assert_eq a.open([], [0.as_u8; 12], [0.as_u8; 16], []).err?.message || "", "chacha20poly1305: message authentication failed"
}

test "dst is kept" {
  a = new([7.as_u8; 32]).unwrap
  ct = a.seal([1.as_u8, 2], [0.as_u8; 12], [3.as_u8, 4, 5], [9.as_u8])
  assert_eq ct.size, 2 + 3 + 16
  assert_eq ct[0...2], [1.as_u8, 2]
  pt = a.open([8.as_u8], [0.as_u8; 12], ct[2...ct.size], [9.as_u8]).unwrap
  assert_eq pt, [8.as_u8, 3, 4, 5]
}

example "NewX" {
  # key should be randomly generated or derived from a function like Argon2.
  key = random_bytes(KEY_SIZE)
  aead = new_x(key).unwrap
  # Encryption.
  msg = "Gophers, gophers, gophers everywhere!".bytes
  # Select a random nonce, and append the ciphertext to it.
  nonce = random_bytes(aead.nonce_size)
  encrypted_msg = aead.seal(nonce, nonce, msg, [])
  # Decryption: split nonce and ciphertext.
  n2 = encrypted_msg[0...aead.nonce_size]
  ciphertext = encrypted_msg[aead.nonce_size...encrypted_msg.size]
  # Decrypt the message and check it wasn't tampered with.
  plaintext = aead.open([], n2, ciphertext, []).unwrap
  puts Str.from_bytes(plaintext)
} outputs "Gophers, gophers, gophers everywhere!\n"

bench "Seal 1K" {
  a = new([1.as_u8; 32]).unwrap
  a.seal([], [0.as_u8; 12], [2.as_u8; 1024], [3.as_u8; 13])
}
