# Package asn1: golang.org/x/crypto/cryptobyte/asn1, the ASN.1 tags
# cryptobyte reads and writes (low-tag-number form only).
#
#   Go                                  alx
#   type Tag uint8                      a Byte
#   t.Constructed() / ContextSpecific() constructed(t) / context_specific(t)
#   BOOLEAN ... GeneralString           BOOLEAN ... GENERAL_STRING
#
# Differences from Go: Tag is a plain Byte (alx can't name a Byte type with
# methods), so the two tag methods are functions. Go's mixed-case names
# (UTF8String, UTCTime, ...) are upper snake case like the others.
# Import it under another name next to encoding/asn1
# (`import cbasn1 "golang.org/x/crypto/cryptobyte/asn1"`).

CLASS_CONSTRUCTED: Byte = 0x20
CLASS_CONTEXT_SPECIFIC: Byte = 0x80

# The tag with the constructed bit set.
pub def constructed(t: Byte) -> Byte { t | CLASS_CONSTRUCTED }

# The tag with the context-specific class bit set.
pub def context_specific(t: Byte) -> Byte { t | CLASS_CONTEXT_SPECIFIC }

# The common universal tags.
pub BOOLEAN: Byte = 1
pub INTEGER: Byte = 2
pub BIT_STRING: Byte = 3
pub OCTET_STRING: Byte = 4
pub NULL: Byte = 5
pub OBJECT_IDENTIFIER: Byte = 6
pub ENUM: Byte = 10
pub UTF8_STRING: Byte = 12
pub SEQUENCE: Byte = 0x30
pub SET: Byte = 0x31
pub PRINTABLE_STRING: Byte = 19
pub T61_STRING: Byte = 20
pub IA5_STRING: Byte = 22
pub UTC_TIME: Byte = 23
pub GENERALIZED_TIME: Byte = 24
pub GENERAL_STRING: Byte = 27
