#![test(external)]
# Go's example_test.go.

import "golang.org/x/net/dns/dnsmessage"
import "strings"

example "Parser" {
  a1: [Byte; 4] = [127, 0, 0, 1]
  a2: [Byte; 4] = [127, 0, 0, 2]
  msg = dnsmessage.Message.new(
    header: dnsmessage.Header.new(response: true, authoritative: true),
    questions: [
      dnsmessage.Question.new(name: dnsmessage.must_new_name("foo.bar.example.com."), type: dnsmessage.TYPE_A, class: dnsmessage.CLASS_INET),
      dnsmessage.Question.new(name: dnsmessage.must_new_name("bar.example.com."), type: dnsmessage.TYPE_A, class: dnsmessage.CLASS_INET),
    ],
    answers: [
      dnsmessage.Resource.new(
        header: dnsmessage.ResourceHeader.new(name: dnsmessage.must_new_name("foo.bar.example.com."), type: dnsmessage.TYPE_A, class: dnsmessage.CLASS_INET),
        body: dnsmessage.AResource.new(a: a1).body,
      ),
      dnsmessage.Resource.new(
        header: dnsmessage.ResourceHeader.new(name: dnsmessage.must_new_name("bar.example.com."), type: dnsmessage.TYPE_A, class: dnsmessage.CLASS_INET),
        body: dnsmessage.AResource.new(a: a2).body,
      ),
    ],
  )

  buf = msg.pack.unwrap
  want_name = "bar.example.com."

  p = dnsmessage.Parser.new()
  p.start!(buf).unwrap

  loop {
    r = p.question!
    if e = r.err {
      break if dnsmessage.section_done?(e)
      panic(e.message)
    }
    q = r.unwrap
    next if q.name.to_s != want_name
    puts "Found question for name #{want_name}"
    p.skip_all_questions!.unwrap
    break
  }

  got_ips: [Str] = []
  loop {
    r = p.answer_header!
    if e = r.err {
      break if dnsmessage.section_done?(e)
      panic(e.message)
    }
    h = r.unwrap
    next if (h.type != dnsmessage.TYPE_A && h.type != dnsmessage.TYPE_AAAA) || h.class != dnsmessage.CLASS_INET
    if !strings.equal_fold(h.name.to_s, want_name) {
      p.skip_answer!.unwrap
      next
    }
    if h.type == dnsmessage.TYPE_A {
      a = p.a_resource!.unwrap.a
      got_ips << "#{a[0]}.#{a[1]}.#{a[2]}.#{a[3]}"
    } else {
      got_ips << "#{p.aaaa_resource!.unwrap.aaaa}"
    }
  }

  puts "Found A/AAAA records for name #{want_name}: [#{strings.join(got_ips, " ")}]"
} outputs "Found question for name bar.example.com.\nFound A/AAAA records for name bar.example.com.: [127.0.0.2]\n"
