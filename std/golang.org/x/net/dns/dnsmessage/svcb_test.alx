# Go's svcb_test.go, translated. The allocation tests run their bodies as
# plain tests.

def check_svcb_param_round_trip(p: SVCParam) {
  rr = SVCBResource.new(priority: 1, target: must_new_name("svc.example.com."), params: [p])
  empty: [Byte] = []
  buf = rr.pack_rdata(empty).unwrap
  got, n = unpack_resource_body(buf, 0, ResourceHeader.new(type: TYPE_SVCB, length: buf.size.as_u16)).unwrap
  assert_eq n, buf.size
  assert got == rr.body, "roundtrip mismatch: got = #{got.go_string}, want = #{rr.go_string}"
}

test "SVCBParamsRoundTrip" {
  v0: [Byte] = [0x00, 0x01, 0x00, 0x03, 0x00, 0x05]
  check_svcb_param_round_trip(SVCParam.new(key: SVC_PARAM_MANDATORY, value: v0))
  v1: [Byte] = [0x02, 104, 50, 0x02, 104, 51]
  check_svcb_param_round_trip(SVCParam.new(key: SVC_PARAM_ALPN, value: v1))
  check_svcb_param_round_trip(SVCParam.new(key: SVC_PARAM_NO_DEFAULT_ALPN, value: []))
  v3: [Byte] = [0x1f, 0x90]
  check_svcb_param_round_trip(SVCParam.new(key: SVC_PARAM_PORT, value: v3))
  v4: [Byte] = [192, 0, 2, 1, 198, 51, 100, 2]
  check_svcb_param_round_trip(SVCParam.new(key: SVC_PARAM_IPV4_HINT, value: v4))
  v5: [Byte] = [0x01, 0x02, 0x03, 0x04]
  check_svcb_param_round_trip(SVCParam.new(key: SVC_PARAM_ECH, value: v5))
  v6: [Byte] = [0x20, 0x01, 0x0d, 0xb8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01]
  check_svcb_param_round_trip(SVCParam.new(key: SVC_PARAM_IPV6_HINT, value: v6))
  check_svcb_param_round_trip(SVCParam.new(key: SVC_PARAM_DOH_PATH, value: "/dns-query{?dns}".bytes))
  v8: [Byte] = [0x00, 0x01, 0x02, 0x03]
  check_svcb_param_round_trip(SVCParam.new(key: SVC_PARAM_OHTTP, value: v8))
  v9: [Byte] = [0x00, 0x1d, 0x00, 0x17]
  check_svcb_param_round_trip(SVCParam.new(key: SVC_PARAM_TLS_SUPPORTED_GROUPS, value: v9))
}

test "SVCBParsing" {
  # TestSVCBParsingAllocs, without the allocation count.
  name = must_new_name("foo.bar.example.com.")
  m0: [Byte] = [0x00, 0x01, 0x00, 0x03, 0x00, 0x05]
  alpn: [Byte] = [0x02, 104, 50, 0x02, 104, 51]
  port: [Byte] = [0x1f, 0x90]
  v4: [Byte] = [192, 0, 2, 1, 198, 51, 100, 2]
  v6: [Byte] = [0x20, 0x01, 0x0d, 0xb8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01]
  svcb = SVCBResource.new(
    priority: 1,
    target: must_new_name("svc.example.com."),
    params: [
      SVCParam.new(key: SVC_PARAM_MANDATORY, value: m0),
      SVCParam.new(key: SVC_PARAM_ALPN, value: alpn),
      SVCParam.new(key: SVC_PARAM_PORT, value: port),
      SVCParam.new(key: SVC_PARAM_IPV4_HINT, value: v4),
      SVCParam.new(key: SVC_PARAM_IPV6_HINT, value: v6),
    ],
  )
  msg = Message.new(
    header: Header.new(response: true, authoritative: true),
    questions: [Question.new(name: name, type: TYPE_A, class: CLASS_INET)],
    answers: [Resource.new(header: ResourceHeader.new(name: name, type: TYPE_SVCB, class: CLASS_INET, ttl: 300), body: svcb.body)],
  )
  buf = msg.pack.unwrap
  p = Parser.new()
  p.start!(buf).unwrap
  p.skip_all_questions!.unwrap
  p.answer_header!.unwrap
  got = p.svcb_resource!.unwrap
  assert got == svcb, "got #{got.go_string}"
}

test "HTTPSBuild" {
  # TestHTTPSBuildAllocs, without the allocation count.
  empty: [Byte] = []
  b = new_builder(empty, Header.new(response: true, authoritative: true))
  b.enable_compression!
  b.start_questions!.unwrap
  b.question!(Question.new(name: must_new_name("foo.bar.example.com."), type: TYPE_HTTPS, class: CLASS_INET)).unwrap
  b.start_answers!.unwrap
  header = ResourceHeader.new(name: must_new_name("foo.bar.example.com."), type: TYPE_HTTPS, class: CLASS_INET, ttl: 300)
  resource = HTTPSResource.new(priority: 1, target: must_new_name("svc.example.com."))
  b.https_resource!(header, resource).unwrap
  b.https_resource!(header, resource).unwrap
  msg = b.finish!.unwrap
  m = unpack_message(msg).unwrap
  assert_eq m.answers.size, 2
  assert m.answers[1].body == resource.body
}

test "SVCBParams" {
  rr = SVCBResource.new(priority: 1, target: must_new_name("svc.example.com."))
  assert rr.get_param(SVC_PARAM_ALPN).none?, "get_param found non-existent param"
  hint: [Byte] = [192, 0, 2, 1]
  rr.set_param!(SVC_PARAM_IPV4_HINT, hint)
  in_alpn: [Byte] = [0x02, 104, 50, 0x02, 104, 51]
  rr.set_param!(SVC_PARAM_ALPN, in_alpn)

  # The params are kept sorted.
  empty: [Byte] = []
  packed = rr.pack_rdata(empty).unwrap
  expected: [Byte] = [
    0x00, 0x01,
    0x03, 0x73, 0x76, 0x63, 0x07, 0x65, 0x78, 0x61, 0x6d, 0x70, 0x6c, 0x65, 0x03, 0x63, 0x6f, 0x6d, 0x00,
    0x00, 0x01,
    0x00, 0x06,
    0x02, 104, 50, 0x02, 104, 51,
    0x00, 0x04,
    0x00, 0x04,
    192, 0, 2, 1,
  ]
  assert packed == expected, "pack produced unexpected output: want = #{expected}, got = #{packed}"

  out_alpn = rr.get_param(SVC_PARAM_ALPN) || fail Failure.Msg("get_param failed to retrieve set param")
  assert out_alpn == in_alpn
  assert rr.delete_param!(SVC_PARAM_ALPN), "delete_param failed to remove existing param"
  assert rr.get_param(SVC_PARAM_ALPN).none?, "get_param found deleted param"
  assert rr.params.size == 1 && rr.params[0].key == SVC_PARAM_IPV4_HINT, "delete_param removed wrong param"
  # Setting an existing key replaces its value.
  v2: [Byte] = [10, 0, 0, 1]
  rr.set_param!(SVC_PARAM_IPV4_HINT, v2)
  assert_eq rr.params.size, 1
  assert rr.params[0].value == v2
  assert !rr.delete_param!(SVC_PARAM_ALPN)
}

def check_svcb_wire(bytes_input: [Byte], parsed_input: SVCBResource) {
  parsed_output, n = unpack_resource_body(bytes_input, 0, ResourceHeader.new(type: TYPE_SVCB, length: bytes_input.size.as_u16)).unwrap
  assert_eq n, bytes_input.size
  assert parsed_output == parsed_input.body, "unpack mismatch: got = #{parsed_output.go_string}, want = #{parsed_input.go_string}"
  empty: [Byte] = []
  bytes_output = parsed_input.pack_rdata(empty).unwrap
  assert bytes_output == bytes_input, "pack mismatch: got = #{bytes_output}, want = #{bytes_input}"
}

def foo_example_com -> [Byte] {
  t: [Byte] = [0x03, 0x66, 0x6f, 0x6f, 0x07, 0x65, 0x78, 0x61, 0x6d, 0x70, 0x6c, 0x65, 0x03, 0x63, 0x6f, 0x6d, 0x00]
  t
}

def foo_example_org -> [Byte] {
  t: [Byte] = [0x03, 0x66, 0x6f, 0x6f, 0x07, 0x65, 0x78, 0x61, 0x6d, 0x70, 0x6c, 0x65, 0x03, 0x6f, 0x72, 0x67, 0x00]
  t
}

def wire(priority: Int, target: [Byte], params: [Byte]) -> [Byte] {
  p: [Byte] = [(priority >> 8).as_u8, priority.as_u8]
  p + target + params
}

test "SVCBWireFormat" {
  # The test vectors of RFC 9460 appendix D.

  # Figure 2: AliasMode. example.com. HTTPS 0 foo.example.com.
  check_svcb_wire(wire(0, foo_example_com(), []), SVCBResource.new(priority: 0, target: must_new_name("foo.example.com.")))

  # Figure 3: TargetName is ".". example.com. SVCB 1 .
  root: [Byte] = [0x00]
  check_svcb_wire(wire(1, root, []), SVCBResource.new(priority: 1, target: must_new_name(".")))

  # Figure 4: a port. example.com. SVCB 16 foo.example.com. port=53
  p4: [Byte] = [0x00, 0x03, 0x00, 0x02, 0x00, 0x35]
  v4: [Byte] = [0x00, 0x35]
  check_svcb_wire(
    wire(16, foo_example_com(), p4),
    SVCBResource.new(priority: 16, target: must_new_name("foo.example.com."), params: [SVCParam.new(key: SVC_PARAM_PORT, value: v4)]),
  )

  # Figure 5: a generic key and unquoted value. key667=hello
  p5: [Byte] = [0x02, 0x9b, 0x00, 0x05, 0x68, 0x65, 0x6c, 0x6c, 0x6f]
  check_svcb_wire(
    wire(1, foo_example_com(), p5),
    SVCBResource.new(priority: 1, target: must_new_name("foo.example.com."), params: [SVCParam.new(key: 667, value: "hello".bytes)]),
  )

  # Figure 6: a generic key and quoted value with a decimal escape.
  # key667="hello\210qoo"
  p6: [Byte] = [0x02, 0x9b, 0x00, 0x09, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xd2, 0x71, 0x6f, 0x6f]
  v6: [Byte] = [0x68, 0x65, 0x6c, 0x6c, 0x6f, 0xd2, 0x71, 0x6f, 0x6f]
  check_svcb_wire(
    wire(1, foo_example_com(), p6),
    SVCBResource.new(priority: 1, target: must_new_name("foo.example.com."), params: [SVCParam.new(key: 667, value: v6)]),
  )

  # Figure 7: two quoted IPv6 hints. ipv6hint="2001:db8::1,2001:db8::53:1"
  a1: [Byte] = [0x20, 0x01, 0x0d, 0xb8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01]
  a2: [Byte] = [0x20, 0x01, 0x0d, 0xb8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x53, 0x00, 0x01]
  k7: [Byte] = [0x00, 0x06, 0x00, 0x20]
  check_svcb_wire(
    wire(1, foo_example_com(), k7 + a1 + a2),
    SVCBResource.new(priority: 1, target: must_new_name("foo.example.com."), params: [SVCParam.new(key: SVC_PARAM_IPV6_HINT, value: a1 + a2)]),
  )

  # Figure 8: an IPv6 hint in the embedded IPv4 syntax.
  # example.com. SVCB 1 example.com. ipv6hint="2001:db8:122:344::192.0.2.33"
  example_com: [Byte] = [0x07, 0x65, 0x78, 0x61, 0x6d, 0x70, 0x6c, 0x65, 0x03, 0x63, 0x6f, 0x6d, 0x00]
  a8: [Byte] = [0x20, 0x01, 0x0d, 0xb8, 0x01, 0x22, 0x03, 0x44, 0x00, 0x00, 0x00, 0x00, 0xc0, 0x00, 0x02, 0x21]
  k8: [Byte] = [0x00, 0x06, 0x00, 0x10]
  check_svcb_wire(
    wire(1, example_com, k8 + a8),
    SVCBResource.new(priority: 1, target: must_new_name("example.com."), params: [SVCParam.new(key: SVC_PARAM_IPV6_HINT, value: a8)]),
  )

  # Figure 9: keys sorted in wire format.
  # example.com. SVCB 16 foo.example.org. alpn=h2,h3-19 mandatory=ipv4hint,alpn ipv4hint=192.0.2.1
  p9: [Byte] = [
    0x00, 0x00, 0x00, 0x04, 0x00, 0x01, 0x00, 0x04,
    0x00, 0x01, 0x00, 0x09, 0x02, 0x68, 0x32, 0x05, 0x68, 0x33, 0x2d, 0x31, 0x39,
    0x00, 0x04, 0x00, 0x04, 0xc0, 0x00, 0x02, 0x01,
  ]
  m9: [Byte] = [0x00, 0x01, 0x00, 0x04]
  alpn9: [Byte] = [0x02, 0x68, 0x32, 0x05, 0x68, 0x33, 0x2d, 0x31, 0x39]
  hint9: [Byte] = [0xc0, 0x00, 0x02, 0x01]
  check_svcb_wire(
    wire(16, foo_example_org(), p9),
    SVCBResource.new(
      priority: 16,
      target: must_new_name("foo.example.org."),
      params: [
        SVCParam.new(key: SVC_PARAM_MANDATORY, value: m9),
        SVCParam.new(key: SVC_PARAM_ALPN, value: alpn9),
        SVCParam.new(key: SVC_PARAM_IPV4_HINT, value: hint9),
      ],
    ),
  )

  # Figure 10: an alpn value with an escaped comma and backslash.
  # example.com. SVCB 16 foo.example.org. alpn=f\\\092oo\092,bar,h2
  alpn10: [Byte] = [0x08, 0x66, 0x5c, 0x6f, 0x6f, 0x2c, 0x62, 0x61, 0x72, 0x02, 0x68, 0x32]
  k10: [Byte] = [0x00, 0x01, 0x00, 0x0c]
  check_svcb_wire(
    wire(16, foo_example_org(), k10 + alpn10),
    SVCBResource.new(priority: 16, target: must_new_name("foo.example.org."), params: [SVCParam.new(key: SVC_PARAM_ALPN, value: alpn10)]),
  )
}

test "SVCBPackErrors" {
  long_value: [Byte] = [0; 65536]
  tests: [(Str, SVCBResource)] = [
    ("long value", SVCBResource.new(target: must_new_name("example.com."), params: [SVCParam.new(key: SVC_PARAM_MANDATORY, value: long_value)])),
    (
      "out-of-order keys",
      SVCBResource.new(
        target: must_new_name("example.com."),
        params: [SVCParam.new(key: SVC_PARAM_PORT, value: "443".bytes), SVCParam.new(key: SVC_PARAM_ALPN, value: "h2".bytes)],
      ),
    ),
    (
      "duplicate keys",
      SVCBResource.new(
        target: must_new_name("example.com."),
        params: [SVCParam.new(key: SVC_PARAM_ALPN, value: "h3".bytes), SVCParam.new(key: SVC_PARAM_ALPN, value: "h2".bytes)],
      ),
    ),
  ]
  for t in tests {
    empty: [Byte] = []
    b = new_builder(empty, Header.new())
    b.start_questions!.unwrap
    b.start_answers!.unwrap
    assert b.svcb_resource!(ResourceHeader.new(name: must_new_name("example.com.")), t[1]).err?, "#{t[0]}: b.svcb_resource! succeeded; want error"

    b = new_builder(empty, Header.new())
    b.start_questions!.unwrap
    b.start_answers!.unwrap
    assert b.https_resource!(ResourceHeader.new(name: must_new_name("example.com.")), t[1].https_resource).err?, "#{t[0]}: b.https_resource! succeeded; want error"
  }
}

test "SVCParamKey strings" {
  assert_eq svc_param_key_string(SVC_PARAM_ALPN), "ALPN"
  assert_eq svc_param_key_string(667), "667"
  assert_eq svc_param_key_go_string(SVC_PARAM_IPV6_HINT), "dnsmessage.SVCParamIPv6Hint"
  h = HTTPSResource.new(priority: 2, target: must_new_name("a."))
  assert_eq h.go_string, "dnsmessage.HTTPSResource{SVCBResource: dnsmessage.SVCBResource{Priority: 2, Target: dnsmessage.MustNewName(\"a.\"), Params: []dnsmessage.SVCParam{}}}"
  assert h.svcb_resource.https_resource == h
}
