#![overflow(wrap)]
# Package adler32: Go's hash/adler32, the Adler-32 checksum (RFC 1950).
#
#   Go                                  alx
#   adler32.Size                        SIZE
#   adler32.New() hash.Hash32           new() -> Digest
#   adler32.Checksum(data) uint32       checksum(data) -> U32
#   d.Write(p) (int, error)             d.write!(p) -> Int (never fails)
#   d.Sum(b) / Sum32 / Reset            d.sum(b) / d.sum32 / d.reset!
#   d.Size / BlockSize                  d.size / d.block_size
#   d.MarshalBinary / AppendBinary      d.marshal_binary / d.append_binary(b) (never fail)
#   d.UnmarshalBinary(b) error          d.unmarshal_binary!(b) -> ~Unit<StateError>
#   d.Clone() (hash.Cloner, error)      d.clone -> Digest
#
# A Digest satisfies hash.Hash and hash.Hash32 structurally.
#
# Differences from Go:
#   - A Digest keeps its state in shared storage (GO-VS-RUBY D36), so copies of
#     a Digest are the same hash, as Go's pointer is; `clone` makes an
#     independent one. Use new: a zero `Digest.new` has no state.
#   - Clone, MarshalBinary and AppendBinary can't fail, so they return plain values.

# The size of an Adler-32 checksum in bytes.
pub SIZE = 4

# The largest prime less than 65536.
MOD: U32 = 65521
# The largest n such that 255 * n * (n+1) / 2 + (n+1) * (MOD-1) <= 2^32-1
# (RFC 1950's 5552).
NMAX = 5552

# Errors of Digest.unmarshal_binary!.
pub error StateError {
  InvalidIdentifier
  InvalidSize

  def message -> Str {
    case self {
      InvalidIdentifier => "hash/adler32: invalid hash state identifier"
      InvalidSize => "hash/adler32: invalid hash state size"
    }
  }
}

# Adds p to the state d (s2 << 16 | s1).
def update(d: U32, p: [Byte]) -> U32 {
  s1 = d & 0xffff
  s2 = d >> 16
  n = p.size
  i = 0
  while i < n {
    stop = i + NMAX
    stop = n if stop > n
    while stop - i >= 4 {
      s1 += p[i].as_u32
      s2 += s1
      s1 += p[i + 1].as_u32
      s2 += s1
      s1 += p[i + 2].as_u32
      s2 += s1
      s1 += p[i + 3].as_u32
      s2 += s1
      i += 4
    }
    while i < stop {
      s1 += p[i].as_u32
      s2 += s1
      i += 1
    }
    s1 = s1 % MOD
    s2 = s2 % MOD
  }
  (s2 << 16) | s1
}

# The Adler-32 checksum of data.
pub def checksum(data: [Byte]) -> U32 {
  update(1, data)
}

# A new running Adler-32 checksum.
pub def new -> Digest {
  Digest.new(st: [1.as_u32])
}

MAGIC = "adl\x01"
MARSHALED_SIZE = 8

def put_be32(b: [Byte], v: U32) -> [Byte] {
  out = b
  out << (v >> 24).as_u8
  out << (v >> 16).as_u8
  out << (v >> 8).as_u8
  out << v.as_u8
  out
}

# Whether b starts with the bytes of s.
def has_magic(b: [Byte], s: Str) -> Bool {
  return false if b.size < s.size
  i = 0
  while i < s.size {
    return false if b[i] != s[i]
    i += 1
  }
  true
}

# A running Adler-32 checksum (Go's hash.Hash32 returned by New).
pub struct Digest {
  st: [U32]

  # The checksum size in bytes.
  pub def size -> Int { SIZE }

  # The block size: 4.
  pub def block_size -> Int { 4 }

  # Back to the initial state.
  pub def reset! {
    self.st[0] = 1
    nil
  }

  # Adds p to the running checksum; returns p.size.
  pub def write!(p: [Byte]) -> Int {
    self.st[0] = update(st[0], p)
    p.size
  }

  # The current checksum.
  pub def sum32 -> U32 { st[0] }

  # b with the current checksum appended, big-endian. The state is unchanged.
  pub def sum(b: [Byte]) -> [Byte] {
    put_be32(b, st[0])
  }

  # An independent copy of the hash in its current state.
  pub def clone -> Digest {
    Digest.new(st: [st[0]])
  }

  # b with the marshaled state appended (Go's AppendBinary).
  pub def append_binary(b: [Byte]) -> [Byte] {
    out = b
    for c in MAGIC.bytes {
      out << c
    }
    put_be32(out, st[0])
  }

  # The marshaled state (Go's MarshalBinary).
  pub def marshal_binary -> [Byte] {
    append_binary([])
  }

  # Restores a state from marshal_binary.
  pub def unmarshal_binary!(b: [Byte]) -> ~Unit<StateError> {
    fail StateError.InvalidIdentifier if !has_magic(b, MAGIC)
    fail StateError.InvalidSize if b.size != MARSHALED_SIZE
    self.st[0] = (b[4].as_u32 << 24) | (b[5].as_u32 << 16) | (b[6].as_u32 << 8) | b[7].as_u32
  }
}
