# Generated from Go's hash/adler32 (go1.27.1): sums of texts and seeded random bytes,
# chunked writes and marshaled states; do not edit by hand.

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

# Writes p to a fresh hash in chunks whose sizes cycle through `chunks`.
def chunked(p: [Byte], chunks: [Int]) -> [[Byte]] {
  parts: [[Byte]] = []
  off = 0
  k = 0
  while off < p.size {
    n = chunks[k % chunks.size]
    n = p.size - off if n > p.size - off
    parts << p[off...off + n]
    off += n
    k += 1
  }
  parts
}

def chk(p: [Byte], want: U32) {
  assert_eq checksum(p), want
}

def chunks(p: [Byte], sizes: [Int], want: U32) {
  h = new()
  for part in chunked(p, sizes) {
    h.write!(part)
  }
  assert_eq h.sum32, want
}

def marshaled(p: [Byte], want: Str) {
  h = new()
  h.write!(p)
  assert_eq hex(h.marshal_binary), want
}

def hex(p: [Byte]) -> Str {
  digits = "0123456789abcdef"
  out: [Byte] = []
  for x in p {
    out << digits[(x >> 4).to_i]
    out << digits[(x & 15).to_i]
  }
  Str.from_bytes(out)
}

test "adler32 sums" {
  chk(b(""), 0x00000001)
  chk(b("a"), 0x00620062)
  chk(b("abc"), 0x024d0127)
  chk(b("message digest"), 0x29750586)
  chk(b("abcdefghijklmnopqrstuvwxyz"), 0x90860b20)
  chk(b("The quick brown fox jumps over the lazy dog"), 0x5bdc0fda)
  chk(b("The quick brown fox jumps over the lazy dog."), 0x6be41008)
  chk(b("h") + by([0xc3, 0xa9]) + b("llo w") + by([0xc3, 0xb6]) + b("rld, ") + by([0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0xe8, 0xaa, 0x9e]) + b(" ") + by([0xe2, 0x98, 0x83]), 0xd2d50f57)
  chk(b("123456789"), 0x091e01de)
  chk(b("\x00\x01\x02\x03"), 0x000e0007)
  chk(gen(1, 0), 0x00000001)
  chk(gen(8, 1), 0x00370037)
