test "adler32 chunked writes" {
  chunks(b("abc"), [3], 0x024d0127)
  chunks(b("abc"), [13], 0x024d0127)
  chunks(b("abc"), [1, 2, 3, 5, 8, 13], 0x024d0127)
  chunks(b("message digest"), [1], 0x29750586)
  chunks(b("message digest"), [8], 0x29750586)
  chunks(b("message digest"), [100], 0x29750586)
  chunks(b("message digest"), [4096, 1], 0x29750586)
  chunks(b("abcdefghijklmnopqrstuvwxyz"), [7], 0x90860b20)
  chunks(b("abcdefghijklmnopqrstuvwxyz"), [64], 0x90860b20)
  chunks(b("abcdefghijklmnopqrstuvwxyz"), [5552], 0x90860b20)
