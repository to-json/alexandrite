  chunks(b("The quick brown fox jumps over the lazy dog"), [1, 2, 3, 5, 8, 13], 0x5bdc0fda)
  chunks(b("The quick brown fox jumps over the lazy dog."), [1], 0x6be41008)
  chunks(b("The quick brown fox jumps over the lazy dog."), [8], 0x6be41008)
  chunks(b("The quick brown fox jumps over the lazy dog."), [100], 0x6be41008)
  chunks(b("The quick brown fox jumps over the lazy dog."), [4096, 1], 0x6be41008)
