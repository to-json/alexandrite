test "crc32 chunked writes" {
  chunks(b("abc"), [3], 0x352441c2, 0x364b3fb7, 0xba2322ac)
  chunks(b("abc"), [13], 0x352441c2, 0x364b3fb7, 0xba2322ac)
  chunks(b("abc"), [1, 2, 3, 5, 8, 13], 0x352441c2, 0x364b3fb7, 0xba2322ac)
  chunks(b("message digest"), [1], 0x20159d7f, 0x02bd79d0, 0x203ea0c7)
