# Generated from Go's hash/crc32 (go1.27.1): sums of texts and seeded random bytes for
# every polynomial, updates from a nonzero crc, chunked writes and marshaled states;
# do not edit by hand.

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

# Writes p to a fresh hash in chunks whose sizes cycle through `chunks`.
def chunked(p: [Byte], chunks: [Int]) -> [[Byte]] {
  parts: [[Byte]] = []
  off = 0
  k = 0
  while off < p.size {
    n = chunks[k % chunks.size]
    n = p.size - off if n > p.size - off
    parts << p[off...off + n]
    off += n
    k += 1
  }
  parts
}

def chk(p: [Byte], ieee: U32, cast: U32, koop: U32, d5: U32) {
  assert_eq checksum_ieee(p), ieee
  assert_eq checksum(p, make_table(CASTAGNOLI)), cast
  assert_eq checksum(p, make_table(KOOPMAN)), koop
  assert_eq checksum(p, make_table(0xd5828281)), d5
}

def upd(p: [Byte], init: U32, ieee: U32, cast: U32, koop: U32) {
  assert_eq update(init, ieee_table(), p), ieee
  assert_eq update(init, make_table(CASTAGNOLI), p), cast
  assert_eq update(init, make_table(KOOPMAN), p), koop
}

def chunks(p: [Byte], sizes: [Int], ieee: U32, cast: U32, koop: U32) {
  hi = new_ieee()
  hc = new(make_table(CASTAGNOLI))
  hk = new(make_table(KOOPMAN))
  for part in chunked(p, sizes) {
    hi.write!(part)
    hc.write!(part)
    hk.write!(part)
  }
  assert_eq hi.sum32, ieee
  assert_eq hc.sum32, cast
  assert_eq hk.sum32, koop
}

def marshaled(p: [Byte], ieee: Str, cast: Str) {
  hi = new_ieee()
  hc = new(make_table(CASTAGNOLI))
  hi.write!(p)
  hc.write!(p)
  assert_eq hex(hi.marshal_binary), ieee
  assert_eq hex(hc.marshal_binary), cast
}

def hex(p: [Byte]) -> Str {
  digits = "0123456789abcdef"
  out: [Byte] = []
  for x in p {
    out << digits[(x >> 4).to_i]
    out << digits[(x & 15).to_i]
  }
  Str.from_bytes(out)
}

