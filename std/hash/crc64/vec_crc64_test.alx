test "crc64 update from a nonzero crc" {
  upd(b(""), 0xe220a8397b1dcdaf, 0xe220a8397b1dcdaf, 0xe220a8397b1dcdaf, 0xe220a8397b1dcdaf)
  upd(b("a"), 0x910a2dec89025cc1, 0x81010a2dec89025c, 0x2d67bebbfd0ffed5, 0xb99bb734be5293c3)
  upd(b("abc"), 0x975835de1c9756ce, 0xf014d8975835de1c, 0x178414c5a09c802b, 0xfcc247e444e39c99)
  upd(b("message digest"), 0x1d0b14e4db018fed, 0xe0a523b650f3cb5d, 0xf9166b842dfc5578, 0x4478f742ea272fca)
  upd(b("abcdefghijklmnopqrstuvwxyz"), 0x6e73e372e2338aca, 0xb1f6590addeec988, 0x202702d82ca43f11, 0xe03cb5e850dc8bfb)
  upd(b("The quick brown fox jumps over the lazy dog"), 0x63033b0ca389c35a, 0x7f6cff14e75c614f, 0xf136a49b2d6808b4, 0x4969dd58d1b8e121)
  upd(b("The quick brown fox jumps over the lazy dog."), 0xbd64a5d9adefe000, 0xfc82bcc227cd28c2, 0x8fd1884a47251e68, 0xbb4301a932bedf98)
  upd(b("h") + by([0xc3, 0xa9]) + b("llo w") + by([0xc3, 0xb6]) + b("rld, ") + by([0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0xe8, 0xaa, 0x9e]) + b(" ") + by([0xe2, 0x98, 0x83]), 0x63cbe1e459320dd7, 0xab8facd8439f8c31, 0xb516f0abee89f581, 0x8809fe0269ce55ab)
