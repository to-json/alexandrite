# Generated from Go's hash/crc64 (go1.27.1): sums of texts and seeded random bytes for
# ISO, ECMA and a custom polynomial, updates from a nonzero crc, chunked writes and
# marshaled states; do not edit by hand.

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

# Writes p to a fresh hash in chunks whose sizes cycle through `chunks`.
def chunked(p: [Byte], chunks: [Int]) -> [[Byte]] {
  parts: [[Byte]] = []
  off = 0
  k = 0
  while off < p.size {
    n = chunks[k % chunks.size]
    n = p.size - off if n > p.size - off
    parts << p[off...off + n]
    off += n
    k += 1
  }
  parts
}

def chk(p: [Byte], iso: U64, ecma: U64, custom: U64) {
  assert_eq checksum(p, make_table(ISO)), iso
  assert_eq checksum(p, make_table(ECMA)), ecma
  assert_eq checksum(p, make_table(0x95ac9329ac4bc9b5)), custom
}

def upd(p: [Byte], init: U64, iso: U64, ecma: U64, custom: U64) {
  assert_eq update(init, make_table(ISO), p), iso
  assert_eq update(init, make_table(ECMA), p), ecma
  assert_eq update(init, make_table(0x95ac9329ac4bc9b5), p), custom
}

def chunks(p: [Byte], sizes: [Int], iso: U64, ecma: U64, custom: U64) {
  hi = new(make_table(ISO))
  he = new(make_table(ECMA))
  hc = new(make_table(0x95ac9329ac4bc9b5))
  for part in chunked(p, sizes) {
    hi.write!(part)
    he.write!(part)
    hc.write!(part)
  }
  assert_eq hi.sum64, iso
  assert_eq he.sum64, ecma
  assert_eq hc.sum64, custom
}

def marshaled(p: [Byte], iso: Str, ecma: Str) {
  hi = new(make_table(ISO))
  he = new(make_table(ECMA))
  hi.write!(p)
  he.write!(p)
  assert_eq hex(hi.marshal_binary), iso
  assert_eq hex(he.marshal_binary), ecma
}

def hex(p: [Byte]) -> Str {
  digits = "0123456789abcdef"
  out: [Byte] = []
  for x in p {
    out << digits[(x >> 4).to_i]
    out << digits[(x & 15).to_i]
  }
  Str.from_bytes(out)
}

