import "hash"

# Go's fnv_test.go, translated. The golden tables are in golden_test.alx.

test "hash interface" {
  check_hash(->() -> hash.Hash { new32() })
  check_hash(->() -> hash.Hash { new32a() })
  check_hash(->() -> hash.Hash { new64() })
  check_hash(->() -> hash.Hash { new64a() })
  check_hash(->() -> hash.Hash { new128() })
  check_hash(->() -> hash.Hash { new128a() })
}

# The Clone subtest of Go's testhash.TestHash. `clone` returns each concrete
# type, so the caller passes h, a clone of it made before any write (h3), and
# a function cloning h (called after the prefix is written).
def check_clone(h0: hash.Hash, h30: hash.Hash, clone_h: () -> hash.Hash) {
  h = h0
  h3 = h30
  prefix = b("tmp")
  h.write!(prefix)
  h2 = clone_h()
  prefix_sum = h.sum([])
  assert_eq prefix_sum, h2.sum([])
  suffix = b("tmp2")
  h.write!(suffix)
  h3.write!(prefix + suffix)
  composite = h3.sum([])
  assert_eq h.sum([]), composite
  assert_eq h2.sum([]), prefix_sum
  h2.write!(suffix)
  assert_eq h.sum([]), composite
  assert_eq h2.sum([]), composite
}

test "clone" {
  h32 = new32()
  check_clone(h32, h32.clone, ->() -> hash.Hash { h32.clone })
  h32a = new32a()
  check_clone(h32a, h32a.clone, ->() -> hash.Hash { h32a.clone })
  h64 = new64()
  check_clone(h64, h64.clone, ->() -> hash.Hash { h64.clone })
  h64a = new64a()
  check_clone(h64a, h64a.clone, ->() -> hash.Hash { h64a.clone })
  h128 = new128()
  check_clone(h128, h128.clone, ->() -> hash.Hash { h128.clone })
  h128a = new128a()
  check_clone(h128a, h128a.clone, ->() -> hash.Hash { h128a.clone })
}

def check_golden(h0: hash.Hash, gold: [Golden]) {
  h = h0
  for g in gold {
    h.reset!
    done = h.write!(g.input).unwrap
    assert_eq done, g.input.size
    assert_eq h.sum([]), g.out
  }
}

test "golden32" { check_golden(new32(), golden32()) }
test "golden32a" { check_golden(new32a(), golden32a()) }
test "golden64" { check_golden(new64(), golden64()) }
test "golden64a" { check_golden(new64a(), golden64a()) }
test "golden128" { check_golden(new128(), golden128()) }
test "golden128a" { check_golden(new128a(), golden128a()) }

test "golden marshal 32" {
  for g in golden32() {
    h = new32()
    h2 = new32()
    half = g.input.size / 2
    h.write!(g.input[0...half])
    state = h.marshal_binary
    prefix: [Byte] = [0, 0, 0, 0]
    state_append = h.append_binary(prefix)
    assert_eq state, g.half_state
    assert_eq state_append[4...state_append.size], g.half_state
    h2.unmarshal_binary!(state).unwrap
    h.write!(g.input[half...g.input.size])
    h2.write!(g.input[half...g.input.size])
    assert_eq h.sum([]), h2.sum([])
  }
}

