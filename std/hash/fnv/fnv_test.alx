test "unmarshal errors" {
  h = new32()
  r = h.unmarshal_binary!(b("fnv\x02\x00\x00\x00\x00"))
  assert_eq "#{r.err.unwrap}", "hash/fnv: invalid hash state identifier"
  r2 = h.unmarshal_binary!(b("fnv\x01\x00"))
  assert_eq "#{r2.err.unwrap}", "hash/fnv: invalid hash state size"
  h128 = new128a()
  r3 = h128.unmarshal_binary!(new128().marshal_binary)
  assert_eq "#{r3.err.unwrap}", "hash/fnv: invalid hash state identifier"
}

# Go's testIntegrity: returns the sum for the size-specific checks.
def check_integrity(h0: hash.Hash) -> [Byte] {
  h = h0
  data: [Byte] = [0x31, 0x32, 3, 4, 5]
  h.write!(data)
  sum = h.sum([])
  assert_eq h.size, sum.size
  assert_eq h.sum([]), sum
  h.reset!
  h.write!(data)
  assert_eq h.sum([]), sum
  h.reset!
  h.write!(data[0...2])
  h.write!(data[2...data.size])
  assert_eq h.sum([]), sum
  sum
}

test "integrity32" {
  h = new32()
  sum = check_integrity(h)
  assert_eq h.sum32, be32(sum, 0)
}

test "integrity32a" {
  h = new32a()
  sum = check_integrity(h)
  assert_eq h.sum32, be32(sum, 0)
}

test "integrity64" {
  h = new64()
  sum = check_integrity(h)
  assert_eq h.sum64, be64(sum, 0)
}

test "integrity64a" {
  h = new64a()
  sum = check_integrity(h)
  assert_eq h.sum64, be64(sum, 0)
}

test "integrity128" {
  check_integrity(new128())
}

test "integrity128a" {
  check_integrity(new128a())
}

test "mul64" {
  hi, lo = mul64(0xffffffffffffffff, 0xffffffffffffffff)
  assert_eq hi, 0xfffffffffffffffe
  assert_eq lo, 1
  hi2, lo2 = mul64(0x13b, 0x62b821756295c58d)
  assert_eq hi2, 0x79
  assert_eq lo2, 0x78912b704e4a147f
}

example "fnv128a" {
  h = new128a()
  h.write!(b("Hello world"))
  puts hex(h.sum([]))
} outputs "3e2069a3a2839515f3e747cab303a0d7\n"

# Go's benchmarkKB, 1024 times over.
def bench_kb(h0: hash.Hash) {
  h = h0
  data: [Byte] = []
  i = 0
  while i < 1024 {
    data << i.as_u8
    i += 1
  }
  k = 0
  while k < 1024 {
    h.write!(data)
    k += 1
  }
  h.sum([])
}

bench "fnv32 1MB" { bench_kb(new32()) }
bench "fnv32a 1MB" { bench_kb(new32a()) }
bench "fnv64 1MB" { bench_kb(new64()) }
bench "fnv64a 1MB" { bench_kb(new64a()) }
bench "fnv128 1MB" { bench_kb(new128()) }
bench "fnv128a 1MB" { bench_kb(new128a()) }

# Go's internal/testhash.TestHashWithoutClone, for a constructor of hashes.
# (Clone is tested per type: hash.Hash has no clone.) Go's random bytes are
# seeded generator bytes here.
def check_hash(mk: () -> hash.Hash) {
  # SumAppend: sum appends a digest of size bytes and leaves the prefix alone.
  h = mk()
  long_buff = gen(1, h.block_size + 1)
  prefixes: [[Byte]] = [[], b("a"), long_buff]
  for prefix in prefixes {
    h.reset!
    s = get_sum(h, prefix)
    assert_eq s[0...prefix.size], prefix
    assert_eq s[prefix.size...s.size], get_sum(h, [])
    assert_eq s.size - prefix.size, h.size
  }

  # WriteWithoutError: write! reports every byte and leaves p alone.
  h = mk()
  slices: [[Byte]] = [[], b("a"), gen(2, h.block_size + 1)]
  for p in slices {
    write_to_hash(h, p)
  }

  # ResetState: a reset hash sums like a new one.
  h = mk()
  empty_sum = get_sum(h, [])
  write_to_hash(h, gen(3, h.block_size))
  h.reset!
  assert_eq get_sum(h, []), empty_sum

  # OutOfBoundsRead: write! reads only its slice.
  h = mk()
  bs = h.block_size
  msg = gen(4, bs)
  write_to_hash(h, msg)
  expected = get_sum(h, [])
  h.reset!
  buff = gen(5, bs * 3)
  copy(buff[bs...bs * 2], msg)
  write_to_hash(h, buff[bs...bs * 2])
  assert_eq get_sum(h, []), expected

  # StatefulWrite: two writes equal one.
  h = mk()
  prefix = gen(6, h.block_size)
  suffix = gen(7, h.block_size)
  write_to_hash(h, prefix)
  write_to_hash(h, suffix)
  serial = get_sum(h, [])
  h.reset!
  write_to_hash(h, prefix + suffix)
  assert_eq get_sum(h, []), serial
}

def write_to_hash(h0: hash.Hash, p: [Byte]) {
  h = h0
  before = p + []
  n = h.write!(p).unwrap
  assert_eq n, p.size
  assert_eq p, before
}

def get_sum(h: hash.Hash, buff: [Byte]) -> [Byte] {
  test_buff = buff + []
  s = h.sum(buff)
  assert_eq s, h.sum(test_buff)
  s
}
