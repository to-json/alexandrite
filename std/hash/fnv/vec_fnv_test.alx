# Generated from Go's hash/fnv (go1.27.1): sums of texts and seeded random bytes for all
# six variants, chunked writes and marshaled states; do not edit by hand.

# splitmix64 bytes, one output per byte (the generator's `gen`).
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

# Writes p to a fresh hash in chunks whose sizes cycle through `chunks`.
def chunked(p: [Byte], chunks: [Int]) -> [[Byte]] {
  parts: [[Byte]] = []
  off = 0
  k = 0
  while off < p.size {
    n = chunks[k % chunks.size]
    n = p.size - off if n > p.size - off
    parts << p[off...off + n]
    off += n
    k += 1
  }
  parts
}

# The six hashes, in the order 32, 32a, 64, 64a, 128, 128a.
def all -> [hash.Hash] {
  hs: [hash.Hash] = []
  hs << new32()
  hs << new32a()
  hs << new64()
  hs << new64a()
  hs << new128()
  hs << new128a()
  hs
}

def chk(p: [Byte], s32: U32, s32a: U32, s64: U64, s64a: U64, s128: Str, s128a: Str) {
  h32 = new32()
  h32.write!(p)
  assert_eq h32.sum32, s32
  h32a = new32a()
  h32a.write!(p)
  assert_eq h32a.sum32, s32a
  h64 = new64()
  h64.write!(p)
  assert_eq h64.sum64, s64
  h64a = new64a()
  h64a.write!(p)
  assert_eq h64a.sum64, s64a
  h128 = new128()
  h128.write!(p)
  assert_eq hex(h128.sum([])), s128
  h128a = new128a()
  h128a.write!(p)
  assert_eq hex(h128a.sum([])), s128a
}

def chunks(p: [Byte], sizes: [Int], want: [Str]) {
  hs = all()
  for part in chunked(p, sizes) {
    for h0 in hs {
      h = h0
      h.write!(part)
    }
  }
  i = 0
  while i < hs.size {
    assert_eq hex(hs[i].sum([])), want[i]
    i += 1
  }
}

def marshaled(p: [Byte], want: [Str]) {
  hs: [[Byte]] = []
  h32 = new32()
  h32.write!(p)
  hs << h32.marshal_binary
  h32a = new32a()
  h32a.write!(p)
  hs << h32a.marshal_binary
  h64 = new64()
  h64.write!(p)
  hs << h64.marshal_binary
  h64a = new64a()
  h64a.write!(p)
  hs << h64a.marshal_binary
  h128 = new128()
  h128.write!(p)
  hs << h128.marshal_binary
  h128a = new128a()
  h128a.write!(p)
  hs << h128a.marshal_binary
  i = 0
  while i < hs.size {
    assert_eq hex(hs[i]), want[i]
    i += 1
  }
}

def hex(p: [Byte]) -> Str {
  digits = "0123456789abcdef"
  out: [Byte] = []
  for x in p {
    out << digits[(x >> 4).to_i]
    out << digits[(x & 15).to_i]
  }
  Str.from_bytes(out)
}

