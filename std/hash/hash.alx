# Package hash: Go's hash, the interfaces every hash function implements.
#
#   Go                       alx
#   hash.Hash                Hash
#   hash.Hash32 / Hash64     Hash32 / Hash64
#   hash.XOF                 XOF
#   hash.Cloner              (not an interface; see below)
#
# The interfaces are structural (GO-VS-RUBY F2): any struct with these methods
# is one, as io.Writer is. Go embeds io.Writer in Hash; alx interfaces don't
# embed, so the methods are spelled out:
#
#   Go                       alx
#   Write(p) (int, error)    write!(p) -> ~Int   (a hash's write! can't fail)
#   Sum(b) []byte            sum(b) -> [Byte]    (b with the sum appended)
#   Reset()                  reset!
#   Size() / BlockSize()     size / block_size
#   Sum32() / Sum64()        sum32 / sum64
#   Read(p) (int, error)     read!(p) -> ~Int    (XOF)
#
# Differences from Go:
#   - Cloner (Go 1.25) is not an interface here: each hash has
#     `clone -> <its own type>`, and an interface method's result must match
#     exactly, so no interface can name a `clone` returning "some Cloner".
#   - Go's encoding.BinaryMarshaler / BinaryAppender / BinaryUnmarshaler,
#     which every Go hash implements, are the methods `marshal_binary`,
#     `append_binary(b)` and `unmarshal_binary!(b)` on each hash type.
#   - The hashes keep their state in shared storage (GO-VS-RUBY D36): passing
#     a hash to a function that writes to it (io.copy(h, r)) updates the
#     caller's hash, as Go's pointer receivers do.

# The common interface of all hash functions.
pub interface Hash {
  # Adds more data to the running hash. It never fails.
  def write!(p: [Byte]) -> ~Int
  # b with the current hash appended. Doesn't change the state.
  def sum(b: [Byte]) -> [Byte]
  # Back to the initial state.
  def reset!
  # The number of bytes sum appends.
  def size -> Int
  # The underlying block size: writes that are a multiple of it may be faster.
  def block_size -> Int
}

# A Hash whose sum is also a U32.
pub interface Hash32 {
  def write!(p: [Byte]) -> ~Int
  def sum(b: [Byte]) -> [Byte]
  def reset!
  def size -> Int
  def block_size -> Int
  def sum32 -> U32
}

# A Hash whose sum is also a U64.
pub interface Hash64 {
  def write!(p: [Byte]) -> ~Int
  def sum(b: [Byte]) -> [Byte]
  def reset!
  def size -> Int
  def block_size -> Int
  def sum64 -> U64
}

# An extendable output function: a hash with arbitrary or unlimited output.
pub interface XOF {
  # Absorbs more data. Calling it after read! is an error of the XOF's own.
  def write!(p: [Byte]) -> ~Int
  # Reads more output.
  def read!(p: [Byte]) -> ~Int
  # Back to the initial state.
  def reset!
  # The underlying block size.
  def block_size -> Int
}
