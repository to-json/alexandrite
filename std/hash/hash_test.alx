  a = fnv.new128a()
  b = fnv.new128a()
  check_marshal("666e7606a955802b0136cb67622b461d9f91e6ff", fnv.new128a(),
    Marshalable.new(h: a, marshal: ->() -> [Byte] { a.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~a.unmarshal_binary!(p) }),
    Marshalable.new(h: b, marshal: ->() -> [Byte] { b.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~b.unmarshal_binary!(p) }))
}

# Every hash satisfies the interfaces it should.
def sum_of(h0: Hash, p: [Byte]) -> [Byte] {
  h = h0
  h.write!(p)
  h.sum([])
}

def sum32_of(h0: Hash32, p: [Byte]) -> U32 {
  h = h0
  h.write!(p)
  h.sum32
}

def sum64_of(h0: Hash64, p: [Byte]) -> U64 {
  h = h0
  h.write!(p)
  h.sum64
}

test "interfaces" {
  p = "hello".bytes.to_a
  assert_eq sum32_of(crc32.new_ieee(), p), crc32.checksum_ieee(p)
  assert_eq sum32_of(adler32.new(), p), adler32.checksum(p)
  assert_eq sum32_of(fnv.new32(), p), 0xb6fa7167
  assert_eq sum32_of(fnv.new32a(), p), 0x4f9f2cab
  assert_eq sum64_of(crc64.new(crc64.make_table(crc64.ECMA)), p), crc64.checksum(p, crc64.make_table(crc64.ECMA))
  assert_eq sum64_of(fnv.new64(), p), 0x7b495389bdbdd4c7
  assert_eq sum64_of(fnv.new64a(), p), 0xa430d84680aabd0b
  assert_eq sum_of(fnv.new128(), p).size, 16
  m = maphash.new()
  assert_eq sum64_of(m, p), maphash.bytes(m.seed, p)
}
