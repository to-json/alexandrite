  a = fnv.new128()
  b = fnv.new128()
  check_marshal("666e760561587a70a0f66d7981dc980e2cabbaf7", fnv.new128(),
    Marshalable.new(h: a, marshal: ->() -> [Byte] { a.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~a.unmarshal_binary!(p) }),
