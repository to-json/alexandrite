import "hash/adler32"
import "hash/crc32"
import "hash/crc64"
import "hash/fnv"
import "hash/maphash"

# Go's marshal_test.go (TestMarshalHash) for the hashes ported so far; Go's
# md5 / sha* rows wait for crypto. Go's example_test.go uses crypto/sha256 and
# waits for it too.

def from_hex(s: Str) -> [Byte] {
  out: [Byte] = []
  i = 0
  while i < s.size {
    out << ((nibble(s[i]) << 4) | nibble(s[i + 1]))
    i += 2
  }
  out
}

def nibble(c: Byte) -> Byte {
  c <= 57 ? c - 48 : c - 87
}

# A hash with its marshaling methods, as Go's encoding.BinaryMarshaler /
# BinaryUnmarshaler interfaces would reach them.
struct Marshalable {
  h: Hash
  marshal: () -> [Byte]
  unmarshal: ([Byte]) -> ~Unit
}

def buf256 -> [Byte] {
  buf: [Byte] = []
  i = 0
  while i < 256 {
    buf << i.as_u8
    i += 1
  }
  buf
}

# Go's TestMarshalHash body: mk() makes (h2, h3) pairs of fresh hashes.
def check_marshal(golden: Str, h0: Hash, h2m: Marshalable, h3m: Marshalable) {
  buf = buf256()
  h = h0
  h.write!(buf)
  sum = h.sum([])
  h2 = h2m.h
  h3 = h3m.h
  split = 249
  i = 0
  while i < split {
    h2.write!(buf[i...i + 1])
    i += 1
  }
  enc = h2m.marshal.call
  assert_eq enc, from_hex(golden)
  h3m.unmarshal.call(enc).unwrap
  h2.write!(buf[split...buf.size])
  h3.write!(buf[split...buf.size])
  assert_eq h2.sum([]), sum
  assert_eq h3.sum([]), sum
}

test "marshal adler32" {
  a = adler32.new()
  b = adler32.new()
  check_marshal("61646c01460a789d", adler32.new(),
    Marshalable.new(h: a, marshal: ->() -> [Byte] { a.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~a.unmarshal_binary!(p) }),
    Marshalable.new(h: b, marshal: ->() -> [Byte] { b.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~b.unmarshal_binary!(p) }))
}

test "marshal crc32" {
  a = crc32.new_ieee()
  b = crc32.new_ieee()
  check_marshal("63726301ca87914dc956d3e8", crc32.new_ieee(),
    Marshalable.new(h: a, marshal: ->() -> [Byte] { a.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~a.unmarshal_binary!(p) }),
    Marshalable.new(h: b, marshal: ->() -> [Byte] { b.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~b.unmarshal_binary!(p) }))
}

test "marshal crc64" {
  t = crc64.make_table(crc64.ISO)
  a = crc64.new(t)
  b = crc64.new(t)
  check_marshal("6372630273ba8484bbcd5def5d51c83c581695be", crc64.new(t),
    Marshalable.new(h: a, marshal: ->() -> [Byte] { a.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~a.unmarshal_binary!(p) }),
    Marshalable.new(h: b, marshal: ->() -> [Byte] { b.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~b.unmarshal_binary!(p) }))
}

test "marshal fnv32" {
  a = fnv.new32()
  b = fnv.new32()
  check_marshal("666e760171ba3d77", fnv.new32(),
    Marshalable.new(h: a, marshal: ->() -> [Byte] { a.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~a.unmarshal_binary!(p) }),
    Marshalable.new(h: b, marshal: ->() -> [Byte] { b.marshal_binary }, unmarshal: ->(p: [Byte]) -> ~Unit { ~b.unmarshal_binary!(p) }))
}

