# Go's TestComparable, TestWriteComparable, TestComparableShouldPanic,
# TestWriteComparableNoncommute (maphash_test.go) and Example_bloomFilter
# (example_bloom_test.go), translated. Go's cases on pointers (`*T`, with a
# stack growth between hashes), channels and `any` values have no alx
# counterpart (no pointers; channels aren't comparable; interface values
# are closed sums) and are left out. Structs and arrays, which Go's runtime
# hashes by walking the type, are Hashable here (see maphash.alx).

import "math"
import "math/bits"
import "strconv"
import "strings"

# Go's struct{}.
struct Empty {
  def write_hash(_h: Hash) { nil }
}

# Go's struct{ i int; u uint; b bool; f float64 } (its pointer and any fields
# dropped).
struct Mixed {
  i: Int
  u: U64
  b: Bool
  f: Float

  def write_hash(h: Hash) {
    write_comparable(h, i)
    write_comparable(h, u)
    write_comparable(h, b)
    write_comparable(h, f)
  }
}

# Go's `type S struct { s string }`.
struct S {
  s: Str

  def write_hash(h: Hash) { write_comparable(h, s) }
}

# Go's struct{ a, b string }.
struct TwoStr {
  a: Str
  b: Str

  def write_hash(h: Hash) {
    write_comparable(h, a)
    write_comparable(h, b)
  }
}

# Go's [2]string.
struct Arr2 {
  v: [Str; 2]

  def write_hash(h: Hash) {
    write_comparable(h, v[0])
    write_comparable(h, v[1])
  }
}

def heap_str -> Str { Str.from_bytes("aTestString".bytes.to_a) }

#[track_caller]
def test_comparable[T](a: T, b: T) {
  seed = make_seed()
  assert comparable(seed, a) == comparable(seed, b), "comparable(seed, #{a}) != comparable(seed, #{b})"
}

#[track_caller]
def test_comparable_no_equal[T](v1: T, v2: T) {
  seed = make_seed()
  assert comparable(seed, v1) != comparable(seed, v2), "comparable(seed, #{v1}) == comparable(seed, #{v2})"
}

#[track_caller]
def test_write_comparable[T](a: T, b: T) {
  seed = make_seed()
  h1 = Hash.new
  h1.set_seed!(seed)
  h2 = Hash.new
  h2.set_seed!(seed)
  write_comparable(h1, a)
  write_comparable(h2, b)
  assert h1.sum64 == h2.sum64, "write_comparable(h, #{a}) != write_comparable(h, #{b})"
}

#[track_caller]
def test_write_comparable_no_equal[T](v1: T, v2: T) {
  seed = make_seed()
  h1 = Hash.new
  h1.set_seed!(seed)
  h2 = Hash.new
  h2.set_seed!(seed)
  write_comparable(h1, v1)
  write_comparable(h2, v2)
  assert h1.sum64 != h2.sum64, "write_comparable(h, #{v1}) == write_comparable(h, #{v2})"
}

test "TestComparable" {
  test_comparable(2.as_i64, 2.as_i64)
  test_comparable(8.as_u64, 8.as_u64)
  test_comparable(12.as_u64, 12.as_u64) # Go's uintptr
  test_comparable("s", "s")
  test_comparable(true, true)
  test_comparable(9.0, 9.0)
  test_comparable(Complex.new(1.0, 9.0), Complex.new(1.0, 9.0))
  test_comparable(Empty.new, Empty.new)
  test_comparable(Mixed.new(i: 9, u: 1, b: true, f: 9.9), Mixed.new(i: 9, u: 1, b: true, f: 9.9))
  s1 = S.new(s: heap_str())
  s2 = S.new(s: heap_str())
  assert s1.s == s2.s, "unexpected two heap_str values not equal"
  test_comparable(s1, s2)
  test_comparable(s1.s, s2.s)
  test_comparable(0.0, math.copysign(0.0, -1.0))
  test_comparable_no_equal(math.nan, math.nan)
  test_comparable_no_equal(Arr2.new(v: ["a", ""]), Arr2.new(v: ["", "a"]))
  test_comparable_no_equal(TwoStr.new(a: "foo", b: ""), TwoStr.new(a: "", b: "foo"))
  # The other scalar types alx has.
  test_comparable(7.as_i32, 7.as_i32)
  test_comparable(7.as_u32, 7.as_u32)
  test_comparable(7.as_i16, 7.as_i16)
  test_comparable(7.as_u16, 7.as_u16)
  test_comparable(7.as_i8, 7.as_i8)
  test_comparable(7.as_u8, 7.as_u8)
  test_comparable("", "")
  test_comparable_no_equal(1, 2)
  test_comparable_no_equal("a", "b")
  test_comparable_no_equal(true, false)
  test_comparable_no_equal(1.0, 2.0)
}

test "TestWriteComparable" {
  test_write_comparable(2.as_i64, 2.as_i64)
  test_write_comparable(8.as_u64, 8.as_u64)
  test_write_comparable(12.as_u64, 12.as_u64)
  test_write_comparable("s", "s")
  test_comparable(true, true) # sic: Go's test calls testComparable here
  test_write_comparable(9.0, 9.0)
  test_write_comparable(Complex.new(1.0, 9.0), Complex.new(1.0, 9.0))
  test_write_comparable(Empty.new, Empty.new)
  test_write_comparable(Mixed.new(i: 9, u: 1, b: true, f: 9.9), Mixed.new(i: 9, u: 1, b: true, f: 9.9))
  s1 = S.new(s: heap_str())
  s2 = S.new(s: heap_str())
  assert s1.s == s2.s, "unexpected two heap_str values not equal"
  test_write_comparable(s1, s2)
  test_write_comparable(s1.s, s2.s)
  test_write_comparable(0.0, math.copysign(0.0, -1.0))
  test_write_comparable_no_equal(math.nan, math.nan)
  test_write_comparable_no_equal(Arr2.new(v: ["a", ""]), Arr2.new(v: ["", "a"]))
  test_write_comparable_no_equal(TwoStr.new(a: "foo", b: ""), TwoStr.new(a: "", b: "foo"))
}

test "TestComparableShouldPanic" {
  seed = make_seed()
  bs = "s".bytes.to_a
  assert_panics("hash of unhashable type") { comparable(seed, bs) }
}

test "TestWriteComparableNoncommute" {
  seed = make_seed()
  h1 = Hash.new
  h2 = Hash.new
  h1.set_seed!(seed)
  h2.set_seed!(seed)
  h1.write_string!("abc")
  write_comparable(h1, 123)
  write_comparable(h2, 123)
  h2.write_string!("abc")
  assert h1.sum64 != h2.sum64, "write_comparable and write_string! unexpectedly commute"
}

# The bytes before a write_comparable still count, after it.
test "write comparable keeps buffered bytes" {
  seed = make_seed()
  h1 = Hash.new
  h2 = Hash.new
  h1.set_seed!(seed)
  h2.set_seed!(seed)
  h1.write_string!("abc")
  h2.write_string!("abd")
  write_comparable(h1, 1)
  write_comparable(h2, 1)
  assert h1.sum64 != h2.sum64, "buffered bytes lost"
  # and comparable(seed, v) is write_comparable into a fresh Hash
  h3 = Hash.new
  h3.set_seed!(seed)
  write_comparable(h3, "x")
  assert_eq h3.sum64, comparable(seed, "x")
}

# Go's Hasher example: a Hasher[Str] whose equivalence ignores letter case.
struct CaseInsensitive {
  def hash(h: Hash, s: Str) { h.write_string!(strings.to_lower(s)) }
  def equal(x: Str, y: Str) -> Bool { strings.to_lower(x) == strings.to_lower(y) }
}

test "hasher protocol" {
  seed = make_seed()
  ci = CaseInsensitive.new
  h1 = Hash.new
  h1.set_seed!(seed)
  h2 = Hash.new
  h2.set_seed!(seed)
  ci.hash(h1, "Apple")
  ci.hash(h2, "aPPLE")
  assert ci.equal("Apple", "aPPLE"), "case-insensitive equal"
  assert_eq h1.sum64, h2.sum64
  ch = ComparableHasher[Str].new
  assert ch.equal("a", "a") && !ch.equal("a", "A"), "== equivalence"
  h3 = Hash.new
  h3.set_seed!(seed)
  ch.hash(h3, "x")
  assert_eq h3.sum64, comparable(seed, "x")
}

# --- example_bloom_test.go ---

# A Bloom filter over values V, hashed by a Hasher H (Go's
# BloomFilter[V] holding a maphash.Hasher[V]).
struct BloomFilter[V, H] {
  hasher: H
  seeds: [Seed] # each seed determines a hash function
  bitv: [Byte]  # bit vector

  def contains?(v: V) -> Bool {
    for seed in seeds {
      index, bit = locate(seed, v)
      return false if bitv[index] & bit == 0
    }
    true
  }

  def insert!(v: V) {
    for seed in seeds {
      index, bit = locate(seed, v)
      self.bitv[index] = bitv[index] | bit
    }
    nil
  }

  def locate(seed: Seed, v: V) -> (Int, Byte) {
    h = Hash.new
    h.set_seed!(seed)
    hasher.hash(h, v)
    x = h.sum64
    index = bloom_reduce(x, bitv.size.as_u64)
    mask = (1.as_u64 << (x % 8)).as_u8
    (index.to_i, mask)
  }
}

def new_comparable_bloom_filter[V](n: Int, fp_prob: Float) -> BloomFilter[V, ComparableHasher[V]] {
  new_bloom_filter(ComparableHasher[V].new, n, fp_prob)
}

def new_bloom_filter[V, H](hasher: H, n: Int, fp_prob: Float) -> BloomFilter[V, H] {
  nbytes, nseeds = calibrate(n, fp_prob)
  seeds: [Seed] = []
  for _i in 0...nseeds {
    seeds << make_seed()
  }
  BloomFilter[V, H].new(hasher: hasher, bitv: [0.as_u8; nbytes], seeds: seeds)
}

def bloom_reduce(x: U64, n: U64) -> U64 {
  if n > (1 << 32) - 1 {
    hi, _lo = bits.mul64(x, n)
    return hi
  }
  ((x >> 32) * n) >> 32
}

def calibrate(n: Int, fp_prob: Float) -> (Int, Int) {
  # Following https://en.wikipedia.org/wiki/Bloom_filter: k is the number of
  # hash functions, m the size of the bit field, n the number of set bits.
  return (1, 1) if n == 0
  log_fp_prob = math.log(fp_prob)
  m = -(n.to_f * log_fp_prob) / (math.LN2 * math.LN2)
  # Round up to a byte.
  nbytes = m.to_i / 8
  nbytes += 1 if (nbytes * 8).to_f < m
  k = -log_fp_prob / math.LN2
  seeds = math.round(k).to_i
  seeds = 1 if seeds < 1
  (nbytes, seeds)
}

example "bloom filter" {
  # A Bloom filter optimized for 2 elements with a one-in-a-billion
  # false-positive rate (88 bits and 30 hash functions).
  f: BloomFilter[Str, ComparableHasher[Str]] = new_comparable_bloom_filter(2, 1e-9)
  f.insert!("apple")
  f.insert!("banana")
  # "cherry" was not inserted, but contains? is probabilistic, so this
  # spuriously reports true about once every billion runs.
  for fruit in ["apple", "banana", "cherry"] {
    puts "contains?(#{strconv.quote(fruit)}) = #{f.contains?(fruit)}"
  }
} outputs <<~EOS
  contains?("apple") = true
  contains?("banana") = true
  contains?("cherry") = false
EOS
