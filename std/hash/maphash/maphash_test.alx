import "hash"
import "slices"

# Go's maphash_test.go, example_test.go and smhasher_test.go, translated.
# Go's `new(Hash)` is `new()` here (or Hash.new followed by a `!` method; see
# the header of maphash.alx). Go's random bytes are seeded generator bytes
# (gen, below). The smhasher tests that Go skips in -short mode run here at
# reduced sizes (noted on each); the others run at Go's full size.

test "unseeded hash" {
  m: Map[U64, Bool] = {}
  i = 0
  while i < 1000 {
    h = new()
    m[h.sum64] = true
    i += 1
  }
  assert m.size >= 900, "empty hash not sufficiently random: got #{m.size}, want 1000"
}

test "seeded hash" {
  s = make_seed()
  m: Map[U64, Bool] = {}
  i = 0
  while i < 1000 {
    h = Hash.new
    h.set_seed!(s)
    m[h.sum64] = true
    i += 1
  }
  assert_eq m.size, 1
}

test "hash grouping" {
  b = reps("foo", 100)
  hh: [Hash] = []
  i = 0
  while i < 7 {
    hh << new()
    i += 1
  }
  i = 1
  while i < 7 {
    hh[i].set_seed!(hh[0].seed)
    i += 1
  }
  hh[0].write!(b)
  hh[1].write_string!(Str.from_bytes(b))

  i = 0
  while i < b.size {
    x = b[i]
    hh[2].write_byte!(x)
    hh[3].write!([x])
    if i == 0 {
      hh[4].write_byte!(x)
    } else {
      hh[4].write!([x])
    }
    hh[5].write_string!(Str.from_bytes([x]))
    if i == 0 {
      hh[6].write_byte!(x)
    } else {
      hh[6].write_string!(Str.from_bytes([x]))
    }
    i += 1
  }

  sum = hh[0].sum64
  for h in hh {
    assert_eq h.sum64, sum
  }
  assert_eq bytes(hh[0].seed, b), hh[0].sum64
  assert_eq string(hh[0].seed, Str.from_bytes(b)), hh[0].sum64
}

test "hash bytes vs string" {
  s = "foo"
  b = s.bytes.to_a
  h1 = new()
  h2 = new()
  h2.set_seed!(h1.seed)
  assert_eq h1.write_string!(s), s.size
  assert_eq h2.write!(b), b.size
  assert_eq h1.sum64, h2.sum64
}

test "hash high bytes" {
  n = 10
  m: Map[U64, Bool] = {}
  i = 0
  while i < n {
    h = new()
    h.write_string!("foo")
    m[h.sum64 >> 32] = true
    i += 1
  }
  assert m.size >= n / 2, "from #{n} seeds, wanted at least #{n / 2} different hashes; got #{m.size}"
}

test "repeat" {
  h1 = new()
  h1.write_string!("testing")
  sum1 = h1.sum64
  h1.reset!
  h1.write_string!("testing")
  sum2 = h1.sum64
  assert_eq sum1, sum2
  h2 = new()
  h2.set_seed!(h1.seed)
  h2.write_string!("testing")
  assert_eq h2.sum64, sum1
}

test "seed from sum64" {
  h1 = Hash.new
  h1.write_string!("foo")
  x = h1.sum64
  h2 = Hash.new
  h2.set_seed!(h1.seed)
  h2.write_string!("foo")
  assert_eq h2.sum64, x
}

test "seed from seed" {
  h1 = Hash.new
  h1.write_string!("foo")
  h1.seed
  x = h1.sum64
  h2 = Hash.new
  h2.set_seed!(h1.seed)
  h2.write_string!("foo")
  assert_eq h2.sum64, x
}

test "seed from flush" {
  b = [0.as_u8; 65]
  h1 = Hash.new
  h1.write!(b)
  x = h1.sum64
  h2 = Hash.new
  h2.set_seed!(h1.seed)
  h2.write!(b)
  assert_eq h2.sum64, x
}

test "seed from reset" {
  h1 = Hash.new
  h1.write_string!("foo")
  h1.reset!
  h1.write_string!("foo")
  x = h1.sum64
  h2 = Hash.new
  h2.set_seed!(h1.seed)
  h2.write_string!("foo")
  assert_eq h2.sum64, x
}

test "hash interface" {
  check_hash(->() -> hash.Hash { new() })
}

# The Clone subtest of Go's testhash.TestHash.
test "clone" {
  h = new()
  h3 = h.clone
  prefix = b("tmp")
  h.write!(prefix)
  h2 = h.clone
  prefix_sum = h.sum([])
  assert_eq prefix_sum, h2.sum([])
  suffix = b("tmp2")
  h.write!(suffix)
  h3.write!(prefix + suffix)
  composite = h3.sum([])
  assert_eq h.sum([]), composite
  assert_eq h2.sum([]), prefix_sum
  h2.write!(suffix)
  assert_eq h.sum([]), composite
  assert_eq h2.sum([]), composite
}

# Go's Example (its output is random, so it has no Output to check).
test "example" {
  h = new()
  h.write_string!("hello, ")
  first = h.sum64
  h.write!([0x77, 0x6f, 0x72, 0x6c, 0x64])
  assert first != h.sum64, "writing changes the sum"
  h.reset!
  h2 = Hash.new
  h2.set_seed!(h.seed)
  h.write_string!("same")
  h2.write_string!("same")
  assert_eq h.sum64, h2.sum64
}

# Every split of a range of inputs into writes, and bytes / string, agree.
test "writes in pieces" {
  seed = make_seed()
  lengths = [0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 47, 48, 49, 63, 64, 65,
    127, 128, 129, 255, 256, 257, 383, 384, 385, 1000]
  for n in lengths {
    p = gen(n.as_u64 + 1, n)
    want = bytes(seed, p)
    assert_eq string(seed, Str.from_bytes(p)), want
    piece = 1
    while piece <= 200 {
      h = Hash.new
      h.set_seed!(seed)
      g = Hash.new
      g.set_seed!(seed)
      off = 0
      while off < n {
        hi = off + piece
        hi = n if hi > n
        h.write!(p[off...hi])
        g.write_string!(Str.from_bytes(p[off...hi]))
        off = hi
      }
      assert_eq h.sum64, want
      assert_eq g.sum64, want
      piece = piece * 2 + 1
    }
  }
}

test "seeds" {
  assert_eq Seed.new.s, 0
  assert make_seed().s != 0, "make_seed returns a nonzero seed"
  assert make_seed().s != make_seed().s, "seeds are random"
}

test "sizes" {
  assert_eq new().size, 8
  assert_eq new().block_size, 128
  h = new()
  s = h.sum([1, 2])
  assert_eq s.size, 10
  x = h.sum64
  assert_eq s[2], x.as_u8
  assert_eq s[9], (x >> 56).as_u8
}

# --- smhasher_test.go ---

FIXED_SEED: U64 = 0x243f6a8885a308d3

def bytes_hash(b: [Byte]) -> U64 {
  h = Hash.new
  h.set_seed!(Seed.new(s: FIXED_SEED))
  h.write!(b)
  h.sum64
}

def string_hash(s: Str) -> U64 {
  h = Hash.new
  h.set_seed!(Seed.new(s: FIXED_SEED))
  h.write_string!(s)
  h.sum64
}

# splitmix64 bytes, one output per byte.
def gen(seed: U64, n: Int) -> [Byte] {
  x = seed
  out: [Byte] = []
  i = 0
  while i < n {
    x = x +% 0x9e3779b97f4a7c15
    z = x
    z = (z ^ (z >> 30)) *% 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) *% 0x94d049bb133111eb
    z = z ^ (z >> 31)
    out << z.as_u8
    i += 1
  }
  out
}

# Go's hashSet.check: at most a statistically plausible number of collisions.
#[track_caller]
def check_set(list0: [U64]) {
  list = list0
  slices.sort(list)
  collisions = 0
  i = 1
  while i < list.size {
    collisions += 1 if list[i] == list[i - 1]
    i += 1
  }
  n = list.size.to_f
  pairs = n * (n - 1.0) / 2.0
  expected = pairs / 18446744073709551616.0
  stddev = expected.sqrt
  limit = expected + 10.0 * (3.0 * stddev + 1.0)
  assert collisions.to_f <= limit, "unexpected number of collisions: got=#{collisions} mean=#{expected} stddev=#{stddev}"
}

test "smhasher sanity" {
  rep = 10
  keymax = 128
  pad = 16
  offmax = 16
  seed: U64 = 1234
  k = 0
  while k < rep {
    n = 0
    while n < keymax {
      i = 0
      while i < offmax {
        b = gen(seed, keymax + offmax + 2 * pad)
        c = gen(seed + 1, keymax + offmax + 2 * pad)
        seed += 2
        copy(c[pad + i...pad + i + n], b[pad...pad + n])
        assert_eq bytes_hash(b[pad...pad + n]), bytes_hash(c[pad + i...pad + i + n])
        i += 1
      }
      n += 1
    }
    k += 1
  }
}

test "smhasher appended zeros" {
  s = "hello" + "\0" * 256
  h: [U64] = []
  i = 0
  while i <= s.size {
    h << string_hash(s[0...i])
    i += 1
  }
  check_set(h)
}

# Go's -short size: keys of 1 and 2 bytes (the full test adds 3-byte keys).
test "smhasher small keys" {
  h: [U64] = []
  b = [0.as_u8; 3]
  i = 0
  while i < 256 {
    b[0] = i.as_u8
    h << bytes_hash(b[0...1])
    j = 0
    while j < 256 {
      b[1] = j.as_u8
      h << bytes_hash(b[0...2])
      j += 1
    }
    i += 1
  }
  check_set(h)
}

# Go's -short size (N = 1024; the full test uses 256 kB).
test "smhasher zeros" {
  n = 1024
  h: [U64] = []
  b = [0.as_u8; n]
  i = 0
  while i <= n {
    h << bytes_hash(b[0...i])
    i += 1
  }
  check_set(h)
}

def two_non_zero(h: [U64], n: Int) -> [U64] {
  out = h
  b = [0.as_u8; n]
  out << bytes_hash(b)
  i = 0
  while i < n {
    x = 1
    while x < 256 {
      b[i] = x.as_u8
      out << bytes_hash(b)
      b[i] = 0
      x += 1
    }
    i += 1
  }
  i = 0
  while i < n {
    x = 1
    while x < 256 {
      b[i] = x.as_u8
      j = i + 1
      while j < n {
        y = 1
        while y < 256 {
          b[j] = y.as_u8
          out << bytes_hash(b)
          b[j] = 0
          y += 1
        }
        j += 1
      }
      b[i] = 0
      x += 1
    }
    i += 1
  }
  out
}

# Reduced: n = 2..6 (Go: 2..16).
test "smhasher two nonzero" {
  h: [U64] = []
  n = 2
  while n <= 6 {
    h = two_non_zero(h, n)
    n += 1
  }
  check_set(h)
}

# Reduced: 20000 keys per length (Go: 1000000).
test "smhasher cyclic" {
  repeat = 8
  count = 20000
  seed: U64 = 1234
  n = 4
  while n <= 12 {
    h: [U64] = []
    b = [0.as_u8; repeat * n]
    i = 0
    while i < count {
      b[0] = (i * 79 % 97).as_u8
      b[1] = (i * 43 % 137).as_u8
      b[2] = (i * 151 % 197).as_u8
      b[3] = (i * 199 % 251).as_u8
      r = gen(seed, n - 4)
      seed += 1
      copy(b[4...n], r)
      j = n
      while j < n * repeat {
        b[j] = b[j - n]
        j += 1
      }
      h << bytes_hash(b)
      i += 1
    }
    check_set(h)
    n += 1
  }
}

def setbits(h: [U64], b: [Byte], i: Int, k: Int) -> [U64] {
  out = h
  out << bytes_hash(b)
  return out if k == 0
  j = i
  while j < b.size * 8 {
    b[j / 8] = b[j / 8] | (1 << (j & 7)).as_u8
    out = setbits(out, b, j + 1, k - 1)
    b[j / 8] = b[j / 8] & ^(1 << (j & 7)).as_u8
    j += 1
  }
  out
}

def sparse(n: Int, k: Int) {
  b = [0.as_u8; n / 8]
  check_set(setbits([], b, 0, k))
}

# Reduced: one bit fewer per size, and 2048-bit keys with one bit (Go: 6, 6,
# 5, 5, 5, 4, 3, 2).
test "smhasher sparse" {
  sparse(32, 5)
  sparse(40, 4)
  sparse(48, 4)
  sparse(56, 4)
  sparse(64, 4)
  sparse(96, 3)
  sparse(256, 2)
  sparse(2048, 1)
}

def gen_perm(h: [U64], b: [Byte], s: [U32], n: Int) -> [U64] {
  out = h
  out << bytes_hash(b[0...n])
  return out if n == b.size
  for v in s {
    b[n] = v.as_u8
    b[n + 1] = (v >> 8).as_u8
    b[n + 2] = (v >> 16).as_u8
    b[n + 3] = (v >> 24).as_u8
    out = gen_perm(out, b, s, n + 4)
  }
  out
}

def permutation(s: [U32], n: Int) {
  b = [0.as_u8; n * 4]
  check_set(gen_perm([], b, s, 0))
}

# Reduced lengths (Go: 8, 8, 20, 20, 6).
test "smhasher permutation" {
  permutation([0, 1, 2, 3, 4, 5, 6, 7], 6)
  permutation([0, 1 << 29, 2 << 29, 3 << 29, 4 << 29, 5 << 29, 6 << 29, 7 << 29], 6)
  permutation([0, 1], 16)
  permutation([0, 1 << 31], 16)
  permutation([0, 1, 2, 3, 4, 5, 6, 7, 1 << 29, 2 << 29, 3 << 29, 4 << 29, 5 << 29, 6 << 29, 7 << 29], 4)
}

# Go's avalancheTest1 over byte keys: flipping any input bit flips each output
# bit with probability near 1/2. Reduced: 2000 repetitions (Go: 100000), keys
# up to 32 bytes (Go: also 200), and Go's "40% to 60%" slack as the bounds.
def avalanche(size: Int) {
  rep = 2000
  n = size * 8
  grid = [0; n * 64]
  z = 0
  while z < rep {
    k = gen(z.as_u64 * 31 + size.as_u64, size)
    h = bytes_hash(k)
    i = 0
    while i < n {
      k[i >> 3] = k[i >> 3] ^ (1 << (i & 7)).as_u8
      d = h ^ bytes_hash(k)
      k[i >> 3] = k[i >> 3] ^ (1 << (i & 7)).as_u8
      j = 0
      while j < 64 {
        grid[i * 64 + j] += (d & 1).to_i
        d = d >> 1
        j += 1
      }
      i += 1
    }
    z += 1
  }
  low = rep * 4 / 10
  high = rep * 6 / 10
  i = 0
  while i < n * 64 {
    x = grid[i]
    assert x >= low && x <= high, "bad bias for bytes#{size} bit #{i / 64} -> bit #{i % 64}: #{x}/#{rep}"
    i += 1
  }
}

test "smhasher avalanche" {
  avalanche(2)
  avalanche(4)
  avalanche(8)
  avalanche(16)
  avalanche(32)
}

# Reduced: 10-bit windows at every 8th rotation (Go: 16 bits, every rotation).
test "smhasher windowed" {
  bits = 10
  size = 128
  nbits = size * 8
  r = 0
  while r < nbits {
    h: [U64] = []
    i = 0
    while i < 1 << bits {
      k = [0.as_u8; size]
      j = 0
      while j < bits {
        if (i >> j) & 1 != 0 {
          bit = (j + r) % nbits
          k[bit >> 3] = k[bit >> 3] ^ (1 << (bit & 7)).as_u8
        }
        j += 1
      }
      h << bytes_hash(k)
      i += 1
    }
    check_set(h)
    r += 8
  }
}

def text(h: [U64], prefix: Str, suffix: Str) -> [U64] {
  out = h
  s = "ABCDEFGHIJabcdefghij0123456789"
  n = 4
  b = [0.as_u8; prefix.size + n + suffix.size]
  copy(b, prefix.bytes.to_a)
  copy(b[prefix.size + n...b.size], suffix.bytes.to_a)
  c = prefix.size
  i = 0
  while i < s.size {
    b[c] = s[i]
    j = 0
    while j < s.size {
      b[c + 1] = s[j]
      k = 0
      while k < s.size {
        b[c + 2] = s[k]
        x = 0
        while x < s.size {
          b[c + 3] = s[x]
          out << bytes_hash(b)
          x += 1
        }
        k += 1
      }
      j += 1
    }
    i += 1
  }
  out
}

# Reduced: a 30-character alphabet (Go: 50).
test "smhasher text" {
  h: [U64] = []
  h = text(h, "Foo", "Bar")
  h = text(h, "FooBar", "")
  h = text(h, "", "FooBar")
  check_set(h)
}

test "smhasher seed" {
  h: [U64] = []
  n = 100000
  i = 0
  while i < n {
    s1 = Hash.new
    s1.set_seed!(Seed.new(s: (i + 1).as_u64))
    s1.write_string!("hello")
    h << s1.sum64
    s2 = Hash.new
    s2.set_seed!(Seed.new(s: (i + 1).as_u64 << 32))
    s2.write_string!("hello")
    h << s2.sum64
    i += 1
  }
  check_set(h)
}

def b(s: Str) -> [Byte] { s.bytes.to_a }
def reps(unit: Str, n: Int) -> [Byte] { (unit * n).bytes.to_a }

# Go's BenchmarkHash at a few sizes, 1000 times each.
def bench_sizes(size: Int) {
  buf = [0.as_u8; size]
  s = Str.from_bytes(buf)
  h = new()
  seed = h.seed
  i = 0
  while i < 1000 {
    h.reset!
    h.write!(buf)
    h.sum64
    bytes(seed, buf)
    string(seed, s)
    i += 1
  }
}

bench "maphash n=8" { bench_sizes(8) }
bench "maphash n=64" { bench_sizes(64) }
bench "maphash n=1024" { bench_sizes(1024) }
bench "maphash n=16384" { bench_sizes(16384) }

# Go's internal/testhash.TestHashWithoutClone, for a constructor of hashes.
# (Clone is tested per type: hash.Hash has no clone.) Go's random bytes are
# seeded generator bytes here.
def check_hash(mk: () -> hash.Hash) {
  # SumAppend: sum appends a digest of size bytes and leaves the prefix alone.
  h = mk()
  long_buff = gen(1, h.block_size + 1)
  prefixes: [[Byte]] = [[], b("a"), long_buff]
  for prefix in prefixes {
    h.reset!
    s = get_sum(h, prefix)
    assert_eq s[0...prefix.size], prefix
    assert_eq s[prefix.size...s.size], get_sum(h, [])
    assert_eq s.size - prefix.size, h.size
  }

  # WriteWithoutError: write! reports every byte and leaves p alone.
  h = mk()
  slices: [[Byte]] = [[], b("a"), gen(2, h.block_size + 1)]
  for p in slices {
    write_to_hash(h, p)
  }

  # ResetState: a reset hash sums like a new one.
  h = mk()
  empty_sum = get_sum(h, [])
  write_to_hash(h, gen(3, h.block_size))
  h.reset!
  assert_eq get_sum(h, []), empty_sum

  # OutOfBoundsRead: write! reads only its slice.
  h = mk()
  bs = h.block_size
  msg = gen(4, bs)
  write_to_hash(h, msg)
  expected = get_sum(h, [])
  h.reset!
  buff = gen(5, bs * 3)
  copy(buff[bs...bs * 2], msg)
  write_to_hash(h, buff[bs...bs * 2])
  assert_eq get_sum(h, []), expected

  # StatefulWrite: two writes equal one.
  h = mk()
  prefix = gen(6, h.block_size)
  suffix = gen(7, h.block_size)
  write_to_hash(h, prefix)
  write_to_hash(h, suffix)
  serial = get_sum(h, [])
  h.reset!
  write_to_hash(h, prefix + suffix)
  assert_eq get_sum(h, []), serial
}

def write_to_hash(h0: hash.Hash, p: [Byte]) {
  h = h0
  before = p + []
  n = h.write!(p).unwrap
  assert_eq n, p.size
  assert_eq p, before
}

def get_sum(h: hash.Hash, buff: [Byte]) -> [Byte] {
  test_buff = buff + []
  s = h.sum(buff)
  assert_eq s, h.sum(test_buff)
  s
}
