  assert_eq comparable(vs(0xffffffffffffffff), (-7).as_i8), 0xe604da662e9a2e7d
  assert_eq comparable(vs(0xffffffffffffffff), (-7).as_u8), 0xe604da662e9a2e7d
  assert_eq comparable(vs(0xffffffffffffffff), (127).as_i8), 0x449a3321f0c3d695
  assert_eq comparable(vs(0xffffffffffffffff), (127).as_u8), 0x449a3321f0c3d695
  assert_eq comparable(vs(0xffffffffffffffff), true), 0x732299aecf5a4147
  assert_eq comparable(vs(0xffffffffffffffff), false), 0xcc64c5b54b01c5ac
  assert_eq comparable(vs(0xffffffffffffffff), 0.0), 0xfb8d297a841ce6a2
  assert_eq comparable(vs(0xffffffffffffffff), 1.0), 0xd025af90f80aa682
  assert_eq comparable(vs(0xffffffffffffffff), -1.0), 0x5be5a7af2fd93738
  assert_eq comparable(vs(0xffffffffffffffff), 9.9), 0xfd4f17396f241cf3
  assert_eq comparable(vs(0xffffffffffffffff), 1.0e+300), 0xb985ae530bbf44dd
  assert_eq comparable(vs(0xffffffffffffffff), 5.0e-324), 0x45353bdd06db4fe2
  assert_eq comparable(vs(0xffffffffffffffff), 0.0 * -1.0), 0xfb8d297a841ce6a2
  assert_eq comparable(vs(0xffffffffffffffff), math.inf(1)), 0x13958101d7245f4b
  assert_eq comparable(vs(0xffffffffffffffff), Complex.new(1.0, 9.0)), 0xfc902610f38757f6
  assert_eq comparable(vs(0xffffffffffffffff), Complex.new(0.0, 0.0)), 0x622b46983a85cabd
  assert_eq comparable(vs(0xffffffffffffffff), Complex.new(-2.5, 0.0)), 0xb0e25b359ce801fa
  assert_eq comparable(vs(0xffffffffffffffff), ""), 0x5f89e29b87429bd0
  assert_eq comparable(vs(0xffffffffffffffff), "s"), 0xf6615713a606be69
  assert_eq comparable(vs(0xffffffffffffffff), "abc"), 0xe859ad7ef5a5bb31
  assert_eq comparable(vs(0xffffffffffffffff), "aTestString"), 0x5c9289bd38cde685
  assert_eq comparable(vs(0xffffffffffffffff), "0123456789abcdef0123456789abcdef0123456789abcdef0123456789"), 0x5bb636ffca939e78
  assert_eq wc_sum(vs(0xffffffffffffffff), "", 123), 0x25745cea4d810843
  assert_eq wc_sum(vs(0xffffffffffffffff), "abc", 123), 0x118325e884e2ff21
  assert_eq wc_sum(vs(0xffffffffffffffff), "0123456789", 123), 0xc679d8c13d8e4332
}

def wc_sum(seed: Seed, pre: Str, v: Int) -> U64 {
  h = Hash.new
  h.set_seed!(seed)
  h.write_string!(pre)
  write_comparable(h, v)
  h.sum64
}
