# Generated from Go's runtime hash code (internal/runtime/maps memHashFallback,
# memHash32/64Fallback, runtime f64hash/c128hash/strhash) and hash/maphash's
# Bytes, String and WriteComparable (go1.27.1), run with alx's fixed hash keys
# (Go's are random per process); do not edit by hand.

def vb(n: Int, k: Int) -> [Byte] { (0...n).map { |i| (i * 131 + k * 7 + 3).as_u8 }.to_a }
def vs(n: U64) -> Seed { Seed.new(s: n) }
def u64(x: U64) -> U64 { x }

test "maphash vectors 1" {
  assert_eq bytes(vs(0x1), vb(0, 0)), 0x1
  assert_eq string(vs(0x1), Str.from_bytes(vb(0, 0))), 0x1
  assert_eq bytes(vs(0x1), vb(1, 1)), 0x276ee06853d64a11
  assert_eq bytes(vs(0x1), vb(2, 2)), 0xe6d1e47951d45eb9
  assert_eq bytes(vs(0x1), vb(3, 3)), 0x9e1535772dc60242
  assert_eq string(vs(0x1), Str.from_bytes(vb(3, 3))), 0x9e1535772dc60242
  assert_eq bytes(vs(0x1), vb(4, 4)), 0x911a8ceaa0a8b4ce
  assert_eq bytes(vs(0x1), vb(5, 0)), 0x8d103113231746b1
