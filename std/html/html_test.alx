import "strings"
import "unicode/utf8"

test "unescape" {
  cases: [(Str, Str, Str)] = [
    ("copy", "A\ttext\nstring", "A\ttext\nstring"),
    ("simple", "&amp; &gt; &lt;", "& > <"),
    ("stringEnd", "&amp &amp", "& &"),
    ("multiCodepoint", "text &gesl; blah", "text ⋛︀ blah"),
    ("decimalEntity", "Delta = &#916; ", "Delta = Δ "),
    ("hexadecimalEntity", "Lambda = &#x3bb; = &#X3Bb ", "Lambda = λ = λ "),
    ("numericEnds", "&# &#x &#128;43 &copy = &#169f = &#xa9", "&# &#x €43 © = ©f = ©"),
    ("numericReplacements", "Footnote&#x87;", "Footnote‡"),
    ("copySingleAmpersand", "&", "&"),
    ("copyAmpersandNonEntity", "text &test", "text &test"),
    ("copyAmpersandHash", "text &#", "text &#"),
  ]
  for tt in cases {
    assert unescape_string(tt[1]) == tt[2], tt[0]
  }
}

test "unescape escape" {
  ss = [
    "",
    "abc def",
    "a & b",
    "a&amp;b",
    "a &amp b",
    "&quot;",
    "\"",
    "\"<&>\"",
    "&quot;&lt;&amp;&gt;&quot;",
    "3&5==1 && 0<1, \"0&lt;1\", a+acute=&aacute;",
    "The special characters are: <, >, &, ' and \"",
  ]
  for s in ss {
    assert_eq unescape_string(escape_string(s)), s
  }
}

# Go's TestEntityLength: the UTF-8 encoding of each entity is no longer than
# "&" + its name, and names without ';' are at most 6 bytes.
test "entity length" {
  assert ENTITY_COUNT > 0, "maps not loaded"
  assert_eq ENTITIES.size, ENTITY_COUNT * ENTITY_WIDTH
  e = 0
  while e < ENTITY_COUNT {
    name = strings.trim_right(ENTITIES[e * ENTITY_WIDTH...e * ENTITY_WIDTH + ENTITY_NAME_WIDTH], " ")
    r1 = entity_rune(e, 0)
    r2 = entity_rune(e, 1)
    enc = utf8.rune_len(r1)
    enc += utf8.rune_len(r2) if r2 != 0
    assert 1 + name.size >= enc, "escaped entity &#{name} is shorter than its UTF-8 encoding"
    if name[name.size - 1] != 0x3B {
      assert name.size <= LONGEST_ENTITY_WITHOUT_SEMICOLON, "entity name #{name} too long"
    }
    assert_eq lookup(name), e
    if e > 0 {
      assert cmp_name(e - 1, name) < 0, "table not sorted at #{name}"
    }
    e += 1
  }
}

example "escape_string" {
  puts escape_string("\"Fran & Freddie's Diner\" <tasty@example.com>")
} outputs "&#34;Fran &amp; Freddie&#39;s Diner&#34; &lt;tasty@example.com&gt;\n"

example "unescape_string" {
  puts unescape_string("&quot;Fran &amp; Freddie&#39;s Diner&quot; &lt;tasty@example.com&gt;")
} outputs "\"Fran & Freddie's Diner\" <tasty@example.com>\n"

def bench_escape_data -> Str { strings.repeat("AAAAA < BBBBB > CCCCC & DDDDD ' EEEEE \" ", 100) }
def bench_escape_none -> Str { strings.repeat("AAAAA x BBBBB x CCCCC x DDDDD x EEEEE x ", 100) }

bench "escape" {
  escape_string(bench_escape_data)
}

bench "escape none" {
  escape_string(bench_escape_none)
}

bench "unescape" {
  unescape_string(escape_string(bench_escape_data))
}

bench "unescape none" {
  unescape_string(escape_string(bench_escape_none))
}

bench "unescape sparse" {
  unescape_string(strings.repeat(strings.repeat("AAAAA x BBBBB x CCCCC x DDDDD x EEEEE x ", 10) + "&amp;", 10))
}

bench "unescape dense" {
  unescape_string(strings.repeat("&amp;&lt; &amp; &lt;", 100))
}
