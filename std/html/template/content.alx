# Typed content: Go's html/template/content.go. Go's CSS, HTML, HTMLAttr,
# JS, JSStr, URL and Srcset are named string types; here they are string
# Values whose type names are Go's ("template.HTML", ...), made with the
# functions below.

import "dyn"
import ttmpl "text/template"

# Content types (Go's contentType).
CONTENT_PLAIN = 0
CONTENT_CSS = 1
CONTENT_HTML = 2
CONTENT_HTML_ATTR = 3
CONTENT_JS = 4
CONTENT_JS_STR = 5
CONTENT_URL = 6
CONTENT_SRCSET = 7
CONTENT_UNSAFE = 8

# Known safe CSS (Go's template.CSS): a CSS3 stylesheet production, such
# as `p { color: purple }`, a CSS3 rule production, such as `a[href=~"https:"].foo#bar`,
# or a CSS3 declaration production, such as `color: red; margin: 2px`, or a
# CSS3 value production, such as `rgba(0, 0, 255, 127)`.
pub def css(s: Str) -> dyn.Value { dyn.Value.str_of(s, "template.CSS") }

# A known safe HTML document fragment (Go's template.HTML). It should not be
# used for HTML from a third-party, or HTML with unclosed tags or comments.
pub def html(s: Str) -> dyn.Value { dyn.Value.str_of(s, "template.HTML") }

# An HTML attribute from a trusted source (Go's template.HTMLAttr), for
# example, ` dir="ltr"`.
pub def html_attr(s: Str) -> dyn.Value { dyn.Value.str_of(s, "template.HTMLAttr") }

# A known safe EcmaScript5 Expression (Go's template.JS), for example,
# `(x + y * z())`.
pub def js(s: Str) -> dyn.Value { dyn.Value.str_of(s, "template.JS") }

# A sequence of characters meant to be embedded between quotes in a
# JavaScript expression (Go's template.JSStr), for example "foo\\nbar".
pub def js_str(s: Str) -> dyn.Value { dyn.Value.str_of(s, "template.JSStr") }

# A known safe URL or URL substring (Go's template.URL).
pub def url(s: Str) -> dyn.Value { dyn.Value.str_of(s, "template.URL") }

# A known safe srcset attribute (Go's template.Srcset).
pub def srcset(s: Str) -> dyn.Value { dyn.Value.str_of(s, "template.Srcset") }

# The content type of a string Value's type.
def content_type_of_name(t: Str) -> Int {
  case t {
    "template.CSS" => CONTENT_CSS
    "template.HTML" => CONTENT_HTML
    "template.HTMLAttr" => CONTENT_HTML_ATTR
    "template.JS" => CONTENT_JS
    "template.JSStr" => CONTENT_JS_STR
    "template.URL" => CONTENT_URL
    "template.Srcset" => CONTENT_SRCSET
    "string" => CONTENT_PLAIN
    _ => -1
  }
}

# Go's indirect: follows pointers to a non-pointer (a nil pointer stays).
def indirect_val(v0: dyn.Value) -> dyn.Value {
  v = v0
  while v.kind == dyn.KIND_PTR && !v.nil? {
    v = v.elem
  }
  v
}

# Go's indirectToStringerOrError: follows pointers until a value with a
# String() or Error() method, or a non-pointer.
def indirect_to_stringer_or_error(v0: dyn.Value) -> dyn.Value {
  v = v0
  while v.kind == dyn.KIND_PTR && !v.nil? && !stringer?(v) {
    v = v.elem
  }
  v
}

def stringer?(v: dyn.Value) -> Bool {
  if o = v.obj {
    return o.data_string != none
  }
  false
}

# Whether v is Go's nil interface argument (no value, or the nil of an
# interface type).
def nil_arg?(v: dyn.Value) -> Bool {
  return true if v.kind == dyn.KIND_INVALID
  v.kind == dyn.KIND_PTR && v.nil? && !v.type_name.start_with?("*")
}

# Converts its arguments to a string and the type of the content.
def stringify(args: [dyn.Value]) -> (Str, Int) {
  if args.size == 1 {
    s = indirect_val(args[0])
    if s.kind == dyn.KIND_STRING {
      t = content_type_of_name(s.type_name)
      return (s.str_val, t) if t >= 0
    }
  }
  xs: [dyn.Value] = []
  for arg in args {
    next if nil_arg?(arg)
    xs << indirect_to_stringer_or_error(arg)
  }
  (dyn.sprint(xs), CONTENT_PLAIN)
}
