# The escaper's context: Go's html/template/context.go and the *_string.go
# name tables.

import "text/template/parse"

# States (Go's state constants, same values).
STATE_TEXT = 0
STATE_TAG = 1
STATE_ATTR_NAME = 2
STATE_AFTER_NAME = 3
STATE_BEFORE_VALUE = 4
STATE_HTML_CMT = 5
STATE_RCDATA = 6
STATE_ATTR = 7
STATE_URL = 8
STATE_SRCSET = 9
STATE_JS = 10
STATE_JS_DQ_STR = 11
STATE_JS_SQ_STR = 12
STATE_JS_TMPL_LIT = 13
STATE_JS_REGEXP = 14
STATE_JS_BLOCK_CMT = 15
STATE_JS_LINE_CMT = 16
STATE_JS_HTML_OPEN_CMT = 17
STATE_JS_HTML_CLOSE_CMT = 18
STATE_CSS = 19
STATE_CSS_DQ_STR = 20
STATE_CSS_SQ_STR = 21
STATE_CSS_DQ_URL = 22
STATE_CSS_SQ_URL = 23
STATE_CSS_URL = 24
STATE_CSS_BLOCK_CMT = 25
STATE_CSS_LINE_CMT = 26
STATE_ERROR = 27
STATE_META_CONTENT = 28
STATE_META_CONTENT_URL = 29
STATE_DEAD = 30

def state_name(s: Int) -> Str {
  names = ["stateText", "stateTag", "stateAttrName", "stateAfterName", "stateBeforeValue", "stateHTMLCmt", "stateRCDATA", "stateAttr", "stateURL", "stateSrcset", "stateJS", "stateJSDqStr", "stateJSSqStr", "stateJSTmplLit", "stateJSRegexp", "stateJSBlockCmt", "stateJSLineCmt", "stateJSHTMLOpenCmt", "stateJSHTMLCloseCmt", "stateCSS", "stateCSSDqStr", "stateCSSSqStr", "stateCSSDqURL", "stateCSSSqURL", "stateCSSURL", "stateCSSBlockCmt", "stateCSSLineCmt", "stateError", "stateMetaContent", "stateMetaContentURL", "stateDead"]
  return names[s] if s >= 0 && s < names.size
  "state(#{s})"
}

# Delimiters.
DELIM_NONE = 0
DELIM_DOUBLE_QUOTE = 1
DELIM_SINGLE_QUOTE = 2
DELIM_SPACE_OR_TAG_END = 3

def delim_name(d: Int) -> Str {
  names = ["delimNone", "delimDoubleQuote", "delimSingleQuote", "delimSpaceOrTagEnd"]
  return names[d] if d >= 0 && d < names.size
  "delim(#{d})"
}

# URL parts.
URL_PART_NONE = 0
URL_PART_PRE_QUERY = 1
URL_PART_QUERY_OR_FRAG = 2
URL_PART_UNKNOWN = 3

def url_part_name(u: Int) -> Str {
  names = ["urlPartNone", "urlPartPreQuery", "urlPartQueryOrFrag", "urlPartUnknown"]
  return names[u] if u >= 0 && u < names.size
  "urlPart(#{u})"
}

# JS contexts.
JS_CTX_REGEXP = 0
JS_CTX_DIV_OP = 1
JS_CTX_UNKNOWN = 2

def js_ctx_name(j: Int) -> Str {
  names = ["jsCtxRegexp", "jsCtxDivOp", "jsCtxUnknown"]
  return names[j] if j >= 0 && j < names.size
  "jsCtx(#{j})"
}

# Elements.
ELEMENT_NONE = 0
ELEMENT_SCRIPT = 1
ELEMENT_STYLE = 2
ELEMENT_TEXTAREA = 3
ELEMENT_TITLE = 4
ELEMENT_META = 5

def element_name(e: Int) -> Str {
  names = ["elementNone", "elementScript", "elementStyle", "elementTextarea", "elementTitle", "elementMeta"]
  return names[e] if e >= 0 && e < names.size
  "element(#{e})"
}

# Attribute types.
ATTR_NONE = 0
ATTR_SCRIPT = 1
ATTR_SCRIPT_TYPE = 2
ATTR_STYLE = 3
ATTR_URL = 4
ATTR_SRCSET = 5
ATTR_META_CONTENT = 6

def attr_name(a: Int) -> Str {
  names = ["attrNone", "attrScript", "attrScriptType", "attrStyle", "attrURL", "attrSrcset", "attrMetaContent"]
  return names[a] if a >= 0 && a < names.size
  "attr(#{a})"
}

# An escaping error (Go's *Error), held in a context until it is returned.
pub struct ErrInfo {
  # Go's ErrorCode.
  code: Int
  # The node that caused the problem, if known. If set, it overrides name
  # and line.
  node: parse.Node?
  # The name of the template in which the error was encountered.
  name: Str
  # The line number of the error in the template source or 0.
  line: Int
  # A human-readable description of the problem.
  description: Str

  pub def message -> Str {
    if n = node {
      loc, _ = parse.new_tree("").error_context(n)
      return "html/template:#{loc}: #{description}"
    }
    if line != 0 {
      return "html/template:#{name}:#{line}: #{description}"
    }
    if name != "" {
      return "html/template:#{name}: #{description}"
    }
    "html/template: " + description
  }
}

# The state of the HTML parser at a point in a template (Go's context).
# A zero Context is the start of an HTML document.
struct Context {
  state: Int
  delim: Int
  url_part: Int
  js_ctx: Int
  # The depth of braces within each JS template literal's ${...}, innermost
  # last. `jsbd_set` tells an empty list from Go's nil slice (they mangle
  # differently).
  js_brace_depth: [Int]
  jsbd_set: Bool
  attr: Int
  element: Int
  # for range break/continue
  n: parse.Node?
  err: ErrInfo?

  def to_s -> Str {
    e = "<nil>"
    if x = err {
      e = x.message
    }
    d = "[" + ints_str(js_brace_depth) + "]"
    "{#{state_name(state)} #{delim_name(delim)} #{url_part_name(url_part)} #{js_ctx_name(js_ctx)} #{d} #{attr_name(attr)} #{element_name(element)} #{e}}"
  }

  def eq(d: Context) -> Bool {
    state == d.state && delim == d.delim && url_part == d.url_part && js_ctx == d.js_ctx && js_brace_depth == d.js_brace_depth && attr == d.attr && element == d.element && same_err(err, d.err)
  }

  # A name for the template `template_name` in this start context.
  def mangle(template_name: Str) -> Str {
    return template_name if state == STATE_TEXT
    s = template_name + "$htmltemplate_" + state_name(state)
    s = s + "_" + delim_name(delim) if delim != DELIM_NONE
    s = s + "_" + url_part_name(url_part) if url_part != URL_PART_NONE
    s = s + "_" + js_ctx_name(js_ctx) if js_ctx != JS_CTX_REGEXP
    if jsbd_set {
      s = s + "_jsBraceDepth([" + ints_str(js_brace_depth) + "])"
    }
    s = s + "_" + attr_name(attr) if attr != ATTR_NONE
    s = s + "_" + element_name(element) if element != ELEMENT_NONE
    s
  }

  def clone -> Context {
    c = self
    c.js_brace_depth = js_brace_depth.map { it }
    c
  }
}

# Go compares error pointers; two contexts carry the same error only when
# one was copied from the other, and an error context is never joined, so
# comparing the content is enough.
def same_err(a: ErrInfo?, b: ErrInfo?) -> Bool {
  if x = a {
    if y = b {
      return x.code == y.code && x.description == y.description && x.line == y.line && x.name == y.name
    }
    return false
  }
  b == none
}

def ctx(state: Int) -> Context { Context.new(state: state, js_brace_depth: []) }

def err_ctx(e: ErrInfo) -> Context { Context.new(state: STATE_ERROR, js_brace_depth: [], err: e) }

def errorf(code: Int, node: parse.Node?, line: Int, msg: Str) -> ErrInfo {
  ErrInfo.new(code: code, node: node, name: "", line: line, description: msg)
}

def is_comment(s: Int) -> Bool {
  s == STATE_HTML_CMT || s == STATE_JS_BLOCK_CMT || s == STATE_JS_LINE_CMT || s == STATE_JS_HTML_OPEN_CMT || s == STATE_JS_HTML_CLOSE_CMT || s == STATE_CSS_BLOCK_CMT || s == STATE_CSS_LINE_CMT
}

def is_in_tag(s: Int) -> Bool {
  s == STATE_TAG || s == STATE_ATTR_NAME || s == STATE_AFTER_NAME || s == STATE_BEFORE_VALUE || s == STATE_ATTR
}

def is_in_script_literal(s: Int) -> Bool {
  s == STATE_JS_DQ_STR || s == STATE_JS_SQ_STR || s == STATE_JS_TMPL_LIT || s == STATE_JS_REGEXP
}

def ints_str(xs: [Int]) -> Str {
  out: [Str] = []
  for x in xs { out << "#{x}" }
  out.join(" ")
}
