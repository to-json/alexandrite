# Contextual autoescaping: Go's html/template/escape.go. The escaper walks a
# template's parse tree with the HTML parser's context, and rewrites each
# action's pipeline to end in the escapers its context needs.

import "dyn"
import "html"
import "strings"
import ttmpl "text/template"
import "text/template/parse"

# An innocuous word that is emitted in place of unsafe values by sanitizer
# functions. It is not a keyword in any programming language, contains no
# special characters, is not empty, and when it appears in output it is
# distinct enough that a developer can find the source of the problem via a
# search engine.
pub FILTER_FAILSAFE = "ZgotmplZ"

# Error codes (Go's ErrorCode).
pub OK = 0
pub ERR_AMBIG_CONTEXT = 1
pub ERR_BAD_HTML = 2
pub ERR_BRANCH_END = 3
pub ERR_END_CONTEXT = 4
pub ERR_NO_SUCH_TEMPLATE = 5
pub ERR_OUTPUT_CONTEXT = 6
pub ERR_PARTIAL_CHARSET = 7
pub ERR_PARTIAL_ESCAPE = 8
pub ERR_RANGE_LOOP_REENTRY = 9
pub ERR_SLASH_AMBIG = 10
pub ERR_PREDEFINED_ESCAPER = 11
pub ERR_JS_TEMPLATE = 12

# An escaping error (Go's *Error): its ErrorCode and Go's text.
pub error EscapeError {
  Esc(code: Int, text: Str)

  def message -> Str {
    case self {
      Esc(_, t) => t
    }
  }
}

def escape_error(e: ErrInfo) -> EscapeError { EscapeError.Esc(code: e.code, text: e.message) }

# The escapers, by the names the rewritten pipelines call them (Go's
# funcMap).
def escaper_funcs -> Map[Str, dyn.Func] {
  m: Map[Str, dyn.Func] = {}
  sig = dyn.Sig.new(params: ["interface {}"], variadic: true, results: ["string"])
  add = ->(name: Str, f: ([dyn.Value]) -> Str) {
    m[name] = dyn.Func.make(sig, ->(a: [dyn.Value]) -> ~dyn.Value { dyn.Value.str(f.call(a)) })
  }
  add.call("_html_template_attrescaper", ->(a: [dyn.Value]) -> Str { attr_escaper(a) })
  add.call("_html_template_commentescaper", ->(a: [dyn.Value]) -> Str { comment_escaper(a) })
  add.call("_html_template_cssescaper", ->(a: [dyn.Value]) -> Str { css_escaper(a) })
  add.call("_html_template_cssvaluefilter", ->(a: [dyn.Value]) -> Str { css_value_filter(a) })
  add.call("_html_template_htmlnamefilter", ->(a: [dyn.Value]) -> Str { html_name_filter(a) })
  add.call("_html_template_htmlescaper", ->(a: [dyn.Value]) -> Str { html_escaper(a) })
  add.call("_html_template_jsregexpescaper", ->(a: [dyn.Value]) -> Str { js_regexp_escaper(a) })
  add.call("_html_template_jsstrescaper", ->(a: [dyn.Value]) -> Str { js_str_escaper(a) })
  add.call("_html_template_jstmpllitescaper", ->(a: [dyn.Value]) -> Str { js_tmpl_lit_escaper(a) })
  add.call("_html_template_jsvalescaper", ->(a: [dyn.Value]) -> Str { js_val_escaper(a) })
  add.call("_html_template_nospaceescaper", ->(a: [dyn.Value]) -> Str { html_nospace_escaper(a) })
  add.call("_html_template_rcdataescaper", ->(a: [dyn.Value]) -> Str { rcdata_escaper(a) })
  add.call("_html_template_srcsetescaper", ->(a: [dyn.Value]) -> Str { srcset_filter_and_escaper(a) })
  add.call("_html_template_urlescaper", ->(a: [dyn.Value]) -> Str { url_escaper(a) })
  add.call("_html_template_urlfilter", ->(a: [dyn.Value]) -> Str { url_filter(a) })
  add.call("_html_template_urlnormalizer", ->(a: [dyn.Value]) -> Str { url_normalizer(a) })
  add.call("_eval_args_", ->(a: [dyn.Value]) -> Str { eval_args(a) })
  m
}

# Formats the list of arguments into a string. It is equivalent to
# fmt.Sprint(args...), except that it dereferences all pointers.
def eval_args(args: [dyn.Value]) -> Str {
  # Optimization for simple common case of a single string argument.
  if args.size == 1 && args[0].kind == dyn.KIND_STRING && args[0].type_name == "string" {
    return args[0].str_val
  }
  dyn.fmt_print(args.map { nil_arg?(it) ? dyn.Value.invalid : indirect_to_stringer_or_error(it) })
}

# Information about the current range loop.
struct RangeCtx {
  # context at each break action
  breaks: [Context]
  # context at each continue action
  continues: [Context]
}

# Collects type inferences about templates and changes needed to make
# templates injection safe.
struct Escaper {
  # The namespace's template names, and any of its text templates (for
  # looking up templates in the text/template set).
  set: Map[Str, Int]
  text: ttmpl.Template
  # output[name] is the output context for a template name that has been
  # mangled to include its input context.
  output: Map[Str, Context]
  # derived[c.mangle(name)] maps to a template derived from the template
  # named name for the start context c.
  derived: Map[Str, ttmpl.Template]
  # called[name] is a set of called mangled template names.
  called: Map[Str, Bool]
  # The accumulated edits to apply during commit. Such edits are not
  # applied immediately in case a template set executes a given template
  # in different escaping contexts.
  action_edits: [(parse.Node, [Str])]
  template_edits: [(parse.Node, Str)]
  text_edits: [(parse.Node, Str)]
  # The range loops being escaped, innermost last.
  range_ctx: [RangeCtx]

  # Escapes a template node.
  def escape!(c: Context, n: parse.Node) -> Context {
    case n.typ {
      parse.NODE_ACTION => escape_action!(c, n)
      parse.NODE_BREAK => {
        c1 = c
        c1.n = n
        r = range_ctx.size - 1
        bs = range_ctx[r].breaks
        bs << c1
        self.range_ctx[r].breaks = bs
        ctx(STATE_DEAD)
      }
      parse.NODE_COMMENT => c
      parse.NODE_CONTINUE => {
        c1 = c
        c1.n = n
        r = range_ctx.size - 1
        cs = range_ctx[r].continues
        cs << c1
        self.range_ctx[r].continues = cs
        ctx(STATE_DEAD)
      }
      parse.NODE_IF => escape_branch!(c, n, "if")
      parse.NODE_LIST => escape_list!(c, n)
      parse.NODE_RANGE => escape_branch!(c, n, "range")
      parse.NODE_TEMPLATE => escape_template!(c, n)
      parse.NODE_TEXT => escape_text!(c, n)
      parse.NODE_WITH => escape_branch!(c, n, "with")
      _ => {
        panic("escaping #{n.to_s} is unimplemented")
        c
      }
    }
  }

  # Escapes an action template node.
  def escape_action!(c0: Context, n: parse.Node) -> Context {
    pipe = n.pipe.unwrap
    if pipe.decl.size != 0 {
      # A local variable assignment, not an interpolation.
      return c0
    }
    c = nudge(c0)
    # Check for disallowed use of predefined escapers in the pipeline.
    cmds = pipe.cmds
    pos = 0
    for id_node in cmds {
      node = id_node.args[0]
      if node.typ == parse.NODE_IDENTIFIER {
        ident = node.ident_name
        if predefined_escaper?(ident) {
          if pos < cmds.size - 1 || (c.state == STATE_ATTR && c.delim == DELIM_SPACE_OR_TAG_END && ident == "html") {
            return err_ctx(errorf(ERR_PREDEFINED_ESCAPER, n, n.line, "predefined escaper #{gq(ident)} disallowed in template"))
          }
        }
      }
      pos += 1
    }
    s: [Str] = []
    case c.state {
      STATE_ERROR => {
        return c
      }
      STATE_URL | STATE_CSS_DQ_STR | STATE_CSS_SQ_STR | STATE_CSS_DQ_URL | STATE_CSS_SQ_URL | STATE_CSS_URL => {
        case c.url_part {
          URL_PART_NONE | URL_PART_PRE_QUERY => {
            s << "_html_template_urlfilter" if c.url_part == URL_PART_NONE
            if c.state == STATE_CSS_DQ_STR || c.state == STATE_CSS_SQ_STR {
              s << "_html_template_cssescaper"
            } else {
              s << "_html_template_urlnormalizer"
            }
          }
          URL_PART_QUERY_OR_FRAG => s << "_html_template_urlescaper"
          _ => {
            return err_ctx(errorf(ERR_AMBIG_CONTEXT, n, n.line, "#{n.to_s} appears in an ambiguous context within a URL"))
          }
        }
      }
      STATE_META_CONTENT => {}
      STATE_META_CONTENT_URL => s << "_html_template_urlfilter"
      STATE_JS => {
        s << "_html_template_jsvalescaper"
        # A slash after a value starts a div operator.
        c.js_ctx = JS_CTX_DIV_OP
      }
      STATE_JS_DQ_STR | STATE_JS_SQ_STR => s << "_html_template_jsstrescaper"
      STATE_JS_TMPL_LIT => s << "_html_template_jstmpllitescaper"
      STATE_JS_REGEXP => s << "_html_template_jsregexpescaper"
      STATE_CSS => s << "_html_template_cssvaluefilter"
      STATE_TEXT => s << "_html_template_htmlescaper"
      STATE_RCDATA => s << "_html_template_rcdataescaper"
      # Handled below in delim check.
      STATE_ATTR => {}
      STATE_ATTR_NAME | STATE_TAG => {
        c.state = STATE_ATTR_NAME
        s << "_html_template_htmlnamefilter"
      }
      STATE_SRCSET => s << "_html_template_srcsetescaper"
      _ => {
        if is_comment(c.state) {
          s << "_html_template_commentescaper"
        } else {
          panic("unexpected state " + state_name(c.state))
        }
      }
    }
    if c.delim == DELIM_SPACE_OR_TAG_END {
      s << "_html_template_nospaceescaper"
    } else if c.delim != DELIM_NONE {
      s << "_html_template_attrescaper"
    }
    edit_action_node!(n, s)
    c
  }

  # Escapes a branch template node: "if", "range" and "with".
  def escape_branch!(c: Context, n: parse.Node, node_name: Str) -> Context {
    if node_name == "range" {
      self.range_ctx << RangeCtx.new(breaks: [], continues: [])
    }
    c0 = escape_list!(c.clone, n.list.unwrap)
    if node_name == "range" {
      c0 = join_range(c0, range_ctx[range_ctx.size - 1]) if c0.state != STATE_ERROR
      self.range_ctx = range_ctx[0...range_ctx.size - 1]
      return c0 if c0.state == STATE_ERROR
      # The "true" branch of a "range" node can execute multiple times. We
      # check that executing n.List once results in the same context as
      # executing n.List twice.
      self.range_ctx << RangeCtx.new(breaks: [], continues: [])
      c1, _ = escape_list_conditionally!(c0, n.list.unwrap, 0, c0)
      c0 = join(c0, c1, n, node_name)
      if c0.state == STATE_ERROR {
        self.range_ctx = range_ctx[0...range_ctx.size - 1]
        # Make clear that this is a problem on loop re-entry since
        # developers tend to overlook that branch when debugging templates.
        e = c0.err.unwrap
        e.line = n.line
        e.description = "on range loop re-entry: " + e.description
        c0.err = e
        return c0
      }
      c0 = join_range(c0, range_ctx[range_ctx.size - 1])
      self.range_ctx = range_ctx[0...range_ctx.size - 1]
      return c0 if c0.state == STATE_ERROR
    }
    c1 = c.clone
    if el = n.else_list {
      c1 = escape_list!(c.clone, el)
    }
    join(c0, c1, n, node_name)
  }

  # Escapes a list template node.
  def escape_list!(c0: Context, n: parse.Node) -> Context {
    c = c0
    for m in n.nodes {
      c = escape!(c, m)
      break if c.state == STATE_DEAD
    }
    c
  }

  # Escapes a list node but only preserves edits and inferences in e if the
  # inferences and output context satisfy the filter (0: never; 1: the
  # escapeTemplateBody filter for template `tname` assuming context `assumed`).
  # Returns the best guess at an output context, and the result of the
  # filter which is the same as whether e was updated.
  def escape_list_conditionally!(c: Context, n: parse.Node, filter: Int, assumed: Context) -> (Context, Bool) {
    tname = filter_name
    e1 = make_escaper(set, text)
    e1.range_ctx = range_ctx
    # Make type inferences available to f.
    for k, v in output { e1.output[k] = v }
    c1 = e1.escape_list!(c, n)
    # (Go's escaper shares its range contexts with e1.)
    self.range_ctx = e1.range_ctx
    ok = false
    if filter == 1 {
      if c1.state == STATE_ERROR {
        # Do not update the input escaper, e.
        ok = false
      } else if !(e1.called[tname] || false) {
        # If t is not recursively called, then c1 is an accurate output
        # context.
        ok = true
      } else {
        # c1 is accurate if it matches our assumed output context.
        ok = assumed.eq(c1)
      }
    }
    if ok {
      # Copy inferences and edits from e1 back into e.
      for k, v in e1.output { self.output[k] = v }
      for k, v in e1.derived { self.derived[k] = v }
      for k, v in e1.called { self.called[k] = v }
      for x in e1.action_edits { edit_action_node!(x[0], x[1]) }
      for x in e1.template_edits { edit_template_node!(x[0], x[1]) }
      for x in e1.text_edits { edit_text_node!(x[0], x[1]) }
    }
    (c1, ok)
  }

  # (the template name escape_template_body's filter checks)
  filter_name: Str

  # Escapes a {{template}} call node.
  def escape_template!(c0: Context, n: parse.Node) -> Context {
    c, name = escape_tree!(c0, n, n.name, n.line)
    if name != n.name {
      edit_template_node!(n, name)
    }
    c
  }

  # Escapes the named template starting in the given context as necessary
  # and returns its output context.
  def escape_tree!(c: Context, node: parse.Node, name: Str, line: Int) -> (Context, Str) {
    # Mangle the template name with the input context to produce a reliable
    # identifier.
    dname = c.mangle(name)
    self.called[dname] = true
    if out = output[dname] {
      # Already escaped.
      return (out, dname)
    }
    t0 = template(name)
    if t0 == none {
      # Two cases: The template exists but is empty, or has never been
      # mentioned at all. Distinguish the cases in the error messages.
      if set[name] != none {
        return (err_ctx(errorf(ERR_NO_SUCH_TEMPLATE, node, line, "#{gq(name)} is an incomplete or empty template")), dname)
      }
      return (err_ctx(errorf(ERR_NO_SUCH_TEMPLATE, node, line, "no such template #{gq(name)}")), dname)
    }
    t = t0.unwrap
    if dname != name {
      # Use any template derived during an earlier call to escapeTemplate
      # with different top level templates, or clone if necessary.
      dt = template(dname)
      if dt == none {
        nt = ttmpl.new(dname)
        tree = parse.new_tree(dname)
        tree.set_root(t.root.unwrap.copy)
        nt.set_tree(tree)
        self.derived[dname] = nt
        dt = nt
      }
      t = dt.unwrap
    }
    (compute_out_ctx!(c, t), dname)
  }

  # Takes a template and its start context and computes the output context
  # while storing any inferences in e.
  def compute_out_ctx!(c: Context, t: ttmpl.Template) -> Context {
    # Propagate context over the body.
    c1, ok = escape_template_body!(c, t)
    if !ok {
      # Look for a fixed point by assuming c1 as the output context.
      c2, ok2 = escape_template_body!(c1, t)
      if ok2 {
        c1 = c2
        ok = true
      }
      # Use c1 as the error context if neither assumption worked.
    }
    if !ok && c1.state != STATE_ERROR {
      return err_ctx(errorf(ERR_OUTPUT_CONTEXT, t.root, 0, "cannot compute output context for template #{t.name}"))
    }
    c1
  }

  # Escapes the given template assuming the given output context, and
  # returns the best guess at the output context and whether the assumption
  # was correct.
  def escape_template_body!(c: Context, t: ttmpl.Template) -> (Context, Bool) {
    # We need to assume an output context so that recursive template calls
    # take the fast path out of escapeTree instead of infinitely recurring.
    # Naively assuming that the input context is the same as the output
    # works >90% of the time.
    self.output[t.name] = c
    saved = filter_name
    self.filter_name = t.name
    r = escape_list_conditionally!(c, t.root.unwrap, 1, c)
    self.filter_name = saved
    r
  }

  # Escapes a text template node.
  def escape_text!(c0: Context, n: parse.Node) -> Context {
    c = c0
    s = n.text
    written = 0
    i = 0
    b: [Str] = []
    while i != s.size {
      c1, nread = context_after_text(c, s[i...s.size])
      i1 = i + nread
      if c.state == STATE_TEXT || c.state == STATE_RCDATA {
        end = i1
        if c1.state != c.state {
          j = end - 1
          while j >= i {
            if s[j] == 60 {
              end = j
              break
            }
            j -= 1
          }
        }
        j = i
        while j < end {
          if s[j] == 60 && !equal_fold_ascii_prefix(s, j, "<!DOCTYPE") {
            b << s[written...j]
            b << "&lt;"
            written = j + 1
          }
          j += 1
        }
      } else if is_comment(c.state) && c.delim == DELIM_NONE {
        case c.state {
          STATE_JS_BLOCK_CMT => {
            # https://es5.github.io/#x7.4:
            # "Comments behave like white space and are discarded except
            # that, if a MultiLineComment contains a line terminator
            # character, then the entire comment is considered to be a
            # LineTerminator for purposes of parsing by the syntactic
            # grammar."
            if index_any_runes(s[written...i1], "\n\r  ") >= 0 {
              b << "\n"
            } else {
              b << " "
            }
          }
          STATE_CSS_BLOCK_CMT => b << " "
          _ => {}
        }
        written = i1
      }
      if c.state != c1.state && is_comment(c1.state) && c1.delim == DELIM_NONE {
        # Preserve the portion between written and the comment start.
        cs = i1 - 2
        if c1.state == STATE_HTML_CMT || c1.state == STATE_JS_HTML_OPEN_CMT {
          # "<!--" instead of "/*" or "//"
          cs -= 2
        } else if c1.state == STATE_JS_HTML_CLOSE_CMT {
          # "-->" instead of "/*" or "//"
          cs -= 1
        }
        b << s[written...cs]
        written = i1
      }
      if is_in_script_literal(c.state) && contains_special_script_tag(s[i...i1]) {
        b << s[written...i]
        b << escape_special_script_tags(s[i...i1])
        written = i1
      }
      if i == i1 && c.state == c1.state {
        panic("infinite loop from #{c.to_s} to #{c1.to_s} on #{gq(s[0...i])}..#{gq(s[i...s.size])}")
      }
      c = c1
      i = i1
    }
    if written != 0 && c.state != STATE_ERROR {
      if !is_comment(c.state) || c.delim != DELIM_NONE {
        b << n.text[written...n.text.size]
      }
      edit_text_node!(n, b.join(""))
    }
    c
  }

  # Records a change to an action pipeline for later commit.
  def edit_action_node!(n: parse.Node, cmds: [Str]) {
    for x in action_edits {
      panic("node #{n.to_s} shared between templates") if x[0].same?(n)
    }
    self.action_edits << (n, cmds)
  }

  # Records a change to a {{template}} callee for later commit.
  def edit_template_node!(n: parse.Node, callee: Str) {
    for x in template_edits {
      panic("node #{n.to_s} shared between templates") if x[0].same?(n)
    }
    self.template_edits << (n, callee)
  }

  # Records a change to a text node for later commit.
  def edit_text_node!(n: parse.Node, text: Str) {
    for x in text_edits {
      panic("node #{n.to_s} shared between templates") if x[0].same?(n)
    }
    self.text_edits << (n, text)
  }

  # Applies changes to actions and template calls needed to contextually
  # autoescape content and adds any derived templates to the set.
  def commit! {
    fm = escaper_funcs()
    for name, _ in output {
      if t = template(name) {
        t.funcs(fm)
      }
    }
    # Any template from the name space associated with this escaper can be
    # used to add derived templates to the underlying text/template name
    # space.
    for _, t in derived {
      r = text.add_parse_tree(t.name, t.tree.unwrap)
      panic("error adding derived template") if r.err?
    }
    for x in action_edits { ensure_pipeline_contains(x[0].pipe.unwrap, x[1]) }
    for x in template_edits { x[0].set_name(x[1]) }
    for x in text_edits { x[0].set_text(x[1]) }
    # Reset state that is specific to this commit so that the same changes
    # are not re-applied to the template on subsequent calls to commit.
    self.called = {}
    self.action_edits = []
    self.template_edits = []
    self.text_edits = []
  }

  # The named template given a mangled template name.
  def template(name: Str) -> ttmpl.Template? {
    # Any template from the name space associated with this escaper can be
    # used to look up templates in the underlying text/template name space.
    if t = text.lookup(name) {
      return t
    }
    derived[name]
  }
}

def make_escaper(set: Map[Str, Int], text: ttmpl.Template) -> Escaper {
  Escaper.new(set: set, text: text, output: {}, derived: {}, called: {}, action_edits: [], template_edits: [], text_edits: [], range_ctx: [], filter_name: "")
}

def equal_fold_ascii_prefix(s: Str, at: Int, p: Str) -> Bool {
  return false if at + p.size > s.size
  equal_fold_ascii(s[at...at + p.size], p)
}

# Contexts at break and continue statements merged into the overall body
# context.
def join_range(c00: Context, rc: RangeCtx) -> Context {
  # In theory we could treat breaks differently from continues, but for now
  # it is enough to treat them both as going back to the start of the loop
  # (which may then stop).
  c0 = c00
  for c in rc.breaks {
    c0 = join(c0, c, c.n.unwrap, "range")
    if c0.state == STATE_ERROR {
      e = c0.err.unwrap
      e.line = c.n.unwrap.line
      e.description = "at range loop break: " + e.description
      c0.err = e
      return c0
    }
  }
  for c in rc.continues {
    c0 = join(c0, c, c.n.unwrap, "range")
    if c0.state == STATE_ERROR {
      e = c0.err.unwrap
      e.line = c.n.unwrap.line
      e.description = "at range loop continue: " + e.description
      c0.err = e
      return c0
    }
  }
  c0
}

# The context that would result from following empty string transitions
# from the input context. For example, parsing `<a href=` will end in
# context{stateBeforeValue, attrURL}, but parsing one extra rune `<a href=x`
# will end in context{stateURL, delimSpaceOrTagEnd, ...}. There are two
# transitions that happen when the 'x' is seen: (1) Transition from a
# before-value state to a start-of-value state without consuming any
# character. (2) Consume 'x' and transition past the first value
# character. In this case, nudging produces the context after (1) happens.
def nudge(c0: Context) -> Context {
  c = c0
  case c.state {
    # In `<foo {{.}}`, the action should emit an attribute.
    STATE_TAG => c.state = STATE_ATTR_NAME
    STATE_BEFORE_VALUE => {
      # In `<foo bar={{.}}`, the action is an undelimited value.
      c.state = attr_start_state(c.attr)
      c.delim = DELIM_SPACE_OR_TAG_END
      c.attr = ATTR_NONE
    }
    STATE_AFTER_NAME => {
      # In `<foo bar {{.}}`, the action is an attribute name.
      c.state = STATE_ATTR_NAME
      c.attr = ATTR_NONE
    }
    _ => {}
  }
  c
}

# Joins the two contexts of a branch template node. The result is an error
# context if either of the input contexts are error contexts, or if the
# input contexts differ.
def join(a: Context, b: Context, node: parse.Node, node_name: Str) -> Context {
  return a if a.state == STATE_ERROR
  return b if b.state == STATE_ERROR
  return b if a.state == STATE_DEAD
  return a if b.state == STATE_DEAD
  return a if a.eq(b)
  c = a
  c.url_part = b.url_part
  if c.eq(b) {
    # The contexts differ only by urlPart.
    c.url_part = URL_PART_UNKNOWN
    return c
  }
  c = a
  c.js_ctx = b.js_ctx
  if c.eq(b) {
    # The contexts differ only by jsCtx.
    c.js_ctx = JS_CTX_UNKNOWN
    return c
  }
  # Allow a nudged context to join with an unnudged one. This means that
  #   <p title={{if .C}}{{.}}{{end}}
  # ends in an unquoted value state even though the else branch ends in
  # stateBeforeValue.
  c2 = nudge(a)
  d = nudge(b)
  if !(c2.eq(a) && d.eq(b)) {
    e = join(c2, d, node, node_name)
    return e if e.state != STATE_ERROR
  }
  err_ctx(errorf(ERR_BRANCH_END, node, 0, "{{#{node_name}}} branches end in different contexts: #{a.to_s}, #{b.to_s}"))
}

# Template predefined escapers that are equivalent to some contextual
# escapers. Keep in sync with equiv_escaper.
def predefined_escaper?(name: Str) -> Bool { name == "html" || name == "urlquery" }

# The predefined template escaper a contextual escaper is equivalent to
# (Go's equivEscapers), or "".
def equiv_escaper(name: Str) -> Str {
  case name {
    # The following pairs of HTML escapers provide equivalent security
    # guarantees, since they all escape '\000', '\'', '"', '&', '<', and
    # '>'.
    "_html_template_attrescaper" | "_html_template_htmlescaper" | "_html_template_rcdataescaper" => "html"
    # These two URL escapers produce URLs safe for embedding in a URL query
    # by percent-encoding all the reserved characters specified in RFC 3986
    # Section 2.2
    "_html_template_urlescaper" => "urlquery"
    # These two functions are not actually equivalent; urlquery is stricter
    # as it escapes reserved characters (e.g. '#'), while
    # _html_template_urlnormalizer does not. It is therefore only safe to
    # replace _html_template_urlnormalizer with urlquery (this happens in
    # ensurePipelineContains), but not the other way around. We keep this
    # entry around to preserve the behavior of templates written before Go
    # 1.9, which might depend on this substitution taking place.
    "_html_template_urlnormalizer" => "urlquery"
    _ => ""
  }
}

# Whether the two escaping functions are equivalent.
def esc_fns_eq(a: Str, b: Str) -> Bool { normalize_esc_fn(a) == normalize_esc_fn(b) }

# normalize_esc_fn(a) is equal to normalize_esc_fn(b) for any pair of names
# of escaper functions a and b that are equivalent.
def normalize_esc_fn(e: Str) -> Str {
  norm = equiv_escaper(e)
  return norm if norm != ""
  e
}

# Whether funcMap[b](funcMap[a](x)) == funcMap[a](x) for all x (Go's
# redundantFuncs[a][b]).
def redundant_funcs(a: Str, b: Str) -> Bool {
  case a {
    "_html_template_commentescaper" => b == "_html_template_attrescaper" || b == "_html_template_htmlescaper"
    "_html_template_cssescaper" | "_html_template_jsregexpescaper" | "_html_template_jsstrescaper" | "_html_template_jstmpllitescaper" => b == "_html_template_attrescaper"
    "_html_template_urlescaper" => b == "_html_template_urlnormalizer"
    _ => false
  }
}

# Appends the given command to the end of the command pipeline unless it is
# redundant with the last command.
def append_cmd(cmds: [parse.Node], cmd: parse.Node) -> [parse.Node] {
  out = cmds
  if out.size != 0 {
    last = out[out.size - 1].args[0]
    nxt = cmd.args[0]
    if last.typ == parse.NODE_IDENTIFIER && nxt.typ == parse.NODE_IDENTIFIER && redundant_funcs(last.ident_name, nxt.ident_name) {
      return out
    }
  }
  out << cmd
  out
}

# A command containing a single identifier node.
def new_ident_cmd(p: parse.Node, identifier: Str, pos: Int) -> parse.Node {
  p.new_command(pos, [p.new_identifier(identifier, pos)])
}

# Ensures that the pipeline ends with the commands with the identifiers in s
# in order. If the pipeline ends with a predefined escaper (i.e. "html" or
# "urlquery"), merge it with the identifiers in s.
def ensure_pipeline_contains(p: parse.Node, s0: [Str]) {
  # Do not rewrite pipeline if we have no escapers to insert.
  return nil if s0.size == 0
  s = s0.map { it }
  # Precondition: p.Cmds contains at most one predefined escaper and the
  # escaper will be present at p.Cmds[len(p.Cmds)-1]. This precondition is
  # always true because of the checks in escapeAction.
  cmds = p.cmds
  pipeline_len = cmds.size
  if pipeline_len > 0 {
    last_cmd = cmds[pipeline_len - 1]
    id_node = last_cmd.args[0]
    if id_node.typ == parse.NODE_IDENTIFIER {
      esc = id_node.ident_name
      if predefined_escaper?(esc) {
        # Pipeline ends with a predefined escaper.
        if cmds.size == 1 && last_cmd.args.size > 1 {
          # Special case: pipeline is of the form {{ esc arg1 arg2 ... argN }},
          # where esc is the predefined escaper, and arg1...argN are its
          # arguments. Convert this into the equivalent form
          # {{ _eval_args_ arg1 arg2 ... argN | esc }}, so that esc can be
          # easily merged with the escapers in s.
          args = last_cmd.args
          args[0] = p.new_identifier("_eval_args_", args[0].pos)
          last_cmd.set_args(args)
          cmds = append_cmd(cmds, new_ident_cmd(p, esc, p.pos))
          pipeline_len += 1
        }
        # If any of the commands in s that we are about to insert is
        # equivalent to the predefined escaper, use the predefined escaper
        # instead.
        dup = false
        i = 0
        while i < s.size {
          if esc_fns_eq(esc, s[i]) {
            s[i] = esc
            dup = true
          }
          i += 1
        }
        if dup {
          # The predefined escaper will already be inserted along with the
          # escapers in s, so do not copy it to the rewritten pipeline.
          pipeline_len -= 1
        }
      }
    }
  }
  # Rewrite the pipeline, creating the escapers in s at the end of the
  # pipeline.
  new_cmds: [parse.Node] = []
  inserted: Map[Str, Bool] = {}
  i = 0
  while i < pipeline_len {
    cmd = cmds[i]
    new_cmds << cmd
    id_node = cmd.args[0]
    if id_node.typ == parse.NODE_IDENTIFIER {
      inserted[normalize_esc_fn(id_node.ident_name)] = true
    }
    i += 1
  }
  for name in s {
    if !(inserted[normalize_esc_fn(name)] || false) {
      # When two templates share an underlying parse tree via the use of
      # AddParseTree and one template is executed after the other, this
      # check ensures that escapers that were already inserted into the
      # pipeline on the first escaping pass do not get inserted again.
      new_cmds = append_cmd(new_cmds, new_ident_cmd(p, name, p.pos))
    }
  }
  p.set_cmds(new_cmds)
  nil
}

# Starts in context c, consumes some tokens from the front of s, then
# returns the context after those tokens and the number of bytes consumed.
def context_after_text(c: Context, s: Str) -> (Context, Int) {
  if c.delim == DELIM_NONE {
    c1, i = t_special_tag_end(c, s)
    if i == 0 {
      # A special end tag (`</script>`) has been seen and all content
      # preceding it has been consumed.
      return (c1, 0)
    }
    # Consider all content up to any end tag.
    return transition(c, s[0...i])
  }
  # We are at the beginning of an attribute value.
  i = index_any(s, delim_ends(c.delim))
  i = s.size if i == -1
  if c.delim == DELIM_SPACE_OR_TAG_END {
    # https://www.w3.org/TR/html5/syntax.html#attribute-value-(unquoted)-state
    # lists the runes below as error characters. Error out because HTML
    # parsers may differ on whether
    #   "<a id= onclick=f("     ends inside id's or onclick's value,
    #   "<a class=`foo "        ends inside a value,
    #   "<a style=font:'Arial'" needs open-quote fixup.
    # IE treats '`' as a quotation character.
    j = index_any(s[0...i], "\"'<=`")
    if j >= 0 {
      return (err_ctx(errorf(ERR_BAD_HTML, none, 0, "#{gq(s[j...j + 1])} in unquoted attr: #{gq(s[0...i])}")), s.size)
    }
  }
  if i == s.size {
    # Remain inside the attribute. Decode the value so non-HTML rules can
    # easily handle
    #     <button onclick="alert(&quot;Hi!&quot;)">
    # without having to entity decode token boundaries.
    r = c
    u = html.unescape_string(s)
    while u.size != 0 {
      c1, i1 = transition(r, u)
      r = c1
      u = u[i1...u.size]
    }
    return (r, s.size)
  }
  element = c.element
  # If this is a non-JS "type" attribute inside "script" tag, do not treat
  # the contents as JS.
  if c.state == STATE_ATTR && c.element == ELEMENT_SCRIPT && c.attr == ATTR_SCRIPT_TYPE && !is_js_type(s[0...i]) {
    element = ELEMENT_NONE
  }
  if c.delim != DELIM_SPACE_OR_TAG_END {
    # Consume any quote.
    i += 1
  }
  # On exiting an attribute, we discard all state information except the
  # state and element.
  r = ctx(STATE_TAG)
  r.element = element
  (r, i)
}

# The characters that terminate each delimiter (Go's delimEnds).
def delim_ends(d: Int) -> Str {
  case d {
    DELIM_DOUBLE_QUOTE => "\""
    DELIM_SINGLE_QUOTE => "'"
    # Determined empirically by running the below in various browsers.
    # var div = document.createElement("DIV");
    # for (var i = 0; i < 0x10000; ++i) {
    #   div.innerHTML = "<span title=x" + String.fromCharCode(i) + "-bar>";
    #   if (div.getElementsByTagName("SPAN")[0].title.indexOf("bar") < 0)
    #     document.write("<p>U+" + i.toString(16));
    # }
    DELIM_SPACE_OR_TAG_END => " \t\n\x0c\r>"
    _ => ""
  }
}

# Per WHATWG HTML specification, section 4.12.1.3, there are extremely
# complicated rules for how to handle the set of opening tags <!--,
# <script, and </script when they appear in JS literals (i.e. strings,
# regexs, and comments). The specification suggests a simple solution,
# rather than implementing the arcane ABNF, which involves simply escaping
# the opening bracket with \x3C (Go's (?i)<(script|/script|!--) regexp).
def special_script_tag_at(s: Str, i: Int) -> Int {
  return 0 if s[i] != 60
  return 7 if equal_fold_ascii_prefix(s, i + 1, "script")
  return 8 if equal_fold_ascii_prefix(s, i + 1, "/script")
  return 4 if i + 4 <= s.size && s[i + 1...i + 4] == "!--"
  0
}

def contains_special_script_tag(s: Str) -> Bool {
  i = 0
  while i < s.size {
    return true if special_script_tag_at(s, i) > 0
    i += 1
  }
  false
}

def escape_special_script_tags(s: Str) -> Str {
  out: [Str] = []
  written = 0
  i = 0
  while i < s.size {
    n = special_script_tag_at(s, i)
    if n > 0 {
      out << s[written...i]
      out << "\\x3C" + s[i + 1...i + n]
      written = i + n
      i += n
      next
    }
    i += 1
  }
  out << s[written...s.size]
  out.join("")
}

# Rewrites the named template, which must be associated with t, to
# guarantee that the output of any of the named templates is properly
# escaped. If no error is returned, then the named templates have been
# modified. Otherwise the named templates have been rendered unusable.
def escape_template(t: Template, node: parse.Node, name: Str) -> ~Unit {
  esc = t.ns_esc
  c, _ = esc.escape_tree!(ctx(STATE_TEXT), node, name, 0)
  t.set_ns_esc(esc)
  err: EscapeError? = none
  if e = c.err {
    ee = e
    ee.name = name
    err = escape_error(ee)
  } else if c.state != STATE_TEXT {
    err = escape_error(ErrInfo.new(code: ERR_END_CONTEXT, name: name, line: 0, description: "ends in a non-text context: #{c.to_s}"))
  }
  if e = err {
    # Prevent execution of unsafe templates.
    if x = t.lookup_state(name) {
      t.set_escape_err(x, e)
    }
    fail e
  }
  esc.commit!
  t.set_ns_esc(esc)
  if x = t.lookup_state(name) {
    t.set_escape_ok(x)
  }
  nil
}
