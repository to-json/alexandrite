test "unterminated string error" {
  r = new("X").parse("hello\n\n{{`unterminated\n\n\n\n}}\n some more\n\n")
  assert r.err?, "expected error"
  assert strings.contains(r.err?.message || "", "X:3: unterminated raw quoted string"), r.err?.message || ""
}

struct ErrorWriter {
  pub def write!(p: [Byte]) -> ~Int {
    fail Failure.Msg("always be failing")
  }
}

def exec_error?(r: ~Str) -> Bool {
  if e = r.err {
    case e {
      ttmpl.ExecError.Exec(_, _) => {return true}
      _ => {return false}
    }
  }
  false
}

test "execute gives exec error" {
  # First, a non-execution error shouldn't be an ExecError.
  tmpl = new("X").~parse("hello")
  w = ErrorWriter.new
  r = tmpl.execute(w, iv(0))
  assert_eq r.err?.message || "", "always be failing"
  # This one should be an ExecError.
  tmpl2 = new("X").~parse("hello, {{.X.Y}}")
  r2 = tmpl2.execute_str(iv(0))
  assert exec_error?(r2), "expected ExecError"
  assert strings.contains(r2.err?.message || "", "field X in type int"), r2.err?.message || ""
}

def func_name_test_func -> dyn.Func { dyn.Func.of("func() int", ->(a: [dyn.Value]) -> ~dyn.Value { iv(0) }) }

test "good func names" {
  for name in ["_", "a", "a1", "a1", "Ӵ"] {
    tmpl = new("X").funcs({name => func_name_test_func()})
    assert_eq tmpl.name, "X"
  }
}

test "bad func names" {
  for name in ["", "2", "a-b"] {
    # Funcs panics, as Go's does.
    t = spawn { new("X").funcs({name => func_name_test_func()}).name }
    assert t.wait.err?, "#{name} succeeded incorrectly as function name"
  }
}

test "block" {
  input = "a({{block \"inner\" .}}bar({{.}})baz{{end}})b"
  want = "a(bar(hello)baz)b"
  overlay = "{{define \"inner\"}}foo({{.}})bar{{end}}"
  want2 = "a(foo(goodbye)bar)b"
  tmpl = new("outer").~parse(input)
  cl = tmpl.clone
  tmpl2 = must(cl).~parse(overlay)
  assert_eq tmpl.~execute_str(sv("hello")), want
  assert_eq tmpl2.~execute_str(sv("goodbye")), want2
}

test "eval field errors" {
  t_ = dyn.Value.struct_of("template.T", ["X"], [sv("")])
  # Go's MissingFieldOnNil wants "can't evaluate field MissingField in type
  # *template.T": alx's nil pointer doesn't know its element's fields, so
  # it says "nil pointer evaluating *template.T.MissingField".
  cases = [
    ("{{.MissingField}}", t_.ptr, "can't evaluate field MissingField in type *template.T"),
    ("{{.X}}", dyn.Value.nil_of("*template.T"), "nil pointer evaluating *template.T.X"),
    ("{{.MissingKey}}", dyn.Value.nil_of("*map[string]string"), "nil pointer evaluating *map[string]string.MissingKey"),
    ("{{.MissingKey}}", dyn.Value.map_of([], [], "map[string]string").ptr, "<nil>"),
  ]
  for c in cases {
    tmpl = must(new("tmpl").parse(c[0]))
    r = tmpl.execute_str(c[1])
    got = r.err?.message || "<nil>"
    assert strings.has_suffix(got, c[2]), "got error #{got}, want #{c[2]}"
  }
}

test "max exec depth" {
  tmpl = must(new("tmpl").parse("{{template \"tmpl\" .}}"))
  r = tmpl.execute_str(dyn.Value.invalid)
  assert strings.contains(r.err?.message || "<nil>", "exceeded maximum template depth"), r.err?.message || "<nil>"
}

# golang.org/issue/14916. (V's String is to_s in alx, so the templates ask
# for .to_s.)
test "addr of index" {
  texts = ["{{range .}}{{.to_s}}{{end}}", "{{with index . 0}}{{.to_s}}{{end}}"]
  for text in texts {
    tmpl = must(new("tmpl").parse(text))
    data = dyn.Value.list_of([V.new(j: 1).to_data], "[]template.V")
    assert_eq tmpl.~execute_str(data), "&lt;1&gt;"
  }
}

test "interface values" {
  cases = [
    ("{{index .Nil 1}}", "ERROR: index of untyped nil"),
    ("{{index .Slice 2}}", "2"),
    ("{{index .Slice .Two}}", "2"),
    ("{{call .Nil 1}}", "ERROR: call of nil"),
    ("{{call .PlusOne 1}}", "2"),
    ("{{call .PlusOne .One}}", "2"),
    ("{{and (index .Slice 0) true}}", "0"),
    ("{{and .Zero true}}", "0"),
    ("{{and (index .Slice 1) false}}", "false"),
    ("{{and .One false}}", "false"),
    ("{{or (index .Slice 0) false}}", "false"),
    ("{{or .Zero false}}", "false"),
    ("{{or (index .Slice 1) true}}", "1"),
    ("{{or .One true}}", "1"),
    ("{{not (index .Slice 0)}}", "true"),
    ("{{not .Zero}}", "true"),
    ("{{not (index .Slice 1)}}", "false"),
    ("{{not .One}}", "false"),
    ("{{eq (index .Slice 0) .Zero}}", "true"),
    ("{{eq (index .Slice 1) .One}}", "true"),
    ("{{ne (index .Slice 0) .Zero}}", "false"),
    ("{{ne (index .Slice 1) .One}}", "false"),
    ("{{ge (index .Slice 0) .One}}", "false"),
    ("{{ge (index .Slice 1) .Zero}}", "true"),
    ("{{gt (index .Slice 0) .One}}", "false"),
    ("{{gt (index .Slice 1) .Zero}}", "true"),
    ("{{le (index .Slice 0) .One}}", "true"),
    ("{{le (index .Slice 1) .Zero}}", "false"),
    ("{{lt (index .Slice 0) .One}}", "true"),
    ("{{lt (index .Slice 1) .Zero}}", "false"),
  ]
  plus_one = dyn.Func.of("func(int) int", ->(a: [dyn.Value]) -> ~dyn.Value { iv(a[0].int_val + 1) })
  data = dyn.Value.map({
    "PlusOne" => dyn.Value.func(plus_one),
    "Slice" => dyn.Value.list_of([iv(0), iv(1), iv(2), iv(3)], "[]int"),
    "One" => iv(1),
    "Two" => iv(2),
    "Nil" => dyn.Value.invalid,
    "Zero" => iv(0),
  })
  for c in cases {
    tmpl = must(new("tmpl").parse(c[0]))
    r = tmpl.execute_str(data)
    if strings.has_prefix(c[1], "ERROR:") {
      e = strings.trim_space(strings.trim_prefix(c[1], "ERROR:"))
      assert strings.contains(r.err?.message || "", e), "#{c[0]}: Execute: #{r.err?.message || ""}, want error #{e}"
      next
    }
    assert r.ok?, "#{c[0]}: Execute: #{r.err?.message || ""}"
    assert_eq r.unwrap, c[1]
  }
}

# Panics during calls are errors in Go (recovered); alx functions fail
# instead. The method calls on nil receivers (GetU on a nil *T) can't
# exist in alx.
test "execute panic during call" {
  do_panic = dyn.Func.of("func() string", ->(a: [dyn.Value]) -> ~dyn.Value {
    fail Failure.Msg("custom panic string")
    dyn.Value.invalid
  })
  cases = [
    ("direct func call panics", "{{doPanic}}", dyn.Value.nil_of("*template.T"), "template: t:1:2: executing \"t\" at <doPanic>: error calling doPanic: custom panic string"),
    ("indirect func call panics", "{{call doPanic}}", dyn.Value.nil_of("*template.T"), "template: t:1:7: executing \"t\" at <doPanic>: error calling doPanic: custom panic string"),
    ("func field call panics", "{{call .PanicFunc}}", tval(), "template: t:1:2: executing \"t\" at <call .PanicFunc>: error calling call: test panic"),
    ("method call on nil interface", "{{.NonEmptyInterfaceNil.Method0}}", tval(), "template: t:1:23: executing \"t\" at <.NonEmptyInterfaceNil.Method0>: nil pointer evaluating template.I.Method0"),
  ]
  for c in cases {
    tmpl = new("t").funcs({"doPanic" => do_panic}).~parse(c[1])
    r = tmpl.execute_str(c[2])
    assert r.err?, "#{c[0]}: expected error; got none"
    assert strings.contains(r.err?.message || "", c[3]), "#{c[0]}: got #{r.err?.message || ""}"
  }
}

test "parse fs" {
  fsys = fs.dir_fs("testdata")
  assert parse_fs(fsys, ["DOES NOT EXIST"]).err?, "expected error for non-existent file; got none"
  multi_case(new("root").~parse_fs(fsys, ["file1.tmpl", "file2.tmpl"]))
  multi_case(new("root").~parse_fs(fsys, ["file*.tmpl"]))
}

test "parse zip fs" {
  z = zip.open_reader("testdata/fs.zip").unwrap
  tmpl = new("root").~parse_fs(z, ["tmpl*.tmpl"])
  run_exec(tmpl.clone.unwrap.new("test"), "test", "{{template \"tmpl1.tmpl\"}}{{template \"tmpl2.tmpl\"}}", "template1\n\ny\ntemplate2\n\nx\n", iv(0), true)
}
