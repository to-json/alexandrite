# Issue 10910, 10926
test "template look up" {
  t1 = new("foo")
  assert t1.lookup("foo") != none, "t1.Lookup(foo)"
  t1.new("bar")
  assert t1.lookup("bar") != none, "t1.Lookup(bar)"
  _a = t1.parse("{{define \"foo\"}}test{{end}}")
  assert t1.lookup("foo") != none, "Lookup returned nil value for defined template"
}

test "parse" {
  # In multiple calls to Parse with the same receiver template, only one
  # call can contain text other than space, comments, and template
  # definitions
  t1 = new("test")
  _a = t1.~parse("{{define \"test\"}}{{end}}")
  _b = t1.~parse("{{define \"test\"}}{{/* this is a comment */}}{{end}}")
  _c = t1.~parse("{{define \"test\"}}foo{{end}}")
}

test "empty template" {
  cases = [
    (["x", "y"], "", "y"),
    ([""], "once", ""),
    (["", ""], "twice", ""),
    (["{{.}}", "{{.}}"], "twice", "twice"),
    (["{{/* a comment */}}", "{{/* a comment */}}"], "comment", ""),
    (["{{.}}", ""], "twice", "twice"),
  ]
  for c in cases {
    root = new("root")
    m = root
    for d in c[0] {
      m = root.new(c[1]).~parse(d)
    }
    assert_eq m.~execute_str(sv(c[1])), c[2]
  }
}

# Issue 19249 was a regression in 1.8 caused by the handling of empty
# templates added in that release.
test "issue 19294" {
  inlined: Map[Str, Str] = {
    "stylesheet" => "{{define \"stylesheet\"}}stylesheet{{end}}",
    "xhtml" => "{{block \"stylesheet\" .}}{{end}}",
  }
  all = ["stylesheet", "xhtml"]
  i = 0
  while i < 100 {
    res = new("title.xhtml").~parse("{{template \"xhtml\" .}}")
    for name in all {
      _a = res.new(name).~parse(inlined[name].unwrap)
    }
    assert_eq res.~execute_str(iv(0)), "stylesheet"
    i += 1
  }
}

# template_test.go

test "template clone" {
  # https://golang.org/issue/12996
  orig = new("name")
  cl = orig.~clone
  assert_eq cl.templates.size, orig.templates.size
  parsed = must(cl.parse("stuff"))
  assert_eq parsed.~execute_str(dyn.Value.invalid), "stuff"
}

#[track_caller]
def must_parse(t: Template, text: Str) { assert t.parse(text).ok?, "parse: #{text}" }

#[track_caller]
def must_not_parse(t: Template, text: Str) { assert t.parse(text).err?, "parse: unexpected success" }

def must_execute(t: Template, v: dyn.Value, want: Str) {
  r = t.execute_str(v)
  assert r.ok?, "execute: #{r.err?.message || ""}"
  assert_eq r.unwrap, want
}

test "redefine non empty after execution" {
  root = new("root")
  must_parse(root, "foo")
  must_execute(root, dyn.Value.invalid, "foo")
  must_not_parse(root, "bar")
}

test "redefine empty after execution" {
  root = new("root")
  must_parse(root, "")
  must_execute(root, dyn.Value.invalid, "")
  must_not_parse(root, "foo")
  must_execute(root, dyn.Value.invalid, "")
}

test "redefine after non execution" {
  root = new("root")
  must_parse(root, "{{if .}}<{{template \"X\"}}>{{end}}{{define \"X\"}}foo{{end}}")
  must_execute(root, iv(0), "")
  must_not_parse(root, "{{define \"X\"}}bar{{end}}")
  must_execute(root, iv(1), "&lt;foo>")
}

test "redefine after named execution" {
  root = new("root")
  must_parse(root, "<{{template \"X\" .}}>{{define \"X\"}}foo{{end}}")
  must_execute(root, dyn.Value.invalid, "&lt;foo>")
  must_not_parse(root, "{{define \"X\"}}bar{{end}}")
  must_execute(root, dyn.Value.invalid, "&lt;foo>")
}

test "redefine nested by name after execution" {
  root = new("root")
  must_parse(root, "{{define \"X\"}}foo{{end}}")
  must_execute(root.lookup("X").unwrap, dyn.Value.invalid, "foo")
  must_not_parse(root, "{{define \"X\"}}bar{{end}}")
  must_execute(root.lookup("X").unwrap, dyn.Value.invalid, "foo")
}

test "redefine nested by template after execution" {
  root = new("root")
  must_parse(root, "{{define \"X\"}}foo{{end}}")
  must_execute(root.lookup("X").unwrap, dyn.Value.invalid, "foo")
  must_not_parse(root.lookup("X").unwrap, "bar")
  must_execute(root.lookup("X").unwrap, dyn.Value.invalid, "foo")
}

test "redefine safety" {
  root = new("root")
  must_parse(root, "<html><a href=\"{{template \"X\"}}\">{{define \"X\"}}{{end}}")
  must_execute(root, dyn.Value.invalid, "<html><a href=\"\">")
  # Note: Every version of Go prior to Go 1.8 accepted the redefinition of
  # "X" on the next line, but luckily kept it from being used in the outer
  # template. Now we reject it, which makes clearer that we're not going to
  # use it.
  must_not_parse(root, "{{define \"X\"}}\" bar=\"baz{{end}}")
  must_execute(root, dyn.Value.invalid, "<html><a href=\"\">")
}

test "redefine top use" {
  root = new("root")
  must_parse(root, "{{template \"X\"}}{{.}}{{define \"X\"}}{{end}}")
  must_execute(root, iv(42), "42")
  must_not_parse(root, "{{define \"X\"}}<script>{{end}}")
  must_execute(root, iv(42), "42")
}

test "redefine other parsers" {
  root = new("root")
  must_parse(root, "")
  must_execute(root, dyn.Value.invalid, "")
  r1 = root.parse_files(["no.template"])
  assert strings.contains(r1.err?.message || "", "execute"), "ParseFiles: #{r1.err?.message || ""}"
  r2 = root.parse_glob("*.no.template")
  assert strings.contains(r2.err?.message || "", "execute"), "ParseGlob: #{r2.err?.message || ""}"
  r3 = root.add_parse_tree("t1", root.tree.unwrap)
  assert strings.contains(r3.err?.message || "", "execute"), "AddParseTree: #{r3.err?.message || ""}"
}

test "numbers" {
  root = new("root")
  must_parse(root, "{{print 1_2.3_4}} {{print 0x0_1.e_0p+02}}")
  must_execute(root, dyn.Value.invalid, "12.34 7.5")
}

test "strings in scripts with json content type are correctly escaped" {
  # See #33671 and #37634 for more context on this.
  ins = ["", Str.from_bytes([0xef, 0xbf, 0xbd]), "\x00", "\x1f", "\t", "<>", "'\"", "ASCII letters", "ʕ⊙ϖ⊙ʔ", "🍕"]
  prefix = "<script type=\"application/ld+json\">"
  suffix = "</script>"
  tpl = must(new("JS string is JSON string").parse(prefix + "\"{{.}}\"" + suffix))
  for s in ins {
    out = tpl.~execute_str(sv(s))
    trimmed = strings.trim_suffix(strings.trim_prefix(out, prefix), suffix)
    got = json_unquote(trimmed)
    assert_eq got, s
  }
}

def json_unquote(s: Str) -> Str { json.parse(s).unwrap.as_str.unwrap }

test "skip escape comments" {
  tr = parse.new_tree("root")
  tr.set_mode(parse.PARSE_COMMENTS)
  set: Map[Str, parse.Tree] = {}
  new_t = tr.~parse("{{/* A comment */}}{{ 1 }}{{/* Another comment */}}", "", "", set, [])
  root = new("root").~add_parse_tree("root", new_t)
  must_execute(root, dyn.Value.invalid, "1")
}

test "js escaping" {
  cases = [
    ("a", "a"),
    ("'foo", "\\'foo"),
    ("Go \"jump\" \\", "Go \\\"jump\\\" \\\\"),
    ("Yukihiro says \"今日は世界\"", "Yukihiro says \\\"今日は世界\\\""),
    ("unprintable \uFFFE", "unprintable \\uFFFE"),
    ("<html>", "\\u003Chtml\\u003E"),
    ("no = in attributes", "no \\u003D in attributes"),
    ("&#x27; does not become HTML entity", "\\u0026#x27; does not become HTML entity"),
  ]
  for c in cases {
    assert_eq js_escape_string(c[0]), c[1]
  }
}

