# Helpers for Go's html/template test tables (tables_test.alx, generated)
# and the data of TestEscape.

import "dyn"
import "bytes"
import "math"
import "html"
import "strings"
import ttmpl "text/template"

def sv(s: Str) -> dyn.Value { dyn.Value.str(s) }

# Go's badMarshaler: MarshalJSON returns invalid JSON.
#[derive(Data)]
#[data("template.badMarshaler")]
struct BadMarshaler {
  #[data("MarshalJSON")]
  pub def marshal_json -> Str { "{ foo: 'not quite valid JSON' }" }
}

# Go's goodMarshaler.
#[derive(Data)]
#[data("template.goodMarshaler")]
struct GoodMarshaler {
  #[data("MarshalJSON")]
  pub def marshal_json -> Str { "{ \"<foo>\": \"O'Reilly\" }" }
}

# Go's jsonErrType: MarshalJSON fails.
#[derive(Data)]
#[data("template.jsonErrType")]
struct JsonErrType {
  #[data("MarshalJSON")]
  pub def marshal_json -> ~Str {
    fail Failure.Msg("a */ b <script c </script d <!-- e <sCrIpT f </sCrIpT")
    ""
  }
}

def json_err_type -> dyn.Value { JsonErrType.new.to_data.ptr }

# TestEscape's data.
def escape_data -> dyn.Value {
  dyn.Value.struct_of("struct { F bool; T bool; C string; G string; H string; I string; A []string; E []string; B json.Marshaler; M json.Marshaler; N int; U interface {}; Z *int; W template.HTML }", ["F", "T", "C", "G", "H", "I", "A", "E", "B", "M", "N", "U", "Z", "W"], [
    dyn.Value.bool(false),
    dyn.Value.bool(true),
    sv("<Cincinnati>"),
    sv("<Goodbye>"),
    sv("<Hello>"),
    sv("${ asd `` }"),
    dyn.Value.list_of([sv("<a>"), sv("<b>")], "[]string"),
    dyn.Value.list_of([], "[]string"),
    BadMarshaler.new.to_data.ptr,
    GoodMarshaler.new.to_data.ptr,
    dyn.Value.int(42),
    dyn.Value.nil_of("interface {}"),
    dyn.Value.nil_of("*int"),
    html("&iexcl;<b class=\"foo\">Hello</b>, <textarea>O'World</textarea>!"),
  ])
}

def exec_buf(t: Template, data: dyn.Value) -> (Str, Str) {
  b = bytes.new_buffer([])
  r = t.execute(b, data)
  (b.string, r.err?.message || "")
}

def check_escape(name: Str, input: Str, output: Str) {
  tmpl = must(new(name).parse(input))
  data = escape_data()
  got, err = exec_buf(tmpl, data)
  assert err == "", "#{name}: template execution failed: #{err}"
  assert_eq got, output
  got2, err2 = exec_buf(tmpl, data.ptr)
  assert err2 == "", "#{name}: template execution failed for pointer: #{err2}"
  assert_eq got2, output
}

# TestEscapeSet's data: a recursive tree (built as values).
def data_item(x: Str, kids: [dyn.Value]) -> dyn.Value {
  dyn.Value.struct_of("template.dataItem", ["Children", "X"], [kids.size == 0 ? dyn.Value.nil_of("[]*template.dataItem") : dyn.Value.list_of(kids, "[]*template.dataItem"), sv(x)]).ptr
}

def check_escape_set(inputs: Map[Str, Str], want: Str) {
  data = data_item("", [data_item("foo", []), data_item("<bar>", []), data_item("", [data_item("baz", [])])]).elem
  # pred is a template function that returns the predecessor of a natural
  # number for testing recursive templates.
  pred = dyn.Func.of("func(...interface {}) (interface {}, error)", ->(a: [dyn.Value]) -> ~dyn.Value {
    if a.size == 1 && a[0].kind == dyn.KIND_INT && a[0].type_name == "int" && a[0].int_val > 0 {
      return dyn.Value.int(a[0].int_val - 1)
    }
    fail Failure.Msg("undefined pred(#{dyn.fmt_print([dyn.Value.list(a)])})")
    dyn.Value.invalid
  })
  source = ""
  for name, body in inputs {
    source = source + "{{define #{strconv_quote(name)}}}#{body}{{end}} "
  }
  tmpl = new("root").funcs({"pred" => pred}).parse(source).unwrap
  b = bytes.new_buffer([])
  r = tmpl.execute_template(b, "main", data)
  assert r.ok?, r.err?.message || ""
  assert_eq b.string, want
}

def strconv_quote(s: Str) -> Str { gq(s) }

def check_errors(input: Str, err: Str) {
  tmpl = new("z").parse(input).unwrap
  b = bytes.new_buffer([])
  r = tmpl.execute(b, dyn.Value.invalid)
  got = r.err?.message || ""
  if err == "" {
    assert got == "", "input=#{input}: unexpected error #{got}"
    return nil
  }
  assert strings.contains(got, err), "input=#{input}: error #{got} does not contain #{err}"
  # Check that we get the same error if we call Execute again.
  r2 = tmpl.execute(b, dyn.Value.invalid)
  assert_eq r2.err?.message || "", got
  nil
}

def tctx(state: Int, delim: Int, url_part: Int, js_ctx: Int, depth: [Int], set: Bool, attr: Int, element: Int) -> Context {
  Context.new(state: state, delim: delim, url_part: url_part, js_ctx: js_ctx, js_brace_depth: depth, jsbd_set: set, attr: attr, element: element)
}

def check_escape_text(input: Str, output: Context) {
  e = make_escaper({}, ttmpl.new(""))
  n = parse.new_identifier("x").new_text(0, input)
  c = e.escape_text!(ctx(STATE_TEXT), n)
  assert output.eq(c), "input #{input}: want context #{output.to_s} got #{c.to_s}"
  assert_eq n.text, input
}

def check_ensure_pipeline_contains(input: Str, output: Str, ids: [Str]) {
  tmpl = ttmpl.must(ttmpl.new("test").parse(input))
  action = tmpl.tree.unwrap.root.unwrap.nodes[0]
  assert_eq action.typ, parse.NODE_ACTION
  pipe = action.pipe.unwrap
  ensure_pipeline_contains(pipe, ids)
  assert_eq pipe.to_s, output
}

#[track_caller]
def check_escape_malformed_pipelines(t: Str) {
  tmpl = new("test").parse(t).unwrap
  assert tmpl.execute_str(dyn.Value.invalid).err?, "Expected error for #{t}"
}

#[track_caller]
def check_cve202656858(name: Str, tmpl_text: Str, input: Str, want: Str) {
  tmpl = must(new("test").parse(tmpl_text))
  assert_eq tmpl.execute_str(sv(input)).unwrap, want
}

TYPED_DATA_COUNT = 9

def typed_data -> [dyn.Value] {
  [
    sv("<b> \"foo%\" O'Reilly &bar;"),
    css("a[href =~ \"//example.com\"]#foo"),
    html("Hello, <b>World</b> &amp;tc!"),
    html_attr(" dir=\"ltr\""),
    js("c && alert(\"Hello, World!\");"),
    js_str("Hello, World & O'Reilly\\u0021"),
    url("greeting=H%69,&addressee=(World)"),
    srcset("greeting=H%69,&addressee=(World) 2x, https://golang.org/favicon.ico 500.5w"),
    url(",foo/,"),
  ]
}

#[track_caller]
def check_typed_content(input: Str, want: [Str]) {
  tmpl = must(new("x").parse(input))
  pre = input.byteindex("{{.}}")
  post = input.size - (pre + 5)
  i = 0
  for x in typed_data() {
    got = tmpl.execute_str(x).unwrap
    assert_eq got[pre...got.size - post], want[i]
    i += 1
  }
}

