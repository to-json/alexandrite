def utf8_encode(r: Rune) -> [Byte] { utf8.encode_rune(r) }

LOWER7 = "\x00\x01\x02\x03\x04\x05\x06\x07\x08\t\n\x0b\x0c\r\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f !\"\#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\x7f"

test "html nospace escaper" {
  bad = Str.from_bytes([0x96])
  input = LOWER7 + "\u00A0\u0100\u2028\u2029\ufeff\ufdec𝄞" + "erroneous" + bad + "0"
  want = "&#xfffd;\x01\x02\x03\x04\x05\x06\x07\x08&#9;&#10;&#11;&#12;&#13;\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f&#32;!&#34;\#$%&amp;&#39;()*&#43;,-./0123456789:;&lt;&#61;&gt;?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_&#96;abcdefghijklmnopqrstuvwxyz{|}~\x7f\u00A0\u0100\u2028\u2029\ufeff&#xfdec;𝄞erroneous&#xfffd;0"
  got = html_nospace_escaper([sv(input)])
  assert_eq got, want
  repl = strings.replace_all(strings.replace_all(input, "\x00", "\ufffd"), bad, "\ufffd")
  assert_eq html.unescape_string(got), repl
}

test "css escaper" {
  input = LOWER7 + "\u00A0\u0100\u2028\u2029\ufeff𝄞"
  want = "\\0\x01\x02\x03\x04\x05\x06\x07\x08\\9 \\a\x0b\\c \\d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f !\\22\#$%\\26\\27\\28\\29*\\2b,-.\\2f 0123456789\\3a\\3b\\3c=\\3e?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_`abcdefghijklmnopqrstuvwxyz\\7b|\\7d~\x7f\u00A0\u0100\u2028\u2029\ufeff𝄞"
  got = css_escaper([sv(input)])
  assert_eq got, want
  assert_eq decode_css(got), input
}

test "hex decode" {
  i = 0
  while i < 0x200000 {
    s = strconv_format_hex(i)
    assert_eq hex_decode(s), i
    assert_eq hex_decode(strings.to_upper(s)), i
    i += 101
  }
}

def strconv_format_hex(i: Int) -> Str {
  d = "0123456789abcdef"
  return "0" if i == 0
  out = ""
  x = i
  while x > 0 {
    out = d[x % 16...x % 16 + 1] + out
    x = x / 16
  }
  out
}
