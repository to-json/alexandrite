def escaper_named(name: Str, s: Str) -> Str {
  a = [sv(s)]
  case name {
    "jsStrEscaper" => js_str_escaper(a)
    "jsRegexpEscaper" => js_regexp_escaper(a)
    "urlEscaper" => url_escaper(a)
    "urlNormalizer" => url_normalizer(a)
    _ => ""
  }
}

def check_escapers_on_lower_input(s: Str) {}

def check_urlfilters_input(s: Str) {}

def check_escapers_on_lower7_and_select_high_codepoints(name: Str, escaper: Str, escaped: Str) {
  input = lower7_input()
  assert_eq escaper_named(escaper, input), escaped
  # Escape it rune by rune to make sure that any fast-path checking does
  # not break escaping.
  out: [Str] = []
  for r in input.runes {
    out << escaper_named(escaper, Str.from_bytes(utf8_encode(r)))
  }
  assert_eq out.join(""), escaped
}

#[track_caller]
def check_urlfilters(name: Str, escaper: Str, escaped: Str) {
  assert_eq escaper_named(escaper, url_filters_input()), escaped
}

