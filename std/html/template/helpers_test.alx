def check_jsval_escaper(x: dyn.Value, js_: Str, skip_nest: Bool) {
  assert_eq js_val_escaper([x]), js_
  return nil if skip_nest
  # Make sure that escaping corner cases are not broken by nesting.
  a = dyn.Value.list([x])
  assert_eq js_val_escaper([a]), "[" + strings.trim_space(js_) + "]"
  nil
}

