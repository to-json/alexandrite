test "jsval_escaper 0" {
  check_jsval_escaper(dyn.Value.int(42), " 42 ", false)
  check_jsval_escaper(dyn.Value.uint_of(42, "uint"), " 42 ", false)
  check_jsval_escaper(dyn.Value.int_of(42, "int16"), " 42 ", false)
  check_jsval_escaper(dyn.Value.uint_of(42, "uint16"), " 42 ", false)
  check_jsval_escaper(dyn.Value.int_of(-42, "int32"), " -42 ", false)
  check_jsval_escaper(dyn.Value.uint_of(42, "uint32"), " 42 ", false)
  check_jsval_escaper(dyn.Value.int_of(-42, "int16"), " -42 ", false)
  check_jsval_escaper(dyn.Value.uint_of(42, "uint16"), " 42 ", false)
  check_jsval_escaper(dyn.Value.int_of(-42, "int64"), " -42 ", false)
  check_jsval_escaper(dyn.Value.uint_of(42, "uint64"), " 42 ", false)
  check_jsval_escaper(dyn.Value.uint_of(9007199254740992, "uint64"), " 9007199254740992 ", false)
  check_jsval_escaper(dyn.Value.uint_of(9007199254740993, "uint64"), " 9007199254740993 ", false)
  check_jsval_escaper(dyn.Value.float_of(1.0, "float32"), " 1 ", false)
  check_jsval_escaper(dyn.Value.float_of(-1.0, "float32"), " -1 ", false)
  check_jsval_escaper(dyn.Value.float_of(0.5, "float32"), " 0.5 ", false)
  check_jsval_escaper(dyn.Value.float_of(-0.5, "float32"), " -0.5 ", false)
  check_jsval_escaper(dyn.Value.float_of(0.00390625, "float32"), " 0.00390625 ", false)
  check_jsval_escaper(dyn.Value.float_of(0.0, "float32"), " 0 ", false)
  check_jsval_escaper(dyn.Value.float(math.copysign(0.0, -1.0)), " -0 ", false)
  check_jsval_escaper(dyn.Value.float(1.0), " 1 ", false)
  check_jsval_escaper(dyn.Value.float(-1.0), " -1 ", false)
  check_jsval_escaper(dyn.Value.float(0.5), " 0.5 ", false)
  check_jsval_escaper(dyn.Value.float(-0.5), " -0.5 ", false)
  check_jsval_escaper(dyn.Value.float(0.0), " 0 ", false)
  check_jsval_escaper(dyn.Value.float(math.copysign(0.0, -1.0)), " -0 ", false)
  check_jsval_escaper(dyn.Value.str(""), "\"\"", false)
  check_jsval_escaper(dyn.Value.str("foo"), "\"foo\"", false)
  check_jsval_escaper(dyn.Value.str("\r\n  "), "\"\\r\\n\\u2028\\u2029\"", false)
  check_jsval_escaper(dyn.Value.str("\t\x0b"), "\"\\t\\u000b\"", false)
  check_jsval_escaper(dyn.Value.struct_of("struct { X int; Y int }", ["X", "Y"], [dyn.Value.int(1), dyn.Value.int(2)]), "{\"X\":1,\"Y\":2}", false)
  check_jsval_escaper(dyn.Value.list_of([], "[]interface {}"), "[]", false)
  check_jsval_escaper(dyn.Value.list_of([dyn.Value.int(42), dyn.Value.str("foo"), dyn.Value.nil_of("interface {}")], "[]interface {}"), "[42,\"foo\",null]", false)
  check_jsval_escaper(dyn.Value.list_of([dyn.Value.str("<!--"), dyn.Value.str("</script>"), dyn.Value.str("-->")], "[]string"), "[\"\\u003c!--\",\"\\u003c/script\\u003e\",\"--\\u003e\"]", false)
  check_jsval_escaper(dyn.Value.str("<!--"), "\"\\u003c!--\"", false)
  check_jsval_escaper(dyn.Value.str("-->"), "\"--\\u003e\"", false)
  check_jsval_escaper(dyn.Value.str("<![CDATA["), "\"\\u003c![CDATA[\"", false)
  check_jsval_escaper(dyn.Value.str("]]>"), "\"]]\\u003e\"", false)
  check_jsval_escaper(dyn.Value.str("</script"), "\"\\u003c/script\"", false)
  check_jsval_escaper(dyn.Value.str("𝄞"), "\"𝄞\"", false)
  check_jsval_escaper(dyn.Value.invalid, " null ", false)
  check_jsval_escaper(json_err_type(), " /* json: error calling MarshalJSON for type *template.jsonErrType: a * / b \\x3Cscript c \\x3C/script d \\x3C!-- e \\x3Cscript f \\x3C/script */null ", true)
}

test "jsstr_escaper 0" {
  check_jsstr_escaper(dyn.Value.str(""), "")
  check_jsstr_escaper(dyn.Value.str("foo"), "foo")
  check_jsstr_escaper(dyn.Value.str("\x00"), "\\u0000")
  check_jsstr_escaper(dyn.Value.str("\t"), "\\t")
  check_jsstr_escaper(dyn.Value.str("\n"), "\\n")
  check_jsstr_escaper(dyn.Value.str("\r"), "\\r")
  check_jsstr_escaper(dyn.Value.str(" "), "\\u2028")
  check_jsstr_escaper(dyn.Value.str(" "), "\\u2029")
  check_jsstr_escaper(dyn.Value.str("\\"), "\\\\")
  check_jsstr_escaper(dyn.Value.str("\\n"), "\\\\n")
  check_jsstr_escaper(dyn.Value.str("foo\r\nbar"), "foo\\r\\nbar")
  check_jsstr_escaper(dyn.Value.str("\""), "\\u0022")
  check_jsstr_escaper(dyn.Value.str("'"), "\\u0027")
  check_jsstr_escaper(dyn.Value.str("&amp;"), "\\u0026amp;")
  check_jsstr_escaper(dyn.Value.str("</script>"), "\\u003c\\/script\\u003e")
  check_jsstr_escaper(dyn.Value.str("<![CDATA["), "\\u003c![CDATA[")
  check_jsstr_escaper(dyn.Value.str("]]>"), "]]\\u003e")
  check_jsstr_escaper(dyn.Value.str("<!--"), "\\u003c!--")
  check_jsstr_escaper(dyn.Value.str("-->"), "--\\u003e")
  check_jsstr_escaper(dyn.Value.str("+ADw-script+AD4-alert(1)+ADw-/script+AD4-"), "\\u002bADw-script\\u002bAD4-alert(1)\\u002bADw-\\/script\\u002bAD4-")
  check_jsstr_escaper(dyn.Value.str("foo�bar"), "foo�bar")
  check_jsstr_escaper(dyn.Value.str("foo���bar"), "foo���bar")
}

test "jsregexp_escaper 0" {
  check_jsregexp_escaper(dyn.Value.str(""), "(?:)")
  check_jsregexp_escaper(dyn.Value.str("foo"), "foo")
  check_jsregexp_escaper(dyn.Value.str("\x00"), "\\u0000")
  check_jsregexp_escaper(dyn.Value.str("\t"), "\\t")
  check_jsregexp_escaper(dyn.Value.str("\n"), "\\n")
  check_jsregexp_escaper(dyn.Value.str("\r"), "\\r")
  check_jsregexp_escaper(dyn.Value.str(" "), "\\u2028")
  check_jsregexp_escaper(dyn.Value.str(" "), "\\u2029")
  check_jsregexp_escaper(dyn.Value.str("\\"), "\\\\")
  check_jsregexp_escaper(dyn.Value.str("\\n"), "\\\\n")
  check_jsregexp_escaper(dyn.Value.str("foo\r\nbar"), "foo\\r\\nbar")
  check_jsregexp_escaper(dyn.Value.str("\""), "\\u0022")
  check_jsregexp_escaper(dyn.Value.str("'"), "\\u0027")
  check_jsregexp_escaper(dyn.Value.str("&amp;"), "\\u0026amp;")
  check_jsregexp_escaper(dyn.Value.str("</script>"), "\\u003c\\/script\\u003e")
  check_jsregexp_escaper(dyn.Value.str("<![CDATA["), "\\u003c!\\[CDATA\\[")
  check_jsregexp_escaper(dyn.Value.str("]]>"), "\\]\\]\\u003e")
  check_jsregexp_escaper(dyn.Value.str("<!--"), "\\u003c!\\-\\-")
  check_jsregexp_escaper(dyn.Value.str("-->"), "\\-\\-\\u003e")
  check_jsregexp_escaper(dyn.Value.str("*"), "\\*")
  check_jsregexp_escaper(dyn.Value.str("+"), "\\u002b")
  check_jsregexp_escaper(dyn.Value.str("?"), "\\?")
  check_jsregexp_escaper(dyn.Value.str("[](){}"), "\\[\\]\\(\\)\\{\\}")
  check_jsregexp_escaper(dyn.Value.str("$foo|x.y"), "\\$foo\\|x\\.y")
  check_jsregexp_escaper(dyn.Value.str("x^y"), "x\\^y")
}

