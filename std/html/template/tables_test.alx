test "srcset_filter 0" {
  check_srcset_filter("one ok", "http://example.com/img.png", "http://example.com/img.png")
  check_srcset_filter("one ok with metadata", " /img.png 200w", " /img.png 200w")
  check_srcset_filter("one bad", "javascript:alert(1) 200w", "\#ZgotmplZ")
  check_srcset_filter("two ok", "foo.png, bar.png", "foo.png, bar.png")
  check_srcset_filter("left bad", "javascript:alert(1), /foo.png", "\#ZgotmplZ, /foo.png")
  check_srcset_filter("right bad", "/bogus\#, javascript:alert(1)", "/bogus\#,\#ZgotmplZ")
}

