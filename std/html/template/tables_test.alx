test "is_js_mime_type 0" {
  check_is_js_mime_type("application/javascript;version=1.8", true)
  check_is_js_mime_type("application/javascript;version=1.8;foo=bar", true)
  check_is_js_mime_type("application/javascript/version=1.8", false)
  check_is_js_mime_type("text/javascript", true)
  check_is_js_mime_type("application/json", true)
  check_is_js_mime_type("application/ld+json", true)
  check_is_js_mime_type("module", true)
}

test "find_end_tag 0" {
  check_find_end_tag("", "tag", -1)
  check_find_end_tag("hello </textarea> hello", "textarea", 6)
  check_find_end_tag("hello </TEXTarea> hello", "textarea", 6)
  check_find_end_tag("hello </textAREA>", "textarea", 6)
  check_find_end_tag("hello </textarea", "textareax", -1)
  check_find_end_tag("hello </textarea>", "tag", -1)
  check_find_end_tag("hello tag </textarea", "tag", -1)
  check_find_end_tag("hello </tag> </other> </textarea> <other>", "textarea", 22)
  check_find_end_tag("</textarea> <other>", "textarea", 0)
  check_find_end_tag("<div> </div> </TEXTAREA>", "textarea", 13)
  check_find_end_tag("<div> </div> </TEXTAREA\t>", "textarea", 13)
  check_find_end_tag("<div> </div> </TEXTAREA >", "textarea", 13)
  check_find_end_tag("<div> </div> </TEXTAREAfoo", "textarea", -1)
  check_find_end_tag("</TEXTAREAfoo </textarea>", "textarea", 14)
  check_find_end_tag("<</script >", "script", 1)
  check_find_end_tag("</script>", "textarea", -1)
}

test "urlnormalizer 0" {
  check_urlnormalizer("", "")
  check_urlnormalizer("http://example.com:80/foo/bar?q=foo%20&bar=x+y\#frag", "http://example.com:80/foo/bar?q=foo%20&bar=x+y\#frag")
  check_urlnormalizer(" ", "%20")
  check_urlnormalizer("%7c", "%7c")
  check_urlnormalizer("%7C", "%7C")
  check_urlnormalizer("%2", "%252")
  check_urlnormalizer("%", "%25")
  check_urlnormalizer("%z", "%25z")
  check_urlnormalizer("/foo|bar/%5cሴ", "/foo%7cbar/%5c%e1%88%b4")
}

