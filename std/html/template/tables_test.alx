test "ensure_pipeline_contains 0" {
  check_ensure_pipeline_contains("{{.X}}", ".X", [])
  check_ensure_pipeline_contains("{{.X | html}}", ".X | html", [])
  check_ensure_pipeline_contains("{{.X}}", ".X | html", ["html"])
  check_ensure_pipeline_contains("{{html .X}}", "_eval_args_ .X | html | urlquery", ["html", "urlquery"])
  check_ensure_pipeline_contains("{{html .X .Y .Z}}", "_eval_args_ .X .Y .Z | html | urlquery", ["html", "urlquery"])
  check_ensure_pipeline_contains("{{.X | print}}", ".X | print | urlquery", ["urlquery"])
  check_ensure_pipeline_contains("{{.X | print | urlquery}}", ".X | print | urlquery", ["urlquery"])
  check_ensure_pipeline_contains("{{.X | urlquery}}", ".X | html | urlquery", ["html", "urlquery"])
  check_ensure_pipeline_contains("{{.X | print 2 | .f 3}}", ".X | print 2 | .f 3 | urlquery | html", ["urlquery", "html"])
  check_ensure_pipeline_contains("{{.X | println.x }}", ".X | println.x | urlquery | html", ["urlquery", "html"])
  check_ensure_pipeline_contains("{{.X | (print 12 | println).x }}", ".X | (print 12 | println).x | urlquery | html", ["urlquery", "html"])
  check_ensure_pipeline_contains("{{.X | urlquery}}", ".X | _html_template_urlfilter | urlquery", ["_html_template_urlfilter", "urlquery"])
  check_ensure_pipeline_contains("{{.X | urlquery}}", ".X | urlquery | _html_template_urlfilter | _html_template_cssescaper", ["_html_template_urlfilter", "_html_template_cssescaper"])
  check_ensure_pipeline_contains("{{.X | urlquery}}", ".X | urlquery", ["urlquery"])
  check_ensure_pipeline_contains("{{.X | urlquery}}", ".X | urlquery", ["urlquery"])
  check_ensure_pipeline_contains("{{.X | html}}", ".X | html", ["html"])
  check_ensure_pipeline_contains("{{.X | html}}", ".X | html", ["html"])
}

test "escape_malformed_pipelines 0" {
  check_escape_malformed_pipelines("{{ 0 | $ }}")
  check_escape_malformed_pipelines("{{ 0 | $ | urlquery }}")
  check_escape_malformed_pipelines("{{ 0 | (nil) }}")
  check_escape_malformed_pipelines("{{ 0 | (nil) | html }}")
}

test "cve202656858 0" {
  check_cve202656858("regexp after open brace in if block", "<script>if(true){/{{.}}/g.test(\"x\")}</script>", "a.b", "<script>if(true){/a\\.b/g.test(\"x\")}</script>")
  check_cve202656858("regexp after close brace", "<script>if(true){x=1}/{{.}}/g.test(\"x\")</script>", "a.b", "<script>if(true){x=1}/a\\.b/g.test(\"x\")</script>")
  check_cve202656858("regexp pathological attacker input", "<script>if(true){/{{.}}/g.test(\"x\")}</script>", "./;alert(1);var q=/.", "<script>if(true){/\\.\\/;alert\\(1\\);var q=\\/\\./g.test(\"x\")}</script>")
  check_cve202656858("regexp after open brace in template literal", "<script>`${ (function(){/{{.}}/g.test(x)}) }`</script>", "a.b", "<script>`${ (function(){/a\\.b/g.test(x)}) }`</script>")
  check_cve202656858("regexp after close brace in template literal", "<script>`${ (function(){}/{{.}}/g.test(x)) }`</script>", "a.b", "<script>`${ (function(){}/a\\.b/g.test(x)) }`</script>")
}

test "strip_tags 0" {
  check_strip_tags("", "")
  check_strip_tags("Hello, World!", "Hello, World!")
  check_strip_tags("foo&amp;bar", "foo&amp;bar")
  check_strip_tags("Hello <a href=\"www.example.com/\">World</a>!", "Hello World!")
  check_strip_tags("Foo <textarea>Bar</textarea> Baz", "Foo Bar Baz")
  check_strip_tags("Foo <!-- Bar --> Baz", "Foo  Baz")
  check_strip_tags("<", "<")
  check_strip_tags("foo < bar", "foo < bar")
  check_strip_tags("Foo<script type=\"text/javascript\">alert(1337)</script>Bar", "FooBar")
  check_strip_tags("Foo<div title=\"1>2\">Bar", "FooBar")
  check_strip_tags("I <3 Ponies!", "I <3 Ponies!")
  check_strip_tags("<script>foo()</script>", "")
}

