test "ends_with_csskeyword 0" {
  check_ends_with_csskeyword("", "url", false)
  check_ends_with_csskeyword("url", "url", true)
  check_ends_with_csskeyword("URL", "url", true)
  check_ends_with_csskeyword("Url", "url", true)
  check_ends_with_csskeyword("url", "important", false)
  check_ends_with_csskeyword("important", "important", true)
  check_ends_with_csskeyword("image-url", "url", false)
  check_ends_with_csskeyword("imageurl", "url", false)
  check_ends_with_csskeyword("image url", "url", true)
}

test "is_cssnmchar 0" {
  check_is_cssnmchar(0, false)
  check_is_cssnmchar(48, true)
  check_is_cssnmchar(57, true)
  check_is_cssnmchar(65, true)
  check_is_cssnmchar(90, true)
  check_is_cssnmchar(97, true)
  check_is_cssnmchar(122, true)
  check_is_cssnmchar(95, true)
  check_is_cssnmchar(45, true)
  check_is_cssnmchar(58, false)
  check_is_cssnmchar(59, false)
  check_is_cssnmchar(32, false)
  check_is_cssnmchar(127, false)
  check_is_cssnmchar(128, true)
  check_is_cssnmchar(4660, true)
  check_is_cssnmchar(55296, false)
  check_is_cssnmchar(56320, false)
  check_is_cssnmchar(65534, false)
  check_is_cssnmchar(65536, true)
  check_is_cssnmchar(1114112, false)
}

test "decode_css 0" {
  check_decode_css("", "")
  check_decode_css("foo", "foo")
  check_decode_css("foo\\", "foo")
  check_decode_css("foo\\\\", "foo\\")
  check_decode_css("\\", "")
  check_decode_css("\\A", "\n")
  check_decode_css("\\a", "\n")
  check_decode_css("\\0a", "\n")
  check_decode_css("\\00000a", "\n")
  check_decode_css("\\000000a", "\x00a")
  check_decode_css("\\1234 5", "ሴ5")
  check_decode_css("\\1234\\20 5", "ሴ 5")
  check_decode_css("\\1234\\A 5", "ሴ\n5")
  check_decode_css("\\1234\t5", "ሴ5")
  check_decode_css("\\1234\n5", "ሴ5")
  check_decode_css("\\1234\r\n5", "ሴ5")
  check_decode_css("\\12345", "𒍅")
  check_decode_css("\\\\", "\\")
  check_decode_css("\\\\ ", "\\ ")
  check_decode_css("\\\"", "\"")
  check_decode_css("\\'", "'")
  check_decode_css("\\.", ".")
  check_decode_css("\\. .", ". .")
  check_decode_css("The \\3c i\\3equick\\3c/i\\3e,\\d\\A\\3cspan style=\\27 color:brown\\27\\3e brown\\3c/span\\3e  fox jumps\\2028over the \\3c canine class=\\22lazy\\22 \\3e dog\\3c/canine\\3e", "The <i>quick</i>,\r\n<span style='color:brown'>brown</span> fox jumps over the <canine class=\"lazy\">dog</canine>")
}

test "skip_cssspace 0" {
  check_skip_cssspace("", "")
  check_skip_cssspace("foo", "foo")
  check_skip_cssspace("\n", "")
  check_skip_cssspace("\r\n", "")
  check_skip_cssspace("\r", "")
  check_skip_cssspace("\t", "")
  check_skip_cssspace(" ", "")
  check_skip_cssspace("\x0c", "")
  check_skip_cssspace(" foo", "foo")
  check_skip_cssspace("  foo", " foo")
  check_skip_cssspace("\\20", "\\20")
}

test "cssvalue_filter 0" {
  check_cssvalue_filter("", "")
  check_cssvalue_filter("foo", "foo")
  check_cssvalue_filter("0", "0")
  check_cssvalue_filter("0px", "0px")
  check_cssvalue_filter("-5px", "-5px")
  check_cssvalue_filter("1.25in", "1.25in")
  check_cssvalue_filter("+.33em", "+.33em")
  check_cssvalue_filter("100%", "100%")
  check_cssvalue_filter("12.5%", "12.5%")
  check_cssvalue_filter(".foo", ".foo")
  check_cssvalue_filter("\#bar", "\#bar")
  check_cssvalue_filter("corner-radius", "corner-radius")
  check_cssvalue_filter("-moz-corner-radius", "-moz-corner-radius")
  check_cssvalue_filter("\#000", "\#000")
  check_cssvalue_filter("\#48f", "\#48f")
  check_cssvalue_filter("\#123456", "\#123456")
  check_cssvalue_filter("U+00-FF, U+980-9FF", "U+00-FF, U+980-9FF")
  check_cssvalue_filter("color: red", "color: red")
  check_cssvalue_filter("<!--", "ZgotmplZ")
  check_cssvalue_filter("-->", "ZgotmplZ")
  check_cssvalue_filter("<![CDATA[", "ZgotmplZ")
  check_cssvalue_filter("]]>", "ZgotmplZ")
  check_cssvalue_filter("</style", "ZgotmplZ")
  check_cssvalue_filter("\"", "ZgotmplZ")
  check_cssvalue_filter("'", "ZgotmplZ")
  check_cssvalue_filter("`", "ZgotmplZ")
  check_cssvalue_filter("\x00", "ZgotmplZ")
  check_cssvalue_filter("/* foo */", "ZgotmplZ")
  check_cssvalue_filter("//", "ZgotmplZ")
  check_cssvalue_filter("[href=~", "ZgotmplZ")
  check_cssvalue_filter("expression(alert(1337))", "ZgotmplZ")
  check_cssvalue_filter("-expression(alert(1337))", "ZgotmplZ")
  check_cssvalue_filter("expression", "ZgotmplZ")
  check_cssvalue_filter("Expression", "ZgotmplZ")
  check_cssvalue_filter("EXPRESSION", "ZgotmplZ")
  check_cssvalue_filter("-moz-binding", "ZgotmplZ")
  check_cssvalue_filter("-expr\x00ession(alert(1337))", "ZgotmplZ")
  check_cssvalue_filter("-expr\\0ession(alert(1337))", "ZgotmplZ")
  check_cssvalue_filter("-express\\69on(alert(1337))", "ZgotmplZ")
  check_cssvalue_filter("-express\\69 on(alert(1337))", "ZgotmplZ")
  check_cssvalue_filter("-exp\\72 ession(alert(1337))", "ZgotmplZ")
  check_cssvalue_filter("-exp\\52 ession(alert(1337))", "ZgotmplZ")
  check_cssvalue_filter("-exp\\000052 ession(alert(1337))", "ZgotmplZ")
  check_cssvalue_filter("-expre\\0000073sion", "-expre\x073sion")
  check_cssvalue_filter("@import url evil.css", "ZgotmplZ")
  check_cssvalue_filter("<", "ZgotmplZ")
  check_cssvalue_filter(">", "ZgotmplZ")
}

test "escape 0" {
  check_escape("if", "{{if .T}}Hello{{end}}, {{.C}}!", "Hello, &lt;Cincinnati&gt;!")
  check_escape("else", "{{if .F}}{{.H}}{{else}}{{.G}}{{end}}!", "&lt;Goodbye&gt;!")
  check_escape("overescaping1", "Hello, {{.C | html}}!", "Hello, &lt;Cincinnati&gt;!")
  check_escape("overescaping2", "Hello, {{html .C}}!", "Hello, &lt;Cincinnati&gt;!")
  check_escape("overescaping3", "{{with .C}}{{$msg := .}}Hello, {{$msg}}!{{end}}", "Hello, &lt;Cincinnati&gt;!")
  check_escape("assignment", "{{if $x := .H}}{{$x}}{{end}}", "&lt;Hello&gt;")
  check_escape("withBody", "{{with .H}}{{.}}{{end}}", "&lt;Hello&gt;")
  check_escape("withElse", "{{with .E}}{{.}}{{else}}{{.H}}{{end}}", "&lt;Hello&gt;")
  check_escape("rangeBody", "{{range .A}}{{.}}{{end}}", "&lt;a&gt;&lt;b&gt;")
  check_escape("rangeElse", "{{range .E}}{{.}}{{else}}{{.H}}{{end}}", "&lt;Hello&gt;")
  check_escape("nonStringValue", "{{.T}}", "true")
  check_escape("untypedNilValue", "{{.U}}", "")
  check_escape("typedNilValue", "{{.Z}}", "&lt;nil&gt;")
  check_escape("constant", "<a href=\"/search?q={{\"'a<b'\"}}\">", "<a href=\"/search?q=%27a%3cb%27\">")
  check_escape("multipleAttrs", "<a b=1 c={{.H}}>", "<a b=1 c=&lt;Hello&gt;>")
  check_escape("urlStartRel", "<a href='{{\"/foo/bar?a=b&c=d\"}}'>", "<a href='/foo/bar?a=b&amp;c=d'>")
  check_escape("urlStartAbsOk", "<a href='{{\"http://example.com/foo/bar?a=b&c=d\"}}'>", "<a href='http://example.com/foo/bar?a=b&amp;c=d'>")
  check_escape("protocolRelativeURLStart", "<a href='{{\"//example.com:8000/foo/bar?a=b&c=d\"}}'>", "<a href='//example.com:8000/foo/bar?a=b&amp;c=d'>")
  check_escape("pathRelativeURLStart", "<a href=\"{{\"/javascript:80/foo/bar\"}}\">", "<a href=\"/javascript:80/foo/bar\">")
  check_escape("dangerousURLStart", "<a href='{{\"javascript:alert(%22pwned%22)\"}}'>", "<a href='\#ZgotmplZ'>")
  check_escape("dangerousURLStart2", "<a href='  {{\"javascript:alert(%22pwned%22)\"}}'>", "<a href='  \#ZgotmplZ'>")
  check_escape("nonHierURL", "<a href={{\"mailto:Muhammed \\\"The Greatest\\\" Ali <m.ali@example.com>\"}}>", "<a href=mailto:Muhammed%20%22The%20Greatest%22%20Ali%20%3cm.ali@example.com%3e>")
  check_escape("urlPath", "<a href='http://{{\"javascript:80\"}}/foo'>", "<a href='http://javascript:80/foo'>")
  check_escape("urlQuery", "<a href='/search?q={{.H}}'>", "<a href='/search?q=%3cHello%3e'>")
  check_escape("urlFragment", "<a href='/faq\#{{.H}}'>", "<a href='/faq\#%3cHello%3e'>")
  check_escape("urlBranch", "<a href=\"{{if .F}}/foo?a=b{{else}}/bar{{end}}\">", "<a href=\"/bar\">")
  check_escape("urlBranchConflictMoot", "<a href=\"{{if .T}}/foo?a={{else}}/bar\#{{end}}{{.C}}\">", "<a href=\"/foo?a=%3cCincinnati%3e\">")
  check_escape("jsStrValue", "<button onclick='alert({{.H}})'>", "<button onclick='alert(&\#34;\\u003cHello\\u003e&\#34;)'>")
  check_escape("jsNumericValue", "<button onclick='alert({{.N}})'>", "<button onclick='alert( 42 )'>")
  check_escape("jsBoolValue", "<button onclick='alert({{.T}})'>", "<button onclick='alert( true )'>")
  check_escape("jsNilValueTyped", "<button onclick='alert(typeof{{.Z}})'>", "<button onclick='alert(typeof null )'>")
  check_escape("jsNilValueUntyped", "<button onclick='alert(typeof{{.U}})'>", "<button onclick='alert(typeof null )'>")
  check_escape("jsObjValue", "<button onclick='alert({{.A}})'>", "<button onclick='alert([&\#34;\\u003ca\\u003e&\#34;,&\#34;\\u003cb\\u003e&\#34;])'>")
  check_escape("jsObjValueScript", "<script>alert({{.A}})</script>", "<script>alert([\"\\u003ca\\u003e\",\"\\u003cb\\u003e\"])</script>")
  check_escape("scriptTypeSpace", "<script type=\" \">{{.H}}</script>", "<script type=\" \">\"\\u003cHello\\u003e\"</script>")
  check_escape("scriptTypeTab", "<script type=\"\t\">{{.H}}</script>", "<script type=\"\t\">\"\\u003cHello\\u003e\"</script>")
  check_escape("scriptTypeEmpty", "<script type=\"\">{{.H}}</script>", "<script type=\"\">\"\\u003cHello\\u003e\"</script>")
  check_escape("jsObjValueNotOverEscaped", "<button onclick='alert({{.A | html}})'>", "<button onclick='alert([&\#34;\\u003ca\\u003e&\#34;,&\#34;\\u003cb\\u003e&\#34;])'>")
  check_escape("jsStr", "<button onclick='alert(&quot;{{.H}}&quot;)'>", "<button onclick='alert(&quot;\\u003cHello\\u003e&quot;)'>")
  check_escape("badMarshaler", "<button onclick='alert(1/{{.B}}in numbers)'>", "<button onclick='alert(1/ /* json: error calling MarshalJSON for type *template.badMarshaler: invalid character &\#39;f&\#39; looking for beginning of object key string */null in numbers)'>")
  check_escape("jsMarshaler", "<button onclick='alert({{.M}})'>", "<button onclick='alert({&\#34;\\u003cfoo\\u003e&\#34;:&\#34;O&\#39;Reilly&\#34;})'>")
  check_escape("jsStrNotUnderEscaped", "<button onclick='alert({{.C | urlquery}})'>", "<button onclick='alert(&\#34;%3CCincinnati%3E&\#34;)'>")
  check_escape("jsRe", "<button onclick='alert(/{{\"foo+bar\"}}/.test(\"\"))'>", "<button onclick='alert(/foo\\u002bbar/.test(\"\"))'>")
  check_escape("jsReBlank", "<script>alert(/{{\"\"}}/.test(\"\"));</script>", "<script>alert(/(?:)/.test(\"\"));</script>")
  check_escape("jsReAmbigOk", "<script>{{if true}}var x = 1{{end}}</script>", "<script>var x = 1</script>")
  check_escape("styleBidiKeywordPassed", "<p style=\"dir: {{\"ltr\"}}\">", "<p style=\"dir: ltr\">")
  check_escape("styleBidiPropNamePassed", "<p style=\"border-{{\"left\"}}: 0; border-{{\"right\"}}: 1in\">", "<p style=\"border-left: 0; border-right: 1in\">")
  check_escape("styleExpressionBlocked", "<p style=\"width: {{\"expression(alert(1337))\"}}\">", "<p style=\"width: ZgotmplZ\">")
  check_escape("styleTagSelectorPassed", "<style>{{\"p\"}} { color: pink }</style>", "<style>p { color: pink }</style>")
  check_escape("styleIDPassed", "<style>p{{\"\#my-ID\"}} { font: Arial }</style>", "<style>p\#my-ID { font: Arial }</style>")
  check_escape("styleClassPassed", "<style>p{{\".my_class\"}} { font: Arial }</style>", "<style>p.my_class { font: Arial }</style>")
  check_escape("styleQuantityPassed", "<a style=\"left: {{\"2em\"}}; top: {{0}}\">", "<a style=\"left: 2em; top: 0\">")
  check_escape("stylePctPassed", "<table style=width:{{\"100%\"}}>", "<table style=width:100%>")
  check_escape("styleColorPassed", "<p style=\"color: {{\"\#8ff\"}}; background: {{\"\#000\"}}\">", "<p style=\"color: \#8ff; background: \#000\">")
  check_escape("styleObfuscatedExpressionBlocked", "<p style=\"width: {{\"  e\\\\78preS\\x00Sio/**/n(alert(1337))\"}}\">", "<p style=\"width: ZgotmplZ\">")
  check_escape("styleMozBindingBlocked", "<p style=\"{{\"-moz-binding(alert(1337))\"}}: ...\">", "<p style=\"ZgotmplZ: ...\">")
  check_escape("styleObfuscatedMozBindingBlocked", "<p style=\"{{\"  -mo\\\\7a-B\\x00I/**/nding(alert(1337))\"}}: ...\">", "<p style=\"ZgotmplZ: ...\">")
  check_escape("styleFontNameString", "<p style='font-family: \"{{\"Times New Roman\"}}\"'>", "<p style='font-family: \"Times New Roman\"'>")
  check_escape("styleFontNameString", "<p style='font-family: \"{{\"Times New Roman\"}}\", \"{{\"sans-serif\"}}\"'>", "<p style='font-family: \"Times New Roman\", \"sans-serif\"'>")
  check_escape("styleFontNameUnquoted", "<p style='font-family: {{\"Times New Roman\"}}'>", "<p style='font-family: Times New Roman'>")
}

test "escape 1" {
  check_escape("styleURLQueryEncoded", "<p style=\"background: url(/img?name={{\"O'Reilly Animal(1)<2>.png\"}})\">", "<p style=\"background: url(/img?name=O%27Reilly%20Animal%281%29%3c2%3e.png)\">")
  check_escape("styleQuotedURLQueryEncoded", "<p style=\"background: url('/img?name={{\"O'Reilly Animal(1)<2>.png\"}}')\">", "<p style=\"background: url('/img?name=O%27Reilly%20Animal%281%29%3c2%3e.png')\">")
  check_escape("styleStrQueryEncoded", "<p style=\"background: '/img?name={{\"O'Reilly Animal(1)<2>.png\"}}'\">", "<p style=\"background: '/img?name=O%27Reilly%20Animal%281%29%3c2%3e.png'\">")
  check_escape("styleURLBadProtocolBlocked", "<a style=\"background: url('{{\"javascript:alert(1337)\"}}')\">", "<a style=\"background: url('\#ZgotmplZ')\">")
  check_escape("styleStrBadProtocolBlocked", "<a style=\"background: '{{\"vbscript:alert(1337)\"}}'\">", "<a style=\"background: '\#ZgotmplZ'\">")
  check_escape("styleStrEncodedProtocolEncoded", "<a style=\"background: '{{\"javascript\\\\3a alert(1337)\"}}'\">", "<a style=\"background: 'javascript\\\\3a alert\\28 1337\\29 '\">")
  check_escape("styleURLGoodProtocolPassed", "<a style=\"background: url('{{\"http://oreilly.com/O'Reilly Animals(1)<2>;{}.html\"}}')\">", "<a style=\"background: url('http://oreilly.com/O%27Reilly%20Animals%281%29%3c2%3e;%7b%7d.html')\">")
  check_escape("styleStrGoodProtocolPassed", "<a style=\"background: '{{\"http://oreilly.com/O'Reilly Animals(1)<2>;{}.html\"}}'\">", "<a style=\"background: 'http\\3a\\2f\\2foreilly.com\\2fO\\27Reilly Animals\\28 1\\29\\3c 2\\3e\\3b\\7b\\7d.html'\">")
  check_escape("styleURLEncodedForHTMLInAttr", "<a style=\"background: url('{{\"/search?img=foo&size=icon\"}}')\">", "<a style=\"background: url('/search?img=foo&amp;size=icon')\">")
  check_escape("styleURLNotEncodedForHTMLInCdata", "<style>body { background: url('{{\"/search?img=foo&size=icon\"}}') }</style>", "<style>body { background: url('/search?img=foo&size=icon') }</style>")
  check_escape("styleURLMixedCase", "<p style=\"background: URL(\#{{.H}})\">", "<p style=\"background: URL(\#%3cHello%3e)\">")
  check_escape("stylePropertyPairPassed", "<a style='{{\"color: red\"}}'>", "<a style='color: red'>")
  check_escape("styleStrSpecialsEncoded", "<a style=\"font-family: '{{\"/**/'\\\";:// \\\\\"}}', &quot;{{\"/**/'\\\";:// \\\\\"}}&quot;\">", "<a style=\"font-family: '\\2f**\\2f\\27\\22\\3b\\3a\\2f\\2f  \\\\', &quot;\\2f**\\2f\\27\\22\\3b\\3a\\2f\\2f  \\\\&quot;\">")
  check_escape("styleURLSpecialsEncoded", "<a style=\"border-image: url({{\"/**/'\\\";:// \\\\\"}}), url(&quot;{{\"/**/'\\\";:// \\\\\"}}&quot;), url('{{\"/**/'\\\";:// \\\\\"}}'), 'http://www.example.com/?q={{\"/**/'\\\";:// \\\\\"}}''\">", "<a style=\"border-image: url(/**/%27%22;://%20%5c), url(&quot;/**/%27%22;://%20%5c&quot;), url('/**/%27%22;://%20%5c'), 'http://www.example.com/?q=%2f%2a%2a%2f%27%22%3b%3a%2f%2f%20%5c''\">")
  check_escape("HTML comment", "<b>Hello, <!-- name of world -->{{.C}}</b>", "<b>Hello, &lt;Cincinnati&gt;</b>")
  check_escape("HTML comment not first < in text node.", "<<!-- -->!--", "&lt;!--")
  check_escape("HTML normalization 1", "a < b", "a &lt; b")
  check_escape("HTML normalization 2", "a << b", "a &lt;&lt; b")
  check_escape("HTML normalization 3", "a<<!-- --><!-- -->b", "a&lt;b")
  check_escape("HTML doctype not normalized", "<!DOCTYPE html>Hello, World!", "<!DOCTYPE html>Hello, World!")
  check_escape("HTML doctype not case-insensitive", "<!doCtYPE htMl>Hello, World!", "<!doCtYPE htMl>Hello, World!")
  check_escape("No doctype injection", "<!{{\"DOCTYPE\"}}", "&lt;!DOCTYPE")
  check_escape("Split HTML comment", "<b>Hello, <!-- name of {{if .T}}city -->{{.C}}{{else}}world -->{{.W}}{{end}}</b>", "<b>Hello, &lt;Cincinnati&gt;</b>")
  check_escape("JS line comment", "<script>for (;;) { if (c()) break// foo not a label\nfoo({{.T}});}</script>", "<script>for (;;) { if (c()) break\nfoo( true );}</script>")
  check_escape("JS multiline block comment", "<script>for (;;) { if (c()) break/* foo not a label\n */foo({{.T}});}</script>", "<script>for (;;) { if (c()) break\nfoo( true );}</script>")
  check_escape("JS single-line block comment", "<script>for (;;) {\nif (c()) break/* foo a label */foo;x({{.T}});}</script>", "<script>for (;;) {\nif (c()) break foo;x( true );}</script>")
  check_escape("JS block comment flush with mathematical division", "<script>var a/*b*//c\nd</script>", "<script>var a /c\nd</script>")
  check_escape("JS mixed comments", "<script>var a/*b*///c\nd</script>", "<script>var a \nd</script>")
  check_escape("JS HTML-like comments", "<script>before <!-- beep\nbetween\nbefore-->boop\n</script>", "<script>before \nbetween\nbefore\n</script>")
  check_escape("JS hashbang comment", "<script>\#! beep\n</script>", "<script>\n</script>")
  check_escape("Special tags in <script> string literals", "<script>var a = \"asd < 123 <!-- 456 < fgh <script jkl < 789 </script\"</script>", "<script>var a = \"asd < 123 \\x3C!-- 456 < fgh \\x3Cscript jkl < 789 \\x3C/script\"</script>")
  check_escape("Special tags in <script> string literals (mixed case)", "<script>var a = \"<!-- <ScripT </ScripT\"</script>", "<script>var a = \"\\x3C!-- \\x3CScripT \\x3C/ScripT\"</script>")
  check_escape("Special tags in <script> regex literals (mixed case)", "<script>var a = /<!-- <ScripT </ScripT/</script>", "<script>var a = /\\x3C!-- \\x3CScripT \\x3C/ScripT/</script>")
  check_escape("CSS comments", "<style>p// paragraph\n{border: 1px/* color */{{\"\#00f\"}}}</style>", "<style>p\n{border: 1px \#00f}</style>")
  check_escape("JS attr block comment", "<a onclick=\"f(&quot;&quot;); /* alert({{.H}}) */\">", "<a onclick=\"f(&quot;&quot;); /* alert() */\">")
  check_escape("JS attr line comment", "<a onclick=\"// alert({{.G}})\">", "<a onclick=\"// alert()\">")
  check_escape("CSS attr block comment", "<a style=\"/* color: {{.H}} */\">", "<a style=\"/* color:  */\">")
  check_escape("CSS attr line comment", "<a style=\"// color: {{.G}}\">", "<a style=\"// color: \">")
  check_escape("HTML substitution commented out", "<p><!-- {{.H}} --></p>", "<p></p>")
  check_escape("Comment ends flush with start", "<!--{{.}}--><script>/*{{.}}*///{{.}}\n</script><style>/*{{.}}*///{{.}}\n</style><a onclick='/*{{.}}*///{{.}}' style='/*{{.}}*///{{.}}'>", "<script> \n</script><style> \n</style><a onclick='/**///' style='/**///'>")
  check_escape("typed HTML in text", "{{.W}}", "&iexcl;<b class=\"foo\">Hello</b>, <textarea>O'World</textarea>!")
  check_escape("typed HTML in attribute", "<div title=\"{{.W}}\">", "<div title=\"&iexcl;Hello, O&\#39;World!\">")
  check_escape("typed HTML in script", "<button onclick=\"alert({{.W}})\">", "<button onclick=\"alert(&\#34;\\u0026iexcl;\\u003cb class=\\&\#34;foo\\&\#34;\\u003eHello\\u003c/b\\u003e, \\u003ctextarea\\u003eO&\#39;World\\u003c/textarea\\u003e!&\#34;)\">")
  check_escape("typed HTML in RCDATA", "<textarea>{{.W}}</textarea>", "<textarea>&iexcl;&lt;b class=&\#34;foo&\#34;&gt;Hello&lt;/b&gt;, &lt;textarea&gt;O&\#39;World&lt;/textarea&gt;!</textarea>")
  check_escape("range in textarea", "<textarea>{{range .A}}{{.}}{{end}}</textarea>", "<textarea>&lt;a&gt;&lt;b&gt;</textarea>")
  check_escape("No tag injection", "{{\"10$\"}}<{{\"script src,evil.org/pwnd.js\"}}...", "10$&lt;script src,evil.org/pwnd.js...")
  check_escape("No comment injection", "<{{\"!--\"}}", "&lt;!--")
  check_escape("No RCDATA end tag injection", "<textarea><{{\"/textarea \"}}...</textarea>", "<textarea>&lt;/textarea ...</textarea>")
  check_escape("optional attrs", "<img class=\"{{\"iconClass\"}}\"{{if .T}} id=\"{{\"<iconId>\"}}\"{{end}} src={{if .T}}\"?{{\"<iconPath>\"}}\"{{else}}\"images/cleardot.gif\"{{end}}{{if .T}}title=\"{{\"<title>\"}}\"{{end}} alt=\"{{if .T}}{{\"<alt>\"}}{{else}}{{if .F}}{{\"<title>\"}}{{end}}{{end}}\">", "<img class=\"iconClass\" id=\"&lt;iconId&gt;\" src=\"?%3ciconPath%3e\"title=\"&lt;title&gt;\" alt=\"&lt;alt&gt;\">")
  check_escape("conditional valueless attr name", "<input{{if .T}} checked{{end}} name=n>", "<input checked name=n>")
  check_escape("conditional dynamic valueless attr name 1", "<input{{if .T}} {{\"checked\"}}{{end}} name=n>", "<input checked name=n>")
  check_escape("conditional dynamic valueless attr name 2", "<input {{if .T}}{{\"checked\"}} {{end}}name=n>", "<input checked name=n>")
  check_escape("dynamic attribute name", "<img on{{\"load\"}}=\"alert({{\"loaded\"}})\">", "<img onload=\"alert(&\#34;loaded&\#34;)\">")
  check_escape("bad dynamic attribute name 1", "<input {{\"onchange\"}}=\"{{\"doEvil()\"}}\">", "<input ZgotmplZ=\"doEvil()\">")
  check_escape("bad dynamic attribute name 2", "<div {{\"sTyle\"}}=\"{{\"color: expression(alert(1337))\"}}\">", "<div ZgotmplZ=\"color: expression(alert(1337))\">")
  check_escape("bad dynamic attribute name 3", "<img {{\"src\"}}=\"{{\"javascript:doEvil()\"}}\">", "<img ZgotmplZ=\"javascript:doEvil()\">")
  check_escape("bad dynamic attribute name 4", "<input checked {{\"\"}}=\"Whose value am I?\">", "<input checked ZgotmplZ=\"Whose value am I?\">")
  check_escape("dynamic element name", "<h{{3}}><table><t{{\"head\"}}>...</h{{3}}>", "<h3><table><thead>...</h3>")
  check_escape("bad dynamic element name", "<{{\"script\"}}>{{\"doEvil()\"}}</{{\"script\"}}>", "&lt;script>doEvil()&lt;/script>")
  check_escape("srcset bad URL in second position", "<img srcset=\"{{\"/not-an-image\#,javascript:alert(1)\"}}\">", "<img srcset=\"/not-an-image\#,\#ZgotmplZ\">")
}

test "escape 2" {
  check_escape("srcset buffer growth", "<img srcset={{\",,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,\"}}>", "<img srcset=,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,>")
  check_escape("unquoted empty attribute value (plaintext)", "<p name={{.U}}>", "<p name=ZgotmplZ>")
  check_escape("unquoted empty attribute value (url)", "<p href={{.U}}>", "<p href=ZgotmplZ>")
  check_escape("quoted empty attribute value", "<p name=\"{{.U}}\">", "<p name=\"\">")
  check_escape("JS template lit special characters", "<script>var a = `{{.I}}`</script>", "<script>var a = `\\u0024\\u007b asd \\u0060\\u0060 \\u007d`</script>")
  check_escape("JS template lit special characters, nested lit", "<script>var a = `${ `{{.I}}` }`</script>", "<script>var a = `${ `\\u0024\\u007b asd \\u0060\\u0060 \\u007d` }`</script>")
  check_escape("JS template lit, nested JS", "<script>var a = `${ var a = \"{{\"a \\\" d\"}}\" }`</script>", "<script>var a = `${ var a = \"a \\u0022 d\" }`</script>")
  check_escape("meta content attribute url", "<meta http-equiv=\"refresh\" content=\"asd; url={{\"javascript:alert(1)\"}}; asd; url={{\"vbscript:alert(1)\"}}; asd\">", "<meta http-equiv=\"refresh\" content=\"asd; url=\#ZgotmplZ; asd; url=\#ZgotmplZ; asd\">")
  check_escape("meta content string", "<meta http-equiv=\"refresh\" content=\"{{\"asd: 123\"}}\">", "<meta http-equiv=\"refresh\" content=\"asd: 123\">")
  check_escape("meta content url with whitespace before equals", "<meta http-equiv=\"refresh\" content=\"0;url ={{\"javascript:alert(1)\"}}\">", "<meta http-equiv=\"refresh\" content=\"0;url =\#ZgotmplZ\">")
  check_escape("meta content url with tab before equals", "<meta http-equiv=\"refresh\" content=\"0;url\t={{\"javascript:alert(1)\"}}\">", "<meta http-equiv=\"refresh\" content=\"0;url\t=\#ZgotmplZ\">")
  check_escape("meta content url with space after equals", "<meta http-equiv=\"refresh\" content=\"0;url= {{\"javascript:alert(1)\"}}\">", "<meta http-equiv=\"refresh\" content=\"0;url= \#ZgotmplZ\">")
  check_escape("meta content url with whitespace both sides of equals", "<meta http-equiv=\"refresh\" content=\"0;url \t= {{\"javascript:alert(1)\"}}\">", "<meta http-equiv=\"refresh\" content=\"0;url \t= \#ZgotmplZ\">")
}

test "escape_set 0" {
  check_escape_set({"main" => ""}, "")
  check_escape_set({"helper" => "{{\"<World>\"}}", "main" => "Hello, {{template \"helper\"}}!"}, "Hello, &lt;World&gt;!")
  check_escape_set({"helper" => "{{\"<a>\"}}<b", "main" => "<a onclick='a = {{template \"helper\"}};'>"}, "<a onclick='a = &\#34;\\u003ca\\u003e&\#34;<b;'>")
  check_escape_set({"main" => "{{range .Children}}{{template \"main\" .}}{{else}}{{.X}} {{end}}"}, "foo &lt;bar&gt; baz ")
  check_escape_set({"helper" => "{{if .Children}}<ul>{{range .Children}}<li>{{template \"main\" .}}</li>{{end}}</ul>{{else}}{{.X}}{{end}}", "main" => "{{template \"helper\" .}}"}, "<ul><li>foo</li><li>&lt;bar&gt;</li><li><ul><li>baz</li></ul></li></ul>")
  check_escape_set({"helper" => "{{if .Children}}{{template \"main\" .}}{{else}}{{.X}}<br>{{end}}", "main" => "<blockquote>{{range .Children}}{{template \"helper\" .}}{{end}}</blockquote>"}, "<blockquote>foo<br>&lt;bar&gt;<br><blockquote>baz<br></blockquote></blockquote>")
  check_escape_set({"helper" => "{{11}} of {{\"<100>\"}}", "main" => "<button onclick=\"title='{{template \"helper\"}}'; ...\">{{template \"helper\"}}</button>"}, "<button onclick=\"title='11 of \\u003c100\\u003e'; ...\">11 of &lt;100&gt;</button>")
  check_escape_set({"helper" => "{{126}}", "main" => "<script>var x={{template \"helper\"}}/{{\"42\"}};</script>"}, "<script>var x= 126 /\"42\";</script>")
  check_escape_set({"countdown" => "{{.}}{{if .}},{{template \"countdown\" . | pred}}{{end}}", "main" => "<script>var x=[{{template \"countdown\" 4}}];</script>"}, "<script>var x=[ 4 , 3 , 2 , 1 , 0 ];</script>")
}

test "errors 0" {
  check_errors("{{if .Cond}}<a>{{else}}<b>{{end}}", "")
  check_errors("{{if .Cond}}<a>{{end}}", "")
  check_errors("{{if .Cond}}{{else}}<b>{{end}}", "")
  check_errors("{{with .Cond}}<div>{{end}}", "")
  check_errors("{{range .Items}}<a>{{end}}", "")
  check_errors("<a href='/foo?{{range .Items}}&{{.K}}={{.V}}{{end}}'>", "")
  check_errors("{{range .Items}}<a{{if .X}}{{end}}>{{end}}", "")
  check_errors("{{range .Items}}<a{{if .X}}{{end}}>{{continue}}{{end}}", "")
  check_errors("{{range .Items}}<a{{if .X}}{{end}}>{{break}}{{end}}", "")
  check_errors("{{range .Items}}<a{{if .X}}{{end}}>{{if .X}}{{break}}{{end}}{{end}}", "")
  check_errors("<script>var a = `${a+b}`</script>`", "")
  check_errors("<script>var tmpl = `asd`;</script>", "")
  check_errors("<script>var tmpl = `${1}`;</script>", "")
  check_errors("<script>var tmpl = `${return ``}`;</script>", "")
  check_errors("<script>var tmpl = `${return {{.}} }`;</script>", "")
  check_errors("<script>var tmpl = `${ let a = {1:1} {{.}} }`;</script>", "")
  check_errors("<script>var tmpl = `asd ${return \"{\"}`;</script>", "")
  check_errors("{{if eq \"\" \"\"}}<meta>{{end}}", "")
  check_errors("{{if eq \"\" \"\"}}<meta content=\"url={{\"asd\"}}\">{{end}}", "")
  check_errors("{{if .Cond}}<a{{end}}", "z:1:5: {{if}} branches")
  check_errors("{{if .Cond}}\n{{else}}\n<a{{end}}", "z:1:5: {{if}} branches")
  check_errors("{{if .Cond}}<a href=\"foo\">{{else}}<a href=\"bar>{{end}}", "z:1:5: {{if}} branches")
  check_errors("<a {{if .Cond}}href='{{else}}title='{{end}}{{.X}}'>", "z:1:8: {{if}} branches")
  check_errors("\n{{with .X}}<a{{end}}", "z:2:7: {{with}} branches")
  check_errors("\n{{with .X}}<a>{{else}}<a{{end}}", "z:2:7: {{with}} branches")
  check_errors("{{range .Items}}<a{{end}}", "z:1: on range loop re-entry: \"<\" in attribute name: \"<a\"")
  check_errors("\n{{range .Items}} x='<a{{end}}", "z:2:8: on range loop re-entry: {{range}} branches")
  check_errors("{{range .Items}}<a{{if .X}}{{break}}{{end}}>{{end}}", "z:1:29: at range loop break: {{range}} branches end in different contexts")
  check_errors("{{range .Items}}<a{{if .X}}{{continue}}{{end}}>{{end}}", "z:1:29: at range loop continue: {{range}} branches end in different contexts")
  check_errors("{{range .Items}}{{if .X}}{{break}}{{end}}<a{{if .Y}}{{continue}}{{end}}>{{if .Z}}{{continue}}{{end}}{{end}}", "z:1:54: at range loop continue: {{range}} branches end in different contexts")
  check_errors("<a b=1 c={{.H}}", "z: ends in a non-text context: {stateAttr delimSpaceOrTagEnd")
  check_errors("<script>foo();", "z: ends in a non-text context: {stateJS")
  check_errors("<a href=\"{{if .F}}/foo?a={{else}}/bar/{{end}}{{.H}}\">", "z:1:47: {{.H}} appears in an ambiguous context within a URL")
  check_errors("<a onclick=\"alert('Hello \\", "unfinished escape sequence in JS string: \"Hello \\\\\"")
  check_errors("<a onclick='alert(\"Hello\\, World\\", "unfinished escape sequence in JS string: \"Hello\\\\, World\\\\\"")
  check_errors("<a onclick='alert(/x+\\", "unfinished escape sequence in JS string: \"x+\\\\\"")
  check_errors("<a onclick=\"/foo[\\]/", "unfinished JS regexp charset: \"foo[\\\\]/\"")
  check_errors("<script>{{if false}}var x = 1{{end}}/-{{\"1.5\"}}/i.test(x)</script>", "'/' could start a division or regexp: \"/-\"")
  check_errors("{{template \"foo\"}}", "z:1:11: no such template \"foo\"")
  check_errors("<div{{template \"y\"}}>{{define \"y\"}} foo<b{{end}}", "\"<\" in attribute name: \" foo<b\"")
  check_errors("<script>reverseList = [{{template \"t\"}}]</script>{{define \"t\"}}{{if .Tail}}{{template \"t\" .Tail}}{{end}}{{.Head}}\",{{end}}", ": cannot compute output context for template t$htmltemplate_stateJS_elementScript")
  check_errors("<input type=button value=onclick=>", "html/template:z: \"=\" in unquoted attr: \"onclick=\"")
  check_errors("<input type=button value= onclick=>", "html/template:z: \"=\" in unquoted attr: \"onclick=\"")
  check_errors("<input type=button value= 1+1=2>", "html/template:z: \"=\" in unquoted attr: \"1+1=2\"")
  check_errors("<a class=`foo>", "html/template:z: \"`\" in unquoted attr: \"`foo\"")
  check_errors("<a style=font:'Arial'>", "html/template:z: \"'\" in unquoted attr: \"font:'Arial'\"")
  check_errors("<a=foo>", ": expected space, attr name, or end of tag, but got \"=foo>\"")
  check_errors("Hello, {{. | urlquery | print}}!", "predefined escaper \"urlquery\" disallowed in template")
  check_errors("Hello, {{. | html | print}}!", "predefined escaper \"html\" disallowed in template")
  check_errors("Hello, {{html . | print}}!", "predefined escaper \"html\" disallowed in template")
  check_errors("<div class={{. | html}}>Hello<div>", "predefined escaper \"html\" disallowed in template")
  check_errors("Hello, {{. | urlquery | html}}!", "predefined escaper \"urlquery\" disallowed in template")
  check_errors("<script>var a = `{{if .X}}`{{end}}", "{{if}} branches end in different contexts")
  check_errors("<script>var a = `{{if .X}}a{{else}}`{{end}}", "{{if}} branches end in different contexts")
  check_errors("<script>var a = `{{if .X}}a{{else}}b{{end}}`</script>", "")
}

