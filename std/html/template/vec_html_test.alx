  vec(dt, "<a href=\"http://h/{{urlquery .e}}\">x</a>", "<a href=\"http://h/\">x</a>")
  vec(dj, "{{range $k, $v := .}}<li data-k=\"{{$k}}\">{{.name}}</li>{{end}}", "<li data-k=\"age\">|ERR|template: v:1:43: executing \"v\" at <.name>: can't evaluate field name in type interface {}")
  vec(dt, "<a href=\"{{.h}}\">x</a><input value=\"{{.uq}}\" {{len .f}}>", "<a href=\"%3cb%3ebold%3c/b%3e\">x</a><input value=\"a=1&amp;b=2\" |ERR|template: v:1:47: executing \"v\" at <len .f>: error calling len: len of type float64")
  vec(dj, "{{range $k, $v := .}}<li data-k=\"{{$k}}\">{{(index .tags 1)}}</li>{{end}}<script>var r = /{{range (index .tags 1)}}{{.}},{{end}}/;</script>", "<li data-k=\"age\">|ERR|template: v:1:50: executing \"v\" at <.tags>: can't evaluate field tags in type interface {}")
