  vec(dj, "<style>a { font-family: \"{{$v := .flag}}{{$v}}\" }</style>{{if .}}<a href=\"{{range .obj.x}}{{.}},{{end}}\">{{else}}<a title=\"{{printf \"%v-%v\" .pi nil}}\">{{end}}x</a>", "<style>a { font-family: \"true\" }</style><a href=\"|ERR|template: v:1:86: executing \"v\" at <.obj.x>: range can't iterate over 1")
  vec(dt, "{{with .}}<p onclick=\"h({{.}})\">{{end}}", "<p onclick=\"h({&\#34;bad&\#34;:&\#34;javascript:alert(1)&\#34;,&\#34;c&\#34;:&\#34;color: red&\#34;,&\#34;e&\#34;:&\#34;&\#34;,&\#34;f&\#34;:2.5,&\#34;h&\#34;:&\#34;\\u003cb\\u003ebold\\u003c/b\\u003e&\#34;,&\#34;ha&\#34;:&\#34; dir=\\&\#34;ltr\\&\#34;&\#34;,&\#34;i&\#34;:42,&\#34;inf&\#34;:[0,0.25],&\#34;j&\#34;:&\#34;a &\#43; b&\#34;,&\#34;jss&\#34;:&\#34;it&\#39;s&\#34;,&\#34;msi&\#34;:{&\#34;one&\#34;:1,&\#34;two&\#34;:2},&\#34;neg&\#34;:-17,&\#34;np&\#34;:null,&\#34;num&\#34;:1.5e&\#43;300,&\#34;q&\#34;:&\#34;&\#39;\\&\#34;`&\#34;,&\#34;s&\#34;:&\#34;go \\u0026 \\u003calx\\u003e&\#34;,&\#34;si&\#34;:[5,10,15],&\#34;ss&\#34;:[&\#34;x y&\#34;,&\#34;\\u003cz\\u003e&\#34;],&\#34;ss2&\#34;:&\#34;/img.png 2x&\#34;,&\#34;st&\#34;:{&\#34;A&\#34;:1,&\#34;B&\#34;:&\#34;b\\u003ce\\u003ee&\#34;,&\#34;C&\#34;:[4]},&\#34;t&\#34;:true,&\#34;u&\#34;:&\#34;javascript:x()&\#34;,&\#34;uq&\#34;:&\#34;a=1\\u0026b=2&\#34;,&\#34;url&\#34;:&\#34;http://x.org/p?q=a b\\u0026r=\\u003c&\#34;})\">")
