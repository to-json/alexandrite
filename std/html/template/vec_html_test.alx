  vec(dj, "<img srcset=\"{{.missing}}\">", "<img srcset=\"\">")
  vec(dt, "<title>{{range .inf}}{{.}},{{end}}</title><b title={{printf \"%v-%v\" .url .num}}>x</b>", "<title>0,0.25,</title><b title=http://x.org/p?q&\#61;a&\#32;b&amp;r&\#61;&lt;-1.5e&\#43;300>x</b>")
  vec(dj, "<script>// {{nil}}\n{{$v := .s}}{{$v}}</script><style>a { font-family: \"{{printf \"%v-%v\" (len .tags) \"a'b\"}}\" }</style>", "<script>|ERR|template: v:1:13: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "<script>// {{or .si}}\n{{range nil}}{{.}},{{end}}</script>", "<script>\n|ERR|template: v:2:8: executing \"v\" at <nil>: nil is not a command")
  vec(dj, "<script>// {{.obj.w}}\n{{$v := .num}}{{$v}}</script>", "<script>\n\"12px\"</script>")
