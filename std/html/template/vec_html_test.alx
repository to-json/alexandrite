  vec(dt, "<title>{{printf \"%v-%v\" .q .bad}}</title>{{range $k, $v := .}}<li data-k=\"{{$k}}\">{{printf \"%v-%v\" .si .q}}</li>{{end}}", "<title>&\#39;&\#34;`-javascript:alert(1)</title><li data-k=\"bad\">|ERR|template: v:1:99: executing \"v\" at <.si>: can't evaluate field si in type interface {}")
  vec(dj, "<script>var t = `a${{{2.5}}}b{{.flag}}`;</script>", "PARSE:template: v:1: unexpected \"{\" in command")
  vec(dt, "<title>{{true}}</title>", "<title>true</title>")
