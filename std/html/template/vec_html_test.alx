  vec(dt, "<style>a { font-family: \"{{if .inf}}{{.j}}{{else}}E{{end}}\" }</style>{{range $k, $v := .}}<li data-k=\"{{$k}}\">{{js true}}</li>{{end}}", "<style>a { font-family: \"a \\2b  b\" }</style><li data-k=\"bad\">true</li><li data-k=\"c\">true</li><li data-k=\"e\">true</li><li data-k=\"f\">true</li><li data-k=\"h\">true</li><li data-k=\"ha\">true</li><li data-k=\"i\">true</li><li data-k=\"inf\">true</li><li data-k=\"j\">true</li><li data-k=\"jss\">true</li><li data-k=\"msi\">true</li><li data-k=\"neg\">true</li><li data-k=\"np\">true</li><li data-k=\"num\">true</li><li data-k=\"q\">true</li><li data-k=\"s\">true</li><li data-k=\"si\">true</li><li data-k=\"ss\">true</li><li data-k=\"ss2\">true</li><li data-k=\"st\">true</li><li data-k=\"t\">true</li><li data-k=\"u\">true</li><li data-k=\"uq\">true</li><li data-k=\"url\">true</li>")
  vec(dj, "{{if .}}<a href=\"{{printf \"%v-%v\" nil .esc}}\">{{else}}<a title=\"{{.num}}\">{{end}}x</a><script>var x = {{.css}};</script>", "<a href=\"%3cnil%3e-%3c/script%3e%3c!--\">x</a><script>var x = \"expression(x)\";</script>")
  vec(dt, "<p>{{.num}}</p>", "<p>1.5e&\#43;300</p>")
  vec(dj, "<p style=\"background: url({{-3 | len}})\">x</p>", "<p style=\"background: url(|ERR|template: v:1:33: executing \"v\" at <len>: error calling len: len of type int")
  vec(dt, "<p>{{printf \"%v-%v\" .ss .s}}</p><script>var s = \"{{.np}}\";</script>", "<p>[x y &lt;z&gt;]-go &amp; &lt;alx&gt;</p><script>var s = \"\\u003cnil\\u003e\";</script>")
