test "html vectors 2" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "<meta http-equiv=\"refresh\" content=\"0; url={{.nul}}\"><img srcset=\"{{range 2.5}}{{.}},{{end}}\">", "<meta http-equiv=\"refresh\" content=\"0; url=\"><img srcset=\"|ERR|template: v:1:74: executing \"v\" at <2.5>: range can't iterate over 2.5")
  vec(dt, "<a href=\"{{.num}}\" onclick=\"{{.np}}\">", "<a href=\"1.5e&\#43;300\" onclick=\" null \">")
  vec(dj, "{{if .}}<a href=\"{{.css}}\">{{else}}<a title=\"{{if .obj.z}}{{.name}}{{else}}E{{end}}\">{{end}}x</a>", "<a href=\"expression%28x%29\">x</a>")
  vec(dt, "<button onclick=\"f({{.t}})\">x</button><button onclick='g(\"{{printf \"%v-%v\" .si .ha}}\")'>x</button>", "<button onclick=\"f( true )\">x</button><button onclick='g(\"[5 10 15]- dir=\\u0022ltr\\u0022\")'>x</button>")
  vec(dj, "<p>{{$v := true}}{{$v}}</p><p {{$v := .pi}}{{$v}}>", "<p>true</p><p ZgotmplZ>")
  vec(dt, "{{range $k, $v := .}}<li data-k=\"{{$k}}\">{{printf \"%v-%v\" .c .ss2}}</li>{{end}}", "<li data-k=\"bad\">|ERR|template: v:1:58: executing \"v\" at <.c>: can't evaluate field c in type interface {}")
  vec(dj, "<a {{if .url}}{{.neg}}{{else}}E{{end}}=\"x\">y</a>", "<a ZgotmplZ=\"x\">y</a>")
  vec(dt, "<img srcset=\"{{.e}}\">", "<img srcset=\"\">")
  vec(dj, "<!-- {{.obj.x}} -->{{.obj.x}}", "1")
  vec(dt, "<b title=\"{{.neg | html}}\">x</b>", "<b title=\"-17\">x</b>")
  vec(dj, "<svg><a xlink:href=\"{{printf \"%v-%v\" .age .nul}}\">x</a></svg>", "<svg><a xlink:href=\"30-%3cnil%3e\">x</a></svg>")
  vec(dt, "{{range $k, $v := .}}<li data-k=\"{{$k}}\">{{$v := .np}}{{$v}}</li>{{end}}", "<li data-k=\"bad\">|ERR|template: v:1:49: executing \"v\" at <.np>: can't evaluate field np in type interface {}")
  vec(dj, "<a href=\"\#{{.age}}\">x</a>", "<a href=\"\#30\">x</a>")
  vec(dt, "<p {{range .ha}}{{.}},{{end}}>", "<p |ERR|template: v:1:11: executing \"v\" at <.ha>: range can't iterate over  dir=\"ltr\"")
  vec(dj, "<script>var s = \"{{.age}}\";</script>", "<script>var s = \"30\";</script>")
