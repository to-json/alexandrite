test "html vectors 12" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "<meta http-equiv=\"refresh\" content=\"0; url={{.s}}\">", "<meta http-equiv=\"refresh\" content=\"0; url=&lt;b&gt;&amp;&\#39;&\#34;x&\#34;&lt;/b&gt; =\">")
  vec(dt, "<a {{.f}}=\"x\">y</a>", "<a ZgotmplZ=\"x\">y</a>")
  vec(dj, "<a href=\"{{if .}}{{.obj.z}}{{end}}\">x</a>", "<a href=\"\#ZgotmplZ\">x</a>")
  vec(dt, "<p style=\"width: {{.num}}\">x</p>", "<p style=\"width: 1.5e&\#43;300\">x</p>")
  vec(dj, "{{if .obj.z}}{{\"a'b\"}}{{else}}E{{end}}", "a&\#39;b")
  vec(dt, "<script>var s = \"{{.num}}\";</script><p>{{$v := .}}{{$v}}</p>", "<script>var s = \"1.5e\\u002b300\";</script><p>map[bad:javascript:alert(1) c:color: red e: f:2.5 h:&lt;b&gt;bold&lt;/b&gt; ha: dir=&\#34;ltr&\#34; i:42 inf:[0 0.25] j:a &\#43; b jss:it&\#39;s msi:map[one:1 two:2] neg:-17 np:&lt;nil&gt; num:1.5e&\#43;300 q:&\#39;&\#34;` s:go &amp; &lt;alx&gt; si:[5 10 15] ss:[x y &lt;z&gt;] ss2:/img.png 2x st:{1 b&lt;e&gt;e [4]} t:true u:javascript:x() uq:a=1&amp;b=2 url:http://x.org/p?q=a b&amp;r=&lt;]</p>")
  vec(dj, "<a href=\"{{if .}}{{.pi | len}}{{end}}\">x</a>{{range $k, $v := .}}<li data-k=\"{{$k}}\">{{.obj.y}}</li>{{end}}", "<a href=\"|ERR|template: v:1:25: executing \"v\" at <len>: error calling len: len of type float64")
  vec(dt, "<img src={{.f}}>", "<img src=2.5>")
  vec(dj, "<style>a { background: url('{{printf \"%v-%v\" .no .obj.x}}') }</style>", "<style>a { background: url('false-1') }</style>")
  vec(dt, "<p {{\"x&y\"}}>", "<p ZgotmplZ>")
  vec(dj, "<style>a { background: url('{{printf \"%v-%v\" (len .tags) .missing}}') }</style><a href=\"{{if .age}}{{.neg}}{{else}}E{{end}}\">x</a>", "<style>a { background: url('3-%3cnil%3e') }</style><a href=\"-2\">x</a>")
  vec(dt, "<script>var r = /{{.ha}}/;</script>", "<script>var r = / dir=\\u0022ltr\\u0022/;</script>")
  vec(dj, "<b title={{printf \"%v-%v\" .obj.y .missing}}>x</b>", "<b title=&lt;nil&gt;-&lt;nil&gt;>x</b>")
  vec(dt, "<a href='/p?q={{printf \"%v-%v\" .i .uq}}&r={{printf \"%v-%v\" 1 .si}}'>x</a>{{range .num}}{{.}},{{end}}", "<a href='/p?q=42-a%3d1%26b%3d2&r=1-%5b5%2010%2015%5d'>x</a>|ERR|template: v:1:81: executing \"v\" at <.num>: range can't iterate over 1.5e+300")
  vec(dj, "<p style=\"background: url({{.tags}})\">x</p><a href=\"{{if .}}{{.age}}{{end}}\">x</a>", "<p style=\"background: url([a%20b%20c])\">x</p><a href=\"30\">x</a>")
  vec(dt, "{{range $k, $v := .}}<li data-k=\"{{$k}}\">{{printf \"%v-%v\" .msi 1}}</li>{{end}}", "<li data-k=\"bad\">|ERR|template: v:1:58: executing \"v\" at <.msi>: can't evaluate field msi in type interface {}")
  vec(dj, "<svg><a xlink:href=\"{{\"a'b\"}}\">x</a></svg>", "<svg><a xlink:href=\"a%27b\">x</a></svg>")
  vec(dt, "<a href=\"{{if .ha}}{{\"x&y\"}}{{else}}E{{end}}\">x</a>", "<a href=\"x&amp;y\">x</a>")
  vec(dj, "<a href=\"{{.nul}}\" onclick=\"{{printf \"%v-%v\" .name .url}}\">", "<a href=\"\" onclick=\"&\#34;Ann-http://ex.com/a b?q=1\\u0026r=\\u003cx\\u003e\#f&\#34;\">")
  vec(dt, "<button onclick=\"f({{or .c}})\">x</button>", "<button onclick=\"f(&\#34;color: red&\#34;)\">x</button>")
  vec(dj, "<p>{{and .nul}}</p>", "<p></p>")
  vec(dt, "<script>var s = \"{{range .t}}{{.}},{{end}}\";</script>", "<script>var s = \"|ERR|template: v:1:25: executing \"v\" at <.t>: range can't iterate over true")
  vec(dj, "<p style=\"width: {{range .}}{{.}},{{end}}\">x</p>", "<p style=\"width: 30,ZgotmplZ,ZgotmplZ,ZgotmplZ,true,ZgotmplZ,Ann,-2,false,,12px,ZgotmplZ,3.14159,ZgotmplZ,ZgotmplZ,héllo, 世界,ZgotmplZ, \t\n,0,\">x</p>")
