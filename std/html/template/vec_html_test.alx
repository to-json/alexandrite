  vec(dt, "<img srcset=\"{{if .ss}}{{.e}}{{else}}E{{end}}\">", "<img srcset=\"\">")
  vec(dj, "<p style=\"background: url({{false}})\">x</p><a href='/p?q={{.flag}}&r={{if .obj.w}}{{(len .tags)}}{{else}}E{{end}}'>x</a>", "<p style=\"background: url(false)\">x</p><a href='/p?q=true&r=3'>x</a>")
  vec(dt, "<style>a { background: url('{{.u}}') }</style>", "<style>a { background: url('javascript:x%28%29') }</style>")
  vec(dj, "<p {{true | printf \"%q\"}}>", "<p ZgotmplZ>")
  vec(dt, "<iframe srcdoc=\"{{nil}}\"></iframe><button onclick=\"f({{.url}})\">x</button>", "<iframe srcdoc=\"|ERR|template: v:1:18: executing \"v\" at <nil>: nil is not a command")
  vec(dj, "<iframe srcdoc=\"{{printf \"%v-%v\" .nul 1}}\"></iframe>", "<iframe srcdoc=\"&lt;nil&gt;-1\"></iframe>")
  vec(dt, "<title>{{if .q}}{{.st}}{{else}}E{{end}}</title>", "<title>{1 b&lt;e&gt;e [4]}</title>")
  vec(dj, "<script>var t = `a${{{(len .tags)}}}b{{.js}}`;</script>", "PARSE:template: v:1: unexpected \"{\" in command")
  vec(dt, "<!-- {{.ss2}} -->{{range .t}}{{.}},{{end}}", "|ERR|template: v:1:25: executing \"v\" at <.t>: range can't iterate over true")
  vec(dj, "<textarea>{{true | printf \"%q\"}}</textarea>", "<textarea>%!q(bool=true)</textarea>")
  vec(dt, "<p style=\"background: url({{.f}})\">x</p>", "<p style=\"background: url(2.5)\">x</p>")
  vec(dj, "<style>a { background: url('{{or .ws}}') }</style><style>a { font-family: \"{{\"<a>\" | html}}\" }</style>", "<style>a { background: url('%20%09%0a') }</style><style>a { font-family: \"\\26lt\\3b a\\26gt\\3b \" }</style>")
  vec(dt, "<p style=\"width: {{printf \"%v-%v\" true .missing}}\">x</p>", "<p style=\"width: ZgotmplZ\">x</p>")
}

