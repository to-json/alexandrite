  vec(dj, "<a href=\"{{if .}}{{\"\"}}{{end}}\">x</a>", "<a href=\"\">x</a>")
  vec(dt, "<style>p { color: {{1}} }</style>", "<style>p { color: 1 }</style>")
  vec(dj, "<p style=\"width: {{.flag}}\">x</p><button onclick='g(\"{{urlquery .flag}}\")'>x</button>", "<p style=\"width: true\">x</p><button onclick='g(\"true\")'>x</button>")
  vec(dt, "<button onclick=\"f({{if .num}}{{.jss}}{{else}}E{{end}})\">x</button>", "<button onclick=\"f(&\#34;it&\#39;s&\#34;)\">x</button>")
}

