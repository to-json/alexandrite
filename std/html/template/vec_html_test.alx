test "html vectors 16" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "<b title=\"{{.obj.x}}\">x</b>", "<b title=\"1\">x</b>")
  vec(dt, "<b title='{{.t | html}}'>x</b><a {{not 1}}=\"x\">y</a>", "<b title='true'>x</b><a false=\"x\">y</a>")
  vec(dj, "<script>var s = '{{.nul}}' + {{(len .tags) | print}};</script>", "<script>var s = '' + \"3\";</script>")
  vec(dt, "<script>var x = {{.j | len}};</script>", "<script>var x =  5 ;</script>")
  vec(dj, "<a href=\"{{.ws}}\" onclick=\"{{(len .tags)}}\">", "<a href=\"%20%09%0a\" onclick=\" 3 \">")
  vec(dt, "<button onclick=\"f({{if .st}}{{.q}}{{else}}E{{end}})\">x</button>{{.msi}}", "<button onclick=\"f(&\#34;&\#39;\\&\#34;`&\#34;)\">x</button>map[one:1 two:2]")
  vec(dj, "<style>p { color: {{.ws}} }</style>", "<style>p { color:  \t\n }</style>")
  vec(dt, "<style>p { color: {{.st}} }</style>", "<style>p { color: ZgotmplZ }</style>")
