  vec(dj, "{{if .}}<a href=\"{{.obj}}\">{{else}}<a title=\"{{range .num}}{{.}},{{end}}\">{{end}}x</a>", "<a href=\"\#ZgotmplZ\">x</a>")
  vec(dt, "<b title={{.bad}}>x</b><p style=\"background: url({{and .f}})\">x</p>", "<b title=javascript:alert(1)>x</b><p style=\"background: url(2.5)\">x</p>")
  vec(dj, "<script type=\"application/ld+json\">{\"a\": {{.empty}}}</script>", "<script type=\"application/ld+json\">{\"a\": []}</script>")
  vec(dt, "<iframe srcdoc=\"{{not nil}}\"></iframe>", "<iframe srcdoc=\"true\"></iframe>")
  vec(dj, "<a href=\"{{range .obj.z}}{{.}},{{end}}\" onclick=\"{{$v := .url}}{{$v}}\"><img srcset=\"{{.zero}}\">", "<a href=\"1,2,\#ZgotmplZ,\" onclick=\"&\#34;http://ex.com/a b?q=1\\u0026r=\\u003cx\\u003e\#f&\#34;\"><img srcset=\"0\">")
  vec(dt, "<button onclick=\"f({{.num}})\">x</button><b title='{{.url}}'>x</b>", "<button onclick=\"f( 1.5e&\#43;300 )\">x</button><b title='http://x.org/p?q=a b&amp;r=&lt;'>x</b>")
  vec(dj, "<b title=\"{{range .obj}}{{.}},{{end}}\">x</b>", "<b title=\"wide,1,,[1 2 map[k:v]],\">x</b>")
  vec(dt, "<script type=\"text/template\">{{range .j}}{{.}},{{end}}</script>", "<script type=\"text/template\">|ERR|template: v:1:37: executing \"v\" at <.j>: range can't iterate over a + b")
  vec(dj, "<img srcset=\"{{false}}\"><meta http-equiv=\"refresh\" content=\"0; url={{.url | urlquery}}\">", "<img srcset=\"false\"><meta http-equiv=\"refresh\" content=\"0; url=http%3A%2F%2Fex.com%2Fa&\#43;b%3Fq%3D1%26r%3D%3Cx%3E%23f\">")
  vec(dt, "<b title={{and 1}}>x</b>", "<b title=1>x</b>")
}

test "html vectors 20" {
  dj = vec_json()
  dt = vec_typed()
