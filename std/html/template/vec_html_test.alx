test "html vectors 22" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "<img srcset=\"{{if .css}}{{.flag}}{{else}}E{{end}}\"><b title=\"{{.obj}}\">x</b>", "<img srcset=\"true\"><b title=\"map[w:wide x:1 y:&lt;nil&gt; z:[1 2 map[k:v]]]\">x</b>")
