import "bytes"
import "encoding/json"
import "math"
import ttmpl "text/template"

def vec_typed -> ttmpl.Value {
  ttmpl.Value.map_of([ttmpl.Value.str("bad"), ttmpl.Value.str("c"), ttmpl.Value.str("e"), ttmpl.Value.str("f"), ttmpl.Value.str("h"), ttmpl.Value.str("ha"), ttmpl.Value.str("i"), ttmpl.Value.str("inf"), ttmpl.Value.str("j"), ttmpl.Value.str("jss"), ttmpl.Value.str("msi"), ttmpl.Value.str("neg"), ttmpl.Value.str("np"), ttmpl.Value.str("num"), ttmpl.Value.str("q"), ttmpl.Value.str("s"), ttmpl.Value.str("si"), ttmpl.Value.str("ss"), ttmpl.Value.str("ss2"), ttmpl.Value.str("st"), ttmpl.Value.str("t"), ttmpl.Value.str("u"), ttmpl.Value.str("uq"), ttmpl.Value.str("url")], [ttmpl.Value.str("javascript:alert(1)"), ttmpl.Value.str_of("color: red", "template.CSS"), ttmpl.Value.str(""), ttmpl.Value.float(2.5), ttmpl.Value.str_of("<b>bold</b>", "template.HTML"), ttmpl.Value.str_of(" dir=\"ltr\"", "template.HTMLAttr"), ttmpl.Value.int(42), ttmpl.Value.list_of([ttmpl.Value.float(0.0), ttmpl.Value.float(0.25)], "[]float64"), ttmpl.Value.str_of("a + b", "template.JS"), ttmpl.Value.str_of("it's", "template.JSStr"), ttmpl.Value.map_of([ttmpl.Value.str("one"), ttmpl.Value.str("two")], [ttmpl.Value.int(1), ttmpl.Value.int(2)], "map[string]int"), ttmpl.Value.int(-17), ttmpl.Value.nil_of("*int"), ttmpl.Value.float(1.5e+300), ttmpl.Value.str("'\"`"), ttmpl.Value.str("go & <alx>"), ttmpl.Value.list_of([ttmpl.Value.int(5), ttmpl.Value.int(10), ttmpl.Value.int(15)], "[]int"), ttmpl.Value.list_of([ttmpl.Value.str("x y"), ttmpl.Value.str("<z>")], "[]string"), ttmpl.Value.str_of("/img.png 2x", "template.Srcset"), ttmpl.Value.struct_of("template.vecSt", ["A", "B", "C"], [ttmpl.Value.int(1), ttmpl.Value.str("b<e>e"), ttmpl.Value.list_of([ttmpl.Value.int(4)], "[]int")]), ttmpl.Value.bool(true), ttmpl.Value.str_of("javascript:x()", "template.URL"), ttmpl.Value.str_of("a=1&b=2", "template.URL"), ttmpl.Value.str("http://x.org/p?q=a b&r=<")], "map[string]interface {}")
}

def vec_json -> ttmpl.Value {
  ttmpl.Value.from_json(json.parse("{\"name\":\"Ann\",\"age\":30,\"pi\":3.14159,\"neg\":-2,\"zero\":0,\"tags\":[\"a\",\"b\",\"c\"],\"empty\":[],\"obj\":{\"x\":1,\"y\":null,\"z\":[1,2,{\"k\":\"v\"}],\"w\":\"wide\"},\"flag\":true,\"no\":false,\"s\":\"<b>&'\\\"x\\\"</b> =\",\"uni\":\"héllo, 世界\",\"url\":\"http://ex.com/a b?q=1&r=<x>\#f\",\"js\":\"javascript:alert(1)\",\"css\":\"expression(x)\",\"num\":\"12px\",\"ws\":\" \\t\\n\",\"esc\":\"</script><!--\",\"nul\":null}").unwrap)
}

def vec(data: ttmpl.Value, input: Str, want: Str) {
  pr = new("v").parse(input)
  if e = pr.err {
    assert_eq "PARSE:" + e.message, want
    return
  }
  b = bytes.new_buffer([])
  r = pr.unwrap.execute(b, data)
  got = b.string
  if e = r.err {
    got = got + "|ERR|" + e.message
  }
  assert_eq got, want
}

