test "html vectors 6" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "<a href=\"{{$v := .empty}}{{$v}}\" onclick=\"{{.name}}\"><script>var t = `a${{{$v := .zero}}{{$v}}}b{{$v := \"<a>\"}}{{$v}}`;</script>", "PARSE:template: v:1: unexpected \"{\" in command")
  vec(dt, "<script>var r = /{{.uq}}/;</script><script>var r = /{{.c}}/;</script>", "<script>var r = /a=1\\u0026b=2/;</script><script>var r = /color: red/;</script>")
  vec(dj, "<script>var s = '{{printf \"%v-%v\" .ws .pi}}' + {{if .obj.x}}{{.missing}}{{else}}E{{end}};</script>", "<script>var s = ' \\t\\n-3.14159' +  null ;</script>")
  vec(dt, "<p style=\"background: url({{.ss}})\">x</p>", "<p style=\"background: url([x%20y%20%3cz%3e])\">x</p>")
  vec(dj, "<script>var x = {{printf \"%v-%v\" true \"str\"}};</script>", "<script>var x = \"true-str\";</script>")
  vec(dt, "<p {{\"x&y\"}}>", "<p ZgotmplZ>")
  vec(dj, "<button onclick='g(\"{{\"\" | len}}\")'>x</button>", "<button onclick='g(\"0\")'>x</button>")
  vec(dt, "{{if .np}}{{.ss2}}{{else}}E{{end}}<script>// {{.si}}\n{{true}}</script>", "E<script>\n true </script>")
  vec(dj, "<script>// {{if .ws}}{{.no}}{{else}}E{{end}}\n{{.empty | html}}</script>", "<script>\n\"[]\"</script>")
  vec(dt, "<style>a { background: url('{{printf \"%v-%v\" \"x&y\" .neg}}') }</style>", "<style>a { background: url('x&y--17') }</style>")
  vec(dj, "<script>var s = \"{{.flag | urlquery}}\";</script><a href=\"\#{{.missing}}\">x</a>", "<script>var s = \"true\";</script><a href=\"\#\">x</a>")
  vec(dt, "<button onclick='g(\"{{.h}}\")'>x</button>", "<button onclick='g(\"\\u003cb\\u003ebold\\u003c\\/b\\u003e\")'>x</button>")
  vec(dj, "<script type=\"text/template\">{{.js}}</script>", "<script type=\"text/template\">javascript:alert(1)</script>")
  vec(dt, "<p>{{$v := .missing}}{{$v}}</p>", "<p></p>")
  vec(dj, "<a href='/p?q={{range .neg}}{{.}},{{end}}&r={{$v := \"\"}}{{$v}}'>x</a>", "<a href='/p?q=|ERR|template: v:1:22: executing \"v\" at <.neg>: range can't iterate over -2")
  vec(dt, "<p style=\"width: {{.jss | printf \"%q\"}}\">x</p>", "<p style=\"width: ZgotmplZ\">x</p>")
  vec(dj, "<title>{{.missing}}</title>", "<title></title>")
