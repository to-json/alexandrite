test "go random vectors 0" {
  assert_eq unescape_string("#<&profalar&xoplus;&amp\""), "#<&profalar⨁&\""
  assert_eq escape_string("#<&profalar&xoplus;&amp\""), "#&lt;&amp;profalar&amp;xoplus;&amp;amp&#34;"
  assert_eq unescape_string(""), ""
  assert_eq escape_string(""), ""
  assert_eq unescape_string("&copysr;&setminus;&#xDFFF;&#X&#4294967361;#"), "℗∖�&#XA#"
  assert_eq escape_string("&copysr;&setminus;&#xDFFF;&#X&#4294967361;#"), "&amp;copysr;&amp;setminus;&amp;#xDFFF;&amp;#X&amp;#4294967361;#"
  assert_eq unescape_string("&Ncaron;0'&xa"), "Ň0'&xa"
  assert_eq escape_string("&Ncaron;0'&xa"), "&amp;Ncaron;0&#39;&amp;xa"
  assert_eq unescape_string(""), ""
  assert_eq escape_string(""), ""
  assert_eq unescape_string("&yumlx&#99999999999;&CounterClockwiseContourIntegral;"), "ÿx�∳"
  assert_eq escape_string("&yumlx&#99999999999;&CounterClockwiseContourIntegral;"), "&amp;yumlx&amp;#99999999999;&amp;CounterClockwiseContourIntegral;"
  assert_eq unescape_string("&<"), "&<"
  assert_eq escape_string("&<"), "&amp;&lt;"
  assert_eq unescape_string(""), ""
  assert_eq escape_string(""), ""
  assert_eq unescape_string("F#&amp&pxA&szligx;"), "F#&&pxAßx;"
  assert_eq escape_string("F#&amp&pxA&szligx;"), "F#&amp;amp&amp;pxA&amp;szligx;"
  assert_eq unescape_string("&exis&KHca&erDot;&rang;"), "&exis&KHca≓⟩"
  assert_eq escape_string("&exis&KHca&erDot;&rang;"), "&amp;exis&amp;KHca&amp;erDot;&amp;rang;"
  assert_eq unescape_string("&Amp;&#xFFFFFFFFFF;&rlm;"), "&Amp;�\u200f"
  assert_eq escape_string("&Amp;&#xFFFFFFFFFF;&rlm;"), "&amp;Amp;&amp;#xFFFFFFFFFF;&amp;rlm;"
  assert_eq unescape_string("A&#x10FFFF;&ShortLeftArrow;g&rang;"), "A\U0010ffff←g⟩"
  assert_eq escape_string("A&#x10FFFF;&ShortLeftArrow;g&rang;"), "A&amp;#x10FFFF;&amp;ShortLeftArrow;g&amp;rang;"
  assert_eq unescape_string("&gt;&amp;amp;&aacute&amp;amp;"), ">&amp;á&amp;"
  assert_eq escape_string("&gt;&amp;amp;&aacute&amp;amp;"), "&amp;gt;&amp;amp;amp;&amp;aacute&amp;amp;amp;"
  assert_eq unescape_string("&#0;&#0;&tr&#99999999999; &#xFFFFFFFFFF;"), "��&tr� �"
  assert_eq escape_string("&#0;&#0;&tr&#99999999999; &#xFFFFFFFFFF;"), "&amp;#0;&amp;#0;&amp;tr&amp;#99999999999; &amp;#xFFFFFFFFFF;"
  assert_eq unescape_string(""), ""
  assert_eq escape_string(""), ""
  assert_eq unescape_string("&#159;&#159; &frac&rang;"), "ŸŸ &frac⟩"
  assert_eq escape_string("&#159;&#159; &frac&rang;"), "&amp;#159;&amp;#159; &amp;frac&amp;rang;"
  assert_eq unescape_string("&AMP&AMP;&szligx;"), "&&ßx;"
  assert_eq escape_string("&AMP&AMP;&szligx;"), "&amp;AMP&amp;AMP;&amp;szligx;"
  assert_eq unescape_string("&#159;&notit;&#4294967361;&rsquor&aacute"), "Ÿ¬it;A&rsquorá"
  assert_eq escape_string("&#159;&notit;&#4294967361;&rsquor&aacute"), "&amp;#159;&amp;notit;&amp;#4294967361;&amp;rsquor&amp;aacute"
  assert_eq unescape_string("&bsemi;"), "⁏"
  assert_eq escape_string("&bsemi;"), "&amp;bsemi;"
  assert_eq unescape_string(";日&noti"), ";日¬i"
  assert_eq escape_string(";日&noti"), ";日&amp;noti"
  assert_eq unescape_string("&Amp;&gn&Amp;"), "&Amp;&gn&Amp;"
