  assert_eq unescape_string("&AMP;\n"), "&\n"
  assert_eq escape_string("&AMP;\n"), "&amp;AMP;\n"
  assert_eq unescape_string("0&copysr;&ThickSpace;&#0;A&amp;amp;&aacute;"), "0℗\u205f\u200a�A&amp;á"
