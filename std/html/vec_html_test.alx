  assert_eq unescape_string(""), ""
  assert_eq escape_string(""), ""
  assert_eq unescape_string(";&cir&aacute&#159;"), ";&ciráŸ"
  assert_eq escape_string(";&cir&aacute&#159;"), ";&amp;cir&amp;aacute&amp;#159;"
  assert_eq unescape_string("&amp0#"), "&0#"
