  assert_eq escape_string("&#99999999999;&#4294967361;&gesl;"), "&amp;#99999999999;&amp;#4294967361;&amp;gesl;"
  assert_eq unescape_string("&nbsp"), "\u00a0"
  assert_eq escape_string("&nbsp"), "&amp;nbsp"
