def assign_id_8_64(text: [Byte], sa: [I64], num_lms: Int) -> Int {
  id = 0
  last_len: I64 = -1 # impossible
  last_pos = 0
  for x in sa.size - num_lms...sa.size {
    j = sa[x].to_i
    # Is the LMS-substring at index j new, or is it the same as the last one we saw?
    n = sa[j / 2]
    same = false
    if n == last_len {
      if n.as_u64 >= text.size.as_u64 {
        # “Length” is really encoded full text, and they match.
        same = true
      } else {
        # Compare actual texts.
        m = n.to_i
        same = true
        k = 0
        while k < m {
          if text[j + k] != text[last_pos + k] {
            same = false
            break
          }
          k += 1
        }
      }
    }
    if !same {
      id += 1
      last_pos = j
      last_len = n
    }
    sa[j / 2] = id.as_i64
  }
  id
}

