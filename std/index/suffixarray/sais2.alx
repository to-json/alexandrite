  while i > 0 {
    i -= 1
    c1 = c0
    c0 = text[i]
    if c0 < c1 {
      is_type_s = true
    } else if c0 > c1 && is_type_s {
      is_type_s = false

      # Populate inverse map.
      j -= 1
      unmap[j] = (i + 1).as_i64
    }
  }

  # Apply inverse map to subproblem suffix array.
  for x in 0...num_lms {
    sa[x] = unmap[sa[x]]
  }
}

def expand_8_64(text: [Byte], freq: [I64], bucket: [I64], sa: [I64], num_lms: Int) {
  bucket_max_8_64(text, freq, bucket)

  # Loop backward through sa, always tracking
  # the next index to populate from sa[:num_lms].
  # When we get to one, populate it.
  # Zero the rest of the slots; they have dead values in them.
  x = num_lms - 1
  sa_x = sa[x]
  c = text[sa_x]
  b = bucket[c] - 1
  bucket[c] = b

  i = sa.size
  while i > 0 {
    i -= 1
    if i != b.to_i {
      sa[i] = 0
      next
    }
    sa[i] = sa_x

    # Load next entry to put down (if any).
    if x > 0 {
      x -= 1
      sa_x = sa[x]
      c = text[sa_x]
      b = bucket[c] - 1
      bucket[c] = b
    }
  }
}

