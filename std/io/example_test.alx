#![test(external)]
# Go's io/example_test.go, translated (package io_test). strings.NewReader
# is bytes.new_reader here (sr).

import "bytes"
import "io"
import "os"

example "Copy" {
  r = sr("some io.Reader stream to be read\n")
  io.copy(os.stdout, r).unwrap
} outputs "some io.Reader stream to be read\n"

example "CopyBuffer" {
  r1 = sr("first reader\n")
  r2 = sr("second reader\n")
  buf: [Byte] = [0; 8]
  io.copy_buffer(os.stdout, r1, buf).unwrap
  io.copy_buffer(os.stdout, r2, buf).unwrap
} outputs "first reader\nsecond reader\n"

example "CopyN" {
  r = sr("some io.Reader stream to be read")
  io.copy_n(os.stdout, r, 4).unwrap
  puts ""
} outputs "some\n"

example "ReadAtLeast" {
  r = sr("some io.Reader stream to be read\n")
  buf: [Byte] = [0; 14]
  io.read_at_least(r, buf, 4).unwrap
  puts Str.from_bytes(buf)
  short_buf: [Byte] = [0; 3]
  if e = io.read_at_least(r, short_buf, 4).err {
    puts "error: #{e.message}"
  }
  long_buf: [Byte] = [0; 64]
  if e = io.read_at_least(r, long_buf, 64).err {
    puts "error: #{e.message}"
  }
} outputs "some io.Reader\nerror: short buffer\nerror: unexpected EOF\n"

example "ReadFull" {
  r = sr("some io.Reader stream to be read\n")
  buf: [Byte] = [0; 4]
  io.read_exact(r, buf).unwrap
  puts Str.from_bytes(buf)
  long_buf: [Byte] = [0; 64]
  if e = io.read_exact(r, long_buf).err {
    puts "error: #{e.message}"
  }
} outputs "some\nerror: unexpected EOF\n"

example "WriteString" {
  io.write_string(os.stdout, "Hello World").unwrap
  puts ""
} outputs "Hello World\n"

example "LimitReader" {
  r = sr("some io.Reader stream to be read\n")
  lr = io.limit_reader(r, 4)
  io.copy(os.stdout, lr).unwrap
  puts ""
} outputs "some\n"

example "MultiReader" {
  r = io.multi_reader([sr("first reader "), sr("second reader "), sr("third reader\n")])
  io.copy(os.stdout, r).unwrap
} outputs "first reader second reader third reader\n"

example "TeeReader" {
  r = io.tee_reader(sr("some io.Reader stream to be read\n"), os.stdout)
  io.read_all(r).unwrap
} outputs "some io.Reader stream to be read\n"

example "SectionReader" {
  s = io.new_section_reader(sr("some io.Reader stream to be read\n"), 5, 17)
  io.copy(os.stdout, s).unwrap
} outputs "io.Reader stream\n"

example "SectionReader_Read" {
  s = io.new_section_reader(sr("some io.Reader stream to be read\n"), 5, 17)
  buf: [Byte] = [0; 9]
  s.read!(buf).unwrap
  puts Str.from_bytes(buf)
} outputs "io.Reader\n"

example "SectionReader_ReadAt" {
  s = io.new_section_reader(sr("some io.Reader stream to be read\n"), 5, 17)
  buf: [Byte] = [0; 6]
  s.read_at(buf, 10).unwrap
  puts Str.from_bytes(buf)
} outputs "stream\n"

example "SectionReader_Seek" {
  s = io.new_section_reader(sr("some io.Reader stream to be read\n"), 5, 17)
  s.seek!(10, io.SEEK_START).unwrap
  io.copy(os.stdout, s).unwrap
} outputs "stream\n"

example "SectionReader_Size" {
  s = io.new_section_reader(sr("some io.Reader stream to be read\n"), 5, 17)
  puts s.size
} outputs "17\n"

example "Seeker_Seek" {
  r = sr("some io.Reader stream to be read\n")
  r.seek!(5, io.SEEK_START).unwrap
  io.copy(os.stdout, r).unwrap
  r.seek!(-5, io.SEEK_END).unwrap
  io.copy(os.stdout, r).unwrap
} outputs "io.Reader stream to be read\nread\n"

example "MultiWriter" {
  r = sr("some io.Reader stream to be read\n")
  buf1 = bytes.new_buffer_string("")
  buf2 = bytes.new_buffer_string("")
  w = io.multi_writer([buf1, buf2])
  io.copy(w, r).unwrap
  print buf1.to_s
  print buf2.to_s
} outputs "some io.Reader stream to be read\nsome io.Reader stream to be read\n"

example "Pipe" {
  r, w = io.pipe
  t = spawn {
    ww = w
    io.write_string(ww, "some io.Reader stream to be read\n").unwrap
    ww.close!.unwrap
  }
  io.copy(os.stdout, r).unwrap
  t.wait.unwrap
} outputs "some io.Reader stream to be read\n"

example "ReadAll" {
  r = sr("Go is a general-purpose language designed with systems programming in mind.")
  b = io.read_all(r).unwrap
  puts Str.from_bytes(b)
} outputs "Go is a general-purpose language designed with systems programming in mind.\n"
