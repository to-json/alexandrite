test "vec file mode string" {
  assert_eq mode(315).to_s, "-r--rwx-wx"
  assert_eq mode(315).is_dir?, false
  assert_eq mode(315).is_regular?, true
  assert_eq mode(1212279904).to_s, "aLg--xr-----"
  assert_eq mode(1212279904).is_dir?, false
  assert_eq mode(1212279904).is_regular?, false
  assert_eq mode(2126176867).to_s, "alTLDpuct?--xr---wx"
  assert_eq mode(2126176867).is_dir?, false
  assert_eq mode(2126176867).is_regular?, false
  assert_eq mode(184549504).to_s, "LpS-w-------"
  assert_eq mode(184549504).is_dir?, false
  assert_eq mode(184549504).is_regular?, false
  assert_eq mode(3700071545).to_s, "daTLDu?--xrwx--x"
  assert_eq mode(3700071545).is_dir?, true
  assert_eq mode(3700071545).is_regular?, false
  assert_eq mode(199).to_s, "--wx---rwx"
  assert_eq mode(199).is_dir?, false
  assert_eq mode(199).is_regular?, true
  assert_eq mode(2401239502).to_s, "dLDpScrwx--xrw-"
