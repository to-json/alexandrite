test "vec format" {
  assert_eq format_file_info(FileInfo.new(name: "a", size: 858312489215, mode: mode(168296830), mod_time: time.unix(2863068316, 0).utc)), "Lp?r-xrwxrw- 858312489215 2060-09-22 08:45:16 a"
  assert_eq format_dir_entry(file_info_to_dir_entry(FileInfo.new(name: "a", size: 858312489215, mode: mode(168296830), mod_time: time.unix(2863068316, 0).utc))), "Lp? a"
  assert_eq format_file_info(FileInfo.new(name: "hello.go", size: 841481568372, mode: mode(169345035), mod_time: time.unix(225759461, 0).utc)), "Lpt?-----x-wx 841481568372 1977-02-25 22:57:41 hello.go"
  assert_eq format_dir_entry(file_info_to_dir_entry(FileInfo.new(name: "hello.go", size: 841481568372, mode: mode(169345035), mod_time: time.unix(225759461, 0).utc))), "Lp? hello.go"
  assert_eq format_file_info(FileInfo.new(name: "dir/sub", size: 520526338651, mode: mode(2393899058), mod_time: time.unix(3173042349, 0).utc)), "dLDpuct---rw--w- 520526338651 2070-07-20 00:39:09 dir/sub/"
  assert_eq format_dir_entry(file_info_to_dir_entry(FileInfo.new(name: "dir/sub", size: 520526338651, mode: mode(2393899058), mod_time: time.unix(3173042349, 0).utc))), "dLDpc dir/sub/"
  assert_eq format_file_info(FileInfo.new(name: "x y", size: 1065237116489, mode: mode(260571390), mod_time: time.unix(2998976142, 0).utc)), "LDpSu?-wxrwxrw- 1065237116489 2065-01-12 08:55:42 x y"
  assert_eq format_dir_entry(file_info_to_dir_entry(FileInfo.new(name: "x y", size: 1065237116489, mode: mode(260571390), mod_time: time.unix(2998976142, 0).utc))), "LDpS? x y"
  assert_eq format_file_info(FileInfo.new(name: "é", size: 60648507250, mode: mode(263717131), mod_time: time.unix(704594603, 0).utc)), "LDpSuct?r----x-wx 60648507250 1992-04-30 00:43:23 é"
