# Package ioutil: Go's io/ioutil — deprecated since Go 1.16; each function
# is the io or os function it names. Kept for code being ported.
#
#   Go                                      alx
#   ReadAll(r)                              read_all(r) -> ~[Byte]           (io.read_all)
#   ReadFile(name)                          read_file(name) -> ~[Byte]       (os.read_file)
#   WriteFile(name, data, perm)             write_file(name, data, perm)     (os.write_file)
#   ReadDir(name) []fs.FileInfo             read_dir(name) -> ~[os.FileInfo], sorted by name
#   NopCloser(r) io.ReadCloser              nop_closer(r) -> NopCloser[R]
#   Discard                                 Discard (io.Discard)
#   TempFile(dir, pattern)                  temp_file(dir, pattern) -> ~os.File   (os.create_temp)
#   TempDir(dir, pattern)                   temp_dir(dir, pattern) -> ~Str        (os.mkdir_temp)
#
# Differences from Go:
#  - read_dir returns os.FileInfo values (alexandrite's os has its own
#    FileInfo; Go's os.FileInfo is fs.FileInfo). An entry that vanishes
#    between listing and stat is left out (Go's Readdir reports lstat
#    errors).
#  - nop_closer is generic over the reader (a type holding an io.Reader
#    value can't be one: interface values are closed sums).
#  - `Discard` is io's Discard type: `ioutil.Discard.new` (or io.Discard.new).

import "io"
import "os"
import "slices"

pub def read_all(r: io.Reader) -> ~[Byte] {
  ~io.read_all(r)
}

pub def read_file(name: Str) -> ~[Byte] {
  ~os.read_file(name)
}

pub def write_file(name: Str, data: [Byte], perm: Int) -> ~Unit {
  ~os.write_file(name, data, perm)
}

def by_name(a: os.FileInfo, b: os.FileInfo) -> Int {
  return -1 if a.name < b.name
  return 1 if a.name > b.name
  0
}

# The FileInfo of each entry of the directory (not following symlinks),
# sorted by name.
pub def read_dir(name: Str) -> ~[os.FileInfo] {
  out: [os.FileInfo] = []
  for e in ~os.read_dir(name) {
    if i = e.info.ok {
      out << i
    }
  }
  slices.sort_func(out, by_name)
  out
}

# A ReadCloser whose close! does nothing (Go's NopCloser).
pub struct NopCloser[R] {
  st: [R]

  pub def read!(p: [Byte]) -> ~Int { self.st[0].~read!(p) }
  pub def close! -> ~Unit {}
}

pub def nop_closer[R](r: R) -> NopCloser[R] {
  NopCloser[R].new(st: [r])
}

# Go's ioutil.Discard.
pub struct Discard {
  pub def write!(p: [Byte]) -> Int { p.size }
  pub def write_string!(s: Str) -> Int { s.size }
}

pub def temp_file(dir: Str, pattern: Str) -> ~os.File {
  ~os.create_temp(dir, pattern)
}

pub def temp_dir(dir: Str, pattern: Str) -> ~Str {
  ~os.mkdir_temp(dir, pattern)
}
