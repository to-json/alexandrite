# Generated from Go's io/ioutil (error texts) by a throwaway program; do not edit by hand.

test "error texts" {
  assert_eq read_file("/no/such/file").err.unwrap.message, "open /no/such/file: no such file or directory"
  assert_eq write_file("/no/such/dir/x", [], 0o644).err.unwrap.message, "open /no/such/dir/x: no such file or directory"
  assert_eq read_dir("/no/such/dir").err.unwrap.message, "open /no/such/dir: no such file or directory"
  assert_eq temp_dir("/no/such/dir", "x").err.unwrap.message, "stat /no/such/dir: no such file or directory"
  assert temp_file("/no/such/dir", "x").err.unwrap.message.start_with?("open /no/such/dir/x")
  assert_eq temp_file("", "a/b").err.unwrap.message, "createtemp a/b: pattern contains path separator"
  assert_eq temp_dir("", "a/b").err.unwrap.message, "mkdirtemp a/b: pattern contains path separator"
}
