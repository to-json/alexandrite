  assert_eq vec_section_reads(2, 0, 4), ""
  assert_eq vec_section_reads(2, 0, 64), ""
  assert_eq vec_section_seek(2, 0, -5, -1), "err:Seek: invalid whence"
  assert_eq vec_section_seek(2, 0, -1, -1), "err:Seek: invalid whence"
  assert_eq vec_section_seek(2, 0, 0, -1), "err:Seek: invalid whence"
  assert_eq vec_section_seek(2, 0, 2, -1), "err:Seek: invalid whence"
}

