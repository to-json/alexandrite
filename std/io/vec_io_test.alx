  assert_eq vec_read_at_least("a", 20, 21, 2), "err:short buffer"
  assert_eq vec_read_at_least("a", 20, 21, 100), "err:short buffer"
  assert_eq vec_read_at_least("hello", 0, 0, 1), "0|"
  assert_eq vec_read_at_least("hello", 0, 0, 2), "0|"
  assert_eq vec_read_at_least("hello", 0, 0, 100), "0|"
  assert_eq vec_read_at_least("hello", 0, 1, 1), "err:short buffer"
