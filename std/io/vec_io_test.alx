  assert_eq vec_section_seek(7, 3, 9, -1), "err:Seek: invalid whence"
  assert_eq vec_section_seek(7, 3, -5, 0), "err:Seek: invalid offset"
  assert_eq vec_section_seek(7, 3, -1, 0), "err:Seek: invalid offset"
