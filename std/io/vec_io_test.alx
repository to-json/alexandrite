  assert_eq vec_read_at_least("a", 1, 1, 1), "1|a"
  assert_eq vec_read_at_least("a", 1, 1, 2), "1|a"
  assert_eq vec_read_at_least("a", 1, 1, 100), "1|a"
  assert_eq vec_read_at_least("a", 1, 3, 1), "err:short buffer"
  assert_eq vec_read_at_least("a", 1, 3, 2), "err:short buffer"
}

test "vectors 21" {
  assert_eq vec_read_at_least("a", 1, 3, 100), "err:short buffer"
  assert_eq vec_read_at_least("a", 1, 5, 1), "err:short buffer"
  assert_eq vec_read_at_least("a", 1, 5, 2), "err:short buffer"
  assert_eq vec_read_at_least("a", 1, 5, 100), "err:short buffer"
  assert_eq vec_read_at_least("a", 1, 21, 1), "err:short buffer"
  assert_eq vec_read_at_least("a", 1, 21, 2), "err:short buffer"
  assert_eq vec_read_at_least("a", 1, 21, 100), "err:short buffer"
  assert_eq vec_read_at_least("a", 4, 0, 1), "0|"
  assert_eq vec_read_at_least("a", 4, 0, 2), "0|"
  assert_eq vec_read_at_least("a", 4, 0, 100), "0|"
  assert_eq vec_read_at_least("a", 4, 1, 1), "1|a"
  assert_eq vec_read_at_least("a", 4, 1, 2), "1|a"
  assert_eq vec_read_at_least("a", 4, 1, 100), "1|a"
  assert_eq vec_read_at_least("a", 4, 3, 1), "err:unexpected EOF"
  assert_eq vec_read_at_least("a", 4, 3, 2), "err:unexpected EOF"
  assert_eq vec_read_at_least("a", 4, 3, 100), "err:unexpected EOF"
  assert_eq vec_read_at_least("a", 4, 5, 1), "err:short buffer"
  assert_eq vec_read_at_least("a", 4, 5, 2), "err:short buffer"
  assert_eq vec_read_at_least("a", 4, 5, 100), "err:short buffer"
  assert_eq vec_read_at_least("a", 4, 21, 1), "err:short buffer"
  assert_eq vec_read_at_least("a", 4, 21, 2), "err:short buffer"
