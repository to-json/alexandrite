# Levels (Go's level.go).

import "encoding/json"
import "strconv"
import "strings"

# The importance of a log event (Go's Level, an int): more is more severe.
# The named levels are level_debug (-4), level_info (0), level_warn (4) and
# level_error (8); `Level.new(n: 12)` makes any other.
pub struct Level {
  n: Int

  # Go's String: the name, plus the offset from it ("WARN+1", "DEBUG-2").
  pub def to_s -> Str {
    return lvl_str("DEBUG", n + 4) if n < 0
    return lvl_str("INFO", n) if n < 4
    return lvl_str("WARN", n - 4) if n < 8
    lvl_str("ERROR", n - 8)
  }
  pub def string -> Str { self.to_s }

  # Go's Level.Level: a Level is its own Leveler.
  pub def level -> Level { self }

  pub def +(k: Int) -> Level { Level.new(n: n + k) }
  pub def -(k: Int) -> Level { Level.new(n: n - k) }
  pub def <=>(o: Level) -> Int {
    return -1 if n < o.n
    return 1 if n > o.n
    0
  }

  # Go's MarshalJSON: the name as a JSON string.
  pub def marshal_json -> Str { strconv.quote(self.to_s) }
  # Go's MarshalText / AppendText.
  pub def marshal_text -> Str { self.to_s }
  pub def append_text(b: [Byte]) -> [Byte] { b + self.to_s.bytes }

  # Go's UnmarshalJSON: a quoted level name.
  pub def unmarshal_json!(data: Str) -> ~Unit {
    s = strconv.unquote(data)
    if e = s.err {
      fail LevelError.Bad(text: data, why: e.message)
    }
    self.n = ~parse_level(s.unwrap).n
  }

  # Go's UnmarshalText: a level name, as parse_level reads it.
  pub def unmarshal_text!(data: Str) -> ~Unit {
    self.n = ~parse_level(data).n
  }

  # std/flag's Value protocol (Go uses a Level as a flag via TextVar):
  # parses s into the level, or returns why it can't.
  pub def set!(s: Str) -> Str? {
    r = parse_level(s)
    if e = r.err {
      return e.message
    }
    self.n = r.unwrap.n
    none
  }

  # The json protocol (std/encoding/json), so a Level can be a field of a
  # `#[derive(Json)]` type, written as Go's MarshalJSON writes it.
  pub def json_str(e: json.Encoder) -> Str { self.marshal_json }
  pub def json_enc(e: json.Encoder) { e.raw!(self.marshal_json) }
}

pub def level_debug -> Level { Level.new(n: -4) }
pub def level_info -> Level { Level.new(n: 0) }
pub def level_warn -> Level { Level.new(n: 4) }
pub def level_error -> Level { Level.new(n: 8) }

def lvl_str(base: Str, val: Int) -> Str {
  return base if val == 0
  sval = val.to_s
  sval = "+" + sval if val > 0
  base + sval
}

pub error LevelError {
  Bad(text: Str, why: Str)

  def message -> Str {
    case self { Bad(text, why) => "slog: level string " + strconv.quote(text) + ": " + why }
  }
}

# Go's Level.UnmarshalText as a function: "DEBUG", "info", "WARN+3",
# "Error-1" (names ignore case; the offset is an integer).
pub def parse_level(s: Str) -> ~Level<LevelError> {
  name = s
  offset = 0
  i = strings.index_any(s, "+-")
  if i >= 0 {
    name = s[0...i]
    r = strconv.atoi(s[i...s.size])
    if e = r.err {
      fail LevelError.Bad(text: s, why: strings.replace_all(e.message, "strconv.atoi", "strconv.Atoi"))
    }
    offset = r.unwrap
  }
  base = case strings.to_upper(name) {
    "DEBUG" => -4
    "INFO" => 0
    "WARN" => 4
    "ERROR" => 8
    _ => 99
  }
  fail LevelError.Bad(text: s, why: "unknown name") if base == 99
  Level.new(n: base + offset)
}

# Anything that gives a minimum level (Go's Leveler): a Level, a LevelVar.
pub interface Leveler {
  def level -> Level
}

# A Level that can change while handlers use it (Go's LevelVar); copies
# share it. Make one with new_level_var (Go's zero LevelVar is INFO).
pub struct LevelVar {
  val: Atomic[Int]

  pub def level -> Level { Level.new(n: val.load) }
  pub def set(l: Level) { val.store(l.n) }
  pub def to_s -> Str { "LevelVar(" + self.level.to_s + ")" }
  pub def string -> Str { self.to_s }
  pub def marshal_text -> Str { self.level.to_s }
  pub def append_text(b: [Byte]) -> [Byte] { self.level.append_text(b) }

  pub def unmarshal_text(data: Str) -> ~Unit {
    l = ~parse_level(data)
    self.set(l)
  }
}

pub def new_level_var -> LevelVar { LevelVar.new(val: Atomic.new(0)) }
