# Loggers (Go's logger.go).

import "log"
import "time"

# Writes records to a Handler (Go's *Logger). A Logger is a value; with and
# with_group return new ones.
pub struct Logger {
  handler: Handler

  # Go's With: a Logger whose records all carry attrs (the receiver if attrs
  # is empty).
  pub def with(attrs: [Attr]) -> Logger {
    return self if attrs.size == 0
    Logger.new(handler: handler.with_attrs(attrs))
  }

  # Go's WithGroup (the receiver if name is empty).
  pub def with_group(name: Str) -> Logger {
    return self if name == ""
    Logger.new(handler: handler.with_group(name))
  }

  pub def enabled?(level: Level) -> Bool { handler.enabled?(level) }

  # Go's Log and LogAttrs (one function: attributes are always Attrs).
  pub def log(level: Level, msg: Str, attrs: [Attr] = []) {
    return if !handler.enabled?(level)
    r = new_record(time.now, level, msg, 0)
    r.add_attrs!(attrs)
    _ = handler.handle(r)
    nil
  }

  pub def log_attrs(level: Level, msg: Str, attrs: [Attr] = []) { self.log(level, msg, attrs) }
  pub def debug(msg: Str, attrs: [Attr] = []) { self.log(level_debug, msg, attrs) }
  pub def info(msg: Str, attrs: [Attr] = []) { self.log(level_info, msg, attrs) }
  pub def warn(msg: Str, attrs: [Attr] = []) { self.log(level_warn, msg, attrs) }
  pub def error(msg: Str, attrs: [Attr] = []) { self.log(level_error, msg, attrs) }
}

# Go's New.
pub def new(h: Handler) -> Logger { Logger.new(handler: h) }

# Go's Default: a Logger writing through std/log's standard logger (stderr,
# date and time), "INFO msg k=v". A fresh one each call: there is no
# SetDefault (see the header).
pub def default -> Logger { Logger.new(handler: new_default_handler(log.default)) }

pub def with(attrs: [Attr]) -> Logger { default.with(attrs) }
pub def debug(msg: Str, attrs: [Attr] = []) { default.debug(msg, attrs) }
pub def info(msg: Str, attrs: [Attr] = []) { default.info(msg, attrs) }
pub def warn(msg: Str, attrs: [Attr] = []) { default.warn(msg, attrs) }
pub def error(msg: Str, attrs: [Attr] = []) { default.error(msg, attrs) }
pub def log(level: Level, msg: Str, attrs: [Attr] = []) { default.log(level, msg, attrs) }
pub def log_attrs(level: Level, msg: Str, attrs: [Attr] = []) { default.log(level, msg, attrs) }

# A writer that sends each write to a handler as a record at `level`
# (Go's handlerWriter), for new_log_logger.
pub struct HandlerWriter {
  h: Handler
  level: Level

  pub def write!(buf: [Byte]) -> ~Int {
    return 0 if !h.enabled?(level)
    n = buf.size
    m = n > 0 && buf[n - 1] == 10 ? n - 1 : n
    r = new_record(time.now, level, Str.from_bytes(buf[0...m]), 0)
    ~h.handle(r)
    n
  }
}

# Go's NewLogLogger: a log.Logger whose output goes to h at `level`.
pub def new_log_logger(h: Handler, level: Level) -> log.Logger[HandlerWriter] {
  log.new(HandlerWriter.new(h: h, level: level), "", 0)
}
