# Records (Go's record.go).

import "time"

# One log event (Go's Record): time, message, level, the caller's program
# counter (kept, but meaning nothing to alexandrite), the attributes, and
# where the logging call was (the Logger's methods set it; see the header).
pub struct Record {
  time: time.Time
  message: Str
  level: Level
  pc: Int
  list: [Attr]
  src: Source

  # Go's NumAttrs.
  pub def num_attrs -> Int { list.size }

  # Go's Attrs: calls f on each attribute until it returns false.
  pub def attrs(f: (Attr) -> Bool) {
    for a in list {
      break if !f.call(a)
    }
  }

  # The attributes, in order.
  pub def attr_list -> [Attr] { list }

  # Go's AddAttrs: appends attrs, leaving out empty groups. The attribute
  # list is copied, so copies of a Record never see each other's additions
  # (Go needs Clone for that).
  pub def add_attrs!(attrs: [Attr]) {
    l: [Attr] = []
    for a in list {
      l << a
    }
    for a in attrs {
      l << a if !a.value.empty_group?
    }
    self.list = l
  }

  # Go's Clone: a copy (an ordinary copy already is one; see add_attrs!).
  pub def clone -> Record { self }

  # Go's Source: where the logging call was, none if unknown (a record
  # from new_record, unless set_source! gave it one).
  pub def source -> Source? {
    return none if src.empty?
    src
  }

  # Sets the source (Go sets a Record's PC from runtime.Callers: a
  # `#[track_caller]` wrapper passes `source_at(caller_location)`).
  pub def set_source!(s: Source) { self.src = s }
}

# The Source of a call site (`source_at(caller_location)`).
pub def source_at(c: CallSite) -> Source { Source.new(function: c.function, file: c.file, line: c.line) }

# Go's NewRecord (pc is kept but means nothing to alexandrite).
pub def new_record(t: time.Time, level: Level, msg: Str, pc: Int) -> Record {
  Record.new(time: t, message: msg, level: level, pc: pc)
}
