  assert_eq parse_level("INFO+2").unwrap.n, 2
  assert_eq Level.new(n: 3).to_s, "INFO+3"
  assert_eq Level.new(n: 3).marshal_json, "\"INFO+3\""
  assert_eq parse_level("INFO+3").unwrap.n, 3
  assert_eq Level.new(n: 4).to_s, "WARN"
  assert_eq Level.new(n: 4).marshal_json, "\"WARN\""
  assert_eq parse_level("WARN").unwrap.n, 4
  assert_eq Level.new(n: 5).to_s, "WARN+1"
  assert_eq Level.new(n: 5).marshal_json, "\"WARN+1\""
  assert_eq parse_level("WARN+1").unwrap.n, 5
  assert_eq Level.new(n: 6).to_s, "WARN+2"
  assert_eq Level.new(n: 6).marshal_json, "\"WARN+2\""
  assert_eq parse_level("WARN+2").unwrap.n, 6
  assert_eq Level.new(n: 7).to_s, "WARN+3"
  assert_eq Level.new(n: 7).marshal_json, "\"WARN+3\""
  assert_eq parse_level("WARN+3").unwrap.n, 7
  assert_eq Level.new(n: 8).to_s, "ERROR"
  assert_eq Level.new(n: 8).marshal_json, "\"ERROR\""
  assert_eq parse_level("ERROR").unwrap.n, 8
  assert_eq Level.new(n: 9).to_s, "ERROR+1"
  assert_eq Level.new(n: 9).marshal_json, "\"ERROR+1\""
  assert_eq parse_level("ERROR+1").unwrap.n, 9
  assert_eq Level.new(n: 10).to_s, "ERROR+2"
  assert_eq Level.new(n: 10).marshal_json, "\"ERROR+2\""
  assert_eq parse_level("ERROR+2").unwrap.n, 10
  assert_eq Level.new(n: 11).to_s, "ERROR+3"
  assert_eq Level.new(n: 11).marshal_json, "\"ERROR+3\""
  assert_eq parse_level("ERROR+3").unwrap.n, 11
  assert_eq Level.new(n: 12).to_s, "ERROR+4"
  assert_eq Level.new(n: 12).marshal_json, "\"ERROR+4\""
  assert_eq parse_level("ERROR+4").unwrap.n, 12
  assert_eq Level.new(n: 13).to_s, "ERROR+5"
}

test "levels 2" {
  assert_eq Level.new(n: 13).marshal_json, "\"ERROR+5\""
  assert_eq parse_level("ERROR+5").unwrap.n, 13
  assert_eq Level.new(n: 14).to_s, "ERROR+6"
  assert_eq Level.new(n: 14).marshal_json, "\"ERROR+6\""
  assert_eq parse_level("ERROR+6").unwrap.n, 14
  assert_eq Level.new(n: 15).to_s, "ERROR+7"
  assert_eq Level.new(n: 15).marshal_json, "\"ERROR+7\""
  assert_eq parse_level("ERROR+7").unwrap.n, 15
  assert_eq Level.new(n: 16).to_s, "ERROR+8"
  assert_eq Level.new(n: 16).marshal_json, "\"ERROR+8\""
  assert_eq parse_level("ERROR+8").unwrap.n, 16
  assert_eq Level.new(n: 17).to_s, "ERROR+9"
  assert_eq Level.new(n: 17).marshal_json, "\"ERROR+9\""
  assert_eq parse_level("ERROR+9").unwrap.n, 17
  assert_eq Level.new(n: 18).to_s, "ERROR+10"
  assert_eq Level.new(n: 18).marshal_json, "\"ERROR+10\""
  assert_eq parse_level("ERROR+10").unwrap.n, 18
  assert_eq Level.new(n: 19).to_s, "ERROR+11"
  assert_eq Level.new(n: 19).marshal_json, "\"ERROR+11\""
  assert_eq parse_level("ERROR+11").unwrap.n, 19
  assert_eq Level.new(n: 20).to_s, "ERROR+12"
  assert_eq Level.new(n: 20).marshal_json, "\"ERROR+12\""
  assert_eq parse_level("ERROR+12").unwrap.n, 20
  assert_eq parse_level("DEBUG").unwrap.n, -4
  assert_eq parse_level("INFO").unwrap.n, 0
  assert_eq parse_level("WARN").unwrap.n, 4
  assert_eq parse_level("ERROR").unwrap.n, 8
  assert_eq parse_level("debug").unwrap.n, -4
  assert_eq parse_level("iNfo").unwrap.n, 0
  assert_eq parse_level("INFO+87").unwrap.n, 87
  assert_eq parse_level("Error-18").unwrap.n, -10
  assert_eq parse_level("Error-8").unwrap.n, 0
  assert_eq parse_level("warn+0").unwrap.n, 4
  assert_eq parse_level("WARN-0").unwrap.n, 4
  assert_eq parse_level("info+-1").err.unwrap.message, "slog: level string \"info+-1\": strconv.atoi: parsing \"+-1\": invalid syntax"
  assert_eq parse_level("").err.unwrap.message, "slog: level string \"\": unknown name"
  assert_eq parse_level("dbg").err.unwrap.message, "slog: level string \"dbg\": unknown name"
  assert_eq parse_level("INFO+").err.unwrap.message, "slog: level string \"INFO+\": strconv.atoi: parsing \"+\": invalid syntax"
  assert_eq parse_level("INFO-").err.unwrap.message, "slog: level string \"INFO-\": strconv.atoi: parsing \"-\": invalid syntax"
  assert_eq parse_level("ERROR+23x").err.unwrap.message, "slog: level string \"ERROR+23x\": strconv.atoi: parsing \"+23x\": invalid syntax"
  assert_eq parse_level("INFO+1.5").err.unwrap.message, "slog: level string \"INFO+1.5\": strconv.atoi: parsing \"+1.5\": invalid syntax"
  assert_eq parse_level(" INFO").err.unwrap.message, "slog: level string \" INFO\": unknown name"
  assert_eq parse_level("INFO ").err.unwrap.message, "slog: level string \"INFO \": unknown name"
  assert_eq parse_level("+3").err.unwrap.message, "slog: level string \"+3\": unknown name"
  assert_eq parse_level("-3").err.unwrap.message, "slog: level string \"-3\": unknown name"
  assert_eq parse_level("DEBUG+9223372036854775807").unwrap.n, 9223372036854775803
  assert_eq parse_level("INFO++1").err.unwrap.message, "slog: level string \"INFO++1\": strconv.atoi: parsing \"++1\": invalid syntax"
  assert_eq parse_level("WARN-+2").err.unwrap.message, "slog: level string \"WARN-+2\": strconv.atoi: parsing \"-+2\": invalid syntax"
  assert_eq parse_level("INFO+99999999999999999999").err.unwrap.message, "slog: level string \"INFO+99999999999999999999\": strconv.atoi: parsing \"+99999999999999999999\": value out of range"
}
