# Generated from Go's log/slog (Go 1.27, Level.String, MarshalJSON and parsing); do not edit by hand.

test "levels 1" {
  assert_eq Level.new(n: -20).to_s, "DEBUG-16"
  assert_eq Level.new(n: -20).marshal_json, "\"DEBUG-16\""
  assert_eq parse_level("DEBUG-16").unwrap.n, -20
  assert_eq Level.new(n: -19).to_s, "DEBUG-15"
  assert_eq Level.new(n: -19).marshal_json, "\"DEBUG-15\""
  assert_eq parse_level("DEBUG-15").unwrap.n, -19
  assert_eq Level.new(n: -18).to_s, "DEBUG-14"
  assert_eq Level.new(n: -18).marshal_json, "\"DEBUG-14\""
  assert_eq parse_level("DEBUG-14").unwrap.n, -18
  assert_eq Level.new(n: -17).to_s, "DEBUG-13"
  assert_eq Level.new(n: -17).marshal_json, "\"DEBUG-13\""
  assert_eq parse_level("DEBUG-13").unwrap.n, -17
  assert_eq Level.new(n: -16).to_s, "DEBUG-12"
  assert_eq Level.new(n: -16).marshal_json, "\"DEBUG-12\""
  assert_eq parse_level("DEBUG-12").unwrap.n, -16
  assert_eq Level.new(n: -15).to_s, "DEBUG-11"
  assert_eq Level.new(n: -15).marshal_json, "\"DEBUG-11\""
  assert_eq parse_level("DEBUG-11").unwrap.n, -15
  assert_eq Level.new(n: -14).to_s, "DEBUG-10"
  assert_eq Level.new(n: -14).marshal_json, "\"DEBUG-10\""
  assert_eq parse_level("DEBUG-10").unwrap.n, -14
  assert_eq Level.new(n: -13).to_s, "DEBUG-9"
  assert_eq Level.new(n: -13).marshal_json, "\"DEBUG-9\""
  assert_eq parse_level("DEBUG-9").unwrap.n, -13
  assert_eq Level.new(n: -12).to_s, "DEBUG-8"
  assert_eq Level.new(n: -12).marshal_json, "\"DEBUG-8\""
  assert_eq parse_level("DEBUG-8").unwrap.n, -12
  assert_eq Level.new(n: -11).to_s, "DEBUG-7"
  assert_eq Level.new(n: -11).marshal_json, "\"DEBUG-7\""
  assert_eq parse_level("DEBUG-7").unwrap.n, -11
  assert_eq Level.new(n: -10).to_s, "DEBUG-6"
  assert_eq Level.new(n: -10).marshal_json, "\"DEBUG-6\""
  assert_eq parse_level("DEBUG-6").unwrap.n, -10
  assert_eq Level.new(n: -9).to_s, "DEBUG-5"
  assert_eq Level.new(n: -9).marshal_json, "\"DEBUG-5\""
  assert_eq parse_level("DEBUG-5").unwrap.n, -9
  assert_eq Level.new(n: -8).to_s, "DEBUG-4"
  assert_eq Level.new(n: -8).marshal_json, "\"DEBUG-4\""
  assert_eq parse_level("DEBUG-4").unwrap.n, -8
  assert_eq Level.new(n: -7).to_s, "DEBUG-3"
  assert_eq Level.new(n: -7).marshal_json, "\"DEBUG-3\""
  assert_eq parse_level("DEBUG-3").unwrap.n, -7
  assert_eq Level.new(n: -6).to_s, "DEBUG-2"
  assert_eq Level.new(n: -6).marshal_json, "\"DEBUG-2\""
  assert_eq parse_level("DEBUG-2").unwrap.n, -6
  assert_eq Level.new(n: -5).to_s, "DEBUG-1"
  assert_eq Level.new(n: -5).marshal_json, "\"DEBUG-1\""
  assert_eq parse_level("DEBUG-1").unwrap.n, -5
  assert_eq Level.new(n: -4).to_s, "DEBUG"
  assert_eq Level.new(n: -4).marshal_json, "\"DEBUG\""
  assert_eq parse_level("DEBUG").unwrap.n, -4
  assert_eq Level.new(n: -3).to_s, "DEBUG+1"
  assert_eq Level.new(n: -3).marshal_json, "\"DEBUG+1\""
  assert_eq parse_level("DEBUG+1").unwrap.n, -3
  assert_eq Level.new(n: -2).to_s, "DEBUG+2"
  assert_eq Level.new(n: -2).marshal_json, "\"DEBUG+2\""
  assert_eq parse_level("DEBUG+2").unwrap.n, -2
  assert_eq Level.new(n: -1).to_s, "DEBUG+3"
  assert_eq Level.new(n: -1).marshal_json, "\"DEBUG+3\""
  assert_eq parse_level("DEBUG+3").unwrap.n, -1
  assert_eq Level.new(n: 0).to_s, "INFO"
  assert_eq Level.new(n: 0).marshal_json, "\"INFO\""
  assert_eq parse_level("INFO").unwrap.n, 0
  assert_eq Level.new(n: 1).to_s, "INFO+1"
  assert_eq Level.new(n: 1).marshal_json, "\"INFO+1\""
  assert_eq parse_level("INFO+1").unwrap.n, 1
  assert_eq Level.new(n: 2).to_s, "INFO+2"
