  assert_eq text_line(2, [wg("g")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "msg=message g.x.n.first=p g.x.n.last=q g.x.y.a=9"
  assert_eq json_line(2, [wg("g")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"g\":{\"x\":{\"n\":{\"first\":\"p\",\"last\":\"q\"},\"y\":{\"a\":9}}}}"
  assert_eq text_line(2, [wg("g")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "msg=message g.a=1 g.a=2 \"g.\"=\"empty key\""
  assert_eq json_line(2, [wg("g")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"msg\":\"message\",\"g\":{\"a\":1,\"a\":2,\"\":\"empty key\"}}"
  assert_eq text_line(2, [wg("g")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "msg=message g.g.a=1 g.g.b=2"
  assert_eq json_line(2, [wg("g")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"g\":{\"g\":{\"a\":1},\"g\":{\"b\":2}}}"
  assert_eq text_line(2, [wg("g")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "msg=message g.i.c=3"
  assert_eq json_line(2, [wg("g")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"g\":{\"i\":{\"c\":3}}}"
  assert_eq text_line(2, [wg("g")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "msg=message g.c=3"
  assert_eq json_line(2, [wg("g")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"g\":{\"c\":3}}"
  assert_eq text_line(2, [wg("g")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "msg=message g.z=26"
  assert_eq json_line(2, [wg("g")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"msg\":\"message\",\"g\":{\"z\":26}}"
}

test "shapes 19" {
  assert_eq text_line(2, [wa([])], [], test_time, level_info, "message"), "msg=message"
  assert_eq json_line(2, [wa([])], [], test_time, level_info, "message"), "{\"msg\":\"message\"}"
  assert_eq text_line(2, [wa([])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "msg=message a=one b=2"
  assert_eq json_line(2, [wa([])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"msg\":\"message\",\"a\":\"one\",\"b\":2}"
  assert_eq text_line(2, [wa([])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "msg=message a=1 g.b=2 g.h.c=3 g.d=4 e=5"
  assert_eq json_line(2, [wa([])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"msg\":\"message\",\"a\":1,\"g\":{\"b\":2,\"h\":{\"c\":3},\"d\":4},\"e\":5}"
  assert_eq text_line(2, [wa([])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "msg=message h.a=1"
  assert_eq json_line(2, [wa([])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"h\":{\"a\":1}}"
  assert_eq text_line(2, [wa([])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "msg=message"
  assert_eq json_line(2, [wa([])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"msg\":\"message\"}"
  assert_eq text_line(2, [wa([])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "msg=message g.h.j.a=1"
  assert_eq json_line(2, [wa([])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"g\":{\"h\":{\"j\":{\"a\":1}}}}"
