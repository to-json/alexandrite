  assert_eq text_line(6, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message p1=1 s1.p2=2 s1.s2.i.c=3"
  assert_eq json_line(6, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"i\":{\"c\":3}}}}"
  assert_eq text_line(6, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message p1=1 s1.p2=2 s1.s2.c=3"
  assert_eq json_line(6, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"c\":3}}}"
  assert_eq text_line(6, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message p1=1 s1.p2=2 s1.s2.z=26"
