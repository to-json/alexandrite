  assert_eq json_line(1, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"nm\":{\"FIRST\":\"a\",\"LAST\":\"b\"},\"G\":{\"H\":{\"C\":1,\"n2\":{\"FIRST\":\"c\",\"LAST\":\"d\"}},\"x\":{\"n\":{\"FIRST\":\"p\",\"LAST\":\"q\"},\"y\":{\"A\":9}}}}"
