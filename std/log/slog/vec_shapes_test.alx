  assert_eq text_line(6, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message g.a=1 g.n=4 g.h.b=2 \"g.h.a b\"=\"x\\t\\n\\x00y\" \"g.h. b.c=\\\"\\\\x2E\\t.d=e\"=\"f.g\\\"\" \"g.h. b.c=\\\"\\\\x2E\\t.m.d\"=1"
  assert_eq json_line(6, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"g\":{\"a\":1,\"n\":4,\"h\":{\"b\":2,\"a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"d=e\":\"f.g\\\"\",\"m.d\":1}}}}"
  assert_eq text_line(6, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message g.a=1 g.n=4 g.h.b=2 g.h.a=1 g.h.name.first=Ren g.h.name.last=Hoek g.h.b=2"
  assert_eq json_line(6, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"g\":{\"a\":1,\"n\":4,\"h\":{\"b\":2,\"a\":1,\"name\":{\"first\":\"Ren\",\"last\":\"Hoek\"},\"b\":2}}}"
}

test "shapes 44" {
  assert_eq text_line(6, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message g.a=1 g.n=4 g.h.b=2 g.h.a=1 g.h.b=2 g.h.c=3 g.h.d=4"
  assert_eq json_line(6, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"g\":{\"a\":1,\"n\":4,\"h\":{\"b\":2,\"a\":1,\"b\":2,\"c\":3,\"d\":4}}}"
  assert_eq text_line(6, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message g.a=1 g.n=4 g.h.b=2 \"g.h.prefix. needs quoting \"=v g.h.prefix.NotNeedsQuoting=v \"g.h.prefix needs quoting. needs quoting \"=v \"g.h.prefix needs quoting.NotNeedsQuoting\"=v"
  assert_eq json_line(6, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"g\":{\"a\":1,\"n\":4,\"h\":{\"b\":2,\"prefix\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"}}}}"
  assert_eq text_line(6, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message g.a=1 g.n=4 g.h.b=2 g.h.g.a=1"
