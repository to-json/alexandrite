  assert_eq text_line(5, [wg("g")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "level=INFO msg=message g.a=Int64 g.name.first=String g.name.last=String g.b=Int64"
  assert_eq json_line(5, [wg("g")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"a\":\"Int64\",\"name\":{\"first\":\"String\",\"last\":\"String\"},\"b\":\"Int64\"}}"
