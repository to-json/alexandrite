  assert_eq text_line(4, [], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "level=INFO msg=message b=2"
  assert_eq json_line(4, [], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"b\":2}"
  assert_eq text_line(4, [], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "level=INFO msg=message g.g:b=2 g.h.g/h:c=3 g.g:d=4 e=5"
  assert_eq json_line(4, [], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:b\":2,\"h\":{\"g/h:c\":3},\"g:d\":4},\"e\":5}"
  assert_eq text_line(4, [], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
}

test "shapes 27" {
  assert_eq text_line(4, [], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "level=INFO msg=message \"a b\"=\"x\\t\\n\\x00y\" \" b.c=\\\"\\\\x2E\\t. b.c=\\\"\\\\x2E\\t:d=e\"=\"f.g\\\"\" \" b.c=\\\"\\\\x2E\\t. b.c=\\\"\\\\x2E\\t:m.d\"=1"
  assert_eq json_line(4, [], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\" b.c=\\\"\\\\x2E\\t:d=e\":\"f.g\\\"\",\" b.c=\\\"\\\\x2E\\t:m.d\":1}}"
  assert_eq text_line(4, [], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "level=INFO msg=message name.name:first=Ren name.name:last=Hoek b=2"
