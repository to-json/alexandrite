  assert_eq text_line(3, [wg("g"), wa([int64("a", 1)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("g"), wa([int64("a", 1)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{}"
