  assert_eq text_line(6, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message p1=1 s1.s2.c=3"
  assert_eq json_line(6, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"c\":3}}}"
