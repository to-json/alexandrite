  assert_eq json_line(6, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"g\":{\"a\":1,\"n\":4,\"h\":{\"b\":2,\"a\":1,\"b\":2}}}"
