  assert_eq json_line(6, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"a\":\"one\",\"b\":2}}}"
  assert_eq text_line(6, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.a=1 s1.s2.g.b=2 s1.s2.g.h.c=3 s1.s2.g.d=4 s1.s2.e=5"
  assert_eq json_line(6, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"a\":1,\"g\":{\"b\":2,\"h\":{\"c\":3},\"d\":4},\"e\":5}}}"
  assert_eq text_line(6, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.h.a=1"
  assert_eq json_line(6, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"h\":{\"a\":1}}}}"
