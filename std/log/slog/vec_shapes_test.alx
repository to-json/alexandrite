  assert_eq json_line(5, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":\"Int64\",\"s1\":{\"s2\":{\"a b\":\"String\",\" b.c=\\\"\\\\x2E\\t\":{\"d=e\":\"String\",\"m.d\":\"Int64\"}}}}"
  assert_eq text_line(5, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "level=INFO msg=message p1=Int64 s1.s2.a=Int64 s1.s2.name.first=String s1.s2.name.last=String s1.s2.b=Int64"
  assert_eq json_line(5, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":\"Int64\",\"s1\":{\"s2\":{\"a\":\"Int64\",\"name\":{\"first\":\"String\",\"last\":\"String\"},\"b\":\"Int64\"}}}"
}

test "shapes 35" {
  assert_eq text_line(5, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "level=INFO msg=message p1=Int64 s1.s2.a=Int64 s1.s2.b=Int64 s1.s2.c=Int64 s1.s2.d=Int64"
