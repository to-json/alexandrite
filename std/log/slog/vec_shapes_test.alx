test "shapes 13" {
  assert_eq text_line(1, [wa([group("e", [])])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message \"A B\"=\"x\\t\\n\\x00y\" \" b.c=\\\"\\\\x2E\\t.D=E\"=\"f.g\\\"\" \" b.c=\\\"\\\\x2E\\t.M.D\"=1"
  assert_eq json_line(1, [wa([group("e", [])])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"A B\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"D=E\":\"f.g\\\"\",\"M.D\":1}}"
  assert_eq text_line(1, [wa([group("e", [])])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message A=1 name.FIRST=Ren name.LAST=Hoek B=2"
  assert_eq json_line(1, [wa([group("e", [])])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"A\":1,\"name\":{\"FIRST\":\"Ren\",\"LAST\":\"Hoek\"},\"B\":2}"
  assert_eq text_line(1, [wa([group("e", [])])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message A=1 B=2 C=3 D=4"
  assert_eq json_line(1, [wa([group("e", [])])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"A\":1,\"B\":2,\"C\":3,\"D\":4}"
  assert_eq text_line(1, [wa([group("e", [])])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message \"prefix. NEEDS QUOTING \"=v prefix.NOTNEEDSQUOTING=v \"prefix needs quoting. NEEDS QUOTING \"=v \"prefix needs quoting.NOTNEEDSQUOTING\"=v"
  assert_eq json_line(1, [wa([group("e", [])])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"prefix\":{\" NEEDS QUOTING \":\"v\",\"NOTNEEDSQUOTING\":\"v\"},\"prefix needs quoting\":{\" NEEDS QUOTING \":\"v\",\"NOTNEEDSQUOTING\":\"v\"}}"
