  assert_eq json_line(6, [wg("x"), wa([int64("a", 1)]), wg("y")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"a\":\"one\",\"b\":2}}}"
