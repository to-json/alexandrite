  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2 \"s1.s2.prefix.s1/s2/prefix: needs quoting \"=v s1.s2.prefix.s1/s2/prefix:NotNeedsQuoting=v \"s1.s2.prefix needs quoting.s1/s2/prefix needs quoting: needs quoting \"=v \"s1.s2.prefix needs quoting.s1/s2/prefix needs quoting:NotNeedsQuoting\"=v"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"prefix\":{\"s1/s2/prefix: needs quoting \":\"v\",\"s1/s2/prefix:NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\"s1/s2/prefix needs quoting: needs quoting \":\"v\",\"s1/s2/prefix needs quoting:NotNeedsQuoting\":\"v\"}}}}"
