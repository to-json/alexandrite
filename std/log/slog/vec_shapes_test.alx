test "shapes 24" {
  assert_eq text_line(3, [wg("g"), wa([int64("a", 1)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("g"), wa([int64("a", 1)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("g"), wa([int64("a", 1)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("g"), wa([int64("a", 1)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("g"), wa([int64("a", 1)]), wg("h"), wa([int64("b", 2)])], [], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("g"), wa([int64("a", 1)]), wg("h"), wa([int64("b", 2)])], [], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("g"), wa([int64("a", 1)]), wg("h"), wa([int64("b", 2)])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("g"), wa([int64("a", 1)]), wg("h"), wa([int64("b", 2)])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("g"), wa([int64("a", 1)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("g"), wa([int64("a", 1)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("g"), wa([int64("a", 1)]), wg("h"), wa([int64("b", 2)])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), ""
