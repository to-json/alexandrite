  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2 s1.s2.s1/s2:p3=3 s1.s2.x.n.s1/s2/x/n:first=p s1.s2.x.n.s1/s2/x/n:last=q s1.s2.x.y.s1/s2/x/y:=<nil>"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"s1/s2:p3\":3,\"x\":{\"n\":{\"s1/s2/x/n:first\":\"p\",\"s1/s2/x/n:last\":\"q\"},\"y\":{\"s1/s2/x/y:\":null}}}}}"
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2 s1.s2.s1/s2:p3=3 s1.s2.s1/s2:=\"empty key\""
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"s1/s2:p3\":3,\"s1/s2:\":\"empty key\"}}}"
}

test "shapes 29" {
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2 s1.s2.s1/s2:p3=3 s1.s2.g.g.s1/s2/g/g:b=2"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"s1/s2:p3\":3\"g\":{\"s1/s2/g/g:b\":2}}}}"
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2 s1.s2.s1/s2:p3=3 s1.s2.i.s1/s2/i:c=3"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"s1/s2:p3\":3,\"i\":{\"s1/s2/i:c\":3}}}}"
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2 s1.s2.s1/s2:p3=3 s1.s2.s1/s2:c=3"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"s1/s2:p3\":3,\"s1/s2:c\":3}}}"
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2 s1.s2.s1/s2:p3=3 s1.s2.s1/s2:z=26"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"s1/s2:p3\":3,\"s1/s2:z\":26}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("x"), wg("y")], [], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("x"), wg("y")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "level=INFO msg=message x.y.x/y:b=2 x.y.x/y:=<nil>"
  assert_eq json_line(4, [wg("x"), wg("y")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:b\":2,\"x/y:\":null}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "level=INFO msg=message x.y.g.x/y/g:b=2 x.y.g.h.x/y/g/h:c=3 x.y.g.x/y/g:d=4 x.y.x/y:e=5"
  assert_eq json_line(4, [wg("x"), wg("y")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"g\":{\"x/y/g:b\":2,\"h\":{\"x/y/g/h:c\":3},\"x/y/g:d\":4},\"x/y:e\":5}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("x"), wg("y")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("x"), wg("y")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("x"), wg("y")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("x"), wg("y")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("x"), wg("y")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("x"), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "level=INFO msg=message \"x.y.x/y:a b\"=\"x\\t\\n\\x00y\" \"x.y. b.c=\\\"\\\\x2E\\t.x/y/ b.c=\\\"\\\\x2E\\t:d=e\"=\"f.g\\\"\" \"x.y. b.c=\\\"\\\\x2E\\t.x/y/ b.c=\\\"\\\\x2E\\t:m.d\"=1"
  assert_eq json_line(4, [wg("x"), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"x/y/ b.c=\\\"\\\\x2E\\t:d=e\":\"f.g\\\"\",\"x/y/ b.c=\\\"\\\\x2E\\t:m.d\":1}}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "level=INFO msg=message x.y.name.x/y/name:first=Ren x.y.name.x/y/name:last=Hoek x.y.x/y:b=2"
  assert_eq json_line(4, [wg("x"), wg("y")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"name\":{\"x/y/name:first\":\"Ren\",\"x/y/name:last\":\"Hoek\"},\"x/y:b\":2}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "level=INFO msg=message x.y.x/y:b=2 x.y.x/y:c=3 x.y.x/y:d=4"
  assert_eq json_line(4, [wg("x"), wg("y")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:b\":2,\"x/y:c\":3,\"x/y:d\":4}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "level=INFO msg=message \"x.y.prefix.x/y/prefix: needs quoting \"=v x.y.prefix.x/y/prefix:NotNeedsQuoting=v \"x.y.prefix needs quoting.x/y/prefix needs quoting: needs quoting \"=v \"x.y.prefix needs quoting.x/y/prefix needs quoting:NotNeedsQuoting\"=v"
  assert_eq json_line(4, [wg("x"), wg("y")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"prefix\":{\"x/y/prefix: needs quoting \":\"v\",\"x/y/prefix:NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\"x/y/prefix needs quoting: needs quoting \":\"v\",\"x/y/prefix needs quoting:NotNeedsQuoting\":\"v\"}}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("x"), wg("y")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("x"), wg("y")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "level=INFO msg=message x.y.x/y:b=2"
  assert_eq json_line(4, [wg("x"), wg("y")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:b\":2}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "level=INFO msg=message x.y.x.n.x/y/x/n:first=p x.y.x.n.x/y/x/n:last=q x.y.x.y.x/y/x/y:=<nil>"
  assert_eq json_line(4, [wg("x"), wg("y")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x\":{\"n\":{\"x/y/x/n:first\":\"p\",\"x/y/x/n:last\":\"q\"},\"y\":{\"x/y/x/y:\":null}}}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "level=INFO msg=message x.y.x/y:=\"empty key\""
  assert_eq json_line(4, [wg("x"), wg("y")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:\":\"empty key\"}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "level=INFO msg=message x.y.g.g.x/y/g/g:b=2"
  assert_eq json_line(4, [wg("x"), wg("y")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"g\":{\"x/y/g/g:b\":2}}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message x.y.i.x/y/i:c=3"
  assert_eq json_line(4, [wg("x"), wg("y")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"i\":{\"x/y/i:c\":3}}}}"
  assert_eq text_line(4, [wg("x"), wg("y")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message x.y.x/y:c=3"
  assert_eq json_line(4, [wg("x"), wg("y")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:c\":3}}}"
