  assert_eq json_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"x\":\"Int64\",\"a\":\"Int64\",\"n\":\"Int64\",\"h\":{\"b\":\"Int64\",\"a\":\"Int64\",\"b\":\"Int64\"}}}"
  assert_eq text_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "level=INFO msg=message g.x=Int64 g.a=Int64 g.n=Int64 g.h.b=Int64 g.h.x.n.first=String g.h.x.n.last=String \"g.h.x.y.\"=Any g.h.x.y.a=Int64"
  assert_eq json_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"x\":\"Int64\",\"a\":\"Int64\",\"n\":\"Int64\",\"h\":{\"b\":\"Int64\",\"x\":{\"n\":{\"first\":\"String\",\"last\":\"String\"},\"y\":{\"\":\"Any\",\"a\":\"Int64\"}}}}}"
  assert_eq text_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "level=INFO msg=message g.x=Int64 g.a=Int64 g.n=Int64 g.h.b=Int64 g.h.a=Int64 g.h.a=Int64 \"g.h.\"=String"
  assert_eq json_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"x\":\"Int64\",\"a\":\"Int64\",\"n\":\"Int64\",\"h\":{\"b\":\"Int64\",\"a\":\"Int64\",\"a\":\"Int64\",\"\":\"String\"}}}"
}

test "shapes 38" {
  assert_eq text_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "level=INFO msg=message g.x=Int64 g.a=Int64 g.n=Int64 g.h.b=Int64 g.h.g.a=Int64 g.h.g.b=Int64"
  assert_eq json_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"x\":\"Int64\",\"a\":\"Int64\",\"n\":\"Int64\",\"h\":{\"b\":\"Int64\",\"g\":{\"a\":\"Int64\"},\"g\":{\"b\":\"Int64\"}}}}"
  assert_eq text_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message g.x=Int64 g.a=Int64 g.n=Int64 g.h.b=Int64 g.h.i.c=Int64"
  assert_eq json_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"x\":\"Int64\",\"a\":\"Int64\",\"n\":\"Int64\",\"h\":{\"b\":\"Int64\",\"i\":{\"c\":\"Int64\"}}}}"
  assert_eq text_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message g.x=Int64 g.a=Int64 g.n=Int64 g.h.b=Int64 g.h.c=Int64"
  assert_eq json_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"x\":\"Int64\",\"a\":\"Int64\",\"n\":\"Int64\",\"h\":{\"b\":\"Int64\",\"c\":\"Int64\"}}}"
  assert_eq text_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "level=INFO msg=message g.x=Int64 g.a=Int64 g.n=Int64 g.h.b=Int64 g.h.z=Int64"
  assert_eq json_line(5, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"x\":\"Int64\",\"a\":\"Int64\",\"n\":\"Int64\",\"h\":{\"b\":\"Int64\",\"z\":\"Int64\"}}}"
  assert_eq text_line(5, [wg("g")], [], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(5, [wg("g")], [], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(5, [wg("g")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "level=INFO msg=message g.a=String g.b=Int64 \"g.\"=Any"
  assert_eq json_line(5, [wg("g")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"a\":\"String\",\"b\":\"Int64\",\"\":\"Any\"}}"
  assert_eq text_line(5, [wg("g")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "level=INFO msg=message g.a=Int64 g.g.b=Int64 g.g.h.c=Int64 g.g.d=Int64 g.e=Int64"
  assert_eq json_line(5, [wg("g")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"a\":\"Int64\",\"g\":{\"b\":\"Int64\",\"h\":{\"c\":\"Int64\"},\"d\":\"Int64\"},\"e\":\"Int64\"}}"
