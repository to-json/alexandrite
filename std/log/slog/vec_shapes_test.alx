  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.g.h.j.A=1"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"g\":{\"h\":{\"j\":{\"A\":1}}}}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 \"g.h.A B\"=\"x\\t\\n\\x00y\" \"g.h. b.c=\\\"\\\\x2E\\t.D=E\"=\"f.g\\\"\" \"g.h. b.c=\\\"\\\\x2E\\t.M.D\"=1"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"A B\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"D=E\":\"f.g\\\"\",\"M.D\":1}}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.A=1 g.h.name.FIRST=Ren g.h.name.LAST=Hoek g.h.B=2"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"A\":1,\"name\":{\"FIRST\":\"Ren\",\"LAST\":\"Hoek\"},\"B\":2}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.A=1 g.h.B=2 g.h.C=3 g.h.D=4"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"A\":1,\"B\":2,\"C\":3,\"D\":4}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 \"g.h.prefix. NEEDS QUOTING \"=v g.h.prefix.NOTNEEDSQUOTING=v \"g.h.prefix needs quoting. NEEDS QUOTING \"=v \"g.h.prefix needs quoting.NOTNEEDSQUOTING\"=v"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"prefix\":{\" NEEDS QUOTING \":\"v\",\"NOTNEEDSQUOTING\":\"v\"},\"prefix needs quoting\":{\" NEEDS QUOTING \":\"v\",\"NOTNEEDSQUOTING\":\"v\"}}}}"
}

test "shapes 12" {
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.g.A=1"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"g\":{\"A\":1}}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.A=1 g.h.B=2"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"A\":1,\"B\":2}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.x.n.FIRST=p g.h.x.n.LAST=q g.h.x.y.A=9"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"x\":{\"n\":{\"FIRST\":\"p\",\"LAST\":\"q\"},\"y\":{\"A\":9}}}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.A=1 g.h.A=2 \"g.h.\"=\"empty key\""
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"A\":1,\"A\":2,\"\":\"empty key\"}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.g.A=1 g.h.g.B=2"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"g\":{\"A\":1},\"g\":{\"B\":2}}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.i.C=3"
