test "shapes 25" {
  assert_eq text_line(3, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), ""
