  assert_eq json_line(5, [wg("g")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"h\":{\"a\":\"Int64\"}}}"
