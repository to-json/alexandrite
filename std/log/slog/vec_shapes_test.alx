  assert_eq json_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:x\":0,\"g:n\":4,\"h\":{\"g/h:b\":2,\"prefix\":{\"g/h/prefix: needs quoting \":\"v\",\"g/h/prefix:NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\"g/h/prefix needs quoting: needs quoting \":\"v\",\"g/h/prefix needs quoting:NotNeedsQuoting\":\"v\"}}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message g.g:x=0 g.g:n=4 g.h.g/h:b=2"
  assert_eq json_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:x\":0,\"g:n\":4,\"h\":{\"g/h:b\":2}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "level=INFO msg=message g.g:x=0 g.g:n=4 g.h.g/h:b=2 g.h.g/h:b=2"
  assert_eq json_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:x\":0,\"g:n\":4,\"h\":{\"g/h:b\":2,\"g/h:b\":2}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "level=INFO msg=message g.g:x=0 g.g:n=4 g.h.g/h:b=2 g.h.x.n.g/h/x/n:first=p g.h.x.n.g/h/x/n:last=q g.h.x.y.g/h/x/y:=<nil>"
  assert_eq json_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:x\":0,\"g:n\":4,\"h\":{\"g/h:b\":2,\"x\":{\"n\":{\"g/h/x/n:first\":\"p\",\"g/h/x/n:last\":\"q\"},\"y\":{\"g/h/x/y:\":null}}}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "level=INFO msg=message g.g:x=0 g.g:n=4 g.h.g/h:b=2 g.h.g/h:=\"empty key\""
  assert_eq json_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:x\":0,\"g:n\":4,\"h\":{\"g/h:b\":2,\"g/h:\":\"empty key\"}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "level=INFO msg=message g.g:x=0 g.g:n=4 g.h.g/h:b=2 g.h.g.g.g/h/g/g:b=2"
  assert_eq json_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:x\":0,\"g:n\":4,\"h\":{\"g/h:b\":2\"g\":{\"g/h/g/g:b\":2}}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message g.g:x=0 g.g:n=4 g.h.g/h:b=2 g.h.i.g/h/i:c=3"
  assert_eq json_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:x\":0,\"g:n\":4,\"h\":{\"g/h:b\":2,\"i\":{\"g/h/i:c\":3}}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message g.g:x=0 g.g:n=4 g.h.g/h:b=2 g.h.g/h:c=3"
  assert_eq json_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:x\":0,\"g:n\":4,\"h\":{\"g/h:b\":2,\"g/h:c\":3}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "level=INFO msg=message g.g:x=0 g.g:n=4 g.h.g/h:b=2 g.h.g/h:z=26"
  assert_eq json_line(4, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:x\":0,\"g:n\":4,\"h\":{\"g/h:b\":2,\"g/h:z\":26}}}"
  assert_eq text_line(4, [wg("g")], [], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("g")], [], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("g")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "level=INFO msg=message g.g:b=2 g.g:=<nil>"
  assert_eq json_line(4, [wg("g")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:b\":2,\"g:\":null}}"
  assert_eq text_line(4, [wg("g")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "level=INFO msg=message g.g.g/g:b=2 g.g.h.g/g/h:c=3 g.g.g/g:d=4 g.g:e=5"
  assert_eq json_line(4, [wg("g")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g\":{\"g/g:b\":2,\"h\":{\"g/g/h:c\":3},\"g/g:d\":4},\"g:e\":5}}"
  assert_eq text_line(4, [wg("g")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("g")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("g")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("g")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("g")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("g")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("g")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "level=INFO msg=message \"g.g:a b\"=\"x\\t\\n\\x00y\" \"g. b.c=\\\"\\\\x2E\\t.g/ b.c=\\\"\\\\x2E\\t:d=e\"=\"f.g\\\"\" \"g. b.c=\\\"\\\\x2E\\t.g/ b.c=\\\"\\\\x2E\\t:m.d\"=1"
  assert_eq json_line(4, [wg("g")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"g/ b.c=\\\"\\\\x2E\\t:d=e\":\"f.g\\\"\",\"g/ b.c=\\\"\\\\x2E\\t:m.d\":1}}}"
  assert_eq text_line(4, [wg("g")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "level=INFO msg=message g.name.g/name:first=Ren g.name.g/name:last=Hoek g.g:b=2"
  assert_eq json_line(4, [wg("g")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"name\":{\"g/name:first\":\"Ren\",\"g/name:last\":\"Hoek\"},\"g:b\":2}}"
  assert_eq text_line(4, [wg("g")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "level=INFO msg=message g.g:b=2 g.g:c=3 g.g:d=4"
  assert_eq json_line(4, [wg("g")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:b\":2,\"g:c\":3,\"g:d\":4}}"
  assert_eq text_line(4, [wg("g")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "level=INFO msg=message \"g.prefix.g/prefix: needs quoting \"=v g.prefix.g/prefix:NotNeedsQuoting=v \"g.prefix needs quoting.g/prefix needs quoting: needs quoting \"=v \"g.prefix needs quoting.g/prefix needs quoting:NotNeedsQuoting\"=v"
  assert_eq json_line(4, [wg("g")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"prefix\":{\"g/prefix: needs quoting \":\"v\",\"g/prefix:NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\"g/prefix needs quoting: needs quoting \":\"v\",\"g/prefix needs quoting:NotNeedsQuoting\":\"v\"}}}"
  assert_eq text_line(4, [wg("g")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("g")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("g")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "level=INFO msg=message g.g:b=2"
  assert_eq json_line(4, [wg("g")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:b\":2}}"
  assert_eq text_line(4, [wg("g")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "level=INFO msg=message g.x.n.g/x/n:first=p g.x.n.g/x/n:last=q g.x.y.g/x/y:=<nil>"
  assert_eq json_line(4, [wg("g")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"x\":{\"n\":{\"g/x/n:first\":\"p\",\"g/x/n:last\":\"q\"},\"y\":{\"g/x/y:\":null}}}}"
  assert_eq text_line(4, [wg("g")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "level=INFO msg=message g.g:=\"empty key\""
  assert_eq json_line(4, [wg("g")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:\":\"empty key\"}}"
  assert_eq text_line(4, [wg("g")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "level=INFO msg=message g.g.g.g/g/g:b=2"
  assert_eq json_line(4, [wg("g")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g\":{\"g/g/g:b\":2}}}"
  assert_eq text_line(4, [wg("g")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message g.i.g/i:c=3"
  assert_eq json_line(4, [wg("g")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"i\":{\"g/i:c\":3}}}"
  assert_eq text_line(4, [wg("g")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message g.g:c=3"
  assert_eq json_line(4, [wg("g")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:c\":3}}"
  assert_eq text_line(4, [wg("g")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "level=INFO msg=message g.g:z=26"
  assert_eq json_line(4, [wg("g")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:z\":26}}"
  assert_eq text_line(4, [wa([])], [], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wa([])], [], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wa([])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "level=INFO msg=message b=2"
  assert_eq json_line(4, [wa([])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"b\":2}"
}

test "shapes 32" {
  assert_eq text_line(4, [wa([])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "level=INFO msg=message g.g:b=2 g.h.g/h:c=3 g.g:d=4 e=5"
  assert_eq json_line(4, [wa([])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:b\":2,\"h\":{\"g/h:c\":3},\"g:d\":4},\"e\":5}"
  assert_eq text_line(4, [wa([])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wa([])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wa([])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wa([])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wa([])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wa([])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wa([])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "level=INFO msg=message \"a b\"=\"x\\t\\n\\x00y\" \" b.c=\\\"\\\\x2E\\t. b.c=\\\"\\\\x2E\\t:d=e\"=\"f.g\\\"\" \" b.c=\\\"\\\\x2E\\t. b.c=\\\"\\\\x2E\\t:m.d\"=1"
  assert_eq json_line(4, [wa([])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\" b.c=\\\"\\\\x2E\\t:d=e\":\"f.g\\\"\",\" b.c=\\\"\\\\x2E\\t:m.d\":1}}"
  assert_eq text_line(4, [wa([])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "level=INFO msg=message name.name:first=Ren name.name:last=Hoek b=2"
  assert_eq json_line(4, [wa([])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"name\":{\"name:first\":\"Ren\",\"name:last\":\"Hoek\"},\"b\":2}"
  assert_eq text_line(4, [wa([])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "level=INFO msg=message b=2 c=3 d=4"
  assert_eq json_line(4, [wa([])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"b\":2,\"c\":3,\"d\":4}"
  assert_eq text_line(4, [wa([])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "level=INFO msg=message \"prefix.prefix: needs quoting \"=v prefix.prefix:NotNeedsQuoting=v \"prefix needs quoting.prefix needs quoting: needs quoting \"=v \"prefix needs quoting.prefix needs quoting:NotNeedsQuoting\"=v"
  assert_eq json_line(4, [wa([])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"prefix\":{\"prefix: needs quoting \":\"v\",\"prefix:NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\"prefix needs quoting: needs quoting \":\"v\",\"prefix needs quoting:NotNeedsQuoting\":\"v\"}}"
  assert_eq text_line(4, [wa([])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wa([])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
