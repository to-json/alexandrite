  assert_eq json_line(5, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":\"Int64\",\"s1\":{\"s2\":{\"prefix\":{\" needs quoting \":\"String\",\"NotNeedsQuoting\":\"String\"},\"prefix needs quoting\":{\" needs quoting \":\"String\",\"NotNeedsQuoting\":\"String\"}}}}"
