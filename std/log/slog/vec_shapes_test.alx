  assert_eq text_line(4, [wa([int64("pre", 0)]), wg("s")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message pre=0"
  assert_eq json_line(4, [wa([int64("pre", 0)]), wg("s")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"pre\":0}"
  assert_eq text_line(4, [wa([int64("pre", 0)]), wg("s")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "level=INFO msg=message pre=0 s.s:b=2"
  assert_eq json_line(4, [wa([int64("pre", 0)]), wg("s")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"pre\":0,\"s\":{\"s:b\":2}}"
  assert_eq text_line(4, [wa([int64("pre", 0)]), wg("s")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "level=INFO msg=message pre=0 s.x.n.s/x/n:first=p s.x.n.s/x/n:last=q s.x.y.s/x/y:=<nil>"
  assert_eq json_line(4, [wa([int64("pre", 0)]), wg("s")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"pre\":0,\"s\":{\"x\":{\"n\":{\"s/x/n:first\":\"p\",\"s/x/n:last\":\"q\"},\"y\":{\"s/x/y:\":null}}}}"
  assert_eq text_line(4, [wa([int64("pre", 0)]), wg("s")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "level=INFO msg=message pre=0 s.s:=\"empty key\""
  assert_eq json_line(4, [wa([int64("pre", 0)]), wg("s")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"pre\":0,\"s\":{\"s:\":\"empty key\"}}"
  assert_eq text_line(4, [wa([int64("pre", 0)]), wg("s")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "level=INFO msg=message pre=0 s.g.g.s/g/g:b=2"
  assert_eq json_line(4, [wa([int64("pre", 0)]), wg("s")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"pre\":0,\"s\":{\"g\":{\"s/g/g:b\":2}}}"
  assert_eq text_line(4, [wa([int64("pre", 0)]), wg("s")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message pre=0 s.i.s/i:c=3"
  assert_eq json_line(4, [wa([int64("pre", 0)]), wg("s")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"pre\":0,\"s\":{\"i\":{\"s/i:c\":3}}}"
  assert_eq text_line(4, [wa([int64("pre", 0)]), wg("s")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message pre=0 s.s:c=3"
  assert_eq json_line(4, [wa([int64("pre", 0)]), wg("s")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"pre\":0,\"s\":{\"s:c\":3}}"
  assert_eq text_line(4, [wa([int64("pre", 0)]), wg("s")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "level=INFO msg=message pre=0 s.s:z=26"
  assert_eq json_line(4, [wa([int64("pre", 0)]), wg("s")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"pre\":0,\"s\":{\"s:z\":26}}"
}

test "shapes 28" {
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2}}"
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2 s1.s2.s1/s2:b=2 s1.s2.s1/s2:=<nil>"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"s1/s2:b\":2,\"s1/s2:\":null}}}"
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2 s1.s2.g.s1/s2/g:b=2 s1.s2.g.h.s1/s2/g/h:c=3 s1.s2.g.s1/s2/g:d=4 s1.s2.s1/s2:e=5"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"g\":{\"s1/s2/g:b\":2,\"h\":{\"s1/s2/g/h:c\":3},\"s1/s2/g:d\":4},\"s1/s2:e\":5}}}"
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2}}"
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2}}"
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2}}"
  assert_eq text_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "level=INFO msg=message p1=1 s1.s1:p2=2 \"s1.s2.s1/s2:a b\"=\"x\\t\\n\\x00y\" \"s1.s2. b.c=\\\"\\\\x2E\\t.s1/s2/ b.c=\\\"\\\\x2E\\t:d=e\"=\"f.g\\\"\" \"s1.s2. b.c=\\\"\\\\x2E\\t.s1/s2/ b.c=\\\"\\\\x2E\\t:m.d\"=1"
  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"s1/s2:a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"s1/s2/ b.c=\\\"\\\\x2E\\t:d=e\":\"f.g\\\"\",\"s1/s2/ b.c=\\\"\\\\x2E\\t:m.d\":1}}}}"
