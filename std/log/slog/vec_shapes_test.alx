  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.h.A=1"
