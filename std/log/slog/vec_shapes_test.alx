  assert_eq json_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"g\":{\"h\":{\"j\":{\"a\":\"Int64\"}}}}}}"
  assert_eq text_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "level=INFO msg=message \"x.y.a b\"=String \"x.y. b.c=\\\"\\\\x2E\\t.d=e\"=String \"x.y. b.c=\\\"\\\\x2E\\t.m.d\"=Int64"
  assert_eq json_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"a b\":\"String\",\" b.c=\\\"\\\\x2E\\t\":{\"d=e\":\"String\",\"m.d\":\"Int64\"}}}}"
