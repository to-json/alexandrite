  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"C\":3}}}"
  assert_eq text_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.X=0 g.A=1 g.N=4 g.h.B=2 g.h.Z=26"
  assert_eq json_line(1, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"X\":0,\"A\":1,\"N\":4,\"h\":{\"B\":2,\"Z\":26}}}"
  assert_eq text_line(1, [wg("g")], [], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message"
  assert_eq json_line(1, [wg("g")], [], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\"}"
  assert_eq text_line(1, [wg("g")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.A=one g.B=2"
  assert_eq json_line(1, [wg("g")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"A\":\"one\",\"B\":2}}"
  assert_eq text_line(1, [wg("g")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.A=1 g.g.B=2 g.g.h.C=3 g.g.D=4 g.E=5"
  assert_eq json_line(1, [wg("g")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"A\":1,\"g\":{\"B\":2,\"h\":{\"C\":3},\"D\":4},\"E\":5}}"
  assert_eq text_line(1, [wg("g")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message g.h.A=1"
  assert_eq json_line(1, [wg("g")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"g\":{\"h\":{\"A\":1}}}"
