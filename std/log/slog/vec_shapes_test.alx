}

test "shapes 26" {
  assert_eq text_line(3, [wa([group("e", [])])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([group("e", [])])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([group("e", [])])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([group("e", [])])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([group("e", [])])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([group("e", [])])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([group("e", [])])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([group("e", [])])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([group("e", [])])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([group("e", [])])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([group("e", [])])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([group("e", [])])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([group("e", [])])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([group("e", [])])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([group("e", [])])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([group("e", [])])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([group("e", [])])], [group("", [int64("c", 3)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([group("e", [])])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([group("e", [])])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([group("e", [])])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), ""
