  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"a\":\"Int64\",\"name\":{\"first\":\"String\",\"last\":\"String\"},\"b\":\"Int64\"}}"
  assert_eq text_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "level=INFO msg=message nm.first=String nm.last=String G.H.c=Int64 G.H.n2.first=String G.H.n2.last=String G.a=Int64 G.b=Int64 G.c=Int64 G.d=Int64"
  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"a\":\"Int64\",\"b\":\"Int64\",\"c\":\"Int64\",\"d\":\"Int64\"}}"
  assert_eq text_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "level=INFO msg=message nm.first=String nm.last=String G.H.c=Int64 G.H.n2.first=String G.H.n2.last=String \"G.prefix. needs quoting \"=String G.prefix.NotNeedsQuoting=String \"G.prefix needs quoting. needs quoting \"=String \"G.prefix needs quoting.NotNeedsQuoting\"=String"
  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"prefix\":{\" needs quoting \":\"String\",\"NotNeedsQuoting\":\"String\"},\"prefix needs quoting\":{\" needs quoting \":\"String\",\"NotNeedsQuoting\":\"String\"}}}"
  assert_eq text_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message nm.first=String nm.last=String G.H.c=Int64 G.H.n2.first=String G.H.n2.last=String G.g.a=Int64"
  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"g\":{\"a\":\"Int64\"}}}"
  assert_eq text_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "level=INFO msg=message nm.first=String nm.last=String G.H.c=Int64 G.H.n2.first=String G.H.n2.last=String G.a=Int64 G.b=Int64"
  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"a\":\"Int64\",\"b\":\"Int64\"}}"
  assert_eq text_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "level=INFO msg=message nm.first=String nm.last=String G.H.c=Int64 G.H.n2.first=String G.H.n2.last=String G.x.n.first=String G.x.n.last=String \"G.x.y.\"=Any G.x.y.a=Int64"
  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"x\":{\"n\":{\"first\":\"String\",\"last\":\"String\"},\"y\":{\"\":\"Any\",\"a\":\"Int64\"}}}}"
  assert_eq text_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "level=INFO msg=message nm.first=String nm.last=String G.H.c=Int64 G.H.n2.first=String G.H.n2.last=String G.a=Int64 G.a=Int64 \"G.\"=String"
  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"a\":\"Int64\",\"a\":\"Int64\",\"\":\"String\"}}"
  assert_eq text_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "level=INFO msg=message nm.first=String nm.last=String G.H.c=Int64 G.H.n2.first=String G.H.n2.last=String G.g.a=Int64 G.g.b=Int64"
  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"g\":{\"a\":\"Int64\"},\"g\":{\"b\":\"Int64\"}}}"
  assert_eq text_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message nm.first=String nm.last=String G.H.c=Int64 G.H.n2.first=String G.H.n2.last=String G.i.c=Int64"
  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"i\":{\"c\":\"Int64\"}}}"
  assert_eq text_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message nm.first=String nm.last=String G.H.c=Int64 G.H.n2.first=String G.H.n2.last=String G.c=Int64"
  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"c\":\"Int64\"}}"
  assert_eq text_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "level=INFO msg=message nm.first=String nm.last=String G.H.c=Int64 G.H.n2.first=String G.H.n2.last=String G.z=Int64"
  assert_eq json_line(5, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"nm\":{\"first\":\"String\",\"last\":\"String\"},\"G\":{\"H\":{\"c\":\"Int64\",\"n2\":{\"first\":\"String\",\"last\":\"String\"}},\"z\":\"Int64\"}}"
  assert_eq text_line(6, [], [], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message"
  assert_eq json_line(6, [], [], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\"}"
  assert_eq text_line(6, [], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message a=one b=2"
  assert_eq json_line(6, [], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"a\":\"one\",\"b\":2}"
  assert_eq text_line(6, [], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message a=1 g.b=2 g.h.c=3 g.d=4 e=5"
  assert_eq json_line(6, [], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"a\":1,\"g\":{\"b\":2,\"h\":{\"c\":3},\"d\":4},\"e\":5}"
  assert_eq text_line(6, [], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message h.a=1"
  assert_eq json_line(6, [], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"h\":{\"a\":1}}"
  assert_eq text_line(6, [], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message"
  assert_eq json_line(6, [], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\"}"
  assert_eq text_line(6, [], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message g.h.j.a=1"
  assert_eq json_line(6, [], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"g\":{\"h\":{\"j\":{\"a\":1}}}}"
}

test "shapes 40" {
  assert_eq text_line(6, [], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message \"a b\"=\"x\\t\\n\\x00y\" \" b.c=\\\"\\\\x2E\\t.d=e\"=\"f.g\\\"\" \" b.c=\\\"\\\\x2E\\t.m.d\"=1"
  assert_eq json_line(6, [], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"d=e\":\"f.g\\\"\",\"m.d\":1}}"
  assert_eq text_line(6, [], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message a=1 name.first=Ren name.last=Hoek b=2"
  assert_eq json_line(6, [], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"a\":1,\"name\":{\"first\":\"Ren\",\"last\":\"Hoek\"},\"b\":2}"
  assert_eq text_line(6, [], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message a=1 b=2 c=3 d=4"
  assert_eq json_line(6, [], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"a\":1,\"b\":2,\"c\":3,\"d\":4}"
  assert_eq text_line(6, [], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message \"prefix. needs quoting \"=v prefix.NotNeedsQuoting=v \"prefix needs quoting. needs quoting \"=v \"prefix needs quoting.NotNeedsQuoting\"=v"
  assert_eq json_line(6, [], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"prefix\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"}}"
  assert_eq text_line(6, [], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message g.a=1"
  assert_eq json_line(6, [], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"g\":{\"a\":1}}"
  assert_eq text_line(6, [], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message a=1 b=2"
  assert_eq json_line(6, [], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"a\":1,\"b\":2}"
  assert_eq text_line(6, [], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message x.n.first=p x.n.last=q x.y.a=9"
  assert_eq json_line(6, [], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"x\":{\"n\":{\"first\":\"p\",\"last\":\"q\"},\"y\":{\"a\":9}}}"
  assert_eq text_line(6, [], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message a=1 a=2 \"\"=\"empty key\""
  assert_eq json_line(6, [], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"a\":1,\"a\":2,\"\":\"empty key\"}"
  assert_eq text_line(6, [], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message g.a=1 g.b=2"
  assert_eq json_line(6, [], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"g\":{\"a\":1},\"g\":{\"b\":2}}"
  assert_eq text_line(6, [], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message i.c=3"
  assert_eq json_line(6, [], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"i\":{\"c\":3}}"
  assert_eq text_line(6, [], [group("", [int64("c", 3)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message c=3"
  assert_eq json_line(6, [], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"c\":3}"
  assert_eq text_line(6, [], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message z=26"
