  assert_eq text_line(6, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message x.a=1 x.y.c=3"
  assert_eq json_line(6, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"c\":3}}}"
  assert_eq text_line(6, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message x.a=1 x.y.z=26"
  assert_eq json_line(6, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"z\":26}}}"
  assert_eq text_line(6, [wg("g"), wa([int64("a", 1)])], [], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message g.a=1"
