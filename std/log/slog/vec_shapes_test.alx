  assert_eq json_line(4, [wg("x"), wa([group("g", [])]), wg("y")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:b\":2,\"x/y:\":null}}}"
