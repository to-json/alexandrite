  assert_eq json_line(4, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"p1\":1,\"s1\":{\"s1:p2\":2,\"s2\":{\"name\":{\"s1/s2/name:first\":\"Ren\",\"s1/s2/name:last\":\"Hoek\"},\"s1/s2:b\":2}}}"
