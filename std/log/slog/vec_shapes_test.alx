  assert_eq text_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "msg=message x.a=1 \"x.y.a b\"=\"x\\t\\n\\x00y\" \"x.y. b.c=\\\"\\\\x2E\\t.d=e\"=\"f.g\\\"\" \"x.y. b.c=\\\"\\\\x2E\\t.m.d\"=1"
  assert_eq json_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"d=e\":\"f.g\\\"\",\"m.d\":1}}}}"
  assert_eq text_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "msg=message x.a=1 x.y.a=1 x.y.name.first=Ren x.y.name.last=Hoek x.y.b=2"
  assert_eq json_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"a\":1,\"name\":{\"first\":\"Ren\",\"last\":\"Hoek\"},\"b\":2}}}"
}

test "shapes 17" {
  assert_eq text_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "msg=message x.a=1 x.y.a=1 x.y.b=2 x.y.c=3 x.y.d=4"
  assert_eq json_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"a\":1,\"b\":2,\"c\":3,\"d\":4}}}"
  assert_eq text_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "msg=message x.a=1 \"x.y.prefix. needs quoting \"=v x.y.prefix.NotNeedsQuoting=v \"x.y.prefix needs quoting. needs quoting \"=v \"x.y.prefix needs quoting.NotNeedsQuoting\"=v"
  assert_eq json_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"prefix\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"}}}}"
  assert_eq text_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "msg=message x.a=1 x.y.g.a=1"
  assert_eq json_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"g\":{\"a\":1}}}}"
  assert_eq text_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "msg=message x.a=1 x.y.a=1 x.y.b=2"
