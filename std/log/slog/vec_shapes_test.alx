}

test "shapes 22" {
  assert_eq text_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{}"
