  assert_eq json_line(6, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"h\":{\"a\":1}}}}"
