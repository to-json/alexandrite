  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"d=e\":\"f.g\\\"\",\"m.d\":1}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "msg=message p1=1 s1.s2.a=1 s1.s2.name.first=Ren s1.s2.name.last=Hoek s1.s2.b=2"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"a\":1,\"name\":{\"first\":\"Ren\",\"last\":\"Hoek\"},\"b\":2}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "msg=message p1=1 s1.s2.a=1 s1.s2.b=2 s1.s2.c=3 s1.s2.d=4"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"a\":1,\"b\":2,\"c\":3,\"d\":4}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "msg=message p1=1 \"s1.s2.prefix. needs quoting \"=v s1.s2.prefix.NotNeedsQuoting=v \"s1.s2.prefix needs quoting. needs quoting \"=v \"s1.s2.prefix needs quoting.NotNeedsQuoting\"=v"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"prefix\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "msg=message p1=1 s1.s2.g.a=1"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"g\":{\"a\":1}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "msg=message p1=1 s1.s2.a=1 s1.s2.b=2"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"a\":1,\"b\":2}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "msg=message p1=1 s1.s2.x.n.first=p s1.s2.x.n.last=q s1.s2.x.y.a=9"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"x\":{\"n\":{\"first\":\"p\",\"last\":\"q\"},\"y\":{\"a\":9}}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "msg=message p1=1 s1.s2.a=1 s1.s2.a=2 \"s1.s2.\"=\"empty key\""
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"a\":1,\"a\":2,\"\":\"empty key\"}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "msg=message p1=1 s1.s2.g.a=1 s1.s2.g.b=2"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"g\":{\"a\":1},\"g\":{\"b\":2}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "msg=message p1=1 s1.s2.i.c=3"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"i\":{\"c\":3}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "msg=message p1=1 s1.s2.c=3"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"c\":3}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "msg=message p1=1 s1.s2.z=26"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"z\":26}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.a=one s1.s2.b=2"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"a\":\"one\",\"b\":2}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.a=1 s1.s2.g.b=2 s1.s2.g.h.c=3 s1.s2.g.d=4 s1.s2.e=5"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"a\":1,\"g\":{\"b\":2,\"h\":{\"c\":3},\"d\":4},\"e\":5}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.h.a=1"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"h\":{\"a\":1}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.g.h.j.a=1"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"g\":{\"h\":{\"j\":{\"a\":1}}}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 \"s1.s2.a b\"=\"x\\t\\n\\x00y\" \"s1.s2. b.c=\\\"\\\\x2E\\t.d=e\"=\"f.g\\\"\" \"s1.s2. b.c=\\\"\\\\x2E\\t.m.d\"=1"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"d=e\":\"f.g\\\"\",\"m.d\":1}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.a=1 s1.s2.name.first=Ren s1.s2.name.last=Hoek s1.s2.b=2"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"a\":1,\"name\":{\"first\":\"Ren\",\"last\":\"Hoek\"},\"b\":2}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.a=1 s1.s2.b=2 s1.s2.c=3 s1.s2.d=4"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"a\":1,\"b\":2,\"c\":3,\"d\":4}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 \"s1.s2.prefix. needs quoting \"=v s1.s2.prefix.NotNeedsQuoting=v \"s1.s2.prefix needs quoting. needs quoting \"=v \"s1.s2.prefix needs quoting.NotNeedsQuoting\"=v"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"prefix\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.g.a=1"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"g\":{\"a\":1}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.a=1 s1.s2.b=2"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"a\":1,\"b\":2}}}"
}

test "shapes 16" {
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.x.n.first=p s1.s2.x.n.last=q s1.s2.x.y.a=9"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"x\":{\"n\":{\"first\":\"p\",\"last\":\"q\"},\"y\":{\"a\":9}}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.a=1 s1.s2.a=2 \"s1.s2.\"=\"empty key\""
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"a\":1,\"a\":2,\"\":\"empty key\"}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.g.a=1 s1.s2.g.b=2"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"g\":{\"a\":1},\"g\":{\"b\":2}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.i.c=3"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"i\":{\"c\":3}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.c=3"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"c\":3}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.p3=3 s1.s2.z=26"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"p3\":3,\"z\":26}}}"
  assert_eq text_line(2, [wg("x"), wg("y")], [], test_time, level_info, "message"), "msg=message"
  assert_eq json_line(2, [wg("x"), wg("y")], [], test_time, level_info, "message"), "{\"msg\":\"message\"}"
