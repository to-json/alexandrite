  assert_eq json_line(4, [wg("x"), wa([group("g", [])]), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"x/y/ b.c=\\\"\\\\x2E\\t:d=e\":\"f.g\\\"\",\"x/y/ b.c=\\\"\\\\x2E\\t:m.d\":1}}}}"
  assert_eq text_line(4, [wg("x"), wa([group("g", [])]), wg("y")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "level=INFO msg=message x.y.name.x/y/name:first=Ren x.y.name.x/y/name:last=Hoek x.y.x/y:b=2"
