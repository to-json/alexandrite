  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("g"), wa([int64("a", 1)])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("g"), wa([int64("a", 1)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "level=INFO msg=message \"g.g:a b\"=\"x\\t\\n\\x00y\" \"g. b.c=\\\"\\\\x2E\\t.g/ b.c=\\\"\\\\x2E\\t:d=e\"=\"f.g\\\"\" \"g. b.c=\\\"\\\\x2E\\t.g/ b.c=\\\"\\\\x2E\\t:m.d\"=1"
  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"g/ b.c=\\\"\\\\x2E\\t:d=e\":\"f.g\\\"\",\"g/ b.c=\\\"\\\\x2E\\t:m.d\":1}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("a", 1)])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "level=INFO msg=message g.name.g/name:first=Ren g.name.g/name:last=Hoek g.g:b=2"
