  assert_eq text_line(1, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message P1=1 s1.P2=2 s1.s2.A=1 s1.s2.g.B=2 s1.s2.g.h.C=3 s1.s2.g.D=4 s1.s2.E=5"
