  assert_eq text_line(1, [wg("x"), wa([group("g", [])]), wg("y")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.g.h.j.A=1"
  assert_eq json_line(1, [wg("x"), wa([group("g", [])]), wg("y")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"g\":{\"h\":{\"j\":{\"A\":1}}}}}}"
