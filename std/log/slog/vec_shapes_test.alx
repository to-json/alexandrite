  assert_eq text_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d G.g.a=1"
  assert_eq json_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"nm\":{\"first\":\"a\",\"last\":\"b\"},\"G\":{\"H\":{\"c\":1,\"n2\":{\"first\":\"c\",\"last\":\"d\"}},\"g\":{\"a\":1}}}"
  assert_eq text_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d G.a=1 G.b=2"
  assert_eq json_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"nm\":{\"first\":\"a\",\"last\":\"b\"},\"G\":{\"H\":{\"c\":1,\"n2\":{\"first\":\"c\",\"last\":\"d\"}},\"a\":1,\"b\":2}}"
  assert_eq text_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d G.x.n.first=p G.x.n.last=q G.x.y.a=9"
  assert_eq json_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"nm\":{\"first\":\"a\",\"last\":\"b\"},\"G\":{\"H\":{\"c\":1,\"n2\":{\"first\":\"c\",\"last\":\"d\"}},\"x\":{\"n\":{\"first\":\"p\",\"last\":\"q\"},\"y\":{\"a\":9}}}}"
  assert_eq text_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d G.a=1 G.a=2 \"G.\"=\"empty key\""
  assert_eq json_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"msg\":\"message\",\"nm\":{\"first\":\"a\",\"last\":\"b\"},\"G\":{\"H\":{\"c\":1,\"n2\":{\"first\":\"c\",\"last\":\"d\"}},\"a\":1,\"a\":2,\"\":\"empty key\"}}"
  assert_eq text_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d G.g.a=1 G.g.b=2"
  assert_eq json_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"nm\":{\"first\":\"a\",\"last\":\"b\"},\"G\":{\"H\":{\"c\":1,\"n2\":{\"first\":\"c\",\"last\":\"d\"}},\"g\":{\"a\":1},\"g\":{\"b\":2}}}"
  assert_eq text_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d G.i.c=3"
  assert_eq json_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"nm\":{\"first\":\"a\",\"last\":\"b\"},\"G\":{\"H\":{\"c\":1,\"n2\":{\"first\":\"c\",\"last\":\"d\"}},\"i\":{\"c\":3}}}"
  assert_eq text_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d G.c=3"
  assert_eq json_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"nm\":{\"first\":\"a\",\"last\":\"b\"},\"G\":{\"H\":{\"c\":1,\"n2\":{\"first\":\"c\",\"last\":\"d\"}},\"c\":3}}"
  assert_eq text_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d G.z=26"
  assert_eq json_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"msg\":\"message\",\"nm\":{\"first\":\"a\",\"last\":\"b\"},\"G\":{\"H\":{\"c\":1,\"n2\":{\"first\":\"c\",\"last\":\"d\"}},\"z\":26}}"
  assert_eq text_line(3, [], [], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("g", [int64("a", 1)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("i", [int64("c", 3)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("", [int64("c", 3)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{}"
}

test "shapes 21" {
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("", [int64("c", 3)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 3), string("x", "y")])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 0)]), wg("s")], [], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 0)]), wg("s")], [], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 0)]), wg("s")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 0)]), wg("s")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 0)]), wg("s")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 0)]), wg("s")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("pre", 0)]), wg("s")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("pre", 0)]), wg("s")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{}"
