  assert_eq text_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.a\"=1 \"needs quote.q=1.b\"=2"
  assert_eq json_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"a\":1,\"b\":2}}}"
  assert_eq text_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.x.n.first\"=p \"needs quote.q=1.x.n.last\"=q \"needs quote.q=1.x.y.a\"=9"
  assert_eq json_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"x\":{\"n\":{\"first\":\"p\",\"last\":\"q\"},\"y\":{\"a\":9}}}}}"
  assert_eq text_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.a\"=1 \"needs quote.q=1.a\"=2 \"needs quote.q=1.\"=\"empty key\""
  assert_eq json_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"a\":1,\"a\":2,\"\":\"empty key\"}}}"
  assert_eq text_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.g.a\"=1 \"needs quote.q=1.g.b\"=2"
  assert_eq json_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"g\":{\"a\":1},\"g\":{\"b\":2}}}}"
  assert_eq text_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.i.c\"=3"
  assert_eq json_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"i\":{\"c\":3}}}}"
  assert_eq text_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.c\"=3"
  assert_eq json_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"c\":3}}}"
  assert_eq text_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.z\"=26"
  assert_eq json_line(6, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"z\":26}}}"
}

test "shapes 46" {
  assert_eq text_line(6, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d"
