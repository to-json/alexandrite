test "shapes 39" {
  assert_eq text_line(5, [wa([group("e", [])])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message g.a=Int64"
  assert_eq json_line(5, [wa([group("e", [])])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"a\":\"Int64\"}}"
  assert_eq text_line(5, [wa([group("e", [])])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "level=INFO msg=message a=Int64 b=Int64"
  assert_eq json_line(5, [wa([group("e", [])])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"a\":\"Int64\",\"b\":\"Int64\"}"
  assert_eq text_line(5, [wa([group("e", [])])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "level=INFO msg=message x.n.first=String x.n.last=String \"x.y.\"=Any x.y.a=Int64"
  assert_eq json_line(5, [wa([group("e", [])])], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"n\":{\"first\":\"String\",\"last\":\"String\"},\"y\":{\"\":\"Any\",\"a\":\"Int64\"}}}"
  assert_eq text_line(5, [wa([group("e", [])])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "level=INFO msg=message a=Int64 a=Int64 \"\"=String"
  assert_eq json_line(5, [wa([group("e", [])])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"a\":\"Int64\",\"a\":\"Int64\",\"\":\"String\"}"
  assert_eq text_line(5, [wa([group("e", [])])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "level=INFO msg=message g.a=Int64 g.b=Int64"
  assert_eq json_line(5, [wa([group("e", [])])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"a\":\"Int64\"},\"g\":{\"b\":\"Int64\"}}"
  assert_eq text_line(5, [wa([group("e", [])])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message i.c=Int64"
  assert_eq json_line(5, [wa([group("e", [])])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"i\":{\"c\":\"Int64\"}}"
  assert_eq text_line(5, [wa([group("e", [])])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message c=Int64"
