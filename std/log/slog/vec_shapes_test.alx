  assert_eq json_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"a\":\"Int64\",\"b\":\"Int64\",\"c\":\"Int64\",\"d\":\"Int64\"}}}"
