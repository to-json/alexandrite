  assert_eq text_line(5, [wg("x"), wg("y")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message x.y.i.c=Int64"
  assert_eq json_line(5, [wg("x"), wg("y")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"i\":{\"c\":\"Int64\"}}}}"
  assert_eq text_line(5, [wg("x"), wg("y")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message x.y.c=Int64"
  assert_eq json_line(5, [wg("x"), wg("y")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"c\":\"Int64\"}}}"
  assert_eq text_line(5, [wg("x"), wg("y")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "level=INFO msg=message x.y.z=Int64"
  assert_eq json_line(5, [wg("x"), wg("y")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"z\":\"Int64\"}}}"
  assert_eq text_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "level=INFO msg=message x.y.a=String x.y.b=Int64 \"x.y.\"=Any"
  assert_eq json_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"a\":\"String\",\"b\":\"Int64\",\"\":\"Any\"}}}"
  assert_eq text_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "level=INFO msg=message x.y.a=Int64 x.y.g.b=Int64 x.y.g.h.c=Int64 x.y.g.d=Int64 x.y.e=Int64"
  assert_eq json_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"a\":\"Int64\",\"g\":{\"b\":\"Int64\",\"h\":{\"c\":\"Int64\"},\"d\":\"Int64\"},\"e\":\"Int64\"}}}"
  assert_eq text_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message x.y.h.a=Int64"
  assert_eq json_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"h\":{\"a\":\"Int64\"}}}}"
}

test "shapes 36" {
  assert_eq text_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(5, [wg("x"), wa([group("g", [])]), wg("y")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
