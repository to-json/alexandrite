  assert_eq json_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"x\":{\"n\":{\"first\":\"p\",\"last\":\"q\"},\"y\":{\"a\":9}}}}}"
  assert_eq text_line(2, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "msg=message x.a=1 x.y.a=1 x.y.a=2 \"x.y.\"=\"empty key\""
