  assert_eq text_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{}"
  assert_eq text_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), ""
  assert_eq json_line(3, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{}"
