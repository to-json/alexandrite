  assert_eq json_line(1, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"nm\":{\"FIRST\":\"a\",\"LAST\":\"b\"},\"G\":{\"H\":{\"C\":1,\"n2\":{\"FIRST\":\"c\",\"LAST\":\"d\"}},\"A\":1,\"A\":2,\"\":\"empty key\"}}"
  assert_eq text_line(1, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message nm.FIRST=a nm.LAST=b G.H.C=1 G.H.n2.FIRST=c G.H.n2.LAST=d G.g.A=1 G.g.B=2"
  assert_eq json_line(1, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"nm\":{\"FIRST\":\"a\",\"LAST\":\"b\"},\"G\":{\"H\":{\"C\":1,\"n2\":{\"FIRST\":\"c\",\"LAST\":\"d\"}},\"g\":{\"A\":1},\"g\":{\"B\":2}}}"
  assert_eq text_line(1, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message nm.FIRST=a nm.LAST=b G.H.C=1 G.H.n2.FIRST=c G.H.n2.LAST=d G.i.C=3"
  assert_eq json_line(1, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"nm\":{\"FIRST\":\"a\",\"LAST\":\"b\"},\"G\":{\"H\":{\"C\":1,\"n2\":{\"FIRST\":\"c\",\"LAST\":\"d\"}},\"i\":{\"C\":3}}}"
  assert_eq text_line(1, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message nm.FIRST=a nm.LAST=b G.H.C=1 G.H.n2.FIRST=c G.H.n2.LAST=d G.C=3"
  assert_eq json_line(1, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"nm\":{\"FIRST\":\"a\",\"LAST\":\"b\"},\"G\":{\"H\":{\"C\":1,\"n2\":{\"FIRST\":\"c\",\"LAST\":\"d\"}},\"C\":3}}"
  assert_eq text_line(1, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message nm.FIRST=a nm.LAST=b G.H.C=1 G.H.n2.FIRST=c G.H.n2.LAST=d G.Z=26"
  assert_eq json_line(1, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"nm\":{\"FIRST\":\"a\",\"LAST\":\"b\"},\"G\":{\"H\":{\"C\":1,\"n2\":{\"FIRST\":\"c\",\"LAST\":\"d\"}},\"Z\":26}}"
  assert_eq text_line(2, [], [], test_time, level_info, "message"), "msg=message"
  assert_eq json_line(2, [], [], test_time, level_info, "message"), "{\"msg\":\"message\"}"
  assert_eq text_line(2, [], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "msg=message a=one b=2"
  assert_eq json_line(2, [], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"msg\":\"message\",\"a\":\"one\",\"b\":2}"
}

test "shapes 14" {
  assert_eq text_line(2, [], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "msg=message a=1 g.b=2 g.h.c=3 g.d=4 e=5"
  assert_eq json_line(2, [], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"msg\":\"message\",\"a\":1,\"g\":{\"b\":2,\"h\":{\"c\":3},\"d\":4},\"e\":5}"
  assert_eq text_line(2, [], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "msg=message h.a=1"
  assert_eq json_line(2, [], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"h\":{\"a\":1}}"
  assert_eq text_line(2, [], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "msg=message"
  assert_eq json_line(2, [], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"msg\":\"message\"}"
  assert_eq text_line(2, [], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "msg=message g.h.j.a=1"
  assert_eq json_line(2, [], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"g\":{\"h\":{\"j\":{\"a\":1}}}}"
  assert_eq text_line(2, [], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "msg=message \"a b\"=\"x\\t\\n\\x00y\" \" b.c=\\\"\\\\x2E\\t.d=e\"=\"f.g\\\"\" \" b.c=\\\"\\\\x2E\\t.m.d\"=1"
