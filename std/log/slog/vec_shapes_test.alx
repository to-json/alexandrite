  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"h\":{\"a\":1}}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "msg=message p1=1"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "msg=message p1=1 s1.s2.g.h.j.a=1"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wg("s2")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"s2\":{\"g\":{\"h\":{\"j\":{\"a\":1}}}}}}"
