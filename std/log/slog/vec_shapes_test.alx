  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:n\":4,\"h\":{\"g/h:b\":2,\"g/h:b\":2}}}"
