  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"x/y/ b.c=\\\"\\\\x2E\\t:d=e\":\"f.g\\\"\",\"x/y/ b.c=\\\"\\\\x2E\\t:m.d\":1}}}}"
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "level=INFO msg=message x.y.name.x/y/name:first=Ren x.y.name.x/y/name:last=Hoek x.y.x/y:b=2"
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"name\":{\"x/y/name:first\":\"Ren\",\"x/y/name:last\":\"Hoek\"},\"x/y:b\":2}}}"
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "level=INFO msg=message x.y.x/y:b=2 x.y.x/y:c=3 x.y.x/y:d=4"
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:b\":2,\"x/y:c\":3,\"x/y:d\":4}}}"
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "level=INFO msg=message \"x.y.prefix.x/y/prefix: needs quoting \"=v x.y.prefix.x/y/prefix:NotNeedsQuoting=v \"x.y.prefix needs quoting.x/y/prefix needs quoting: needs quoting \"=v \"x.y.prefix needs quoting.x/y/prefix needs quoting:NotNeedsQuoting\"=v"
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"prefix\":{\"x/y/prefix: needs quoting \":\"v\",\"x/y/prefix:NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\"x/y/prefix needs quoting: needs quoting \":\"v\",\"x/y/prefix needs quoting:NotNeedsQuoting\":\"v\"}}}}"
}

test "shapes 30" {
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message"
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\"}"
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "level=INFO msg=message x.y.x/y:b=2"
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:b\":2}}}"
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "level=INFO msg=message x.y.x.n.x/y/x/n:first=p x.y.x.n.x/y/x/n:last=q x.y.x.y.x/y/x/y:=<nil>"
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x\":{\"n\":{\"x/y/x/n:first\":\"p\",\"x/y/x/n:last\":\"q\"},\"y\":{\"x/y/x/y:\":null}}}}}"
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "level=INFO msg=message x.y.x/y:=\"empty key\""
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:\":\"empty key\"}}}"
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "level=INFO msg=message x.y.g.g.x/y/g/g:b=2"
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"g\":{\"x/y/g/g:b\":2}}}}"
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message x.y.i.x/y/i:c=3"
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"i\":{\"x/y/i:c\":3}}}}"
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "level=INFO msg=message x.y.x/y:c=3"
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:c\":3}}}"
  assert_eq text_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "level=INFO msg=message x.y.x/y:z=26"
  assert_eq json_line(4, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"x/y:z\":26}}}"
