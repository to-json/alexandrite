  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:n\":4,\"h\":{\"g/h:b\":2}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "level=INFO msg=message g.g:n=4 g.h.g/h:b=2"
  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:n\":4,\"h\":{\"g/h:b\":2}}}"
}

test "shapes 31" {
  assert_eq text_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "level=INFO msg=message g.g:n=4 g.h.g/h:b=2 \"g.h.g/h:a b\"=\"x\\t\\n\\x00y\" \"g.h. b.c=\\\"\\\\x2E\\t.g/h/ b.c=\\\"\\\\x2E\\t:d=e\"=\"f.g\\\"\" \"g.h. b.c=\\\"\\\\x2E\\t.g/h/ b.c=\\\"\\\\x2E\\t:m.d\"=1"
  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:n\":4,\"h\":{\"g/h:b\":2,\"g/h:a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"g/h/ b.c=\\\"\\\\x2E\\t:d=e\":\"f.g\\\"\",\"g/h/ b.c=\\\"\\\\x2E\\t:m.d\":1}}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "level=INFO msg=message g.g:n=4 g.h.g/h:b=2 g.h.name.g/h/name:first=Ren g.h.name.g/h/name:last=Hoek g.h.g/h:b=2"
  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:n\":4,\"h\":{\"g/h:b\":2,\"name\":{\"g/h/name:first\":\"Ren\",\"g/h/name:last\":\"Hoek\"},\"g/h:b\":2}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "level=INFO msg=message g.g:n=4 g.h.g/h:b=2 g.h.g/h:b=2 g.h.g/h:c=3 g.h.g/h:d=4"
  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:n\":4,\"h\":{\"g/h:b\":2,\"g/h:b\":2,\"g/h:c\":3,\"g/h:d\":4}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "level=INFO msg=message g.g:n=4 g.h.g/h:b=2 \"g.h.prefix.g/h/prefix: needs quoting \"=v g.h.prefix.g/h/prefix:NotNeedsQuoting=v \"g.h.prefix needs quoting.g/h/prefix needs quoting: needs quoting \"=v \"g.h.prefix needs quoting.g/h/prefix needs quoting:NotNeedsQuoting\"=v"
  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:n\":4,\"h\":{\"g/h:b\":2,\"prefix\":{\"g/h/prefix: needs quoting \":\"v\",\"g/h/prefix:NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\"g/h/prefix needs quoting: needs quoting \":\"v\",\"g/h/prefix needs quoting:NotNeedsQuoting\":\"v\"}}}}"
  assert_eq text_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "level=INFO msg=message g.g:n=4 g.h.g/h:b=2"
  assert_eq json_line(4, [wg("g"), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"g\":{\"g:n\":4,\"h\":{\"g/h:b\":2}}}"
