  assert_eq json_line(1, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"P1\":1,\"s1\":{\"P2\":2,\"s2\":{\"P3\":3,\"g\":{\"A\":1},\"g\":{\"B\":2}}}}"
  assert_eq text_line(1, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message P1=1 s1.P2=2 s1.s2.P3=3 s1.s2.i.C=3"
  assert_eq json_line(1, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"P1\":1,\"s1\":{\"P2\":2,\"s2\":{\"P3\":3,\"i\":{\"C\":3}}}}"
  assert_eq text_line(1, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message P1=1 s1.P2=2 s1.s2.P3=3 s1.s2.C=3"
  assert_eq json_line(1, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"P1\":1,\"s1\":{\"P2\":2,\"s2\":{\"P3\":3,\"C\":3}}}"
  assert_eq text_line(1, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message P1=1 s1.P2=2 s1.s2.P3=3 s1.s2.Z=26"
  assert_eq json_line(1, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2"), wa([int64("p3", 3)])], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"P1\":1,\"s1\":{\"P2\":2,\"s2\":{\"P3\":3,\"Z\":26}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message"
  assert_eq json_line(1, [wg("x"), wg("y")], [], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\"}"
  assert_eq text_line(1, [wg("x"), wg("y")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.A=one x.y.B=2"
  assert_eq json_line(1, [wg("x"), wg("y")], [string("a", "one"), int64("b", 2), any("", nil_value)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"A\":\"one\",\"B\":2}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.A=1 x.y.g.B=2 x.y.g.h.C=3 x.y.g.D=4 x.y.E=5"
  assert_eq json_line(1, [wg("x"), wg("y")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"A\":1,\"g\":{\"B\":2,\"h\":{\"C\":3},\"D\":4},\"E\":5}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.h.A=1"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("g", []), group("h", [int64("a", 1)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"h\":{\"A\":1}}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\"}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.g.h.j.A=1"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"g\":{\"h\":{\"j\":{\"A\":1}}}}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message \"x.y.A B\"=\"x\\t\\n\\x00y\" \"x.y. b.c=\\\"\\\\x2E\\t.D=E\"=\"f.g\\\"\" \"x.y. b.c=\\\"\\\\x2E\\t.M.D\"=1"
  assert_eq json_line(1, [wg("x"), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"A B\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"D=E\":\"f.g\\\"\",\"M.D\":1}}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.A=1 x.y.name.FIRST=Ren x.y.name.LAST=Hoek x.y.B=2"
  assert_eq json_line(1, [wg("x"), wg("y")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"A\":1,\"name\":{\"FIRST\":\"Ren\",\"LAST\":\"Hoek\"},\"B\":2}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.A=1 x.y.B=2 x.y.C=3 x.y.D=4"
  assert_eq json_line(1, [wg("x"), wg("y")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"A\":1,\"B\":2,\"C\":3,\"D\":4}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message \"x.y.prefix. NEEDS QUOTING \"=v x.y.prefix.NOTNEEDSQUOTING=v \"x.y.prefix needs quoting. NEEDS QUOTING \"=v \"x.y.prefix needs quoting.NOTNEEDSQUOTING\"=v"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"prefix\":{\" NEEDS QUOTING \":\"v\",\"NOTNEEDSQUOTING\":\"v\"},\"prefix needs quoting\":{\" NEEDS QUOTING \":\"v\",\"NOTNEEDSQUOTING\":\"v\"}}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.g.A=1"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"g\":{\"A\":1}}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.A=1 x.y.B=2"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"A\":1,\"B\":2}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.x.n.FIRST=p x.y.x.n.LAST=q x.y.x.y.A=9"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"x\":{\"n\":{\"FIRST\":\"p\",\"LAST\":\"q\"},\"y\":{\"A\":9}}}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.A=1 x.y.A=2 \"x.y.\"=\"empty key\""
  assert_eq json_line(1, [wg("x"), wg("y")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"A\":1,\"A\":2,\"\":\"empty key\"}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.g.A=1 x.y.g.B=2"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"g\":{\"A\":1},\"g\":{\"B\":2}}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.i.C=3"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"i\":{\"C\":3}}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.C=3"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"C\":3}}}"
  assert_eq text_line(1, [wg("x"), wg("y")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message x.y.Z=26"
  assert_eq json_line(1, [wg("x"), wg("y")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"TIME\":\"2000-01-02T03:04:05Z\",\"LEVEL\":\"INFO\",\"MSG\":\"message\",\"x\":{\"y\":{\"Z\":26}}}"
}

test "shapes 10" {
  assert_eq text_line(1, [wg("x"), wa([group("g", [])]), wg("y")], [], test_time, level_info, "message"), "TIME=2000-01-02T03:04:05.000Z LEVEL=INFO MSG=message"
