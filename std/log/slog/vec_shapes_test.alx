  assert_eq text_line(6, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "time.mins=3 time.secs=2 msg=message x.a=1 x.y.g.h.j.a=1"
  assert_eq json_line(6, [wg("x"), wa([int64("a", 1)]), wg("y")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"g\":{\"h\":{\"j\":{\"a\":1}}}}}}"
