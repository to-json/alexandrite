  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"a\":1,\"a\":2,\"\":\"empty key\"}}}"
  assert_eq text_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "msg=message p1=1 s1.p2=2 s1.s2.g.a=1 s1.s2.g.b=2"
  assert_eq json_line(2, [wa([int64("p1", 1)]), wg("s1"), wa([int64("p2", 2)]), wg("s2")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"p1\":1,\"s1\":{\"p2\":2,\"s2\":{\"g\":{\"a\":1},\"g\":{\"b\":2}}}}"
