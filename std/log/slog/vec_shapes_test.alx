  assert_eq json_line(2, [wa([])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"d=e\":\"f.g\\\"\",\"m.d\":1}}"
  assert_eq text_line(2, [wa([])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "msg=message a=1 name.first=Ren name.last=Hoek b=2"
  assert_eq json_line(2, [wa([])], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"msg\":\"message\",\"a\":1,\"name\":{\"first\":\"Ren\",\"last\":\"Hoek\"},\"b\":2}"
  assert_eq text_line(2, [wa([])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "msg=message a=1 b=2 c=3 d=4"
  assert_eq json_line(2, [wa([])], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"msg\":\"message\",\"a\":1,\"b\":2,\"c\":3,\"d\":4}"
