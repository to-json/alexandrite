}

test "shapes 4" {
  assert_eq text_line(0, [wg("x"), wa([int64("a", 1)]), wg("y")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "time=2000-01-02T03:04:05.000Z level=INFO msg=message x.a=1 \"x.y.a b\"=\"x\\t\\n\\x00y\" \"x.y. b.c=\\\"\\\\x2E\\t.d=e\"=\"f.g\\\"\" \"x.y. b.c=\\\"\\\\x2E\\t.m.d\"=1"
