  assert_eq json_line(3, [wg("g"), wa([int64("a", 1)]), wg("h"), wa([int64("b", 2)])], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{}"
