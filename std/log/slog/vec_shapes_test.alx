  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\""
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [group("i", []), group("j", [])])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\"}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.g.h.j.a\"=1"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"g\":{\"h\":{\"j\":{\"a\":1}}}}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.a b\"=\"x\\t\\n\\x00y\" \"needs quote.q=1. b.c=\\\"\\\\x2E\\t.d=e\"=\"f.g\\\"\" \"needs quote.q=1. b.c=\\\"\\\\x2E\\t.m.d\"=1"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [string("a b", "x\t\n\x00y"), group(" b.c=\"\\x2E\t", [string("d=e", "f.g\""), int64("m.d", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"a b\":\"x\\t\\n\\u0000y\",\" b.c=\\\"\\\\x2E\\t\":{\"d=e\":\"f.g\\\"\",\"m.d\":1}}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.a\"=1 \"needs quote.q=1.name.first\"=Ren \"needs quote.q=1.name.last\"=Hoek \"needs quote.q=1.b\"=2"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [int64("a", 1), any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek"))), int64("b", 2)], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"a\":1,\"name\":{\"first\":\"Ren\",\"last\":\"Hoek\"},\"b\":2}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.a\"=1 \"needs quote.q=1.b\"=2 \"needs quote.q=1.c\"=3 \"needs quote.q=1.d\"=4"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [int64("a", 1), group("", [int64("b", 2), int64("c", 3)]), int64("d", 4)], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"a\":1,\"b\":2,\"c\":3,\"d\":4}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.prefix. needs quoting \"=v \"needs quote.q=1.prefix.NotNeedsQuoting\"=v \"needs quote.q=1.prefix needs quoting. needs quoting \"=v \"needs quote.q=1.prefix needs quoting.NotNeedsQuoting\"=v"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("prefix", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")]), group("prefix needs quoting", [string(" needs quoting ", "v"), string("NotNeedsQuoting", "v")])], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"prefix\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"},\"prefix needs quoting\":{\" needs quoting \":\"v\",\"NotNeedsQuoting\":\"v\"}}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.g.a\"=1"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"g\":{\"a\":1}}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.a\"=1 \"needs quote.q=1.b\"=2"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("", [int64("a", 1), group("", [int64("b", 2)])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"a\":1,\"b\":2}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.x.n.first\"=p \"needs quote.q=1.x.n.last\"=q \"needs quote.q=1.x.y.a\"=9"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("x", [any("n", valuer_value(LogValueName.new(first: "p", last: "q"))), group("y", [any("", nil_value), int64("a", 9)])])], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"x\":{\"n\":{\"first\":\"p\",\"last\":\"q\"},\"y\":{\"a\":9}}}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.a\"=1 \"needs quote.q=1.a\"=2 \"needs quote.q=1.\"=\"empty key\""
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"a\":1,\"a\":2,\"\":\"empty key\"}}}"
}

test "shapes 20" {
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.g.a\"=1 \"needs quote.q=1.g.b\"=2"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [int64("a", 1)]), group("g", [int64("b", 2)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"g\":{\"a\":1},\"g\":{\"b\":2}}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.i.c\"=3"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("i", [int64("c", 3)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"i\":{\"c\":3}}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.c\"=3"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("", [int64("c", 3)])], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"c\":3}}}"
  assert_eq text_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "msg=message \"needs quote.k k\"=\"v v\" \"needs quote.q=1.z\"=26"
  assert_eq json_line(2, [wg("needs quote"), wa([string("k k", "v v")]), wg("q=1")], [group("g", [group("h", [])]), int64("z", 26)], test_time, level_info, "message"), "{\"msg\":\"message\",\"needs quote\":{\"k k\":\"v v\",\"q=1\":{\"z\":26}}}"
  assert_eq text_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [], test_time, level_info, "message"), "msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d"
  assert_eq json_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [], test_time, level_info, "message"), "{\"msg\":\"message\",\"nm\":{\"first\":\"a\",\"last\":\"b\"},\"G\":{\"H\":{\"c\":1,\"n2\":{\"first\":\"c\",\"last\":\"d\"}}}}"
