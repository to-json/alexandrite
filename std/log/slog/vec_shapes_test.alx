  assert_eq json_line(6, [wg("g"), wa([int64("x", 0)]), wa([int64("a", 1)]), wa([int64("n", 4)]), wg("h"), wa([int64("b", 2)])], [group("g", [int64("a", 1)])], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"g\":{\"x\":0,\"a\":1,\"n\":4,\"h\":{\"b\":2,\"g\":{\"a\":1}}}}"
