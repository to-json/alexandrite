  assert_eq json_line(6, [wg("x"), wa([int64("a", 1)]), wg("y")], [int64("a", 1), group("g", [int64("b", 2), group("h", [int64("c", 3)]), int64("d", 4)]), int64("e", 5)], test_time, level_info, "message"), "{\"time\":{\"mins\":3,\"secs\":2},\"msg\":\"message\",\"x\":{\"a\":1,\"y\":{\"a\":1,\"g\":{\"b\":2,\"h\":{\"c\":3},\"d\":4},\"e\":5}}}"
