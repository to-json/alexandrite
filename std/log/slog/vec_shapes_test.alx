  assert_eq text_line(5, [wg("x"), wg("y")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "level=INFO msg=message x.y.a=Int64 x.y.a=Int64 \"x.y.\"=String"
  assert_eq json_line(5, [wg("x"), wg("y")], [int64("a", 1), int64("a", 2), string("", "empty key")], test_time, level_info, "message"), "{\"level\":\"INFO\",\"msg\":\"message\",\"x\":{\"y\":{\"a\":\"Int64\",\"a\":\"Int64\",\"\":\"String\"}}}"
