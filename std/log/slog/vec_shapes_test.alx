  assert_eq text_line(2, [wa([any("nm", valuer_value(LogValueName.new(first: "a", last: "b")))]), wg("G"), wa([group("H", [int64("c", 1), any("n2", valuer_value(LogValueName.new(first: "c", last: "d")))])])], [group("g", [group("h", [group("i", []), group("j", [int64("a", 1)])])])], test_time, level_info, "message"), "msg=message nm.first=a nm.last=b G.H.c=1 G.H.n2.first=c G.H.n2.last=d G.g.h.j.a=1"
