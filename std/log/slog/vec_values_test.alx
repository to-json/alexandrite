  assert_eq json_line(0, [], [string("k", "\ufffd")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\ufffd\"}"
  assert_eq text_line(0, [], [string("\ufffd", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\ufffd\"=v"
  assert_eq json_line(0, [], [string("\ufffd", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\ufffd\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "x\ufffdy")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"x\ufffdy\""
  assert_eq json_line(0, [], [string("k", "x\ufffdy")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"x\ufffdy\"}"
  assert_eq text_line(0, [], [string("x\ufffdy", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"x\ufffdy\"=v"
  assert_eq json_line(0, [], [string("x\ufffdy", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"x\ufffdy\":\"v\"}"
  assert_eq text_line(0, [], [string("k", Str.from_bytes(b([98, 97, 100, 117, 116, 102, 56, 246])))], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"badutf8\\xf6\""
  assert_eq json_line(0, [], [string("k", Str.from_bytes(b([98, 97, 100, 117, 116, 102, 56, 246])))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"badutf8\ufffd\"}"
  assert_eq text_line(0, [], [string(Str.from_bytes(b([98, 97, 100, 117, 116, 102, 56, 246])), "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"badutf8\\xf6\"=v"
  assert_eq json_line(0, [], [string(Str.from_bytes(b([98, 97, 100, 117, 116, 102, 56, 246])), "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"badutf8\ufffd\":\"v\"}"
  assert_eq text_line(0, [], [string("k", Str.from_bytes(b([255, 254])))], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\\xff\\xfe\""
  assert_eq json_line(0, [], [string("k", Str.from_bytes(b([255, 254])))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\ufffd\ufffd\"}"
  assert_eq text_line(0, [], [string(Str.from_bytes(b([255, 254])), "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\\xff\\xfe\"=v"
  assert_eq json_line(0, [], [string(Str.from_bytes(b([255, 254])), "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\ufffd\ufffd\":\"v\"}"
}

test "values 2" {
  assert_eq text_line(0, [], [string("k", Str.from_bytes(b([195])))], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\\xc3\""
  assert_eq json_line(0, [], [string("k", Str.from_bytes(b([195])))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\ufffd\"}"
  assert_eq text_line(0, [], [string(Str.from_bytes(b([195])), "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\\xc3\"=v"
  assert_eq json_line(0, [], [string(Str.from_bytes(b([195])), "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\ufffd\":\"v\"}"
  assert_eq text_line(0, [], [string("k", Str.from_bytes(b([226, 130])))], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\\xe2\\x82\""
  assert_eq json_line(0, [], [string("k", Str.from_bytes(b([226, 130])))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\ufffd\ufffd\"}"
  assert_eq text_line(0, [], [string(Str.from_bytes(b([226, 130])), "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\\xe2\\x82\"=v"
  assert_eq json_line(0, [], [string(Str.from_bytes(b([226, 130])), "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\ufffd\ufffd\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "\U0001f600")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\U0001f600"
  assert_eq json_line(0, [], [string("k", "\U0001f600")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\U0001f600\"}"
  assert_eq text_line(0, [], [string("\U0001f600", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \U0001f600=v"
  assert_eq json_line(0, [], [string("\U0001f600", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\U0001f600\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "\U0001f600x")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\U0001f600x"
  assert_eq json_line(0, [], [string("k", "\U0001f600x")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\U0001f600x\"}"
  assert_eq text_line(0, [], [string("\U0001f600x", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \U0001f600x=v"
  assert_eq json_line(0, [], [string("\U0001f600x", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\U0001f600x\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "<escapeHTML&>")], time.Time.new, level_info, "m"), "level=INFO msg=m k=<escapeHTML&>"
  assert_eq json_line(0, [], [string("k", "<escapeHTML&>")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"<escapeHTML&>\"}"
  assert_eq text_line(0, [], [string("<escapeHTML&>", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m <escapeHTML&>=v"
  assert_eq json_line(0, [], [string("<escapeHTML&>", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"<escapeHTML&>\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "\"[{escape}]\"")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\\\"[{escape}]\\\"\""
  assert_eq json_line(0, [], [string("k", "\"[{escape}]\"")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\\\"[{escape}]\\\"\"}"
  assert_eq text_line(0, [], [string("\"[{escape}]\"", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\\\"[{escape}]\\\"\"=v"
  assert_eq json_line(0, [], [string("\"[{escape}]\"", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\\\"[{escape}]\\\"\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "-123")], time.Time.new, level_info, "m"), "level=INFO msg=m k=-123"
  assert_eq json_line(0, [], [string("k", "-123")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"-123\"}"
  assert_eq text_line(0, [], [string("-123", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m -123=v"
  assert_eq json_line(0, [], [string("-123", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"-123\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "hello\x0d\n\t\x07")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"hello\\r\\n\\t\\a\""
  assert_eq json_line(0, [], [string("k", "hello\x0d\n\t\x07")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"hello\\r\\n\\t\\u0007\"}"
  assert_eq text_line(0, [], [string("hello\x0d\n\t\x07", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"hello\\r\\n\\t\\a\"=v"
  assert_eq json_line(0, [], [string("hello\x0d\n\t\x07", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"hello\\r\\n\\t\\u0007\":\"v\"}"
  assert_eq text_line(0, [], [string("k", Str.from_bytes(b([206, 184, 226, 128, 168, 226, 128, 169, 239, 191, 191, 246])))], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\u03b8\\u2028\\u2029\\uffff\\xf6\""
  assert_eq json_line(0, [], [string("k", Str.from_bytes(b([206, 184, 226, 128, 168, 226, 128, 169, 239, 191, 191, 246])))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\u03b8\\u2028\\u2029\uffff\ufffd\"}"
  assert_eq text_line(0, [], [string(Str.from_bytes(b([206, 184, 226, 128, 168, 226, 128, 169, 239, 191, 191, 246])), "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\u03b8\\u2028\\u2029\\uffff\\xf6\"=v"
  assert_eq json_line(0, [], [string(Str.from_bytes(b([206, 184, 226, 128, 168, 226, 128, 169, 239, 191, 191, 246])), "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\u03b8\\u2028\\u2029\uffff\ufffd\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "{}")], time.Time.new, level_info, "m"), "level=INFO msg=m k={}"
  assert_eq json_line(0, [], [string("k", "{}")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"{}\"}"
  assert_eq text_line(0, [], [string("{}", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m {}=v"
  assert_eq json_line(0, [], [string("{}", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"{}\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "[]")], time.Time.new, level_info, "m"), "level=INFO msg=m k=[]"
  assert_eq json_line(0, [], [string("k", "[]")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"[]\"}"
  assert_eq text_line(0, [], [string("[]", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m []=v"
  assert_eq json_line(0, [], [string("[]", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"[]\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "=")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"=\""
  assert_eq json_line(0, [], [string("k", "=")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"=\"}"
  assert_eq text_line(0, [], [string("=", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"=\"=v"
  assert_eq json_line(0, [], [string("=", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"=\":\"v\"}"
  assert_eq text_line(0, [], [string("k", " ")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\" \""
  assert_eq json_line(0, [], [string("k", " ")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\" \"}"
  assert_eq text_line(0, [], [string(" ", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \" \"=v"
  assert_eq json_line(0, [], [string(" ", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\" \":\"v\"}"
  assert_eq text_line(0, [], [string("k", "  lead")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"  lead\""
  assert_eq json_line(0, [], [string("k", "  lead")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"  lead\"}"
  assert_eq text_line(0, [], [string("  lead", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"  lead\"=v"
  assert_eq json_line(0, [], [string("  lead", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"  lead\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "trail ")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"trail \""
  assert_eq json_line(0, [], [string("k", "trail ")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"trail \"}"
  assert_eq text_line(0, [], [string("trail ", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"trail \"=v"
  assert_eq json_line(0, [], [string("trail ", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"trail \":\"v\"}"
  assert_eq text_line(0, [], [string("k", "\#hash")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\#hash"
  assert_eq json_line(0, [], [string("k", "\#hash")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\#hash\"}"
  assert_eq text_line(0, [], [string("\#hash", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \#hash=v"
  assert_eq json_line(0, [], [string("\#hash", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\#hash\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "\#{interp}")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\#{interp}"
  assert_eq json_line(0, [], [string("k", "\#{interp}")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\#{interp}\"}"
  assert_eq text_line(0, [], [string("\#{interp}", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \#{interp}=v"
  assert_eq json_line(0, [], [string("\#{interp}", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\#{interp}\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "a.b.c")], time.Time.new, level_info, "m"), "level=INFO msg=m k=a.b.c"
  assert_eq json_line(0, [], [string("k", "a.b.c")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"a.b.c\"}"
  assert_eq text_line(0, [], [string("a.b.c", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m a.b.c=v"
  assert_eq json_line(0, [], [string("a.b.c", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"a.b.c\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "key:value")], time.Time.new, level_info, "m"), "level=INFO msg=m k=key:value"
  assert_eq json_line(0, [], [string("k", "key:value")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"key:value\"}"
  assert_eq text_line(0, [], [string("key:value", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m key:value=v"
  assert_eq json_line(0, [], [string("key:value", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"key:value\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "'single'")], time.Time.new, level_info, "m"), "level=INFO msg=m k='single'"
  assert_eq json_line(0, [], [string("k", "'single'")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"'single'\"}"
  assert_eq text_line(0, [], [string("'single'", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m 'single'=v"
  assert_eq json_line(0, [], [string("'single'", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"'single'\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "`back`")], time.Time.new, level_info, "m"), "level=INFO msg=m k=`back`"
  assert_eq json_line(0, [], [string("k", "`back`")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"`back`\"}"
  assert_eq text_line(0, [], [string("`back`", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m `back`=v"
  assert_eq json_line(0, [], [string("`back`", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"`back`\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "~!@$%^&*()_+-")], time.Time.new, level_info, "m"), "level=INFO msg=m k=~!@$%^&*()_+-"
  assert_eq json_line(0, [], [string("k", "~!@$%^&*()_+-")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"~!@$%^&*()_+-\"}"
  assert_eq text_line(0, [], [string("~!@$%^&*()_+-", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m ~!@$%^&*()_+-=v"
  assert_eq json_line(0, [], [string("~!@$%^&*()_+-", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"~!@$%^&*()_+-\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "\u0085")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\\u0085\""
  assert_eq json_line(0, [], [string("k", "\u0085")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\u0085\"}"
  assert_eq text_line(0, [], [string("\u0085", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\\u0085\"=v"
  assert_eq json_line(0, [], [string("\u0085", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\u0085\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "\u00ad")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\\u00ad\""
  assert_eq json_line(0, [], [string("k", "\u00ad")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\u00ad\"}"
  assert_eq text_line(0, [], [string("\u00ad", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\\u00ad\"=v"
  assert_eq json_line(0, [], [string("\u00ad", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\u00ad\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "\u2060")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\\u2060\""
  assert_eq json_line(0, [], [string("k", "\u2060")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\u2060\"}"
  assert_eq text_line(0, [], [string("\u2060", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\\u2060\"=v"
  assert_eq json_line(0, [], [string("\u2060", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\u2060\":\"v\"}"
}

test "values 3" {
  assert_eq text_line(0, [], [string("k", "\ue000")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\\ue000\""
  assert_eq json_line(0, [], [string("k", "\ue000")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\ue000\"}"
  assert_eq text_line(0, [], [string("\ue000", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\\ue000\"=v"
  assert_eq json_line(0, [], [string("\ue000", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\ue000\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "\U000e0001")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\\U000e0001\""
  assert_eq json_line(0, [], [string("k", "\U000e0001")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\U000e0001\"}"
  assert_eq text_line(0, [], [string("\U000e0001", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\\U000e0001\"=v"
  assert_eq json_line(0, [], [string("\U000e0001", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\U000e0001\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "a\x1bb")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"a\\x1bb\""
  assert_eq json_line(0, [], [string("k", "a\x1bb")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"a\\u001bb\"}"
  assert_eq text_line(0, [], [string("a\x1bb", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"a\\x1bb\"=v"
  assert_eq json_line(0, [], [string("a\x1bb", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"a\\u001bb\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "\x08\x0c\x0b")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\\b\\f\\v\""
  assert_eq json_line(0, [], [string("k", "\x08\x0c\x0b")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\\u0008\\u000c\\u000b\"}"
  assert_eq text_line(0, [], [string("\x08\x0c\x0b", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\\b\\f\\v\"=v"
  assert_eq json_line(0, [], [string("\x08\x0c\x0b", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\\u0008\\u000c\\u000b\":\"v\"}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x0))], time.Time.new, level_info, "m"), "level=INFO msg=m f=0"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x0))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":0}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x8000000000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m f=-0"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x8000000000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":-0}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x3ff0000000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x3ff0000000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":1}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0xbff0000000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m f=-1"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0xbff0000000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":-1}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x3fc3333333333333))], time.Time.new, level_info, "m"), "level=INFO msg=m f=0.15"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x3fc3333333333333))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":0.15}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x400c000000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m f=3.5"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x400c000000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":3.5}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0xc029800000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m f=-12.75"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0xc029800000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":-12.75}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x3e152198e2aaa6a8))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1.23e-09"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x3e152198e2aaa6a8))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":1.23e-9}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x3eb0c6f7a0b5ed8d))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1e-06"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x3eb0c6f7a0b5ed8d))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":0.000001}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x3eb0c2ac1dbbe3d8))], time.Time.new, level_info, "m"), "level=INFO msg=m f=9.99e-07"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x3eb0c2ac1dbbe3d8))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":9.99e-7}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x4415af1d78b58c40))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1e+20"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x4415af1d78b58c40))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":100000000000000000000}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x444b1ae4d6e2ef50))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1e+21"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x444b1ae4d6e2ef50))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":1e+21}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x4454542ba12a337c))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1.5e+21"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x4454542ba12a337c))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":1.5e+21}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x419d6f3454800000))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1.23456789125e+08"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x419d6f3454800000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":123456789.125}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x430c6bf526340000))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1e+15"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x430c6bf526340000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":1000000000000000}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x4341c37937e08000))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1e+16"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x4341c37937e08000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":10000000000000000}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x3efa36e2eb1c432d))], time.Time.new, level_info, "m"), "level=INFO msg=m f=2.5e-05"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x3efa36e2eb1c432d))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":0.000025}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x7fefffffffffffff))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1.7976931348623157e+308"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x7fefffffffffffff))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":1.7976931348623157e+308}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x1))], time.Time.new, level_info, "m"), "level=INFO msg=m f=5e-324"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x1))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":5e-324}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x3fd5555555555555))], time.Time.new, level_info, "m"), "level=INFO msg=m f=0.3333333333333333"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x3fd5555555555555))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":0.3333333333333333}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x4059000000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m f=100"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x4059000000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":100}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x54b249ad2594c37d))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1e+100"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x54b249ad2594c37d))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":1e+100}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0xab2bff2ee48e0530))], time.Time.new, level_info, "m"), "level=INFO msg=m f=-1e-100"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0xab2bff2ee48e0530))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":-1e-100}"
  assert_eq text_line(0, [], [float64("f", math.nan)], time.Time.new, level_info, "m"), "level=INFO msg=m f=NaN"
  assert_eq json_line(0, [], [float64("f", math.nan)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":\"!ERROR:json: unsupported value: NaN\"}"
  assert_eq text_line(0, [], [float64("f", math.inf(1))], time.Time.new, level_info, "m"), "level=INFO msg=m f=+Inf"
  assert_eq json_line(0, [], [float64("f", math.inf(1))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":\"!ERROR:json: unsupported value: +Inf\"}"
  assert_eq text_line(0, [], [float64("f", math.inf(-1))], time.Time.new, level_info, "m"), "level=INFO msg=m f=-Inf"
  assert_eq json_line(0, [], [float64("f", math.inf(-1))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":\"!ERROR:json: unsupported value: -Inf\"}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x3fb999999999999a))], time.Time.new, level_info, "m"), "level=INFO msg=m f=0.1"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x3fb999999999999a))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":0.1}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x3eb4b3fd5942cd96))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1.234e-06"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x3eb4b3fd5942cd96))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":0.000001234}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x43e56a95319d63e1))], time.Time.new, level_info, "m"), "level=INFO msg=m f=1.2345678901234567e+19"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x43e56a95319d63e1))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":12345678901234567000}"
  assert_eq text_line(0, [], [float64("f", math.float64frombits(0x400921f9f01b866e))], time.Time.new, level_info, "m"), "level=INFO msg=m f=3.14159"
  assert_eq json_line(0, [], [float64("f", math.float64frombits(0x400921f9f01b866e))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"f\":3.14159}"
  assert_eq text_line(0, [], [int64("i", 0)], time.Time.new, level_info, "m"), "level=INFO msg=m i=0"
  assert_eq json_line(0, [], [int64("i", 0)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"i\":0}"
  assert_eq text_line(0, [], [int64("i", 1)], time.Time.new, level_info, "m"), "level=INFO msg=m i=1"
  assert_eq json_line(0, [], [int64("i", 1)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"i\":1}"
  assert_eq text_line(0, [], [int64("i", -1)], time.Time.new, level_info, "m"), "level=INFO msg=m i=-1"
  assert_eq json_line(0, [], [int64("i", -1)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"i\":-1}"
  assert_eq text_line(0, [], [int64("i", 42)], time.Time.new, level_info, "m"), "level=INFO msg=m i=42"
  assert_eq json_line(0, [], [int64("i", 42)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"i\":42}"
  assert_eq text_line(0, [], [int64("i", -3)], time.Time.new, level_info, "m"), "level=INFO msg=m i=-3"
  assert_eq json_line(0, [], [int64("i", -3)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"i\":-3}"
  assert_eq text_line(0, [], [int64("i", 9223372036854775807)], time.Time.new, level_info, "m"), "level=INFO msg=m i=9223372036854775807"
  assert_eq json_line(0, [], [int64("i", 9223372036854775807)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"i\":9223372036854775807}"
  assert_eq text_line(0, [], [int64("i", -9223372036854775808)], time.Time.new, level_info, "m"), "level=INFO msg=m i=-9223372036854775808"
  assert_eq json_line(0, [], [int64("i", -9223372036854775808)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"i\":-9223372036854775808}"
  assert_eq text_line(0, [], [int64("i", 1000000000000000)], time.Time.new, level_info, "m"), "level=INFO msg=m i=1000000000000000"
  assert_eq json_line(0, [], [int64("i", 1000000000000000)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"i\":1000000000000000}"
  assert_eq text_line(0, [], [int64("i", -9200123456789123456)], time.Time.new, level_info, "m"), "level=INFO msg=m i=-9200123456789123456"
  assert_eq json_line(0, [], [int64("i", -9200123456789123456)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"i\":-9200123456789123456}"
  assert_eq text_line(0, [], [uint64("u", 0)], time.Time.new, level_info, "m"), "level=INFO msg=m u=0"
  assert_eq json_line(0, [], [uint64("u", 0)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"u\":0}"
  assert_eq text_line(0, [], [uint64("u", 1)], time.Time.new, level_info, "m"), "level=INFO msg=m u=1"
  assert_eq json_line(0, [], [uint64("u", 1)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"u\":1}"
  assert_eq text_line(0, [], [uint64("u", 999)], time.Time.new, level_info, "m"), "level=INFO msg=m u=999"
  assert_eq json_line(0, [], [uint64("u", 999)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"u\":999}"
}

test "values 4" {
  assert_eq text_line(0, [], [uint64("u", 18446744073709551615)], time.Time.new, level_info, "m"), "level=INFO msg=m u=18446744073709551615"
  assert_eq json_line(0, [], [uint64("u", 18446744073709551615)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"u\":18446744073709551615}"
  assert_eq text_line(0, [], [uint64("u", 9200123456789123456)], time.Time.new, level_info, "m"), "level=INFO msg=m u=9200123456789123456"
  assert_eq json_line(0, [], [uint64("u", 9200123456789123456)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"u\":9200123456789123456}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(0))], time.Time.new, level_info, "m"), "level=INFO msg=m d=0s"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(0))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":0}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(1))], time.Time.new, level_info, "m"), "level=INFO msg=m d=1ns"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(1))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":1}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(1000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m d=1s"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(1000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":1000000000}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(3000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m d=3s"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(3000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":3000000000}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(60000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m d=1m0s"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(60000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":60000000000}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(5400000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m d=1h30m0s"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(5400000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":5400000000000}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(1500000000))], time.Time.new, level_info, "m"), "level=INFO msg=m d=1.5s"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(1500000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":1500000000}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(-120000000000))], time.Time.new, level_info, "m"), "level=INFO msg=m d=-2m0s"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(-120000000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":-120000000000}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(9223372036854775807))], time.Time.new, level_info, "m"), "level=INFO msg=m d=2562047h47m16.854775807s"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(9223372036854775807))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":9223372036854775807}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(-9223372036854775808))], time.Time.new, level_info, "m"), "level=INFO msg=m d=-2562047h47m16.854775808s"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(-9223372036854775808))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":-9223372036854775808}"
  assert_eq text_line(0, [], [duration("d", time.Duration.new(259380500000000))], time.Time.new, level_info, "m"), "level=INFO msg=m d=72h3m0.5s"
  assert_eq json_line(0, [], [duration("d", time.Duration.new(259380500000000))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"d\":259380500000000}"
  assert_eq text_line(0, [], [time_attr("t", time.date(2000, 1, 2, 3, 4, 5, 0, time.utc))], time.Time.new, level_info, "m"), "level=INFO msg=m t=2000-01-02T03:04:05.000Z"
  assert_eq json_line(0, [], [time_attr("t", time.date(2000, 1, 2, 3, 4, 5, 0, time.utc))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"2000-01-02T03:04:05Z\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(2000, 1, 2, 3, 4, 5, 400, time.utc))], time.Time.new, level_info, "m"), "level=INFO msg=m t=2000-01-02T03:04:05.000Z"
  assert_eq json_line(0, [], [time_attr("t", time.date(2000, 1, 2, 3, 4, 5, 400, time.utc))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"2000-01-02T03:04:05.0000004Z\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(2000, 11, 12, 3, 12, 20, 50000000, time.utc))], time.Time.new, level_info, "m"), "level=INFO msg=m t=2000-11-12T03:12:20.050Z"
  assert_eq json_line(0, [], [time_attr("t", time.date(2000, 11, 12, 3, 12, 20, 50000000, time.utc))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"2000-11-12T03:12:20.05Z\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(2022, 3, 4, 5, 6, 7, 823456789, time.utc))], time.Time.new, level_info, "m"), "level=INFO msg=m t=2022-03-04T05:06:07.823Z"
  assert_eq json_line(0, [], [time_attr("t", time.date(2022, 3, 4, 5, 6, 7, 823456789, time.utc))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"2022-03-04T05:06:07.823456789Z\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(2022, 3, 4, 5, 6, 7, 823456789, time.fixed_zone("EST", -18000)))], time.Time.new, level_info, "m"), "level=INFO msg=m t=2022-03-04T05:06:07.823-05:00"
  assert_eq json_line(0, [], [time_attr("t", time.date(2022, 3, 4, 5, 6, 7, 823456789, time.fixed_zone("EST", -18000)))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"2022-03-04T05:06:07.823456789-05:00\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(1999, 12, 31, 23, 59, 59, 999999999, time.fixed_zone("", 19800)))], time.Time.new, level_info, "m"), "level=INFO msg=m t=1999-12-31T23:59:59.999+05:30"
  assert_eq json_line(0, [], [time_attr("t", time.date(1999, 12, 31, 23, 59, 59, 999999999, time.fixed_zone("", 19800)))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"1999-12-31T23:59:59.999999999+05:30\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(1, 1, 1, 0, 0, 0, 1, time.utc))], time.Time.new, level_info, "m"), "level=INFO msg=m t=0001-01-01T00:00:00.000Z"
  assert_eq json_line(0, [], [time_attr("t", time.date(1, 1, 1, 0, 0, 0, 1, time.utc))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"0001-01-01T00:00:00.000000001Z\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(9999, 12, 31, 23, 59, 59, 0, time.utc))], time.Time.new, level_info, "m"), "level=INFO msg=m t=9999-12-31T23:59:59.000Z"
  assert_eq json_line(0, [], [time_attr("t", time.date(9999, 12, 31, 23, 59, 59, 0, time.utc))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"9999-12-31T23:59:59Z\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(10000, 1, 1, 0, 0, 0, 0, time.utc))], time.Time.new, level_info, "m"), "level=INFO msg=m t=10000-01-01T00:00:00.001Z"
  assert_eq json_line(0, [], [time_attr("t", time.date(10000, 1, 1, 0, 0, 0, 0, time.utc))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"!ERROR:time.Time year outside of range [0,9999]\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(-1, 1, 1, 0, 0, 0, 0, time.utc))], time.Time.new, level_info, "m"), "level=INFO msg=m t=-0001-01-01T00:00:00.001Z"
  assert_eq json_line(0, [], [time_attr("t", time.date(-1, 1, 1, 0, 0, 0, 0, time.utc))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"!ERROR:time.Time year outside of range [0,9999]\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(2300, 1, 1, 0, 0, 0, 0, time.utc))], time.Time.new, level_info, "m"), "level=INFO msg=m t=2300-01-01T00:00:00.000Z"
  assert_eq json_line(0, [], [time_attr("t", time.date(2300, 1, 1, 0, 0, 0, 0, time.utc))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"2300-01-01T00:00:00Z\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(1715, 6, 13, 0, 25, 26, 290448384, time.utc))], time.Time.new, level_info, "m"), "level=INFO msg=m t=1715-06-13T00:25:26.290Z"
  assert_eq json_line(0, [], [time_attr("t", time.date(1715, 6, 13, 0, 25, 26, 290448384, time.utc))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"1715-06-13T00:25:26.290448384Z\"}"
  assert_eq text_line(0, [], [time_attr("t", time.date(2024, 2, 29, 12, 0, 0, 120000000, time.fixed_zone("X", -12600)))], time.Time.new, level_info, "m"), "level=INFO msg=m t=2024-02-29T12:00:00.120-03:30"
  assert_eq json_line(0, [], [time_attr("t", time.date(2024, 2, 29, 12, 0, 0, 120000000, time.fixed_zone("X", -12600)))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"2024-02-29T12:00:00.12-03:30\"}"
  assert_eq text_line(0, [], [bool("b", true)], time.Time.new, level_info, "m"), "level=INFO msg=m b=true"
  assert_eq json_line(0, [], [bool("b", true)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"b\":true}"
  assert_eq text_line(0, [], [bool("b", false)], time.Time.new, level_info, "m"), "level=INFO msg=m b=false"
  assert_eq json_line(0, [], [bool("b", false)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"b\":false}"
  assert_eq text_line(0, [], [any("n", nil_value)], time.Time.new, level_info, "m"), "level=INFO msg=m n=<nil>"
  assert_eq json_line(0, [], [any("n", nil_value)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"n\":null}"
  assert_eq text_line(0, [], [any("", nil_value)], time.Time.new, level_info, "m"), "level=INFO msg=m"
  assert_eq json_line(0, [], [any("", nil_value)], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\"}"
  assert_eq text_line(0, [], [any("e", error_value("EOF"))], time.Time.new, level_info, "m"), "level=INFO msg=m e=EOF"
  assert_eq json_line(0, [], [any("e", error_value("EOF"))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"e\":\"EOF\"}"
  assert_eq text_line(0, [], [any("e", error_value("bad thing: \"x\""))], time.Time.new, level_info, "m"), "level=INFO msg=m e=\"bad thing: \\\"x\\\"\""
  assert_eq json_line(0, [], [any("e", error_value("bad thing: \"x\""))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"e\":\"bad thing: \\\"x\\\"\"}"
  assert_eq text_line(0, [], [any("bs", bytes_value(b([1, 2, 3, 4])))], time.Time.new, level_info, "m"), "level=INFO msg=m bs=\"\\x01\\x02\\x03\\x04\""
  assert_eq json_line(0, [], [any("bs", bytes_value(b([1, 2, 3, 4])))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"bs\":\"AQIDBA==\"}"
  assert_eq text_line(0, [], [any("bs", bytes_value(b([104, 101, 108, 108, 111])))], time.Time.new, level_info, "m"), "level=INFO msg=m bs=\"hello\""
  assert_eq json_line(0, [], [any("bs", bytes_value(b([104, 101, 108, 108, 111])))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"bs\":\"aGVsbG8=\"}"
  assert_eq text_line(0, [], [any("bs", bytes_value(b([])))], time.Time.new, level_info, "m"), "level=INFO msg=m bs=\"\""
  assert_eq json_line(0, [], [any("bs", bytes_value(b([])))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"bs\":\"\"}"
  assert_eq text_line(0, [], [any("bs", bytes_value(b([255, 0, 97])))], time.Time.new, level_info, "m"), "level=INFO msg=m bs=\"\\xff\\x00a\""
  assert_eq json_line(0, [], [any("bs", bytes_value(b([255, 0, 97])))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"bs\":\"/wBh\"}"
  assert_eq text_line(0, [], [any("r", raw_json_value("1234"))], time.Time.new, level_info, "m"), "level=INFO msg=m r=\"1234\""
  assert_eq json_line(0, [], [any("r", raw_json_value("1234"))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"r\":1234}"
  assert_eq text_line(0, [], [any("r", raw_json_value("{\"a\": [1, 2]}"))], time.Time.new, level_info, "m"), "level=INFO msg=m r=\"{\\\"a\\\": [1, 2]}\""
  assert_eq json_line(0, [], [any("r", raw_json_value("{\"a\": [1, 2]}"))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"r\":{\"a\":[1,2]}}"
  assert_eq text_line(0, [], [any("r", raw_json_value("\"x\""))], time.Time.new, level_info, "m"), "level=INFO msg=m r=\"\\\"x\\\"\""
  assert_eq json_line(0, [], [any("r", raw_json_value("\"x\""))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"r\":\"x\"}"
  assert_eq text_line(0, [], [any("r", raw_json_value("  null "))], time.Time.new, level_info, "m"), "level=INFO msg=m r=\"  null \""
  assert_eq json_line(0, [], [any("r", raw_json_value("  null "))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"r\":null}"
  assert_eq text_line(0, [], [any("l", level_value(Level.new(n: -4)))], time.Time.new, level_info, "m"), "level=INFO msg=m l=DEBUG"
  assert_eq json_line(0, [], [any("l", level_value(Level.new(n: -4)))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"l\":\"DEBUG\"}"
  assert_eq text_line(0, [], [any("l", level_value(Level.new(n: 5)))], time.Time.new, level_info, "m"), "level=INFO msg=m l=WARN+1"
  assert_eq json_line(0, [], [any("l", level_value(Level.new(n: 5)))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"l\":\"WARN+1\"}"
  assert_eq text_line(0, [], [any("l", level_value(Level.new(n: 100)))], time.Time.new, level_info, "m"), "level=INFO msg=m l=ERROR+92"
  assert_eq json_line(0, [], [any("l", level_value(Level.new(n: 100)))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"l\":\"ERROR+92\"}"
  assert_eq text_line(0, [], [any("l", level_value(Level.new(n: -10)))], time.Time.new, level_info, "m"), "level=INFO msg=m l=DEBUG-6"
  assert_eq json_line(0, [], [any("l", level_value(Level.new(n: -10)))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"l\":\"DEBUG-6\"}"
  assert_eq text_line(0, [], [any("kd", kind_value(1))], time.Time.new, level_info, "m"), "level=INFO msg=m kd=Bool"
  assert_eq json_line(0, [], [any("kd", kind_value(1))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"kd\":1}"
  assert_eq text_line(0, [], [any("kd", kind_value(8))], time.Time.new, level_info, "m"), "level=INFO msg=m kd=Group"
  assert_eq json_line(0, [], [any("kd", kind_value(8))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"kd\":8}"
  assert_eq text_line(0, [], [any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek")))], time.Time.new, level_info, "m"), "level=INFO msg=m name.first=Ren name.last=Hoek"
  assert_eq json_line(0, [], [any("name", valuer_value(LogValueName.new(first: "Ren", last: "Hoek")))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"name\":{\"first\":\"Ren\",\"last\":\"Hoek\"}}"
  assert_eq text_line(0, [], [any("", valuer_value(LogValueName.new(first: "a", last: "b")))], time.Time.new, level_info, "m"), "level=INFO msg=m first=a last=b"
  assert_eq json_line(0, [], [any("", valuer_value(LogValueName.new(first: "a", last: "b")))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"first\":\"a\",\"last\":\"b\"}"
  assert_eq text_line(0, [], [any("n m", valuer_value(LogValueName.new(first: "x y", last: "")))], time.Time.new, level_info, "m"), "level=INFO msg=m \"n m.first\"=\"x y\" \"n m.last\"=\"\""
  assert_eq json_line(0, [], [any("n m", valuer_value(LogValueName.new(first: "x y", last: "")))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"n m\":{\"first\":\"x y\",\"last\":\"\"}}"
  assert_eq text_line(0, [], [any("t", any_value(TextM.new(s: "abc")))], time.Time.new, level_info, "m"), "level=INFO msg=m t=\"text{\\\"abc\\\"}\""
  assert_eq json_line(0, [], [any("t", any_value(TextM.new(s: "abc")))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"text{\\\"abc\\\"}\"}"
}

test "values 5" {
  assert_eq text_line(0, [], [any("t", any_value(TextM.new(s: "")))], time.Time.new, level_info, "m"), "level=INFO msg=m t=\"!ERROR:text: empty string\""
  assert_eq json_line(0, [], [any("t", any_value(TextM.new(s: "")))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"!ERROR:json: error calling MarshalText for type *main.textM: text: empty string\"}"
  assert_eq text_line(0, [], [any("t", any_value(TextM.new(s: "a b")))], time.Time.new, level_info, "m"), "level=INFO msg=m t=\"text{\\\"a b\\\"}\""
  assert_eq json_line(0, [], [any("t", any_value(TextM.new(s: "a b")))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"t\":\"text{\\\"a b\\\"}\"}"
  assert_eq text_line(0, [], [any("j", any_value(JsonM.new(s: "xyz")))], time.Time.new, level_info, "m"), "level=INFO msg=m j={s:xyz}"
  assert_eq json_line(0, [], [any("j", any_value(JsonM.new(s: "xyz")))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"j\":[\"xyz\"]}"
  assert_eq text_line(0, [], [any("j", any_value(JsonM.new(s: "")))], time.Time.new, level_info, "m"), "level=INFO msg=m j={s:}"
  assert_eq json_line(0, [], [any("j", any_value(JsonM.new(s: "")))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"j\":\"!ERROR:json: error calling MarshalJSON for type *main.jsonM: json: empty string\"}"
  assert_eq text_line(0, [], [any("j", any_value(JsonM.new(s: "a\"b\\c\td\ne\x00f<>&")))], time.Time.new, level_info, "m"), "level=INFO msg=m j=\"{s:a\\\"b\\\\c\\td\\ne\\x00f<>&}\""
  assert_eq json_line(0, [], [any("j", any_value(JsonM.new(s: "a\"b\\c\td\ne\x00f<>&")))], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"j\":[\"a\\\"b\\\\c\\td\\ne\\u0000f\\u003c\\u003e\\u0026\"]}"
  assert_eq string("k", "").value.to_s, ""
  assert_eq string("", "v").value.to_s, "v"
  assert_eq string("k", "a").value.to_s, "a"
  assert_eq string("a", "v").value.to_s, "v"
  assert_eq string("k", "ab").value.to_s, "ab"
  assert_eq string("ab", "v").value.to_s, "v"
  assert_eq string("k", "a b").value.to_s, "a b"
  assert_eq string("a b", "v").value.to_s, "v"
  assert_eq string("k", "a=b").value.to_s, "a=b"
  assert_eq string("a=b", "v").value.to_s, "v"
  assert_eq string("k", "a\"b").value.to_s, "a\"b"
  assert_eq string("a\"b", "v").value.to_s, "v"
  assert_eq string("k", "a\\b").value.to_s, "a\\b"
  assert_eq string("a\\b", "v").value.to_s, "v"
  assert_eq string("k", "a\tb").value.to_s, "a\tb"
  assert_eq string("a\tb", "v").value.to_s, "v"
  assert_eq string("k", "a\nb").value.to_s, "a\nb"
  assert_eq string("a\nb", "v").value.to_s, "v"
  assert_eq string("k", "a\x0db").value.to_s, "a\x0db"
  assert_eq string("a\x0db", "v").value.to_s, "v"
  assert_eq string("k", "\x00").value.to_s, "\x00"
  assert_eq string("\x00", "v").value.to_s, "v"
  assert_eq string("k", "\x01\x02").value.to_s, "\x01\x02"
  assert_eq string("\x01\x02", "v").value.to_s, "v"
  assert_eq string("k", "\x7f").value.to_s, "\x7f"
  assert_eq string("\x7f", "v").value.to_s, "v"
  assert_eq string("k", "\u00b5\u00e5\u03c0").value.to_s, "\u00b5\u00e5\u03c0"
  assert_eq string("\u00b5\u00e5\u03c0", "v").value.to_s, "v"
  assert_eq string("k", "\u65e5\u672c\u8a9e").value.to_s, "\u65e5\u672c\u8a9e"
  assert_eq string("\u65e5\u672c\u8a9e", "v").value.to_s, "v"
  assert_eq string("k", "\u00a0").value.to_s, "\u00a0"
  assert_eq string("\u00a0", "v").value.to_s, "v"
  assert_eq string("k", "\u2028").value.to_s, "\u2028"
  assert_eq string("\u2028", "v").value.to_s, "v"
  assert_eq string("k", "\u2029").value.to_s, "\u2029"
  assert_eq string("\u2029", "v").value.to_s, "v"
  assert_eq string("k", "\u3000").value.to_s, "\u3000"
  assert_eq string("\u3000", "v").value.to_s, "v"
  assert_eq string("k", "\u200b").value.to_s, "\u200b"
  assert_eq string("\u200b", "v").value.to_s, "v"
  assert_eq string("k", "\ufeff").value.to_s, "\ufeff"
  assert_eq string("\ufeff", "v").value.to_s, "v"
  assert_eq string("k", "\ufffd").value.to_s, "\ufffd"
  assert_eq string("\ufffd", "v").value.to_s, "v"
  assert_eq string("k", "x\ufffdy").value.to_s, "x\ufffdy"
  assert_eq string("x\ufffdy", "v").value.to_s, "v"
  assert_eq string("k", Str.from_bytes(b([98, 97, 100, 117, 116, 102, 56, 246]))).value.to_s, Str.from_bytes(b([98, 97, 100, 117, 116, 102, 56, 246]))
  assert_eq string(Str.from_bytes(b([98, 97, 100, 117, 116, 102, 56, 246])), "v").value.to_s, "v"
  assert_eq string("k", Str.from_bytes(b([255, 254]))).value.to_s, Str.from_bytes(b([255, 254]))
  assert_eq string(Str.from_bytes(b([255, 254])), "v").value.to_s, "v"
  assert_eq string("k", Str.from_bytes(b([195]))).value.to_s, Str.from_bytes(b([195]))
  assert_eq string(Str.from_bytes(b([195])), "v").value.to_s, "v"
  assert_eq string("k", Str.from_bytes(b([226, 130]))).value.to_s, Str.from_bytes(b([226, 130]))
  assert_eq string(Str.from_bytes(b([226, 130])), "v").value.to_s, "v"
  assert_eq string("k", "\U0001f600").value.to_s, "\U0001f600"
  assert_eq string("\U0001f600", "v").value.to_s, "v"
  assert_eq string("k", "\U0001f600x").value.to_s, "\U0001f600x"
  assert_eq string("\U0001f600x", "v").value.to_s, "v"
  assert_eq string("k", "<escapeHTML&>").value.to_s, "<escapeHTML&>"
  assert_eq string("<escapeHTML&>", "v").value.to_s, "v"
  assert_eq string("k", "\"[{escape}]\"").value.to_s, "\"[{escape}]\""
  assert_eq string("\"[{escape}]\"", "v").value.to_s, "v"
  assert_eq string("k", "-123").value.to_s, "-123"
  assert_eq string("-123", "v").value.to_s, "v"
  assert_eq string("k", "hello\x0d\n\t\x07").value.to_s, "hello\x0d\n\t\x07"
  assert_eq string("hello\x0d\n\t\x07", "v").value.to_s, "v"
  assert_eq string("k", Str.from_bytes(b([206, 184, 226, 128, 168, 226, 128, 169, 239, 191, 191, 246]))).value.to_s, Str.from_bytes(b([206, 184, 226, 128, 168, 226, 128, 169, 239, 191, 191, 246]))
  assert_eq string(Str.from_bytes(b([206, 184, 226, 128, 168, 226, 128, 169, 239, 191, 191, 246])), "v").value.to_s, "v"
  assert_eq string("k", "{}").value.to_s, "{}"
  assert_eq string("{}", "v").value.to_s, "v"
  assert_eq string("k", "[]").value.to_s, "[]"
  assert_eq string("[]", "v").value.to_s, "v"
  assert_eq string("k", "=").value.to_s, "="
  assert_eq string("=", "v").value.to_s, "v"
  assert_eq string("k", " ").value.to_s, " "
  assert_eq string(" ", "v").value.to_s, "v"
  assert_eq string("k", "  lead").value.to_s, "  lead"
  assert_eq string("  lead", "v").value.to_s, "v"
  assert_eq string("k", "trail ").value.to_s, "trail "
  assert_eq string("trail ", "v").value.to_s, "v"
  assert_eq string("k", "\#hash").value.to_s, "\#hash"
  assert_eq string("\#hash", "v").value.to_s, "v"
  assert_eq string("k", "\#{interp}").value.to_s, "\#{interp}"
  assert_eq string("\#{interp}", "v").value.to_s, "v"
  assert_eq string("k", "a.b.c").value.to_s, "a.b.c"
  assert_eq string("a.b.c", "v").value.to_s, "v"
  assert_eq string("k", "key:value").value.to_s, "key:value"
  assert_eq string("key:value", "v").value.to_s, "v"
  assert_eq string("k", "'single'").value.to_s, "'single'"
  assert_eq string("'single'", "v").value.to_s, "v"
}

test "values 6" {
  assert_eq string("k", "`back`").value.to_s, "`back`"
  assert_eq string("`back`", "v").value.to_s, "v"
  assert_eq string("k", "~!@$%^&*()_+-").value.to_s, "~!@$%^&*()_+-"
  assert_eq string("~!@$%^&*()_+-", "v").value.to_s, "v"
  assert_eq string("k", "\u0085").value.to_s, "\u0085"
  assert_eq string("\u0085", "v").value.to_s, "v"
  assert_eq string("k", "\u00ad").value.to_s, "\u00ad"
  assert_eq string("\u00ad", "v").value.to_s, "v"
  assert_eq string("k", "\u2060").value.to_s, "\u2060"
  assert_eq string("\u2060", "v").value.to_s, "v"
  assert_eq string("k", "\ue000").value.to_s, "\ue000"
  assert_eq string("\ue000", "v").value.to_s, "v"
  assert_eq string("k", "\U000e0001").value.to_s, "\U000e0001"
  assert_eq string("\U000e0001", "v").value.to_s, "v"
  assert_eq string("k", "a\x1bb").value.to_s, "a\x1bb"
  assert_eq string("a\x1bb", "v").value.to_s, "v"
  assert_eq string("k", "\x08\x0c\x0b").value.to_s, "\x08\x0c\x0b"
  assert_eq string("\x08\x0c\x0b", "v").value.to_s, "v"
  assert_eq float64("f", math.float64frombits(0x0)).value.to_s, "0"
  assert_eq float64("f", math.float64frombits(0x8000000000000000)).value.to_s, "-0"
  assert_eq float64("f", math.float64frombits(0x3ff0000000000000)).value.to_s, "1"
  assert_eq float64("f", math.float64frombits(0xbff0000000000000)).value.to_s, "-1"
  assert_eq float64("f", math.float64frombits(0x3fc3333333333333)).value.to_s, "0.15"
  assert_eq float64("f", math.float64frombits(0x400c000000000000)).value.to_s, "3.5"
  assert_eq float64("f", math.float64frombits(0xc029800000000000)).value.to_s, "-12.75"
  assert_eq float64("f", math.float64frombits(0x3e152198e2aaa6a8)).value.to_s, "1.23e-09"
  assert_eq float64("f", math.float64frombits(0x3eb0c6f7a0b5ed8d)).value.to_s, "1e-06"
  assert_eq float64("f", math.float64frombits(0x3eb0c2ac1dbbe3d8)).value.to_s, "9.99e-07"
  assert_eq float64("f", math.float64frombits(0x4415af1d78b58c40)).value.to_s, "1e+20"
  assert_eq float64("f", math.float64frombits(0x444b1ae4d6e2ef50)).value.to_s, "1e+21"
  assert_eq float64("f", math.float64frombits(0x4454542ba12a337c)).value.to_s, "1.5e+21"
  assert_eq float64("f", math.float64frombits(0x419d6f3454800000)).value.to_s, "1.23456789125e+08"
  assert_eq float64("f", math.float64frombits(0x430c6bf526340000)).value.to_s, "1e+15"
  assert_eq float64("f", math.float64frombits(0x4341c37937e08000)).value.to_s, "1e+16"
  assert_eq float64("f", math.float64frombits(0x3efa36e2eb1c432d)).value.to_s, "2.5e-05"
  assert_eq float64("f", math.float64frombits(0x7fefffffffffffff)).value.to_s, "1.7976931348623157e+308"
  assert_eq float64("f", math.float64frombits(0x1)).value.to_s, "5e-324"
  assert_eq float64("f", math.float64frombits(0x3fd5555555555555)).value.to_s, "0.3333333333333333"
  assert_eq float64("f", math.float64frombits(0x4059000000000000)).value.to_s, "100"
  assert_eq float64("f", math.float64frombits(0x54b249ad2594c37d)).value.to_s, "1e+100"
  assert_eq float64("f", math.float64frombits(0xab2bff2ee48e0530)).value.to_s, "-1e-100"
  assert_eq float64("f", math.nan).value.to_s, "NaN"
  assert_eq float64("f", math.inf(1)).value.to_s, "+Inf"
  assert_eq float64("f", math.inf(-1)).value.to_s, "-Inf"
  assert_eq float64("f", math.float64frombits(0x3fb999999999999a)).value.to_s, "0.1"
  assert_eq float64("f", math.float64frombits(0x3eb4b3fd5942cd96)).value.to_s, "1.234e-06"
  assert_eq float64("f", math.float64frombits(0x43e56a95319d63e1)).value.to_s, "1.2345678901234567e+19"
  assert_eq float64("f", math.float64frombits(0x400921f9f01b866e)).value.to_s, "3.14159"
  assert_eq int64("i", 0).value.to_s, "0"
  assert_eq int64("i", 1).value.to_s, "1"
  assert_eq int64("i", -1).value.to_s, "-1"
  assert_eq int64("i", 42).value.to_s, "42"
  assert_eq int64("i", -3).value.to_s, "-3"
  assert_eq int64("i", 9223372036854775807).value.to_s, "9223372036854775807"
  assert_eq int64("i", -9223372036854775808).value.to_s, "-9223372036854775808"
  assert_eq int64("i", 1000000000000000).value.to_s, "1000000000000000"
  assert_eq int64("i", -9200123456789123456).value.to_s, "-9200123456789123456"
  assert_eq uint64("u", 0).value.to_s, "0"
  assert_eq uint64("u", 1).value.to_s, "1"
  assert_eq uint64("u", 999).value.to_s, "999"
  assert_eq uint64("u", 18446744073709551615).value.to_s, "18446744073709551615"
  assert_eq uint64("u", 9200123456789123456).value.to_s, "9200123456789123456"
  assert_eq duration("d", time.Duration.new(0)).value.to_s, "0s"
  assert_eq duration("d", time.Duration.new(1)).value.to_s, "1ns"
  assert_eq duration("d", time.Duration.new(1000000000)).value.to_s, "1s"
  assert_eq duration("d", time.Duration.new(3000000000)).value.to_s, "3s"
  assert_eq duration("d", time.Duration.new(60000000000)).value.to_s, "1m0s"
  assert_eq duration("d", time.Duration.new(5400000000000)).value.to_s, "1h30m0s"
  assert_eq duration("d", time.Duration.new(1500000000)).value.to_s, "1.5s"
  assert_eq duration("d", time.Duration.new(-120000000000)).value.to_s, "-2m0s"
  assert_eq duration("d", time.Duration.new(9223372036854775807)).value.to_s, "2562047h47m16.854775807s"
  assert_eq duration("d", time.Duration.new(-9223372036854775808)).value.to_s, "-2562047h47m16.854775808s"
  assert_eq duration("d", time.Duration.new(259380500000000)).value.to_s, "72h3m0.5s"
  assert_eq time_attr("t", time.date(2000, 1, 2, 3, 4, 5, 0, time.utc)).value.to_s, "2000-01-02 03:04:05 +0000 UTC"
  assert_eq time_attr("t", time.date(2000, 1, 2, 3, 4, 5, 400, time.utc)).value.to_s, "2000-01-02 03:04:05.0000004 +0000 UTC"
  assert_eq time_attr("t", time.date(2000, 11, 12, 3, 12, 20, 50000000, time.utc)).value.to_s, "2000-11-12 03:12:20.05 +0000 UTC"
  assert_eq time_attr("t", time.date(2022, 3, 4, 5, 6, 7, 823456789, time.utc)).value.to_s, "2022-03-04 05:06:07.823456789 +0000 UTC"
  assert_eq time_attr("t", time.date(2022, 3, 4, 5, 6, 7, 823456789, time.fixed_zone("EST", -18000))).value.to_s, "2022-03-04 05:06:07.823456789 -0500 EST"
  assert_eq time_attr("t", time.date(1999, 12, 31, 23, 59, 59, 999999999, time.fixed_zone("", 19800))).value.to_s, "1999-12-31 23:59:59.999999999 +0530 +0530"
  assert_eq time_attr("t", time.date(1, 1, 1, 0, 0, 0, 1, time.utc)).value.to_s, "0001-01-01 00:00:00.000000001 +0000 UTC"
  assert_eq time_attr("t", time.date(9999, 12, 31, 23, 59, 59, 0, time.utc)).value.to_s, "9999-12-31 23:59:59 +0000 UTC"
  assert_eq time_attr("t", time.date(10000, 1, 1, 0, 0, 0, 0, time.utc)).value.to_s, "10000-01-01 00:00:00 +0000 UTC"
  assert_eq time_attr("t", time.date(-1, 1, 1, 0, 0, 0, 0, time.utc)).value.to_s, "-0001-01-01 00:00:00 +0000 UTC"
  assert_eq time_attr("t", time.date(2300, 1, 1, 0, 0, 0, 0, time.utc)).value.to_s, "2300-01-01 00:00:00 +0000 UTC"
  assert_eq time_attr("t", time.date(1715, 6, 13, 0, 25, 26, 290448384, time.utc)).value.to_s, "1715-06-13 00:25:26.290448384 +0000 UTC"
  assert_eq time_attr("t", time.date(2024, 2, 29, 12, 0, 0, 120000000, time.fixed_zone("X", -12600))).value.to_s, "2024-02-29 12:00:00.12 -0330 X"
  assert_eq bool("b", true).value.to_s, "true"
  assert_eq bool("b", false).value.to_s, "false"
  assert_eq any("n", nil_value).value.to_s, "<nil>"
  assert_eq any("", nil_value).value.to_s, "<nil>"
  assert_eq any("e", error_value("EOF")).value.to_s, "EOF"
  assert_eq any("e", error_value("bad thing: \"x\"")).value.to_s, "bad thing: \"x\""
  assert_eq any("l", level_value(Level.new(n: -4))).value.to_s, "DEBUG"
  assert_eq any("l", level_value(Level.new(n: 5))).value.to_s, "WARN+1"
  assert_eq any("l", level_value(Level.new(n: 100))).value.to_s, "ERROR+92"
  assert_eq any("l", level_value(Level.new(n: -10))).value.to_s, "DEBUG-6"
  assert_eq any("kd", kind_value(1)).value.to_s, "1"
  assert_eq any("kd", kind_value(8)).value.to_s, "8"
}
