# Generated from Go's log/slog (Go 1.27, text and JSON handler output for one attribute); do not edit by hand.
import "math"
import "time"

test "values 1" {
  assert_eq text_line(0, [], [string("k", "")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"\""
  assert_eq json_line(0, [], [string("k", "")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"\"}"
  assert_eq text_line(0, [], [string("", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"\"=v"
  assert_eq json_line(0, [], [string("", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "a")], time.Time.new, level_info, "m"), "level=INFO msg=m k=a"
  assert_eq json_line(0, [], [string("k", "a")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"a\"}"
  assert_eq text_line(0, [], [string("a", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m a=v"
  assert_eq json_line(0, [], [string("a", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"a\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "ab")], time.Time.new, level_info, "m"), "level=INFO msg=m k=ab"
  assert_eq json_line(0, [], [string("k", "ab")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"ab\"}"
  assert_eq text_line(0, [], [string("ab", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m ab=v"
  assert_eq json_line(0, [], [string("ab", "v")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"ab\":\"v\"}"
  assert_eq text_line(0, [], [string("k", "a b")], time.Time.new, level_info, "m"), "level=INFO msg=m k=\"a b\""
  assert_eq json_line(0, [], [string("k", "a b")], time.Time.new, level_info, "m"), "{\"level\":\"INFO\",\"msg\":\"m\",\"k\":\"a b\"}"
  assert_eq text_line(0, [], [string("a b", "v")], time.Time.new, level_info, "m"), "level=INFO msg=m \"a b\"=v"
