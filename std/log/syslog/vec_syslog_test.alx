# Generated from Go's log/syslog (netConn.writeString's line for fixed times; Writer.write's newline rule); do not edit by hand.
import "time"

test "format message 0" {
  t = time.unix(0, 114473942).in_zone(time.fixed_zone("X", -34200))
  assert_eq format_message(true, 116, t, "web-1.example.com", "how's it going?", 19804, "", newline_for("")), "<116>Dec 31 14:30:00 how's it going?[19804]: \n"
  t = time.unix(3809129073, 585318182).in_zone(time.fixed_zone("UTC", 0))
  assert_eq format_message(true, 55, t, "localhost", "how's it going?", 38571, "", newline_for("")), "<55>Sep 15 03:24:33 how's it going?[38571]: \n"
  t = time.unix(3151241157, 59157599).in_zone(time.fixed_zone("EST", -18000))
  assert_eq format_message(false, 167, t, "web-1.example.com", "demotag", 68487, "Test 123", newline_for("Test 123")), "<167>2069-11-09T11:45:57-05:00 web-1.example.com demotag[68487]: Test 123\n"
  t = time.unix(3533809467, 924109783).in_zone(time.fixed_zone("X", -34200))
