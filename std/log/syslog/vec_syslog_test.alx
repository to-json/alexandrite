  assert_eq format_message(true, 36, t, "localhost", "syslog_test", 15940, "Test 123", newline_for("Test 123")), "<36>Dec 12 08:14:35 syslog_test[15940]: Test 123\n"
  t = time.unix(783715845, 77456255).in_zone(time.fixed_zone("EST", -18000))
  assert_eq format_message(true, 77, t, "localhost", "syslog_test", 33959, "hello", newline_for("hello")), "<77>Nov  1 13:50:45 syslog_test[33959]: hello\n"
  t = time.unix(385635565, 586213075).in_zone(time.fixed_zone("NPT", 20700))
  assert_eq format_message(false, 174, t, "web-1.example.com", "how's it going?", 85876, "two\nlines", newline_for("two\nlines")), "<174>1982-03-22T14:44:25+05:45 web-1.example.com how's it going?[85876]: two\nlines\n"
  t = time.unix(727599687, 33390832).in_zone(time.fixed_zone("EST", -18000))
  assert_eq format_message(true, 160, t, "127.0.0.1:53211", "demotag", 52558, "hello", newline_for("hello")), "<160>Jan 21 02:01:27 demotag[52558]: hello\n"
  t = time.unix(2998172131, 929629149).in_zone(time.fixed_zone("X", -34200))
  assert_eq format_message(false, 55, t, "127.0.0.1:53211", "how's it going?", 1501, "hello", newline_for("hello")), "<55>2065-01-02T16:05:31-09:30 127.0.0.1:53211 how's it going?[1501]: hello\n"
  t = time.unix(2498254247, 502606405).in_zone(time.fixed_zone("UTC", 0))
  assert_eq format_message(true, 5, t, "localhost", "", 13860, "<html> & \"quotes\"", newline_for("<html> & \"quotes\"")), "<5>Mar  1 23:30:47 [13860]: <html> & \"quotes\"\n"
  t = time.unix(3378690997, 853522249).in_zone(time.fixed_zone("NPT", 20700))
  assert_eq format_message(false, 11, t, "127.0.0.1:53211", "/usr/bin/app", 70988, "Test 123", newline_for("Test 123")), "<11>2077-01-24T11:01:37+05:45 127.0.0.1:53211 /usr/bin/app[70988]: Test 123\n"
  t = time.unix(2483224557, 538265141).in_zone(time.fixed_zone("IST", 19800))
  assert_eq format_message(false, 171, t, "127.0.0.1:53211", "demotag", 80493, "ends with newline\n", newline_for("ends with newline\n")), "<171>2048-09-09T06:05:57+05:30 127.0.0.1:53211 demotag[80493]: ends with newline\n"
  t = time.unix(1609119127, 921823663).in_zone(time.fixed_zone("IST", 19800))
  assert_eq format_message(false, 60, t, "127.0.0.1:53211", "how's it going?", 74751, "", newline_for("")), "<60>2020-12-28T07:02:07+05:30 127.0.0.1:53211 how's it going?[74751]: \n"
}
