test "format message 1" {
  t = time.unix(1234567890, 145148790).in_zone(time.fixed_zone("EST", -18000))
  assert_eq format_message(true, 10, t, "localhost", "", 89533, "two\nlines", newline_for("two\nlines")), "<10>Feb 13 18:31:30 [89533]: two\nlines\n"
  t = time.unix(2512573558, 326444540).in_zone(time.fixed_zone("X", -34200))
  assert_eq format_message(true, 77, t, "web-1.example.com", "how's it going?", 87202, "x\#{y}", newline_for("x\#{y}")), "<77>Aug 14 07:35:58 how's it going?[87202]: x\#{y}\n"
  t = time.unix(2008895601, 807167053).in_zone(time.fixed_zone("X", -34200))
  assert_eq format_message(true, 88, t, "localhost", "", 30927, "", newline_for("")), "<88>Aug 28 17:03:21 [30927]: \n"
  t = time.unix(3926011077, 216087682).in_zone(time.fixed_zone("EST", -18000))
  assert_eq format_message(true, 99, t, "localhost", "demotag", 68720, "ends with newline\n", newline_for("ends with newline\n")), "<99>May 29 17:37:57 demotag[68720]: ends with newline\n"
  t = time.unix(1512505756, 173843517).in_zone(time.fixed_zone("X", -34200))
  assert_eq format_message(true, 92, t, "localhost", "how's it going?", 41292, "ends with newline\n", newline_for("ends with newline\n")), "<92>Dec  5 10:59:16 how's it going?[41292]: ends with newline\n"
  t = time.unix(3140776009, 275557879).in_zone(time.fixed_zone("EST", -18000))
  assert_eq format_message(false, 146, t, "localhost", "how's it going?", 83995, "x\#{y}", newline_for("x\#{y}")), "<146>2069-07-11T08:46:49-05:00 localhost how's it going?[83995]: x\#{y}\n"
  t = time.unix(3374349892, 48991737).in_zone(time.fixed_zone("IST", 19800))
  assert_eq format_message(true, 149, t, "127.0.0.1:53211", "syslog_test", 43563, "x\#{y}", newline_for("x\#{y}")), "<149>Dec  5 04:54:52 syslog_test[43563]: x\#{y}\n"
  t = time.unix(216260809, 773346601).in_zone(time.fixed_zone("EST", -18000))
  assert_eq format_message(false, 126, t, "web-1.example.com", "how's it going?", 13032, "Test 123", newline_for("Test 123")), "<126>1976-11-07T19:26:49-05:00 web-1.example.com how's it going?[13032]: Test 123\n"
  t = time.unix(1421579687, 996582581).in_zone(time.fixed_zone("EST", -18000))
  assert_eq format_message(true, 91, t, "localhost", "", 38427, "Test 123", newline_for("Test 123")), "<91>Jan 18 06:14:47 [38427]: Test 123\n"
  t = time.unix(1091195450, 440482532).in_zone(time.fixed_zone("EST", -18000))
