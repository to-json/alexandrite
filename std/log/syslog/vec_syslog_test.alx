test "format message 2" {
  t = time.unix(4102444799, 338289030).in_zone(time.fixed_zone("IST", 19800))
  assert_eq format_message(true, 47, t, "127.0.0.1:53211", "/usr/bin/app", 83299, "", newline_for("")), "<47>Jan  1 05:29:59 /usr/bin/app[83299]: \n"
