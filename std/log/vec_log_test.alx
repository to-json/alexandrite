test "format header 1" {
  assert_eq format_header(time.unix(0, 999).utc, "logger: ", 16, "x/y.go", 7), "logger: y.go:7: "
  assert_eq format_header(time.unix(1, 1000).utc, "", 16, "/", 23), "/:23: "
  assert_eq format_header(time.unix(59, 123456789).utc, "logger: ", 16, "a//b.go", 12345), "logger: b.go:12345: "
  assert_eq format_header(time.unix(86399, 999999999).utc, "", 16, "???", 0), "???:0: "
  assert_eq format_header(time.unix(951782400, 500000).utc, "logger: ", 16, "/a/b/c/d.go", 7), "logger: d.go:7: "
  assert_eq format_header(time.unix(1234567890, 0).utc, "", 16, "d.go", 23), "d.go:23: "
  assert_eq format_header(time.unix(1700000000, 1).utc, "logger: ", 16, "x/y.go", 12345), "logger: y.go:12345: "
  assert_eq format_header(time.unix(4102444799, 999).utc, "", 16, "/", 0), "/:0: "
  assert_eq format_header(time.unix(-1, 1000).utc, "logger: ", 16, "a//b.go", 7), "logger: b.go:7: "
  assert_eq format_header(time.unix(-31536000, 123456789).utc, "", 16, "???", 23), "???:23: "
  assert_eq format_header(time.unix(253402300799, 999999999).utc, "logger: ", 16, "/a/b/c/d.go", 12345), "logger: d.go:12345: "
  assert_eq format_header(time.unix(0, 1000).utc, "\n", 24, "d.go", 23), "\nd.go:23: "
  assert_eq format_header(time.unix(1, 123456789).utc, "XXX", 24, "x/y.go", 12345), "XXXy.go:12345: "
  assert_eq format_header(time.unix(59, 999999999).utc, "\n", 24, "/", 0), "\n/:0: "
  assert_eq format_header(time.unix(86399, 500000).utc, "XXX", 24, "a//b.go", 7), "XXXb.go:7: "
  assert_eq format_header(time.unix(951782400, 0).utc, "\n", 24, "???", 23), "\n???:23: "
  assert_eq format_header(time.unix(1234567890, 1).utc, "XXX", 24, "/a/b/c/d.go", 12345), "XXXd.go:12345: "
  assert_eq format_header(time.unix(1700000000, 999).utc, "\n", 24, "d.go", 0), "\nd.go:0: "
  assert_eq format_header(time.unix(4102444799, 1000).utc, "XXX", 24, "x/y.go", 7), "XXXy.go:7: "
  assert_eq format_header(time.unix(-1, 123456789).utc, "\n", 24, "/", 23), "\n/:23: "
  assert_eq format_header(time.unix(-31536000, 999999999).utc, "XXX", 24, "a//b.go", 12345), "XXXb.go:12345: "
  assert_eq format_header(time.unix(253402300799, 500000).utc, "\n", 24, "???", 0), "\n???:0: "
  assert_eq format_header(time.unix(0, 123456789).utc, "a/b ", 32, "/a/b/c/d.go", 12345), "a/b "
  assert_eq format_header(time.unix(1, 999999999).utc, "Test:", 32, "d.go", 0), "Test:"
  assert_eq format_header(time.unix(59, 500000).utc, "a/b ", 32, "x/y.go", 7), "a/b "
  assert_eq format_header(time.unix(86399, 0).utc, "Test:", 32, "/", 23), "Test:"
  assert_eq format_header(time.unix(951782400, 1).utc, "a/b ", 32, "a//b.go", 12345), "a/b "
  assert_eq format_header(time.unix(1234567890, 999).utc, "Test:", 32, "???", 0), "Test:"
  assert_eq format_header(time.unix(1700000000, 1000).utc, "a/b ", 32, "/a/b/c/d.go", 7), "a/b "
  assert_eq format_header(time.unix(4102444799, 123456789).utc, "Test:", 32, "d.go", 23), "Test:"
  assert_eq format_header(time.unix(-1, 999999999).utc, "a/b ", 32, "x/y.go", 12345), "a/b "
  assert_eq format_header(time.unix(-31536000, 500000).utc, "Test:", 32, "/", 0), "Test:"
  assert_eq format_header(time.unix(253402300799, 0).utc, "a/b ", 32, "a//b.go", 7), "a/b "
  assert_eq format_header(time.unix(0, 999999999).utc, "", 33, "???", 0), "1970/01/01 "
