  assert_eq format_header(time.unix(1234567890, 500000).utc, "", 36, "d.go", 0), "23:31:30.000500 "
  assert_eq format_header(time.unix(1700000000, 0).utc, "logger: ", 36, "x/y.go", 7), "logger: 22:13:20.000000 "
  assert_eq format_header(time.unix(4102444799, 1).utc, "", 36, "/", 23), "23:59:59.000000 "
  assert_eq format_header(time.unix(-1, 999).utc, "logger: ", 36, "a//b.go", 12345), "logger: 23:59:59.000000 "
  assert_eq format_header(time.unix(-31536000, 1000).utc, "", 36, "???", 0), "00:00:00.000001 "
  assert_eq format_header(time.unix(253402300799, 123456789).utc, "logger: ", 36, "/a/b/c/d.go", 7), "logger: 23:59:59.123456 "
  assert_eq format_header(time.unix(0, 999).utc, "\n", 39, "d.go", 0), "\n1970/01/01 00:00:00.000000 "
  assert_eq format_header(time.unix(1, 1000).utc, "XXX", 39, "x/y.go", 7), "XXX1970/01/01 00:00:01.000001 "
  assert_eq format_header(time.unix(59, 123456789).utc, "\n", 39, "/", 23), "\n1970/01/01 00:00:59.123456 "
  assert_eq format_header(time.unix(86399, 999999999).utc, "XXX", 39, "a//b.go", 12345), "XXX1970/01/01 23:59:59.999999 "
  assert_eq format_header(time.unix(951782400, 500000).utc, "\n", 39, "???", 0), "\n2000/02/29 00:00:00.000500 "
  assert_eq format_header(time.unix(1234567890, 0).utc, "XXX", 39, "/a/b/c/d.go", 7), "XXX2009/02/13 23:31:30.000000 "
  assert_eq format_header(time.unix(1700000000, 1).utc, "\n", 39, "d.go", 23), "\n2023/11/14 22:13:20.000000 "
  assert_eq format_header(time.unix(4102444799, 999).utc, "XXX", 39, "x/y.go", 12345), "XXX2099/12/31 23:59:59.000000 "
  assert_eq format_header(time.unix(-1, 1000).utc, "\n", 39, "/", 0), "\n1969/12/31 23:59:59.000001 "
  assert_eq format_header(time.unix(-31536000, 123456789).utc, "XXX", 39, "a//b.go", 7), "XXX1969/01/01 00:00:00.123456 "
  assert_eq format_header(time.unix(253402300799, 999999999).utc, "\n", 39, "???", 23), "\n9999/12/31 23:59:59.999999 "
  assert_eq format_header(time.unix(0, 1000).utc, "a/b ", 64, "/a/b/c/d.go", 7), "a/b "
  assert_eq format_header(time.unix(1, 123456789).utc, "Test:", 64, "d.go", 23), "Test:"
  assert_eq format_header(time.unix(59, 999999999).utc, "a/b ", 64, "x/y.go", 12345), "a/b "
  assert_eq format_header(time.unix(86399, 500000).utc, "Test:", 64, "/", 0), "Test:"
  assert_eq format_header(time.unix(951782400, 0).utc, "a/b ", 64, "a//b.go", 7), "a/b "
  assert_eq format_header(time.unix(1234567890, 1).utc, "Test:", 64, "???", 23), "Test:"
  assert_eq format_header(time.unix(1700000000, 999).utc, "a/b ", 64, "/a/b/c/d.go", 12345), "a/b "
  assert_eq format_header(time.unix(4102444799, 1000).utc, "Test:", 64, "d.go", 0), "Test:"
  assert_eq format_header(time.unix(-1, 123456789).utc, "a/b ", 64, "x/y.go", 7), "a/b "
  assert_eq format_header(time.unix(-31536000, 999999999).utc, "Test:", 64, "/", 23), "Test:"
  assert_eq format_header(time.unix(253402300799, 500000).utc, "a/b ", 64, "a//b.go", 12345), "a/b "
}

test "format header 2" {
  assert_eq format_header(time.unix(0, 123456789).utc, "", 65, "???", 23), "1970/01/01 "
  assert_eq format_header(time.unix(1, 999999999).utc, "logger: ", 65, "/a/b/c/d.go", 12345), "1970/01/01 logger: "
  assert_eq format_header(time.unix(59, 500000).utc, "", 65, "d.go", 0), "1970/01/01 "
  assert_eq format_header(time.unix(86399, 0).utc, "logger: ", 65, "x/y.go", 7), "1970/01/01 logger: "
  assert_eq format_header(time.unix(951782400, 1).utc, "", 65, "/", 23), "2000/02/29 "
  assert_eq format_header(time.unix(1234567890, 999).utc, "logger: ", 65, "a//b.go", 12345), "2009/02/13 logger: "
  assert_eq format_header(time.unix(1700000000, 1000).utc, "", 65, "???", 0), "2023/11/14 "
  assert_eq format_header(time.unix(4102444799, 123456789).utc, "logger: ", 65, "/a/b/c/d.go", 7), "2099/12/31 logger: "
  assert_eq format_header(time.unix(-1, 999999999).utc, "", 65, "d.go", 23), "1969/12/31 "
  assert_eq format_header(time.unix(-31536000, 500000).utc, "logger: ", 65, "x/y.go", 12345), "1969/01/01 logger: "
  assert_eq format_header(time.unix(253402300799, 0).utc, "", 65, "/", 0), "9999/12/31 "
  assert_eq format_header(time.unix(0, 999999999).utc, "XXX", 66, "a//b.go", 12345), "00:00:00 XXX"
  assert_eq format_header(time.unix(1, 500000).utc, "\n", 66, "???", 0), "00:00:01 \n"
  assert_eq format_header(time.unix(59, 0).utc, "XXX", 66, "/a/b/c/d.go", 7), "00:00:59 XXX"
  assert_eq format_header(time.unix(86399, 1).utc, "\n", 66, "d.go", 23), "23:59:59 \n"
  assert_eq format_header(time.unix(951782400, 999).utc, "XXX", 66, "x/y.go", 12345), "00:00:00 XXX"
  assert_eq format_header(time.unix(1234567890, 1000).utc, "\n", 66, "/", 0), "23:31:30 \n"
  assert_eq format_header(time.unix(1700000000, 123456789).utc, "XXX", 66, "a//b.go", 7), "22:13:20 XXX"
  assert_eq format_header(time.unix(4102444799, 999999999).utc, "\n", 66, "???", 23), "23:59:59 \n"
  assert_eq format_header(time.unix(-1, 500000).utc, "XXX", 66, "/a/b/c/d.go", 12345), "23:59:59 XXX"
  assert_eq format_header(time.unix(-31536000, 0).utc, "\n", 66, "d.go", 0), "00:00:00 \n"
  assert_eq format_header(time.unix(253402300799, 1).utc, "XXX", 66, "x/y.go", 7), "23:59:59 XXX"
  assert_eq format_header(time.unix(0, 500000).utc, "Test:", 67, "/", 0), "1970/01/01 00:00:00 Test:"
  assert_eq format_header(time.unix(1, 0).utc, "a/b ", 67, "a//b.go", 7), "1970/01/01 00:00:01 a/b "
  assert_eq format_header(time.unix(59, 1).utc, "Test:", 67, "???", 23), "1970/01/01 00:00:59 Test:"
  assert_eq format_header(time.unix(86399, 999).utc, "a/b ", 67, "/a/b/c/d.go", 12345), "1970/01/01 23:59:59 a/b "
  assert_eq format_header(time.unix(951782400, 1000).utc, "Test:", 67, "d.go", 0), "2000/02/29 00:00:00 Test:"
  assert_eq format_header(time.unix(1234567890, 123456789).utc, "a/b ", 67, "x/y.go", 7), "2009/02/13 23:31:30 a/b "
  assert_eq format_header(time.unix(1700000000, 999999999).utc, "Test:", 67, "/", 23), "2023/11/14 22:13:20 Test:"
  assert_eq format_header(time.unix(4102444799, 500000).utc, "a/b ", 67, "a//b.go", 12345), "2099/12/31 23:59:59 a/b "
  assert_eq format_header(time.unix(-1, 0).utc, "Test:", 67, "???", 0), "1969/12/31 23:59:59 Test:"
  assert_eq format_header(time.unix(-31536000, 1).utc, "a/b ", 67, "/a/b/c/d.go", 7), "1969/01/01 00:00:00 a/b "
  assert_eq format_header(time.unix(253402300799, 999).utc, "Test:", 67, "d.go", 23), "9999/12/31 23:59:59 Test:"
  assert_eq format_header(time.unix(0, 0).utc, "logger: ", 71, "x/y.go", 7), "1970/01/01 00:00:00.000000 logger: "
  assert_eq format_header(time.unix(1, 1).utc, "", 71, "/", 23), "1970/01/01 00:00:01.000000 "
  assert_eq format_header(time.unix(59, 999).utc, "logger: ", 71, "a//b.go", 12345), "1970/01/01 00:00:59.000000 logger: "
  assert_eq format_header(time.unix(86399, 1000).utc, "", 71, "???", 0), "1970/01/01 23:59:59.000001 "
  assert_eq format_header(time.unix(951782400, 123456789).utc, "logger: ", 71, "/a/b/c/d.go", 7), "2000/02/29 00:00:00.123456 logger: "
  assert_eq format_header(time.unix(1234567890, 999999999).utc, "", 71, "d.go", 23), "2009/02/13 23:31:30.999999 "
  assert_eq format_header(time.unix(1700000000, 500000).utc, "logger: ", 71, "x/y.go", 12345), "2023/11/14 22:13:20.000500 logger: "
  assert_eq format_header(time.unix(4102444799, 0).utc, "", 71, "/", 0), "2099/12/31 23:59:59.000000 "
  assert_eq format_header(time.unix(-1, 1).utc, "logger: ", 71, "a//b.go", 7), "1969/12/31 23:59:59.000000 logger: "
  assert_eq format_header(time.unix(-31536000, 999).utc, "", 71, "???", 23), "1969/01/01 00:00:00.000000 "
  assert_eq format_header(time.unix(253402300799, 1000).utc, "logger: ", 71, "/a/b/c/d.go", 12345), "9999/12/31 23:59:59.000001 logger: "
  assert_eq format_header(time.unix(0, 1).utc, "\n", 79, "d.go", 23), "1970/01/01 00:00:00.000000 d.go:23: \n"
  assert_eq format_header(time.unix(1, 999).utc, "XXX", 79, "x/y.go", 12345), "1970/01/01 00:00:01.000000 x/y.go:12345: XXX"
  assert_eq format_header(time.unix(59, 1000).utc, "\n", 79, "/", 0), "1970/01/01 00:00:59.000001 /:0: \n"
  assert_eq format_header(time.unix(86399, 123456789).utc, "XXX", 79, "a//b.go", 7), "1970/01/01 23:59:59.123456 a//b.go:7: XXX"
  assert_eq format_header(time.unix(951782400, 999999999).utc, "\n", 79, "???", 23), "2000/02/29 00:00:00.999999 ???:23: \n"
  assert_eq format_header(time.unix(1234567890, 500000).utc, "XXX", 79, "/a/b/c/d.go", 12345), "2009/02/13 23:31:30.000500 /a/b/c/d.go:12345: XXX"
  assert_eq format_header(time.unix(1700000000, 0).utc, "\n", 79, "d.go", 0), "2023/11/14 22:13:20.000000 d.go:0: \n"
  assert_eq format_header(time.unix(4102444799, 1).utc, "XXX", 79, "x/y.go", 7), "2099/12/31 23:59:59.000000 x/y.go:7: XXX"
  assert_eq format_header(time.unix(-1, 999).utc, "\n", 79, "/", 23), "1969/12/31 23:59:59.000000 /:23: \n"
  assert_eq format_header(time.unix(-31536000, 1000).utc, "XXX", 79, "a//b.go", 12345), "1969/01/01 00:00:00.000001 a//b.go:12345: XXX"
  assert_eq format_header(time.unix(253402300799, 123456789).utc, "\n", 79, "???", 0), "9999/12/31 23:59:59.123456 ???:0: \n"
  assert_eq format_header(time.unix(0, 999).utc, "a/b ", 87, "/a/b/c/d.go", 12345), "1970/01/01 00:00:00.000000 d.go:12345: a/b "
  assert_eq format_header(time.unix(1, 1000).utc, "Test:", 87, "d.go", 0), "1970/01/01 00:00:01.000001 d.go:0: Test:"
  assert_eq format_header(time.unix(59, 123456789).utc, "a/b ", 87, "x/y.go", 7), "1970/01/01 00:00:59.123456 y.go:7: a/b "
  assert_eq format_header(time.unix(86399, 999999999).utc, "Test:", 87, "/", 23), "1970/01/01 23:59:59.999999 /:23: Test:"
  assert_eq format_header(time.unix(951782400, 500000).utc, "a/b ", 87, "a//b.go", 12345), "2000/02/29 00:00:00.000500 b.go:12345: a/b "
  assert_eq format_header(time.unix(1234567890, 0).utc, "Test:", 87, "???", 0), "2009/02/13 23:31:30.000000 ???:0: Test:"
  assert_eq format_header(time.unix(1700000000, 1).utc, "a/b ", 87, "/a/b/c/d.go", 7), "2023/11/14 22:13:20.000000 d.go:7: a/b "
  assert_eq format_header(time.unix(4102444799, 999).utc, "Test:", 87, "d.go", 23), "2099/12/31 23:59:59.000000 d.go:23: Test:"
  assert_eq format_header(time.unix(-1, 1000).utc, "a/b ", 87, "x/y.go", 12345), "1969/12/31 23:59:59.000001 y.go:12345: a/b "
  assert_eq format_header(time.unix(-31536000, 123456789).utc, "Test:", 87, "/", 0), "1969/01/01 00:00:00.123456 /:0: Test:"
  assert_eq format_header(time.unix(253402300799, 999999999).utc, "a/b ", 87, "a//b.go", 7), "9999/12/31 23:59:59.999999 b.go:7: a/b "
  assert_eq format_header(time.unix(0, 1000).utc, "", 95, "???", 0), "1970/01/01 00:00:00.000001 ???:0: "
  assert_eq format_header(time.unix(1, 123456789).utc, "logger: ", 95, "/a/b/c/d.go", 7), "1970/01/01 00:00:01.123456 d.go:7: logger: "
  assert_eq format_header(time.unix(59, 999999999).utc, "", 95, "d.go", 23), "1970/01/01 00:00:59.999999 d.go:23: "
  assert_eq format_header(time.unix(86399, 500000).utc, "logger: ", 95, "x/y.go", 12345), "1970/01/01 23:59:59.000500 y.go:12345: logger: "
  assert_eq format_header(time.unix(951782400, 0).utc, "", 95, "/", 0), "2000/02/29 00:00:00.000000 /:0: "
  assert_eq format_header(time.unix(1234567890, 1).utc, "logger: ", 95, "a//b.go", 7), "2009/02/13 23:31:30.000000 b.go:7: logger: "
  assert_eq format_header(time.unix(1700000000, 999).utc, "", 95, "???", 23), "2023/11/14 22:13:20.000000 ???:23: "
  assert_eq format_header(time.unix(4102444799, 1000).utc, "logger: ", 95, "/a/b/c/d.go", 12345), "2099/12/31 23:59:59.000001 d.go:12345: logger: "
  assert_eq format_header(time.unix(-1, 123456789).utc, "", 95, "d.go", 0), "1969/12/31 23:59:59.123456 d.go:0: "
  assert_eq format_header(time.unix(-31536000, 999999999).utc, "logger: ", 95, "x/y.go", 7), "1969/01/01 00:00:00.999999 y.go:7: logger: "
  assert_eq format_header(time.unix(253402300799, 500000).utc, "", 95, "/", 23), "9999/12/31 23:59:59.000500 /:23: "
  assert_eq format_header(time.unix(0, 123456789).utc, "XXX", 103, "a//b.go", 7), "1970/01/01 00:00:00.123456 XXX"
  assert_eq format_header(time.unix(1, 999999999).utc, "\n", 103, "???", 23), "1970/01/01 00:00:01.999999 \n"
  assert_eq format_header(time.unix(59, 500000).utc, "XXX", 103, "/a/b/c/d.go", 12345), "1970/01/01 00:00:59.000500 XXX"
  assert_eq format_header(time.unix(86399, 0).utc, "\n", 103, "d.go", 0), "1970/01/01 23:59:59.000000 \n"
  assert_eq format_header(time.unix(951782400, 1).utc, "XXX", 103, "x/y.go", 7), "2000/02/29 00:00:00.000000 XXX"
  assert_eq format_header(time.unix(1234567890, 999).utc, "\n", 103, "/", 23), "2009/02/13 23:31:30.000000 \n"
  assert_eq format_header(time.unix(1700000000, 1000).utc, "XXX", 103, "a//b.go", 12345), "2023/11/14 22:13:20.000001 XXX"
  assert_eq format_header(time.unix(4102444799, 123456789).utc, "\n", 103, "???", 0), "2099/12/31 23:59:59.123456 \n"
  assert_eq format_header(time.unix(-1, 999999999).utc, "XXX", 103, "/a/b/c/d.go", 7), "1969/12/31 23:59:59.999999 XXX"
  assert_eq format_header(time.unix(-31536000, 500000).utc, "\n", 103, "d.go", 23), "1969/01/01 00:00:00.000500 \n"
  assert_eq format_header(time.unix(253402300799, 0).utc, "XXX", 103, "x/y.go", 12345), "9999/12/31 23:59:59.000000 XXX"
  assert_eq format_header(time.unix(0, 999999999).utc, "Test:", 127, "/", 23), "1970/01/01 00:00:00.999999 /:23: Test:"
  assert_eq format_header(time.unix(1, 500000).utc, "a/b ", 127, "a//b.go", 12345), "1970/01/01 00:00:01.000500 b.go:12345: a/b "
  assert_eq format_header(time.unix(59, 0).utc, "Test:", 127, "???", 0), "1970/01/01 00:00:59.000000 ???:0: Test:"
  assert_eq format_header(time.unix(86399, 1).utc, "a/b ", 127, "/a/b/c/d.go", 7), "1970/01/01 23:59:59.000000 d.go:7: a/b "
  assert_eq format_header(time.unix(951782400, 999).utc, "Test:", 127, "d.go", 23), "2000/02/29 00:00:00.000000 d.go:23: Test:"
  assert_eq format_header(time.unix(1234567890, 1000).utc, "a/b ", 127, "x/y.go", 12345), "2009/02/13 23:31:30.000001 y.go:12345: a/b "
  assert_eq format_header(time.unix(1700000000, 123456789).utc, "Test:", 127, "/", 0), "2023/11/14 22:13:20.123456 /:0: Test:"
  assert_eq format_header(time.unix(4102444799, 999999999).utc, "a/b ", 127, "a//b.go", 7), "2099/12/31 23:59:59.999999 b.go:7: a/b "
  assert_eq format_header(time.unix(-1, 500000).utc, "Test:", 127, "???", 23), "1969/12/31 23:59:59.000500 ???:23: Test:"
  assert_eq format_header(time.unix(-31536000, 0).utc, "a/b ", 127, "/a/b/c/d.go", 12345), "1969/01/01 00:00:00.000000 d.go:12345: a/b "
  assert_eq format_header(time.unix(253402300799, 1).utc, "Test:", 127, "d.go", 0), "9999/12/31 23:59:59.000000 d.go:0: Test:"
}

test "logger lines" {
  assert_eq lines("", 0, ""), "\n"
  assert_eq lines("", 0, "x"), "x\n"
  assert_eq lines("", 0, "x\n"), "x\n"
  assert_eq lines("", 0, "hello 23 world"), "hello 23 world\n"
  assert_eq lines("", 0, "a\nb"), "a\nb\n"
  assert_eq lines("", 0, "\n"), "\n"
  assert_eq lines("", 0, "two\n\n"), "two\n\n"
  assert_eq lines("", 0, "héllo"), "héllo\n"
  assert_eq lines("", 64, ""), "\n"
  assert_eq lines("", 64, "x"), "x\n"
  assert_eq lines("", 64, "x\n"), "x\n"
  assert_eq lines("", 64, "hello 23 world"), "hello 23 world\n"
  assert_eq lines("", 64, "a\nb"), "a\nb\n"
  assert_eq lines("", 64, "\n"), "\n"
  assert_eq lines("", 64, "two\n\n"), "two\n\n"
  assert_eq lines("", 64, "héllo"), "héllo\n"
  assert_eq lines("", 32, ""), "\n"
  assert_eq lines("", 32, "x"), "x\n"
  assert_eq lines("", 32, "x\n"), "x\n"
  assert_eq lines("", 32, "hello 23 world"), "hello 23 world\n"
  assert_eq lines("", 32, "a\nb"), "a\nb\n"
  assert_eq lines("", 32, "\n"), "\n"
  assert_eq lines("", 32, "two\n\n"), "two\n\n"
  assert_eq lines("", 32, "héllo"), "héllo\n"
  assert_eq lines("XXX", 0, ""), "XXX\n"
  assert_eq lines("XXX", 0, "x"), "XXXx\n"
  assert_eq lines("XXX", 0, "x\n"), "XXXx\n"
  assert_eq lines("XXX", 0, "hello 23 world"), "XXXhello 23 world\n"
  assert_eq lines("XXX", 0, "a\nb"), "XXXa\nb\n"
  assert_eq lines("XXX", 0, "\n"), "XXX\n"
  assert_eq lines("XXX", 0, "two\n\n"), "XXXtwo\n\n"
  assert_eq lines("XXX", 0, "héllo"), "XXXhéllo\n"
  assert_eq lines("XXX", 64, ""), "XXX\n"
  assert_eq lines("XXX", 64, "x"), "XXXx\n"
  assert_eq lines("XXX", 64, "x\n"), "XXXx\n"
  assert_eq lines("XXX", 64, "hello 23 world"), "XXXhello 23 world\n"
  assert_eq lines("XXX", 64, "a\nb"), "XXXa\nb\n"
  assert_eq lines("XXX", 64, "\n"), "XXX\n"
  assert_eq lines("XXX", 64, "two\n\n"), "XXXtwo\n\n"
  assert_eq lines("XXX", 64, "héllo"), "XXXhéllo\n"
  assert_eq lines("XXX", 32, ""), "XXX\n"
  assert_eq lines("XXX", 32, "x"), "XXXx\n"
  assert_eq lines("XXX", 32, "x\n"), "XXXx\n"
  assert_eq lines("XXX", 32, "hello 23 world"), "XXXhello 23 world\n"
  assert_eq lines("XXX", 32, "a\nb"), "XXXa\nb\n"
  assert_eq lines("XXX", 32, "\n"), "XXX\n"
  assert_eq lines("XXX", 32, "two\n\n"), "XXXtwo\n\n"
  assert_eq lines("XXX", 32, "héllo"), "XXXhéllo\n"
  assert_eq lines("Test:", 0, ""), "Test:\n"
  assert_eq lines("Test:", 0, "x"), "Test:x\n"
  assert_eq lines("Test:", 0, "x\n"), "Test:x\n"
  assert_eq lines("Test:", 0, "hello 23 world"), "Test:hello 23 world\n"
  assert_eq lines("Test:", 0, "a\nb"), "Test:a\nb\n"
  assert_eq lines("Test:", 0, "\n"), "Test:\n"
  assert_eq lines("Test:", 0, "two\n\n"), "Test:two\n\n"
  assert_eq lines("Test:", 0, "héllo"), "Test:héllo\n"
  assert_eq lines("Test:", 64, ""), "Test:\n"
  assert_eq lines("Test:", 64, "x"), "Test:x\n"
  assert_eq lines("Test:", 64, "x\n"), "Test:x\n"
  assert_eq lines("Test:", 64, "hello 23 world"), "Test:hello 23 world\n"
  assert_eq lines("Test:", 64, "a\nb"), "Test:a\nb\n"
  assert_eq lines("Test:", 64, "\n"), "Test:\n"
  assert_eq lines("Test:", 64, "two\n\n"), "Test:two\n\n"
  assert_eq lines("Test:", 64, "héllo"), "Test:héllo\n"
  assert_eq lines("Test:", 32, ""), "Test:\n"
  assert_eq lines("Test:", 32, "x"), "Test:x\n"
  assert_eq lines("Test:", 32, "x\n"), "Test:x\n"
  assert_eq lines("Test:", 32, "hello 23 world"), "Test:hello 23 world\n"
  assert_eq lines("Test:", 32, "a\nb"), "Test:a\nb\n"
  assert_eq lines("Test:", 32, "\n"), "Test:\n"
  assert_eq lines("Test:", 32, "two\n\n"), "Test:two\n\n"
  assert_eq lines("Test:", 32, "héllo"), "Test:héllo\n"
  assert_eq lines("logger: ", 0, ""), "logger: \n"
  assert_eq lines("logger: ", 0, "x"), "logger: x\n"
  assert_eq lines("logger: ", 0, "x\n"), "logger: x\n"
  assert_eq lines("logger: ", 0, "hello 23 world"), "logger: hello 23 world\n"
  assert_eq lines("logger: ", 0, "a\nb"), "logger: a\nb\n"
  assert_eq lines("logger: ", 0, "\n"), "logger: \n"
  assert_eq lines("logger: ", 0, "two\n\n"), "logger: two\n\n"
  assert_eq lines("logger: ", 0, "héllo"), "logger: héllo\n"
  assert_eq lines("logger: ", 64, ""), "logger: \n"
  assert_eq lines("logger: ", 64, "x"), "logger: x\n"
  assert_eq lines("logger: ", 64, "x\n"), "logger: x\n"
  assert_eq lines("logger: ", 64, "hello 23 world"), "logger: hello 23 world\n"
  assert_eq lines("logger: ", 64, "a\nb"), "logger: a\nb\n"
  assert_eq lines("logger: ", 64, "\n"), "logger: \n"
  assert_eq lines("logger: ", 64, "two\n\n"), "logger: two\n\n"
  assert_eq lines("logger: ", 64, "héllo"), "logger: héllo\n"
  assert_eq lines("logger: ", 32, ""), "logger: \n"
  assert_eq lines("logger: ", 32, "x"), "logger: x\n"
  assert_eq lines("logger: ", 32, "x\n"), "logger: x\n"
  assert_eq lines("logger: ", 32, "hello 23 world"), "logger: hello 23 world\n"
  assert_eq lines("logger: ", 32, "a\nb"), "logger: a\nb\n"
  assert_eq lines("logger: ", 32, "\n"), "logger: \n"
  assert_eq lines("logger: ", 32, "two\n\n"), "logger: two\n\n"
  assert_eq lines("logger: ", 32, "héllo"), "logger: héllo\n"
  assert_eq lines("\n", 0, ""), "\n"
  assert_eq lines("\n", 0, "x"), "\nx\n"
  assert_eq lines("\n", 0, "x\n"), "\nx\n"
  assert_eq lines("\n", 0, "hello 23 world"), "\nhello 23 world\n"
  assert_eq lines("\n", 0, "a\nb"), "\na\nb\n"
  assert_eq lines("\n", 0, "\n"), "\n\n"
  assert_eq lines("\n", 0, "two\n\n"), "\ntwo\n\n"
  assert_eq lines("\n", 0, "héllo"), "\nhéllo\n"
  assert_eq lines("\n", 64, ""), "\n"
  assert_eq lines("\n", 64, "x"), "\nx\n"
  assert_eq lines("\n", 64, "x\n"), "\nx\n"
  assert_eq lines("\n", 64, "hello 23 world"), "\nhello 23 world\n"
  assert_eq lines("\n", 64, "a\nb"), "\na\nb\n"
  assert_eq lines("\n", 64, "\n"), "\n\n"
  assert_eq lines("\n", 64, "two\n\n"), "\ntwo\n\n"
  assert_eq lines("\n", 64, "héllo"), "\nhéllo\n"
  assert_eq lines("\n", 32, ""), "\n"
  assert_eq lines("\n", 32, "x"), "\nx\n"
  assert_eq lines("\n", 32, "x\n"), "\nx\n"
  assert_eq lines("\n", 32, "hello 23 world"), "\nhello 23 world\n"
  assert_eq lines("\n", 32, "a\nb"), "\na\nb\n"
  assert_eq lines("\n", 32, "\n"), "\n\n"
  assert_eq lines("\n", 32, "two\n\n"), "\ntwo\n\n"
  assert_eq lines("\n", 32, "héllo"), "\nhéllo\n"
  assert_eq lines("a/b ", 0, ""), "a/b \n"
  assert_eq lines("a/b ", 0, "x"), "a/b x\n"
  assert_eq lines("a/b ", 0, "x\n"), "a/b x\n"
  assert_eq lines("a/b ", 0, "hello 23 world"), "a/b hello 23 world\n"
  assert_eq lines("a/b ", 0, "a\nb"), "a/b a\nb\n"
  assert_eq lines("a/b ", 0, "\n"), "a/b \n"
  assert_eq lines("a/b ", 0, "two\n\n"), "a/b two\n\n"
  assert_eq lines("a/b ", 0, "héllo"), "a/b héllo\n"
  assert_eq lines("a/b ", 64, ""), "a/b \n"
  assert_eq lines("a/b ", 64, "x"), "a/b x\n"
  assert_eq lines("a/b ", 64, "x\n"), "a/b x\n"
  assert_eq lines("a/b ", 64, "hello 23 world"), "a/b hello 23 world\n"
  assert_eq lines("a/b ", 64, "a\nb"), "a/b a\nb\n"
  assert_eq lines("a/b ", 64, "\n"), "a/b \n"
  assert_eq lines("a/b ", 64, "two\n\n"), "a/b two\n\n"
  assert_eq lines("a/b ", 64, "héllo"), "a/b héllo\n"
  assert_eq lines("a/b ", 32, ""), "a/b \n"
  assert_eq lines("a/b ", 32, "x"), "a/b x\n"
  assert_eq lines("a/b ", 32, "x\n"), "a/b x\n"
  assert_eq lines("a/b ", 32, "hello 23 world"), "a/b hello 23 world\n"
  assert_eq lines("a/b ", 32, "a\nb"), "a/b a\nb\n"
  assert_eq lines("a/b ", 32, "\n"), "a/b \n"
  assert_eq lines("a/b ", 32, "two\n\n"), "a/b two\n\n"
  assert_eq lines("a/b ", 32, "héllo"), "a/b héllo\n"
}

test "logger println lines" {
  assert_eq lines_ln("", ""), "\n"
  assert_eq lines_ln("", "x"), "x\n"
  assert_eq lines_ln("", "x\n"), "x\n\n"
  assert_eq lines_ln("", "hello 23 world"), "hello 23 world\n"
  assert_eq lines_ln("", "a\nb"), "a\nb\n"
  assert_eq lines_ln("", "\n"), "\n\n"
  assert_eq lines_ln("", "two\n\n"), "two\n\n\n"
  assert_eq lines_ln("", "héllo"), "héllo\n"
  assert_eq lines_ln("XXX", ""), "XXX\n"
  assert_eq lines_ln("XXX", "x"), "XXXx\n"
  assert_eq lines_ln("XXX", "x\n"), "XXXx\n\n"
  assert_eq lines_ln("XXX", "hello 23 world"), "XXXhello 23 world\n"
  assert_eq lines_ln("XXX", "a\nb"), "XXXa\nb\n"
  assert_eq lines_ln("XXX", "\n"), "XXX\n\n"
  assert_eq lines_ln("XXX", "two\n\n"), "XXXtwo\n\n\n"
  assert_eq lines_ln("XXX", "héllo"), "XXXhéllo\n"
  assert_eq lines_ln("Test:", ""), "Test:\n"
  assert_eq lines_ln("Test:", "x"), "Test:x\n"
  assert_eq lines_ln("Test:", "x\n"), "Test:x\n\n"
  assert_eq lines_ln("Test:", "hello 23 world"), "Test:hello 23 world\n"
  assert_eq lines_ln("Test:", "a\nb"), "Test:a\nb\n"
  assert_eq lines_ln("Test:", "\n"), "Test:\n\n"
  assert_eq lines_ln("Test:", "two\n\n"), "Test:two\n\n\n"
  assert_eq lines_ln("Test:", "héllo"), "Test:héllo\n"
  assert_eq lines_ln("logger: ", ""), "logger: \n"
  assert_eq lines_ln("logger: ", "x"), "logger: x\n"
  assert_eq lines_ln("logger: ", "x\n"), "logger: x\n\n"
  assert_eq lines_ln("logger: ", "hello 23 world"), "logger: hello 23 world\n"
  assert_eq lines_ln("logger: ", "a\nb"), "logger: a\nb\n"
  assert_eq lines_ln("logger: ", "\n"), "logger: \n\n"
  assert_eq lines_ln("logger: ", "two\n\n"), "logger: two\n\n\n"
  assert_eq lines_ln("logger: ", "héllo"), "logger: héllo\n"
  assert_eq lines_ln("\n", ""), "\n\n"
  assert_eq lines_ln("\n", "x"), "\nx\n"
  assert_eq lines_ln("\n", "x\n"), "\nx\n\n"
  assert_eq lines_ln("\n", "hello 23 world"), "\nhello 23 world\n"
  assert_eq lines_ln("\n", "a\nb"), "\na\nb\n"
  assert_eq lines_ln("\n", "\n"), "\n\n\n"
  assert_eq lines_ln("\n", "two\n\n"), "\ntwo\n\n\n"
  assert_eq lines_ln("\n", "héllo"), "\nhéllo\n"
  assert_eq lines_ln("a/b ", ""), "a/b \n"
  assert_eq lines_ln("a/b ", "x"), "a/b x\n"
  assert_eq lines_ln("a/b ", "x\n"), "a/b x\n\n"
  assert_eq lines_ln("a/b ", "hello 23 world"), "a/b hello 23 world\n"
  assert_eq lines_ln("a/b ", "a\nb"), "a/b a\nb\n"
  assert_eq lines_ln("a/b ", "\n"), "a/b \n\n"
  assert_eq lines_ln("a/b ", "two\n\n"), "a/b two\n\n\n"
  assert_eq lines_ln("a/b ", "héllo"), "a/b héllo\n"
}
