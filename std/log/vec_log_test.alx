# Generated from Go's log (formatHeader, Logger.Print/Println/Output); do not edit by hand.
import "time"

test "format header 0" {
  assert_eq format_header(time.unix(0, 0).utc, "", 0, "???", 0), ""
  assert_eq format_header(time.unix(1, 1).utc, "logger: ", 0, "/a/b/c/d.go", 7), "logger: "
  assert_eq format_header(time.unix(59, 999).utc, "", 0, "d.go", 23), ""
  assert_eq format_header(time.unix(86399, 1000).utc, "logger: ", 0, "x/y.go", 12345), "logger: "
  assert_eq format_header(time.unix(951782400, 123456789).utc, "", 0, "/", 0), ""
  assert_eq format_header(time.unix(1234567890, 999999999).utc, "logger: ", 0, "a//b.go", 7), "logger: "
  assert_eq format_header(time.unix(1700000000, 500000).utc, "", 0, "???", 23), ""
