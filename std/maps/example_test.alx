#![test(external)]
# Go's maps example_test.go, translated. Go's fmt prints a map sorted by key;
# alx prints maps in insertion order, so the examples print through
# `show`, which sorts the keys as Go's fmt does.
import "maps"
import "slices"
import "strings"

def show[K, V](m: Map[K, V]) -> Str {
  parts: [Str] = []
  for k in maps.sorted_keys(m) {
    parts << format("%v:%v", k, m[k] || panic("missing key"))
  }
  "map[" + strings.join(parts, " ") + "]"
}

example "Clone" {
  m1: Map[Str, Int] = {"key" => 1}
  m2 = maps.clone(m1)
  m2["key"] = 100
  puts m1["key"] || 0
  puts m2["key"] || 0
  m3: Map[Str, [Int]] = {"key" => [1, 2, 3]}
  m4 = maps.clone(m3)
  k4 = m4["key"] || [0]
  puts k4[0]
  k4[0] = 100
  puts (m3["key"] || [0])[0]
  puts (m4["key"] || [0])[0]
} outputs "1\n100\n1\n100\n100\n"

example "Copy" {
  m1: Map[Str, Int] = {"one" => 1, "two" => 2}
  m2: Map[Str, Int] = {"one" => 10}
  maps.copy(m2, m1)
  puts "m2 is: #{show(m2)}"
  m2["one"] = 100
  puts "m1 is: #{show(m1)}"
  puts "m2 is: #{show(m2)}"
  m3: Map[Str, [Int]] = {"one" => [1, 2, 3], "two" => [4, 5, 6]}
  m4: Map[Str, [Int]] = {"one" => [7, 8, 9]}
  maps.copy(m4, m3)
  puts "m4 is: #{show(m4)}"
  one = m4["one"] || [0]
  one[0] = 100
  puts "m3 is: #{show(m3)}"
  puts "m4 is: #{show(m4)}"
} outputs <<~EOS
  m2 is: map[one:1 two:2]
  m1 is: map[one:1 two:2]
  m2 is: map[one:100 two:2]
  m4 is: map[one:[1 2 3] two:[4 5 6]]
  m3 is: map[one:[100 2 3] two:[4 5 6]]
  m4 is: map[one:[100 2 3] two:[4 5 6]]
EOS

example "DeleteFunc" {
  m: Map[Str, Int] = {"one" => 1, "two" => 2, "three" => 3, "four" => 4}
  maps.delete_func(m) { |_k, v| v % 2 != 0 } # delete odd values
  puts show(m)
} outputs "map[four:4 two:2]\n"

example "Equal" {
  m1: Map[Int, Str] = {1 => "one", 10 => "Ten", 1000 => "THOUSAND"}
  m2: Map[Int, Str] = {1 => "one", 10 => "Ten", 1000 => "THOUSAND"}
  m3: Map[Int, Str] = {1 => "one", 10 => "ten", 1000 => "thousand"}
  puts maps.equal(m1, m2)
  puts maps.equal(m1, m3)
} outputs "true\nfalse\n"

example "EqualFunc" {
  m1: Map[Int, Str] = {1 => "one", 10 => "Ten", 1000 => "THOUSAND"}
  m2: Map[Int, [Byte]] = {1 => "One".bytes, 10 => "Ten".bytes, 1000 => "Thousand".bytes}
  eq = maps.equal_func(m1, m2) { |v1, v2| strings.equal_fold(v1, Str.from_bytes(v2)) }
  puts eq
} outputs "true\n"

example "All" {
  m1: Map[Str, Int] = {"one" => 1, "two" => 2}
  m2: Map[Str, Int] = {"one" => 10}
  maps.insert(m2, maps.all(m1))
  puts "m2 is: #{show(m2)}"
} outputs "m2 is: map[one:1 two:2]\n"

example "Keys" {
  m1: Map[Int, Str] = {1 => "one", 10 => "Ten", 1000 => "THOUSAND"}
  keys = slices.sorted(maps.keys(m1))
  puts keys
} outputs "[1 10 1000]\n"

example "Values" {
  m1: Map[Int, Str] = {1 => "one", 10 => "Ten", 1000 => "THOUSAND"}
  values = slices.sorted(maps.values(m1))
  puts values
} outputs "[THOUSAND Ten one]\n"

example "Insert" {
  m1: Map[Int, Str] = {1000 => "THOUSAND"}
  s1 = ["zero", "one", "two", "three"]
  maps.insert(m1, slices.all(s1))
  puts "m1 is: #{show(m1)}"
} outputs "m1 is: map[0:zero 1:one 2:two 3:three 1000:THOUSAND]\n"

example "Collect" {
  s1 = ["zero", "one", "two", "three"]
  m1 = maps.collect(slices.all(s1))
  puts "m1 is: #{show(m1)}"
} outputs "m1 is: map[0:zero 1:one 2:two 3:three]\n"
