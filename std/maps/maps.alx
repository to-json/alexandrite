# Package maps: Go's maps (S2).
#
#   Go                                  alx
#   All(m) iter.Seq2[K, V]              all(m) -> [(K, V)]
#   Keys(m) iter.Seq[K]                 keys(m) -> [K]
#   Values(m) iter.Seq[V]               values(m) -> [V]
#   Insert(m, seq iter.Seq2[K, V])      insert(m, seq: [(K, V)])
#   Collect(seq iter.Seq2[K, V]) map    collect(seq: [(K, V)]) -> Map[K, V]
#   Clone(m), Copy(dst, src)            clone(m), copy(dst, src)
#   DeleteFunc(m, del)                  delete_func(m) { |k, v| }
#   Equal(m1, m2), EqualFunc(m1, m2, eq) equal(a, b), equal_func(a, b) { |v1, v2| }
#   (none)                              sorted_keys(m) -> [K]
#
# Differences from Go:
#   - Maps here are insertion-ordered (C2), so `all`, `keys` and `values`
#     come back in the order the keys were first inserted (Go's iteration
#     order is random).
#   - Iterators: alx has no range-over-func, so Go's iter.Seq / iter.Seq2 are
#     slices (`[(K, V)]` for a Seq2), built all at once; `insert` and
#     `collect` take one.
#   - No nil maps: `clone` of an empty map is an empty map, and `equal`
#     can't tell nil from empty (neither can Go's).
#   - `copy` shadows the builtin copy inside this package (S12); callers
#     write `maps.copy(dst, src)`.
#   - `sorted_keys` is an alexandrite convenience for the common
#     `slices.sorted(maps.keys(m))`.
import "slices"

# Every (key, value) of `m`, in insertion order.
pub def all[K, V](m: Map[K, V]) -> [(K, V)] {
  out: [(K, V)] = []
  for k, v in m { out << (k, v) }
  out
}

# Adds the pairs of `seq` to `m`, overwriting the values of existing keys.
pub def insert[K, V](m: Map[K, V], seq: [(K, V)]) {
  for kv in seq { m[kv[0]] = kv[1] }
}

# A new map of the pairs of `seq` (a later pair wins for a repeated key).
pub def collect[K, V](seq: [(K, V)]) -> Map[K, V] {
  m: Map[K, V] = {}
  insert(m, seq)
  m
}

# The keys of `m`, in insertion order.
pub def keys[K, V](m: Map[K, V]) -> [K] {
  out: [K] = []
  for k, _ in m { out << k }
  out
}

# The values of `m`, in key insertion order.
pub def values[K, V](m: Map[K, V]) -> [V] {
  out: [V] = []
  for _, v in m { out << v }
  out
}

# The keys of `m`, ascending.
pub def sorted_keys[K, V](m: Map[K, V]) -> [K] {
  out = keys(m)
  slices.sort(out)
  out
}

# A new map with the same entries (the values themselves are not deep-copied).
pub def clone[K, V](m: Map[K, V]) -> Map[K, V] {
  m.dup
}

# Sets dst[k] = v for every entry of `src`.
pub def copy[K, V](dst: Map[K, V], src: Map[K, V]) {
  for k, v in src { dst[k] = v }
}

# Removes the entries for which `del(k, v)` is true.
pub def delete_func[K, V](m: Map[K, V], del: (K, V) -> Bool) {
  doomed: [K] = []
  for k, v in m {
    doomed << k if del(k, v)
  }
  for k in doomed { m.delete(k) }
}

# Whether two maps have the same keys with equal values.
pub def equal[K, V](a: Map[K, V], b: Map[K, V]) -> Bool {
  return false if a.size != b.size
  for k, v in a {
    return false if !b.key?(k)
    w = b[k] || v
    return false if w != v
  }
  true
}

# `equal` with `eq` comparing the values (which may differ in type).
pub def equal_func[K, V1, V2](a: Map[K, V1], b: Map[K, V2], eq: (V1, V2) -> Bool) -> Bool {
  return false if a.size != b.size
  for k, v in a {
    return false if !b.key?(k)
    if w = b[k] {
      return false if !eq(v, w)
    }
  }
  true
}
