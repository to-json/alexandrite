# Package maps: Go's maps (S2).
#
# Maps here are insertion-ordered (C2), so `keys` and `values` come back in the
# order the keys were first inserted (Go 1.21 returns iterators in random
# order). `sorted_keys` is an alexandrite convenience for the common
# `slices.sorted(maps.keys(m))`.
import "slices"

# The keys of `m`, in insertion order.
pub def keys[K, V](m: Map[K, V]) -> [K] {
  out: [K] = []
  for k, _ in m { out << k }
  out
}

# The values of `m`, in key insertion order.
pub def values[K, V](m: Map[K, V]) -> [V] {
  out: [V] = []
  for _, v in m { out << v }
  out
}

# The keys of `m`, ascending.
pub def sorted_keys[K, V](m: Map[K, V]) -> [K] {
  out = keys(m)
  slices.sort(out)
  out
}

# A new map with the same entries (the values themselves are not deep-copied).
pub def clone[K, V](m: Map[K, V]) -> Map[K, V] {
  m.dup
}

# Sets dst[k] = v for every entry of `src`.
pub def copy[K, V](dst: Map[K, V], src: Map[K, V]) {
  for k, v in src { dst[k] = v }
}

# Removes the entries for which `del(k, v)` is true.
pub def delete_func[K, V](m: Map[K, V], del: (K, V) -> Bool) {
  doomed: [K] = []
  for k, v in m {
    doomed << k if del(k, v)
  }
  for k in doomed { m.delete(k) }
}

# Whether two maps have the same keys with equal values.
pub def equal[K, V](a: Map[K, V], b: Map[K, V]) -> Bool {
  return false if a.size != b.size
  for k, v in a {
    return false if !b.key?(k)
    w = b[k] || v
    return false if w != v
  }
  true
}

# `equal` with `eq` comparing the values (which may differ in type).
pub def equal_func[K, V1, V2](a: Map[K, V1], b: Map[K, V2], eq: (V1, V2) -> Bool) -> Bool {
  return false if a.size != b.size
  for k, v in a {
    return false if !b.key?(k)
    if w = b[k] {
      return false if !eq(v, w)
    }
  }
  true
}
