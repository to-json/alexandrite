def sample -> Map[Str, Int] {
  m: Map[Str, Int] = {}
  m["zed"] = 3
  m["ada"] = 1
  m["bob"] = 2
  m
}

test "keys and values keep insertion order" {
  m = sample()
  assert slices.equal(keys(m), ["zed", "ada", "bob"])
  assert slices.equal(values(m), [3, 1, 2])
  m.delete("ada")
  m["ada"] = 9
  assert slices.equal(keys(m), ["zed", "bob", "ada"])
  e: Map[Str, Int] = {}
  assert_eq keys(e).size, 0
  assert_eq values(e).size, 0
}

test "sorted_keys" {
  assert slices.equal(sorted_keys(sample()), ["ada", "bob", "zed"])
  n: Map[Int, Str] = {}
  n[30] = "c"
  n[-2] = "a"
  n[7] = "b"
  assert slices.equal(sorted_keys(n), [-2, 7, 30])
  assert slices.equal(values(n), ["c", "a", "b"])
}

test "clone is independent" {
  m = sample()
  c = clone(m)
  c["new"] = 4
  m["zed"] = 100
  assert_eq m.size, 3
  assert_eq c.size, 4
  assert_eq (c["zed"] || -1), 3
}

test "copy merges src into dst" {
  dst = sample()
  src: Map[Str, Int] = {}
  src["ada"] = 10
  src["eve"] = 5
  copy(dst, src)
  assert_eq dst.size, 4
  assert_eq (dst["ada"] || -1), 10
  assert_eq (dst["eve"] || -1), 5
  assert_eq src.size, 2
  assert slices.equal(keys(dst), ["zed", "ada", "bob", "eve"])
  e: Map[Str, Int] = {}
  copy(dst, e)
  assert_eq dst.size, 4
}

test "delete_func" {
  m = sample()
  delete_func(m, ->(k: Str, v: Int) -> Bool { v % 2 == 1 })
  assert slices.equal(keys(m), ["bob"])
  delete_func(m, ->(k: Str, v: Int) -> Bool { false })
  assert_eq m.size, 1
  delete_func(m, ->(k: Str, v: Int) -> Bool { true })
  assert_eq m.size, 0
  big: Map[Int, Int] = {}
  for i in 0...1000 { big[i] = i }
  delete_func(big, ->(k: Int, v: Int) -> Bool { k % 3 != 0 })
  assert_eq big.size, 334
}

test "equal and equal_func" {
  a = sample()
  b: Map[Str, Int] = {}
  b["bob"] = 2
  b["zed"] = 3
  b["ada"] = 1
  assert equal(a, b)
  b["ada"] = 5
  assert !equal(a, b)
  b["ada"] = 1
  b["x"] = 1
  assert !equal(a, b)
  c: Map[Str, Int] = {}
  assert !equal(a, c)
  d: Map[Str, Int] = {}
  assert equal(c, d)
  e = sample()
  e.delete("ada")
  e["other"] = 1
  assert !equal(a, e)
  f: Map[Str, Str] = {}
  f["zed"] = "3"
  f["ada"] = "1"
  f["bob"] = "2"
  assert equal_func(a, f, ->(i: Int, s: Str) -> Bool { i.to_s == s })
  f["bob"] = "x"
  assert !equal_func(a, f, ->(i: Int, s: Str) -> Bool { i.to_s == s })
}
