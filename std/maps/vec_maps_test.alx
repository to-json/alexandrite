  assert_eq vec_sorted(collect([(2, 2), (4, -2)])), [(2, 2), (4, -2)]
  assert_eq collect([(2, 2), (4, -2)]).size, 2
  assert_eq vec_sorted(collect([(-1, -2), (2, 0), (-1, 2), (1, -1), (0, -2), (2, 3), (1, 1)])), [(-1, 2), (0, -2), (1, 1), (2, 3)]
  assert_eq collect([(-1, -2), (2, 0), (-1, 2), (1, -1), (0, -2), (2, 3), (1, 1)]).size, 4
  assert_eq vec_sorted(collect([(3, 3), (-2, -2)])), [(-2, -2), (3, 3)]
  assert_eq collect([(3, 3), (-2, -2)]).size, 2
  assert_eq vec_sorted(collect([(3, 4), (2, 4), (3, 2), (1, 3)])), [(1, 3), (2, 4), (3, 2)]
  assert_eq collect([(3, 4), (2, 4), (3, 2), (1, 3)]).size, 3
  assert_eq vec_sorted(collect([(-1, -2), (3, -1), (-1, -1), (4, -2), (-1, 3)])), [(-1, 3), (3, -1), (4, -2)]
  assert_eq collect([(-1, -2), (3, -1), (-1, -1), (4, -2), (-1, 3)]).size, 3
