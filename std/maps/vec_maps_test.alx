  assert_eq collect([(0, 2), (0, 2), (0, 1), (0, -2), (0, 1), (0, 2), (0, 4), (0, 2)]).size, 1
  assert_eq vec_sorted(collect([(1, 4), (2, 2), (-1, 3), (-1, 4), (1, 3), (-1, 1)])), [(-1, 1), (1, 3), (2, 2)]
  assert_eq collect([(1, 4), (2, 2), (-1, 3), (-1, 4), (1, 3), (-1, 1)]).size, 3
  assert_eq vec_sorted(collect([(2, 1), (7, 1), (5, 3), (5, 0)])), [(2, 1), (5, 0), (7, 1)]
  assert_eq collect([(2, 1), (7, 1), (5, 3), (5, 0)]).size, 3
  assert_eq vec_sorted(collect([(-1, 1), (1, 4), (0, 4), (3, 4), (0, 1), (-1, 1), (1, 4), (1, 0), (-1, 4)])), [(-1, 4), (0, 1), (1, 0), (3, 4)]
  assert_eq collect([(-1, 1), (1, 4), (0, 4), (3, 4), (0, 1), (-1, 1), (1, 4), (1, 0), (-1, 4)]).size, 4
  assert_eq vec_sorted(collect([(0, -1), (0, 4), (0, 3), (0, 1), (0, 3), (0, 1), (0, 2), (0, -2)])), [(0, -2)]
  assert_eq collect([(0, -1), (0, 4), (0, 3), (0, 1), (0, 3), (0, 1), (0, 2), (0, -2)]).size, 1
  assert_eq vec_sorted(collect([(7, 1), (3, -1), (-1, -2), (3, 3), (0, 4), (1, 2), (0, 0)])), [(-1, -2), (0, 0), (1, 2), (3, 3), (7, 1)]
  assert_eq collect([(7, 1), (3, -1), (-1, -2), (3, 3), (0, 4), (1, 2), (0, 0)]).size, 5
  assert_eq vec_sorted(collect([(0, -2)])), [(0, -2)]
