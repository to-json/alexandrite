  assert_eq collect([(4, -2), (1, 2), (-1, -1), (-2, -1), (-1, -2), (-2, 2), (-1, -2), (1, 4)]).size, 4
  assert_eq vec_sorted(collect([(-1, 2), (1, -2), (3, 3), (4, 0), (-1, -2), (3, 3)])), [(-1, -2), (1, -2), (3, 3), (4, 0)]
  assert_eq collect([(-1, 2), (1, -2), (3, 3), (4, 0), (-1, -2), (3, 3)]).size, 4
  assert_eq vec_sorted(collect([(0, 1), (1, -1), (1, 0), (1, 4), (1, -2), (1, 3), (0, 4), (0, 3)])), [(0, 3), (1, 3)]
  assert_eq collect([(0, 1), (1, -1), (1, 0), (1, 4), (1, -2), (1, 3), (0, 4), (0, 3)]).size, 2
  assert_eq vec_sorted(collect(vec_pairs())), vec_pairs()
  assert_eq collect(vec_pairs()).size, 0
  assert_eq vec_sorted(collect(vec_pairs())), vec_pairs()
  assert_eq collect(vec_pairs()).size, 0
  assert_eq vec_sorted(collect([(-1, 2), (1, 3), (1, 0), (1, 3), (-1, 0), (-1, -2), (1, 4)])), [(-1, -2), (1, 4)]
  assert_eq collect([(-1, 2), (1, 3), (1, 0), (1, 3), (-1, 0), (-1, -2), (1, 4)]).size, 2
  assert_eq vec_sorted(collect([(4, 0), (3, -2), (1, 1), (3, 1), (4, -1), (3, 3)])), [(1, 1), (3, 3), (4, -1)]
  assert_eq collect([(4, 0), (3, -2), (1, 1), (3, 1), (4, -1), (3, 3)]).size, 3
