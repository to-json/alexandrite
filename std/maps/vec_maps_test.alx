  assert_eq vec_sorted(collect([(4, 2), (-4, 1), (5, 1), (2, 4), (6, -1), (-3, -2), (-3, 3)])), [(-4, 1), (-3, 3), (2, 4), (4, 2), (5, 1), (6, -1)]
  assert_eq collect([(4, 2), (-4, 1), (5, 1), (2, 4), (6, -1), (-3, -2), (-3, 3)]).size, 6
  assert_eq vec_sorted(collect([(-1, 2), (-1, 0), (2, 4), (-1, -1), (-1, 1), (-1, 0)])), [(-1, 0), (2, 4)]
  assert_eq collect([(-1, 2), (-1, 0), (2, 4), (-1, -1), (-1, 1), (-1, 0)]).size, 2
