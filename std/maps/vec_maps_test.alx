# Generated from Go's maps (go1.27.1, .scratch/gen/maps); do not edit by hand.
import "math"

def vec_pairs -> [(Int, Int)] {
  e: [(Int, Int)] = []
  e
}

# The pairs of m sorted by key (Go's maps have no order to compare).
def vec_sorted(m: Map[Int, Int]) -> [(Int, Int)] {
  out: [(Int, Int)] = []
  for k in sorted_keys(m) { out << (k, m[k] || 0) }
  out
}

def vec_copy(dst: [(Int, Int)], src: [(Int, Int)]) -> [(Int, Int)] {
  d = collect(dst)
  copy(d, collect(src))
  vec_sorted(d)
}

def vec_insert(dst: [(Int, Int)], src: [(Int, Int)]) -> [(Int, Int)] {
  d = collect(dst)
  insert(d, src)
  vec_sorted(d)
}

def vec_delete_odd(ps: [(Int, Int)]) -> [(Int, Int)] {
  m = collect(ps)
  delete_func(m) { |k, v| (k + v) % 2 != 0 }
  vec_sorted(m)
}

def vec_fmap(ps: [(Int, Float)]) -> Map[Int, Float] {
  collect(ps)
}

test "vectors: collect 1" {
  nan = math.nan
  inf = math.inf(1)
  nz = math.copysign(0.0, -1.0)
  _ = nan + inf + nz
  assert_eq vec_sorted(collect([(-2, 4), (3, 4), (-2, 0), (-2, -1), (0, 2), (3, 1), (-2, 0), (-2, 4)])), [(-2, 4), (0, 2), (3, 1)]
  assert_eq collect([(-2, 4), (3, 4), (-2, 0), (-2, -1), (0, 2), (3, 1), (-2, 0), (-2, 4)]).size, 3
  assert_eq vec_sorted(collect([(1, 1), (-2, 0), (-2, 1), (2, 3)])), [(-2, 1), (1, 1), (2, 3)]
  assert_eq collect([(1, 1), (-2, 0), (-2, 1), (2, 3)]).size, 3
  assert_eq vec_sorted(collect([(3, 0), (-1, 2)])), [(-1, 2), (3, 0)]
  assert_eq collect([(3, 0), (-1, 2)]).size, 2
  assert_eq vec_sorted(collect([(1, 2), (0, 3)])), [(0, 3), (1, 2)]
  assert_eq collect([(1, 2), (0, 3)]).size, 2
  assert_eq vec_sorted(collect([(0, -1), (0, -2), (0, -1)])), [(0, -1)]
  assert_eq collect([(0, -1), (0, -2), (0, -1)]).size, 1
  assert_eq vec_sorted(collect([(3, 1), (2, 3), (4, 0)])), [(2, 3), (3, 1), (4, 0)]
  assert_eq collect([(3, 1), (2, 3), (4, 0)]).size, 3
  assert_eq vec_sorted(collect([(0, -2), (0, 0)])), [(0, 0)]
  assert_eq collect([(0, -2), (0, 0)]).size, 1
  assert_eq vec_sorted(collect([(-2, 4), (5, 2), (-2, 0), (-2, -2), (7, -2)])), [(-2, -2), (5, 2), (7, -2)]
  assert_eq collect([(-2, 4), (5, 2), (-2, 0), (-2, -2), (7, -2)]).size, 3
  assert_eq vec_sorted(collect([(0, -2), (0, 0), (0, 4), (0, -1), (0, -1), (0, -2), (0, 3)])), [(0, 3)]
  assert_eq collect([(0, -2), (0, 0), (0, 4), (0, -1), (0, -1), (0, -2), (0, 3)]).size, 1
  assert_eq vec_sorted(collect([(-2, 2), (-1, -1), (3, -2), (-2, 3), (-2, 4), (0, 0), (1, 3)])), [(-2, 4), (-1, -1), (0, 0), (1, 3), (3, -2)]
  assert_eq collect([(-2, 2), (-1, -1), (3, -2), (-2, 3), (-2, 4), (0, 0), (1, 3)]).size, 5
  assert_eq vec_sorted(collect([(-2, 0), (-2, -2)])), [(-2, -2)]
  assert_eq collect([(-2, 0), (-2, -2)]).size, 1
  assert_eq vec_sorted(collect([(5, -1), (-2, 2), (1, 3)])), [(-2, 2), (1, 3), (5, -1)]
  assert_eq collect([(5, -1), (-2, 2), (1, 3)]).size, 3
  assert_eq vec_sorted(collect([(-2, -2), (3, 4), (4, 1), (1, -2), (2, 1), (5, -2), (3, -1), (-1, 3), (5, 2)])), [(-2, -2), (-1, 3), (1, -2), (2, 1), (3, -1), (4, 1), (5, 2)]
  assert_eq collect([(-2, -2), (3, 4), (4, 1), (1, -2), (2, 1), (5, -2), (3, -1), (-1, 3), (5, 2)]).size, 7
  assert_eq vec_sorted(collect(vec_pairs())), vec_pairs()
  assert_eq collect(vec_pairs()).size, 0
  assert_eq vec_sorted(collect([(0, -2)])), [(0, -2)]
  assert_eq collect([(0, -2)]).size, 1
  assert_eq vec_sorted(collect([(1, 1), (-2, 3), (-1, -1), (0, -2), (1, -1), (2, 0)])), [(-2, 3), (-1, -1), (0, -2), (1, -1), (2, 0)]
  assert_eq collect([(1, 1), (-2, 3), (-1, -1), (0, -2), (1, -1), (2, 0)]).size, 5
  assert_eq vec_sorted(collect([(5, 4), (4, 2), (-1, 3), (-2, 2), (7, 0), (3, -2), (1, -2), (3, -2), (-3, -2)])), [(-3, -2), (-2, 2), (-1, 3), (1, -2), (3, -2), (4, 2), (5, 4), (7, 0)]
