  assert_eq equal(vec_fmap([(1, inf), (2, nan), (2, 1.5)]), vec_fmap([(1, inf), (2, nan), (2, 1.5)])), true
  assert_eq equal_func(vec_fmap([(1, inf), (2, nan), (2, 1.5)]), vec_fmap([(1, inf), (2, nan), (2, 1.5)])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(1, inf), (2, 0.0)])), false
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(1, inf), (2, 0.0)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, inf), (1, nz), (0, nz)]), vec_fmap([(0, inf)])), false
  assert_eq equal_func(vec_fmap([(0, inf), (1, nz), (0, nz)]), vec_fmap([(0, inf)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 1.5)])), false
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 1.5)])) { |x, y| x == y || (x != x && y != y) }, false
}

test "vectors: float values 2" {
  nan = math.nan
  inf = math.inf(1)
  nz = math.copysign(0.0, -1.0)
  _ = nan + inf + nz
  assert_eq equal(vec_fmap([(0, nan)]), vec_fmap([(1, 0.0), (1, 0.0)])), false
  assert_eq equal_func(vec_fmap([(0, nan)]), vec_fmap([(1, 0.0), (1, 0.0)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(1, 1.5), (0, nz)]), vec_fmap([(2, nan), (2, 0.0)])), false
  assert_eq equal_func(vec_fmap([(1, 1.5), (0, nz)]), vec_fmap([(2, nan), (2, 0.0)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 0.0)][0...0])), true
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 0.0)][0...0])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 0.0)][0...0])), true
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 0.0)][0...0])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(2, nan), (2, nan), (0, nz)]), vec_fmap([(0, inf), (0, inf)])), false
  assert_eq equal_func(vec_fmap([(2, nan), (2, nan), (0, nz)]), vec_fmap([(0, inf), (0, inf)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(1, inf), (0, nan), (0, inf)])), false
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(1, inf), (0, nan), (0, inf)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 0.0)][0...0])), true
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 0.0)][0...0])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(0, 1.5), (2, nz), (2, nan)]), vec_fmap([(2, nz), (1, 1.5), (0, 1.5)])), false
  assert_eq equal_func(vec_fmap([(0, 1.5), (2, nz), (2, nan)]), vec_fmap([(2, nz), (1, 1.5), (0, 1.5)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(2, nan)]), vec_fmap([(1, 0.0), (1, 1.5)])), false
  assert_eq equal_func(vec_fmap([(2, nan)]), vec_fmap([(1, 0.0), (1, 1.5)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 1.5), (0, nz)])), false
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 1.5), (0, nz)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(2, nz)]), vec_fmap([(2, nz)])), true
  assert_eq equal_func(vec_fmap([(2, nz)]), vec_fmap([(2, nz)])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(2, 0.0), (2, 1.5)])), false
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(2, 0.0), (2, 1.5)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 0.0)][0...0])), true
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, 0.0)][0...0])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(2, nz), (1, inf)]), vec_fmap([(2, nz), (1, inf)])), true
  assert_eq equal_func(vec_fmap([(2, nz), (1, inf)]), vec_fmap([(2, nz), (1, inf)])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(1, nan), (2, 0.0), (2, nz)]), vec_fmap([(1, nan), (2, 0.0), (2, nz)])), false
  assert_eq equal_func(vec_fmap([(1, nan), (2, 0.0), (2, nz)]), vec_fmap([(1, nan), (2, 0.0), (2, nz)])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(0, nan), (0, 0.0)]), vec_fmap([(0, nan), (0, 0.0)])), true
  assert_eq equal_func(vec_fmap([(0, nan), (0, 0.0)]), vec_fmap([(0, nan), (0, 0.0)])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, inf), (0, 1.5)])), false
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(0, inf), (0, 1.5)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, 0.0), (2, inf), (2, 1.5)]), vec_fmap([(0, nan)])), false
  assert_eq equal_func(vec_fmap([(0, 0.0), (2, inf), (2, 1.5)]), vec_fmap([(0, nan)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(1, nz), (1, nz)])), false
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(1, nz), (1, nz)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(2, nz)]), vec_fmap([(1, 1.5)])), false
  assert_eq equal_func(vec_fmap([(2, nz)]), vec_fmap([(1, 1.5)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, nz)]), vec_fmap([(1, 1.5), (1, inf), (2, inf)])), false
  assert_eq equal_func(vec_fmap([(0, nz)]), vec_fmap([(1, 1.5), (1, inf), (2, inf)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(2, inf), (0, inf)]), vec_fmap([(2, inf), (0, inf)])), true
  assert_eq equal_func(vec_fmap([(2, inf), (0, inf)]), vec_fmap([(2, inf), (0, inf)])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(1, inf), (1, 1.5)]), vec_fmap([(1, inf), (1, 1.5)])), true
  assert_eq equal_func(vec_fmap([(1, inf), (1, 1.5)]), vec_fmap([(1, inf), (1, 1.5)])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(1, nz)])), false
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(1, nz)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(2, nz)]), vec_fmap([(2, nz)])), true
  assert_eq equal_func(vec_fmap([(2, nz)]), vec_fmap([(2, nz)])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(2, 1.5)]), vec_fmap([(0, 0.0)][0...0])), false
  assert_eq equal_func(vec_fmap([(2, 1.5)]), vec_fmap([(0, 0.0)][0...0])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(2, inf), (0, 0.0)]), vec_fmap([(2, inf), (0, 0.0)])), true
  assert_eq equal_func(vec_fmap([(2, inf), (0, 0.0)]), vec_fmap([(2, inf), (0, 0.0)])) { |x, y| x == y || (x != x && y != y) }, true
  assert_eq equal(vec_fmap([(1, inf)]), vec_fmap([(2, nan), (1, 1.5), (0, 1.5)])), false
  assert_eq equal_func(vec_fmap([(1, inf)]), vec_fmap([(2, nan), (1, 1.5), (0, 1.5)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(2, 1.5), (2, 1.5)])), false
  assert_eq equal_func(vec_fmap([(0, 0.0)][0...0]), vec_fmap([(2, 1.5), (2, 1.5)])) { |x, y| x == y || (x != x && y != y) }, false
  assert_eq equal(vec_fmap([(2, inf), (1, inf), (2, nz)]), vec_fmap([(2, 0.0)])), false
  assert_eq equal_func(vec_fmap([(2, inf), (1, inf), (2, nz)]), vec_fmap([(2, 0.0)])) { |x, y| x == y || (x != x && y != y) }, false
}
