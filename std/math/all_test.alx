    f = math.expm1(a)
    want(veryclose(w[i], f), "expm1(#{a})", f, w[i])
  }
  w = expm1_large
  for i in 0...v.size {
    a = v[i] * 10.0
    f = math.expm1(a)
    want(close(w[i], f), "expm1(#{a})", f, w[i])
