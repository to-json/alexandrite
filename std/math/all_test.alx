test "TestRemainder" {
  v = vf
  w = remainder
  for i in 0...v.size {
    f = math.remainder(10.0, v[i])
    want(w[i] == f, "remainder(10, #{v[i]})", f, w[i])
  }
  special2("remainder", vffmod_sc, fmod_sc) { |x, y| math.remainder(x, y) }
  # verify precision of result for extreme inputs
  f = math.remainder(5.9790119248836734e+200, 1.1258465975523544)
  want(f == -0.4810497673014966, "remainder(5.9790119248836734e200, 1.1258465975523544)", f, -0.4810497673014966)
  # verify that sign is correct when r == 0.
  check = ->(x: Float, y: Float) {
    r = math.remainder(x, y)
    assert !(r == 0.0 && math.signbit(r) != math.signbit(x)), "remainder(#{x}, #{y}) = #{r}, sign of (r == 0) != sign of x"
  }
  x = 0.0
  while x <= 3.0 {
    y = 1.0
    while y <= 3.0 {
      check.call(x, y)
      check.call(x, -y)
      check.call(-x, y)
      check.call(-x, -y)
      y += 1.0
    }
    x += 1.0
  }
}

