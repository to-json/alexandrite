    want(close(w2[i], f), "yn(2, #{a})", f, w2[i])
    f = math.yn(-3, a)
    want(close(wm3[i], f), "yn(-3, #{a})", f, wm3[i])
  }
  special("yn(2, x)", vfy0_sc, y2_sc) { |x| math.yn(2, x) }
  special("yn(-3, x)", vfy0_sc, y_m3_sc) { |x| math.yn(-3, x) }
  f = math.yn(0, 0.0)
  want(alike(math.inf(-1), f), "yn(0, 0)", f, math.inf(-1))
}

test "TestFMA" {
  for c in fma_c {
