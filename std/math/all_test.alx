test "TestMod" {
  v = vf
  w = fmod
  for i in 0...v.size {
    f = math.mod(10.0, v[i])
    want(w[i] == f, "mod(10, #{v[i]})", f, w[i])
  }
  special2("mod", vffmod_sc, fmod_sc) { |x, y| math.mod(x, y) }
  # verify precision of result for extreme inputs
  f = math.mod(5.9790119248836734e+200, 1.1258465975523544)
  want(f == 0.6447968302508578, "mod(5.9790119248836734e200, 1.1258465975523544)", f, 0.6447968302508578)
}

test "TestFrexp" {
  v = vf
  w = frexp
  for i in 0...v.size {
    f, j = math.frexp(v[i])
    assert veryclose(w[i][0], f) && w[i][1] == j, "frexp(#{v[i]}) = #{f}, #{j}, want #{w[i][0]}, #{w[i][1]}"
  }
  xs = vffrexp_sc
  w = frexp_sc
  for i in 0...xs.size {
    f, j = math.frexp(xs[i])
    assert alike(w[i][0], f) && w[i][1] == j, "frexp(#{xs[i]}) = #{f}, #{j}, want #{w[i][0]}, #{w[i][1]}"
  }
  xs = vffrexp_bc
  w = frexp_bc
  for i in 0...xs.size {
    f, j = math.frexp(xs[i])
    assert alike(w[i][0], f) && w[i][1] == j, "frexp(#{xs[i]}) = #{f}, #{j}, want #{w[i][0]}, #{w[i][1]}"
  }
}

test "TestGamma" {
  v = vf
  w = gamma
  for i in 0...v.size {
    f = math.gamma(v[i])
    want(close(w[i], f), "gamma(#{v[i]})", f, w[i])
  }
  for g in vfgamma {
    x, gw = g
    f = math.gamma(x)
    ok = false
    if math.is_nan(gw) || math.is_inf(gw, 0) || gw == 0.0 || f == 0.0 {
      ok = alike(gw, f)
    } else if x > -50.0 && x <= 171.0 {
      ok = veryclose(gw, f)
    } else {
      ok = close(gw, f)
    }
    want(ok, "gamma(#{x})", f, gw)
  }
}

test "TestHypot" {
  v = vf
  th = tanh
  for i in 0...v.size {
    a = math.abs(1e200 * th[i] * math.sqrt(2.0))
    f = math.hypot(1e200 * th[i], 1e200 * th[i])
    want(veryclose(a, f), "hypot(#{1e200 * th[i]}, #{1e200 * th[i]})", f, a)
  }
  special2("hypot", vfhypot_sc, hypot_sc) { |x, y| math.hypot(x, y) }
}

test "TestIlogb" {
  v = vf
  fr = frexp
  for i in 0...v.size {
    a = fr[i][1] - 1 # adjust because fr is in the interval [1/2, 1)
    e = math.ilogb(v[i])
    assert a == e, "ilogb(#{v[i]}) = #{e}, want #{a}"
  }
  xs = vflogb_sc
  ws = ilogb_sc
  for i in 0...xs.size {
    e = math.ilogb(xs[i])
    assert ws[i] == e, "ilogb(#{xs[i]}) = #{e}, want #{ws[i]}"
  }
  xs = vffrexp_bc
  lb = logb_bc
  for i in 0...xs.size {
    e = math.ilogb(xs[i])
    assert lb[i].to_i == e, "ilogb(#{xs[i]}) = #{e}, want #{lb[i]}"
  }
}

