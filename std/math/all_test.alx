  }
  xs = vffrexp_bc
  fr = frexp_bc
  for i in 0...xs.size {
    f = math.ldexp(fr[i][0], fr[i][1])
    want(alike(xs[i], f), "ldexp(#{fr[i][0]}, #{fr[i][1]})", f, xs[i])
