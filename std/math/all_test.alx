test "TestLog" {
  v = vf
  w = log
  for i in 0...v.size {
    a = math.abs(v[i])
    f = math.log(a)
    want(w[i] == f, "log(#{a})", f, w[i])
  }
  f = math.log(10.0)
  want(f == math.LN10, "log(10)", f, math.LN10)
  special("log", vflog_sc, log_sc) { |x| math.log(x) }
}

