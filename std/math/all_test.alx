test "TestLog2" {
  v = vf
  w = log2
  for i in 0...v.size {
    a = math.abs(v[i])
    f = math.log2(a)
    want(veryclose(w[i], f), "log2(#{a})", f, w[i])
  }
  f = math.log2(math.E)
  want(f == math.LOG2E, "log2(e)", f, math.LOG2E)
  special("log2", vflog_sc, log_sc) { |x| math.log2(x) }
  for i in -1074..1023 {
    f = math.ldexp(1.0, i)
    l = math.log2(f)
    want(l == i.to_f, "log2(2**#{i})", l, i.to_f)
  }
}

