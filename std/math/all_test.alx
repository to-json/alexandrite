test "TestCopysign" {
  v = vf
  w = copysign
  for i in 0...v.size {
    f = math.copysign(v[i], -1.0)
    want(w[i] == f, "copysign(#{v[i]}, -1)", f, w[i])
  }
  for i in 0...v.size {
    f = math.copysign(v[i], 1.0)
    want(-w[i] == f, "copysign(#{v[i]}, 1)", f, -w[i])
  }
  special("copysign(x, -1)", vfcopysign_sc, copysign_sc) { |x| math.copysign(x, -1.0) }
}

