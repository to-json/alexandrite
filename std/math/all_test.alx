#![test(external)]
# Go's math tests (all_test.go, huge_test.go, const_test.go; package
# math_test), translated test for test. The tables are in all_data_test.alx.
#
# Go also runs ExpGo, Exp2Go, HypotGo and SqrtGo (the portable code behind
# its assembly) and PortableFMA: alx has one implementation of each, which
# the same loops test once. TestTrigReduce needs the unexported trig_reduce
# and is in math_test.alx.

import "math"
import "strconv"

def tolerance(a: Float, b: Float, e: Float) -> Bool {
  # Multiplying by e here can underflow denormal values to zero. Check a == b
  # so that at least if a and b are small and identical we say they match.
  return true if a == b
  d = a - b
  d = -d if d < 0.0
  # b is the correct (expected) value, a the actual one: make the error
  # tolerance a fraction of b, not a.
  if b != 0.0 {
    e = e * b
    e = -e if e < 0.0
  }
  d < e
}

def close(a: Float, b: Float) -> Bool { tolerance(a, b, 1e-14) }
def veryclose(a: Float, b: Float) -> Bool { tolerance(a, b, 4e-16) }
def soclose(a: Float, b: Float, e: Float) -> Bool { tolerance(a, b, e) }

def alike(a: Float, b: Float) -> Bool {
  return true if math.is_nan(a) && math.is_nan(b)
  return math.signbit(a) == math.signbit(b) if a == b
  false
}

#[track_caller]
def want(ok: Bool, call: Str, got: Float, w: Float) {
  assert ok, "#{call} = #{got}, want #{w}"
}

# Go's special-case loops: f(xs[i]) is alike wants[i].
#[track_caller]
def special(name: Str, xs: [Float], wants: [Float], f: (Float) -> Float) {
  for i in 0...xs.size {
    got = f(xs[i])
    assert alike(wants[i], got), "#{name}(#{xs[i]}) = #{got}, want #{wants[i]}"
  }
}

#[track_caller]
def special2(name: Str, xs: [(Float, Float)], wants: [Float], f: (Float, Float) -> Float) {
  for i in 0...xs.size {
    x, y = xs[i]
    got = f(x, y)
    assert alike(wants[i], got), "#{name}(#{x}, #{y}) = #{got}, want #{wants[i]}"
  }
}

LARGE = 314159.26535897935 # float64(100000 * Pi)

test "TestMaxUint" {
  v: U64 = math.MAX_UINT
  assert v +% 1 == 0, "MAX_UINT should wrap around to zero: #{v +% 1}"
  v8: U8 = math.MAX_UINT8
  assert v8 +% 1 == 0, "MAX_UINT8 should wrap around to zero: #{v8 +% 1}"
  v16: U16 = math.MAX_UINT16
  assert v16 +% 1 == 0, "MAX_UINT16 should wrap around to zero: #{v16 +% 1}"
  v32: U32 = math.MAX_UINT32
  assert v32 +% 1 == 0, "MAX_UINT32 should wrap around to zero: #{v32 +% 1}"
  v64: U64 = math.MAX_UINT64
  assert v64 +% 1 == 0, "MAX_UINT64 should wrap around to zero: #{v64 +% 1}"
}

test "TestMaxInt" {
  v: Int = math.MAX_INT
  assert v +% 1 == math.MIN_INT, "MAX_INT should wrap around to MIN_INT: #{v +% 1}"
  v8: I8 = math.MAX_INT8
  assert v8 +% 1 == math.MIN_INT8, "MAX_INT8 should wrap around to MIN_INT8: #{v8 +% 1}"
  v16: I16 = math.MAX_INT16
  assert v16 +% 1 == math.MIN_INT16, "MAX_INT16 should wrap around to MIN_INT16: #{v16 +% 1}"
  v32: I32 = math.MAX_INT32
  assert v32 +% 1 == math.MIN_INT32, "MAX_INT32 should wrap around to MIN_INT32: #{v32 +% 1}"
  v64: I64 = math.MAX_INT64
  assert v64 +% 1 == math.MIN_INT64, "MAX_INT64 should wrap around to MIN_INT64: #{v64 +% 1}"
}

test "TestHugeCos" {
  xs = trig_huge
  ws = cos_huge
  for i in 0...xs.size {
    f2 = math.cos(xs[i])
    want(close(ws[i], f2), "cos(#{xs[i]})", f2, ws[i])
    f3 = math.cos(-xs[i])
    want(close(ws[i], f3), "cos(#{-xs[i]})", f3, ws[i])
  }
}

test "TestHugeSin" {
  xs = trig_huge
  ws = sin_huge
  for i in 0...xs.size {
    f2 = math.sin(xs[i])
    want(close(ws[i], f2), "sin(#{xs[i]})", f2, ws[i])
    f3 = math.sin(-xs[i])
    want(close(-ws[i], f3), "sin(#{-xs[i]})", f3, -ws[i])
  }
}

test "TestHugeSinCos" {
  xs = trig_huge
  ss = sin_huge
  cs = cos_huge
  for i in 0...xs.size {
    f2, g2 = math.sincos(xs[i])
    assert close(ss[i], f2) && close(cs[i], g2), "sincos(#{xs[i]}) = #{f2}, #{g2}"
    f3, g3 = math.sincos(-xs[i])
    assert close(-ss[i], f3) && close(cs[i], g3), "sincos(#{-xs[i]}) = #{f3}, #{g3}"
  }
}

test "TestHugeTan" {
  xs = trig_huge
  ws = tan_huge
  for i in 0...xs.size {
    f2 = math.tan(xs[i])
    want(close(ws[i], f2), "tan(#{xs[i]})", f2, ws[i])
    f3 = math.tan(-xs[i])
    want(close(-ws[i], f3), "tan(#{-xs[i]})", f3, -ws[i])
  }
}

test "TestNaN" {
  f64 = math.nan
  assert f64 != f64, "nan returns #{f64}, expected NaN"
  f32 = math.to_float32(f64)
  assert f32 != f32, "to_float32(nan) is #{f32}, expected NaN"
}

test "TestAcos" {
  v = vf
  w = acos
  for i in 0...v.size {
    a = v[i] / 10.0
    f = math.acos(a)
    want(close(w[i], f), "acos(#{a})", f, w[i])
  }
  special("acos", vfacos_sc, acos_sc) { |x| math.acos(x) }
}

