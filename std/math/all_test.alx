test "TestErfinv" {
  v = vf
  w = erfinv
  for i in 0...v.size {
    a = v[i] / 10.0
    f = math.erfinv(a)
    want(veryclose(w[i], f), "erfinv(#{a})", f, w[i])
  }
  special("erfinv", vferfinv_sc, erfinv_sc) { |x| math.erfinv(x) }
  x = -0.9
  while x <= 0.90 {
    f = math.erf(math.erfinv(x))
    want(close(x, f), "erf(erfinv(#{x}))", f, x)
    x += 1e-2
  }
  x = -0.9
  while x <= 0.90 {
    f = math.erfinv(math.erf(x))
    want(close(x, f), "erfinv(erf(#{x}))", f, x)
    x += 1e-2
  }
}

test "TestErfcinv" {
  v = vf
  w = erfinv
  for i in 0...v.size {
    a = 1.0 - (v[i] / 10.0)
    f = math.erfcinv(a)
    want(veryclose(w[i], f), "erfcinv(#{a})", f, w[i])
  }
  special("erfcinv", vferfcinv_sc, erfcinv_sc) { |x| math.erfcinv(x) }
  x = 0.1
  while x <= 1.9 {
    f = math.erfc(math.erfcinv(x))
    want(close(x, f), "erfc(erfcinv(#{x}))", f, x)
    x += 1e-2
  }
  x = 0.1
  while x <= 1.9 {
    f = math.erfcinv(math.erfc(x))
    want(close(x, f), "erfcinv(erfc(#{x}))", f, x)
    x += 1e-2
  }
}

