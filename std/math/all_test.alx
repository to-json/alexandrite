    got = math.fma(x, y, z)
    want(alike(got, w), "fma(#{x}, #{y}, #{z})", got, w)
  }
}

def fmsub(x: Float, y: Float, z: Float) -> Float { math.fma(x, y, -z) }
def fnmsub(x: Float, y: Float, z: Float) -> Float { math.fma(-x, y, z) }
def fnmadd(x: Float, y: Float, z: Float) -> Float { math.fma(-x, y, -z) }

test "TestFMANegativeArgs" {
  # Architectures with fused multiply-subtract and negated variants of fused
  # multiply-add and -subtract must apply them correctly.
  for c in fma_c {
    x, y, z, _w = c
    w = math.fma(x, y, -z)
    got = fmsub(x, y, z)
    want(alike(got, w), "fma(#{x}, #{y}, -(#{z}))", got, w)
    w = math.fma(-x, y, z)
    got = fnmsub(x, y, z)
    want(alike(got, w), "fma(-(#{x}), #{y}, #{z})", got, w)
    w = math.fma(-x, y, -z)
    got = fnmadd(x, y, z)
    want(alike(got, w), "fma(-(#{x}), #{y}, -(#{z}))", got, w)
  }
}

# Trig functions of high angle values return accurate results. [Since
# (vf[i] + large) - large != vf[i], testing for Trig(vf[i] + large) ==
# Trig(vf[i]), where large is a multiple of 2*Pi, is misleading.]
test "TestLargeCos" {
  v = vf
  w = cos_large
  for i in 0...v.size {
    f2 = math.cos(v[i] + LARGE)
    want(close(w[i], f2), "cos(#{v[i] + LARGE})", f2, w[i])
  }
}

test "TestLargeSin" {
  v = vf
  w = sin_large
  for i in 0...v.size {
    f2 = math.sin(v[i] + LARGE)
    want(close(w[i], f2), "sin(#{v[i] + LARGE})", f2, w[i])
  }
}

test "TestLargeSincos" {
  v = vf
  ws = sin_large
  wc = cos_large
  for i in 0...v.size {
    f2, g2 = math.sincos(v[i] + LARGE)
    assert close(ws[i], f2) && close(wc[i], g2), "sincos(#{v[i] + LARGE}) = #{f2}, #{g2}, want #{ws[i]}, #{wc[i]}"
  }
}

test "TestLargeTan" {
  v = vf
  w = tan_large
  for i in 0...v.size {
    f2 = math.tan(v[i] + LARGE)
    want(close(w[i], f2), "tan(#{v[i] + LARGE})", f2, w[i])
  }
}

# Go prints these constants with fmt.Sprint; float32 ones through strconv here.
test "TestFloatMinMax" {
  tests = [
    (strconv.format_float(math.MAX_FLOAT64, "g", -1, 64), "MAX_FLOAT64", "1.7976931348623157e+308"),
    (strconv.format_float(math.SMALLEST_NONZERO_FLOAT64, "g", -1, 64), "SMALLEST_NONZERO_FLOAT64", "5e-324"),
    (strconv.format_float(math.MAX_FLOAT32, "g", -1, 32), "MAX_FLOAT32", "3.4028235e+38"),
    (strconv.format_float(math.SMALLEST_NONZERO_FLOAT32, "g", -1, 32), "SMALLEST_NONZERO_FLOAT32", "1e-45"),
    ("#{math.MAX_FLOAT64}", "MAX_FLOAT64 interpolated", "1.7976931348623157e+308"),
    ("#{math.SMALLEST_NONZERO_FLOAT64}", "SMALLEST_NONZERO_FLOAT64 interpolated", "5e-324"),
  ]
  for t in tests {
    s, name, str = t
    assert s == str, "format(#{name}) = #{s}, want #{str}"
  }
}

test "TestFloatMinima" {
  q = math.to_float32(math.SMALLEST_NONZERO_FLOAT32 / 2.0)
  assert q == 0.0, "to_float32(SMALLEST_NONZERO_FLOAT32 / 2) = #{q}, want 0"
  q = math.SMALLEST_NONZERO_FLOAT64 / 2.0
  assert q == 0.0, "SMALLEST_NONZERO_FLOAT64 / 2 = #{q}, want 0"
}

# Go checks its float32 square-root optimization; alx has no float32 arithmetic,
# so this checks to_float32(sqrt(v)) against Go's float32 results instead.
test "TestFloat32Sqrt" {
  for v in sqrt32 {
    w = math.to_float32(math.sqrt(v))
    got = math.to_float32(math.sqrt(v))
    if math.is_nan(w) {
      assert math.is_nan(got), "got=#{got} want=NaN, v=#{v}"
      next
    }
    assert got == w, "got=#{got} want=#{w}, v=#{v}"
  }
}
