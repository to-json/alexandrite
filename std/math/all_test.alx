test "TestExp2" {
  v = vf
  w = exp2
  for i in 0...v.size {
    f = math.exp2(v[i])
    want(close(w[i], f), "exp2(#{v[i]})", f, w[i])
  }
  special("exp2", vfexp2_sc, exp2_sc) { |x| math.exp2(x) }
  for n in -1074...1024 {
    f = math.exp2(n.to_f)
    vf1 = math.ldexp(1.0, n)
    want(f == vf1, "exp2(#{n})", f, vf1)
  }
}

