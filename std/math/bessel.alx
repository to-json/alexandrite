# Bessel functions of the first and second kinds: Go's j0.go, j1.go and
# jn.go (from FreeBSD's msun), line for line, so results are bit-identical
# with Go's portable code on every backend.

INV_SQRT_PI = 0.5641895835477563 # 1 / SQRT_PI, rounded once as Go's constant is
TWO_OVER_PI = 0.6366197723675814 # 2 / PI, likewise
TWO129 = 6.80564733841877e+38    # 2**129
TWO302 = 8.148143905337944e+90   # 2**302

# ---- order zero ----

# The order-zero Bessel function of the first kind.
pub def j0(x: Float) -> Float {
  two_m27 = 7.450580596923828e-09 # 2**-27
  two_m13 = 0.0001220703125       # 2**-13
  r02 = 1.56249999999999947958e-02
  r03 = -1.89979294238854721751e-04
  r04 = 1.82954049532700665670e-06
  r05 = -4.61832688532103189199e-09
  s01 = 1.56191029464890010492e-02
  s02 = 1.16926784663337450260e-04
  s03 = 5.13546550207318111446e-07
  s04 = 1.16614003333790000205e-09
  return x if is_nan(x)
  return 0.0 if is_inf(x, 0)
  return 1.0 if x == 0.0
  x = x.abs
  if x >= 2.0 {
    s, c = sincos(x)
    ss = s - c
    cc = s + c
    if x < MAX_FLOAT64 / 2.0 {
      z = -cos(x + x)
      if s * c < 0.0 {
        cc = z / ss
      } else {
        ss = z / cc
      }
    }
    z = 0.0
    if x > TWO129 { # |x| > ~6.8056e+38
      z = INV_SQRT_PI * cc / x.sqrt
    } else {
      u = pzero(x)
      v = qzero(x)
      z = INV_SQRT_PI * (u * cc - v * ss) / x.sqrt
    }
    return z # |x| >= 2.0
  }
  if x < two_m13 {            # |x| < ~1.2207e-4
    return 1.0 if x < two_m27 # |x| < ~7.4506e-9
    return 1.0 - 0.25 * x * x # ~7.4506e-9 < |x| < ~1.2207e-4
  }
  z = x * x
  r = z * (r02 + z * (r03 + z * (r04 + z * r05)))
  s = 1.0 + z * (s01 + z * (s02 + z * (s03 + z * s04)))
  return 1.0 + z * (-0.25 + (r / s)) if x < 1.0 # |x| < 1.00
  u = 0.5 * x
  (1.0 + u) * (1.0 - u) + z * (r / s) # 1.0 < |x| < 2.0
}

# The order-zero Bessel function of the second kind.
pub def y0(x: Float) -> Float {
  two_m27 = 7.450580596923828e-09 # 2**-27
  u00 = -7.38042951086872317523e-02
  u01 = 1.76666452509181115538e-01
  u02 = -1.38185671945596898896e-02
  u03 = 3.47453432093683650238e-04
  u04 = -3.81407053724364161125e-06
  u05 = 1.95590137035022920206e-08
  u06 = -3.98205194132103398453e-11
  v01 = 1.27304834834123699328e-02
  v02 = 7.60068627350353253702e-05
  v03 = 2.59150851840457805467e-07
  v04 = 4.41110311332675467403e-10
  return nan if x < 0.0 || is_nan(x)
  return 0.0 if is_inf(x, 1)
  return inf(-1) if x == 0.0
  if x >= 2.0 { # |x| >= 2.0
    s, c = sincos(x)
    ss = s - c
    cc = s + c
    if x < MAX_FLOAT64 / 2.0 {
      z = -cos(x + x)
      if s * c < 0.0 {
        cc = z / ss
      } else {
        ss = z / cc
      }
    }
    z = 0.0
    if x > TWO129 { # |x| > ~6.8056e+38
      z = INV_SQRT_PI * ss / x.sqrt
    } else {
      u = pzero(x)
      v = qzero(x)
      z = INV_SQRT_PI * (u * ss + v * cc) / x.sqrt
    }
    return z # |x| >= 2.0
  }
  return u00 + TWO_OVER_PI * log(x) if x <= two_m27 # |x| < ~7.4506e-9
  z = x * x
  u = u00 + z * (u01 + z * (u02 + z * (u03 + z * (u04 + z * (u05 + z * u06)))))
  v = 1.0 + z * (v01 + z * (v02 + z * (v03 + z * v04)))
  u / v + TWO_OVER_PI * j0(x) * log(x) # ~7.4506e-9 < |x| < 2.0
}

# The asymptotic expansion's P0 for x >= 2.
def pzero(x: Float) -> Float {
  p = P0_R2
  q = P0_S2
  if x >= 8.0 {
    p = P0_R8
    q = P0_S8
  } else if x >= 4.5454 {
    p = P0_R5
    q = P0_S5
  } else if x >= 2.8571 {
    p = P0_R3
    q = P0_S3
  }
  z = 1.0 / (x * x)
  r = p[0] + z * (p[1] + z * (p[2] + z * (p[3] + z * (p[4] + z * p[5]))))
  s = 1.0 + z * (q[0] + z * (q[1] + z * (q[2] + z * (q[3] + z * q[4]))))
  1.0 + r / s
}

# The asymptotic expansion's Q0 for x >= 2.
def qzero(x: Float) -> Float {
  p = Q0_R2
  q = Q0_S2
  if x >= 8.0 {
    p = Q0_R8
    q = Q0_S8
  } else if x >= 4.5454 {
    p = Q0_R5
    q = Q0_S5
  } else if x >= 2.8571 {
    p = Q0_R3
    q = Q0_S3
  }
  z = 1.0 / (x * x)
  r = p[0] + z * (p[1] + z * (p[2] + z * (p[3] + z * (p[4] + z * p[5]))))
  s = 1.0 + z * (q[0] + z * (q[1] + z * (q[2] + z * (q[3] + z * (q[4] + z * q[5])))))
  (-0.125 + r / s) / x
}

# ---- order one ----

# The order-one Bessel function of the first kind.
pub def j1(x: Float) -> Float {
  two_m27 = 7.450580596923828e-09 # 2**-27
  r00 = -6.25000000000000000000e-02
  r01 = 1.40705666955189706048e-03
  r02 = -1.59955631084035597520e-05
  r03 = 4.96727999609584448412e-08
  s01 = 1.91537599538363460805e-02
  s02 = 1.85946785588630915560e-04
  s03 = 1.17718464042623683263e-06
  s04 = 5.04636257076217042715e-09
  s05 = 1.23542274426137913908e-11
  return x if is_nan(x)
  return 0.0 if is_inf(x, 0) || x == 0.0
  sign = false
  if x < 0.0 {
    x = -x
    sign = true
  }
  if x >= 2.0 {
    s, c = sincos(x)
    ss = -s - c
    cc = s - c
    if x < MAX_FLOAT64 / 2.0 {
      z = cos(x + x)
      if s * c > 0.0 {
        cc = z / ss
      } else {
        ss = z / cc
      }
    }
    z = 0.0
    if x > TWO129 {
      z = INV_SQRT_PI * cc / x.sqrt
    } else {
      u = pone(x)
      v = qone(x)
      z = INV_SQRT_PI * (u * cc - v * ss) / x.sqrt
    }
    return -z if sign
    return z
  }
  return 0.5 * x if x < two_m27 # |x| < 2**-27
  z = x * x
  r = z * (r00 + z * (r01 + z * (r02 + z * r03)))
  s = 1.0 + z * (s01 + z * (s02 + z * (s03 + z * (s04 + z * s05))))
  r *= x
  z = 0.5 * x + r / s
  return -z if sign
  z
}

# The order-one Bessel function of the second kind.
pub def y1(x: Float) -> Float {
  two_m54 = 5.551115123125783e-17 # 2**-54
  u00 = -1.96057090646238940668e-01
  u01 = 5.04438716639811282616e-02
  u02 = -1.91256895875763547298e-03
  u03 = 2.35252600561610495928e-05
  u04 = -9.19099158039878874504e-08
  v00 = 1.99167318236649903973e-02
  v01 = 2.02552581025135171496e-04
  v02 = 1.35608801097516229404e-06
  v03 = 6.22741452364621501295e-09
  v04 = 1.66559246207992079114e-11
  return nan if x < 0.0 || is_nan(x)
  return 0.0 if is_inf(x, 1)
  return inf(-1) if x == 0.0
  if x >= 2.0 {
    s, c = sincos(x)
    ss = -s - c
    cc = s - c
    if x < MAX_FLOAT64 / 2.0 {
      z = cos(x + x)
      if s * c > 0.0 {
        cc = z / ss
      } else {
        ss = z / cc
      }
    }
    z = 0.0
    if x > TWO129 {
      z = INV_SQRT_PI * ss / x.sqrt
    } else {
      u = pone(x)
      v = qone(x)
      z = INV_SQRT_PI * (u * ss + v * cc) / x.sqrt
    }
    return z
  }
  return -TWO_OVER_PI / x if x <= two_m54 # x < 2**-54
  z = x * x
  u = u00 + z * (u01 + z * (u02 + z * (u03 + z * u04)))
  v = 1.0 + z * (v00 + z * (v01 + z * (v02 + z * (v03 + z * v04))))
  x * (u / v) + TWO_OVER_PI * (j1(x) * log(x) - 1.0 / x)
}

# The asymptotic expansion's P1 for x >= 2.
def pone(x: Float) -> Float {
  p = P1_R2
  q = P1_S2
  if x >= 8.0 {
    p = P1_R8
    q = P1_S8
  } else if x >= 4.5454 {
    p = P1_R5
    q = P1_S5
  } else if x >= 2.8571 {
    p = P1_R3
    q = P1_S3
  }
  z = 1.0 / (x * x)
  r = p[0] + z * (p[1] + z * (p[2] + z * (p[3] + z * (p[4] + z * p[5]))))
  s = 1.0 + z * (q[0] + z * (q[1] + z * (q[2] + z * (q[3] + z * q[4]))))
  1.0 + r / s
}

# The asymptotic expansion's Q1 for x >= 2.
def qone(x: Float) -> Float {
  p = Q1_R2
  q = Q1_S2
  if x >= 8.0 {
    p = Q1_R8
    q = Q1_S8
  } else if x >= 4.5454 {
    p = Q1_R5
    q = Q1_S5
  } else if x >= 2.8571 {
    p = Q1_R3
    q = Q1_S3
  }
  z = 1.0 / (x * x)
  r = p[0] + z * (p[1] + z * (p[2] + z * (p[3] + z * (p[4] + z * p[5]))))
  s = 1.0 + z * (q[0] + z * (q[1] + z * (q[2] + z * (q[3] + z * (q[4] + z * q[5])))))
  (0.375 + r / s) / x
}

# ---- order n ----

# The order-n Bessel function of the first kind.
pub def jn(n: Int, x: Float) -> Float {
  two_m29 = 1.862645149230957e-09 # 2**-29
  return x if is_nan(x)
  return 0.0 if is_inf(x, 0)
  return j0(x) if n == 0
  return 0.0 if x == 0.0
  if n < 0 {
    n = -n
    x = -x
  }
  return j1(x) if n == 1
  sign = false
  if x < 0.0 {
    x = -x
    sign = true if n & 1 == 1 # odd n and negative x
  }
  b = 0.0
  if n.to_f <= x {
    if x >= TWO302 { # x > 2**302
      s, c = sincos(x)
      temp = case n & 3 {
        0 => c + s
        1 => -c + s
        2 => -c - s
        _ => c - s
      }
      b = INV_SQRT_PI * temp / x.sqrt
    } else {
      b = j1(x)
      a = j0(x)
      i = 1
      while i < n {
        nb = b * ((i + i).to_f / x) - a # avoid underflow
        a = b
        b = nb
        i += 1
      }
    }
  } else {
    if x < two_m29 { # x < 2**-29
      if n > 33 { # underflow
        b = 0.0
      } else {
        temp = x * 0.5
        b = temp
        a = 1.0
        i = 2
        while i <= n {
          a *= i.to_f # a = n!
          b *= temp   # b = (x/2)**n
          i += 1
        }
        b /= a
      }
    } else {
      w = (n + n).to_f / x
      h = 2.0 / x
      q0 = w
      z = w + h
      q1 = w * z - 1.0
      k = 1
      while q1 < 1e9 {
        k += 1
        z += h
        nq = z * q1 - q0
        q0 = q1
        q1 = nq
      }
      m = n + n
      t = 0.0
      i = 2 * (n + k)
      while i >= m {
        t = 1.0 / (i.to_f / x - t)
        i -= 2
      }
      a = t
      b = 1.0
      tmp = n.to_f
      v = 2.0 / x
      tmp = tmp * log((v * tmp).abs)
      if tmp < 7.09782712893383973096e+02 {
        i = n - 1
        while i > 0 {
          di = (i + i).to_f
          nb = b * di / x - a
          a = b
          b = nb
          i -= 1
        }
      } else {
        i = n - 1
        while i > 0 {
          di = (i + i).to_f
          nb = b * di / x - a
          a = b
          b = nb
          if b > 1e100 {
            a /= b
            t /= b
            b = 1.0
          }
          i -= 1
        }
      }
      b = t * j0(x) / b
    }
  }
  return -b if sign
  b
}

# The order-n Bessel function of the second kind.
pub def yn(n: Int, x: Float) -> Float {
  return nan if x < 0.0 || is_nan(x)
  return 0.0 if is_inf(x, 1)
  return y0(x) if n == 0
  if x == 0.0 {
    return inf(1) if n < 0 && n & 1 == 1
    return inf(-1)
  }
  sign = false
  if n < 0 {
    n = -n
    sign = true if n & 1 == 1 # sign true if n < 0 && |n| odd
  }
  if n == 1 {
    return -y1(x) if sign
    return y1(x)
  }
  b = 0.0
  if x >= TWO302 { # x > 2**302
    s, c = sincos(x)
    temp = case n & 3 {
      0 => s - c
      1 => -s - c
      2 => -s + c
      _ => s + c
    }
    b = INV_SQRT_PI * temp / x.sqrt
  } else {
    a = y0(x)
    b = y1(x)
    i = 1
    while i < n && !is_inf(b, -1) {
      nb = (i + i).to_f / x * b - a
      a = b
      b = nb
      i += 1
    }
  }
  return -b if sign
  b
}

