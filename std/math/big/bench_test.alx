# Benchmarks (alx test -bench .): the operations crypto leans on.

def bench_operand(bits: I64, seed: I64) -> Int {
  r = new_go_rand(seed)
  lim = Int.new
  lim.lsh!(new_int(1), bits)
  z = Int.new
  z.rand!(r, lim)
  z.set_bit!(z, bits - 1, 1)
}

bench "Exp 2048-bit modular" {
  x = bench_operand(2048, 1)
  y = bench_operand(2048, 2)
  m = bench_operand(2048, 3)
  m.set_bit!(m, 0, 1)
  z = Int.new
  z.exp!(x, y, m)
}

bench "Mul 2048x2048" {
  x = bench_operand(2048, 1)
  y = bench_operand(2048, 2)
  z = Int.new
  for _i in 0...1000 {
    z.mul!(x, y)
  }
}

bench "Mul 1e5 bits" {
  x = bench_operand(100000, 1)
  y = bench_operand(100000, 2)
  z = Int.new
  z.mul!(x, y)
}

bench "String 1e4 digits" {
  x = bench_operand(33220, 4)
  _s = x.to_s
}

bench "String 2048 bits" {
  x = bench_operand(2048, 4)
  for _i in 0...100 {
    _s = x.to_s
  }
}
