# Go's bits_test.go, translated: Bits, a Float written as a list of the
# exponents of its one bits (sum of 2**b), the reference the arithmetic
# tests compare against.

def bits_add(x: [I64], y: [I64]) -> [I64] { x + y }

def bits_mul(x: [I64], y: [I64]) -> [I64] {
  p: [I64] = []
  for a in x {
    for b in y {
      p << a + b
    }
  }
  p
}

test "MulBits" {
  for t in t_test_mul_bits_0 {
    assert_eq bits_mul(t.x, t.y), t.want
  }
}

# x with no bit appearing twice (2**b + 2**b == 2**(b+1)), sorted.
def bits_norm(x: [I64]) -> [I64] {
  m: Map[I64, Bool] = {}
  for b0 in x {
    b = b0
    while m[b] || false {
      m[b] = false
      b += 1
    }
    m[b] = true
  }
  z: [I64] = []
  for b in m.keys {
    z << b if m[b] || false
  }
  z.sort
}

test "NormBits" {
  for t in t_test_norm_bits_0 {
    assert_eq bits_norm(t.x), t.want
  }
}

# x rounded to prec bits in mode (ToNearestAway isn't implemented, as in
# Go's test).
def bits_round(x0: [I64], prec: I64, mode: RoundingMode) -> Float {
  x = bits_norm(x0)
  mn = 0
  mx = 0
  for i in 0...x.size {
    b = x[i]
    mn = b if i == 0 || b < mn
    mx = b if i == 0 || b > mx
  }
  prec0 = mx + 1 - mn
  return bits_float(x) if prec >= prec0
  bit0 = 0
  rbit = 0
  sbit = 0
  z: [I64] = []
  r = mx - prec
  for b in x {
    if b == r {
      rbit = 1
    } elsif b < r {
      sbit = 1
    } else {
      bit0 = 1 if b == r + 1
      z << b
    }
  }
  f = bits_float(z)
  panic("not yet implemented") if mode == RoundingMode.ToNearestAway
  if (mode == RoundingMode.ToNearestEven && rbit == 1 && (sbit == 1 || (sbit == 0 && bit0 != 0))) || mode == RoundingMode.AwayFromZero {
    f.set_mode!(RoundingMode.ToZero)
    f.set_prec!(prec)
    f.add!(f, bits_float([r + 1]))
  }
  f
}

# The Float with exactly the bits in `bits` (Go's Bits.Float).
def bits_float(bits: [I64]) -> Float {
  return Float.new if bits.size == 0
  mn = 0
  for i in 0...bits.size {
    mn = bits[i] if i == 0 || bits[i] < mn
  }
  x = new_int(0)
  for b in bits {
    badj = b - mn
    while x.bit(badj) != 0 {
      x.set_bit!(x, badj, 0)
      badj += 1
    }
    x.set_bit!(x, badj, 1)
  }
  z = Float.new
  z.set_int!(x)
  e = z.exp.to_i64 + mn
  panic("exponent out of range") if e < MIN_EXP || e > MAX_EXP
  z.exp = e.as_i32
  z
}

test "FromBits" {
  for t in t_test_from_bits_0 {
    assert_eq bits_float(t.bits).text("p", 0), t.want
  }
}
