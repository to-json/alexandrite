# Go's decimal_test.go, translated (benchmarks in bench_test.alx).

test "DecimalString" {
  for t in t_test_decimal_string_0 {
    assert_eq t.x.to_s, t.want
  }
}

test "DecimalInit" {
  for t in t_test_decimal_init_0 {
    d = decimal_init(nat_norm(nw([t.x])), t.shift)
    assert_eq d.to_s, t.want
  }
}

test "DecimalRounding" {
  for t in t_test_decimal_rounding_0 {
    x = nat_set_u64(t.x)
    d = decimal_round_down(decimal_init(x, 0), t.n)
    assert_eq d.to_s, t.down
    d = decimal_round(decimal_init(x, 0), t.n)
    assert_eq d.to_s, t.even
    d = decimal_round_up(decimal_init(x, 0), t.n)
    assert_eq d.to_s, t.up
  }
}
