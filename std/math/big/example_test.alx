# Go's example_test.go, floatexample_test.go and example_rat_test.go,
# translated. fmt.Println(x) of a *Float prints through Format's %v
# (shortest 'g'), so those lines use x.format("%v"); x.to_s is Go's
# String ('g' with 10 digits). fmt.Sscan(s, x) is x.scan!(reader, "v").
# ExampleFloat_Copy's pointer comparisons (r == &z) become value checks.

import "math"

example "Rat_SetString" {
  r = Rat.new
  r.set_string!("355/113")
  puts r.float_string(3)
} outputs "3.142"

example "Int_SetString" {
  i = Int.new
  i.set_string!("644", 8)
  puts i
} outputs "420"

example "Float_SetString" {
  f = Float.new
  f.set_string!("3.14159")
  puts f.format("%v")
} outputs "3.14159"

example "Rat_Scan" {
  r = Rat.new
  res = r.scan!(new_byte_reader("1.5000"), "v")
  if e = res.err {
    puts "error scanning value: #{e.message}"
  } else {
    puts r
  }
} outputs "3/2"

example "Int_Scan" {
  i = Int.new
  res = i.scan!(new_byte_reader("18446744073709551617"), "v")
  if e = res.err {
    puts "error scanning value: #{e.message}"
  } else {
    puts i
  }
} outputs "18446744073709551617"

example "Float_Scan" {
  f = Float.new
  res = f.scan!(new_byte_reader("1.19282e99"), "v")
  if e = res.err {
    puts "error scanning value: #{e.message}"
  } else {
    puts f.format("%v")
  }
} outputs "1.19282e+99"

example "fibonacci" {
  a = new_int(0)
  b = new_int(1)
  limit = Int.new
  limit.exp!(new_int(10), new_int(99), Int.new)
  while a.cmp(limit) < 0 {
    a.add!(a, b)
    t = a
    a = b
    b = t
  }
  puts a
  puts a.probably_prime?(20)
} outputs "1344719667586153181419716641724567886890850696275767987106294472017884974410332069524504824747437757\nfalse"

example "sqrt2" {
  prec = 200
  steps = math.log2(prec.to_f).to_i
  two = Float.new
  two.set_prec!(prec)
  two.set_int64!(2)
  half = Float.new
  half.set_prec!(prec)
  half.set_float64!(0.5)
  x = Float.new
  x.set_prec!(prec)
  x.set_int64!(1)
  t = Float.new
  for _i in 0..steps {
    t.quo!(two, x)
    t.add!(x, t)
    x.mul!(half, t)
  }
  puts "sqrt(2) = #{x.format("%.50f")}"
  t.mul!(x, x)
  t.sub!(two, t)
  puts "error = #{t.format("%e")}"
} outputs "sqrt(2) = 1.41421356237309504880168872420969807856967187537695\nerror = 0.000000e+00"

example "Float_Add" {
  x = Float.new
  y = Float.new
  z = Float.new
  x.set_int64!(1000)
  y.set_float64!(2.718281828)
  z.set_prec!(32)
  z.add!(x, y)
  puts "x = #{x.format("%.10g")} (#{x.text("p", 0)}, prec = #{x.prec}, acc = #{x.acc})"
  puts "y = #{y.format("%.10g")} (#{y.text("p", 0)}, prec = #{y.prec}, acc = #{y.acc})"
  puts "z = #{z.format("%.10g")} (#{z.text("p", 0)}, prec = #{z.prec}, acc = #{z.acc})"
} outputs "x = 1000 (0x.fap+10, prec = 64, acc = Exact)\ny = 2.718281828 (0x.adf85458248cd8p+2, prec = 53, acc = Exact)\nz = 1002.718282 (0x.faadf854p+10, prec = 32, acc = Below)"

example "Float_shift" {
  for s in -5..5 {
    x = new_float(0.5)
    m, e = x.mant_exp
    x.set_mant_exp!(x, e + s)
    _m = m
    puts x.format("%v")
  }
} outputs "0.015625\n0.03125\n0.0625\n0.125\n0.25\n0.5\n1\n2\n4\n8\n16"

example "Float_Cmp" {
  inf = math.inf(1)
  operands = [-1.0 * inf, -1.2, neg_zero, 0.0, 1.2, inf]
  puts "   x     y  cmp"
  puts "---------------"
  for x64 in operands {
    x = new_float(x64)
    for y64 in operands {
      y = new_float(y64)
      puts "#{x.format("%4g")}  #{y.format("%4g")}  #{format("%3d", x.cmp(y))}"
    }
    puts ""
  }
} outputs "   x     y  cmp\n---------------\n-Inf  -Inf    0\n-Inf  -1.2   -1\n-Inf    -0   -1\n-Inf     0   -1\n-Inf   1.2   -1\n-Inf  +Inf   -1\n\n-1.2  -Inf    1\n-1.2  -1.2    0\n-1.2    -0   -1\n-1.2     0   -1\n-1.2   1.2   -1\n-1.2  +Inf   -1\n\n  -0  -Inf    1\n  -0  -1.2    1\n  -0    -0    0\n  -0     0    0\n  -0   1.2   -1\n  -0  +Inf   -1\n\n   0  -Inf    1\n   0  -1.2    1\n   0    -0    0\n   0     0    0\n   0   1.2   -1\n   0  +Inf   -1\n\n 1.2  -Inf    1\n 1.2  -1.2    1\n 1.2    -0    1\n 1.2     0    1\n 1.2   1.2    0\n 1.2  +Inf   -1\n\n+Inf  -Inf    1\n+Inf  -1.2    1\n+Inf    -0    1\n+Inf     0    1\n+Inf   1.2    1\n+Inf  +Inf    0\n"

example "RoundingMode" {
  operands = [2.6, 2.5, 2.1, -2.1, -2.5, -2.6]
  modes: [RoundingMode] = []
  for i in 0...6 {
    modes << RoundingMode.from_i(i)
  }
  line = "   x"
  for mode in modes {
    line = line + "  #{mode}"
  }
  puts line
  for f64 in operands {
    line = new_float(f64).format("%4g")
    for mode in modes {
      f = Float.new
      f.set_prec!(2)
      f.set_mode!(mode)
      f.set_float64!(f64)
      line = line + "  " + f.format("%#{mode.to_s.size}g")
    }
    puts line
  }
} outputs "   x  ToNearestEven  ToNearestAway  ToZero  AwayFromZero  ToNegativeInf  ToPositiveInf\n 2.6              3              3       2             3              2              3\n 2.5              2              3       2             3              2              3\n 2.1              2              2       2             3              2              3\n-2.1             -2             -2      -2            -3             -3             -2\n-2.5             -2             -3      -2            -3             -3             -2\n-2.6             -3             -3      -2            -3             -3             -2"

example "Float_Copy" {
  x = Float.new
  z = Float.new
  x.set_float64!(1.23)
  r = z.copy!(x)
  puts "a) r = #{r.format("%g")}, z = #{z.format("%g")}, x = #{x.format("%g")}, r == z = #{r == z}"
  z.set_int64!(42)
  r = z
  puts "b) r = #{r.format("%g")}, z = #{z.format("%g")}, r == z = #{r == z}"
  x.set_prec!(1)
  z.copy!(x)
  puts "c) z = #{z.format("%g")}, x = #{x.format("%g")}, z == x = false"
} outputs "a) r = 1.23, z = 1.23, x = 1.23, r == z = true\nb) r = 42, z = 42, r == z = true\nc) z = 1, x = 1, z == x = false"

def recur(n: I64, lim: I64) -> Rat {
  term = Rat.new
  if n % 3 != 1 {
    term.set_int64!(1)
  } else {
    term.set_int64!((n - 1) / 3 * 2)
  }
  return term if n > lim
  frac = Rat.new
  frac.inv!(recur(n + 1, lim))
  term.add!(term, frac)
}

example "eConvergents" {
  for i in 1..15 {
    r = recur(0, i)
    puts format("%-13s = %s", r.to_s, r.float_string(8))
  }
} outputs "2/1           = 2.00000000\n3/1           = 3.00000000\n8/3           = 2.66666667\n11/4          = 2.75000000\n19/7          = 2.71428571\n87/32         = 2.71875000\n106/39        = 2.71794872\n193/71        = 2.71830986\n1264/465      = 2.71827957\n1457/536      = 2.71828358\n2721/1001     = 2.71828172\n23225/8544    = 2.71828184\n25946/9545    = 2.71828182\n49171/18089   = 2.71828183\n517656/190435 = 2.71828183"
