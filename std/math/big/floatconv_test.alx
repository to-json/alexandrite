# Go's floatconv_test.go, translated. fmt.Sprintf(format, x) is
# x.format(format); fmt.Fscanf(r, format, x) is x.scan!(reader, verb).
# strconv.FormatFloat is alx's strconv.format_float.

import "math"
import "strconv"

test "FloatSetFloat64String" {
  for t in t_test_float_set_float64_string_0 {
    x = Float.new
    x.set_prec!(53)
    ok = x.set_string!(t.s).some?
    if math.is_nan(t.x) {
      assert !ok, "#{t.s}: want parse error"
      next
    }
    assert ok, "#{t.s}: got parse error"
    want = Float.new
    want.set_float64!(t.x)
    assert x.cmp(want) == 0 && x.signbit == want.signbit, "#{t.s}: got #{x}; want #{t.x}"
  }
}

# Go's actualPrec: 53, or the significant bits of a denormal.
def actual_prec(x: F64) -> I64 {
  mant = math.float64bits(x)
  if x != 0.0 && mant & (0x7ff << 52) == 0 {
    return 64 - nlz(mant & ((ONE << 52) - 1))
  }
  53
}

test "Float64Text" {
  for t in t_test_float64_text_0 {
    f = Float.new
    f.set_prec!(actual_prec(t.x))
    f.set_float64!(t.x)
    fm = Str.from_bytes([t.format])
    got = f.text(fm, t.prec)
    assert_eq got, t.want
    next if t.format == 98 && t.x == 0.0
    next if t.format == 112
    assert_eq got, strconv.format_float(t.x, fm, t.prec, 64)
  }
}

test "RoundShortestNormal" {
  for x in t_test_round_shortest_normal_0 {
    f = Float.new
    f.set_prec!(53)
    f.set_float64!(x)
    assert_eq f.text("g", -1), strconv.format_float(x, "g", -1, 64)
  }
}

test "FloatText" {
  for t in t_test_float_text_0 {
    r = parse_float(t.x, 0, t.prec, RoundingMode.ToNearestEven)
    assert r.ok?, "#{t.x}: parse error"
    f = r.unwrap[0]
    f.set_mode!(t.round)
    fm = Str.from_bytes([t.format])
    assert_eq f.text(fm, t.digits), t.want
    if t.prec == 53 && t.format != 112 && f.sign != 0 && t.round == RoundingMode.ToNearestEven {
      f64, acc = f.float64
      assert acc == Accuracy.Exact, "#{t.x}: expected exact conversion to float64"
      assert_eq strconv.format_float(f64, fm, t.digits, 64), t.want
    }
  }
}

# A test value: "f32:...", "f64:..." or "s:..." (a 512-bit Float).
def format_value(v: Str) -> Float {
  value = Float.new
  if v.start_with?("f32:") {
    value.set_prec!(24)
    value.set_float64!(strconv.parse_float(v[4...v.size]).unwrap)
  } elsif v.start_with?("f64:") {
    value.set_prec!(53)
    value.set_float64!(strconv.parse_float(v[4...v.size]).unwrap)
  } else {
    value.set_prec!(512)
    _r = value.parse!(v[2...v.size], 0)
  }
  value
}

test "FloatFormat" {
  for t in t_test_float_format_0 {
    value = format_value(t.value)
    assert_eq value.format(t.format), t.want
  }
}

test "FloatScan" {
  for t in t_test_float_scan_0 {
    x = Float.new
    r = new_byte_reader(t.input)
    res = x.scan!(r, t.format[1...2])
    if t.want_err {
      assert res.err?, "#{t.input}: want an error"
      next
    }
    assert res.ok?, "#{t.input}: error"
    assert_eq x.to_s, t.output
    assert_eq r.len, t.remaining
  }
}
