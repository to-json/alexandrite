# Go's floatmarsh_test.go, translated: gob round trips through
# gob_encode / gob_decode!, JSON through encoding/json (a Float is a JSON
# string, as Go encodes it through MarshalText). Not translated:
# TestFloatCorruptGob's truncated-stream check (it tests encoding/gob's
# framing; the version-byte check is kept) and TestFloatAppendTextNil
# (there is no nil Float).

import "encoding/json"

def float_modes -> [RoundingMode] { [RoundingMode.ToNearestEven, RoundingMode.ToNearestAway, RoundingMode.ToZero, RoundingMode.AwayFromZero, RoundingMode.ToNegativeInf, RoundingMode.ToPositiveInf] }

test "FloatGobEncoding" {
  for t in t_float_vals {
    for sign in ["", "+", "-"] {
      for prec in [0, 1, 2, 10, 53, 64, 100, 1000] {
        for mode in float_modes {
          x = sign + t
          tx = Float.new
          tx.set_prec!(prec)
          tx.set_mode!(mode)
          r = tx.parse!(x, 0)
          assert r.ok?, "parsing of #{x} failed"
          tx.set_prec!(0) if prec == 0
          b = tx.gob_encode
          rx = Float.new
          rx.~gob_decode!(b)
          assert rx.cmp(tx) == 0, "transmission of #{x} failed: got #{rx} want #{tx}"
          assert_eq rx.prec, prec
          assert_eq rx.mode, mode
          assert_eq rx.acc, tx.acc
        }
      }
    }
  }
}

test "FloatCorruptGob" {
  tx = new_float(1.0)
  tx.set_prec!(1000)
  tx.set_mode!(RoundingMode.ToPositiveInf)
  b = tx.gob_encode
  rx = Float.new
  rx.~gob_decode!(b)
  b[0] = 0
  assert rx.gob_decode!(b).err?, "got nil want version error"
}

test "FloatJSONEncoding" {
  for t in t_float_vals {
    for sign in ["", "+", "-"] {
      for prec in [0, 1, 2, 10, 53, 64, 100, 1000] {
        x = sign + t
        tx = Float.new
        tx.set_prec!(prec)
        r = tx.parse!(x, 0)
        assert r.ok?, "parsing of #{x} failed"
        s = json.~marshal(tx)
        # Go's json.Unmarshal into a Float of the same precision: the
        # JSON string through UnmarshalText.
        v = json.~parse(s)
        rx = Float.new
        rx.set_prec!(prec)
        rx.~unmarshal_text!((v.as_str || "").bytes)
        assert rx.cmp(tx) == 0, "JSON encoding of #{tx} (prec = #{prec}) failed: got #{rx}"
        if prec == 0 {
          d = json.new_decoder(s)
          ry = Float.json_dec(d)
          d.~done!
          assert_eq ry.cmp(tx), 0
        }
      }
    }
  }
}

test "FloatGobDecodeShortBuffer" {
  for tc in [bs([0x1, 0x0, 0x0, 0x0]), bs([0x1, 0xfa, 0x0, 0x0, 0x0, 0x0])] {
    z = new_float(0.0)
    assert z.gob_decode!(tc).err?, "expected GobDecode to return error for malformed input"
  }
}

test "FloatGobDecodeInvalid" {
  for tc in t_test_float_gob_decode_invalid_0 {
    z = new_float(0.0)
    r = z.gob_decode!(tc.buf)
    assert r.err?, "expected an error"
    if e = r.err {
      assert e.message.start_with?(tc.msg), "got #{e.message}"
    }
  }
}

test "FloatAppendText" {
  for t in t_float_vals {
    for sign in ["", "+", "-"] {
      for prec in [0, 1, 2, 10, 53, 64, 100, 1000] {
        x = sign + t
        tx = Float.new
        tx.set_prec!(prec)
        r = tx.parse!(x, 0)
        assert r.ok?, "parsing of #{x} failed"
        buf: [Byte] = [0; 4]
        b = tx.append_text(buf)
        rx = Float.new
        rx.set_prec!(prec)
        rx.~unmarshal_text!(b[4...b.size])
        assert rx.cmp(tx) == 0, "AppendText of #{tx} (prec = #{prec}) failed: got #{rx}"
      }
    }
  }
}
