# Helpers for the translated tests (Go's test helpers and table literals).

# The Int written in s (base 0 rules). Panics if s isn't one.
def iv(s: Str) -> Int {
  z = Int.new
  if v = z.set_string!(s, 0) {
    return v
  }
  panic("iv: bad integer #{s}")
}

# The Int written in s in the given base, or none.
def ivb(s: Str, base: I64) -> Int? {
  z = Int.new
  z.set_string!(s, base)
}

# The Rat written in s. Panics if s isn't one.
def rv(s: Str) -> Rat {
  z = Rat.new
  if v = z.set_string!(s) {
    return v
  }
  panic("rv: bad rational #{s}")
}

# A Float from its fields (as Go's tables hold them).
def fbits(prec: I64, mode: I64, acc: I64, form: I64, neg: Bool, mant: [U64], exp: I64) -> Float {
  Float.new(prec_: prec.as_u32, mode_: RoundingMode.from_i(mode), acc_: Accuracy.from_i(acc), form: form, neg: neg, mant: mant, exp: exp.as_i32)
}

def nw(x: [U64]) -> [U64] { x }

def bs(x: [Byte]) -> [Byte] { x }

# Go's isNormalized.
def normalized?(x: Int) -> Bool {
  return !x.neg if x.abs.size == 0
  x.abs[x.abs.size - 1] != 0
}

# Go's new(Float).SetPrec(prec).SetMode(mode).
def new_float_pm(prec: I64, mode: RoundingMode) -> Float {
  z = Float.new
  z.set_prec!(prec)
  z.set_mode!(mode)
}

# A Float of precision prec (0: whatever s needs, as Go's tests do with
# SetString on a zero Float) parsed from s; panics on a syntax error.
def fs(s: Str, prec: I64) -> Float {
  z = Float.new
  z.set_prec!(prec) if prec > 0
  if v = z.set_string!(s) {
    return v
  }
  panic("fs: bad float #{s}")
}

# Go's %v of a Float (Text('g', 10)).
def fstr(x: Float) -> Str { x.to_s }

# The decimal Int value of a Word slice (for messages).
def natstr(x: [U64]) -> Str { Str.from_bytes(nat_utoa(nat_norm(x), 10)) }

# A copy of a Word slice.
def nat_copy(x: [U64]) -> [U64] { nat_set(x) }

# Go's new(Int).Set(x) etc. as expressions.
def iadd(x: Int, y: Int) -> Int { i_add(x, y) }

def isub(x: Int, y: Int) -> Int { i_sub(x, y) }

def imul(x: Int, y: Int) -> Int { i_mul(x, y) }
