test "CmpAbs" {
  values: [Int] = []
  for s in t_cmp_abs_tests {
    x = iv(s)
    if values.size > 0 {
      assert values[values.size - 1].cmp(x) < 0, "not sorted"
    }
    values << x
  }
  for i in 0...values.size {
    for j in 0...values.size {
      for k in 0...4 {
        a = values[i]
        b = values[j]
        a = i_neg(a) if k & 1 != 0
        b = i_neg(b) if k & 2 != 0
        want = 0
        want = 1 if i > j
        want = -1 if i < j
        assert_eq a.cmp_abs(b), want
      }
    }
  }
}

