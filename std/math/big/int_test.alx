test "ModInverse" {
  one = new_int(1)
  for t in t_mod_inverse_tests {
    element = iv(t.element)
    modulus = iv(t.modulus)
    inv = Int.new
    inv.mod_inverse!(element, modulus)
    inv.mul!(inv, element)
    inv.mod!(inv, modulus)
    assert int_eq?(inv, one), "ModInverse(#{element}, #{modulus})"
  }
  for n in 2...100 {
    modulus = new_int(n)
    for x in 1...n {
      element = new_int(x)
      g = Int.new
      g.gcd!(element, modulus)
      next if g.cmp(one) != 0
      inv = Int.new
      inv.mod_inverse!(element, modulus)
      inv.mul!(inv, element)
      inv.mod!(inv, modulus)
      assert int_eq?(inv, one), "ModInverse(#{x}, #{n})"
    }
  }
}

# Go's testModSqrt: (sq, sqrt, ok).
def check_mod_sqrt(elt: Int, mod: Int) -> (Int, Int, Bool) {
  sq = i_mod(i_mul(elt, elt), mod)
  z = Int.new
  zr = z.mod_sqrt!(sq, mod)
  return (sq, Int.new, false) if zr.none?
  sqrt = zr || Int.new
  chk = Int.new
  c1 = chk.mod_sqrt!(i_add(sq, mod), mod) || Int.new
  return (sq, sqrt, false) if !int_eq?(c1, sqrt)
  c2 = chk.mod_sqrt!(i_sub(sq, mod), mod) || Int.new
  return (sq, sqrt, false) if !int_eq?(c2, sqrt)
  c3 = chk.mod_sqrt!(sq, mod) || Int.new
  return (sq, sqrt, false) if !int_eq?(c3, sqrt)
  return (sq, sqrt, true) if int_eq?(sqrt, elt)
  sqrtsq = i_mod(i_mul(sqrt, sqrt), mod)
  (sq, sqrt, int_eq?(sq, sqrtsq))
}

test "ModSqrt" {
  r = new_go_rand(9)
  ps = t_primes
  for i in 1...ps.size {
    mod = iv(ps[i])
    modx4 = i_lsh(mod, 2)
    for _x in 1...5 {
      elt = Int.new
      elt.rand!(r, modx4)
      elt.sub!(elt, mod)
      _sq, sqrt, ok = check_mod_sqrt(elt, mod)
      assert ok, "#{i}: failed (sqrt(e) = #{sqrt})"
    }
  }
  for n in 3...100 {
    mod = new_int(n)
    next if !mod.probably_prime?(10)
    is_square: [Bool] = [false; n]
    for x in 1...n {
      elt = new_int(x)
      sq, sqrt, ok = check_mod_sqrt(elt, mod)
      assert ok, "#{x}: failed (sqrt(#{x},#{n}) = #{sqrt})"
      is_square[sq.uint64.to_i64] = true
    }
    for x in 1...n {
      sqrt = Int.new
      z = sqrt.mod_sqrt!(new_int(x), mod)
      assert is_square[x] || z.none?, "#{x}: failed (sqrt(#{x},#{n}) = nil)"
    }
  }
}

