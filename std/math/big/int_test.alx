#![overflow(wrap)]
# Go's int_test.go, translated. Go's `new(Int).Op(...)` chains are a
# local `z = Int.new` and `z.op!(...)` here; Go's testing/quick properties
# run on 100 pseudo-random byte strings (`quick_bytes`). Results that Go
# returns through extra *Int arguments (QuoRem, DivMod, Divide, GCD) are
# the returned tuples. Not translated: TestNewIntAllocs (counts heap
# allocations); TestJacobiPanic and the FillBytes "buffer too small"
# panic checks (alx can't recover a panic inside a test); the aliasing
# variants of testGcd (Ints are values here, so aliasing can't happen).

# Go's testing/quick: n random byte strings of length 0..49.
def quick_bytes(n: I64, seed: U64) -> [[Byte]] {
  r = new_word_rand(seed)
  out: [[Byte]] = []
  for _i in 0...n {
    len = (r.next! % 50).to_i64
    b: [Byte] = [0; len]
    for j in 0...len {
      b[j] = r.next!.as_u8
    }
    out << b
  }
  out
}

def int_eq?(x: Int, y: Int) -> Bool { x.cmp(y) == 0 }

test "SignZ" {
  zero = Int.new
  for a in t_sum_zz {
    assert_eq a.z.sign, a.z.cmp(zero)
  }
}

test "SetZ" {
  for a in t_sum_zz {
    z = Int.new
    z.set!(a.z)
    assert normalized?(z), "normalized"
    assert int_eq?(z, a.z), "set #{a.z}"
  }
}

test "AbsZ" {
  zero = Int.new
  for a in t_sum_zz {
    z = Int.new
    z.abs!(a.z)
    e = Int.new
    e.set!(a.z)
    e.sub!(zero, e) if e.cmp(zero) < 0
    assert int_eq?(z, e), "abs #{a.z}"
  }
}

test "SumZZ" {
  for a in t_sum_zz {
    z = Int.new
    z.add!(a.x, a.y)
    assert normalized?(z) && int_eq?(z, a.z), "AddZZ #{a.x} + #{a.y}"
    z.add!(a.y, a.x)
    assert normalized?(z) && int_eq?(z, a.z), "AddZZ symmetric"
    z.sub!(a.z, a.y)
    assert normalized?(z) && int_eq?(z, a.x), "SubZZ"
    z.sub!(a.z, a.x)
    assert normalized?(z) && int_eq?(z, a.y), "SubZZ symmetric"
  }
}

test "ProdZZ" {
  for a in t_prod_zz {
    z = Int.new
    z.mul!(a.x, a.y)
    assert normalized?(z) && int_eq?(z, a.z), "MulZZ #{a.x} * #{a.y}"
    z.mul!(a.y, a.x)
    assert normalized?(z) && int_eq?(z, a.z), "MulZZ symmetric"
  }
}

# Go's mulBytes: grade-school multiplication of big-endian byte strings.
def mul_bytes(x: [Byte], y: [Byte]) -> [Byte] {
  z: [Byte] = [0; x.size + y.size]
  k0 = z.size - 1
  j = y.size - 1
  while j >= 0 {
    d = y[j].to_i64
    if d != 0 {
      k = k0
      carry = 0
      i = x.size - 1
      while i >= 0 {
        t = z[k].to_i64 + x[i].to_i64 * d + carry
        z[k] = t.as_u8
        carry = t >> 8
        k -= 1
        i -= 1
      }
      z[k] = carry.as_u8
    }
    k0 -= 1
    j -= 1
  }
  i = 0
  while i < z.size && z[i] == 0 {
    i += 1
  }
  z[i...z.size]
}

test "Mul" {
  bs_ = quick_bytes(200, 21)
  for k in 0...100 {
    a = bs_[2 * k]
    b = bs_[2 * k + 1]
    x = Int.new
    x.set_bytes!(a)
    y = Int.new
    y.set_bytes!(b)
    z1 = Int.new
    z1.mul!(x, y)
    z2 = Int.new
    z2.set_bytes!(mul_bytes(a, b))
    assert int_eq?(z1, z2), "checkMul"
  }
}

