test "Issue2607" {
  n = new_int(10)
  n.rand!(new_go_rand(9), n)
  assert n.cmp(new_int(10)) < 0 && n.sign >= 0, "rand in [0, 10)"
}

test "Sqrt" {
  root = 0
  r = Int.new
  for i in 0...10000 {
    root += 1 if (root + 1) * (root + 1) <= i
    n = new_int(i)
    r.set_int64!(-2)
    r.sqrt!(n)
    assert int_eq?(r, new_int(root)), "Sqrt(#{i})"
  }
  i = 0
  while i < 1000 {
    n = iv("1" + "0" * i)
    r2 = Int.new
    r2.sqrt!(n)
    assert int_eq?(r2, iv("1" + "0" * (i / 2))), "Sqrt(1e#{i})"
    i += 10
  }
  r.set_int64!(100)
  r.sqrt!(r)
  assert_eq r.int64, 10
}

test "Issue22830" {
  one = new_int(1)
  base = iv("84555555300000000000")
  mod = iv("66666670001111111111")
  want = iv("17888885298888888889")
  for n in [0, 1, -1] {
    m = new_int(n)
    got = m.exp!(base, one, mod) || Int.new
    assert int_eq?(got, want), "(#{n}).Exp"
  }
}

test "FillBytes" {
  for n in ["0", "1000", "0xffffffff", "-0xffffffff", "0xffffffffffffffff", "0x10000000000000000", "0xabababababababababababababababababababababababababa", "0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"] {
    x = iv(n)
    byte_len = (x.bit_len + 7) / 8
    buf: [Byte] = [0; byte_len]
    got = Int.new
    got.set_bytes!(x.fill_bytes(buf))
    assert_eq got.cmp_abs(x), 0
    buf2: [Byte] = [0xff; 100]
    got.set_bytes!(x.fill_bytes(buf2))
    assert_eq got.cmp_abs(x), 0
  }
}

test "NewIntMinInt64" {
  want = -9223372036854775808
  assert_eq new_int(want).int64, want
}

test "Float64" {
  for t in t_test_float64_0 {
    i = iv(t.istr)
    f, acc = i.float64
    assert f == t.f && acc == t.acc, "#{t.istr}: got #{f} (#{acc}); want #{t.f} (#{t.acc})"
    fz = Float.new
    f2, acc2 = fz.set_int!(i).float64
    assert f == f2 && acc == acc2, "#{t.istr}: Float.Float64 gives #{f2} (#{acc2})"
  }
}
