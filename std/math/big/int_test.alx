test "Bitwise" {
  for t in t_bitwise_tests {
    x = iv(t.x)
    y = iv(t.y)
    z = Int.new
    assert int_eq?(z.and!(x, y), iv(t.and)), "and"
    s = x
    assert int_eq?(s.and!(s, y), iv(t.and)), "and self"
    assert int_eq?(z.and_not!(x, y), iv(t.and_not)), "andNot"
    s = x
    assert int_eq?(s.and_not!(s, y), iv(t.and_not)), "andNot self"
    assert int_eq?(z.or!(x, y), iv(t.or)), "or"
    s = x
    assert int_eq?(s.or!(s, y), iv(t.or)), "or self"
    assert int_eq?(z.xor!(x, y), iv(t.xor)), "xor"
    s = x
    assert int_eq?(s.xor!(s, y), iv(t.xor)), "xor self"
  }
}

