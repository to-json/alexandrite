test "DivisionSigns" {
  for t in t_division_signs_tests {
    x = new_int(t.x)
    y = new_int(t.y)
    q = new_int(t.q)
    r = new_int(t.r)
    d = new_int(t.d)
    m = new_int(t.m)
    q1 = Int.new
    q1.quo!(x, y)
    r1 = Int.new
    r1.rem!(x, y)
    assert normalized?(q1) && normalized?(r1), "Quo/Rem normalized"
    assert int_eq?(q1, q) && int_eq?(r1, r), "QuoRem #{t.x} #{t.y}"
    q2z = Int.new
    q2, r2 = q2z.quo_rem!(x, y)
    assert normalized?(q2) && normalized?(r2), "QuoRem normalized"
    assert int_eq?(q2, q) && int_eq?(r2, r), "QuoRem"
    d1 = Int.new
    d1.div!(x, y)
    m1 = Int.new
    m1.mod!(x, y)
    assert normalized?(d1) && normalized?(m1), "Div/Mod normalized"
    assert int_eq?(d1, d) && int_eq?(m1, m), "DivMod"
    d2z = Int.new
    d2, m2 = d2z.div_mod!(x, y)
    assert normalized?(d2) && normalized?(m2), "DivMod normalized"
    assert int_eq?(d2, d) && int_eq?(m2, m), "DivMod"
  }
}

test "Bits" {
  for t in [nw([]), nw([0]), nw([1]), nw([0, 1, 2, 3, 4]), nw([4, 3, 2, 1, 0]), nw([4, 3, 2, 1, 0, 0, 0, 0])] {
    z = Int.new
    z.neg = true
    got = z.set_bits!(t)
    want = nat_norm(t)
    assert_eq nat_cmp(got.abs, want), 0
    assert !got.neg, "SetBits: negative"
    assert_eq nat_cmp(z.bits, want), 0
  }
}

def to_hex(b: [Byte]) -> Str {
  s = ""
  for c in b {
    s = s + DIGITS[(c >> 4).to_i64...(c >> 4).to_i64 + 1] + DIGITS[(c & 15).to_i64...(c & 15).to_i64 + 1]
  }
  s
}

test "SetBytes" {
  for b in quick_bytes(100, 22) {
    z = Int.new
    z.set_bytes!(b)
    hex1 = to_hex(z.bytes)
    hex2 = to_hex(b)
    while hex1.size < hex2.size {
      hex1 = "0" + hex1
    }
    while hex1.size > hex2.size {
      hex2 = "0" + hex2
    }
    assert_eq hex1, hex2
  }
}

test "Bytes" {
  for b0 in quick_bytes(100, 23) {
    i = 0
    while i < b0.size && b0[i] == 0 {
      i += 1
    }
    b = b0[i...b0.size]
    z = Int.new
    z.set_bytes!(b)
    assert z.bytes == b, "checkBytes"
  }
}

test "Quo" {
  bs_ = quick_bytes(200, 24)
  for k in 0...100 {
    u = Int.new
    u.set_bytes!(bs_[2 * k])
    v = Int.new
    v.set_bytes!(bs_[2 * k + 1])
    next if v.abs.size == 0
    qz = Int.new
    q, r = qz.quo_rem!(u, v)
    assert r.cmp(v) < 0, "checkQuo: r >= v"
    up = Int.new
    up.set!(q)
    up.mul!(up, v)
    up.add!(up, r)
    assert int_eq?(up, u), "checkQuo"
  }
  for t in t_quo_tests {
    x = iv(t.x)
    y = iv(t.y)
    eq = iv(t.q)
    er = iv(t.r)
    qz = Int.new
    q, r = qz.quo_rem!(x, y)
    assert int_eq?(q, eq) && int_eq?(r, er), "QuoRem #{t.x} / #{t.y}"
  }
}

test "QuoStepD6" {
  u = Int.new(abs: nw([0, 0, 1 + (ONE << 63), M_ ^ (ONE << 63)]))
  v = Int.new(abs: nw([5, 2 + (ONE << 63), ONE << 63]))
  qz = Int.new
  q, r = qz.quo_rem!(u, v)
  assert_eq q.to_s, "18446744073709551613"
  assert_eq r.to_s, "3138550867693340382088035895064302439801311770021610913807"
}

test "IntDivide" {
  for s in ["1", "1234", "99991", "1234567890", "12345678901234567890"] {
    f = iv(s)
    n = 10
    for i in -n..n {
      for j in -n..n {
        next if j == 0
        z = i.to_f / j.to_f
        checks = [(i / j, trunc), (math_trunc(z), trunc), (math_floor(z), floor), (math_ceil(z), ceil), (math_round_even(z), round)]
        for c in checks {
          q_ = c[0]
          mode = c[1]
          x = i_mul(new_int(i), f)
          y = i_mul(new_int(j), f)
          q = new_int(q_)
          r = i_mul(new_int(i - j * q_), f)
          qz = Int.new
          qg, rg = qz.divide!(x, y, mode)
          assert int_eq?(qg, q) && int_eq?(rg, r), "#{mode}(#{x}/#{y}): got q = #{qg}, r = #{rg}; want q = #{q}, r = #{r}"
        }
      }
    }
  }
}

def math_trunc(z: F64) -> I64 { z.to_i }

def math_floor(z: F64) -> I64 {
  t = z.to_i
  return t - 1 if t.to_f > z
  t
}

def math_ceil(z: F64) -> I64 {
  t = z.to_i
  return t + 1 if t.to_f < z
  t
}

def math_round_even(z: F64) -> I64 {
  fl = math_floor(z)
  d = z - fl.to_f
  return fl if d < 0.5
  return fl + 1 if d > 0.5
  return fl if fl % 2 == 0
  fl + 1
}

