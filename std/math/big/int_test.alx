# Go's altBit and altSetBit.
def alt_bit(x: Int, i: I64) -> I64 {
  z = i_rsh(x, i)
  z.and!(z, new_int(1))
  return 1 if z.cmp(Int.new) != 0
  0
}

def alt_set_bit(x: Int, i: I64, b: I64) -> Int {
  m = i_lsh(new_int(1), i)
  z = Int.new
  return z.or!(x, m) if b == 1
  z.and_not!(x, m)
}

def check_bitset(x: Int) -> Bool {
  n = x.bit_len
  z = x
  z1 = x
  for i in 0...n + 10 {
    old = z.bit(i)
    return false if old != alt_bit(z1, i)
    zz = Int.new
    zz.set_bit!(z, i, 1)
    zz1 = alt_set_bit(z1, i, 1)
    return false if zz.bit(i) == 0 || !int_eq?(zz, zz1)
    zz.set_bit!(zz, i, 0)
    zz1 = alt_set_bit(zz1, i, 0)
    return false if zz.bit(i) != 0 || !int_eq?(zz, zz1)
    z1 = alt_set_bit(z1, i, old)
    z.set_bit!(z, i, old)
    return false if !int_eq?(z, z1)
  }
  int_eq?(z, x)
}

test "BitSet" {
  for t in t_bitwise_tests {
    assert check_bitset(iv(t.x)), "bitset #{t.x}"
    assert check_bitset(iv(t.y)), "bitset #{t.y}"
  }
  for t in t_bitset_tests {
    assert_eq iv(t.x).bit(t.i), t.b
  }
  z = new_int(1)
  z.set_bit!(new_int(0), 2, 1)
  assert int_eq?(z, new_int(4)), "destination leaked into result"
}

