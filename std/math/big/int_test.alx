test "Exp" {
  for t in t_exp_tests {
    x = iv(t.x)
    y = iv(t.y)
    m = Int.new
    m = iv(t.m) if t.m.size > 0
    z = Int.new
    z1 = z.exp!(x, y, m)
    if t.out.size == 0 {
      assert z1.none?, "#{t.x} ** #{t.y} mod #{t.m}: want nil"
    } else {
      out = iv(t.out)
      if v = z1 {
        assert normalized?(v), "normalized"
        assert int_eq?(v, out), "#{t.x} ** #{t.y} mod #{t.m}: got #{v.text(16)} want #{out.text(16)}"
      } else {
        assert false, "#{t.x} ** #{t.y} mod #{t.m}: got nil"
      }
    }
  }
}

# Go's euclidExtGCD.
def euclid_ext_gcd(a: Int, b: Int) -> (Int, Int, Int) {
  aa = a
  bb = b
  ua = new_int(1)
  va = Int.new
  ub = Int.new
  vb = new_int(1)
  while bb.abs.size > 0 {
    qz = Int.new
    q, r = qz.quo_rem!(aa, bb)
    aa = bb
    bb = r
    temp = ub
    ub = i_sub(ua, i_mul(ub, q))
    ua = temp
    temp = vb
    vb = i_sub(va, i_mul(vb, q))
    va = temp
  }
  (aa, ua, va)
}

def test_gcd(d: Int, x: Int?, y: Int?, a: Int, b: Int) -> Bool {
  if x.none? && y.none? {
    z = Int.new
    dd = z.gcd!(a, b)
    return int_eq?(dd, d)
  }
  z = Int.new
  dd, xx, yy = z.gcd_xy!(a, b)
  return false if !int_eq?(dd, d)
  if xv = x {
    return false if !int_eq?(xx, xv)
  }
  if yv = y {
    return false if !int_eq?(yy, yv)
  }
  true
}

test "Gcd" {
  for t in t_gcd_tests {
    d = iv(t.d)
    x = iv(t.x)
    y = iv(t.y)
    a = iv(t.a)
    b = iv(t.b)
    assert test_gcd(d, none, none, a, b), "GCD(nil, nil, #{a}, #{b})"
    assert test_gcd(d, x, none, a, b), "GCD(x, nil, #{a}, #{b})"
    assert test_gcd(d, none, y, a, b), "GCD(nil, y, #{a}, #{b})"
    assert test_gcd(d, x, y, a, b), "GCD(x, y, #{a}, #{b})"
  }
  bs_ = quick_bytes(200, 25)
  for k in 0...100 {
    a = Int.new
    a.set_bytes!(bs_[2 * k])
    b = Int.new
    b.set_bytes!(bs_[2 * k + 1])
    z = Int.new
    d, x, y = z.gcd_xy!(a, b)
    assert int_eq?(i_add(i_mul(x, a), i_mul(y, b)), d), "checkGcd"
    if a.sign > 0 && b.sign > 0 {
      d0, x0, y0 = euclid_ext_gcd(a, b)
      dl, _xl, _yl = lehmer_gcd(a, b, false)
      assert int_eq?(dl, d0), "checkLehmerGcd"
      de, xe, ye = lehmer_gcd(a, b, true)
      assert int_eq?(de, d0) && int_eq?(xe, x0) && int_eq?(ye, y0), "checkLehmerExtGcd"
    }
  }
}

