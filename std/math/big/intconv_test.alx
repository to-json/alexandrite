#![overflow(wrap)]
# Go's intconv_test.go, translated. fmt.Sprintf(format, x) is
# x.format(format) (Int's Format verbs); fmt.Fscanf(r, format, x) is
# x.scan!(reader, verb) followed by the bytes left in the reader. Not
# translated: the formatTests rows for a nil *Int (alx has no nil Int).

test "IntText" {
  z = Int.new
  for t in t_string_tests {
    next if !t.ok
    assert z.set_string!(t.in_, t.base).some?, "#{t.in_}: failed to parse"
    base = t.base
    base = 10 if base == 0
    assert_eq z.text(base), t.out
  }
}

test "AppendText" {
  z = Int.new
  buf: [Byte] = []
  for t in t_string_tests {
    next if !t.ok
    assert z.set_string!(t.in_, t.base).some?, "#{t.in_}: failed to parse"
    base = t.base
    base = 10 if base == 0
    i = buf.size
    buf = z.append(buf, base)
    assert_eq Str.from_bytes(buf[i...buf.size]), t.out
  }
}

def verb_for(base: I64) -> Str {
  return "%b" if base == 2
  return "%o" if base == 8
  return "%x" if base == 16
  "%d"
}

test "GetString" {
  z = Int.new
  for t in t_string_tests {
    next if !t.ok
    z.set_int64!(t.val)
    assert_eq z.to_s, t.out if t.base == 10
    f = verb_for(t.base)
    got = z.format(f)
    if f == "%d" {
      assert_eq got, "#{t.val}"
    } else {
      assert_eq got, t.out
    }
  }
}

test "SetString" {
  tmp = Int.new
  for t in t_string_tests {
    tmp.set_int64!(1234567890)
    n1z = Int.new
    n1 = n1z.set_string!(t.in_, t.base)
    n2 = tmp.set_string!(t.in_, t.base)
    expected = new_int(t.val)
    assert n1.some? == t.ok && n2.some? == t.ok, "input '#{t.in_}': ok should be #{t.ok}"
    if v1 = n1 {
      assert normalized?(v1), "'#{t.in_}' normalized"
      assert_eq v1.cmp(expected), 0
    }
    if v2 = n2 {
      assert normalized?(v2), "'#{t.in_}' normalized"
      assert_eq v2.cmp(expected), 0
    }
  }
}

test "Format" {
  for t in t_format_tests {
    next if t.input == "<nil>"
    x = ivb(t.input, 0)
    assert x.some?, "failed reading input #{t.input}"
    if v = x {
      assert_eq v.format(t.format), t.output
    }
  }
}

test "Scan" {
  for t in t_scan_tests {
    x = Int.new
    r = new_byte_reader(t.input)
    res = x.scan!(r, t.format[1...2])
    assert res.ok?, "#{t.input} #{t.format}: error"
    assert_eq x.to_s, t.output
    assert_eq r.len, t.remaining
  }
}
