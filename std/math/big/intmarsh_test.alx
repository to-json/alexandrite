# Go's intmarsh_test.go, translated. encoding/gob doesn't exist in alx:
# the gob tests round-trip gob_encode / gob_decode! directly. JSON goes
# through encoding/json's protocol (Int implements json_enc / json_dec, so
# a big.Int can be a field of a type that derives Json; inside this
# package a derive in another file can't see that `Int` is this package's
# type, so the test uses json.marshal and json_dec directly). Not
# translated: the XML test (no encoding/xml) and the nil-*Int tests
# (TestGobEncodingNilIntInSlice, TestIntJSONEncodingNil,
# TestIntAppendTextNil: there is no nil Int).

import "encoding/json"

test "IntGobEncoding" {
  for t in t_encoding_tests {
    for sign in ["", "+", "-"] {
      tx = iv(sign + t)
      b = tx.gob_encode
      rx = Int.new
      rx.~gob_decode!(b)
      assert_eq rx.cmp(tx), 0
    }
  }
}

test "IntJSONEncoding" {
  for t in t_encoding_tests {
    for sign in ["", "+", "-"] {
      tx = iv(sign + t)
      b = Str.from_bytes(tx.marshal_json)
      rx = Int.new
      rx.~unmarshal_json!(b.bytes)
      assert_eq rx.cmp(tx), 0
      s = json.~marshal(tx)
      assert_eq s, b
      d = json.new_decoder(s)
      back = Int.json_dec(d)
      d.~done!
      assert_eq back.cmp(tx), 0
    }
  }
}

test "IntAppendText" {
  for t in t_encoding_tests {
    for sign in ["", "+", "-"] {
      tx = iv(sign + t)
      buf: [Byte] = [0; 4]
      b = tx.append_text(buf)
      rx = Int.new
      rx.~unmarshal_text!(b[4...b.size])
      assert_eq rx.cmp(tx), 0
    }
  }
}

test "IntUnmarshalErrors" {
  rx = Int.new
  r = rx.unmarshal_text!("12x".bytes)
  assert r.err?, "error expected"
  if e = r.err {
    assert_eq e.message, "math/big: cannot unmarshal \"12x\" into a *big.Int"
  }
  d = json.new_decoder("\"7\"")
  _v = Int.json_dec(d)
  assert d.done!.err?, "a JSON string is not an Int"
}
