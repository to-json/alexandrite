#![overflow(wrap)]
# Go's natconv_test.go, translated. Not translated: TestString's check
# that utoa(1) panics with "invalid base" (alx can't recover a panic in a
# test); the benchmarks (bench_test.alx has the conversion benchmarks).

test "MaxBase" {
  assert_eq MAX_BASE, DIGITS.size
}

def log2w(x: U64) -> I64 { word_len(x) - 1 }

# Go's itoa: digit-by-digit conversion, the reference for utoa.
def ref_itoa(x: [U64], base: I64) -> [Byte] {
  if x.size == 0 {
    z: [Byte] = [48]
    return z
  }
  i = nat_bit_len(x) / log2w(base.as_u64) + 1
  s: [Byte] = [0; i]
  q = nat_set(x)
  while q.size > 0 {
    i -= 1
    qq, r = nat_div_w(q, base.as_u64)
    q = qq
    s[i] = DIGITS[r.to_i64]
  }
  s[i...s.size]
}

def scan_err_text(code: I64) -> Str {
  return "number has no digits" if code == SCAN_NO_DIGITS
  return "'_' must separate successive digits" if code == SCAN_INVAL_SEP
  ""
}

test "String" {
  for a in t_str_tests {
    assert_eq Str.from_bytes(nat_utoa(a.x, a.b)), a.s
    x, b, _c, err = nat_scan_raw(new_byte_reader(a.s), a.b, false)
    assert_eq nat_cmp(x, a.x), 0
    assert_eq b, a.b
    assert_eq err, 0
  }
}

test "ScanBase" {
  for a in t_nat_scan_tests {
    r = new_byte_reader(a.s)
    x, b, count, err = nat_scan_raw(r, a.base, a.frac)
    assert_eq scan_err_text(err), a.err
    assert nat_cmp(x, a.x) == 0, "scan #{a.s}: got #{natstr(x)}"
    assert_eq b, a.b
    assert_eq count, a.count
    next_: I64 = 0
    if ch = r.read_byte! {
      next_ = ch.to_i64
    }
    assert_eq next_, a.next_
  }
}

test "ScanPi" {
  z, _b, _c = nat_scan(new_byte_reader(PI), 10, false).unwrap
  assert_eq Str.from_bytes(nat_utoa(z, 10)), PI
}

test "ScanPiParallel" {
  t1 = spawn {
    z, _b, _c = nat_scan(new_byte_reader(PI), 10, false).unwrap
    Str.from_bytes(nat_utoa(z, 10)) == PI
  }
  t2 = spawn {
    z, _b, _c = nat_scan(new_byte_reader(PI), 10, false).unwrap
    Str.from_bytes(nat_utoa(z, 10)) == PI
  }
  assert t1.wait.unwrap, "first"
  assert t2.wait.unwrap, "second"
}

test "StringPowers" {
  for b in 2..16 {
    for p in 0..512 {
      x = nat_exp_nn(nat_set_word(b.as_u64), nat_set_word(p.as_u64), nat_zero, false)
      assert nat_utoa(x, b) == ref_itoa(x, b), "#{b} ** #{p} in base #{b}"
    }
  }
}
