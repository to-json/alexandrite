# Go's prime_test.go, translated.

def cut_space(s: Str) -> Str {
  out: [Byte] = []
  for c in s.bytes {
    out << c if !(c == 32 || c == 9 || c == 10 || c == 13)
  }
  Str.from_bytes(out)
}

test "ProbablyPrime" {
  nreps = 20
  i = 0
  for s in t_primes {
    p = iv(s)
    assert p.probably_prime?(nreps) && p.probably_prime?(1) && p.probably_prime?(0), "#{i} prime found to be non-prime (#{s})"
    i += 1
  }
  i = 0
  for s0 in t_composites {
    s = cut_space(s0)
    c = iv(s)
    assert !c.probably_prime?(nreps) && !c.probably_prime?(1) && !c.probably_prime?(0), "#{i} composite found to be prime (#{s})"
    i += 1
  }
  c = new_int(11)
  for n in [0, 1] {
    assert c.probably_prime?(n), "11 should be a prime"
  }
  assert_panics("negative n for ProbablyPrime") { c.probably_prime?(-1) }
}

# Go's testPseudoprimes: the odd n < 100000 for which cond holds must be
# exactly `want`.
def pseudoprimes(lucas: Bool) -> [I64] {
  out: [I64] = []
  i = 3
  while i < 100000 {
    n = nw([i.as_u64])
    pseudo = false
    if lucas {
      pseudo = probably_prime_lucas(n) && !probably_prime_miller_rabin(n, 1, true)
    } else {
      pseudo = probably_prime_miller_rabin(n, 1, true) && !probably_prime_lucas(n)
    }
    out << i if pseudo
    i += 2
  }
  out
}

test "MillerRabinPseudoprimes" {
  assert_eq pseudoprimes(false), [2047, 3277, 4033, 4681, 8321, 15841, 29341, 42799, 49141, 52633, 65281, 74665, 80581, 85489, 88357, 90751]
}

test "LucasPseudoprimes" {
  assert_eq pseudoprimes(true), [989, 3239, 5777, 10877, 27971, 29681, 30739, 31631, 39059, 72389, 73919, 75077]
}
