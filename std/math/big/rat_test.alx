# Go's rat_test.go, translated. Not translated: TestZeroRat's check that
# Quo by zero panics (no recover in alx tests); the parts of
# TestIssue3521 and TestIssue34919 about pointer identity and slice
# capacity (Num and Denom return copies here, and nats have no spare
# capacity to clobber), whose value checks are kept.

import "math"

def rat_ok(s: Str) -> Rat? {
  z = Rat.new
  z.set_string!(s)
}

test "ZeroRat" {
  x = Rat.new
  y = Rat.new
  y.set_frac64!(0, 42)
  assert_eq x.cmp(y), 0
  assert_eq x.to_s, "0/1"
  assert_eq x.rat_string, "0"
  z = Rat.new
  z.add!(x, y)
  assert_eq z.rat_string, "0"
  z.sub!(x, y)
  assert_eq z.rat_string, "0"
  z.mul!(x, y)
  assert_eq z.rat_string, "0"
}

test "RatSign" {
  zero = new_rat(0, 1)
  for a in t_set_string_tests {
    if x = rat_ok(a.in_) {
      assert_eq x.sign, x.cmp(zero)
    }
  }
}

test "RatCmp" {
  for t in t_rat_cmp_tests {
    x = rv(t.rat1)
    y = rv(t.rat2)
    assert_eq x.cmp(y), t.out
  }
}

test "IsInt" {
  one = new_int(1)
  for a in t_set_string_tests {
    if x = rat_ok(a.in_) {
      assert_eq x.int?, x.denom.cmp(one) == 0
    }
  }
}

test "RatAbs" {
  zero = Rat.new
  for a in t_set_string_tests {
    if x = rat_ok(a.in_) {
      e = Rat.new
      e.set!(x)
      e.sub!(zero, e) if e.cmp(zero) < 0
      z = Rat.new
      z.abs!(x)
      assert_eq z.cmp(e), 0
    }
  }
}

test "RatNeg" {
  zero = Rat.new
  for a in t_set_string_tests {
    if x = rat_ok(a.in_) {
      e = Rat.new
      e.sub!(zero, x)
      z = Rat.new
      z.neg!(x)
      assert_eq z.cmp(e), 0
    }
  }
}

test "RatInv" {
  zero = Rat.new
  for a in t_set_string_tests {
    if x = rat_ok(a.in_) {
      next if x.cmp(zero) == 0
      e = Rat.new
      e.set_frac!(x.denom, x.num)
      z = Rat.new
      z.inv!(x)
      assert_eq z.cmp(e), 0
    }
  }
}

# op: 0 add, 1 sub, 2 mul, 3 quo
def rat_bin_ok?(op: I64, xs: Str, ys: Str, zs: Str) -> Bool {
  x = rv(xs)
  y = rv(ys)
  z = rv(zs)
  out = Rat.new
  if op == 0 {
    out.add!(x, y)
  } elsif op == 1 {
    out.sub!(x, y)
  } elsif op == 2 {
    out.mul!(x, y)
  } else {
    out.quo!(x, y)
  }
  out.cmp(z) == 0
}

test "RatBin" {
  for t in t_rat_bin_tests {
    assert rat_bin_ok?(0, t.x, t.y, t.sum), "Add #{t.x} #{t.y}"
    assert rat_bin_ok?(0, t.y, t.x, t.sum), "Add symmetric"
    assert rat_bin_ok?(1, t.sum, t.x, t.y), "Sub"
    assert rat_bin_ok?(1, t.sum, t.y, t.x), "Sub symmetric"
    assert rat_bin_ok?(2, t.x, t.y, t.prod), "Mul"
    assert rat_bin_ok?(2, t.y, t.x, t.prod), "Mul symmetric"
    assert rat_bin_ok?(3, t.prod, t.x, t.y), "Quo" if t.x != "0"
    assert rat_bin_ok?(3, t.prod, t.y, t.x), "Quo symmetric" if t.y != "0"
  }
}

test "Issue820" {
  x = new_rat(3, 1)
  y = new_rat(2, 1)
  z = y.quo!(x, y)
  assert_eq z.cmp(new_rat(3, 2)), 0
  y = new_rat(3, 1)
  x = new_rat(2, 1)
  z = y.quo!(x, y)
  assert_eq z.cmp(new_rat(2, 3)), 0
  x = new_rat(3, 1)
  z = x.quo!(x, x)
  assert_eq z.cmp(new_rat(3, 3)), 0
}

test "RatSetFrac64Rat" {
  for t in t_set_frac64_tests {
    x = Rat.new
    x.set_frac64!(t.a, t.b)
    assert_eq x.rat_string, t.out
  }
}

test "Issue2379" {
  q = new_rat(3, 2)
  x = Rat.new
  x.set_frac!(new_int(3), new_int(2))
  assert_eq x.cmp(q), 0
  x = new_rat(2, 3)
  x.set_frac!(new_int(3), x.num)
  assert_eq x.cmp(q), 0
  x = new_rat(2, 3)
  x.set_frac!(x.denom, new_int(2))
  assert_eq x.cmp(q), 0
  x = new_rat(2, 3)
  x.set_frac!(x.denom, x.num)
  assert_eq x.cmp(q), 0
  q = new_rat(1, 1)
  x = Rat.new
  n = new_int(7)
  x.set_frac!(n, n)
  assert_eq x.cmp(q), 0
}

test "Issue3521" {
  a = iv("64375784358435883458348587")
  b = iv("4789759874531")
  zero = Rat.new
  one = new_int(1)
  assert_eq zero.denom.cmp(one), 0
  qab = Rat.new
  qab.set_frac!(a, b)
  x = Rat.new
  x.set_frac!(a, b)
  assert_eq x.cmp(qab), 0
  q53 = new_rat(5, 3)
  x.set_frac!(new_int(5), new_int(3))
  assert_eq x.cmp(q53), 0
}

# ---- float32 helpers (alx has no float32: values are F64s) ----

# The bits of a float32 value held in an F64.
def float32bits(f: F64) -> U64 {
  b = math.float64bits(f)
  sign = (b >> 63) << 31
  return sign if f == 0.0
  return sign | 0x7f800000 if math.is_inf(f, 0)
  e = ((b >> 52) & 2047).to_i64 - 1023
  m = b & ((ONE << 52) - 1)
  if e < -126 {
    # denormal: value = m32 * 2^-149
    mm = (m | (ONE << 52)) >> (52 - 23 + (-126 - e))
    return sign | mm
  }
  sign | ((e + 127).as_u64 << 23) | (m >> 29)
}

def nextafter32(f: F64, up: Bool) -> F64 {
  b = float32bits(f)
  if f == 0.0 {
    return float32_from_bits(1) if up
    return float32_from_bits(ONE << 31 | 1)
  }
  if (f > 0.0) == up {
    b += 1
  } else {
    b -= 1
  }
  float32_from_bits(b)
}

def is_finite(f: F64) -> Bool { !math.is_nan(f) && !math.is_inf(f, 0) }

def rat_of_float(f: F64) -> Rat {
  z = Rat.new
  if v = z.set_float64!(f) {
    return v
  }
  panic("rat_of_float: not finite")
}

def rat_delta(r: Rat, f: F64) -> Rat {
  d = Rat.new
  d.sub!(r, rat_of_float(f))
  d.abs!(d)
}

def best_approx?(f: F64, r: Rat, f32: Bool) -> Bool {
  if f32 {
    return true if math.abs(f) >= 3.40282346638528859811704183484516925440e+38
  } else {
    return true if math.abs(f) >= 1.79769313486231570814527423731704356798070e+308
  }
  f0 = 0.0
  f1 = 0.0
  even = true
  if f32 {
    f0 = nextafter32(f, false)
    f1 = nextafter32(f, true)
    even = float32bits(f) & 1 == 0
  } else {
    f0 = math.nextafter(f, math.inf(-1))
    f1 = math.nextafter(f, math.inf(1))
    even = math.float64bits(f) & 1 == 0
  }
  df = rat_delta(r, f)
  df0 = rat_delta(r, f0)
  df1 = rat_delta(r, f1)
  return false if df.cmp(df0) > 0 || df.cmp(df1) > 0
  return false if df.cmp(df0) == 0 && !even
  return false if df.cmp(df1) == 0 && !even
  true
}

def non_lossy_roundtrip?(f: F64, f32: Bool) -> Bool {
  return true if !is_finite(f)
  r = rat_of_float(f)
  f2 = 0.0
  exact = false
  if f32 {
    f2, exact = r.float32
  } else {
    f2, exact = r.float64
  }
  f == f2 && exact
}

def check_distribution(f32: Bool, wmax: U64, winc: U64, emin: I64, emax: I64, einc: I64) -> Bool {
  adds = t_test_float32_distribution_0
  for sign in [1, -1] {
    for a in adds {
      wid: U64 = 0
      while wid < wmax {
        b = (ONE << wid).as_i64 + a
        b = 0 - b if sign < 0
        exp = emin
        while exp < emax {
          num = new_int(b)
          den = new_int(1)
          if exp > 0 {
            num.lsh!(num, exp)
          } else {
            den.lsh!(den, 0 - exp)
          }
          r = Rat.new
          r.set_frac!(num, den)
          f = 0.0
          if f32 {
            f, _e = r.float32
          } else {
            f, _e = r.float64
          }
          return false if !best_approx?(f, r, f32)
          return false if !non_lossy_roundtrip?(f, f32)
          exp += einc
        }
        wid += winc
      }
    }
  }
  true
}

test "Float32Distribution" {
  assert check_distribution(true, 30, 5, -150, 150, 15), "float32 distribution"
}

test "Float64Distribution" {
  assert check_distribution(false, 60, 10, -1100, 1100, 500), "float64 distribution"
}

test "SetFloat64NonFinite" {
  for f in [math.nan, math.inf(1), math.inf(-1)] {
    r = Rat.new
    assert r.set_float64!(f).none?, "SetFloat64(#{f})"
  }
}

test "IsFinite" {
  for f in t_test_is_finite_0 {
    assert is_finite(f), "!IsFinite(#{f})"
  }
  for f in t_test_is_finite_1 {
    assert !is_finite(f), "IsFinite(#{f})"
  }
}

test "RatSetInt64" {
  r = Rat.new
  for want in t_test_rat_set_int64_0 {
    r.set_int64!(want)
    assert r.int?, "SetInt64(#{want}) is not an integer"
    num = r.num
    assert num.int64?, "numerator is not an int64"
    assert_eq num.int64, want
  }
}

test "RatSetUint64" {
  r = Rat.new
  for want in t_test_rat_set_uint64_0 {
    r.set_uint64!(want)
    assert r.int?, "SetUint64(#{want}) is not an integer"
    num = r.num
    assert num.uint64?, "numerator is not a uint64"
    assert_eq num.uint64, want
  }
}

test "Issue34919" {
  for _t in t_test_issue34919_0 {
    r = Rat.new(a: Int.new(abs: nw([991])), b: Int.new)
    _f, _e = r.float32
    _g, _e2 = r.float64
    _s = r.sign
    _i = r.int?
    _n = r.num
    z = Rat.new
    z.inv!(r)
    assert_eq r.b.abs.size, 0
  }
}

test "DenomRace" {
  # each task gets its own value (alx refuses unsynchronized sharing)
  x1 = new_rat(1, 2)
  x2 = new_rat(1, 2)
  x3 = new_rat(1, 2)
  t1 = spawn { denom_and_float(x1) }
  t2 = spawn { denom_and_float(x2) }
  t3 = spawn { denom_and_float(x3) }
  assert_eq t1.wait.unwrap, 2
  assert_eq t2.wait.unwrap, 2
  assert_eq t3.wait.unwrap, 2
}

def denom_and_float(x: Rat) -> I64 {
  fz = Float.new
  fz.set_rat!(x)
  x.denom.int64
}
