# Go's ratmarsh_test.go, translated: gob round trips through gob_encode /
# gob_decode!, JSON through encoding/json (a Rat is a JSON string, as Go
# encodes it through MarshalText). Not translated: the XML test (no
# encoding/xml) and TestGobEncodingNilRatInSlice (there is no nil Rat).

import "encoding/json"

test "RatGobEncoding" {
  for t in t_encoding_tests {
    tx = rv(t + ".14159265")
    b = tx.~gob_encode
    rx = Rat.new
    rx.~gob_decode!(b)
    assert_eq rx.cmp(tx), 0
  }
}

test "RatJSONEncoding" {
  for num in t_rat_nums {
    for denom in t_rat_denoms {
      tx = rv(num + "/" + denom)
      s = json.~marshal(tx)
      d = json.new_decoder(s)
      rx = Rat.json_dec(d)
      d.~done!
      assert_eq rx.cmp(tx), 0
    }
  }
}

test "RatGobDecodeShortBuffer" {
  for tc in t_test_rat_gob_decode_short_buffer_0 {
    z = new_rat(1, 2)
    assert z.gob_decode!(tc).err?, "expected GobDecode to return error for malformed input"
  }
}

test "RatAppendText" {
  for num in t_rat_nums {
    for denom in t_rat_denoms {
      tx = rv(num + "/" + denom)
      buf: [Byte] = [0; 4]
      b = tx.append_text(buf)
      rx = Rat.new
      rx.~unmarshal_text!(b[4...b.size])
      assert_eq rx.cmp(tx), 0
    }
  }
}
