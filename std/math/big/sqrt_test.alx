# Go's sqrt_test.go and hilbert_test.go, translated. TestFloatSqrt64 draws
# its 1e5 values from Go's math/rand source (seeded with 1) instead of
# the unseeded global one.

import "math"

test "FloatSqrt64" {
  r = new_go_rand(1)
  for _i in 0...100000 {
    x = (r.int63! >> 10).to_f * 1.1102230246251565e-16
    got = Float.new
    got.set_prec!(53)
    got.sqrt!(new_float(x))
    want = new_float(math.sqrt(x))
    assert got.cmp(want) == 0, "Sqrt(#{x}) = #{got}; want #{want}"
  }
}

test "FloatSqrt" {
  for t in t_test_float_sqrt_0 {
    for prec in [24, 53, 64, 65, 100, 128, 129, 200, 256, 400, 600, 800, 1000] {
      x = Float.new
      x.set_prec!(prec)
      _r = x.parse!(t.x, 10)
      got = Float.new
      got.set_prec!(prec)
      got.sqrt!(x)
      want = Float.new
      want.set_prec!(prec)
      _w = want.parse!(t.want, 10)
      assert got.cmp(want) == 0, "prec = #{prec}, Sqrt(#{t.x}) = #{got}; want #{want}"
      sq = Float.new
      sq.set_prec!(prec + 32)
      sq.mul!(got, got)
      diff = Float.new
      diff.sub!(sq, x)
      err = Float.new
      err.abs!(diff)
      err.set_prec!(prec)
      one = Float.new
      one.set_prec!(prec)
      one.set_int64!(1)
      m = Float.new
      m.set_mant_exp!(one, 1 - prec)
      max_err = Float.new
      max_err.mul!(m, got)
      assert err.cmp(max_err) < 0, "prec = #{prec}, Sqrt(#{t.x}): err #{err} >= #{max_err}"
    }
  }
}

test "FloatSqrtSpecial" {
  for t in t_test_float_sqrt_special_0 {
    got = Float.new
    got.sqrt!(t.x)
    assert got.neg == t.want.neg && got.form == t.want.form, "Sqrt(#{t.x}) = #{got}"
  }
}

# ---- hilbert_test.go: Hilbert matrices times their inverses ----

struct Matrix {
  n: I64
  m: I64
  a: [Rat]

  def at(i: I64, j: I64) -> Rat {
    panic("index out of range") if !(0 <= i && i < n && 0 <= j && j < m)
    a[i * m + j]
  }

  def set!(i: I64, j: I64, x: Rat) -> Unit {
    panic("index out of range") if !(0 <= i && i < n && 0 <= j && j < m)
    self.a[i * m + j] = x
  }

  def mul(b: Matrix) -> Matrix {
    panic("illegal matrix multiply") if m != b.n
    c = new_matrix(n, b.m)
    for i in 0...c.n {
      for j in 0...c.m {
        x = new_rat(0, 1)
        for k in 0...m {
          p = Rat.new
          p.mul!(self.at(i, k), b.at(k, j))
          x.add!(x, p)
        }
        c.set!(i, j, x)
      }
    }
    c
  }

  def eql(b: Matrix) -> Bool {
    return false if n != b.n || m != b.m
    for i in 0...n {
      for j in 0...m {
        return false if self.at(i, j).cmp(b.at(i, j)) != 0
      }
    }
    true
  }
}

def new_matrix(n: I64, m: I64) -> Matrix {
  panic("illegal matrix") if !(0 <= n && 0 <= m)
  a: [Rat] = []
  for _i in 0...n * m {
    a << Rat.new
  }
  Matrix.new(n: n, m: m, a: a)
}

def new_unit(n: I64) -> Matrix {
  a = new_matrix(n, n)
  for i in 0...n {
    for j in 0...n {
      x = new_rat(0, 1)
      x.set_int64!(1) if i == j
      a.set!(i, j, x)
    }
  }
  a
}

def new_hilbert(n: I64) -> Matrix {
  a = new_matrix(n, n)
  for i in 0...n {
    for j in 0...n {
      a.set!(i, j, new_rat(1, i + j + 1))
    }
  }
  a
}

def rat_binomial(n: I64, k: I64) -> Rat {
  b = Int.new
  b.binomial!(n, k)
  r = Rat.new
  r.set_int!(b)
}

def new_inverse_hilbert(n: I64) -> Matrix {
  a = new_matrix(n, n)
  for i in 0...n {
    for j in 0...n {
      x1 = Rat.new
      x1.set_int64!(i + j + 1)
      x2 = rat_binomial(n + i, n - j - 1)
      x3 = rat_binomial(n + j, n - i - 1)
      x4 = rat_binomial(i + j, i)
      x1.mul!(x1, x2)
      x1.mul!(x1, x3)
      x1.mul!(x1, x4)
      x1.mul!(x1, x4)
      x1.neg!(x1) if (i + j) & 1 != 0
      a.set!(i, j, x1)
    }
  }
  a
}

test "Hilbert" {
  n = 10
  a = new_hilbert(n)
  b = new_inverse_hilbert(n)
  assert a.mul(b).eql(new_unit(n)), "Hilbert(10) * inverse != I"
}
