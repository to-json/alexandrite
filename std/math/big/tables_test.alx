struct TabScanTest {
  input: Str
  format: Str
  output: Str
  remaining: I64
}

def t_scan_tests -> [TabScanTest] {
  t: [TabScanTest] = []
  t << TabScanTest.new(input: "1010", format: "%b", output: "10", remaining: 0)
  t << TabScanTest.new(input: "0b1010", format: "%v", output: "10", remaining: 0)
  t << TabScanTest.new(input: "12", format: "%o", output: "10", remaining: 0)
