  t << TabArgNN.new(z: nw([0x423a35c6]), x: nw([0x75bcd15]), y: nw([0x3ade68b1]))
  t << TabArgNN.new(z: nw([0x0, 0x0, 0x0, 0x1]), x: nat_zero, y: nw([0x0, 0x0, 0x0, 0x1]))
  t << TabArgNN.new(z: nw([0x0, 0x0, 0x0, 0x423a35c6]), x: nw([0x0, 0x0, 0x0, 0x75bcd15]), y: nw([0x0, 0x0, 0x0, 0x3ade68b1]))
  t << TabArgNN.new(z: nw([0x0, 0x0, 0x0, 0x1]), x: nw([0x0, 0x0, 0xffffffffffffffff]), y: nw([0x0, 0x0, 0x1]))
  t
}

