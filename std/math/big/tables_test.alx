  t << TabTestFloatSetPrec0.new(x: "-123", prec: 0, want: "-0", acc: Accuracy.Above)
  t << TabTestFloatSetPrec0.new(x: "0", prec: 4294967295, want: "0", acc: Accuracy.Exact)
  t << TabTestFloatSetPrec0.new(x: "-0", prec: 4294967295, want: "-0", acc: Accuracy.Exact)
  t << TabTestFloatSetPrec0.new(x: "-Inf", prec: 4294967295, want: "-Inf", acc: Accuracy.Exact)
  t << TabTestFloatSetPrec0.new(x: "+Inf", prec: 4294967295, want: "+Inf", acc: Accuracy.Exact)
