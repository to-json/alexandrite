struct TabTestFloatScan0 {
  input: Str
  format: Str
  output: Str
  remaining: I64
  want_err: Bool
}

def t_test_float_scan_0 -> [TabTestFloatScan0] {
  t: [TabTestFloatScan0] = []
  t << TabTestFloatScan0.new(input: "10.0", format: "%f", output: "10", remaining: 0, want_err: false)
  t << TabTestFloatScan0.new(input: "23.98+2.0", format: "%v", output: "23.98", remaining: 4, want_err: false)
  t << TabTestFloatScan0.new(input: "-1+1", format: "%v", output: "-1", remaining: 2, want_err: false)
  t << TabTestFloatScan0.new(input: " 00000", format: "%v", output: "0", remaining: 0, want_err: false)
  t << TabTestFloatScan0.new(input: "-123456p-78", format: "%b", output: "-4.084816388e-19", remaining: 0, want_err: false)
  t << TabTestFloatScan0.new(input: "+123", format: "%b", output: "123", remaining: 0, want_err: false)
  t << TabTestFloatScan0.new(input: "-1.234e+56", format: "%e", output: "-1.234e+56", remaining: 0, want_err: false)
  t << TabTestFloatScan0.new(input: "-1.234E-56", format: "%E", output: "-1.234e-56", remaining: 0, want_err: false)
  t << TabTestFloatScan0.new(input: "-1.234e+567", format: "%g", output: "-1.234e+567", remaining: 0, want_err: false)
  t << TabTestFloatScan0.new(input: "+1234567891011.234", format: "%G", output: "1.234567891e+12", remaining: 0, want_err: false)
  t << TabTestFloatScan0.new(input: "Inf", format: "%v", output: "", remaining: 3, want_err: true)
  t << TabTestFloatScan0.new(input: "-Inf", format: "%v", output: "", remaining: 3, want_err: true)
  t << TabTestFloatScan0.new(input: "-Inf", format: "%v", output: "", remaining: 3, want_err: true)
  t
}

