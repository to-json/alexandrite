struct TabExponentTests {
  s: Str
  base2ok: Bool
  sep_ok: Bool
  x: I64
  b: I64
  err: Str
  next_: I64
}

def t_exponent_tests -> [TabExponentTests] {
  t: [TabExponentTests] = []
  t << TabExponentTests.new(s: "", base2ok: false, sep_ok: false, x: 0, b: 10, err: "", next_: 0)
  t << TabExponentTests.new(s: "1", base2ok: false, sep_ok: false, x: 0, b: 10, err: "", next_: 49)
  t << TabExponentTests.new(s: "e0", base2ok: false, sep_ok: false, x: 0, b: 10, err: "", next_: 0)
  t << TabExponentTests.new(s: "E1", base2ok: false, sep_ok: false, x: 1, b: 10, err: "", next_: 0)
  t << TabExponentTests.new(s: "e+10", base2ok: false, sep_ok: false, x: 10, b: 10, err: "", next_: 0)
  t << TabExponentTests.new(s: "e-10", base2ok: false, sep_ok: false, x: -10, b: 10, err: "", next_: 0)
  t << TabExponentTests.new(s: "e123456789a", base2ok: false, sep_ok: false, x: 123456789, b: 10, err: "", next_: 97)
  t << TabExponentTests.new(s: "p", base2ok: false, sep_ok: false, x: 0, b: 10, err: "", next_: 112)
  t << TabExponentTests.new(s: "P+100", base2ok: false, sep_ok: false, x: 0, b: 10, err: "", next_: 80)
  t << TabExponentTests.new(s: "p0", base2ok: true, sep_ok: false, x: 0, b: 2, err: "", next_: 0)
  t << TabExponentTests.new(s: "P-123", base2ok: true, sep_ok: false, x: -123, b: 2, err: "", next_: 0)
  t << TabExponentTests.new(s: "p+0a", base2ok: true, sep_ok: false, x: 0, b: 2, err: "", next_: 97)
  t << TabExponentTests.new(s: "p+123__", base2ok: true, sep_ok: false, x: 123, b: 2, err: "", next_: 95)
  t << TabExponentTests.new(s: "e+1_0", base2ok: false, sep_ok: true, x: 10, b: 10, err: "", next_: 0)
  t << TabExponentTests.new(s: "e-1_0", base2ok: false, sep_ok: true, x: -10, b: 10, err: "", next_: 0)
  t << TabExponentTests.new(s: "e123_456_789a", base2ok: false, sep_ok: true, x: 123456789, b: 10, err: "", next_: 97)
  t << TabExponentTests.new(s: "P+1_00", base2ok: false, sep_ok: true, x: 0, b: 10, err: "", next_: 80)
  t << TabExponentTests.new(s: "p-1_2_3", base2ok: true, sep_ok: true, x: -123, b: 2, err: "", next_: 0)
  t << TabExponentTests.new(s: "e", base2ok: false, sep_ok: false, x: 0, b: 10, err: "number has no digits", next_: 0)
  t << TabExponentTests.new(s: "ef", base2ok: false, sep_ok: false, x: 0, b: 10, err: "number has no digits", next_: 102)
  t << TabExponentTests.new(s: "e+", base2ok: false, sep_ok: false, x: 0, b: 10, err: "number has no digits", next_: 0)
  t << TabExponentTests.new(s: "E-x", base2ok: false, sep_ok: false, x: 0, b: 10, err: "number has no digits", next_: 120)
  t << TabExponentTests.new(s: "p", base2ok: true, sep_ok: false, x: 0, b: 2, err: "number has no digits", next_: 0)
  t << TabExponentTests.new(s: "P-", base2ok: true, sep_ok: false, x: 0, b: 2, err: "number has no digits", next_: 0)
  t << TabExponentTests.new(s: "p+e", base2ok: true, sep_ok: false, x: 0, b: 2, err: "number has no digits", next_: 101)
  t << TabExponentTests.new(s: "e+_x", base2ok: false, sep_ok: true, x: 0, b: 10, err: "number has no digits", next_: 120)
  t << TabExponentTests.new(s: "e0_", base2ok: false, sep_ok: true, x: 0, b: 10, err: "'_' must separate successive digits", next_: 0)
  t << TabExponentTests.new(s: "e_0", base2ok: false, sep_ok: true, x: 0, b: 10, err: "'_' must separate successive digits", next_: 0)
  t << TabExponentTests.new(s: "e-1_2__3", base2ok: false, sep_ok: true, x: -123, b: 10, err: "'_' must separate successive digits", next_: 0)
  t
}

