  t << TabTestDecimalString0.new(x: Decimal.new(mant: bs([]), exp: 0), want: "0")
  t << TabTestDecimalString0.new(x: Decimal.new(mant: bs([]), exp: 1000), want: "0")
  t << TabTestDecimalString0.new(x: Decimal.new(mant: bs([49, 50, 51, 52, 53]), exp: 0), want: "0.12345")
  t << TabTestDecimalString0.new(x: Decimal.new(mant: bs([49, 50, 51, 52, 53]), exp: -3), want: "0.00012345")
  t << TabTestDecimalString0.new(x: Decimal.new(mant: bs([49, 50, 51, 52, 53]), exp: 3), want: "123.45")
  t << TabTestDecimalString0.new(x: Decimal.new(mant: bs([49, 50, 51, 52, 53]), exp: 10), want: "1234500000")
  t
}

