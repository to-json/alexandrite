  t << TabTestFloatSetPrec0.new(x: "-1.5", prec: 1, want: "-2", acc: Accuracy.Below)
  t << TabTestFloatSetPrec0.new(x: "123", prec: 1000000, want: "123", acc: Accuracy.Exact)
  t << TabTestFloatSetPrec0.new(x: "-123", prec: 1000000, want: "-123", acc: Accuracy.Exact)
  t
}

