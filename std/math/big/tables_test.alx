def t_test_float_set_prec_0 -> [TabTestFloatSetPrec0] {
  t: [TabTestFloatSetPrec0] = []
  t << TabTestFloatSetPrec0.new(x: "0", prec: 0, want: "0", acc: Accuracy.Exact)
  t << TabTestFloatSetPrec0.new(x: "-0", prec: 0, want: "-0", acc: Accuracy.Exact)
