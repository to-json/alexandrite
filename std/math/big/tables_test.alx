  x: Int
  y: Int
}

def t_sum_zz -> [TabArgZZ] {
  t: [TabArgZZ] = []
  t << TabArgZZ.new(z: iv("0"), x: iv("0"), y: iv("0"))
  t << TabArgZZ.new(z: iv("1"), x: iv("1"), y: iv("0"))
  t << TabArgZZ.new(z: iv("1111111110"), x: iv("123456789"), y: iv("987654321"))
  t << TabArgZZ.new(z: iv("-1"), x: iv("-1"), y: iv("0"))
  t << TabArgZZ.new(z: iv("864197532"), x: iv("-123456789"), y: iv("987654321"))
  t << TabArgZZ.new(z: iv("-1111111110"), x: iv("-123456789"), y: iv("-987654321"))
  t
}

