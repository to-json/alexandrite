  t << TabShiftTest.new(in_: nw([0x1]), shift: 1, out: nw([0x2]))
  t << TabShiftTest.new(in_: nw([0x8000000000000000]), shift: 1, out: nw([0x0]))
  t << TabShiftTest.new(in_: nw([0x8000000000000000, 0x0]), shift: 1, out: nw([0x0, 0x1]))
  t
}

def t_right_shift_tests -> [TabShiftTest] {
  t: [TabShiftTest] = []
  t << TabShiftTest.new(in_: nat_zero, shift: 0, out: nat_zero)
  t << TabShiftTest.new(in_: nat_zero, shift: 1, out: nat_zero)
  t << TabShiftTest.new(in_: nw([0x1]), shift: 0, out: nw([0x1]))
  t << TabShiftTest.new(in_: nw([0x1]), shift: 1, out: nat_zero)
  t << TabShiftTest.new(in_: nw([0x2]), shift: 1, out: nw([0x1]))
  t << TabShiftTest.new(in_: nw([0x0, 0x1]), shift: 1, out: nw([0x8000000000000000]))
  t << TabShiftTest.new(in_: nw([0x2, 0x1, 0x1]), shift: 1, out: nw([0x8000000000000001, 0x8000000000000000]))
  t
}

