  t << TabScanTest.new(input: "A", format: "%X", output: "10", remaining: 0)
  t << TabScanTest.new(input: "-A", format: "%X", output: "-10", remaining: 0)
  t << TabScanTest.new(input: "+0b1011001", format: "%v", output: "89", remaining: 0)
  t << TabScanTest.new(input: "0xA", format: "%v", output: "10", remaining: 0)
  t << TabScanTest.new(input: "0 ", format: "%v", output: "0", remaining: 1)
