struct TabCmpTests {
  x: [U64]
  y: [U64]
  r: I64
}

def t_cmp_tests -> [TabCmpTests] {
  t: [TabCmpTests] = []
  t << TabCmpTests.new(x: nat_zero, y: nat_zero, r: 0)
  t << TabCmpTests.new(x: nat_zero, y: nat_zero, r: 0)
  t << TabCmpTests.new(x: nat_zero, y: nat_zero, r: 0)
  t << TabCmpTests.new(x: nat_zero, y: nat_zero, r: 0)
  t << TabCmpTests.new(x: nw([0x0]), y: nw([0x0]), r: 0)
  t << TabCmpTests.new(x: nw([0x0]), y: nw([0x1]), r: -1)
  t << TabCmpTests.new(x: nw([0x1]), y: nw([0x0]), r: 1)
  t << TabCmpTests.new(x: nw([0x1]), y: nw([0x1]), r: 0)
  t << TabCmpTests.new(x: nw([0x0, 0xffffffffffffffff]), y: nw([0x1]), r: 1)
  t << TabCmpTests.new(x: nw([0x1]), y: nw([0x0, 0xffffffffffffffff]), r: -1)
  t << TabCmpTests.new(x: nw([0x1, 0xffffffffffffffff]), y: nw([0x0, 0xffffffffffffffff]), r: 1)
  t << TabCmpTests.new(x: nw([0x0, 0xffffffffffffffff]), y: nw([0x1, 0xffffffffffffffff]), r: -1)
  t << TabCmpTests.new(x: nw([0x10, 0x8ba34, 0x225a, 0x44]), y: nw([0x345, 0x23ba, 0x1, 0xb8339]), r: -1)
  t << TabCmpTests.new(x: nw([0x88aa, 0x29, 0x69, 0x7a5]), y: nw([0x38, 0x1d22, 0x68, 0x7a5]), r: 1)
  t
}

struct TabArgNN {
