#![overflow(wrap)]
# Small helpers shared by the marshaling code.

import "encoding/json"

def put_be32(buf: [Byte], i: I64, v: U64) -> Unit {
  buf[i] = (v >> 24).as_u8
  buf[i + 1] = (v >> 16).as_u8
  buf[i + 2] = (v >> 8).as_u8
  buf[i + 3] = v.as_u8
}

def get_be32(buf: [Byte], i: I64) -> U64 {
  (buf[i].to_u64 << 24) | (buf[i + 1].to_u64 << 16) | (buf[i + 2].to_u64 << 8) | buf[i + 3].to_u64
}

# Go's %#x of a word.
def format_hex(x: U64) -> Str { "0x" + Str.from_bytes(nat_utoa(nat_set_word(x), 16)) }

# The text of the JSON string read from d (for the types Go's json encodes
# through MarshalText), or none after null or an error (recorded in d).
def json_text_value(d: json.Decoder, what: Str) -> Str? {
  dd = d
  v = json.Value.json_dec(dd)
  return none if dd.failed || v.null?
  if s = v.as_str {
    return s
  }
  dd.fail!(json.JsonError.Type(value: v.to_s, type_name: "*big." + what, offset: dd.pos, struct_name: "", field: "", cause: ""))
  none
}
