test "vectors: Int.format 13" {
  assert_eq vformat("0x8510e11", "%+\#o"), "+01024207021"
  assert_eq vformat("0x1", "%x"), "1"
  assert_eq vformat("0x0", "%-12.5x|"), "00000       |"
  assert_eq vformat("0x44cd77d8668e1b603a5c46e39b36d1047d28631a602e597", "%+\#o"), "+0104632737303150703330035134215616331555040437224143064600562627"
  assert_eq vformat("0x377f55ff", "%12.5d"), "   931091967"
  assert_eq vformat("0x0", "%o"), "0"
  assert_eq vformat("0x0", "%v"), "0"
  assert_eq vformat("0x0", "%-8d|"), "0       |"
  assert_eq vformat("0xc581ca6e73f5fc7ff7eb", "%X"), "C581CA6E73F5FC7FF7EB"
  assert_eq vformat("0x0", "%\#o"), "00"
  assert_eq vformat("0x283cded3202a5351590a3050ed804de860983", "%\#x"), "0x283cded3202a5351590a3050ed804de860983"
  assert_eq vformat("0x373af7fffff", "%q"), "%!q(big.Int=3795400523775)"
  assert_eq vformat("0x8b1b6ac2f01", "%\#y"), "%!y(big.Int=9559366971137)"
  assert_eq vformat("0x0", "%b"), "0"
  assert_eq vformat("0x1", "%+d"), "+1"
  assert_eq vformat("0x0", "%010b"), "0000000000"
  assert_eq vformat("0x3", "%\#x"), "0x3"
  assert_eq vformat("0x0", "%s"), "0"
  assert_eq vformat("0x0", "%\#y"), "%!y(big.Int=0)"
  assert_eq vformat("-0x382dbc", "%X"), "-382DBC"
  assert_eq vformat("0x975135f6dd48eaef5347987373371ca173", "%\#x"), "0x975135f6dd48eaef5347987373371ca173"
  assert_eq vformat("-0x3f7ffff", "%-12.5x|"), "-3f7ffff    |"
  assert_eq vformat("0x2", "%+d"), "+2"
  assert_eq vformat("0x5a11fdc", "%\#y"), "%!y(big.Int=94445532)"
  assert_eq vformat("0x0", "%.10d"), "0000000000"
  assert_eq vformat("-0x3f", "% x"), "-3f"
  assert_eq vformat("0x7e9ff6e", "%o"), "772377556"
  assert_eq vformat("0x0", "%+\#o"), "+00"
  assert_eq vformat("0x0", "%\#X"), "0X0"
  assert_eq vformat("0xd679a9c31001198bdc65fbfff7", "%\#X"), "0XD679A9C31001198BDC65FBFFF7"
  assert_eq vformat("0x0", "%12.5d"), "       00000"
  assert_eq vformat("-0xd9b7c", "%+\#o"), "-03315574"
  assert_eq vformat("0x3d04593a27ec892185aa46dab3eed8c99f7b8", "% d"), " 85045266792954491403175954523995650829973432"
  assert_eq vformat("0x1", "%\#b"), "0b1"
  assert_eq vformat("-0x2c9e3976fff", "%+d"), "-3066130034687"
  assert_eq vformat("0x5aec3", "%12.5d"), "      372419"
  assert_eq vformat("0x0", "%-8d|"), "0       |"
