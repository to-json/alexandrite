  assert_eq vf("sqrt", "0x.bd1968840eea24fe9ed7cp-16/102", "0/0", 1, 2), "0x.8p-7/1 Exact"
  assert_eq vf("sqrt", "0x.fd3b558be17p+125/48", "0/0", 24, 2), "0x.b409b8p+63/24 Exact"
  assert_eq vf("sqrt", "0x.a7bd730f7f16p+140/62", "0/0", 64, 2), "0x.cf3922d19b36beeep+70/64 Exact"
