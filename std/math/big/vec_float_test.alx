test "vectors: Float.sqrt 17" {
  assert_eq vf("sqrt", "0x.fec83f1d7fb90b3ab2343042c245089fap+118/235", "0/0", 128, 2), "0x.ff63effcfd86d39a30daec5f610195efp+59/128 Exact"
