test "vectors: Float.parse 12" {
  assert_eq vfparse("-46610.3270742833508899932e-31", 24, 4), "-0x.b8a47dp-87/24 10 Below"
  assert_eq vfparse("0x42071147e3a01a29.6a665p-60", 10, 1), "0x.84p+3/10 16 Below"
  assert_eq vfparse("2.9552519325050244e+167", 300, 4), "0x.a05f135806c2c81c0340c92dc6d230a98fa5986de592d7f9d17e2950d0356540408ba502d2ap+557/300 10 Below"
  assert_eq vfparse("12785868619988237746488215019.1363851125111495935721471", 10, 4), "0x.a54p+94/10 10 Below"
  assert_eq vfparse("0b10000100100010000010.1100110101p11", 1, 2), "0x.8p+31/1 2 Below"
  assert_eq vfparse("716e-1357", 10, 5), "0x.c5cp-4498/10 10 Above"
  assert_eq vfparse("15389.4835254904277710046e-28", 300, 0), "0x.ee24066c31a191b63489eac8b70cdd9a24a4227745d497fc324da4230860445edc6b77a1008p-79/300 10 Above"
  assert_eq vfparse("0x38791befea89922.257d6p-84", 53, 2), "0x.e1e46fbfaa2648p-26/53 16 Below"
  assert_eq vfparse("1.6662143423254127e+84", 100, 1), "0x.db91cbe8c3d3fe9a4110c6015p+280/100 10 Below"
  assert_eq vfparse("34491.79803359775658784526694399", 300, 0), "0x.86bbcc4bee0b794895004ad58d1267ce975864aa07a3d60d0358f63a79db9ef791e2393a0e4p+16/300 10 Below"
  assert_eq vfparse("0b11100000101001001001.11100110p0", 10, 3), "0x.e0cp+20/10 2 Above"
  assert_eq vfparse("360e1614", 10, 3), "0x.87cp+5371/10 10 Above"
  assert_eq vfparse("18696.5929099253491178335e-16", 300, 1), "0x.8390c99c8ad06e65b762afe214dae410612515478a7a4fc82e48a804a53efaa392fbd6b3c7ep-38/300 10 Below"
  assert_eq vfparse("0x571799f1744f1bb7.3310ap11", 300, 1), "0x.ae2f33e2e89e376e66214p+74/300 16 Exact"
  assert_eq vfparse("2.22584460394463e+226", 53, 2), "0x.f088ee1081a66p+752/53 10 Below"
  assert_eq vfparse("124557850181669642209378686719434660521574383.1219855445661702826752248341534", 10, 0), "0x.b2cp+147/10 10 Above"
  assert_eq vfparse("0b111100011000001111.11010101p11", 300, 0), "0x.f183f54p+29/300 2 Exact"
