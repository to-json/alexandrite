# Helpers for the generated vectors (vec_*_test.alx): each takes the
# operands as text and returns the result in the text form Go printed.

import "math"
import "strconv"

def hx(z: Int) -> Str { z.format("%#x") }

def vi(op: Str, xs: Str, ys: Str) -> Str {
  x = iv(xs)
  y = iv(ys)
  z = Int.new
  case op {
    "add" => z.add!(x, y)
    "sub" => z.sub!(x, y)
    "mul" => z.mul!(x, y)
    "quo" => z.quo!(x, y)
    "rem" => z.rem!(x, y)
    "div" => z.div!(x, y)
    "mod" => z.mod!(x, y)
    "and" => z.and!(x, y)
    "or" => z.or!(x, y)
    "xor" => z.xor!(x, y)
    "and_not" => z.and_not!(x, y)
    "cmp" => {
      return "#{x.cmp(y)}"
    }
    "gcd" => z.gcd!(x, y)
    "gcd_x" => {
      _d, a, _b = z.gcd_xy!(x, y)
      z = a
    }
    "gcd_y" => {
      _d, _a, b = z.gcd_xy!(x, y)
      z = b
    }
    _ => {
      if r = z.mod_inverse!(x, y) {
        z = r
      } else {
        return "nil"
      }
    }
  }
  hx(z)
}

def vexp(xs: Str, ys: Str, ms: Str) -> Str {
  z = Int.new
  if r = z.exp!(iv(xs), iv(ys), iv(ms)) {
    return hx(r)
  }
  "nil"
}

def vsh(op: Str, xs: Str, n: I64) -> Str {
  x = iv(xs)
  z = Int.new
  case op {
    "lsh" => z.lsh!(x, n)
    "rsh" => z.rsh!(x, n)
    "bit" => {
      return "#{x.bit(n)}"
    }
    "set_bit0" => z.set_bit!(x, n, 0)
    "set_bit1" => z.set_bit!(x, n, 1)
    "sqrt" => z.sqrt!(x)
    "not" => z.not!(x)
    "bit_len" => {
      return "#{x.bit_len}"
    }
    _ => {
      return "#{x.trailing_zero_bits}"
    }
  }
  hx(z)
}

def vbinomial(n: I64, k: I64) -> Str {
  z = Int.new
  hx(z.binomial!(n, k))
}

def vmul_range(a: I64, b: I64) -> Str {
  z = Int.new
  hx(z.mul_range!(a, b))
}

def vprime(xs: Str) -> Bool { iv(xs).probably_prime?(10) }

def vjacobi(xs: Str, ys: Str) -> I64 { jacobi(iv(xs), iv(ys)) }

def vmod_sqrt(xs: Str, ps: Str) -> Str {
  z = Int.new
  if r = z.mod_sqrt!(iv(xs), iv(ps)) {
    return hx(r)
  }
  "nil"
}

def vdivide(xs: Str, ys: Str, mode: I64) -> Str {
  z = Int.new
  q, r = z.divide!(iv(xs), iv(ys), RoundingMode.from_i(mode))
  "#{hx(q)} #{hx(r)}"
}

def vfloat64(xs: Str) -> Str {
  f, acc = iv(xs).float64
  "#{strconv.format_float(f, "g", -1, 64)} #{acc}"
}

def vtext(xs: Str, base: I64) -> Str { iv(xs).text(base) }

def vset_string(s: Str, base: I64) -> Str {
  z = Int.new
  if r = z.set_string!(s, base) {
    return hx(r)
  }
  "nil"
}

def vformat(xs: Str, f: Str) -> Str { iv(xs).format(f) }

def to_hex_bytes(b: [Byte]) -> Str {
  out: [Byte] = []
  for c in b {
    out << DIGITS[(c >> 4).to_i64]
    out << DIGITS[(c & 15).to_i64]
  }
  Str.from_bytes(out)
}

def vbytes(xs: Str) -> Str {
  x = iv(xs)
  "#{to_hex_bytes(x.bytes)} #{to_hex_bytes(x.gob_encode)}"
}

def vr(op: Str, xs: Str, ys: Str) -> Str {
  x = rv(xs)
  y = rv(ys)
  z = Rat.new
  case op {
    "add" => z.add!(x, y)
    "sub" => z.sub!(x, y)
    "mul" => z.mul!(x, y)
    "quo" => z.quo!(x, y)
    _ => {
      return "#{x.cmp(y)}"
    }
  }
  z.to_s
}

def vrconv(xs: Str, prec: I64) -> Str {
  x = rv(xs)
  f64, ex = x.float64
  f32, ex32 = x.float32
  fp_, fe = x.float_prec
  "#{x.rat_string}|#{x.float_string(prec)}|#{strconv.format_float(f64, "g", -1, 64)} #{ex}|#{strconv.format_float(f32, "g", -1, 32)} #{ex32}|#{fp_} #{fe}"
}

def vrset(s: Str) -> Str {
  z = Rat.new
  if r = z.set_string!(s) {
    return r.to_s
  }
  "nil"
}

def vrfloat(bits: U64) -> Str {
  z = Rat.new
  if r = z.set_float64!(math.float64frombits(bits)) {
    return r.to_s
  }
  "nil"
}

# "<%p text>/<prec>" for a Float, and back.
def fp(x: Float) -> Str { "#{x.text("p", 0)}/#{x.prec}" }

def fparse(s: Str) -> Float {
  i = s.size - 1
  while s[i] != 47 {
    i -= 1
  }
  prec = strconv.atoi(s[i + 1...s.size]).unwrap
  t = s[0...i]
  z = Float.new
  z.set_prec!(prec)
  if t == "+Inf" || t == "-Inf" {
    return z.set_inf!(t == "-Inf")
  }
  if t == "-0" {
    z.set_float64!(neg_zero)
    return z
  }
  z.set_string!(t)
  z
}

def vf(op: Str, xs: Str, ys: Str, prec: I64, mode: I64) -> Str {
  x = fparse(xs)
  z = Float.new
  z.set_prec!(prec)
  z.set_mode!(RoundingMode.from_i(mode))
  case op {
    "add" => z.add!(x, fparse(ys))
    "sub" => z.sub!(x, fparse(ys))
    "mul" => z.mul!(x, fparse(ys))
    "quo" => z.quo!(x, fparse(ys))
    "sqrt" => z.sqrt!(x)
    _ => {
      z = x
      z.set_mode!(RoundingMode.from_i(mode))
      z.set_prec!(prec)
    }
  }
  "#{fp(z)} #{z.acc}"
}

def vfconv(xs: Str) -> Str {
  x = fparse(xs)
  i64, a1 = x.int64
  u64, a2 = x.uint64
  f64, a3 = x.float64
  f32, a4 = x.float32
  iz, a5 = x.int
  rz, _a6 = x.rat
  ivs = "nil"
  if v = iz {
    ivs = v.to_s
  }
  rs = "nil"
  if v = rz {
    rs = v.to_s
  }
  "#{i64} #{a1}|#{u64} #{a2}|#{strconv.format_float(f64, "g", -1, 64)} #{a3}|#{strconv.format_float(f32, "g", -1, 32)} #{a4}|#{ivs} #{a5}|#{rs}|#{x.int?} #{x.min_prec}"
}

def vftext(xs: Str, f: Str, prec: I64) -> Str { fparse(xs).text(f, prec) }

def vfformat(xs: Str, f: Str) -> Str { fparse(xs).format(f) }

def vfparse(s: Str, prec: I64, mode: I64) -> Str {
  r = parse_float(s, 0, prec, RoundingMode.from_i(mode))
  if r.err? {
    return "error"
  }
  z, b = r.unwrap
  "#{fp(z)} #{b} #{z.acc}"
}
