test "vectors: Int.divide 48" {
  assert_eq vdivide("0x254705f283b3de1a45fdc29259e9cd4f83", "0x253e02b059dfde6704975e9a951564462", 2), "0x10 0x9034229d3ffb3416663f7c4d4690963"
  assert_eq vdivide("-0x77dfff", "0x18011ba2cab99d4d77e02a90", 4), "-0x1 0x18011ba2cab99d4d77684a91"
