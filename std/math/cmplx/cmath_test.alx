# Go's cmath_test.go and huge_test.go, translated. The tables are in
# data_test.alx (generated from Go's); the tolerances are Go's.

import "math"

# ---- Go's helpers (from pkg/math/all_test.go) ----

# b is the expected value, a the actual one; e is a fraction of b.
def tolerance(a: Float, b: Float, e: Float) -> Bool {
  d = a - b
  d = -d if d < 0.0
  if b != 0.0 {
    e = e * b
    e = -e if e < 0.0
  }
  d < e
}

def veryclose(a: Float, b: Float) -> Bool { tolerance(a, b, 4e-16) }

def alike(a: Float, b: Float) -> Bool {
  return true if a != a && b != b
  return math.signbit(a) == math.signbit(b) if a == b
  false
}

def c_tolerance(a: Complex, b: Complex, e: Float) -> Bool {
  d = abs(a - b)
  if b != 0 {
    e = e * abs(b)
    e = -e if e < 0.0
  }
  d < e
}

def c_soclose(a: Complex, b: Complex, e: Float) -> Bool { c_tolerance(a, b, e) }

def c_veryclose(a: Complex, b: Complex) -> Bool { c_tolerance(a, b, 4e-16) }

def c_alike(a: Complex, b: Complex) -> Bool {
  # Special values match exactly; other cases (multiples of PI) may differ
  # in the last bit across platforms.
  ra = is_exact(b.real) ? alike(a.real, b.real) : veryclose(a.real, b.real)
  ia = is_exact(b.imag) ? alike(a.imag, b.imag) : veryclose(a.imag, b.imag)
  ra && ia
}

def is_exact(x: Float) -> Bool { math.is_nan(x) || math.is_inf(x, 0) || x == 0.0 || x == 1.0 || x == -1.0 }

# The vc table at tolerance e (0 = veryclose).
def check_vc(name: Str, f: (Complex) -> Complex, want: [Complex], e: Float) -> Int {
  bad = 0
  vc = t_vc
  for i in 0...vc.size {
    got = f(vc[i])
    ok = e == 0.0 ? c_veryclose(want[i], got) : c_soclose(want[i], got, e)
    if !ok {
      puts "#{name}(#{vc[i]}) = #{got}, want #{want[i]}"
      bad += 1
    }
  }
  bad
}

# A special-case table, with Go's symmetry checks: f(conj z) == conj f(z)
# always; f(-z) == -f(z) when odd, f(-z) == f(z) when even.
def check_sc(name: Str, f: (Complex) -> Complex, sc: [(Complex, Complex)], odd: Bool, even: Bool) -> Int {
  bad = 0
  for v in sc {
    x = v[0]
    want = v[1]
    got = f(x)
    if !c_alike(want, got) {
      puts "#{name}(#{x}) = #{got}, want #{want}"
      bad += 1
    }
    # Negating NaN is undefined with regard to the sign bit produced.
    next if math.is_nan(x.imag) || math.is_nan(want.imag)
    g2 = f(conj(x))
    if !c_alike(conj(want), g2) && !c_alike(x, conj(x)) {
      puts "#{name}(#{conj(x)}) = #{g2}, want #{conj(want)}"
      bad += 1
    }
    next if !odd && !even
    next if math.is_nan(x.real) || math.is_nan(want.real)
    w3 = odd ? -want : want
    g3 = f(-x)
    if !c_alike(w3, g3) && !c_alike(x, -x) {
      puts "#{name}(#{-x}) = #{g3}, want #{w3}"
      bad += 1
    }
  }
  bad
}

def check_branches(name: Str, f: (Complex) -> Complex) -> Int {
  bad = 0
  for pt in t_branch_points {
    f0 = f(pt[0])
    f1 = f(pt[1])
    if !c_veryclose(f0, f1) {
      puts "#{name}(#{pt[0]}) not continuous, got #{f0} want #{f1}"
      bad += 1
    }
  }
  bad
}

test "abs" {
  vc = t_vc
  want = t_abs
  for i in 0...vc.size { assert veryclose(want[i], abs(vc[i])), "abs(#{vc[i]}) = #{abs(vc[i])}, want #{want[i]}" }
  sc = t_vc_abs_sc
  wsc = t_abs_sc
  for i in 0...sc.size { assert alike(wsc[i], abs(sc[i])), "abs(#{sc[i]})" }
}

test "acos" {
  f = ->(z: Complex) -> Complex { acos(z) }
  assert_eq check_vc("acos", f, t_acos, 1e-14), 0
  assert_eq check_sc("acos", f, t_acos_sc, false, false), 0
  assert_eq check_branches("acos", f), 0
}

test "acosh" {
  f = ->(z: Complex) -> Complex { acosh(z) }
  assert_eq check_vc("acosh", f, t_acosh, 1e-14), 0
  assert_eq check_sc("acosh", f, t_acosh_sc, false, false), 0
  assert_eq check_branches("acosh", f), 0
}

test "asin" {
  f = ->(z: Complex) -> Complex { asin(z) }
  assert_eq check_vc("asin", f, t_asin, 1e-14), 0
  assert_eq check_sc("asin", f, t_asin_sc, true, false), 0
  assert_eq check_branches("asin", f), 0
}

test "asinh" {
  f = ->(z: Complex) -> Complex { asinh(z) }
  assert_eq check_vc("asinh", f, t_asinh, 4e-15), 0
  assert_eq check_sc("asinh", f, t_asinh_sc, true, false), 0
  assert_eq check_branches("asinh", f), 0
}

test "atan" {
  f = ->(z: Complex) -> Complex { atan(z) }
  assert_eq check_vc("atan", f, t_atan, 0.0), 0
  assert_eq check_sc("atan", f, t_atan_sc, true, false), 0
  assert_eq check_branches("atan", f), 0
}

test "atanh" {
  f = ->(z: Complex) -> Complex { atanh(z) }
  assert_eq check_vc("atanh", f, t_atanh, 0.0), 0
  assert_eq check_sc("atanh", f, t_atanh_sc, true, false), 0
  assert_eq check_branches("atanh", f), 0
}

test "conj" {
  vc = t_vc
  want = t_conj
  for i in 0...vc.size { assert c_veryclose(want[i], conj(vc[i])), "conj(#{vc[i]})" }
  sc = t_vc_conj_sc
  wsc = t_conj_sc
  for i in 0...sc.size { assert c_alike(wsc[i], conj(sc[i])), "conj(#{sc[i]})" }
}

test "cos" {
  f = ->(z: Complex) -> Complex { cos(z) }
  assert_eq check_vc("cos", f, t_cos, 3e-15), 0
  assert_eq check_sc("cos", f, t_cos_sc, false, true), 0
}

test "cosh" {
  f = ->(z: Complex) -> Complex { cosh(z) }
  assert_eq check_vc("cosh", f, t_cosh, 2e-15), 0
  assert_eq check_sc("cosh", f, t_cosh_sc, false, true), 0
}

test "exp" {
  f = ->(z: Complex) -> Complex { exp(z) }
  assert_eq check_vc("exp", f, t_exp, 1e-15), 0
  assert_eq check_sc("exp", f, t_exp_sc, false, false), 0
}

test "is_nan" {
  sc = t_vc_is_nan_sc
  want = t_is_nan_sc
  for i in 0...sc.size { assert_eq is_nan(sc[i]), want[i] }
}

test "log" {
  f = ->(z: Complex) -> Complex { log(z) }
  assert_eq check_vc("log", f, t_log, 0.0), 0
  assert_eq check_sc("log", f, t_log_sc, false, false), 0
  assert_eq check_branches("log", f), 0
}

test "log10" {
  f = ->(z: Complex) -> Complex { log10(z) }
  assert_eq check_vc("log10", f, t_log10, 0.0), 0
  assert_eq check_sc("log10", f, t_log10_sc, false, false), 0
}

test "polar" {
  vc = t_vc
  want = t_polar
  for i in 0...vc.size {
    r, theta = polar(vc[i])
    assert veryclose(want[i][0], r) || veryclose(want[i][1], theta), "polar(#{vc[i]}) = #{r}, #{theta}"
  }
  sc = t_vc_polar_sc
  wsc = t_polar_sc
  for i in 0...sc.size {
    r, theta = polar(sc[i])
    assert alike(wsc[i][0], r) || alike(wsc[i][1], theta), "polar(#{sc[i]})"
  }
}

test "pow" {
  # Special cases for pow(0, c).
  zero = Complex.new(0, 0)
  zero_powers: [(Complex, Complex)] = [(0, 1 + 0i), (1.5, 0 + 0i), (-1.5, Complex.new(math.inf(0), 0)), (-1.5 + 1.5i, inf)]
  for zp in zero_powers { assert pow(zero, zp[0]) == zp[1], "pow(#{zero}, #{zp[0]}) = #{pow(zero, zp[0])}, want #{zp[1]}" }
  a = Complex.new(3.0, 3.0)
  vc = t_vc
  want = t_pow
  for i in 0...vc.size { assert c_soclose(want[i], pow(a, vc[i]), 4e-15), "pow(#{a}, #{vc[i]}) = #{pow(a, vc[i])}, want #{want[i]}" }
  sc = t_vc_pow_sc
  wsc = t_pow_sc
  for i in 0...sc.size { assert c_alike(wsc[i], pow(sc[i][0], sc[i][1])), "pow(#{sc[i][0]}, #{sc[i][1]})" }
  f = ->(z: Complex) -> Complex { pow(z, 0.1) }
  assert_eq check_branches("pow", f), 0
}

test "rect" {
  vc = t_vc
  p = t_polar
  for i in 0...vc.size { assert c_veryclose(vc[i], rect(p[i][0], p[i][1])), "rect(#{p[i][0]}, #{p[i][1]}) = #{rect(p[i][0], p[i][1])}, want #{vc[i]}" }
  sc = t_vc_polar_sc
  psc = t_polar_sc
  for i in 0...sc.size { assert c_alike(sc[i], rect(psc[i][0], psc[i][1])), "rect(#{psc[i][0]}, #{psc[i][1]})" }
}

test "sin" {
  f = ->(z: Complex) -> Complex { sin(z) }
  assert_eq check_vc("sin", f, t_sin, 2e-15), 0
  assert_eq check_sc("sin", f, t_sin_sc, true, false), 0
}

test "sinh" {
  f = ->(z: Complex) -> Complex { sinh(z) }
  assert_eq check_vc("sinh", f, t_sinh, 2e-15), 0
