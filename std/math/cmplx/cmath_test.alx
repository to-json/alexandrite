test "tanh" {
  f = ->(z: Complex) -> Complex { tanh(z) }
  assert_eq check_vc("tanh", f, t_tanh, 2e-15), 0
  assert_eq check_sc("tanh", f, t_tanh_sc, true, false), 0
}

# See Go issue 17577.
test "infinite loop in tan_series" {
  assert cot(0) == inf, "cot(0) = #{cot(0)}"
}

# huge_test.go: reduce_pi on huge values along the real axis.
test "tan huge" {
  xs = t_huge_in
  want = t_tan_huge
  for i in 0...xs.size { assert c_soclose(want[i], tan(xs[i]), 3e-15), "tan(#{xs[i]}) = #{tan(xs[i])}, want #{want[i]}" }
}
