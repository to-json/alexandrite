# Go's example_test.go.

example "abs" {
  puts format("%.1f", abs(3 + 4i))
} outputs "5.0"

# euler identity
example "exp" {
  puts format("%.1f", exp(1i * math.PI) + 1)
} outputs "(0.0+0.0i)"

example "polar" {
  r, theta = polar(2i)
  puts format("r: %.1f, θ: %.1f*π", r, theta / math.PI)
} outputs "r: 2.0, θ: 0.5*π"
