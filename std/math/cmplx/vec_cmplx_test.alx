  assert cok(log10(cb(0xC000000000000000, 0xBFF0000000000000)), 0x3FD65DF657B04301, 0xBFF29BB775274232), "log10((-2-1i))"
}

test "log10 2" {
  assert cok(log10(cb(0xC000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FE5D47C4CB2FBA0), "log10((-2+Infi))"
  assert cok(log10(cb(0xC000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xBFE5D47C4CB2FBA0), "log10((-2-Infi))"
  assert cok(log10(cb(0xC000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "log10((-2+NaNi))"
  assert cok(log10(cb(0xC000000000000000, 0x3FE0000000000000)), 0x3FD41BC319F7812F, 0x3FF420B347045E2B), "log10((-2+0.5i))"
  assert cok(log10(cb(0xC000000000000000, 0xC000000000000000)), 0x3FDCE61CF8EF36FF, 0xBFF05F5D39863CB8), "log10((-2-2i))"
  assert cok(log10(cb(0xC000000000000000, 0x000012688B70E62B)), 0x3FD34413509F79FF, 0x3FF5D47C4CB2FBA0), "log10((-2+1e-310i))"
  assert cok(log10(cb(0xC000000000000000, 0x7E37E43C8800759C)), 0x4072C00000000000, 0x3FE5D47C4CB2FBA0), "log10((-2+1e+300i))"
  assert cok(log10(cb(0xC000000000000000, 0x3FF921FB54442D18)), 0x3FD9F17F9D114AB9, 0x3FF13429141871C8), "log10((-2+1.5707963267948966i))"
  assert cok(log10(cb(0x000012688B70E62B, 0x0000000000000000)), 0xC073600000000000, 0x0000000000000000), "log10((1e-310+0i))"
  assert cok(log10(cb(0x000012688B70E62B, 0x8000000000000000)), 0xC073600000000000, 0x8000000000000000), "log10((1e-310-0i))"
  assert cok(log10(cb(0x000012688B70E62B, 0x3FF0000000000000)), 0x0000000000000000, 0x3FE5D47C4CB2FBA0), "log10((1e-310+1i))"
  assert cok(log10(cb(0x000012688B70E62B, 0xBFF0000000000000)), 0x0000000000000000, 0xBFE5D47C4CB2FBA0), "log10((1e-310-1i))"
  assert cok(log10(cb(0x000012688B70E62B, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FE5D47C4CB2FBA0), "log10((1e-310+Infi))"
  assert cok(log10(cb(0x000012688B70E62B, 0xFFF0000000000000)), 0x7FF0000000000000, 0xBFE5D47C4CB2FBA0), "log10((1e-310-Infi))"
  assert cok(log10(cb(0x000012688B70E62B, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "log10((1e-310+NaNi))"
  assert cok(log10(cb(0x000012688B70E62B, 0x3FE0000000000000)), 0xBFD34413509F79FF, 0x3FE5D47C4CB2FBA0), "log10((1e-310+0.5i))"
  assert cok(log10(cb(0x000012688B70E62B, 0xC000000000000000)), 0x3FD34413509F79FF, 0xBFE5D47C4CB2FBA0), "log10((1e-310-2i))"
  assert cok(log10(cb(0x000012688B70E62B, 0x000012688B70E62B)), 0xC0735D977D95EC11, 0x3FD5D47C4CB2FBA0), "log10((1e-310+1e-310i))"
  assert cok(log10(cb(0x000012688B70E62B, 0x7E37E43C8800759C)), 0x4072C00000000000, 0x3FE5D47C4CB2FBA0), "log10((1e-310+1e+300i))"
  assert cok(log10(cb(0x000012688B70E62B, 0x3FF921FB54442D18)), 0x3FC91A74C4F85377, 0x3FE5D47C4CB2FBA0), "log10((1e-310+1.5707963267948966i))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0x0000000000000000)), 0x4072C00000000000, 0x0000000000000000), "log10((1e+300+0i))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0x8000000000000000)), 0x4072C00000000000, 0x8000000000000000), "log10((1e+300-0i))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0x3FF0000000000000)), 0x4072C00000000000, 0x01929D2FD3734F0B), "log10((1e+300+1i))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0xBFF0000000000000)), 0x4072C00000000000, 0x81929D2FD3734F0B), "log10((1e+300-1i))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FE5D47C4CB2FBA0), "log10((1e+300+Infi))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0xFFF0000000000000)), 0x7FF0000000000000, 0xBFE5D47C4CB2FBA0), "log10((1e+300-Infi))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "log10((1e+300+NaNi))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0x3FE0000000000000)), 0x4072C00000000000, 0x01829D2FD3734F0B), "log10((1e+300+0.5i))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0xC000000000000000)), 0x4072C00000000000, 0x81A29D2FD3734F0B), "log10((1e+300-2i))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0x000012688B70E62B)), 0x4072C00000000000, 0x0000000000000000), "log10((1e+300+1e-310i))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0x7E37E43C8800759C)), 0x4072C268826A13EF, 0x3FD5D47C4CB2FBA0), "log10((1e+300+1e+300i))"
  assert cok(log10(cb(0x7E37E43C8800759C, 0x3FF921FB54442D18)), 0x4072C00000000000, 0x019D3D2350EF1A0C), "log10((1e+300+1.5707963267948966i))"
  assert cok(log10(cb(0x3FF921FB54442D18, 0x0000000000000000)), 0x3FC91A74C4F85377, 0x0000000000000000), "log10((1.5707963267948966+0i))"
  assert cok(log10(cb(0x3FF921FB54442D18, 0x8000000000000000)), 0x3FC91A74C4F85377, 0x8000000000000000), "log10((1.5707963267948966-0i))"
  assert cok(log10(cb(0x3FF921FB54442D18, 0x3FF0000000000000)), 0x3FD147B6A4576417, 0x3FCF83B223147FDF), "log10((1.5707963267948966+1i))"
  assert cok(log10(cb(0x3FF921FB54442D18, 0xBFF0000000000000)), 0x3FD147B6A4576417, 0xBFCF83B223147FDF), "log10((1.5707963267948966-1i))"
  assert cok(log10(cb(0x3FF921FB54442D18, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FE5D47C4CB2FBA0), "log10((1.5707963267948966+Infi))"
