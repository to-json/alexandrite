  assert cok(asin(cb(0xBFF0000000000000, 0xC000000000000000)), 0xBFDB55416C582A87, 0xBFF87506C7CC99BF), "asin((-1-2i))"
  assert cok(asin(cb(0xBFF0000000000000, 0x000012688B70E62B)), 0xBFF921FB54442D18, 0x8000000000000000), "asin((-1+1e-310i))"
