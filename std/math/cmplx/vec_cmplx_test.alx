test "asinh 3" {
  assert cok(asinh(cb(0xBFC4D03297FC2C30, 0xBFE696DE924495D8)), 0xBFCC797C4CEA7630, 0xBFE850943360430D), "asinh((-0.16260368748803122-0.7059166771693368i))"
  assert cok(asinh(cb(0xBFD243B5D337796C, 0x3FC4CB17DB74B0C4)), 0xBFD23E3639DD87DC, 0x3FC40EEA34442ADC), "asinh((-0.28538270594244497+0.16244791236511535i))"
