  assert cok(acosh(cb(0x3FF921FB54442D18, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0xBFF921FB54442D18), "acosh((1.5707963267948966+1e+300i))"
  assert cok(acosh(cb(0x3FF921FB54442D18, 0x3FF921FB54442D18)), 0x3FF7EBEAAD34A671, 0x3FEABD829738879D), "acosh((1.5707963267948966+1.5707963267948966i))"
