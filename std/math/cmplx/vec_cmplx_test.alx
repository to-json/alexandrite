  assert cok(asin(cb(0x3FF0000000000000, 0xC000000000000000)), 0x3FDB55416C582A87, 0xBFF87506C7CC99BF), "asin((1-2i))"
  assert cok(asin(cb(0x3FF0000000000000, 0x000012688B70E62B)), 0x3FF921FB54442D18, 0x8000000000000000), "asin((1+1e-310i))"
  assert cok(asin(cb(0x3FF0000000000000, 0x7E37E43C8800759C)), 0x0000000000000000, 0xFFF0000000000000), "asin((1+1e+300i))"
  assert cok(asin(cb(0x3FF0000000000000, 0x3FF921FB54442D18)), 0x3FE03EF5FE25918A, 0x3FF59674AAA3CCA1), "asin((1+1.5707963267948966i))"
  assert cok(asin(cb(0xBFF0000000000000, 0x0000000000000000)), 0xBFF921FB54442D18, 0x0000000000000000), "asin((-1+0i))"
  assert cok(asin(cb(0xBFF0000000000000, 0x8000000000000000)), 0xBFF921FB54442D18, 0x8000000000000000), "asin((-1-0i))"
