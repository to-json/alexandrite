  assert cok(conj(cb(0x7FF8000000000001, 0x7E37E43C8800759C)), NAN_BITS, 0xFE37E43C8800759C), "conj((NaN+1e+300i))"
  assert cok(conj(cb(0x7FF8000000000001, 0x3FF921FB54442D18)), NAN_BITS, 0xBFF921FB54442D18), "conj((NaN+1.5707963267948966i))"
  assert cok(conj(cb(0x3FE0000000000000, 0x0000000000000000)), 0x3FE0000000000000, 0x8000000000000000), "conj((0.5+0i))"
  assert cok(conj(cb(0x3FE0000000000000, 0x8000000000000000)), 0x3FE0000000000000, 0x0000000000000000), "conj((0.5-0i))"
  assert cok(conj(cb(0x3FE0000000000000, 0x3FF0000000000000)), 0x3FE0000000000000, 0xBFF0000000000000), "conj((0.5+1i))"
  assert cok(conj(cb(0x3FE0000000000000, 0xBFF0000000000000)), 0x3FE0000000000000, 0x3FF0000000000000), "conj((0.5-1i))"
  assert cok(conj(cb(0x3FE0000000000000, 0x7FF0000000000000)), 0x3FE0000000000000, 0xFFF0000000000000), "conj((0.5+Infi))"
  assert cok(conj(cb(0x3FE0000000000000, 0xFFF0000000000000)), 0x3FE0000000000000, 0x7FF0000000000000), "conj((0.5-Infi))"
