  assert cok(cos(cb(0xBFC4D03297FC2C30, 0xBFE696DE924495D8)), 0x3FF3E3960D0CD246, 0xBFBFBF1FDB57F864), "cos((-0.16260368748803122-0.7059166771693368i))"
