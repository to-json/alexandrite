test "log10 1" {
  assert cok(log10(cb(0x0000000000000000, 0x0000000000000000)), 0xFFF0000000000000, 0x0000000000000000), "log10((0+0i))"
  assert cok(log10(cb(0x0000000000000000, 0x8000000000000000)), 0xFFF0000000000000, 0x8000000000000000), "log10((0-0i))"
  assert cok(log10(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FE5D47C4CB2FBA0), "log10((0+1i))"
