  assert cok(atan(cb(0xC000000000000000, 0x3FF0000000000000)), 0xBFF2D97C7F3321D2, 0x3FC62E42FEFA39EF), "atan((-2+1i))"
  assert cok(atan(cb(0xC000000000000000, 0xBFF0000000000000)), 0xBFF2D97C7F3321D2, 0xBFC62E42FEFA39EF), "atan((-2-1i))"
}

