test "sqrt 3" {
  assert cok(sqrt(cb(0xBFC4D03297FC2C30, 0xBFE696DE924495D8)), 0x3FE0F5C0EDED4CED, 0xBFE54F8B91ACC7F2), "sqrt((-0.16260368748803122-0.7059166771693368i))"
  assert cok(sqrt(cb(0xBFD243B5D337796C, 0x3FC4CB17DB74B0C4)), 0x3FC2C48302BFCE6B, 0x3FE1BA1B759513A2), "sqrt((-0.28538270594244497+0.16244791236511535i))"
  assert cok(sqrt(cb(0xBFFBA730F579C1B2, 0x3FD277A756CDDEF8)), 0x3FBBFF7988793C64, 0x3FF51B6DC092AF4E), "sqrt((-1.7283181752101027+0.2885530803391556i))"
  assert cok(sqrt(cb(0xBF8738FEB2BC759E, 0xC030B9BF8C06766C)), 0x4007207FC4F820C4, 0xC0072483A859BC77), "sqrt((-0.011339177922816298-16.725579024865894i))"
}

test "exp 1" {
  assert cok(exp(cb(0x0000000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "exp((0+0i))"
  assert cok(exp(cb(0x0000000000000000, 0x8000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "exp((0-0i))"
  assert cok(exp(cb(0x0000000000000000, 0x3FF0000000000000)), 0x3FE14A280FB5068C, 0x3FEAED548F090CEE), "exp((0+1i))"
  assert cok(exp(cb(0x0000000000000000, 0xBFF0000000000000)), 0x3FE14A280FB5068C, 0xBFEAED548F090CEE), "exp((0-1i))"
  assert cok(exp(cb(0x0000000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "exp((0+Infi))"
  assert cok(exp(cb(0x0000000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "exp((0-Infi))"
  assert cok(exp(cb(0x0000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "exp((0+NaNi))"
  assert cok(exp(cb(0x0000000000000000, 0x3FE0000000000000)), 0x3FEC1528065B7D50, 0x3FDEAEE8744B05F0), "exp((0+0.5i))"
  assert cok(exp(cb(0x0000000000000000, 0xC000000000000000)), 0xBFDAA22657537205, 0xBFED18F6EAD1B445), "exp((0-2i))"
  assert cok(exp(cb(0x0000000000000000, 0x000012688B70E62B)), 0x3FF0000000000000, 0x000012688B70E62B), "exp((0+1e-310i))"
  assert cok(exp(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0xBFE2699022ADC4C1, 0xBFEA2C16B010E386), "exp((0+1e+300i))"
  assert cok(exp(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x3C91A62633145C00, 0x3FF0000000000000), "exp((0+1.5707963267948966i))"
  assert cok(exp(cb(0x8000000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "exp((-0+0i))"
  assert cok(exp(cb(0x8000000000000000, 0x8000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "exp((-0-0i))"
  assert cok(exp(cb(0x8000000000000000, 0x3FF0000000000000)), 0x3FE14A280FB5068C, 0x3FEAED548F090CEE), "exp((-0+1i))"
  assert cok(exp(cb(0x8000000000000000, 0xBFF0000000000000)), 0x3FE14A280FB5068C, 0xBFEAED548F090CEE), "exp((-0-1i))"
  assert cok(exp(cb(0x8000000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "exp((-0+Infi))"
  assert cok(exp(cb(0x8000000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "exp((-0-Infi))"
  assert cok(exp(cb(0x8000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "exp((-0+NaNi))"
  assert cok(exp(cb(0x8000000000000000, 0x3FE0000000000000)), 0x3FEC1528065B7D50, 0x3FDEAEE8744B05F0), "exp((-0+0.5i))"
  assert cok(exp(cb(0x8000000000000000, 0xC000000000000000)), 0xBFDAA22657537205, 0xBFED18F6EAD1B445), "exp((-0-2i))"
  assert cok(exp(cb(0x8000000000000000, 0x000012688B70E62B)), 0x3FF0000000000000, 0x000012688B70E62B), "exp((-0+1e-310i))"
  assert cok(exp(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0xBFE2699022ADC4C1, 0xBFEA2C16B010E386), "exp((-0+1e+300i))"
  assert cok(exp(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x3C91A62633145C00, 0x3FF0000000000000), "exp((-0+1.5707963267948966i))"
  assert cok(exp(cb(0x3FF0000000000000, 0x0000000000000000)), 0x4005BF0A8B145769, 0x0000000000000000), "exp((1+0i))"
  assert cok(exp(cb(0x3FF0000000000000, 0x8000000000000000)), 0x4005BF0A8B145769, 0x8000000000000000), "exp((1-0i))"
  assert cok(exp(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FF77FC5377C5A96, 0x40024C80EDC62064), "exp((1+1i))"
  assert cok(exp(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FF77FC5377C5A96, 0xC0024C80EDC62064), "exp((1-1i))"
  assert cok(exp(cb(0x3FF0000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "exp((1+Infi))"
  assert cok(exp(cb(0x3FF0000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "exp((1-Infi))"
  assert cok(exp(cb(0x3FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "exp((1+NaNi))"
  assert cok(exp(cb(0x3FF0000000000000, 0x3FE0000000000000)), 0x40031589CBBC3E17, 0x3FF4D9F6A3CB42E3), "exp((1+0.5i))"
  assert cok(exp(cb(0x3FF0000000000000, 0xC000000000000000)), 0xBFF21969C4953CD1, 0xC003C618A2274AFC), "exp((1-2i))"
  assert cok(exp(cb(0x3FF0000000000000, 0x000012688B70E62B)), 0x4005BF0A8B145769, 0x0000320A064C393B), "exp((1+1e-310i))"
  assert cok(exp(cb(0x3FF0000000000000, 0x7E37E43C8800759C)), 0xBFF9066578289EFF, 0xC001C92EAA7D36BC), "exp((1+1e+300i))"
  assert cok(exp(cb(0x3FF0000000000000, 0x3FF921FB54442D18)), 0x3CA7FCCD2C4E37AE, 0x4005BF0A8B145769), "exp((1+1.5707963267948966i))"
  assert cok(exp(cb(0xBFF0000000000000, 0x0000000000000000)), 0x3FD78B56362CEF38, 0x0000000000000000), "exp((-1+0i))"
  assert cok(exp(cb(0xBFF0000000000000, 0x8000000000000000)), 0x3FD78B56362CEF38, 0x8000000000000000), "exp((-1-0i))"
  assert cok(exp(cb(0xBFF0000000000000, 0x3FF0000000000000)), 0x3FC9712AFBBED823, 0x3FD3CFD439855F55), "exp((-1+1i))"
  assert cok(exp(cb(0xBFF0000000000000, 0xBFF0000000000000)), 0x3FC9712AFBBED823, 0xBFD3CFD439855F55), "exp((-1-1i))"
  assert cok(exp(cb(0xBFF0000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "exp((-1+Infi))"
  assert cok(exp(cb(0xBFF0000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "exp((-1-Infi))"
  assert cok(exp(cb(0xBFF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "exp((-1+NaNi))"
  assert cok(exp(cb(0xBFF0000000000000, 0x3FE0000000000000)), 0x3FD4A97C52D41321, 0x3FC693517F5208D4), "exp((-1+0.5i))"
  assert cok(exp(cb(0xBFF0000000000000, 0xC000000000000000)), 0xBFC39883A62D5DDD, 0xBFD568A44DAD4C11), "exp((-1-2i))"
  assert cok(exp(cb(0xBFF0000000000000, 0x000012688B70E62B)), 0x3FD78B56362CEF38, 0x000006C5A5F77C6D), "exp((-1+1e-310i))"
  assert cok(exp(cb(0xBFF0000000000000, 0x7E37E43C8800759C)), 0xBFCB18177BC5C6E3, 0xBFD341A653E50CA1), "exp((-1+1e+300i))"
  assert cok(exp(cb(0xBFF0000000000000, 0x3FF921FB54442D18)), 0x3C79F8896E18A962, 0x3FD78B56362CEF38), "exp((-1+1.5707963267948966i))"
