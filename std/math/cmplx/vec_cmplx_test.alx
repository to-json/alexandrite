  assert cok(asinh(cb(0xBFF0000000000000, 0xBFF0000000000000)), 0xBFF0FAFB8F2F147E, 0xBFE551D55BBB8CED), "asinh((-1-1i))"
  assert cok(asinh(cb(0xBFF0000000000000, 0x7FF0000000000000)), 0xFFF0000000000000, 0x3FF921FB54442D18), "asinh((-1+Infi))"
