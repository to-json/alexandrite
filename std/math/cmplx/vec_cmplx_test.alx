}

test "tan 1" {
  assert cok(tan(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "tan((0+0i))"
  assert cok(tan(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "tan((0-0i))"
  assert cok(tan(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FE85EFAB514F395), "tan((0+1i))"
  assert cok(tan(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xBFE85EFAB514F395), "tan((0-1i))"
  assert cok(tan(cb(0x0000000000000000, 0x7FF0000000000000)), 0x0000000000000000, 0x3FF0000000000000), "tan((0+Infi))"
  assert cok(tan(cb(0x0000000000000000, 0xFFF0000000000000)), 0x0000000000000000, 0xBFF0000000000000), "tan((0-Infi))"
