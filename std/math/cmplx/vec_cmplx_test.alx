  assert cok(cos(cb(0xBFF0000000000000, 0xC000000000000000)), 0x4000430447A7CF58, 0xC0086A4964B0BB19), "cos((-1-2i))"
  assert cok(cos(cb(0xBFF0000000000000, 0x000012688B70E62B)), 0x3FE14A280FB5068C, 0x00000F7D78392D98), "cos((-1+1e-310i))"
  assert cok(cos(cb(0xBFF0000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0x7FF0000000000000), "cos((-1+1e+300i))"
  assert cok(cos(cb(0xBFF0000000000000, 0x3FF921FB54442D18)), 0x3FF5B102202E17B9, 0x3FFEFBCE862F54FC), "cos((-1+1.5707963267948966i))"
  assert cok(cos(cb(0x7FF0000000000000, 0x0000000000000000)), NAN_BITS, 0x8000000000000000), "cos((+Inf+0i))"
