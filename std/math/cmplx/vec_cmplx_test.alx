test "cosh 2" {
  assert cok(cosh(cb(0xC000000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "cosh((-2+Infi))"
  assert cok(cosh(cb(0xC000000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "cosh((-2-Infi))"
  assert cok(cosh(cb(0xC000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "cosh((-2+NaNi))"
