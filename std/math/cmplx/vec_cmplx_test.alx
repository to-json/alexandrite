test "conj 1" {
  assert cok(conj(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x8000000000000000), "conj((0+0i))"
  assert cok(conj(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x0000000000000000), "conj((0-0i))"
  assert cok(conj(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0xBFF0000000000000), "conj((0+1i))"
  assert cok(conj(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0x3FF0000000000000), "conj((0-1i))"
  assert cok(conj(cb(0x0000000000000000, 0x7FF0000000000000)), 0x0000000000000000, 0xFFF0000000000000), "conj((0+Infi))"
  assert cok(conj(cb(0x0000000000000000, 0xFFF0000000000000)), 0x0000000000000000, 0x7FF0000000000000), "conj((0-Infi))"
  assert cok(conj(cb(0x0000000000000000, 0x7FF8000000000001)), 0x0000000000000000, NAN_BITS), "conj((0+NaNi))"
  assert cok(conj(cb(0x0000000000000000, 0x3FE0000000000000)), 0x0000000000000000, 0xBFE0000000000000), "conj((0+0.5i))"
  assert cok(conj(cb(0x0000000000000000, 0xC000000000000000)), 0x0000000000000000, 0x4000000000000000), "conj((0-2i))"
  assert cok(conj(cb(0x0000000000000000, 0x000012688B70E62B)), 0x0000000000000000, 0x800012688B70E62B), "conj((0+1e-310i))"
  assert cok(conj(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x0000000000000000, 0xFE37E43C8800759C), "conj((0+1e+300i))"
  assert cok(conj(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x0000000000000000, 0xBFF921FB54442D18), "conj((0+1.5707963267948966i))"
  assert cok(conj(cb(0x8000000000000000, 0x0000000000000000)), 0x8000000000000000, 0x8000000000000000), "conj((-0+0i))"
  assert cok(conj(cb(0x8000000000000000, 0x8000000000000000)), 0x8000000000000000, 0x0000000000000000), "conj((-0-0i))"
  assert cok(conj(cb(0x8000000000000000, 0x3FF0000000000000)), 0x8000000000000000, 0xBFF0000000000000), "conj((-0+1i))"
  assert cok(conj(cb(0x8000000000000000, 0xBFF0000000000000)), 0x8000000000000000, 0x3FF0000000000000), "conj((-0-1i))"
  assert cok(conj(cb(0x8000000000000000, 0x7FF0000000000000)), 0x8000000000000000, 0xFFF0000000000000), "conj((-0+Infi))"
  assert cok(conj(cb(0x8000000000000000, 0xFFF0000000000000)), 0x8000000000000000, 0x7FF0000000000000), "conj((-0-Infi))"
  assert cok(conj(cb(0x8000000000000000, 0x7FF8000000000001)), 0x8000000000000000, NAN_BITS), "conj((-0+NaNi))"
  assert cok(conj(cb(0x8000000000000000, 0x3FE0000000000000)), 0x8000000000000000, 0xBFE0000000000000), "conj((-0+0.5i))"
  assert cok(conj(cb(0x8000000000000000, 0xC000000000000000)), 0x8000000000000000, 0x4000000000000000), "conj((-0-2i))"
  assert cok(conj(cb(0x8000000000000000, 0x000012688B70E62B)), 0x8000000000000000, 0x800012688B70E62B), "conj((-0+1e-310i))"
  assert cok(conj(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0x8000000000000000, 0xFE37E43C8800759C), "conj((-0+1e+300i))"
  assert cok(conj(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x8000000000000000, 0xBFF921FB54442D18), "conj((-0+1.5707963267948966i))"
  assert cok(conj(cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "conj((1+0i))"
  assert cok(conj(cb(0x3FF0000000000000, 0x8000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "conj((1-0i))"
  assert cok(conj(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FF0000000000000, 0xBFF0000000000000), "conj((1+1i))"
  assert cok(conj(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FF0000000000000, 0x3FF0000000000000), "conj((1-1i))"
  assert cok(conj(cb(0x3FF0000000000000, 0x7FF0000000000000)), 0x3FF0000000000000, 0xFFF0000000000000), "conj((1+Infi))"
  assert cok(conj(cb(0x3FF0000000000000, 0xFFF0000000000000)), 0x3FF0000000000000, 0x7FF0000000000000), "conj((1-Infi))"
  assert cok(conj(cb(0x3FF0000000000000, 0x7FF8000000000001)), 0x3FF0000000000000, NAN_BITS), "conj((1+NaNi))"
  assert cok(conj(cb(0x3FF0000000000000, 0x3FE0000000000000)), 0x3FF0000000000000, 0xBFE0000000000000), "conj((1+0.5i))"
  assert cok(conj(cb(0x3FF0000000000000, 0xC000000000000000)), 0x3FF0000000000000, 0x4000000000000000), "conj((1-2i))"
  assert cok(conj(cb(0x3FF0000000000000, 0x000012688B70E62B)), 0x3FF0000000000000, 0x800012688B70E62B), "conj((1+1e-310i))"
  assert cok(conj(cb(0x3FF0000000000000, 0x7E37E43C8800759C)), 0x3FF0000000000000, 0xFE37E43C8800759C), "conj((1+1e+300i))"
  assert cok(conj(cb(0x3FF0000000000000, 0x3FF921FB54442D18)), 0x3FF0000000000000, 0xBFF921FB54442D18), "conj((1+1.5707963267948966i))"
  assert cok(conj(cb(0xBFF0000000000000, 0x0000000000000000)), 0xBFF0000000000000, 0x8000000000000000), "conj((-1+0i))"
  assert cok(conj(cb(0xBFF0000000000000, 0x8000000000000000)), 0xBFF0000000000000, 0x0000000000000000), "conj((-1-0i))"
  assert cok(conj(cb(0xBFF0000000000000, 0x3FF0000000000000)), 0xBFF0000000000000, 0xBFF0000000000000), "conj((-1+1i))"
  assert cok(conj(cb(0xBFF0000000000000, 0xBFF0000000000000)), 0xBFF0000000000000, 0x3FF0000000000000), "conj((-1-1i))"
  assert cok(conj(cb(0xBFF0000000000000, 0x7FF0000000000000)), 0xBFF0000000000000, 0xFFF0000000000000), "conj((-1+Infi))"
  assert cok(conj(cb(0xBFF0000000000000, 0xFFF0000000000000)), 0xBFF0000000000000, 0x7FF0000000000000), "conj((-1-Infi))"
  assert cok(conj(cb(0xBFF0000000000000, 0x7FF8000000000001)), 0xBFF0000000000000, NAN_BITS), "conj((-1+NaNi))"
  assert cok(conj(cb(0xBFF0000000000000, 0x3FE0000000000000)), 0xBFF0000000000000, 0xBFE0000000000000), "conj((-1+0.5i))"
  assert cok(conj(cb(0xBFF0000000000000, 0xC000000000000000)), 0xBFF0000000000000, 0x4000000000000000), "conj((-1-2i))"
  assert cok(conj(cb(0xBFF0000000000000, 0x000012688B70E62B)), 0xBFF0000000000000, 0x800012688B70E62B), "conj((-1+1e-310i))"
  assert cok(conj(cb(0xBFF0000000000000, 0x7E37E43C8800759C)), 0xBFF0000000000000, 0xFE37E43C8800759C), "conj((-1+1e+300i))"
  assert cok(conj(cb(0xBFF0000000000000, 0x3FF921FB54442D18)), 0xBFF0000000000000, 0xBFF921FB54442D18), "conj((-1+1.5707963267948966i))"
  assert cok(conj(cb(0x7FF0000000000000, 0x0000000000000000)), 0x7FF0000000000000, 0x8000000000000000), "conj((+Inf+0i))"
  assert cok(conj(cb(0x7FF0000000000000, 0x8000000000000000)), 0x7FF0000000000000, 0x0000000000000000), "conj((+Inf-0i))"
  assert cok(conj(cb(0x7FF0000000000000, 0x3FF0000000000000)), 0x7FF0000000000000, 0xBFF0000000000000), "conj((+Inf+1i))"
  assert cok(conj(cb(0x7FF0000000000000, 0xBFF0000000000000)), 0x7FF0000000000000, 0x3FF0000000000000), "conj((+Inf-1i))"
  assert cok(conj(cb(0x7FF0000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "conj((+Inf+Infi))"
  assert cok(conj(cb(0x7FF0000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "conj((+Inf-Infi))"
  assert cok(conj(cb(0x7FF0000000000000, 0x7FF8000000000001)), 0x7FF0000000000000, NAN_BITS), "conj((+Inf+NaNi))"
  assert cok(conj(cb(0x7FF0000000000000, 0x3FE0000000000000)), 0x7FF0000000000000, 0xBFE0000000000000), "conj((+Inf+0.5i))"
  assert cok(conj(cb(0x7FF0000000000000, 0xC000000000000000)), 0x7FF0000000000000, 0x4000000000000000), "conj((+Inf-2i))"
  assert cok(conj(cb(0x7FF0000000000000, 0x000012688B70E62B)), 0x7FF0000000000000, 0x800012688B70E62B), "conj((+Inf+1e-310i))"
  assert cok(conj(cb(0x7FF0000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0xFE37E43C8800759C), "conj((+Inf+1e+300i))"
  assert cok(conj(cb(0x7FF0000000000000, 0x3FF921FB54442D18)), 0x7FF0000000000000, 0xBFF921FB54442D18), "conj((+Inf+1.5707963267948966i))"
  assert cok(conj(cb(0xFFF0000000000000, 0x0000000000000000)), 0xFFF0000000000000, 0x8000000000000000), "conj((-Inf+0i))"
  assert cok(conj(cb(0xFFF0000000000000, 0x8000000000000000)), 0xFFF0000000000000, 0x0000000000000000), "conj((-Inf-0i))"
  assert cok(conj(cb(0xFFF0000000000000, 0x3FF0000000000000)), 0xFFF0000000000000, 0xBFF0000000000000), "conj((-Inf+1i))"
  assert cok(conj(cb(0xFFF0000000000000, 0xBFF0000000000000)), 0xFFF0000000000000, 0x3FF0000000000000), "conj((-Inf-1i))"
  assert cok(conj(cb(0xFFF0000000000000, 0x7FF0000000000000)), 0xFFF0000000000000, 0xFFF0000000000000), "conj((-Inf+Infi))"
  assert cok(conj(cb(0xFFF0000000000000, 0xFFF0000000000000)), 0xFFF0000000000000, 0x7FF0000000000000), "conj((-Inf-Infi))"
  assert cok(conj(cb(0xFFF0000000000000, 0x7FF8000000000001)), 0xFFF0000000000000, NAN_BITS), "conj((-Inf+NaNi))"
  assert cok(conj(cb(0xFFF0000000000000, 0x3FE0000000000000)), 0xFFF0000000000000, 0xBFE0000000000000), "conj((-Inf+0.5i))"
  assert cok(conj(cb(0xFFF0000000000000, 0xC000000000000000)), 0xFFF0000000000000, 0x4000000000000000), "conj((-Inf-2i))"
  assert cok(conj(cb(0xFFF0000000000000, 0x000012688B70E62B)), 0xFFF0000000000000, 0x800012688B70E62B), "conj((-Inf+1e-310i))"
  assert cok(conj(cb(0xFFF0000000000000, 0x7E37E43C8800759C)), 0xFFF0000000000000, 0xFE37E43C8800759C), "conj((-Inf+1e+300i))"
  assert cok(conj(cb(0xFFF0000000000000, 0x3FF921FB54442D18)), 0xFFF0000000000000, 0xBFF921FB54442D18), "conj((-Inf+1.5707963267948966i))"
  assert cok(conj(cb(0x7FF8000000000001, 0x0000000000000000)), NAN_BITS, 0x8000000000000000), "conj((NaN+0i))"
  assert cok(conj(cb(0x7FF8000000000001, 0x8000000000000000)), NAN_BITS, 0x0000000000000000), "conj((NaN-0i))"
  assert cok(conj(cb(0x7FF8000000000001, 0x3FF0000000000000)), NAN_BITS, 0xBFF0000000000000), "conj((NaN+1i))"
  assert cok(conj(cb(0x7FF8000000000001, 0xBFF0000000000000)), NAN_BITS, 0x3FF0000000000000), "conj((NaN-1i))"
  assert cok(conj(cb(0x7FF8000000000001, 0x7FF0000000000000)), NAN_BITS, 0xFFF0000000000000), "conj((NaN+Infi))"
  assert cok(conj(cb(0x7FF8000000000001, 0xFFF0000000000000)), NAN_BITS, 0x7FF0000000000000), "conj((NaN-Infi))"
  assert cok(conj(cb(0x7FF8000000000001, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "conj((NaN+NaNi))"
  assert cok(conj(cb(0x7FF8000000000001, 0x3FE0000000000000)), NAN_BITS, 0xBFE0000000000000), "conj((NaN+0.5i))"
  assert cok(conj(cb(0x7FF8000000000001, 0xC000000000000000)), NAN_BITS, 0x4000000000000000), "conj((NaN-2i))"
