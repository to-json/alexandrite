  assert cok(sqrt(cb(0x7FF0000000000000, 0x3FE0000000000000)), 0x7FF0000000000000, 0x0000000000000000), "sqrt((+Inf+0.5i))"
  assert cok(sqrt(cb(0x7FF0000000000000, 0xC000000000000000)), 0x7FF0000000000000, 0x8000000000000000), "sqrt((+Inf-2i))"
  assert cok(sqrt(cb(0x7FF0000000000000, 0x000012688B70E62B)), 0x7FF0000000000000, 0x0000000000000000), "sqrt((+Inf+1e-310i))"
  assert cok(sqrt(cb(0x7FF0000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0x0000000000000000), "sqrt((+Inf+1e+300i))"
  assert cok(sqrt(cb(0x7FF0000000000000, 0x3FF921FB54442D18)), 0x7FF0000000000000, 0x0000000000000000), "sqrt((+Inf+1.5707963267948966i))"
  assert cok(sqrt(cb(0xFFF0000000000000, 0x0000000000000000)), 0x0000000000000000, 0x7FF0000000000000), "sqrt((-Inf+0i))"
  assert cok(sqrt(cb(0xFFF0000000000000, 0x8000000000000000)), 0x0000000000000000, 0xFFF0000000000000), "sqrt((-Inf-0i))"
  assert cok(sqrt(cb(0xFFF0000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x7FF0000000000000), "sqrt((-Inf+1i))"
  assert cok(sqrt(cb(0xFFF0000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xFFF0000000000000), "sqrt((-Inf-1i))"
