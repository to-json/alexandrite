  assert cok(asinh(cb(0xBFF0000000000000, 0x000012688B70E62B)), 0xBFEC34366179D425, 0x00000D0445B5F9A7), "asinh((-1+1e-310i))"
  assert cok(asinh(cb(0xBFF0000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0xBFF921FB54442D18), "asinh((-1+1e+300i))"
  assert cok(asinh(cb(0xBFF0000000000000, 0x3FF921FB54442D18)), 0xBFF4A60F786048CE, 0x3FEDDC6588E839B8), "asinh((-1+1.5707963267948966i))"
