test "cosh 3" {
  assert cok(cosh(cb(0xBFC4D03297FC2C30, 0xBFE696DE924495D8)), 0x3FE8ACD9EED1E973, 0x3FBB1FA54ADD5A54), "cosh((-0.16260368748803122-0.7059166771693368i))"
  assert cok(cosh(cb(0xBFD243B5D337796C, 0x3FC4CB17DB74B0C4)), 0x3FF06FCB1FCED2E5, 0xBFA7F43D16D9E7B5), "cosh((-0.28538270594244497+0.16244791236511535i))"
  assert cok(cosh(cb(0xBFFBA730F579C1B2, 0x3FD277A756CDDEF8)), 0x400646403D688DD0, 0xBFE8D49922EE957B), "cosh((-1.7283181752101027+0.2885530803391556i))"
  assert cok(cosh(cb(0xBF8738FEB2BC759E, 0xC030B9BF8C06766C)), 0xBFE0D0524E68B1D3, 0xBF83C274195515B4), "cosh((-0.011339177922816298-16.725579024865894i))"
}

test "tanh 1" {
  assert cok(tanh(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "tanh((0+0i))"
  assert cok(tanh(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "tanh((0-0i))"
  assert cok(tanh(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FF8EB245CBEE3A5), "tanh((0+1i))"
  assert cok(tanh(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xBFF8EB245CBEE3A5), "tanh((0-1i))"
  assert cok(tanh(cb(0x0000000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "tanh((0+Infi))"
  assert cok(tanh(cb(0x0000000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "tanh((0-Infi))"
  assert cok(tanh(cb(0x0000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "tanh((0+NaNi))"
  assert cok(tanh(cb(0x0000000000000000, 0x3FE0000000000000)), 0x0000000000000000, 0x3FE17B4F5BF3474A), "tanh((0+0.5i))"
  assert cok(tanh(cb(0x0000000000000000, 0xC000000000000000)), 0x0000000000000000, 0x40017AF62E0950F8), "tanh((0-2i))"
  assert cok(tanh(cb(0x0000000000000000, 0x000012688B70E62B)), 0x0000000000000000, 0x000012688B70E62B), "tanh((0+1e-310i))"
  assert cok(tanh(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x0000000000000000, 0x3FF6BE411F37AC76), "tanh((0+1e+300i))"
  assert cok(tanh(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x7FF0000000000000, 0x7FF0000000000000), "tanh((0+1.5707963267948966i))"
  assert cok(tanh(cb(0x8000000000000000, 0x0000000000000000)), 0x8000000000000000, 0x0000000000000000), "tanh((-0+0i))"
  assert cok(tanh(cb(0x8000000000000000, 0x8000000000000000)), 0x8000000000000000, 0x8000000000000000), "tanh((-0-0i))"
  assert cok(tanh(cb(0x8000000000000000, 0x3FF0000000000000)), 0x8000000000000000, 0x3FF8EB245CBEE3A5), "tanh((-0+1i))"
  assert cok(tanh(cb(0x8000000000000000, 0xBFF0000000000000)), 0x8000000000000000, 0xBFF8EB245CBEE3A5), "tanh((-0-1i))"
  assert cok(tanh(cb(0x8000000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "tanh((-0+Infi))"
  assert cok(tanh(cb(0x8000000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "tanh((-0-Infi))"
  assert cok(tanh(cb(0x8000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "tanh((-0+NaNi))"
  assert cok(tanh(cb(0x8000000000000000, 0x3FE0000000000000)), 0x8000000000000000, 0x3FE17B4F5BF3474A), "tanh((-0+0.5i))"
  assert cok(tanh(cb(0x8000000000000000, 0xC000000000000000)), 0x8000000000000000, 0x40017AF62E0950F8), "tanh((-0-2i))"
  assert cok(tanh(cb(0x8000000000000000, 0x000012688B70E62B)), 0x8000000000000000, 0x000012688B70E62B), "tanh((-0+1e-310i))"
  assert cok(tanh(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0x8000000000000000, 0x3FF6BE411F37AC76), "tanh((-0+1e+300i))"
  assert cok(tanh(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x7FF0000000000000, 0x7FF0000000000000), "tanh((-0+1.5707963267948966i))"
  assert cok(tanh(cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FE85EFAB514F395, 0x0000000000000000), "tanh((1+0i))"
  assert cok(tanh(cb(0x3FF0000000000000, 0x8000000000000000)), 0x3FE85EFAB514F395, 0x8000000000000000), "tanh((1-0i))"
  assert cok(tanh(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FF157BFFCA4A8BE, 0x3FD16464F4A33F87), "tanh((1+1i))"
  assert cok(tanh(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FF157BFFCA4A8BE, 0xBFD16464F4A33F87), "tanh((1-1i))"
  assert cok(tanh(cb(0x3FF0000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "tanh((1+Infi))"
  assert cok(tanh(cb(0x3FF0000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "tanh((1-Infi))"
  assert cok(tanh(cb(0x3FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "tanh((1+NaNi))"
  assert cok(tanh(cb(0x3FF0000000000000, 0x3FE0000000000000)), 0x3FEAF994432E449D, 0x3FC908AD634952C2), "tanh((1+0.5i))"
  assert cok(tanh(cb(0x3FF0000000000000, 0xC000000000000000)), 0x3FF2AAF3A33E83DE, 0x3FCF29A36A04911B), "tanh((1-2i))"
  assert cok(tanh(cb(0x3FF0000000000000, 0x000012688B70E62B)), 0x3FE85EFAB514F395, 0x000007BB25D9C481), "tanh((1+1e-310i))"
  assert cok(tanh(cb(0x3FF0000000000000, 0x7E37E43C8800759C)), 0x3FF0F2403A6A1925, 0x3FD19739FAEB016F), "tanh((1+1e+300i))"
  assert cok(tanh(cb(0x3FF0000000000000, 0x3FF921FB54442D18)), 0x3FF50231499B6B1E, 0x3C898ED656361E1D), "tanh((1+1.5707963267948966i))"
  assert cok(tanh(cb(0xBFF0000000000000, 0x0000000000000000)), 0xBFE85EFAB514F395, 0x0000000000000000), "tanh((-1+0i))"
  assert cok(tanh(cb(0xBFF0000000000000, 0x8000000000000000)), 0xBFE85EFAB514F395, 0x8000000000000000), "tanh((-1-0i))"
  assert cok(tanh(cb(0xBFF0000000000000, 0x3FF0000000000000)), 0xBFF157BFFCA4A8BE, 0x3FD16464F4A33F87), "tanh((-1+1i))"
  assert cok(tanh(cb(0xBFF0000000000000, 0xBFF0000000000000)), 0xBFF157BFFCA4A8BE, 0xBFD16464F4A33F87), "tanh((-1-1i))"
  assert cok(tanh(cb(0xBFF0000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "tanh((-1+Infi))"
  assert cok(tanh(cb(0xBFF0000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "tanh((-1-Infi))"
  assert cok(tanh(cb(0xBFF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "tanh((-1+NaNi))"
  assert cok(tanh(cb(0xBFF0000000000000, 0x3FE0000000000000)), 0xBFEAF994432E449D, 0x3FC908AD634952C2), "tanh((-1+0.5i))"
  assert cok(tanh(cb(0xBFF0000000000000, 0xC000000000000000)), 0xBFF2AAF3A33E83DE, 0x3FCF29A36A04911B), "tanh((-1-2i))"
  assert cok(tanh(cb(0xBFF0000000000000, 0x000012688B70E62B)), 0xBFE85EFAB514F395, 0x000007BB25D9C481), "tanh((-1+1e-310i))"
  assert cok(tanh(cb(0xBFF0000000000000, 0x7E37E43C8800759C)), 0xBFF0F2403A6A1925, 0x3FD19739FAEB016F), "tanh((-1+1e+300i))"
  assert cok(tanh(cb(0xBFF0000000000000, 0x3FF921FB54442D18)), 0xBFF50231499B6B1E, 0x3C898ED656361E1D), "tanh((-1+1.5707963267948966i))"
  assert cok(tanh(cb(0x7FF0000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "tanh((+Inf+0i))"
  assert cok(tanh(cb(0x7FF0000000000000, 0x8000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "tanh((+Inf-0i))"
  assert cok(tanh(cb(0x7FF0000000000000, 0x3FF0000000000000)), 0x3FF0000000000000, 0x0000000000000000), "tanh((+Inf+1i))"
  assert cok(tanh(cb(0x7FF0000000000000, 0xBFF0000000000000)), 0x3FF0000000000000, 0x8000000000000000), "tanh((+Inf-1i))"
  assert cok(tanh(cb(0x7FF0000000000000, 0x7FF0000000000000)), 0x3FF0000000000000, 0x0000000000000000), "tanh((+Inf+Infi))"
  assert cok(tanh(cb(0x7FF0000000000000, 0xFFF0000000000000)), 0x3FF0000000000000, 0x8000000000000000), "tanh((+Inf-Infi))"
  assert cok(tanh(cb(0x7FF0000000000000, 0x7FF8000000000001)), 0x3FF0000000000000, 0x0000000000000000), "tanh((+Inf+NaNi))"
  assert cok(tanh(cb(0x7FF0000000000000, 0x3FE0000000000000)), 0x3FF0000000000000, 0x0000000000000000), "tanh((+Inf+0.5i))"
  assert cok(tanh(cb(0x7FF0000000000000, 0xC000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "tanh((+Inf-2i))"
  assert cok(tanh(cb(0x7FF0000000000000, 0x000012688B70E62B)), 0x3FF0000000000000, 0x0000000000000000), "tanh((+Inf+1e-310i))"
  assert cok(tanh(cb(0x7FF0000000000000, 0x7E37E43C8800759C)), 0x3FF0000000000000, 0x0000000000000000), "tanh((+Inf+1e+300i))"
  assert cok(tanh(cb(0x7FF0000000000000, 0x3FF921FB54442D18)), 0x3FF0000000000000, 0x0000000000000000), "tanh((+Inf+1.5707963267948966i))"
  assert cok(tanh(cb(0xFFF0000000000000, 0x0000000000000000)), 0xBFF0000000000000, 0x0000000000000000), "tanh((-Inf+0i))"
  assert cok(tanh(cb(0xFFF0000000000000, 0x8000000000000000)), 0xBFF0000000000000, 0x8000000000000000), "tanh((-Inf-0i))"
  assert cok(tanh(cb(0xFFF0000000000000, 0x3FF0000000000000)), 0xBFF0000000000000, 0x0000000000000000), "tanh((-Inf+1i))"
  assert cok(tanh(cb(0xFFF0000000000000, 0xBFF0000000000000)), 0xBFF0000000000000, 0x8000000000000000), "tanh((-Inf-1i))"
  assert cok(tanh(cb(0xFFF0000000000000, 0x7FF0000000000000)), 0xBFF0000000000000, 0x0000000000000000), "tanh((-Inf+Infi))"
  assert cok(tanh(cb(0xFFF0000000000000, 0xFFF0000000000000)), 0xBFF0000000000000, 0x8000000000000000), "tanh((-Inf-Infi))"
  assert cok(tanh(cb(0xFFF0000000000000, 0x7FF8000000000001)), 0xBFF0000000000000, 0x0000000000000000), "tanh((-Inf+NaNi))"
  assert cok(tanh(cb(0xFFF0000000000000, 0x3FE0000000000000)), 0xBFF0000000000000, 0x0000000000000000), "tanh((-Inf+0.5i))"
  assert cok(tanh(cb(0xFFF0000000000000, 0xC000000000000000)), 0xBFF0000000000000, 0x0000000000000000), "tanh((-Inf-2i))"
  assert cok(tanh(cb(0xFFF0000000000000, 0x000012688B70E62B)), 0xBFF0000000000000, 0x0000000000000000), "tanh((-Inf+1e-310i))"
  assert cok(tanh(cb(0xFFF0000000000000, 0x7E37E43C8800759C)), 0xBFF0000000000000, 0x0000000000000000), "tanh((-Inf+1e+300i))"
  assert cok(tanh(cb(0xFFF0000000000000, 0x3FF921FB54442D18)), 0xBFF0000000000000, 0x0000000000000000), "tanh((-Inf+1.5707963267948966i))"
  assert cok(tanh(cb(0x7FF8000000000001, 0x0000000000000000)), NAN_BITS, 0x0000000000000000), "tanh((NaN+0i))"
  assert cok(tanh(cb(0x7FF8000000000001, 0x8000000000000000)), NAN_BITS, 0x8000000000000000), "tanh((NaN-0i))"
  assert cok(tanh(cb(0x7FF8000000000001, 0x3FF0000000000000)), NAN_BITS, NAN_BITS), "tanh((NaN+1i))"
  assert cok(tanh(cb(0x7FF8000000000001, 0xBFF0000000000000)), NAN_BITS, NAN_BITS), "tanh((NaN-1i))"
  assert cok(tanh(cb(0x7FF8000000000001, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "tanh((NaN+Infi))"
  assert cok(tanh(cb(0x7FF8000000000001, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "tanh((NaN-Infi))"
  assert cok(tanh(cb(0x7FF8000000000001, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "tanh((NaN+NaNi))"
  assert cok(tanh(cb(0x7FF8000000000001, 0x3FE0000000000000)), NAN_BITS, NAN_BITS), "tanh((NaN+0.5i))"
  assert cok(tanh(cb(0x7FF8000000000001, 0xC000000000000000)), NAN_BITS, NAN_BITS), "tanh((NaN-2i))"
  assert cok(tanh(cb(0x7FF8000000000001, 0x000012688B70E62B)), NAN_BITS, NAN_BITS), "tanh((NaN+1e-310i))"
  assert cok(tanh(cb(0x7FF8000000000001, 0x7E37E43C8800759C)), NAN_BITS, NAN_BITS), "tanh((NaN+1e+300i))"
  assert cok(tanh(cb(0x7FF8000000000001, 0x3FF921FB54442D18)), NAN_BITS, NAN_BITS), "tanh((NaN+1.5707963267948966i))"
