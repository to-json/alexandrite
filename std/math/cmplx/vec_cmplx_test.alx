  assert cok(sqrt(cb(0x3FE0000000000000, 0x8000000000000000)), 0x3FE6A09E667F3BCD, 0x8000000000000000), "sqrt((0.5-0i))"
  assert cok(sqrt(cb(0x3FE0000000000000, 0x3FF0000000000000)), 0x3FECC8532AF1B6FC, 0x3FE1C9E00DE9CC05), "sqrt((0.5+1i))"
