test "asinh 2" {
  assert cok(asinh(cb(0xC000000000000000, 0x7FF0000000000000)), 0xFFF0000000000000, 0x3FF921FB54442D18), "asinh((-2+Infi))"
  assert cok(asinh(cb(0xC000000000000000, 0xFFF0000000000000)), 0xFFF0000000000000, 0xBFF921FB54442D18), "asinh((-2-Infi))"
  assert cok(asinh(cb(0xC000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "asinh((-2+NaNi))"
  assert cok(asinh(cb(0xC000000000000000, 0x3FE0000000000000)), 0xBFF77391F0DDBD69, 0x3FCC4A56B1E7461B), "asinh((-2+0.5i))"
  assert cok(asinh(cb(0xC000000000000000, 0xC000000000000000)), 0xBFFBBFCB11C71116, 0xBFE822CF1A307359), "asinh((-2-2i))"
  assert cok(asinh(cb(0xC000000000000000, 0x000012688B70E62B)), 0xBFF719218313D085, 0x0000083B839922CA), "asinh((-2+1e-310i))"
  assert cok(asinh(cb(0xC000000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0xBFF921FB54442D18), "asinh((-2+1e+300i))"
  assert cok(asinh(cb(0xC000000000000000, 0x3FF921FB54442D18)), 0xBFFA3365F6C38A72, 0x3FE423E165B3B0F0), "asinh((-2+1.5707963267948966i))"
  assert cok(asinh(cb(0x000012688B70E62B, 0x0000000000000000)), 0x000012688B70E62B, 0x0000000000000000), "asinh((1e-310+0i))"
  assert cok(asinh(cb(0x000012688B70E62B, 0x8000000000000000)), 0x000012688B70E62B, 0x8000000000000000), "asinh((1e-310-0i))"
  assert cok(asinh(cb(0x000012688B70E62B, 0x3FF0000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "asinh((1e-310+1i))"
  assert cok(asinh(cb(0x000012688B70E62B, 0xBFF0000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "asinh((1e-310-1i))"
  assert cok(asinh(cb(0x000012688B70E62B, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FF921FB54442D18), "asinh((1e-310+Infi))"
  assert cok(asinh(cb(0x000012688B70E62B, 0xFFF0000000000000)), 0x7FF0000000000000, 0xBFF921FB54442D18), "asinh((1e-310-Infi))"
  assert cok(asinh(cb(0x000012688B70E62B, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "asinh((1e-310+NaNi))"
  assert cok(asinh(cb(0x000012688B70E62B, 0x3FE0000000000000)), 0x0000000000000000, 0x3FE0C152382D7366), "asinh((1e-310+0.5i))"
  assert cok(asinh(cb(0x000012688B70E62B, 0xC000000000000000)), 0x3FF5124271980434, 0xBFF921FB54442D18), "asinh((1e-310-2i))"
