  assert cok(tanh(cb(0xC000000000000000, 0xBFF0000000000000)), 0xBFF03C983B18A141, 0xBFA14FEA2C65A0C3), "tanh((-2-1i))"
}

test "tanh 2" {
  assert cok(tanh(cb(0xC000000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "tanh((-2+Infi))"
  assert cok(tanh(cb(0xC000000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "tanh((-2-Infi))"
