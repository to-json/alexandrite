}

test "acos 1" {
  assert cok(acos(cb(0x0000000000000000, 0x0000000000000000)), 0x3FF921FB54442D18, 0x8000000000000000), "acos((0+0i))"
  assert cok(acos(cb(0x0000000000000000, 0x8000000000000000)), 0x3FF921FB54442D18, 0x0000000000000000), "acos((0-0i))"
  assert cok(acos(cb(0x0000000000000000, 0x3FF0000000000000)), 0x3FF921FB54442D18, 0xBFEC34366179D427), "acos((0+1i))"
  assert cok(acos(cb(0x0000000000000000, 0xBFF0000000000000)), 0x3FF921FB54442D18, 0x3FEC34366179D427), "acos((0-1i))"
  assert cok(acos(cb(0x0000000000000000, 0x7FF0000000000000)), 0x3FF921FB54442D18, 0xFFF0000000000000), "acos((0+Infi))"
  assert cok(acos(cb(0x0000000000000000, 0xFFF0000000000000)), 0x3FF921FB54442D18, 0x7FF0000000000000), "acos((0-Infi))"
  assert cok(acos(cb(0x0000000000000000, 0x7FF8000000000001)), 0x3FF921FB54442D18, NAN_BITS), "acos((0+NaNi))"
  assert cok(acos(cb(0x0000000000000000, 0x3FE0000000000000)), 0x3FF921FB54442D18, 0xBFDECC2CAEC5160A), "acos((0+0.5i))"
  assert cok(acos(cb(0x0000000000000000, 0xC000000000000000)), 0x3FF921FB54442D18, 0x3FF719218313D087), "acos((0-2i))"
  assert cok(acos(cb(0x0000000000000000, 0x000012688B70E62B)), 0x3FF921FB54442D18, 0x800012688B70E62B), "acos((0+1e-310i))"
  assert cok(acos(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x3FF921FB54442D18, 0x7FF0000000000000), "acos((0+1e+300i))"
  assert cok(acos(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x3FF921FB54442D18, 0xBFF3BC04E847EC05), "acos((0+1.5707963267948966i))"
  assert cok(acos(cb(0x8000000000000000, 0x0000000000000000)), 0x3FF921FB54442D18, 0x8000000000000000), "acos((-0+0i))"
  assert cok(acos(cb(0x8000000000000000, 0x8000000000000000)), 0x3FF921FB54442D18, 0x0000000000000000), "acos((-0-0i))"
  assert cok(acos(cb(0x8000000000000000, 0x3FF0000000000000)), 0x3FF921FB54442D18, 0xBFEC34366179D427), "acos((-0+1i))"
  assert cok(acos(cb(0x8000000000000000, 0xBFF0000000000000)), 0x3FF921FB54442D18, 0x3FEC34366179D427), "acos((-0-1i))"
  assert cok(acos(cb(0x8000000000000000, 0x7FF0000000000000)), 0x3FF921FB54442D18, 0xFFF0000000000000), "acos((-0+Infi))"
  assert cok(acos(cb(0x8000000000000000, 0xFFF0000000000000)), 0x3FF921FB54442D18, 0x7FF0000000000000), "acos((-0-Infi))"
  assert cok(acos(cb(0x8000000000000000, 0x7FF8000000000001)), 0x3FF921FB54442D18, NAN_BITS), "acos((-0+NaNi))"
  assert cok(acos(cb(0x8000000000000000, 0x3FE0000000000000)), 0x3FF921FB54442D18, 0xBFDECC2CAEC5160A), "acos((-0+0.5i))"
  assert cok(acos(cb(0x8000000000000000, 0xC000000000000000)), 0x3FF921FB54442D18, 0x3FF719218313D087), "acos((-0-2i))"
  assert cok(acos(cb(0x8000000000000000, 0x000012688B70E62B)), 0x3FF921FB54442D18, 0x800012688B70E62B), "acos((-0+1e-310i))"
  assert cok(acos(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0x3FF921FB54442D18, 0x7FF0000000000000), "acos((-0+1e+300i))"
  assert cok(acos(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x3FF921FB54442D18, 0xBFF3BC04E847EC05), "acos((-0+1.5707963267948966i))"
  assert cok(acos(cb(0x3FF0000000000000, 0x0000000000000000)), 0x0000000000000000, 0x8000000000000000), "acos((1+0i))"
  assert cok(acos(cb(0x3FF0000000000000, 0x8000000000000000)), 0x0000000000000000, 0x0000000000000000), "acos((1-0i))"
