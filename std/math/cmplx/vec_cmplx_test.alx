  assert cok(asin(cb(0xBFF0000000000000, 0x3FF921FB54442D18)), 0xBFE03EF5FE25918A, 0x3FF59674AAA3CCA1), "asin((-1+1.5707963267948966i))"
  assert cok(asin(cb(0x7FF0000000000000, 0x0000000000000000)), 0x3FF921FB54442D18, 0x7FF0000000000000), "asin((+Inf+0i))"
  assert cok(asin(cb(0x7FF0000000000000, 0x8000000000000000)), 0x3FF921FB54442D18, 0xFFF0000000000000), "asin((+Inf-0i))"
