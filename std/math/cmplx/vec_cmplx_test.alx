test "log 1" {
  assert cok(log(cb(0x0000000000000000, 0x0000000000000000)), 0xFFF0000000000000, 0x0000000000000000), "log((0+0i))"
  assert cok(log(cb(0x0000000000000000, 0x8000000000000000)), 0xFFF0000000000000, 0x8000000000000000), "log((0-0i))"
  assert cok(log(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "log((0+1i))"
  assert cok(log(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "log((0-1i))"
  assert cok(log(cb(0x0000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FF921FB54442D18), "log((0+Infi))"
  assert cok(log(cb(0x0000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xBFF921FB54442D18), "log((0-Infi))"
  assert cok(log(cb(0x0000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "log((0+NaNi))"
  assert cok(log(cb(0x0000000000000000, 0x3FE0000000000000)), 0xBFE62E42FEFA39EF, 0x3FF921FB54442D18), "log((0+0.5i))"
  assert cok(log(cb(0x0000000000000000, 0xC000000000000000)), 0x3FE62E42FEFA39EF, 0xBFF921FB54442D18), "log((0-2i))"
  assert cok(log(cb(0x0000000000000000, 0x000012688B70E62B)), 0xC0864E69394D9508, 0x3FF921FB54442D18), "log((0+1e-310i))"
  assert cok(log(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x4085963447F87FB5, 0x3FF921FB54442D18), "log((0+1e+300i))"
  assert cok(log(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x3FDCE6BB25AA1315, 0x3FF921FB54442D18), "log((0+1.5707963267948966i))"
  assert cok(log(cb(0x8000000000000000, 0x0000000000000000)), 0xFFF0000000000000, 0x400921FB54442D18), "log((-0+0i))"
  assert cok(log(cb(0x8000000000000000, 0x8000000000000000)), 0xFFF0000000000000, 0xC00921FB54442D18), "log((-0-0i))"
  assert cok(log(cb(0x8000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "log((-0+1i))"
  assert cok(log(cb(0x8000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "log((-0-1i))"
  assert cok(log(cb(0x8000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FF921FB54442D18), "log((-0+Infi))"
  assert cok(log(cb(0x8000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xBFF921FB54442D18), "log((-0-Infi))"
  assert cok(log(cb(0x8000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "log((-0+NaNi))"
  assert cok(log(cb(0x8000000000000000, 0x3FE0000000000000)), 0xBFE62E42FEFA39EF, 0x3FF921FB54442D18), "log((-0+0.5i))"
  assert cok(log(cb(0x8000000000000000, 0xC000000000000000)), 0x3FE62E42FEFA39EF, 0xBFF921FB54442D18), "log((-0-2i))"
  assert cok(log(cb(0x8000000000000000, 0x000012688B70E62B)), 0xC0864E69394D9508, 0x3FF921FB54442D18), "log((-0+1e-310i))"
  assert cok(log(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0x4085963447F87FB5, 0x3FF921FB54442D18), "log((-0+1e+300i))"
  assert cok(log(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x3FDCE6BB25AA1315, 0x3FF921FB54442D18), "log((-0+1.5707963267948966i))"
  assert cok(log(cb(0x3FF0000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "log((1+0i))"
  assert cok(log(cb(0x3FF0000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "log((1-0i))"
  assert cok(log(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FD62E42FEFA39F0, 0x3FE921FB54442D18), "log((1+1i))"
