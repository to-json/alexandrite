test "rect 1" {
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "rect((0+0i))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "rect((0-0i))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0x3FF0000000000000)), 0x0000000000000000, 0x0000000000000000), "rect((0+1i))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0xBFF0000000000000)), 0x0000000000000000, 0x8000000000000000), "rect((0-1i))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0x7FF0000000000000)), NAN_BITS, NAN_BITS), "rect((0+Infi))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0xFFF0000000000000)), NAN_BITS, NAN_BITS), "rect((0-Infi))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0x7FF8000000000001)), NAN_BITS, NAN_BITS), "rect((0+NaNi))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0x3FE0000000000000)), 0x0000000000000000, 0x0000000000000000), "rect((0+0.5i))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0xC000000000000000)), 0x8000000000000000, 0x8000000000000000), "rect((0-2i))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0x000012688B70E62B)), 0x0000000000000000, 0x0000000000000000), "rect((0+1e-310i))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0x7E37E43C8800759C)), 0x8000000000000000, 0x8000000000000000), "rect((0+1e+300i))"
  assert cok(rect(math.float64frombits(0x0000000000000000), math.float64frombits(0x3FF921FB54442D18)), 0x0000000000000000, 0x0000000000000000), "rect((0+1.5707963267948966i))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0x0000000000000000)), 0x8000000000000000, 0x8000000000000000), "rect((-0+0i))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0x8000000000000000)), 0x8000000000000000, 0x0000000000000000), "rect((-0-0i))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0x3FF0000000000000)), 0x8000000000000000, 0x8000000000000000), "rect((-0+1i))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0xBFF0000000000000)), 0x8000000000000000, 0x0000000000000000), "rect((-0-1i))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0x7FF0000000000000)), NAN_BITS, NAN_BITS), "rect((-0+Infi))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0xFFF0000000000000)), NAN_BITS, NAN_BITS), "rect((-0-Infi))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0x7FF8000000000001)), NAN_BITS, NAN_BITS), "rect((-0+NaNi))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0x3FE0000000000000)), 0x8000000000000000, 0x8000000000000000), "rect((-0+0.5i))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0xC000000000000000)), 0x0000000000000000, 0x0000000000000000), "rect((-0-2i))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0x000012688B70E62B)), 0x8000000000000000, 0x8000000000000000), "rect((-0+1e-310i))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0x7E37E43C8800759C)), 0x0000000000000000, 0x0000000000000000), "rect((-0+1e+300i))"
  assert cok(rect(math.float64frombits(0x8000000000000000), math.float64frombits(0x3FF921FB54442D18)), 0x8000000000000000, 0x8000000000000000), "rect((-0+1.5707963267948966i))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0x0000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "rect((1+0i))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0x8000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "rect((1-0i))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0x3FF0000000000000)), 0x3FE14A280FB5068C, 0x3FEAED548F090CEE), "rect((1+1i))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0xBFF0000000000000)), 0x3FE14A280FB5068C, 0xBFEAED548F090CEE), "rect((1-1i))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0x7FF0000000000000)), NAN_BITS, NAN_BITS), "rect((1+Infi))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0xFFF0000000000000)), NAN_BITS, NAN_BITS), "rect((1-Infi))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0x7FF8000000000001)), NAN_BITS, NAN_BITS), "rect((1+NaNi))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0x3FE0000000000000)), 0x3FEC1528065B7D50, 0x3FDEAEE8744B05F0), "rect((1+0.5i))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0xC000000000000000)), 0xBFDAA22657537205, 0xBFED18F6EAD1B445), "rect((1-2i))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0x000012688B70E62B)), 0x3FF0000000000000, 0x000012688B70E62B), "rect((1+1e-310i))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0x7E37E43C8800759C)), 0xBFE2699022ADC4C1, 0xBFEA2C16B010E386), "rect((1+1e+300i))"
  assert cok(rect(math.float64frombits(0x3FF0000000000000), math.float64frombits(0x3FF921FB54442D18)), 0x3C91A62633145C00, 0x3FF0000000000000), "rect((1+1.5707963267948966i))"
