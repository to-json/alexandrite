test "cos 2" {
  assert cok(cos(cb(0xC000000000000000, 0x7FF0000000000000)), 0xFFF0000000000000, 0x7FF0000000000000), "cos((-2+Infi))"
  assert cok(cos(cb(0xC000000000000000, 0xFFF0000000000000)), 0xFFF0000000000000, 0xFFF0000000000000), "cos((-2-Infi))"
  assert cok(cos(cb(0xC000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "cos((-2+NaNi))"
