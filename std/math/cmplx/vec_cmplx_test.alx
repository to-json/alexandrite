}

test "rect 2" {
  assert cok(rect(math.float64frombits(0xC000000000000000), math.float64frombits(0x7FF0000000000000)), NAN_BITS, NAN_BITS), "rect((-2+Infi))"
  assert cok(rect(math.float64frombits(0xC000000000000000), math.float64frombits(0xFFF0000000000000)), NAN_BITS, NAN_BITS), "rect((-2-Infi))"
  assert cok(rect(math.float64frombits(0xC000000000000000), math.float64frombits(0x7FF8000000000001)), NAN_BITS, NAN_BITS), "rect((-2+NaNi))"
  assert cok(rect(math.float64frombits(0xC000000000000000), math.float64frombits(0x3FE0000000000000)), 0xBFFC1528065B7D50, 0xBFEEAEE8744B05F0), "rect((-2+0.5i))"
  assert cok(rect(math.float64frombits(0xC000000000000000), math.float64frombits(0xC000000000000000)), 0x3FEAA22657537205, 0x3FFD18F6EAD1B445), "rect((-2-2i))"
  assert cok(rect(math.float64frombits(0xC000000000000000), math.float64frombits(0x000012688B70E62B)), 0xC000000000000000, 0x800024D116E1CC56), "rect((-2+1e-310i))"
  assert cok(rect(math.float64frombits(0xC000000000000000), math.float64frombits(0x7E37E43C8800759C)), 0x3FF2699022ADC4C1, 0x3FFA2C16B010E386), "rect((-2+1e+300i))"
  assert cok(rect(math.float64frombits(0xC000000000000000), math.float64frombits(0x3FF921FB54442D18)), 0xBCA1A62633145C00, 0xC000000000000000), "rect((-2+1.5707963267948966i))"
  assert cok(rect(math.float64frombits(0x000012688B70E62B), math.float64frombits(0x0000000000000000)), 0x000012688B70E62B, 0x0000000000000000), "rect((1e-310+0i))"
  assert cok(rect(math.float64frombits(0x000012688B70E62B), math.float64frombits(0x8000000000000000)), 0x000012688B70E62B, 0x8000000000000000), "rect((1e-310-0i))"
  assert cok(rect(math.float64frombits(0x000012688B70E62B), math.float64frombits(0x3FF0000000000000)), 0x000009F232E226CD, 0x00000F7D78392D98), "rect((1e-310+1i))"
