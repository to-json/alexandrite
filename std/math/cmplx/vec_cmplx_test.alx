test "acosh 3" {
  assert cok(acosh(cb(0xBFC4D03297FC2C30, 0xBFE696DE924495D8)), 0x3FE53439DC938582, 0xBFFB421585F50A02), "acosh((-0.16260368748803122-0.7059166771693368i))"
  assert cok(acosh(cb(0xBFD243B5D337796C, 0x3FC4CB17DB74B0C4)), 0x3FC5910F4EE95EC8, 0x3FFDB249DA91EE58), "acosh((-0.28538270594244497+0.16244791236511535i))"
  assert cok(acosh(cb(0xBFFBA730F579C1B2, 0x3FD277A756CDDEF8)), 0x3FF2B0ACD174E44A, 0x400788685089DAA8), "acosh((-1.7283181752101027+0.2885530803391556i))"
  assert cok(acosh(cb(0xBF8738FEB2BC759E, 0xC030B9BF8C06766C)), 0x400C167C373E3AAA, 0xBFF924C0F2CD58B5), "acosh((-0.011339177922816298-16.725579024865894i))"
}

test "atanh 1" {
  assert cok(atanh(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "atanh((0+0i))"
  assert cok(atanh(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "atanh((0-0i))"
  assert cok(atanh(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FE921FB54442D18), "atanh((0+1i))"
  assert cok(atanh(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xBFE921FB54442D18), "atanh((0-1i))"
  assert cok(atanh(cb(0x0000000000000000, 0x7FF0000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "atanh((0+Infi))"
  assert cok(atanh(cb(0x0000000000000000, 0xFFF0000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "atanh((0-Infi))"
  assert cok(atanh(cb(0x0000000000000000, 0x7FF8000000000001)), 0x0000000000000000, NAN_BITS), "atanh((0+NaNi))"
  assert cok(atanh(cb(0x0000000000000000, 0x3FE0000000000000)), 0x0000000000000000, 0x3FDDAC670561BB4F), "atanh((0+0.5i))"
  assert cok(atanh(cb(0x0000000000000000, 0xC000000000000000)), 0x0000000000000000, 0xBFF1B6E192EBBE44), "atanh((0-2i))"
  assert cok(atanh(cb(0x0000000000000000, 0x000012688B70E62B)), 0x0000000000000000, 0x000012688B70E62B), "atanh((0+1e-310i))"
  assert cok(atanh(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x0000000000000000, 0x3FF921FB54442D18), "atanh((0+1e+300i))"
  assert cok(atanh(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x0000000000000000, 0x3FF00FE987ED02FF), "atanh((0+1.5707963267948966i))"
  assert cok(atanh(cb(0x8000000000000000, 0x0000000000000000)), 0x8000000000000000, 0x0000000000000000), "atanh((-0+0i))"
  assert cok(atanh(cb(0x8000000000000000, 0x8000000000000000)), 0x8000000000000000, 0x8000000000000000), "atanh((-0-0i))"
  assert cok(atanh(cb(0x8000000000000000, 0x3FF0000000000000)), 0x8000000000000000, 0x3FE921FB54442D18), "atanh((-0+1i))"
  assert cok(atanh(cb(0x8000000000000000, 0xBFF0000000000000)), 0x8000000000000000, 0xBFE921FB54442D18), "atanh((-0-1i))"
  assert cok(atanh(cb(0x8000000000000000, 0x7FF0000000000000)), 0x8000000000000000, 0x3FF921FB54442D18), "atanh((-0+Infi))"
  assert cok(atanh(cb(0x8000000000000000, 0xFFF0000000000000)), 0x8000000000000000, 0xBFF921FB54442D18), "atanh((-0-Infi))"
  assert cok(atanh(cb(0x8000000000000000, 0x7FF8000000000001)), 0x8000000000000000, NAN_BITS), "atanh((-0+NaNi))"
  assert cok(atanh(cb(0x8000000000000000, 0x3FE0000000000000)), 0x8000000000000000, 0x3FDDAC670561BB4F), "atanh((-0+0.5i))"
  assert cok(atanh(cb(0x8000000000000000, 0xC000000000000000)), 0x8000000000000000, 0xBFF1B6E192EBBE44), "atanh((-0-2i))"
  assert cok(atanh(cb(0x8000000000000000, 0x000012688B70E62B)), 0x8000000000000000, 0x000012688B70E62B), "atanh((-0+1e-310i))"
  assert cok(atanh(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0x8000000000000000, 0x3FF921FB54442D18), "atanh((-0+1e+300i))"
  assert cok(atanh(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x8000000000000000, 0x3FF00FE987ED02FF), "atanh((-0+1.5707963267948966i))"
  assert cok(atanh(cb(0x3FF0000000000000, 0x0000000000000000)), 0x7FF0000000000000, 0x0000000000000000), "atanh((1+0i))"
  assert cok(atanh(cb(0x3FF0000000000000, 0x8000000000000000)), 0x7FF0000000000000, 0x8000000000000000), "atanh((1-0i))"
  assert cok(atanh(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FD9C041F7ED8D33, 0x3FF0468A8ACE4DF6), "atanh((1+1i))"
  assert cok(atanh(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FD9C041F7ED8D33, 0xBFF0468A8ACE4DF6), "atanh((1-1i))"
  assert cok(atanh(cb(0x3FF0000000000000, 0x7FF0000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "atanh((1+Infi))"
  assert cok(atanh(cb(0x3FF0000000000000, 0xFFF0000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "atanh((1-Infi))"
  assert cok(atanh(cb(0x3FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "atanh((1+NaNi))"
  assert cok(atanh(cb(0x3FF0000000000000, 0x3FE0000000000000)), 0x3FE6AA6BC1FA7F7A, 0x3FED0D6A1369BD34), "atanh((1+0.5i))"
  assert cok(atanh(cb(0x3FF0000000000000, 0xC000000000000000)), 0x3FC62E42FEFA39EF, 0xBFF2D97C7F3321D2), "atanh((1-2i))"
  assert cok(atanh(cb(0x3FF0000000000000, 0x000012688B70E62B)), NAN_BITS, NAN_BITS), "atanh((1+1e-310i))"
  assert cok(atanh(cb(0x3FF0000000000000, 0x7E37E43C8800759C)), NAN_BITS, 0x3FF921FB54442D18), "atanh((1+1e+300i))"
  assert cok(atanh(cb(0x3FF0000000000000, 0x3FF921FB54442D18)), 0x3FCED5E26672223A, 0x3FF1E47EDA395834), "atanh((1+1.5707963267948966i))"
  assert cok(atanh(cb(0xBFF0000000000000, 0x0000000000000000)), 0xFFF0000000000000, 0x0000000000000000), "atanh((-1+0i))"
  assert cok(atanh(cb(0xBFF0000000000000, 0x8000000000000000)), 0xFFF0000000000000, 0x8000000000000000), "atanh((-1-0i))"
  assert cok(atanh(cb(0xBFF0000000000000, 0x3FF0000000000000)), 0xBFD9C041F7ED8D33, 0x3FF0468A8ACE4DF6), "atanh((-1+1i))"
  assert cok(atanh(cb(0xBFF0000000000000, 0xBFF0000000000000)), 0xBFD9C041F7ED8D33, 0xBFF0468A8ACE4DF6), "atanh((-1-1i))"
  assert cok(atanh(cb(0xBFF0000000000000, 0x7FF0000000000000)), 0x8000000000000000, 0x3FF921FB54442D18), "atanh((-1+Infi))"
  assert cok(atanh(cb(0xBFF0000000000000, 0xFFF0000000000000)), 0x8000000000000000, 0xBFF921FB54442D18), "atanh((-1-Infi))"
  assert cok(atanh(cb(0xBFF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "atanh((-1+NaNi))"
  assert cok(atanh(cb(0xBFF0000000000000, 0x3FE0000000000000)), 0xBFE6AA6BC1FA7F7A, 0x3FED0D6A1369BD34), "atanh((-1+0.5i))"
  assert cok(atanh(cb(0xBFF0000000000000, 0xC000000000000000)), 0xBFC62E42FEFA39EF, 0xBFF2D97C7F3321D2), "atanh((-1-2i))"
  assert cok(atanh(cb(0xBFF0000000000000, 0x000012688B70E62B)), NAN_BITS, NAN_BITS), "atanh((-1+1e-310i))"
  assert cok(atanh(cb(0xBFF0000000000000, 0x7E37E43C8800759C)), NAN_BITS, 0x3FF921FB54442D18), "atanh((-1+1e+300i))"
  assert cok(atanh(cb(0xBFF0000000000000, 0x3FF921FB54442D18)), 0xBFCED5E26672223A, 0x3FF1E47EDA395834), "atanh((-1+1.5707963267948966i))"
  assert cok(atanh(cb(0x7FF0000000000000, 0x0000000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "atanh((+Inf+0i))"
  assert cok(atanh(cb(0x7FF0000000000000, 0x8000000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "atanh((+Inf-0i))"
  assert cok(atanh(cb(0x7FF0000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "atanh((+Inf+1i))"
  assert cok(atanh(cb(0x7FF0000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "atanh((+Inf-1i))"
  assert cok(atanh(cb(0x7FF0000000000000, 0x7FF0000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "atanh((+Inf+Infi))"
  assert cok(atanh(cb(0x7FF0000000000000, 0xFFF0000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "atanh((+Inf-Infi))"
  assert cok(atanh(cb(0x7FF0000000000000, 0x7FF8000000000001)), 0x0000000000000000, NAN_BITS), "atanh((+Inf+NaNi))"
  assert cok(atanh(cb(0x7FF0000000000000, 0x3FE0000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "atanh((+Inf+0.5i))"
  assert cok(atanh(cb(0x7FF0000000000000, 0xC000000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "atanh((+Inf-2i))"
  assert cok(atanh(cb(0x7FF0000000000000, 0x000012688B70E62B)), 0x0000000000000000, 0x3FF921FB54442D18), "atanh((+Inf+1e-310i))"
