test "tan 3" {
  assert cok(tan(cb(0xBFC4D03297FC2C30, 0xBFE696DE924495D8)), 0xBFBA34BCCE018B94, 0xBFE3C94BB28A3681), "tan((-0.16260368748803122-0.7059166771693368i))"
