  assert cok(rect(math.float64frombits(0x000012688B70E62B), math.float64frombits(0xC000000000000000)), 0x800007A91C4E0431, 0x800010BD1AD1AA56), "rect((1e-310-2i))"
  assert cok(rect(math.float64frombits(0x000012688B70E62B), math.float64frombits(0x000012688B70E62B)), 0x000012688B70E62B, 0x0000000000000000), "rect((1e-310+1e-310i))"
  assert cok(rect(math.float64frombits(0x000012688B70E62B), math.float64frombits(0x7E37E43C8800759C)), 0x80000A9788637272, 0x80000F0E4E189ED3), "rect((1e-310+1e+300i))"
  assert cok(rect(math.float64frombits(0x000012688B70E62B), math.float64frombits(0x3FF921FB54442D18)), 0x0000000000000000, 0x000012688B70E62B), "rect((1e-310+1.5707963267948966i))"
  assert cok(rect(math.float64frombits(0x7E37E43C8800759C), math.float64frombits(0x0000000000000000)), 0x7E37E43C8800759C, 0x0000000000000000), "rect((1e+300+0i))"
