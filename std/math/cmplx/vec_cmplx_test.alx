  assert cok(asin(cb(0xFFF0000000000000, 0x7E37E43C8800759C)), 0xBFF921FB54442D18, 0x7FF0000000000000), "asin((-Inf+1e+300i))"
  assert cok(asin(cb(0xFFF0000000000000, 0x3FF921FB54442D18)), 0xBFF921FB54442D18, 0x7FF0000000000000), "asin((-Inf+1.5707963267948966i))"
  assert cok(asin(cb(0x7FF8000000000001, 0x0000000000000000)), NAN_BITS, NAN_BITS), "asin((NaN+0i))"
  assert cok(asin(cb(0x7FF8000000000001, 0x8000000000000000)), NAN_BITS, NAN_BITS), "asin((NaN-0i))"
  assert cok(asin(cb(0x7FF8000000000001, 0x3FF0000000000000)), NAN_BITS, NAN_BITS), "asin((NaN+1i))"
  assert cok(asin(cb(0x7FF8000000000001, 0xBFF0000000000000)), NAN_BITS, NAN_BITS), "asin((NaN-1i))"
