  assert cok(conj(cb(0xC000000000000000, 0x8000000000000000)), 0xC000000000000000, 0x0000000000000000), "conj((-2-0i))"
  assert cok(conj(cb(0xC000000000000000, 0x3FF0000000000000)), 0xC000000000000000, 0xBFF0000000000000), "conj((-2+1i))"
  assert cok(conj(cb(0xC000000000000000, 0xBFF0000000000000)), 0xC000000000000000, 0x3FF0000000000000), "conj((-2-1i))"
}

test "conj 2" {
  assert cok(conj(cb(0xC000000000000000, 0x7FF0000000000000)), 0xC000000000000000, 0xFFF0000000000000), "conj((-2+Infi))"
  assert cok(conj(cb(0xC000000000000000, 0xFFF0000000000000)), 0xC000000000000000, 0x7FF0000000000000), "conj((-2-Infi))"
  assert cok(conj(cb(0xC000000000000000, 0x7FF8000000000001)), 0xC000000000000000, NAN_BITS), "conj((-2+NaNi))"
  assert cok(conj(cb(0xC000000000000000, 0x3FE0000000000000)), 0xC000000000000000, 0xBFE0000000000000), "conj((-2+0.5i))"
  assert cok(conj(cb(0xC000000000000000, 0xC000000000000000)), 0xC000000000000000, 0x4000000000000000), "conj((-2-2i))"
  assert cok(conj(cb(0xC000000000000000, 0x000012688B70E62B)), 0xC000000000000000, 0x800012688B70E62B), "conj((-2+1e-310i))"
