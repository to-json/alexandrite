  assert cok(asinh(cb(0x7FF0000000000000, 0x3FF921FB54442D18)), 0x7FF0000000000000, 0x0000000000000000), "asinh((+Inf+1.5707963267948966i))"
  assert cok(asinh(cb(0xFFF0000000000000, 0x0000000000000000)), 0xFFF0000000000000, 0x0000000000000000), "asinh((-Inf+0i))"
