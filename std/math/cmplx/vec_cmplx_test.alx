  assert cok(sinh(cb(0x0000000000000000, 0xC000000000000000)), 0x8000000000000000, 0xBFED18F6EAD1B445), "sinh((0-2i))"
  assert cok(sinh(cb(0x0000000000000000, 0x000012688B70E62B)), 0x0000000000000000, 0x000012688B70E62B), "sinh((0+1e-310i))"
  assert cok(sinh(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x8000000000000000, 0xBFEA2C16B010E386), "sinh((0+1e+300i))"
  assert cok(sinh(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x0000000000000000, 0x3FF0000000000000), "sinh((0+1.5707963267948966i))"
  assert cok(sinh(cb(0x8000000000000000, 0x0000000000000000)), 0x8000000000000000, 0x0000000000000000), "sinh((-0+0i))"
