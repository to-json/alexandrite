test "atan 1" {
  assert cok(atan(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "atan((0+0i))"
  assert cok(atan(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "atan((0-0i))"
  assert cok(atan(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x7FF0000000000000), "atan((0+1i))"
  assert cok(atan(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xFFF0000000000000), "atan((0-1i))"
  assert cok(atan(cb(0x0000000000000000, 0x7FF0000000000000)), 0x3FF921FB54442D18, 0x0000000000000000), "atan((0+Infi))"
  assert cok(atan(cb(0x0000000000000000, 0xFFF0000000000000)), 0x3FF921FB54442D18, 0x8000000000000000), "atan((0-Infi))"
  assert cok(atan(cb(0x0000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "atan((0+NaNi))"
  assert cok(atan(cb(0x0000000000000000, 0x3FE0000000000000)), 0x0000000000000000, 0x3FE193EA7AAD030A), "atan((0+0.5i))"
  assert cok(atan(cb(0x0000000000000000, 0xC000000000000000)), 0xBFF921FB54442D19, 0xBFE193EA7AAD030B), "atan((0-2i))"
  assert cok(atan(cb(0x0000000000000000, 0x000012688B70E62B)), 0x0000000000000000, 0x000012688B70E62B), "atan((0+1e-310i))"
  assert cok(atan(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0xBFF921FB54442D19, NAN_BITS), "atan((0+1e+300i))"
  assert cok(atan(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0xBFF921FB54442D19, 0x3FE8143A6DB3D44B), "atan((0+1.5707963267948966i))"
  assert cok(atan(cb(0x8000000000000000, 0x0000000000000000)), 0x8000000000000000, 0x0000000000000000), "atan((-0+0i))"
  assert cok(atan(cb(0x8000000000000000, 0x8000000000000000)), 0x8000000000000000, 0x8000000000000000), "atan((-0-0i))"
  assert cok(atan(cb(0x8000000000000000, 0x3FF0000000000000)), 0x8000000000000000, 0x7FF0000000000000), "atan((-0+1i))"
  assert cok(atan(cb(0x8000000000000000, 0xBFF0000000000000)), 0x8000000000000000, 0xFFF0000000000000), "atan((-0-1i))"
  assert cok(atan(cb(0x8000000000000000, 0x7FF0000000000000)), 0xBFF921FB54442D18, 0x0000000000000000), "atan((-0+Infi))"
  assert cok(atan(cb(0x8000000000000000, 0xFFF0000000000000)), 0xBFF921FB54442D18, 0x8000000000000000), "atan((-0-Infi))"
  assert cok(atan(cb(0x8000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "atan((-0+NaNi))"
  assert cok(atan(cb(0x8000000000000000, 0x3FE0000000000000)), 0x8000000000000000, 0x3FE193EA7AAD030A), "atan((-0+0.5i))"
  assert cok(atan(cb(0x8000000000000000, 0xC000000000000000)), 0xBFF921FB54442D18, 0xBFE193EA7AAD030B), "atan((-0-2i))"
  assert cok(atan(cb(0x8000000000000000, 0x000012688B70E62B)), 0x8000000000000000, 0x000012688B70E62B), "atan((-0+1e-310i))"
  assert cok(atan(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0xBFF921FB54442D18, NAN_BITS), "atan((-0+1e+300i))"
  assert cok(atan(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0xBFF921FB54442D18, 0x3FE8143A6DB3D44B), "atan((-0+1.5707963267948966i))"
  assert cok(atan(cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FE921FB54442D18, 0x0000000000000000), "atan((1+0i))"
  assert cok(atan(cb(0x3FF0000000000000, 0x8000000000000000)), 0x3FE921FB54442D18, 0x8000000000000000), "atan((1-0i))"
  assert cok(atan(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FF0468A8ACE4DF6, 0x3FD9C041F7ED8D33), "atan((1+1i))"
  assert cok(atan(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FF0468A8ACE4DF6, 0xBFD9C041F7ED8D33), "atan((1-1i))"
  assert cok(atan(cb(0x3FF0000000000000, 0x7FF0000000000000)), 0x3FF921FB54442D18, 0x0000000000000000), "atan((1+Infi))"
  assert cok(atan(cb(0x3FF0000000000000, 0xFFF0000000000000)), 0x3FF921FB54442D18, 0x8000000000000000), "atan((1-Infi))"
  assert cok(atan(cb(0x3FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "atan((1+NaNi))"
  assert cok(atan(cb(0x3FF0000000000000, 0x3FE0000000000000)), 0x3FEB1F56FDEEF00F, 0x3FCE938CBCEB16DE), "atan((1+0.5i))"
  assert cok(atan(cb(0x3FF0000000000000, 0xC000000000000000)), 0x3FF56C6E7397F5AE, 0xBFD9C041F7ED8D33), "atan((1-2i))"
  assert cok(atan(cb(0x3FF0000000000000, 0x000012688B70E62B)), NAN_BITS, NAN_BITS), "atan((1+1e-310i))"
  assert cok(atan(cb(0x3FF0000000000000, 0x7E37E43C8800759C)), 0xBFF921FB54442D19, NAN_BITS), "atan((1+1e+300i))"
  assert cok(atan(cb(0x3FF0000000000000, 0x3FF921FB54442D18)), 0x3FF3AEFB3294EE44, 0x3FDBF4F9C5DC4FFF), "atan((1+1.5707963267948966i))"
  assert cok(atan(cb(0xBFF0000000000000, 0x0000000000000000)), 0xBFE921FB54442D18, 0x0000000000000000), "atan((-1+0i))"
  assert cok(atan(cb(0xBFF0000000000000, 0x8000000000000000)), 0xBFE921FB54442D18, 0x8000000000000000), "atan((-1-0i))"
  assert cok(atan(cb(0xBFF0000000000000, 0x3FF0000000000000)), 0xBFF0468A8ACE4DF6, 0x3FD9C041F7ED8D33), "atan((-1+1i))"
  assert cok(atan(cb(0xBFF0000000000000, 0xBFF0000000000000)), 0xBFF0468A8ACE4DF6, 0xBFD9C041F7ED8D33), "atan((-1-1i))"
  assert cok(atan(cb(0xBFF0000000000000, 0x7FF0000000000000)), 0xBFF921FB54442D18, 0x0000000000000000), "atan((-1+Infi))"
  assert cok(atan(cb(0xBFF0000000000000, 0xFFF0000000000000)), 0xBFF921FB54442D18, 0x8000000000000000), "atan((-1-Infi))"
  assert cok(atan(cb(0xBFF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "atan((-1+NaNi))"
  assert cok(atan(cb(0xBFF0000000000000, 0x3FE0000000000000)), 0xBFEB1F56FDEEF00F, 0x3FCE938CBCEB16DE), "atan((-1+0.5i))"
  assert cok(atan(cb(0xBFF0000000000000, 0xC000000000000000)), 0xBFF56C6E7397F5AE, 0xBFD9C041F7ED8D33), "atan((-1-2i))"
  assert cok(atan(cb(0xBFF0000000000000, 0x000012688B70E62B)), NAN_BITS, NAN_BITS), "atan((-1+1e-310i))"
  assert cok(atan(cb(0xBFF0000000000000, 0x7E37E43C8800759C)), 0xBFF921FB54442D18, NAN_BITS), "atan((-1+1e+300i))"
  assert cok(atan(cb(0xBFF0000000000000, 0x3FF921FB54442D18)), 0xBFF3AEFB3294EE44, 0x3FDBF4F9C5DC4FFF), "atan((-1+1.5707963267948966i))"
  assert cok(atan(cb(0x7FF0000000000000, 0x0000000000000000)), 0x3FF921FB54442D18, 0x0000000000000000), "atan((+Inf+0i))"
  assert cok(atan(cb(0x7FF0000000000000, 0x8000000000000000)), 0x3FF921FB54442D18, 0x8000000000000000), "atan((+Inf-0i))"
  assert cok(atan(cb(0x7FF0000000000000, 0x3FF0000000000000)), 0x3FF921FB54442D18, 0x0000000000000000), "atan((+Inf+1i))"
  assert cok(atan(cb(0x7FF0000000000000, 0xBFF0000000000000)), 0x3FF921FB54442D18, 0x8000000000000000), "atan((+Inf-1i))"
  assert cok(atan(cb(0x7FF0000000000000, 0x7FF0000000000000)), 0x3FF921FB54442D18, 0x0000000000000000), "atan((+Inf+Infi))"
  assert cok(atan(cb(0x7FF0000000000000, 0xFFF0000000000000)), 0x3FF921FB54442D18, 0x8000000000000000), "atan((+Inf-Infi))"
  assert cok(atan(cb(0x7FF0000000000000, 0x7FF8000000000001)), 0x3FF921FB54442D18, 0x0000000000000000), "atan((+Inf+NaNi))"
  assert cok(atan(cb(0x7FF0000000000000, 0x3FE0000000000000)), 0x3FF921FB54442D18, 0x0000000000000000), "atan((+Inf+0.5i))"
  assert cok(atan(cb(0x7FF0000000000000, 0xC000000000000000)), 0x3FF921FB54442D18, 0x8000000000000000), "atan((+Inf-2i))"
  assert cok(atan(cb(0x7FF0000000000000, 0x000012688B70E62B)), 0x3FF921FB54442D18, 0x0000000000000000), "atan((+Inf+1e-310i))"
  assert cok(atan(cb(0x7FF0000000000000, 0x7E37E43C8800759C)), 0x3FF921FB54442D18, 0x0000000000000000), "atan((+Inf+1e+300i))"
  assert cok(atan(cb(0x7FF0000000000000, 0x3FF921FB54442D18)), 0x3FF921FB54442D18, 0x0000000000000000), "atan((+Inf+1.5707963267948966i))"
  assert cok(atan(cb(0xFFF0000000000000, 0x0000000000000000)), 0xBFF921FB54442D18, 0x0000000000000000), "atan((-Inf+0i))"
  assert cok(atan(cb(0xFFF0000000000000, 0x8000000000000000)), 0xBFF921FB54442D18, 0x8000000000000000), "atan((-Inf-0i))"
  assert cok(atan(cb(0xFFF0000000000000, 0x3FF0000000000000)), 0xBFF921FB54442D18, 0x0000000000000000), "atan((-Inf+1i))"
  assert cok(atan(cb(0xFFF0000000000000, 0xBFF0000000000000)), 0xBFF921FB54442D18, 0x8000000000000000), "atan((-Inf-1i))"
  assert cok(atan(cb(0xFFF0000000000000, 0x7FF0000000000000)), 0xBFF921FB54442D18, 0x0000000000000000), "atan((-Inf+Infi))"
  assert cok(atan(cb(0xFFF0000000000000, 0xFFF0000000000000)), 0xBFF921FB54442D18, 0x8000000000000000), "atan((-Inf-Infi))"
  assert cok(atan(cb(0xFFF0000000000000, 0x7FF8000000000001)), 0xBFF921FB54442D18, 0x0000000000000000), "atan((-Inf+NaNi))"
  assert cok(atan(cb(0xFFF0000000000000, 0x3FE0000000000000)), 0xBFF921FB54442D18, 0x0000000000000000), "atan((-Inf+0.5i))"
  assert cok(atan(cb(0xFFF0000000000000, 0xC000000000000000)), 0xBFF921FB54442D18, 0x8000000000000000), "atan((-Inf-2i))"
  assert cok(atan(cb(0xFFF0000000000000, 0x000012688B70E62B)), 0xBFF921FB54442D18, 0x0000000000000000), "atan((-Inf+1e-310i))"
  assert cok(atan(cb(0xFFF0000000000000, 0x7E37E43C8800759C)), 0xBFF921FB54442D18, 0x0000000000000000), "atan((-Inf+1e+300i))"
  assert cok(atan(cb(0xFFF0000000000000, 0x3FF921FB54442D18)), 0xBFF921FB54442D18, 0x0000000000000000), "atan((-Inf+1.5707963267948966i))"
  assert cok(atan(cb(0x7FF8000000000001, 0x0000000000000000)), NAN_BITS, 0x0000000000000000), "atan((NaN+0i))"
