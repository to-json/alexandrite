  assert cok(asin(cb(0x3FE0000000000000, 0xC000000000000000)), 0x3FCC4A56B1E74619, 0xBFF77391F0DDBD68), "asin((0.5-2i))"
  assert cok(asin(cb(0x3FE0000000000000, 0x000012688B70E62B)), 0x3FE0C152382D7366, 0x8000000000000000), "asin((0.5+1e-310i))"
  assert cok(asin(cb(0x3FE0000000000000, 0x7E37E43C8800759C)), 0x0000000000000000, 0xFFF0000000000000), "asin((0.5+1e+300i))"
  assert cok(asin(cb(0x3FE0000000000000, 0x3FF921FB54442D18)), 0x3FD0F31685CFBBF6, 0x3FF4374124FE0EAE), "asin((0.5+1.5707963267948966i))"
  assert cok(asin(cb(0xC000000000000000, 0x0000000000000000)), 0xBFF921FB54442D18, 0x3FF5124271980433), "asin((-2+0i))"
  assert cok(asin(cb(0xC000000000000000, 0x8000000000000000)), 0xBFF921FB54442D18, 0xBFF5124271980434), "asin((-2-0i))"
  assert cok(asin(cb(0xC000000000000000, 0x3FF0000000000000)), 0xBFF103D9AFA861F4, 0x3FF78276F9861C4C), "asin((-2+1i))"
  assert cok(asin(cb(0xC000000000000000, 0xBFF0000000000000)), 0xBFF103D9AFA861F4, 0xBFF78276F9861C4B), "asin((-2-1i))"
}

test "asin 2" {
  assert cok(asin(cb(0xC000000000000000, 0x7FF0000000000000)), 0x8000000000000000, 0x7FF0000000000000), "asin((-2+Infi))"
  assert cok(asin(cb(0xC000000000000000, 0xFFF0000000000000)), 0x8000000000000000, 0xFFF0000000000000), "asin((-2-Infi))"
  assert cok(asin(cb(0xC000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "asin((-2+NaNi))"
  assert cok(asin(cb(0xC000000000000000, 0x3FE0000000000000)), 0xBFF4B04CE1C05556, 0x3FF5C9EFBDCD9088), "asin((-2+0.5i))"
  assert cok(asin(cb(0xC000000000000000, 0xC000000000000000)), 0xBFE822CF1A307358, 0xBFFBBFCB11C71110), "asin((-2-2i))"
  assert cok(asin(cb(0xC000000000000000, 0x000012688B70E62B)), 0xBFF921FB54442D18, 0x3FF5124271980433), "asin((-2+1e-310i))"
  assert cok(asin(cb(0xC000000000000000, 0x7E37E43C8800759C)), 0x8000000000000000, 0xFFF0000000000000), "asin((-2+1e+300i))"
  assert cok(asin(cb(0xC000000000000000, 0x3FF921FB54442D18)), 0xBFEBBB27DB54183E, 0x3FF9E960D5B6EA3B), "asin((-2+1.5707963267948966i))"
  assert cok(asin(cb(0x000012688B70E62B, 0x0000000000000000)), 0x000012688B70E62B, 0x0000000000000000), "asin((1e-310+0i))"
  assert cok(asin(cb(0x000012688B70E62B, 0x8000000000000000)), 0x000012688B70E62B, 0x8000000000000000), "asin((1e-310-0i))"
  assert cok(asin(cb(0x000012688B70E62B, 0x3FF0000000000000)), 0x00000D0445B5F9A7, 0x3FEC34366179D425), "asin((1e-310+1i))"
  assert cok(asin(cb(0x000012688B70E62B, 0xBFF0000000000000)), 0x00000D0445B5F9A8, 0xBFEC34366179D426), "asin((1e-310-1i))"
  assert cok(asin(cb(0x000012688B70E62B, 0x7FF0000000000000)), 0x0000000000000000, 0x7FF0000000000000), "asin((1e-310+Infi))"
  assert cok(asin(cb(0x000012688B70E62B, 0xFFF0000000000000)), 0x0000000000000000, 0xFFF0000000000000), "asin((1e-310-Infi))"
  assert cok(asin(cb(0x000012688B70E62B, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "asin((1e-310+NaNi))"
  assert cok(asin(cb(0x000012688B70E62B, 0x3FE0000000000000)), 0x000010770732459A, 0x3FDECC2CAEC51608), "asin((1e-310+0.5i))"
  assert cok(asin(cb(0x000012688B70E62B, 0xC000000000000000)), 0x0000083B839922CE, 0xBFF719218313D087), "asin((1e-310-2i))"
  assert cok(asin(cb(0x000012688B70E62B, 0x000012688B70E62B)), 0x000012688B70E62B, 0x8000000000000000), "asin((1e-310+1e-310i))"
  assert cok(asin(cb(0x000012688B70E62B, 0x7E37E43C8800759C)), 0x0000000000000000, 0xFFF0000000000000), "asin((1e-310+1e+300i))"
  assert cok(asin(cb(0x000012688B70E62B, 0x3FF921FB54442D18)), 0x000009E2C6421141, 0x3FF3BC04E847EC05), "asin((1e-310+1.5707963267948966i))"
  assert cok(asin(cb(0x7E37E43C8800759C, 0x0000000000000000)), 0xBFF921FB54442D18, 0xFFF0000000000000), "asin((1e+300+0i))"
  assert cok(asin(cb(0x7E37E43C8800759C, 0x8000000000000000)), 0x3FF921FB54442D18, 0xFFF0000000000000), "asin((1e+300-0i))"
  assert cok(asin(cb(0x7E37E43C8800759C, 0x3FF0000000000000)), 0xBFF921FB54442D18, 0xFFF0000000000000), "asin((1e+300+1i))"
  assert cok(asin(cb(0x7E37E43C8800759C, 0xBFF0000000000000)), 0x3FF921FB54442D18, 0xFFF0000000000000), "asin((1e+300-1i))"
  assert cok(asin(cb(0x7E37E43C8800759C, 0x7FF0000000000000)), 0x0000000000000000, 0x7FF0000000000000), "asin((1e+300+Infi))"
  assert cok(asin(cb(0x7E37E43C8800759C, 0xFFF0000000000000)), 0x0000000000000000, 0xFFF0000000000000), "asin((1e+300-Infi))"
  assert cok(asin(cb(0x7E37E43C8800759C, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "asin((1e+300+NaNi))"
