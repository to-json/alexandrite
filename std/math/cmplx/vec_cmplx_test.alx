}

test "cot 1" {
  assert cok(cot(cb(0x0000000000000000, 0x0000000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "cot((0+0i))"
  assert cok(cot(cb(0x0000000000000000, 0x8000000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "cot((0-0i))"
  assert cok(cot(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0xBFF50231499B6B1E), "cot((0+1i))"
  assert cok(cot(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0x3FF50231499B6B1E), "cot((0-1i))"
  assert cok(cot(cb(0x0000000000000000, 0x7FF0000000000000)), 0x0000000000000000, NAN_BITS), "cot((0+Infi))"
  assert cok(cot(cb(0x0000000000000000, 0xFFF0000000000000)), 0x0000000000000000, NAN_BITS), "cot((0-Infi))"
  assert cok(cot(cb(0x0000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "cot((0+NaNi))"
  assert cok(cot(cb(0x0000000000000000, 0x3FE0000000000000)), 0x0000000000000000, 0xC0014FC6CEB099BF), "cot((0+0.5i))"
  assert cok(cot(cb(0x0000000000000000, 0xC000000000000000)), 0x0000000000000000, 0x3FF098D75212F273), "cot((0-2i))"
  assert cok(cot(cb(0x0000000000000000, 0x000012688B70E62B)), 0x7FF0000000000000, 0x7FF0000000000000), "cot((0+1e-310i))"
  assert cok(cot(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x0000000000000000, NAN_BITS), "cot((0+1e+300i))"
  assert cok(cot(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x0000000000000000, 0xBFF171FF596E026C), "cot((0+1.5707963267948966i))"
  assert cok(cot(cb(0x8000000000000000, 0x0000000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "cot((-0+0i))"
  assert cok(cot(cb(0x8000000000000000, 0x8000000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "cot((-0-0i))"
  assert cok(cot(cb(0x8000000000000000, 0x3FF0000000000000)), 0x8000000000000000, 0xBFF50231499B6B1E), "cot((-0+1i))"
  assert cok(cot(cb(0x8000000000000000, 0xBFF0000000000000)), 0x8000000000000000, 0x3FF50231499B6B1E), "cot((-0-1i))"
  assert cok(cot(cb(0x8000000000000000, 0x7FF0000000000000)), 0x8000000000000000, NAN_BITS), "cot((-0+Infi))"
  assert cok(cot(cb(0x8000000000000000, 0xFFF0000000000000)), 0x8000000000000000, NAN_BITS), "cot((-0-Infi))"
  assert cok(cot(cb(0x8000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "cot((-0+NaNi))"
  assert cok(cot(cb(0x8000000000000000, 0x3FE0000000000000)), 0x8000000000000000, 0xC0014FC6CEB099BF), "cot((-0+0.5i))"
  assert cok(cot(cb(0x8000000000000000, 0xC000000000000000)), 0x8000000000000000, 0x3FF098D75212F273), "cot((-0-2i))"
  assert cok(cot(cb(0x8000000000000000, 0x000012688B70E62B)), 0x7FF0000000000000, 0x7FF0000000000000), "cot((-0+1e-310i))"
  assert cok(cot(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0x8000000000000000, NAN_BITS), "cot((-0+1e+300i))"
  assert cok(cot(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x8000000000000000, 0xBFF171FF596E026C), "cot((-0+1.5707963267948966i))"
  assert cok(cot(cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FE48C05D04E1CFD, 0x8000000000000000), "cot((1+0i))"
  assert cok(cot(cb(0x3FF0000000000000, 0x8000000000000000)), 0x3FE48C05D04E1CFD, 0x0000000000000000), "cot((1-0i))"
  assert cok(cot(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FCBDB05F988D84A, 0xBFEBC6C5988682D1), "cot((1+1i))"
  assert cok(cot(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FCBDB05F988D84A, 0x3FEBC6C5988682D1), "cot((1-1i))"
  assert cok(cot(cb(0x3FF0000000000000, 0x7FF0000000000000)), 0x0000000000000000, NAN_BITS), "cot((1+Infi))"
  assert cok(cot(cb(0x3FF0000000000000, 0xFFF0000000000000)), 0x0000000000000000, NAN_BITS), "cot((1-Infi))"
  assert cok(cot(cb(0x3FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "cot((1+NaNi))"
  assert cok(cot(cb(0x3FF0000000000000, 0x3FE0000000000000)), 0x3FDDB3FB3605D336, 0xBFE331CC4EADC1BE), "cot((1+0.5i))"
  assert cok(cot(cb(0x3FF0000000000000, 0xC000000000000000)), 0x3FA0CADE0ECCA199, 0x3FEF7FA00184512B), "cot((1-2i))"
  assert cok(cot(cb(0x3FF0000000000000, 0x000012688B70E62B)), 0x3FE48C05D04E1CFD, 0x800019FF7248175D), "cot((1+1e-310i))"
  assert cok(cot(cb(0x3FF0000000000000, 0x7E37E43C8800759C)), 0x0000000000000000, NAN_BITS), "cot((1+1e+300i))"
  assert cok(cot(cb(0x3FF0000000000000, 0x3FF921FB54442D18)), 0x3FB362A0641FF9DC, 0xBFEEC69F0AC89314), "cot((1+1.5707963267948966i))"
  assert cok(cot(cb(0xBFF0000000000000, 0x0000000000000000)), 0xBFE48C05D04E1CFD, 0x8000000000000000), "cot((-1+0i))"
  assert cok(cot(cb(0xBFF0000000000000, 0x8000000000000000)), 0xBFE48C05D04E1CFD, 0x0000000000000000), "cot((-1-0i))"
  assert cok(cot(cb(0xBFF0000000000000, 0x3FF0000000000000)), 0xBFCBDB05F988D84A, 0xBFEBC6C5988682D1), "cot((-1+1i))"
  assert cok(cot(cb(0xBFF0000000000000, 0xBFF0000000000000)), 0xBFCBDB05F988D84A, 0x3FEBC6C5988682D1), "cot((-1-1i))"
  assert cok(cot(cb(0xBFF0000000000000, 0x7FF0000000000000)), 0x8000000000000000, NAN_BITS), "cot((-1+Infi))"
  assert cok(cot(cb(0xBFF0000000000000, 0xFFF0000000000000)), 0x8000000000000000, NAN_BITS), "cot((-1-Infi))"
  assert cok(cot(cb(0xBFF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "cot((-1+NaNi))"
  assert cok(cot(cb(0xBFF0000000000000, 0x3FE0000000000000)), 0xBFDDB3FB3605D336, 0xBFE331CC4EADC1BE), "cot((-1+0.5i))"
  assert cok(cot(cb(0xBFF0000000000000, 0xC000000000000000)), 0xBFA0CADE0ECCA199, 0x3FEF7FA00184512B), "cot((-1-2i))"
  assert cok(cot(cb(0xBFF0000000000000, 0x000012688B70E62B)), 0xBFE48C05D04E1CFD, 0x800019FF7248175D), "cot((-1+1e-310i))"
  assert cok(cot(cb(0xBFF0000000000000, 0x7E37E43C8800759C)), 0x8000000000000000, NAN_BITS), "cot((-1+1e+300i))"
  assert cok(cot(cb(0xBFF0000000000000, 0x3FF921FB54442D18)), 0xBFB362A0641FF9DC, 0xBFEEC69F0AC89314), "cot((-1+1.5707963267948966i))"
  assert cok(cot(cb(0x7FF0000000000000, 0x0000000000000000)), NAN_BITS, NAN_BITS), "cot((+Inf+0i))"
  assert cok(cot(cb(0x7FF0000000000000, 0x8000000000000000)), NAN_BITS, NAN_BITS), "cot((+Inf-0i))"
  assert cok(cot(cb(0x7FF0000000000000, 0x3FF0000000000000)), NAN_BITS, NAN_BITS), "cot((+Inf+1i))"
  assert cok(cot(cb(0x7FF0000000000000, 0xBFF0000000000000)), NAN_BITS, NAN_BITS), "cot((+Inf-1i))"
  assert cok(cot(cb(0x7FF0000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "cot((+Inf+Infi))"
  assert cok(cot(cb(0x7FF0000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "cot((+Inf-Infi))"
  assert cok(cot(cb(0x7FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "cot((+Inf+NaNi))"
  assert cok(cot(cb(0x7FF0000000000000, 0x3FE0000000000000)), NAN_BITS, NAN_BITS), "cot((+Inf+0.5i))"
  assert cok(cot(cb(0x7FF0000000000000, 0xC000000000000000)), NAN_BITS, NAN_BITS), "cot((+Inf-2i))"
  assert cok(cot(cb(0x7FF0000000000000, 0x000012688B70E62B)), NAN_BITS, NAN_BITS), "cot((+Inf+1e-310i))"
  assert cok(cot(cb(0x7FF0000000000000, 0x7E37E43C8800759C)), NAN_BITS, NAN_BITS), "cot((+Inf+1e+300i))"
  assert cok(cot(cb(0x7FF0000000000000, 0x3FF921FB54442D18)), NAN_BITS, NAN_BITS), "cot((+Inf+1.5707963267948966i))"
  assert cok(cot(cb(0xFFF0000000000000, 0x0000000000000000)), NAN_BITS, NAN_BITS), "cot((-Inf+0i))"
  assert cok(cot(cb(0xFFF0000000000000, 0x8000000000000000)), NAN_BITS, NAN_BITS), "cot((-Inf-0i))"
  assert cok(cot(cb(0xFFF0000000000000, 0x3FF0000000000000)), NAN_BITS, NAN_BITS), "cot((-Inf+1i))"
  assert cok(cot(cb(0xFFF0000000000000, 0xBFF0000000000000)), NAN_BITS, NAN_BITS), "cot((-Inf-1i))"
  assert cok(cot(cb(0xFFF0000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "cot((-Inf+Infi))"
