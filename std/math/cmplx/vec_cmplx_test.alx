  assert cok(cos(cb(0x7FF0000000000000, 0x3FF0000000000000)), NAN_BITS, NAN_BITS), "cos((+Inf+1i))"
  assert cok(cos(cb(0x7FF0000000000000, 0xBFF0000000000000)), NAN_BITS, NAN_BITS), "cos((+Inf-1i))"
