test "acosh 2" {
  assert cok(acosh(cb(0xC000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FF921FB54442D18), "acosh((-2+Infi))"
  assert cok(acosh(cb(0xC000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xBFF921FB54442D18), "acosh((-2-Infi))"
  assert cok(acosh(cb(0xC000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "acosh((-2+NaNi))"
  assert cok(acosh(cb(0xC000000000000000, 0x3FE0000000000000)), 0x3FF5C9EFBDCD9088, 0x4006E9241B024137), "acosh((-2+0.5i))"
  assert cok(acosh(cb(0xC000000000000000, 0xC000000000000000)), 0x3FFBBFCB11C71110, 0xC00299B170AE3362), "acosh((-2-2i))"
  assert cok(acosh(cb(0xC000000000000000, 0x000012688B70E62B)), 0x3FF5124271980433, 0x400921FB54442D18), "acosh((-2+1e-310i))"
  assert cok(acosh(cb(0xC000000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0xBFF921FB54442D18), "acosh((-2+1e+300i))"
  assert cok(acosh(cb(0xC000000000000000, 0x3FF921FB54442D18)), 0x3FF9E960D5B6EA3B, 0x40037FC7A0F71C9C), "acosh((-2+1.5707963267948966i))"
  assert cok(acosh(cb(0x000012688B70E62B, 0x0000000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "acosh((1e-310+0i))"
  assert cok(acosh(cb(0x000012688B70E62B, 0x8000000000000000)), 0x8000000000000000, 0x3FF921FB54442D18), "acosh((1e-310-0i))"
  assert cok(acosh(cb(0x000012688B70E62B, 0x3FF0000000000000)), 0x3FEC34366179D425, 0x3FF921FB54442D18), "acosh((1e-310+1i))"
  assert cok(acosh(cb(0x000012688B70E62B, 0xBFF0000000000000)), 0x3FEC34366179D426, 0xBFF921FB54442D18), "acosh((1e-310-1i))"
  assert cok(acosh(cb(0x000012688B70E62B, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FF921FB54442D18), "acosh((1e-310+Infi))"
  assert cok(acosh(cb(0x000012688B70E62B, 0xFFF0000000000000)), 0x7FF0000000000000, 0xBFF921FB54442D18), "acosh((1e-310-Infi))"
  assert cok(acosh(cb(0x000012688B70E62B, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "acosh((1e-310+NaNi))"
  assert cok(acosh(cb(0x000012688B70E62B, 0x3FE0000000000000)), 0x3FDECC2CAEC51608, 0x3FF921FB54442D18), "acosh((1e-310+0.5i))"
  assert cok(acosh(cb(0x000012688B70E62B, 0xC000000000000000)), 0x3FF719218313D087, 0xBFF921FB54442D18), "acosh((1e-310-2i))"
  assert cok(acosh(cb(0x000012688B70E62B, 0x000012688B70E62B)), 0x8000000000000000, 0x3FF921FB54442D18), "acosh((1e-310+1e-310i))"
  assert cok(acosh(cb(0x000012688B70E62B, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0xBFF921FB54442D18), "acosh((1e-310+1e+300i))"
  assert cok(acosh(cb(0x000012688B70E62B, 0x3FF921FB54442D18)), 0x3FF3BC04E847EC05, 0x3FF921FB54442D18), "acosh((1e-310+1.5707963267948966i))"
  assert cok(acosh(cb(0x7E37E43C8800759C, 0x0000000000000000)), 0x7FF0000000000000, 0xC00921FB54442D18), "acosh((1e+300+0i))"
  assert cok(acosh(cb(0x7E37E43C8800759C, 0x8000000000000000)), 0x7FF0000000000000, 0x8000000000000000), "acosh((1e+300-0i))"
  assert cok(acosh(cb(0x7E37E43C8800759C, 0x3FF0000000000000)), 0x7FF0000000000000, 0xC00921FB54442D18), "acosh((1e+300+1i))"
