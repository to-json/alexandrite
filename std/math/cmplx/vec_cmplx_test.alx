  assert cok(sinh(cb(0xBFC4D03297FC2C30, 0xBFE696DE924495D8)), 0xBFBFD17BE6703587, 0xBFE508D24D1E59AB), "sinh((-0.16260368748803122-0.7059166771693368i))"
