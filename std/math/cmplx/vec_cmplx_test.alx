}

test "cosh 1" {
  assert cok(cosh(cb(0x0000000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "cosh((0+0i))"
  assert cok(cosh(cb(0x0000000000000000, 0x8000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "cosh((0-0i))"
  assert cok(cosh(cb(0x0000000000000000, 0x3FF0000000000000)), 0x3FE14A280FB5068C, 0x0000000000000000), "cosh((0+1i))"
  assert cok(cosh(cb(0x0000000000000000, 0xBFF0000000000000)), 0x3FE14A280FB5068C, 0x8000000000000000), "cosh((0-1i))"
  assert cok(cosh(cb(0x0000000000000000, 0x7FF0000000000000)), NAN_BITS, 0x0000000000000000), "cosh((0+Infi))"
  assert cok(cosh(cb(0x0000000000000000, 0xFFF0000000000000)), NAN_BITS, 0x8000000000000000), "cosh((0-Infi))"
  assert cok(cosh(cb(0x0000000000000000, 0x7FF8000000000001)), NAN_BITS, 0x0000000000000000), "cosh((0+NaNi))"
  assert cok(cosh(cb(0x0000000000000000, 0x3FE0000000000000)), 0x3FEC1528065B7D50, 0x0000000000000000), "cosh((0+0.5i))"
  assert cok(cosh(cb(0x0000000000000000, 0xC000000000000000)), 0xBFDAA22657537205, 0x8000000000000000), "cosh((0-2i))"
  assert cok(cosh(cb(0x0000000000000000, 0x000012688B70E62B)), 0x3FF0000000000000, 0x0000000000000000), "cosh((0+1e-310i))"
  assert cok(cosh(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0xBFE2699022ADC4C1, 0x8000000000000000), "cosh((0+1e+300i))"
  assert cok(cosh(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x3C91A62633145C00, 0x0000000000000000), "cosh((0+1.5707963267948966i))"
  assert cok(cosh(cb(0x8000000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "cosh((-0+0i))"
  assert cok(cosh(cb(0x8000000000000000, 0x8000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "cosh((-0-0i))"
  assert cok(cosh(cb(0x8000000000000000, 0x3FF0000000000000)), 0x3FE14A280FB5068C, 0x8000000000000000), "cosh((-0+1i))"
  assert cok(cosh(cb(0x8000000000000000, 0xBFF0000000000000)), 0x3FE14A280FB5068C, 0x0000000000000000), "cosh((-0-1i))"
  assert cok(cosh(cb(0x8000000000000000, 0x7FF0000000000000)), NAN_BITS, 0x8000000000000000), "cosh((-0+Infi))"
  assert cok(cosh(cb(0x8000000000000000, 0xFFF0000000000000)), NAN_BITS, 0x0000000000000000), "cosh((-0-Infi))"
  assert cok(cosh(cb(0x8000000000000000, 0x7FF8000000000001)), NAN_BITS, 0x8000000000000000), "cosh((-0+NaNi))"
  assert cok(cosh(cb(0x8000000000000000, 0x3FE0000000000000)), 0x3FEC1528065B7D50, 0x8000000000000000), "cosh((-0+0.5i))"
  assert cok(cosh(cb(0x8000000000000000, 0xC000000000000000)), 0xBFDAA22657537205, 0x0000000000000000), "cosh((-0-2i))"
  assert cok(cosh(cb(0x8000000000000000, 0x000012688B70E62B)), 0x3FF0000000000000, 0x8000000000000000), "cosh((-0+1e-310i))"
  assert cok(cosh(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0xBFE2699022ADC4C1, 0x0000000000000000), "cosh((-0+1e+300i))"
  assert cok(cosh(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x3C91A62633145C00, 0x8000000000000000), "cosh((-0+1.5707963267948966i))"
  assert cok(cosh(cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FF8B07551D9F550, 0x0000000000000000), "cosh((1+0i))"
  assert cok(cosh(cb(0x3FF0000000000000, 0x8000000000000000)), 0x3FF8B07551D9F550, 0x8000000000000000), "cosh((1-0i))"
  assert cok(cosh(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FEAADEA96F4359B, 0x3FEFA50CCD2AE8F3), "cosh((1+1i))"
  assert cok(cosh(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FEAADEA96F4359B, 0xBFEFA50CCD2AE8F3), "cosh((1-1i))"
