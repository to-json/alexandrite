test "asin 1" {
  assert cok(asin(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "asin((0+0i))"
  assert cok(asin(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "asin((0-0i))"
  assert cok(asin(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FEC34366179D427), "asin((0+1i))"
  assert cok(asin(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xBFEC34366179D427), "asin((0-1i))"
  assert cok(asin(cb(0x0000000000000000, 0x7FF0000000000000)), 0x0000000000000000, 0x7FF0000000000000), "asin((0+Infi))"
  assert cok(asin(cb(0x0000000000000000, 0xFFF0000000000000)), 0x0000000000000000, 0xFFF0000000000000), "asin((0-Infi))"
  assert cok(asin(cb(0x0000000000000000, 0x7FF8000000000001)), 0x0000000000000000, NAN_BITS), "asin((0+NaNi))"
  assert cok(asin(cb(0x0000000000000000, 0x3FE0000000000000)), 0x0000000000000000, 0x3FDECC2CAEC5160A), "asin((0+0.5i))"
  assert cok(asin(cb(0x0000000000000000, 0xC000000000000000)), 0x0000000000000000, 0xBFF719218313D087), "asin((0-2i))"
  assert cok(asin(cb(0x0000000000000000, 0x000012688B70E62B)), 0x0000000000000000, 0x000012688B70E62B), "asin((0+1e-310i))"
  assert cok(asin(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x0000000000000000, 0xFFF0000000000000), "asin((0+1e+300i))"
  assert cok(asin(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x0000000000000000, 0x3FF3BC04E847EC05), "asin((0+1.5707963267948966i))"
  assert cok(asin(cb(0x8000000000000000, 0x0000000000000000)), 0x8000000000000000, 0x0000000000000000), "asin((-0+0i))"
  assert cok(asin(cb(0x8000000000000000, 0x8000000000000000)), 0x8000000000000000, 0x8000000000000000), "asin((-0-0i))"
  assert cok(asin(cb(0x8000000000000000, 0x3FF0000000000000)), 0x8000000000000000, 0x3FEC34366179D427), "asin((-0+1i))"
  assert cok(asin(cb(0x8000000000000000, 0xBFF0000000000000)), 0x8000000000000000, 0xBFEC34366179D427), "asin((-0-1i))"
  assert cok(asin(cb(0x8000000000000000, 0x7FF0000000000000)), 0x8000000000000000, 0x7FF0000000000000), "asin((-0+Infi))"
  assert cok(asin(cb(0x8000000000000000, 0xFFF0000000000000)), 0x8000000000000000, 0xFFF0000000000000), "asin((-0-Infi))"
  assert cok(asin(cb(0x8000000000000000, 0x7FF8000000000001)), 0x8000000000000000, NAN_BITS), "asin((-0+NaNi))"
  assert cok(asin(cb(0x8000000000000000, 0x3FE0000000000000)), 0x8000000000000000, 0x3FDECC2CAEC5160A), "asin((-0+0.5i))"
  assert cok(asin(cb(0x8000000000000000, 0xC000000000000000)), 0x8000000000000000, 0xBFF719218313D087), "asin((-0-2i))"
  assert cok(asin(cb(0x8000000000000000, 0x000012688B70E62B)), 0x8000000000000000, 0x000012688B70E62B), "asin((-0+1e-310i))"
  assert cok(asin(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0x0000000000000000, 0xFFF0000000000000), "asin((-0+1e+300i))"
  assert cok(asin(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x0000000000000000, 0x3FF3BC04E847EC05), "asin((-0+1.5707963267948966i))"
  assert cok(asin(cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FF921FB54442D18, 0x0000000000000000), "asin((1+0i))"
  assert cok(asin(cb(0x3FF0000000000000, 0x8000000000000000)), 0x3FF921FB54442D18, 0x8000000000000000), "asin((1-0i))"
  assert cok(asin(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FE551D55BBB8CED, 0x3FF0FAFB8F2F147E), "asin((1+1i))"
  assert cok(asin(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FE551D55BBB8CED, 0xBFF0FAFB8F2F147F), "asin((1-1i))"
  assert cok(asin(cb(0x3FF0000000000000, 0x7FF0000000000000)), 0x0000000000000000, 0x7FF0000000000000), "asin((1+Infi))"
  assert cok(asin(cb(0x3FF0000000000000, 0xFFF0000000000000)), 0x0000000000000000, 0xFFF0000000000000), "asin((1-Infi))"
  assert cok(asin(cb(0x3FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "asin((1+NaNi))"
