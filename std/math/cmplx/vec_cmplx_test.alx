test "sinh 1" {
  assert cok(sinh(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "sinh((0+0i))"
  assert cok(sinh(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "sinh((0-0i))"
  assert cok(sinh(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FEAED548F090CEE), "sinh((0+1i))"
  assert cok(sinh(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xBFEAED548F090CEE), "sinh((0-1i))"
