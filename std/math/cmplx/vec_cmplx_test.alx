  assert cok(sqrt(cb(0x3FE0000000000000, 0xC000000000000000)), 0x3FF21B800F533866, 0xBFEC469413EB22E2), "sqrt((0.5-2i))"
  assert cok(sqrt(cb(0x3FE0000000000000, 0x000012688B70E62B)), 0x3FE6A09E667F3BCD, 0x00000D0445B5F9A8), "sqrt((0.5+1e-310i))"
