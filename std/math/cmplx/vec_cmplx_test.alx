  assert cok(sqrt(cb(0xC000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x3FF6A09E667F3BCD), "sqrt((-2+0i))"
  assert cok(sqrt(cb(0xC000000000000000, 0x8000000000000000)), 0x0000000000000000, 0xBFF6A09E667F3BCD), "sqrt((-2-0i))"
  assert cok(sqrt(cb(0xC000000000000000, 0x3FF0000000000000)), 0x3FD5FCE63A0FD5ED, 0x3FF749199C6DC181), "sqrt((-2+1i))"
  assert cok(sqrt(cb(0xC000000000000000, 0xBFF0000000000000)), 0x3FD5FCE63A0FD5ED, 0xBFF749199C6DC181), "sqrt((-2-1i))"
}

test "sqrt 2" {
  assert cok(sqrt(cb(0xC000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "sqrt((-2+Infi))"
  assert cok(sqrt(cb(0xC000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "sqrt((-2-Infi))"
  assert cok(sqrt(cb(0xC000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sqrt((-2+NaNi))"
  assert cok(sqrt(cb(0xC000000000000000, 0x3FE0000000000000)), 0x3FC6748EC06731E6, 0x3FF6CD04812EAD31), "sqrt((-2+0.5i))"
  assert cok(sqrt(cb(0xC000000000000000, 0xC000000000000000)), 0x3FE49852F983EFDD, 0xBFF8DC42193D5C03), "sqrt((-2-2i))"
  assert cok(sqrt(cb(0xC000000000000000, 0x000012688B70E62B)), 0x0000068222DAFCD4, 0x3FF6A09E667F3BCD), "sqrt((-2+1e-310i))"
  assert cok(sqrt(cb(0xC000000000000000, 0x7E37E43C8800759C)), 0x5F0BA66EC32ACB5F, 0x5F0BA66EC32ACB60), "sqrt((-2+1e+300i))"
  assert cok(sqrt(cb(0xC000000000000000, 0x3FF921FB54442D18)), 0x3FE0ACEC260A4FCE, 0x3FF81D5BCEF3FCFD), "sqrt((-2+1.5707963267948966i))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0x0000000000000000)), 0x1FC1297872D9CBAE, 0x0000000000000000), "sqrt((1e-310+0i))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0x8000000000000000)), 0x1FC1297872D9CBAE, 0x8000000000000000), "sqrt((1e-310-0i))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0x3FF0000000000000)), 0x3FE6A09E667F3BCD, 0x3FE6A09E667F3BCC), "sqrt((1e-310+1i))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0xBFF0000000000000)), 0x3FE6A09E667F3BCD, 0xBFE6A09E667F3BCC), "sqrt((1e-310-1i))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "sqrt((1e-310+Infi))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0xFFF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "sqrt((1e-310-Infi))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sqrt((1e-310+NaNi))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0x3FE0000000000000)), 0x3FE0000000000000, 0x3FE0000000000000), "sqrt((1e-310+0.5i))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0xC000000000000000)), 0x3FF0000000000000, 0xBFF0000000000000), "sqrt((1e-310-2i))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0x000012688B70E62B)), 0x1FC2DB09474A8F61, 0x1FAF3DB20D2B2E5B), "sqrt((1e-310+1e-310i))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0x7E37E43C8800759C)), 0x5F0BA66EC32ACB60, 0x5F0BA66EC32ACB5F), "sqrt((1e-310+1e+300i))"
  assert cok(sqrt(cb(0x000012688B70E62B, 0x3FF921FB54442D18)), 0x3FEC5BF891B4EF6A, 0x3FEC5BF891B4EF6B), "sqrt((1e-310+1.5707963267948966i))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0x0000000000000000)), 0x5F138D352E5096AF, 0x0000000000000000), "sqrt((1e+300+0i))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0x8000000000000000)), 0x5F138D352E5096AF, 0x8000000000000000), "sqrt((1e+300-0i))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0x3FF0000000000000)), 0x5F138D352E5096AF, 0x20BA2FE76A3F9475), "sqrt((1e+300+1i))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0xBFF0000000000000)), 0x5F138D352E5096AF, 0xA0BA2FE76A3F9475), "sqrt((1e+300-1i))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "sqrt((1e+300+Infi))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0xFFF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "sqrt((1e+300-Infi))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sqrt((1e+300+NaNi))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0x3FE0000000000000)), 0x5F138D352E5096AF, 0x20AA2FE76A3F9475), "sqrt((1e+300+0.5i))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0xC000000000000000)), 0x5F138D352E5096AF, 0xA0CA2FE76A3F9475), "sqrt((1e+300-2i))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0x000012688B70E62B)), 0x5F138D352E5096AF, 0x0000000000000000), "sqrt((1e+300+1e-310i))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0x7E37E43C8800759C)), 0x5F157B2468F15C93, 0x5F01CBA37A2EACF6), "sqrt((1e+300+1e+300i))"
  assert cok(sqrt(cb(0x7E37E43C8800759C, 0x3FF921FB54442D18)), 0x5F138D352E5096AF, 0x20C4913BDE5BF119), "sqrt((1e+300+1.5707963267948966i))"
  assert cok(sqrt(cb(0x3FF921FB54442D18, 0x0000000000000000)), 0x3FF40D931FF62705, 0x0000000000000000), "sqrt((1.5707963267948966+0i))"
  assert cok(sqrt(cb(0x3FF921FB54442D18, 0x8000000000000000)), 0x3FF40D931FF62705, 0x8000000000000000), "sqrt((1.5707963267948966-0i))"
  assert cok(sqrt(cb(0x3FF921FB54442D18, 0x3FF0000000000000)), 0x3FF4F64D12819A1D, 0x3FD86CCDFA900F38), "sqrt((1.5707963267948966+1i))"
  assert cok(sqrt(cb(0x3FF921FB54442D18, 0xBFF0000000000000)), 0x3FF4F64D12819A1D, 0xBFD86CCDFA900F38), "sqrt((1.5707963267948966-1i))"
  assert cok(sqrt(cb(0x3FF921FB54442D18, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "sqrt((1.5707963267948966+Infi))"
  assert cok(sqrt(cb(0x3FF921FB54442D18, 0xFFF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "sqrt((1.5707963267948966-Infi))"
  assert cok(sqrt(cb(0x3FF921FB54442D18, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sqrt((1.5707963267948966+NaNi))"
  assert cok(sqrt(cb(0x3FF921FB54442D18, 0x3FE0000000000000)), 0x3FF44CA2EE124870, 0x3FC938F3B52990B5), "sqrt((1.5707963267948966+0.5i))"
  assert cok(sqrt(cb(0x3FF921FB54442D18, 0xC000000000000000)), 0x3FF6F2840893A822, 0xBFE64FDD0CEDC76B), "sqrt((1.5707963267948966-2i))"
