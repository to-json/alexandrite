  assert cok(asinh(cb(0xBF8738FEB2BC759E, 0xC030B9BF8C06766C)), 0xC00C12D321F10BF9, 0xBFF91F332B2E1227), "asinh((-0.011339177922816298-16.725579024865894i))"
}

test "acosh 1" {
  assert cok(acosh(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "acosh((0+0i))"
  assert cok(acosh(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "acosh((0-0i))"
  assert cok(acosh(cb(0x0000000000000000, 0x3FF0000000000000)), 0x3FEC34366179D427, 0x3FF921FB54442D18), "acosh((0+1i))"
  assert cok(acosh(cb(0x0000000000000000, 0xBFF0000000000000)), 0x3FEC34366179D427, 0xBFF921FB54442D18), "acosh((0-1i))"
  assert cok(acosh(cb(0x0000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FF921FB54442D18), "acosh((0+Infi))"
  assert cok(acosh(cb(0x0000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xBFF921FB54442D18), "acosh((0-Infi))"
  assert cok(acosh(cb(0x0000000000000000, 0x7FF8000000000001)), NAN_BITS, 0xBFF921FB54442D18), "acosh((0+NaNi))"
  assert cok(acosh(cb(0x0000000000000000, 0x3FE0000000000000)), 0x3FDECC2CAEC5160A, 0x3FF921FB54442D18), "acosh((0+0.5i))"
  assert cok(acosh(cb(0x0000000000000000, 0xC000000000000000)), 0x3FF719218313D087, 0xBFF921FB54442D18), "acosh((0-2i))"
  assert cok(acosh(cb(0x0000000000000000, 0x000012688B70E62B)), 0x000012688B70E62B, 0x3FF921FB54442D18), "acosh((0+1e-310i))"
  assert cok(acosh(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0xBFF921FB54442D18), "acosh((0+1e+300i))"
  assert cok(acosh(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x3FF3BC04E847EC05, 0x3FF921FB54442D18), "acosh((0+1.5707963267948966i))"
  assert cok(acosh(cb(0x8000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "acosh((-0+0i))"
  assert cok(acosh(cb(0x8000000000000000, 0x8000000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "acosh((-0-0i))"
