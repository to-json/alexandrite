test "log10 3" {
  assert cok(log10(cb(0xBFC4D03297FC2C30, 0xBFE696DE924495D8)), 0xBFC1EC2FB5A3A35C, 0xBFE8F9F0C79BB29B), "log10((-0.16260368748803122-0.7059166771693368i))"
  assert cok(log10(cb(0xBFD243B5D337796C, 0x3FC4CB17DB74B0C4)), 0xBFDEF3B6001C2554, 0x3FF23BF20208A91A), "log10((-0.28538270594244497+0.16244791236511535i))"
  assert cok(log10(cb(0xBFFBA730F579C1B2, 0x3FD277A756CDDEF8)), 0x3FCF2E14132C670C, 0x3FF4AE34ECFF8D9A), "log10((-1.7283181752101027+0.2885530803391556i))"
  assert cok(log10(cb(0xBF8738FEB2BC759E, 0xC030B9BF8C06766C)), 0x3FF392F83AC400D2, 0xBFE5D6E5C48BC2B8), "log10((-0.011339177922816298-16.725579024865894i))"
}

test "sin 1" {
  assert cok(sin(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "sin((0+0i))"
  assert cok(sin(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "sin((0-0i))"
  assert cok(sin(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FF2CD9FC44EB982), "sin((0+1i))"
  assert cok(sin(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xBFF2CD9FC44EB982), "sin((0-1i))"
  assert cok(sin(cb(0x0000000000000000, 0x7FF0000000000000)), 0x0000000000000000, 0x7FF0000000000000), "sin((0+Infi))"
  assert cok(sin(cb(0x0000000000000000, 0xFFF0000000000000)), 0x0000000000000000, 0xFFF0000000000000), "sin((0-Infi))"
  assert cok(sin(cb(0x0000000000000000, 0x7FF8000000000001)), 0x0000000000000000, NAN_BITS), "sin((0+NaNi))"
  assert cok(sin(cb(0x0000000000000000, 0x3FE0000000000000)), 0x0000000000000000, 0x3FE0ACD00FE63B97), "sin((0+0.5i))"
  assert cok(sin(cb(0x0000000000000000, 0xC000000000000000)), 0x0000000000000000, 0xC00D03CF63B6E19F), "sin((0-2i))"
  assert cok(sin(cb(0x0000000000000000, 0x000012688B70E62B)), 0x0000000000000000, 0x000012688B70E62B), "sin((0+1e-310i))"
  assert cok(sin(cb(0x0000000000000000, 0x7E37E43C8800759C)), NAN_BITS, 0x7FF0000000000000), "sin((0+1e+300i))"
  assert cok(sin(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x0000000000000000, 0x4002690F661DD820), "sin((0+1.5707963267948966i))"
  assert cok(sin(cb(0x8000000000000000, 0x0000000000000000)), 0x8000000000000000, 0x0000000000000000), "sin((-0+0i))"
  assert cok(sin(cb(0x8000000000000000, 0x8000000000000000)), 0x8000000000000000, 0x8000000000000000), "sin((-0-0i))"
  assert cok(sin(cb(0x8000000000000000, 0x3FF0000000000000)), 0x8000000000000000, 0x3FF2CD9FC44EB982), "sin((-0+1i))"
  assert cok(sin(cb(0x8000000000000000, 0xBFF0000000000000)), 0x8000000000000000, 0xBFF2CD9FC44EB982), "sin((-0-1i))"
  assert cok(sin(cb(0x8000000000000000, 0x7FF0000000000000)), 0x8000000000000000, 0x7FF0000000000000), "sin((-0+Infi))"
  assert cok(sin(cb(0x8000000000000000, 0xFFF0000000000000)), 0x8000000000000000, 0xFFF0000000000000), "sin((-0-Infi))"
  assert cok(sin(cb(0x8000000000000000, 0x7FF8000000000001)), 0x8000000000000000, NAN_BITS), "sin((-0+NaNi))"
  assert cok(sin(cb(0x8000000000000000, 0x3FE0000000000000)), 0x8000000000000000, 0x3FE0ACD00FE63B97), "sin((-0+0.5i))"
  assert cok(sin(cb(0x8000000000000000, 0xC000000000000000)), 0x8000000000000000, 0xC00D03CF63B6E19F), "sin((-0-2i))"
  assert cok(sin(cb(0x8000000000000000, 0x000012688B70E62B)), 0x8000000000000000, 0x000012688B70E62B), "sin((-0+1e-310i))"
  assert cok(sin(cb(0x8000000000000000, 0x7E37E43C8800759C)), NAN_BITS, 0x7FF0000000000000), "sin((-0+1e+300i))"
  assert cok(sin(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x8000000000000000, 0x4002690F661DD820), "sin((-0+1.5707963267948966i))"
  assert cok(sin(cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FEAED548F090CEE, 0x0000000000000000), "sin((1+0i))"
  assert cok(sin(cb(0x3FF0000000000000, 0x8000000000000000)), 0x3FEAED548F090CEE, 0x8000000000000000), "sin((1-0i))"
  assert cok(sin(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FF4C67B74F6CC4F, 0x3FE4519FD8047F92), "sin((1+1i))"
  assert cok(sin(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FF4C67B74F6CC4F, 0xBFE4519FD8047F92), "sin((1-1i))"
  assert cok(sin(cb(0x3FF0000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "sin((1+Infi))"
  assert cok(sin(cb(0x3FF0000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "sin((1-Infi))"
  assert cok(sin(cb(0x3FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sin((1+NaNi))"
  assert cok(sin(cb(0x3FF0000000000000, 0x3FE0000000000000)), 0x3FEE5D19265B6C8C, 0x3FD204E61394FCB7), "sin((1+0.5i))"
  assert cok(sin(cb(0x3FF0000000000000, 0xC000000000000000)), 0x40095383AF6524C0, 0xBFFF5A869F21D03D), "sin((1-2i))"
  assert cok(sin(cb(0x3FF0000000000000, 0x000012688B70E62B)), 0x3FEAED548F090CEE, 0x000009F232E226CD), "sin((1+1e-310i))"
  assert cok(sin(cb(0x3FF0000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0x7FF0000000000000), "sin((1+1e+300i))"
  assert cok(sin(cb(0x3FF0000000000000, 0x3FF921FB54442D18)), 0x4000E42625BF93E5, 0x3FF3E4F45C71496B), "sin((1+1.5707963267948966i))"
  assert cok(sin(cb(0xBFF0000000000000, 0x0000000000000000)), 0xBFEAED548F090CEE, 0x0000000000000000), "sin((-1+0i))"
  assert cok(sin(cb(0xBFF0000000000000, 0x8000000000000000)), 0xBFEAED548F090CEE, 0x8000000000000000), "sin((-1-0i))"
  assert cok(sin(cb(0xBFF0000000000000, 0x3FF0000000000000)), 0xBFF4C67B74F6CC4F, 0x3FE4519FD8047F92), "sin((-1+1i))"
  assert cok(sin(cb(0xBFF0000000000000, 0xBFF0000000000000)), 0xBFF4C67B74F6CC4F, 0xBFE4519FD8047F92), "sin((-1-1i))"
  assert cok(sin(cb(0xBFF0000000000000, 0x7FF0000000000000)), 0xFFF0000000000000, 0x7FF0000000000000), "sin((-1+Infi))"
  assert cok(sin(cb(0xBFF0000000000000, 0xFFF0000000000000)), 0xFFF0000000000000, 0xFFF0000000000000), "sin((-1-Infi))"
  assert cok(sin(cb(0xBFF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sin((-1+NaNi))"
