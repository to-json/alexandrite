test "sinh 2" {
  assert cok(sinh(cb(0xC000000000000000, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "sinh((-2+Infi))"
  assert cok(sinh(cb(0xC000000000000000, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "sinh((-2-Infi))"
  assert cok(sinh(cb(0xC000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sinh((-2+NaNi))"
  assert cok(sinh(cb(0xC000000000000000, 0x3FE0000000000000)), 0xC009768441E05D6C, 0x3FFCDBECDF358452), "sinh((-2+0.5i))"
  assert cok(sinh(cb(0xC000000000000000, 0xC000000000000000)), 0x3FF8261E8EA1B0AC, 0xC00B5E1D950CB7E4), "sinh((-2-2i))"
  assert cok(sinh(cb(0xC000000000000000, 0x000012688B70E62B)), 0xC00D03CF63B6E19F, 0x0000454183ECD00E), "sinh((-2+1e-310i))"
  assert cok(sinh(cb(0xC000000000000000, 0x7E37E43C8800759C)), 0x4000B1DBD92CEB0E, 0xC0089DC2D9EDAA33), "sinh((-2+1e+300i))"
  assert cok(sinh(cb(0xC000000000000000, 0x3FF921FB54442D18)), 0xBCB000AC93A53B4C, 0x400E18FA0DF2D9BB), "sinh((-2+1.5707963267948966i))"
  assert cok(sinh(cb(0x000012688B70E62B, 0x0000000000000000)), 0x000012688B70E62B, 0x0000000000000000), "sinh((1e-310+0i))"
  assert cok(sinh(cb(0x000012688B70E62B, 0x8000000000000000)), 0x000012688B70E62B, 0x8000000000000000), "sinh((1e-310-0i))"
  assert cok(sinh(cb(0x000012688B70E62B, 0x3FF0000000000000)), 0x000009F232E226CD, 0x3FEAED548F090CEE), "sinh((1e-310+1i))"
  assert cok(sinh(cb(0x000012688B70E62B, 0xBFF0000000000000)), 0x000009F232E226CD, 0xBFEAED548F090CEE), "sinh((1e-310-1i))"
  assert cok(sinh(cb(0x000012688B70E62B, 0x7FF0000000000000)), NAN_BITS, NAN_BITS), "sinh((1e-310+Infi))"
  assert cok(sinh(cb(0x000012688B70E62B, 0xFFF0000000000000)), NAN_BITS, NAN_BITS), "sinh((1e-310-Infi))"
  assert cok(sinh(cb(0x000012688B70E62B, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sinh((1e-310+NaNi))"
  assert cok(sinh(cb(0x000012688B70E62B, 0x3FE0000000000000)), 0x00001027A5A4A205, 0x3FDEAEE8744B05F0), "sinh((1e-310+0.5i))"
  assert cok(sinh(cb(0x000012688B70E62B, 0xC000000000000000)), 0x800007A91C4E0431, 0xBFED18F6EAD1B445), "sinh((1e-310-2i))"
  assert cok(sinh(cb(0x000012688B70E62B, 0x000012688B70E62B)), 0x000012688B70E62B, 0x000012688B70E62B), "sinh((1e-310+1e-310i))"
  assert cok(sinh(cb(0x000012688B70E62B, 0x7E37E43C8800759C)), 0x80000A9788637272, 0xBFEA2C16B010E386), "sinh((1e-310+1e+300i))"
  assert cok(sinh(cb(0x000012688B70E62B, 0x3FF921FB54442D18)), 0x0000000000000000, 0x3FF0000000000000), "sinh((1e-310+1.5707963267948966i))"
  assert cok(sinh(cb(0x7E37E43C8800759C, 0x0000000000000000)), 0x7FF0000000000000, NAN_BITS), "sinh((1e+300+0i))"
