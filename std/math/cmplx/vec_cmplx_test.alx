# Generated from Go's math/cmplx (go1.27.1, GOOS=js GOARCH=wasm: the portable
# math, no FMA); do not edit by hand. Exact bits; a NaN part matches any NaN.

NAN_BITS: U64 = 0x7FF8000000000001

def cb(r: U64, i: U64) -> Complex { Complex.new(math.float64frombits(r), math.float64frombits(i)) }

def fok(got: Float, want: U64) -> Bool {
  return math.is_nan(got) if want == NAN_BITS
  math.float64bits(got) == want
}

def cok(got: Complex, re: U64, im: U64) -> Bool { fok(got.real, re) && fok(got.imag, im) }

test "sqrt 1" {
  assert cok(sqrt(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "sqrt((0+0i))"
  assert cok(sqrt(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "sqrt((0-0i))"
  assert cok(sqrt(cb(0x0000000000000000, 0x3FF0000000000000)), 0x3FE6A09E667F3BCD, 0x3FE6A09E667F3BCD), "sqrt((0+1i))"
  assert cok(sqrt(cb(0x0000000000000000, 0xBFF0000000000000)), 0x3FE6A09E667F3BCD, 0xBFE6A09E667F3BCD), "sqrt((0-1i))"
  assert cok(sqrt(cb(0x0000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "sqrt((0+Infi))"
  assert cok(sqrt(cb(0x0000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "sqrt((0-Infi))"
  assert cok(sqrt(cb(0x0000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sqrt((0+NaNi))"
  assert cok(sqrt(cb(0x0000000000000000, 0x3FE0000000000000)), 0x3FE0000000000000, 0x3FE0000000000000), "sqrt((0+0.5i))"
  assert cok(sqrt(cb(0x0000000000000000, 0xC000000000000000)), 0x3FF0000000000000, 0xBFF0000000000000), "sqrt((0-2i))"
  assert cok(sqrt(cb(0x0000000000000000, 0x000012688B70E62B)), 0x1FB8454E39DE41FF, 0x1FB8454E39DE41FF), "sqrt((0+1e-310i))"
  assert cok(sqrt(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x5F0BA66EC32ACB60, 0x5F0BA66EC32ACB60), "sqrt((0+1e+300i))"
  assert cok(sqrt(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x3FEC5BF891B4EF6A, 0x3FEC5BF891B4EF6A), "sqrt((0+1.5707963267948966i))"
  assert cok(sqrt(cb(0x8000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "sqrt((-0+0i))"
  assert cok(sqrt(cb(0x8000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "sqrt((-0-0i))"
  assert cok(sqrt(cb(0x8000000000000000, 0x3FF0000000000000)), 0x3FE6A09E667F3BCD, 0x3FE6A09E667F3BCD), "sqrt((-0+1i))"
  assert cok(sqrt(cb(0x8000000000000000, 0xBFF0000000000000)), 0x3FE6A09E667F3BCD, 0xBFE6A09E667F3BCD), "sqrt((-0-1i))"
  assert cok(sqrt(cb(0x8000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "sqrt((-0+Infi))"
  assert cok(sqrt(cb(0x8000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "sqrt((-0-Infi))"
  assert cok(sqrt(cb(0x8000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sqrt((-0+NaNi))"
  assert cok(sqrt(cb(0x8000000000000000, 0x3FE0000000000000)), 0x3FE0000000000000, 0x3FE0000000000000), "sqrt((-0+0.5i))"
  assert cok(sqrt(cb(0x8000000000000000, 0xC000000000000000)), 0x3FF0000000000000, 0xBFF0000000000000), "sqrt((-0-2i))"
  assert cok(sqrt(cb(0x8000000000000000, 0x000012688B70E62B)), 0x1FB8454E39DE41FF, 0x1FB8454E39DE41FF), "sqrt((-0+1e-310i))"
  assert cok(sqrt(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0x5F0BA66EC32ACB60, 0x5F0BA66EC32ACB60), "sqrt((-0+1e+300i))"
  assert cok(sqrt(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x3FEC5BF891B4EF6A, 0x3FEC5BF891B4EF6A), "sqrt((-0+1.5707963267948966i))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "sqrt((1+0i))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0x8000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "sqrt((1-0i))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FF19435CAFFA9F9, 0x3FDD203138F6C828), "sqrt((1+1i))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FF19435CAFFA9F9, 0xBFDD203138F6C828), "sqrt((1-1i))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "sqrt((1+Infi))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "sqrt((1-Infi))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sqrt((1+NaNi))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0x3FE0000000000000)), 0x3FF077225F1DA572, 0x3FCF18773C56F721), "sqrt((1+0.5i))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0xC000000000000000)), 0x3FF45A3146A88456, 0xBFE92826EF258D1B), "sqrt((1-2i))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0x000012688B70E62B)), 0x3FF0000000000000, 0x0000093445B87316), "sqrt((1+1e-310i))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0x7E37E43C8800759C)), 0x5F0BA66EC32ACB60, 0x5F0BA66EC32ACB5F), "sqrt((1+1e+300i))"
  assert cok(sqrt(cb(0x3FF0000000000000, 0x3FF921FB54442D18)), 0x3FF323E5E3BDCF2B, 0x3FE502653DDED067), "sqrt((1+1.5707963267948966i))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0x0000000000000000)), 0x0000000000000000, 0x3FF0000000000000), "sqrt((-1+0i))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0x8000000000000000)), 0x0000000000000000, 0xBFF0000000000000), "sqrt((-1-0i))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0x3FF0000000000000)), 0x3FDD203138F6C828, 0x3FF19435CAFFA9F9), "sqrt((-1+1i))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0xBFF0000000000000)), 0x3FDD203138F6C828, 0xBFF19435CAFFA9F9), "sqrt((-1-1i))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "sqrt((-1+Infi))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "sqrt((-1-Infi))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "sqrt((-1+NaNi))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0x3FE0000000000000)), 0x3FCF18773C56F721, 0x3FF077225F1DA572), "sqrt((-1+0.5i))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0xC000000000000000)), 0x3FE92826EF258D1B, 0xBFF45A3146A88456), "sqrt((-1-2i))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0x000012688B70E62B)), 0x0000093445B87316, 0x3FF0000000000000), "sqrt((-1+1e-310i))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0x7E37E43C8800759C)), 0x5F0BA66EC32ACB5F, 0x5F0BA66EC32ACB60), "sqrt((-1+1e+300i))"
  assert cok(sqrt(cb(0xBFF0000000000000, 0x3FF921FB54442D18)), 0x3FE502653DDED067, 0x3FF323E5E3BDCF2B), "sqrt((-1+1.5707963267948966i))"
  assert cok(sqrt(cb(0x7FF0000000000000, 0x0000000000000000)), 0x7FF0000000000000, 0x0000000000000000), "sqrt((+Inf+0i))"
  assert cok(sqrt(cb(0x7FF0000000000000, 0x8000000000000000)), 0x7FF0000000000000, 0x8000000000000000), "sqrt((+Inf-0i))"
  assert cok(sqrt(cb(0x7FF0000000000000, 0x3FF0000000000000)), 0x7FF0000000000000, 0x0000000000000000), "sqrt((+Inf+1i))"
  assert cok(sqrt(cb(0x7FF0000000000000, 0xBFF0000000000000)), 0x7FF0000000000000, 0x8000000000000000), "sqrt((+Inf-1i))"
  assert cok(sqrt(cb(0x7FF0000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "sqrt((+Inf+Infi))"
  assert cok(sqrt(cb(0x7FF0000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "sqrt((+Inf-Infi))"
