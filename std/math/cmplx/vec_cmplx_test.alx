test "asinh 1" {
  assert cok(asinh(cb(0x0000000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "asinh((0+0i))"
  assert cok(asinh(cb(0x0000000000000000, 0x8000000000000000)), 0x0000000000000000, 0x8000000000000000), "asinh((0-0i))"
  assert cok(asinh(cb(0x0000000000000000, 0x3FF0000000000000)), 0x0000000000000000, 0x3FF921FB54442D18), "asinh((0+1i))"
  assert cok(asinh(cb(0x0000000000000000, 0xBFF0000000000000)), 0x0000000000000000, 0xBFF921FB54442D18), "asinh((0-1i))"
  assert cok(asinh(cb(0x0000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x3FF921FB54442D18), "asinh((0+Infi))"
  assert cok(asinh(cb(0x0000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0xBFF921FB54442D18), "asinh((0-Infi))"
  assert cok(asinh(cb(0x0000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "asinh((0+NaNi))"
  assert cok(asinh(cb(0x0000000000000000, 0x3FE0000000000000)), 0x0000000000000000, 0x3FE0C152382D7366), "asinh((0+0.5i))"
  assert cok(asinh(cb(0x0000000000000000, 0xC000000000000000)), 0x3FF5124271980434, 0xBFF921FB54442D18), "asinh((0-2i))"
  assert cok(asinh(cb(0x0000000000000000, 0x000012688B70E62B)), 0x0000000000000000, 0x000012688B70E62B), "asinh((0+1e-310i))"
  assert cok(asinh(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0x3FF921FB54442D18), "asinh((0+1e+300i))"
  assert cok(asinh(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x3FF05F23C6CBAF31, 0x3FF921FB54442D18), "asinh((0+1.5707963267948966i))"
  assert cok(asinh(cb(0x8000000000000000, 0x0000000000000000)), 0x8000000000000000, 0x0000000000000000), "asinh((-0+0i))"
  assert cok(asinh(cb(0x8000000000000000, 0x8000000000000000)), 0x8000000000000000, 0x8000000000000000), "asinh((-0-0i))"
  assert cok(asinh(cb(0x8000000000000000, 0x3FF0000000000000)), 0x8000000000000000, 0x3FF921FB54442D18), "asinh((-0+1i))"
  assert cok(asinh(cb(0x8000000000000000, 0xBFF0000000000000)), 0x8000000000000000, 0xBFF921FB54442D18), "asinh((-0-1i))"
  assert cok(asinh(cb(0x8000000000000000, 0x7FF0000000000000)), 0xFFF0000000000000, 0x3FF921FB54442D18), "asinh((-0+Infi))"
  assert cok(asinh(cb(0x8000000000000000, 0xFFF0000000000000)), 0xFFF0000000000000, 0xBFF921FB54442D18), "asinh((-0-Infi))"
  assert cok(asinh(cb(0x8000000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "asinh((-0+NaNi))"
  assert cok(asinh(cb(0x8000000000000000, 0x3FE0000000000000)), 0x8000000000000000, 0x3FE0C152382D7366), "asinh((-0+0.5i))"
  assert cok(asinh(cb(0x8000000000000000, 0xC000000000000000)), 0xBFF5124271980433, 0xBFF921FB54442D18), "asinh((-0-2i))"
  assert cok(asinh(cb(0x8000000000000000, 0x000012688B70E62B)), 0x8000000000000000, 0x000012688B70E62B), "asinh((-0+1e-310i))"
  assert cok(asinh(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0xBFF921FB54442D18), "asinh((-0+1e+300i))"
  assert cok(asinh(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0xBFF05F23C6CBAF31, 0x3FF921FB54442D18), "asinh((-0+1.5707963267948966i))"
  assert cok(asinh(cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FEC34366179D427, 0x0000000000000000), "asinh((1+0i))"
  assert cok(asinh(cb(0x3FF0000000000000, 0x8000000000000000)), 0x3FEC34366179D427, 0x8000000000000000), "asinh((1-0i))"
