test "cos 1" {
  assert cok(cos(cb(0x0000000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "cos((0+0i))"
  assert cok(cos(cb(0x0000000000000000, 0x8000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "cos((0-0i))"
  assert cok(cos(cb(0x0000000000000000, 0x3FF0000000000000)), 0x3FF8B07551D9F550, 0x8000000000000000), "cos((0+1i))"
  assert cok(cos(cb(0x0000000000000000, 0xBFF0000000000000)), 0x3FF8B07551D9F550, 0x0000000000000000), "cos((0-1i))"
  assert cok(cos(cb(0x0000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x8000000000000000), "cos((0+Infi))"
  assert cok(cos(cb(0x0000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0x0000000000000000), "cos((0-Infi))"
  assert cok(cos(cb(0x0000000000000000, 0x7FF8000000000001)), NAN_BITS, 0x0000000000000000), "cos((0+NaNi))"
  assert cok(cos(cb(0x0000000000000000, 0x3FE0000000000000)), 0x3FF20AC1862AE8D0, 0x8000000000000000), "cos((0+0.5i))"
  assert cok(cos(cb(0x0000000000000000, 0xC000000000000000)), 0x400E18FA0DF2D9BB, 0x0000000000000000), "cos((0-2i))"
  assert cok(cos(cb(0x0000000000000000, 0x000012688B70E62B)), 0x3FF0000000000000, 0x8000000000000000), "cos((0+1e-310i))"
  assert cok(cos(cb(0x0000000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, NAN_BITS), "cos((0+1e+300i))"
  assert cok(cos(cb(0x0000000000000000, 0x3FF921FB54442D18)), 0x400412CC2A8D4E9E, 0x8000000000000000), "cos((0+1.5707963267948966i))"
  assert cok(cos(cb(0x8000000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "cos((-0+0i))"
  assert cok(cos(cb(0x8000000000000000, 0x8000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "cos((-0-0i))"
  assert cok(cos(cb(0x8000000000000000, 0x3FF0000000000000)), 0x3FF8B07551D9F550, 0x0000000000000000), "cos((-0+1i))"
  assert cok(cos(cb(0x8000000000000000, 0xBFF0000000000000)), 0x3FF8B07551D9F550, 0x8000000000000000), "cos((-0-1i))"
  assert cok(cos(cb(0x8000000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x0000000000000000), "cos((-0+Infi))"
  assert cok(cos(cb(0x8000000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0x8000000000000000), "cos((-0-Infi))"
  assert cok(cos(cb(0x8000000000000000, 0x7FF8000000000001)), NAN_BITS, 0x0000000000000000), "cos((-0+NaNi))"
  assert cok(cos(cb(0x8000000000000000, 0x3FE0000000000000)), 0x3FF20AC1862AE8D0, 0x0000000000000000), "cos((-0+0.5i))"
  assert cok(cos(cb(0x8000000000000000, 0xC000000000000000)), 0x400E18FA0DF2D9BB, 0x8000000000000000), "cos((-0-2i))"
  assert cok(cos(cb(0x8000000000000000, 0x000012688B70E62B)), 0x3FF0000000000000, 0x0000000000000000), "cos((-0+1e-310i))"
  assert cok(cos(cb(0x8000000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, NAN_BITS), "cos((-0+1e+300i))"
  assert cok(cos(cb(0x8000000000000000, 0x3FF921FB54442D18)), 0x400412CC2A8D4E9E, 0x0000000000000000), "cos((-0+1.5707963267948966i))"
  assert cok(cos(cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FE14A280FB5068C, 0x8000000000000000), "cos((1+0i))"
  assert cok(cos(cb(0x3FF0000000000000, 0x8000000000000000)), 0x3FE14A280FB5068C, 0x0000000000000000), "cos((1-0i))"
  assert cok(cos(cb(0x3FF0000000000000, 0x3FF0000000000000)), 0x3FEAADEA96F4359B, 0xBFEFA50CCD2AE8F3), "cos((1+1i))"
  assert cok(cos(cb(0x3FF0000000000000, 0xBFF0000000000000)), 0x3FEAADEA96F4359B, 0x3FEFA50CCD2AE8F3), "cos((1-1i))"
  assert cok(cos(cb(0x3FF0000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "cos((1+Infi))"
  assert cok(cos(cb(0x3FF0000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "cos((1-Infi))"
  assert cok(cos(cb(0x3FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "cos((1+NaNi))"
  assert cok(cos(cb(0x3FF0000000000000, 0x3FE0000000000000)), 0x3FE37F0C8A3423BA, 0xBFDC102A0417E8DE), "cos((1+0.5i))"
  assert cok(cos(cb(0x3FF0000000000000, 0xC000000000000000)), 0x4000430447A7CF58, 0x40086A4964B0BB19), "cos((1-2i))"
  assert cok(cos(cb(0x3FF0000000000000, 0x000012688B70E62B)), 0x3FE14A280FB5068C, 0x80000F7D78392D98), "cos((1+1e-310i))"
  assert cok(cos(cb(0x3FF0000000000000, 0x7E37E43C8800759C)), 0x7FF0000000000000, 0xFFF0000000000000), "cos((1+1e+300i))"
  assert cok(cos(cb(0x3FF0000000000000, 0x3FF921FB54442D18)), 0x3FF5B102202E17B9, 0xBFFEFBCE862F54FC), "cos((1+1.5707963267948966i))"
  assert cok(cos(cb(0xBFF0000000000000, 0x0000000000000000)), 0x3FE14A280FB5068C, 0x0000000000000000), "cos((-1+0i))"
  assert cok(cos(cb(0xBFF0000000000000, 0x8000000000000000)), 0x3FE14A280FB5068C, 0x8000000000000000), "cos((-1-0i))"
  assert cok(cos(cb(0xBFF0000000000000, 0x3FF0000000000000)), 0x3FEAADEA96F4359B, 0x3FEFA50CCD2AE8F3), "cos((-1+1i))"
  assert cok(cos(cb(0xBFF0000000000000, 0xBFF0000000000000)), 0x3FEAADEA96F4359B, 0xBFEFA50CCD2AE8F3), "cos((-1-1i))"
  assert cok(cos(cb(0xBFF0000000000000, 0x7FF0000000000000)), 0x7FF0000000000000, 0x7FF0000000000000), "cos((-1+Infi))"
