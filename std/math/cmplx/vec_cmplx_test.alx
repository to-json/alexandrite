  assert cok(sqrt(cb(0x7FF8000000000001, 0x3FE0000000000000)), NAN_BITS, NAN_BITS), "sqrt((NaN+0.5i))"
  assert cok(sqrt(cb(0x7FF8000000000001, 0xC000000000000000)), NAN_BITS, NAN_BITS), "sqrt((NaN-2i))"
  assert cok(sqrt(cb(0x7FF8000000000001, 0x000012688B70E62B)), NAN_BITS, NAN_BITS), "sqrt((NaN+1e-310i))"
  assert cok(sqrt(cb(0x7FF8000000000001, 0x7E37E43C8800759C)), NAN_BITS, NAN_BITS), "sqrt((NaN+1e+300i))"
  assert cok(sqrt(cb(0x7FF8000000000001, 0x3FF921FB54442D18)), NAN_BITS, NAN_BITS), "sqrt((NaN+1.5707963267948966i))"
