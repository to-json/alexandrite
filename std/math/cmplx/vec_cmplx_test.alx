  assert cok(asin(cb(0x7FF8000000000001, 0x3FE0000000000000)), NAN_BITS, NAN_BITS), "asin((NaN+0.5i))"
  assert cok(asin(cb(0x7FF8000000000001, 0xC000000000000000)), NAN_BITS, NAN_BITS), "asin((NaN-2i))"
  assert cok(asin(cb(0x7FF8000000000001, 0x000012688B70E62B)), NAN_BITS, NAN_BITS), "asin((NaN+1e-310i))"
  assert cok(asin(cb(0x7FF8000000000001, 0x7E37E43C8800759C)), NAN_BITS, NAN_BITS), "asin((NaN+1e+300i))"
  assert cok(asin(cb(0x7FF8000000000001, 0x3FF921FB54442D18)), NAN_BITS, NAN_BITS), "asin((NaN+1.5707963267948966i))"
  assert cok(asin(cb(0x3FE0000000000000, 0x0000000000000000)), 0x3FE0C152382D7366, 0x0000000000000000), "asin((0.5+0i))"
  assert cok(asin(cb(0x3FE0000000000000, 0x8000000000000000)), 0x3FE0C152382D7366, 0x8000000000000000), "asin((0.5-0i))"
  assert cok(asin(cb(0x3FE0000000000000, 0x3FF0000000000000)), 0x3FD65D35A8BAA9E4, 0x3FEDA2E1BD2C9EBA), "asin((0.5+1i))"
  assert cok(asin(cb(0x3FE0000000000000, 0xBFF0000000000000)), 0x3FD65D35A8BAA9E4, 0xBFEDA2E1BD2C9EBA), "asin((0.5-1i))"
