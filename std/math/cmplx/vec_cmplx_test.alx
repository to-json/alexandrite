  assert cok(cos(cb(0x7FF0000000000000, 0xFFF0000000000000)), 0x7FF0000000000000, NAN_BITS), "cos((+Inf-Infi))"
  assert cok(cos(cb(0x7FF0000000000000, 0x7FF8000000000001)), NAN_BITS, NAN_BITS), "cos((+Inf+NaNi))"
  assert cok(cos(cb(0x7FF0000000000000, 0x3FE0000000000000)), NAN_BITS, NAN_BITS), "cos((+Inf+0.5i))"
  assert cok(cos(cb(0x7FF0000000000000, 0xC000000000000000)), NAN_BITS, NAN_BITS), "cos((+Inf-2i))"
  assert cok(cos(cb(0x7FF0000000000000, 0x000012688B70E62B)), NAN_BITS, NAN_BITS), "cos((+Inf+1e-310i))"
  assert cok(cos(cb(0x7FF0000000000000, 0x7E37E43C8800759C)), NAN_BITS, NAN_BITS), "cos((+Inf+1e+300i))"
  assert cok(cos(cb(0x7FF0000000000000, 0x3FF921FB54442D18)), NAN_BITS, NAN_BITS), "cos((+Inf+1.5707963267948966i))"
  assert cok(cos(cb(0xFFF0000000000000, 0x0000000000000000)), NAN_BITS, 0x0000000000000000), "cos((-Inf+0i))"
  assert cok(cos(cb(0xFFF0000000000000, 0x8000000000000000)), NAN_BITS, 0x8000000000000000), "cos((-Inf-0i))"
  assert cok(cos(cb(0xFFF0000000000000, 0x3FF0000000000000)), NAN_BITS, NAN_BITS), "cos((-Inf+1i))"
