  assert cok(asinh(cb(0xFFF0000000000000, 0x3FF921FB54442D18)), 0xFFF0000000000000, 0x0000000000000000), "asinh((-Inf+1.5707963267948966i))"
  assert cok(asinh(cb(0x7FF8000000000001, 0x0000000000000000)), NAN_BITS, 0x0000000000000000), "asinh((NaN+0i))"
  assert cok(asinh(cb(0x7FF8000000000001, 0x8000000000000000)), NAN_BITS, 0x8000000000000000), "asinh((NaN-0i))"
