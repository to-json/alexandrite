  assert cok(x + y, 0x8000000000000000, 0x8000000000000000) && cok(x - y, 0x0000000000000000, 0x0000000000000000) && cok(x * y, 0x0000000000000000, 0x0000000000000000) && cok(x / y, NAN_BITS, NAN_BITS) && (x == y) == true, "(-0-0i) op (-0-0i)"
