test "pow 3" {
  assert cok(pow(cb(0x0000000000000000, 0x7E37E43C8800759C), cb(0x0000000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "pow((0+1e+300i), (0+0i))"
