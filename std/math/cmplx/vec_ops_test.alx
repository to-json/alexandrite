  x = cb(0x8000000000000000, 0x3FF0000000000000)
  y = cb(0x8000000000000000, 0x8000000000000000)
  assert cok(x + y, 0x8000000000000000, 0x3FF0000000000000) && cok(x - y, 0x0000000000000000, 0x3FF0000000000000) && cok(x * y, 0x0000000000000000, 0x0000000000000000) && cok(x / y, NAN_BITS, 0xFFF0000000000000) && (x == y) == false, "(-0+1i) op (-0-0i)"
  x = cb(0x8000000000000000, 0x3FF0000000000000)
  y = cb(0x8000000000000000, 0x3FF0000000000000)
  assert cok(x + y, 0x8000000000000000, 0x4000000000000000) && cok(x - y, 0x0000000000000000, 0x0000000000000000) && cok(x * y, 0xBFF0000000000000, 0x8000000000000000) && cok(x / y, 0x3FF0000000000000, 0x0000000000000000) && (x == y) == true, "(-0+1i) op (-0+1i)"
  x = cb(0x8000000000000000, 0x3FF0000000000000)
  y = cb(0x8000000000000000, 0xBFF0000000000000)
  assert cok(x + y, 0x8000000000000000, 0x0000000000000000) && cok(x - y, 0x0000000000000000, 0x4000000000000000) && cok(x * y, 0x3FF0000000000000, 0x0000000000000000) && cok(x / y, 0xBFF0000000000000, 0x8000000000000000) && (x == y) == false, "(-0+1i) op (-0-1i)"
  x = cb(0x8000000000000000, 0x3FF0000000000000)
  y = cb(0x8000000000000000, 0x7FF0000000000000)
  assert cok(x + y, 0x8000000000000000, 0x7FF0000000000000) && cok(x - y, 0x0000000000000000, 0xFFF0000000000000) && cok(x * y, 0xFFF0000000000000, NAN_BITS) && cok(x / y, 0x0000000000000000, 0x0000000000000000) && (x == y) == false, "(-0+1i) op (-0+Infi)"
  x = cb(0x8000000000000000, 0x3FF0000000000000)
  y = cb(0x8000000000000000, 0xFFF0000000000000)
