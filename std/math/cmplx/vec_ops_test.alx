  y = cb(0x8000000000000000, 0x3FE0000000000000)
  assert cok(x + y, 0x8000000000000000, 0x3FF8000000000000) && cok(x - y, 0x0000000000000000, 0x3FE0000000000000) && cok(x * y, 0xBFE0000000000000, 0x8000000000000000) && cok(x / y, 0x4000000000000000, 0x0000000000000000) && (x == y) == false, "(-0+1i) op (-0+0.5i)"
}

