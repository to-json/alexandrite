  assert cok(x + y, 0x8000000000000000, 0x3FE0000000000000) && cok(x - y, 0x0000000000000000, 0xBFE0000000000000) && cok(x * y, 0x0000000000000000, 0x0000000000000000) && cok(x / y, 0x0000000000000000, 0x0000000000000000) && (x == y) == false, "(-0-0i) op (-0+0.5i)"
