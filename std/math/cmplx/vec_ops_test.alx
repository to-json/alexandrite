  assert cok(pow(cb(0x3FF0000000000000, 0x8000000000000000), cb(0x01A56E1FC2F8F359, 0x7E37E43C8800759C)), 0x3FF0000000000000, 0x0000000000000000), "pow((1-0i), (1e-300+1e+300i))"
