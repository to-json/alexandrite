  y = cb(0x8000000000000000, 0x7FF8000000000001)
  assert cok(x + y, 0x8000000000000000, NAN_BITS) && cok(x - y, 0x0000000000000000, NAN_BITS) && cok(x * y, NAN_BITS, NAN_BITS) && cok(x / y, NAN_BITS, NAN_BITS) && (x == y) == false, "(-0-0i) op (-0+NaNi)"
