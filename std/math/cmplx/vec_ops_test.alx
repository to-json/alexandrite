test "pow 6" {
  assert cok(pow(cb(0x3FF0000000000000, 0x8000000000000000), cb(0x0000000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "pow((1-0i), (0+0i))"
  assert cok(pow(cb(0x3FF0000000000000, 0x8000000000000000), cb(0x3FF0000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "pow((1-0i), (1+0i))"
  assert cok(pow(cb(0x3FF0000000000000, 0x8000000000000000), cb(0xBFF0000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x0000000000000000), "pow((1-0i), (-1+0i))"
  assert cok(pow(cb(0x3FF0000000000000, 0x8000000000000000), cb(0x0000000000000000, 0x3FF0000000000000)), 0x3FF0000000000000, 0x0000000000000000), "pow((1-0i), (0+1i))"
  assert cok(pow(cb(0x3FF0000000000000, 0x8000000000000000), cb(0x3FE0000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "pow((1-0i), (0.5+0i))"
  assert cok(pow(cb(0x3FF0000000000000, 0x8000000000000000), cb(0xBFE0000000000000, 0x3FE0000000000000)), 0x3FF0000000000000, 0x0000000000000000), "pow((1-0i), (-0.5+0.5i))"
  assert cok(pow(cb(0x3FF0000000000000, 0x8000000000000000), cb(0x4000000000000000, 0x4008000000000000)), 0x3FF0000000000000, 0x0000000000000000), "pow((1-0i), (2+3i))"
  assert cok(pow(cb(0x3FF0000000000000, 0x8000000000000000), cb(0x7FF0000000000000, 0x0000000000000000)), NAN_BITS, NAN_BITS), "pow((1-0i), (+Inf+0i))"
  assert cok(pow(cb(0x3FF0000000000000, 0x8000000000000000), cb(0x7FF8000000000001, 0x0000000000000000)), NAN_BITS, NAN_BITS), "pow((1-0i), (NaN+0i))"
