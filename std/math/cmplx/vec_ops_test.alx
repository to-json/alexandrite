test "pow 2" {
  assert cok(pow(cb(0x0000000000000000, 0xFFF0000000000000), cb(0x0000000000000000, 0x0000000000000000)), 0x3FF0000000000000, 0x8000000000000000), "pow((0-Infi), (0+0i))"
  assert cok(pow(cb(0x0000000000000000, 0xFFF0000000000000), cb(0x3FF0000000000000, 0x0000000000000000)), 0x7FF0000000000000, 0xFFF0000000000000), "pow((0-Infi), (1+0i))"
  assert cok(pow(cb(0x0000000000000000, 0xFFF0000000000000), cb(0xBFF0000000000000, 0x0000000000000000)), 0x0000000000000000, 0x0000000000000000), "pow((0-Infi), (-1+0i))"
