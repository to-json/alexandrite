# Go's example_test.go.

example "acos" { puts format("%.2f", acos(1.0)) } outputs "0.00"
example "acosh" { puts format("%.2f", acosh(1.0)) } outputs "0.00"
example "asin" { puts format("%.2f", asin(0.0)) } outputs "0.00"
example "asinh" { puts format("%.2f", asinh(0.0)) } outputs "0.00"
example "atan" { puts format("%.2f", atan(0.0)) } outputs "0.00"
example "atan2" { puts format("%.2f", atan2(0.0, 0.0)) } outputs "0.00"
example "atanh" { puts format("%.2f", atanh(0.0)) } outputs "0.00"
example "copysign" { puts format("%.2f", copysign(3.2, -1.0)) } outputs "-3.20"
example "cos" { puts format("%.2f", cos(PI / 2)) } outputs "0.00"
example "cosh" { puts format("%.2f", cosh(0.0)) } outputs "1.00"
example "sin" { puts format("%.2f", sin(PI)) } outputs "0.00"

example "sincos" {
  s, c = sincos(0.0)
  puts format("%.2f, %.2f", s, c)
} outputs "0.00, 1.00"

example "sinh" { puts format("%.2f", sinh(0.0)) } outputs "0.00"
example "tan" { puts format("%.2f", tan(0.0)) } outputs "0.00"
example "tanh" { puts format("%.2f", tanh(0.0)) } outputs "0.00"

example "sqrt" {
  a = 3.0
  b = 4.0
  c = sqrt(a * a + b * b)
  puts format("%.1f", c)
} outputs "5.0"

example "ceil" { puts format("%.1f", ceil(1.49)) } outputs "2.0"
example "floor" { puts format("%.1f", floor(1.51)) } outputs "1.0"
example "pow" { puts format("%.1f", pow(2.0, 3.0)) } outputs "8.0"
example "pow10" { puts format("%.1f", pow10(2)) } outputs "100.0"

example "round" {
  puts format("%.1f", round(10.5))
  puts format("%.1f", round(-10.5))
} outputs "11.0\n-11.0"

example "round_to_even" {
  puts format("%.1f", round_to_even(11.5))
  puts format("%.1f", round_to_even(12.5))
} outputs "12.0\n12.0"

example "log" {
  puts format("%.1f", log(1.0))
  puts format("%.1f", log(2.7183))
} outputs "0.0\n1.0"

example "log2" { puts format("%.1f", log2(256.0)) } outputs "8.0"
example "log10" { puts format("%.1f", log10(100.0)) } outputs "2.0"
example "remainder" { puts format("%.1f", remainder(100.0, 30.0)) } outputs "10.0"
example "mod" { puts format("%.1f", mod(7.0, 4.0)) } outputs "3.0"

example "abs" {
  puts format("%.1f", abs(-2.0))
  puts format("%.1f", abs(2.0))
} outputs "2.0\n2.0"

example "dim" {
  puts format("%.2f", dim(4.0, -2.0))
  puts format("%.2f", dim(-4.0, 2.0))
} outputs "6.00\n0.00"

example "exp" {
  puts format("%.2f", exp(1.0))
  puts format("%.2f", exp(2.0))
  puts format("%.2f", exp(-1.0))
} outputs "2.72\n7.39\n0.37"

example "exp2" {
  puts format("%.2f", exp2(1.0))
  puts format("%.2f", exp2(-3.0))
} outputs "2.00\n0.12"

example "expm1" {
  puts format("%.6f", expm1(0.01))
  puts format("%.6f", expm1(-1.0))
} outputs "0.010050\n-0.632121"

example "trunc" {
  puts format("%.2f", trunc(PI))
  puts format("%.2f", trunc(-1.2345))
} outputs "3.00\n-1.00"

example "cbrt" {
  puts format("%.2f", cbrt(8.0))
  puts format("%.2f", cbrt(27.0))
} outputs "2.00\n3.00"

example "modf" {
  int, frac = modf(3.14)
  puts format("%.2f, %.2f", int, frac)
  int, frac = modf(-2.71)
  puts format("%.2f, %.2f", int, frac)
} outputs "3.00, 0.14\n-2.00, -0.71"
