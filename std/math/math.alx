# Package math: Go's math, snake_case (L1). Every Go function and constant
# is here; where Go returns a pair, so does this (a tuple).
#
#   Go                                   alx
#   Pi, E, Sqrt2, Ln2, Log2E, MaxFloat64, PI, E, SQRT2, LN2, LOG2E, MAX_FLOAT64,
#   MaxInt8, MaxUint, ...                MAX_INT8, MAX_UINT, ... (UPPER_SNAKE)
#   Abs Ceil Floor Trunc Round           abs ceil floor trunc round
#   RoundToEven Mod Remainder Dim        round_to_even mod remainder dim
#   Max Min FMA Modf Copysign Signbit    max min fma modf copysign signbit
#   Frexp Ldexp Ilogb Logb               frexp ldexp ilogb logb
#   Sqrt Cbrt Pow Pow10 Hypot            sqrt cbrt pow pow10 hypot
#   Exp Exp2 Expm1 Log Log2 Log10 Log1p  exp exp2 expm1 log log2 log10 log1p
#   Sin Cos Tan Sincos Asin Acos Atan    sin cos tan sincos asin acos atan
#   Atan2 Sinh Cosh Tanh Asinh Acosh     atan2 sinh cosh tanh asinh acosh
#   Atanh                                atanh
#   Erf Erfc Erfinv Erfcinv              erf erfc erfinv erfcinv (special.alx)
#   Gamma Lgamma                         gamma, lgamma -> (Float, Int)
#   J0 J1 Jn Y0 Y1 Yn                    j0 j1 jn y0 y1 yn (bessel.alx)
#   Inf NaN IsInf IsNaN                  inf nan is_inf is_nan
#   Float64bits Float64frombits          float64bits float64frombits
#   Nextafter                            nextafter
#   Float32bits Float32frombits          float32bits(Float) -> U32, float32frombits(U32) -> Float
#   Nextafter32                          nextafter32(Float, Float) -> Float
#
# Every function is Go's portable implementation in plain alx (elem.alx,
# special.alx, bessel.alx, and the rest here), so results are Go's bits on
# every backend: the vectors (vec_*_test.alx) were generated by Go compiled
# for wasm, its portable code without FMA. Go's amd64/arm64 builds swap in
# assembly for a few functions (Exp, Log, Hypot, ...) and its arm64 compiler
# fuses a*b+c; those can differ from these in the last bit, as Go's own
# tolerances allow. The operations IEEE 754 defines exactly (sqrt, floor,
# ceil, trunc, round, round_to_even, mod, remainder, fma, copysign, abs) use
# the hardware or C library through hidden `__name` Float methods.
#
# Differences from Go:
#   - No float32 type: float32bits, nextafter32 and the new to_float32 take
#     Floats and first round them to the nearest float32 (ties to even), as
#     Go's float32(x) conversion does; float32frombits and nextafter32 return
#     the float32 value as a Float (exactly). to_float32(x) is Go's
#     float64(float32(x)).
#   - Integer constants are untyped as in Go, but alx has no `uint`: MAX_UINT
#     is MAX_UINT64 (64-bit only), and fits a U64.
#   - jn/yn negate n with checked arithmetic: n == MIN_INT panics where Go
#     wraps.
#   - Not ported: nothing. Go's tests ExpGo/Exp2Go/HypotGo/SqrtGo/PortableFMA
#     (the portable fallbacks behind its assembly) have no separate alx
#     version; the same tests run once. TestFloat32Sqrt (Go's float32 sqrt
#     optimisation) is checked through to_float32.

# ---- constants ----
pub E = 2.71828182845904523536028747135266249775724709369995957496696763
pub PI = 3.14159265358979323846264338327950288419716939937510582097494459
pub PHI = 1.61803398874989484820458683436563811772030917980576286213544862

pub SQRT2 = 1.41421356237309504880168872420969807856967187537694807317667974
pub SQRT_E = 1.64872127070012814684865078781416357165377610071014801157507931
pub SQRT_PI = 1.77245385090551602729816748334114518279754945612238712821380779
pub SQRT_PHI = 1.27201964951406896425242246173749149171560804184009624861664038

pub LN2 = 0.693147180559945309417232121458176568075500134360255254120680009
pub LOG2E = 1.44269504088896340735992468100189213742664595415298593413544940
pub LN10 = 2.30258509299404568401799145468436420760110148862877297603332790
pub LOG10E = 0.434294481903251827651128918916605082294397005803666566114453783

pub MAX_FLOAT32 = 3.40282346638528859811704183484516925440e+38
pub SMALLEST_NONZERO_FLOAT32 = 1.401298464324817070923729583289916131280e-45
pub MAX_FLOAT64 = 1.79769313486231570814527423731704356798070e+308
pub SMALLEST_NONZERO_FLOAT64 = 4.9406564584124654417656879286822137236505980e-324

pub MAX_INT = 9223372036854775807
pub MIN_INT = -9223372036854775808
pub MAX_INT8 = 127
pub MIN_INT8 = -128
pub MAX_INT16 = 32767
pub MIN_INT16 = -32768
pub MAX_INT32 = 2147483647
pub MIN_INT32 = -2147483648
pub MAX_INT64 = 9223372036854775807
pub MIN_INT64 = -9223372036854775808
pub MAX_UINT8 = 255
pub MAX_UINT16 = 65535
pub MAX_UINT32 = 4294967295
pub MAX_UINT64 = 18446744073709551615
pub MAX_UINT = 18446744073709551615

# ---- bits and special values ----

# The IEEE 754 bit pattern of f.
pub def float64bits(f: Float) -> U64 { f.__bits }

# The Float with IEEE 754 bit pattern b.
pub def float64frombits(b: U64) -> Float { b.__from_bits }

# +Inf if sign >= 0, -Inf otherwise.
pub def inf(sign: Int) -> Float {
  if sign >= 0 { float64frombits(0x7FF0000000000000) } else { float64frombits(0xFFF0000000000000) }
}

# An IEEE 754 "not-a-number".
pub def nan -> Float { float64frombits(0x7FF8000000000001) }

pub def is_nan(f: Float) -> Bool { f != f }

# Whether f is an infinity: +Inf if sign > 0, -Inf if sign < 0, either if sign == 0.
pub def is_inf(f: Float, sign: Int) -> Bool {
  (sign >= 0 && f > MAX_FLOAT64) || (sign <= 0 && f < -MAX_FLOAT64)
}

# Whether the sign bit of x is set (true for -0).
pub def signbit(x: Float) -> Bool { float64bits(x) >> 63 != 0 }

# f with the sign of sign.
pub def copysign(f: Float, sign: Float) -> Float { f.__copysign(sign) }

# ---- rounding and remainders ----
pub def abs(x: Float) -> Float { x.abs }
pub def ceil(x: Float) -> Float { x.__ceil }
pub def floor(x: Float) -> Float { x.__floor }
pub def trunc(x: Float) -> Float { x.__trunc }

# Nearest integer, ties away from zero.
pub def round(x: Float) -> Float { x.__round }

# Nearest integer, ties to even.
pub def round_to_even(x: Float) -> Float { x.__round_even }

# Remainder of x/y with the sign of x (C fmod; Go's Mod).
pub def mod(x: Float, y: Float) -> Float { x.__fmod(y) }

# IEEE 754 remainder of x/y.
pub def remainder(x: Float, y: Float) -> Float { x.__remainder(y) }

# x - y if positive, else 0.
pub def dim(x: Float, y: Float) -> Float {
  v = x - y
  if v <= 0.0 { return 0.0 }
  v
}

# The larger of x and y: +Inf beats NaN, NaN beats numbers, +0 beats -0.
pub def max(x: Float, y: Float) -> Float {
  if is_inf(x, 1) || is_inf(y, 1) { return inf(1) }
  if is_nan(x) || is_nan(y) { return nan }
  if x == 0.0 && x == y {
    if signbit(x) { return y }
    return x
  }
  if x > y { x } else { y }
}

# The smaller of x and y: -Inf beats NaN, NaN beats numbers, -0 beats +0.
pub def min(x: Float, y: Float) -> Float {
  if is_inf(x, -1) || is_inf(y, -1) { return inf(-1) }
  if is_nan(x) || is_nan(y) { return nan }
  if x == 0.0 && x == y {
    if signbit(x) { return x }
    return y
  }
  if x < y { x } else { y }
}

# x*y + z with a single rounding.
pub def fma(x: Float, y: Float, z: Float) -> Float { x.__fma(y, z) }

# Integer and fractional parts of f, both with the sign of f.
pub def modf(f: Float) -> (Float, Float) {
  if is_inf(f, 0) { return (f, nan) }
  if is_nan(f) { return (f, f) }
  i = f.__trunc
  (i, (f - i).__copysign(f))
}

# ---- exponent decomposition ----

# f = frac * 2**exp with frac in [0.5, 1); 0, Inf and NaN come back unchanged with exp 0.
pub def frexp(f: Float) -> (Float, Int) {
  if f == 0.0 || is_inf(f, 0) || is_nan(f) { return (f, 0) }
  x = f
  ex = 0
  if x.abs < 2.2250738585072014e-308 {
    x = x * 4503599627370496.0 # 2**52
    ex = -52
  }
  b = float64bits(x)
  ex += ((b >> 52) & 0x7ff).to_i - 1022
  b = (b & 0x800FFFFFFFFFFFFF) | (1022 << 52)
  (float64frombits(b), ex)
}

# frac * 2**exp.
pub def ldexp(frac: Float, exp: Int) -> Float {
  y = frac
  n = exp
  if n > 1023 {
    y = y * float64frombits(0x7FE0000000000000) # 2**1023
    n -= 1023
    if n > 1023 {
      y = y * float64frombits(0x7FE0000000000000)
      n -= 1023
      if n > 1023 { n = 1023 }
    }
  } else if n < -1022 {
    # 2**-1022 * 2**53: keeps the last rounding to a single step
    k = float64frombits(0x0010000000000000) * 9007199254740992.0
    y = y * k
    n += 1022 - 53
    if n < -1022 {
      y = y * k
      n += 1022 - 53
      if n < -1022 { n = -1022 }
    }
  }
  y * float64frombits((1023 + n).as_u64 << 52)
}

# The binary exponent of x as an Int (Go's Ilogb): 0 gives MIN_INT32, Inf and NaN MAX_INT32.
pub def ilogb(x: Float) -> Int {
  if x == 0.0 { return MIN_INT32 }
  if is_nan(x) || is_inf(x, 0) { return MAX_INT32 }
  frexp(x)[1] - 1
}

# The binary exponent of x as a Float.
pub def logb(x: Float) -> Float {
  if x == 0.0 { return inf(-1) }
  if is_inf(x, 0) { return inf(1) }
  if is_nan(x) { return x }
  frexp(x)[1].to_f - 1.0
}

# ---- roots, powers, exponentials, logarithms ----
pub def sqrt(x: Float) -> Float { x.sqrt }

POW10_TAB: [Float] = [
  1e00, 1e01, 1e02, 1e03, 1e04, 1e05, 1e06, 1e07, 1e08, 1e09,
  1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19,
  1e20, 1e21, 1e22, 1e23, 1e24, 1e25, 1e26, 1e27, 1e28, 1e29,
  1e30, 1e31,
]
POW10_POS_TAB32: [Float] = [1e00, 1e32, 1e64, 1e96, 1e128, 1e160, 1e192, 1e224, 1e256, 1e288]
POW10_NEG_TAB32: [Float] = [1e-00, 1e-32, 1e-64, 1e-96, 1e-128, 1e-160, 1e-192, 1e-224, 1e-256, 1e-288, 1e-320]

# 10**n, 0 below 10**-323 and +Inf above 10**308 (Go's tables, so Go's bits).
pub def pow10(n: Int) -> Float {
  return POW10_POS_TAB32[n / 32] * POW10_TAB[n % 32] if 0 <= n && n <= 308
  return POW10_NEG_TAB32[-n / 32] / POW10_TAB[-n % 32] if -323 <= n && n < 0
  return inf(1) if n > 0
  0.0
}

# The next representable Float after x toward y.
pub def nextafter(x: Float, y: Float) -> Float {
  return nan if is_nan(x) || is_nan(y)
  return x if x == y
  return copysign(float64frombits(1), y) if x == 0.0
  return float64frombits(float64bits(x) + 1) if (y > x) == (x > 0.0)
  float64frombits(float64bits(x) - 1)
}

# ---- float32 ----
# alx has no float32 type: these take and return Floats holding float32
# values. A Float argument is first rounded to the nearest float32 (ties to
# even), as Go's float32(x) conversion does.

# The IEEE 754 binary32 bit pattern of f rounded to float32 (Go's Float32bits(float32(f))).
pub def float32bits(f: Float) -> U32 {
  b = float64bits(f)
  sign = (b >> 32).as_u32 & 0x80000000
  ex = ((b >> 52) & 0x7ff).to_i
  mant = b & 0xFFFFFFFFFFFFF
  if ex == 0x7ff {
    return sign | 0x7F800000 if mant == 0
    return sign | 0x7FC00000 | (mant >> 29).as_u32 # NaN: quieted, payload kept
  }
  return sign if ex == 0 # float64 subnormals are far below float32's range
  e = ex - 1023 + 127
  return sign | 0x7F800000 if e >= 255
  m = mant | (1 << 52) # the 53-bit significand
  shift = 29
  base: U64 = 0
  if e >= 1 {
    m = mant
    base = e.as_u64 << 23
  } else {
    shift = 30 - e # subnormal result
    return sign if shift > 60
  }
  r = base | (m >> shift)
  rem = m & ((1.as_u64 << shift) - 1)
  half = 1.as_u64 << (shift - 1)
  r += 1 if rem > half || (rem == half && r & 1 == 1) # a carry rounds up into the exponent
  sign | r.as_u32
}

# The float32 with bit pattern b, as a Float (exact; Go's float64(Float32frombits(b))).
pub def float32frombits(b: U32) -> Float {
  sign = (b & 0x80000000).as_u64 << 32
  ex = ((b >> 23) & 0xff).to_i
  mant = (b & 0x7FFFFF).as_u64
  if ex == 0xff {
    return float64frombits(sign | 0x7FF0000000000000) if mant == 0
    return float64frombits(sign | 0x7FF8000000000000 | (mant << 29))
  }
  if ex == 0 {
    v = mant.to_f * 1.401298464324817e-45 # 2**-149, exact
    return sign != 0 ? -v : v
  }
  float64frombits(sign | ((ex - 127 + 1023).as_u64 << 52) | (mant << 29))
}

# f rounded to the nearest float32 (Go's float64(float32(f))).
pub def to_float32(f: Float) -> Float { float32frombits(float32bits(f)) }

# The next float32 after x toward y (x and y rounded to float32 first).
pub def nextafter32(x: Float, y: Float) -> Float {
  return nan if is_nan(x) || is_nan(y)
  xb = float32bits(x)
  x = float32frombits(xb)
  y = to_float32(y)
  return x if x == y
  return copysign(float32frombits(1), y) if x == 0.0
  return float32frombits(xb + 1) if (y > x) == (x > 0.0)
  float32frombits(xb - 1)
}
