def near(got: Float, want: Float) -> Bool {
  if is_nan(want) { return is_nan(got) }
  if is_inf(want, 0) { return got == want }
  if want == 0.0 { return got.abs < 1e-15 }
  (got - want).abs <= 1e-12 * want.abs
}

# Bit-exact, so -0 and +0 differ.
def same(got: Float, want: Float) -> Bool {
  if is_nan(want) { return is_nan(got) }
  float64bits(got) == float64bits(want)
}

test "constants" {
  assert near(PI, 3.141592653589793)
  assert near(E, 2.718281828459045)
  assert near(PHI, 1.618033988749895)
  assert near(SQRT2, 1.4142135623730951)
  assert near(LN2, 0.6931471805599453)
  assert near(LN10, 2.302585092994046)
  assert near(LOG2E * LN2, 1.0)
  assert near(LOG10E * LN10, 1.0)
  assert near(SQRT_PI * SQRT_PI, PI)
  assert near(SQRT_E * SQRT_E, E)
  assert near(SQRT_PHI * SQRT_PHI, PHI)
  assert MAX_FLOAT64 == 1.7976931348623157e308
  assert SMALLEST_NONZERO_FLOAT64 > 0.0
  assert SMALLEST_NONZERO_FLOAT64 / 2.0 == 0.0
  assert MAX_FLOAT32 > 3.4e38
  assert SMALLEST_NONZERO_FLOAT32 > 0.0
  assert MAX_INT == 9223372036854775807
  assert MIN_INT == -MAX_INT - 1
  assert MAX_INT8 == 127
  assert MIN_INT16 == -32768
  assert MAX_INT32 == 2147483647
  assert MAX_UINT8 == 255
  assert MAX_UINT16 == 65535
  assert MAX_UINT32 == 4294967295
  u: U64 = MAX_UINT64
  assert u == 18446744073709551615
}

test "bits and specials" {
  assert float64bits(1.0) == 0x3FF0000000000000
  assert float64bits(-2.0) == 0xC000000000000000
  assert float64frombits(0x4000000000000000) == 2.0
  assert float64frombits(float64bits(3.25)) == 3.25
  assert is_inf(inf(1), 1)
  assert !is_inf(inf(1), -1)
  assert is_inf(inf(-1), -1)
  assert is_inf(inf(-1), 0)
  assert !is_inf(1.0, 0)
  assert !is_inf(nan, 0)
  assert is_nan(nan)
  assert !is_nan(inf(1))
  assert !is_nan(0.0)
  assert nan != nan
  assert signbit(-1.0)
  assert !signbit(1.0)
  assert signbit(copysign(0.0, -1.0))
  assert !signbit(0.0)
  assert copysign(3.0, -1.0) == -3.0
  assert copysign(-3.0, 1.0) == 3.0
  assert is_nan(copysign(nan, 1.0))
  assert inf(1) > MAX_FLOAT64
}

test "rounding" {
  assert ceil(1.2) == 2.0
  assert ceil(-1.2) == -1.0
  assert signbit(ceil(-0.5))
  assert floor(1.8) == 1.0
  assert floor(-1.2) == -2.0
  assert trunc(1.9) == 1.0
  assert trunc(-1.9) == -1.0
  assert signbit(trunc(-0.9))
  assert round(2.5) == 3.0
  assert round(-2.5) == -3.0
  assert round(0.49999999999999994) == 0.0
  assert round(1.5) == 2.0
  assert round_to_even(2.5) == 2.0
  assert round_to_even(3.5) == 4.0
  assert round_to_even(-2.5) == -2.0
  assert round_to_even(2.6) == 3.0
  assert is_inf(ceil(inf(1)), 1)
  assert is_inf(floor(inf(-1)), -1)
  assert is_nan(round(nan))
  assert is_nan(floor(nan))
  assert abs(-3.5) == 3.5
  assert abs(3.5) == 3.5
  assert is_inf(abs(inf(-1)), 1)
  assert is_nan(abs(nan))
  assert same(abs(copysign(0.0, -1.0)), 0.0)
  assert (-4.5).abs == 4.5
}

test "mod remainder dim" {
  assert mod(7.0, 3.0) == 1.0
  assert mod(-7.0, 3.0) == -1.0
  assert mod(7.0, -3.0) == 1.0
  assert near(mod(5.5, 2.0), 1.5)
  assert is_nan(mod(1.0, 0.0))
  assert is_nan(mod(inf(1), 2.0))
  assert mod(3.0, inf(1)) == 3.0
  assert is_nan(mod(nan, 1.0))
  assert remainder(7.0, 3.0) == 1.0
  assert remainder(8.0, 3.0) == -1.0
  assert remainder(5.0, 2.0) == 1.0
  assert remainder(7.0, 2.0) == -1.0
  assert is_nan(remainder(1.0, 0.0))
  assert is_nan(remainder(inf(1), 1.0))
  assert dim(5.0, 3.0) == 2.0
  assert dim(3.0, 5.0) == 0.0
  assert is_nan(dim(inf(1), inf(1)))
  assert is_nan(dim(nan, 1.0))
  assert is_inf(dim(inf(1), 1.0), 1)
}

test "max min" {
  assert max(1.0, 2.0) == 2.0
  assert max(2.0, 1.0) == 2.0
  assert min(1.0, 2.0) == 1.0
  assert min(2.0, 1.0) == 1.0
  assert is_inf(max(inf(1), nan), 1)
  assert is_inf(max(nan, inf(1)), 1)
  assert is_nan(max(nan, 1.0))
  assert is_nan(max(1.0, nan))
  assert is_inf(min(inf(-1), nan), -1)
  assert is_inf(min(nan, inf(-1)), -1)
  assert is_nan(min(nan, 1.0))
  assert is_nan(min(1.0, nan))
  nz = copysign(0.0, -1.0)
  assert !signbit(max(0.0, nz))
  assert !signbit(max(nz, 0.0))
  assert signbit(min(0.0, nz))
  assert signbit(min(nz, 0.0))
  assert signbit(max(nz, nz))
  assert max(-1.0, -2.0) == -1.0
  assert min(-1.0, -2.0) == -2.0
  assert max(inf(-1), 1.0) == 1.0
  assert min(inf(1), 1.0) == 1.0
}

test "fma" {
  assert fma(2.0, 3.0, 1.0) == 7.0
  # a rounding step a separate multiply-add would lose
  x = 1.0 + 1.0 / 134217728.0                                             # 1 + 2**-27
  assert fma(x, x, -1.0 - 2.0 / 134217728.0) == 1.0 / 18014398509481984.0 # 2**-54
  assert is_nan(fma(inf(1), 0.0, 1.0))
}

test "modf" {
  r = modf(3.25)
  assert r[0] == 3.0
  assert r[1] == 0.25
  r = modf(-3.25)
  assert r[0] == -3.0
  assert r[1] == -0.25
  r = modf(0.5)
  assert r[0] == 0.0
  assert r[1] == 0.5
  r = modf(-0.5)
  assert same(r[0], copysign(0.0, -1.0))
  assert r[1] == -0.5
  r = modf(inf(1))
  assert is_inf(r[0], 1)
  assert is_nan(r[1])
  r = modf(inf(-1))
  assert is_inf(r[0], -1)
  assert is_nan(r[1])
  r = modf(nan)
  assert is_nan(r[0])
  assert is_nan(r[1])
  r = modf(-4.0)
  assert r[0] == -4.0
  assert same(r[1], copysign(0.0, -1.0))
}

test "frexp ldexp" {
  r = frexp(8.0)
  assert r[0] == 0.5
  assert r[1] == 4
  r = frexp(-12.0)
  assert r[0] == -0.75
  assert r[1] == 4
  r = frexp(1.0)
  assert r[0] == 0.5
  assert r[1] == 1
  r = frexp(0.1)
  assert near(r[0], 0.8)
  assert r[1] == -3
  r = frexp(0.0)
  assert r[0] == 0.0
  assert r[1] == 0
  r = frexp(inf(1))
  assert is_inf(r[0], 1)
  assert r[1] == 0
  r = frexp(nan)
  assert is_nan(r[0])
  assert r[1] == 0
  r = frexp(SMALLEST_NONZERO_FLOAT64)
  assert r[0] == 0.5
  assert r[1] == -1073
  assert ldexp(0.5, 4) == 8.0
  assert ldexp(-0.75, 4) == -12.0
  assert ldexp(1.0, -1) == 0.5
  assert ldexp(1.0, 1023) == 8.98846567431158e307
  assert ldexp(1.0, 1024) == inf(1)
  assert ldexp(1.0, 5000) == inf(1)
  assert ldexp(1.0, -1074) == SMALLEST_NONZERO_FLOAT64
  assert ldexp(1.0, -1075) == 0.0
  assert ldexp(1.0, -5000) == 0.0
  assert ldexp(0.0, 10) == 0.0
  assert is_inf(ldexp(inf(1), -10), 1)
  assert is_nan(ldexp(nan, 3))
  [0.3, 1234.5678, -9.75, 1e-300, 5e300, 3e-310].each { |v|
    d = frexp(v)
    assert d[0].abs >= 0.5 && d[0].abs < 1.0
    assert ldexp(d[0], d[1]) == v
  }
}

test "logb ilogb" {
  assert ilogb(8.0) == 3
  assert ilogb(1.0) == 0
  assert ilogb(0.75) == -1
  assert ilogb(-1024.5) == 10
  assert ilogb(0.0) == MIN_INT32
  assert ilogb(inf(1)) == MAX_INT32
  assert ilogb(nan) == MAX_INT32
  assert logb(8.0) == 3.0
  assert logb(0.3) == -2.0
  assert is_inf(logb(0.0), -1)
  assert is_inf(logb(inf(-1)), 1)
  assert is_nan(logb(nan))
}

test "roots and powers" {
  assert sqrt(4.0) == 2.0
  assert near(sqrt(2.0), 1.4142135623730951)
  assert is_nan(sqrt(-1.0))
  assert is_inf(sqrt(inf(1)), 1)
  assert same(sqrt(copysign(0.0, -1.0)), copysign(0.0, -1.0))
  assert (9.0).sqrt == 3.0
  assert near(cbrt(27.0), 3.0)
  assert near(cbrt(-8.0), -2.0)
  assert near(cbrt(2.0), 1.2599210498948732)
  assert cbrt(0.0) == 0.0
  assert is_inf(cbrt(inf(-1)), -1)
  assert near(pow(2.0, 10.0), 1024.0)
  assert near(pow(2.0, 0.5), 1.4142135623730951)
  assert near(pow(2.0, -2.0), 0.25)
  assert near(pow(-8.0, 3.0), -512.0)
  assert is_nan(pow(-8.0, 0.5))
  assert pow(nan, 0.0) == 1.0
  assert pow(1.0, nan) == 1.0
  assert pow(5.0, 0.0) == 1.0
  assert is_inf(pow(0.0, -1.0), 1)
  assert is_inf(pow(copysign(0.0, -1.0), -3.0), -1)
  assert pow(0.0, 3.0) == 0.0
  assert is_inf(pow(2.0, inf(1)), 1)
  assert pow(2.0, inf(-1)) == 0.0
  assert pow(-1.0, inf(1)) == 1.0
  assert pow(0.5, inf(1)) == 0.0
  assert is_inf(pow(0.5, inf(-1)), 1)
  assert pow(inf(-1), 3.0) == inf(-1)
  assert pow10(0) == 1.0
  assert pow10(3) == 1000.0
  assert near(pow10(-3), 0.001)
  assert near(pow10(22), 1e22)
  assert near(pow10(100), 1e100)
  assert near(pow10(308), 1e308)
  assert is_inf(pow10(309), 1)
  assert pow10(-324) == 0.0
  assert pow10(-323) > 0.0
  assert near(hypot(3.0, 4.0), 5.0)
  assert is_inf(hypot(inf(-1), nan), 1)
  assert is_inf(hypot(nan, inf(1)), 1)
  assert is_nan(hypot(nan, 1.0))
  assert hypot(0.0, 0.0) == 0.0
  assert near(hypot(1e200, 1e200), 1.4142135623730951e200)
}

test "exp and log" {
  assert exp(0.0) == 1.0
  assert near(exp(1.0), E)
  assert near(exp(-1.0), 0.36787944117144233)
  assert near(exp(10.0), 22026.465794806718)
  assert is_inf(exp(inf(1)), 1)
  assert exp(inf(-1)) == 0.0
  assert is_inf(exp(710.0), 1)
  assert exp(-1000.0) == 0.0
  assert is_nan(exp(nan))
  assert exp2(10.0) == 1024.0
  assert near(exp2(0.5), SQRT2)
  assert near(exp2(-3.0), 0.125)
  assert is_inf(exp2(1024.0), 1)
  assert near(expm1(1e-10), 1.00000000005e-10)
  assert expm1(0.0) == 0.0
  assert expm1(inf(-1)) == -1.0
  assert near(expm1(1.0), 1.718281828459045)
  assert log(1.0) == 0.0
  assert near(log(E), 1.0)
  assert near(log(10.0), LN10)
  assert is_inf(log(0.0), -1)
  assert is_nan(log(-1.0))
  assert is_inf(log(inf(1)), 1)
  assert log2(8.0) == 3.0
  assert near(log2(10.0), 3.321928094887362)
  assert log2(0.5) == -1.0
  assert is_inf(log2(0.0), -1)
  assert is_nan(log2(-1.0))
  assert log10(1000.0) == 3.0
  assert near(log10(2.0), 0.3010299956639812)
  assert is_inf(log10(0.0), -1)
  assert is_nan(log10(-0.5))
  assert near(log1p(1e-10), 9.9999999995e-11)
  assert log1p(0.0) == 0.0
  assert is_inf(log1p(-1.0), -1)
  assert is_nan(log1p(-2.0))
  assert near(log1p(1.0), LN2)
}

test "trigonometry" {
  assert sin(0.0) == 0.0
  assert near(sin(1.0), 0.8414709848078965)
  assert near(sin(PI / 2.0), 1.0)
  assert near(sin(-1.0), -0.8414709848078965)
  assert near(sin(100.0), -0.5063656411097588)
  assert same(sin(copysign(0.0, -1.0)), copysign(0.0, -1.0))
  assert is_nan(sin(inf(1)))
  assert is_nan(sin(nan))
  assert cos(0.0) == 1.0
  assert near(cos(1.0), 0.5403023058681398)
  assert near(cos(PI), -1.0)
  assert near(cos(100.0), 0.8623188722876839)
  assert is_nan(cos(inf(-1)))
  assert tan(0.0) == 0.0
  assert near(tan(1.0), 1.5574077246549023)
  assert near(tan(PI / 4.0), 1.0)
  assert is_nan(tan(inf(1)))
  assert asin(0.0) == 0.0
  assert near(asin(1.0), PI / 2.0)
  assert near(asin(0.5), 0.5235987755982989)
  assert is_nan(asin(1.5))
  assert acos(1.0) == 0.0
  assert near(acos(0.0), PI / 2.0)
  assert near(acos(-1.0), PI)
  assert near(acos(0.5), 1.0471975511965979)
  assert is_nan(acos(-1.5))
  assert atan(0.0) == 0.0
  assert near(atan(1.0), PI / 4.0)
  assert near(atan(inf(1)), PI / 2.0)
  assert near(atan(inf(-1)), -PI / 2.0)
  assert near(atan2(1.0, 1.0), PI / 4.0)
  assert near(atan2(1.0, -1.0), 3.0 * PI / 4.0)
  assert near(atan2(-1.0, -1.0), -3.0 * PI / 4.0)
  assert near(atan2(1.0, 0.0), PI / 2.0)
  assert atan2(0.0, 1.0) == 0.0
  assert near(atan2(0.0, -1.0), PI)
  assert near(atan2(copysign(0.0, -1.0), -1.0), -PI)
  assert same(atan2(copysign(0.0, -1.0), 1.0), copysign(0.0, -1.0))
  assert near(atan2(inf(1), inf(1)), PI / 4.0)
  assert near(atan2(inf(1), inf(-1)), 3.0 * PI / 4.0)
  assert is_nan(atan2(nan, 1.0))
  s = sincos(0.7)
  assert near(s[0], 0.644217687237691)
  assert near(s[1], 0.7648421872844885)
  assert near(sin(0.3) * sin(0.3) + cos(0.3) * cos(0.3), 1.0)
}

test "hyperbolic" {
  assert sinh(0.0) == 0.0
  assert near(sinh(1.0), 1.1752011936438014)
  assert near(sinh(-1.0), -1.1752011936438014)
  assert is_inf(sinh(inf(1)), 1)
  assert is_inf(sinh(inf(-1)), -1)
  assert cosh(0.0) == 1.0
  assert near(cosh(1.0), 1.5430806348152437)
  assert is_inf(cosh(inf(-1)), 1)
  assert tanh(0.0) == 0.0
  assert near(tanh(1.0), 0.7615941559557649)
  assert tanh(inf(1)) == 1.0
  assert tanh(inf(-1)) == -1.0
  assert asinh(0.0) == 0.0
  assert near(asinh(1.0), 0.881373587019543)
  assert near(asinh(-1.0), -0.881373587019543)
  assert is_inf(asinh(inf(1)), 1)
  assert acosh(1.0) == 0.0
  assert near(acosh(2.0), 1.3169578969248166)
  assert is_nan(acosh(0.5))
  assert is_inf(acosh(inf(1)), 1)
  assert atanh(0.0) == 0.0
  assert near(atanh(0.5), 0.5493061443340548)
  assert is_inf(atanh(1.0), 1)
  assert is_inf(atanh(-1.0), -1)
  assert is_nan(atanh(1.5))
}

test "erf gamma" {
  assert erf(0.0) == 0.0
  assert near(erf(0.5), 0.5204998778130465)
  assert near(erf(1.0), 0.8427007929497149)
  assert near(erf(-1.0), -0.8427007929497149)
  assert erf(inf(1)) == 1.0
  assert erf(inf(-1)) == -1.0
  assert is_nan(erf(nan))
  assert erfc(0.0) == 1.0
  assert near(erfc(0.5), 0.4795001221869535)
  assert near(erfc(1.0), 0.15729920705028513)
  assert near(erfc(3.0), 2.209049699858544e-05)
  assert erfc(inf(1)) == 0.0
  assert erfc(inf(-1)) == 2.0
  assert gamma(1.0) == 1.0
  assert gamma(5.0) == 24.0
  assert near(gamma(0.5), 1.772453850905516)
  assert near(gamma(4.5), 11.631728396567448)
  assert near(gamma(-0.5), -3.5449077018110318)
  assert near(gamma(-1.5), 2.3632718012073544)
  assert near(gamma(10.0), 362880.0)
  assert is_inf(gamma(0.0), 1)
  assert is_inf(gamma(copysign(0.0, -1.0)), -1)
  assert is_nan(gamma(-1.0))
  assert is_nan(gamma(-3.0))
  assert is_nan(gamma(inf(-1)))
  assert is_inf(gamma(inf(1)), 1)
  assert is_inf(gamma(200.0), 1)
  assert is_nan(gamma(nan))
  r = lgamma(5.0)
  assert near(r[0], 3.1780538303479458)
  assert r[1] == 1
  r = lgamma(0.5)
  assert near(r[0], 0.5723649429247001)
  assert r[1] == 1
  r = lgamma(-0.5)
  assert near(r[0], 1.2655121234846454)
  assert r[1] == -1
  r = lgamma(-1.5)
  assert near(r[0], 0.8600470153764811)
  assert r[1] == 1
  r = lgamma(-2.5)
  assert near(r[0], -0.05624371649767405)
  assert r[1] == -1
  r = lgamma(1.0)
  assert r[0] == 0.0
  assert r[1] == 1
  r = lgamma(2.0)
  assert r[0] == 0.0
  assert r[1] == 1
  r = lgamma(0.0)
  assert is_inf(r[0], 1)
  assert r[1] == 1
  r = lgamma(copysign(0.0, -1.0))
  assert is_inf(r[0], 1)
  assert r[1] == -1
  r = lgamma(-3.0)
  assert is_inf(r[0], 1)
  assert r[1] == 1
  r = lgamma(inf(1))
  assert is_inf(r[0], 1)
  assert r[1] == 1
  r = lgamma(inf(-1))
  assert is_inf(r[0], 1)
  assert r[1] == 1
  r = lgamma(nan)
  assert is_nan(r[0])
}

test "nextafter" {
  assert nextafter(1.0, 2.0) == 1.0000000000000002
  assert nextafter(1.0, 0.0) == 0.9999999999999999
  assert nextafter(1.0, 1.0) == 1.0
  assert nextafter(0.0, 1.0) == SMALLEST_NONZERO_FLOAT64
  assert nextafter(0.0, -1.0) == -SMALLEST_NONZERO_FLOAT64
  assert is_inf(nextafter(MAX_FLOAT64, inf(1)), 1)
  assert is_nan(nextafter(nan, 1.0))
  assert is_nan(nextafter(1.0, nan))
  assert float64bits(nextafter(1.0, 2.0)) == 0x3FF0000000000001
}
