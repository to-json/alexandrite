# Package rand: Go's math/rand, pseudo-random numbers for simulations and
# tests. Not for security-sensitive work (see crypto/rand).
#
#   Go                                     alx
#   rand.Source / Source64 (interfaces)    Source (int63!, seed!, uint64!) / Source64
#   rand.NewSource(seed) Source            new_source(seed) -> Source (an RngSource)
#   rand.New(src) *Rand                    new(src) -> Rand
#   r.Seed(seed)                           r.seed!(seed)
#   r.Int63() / Uint32 / Uint64 / Int31    r.int63! -> Int / uint32! -> U32 / uint64! -> U64 / int31! -> I32
#   r.Int()                                r.int! -> Int
#   r.Int63n(n) / Int31n(n) / Intn(n)      r.int63n!(n: Int) / int31n!(n: I32) -> I32 / intn!(n: Int)
#   r.Float64() / Float32()                r.float64! / float32! (both Float; see below)
#   r.Perm(n) []int                        r.perm!(n) -> [Int]
#   r.Shuffle(n, swap)                     r.shuffle!(n) { |i, j| ... }
#   r.Read(p) (n int, err error)           r.read!(p) -> Int (never fails; an io.Reader)
#   r.NormFloat64() / ExpFloat64()         r.norm_float64! / exp_float64!
#   rand.NewZipf(r, s, v, imax) *Zipf      new_zipf(r, s, v, imax) -> Zipf? (none for Go's nil)
#   z.Uint64()                             z.uint64! -> U64
#   rand.Int63() ... rand.ExpFloat64()     int63() ... exp_float64(): the same functions
#                                          on a generator seeded by the operating system
#   rand.Seed(seed) (deprecated)           seed(seed): a no-op, Go's default since 1.24
#
# For a given seed, every method gives exactly Go's sequence (the rngSource
# algorithm and tables, Go's rejection sampling, ziggurat tables and float32
# rounding), checked against Go's regression golden table and generated
# vectors.
#
# Differences from Go:
#   - The methods that advance a generator end in `!` (alx's rule for
#     methods that change their receiver); a Rand, an RngSource and a Zipf
#     keep their state in shared storage (D36), so copies are one generator,
#     as Go's pointers are. Like Go's, they aren't safe for concurrent use.
#   - Source carries Source64's uint64! with a default (Go's fallback for a
#     Source without Uint64: two int63! calls combined), so Rand.uint64! is
#     Go's for both kinds of source. A type implementing int63! and seed!
#     is a Source; Source64 asks for an explicit uint64!.
#   - A Rand is not itself a Source: interface values are closed sums
#     (D12), and Rand holds one.
#   - alx has no float32: float32! returns a Float holding exactly Go's
#     float32 value (the Float64 rounded to float32, resampled on 1).
#     norm_float64! and exp_float64! do Go's float32 arithmetic by rounding
#     each operation to float32 (exact: a double holds every float32 sum
#     and product before rounding).
#   - The top-level functions draw from the operating system's CSPRNG
#     (getentropy(3)) through a small buffer per call, where Go uses its
#     runtime's per-thread ChaCha8 seeded by the OS; both are unpredictable
#     and unseedable, so the only difference is speed (a system call per
#     top-level call). In the browser the wasm backend refuses programs
#     that call getentropy (only the time/sleep FFI is provided), so use a
#     seeded Rand there.
#   - seed(seed) is always a no-op (Go 1.24's default). Go's GODEBUG
#     opt-outs randseednop=0 / randautoseed=0, which make the global source
#     a seeded rngSource, aren't supported: alx has no mutable package
#     state to hold it (docs/notes/port-issues.md #30). Use new(new_source(s)).
#   - Read is only r.read! and read(p); Go's lockedSource and the Rand's
#     interplay with it (seedPos) have no counterpart since nothing here is
#     global.

import "math"

extern def c_getentropy(buf: [Byte], n: Int) -> I32 = "getentropy"

RN = 3.442619855899
RE = 7.69711747013104972
TWO63 = 9223372036854775808.0
INT31_MAX = 2147483647

# A source of uniformly distributed pseudo-random Int values in [0, 1<<63).
pub interface Source {
  def int63! -> Int
  def seed!(seed: Int)
  # Go's Rand.Uint64 for a Source without Uint64.
  def uint64! -> U64 {
    a = int63!().as_u64 >> 31
    a | int63!().as_u64 << 32
  }
}

# A Source that also generates uniformly distributed U64 values directly.
pub interface Source64 {
  def int63! -> Int
  def seed!(seed: Int)
  def uint64! -> U64
}

# A new pseudo-random Source seeded with seed. Unlike the top-level
# functions, it is not safe for concurrent use by multiple tasks.
pub def new_source(seed: Int) -> Source { new_rng_source(seed) }

struct ReadState {
  val: Int
  pos: Int
}

# A source of random numbers.
pub struct Rand {
  src: Source
  rd: [ReadState]

  # Seeds the source with seed (and restarts read!'s byte stream).
  pub def seed!(seed: Int) {
    src.seed!(seed)
    rd[0].pos = 0
  }

  # A non-negative pseudo-random 63-bit integer.
  pub def int63! -> Int { src.int63!() }

  # A pseudo-random 32-bit value.
  pub def uint32! -> U32 { (int63!() >> 31).as_u32 }

  # A pseudo-random 64-bit value.
  pub def uint64! -> U64 { src.uint64!() }

  # A non-negative pseudo-random 31-bit integer.
  pub def int31! -> I32 { (int63!() >> 32).as_i32 }

  # A non-negative pseudo-random Int.
  pub def int! -> Int { int63!() }

  # A non-negative pseudo-random number in [0, n). Panics if n <= 0.
  pub def int63n!(n: Int) -> Int {
    panic("invalid argument to Int63n") if n <= 0
    return int63!() & (n - 1) if n & (n - 1) == 0
    big: U64 = 1 << 63
    max = (big - 1 - big % n.as_u64).as_i64
    v = int63!()
    while v > max { v = int63!() }
    v % n
  }

  # A non-negative pseudo-random number in [0, n). Panics if n <= 0.
  pub def int31n!(n: I32) -> I32 {
    panic("invalid argument to Int31n") if n <= 0
    return int31!() & (n - 1) if n & (n - 1) == 0
    big: U32 = 1 << 31
    max = (big - 1 - big % n.as_u32).as_i32
    v = int31!()
    while v > max { v = int31!() }
    v % n
  }

  # Go's unexported int31n: Lemire's multiply-shift, used by shuffle!.
  # n must be > 0.
  def lemire_int31n!(n: I32) -> I32 {
    nu = n.as_u32
    v = uint32!()
    prod = v.to_u64 * nu.to_u64
    low = prod.as_u32
    if low < nu {
      thresh = (-n).as_u32 % nu
      while low < thresh {
        v = uint32!()
        prod = v.to_u64 * nu.to_u64
        low = prod.as_u32
      }
    }
    (prod >> 32).as_i32
  }

  # A non-negative pseudo-random number in [0, n). Panics if n <= 0.
  pub def intn!(n: Int) -> Int {
    panic("invalid argument to Intn") if n <= 0
    return int31n!(n.as_i32).to_i if n <= INT31_MAX
    int63n!(n)
  }

  # A pseudo-random number in [0.0, 1.0).
  pub def float64! -> Float {
    while true {
      f = int63!().to_f / TWO63
      return f if f != 1.0
    }
    0.0
  }

  # A pseudo-random float32 in [0.0, 1.0), as the Float of that value.
  pub def float32! -> Float {
    while true {
      f = f32(float64!())
      return f if f != 1.0
    }
    0.0
  }

  # A pseudo-random permutation of the integers [0, n).
  pub def perm!(n: Int) -> [Int] {
    m = [0; n]
    for i in 0...n {
      j = intn!(i + 1)
      m[i] = m[j]
      m[j] = i
    }
    m
  }

  # Pseudo-randomizes the order of n elements; swap swaps the elements with
  # indexes i and j. Panics if n < 0.
  pub def shuffle!(n: Int, swap: (Int, Int) -> Unit) {
    panic("invalid argument to Shuffle") if n < 0
    i = n - 1
    while i > INT31_MAX - 1 {
      j = int63n!(i + 1)
      swap(i, j)
      i -= 1
    }
    while i > 0 {
      j = lemire_int31n!((i + 1).as_i32).to_i
      swap(i, j)
      i -= 1
    }
  }

  # Fills p with pseudo-random bytes; returns p.size. It never fails.
  pub def read!(p: [Byte]) -> Int {
    pos = rd[0].pos
    val = rd[0].val
    for n in 0...p.size {
      if pos == 0 {
        val = src.int63!()
        pos = 7
      }
      p[n] = val.as_u8
      val >>= 8
      pos -= 1
    }
    rd[0].pos = pos
    rd[0].val = val
    p.size
  }

  # A normally distributed Float in [-MAX_FLOAT64, +MAX_FLOAT64] with mean 0
  # and standard deviation 1 (Marsaglia and Tsang's ziggurat).
  pub def norm_float64! -> Float {
    while true {
      j = uint32!().as_i32
      i = (j & 0x7F).to_i
      x = j.to_f * WN[i]
      return x if abs_int32(j) < KN[i]
      if i == 0 {
        while true {
          x = -math.log(float64!()) * (1.0 / RN)
          y = -math.log(float64!())
          break if y + y >= x * x
        }
        return RN + x if j > 0
        return -RN - x
      }
      if f32(FN[i] + f32(f32(float64!()) * f32(FN[i - 1] - FN[i]))) < f32(math.exp(-0.5 * x * x)) {
        return x
      }
    }
    0.0
  }

  # An exponentially distributed Float in (0, +MAX_FLOAT64] with rate 1
  # (Marsaglia and Tsang's ziggurat).
  pub def exp_float64! -> Float {
    while true {
      j = uint32!()
      i = (j & 0xFF).to_i
      x = j.to_f * WE[i]
      return x if j < KE[i]
      return RE - math.log(float64!()) if i == 0
      if f32(FE[i] + f32(f32(float64!()) * f32(FE[i - 1] - FE[i]))) < f32(math.exp(-x)) {
        return x
      }
    }
    0.0
  }
}

# A new Rand that uses random values from src.
pub def new(src: Source) -> Rand {
  Rand.new(src: src, rd: [ReadState.new(val: 0, pos: 0)])
}

def abs_int32(i: I32) -> U32 {
  return (-i.to_i).as_u32 if i < 0
  i.as_u32
}

# x rounded to the nearest float32 (ties to even), as Go's float32(x).
def f32(x: Float) -> Float {
  b = x.__bits
  sign = b & 0x8000000000000000
  a = b ^ sign
  e = (a >> 52).to_i
  return x if e == 0x7ff
  return sign.__from_bits if e == 0
  ue = e - 1023
  return (sign | 0x7FF0000000000000).__from_bits if ue > 127
  m = a & 0xFFFFFFFFFFFFF | 0x10000000000000
  shift = 29
  shift = 29 + (-126 - ue) if ue < -126
  return sign.__from_bits if shift >= 54
  one: U64 = 1
  rem = m & ((one << shift) - 1)
  half = one << (shift - 1)
  q = m >> shift
  q += 1 if rem > half || (rem == half && q & 1 == 1)
  k = ue - 52 + shift
  r = q.to_f * ((k + 1023).as_u64 << 52).__from_bits
  r = (0x7FF0000000000000).as_u64.__from_bits if r >= 340282366920938463463374607431768211456.0
  r.__copysign(x)
}

# ---- Zipf ----

# A Zipf distribution: P(k) is proportional to (v + k) ** (-s), over
# k in [0, imax] (Go's Zipf).
pub struct Zipf {
  r: Rand
  imax: Float
  v: Float
  q: Float
  s: Float
  oneminus_q: Float
  oneminus_qinv: Float
  hxm: Float
  hx0minus_hxm: Float

  def h(x: Float) -> Float { math.exp(oneminus_q * math.log(v + x)) * oneminus_qinv }

  def hinv(x: Float) -> Float { math.exp(oneminus_qinv * math.log(oneminus_q * x)) - v }

  # A value drawn from the Zipf distribution.
  pub def uint64! -> U64 {
    k = 0.0
    while true {
      rr = r.float64!()
      ur = hxm + rr * hx0minus_hxm
      x = hinv(ur)
      k = math.floor(x + 0.5)
      break if k - x <= s
      break if ur >= h(k + 0.5) - math.exp(-math.log(k + v) * q)
    }
    k.to_u64
  }
}

# A Zipf generator drawing from r, with s > 1 and v >= 1; none if they're
# out of range (Go's nil).
pub def new_zipf(r: Rand, s: Float, v: Float, imax: U64) -> Zipf? {
  return none if s <= 1.0 || v < 1.0
  z = Zipf.new(r: r, imax: imax.to_f, v: v, q: s)
  z.oneminus_q = 1.0 - z.q
  z.oneminus_qinv = 1.0 / z.oneminus_q
  z.hxm = z.h(z.imax + 0.5)
  z.hx0minus_hxm = z.h(0.5) - math.exp(math.log(z.v) * -z.q) - z.hxm
  z.s = 1.0 - z.hinv(z.h(1.5) - math.exp(-z.q * math.log(z.v + 1.0)))
  z
}

# ---- top-level functions: the operating system's random bytes ----

OS_BUF = 64

struct OsState {
  buf: [Byte]
  off: Int
}

# Go's runtimeSource: uniform values from getentropy(3), buffered.
struct OsSource {
  st: [OsState]

  def int63! -> Int { (uint64!() & RNG_MASK).as_i64 }

  def seed!(seed: Int) { panic("internal error: call to runtimeSource.Seed") if st.size > 0 }

  def uint64! -> U64 {
    s = st[0]
    if s.off + 8 > s.buf.size {
      rc = c_getentropy(s.buf, s.buf.size)
      panic("math/rand: getentropy failed") if rc != 0
      st[0].off = 0
    }
    off = st[0].off
    b = s.buf
    st[0].off = off + 8
    v: U64 = 0
    for k in 0...8 { v |= b[off + k].to_u64 << (8 * k) }
    v
  }
}

# A Rand over the operating system's randomness, for one top-level call.
def global -> Rand {
  new(OsSource.new(st: [OsState.new(buf: [0.as_u8; OS_BUF], off: OS_BUF)]))
}

# Deprecated (Go): a no-op, as Go's Seed is by default since Go 1.24.
# Use new(new_source(seed)) for a deterministic sequence.
pub def seed(seed: Int) {
}

# A non-negative random 63-bit integer from the default source.
pub def int63 -> Int {
  r = global()
  r.int63!()
}

# A random 32-bit value from the default source.
pub def uint32 -> U32 {
  r = global()
  r.uint32!()
}

# A random 64-bit value from the default source.
pub def uint64 -> U64 {
  r = global()
  r.uint64!()
}

# A non-negative random 31-bit integer from the default source.
pub def int31 -> I32 {
  r = global()
  r.int31!()
}

# A non-negative random Int from the default source.
pub def int -> Int {
  r = global()
  r.int!()
}

# A non-negative random number in [0, n) from the default source. Panics if n <= 0.
pub def int63n(n: Int) -> Int {
  r = global()
  r.int63n!(n)
}

# A non-negative random number in [0, n) from the default source. Panics if n <= 0.
pub def int31n(n: I32) -> I32 {
  r = global()
  r.int31n!(n)
}

# A non-negative random number in [0, n) from the default source. Panics if n <= 0.
pub def intn(n: Int) -> Int {
  r = global()
  r.intn!(n)
}

# A random number in [0.0, 1.0) from the default source.
pub def float64 -> Float {
  r = global()
  r.float64!()
}

# A random float32 in [0.0, 1.0) (as a Float) from the default source.
pub def float32 -> Float {
  r = global()
  r.float32!()
}

# A random permutation of the integers [0, n) from the default source.
pub def perm(n: Int) -> [Int] {
  r = global()
  r.perm!(n)
}

# Randomizes the order of n elements with the default source.
pub def shuffle(n: Int, swap: (Int, Int) -> Unit) {
  r = global()
  r.shuffle!(n, swap)
}

# Fills p with random bytes from the default source; returns p.size.
pub def read(p: [Byte]) -> Int {
  r = global()
  r.read!(p)
}

# A normally distributed Float (mean 0, standard deviation 1) from the default source.
pub def norm_float64 -> Float {
  r = global()
  r.norm_float64!()
}

# An exponentially distributed Float (rate 1) from the default source.
pub def exp_float64 -> Float {
  r = global()
  r.exp_float64!()
}
