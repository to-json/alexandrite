test "regress Perm" {
  r = new(new_source(0))
  want: [Int] = []
  assert_eq r.perm!(0), want
  want = [0]
  assert_eq r.perm!(1), want
  want = [0, 4, 1, 3, 2]
  assert_eq r.perm!(5), want
  want = [3, 1, 0, 4, 7, 5, 2, 6]
  assert_eq r.perm!(8), want
  want = [5, 0, 3, 6, 7, 4, 2, 1, 8]
  assert_eq r.perm!(9), want
  want = [4, 5, 0, 2, 6, 9, 3, 1, 8, 7]
  assert_eq r.perm!(10), want
  want = [14, 2, 0, 8, 3, 5, 13, 12, 1, 4, 6, 7, 11, 9, 15, 10]
  assert_eq r.perm!(16), want
  want: [Int] = []
  assert_eq r.perm!(0), want
  want = [0]
  assert_eq r.perm!(1), want
  want = [3, 0, 1, 2, 4]
  assert_eq r.perm!(5), want
  want = [5, 1, 2, 0, 4, 7, 3, 6]
  assert_eq r.perm!(8), want
  want = [4, 0, 6, 8, 1, 5, 2, 7, 3]
  assert_eq r.perm!(9), want
  want = [8, 6, 1, 7, 5, 4, 3, 2, 9, 0]
  assert_eq r.perm!(10), want
  want = [0, 3, 13, 2, 15, 4, 10, 1, 8, 14, 7, 6, 12, 9, 5, 11]
  assert_eq r.perm!(16), want
  want: [Int] = []
  assert_eq r.perm!(0), want
  want = [0]
  assert_eq r.perm!(1), want
  want = [0, 4, 2, 1, 3]
  assert_eq r.perm!(5), want
  want = [2, 1, 7, 0, 6, 3, 4, 5]
  assert_eq r.perm!(8), want
  want = [8, 7, 5, 3, 4, 6, 0, 1, 2]
  assert_eq r.perm!(9), want
  want = [1, 0, 2, 5, 7, 6, 9, 8, 3, 4]
  assert_eq r.perm!(10), want
}

test "regress Read" {
  r = new(new_source(0))
  b = [0.as_u8; 1]
  assert_eq r.read!(b), 1
  want: [Byte] = [1]
