#![overflow(wrap)]
# Go's rngSource: an additive lagged Fibonacci generator (Mitchell and
# Reeds), seeded by Park and Miller's minimal standard generator. The tables
# are in tables.alx.

RNG_LEN = 607
RNG_TAP = 273
RNG_MASK: U64 = (1 << 63) - 1
INT32_MAX = 2147483647

struct RngState {
  tap: Int
  feed: Int
  vec: [I64]
}

# The generator behind new_source (Go's unexported *rngSource). Its state
# is shared by every copy, as Go's pointer is. Not safe for concurrent use.
pub struct RngSource {
  st: [RngState]

  # Initializes the generator to the deterministic state for seed.
  pub def seed!(seed: Int) {
    st[0].tap = 0
    st[0].feed = RNG_LEN - RNG_TAP
    s = seed % INT32_MAX
    s += INT32_MAX if s < 0
    s = 89482311 if s == 0
    x = s.as_i32
    v = st[0].vec
    i = -20
    while i < RNG_LEN {
      x = seedrand(x)
      if i >= 0 {
        u = x.to_i << 40
        x = seedrand(x)
        u ^= x.to_i << 20
        x = seedrand(x)
        u ^= x.to_i
        u ^= RNG_COOKED[i]
        v[i] = u
      }
      i += 1
    }
  }

  # A non-negative pseudo-random 63-bit integer.
  pub def int63! -> Int { (uint64!() & RNG_MASK).as_i64 }

  # A pseudo-random 64-bit value.
  pub def uint64! -> U64 {
    tap = st[0].tap - 1
    tap += RNG_LEN if tap < 0
    feed = st[0].feed - 1
    feed += RNG_LEN if feed < 0
    v = st[0].vec
    x = v[feed] + v[tap]
    v[feed] = x
    st[0].tap = tap
    st[0].feed = feed
    x.as_u64
  }
}

# x[n+1] = 48271 * x[n] mod (2**31 - 1)
def seedrand(x: I32) -> I32 {
  a: I32 = 48271
  q: I32 = 44488
  r: I32 = 3399
  hi = x / q
  lo = x % q
  y = a * lo - r * hi
  y += INT32_MAX.as_i32 if y < 0
  y
}

# A new RngSource seeded with seed.
def new_rng_source(seed: Int) -> RngSource {
  r = RngSource.new(st: [RngState.new(tap: 0, feed: 0, vec: [0.as_i64; RNG_LEN])])
  r.seed!(seed)
  r
}
