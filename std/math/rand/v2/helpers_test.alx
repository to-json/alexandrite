# Helpers for the tests and the generated vectors.

# The bytes of a hex string.
def hx(s: Str) -> [Byte] {
  out: [Byte] = []
  k = 0
  while k + 1 < s.size {
    out << (nibble(s[k]) << 4 | nibble(s[k + 1]))
    k += 2
  }
  out
}

def nibble(c: Byte) -> Byte {
  return c - 48 if c <= 57
  c - 87
}

def seed_of(b: [Byte]) -> [Byte; 32] {
  seed: [Byte; 32] = [0; 32]
  for k in 0...32 { seed[k] = b[k] }
  seed
}

# chacha8_test.go's chacha8seed.
def chacha8_seed -> [Byte; 32] { seed_of("ABCDEFGHIJKLMNOPQRSTUVWXYZ123456".bytes) }

def zero_seed -> [Byte; 32] { [0; 32] }

# A ChaCha8 with chacha8_seed that has produced k values.
def chacha8_test_source(k: Int) -> ChaCha8 {
  p = new_chacha8(chacha8_seed())
  for _ in 0...k { p.uint64! }
  p
}

# Draws k values of a distribution from r (to start a vector block mid-run).
def skip(r: Rand, k: Int, dist: Str) {
  q = r
  for _ in 0...k {
    if dist == "norm_float64" {
      q.norm_float64!
    } else {
      q.exp_float64!
    }
  }
}
