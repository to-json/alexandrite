#![overflow(wrap)]
# PCG: Go's math/rand/v2 PCG source (a 128-bit LCG with the DXSM output
# permutation). See rand.alx for the API mapping.

# A PCG generator with 128 bits of internal state. Its state is a shared
# two-element slice (hi, lo), so copies are the same generator (Go's *PCG,
# GO-VS-RUBY D36). `PCG.new` is not usable: make one with new_pcg.
pub struct PCG {
  st: [U64]

  # Resets it to behave like new_pcg(seed1, seed2).
  pub def seed!(seed1: U64, seed2: U64) {
    self.st[0] = seed1
    self.st[1] = seed2
  }

  # Go's AppendBinary: b with "pcg:" and the state (big-endian) appended.
  pub def append_binary(b: [Byte]) -> [Byte] {
    out = b + "pcg:".bytes
    for w in [st[0], st[1]] {
      for k in 0...8 { out << (w >> (56 - 8 * k)).as_u8 }
    }
    out
  }

  # Go's MarshalBinary (which never fails).
  pub def marshal_binary -> [Byte] { append_binary([]) }

  # Go's UnmarshalBinary.
  pub def unmarshal_binary!(data: [Byte]) -> ~Unit<RandError> {
    fail RandError.InvalidPCG if data.size != 20 || !has_prefix(data, "pcg:")
    self.st[0] = be64(data, 4)
    self.st[1] = be64(data, 12)
  }

  # A uniformly distributed random U64.
  pub def uint64! -> U64 {
    # next: the 128-bit LCG step.
    mul_hi: U64 = 2549297995355413924
    mul_lo: U64 = 4865540595714422341
    inc_hi: U64 = 6364136223846793005
    inc_lo: U64 = 1442695040888963407
    s_hi = st[0]
    s_lo = st[1]
    # bits.mul64 and bits.add64, inline (u.__mulhi is the high word).
    lo = s_lo * mul_lo
    hi = s_lo.__mulhi(mul_lo) + s_hi * mul_lo + s_lo * mul_hi
    lo2 = lo + inc_lo
    hi2 = hi + inc_hi
    hi2 += 1 if lo2 < lo
    self.st[0] = hi2
    self.st[1] = lo2
    # The DXSM "double xorshift multiply" permutation.
    cheap_mul: U64 = 0xda942042e4dd58b5
    h = hi2
    h ^= h >> 32
    h *= cheap_mul
    h ^= h >> 48
    h *= lo2 | 1
    h
  }

  # The state (hi, lo), for tests and equality.
  pub def state -> (U64, U64) { (st[0], st[1]) }
}

# A new PCG seeded with the given values.
pub def new_pcg(seed1: U64, seed2: U64) -> PCG { PCG.new(st: [seed1, seed2]) }
