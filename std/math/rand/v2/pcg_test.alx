# Go's pcg_test.go.

test "PCG marshal" {
  p = new_pcg(0, 0)
  seed1: U64 = 0x123456789abcdef0
  seed2: U64 = 0xfedcba9876543210
  want = hx("7063673a123456789abcdef0fedcba9876543210")
  p.seed!(seed1, seed2)
  data = p.marshal_binary
  assert_eq data, want
  pre: [Byte] = [0, 0, 0, 0]
  assert_eq p.append_binary(pre), pre + want
  q = new_pcg(0, 0)
  q.unmarshal_binary!(want).unwrap
  assert_eq q.state, p.state
  qu = q.uint64!
  pu = p.uint64!
  assert_eq qu, pu
}

test "PCG unmarshal errors" {
  p = new_pcg(1, 2)
  r = p.unmarshal_binary!("pcg:".bytes)
  assert r.err?
  assert_eq r.err.unwrap.message, "invalid PCG encoding"
  bad = "pcx:0123456789abcdef".bytes
  assert p.unmarshal_binary!(bad).err?
  assert_eq p.state, (1, 2)
}

test "PCG" {
  p = new_pcg(1, 2)
  want: [U64] = [
    0xc4f5a58656eef510,
    0x9dcec3ad077dec6c,
    0xc8d04605312f8088,
    0xcbedc0dcb63ac19a,
    0x3bf98798cae97950,
    0xa8c6d7f8d485abc,
    0x7ffa3780429cd279,
    0x730ad2626b1c2f8e,
    0x21ff2330f4a0ad99,
    0x2f0901a1947094b0,
    0xa9735a3cfbe36cef,
    0x71ddb0a01a12c84a,
    0xf0e53e77a78453bb,
    0x1f173e9663be1e9d,
    0x657651da3ac4115e,
    0xc8987376b65a157b,
    0xbb17008f5fca28e7,
    0x8232bd645f29ed22,
    0x12be8f07ad14c539,
    0x54908a48e8e4736e,
  ]
  for x in want {
    assert_eq p.uint64!, x
  }
}

test "PCG copies share state" {
  p = new_pcg(1, 2)
  q = p
  a = p.uint64!
  b = q.uint64!
  assert a != b, "q continues p's sequence"
  assert_eq b, 0x9dcec3ad077dec6c
}

bench "PCG DXSM" {
  p = new_pcg(1, 2)
  t: U64 = 0
  for _ in 0...1000000 { t = t +% p.uint64! }
  assert t != 0
}
