test "ChaCha8 marshal read" {
  p = new_chacha8(chacha8_seed())
  assert_eq p.marshal_binary, hx("636861636861383a00000000000000004142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  q = new_chacha8(zero_seed())
  q.unmarshal_binary!(p.marshal_binary).unwrap
  p = q
  p.read!([0.as_u8])
  assert_eq p.marshal_binary, hx("726561646275663a0716463d06b673b7636861636861383a00000000000000014142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  q = new_chacha8(zero_seed())
