test "ChaCha8 marshal 0" {
  p = chacha8_test_source(0)
  assert_eq p.marshal_binary, hx("636861636861383a00000000000000004142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  assert_eq p.append_binary(hx("00000000")), hx("00000000636861636861383a00000000000000004142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  q = new_chacha8(zero_seed())
  q.unmarshal_binary!(p.marshal_binary).unwrap
  assert_eq q.uint64!, 0xb773b6063d4616a5
  p.uint64!
  assert_eq p.marshal_binary, hx("636861636861383a00000000000000014142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  assert_eq p.append_binary(hx("00000000")), hx("00000000636861636861383a00000000000000014142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  q = new_chacha8(zero_seed())
  q.unmarshal_binary!(p.marshal_binary).unwrap
  assert_eq q.uint64!, 0x1160af22a66abc3c
  p.uint64!
  assert_eq p.marshal_binary, hx("636861636861383a00000000000000024142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  assert_eq p.append_binary(hx("00000000")), hx("00000000636861636861383a00000000000000024142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  q = new_chacha8(zero_seed())
  q.unmarshal_binary!(p.marshal_binary).unwrap
  assert_eq q.uint64!, 0x8c2599d9418d287c
  p.uint64!
  assert_eq p.marshal_binary, hx("636861636861383a00000000000000034142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  assert_eq p.append_binary(hx("00000000")), hx("00000000636861636861383a00000000000000034142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  q = new_chacha8(zero_seed())
  q.unmarshal_binary!(p.marshal_binary).unwrap
  assert_eq q.uint64!, 0x7ee07e037edc5cd6
  p.uint64!
  assert_eq p.marshal_binary, hx("636861636861383a00000000000000044142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  assert_eq p.append_binary(hx("00000000")), hx("00000000636861636861383a00000000000000044142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  q = new_chacha8(zero_seed())
  q.unmarshal_binary!(p.marshal_binary).unwrap
  assert_eq q.uint64!, 0xcfaa9ee02d1c16ad
  p.uint64!
  assert_eq p.marshal_binary, hx("636861636861383a00000000000000054142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  assert_eq p.append_binary(hx("00000000")), hx("00000000636861636861383a00000000000000054142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  q = new_chacha8(zero_seed())
  q.unmarshal_binary!(p.marshal_binary).unwrap
  assert_eq q.uint64!, 0x0e090eef8febea79
  p.uint64!
  assert_eq p.marshal_binary, hx("636861636861383a00000000000000064142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  assert_eq p.append_binary(hx("00000000")), hx("00000000636861636861383a00000000000000064142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  q = new_chacha8(zero_seed())
  q.unmarshal_binary!(p.marshal_binary).unwrap
  assert_eq q.uint64!, 0x3c82d271128b5b3e
  p.uint64!
  assert_eq p.marshal_binary, hx("636861636861383a00000000000000074142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  assert_eq p.append_binary(hx("00000000")), hx("00000000636861636861383a00000000000000074142434445464748494a4b4c4d4e4f505152535455565758595a313233343536")
  q = new_chacha8(zero_seed())
  q.unmarshal_binary!(p.marshal_binary).unwrap
  assert_eq q.uint64!, 0x9c5addc11252a34f
