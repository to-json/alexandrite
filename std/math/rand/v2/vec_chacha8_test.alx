test "ChaCha8 reads" {
  p = new_chacha8(chacha8_seed())
  b: [Byte] = [0; 0]
  assert_eq p.read!(b), 0
  assert_eq b.size, 0
  b: [Byte] = [0; 1]
  assert_eq p.read!(b), 1
  assert_eq b, hx("a5")
  b: [Byte] = [0; 3]
  assert_eq p.read!(b), 3
  assert_eq b, hx("16463d")
  b: [Byte] = [0; 7]
  assert_eq p.read!(b), 7
  assert_eq b, hx("06b673b73cbc6a")
  b: [Byte] = [0; 8]
  assert_eq p.read!(b), 8
  assert_eq b, hx("a622af60117c288d")
  b: [Byte] = [0; 9]
  assert_eq p.read!(b), 9
  assert_eq b, hx("41d999258cd65cdc7e")
  b: [Byte] = [0; 15]
  assert_eq p.read!(b), 15
  assert_eq b, hx("037ee07ead161c2de09eaacf79eaeb")
  b: [Byte] = [0; 16]
  assert_eq p.read!(b), 16
  assert_eq b, hx("8fef0e090e3e5b8b1271d2823c4fa352")
  b: [Byte] = [0; 17]
  assert_eq p.read!(b), 17
  assert_eq b, hx("12c1dd5a9ca6ee6c7d61bb79df6a739d1f")
  b: [Byte] = [0; 31]
  assert_eq p.read!(b), 31
  assert_eq b, hx("5953d5361fe01e184ed1f0ee3684e50a76fc9b0868d22acc592be5d9ba8a1b")
  b: [Byte] = [0; 100]
  assert_eq p.read!(b), 100
  assert_eq b, hx("4b44b42feb6166c492a6c8954f2ce6ca173232c6c37e2e4e7f36b4eb91c69beca0c6f24c7820beea345cec345ca8da7055518f0a4ff26b3d11b4dc35fcbc5455644ca40d5be1d921dba33d966df300e55031fcaeeea55037da3d92372db0c84b6d627a0d")
  b: [Byte] = [0; 5]
  assert_eq p.read!(b), 5
  assert_eq b, hx("3849eed7e3")
  b: [Byte] = [0; 2]
  assert_eq p.read!(b), 2
  assert_eq b, hx("ed68")
  b: [Byte] = [0; 64]
  assert_eq p.read!(b), 64
  assert_eq b, hx("afee7c713b88956635f4a495243921906a841ba630965410858e93e4ba5d5402dc18433d5aa6f09f8f0f80f00f19f765f0cc30336739aad176fd3364ba6c9332")
}
