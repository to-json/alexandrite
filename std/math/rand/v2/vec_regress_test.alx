test "regress Perm" {
  r = new(new_pcg(1, 2))
  assert_eq r.perm!(0), []
  assert_eq r.perm!(1), [0]
  assert_eq r.perm!(5), [1, 4, 2, 0, 3]
  assert_eq r.perm!(8), [4, 3, 6, 1, 5, 2, 7, 0]
  assert_eq r.perm!(9), [6, 5, 1, 8, 7, 2, 0, 3, 4]
  assert_eq r.perm!(10), [9, 4, 2, 5, 6, 8, 1, 7, 0, 3]
  assert_eq r.perm!(16), [5, 9, 3, 1, 4, 2, 10, 7, 15, 11, 0, 14, 13, 8, 6, 12]
  assert_eq r.perm!(0), []
  assert_eq r.perm!(1), [0]
  assert_eq r.perm!(5), [4, 2, 1, 3, 0]
  assert_eq r.perm!(8), [0, 2, 3, 1, 5, 4, 6, 7]
  assert_eq r.perm!(9), [2, 0, 8, 3, 4, 7, 6, 5, 1]
  assert_eq r.perm!(10), [0, 6, 5, 3, 8, 4, 1, 2, 9, 7]
  assert_eq r.perm!(16), [9, 14, 4, 11, 13, 8, 0, 6, 2, 12, 3, 7, 1, 10, 5, 15]
  assert_eq r.perm!(0), []
  assert_eq r.perm!(1), [0]
  assert_eq r.perm!(5), [2, 4, 0, 3, 1]
  assert_eq r.perm!(8), [3, 2, 1, 0, 7, 5, 4, 6]
  assert_eq r.perm!(9), [1, 3, 4, 5, 0, 2, 7, 8, 6]
  assert_eq r.perm!(10), [1, 8, 4, 7, 2, 6, 5, 9, 0, 3]
}

