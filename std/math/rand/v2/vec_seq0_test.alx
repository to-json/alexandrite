  assert_eq z.uint64!, 2
  assert_eq z.uint64!, 0
}

test "zipf src0 s=1.0001 v=1 imax=10" {
  r = new(new_pcg(1, 2))
  z = new_zipf(r, 1.0001, 1.0, 10).unwrap
