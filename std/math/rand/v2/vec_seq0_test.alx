test "perm and shuffle src0" {
  r = new(new_pcg(1, 2))
  assert_eq r.perm!(0), []
  xs = (0...0).map { |i| i * i }
  r.shuffle!(0) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, []
  assert_eq r.perm!(1), [0]
  xs = (0...1).map { |i| i * i }
  r.shuffle!(1) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [0]
  assert_eq r.perm!(2), [1, 0]
  xs = (0...2).map { |i| i * i }
  r.shuffle!(2) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [1, 0]
  assert_eq r.perm!(3), [1, 0, 2]
  xs = (0...3).map { |i| i * i }
  r.shuffle!(3) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [1, 4, 0]
  assert_eq r.perm!(10), [6, 8, 0, 5, 2, 3, 7, 1, 9, 4]
  xs = (0...10).map { |i| i * i }
  r.shuffle!(10) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [25, 81, 16, 9, 64, 1, 0, 4, 36, 49]
  assert_eq r.perm!(52), [11, 42, 20, 29, 18, 9, 5, 41, 4, 8, 2, 32, 35, 10, 39, 37, 7, 51, 49, 19, 12, 48, 6, 15, 26, 47, 43, 24, 16, 28, 34, 31, 1, 23, 13, 44, 33, 14, 3, 45, 38, 25, 0, 22, 30, 27, 21, 46, 40, 50, 36, 17]
  xs = (0...52).map { |i| i * i }
  r.shuffle!(52) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [1296, 1849, 1600, 961, 9, 1521, 2116, 169, 400, 576, 1, 1936, 2500, 676, 841, 256, 1764, 225, 2304, 81, 4, 1681, 2025, 36, 0, 16, 1024, 2601, 1225, 484, 625, 729, 1444, 1089, 1156, 441, 361, 144, 100, 2401, 2209, 529, 49, 1369, 784, 324, 25, 121, 196, 64, 289, 900]
  assert_eq r.perm!(100), [37, 12, 42, 67, 8, 45, 31, 16, 80, 53, 85, 86, 9, 81, 36, 29, 77, 41, 73, 68, 44, 90, 5, 61, 47, 78, 6, 96, 39, 26, 32, 71, 13, 3, 14, 40, 0, 92, 28, 52, 20, 83, 54, 51, 23, 4, 46, 70, 56, 99, 38, 62, 66, 72, 34, 21, 50, 24, 1, 49, 79, 2, 27, 84, 33, 22, 18, 15, 19, 74, 58, 91, 65, 30, 11, 57, 98, 87, 69, 97, 95, 82, 35, 76, 59, 10, 89, 55, 75, 48, 25, 63, 7, 88, 43, 60, 64, 93, 17, 94]
  xs = (0...100).map { |i| i * i }
  r.shuffle!(100) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [5625, 8649, 2601, 4900, 4356, 7056, 1936, 4624, 1600, 8281, 529, 3249, 3600, 289, 1156, 6724, 196, 1225, 2304, 225, 9604, 2209, 1, 2916, 2809, 9801, 1764, 4761, 0, 841, 6889, 961, 441, 3969, 2116, 361, 2500, 7921, 2401, 5929, 5329, 1444, 400, 100, 484, 1369, 6561, 1296, 1681, 324, 3481, 1849, 4, 5184, 9025, 3844, 49, 729, 6241, 9216, 4489, 2704, 5476, 81, 5041, 3136, 900, 7225, 784, 5776, 7569, 256, 3364, 121, 3025, 9409, 2025, 7396, 1521, 9, 7744, 625, 25, 1024, 8836, 6084, 3721, 4096, 676, 4225, 8100, 64, 1089, 576, 169, 36, 144, 16, 6400, 8464]
}

