test "perm and shuffle src1" {
  r = new(new_pcg(0xdeadbeef, 0x12345678))
  assert_eq r.perm!(0), []
  xs = (0...0).map { |i| i * i }
  r.shuffle!(0) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, []
  assert_eq r.perm!(1), [0]
  xs = (0...1).map { |i| i * i }
  r.shuffle!(1) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [0]
  assert_eq r.perm!(2), [1, 0]
  xs = (0...2).map { |i| i * i }
  r.shuffle!(2) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [1, 0]
  assert_eq r.perm!(3), [0, 1, 2]
  xs = (0...3).map { |i| i * i }
  r.shuffle!(3) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [1, 0, 4]
  assert_eq r.perm!(10), [8, 5, 0, 1, 7, 3, 4, 9, 2, 6]
  xs = (0...10).map { |i| i * i }
  r.shuffle!(10) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [36, 9, 49, 16, 4, 0, 81, 1, 64, 25]
  assert_eq r.perm!(52), [24, 41, 26, 32, 46, 48, 39, 21, 36, 10, 35, 40, 44, 6, 4, 22, 0, 20, 38, 3, 30, 12, 33, 1, 50, 8, 9, 47, 7, 19, 15, 2, 11, 27, 13, 14, 16, 29, 18, 45, 31, 51, 23, 37, 25, 42, 17, 34, 5, 28, 49, 43]
  xs = (0...52).map { |i| i * i }
  r.shuffle!(52) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [16, 2401, 169, 144, 729, 1444, 25, 100, 49, 64, 900, 441, 4, 2209, 2304, 81, 256, 1156, 2116, 2025, 1849, 676, 1521, 1369, 196, 484, 1225, 784, 225, 36, 0, 1681, 1600, 1024, 361, 2500, 9, 324, 1936, 961, 1089, 625, 289, 529, 2601, 1, 1764, 121, 576, 841, 1296, 400]
  assert_eq r.perm!(100), [6, 77, 86, 8, 91, 68, 29, 14, 2, 42, 44, 3, 30, 22, 23, 28, 82, 97, 33, 57, 38, 85, 73, 88, 5, 58, 90, 99, 83, 10, 46, 52, 45, 27, 39, 32, 48, 94, 96, 51, 50, 89, 66, 15, 26, 59, 55, 16, 60, 64, 13, 19, 37, 20, 18, 63, 0, 69, 1, 35, 78, 56, 17, 36, 25, 54, 65, 74, 72, 47, 9, 24, 21, 31, 53, 87, 98, 49, 61, 75, 12, 11, 40, 71, 79, 95, 43, 80, 93, 34, 70, 76, 7, 81, 4, 92, 84, 41, 67, 62]
  xs = (0...100).map { |i| i * i }
  r.shuffle!(100) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [484, 121, 7396, 9216, 784, 5776, 1600, 4096, 9604, 8100, 7569, 5329, 5041, 2704, 1936, 256, 3844, 25, 900, 16, 400, 6889, 6724, 4, 1681, 961, 2209, 729, 7225, 196, 81, 2025, 8281, 9, 100, 2601, 1521, 1024, 1369, 1225, 3721, 9409, 169, 49, 841, 5184, 9025, 3025, 7744, 225, 8464, 7056, 2916, 529, 36, 4624, 3481, 3364, 0, 1444, 2304, 576, 4489, 3969, 7921, 361, 6561, 324, 289, 64, 5625, 5476, 3600, 1156, 3249, 4225, 5929, 1089, 8836, 1764, 3136, 2500, 6084, 6241, 676, 441, 1296, 2116, 4356, 1, 1849, 625, 9801, 8649, 4761, 4900, 144, 6400, 2401, 2809]
}

