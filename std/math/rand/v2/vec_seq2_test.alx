test "perm and shuffle src2" {
  r = new(new_chacha8(chacha8_seed()))
  assert_eq r.perm!(0), []
  xs = (0...0).map { |i| i * i }
  r.shuffle!(0) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, []
  assert_eq r.perm!(1), [0]
  xs = (0...1).map { |i| i * i }
  r.shuffle!(1) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [0]
  assert_eq r.perm!(2), [0, 1]
  xs = (0...2).map { |i| i * i }
  r.shuffle!(2) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [1, 0]
  assert_eq r.perm!(3), [2, 0, 1]
  xs = (0...3).map { |i| i * i }
  r.shuffle!(3) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [0, 1, 4]
  assert_eq r.perm!(10), [3, 7, 9, 4, 0, 8, 1, 6, 5, 2]
  xs = (0...10).map { |i| i * i }
  r.shuffle!(10) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [9, 81, 64, 0, 16, 1, 4, 36, 25, 49]
  assert_eq r.perm!(52), [37, 21, 28, 41, 33, 6, 25, 34, 16, 39, 15, 48, 29, 51, 44, 38, 19, 32, 43, 31, 22, 18, 36, 23, 20, 7, 40, 5, 12, 3, 8, 0, 14, 45, 50, 27, 30, 1, 13, 10, 17, 47, 42, 35, 2, 4, 26, 24, 49, 46, 11, 9]
  xs = (0...52).map { |i| i * i }
  r.shuffle!(52) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [324, 169, 729, 784, 36, 16, 1764, 576, 1024, 1444, 1936, 676, 1296, 900, 1849, 144, 1089, 2209, 2500, 1156, 256, 1369, 1225, 2304, 2116, 625, 0, 484, 2025, 2601, 1600, 81, 100, 1681, 361, 289, 25, 400, 961, 529, 4, 64, 441, 196, 121, 49, 1, 9, 841, 2401, 225, 1521]
  assert_eq r.perm!(100), [19, 37, 72, 22, 48, 57, 30, 40, 4, 18, 59, 46, 99, 13, 56, 27, 77, 21, 23, 51, 82, 66, 29, 8, 64, 93, 36, 28, 25, 6, 90, 89, 44, 20, 60, 16, 79, 92, 69, 34, 26, 70, 50, 81, 84, 5, 73, 11, 38, 12, 45, 43, 15, 86, 68, 63, 87, 53, 54, 58, 42, 10, 35, 7, 75, 88, 49, 95, 76, 91, 83, 1, 52, 94, 67, 85, 61, 41, 47, 96, 24, 65, 14, 33, 78, 62, 71, 98, 31, 2, 3, 17, 55, 97, 9, 32, 0, 80, 39, 74]
  xs = (0...100).map { |i| i * i }
  r.shuffle!(100) { |i, j| xs[i], xs[j] = xs[j], xs[i] }
  assert_eq xs, [1936, 8281, 36, 2809, 5041, 9216, 5625, 256, 961, 7396, 121, 2601, 25, 2401, 3600, 361, 784, 900, 3844, 2304, 6561, 1296, 6724, 5476, 4761, 7056, 3969, 5184, 5776, 8649, 144, 9, 2209, 676, 1521, 9604, 3249, 3025, 1, 196, 841, 8100, 484, 324, 1444, 81, 2025, 9025, 2704, 1600, 7921, 100, 1849, 169, 9409, 289, 0, 5329, 6400, 8836, 1369, 6889, 4096, 441, 1089, 3481, 4900, 4225, 3721, 1156, 1764, 16, 7225, 7744, 2116, 576, 6084, 4356, 6241, 2916, 729, 225, 4489, 529, 400, 4624, 4, 5929, 2500, 64, 8464, 3364, 3136, 1024, 1225, 7569, 9801, 49, 625, 1681]
}

