test "mixed src2" {
  r = new(new_chacha8(chacha8_seed()))
  assert_eq r.float64!.__bits, 0x3fe3b6063d4616a5
  assert_eq r.float32!.__bits, 0x3fd82bc880000000
  assert_eq r.int_n!(1000), 547
  assert_eq r.int_n!(3), 1
  assert_eq r.int64_n!((1 << 62) + 12345), 3740986849389653193
  assert_eq r.uint64_n!(0xFFFFFFFFFFFFFFF1), 1011356013395962488
  assert_eq r.uint32_n!(0x80000001), 507603256
  assert_eq r.int32_n!(7), 4
  assert_eq r.uint_n!(1 << 40), 418716118694
  assert_eq r.n!(1000000007), 214192591
