# Zipf: Go's math/rand/v2 Zipf distribution ("Rejection-inversion to
# generate variates from monotone discrete distributions", Hörmann and
# Derflinger, 1996). See rand.alx for the API mapping.

import "math"

# A Zipf distributed variate generator.
pub struct Zipf {
  r: Rand
  imax: Float
  v: Float
  q: Float
  s: Float
  oneminus_q: Float
  oneminus_qinv: Float
  hxm: Float
  hx0minus_hxm: Float

  def h(x: Float) -> Float { math.exp(oneminus_q * math.log(v + x)) * oneminus_qinv }

  def hinv(x: Float) -> Float { math.exp(oneminus_qinv * math.log(oneminus_q * x)) - v }

  # A value drawn from the Zipf distribution.
  pub def uint64! -> U64 {
    k = 0.0
    while true {
      r1 = self.r.float64! # r on [0,1]
      ur = hxm + r1 * hx0minus_hxm
      x = hinv(ur)
      k = math.floor(x + 0.5)
      break if k - x <= s
      break if ur >= h(k + 0.5) - math.exp(-math.log(k + v) * q)
    }
    k.to_u64
  }
}

# A Zipf variate generator drawing from r: values k in [0, imax] with P(k)
# proportional to (v + k) ** (-s). Requires s > 1 and v >= 1; none otherwise
# (Go returns nil).
pub def new_zipf(r: Rand, s: Float, v: Float, imax: U64) -> Zipf? {
  return none if s <= 1.0 || v < 1.0
  z = Zipf.new(r: r, imax: u64_to_f(imax), v: v, q: s)
  z.oneminus_q = 1.0 - z.q
  z.oneminus_qinv = 1.0 / z.oneminus_q
  z.hxm = z.h(z.imax + 0.5)
  z.hx0minus_hxm = z.h(0.5) - math.exp(math.log(z.v) * -z.q) - z.hxm
  z.s = 1.0 - z.hinv(z.h(1.5) - math.exp(-z.q * math.log(z.v + 1.0)))
  z
}

# Go's float64(u) for any U64 (rounded to nearest even).
def u64_to_f(u: U64) -> Float {
  return u.as_i64.to_f if u >> 63 == 0
  # Halve with the low bit kept sticky, convert, double: exact rounding.
  ((u >> 1) | (u & 1)).as_i64.to_f * 2.0
}
