  assert_eq r.read!(buf), 8
  want: [Byte] = [203, 31, 161, 62, 251, 30, 4, 55]
  assert_eq buf, want
  assert_eq r.int63!(), 2962186951617203768
  r.seed!(1099511627777)
  assert_eq r.int63!(), 1092155856703575120
}

