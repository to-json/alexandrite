LGAM_U: [Float] = [
  -7.72156649015328655494e-02,
  6.32827064025093366517e-01,
  1.45492250137234768737e+00,
  9.77717527963372745603e-01,
  2.28963728064692451092e-01,
  1.33810918536787660377e-02,
]

LGAM_V: [Float] = [
  1.0,
  2.45597793713041134822e+00,
  2.12848976379893395361e+00,
  7.69285150456672783825e-01,
  1.04222645593369134254e-01,
  3.21709242282423911810e-03,
]

LGAM_W: [Float] = [
  4.18938533204672725052e-01,
  8.33333333333329678849e-02,
  -2.77777777728775536470e-03,
  7.93650558643019558500e-04,
  -5.95187557450339963135e-04,
  8.36339918996282139126e-04,
  -1.63092934096575273989e-03,
]

# The natural logarithm of |Gamma(x)| and the sign of Gamma(x) (-1 or 1):
# lgamma(+Inf) = +Inf, lgamma(0) = +Inf, lgamma(-integer) = +Inf,
# lgamma(-Inf) = -Inf, lgamma(NaN) = NaN.
pub def lgamma(x: Float) -> (Float, Int) {
  two52 = 4503599627370496.0   # 1 << 52
  two58 = 288230376151711744.0 # 1 << 58
  tiny = 8.470329472543003e-22 # 2**-70
  tc = 1.46163214496836224576e+00
  tf = -1.21486290535849611461e-01
  # tt = -(tail of tf)
  tt = -3.63867699703950536541e-18
  # Go's constant expressions on Ymin = 1.461632144968362245 and Tc, rounded once:
  ymin_m1_p027 = 0.7316321449683623  # Ymin - 1 + 0.27
  ymin_m1_m027 = 0.19163214496836226 # Ymin - 1 - 0.27
  ymin_p027 = 1.7316321449683623     # Ymin + 0.27
  ymin_m027 = 1.1916321449683622     # Ymin - 0.27
  tc_m1 = 0.46163214496836225        # Tc - 1
  sign = 1
  return (x, sign) if is_nan(x)
  return (x, sign) if is_inf(x, 0)
  return (inf(1), sign) if x == 0.0
  neg = false
  if x < 0.0 {
    x = -x
    neg = true
  }
  if x < tiny { # if |x| < 2**-70, return -log(|x|)
    sign = -1 if neg
    return (-log(x), sign)
  }
  nadj = 0.0
  if neg {
    return (inf(1), sign) if x >= two52 # |x| >= 2**52, must be -integer
    t = sin_pi(x)
    return (inf(1), sign) if t == 0.0 # -integer
    nadj = log(PI / (t * x).abs)
    sign = -1 if t < 0.0
  }
  lg = 0.0
  if x == 1.0 || x == 2.0 { # purge off 1 and 2
    return (0.0, sign)
  } else if x < 2.0 { # use lgamma(x) = lgamma(x+1) - log(x)
    y = 0.0
    i = 0
    if x <= 0.9 {
      lg = -log(x)
      if x >= ymin_m1_p027 { # 0.7316 <= x <=  0.9
        y = 1.0 - x
        i = 0
      } else if x >= ymin_m1_m027 { # 0.2316 <= x < 0.7316
        y = x - tc_m1
        i = 1
      } else { # 0 < x < 0.2316
        y = x
        i = 2
      }
    } else {
      lg = 0.0
      if x >= ymin_p027 { # 1.7316 <= x < 2
        y = 2.0 - x
        i = 0
      } else if x >= ymin_m027 { # 1.2316 <= x < 1.7316
        y = x - tc
        i = 1
      } else { # 0.9 < x < 1.2316
        y = x - 1.0
        i = 2
      }
    }
    case i {
      0 => {
        z = y * y
        p1 = LGAM_A[0] + z * (LGAM_A[2] + z * (LGAM_A[4] + z * (LGAM_A[6] + z * (LGAM_A[8] + z * LGAM_A[10]))))
        p2 = z * (LGAM_A[1] + z * (LGAM_A[3] + z * (LGAM_A[5] + z * (LGAM_A[7] + z * (LGAM_A[9] + z * LGAM_A[11])))))
        p = y * p1 + p2
        lg += (p - 0.5 * y)
      }
      1 => {
        z = y * y
        w = z * y
        p1 = LGAM_T[0] + w * (LGAM_T[3] + w * (LGAM_T[6] + w * (LGAM_T[9] + w * LGAM_T[12]))) # parallel comp
        p2 = LGAM_T[1] + w * (LGAM_T[4] + w * (LGAM_T[7] + w * (LGAM_T[10] + w * LGAM_T[13])))
        p3 = LGAM_T[2] + w * (LGAM_T[5] + w * (LGAM_T[8] + w * (LGAM_T[11] + w * LGAM_T[14])))
        p = z * p1 - (tt - w * (p2 + y * p3))
        lg += (tf + p)
      }
      _ => {
        p1 = y * (LGAM_U[0] + y * (LGAM_U[1] + y * (LGAM_U[2] + y * (LGAM_U[3] + y * (LGAM_U[4] + y * LGAM_U[5])))))
        p2 = 1.0 + y * (LGAM_V[1] + y * (LGAM_V[2] + y * (LGAM_V[3] + y * (LGAM_V[4] + y * LGAM_V[5]))))
        lg += (-0.5 * y + p1 / p2)
      }
    }
  } else if x < 8.0 { # 2 <= x < 8
    i = x.to_i
    y = x - i.to_f
    p = y * (LGAM_S[0] + y * (LGAM_S[1] + y * (LGAM_S[2] + y * (LGAM_S[3] + y * (LGAM_S[4] + y * (LGAM_S[5] + y * LGAM_S[6]))))))
    q = 1.0 + y * (LGAM_R[1] + y * (LGAM_R[2] + y * (LGAM_R[3] + y * (LGAM_R[4] + y * (LGAM_R[5] + y * LGAM_R[6])))))
    lg = 0.5 * y + p / q
    z = 1.0 # lgamma(1+s) = log(s) + lgamma(s)
    # Go's switch with fallthrough from case 7 down to case 3.
    if i >= 3 {
      z *= (y + 6.0) if i >= 7
      z *= (y + 5.0) if i >= 6
      z *= (y + 4.0) if i >= 5
      z *= (y + 3.0) if i >= 4
      z *= (y + 2.0)
      lg += log(z)
    }
  } else if x < two58 { # 8 <= x < 2**58
    t = log(x)
    z = 1.0 / x
    y = z * z
    w = LGAM_W[0] + z * (LGAM_W[1] + y * (LGAM_W[2] + y * (LGAM_W[3] + y * (LGAM_W[4] + y * (LGAM_W[5] + y * LGAM_W[6])))))
    lg = (x - 0.5) * (t - 1.0) + w
  } else { # 2**58 <= x <= Inf
    lg = x * (log(x) - 1.0)
  }
  lg = nadj - lg if neg
  (lg, sign)
}

# sin(Pi*x) for x > 0, for lgamma; the result is negated (Go's sinPi).
def sin_pi(x: Float) -> Float {
  two52 = 4503599627370496.0 # 1 << 52
  two53 = 9007199254740992.0 # 1 << 53
  return -sin(PI * x) if x < 0.25
  # argument reduction
  z = floor(x)
  n = 0
  if z != x { # inexact
    x = mod(x, 2.0)
    n = (x * 4.0).to_i
  } else {
    if x >= two53 { # x must be even
      x = 0.0
      n = 0
    } else {
      z = x + two52 if x < two52 # exact
      n = (1 & float64bits(z)).to_i
      x = n.to_f
      n <<= 2
    }
  }
  x = case n {
    0 => sin(PI * x)
    1..2 => cos(PI * (0.5 - x))
    3..4 => sin(PI * (1.0 - x))
    5..6 => -cos(PI * (x - 1.5))
    _ => sin(PI * (x - 2.0))
  }
  -x
}
