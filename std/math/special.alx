# Gamma(x) by Stirling's formula, as two factors whose product is the result
# (so the caller can avoid overflow). Valid for 33 <= x <= 172.
def stirling(x: Float) -> (Float, Float) {
  return (inf(1), 1.0) if x > 200.0
  sqrt_two_pi = 2.506628274631000502417
  max_stirling = 143.01608
  w = 1.0 / x
  w = 1.0 + w * ((((GAM_S[0] * w + GAM_S[1]) * w + GAM_S[2]) * w + GAM_S[3]) * w + GAM_S[4])
  y1 = exp(x)
  y2 = 1.0
  if x > max_stirling { # avoid pow() overflow
    v = pow(x, 0.5 * x - 0.25)
    y2 = v / y1
    y1 = v
  } else {
    y1 = pow(x, x - 0.5) / y1
  }
  (y1, sqrt_two_pi * w * y2)
}

# The Gamma function: gamma(+Inf) = +Inf, gamma(±0) = ±Inf, NaN at negative
# integers, -Inf and NaN.
pub def gamma(x: Float) -> Float {
  euler = 0.57721566490153286060651209008240243104215933593992 # A001620
  return nan if neg_int?(x) || is_inf(x, -1) || is_nan(x)
  return inf(1) if is_inf(x, 1)
  if x == 0.0 {
    return inf(-1) if signbit(x)
    return inf(1)
  }
  q = x.abs
  p = floor(q)
  if q > 33.0 {
    if x >= 0.0 {
      y1, y2 = stirling(x)
      return y1 * y2
    }
    # Note: x is negative but (checked above) not a negative integer,
    # so x must be small enough to be in range for conversion to Int.
    signgam = 1
    signgam = -1 if p.to_i & 1 == 0
    z = q - p
    if z > 0.5 {
      p = p + 1.0
      z = q - p
    }
    z = q * sin(PI * z)
    return inf(signgam) if z == 0.0
    sq1, sq2 = stirling(q)
    absz = z.abs
    d = absz * sq1 * sq2
    if is_inf(d, 0) {
      z = PI / absz / sq1 / sq2
    } else {
      z = PI / d
    }
    return signgam.to_f * z
  }
  # Reduce argument
  z = 1.0
  while x >= 3.0 {
    x = x - 1.0
    z = z * x
  }
  while x < 0.0 {
    return gamma_small(x, z, euler) if x > -1e-09
    z = z / x
    x = x + 1.0
  }
  while x < 2.0 {
    return gamma_small(x, z, euler) if x < 1e-09
    z = z / x
    x = x + 1.0
  }
  return z if x == 2.0
  x = x - 2.0
  p = (((((x * GAM_P[0] + GAM_P[1]) * x + GAM_P[2]) * x + GAM_P[3]) * x + GAM_P[4]) * x + GAM_P[5]) * x + GAM_P[6]
  q = ((((((x * GAM_Q[0] + GAM_Q[1]) * x + GAM_Q[2]) * x + GAM_Q[3]) * x + GAM_Q[4]) * x + GAM_Q[5]) * x + GAM_Q[6]) * x + GAM_Q[7]
  z * p / q
}

# Go's `small:` label in Gamma.
def gamma_small(x: Float, z: Float, euler: Float) -> Float {
  return inf(1) if x == 0.0
  z / ((1.0 + euler * x) * x)
}

def neg_int?(x: Float) -> Bool {
  if x < 0.0 {
    _, xf = modf(x)
    return xf == 0.0
  }
  false
}

