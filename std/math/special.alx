# Special functions: Go's portable implementations (cbrt.go, erf.go,
# erfinv.go, gamma.go, lgamma.go, from FreeBSD's msun and Cephes), line for
# line, so results are bit-identical with Go's pure-Go math on every backend.

# ---- cube root ----

# The cube root of x: cbrt(±0) = ±0, cbrt(±Inf) = ±Inf, cbrt(NaN) = NaN.
pub def cbrt(x: Float) -> Float {
  b1: U64 = 715094163                           # (682-0.03306235651)*2**20
  b2: U64 = 696219795                           # (664-0.03306235651)*2**20
  c = 5.42857142857142815906e-01                # 19/35
  d = -7.05306122448979611050e-01               # -864/1225
  e = 1.41428571428571436819e+00                # 99/70
  f = 1.60714285714285720630e+00                # 45/28
  g = 3.57142857142857150787e-01                # 5/14
  smallest_normal = 2.22507385850720138309e-308 # 2**-1022
  return x if x == 0.0 || is_nan(x) || is_inf(x, 0)
  sign = false
  if x < 0.0 {
    x = -x
    sign = true
  }
  # rough cbrt to 5 bits
  t = float64frombits(float64bits(x) / 3 + (b1 << 32))
  if x < smallest_normal {
    # subnormal: scale up by 2**54 first
    t = 18014398509481984.0 # 1 << 54
    t *= x
    t = float64frombits(float64bits(t) / 3 + (b2 << 32))
  }
  # new cbrt to 23 bits
  r = t * t / x
  s = c + r * t
  t *= g + f / (s + e + d / s)
  # chop to 22 bits, make larger than cbrt(x)
  t = float64frombits((float64bits(t) & (0xFFFFFFFFC << 28)) + (1 << 30))
  # one step newton iteration to 53 bits with error less than 0.667ulps
  s = t * t # t*t is exact
  r = x / s
  w = t + t
  r = (r - t) / (w + r) # r-s is exact
  t = t + t * r
  t = -t if sign
  t
}

# ---- error function ----

ERF_ERX = 8.45062911510467529297e-01
# Coefficients for approximation to erf in |x| <= 0.84375.
ERF_EFX = 1.28379167095512586316e-01
ERF_EFX8 = 1.02703333676410069053e+00
ERF_PP0 = 1.28379167095512558561e-01
ERF_PP1 = -3.25042107247001499370e-01
ERF_PP2 = -2.84817495755985104766e-02
ERF_PP3 = -5.77027029648944159157e-03
ERF_PP4 = -2.37630166566501626084e-05
ERF_QQ1 = 3.97917223959155352819e-01
ERF_QQ2 = 6.50222499887672944485e-02
ERF_QQ3 = 5.08130628187576562776e-03
ERF_QQ4 = 1.32494738004321644526e-04
ERF_QQ5 = -3.96022827877536812320e-06
# Coefficients for approximation to erf in 0.84375 <= |x| <= 1.25.
ERF_PA0 = -2.36211856075265944077e-03
ERF_PA1 = 4.14856118683748331666e-01
ERF_PA2 = -3.72207876035701323847e-01
ERF_PA3 = 3.18346619901161753674e-01
ERF_PA4 = -1.10894694282396677476e-01
ERF_PA5 = 3.54783043256182359371e-02
ERF_PA6 = -2.16637559486879084300e-03
ERF_QA1 = 1.06420880400844228286e-01
ERF_QA2 = 5.40397917702171048937e-01
ERF_QA3 = 7.18286544141962662868e-02
ERF_QA4 = 1.26171219808761642112e-01
ERF_QA5 = 1.36370839120290507362e-02
ERF_QA6 = 1.19844998467991074170e-02
# Coefficients for approximation to erfc in 1.25 <= |x| <= 1/0.35.
ERF_RA0 = -9.86494403484714822705e-03
ERF_RA1 = -6.93858572707181764372e-01
ERF_RA2 = -1.05586262253232909814e+01
ERF_RA3 = -6.23753324503260060396e+01
ERF_RA4 = -1.62396669462573470355e+02
ERF_RA5 = -1.84605092906711035994e+02
ERF_RA6 = -8.12874355063065934246e+01
ERF_RA7 = -9.81432934416914548592e+00
ERF_SA1 = 1.96512716674392571292e+01
ERF_SA2 = 1.37657754143519042600e+02
ERF_SA3 = 4.34565877475229228821e+02
ERF_SA4 = 6.45387271733267880336e+02
ERF_SA5 = 4.29008140027567833386e+02
ERF_SA6 = 1.08635005541779435134e+02
ERF_SA7 = 6.57024977031928170135e+00
ERF_SA8 = -6.04244152148580987438e-02
# Coefficients for approximation to erfc in 1/0.35 <= |x| <= 28.
ERF_RB0 = -9.86494292470009928597e-03
ERF_RB1 = -7.99283237680523006574e-01
ERF_RB2 = -1.77579549177547519889e+01
ERF_RB3 = -1.60636384855821916062e+02
ERF_RB4 = -6.37566443368389627722e+02
ERF_RB5 = -1.02509513161107724954e+03
ERF_RB6 = -4.83519191608651397019e+02
ERF_SB1 = 3.03380607434824582924e+01
ERF_SB2 = 3.25792512996573918826e+02
ERF_SB3 = 1.53672958608443695994e+03
ERF_SB4 = 3.19985821950859553908e+03
ERF_SB5 = 2.55305040643316442583e+03
ERF_SB6 = 4.74528541206955367215e+02
ERF_SB7 = -2.24409524465858183362e+01
ERF_INV035 = 2.857142857142857 # 1/0.35, rounded once as Go's constant is

# The error function of x: erf(±Inf) = ±1, erf(NaN) = NaN.
pub def erf(x: Float) -> Float {
  very_tiny = 2.848094538889218e-306 # 0x0080000000000000
  small = 3.725290298461914e-09      # 2**-28
  return nan if is_nan(x)
  return 1.0 if is_inf(x, 1)
  return -1.0 if is_inf(x, -1)
  sign = false
  if x < 0.0 {
    x = -x
    sign = true
  }
  if x < 0.84375 { # |x| < 0.84375
    temp = 0.0
    if x < small { # |x| < 2**-28
      if x < very_tiny {
        temp = 0.125 * (8.0 * x + ERF_EFX8 * x) # avoid underflow
      } else {
        temp = x + ERF_EFX * x
      }
    } else {
      z = x * x
      r = ERF_PP0 + z * (ERF_PP1 + z * (ERF_PP2 + z * (ERF_PP3 + z * ERF_PP4)))
      s = 1.0 + z * (ERF_QQ1 + z * (ERF_QQ2 + z * (ERF_QQ3 + z * (ERF_QQ4 + z * ERF_QQ5))))
      y = r / s
      temp = x + x * y
    }
    return -temp if sign
    return temp
  }
  if x < 1.25 { # 0.84375 <= |x| < 1.25
    s = x - 1.0
    p = ERF_PA0 + s * (ERF_PA1 + s * (ERF_PA2 + s * (ERF_PA3 + s * (ERF_PA4 + s * (ERF_PA5 + s * ERF_PA6)))))
    q = 1.0 + s * (ERF_QA1 + s * (ERF_QA2 + s * (ERF_QA3 + s * (ERF_QA4 + s * (ERF_QA5 + s * ERF_QA6)))))
    return -ERF_ERX - p / q if sign
    return ERF_ERX + p / q
  }
  if x >= 6.0 { # inf > |x| >= 6
    return -1.0 if sign
    return 1.0
  }
  r, s = erf_tail(x)
  z = float64frombits(float64bits(x) & 0xffffffff00000000) # pseudo-single (20-bit) precision x
  r = exp(-z * z - 0.5625) * exp((z - x) * (z + x) + r / s)
  return r / x - 1.0 if sign
  1.0 - r / x
}

# R and S of erf's and erfc's rational approximation for 1.25 <= x < 28.
def erf_tail(x: Float) -> (Float, Float) {
  s = 1.0 / (x * x)
  if x < ERF_INV035 { # |x| < 1 / 0.35  ~ 2.857143
    r = ERF_RA0 + s * (ERF_RA1 + s * (ERF_RA2 + s * (ERF_RA3 + s * (ERF_RA4 + s * (ERF_RA5 + s * (ERF_RA6 + s * ERF_RA7))))))
    q = 1.0 + s * (ERF_SA1 + s * (ERF_SA2 + s * (ERF_SA3 + s * (ERF_SA4 + s * (ERF_SA5 + s * (ERF_SA6 + s * (ERF_SA7 + s * ERF_SA8)))))))
    return (r, q)
  }
  # |x| >= 1 / 0.35  ~ 2.857143
  r = ERF_RB0 + s * (ERF_RB1 + s * (ERF_RB2 + s * (ERF_RB3 + s * (ERF_RB4 + s * (ERF_RB5 + s * ERF_RB6)))))
  q = 1.0 + s * (ERF_SB1 + s * (ERF_SB2 + s * (ERF_SB3 + s * (ERF_SB4 + s * (ERF_SB5 + s * (ERF_SB6 + s * ERF_SB7))))))
  (r, q)
}

# The complementary error function 1 - erf(x): erfc(+Inf) = 0, erfc(-Inf) = 2, erfc(NaN) = NaN.
pub def erfc(x: Float) -> Float {
  tiny = 1.3877787807814457e-17 # 2**-56
  return nan if is_nan(x)
  return 0.0 if is_inf(x, 1)
  return 2.0 if is_inf(x, -1)
  sign = false
  if x < 0.0 {
    x = -x
    sign = true
  }
  if x < 0.84375 { # |x| < 0.84375
    temp = 0.0
    if x < tiny { # |x| < 2**-56
      temp = x
    } else {
      z = x * x
      r = ERF_PP0 + z * (ERF_PP1 + z * (ERF_PP2 + z * (ERF_PP3 + z * ERF_PP4)))
      s = 1.0 + z * (ERF_QQ1 + z * (ERF_QQ2 + z * (ERF_QQ3 + z * (ERF_QQ4 + z * ERF_QQ5))))
      y = r / s
      if x < 0.25 { # |x| < 1/4
        temp = x + x * y
      } else {
        temp = 0.5 + (x * y + (x - 0.5))
      }
    }
    return 1.0 + temp if sign
    return 1.0 - temp
  }
  if x < 1.25 { # 0.84375 <= |x| < 1.25
    s = x - 1.0
    p = ERF_PA0 + s * (ERF_PA1 + s * (ERF_PA2 + s * (ERF_PA3 + s * (ERF_PA4 + s * (ERF_PA5 + s * ERF_PA6)))))
    q = 1.0 + s * (ERF_QA1 + s * (ERF_QA2 + s * (ERF_QA3 + s * (ERF_QA4 + s * (ERF_QA5 + s * ERF_QA6)))))
    return 1.0 + ERF_ERX + p / q if sign
    return 1.0 - ERF_ERX - p / q
  }
  if x < 28.0 {                   # |x| < 28
    return 2.0 if sign && x > 6.0 # x < -6
    r, s = erf_tail(x)
    z = float64frombits(float64bits(x) & 0xffffffff00000000) # pseudo-single (20-bit) precision x
    r = exp(-z * z - 0.5625) * exp((z - x) * (z + x) + r / s)
    return 2.0 - r / x if sign
    return r / x
  }
  return 2.0 if sign
  0.0
}

# ---- inverse error function ----

# The inverse of erf: erfinv(1) = +Inf, erfinv(-1) = -Inf, NaN outside [-1, 1].
pub def erfinv(x: Float) -> Float {
  # Coefficients for approximation to erf in |x| <= 0.85
  a0 = 1.1975323115670912564578e0
  a1 = 4.7072688112383978012285e1
  a2 = 6.9706266534389598238465e2
  a3 = 4.8548868893843886794648e3
  a4 = 1.6235862515167575384252e4
  a5 = 2.3782041382114385731252e4
  a6 = 1.1819493347062294404278e4
  a7 = 8.8709406962545514830200e2
  b0 = 1.0000000000000000000e0
  b1 = 4.2313330701600911252e1
  b2 = 6.8718700749205790830e2
  b3 = 5.3941960214247511077e3
  b4 = 2.1213794301586595867e4
  b5 = 3.9307895800092710610e4
  b6 = 2.8729085735721942674e4
  b7 = 5.2264952788528545610e3
  # Coefficients for approximation to erf in 0.85 < |x| <= 1-2*exp(-25)
  c0 = 1.42343711074968357734e0
  c1 = 4.63033784615654529590e0
  c2 = 5.76949722146069140550e0
  c3 = 3.64784832476320460504e0
  c4 = 1.27045825245236838258e0
  c5 = 2.41780725177450611770e-1
  c6 = 2.27238449892691845833e-2
  c7 = 7.74545014278341407640e-4
  d0 = 1.4142135623730950488016887e0
  d1 = 2.9036514445419946173133295e0
  d2 = 2.3707661626024532365971225e0
  d3 = 9.7547832001787427186894837e-1
  d4 = 2.0945065210512749128288442e-1
  d5 = 2.1494160384252876777097297e-2
  d6 = 7.7441459065157709165577218e-4
  d7 = 1.4859850019840355905497876e-9
  # Coefficients for approximation to erf in 1-2*exp(-25) < |x| < 1
  e0 = 6.65790464350110377720e0
  e1 = 5.46378491116411436990e0
  e2 = 1.78482653991729133580e0
  e3 = 2.96560571828504891230e-1
  e4 = 2.65321895265761230930e-2
  e5 = 1.24266094738807843860e-3
  e6 = 2.71155556874348757815e-5
  e7 = 2.01033439929228813265e-7
  f0 = 1.414213562373095048801689e0
  f1 = 8.482908416595164588112026e-1
  f2 = 1.936480946950659106176712e-1
  f3 = 2.103693768272068968719679e-2
  f4 = 1.112800997078859844711555e-3
  f5 = 2.611088405080593625138020e-5
  f6 = 2.010321207683943062279931e-7
  f7 = 2.891024605872965461538222e-15
  if is_nan(x) || x <= -1.0 || x >= 1.0 {
    return inf(x.to_i) if x == -1.0 || x == 1.0
    return nan
  }
  sign = false
  if x < 0.0 {
    x = -x
    sign = true
  }
  ans = 0.0
  if x <= 0.85 { # |x| <= 0.85
    r = 0.180625 - 0.25 * x * x
    z1 = ((((((a7 * r + a6) * r + a5) * r + a4) * r + a3) * r + a2) * r + a1) * r + a0
    z2 = ((((((b7 * r + b6) * r + b5) * r + b4) * r + b3) * r + b2) * r + b1) * r + b0
    ans = (x * z1) / z2
  } else {
    z1 = 0.0
    z2 = 0.0
    r = (LN2 - log(1.0 - x)).sqrt
    if r <= 5.0 {
      r -= 1.6
      z1 = ((((((c7 * r + c6) * r + c5) * r + c4) * r + c3) * r + c2) * r + c1) * r + c0
      z2 = ((((((d7 * r + d6) * r + d5) * r + d4) * r + d3) * r + d2) * r + d1) * r + d0
    } else {
      r -= 5.0
      z1 = ((((((e7 * r + e6) * r + e5) * r + e4) * r + e3) * r + e2) * r + e1) * r + e0
      z2 = ((((((f7 * r + f6) * r + f5) * r + f4) * r + f3) * r + f2) * r + f1) * r + f0
    }
    ans = z1 / z2
  }
  return -ans if sign
  ans
}

# The inverse of erfc: erfcinv(0) = +Inf, erfcinv(2) = -Inf, NaN outside [0, 2].
pub def erfcinv(x: Float) -> Float { erfinv(1.0 - x) }

