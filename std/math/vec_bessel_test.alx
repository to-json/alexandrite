  assert bq_ok(j0(bq_fb(0x3FF0000000000000)), 0x3FE87C7FDBD7B8F0), "j0(1)"
  assert bq_ok(j0(bq_fb(0x3FF0000000000001)), 0x3FE87C7FDBD7B8EE), "j0(1.0000000000000002)"
