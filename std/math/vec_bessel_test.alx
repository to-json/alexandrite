# Generated from Go's math (go1.27.1, GOOS=js GOARCH=wasm: the portable
# implementations, no FMA); do not edit by hand.

BQ_NAN_BITS: U64 = 0x7FF8000000000001

def bq_fb(b: U64) -> Float { float64frombits(b) }

# Bit-exact; any NaN matches a NaN.
def bq_ok(got: Float, want: U64) -> Bool {
  return is_nan(got) if want == BQ_NAN_BITS
  float64bits(got) == want
}

test "j0 1" {
  assert bq_ok(j0(bq_fb(0x0000000000000000)), 0x3FF0000000000000), "j0(0)"
  assert bq_ok(j0(bq_fb(0x8000000000000000)), 0x3FF0000000000000), "j0(-0)"
  assert bq_ok(j0(bq_fb(0x7FF0000000000000)), 0x0000000000000000), "j0(+Inf)"
  assert bq_ok(j0(bq_fb(0xFFF0000000000000)), 0x0000000000000000), "j0(-Inf)"
  assert bq_ok(j0(bq_fb(0x7FF8000000000001)), BQ_NAN_BITS), "j0(NaN)"
  assert bq_ok(j0(bq_fb(0x0000000000000001)), 0x3FF0000000000000), "j0(5e-324)"
  assert bq_ok(j0(bq_fb(0x000012688B70E62B)), 0x3FF0000000000000), "j0(1e-310)"
  assert bq_ok(j0(bq_fb(0x01A56E1FC2F8F359)), 0x3FF0000000000000), "j0(1e-300)"
  assert bq_ok(j0(bq_fb(0x3BC79CA10C924223)), 0x3FF0000000000000), "j0(1e-20)"
  assert bq_ok(j0(bq_fb(0x3C90000000000000)), 0x3FF0000000000000), "j0(5.551115123125783e-17)"
  assert bq_ok(j0(bq_fb(0x3C8FFFFFFFFFFFFF)), 0x3FF0000000000000), "j0(5.551115123125782e-17)"
  assert bq_ok(j0(bq_fb(0x3DDB7CDFD9D7BDBB)), 0x3FF0000000000000), "j0(1e-10)"
