  assert bq_ok(j0(bq_fb(0x3F50624DD2F1A9FC)), 0x3FEFFFFF79C84387), "j0(0.001)"
  assert bq_ok(j0(bq_fb(0x3FB999999999999A)), 0x3FEFEB8865590AB3), "j0(0.1)"
