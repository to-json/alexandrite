  assert bq_ok(jn(-3, bq_fb(0x4000000000000000)), 0xBFC081365FC429D1), "jn(-3, 2)"
  assert bq_ok(jn(-3, bq_fb(0xC000000000000000)), 0x3FC081365FC429D1), "jn(-3, -2)"
