test "y0 7" {
  assert bq_ok(y0(bq_fb(0x0000000000000000)), 0xFFF0000000000000), "y0(0)"
  assert bq_ok(y0(bq_fb(0x8000000000000000)), 0xFFF0000000000000), "y0(-0)"
  assert bq_ok(y0(bq_fb(0x7FF0000000000000)), 0x0000000000000000), "y0(+Inf)"
  assert bq_ok(y0(bq_fb(0xFFF0000000000000)), BQ_NAN_BITS), "y0(-Inf)"
  assert bq_ok(y0(bq_fb(0x7FF8000000000001)), BQ_NAN_BITS), "y0(NaN)"
  assert bq_ok(y0(bq_fb(0x0000000000000001)), 0xC07D9FFC3469E1B3), "y0(5e-324)"
  assert bq_ok(y0(bq_fb(0x000012688B70E62B)), 0xC07C67E6EA19FD00), "y0(1e-310)"
  assert bq_ok(y0(bq_fb(0x01A56E1FC2F8F359)), 0xC07B7D5CD487E960), "y0(1e-300)"
  assert bq_ok(y0(bq_fb(0x3BC79CA10C924223)), 0xC03D642788DC3FB2), "y0(1e-20)"
  assert bq_ok(y0(bq_fb(0x3C90000000000000)), 0xC037E706E7AC9AE4), "y0(5.551115123125783e-17)"
  assert bq_ok(y0(bq_fb(0x3C8FFFFFFFFFFFFF)), 0xC037E706E7AC9AE4), "y0(5.551115123125782e-17)"
  assert bq_ok(y0(bq_fb(0x3DDB7CDFD9D7BDBB)), 0xC02D770C5F760B82), "y0(1e-10)"
  assert bq_ok(y0(bq_fb(0x3E20000000000000)), 0xC029BDC8573E501E), "y0(1.862645149230957e-09)"
  assert bq_ok(y0(bq_fb(0x3E1FFFFFFFFFFFFF)), 0xC029BDC8573E501E), "y0(1.8626451492309568e-09)"
  assert bq_ok(y0(bq_fb(0x3E40000000000000)), 0xC027F9EBBE4666B4), "y0(7.450580596923828e-09)"
  assert bq_ok(y0(bq_fb(0x3E3FFFFFFFFFFFFF)), 0xC027F9EBBE4666B4), "y0(7.450580596923827e-09)"
  assert bq_ok(y0(bq_fb(0x3E40000000000001)), 0xC027F9EBBE4666B4), "y0(7.45058059692383e-09)"
  assert bq_ok(y0(bq_fb(0x3EE4F8B588E368F1)), 0xC01D9CD60CA62F27), "y0(1e-05)"
  assert bq_ok(y0(bq_fb(0x3F20000000000000)), 0xC0173DC71D616ECC), "y0(0.0001220703125)"
  assert bq_ok(y0(bq_fb(0x3F1FFFFFFFFFFFFF)), 0xC0173DC71D616ECC), "y0(0.00012207031249999999)"
  assert bq_ok(y0(bq_fb(0x3F50624DD2F1A9FC)), 0xC011E2BB09429A5A), "y0(0.001)"
  assert bq_ok(y0(bq_fb(0x3FB999999999999A)), 0xBFF88C3DD3FCF18C), "y0(0.1)"
  assert bq_ok(y0(bq_fb(0x3FE0000000000000)), 0xBFDC72FEB3B7B8A2), "y0(0.5)"
  assert bq_ok(y0(bq_fb(0x3FE8000000000000)), 0xBFC18EE09734F23D), "y0(0.75)"
  assert bq_ok(y0(bq_fb(0x3FEFFFFFFFFFFFFF)), 0x3FB6980226F358DA), "y0(0.9999999999999999)"
  assert bq_ok(y0(bq_fb(0x3FF0000000000000)), 0x3FB6980226F358E0), "y0(1)"
  assert bq_ok(y0(bq_fb(0x3FF0000000000001)), 0x3FB6980226F358ED), "y0(1.0000000000000002)"
  assert bq_ok(y0(bq_fb(0x3FF8000000000000)), 0x3FD87A0B0D068369), "y0(1.5)"
  assert bq_ok(y0(bq_fb(0x3FFFFFFFFFFFFFFF)), 0x3FE054FF5CD68C8D), "y0(1.9999999999999998)"
  assert bq_ok(y0(bq_fb(0x4000000000000000)), 0x3FE054FF5CD68C8D), "y0(2)"
  assert bq_ok(y0(bq_fb(0x4000000000000001)), 0x3FE054FF5CD68C8F), "y0(2.0000000000000004)"
