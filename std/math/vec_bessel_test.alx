test "y1 9" {
  assert bq_ok(y1(bq_fb(0x0000000000000000)), 0xFFF0000000000000), "y1(0)"
  assert bq_ok(y1(bq_fb(0x8000000000000000)), 0xFFF0000000000000), "y1(-0)"
  assert bq_ok(y1(bq_fb(0x7FF0000000000000)), 0x0000000000000000), "y1(+Inf)"
  assert bq_ok(y1(bq_fb(0xFFF0000000000000)), BQ_NAN_BITS), "y1(-Inf)"
  assert bq_ok(y1(bq_fb(0x7FF8000000000001)), BQ_NAN_BITS), "y1(NaN)"
  assert bq_ok(y1(bq_fb(0x0000000000000001)), 0xFFF0000000000000), "y1(5e-324)"
