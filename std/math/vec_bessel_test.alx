test "jn 11" {
  assert bq_ok(jn(-3, bq_fb(0x0000000000000000)), 0x0000000000000000), "jn(-3, 0)"
  assert bq_ok(jn(-3, bq_fb(0x8000000000000000)), 0x0000000000000000), "jn(-3, -0)"
  assert bq_ok(jn(-3, bq_fb(0x7FF0000000000000)), 0x0000000000000000), "jn(-3, +Inf)"
  assert bq_ok(jn(-3, bq_fb(0xFFF0000000000000)), 0x0000000000000000), "jn(-3, -Inf)"
  assert bq_ok(jn(-3, bq_fb(0x7FF8000000000001)), BQ_NAN_BITS), "jn(-3, NaN)"
  assert bq_ok(jn(-3, bq_fb(0x000012688B70E62B)), 0x8000000000000000), "jn(-3, 1e-310)"
  assert bq_ok(jn(-3, bq_fb(0x3BC79CA10C924223)), 0xB32124031C73196E), "jn(-3, 1e-20)"
  assert bq_ok(jn(-3, bq_fb(0x3E112E0BE826D695)), 0xB9FA68CD9E985017), "jn(-3, 1e-09)"
  assert bq_ok(jn(-3, bq_fb(0x3FB999999999999A)), 0xBEF5D4E93442DB3C), "jn(-3, 0.1)"
  assert bq_ok(jn(-3, bq_fb(0x3FF0000000000000)), 0xBF94086A7638F7A3), "jn(-3, 1)"
  assert bq_ok(jn(-3, bq_fb(0xBFF0000000000000)), 0x3F94086A7638F7A3), "jn(-3, -1)"
  assert bq_ok(jn(-3, bq_fb(0x3FF8000000000000)), 0xBFAF36AAC0C5B3B2), "jn(-3, 1.5)"
