# Generated from Go's math (go1.27.1, GOOS=js GOARCH=wasm: the portable
# implementations, no FMA); do not edit by hand.

NAN_BITS: U64 = 0x7FF8000000000001

def fb(b: U64) -> Float { float64frombits(b) }

# Bit-exact; any NaN matches a NaN.
def ok(got: Float, want: U64) -> Bool {
  return is_nan(got) if want == NAN_BITS
  float64bits(got) == want
}

test "exp 1" {
  assert ok(exp(fb(0x0000000000000000)), 0x3FF0000000000000), "exp(0)"
  assert ok(exp(fb(0x8000000000000000)), 0x3FF0000000000000), "exp(-0)"
  assert ok(exp(fb(0x7FF0000000000000)), 0x7FF0000000000000), "exp(+Inf)"
  assert ok(exp(fb(0xFFF0000000000000)), 0x0000000000000000), "exp(-Inf)"
  assert ok(exp(fb(0x7FF8000000000001)), NAN_BITS), "exp(NaN)"
  assert ok(exp(fb(0x3FF0000000000000)), 0x4005BF0A8B145769), "exp(1)"
  assert ok(exp(fb(0xBFF0000000000000)), 0x3FD78B56362CEF38), "exp(-1)"
  assert ok(exp(fb(0x3FE0000000000000)), 0x3FFA61298E1E069C), "exp(0.5)"
  assert ok(exp(fb(0xBFE0000000000000)), 0x3FE368B2FC6F960A), "exp(-0.5)"
  assert ok(exp(fb(0x4000000000000000)), 0x401D8E64B8D4DDAE), "exp(2)"
  assert ok(exp(fb(0xC000000000000000)), 0x3FC152AAA3BF81CC), "exp(-2)"
  assert ok(exp(fb(0x3FB999999999999A)), 0x3FF1AEC7B35A00D4), "exp(0.1)"
  assert ok(exp(fb(0xBFB999999999999A)), 0x3FECF46D99D52B3A), "exp(-0.1)"
  assert ok(exp(fb(0x3FE6666666666666)), 0x40001C2A61268987), "exp(0.7)"
  assert ok(exp(fb(0x3FE51EB851EB851F)), 0x3FFEF4E8CE8CEE7A), "exp(0.66)"
  assert ok(exp(fb(0x3FE4000000000000)), 0x3FFDE455DF80E3C0), "exp(0.625)"
  assert ok(exp(fb(0x01A56E1FC2F8F359)), 0x3FF0000000000000), "exp(1e-300)"
  assert ok(exp(fb(0x81A56E1FC2F8F359)), 0x3FF0000000000000), "exp(-1e-300)"
  assert ok(exp(fb(0x0000000000000001)), 0x3FF0000000000000), "exp(5e-324)"
  assert ok(exp(fb(0x8000000000000001)), 0x3FF0000000000000), "exp(-5e-324)"
  assert ok(exp(fb(0x0010000000000000)), 0x3FF0000000000000), "exp(2.2250738585072014e-308)"
  assert ok(exp(fb(0x3BC79CA10C924223)), 0x3FF0000000000000), "exp(1e-20)"
