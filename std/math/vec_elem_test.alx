test "asinh 33" {
  assert ok(asinh(fb(0x0000000000000000)), 0x0000000000000000), "asinh(0)"
  assert ok(asinh(fb(0x8000000000000000)), 0x8000000000000000), "asinh(-0)"
  assert ok(asinh(fb(0x7FF0000000000000)), 0x7FF0000000000000), "asinh(+Inf)"
  assert ok(asinh(fb(0xFFF0000000000000)), 0xFFF0000000000000), "asinh(-Inf)"
  assert ok(asinh(fb(0x7FF8000000000001)), NAN_BITS), "asinh(NaN)"
  assert ok(asinh(fb(0x3FF0000000000000)), 0x3FEC34366179D427), "asinh(1)"
  assert ok(asinh(fb(0xBFF0000000000000)), 0xBFEC34366179D427), "asinh(-1)"
  assert ok(asinh(fb(0x3FE0000000000000)), 0x3FDECC2CAEC5160A), "asinh(0.5)"
  assert ok(asinh(fb(0xBFE0000000000000)), 0xBFDECC2CAEC5160A), "asinh(-0.5)"
  assert ok(asinh(fb(0x4000000000000000)), 0x3FF719218313D087), "asinh(2)"
  assert ok(asinh(fb(0xC000000000000000)), 0xBFF719218313D087), "asinh(-2)"
  assert ok(asinh(fb(0x3FB999999999999A)), 0x3FB98EB9E7E5FC3F), "asinh(0.1)"
  assert ok(asinh(fb(0xBFB999999999999A)), 0xBFB98EB9E7E5FC3F), "asinh(-0.1)"
