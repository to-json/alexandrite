test "log 7" {
  assert ok(log(fb(0x0000000000000000)), 0xFFF0000000000000), "log(0)"
  assert ok(log(fb(0x8000000000000000)), 0xFFF0000000000000), "log(-0)"
  assert ok(log(fb(0x7FF0000000000000)), 0x7FF0000000000000), "log(+Inf)"
  assert ok(log(fb(0xFFF0000000000000)), NAN_BITS), "log(-Inf)"
  assert ok(log(fb(0x7FF8000000000001)), NAN_BITS), "log(NaN)"
  assert ok(log(fb(0x3FF0000000000000)), 0x0000000000000000), "log(1)"
  assert ok(log(fb(0xBFF0000000000000)), NAN_BITS), "log(-1)"
  assert ok(log(fb(0x3FE0000000000000)), 0xBFE62E42FEFA39EF), "log(0.5)"
  assert ok(log(fb(0xBFE0000000000000)), NAN_BITS), "log(-0.5)"
  assert ok(log(fb(0x4000000000000000)), 0x3FE62E42FEFA39EF), "log(2)"
  assert ok(log(fb(0xC000000000000000)), NAN_BITS), "log(-2)"
  assert ok(log(fb(0x3FB999999999999A)), 0xC0026BB1BBB55515), "log(0.1)"
  assert ok(log(fb(0xBFB999999999999A)), NAN_BITS), "log(-0.1)"
  assert ok(log(fb(0x3FE6666666666666)), 0xBFD6D3C324E13F50), "log(0.7)"
  assert ok(log(fb(0x3FE51EB851EB851F)), 0xBFDA97CE16B316F1), "log(0.66)"
  assert ok(log(fb(0x3FE4000000000000)), 0xBFDE148A1A2726CE), "log(0.625)"
  assert ok(log(fb(0x01A56E1FC2F8F359)), 0xC085963447F87FB5), "log(1e-300)"
  assert ok(log(fb(0x81A56E1FC2F8F359)), NAN_BITS), "log(-1e-300)"
  assert ok(log(fb(0x0000000000000001)), 0xC0874385446D71C3), "log(5e-324)"
  assert ok(log(fb(0x8000000000000001)), NAN_BITS), "log(-5e-324)"
  assert ok(log(fb(0x0010000000000000)), 0xC086232BDD7ABCD2), "log(2.2250738585072014e-308)"
  assert ok(log(fb(0x3BC79CA10C924223)), 0xC047069E2AA2AA5B), "log(1e-20)"
  assert ok(log(fb(0x3E2FC862D3E17360)), 0xC0336A390CDB5163), "log(3.7e-09)"
  assert ok(log(fb(0x3E45798EE2308C3A)), 0xC0326BB1BBB55516), "log(1e-08)"
  assert ok(log(fb(0x3CD203AF9EE75616)), 0xC04144F69FF9FFC4), "log(1e-15)"
  assert ok(log(fb(0x4035000000000000)), 0x40085B2E946FAEB1), "log(21)"
  assert ok(log(fb(0x4035800000000000)), 0x40088B5F56565D95), "log(21.5)"
  assert ok(log(fb(0x4036000000000000)), 0x4008BA74773DC5C8), "log(22)"
  assert ok(log(fb(0x3FD0000000000000)), 0xBFF62E42FEFA39EF), "log(0.25)"
  assert ok(log(fb(0x3FE8000000000000)), 0xBFD269621134DB92), "log(0.75)"
  assert ok(log(fb(0x3FF8000000000000)), 0x3FD9F323ECBF984C), "log(1.5)"
  assert ok(log(fb(0x4008000000000000)), 0x3FF193EA7AAD030A), "log(3)"
  assert ok(log(fb(0x4024000000000000)), 0x40026BB1BBB55516), "log(10)"
  assert ok(log(fb(0x4059000000000000)), 0x40126BB1BBB55516), "log(100)"
  assert ok(log(fb(0x4086280000000000)), 0x401A416357D87F55), "log(709)"
  assert ok(log(fb(0x40862E3D70A3D70A)), 0x401A4283947AD848), "log(709.78)"
  assert ok(log(fb(0x40862E51EB851EB8)), 0x401A428745F620CE), "log(709.79)"
  assert ok(log(fb(0x4086300000000000)), 0x401A42D4D1FF8154), "log(710)"
  assert ok(log(fb(0xC087480000000000)), NAN_BITS), "log(-745)"
  assert ok(log(fb(0xC08749999999999A)), NAN_BITS), "log(-745.2)"
  assert ok(log(fb(0xC087500000000000)), NAN_BITS), "log(-746)"
  assert ok(log(fb(0x408FFF3333333333)), 0x401BB9BA24CD41EF), "log(1023.9)"
  assert ok(log(fb(0x4090000000000000)), 0x401BB9D3BEB8C86B), "log(1024)"
  assert ok(log(fb(0xC090C80000000000)), NAN_BITS), "log(-1074)"
  assert ok(log(fb(0xC090CC0000000000)), NAN_BITS), "log(-1075)"
  assert ok(log(fb(0x41B0000000000000)), 0x4033687A9F1AF2B1), "log(2.68435456e+08)"
  assert ok(log(fb(0x41B0000001000000)), 0x4033687A9F2AF2B1), "log(2.68435457e+08)"
  assert ok(log(fb(0x41C0000000000000)), 0x403419ECB712C481), "log(5.36870912e+08)"
  assert ok(log(fb(0x41C0000001800000)), 0x403419ECB72AC481), "log(5.36870915e+08)"
  assert ok(log(fb(0x41D0000000000000)), 0x4034CB5ECF0A9650), "log(1.073741824e+09)"
  assert ok(log(fb(0x4202A05F20000000)), 0x4037069E2AA2AA5B), "log(1e+10)"
