  assert ok(atan2(fb(0x0000000000000000), fb(0xC000000000000000)), 0x400921FB54442D18), "atan2(0, -2)"
  assert ok(atan2(fb(0x0000000000000000), fb(0x4008000000000000)), 0x0000000000000000), "atan2(0, 3)"
