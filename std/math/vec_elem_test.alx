test "sincos 39" {
  assert ok(sincos(fb(0x0000000000000000))[0], 0x0000000000000000) && ok(sincos(fb(0x0000000000000000))[1], 0x3FF0000000000000), "sincos(0)"
  assert ok(sincos(fb(0x8000000000000000))[0], 0x8000000000000000) && ok(sincos(fb(0x8000000000000000))[1], 0x3FF0000000000000), "sincos(-0)"
  assert ok(sincos(fb(0x7FF0000000000000))[0], NAN_BITS) && ok(sincos(fb(0x7FF0000000000000))[1], NAN_BITS), "sincos(+Inf)"
  assert ok(sincos(fb(0xFFF0000000000000))[0], NAN_BITS) && ok(sincos(fb(0xFFF0000000000000))[1], NAN_BITS), "sincos(-Inf)"
  assert ok(sincos(fb(0x7FF8000000000001))[0], NAN_BITS) && ok(sincos(fb(0x7FF8000000000001))[1], NAN_BITS), "sincos(NaN)"
