test "asin 21" {
  assert ok(asin(fb(0x0000000000000000)), 0x0000000000000000), "asin(0)"
  assert ok(asin(fb(0x8000000000000000)), 0x8000000000000000), "asin(-0)"
  assert ok(asin(fb(0x7FF0000000000000)), NAN_BITS), "asin(+Inf)"
  assert ok(asin(fb(0xFFF0000000000000)), NAN_BITS), "asin(-Inf)"
