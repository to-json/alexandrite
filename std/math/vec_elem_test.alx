test "tanh 31" {
  assert ok(tanh(fb(0x0000000000000000)), 0x0000000000000000), "tanh(0)"
  assert ok(tanh(fb(0x8000000000000000)), 0x8000000000000000), "tanh(-0)"
  assert ok(tanh(fb(0x7FF0000000000000)), 0x3FF0000000000000), "tanh(+Inf)"
  assert ok(tanh(fb(0xFFF0000000000000)), 0xBFF0000000000000), "tanh(-Inf)"
  assert ok(tanh(fb(0x7FF8000000000001)), NAN_BITS), "tanh(NaN)"
  assert ok(tanh(fb(0x3FF0000000000000)), 0x3FE85EFAB514F394), "tanh(1)"
  assert ok(tanh(fb(0xBFF0000000000000)), 0xBFE85EFAB514F394), "tanh(-1)"
  assert ok(tanh(fb(0x3FE0000000000000)), 0x3FDD9353D7568AF3), "tanh(0.5)"
  assert ok(tanh(fb(0xBFE0000000000000)), 0xBFDD9353D7568AF3), "tanh(-0.5)"
  assert ok(tanh(fb(0x4000000000000000)), 0x3FEED9505E1BC3D4), "tanh(2)"
  assert ok(tanh(fb(0xC000000000000000)), 0xBFEED9505E1BC3D4), "tanh(-2)"
  assert ok(tanh(fb(0x3FB999999999999A)), 0x3FB983D7795F413A), "tanh(0.1)"
  assert ok(tanh(fb(0xBFB999999999999A)), 0xBFB983D7795F413A), "tanh(-0.1)"
  assert ok(tanh(fb(0x3FE6666666666666)), 0x3FE356FB17AF2E91), "tanh(0.7)"
