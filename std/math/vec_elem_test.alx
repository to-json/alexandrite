test "log10 11" {
  assert ok(log10(fb(0x0000000000000000)), 0xFFF0000000000000), "log10(0)"
  assert ok(log10(fb(0x8000000000000000)), 0xFFF0000000000000), "log10(-0)"
  assert ok(log10(fb(0x7FF0000000000000)), 0x7FF0000000000000), "log10(+Inf)"
  assert ok(log10(fb(0xFFF0000000000000)), NAN_BITS), "log10(-Inf)"
  assert ok(log10(fb(0x7FF8000000000001)), NAN_BITS), "log10(NaN)"
  assert ok(log10(fb(0x3FF0000000000000)), 0x0000000000000000), "log10(1)"
  assert ok(log10(fb(0xBFF0000000000000)), NAN_BITS), "log10(-1)"
  assert ok(log10(fb(0x3FE0000000000000)), 0xBFD34413509F79FF), "log10(0.5)"
  assert ok(log10(fb(0xBFE0000000000000)), NAN_BITS), "log10(-0.5)"
  assert ok(log10(fb(0x4000000000000000)), 0x3FD34413509F79FF), "log10(2)"
  assert ok(log10(fb(0xC000000000000000)), NAN_BITS), "log10(-2)"
  assert ok(log10(fb(0x3FB999999999999A)), 0xBFEFFFFFFFFFFFFF), "log10(0.1)"
  assert ok(log10(fb(0xBFB999999999999A)), NAN_BITS), "log10(-0.1)"
  assert ok(log10(fb(0x3FE6666666666666)), 0xBFC3D3D3D21CCF04), "log10(0.7)"
