test "pow 63" {
  assert ok(pow(fb(0xBFB999999999999A), fb(0x7FF8000000000001)), NAN_BITS), "pow(-0.1, NaN)"
  assert ok(pow(fb(0xBFB999999999999A), fb(0x3FF0000000000000)), 0xBFB999999999999A), "pow(-0.1, 1)"
  assert ok(pow(fb(0xBFB999999999999A), fb(0xBFF0000000000000)), 0xC024000000000000), "pow(-0.1, -1)"
