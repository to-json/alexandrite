test "acosh 35" {
  assert ok(acosh(fb(0x0000000000000000)), NAN_BITS), "acosh(0)"
  assert ok(acosh(fb(0x8000000000000000)), NAN_BITS), "acosh(-0)"
  assert ok(acosh(fb(0x7FF0000000000000)), 0x7FF0000000000000), "acosh(+Inf)"
  assert ok(acosh(fb(0xFFF0000000000000)), NAN_BITS), "acosh(-Inf)"
  assert ok(acosh(fb(0x7FF8000000000001)), NAN_BITS), "acosh(NaN)"
  assert ok(acosh(fb(0x3FF0000000000000)), 0x0000000000000000), "acosh(1)"
  assert ok(acosh(fb(0xBFF0000000000000)), NAN_BITS), "acosh(-1)"
  assert ok(acosh(fb(0x3FE0000000000000)), NAN_BITS), "acosh(0.5)"
  assert ok(acosh(fb(0xBFE0000000000000)), NAN_BITS), "acosh(-0.5)"
  assert ok(acosh(fb(0x4000000000000000)), 0x3FF5124271980434), "acosh(2)"
  assert ok(acosh(fb(0xC000000000000000)), NAN_BITS), "acosh(-2)"
  assert ok(acosh(fb(0x3FB999999999999A)), NAN_BITS), "acosh(0.1)"
  assert ok(acosh(fb(0xBFB999999999999A)), NAN_BITS), "acosh(-0.1)"
  assert ok(acosh(fb(0x3FE6666666666666)), NAN_BITS), "acosh(0.7)"
  assert ok(acosh(fb(0x3FE51EB851EB851F)), NAN_BITS), "acosh(0.66)"
  assert ok(acosh(fb(0x3FE4000000000000)), NAN_BITS), "acosh(0.625)"
  assert ok(acosh(fb(0x01A56E1FC2F8F359)), NAN_BITS), "acosh(1e-300)"
  assert ok(acosh(fb(0x81A56E1FC2F8F359)), NAN_BITS), "acosh(-1e-300)"
  assert ok(acosh(fb(0x0000000000000001)), NAN_BITS), "acosh(5e-324)"
  assert ok(acosh(fb(0x8000000000000001)), NAN_BITS), "acosh(-5e-324)"
  assert ok(acosh(fb(0x0010000000000000)), NAN_BITS), "acosh(2.2250738585072014e-308)"
  assert ok(acosh(fb(0x3BC79CA10C924223)), NAN_BITS), "acosh(1e-20)"
