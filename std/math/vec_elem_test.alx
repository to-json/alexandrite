test "atan2 44" {
  assert ok(atan2(fb(0x3FF0000000000000), fb(0x0000000000000000)), 0x3FF921FB54442D18), "atan2(1, 0)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0x8000000000000000)), 0x3FF921FB54442D18), "atan2(1, -0)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0x7FF0000000000000)), 0x0000000000000000), "atan2(1, +Inf)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0xFFF0000000000000)), 0x400921FB54442D18), "atan2(1, -Inf)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0x7FF8000000000001)), NAN_BITS), "atan2(1, NaN)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0x3FF0000000000000)), 0x3FE921FB54442D18), "atan2(1, 1)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0xBFF0000000000000)), 0x4002D97C7F3321D2), "atan2(1, -1)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0x3FE0000000000000)), 0x3FF1B6E192EBBE44), "atan2(1, 0.5)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0xBFE0000000000000)), 0x4000468A8ACE4DF6), "atan2(1, -0.5)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0x4000000000000000)), 0x3FDDAC670561BB4F), "atan2(1, 2)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0xC000000000000000)), 0x40056C6E7397F5AE), "atan2(1, -2)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0x4008000000000000)), 0x3FD4978FA3269EE1), "atan2(1, 3)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0xC008000000000000)), 0x40068F095FDF593C), "atan2(1, -3)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0x3FB999999999999A)), 0x3FF789BD2C160053), "atan2(1, 0.1)"
  assert ok(atan2(fb(0x3FF0000000000000), fb(0x3DDB7CDFD9D7BDBB)), 0x3FF921FB543D4DE0), "atan2(1, 1e-10)"
