test "exp2 3" {
  assert ok(exp2(fb(0x0000000000000000)), 0x3FF0000000000000), "exp2(0)"
  assert ok(exp2(fb(0x8000000000000000)), 0x3FF0000000000000), "exp2(-0)"
  assert ok(exp2(fb(0x7FF0000000000000)), 0x7FF0000000000000), "exp2(+Inf)"
  assert ok(exp2(fb(0xFFF0000000000000)), 0x0000000000000000), "exp2(-Inf)"
  assert ok(exp2(fb(0x7FF8000000000001)), NAN_BITS), "exp2(NaN)"
  assert ok(exp2(fb(0x3FF0000000000000)), 0x4000000000000000), "exp2(1)"
  assert ok(exp2(fb(0xBFF0000000000000)), 0x3FE0000000000000), "exp2(-1)"
  assert ok(exp2(fb(0x3FE0000000000000)), 0x3FF6A09E667F3BCC), "exp2(0.5)"
  assert ok(exp2(fb(0xBFE0000000000000)), 0x3FE6A09E667F3BCC), "exp2(-0.5)"
  assert ok(exp2(fb(0x4000000000000000)), 0x4010000000000000), "exp2(2)"
  assert ok(exp2(fb(0xC000000000000000)), 0x3FD0000000000000), "exp2(-2)"
  assert ok(exp2(fb(0x3FB999999999999A)), 0x3FF125FBEE250664), "exp2(0.1)"
  assert ok(exp2(fb(0xBFB999999999999A)), 0x3FEDDB680117AB12), "exp2(-0.1)"
  assert ok(exp2(fb(0x3FE6666666666666)), 0x3FF9FDF8BCCE533D), "exp2(0.7)"
  assert ok(exp2(fb(0x3FE51EB851EB851F)), 0x3FF94804B79E2606), "exp2(0.66)"
  assert ok(exp2(fb(0x3FE4000000000000)), 0x3FF8ACE5422AA0DC), "exp2(0.625)"
  assert ok(exp2(fb(0x01A56E1FC2F8F359)), 0x3FF0000000000000), "exp2(1e-300)"
  assert ok(exp2(fb(0x81A56E1FC2F8F359)), 0x3FF0000000000000), "exp2(-1e-300)"
  assert ok(exp2(fb(0x0000000000000001)), 0x3FF0000000000000), "exp2(5e-324)"
  assert ok(exp2(fb(0x8000000000000001)), 0x3FF0000000000000), "exp2(-5e-324)"
  assert ok(exp2(fb(0x0010000000000000)), 0x3FF0000000000000), "exp2(2.2250738585072014e-308)"
  assert ok(exp2(fb(0x3BC79CA10C924223)), 0x3FF0000000000000), "exp2(1e-20)"
  assert ok(exp2(fb(0x3E2FC862D3E17360)), 0x3FF0000000B03DB4), "exp2(3.7e-09)"
  assert ok(exp2(fb(0x3E45798EE2308C3A)), 0x3FF0000001DC53BE), "exp2(1e-08)"
  assert ok(exp2(fb(0x3CD203AF9EE75616)), 0x3FF0000000000003), "exp2(1e-15)"
