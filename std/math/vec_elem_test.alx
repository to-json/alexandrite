test "hypot 53" {
  assert ok(hypot(fb(0xC000000000000000), fb(0x0000000000000000)), 0x4000000000000000), "hypot(-2, 0)"
  assert ok(hypot(fb(0xC000000000000000), fb(0x8000000000000000)), 0x4000000000000000), "hypot(-2, -0)"
  assert ok(hypot(fb(0xC000000000000000), fb(0x7FF0000000000000)), 0x7FF0000000000000), "hypot(-2, +Inf)"
