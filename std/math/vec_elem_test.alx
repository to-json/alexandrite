test "sin 15" {
  assert ok(sin(fb(0x0000000000000000)), 0x0000000000000000), "sin(0)"
  assert ok(sin(fb(0x8000000000000000)), 0x8000000000000000), "sin(-0)"
  assert ok(sin(fb(0x7FF0000000000000)), NAN_BITS), "sin(+Inf)"
  assert ok(sin(fb(0xFFF0000000000000)), NAN_BITS), "sin(-Inf)"
  assert ok(sin(fb(0x7FF8000000000001)), NAN_BITS), "sin(NaN)"
  assert ok(sin(fb(0x3FF0000000000000)), 0x3FEAED548F090CEE), "sin(1)"
  assert ok(sin(fb(0xBFF0000000000000)), 0xBFEAED548F090CEE), "sin(-1)"
  assert ok(sin(fb(0x3FE0000000000000)), 0x3FDEAEE8744B05F0), "sin(0.5)"
  assert ok(sin(fb(0xBFE0000000000000)), 0xBFDEAEE8744B05F0), "sin(-0.5)"
  assert ok(sin(fb(0x4000000000000000)), 0x3FED18F6EAD1B445), "sin(2)"
  assert ok(sin(fb(0xC000000000000000)), 0xBFED18F6EAD1B445), "sin(-2)"
  assert ok(sin(fb(0x3FB999999999999A)), 0x3FB98EAECB8BCB2C), "sin(0.1)"
  assert ok(sin(fb(0xBFB999999999999A)), 0xBFB98EAECB8BCB2C), "sin(-0.1)"
