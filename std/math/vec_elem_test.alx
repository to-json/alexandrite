test "expm1 5" {
  assert ok(expm1(fb(0x0000000000000000)), 0x0000000000000000), "expm1(0)"
  assert ok(expm1(fb(0x8000000000000000)), 0x8000000000000000), "expm1(-0)"
  assert ok(expm1(fb(0x7FF0000000000000)), 0x7FF0000000000000), "expm1(+Inf)"
  assert ok(expm1(fb(0xFFF0000000000000)), 0xBFF0000000000000), "expm1(-Inf)"
  assert ok(expm1(fb(0x7FF8000000000001)), NAN_BITS), "expm1(NaN)"
  assert ok(expm1(fb(0x3FF0000000000000)), 0x3FFB7E151628AED2), "expm1(1)"
  assert ok(expm1(fb(0xBFF0000000000000)), 0xBFE43A54E4E98864), "expm1(-1)"
  assert ok(expm1(fb(0x3FE0000000000000)), 0x3FE4C2531C3C0D38), "expm1(0.5)"
  assert ok(expm1(fb(0xBFE0000000000000)), 0xBFD92E9A0720D3EC), "expm1(-0.5)"
  assert ok(expm1(fb(0x4000000000000000)), 0x40198E64B8D4DDAE), "expm1(2)"
  assert ok(expm1(fb(0xC000000000000000)), 0xBFEBAB5557101F8D), "expm1(-2)"
  assert ok(expm1(fb(0x3FB999999999999A)), 0x3FBAEC7B35A00D3A), "expm1(0.1)"
  assert ok(expm1(fb(0xBFB999999999999A)), 0xBFB85C933156A62C), "expm1(-0.1)"
  assert ok(expm1(fb(0x3FE6666666666666)), 0x3FF03854C24D130D), "expm1(0.7)"
  assert ok(expm1(fb(0x3FE51EB851EB851F)), 0x3FEDE9D19D19DCF3), "expm1(0.66)"
  assert ok(expm1(fb(0x3FE4000000000000)), 0x3FEBC8ABBF01C781), "expm1(0.625)"
  assert ok(expm1(fb(0x01A56E1FC2F8F359)), 0x01A56E1FC2F8F359), "expm1(1e-300)"
  assert ok(expm1(fb(0x81A56E1FC2F8F359)), 0x81A56E1FC2F8F359), "expm1(-1e-300)"
  assert ok(expm1(fb(0x0000000000000001)), 0x0000000000000001), "expm1(5e-324)"
  assert ok(expm1(fb(0x8000000000000001)), 0x8000000000000001), "expm1(-5e-324)"
  assert ok(expm1(fb(0x0010000000000000)), 0x0010000000000000), "expm1(2.2250738585072014e-308)"
  assert ok(expm1(fb(0x3BC79CA10C924223)), 0x3BC79CA10C924223), "expm1(1e-20)"
  assert ok(expm1(fb(0x3E2FC862D3E17360)), 0x3E2FC862D4DDFC92), "expm1(3.7e-09)"
  assert ok(expm1(fb(0x3E45798EE2308C3A)), 0x3E45798EE3FDB764), "expm1(1e-08)"
  assert ok(expm1(fb(0x3CD203AF9EE75616)), 0x3CD203AF9EE75619), "expm1(1e-15)"
  assert ok(expm1(fb(0x4035000000000000)), 0x41D3A6E1FD5EECFD), "expm1(21)"
  assert ok(expm1(fb(0x4035800000000000)), 0x41E0334300127298), "expm1(21.5)"
  assert ok(expm1(fb(0x4036000000000000)), 0x41EAB5ADB9A43600), "expm1(22)"
  assert ok(expm1(fb(0x3FD0000000000000)), 0x3FD22D78F0FA061A), "expm1(0.25)"
  assert ok(expm1(fb(0x3FE8000000000000)), 0x3FF1DF3B68CFB9F0), "expm1(0.75)"
  assert ok(expm1(fb(0x3FF8000000000000)), 0x400BDA7FCC9F8A83), "expm1(1.5)"
  assert ok(expm1(fb(0x4008000000000000)), 0x403315E5BF6FB106), "expm1(3)"
  assert ok(expm1(fb(0x4024000000000000)), 0x40D5825DCF950560), "expm1(10)"
  assert ok(expm1(fb(0x4059000000000000)), 0x48F3494A9B171BF5), "expm1(100)"
  assert ok(expm1(fb(0x4086280000000000)), 0x7FDD422D2BE5DC9B), "expm1(709)"
  assert ok(expm1(fb(0x40862E3D70A3D70A)), 0x7FEFE9CE5C4C52B4), "expm1(709.78)"
  assert ok(expm1(fb(0x40862E51EB851EB8)), 0x7FF0000000000000), "expm1(709.79)"
  assert ok(expm1(fb(0x4086300000000000)), 0x7FF0000000000000), "expm1(710)"
  assert ok(expm1(fb(0xC087480000000000)), 0xBFF0000000000000), "expm1(-745)"
  assert ok(expm1(fb(0xC08749999999999A)), 0xBFF0000000000000), "expm1(-745.2)"
  assert ok(expm1(fb(0xC087500000000000)), 0xBFF0000000000000), "expm1(-746)"
