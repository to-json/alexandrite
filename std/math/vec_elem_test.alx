test "atanh 37" {
  assert ok(atanh(fb(0x0000000000000000)), 0x0000000000000000), "atanh(0)"
  assert ok(atanh(fb(0x8000000000000000)), 0x8000000000000000), "atanh(-0)"
  assert ok(atanh(fb(0x7FF0000000000000)), NAN_BITS), "atanh(+Inf)"
  assert ok(atanh(fb(0xFFF0000000000000)), NAN_BITS), "atanh(-Inf)"
  assert ok(atanh(fb(0x7FF8000000000001)), NAN_BITS), "atanh(NaN)"
  assert ok(atanh(fb(0x3FF0000000000000)), 0x7FF0000000000000), "atanh(1)"
  assert ok(atanh(fb(0xBFF0000000000000)), 0xFFF0000000000000), "atanh(-1)"
  assert ok(atanh(fb(0x3FE0000000000000)), 0x3FE193EA7AAD030A), "atanh(0.5)"
  assert ok(atanh(fb(0xBFE0000000000000)), 0xBFE193EA7AAD030A), "atanh(-0.5)"
  assert ok(atanh(fb(0x4000000000000000)), NAN_BITS), "atanh(2)"
  assert ok(atanh(fb(0xC000000000000000)), NAN_BITS), "atanh(-2)"
  assert ok(atanh(fb(0x3FB999999999999A)), 0x3FB9AF93CD234412), "atanh(0.1)"
  assert ok(atanh(fb(0xBFB999999999999A)), 0xBFB9AF93CD234412), "atanh(-0.1)"
