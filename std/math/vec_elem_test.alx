test "hypot 52" {
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x0000000000000000)), 0x3FF0000000000000), "hypot(1, 0)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x8000000000000000)), 0x3FF0000000000000), "hypot(1, -0)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x7FF0000000000000)), 0x7FF0000000000000), "hypot(1, +Inf)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0xFFF0000000000000)), 0x7FF0000000000000), "hypot(1, -Inf)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x7FF8000000000001)), NAN_BITS), "hypot(1, NaN)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x3FF0000000000000)), 0x3FF6A09E667F3BCD), "hypot(1, 1)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0xBFF0000000000000)), 0x3FF6A09E667F3BCD), "hypot(1, -1)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x3FE0000000000000)), 0x3FF1E3779B97F4A8), "hypot(1, 0.5)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0xBFE0000000000000)), 0x3FF1E3779B97F4A8), "hypot(1, -0.5)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x4000000000000000)), 0x4001E3779B97F4A8), "hypot(1, 2)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0xC000000000000000)), 0x4001E3779B97F4A8), "hypot(1, -2)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x4008000000000000)), 0x40094C583ADA5B53), "hypot(1, 3)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0xC008000000000000)), 0x40094C583ADA5B53), "hypot(1, -3)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x3FB999999999999A)), 0x3FF0146DD68287F3), "hypot(1, 0.1)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x3DDB7CDFD9D7BDBB)), 0x3FF0000000000000), "hypot(1, 1e-10)"
  assert ok(hypot(fb(0x3FF0000000000000), fb(0x4202A05F20000000)), 0x4202A05F20000000), "hypot(1, 1e+10)"
