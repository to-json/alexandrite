test "cosh 29" {
  assert ok(cosh(fb(0x0000000000000000)), 0x3FF0000000000000), "cosh(0)"
  assert ok(cosh(fb(0x8000000000000000)), 0x3FF0000000000000), "cosh(-0)"
  assert ok(cosh(fb(0x7FF0000000000000)), 0x7FF0000000000000), "cosh(+Inf)"
  assert ok(cosh(fb(0xFFF0000000000000)), 0x7FF0000000000000), "cosh(-Inf)"
  assert ok(cosh(fb(0x7FF8000000000001)), NAN_BITS), "cosh(NaN)"
  assert ok(cosh(fb(0x3FF0000000000000)), 0x3FF8B07551D9F550), "cosh(1)"
  assert ok(cosh(fb(0xBFF0000000000000)), 0x3FF8B07551D9F550), "cosh(-1)"
  assert ok(cosh(fb(0x3FE0000000000000)), 0x3FF20AC1862AE8D0), "cosh(0.5)"
  assert ok(cosh(fb(0xBFE0000000000000)), 0x3FF20AC1862AE8D0), "cosh(-0.5)"
  assert ok(cosh(fb(0x4000000000000000)), 0x400E18FA0DF2D9BC), "cosh(2)"
  assert ok(cosh(fb(0xC000000000000000)), 0x400E18FA0DF2D9BC), "cosh(-2)"
  assert ok(cosh(fb(0x3FB999999999999A)), 0x3FF0147F40224B38), "cosh(0.1)"
  assert ok(cosh(fb(0xBFB999999999999A)), 0x3FF0147F40224B38), "cosh(-0.1)"
  assert ok(cosh(fb(0x3FE6666666666666)), 0x3FF4152C1862342F), "cosh(0.7)"
  assert ok(cosh(fb(0x3FE51EB851EB851F)), 0x3FF39CF75B1AC091), "cosh(0.66)"
