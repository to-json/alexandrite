test "pow 72" {
  assert ok(pow(fb(0xC08749999999999A), fb(0x3FB999999999999A)), NAN_BITS), "pow(-745.2, 0.1)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x3DDB7CDFD9D7BDBB)), NAN_BITS), "pow(-745.2, 1e-10)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x4202A05F20000000)), 0x7FF0000000000000), "pow(-745.2, 1e+10)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x404A400000000000)), NAN_BITS), "pow(-745.2, 52.5)"
  assert ok(pow(fb(0xC08749999999999A), fb(0xC01C000000000000)), 0xBBC280861EE819B3), "pow(-745.2, -7)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x43E0000000000000)), 0x7FF0000000000000), "pow(-745.2, 9.223372036854776e+18)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x4340000000000000)), 0x7FF0000000000000), "pow(-745.2, 9.007199254740992e+15)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x4340000000000001)), 0x7FF0000000000000), "pow(-745.2, 9.007199254740994e+15)"
  assert ok(pow(fb(0xC08749999999999A), fb(0xC04AAF20AA88F154)), NAN_BITS), "pow(-745.2, -53.36818439184813)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x3F67B77C8F9FDB98)), NAN_BITS), "pow(-745.2, 0.002895110400455047)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x3FB2356650134BE0)), NAN_BITS), "pow(-745.2, 0.07112731413808104)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x3F69E54A9719792E)), NAN_BITS), "pow(-745.2, 0.003161092456863155)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x3FE5971B765E62C2)), NAN_BITS), "pow(-745.2, 0.674695712269646)"
  assert ok(pow(fb(0xC08749999999999A), fb(0xC063D7B8C49E9164)), NAN_BITS), "pow(-745.2, -158.7413046929388)"
  assert ok(pow(fb(0xC08749999999999A), fb(0xC075AB3EAFCE953A)), NAN_BITS), "pow(-745.2, -346.7028043813367)"
  assert ok(pow(fb(0xC08749999999999A), fb(0x4063F997186875AC)), NAN_BITS), "pow(-745.2, 159.79969425585057)"
  assert ok(pow(fb(0xC08749999999999A), fb(0xBF7D37FD94339404)), NAN_BITS), "pow(-745.2, -0.007133474867463189)"
  assert ok(pow(fb(0xC08749999999999A), fb(0xBF14F21EE2A50D00)), NAN_BITS), "pow(-745.2, -7.990182408428373e-05)"
  assert ok(pow(fb(0xC08749999999999A), fb(0xBFB7B6AFA9FC3070)), NAN_BITS), "pow(-745.2, -0.09263131999995422)"
  assert ok(pow(fb(0xC08749999999999A), fb(0xBFCE160B30E9FD0C)), NAN_BITS), "pow(-745.2, -0.2350477207982994)"
}
