test "log2 9" {
  assert ok(log2(fb(0x0000000000000000)), 0xFFF0000000000000), "log2(0)"
  assert ok(log2(fb(0x8000000000000000)), 0xFFF0000000000000), "log2(-0)"
  assert ok(log2(fb(0x7FF0000000000000)), 0x7FF0000000000000), "log2(+Inf)"
  assert ok(log2(fb(0xFFF0000000000000)), NAN_BITS), "log2(-Inf)"
  assert ok(log2(fb(0x7FF8000000000001)), NAN_BITS), "log2(NaN)"
  assert ok(log2(fb(0x3FF0000000000000)), 0x0000000000000000), "log2(1)"
  assert ok(log2(fb(0xBFF0000000000000)), NAN_BITS), "log2(-1)"
  assert ok(log2(fb(0x3FE0000000000000)), 0xBFF0000000000000), "log2(0.5)"
  assert ok(log2(fb(0xBFE0000000000000)), NAN_BITS), "log2(-0.5)"
  assert ok(log2(fb(0x4000000000000000)), 0x3FF0000000000000), "log2(2)"
  assert ok(log2(fb(0xC000000000000000)), NAN_BITS), "log2(-2)"
  assert ok(log2(fb(0x3FB999999999999A)), 0xC00A934F0979A371), "log2(0.1)"
  assert ok(log2(fb(0xBFB999999999999A)), NAN_BITS), "log2(-0.1)"
