test "pow 62" {
  assert ok(pow(fb(0x4000000000000000), fb(0xFFF0000000000000)), 0x0000000000000000), "pow(2, -Inf)"
  assert ok(pow(fb(0x4000000000000000), fb(0x7FF8000000000001)), NAN_BITS), "pow(2, NaN)"
  assert ok(pow(fb(0x4000000000000000), fb(0x3FF0000000000000)), 0x4000000000000000), "pow(2, 1)"
  assert ok(pow(fb(0x4000000000000000), fb(0xBFF0000000000000)), 0x3FE0000000000000), "pow(2, -1)"
  assert ok(pow(fb(0x4000000000000000), fb(0x3FE0000000000000)), 0x3FF6A09E667F3BCD), "pow(2, 0.5)"
  assert ok(pow(fb(0x4000000000000000), fb(0xBFE0000000000000)), 0x3FE6A09E667F3BCC), "pow(2, -0.5)"
  assert ok(pow(fb(0x4000000000000000), fb(0x4000000000000000)), 0x4010000000000000), "pow(2, 2)"
  assert ok(pow(fb(0x4000000000000000), fb(0xC000000000000000)), 0x3FD0000000000000), "pow(2, -2)"
  assert ok(pow(fb(0x4000000000000000), fb(0x4008000000000000)), 0x4020000000000000), "pow(2, 3)"
  assert ok(pow(fb(0x4000000000000000), fb(0xC008000000000000)), 0x3FC0000000000000), "pow(2, -3)"
  assert ok(pow(fb(0x4000000000000000), fb(0x3FB999999999999A)), 0x3FF125FBEE250664), "pow(2, 0.1)"
  assert ok(pow(fb(0x4000000000000000), fb(0x3DDB7CDFD9D7BDBB)), 0x3FF000000004C366), "pow(2, 1e-10)"
  assert ok(pow(fb(0x4000000000000000), fb(0x4202A05F20000000)), 0x7FF0000000000000), "pow(2, 1e+10)"
  assert ok(pow(fb(0x4000000000000000), fb(0x404A400000000000)), 0x4336A09E667F3BCC), "pow(2, 52.5)"
  assert ok(pow(fb(0x4000000000000000), fb(0xC01C000000000000)), 0x3F80000000000000), "pow(2, -7)"
  assert ok(pow(fb(0x4000000000000000), fb(0x43E0000000000000)), 0x7FF0000000000000), "pow(2, 9.223372036854776e+18)"
