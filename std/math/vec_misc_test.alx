test "float32bits 42" {
  assert math.float32bits(mv_fb(0x0000000000000000)) == 0x00000000, "float32bits(0)"
  assert math.float32bits(mv_fb(0x8000000000000000)) == 0x80000000, "float32bits(-0)"
  assert math.float32bits(mv_fb(0x7FF0000000000000)) == 0x7F800000, "float32bits(+Inf)"
  assert math.float32bits(mv_fb(0xFFF0000000000000)) == 0xFF800000, "float32bits(-Inf)"
  assert math.float32bits(mv_fb(0x7FF8000000000001)) == 0x7FC00000, "float32bits(NaN)"
  assert math.float32bits(mv_fb(0x3FF0000000000000)) == 0x3F800000, "float32bits(1)"
  assert math.float32bits(mv_fb(0xBFF0000000000000)) == 0xBF800000, "float32bits(-1)"
  assert math.float32bits(mv_fb(0x3FE0000000000000)) == 0x3F000000, "float32bits(0.5)"
  assert math.float32bits(mv_fb(0xBFE0000000000000)) == 0xBF000000, "float32bits(-0.5)"
  assert math.float32bits(mv_fb(0x3FF8000000000000)) == 0x3FC00000, "float32bits(1.5)"
  assert math.float32bits(mv_fb(0xBFF8000000000000)) == 0xBFC00000, "float32bits(-1.5)"
  assert math.float32bits(mv_fb(0x4004000000000000)) == 0x40200000, "float32bits(2.5)"
  assert math.float32bits(mv_fb(0xC004000000000000)) == 0xC0200000, "float32bits(-2.5)"
  assert math.float32bits(mv_fb(0x4008000000000000)) == 0x40400000, "float32bits(3)"
  assert math.float32bits(mv_fb(0xC008000000000000)) == 0xC0400000, "float32bits(-3)"
  assert math.float32bits(mv_fb(0x3FDFFFFFFFFFFFFF)) == 0x3F000000, "float32bits(0.49999999999999994)"
  assert math.float32bits(mv_fb(0xBFDFFFFFFFFFFFFF)) == 0xBF000000, "float32bits(-0.49999999999999994)"
  assert math.float32bits(mv_fb(0x432FFFFFFFFFFFFF)) == 0x59800000, "float32bits(4.5035996273704955e+15)"
  assert math.float32bits(mv_fb(0x4330000000000000)) == 0x59800000, "float32bits(4.503599627370496e+15)"
  assert math.float32bits(mv_fb(0xC330000000000001)) == 0xD9800000, "float32bits(-4.503599627370497e+15)"
  assert math.float32bits(mv_fb(0x4340000000000000)) == 0x5A000000, "float32bits(9.007199254740992e+15)"
  assert math.float32bits(mv_fb(0x43D0000000000000)) == 0x5E800000, "float32bits(4.611686018427388e+18)"
  assert math.float32bits(mv_fb(0xC3E0000000000000)) == 0xDF000000, "float32bits(-9.223372036854776e+18)"
  assert math.float32bits(mv_fb(0x7FEFFFFFFFFFFFFF)) == 0x7F800000, "float32bits(1.7976931348623157e+308)"
  assert math.float32bits(mv_fb(0xFFEFFFFFFFFFFFFF)) == 0xFF800000, "float32bits(-1.7976931348623157e+308)"
  assert math.float32bits(mv_fb(0x0000000000000001)) == 0x00000000, "float32bits(5e-324)"
  assert math.float32bits(mv_fb(0x8000000000000001)) == 0x80000000, "float32bits(-5e-324)"
  assert math.float32bits(mv_fb(0x0010000000000000)) == 0x00000000, "float32bits(2.2250738585072014e-308)"
  assert math.float32bits(mv_fb(0x000FFFFFFFFFFFFF)) == 0x00000000, "float32bits(2.225073858507201e-308)"
  assert math.float32bits(mv_fb(0x000012688B70E62B)) == 0x00000000, "float32bits(1e-310)"
  assert math.float32bits(mv_fb(0x80000000000007E8)) == 0x80000000, "float32bits(-1e-320)"
  assert math.float32bits(mv_fb(0x400921FB54442D18)) == 0x40490FDB, "float32bits(3.141592653589793)"
  assert math.float32bits(mv_fb(0xC005BF0A8B145769)) == 0xC02DF854, "float32bits(-2.718281828459045)"
