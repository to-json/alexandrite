test "fma 41" {
  assert mv_ok(math.fma(mv_fb(0xC060880000000000), mv_fb(0x000012688B70E62B), mv_fb(0x7FF8000000000001)), MV_NAN), "fma(-132.25, 1e-310, NaN)"
