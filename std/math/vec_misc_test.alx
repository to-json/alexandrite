test "sqrt 11" {
  assert mv_ok(math.sqrt(mv_fb(0x0000000000000000)), 0x0000000000000000), "sqrt(0)"
  assert mv_ok(math.sqrt(mv_fb(0x8000000000000000)), 0x8000000000000000), "sqrt(-0)"
  assert mv_ok(math.sqrt(mv_fb(0x7FF0000000000000)), 0x7FF0000000000000), "sqrt(+Inf)"
  assert mv_ok(math.sqrt(mv_fb(0xFFF0000000000000)), MV_NAN), "sqrt(-Inf)"
  assert mv_ok(math.sqrt(mv_fb(0x7FF8000000000001)), MV_NAN), "sqrt(NaN)"
  assert mv_ok(math.sqrt(mv_fb(0x3FF0000000000000)), 0x3FF0000000000000), "sqrt(1)"
  assert mv_ok(math.sqrt(mv_fb(0xBFF0000000000000)), MV_NAN), "sqrt(-1)"
  assert mv_ok(math.sqrt(mv_fb(0x3FE0000000000000)), 0x3FE6A09E667F3BCD), "sqrt(0.5)"
  assert mv_ok(math.sqrt(mv_fb(0xBFE0000000000000)), MV_NAN), "sqrt(-0.5)"
  assert mv_ok(math.sqrt(mv_fb(0x3FF8000000000000)), 0x3FF3988E1409212E), "sqrt(1.5)"
  assert mv_ok(math.sqrt(mv_fb(0xBFF8000000000000)), MV_NAN), "sqrt(-1.5)"
  assert mv_ok(math.sqrt(mv_fb(0x4004000000000000)), 0x3FF94C583ADA5B53), "sqrt(2.5)"
  assert mv_ok(math.sqrt(mv_fb(0xC004000000000000)), MV_NAN), "sqrt(-2.5)"
  assert mv_ok(math.sqrt(mv_fb(0x4008000000000000)), 0x3FFBB67AE8584CAA), "sqrt(3)"
  assert mv_ok(math.sqrt(mv_fb(0xC008000000000000)), MV_NAN), "sqrt(-3)"
