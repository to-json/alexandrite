test "frexp 17" {
  assert mv_ok(math.frexp(mv_fb(0x0000000000000000))[0], 0x0000000000000000) && math.frexp(mv_fb(0x0000000000000000))[1] == 0, "frexp(0)"
  assert mv_ok(math.frexp(mv_fb(0x8000000000000000))[0], 0x8000000000000000) && math.frexp(mv_fb(0x8000000000000000))[1] == 0, "frexp(-0)"
  assert mv_ok(math.frexp(mv_fb(0x7FF0000000000000))[0], 0x7FF0000000000000) && math.frexp(mv_fb(0x7FF0000000000000))[1] == 0, "frexp(+Inf)"
  assert mv_ok(math.frexp(mv_fb(0xFFF0000000000000))[0], 0xFFF0000000000000) && math.frexp(mv_fb(0xFFF0000000000000))[1] == 0, "frexp(-Inf)"
  assert mv_ok(math.frexp(mv_fb(0x7FF8000000000001))[0], MV_NAN) && math.frexp(mv_fb(0x7FF8000000000001))[1] == 0, "frexp(NaN)"
  assert mv_ok(math.frexp(mv_fb(0x3FF0000000000000))[0], 0x3FE0000000000000) && math.frexp(mv_fb(0x3FF0000000000000))[1] == 1, "frexp(1)"
  assert mv_ok(math.frexp(mv_fb(0xBFF0000000000000))[0], 0xBFE0000000000000) && math.frexp(mv_fb(0xBFF0000000000000))[1] == 1, "frexp(-1)"
  assert mv_ok(math.frexp(mv_fb(0x3FE0000000000000))[0], 0x3FE0000000000000) && math.frexp(mv_fb(0x3FE0000000000000))[1] == 0, "frexp(0.5)"
  assert mv_ok(math.frexp(mv_fb(0xBFE0000000000000))[0], 0xBFE0000000000000) && math.frexp(mv_fb(0xBFE0000000000000))[1] == 0, "frexp(-0.5)"
  assert mv_ok(math.frexp(mv_fb(0x3FF8000000000000))[0], 0x3FE8000000000000) && math.frexp(mv_fb(0x3FF8000000000000))[1] == 1, "frexp(1.5)"
  assert mv_ok(math.frexp(mv_fb(0xBFF8000000000000))[0], 0xBFE8000000000000) && math.frexp(mv_fb(0xBFF8000000000000))[1] == 1, "frexp(-1.5)"
