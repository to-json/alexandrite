test "nextafter32 46" {
  assert mv_ok(math.nextafter32(mv_fb(0x0000000000000000), mv_fb(0x0000000000000000)), 0x0000000000000000), "nextafter32(0, 0)"
  assert mv_ok(math.nextafter32(mv_fb(0x0000000000000000), mv_fb(0x8000000000000000)), 0x0000000000000000), "nextafter32(0, -0)"
  assert mv_ok(math.nextafter32(mv_fb(0x0000000000000000), mv_fb(0x7FF0000000000000)), 0x36A0000000000000), "nextafter32(0, +Inf)"
  assert mv_ok(math.nextafter32(mv_fb(0x0000000000000000), mv_fb(0xFFF0000000000000)), 0xB6A0000000000000), "nextafter32(0, -Inf)"
  assert mv_ok(math.nextafter32(mv_fb(0x0000000000000000), mv_fb(0x7FF8000000000001)), MV_NAN), "nextafter32(0, NaN)"
  assert mv_ok(math.nextafter32(mv_fb(0x0000000000000000), mv_fb(0x4004000000000000)), 0x36A0000000000000), "nextafter32(0, 2.5)"
  assert mv_ok(math.nextafter32(mv_fb(0x0000000000000000), mv_fb(0xC008000000000000)), 0xB6A0000000000000), "nextafter32(0, -3)"
  assert mv_ok(math.nextafter32(mv_fb(0x0000000000000000), mv_fb(0x000012688B70E62B)), 0x0000000000000000), "nextafter32(0, 1e-310)"
  assert mv_ok(math.nextafter32(mv_fb(0x8000000000000000), mv_fb(0x0000000000000000)), 0x8000000000000000), "nextafter32(-0, 0)"
  assert mv_ok(math.nextafter32(mv_fb(0x8000000000000000), mv_fb(0x8000000000000000)), 0x8000000000000000), "nextafter32(-0, -0)"
  assert mv_ok(math.nextafter32(mv_fb(0x8000000000000000), mv_fb(0x7FF0000000000000)), 0x36A0000000000000), "nextafter32(-0, +Inf)"
  assert mv_ok(math.nextafter32(mv_fb(0x8000000000000000), mv_fb(0xFFF0000000000000)), 0xB6A0000000000000), "nextafter32(-0, -Inf)"
  assert mv_ok(math.nextafter32(mv_fb(0x8000000000000000), mv_fb(0x7FF8000000000001)), MV_NAN), "nextafter32(-0, NaN)"
  assert mv_ok(math.nextafter32(mv_fb(0x8000000000000000), mv_fb(0x4004000000000000)), 0x36A0000000000000), "nextafter32(-0, 2.5)"
  assert mv_ok(math.nextafter32(mv_fb(0x8000000000000000), mv_fb(0xC008000000000000)), 0xB6A0000000000000), "nextafter32(-0, -3)"
  assert mv_ok(math.nextafter32(mv_fb(0x8000000000000000), mv_fb(0x000012688B70E62B)), 0x8000000000000000), "nextafter32(-0, 1e-310)"
  assert mv_ok(math.nextafter32(mv_fb(0x7FF0000000000000), mv_fb(0x0000000000000000)), 0x47EFFFFFE0000000), "nextafter32(+Inf, 0)"
  assert mv_ok(math.nextafter32(mv_fb(0x7FF0000000000000), mv_fb(0x8000000000000000)), 0x47EFFFFFE0000000), "nextafter32(+Inf, -0)"
  assert mv_ok(math.nextafter32(mv_fb(0x7FF0000000000000), mv_fb(0x7FF0000000000000)), 0x7FF0000000000000), "nextafter32(+Inf, +Inf)"
  assert mv_ok(math.nextafter32(mv_fb(0x7FF0000000000000), mv_fb(0xFFF0000000000000)), 0x47EFFFFFE0000000), "nextafter32(+Inf, -Inf)"
  assert mv_ok(math.nextafter32(mv_fb(0x7FF0000000000000), mv_fb(0x7FF8000000000001)), MV_NAN), "nextafter32(+Inf, NaN)"
  assert mv_ok(math.nextafter32(mv_fb(0x7FF0000000000000), mv_fb(0x4004000000000000)), 0x47EFFFFFE0000000), "nextafter32(+Inf, 2.5)"
  assert mv_ok(math.nextafter32(mv_fb(0x7FF0000000000000), mv_fb(0xC008000000000000)), 0x47EFFFFFE0000000), "nextafter32(+Inf, -3)"
  assert mv_ok(math.nextafter32(mv_fb(0x7FF0000000000000), mv_fb(0x000012688B70E62B)), 0x47EFFFFFE0000000), "nextafter32(+Inf, 1e-310)"
