test "signbit 48" {
  assert math.signbit(mv_fb(0x0000000000000000)) == false, "signbit(0)"
  assert math.signbit(mv_fb(0x8000000000000000)) == true, "signbit(-0)"
  assert math.signbit(mv_fb(0x7FF0000000000000)) == false, "signbit(+Inf)"
  assert math.signbit(mv_fb(0xFFF0000000000000)) == true, "signbit(-Inf)"
  assert math.signbit(mv_fb(0x7FF8000000000001)) == false, "signbit(NaN)"
  assert math.signbit(mv_fb(0x3FF0000000000000)) == false, "signbit(1)"
  assert math.signbit(mv_fb(0xBFF0000000000000)) == true, "signbit(-1)"
  assert math.signbit(mv_fb(0x3FE0000000000000)) == false, "signbit(0.5)"
  assert math.signbit(mv_fb(0xBFE0000000000000)) == true, "signbit(-0.5)"
  assert math.signbit(mv_fb(0x3FF8000000000000)) == false, "signbit(1.5)"
  assert math.signbit(mv_fb(0xBFF8000000000000)) == true, "signbit(-1.5)"
  assert math.signbit(mv_fb(0x4004000000000000)) == false, "signbit(2.5)"
  assert math.signbit(mv_fb(0xC004000000000000)) == true, "signbit(-2.5)"
  assert math.signbit(mv_fb(0x4008000000000000)) == false, "signbit(3)"
  assert math.signbit(mv_fb(0xC008000000000000)) == true, "signbit(-3)"
  assert math.signbit(mv_fb(0x3FDFFFFFFFFFFFFF)) == false, "signbit(0.49999999999999994)"
  assert math.signbit(mv_fb(0xBFDFFFFFFFFFFFFF)) == true, "signbit(-0.49999999999999994)"
  assert math.signbit(mv_fb(0x432FFFFFFFFFFFFF)) == false, "signbit(4.5035996273704955e+15)"
  assert math.signbit(mv_fb(0x4330000000000000)) == false, "signbit(4.503599627370496e+15)"
  assert math.signbit(mv_fb(0xC330000000000001)) == true, "signbit(-4.503599627370497e+15)"
  assert math.signbit(mv_fb(0x4340000000000000)) == false, "signbit(9.007199254740992e+15)"
  assert math.signbit(mv_fb(0x43D0000000000000)) == false, "signbit(4.611686018427388e+18)"
  assert math.signbit(mv_fb(0xC3E0000000000000)) == true, "signbit(-9.223372036854776e+18)"
  assert math.signbit(mv_fb(0x7FEFFFFFFFFFFFFF)) == false, "signbit(1.7976931348623157e+308)"
  assert math.signbit(mv_fb(0xFFEFFFFFFFFFFFFF)) == true, "signbit(-1.7976931348623157e+308)"
  assert math.signbit(mv_fb(0x0000000000000001)) == false, "signbit(5e-324)"
  assert math.signbit(mv_fb(0x8000000000000001)) == true, "signbit(-5e-324)"
  assert math.signbit(mv_fb(0x0010000000000000)) == false, "signbit(2.2250738585072014e-308)"
  assert math.signbit(mv_fb(0x000FFFFFFFFFFFFF)) == false, "signbit(2.225073858507201e-308)"
  assert math.signbit(mv_fb(0x000012688B70E62B)) == false, "signbit(1e-310)"
  assert math.signbit(mv_fb(0x80000000000007E8)) == true, "signbit(-1e-320)"
  assert math.signbit(mv_fb(0x400921FB54442D18)) == false, "signbit(3.141592653589793)"
  assert math.signbit(mv_fb(0xC005BF0A8B145769)) == true, "signbit(-2.718281828459045)"
  assert math.signbit(mv_fb(0x7E37E43C8800759C)) == false, "signbit(1e+300)"
  assert math.signbit(mv_fb(0x81A56E1FC2F8F359)) == true, "signbit(-1e-300)"
  assert math.signbit(mv_fb(0x3FB999999999999A)) == false, "signbit(0.1)"
  assert math.signbit(mv_fb(0x40FE240C9FBE76C9)) == false, "signbit(123456.789)"
  assert math.signbit(mv_fb(0xC0F81CD6E9E1B08A)) == true, "signbit(-98765.4321)"
  assert math.signbit(mv_fb(0x3FEFFFFFFFFFFFFF)) == false, "signbit(0.9999999999999999)"
  assert math.signbit(mv_fb(0x3FF0000000000001)) == false, "signbit(1.0000000000000002)"
  assert math.signbit(mv_fb(0x47EFFFFFE0000000)) == false, "signbit(3.4028234663852886e+38)"
  assert math.signbit(mv_fb(0x47EFFFFFF0000000)) == false, "signbit(3.4028235677973366e+38)"
  assert math.signbit(mv_fb(0x47EFFFFFEFFFFFFE)) == false, "signbit(3.402823567797336e+38)"
  assert math.signbit(mv_fb(0x36A0000000000000)) == false, "signbit(1.401298464324817e-45)"
  assert math.signbit(mv_fb(0x3690000000000000)) == false, "signbit(7.006492321624085e-46)"
  assert math.signbit(mv_fb(0x3690000000000000)) == false, "signbit(7.006492321624085e-46)"
  assert math.signbit(mv_fb(0x380FFFFFC000E240)) == false, "signbit(1.1754942107e-38)"
  assert math.signbit(mv_fb(0x3810000000000000)) == false, "signbit(1.1754943508222875e-38)"
  assert math.signbit(mv_fb(0x4170000010000000)) == false, "signbit(1.6777217e+07)"
  assert math.signbit(mv_fb(0x4170000030000000)) == false, "signbit(1.6777219e+07)"
  assert math.signbit(mv_fb(0x3FD3333333333333)) == false, "signbit(0.3)"
  assert math.signbit(mv_fb(0x43C3B4BD431A6712)) == false, "signbit(2.8399357568639396e+18)"
  assert math.signbit(mv_fb(0xC037F542C979740A)) == true, "signbit(-23.95805033888977)"
  assert math.signbit(mv_fb(0xBCC2DDD9F48F7C74)) == true, "signbit(-5.236535367594236e-16)"
  assert math.signbit(mv_fb(0x405F400000000000)) == false, "signbit(125)"
  assert math.signbit(mv_fb(0x82EA7CE9A824F65C)) == true, "signbit(-1.2960520486139112e-294)"
  assert math.signbit(mv_fb(0x40260AEBF029F72C)) == false, "signbit(11.021331315157646)"
  assert math.signbit(mv_fb(0x3E7C64B9D8DDA91C)) == false, "signbit(1.057738840661541e-07)"
  assert math.signbit(mv_fb(0x4063C00000000000)) == false, "signbit(158)"
  assert math.signbit(mv_fb(0xC5D768E27583428D)) == true, "signbit(-2.897981173473328e+28)"
  assert math.signbit(mv_fb(0xC03F56AA05985B01)) == true, "signbit(-31.338531827636874)"
  assert math.signbit(mv_fb(0x3EFDAC4832394200)) == false, "signbit(2.8298355699897873e-05)"
  assert math.signbit(mv_fb(0xC06A900000000000)) == true, "signbit(-212.5)"
  assert math.signbit(mv_fb(0x3EF24A92F48278B7)) == false, "signbit(1.7443947655786727e-05)"
  assert math.signbit(mv_fb(0x40251359D908C5C8)) == false, "signbit(10.537794859238502)"
  assert math.signbit(mv_fb(0x41B76DB8B3FADC04)) == false, "signbit(3.930666759799197e+08)"
  assert math.signbit(mv_fb(0xC04E000000000000)) == true, "signbit(-60)"
  assert math.signbit(mv_fb(0x1EA2233C051F0479)) == false, "signbit(4.031558596341236e-161)"
  assert math.signbit(mv_fb(0x40360656376679FD)) == false, "signbit(22.02475305797451)"
  assert math.signbit(mv_fb(0x3E6A760E8483BB60)) == false, "signbit(4.92877494944841e-08)"
  assert math.signbit(mv_fb(0x4047C00000000000)) == false, "signbit(47.5)"
}

test "is_inf 49" {
  assert math.is_inf(mv_fb(0x0000000000000000), 1) == false && math.is_inf(mv_fb(0x0000000000000000), -1) == false && math.is_inf(mv_fb(0x0000000000000000), 0) == false, "is_inf(0)"
  assert math.is_inf(mv_fb(0x8000000000000000), 1) == false && math.is_inf(mv_fb(0x8000000000000000), -1) == false && math.is_inf(mv_fb(0x8000000000000000), 0) == false, "is_inf(-0)"
  assert math.is_inf(mv_fb(0x7FF0000000000000), 1) == true && math.is_inf(mv_fb(0x7FF0000000000000), -1) == false && math.is_inf(mv_fb(0x7FF0000000000000), 0) == true, "is_inf(+Inf)"
  assert math.is_inf(mv_fb(0xFFF0000000000000), 1) == false && math.is_inf(mv_fb(0xFFF0000000000000), -1) == true && math.is_inf(mv_fb(0xFFF0000000000000), 0) == true, "is_inf(-Inf)"
  assert math.is_inf(mv_fb(0x7FF8000000000001), 1) == false && math.is_inf(mv_fb(0x7FF8000000000001), -1) == false && math.is_inf(mv_fb(0x7FF8000000000001), 0) == false, "is_inf(NaN)"
  assert math.is_inf(mv_fb(0x3FF0000000000000), 1) == false && math.is_inf(mv_fb(0x3FF0000000000000), -1) == false && math.is_inf(mv_fb(0x3FF0000000000000), 0) == false, "is_inf(1)"
  assert math.is_inf(mv_fb(0xBFF0000000000000), 1) == false && math.is_inf(mv_fb(0xBFF0000000000000), -1) == false && math.is_inf(mv_fb(0xBFF0000000000000), 0) == false, "is_inf(-1)"
  assert math.is_inf(mv_fb(0x3FE0000000000000), 1) == false && math.is_inf(mv_fb(0x3FE0000000000000), -1) == false && math.is_inf(mv_fb(0x3FE0000000000000), 0) == false, "is_inf(0.5)"
  assert math.is_inf(mv_fb(0xBFE0000000000000), 1) == false && math.is_inf(mv_fb(0xBFE0000000000000), -1) == false && math.is_inf(mv_fb(0xBFE0000000000000), 0) == false, "is_inf(-0.5)"
  assert math.is_inf(mv_fb(0x3FF8000000000000), 1) == false && math.is_inf(mv_fb(0x3FF8000000000000), -1) == false && math.is_inf(mv_fb(0x3FF8000000000000), 0) == false, "is_inf(1.5)"
  assert math.is_inf(mv_fb(0xBFF8000000000000), 1) == false && math.is_inf(mv_fb(0xBFF8000000000000), -1) == false && math.is_inf(mv_fb(0xBFF8000000000000), 0) == false, "is_inf(-1.5)"
  assert math.is_inf(mv_fb(0x4004000000000000), 1) == false && math.is_inf(mv_fb(0x4004000000000000), -1) == false && math.is_inf(mv_fb(0x4004000000000000), 0) == false, "is_inf(2.5)"
  assert math.is_inf(mv_fb(0xC004000000000000), 1) == false && math.is_inf(mv_fb(0xC004000000000000), -1) == false && math.is_inf(mv_fb(0xC004000000000000), 0) == false, "is_inf(-2.5)"
  assert math.is_inf(mv_fb(0x4008000000000000), 1) == false && math.is_inf(mv_fb(0x4008000000000000), -1) == false && math.is_inf(mv_fb(0x4008000000000000), 0) == false, "is_inf(3)"
  assert math.is_inf(mv_fb(0xC008000000000000), 1) == false && math.is_inf(mv_fb(0xC008000000000000), -1) == false && math.is_inf(mv_fb(0xC008000000000000), 0) == false, "is_inf(-3)"
  assert math.is_inf(mv_fb(0x3FDFFFFFFFFFFFFF), 1) == false && math.is_inf(mv_fb(0x3FDFFFFFFFFFFFFF), -1) == false && math.is_inf(mv_fb(0x3FDFFFFFFFFFFFFF), 0) == false, "is_inf(0.49999999999999994)"
  assert math.is_inf(mv_fb(0xBFDFFFFFFFFFFFFF), 1) == false && math.is_inf(mv_fb(0xBFDFFFFFFFFFFFFF), -1) == false && math.is_inf(mv_fb(0xBFDFFFFFFFFFFFFF), 0) == false, "is_inf(-0.49999999999999994)"
  assert math.is_inf(mv_fb(0x432FFFFFFFFFFFFF), 1) == false && math.is_inf(mv_fb(0x432FFFFFFFFFFFFF), -1) == false && math.is_inf(mv_fb(0x432FFFFFFFFFFFFF), 0) == false, "is_inf(4.5035996273704955e+15)"
  assert math.is_inf(mv_fb(0x4330000000000000), 1) == false && math.is_inf(mv_fb(0x4330000000000000), -1) == false && math.is_inf(mv_fb(0x4330000000000000), 0) == false, "is_inf(4.503599627370496e+15)"
  assert math.is_inf(mv_fb(0xC330000000000001), 1) == false && math.is_inf(mv_fb(0xC330000000000001), -1) == false && math.is_inf(mv_fb(0xC330000000000001), 0) == false, "is_inf(-4.503599627370497e+15)"
  assert math.is_inf(mv_fb(0x4340000000000000), 1) == false && math.is_inf(mv_fb(0x4340000000000000), -1) == false && math.is_inf(mv_fb(0x4340000000000000), 0) == false, "is_inf(9.007199254740992e+15)"
  assert math.is_inf(mv_fb(0x43D0000000000000), 1) == false && math.is_inf(mv_fb(0x43D0000000000000), -1) == false && math.is_inf(mv_fb(0x43D0000000000000), 0) == false, "is_inf(4.611686018427388e+18)"
  assert math.is_inf(mv_fb(0xC3E0000000000000), 1) == false && math.is_inf(mv_fb(0xC3E0000000000000), -1) == false && math.is_inf(mv_fb(0xC3E0000000000000), 0) == false, "is_inf(-9.223372036854776e+18)"
  assert math.is_inf(mv_fb(0x7FEFFFFFFFFFFFFF), 1) == false && math.is_inf(mv_fb(0x7FEFFFFFFFFFFFFF), -1) == false && math.is_inf(mv_fb(0x7FEFFFFFFFFFFFFF), 0) == false, "is_inf(1.7976931348623157e+308)"
  assert math.is_inf(mv_fb(0xFFEFFFFFFFFFFFFF), 1) == false && math.is_inf(mv_fb(0xFFEFFFFFFFFFFFFF), -1) == false && math.is_inf(mv_fb(0xFFEFFFFFFFFFFFFF), 0) == false, "is_inf(-1.7976931348623157e+308)"
  assert math.is_inf(mv_fb(0x0000000000000001), 1) == false && math.is_inf(mv_fb(0x0000000000000001), -1) == false && math.is_inf(mv_fb(0x0000000000000001), 0) == false, "is_inf(5e-324)"
  assert math.is_inf(mv_fb(0x8000000000000001), 1) == false && math.is_inf(mv_fb(0x8000000000000001), -1) == false && math.is_inf(mv_fb(0x8000000000000001), 0) == false, "is_inf(-5e-324)"
  assert math.is_inf(mv_fb(0x0010000000000000), 1) == false && math.is_inf(mv_fb(0x0010000000000000), -1) == false && math.is_inf(mv_fb(0x0010000000000000), 0) == false, "is_inf(2.2250738585072014e-308)"
