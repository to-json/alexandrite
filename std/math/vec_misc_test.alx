test "floor 2" {
  assert mv_ok(math.floor(mv_fb(0x403837A08E37F361)), 0x4038000000000000), "floor(24.217293633136595)"
}

test "ceil 3" {
  assert mv_ok(math.ceil(mv_fb(0x0000000000000000)), 0x0000000000000000), "ceil(0)"
  assert mv_ok(math.ceil(mv_fb(0x8000000000000000)), 0x8000000000000000), "ceil(-0)"
  assert mv_ok(math.ceil(mv_fb(0x7FF0000000000000)), 0x7FF0000000000000), "ceil(+Inf)"
  assert mv_ok(math.ceil(mv_fb(0xFFF0000000000000)), 0xFFF0000000000000), "ceil(-Inf)"
  assert mv_ok(math.ceil(mv_fb(0x7FF8000000000001)), MV_NAN), "ceil(NaN)"
  assert mv_ok(math.ceil(mv_fb(0x3FF0000000000000)), 0x3FF0000000000000), "ceil(1)"
  assert mv_ok(math.ceil(mv_fb(0xBFF0000000000000)), 0xBFF0000000000000), "ceil(-1)"
  assert mv_ok(math.ceil(mv_fb(0x3FE0000000000000)), 0x3FF0000000000000), "ceil(0.5)"
  assert mv_ok(math.ceil(mv_fb(0xBFE0000000000000)), 0x8000000000000000), "ceil(-0.5)"
  assert mv_ok(math.ceil(mv_fb(0x3FF8000000000000)), 0x4000000000000000), "ceil(1.5)"
  assert mv_ok(math.ceil(mv_fb(0xBFF8000000000000)), 0xBFF0000000000000), "ceil(-1.5)"
  assert mv_ok(math.ceil(mv_fb(0x4004000000000000)), 0x4008000000000000), "ceil(2.5)"
  assert mv_ok(math.ceil(mv_fb(0xC004000000000000)), 0xC000000000000000), "ceil(-2.5)"
