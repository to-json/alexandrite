test "ilogb 16" {
  assert math.ilogb(mv_fb(0x0000000000000000)) == -2147483648, "ilogb(0)"
  assert math.ilogb(mv_fb(0x8000000000000000)) == -2147483648, "ilogb(-0)"
  assert math.ilogb(mv_fb(0x7FF0000000000000)) == 2147483647, "ilogb(+Inf)"
  assert math.ilogb(mv_fb(0xFFF0000000000000)) == 2147483647, "ilogb(-Inf)"
  assert math.ilogb(mv_fb(0x7FF8000000000001)) == 2147483647, "ilogb(NaN)"
  assert math.ilogb(mv_fb(0x3FF0000000000000)) == 0, "ilogb(1)"
  assert math.ilogb(mv_fb(0xBFF0000000000000)) == 0, "ilogb(-1)"
  assert math.ilogb(mv_fb(0x3FE0000000000000)) == -1, "ilogb(0.5)"
  assert math.ilogb(mv_fb(0xBFE0000000000000)) == -1, "ilogb(-0.5)"
  assert math.ilogb(mv_fb(0x3FF8000000000000)) == 0, "ilogb(1.5)"
  assert math.ilogb(mv_fb(0xBFF8000000000000)) == 0, "ilogb(-1.5)"
  assert math.ilogb(mv_fb(0x4004000000000000)) == 1, "ilogb(2.5)"
  assert math.ilogb(mv_fb(0xC004000000000000)) == 1, "ilogb(-2.5)"
  assert math.ilogb(mv_fb(0x4008000000000000)) == 1, "ilogb(3)"
  assert math.ilogb(mv_fb(0xC008000000000000)) == 1, "ilogb(-3)"
  assert math.ilogb(mv_fb(0x3FDFFFFFFFFFFFFF)) == -2, "ilogb(0.49999999999999994)"
  assert math.ilogb(mv_fb(0xBFDFFFFFFFFFFFFF)) == -2, "ilogb(-0.49999999999999994)"
  assert math.ilogb(mv_fb(0x432FFFFFFFFFFFFF)) == 51, "ilogb(4.5035996273704955e+15)"
  assert math.ilogb(mv_fb(0x4330000000000000)) == 52, "ilogb(4.503599627370496e+15)"
  assert math.ilogb(mv_fb(0xC330000000000001)) == 52, "ilogb(-4.503599627370497e+15)"
  assert math.ilogb(mv_fb(0x4340000000000000)) == 53, "ilogb(9.007199254740992e+15)"
  assert math.ilogb(mv_fb(0x43D0000000000000)) == 62, "ilogb(4.611686018427388e+18)"
  assert math.ilogb(mv_fb(0xC3E0000000000000)) == 63, "ilogb(-9.223372036854776e+18)"
  assert math.ilogb(mv_fb(0x7FEFFFFFFFFFFFFF)) == 1023, "ilogb(1.7976931348623157e+308)"
  assert math.ilogb(mv_fb(0xFFEFFFFFFFFFFFFF)) == 1023, "ilogb(-1.7976931348623157e+308)"
  assert math.ilogb(mv_fb(0x0000000000000001)) == -1074, "ilogb(5e-324)"
  assert math.ilogb(mv_fb(0x8000000000000001)) == -1074, "ilogb(-5e-324)"
  assert math.ilogb(mv_fb(0x0010000000000000)) == -1022, "ilogb(2.2250738585072014e-308)"
  assert math.ilogb(mv_fb(0x000FFFFFFFFFFFFF)) == -1023, "ilogb(2.225073858507201e-308)"
  assert math.ilogb(mv_fb(0x000012688B70E62B)) == -1030, "ilogb(1e-310)"
  assert math.ilogb(mv_fb(0x80000000000007E8)) == -1064, "ilogb(-1e-320)"
  assert math.ilogb(mv_fb(0x400921FB54442D18)) == 1, "ilogb(3.141592653589793)"
  assert math.ilogb(mv_fb(0xC005BF0A8B145769)) == 1, "ilogb(-2.718281828459045)"
  assert math.ilogb(mv_fb(0x7E37E43C8800759C)) == 996, "ilogb(1e+300)"
  assert math.ilogb(mv_fb(0x81A56E1FC2F8F359)) == -997, "ilogb(-1e-300)"
  assert math.ilogb(mv_fb(0x3FB999999999999A)) == -4, "ilogb(0.1)"
