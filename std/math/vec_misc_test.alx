test "round_to_even 9" {
  assert mv_ok(math.round_to_even(mv_fb(0x0000000000000000)), 0x0000000000000000), "round_to_even(0)"
  assert mv_ok(math.round_to_even(mv_fb(0x8000000000000000)), 0x8000000000000000), "round_to_even(-0)"
