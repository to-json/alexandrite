  assert mv_ok(math.round_to_even(mv_fb(0xFFF0000000000000)), 0xFFF0000000000000), "round_to_even(-Inf)"
  assert mv_ok(math.round_to_even(mv_fb(0x7FF8000000000001)), MV_NAN), "round_to_even(NaN)"
