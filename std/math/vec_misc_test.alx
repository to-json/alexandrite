test "ldexp 19" {
  assert mv_ok(math.ldexp(mv_fb(0x0000000000000000), -1100), 0x0000000000000000), "ldexp(0, -1100)"
  assert mv_ok(math.ldexp(mv_fb(0x0000000000000000), 1023), 0x0000000000000000), "ldexp(0, 1023)"
  assert mv_ok(math.ldexp(mv_fb(0x0000000000000000), 2000), 0x0000000000000000), "ldexp(0, 2000)"
  assert mv_ok(math.ldexp(mv_fb(0x0000000000000000), -484), 0x0000000000000000), "ldexp(0, -484)"
  assert mv_ok(math.ldexp(mv_fb(0x8000000000000000), -52), 0x8000000000000000), "ldexp(-0, -52)"
  assert mv_ok(math.ldexp(mv_fb(0x8000000000000000), -2000), 0x8000000000000000), "ldexp(-0, -2000)"
  assert mv_ok(math.ldexp(mv_fb(0x8000000000000000), 1), 0x8000000000000000), "ldexp(-0, 1)"
  assert mv_ok(math.ldexp(mv_fb(0x8000000000000000), 1512), 0x8000000000000000), "ldexp(-0, 1512)"
  assert mv_ok(math.ldexp(mv_fb(0x7FF0000000000000), -1), 0x7FF0000000000000), "ldexp(+Inf, -1)"
  assert mv_ok(math.ldexp(mv_fb(0x7FF0000000000000), -52), 0x7FF0000000000000), "ldexp(+Inf, -52)"
  assert mv_ok(math.ldexp(mv_fb(0x7FF0000000000000), -1074), 0x7FF0000000000000), "ldexp(+Inf, -1074)"
  assert mv_ok(math.ldexp(mv_fb(0x7FF0000000000000), 1849), 0x7FF0000000000000), "ldexp(+Inf, 1849)"
  assert mv_ok(math.ldexp(mv_fb(0xFFF0000000000000), 2000), 0xFFF0000000000000), "ldexp(-Inf, 2000)"
  assert mv_ok(math.ldexp(mv_fb(0xFFF0000000000000), 1099511627776), 0xFFF0000000000000), "ldexp(-Inf, 1099511627776)"
  assert mv_ok(math.ldexp(mv_fb(0xFFF0000000000000), -1075), 0xFFF0000000000000), "ldexp(-Inf, -1075)"
  assert mv_ok(math.ldexp(mv_fb(0xFFF0000000000000), -1783), 0xFFF0000000000000), "ldexp(-Inf, -1783)"
  assert mv_ok(math.ldexp(mv_fb(0x7FF8000000000001), -1), MV_NAN), "ldexp(NaN, -1)"
  assert mv_ok(math.ldexp(mv_fb(0x7FF8000000000001), 52), MV_NAN), "ldexp(NaN, 52)"
  assert mv_ok(math.ldexp(mv_fb(0x7FF8000000000001), 4000), MV_NAN), "ldexp(NaN, 4000)"
  assert mv_ok(math.ldexp(mv_fb(0x7FF8000000000001), 445), MV_NAN), "ldexp(NaN, 445)"
  assert mv_ok(math.ldexp(mv_fb(0x3FF0000000000000), 52), 0x4330000000000000), "ldexp(1, 52)"
  assert mv_ok(math.ldexp(mv_fb(0x3FF0000000000000), -1075), 0x0000000000000000), "ldexp(1, -1075)"
  assert mv_ok(math.ldexp(mv_fb(0x3FF0000000000000), 1024), 0x7FF0000000000000), "ldexp(1, 1024)"
  assert mv_ok(math.ldexp(mv_fb(0x3FF0000000000000), -1021), 0x0020000000000000), "ldexp(1, -1021)"
  assert mv_ok(math.ldexp(mv_fb(0xBFF0000000000000), 4000), 0xFFF0000000000000), "ldexp(-1, 4000)"
  assert mv_ok(math.ldexp(mv_fb(0xBFF0000000000000), 1024), 0xFFF0000000000000), "ldexp(-1, 1024)"
  assert mv_ok(math.ldexp(mv_fb(0xBFF0000000000000), -1100), 0x8000000000000000), "ldexp(-1, -1100)"
  assert mv_ok(math.ldexp(mv_fb(0xBFF0000000000000), 1842), 0xFFF0000000000000), "ldexp(-1, 1842)"
  assert mv_ok(math.ldexp(mv_fb(0x3FE0000000000000), 1099511627776), 0x7FF0000000000000), "ldexp(0.5, 1099511627776)"
  assert mv_ok(math.ldexp(mv_fb(0x3FE0000000000000), -52), 0x3CA0000000000000), "ldexp(0.5, -52)"
  assert mv_ok(math.ldexp(mv_fb(0x3FE0000000000000), -1023), 0x0004000000000000), "ldexp(0.5, -1023)"
  assert mv_ok(math.ldexp(mv_fb(0x3FE0000000000000), 1490), 0x7FF0000000000000), "ldexp(0.5, 1490)"
  assert mv_ok(math.ldexp(mv_fb(0xBFE0000000000000), -1075), 0x8000000000000000), "ldexp(-0.5, -1075)"
  assert mv_ok(math.ldexp(mv_fb(0xBFE0000000000000), 1), 0xBFF0000000000000), "ldexp(-0.5, 1)"
  assert mv_ok(math.ldexp(mv_fb(0xBFE0000000000000), 1099511627776), 0xFFF0000000000000), "ldexp(-0.5, 1099511627776)"
  assert mv_ok(math.ldexp(mv_fb(0xBFE0000000000000), -2096), 0x8000000000000000), "ldexp(-0.5, -2096)"
  assert mv_ok(math.ldexp(mv_fb(0x3FF8000000000000), 4000), 0x7FF0000000000000), "ldexp(1.5, 4000)"
  assert mv_ok(math.ldexp(mv_fb(0x3FF8000000000000), -4000), 0x0000000000000000), "ldexp(1.5, -4000)"
  assert mv_ok(math.ldexp(mv_fb(0x3FF8000000000000), -4000), 0x0000000000000000), "ldexp(1.5, -4000)"
  assert mv_ok(math.ldexp(mv_fb(0x3FF8000000000000), 1637), 0x7FF0000000000000), "ldexp(1.5, 1637)"
  assert mv_ok(math.ldexp(mv_fb(0xBFF8000000000000), 2000), 0xFFF0000000000000), "ldexp(-1.5, 2000)"
  assert mv_ok(math.ldexp(mv_fb(0xBFF8000000000000), 1), 0xC008000000000000), "ldexp(-1.5, 1)"
  assert mv_ok(math.ldexp(mv_fb(0xBFF8000000000000), -4000), 0x8000000000000000), "ldexp(-1.5, -4000)"
  assert mv_ok(math.ldexp(mv_fb(0xBFF8000000000000), -1842), 0x8000000000000000), "ldexp(-1.5, -1842)"
