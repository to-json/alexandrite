test "remainder 31" {
  assert mv_ok(math.remainder(mv_fb(0x0000000000000000), mv_fb(0x0000000000000000)), MV_NAN), "remainder(0, 0)"
  assert mv_ok(math.remainder(mv_fb(0x0000000000000000), mv_fb(0x8000000000000000)), MV_NAN), "remainder(0, -0)"
  assert mv_ok(math.remainder(mv_fb(0x0000000000000000), mv_fb(0x7FF0000000000000)), 0x0000000000000000), "remainder(0, +Inf)"
  assert mv_ok(math.remainder(mv_fb(0x0000000000000000), mv_fb(0xFFF0000000000000)), 0x0000000000000000), "remainder(0, -Inf)"
  assert mv_ok(math.remainder(mv_fb(0x0000000000000000), mv_fb(0x7FF8000000000001)), MV_NAN), "remainder(0, NaN)"
  assert mv_ok(math.remainder(mv_fb(0x0000000000000000), mv_fb(0x4004000000000000)), 0x0000000000000000), "remainder(0, 2.5)"
  assert mv_ok(math.remainder(mv_fb(0x0000000000000000), mv_fb(0xC008000000000000)), 0x0000000000000000), "remainder(0, -3)"
  assert mv_ok(math.remainder(mv_fb(0x0000000000000000), mv_fb(0x000012688B70E62B)), 0x0000000000000000), "remainder(0, 1e-310)"
  assert mv_ok(math.remainder(mv_fb(0x8000000000000000), mv_fb(0x0000000000000000)), MV_NAN), "remainder(-0, 0)"
  assert mv_ok(math.remainder(mv_fb(0x8000000000000000), mv_fb(0x8000000000000000)), MV_NAN), "remainder(-0, -0)"
  assert mv_ok(math.remainder(mv_fb(0x8000000000000000), mv_fb(0x7FF0000000000000)), 0x8000000000000000), "remainder(-0, +Inf)"
