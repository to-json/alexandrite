#![test(external)]
# Generated from Go's math (go1.27.1, GOOS=js GOARCH=wasm: the portable
# implementations, no FMA); do not edit by hand. Rounding, remainders,
# exponent decomposition, fma, pow10, nextafter and the float32 functions,
# bit-exact (any NaN matches a NaN). External: it calls math. as a user does.

import "math"

MV_NAN: U64 = 0x7FF8000000000001

def mv_fb(b: U64) -> Float { math.float64frombits(b) }

def mv_ok(got: Float, want: U64) -> Bool {
  return math.is_nan(got) if want == MV_NAN
  math.float64bits(got) == want
}

test "floor 1" {
  assert mv_ok(math.floor(mv_fb(0x0000000000000000)), 0x0000000000000000), "floor(0)"
  assert mv_ok(math.floor(mv_fb(0x8000000000000000)), 0x8000000000000000), "floor(-0)"
  assert mv_ok(math.floor(mv_fb(0x7FF0000000000000)), 0x7FF0000000000000), "floor(+Inf)"
  assert mv_ok(math.floor(mv_fb(0xFFF0000000000000)), 0xFFF0000000000000), "floor(-Inf)"
  assert mv_ok(math.floor(mv_fb(0x7FF8000000000001)), MV_NAN), "floor(NaN)"
  assert mv_ok(math.floor(mv_fb(0x3FF0000000000000)), 0x3FF0000000000000), "floor(1)"
  assert mv_ok(math.floor(mv_fb(0xBFF0000000000000)), 0xBFF0000000000000), "floor(-1)"
