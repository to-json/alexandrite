test "dim 33" {
  assert mv_ok(math.dim(mv_fb(0x0000000000000000), mv_fb(0x0000000000000000)), 0x0000000000000000), "dim(0, 0)"
  assert mv_ok(math.dim(mv_fb(0x0000000000000000), mv_fb(0x8000000000000000)), 0x0000000000000000), "dim(0, -0)"
  assert mv_ok(math.dim(mv_fb(0x0000000000000000), mv_fb(0x7FF0000000000000)), 0x0000000000000000), "dim(0, +Inf)"
  assert mv_ok(math.dim(mv_fb(0x0000000000000000), mv_fb(0xFFF0000000000000)), 0x7FF0000000000000), "dim(0, -Inf)"
  assert mv_ok(math.dim(mv_fb(0x0000000000000000), mv_fb(0x7FF8000000000001)), MV_NAN), "dim(0, NaN)"
  assert mv_ok(math.dim(mv_fb(0x0000000000000000), mv_fb(0x4004000000000000)), 0x0000000000000000), "dim(0, 2.5)"
  assert mv_ok(math.dim(mv_fb(0x0000000000000000), mv_fb(0xC008000000000000)), 0x4008000000000000), "dim(0, -3)"
  assert mv_ok(math.dim(mv_fb(0x0000000000000000), mv_fb(0x000012688B70E62B)), 0x0000000000000000), "dim(0, 1e-310)"
  assert mv_ok(math.dim(mv_fb(0x8000000000000000), mv_fb(0x0000000000000000)), 0x0000000000000000), "dim(-0, 0)"
  assert mv_ok(math.dim(mv_fb(0x8000000000000000), mv_fb(0x8000000000000000)), 0x0000000000000000), "dim(-0, -0)"
  assert mv_ok(math.dim(mv_fb(0x8000000000000000), mv_fb(0x7FF0000000000000)), 0x0000000000000000), "dim(-0, +Inf)"
  assert mv_ok(math.dim(mv_fb(0x8000000000000000), mv_fb(0xFFF0000000000000)), 0x7FF0000000000000), "dim(-0, -Inf)"
  assert mv_ok(math.dim(mv_fb(0x8000000000000000), mv_fb(0x7FF8000000000001)), MV_NAN), "dim(-0, NaN)"
  assert mv_ok(math.dim(mv_fb(0x8000000000000000), mv_fb(0x4004000000000000)), 0x0000000000000000), "dim(-0, 2.5)"
  assert mv_ok(math.dim(mv_fb(0x8000000000000000), mv_fb(0xC008000000000000)), 0x4008000000000000), "dim(-0, -3)"
  assert mv_ok(math.dim(mv_fb(0x8000000000000000), mv_fb(0x000012688B70E62B)), 0x0000000000000000), "dim(-0, 1e-310)"
  assert mv_ok(math.dim(mv_fb(0x7FF0000000000000), mv_fb(0x0000000000000000)), 0x7FF0000000000000), "dim(+Inf, 0)"
  assert mv_ok(math.dim(mv_fb(0x7FF0000000000000), mv_fb(0x8000000000000000)), 0x7FF0000000000000), "dim(+Inf, -0)"
  assert mv_ok(math.dim(mv_fb(0x7FF0000000000000), mv_fb(0x7FF0000000000000)), MV_NAN), "dim(+Inf, +Inf)"
  assert mv_ok(math.dim(mv_fb(0x7FF0000000000000), mv_fb(0xFFF0000000000000)), 0x7FF0000000000000), "dim(+Inf, -Inf)"
  assert mv_ok(math.dim(mv_fb(0x7FF0000000000000), mv_fb(0x7FF8000000000001)), MV_NAN), "dim(+Inf, NaN)"
  assert mv_ok(math.dim(mv_fb(0x7FF0000000000000), mv_fb(0x4004000000000000)), 0x7FF0000000000000), "dim(+Inf, 2.5)"
  assert mv_ok(math.dim(mv_fb(0x7FF0000000000000), mv_fb(0xC008000000000000)), 0x7FF0000000000000), "dim(+Inf, -3)"
  assert mv_ok(math.dim(mv_fb(0x7FF0000000000000), mv_fb(0x000012688B70E62B)), 0x7FF0000000000000), "dim(+Inf, 1e-310)"
  assert mv_ok(math.dim(mv_fb(0xFFF0000000000000), mv_fb(0x0000000000000000)), 0x0000000000000000), "dim(-Inf, 0)"
  assert mv_ok(math.dim(mv_fb(0xFFF0000000000000), mv_fb(0x8000000000000000)), 0x0000000000000000), "dim(-Inf, -0)"
  assert mv_ok(math.dim(mv_fb(0xFFF0000000000000), mv_fb(0x7FF0000000000000)), 0x0000000000000000), "dim(-Inf, +Inf)"
  assert mv_ok(math.dim(mv_fb(0xFFF0000000000000), mv_fb(0xFFF0000000000000)), MV_NAN), "dim(-Inf, -Inf)"
  assert mv_ok(math.dim(mv_fb(0xFFF0000000000000), mv_fb(0x7FF8000000000001)), MV_NAN), "dim(-Inf, NaN)"
  assert mv_ok(math.dim(mv_fb(0xFFF0000000000000), mv_fb(0x4004000000000000)), 0x0000000000000000), "dim(-Inf, 2.5)"
  assert mv_ok(math.dim(mv_fb(0xFFF0000000000000), mv_fb(0xC008000000000000)), 0x0000000000000000), "dim(-Inf, -3)"
  assert mv_ok(math.dim(mv_fb(0xFFF0000000000000), mv_fb(0x000012688B70E62B)), 0x0000000000000000), "dim(-Inf, 1e-310)"
  assert mv_ok(math.dim(mv_fb(0x7FF8000000000001), mv_fb(0x0000000000000000)), MV_NAN), "dim(NaN, 0)"
  assert mv_ok(math.dim(mv_fb(0x7FF8000000000001), mv_fb(0x8000000000000000)), MV_NAN), "dim(NaN, -0)"
