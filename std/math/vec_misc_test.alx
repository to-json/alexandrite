test "modf 18" {
  assert mv_ok(math.modf(mv_fb(0x0000000000000000))[0], 0x0000000000000000) && mv_ok(math.modf(mv_fb(0x0000000000000000))[1], 0x0000000000000000), "modf(0)"
  assert mv_ok(math.modf(mv_fb(0x8000000000000000))[0], 0x8000000000000000) && mv_ok(math.modf(mv_fb(0x8000000000000000))[1], 0x8000000000000000), "modf(-0)"
  assert mv_ok(math.modf(mv_fb(0x7FF0000000000000))[0], 0x7FF0000000000000) && mv_ok(math.modf(mv_fb(0x7FF0000000000000))[1], MV_NAN), "modf(+Inf)"
  assert mv_ok(math.modf(mv_fb(0xFFF0000000000000))[0], 0xFFF0000000000000) && mv_ok(math.modf(mv_fb(0xFFF0000000000000))[1], MV_NAN), "modf(-Inf)"
  assert mv_ok(math.modf(mv_fb(0x7FF8000000000001))[0], MV_NAN) && mv_ok(math.modf(mv_fb(0x7FF8000000000001))[1], MV_NAN), "modf(NaN)"
  assert mv_ok(math.modf(mv_fb(0x3FF0000000000000))[0], 0x3FF0000000000000) && mv_ok(math.modf(mv_fb(0x3FF0000000000000))[1], 0x0000000000000000), "modf(1)"
  assert mv_ok(math.modf(mv_fb(0xBFF0000000000000))[0], 0xBFF0000000000000) && mv_ok(math.modf(mv_fb(0xBFF0000000000000))[1], 0x8000000000000000), "modf(-1)"
  assert mv_ok(math.modf(mv_fb(0x3FE0000000000000))[0], 0x0000000000000000) && mv_ok(math.modf(mv_fb(0x3FE0000000000000))[1], 0x3FE0000000000000), "modf(0.5)"
  assert mv_ok(math.modf(mv_fb(0xBFE0000000000000))[0], 0x8000000000000000) && mv_ok(math.modf(mv_fb(0xBFE0000000000000))[1], 0xBFE0000000000000), "modf(-0.5)"
  assert mv_ok(math.modf(mv_fb(0x3FF8000000000000))[0], 0x3FF0000000000000) && mv_ok(math.modf(mv_fb(0x3FF8000000000000))[1], 0x3FE0000000000000), "modf(1.5)"
  assert mv_ok(math.modf(mv_fb(0xBFF8000000000000))[0], 0xBFF0000000000000) && mv_ok(math.modf(mv_fb(0xBFF8000000000000))[1], 0xBFE0000000000000), "modf(-1.5)"
  assert mv_ok(math.modf(mv_fb(0x4004000000000000))[0], 0x4000000000000000) && mv_ok(math.modf(mv_fb(0x4004000000000000))[1], 0x3FE0000000000000), "modf(2.5)"
  assert mv_ok(math.modf(mv_fb(0xC004000000000000))[0], 0xC000000000000000) && mv_ok(math.modf(mv_fb(0xC004000000000000))[1], 0xBFE0000000000000), "modf(-2.5)"
  assert mv_ok(math.modf(mv_fb(0x4008000000000000))[0], 0x4008000000000000) && mv_ok(math.modf(mv_fb(0x4008000000000000))[1], 0x0000000000000000), "modf(3)"
  assert mv_ok(math.modf(mv_fb(0xC008000000000000))[0], 0xC008000000000000) && mv_ok(math.modf(mv_fb(0xC008000000000000))[1], 0x8000000000000000), "modf(-3)"
  assert mv_ok(math.modf(mv_fb(0x3FDFFFFFFFFFFFFF))[0], 0x0000000000000000) && mv_ok(math.modf(mv_fb(0x3FDFFFFFFFFFFFFF))[1], 0x3FDFFFFFFFFFFFFF), "modf(0.49999999999999994)"
  assert mv_ok(math.modf(mv_fb(0xBFDFFFFFFFFFFFFF))[0], 0x8000000000000000) && mv_ok(math.modf(mv_fb(0xBFDFFFFFFFFFFFFF))[1], 0xBFDFFFFFFFFFFFFF), "modf(-0.49999999999999994)"
  assert mv_ok(math.modf(mv_fb(0x432FFFFFFFFFFFFF))[0], 0x432FFFFFFFFFFFFE) && mv_ok(math.modf(mv_fb(0x432FFFFFFFFFFFFF))[1], 0x3FE0000000000000), "modf(4.5035996273704955e+15)"
  assert mv_ok(math.modf(mv_fb(0x4330000000000000))[0], 0x4330000000000000) && mv_ok(math.modf(mv_fb(0x4330000000000000))[1], 0x0000000000000000), "modf(4.503599627370496e+15)"
  assert mv_ok(math.modf(mv_fb(0xC330000000000001))[0], 0xC330000000000001) && mv_ok(math.modf(mv_fb(0xC330000000000001))[1], 0x8000000000000000), "modf(-4.503599627370497e+15)"
  assert mv_ok(math.modf(mv_fb(0x4340000000000000))[0], 0x4340000000000000) && mv_ok(math.modf(mv_fb(0x4340000000000000))[1], 0x0000000000000000), "modf(9.007199254740992e+15)"
  assert mv_ok(math.modf(mv_fb(0x43D0000000000000))[0], 0x43D0000000000000) && mv_ok(math.modf(mv_fb(0x43D0000000000000))[1], 0x0000000000000000), "modf(4.611686018427388e+18)"
