test "max 34" {
  assert mv_ok(math.max(mv_fb(0x0000000000000000), mv_fb(0x0000000000000000)), 0x0000000000000000), "max(0, 0)"
  assert mv_ok(math.max(mv_fb(0x0000000000000000), mv_fb(0x8000000000000000)), 0x0000000000000000), "max(0, -0)"
  assert mv_ok(math.max(mv_fb(0x0000000000000000), mv_fb(0x7FF0000000000000)), 0x7FF0000000000000), "max(0, +Inf)"
  assert mv_ok(math.max(mv_fb(0x0000000000000000), mv_fb(0xFFF0000000000000)), 0x0000000000000000), "max(0, -Inf)"
