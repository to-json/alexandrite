  assert sp_lg(lgamma(sp_fb(0x0000000000000000)), 0x7FF0000000000000, 1), "lgamma(0)"
  assert sp_lg(lgamma(sp_fb(0x8000000000000000)), 0x7FF0000000000000, 1), "lgamma(-0)"
  assert sp_lg(lgamma(sp_fb(0x7FF0000000000000)), 0x7FF0000000000000, 1), "lgamma(+Inf)"
