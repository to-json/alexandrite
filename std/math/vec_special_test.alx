# Generated from Go's math (go1.27.1, GOOS=js GOARCH=wasm: the portable
# implementations, no FMA); do not edit by hand.

SP_NAN: U64 = 0x7FF8000000000001

def sp_fb(b: U64) -> Float { float64frombits(b) }

# Bit-exact; any NaN matches a NaN.
def sp_ok(got: Float, want: U64) -> Bool {
  return is_nan(got) if want == SP_NAN
  float64bits(got) == want
}

def sp_lg(got: (Float, Int), want: U64, sign: Int) -> Bool { sp_ok(got[0], want) && got[1] == sign }

test "cbrt 1" {
  assert sp_ok(cbrt(sp_fb(0x0000000000000000)), 0x0000000000000000), "cbrt(0)"
  assert sp_ok(cbrt(sp_fb(0x8000000000000000)), 0x8000000000000000), "cbrt(-0)"
  assert sp_ok(cbrt(sp_fb(0x7FF0000000000000)), 0x7FF0000000000000), "cbrt(+Inf)"
  assert sp_ok(cbrt(sp_fb(0xFFF0000000000000)), 0xFFF0000000000000), "cbrt(-Inf)"
  assert sp_ok(cbrt(sp_fb(0x7FF8000000000001)), SP_NAN), "cbrt(NaN)"
  assert sp_ok(cbrt(sp_fb(0x0000000000000001)), 0x2990000000000000), "cbrt(5e-324)"
  assert sp_ok(cbrt(sp_fb(0x8000000000000001)), 0xA990000000000000), "cbrt(-5e-324)"
  assert sp_ok(cbrt(sp_fb(0x000012688B70E62B)), 0x2A7A9D1B0B5D7427), "cbrt(1e-310)"
  assert sp_ok(cbrt(sp_fb(0x800012688B70E62B)), 0xAA7A9D1B0B5D7427), "cbrt(-1e-310)"
  assert sp_ok(cbrt(sp_fb(0x0010000000000000)), 0x2AA428A2F98D728B), "cbrt(2.2250738585072014e-308)"
  assert sp_ok(cbrt(sp_fb(0x8010000000000000)), 0xAAA428A2F98D728B), "cbrt(-2.2250738585072014e-308)"
  assert sp_ok(cbrt(sp_fb(0x7FEFFFFFFFFFFFFF)), 0x554428A2F98D728B), "cbrt(1.7976931348623157e+308)"
  assert sp_ok(cbrt(sp_fb(0xFFEFFFFFFFFFFFFF)), 0xD54428A2F98D728B), "cbrt(-1.7976931348623157e+308)"
  assert sp_ok(cbrt(sp_fb(0x3FF0000000000000)), 0x3FF0000000000000), "cbrt(1)"
  assert sp_ok(cbrt(sp_fb(0xBFF0000000000000)), 0xBFF0000000000000), "cbrt(-1)"
  assert sp_ok(cbrt(sp_fb(0x3FE0000000000000)), 0x3FE965FEA53D6E3C), "cbrt(0.5)"
  assert sp_ok(cbrt(sp_fb(0xBFE0000000000000)), 0xBFE965FEA53D6E3C), "cbrt(-0.5)"
  assert sp_ok(cbrt(sp_fb(0x4000000000000000)), 0x3FF428A2F98D728B), "cbrt(2)"
  assert sp_ok(cbrt(sp_fb(0xC000000000000000)), 0xBFF428A2F98D728B), "cbrt(-2)"
  assert sp_ok(cbrt(sp_fb(0x4008000000000000)), 0x3FF7137449123EF6), "cbrt(3)"
  assert sp_ok(cbrt(sp_fb(0x4024000000000000)), 0x40013C484138704F), "cbrt(10)"
  assert sp_ok(cbrt(sp_fb(0xC024000000000000)), 0xC0013C484138704F), "cbrt(-10)"
  assert sp_ok(cbrt(sp_fb(0x7E37E43C8800759C)), 0x54B249AD2594C37D), "cbrt(1e+300)"
  assert sp_ok(cbrt(sp_fb(0xFE37E43C8800759C)), 0xD4B249AD2594C37D), "cbrt(-1e+300)"
  assert sp_ok(cbrt(sp_fb(0x4020000000000000)), 0x4000000000000000), "cbrt(8)"
  assert sp_ok(cbrt(sp_fb(0x403B000000000000)), 0x4008000000000000), "cbrt(27)"
  assert sp_ok(cbrt(sp_fb(0x4050000000000000)), 0x4010000000000000), "cbrt(64)"
  assert sp_ok(cbrt(sp_fb(0x405F400000000000)), 0x4014000000000000), "cbrt(125)"
  assert sp_ok(cbrt(sp_fb(0x408F400000000000)), 0x4024000000000000), "cbrt(1000)"
  assert sp_ok(cbrt(sp_fb(0x01A56E1FC2F8F359)), 0x2B2BFF2EE48E0530), "cbrt(1e-300)"
  assert sp_ok(cbrt(sp_fb(0x00000000000007E8)), 0x29C94C7F15EF7DDF), "cbrt(1e-320)"
