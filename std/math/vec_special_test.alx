test "gamma 17" {
  assert sp_ok(gamma(sp_fb(0x0000000000000000)), 0x7FF0000000000000), "gamma(0)"
  assert sp_ok(gamma(sp_fb(0x8000000000000000)), 0xFFF0000000000000), "gamma(-0)"
  assert sp_ok(gamma(sp_fb(0x7FF0000000000000)), 0x7FF0000000000000), "gamma(+Inf)"
  assert sp_ok(gamma(sp_fb(0xFFF0000000000000)), SP_NAN), "gamma(-Inf)"
  assert sp_ok(gamma(sp_fb(0x7FF8000000000001)), SP_NAN), "gamma(NaN)"
  assert sp_ok(gamma(sp_fb(0x0000000000000001)), 0x7FF0000000000000), "gamma(5e-324)"
  assert sp_ok(gamma(sp_fb(0x8000000000000001)), 0xFFF0000000000000), "gamma(-5e-324)"
  assert sp_ok(gamma(sp_fb(0x000012688B70E62B)), 0x7FF0000000000000), "gamma(1e-310)"
  assert sp_ok(gamma(sp_fb(0x800012688B70E62B)), 0xFFF0000000000000), "gamma(-1e-310)"
  assert sp_ok(gamma(sp_fb(0x0010000000000000)), 0x7FD0000000000000), "gamma(2.2250738585072014e-308)"
  assert sp_ok(gamma(sp_fb(0x8010000000000000)), 0xFFD0000000000000), "gamma(-2.2250738585072014e-308)"
  assert sp_ok(gamma(sp_fb(0x7FEFFFFFFFFFFFFF)), 0x7FF0000000000000), "gamma(1.7976931348623157e+308)"
  assert sp_ok(gamma(sp_fb(0xFFEFFFFFFFFFFFFF)), SP_NAN), "gamma(-1.7976931348623157e+308)"
