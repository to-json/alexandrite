test "erfinv 11" {
  assert sp_ok(erfinv(sp_fb(0x0000000000000000)), 0x0000000000000000), "erfinv(0)"
  assert sp_ok(erfinv(sp_fb(0x8000000000000000)), 0x8000000000000000), "erfinv(-0)"
  assert sp_ok(erfinv(sp_fb(0x7FF0000000000000)), SP_NAN), "erfinv(+Inf)"
  assert sp_ok(erfinv(sp_fb(0xFFF0000000000000)), SP_NAN), "erfinv(-Inf)"
  assert sp_ok(erfinv(sp_fb(0x7FF8000000000001)), SP_NAN), "erfinv(NaN)"
  assert sp_ok(erfinv(sp_fb(0x0000000000000001)), 0x0000000000000001), "erfinv(5e-324)"
  assert sp_ok(erfinv(sp_fb(0x8000000000000001)), 0x8000000000000001), "erfinv(-5e-324)"
  assert sp_ok(erfinv(sp_fb(0x000012688B70E62B)), 0x00001050624D5CED), "erfinv(1e-310)"
  assert sp_ok(erfinv(sp_fb(0x800012688B70E62B)), 0x80001050624D5CED), "erfinv(-1e-310)"
  assert sp_ok(erfinv(sp_fb(0x0010000000000000)), 0x000E2DFC48DA77B6), "erfinv(2.2250738585072014e-308)"
  assert sp_ok(erfinv(sp_fb(0x8010000000000000)), 0x800E2DFC48DA77B6), "erfinv(-2.2250738585072014e-308)"
  assert sp_ok(erfinv(sp_fb(0x7FEFFFFFFFFFFFFF)), SP_NAN), "erfinv(1.7976931348623157e+308)"
  assert sp_ok(erfinv(sp_fb(0xFFEFFFFFFFFFFFFF)), SP_NAN), "erfinv(-1.7976931348623157e+308)"
  assert sp_ok(erfinv(sp_fb(0x3FF0000000000000)), 0x7FF0000000000000), "erfinv(1)"
  assert sp_ok(erfinv(sp_fb(0xBFF0000000000000)), 0xFFF0000000000000), "erfinv(-1)"
  assert sp_ok(erfinv(sp_fb(0x3FE0000000000000)), 0x3FDE861FBB24C00A), "erfinv(0.5)"
  assert sp_ok(erfinv(sp_fb(0xBFE0000000000000)), 0xBFDE861FBB24C00A), "erfinv(-0.5)"
  assert sp_ok(erfinv(sp_fb(0x4000000000000000)), SP_NAN), "erfinv(2)"
  assert sp_ok(erfinv(sp_fb(0xC000000000000000)), SP_NAN), "erfinv(-2)"
  assert sp_ok(erfinv(sp_fb(0x4008000000000000)), SP_NAN), "erfinv(3)"
  assert sp_ok(erfinv(sp_fb(0x4024000000000000)), SP_NAN), "erfinv(10)"
  assert sp_ok(erfinv(sp_fb(0xC024000000000000)), SP_NAN), "erfinv(-10)"
  assert sp_ok(erfinv(sp_fb(0x7E37E43C8800759C)), SP_NAN), "erfinv(1e+300)"
  assert sp_ok(erfinv(sp_fb(0xFE37E43C8800759C)), SP_NAN), "erfinv(-1e+300)"
  assert sp_ok(erfinv(sp_fb(0x3FEB333333333332)), 0x3FF04954184F8AA3), "erfinv(0.8499999999999999)"
  assert sp_ok(erfinv(sp_fb(0x3FEB333333333333)), 0x3FF04954184F8AA5), "erfinv(0.85)"
  assert sp_ok(erfinv(sp_fb(0x3FEB333333333334)), 0x3FF04954184F8AA5), "erfinv(0.8500000000000001)"
  assert sp_ok(erfinv(sp_fb(0x3FEFFFFFFFFC2EB8)), 0x4012D4D6642A7D22), "erfinv(0.999999999972224)"
  assert sp_ok(erfinv(sp_fb(0x3FEFFFFFFFFC2EB9)), 0x4012D4D6800D0C71), "erfinv(0.9999999999722241)"
  assert sp_ok(erfinv(sp_fb(0x3FEFFFFFFFFC2EBA)), 0x4012D4D69BEFA2E3), "erfinv(0.9999999999722242)"
  assert sp_ok(erfinv(sp_fb(0xBFEB333333333332)), 0xBFF04954184F8AA3), "erfinv(-0.8499999999999999)"
  assert sp_ok(erfinv(sp_fb(0xBFEB333333333333)), 0xBFF04954184F8AA5), "erfinv(-0.85)"
  assert sp_ok(erfinv(sp_fb(0xBFEB333333333334)), 0xBFF04954184F8AA5), "erfinv(-0.8500000000000001)"
  assert sp_ok(erfinv(sp_fb(0xBFEFFFFFFFFC2EB8)), 0xC012D4D6642A7D22), "erfinv(-0.999999999972224)"
  assert sp_ok(erfinv(sp_fb(0xBFEFFFFFFFFC2EB9)), 0xC012D4D6800D0C71), "erfinv(-0.9999999999722241)"
  assert sp_ok(erfinv(sp_fb(0xBFEFFFFFFFFC2EBA)), 0xC012D4D69BEFA2E3), "erfinv(-0.9999999999722242)"
  assert sp_ok(erfinv(sp_fb(0x3FECCCCCCCCCCCCD)), 0x3FF29C014677064F), "erfinv(0.9)"
  assert sp_ok(erfinv(sp_fb(0xBFECCCCCCCCCCCCD)), 0xBFF29C014677064F), "erfinv(-0.9)"
