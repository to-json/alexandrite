test "erf 5" {
  assert sp_ok(erf(sp_fb(0x0000000000000000)), 0x0000000000000000), "erf(0)"
  assert sp_ok(erf(sp_fb(0x8000000000000000)), 0x8000000000000000), "erf(-0)"
  assert sp_ok(erf(sp_fb(0x7FF0000000000000)), 0x3FF0000000000000), "erf(+Inf)"
  assert sp_ok(erf(sp_fb(0xFFF0000000000000)), 0xBFF0000000000000), "erf(-Inf)"
  assert sp_ok(erf(sp_fb(0x7FF8000000000001)), SP_NAN), "erf(NaN)"
  assert sp_ok(erf(sp_fb(0x0000000000000001)), 0x0000000000000001), "erf(5e-324)"
  assert sp_ok(erf(sp_fb(0x8000000000000001)), 0x8000000000000001), "erf(-5e-324)"
