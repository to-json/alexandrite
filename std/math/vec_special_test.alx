test "erfcinv 14" {
  assert sp_ok(erfcinv(sp_fb(0x0000000000000000)), 0x7FF0000000000000), "erfcinv(0)"
  assert sp_ok(erfcinv(sp_fb(0x8000000000000000)), 0x7FF0000000000000), "erfcinv(-0)"
  assert sp_ok(erfcinv(sp_fb(0x7FF0000000000000)), SP_NAN), "erfcinv(+Inf)"
  assert sp_ok(erfcinv(sp_fb(0xFFF0000000000000)), SP_NAN), "erfcinv(-Inf)"
  assert sp_ok(erfcinv(sp_fb(0x7FF8000000000001)), SP_NAN), "erfcinv(NaN)"
