test "erfc 8" {
  assert sp_ok(erfc(sp_fb(0x0000000000000000)), 0x3FF0000000000000), "erfc(0)"
  assert sp_ok(erfc(sp_fb(0x8000000000000000)), 0x3FF0000000000000), "erfc(-0)"
  assert sp_ok(erfc(sp_fb(0x7FF0000000000000)), 0x0000000000000000), "erfc(+Inf)"
  assert sp_ok(erfc(sp_fb(0xFFF0000000000000)), 0x4000000000000000), "erfc(-Inf)"
  assert sp_ok(erfc(sp_fb(0x7FF8000000000001)), SP_NAN), "erfc(NaN)"
  assert sp_ok(erfc(sp_fb(0x0000000000000001)), 0x3FF0000000000000), "erfc(5e-324)"
  assert sp_ok(erfc(sp_fb(0x8000000000000001)), 0x3FF0000000000000), "erfc(-5e-324)"
  assert sp_ok(erfc(sp_fb(0x000012688B70E62B)), 0x3FF0000000000000), "erfc(1e-310)"
  assert sp_ok(erfc(sp_fb(0x800012688B70E62B)), 0x3FF0000000000000), "erfc(-1e-310)"
  assert sp_ok(erfc(sp_fb(0x0010000000000000)), 0x3FF0000000000000), "erfc(2.2250738585072014e-308)"
  assert sp_ok(erfc(sp_fb(0x8010000000000000)), 0x3FF0000000000000), "erfc(-2.2250738585072014e-308)"
  assert sp_ok(erfc(sp_fb(0x7FEFFFFFFFFFFFFF)), 0x0000000000000000), "erfc(1.7976931348623157e+308)"
  assert sp_ok(erfc(sp_fb(0xFFEFFFFFFFFFFFFF)), 0x4000000000000000), "erfc(-1.7976931348623157e+308)"
  assert sp_ok(erfc(sp_fb(0x3FF0000000000000)), 0x3FC4226162FBDDD5), "erfc(1)"
  assert sp_ok(erfc(sp_fb(0xBFF0000000000000)), 0x3FFD7BB3D3A08445), "erfc(-1)"
  assert sp_ok(erfc(sp_fb(0x3FE0000000000000)), 0x3FDEB02147CE245C), "erfc(0.5)"
  assert sp_ok(erfc(sp_fb(0xBFE0000000000000)), 0x3FF853F7AE0C76E9), "erfc(-0.5)"
  assert sp_ok(erfc(sp_fb(0x4000000000000000)), 0x3F7328F5EC350E66), "erfc(2)"
  assert sp_ok(erfc(sp_fb(0xC000000000000000)), 0x3FFFECD70A13CAF2), "erfc(-2)"
  assert sp_ok(erfc(sp_fb(0x4008000000000000)), 0x3EF729DF65034229), "erfc(3)"
  assert sp_ok(erfc(sp_fb(0x4024000000000000)), 0x36A7D8A7F2A8A2D0), "erfc(10)"
  assert sp_ok(erfc(sp_fb(0xC024000000000000)), 0x4000000000000000), "erfc(-10)"
  assert sp_ok(erfc(sp_fb(0x7E37E43C8800759C)), 0x0000000000000000), "erfc(1e+300)"
  assert sp_ok(erfc(sp_fb(0xFE37E43C8800759C)), 0x4000000000000000), "erfc(-1e+300)"
  assert sp_ok(erfc(sp_fb(0x3FEAFFFFFFFFFFFF)), 0x3FCDCB8CAE2D7480), "erfc(0.8437499999999999)"
  assert sp_ok(erfc(sp_fb(0x3FEB000000000000)), 0x3FCDCB8CAE2D747E), "erfc(0.84375)"
  assert sp_ok(erfc(sp_fb(0x3FEB000000000001)), 0x3FCDCB8CAE2D747C), "erfc(0.8437500000000001)"
  assert sp_ok(erfc(sp_fb(0x3FF3FFFFFFFFFFFF)), 0x3FB3BCD133AA0FFF), "erfc(1.2499999999999998)"
  assert sp_ok(erfc(sp_fb(0x3FF4000000000000)), 0x3FB3BCD133AA0FFC), "erfc(1.25)"
  assert sp_ok(erfc(sp_fb(0x3FF4000000000001)), 0x3FB3BCD133AA0FF8), "erfc(1.2500000000000002)"
  assert sp_ok(erfc(sp_fb(0x4006DB6DB6DB6DB6)), 0x3F0BF37512335B03), "erfc(2.8571428571428568)"
  assert sp_ok(erfc(sp_fb(0x4006DB6DB6DB6DB7)), 0x3F0BF37512335AED), "erfc(2.857142857142857)"
  assert sp_ok(erfc(sp_fb(0x4006DB6DB6DB6DB8)), 0x3F0BF37512335AD8), "erfc(2.8571428571428577)"
  assert sp_ok(erfc(sp_fb(0x4017FFFFFFFFFFFF)), 0x3C78CF81557D2101), "erfc(5.999999999999999)"
  assert sp_ok(erfc(sp_fb(0x4018000000000000)), 0x3C78CF81557D20B5), "erfc(6)"
  assert sp_ok(erfc(sp_fb(0x4018000000000001)), 0x3C78CF81557D206A), "erfc(6.000000000000001)"
  assert sp_ok(erfc(sp_fb(0x403BFFFFFFFFFFFF)), 0x0000000000000000), "erfc(27.999999999999996)"
  assert sp_ok(erfc(sp_fb(0x403C000000000000)), 0x0000000000000000), "erfc(28)"
  assert sp_ok(erfc(sp_fb(0x403C000000000001)), 0x0000000000000000), "erfc(28.000000000000004)"
  assert sp_ok(erfc(sp_fb(0x3E2FFFFFFFFFFFFF)), 0x3FEFFFFFFDBE4516), "erfc(3.7252902984619136e-09)"
  assert sp_ok(erfc(sp_fb(0x3E30000000000000)), 0x3FEFFFFFFDBE4516), "erfc(3.725290298461914e-09)"
  assert sp_ok(erfc(sp_fb(0x3E30000000000001)), 0x3FEFFFFFFDBE4516), "erfc(3.725290298461915e-09)"
