  assert sp_ok(erf(sp_fb(0xFFEFFFFFFFFFFFFF)), 0xBFF0000000000000), "erf(-1.7976931348623157e+308)"
  assert sp_ok(erf(sp_fb(0x3FF0000000000000)), 0x3FEAF767A741088B), "erf(1)"
