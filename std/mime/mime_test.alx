# Go's mime tests (type_test.go, type_unix_test.go, mediatype_test.go,
# encodedword_test.go, example_test.go), translated.
import "strings"

# The bytes a hex string spells (for strings that aren't valid UTF-8).
def hx(h: Str) -> Str {
  out: [Byte] = []
  i = 0
  while i + 1 < h.size {
    out << (from_hex(h[i]) * 16 + from_hex(h[i + 1])).as_u8
    i += 2
  }
  Str.from_bytes(out)
}

def map_eq(a: Map[Str, Str], b: Map[Str, Str]) -> Bool {
  return false if a.size != b.size
  for k, v in a {
    w = b[k]
    return false if w.none? || (w || "") != v
  }
  true
}

# A Map from alternating keys and values.
def m(kv: [Str]) -> Map[Str, Str] {
  out: Map[Str, Str] = {}
  i = 0
  while i + 1 < kv.size {
    out[kv[i]] = kv[i + 1]
    i += 2
  }
  out
}

# parse_media_type's result as the vectors spell it: "type|k=v|k=v" (keys
# sorted), "ERR message" or "ERR message|type".
def pmt(s: Str) -> Str {
  r = parse_media_type(s)
  if r.err? {
    e = r.err.unwrap
    return case e {
      InvalidMediaParameter(mt) => "ERR #{e.message}|#{mt}"
      _ => "ERR #{e.message}"
    }
  }
  mt, params = r.unwrap
  keys: [Str] = []
  for k, _ in params {
    keys << k
  }
  out = mt
  for k in keys.sort {
    out = out + "|" + k + "=" + (params[k] || "")
  }
  out
}

# (decoded, error message) of WordDecoder.decode / decode_header.
def wd(s: Str) -> (Str, Str) {
  r = WordDecoder.new.decode(s)
  r.err? ? ("", r.err.unwrap.message) : (r.unwrap, "")
}

def wdh(s: Str) -> (Str, Str) {
  r = WordDecoder.new.decode_header(s)
  r.err? ? ("", r.err.unwrap.message) : (r.unwrap, "")
}

# ------------------------------------------------------------- type_test.go

# testdata/test.types and testdata/test.types.globs2.
TEST_TYPES = "# Copyright 2010 The Go Authors. All rights reserved.\n# Use of this source code is governed by a BSD-style\n# license that can be found in the LICENSE file.\n\n\n # mime package test\napplication/test\tt1\t# Simple test\ntext/test\t\tt2\t# Text test\n"
TEST_GLOBS = "# Copyright 2021 The Go Authors. All rights reserved.\n# Use of this source code is governed by a BSD-style\n# license that can be found in the LICENSE file.\n\n\n# mime package test for globs2\n50:document/test:*.t3\n50:example/test:*.t4\n50:text/plain:*,v\n50:application/x-trash:*~\n30:example/do-not-use:*.t4\n10:example/glob-question-mark:*.foo?ar\n10:example/glob-asterisk:*.foo*r\n10:example/glob-range:*.foo[1-3]\n"

def set_type(t: Types, ext: Str, typ: Str) -> Types {
  out = t
  out.add_extension_type!(ext, typ).unwrap
  out
}

test "type by extension" {
  # initMimeForTests on Unix: no globs file, testdata/test.types.
  t = builtin_types
  t.load_mime_types!(TEST_TYPES)
  tests = [(".T1", "application/test"), (".t2", "text/test; charset=utf-8"), (".png", "image/png")]
  for tt in tests {
    assert_eq t.type_by_extension(tt[0]), tt[1]
  }
}

test "type by extension: package functions use the builtin table" {
  assert_eq type_by_extension(".png"), "image/png"
  assert_eq type_by_extension(".HTML"), "text/html; charset=utf-8"
  assert_eq type_by_extension(".T1"), ""
  assert_eq type_by_extension(".jpg"), "image/jpeg"
  assert_eq type_by_extension(".JpG"), "image/jpeg"
  assert_eq type_by_extension(".ÄÖ"), ""
  assert_eq type_by_extension(""), ""
  assert_eq extensions_by_type("text/html").unwrap, [".ehtml", ".htm", ".html", ".shtml"]
  assert_eq extensions_by_type("x/unknown").unwrap.size, 0
  assert extensions_by_type("bogus/<script>").err?
}

test "type by extension: local data" {
  t = new_types
  t = set_type(t, ".foo", "x/foo")
  t = set_type(t, ".bar", "x/bar")
  t = set_type(t, ".Bar", "x/bar; capital=1")
  tests = [(".foo", "x/foo"), (".bar", "x/bar"), (".Bar", "x/bar; capital=1"), (".sdlkfjskdlfj", ""), (".t1", "")]
  for tt in tests {
    assert_eq t.type_by_extension(tt[0]), tt[1]
  }
}

test "type by extension case" {
  custom = "test/test; charset=iso-8859-1"
  caps = "test/test; WAS=ALLCAPS"
  t = new_types
  t = set_type(t, ".TEST", caps)
  t = set_type(t, ".tesT", custom)
  # case-sensitive lookup
  assert_eq t.type_by_extension(".tesT"), custom
  assert_eq t.type_by_extension(".TEST"), caps
  # case-insensitive
  assert_eq t.type_by_extension(".TesT"), custom
}

test "add extension type: text MIME with params gets the default charset" {
  t = new_types
  ~t.add_extension_type!(".regtxt", "text/x-reg; myparam=myvalue")
  got = t.type_by_extension(".regtxt")
  assert got != ""
  assert strings.contains(got, "charset=utf-8"), got
  assert strings.has_prefix(got, "text/x-reg"), got
  r = t.add_extension_type!("regtxt", "text/plain")
  assert_eq r.err.unwrap.message, "mime: extension \"regtxt\" missing leading dot"
}

test "extensions by type" {
  t = new_types
  t = set_type(t, ".gif", "image/gif")
  t = set_type(t, ".a", "foo/letter")
  t = set_type(t, ".b", "foo/letter")
  t = set_type(t, ".B", "foo/letter")
  t = set_type(t, ".PNG", "image/png")
  assert_eq t.extensions_by_type("image/gif").unwrap, [".gif"]
  assert_eq t.extensions_by_type("image/png").unwrap, [".png"] # lowercase
  assert_eq t.extensions_by_type("foo/letter").unwrap, [".a", ".b"]
  assert_eq t.extensions_by_type("x/unknown").unwrap.size, 0
}

