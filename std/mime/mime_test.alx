test "type by extension unix" {
  # initMimeUnixTest: the builtin table, testdata/test.types.globs2, then
  # testdata/test.types.
  t = builtin_types
  t.load_mime_globs!(TEST_GLOBS)
  t.load_mime_types!(TEST_TYPES)
  tests = [(".T1", "application/test"), (".t2", "text/test; charset=utf-8"), (".t3", "document/test"), (".t4", "example/test"), (".png", "image/png"), (",v", ""), ("~", ""), (".foo?ar", ""), (".foo*r", ""), (".foo[1-3]", "")]
  for tt in tests {
    assert_eq t.type_by_extension(tt[0]), tt[1]
  }
}

test "system types" {
  t = system_types
  assert_eq t.type_by_extension(".png"), "image/png"
}

