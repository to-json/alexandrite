  assert_eq parse_render("-a'()+_,-./:=?b\r\nX-Lower: text/plain\r\nX-Lower: quoted-printable\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{} form= file= body=<hello world>\n{} form= file= body=<\r>"
  assert_eq parse_render("\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space--\r\nepilogue\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=f\"q file=field body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=f\"q file=é body=<\n>"
  assert_eq parse_render("--with space \t\r\n\r\n\r\n--with space\r\nContent-Disposition: QUOTED-PRINTABLE\r\nX-A: form-data; name=\"k\"\r\n\r\nline1\r\nline2\r\n--with space--\r\n", "with space", true), "{} form= file= body=<>\n{Content-Disposition=[QUOTED-PRINTABLE];X-A=[form-data; name=\"k\"]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("\r\n-0123456789-\r\n", "0123456789", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B--\r\n", "B", true), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=back\\slash file=field body=<=3D>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--B\r\nContent-Type: quoted-printable\r\nContent-Type: QUOTED-PRINTABLE\r\n\r\n--B\r\n--B--\r\n", "B", true), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=x y file=a body=<\n>\n{Content-Type=[quoted-printable|QUOTED-PRINTABLE]} form= file= body=<>\nERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render("--with spa", "with space", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--a'()", "a'()+_,-./:=?b", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n=3D\r\n--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nline1\r\nline2\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=x y file=a body=<hello world>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<=3D>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<line1\r\nline2>"
  assert_eq parse_render("\r\n--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=field file=field body=<>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B\r\n--0123456789\r\nContent", "0123456789", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<--B>\nERR malformed MIME header: missing colon: \"Content\""
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; n", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("preamble\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=x y file=n%0D%0Al body=<>\nERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render("-with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=field file=f\"q body=<=3D>"
  assert_eq parse_render(" \t\r\n--B\r\n", "B", false), ""
  assert_eq parse_render("\r\n\r\n--MyBoundary--\r\n", "MyBoundary", false), ""
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=n%0D%0Al body=<v>"
  assert_eq parse_render("preamble\r\n--0123456789\r\nContent-Disposition: quoted-printable\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n=3D\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--0123456789--\r\nepilogue\r\n", "0123456789", false), "{Content-Disposition=[quoted-printable]} form= file= body=<hello world>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<=3D>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=back\\slash file=x y body=<é ü>"
}

test "vectors: parse 7" {
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\né ü\r\n--a'()+_,-./:=?b\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Type: v\r\nX-A: v\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<é ü>\n{} form= file= body=<\r\n--B>\n{Content-Type=[v];X-A=[v]} form= file= body=<\n>"
  assert_eq parse_render("\r\n\r\n--with space--\r\nepilogue\r\n", "with space", false), ""
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"a\"\r\nConten", "with space", false), "ERR malformed MIME header: missing colon: \"Conten\""
  assert_eq parse_render(" \t\r\n--a'()+_,-./:=?b", "a'()+_,-./:=?b", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--B\r\nContent-Transfer-Encoding: form-data; name=k; filename=\"a/b.txt\"\r\nX-A: v\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"é\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--B--\r\nepilogue\r\n", "B", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=f\"q body=<hello world>\n{Content-Transfer-Encoding=[form-data; name=k; filename=\"a/b.txt\"];X-A=[v]} form= file= body=<v>\n{Content-Disposition=[form-data; name=\"é\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=é file=é body=<\n>"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=é file=x y body=<\r>"
  assert_eq parse_render("\r\n--MyBoundary\r\n\r\nhello world\r\n--MyBoundary\r\nX-A: quoted-printable\r\nX-Lower: text/plain\r\n\r\nv\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\né ü\r\n--MyBoundary\r\n", "MyBoundary", false), "{} form= file= body=<hello world>\n{X-A=[quoted-printable];X-Lower=[text/plain]} form= file= body=<v>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<é ü>"
  assert_eq parse_render(" \t\r\n--with space--\r\n", "with space", false), ""
  assert_eq parse_render("\r\n--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: quoted-printable\r\n\r\n\r\n--0123456789\r\n", "0123456789", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<hello world>\n{Content-Disposition=[quoted-printable]} form= file= body=<>"
  assert_eq parse_render("-a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form= file=x y body=<\r\n--B>"
  assert_eq parse_render("--with space\r\nX-Lower: \r\n\r\n", "with space", false), "{X-Lower=[]} form= file= body=<> UEOF"
  assert_eq parse_render("-MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n--B--\r\n--MyBoundary--\r\n", "MyBoundary", true), ""
  assert_eq parse_render("", "B", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render(" \t\r\n--with space \t\r\nContent-Disposition: form-data; name=\"a\" \t\r\n\r\nhello world\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\né ü\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<hello world>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<é ü>"
  assert_eq parse_render(" \t\r\n--0123456789--\r\nepilogue\r\n", "0123456789", false), ""
  assert_eq parse_render("--B\r\nX-A: form-data; name=\"k\"\r\n\r\nhello world\r\n--B\r\nContent-Transfer-Encoding: 7bit\r\nX-A: text/plain\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B--\r\n", "B", false), "{X-A=[form-data; name=\"k\"]} form= file= body=<hello world>\n{Content-Transfer-Encoding=[7bit];X-A=[text/plain]} form= file= body=<>\nERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("\r\n-0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B--\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--B\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<--B-->\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<\r\n--B>"
  assert_eq parse_render("\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<=3D>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<\r>"
  assert_eq parse_render("--0123456789 \t\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"x y\" \t\r\nContent-Type: application/octet-stream \t\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nv\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=f\"q file=x y body=<--B>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<v>"
  assert_eq parse_render("--with space \t\r\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=field file=a body=<>"
  assert_eq parse_render("\r\n-a'()+_,-./:=?b--\r\nepilogue\r\n", "a'()+_,-./:=?b", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--MyBoundary \t\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"a\" \t\r\nContent-Type: application/octet-stream \t\r\n\r\nv\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=back\\slash file=a body=<v>"
  assert_eq parse_render("--with space\r\n\r\nhello world\r\n--with space--\r\nepilogue\r\n", "with space", true), "{} form= file= body=<hello world>"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\r\n--with space\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<\r>\n{} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=f\"q file=x y body=<line1\r\nline2>"
  assert_eq parse_render("-B\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n=3D\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<=3D>"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{} form= file= body=<v>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<--B-->\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<line1\r\nline2>"
  assert_eq parse_render("--0123456789\r\n\r\n\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"é\"\r\nContent-Type: applicatioepilogue\r\n", "0123456789", false), "{} form= file= body=<\n>"
  assert_eq parse_render("\r\n", "a'()+_,-./:=?b", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\n--MyBoundary\nContent-Disposition: form-data; name=\"n%0D%0Al\"\n\nv\n--MyBoundary\nContent-Disposition: form-data; name=\"f\\\"q\"\n\n\n--B\n--MyBoundary--\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<v>\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<\n--B>"
  assert_eq parse_render("\r\n--0123456789\r\n\r\nline1\r\nline2\r\n--0123456789--\r\nepilogue\r\n", "0123456789", true), "{} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{} form= file= body=<--B>\n{} form= file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form= file=n%0D%0Al body=<line1\r\nline2>"
  assert_eq parse_render("--0123456789 \t\r\nContent-Disposition: form-data; name=\"back\\\\slash\" \t\r\n \t\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--0123456789--\r\n", "0123456789", false), "ERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("\r\n--0123456789\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"é\"];Content-Type=[application/octet-stream]} form= file=é body=<é ü>"
  assert_eq parse_render("preamble\r\n-with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B--\r\n--with space--\r\n", "with space", false), ""
  assert_eq parse_render("\r\n--MyBoundary\r\nX-A: 7bit\r\n\r\n--B\r\n--MyBoundary\r\nContent-Transfer-Encoding: \r\nContent-Type: 7bit\r\n\r\n\n\r\n--MyBoundary\r\nX-A: QUOTED-PRINTABLE\r\n\r\né ü\r\n--MyBoundary--\r\n", "MyBoundary", false), "{X-A=[7bit]} form= file= body=<--B>\n{Content-Transfer-Encoding=[];Content-Type=[7bit]} form= file= body=<\n>\n{X-A=[QUOTED-PRINTABLE]} form= file= body=<é ü>"
  assert_eq parse_render("preamble\r\n--MyBoundary \t\r\nContent-Disposition: form-data; name=\"é\" \t\r\n\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<\r\n--B>"
  assert_eq parse_render("\r\n--MyBoundary--\r", "MyBoundary", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--0123456789\r\n", "0123456789", true), "{Content-Disposition=[form-data; name=\"é\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=é file=x y body=<é ü>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--MyBoundary\r\n\r\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file= body=<--B>\n{} form= file= body=<>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=x y file=x y body=<line1\r\nline2>"
  assert_eq parse_render("--with space\r\nContent-Type: \r\n\r\n\r\n--B\r\n--with space\r\n", "with space", false), "{Content-Type=[]} form= file= body=<\r\n--B>"
  assert_eq parse_render("--0123456789\r\nX-A: quoted-printable\r\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\r\n\r\nline1\r\nline2\r\n--0123456789\r\n", "0123456789", false), "{X-A=[quoted-printable];X-Lower=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("--B\nContent-Disposition: form-data; name=\"x y\"\n\né ü\n--B\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\nContent-Type: application/octet-stream\n\né ü\n--B\nContent-Disposition: form-data; name=\"x y\"; filename=\"field\"\nContent-Type: application/octet-stream\n\n\n--B\n--B--\n", "B", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<é ü>\n{Content-Disposition=[form-data; name=\"a\"; filename=\"\"];Content-Type=[application/octet-stream]} form=a file= body=<é ü>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=x y file=field body=<>\nERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render(" \t\r\n--0123456789-- \t\r\n", "0123456789", false), ""
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{} form= file= body=<\r>\n{Content-Disposition=[form-data; name=\"a\"; filename=\"\"];Content-Type=[application/octet-stream]} form=a file= body=<--B-->"
  assert_eq parse_render("--0123456789\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\nContent-Type: application/octet-stream\n\n\n--B\n--0123456789\nContent-Disposition: form-data; name=\"\"; filename=\"x y\"\nContent-Type: application/octet-stream\n\né ü\n--0123456789--\n", "0123456789", true), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=f\"q file=field body=<\n--B>\n{Content-Disposition=[form-data; name=\"\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form= file=x y body=<é ü>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"a\"];Content-Type=[application/octet-stream]} form= file=a body=<>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--B--\r", "B", true), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<>\nERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\nX-A: quoted-printable\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{X-A=[quoted-printable]} form= file= body=<\n>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"", "B", false), ""
  assert_eq parse_render("--0123456789 \t\r\nContent-Disposition: form-data; name=\"a\" \t\r\n \t\r\nv\r\n--0123456789\r\n\r\n\r\n--B\r\n--0123456789--\r\n", "0123456789", false), "ERR malformed MIME header: missing colon: \"v\""
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nline1\r\nline2\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=back\\slash file=a body=<\r\n--B>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=field file=f\"q body=<>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<hello world>\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=f\"q file=back\\slash body=<>"
  assert_eq parse_render("--MyBoundary \t\r\nContent-Disposition: form-data; name=\"field\"; filename=\"x y\" \t\r\nContent-Type: application/octet-stream \t\r\n\r\n--B--\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=field file=x y body=<--B-->"
  assert_eq parse_render("preamble\r\n--MyBoundary\r\n\r\nline1\r\nline2\r\n--MyBoundary--", "MyBoundary", false), "{} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("\r\n--with space\r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\nX-Lower: text/plain\r\n\r\n=3D\r\n--with space--\r\n", "with space", false), "{Content-Transfer-Encoding=[form-data; name=\"k\"];X-Lower=[text/plain]} form= file= body=<=3D>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nX-A: text/plain\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"\"];Content-Type=[application/octet-stream]} form=x y file= body=<line1\r\nline2>\n{X-A=[text/plain]} form= file= body=<--B-->"
  assert_eq parse_render("-B\r\nContent-Disposition: form-data; name=\"\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--B--\r\n", "B", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file= body=<hello world>"
  assert_eq parse_render("--0123456789\r\nContent-Type: 7bit\r\n\r\nv\r\n--0123456789--\r\n", "0123456789", false), "{Content-Type=[7bit]} form= file= body=<v>"
  assert_eq parse_render("--with space\r\nContent-Disposition: quoted-printable\r\n\r\nv\r\n--with space\r\n\r\nv\r\n--with space\r\n\r\nhello world\r\n--with space\r\n", "with space", false), "{Content-Disposition=[quoted-printable]} form= file= body=<v>\n{} form= file= body=<v>\n{} form= file= body=<hello world>"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: quoted-printable\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<v>\n{Content-Transfer-Encoding=[quoted-printable|QUOTED-PRINTABLE]} form= file= body=<\r>"
  assert_eq parse_render("\r\n--with space\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\n\r\n=3D\r\n--with space--\r\n", "with space", false), "{} form= file= body=<=>"
  assert_eq parse_render("\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--with space\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=field body=<hello world>"
  assert_eq parse_render("\r\n--with space\r\nContent-Transfer-Encoding: text/plain\r\nX-A: 7bit\r\n\r", "with space", false), "ERR malformed MIME header: missing colon: \"\\r\""
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nv\r\n--MyBoundary\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\nepilogue\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<v>\n{} form= file= body=<--B>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=n%0D%0Al body=<line1\r\nline2>"
  assert_eq parse_render("\r\n--a'()+_,-./", "a'()+_,-./:=?b", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--B\r\nX-A: \r\n\r\n=3D\r\n--B\r\n", "B", false), "{X-A=[]} form= file= body=<=3D>"
  assert_eq parse_render("-B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=field file=n%0D%0Al body=<>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nline1\r\nline2\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n=3D\r\n--B--\r\nepilogue\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<=3D>"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"\" \t\r\nContent-Type: application/octet-stream \t\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"\"];Content-Type=[application/octet-stream]} form=f\"q file= body=<\r\n--B>"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n=3D\r\n--with space--\r\nepilogue\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<=3D>"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space--\r\nepilogue\r\n", "with space", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=field body=<é ü>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=f\"q body=<--B-->"
  assert_eq parse_render("\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\r\n--0123456789\r\nContent-Disposition: text/plain\r\nX-A: form-data", "0123456789", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"\"];Content-Type=[application/octet-stream]} form=x y file= body=<\r\n--B>\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<\r>"
  assert_eq parse_render("-MyBoundary \t\r\nContent-Disposition: form-data; name=\"x y\" \t\r\n \t\r\n=3D\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--MyBoundary--\r\n", "MyBoundary", true), "{Content-Disposition=[form-data; name=\"a\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=a file=back\\slash body=<\r>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--MyBoundary--\r\nepilogue\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=field file=back\\slash body=<=3D>"
  assert_eq parse_render("-a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\né ü\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<é ü>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=a body=<>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nv\r\n--a'()+_,-./:=?b\r\n\r\n\n\r\n--a'()", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<v>\n{} form= file= body=<\n> UEOF"
  assert_eq parse_render("--B\n\né ü\n--B--\n", "B", false), "{} form= file= body=<é ü>"
  assert_eq parse_render("--a'", "a'()+_,-./:=?b", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render(" \t\r\n--with space-- \t\r\n", "with space", true), ""
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=back\\slash body=<\r>"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<> UEOF"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\n \t\r\nhello world \t\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "ERR malformed MIME header initial line: \" \\t\""
  assert_eq parse_render("--B\r\nX-Lower: attac", "B", true), ""
  assert_eq parse_render("\r\n--B \t\r\nContent-Disposition: QUOTED-PRINTABLE \t\r\n \t\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--B--\r\n", "B", false), "{Content-Disposition=[QUOTED-PRINTABLE ]} form= file= body=<>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=x y file=é body=<\n>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\nepilogue\r\nepilogue\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form= file=back\\slash body=<\n>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<--B-->"
  assert_eq parse_render("--B\nContent-Disposition: form-data; name=\"n%0D%0Al\"\n\n\n--B\nX-A: form-data; name=\"k\"\nX-Lower: v\n\n--B\n--B--\n", "B", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<>\n{X-A=[form-data; name=\"k\"];X-Lower=[v]} form= file= body=<>\nERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\nepilogue\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<--B>"
}

test "vectors: read form 0" {
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\n\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", 1), "V a=[line1\r\nline2]\nF x y=x y 11 <hello world> {Content-Disposition=[form-data; name=\"x y\"; filename=\"x y\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1048576), ""
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1048576), "F f\"q=x y 5 <\r\n--B> {Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"x y\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("preamble\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", 1048576), "V é=[\r\n--B]"
  assert_eq read_form_render("--MyBoundary\r\nX-A: v\r\nX-Lower: \r\n\r\n\r\n--MyBoundary--\r\n", "MyBoundary", 1048576), ""
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n", "MyBoundary", 1048576), ""
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: text/plain\r\nContent-Type: attachment; filename=f.bin\r\n\r\n--B--\r\n--0123456789--\r\n", "0123456789", 5), "V back\\slash=[hello world]"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--B--\r\n", "B", 1), "V n%0D%0Al=[line1\r\nline2]"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\r\n--B\r\nContent-Transfer-Encoding: form-data; name=k; filename=\"a/b.txt\"\r\nX-Lower: \r\n\r\n\n\r\n--B--\r\n", "B", 1048576), "V back\\slash=[\r]\nF field=a 1 <v> {Content-Disposition=[form-data; name=\"field\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nv\r\n--MyBoundary--\r\n", "MyBoundary", 1048576), "V f\"q=[v]"
  assert_eq read_form_render("\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--with space--\r\n", "with space", 0), "V n%0D%0Al=[]"
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n--B\r\n--0123456789--\r\n", "0123456789", 0), "V a=[--B]"
  assert_eq read_form_render("--0123456789\r\nX-Lower: v\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\né ü\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\né ü\r\n--0123456789--\r\n", "0123456789", 0), "V back\\slash=[é ü|é ü]"
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nv\r\n--0123456789--\r\n", "0123456789", 1048576), "V f\"q=[v]\nF field=field 3 <=3D> {Content-Disposition=[form-data; name=\"field\"; filename=\"field\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("\r\n--with space--\r\n", "with space", 0), ""
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--B--\r\n", "B", 1048576), "F f\"q=a 5 <é ü> {Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--with space--\r\n", "with space", 0), "F field=a 5 <--B--> {Content-Disposition=[form-data; name=\"field\"; filename=\"a\"];Content-Type=[application/octet-stream]}\nF n%0D%0Al=field 3 <--B> {Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"field\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--with space\r\n\r\né ü\r\n--with space--\r\n", "with space", 0), ""
  assert_eq read_form_render("\r\n--with space--\r\n", "with space", 1), ""
