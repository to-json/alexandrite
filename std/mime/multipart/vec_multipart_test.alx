  assert_eq read_form_render("\r\n--MyBoundary--\r\n", "MyBoundary", 1), ""
  assert_eq read_form_render("-MyBoundary\r\n\r\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\né ü\r\n--MyBoundary--\r\n", "MyBoundary", 1), "V n%0D%0Al=[é ü]"
  assert_eq read_form_render("--with space\r\nX-Lower: QUOTED-PRINTABLE\r\n\r\n\r\r\n--with space--\r\n", "with space", 0), ""
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\né ü\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), "V back\\slash=[é ü]\nV f\"q=[\r\n--B]\nV field=[]"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1048576), "V n%0D%0Al=[\n]"
  assert_eq read_form_render("--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--with space\r\nContent-Type: form-data; name=\"k\"\r\n\r\n\r\n--with space--\r\n", "with space", 5), "F a=é 3 <=3D> {Content-Disposition=[form-data; name=\"a\"; filename=\"é\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--B\r\n--MyBoundary\r\nContent-Transfer-Encoding: form-data; name=k; filename=\"a/b.txt\"\r\nContent-Type: form-data; name=\"k\"\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", 5), "V field=[\r\n--B]"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\nX-Lower: form-data; name=\"k\"\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1), "F field=back\\slash 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"field\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--B\r\nX-Lower: QUOTED-PRINTABLE\r\n\r\né ü\r\n--B--\r\n", "B", 1048576), "F x y=f\"q 5 <é ü> {Content-Disposition=[form-data; name=\"x y\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--0123456789\r\nContent-Transfer-Encoding: form-data; name=k; filename=\"a/b.txt\"\r\nX-Lower: 7bit\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789\r\nContent-Type: v\r\n\r\né ü\r\n--0123456789--\r\n", "0123456789", 5), "F é=a 3 <=3D> {Content-Disposition=[form-data; name=\"é\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), ""
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n--B\r\n--0123456789--\r\n", "0123456789", 1048576), "V f\"q=[--B]"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 5), "F x y=f\"q 1 <v> {Content-Disposition=[form-data; name=\"x y\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--MyBoundary\r\n\r\nv\r\n--MyBoundary--\r\n", "MyBoundary", 0), "F a=a 1 <\r> {Content-Disposition=[form-data; name=\"a\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("\r\n--MyBoundary--\r\n", "MyBoundary", 1048576), ""
  assert_eq read_form_render("--with space\r\nContent-Type: quoted-printable\r\nContent-Type: text/plain\r\n\r\nhello world\r\n--with space--\r\n", "with space", 5), ""
}

test "vectors: read form 1" {
  assert_eq read_form_render("--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nv\r\n--with space--\r\n", "with space", 0), "V x y=[v]"
  assert_eq read_form_render(" \t\r\n--with space-- \t\r\n", "with space", 0), ""
  assert_eq read_form_render("\r\n--0123456789--\r\n", "0123456789", 5), ""
  assert_eq read_form_render("preamble\r\n--with space\r\nContent-Type: form-data; name=\"k\"\r\n\r\né ü\r\n--with space--\r\n", "with space", 1), ""
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--0123456789\r\n", "0123456789", 1048576), "F n%0D%0Al=field 5 <\r\n--B> {Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"field\"];Content-Type=[application/octet-stream]}\nF é=n%0D%0Al 5 <--B--> {Content-Disposition=[form-data; name=\"é\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--with space\r\n\r\nhello world\r\n--with space--\r\n", "with space", 5), ""
  assert_eq read_form_render("--with space\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space\r\nX-Lower: form-data; name=\"k\"\r\n\r\nv\r\n--with space--\r\n", "with space", 0), "V é=[--B]\nF x y=field 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"x y\"; filename=\"field\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("\r\n--with space\r\nContent-Transfer-Encoding: text/plain\r\nX-Lower: v\r\n\r\né ü\r\n--with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\n\r\n--with space--\r\n", "with space", 1), ""
  assert_eq read_form_render("--a'()+_,-./:=?b\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), "F back\\slash=n%0D%0Al 1 <\r> {Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]}\nF field=a 5 <--B--> {Content-Disposition=[form-data; name=\"field\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("\r", "B", 5), "ERR multipart: NextPart: EOF"
  assert_eq read_form_render("preamble\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: text/plain\r\nX-A: QUOTED-PRINTABLE\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: v\r\n\r\né ü\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), ""
  assert_eq read_form_render("--0123456789 \t\r\nContent-Disposition: form-data; name=\"field\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--B\r\n--0123456789--\r\n", "0123456789", 1), "V a=[\r\n--B]\nF field=n%0D%0Al 3 <--B> {Content-Disposition=[form-data; name=\"field\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1048576), "V x y=[hello world]"
  assert_eq read_form_render("--MyBoundary\r\nContent-Type: 7bit\r\n\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--MyBoundary--\r\n", "MyBoundary", 5), ""
  assert_eq read_form_render("preamble\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n--B--\r\n--0123456789--\r\n", "0123456789", 5), "V f\"q=[--B--]\nF field=x y 1 <\n> {Content-Disposition=[form-data; name=\"field\"; filename=\"x y\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("\r\n-MyBoundary--\r\n", "MyBoundary", 0), "ERR multipart: NextPart: EOF"
  assert_eq read_form_render(" \t\r\n--a'()+_,-./:=?b-- \t\r\n", "a'()+_,-./:=?b", 1), ""
  assert_eq read_form_render("--0123456789\r\nX-Lower: v\r\n\r\n\n\r\n--0123456789\r\nContent-Transfer-Encoding: 7bit\r\nContent-Transfer-Encoding: attachment; filename=f.bin\r\n\r\n=3D\r\n--0123456789--\r\n", "0123456789", 5), ""
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--MyBoundary\r\nX-Lower: attachment; filename=f.bin\r\n\r\nhello world\r\n--MyBoundary\r\n\r\n\r\n--MyBoundary--\r\n", "MyBoundary", 0), "V é=[é ü]"
  assert_eq read_form_render("\r\n--0123456789\r\n", "0123456789", 0), ""
  assert_eq read_form_render("\r\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), ""
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--0123456789--\r\n", "0123456789", 1), "V field=[--B--]\nF field=n%0D%0Al 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"field\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]}\nF n%0D%0Al=a 3 <=3D> {Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: v\r\nX-A: \r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--MyBoundary--\r\n", "MyBoundary", 0), "F field=f\"q 1 <v> {Content-Disposition=[form-data; name=\"field\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--B \t\r\nContent-Disposition: form-data; name=\"a\"; filename=\"field\" \t\r\nContent-Type: application/octet-stream \t\r\n\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n=3D\r\n--B--\r\n", "B", 1048576), "ERR malformed MIME header: missing colon: \"--B\""
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\né ü\r\n--0123456789--\r\n", "0123456789", 0), ""
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B--\r\n--B\r\n", "B", 5), "V n%0D%0Al=[]"
  assert_eq read_form_render("--0123456789\r\nContent-Type: text/plain\r\nX-Lower: attachment; filename=f.bin\r\n\r\n--B\r\n--0123456789\r\n\r\nv\r\n--0123456789--\r\n", "0123456789", 5), ""
  assert_eq read_form_render("--0123456789 \t\r\nContent-Type: attachment; filename=f.bin\r\nX-Lower: 7bit\r\n\r\nline1\r\nline2\r\n--0123456789--\r\n", "0123456789", 5), ""
  assert_eq read_form_render("\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--with space--\r\n", "with space", 0), "V x y=[\r]\nF a=a 5 <\r\n--B> {Content-Disposition=[form-data; name=\"a\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--with space\r\nContent-Disposition: \r\n\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n--B\r\n--with space--\r\n", "with space", 5), "V x y=[--B]"
  assert_eq read_form_render("--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Transfer-Encoding: v\r\n\r\nv\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space--\r\n", "with space", 0), "V n%0D%0Al=[line1\r\nline2]\nF back\\slash=back\\slash 5 <--B--> {Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--with space--\r\n", "with space", 0), "F x y=é 3 <--B> {Content-Disposition=[form-data; name=\"x y\"; filename=\"é\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nX-A: attachment; filename=f.bin\r\nX-Lower: attachment; filename=f.bin\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 5), ""
  assert_eq read_form_render("--B\r\n\r\n\r\n--B\r\n--B--\r\n", "B", 1), "ERR malformed MIME header: missing colon: \"--B--\""
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--B\r\n--B--\r\n", "B", 0), "ERR malformed MIME header: missing colon: \"--B--\""
  assert_eq read_form_render("\r\n\r\n--B--\r\n", "B", 5), ""
  assert_eq read_form_render("--with space\r\nContent-Disposition: quoted-printable\r\nContent-Disposition: QUOTED-PRINTABLE\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--with space--\r\n", "with space", 5), "V x y=[line1\r\nline2]"
  assert_eq read_form_render("-B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--B--\r\n", "B", 1), ""
  assert_eq read_form_render("--B\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"a\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B--\r\nepilogue\r\n", "B", 0), "F a=x y 3 <=3D> {Content-Disposition=[form-data; name=\"a\"; filename=\"x y\"];Content-Type=[application/octet-stream]}\nF f\"q=n%0D%0Al 11 <hello world> {Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n=3D\r\n--MyBoundary--\r\n", "MyBoundary", 5), "V n%0D%0Al=[=3D]\nF a=back\\slash 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"a\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"a\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\r\n--B\r\n", "B", 1048576), "ERR malformed MIME header: missing colon: \"--B\""
  assert_eq read_form_render("-0123456789\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--0123456789--\r\n", "0123456789", 1), "F é=f\"q 5 <é ü> {Content-Disposition=[form-data; name=\"é\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--0123456789\r\n\r\n=3D\r\n--0123456789\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\n\r\n\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--B\r\n--0123456789--\r\n", "0123456789", 1048576), "V x y=[\r\n--B]"
  assert_eq read_form_render("\r\n--with space--\r\n", "with space", 5), ""
  assert_eq read_form_render("--with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space--\r\n", "with space", 0), "F f\"q=field 1 <v> {Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"field\"];Content-Type=[application/octet-stream]}\nF field=n%0D%0Al 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"field\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: v\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 5), "F x y=field 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"x y\"; filename=\"field\"];Content-Type=[application/octet-stream]}\nF é=f\"q 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"é\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--MyBoundary--\r\n", "MyBoundary", 5), "V f\"q=[hello world]\nF n%0D%0Al=f\"q 1 <v> {Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nX-Lower: quoted-printable\r\n\r\né ü\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1048576), "V back\\slash=[line1\r\nline2]\nF é=é 0 <> {Content-Disposition=[form-data; name=\"é\"; filename=\"é\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), "F n%0D%0Al=f\"q 1 <v> {Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}\nF é=é 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"é\"; filename=\"é\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"é\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n--B\r\n--B--\r\n", "B", 5), "ERR malformed MIME header: missing colon: \"--B\""
  assert_eq read_form_render("--with space\r\nContent-Transfer-Encoding: attachment; filename=f.bin\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space--\r\n", "with space", 5), "F a=n%0D%0Al 1 <\n> {Content-Disposition=[form-data; name=\"a\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("-MyBoundary\r\nContent-Type: v\r\n\r\nhello world\r\n--MyBoundary--\r\n", "MyBoundary", 1), ""
  assert_eq read_form_render("--0123456789\r\nX-A: 7bit\r\n\r\nline1\r\nline2\r\n--0123456789\r\nContent-Type: form-data; name=k; filename=\"a/b.txt\"\r\nContent-Type: form-data; name=\"k\"\r\n\r\n\n\r\n--0123456789--\r\n", "0123456789", 1048576), ""
  assert_eq read_form_render("\r\n--a'()+_,-./:=?b\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1), ""
  assert_eq read_form_render("--B \t\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\" \t\r\nContent-Type: application/octet-stream \t\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--B--\r\n", "B", 1048576), "V field=[]\nF n%0D%0Al=é 1 <v> {Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"é\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("\n--MyBoundary--\n", "MyBoundary", 0), "ERR multipart: NextPart: EOF"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\né ü\r\n--B\r\n\r\n=3D\r\n--B\r\nContent-Disposition: form-data; name=\"é\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--B--\r\n", "B", 1048576), "V é=[é ü]\nF é=f\"q 0 <> {Content-Disposition=[form-data; name=\"é\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Type: form-data; name=\"k\"\r\nX-A: QUOTED-PRINTABLE\r\n\r\n\r\n--a'()+_,-./:=?b\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), ""
  assert_eq read_form_render("--0123456789\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\né ü\r\n--0123456789--\r\n", "0123456789", 1), ""
  assert_eq read_form_render("--MyBoundary \t\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"a\" \t\r\nContent-Type: application/octet-stream \t\r\n\r\nv\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\r\n--MyBoundary--\r\n", "MyBoundary", 0), "V x y=[\r]\nF back\\slash=a 1 <v> {Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Transfer-Encoding: \r\nX-Lower: v\r\n\r\n\r\r\n--MyBoundary--\r\n", "MyBoundary", 1), "V n%0D%0Al=[hello world]"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\né ü\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1), "F field=f\"q 5 <\r\n--B> {Content-Disposition=[form-data; name=\"field\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nhello world\r\n--MyBoundary--\r\n", "MyBoundary", 5), "V é=[hello world]\nF é=back\\slash 3 <=3D> {Content-Disposition=[form-data; name=\"é\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary \t\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n", "MyBoundary", 0), "V é=[line1\r\nline2]\nF n%0D%0Al=x y 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"x y\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--with space\r\nX-A: text/plain\r\n\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--with space--\r\n", "with space", 0), "F é=x y 5 <é ü> {Content-Disposition=[form-data; name=\"é\"; filename=\"x y\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n", "MyBoundary", 1048576), "V a=[hello world]\nF é=f\"q 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"é\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render(" \t\r\n--a'()+_,-./:=?b-- \t\r\n", "a'()+_,-./:=?b", 5), ""
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: 7bit\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: 7bit\r\nContent-Disposition: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), "F n%0D%0Al=é 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"é\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--with space\r\nContent-Type: attachment; filename=f.bin\r\nContent-Type: QUOTED-PRINTABLE\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\n\r\n--with space--\r\n", "with space", 1), ""
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--B\r\n--B--\r\n", "B", 1048576), "ERR malformed MIME header: missing colon: \"--B--\""
  assert_eq read_form_render("--0123456789\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"field\"\nContent-Type: application/octet-stream\n\n\n\n--0123456789\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"\nContent-Type: application/octet-stream\n\n\r\n--0123456789--\n", "0123456789", 0), "F back\\slash=field 1 <\n> {Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"field\"];Content-Type=[application/octet-stream]}\nF f\"q=back\\slash 1 <\r> {Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), ""
  assert_eq read_form_render("preamble\r\n\r\n--with space--\r\n", "with space", 1048576), ""
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1), "F field=a 1 <\r> {Content-Disposition=[form-data; name=\"field\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--with space\r\nContent-Disposition: form-data; name=\"é\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space\r\n\r\n--B--\r\n--with space\r\nContent-Type: text/plain\r\n\r\n=3D\r\n--with space--\r\n", "with space", 0), "V é=[\n]"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", 1048576), "V a=[--B--|\r\n--B]"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\r\n--B\r\n\r\n--B\r\n--B\r\n\r\né ü\r\n--B--\r\n", "B", 5), "ERR malformed MIME header: missing colon: \"--B\""
  assert_eq read_form_render("\r\n--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\né ü\r\n--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n=3D\r\n--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\r\n--B--\r\n", "B", 5), "V f\"q=[=3D]\nV field=[\r]"
  assert_eq read_form_render("--0123456789\r\n\r\n=3D\r\n--0123456789\r\n\r\n\r\n--0123456789--\r\n", "0123456789", 0), ""
  assert_eq read_form_render("--B\r\n\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B\r\nContent-Disposition: text/plain\r\nContent-Type: 7bit\r\n\r\n--B--\r\n--B--\r\n", "B", 1048576), "F back\\slash=é 3 <=3D> {Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"é\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--with space\r\nContent-Transfer-Encoding: \r\nContent-Type: form-data; name=k; filename=\"a/b.txt\"\r\n\r\nv\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n=3D\r\n--with space--\r\n", "with space", 5), "V é=[=3D]\nF x y=n%0D%0Al 0 <> {Content-Disposition=[form-data; name=\"x y\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nline1\r\nline2\r\n--B--\r\n", "B", 5), "V n%0D%0Al=[line1\r\nline2]"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B--\r\n", "B", 1), ""
  assert_eq read_form_render("--B\r\nContent-Disposition: quoted-printable\r\nX-Lower: text/plain\r\n\r\n--B--\r\n--B--\r\n", "B", 0), ""
  assert_eq read_form_render("--B\r\nX-Lower: attachment; filename=f.bin\r\n\r\né ü\r\n--B\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B--\r\n", "B", 0), "ERR malformed MIME header: missing colon: \"--B--\""
  assert_eq read_form_render("\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), ""
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--0123456789\r\n", "0123456789", 0), "V n%0D%0Al=[--B]\nV x y=[line1\r\nline2]"
  assert_eq read_form_render("--MyBoundary\nContent-Disposition: quoted-printable\nX-A: attachment; filename=f.bin\n\nline1\nline2\n--MyBoundary\nContent-Disposition: form-data; name=\"a\"; filename=\"n%0D%0Al\"\nContent-Type: application/octet-stream\n\n--B\n--MyBoundary--\n", "MyBoundary", 1), "F a=n%0D%0Al 3 <--B> {Content-Disposition=[form-data; name=\"a\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("\r\n--0123456789--\r\n", "0123456789", 0), ""
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\r\n--B\r\n--B--\r\n", "B", 5), "ERR malformed MIME header: missing colon: \"--B\""
}

test "vectors: read form 2" {
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--B\r\n", "B", 1048576), "F f\"q=field 12 <line1\r\nline2> {Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"field\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--with space\r\n\r\n=3D\r\n--with space--\r\n", "with space", 1), ""
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--MyBoundary--\r\n", "MyBoundary", 1048576), "V n%0D%0Al=[--B]\nF f\"q=f\"q 5 <--B--> {Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--MyBoundary--\r\n", "MyBoundary", 1), "V field=[--B--]"
  assert_eq read_form_render("\r\n-MyBoundary--\r\n", "MyBoundary", 1048576), "ERR multipart: NextPart: EOF"
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nv\r\n--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--0123456789--\r\n", "0123456789", 0), "V n%0D%0Al=[v]\nF f\"q=x y 1 <v> {Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"x y\"];Content-Type=[application/octet-stream]}\nF f\"q=a 1 <v> {Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--B--\r\n", "B", 0), "V f\"q=[\n]"
  assert_eq read_form_render("--with space\nContent-Transfer-Encoding: form-data; name=\"k\"\nContent-Type: text/plain\n\n--B\n--with space--\n", "with space", 1), ""
  assert_eq read_form_render("--MyBoundary\r\nContent-Type: form-data; name=\"k\"\r\nX-Lower: v\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nv\r\n--MyBoundary--\r\n", "MyBoundary", 1048576), "V field=[--B--]\nV é=[v]"
