  assert_eq parse_render("preamble\r\n-a'()+_,-./:=?b\r\nContent-Type: 7bit\r\nX-A: \r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=back\\slash body=<=3D>\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=f\"q file=n%0D%0Al body=<line1\r\nline2>"
  assert_eq parse_render("--with space \t\r\nContent-Disposition: form-data; name=\"x y\" \t\r\n\r\n=3D\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<=3D>"
