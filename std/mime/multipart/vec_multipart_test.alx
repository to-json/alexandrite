  assert_eq parse_render("preamble\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nv\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=field file=a body=<v>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<v>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<--B-->"
