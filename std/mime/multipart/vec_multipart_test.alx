  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--0123456789\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=f\"q file=x y body=<é ü>"
