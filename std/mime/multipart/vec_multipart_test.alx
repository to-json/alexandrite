  assert_eq set_boundary_render("("), "OK multipart/form-data; boundary=\"(\""
  assert_eq set_boundary_render("\\+Z"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("\"!"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render(":\";"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("[é(!"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("(é\\"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("=,"), "OK multipart/form-data; boundary=\"=,\""
  assert_eq set_boundary_render(":a[(a"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("/[@)_Z.<,\\'\"-@é+..!!a.[-Z\"@\\/+.\\, @ )=-/!aa<!@=0,Z?<==-/( )\"!,)é;<=;Z-["), "ERR mime: invalid boundary length"
  assert_eq set_boundary_render(";,_"), "ERR mime: invalid boundary character"
