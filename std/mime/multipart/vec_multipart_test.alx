  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nv\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", 1), "V x y=[\r|v]\nF back\\slash=f\"q 1 <v> {Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--B\r\nContent-Transfer-Encoding: text/plain\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n--B\r\n--B\r\n\r\nline1\r\nline2\r\n--B--\r\n", "B", 0), "ERR malformed MIME header: missing colon: \"--B\""
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\né ü\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: \r\nContent-Type: text/plain\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1), "V a=[v]\nV back\\slash=[é ü]"
  assert_eq read_form_render("--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--B--\r\nepilogue\r\n", "B", 1), "F back\\slash=a 5 <é ü> {Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"a\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render(" \t\r\n--B-- \t\r\n", "B", 5), ""
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nContent-Type: form-data; name=k; filename=\"a/b.txt\"\r\nX-Lower: 7bit\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 0), "V field=[]\nF x y=f\"q 5 <--B--> {Content-Disposition=[form-data; name=\"x y\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1048576), "V n%0D%0Al=[hello world]"
  assert_eq read_form_render("--B \t\r\nContent-Disposition: form-data; name=\"\" \t\r\n \t\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nv\r\n--B--\r\n", "B", 1048576), "ERR malformed MIME header: missing colon: \"--B\""
  assert_eq read_form_render("-MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", 1048576), ""
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nv\r\n--0123456789\r\n", "0123456789", 1), "V a=[v]\nF x y=é 1 <\r> {Content-Disposition=[form-data; name=\"x y\"; filename=\"é\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--B\r\nContent-Type: attachment; filename=f.bin\r\n\r\n\r\n--B\r\nContent-Transfer-Encoding: v\r\n\r\n\r\r\n--B--\r\n", "B", 5), ""
  assert_eq read_form_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--MyBoundary--\r\n", "MyBoundary", 5), "V a=[line1\r\nline2]"
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\n\r\n--0123456789--\r\n", "0123456789", 1048576), "V a=[\n]"
  assert_eq read_form_render("--B\r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\nX-Lower: text/plain\r\n\r\n=3D\r\n--B\r\n\r\n\r\n--B--\r\n", "B", 1048576), ""
  assert_eq read_form_render("--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--0123456789--\r\n", "0123456789", 0), "V a=[\r\n--B]\nF x y=f\"q 5 <é ü> {Content-Disposition=[form-data; name=\"x y\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]}"
  assert_eq read_form_render("--a'()+_,-./:=?b\r\nX-Lower: form-data; name=\"k\"\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n=3D\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", 1), "V field=[=3D]"
  assert_eq read_form_render("\r\n--MyBoundary--\r\n", "MyBoundary", 5), ""
  assert_eq read_form_render("--0123456789 \t\r\nContent-Transfer-Encoding: v \t\r\nX-A: quoted-printable\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nv\r\n--0123456789--\r\n", "0123456789", 1048576), "V field=[--B--]"
}

