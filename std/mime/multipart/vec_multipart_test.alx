  assert_eq set_boundary_render("(,["), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("\")(<"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("@a0[0?( [ )_.éZ;/+[=:. ))0 Za<Z_!\\,[:=<;,);=!!!_[[<_é=)-\"[:.(<'_).\\+@"), "ERR mime: invalid boundary length"
  assert_eq set_boundary_render("\"?"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("!/ !"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("?;0+("), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("-: (@"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("?"), "OK multipart/form-data; boundary=\"?\""
  assert_eq set_boundary_render(","), "OK multipart/form-data; boundary=\",\""
  assert_eq set_boundary_render(":?!!_"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("!"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("-"), "OK multipart/form-data; boundary=-"
  assert_eq set_boundary_render("(\\"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("?Z"), "OK multipart/form-data; boundary=\"?Z\""
  assert_eq set_boundary_render("\" -"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("a<\\-"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("()-"), "OK multipart/form-data; boundary=\"()-\""
  assert_eq set_boundary_render("a/"), "OK multipart/form-data; boundary=\"a/\""
  assert_eq set_boundary_render("(!\""), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render(" </"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("!@"), "ERR mime: invalid boundary character"
  assert_eq set_boundary_render("'"), "OK multipart/form-data; boundary='"
