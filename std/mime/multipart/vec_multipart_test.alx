  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=back\\slash file=n%0D%0Al body=<hello world>"
