  assert_eq parse_render("--with space\nContent-Disposition: form-data; name=\"f\\\"q\"\n\n--B--\n--with space--\n", "with space", true), "{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<--B-->"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Type: v\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: \r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Type=[v]} form= file= body=<>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<>\n{Content-Disposition=[]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("-with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"k\"\r\nX-A: text/plain\r\n\r\n--B\r\n--with space--\r\nepilogue\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"k\"];X-A=[text/plain]} form=k file= body=<--B>"
  assert_eq parse_render(" \t\r\n--0123", "0123456789", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--MyBoundary \t\r\nContent-Disposition: form-data; name=\"é\" \t\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\n\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<é ü>\n{Content-Disposition=[form-data; name=\"\"]} form= file= body=<\n>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n--B--\r\n--My", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<--B--> UEOF"
