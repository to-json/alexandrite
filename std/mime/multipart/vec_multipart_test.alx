  assert_eq parse_render("\n--MyBoundary\nContent-Disposition: form-data; name=\"\"\n\n=3D\n--MyBoundary\nContent-Disposition: form-data; name=\"é\"; filename=\"x y\"\nContent-Type: application/octet-stream\n\n=3D\n--MyBoundary--\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<=3D>\n{Content-Disposition=[form-data; name=\"é\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=é file=x y body=<=3D>"
  assert_eq parse_render("\r\n\r\n--0123456789\r\n", "0123456789", false), ""
