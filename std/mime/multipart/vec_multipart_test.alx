  assert_eq parse_render("--B\r\n\r\n\r\n--B", "B", false), "{} form= file= body=<>\nERR multipart: NextPart: EOF"
  assert_eq parse_render("--with space\nContent-Disposition: QUOTED-PRINTABLE\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\n\nv\n--with space--\n", "with space", false), "{Content-Disposition=[QUOTED-PRINTABLE];X-Lower=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<v>"
  assert_eq parse_render("--B\r\nConten", "B", false), "ERR malformed MIME header: missing colon: \"Conten\""
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\né ü\r\n--B\r\nContent-Disposition: form-data; name=\"a\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--B--\r\nepilogue\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<é ü>\n{Content-Disposition=[form-data; name=\"a\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=a file=n%0D%0Al body=<é ü>"
  assert_eq parse_render("\r\n--0123456789\r\nX-Lower: v\r\n\r\n=3D\r\n--0123456789\r\nContent-Transfer-Encoding: text/plain\r\n\r\n--B--\r\n--0123456789--\r\n", "0123456789", false), "{X-Lower=[v]} form= file= body=<=3D>\n{Content-Transfer-Encoding=[text/plain]} form= file= body=<--B-->"
  assert_eq parse_render("\r\n--", "a'()+_,-./:=?b", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--with space \t\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=x y file=f\"q body=<\n>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file= body=<\n>\n{Content-Disposition=[form-data; name=\"\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form= file=x y body=<\r>"
  assert_eq parse_render("preamble\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nhello world\r\n--0123456789--\r\nepilogue\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"\"];Content-Type=[application/octet-stream]} form=back\\slash file= body=<é ü>\n{Content-Disposition=[form-data; name=\"é\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=é file=x y body=<>\n{Content-Disposition=[form-data; name=\"\"]} form= file= body=<hello world>"
  assert_eq parse_render(" \t\r\n--B\r\n", "B", true), ""
  assert_eq parse_render("\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n", "MyBoundary", true), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"\"];Content-Type=[application/octet-stream]} form=f\"q file= body=<line1\r\nline2>"
}

test "vectors: parse 4" {
  assert_eq parse_render("--B \t\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\" \t\r\nContent-Type: application/octet-stream \t\r\n\r\nv\r\n--B--\r\n", "B", true), "{Content-Disposition=[form-data; name=\"é\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=é file=field body=<v>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--MyBoundary\r\n\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\nepilogue\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=field body=<é ü>\n{} form= file= body=<\r\n--B>\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<line1\r\nline2>"
  assert_eq parse_render("preamble\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=field file=field body=<hello world>"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"back\\\\slash\" \t\r\n \t\r\né ü\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", false), "ERR malformed MIME header: missing colon: \"é ü\""
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Type: \r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", false), "{Content-Type=[]} form= file= body=<hello world>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=x y body=<--B-->\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=x y body=<=3D>"
  assert_eq parse_render("--B \t\r\n\r\né ü\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--B--\r\n", "B", false), "{} form= file= body=<é ü>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<>"
  assert_eq parse_render("-B\r\n\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\r\n--B\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=field file=x y body=<\r>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<\r>"
  assert_eq parse_render("\r\n--B--\r\nepilogue\r\n", "B", false), ""
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n--B\r\n--0123456789\r\nContent-Type: attachment; filename=f.bin\r\n\r\n\r\r\n--0123456789\r\nContent-Type: attachment; filename=f.bin\r\n\r\nline1\r\nline2\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<--B>\n{Content-Type=[attachment; filename=f.bin]} form= file= body=<\r>\n{Content-Type=[attachment; filename=f.bin]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("preamble\r\n\r\n-MyBoundary--\r\n", "MyBoundary", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--B\r\nContent-Disposition: \r\nContent-Type: QUOTED-PRINTABLE\r\n\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B\r\n--B--\r\n", "B", false), "{Content-Disposition=[];Content-Type=[QUOTED-PRINTABLE]} form= file= body=<\n>\n{Content-Disposition=[form-data; name=\"\"]} form= file= body=<>\nERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render("preamble\r\n\r\n--MyBoundary--\r\n", "MyBoundary", false), ""
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"é\" \t\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<hello world>\n{} form= file= body=<\r>"
  assert_eq parse_render("\r\n--MyBoundary\r\n", "MyBoundary", false), ""
  assert_eq parse_render("preamble\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<hello world>\n{} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=x y file=field body=<\r\n--B>"
  assert_eq parse_render("--0123456789\r\nX-A: form-data; name=\"k\"\r\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n\r\n--0123456789--\r\n", "0123456789", true), "{X-A=[form-data; name=\"k\"];X-Lower=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<>"
  assert_eq parse_render("--MyBoundary\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"x y\"\nContent-Type: application/octet-stream\n\n--B\n--MyBoundary--\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=back\\slash file=x y body=<--B>"
  assert_eq parse_render("\r\n-B\r\n\r\nline1\r\nline2\r\n--B--\r\n", "B", false), ""
  assert_eq parse_render("--B\r\nContent-Disposition: v\r\n\r\nhello world\r\n--B\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nline1\r\nline2\r\n--B--\r\nepilogue\r\n", "B", false), "{Content-Disposition=[v]} form= file= body=<hello world>\n{} form= file= body=<>\nERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nhello world\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<hello world>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<hello world>"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nX-A: text/plain \t\r\nX-Lower: \r\n\r\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{X-A=[text/plain];X-Lower=[]} form= file= body=<>"
  assert_eq parse_render("--0123456789\r\nContent-Transfer-Encoding: quoted-printable\r\nContent-Type: 7bit\r\n\r\nline1\r\nline2\r\n--0123456789--\r\n", "0123456789", false), "{Content-Type=[7bit]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("preamble\r\n--with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B\r\n--with space\r\nContent-Disposition: quoted-printable\r\nContent-Disposition: 7bit\r\n\r\n\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<--B>\n{Content-Disposition=[quoted-printable|7bit]} form= file= body=<>"
  assert_eq parse_render("--0123456789\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\n\n--B--\n--0123456789--\n", "0123456789", false), "{X-Lower=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<--B-->"
  assert_eq parse_render("\r\n--0123456789\r\nContent-Transfer-Encoding: text/plain\r\nContent-Type: QUOTED-PRINTABLE\r\n\r\n\r\n--0123456789\r\n\r\n=3D\r\n--0123456789--\r\n", "0123456789", false), "{Content-Transfer-Encoding=[text/plain];Content-Type=[QUOTED-PRINTABLE]} form= file= body=<>\n{} form= file= body=<=3D>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\nepilogue\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=x y file=back\\slash body=<\r>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=field file=back\\slash body=<v>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"\"];Content-Type=[application/octet-stream]} form=x y file= body=<\r>"
  assert_eq parse_render("\n--with spa", "with space", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--with space\r\nContent-Transfer-Encoding: v\r\nX-Lower: QUOTED-PRINTABLE\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n=3D\r\n--with space--\r\n", "with space", false), "{Content-Transfer-Encoding=[v];X-Lower=[QUOTED-PRINTABLE]} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<\r\n--B>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<=3D>"
  assert_eq parse_render("--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"\"\n\nline1\nline2\n--a'()+_,-./:=?b\n\n--B\n--a'()+_,-./:=?b\nContent-Disposition: v\nX-Lower: text/plain\n\n\n--B\n--a'()+_,-./:=?b--\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<line1\nline2>\n{} form= file= body=<--B>\n{Content-Disposition=[v];X-Lower=[text/plain]} form= file= body=<\n--B>"
  assert_eq parse_render("-with space \t\r\nContent-Disposition: form-data; name=\"\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--with space--\r\n", "with space", true), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\n>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<>"
  assert_eq parse_render("--B\nContent-Dispo", "B", false), "ERR malformed MIME header: missing colon: \"Content-Dispo\""
  assert_eq parse_render("\r\n--0123456789\nContent-Disposition: form-data; name=\"x y\"; filename=\"field\"\nContent-Type: application/octet-stream\n\nv\n--0123456789\nContent-Disposition: form-data; name=\"\"\n\n=3D\n--0123456789\nContent-Disposition: form-data; name=\"n%0D%0Al\"\n\n\r\n--0123456789--\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=x y file=field body=<v>\n{Content-Disposition=[form-data; name=\"\"]} form= file= body=<=3D>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<\r>"
  assert_eq parse_render(" \t\r\n--a'()+_,-./:=?b--\r\nepilogue\r\n", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"a\"\n\nv\n--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"back\\\\slash\"\n\nv\n--a'()+_,-./:=?b--\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<v>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<v>"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"n%0D%0Al\"\r\nContent", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=x y file=a body=<\n>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<--B>\nERR malformed MIME header: missing colon: \"Content\""
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: 7bit\r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\n\r\nv\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\n\r\n--MyBoundary--\r\nepilogue\r\n", "MyBoundary", true), "{Content-Disposition=[7bit];Content-Transfer-Encoding=[form-data; name=\"k\"]} form= file= body=<v>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<\n>"
  assert_eq parse_render("-MyBoundary\r\nContent-Type: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n\r\n--MyBoundary\r\nContent-Disposition: quoted-printable\r\nContent-Transfer-Encoding: text/plain\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n", "MyBoundary", true), "{Content-Disposition=[quoted-printable];Content-Transfer-Encoding=[text/plain]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789\r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\n\r\n\r\r\n--0123456789--\r\nepilogue\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=é file=field body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=field file=é body=<=3D>\n{Content-Transfer-Encoding=[form-data; name=\"k\"]} form= file= body=<\r>"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\" \t\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=f\"q body=<\r>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=field file=f\"q body=<--B-->"
  assert_eq parse_render("-MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B\r\n--MyBoundary\r\nX-A: form-data; name=\"k\"\r\n\r\nhello world\r\n--MyBoundary--\r\n", "MyBoundary", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<--B>\n{X-A=[form-data; name=\"k\"]} form= file= body=<hello world>"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nli", "with space", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=é body=<li> UEOF"
  assert_eq parse_render("\r\n--01234567", "0123456789", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--with space\nContent-Disposition: form-data; name=\"a\"; filename=\"é\"\nContent-Type: application/octet-stream\n\n--B--\n--with space\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"a\"\nContent-Type: application/octet-stream\n\nv\n--with space--\n", "with space", false), "{Content-Disposition=[form-data; name=\"a\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=a file=é body=<--B-->\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=f\"q file=a body=<v>"
  assert_eq parse_render("\r\n--0123456789--\r\n", "0123456789", true), ""
  assert_eq parse_render("--with space \t\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<--B-->\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=back\\slash file=é body=<--B-->"
  assert_eq parse_render("--B\nContent-Disposition: form-data; name=\"field\"\n\n--B\n--B\nContent-Disposition: form-data; name=\"x y\"; filename=\"a\"\nContent-Type: application/octet-stream\n\n=3D\n--B\n\n\n--B\n--B--\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<>\nERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--0123456789\r\n\r\n\r\r\n--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--B\r\n--0123456789--\r\n", "0123456789", true), "{Content-Disposition=[form-data; name=\"field\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=field file=back\\slash body=<line1\r\nline2>\n{} form= file= body=<\r>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<\r\n--B>"
  assert_eq parse_render("--MyBoundary\r\nCo", "MyBoundary", true), "ERR malformed MIME header: missing colon: \"Co\""
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<\r\n--B>\n{Content-Disposition=[form-data; name=\"a\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=a file=a body=<>"
  assert_eq parse_render("--with space\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\n\nline1\nline2\n--with space\nContent-Disposition: form-data; name=\"back\\\\slash\"\n\né ü\n--with space\n", "with space", false), "{X-Lower=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<line1\nline2>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<é ü>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\n\r\né ü\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--a'()+_,-./:=?b--\r\nepilogue\r\n", "a'()+_,-./:=?b", false), "{} form= file= body=<é ü>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"a\"; filename=\"\"];Content-Type=[application/octet-stream]} form=a file= body=<é ü>"
  assert_eq parse_render("-a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: attachment; filename=f.bin\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Transfer-Encoding=[attachment; filename=f.bin]} form= file= body=<hello world>\n{} form= file= body=<--B>"
  assert_eq parse_render("-MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"k\"\r\n\r\né ü\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=x y file=field body=<--B-->\n{Content-Disposition=[form-data; name=\"k\"]} form=k file= body=<é ü>"
  assert_eq parse_render("\r\n", "with space", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n\n--B--\n", "B", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--with space \t\r\nContent-Type: 7bit \t\r\nContent-Type: v\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--with space--\r\n", "with space", false), "{Content-Type=[7bit|v]} form= file= body=<\n>\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=f\"q file=back\\slash body=<--B-->\n{Content-Disposition=[form-data; name=\"\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form= file=f\"q body=<=3D>"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=é file=n%0D%0Al body=<\r>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<--B>\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<\n>"
  assert_eq parse_render("preamble\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form= file=back\\slash body=<--B>"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<--B-->"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"\" \t\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nX-A: text/plain\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"\"];Content-Type=[application/octet-stream]} form=f\"q file= body=<\r\n--B>\n{X-A=[text/plain]} form= file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<line1\r\nline2>"
  assert_eq parse_render("\r\n--with space\nContent-Disposition: quoted-printable\n\n=3D\n--with space\nContent-Disposition: form-data; name=\"back\\\\slash\"\n\n\n--B\n--with space--\n", "with space", true), "{Content-Disposition=[quoted-printable]} form= file= body=<=3D>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<\n--B>"
  assert_eq parse_render("preamble\r\n--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<--B>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=a body=<\n>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=x y file=back\\slash body=<é ü>"
  assert_eq parse_render("preamble\r\n--0123456789\r\nContent-Disposition: form-data; name=\"\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B--\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form= file=n%0D%0Al body=<--B>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<--B-->"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nContent-Disposition: v\r\n\r\n\n\r\n--a'()+_,-./:=?b\r\n\r\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<=3D>\n{Content-Disposition=[v]} form= file= body=<\n>\n{} form= file= body=<>"
  assert_eq parse_render("--with space\n\nline1\nline2\n--with space--\nepilogue\n", "with space", false), "{} form= file= body=<line1\nline2>"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--a'()+_,-./:=?b--\r\nepilogue\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<hello world>\n{Content-Disposition=[form-data; name=\"\"; filename=\"\"];Content-Type=[application/octet-stream]} form= file= body=<>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n=3D\r\n--B\r\n", "B", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=a body=<>\nERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("--with space\nX-A: attachment; filename=f.bin\n\n--B--\n--with space\nContent-Disposition: form-data; name=\"a\"\n\n\n\n--with space--\n", "with space", false), "{X-A=[attachment; filename=f.bin]} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<\n>"
  assert_eq parse_render("\r\n--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<hello world>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=field file=é body=<--B-->"
  assert_eq parse_render("preamble\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n=3D\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<=3D>"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b--\r\nepilogue\r\n", "a'()+_,-./:=?b", true), ""
  assert_eq parse_render("preamble\r\n-a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n=3D\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n=3D\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<hello world>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<=3D>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<=3D>"
  assert_eq parse_render("preamble\r\n-a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: text/plain\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Transfer-Encoding=[text/plain]} form= file= body=<--B>"
  assert_eq parse_render("\r\n--with space\r\nX-Lower: form-data; name=\"k\"\r\nX-Lower: QUOTED-PRINTABLE\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n--B--\r\n--with space--\r\n", "with space", false), "{X-Lower=[form-data; name=\"k\"|QUOTED-PRINTABLE]} form= file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=back\\slash file=f\"q body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<--B-->"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-dat", "0123456789", false), ""
  assert_eq parse_render("--with space\r\n\r\n=3D\r\n--with space--\r\nepilogue\r\n", "with space", true), "{} form= file= body=<=3D>"
  assert_eq parse_render("--B\r\nContent-Disposition: text/plain\r\nContent-Type: QUOTED-PRINTABLE\r\n\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\r\n--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n=3D\r\n--B--\r\nepilogue\r\n", "B", false), "{Content-Disposition=[text/plain];Content-Type=[QUOTED-PRINTABLE]} form= file= body=<\n>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<\r>\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<=3D>"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"a\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: form-data; name=k; filename=\"a/b.txt\"\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"a\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=a file=é body=<--B>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"\"];Content-Type=[application/octet-stream]} form=x y file= body=<\r>\n{Content-Transfer-Encoding=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<hello world>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=field body=<v>"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\nContent-Type: quoted-printable\r\n\r\n\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Transfer-Encoding=[form-data; name=\"k\"];Content-Type=[quoted-printable]} form= file= body=<\n>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=field file=x y body=<--B-->\n{Content-Disposition=[form-data; name=\"a\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=a file=é body=<\r\n--B>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", false), "{} form= file= body=<v>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<--B>"
}

test "vectors: parse 5" {
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: attachment; filename=f.bin\r\n\r\n\r\n--a'()+_,-./:=?b--\r\nepilogue\r\nepilogue\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"a\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=a file=back\\slash body=<v>\n{} form= file= body=<line1\r\nline2>\n{Content-Disposition=[attachment; filename=f.bin]} form= file=f.bin body=<>"
  assert_eq parse_render("\r\n--MyBoun", "MyBoundary", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n=3D\r\n--0123456789\r\nConte", "0123456789", true), "{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<=3D>\nERR malformed MIME header: missing colon: \"Conte\""
  assert_eq parse_render("--B\r\nX-A: \r\n\r\nline1\r\nline2\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--B\r\n", "B", false), "{X-A=[]} form= file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<>"
  assert_eq parse_render("\r\npreamble\r\n\r\n--B--\r\n", "B", true), ""
  assert_eq parse_render("-with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\né ü\r\n--with space--\r\n", "with space", false), ""
  assert_eq parse_render("preamble\r\n--B\r\nContent-Disposition: form-data; name=\"é\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=é file=n%0D%0Al body=<>\nERR malformed MIME header: missing colon: \"--B--\""
