  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B--\r\n--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n=3D\r\n--B--\r\n", "B", true), "{Content-Disposition=[form-data; name=\"\"; filename=\"é\"];Content-Type=[application/octet-stream]} form= file=é body=<v>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<>"
  assert_eq parse_render("\r\n--a'()+_,-./:=", "a'()+_,-./:=?b", false), "ERR multipart: NextPart: EOF"
