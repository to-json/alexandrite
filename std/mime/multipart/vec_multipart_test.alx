  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--MyBoundary\r\nepilogue\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=field file=field body=<--B-->\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=f\"q file=x y body=<é ü>\nERR malformed MIME header: missing colon: \"epilogue\""
  assert_eq parse_render("--B\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"a\"\nContent-Type: application/octet-stream\n\n--B--\n--B\nContent-Disposition: form-data; name=\"n%0D%0Al\"\n\nline1\nline2\n--B--\n", "B", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=f\"q file=a body=<>"
  assert_eq parse_render("\r\n--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nline1\r\nline2\r\n--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nhello world\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<hello world>"
  assert_eq parse_render("\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nv\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=a body=<=3D>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<v>"
  assert_eq parse_render("--with space\r\n\r\n\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\n\r\n--with space--\r\nepilogue\r\n", "with space", false), "{} form= file= body=<>\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<\n>"
  assert_eq parse_render("preamble\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=a body=<--B>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=n%0D%0Al body=<\r\n--B>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition:", "a'()+_,-./:=?b", true), ""
  assert_eq parse_render("\r\n-a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), ""
  assert_eq parse_render("\r\n--MyBoundary\r\n\r\n=3D\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=", "MyBoundary", false), "{} form= file= body=<=3D>"
  assert_eq parse_render("-with space\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nv\r\n--with space\r\n\r\n--B--\r\n--with space--\r\n", "with space", true), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<v>\n{} form= file= body=<--B-->"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--MyBoundary\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\nX-Lower: v\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nv\r\n--MyBoundary--\r\nepilogue\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=x y body=<v>\n{X-Lower=[v]} form= file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<v>"
  assert_eq parse_render("preamble\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\n\r\n--with space\r\nContent-Type: text/plain\r\n\r\nline1\r\nline2\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=field body=<\r>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\n>\n{Content-Type=[text/plain]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("-0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B--\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=f\"q file=back\\slash body=<v>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<--B-->"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<>"
  assert_eq parse_render("--B \t\r\nContent-Disposition: form-data; name=\"n%0D%0Al\" \t\r\n\r\n\r\n--", "B", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<> UEOF"
  assert_eq parse_render("preamble\r\npreamble\r\n\r\n--with space--\r\n", "with space", false), ""
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\";", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--B\r\n", "B", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=f\"q body=<é ü>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<>"
  assert_eq parse_render("--with space \t\r\n \t\r\nline1\r\nline2\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--with space--\r\n", "with space", false), "ERR malformed MIME header initial line: \" \\t\""
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space--\r\nepilogue\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"\"];Content-Type=[application/octet-stream]} form=back\\slash file= body=<line1\r\nline2>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Type: form-data; name=\"k\"\r\n\r\n=3D\r\n--a'()+_,-./:=?b--\r\nepilogue\r\n", "a'()+_,-./:=?b", true), "{Content-Type=[form-data; name=\"k\"]} form= file= body=<=3D>"
  assert_eq parse_render("preamble\r\n--MyBoundary\nContent-Disposition: form-data; name=\"é\"; filename=\"a\"\nContent-Type: application/octet-stream\n\nhello world\n--MyBoundary--\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=é file=a body=<hello world>"
  assert_eq parse_render("--MyBoundary\nContent-Disposition: form-data; name=\"n%0D%0Al\"\n\nv\n--MyBoundary\nContent-Type: 7bit\n\n=3D\n--MyBoundary--\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<v>\n{Content-Type=[7bit]} form= file= body=<=3D>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data;", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=n%0D%0Al body=<\r>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--B\r\nContent-Disposition: form-data; name=\"\"; filenam", "B", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"\"];Content-Type=[application/octet-stream]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("--with space\r\nContent-Transfer-Encoding: form-data; name=k; filename=\"a/b.txt\"\r\nContent-Transfer-Encoding: 7bit\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--with space--\r\n", "with space", false), "{Content-Transfer-Encoding=[form-data; name=k; filename=\"a/b.txt\"|7bit]} form= file= body=<\n>\n{Content-Disposition=[form-data; name=\"é\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=é file=field body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=x y file=f\"q body=<\r>"
  assert_eq parse_render("--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"x y\"\nContent-Type: application/octet-stream\n\n--B\n--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"back\\\\slash\"\n\nline1\nline2\n--a'()+_,-./:=?b--\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=back\\slash file=x y body=<--B>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<line1\nline2>"
  assert_eq parse_render("--B\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--B--\r\nepilogue\r\n", "B", false), "{} form= file= body=<v>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<line1\r\nline2>"
  assert_eq parse_render("preamble\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\nepilogue\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=back\\slash file=x y body=<\n>\n{Content-Disposition=[form-data; name=\"é\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=é file=n%0D%0Al body=<line1\r\nline2>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=é file=a body=<--B-->\nERR multipart: NextPart: EOF"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n=3D\r\n--MyBoundary\r\nContent-Disposition: 7bit\r\n\r\n\r\n--B\r\n--MyBoundary\r\n", "MyBoundary", true), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<=3D>\n{Content-Disposition=[7bit]} form= file= body=<\r\n--B>"
  assert_eq parse_render("--0123456789\nContent-Disposition: form-data; name=\"\"\n\n\r\n--0123456789\nContent-Transfer-Encoding: QUOTED-PRINTABLE\nContent-Transfer-Encoding: v\n\n=3D\n--0123456789--\n", "0123456789", true), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<\r>\n{Content-Transfer-Encoding=[QUOTED-PRINTABLE|v]} form= file= body=<=3D>"
  assert_eq parse_render("\r\n--B\r\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n\r\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n", "B", false), "{X-Lower=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<\r>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=f\"q body=<>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\n\r\n--0123456789\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<\n>"
  assert_eq parse_render("--0123456789\nContent-Disposition: form-data; name=k; filename=\"a/b.txt\"\nX-Lower: 7bit\n\nline1\nline2\n--0123456789\nContent-Disposition: form-data; name=\"field\"\n\n\n\n--0123456789\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"\nContent-Type: application/octet-stream\n\n\n--0123456789--\n", "0123456789", true), "{Content-Disposition=[form-data; name=k; filename=\"a/b.txt\"];X-Lower=[7bit]} form=k file=b.txt body=<line1\nline2>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\n>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=n%0D%0Al body=<>"
  assert_eq parse_render("\r\n-", "B", true), "ERR multipart: NextPart: EOF"
}

test "vectors: parse 6" {
  assert_eq parse_render("\r\n--with space\n\n\n\n--with space\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"\nContent-Type: application/octet-stream\n\nline1\nline2\n--with space--\n", "with space", false), "{} form= file= body=<\n>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=f\"q body=<line1\nline2>"
  assert_eq parse_render("preamble\r\n-MyBoundary\r\n\r\n\r\r\n--MyBoundary--\r\n", "MyBoundary", false), ""
  assert_eq parse_render("\r\n--012345678", "0123456789", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--B\r\nContent-Type: attachment; filename=f.bin\r\nX-Lower: \r\n\r\n\n\r\n--B\r\n", "B", false), "{Content-Type=[attachment; filename=f.bin];X-Lower=[]} form= file= body=<\n>"
  assert_eq parse_render("--with space\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--with space\r\n", "with space", false), "{} form= file= body=<\n>\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<\n>\n{Content-Disposition=[form-data; name=\"a\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=a file=n%0D%0Al body=<v>"
  assert_eq parse_render("\r\n\r\n--My", "MyBoundary", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("preamble\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; ", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("--0123456789\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\nX-Lower: 7bit\r\n\r\n--B\r\n--0123456789\r\n", "0123456789", false), "{X-Lower=[7bit]} form= file= body=<--B>"
  assert_eq parse_render("--a'()+_,-./:=?b\nX-A: attachment; filename=f.bin\nX-Lower: QUOTED-PRINTABLE\n\né ü\n--a'()+_,-./:=?b--\n", "a'()+_,-./:=?b", true), "{X-A=[attachment; filename=f.bin];X-Lower=[QUOTED-PRINTABLE]} form= file= body=<é ü>"
  assert_eq parse_render("preamble\n--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"x y\"\n\nhello world\n--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"back\\\\slash\"\n\n=3D\n--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"field\"; filename=\"n%0D%0Al\"\nContent-Type: application/octet-stream\n\nhello world\n--a'()+_,-./:=?b--\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<hello world>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<=3D>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=field file=n%0D%0Al body=<hello world>"
  assert_eq parse_render("--with space\r\nX-Lower: 7bit\r\n\r\n--B\r\n--with space\r\n\r\n\n\r\n--with space\r\n", "with space", true), "{X-Lower=[7bit]} form= file= body=<--B>\n{} form= file= body=<\n>"
  assert_eq parse_render("--with space\r\nContent-Transfer-Encoding: \r\nX-Lower: v\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space\r\n", "with space", false), "{Content-Transfer-Encoding=[];X-Lower=[v]} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"field\"; filename=\"\"];Content-Type=[application/octet-stream]} form=field file= body=<line1\r\nline2>"
  assert_eq parse_render("preamble\r\n--B\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\nContent-Type: text/plain\r\n\r\n\r\n--B\r\nContent-Disposition: form-data; name=\"é\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--B\r\nContent-Disposition: QUOTED-PRINTABLE\r\n\r\nhello world\r\n--B--\r\n", "B", false), "{Content-Type=[text/plain]} form= file= body=<>\n{Content-Disposition=[form-data; name=\"é\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=é file=x y body=<\n>\n{Content-Disposition=[QUOTED-PRINTABLE]} form= file= body=<hello world>"
  assert_eq parse_render("--MyBoundary\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Transfe", "MyBoundary", false), "{} form= file= body=<hello world>\nERR malformed MIME header: missing colon: \"Content-Transfe\""
  assert_eq parse_render("\r\n--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nv\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<v>"
  assert_eq parse_render("--with space \t\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\" \t\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nv\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=é file=field body=<\r>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<v>"
  assert_eq parse_render(" \t \t\r\n--a'()+_,-./:=?b-- \t \t\r\n", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("-with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--with space\r\nContent-Type: 7bit\r\nX-A: attachment; filename=f.bin\r\n\r\n\n\r\n--with space--\r\n", "with space", false), "{Content-Type=[7bit];X-A=[attachment; filename=f.bin]} form= file= body=<\n>"
  assert_eq parse_render("-a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\n>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--B--\r\nepilogue\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=field file=é body=<>\nERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("\r\n-", "with space", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("-0123456789\r\nContent-Transfer-Encoding: form-data; name=k; filename=\"a/b.txt\"\r\nX-A: text/plain\r\n\r\n\r\r\n--0123456789--\r\n", "0123456789", false), ""
  assert_eq parse_render("\n--B--\nepilogue\r\n", "B", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--with space \t\r\nContent-Disposition: form-data; name=\"é\"; filename=\"f\\\"q\" \t\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=é file=f\"q body=<v>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=field file=back\\slash body=<v>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"\"];Content-Type=[application/octet-stream]} form=x y file= body=<\r\n--B>\n{Content-Disposition=[form-data; name=\"\"; filename=\"field\"];Content-Type=[application/octet-stream]} form= file=field body=<--B>"
  assert_eq parse_render("--with space\r\nContent-Type: form-data; name=\"k\"\r\n\r\n=3D\r\n--with space\r\nX-A: attachment; filename=f.bin\r\n\r\n-", "with space", false), "{Content-Type=[form-data; name=\"k\"]} form= file= body=<=3D>\n{X-A=[attachment; filename=f.bin]} form= file= body=<> UEOF"
