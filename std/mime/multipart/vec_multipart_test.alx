  assert_eq parse_render("\r\npreamble\r\n--0123456789\r\nContent-Type: \r\n\r\n--B--\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nline1\r\nline2\r\n--0123456789--\r\n", "0123456789", false), "{Content-Type=[]} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<line1\r\nline2>"
  assert_eq parse_render("preamble\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nv\r\n--with space\r\nConten", "with space", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<v>\nERR malformed MIME header: missing colon: \"Conten\""
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n=3D\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<\r\n--B>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=é body=<=3D>\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<=3D>"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n--B--\r\n--with space\r\n", "with space", true), "{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<--B-->"
  assert_eq parse_render("--with space \t\r\nContent-Disposition: form-data; name=\"n%0D%0Al\" \t\r\n \t\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--with space\r\nContent-Transfer-Encoding: quoted-printable\r\nContent-Type: quoted-printable\r\n\r\n\r\r\n--with space--\r\n", "with space", false), "ERR malformed MIME header: missing colon: \"=3D\""
  assert_eq parse_render("--with space \t\r\nContent-Type: 7bit \t\r\nX-A: \r\n\r\nline1\r\nline2\r\n--with space\r\n\r\nhello world\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space--\r\n", "with space", false), "{Content-Type=[7bit];X-A=[]} form= file= body=<line1\r\nline2>\n{} form= file= body=<hello world>\n{Content-Disposition=[form-data; name=\"a\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=a file=field body=<line1\r\nline2>"
