  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\n\r\n--with space\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<\n>"
  assert_eq parse_render("\r\n--with space\r\nX-A: form-data; name=\"k\"\r\n\r\né ü\r\n--with space\r\nContent-Disposition: \r\nContent-Type: text/plain\r\n\r\n--B\r\n--with space--\r\n", "with space", false), "{X-A=[form-data; name=\"k\"]} form= file= body=<é ü>\n{Content-Disposition=[];Content-Type=[text/plain]} form= file= body=<--B>"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{} form= file= body=<v>"
  assert_eq parse_render("--MyBoundary \t\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--MyBoundary\r\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n\r\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<\r>\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=f\"q file=f\"q body=<\r>\n{X-Lower=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<\r>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n--B\r\n--0123456789\r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\n\r\n--B--\r\n--0123456789\r\nX-Lower: 7bit\r\n\r\n\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<--B>\n{Content-Transfer-Encoding=[form-data; name=\"k\"]} form= file= body=<--B-->\n{X-Lower=[7bit]} form= file= body=<>"
  assert_eq parse_render("--0123456789\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\nContent-Type: application/octet-stream\n\n\n--B\n--0123456789\nContent-Disposition: form-data; name=\"n%0D%0Al\"\n\né ü\n--0123456789\nContent-Disposition: form-data; name=\"é\"\n\nhello world\n--0123456789--\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=field file=a body=<\n--B>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<é ü>\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<hello world>"
  assert_eq parse_render("\n--B--\n", "B", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n\r\n--0123456789--\r\n", "0123456789", false), ""
  assert_eq parse_render("preamble\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--MyBoundary\r\nX-Lower: form-data; name=\"k\"\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"\"];Content-Type=[application/octet-stream]} form=f\"q file= body=<é ü>\n{X-Lower=[form-data; name=\"k\"]} form= file= body=<hello world>\n{Content-Disposition=[form-data; name=\"a\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=a file=n%0D%0Al body=<\r\n--B>"
  assert_eq parse_render("--0123456789 \t\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"a\" \t\r\nContent-Type: application/octet-stream \t\r\n\r\n\r\n--B\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=back\\slash file=a body=<\r\n--B>"
  assert_eq parse_render("-with space \t\r\nX-A: form-data; name=\"k\" \t\r\nX-Lower:  \t\r\n\r\n\r\n--B\r\n--with space--\r\n", "with space", false), ""
  assert_eq parse_render("\r\n--B--\r\n", "B", false), ""
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: 7bit\r\nContent-Disposition: form-data; name=k; filename=\"a/b.txt\"\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nv\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--MyBoundary--\r\nepilogue\r\n", "MyBoundary", false), "{Content-Disposition=[7bit|form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<v>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=field file=back\\slash body=<hello world>"
  assert_eq parse_render("pre", "0123456789", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("-a'()+_,-./:=?b\r\nX-Lower: \r\nX-Lower: \r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), ""
  assert_eq parse_render("--with space\r\nX-A: QUOTED-PRINTABLE\r\n\r\n\r\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nv\r\n--with space--\r\nepilogue\r\n", "with space", false), "{X-A=[QUOTED-PRINTABLE]} form= file= body=<\r>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<v>"
  assert_eq parse_render("--B\r", "B", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; nam", "0123456789", false), ""
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B\r\n--MyBoundary\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<é ü>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=back\\slash file=n%0D%0Al body=<--B-->\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<--B>"
  assert_eq parse_render("-MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n", "MyBoundary", false), ""
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"", "with space", false), ""
  assert_eq parse_render("-MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", false), ""
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{} form= file= body=<v>"
  assert_eq parse_render(" \t\r\n--with space-- \t\r\nepilogue\r\n", "with space", true), ""
  assert_eq parse_render("--0123456789\r\nContent-Disposit", "0123456789", false), "ERR malformed MIME header: missing colon: \"Content-Disposit\""
  assert_eq parse_render("--MyBoundary \t\r\nContent-Disposition: form-data; name=\"back\\\\slash\" \t\r\n \t\r\nv\r\n--MyBoundary--\r\n", "MyBoundary", false), "ERR malformed MIME header: missing colon: \"v\""
  assert_eq parse_render("-B\nContent-Disposition: form-data; name=\"é\"; filename=\"é\"\nContent-Type: application/octet-stream\n\nline1\nline2\n--B--\n", "B", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nhello world\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<hello world>"
  assert_eq parse_render("\n--with space--\nepilogue\r\n", "with space", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--with space\n\nhello world\n--with space\nContent-Disposition: form-data; name=\"\"\n\n--B--\n--with space\n\nline1\nline2\n--with space--\n", "with space", false), "{} form= file= body=<hello world>\n{Content-Disposition=[form-data; name=\"\"]} form= file= body=<--B-->\n{} form= file= body=<line1\nline2>"
  assert_eq parse_render("\r\n-with space--\r\n", "with space", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\n\r\n--MyBoundary\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<é ü>\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<\n>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"; filename=\"field\"\r\nContent-T", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\n>\nERR malformed MIME header: missing colon: \"Content-T\""
}

test "vectors: parse 1" {
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n--B--\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<\r>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<--B-->"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B--\r\n--0123456789\r\nContent-Transfer-Encoding: v\r\n\r\n--B--\r\n--0123456789\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<--B-->\n{Content-Transfer-Encoding=[v]} form= file= body=<--B-->"
  assert_eq parse_render("--with space\r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--B\r\n--with space--\r\nepilogue\r\n", "with space", false), "{Content-Transfer-Encoding=[form-data; name=\"k\"]} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"field\"; filename=\"\"];Content-Type=[application/octet-stream]} form=field file= body=<--B-->\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\r\n--B>"
  assert_eq parse_render("-with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--with space--\r\n", "with space", false), ""
  assert_eq parse_render("\r\npreamble\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"\"];Content-Type=[application/octet-stream]} form=x y file= body=<v>\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<=3D>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=field file=x y body=<hello world>"
  assert_eq parse_render("preamble\r\n--B\r\nContent-Type: \r\n\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\r\n--B\r\nContent-Transfer-Encoding: text/plain\r\n\r\n\n\r\n--B--\r\n", "B", false), "{Content-Type=[]} form= file= body=<>\nERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("-0123456789\r\nContent-Disposition: form-data; name=\"a\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789--\r\n", "0123456789", false), ""
  assert_eq parse_render("preamble\r\n--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"é\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<v>\n{Content-Disposition=[form-data; name=\"é\"; filename=\"\"];Content-Type=[application/octet-stream]} form=é file= body=<>\nERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render("--with space \t\r\nContent-Disposition: v \t\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\né ü\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[v]} form= file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<é ü>"
  assert_eq parse_render("preamble\n\n--MyBoundary--\n", "MyBoundary", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render(" \t\r\n-0123456789-- \t\r\n", "0123456789", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\r\n--MyBoundary\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"field\"];Content-Type=[application/octet-stream]} form= file=field body=<hello world>\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<\r>"
  assert_eq parse_render("--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"\"\n\n\n--a'()+_,-./:=?b--\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<>"
  assert_eq parse_render("--0123456789\nContent-Transfer-Encoding: form-data; name=k; filename=\"a/b.txt\"\nContent-Type: v\n\n\r\n--0123456789\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"\"\nContent-Type: application/octet-stream\n\n\n--0123456789--\n", "0123456789", false), "{Content-Transfer-Encoding=[form-data; name=k; filename=\"a/b.txt\"];Content-Type=[v]} form= file= body=<\r>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"\"];Content-Type=[application/octet-stream]} form=back\\slash file= body=<>"
  assert_eq parse_render("\r\n\r\n--with space--\r\n", "with space", false), ""
  assert_eq parse_render("--MyBoundary \t\r\nContent-Disposition: form-data; name=\"field\" \t\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Type: text/plain\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\r>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"\"];Content-Type=[application/octet-stream]} form=back\\slash file= body=<--B-->\n{Content-Type=[text/plain]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("", "with space", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--B\r\n", "B", false), ""
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nhello world\r\n--with space\r\n\r\nv\r\n--with space--\r\nepilogue\r\n", "with space", true), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<hello world>\n{} form= file= body=<v>"
  assert_eq parse_render("\r\n--with space\r\nContent-Transfer-Encoding: v\r\nX-A: text/plain\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nv\r\n--with space--\r\n", "with space", false), "{Content-Transfer-Encoding=[v];X-A=[text/plain]} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<v>"
  assert_eq parse_render("--B\n\nhello world\n--B\nContent-Disposition: form-data; name=\"back\\\\slash\"\n\n\r\n--B\nContent-Disposition: form-data; name=\"back\\\\slash\"\n\n\n--B\n--B--\nepilogue\n", "B", false), "{} form= file= body=<hello world>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<\r>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<>\nERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render("-a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=é file=n%0D%0Al body=<\n>\n{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<>"
  assert_eq parse_render("\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--MyBoundary--\r\n", "MyBoundary", true), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=x y file=back\\slash body=<=3D>"
  assert_eq parse_render("\r\n--MyBoundary--\r\n", "MyBoundary", true), ""
  assert_eq parse_render("\r\n--a'()+_,-./:=?b--\r\nepilogue\r\nepilogue\r\n", "a'()+_,-./:=?b", true), ""
  assert_eq parse_render("\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--B--\r\n", "B", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=é body=<>"
  assert_eq parse_render("--B\nContent-Disposition: form-data; name=\"x y\"; filename=\"field\"\nContent-Type: application/octet-stream\n\né ü\n--B\nContent-Disposition: form-data; name=\"x y\"\n\n\n\n--B--\n", "B", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=x y file=field body=<é ü>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<\n>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"\"];Content-Type=[application/octet-stream]} form=x y file= body=<é ü>"
  assert_eq parse_render("preamble\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=x y body=<--B-->\n{} form= file= body=<\r\n--B>"
  assert_eq parse_render("--with space \t\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"a\" \t\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=x y file=a body=<>"
  assert_eq parse_render("preamble\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=é file=field body=<hello world>"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b--\r\nepilogue\r\n", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("preamble\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--B\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<>\nERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render("\r\n--with space\nContent-Disposition: form-data; name=\"a\"\n\n\n\n--with space\n\n\n--with space\nContent-Disposition: form-data; name=\"\"\n\n\n--B\n--with space--\n", "with space", true), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<\n>\n{} form= file= body=<>\n{Content-Disposition=[form-data; name=\"\"]} form= file= body=<\n--B>"
  assert_eq parse_render("-0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--0123456789--\r\n", "0123456789", true), ""
  assert_eq parse_render("--B \t\nContent-Disposition: form-data; name=\"field\"; filename=\"é\"\nContent-Type: application/octet-stream\n\nhello world\n--B\nContent-Disposition: form-data; name=\"é\"\n\nv\n--B--\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=field file=é body=<hello world>\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<v>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"é\"; fi", "0123456789", false), ""
  assert_eq parse_render("--a'()+_,-./:=?b\n\n--B--\n--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"é\"\nContent-Type: application/octet-stream\n\nhello world\n--a'()+_,-./:=?b--\n", "a'()+_,-./:=?b", true), "{} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=f\"q file=é body=<hello world>"
  assert_eq parse_render("\r\n--MyBoundary\r\nContent-Transfer-Encoding: 7bit\r\nContent-Type: \r\n\r\n--B--\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Transfer-Encoding=[7bit];Content-Type=[]} form= file= body=<--B-->"
  assert_eq parse_render("preamble\r\n-with space\r\nContent-Disposition: form-data; name=\"é\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--with space--\r\n", "with space", false), ""
  assert_eq parse_render("preamble\r\n\r\n--with space--\r\n", "with space", false), ""
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"back\\\\slash\"\r\nConten", "with space", false), "ERR malformed MIME header: missing colon: \"Conten\""
  assert_eq parse_render("preamble\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=f\"q file=f\"q body=<\r>"
  assert_eq parse_render("\r\n--B\r\n", "B", true), ""
  assert_eq parse_render("-a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"k\"\r\nContent-Type: v\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<--B>\n{Content-Disposition=[form-data; name=\"k\"];Content-Type=[v]} form=k file= body=<\n>"
  assert_eq parse_render("-0123456789 \t\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\" \t\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--0123456789--\r\n", "0123456789", false), ""
  assert_eq parse_render("--0123456789 \t\r\n \t\r\né ü \t\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nline1\r\nline2\r\n--0123456789--\r\n", "0123456789", false), "ERR malformed MIME header initial line: \" \\t\""
  assert_eq parse_render("\r\n--MyBoundary\r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\nContent-Type: text/plain\r\n\r\nhello world\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Transfer-Encoding=[form-data; name=\"k\"];Content-Type=[text/plain]} form= file= body=<hello world>"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"ba", "with space", false), ""
  assert_eq parse_render("preamble\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"a\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=a file=f\"q body=<line1\r\nline2>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--0123456789\r\nX-Lower: \r\n\r\nv\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=n%0D%0Al body=<line1\r\nline2>\n{X-Lower=[]} form= file= body=<v>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nv\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789--\r\nepilogue\r\nepilogue\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<v>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=back\\slash file=é body=<=3D>"
  assert_eq parse_render("preamble\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B--\r\n--MyBoundary--\r\nepilogue\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<--B-->"
  assert_eq parse_render("\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--MyBoundary\r\n\r\nv\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=x y file=f\"q body=<\r>\n{} form= file= body=<v>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposi", "MyBoundary", false), "ERR malformed MIME header: missing colon: \"Content-Disposi\""
  assert_eq parse_render("preamble\r\n \t\r\n--with space-- \t\r\n", "with space", false), ""
  assert_eq parse_render("--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"é\"\n\nhello world\n--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"field\"; filename=\"\"\nContent-Type: application/octet-stream\n\n--B--\n--a'()+_,-./:=?b\n\n\n--a'()+_,-./:=?b--\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<hello world>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"\"];Content-Type=[application/octet-stream]} form=field file= body=<--B-->\n{} form= file= body=<>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r", "B", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=field file=é body=<hello world> UEOF"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<hello world>"
  assert_eq parse_render("\r\n--0123456789--\r\n", "0123456789", false), ""
  assert_eq parse_render("\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nv\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<v>\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=f\"q file=n%0D%0Al body=<--B>"
  assert_eq parse_render("--MyBoundary \t\r\n \t\r\nv\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\r\n--MyBoundary--\r\n", "MyBoundary", false), "ERR malformed MIME header initial line: \" \\t\""
  assert_eq parse_render("--B\r\nContent-Disposition: quoted-printable\r\nX-Lower: \r\n\r\nhello world\r\n--B\r\n\r\n--B\r\n--B--\r\nepilogue\r\n", "B", false), "{Content-Disposition=[quoted-printable];X-Lower=[]} form= file= body=<hello world>\n{} form= file= body=<>\nERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render("--0123456789\nContent-Disposition: form-data; name=\"é\"\n\n\n--B\n--0123456789--\n", "0123456789", true), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<\n--B>"
  assert_eq parse_render("preamble\r\npreamble\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\né ü\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<é ü>"
  assert_eq parse_render("preamble\r\n-with space\r\n\r\né ü\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--B\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\r\n--B>"
  assert_eq parse_render("--with space\r\nContent-Type: quoted-printable\r\n\r\n\n\r\n--with space--\r\n", "with space", false), "{Content-Type=[quoted-printable]} form= file= body=<\n>"
  assert_eq parse_render("-B\r\nContent-Disposition: form-data; name=\"é\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--B--\r\n", "B", false), ""
  assert_eq parse_render("--MyBoundary\r\nContent-Transfer-Encoding: v\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\n\r\n=3D\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\n--B\r\n--MyBoundary\r\n", "MyBoundary", true), "{Content-Transfer-Encoding=[v|QUOTED-PRINTABLE]} form= file= body=<=3D>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<\r\n--B>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--0123456789\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=é file=x y body=<>"
  assert_eq parse_render("preamble\n--with space\nContent-Disposition: form-data; name=\"f\\\"q\"\n\nhello world\n--with space\nContent-Disposition: form-data; name=\"f\\\"q\"\n\nline1\nline2\n--with space\n\né ü\n--with space--\n", "with space", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<hello world>\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<line1\nline2>\n{} form= file= body=<é ü>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"\"];Content-Type=[application/octet-stream]} form= file= body=<>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=x y file=a body=<=3D>"
  assert_eq parse_render("--with space\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\nContent-Type: application/octet-stream\n\nline1\nline2\n--with space\n\n\r\n--with space\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"\nContent-Type: application/octet-stream\n\nline1\nline2\n--with space--\n", "with space", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"é\"];Content-Type=[application/octet-stream]} form= file=é body=<line1\nline2>\n{} form= file= body=<\r>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=back\\slash body=<line1\nline2>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\n\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\n>"
  assert_eq parse_render("preamble\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\né ü\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=field body=<=3D>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<=3D>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<é ü>"
  assert_eq parse_render("\r\n-0123456789--\r\n", "0123456789", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--with space\r\nX-Lower: form-data; name=\"k\"\r\n\r\né ü\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"; filename=\"n%0D%0Al\"\r\nContent-Ty", "with space", false), "{X-Lower=[form-data; name=\"k\"]} form= file= body=<é ü>\nERR malformed MIME header: missing colon: \"Content-Ty\""
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--with space\r\n\r\né ü\r\n--with space\r\nContent-Disposition: form-", "with space", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=f\"q file=back\\slash body=<>\n{} form= file= body=<é ü>"
  assert_eq parse_render("\r\n--MyBoundary \t\r\nContent-Disposition: form-data; name=\"n%0D%0Al\" \t\r\n\r\n--B--\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<--B-->"
  assert_eq parse_render("\n--MyBoundary--\n", "MyBoundary", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("preamble\r\n\r\n--B--\r\n", "B", false), ""
  assert_eq parse_render("\r\n--with space\r\n\r\n\r\n--with space\r\nContent-Transfer-Encoding: \r\nX-A: attachment; filename=f.bin\r\n\r\n\n\r\n--with space--\r\n", "with space", false), "{} form= file= body=<>\n{Content-Transfer-Encoding=[];X-A=[attachment; filename=f.bin]} form= file= body=<\n>"
  assert_eq parse_render("\r\n-MyBoundary--\r\n", "MyBoundary", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--MyBoun", "MyBoundary", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("-with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nv\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<v>"
  assert_eq parse_render("preamble\r\n\r\n-MyBoundary--\r\n", "MyBoundary", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--B\r\nContent-Type: text/plain\r\nX-A: quoted-printable\r\n\r\n=3D\r\n--B--\r\nepilogue\r\n", "B", false), "{Content-Type=[text/plain];X-A=[quoted-printable]} form= file= body=<=3D>"
  assert_eq parse_render("--B \t \t\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\" \t\r\nContent-Type: application/octet-stream \t\r\n\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nline1\r\nline2\r\n--B--\r\n", "B", true), "{Content-Disposition=[form-data; name=\"a\"; filename=\"\"];Content-Type=[application/octet-stream]} form=a file= body=<\n>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<>\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<line1\r\nline2>"
  assert_eq parse_render("\r\n--0123456789\r\n", "0123456789", true), ""
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B\r\nContent-Type: quoted-printable\r\nX-A: form-data; name=\"k\"\r\n\r\nline1\r\nline2\r\n--B--\r\n", "B", true), "{Content-Disposition=[form-data; name=\"é\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=é file=field body=<=3D>\n{Content-Type=[quoted-printable];X-A=[form-data; name=\"k\"]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\né ü\r\n--with space--\r\nepilogue\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<é ü>"
  assert_eq parse_render("--with space \t\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"\" \t\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\né ü\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--with space--\r\nepilogue\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file= body=<\r>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<é ü>\n{Content-Disposition=[form-data; name=\"é\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=é file=field body=<--B>"
  assert_eq parse_render("--0123456789\r\nContent-Transfer-Encoding: QUO", "0123456789", false), ""
}

test "vectors: parse 2" {
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"field\"; filename=\"é\" \t\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=field file=é body=<--B-->\n{} form= file= body=<>\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=f\"q file=é body=<\r\n--B>"
  assert_eq parse_render("--B \t\r\nContent-Disposition: attachment; filename=f.bin\r\nContent-Type: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B--\r\n", "B", true), "{Content-Disposition=[attachment; filename=f.bin];Content-Type=[form-data; name=k; filename=\"a/b.txt\"]} form= file=f.bin body=<\n>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<>\nERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; fil", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<--B>"
  assert_eq parse_render("preamble\r\n--MyBoundary\r\nContent-Type: form-data; name=\"k\"\r\nX-A: text/plain\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: quoted-printable\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nv\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Type=[form-data; name=\"k\"];X-A=[text/plain]} form= file= body=<\r>\n{Content-Disposition=[quoted-printable]} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<v>"
  assert_eq parse_render("preamble\r\n--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<>\nERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("preamble\r\n\r\n--with space--\r\n", "with space", true), ""
  assert_eq parse_render("\n--0123456789--\n", "0123456789", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("-B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\n\r\n--B--\r\n", "B", true), ""
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\r\n--with space\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<\r\n--B>\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<--B-->\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<\r>"
  assert_eq parse_render("\r\n-MyBoundary--\r\n", "MyBoundary", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nConte", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<v>\nERR malformed MIME header: missing colon: \"Conte\""
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\r\n--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\né ü\r\n--0123456789\r\n\r\n--B--\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<\r>\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<é ü>\n{} form= file= body=<--B-->"
  assert_eq parse_render(" \t\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("--with space\nContent-Disposition: form-data; name=\"é\"\n\n\n--with space--\n", "with space", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<>"
  assert_eq parse_render("preamble\r\n--B\r\nContent-Disposition: text/plain\r\nX-A: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n=3D\r\n--B--\r\n", "B", false), "{Content-Disposition=[text/plain];X-A=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<=3D>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nhello world\r\n--B\r\n", "B", false), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<hello world>"
  assert_eq parse_render("preamble\r\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), ""
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--0123456789\r\nContent-Disposition: attachment; filename=f.bin\r\n\r\né ü\r\n--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\r\n--0123456789--\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=é file=field body=<>\n{Content-Disposition=[attachment; filename=f.bin]} form= file=f.bin body=<é ü>\n{Content-Disposition=[form-data; name=\"\"]} form= file= body=<\r>"
  assert_eq parse_render("\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\n--B\r\n\r\n\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=x y file=f\"q body=<>\nERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("--a'()+_,-./:=?b\r\n\r\né ü\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{} form= file= body=<é ü>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=back\\slash file=é body=<\r>"
  assert_eq parse_render("-B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\r\n--B\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\r>"
  assert_eq parse_render("\n\n--with space--\n", "with space", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=f\"q file=field body=<>\n{Content-Disposition=[form-data; name=\"\"]} form= file= body=<--B>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=back\\slash file=n%0D%0Al body=<=3D>"
  assert_eq parse_render("\n--with space\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\nContent-Type: application/octet-stream\n\n=3D\n--with space--\n", "with space", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=field file=a body=<=3D>"
  assert_eq parse_render("--B \t \t\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"n%0D%0Al\" \t \t\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--B\r\n\r\nline1\r\nline2\r\n--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--B--\r\n", "B", true), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=x y file=n%0D%0Al body=<\n>\n{} form= file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=f\"q file=é body=<>"
  assert_eq parse_render("-with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nhello world\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<hello world>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nX-A: text/plain\r\nX-Lower: v\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<--B-->\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<\r>\n{X-A=[text/plain];X-Lower=[v]} form= file= body=<line1\r\nline2>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\r\nContent-Type", "MyBoundary", true), "ERR malformed MIME header: missing colon: \"Content-Type\""
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n--B--\r\n--with space\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<--B-->"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B\r\n--with space\r\n", "with space", true), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<--B>"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("\r\n--MyBoundary--\r\n", "MyBoundary", false), ""
  assert_eq parse_render("\r\n--MyBoundary--\r\nepilogue\r\n", "MyBoundary", true), ""
  assert_eq parse_render("\r\n--a'()+_", "a'()+_,-./:=?b", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nX-Lower: 7bit\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: QUOTED-PRINTABLE\r\nX-A: form-data; name=\"k\"\r\n\r\n\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", true), "{X-Lower=[7bit]} form= file= body=<line1\r\nline2>\n{Content-Disposition=[QUOTED-PRINTABLE];X-A=[form-data; name=\"k\"]} form= file= body=<>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"f\\\"q\"\r\nCont", "MyBoundary", false), "ERR malformed MIME header: missing colon: \"Cont\""
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\né ü\r\n--MyBoundary\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<é ü>"
  assert_eq parse_render("\r\n-with space--\r\n", "with space", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--with space\r\nContent-D", "with space", false), "ERR malformed MIME header: missing colon: \"Content-D\""
  assert_eq parse_render("--with space \t\nContent-Disposition: form-data; name=\"f\\\"q\" \t\n \t\n\r\n--with space\nContent-Disposition: form-data; name=\"é\"\n\n--B--\n--with space\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"\nContent-Type: application/octet-stream\n\né ü\n--with space--\n", "with space", false), "{Content-Disposition=[form-data; name=\"f\\\"q\" ]} form=f\"q file= body=<>\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<--B-->\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=back\\slash file=n%0D%0Al body=<é ü>"
  assert_eq parse_render("\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<hello world>\n{Content-Disposition=[form-data; name=\"é\"; filename=\"\"];Content-Type=[application/octet-stream]} form=é file= body=<>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<\r\n--B>"
  assert_eq parse_render("preamble\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Disposition: \r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\n\r\nhello world\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<line1\r\nline2>\n{Content-Disposition=[];Content-Transfer-Encoding=[form-data; name=\"k\"]} form= file= body=<hello world>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: attachment; filename=f.bin\r\nContent-Disposition: text/plain\r\n\r\n=3D\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--0123456789--\r\nepilogue\r\n", "0123456789", false), "{Content-Disposition=[attachment; filename=f.bin|text/plain]} form= file=f.bin body=<=3D>\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=x y file=f\"q body=<é ü>"
  assert_eq parse_render("--0123456789\nContent-Disposition: form-data; name=\"\"\n\n--B--\n--0123456789\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"\"\nContent-Type: application/octet-stream\n\né ü\n--0123456789\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\nContent-Type: application/octet-stream\n\né ü\n--0123456789--\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"\"];Content-Type=[application/octet-stream]} form=back\\slash file= body=<é ü>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=field file=a body=<é ü>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<v>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=back\\slash body=<\r>"
  assert_eq parse_render("-with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=x y file=x y body=<\n>"
  assert_eq parse_render("\r\n--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<>"
  assert_eq parse_render("--MyBoundary\nX-A: quoted-printable\n\nv\n--MyBoundary\nContent-Disposition: form-data; name=\"field\"; filename=\"x y\"\nContent-Type: application/octet-stream\n\n\r\n--MyBoundary\n", "MyBoundary", true), "{X-A=[quoted-printable]} form= file= body=<v>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=field file=x y body=<\r>"
  assert_eq parse_render("-with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\né ü\r\n--with space\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\né ü\r\n--with space--\r\nepilogue\r\n", "with space", false), "{} form= file= body=<é ü>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--0123456789--\r\nepilogue\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=f\"q file=field body=<\r>"
  assert_eq parse_render("preamble\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", true), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=back\\slash file=a body=<hello world>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=back\\slash file=n%0D%0Al body=<\r\n--B>"
  assert_eq parse_render(" \t\n--MyBoundary--\n", "MyBoundary", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--0123456789\r\nContent-Type: form-data; name=k; filename=\"a/b.txt\"\r\n\r\né ü\r\n--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n=3D\r\n--0123456789\r\nContent-Disposition: form-", "0123456789", true), "{Content-Type=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<é ü>\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<=3D>"
  assert_eq parse_render("--B \t\r\nContent-Disposition: form-data; name=\"a\" \t\r\n\r\n\r\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<\r>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<\r>"
  assert_eq parse_render("--with space\r\nX-Lower: 7bit\r\n\r\n--B\r\n", "with space", false), "{X-Lower=[7bit]} form= file= body=<--B> UEOF"
  assert_eq parse_render("\r\n--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nv\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\n\r\n--0123456789--\r\n", "0123456789", true), "{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<v>\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<\n>"
  assert_eq parse_render(" \t\r\n-0123456789--\r\n", "0123456789", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--with space\r\n", "with space", false), ""
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=f\"q file=a body=<--B>\n{} form= file= body=<=3D>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=field body=<--B>"
  assert_eq parse_render("preamble\r\n--MyBoundary\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B\r\n--MyBoundary--\r\n", "MyBoundary", false), "{} form= file= body=<--B>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<--B>"
  assert_eq parse_render("--MyBoundary \t\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary\r\n", "MyBoundary", false), "{} form= file= body=<--B-->\n{Content-Disposition=[form-data; name=\"field\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=field file=f\"q body=<--B-->"
  assert_eq parse_render("preamble\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=field body=<>"
  assert_eq parse_render("\r\n-a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("-B\r\nContent-Type: form-data; name=\"k\"\r\nX-Lower: text/plain\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B\r\n\r\nhello world\r\n--B--\r\n", "B", false), "ERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("\r\n--with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"\"];Content-Type=[application/octet-stream]} form= file= body=<\r>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=é body=<>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"\"]} form= file= body=<>"
  assert_eq parse_render("\r\n--0123456789-", "0123456789", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("preamble\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\r\n--with space\r\n\r\n--B\r\n--with space--\r\n", "with space", true), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=back\\slash file=field body=<hello world>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<\r>\n{} form= file= body=<--B>"
  assert_eq parse_render("preamble\r\n--with space\r\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--with space\r\n", "with space", true), "{X-Lower=[form-data; name=k; filename=\"a/b.txt\"]} form= file= body=<--B>\n{Content-Disposition=[form-data; name=\"a\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=a file=x y body=<\n>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<line1\r\nline2>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--0123456789\r\nContent-Transfer-Encoding: quoted-printable\r\nX-A: attachment; filename=f.bin\r\n\r\n\r\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n=3D\r\n--0123456789--\r\nepilogue\r\n", "0123456789", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=back\\slash file=é body=<>\n{X-A=[attachment; filename=f.bin]} form= file= body=<>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<=3D>"
  assert_eq parse_render("\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--0123456789\r\nX-A: 7bit\r\n\r\né ü\r\n--0123456789--\r\n", "0123456789", true), "{Content-Disposition=[form-data; name=\"é\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=é file=a body=<v>\n{X-A=[7bit]} form= file= body=<é ü>"
  assert_eq parse_render("-B\r\nContent-Disposition: attachment; filename=f.bin\r\n\r\n\r\n--B\r\n--B--\r\n", "B", false), "ERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render("\n--0123456789--\n", "0123456789", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\nContent-Type: 7bit\r\n\r\né ü\r\n--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n=3D\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form= file=f\"q body=<>\n{Content-Type=[7bit]} form= file= body=<é ü>\n{Content-Disposition=[form-data; name=\"a\"]} form=a file= body=<=3D>"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space\r\n\r\n\n\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=back\\slash file=é body=<--B-->\n{} form= file= body=<\n>"
  assert_eq parse_render("--with space \t\r\nContent-Type: attachment; filename=f.bin \t\r\nContent-Type: quoted-printable \t\r\n\r\n\r\n--B\r\n--with space\r\nContent-Type: 7bit\r\n\r\n\r\n--B\r\n--with space--\r\n", "with space", false), "{Content-Type=[attachment; filename=f.bin|quoted-printable]} form= file= body=<\r\n--B>\n{Content-Type=[7bit]} form= file= body=<\r\n--B>"
  assert_eq parse_render("\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--MyB", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=f\"q file=field body=<=3D> UEOF"
  assert_eq parse_render("--B\r\nContent-Disposition: for", "B", true), ""
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\n", "MyBoundary", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=x y body=<line1\r\nline2>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", true), "{Content-Disposition=[form-data; name=\"\"; filename=\"\"];Content-Type=[application/octet-stream]} form= file= body=<\n>"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r", "0123456789", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"\"];Content-Type=[application/octet-stream]} form=é file= body=<--B-->\nERR malformed MIME header: missing colon: \"\\r\""
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B\r\n--with space\r\nContent", "with space", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<--B>\nERR malformed MIME header: missing colon: \"Content\""
  assert_eq parse_render("preamble\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\n--B\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<>\n{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"\"]} form= file= body=<>\nERR malformed MIME header: missing colon: \"--B--\""
  assert_eq parse_render("-MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n", "MyBoundary", false), "{} form= file= body=<é ü>\n{Content-Disposition=[form-data; name=\"f\\\"q\"]} form=f\"q file= body=<line1\r\nline2>"
  assert_eq parse_render(" \t\r\n--with space-- \t\r\n", "with space", false), ""
  assert_eq parse_render("-B\nContent-Disposition: form-data; name=\"\"\n\nv\n--B\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\nContent-Type: application/octet-stream\n\n\r\n--B--\n", "B", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=é body=<\r>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--MyBoundary\r\n\r\n\r\r\n--MyBoundary\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"a\"; filename=\"\"];Content-Type=[application/octet-stream]} form=a file= body=<--B>\n{} form= file= body=<\r>"
  assert_eq parse_render("--with space\nContent-Disposition: form", "with space", false), ""
  assert_eq parse_render("preamble\r\n-with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--with space\r\nContent-Transfer-Encoding: text/plain\r\n\r\n--B\r\n--with space--\r\n", "with space", false), "{Content-Transfer-Encoding=[text/plain]} form= file= body=<--B>"
  assert_eq parse_render("--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<=3D>\n{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<\r>"
  assert_eq parse_render("\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nhello world\r\n--with space--\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"f\\\"q\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=f\"q file=x y body=<v>\n{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<hello world>"
  assert_eq parse_render("--B \t\r\nContent-Disposition: form-data; name=\"k\"\r\nContent-Disposition: \r\n\r\n\n\r\n--B\r\nContent-Disposition: fo", "B", false), "{Content-Disposition=[form-data; name=\"k\"|]} form=k file= body=<\n>"
}

test "vectors: parse 3" {
  assert_eq parse_render("\r\n-a'()+_,-./:=?b\r\nX-A: text/plain\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nv\r\n--with space\r\n", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<v>"
  assert_eq parse_render("preamble\r\n--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--B--\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"; filename=\"a\"];Content-Type=[application/octet-stream]} form=field file=a body=<\r>"
  assert_eq parse_render("--0123456789\r\n\r\n\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"n", "0123456789", false), "{} form= file= body=<\n>"
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--a'()+_,-./:=?b\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=é file=é body=<\n>\n{} form= file= body=<--B-->"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--MyBoundary\r\n", "MyBoundary", false), "{Content-Disposition=[form-data; name=\"é\"; filename=\"\"];Content-Type=[application/octet-stream]} form=é file= body=<--B-->\n{Content-Disposition=[form-data; name=\"x y\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=x y file=back\\slash body=<\r\n--B>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"é\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=é body=<v>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nline1\r\n", "B", false), "{Content-Disposition=[form-data; name=\"é\"]} form=é file= body=<line1> UEOF"
  assert_eq parse_render("preamble\r\n\r\n--MyBoundary--\r\nepilogue\r\n", "MyBoundary", false), ""
  assert_eq parse_render("--0123456789\nContent-Transfer-Encoding: form-data; name=\"k\"\n\n--B--\n--0123456789--\n", "0123456789", true), "{Content-Transfer-Encoding=[form-data; name=\"k\"]} form= file= body=<--B-->"
  assert_eq parse_render("--0123456789\r\nContent-Disposition: quoted-printable\r\n\r\nline1\r\nline2\r\n--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--0123456789--\r\nepilogue\r\n", "0123456789", false), "{Content-Disposition=[quoted-printable]} form= file= body=<line1\r\nline2>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file=n%0D%0Al body=<\r\n--B>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form=field file=f\"q body=<v>"
  assert_eq parse_render("\r\n--012", "0123456789", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("-a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Transfe", "a'()+_,-./:=?b", false), "ERR malformed MIME header: missing colon: \"Content-Transfe\""
  assert_eq parse_render("\r\n--a'()+_,-./:=?b\r\n", "a'()+_,-./:=?b", true), ""
  assert_eq parse_render("--with space \t\r\nContent-Transfer-Encoding: text/plain \t\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--with space--\r\n", "with space", false), "{Content-Transfer-Encoding=[text/plain]} form= file= body=<=3D>\n{Content-Disposition=[form-data; name=\"field\"; filename=\"field\"];Content-Type=[application/octet-stream]} form=field file=field body=<v>"
  assert_eq parse_render("--MyBoundary\r\n\r\n--B--\r\n--MyBoundary\r\n", "MyBoundary", false), "{} form= file= body=<--B-->"
  assert_eq parse_render("\r\n--0123456789\r\n", "0123456789", false), ""
  assert_eq parse_render("\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\r\n--0123456789--\r\n", "0123456789", true), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<\r>"
  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"n%0D%0Al\" \t\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<line1\r\nline2>\n{} form= file= body=<v>\n{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<\r>"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\r\n--B--\r\nepilogue\r\n", "B", false), "{Content-Disposition=[form-data; name=\"field\"]} form=field file= body=<>\nERR malformed MIME header: missing colon: \"--B\""
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--B--\r\n", "B", true), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"n%0D%0Al\"];Content-Type=[application/octet-stream]} form=x y file=n%0D%0Al body=<=3D>\n{Content-Disposition=[form-data; name=\"\"; filename=\"é\"];Content-Type=[application/octet-stream]} form= file=é body=<\r>"
  assert_eq parse_render("\r\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), ""
  assert_eq parse_render("preamble\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: quoted-printable\r\nContent-Type: 7bit\r\n\r\nhello world\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--with space--\r\n", "with space", true), "{Content-Disposition=[form-data; name=\"back\\\\slash\"]} form=back\\slash file= body=<--B-->\n{Content-Disposition=[quoted-printable];Content-Type=[7bit]} form= file= body=<hello world>\n{Content-Disposition=[form-data; name=\"a\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=a file=back\\slash body=<=3D>"
