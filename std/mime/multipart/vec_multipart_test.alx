  assert_eq parse_render("--a'()+_,-./:=?b \t\r\nContent-Disposition: form-data; name=\"n%0D%0Al\" \t\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"]} form=n%0D%0Al file= body=<--B-->"
  assert_eq parse_render("--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--with space--\r\nepilogue\r\n", "with space", true), "{Content-Disposition=[form-data; name=\"x y\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=x y file=back\\slash body=<hello world>"
