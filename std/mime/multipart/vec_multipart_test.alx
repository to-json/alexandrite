# Generated from Go's mime/multipart (go run, Go 1.27): Writer output with fixed boundaries, parsing, ReadForm, boundaries; do not edit by hand.

test "vectors: writer 0" {
  assert_eq write_ops("with space", [("F", "x y", "", "")]), "--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--with space--\r\n"
  assert_eq write_ops("0123456789", no_ops()), "\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", no_ops()), "\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "é", "=3D", ""), ("F", "field", "line1\r\nline2", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("FILE", "field", "", "v"), ("FILE", "field", "é", "\r")]), "--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--with space--\r\n"
  assert_eq write_ops("B", [("FILE", "n\r\nl", "back\\slash", "v"), ("FILE", "field", "é", "hello world")]), "--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("F", "é", "\r", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\r\r\n--0123456789--\r\n"
  assert_eq write_ops("B", [("F", "f\"q", "=3D", ""), ("F", "n\r\nl", "--B--", "")]), "--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n=3D\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B--\r\n--B--\r\n"
  assert_eq write_ops("MyBoundary", no_ops()), "\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("F", "n\r\nl", "line1\r\nline2", "")]), "--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nline1\r\nline2\r\n--B--\r\n"
  assert_eq write_ops("with space", no_ops()), "\r\n--with space--\r\n"
  assert_eq write_ops("with space", [("FILE", "a", "", "\r\n--B")]), "--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--with space--\r\n"
  assert_eq write_ops("B", [("FILE", "", "é", "=3D")]), "--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("F", "é", "\r\n--B", ""), ("P", "Content-Type: v", "\n", ""), ("P", "Content-Type: 7bit", "é ü", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\r\n--B\r\n--0123456789\r\nContent-Type: v\r\n\r\n\n\r\n--0123456789\r\nContent-Type: 7bit\r\n\r\né ü\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "", "--B--", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("B", [("F", "back\\slash", "hello world", "")]), "--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nhello world\r\n--B--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "X-A: attachment; filename=f.bin|x-lower: form-data; name=k; filename=\"a/b.txt\"", "--B--", "")]), "--MyBoundary\r\nX-A: attachment; filename=f.bin\r\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n--B--\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "", "é", "hello world"), ("FILE", "f\"q", "field", "\r"), ("FILE", "a", "a", "=3D")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("FILE", "f\"q", "a", "hello world"), ("FILE", "", "a", "line1\r\nline2")]), "--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--B--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "x-lower: |X-A: quoted-printable", "hello world", "")]), "--MyBoundary\r\nX-A: quoted-printable\r\nX-Lower: \r\n\r\nhello world\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("F", "", "\r", ""), ("P", "Content-Type: form-data; name=\"k\"", "é ü", "")]), "--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\r\n--B\r\nContent-Type: form-data; name=\"k\"\r\n\r\né ü\r\n--B--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "f\"q", "back\\slash", ""), ("FILE", "f\"q", "é", "--B")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--MyBoundary--\r\n"
  assert_eq write_ops("0123456789", [("P", "Content-Transfer-Encoding: form-data; name=\"k\"", "", "")]), "--0123456789\r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\n\r\n\r\n--0123456789--\r\n"
  assert_eq write_ops("0123456789", [("P", "Content-Transfer-Encoding: attachment; filename=f.bin", "v", "")]), "--0123456789\r\nContent-Transfer-Encoding: attachment; filename=f.bin\r\n\r\nv\r\n--0123456789--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "Content-Type: QUOTED-PRINTABLE|Content-Disposition: QUOTED-PRINTABLE", "hello world", "")]), "--MyBoundary\r\nContent-Disposition: QUOTED-PRINTABLE\r\nContent-Type: QUOTED-PRINTABLE\r\n\r\nhello world\r\n--MyBoundary--\r\n"
  assert_eq write_ops("0123456789", [("P", "Content-Disposition: quoted-printable|X-A: QUOTED-PRINTABLE", "v", ""), ("F", "f\"q", "\n", "")]), "--0123456789\r\nContent-Disposition: quoted-printable\r\nX-A: QUOTED-PRINTABLE\r\n\r\nv\r\n--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\n\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "f\"q", "hello world", ""), ("P", "Content-Disposition: QUOTED-PRINTABLE", "--B", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: QUOTED-PRINTABLE\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "a", "", "\n"), ("P", "Content-Type: v", "é ü", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--0123456789\r\nContent-Type: v\r\n\r\né ü\r\n--0123456789--\r\n"
  assert_eq write_ops("with space", [("F", "field", "line1\r\nline2", "")]), "--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nline1\r\nline2\r\n--with space--\r\n"
  assert_eq write_ops("with space", [("P", "X-A: form-data; name=\"k\"|Content-Transfer-Encoding: QUOTED-PRINTABLE", "\n", "")]), "--with space\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\nX-A: form-data; name=\"k\"\r\n\r\n\n\r\n--with space--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "", "line1\r\nline2", ""), ("P", "Content-Disposition: attachment; filename=f.bin|X-A: ", "=3D", "")]), "--a'()+_,-./:=?b\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: attachment; filename=f.bin\r\nX-A: \r\n\r\n=3D\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "x y", "a", "hello world"), ("P", "", "--B", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--0123456789\r\n\r\n--B\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "a", "line1\r\nline2", ""), ("FILE", "", "é", "hello world"), ("FILE", "f\"q", "", "--B--")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "f\"q", "é", "\r\n--B"), ("F", "back\\slash", "\n", ""), ("P", "x-lower: text/plain|Content-Disposition: 7bit", "\r", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\n\r\n--MyBoundary\r\nContent-Disposition: 7bit\r\nX-Lower: text/plain\r\n\r\n\r\r\n--MyBoundary--\r\n"
  assert_eq write_ops("with space", [("FILE", "f\"q", "", "é ü"), ("F", "back\\slash", "--B--", ""), ("FILE", "field", "n\r\nl", "\r\n--B")]), "--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--with space--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "é", "back\\slash", ""), ("P", "", "--B--", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--a'()+_,-./:=?b\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("FILE", "back\\slash", "field", "--B--"), ("P", "", "--B--", ""), ("P", "x-lower: QUOTED-PRINTABLE", "é ü", "")]), "--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space\r\n\r\n--B--\r\n--with space\r\nX-Lower: QUOTED-PRINTABLE\r\n\r\né ü\r\n--with space--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "field", "é ü", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\né ü\r\n--MyBoundary--\r\n"
  assert_eq write_ops("with space", [("FILE", "é", "é", "--B--")]), "--with space\r\nContent-Disposition: form-data; name=\"é\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space--\r\n"
  assert_eq write_ops("0123456789", [("P", "", "--B--", ""), ("F", "field", "hello world", "")]), "--0123456789\r\n\r\n--B--\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nhello world\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "é", "--B", ""), ("FILE", "back\\slash", "a", "hello world")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "Content-Disposition: quoted-printable", "--B", ""), ("FILE", "", "n\r\nl", "v"), ("P", "X-A: 7bit|x-lower: QUOTED-PRINTABLE", "\r\n--B", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: quoted-printable\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nX-A: 7bit\r\nX-Lower: QUOTED-PRINTABLE\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "n\r\nl", "field", "hello world"), ("FILE", "field", "f\"q", "\r\n--B")]), "--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--0123456789--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "n\r\nl", "field", ""), ("P", "Content-Type: attachment; filename=f.bin|x-lower: quoted-printable", "--B", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--MyBoundary\r\nContent-Type: attachment; filename=f.bin\r\nX-Lower: quoted-printable\r\n\r\n--B\r\n--MyBoundary--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "n\r\nl", "f\"q", "hello world")]), "--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "Content-Type: quoted-printable", "hello world", "")]), "--a'()+_,-./:=?b\r\nContent-Type: quoted-printable\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("FILE", "a", "back\\slash", ""), ("FILE", "x y", "back\\slash", "hello world")]), "--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--with space--\r\n"
  assert_eq write_ops("B", [("F", "back\\slash", "line1\r\nline2", ""), ("FILE", "x y", "n\r\nl", "hello world")]), "--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nline1\r\nline2\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--B--\r\n"
  assert_eq write_ops("B", [("FILE", "é", "back\\slash", "v"), ("FILE", "f\"q", "f\"q", "=3D")]), "--B\r\nContent-Disposition: form-data; name=\"é\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B--\r\n"
  assert_eq write_ops("with space", [("P", "x-lower: |Content-Transfer-Encoding: text/plain", "\r", "")]), "--with space\r\nContent-Transfer-Encoding: text/plain\r\nX-Lower: \r\n\r\n\r\r\n--with space--\r\n"
  assert_eq write_ops("B", [("F", "x y", "line1\r\nline2", "")]), "--B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--B--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "x-lower: form-data; name=k; filename=\"a/b.txt\"", "", "")]), "--a'()+_,-./:=?b\r\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "n\r\nl", "", ""), ("FILE", "a", "x y", "line1\r\nline2"), ("P", "", "\r", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\n\r\n\r\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("B", [("FILE", "back\\slash", "n\r\nl", "v"), ("F", "x y", "", ""), ("P", "Content-Transfer-Encoding: QUOTED-PRINTABLE", "--B--", "")]), "--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--B\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\n\r\n--B--\r\n--B--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "X-A: quoted-printable|Content-Disposition: attachment; filename=f.bin", "\r", ""), ("F", "", "\r", ""), ("F", "field", "", "")]), "--MyBoundary\r\nContent-Disposition: attachment; filename=f.bin\r\nX-A: quoted-printable\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--MyBoundary--\r\n"
  assert_eq write_ops("0123456789", [("P", "Content-Transfer-Encoding: 7bit|X-A: attachment; filename=f.bin", "", "")]), "--0123456789\r\nContent-Transfer-Encoding: 7bit\r\nX-A: attachment; filename=f.bin\r\n\r\n\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "", "f\"q", "é ü"), ("F", "x y", "--B--", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("F", "field", "--B--", ""), ("P", "", "=3D", ""), ("P", "", "\r\n--B", "")]), "--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--with space\r\n\r\n=3D\r\n--with space\r\n\r\n\r\n--B\r\n--with space--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "n\r\nl", "n\r\nl", "v"), ("F", "", "é ü", ""), ("P", "X-A: v|Content-Disposition: attachment; filename=f.bin", "hello world", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\né ü\r\n--0123456789\r\nContent-Disposition: attachment; filename=f.bin\r\nX-A: v\r\n\r\nhello world\r\n--0123456789--\r\n"
  assert_eq write_ops("B", [("FILE", "x y", "field", "\r"), ("FILE", "f\"q", "field", "\n")]), "--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--B--\r\n"
  assert_eq write_ops("B", [("F", "", "é ü", "")]), "--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\né ü\r\n--B--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "", "hello world", ""), ("F", "a", "", ""), ("P", "", "=3D", "")]), "--a'()+_,-./:=?b\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--a'()+_,-./:=?b\r\n\r\n=3D\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("FILE", "", "", "\r\n--B"), ("F", "back\\slash", "\n", "")]), "--with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\n\r\n--with space--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "n\r\nl", "=3D", ""), ("FILE", "é", "n\r\nl", "é ü")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n=3D\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "Content-Transfer-Encoding: attachment; filename=f.bin", "", "")]), "--MyBoundary\r\nContent-Transfer-Encoding: attachment; filename=f.bin\r\n\r\n\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("P", "", "--B", "")]), "--B\r\n\r\n--B\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "x y", "field", "v"), ("F", "back\\slash", "", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "field", "a", "hello world")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "x-lower: 7bit|X-A: v", "\r", ""), ("F", "back\\slash", "--B--", "")]), "--MyBoundary\r\nX-A: v\r\nX-Lower: 7bit\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B--\r\n--MyBoundary--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "x y", "v", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("B", [("FILE", "", "", "=3D")]), "--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "", "\n", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\n\r\n--MyBoundary--\r\n"
  assert_eq write_ops("with space", [("P", "", "line1\r\nline2", "")]), "--with space\r\n\r\nline1\r\nline2\r\n--with space--\r\n"
  assert_eq write_ops("B", no_ops()), "\r\n--B--\r\n"
  assert_eq write_ops("B", [("F", "f\"q", "\r\n--B", "")]), "--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\n--B\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("P", "", "é ü", ""), ("FILE", "a", "é", "hello world"), ("F", "n\r\nl", "", "")]), "--0123456789\r\n\r\né ü\r\n--0123456789\r\nContent-Disposition: form-data; name=\"a\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "a", "", "\n"), ("F", "back\\slash", "--B--", ""), ("FILE", "x y", "n\r\nl", "é ü")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--a'()+_,-./:=?b--\r\n"
}

test "vectors: writer 1" {
  assert_eq write_ops("MyBoundary", [("F", "", "v", ""), ("P", "X-A: v|x-lower: QUOTED-PRINTABLE", "hello world", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nv\r\n--MyBoundary\r\nX-A: v\r\nX-Lower: QUOTED-PRINTABLE\r\n\r\nhello world\r\n--MyBoundary--\r\n"
  assert_eq write_ops("with space", [("FILE", "n\r\nl", "f\"q", "é ü")]), "--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--with space--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "", "=3D", ""), ("P", "X-A: form-data; name=\"k\"|X-A: form-data; name=\"k\"", "line1\r\nline2", ""), ("FILE", "", "f\"q", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nX-A: form-data; name=\"k\"\r\nX-A: form-data; name=\"k\"\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "f\"q", "back\\slash", "hello world"), ("FILE", "", "", "--B--")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary--\r\n"
  assert_eq write_ops("0123456789", [("F", "n\r\nl", "", ""), ("P", "x-lower: form-data; name=k; filename=\"a/b.txt\"|X-A: form-data; name=\"k\"", "", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--0123456789\r\nX-A: form-data; name=\"k\"\r\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n\r\n--0123456789--\r\n"
  assert_eq write_ops("with space", [("P", "Content-Transfer-Encoding: attachment; filename=f.bin|X-A: text/plain", "\r\n--B", ""), ("FILE", "a", "back\\slash", "=3D"), ("F", "a", "é ü", "")]), "--with space\r\nContent-Transfer-Encoding: attachment; filename=f.bin\r\nX-A: text/plain\r\n\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\né ü\r\n--with space--\r\n"
  assert_eq write_ops("0123456789", [("F", "a", "\n", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\n\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "a", "f\"q", "\r\n--B")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "f\"q", "é ü", ""), ("F", "a", "", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("F", "", "line1\r\nline2", ""), ("P", "", "v", ""), ("F", "é", "hello world", "")]), "--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nline1\r\nline2\r\n--B\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nhello world\r\n--B--\r\n"
  assert_eq write_ops("with space", [("FILE", "f\"q", "back\\slash", "--B"), ("FILE", "f\"q", "n\r\nl", "é ü")]), "--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--with space--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "", "--B--", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n--B--\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "back\\slash", "é ü", ""), ("P", "Content-Transfer-Encoding: 7bit|Content-Disposition: quoted-printable", "v", ""), ("P", "", "--B--", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: quoted-printable\r\nContent-Transfer-Encoding: 7bit\r\n\r\nv\r\n--MyBoundary\r\n\r\n--B--\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("FILE", "back\\slash", "field", "v"), ("FILE", "back\\slash", "f\"q", "=3D"), ("P", "X-A: form-data; name=\"k\"", "\r", "")]), "--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--B\r\nX-A: form-data; name=\"k\"\r\n\r\n\r\r\n--B--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "Content-Disposition: quoted-printable|Content-Type: v", "\r\n--B", ""), ("P", "Content-Type: form-data; name=k; filename=\"a/b.txt\"", "--B", ""), ("F", "f\"q", "--B--", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: quoted-printable\r\nContent-Type: v\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Type: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("P", "", "line1\r\nline2", ""), ("P", "Content-Type: QUOTED-PRINTABLE", "line1\r\nline2", ""), ("F", "n\r\nl", "\n", "")]), "--with space\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Type: QUOTED-PRINTABLE\r\n\r\nline1\r\nline2\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\n\r\n--with space--\r\n"
  assert_eq write_ops("0123456789", [("P", "Content-Transfer-Encoding: quoted-printable", "hello world", "")]), "--0123456789\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\nhello world\r\n--0123456789--\r\n"
  assert_eq write_ops("with space", [("F", "", "hello world", ""), ("FILE", "é", "field", "--B--")]), "--with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nhello world\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space--\r\n"
  assert_eq write_ops("0123456789", [("F", "", "line1\r\nline2", ""), ("P", "x-lower: v", "=3D", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nline1\r\nline2\r\n--0123456789\r\nX-Lower: v\r\n\r\n=3D\r\n--0123456789--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "x-lower: |Content-Type: v", "--B", "")]), "--MyBoundary\r\nContent-Type: v\r\nX-Lower: \r\n\r\n--B\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("P", "Content-Type: 7bit|X-A: attachment; filename=f.bin", "hello world", ""), ("FILE", "back\\slash", "n\r\nl", "v")]), "--B\r\nContent-Type: 7bit\r\nX-A: attachment; filename=f.bin\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "Content-Disposition: v|X-A: v", "\n", ""), ("F", "field", "v", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: v\r\nX-A: v\r\n\r\n\n\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("P", "", "\r", ""), ("F", "é", "\r\n--B", ""), ("FILE", "a", "f\"q", "hello world")]), "--with space\r\n\r\n\r\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--with space--\r\n"
  assert_eq write_ops("with space", [("FILE", "x y", "é", "--B")]), "--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--with space--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "x y", "field", "--B--")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "a", "field", "\r"), ("F", "x y", "", ""), ("FILE", "é", "é", "--B")]), "--0123456789\r\nContent-Disposition: form-data; name=\"a\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--0123456789--\r\n"
  assert_eq write_ops("B", [("FILE", "", "n\r\nl", "\r\n--B")]), "--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--B--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "n\r\nl", "é", "v"), ("F", "é", "\r", ""), ("P", "Content-Disposition: quoted-printable", "v", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: quoted-printable\r\n\r\nv\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "Content-Transfer-Encoding: text/plain", "é ü", ""), ("F", "back\\slash", "", ""), ("F", "x y", "line1\r\nline2", "")]), "--MyBoundary\r\nContent-Transfer-Encoding: text/plain\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "", "a", "=3D"), ("F", "f\"q", "\r", ""), ("F", "é", "hello world", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nhello world\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("F", "field", "--B--", "")]), "--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "é", "field", ""), ("P", "X-A: text/plain|Content-Disposition: form-data; name=k; filename=\"a/b.txt\"", "\r\n--B", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--0123456789\r\nContent-Disposition: form-data; name=k; filename=\"a/b.txt\"\r\nX-A: text/plain\r\n\r\n\r\n--B\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "", "hello world", ""), ("F", "f\"q", "\r\n--B", "")]), "--a'()+_,-./:=?b\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("B", [("FILE", "", "back\\slash", "v"), ("FILE", "n\r\nl", "x y", "--B")]), "--B\r\nContent-Disposition: form-data; name=\"\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "field", "=3D", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n=3D\r\n--MyBoundary--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "n\r\nl", "é", "line1\r\nline2")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("F", "a", "--B", "")]), "--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n--B\r\n--with space--\r\n"
  assert_eq write_ops("B", [("FILE", "x y", "", "hello world"), ("F", "x y", "line1\r\nline2", "")]), "--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--B--\r\n"
  assert_eq write_ops("with space", [("F", "x y", "=3D", ""), ("FILE", "é", "n\r\nl", "\r")]), "--with space\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"é\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--with space--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "", "x y", "line1\r\nline2"), ("P", "Content-Disposition: text/plain", "\n", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\nContent-Disposition: text/plain\r\n\r\n\n\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "back\\slash", "é", ""), ("F", "n\r\nl", "hello world", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nhello world\r\n--MyBoundary--\r\n"
  assert_eq write_ops("with space", [("F", "n\r\nl", "\r", "")]), "--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\r\n--with space--\r\n"
  assert_eq write_ops("with space", [("FILE", "field", "f\"q", "=3D"), ("FILE", "", "back\\slash", "é ü")]), "--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--with space--\r\n"
  assert_eq write_ops("B", [("F", "", "\r\n--B", ""), ("P", "", "line1\r\nline2", "")]), "--B\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\n--B\r\n--B\r\n\r\nline1\r\nline2\r\n--B--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "", "hello world", ""), ("P", "", "é ü", ""), ("FILE", "back\\slash", "a", "\n")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\n\r\né ü\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "", "é ü", ""), ("FILE", "a", "é", "\n"), ("P", "Content-Transfer-Encoding: v|Content-Disposition: v", "\n", "")]), "--MyBoundary\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--MyBoundary\r\nContent-Disposition: v\r\nContent-Transfer-Encoding: v\r\n\r\n\n\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "Content-Transfer-Encoding: QUOTED-PRINTABLE|Content-Type: attachment; filename=f.bin", "--B--", ""), ("F", "a", "line1\r\nline2", ""), ("P", "Content-Type: form-data; name=\"k\"", "\r", "")]), "--MyBoundary\r\nContent-Transfer-Encoding: QUOTED-PRINTABLE\r\nContent-Type: attachment; filename=f.bin\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nline1\r\nline2\r\n--MyBoundary\r\nContent-Type: form-data; name=\"k\"\r\n\r\n\r\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "", "é", "\n")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "", "v", ""), ("FILE", "f\"q", "field", ""), ("FILE", "é", "", "v")]), "--MyBoundary\r\n\r\nv\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--MyBoundary--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "f\"q", "f\"q", "=3D"), ("FILE", "n\r\nl", "field", "hello world"), ("F", "x y", "--B", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n--B\r\n--0123456789--\r\n"
  assert_eq write_ops("with space", [("FILE", "back\\slash", "x y", "--B")]), "--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--with space--\r\n"
  assert_eq write_ops("with space", [("F", "back\\slash", "", ""), ("F", "back\\slash", "=3D", ""), ("F", "a", "hello world", "")]), "--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nhello world\r\n--with space--\r\n"
  assert_eq write_ops("with space", [("FILE", "a", "a", "--B--"), ("FILE", "f\"q", "é", "\n")]), "--with space\r\nContent-Disposition: form-data; name=\"a\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "f\"q", "field", "\r\n--B"), ("P", "", "\r", ""), ("F", "back\\slash", "v", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--0123456789\r\n\r\n\r\r\n--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nv\r\n--0123456789--\r\n"
  assert_eq write_ops("0123456789", [("P", "x-lower: v", "", "")]), "--0123456789\r\nX-Lower: v\r\n\r\n\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "Content-Transfer-Encoding: 7bit", "--B--", ""), ("P", "", "--B--", "")]), "--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: 7bit\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("F", "a", "--B", ""), ("F", "back\\slash", "\r", ""), ("FILE", "back\\slash", "a", "é ü")]), "--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\r\n--with space\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--with space--\r\n"
  assert_eq write_ops("with space", [("FILE", "x y", "", "\r\n--B"), ("F", "a", "é ü", "")]), "--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\né ü\r\n--with space--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "n\r\nl", "n\r\nl", "--B--")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary--\r\n"
  assert_eq write_ops("with space", [("P", "X-A: attachment; filename=f.bin|x-lower: text/plain", "\r", ""), ("P", "", "\r", ""), ("P", "Content-Type: ", "\r", "")]), "--with space\r\nX-A: attachment; filename=f.bin\r\nX-Lower: text/plain\r\n\r\n\r\r\n--with space\r\n\r\n\r\r\n--with space\r\nContent-Type: \r\n\r\n\r\r\n--with space--\r\n"
  assert_eq write_ops("B", [("P", "x-lower: attachment; filename=f.bin", "", "")]), "--B\r\nX-Lower: attachment; filename=f.bin\r\n\r\n\r\n--B--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "é", "x y", "line1\r\nline2"), ("P", "x-lower: 7bit", "v", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nX-Lower: 7bit\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("0123456789", [("F", "é", "é ü", ""), ("P", "", "", ""), ("F", "x y", "é ü", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\né ü\r\n--0123456789\r\n\r\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\né ü\r\n--0123456789--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "a", "a", "=3D"), ("P", "Content-Disposition: text/plain|Content-Transfer-Encoding: quoted-printable", "hello world", ""), ("F", "f\"q", "hello world", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"a\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789\r\nContent-Disposition: text/plain\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\nhello world\r\n--0123456789--\r\n"
  assert_eq write_ops("B", [("F", "n\r\nl", "--B", ""), ("P", "", "é ü", "")]), "--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B\r\n--B\r\n\r\né ü\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("P", "x-lower: 7bit", "--B--", "")]), "--0123456789\r\nX-Lower: 7bit\r\n\r\n--B--\r\n--0123456789--\r\n"
  assert_eq write_ops("with space", [("FILE", "n\r\nl", "a", "v")]), "--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--with space--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "field", "", ""), ("FILE", "field", "n\r\nl", "hello world")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("FILE", "back\\slash", "back\\slash", "é ü"), ("FILE", "a", "a", "hello world"), ("P", "", "--B", "")]), "--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--B\r\nContent-Disposition: form-data; name=\"a\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--B\r\n\r\n--B\r\n--B--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "", "", "v")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "back\\slash", "back\\slash", "=3D")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "n\r\nl", "hello world", ""), ("FILE", "a", "back\\slash", "--B--")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n"
}

test "vectors: writer 2" {
  assert_eq write_ops("MyBoundary", [("P", "x-lower: 7bit|Content-Transfer-Encoding: quoted-printable", "\n", "")]), "--MyBoundary\r\nContent-Transfer-Encoding: quoted-printable\r\nX-Lower: 7bit\r\n\r\n\n\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "", "é", "--B--")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "Content-Type: form-data; name=k; filename=\"a/b.txt\"", "\n", ""), ("F", "é", "\r", ""), ("P", "Content-Type: v", "\r", "")]), "--MyBoundary\r\nContent-Type: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\r\r\n--MyBoundary\r\nContent-Type: v\r\n\r\n\r\r\n--MyBoundary--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "x y", "back\\slash", "\r\n--B"), ("F", "back\\slash", "\r\n--B", ""), ("P", "Content-Type: QUOTED-PRINTABLE", "--B", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Type: QUOTED-PRINTABLE\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("B", [("FILE", "x y", "back\\slash", "\r")]), "--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--B--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "", "\r", ""), ("F", "n\r\nl", "\r\n--B", "")]), "--a'()+_,-./:=?b\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "", "v", ""), ("F", "é", "line1\r\nline2", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"\"\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "X-A: 7bit", "=3D", ""), ("P", "", "v", "")]), "--MyBoundary\r\nX-A: 7bit\r\n\r\n=3D\r\n--MyBoundary\r\n\r\nv\r\n--MyBoundary--\r\n"
  assert_eq write_ops("0123456789", [("P", "Content-Disposition: 7bit|Content-Transfer-Encoding: text/plain", "\r", ""), ("F", "field", "é ü", "")]), "--0123456789\r\nContent-Disposition: 7bit\r\nContent-Transfer-Encoding: text/plain\r\n\r\n\r\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\né ü\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "a", "x y", "--B--"), ("P", "X-A: attachment; filename=f.bin", "\r", ""), ("FILE", "x y", "a", "hello world")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nX-A: attachment; filename=f.bin\r\n\r\n\r\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "", "n\r\nl", "hello world"), ("FILE", "f\"q", "field", "é ü")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("P", "Content-Disposition: 7bit", "é ü", ""), ("FILE", "field", "back\\slash", "--B--")]), "--B\r\nContent-Disposition: 7bit\r\n\r\né ü\r\n--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("P", "Content-Transfer-Encoding: quoted-printable|X-A: v", "é ü", ""), ("FILE", "é", "", "hello world")]), "--0123456789\r\nContent-Transfer-Encoding: quoted-printable\r\nX-A: v\r\n\r\né ü\r\n--0123456789\r\nContent-Disposition: form-data; name=\"é\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "x y", "=3D", ""), ("FILE", "back\\slash", "a", "=3D"), ("F", "field", "", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "x y", "--B", ""), ("FILE", "back\\slash", "field", "é ü"), ("FILE", "", "", "\r\n--B")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--MyBoundary--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "Content-Type: form-data; name=\"k\"", "v", ""), ("F", "n\r\nl", "--B--", ""), ("FILE", "back\\slash", "x y", "v")]), "--a'()+_,-./:=?b\r\nContent-Type: form-data; name=\"k\"\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("0123456789", [("P", "X-A: ", "line1\r\nline2", "")]), "--0123456789\r\nX-A: \r\n\r\nline1\r\nline2\r\n--0123456789--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "", "back\\slash", "v")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--MyBoundary--\r\n"
  assert_eq write_ops("with space", [("FILE", "field", "f\"q", "--B"), ("F", "a", "--B", "")]), "--with space\r\nContent-Disposition: form-data; name=\"field\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--with space\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n--B\r\n--with space--\r\n"
  assert_eq write_ops("with space", [("P", "", "\r", ""), ("FILE", "", "é", "\n")]), "--with space\r\n\r\n\r\r\n--with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("F", "n\r\nl", "\r\n--B", ""), ("P", "x-lower: form-data; name=k; filename=\"a/b.txt\"|Content-Disposition: form-data; name=k; filename=\"a/b.txt\"", "", ""), ("P", "", "v", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--B\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=k; filename=\"a/b.txt\"\r\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n\r\n--a'()+_,-./:=?b\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("B", [("FILE", "a", "field", "é ü"), ("F", "back\\slash", "", "")]), "--B\r\nContent-Disposition: form-data; name=\"a\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\n\r\n--B--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "Content-Type: QUOTED-PRINTABLE|Content-Disposition: ", "é ü", ""), ("P", "Content-Disposition: v", "\n", "")]), "--MyBoundary\r\nContent-Disposition: \r\nContent-Type: QUOTED-PRINTABLE\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: v\r\n\r\n\n\r\n--MyBoundary--\r\n"
  assert_eq write_ops("0123456789", [("P", "Content-Type: form-data; name=\"k\"", "hello world", ""), ("FILE", "a", "f\"q", "hello world"), ("F", "", "\r", "")]), "--0123456789\r\nContent-Type: form-data; name=\"k\"\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"a\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\r\r\n--0123456789--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "field", "back\\slash", "--B--")]), "--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--0123456789--\r\n"
  assert_eq write_ops("B", [("P", "", "--B--", "")]), "--B\r\n\r\n--B--\r\n--B--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "Content-Disposition: 7bit|Content-Type: 7bit", "hello world", ""), ("FILE", "a", "f\"q", "v"), ("F", "n\r\nl", "\n", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: 7bit\r\nContent-Type: 7bit\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "a", "x y", "line1\r\nline2")]), "--0123456789\r\nContent-Disposition: form-data; name=\"a\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--0123456789--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "field", "--B--", ""), ("P", "", "=3D", ""), ("FILE", "n\r\nl", "back\\slash", "é ü")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B--\r\n--MyBoundary\r\n\r\n=3D\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("FILE", "field", "field", "--B")]), "--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B--\r\n"
  assert_eq write_ops("with space", [("FILE", "f\"q", "n\r\nl", "hello world"), ("FILE", "x y", "", "hello world")]), "--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--with space\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--with space--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "x-lower: text/plain", "line1\r\nline2", "")]), "--a'()+_,-./:=?b\r\nX-Lower: text/plain\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("P", "X-A: quoted-printable|X-A: attachment; filename=f.bin", "=3D", ""), ("FILE", "n\r\nl", "", "=3D")]), "--with space\r\nX-A: quoted-printable\r\nX-A: attachment; filename=f.bin\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--with space--\r\n"
  assert_eq write_ops("B", [("FILE", "x y", "", "--B"), ("F", "é", "é ü", "")]), "--B\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\né ü\r\n--B--\r\n"
  assert_eq write_ops("B", [("FILE", "field", "n\r\nl", "--B")]), "--B\r\nContent-Disposition: form-data; name=\"field\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n--B\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("P", "", "", ""), ("FILE", "x y", "é", "")]), "--0123456789\r\n\r\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--0123456789--\r\n"
  assert_eq write_ops("B", [("F", "back\\slash", "hello world", ""), ("P", "Content-Transfer-Encoding: quoted-printable|Content-Disposition: quoted-printable", "line1\r\nline2", "")]), "--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nhello world\r\n--B\r\nContent-Disposition: quoted-printable\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\nline1\r\nline2\r\n--B--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "n\r\nl", "field", "--B--"), ("P", "Content-Transfer-Encoding: form-data; name=\"k\"|X-A: QUOTED-PRINTABLE", "hello world", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: form-data; name=\"k\"\r\nX-A: QUOTED-PRINTABLE\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("with space", [("P", "", "v", "")]), "--with space\r\n\r\nv\r\n--with space--\r\n"
  assert_eq write_ops("with space", [("FILE", "é", "a", "\n"), ("F", "field", "=3D", ""), ("P", "", "hello world", "")]), "--with space\r\nContent-Disposition: form-data; name=\"é\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n=3D\r\n--with space\r\n\r\nhello world\r\n--with space--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "a", "field", "é ü"), ("FILE", "x y", "a", "line1\r\nline2"), ("F", "é", "--B--", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n--B--\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "é", "", ""), ("P", "", "\r\n--B", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n\r\n--MyBoundary\r\n\r\n\r\n--B\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("P", "X-A: attachment; filename=f.bin|Content-Type: QUOTED-PRINTABLE", "", ""), ("F", "field", "--B", ""), ("F", "field", "", "")]), "--B\r\nContent-Type: QUOTED-PRINTABLE\r\nX-A: attachment; filename=f.bin\r\n\r\n\r\n--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B\r\n--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\n--B--\r\n"
  assert_eq write_ops("with space", [("F", "field", "--B", "")]), "--with space\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n--B\r\n--with space--\r\n"
  assert_eq write_ops("B", [("P", "X-A: attachment; filename=f.bin", "v", ""), ("FILE", "f\"q", "a", "--B--"), ("F", "é", "line1\r\nline2", "")]), "--B\r\nX-A: attachment; filename=f.bin\r\n\r\nv\r\n--B\r\nContent-Disposition: form-data; name=\"f\\\"q\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nline1\r\nline2\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "back\\slash", "f\"q", "\n"), ("F", "", "é ü", ""), ("P", "", "", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\né ü\r\n--0123456789\r\n\r\n\r\n--0123456789--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "", "=3D", "")]), "--a'()+_,-./:=?b\r\n\r\n=3D\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "n\r\nl", "back\\slash", "\r"), ("FILE", "a", "n\r\nl", "=3D")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "field", "\r", ""), ("P", "Content-Disposition: form-data; name=\"k\"|X-A: v", "é ü", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\r\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"k\"\r\nX-A: v\r\n\r\né ü\r\n--MyBoundary--\r\n"
  assert_eq write_ops("MyBoundary", [("F", "field", "\n", ""), ("F", "a", "hello world", ""), ("P", "", "line1\r\nline2", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\n\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nhello world\r\n--MyBoundary\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n"
  assert_eq write_ops("0123456789", [("F", "back\\slash", "line1\r\nline2", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nline1\r\nline2\r\n--0123456789--\r\n"
  assert_eq write_ops("with space", [("P", "", "hello world", "")]), "--with space\r\n\r\nhello world\r\n--with space--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "a", "n\r\nl", "é ü")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("0123456789", [("P", "Content-Disposition: attachment; filename=f.bin", "--B--", "")]), "--0123456789\r\nContent-Disposition: attachment; filename=f.bin\r\n\r\n--B--\r\n--0123456789--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "n\r\nl", "é", "--B--"), ("F", "a", "é ü", ""), ("F", "é", "line1\r\nline2", "")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\n--B--\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\né ü\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("P", "Content-Disposition: form-data; name=\"k\"", "\n", ""), ("F", "back\\slash", "line1\r\nline2", ""), ("P", "Content-Type: form-data; name=k; filename=\"a/b.txt\"", "--B--", "")]), "--B\r\nContent-Disposition: form-data; name=\"k\"\r\n\r\n\n\r\n--B\r\nContent-Disposition: form-data; name=\"back\\\\slash\"\r\n\r\nline1\r\nline2\r\n--B\r\nContent-Type: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n--B--\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("F", "f\"q", "", ""), ("FILE", "field", "field", "hello world")]), "--0123456789\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n\r\n--0123456789\r\nContent-Disposition: form-data; name=\"field\"; filename=\"field\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--0123456789--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "back\\slash", "f\"q", "\r\n--B"), ("F", "n\r\nl", "", ""), ("FILE", "é", "n\r\nl", "\r")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\n--B\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\n\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"; filename=\"n%0D%0Al\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--MyBoundary--\r\n"
  assert_eq write_ops("B", [("F", "x y", "é ü", "")]), "--B\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\né ü\r\n--B--\r\n"
  assert_eq write_ops("B", [("F", "a", "--B", ""), ("P", "Content-Type: text/plain", "", "")]), "--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n--B\r\n--B\r\nContent-Type: text/plain\r\n\r\n\r\n--B--\r\n"
  assert_eq write_ops("with space", [("P", "Content-Transfer-Encoding: form-data; name=k; filename=\"a/b.txt\"", "é ü", ""), ("P", "Content-Disposition: |x-lower: form-data; name=k; filename=\"a/b.txt\"", "--B--", "")]), "--with space\r\nContent-Transfer-Encoding: form-data; name=k; filename=\"a/b.txt\"\r\n\r\né ü\r\n--with space\r\nContent-Disposition: \r\nX-Lower: form-data; name=k; filename=\"a/b.txt\"\r\n\r\n--B--\r\n--with space--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("P", "Content-Transfer-Encoding: quoted-printable|Content-Transfer-Encoding: ", "v", "")]), "--a'()+_,-./:=?b\r\nContent-Transfer-Encoding: quoted-printable\r\nContent-Transfer-Encoding: \r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("a'()+_,-./:=?b", [("FILE", "n\r\nl", "é", "hello world"), ("F", "n\r\nl", "hello world", "")]), "--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"é\"\r\nContent-Type: application/octet-stream\r\n\r\nhello world\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"\r\n\r\nhello world\r\n--a'()+_,-./:=?b--\r\n"
  assert_eq write_ops("MyBoundary", [("P", "Content-Type: text/plain", "\r", ""), ("P", "Content-Type: quoted-printable|Content-Type: quoted-printable", "", "")]), "--MyBoundary\r\nContent-Type: text/plain\r\n\r\n\r\r\n--MyBoundary\r\nContent-Type: quoted-printable\r\nContent-Type: quoted-printable\r\n\r\n\r\n--MyBoundary--\r\n"
  assert_eq write_ops("with space", [("P", "", "=3D", ""), ("FILE", "", "a", "\r")]), "--with space\r\n\r\n=3D\r\n--with space\r\nContent-Disposition: form-data; name=\"\"; filename=\"a\"\r\nContent-Type: application/octet-stream\r\n\r\n\r\r\n--with space--\r\n"
  assert_eq write_ops("MyBoundary", [("FILE", "é", "x y", "line1\r\nline2")]), "--MyBoundary\r\nContent-Disposition: form-data; name=\"é\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\nline1\r\nline2\r\n--MyBoundary--\r\n"
  assert_eq write_ops("0123456789", [("F", "x y", "line1\r\nline2", ""), ("F", "x y", "\r\n--B", ""), ("P", "x-lower: v", "--B", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\nline1\r\nline2\r\n--0123456789\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\r\n--B\r\n--0123456789\r\nX-Lower: v\r\n\r\n--B\r\n--0123456789--\r\n"
  assert_eq write_ops("0123456789", [("FILE", "n\r\nl", "x y", "=3D")]), "--0123456789\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"x y\"\r\nContent-Type: application/octet-stream\r\n\r\n=3D\r\n--0123456789--\r\n"
  assert_eq write_ops("with space", [("F", "", "\n", "")]), "--with space\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\n\r\n--with space--\r\n"
  assert_eq write_ops("B", [("P", "x-lower: attachment; filename=f.bin|Content-Disposition: quoted-printable", "é ü", ""), ("F", "field", "line1\r\nline2", ""), ("P", "x-lower: QUOTED-PRINTABLE", "--B--", "")]), "--B\r\nContent-Disposition: quoted-printable\r\nX-Lower: attachment; filename=f.bin\r\n\r\né ü\r\n--B\r\nContent-Disposition: form-data; name=\"field\"\r\n\r\nline1\r\nline2\r\n--B\r\nX-Lower: QUOTED-PRINTABLE\r\n\r\n--B--\r\n--B--\r\n"
  assert_eq write_ops("with space", [("P", "", "=3D", "")]), "--with space\r\n\r\n=3D\r\n--with space--\r\n"
  assert_eq write_ops("with space", [("F", "f\"q", "--B--", ""), ("P", "Content-Type: form-data; name=\"k\"|X-A: form-data; name=\"k\"", "\n", ""), ("P", "", "--B--", "")]), "--with space\r\nContent-Disposition: form-data; name=\"f\\\"q\"\r\n\r\n--B--\r\n--with space\r\nContent-Type: form-data; name=\"k\"\r\nX-A: form-data; name=\"k\"\r\n\r\n\n\r\n--with space\r\n\r\n--B--\r\n--with space--\r\n"
  assert_eq write_ops("B", [("F", "é", "=3D", "")]), "--B\r\nContent-Disposition: form-data; name=\"é\"\r\n\r\n=3D\r\n--B--\r\n"
  assert_eq write_ops("B", [("P", "", "", ""), ("P", "", "line1\r\nline2", "")]), "--B\r\n\r\n\r\n--B\r\n\r\nline1\r\nline2\r\n--B--\r\n"
  assert_eq write_ops("0123456789", [("F", "", "\n", "")]), "--0123456789\r\nContent-Disposition: form-data; name=\"\"\r\n\r\n\n\r\n--0123456789--\r\n"
}

test "vectors: parse 0" {
  assert_eq parse_render("\r\n\n--with space--\n", "with space", true), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("\r\n--with space--\r\n", "with space", false), ""
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-dat", "MyBoundary", false), ""
  assert_eq parse_render("\r\n-B--\r\n", "B", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("--a'()+_,-./:=?b\nContent-Disposition: form-data; name=\"back\\\\slash\"; filename=\"x y\"\nContent-Type: application/octet-stream\n\n=3D\n--a'()+_,-./:=?b\nX-A: text/plain\nX-Lower: text/plain\n\né ü\n--a'()+_,-./:=?b--\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"back\\\\slash\"; filename=\"x y\"];Content-Type=[application/octet-stream]} form=back\\slash file=x y body=<=3D>\n{X-A=[text/plain];X-Lower=[text/plain]} form= file= body=<é ü>"
  assert_eq parse_render("\r\n\r\n--with space", "with space", false), "ERR multipart: NextPart: EOF"
  assert_eq parse_render("preamble\r\npreamble\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"back\\\\slash\"\r\nContent-Type: application/octet-stream\r\n\r\nv\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"a\"; filename=\"back\\\\slash\"];Content-Type=[application/octet-stream]} form=a file=back\\slash body=<v>"
  assert_eq parse_render("--B\r\nCon", "B", true), "ERR malformed MIME header: missing colon: \"Con\""
