  assert_eq parse_render("\r\n--with space\r\n\r\nhello world\r\n--with space\r\n", "with space", true), "{} form= file= body=<hello world>"
  assert_eq parse_render("preamble\r\n--a'()+_,-./:=?b\r\nContent-Disposition: form-data; name=\"x y\"\r\n\r\n\n\r\n--a'()+_,-./:=?b--\r\n", "a'()+_,-./:=?b", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<\n>"
  assert_eq parse_render("--MyBoundary\r\nContent-Disposition: form-data; name=\"\"; filename=\"f\\\"q\"\r\nContent-Type: application/octet-stream\r\n\r\n\n\r\n--MyBoundary\r\nContent-Disposition: text/plain\r\n\r\nhello world\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"a\"; filename=\"x y\"\r\nContent-Type: application/octe", "MyBoundary", true), "{Content-Disposition=[form-data; name=\"\"; filename=\"f\\\"q\"];Content-Type=[application/octet-stream]} form= file=f\"q body=<\n>\n{Content-Disposition=[text/plain]} form= file= body=<hello world>"
  assert_eq parse_render("--with space\nContent-Disposition: form-data; name=\"x y\"\n\n--B--\n--with space--\n", "with space", false), "{Content-Disposition=[form-data; name=\"x y\"]} form=x y file= body=<--B-->"
  assert_eq parse_render("--B\r\nContent-Disposition: form-data; name=\"n%0D%0Al\"; filename=\"\"\r\nContent-Type: application/octet-stream\r\n\r\né ü\r\n--B--\r\nepilogue\r\n", "B", true), "{Content-Disposition=[form-data; name=\"n%0D%0Al\"; filename=\"\"];Content-Type=[application/octet-stream]} form=n%0D%0Al file= body=<é ü>"
