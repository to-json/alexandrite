  assert_eq qp_dec(hx("463d200d0a013de97e613d3d3d30413d43333d41393d0d0a303d0d0a3d3041660a0a3d3344200a61")), ("F", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r=3D=0Af=g=\r\na\x01\t\na=F \r\n\r\n\t = \r\n"), ("\r=\nf=ga", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(" Z\t=3D0=C3=A9=\r\n=\n"), (" Z\t=0é", "")
  assert_eq qp_dec("F"), ("F", "")
  assert_eq qp_dec(hx("e93d3041")), (hx("e90a"), "")
  assert_eq qp_dec("Daa\r =\n=\r\n=g=C3=A9=0AZ=\n \n=C3=A9~=g\t=g\r=0A=C3=A9"), ("Daa\r =gé\nZ\né~=g\t=g\r\né", "")
  assert_eq qp_dec(hx("e93d0d0a6144303d203d200d0a660a4420443d3041")), (hx("e96144303d20660a4420440a"), "")
  assert_eq qp_dec(hx("3d304130e9")), (hx("0a30e9"), "")
  assert_eq qp_dec("=\r\n\x01=0AD\r\na==\r\n\r\n0=F"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0d7e443d0a660d0d3d0d0a5a7e3d3344202009e96166")), (hx("0d7e44660d0d5a7e3d202009e96166"), "")
  assert_eq qp_dec("=0AD= \r\nf=\n"), ("\nDf", "")
  assert_eq qp_dec("=\r\n\r\n\x01"), ("\r\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d200a3d673d33443d3041010a46200a30013d0a3d200d0ae9")), ("=g=\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\t\t"), ("", "")
  assert_eq qp_dec("a=3DD\x01=g=\nF=3D~\n\n=0D\x01"), ("a=D", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("0 ~\n=g\r\tZ=\r\n\x01\r\r\n\r\n\t\r=0A\na=3D0"), ("0 ~\n=g\r\tZ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\n=\r\n=\r\n= \r\n=g~~"), ("\n=g~~", "")
  assert_eq qp_dec("af=C3=A9\t="), ("afé\t", "")
  assert_eq qp_dec(hx("303d0d0a30e97e3061613d0d0a3d0a663d0d0a3d200d0a66")), (hx("3030e97e3061616666"), "")
  assert_eq qp_dec("= \r\n\r=0=\n \r=0A\n==3D~D=g\r\n0Z=0ADa"), ("\r=0 \r\n\n==~D=g\r\n0Z\nDa", "")
  assert_eq qp_dec("\taF=\r\n=3D"), ("\taF=", "")
  assert_eq qp_dec("=\r\na\tfD=3DF=C3=A9=g= \r\n "), ("a\tfD=Fé=g", "")
  assert_eq qp_dec(hx("3d33443d43333d41393d3344e93d43333d41395a3d304130463d0d0a3d0d0a2061")), (hx("3dc3a93de9c3a95a0a30462061"), "")
  assert_eq qp_dec(hx("610a3d33443d33440d0a0d0a66e93d0d0a660a093d3041e93d0d0a3d33447e093d33440a3d0d0a")), (hx("610a3d3d0d0a0d0a66e9660a090ae93d7e093d0a"), "")
  assert_eq qp_dec("~\rf "), ("~\rf", "")
  assert_eq qp_dec("a\x01F= \r\n=\x01= \r\nZ\r=C3=A9f= \r\na\r\nF=0A\n\n\n0f"), ("a", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(" \r\x010~\r"), (" \r", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("307e3d6730e90de9203d0a3d445a")), (hx("307e3d6730e90de9203d445a"), "")
  assert_eq qp_dec("=3DD=C3=A9 =\r\n=0AfZ \ta=C3=A9\t\x01"), ("=Dé \nfZ \taé\t", "quotedprintable: invalid unescaped byte 0x01 in body")
}
