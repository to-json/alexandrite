  assert_eq qp_dec(hx("46013d090a0a7e3d0d0a3d43333d41390a7e3d67e95a0a3d0a7e3d200d0a7e3d200d0a01")), ("F", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\nff 0"), ("ff 0", "")
