  assert_eq qp_dec(hx("3d33440d0a61203d0ae961463d3344013d0d0a3d0d0a010101013d43333d4139093d0d0a3d43333d4139660d")), (hx("3d0d0a6120e961463d"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("44440de93d6761e9e90909")), (hx("44440de93d6761e9e9"), "")
  assert_eq qp_dec(hx("4601663d43333d41390d0ae95a0a3d200d0a0d303d0d0a3d30413d0a46")), ("F", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=3D\r\n=0A= \r\n=\r\n\n=g"), ("=\r\n\n\n=g", "")
