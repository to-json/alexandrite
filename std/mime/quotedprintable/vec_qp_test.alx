  assert_eq qp_dec(hx("3d67463d3344e90a5a3d3344")), (hx("3d67463de90a5a3d"), "")
  assert_eq qp_dec("=\n\x01DF ==0AZ\t=\r\n \r\n=gDa0f=\n"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=0A= \r\na~0=C3=A9\raZZ\nZ=\r\nD\r\n=3D~~= \r\n0=\nF"), ("\na~0é\raZZ\nZD\r\n=~~0F", "")
  assert_eq qp_dec(hx("010d0a613d0a3d7e3d01463d43333d41390d44207e4409446646e9")), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec("\r\n=3DFD~=g"), ("\r\n=FD~=g", "")
  assert_eq qp_dec(" =\r\n=\n=C3=A9"), (" é", "")
  assert_eq qp_dec(hx("0a3d0a3de90d5a3d0d0a3d0a66e9443d43333d41397e3d3344013d43333d41390a443d30413d3344")), (hx("0a3de90d5a66e944c3a97e3d"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\n0~0=gZ\r\x01=g0f"), ("0~0=gZ\r", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0d3d200d0a0a3d0a3d0d0a203d0a66303d0a46e97e3d33440130")), (hx("0d0a20663046e97e3d"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\t=0A=g =g\nZDfa~\tf=C3=A9=\nZ\tD=0A=\r\n"), ("\t\n=g =g\nZDfa~\tféZ\tD\n", "")
  assert_eq qp_dec("\r\n\n= \r\n\r\n~= \r\n\n"), ("\r\n\n\r\n~\n", "")
  assert_eq qp_dec("a"), ("a", "")
  assert_eq qp_dec(hx("3d3041305a30e93d43333d4139663d0d0a5a3d3344447e613d200d0a20303d613d0d0a3d6701")), (hx("0a305a30e9c3a9665a3d447e6120303d613d67"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d673d0a0d0a300d0a093d43333d4139093d33443d43333d41393d304120093d0d0ae9")), (hx("3d670d0a300d0a09c3a9093dc3a90a2009e9"), "")
  assert_eq qp_dec("\x01f==Z"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\n==0A\r=gZ= \r\n0"), ("\n=\n\r=gZ0", "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("460a2020465a3d3041013d303030e9e93d43333d41393d4401203d304101")), ("F\n  FZ\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0d01e9093d43333d4139443d0d0a")), ("\r", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0d0ae9013d43333d41393d673d0a3d3041663d0d0a3d3344660d3d")), (hx("0d0ae9"), "quotedprintable: invalid unescaped byte 0x01 in body")
}

test "vectors: reader 6" {
  assert_eq qp_dec(hx("e95a203d0d0a09660d7e0d3d0d0a2046203d200d0a443d0d0a0d0a3d0d0ae90d0a")), (hx("e95a2009660d7e0d204620440d0ae90d0a"), "")
  assert_eq qp_dec("\r\nf=C3=A9F=\n\t0\r\n0Z=\n\t=C3=A9= \r\n~Z"), ("\r\nféF\t0\r\n0Z\té~Z", "")
  assert_eq qp_dec(hx("66013d0a5a3d200d0a610d3d200d0a3d673d5a613d0a3d43333d4139e93d200d0a")), ("f", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("af\x01"), ("af", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=C3=A9\r\nZZ\x01Df=3D\rFZ"), ("é\r\nZZ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("~Z\r\n"), ("~Z\r\n", "")
  assert_eq qp_dec(hx("61e93d0d0a6130207e7e46")), (hx("61e96130207e7e46"), "")
  assert_eq qp_dec("=g\raD==g\x01\t=a"), ("=g\raD==g", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("3d67443d200d0a7ee90d0a3d0a203066203d200d0a5a0d5a61")), (hx("3d67447ee90d0a203066205a0d5a61"), "")
  assert_eq qp_dec(hx("666644463d0a467e46e93d0a090a3d43333d41390ae9463d0a3d0ae909")), (hx("66664446467e46e90ac3a90ae946e9"), "")
  assert_eq qp_dec("==3D =0A"), ("== \n", "")
  assert_eq qp_dec("=\nFDZ=\r\nZ\rF"), ("FDZZ\rF", "")
  assert_eq qp_dec("Z=3D=\r\n~=gZD= \r\n=\r\n\tf\r\n\x01D==C3=A9a0"), ("Z=~=gZD\tf\r\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(" \r\n \r\nFF"), ("\r\n\r\nFF", "")
  assert_eq qp_dec(hx("6109e9e9463d0d")), (hx("6109e9e946"), "quotedprintable: invalid bytes after =: \"\\r\"")
  assert_eq qp_dec(hx("e96130e9663d30413d0a0d0a5a")), (hx("e96130e9660a0d0a5a"), "")
  assert_eq qp_dec("=0A=\r\nF=\r\n a=3D=C3=A9Z=\n\n\r\r\n~F\x01=\r\n\n0\r=0A=C3=A9"), ("\nF a=éZ\n\r\n~F", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=C3=A9=gaZZ=0A=0A= \r\n0= \r\n"), ("é=gaZZ\n\n0", "")
  assert_eq qp_dec("\rD\r=\r\n\nF=C3=A9\nZD"), ("\rD\r\nFé\nZD", "")
  assert_eq qp_dec(hx("30203d43333d41397e443d200d0a3d67e93d0a0a0ae9207e3d0d0a46613d33443d43333d41393d200d0a013d43333d4139")), (hx("3020c3a97e443d67e90a0ae9207e46613dc3a9"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d67013d3344303d013d463d3041615ae90d613d304101440d3d0d0a0d0a")), ("=g", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d3041443d0a7e3d200d0a3d200d0a0d3d43333d413901e93d30410a3d200d0a663d43333d413920090a46094630")), ("\nD~\ré", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=0A\n\rZ\n=g=ga "), ("\n\n\rZ\n=g=ga", "")
  assert_eq qp_dec(hx("3d6761013d30413d0d0a095a61663d200d0a463d33440de9463d200d0a3d30413044")), ("=ga", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("5a200d0a30e944613d200d0a0a0a3d3d200d0a3d43333d41393d334420663d0d3d465a3d3d33440d")), (hx("5a0d0a30e944610a0a"), "unexpected EOF")
  assert_eq qp_dec("=\n=ga\nD\tZ"), ("=ga\nD\tZ", "")
  assert_eq qp_dec("\x01F= \r\n=0A \r=\r\n\r=3Df\x01Z=3D=g~"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\nD~ a=0A=0Aa=g\r\n=C3=A9= \r\n"), ("\nD~ a\n\na=g\r\né", "")
  assert_eq qp_dec("=\nZ \rZ=C3=A90=3Da=0A=0AD"), ("Z \rZé0=a\n\nD", "")
  assert_eq qp_dec(hx("3d43333d4139663d0d0a0a663d0d0ae93d0d0a0a3d3d200d0a463d0a0a0d0a0d0a665a3d200d0a7e7e")), (hx("c3a9660a66e90a"), "unexpected EOF")
  assert_eq qp_dec("=\n=F=C3=A9="), ("=Fé", "")
  assert_eq qp_dec(hx("3d200d0a3d43333d41393d0a3d200d0ae9")), (hx("c3a9e9"), "")
  assert_eq qp_dec(hx("e9667e")), (hx("e9667e"), "")
  assert_eq qp_dec("=C3=A9a\r\n f=\na=3D\r=\r\n=0AZf0\t=3D=g= \r\n=g=\n0\x01F"), ("éa\r\n fa=\r\nZf0\t==g=g0", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("FF=\n~ F~ =C3=A9=3DD\t=0Aa=g =3D~\tDF "), ("FF~ F~ é=D\t\na=g =~\tDF", "")
  assert_eq qp_dec("="), ("", "quotedprintable: invalid bytes after =: \"\"")
  assert_eq qp_dec(hx("3d3d673046304430e97e5a4430")), (hx("3d3d673046304430e97e5a4430"), "")
  assert_eq qp_dec("~= \r\n=\r\nD\t0=g=\n0"), ("~D\t0=g0", "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec("=\r\naF "), ("aF", "")
  assert_eq qp_dec("a\t f~F=C3=A9\r\nfa= \r\nZZ=\n=\n="), ("a\t f~Fé\r\nfaZZ", "quotedprintable: invalid bytes after =: \"\"")
  assert_eq qp_dec("\x01Z\x01==3Df=C3=A9=gf= \r\n\n"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("613d43333d41393d0d0a6101663d0d0ae961")), ("aéa", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("0\t f=\r\n\r D=\r\n=\n\na"), ("0\t f\r D\na", "")
  assert_eq qp_dec("0\t=\n\tf= \r\n0=3D\n=0A=C3=A9==g=\rf= \r\n=C3=A9\n\n=\n=\n=\r\n\t"), ("0\t\tf0=\n\né==g", "quotedprintable: invalid hex byte 0x0d")
  assert_eq qp_dec(hx("3d43333d41393d3344203d0d0ae9200d0a3d200d0a30203d43333d41390d0a303d33443d0d0a09e944e97e5a7e")), (hx("c3a93d20e90d0a3020c3a90d0a303d09e944e97e5a7e"), "")
  assert_eq qp_dec("~\t=C3=A9=0A\t=C3=A9f0\x01~0=0Aa=\nD\x010~\r~\n"), ("~\té\n\téf0", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(" ~~=\n=== \r\n=0A=3D ~"), (" ~~=", "unexpected EOF")
  assert_eq qp_dec("\tF\n =0A \n=\n=C3=A9=~=3D=0A=3D0fZ=3D\r=C3=A9=0AF~=\r\n"), ("\tF\n \n\né=~=\n=0fZ=\ré\nF~", "")
  assert_eq qp_dec("a f= \r\n=C3=A9=3D=\n\r\n~=C3=A9=3D\t=\naf=\t=gf =\r\n\t=3D "), ("a fé=\r\n~é=\taf=\t=gf \t=", "")
  assert_eq qp_dec(hx("617e010a01095ae93d200d0a303d3041")), ("a~", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("Ff\t0=g=gD=\na \r\naD0D=C3=A9a"), ("Ff\t0=g=gDa\r\naD0Déa", "")
  assert_eq qp_dec(hx("463d43333d4139463d0a3d0d0a3d6709e97e614644")), (hx("46c3a9463d6709e97e614644"), "")
  assert_eq qp_dec(hx("3d33443d43333d41393d675a3d3d0ae93d3344443d0d0a")), ("=é=gZ", "unexpected EOF")
  assert_eq qp_dec(hx("0a3d5ae961010d0a3d67440d")), (hx("0a3d5ae961"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d3d30417e3066440901e901303d43333d41393d67e93d673d0a5a3d673d33440d")), ("=\n~0fD\t", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("66613d33443d30413d010d0ae93d43333d413909")), ("fa=\n=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("7e0d0a5a3d61013d3041463d3344e90a3d66663d200d0a0d0a3d0a20")), ("~\r\nZ=a", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("~0=\n=\r\n\r\n=C3=A9D\t~=0A\rZ=C3=A9"), ("~0\r\néD\t~\n\rZé", "")
  assert_eq qp_dec(hx("090d3d0d0a0a0d0ae93d0d0ae9303d200d0a203d673d43333d41394620")), (hx("090d0a0d0ae9e930203d67c3a946"), "")
  assert_eq qp_dec("=\r\n=Z\r\n=3D0Z=3D\t~=0A=\na=3D =f\r\n"), ("=Z\r\n=0Z=\t~\na= =f\r\n", "")
  assert_eq qp_dec(hx("3d43333d41393d3344665ae93d200d0a20610d7e")), (hx("c3a93d665ae920610d7e"), "")
  assert_eq qp_dec("~=0A=\r\nD=\n=gZ=\n"), ("~\nD=gZ", "")
  assert_eq qp_dec(hx("3d0d0a3d200d0a440d0a3d0d0a0d0a3d200d0ae9e90a3d6120443d304146")), (hx("440d0a0d0ae9e90a3d6120440a46"), "")
  assert_eq qp_dec(hx("3d43333d4139443009443d0a093d0d0a663d0d0ae93d33443046463d43333d41393d0d0a3d200d0a")), (hx("c3a9443009440966e93d304646c3a9"), "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("3d0d0d20e93d")), ("", "quotedprintable: invalid hex byte 0x0d")
  assert_eq qp_dec("a=3DF"), ("a=F", "")
  assert_eq qp_dec("=\n\r\n"), ("\r\n", "")
  assert_eq qp_dec(hx("303d200d0a013d0d0a66203d0a3d3344e90d")), ("0", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=0A"), ("\n", "")
  assert_eq qp_dec(hx("e93d43333d41397e093d67610a094466203d33440d0a3d30413d30412030663d3344")), (hx("e9c3a97e093d67610a094466203d0d0a0a0a2030663d"), "")
  assert_eq qp_dec(hx("61440d0a463d200d0a0a0a66e93d0a46093d334430663d677e613d43333d413920013d334409")), (hx("61440d0a460a0a66e946093d30663d677e61c3a920"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r\nD=3DZ\x01= \r\n="), ("\r\nD=Z", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("= \r\n \tZ Z~\tf=C3=A9~"), (" \tZ Z~\tfé~", "")
  assert_eq qp_dec("= \r\na\t\x01=\n=gF\n=\r\nf\r=3D F= \r\n\r0\na=C3=A9aaf"), ("a\t", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=aZ\rF=g==g\t\r=\n==g\rF"), ("=aZ\rF=g==g\t\r==g\rF", "")
  assert_eq qp_dec("\t=3D\r\n\n\r\n= \tD=3D== \r\n=g= \r\n=0Aa0a=\n0= \r\n= \r\n"), ("\t=\r\n\n\r\n= \tD=", "unexpected EOF")
  assert_eq qp_dec("FF= \r\naFZ0~=\n"), ("FFaFZ0~", "")
  assert_eq qp_dec("a0\n\nf=C3=A90a\r\na=C3=A9=f=3D=0A\n=0A=\r\n\r\n\r\n=\r\n\nF"), ("a0\n\nfé0a\r\naé=f=\n\n\n\r\n\r\n\nF", "")
  assert_eq qp_dec("= \r\n0\r\n= \r\n= \r\nDZ=\r\n=0A"), ("0\r\nDZ\n", "")
  assert_eq qp_dec("\n=\n =\n"), ("\n ", "")
  assert_eq qp_dec(hx("6120013d43333d4139e944093d33447e44093d670a467e0d0d3d3d3041663001")), ("a ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("463d0a3d200d0a093d200d0a3d67e97e3d33443d0d0a443d3344e93d0d0a")), (hx("46093d67e97e3d443de9"), "")
  assert_eq qp_dec(hx("3d43333d4139203d30413d200d0a3d0ae93d30413d3041")), (hx("c3a9200ae90a0a"), "")
  assert_eq qp_dec(hx("0901610d0a3d3344e93d67e9463d670d09093d33443d334409095ae93066")), ("\t", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("f"), ("f", "")
  assert_eq qp_dec("=C3=A9~\r=g=0A~= \r\n=3D= \r\n\x01=\na\r\n"), ("é~\r=g\n~=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0d0a0a0a44613d010a0ae93d304166203d30413d33440d0a300a3066203d200d0a3d")), ("\r\n\n\nDa=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("013d0a613d33443d200a0a0a5a0ae90101")), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(" "), ("", "")
  assert_eq qp_dec("\t=g\r\n  f=0A\x01=\n=0AF\x01\x01~=g0f~=\n0"), ("\t=g\r\n  f\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r= \r\n\nZ~Da=3D \n=\n\n\r\nf"), ("\r\nZ~Da=\n\n\r\nf", "")
  assert_eq qp_dec(hx("095a01093d673d30413d0a200a0d3d3d30413d43333d41393d0d0a3d673d3344e9e93d3344303d200d0a7ee9")), ("\tZ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("D\t\ta\r\n=\r\n= \r\n\t=\r\n=0A"), ("D\t\ta\r\n\t\n", "")
  assert_eq qp_dec("=\r\n="), ("", "quotedprintable: invalid bytes after =: \"\"")
  assert_eq qp_dec(hx("0d0a3d30413d3d0a7e20013d0a66013d0d0a207ee93d0d0a")), ("\r\n\n", "unexpected EOF")
  assert_eq qp_dec("aF =\n\x01=\n== \r\n\x01=3D0\r\nZ\r=C3=A9\r\n 0\n=0A=g=0A"), ("aF ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("46e93d200d0a0d0a3d0a3d33443d200d0a5a44203d30410a3d0d0a463d43333d41397e443d0a3d3d670a")), (hx("46e90d0a3d5a44200a0a46c3a97e443d3d670a"), "")
}

test "vectors: reader 7" {
  assert_eq qp_dec(hx("3d200d0a207e30e93046463d0d0a")), (hx("207e30e9304646"), "")
  assert_eq qp_dec("\t=\t = \r\n=\x01=\n\r\t\r=\n="), ("\t=\t =", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(" a~\r=\r\n D\r\r\n=\r\n\r\na =gFZDD=0A~ D=\r\n0"), (" a~\r D\r\n\r\na =gFZDD\n~ D0", "")
  assert_eq qp_dec("\t=g=C3=A9\t= \r\n0=3D"), ("\t=gé\t0=", "")
  assert_eq qp_dec(hx("3d0d0a7e3d304120e93d3041090d0a093d200d0a010a3d673d200d0a3d")), (hx("7e0a20e90a0d0a09"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=C3=A9\r\nZ\tF\n"), ("é\r\nZ\tF\n", "")
  assert_eq qp_dec(hx("e9e93d0d0a3d200d0a3d3344013d0a203d3041300d0a0d663d33445a617e44465a")), (hx("e9e93d"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("fZ\x01=\r\n\t\n\r\r\n\x01Z\r"), ("fZ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("3d30410d0a3d33443d0d0a0a093d200d0a443d3344463d43333d413946e9617e5a5a463d200d0a3d67")), (hx("0a0d0a3d0a09443d46c3a946e9617e5a5a463d67"), "")
  assert_eq qp_dec(hx("09203d200d0a3d33443d3344e93d0d0a460a46095a7e3d33443d0d0a30")), (hx("09203d3de9460a46095a7e3d30"), "")
  assert_eq qp_dec(hx("013d33440d0a30463d3d200d0a3d30410d0a46e94446")), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(""), ("", "")
