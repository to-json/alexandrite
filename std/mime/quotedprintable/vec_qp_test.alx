  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("300d305a3d200d0a3d200d0a3d0a205a09e9460a")), (hx("300d305a205a09e9460a"), "")
  assert_eq qp_dec("=3DFFZ=\r\n~=\r\n=C3=A9"), ("=FFZ~é", "")
