  assert_eq qp_enc(hx(""), true), "~=C3=A9=C3=A9 \t~ =00=00 !=0A ab-!~=FF- =0D=3D~ =3D=0A-\t=C3=A9~b=0D=FF =FF=\r\n=0D=0A~=3D=0D=0Ab=7F=0D~ 0 =7F =0D.=0D=00-=C3=A9=3D-!=3D- =0D0 =7F =7F =FF=\r\n=00b=00=FF!=FF ~=00.=7F a. =3D=7F0!=0A \t=00=00!\t=00~b=0D -=0D=C3=A9  b=C3=\r\n=A9a=FFa=0D=0A\t=7F-~0 =00.=3D=00=3D-0!0Z=0D=0A =C3=A9=0D!Z.!=0A0 =0A=FF=FF=\r\n=FF  -.b=C3=A9~ Z=00=00=FF=00=7F=C3=A9Z"
  assert_eq qp_enc(" ", false), "=20"
  assert_eq qp_enc(" ", true), "=20"
  assert_eq qp_enc("~\r\n\r\n0- ==\x00!", false), "~\r\n\r\n0- =3D=3D=00!"
  assert_eq qp_enc("~\r\n\r\n0- ==\x00!", true), "~=0D=0A=0D=0A0- =3D=3D=00!"
  assert_eq qp_enc("a\t\r\n\ré .~bZ\r-Z\r\nbb.\ré", false), "a=09\r\n\r\n=C3=A9 .~bZ\r\n-Z\r\nbb.\r\n=C3=A9"
  assert_eq qp_enc("a\t\r\n\ré .~bZ\r-Z\r\nbb.\ré", true), "a\t=0D=0A=0D=C3=A9 .~bZ=0D-Z=0D=0Abb.=0D=C3=A9"
  assert_eq qp_enc(hx("62ff5aff205a620a2e"), false), "b=FFZ=FF Zb\r\n."
  assert_eq qp_enc(hx("62ff5aff205a620a2e"), true), "b=FFZ=FF Zb=0A."
  assert_eq qp_enc(hx("5a7e5a0d20096100005a20203030202e092e5a21622d5a0d2d093d7e610ac3a9007e20212020207f0d0a20302021203dc3a90d0a2d5a2dc3a90d0a2dc3a9003009610d0a0d2e2e002e62c3a9613d613d003d3009ff2d0d7f2eff0a0d0d0a3d2e5a300d0a2e620dc3a920ff5a7eff6109613d2e7e61303d0a00ff7e207e7f212e000d0a30ff20ff7e5a0d0a7e610d0a0d7e"), false), "Z~Z\r\n \ta=00=00Z  00 .\t.Z!b-Z\r\n-\t=3D~a\r\n=C3=A9=00~ !   =7F\r\n 0 ! =3D=C3=A9\r\n-Z-=C3=A9\r\n-=C3=A9=000\ta\r\n\r\n..=00.b=C3=A9a=3Da=3D=00=3D0\t=FF-\r\n=7F.=FF\r\n\r\n\r\n=3D.Z0\r\n.b\r\n=C3=A9 =FFZ~=FFa\ta=3D.~a0=3D\r\n=00=FF~ ~=7F!.=00\r\n0=FF =FF~Z\r\n~a\r\n\r\n~"
  assert_eq qp_enc(hx("5a7e5a0d20096100005a20203030202e092e5a21622d5a0d2d093d7e610ac3a9007e20212020207f0d0a20302021203dc3a90d0a2d5a2dc3a90d0a2dc3a9003009610d0a0d2e2e002e62c3a9613d613d003d3009ff2d0d7f2eff0a0d0d0a3d2e5a300d0a2e620dc3a920ff5a7eff6109613d2e7e61303d0a00ff7e207e7f212e000d0a30ff20ff7e5a0d0a7e610d0a0d7e"), true), "Z~Z=0D \ta=00=00Z  00 .\t.Z!b-Z=0D-\t=3D~a=0A=C3=A9=00~ !   =7F=0D=0A 0 ! =3D=\r\n=C3=A9=0D=0A-Z-=C3=A9=0D=0A-=C3=A9=000\ta=0D=0A=0D..=00.b=C3=A9a=3Da=3D=00=\r\n=3D0\t=FF-=0D=7F.=FF=0A=0D=0D=0A=3D.Z0=0D=0A.b=0D=C3=A9 =FFZ~=FFa\ta=3D.~a0=\r\n=3D=0A=00=FF~ ~=7F!.=00=0D=0A0=FF =FF~Z=0D=0A~a=0D=0A=0D~"
  assert_eq qp_enc("\r-\t0\n\t~\t é0\n.~a\r\n ", false), "\r\n-\t0\r\n\t~\t =C3=A90\r\n.~a\r\n=20"
  assert_eq qp_enc("\r-\t0\n\t~\t é0\n.~a\r\n ", true), "=0D-\t0=0A\t~\t =C3=A90=0A.~a=0D=0A=20"
  assert_eq qp_enc(hx("307f61ff20097f7f2e2009092d3d0900090d0a627f20200d7e5a3021627e3d"), false), "0=7Fa=FF \t=7F=7F. \t\t-=3D\t=00=09\r\nb=7F =20\r\n~Z0!b~=3D"
  assert_eq qp_enc(hx("307f61ff20097f7f2e2009092d3d0900090d0a627f20200d7e5a3021627e3d"), true), "0=7Fa=FF \t=7F=7F. \t\t-=3D\t=00\t=0D=0Ab=7F  =0D~Z0!b~=3D"
  assert_eq qp_enc(hx("2d007e0d0a2d09307f30213d62005a7f5a2dff0d2d000d0a3d3dc3a92d0a2e3d"), false), "-=00~\r\n-\t0=7F0!=3Db=00Z=7FZ-=FF\r\n-=00\r\n=3D=3D=C3=A9-\r\n.=3D"
  assert_eq qp_enc(hx("2d007e0d0a2d09307f30213d62005a7f5a2dff0d2d000d0a3d3dc3a92d0a2e3d"), true), "-=00~=0D=0A-\t0=7F0!=3Db=00Z=7FZ-=FF=0D-=00=0D=0A=3D=3D=C3=A9-=0A.=3D"
  assert_eq qp_enc("\x00a é", false), "=00a =C3=A9"
  assert_eq qp_enc("\x00a é", true), "=00a =C3=A9"
}

test "vectors: reader" {
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(" \n\r\n"), ("\n\r\n", "")
  assert_eq qp_dec("=C3=A9=\n\n\r=0Aaa=\r\n\t=0f"), ("é\n\r\naa\t\x0f", "")
  assert_eq qp_dec(hx("e93d3d30413d0d0a3d3344")), (hx("e93d0a3d"), "")
  assert_eq qp_dec("\nfF~D0=g=C3=A9"), ("\nfF~D0=gé", "")
  assert_eq qp_dec("~F=0A~=0A=0"), ("~F\n~\n=0", "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("0d0a3d3d200d0ae93d3344")), ("\r\n", "unexpected EOF")
  assert_eq qp_dec("0\n\x01F =0A"), ("0\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=3D =C3=A9=\r\nfF\r\n\t\r\n0=0A"), ("= éfF\r\n\r\n0\n", "")
  assert_eq qp_dec("=\r\n=ga=f\x01Z\n\x01=C3=A9D~Z\t"), ("=ga=f", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\x01\r\nZ\t =a=C3=A9f=C3=A9\r\na\tZZ\t\x01"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("e93d67303d200d0ae90944303d673d0a3d67e93d0d0a3d43333d41393d0d0a010d3d200d0a3d43333d4139463d673d6701")), (hx("e93d6730e90944303d673d67e9c3a9"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(" ~=0Aa\r\n"), (" ~\na\r\n", "")
  assert_eq qp_dec("=\n\r"), ("", "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("460a3d3d43333d41393d673d33443d0d0a3d0a3d673d30413d43333d41393d33440a3d673d20e97e")), (hx("460a3dc3a93d673d3d670ac3a93d0a3d673d20e97e"), "")
  assert_eq qp_dec(hx("e9443d200d0a2009203d30415a663d6744200d3d33440d0a66303d3041300a3d43333d41393d3041")), (hx("e9442009200a5a663d6744200d3d0d0a66300a300ac3a90a"), "")
  assert_eq qp_dec(hx("0920e901")), (hx("0920e9"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d013d015a667e3d0d0a3d200d0a3d0a093d0ae9e95a20")), ("=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=g\x01a=\n\x01\t"), ("=g", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0a3d200d0a303d6601e90161090901610d3d3344613d3d0d0a663d3344303d0a3d30413d0d0a")), ("\n0=f", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("440a3d0a0d0a0a444420e95a44")), (hx("440a0d0a0a444420e95a44"), "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec("Z=\r\n0DD00"), ("Z0DD00", "")
  assert_eq qp_dec("=0A =\r\n\t\t=3D\t=gZ0=0A"), ("\n \t\t=\t=gZ0\n", "")
  assert_eq qp_dec("FF=gD"), ("FF=gD", "")
  assert_eq qp_dec("=0A= \r\n=\n=C3=A9=g\t"), ("\né=g", "")
  assert_eq qp_dec("\x01=0Af~=\r\na\r=\r\n=3D\r\n~~ =C3=A9=0AD==C3=A9=C3=A9 "), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\t0 ~= =C3=A9F\t=\n\t==ZD0=\n"), ("\t0 ~= éF\t\t==ZD0", "")
  assert_eq qp_dec("0\x010F =\r\n0"), ("0", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=g\ra=C3=A9D=\r=0A 0=C3=A9\nD"), ("=g\raéD", "quotedprintable: invalid hex byte 0x0d")
  assert_eq qp_dec("0=\n~D\r\nF\tF=\nf=\n\tF0= \r\n= \r\n= \r\n"), ("0~D\r\nF\tFf\tF0", "")
  assert_eq qp_dec(hx("093d0d0ae95a5a443d0d0a093d0ae90d0d0a3d3344")), (hx("09e95a5a4409e90d0a3d"), "")
  assert_eq qp_dec("D=0A=0A"), ("D\n\n", "")
  assert_eq qp_dec(hx("300a3d0d0a09e93d43333d41393d3d203d200d0a3d200d0a3d0d0a0d0d0a3d0d0a0a3d0a0a0d090a203d43333d4139")), (hx("300a09e9c3a93d3d200d0a0a0a0a20c3a9"), "")
  assert_eq qp_dec("aF= \r\nZ=0A\t= \r\nf=g = \r\n\n = \r\n\n0==gZD~\r\r"), ("aFZ\n\tf=g \n \n0==gZD~", "")
  assert_eq qp_dec("0aDF"), ("0aDF", "")
  assert_eq qp_dec("=F=0A"), ("=F\n", "")
  assert_eq qp_dec(hx("663d33440d0a7e4661093d0d0a20e93d67305a3d3041e93d673d33447e3d0d0a3d33443d67")), (hx("663d0d0a7e46610920e93d67305a0ae93d673d7e3d3d67"), "")
  assert_eq qp_dec(hx("6144203d3041203d30413d30413d0d0a3d304144093d6746e90a303d670930613d30410d0a")), (hx("6144200a200a0a0a44093d6746e90a303d670930610a0d0a"), "")
  assert_eq qp_dec("\t\r\n\x01=\nf=\r\n\n\t~=\n\n"), ("\r\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d0d0a30303d67663d0d0a30610a3d443d0a44200d20e93d67")), (hx("30303d676630610a3d4444200d20e93d67"), "")
  assert_eq qp_dec(hx("0d613d0d0ae93d200d0a0d303d200d0a3d673d43333d41390a3d0a7e3066663d0d0a")), (hx("0d61e90d303d67c3a90a7e306666"), "")
  assert_eq qp_dec(hx("3d43333d41390d0de9467e3d200d0a0d0a0d0a093d30413d0d0a3d673d200d0a0a0a4409093d0a3d673d0a44")), (hx("c3a90d0de9467e0d0a0d0a090a3d670a0a4409093d6744"), "")
  assert_eq qp_dec("F~=3D"), ("F~=", "")
  assert_eq qp_dec(hx("3030e9e90a3d67613d30413d33443d20010920613d0d0a0d0a3d43333d41393d3d3d33443d30410a")), (hx("3030e9e90a3d67610a3d3d20"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\n\n~Z0D0\nDD\r= \r\na~a"), ("\n\n~Z0D0\nDD\ra~a", "")
  assert_eq qp_dec("=C3=A9\n=C3=A9=gFa ==\r\n \r\n ~ = \r\n=\n=3DD"), ("é\né=gFa ", "unexpected EOF")
  assert_eq qp_dec(hx("443d0ae9443d33443d30413d0d0a3d200d0a660d0a3d33443d0d0a467e3d200d0a3d0a3d43333d41397e")), (hx("44e9443d0a660d0a3d467ec3a97e"), "")
  assert_eq qp_dec("\r=\r\n\n\t=g\t\x01"), ("\r\n\t=g\t", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("665a09090d663d7e3d33440a0a0a204644093d0a46e9")), (hx("665a09090d663d7e3d0a0a0a2046440946e9"), "")
  assert_eq qp_dec(hx("663d43333d4139e96130013d43333d413961613d3d200d0a61203d3344e93d43333d41393d67613d66")), (hx("66c3a9e96130"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r=\r\n\r=\r\n=3DZ \n=g\ra"), ("\r\r=Z\n=g\ra", "")
  assert_eq qp_dec("\x01\r\n\r\n\t\r\nD=g\r\n0"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=3D"), ("=", "")
  assert_eq qp_dec(hx("443d30413d673d0a0ae9463d200d0a303d0a660d")), (hx("440a3d670ae9463066"), "")
  assert_eq qp_dec("\n=0A=\r\n==\r\nDF=\n"), ("\n\n", "unexpected EOF")
  assert_eq qp_dec(hx("3d67e90d09300d0a3d677e3d3d200d0a44090a3d43333d41393d0a3d43333d41390d0a3d0a3d3344")), (hx("3d67e90d09300d0a3d677e"), "unexpected EOF")
  assert_eq qp_dec(hx("20615a463d30414401443d200d0a460a5a0d3d673d200d0a61203d43333d41390d0ae9")), (" aZF\nD", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("===C3=A9~~==3D\x01=\r\nF~\n\r\nD="), ("==é~~==", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d0d0a203d0d0a3d3041443d673d43333d41390d0ae9660d3d3041")), (hx("200a443d67c3a90d0ae9660d0a"), "")
  assert_eq qp_dec("\rF=\r\n=0Aa= \r\n= \r\n=\n\r\n0\n=C3=A9=0A=3D=C3=A9D=C3=A90\r\nF"), ("\rF\na\r\n0\né\n=éDé0\r\nF", "")
  assert_eq qp_dec("=3Df\tZf=g\t0=\r~\x01\r\nFf=C3=A9"), ("=f\tZf=g\t0", "quotedprintable: invalid hex byte 0x0d")
  assert_eq qp_dec("=g\r\nZ=\t"), ("=g\r\nZ", "")
  assert_eq qp_dec(hx("e97e3d0d0a")), (hx("e97e"), "")
  assert_eq qp_dec(hx("3d673d0d0d44e97e3d43333d4139663d203d334409300161")), ("=g", "quotedprintable: invalid hex byte 0x0d")
  assert_eq qp_dec("\t\rZa"), ("\t\rZa", "")
  assert_eq qp_dec("=0A=g=\n\r\r=\r\n\r\n=== \r\n=\r\nZ\r=3D=g"), ("\n=g\r\r\r\n=", "unexpected EOF")
  assert_eq qp_dec(hx("0d3d0ae93d200d0a3d673d6120203d3041093d33447e3d673d3041")), (hx("0de93d673d6120200a093d7e3d670a"), "")
  assert_eq qp_dec("f ==0A\x01a\n=C3=A9=\n"), ("f =\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("463d20097e3d0d0a3d673d43333d41393d3041443d304146e90a66")), (hx("463d20097e3d67c3a90a440a46e90a66"), "")
  assert_eq qp_dec(hx("0d3d33440d44e9013d")), (hx("0d3d0d44e9"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r\nf=C3=A9D f0FFFf"), ("\r\nféD f0FFFf", "")
  assert_eq qp_dec("=0A=3DZ\n=C3=A9"), ("\n=Z\né", "")
  assert_eq qp_dec("\rF= \r\nF~=\r\n000=0A=\r\r\n=\r\n\n\r\n=3DF=0A=3D "), ("\rFF~000\n", "quotedprintable: invalid bytes after =: \"\\r\\r\\n\"")
  assert_eq qp_dec("Z"), ("Z", "")
  assert_eq qp_dec("D\nD\tD\r\nD=\n0~ =C3=A9= \r\n 0\t "), ("D\nD\tD\r\nD0~ é 0", "")
  assert_eq qp_dec("Z=g=\n=\nfF= \r\n=3D=\r\n\x01= \r\nF\t=g=g=3DF=g"), ("Z=gfF=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d6744e93d0d0a443d43333d4139200a3d200d0a3001")), (hx("3d6744e944c3a90a30"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec("=C3=A9"), ("é", "")
  assert_eq qp_dec("f\r\n =0"), ("f\r\n =0", "")
  assert_eq qp_dec(hx("66e9203d30410d0a010a3d0d0a3d43333d4139")), (hx("66e9200a0d0a"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d33443d670d3d0a3d0d0a303d33442044e946463d3d3344093d43333d4139")), (hx("3d3d670d303d2044e946463d3d09c3a9"), "")
  assert_eq qp_dec("\n"), ("\n", "")
  assert_eq qp_dec(hx("e9300a01e93d673d43333d413966663d304161463d3344")), (hx("e9300a"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d200d0a0a3d0a015a3d677e0ae9013d200d0a3d673de9")), ("\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d463d200d0a20e96609303de94461203d673d200d0a0d")), (hx("3d4620e96609303de94461203d67"), "")
  assert_eq qp_dec(hx("3d200d0ae90d443d0a")), (hx("e90d44"), "")
  assert_eq qp_dec(hx("3d0d0a3d30410d0a443d43333d41396644e9203d0a3d3041")), (hx("0a0d0a44c3a96644e9200a"), "")
  assert_eq qp_dec("=0A\rF~=C3=A9  =3D\rD\x01\r=C3=A9~\r\rfFa=g=\n=\n"), ("\n\rF~é  =\rD", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\t\x01a= \r\nD=C3=A9\t"), ("\t", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("20e97e0a7e3d43333d4139463d01610a610d200d0a66")), (hx("20e97e0a7ec3a9463d"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("300a0d0ae9660966097e3d0d0a097e3d200d0a613d200d0ae93d3d200d0a0d0a3d43333d4139095a")), (hx("300a0d0ae9660966097e097e61e9"), "unexpected EOF")
  assert_eq qp_dec("=gD= \r\n=g"), ("=gD=g", "")
  assert_eq qp_dec(hx("e90a3d200d0a7e3d200d0a3d673d0a0d0a300a0101")), (hx("e90a7e3d670d0a300a"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\n0=\n\t"), ("\n0", "")
  assert_eq qp_dec("=3DF0~=ga=\n Da\x01DFD\x0100= \r\n=ga=g\nD"), ("=F0~=ga Da", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("Z\t=0A=\r\n\t\x01D"), ("Z\t\n\t", "quotedprintable: invalid unescaped byte 0x01 in body")
}

test "vectors: reader 1" {
  assert_eq qp_dec("=3Df\r\nD\r\x01ZZ  \na=0A"), ("=f\r\nD\r", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r\n==C3=A9= \r\n"), ("\r\n=é", "")
  assert_eq qp_dec(hx("3d0d0a5a0ae95a3d3041200a3d43333d41390d0a3d0d0a7e3d67460120093d673d43333d41393d3d673d3041")), (hx("5a0ae95a0a0ac3a90d0a7e3d6746"), "quotedprintable: invalid unescaped byte 0x01 in body")
