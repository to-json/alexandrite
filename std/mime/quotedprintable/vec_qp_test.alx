  assert_eq qp_dec(hx("0d3d43333d41392066e93d200d0a3d0d0a447ee93d200d0a3d0d0a3d334466613d0a0a0944463d670a463d43333d4139")), (hx("0dc3a92066e9447ee93d66610a0944463d670a46c3a9"), "")
  assert_eq qp_dec(hx("463d200d0a3d0a0d3d200d0a3d67443d33443d3041445a3d43333d41393d0a0d093d6761663d0a0144e93d0d0a3d43333d4139")), ("F\r=gD=\nDZé\r\t=gaf", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d09663d200d0ae961")), (hx("3d0966e961"), "")
  assert_eq qp_dec("af\x01a= \r\n \t=0A=C3=A9FZ\t =g= \r\n\n =3DaZF"), ("af", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("~=0A=aF=\nFD =0A =C3=A90=0AF"), (hx("7e0aaf4644200a20c3a9300a46"), "")
  assert_eq qp_dec(hx("3d304144203d0a3d7ee90a613d3041e96630613d3041613d200d0a613d670d3d670a")), (hx("0a44203d7ee90a610ae96630610a61613d670d3d670a"), "")
  assert_eq qp_dec("=0A\x01=C3=A9=\x01=\r\n\t==\r\n\r"), ("\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("f=\r\n"), ("f", "")
  assert_eq qp_dec(hx("01205a3d0ae9663d43333d41390a7e")), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("613d43333d41390d090a3d0d0a093d43333d41393d0a465ae9e93d33440d0a0a203d200d0a61")), (hx("61c3a90a09c3a9465ae9e93d0d0a0a2061"), "")
  assert_eq qp_dec("=0A\r\n\r\na\n=C3=A9=3D=\r\n=C3=A9=C3=A9\ta=\r\n=0A\t"), ("\n\r\n\r\na\né=éé\ta\n", "")
  assert_eq qp_dec(hx("660a303d0d0a4446463d30413d43333d4139443d43333d41393d673d43333d41395a3d0d0ae93d3d673d200d0a")), (hx("660a304446460ac3a944c3a93d67c3a95ae93d3d67"), "")
  assert_eq qp_dec(hx("0d0a3d200d0a3d3041660d0a20613d30413d673d33443d3d3344e93d33443d67443d43333d41393d3d67613d3d3344")), (hx("0d0a0a660d0a20610a3d673d3d3de93d3d6744c3a93d3d67613d3d"), "")
  assert_eq qp_dec("\n~\r\n\n\n0="), ("\n~\r\n\n\n0", "")
  assert_eq qp_dec(hx("3d0d0a3d43333d41390d0a01e90d3d3d30414420613d43333d41393d67")), ("é\r\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0109e93d30415a013d3041")), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("fDF"), ("fDF", "")
  assert_eq qp_dec("= \r\n=FFD\r\nZ=C3=A9==\r\n=g=\r\n\tf~Z\r0= \r\n =\r\n"), (hx("ff440d0a5ac3a9"), "unexpected EOF")
  assert_eq qp_dec(hx("013d677e0d0a46300d3de95a0a46")), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("DDa=g=gF"), ("DDa=g=gF", "")
  assert_eq qp_dec(hx("3d677e460d093d30417ee90de90d0a303d0a3d673d200d0a0a3d200d0a3d0a30300d0a")), (hx("3d677e460d090a7ee90de90d0a303d670a30300d0a"), "")
  assert_eq qp_dec(hx("3d0d0a0d0a303d33443d20013d200d0ae93d0d0a3d3344")), ("\r\n0== ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0d303d43333d4139e93d30413d67017e094409")), (hx("0d30c3a9e90a3d67"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("f\x01D0"), ("f", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("66015a440944200a303d43333d41393d30413d200d0ae9e90d0d0a3d43333d4139")), ("f", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("= \r\n\r\n~a=\n\tfFZ=\r\n\tD\x01"), ("\r\n~a\tfFZ\tD", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=3D0"), ("=0", "")
  assert_eq qp_dec("D= \r\nF~= \r\n\rFf\rF\x01D=0A\x01\n\r=\r\n==g=g="), ("DF~\rFf\rF", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("aDf=\x01f=C3=A90~0=\n=\r=3D=\r\nD"), ("aDf=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(" =\r\nF=\r\na0\x01=\r\nF"), (" Fa0", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("e93d43333d41390d0a0d")), (hx("e9c3a90d0a"), "")
  assert_eq qp_dec("==\n\r= \r\n0~D=3D~\r=\n"), ("", "unexpected EOF")
  assert_eq qp_dec(hx("3d33440a66e9445a3d33443d200d0a66093d67")), (hx("3d0a66e9445a3d66093d67"), "")
  assert_eq qp_dec("= \r\n\r="), ("\r", "")
  assert_eq qp_dec(hx("6130463d33443d43333d4139203d43333d41393d67460de9e97e01617e303d670a0d7e0d09")), (hx("6130463dc3a920c3a93d67460de9e97e"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("20e95a3d43333d4139e93d0d443d200d0a3d33445a61")), (hx("20e95ac3a9e9"), "quotedprintable: invalid hex byte 0x0d")
  assert_eq qp_dec(hx("3d0d7e0ae93d0d0a5a3d30413d43333d41393d0d0a61")), ("", "quotedprintable: invalid hex byte 0x0d")
  assert_eq qp_dec(hx("0a440d0a3d200d0a3d0d0a204630667ee9e9e930")), (hx("0a440d0a204630667ee9e9e930"), "")
  assert_eq qp_dec(hx("e93d3344443d663d0a7e3d43333d41390d0a3d3344")), (hx("e93d443d667ec3a90d0a3d"), "")
  assert_eq qp_dec(hx("0d3d43333d41393d200d0a5a0a7e2046e93d30413d200d0a3d443d0a7e3d0a3d0d0a663d0ae9")), (hx("0dc3a95a0a7e2046e90a3d447e66e9"), "")
  assert_eq qp_dec("\r\n\r\r\n\t= \r\n =\nf"), ("\r\n\r\n\t f", "")
  assert_eq qp_dec(hx("0d0a3d5ae930205a3d67200a5a200d0a")), (hx("0d0a3d5ae930205a3d670a5a0d0a"), "")
  assert_eq qp_dec("=\r\n"), ("", "")
  assert_eq qp_dec("=3D~ =3Da\n=3DF"), ("=~ =a\n=F", "")
  assert_eq qp_dec("Z=0A\x01=\n=0A=gF\r\n=DF=g=C3=A9=3D=0A=FD=3D"), ("Z\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r\n\r\nZ==f\t\rF=\r\n\r"), ("\r\n\r\nZ==f\t\rF", "")
  assert_eq qp_dec("=\n=g \n"), ("=g\n", "")
  assert_eq qp_dec(hx("3d0d0a443d0d0a463d675a0a3d33443d43333d4139303d3041e930460a300d3d200d0a")), (hx("44463d675a0a3dc3a9300ae930460a300d"), "")
}

test "vectors: reader 3" {
  assert_eq qp_dec(hx("465a663d7ee93d673d673d33446609")), (hx("465a663d7ee93d673d673d66"), "")
  assert_eq qp_dec("Z=3D=\x01=~\r\n"), ("Z==", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\nZ"), ("Z", "")
  assert_eq qp_dec("f "), ("f", "")
  assert_eq qp_dec(hx("3d0a663d334461093d33443d0d0a0a4601440a3d67013d0ae97e3d0d0a3d43333d41393d200d0a3d30413d0d0a463d0a")), ("f=a\t=\nF", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=3D\r\n=\n0=~\n=\n\x01\t a= \r\nf\r "), ("=\r\n0=~\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("F=C3=A9Zf= \r\n\ta"), ("FéZf\ta", "")
  assert_eq qp_dec("\x01\t\x01=C3=A9~=\r\n\r\nZ\rf~=\nZ"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\t=\r\n=C3=A9=C3=A9ZafF\r=0A\t=C3=A9= \r\n\x01=D\x01\x01=gf==C3=A9Z"), ("\tééZafF\r\n\té", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0a013d200d0a4644303d33443d304101303d0ae95a0d0a5a3d200d0a3d677e3d0a0a613d0d0a0d")), ("\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0a0d3d3d200d0a01017e3d30413d200d0a093d6746667ee9612066")), ("\n\r", "unexpected EOF")
  assert_eq qp_dec(hx("3d3344610d09e9303d43333d41393d304120663d673d33443d43333d41393d3041")), (hx("3d610d09e930c3a90a20663d673dc3a90a"), "")
  assert_eq qp_dec("a\x01F~~= \r\nF\tF\n=ga=gDfZ=g\r\n~"), ("a", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("5ae97e613d30417e0d0a0d44")), (hx("5ae97e610a7e0d0a0d44"), "")
  assert_eq qp_dec(hx("3d0a3d43333d4139e93d0a0d0a090a0d3d3041463d673d3d0a0d0a3d0d0a0d3d30417e3d67")), (hx("c3a9e90d0a0a0d0a463d67"), "unexpected EOF")
  assert_eq qp_dec("0=\n"), ("0", "")
  assert_eq qp_dec("a\nD"), ("a\nD", "")
  assert_eq qp_dec(hx("0a0d0a09303d43333d41393d0a613d67e97e3d3344")), (hx("0a0d0a0930c3a9613d67e97e3d"), "")
  assert_eq qp_dec("\r=C3=A9=3D\n=0Af= \r\n\x01fZ\n=Z=0AD0=C3=A9\t\t~=\r\n=\n"), ("\ré=\n\nf", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\r\n=3D"), ("=", "")
  assert_eq qp_dec("Zf\n "), ("Zf\n", "")
  assert_eq qp_dec("= \r\n=\t~=f=\r\n=\n= \r\n\x01f\r=C3=A90= \r\n0=\r\n =C3=A9a\ta~"), ("=\t~=f", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("0~ "), ("0~", "")
  assert_eq qp_dec(hx("46443d30417e3d0a09303d33443d0d0a0a3d01e930460d013d3d3d0d0a6620")), ("FD\n~\t0=\n=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=gf==3D= \r\n"), ("=gf==", "")
  assert_eq qp_dec("=\n"), ("", "")
  assert_eq qp_dec(hx("3d200d0a300d0a09300a5a01e9460d300d0a01610a3009613d43333d413944443d673d200d0a")), ("0\r\n\t0\nZ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("e97e446630e9663d0d0a5a307e3d0d0a3d43333d413946e93d200d0a0a66")), (hx("e97e446630e9665a307ec3a946e90a66"), "")
  assert_eq qp_dec(" =0A= \r\n\x01Za00F =3D == \r\n=C3=A9 a=3D0=0AZ=3D\r"), (" \n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\r=Z=3D=g=g\r\n0f=3D=g=\n=3D"), ("", "quotedprintable: invalid hex byte 0x0d")
  assert_eq qp_dec(hx("613d200d0a0d3d67203d0d0a3d43333d4139443d304146443d3d7e4446e9303d200d0a093d43333d41390d0a3d67")), (hx("610d3d6720c3a9440a46443d3d7e4446e93009c3a90d0a3d67"), "")
  assert_eq qp_dec(hx("e90d3d3d673d67")), (hx("e90d3d3d673d67"), "")
  assert_eq qp_dec("= \r\n\n0 Z=\r\n\n=\nf "), ("\n0 Z\nf", "")
  assert_eq qp_dec("F\n"), ("F\n", "")
  assert_eq qp_dec("Z\n\r\nZ= \r\n=g=\r= \r\n\rF~\n=g= \r\n=\n= \r\n=3D\tf\n= \r\n=3D=C3=A9"), ("Z\n\r\nZ=g", "unexpected EOF")
  assert_eq qp_dec("Z~D=C3=A9"), ("Z~Dé", "")
  assert_eq qp_dec("a==0=C3=A9=3D=3D\r\r=3DfDZa=3D=g\r\n~D\r=\r\n=\r\n=0AD"), ("a==0é==\r\r=fDZa==g\r\n~D\r\nD", "")
  assert_eq qp_dec(hx("e93d200d0a")), (hx("e9"), "")
  assert_eq qp_dec(hx("0d0a0d0a30e9445a013d30413d334466467e0d5a445a3d673d0d0a46")), (hx("0d0a0d0a30e9445a"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=3D=\r\n=\n\n=F"), ("=\n=F", "")
  assert_eq qp_dec("\x01= \r\nZ\r\nfD\nF\n=\r\nD=g0\t=g\x01\r=g"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\rf=3D"), ("", "quotedprintable: invalid hex byte 0x0d")
  assert_eq qp_dec(hx("0d0a0d0a093d200d0a3d30410d0a0144e9e90d0a3d304146663d0d0a")), ("\r\n\r\n\t\n\r\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("0=C3=A9"), ("0é", "")
  assert_eq qp_dec("= \r\n=3D=\n==gf=g \r"), ("===gf=g", "")
  assert_eq qp_dec(hx("093d0d0a7ee9200d0a0a01303d0d0a3d675a20e93d0d0a0a44")), (hx("097ee90d0a0a"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("D\n\r\n\n "), ("D\n\r\n\n", "")
  assert_eq qp_dec("f=Da =a\r\n0=\n\r\n"), (hx("66da203d610d0a300d0a"), "")
  assert_eq qp_dec(hx("5a663d0a0d0d0a663d673d675ae93d670d0a44663d67")), (hx("5a660d0a663d673d675ae93d670d0a44663d67"), "")
  assert_eq qp_dec("\t\t=0A0= \r\n =C3=A9=0Aa=0A=g\nD f\t= \r\nF\rD\x01=C3=A9"), ("\t\t\n0 é\na\n=g\nD f\tF\rD", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d33447e3d4444663d6746610d0a0d0d3d465a0909010d3d30410d0de9")), (hx("3d7edd663d6746610d0a0d0d3d465a0909"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("F=\r\n\t\n=\na=3D=\n"), ("F\na=", "")
  assert_eq qp_dec("=C3=A9=D"), ("é=D", "")
  assert_eq qp_dec("=\n=\n=\n=\r\n=0AZ\r\n= \r\n f \x01"), ("\nZ\r\n f ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(" = \r\n~\rZ\rD"), (" ~\rZ\rD", "")
  assert_eq qp_dec(hx("0d465a6620610a463d33445a66e93d33440de93d33443d3344")), (hx("0d465a6620610a463d5a66e93d0de93d3d"), "")
  assert_eq qp_dec(hx("3d43333d41395a303d3344203d673d0d0a3d43333d4139e96166")), (hx("c3a95a303d203d67c3a9e96166"), "")
  assert_eq qp_dec("=g=a=g= \r\na= \r\nD0=C3=A9\r\n\t=\n=g=0AD=3D=0A==gFZ"), ("=g=a=gaD0é\r\n\t=g\nD=\n==gFZ", "")
  assert_eq qp_dec("a= \r\n=C3=A9"), ("aé", "")
  assert_eq qp_dec(hx("e93d3344443d43333d41393d33447e443d30417e")), (hx("e93d44c3a93d7e440a7e"), "")
  assert_eq qp_dec("=3D\r\nZ0=3D \n=f\r\n\r=\r\n~f0a=\n= \r\n= \r\n= \r\n=C3=A9\t=g"), ("=\r\nZ0=\n=f\r\n\r~f0aé\t=g", "")
  assert_eq qp_dec(hx("e93d3041e930660d0a093d30413d2044463d663d334401")), (hx("e90ae930660d0a090a3d2044463d663d"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\n\t\nD f\r\r\n=\n"), ("\nD f\r\n", "")
  assert_eq qp_dec("=\n ==0A Z\r"), (" =\n Z", "")
  assert_eq qp_dec(" =0A=0A\x01Z=3D\n=gZF\nZ=\n\r\n= \r\n=3D"), (" \n\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("303d0a3d0d0a303d0d0a3d43333d4139e93d0a3d30410a3d334446015a0d0a")), (hx("3030c3a9e90a0a3d46"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\r\n0=3D"), ("0=", "")
  assert_eq qp_dec(hx("3d3041e93d200d0a3d6761")), (hx("0ae93d6761"), "")
  assert_eq qp_dec("\n~~F=C3=A9=C3=A9Zf\tD F\n"), ("\n~~FééZf\tD F\n", "")
  assert_eq qp_dec("\n"), ("\n", "")
  assert_eq qp_dec(" D\x01Fa~0=\nfZ=C3=A9"), (" D", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0d0ae920013d200d0a097e6130013d673d3344443d0a3d7e613d43333d41390ae93d43333d41393d093d3344")), (hx("0d0ae920"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("F\r\n\r\n=0A\nZ\rf0Fa =3D=\r\na=\r\nD\r\t"), ("F\r\n\r\n\n\nZ\rf0Fa =aD", "")
  assert_eq qp_dec("=0A=C3=A90=gf\r=g\r\n"), ("\né0=gf\r=g\r\n", "")
  assert_eq qp_dec(hx("e9203d3d30413d30417e3de9090d0a")), (hx("e9203d0a0a7e3de90d0a"), "")
  assert_eq qp_dec(hx("66e95a0d20093d30413d3d200d0a5a7e0a0a3d43333d41393d30410d0a0d0a3d0a093d200d0a3d3344613d0d0a3d67")), (hx("66e95a0d20090a"), "unexpected EOF")
  assert_eq qp_dec(hx("307e66e9303d677e5a460d445a3d093d43333d41394461015ae9")), (hx("307e66e9303d677e5a460d445a3d09c3a94461"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d200d0ae90d0a447e46")), (hx("e90d0a447e46"), "")
  assert_eq qp_dec("=\n~=\r\n\n\nD=3D=3DF~~\ra\t0=g"), ("~\n\nD==F~~\ra\t0=g", "")
  assert_eq qp_dec("=\r\n~=\t~\t\r D=0A\r\n\r=3D=3D==0A Z\r=C3=A9= \r\n\tD"), ("~=\t~\t\r D\n\r\n\r===\n Z\ré\tD", "")
  assert_eq qp_dec("= \r\n=3D\n=\r\nF"), ("=\nF", "")
  assert_eq qp_dec("=3D=g=3D=\r\n"), ("==g=", "")
  assert_eq qp_dec(hx("615a303d43333d41393d33443d30413d0d0a0d0a3d3344e97e3d33443d0d0a090d0a3d3344e97e")), (hx("615a30c3a93d0a0d0a3de97e3d0d0a3de97e"), "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec("F=C3=A9a\nZ"), ("Féa\nZ", "")
  assert_eq qp_dec(hx("3044e9203d460a463d0a0d46300d0d0a3d200d0a0d3d3344e9613d43333d4139")), (hx("3044e9203d460a460d46300d0a0d3de961c3a9"), "")
  assert_eq qp_dec(hx("5a6666200a3d0a3d67613d43333d41393d0d0a3d3344e90a663d43333d41393d46e93d673d09")), (hx("5a66660a3d6761c3a93de90a66c3a93d46e93d67"), "")
  assert_eq qp_dec(hx("7e3d3344e93d33443d3344093d304161e9013d0d0a")), (hx("7e3de93d3d090a61e9"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("460d0a614409e93d43333d41390d0a013d200d0a443d43333d4139440120e90d0a0d0a3d30416644")), (hx("460d0a614409e9c3a90d0a"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d43333d41395a5a3d67e90a")), (hx("c3a95a5a3d67e90a"), "")
  assert_eq qp_dec("D\r\n \r\n aD\r\n"), ("D\r\n\r\n aD\r\n", "")
  assert_eq qp_dec("D=gF"), ("D=gF", "")
  assert_eq qp_dec(hx("e9303d30413d0d0a5a3d6701")), (hx("e9300a5a3d67"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r"), ("", "")
  assert_eq qp_dec(hx("3d3041460d0944e9665a3d200d0a013d0d0a3d0d0a3d30410d0a0d0a")), (hx("0a460d0944e9665a"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d0ae93d67303d33445ae93d43333d41393d0a303d43333d41393d0d0a3d200d0a")), (hx("e93d67303d5ae9c3a930c3a9"), "")
  assert_eq qp_dec(hx("3d670a0de90d663d43333d41390d3d3041203d43333d413946")), (hx("3d670a0de90d66c3a90d0a20c3a946"), "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec("0\x01f=0A"), ("0", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=C3=A9\x01==0A=\r\n~Z"), ("é", "quotedprintable: invalid unescaped byte 0x01 in body")
}

test "vectors: reader 4" {
  assert_eq qp_dec("0=0AZFF\r\n=\r\nD=C3=A9\n"), ("0\nZFF\r\nDé\n", "")
  assert_eq qp_dec("F=g=\r\n~\x01=\r\n=C3=A9=g=0A=\r\n0\r\t=0A\t=C3=A9= \r\n \r\n==C3=A9= \r\n"), ("F=g~", "quotedprintable: invalid unescaped byte 0x01 in body")
