  assert_eq qp_dec(hx("663d0a010a3d33445a3d67e90d3d090146440d0a3d43333d41390d0d0a443d200d0a")), ("f", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=gD"), ("=gD", "")
