  assert_eq qp_dec("\r\n=\r\nF==0A~"), ("\r\nF=\n~", "")
  assert_eq qp_dec(hx("613d3041613d01e93d43333d4139663d010d0a46443d3344")), ("a\na=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("e9e90a09e90d0a0a3d0a663d30413d30413d43333d41393d200d0a090a0d660d0a3d43333d41390a20203009")), (hx("e9e90a09e90d0a0a660a0ac3a90a0d660d0ac3a90a202030"), "")
  assert_eq qp_dec(hx("e93d67")), (hx("e93d67"), "")
  assert_eq qp_dec(hx("7e3d200d0a0d0de94420443d673d33443d0d0a3d0a663d33446601")), (hx("7e0d0de94420443d673d663d66"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("==C3=A9\tDFD\r=g=g~= \r\n=C3=A9a\x01"), ("=é\tDFD\r=g=g~éa", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r=C3=A9\r\n \r\n=g = \r\n\rF= \r\n"), ("\ré\r\n\r\n=g \rF", "")
  assert_eq qp_dec("\r\nf=\r\n"), ("\r\nf", "")
  assert_eq qp_dec("=g\n\t\x01\r\n\rD==0A=C3=A9=3D0\n\nD\r\n=3D=3D\t\x01=C3=A9= \r\n=C3=A9"), ("=g\n\t", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=C3=A9=\n=3D\t=3Da=C3=A9\x01=\n\r\n\n=\r\nf\r=g~Z\r\n"), ("é=\t=aé", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d43333d4139e961613d673d33440d3d0a7ee94401665a3d67")), (hx("c3a9e961613d673d0d7ee944"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d43333d41390d0a300d0a463d0d0a5a3d200d0a3d673d0a3d334466203d43333d4139200d303d30415ae9")), (hx("c3a90d0a300d0a465a3d673d6620c3a9200d300a5ae9"), "")
