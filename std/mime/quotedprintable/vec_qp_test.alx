  assert_eq qp_dec("\nF==C3=A9\r\n\r\nfF\r\n=\r\n=\r\n==gf=\n0"), ("\nF=é\r\n\r\nfF\r\n==gf0", "")
  assert_eq qp_dec(hx("3d3d43333d41393d673d33443d0d0a0d0a613d33443d30416161443d334444e93d43333d41393d0a3d3d43333d41390a")), (hx("3dc3a93d673d0d0a613d0a6161443d44e9c3a93dc3a90a"), "")
  assert_eq qp_dec(hx("e93d0d0a203d443d0a3d0a3d3344013d0a0a3d67e93d304166203d0d0a303d200d0a61")), (hx("e9203d443d"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("6146093d3041015a3d67e9445a61")), ("aF\t\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=0A=\n\r\n=3D~\r\n= \r\n=C3=A9= \r\n==0A\t=g~"), ("\n\r\n=~\r\né=\n\t=g~", "")
  assert_eq qp_dec("f"), ("f", "")
  assert_eq qp_dec(hx("5ae93d6766462066663d43333d41393d43333d41393d0d0a3d0d0a0a0a0961617e66")), (hx("5ae93d676646206666c3a9c3a90a0a0961617e66"), "")
  assert_eq qp_dec(hx("3d0d0ae93d7e0130")), (hx("e93d7e"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d33443d200d0a3d203d5a3d3041613d0a3d0a3d0a3d33443d304120e90d0a3d200d0a09")), (hx("3d3d203d5a0a613d0a20e90d0a"), "")
  assert_eq qp_dec(hx("09303d0a440a3d0d0a613d200d0a44203d200d0a5a3d677e6109e93d33440a0d66")), (hx("0930440a6144205a3d677e6109e93d0a0d66"), "")
  assert_eq qp_dec("\n=C3=A9=0A\t=F=\r\n\r\n\r\nFF=0A= \r\n=C3=A9=\n\x01=0A=\nD0"), ("\né\n\t=F\r\n\r\nFF\né", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("f=C3=A9\r\n=3D= \r\n0\x01D0 = \r\n=\n"), ("fé\r\n=0", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec("=\x01=0A\tD \x01a=\r\n\t= \r\n=3D\t\r\r\n"), ("=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec("~"), ("~", "")
  assert_eq qp_dec("Z"), ("Z", "")
  assert_eq qp_dec(hx("0d3d6766445a66e90a7e3d0a460a0a7e61")), (hx("0d3d6766445a66e90a7e460a0a7e61"), "")
  assert_eq qp_dec("F=C3=A9a\x01a\x01 Z=C3=A9=C3=A9"), ("Féa", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("= \r\n=3D=\nD=C3=A9a=="), ("=Déa", "unexpected EOF")
  assert_eq qp_dec("0\nFZ"), ("0\nFZ", "")
  assert_eq qp_dec(" a\t=\r\n\x01=\r\n\x01\t=3Df\t=g= \r\na== \r\n=3D==0A"), (" a\t", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("e9442030663d3d43333d4139")), (hx("e9442030663dc3a9"), "")
  assert_eq qp_dec("Z0=3D=3DZ=C3=A9=g0\r\nF\x01\r==3Da\t=C3=A9"), ("Z0==Zé=g0\r\nF", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("5ae90d0a3d43333d41393d33440161443de95a5a0a613d30")), (hx("5ae90d0ac3a93d"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\n"), ("\n", "")
  assert_eq qp_dec(hx("5a3d3d0d0a3d0d0a0161203d43333d41390946e9e93d0d0a0d61460d0a3d43333d4139617e44")), ("Z", "unexpected EOF")
  assert_eq qp_dec("F=gf\tZ== \r\n= \r\n=C3=A9F=0A\t=3D=\r\n\t==g=C3=A9\x01ZF"), ("F=gf\tZ", "unexpected EOF")
  assert_eq qp_dec(hx("3d30413d43333d41393d3344e93d0d0a303020463d43333d4139")), (hx("0ac3a93de930302046c3a9"), "")
  assert_eq qp_dec("\r=\n=\n\x01\n=\n=\r\n=0A=3DZ= \r\n=\n\r=\naD\r\n=\r\n="), ("\r", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d30413d0d0a660de9303d67e93d67e93d0d0a3d673d0a460d0a0d460130e9")), (hx("0a660de9303d67e93d67e93d67460d0a0d46"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("D=C3=A9f=\r\n"), ("Déf", "")
  assert_eq qp_dec("Z==3DF=\r\n=f=3DF=\nF=0A=\r\na\tF"), ("Z==F=f=FF\na\tF", "")
  assert_eq qp_dec("a=\nff=0A=3D\x01=\na=0A=0A\t~=C3=A9="), ("aff\n=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("= \r\n"), ("", "")
  assert_eq qp_dec(hx("3d0a3d3d43333d4139e9305a615a090a443001e9")), (hx("3dc3a9e9305a615a0a4430"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\r\n\rf\n\t~= \r\n==C3=A9==3Da0F= \r\n\t"), ("\rf\n\t~=é==a0F", "")
  assert_eq qp_dec(hx("e9203d304166303d0a3d200d0a3d33443d200d0a203d0d0a09463d673d0a6144093d200d0a0a46660d0a")), (hx("e9200a66303d2009463d676144090a46660d0a"), "")
  assert_eq qp_dec("\r\n= \r\n"), ("\r\n", "")
  assert_eq qp_dec("D=\na\t\r==g=g=f\r\nD\t"), ("Da\t\r==g=g=f\r\nD", "")
  assert_eq qp_dec(hx("20e9303d43333d41393d0d0a7ee93d6701015a3d30413d3d0a3d3041467e0a613d0d0a203d67e93d")), (hx("20e930c3a97ee93d67"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("= \r\n\r0"), ("\r0", "")
  assert_eq qp_dec("= \r\n=C3=A9~=0A=\r\n=0A=C3=A9=a=g\r\n=g= \r\n=\n"), ("é~\n\né=a=g\r\n=g", "")
  assert_eq qp_dec(hx("3d200d0a7e61203d30410d0a3d0d0a0a0a300d20013d0ae93d67093d33443d673d0d0a01")), ("~a \n\r\n\n\n0\r ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("F\r\r\nD\tZ\x01=g \r"), ("F\r\nD\tZ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\x01f=\t\r\n\n"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0a3d200d0a013d200d0a3d304109443d43333d41393d33445ae90946")), ("\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("a\x010\raZ\n"), ("a", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d200d0a3d0d0a0a3d33443d43333d41393d0a3d670d0a3d33443d334446e93d334446203d33440d613d200d0a3d3041")), (hx("0a3dc3a93d670d0a3d3d46e93d46203d0d610a"), "")
  assert_eq qp_dec("=3DZ=\n\rf=\n"), ("=Z\rf", "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec("=C3=A9"), ("é", "")
  assert_eq qp_dec(hx("3d200d0a4401e93d200d0a5a3d670130093d3d304161203d43333d41393d30413d200d0a3d3041443d200d0a7e")), ("D", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=3D=0A Z=3DZ"), ("=\n Z=Z", "")
  assert_eq qp_dec("=0AD= \r\n\r\x01=g"), ("\nD\r", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("0a3d30413d0d0a0d0a46613d090d44203d0d3d0a013d0d0a0ae93d0a")), ("\n\n\r\nFa=\t\rD ", "unexpected EOF")
  assert_eq qp_dec("=\r\n\x01\x01=g=\r\nF\r=0A"), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=C3=A9 ~=gF\r\nZFZ~"), ("é ~=gF\r\nZFZ~", "")
  assert_eq qp_dec("=\n\x01\rZfaf=\r\n "), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("7e0d0a5a203d0d0a0a5a44e9")), (hx("7e0d0a5a200a5a44e9"), "")
}

test "vectors: reader 2" {
  assert_eq qp_dec(hx("3d0a61663d0d0a443d0a5a3d200d0a44610d3d67e9613d3344e9")), (hx("6166445a44610d3d67e9613de9"), "")
  assert_eq qp_dec("\r=3DF=3D~Da~=\n\x01\r\n\r\n=\n==3D\rZ"), ("\r=F=~Da~", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("61e9610d0a46013d43333d413920")), (hx("61e9610d0a46"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=C3=A9\tFf\r\n"), ("é\tFf\r\n", "")
  assert_eq qp_dec(hx("7e3d43333d41393044013d200d0a3d0a010d0a015a0d3d0d0a3d0a61207e303d3041e9663d0a46")), ("~é0D", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\tZ=\n=\n"), ("\tZ", "")
  assert_eq qp_dec("\t\t =3D\n=\r\n=3D \r\n"), ("\t\t =\n=\r\n", "")
  assert_eq qp_dec("a ==\n"), ("a ", "unexpected EOF")
  assert_eq qp_dec(hx("44613d675a7e0d0a3d30414461443d0a66e9440d0a")), (hx("44613d675a7e0d0a0a44614466e9440d0a"), "")
  assert_eq qp_dec(" =\r\n\x01\x01= \r\n\r\n=\r\n\r\n=3D~0"), (" ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=g"), ("=g", "")
  assert_eq qp_dec(hx("094620e90a3d43333d41390d0a")), (hx("094620e90ac3a90d0a"), "")
  assert_eq qp_dec("f"), ("f", "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("0d0ae90d0a5a6146093d33440d7e0d0d3d67303d33443d200d0a0d0a013d33443d43333d41397e3d0d0a")), (hx("0d0ae90d0a5a6146093d0d7e0d0d3d67303d0d0a"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\n=C3=A9\x01=0A"), ("\né", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("20013d30415a0a303d334401613d43333d413966443d67e901e90d7e3d0d0a")), (" ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\r\n\r\na=g0f"), ("\r\na=g0f", "")
  assert_eq qp_dec("\t\x01=g\r\n =\nFZF=C3=A9\tZ =g=0A~"), ("\t", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=g==f=3D=g= \r\n=\r\n"), ("=g==f==g", "")
  assert_eq qp_dec(hx("3d0d0a46e93d6730090a3d43333d41395a463d67610a0a0a0a0d0d093d200d0a3d3d0d0a")), (hx("46e93d67300ac3a95a463d67610a0a0a0a0d0d09"), "unexpected EOF")
  assert_eq qp_dec("F=\n=\n\x01f=\r\n"), ("F", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d20613d614401093d43333d41390a0de93d")), (hx("3d2061ad"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("ZD\x01f=0A= =\r\n~D=\r\nf"), ("ZD", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(" =0A0 =0A0"), (" \n0 \n0", "")
  assert_eq qp_dec(hx("090a3d67097e0a7ee94630")), (hx("0a3d67097e0a7ee94630"), "")
  assert_eq qp_dec(hx("3d30413d0a463d2046203d0a3d33443d33440d0a0a20667e3d200d0a0d0d3d3344e90a3d3041")), (hx("0a463d2046203d3d0d0a0a20667e0d0d3de90a0a"), "")
  assert_eq qp_dec(hx("09e93d304130303d3d3344440a3d30415a3d0a3d673d200d0a")), (hx("09e90a30303d3d440a0a5a3d67"), "")
  assert_eq qp_dec(hx("200d0a0d0a3d33447e443d0d0ae930")), (hx("0d0a0d0a3d7e44e930"), "")
  assert_eq qp_dec("=Z=g=0A"), ("=Z=g\n", "")
  assert_eq qp_dec(hx("5a3d200d0a613d67463d43333d4139e944463d0d0a7e0d20203d0a4409e93d33443d0d0a66663d43333d413944")), (hx("5a613d6746c3a9e944467e0d20204409e93d6666c3a944"), "")
  assert_eq qp_dec("\r\nD=gaf=0=\n\tZZ~"), ("\r\nD=gaf=0\tZZ~", "")
  assert_eq qp_dec("Z\x01f\r\r=C3=A9\r= \r\n=0AZ="), ("Z", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\n=\r\nZ"), ("\nZ", "")
  assert_eq qp_dec("\nFF=0A=\n"), ("\nFF\n", "")
  assert_eq qp_dec("=\t\n = \r\n=C3=A9"), (" é", "")
  assert_eq qp_dec("a"), ("a", "")
  assert_eq qp_dec(hx("0a20e93d67093d33446144")), (hx("0a20e93d67093d6144"), "")
  assert_eq qp_dec(hx("663d200d0a0a3d43333d41393d443d200d0a463d304120205a09467e203d0a300a3d304120e9")), (hx("660ac3a93d44460a20205a09467e20300a0a20e9"), "")
  assert_eq qp_dec("Z"), ("Z", "")
  assert_eq qp_dec(hx("0946203d0d0a0a5ae93d46")), (hx("0946200a5ae93d46"), "")
  assert_eq qp_dec("Z =g0\t=gZ=D\n\t"), ("Z =g0\t=gZ=D\n", "")
