  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("303d33447e20093d200d0ae93d43333d4139e9200a46203d0d0a0d660d0a")), (hx("303d7e2009e9c3a9e90a46200d660d0a"), "")
  assert_eq qp_dec(hx("3d30417e30e9460d3d43333d413909")), (hx("0a7e30e9460dc3a9"), "")
  assert_eq qp_dec("~00= \r\n=g=\r\n=\n"), ("~00=g", "")
  assert_eq qp_dec("\rfF~\n\n=C3=A9F\n=g\t\n= \r\n=Zf"), ("\rfF~\n\néF\n=g\n=Zf", "")
  assert_eq qp_dec(hx("463d6720303d43333d4139093d30413d0a0d0a663d43333d41390d7ee9")), (hx("463d672030c3a9090a0d0a66c3a90d7ee9"), "")
  assert_eq qp_dec(hx("0d3d3344e93d0d0a5a440d0a")), (hx("0d3de95a440d0a"), "")
  assert_eq qp_dec("\n= \r\nF\r\n\r\n=3DF=gD=g=\n=g"), ("\nF\r\n\r\n=F=gD=g=g", "")
  assert_eq qp_dec("=Da=0A\n0a\r\r\n=\n= \r\n\rf\r\n"), (hx("da0a0a30610d0a0d660d0a"), "")
