  assert_eq qp_dec("~aa0=C3=A9"), ("~aa0é", "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("463d3d090901e9445a5a3d30417ee9")), ("F==\t\t", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d0a0de9443d0a20093d0d0a0d66093d67094609610d663d0d0a3d0a7e09")), (hx("0de94420090d66093d67094609610d667e"), "")
  assert_eq qp_dec(hx("5a5ae90a3d200d0a0a7e0a3d673d43333d4139010a0a3d43333d4139093d200d0a3d3344e9")), (hx("5a5ae90a0a7e0a3d67c3a9"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("= \r\n\r \r\n\t= \r\n=\n= \r\nf= \r\nF"), ("\r\n\tfF", "")
  assert_eq qp_dec("\n=3D=C3=A9f= \r\n\r=C3=A9=\nD =gf\t=\r\n\n=g=0Aa\x01="), ("\n=éf\réD =gf\t\n=g\na", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("00=C3=A9F= \r\n\r\nDa=3Df=gDa\r=C3=A9\x01F0a~\t\r\n"), ("00éF\r\nDa=f=gDa\ré", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("e9663d676661204466613d0d0a3d33445a3d43333d413961")), (hx("e9663d676661204466613d5ac3a961"), "")
  assert_eq qp_dec(hx("3d200d0a3d30413d673d43333d4139203d43333d4139094666013d30413d3041205a09e9e9090d0a3d200d0a613001")), ("\n=gé é\tFf", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("aZ"), ("aZ", "")
  assert_eq qp_dec(hx("3d0d0a3d200d0a5a012066010a4646013d673d43333d4139e9663d43333d413901303d43333d41395a3d43333d41393d0a3d0a")), ("Z", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("663d0d0a09203d0d0a0ae9013d0a3d200d0a3d3041465a3d0d0ae90d0a61300a30")), (hx("6609200ae9"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("5a5a3d30413d43333d41393d3344e93d33440a3d43333d4139200d7e3d304161")), (hx("5a5a0ac3a93de93d0ac3a9200d7e0a61"), "")
  assert_eq qp_dec(hx("443d0a46443d200d0a0d3d200d0a3d0d0a3d200d0a3d33443d200d0a0a090d0a442066445a5a3d3041463d67e9")), (hx("4446440d3d0a0d0a442066445a5a0a463d67e9"), "")
  assert_eq qp_dec(hx("3d33443d3d43333d41392020093d673d0a3d673d43333d41395a09e94666200d0a3d0d0a3d200d0a3d6720440d0a")), (hx("3d3dc3a92020093d673d67c3a95a09e946660d0a3d6720440d0a"), "")
  assert_eq qp_dec(hx("61e93d43333d41393d0a3d0d0a3d0d3d43333d41393d200d0a3d7e3d43333d41390d0a0a61447e663d0d0ae9e920")), (hx("61e9c3a9"), "quotedprintable: invalid hex byte 0x0d")
  assert_eq qp_dec("\tZF=\r\na=\n"), ("\tZFa", "")
  assert_eq qp_dec("=\n=\r\n=C3=A9=0A\r\n=g=C3=A9Z\r\n=\r\na=g"), ("é\n\r\n=géZ\r\na=g", "")
  assert_eq qp_dec(hx("61e93de97ee90d3d673d33443d0d0a203d200d0a0146466146200a")), (hx("61e93de97ee90d3d673d20"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r=3DZ\tFZ=\n =\x01=\r\n=\r\n  =0A~\rf=C3=A9~ \x01=g"), ("\r=Z\tFZ =", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("~0\rFf=C3=A9=\r\nF\n~= \r\n= \r\n=\n\r\n\t\t"), ("~0\rFféF\n~\r\n", "")
  assert_eq qp_dec(hx("61465a3d30413d0d0a3d673d200d0ae966097e3d43333d4139e90a303d33447e613d0a30")), (hx("61465a0a3d67e966097ec3a9e90a303d7e6130"), "")
  assert_eq qp_dec(hx("0a7e3d0a3d3041e96620")), (hx("0a7e0ae966"), "")
  assert_eq qp_dec("=\n\r\n\r=\nF=g\tf=C3=A9=g=3D \r\na\n\r\n"), ("\r\n\rF=g\tfé=g=\r\na\n\r\n", "")
  assert_eq qp_dec("aa"), ("aa", "")
  assert_eq qp_dec(hx("20663d0d0a61463d670a3d0a3d43333d4139660d0a3d673d43333d41393d334420e90d0a463d3344")), (hx("206661463d670ac3a9660d0a3d67c3a93d20e90d0a463d"), "")
  assert_eq qp_dec(hx("3d33443d0d0a3d0d0a3d3d0d0a013d0d0a3d0a01613d0d0a4661300d0ae9615a")), ("=", "unexpected EOF")
  assert_eq qp_dec(hx("3d200d0a465a44010d0a667e0de93d200d0a3d670d0d7e")), ("FZD", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d43333d41393d5ae9613d672030610146")), (hx("c3a93d5ae9613d67203061"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("= \r\nD\r\ta\t"), ("D\r\ta", "")
  assert_eq qp_dec("=g=gZ=0A\t a\n=3D=0Af0 =0A==\na=3Df=\r\n"), ("=g=gZ\n\t a\n=\nf0 \n", "unexpected EOF")
  assert_eq qp_dec("D\t\r\n=0A=F\r\n=g\r\n=C3=A9f=\n f\x01\tF="), ("D\r\n\n=F\r\n=g\r\néf f", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\n\n=3DF=C3=A9 ~F= \r\n=3D=g=0AZ\n\n=C3=A9ff=\r\n\tZ=\r\n "), ("\n\n=Fé ~F==g\nZ\n\néff\tZ", "")
  assert_eq qp_dec(hx("0a3d200d0a3d5a5a09203d43333d41393d30413d673d200d0a0ae93d43333d4139")), (hx("0a3d5a5a0920c3a90a3d670ae9c3a9"), "")
  assert_eq qp_dec(hx("3d30413d3344613d43333d4139200a3d43333d41393d0a3d6744097e66460d01467e0d0ae9")), ("\n=aé\né=gD\t~fF\r", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("20e95a3046300d0a3d3041093d30613d670a013d0d0a61667e3d334446")), (hx("20e95a3046300d0a0a090a3d670a"), "quotedprintable: invalid unescaped byte 0x01 in body")
