  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("0d0a3d0a3d5a3de90d")), (hx("0d0a3d5a3de9"), "")
  assert_eq qp_dec("=g=3D=C3=A9=\r\n"), ("=g=é", "")
  assert_eq qp_dec(hx("3d30413d3d200d0a3d670d613d0d0ae90a303d30417e3d200d0a3d3d43333d4139443d3041203d3041")), ("\n", "unexpected EOF")
  assert_eq qp_dec("\na== \r\n\x01\t=C3=A9~\n=\x01F~\n==0A= \r\nF=3DDD"), ("\na", "unexpected EOF")
  assert_eq qp_dec("F= \r\n\r\nD\n\r\n~\r\n\r\nF=0A\n=C3=A90 F=3D= \r\na"), ("F\r\nD\n\r\n~\r\n\r\nF\n\né0 F=a", "")
  assert_eq qp_dec(hx("7e3de90a")), (hx("7e3de90a"), "")
  assert_eq qp_dec("=C3=A9=\x01Z"), ("é=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\r\n=\n=C3=A9\r\n= \r\n"), ("\r\né\r\n", "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec("\t"), ("", "")
