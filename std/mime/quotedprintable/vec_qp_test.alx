  assert_eq qp_dec(" =0AD\n=C3=A9==3D"), (" \nD\né==", "")
  assert_eq qp_dec(hx("0a3d43333d41393d0a3d0d0a3046e90120200d0a303d33442030663d30413d33443d673d67")), (hx("0ac3a93046e9"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("D0~= \r\n"), ("D0~", "")
  assert_eq qp_dec(" 0a\x01=\n\n0~D=gFaZ=g=\n=C3=A9=0A"), (" 0a", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("Z\x01"), ("Z", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("4620e93d200d0ae90a3d0d0a3d3041013d200d0a3d3d6709")), (hx("4620e9e90a0a"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=\r\nf\rf"), ("f\rf", "")
  assert_eq qp_dec(" 0=0A= \r\nZ\x01"), (" 0\nZ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("a\r\r\n=0A=C3=A9=C3=A9\tF~\r\n 0=C3=A9\n"), ("a\r\n\néé\tF~\r\n 0é\n", "")
  assert_eq qp_dec(hx("44e9443d0a09443d0d0a3d0a203d0a0d3d")), (hx("44e9440944200d"), "")
  assert_eq qp_dec("=\nZ=3Df~=g\x01\r=0A Z=\r\na=\r\nf=D=C3=A9= \r\n"), ("Z=f~=g", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("Z\r\n=\r\n=3D=a=\r\n= \r\n\r\nf 0FF=g= \r\n f\x01D"), ("Z\r\n==a\r\nf 0FF=g f", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=3D\nfD0\r\r\n\x01\r\t\r=3D0=3D=C3=A9\t\rf=3D"), ("=\nfD0\r\n", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=0A\r~== \r\n\r\n"), ("\n\r~", "unexpected EOF")
  assert_eq qp_dec(hx("443d33443d0d0a3d30413d200d0a0a0d6144e93d43333d41390a0d01463d0d0a3d3344303d0a3d673d3d200d0a")), (hx("443d0a0a0d6144e9c3a90a0d"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3d0d0a3d6701e90d0a4466")), ("=g", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3de9090d0a200d665a3d7e")), (hx("3de90d0a200d665a3d7e"), "")
  assert_eq qp_dec(hx("0a3d67203d33443d0ae93d43333d41393d200d0a3d43333d41393d304120200a6609013d3344016144")), (hx("0a3d67203de9c3a9c3a90a0a6609"), "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=C3=A9=C3=A9\r\nD\x01\n=3D==3D=g"), ("éé\r\nD", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("f0=g\x01=C3=A9FF"), ("f0=g", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("666120207e0a200130300a303d6620e93d677e3d093d67095a")), ("fa  ~\n ", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("0\r=C3=A9"), ("0\ré", "")
  assert_eq qp_dec(hx("0a30613d673d43333d41393d0a3d0d0a3d3041300d0d0a463d0ae9e95a3d200d0a613d200d0a3d673d")), (hx("0a30613d67c3a90a300d0a46e9e95a613d67"), "")
  assert_eq qp_dec(hx("3d0a01667e3d67e93d30413d43333d41390d3d0a0a467ee9")), ("", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("=0A~\n=g=C3=A9=0A\tZ=C3=A9"), ("\n~\n=gé\n\tZé", "")
  assert_eq qp_dec("=\n\r= \r\nfa"), ("\rfa", "")
}

test "vectors: reader 5" {
  assert_eq qp_dec("=g\rf0\x01= \r\n=\n\t\t=\r\n=a=C3=A9\t\n\x01\r\n=C3=A9"), ("=g\rf0", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec("\na\r\na =\n== \r\n=\r\na==\n=g=g=0A\r\nZf=\n==3D="), ("\na\r\na ", "unexpected EOF")
  assert_eq qp_dec(hx("3d0a3de93d33445a")), (hx("3de93d5a"), "")
  assert_eq qp_dec(""), ("", "")
  assert_eq qp_dec(hx("5a615a5a3d0d0a3d673de90d0a3d0a44303d200d0a440d")), (hx("5a615a5a3d673de90d0a443044"), "")
  assert_eq qp_dec("\n=\n\r=\n=\r\n"), ("\n\r", "")
  assert_eq qp_dec("=\nZ=\r\na=3Da0Z\r\nFFaa=3DF\n=g"), ("Za=a0Z\r\nFFaa=F\n=g", "")
  assert_eq qp_dec("==\n=\nfa=g=3Da=\r\n=\n\r\n= \r\na\r\r\rf\n=\r\n=3D=f \n"), ("", "unexpected EOF")
  assert_eq qp_dec(hx("3d0a7e3020300d0a3d33443d43333d4139663d3344010d3d0ae944")), ("~0 0\r\n=éf=", "quotedprintable: invalid unescaped byte 0x01 in body")
  assert_eq qp_dec(hx("3066093d677e3d200d0ae90d0a")), (hx("3066093d677ee90d0a"), "")
  assert_eq qp_dec("~0=g0\r=C3=A9=C3=A9=C3=A9=3D"), ("~0=g0\rééé=", "")
  assert_eq qp_dec(hx("0a3d0d0a3d200d0a663d3d33443d3041e9")), (hx("0a663d3d0ae9"), "")
  assert_eq qp_dec("~\x01~~F=C3=A9=3D~=\n"), ("~", "quotedprintable: invalid unescaped byte 0x01 in body")
