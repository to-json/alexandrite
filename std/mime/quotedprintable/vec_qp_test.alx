  assert_eq qp_dec("~=\r\n0=\n0Z=gF 0fD=C3=A9D="), ("~00Z=gF 0fDéD", "")
  assert_eq qp_dec(hx("0d0a3d013d43333d413930e9666109")), ("\r\n=", "quotedprintable: invalid unescaped byte 0x01 in body")
