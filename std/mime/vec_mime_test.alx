  assert_eq wd("=?iso-8859-1?Q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??=  "), ("  ", "")
  assert_eq wd("é_Zm9v=?utf-8?x?\r\n =zz=?us-ascii?q?a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é_Zm9v=?utf-8?x?\r\n =zz=?us-ascii?q?a"), ("é_Zm9v=?utf-8?x?\r\n =zz=?us-ascii?q?a", "")
  assert_eq wd("=?utf-8?q?=3F=3FZg==?=\r\n\t=?UTF-8?B?=E9a?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3F=3FZg==?=\r\n\t=?UTF-8?B?=E9a?=  "), ("=?utf-8?q?=3F=3FZg==?=\r\n\t=?UTF-8?B?=E9a?=  ", "")
  assert_eq wd("=?iso-8859-1?Q?=C3=A9é====??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=C3=A9é====??="), ("=?iso-8859-1?Q?=C3=A9é====??=", "")
  assert_eq wd("=?utf-8?b?=3F=E9?=\r\n\t=?UTF-8?B?Zg===3F?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3F=E9?=\r\n\t=?UTF-8?B?Zg===3F?=\r\n\t"), ("=?utf-8?b?=3F=E9?=\r\n\t=?UTF-8?B?Zg===3F?=\r\n\t", "")
  assert_eq wd("=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?"), ("=?utf-8?x?", "")
  assert_eq wd("=?iso-8859-1?Q?=C3=A9=C3=A9=3F?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=C3=A9=C3=A9=3F?= x "), ("Ã©Ã©? x ", "")
  assert_eq wd("=?x-unknown?q?====?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?====?"), ("=?x-unknown?q?====?", "")
  assert_eq wd("=?UTF-8?B?=C3=A9?= x =?UTF-8?B??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=C3=A9?= x =?UTF-8?B??=  "), ("=?UTF-8?B?=C3=A9?= x   ", "")
  assert_eq wd("\r\n _ =?utf-8?x?=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n _ =?utf-8?x?=?x-unknown?q?"), ("\r\n _ =?utf-8?x?=?x-unknown?q?", "")
  assert_eq wd("=?utf-8?b??=\r\n\t=?us-ascii?q?w6k=Zm9vw6k=?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t=?us-ascii?q?w6k=Zm9vw6k=?=\r\n\t"), ("\r\n\t=?us-ascii?q?w6k=Zm9vw6k=?=\r\n\t", "")
  assert_eq wd("w6k=é_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k=é_"), ("w6k=é_", "")
  assert_eq wd("=?iso-8859-1?Q??= x =?utf-8?b??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??= x =?utf-8?b??=  "), (" x   ", "")
  assert_eq wd("=?utf-8?x??==?utf-8?q? w6k=?=plainZm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x??==?utf-8?q? w6k=?=plainZm9v"), ("=?utf-8?x??==?utf-8?q? w6k=?=plainZm9v", "")
  assert_eq wd("=?utf-8?q??==?utf-8?q?=C3=A9Zg==?= x =?utf-8?q?w6k=QW5k_?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??==?utf-8?q?=C3=A9Zg==?= x =?utf-8?q?w6k=QW5k_?=\r\n\t"), ("=?utf-8?q?=C3=A9Zg==?= x =?utf-8?q?w6k=QW5k_?=\r\n\t", "")
  assert_eq wd("=?utf-8?x?_cw==éZm9v=?us-ascii?q?plain?====="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?_cw==éZm9v=?us-ascii?q?plain?====="), ("=?utf-8?x?_cw==éZm9v=?us-ascii?q?plain?=====", "")
  assert_eq wd("=?iso-8859-1?Q?w6k=?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?w6k=?=  "), ("=?iso-8859-1?Q?w6k=?=  ", "")
  assert_eq wd("éa_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("éa_"), ("éa_", "")
  assert_eq wd("=?utf-8?b??=\r\n\t=?iso-8859-1?Q?=3F?=\r\n\t=?us-ascii?q?cw==Zg===3F?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t=?iso-8859-1?Q?=3F?=\r\n\t=?us-ascii?q?cw==Zg===3F?=\r\n\t"), ("?\r\n\t=?us-ascii?q?cw==Zg===3F?=\r\n\t", "")
  assert_eq wd("plain?==E9\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plain?==E9\n"), ("plain?==E9\n", "")
  assert_eq wd("=?utf-8?q?=3F?=  =?utf-8?q?Zm9vw6k==C3=A9?=\r\n\t=?utf-8?q?Zg==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3F?=  =?utf-8?q?Zm9vw6k==C3=A9?=\r\n\t=?utf-8?q?Zg==?= x "), ("?  =?utf-8?q?Zm9vw6k==C3=A9?=\r\n\t=?utf-8?q?Zg==?= x ", "")
  assert_eq wd("cw==plain\n w6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw==plain\n w6k="), ("cw==plain\n w6k=", "")
  assert_eq wd("=?utf-8?b?=C3=A9Zg==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=C3=A9Zg==?=  "), ("=?utf-8?b?=C3=A9Zg==?=  ", "")
  assert_eq wd("aZg=?utf-8?x??\nplain=?UTF-8?B?=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("aZg=?utf-8?x??\nplain=?UTF-8?B?=?iso-8859-1?Q?"), ("aZg=?utf-8?x??\nplain=?UTF-8?B?=?iso-8859-1?Q?", "")
  assert_eq wd("=?UTF-8?B?Zm9v?=\r\n\t=?utf-8?b?cw==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zm9v?=\r\n\t=?utf-8?b?cw==?="), ("foos", "")
  assert_eq wd(" =4\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" =4\n"), (" =4\n", "")
  assert_eq wd("=?us-ascii?q?cw==w6k==3F?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?cw==w6k==3F?=  "), ("=?us-ascii?q?cw==w6k==3F?=  ", "")
  assert_eq wd("Zm9v=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v=?utf-8?q?"), ("Zm9v=?utf-8?q?", "")
  assert_eq wd("=?UTF-8?B?QW5k?= x =?iso-8859-1?Q?Zg==Zm9v_?= x =?iso-8859-1?Q?_QW5k?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?QW5k?= x =?iso-8859-1?Q?Zg==Zm9v_?= x =?iso-8859-1?Q?_QW5k?="), ("And x =?iso-8859-1?Q?Zg==Zm9v_?= x  QW5k", "")
  assert_eq wd("plaincw==w6k=aZm9é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plaincw==w6k=aZm9é"), ("plaincw==w6k=aZm9é", "")
}

test "vectors: word decoder 21" {
  assert_eq wd(hx("3d3f5554462d383f423f3d43333d41393d45393f3d203d3f7574662d383f713f803f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f3d43333d41393d45393f3d203d3f7574662d383f713f803f3d0d0a09")), (hx("3d3f5554462d383f423f3d43333d41393d45393f3d203d3f7574662d383f713f803f3d0d0a09"), "")
  assert_eq wd("=E9=?=?iso-8859-1?Q?=?us-ascii?q? =E9=?utf-8?q?_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9=?=?iso-8859-1?Q?=?us-ascii?q? =E9=?utf-8?q?_"), ("=E9=?=?iso-8859-1?Q?=?us-ascii?q? =E9=?utf-8?q?_", "")
  assert_eq wd("=?utf-8?q?w6k==C3=A9?="), ("", "mime: invalid hex byte 0x3d")
  assert_eq wdh("=?utf-8?q?w6k==C3=A9?="), ("=?utf-8?q?w6k==C3=A9?=", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f3f3d0d0a093d3f69736f2d383835392d313f513f8077366b3d3f3d3d3f75732d61736369693f713f3d45393d43333d41393d43333d41393f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f3f3d0d0a093d3f69736f2d383835392d313f513f8077366b3d3f3d3d3f75732d61736369693f713f3d45393d43333d41393d43333d41393f3d0d0a09")), (hx("0d0a093d3f69736f2d383835392d313f513f8077366b3d3f3defbfbdefbfbdefbfbdefbfbdefbfbd0d0a09"), "")
  assert_eq wd("w6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k="), ("w6k=", "")
  assert_eq wd(hx("3d3f7574662d383f713f3d334663773d3d3f3d0d0a093d3f75732d61736369693f713f5157356b803d45393f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f3d334663773d3d3f3d0d0a093d3f75732d61736369693f713f5157356b803d45393f3d20")), (hx("3d3f7574662d383f713f3d334663773d3d3f3d0d0a093d3f75732d61736369693f713f5157356b803d45393f3d20"), "")
  assert_eq wd("=?x-unknown?q?é===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?é===="), ("=?x-unknown?q?é====", "")
  assert_eq wd("=?UTF-8?B??="), ("", "")
  assert_eq wdh("=?UTF-8?B??="), ("", "")
  assert_eq wd("aZm9vZgQW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("aZm9vZgQW5k"), ("aZm9vZgQW5k", "")
  assert_eq wd("=?utf-8?q??= x =?us-ascii?q?a?=\r\n\t=?UTF-8?B??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= x =?us-ascii?q?a?=\r\n\t=?UTF-8?B??= x "), (" x a x ", "")
  assert_eq wd("=?UTF-8?B?_w6k=QW5kplain?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?_w6k=QW5kplain?= "), ("=?UTF-8?B?_w6k=QW5kplain?= ", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f3f3d3d3f69736f2d383835392d313f513f803f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f3f3d3d3f69736f2d383835392d313f513f803f3d")), (hx("3d3f69736f2d383835392d313f513f803f3d"), "")
  assert_eq wd("w6k=plainZg=?é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k=plainZg=?é"), ("w6k=plainZg=?é", "")
  assert_eq wd("=?utf-8?q?Zm9vcw==_?==?UTF-8?B?a=C3=A9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zm9vcw==_?==?UTF-8?B?a=C3=A9?=  "), ("=?utf-8?q?Zm9vcw==_?==?UTF-8?B?a=C3=A9?=  ", "")
  assert_eq wd("w6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k="), ("w6k=", "")
  assert_eq wd(hx("3d3f7574662d383f623f3d33463d43333d4139803f3d203d3f75732d61736369693f713f3d45395a673d3d5157356b3f3d2078203d3f75732d61736369693f713f5a673d3d3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f3d33463d43333d4139803f3d203d3f75732d61736369693f713f3d45395a673d3d5157356b3f3d2078203d3f75732d61736369693f713f5a673d3d3f3d0d0a09")), (hx("3d3f7574662d383f623f3d33463d43333d4139803f3d203d3f75732d61736369693f713f3d45395a673d3d5157356b3f3d2078203d3f75732d61736369693f713f5a673d3d3f3d0d0a09"), "")
  assert_eq wd("\r\n Zm9v=?x-unknown?q?_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n Zm9v=?x-unknown?q?_"), ("\r\n Zm9v=?x-unknown?q?_", "")
  assert_eq wd("=?utf-8?q?_Zm9va?="), (" Zm9va", "")
  assert_eq wdh("=?utf-8?q?_Zm9va?="), (" Zm9va", "")
  assert_eq wd("=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?"), ("=?", "")
  assert_eq wd("=?us-ascii?q??==?utf-8?b?=E9=3F?= x =?iso-8859-1?Q?=C3=A9=C3=A9w6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??==?utf-8?b?=E9=3F?= x =?iso-8859-1?Q?=C3=A9=C3=A9w6k=?= x "), ("=?utf-8?b?=E9=3F?= x =?iso-8859-1?Q?=C3=A9=C3=A9w6k=?= x ", "")
  assert_eq wd("a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a"), ("a", "")
  assert_eq wd("=?utf-8?q?Zm9v?==?UTF-8?B?QW5k=3F?= x =?utf-8?q?Zm9vw6k=?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zm9v?==?UTF-8?B?QW5k=3F?= x =?utf-8?q?Zm9vw6k=?= "), ("Zm9v=?UTF-8?B?QW5k=3F?= x =?utf-8?q?Zm9vw6k=?= ", "")
  assert_eq wd("=?=?us-ascii?q?Zgcw==\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?=?us-ascii?q?Zgcw==\n"), ("=?=?us-ascii?q?Zgcw==\n", "")
  assert_eq wd("=?utf-8?q?_?=\r\n\t=?UTF-8?B?=E9_=E9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?_?=\r\n\t=?UTF-8?B?=E9_=E9?=  "), (" \r\n\t=?UTF-8?B?=E9_=E9?=  ", "")
  assert_eq wd("=?UTF-8?B?=?utf-8?q?=?us-ascii?q? =C3=A9 "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=?utf-8?q?=?us-ascii?q? =C3=A9 "), ("=?UTF-8?B?=?utf-8?q?=?us-ascii?q? =C3=A9 ", "")
  assert_eq wd(hx("3d3f7574662d383f713f5f803f3d0d0a093d3f7574662d383f713f6177366b3d5f3f3d203d3f75732d61736369693f713f5157356b3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5f803f3d0d0a093d3f7574662d383f713f6177366b3d5f3f3d203d3f75732d61736369693f713f5157356b3f3d2020")), (hx("3d3f7574662d383f713f5f803f3d0d0a093d3f7574662d383f713f6177366b3d5f3f3d205157356b2020"), "")
  assert_eq wd("=4\r\n =C3=A9_=zz=?utf-8?q?=zzZm9v=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4\r\n =C3=A9_=zz=?utf-8?q?=zzZm9v=?us-ascii?q?"), ("=4\r\n =C3=A9_=zz=?utf-8?q?=zzZm9v=?us-ascii?q?", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f3d43333d41395a673d3d803f3d")), ("", "mime: invalid hex byte 0x3d")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f3d43333d41395a673d3d803f3d")), (hx("3d3f69736f2d383835392d313f513f3d43333d41395a673d3d803f3d"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f805f613f3d0d0a093d3f7574662d383f623f3f3d20203d3f75732d61736369693f713f615f3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f805f613f3d0d0a093d3f7574662d383f623f3f3d20203d3f75732d61736369693f713f615f3f3d0d0a09")), (hx("3d3f69736f2d383835392d313f513f805f613f3d0d0a0961200d0a09"), "")
  assert_eq wd("=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?"), ("=?iso-8859-1?Q?", "")
  assert_eq wd("=?utf-8?b??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("=4a=?x-unknown?q?=?Zm9v=?UTF-8?B?=4Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4a=?x-unknown?q?=?Zm9v=?UTF-8?B?=4Zm9v"), ("=4a=?x-unknown?q?=?Zm9v=?UTF-8?B?=4Zm9v", "")
  assert_eq wd("=?us-ascii?q?_=C3=A9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?_=C3=A9?=\r\n\t"), (" ��\r\n\t", "")
  assert_eq wd("=?UTF-8?B?=E9=?cw==QW5k?==zz=zz "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=E9=?cw==QW5k?==zz=zz "), ("=?UTF-8?B?=E9=?cw==QW5k?==zz=zz ", "")
  assert_eq wd("=?iso-8859-1?Q?cw==_?=  =?utf-8?q?a?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?cw==_?=  =?utf-8?q?a?=  "), ("=?iso-8859-1?Q?cw==_?=  a  ", "")
  assert_eq wd("\r\n Zm9v_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n Zm9v_"), ("\r\n Zm9v_", "")
  assert_eq wd("=?utf-8?b?=E9?=  =?iso-8859-1?Q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=E9?=  =?iso-8859-1?Q??=  "), ("=?utf-8?b?=E9?=    ", "")
  assert_eq wd("QW5kZgQW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5kZgQW5k"), ("QW5kZgQW5k", "")
  assert_eq wd("=?iso-8859-1?Q?cw===3F_?=\r\n\t=?iso-8859-1?Q??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?cw===3F_?=\r\n\t=?iso-8859-1?Q??= x "), ("=?iso-8859-1?Q?cw===3F_?=\r\n\t x ", "")
  assert_eq wd("=E9aa=====E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9aa=====E9"), ("=E9aa=====E9", "")
  assert_eq wd("=?iso-8859-1?Q?QW5k?= =?iso-8859-1?Q?=3FZm9vQW5k?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?QW5k?= =?iso-8859-1?Q?=3FZm9vQW5k?=\r\n\t"), ("QW5k?Zm9vQW5k\r\n\t", "")
  assert_eq wd("=?utf-8?q?=?utf-8?x?=?iso-8859-1?Q?_=?x-unknown?q?=?us-ascii?q?=?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=?utf-8?x?=?iso-8859-1?Q?_=?x-unknown?q?=?us-ascii?q?=?UTF-8?B?"), ("=?utf-8?q?=?utf-8?x?=?iso-8859-1?Q?_=?x-unknown?q?=?us-ascii?q?=?UTF-8?B?", "")
  assert_eq wd("=?utf-8?b??==?UTF-8?B??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??==?UTF-8?B??=  "), ("  ", "")
  assert_eq wd("=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?"), ("=?utf-8?x?", "")
  assert_eq wd("=?utf-8?q?=3Fcw==?==?utf-8?q??=  =?utf-8?q?_=E9QW5k?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3Fcw==?==?utf-8?q??=  =?utf-8?q?_=E9QW5k?= x "), (hx("3d3f7574662d383f713f3d334663773d3d3f3d20e95157356b207820"), "")
  assert_eq wd("w6k= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k= "), ("w6k= ", "")
  assert_eq wd("=?us-ascii?q??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= x "), (" x ", "")
  assert_eq wd(" =zz=?utf-8?x?=?utf-8?q?=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" =zz=?utf-8?x?=?utf-8?q?=?x-unknown?q?"), (" =zz=?utf-8?x?=?utf-8?q?=?x-unknown?q?", "")
}

test "vectors: word decoder 22" {
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f3f3d0d0a093d3f7574662d383f623f803d33463f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f3f3d0d0a093d3f7574662d383f623f803d33463f3d0d0a09")), (hx("0d0a093d3f7574662d383f623f803d33463f3d0d0a09"), "")
  assert_eq wd("\n=?x-unknown?q?é\nZm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n=?x-unknown?q?é\nZm9"), ("\n=?x-unknown?q?é\nZm9", "")
  assert_eq wd(hx("3d3f7574662d383f713f5a673d3d613d45393f3d2078203d3f7574662d383f623f3d45395a6d39765a6d39763f3d203d3f7574662d383f623f77366b3d805157356b3f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5a673d3d613d45393f3d2078203d3f7574662d383f623f3d45395a6d39765a6d39763f3d203d3f7574662d383f623f77366b3d805157356b3f3d20")), (hx("3d3f7574662d383f713f5a673d3d613d45393f3d2078203d3f7574662d383f623f3d45395a6d39765a6d39763f3d203d3f7574662d383f623f77366b3d805157356b3f3d20"), "")
  assert_eq wd("w6k==?_=E9=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k==?_=E9=?iso-8859-1?Q?"), ("w6k==?_=E9=?iso-8859-1?Q?", "")
  assert_eq wd(hx("3d3f5554462d383f423f805a673d3d3d45393f3d20203d3f75732d61736369693f713f3d33465a673d3d3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f805a673d3d3d45393f3d20203d3f75732d61736369693f713f3d33465a673d3d3f3d2020")), (hx("3d3f5554462d383f423f805a673d3d3d45393f3d20203d3f75732d61736369693f713f3d33465a673d3d3f3d2020"), "")
  assert_eq wd("\r\n =?utf-8?q?é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n =?utf-8?q?é"), ("\r\n =?utf-8?q?é", "")
  assert_eq wd("=?utf-8?b??=\r\n\t=?UTF-8?B?QW5kcw==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t=?UTF-8?B?QW5kcw==?=  "), ("Ands  ", "")
  assert_eq wd("é=?utf-8?q? \r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é=?utf-8?q? \r\n "), ("é=?utf-8?q? \r\n ", "")
  assert_eq wd("=?utf-8?b?_?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?_?=\r\n\t"), ("=?utf-8?b?_?=\r\n\t", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q?Zg==_=C3=A9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zg==_=C3=A9?=\r\n\t"), ("=?utf-8?q?Zg==_=C3=A9?=\r\n\t", "")
  assert_eq wd("=4=?utf-8?q?=?utf-8?x?=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4=?utf-8?q?=?utf-8?x?=?"), ("=4=?utf-8?q?=?utf-8?x?=?", "")
  assert_eq wd(hx("3d3f7574662d383f623f3f3d20203d3f5554462d383f423f3d453980803f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f3f3d20203d3f5554462d383f423f3d453980803f3d207820")), (hx("20203d3f5554462d383f423f3d453980803f3d207820"), "")
  assert_eq wd("=?utf-8?x?plain=?x-unknown?q?=C3=A9QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?plain=?x-unknown?q?=C3=A9QW5k"), ("=?utf-8?x?plain=?x-unknown?q?=C3=A9QW5k", "")
  assert_eq wd("=?iso-8859-1?Q??=  =?utf-8?b??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??=  =?utf-8?b??= x "), (" x ", "")
  assert_eq wd("====cw===?utf-8?q?w6k=é\r\n =?UTF-8?B?=zz=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("====cw===?utf-8?q?w6k=é\r\n =?UTF-8?B?=zz=?iso-8859-1?Q?"), ("====cw===?utf-8?q?w6k=é\r\n =?UTF-8?B?=zz=?iso-8859-1?Q?", "")
  assert_eq wd("=?iso-8859-1?Q?QW5ka?=\r\n\t=?utf-8?b?=3FQW5kZg==?= x =?UTF-8?B?=3Fw6k=?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?QW5ka?=\r\n\t=?utf-8?b?=3FQW5kZg==?= x =?UTF-8?B?=3Fw6k=?="), ("QW5ka\r\n\t=?utf-8?b?=3FQW5kZg==?= x =?UTF-8?B?=3Fw6k=?=", "")
  assert_eq wd("====é_Zg=C3=A9Zg"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("====é_Zg=C3=A9Zg"), ("====é_Zg=C3=A9Zg", "")
  assert_eq wd(hx("3d3f5554462d383f423f5f3f3d3d3f7574662d383f713f803f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f5f3f3d3d3f7574662d383f713f803f3d207820")), (hx("3d3f5554462d383f423f5f3f3d3d3f7574662d383f713f803f3d207820"), "")
  assert_eq wd("=?cw===C3=A9?=?utf-8?q? w6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?cw===C3=A9?=?utf-8?q? w6k="), ("=?cw===C3=A9?=?utf-8?q? w6k=", "")
  assert_eq wd("=?us-ascii?q?a=C3=A9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?a=C3=A9?= "), ("a�� ", "")
  assert_eq wd("aZm9v=4===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("aZm9v=4===="), ("aZm9v=4====", "")
  assert_eq wd("=?UTF-8?B?=3Fw6k=Zg==?= x =?utf-8?b?_=3F?= x =?utf-8?b?aaw6k=?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=3Fw6k=Zg==?= x =?utf-8?b?_=3F?= x =?utf-8?b?aaw6k=?="), ("=?UTF-8?B?=3Fw6k=Zg==?= x =?utf-8?b?_=3F?= x =?utf-8?b?aaw6k=?=", "")
  assert_eq wd("Zm9\r\n w6k==?UTF-8?B?\n=?utf-8?x?=C3=A9Zm9v?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9\r\n w6k==?UTF-8?B?\n=?utf-8?x?=C3=A9Zm9v?"), ("Zm9\r\n w6k==?UTF-8?B?\n=?utf-8?x?=C3=A9Zm9v?", "")
  assert_eq wd("=?us-ascii?q?=E9w6k==C3=A9?==?utf-8?b?cw==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=E9w6k==C3=A9?==?utf-8?b?cw==?=  "), ("=?us-ascii?q?=E9w6k==C3=A9?=s  ", "")
  assert_eq wd("=?x-unknown?q?=4=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?=4=C3=A9"), ("=?x-unknown?q?=4=C3=A9", "")
  assert_eq wd("=?us-ascii?q??= x =?UTF-8?B?cw===C3=A9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= x =?UTF-8?B?cw===C3=A9?=  "), (" x =?UTF-8?B?cw===C3=A9?=  ", "")
  assert_eq wd("?==?UTF-8?B?=?\r\n \na=E9Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==?UTF-8?B?=?\r\n \na=E9Zm9v"), ("?==?UTF-8?B?=?\r\n \na=E9Zm9v", "")
  assert_eq wd("=?UTF-8?B?w6k=a=C3=A9?="), ("", "illegal base64 data at input byte 4")
  assert_eq wdh("=?UTF-8?B?w6k=a=C3=A9?="), ("=?UTF-8?B?w6k=a=C3=A9?=", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q??==?utf-8?b?cw==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??==?utf-8?b?cw==?="), ("s", "")
  assert_eq wd("\n\n_=C3=A9=?=?x-unknown?q?=?utf-8?q?=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n\n_=C3=A9=?=?x-unknown?q?=?utf-8?q?=?utf-8?x?"), ("\n\n_=C3=A9=?=?x-unknown?q?=?utf-8?q?=?utf-8?x?", "")
  assert_eq wd("=?UTF-8?B??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("=?Zm9v=C3=A9?=QW5kw6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?Zm9v=C3=A9?=QW5kw6k="), ("=?Zm9v=C3=A9?=QW5kw6k=", "")
  assert_eq wd("=?iso-8859-1?Q?cw==QW5kcw==?==?UTF-8?B?Zg==cw==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?cw==QW5kcw==?==?UTF-8?B?Zg==cw==?=  "), ("=?iso-8859-1?Q?cw==QW5kcw==?==?UTF-8?B?Zg==cw==?=  ", "")
  assert_eq wd("=?iso-8859-1?Q?Zm9=========E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zm9=========E9"), ("=?iso-8859-1?Q?Zm9=========E9", "")
  assert_eq wd(hx("3d3f7574662d383f713f3d45393d45393d43333d41393f3d2078203d3f75732d61736369693f713f803d33463f3d2078203d3f7574662d383f713f3f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f3d45393d45393d43333d41393f3d2078203d3f75732d61736369693f713f803d33463f3d2078203d3f7574662d383f713f3f3d")), (hx("e9e9c3a92078203d3f75732d61736369693f713f803d33463f3d207820"), "")
  assert_eq wd("=4=====?iso-8859-1?Q?\r\n cw==?=w6k==?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4=====?iso-8859-1?Q?\r\n cw==?=w6k==?utf-8?x?"), ("=4=====?iso-8859-1?Q?\r\n cw==?=w6k==?utf-8?x?", "")
  assert_eq wd("=?utf-8?b?=3F?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3F?=  "), ("=?utf-8?b?=3F?=  ", "")
  assert_eq wd("\n=4cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n=4cw=="), ("\n=4cw==", "")
  assert_eq wd(hx("3d3f7574662d383f623f3f3d20203d3f7574662d383f623f63773d3d803f3d20203d3f7574662d383f713f3f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f3f3d20203d3f7574662d383f623f63773d3d803f3d20203d3f7574662d383f713f3f3d")), (hx("20203d3f7574662d383f623f63773d3d803f3d2020"), "")
  assert_eq wd("?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?="), ("?=", "")
  assert_eq wd("=?iso-8859-1?Q??=\r\n\t=?us-ascii?q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??=\r\n\t=?us-ascii?q??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a"), ("a", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f5a6d3976803f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f5a6d3976803f3d")), (hx("3d3f75732d61736369693f713f5a6d3976803f3d"), "")
  assert_eq wd("??=_=?us-ascii?q?cw===zz=?x-unknown?q?=?x-unknown?q?=4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("??=_=?us-ascii?q?cw===zz=?x-unknown?q?=?x-unknown?q?=4"), ("??=_=?us-ascii?q?cw===zz=?x-unknown?q?=?x-unknown?q?=4", "")
  assert_eq wd("=?us-ascii?q?w6k=?= =?UTF-8?B??=\r\n\t=?utf-8?q?QW5kZm9v?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?w6k=?= =?UTF-8?B??=\r\n\t=?utf-8?q?QW5kZm9v?= "), ("=?us-ascii?q?w6k=?= QW5kZm9v ", "")
  assert_eq wd("plainZg"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plainZg"), ("plainZg", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f5f3f3d203d3f7574662d383f623f5a6d3976803f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f5f3f3d203d3f7574662d383f623f5a6d3976803f3d")), (hx("20203d3f7574662d383f623f5a6d3976803f3d"), "")
  assert_eq wd("Zm9=E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9=E9"), ("Zm9=E9", "")
}

