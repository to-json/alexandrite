  assert_eq pmt("utf-8''*0*;%zztext"), "ERR mime: invalid media parameter|utf-8''*0*"
  assert_eq pmt("text/plain; filename= \"\\\\a;é\"; name=~~-a. ; name*0*= a!;"), "text/plain|filename=\\a;é|name="
  assert_eq pmt("a/b; x= ''a%c3%a4%c3%a4; Title= b"), "a/b|title=b|x=''a%c3%a4%c3%a4"
  assert_eq pmt("us-ascii'en'foo;*0*TEXT"), "ERR mime: invalid media parameter|us-ascii'en'foo"
