  assert_eq wdh("=?utf-8?b??==?iso-8859-1?Q??= =?utf-8?b?_?= x "), (" =?utf-8?b?_?= x ", "")
  assert_eq wd("_=?iso-8859-1?Q?=C3=A9Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_=?iso-8859-1?Q?=C3=A9Zm9v"), ("_=?iso-8859-1?Q?=C3=A9Zm9v", "")
  assert_eq wd("=?utf-8?q?=E9=E9=C3=A9?=  =?iso-8859-1?Q?a?=\r\n\t=?utf-8?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=E9=E9=C3=A9?=  =?iso-8859-1?Q?a?=\r\n\t=?utf-8?q??= "), (hx("e9e9c3a96120"), "")
