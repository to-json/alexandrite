  assert_eq wdh("=?iso-8859-1?Q?_=3Fw6k=?=  =?UTF-8?B?Zg==Zm9v?=\r\n\t=?us-ascii?q?_?="), ("=?iso-8859-1?Q?_=3Fw6k=?=  =?UTF-8?B?Zg==Zm9v?=\r\n\t ", "")
  assert_eq wd("=?iso-8859-1?Q?=?utf-8?x?=?utf-8?q?=?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=?utf-8?x?=?utf-8?q?=?UTF-8?B?"), ("=?iso-8859-1?Q?=?utf-8?x?=?utf-8?q?=?UTF-8?B?", "")
  assert_eq wd("=?utf-8?q?QW5ka_?=  =?UTF-8?B??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?QW5ka_?=  =?UTF-8?B??=  "), ("QW5ka   ", "")
  assert_eq wd("=?x-unknown?q?=?utf-8?x?=?iso-8859-1?Q?=?x-unknown?q?=?utf-8?q?\nécw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?=?utf-8?x?=?iso-8859-1?Q?=?x-unknown?q?=?utf-8?q?\nécw=="), ("=?x-unknown?q?=?utf-8?x?=?iso-8859-1?Q?=?x-unknown?q?=?utf-8?q?\nécw==", "")
  assert_eq wd(hx("3d3f7574662d383f623f5a673d3d61803f3d0d0a093d3f69736f2d383835392d313f513f3f3d20203d3f7574662d383f713f3f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f5a673d3d61803f3d0d0a093d3f69736f2d383835392d313f513f3f3d20203d3f7574662d383f713f3f3d207820")), (hx("3d3f7574662d383f623f5a673d3d61803f3d0d0a09207820"), "")
  assert_eq wd("Zm9=4\r\n ?é "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9=4\r\n ?é "), ("Zm9=4\r\n ?é ", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f805a6d3976803f3d203d3f7574662d383f623f5157356b3d3346613f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f805a6d3976803f3d203d3f7574662d383f623f5157356b3d3346613f3d2020")), (hx("3d3f69736f2d383835392d313f513f805a6d3976803f3d203d3f7574662d383f623f5157356b3d3346613f3d2020"), "")
  assert_eq wd("?=plain=E9=?Zg=zz =?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=plain=E9=?Zg=zz =?utf-8?x?"), ("?=plain=E9=?Zg=zz =?utf-8?x?", "")
}

test "vectors: b words" {
  assert_eq wd("=?utf-8?b?=Zm9vQw=+/?="), ("", "illegal base64 data at input byte 0")
  assert_eq wd("=?utf-8?b?Zm9vYQQ\n\rAw+?="), ("", "illegal base64 data at input byte 10")
  assert_eq wd("=?utf-8?b?=\nwYQ//?="), ("", "illegal base64 data at input byte 0")
  assert_eq wd("=?utf-8?b?YQ\n?="), ("", "illegal base64 data at input byte 1")
  assert_eq wd("=?utf-8?b?+\n\r?="), ("", "illegal base64 data at input byte 2")
  assert_eq wd("=?utf-8?b?QYQYWI?="), ("", "illegal base64 data at input byte 4")
  assert_eq wd("=?utf-8?b??="), ("", "")
  assert_eq wd("=?utf-8?b?Zm9v*w?="), ("", "illegal base64 data at input byte 4")
  assert_eq wd("=?utf-8?b?+YWI+YWIAQwYWI?="), ("", "illegal base64 data at input byte 12")
  assert_eq wd("=?utf-8?b?*?="), ("", "illegal base64 data at input byte 0")
