  assert_eq pmt("attachment;Title= 1--!"), "attachment|title=1--!"
  assert_eq pmt("x; html%zz*1utf-8''=utf-8\"a b\"\\\"name/"), "ERR mime: invalid media parameter|x"
  assert_eq pmt("attachment; Title= utf-8''%41%;charset*1=_b1 ; x* =-b_~"), "attachment|title=utf-8''%41%"
  assert_eq pmt("Multipart/Mixed ; boundary =1a!!b; boundary*1* =\"\" ; name= ."), "multipart/mixed|boundary=1a!!b|name=."
  assert_eq pmt("Plain"), "plain"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("a/b ; filename= !;x*=_a!-_; boundary*1*= ''%c3%a4%4%"), "a/b|filename=!"
  assert_eq pmt("\"a b\"'\\foo=@"), "ERR mime: no media type"
  assert_eq pmt("attachment; name=\"x\""), "attachment|name=x"
  assert_eq pmt("attachment"), "attachment"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("a/b;filename =\"\"; Title=11~a.b"), "a/b|filename=|title=11~a.b"
  assert_eq pmt("x*1*0* \r\n\tPlain%2"), "ERR mime: expected slash after first token"
  assert_eq pmt("attachment ; filename*1*=\"é\\\\x;é\""), "attachment"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("TEXT\\\"TEXT\tname=%41{}utf-8''"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data ; name =utf-8'%"), "form-data|name=utf-8'%"
  assert_eq pmt("Multipart/Mixed;filename*2= !a"), "multipart/mixed"
  assert_eq pmt("\t*0*é"), "ERR mime: expected slash after first token"
  assert_eq pmt("attachment; charset= \"x\"; Title*0= 1!.aa;filename*= 1_b~"), "attachment|charset=x|title=1!.aa"
  assert_eq pmt("text/plain; boundary=~b~b; filename*1=ba!a!"), "text/plain|boundary=~b~b"
  assert_eq pmt(";TEXT\"a b\"\tus-ascii'en'"), "ERR mime: no media type"
  assert_eq pmt("form-data ; Title*=\";\\\\ ;\";Title=\"\\\\\\\\éé\""), "form-data|title=\\\\éé"
  assert_eq pmt("text/plain ; charset= !1-a!~"), "text/plain|charset=!1-a!~"
  assert_eq pmt("utf-8''%2%41;\ttextcharset;,Plainfoo%41"), "ERR mime: invalid media parameter|utf-8''%2%41"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("form-data"), "form-data"
  assert_eq pmt("\\; {}*0\\*utf-8''foo/"), "ERR mime: no media type"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("application/x-stuff ; boundary= \"a%41%41\" ; charset= ."), "application/x-stuff|boundary=a%41%41|charset=."
  assert_eq pmt("charset*0*%41\tus-ascii'en'{}\"a b\"textTEXT%zzhtml"), "ERR mime: expected slash after first token"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("attachment ; name*0* =_."), "attachment|name="
  assert_eq pmt("'%2/'us-ascii'en'Plainhtmlx"), "'%2/'us-ascii'en'plainhtmlx"
  assert_eq pmt("a/b ; filename=a;Title= a~1"), "a/b|filename=a|title=a~1"
  assert_eq pmt("attachment; charset=b-ba!~;boundary*0= _!.1"), "attachment|boundary=_!.1|charset=b-ba!~"
  assert_eq pmt("\"a b\"utf-8''= "), "ERR mime: no media type"
