  assert_eq pmt("text/plain;name=._.__1"), "text/plain|name=._.__1"
  assert_eq pmt("a/b;Title =US-ASCII'en'%4%;boundary=~1; boundary*2 =utf-8'"), "a/b|boundary=~1|title=US-ASCII'en'%4%"
  assert_eq pmt(";*1\"*0*TEXT\r\n\\@ text*utf-8''"), "ERR mime: no media type"
