  assert_eq pmt("attachment;charset= a~-_!-"), "attachment|charset=a~-_!-"
  assert_eq pmt("TEXTPlainus-ascii'en'utf-8; %zz/ "), "ERR mime: invalid media parameter|textplainus-ascii'en'utf-8"
  assert_eq pmt("application/x-stuff;charset =\"\";charset*2=\"\\\"a\\\\\\\\\""), "application/x-stuff|charset="
