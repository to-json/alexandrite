  assert_eq wd(hx("3d3f7574662d383f623f5157356b3f3d203d3f7574662d383f713f5157356b803f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f5157356b3f3d203d3f7574662d383f713f5157356b803f3d0d0a09")), (hx("416e64203d3f7574662d383f713f5157356b803f3d0d0a09"), "")
  assert_eq wd("cw===E9=?us-ascii?q?=?us-ascii?q?Zg=?iso-8859-1?Q?=?us-ascii?q?=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw===E9=?us-ascii?q?=?us-ascii?q?Zg=?iso-8859-1?Q?=?us-ascii?q?=?utf-8?x?"), ("cw===E9=?us-ascii?q?=?us-ascii?q?Zg=?iso-8859-1?Q?=?us-ascii?q?=?utf-8?x?", "")
  assert_eq wd(hx("3d3f7574662d383f713f5f803f3d20203d3f75732d61736369693f713f3d33463f3d0d0a093d3f5554462d383f423f5f5157356b5a6d39763f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5f803f3d20203d3f75732d61736369693f713f3d33463f3d0d0a093d3f5554462d383f423f5f5157356b5a6d39763f3d")), (hx("3d3f7574662d383f713f5f803f3d20203f0d0a093d3f5554462d383f423f5f5157356b5a6d39763f3d"), "")
  assert_eq wd(" =E9=?utf-8?q?Zm9=?utf-8?q?=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" =E9=?utf-8?q?Zm9=?utf-8?q?=?utf-8?x?"), (" =E9=?utf-8?q?Zm9=?utf-8?q?=?utf-8?x?", "")
  assert_eq wd(hx("3d3f7574662d383f623f80613d43333d41393f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f80613d43333d41393f3d20")), (hx("3d3f7574662d383f623f80613d43333d41393f3d20"), "")
  assert_eq wd("plaina=4=?UTF-8?B? =zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plaina=4=?UTF-8?B? =zz"), ("plaina=4=?UTF-8?B? =zz", "")
  assert_eq wd(hx("3d3f7574662d383f623f805157356b613f3d203d3f5554462d383f423f3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f805157356b613f3d203d3f5554462d383f423f3f3d0d0a09")), (hx("3d3f7574662d383f623f805157356b613f3d200d0a09"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
}

test "vectors: word decoder 15" {
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f805157356b3f3d0d0a093d3f7574662d383f623f803f3d203d3f7574662d383f623f3d33463f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f805157356b3f3d0d0a093d3f7574662d383f623f803f3d203d3f7574662d383f623f3d33463f3d")), (hx("3d3f69736f2d383835392d313f513f805157356b3f3d0d0a093d3f7574662d383f623f803f3d203d3f7574662d383f623f3d33463f3d"), "")
  assert_eq wd("?=\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=\n"), ("?=\n", "")
  assert_eq wd("=?iso-8859-1?Q?w6k=aa?=\r\n\t=?iso-8859-1?Q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?w6k=aa?=\r\n\t=?iso-8859-1?Q??="), ("w6kª", "")
  assert_eq wd("=?utf-8?q?=C3=A9Zm9v=4\nZm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9Zm9v=4\nZm9"), ("=?utf-8?q?=C3=A9Zm9v=4\nZm9", "")
  assert_eq wd("=?iso-8859-1?Q?cw===3F?==?UTF-8?B?=C3=A9a=3F?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?cw===3F?==?UTF-8?B?=C3=A9a=3F?= x "), ("=?iso-8859-1?Q?cw===3F?==?UTF-8?B?=C3=A9a=3F?= x ", "")
  assert_eq wd("?=\nZm9 =E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=\nZm9 =E9"), ("?=\nZm9 =E9", "")
  assert_eq wd(hx("3d3f7574662d383f713f5f3f3d203d3f7574662d383f623f77366b3d803f3d2078203d3f7574662d383f623f5f3f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5f3f3d203d3f7574662d383f623f77366b3d803f3d2078203d3f7574662d383f623f5f3f3d207820")), (hx("20203d3f7574662d383f623f77366b3d803f3d2078203d3f7574662d383f623f5f3f3d207820"), "")
  assert_eq wd("=?UTF-8?B?QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?QW5k"), ("=?UTF-8?B?QW5k", "")
  assert_eq wd("=?us-ascii?q?QW5kQW5ka?==?us-ascii?q?=E9Zm9v_?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?QW5kQW5ka?==?us-ascii?q?=E9Zm9v_?= x "), ("QW5kQW5ka�Zm9v  x ", "")
  assert_eq wd("=?utf-8?x?Zm9=zzcw==Zm9=E9Zm9=?utf-8?x?=4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?Zm9=zzcw==Zm9=E9Zm9=?utf-8?x?=4"), ("=?utf-8?x?Zm9=zzcw==Zm9=E9Zm9=?utf-8?x?=4", "")
  assert_eq wd("=?utf-8?b?=3Fa=3F?= x =?iso-8859-1?Q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3Fa=3F?= x =?iso-8859-1?Q??= "), ("=?utf-8?b?=3Fa=3F?= x  ", "")
  assert_eq wd("=E9=C3=A9=?utf-8?q?\nQW5k========Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9=C3=A9=?utf-8?q?\nQW5k========Zm9v"), ("=E9=C3=A9=?utf-8?q?\nQW5k========Zm9v", "")
  assert_eq wd("=?utf-8?b?w6k=?=\r\n\t=?utf-8?q?Zm9vQW5kZg==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?w6k=?=\r\n\t=?utf-8?q?Zm9vQW5kZg==?=\r\n\t"), ("é\r\n\t=?utf-8?q?Zm9vQW5kZg==?=\r\n\t", "")
  assert_eq wd("?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?"), ("?", "")
  assert_eq wd("=?us-ascii?q?QW5k?=  =?utf-8?b??=\r\n\t=?iso-8859-1?Q?a?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?QW5k?=  =?utf-8?b??=\r\n\t=?iso-8859-1?Q?a?=  "), ("QW5ka  ", "")
  assert_eq wd("_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_"), ("_", "")
  assert_eq wd("=?utf-8?q?=E9a=3F?=  =?iso-8859-1?Q?Zm9va=3F?= x =?utf-8?b?=C3=A9Zg===3F?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=E9a=3F?=  =?iso-8859-1?Q?Zm9va=3F?= x =?utf-8?b?=C3=A9Zg===3F?= x "), (hx("e9613f5a6d3976613f2078203d3f7574662d383f623f3d43333d41395a673d3d3d33463f3d207820"), "")
  assert_eq wd("=?utf-8?q?=?=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=?=?iso-8859-1?Q?"), ("=?utf-8?q?=?=?iso-8859-1?Q?", "")
  assert_eq wd("=?utf-8?b?=3FZm9v=C3=A9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3FZm9v=C3=A9?=\r\n\t"), ("=?utf-8?b?=3FZm9v=C3=A9?=\r\n\t", "")
  assert_eq wd("cw==?=Zm9=?utf-8?x?Zm9?=plain?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw==?=Zm9=?utf-8?x?Zm9?=plain?"), ("cw==?=Zm9=?utf-8?x?Zm9?=plain?", "")
  assert_eq wd("=?us-ascii?q??=  =?us-ascii?q?QW5ka?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=  =?us-ascii?q?QW5ka?=  "), ("QW5ka  ", "")
  assert_eq wd("=?x-unknown?q?=?x-unknown?q?=?iso-8859-1?Q?QW5k=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?=?x-unknown?q?=?iso-8859-1?Q?QW5k=?us-ascii?q?"), ("=?x-unknown?q?=?x-unknown?q?=?iso-8859-1?Q?QW5k=?us-ascii?q?", "")
  assert_eq wd("=?iso-8859-1?Q??= =?iso-8859-1?Q?aw6k=Zm9v?= x =?iso-8859-1?Q?=C3=A9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??= =?iso-8859-1?Q?aw6k=Zm9v?= x =?iso-8859-1?Q?=C3=A9?=  "), (" =?iso-8859-1?Q?aw6k=Zm9v?= x Ã©  ", "")
  assert_eq wd("Zm9vQW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9vQW5k"), ("Zm9vQW5k", "")
  assert_eq wd("=?iso-8859-1?Q?aaZm9v?=  =?utf-8?b?=E9cw==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?aaZm9v?=  =?utf-8?b?=E9cw==?= x "), ("aaZm9v  =?utf-8?b?=E9cw==?= x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?iso-8859-1?Q??= =?utf-8?q?Zm9va?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??= =?utf-8?q?Zm9va?= "), ("Zm9va ", "")
  assert_eq wd("éa?=C3=A9\n====_=C3=A9cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("éa?=C3=A9\n====_=C3=A9cw=="), ("éa?=C3=A9\n====_=C3=A9cw==", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f3d45393f3d2078203d3f7574662d383f713f3f3d0d0a093d3f5554462d383f423f5a6d3976803f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f3d45393f3d2078203d3f7574662d383f713f3f3d0d0a093d3f5554462d383f423f5a6d3976803f3d")), (hx("c3a92078200d0a093d3f5554462d383f423f5a6d3976803f3d"), "")
  assert_eq wd("\n =4=?x-unknown?q?=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n =4=?x-unknown?q?=?us-ascii?q?"), ("\n =4=?x-unknown?q?=?us-ascii?q?", "")
  assert_eq wd("=?iso-8859-1?Q?w6k==C3=A9?=\r\n\t=?utf-8?b?_cw==cw==?==?utf-8?b?Zm9vQW5kZm9v?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?w6k==C3=A9?=\r\n\t=?utf-8?b?_cw==cw==?==?utf-8?b?Zm9vQW5kZm9v?="), ("=?iso-8859-1?Q?w6k==C3=A9?=\r\n\t=?utf-8?b?_cw==cw==?=fooAndfoo", "")
  assert_eq wd("?==E9=?w6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==E9=?w6k="), ("?==E9=?w6k=", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f3d45395157356b3f3d20203d3f7574662d383f713f3d3346803f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f3d45395157356b3f3d20203d3f7574662d383f713f3d3346803f3d207820")), (hx("efbfbd5157356b20203d3f7574662d383f713f3d3346803f3d207820"), "")
  assert_eq wd("=?iso-8859-1?Q?=?us-ascii?q?w6k=Zm9=?=?utf-8?q?=?UTF-8?B?=?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=?us-ascii?q?w6k=Zm9=?=?utf-8?q?=?UTF-8?B?=?UTF-8?B?"), ("=?iso-8859-1?Q?=?us-ascii?q?w6k=Zm9=?=?utf-8?q?=?UTF-8?B?=?UTF-8?B?", "")
  assert_eq wd(hx("3d3f7574662d383f623f3d43333d41393f3d20203d3f69736f2d383835392d313f513f803d33463f3d3d3f75732d61736369693f713f613d33463f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f3d43333d41393f3d20203d3f69736f2d383835392d313f513f803d33463f3d3d3f75732d61736369693f713f613d33463f3d")), (hx("3d3f7574662d383f623f3d43333d41393f3d20203d3f69736f2d383835392d313f513f803d33463f3d613f"), "")
  assert_eq wd("=zz=?iso-8859-1?Q?=?utf-8?x?=E9w6k==?utf-8?x?Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz=?iso-8859-1?Q?=?utf-8?x?=E9w6k==?utf-8?x?Zm9"), ("=zz=?iso-8859-1?Q?=?utf-8?x?=E9w6k==?utf-8?x?Zm9", "")
  assert_eq wd("=?us-ascii?q??= =?utf-8?q??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= =?utf-8?q??= x "), (" x ", "")
  assert_eq wd("w6k=cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k=cw=="), ("w6k=cw==", "")
  assert_eq wd("=?iso-8859-1?Q?=3F_=C3=A9?= =?utf-8?q?a_QW5k?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=3F_=C3=A9?= =?utf-8?q?a_QW5k?=\r\n\t"), ("? Ã©a QW5k\r\n\t", "")
  assert_eq wd("=?utf-8?x?=4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=4"), ("=?utf-8?x?=4", "")
  assert_eq wd("=?utf-8?q?cw==?= x =?utf-8?q?w6k==C3=A9Zm9v?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?cw==?= x =?utf-8?q?w6k==C3=A9Zm9v?="), ("=?utf-8?q?cw==?= x =?utf-8?q?w6k==C3=A9Zm9v?=", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?iso-8859-1?Q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??=  "), ("  ", "")
  assert_eq wd("w6k= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k= "), ("w6k= ", "")
  assert_eq wd("=?utf-8?b?=C3=A9_?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=C3=A9_?=  "), ("=?utf-8?b?=C3=A9_?=  ", "")
  assert_eq wd("plainZm9v=4Zgplain=?utf-8?q?a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plainZm9v=4Zgplain=?utf-8?q?a"), ("plainZm9v=4Zgplain=?utf-8?q?a", "")
  assert_eq wd("=?utf-8?q?Zg==?=  =?iso-8859-1?Q?w6k=cw==QW5k?= =?iso-8859-1?Q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zg==?=  =?iso-8859-1?Q?w6k=cw==QW5k?= =?iso-8859-1?Q??="), ("=?utf-8?q?Zg==?=  =?iso-8859-1?Q?w6k=cw==QW5k?= ", "")
  assert_eq wd("=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?"), ("=?us-ascii?q?", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f3f3d0d0a093d3f75732d61736369693f713f3d3346805157356b3f3d2078203d3f7574662d383f623f3f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f3f3d0d0a093d3f75732d61736369693f713f3d3346805157356b3f3d2078203d3f7574662d383f623f3f3d207820")), (hx("0d0a093d3f75732d61736369693f713f3d3346805157356b3f3d207820207820"), "")
  assert_eq wd("=?utf-8?q?=4========QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=4========QW5k"), ("=?utf-8?q?=4========QW5k", "")
}

test "vectors: word decoder 16" {
  assert_eq wd("=?iso-8859-1?Q?_cw==w6k=?==?utf-8?q?QW5k=E9?=  =?us-ascii?q?Zm9v=E9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?_cw==w6k=?==?utf-8?q?QW5k=E9?=  =?us-ascii?q?Zm9v=E9?=\r\n\t"), (hx("3d3f69736f2d383835392d313f513f5f63773d3d77366b3d3f3d5157356be95a6d3976efbfbd0d0a09"), "")
  assert_eq wd("=zz=?us-ascii?q?a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz=?us-ascii?q?a"), ("=zz=?us-ascii?q?a", "")
  assert_eq wd("=?UTF-8?B?QW5k=3F?="), ("", "illegal base64 data at input byte 4")
  assert_eq wdh("=?UTF-8?B?QW5k=3F?="), ("=?UTF-8?B?QW5k=3F?=", "")
  assert_eq wd("=?utf-8?x?=zzZm9_=?utf-8?q?w6k=Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=zzZm9_=?utf-8?q?w6k=Zm9"), ("=?utf-8?x?=zzZm9_=?utf-8?q?w6k=Zm9", "")
  assert_eq wd("=?utf-8?q??=  =?us-ascii?q?cw==?= =?utf-8?q?w6k=?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??=  =?us-ascii?q?cw==?= =?utf-8?q?w6k=?=  "), ("  =?us-ascii?q?cw==?= =?utf-8?q?w6k=?=  ", "")
  assert_eq wd("=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?"), ("=?utf-8?x?", "")
  assert_eq wd("=?utf-8?q??= x =?UTF-8?B??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= x =?UTF-8?B??=\r\n\t"), (" x \r\n\t", "")
  assert_eq wd("cw==w6k=\r\n =?UTF-8?B??plain=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw==w6k=\r\n =?UTF-8?B??plain=?"), ("cw==w6k=\r\n =?UTF-8?B??plain=?", "")
  assert_eq wd("=?utf-8?b?Zg==?=  =?utf-8?q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zg==?=  =?utf-8?q??="), ("f", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?b?Zm9v=E9cw==?=  =?utf-8?b?=E9Zm9v?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zm9v=E9cw==?=  =?utf-8?b?=E9Zm9v?=  "), ("=?utf-8?b?Zm9v=E9cw==?=  =?utf-8?b?=E9Zm9v?=  ", "")
  assert_eq wd("?==?utf-8?x?=?utf-8?x??a=?us-ascii?q?=?iso-8859-1?Q?Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==?utf-8?x?=?utf-8?x??a=?us-ascii?q?=?iso-8859-1?Q?Zm9"), ("?==?utf-8?x?=?utf-8?x??a=?us-ascii?q?=?iso-8859-1?Q?Zm9", "")
  assert_eq wd("=?utf-8?q??= x =?UTF-8?B?Zg==?=  =?iso-8859-1?Q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= x =?UTF-8?B?Zg==?=  =?iso-8859-1?Q??="), (" x f", "")
  assert_eq wd("=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?"), ("=?utf-8?x?", "")
  assert_eq wd("=?utf-8?q?Zg==?=\r\n\t=?utf-8?b?Zm9vZm9v?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zg==?=\r\n\t=?utf-8?b?Zm9vZm9v?=\r\n\t"), ("=?utf-8?q?Zg==?=\r\n\tfoofoo\r\n\t", "")
  assert_eq wd("aZm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("aZm9"), ("aZm9", "")
  assert_eq wd("=?utf-8?b??==?us-ascii?q?=3F?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??==?us-ascii?q?=3F?= "), ("? ", "")
  assert_eq wd("\r\n ?\r\n Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n ?\r\n Zm9v"), ("\r\n ?\r\n Zm9v", "")
  assert_eq wd("=?utf-8?q?_?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?_?=  "), ("   ", "")
  assert_eq wd("=?UTF-8?B?Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zm9"), ("=?UTF-8?B?Zm9", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f803f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f803f3d2020")), (hx("3d3f75732d61736369693f713f803f3d2020"), "")
  assert_eq wd("=?=C3=A9=?x-unknown?q?_?===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?=C3=A9=?x-unknown?q?_?===="), ("=?=C3=A9=?x-unknown?q?_?====", "")
  assert_eq wd("=?us-ascii?q?__?= =?us-ascii?q?cw==QW5k?= =?utf-8?q?QW5k?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?__?= =?us-ascii?q?cw==QW5k?= =?utf-8?q?QW5k?= x "), ("   =?us-ascii?q?cw==QW5k?= QW5k x ", "")
  assert_eq wd("=?us-ascii?q?=?x-unknown?q?=zz?plain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=?x-unknown?q?=zz?plain"), ("=?us-ascii?q?=?x-unknown?q?=zz?plain", "")
  assert_eq wd("=?UTF-8?B??=  =?us-ascii?q?Zm9v?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??=  =?us-ascii?q?Zm9v?="), ("Zm9v", "")
  assert_eq wd("\n=?us-ascii?q?=zza=C3=A9Zm9vé=C3=A9=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n=?us-ascii?q?=zza=C3=A9Zm9vé=C3=A9=?utf-8?x?"), ("\n=?us-ascii?q?=zza=C3=A9Zm9vé=C3=A9=?utf-8?x?", "")
  assert_eq wd("=?us-ascii?q??=\r\n\t=?iso-8859-1?Q?Zm9v?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=\r\n\t=?iso-8859-1?Q?Zm9v?= x "), ("Zm9v x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??= "), (" ", "")
  assert_eq wd("aQW5k Zm9é=zz=4=?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("aQW5k Zm9é=zz=4=?UTF-8?B?"), ("aQW5k Zm9é=zz=4=?UTF-8?B?", "")
  assert_eq wd("=?utf-8?q?w6k=?=  =?us-ascii?q?acw==cw==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?w6k=?=  =?us-ascii?q?acw==cw==?= x "), ("=?utf-8?q?w6k=?=  =?us-ascii?q?acw==cw==?= x ", "")
  assert_eq wd("?=Zm9v=?x-unknown?q?QW5kw6k==?utf-8?x?=4=?us-ascii?q?=4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=Zm9v=?x-unknown?q?QW5kw6k==?utf-8?x?=4=?us-ascii?q?=4"), ("?=Zm9v=?x-unknown?q?QW5kw6k==?utf-8?x?=4=?us-ascii?q?=4", "")
  assert_eq wd("=?iso-8859-1?Q?QW5k?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?QW5k?=  "), ("QW5k  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q??= x =?utf-8?b?_aQW5k?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= x =?utf-8?b?_aQW5k?= "), (" x =?utf-8?b?_aQW5k?= ", "")
  assert_eq wd("=?utf-8?x?=?UTF-8?B? "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=?UTF-8?B? "), ("=?utf-8?x?=?UTF-8?B? ", "")
  assert_eq wd("=?iso-8859-1?Q?Zg==a=3F?==?utf-8?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zg==a=3F?==?utf-8?q??= "), ("=?iso-8859-1?Q?Zg==a=3F?= ", "")
  assert_eq wd("=zz=?utf-8?q?=?utf-8?x?=C3=A9cw===?x-unknown?q?=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz=?utf-8?q?=?utf-8?x?=C3=A9cw===?x-unknown?q?=?utf-8?q?"), ("=zz=?utf-8?q?=?utf-8?x?=C3=A9cw===?x-unknown?q?=?utf-8?q?", "")
  assert_eq wd("=?iso-8859-1?Q?Zg==cw==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zg==cw==?=  "), ("=?iso-8859-1?Q?Zg==cw==?=  ", "")
  assert_eq wd("QW5ké\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5ké\n"), ("QW5ké\n", "")
  assert_eq wd("=?iso-8859-1?Q?Zm9v?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zm9v?= x "), ("Zm9v x ", "")
  assert_eq wd("=E9=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9=?us-ascii?q?"), ("=E9=?us-ascii?q?", "")
  assert_eq wd("=?utf-8?b?cw==Zm9v?= =?utf-8?b?Zm9vw6k=?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?cw==Zm9v?= =?utf-8?b?Zm9vw6k=?= "), ("=?utf-8?b?cw==Zm9v?= fooé ", "")
  assert_eq wd("?=\n\n=?UTF-8?B?=4=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=\n\n=?UTF-8?B?=4=C3=A9"), ("?=\n\n=?UTF-8?B?=4=C3=A9", "")
  assert_eq wd("=?UTF-8?B?=3Faw6k=?==?us-ascii?q?Zg===C3=A9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=3Faw6k=?==?us-ascii?q?Zg===C3=A9?= "), ("=?UTF-8?B?=3Faw6k=?==?us-ascii?q?Zg===C3=A9?= ", "")
  assert_eq wd("=?UTF-8?B??"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??"), ("=?UTF-8?B??", "")
  assert_eq wd("=?iso-8859-1?Q?=3F?==?utf-8?b?w6k=QW5k?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=3F?==?utf-8?b?w6k=QW5k?= x "), ("?=?utf-8?b?w6k=QW5k?= x ", "")
  assert_eq wd("=E9éZm9v?==E9=4=C3=A9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9éZm9v?==E9=4=C3=A9?="), ("=E9éZm9v?==E9=4=C3=A9?=", "")
  assert_eq wd(hx("3d3f5554462d383f423f8077366b3d3f3d20203d3f5554462d383f423f3f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f8077366b3d3f3d20203d3f5554462d383f423f3f3d20")), (hx("3d3f5554462d383f423f8077366b3d3f3d202020"), "")
  assert_eq wd("Zg"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zg"), ("Zg", "")
}

test "vectors: word decoder 17" {
  assert_eq wd("=?UTF-8?B?Zg===3F_?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zg===3F_?= x "), ("=?UTF-8?B?Zg===3F_?= x ", "")
  assert_eq wd("é =E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é =E9"), ("é =E9", "")
  assert_eq wd("=?iso-8859-1?Q?aZm9v=3F?=  =?us-ascii?q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?aZm9v=3F?=  =?us-ascii?q??=  "), ("aZm9v?  ", "")
  assert_eq wd("\nw6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\nw6k="), ("\nw6k=", "")
  assert_eq wd("=?utf-8?b?=E9?= x =?iso-8859-1?Q?a?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=E9?= x =?iso-8859-1?Q?a?="), ("=?utf-8?b?=E9?= x a", "")
  assert_eq wd("=?utf-8?x?Zm9QW5k=?UTF-8?B?=?x-unknown?q? ===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?Zm9QW5k=?UTF-8?B?=?x-unknown?q? ===="), ("=?utf-8?x?Zm9QW5k=?UTF-8?B?=?x-unknown?q? ====", "")
  assert_eq wd("=?utf-8?b?w6k=?=\r\n\t=?UTF-8?B?a_?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?w6k=?=\r\n\t=?UTF-8?B?a_?="), ("é\r\n\t=?UTF-8?B?a_?=", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q?=3F=3F?==?UTF-8?B??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3F=3F?==?UTF-8?B??= "), ("?? ", "")
  assert_eq wd("QW5k=E9?==?us-ascii?q?QW5k=?UTF-8?B?=?utf-8?q?é?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k=E9?==?us-ascii?q?QW5k=?UTF-8?B?=?utf-8?q?é?"), ("QW5k=E9?==?us-ascii?q?QW5k=?UTF-8?B?=?utf-8?q?é?", "")
  assert_eq wd(hx("3d3f7574662d383f713f803f3d0d0a093d3f7574662d383f623f61805157356b3f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f803f3d0d0a093d3f7574662d383f623f61805157356b3f3d")), (hx("3d3f7574662d383f713f803f3d0d0a093d3f7574662d383f623f61805157356b3f3d"), "")
  assert_eq wd("QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k"), ("QW5k", "")
  assert_eq wd(hx("3d3f5554462d383f423f3f3d0d0a093d3f69736f2d383835392d313f513f803f3d3d3f7574662d383f623f5a673d3d3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f3f3d0d0a093d3f69736f2d383835392d313f513f803f3d3d3f7574662d383f623f5a673d3d3f3d2020")), (hx("0d0a093d3f69736f2d383835392d313f513f803f3d662020"), "")
  assert_eq wd("Zm9=?\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9=?\n"), ("Zm9=?\n", "")
  assert_eq wd(hx("3d3f5554462d383f423f80613f3d203d3f69736f2d383835392d313f513f3f3d20203d3f75732d61736369693f713f3d33463f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f80613f3d203d3f69736f2d383835392d313f513f3f3d20203d3f75732d61736369693f713f3d33463f3d2020")), (hx("3d3f5554462d383f423f80613f3d203f2020"), "")
  assert_eq wd("=E9cw==é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9cw==é"), ("=E9cw==é", "")
  assert_eq wd("=?utf-8?q?=C3=A9?=  =?iso-8859-1?Q?cw==Zg==a?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9?=  =?iso-8859-1?Q?cw==Zg==a?= "), ("é  =?iso-8859-1?Q?cw==Zg==a?= ", "")
  assert_eq wd("=C3=A9=?x-unknown?q?=?utf-8?q?=4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9=?x-unknown?q?=?utf-8?q?=4"), ("=C3=A9=?x-unknown?q?=?utf-8?q?=4", "")
  assert_eq wd("=?us-ascii?q?=E9QW5k?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=E9QW5k?=  "), ("�QW5k  ", "")
  assert_eq wd("?==?us-ascii?q? ?=Zm9vZm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==?us-ascii?q? ?=Zm9vZm9v"), ("?= Zm9vZm9v", "")
  assert_eq wd("=?utf-8?q?=C3=A9?=  =?us-ascii?q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9?=  =?us-ascii?q??="), ("é", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q?=3FZm9v?=\r\n\t=?UTF-8?B?=C3=A9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3FZm9v?=\r\n\t=?UTF-8?B?=C3=A9?="), ("?Zm9v\r\n\t=?UTF-8?B?=C3=A9?=", "")
  assert_eq wd("=4=4=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4=4=C3=A9"), ("=4=4=C3=A9", "")
  assert_eq wd("=?utf-8?b?a?=  =?utf-8?q?w6k=?= x =?us-ascii?q?Zm9v?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?a?=  =?utf-8?q?w6k=?= x =?us-ascii?q?Zm9v?= x "), ("=?utf-8?b?a?=  =?utf-8?q?w6k=?= x Zm9v x ", "")
  assert_eq wd("Zm9=?UTF-8?B?=?UTF-8?B?QW5k\na?=zzZm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9=?UTF-8?B?=?UTF-8?B?QW5k\na?=zzZm9"), ("Zm9=?UTF-8?B?=?UTF-8?B?QW5k\na?=zzZm9", "")
  assert_eq wd("=?utf-8?b?Zm9v?==?UTF-8?B?Zg==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zm9v?==?UTF-8?B?Zg==?= x "), ("foof x ", "")
  assert_eq wd("=E9?==E9=?x-unknown?q?=?x-unknown?q??=?us-ascii?q?=E9?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9?==E9=?x-unknown?q?=?x-unknown?q??=?us-ascii?q?=E9?"), ("=E9?==E9=?x-unknown?q?=?x-unknown?q??=?us-ascii?q?=E9?", "")
  assert_eq wd("=?UTF-8?B?Zm9v?=\r\n\t=?UTF-8?B?w6k=cw===E9?= x =?utf-8?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zm9v?=\r\n\t=?UTF-8?B?w6k=cw===E9?= x =?utf-8?q??= "), ("foo\r\n\t=?UTF-8?B?w6k=cw===E9?= x  ", "")
  assert_eq wd("=?\r\n Zm9 "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?\r\n Zm9 "), ("=?\r\n Zm9 ", "")
  assert_eq wd("=?iso-8859-1?Q?cw==cw==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?cw==cw==?= "), ("=?iso-8859-1?Q?cw==cw==?= ", "")
  assert_eq wd("=?utf-8?x?ZgZg=?us-ascii?q?_QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?ZgZg=?us-ascii?q?_QW5k"), ("=?utf-8?x?ZgZg=?us-ascii?q?_QW5k", "")
  assert_eq wd("=?utf-8?b?_Zg==?=\r\n\t=?utf-8?b?cw==QW5kQW5k?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?_Zg==?=\r\n\t=?utf-8?b?cw==QW5kQW5k?="), ("=?utf-8?b?_Zg==?=\r\n\t=?utf-8?b?cw==QW5kQW5k?=", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f5f803f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f5f803f3d2020")), (hx("3d3f75732d61736369693f713f5f803f3d2020"), "")
  assert_eq wd("QW5k?==?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k?==?us-ascii?q?"), ("QW5k?==?us-ascii?q?", "")
  assert_eq wd("=?us-ascii?q?aZm9v=3F?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?aZm9v=3F?= x "), ("aZm9v? x ", "")
  assert_eq wd("Zm9w6k=?cw==_QW5kZg\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9w6k=?cw==_QW5kZg\r\n "), ("Zm9w6k=?cw==_QW5kZg\r\n ", "")
  assert_eq wd("=?UTF-8?B?a?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?a?=  "), ("=?UTF-8?B?a?=  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B?a?= x =?utf-8?b??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?a?= x =?utf-8?b??=  "), ("=?UTF-8?B?a?= x   ", "")
  assert_eq wd("\r\n \n=4=?utf-8?x?\n=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n \n=4=?utf-8?x?\n=?us-ascii?q?"), ("\r\n \n=4=?utf-8?x?\n=?us-ascii?q?", "")
  assert_eq wd(hx("3d3f5554462d383f423f803f3d203d3f5554462d383f423f615157356b5f3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f803f3d203d3f5554462d383f423f615157356b5f3f3d2020")), (hx("3d3f5554462d383f423f803f3d203d3f5554462d383f423f615157356b5f3f3d2020"), "")
  assert_eq wd("===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("===="), ("====", "")
  assert_eq wd(hx("3d3f7574662d383f713f63773d3d803f3d203d3f7574662d383f623f5f3f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f63773d3d803f3d203d3f7574662d383f623f5f3f3d207820")), (hx("3d3f7574662d383f713f63773d3d803f3d203d3f7574662d383f623f5f3f3d207820"), "")
  assert_eq wd("?=a=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=a=?"), ("?=a=?", "")
  assert_eq wd("=?UTF-8?B??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??= x "), (" x ", "")
  assert_eq wd("é=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é=zz"), ("é=zz", "")
  assert_eq wd(hx("3d3f7574662d383f623f77366b3d803f3d20203d3f5554462d383f423f5157356b5f5a673d3d3f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f77366b3d803f3d20203d3f5554462d383f423f5157356b5f5a673d3d3f3d207820")), (hx("3d3f7574662d383f623f77366b3d803f3d20203d3f5554462d383f423f5157356b5f5a673d3d3f3d207820"), "")
  assert_eq wd("cw==_cw==plain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw==_cw==plain"), ("cw==_cw==plain", "")
}

test "vectors: word decoder 18" {
  assert_eq wd("=?UTF-8?B?Zm9v?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zm9v?= "), ("foo ", "")
  assert_eq wd("=?us-ascii?q??=?us-ascii?q?ZgQW5k\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=?us-ascii?q?ZgQW5k\r\n "), ("?us-ascii?q?ZgQW5k\r\n ", "")
  assert_eq wd("=?iso-8859-1?Q?Zg==?= x =?iso-8859-1?Q?=C3=A9Zg==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zg==?= x =?iso-8859-1?Q?=C3=A9Zg==?="), ("=?iso-8859-1?Q?Zg==?= x =?iso-8859-1?Q?=C3=A9Zg==?=", "")
  assert_eq wd("cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw=="), ("cw==", "")
  assert_eq wd(hx("3d3f5554462d383f423f3d43333d4139803f3d20203d3f7574662d383f623f803f3d2078203d3f7574662d383f713f3d45395a6d39763f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f3d43333d4139803f3d20203d3f7574662d383f623f803f3d2078203d3f7574662d383f713f3d45395a6d39763f3d")), (hx("3d3f5554462d383f423f3d43333d4139803f3d20203d3f7574662d383f623f803f3d207820e95a6d3976"), "")
  assert_eq wd("?=====QW5k?==?utf-8?q?=?utf-8?q?Zg=====?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=====QW5k?==?utf-8?q?=?utf-8?q?Zg=====?x-unknown?q?"), ("?=====QW5k?==?utf-8?q?=?utf-8?q?Zg=====?x-unknown?q?", "")
  assert_eq wd("=?us-ascii?q?w6k=Zg==?=  =?iso-8859-1?Q?=3Fw6k=cw==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?w6k=Zg==?=  =?iso-8859-1?Q?=3Fw6k=cw==?= "), ("=?us-ascii?q?w6k=Zg==?=  =?iso-8859-1?Q?=3Fw6k=cw==?= ", "")
  assert_eq wd("=?utf-8?q?w6k==?UTF-8?B?Zm9a=C3=A9?=Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?w6k==?UTF-8?B?Zm9a=C3=A9?=Zm9"), ("=?utf-8?q?w6k==?UTF-8?B?Zm9a=C3=A9?=Zm9", "")
  assert_eq wd("=?us-ascii?q?_=C3=A9cw==?==?utf-8?b??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?_=C3=A9cw==?==?utf-8?b??= x "), ("=?us-ascii?q?_=C3=A9cw==?= x ", "")
  assert_eq wd("?==?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==?us-ascii?q?"), ("?==?us-ascii?q?", "")
  assert_eq wd("=?utf-8?q?Zm9vw6k=?=\r\n\t=?us-ascii?q?a?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zm9vw6k=?=\r\n\t=?us-ascii?q?a?= x "), ("=?utf-8?q?Zm9vw6k=?=\r\n\ta x ", "")
  assert_eq wd("plain=4?cw===?utf-8?x?w6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plain=4?cw===?utf-8?x?w6k="), ("plain=4?cw===?utf-8?x?w6k=", "")
  assert_eq wd("=?UTF-8?B??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??= "), (" ", "")
  assert_eq wd("=?utf-8?q?=4 ?=?iso-8859-1?Q?=E9 "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=4 ?=?iso-8859-1?Q?=E9 "), ("=?utf-8?q?=4 ?=?iso-8859-1?Q?=E9 ", "")
  assert_eq wd("=?utf-8?q?w6k=cw==cw==?= =?us-ascii?q??= =?us-ascii?q?cw==Zm9v?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?w6k=cw==cw==?= =?us-ascii?q??= =?us-ascii?q?cw==Zm9v?= "), ("=?utf-8?q?w6k=cw==cw==?=  =?us-ascii?q?cw==Zm9v?= ", "")
  assert_eq wd("=?iso-8859-1?Q?w6k=Zm9=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?w6k=Zm9=zz"), ("=?iso-8859-1?Q?w6k=Zm9=zz", "")
  assert_eq wd("=?utf-8?q?a?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?a?=  "), ("a  ", "")
  assert_eq wd("=?utf-8?x?=C3=A9?==?iso-8859-1?Q?=4a=====C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=C3=A9?==?iso-8859-1?Q?=4a=====C3=A9"), ("=?utf-8?x?=C3=A9?==?iso-8859-1?Q?=4a=====C3=A9", "")
  assert_eq wd(hx("3d3f7574662d383f713f8063773d3d3f3d20203d3f69736f2d383835392d313f513f77366b3d5a673d3d3f3d2078203d3f7574662d383f623f3f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f8063773d3d3f3d20203d3f69736f2d383835392d313f513f77366b3d5a673d3d3f3d2078203d3f7574662d383f623f3f3d")), (hx("3d3f7574662d383f713f8063773d3d3f3d20203d3f69736f2d383835392d313f513f77366b3d5a673d3d3f3d207820"), "")
  assert_eq wd("=zz=?utf-8?q?\r\n =E9\r\n =?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz=?utf-8?q?\r\n =E9\r\n =?utf-8?x?"), ("=zz=?utf-8?q?\r\n =E9\r\n =?utf-8?x?", "")
  assert_eq wd("=?utf-8?b?cw===E9?="), ("", "illegal base64 data at input byte 4")
  assert_eq wdh("=?utf-8?b?cw===E9?="), ("=?utf-8?b?cw===E9?=", "")
  assert_eq wd("=====?Zg w6k==??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=====?Zg w6k==??="), ("=====?Zg w6k==??=", "")
  assert_eq wd("=?utf-8?q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??=  "), ("  ", "")
  assert_eq wd("=4_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4_"), ("=4_", "")
  assert_eq wd("=?iso-8859-1?Q?_=C3=A9a?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?_=C3=A9a?=  "), (" Ã©a  ", "")
  assert_eq wd("Zgw6k==?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zgw6k==?us-ascii?q?"), ("Zgw6k==?us-ascii?q?", "")
  assert_eq wd("=?iso-8859-1?Q?w6k=?=\r\n\t=?utf-8?b?w6k=?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?w6k=?=\r\n\t=?utf-8?b?w6k=?=  "), ("=?iso-8859-1?Q?w6k=?=\r\n\té  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f5554462d383f423f805a673d3d3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f805a673d3d3f3d0d0a09")), (hx("3d3f5554462d383f423f805a673d3d3f3d0d0a09"), "")
  assert_eq wd("=====zz?=_cw==Zm9plainw6k=\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=====zz?=_cw==Zm9plainw6k=\n"), ("=====zz?=_cw==Zm9plainw6k=\n", "")
  assert_eq wd("=?us-ascii?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= "), (" ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B?Zg==?=  =?utf-8?q?cw==w6k=?= x =?utf-8?b?QW5k?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zg==?=  =?utf-8?q?cw==w6k=?= x =?utf-8?b?QW5k?=\r\n\t"), ("f  =?utf-8?q?cw==w6k=?= x And\r\n\t", "")
  assert_eq wd("=?utf-8?x?=4 ?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=4 ?"), ("=?utf-8?x?=4 ?", "")
  assert_eq wd("=?utf-8?b?QW5k?==?utf-8?b??= =?us-ascii?q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?QW5k?==?utf-8?b??= =?us-ascii?q??=\r\n\t"), ("And\r\n\t", "")
  assert_eq wd("=E9w6k= cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9w6k= cw=="), ("=E9w6k= cw==", "")
  assert_eq wd("=?iso-8859-1?Q?aZg==?= x =?iso-8859-1?Q?Zm9v?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?aZg==?= x =?iso-8859-1?Q?Zm9v?= "), ("=?iso-8859-1?Q?aZg==?= x Zm9v ", "")
  assert_eq wd("QW5k?a=?UTF-8?B?aZm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k?a=?UTF-8?B?aZm9"), ("QW5k?a=?UTF-8?B?aZm9", "")
  assert_eq wd("=?utf-8?b?w6k=Zm9v?= =?utf-8?b?=E9=E9QW5k?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?w6k=Zm9v?= =?utf-8?b?=E9=E9QW5k?= "), ("=?utf-8?b?w6k=Zm9v?= =?utf-8?b?=E9=E9QW5k?= ", "")
  assert_eq wd("?==?us-ascii?q?\n?==C3=A9cw===?x-unknown?q?\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==?us-ascii?q?\n?==C3=A9cw===?x-unknown?q?\n"), ("?=\n=C3=A9cw===?x-unknown?q?\n", "")
  assert_eq wd("=?iso-8859-1?Q?w6k=?= x =?us-ascii?q?QW5k?==?utf-8?q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?w6k=?= x =?us-ascii?q?QW5k?==?utf-8?q??="), ("=?iso-8859-1?Q?w6k=?= x QW5k", "")
  assert_eq wd("é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é"), ("é", "")
  assert_eq wd("=?UTF-8?B?Zg==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zg==?= x "), ("f x ", "")
  assert_eq wd("éw6k=w6k==C3=A9QW5k=?iso-8859-1?Q??=?=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("éw6k=w6k==C3=A9QW5k=?iso-8859-1?Q??=?=?us-ascii?q?"), ("éw6k=w6k==C3=A9QW5k?=?us-ascii?q?", "")
  assert_eq wd("=?utf-8?q?aZm9v?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?aZm9v?= x "), ("aZm9v x ", "")
  assert_eq wd("ZgZm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("ZgZm9"), ("ZgZm9", "")
  assert_eq wd(hx("3d3f7574662d383f713f5a6d39765f3f3d203d3f75732d61736369693f713f803f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5a6d39765f3f3d203d3f75732d61736369693f713f803f3d207820")), (hx("5a6d397620203d3f75732d61736369693f713f803f3d207820"), "")
  assert_eq wd("=?utf-8?q? w6k==C3=A9é====Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q? w6k==C3=A9é====Zm9"), ("=?utf-8?q? w6k==C3=A9é====Zm9", "")
  assert_eq wd("=?utf-8?b??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=  "), ("  ", "")
  assert_eq wd(" \n=?UTF-8?B?=?us-ascii?q?=4 QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" \n=?UTF-8?B?=?us-ascii?q?=4 QW5k"), (" \n=?UTF-8?B?=?us-ascii?q?=4 QW5k", "")
}

test "vectors: word decoder 19" {
  assert_eq wd("=?iso-8859-1?Q?QW5kaQW5k?=\r\n\t=?UTF-8?B?_=E9Zm9v?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?QW5kaQW5k?=\r\n\t=?UTF-8?B?_=E9Zm9v?=  "), ("QW5kaQW5k\r\n\t=?UTF-8?B?_=E9Zm9v?=  ", "")
  assert_eq wd("=?x-unknown?q?plain=?utf-8?x?_w6k==?utf-8?q?=E9=4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?plain=?utf-8?x?_w6k==?utf-8?q?=E9=4"), ("=?x-unknown?q?plain=?utf-8?x?_w6k==?utf-8?q?=E9=4", "")
  assert_eq wd(hx("3d3f7574662d383f713f8077366b3d3f3d0d0a093d3f75732d61736369693f713f5a673d3d63773d3d3d45393f3d3d3f5554462d383f423f5f3d33463f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f8077366b3d3f3d0d0a093d3f75732d61736369693f713f5a673d3d63773d3d3d45393f3d3d3f5554462d383f423f5f3d33463f3d2020")), (hx("3d3f7574662d383f713f8077366b3d3f3d0d0a093d3f75732d61736369693f713f5a673d3d63773d3d3d45393f3d3d3f5554462d383f423f5f3d33463f3d2020"), "")
  assert_eq wd("=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz"), ("=zz", "")
  assert_eq wd("=?UTF-8?B?cw==?=  =?utf-8?q?=E9QW5kZg==?==?iso-8859-1?Q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?cw==?=  =?utf-8?q?=E9QW5kZg==?==?iso-8859-1?Q??=  "), ("s  =?utf-8?q?=E9QW5kZg==?=  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?iso-8859-1?Q?aZg==?==?utf-8?b?a=E9=3F?=  =?UTF-8?B??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?aZg==?==?utf-8?b?a=E9=3F?=  =?UTF-8?B??=  "), ("=?iso-8859-1?Q?aZg==?==?utf-8?b?a=E9=3F?=    ", "")
  assert_eq wd("\n=4?=plain=?UTF-8?B?\r\n QW5kw6k==?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n=4?=plain=?UTF-8?B?\r\n QW5kw6k==?UTF-8?B?"), ("\n=4?=plain=?UTF-8?B?\r\n QW5kw6k==?UTF-8?B?", "")
  assert_eq wd("=?utf-8?b?Zg==_=3F?= x =?utf-8?b?cw==w6k=?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zg==_=3F?= x =?utf-8?b?cw==w6k=?=  "), ("=?utf-8?b?Zg==_=3F?= x =?utf-8?b?cw==w6k=?=  ", "")
  assert_eq wd("=?iso-8859-1?Q?=4QW5kZm9vcw==Zm9véZm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=4QW5kZm9vcw==Zm9véZm9"), ("=?iso-8859-1?Q?=4QW5kZm9vcw==Zm9véZm9", "")
  assert_eq wd("=?iso-8859-1?Q?cw==Zg==?=\r\n\t=?us-ascii?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?cw==Zg==?=\r\n\t=?us-ascii?q??= "), ("=?iso-8859-1?Q?cw==Zg==?=\r\n\t ", "")
  assert_eq wd("plain_Zg_é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plain_Zg_é"), ("plain_Zg_é", "")
  assert_eq wd("=?iso-8859-1?Q?=E9Zg==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=E9Zg==?="), ("=?iso-8859-1?Q?=E9Zg==?=", "")
  assert_eq wd("=?x-unknown?q?====Zg=?utf-8?q?Zm9v=?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?====Zg=?utf-8?q?Zm9v=?UTF-8?B?"), ("=?x-unknown?q?====Zg=?utf-8?q?Zm9v=?UTF-8?B?", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f5f63773d3d63773d3d3f3d203d3f5554462d383f423f803d43333d41393f3d3d3f7574662d383f623f5f803f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f5f63773d3d63773d3d3f3d203d3f5554462d383f423f803d43333d41393f3d3d3f7574662d383f623f5f803f3d0d0a09")), (hx("3d3f75732d61736369693f713f5f63773d3d63773d3d3f3d203d3f5554462d383f423f803d43333d41393f3d3d3f7574662d383f623f5f803f3d0d0a09"), "")
  assert_eq wd("=?utf-8?x?Zgéw6k====="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?Zgéw6k====="), ("=?utf-8?x?Zgéw6k=====", "")
  assert_eq wd("=?utf-8?b?Zm9vcw==?="), ("foos", "")
  assert_eq wdh("=?utf-8?b?Zm9vcw==?="), ("foos", "")
  assert_eq wd("=E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9"), ("=E9", "")
  assert_eq wd("=?utf-8?b??==?utf-8?q?a=E9?=\r\n\t=?utf-8?b?cw==_cw==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??==?utf-8?q?a=E9?=\r\n\t=?utf-8?b?cw==_cw==?= x "), (hx("61e90d0a093d3f7574662d383f623f63773d3d5f63773d3d3f3d207820"), "")
  assert_eq wd("Zm9v=4=?iso-8859-1?Q?Zm9=E9Zg=C3=A9====\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v=4=?iso-8859-1?Q?Zm9=E9Zg=C3=A9====\n"), ("Zm9v=4=?iso-8859-1?Q?Zm9=E9Zg=C3=A9====\n", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f803d43333d413977366b3d3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f803d43333d413977366b3d3f3d2020")), (hx("3d3f69736f2d383835392d313f513f803d43333d413977366b3d3f3d2020"), "")
  assert_eq wd("Zg=zz=?utf-8?q?=4=??? \r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zg=zz=?utf-8?q?=4=??? \r\n "), ("Zg=zz=?utf-8?q?=4=??? \r\n ", "")
  assert_eq wd("=?us-ascii?q??=\r\n\t=?UTF-8?B??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=\r\n\t=?UTF-8?B??=  "), ("  ", "")
  assert_eq wd("Zm9=C3=A9=?utf-8?q?_=E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9=C3=A9=?utf-8?q?_=E9"), ("Zm9=C3=A9=?utf-8?q?_=E9", "")
  assert_eq wd("=?iso-8859-1?Q?w6k==E9=3F?= =?us-ascii?q??=\r\n\t=?utf-8?q?w6k=cw===3F?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?w6k==E9=3F?= =?us-ascii?q??=\r\n\t=?utf-8?q?w6k=cw===3F?= "), ("=?iso-8859-1?Q?w6k==E9=3F?= \r\n\t=?utf-8?q?w6k=cw===3F?= ", "")
  assert_eq wd("=E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9"), ("=E9", "")
  assert_eq wd("=?utf-8?b?=3Fw6k==C3=A9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3Fw6k==C3=A9?= "), ("=?utf-8?b?=3Fw6k==C3=A9?= ", "")
  assert_eq wd("=?utf-8?x??"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x??"), ("=?utf-8?x??", "")
  assert_eq wd(hx("3d3f7574662d383f623f803f3d2078203d3f7574662d383f713f3f3d203d3f75732d61736369693f713f613d334663773d3d3f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f803f3d2078203d3f7574662d383f713f3f3d203d3f75732d61736369693f713f613d334663773d3d3f3d")), (hx("3d3f7574662d383f623f803f3d207820203d3f75732d61736369693f713f613d334663773d3d3f3d"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B??="), ("", "")
  assert_eq wdh("=?UTF-8?B??="), ("", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q??= x =?iso-8859-1?Q?Zm9v?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= x =?iso-8859-1?Q?Zm9v?= x "), (" x Zm9v x ", "")
  assert_eq wd("?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?="), ("?=", "")
  assert_eq wd("=?us-ascii?q?=3F?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=3F?= x "), ("? x ", "")
  assert_eq wd("é=?iso-8859-1?Q?=?us-ascii?q?=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é=?iso-8859-1?Q?=?us-ascii?q?=?utf-8?x?"), ("é=?iso-8859-1?Q?=?us-ascii?q?=?utf-8?x?", "")
  assert_eq wd("=?utf-8?b?=E9?=  =?us-ascii?q?=E9QW5k?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=E9?=  =?us-ascii?q?=E9QW5k?=  "), ("=?utf-8?b?=E9?=  �QW5k  ", "")
  assert_eq wd("=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9"), ("=C3=A9", "")
  assert_eq wd("=?us-ascii?q?=E9w6k=?=  =?UTF-8?B?Zm9vZg===C3=A9?=  =?us-ascii?q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=E9w6k=?=  =?UTF-8?B?Zm9vZg===C3=A9?=  =?us-ascii?q??="), ("=?us-ascii?q?=E9w6k=?=  =?UTF-8?B?Zm9vZg===C3=A9?=  ", "")
  assert_eq wd("?aa?=a=E9w6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?aa?=a=E9w6k="), ("?aa?=a=E9w6k=", "")
  assert_eq wd("=?utf-8?b??=  =?utf-8?q??==?UTF-8?B?Zg==_w6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=  =?utf-8?q??==?UTF-8?B?Zg==_w6k=?= x "), ("=?UTF-8?B?Zg==_w6k=?= x ", "")
  assert_eq wd("a=?utf-8?x?cw==Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=?utf-8?x?cw==Zm9"), ("a=?utf-8?x?cw==Zm9", "")
  assert_eq wd("=?utf-8?q?=3F_?==?utf-8?q?=E9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3F_?==?utf-8?q?=E9?= x "), (hx("3f20e9207820"), "")
  assert_eq wd("a=zz=?iso-8859-1?Q?=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=zz=?iso-8859-1?Q?=zz"), ("a=zz=?iso-8859-1?Q?=zz", "")
  assert_eq wd("=?UTF-8?B?aZg==?=  =?utf-8?b?=C3=A9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?aZg==?=  =?utf-8?b?=C3=A9?=\r\n\t"), ("=?UTF-8?B?aZg==?=  =?utf-8?b?=C3=A9?=\r\n\t", "")
  assert_eq wd("a\r\n =?utf-8?x?=?x-unknown?q?ZgZm9QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a\r\n =?utf-8?x?=?x-unknown?q?ZgZm9QW5k"), ("a\r\n =?utf-8?x?=?x-unknown?q?ZgZm9QW5k", "")
  assert_eq wd("=?utf-8?q?Zm9v?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zm9v?=\r\n\t"), ("Zm9v\r\n\t", "")
  assert_eq wd("\n\r\n =?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n\r\n =?"), ("\n\r\n =?", "")
  assert_eq wd("=?us-ascii?q?Zm9v=E9_?=  =?utf-8?q?aQW5k?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zm9v=E9_?=  =?utf-8?q?aQW5k?=\r\n\t"), ("Zm9v� aQW5k\r\n\t", "")
  assert_eq wd("=?UTF-8?B?plain=4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?plain=4"), ("=?UTF-8?B?plain=4", "")
}

test "vectors: word decoder 20" {
  assert_eq wd("=?UTF-8?B?QW5k?=\r\n\t=?iso-8859-1?Q?=C3=A9?=\r\n\t=?iso-8859-1?Q?QW5kcw==w6k=?=  "), ("", "mime: invalid RFC 2047 encoded-word")
