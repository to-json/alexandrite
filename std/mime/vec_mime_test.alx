}

test "vectors: parse media type 14" {
  assert_eq pmt("application/x-stuff ; filename*0*= !~a.; ="), "ERR mime: invalid media parameter|application/x-stuff"
  assert_eq pmt("=\\\"*0html'//x xTEXT"), "ERR mime: no media type"
  assert_eq pmt("attachment ; boundary*2*=ba1~~a; charset*1= -; boundary =~"), "attachment|boundary=~"
  assert_eq pmt("attachment"), "attachment"
  assert_eq pmt("PlainPlainutf-8''*\"a b\""), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data ; filename=-b!!a~;"), "form-data|filename=-b!!a~"
  assert_eq pmt("a/b ; name= b.b ; filename*2*= utf-8''%41%%41; Title*1* =_~aa1_ ;"), "a/b|name=b.b"
  assert_eq pmt("'\"a b\"utf-8'''"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b; boundary* =~.!_"), "a/b"
  assert_eq pmt("text/plain;charset*= b1~!b;x= ba---;boundary =1a_"), "text/plain|boundary=1a_|x=ba---"
  assert_eq pmt("textx"), "textx"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("*1' ,*0text'textus-ascii'en'text"), "ERR mime: expected slash after first token"
  assert_eq pmt("attachment ; name= \" \";x*2* =\"xxa\\\" \"; charset= utf-8''a%41b%4 ;"), "attachment|charset=utf-8''a%41b%4|name= "
  assert_eq pmt("Multipart/Mixed; filename*2= ~-b._"), "multipart/mixed"
  assert_eq pmt("\"TEXT%41text%41'"), "ERR mime: no media type"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("text/plain; filename*0*= \"x \" ; name*=\"a; %41%41\""), "text/plain|filename="
  assert_eq pmt(" x ; =é; "), "ERR mime: invalid media parameter|x"
  assert_eq pmt("text/plain ; filename=_ ; boundary*0= 1~_~; name*0*=\"aaax \""), "text/plain|boundary=1~_~|filename=_|name="
  assert_eq pmt("text/plain ; boundary =utf-8''; x= \"\\\\a x\";filename= _--1 ;"), "text/plain|boundary=utf-8''|filename=_--1|x=\\a x"
  assert_eq pmt(";\"foo\\TEXT\\é=*=*=\\\"x;"), "ERR mime: no media type"
  assert_eq pmt("form-data;boundary*= b; boundary =b1.b;name*1*= \"\\\\\""), "form-data|boundary=b1.b"
  assert_eq pmt("text/plain ; boundary=_~-.a- ; filename =\"\\\"x\\\"x\\\"\";x=iso-8859-1''"), "text/plain|boundary=_~-.a-|filename=\"x\"x\"|x=iso-8859-1''"
  assert_eq pmt("charsetfooutf-8'',name{}html*1*0**1 *0*%zz"), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed; boundary= utf-8'b%41a; x*1= -"), "multipart/mixed|boundary=utf-8'b%41a"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("*=*0*\\=,%2"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff; filename*1*= US-ASCII'en'a%4 ; name*2= ~b1"), "application/x-stuff"
  assert_eq pmt("text/plain ; x* =_;charset* =\" %41 \"; charset*1=~~"), "text/plain"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff ; charset*=~-.-b;x*0* =\";é%41\" ; boundary=~1-"), "application/x-stuff|boundary=~1-|x="
  assert_eq pmt("form-data ; x= ''%4;boundary* =utf-8'%4 ; x=US-ASCII'en'%c3%a4%4%4a"), "ERR mime: duplicate parameter name"
  assert_eq pmt("name\"a b\"x\"*1us-ascii'en'=xname%zzfoo\t"), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed;name*1* =_"), "multipart/mixed"
  assert_eq pmt("Multipart/Mixed; boundary*2=!\""), "ERR mime: invalid media parameter|multipart/mixed"
  assert_eq pmt("utf-8"), "utf-8"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("text/plain;x= ~..; x= -_~1a~ ;"), "ERR mime: duplicate parameter name"
  assert_eq pmt("\t"), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed ; x*0= _b ; charset= !"), "multipart/mixed|charset=!|x=_b"
  assert_eq pmt("attachment ; name= -_-.! ; x*1* =US-ASCII'en'"), "attachment|name=-_-.!"
  assert_eq pmt("'{}"), "'{}"
  assert_eq pmt("attachment; Title= a_!b.-"), "attachment|title=a_!b.-"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("é*0TEXT\"=charset"), "ERR mime: no media type"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("form-data; Title*=ab.b; name* =utf-8'a"), "form-data"
  assert_eq pmt("fooxfoo /;*0*utf-8''{}utf-8''é"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data; x=1.1_!b;boundary*2=!!bb"), "form-data|x=1.1_!b"
  assert_eq pmt("Multipart/Mixed;filename =b!ba."), "multipart/mixed|filename=b!ba."
  assert_eq pmt("\r\nutf-8''*"), "utf-8''*"
  assert_eq pmt("attachment;x= ~!-~;boundary*2* =\"x; \\\"é\"\""), "ERR mime: invalid media parameter|attachment"
  assert_eq pmt("attachment ; Title*= utf-8''a%%b; charset= \";\""), "attachment|charset=;"
  assert_eq pmt(",\\utf-8@\\\";\\="), "ERR mime: no media type"
  assert_eq pmt("form-data ; boundary*= iso-8859-1''%41a"), "form-data"
  assert_eq pmt("a/b;filename*0*=\"\\\"a\\\\\\\\é\" ; boundary*= ~!~.b; name =.a ;"), "a/b|filename=|name=.a"
  assert_eq pmt("%2*@ "), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("application/x-stuff ; boundary*2 =\";\""), "application/x-stuff"
  assert_eq pmt("*0@ é%zz *utf-8"), "ERR mime: expected slash after first token"
  assert_eq pmt("attachment; filename*=~b; ="), "ERR mime: invalid media parameter|attachment"
  assert_eq pmt("application/x-stuff; charset* =\"\"; x= iso-8859-1'' ;"), "application/x-stuff|x=iso-8859-1''"
  assert_eq pmt("\\"), "ERR mime: no media type"
  assert_eq pmt("form-data;name =a!; name= utf-8''%4"), "ERR mime: duplicate parameter name"
  assert_eq pmt("attachment;boundary =a~b-a."), "attachment|boundary=a~b-a."
  assert_eq pmt("x; text*%zzutf-8{}xPlain"), "ERR mime: invalid media parameter|x"
  assert_eq pmt("Multipart/Mixed; x* =iso-8859-1''%41a"), "multipart/mixed"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("'"), "'"
  assert_eq pmt("form-data ; name*2*= 1; charset*2=\"   \""), "form-data"
  assert_eq pmt("application/x-stuff ; filename =!a~11 ; charset*= \"\\\\\\\" \";"), "application/x-stuff|filename=!a~11"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("form-data; filename= \"\""), "form-data|filename="
  assert_eq pmt("utf-8''*0TEXT'charset, Plainfoo*=us-ascii'en'\r\n"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b;charset*=b.b_"), "a/b"
  assert_eq pmt("attachment ; x*2 =_-_! ; Title= ~~1a.1;filename =b"), "attachment|filename=b|title=~~1a.1"
  assert_eq pmt("*0/nameutf-8''\"utf-8''"), "ERR mime: unexpected content after media subtype"
  assert_eq pmt("Multipart/Mixed ; boundary=b;boundary*= utf-8''%c3%a4%"), "multipart/mixed|boundary=b"
  assert_eq pmt("form-data;charset*0 =b; boundary*1* =\";a\\\\\\\\\""), "form-data|charset=b"
  assert_eq pmt("foo'\\\"utf-8\"a b\""), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b; charset =!b1b1; Title=~-ba; charset= b"), "ERR mime: duplicate parameter name"
  assert_eq pmt("a/b; charset=\"é\\\\xax\""), "a/b|charset=é\\xax"
  assert_eq pmt("html%2html\r\n/Plain\""), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed; name=!.!11-"), "multipart/mixed|name=!.!11-"
  assert_eq pmt("Multipart/Mixed;x*0= ..-~.-"), "multipart/mixed|x=..-~.-"
  assert_eq pmt(";charset@; us-ascii'en'*0étext'é' *0*"), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff;x =utf-8''a%4a ; name*=~-b~."), "application/x-stuff|x=utf-8''a%4a"
  assert_eq pmt("form-data ; charset*2* =!- ; Title*1*= -b~--; filename=\"\\\"\\\"\\\\\""), "form-data|filename=\"\"\\"
  assert_eq pmt("\"Plain@TEXTxtext%41utf-8''*=charset'@"), "ERR mime: no media type"
  assert_eq pmt("attachment ; x= ~1a!!; filename= b~"), "attachment|filename=b~|x=~1a!!"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("TEXT"), "text"
  assert_eq pmt("Multipart/Mixed ; boundary*= _ba!~"), "multipart/mixed"
  assert_eq pmt("form-data ; name*0*= .1 ; Title=iso-8859-1''; Title*1* =-"), "form-data|name=|title=iso-8859-1''"
  assert_eq pmt("*0*%zz%41TEXThtmlfooé*0/Plain*={}*"), "ERR mime: expected slash after first token"
  assert_eq pmt("attachment"), "attachment"
  assert_eq pmt("a/b;charset =~;name*1*=.~_1~1 ; Title*0 =US-ASCII'en'%c3%a4%41%c3%a4%41 ;"), "a/b|charset=~|title=US-ASCII'en'%c3%a4%41%c3%a4%41"
}

test "vectors: format media type" {
  assert_eq format_media_type("text/html", m(["x-y", "é"])), "text/html; x-y*=utf-8''%C3%A9"
  assert_eq format_media_type("/", m(["", "é", "x-y", "", "0", "数据"])), ""
  assert_eq format_media_type("", m(["a", "a\"b"])), ""
  assert_eq format_media_type("noslash", m(["bad attr", ""])), ""
  assert_eq format_media_type("image/svg+xml", m(["filename", "ok", "a", "x;y"])), "image/svg+xml; a=\"x;y\"; filename=ok"
  assert_eq format_media_type("a b/c", m(["filename", "ok"])), ""
  assert_eq format_media_type("", m(["0", "é", "charset", "tab\there", "x-y", "x;y"])), ""
  assert_eq format_media_type("image/svg+xml", m(["0", "{x}", "Z", "nl\nx"])), "image/svg+xml; 0={x}; z*=utf-8''nl%0Ax"
  assert_eq format_media_type("x/y z", m(["bad attr", "a b", "Name", "50%"])), ""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("TEXT/Plain", m(["x-y", "a\\b", "Name", ""])), "text/plain; name=\"\"; x-y=\"a\\\\b\""
  assert_eq format_media_type("", m(["a", "x;y", "filename", "a\"b"])), ""
  assert_eq format_media_type("image/svg+xml", m(["filename", "a*b", "0", "a\"b"])), "image/svg+xml; 0=\"a\\\"b\"; filename=a*b"
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("a b/c", m(["Z", "ok", "0", "'q'", "a", "ok"])), ""
  assert_eq format_media_type("a/", m(["a", "数据", "bad attr", "a\\b", "x-y", "a\\b"])), ""
  assert_eq format_media_type("", m(["0", "nl\nx"])), ""
  assert_eq format_media_type("a/", m(["charset", "{x}", "bad attr", "ok", "x-y", "ok"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("/", m(["Z", "a\"b", "filename", "a b"])), ""
  assert_eq format_media_type("text/html", m(["", "a*b", "Z", "tab\there", "Name", "a\\b"])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("multipart/form-data", m(["bad attr", "a*b"])), ""
  assert_eq format_media_type("x/y z", m(["bad attr", "a\"b", "a", "tab\there", "", "ok"])), ""
  assert_eq format_media_type("text/html", m(["a", "ok", "charset", "nl\nx"])), "text/html; a=ok; charset*=utf-8''nl%0Ax"
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("x/y z", m(["charset", "{x}", "Z", "utf-8"])), ""
  assert_eq format_media_type("text/html", m(["a", "a*b", "bad attr", "50%"])), ""
  assert_eq format_media_type("x/y z", m(["x-y", "'q'", "bad attr", "数据"])), ""
  assert_eq format_media_type("noslash", m(["x-y", "x;y", "", ""])), ""
  assert_eq format_media_type("x/y z", m(["", "utf-8", "Name", "'q'"])), ""
  assert_eq format_media_type("a/", m(["x-y", "a*b", "a", "utf-8"])), ""
  assert_eq format_media_type("multipart/form-data", m(["0", "'q'"])), "multipart/form-data; 0='q'"
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("TEXT/Plain", m(["Name", "a\"b"])), "text/plain; name=\"a\\\"b\""
  assert_eq format_media_type("/", m(["x-y", "'q'", "0", "{x}"])), ""
  assert_eq format_media_type("text/html", m(["charset", "a*b", "Z", "a\"b"])), "text/html; z=\"a\\\"b\"; charset=a*b"
  assert_eq format_media_type("image/svg+xml", m(["Name", "数据", "charset", "tab\there", "a", "ok"])), "image/svg+xml; name*=utf-8''%E6%95%B0%E6%8D%AE; a=ok; charset=\"tab\there\""
  assert_eq format_media_type("text/html", m(["a", "tab\there", "bad attr", "a\\b"])), ""
  assert_eq format_media_type("/", m(["Name", "é", "bad attr", "tab\there"])), ""
  assert_eq format_media_type("a b/c", m(["0", "é", "a", "a\\b"])), ""
  assert_eq format_media_type("text/html", m(["x-y", "ok"])), "text/html; x-y=ok"
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("TEXT/Plain", m(["a", "x;y"])), "text/plain; a=\"x;y\""
  assert_eq format_media_type("", m(["", "x;y"])), ""
  assert_eq format_media_type("noslash", m(["x-y", "a\\b", "charset", "'q'"])), "noslash; charset='q'; x-y=\"a\\\\b\""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("/", m(["Name", "x;y", "", "tab\there"])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("/", m(["charset", "a\"b"])), ""
  assert_eq format_media_type("x/y z", m(["Z", "a b", "charset", "tab\there"])), ""
  assert_eq format_media_type("a b/c", m(["Name", "{x}"])), ""
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("image/svg+xml", m(["bad attr", "utf-8"])), ""
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("multipart/form-data", m(["", "é", "Name", "数据"])), ""
  assert_eq format_media_type("multipart/form-data", m(["Name", "'q'"])), "multipart/form-data; name='q'"
  assert_eq format_media_type("x/y z", m(["Name", "a\\b"])), ""
  assert_eq format_media_type("text/html", m(["Z", "{x}", "", "tab\there", "bad attr", "tab\there"])), ""
  assert_eq format_media_type("/", m(["Z", "'q'", "x-y", "a\\b"])), ""
  assert_eq format_media_type("text/html", m(["Z", "a b", "0", "数据", "x-y", "a\"b"])), "text/html; 0*=utf-8''%E6%95%B0%E6%8D%AE; z=\"a b\"; x-y=\"a\\\"b\""
  assert_eq format_media_type("a/", m(["", "'q'", "x-y", "tab\there"])), ""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("x/y z", m(["", "x;y"])), ""
  assert_eq format_media_type("a/", m(["charset", "ok", "0", "x;y", "filename", "'q'"])), ""
  assert_eq format_media_type("multipart/form-data", m(["Z", "nl\nx"])), "multipart/form-data; z*=utf-8''nl%0Ax"
  assert_eq format_media_type("/", m(["filename", "tab\there", "bad attr", "'q'"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["bad attr", "a\"b"])), ""
  assert_eq format_media_type("x/y z", m(["Z", "x;y", "x-y", "50%"])), ""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("a/", m(["0", "{x}", "a", "", "bad attr", "a\\b"])), ""
  assert_eq format_media_type("noslash", m(["Name", "a\\b", "bad attr", ""])), ""
  assert_eq format_media_type("/", m(["Z", "a\"b"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["x-y", "{x}"])), "text/plain; x-y={x}"
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("", m(["0", "tab\there", "", "50%", "Name", "50%"])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("text/html", m(["0", "'q'", "", "{x}"])), ""
  assert_eq format_media_type("text/html", m(["bad attr", "tab\there"])), ""
  assert_eq format_media_type("a b/c", m(["Name", "nl\nx"])), ""
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("multipart/form-data", m(["Name", "tab\there", "Z", "a b"])), "multipart/form-data; name=\"tab\there\"; z=\"a b\""
  assert_eq format_media_type("text/html", m(["filename", "a\\b", "charset", "{x}"])), "text/html; charset={x}; filename=\"a\\\\b\""
  assert_eq format_media_type("noslash", m(["filename", "x;y"])), "noslash; filename=\"x;y\""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("noslash", m(["bad attr", "a\"b", "charset", "tab\there"])), ""
  assert_eq format_media_type("noslash", m(["bad attr", "'q'"])), ""
  assert_eq format_media_type("text/html", m(["0", "a\\b"])), "text/html; 0=\"a\\\\b\""
  assert_eq format_media_type("multipart/form-data", m(["", ""])), ""
  assert_eq format_media_type("x/y z", m(["0", "nl\nx"])), ""
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("", m(["", "é", "x-y", "a\\b"])), ""
  assert_eq format_media_type("noslash", m(["", "utf-8"])), ""
  assert_eq format_media_type("/", m(["", "x;y", "0", "{x}", "Name", "x;y"])), ""
  assert_eq format_media_type("image/svg+xml", m(["Name", "utf-8", "a", "数据", "charset", "nl\nx"])), "image/svg+xml; name=utf-8; a*=utf-8''%E6%95%B0%E6%8D%AE; charset*=utf-8''nl%0Ax"
  assert_eq format_media_type("multipart/form-data", m(["x-y", "nl\nx", "a", "nl\nx", "Name", "'q'"])), "multipart/form-data; name='q'; a*=utf-8''nl%0Ax; x-y*=utf-8''nl%0Ax"
  assert_eq format_media_type("/", m(["Z", "ok", "filename", "x;y", "charset", "a b"])), ""
  assert_eq format_media_type("noslash", m(["bad attr", "tab\there", "x-y", "a*b"])), ""
}

test "vectors: format media type 1" {
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("/", m(["bad attr", "a\\b", "0", "'q'", "Z", "a b"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("/", m(["Z", "utf-8"])), ""
  assert_eq format_media_type("noslash", m(["", "x;y", "0", ""])), ""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("text/html", m(["charset", "utf-8", "", "数据"])), ""
  assert_eq format_media_type("/", m(["filename", "数据"])), ""
  assert_eq format_media_type("a/", m(["x-y", "x;y"])), ""
  assert_eq format_media_type("image/svg+xml", m(["x-y", "a b", "charset", ""])), "image/svg+xml; charset=\"\"; x-y=\"a b\""
  assert_eq format_media_type("image/svg+xml", m(["a", "a*b"])), "image/svg+xml; a=a*b"
  assert_eq format_media_type("x/y z", m(["", "utf-8", "charset", "{x}"])), ""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("x/y z", m(["filename", "ok"])), ""
  assert_eq format_media_type("a/", m(["filename", "ok"])), ""
  assert_eq format_media_type("text/html", m(["0", "'q'"])), "text/html; 0='q'"
  assert_eq format_media_type("image/svg+xml", m(["Name", "utf-8", "x-y", "{x}", "filename", "a\"b"])), "image/svg+xml; name=utf-8; filename=\"a\\\"b\"; x-y={x}"
  assert_eq format_media_type("a/", m(["Z", "a b", "", "utf-8"])), ""
  assert_eq format_media_type("a b/c", m(["Z", "", "x-y", "a\\b", "0", "50%"])), ""
  assert_eq format_media_type("multipart/form-data", m(["Name", "数据", "Z", "{x}", "x-y", "é"])), "multipart/form-data; name*=utf-8''%E6%95%B0%E6%8D%AE; z={x}; x-y*=utf-8''%C3%A9"
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("/", m(["filename", "a\"b", "a", "a\\b"])), ""
  assert_eq format_media_type("a b/c", m(["", "é", "Z", "x;y", "charset", ""])), ""
  assert_eq format_media_type("/", m(["filename", "a\\b", "a", "50%"])), ""
  assert_eq format_media_type("multipart/form-data", m(["0", "50%", "Z", "{x}"])), "multipart/form-data; 0=50%; z={x}"
  assert_eq format_media_type("", m(["", "a*b"])), ""
  assert_eq format_media_type("text/html", m(["bad attr", "a*b", "", "x;y"])), ""
  assert_eq format_media_type("/", m(["Z", "a\\b", "Name", "nl\nx"])), ""
  assert_eq format_media_type("", m(["", "tab\there", "charset", "数据"])), ""
  assert_eq format_media_type("noslash", m(["bad attr", "50%"])), ""
  assert_eq format_media_type("/", m(["bad attr", "tab\there", "0", "ok"])), ""
  assert_eq format_media_type("a b/c", m(["Z", "é"])), ""
  assert_eq format_media_type("text/html", m(["Name", "a\"b", "filename", "nl\nx"])), "text/html; name=\"a\\\"b\"; filename*=utf-8''nl%0Ax"
  assert_eq format_media_type("x/y z", m(["charset", "a\"b", "Z", "tab\there"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["Name", "é", "", "utf-8", "a", "ok"])), ""
  assert_eq format_media_type("a/", m(["bad attr", ""])), ""
  assert_eq format_media_type("multipart/form-data", m(["a", "a\"b", "filename", "ok"])), "multipart/form-data; a=\"a\\\"b\"; filename=ok"
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("image/svg+xml", m(["0", "a b"])), "image/svg+xml; 0=\"a b\""
  assert_eq format_media_type("multipart/form-data", m(["0", "é", "", "é"])), ""
  assert_eq format_media_type("x/y z", m(["", "a*b"])), ""
  assert_eq format_media_type("image/svg+xml", m(["x-y", "'q'"])), "image/svg+xml; x-y='q'"
  assert_eq format_media_type("noslash", m(["Name", "a\"b"])), "noslash; name=\"a\\\"b\""
  assert_eq format_media_type("noslash", m(["0", "a\"b", "", "{x}"])), ""
  assert_eq format_media_type("image/svg+xml", m(["0", "utf-8", "a", "数据"])), "image/svg+xml; 0=utf-8; a*=utf-8''%E6%95%B0%E6%8D%AE"
  assert_eq format_media_type("a b/c", m(["a", "tab\there"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("noslash", m(["a", "tab\there", "Name", "é", "charset", "{x}"])), "noslash; name*=utf-8''%C3%A9; a=\"tab\there\"; charset={x}"
  assert_eq format_media_type("text/html", m(["0", "utf-8", "", ""])), ""
  assert_eq format_media_type("noslash", m(["charset", "a\"b", "bad attr", "{x}", "Name", "a\\b"])), ""
  assert_eq format_media_type("text/html", m(["filename", "utf-8", "Name", "'q'", "", "a\\b"])), ""
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("a b/c", m(["Z", "数据", "bad attr", "ok"])), ""
  assert_eq format_media_type("text/html", m(["", "'q'", "Z", "a b"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["x-y", "50%", "charset", "a*b"])), "text/plain; charset=a*b; x-y=50%"
  assert_eq format_media_type("text/html", m(["Name", "x;y"])), "text/html; name=\"x;y\""
  assert_eq format_media_type("", m(["Z", "ok", "charset", "50%"])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("a/", m(["Z", "tab\there", "filename", "a b"])), ""
  assert_eq format_media_type("/", m(["bad attr", "ok", "Z", "'q'", "charset", "ok"])), ""
  assert_eq format_media_type("image/svg+xml", m(["Z", "nl\nx", "bad attr", "nl\nx", "x-y", "tab\there"])), ""
  assert_eq format_media_type("", m(["0", "tab\there"])), ""
  assert_eq format_media_type("image/svg+xml", m(["Z", "utf-8", "", "", "x-y", "a b"])), ""
  assert_eq format_media_type("a/", m(["", "utf-8"])), ""
  assert_eq format_media_type("", m(["Name", "é", "a", "a*b", "0", "ok"])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("image/svg+xml", m(["x-y", "'q'", "filename", ""])), "image/svg+xml; filename=\"\"; x-y='q'"
  assert_eq format_media_type("TEXT/Plain", m(["Z", "'q'", "a", "tab\there"])), "text/plain; z='q'; a=\"tab\there\""
  assert_eq format_media_type("", m(["filename", "nl\nx", "charset", "a b", "x-y", "utf-8"])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("a/", m(["Z", "a\\b", "charset", "", "x-y", ""])), ""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("", m(["x-y", "数据", "Name", "a*b", "0", "nl\nx"])), ""
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("multipart/form-data", m(["", "utf-8"])), ""
  assert_eq format_media_type("", m(["0", "é", "a", "nl\nx"])), ""
  assert_eq format_media_type("image/svg+xml", m(["", "a*b"])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("text/html", m(["filename", "'q'", "x-y", "utf-8"])), "text/html; filename='q'; x-y=utf-8"
  assert_eq format_media_type("noslash", m(["Z", "ok"])), "noslash; z=ok"
  assert_eq format_media_type("a b/c", m(["", "{x}", "a", "a*b"])), ""
  assert_eq format_media_type("x/y z", m(["x-y", "tab\there"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("/", m(["charset", "a\\b", "x-y", "ok"])), ""
  assert_eq format_media_type("", m(["charset", "{x}", "Name", "x;y", "", "a*b"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["a", "数据"])), "text/plain; a*=utf-8''%E6%95%B0%E6%8D%AE"
  assert_eq format_media_type("multipart/form-data", m(["x-y", "a*b"])), "multipart/form-data; x-y=a*b"
  assert_eq format_media_type("text/html", m(["Z", "{x}"])), "text/html; z={x}"
  assert_eq format_media_type("text/html", m([])), "text/html"
}

test "vectors: format media type 2" {
  assert_eq format_media_type("/", m(["charset", "数据"])), ""
  assert_eq format_media_type("multipart/form-data", m(["bad attr", "数据"])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("a/", m(["charset", "ok", "filename", ""])), ""
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("noslash", m(["", "x;y", "Z", "a b"])), ""
  assert_eq format_media_type("a b/c", m(["charset", "", "bad attr", "50%"])), ""
  assert_eq format_media_type("/", m(["bad attr", "50%", "filename", "a b"])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("noslash", m(["", "'q'"])), ""
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("", m(["charset", "a\"b", "", "数据"])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("multipart/form-data", m(["x-y", "50%"])), "multipart/form-data; x-y=50%"
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("/", m(["bad attr", "", "filename", "ok"])), ""
  assert_eq format_media_type("text/html", m(["bad attr", "nl\nx"])), ""
  assert_eq format_media_type("multipart/form-data", m(["x-y", "x;y"])), "multipart/form-data; x-y=\"x;y\""
  assert_eq format_media_type("a/", m(["a", "é", "Name", "{x}"])), ""
  assert_eq format_media_type("a b/c", m(["filename", "a*b", "a", "x;y"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["charset", "nl\nx", "Name", "a b", "Z", "é"])), "text/plain; name=\"a b\"; z*=utf-8''%C3%A9; charset*=utf-8''nl%0Ax"
  assert_eq format_media_type("/", m(["filename", "{x}", "charset", "x;y"])), ""
  assert_eq format_media_type("text/html", m(["Name", "a*b"])), "text/html; name=a*b"
  assert_eq format_media_type("TEXT/Plain", m(["filename", "数据", "charset", "utf-8"])), "text/plain; charset=utf-8; filename*=utf-8''%E6%95%B0%E6%8D%AE"
  assert_eq format_media_type("a b/c", m(["Z", "a b", "x-y", "a\"b", "a", "50%"])), ""
  assert_eq format_media_type("text/html", m(["filename", "'q'"])), "text/html; filename='q'"
  assert_eq format_media_type("", m(["Name", "50%", "x-y", "x;y"])), ""
  assert_eq format_media_type("text/html", m(["charset", "tab\there", "a", ""])), "text/html; a=\"\"; charset=\"tab\there\""
  assert_eq format_media_type("a/", m(["Z", ""])), ""
  assert_eq format_media_type("noslash", m(["Z", "tab\there", "Name", "数据"])), "noslash; name*=utf-8''%E6%95%B0%E6%8D%AE; z=\"tab\there\""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("", m(["bad attr", "x;y", "x-y", "a*b"])), ""
  assert_eq format_media_type("/", m(["bad attr", "nl\nx"])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("x/y z", m(["x-y", "a\\b"])), ""
  assert_eq format_media_type("a/", m(["filename", "tab\there"])), ""
  assert_eq format_media_type("multipart/form-data", m(["a", "ok", "bad attr", "a\\b"])), ""
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("noslash", m(["", "{x}", "filename", "a b", "charset", "数据"])), ""
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("/", m(["charset", "'q'"])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("", m(["x-y", "a\"b", "Z", "a b", "Name", "{x}"])), ""
  assert_eq format_media_type("a b/c", m(["filename", "a b"])), ""
  assert_eq format_media_type("a b/c", m(["bad attr", "a b"])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("", m(["", "tab\there", "0", "a b", "Name", "a b"])), ""
  assert_eq format_media_type("multipart/form-data", m(["filename", "x;y", "x-y", "a b"])), "multipart/form-data; filename=\"x;y\"; x-y=\"a b\""
  assert_eq format_media_type("image/svg+xml", m(["x-y", "ok"])), "image/svg+xml; x-y=ok"
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("/", m(["bad attr", "a\"b", "", "a\\b"])), ""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("a b/c", m(["", "{x}", "filename", "x;y"])), ""
  assert_eq format_media_type("image/svg+xml", m(["0", "x;y"])), "image/svg+xml; 0=\"x;y\""
  assert_eq format_media_type("multipart/form-data", m(["filename", "数据", "0", "x;y"])), "multipart/form-data; 0=\"x;y\"; filename*=utf-8''%E6%95%B0%E6%8D%AE"
  assert_eq format_media_type("a b/c", m(["Name", "数据", "charset", "50%"])), ""
  assert_eq format_media_type("a b/c", m(["filename", "a b"])), ""
  assert_eq format_media_type("multipart/form-data", m(["Name", "数据", "a", "{x}"])), "multipart/form-data; name*=utf-8''%E6%95%B0%E6%8D%AE; a={x}"
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("TEXT/Plain", m(["a", "'q'"])), "text/plain; a='q'"
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("image/svg+xml", m(["x-y", "a*b", "0", ""])), "image/svg+xml; 0=\"\"; x-y=a*b"
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("text/html", m(["", "tab\there", "x-y", "a\"b", "charset", "{x}"])), ""
  assert_eq format_media_type("a b/c", m(["Z", "a b"])), ""
  assert_eq format_media_type("/", m(["Name", "a\\b", "a", "a*b", "bad attr", "'q'"])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("image/svg+xml", m(["a", "", "x-y", "a b", "filename", "utf-8"])), "image/svg+xml; a=\"\"; filename=utf-8; x-y=\"a b\""
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("x/y z", m(["x-y", "'q'", "filename", "tab\there"])), ""
  assert_eq format_media_type("multipart/form-data", m(["Z", "x;y", "Name", "50%", "filename", "a\\b"])), "multipart/form-data; name=50%; z=\"x;y\"; filename=\"a\\\\b\""
  assert_eq format_media_type("TEXT/Plain", m(["0", "a\"b"])), "text/plain; 0=\"a\\\"b\""
  assert_eq format_media_type("x/y z", m(["Name", "'q'", "", "a*b"])), ""
  assert_eq format_media_type("", m(["Z", "ok", "a", "nl\nx", "filename", "'q'"])), ""
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("", m(["Name", "a*b"])), ""
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("a/", m(["charset", "a*b", "x-y", "'q'", "", "nl\nx"])), ""
  assert_eq format_media_type("a b/c", m(["x-y", "数据", "filename", "é", "0", "a*b"])), ""
  assert_eq format_media_type("a b/c", m(["Z", "a\\b"])), ""
  assert_eq format_media_type("noslash", m(["a", "a b"])), "noslash; a=\"a b\""
  assert_eq format_media_type("multipart/form-data", m(["Name", "{x}", "0", "", "charset", "'q'"])), "multipart/form-data; 0=\"\"; name={x}; charset='q'"
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("image/svg+xml", m(["charset", "", "0", "{x}", "filename", "50%"])), "image/svg+xml; 0={x}; charset=\"\"; filename=50%"
  assert_eq format_media_type("noslash", m(["bad attr", "nl\nx", "Z", "a*b"])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("a/", m(["a", "a\"b", "x-y", "a b"])), ""
  assert_eq format_media_type("multipart/form-data", m(["a", "'q'"])), "multipart/form-data; a='q'"
  assert_eq format_media_type("a/", m(["Z", "utf-8", "0", "a\\b"])), ""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("a b/c", m([])), ""
}

test "vectors: format media type 3" {
  assert_eq format_media_type("TEXT/Plain", m(["filename", "", "", "数据"])), ""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("multipart/form-data", m(["bad attr", "ok", "filename", "é", "", "ok"])), ""
  assert_eq format_media_type("noslash", m(["Z", "x;y", "0", ""])), "noslash; 0=\"\"; z=\"x;y\""
  assert_eq format_media_type("multipart/form-data", m(["Name", "a\"b", "", "{x}", "x-y", "utf-8"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["charset", "50%", "Z", "ok"])), "text/plain; z=ok; charset=50%"
  assert_eq format_media_type("/", m(["charset", "", "x-y", "{x}", "0", "数据"])), ""
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("text/html", m(["Z", "a\"b", "filename", "50%", "a", "utf-8"])), "text/html; z=\"a\\\"b\"; a=utf-8; filename=50%"
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("/", m(["bad attr", "a\"b"])), ""
  assert_eq format_media_type("multipart/form-data", m(["filename", "'q'", "charset", "a*b"])), "multipart/form-data; charset=a*b; filename='q'"
  assert_eq format_media_type("x/y z", m(["Z", "x;y", "0", "utf-8", "charset", "ok"])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("/", m(["bad attr", "50%", "filename", "a\"b"])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("multipart/form-data", m(["charset", "utf-8"])), "multipart/form-data; charset=utf-8"
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("image/svg+xml", m(["filename", "", "bad attr", "'q'"])), ""
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("multipart/form-data", m(["x-y", "é"])), "multipart/form-data; x-y*=utf-8''%C3%A9"
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("text/html", m(["x-y", "nl\nx"])), "text/html; x-y*=utf-8''nl%0Ax"
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("", m(["Name", "ok"])), ""
  assert_eq format_media_type("multipart/form-data", m(["x-y", "50%", "charset", "a*b", "filename", ""])), "multipart/form-data; charset=a*b; filename=\"\"; x-y=50%"
  assert_eq format_media_type("TEXT/Plain", m(["charset", "nl\nx", "Z", "a*b", "0", "a*b"])), "text/plain; 0=a*b; z=a*b; charset*=utf-8''nl%0Ax"
  assert_eq format_media_type("multipart/form-data", m(["filename", "é"])), "multipart/form-data; filename*=utf-8''%C3%A9"
  assert_eq format_media_type("x/y z", m(["", "nl\nx"])), ""
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("image/svg+xml", m(["filename", "'q'"])), "image/svg+xml; filename='q'"
  assert_eq format_media_type("x/y z", m(["x-y", "utf-8", "Z", "a b"])), ""
  assert_eq format_media_type("text/html", m(["filename", ""])), "text/html; filename=\"\""
  assert_eq format_media_type("a b/c", m(["x-y", "'q'", "charset", "é"])), ""
  assert_eq format_media_type("image/svg+xml", m(["0", "tab\there"])), "image/svg+xml; 0=\"tab\there\""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("noslash", m(["charset", "tab\there"])), "noslash; charset=\"tab\there\""
  assert_eq format_media_type("x/y z", m(["filename", "a*b"])), ""
  assert_eq format_media_type("noslash", m(["filename", "tab\there", "Name", "50%"])), "noslash; name=50%; filename=\"tab\there\""
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("text/html", m(["Name", "a b", "", "a b"])), ""
  assert_eq format_media_type("", m(["bad attr", "a*b", "x-y", "ok"])), ""
  assert_eq format_media_type("image/svg+xml", m(["Name", "a b", "filename", "'q'", "bad attr", "a b"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["filename", "a*b", "Name", "utf-8"])), "text/plain; name=utf-8; filename=a*b"
  assert_eq format_media_type("TEXT/Plain", m(["bad attr", "", "x-y", "'q'"])), ""
  assert_eq format_media_type("a/", m(["", "'q'", "x-y", "a\\b", "charset", "é"])), ""
  assert_eq format_media_type("a/", m(["x-y", "nl\nx"])), ""
  assert_eq format_media_type("multipart/form-data", m(["a", "é"])), "multipart/form-data; a*=utf-8''%C3%A9"
  assert_eq format_media_type("a/", m(["a", "ok"])), ""
  assert_eq format_media_type("a b/c", m(["x-y", "a\\b", "bad attr", "'q'"])), ""
  assert_eq format_media_type("a/", m(["x-y", "a b", "0", "'q'", "Name", "é"])), ""
  assert_eq format_media_type("noslash", m(["filename", "utf-8"])), "noslash; filename=utf-8"
  assert_eq format_media_type("x/y z", m(["Name", "", "Z", "a\"b"])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("TEXT/Plain", m(["a", "{x}"])), "text/plain; a={x}"
  assert_eq format_media_type("TEXT/Plain", m(["", "a\\b", "charset", "tab\there"])), ""
  assert_eq format_media_type("text/html", m(["Name", "'q'", "", "ok"])), ""
  assert_eq format_media_type("image/svg+xml", m(["x-y", ""])), "image/svg+xml; x-y=\"\""
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("x/y z", m(["charset", "a\"b"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("a/", m(["", "é", "charset", "{x}"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["charset", "a\"b", "bad attr", "a\"b"])), ""
  assert_eq format_media_type("x/y z", m(["bad attr", "{x}", "Name", "'q'"])), ""
  assert_eq format_media_type("a/", m(["x-y", "a b"])), ""
  assert_eq format_media_type("", m(["", "a*b", "Z", "ok", "a", "a\"b"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["filename", "nl\nx", "Name", "é", "Z", "a*b"])), "text/plain; name*=utf-8''%C3%A9; z=a*b; filename*=utf-8''nl%0Ax"
  assert_eq format_media_type("a/", m(["bad attr", "a\"b", "charset", "a\\b"])), ""
  assert_eq format_media_type("/", m(["charset", "a*b", "a", "a b", "Z", "ok"])), ""
  assert_eq format_media_type("text/html", m(["Name", "50%", "0", "tab\there", "x-y", "x;y"])), "text/html; 0=\"tab\there\"; name=50%; x-y=\"x;y\""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("a b/c", m(["charset", "数据", "", "a b"])), ""
  assert_eq format_media_type("/", m(["", "é"])), ""
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("a b/c", m(["0", "x;y"])), ""
  assert_eq format_media_type("a b/c", m(["0", "tab\there"])), ""
  assert_eq format_media_type("noslash", m(["x-y", "a\\b"])), "noslash; x-y=\"a\\\\b\""
  assert_eq format_media_type("a/", m(["0", "a*b"])), ""
  assert_eq format_media_type("multipart/form-data", m(["bad attr", "数据"])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("a/", m(["Z", "é"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["0", "x;y"])), "text/plain; 0=\"x;y\""
  assert_eq format_media_type("a/", m(["charset", "tab\there", "a", "tab\there", "", "50%"])), ""
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("image/svg+xml", m(["0", "x;y", "Z", ""])), "image/svg+xml; 0=\"x;y\"; z=\"\""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("/", m(["x-y", "数据", "a", "{x}"])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
}

test "vectors: format media type 4" {
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("TEXT/Plain", m(["0", "a\\b", "x-y", "a*b", "Name", "tab\there"])), "text/plain; 0=\"a\\\\b\"; name=\"tab\there\"; x-y=a*b"
  assert_eq format_media_type("a b/c", m(["charset", "a*b", "", "ok", "x-y", "nl\nx"])), ""
  assert_eq format_media_type("/", m(["bad attr", "utf-8", "filename", "{x}"])), ""
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("a b/c", m(["", "nl\nx"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["Name", "a b", "", ""])), ""
  assert_eq format_media_type("", m(["x-y", "ok"])), ""
  assert_eq format_media_type("/", m(["0", "ok"])), ""
  assert_eq format_media_type("x/y z", m(["x-y", "a\"b"])), ""
  assert_eq format_media_type("", m(["", "nl\nx"])), ""
  assert_eq format_media_type("image/svg+xml", m(["Name", "a b", "0", "utf-8"])), "image/svg+xml; 0=utf-8; name=\"a b\""
  assert_eq format_media_type("", m(["charset", "tab\there", "filename", "ok"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("x/y z", m(["Z", "utf-8", "a", "a\"b"])), ""
  assert_eq format_media_type("text/html", m(["x-y", "x;y", "", "a\\b"])), ""
  assert_eq format_media_type("/", m(["Name", "a\\b"])), ""
  assert_eq format_media_type("image/svg+xml", m(["0", "a\\b", "charset", "é"])), "image/svg+xml; 0=\"a\\\\b\"; charset*=utf-8''%C3%A9"
  assert_eq format_media_type("a/", m(["0", "ok", "bad attr", "数据"])), ""
  assert_eq format_media_type("/", m(["0", "ok"])), ""
  assert_eq format_media_type("a/", m(["a", "a\\b", "0", "'q'"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["x-y", "{x}", "bad attr", "{x}", "filename", "'q'"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("a b/c", m(["charset", "a\"b", "filename", "a\"b", "a", "50%"])), ""
  assert_eq format_media_type("image/svg+xml", m(["", "utf-8", "Z", "50%", "filename", "ok"])), ""
  assert_eq format_media_type("image/svg+xml", m(["filename", "ok", "Z", "50%"])), "image/svg+xml; z=50%; filename=ok"
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("", m(["x-y", "x;y"])), ""
  assert_eq format_media_type("", m(["Z", "数据"])), ""
  assert_eq format_media_type("noslash", m(["bad attr", "", "", "", "x-y", ""])), ""
  assert_eq format_media_type("noslash", m(["bad attr", "a\\b"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["a", "数据", "Name", "数据", "filename", "a\\b"])), "text/plain; name*=utf-8''%E6%95%B0%E6%8D%AE; a*=utf-8''%E6%95%B0%E6%8D%AE; filename=\"a\\\\b\""
  assert_eq format_media_type("image/svg+xml", m(["0", "", "Z", "ok"])), "image/svg+xml; 0=\"\"; z=ok"
  assert_eq format_media_type("multipart/form-data", m(["Z", "utf-8", "Name", "a\\b", "charset", "tab\there"])), "multipart/form-data; name=\"a\\\\b\"; z=utf-8; charset=\"tab\there\""
  assert_eq format_media_type("text/html", m(["a", "a\"b", "filename", "x;y"])), "text/html; a=\"a\\\"b\"; filename=\"x;y\""
  assert_eq format_media_type("a b/c", m(["charset", "nl\nx", "", "50%"])), ""
  assert_eq format_media_type("text/html", m(["charset", "", "a", "nl\nx", "bad attr", "'q'"])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("text/html", m(["0", "", "filename", "a b"])), "text/html; 0=\"\"; filename=\"a b\""
  assert_eq format_media_type("text/html", m(["bad attr", "{x}", "filename", "nl\nx", "Name", "a\\b"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["Z", "", "0", "a b", "x-y", ""])), "text/plain; 0=\"a b\"; z=\"\"; x-y=\"\""
  assert_eq format_media_type("noslash", m(["Name", "{x}", "charset", "数据"])), "noslash; name={x}; charset*=utf-8''%E6%95%B0%E6%8D%AE"
  assert_eq format_media_type("/", m(["bad attr", "é"])), ""
  assert_eq format_media_type("text/html", m(["a", "'q'", "", ""])), ""
  assert_eq format_media_type("x/y z", m(["a", "数据", "Name", "{x}"])), ""
  assert_eq format_media_type("text/html", m(["a", "nl\nx", "charset", "nl\nx"])), "text/html; a*=utf-8''nl%0Ax; charset*=utf-8''nl%0Ax"
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("multipart/form-data", m(["filename", "é", "0", "数据"])), "multipart/form-data; 0*=utf-8''%E6%95%B0%E6%8D%AE; filename*=utf-8''%C3%A9"
  assert_eq format_media_type("x/y z", m(["0", "'q'"])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("a/", m(["Z", "a*b", "0", "ok"])), ""
  assert_eq format_media_type("x/y z", m(["", "数据", "charset", "utf-8", "filename", "tab\there"])), ""
  assert_eq format_media_type("text/html", m(["Name", "é", "x-y", "x;y"])), "text/html; name*=utf-8''%C3%A9; x-y=\"x;y\""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("TEXT/Plain", m(["Name", "", "x-y", "a\\b"])), "text/plain; name=\"\"; x-y=\"a\\\\b\""
  assert_eq format_media_type("a b/c", m(["x-y", "a b"])), ""
  assert_eq format_media_type("x/y z", m(["filename", "nl\nx", "bad attr", "utf-8", "", "x;y"])), ""
  assert_eq format_media_type("/", m(["Z", "a\\b"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["", "x;y", "0", "'q'", "Z", "{x}"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["bad attr", "a\"b", "a", "50%"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["a", "nl\nx", "charset", "{x}"])), "text/plain; a*=utf-8''nl%0Ax; charset={x}"
  assert_eq format_media_type("multipart/form-data", m(["bad attr", "a*b"])), ""
  assert_eq format_media_type("x/y z", m(["Z", "ok", "Name", "tab\there"])), ""
  assert_eq format_media_type("x/y z", m(["bad attr", "", "", "ok"])), ""
  assert_eq format_media_type("a/", m(["Name", "a\\b"])), ""
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("text/html", m(["bad attr", "a\\b"])), ""
  assert_eq format_media_type("", m(["", "{x}"])), ""
  assert_eq format_media_type("text/html", m(["x-y", "a*b"])), "text/html; x-y=a*b"
  assert_eq format_media_type("", m(["charset", "utf-8", "Z", "ok", "filename", "{x}"])), ""
  assert_eq format_media_type("x/y z", m(["filename", "a*b", "Z", "a\"b", "charset", "utf-8"])), ""
  assert_eq format_media_type("image/svg+xml", m(["bad attr", ""])), ""
  assert_eq format_media_type("image/svg+xml", m(["filename", "50%"])), "image/svg+xml; filename=50%"
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("multipart/form-data", m(["Z", ""])), "multipart/form-data; z=\"\""
  assert_eq format_media_type("", m(["", "数据", "Z", "a\\b", "charset", ""])), ""
  assert_eq format_media_type("text/html", m(["Z", "'q'", "filename", "数据"])), "text/html; z='q'; filename*=utf-8''%E6%95%B0%E6%8D%AE"
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("noslash", m(["charset", "a b", "x-y", "utf-8"])), "noslash; charset=\"a b\"; x-y=utf-8"
  assert_eq format_media_type("x/y z", m(["", ""])), ""
  assert_eq format_media_type("multipart/form-data", m(["Z", "", "charset", "a\"b"])), "multipart/form-data; z=\"\"; charset=\"a\\\"b\""
  assert_eq format_media_type("a/", m(["0", "a\"b"])), ""
  assert_eq format_media_type("text/html", m(["Z", "数据", "Name", "a\"b"])), "text/html; name=\"a\\\"b\"; z*=utf-8''%E6%95%B0%E6%8D%AE"
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("TEXT/Plain", m(["a", "'q'"])), "text/plain; a='q'"
  assert_eq format_media_type("", m(["Name", "'q'", "", "'q'"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("/", m(["charset", "a\\b", "a", "nl\nx", "0", "ok"])), ""
  assert_eq format_media_type("a/", m(["Z", "'q'"])), ""
  assert_eq format_media_type("/", m(["Z", "a\\b", "a", "é"])), ""
  assert_eq format_media_type("x/y z", m(["a", "nl\nx"])), ""
  assert_eq format_media_type("a/", m(["a", "数据", "Z", "'q'"])), ""
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("multipart/form-data", m(["0", "nl\nx"])), "multipart/form-data; 0*=utf-8''nl%0Ax"
}

test "vectors: format media type 5" {
  assert_eq format_media_type("", m(["0", "x;y", "filename", "a\\b", "", "数据"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["bad attr", "x;y", "charset", "utf-8", "", "ok"])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("TEXT/Plain", m(["x-y", "utf-8", "filename", "ok"])), "text/plain; filename=ok; x-y=utf-8"
  assert_eq format_media_type("a/", m(["0", "50%"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["0", "tab\there"])), "text/plain; 0=\"tab\there\""
  assert_eq format_media_type("a b/c", m(["x-y", "tab\there", "0", "50%"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["Z", "é", "a", "a b"])), "text/plain; z*=utf-8''%C3%A9; a=\"a b\""
  assert_eq format_media_type("text/html", m(["charset", "tab\there", "0", "nl\nx"])), "text/html; 0*=utf-8''nl%0Ax; charset=\"tab\there\""
  assert_eq format_media_type("TEXT/Plain", m(["Name", "50%", "charset", "x;y", "x-y", ""])), "text/plain; name=50%; charset=\"x;y\"; x-y=\"\""
  assert_eq format_media_type("a/", m(["bad attr", "", "charset", "a*b", "Z", "nl\nx"])), ""
  assert_eq format_media_type("noslash", m(["filename", "é"])), "noslash; filename*=utf-8''%C3%A9"
  assert_eq format_media_type("", m(["Name", "é"])), ""
  assert_eq format_media_type("x/y z", m(["bad attr", "50%"])), ""
  assert_eq format_media_type("text/html", m(["Z", "tab\there", "", "tab\there"])), ""
  assert_eq format_media_type("TEXT/Plain", m([])), "text/plain"
  assert_eq format_media_type("TEXT/Plain", m(["bad attr", "a*b"])), ""
  assert_eq format_media_type("text/html", m(["filename", "utf-8", "bad attr", "x;y"])), ""
  assert_eq format_media_type("a b/c", m(["bad attr", "é", "Z", "é", "x-y", "'q'"])), ""
  assert_eq format_media_type("noslash", m(["charset", "{x}"])), "noslash; charset={x}"
  assert_eq format_media_type("a/", m(["charset", "utf-8"])), ""
  assert_eq format_media_type("a/", m(["", "数据"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("x/y z", m(["Name", "tab\there", "charset", "50%"])), ""
  assert_eq format_media_type("image/svg+xml", m(["filename", "a*b"])), "image/svg+xml; filename=a*b"
  assert_eq format_media_type("a b/c", m(["filename", "{x}", "Name", ""])), ""
  assert_eq format_media_type("TEXT/Plain", m(["0", "utf-8"])), "text/plain; 0=utf-8"
  assert_eq format_media_type("a b/c", m(["x-y", "'q'", "Name", "utf-8"])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("multipart/form-data", m(["charset", "{x}", "", "a*b", "bad attr", "50%"])), ""
  assert_eq format_media_type("multipart/form-data", m(["bad attr", "数据", "Z", ""])), ""
  assert_eq format_media_type("image/svg+xml", m(["Name", "utf-8", "a", "数据"])), "image/svg+xml; name=utf-8; a*=utf-8''%E6%95%B0%E6%8D%AE"
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("multipart/form-data", m(["x-y", "'q'", "bad attr", "a b"])), ""
  assert_eq format_media_type("/", m(["charset", "数据"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("multipart/form-data", m(["filename", "é", "bad attr", "tab\there", "charset", "ok"])), ""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("a/", m(["0", "a\"b", "charset", "50%"])), ""
  assert_eq format_media_type("", m([])), ""
  assert_eq format_media_type("a/", m(["x-y", "é", "filename", "x;y", "Name", "a b"])), ""
  assert_eq format_media_type("a/", m(["filename", "a b"])), ""
  assert_eq format_media_type("x/y z", m(["a", "a\\b", "bad attr", "a\"b"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("TEXT/Plain", m(["filename", "é", "Z", "tab\there", "bad attr", "数据"])), ""
  assert_eq format_media_type("text/html", m([])), "text/html"
  assert_eq format_media_type("/", m(["Z", "a\"b"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["0", "数据", "filename", "a\\b"])), "text/plain; 0*=utf-8''%E6%95%B0%E6%8D%AE; filename=\"a\\\\b\""
  assert_eq format_media_type("text/html", m(["filename", "{x}", "", "é"])), ""
  assert_eq format_media_type("image/svg+xml", m(["Z", "a b"])), "image/svg+xml; z=\"a b\""
  assert_eq format_media_type("image/svg+xml", m(["", "ok"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["", "nl\nx", "bad attr", "utf-8"])), ""
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("multipart/form-data", m(["x-y", "x;y"])), "multipart/form-data; x-y=\"x;y\""
  assert_eq format_media_type("image/svg+xml", m(["Z", "x;y"])), "image/svg+xml; z=\"x;y\""
  assert_eq format_media_type("text/html", m(["0", "x;y", "Z", "", "", "50%"])), ""
  assert_eq format_media_type("x/y z", m(["x-y", "", "", "utf-8"])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("", m(["bad attr", "nl\nx", "", "é"])), ""
  assert_eq format_media_type("multipart/form-data", m(["Z", "", "x-y", "a\\b"])), "multipart/form-data; z=\"\"; x-y=\"a\\\\b\""
  assert_eq format_media_type("a/", m([])), ""
  assert_eq format_media_type("image/svg+xml", m(["bad attr", "a\"b", "Z", "ok", "x-y", "a b"])), ""
  assert_eq format_media_type("multipart/form-data", m(["filename", "a b"])), "multipart/form-data; filename=\"a b\""
  assert_eq format_media_type("multipart/form-data", m(["Name", "a\"b", "charset", "é"])), "multipart/form-data; name=\"a\\\"b\"; charset*=utf-8''%C3%A9"
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("multipart/form-data", m(["a", "{x}", "filename", "", "", "{x}"])), ""
  assert_eq format_media_type("x/y z", m(["0", "utf-8"])), ""
  assert_eq format_media_type("x/y z", m(["Name", "a b", "0", "50%", "filename", "a\"b"])), ""
  assert_eq format_media_type("text/html", m(["a", "x;y"])), "text/html; a=\"x;y\""
  assert_eq format_media_type("text/html", m(["Name", "x;y", "bad attr", "utf-8", "charset", "nl\nx"])), ""
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("text/html", m(["x-y", "a b"])), "text/html; x-y=\"a b\""
  assert_eq format_media_type("", m(["charset", "{x}"])), ""
  assert_eq format_media_type("TEXT/Plain", m(["Name", "a\\b", "Z", "x;y"])), "text/plain; name=\"a\\\\b\"; z=\"x;y\""
  assert_eq format_media_type("/", m(["", "a*b", "bad attr", "{x}", "a", "ok"])), ""
  assert_eq format_media_type("noslash", m([])), "noslash"
  assert_eq format_media_type("x/y z", m(["Name", "ok", "Z", ""])), ""
  assert_eq format_media_type("x/y z", m(["bad attr", "é", "x-y", "é"])), ""
  assert_eq format_media_type("multipart/form-data", m(["charset", "ok"])), "multipart/form-data; charset=ok"
  assert_eq format_media_type("multipart/form-data", m(["", "ok", "a", "'q'"])), ""
  assert_eq format_media_type("a b/c", m(["Z", "utf-8", "x-y", "50%", "Name", "a\"b"])), ""
  assert_eq format_media_type("multipart/form-data", m([])), "multipart/form-data"
  assert_eq format_media_type("a b/c", m([])), ""
  assert_eq format_media_type("a b/c", m(["Name", "utf-8"])), ""
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("TEXT/Plain", m(["a", "a\"b", "bad attr", "x;y", "x-y", "数据"])), ""
  assert_eq format_media_type("x/y z", m(["", "a*b"])), ""
  assert_eq format_media_type("noslash", m(["bad attr", "a\"b", "a", "'q'"])), ""
  assert_eq format_media_type("/", m(["", "ok"])), ""
  assert_eq format_media_type("x/y z", m([])), ""
  assert_eq format_media_type("text/html", m(["0", "'q'", "bad attr", "a\"b", "charset", ""])), ""
  assert_eq format_media_type("text/html", m(["filename", "x;y", "charset", "a\"b"])), "text/html; charset=\"a\\\"b\"; filename=\"x;y\""
  assert_eq format_media_type("a b/c", m(["charset", "", "filename", "utf-8", "bad attr", "ok"])), ""
  assert_eq format_media_type("", m(["bad attr", "utf-8", "charset", "utf-8", "x-y", "utf-8"])), ""
  assert_eq format_media_type("text/html", m(["charset", "50%", "", "nl\nx"])), ""
  assert_eq format_media_type("image/svg+xml", m([])), "image/svg+xml"
  assert_eq format_media_type("multipart/form-data", m(["x-y", "50%"])), "multipart/form-data; x-y=50%"
  assert_eq format_media_type("/", m([])), ""
  assert_eq format_media_type("", m(["bad attr", "tab\there", "0", "a b"])), ""
}

test "vectors: word encoder" {
  assert_eq WordEncoder.BEncoding.encode("iso-8859-1", hx("48656c6c6f48656c6c6f3d3f215a3f48656c6c6f805f216109c3a90948656c6c6f21e282ac2109e282ace9e282ace9093fe282ac48656c6c6fe95fe282acf09d849e7e0161622120615f09")), "=?iso-8859-1?b?SGVsbG9IZWxsbz0/IVo/SGVsbG+AXyFhCcOpCUhlbGxvIeKCrCEJ4oKs6eKCrOkJP+KCrEhlbGxv6V/igqzwnYSefgFhYiEgYV8J?="
