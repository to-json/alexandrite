  assert_eq pmt("*1charset'html%zz"), "*1charset'html%zz"
  assert_eq pmt("a/b; Title*= ''a ; x= b!.!; Title*2= a_~."), "a/b|x=b!.!"
  assert_eq pmt("attachment;"), "attachment"
  assert_eq pmt("%2;Plainnameutf-8TEXTfoo %2*=%2x; "), "ERR mime: invalid media parameter|%2"
  assert_eq pmt("a/b ; x=bb!"), "a/b|x=bb!"
  assert_eq pmt("form-data;charset*=\"\\\"%41%41é \" ; x*0 =\"aé %41\" ; x=-ba"), "form-data|x=aé %41"
