  assert_eq pmt("TEXT,; TEXT\\foo@\\\\@; "), "ERR mime: expected slash after first token"
  assert_eq pmt("attachment"), "attachment"
  assert_eq pmt("a/b;x*2*= ~b-1"), "a/b"
  assert_eq pmt(";é\t'"), "ERR mime: no media type"
