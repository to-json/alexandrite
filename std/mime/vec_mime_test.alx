# Generated from Go's mime (go run, Go 1.27): media types, extensions and encoded-words; do not edit by hand.

test "vectors: parse media type" {
  assert_eq pmt("*0*us-ascii'en'us-ascii'en''TEXT\""), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("attachment ; filename*2 =~.1-!_"), "attachment"
  assert_eq pmt("/us-ascii'en'%zzus-ascii'en'\tcharset*1"), "ERR mime: no media type"
  assert_eq pmt("a/b;Title =\" \\\\éa\""), "a/b|title= \\éa"
  assert_eq pmt("a/b; filename*=1~ba!b"), "a/b"
  assert_eq pmt("html\"a b\"htmlfoo'\t'é**1%zz"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data;x*1=~-_a ; x*0=\"\\\\\";Title*1*= b1_"), "form-data|x=\\~-_a"
  assert_eq pmt("text/plain ; Title=_1;Title= utf-8''%aaa;charset*1= _1"), "ERR mime: duplicate parameter name"
  assert_eq pmt("%zz/\t\t\\{}\t%zzfoo"), "ERR mime: expected token after slash"
  assert_eq pmt("application/x-stuff; boundary*2*=\"\\\"\";boundary =1a"), "application/x-stuff|boundary=1a"
  assert_eq pmt("attachment; filename*2=\"\\\\a%41\\\\%41\"; boundary =~!__1;Title*2=1!bab"), "attachment|boundary=~!__1"
  assert_eq pmt("*1charset foo*0; {}TEXT\"a b\"\\htmlTEXT"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data; name*1= _; charset=''"), "form-data|charset=''"
  assert_eq pmt("application/x-stuff ; x*2*= utf-8''b%4 ; charset*1*= -!- x"), "ERR mime: invalid media parameter|application/x-stuff"
  assert_eq pmt("Plaintext\"a b\"text*1utf-8\"\\\"*= ;\";"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff; boundary=~!_; x =utf-8''% ; Title*0 =utf-8'"), "application/x-stuff|boundary=~!_|title=utf-8'|x=utf-8''%"
  assert_eq pmt("attachment ; Title*= !a.aa~ ; boundary*2= ba~.b;name= \"\""), "attachment|name="
  assert_eq pmt("utf-8''footext\r\n\t\\\"*0*name"), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("application/x-stuff ; x= !1a!_"), "application/x-stuff|x=!1a!_"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff ; x= -!b-_-;charset=b!b~"), "application/x-stuff|charset=b!b~|x=-!b-_-"
  assert_eq pmt("attachment; Title=\"a;\"; x=."), "attachment|title=a;|x=."
  assert_eq pmt("Plain@%2\"a b\"\r\nhtml; "), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed; boundary =US-ASCII'en'%41"), "multipart/mixed|boundary=US-ASCII'en'%41"
  assert_eq pmt("a/b ; charset= !b.._1;name* =_; Title*0= ~1~1~"), "a/b|charset=!b.._1|title=~1~1~"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("a/b;charset=~.a._;boundary* =\"\\\\\" ; charset*2 =-a"), "a/b|charset=~.a._"
  assert_eq pmt("a/b; boundary*2* =utf-8''%c3%a4; boundary*1*=ab11~!; x= \"a\\\\x%41\""), "a/b|x=a\\x%41"
  assert_eq pmt("é/\t "), "ERR mime: no media type"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("Multipart/Mixed ; filename= ."), "multipart/mixed|filename=."
  assert_eq pmt("*0**=charset'utf-8''"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff;x=_;x*=-b!1- ; filename =b"), "application/x-stuff|filename=b|x=_"
  assert_eq pmt("attachment;Title= b.!.."), "attachment|title=b.!.."
  assert_eq pmt(",*/\"utf-8,fooxutf-8''htmlfoo"), "ERR mime: no media type"
  assert_eq pmt("form-data; x =\"\\\"  \\\" \""), "form-data|x=\"  \" "
  assert_eq pmt("form-data;boundary*= US-ASCII'en'%; charset =\"\\\"   \\\\\""), "form-data|charset=\"   \\"
  assert_eq pmt("%41 TEXT; Plainutf-8TEXT*1\\\"us-ascii'en'{}"), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed ; filename*0*=\"\\\"%41a%41\\\"\"; ="), "ERR mime: invalid media parameter|multipart/mixed"
  assert_eq pmt("text/plain ; charset*2*=.~"), "text/plain"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("text/plain ; charset= -.!~"), "text/plain|charset=-.!~"
  assert_eq pmt("a/b; name =1."), "a/b|name=1."
  assert_eq pmt(";'',name=\r\n=html\"Plain{}*1"), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff ; Title*0= \"\\\\a\\\\;\"; boundary* =.; Title=''ba%c3%a4"), "application/x-stuff|title=\\a\\;"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("\r\n*0*éfoo/text%zz \\\""), "ERR mime: expected slash after first token"
  assert_eq pmt("text/plain;"), "text/plain"
  assert_eq pmt("form-data ; filename*2= 1bb!_~ ; name =~;name= b~~_"), "ERR mime: duplicate parameter name"
  assert_eq pmt("TEXTutf-8''text"), "textutf-8''text"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("text/plain ; x*0= .--b ; filename* =utf-8'%; x*1=utf-8'aa%4"), "text/plain|x=.--butf-8'aa%4"
  assert_eq pmt("; utf-8/"), "ERR mime: no media type"
  assert_eq pmt("text/plain; boundary= \";é%41\\\"\\\\\"; filename* =\"a%41 x\""), "text/plain|boundary=;é%41\"\\"
  assert_eq pmt("text/plain ; boundary=abb;x*2=_b-1; name=\"\\\"%41\"\""), "ERR mime: invalid media parameter|text/plain"
  assert_eq pmt(",\t{}%zzhtml"), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed; x=1.b_"), "multipart/mixed|x=1.b_"
  assert_eq pmt("attachment;Title*= utf-8''%;Title=-b-.1; filename*0=!.-~~b"), "attachment|filename=!.-~~b|title=-b-.1"
  assert_eq pmt("\"\\\\; \t\t\thtml{}name"), "ERR mime: no media type"
  assert_eq pmt("attachment;x* =a.~a;x=!~b~__"), "attachment|x=!~b~__"
  assert_eq pmt("text/plain; ="), "ERR mime: invalid media parameter|text/plain"
  assert_eq pmt("x"), "x"
  assert_eq pmt("attachment;x*= .~ ;"), "attachment"
  assert_eq pmt("text/plain; Title=1!_b;x =."), "text/plain|title=1!_b|x=."
  assert_eq pmt(" ; **0*Plaincharset*=Plain*1xTEXTus-ascii'en'"), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff;Title =\"é\""), "application/x-stuff|title=é"
  assert_eq pmt("application/x-stuff; name*= iso-8859-1''%41%a ; charset=''%c3%a4"), "application/x-stuff|charset=''%c3%a4"
  assert_eq pmt("%zzé%2"), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("application/x-stuff;filename =!"), "application/x-stuff|filename=!"
  assert_eq pmt("@é"), "ERR mime: no media type"
  assert_eq pmt("a/b;boundary*2 =~.1"), "a/b"
  assert_eq pmt("a/b;filename=b..1. ; boundary=US-ASCII'en'%4b%;boundary= a!~"), "ERR mime: duplicate parameter name"
  assert_eq pmt("\r\nx'TEXT*0%41"), "x'text*0%41"
  assert_eq pmt("attachment;boundary*0 =\"\\\"%41;\\\\\""), "attachment|boundary=\"%41;\\"
  assert_eq pmt("application/x-stuff ; x*2* =a-1"), "application/x-stuff"
  assert_eq pmt("=\"a b\""), "ERR mime: no media type"
  assert_eq pmt("text/plain ; Title= _b.b ; x =."), "text/plain|title=_b.b|x=."
  assert_eq pmt("attachment; charset*2* =_.! ; boundary*=~!b1_ ; boundary* =~"), "ERR mime: duplicate parameter name"
  assert_eq pmt("\t;%41"), "ERR mime: no media type"
  assert_eq pmt("a/b;name=1~;Title*1=!. ; boundary*1= \"%41\""), "a/b|name=1~"
  assert_eq pmt("a/b; charset*1= _ ; x =.!~b_"), "a/b|x=.!~b_"
  assert_eq pmt("TEXT,foo"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data ; Title= b-!!_.; name= utf-8'"), "form-data|name=utf-8'|title=b-!!_."
  assert_eq pmt("a/b; Title*0*=-_!1;filename =\"a\\\\%41;\";charset* =.abb-."), "a/b|filename=a\\%41;|title="
  assert_eq pmt("@{}name,%zzhtml/'*=%zz\"a b\""), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed;boundary= 1-_ ; charset*0* =\";%41\"; ="), "ERR mime: invalid media parameter|multipart/mixed"
  assert_eq pmt("form-data; ="), "ERR mime: invalid media parameter|form-data"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("attachment;filename*2*=-- ; Title= _~"), "attachment|title=_~"
