  assert_eq pmt("form-data;name*= a x"), "ERR mime: invalid media parameter|form-data"
  assert_eq pmt("a/b ; x =utf-8''b%c3%a4%;Title*2= iso-8859-1''%c3%a4b ; x* =~~aa!a"), "a/b|x=utf-8''b%c3%a4%"
