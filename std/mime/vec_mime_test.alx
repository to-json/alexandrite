  assert_eq pmt("application/x-stuff; boundary =1..a!_;boundary =US-ASCII'en'% ; boundary* =iso-8859-1''%c3%a4%4%41"), "ERR mime: duplicate parameter name"
  assert_eq pmt(""), "ERR mime: no media type"
