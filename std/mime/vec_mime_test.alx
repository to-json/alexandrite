  assert_eq pmt("form-data ; filename*2*=b; boundary*0 =\"\\\"éa\\\"\"; charset* =\"\\\"\\\"\\\"x \""), "form-data|boundary=\"éa\""
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("é{}utf-8; "), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed;x= utf-8''%4%4%41;Title*= .~_- ; Title* =1"), "ERR mime: duplicate parameter name"
  assert_eq pmt("Multipart/Mixed;x =_;x= aa"), "ERR mime: duplicate parameter name"
  assert_eq pmt("\\;,TEXT{}*utf-8"), "ERR mime: no media type"
  assert_eq pmt("text/plain; Title= \"\\\"\\\\%41\" ; name=_~1.a ; x*= ~aa~a-"), "text/plain|name=_~1.a|title=\"\\%41"
  assert_eq pmt("a/b ; filename =~;boundary*0* =~_a_"), "a/b|boundary=|filename=~"
  assert_eq pmt("; name*=%41=,PlainTEXT"), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("Plain*1TEXTé us-ascii'en'\"%41\\"), "ERR mime: expected slash after first token"
  assert_eq pmt("attachment; Title* =_a1.b; name*=ba."), "attachment"
  assert_eq pmt("a/b ; boundary*0= utf-8''%41"), "a/b|boundary=utf-8''%41"
  assert_eq pmt("\r\n%zz%41@foo*0"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b;filename=.!b ; Title*= _a!"), "a/b|filename=.!b"
  assert_eq pmt("text/plain; charset= 1~a.b- ; name =.; Title=\"%41\\\\;\""), "text/plain|charset=1~a.b-|name=.|title=%41\\;"
  assert_eq pmt("*0,\tus-ascii'en'\\Plain\\\""), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed ; boundary=\"\\\"a\";boundary*2*= b!.~.;"), "multipart/mixed|boundary=\"a"
  assert_eq pmt("form-data;filename*= b_-~!a ; name*1=\"\"; Title=1_.~b"), "form-data|title=1_.~b"
  assert_eq pmt("\r\nPlainus-ascii'en'={};text%zz,utf-8"), "ERR mime: expected slash after first token"
  assert_eq pmt("text/plain ; filename =utf-8''%4%c3%a4%c3%a4;name* =US-ASCII'en'%c3%a4a%41%4"), "text/plain|filename=utf-8''%4%c3%a4%c3%a4"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("\"a b\"=text\r\nTEXT"), "ERR mime: no media type"
  assert_eq pmt("a/b;boundary* =utf-8''b%c3%a4b; charset*2 =!!1; charset= utf-8''"), "a/b|boundary=bäb|charset=utf-8''"
  assert_eq pmt("attachment ; name*2*=!.a!b"), "attachment"
  assert_eq pmt("foohtml*='é\"a b\"%zz@\r\n"), "ERR mime: expected slash after first token"
  assert_eq pmt("text/plain; charset=_; x*2 =\"é\";filename= a"), "text/plain|charset=_|filename=a"
  assert_eq pmt("Multipart/Mixed;name*2 =a; filename*2*=_"), "multipart/mixed"
  assert_eq pmt("\\"), "ERR mime: no media type"
  assert_eq pmt("text/plain;name =US-ASCII'en'aa%41b;name*=-_!.; boundary*0* =!a~!!a"), "text/plain|boundary=|name=US-ASCII'en'aa%41b"
  assert_eq pmt("attachment"), "attachment"
  assert_eq pmt("namecharset\"/html/\\\"*0*/utf-8''TEXT"), "ERR mime: expected slash after first token"
  assert_eq pmt("text/plain; name*= _!-.~~ x"), "ERR mime: invalid media parameter|text/plain"
