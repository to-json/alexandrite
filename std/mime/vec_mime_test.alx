  assert_eq pmt("texttexté%zz**1*0\r\n\\\"utf-8''\r\n"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff ; charset* =!-b"), "application/x-stuff"
  assert_eq pmt("a/b ; filename= !__!b~ ; Title=US-ASCII'en'"), "a/b|filename=!__!b~|title=US-ASCII'en'"
  assert_eq pmt("name%zz%2utf-8us-ascii'en'{}nameé\\TEXT\t"), "ERR mime: expected slash after first token"
  assert_eq pmt("text/plain;charset*=\"éxé\";filename* =~~!!;charset =\"xa\""), "text/plain|charset=xa"
  assert_eq pmt("attachment; name*2*= ''b; x*0*=-.__"), "attachment|x="
  assert_eq pmt(" \\\"nameutf-8; "), "ERR mime: no media type"
  assert_eq pmt("text/plain ; filename=1b.~!;x*0 =\";\" ;"), "text/plain|filename=1b.~!|x=;"
  assert_eq pmt("Multipart/Mixed; filename*2* =\"a\\\\é x\";name =US-ASCII'en' ; name=!1!"), "ERR mime: duplicate parameter name"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("form-data ; filename*1*= iso-8859-1''; ="), "ERR mime: invalid media parameter|form-data"
  assert_eq pmt("application/x-stuff ; filename =-~"), "application/x-stuff|filename=-~"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("form-data; boundary*0= a.1b-1;boundary*1* =!11"), "form-data|boundary=a.1b-1!11"
  assert_eq pmt("textutf-8"), "textutf-8"
  assert_eq pmt("form-data; boundary =-! ; name= _ ; x*1*= b_"), "form-data|boundary=-!|name=_"
  assert_eq pmt("attachment;Title=-.b"), "attachment|title=-.b"
  assert_eq pmt("us-ascii'en'\t\\*0*\r\n *name*utf-8''utf-8''"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data\""), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b; charset*=\"a;\\\"xa\" ; boundary*0 =11.-~!"), "a/b|boundary=11.-~!"
  assert_eq pmt("*%41\"*=charset; Plain\t{}name{}name"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff; charset*=a-~"), "application/x-stuff"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt(",*0***0**1/\r\nutf-8; ,\r\ntext"), "ERR mime: no media type"
  assert_eq pmt("attachment"), "attachment"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("%41*0*\\\"utf-8''\t%2%2%2 %zz"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff ; boundary=!1.-_"), "application/x-stuff|boundary=!1.-_"
  assert_eq pmt("text/plain ; boundary*1 =! ; x* ='';name* =!-"), "text/plain"
  assert_eq pmt("TEXT*0*{}; \\\"a b\"htmlx\\"), "ERR mime: invalid media parameter|text*0*{}"
  assert_eq pmt("text/plain\""), "ERR mime: unexpected content after media subtype"
  assert_eq pmt("Multipart/Mixed ; x=\";\\\"x\""), "multipart/mixed|x=;\"x"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("attachment ; name*1 =a_b_; name*1* =ab1-"), "attachment"
  assert_eq pmt("text/plain;boundary =\"xéé\"; boundary*= !-_~"), "text/plain|boundary=xéé"
  assert_eq pmt("\\%2*name\\Plainnamename{}*1\t\"a b\"*0*"), "ERR mime: no media type"
  assert_eq pmt("a/b;name*0 =iso-8859-1''%4%c3%a4%c3%a4;filename*0 =\"%41\\\\ax\""), "a/b|filename=%41\\ax|name=iso-8859-1''%4%c3%a4%c3%a4"
  assert_eq pmt("form-data; charset= b.~.!b"), "form-data|charset=b.~.!b"
  assert_eq pmt("%zz*==*0*"), "ERR mime: expected slash after first token"
}

test "vectors: parse media type 7" {
  assert_eq pmt("Multipart/Mixed; boundary*1*= \"a\\\"\"; name= utf-8''"), "multipart/mixed|name=utf-8''"
