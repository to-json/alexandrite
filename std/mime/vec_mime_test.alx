  assert_eq pmt(",x;us-ascii'en'charset*0*é*,"), "ERR mime: no media type"
  assert_eq pmt("form-data ; boundary*2*= _~; filename*=\"éa;xa\" x"), "ERR mime: invalid media parameter|form-data"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("\"%zz\\\"\"\r\n xutf-8"), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("form-data; filename*0* =\"%41\""), "form-data|filename="
  assert_eq pmt("%zzPlainfoo%2htmlname charsetcharset%2\""), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b; x=_!_bb;x*2*=\"\\\"x\";charset=_1b~~"), "a/b|charset=_1b~~|x=_!_bb"
  assert_eq pmt("Multipart/Mixed; name=~;Title= .-b"), "multipart/mixed|name=~|title=.-b"
  assert_eq pmt("/charset"), "ERR mime: no media type"
  assert_eq pmt("attachment ; name*2* =_!a1b!"), "attachment"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("*0%2\"=*0"), "ERR mime: expected slash after first token"
  assert_eq pmt("text/plain; charset=-1 ; x*2*=!1~1b.; x= _.b x"), "ERR mime: invalid media parameter|text/plain"
  assert_eq pmt("form-data;Title*1*= iso-8859-1''%b%4%4 ; name*= -ab1.- ; charset*0=\" x\\\"\""), "form-data|charset= x\""
  assert_eq pmt(",xutf-8''name\\ html\r\n,%zz"), "ERR mime: no media type"
  assert_eq pmt("attachment;x=1b;x='' ; charset=\";;\\\\é\""), "ERR mime: duplicate parameter name"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("TEXT"), "text"
  assert_eq pmt("a/b; name*0* =~\""), "ERR mime: invalid media parameter|a/b"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("%2utf-8''%2utf-8"), "%2utf-8''%2utf-8"
  assert_eq pmt("application/x-stuff; charset =\" é\""), "application/x-stuff|charset= é"
  assert_eq pmt("text/plain; charset*=-a!b!a;name*=1~~~ ; name*=US-ASCII'en'"), "ERR mime: duplicate parameter name"
  assert_eq pmt("Plain=text=*0us-ascii'en'%2*=utf-8%zz*1x"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff; x=US-ASCII'en'a%41b%41 ; name =b_~~b~ ; filename =~~~-"), "application/x-stuff|filename=~~~-|name=b_~~b~|x=US-ASCII'en'a%41b%41"
}

