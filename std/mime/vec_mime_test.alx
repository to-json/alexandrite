  assert_eq pmt("application/x-stuff; Title*1* =a.~a_; x=utf-8''%b\""), "ERR mime: invalid media parameter|application/x-stuff"
  assert_eq pmt("form-data; x*1=bb;filename= \"\\\"\""), "form-data|filename=\""
  assert_eq pmt(";"), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("text/plain;"), "text/plain"
  assert_eq pmt("us-ascii'en'"), "us-ascii'en'"
  assert_eq pmt("Multipart/Mixed;name*= \"\";x*=ba"), "multipart/mixed"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("%41TEXTus-ascii'en'*0\"%zz\t*"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b; boundary= a~.b_; x=a_"), "a/b|boundary=a~.b_|x=a_"
  assert_eq pmt("form-data; ="), "ERR mime: invalid media parameter|form-data"
  assert_eq pmt("%2*="), "ERR mime: expected slash after first token"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("text/plain ; filename*2=utf-8''%41"), "text/plain"
  assert_eq pmt("\\\"é; us-ascii'en''é"), "ERR mime: no media type"
  assert_eq pmt("attachment;filename=a."), "attachment|filename=a."
  assert_eq pmt("form-data ; x =~! ; Title*0*= 1b1~"), "form-data|title=|x=~!"
  assert_eq pmt("*=éé x@foohtml;\"\r\n;%41"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b;filename=1!b-_"), "a/b|filename=1!b-_"
  assert_eq pmt("text/plain ; name =''a"), "text/plain|name=''a"
  assert_eq pmt("\\%41*1\r\nutf-8''"), "ERR mime: no media type"
  assert_eq pmt("attachment;"), "attachment"
  assert_eq pmt("form-data;name =~bb-a. ; filename =utf-8'"), "form-data|filename=utf-8'|name=~bb-a."
  assert_eq pmt("utf-8''"), "utf-8''"
  assert_eq pmt("attachment;filename=~bb_~~; Title=ab!a; ="), "ERR mime: invalid media parameter|attachment"
  assert_eq pmt("attachment;Title=\"\\\" é\"; charset =utf-8'b"), "attachment|charset=utf-8'b|title=\" é"
  assert_eq pmt("%2*@name' /\"charsetutf-8'';utf-8''"), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("Multipart/Mixed x"), "ERR mime: unexpected content after media subtype"
  assert_eq pmt("utf-8\r\ncharset%2%zz%2\\\"utf-8''*=name\\\"%2"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b ; charset*1= b1--b1"), "a/b"
  assert_eq pmt("attachment; charset*0*=US-ASCII'en'b%%41; filename*1*= utf-8'%c3%a4"), "attachment|charset="
  assert_eq pmt("TEXTfoohtml*=us-ascii'en'Plain*"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("a/b;Title* =US-ASCII'en'b%c3%a4b%;boundary*1* =\"é\""), "a/b"
  assert_eq pmt("=*0utf-8''%zz*0x \r\n\r\n*0*"), "ERR mime: no media type"
  assert_eq pmt("a/b;x= !-a_a; x* =a_-!1_"), "a/b|x=!-a_a"
  assert_eq pmt("a/b;filename= -; name=!!b!-"), "a/b|filename=-|name=!!b!-"
  assert_eq pmt("'"), "'"
}

test "vectors: parse media type 4" {
  assert_eq pmt("attachment ; charset =\"\\\" a %41\""), "attachment|charset=\" a %41"
  assert_eq pmt("text/plain; filename =\"\""), "text/plain|filename="
  assert_eq pmt("Plain'Plainutf-8''\\\"=,html\t{}htmlutf-8;"), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("text/plain;filename*1= \"\" ; boundary*=-a-.- ; Title= ~~11a"), "text/plain|title=~~11a"
  assert_eq pmt("@ *0=Plain/%zz@/us-ascii'en',@Plain"), "ERR mime: no media type"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("Multipart/Mixed ; Title*0*= a ; x* =US-ASCII'en'%%41"), "multipart/mixed|title="
  assert_eq pmt("us-ascii'en';é"), "ERR mime: invalid media parameter|us-ascii'en'"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("form-data ; name*=._~b"), "form-data"
  assert_eq pmt("%2"), "%2"
  assert_eq pmt("form-data; boundary* =b-.a ; filename =\"\"; x*=.~~~!~"), "form-data|filename="
  assert_eq pmt("application/x-stuff; filename=''%c3%a4%4b; charset* =iso-8859-1''\""), "ERR mime: invalid media parameter|application/x-stuff"
  assert_eq pmt("us-ascii'en'\\fooutf-8'' Plain"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("Multipart/Mixed; boundary*= \" éa \";boundary*=-_aa x"), "ERR mime: duplicate parameter name"
  assert_eq pmt("us-ascii'en'x\\\""), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("application/x-stuff ; filename =iso-8859-1''bbb%41; boundary=\"a;  \""), "application/x-stuff|boundary=a;  |filename=iso-8859-1''bbb%41"
  assert_eq pmt("TEXT\r\nutf-8\\\"\"a b\"foo"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff ; name=b.__a- ; boundary=_~1"), "application/x-stuff|boundary=_~1|name=b.__a-"
  assert_eq pmt("application/x-stuff;"), "application/x-stuff"
  assert_eq pmt("charset\" TEXTcharset%41/*1text\r\n\r\n/*1"), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed;x*1 =.~__"), "multipart/mixed"
  assert_eq pmt("attachment; x=_-!;charset=''%41;charset*1*= -~a"), "attachment|charset=''%41|x=_-!"
  assert_eq pmt("TEXT;\\\"name\"a b\"%41 textxus-ascii'en'xé"), "ERR mime: invalid media parameter|text"
  assert_eq pmt("Multipart/Mixed; x =iso-8859-1''; x* =_~1b;boundary*1*= iso-8859-1''"), "multipart/mixed|x=iso-8859-1''"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt(",'%zz%2*=x text"), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("text/plain;boundary=_a1.!"), "text/plain|boundary=_a1.!"
  assert_eq pmt("Plain{}text\t *"), "ERR mime: expected slash after first token"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("'utf-8\\foo%zz*={}\r\nutf-8"), "ERR mime: expected slash after first token"
  assert_eq pmt("attachment ; charset=!-_"), "attachment|charset=!-_"
  assert_eq pmt("form-data ; name =~aaa~."), "form-data|name=~aaa~."
  assert_eq pmt("@nameutf-8*textfooé'charset\"a b\""), "ERR mime: no media type"
  assert_eq pmt("text/plain;name= b;Title*1*= _.; name= aa_"), "ERR mime: duplicate parameter name"
  assert_eq pmt("attachment ; charset*2=!ab~1;filename =.1-; charset=_1-ab"), "attachment|charset=_1-ab|filename=.1-"
  assert_eq pmt("TEXTutf-8''utf-8''us-ascii'en'*';*=*0*us-ascii'en'"), "textutf-8''utf-8''us-ascii'en'*'"
  assert_eq pmt("attachment ; boundary*2*= -a_~-!; charset= 1_b"), "attachment|charset=1_b"
  assert_eq pmt("a/b ; Title*1*=\"%41x\\\\\"; boundary= 1_!a_. ; name*= \" x é\""), "a/b|boundary=1_!a_."
  assert_eq pmt("*=TEXT%zz"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("application/x-stuff ; Title =utf-8''%41%c3%a4 ; Title*1*=_; boundary*0* =!b~~_-"), "application/x-stuff|boundary=|title=utf-8''%41%c3%a4"
  assert_eq pmt("{}us-ascii'en'charset\"%zz; /\t"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b;charset =a11~a; filename*0*=\"\\\\é\\\\\" ; boundary =\"\\\\x\""), "a/b|boundary=\\x|charset=a11~a|filename="
  assert_eq pmt("a/b x"), "ERR mime: unexpected content after media subtype"
  assert_eq pmt("%41us-ascii'en'*0; @=,x"), "ERR mime: invalid media parameter|%41us-ascii'en'*0"
  assert_eq pmt("application/x-stuff;filename*=~a~.-"), "application/x-stuff"
  assert_eq pmt("form-data;filename =.a ; Title= .;x*2* =_~a!a"), "form-data|filename=.a|title=."
  assert_eq pmt("; charsetutf-8''charsetname"), "ERR mime: no media type"
  assert_eq pmt("attachment ; charset=\"ééa\"; filename=\"ééx%41\"; x*= iso-8859-1''%4%4"), "attachment|charset=ééa|filename=ééx%41"
  assert_eq pmt("text/plain; name*0=~-_a!~; x*0*= US-ASCII'en'%c3%a4;charset*0=_1aa_"), "text/plain|charset=_1aa_|name=~-_a!~|x=ä"
  assert_eq pmt("*=*"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("text/plain ; boundary*2*= \"\""), "text/plain"
  assert_eq pmt("*=*0= "), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data ; filename =_"), "form-data|filename=_"
  assert_eq pmt("text/plain ; boundary*0*=utf-8''%41a; charset=b~!"), "text/plain|boundary=Aa|charset=b~!"
  assert_eq pmt("text%2'/ "), "ERR mime: expected token after slash"
  assert_eq pmt("application/x-stuff;x =a!.;filename =a.b"), "application/x-stuff|filename=a.b|x=a!."
