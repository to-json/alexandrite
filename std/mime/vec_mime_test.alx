test "vectors: parse media type 2" {
  assert_eq pmt("text/plain; x*= 1!-."), "text/plain"
  assert_eq pmt("\\\t%41/us-ascii'en'\\namexfoo*0"), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff ; x=11b."), "application/x-stuff|x=11b."
  assert_eq pmt("form-data;Title=\"\""), "form-data|title="
  assert_eq pmt(",\"a b\" ,éhtml%2text%41\\\" utf-8"), "ERR mime: no media type"
  assert_eq pmt("text/plain ; Title =US-ASCII'en'ba%c3%a4a"), "text/plain|title=US-ASCII'en'ba%c3%a4a"
  assert_eq pmt("application/x-stuff ; name*1*= iso-8859-1''%c3%a4%4 ; Title*2 =-b!. ; name*=."), "application/x-stuff"
  assert_eq pmt("\\\";\t\\\"\"a b\"\r\ntext'@"), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff ; boundary =-.a.! ; name= !;x*1=1"), "application/x-stuff|boundary=-.a.!|name=!"
  assert_eq pmt("form-data ; boundary=utf-8''%; x= a!. ; charset*2= \"\""), "form-data|boundary=utf-8''%|x=a!."
  assert_eq pmt("=;é\"a b\"*1@"), "ERR mime: no media type"
  assert_eq pmt("attachment; Title= !_ ; filename*= a~_b!b; boundary*2=1_!"), "attachment|title=!_"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("\\\"*0\t'\t\\\"\"a b\"*0=charset"), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("Multipart/Mixed x"), "ERR mime: unexpected content after media subtype"
  assert_eq pmt("*PlainfooPlainhtmlhtml\\"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data; charset= US-ASCII'en'%c3%a4b; x =~_-"), "form-data|charset=US-ASCII'en'%c3%a4b|x=~_-"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("textus-ascii'en'*1;html"), "ERR mime: invalid media parameter|textus-ascii'en'*1"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("Multipart/Mixed;name*0 =\"%41éé\";Title =_ab!-"), "multipart/mixed|name=%41éé|title=_ab!-"
  assert_eq pmt("*1@%zz%41\""), "ERR mime: expected slash after first token"
  assert_eq pmt("text/plain; boundary*0= iso-8859-1'' ; Title= \"\\\\\\\"é\"; boundary= .1-ab~"), "text/plain|boundary=iso-8859-1''|title=\\\"é"
  assert_eq pmt("attachment ; Title*2 =b!11"), "attachment"
  assert_eq pmt("\r\n\r\ncharsetname\"a b\";\r\nx,"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data"), "form-data"
  assert_eq pmt("application/x-stuff; charset* =a.b.-_"), "application/x-stuff"
