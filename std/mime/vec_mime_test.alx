  assert_eq pmt("nameus-ascii'en'\t %zz"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("'%41*0*charset/"), "ERR mime: expected token after slash"
  assert_eq pmt("form-data; charset= ~-.~ ; boundary*2=-"), "form-data|charset=~-.~"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("*=@%2*=\"a b\"foo*0"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data; Title*1*= utf-8''b"), "form-data"
  assert_eq pmt("attachment ; filename* =~a!_b_\""), "ERR mime: invalid media parameter|attachment"
  assert_eq pmt("'\"a b\"*0éfoofoo; %zz"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data; boundary =\" \" ; name =!b~1"), "form-data|boundary= |name=!b~1"
  assert_eq pmt("a/b ; name*1=.~.-!~ ; boundary =-~~ ;"), "a/b|boundary=-~~"
  assert_eq pmt("*0*étext\r\n"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff; name*2*=!.1~b ; charset =\"\"; name*2* =~b"), "ERR mime: duplicate parameter name"
  assert_eq pmt("Multipart/Mixed ; boundary*=1.;x =US-ASCII'en'%c3%a4; boundary*2=1!a1a"), "multipart/mixed|x=US-ASCII'en'%c3%a4"
  assert_eq pmt("*1{}*"), "*1{}*"
  assert_eq pmt("text/plain; charset= .!b1-b;Title*=\"\" ; charset*1* =utf-8'a"), "text/plain|charset=.!b1-b"
  assert_eq pmt("text/plain;filename*=\"a\\\"\" ; name*=aa.1a"), "text/plain"
  assert_eq pmt("name"), "name"
  assert_eq pmt("text/plain; filename =a!; x =\"é\\\"é é\" ; boundary= ~"), "text/plain|boundary=~|filename=a!|x=é\"é é"
  assert_eq pmt("Multipart/Mixed; Title=-~_a"), "multipart/mixed|title=-~_a"
  assert_eq pmt("\\%zz\"\r\n"), "ERR mime: no media type"
  assert_eq pmt("attachment;charset*0* =~-1 ; Title*1*= \"x\"; x=\"\\\"; \""), "attachment|charset=|x=\"; "
  assert_eq pmt("application/x-stuff;charset =\"a \\\";\""), "application/x-stuff|charset=a \";"
  assert_eq pmt("/%zz\\\"\"\r\n*0*\r\ntext"), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed;name*1*=-bb~_-"), "multipart/mixed"
  assert_eq pmt("application/x-stuff ; name= _-__b ; boundary=-; filename*= _~; ="), "ERR mime: invalid media parameter|application/x-stuff"
  assert_eq pmt("*0"), "*0"
  assert_eq pmt("form-data;x=\"\\\\aa\";Title =\";;\"; Title =\"%41 %41\"\""), "ERR mime: duplicate parameter name"
  assert_eq pmt("attachment;name*0*=iso-8859-1''%41a"), "attachment|name="
  assert_eq pmt("é\"a b\"\\\";\\\"*0html\""), "ERR mime: no media type"
  assert_eq pmt("attachment"), "attachment"
  assert_eq pmt("Multipart/Mixed; charset= -~aa~a;charset*0 =\"\\\"x \";filename =_--_a x"), "ERR mime: invalid media parameter|multipart/mixed"
  assert_eq pmt("/ ; \tPlainnameTEXT utf-8*"), "ERR mime: no media type"
  assert_eq pmt("form-data; x =US-ASCII'en';x= \";;x\\\\\""), "ERR mime: duplicate parameter name"
  assert_eq pmt("application/x-stuff;"), "application/x-stuff"
}

test "vectors: parse media type 9" {
  assert_eq pmt("%41=%zz;foo; é' "), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("a/b ;"), "a/b"
  assert_eq pmt("%zzx\r\nxcharset\\us-ascii'en'Plain\"a b\"nametexthtml"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b ; name*0*= !"), "a/b|name="
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt(" Plaincharset'/"), "ERR mime: expected token after slash"
  assert_eq pmt("form-data"), "form-data"
  assert_eq pmt("form-data;name*0= 1b; boundary=utf-8''%c3%a4;x*2*= _1~-"), "form-data|boundary=utf-8''%c3%a4|name=1b"
  assert_eq pmt(""), "ERR mime: no media type"
  assert_eq pmt("attachment ; boundary=utf-8''; boundary=-!b ; name*=-1!--!"), "ERR mime: duplicate parameter name"
  assert_eq pmt("a/b; charset=\"%41x\\\\xx\";name*0*=._ba;charset*2*= -"), "a/b|charset=%41x\\xx|name="
  assert_eq pmt(" {}%2; us-ascii'en''; Plain"), "ERR mime: invalid media parameter|{}%2"
  assert_eq pmt("application/x-stuff ; filename= utf-8''a%41%4 ; name=\"%41\""), "application/x-stuff|filename=utf-8''a%41%4|name=%41"
  assert_eq pmt("application/x-stuff"), "application/x-stuff"
  assert_eq pmt("html utf-8''Plain*0*Plain%41name%41"), "ERR mime: expected slash after first token"
  assert_eq pmt("application/x-stuff; name*=iso-8859-1''%4 ; x=\"\\\"\" ; filename= 1!-"), "application/x-stuff|filename=1!-|x=\""
  assert_eq pmt("application/x-stuff; filename=''%"), "application/x-stuff|filename=''%"
  assert_eq pmt("//\r\n\\"), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed ; filename=a-_"), "multipart/mixed|filename=a-_"
  assert_eq pmt("form-data"), "form-data"
  assert_eq pmt("%zz/\\\"{}*0*us-ascii'en'utf-8''"), "ERR mime: expected token after slash"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("text/plain ; filename=_a; filename*0*= a!1~a"), "text/plain|filename="
  assert_eq pmt("é\\\"utf-8''%2*utf-8''\"a b\"\téé\\\""), "ERR mime: no media type"
  assert_eq pmt("attachment; boundary*2 =aa; Title*0= a__~a; charset*0*=_b. ;"), "attachment|charset=|title=a__~a"
  assert_eq pmt("attachment; filename*= !.b!!!"), "attachment"
  assert_eq pmt("{}*1=TEXT*0*"), "ERR mime: expected slash after first token"
  assert_eq pmt("form-data;charset= 1a~b.!; name =."), "form-data|charset=1a~b.!|name=."
  assert_eq pmt("attachment;x=\"%41\"; boundary*1*= _-"), "attachment|x=%41"
