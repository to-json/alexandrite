  assert_eq pmt("\\html'Plain*0,*0*"), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed ; Title*0*=_1ba ;"), "multipart/mixed|title="
  assert_eq pmt("application/x-stuff; boundary =b1.; x =\";é\\\"é\" ; Title= aa~a.b"), "application/x-stuff|boundary=b1.|title=aa~a.b|x=;é\"é"
  assert_eq pmt("\"Plaincharset\\us-ascii'en''\\\"Plain/utf-8textutf-8''us-ascii'en'"), "ERR mime: no media type"
  assert_eq pmt("Multipart/Mixed"), "multipart/mixed"
  assert_eq pmt("a/b;name =\"\" ; x=\" \""), "a/b|name=|x= "
  assert_eq pmt("\"a b\"{}%zz\\\""), "ERR mime: no media type"
  assert_eq pmt("form-data; charset*2*= a"), "form-data"
  assert_eq pmt("application/x-stuff;Title*0= ''bab%; name*1*= _b_--;Title= -__1ab"), "application/x-stuff|title=''bab%"
  assert_eq pmt("\\\"utf-8'''TEXT\\\"=*0\"a b\""), "ERR mime: no media type"
  assert_eq pmt("a/b; Title*2*=~a; Title*2 =''%41%c3%a4; charset*0*= 1~!~"), "a/b|charset="
  assert_eq pmt("form-data;charset =!b.1~"), "form-data|charset=!b.1~"
  assert_eq pmt("TEXT%zz\"\té\"foo//*0*"), "ERR mime: expected slash after first token"
  assert_eq pmt("text/plain"), "text/plain"
  assert_eq pmt("form-data ; x= !; boundary*2=''a%41a ; boundary*2= utf-8'a"), "ERR mime: duplicate parameter name"
  assert_eq pmt("\\\"%41%41/,\"a b\"%41html\t\r\n%41Plain "), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff;Title= .-~~~"), "application/x-stuff|title=.-~~~"
  assert_eq pmt("application/x-stuff ; filename*= \"\";x= \"xé%41\\\\\""), "application/x-stuff|x=xé%41\\"
  assert_eq pmt("*0*\"; Plainutf-8\\"), "ERR mime: expected slash after first token"
  assert_eq pmt("a/b;filename*1=!"), "a/b"
  assert_eq pmt("form-data;boundary*0*= -1._.1"), "form-data|boundary="
  assert_eq pmt("=@\"a b\"*1TEXTutf-8="), "ERR mime: no media type"
  assert_eq pmt("application/x-stuff ; filename=b;filename*1* =!. ; charset*=b"), "application/x-stuff|filename=b"
  assert_eq pmt("form-data; charset=!a!~_a"), "form-data|charset=!a!~_a"
  assert_eq pmt("\\\"name'\"{}\"a b\"@ %41text*="), "ERR mime: no media type"
  assert_eq pmt("a/b"), "a/b"
  assert_eq pmt("attachment ; boundary*0*= .._"), "attachment|boundary="
  assert_eq pmt(" ,;%2\\x@%41@é\"us-ascii'en'%2"), "ERR mime: no media type"
