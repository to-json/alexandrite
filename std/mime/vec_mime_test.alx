test "vectors: word encoder 1" {
  assert_eq WordEncoder.QEncoding.encode("iso-8859-1", hx("e948656c6c6f3f5a3d01616221613d0161805f3ff09d849e")), "=?iso-8859-1?q?=E9Hello=3FZ=3D=01ab!a=3D=01a=80=5F=3F=F0=9D=84=9E?="
  assert_eq WordEncoder.BEncoding.encode("Utf-8", hx("48656c6c6f2121c3a90948656c6c6f5a80f09d849e09203d")), "=?Utf-8?b?SGVsbG8hIcOpCUhlbGxvWoDwnYSeCSA9?="
  assert_eq WordEncoder.QEncoding.encode("iso-8859-1", hx("3f3f3f80c3a9c3a97e20")), "=?iso-8859-1?q?=3F=3F=3F=80=C3=A9=C3=A9~_?="
