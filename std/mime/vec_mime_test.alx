  assert_eq wd("=?utf-8?q?_?=  =?iso-8859-1?Q?QW5k?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?_?=  =?iso-8859-1?Q?QW5k?= "), (" QW5k ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f8077366b3d5157356b3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
