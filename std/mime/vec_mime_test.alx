  assert_eq pmt("attachment;boundary= utf-8'%41 ; name*0*= \"\\\\ ;\" ; Title =''%%%4"), "attachment|boundary=utf-8'%41|name=|title=''%%%4"
  assert_eq pmt("*0*@utf-8 \ttext@*0/*=%zz/"), "ERR mime: expected slash after first token"
