  assert_eq pmt("application/x-stuff;name*= US-ASCII'en'%4b%c3%a4"), "application/x-stuff|name=Kä"
  assert_eq pmt("é%zz;'/\r\n\"a b\"us-ascii'en'\r\nname*=text="), "ERR mime: no media type"
  assert_eq pmt("attachment"), "attachment"
