  assert_eq wd(hx("3d3f7574662d383f713f5a673d3d3f3d0d0a093d3f7574662d383f623f3f3d2078203d3f5554462d383f423f805f3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5a673d3d3f3d0d0a093d3f7574662d383f623f3f3d2078203d3f5554462d383f423f805f3f3d2020")), (hx("3d3f7574662d383f713f5a673d3d3f3d0d0a092078203d3f5554462d383f423f805f3f3d2020"), "")
  assert_eq wd("=====?utf-8?x?Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=====?utf-8?x?Zm9"), ("=====?utf-8?x?Zm9", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f8077366b3d5a673d3d3f3d20203d3f75732d61736369693f713f5f3d33463f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f8077366b3d5a673d3d3f3d20203d3f75732d61736369693f713f5f3d33463f3d20")), (hx("3d3f69736f2d383835392d313f513f8077366b3d5a673d3d3f3d2020203f20"), "")
  assert_eq wd("é=?us-ascii?q??="), ("", "mime: invalid RFC 2047 encoded-word")
