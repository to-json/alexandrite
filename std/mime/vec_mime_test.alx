test "vectors: word decoder" {
  assert_eq wd("=?utf-8?q?cw===3FQW5k?=\r\n\t=?utf-8?q?=C3=A9cw==w6k=?= x =?us-ascii?q??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?cw===3FQW5k?=\r\n\t=?utf-8?q?=C3=A9cw==w6k=?= x =?us-ascii?q??= x "), ("=?utf-8?q?cw===3FQW5k?=\r\n\t=?utf-8?q?=C3=A9cw==w6k=?= x  x ", "")
  assert_eq wd("\n=4=E9===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n=4=E9===="), ("\n=4=E9====", "")
  assert_eq wd(hx("3d3f7574662d383f623f803d43333d41393f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f803d43333d41393f3d20")), (hx("3d3f7574662d383f623f803d43333d41393f3d20"), "")
  assert_eq wd("=?=E9plain=C3=A9=?utf-8?q?Zm9=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?=E9plain=C3=A9=?utf-8?q?Zm9=?utf-8?q?"), ("=?=E9plain=C3=A9=?utf-8?q?Zm9=?utf-8?q?", "")
  assert_eq wd("=?UTF-8?B?Zm9v=E9a?=\r\n\t=?us-ascii?q?Zm9v=C3=A9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zm9v=E9a?=\r\n\t=?us-ascii?q?Zm9v=C3=A9?="), ("=?UTF-8?B?Zm9v=E9a?=\r\n\tZm9v��", "")
  assert_eq wd("\r\n w6k==?UTF-8?B?a=E9=E9Zg?=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n w6k==?UTF-8?B?a=E9=E9Zg?=?utf-8?q?"), ("\r\n w6k==?UTF-8?B?a=E9=E9Zg?=?utf-8?q?", "")
  assert_eq wd("=?utf-8?b??==?UTF-8?B?__Zg==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??==?UTF-8?B?__Zg==?= "), ("=?UTF-8?B?__Zg==?= ", "")
  assert_eq wd(" plainZgw6k==?UTF-8?B??=C3=A9=?us-ascii?q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" plainZgw6k==?UTF-8?B??=C3=A9=?us-ascii?q??="), (" plainZgw6k=C3=A9", "")
  assert_eq wd("=?iso-8859-1?Q?QW5ka_?==?utf-8?b?Zm9v_?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?QW5ka_?==?utf-8?b?Zm9v_?=\r\n\t"), ("QW5ka =?utf-8?b?Zm9v_?=\r\n\t", "")
  assert_eq wd("\r\n Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n Zm9v"), ("\r\n Zm9v", "")
  assert_eq wd("=?us-ascii?q?Zm9v=3Fcw==?= =?us-ascii?q?Zg==QW5k=C3=A9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zm9v=3Fcw==?= =?us-ascii?q?Zg==QW5k=C3=A9?=  "), ("=?us-ascii?q?Zm9v=3Fcw==?= =?us-ascii?q?Zg==QW5k=C3=A9?=  ", "")
  assert_eq wd("cw==Zg=4?==4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw==Zg=4?==4"), ("cw==Zg=4?==4", "")
  assert_eq wd("=?utf-8?b?Zm9vQW5kw6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zm9vQW5kw6k=?= x "), ("fooAndé x ", "")
  assert_eq wd("_\nZm9v=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_\nZm9v=?utf-8?q?"), ("_\nZm9v=?utf-8?q?", "")
  assert_eq wd("=?utf-8?q??= x =?utf-8?q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= x =?utf-8?q??=\r\n\t"), (" x \r\n\t", "")
  assert_eq wd("\r\n  ?Zm9=4aaplain=E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n  ?Zm9=4aaplain=E9"), ("\r\n  ?Zm9=4aaplain=E9", "")
  assert_eq wd(hx("3d3f7574662d383f713f80803f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f80803f3d207820")), (hx("3d3f7574662d383f713f80803f3d207820"), "")
  assert_eq wd("=E9ZgZm9Zm9v=?UTF-8?B?=?utf-8?x?cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9ZgZm9Zm9v=?UTF-8?B?=?utf-8?x?cw=="), ("=E9ZgZm9Zm9v=?UTF-8?B?=?utf-8?x?cw==", "")
  assert_eq wd("=?UTF-8?B??=  =?iso-8859-1?Q?w6k=?=\r\n\t=?utf-8?q?_?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??=  =?iso-8859-1?Q?w6k=?=\r\n\t=?utf-8?q?_?=\r\n\t"), ("  =?iso-8859-1?Q?w6k=?=\r\n\t \r\n\t", "")
  assert_eq wd("Zm9cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9cw=="), ("Zm9cw==", "")
  assert_eq wd("=?utf-8?q?Zm9vZm9v?=\r\n\t=?UTF-8?B?=E9_?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zm9vZm9v?=\r\n\t=?UTF-8?B?=E9_?="), ("Zm9vZm9v\r\n\t=?UTF-8?B?=E9_?=", "")
  assert_eq wd("\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n"), ("\n", "")
  assert_eq wd("=?iso-8859-1?Q?a=E9?==?utf-8?b??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?a=E9?==?utf-8?b??="), ("aé", "")
  assert_eq wd("=?utf-8?q?Zgé=?utf-8?q? ?=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zgé=?utf-8?q? ?=?iso-8859-1?Q?"), ("=?utf-8?q?Zgé=?utf-8?q? ?=?iso-8859-1?Q?", "")
  assert_eq wd(hx("3d3f5554462d383f423f3d43333d41395157356b3f3d2078203d3f5554462d383f423f803f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f3d43333d41395157356b3f3d2078203d3f5554462d383f423f803f3d0d0a09")), (hx("3d3f5554462d383f423f3d43333d41395157356b3f3d2078203d3f5554462d383f423f803f3d0d0a09"), "")
  assert_eq wd("=4=?UTF-8?B?aZg=zz====plain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4=?UTF-8?B?aZg=zz====plain"), ("=4=?UTF-8?B?aZg=zz====plain", "")
  assert_eq wd(hx("3d3f7574662d383f713f63773d3d3f3d2078203d3f5554462d383f423f805a6d39763f3d203d3f5554462d383f423f5a6d39765a6d39763f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f63773d3d3f3d2078203d3f5554462d383f423f805a6d39763f3d203d3f5554462d383f423f5a6d39765a6d39763f3d20")), (hx("3d3f7574662d383f713f63773d3d3f3d2078203d3f5554462d383f423f805a6d39763f3d20666f6f666f6f20"), "")
  assert_eq wd("=E9=?iso-8859-1?Q?=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9=?iso-8859-1?Q?=?"), ("=E9=?iso-8859-1?Q?=?", "")
  assert_eq wd(hx("3d3f7574662d383f623f63773d3d5f803f3d0d0a093d3f5554462d383f423f3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f63773d3d5f803f3d0d0a093d3f5554462d383f423f3f3d0d0a09")), (hx("3d3f7574662d383f623f63773d3d5f803f3d0d0a090d0a09"), "")
  assert_eq wd("cw===?=?iso-8859-1?Q? =?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw===?=?iso-8859-1?Q? =?utf-8?x?"), ("cw===?=?iso-8859-1?Q? =?utf-8?x?", "")
  assert_eq wd("=?UTF-8?B?QW5k=C3=A9a?=  =?utf-8?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?QW5k=C3=A9a?=  =?utf-8?q??= "), ("=?UTF-8?B?QW5k=C3=A9a?=   ", "")
  assert_eq wd("Zm9v=?x-unknown?q?é=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v=?x-unknown?q?é=?us-ascii?q?"), ("Zm9v=?x-unknown?q?é=?us-ascii?q?", "")
  assert_eq wd("=?utf-8?b?_aZg==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?_aZg==?=  "), ("=?utf-8?b?_aZg==?=  ", "")
  assert_eq wd("=?utf-8?x?QW5kplain =?utf-8?q?=C3=A9=?utf-8?q?w6k=\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?QW5kplain =?utf-8?q?=C3=A9=?utf-8?q?w6k=\r\n "), ("=?utf-8?x?QW5kplain =?utf-8?q?=C3=A9=?utf-8?q?w6k=\r\n ", "")
  assert_eq wd("=?us-ascii?q?cw==?= x =?us-ascii?q?Zm9v?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?cw==?= x =?us-ascii?q?Zm9v?=  "), ("=?us-ascii?q?cw==?= x Zm9v  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f5554462d383f423f5a673d3d5157356b3f3d203d3f7574662d383f713f803f3d3d3f7574662d383f713f3f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f5a673d3d5157356b3f3d203d3f7574662d383f713f803f3d3d3f7574662d383f713f3f3d207820")), (hx("3d3f5554462d383f423f5a673d3d5157356b3f3d203d3f7574662d383f713f803f3d207820"), "")
  assert_eq wd("=?x-unknown?q?===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?===="), ("=?x-unknown?q?====", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f5a6d39763f3d20203d3f69736f2d383835392d313f513f803f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f5a6d39763f3d20203d3f69736f2d383835392d313f513f803f3d207820")), (hx("5a6d397620203d3f69736f2d383835392d313f513f803f3d207820"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q?=C3=A9?=  =?utf-8?b?=3Fw6k=Zm9v?==?us-ascii?q?=3F=E9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=C3=A9?=  =?utf-8?b?=3Fw6k=Zm9v?==?us-ascii?q?=3F=E9?= x "), ("��  =?utf-8?b?=3Fw6k=Zm9v?=?� x ", "")
  assert_eq wd("=====zz  Zm9Zg=====?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=====zz  Zm9Zg=====?iso-8859-1?Q?"), ("=====zz  Zm9Zg=====?iso-8859-1?Q?", "")
  assert_eq wd("=?utf-8?b?_QW5k?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?_QW5k?=  "), ("=?utf-8?b?_QW5k?=  ", "")
  assert_eq wd("QW5kw6k=é=?us-ascii?q?====plainZm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5kw6k=é=?us-ascii?q?====plainZm9v"), ("QW5kw6k=é=?us-ascii?q?====plainZm9v", "")
  assert_eq wd("=?utf-8?b?Zg==?=\r\n\t=?iso-8859-1?Q?Zg==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zg==?=\r\n\t=?iso-8859-1?Q?Zg==?="), ("f\r\n\t=?iso-8859-1?Q?Zg==?=", "")
  assert_eq wd("=C3=A9=?us-ascii?q?=zz=?utf-8?x?_=4QW5kplain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9=?us-ascii?q?=zz=?utf-8?x?_=4QW5kplain"), ("=C3=A9=?us-ascii?q?=zz=?utf-8?x?_=4QW5kplain", "")
  assert_eq wd(hx("3d3f7574662d383f623f3f3d2078203d3f69736f2d383835392d313f513f61613d43333d41393f3d203d3f69736f2d383835392d313f513f5157356b3d43333d4139803f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f3f3d2078203d3f69736f2d383835392d313f513f61613d43333d41393f3d203d3f69736f2d383835392d313f513f5157356b3d43333d4139803f3d20")), (hx("2078206161c383c2a9203d3f69736f2d383835392d313f513f5157356b3d43333d4139803f3d20"), "")
  assert_eq wd("Zm9v=4=?us-ascii?q?=?UTF-8?B?=?us-ascii?q?cw======Zm9v?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v=4=?us-ascii?q?=?UTF-8?B?=?us-ascii?q?cw======Zm9v?="), ("Zm9v=4=?us-ascii?q?=?UTF-8?B?=?us-ascii?q?cw======Zm9v?=", "")
  assert_eq wd("=?utf-8?b?Zm9vZg==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zm9vZg==?= x "), ("foof x ", "")
  assert_eq wd("=?UTF-8?B?\r\n a=C3=A9?="), ("", "illegal base64 data at input byte 2")
  assert_eq wdh("=?UTF-8?B?\r\n a=C3=A9?="), ("=?UTF-8?B?\r\n a=C3=A9?=", "")
}

test "vectors: word decoder 1" {
  assert_eq wd(hx("3d3f75732d61736369693f713f61803f3d203d3f7574662d383f713f3f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f61803f3d203d3f7574662d383f713f3f3d207820")), (hx("3d3f75732d61736369693f713f61803f3d20207820"), "")
  assert_eq wd("\r\n =?iso-8859-1?Q? =?cw===?us-ascii?q?plain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n =?iso-8859-1?Q? =?cw===?us-ascii?q?plain"), ("\r\n =?iso-8859-1?Q? =?cw===?us-ascii?q?plain", "")
  assert_eq wd(hx("3d3f5554462d383f423f613f3d20203d3f75732d61736369693f713f5a6d39763f3d0d0a093d3f7574662d383f713f803d33463d45393f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f613f3d20203d3f75732d61736369693f713f5a6d39763f3d0d0a093d3f7574662d383f713f803d33463d45393f3d2020")), (hx("3d3f5554462d383f423f613f3d20205a6d39760d0a093d3f7574662d383f713f803d33463d45393f3d2020"), "")
  assert_eq wd("Zm9plain=zz\r\n ====w6k=\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9plain=zz\r\n ====w6k=\r\n "), ("Zm9plain=zz\r\n ====w6k=\r\n ", "")
  assert_eq wd("=?us-ascii?q??="), ("", "")
  assert_eq wdh("=?us-ascii?q??="), ("", "")
  assert_eq wd("=C3=A9 =4=C3=A9acw==cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9 =4=C3=A9acw==cw=="), ("=C3=A9 =4=C3=A9acw==cw==", "")
  assert_eq wd("=?iso-8859-1?Q?Zm9v?= x =?utf-8?q?w6k==E9w6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zm9v?= x =?utf-8?q?w6k==E9w6k=?= x "), ("Zm9v x =?utf-8?q?w6k==E9w6k=?= x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f3d43333d41395a6d39765a673d3d3f3d2078203d3f75732d61736369693f713f5a673d3d77366b3d77366b3d3f3d0d0a093d3f7574662d383f713f61805a6d39763f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f3d43333d41395a6d39765a673d3d3f3d2078203d3f75732d61736369693f713f5a673d3d77366b3d77366b3d3f3d0d0a093d3f7574662d383f713f61805a6d39763f3d2020")), (hx("3d3f69736f2d383835392d313f513f3d43333d41395a6d39765a673d3d3f3d2078203d3f75732d61736369693f713f5a673d3d77366b3d77366b3d3f3d0d0a093d3f7574662d383f713f61805a6d39763f3d2020"), "")
  assert_eq wd("\nZm9vplain=?=?utf-8?x?é=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\nZm9vplain=?=?utf-8?x?é=?us-ascii?q?"), ("\nZm9vplain=?=?utf-8?x?é=?us-ascii?q?", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f803f3d0d0a093d3f75732d61736369693f713f3d43333d413963773d3d3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f803f3d0d0a093d3f75732d61736369693f713f3d43333d413963773d3d3f3d0d0a09")), (hx("3d3f69736f2d383835392d313f513f803f3d0d0a093d3f75732d61736369693f713f3d43333d413963773d3d3f3d0d0a09"), "")
  assert_eq wd("=?utf-8?x?cw==\r\n _\n=?x-unknown?q?=?utf-8?x?=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?cw==\r\n _\n=?x-unknown?q?=?utf-8?x?=C3=A9"), ("=?utf-8?x?cw==\r\n _\n=?x-unknown?q?=?utf-8?x?=C3=A9", "")
  assert_eq wd("=?us-ascii?q?Zm9v?==?utf-8?q?_?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zm9v?==?utf-8?q?_?=  "), ("Zm9v   ", "")
  assert_eq wd("é=?utf-8?x? =====?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é=?utf-8?x? =====?iso-8859-1?Q?"), ("é=?utf-8?x? =====?iso-8859-1?Q?", "")
  assert_eq wd("=?utf-8?q?=C3=A9_=3F?= =?utf-8?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9_=3F?= =?utf-8?q??= "), ("é ? ", "")
  assert_eq wd("Zm9v=4\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v=4\n"), ("Zm9v=4\n", "")
  assert_eq wd("=?UTF-8?B??==?iso-8859-1?Q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??==?iso-8859-1?Q??=  "), ("  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?iso-8859-1?Q?QW5kcw==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?QW5kcw==?=\r\n\t"), ("=?iso-8859-1?Q?QW5kcw==?=\r\n\t", "")
  assert_eq wd("====w6k====="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("====w6k====="), ("====w6k=====", "")
  assert_eq wd("=?utf-8?b?=C3=A9w6k=?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=C3=A9w6k=?= "), ("=?utf-8?b?=C3=A9w6k=?= ", "")
  assert_eq wd("_\r\n =4aé ZgZm9=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_\r\n =4aé ZgZm9=zz"), ("_\r\n =4aé ZgZm9=zz", "")
  assert_eq wd("=?us-ascii?q??= x =?UTF-8?B?Zg===C3=A9?=  =?UTF-8?B?=E9QW5k?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= x =?UTF-8?B?Zg===C3=A9?=  =?UTF-8?B?=E9QW5k?= x "), (" x =?UTF-8?B?Zg===C3=A9?=  =?UTF-8?B?=E9QW5k?= x ", "")
  assert_eq wd("=?utf-8?x?QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?QW5k"), ("=?utf-8?x?QW5k", "")
  assert_eq wd("=?utf-8?b?_=E9_?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?_=E9_?=\r\n\t"), ("=?utf-8?b?_=E9_?=\r\n\t", "")
  assert_eq wd("é\n=?us-ascii?q?=??=\nw6k==E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é\n=?us-ascii?q?=??=\nw6k==E9"), ("é\n=?us-ascii?q?=??=\nw6k==E9", "")
  assert_eq wd("=?us-ascii?q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?="), ("?=", "")
  assert_eq wd("=?utf-8?b?=E9?=\r\n\t=?utf-8?q??==?iso-8859-1?Q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=E9?=\r\n\t=?utf-8?q??==?iso-8859-1?Q??= "), ("=?utf-8?b?=E9?=\r\n\t ", "")
  assert_eq wd("=?_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?_"), ("=?_", "")
  assert_eq wd("=?UTF-8?B?QW5k?= =?iso-8859-1?Q?a=C3=A9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?QW5k?= =?iso-8859-1?Q?a=C3=A9?= "), ("AndaÃ© ", "")
  assert_eq wd("Zm9\n=C3=A9=?=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9\n=C3=A9=?=?iso-8859-1?Q?"), ("Zm9\n=C3=A9=?=?iso-8859-1?Q?", "")
  assert_eq wd("=?UTF-8?B?Zm9v?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zm9v?=\r\n\t"), ("foo\r\n\t", "")
  assert_eq wd("====?==?utf-8?x?cw==éQW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("====?==?utf-8?x?cw==éQW5k"), ("====?==?utf-8?x?cw==éQW5k", "")
  assert_eq wd("=?UTF-8?B?=E9=C3=A9?=\r\n\t=?UTF-8?B?Zm9vcw==_?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=E9=C3=A9?=\r\n\t=?UTF-8?B?Zm9vcw==_?=\r\n\t"), ("=?UTF-8?B?=E9=C3=A9?=\r\n\t=?UTF-8?B?Zm9vcw==_?=\r\n\t", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B?w6k=cw==_?==?utf-8?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?w6k=cw==_?==?utf-8?q??= "), ("=?UTF-8?B?w6k=cw==_?= ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?b??=  =?us-ascii?q??= x =?iso-8859-1?Q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=  =?us-ascii?q??= x =?iso-8859-1?Q??=  "), (" x   ", "")
  assert_eq wd("_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_"), ("_", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f3f3d3d3f7574662d383f623f3d45393f3d3d3f5554462d383f423f805157356b3d45393f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f3f3d3d3f7574662d383f623f3d45393f3d3d3f5554462d383f423f805157356b3d45393f3d")), (hx("3d3f7574662d383f623f3d45393f3d3d3f5554462d383f423f805157356b3d45393f3d"), "")
  assert_eq wd("=?iso-8859-1?Q?=?iso-8859-1?Q?=?utf-8?x?=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=?iso-8859-1?Q?=?utf-8?x?=?"), ("=?iso-8859-1?Q?=?iso-8859-1?Q?=?utf-8?x?=?", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f5157356b805f3f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f5157356b805f3f3d")), (hx("3d3f69736f2d383835392d313f513f5157356b805f3f3d"), "")
  assert_eq wd("=4=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4=C3=A9"), ("=4=C3=A9", "")
  assert_eq wd("=?iso-8859-1?Q?Zg==Zg==?==?utf-8?b?Zm9vZm9v?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zg==Zg==?==?utf-8?b?Zm9vZm9v?= x "), ("=?iso-8859-1?Q?Zg==Zg==?=foofoo x ", "")
  assert_eq wd("QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k"), ("QW5k", "")
  assert_eq wd("=?iso-8859-1?Q??==?iso-8859-1?Q?=C3=A9_?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??==?iso-8859-1?Q?=C3=A9_?=  "), ("Ã©   ", "")
  assert_eq wd("Zm9vcw==?plainplain=?x-unknown?q?=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9vcw==?plainplain=?x-unknown?q?=?"), ("Zm9vcw==?plainplain=?x-unknown?q?=?", "")
  assert_eq wd("=?UTF-8?B?=E9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=E9?=\r\n\t"), ("=?UTF-8?B?=E9?=\r\n\t", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
}

test "vectors: word decoder 2" {
  assert_eq wd(hx("3d3f7574662d383f713f3f3d3d3f75732d61736369693f713f805a673d3d3d33463f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f3f3d3d3f75732d61736369693f713f805a673d3d3d33463f3d2020")), (hx("3d3f75732d61736369693f713f805a673d3d3d33463f3d2020"), "")
  assert_eq wd("cw===?utf-8?q?=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw===?utf-8?q?=?"), ("cw===?utf-8?q?=?", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f803f3d203d3f5554462d383f423f615a673d3d3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f803f3d203d3f5554462d383f423f615a673d3d3f3d2020")), (hx("3d3f69736f2d383835392d313f513f803f3d203d3f5554462d383f423f615a673d3d3f3d2020"), "")
  assert_eq wd("=?x-unknown?q?=?utf-8?q?QW5kcw==QW5k=zz=4=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?=?utf-8?q?QW5kcw==QW5k=zz=4=?utf-8?q?"), ("=?x-unknown?q?=?utf-8?q?QW5kcw==QW5k=zz=4=?utf-8?q?", "")
  assert_eq wd("=?iso-8859-1?Q?=3FZm9v?= =?UTF-8?B??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=3FZm9v?= =?UTF-8?B??= x "), ("?Zm9v x ", "")
  assert_eq wd("Zm9v?Zgplain=4?=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v?Zgplain=4?=?utf-8?q?"), ("Zm9v?Zgplain=4?=?utf-8?q?", "")
  assert_eq wd("=?utf-8?b?=3F=E9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3F=E9?=  "), ("=?utf-8?b?=3F=E9?=  ", "")
  assert_eq wd("a=?utf-8?x?=4=?UTF-8?B?=E9=E9ZgQW5ké"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=?utf-8?x?=4=?UTF-8?B?=E9=E9ZgQW5ké"), ("a=?utf-8?x?=4=?UTF-8?B?=E9=E9ZgQW5ké", "")
  assert_eq wd("=?utf-8?q??= =?utf-8?b?_w6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= =?utf-8?b?_w6k=?= x "), (" =?utf-8?b?_w6k=?= x ", "")
  assert_eq wd("=?utf-8?q?QW5ka_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?QW5ka_"), ("=?utf-8?q?QW5ka_", "")
  assert_eq wd("=?us-ascii?q??="), ("", "")
  assert_eq wdh("=?us-ascii?q??="), ("", "")
  assert_eq wd("plainZgZg_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plainZgZg_"), ("plainZgZg_", "")
  assert_eq wd("=?utf-8?b?a=C3=A9a?= =?iso-8859-1?Q??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?a=C3=A9a?= =?iso-8859-1?Q??= x "), ("=?utf-8?b?a=C3=A9a?=  x ", "")
  assert_eq wd("=E9?=Zg=?utf-8?x?plain=zzZg"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9?=Zg=?utf-8?x?plain=zzZg"), ("=E9?=Zg=?utf-8?x?plain=zzZg", "")
  assert_eq wd("=?utf-8?q?Zg===E9w6k=?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zg===E9w6k=?= "), ("=?utf-8?q?Zg===E9w6k=?= ", "")
  assert_eq wd("?=a=?utf-8?x?=?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=a=?utf-8?x?=?UTF-8?B?"), ("?=a=?utf-8?x?=?UTF-8?B?", "")
  assert_eq wd("=?utf-8?b?QW5k=E9Zm9v?=\r\n\t=?utf-8?q?a=C3=A9a?= x =?utf-8?q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?QW5k=E9Zm9v?=\r\n\t=?utf-8?q?a=C3=A9a?= x =?utf-8?q??="), ("=?utf-8?b?QW5k=E9Zm9v?=\r\n\taéa x ", "")
  assert_eq wd("\r\n Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n Zm9v"), ("\r\n Zm9v", "")
  assert_eq wd("=?utf-8?b?=C3=A9?==?us-ascii?q??==?iso-8859-1?Q?cw==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=C3=A9?==?us-ascii?q??==?iso-8859-1?Q?cw==?="), ("=?utf-8?b?=C3=A9?==?iso-8859-1?Q?cw==?=", "")
  assert_eq wd("=4Zm9=?QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4Zm9=?QW5k"), ("=4Zm9=?QW5k", "")
  assert_eq wd("=?utf-8?q??= x =?us-ascii?q??=\r\n\t=?utf-8?b?_=E9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= x =?us-ascii?q??=\r\n\t=?utf-8?b?_=E9?="), (" x \r\n\t=?utf-8?b?_=E9?=", "")
  assert_eq wd("\r\n =?iso-8859-1?Q?é\na=?w6k=w6k==4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n =?iso-8859-1?Q?é\na=?w6k=w6k==4"), ("\r\n =?iso-8859-1?Q?é\na=?w6k=w6k==4", "")
  assert_eq wd("=?us-ascii?q?Zg==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zg==?= x "), ("=?us-ascii?q?Zg==?= x ", "")
  assert_eq wd("?_=?utf-8?q?\nw6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?_=?utf-8?q?\nw6k="), ("?_=?utf-8?q?\nw6k=", "")
  assert_eq wd("=?utf-8?q?=C3=A9=C3=A9Zg==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9=C3=A9Zg==?=  "), ("=?utf-8?q?=C3=A9=C3=A9Zg==?=  ", "")
  assert_eq wd(" \n=?iso-8859-1?Q?\n=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" \n=?iso-8859-1?Q?\n=?utf-8?x?"), (" \n=?iso-8859-1?Q?\n=?utf-8?x?", "")
  assert_eq wd("=?iso-8859-1?Q?Zm9vw6k=?==?utf-8?b??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zm9vw6k=?==?utf-8?b??= "), ("=?iso-8859-1?Q?Zm9vw6k=?= ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q?QW5k=E9?= x =?utf-8?q?Zg===C3=A9?=  =?UTF-8?B??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?QW5k=E9?= x =?utf-8?q?Zg===C3=A9?=  =?UTF-8?B??="), ("QW5k� x =?utf-8?q?Zg===C3=A9?=  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q?QW5kQW5kQW5k?= x =?UTF-8?B?Zg==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?QW5kQW5kQW5k?= x =?UTF-8?B?Zg==?= "), ("QW5kQW5kQW5k x f ", "")
  assert_eq wd("a_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a_"), ("a_", "")
  assert_eq wd("=?iso-8859-1?Q?=C3=A9?=  =?utf-8?q?=3Fa_?= =?utf-8?b?Zm9v?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=C3=A9?=  =?utf-8?q?=3Fa_?= =?utf-8?b?Zm9v?= x "), ("Ã©?a foo x ", "")
  assert_eq wd("éZm9vcw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("éZm9vcw=="), ("éZm9vcw==", "")
  assert_eq wd("=?us-ascii?q??=\r\n\t=?utf-8?b??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=\r\n\t=?utf-8?b??="), ("", "")
  assert_eq wd("=?iso-8859-1?Q?=zz=?utf-8?q?=E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=zz=?utf-8?q?=E9"), ("=?iso-8859-1?Q?=zz=?utf-8?q?=E9", "")
  assert_eq wd("=?us-ascii?q?a=3F?="), ("a?", "")
  assert_eq wdh("=?us-ascii?q?a=3F?="), ("a?", "")
  assert_eq wd("?==?x-unknown?q?\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==?x-unknown?q?\r\n "), ("?==?x-unknown?q?\r\n ", "")
  assert_eq wd("=?iso-8859-1?Q?=E9cw==?=  =?utf-8?b?Zm9v=C3=A9?==?us-ascii?q??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=E9cw==?=  =?utf-8?b?Zm9v=C3=A9?==?us-ascii?q??= x "), ("=?iso-8859-1?Q?=E9cw==?=  =?utf-8?b?Zm9v=C3=A9?= x ", "")
  assert_eq wd("=?utf-8?q?w6k==?UTF-8?B?Zm9?=Zg=4=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?w6k==?UTF-8?B?Zm9?=Zg=4=?iso-8859-1?Q?"), ("=?utf-8?q?w6k==?UTF-8?B?Zm9?=Zg=4=?iso-8859-1?Q?", "")
  assert_eq wd(hx("3d3f5554462d383f423f5a673d3d803f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f5a673d3d803f3d2020")), (hx("3d3f5554462d383f423f5a673d3d803f3d2020"), "")
  assert_eq wd("a=4\r\n =?utf-8?x?=?QW5k=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=4\r\n =?utf-8?x?=?QW5k=?iso-8859-1?Q?"), ("a=4\r\n =?utf-8?x?=?QW5k=?iso-8859-1?Q?", "")
  assert_eq wd("=?iso-8859-1?Q?=C3=A9_QW5k?=\r\n\t=?us-ascii?q?a?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=C3=A9_QW5k?=\r\n\t=?us-ascii?q?a?=\r\n\t"), ("Ã© QW5ka\r\n\t", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?iso-8859-1?Q?Zg===E9QW5k?=  =?utf-8?q?a=3F?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zg===E9QW5k?=  =?utf-8?q?a=3F?= x "), ("=?iso-8859-1?Q?Zg===E9QW5k?=  a? x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B?=E9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=E9?= x "), ("=?UTF-8?B?=E9?= x ", "")
  assert_eq wd("?==?UTF-8?B?é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==?UTF-8?B?é"), ("?==?UTF-8?B?é", "")
  assert_eq wd("=?utf-8?b?QW5k?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?QW5k?= x "), ("And x ", "")
  assert_eq wd("=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?"), ("=?x-unknown?q?", "")
}

test "vectors: word decoder 3" {
  assert_eq wd("=?utf-8?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= "), (" ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q?Zg===C3=A9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zg===C3=A9?= x "), ("=?us-ascii?q?Zg===C3=A9?= x ", "")
  assert_eq wd("=====?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=====?utf-8?x?"), ("=====?utf-8?x?", "")
  assert_eq wd("=?utf-8?q?=C3=A9=C3=A9?= x =?utf-8?q?Zg==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9=C3=A9?= x =?utf-8?q?Zg==?= "), ("éé x =?utf-8?q?Zg==?= ", "")
  assert_eq wd("Zm9====\r\n _=?iso-8859-1?Q?=E9\n===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9====\r\n _=?iso-8859-1?Q?=E9\n===="), ("Zm9====\r\n _=?iso-8859-1?Q?=E9\n====", "")
  assert_eq wd("=?UTF-8?B??=  =?UTF-8?B?QW5k_QW5k?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??=  =?UTF-8?B?QW5k_QW5k?="), ("  =?UTF-8?B?QW5k_QW5k?=", "")
  assert_eq wd("w6k==?utf-8?x?=?utf-8?x?====?=?=plaincw===?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k==?utf-8?x?=?utf-8?x?====?=?=plaincw===?x-unknown?q?"), ("w6k==?utf-8?x?=?utf-8?x?====?=?=plaincw===?x-unknown?q?", "")
  assert_eq wd("=?utf-8?b??=\r\n\t=?iso-8859-1?Q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t=?iso-8859-1?Q??= "), (" ", "")
  assert_eq wd("w6k=w6k=\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k=w6k=\r\n "), ("w6k=w6k=\r\n ", "")
  assert_eq wd("=?iso-8859-1?Q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("=4\n=C3=A9=?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4\n=C3=A9=?UTF-8?B?"), ("=4\n=C3=A9=?UTF-8?B?", "")
  assert_eq wd(hx("3d3f7574662d383f713f8077366b3d3f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f8077366b3d3f3d")), (hx("3d3f7574662d383f713f8077366b3d3f3d"), "")
  assert_eq wd("=zz =?utf-8?q?plaina\r\n éZm9v=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz =?utf-8?q?plaina\r\n éZm9v=?x-unknown?q?"), ("=zz =?utf-8?q?plaina\r\n éZm9v=?x-unknown?q?", "")
  assert_eq wd("=?UTF-8?B?cw==_w6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?cw==_w6k=?= x "), ("=?UTF-8?B?cw==_w6k=?= x ", "")
  assert_eq wd("cw==Zm9=?iso-8859-1?Q?QW5kplain=?x-unknown?q? =C3=A9 "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw==Zm9=?iso-8859-1?Q?QW5kplain=?x-unknown?q? =C3=A9 "), ("cw==Zm9=?iso-8859-1?Q?QW5kplain=?x-unknown?q? =C3=A9 ", "")
  assert_eq wd("=?utf-8?b??= =?iso-8859-1?Q?=E9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??= =?iso-8859-1?Q?=E9?=  "), ("é  ", "")
  assert_eq wd("=?utf-8?q??==zz_ "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??==zz_ "), ("=zz_ ", "")
  assert_eq wd("=?iso-8859-1?Q?=3FQW5k?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=3FQW5k?= "), ("?QW5k ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q??=\r\n\t=?utf-8?b??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??=\r\n\t=?utf-8?b??="), ("", "")
  assert_eq wd("=C3=A9w6k==?iso-8859-1?Q?QW5kw6k==4ZgZg"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9w6k==?iso-8859-1?Q?QW5kw6k==4ZgZg"), ("=C3=A9w6k==?iso-8859-1?Q?QW5kw6k==4ZgZg", "")
  assert_eq wd(hx("3d3f7574662d383f713f80803d33463f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f80803d33463f3d0d0a09")), (hx("3d3f7574662d383f713f80803d33463f3d0d0a09"), "")
  assert_eq wd("=E9?\r\n plainw6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9?\r\n plainw6k="), ("=E9?\r\n plainw6k=", "")
  assert_eq wd(hx("3d3f7574662d383f713f3d4539803f3d203d3f75732d61736369693f713f613f3d2078203d3f75732d61736369693f713f613d45395a6d39763f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f3d4539803f3d203d3f75732d61736369693f713f613f3d2078203d3f75732d61736369693f713f613d45395a6d39763f3d20")), (hx("3d3f7574662d383f713f3d4539803f3d206120782061efbfbd5a6d397620"), "")
  assert_eq wd("cw==\r\n ====Zm9_cw== "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw==\r\n ====Zm9_cw== "), ("cw==\r\n ====Zm9_cw== ", "")
  assert_eq wd("=?us-ascii?q?cw==a_?==?us-ascii?q??= =?iso-8859-1?Q?_?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?cw==a_?==?us-ascii?q??= =?iso-8859-1?Q?_?= "), ("=?us-ascii?q?cw==a_?=  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?iso-8859-1?Q?=C3=A9=C3=A9?=  =?iso-8859-1?Q?=C3=A9?=\r\n\t=?us-ascii?q?=C3=A9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=C3=A9=C3=A9?=  =?iso-8859-1?Q?=C3=A9?=\r\n\t=?us-ascii?q?=C3=A9?= "), ("Ã©Ã©Ã©�� ", "")
  assert_eq wd("=?x-unknown?q?=?iso-8859-1?Q? aplainZg"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?=?iso-8859-1?Q? aplainZg"), ("=?x-unknown?q?=?iso-8859-1?Q? aplainZg", "")
  assert_eq wd("=?utf-8?q?_w6k=?=  =?utf-8?q?=E9=3FQW5k?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?_w6k=?=  =?utf-8?q?=E9=3FQW5k?=\r\n\t"), (hx("3d3f7574662d383f713f5f77366b3d3f3d2020e93f5157356b0d0a09"), "")
  assert_eq wd("=E9=?utf-8?q?\r\n =?utf-8?x?=?utf-8?x?? _"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9=?utf-8?q?\r\n =?utf-8?x?=?utf-8?x?? _"), ("=E9=?utf-8?q?\r\n =?utf-8?x?=?utf-8?x?? _", "")
  assert_eq wd("=?UTF-8?B??="), ("", "")
  assert_eq wdh("=?UTF-8?B??="), ("", "")
  assert_eq wd("w6k=\n?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k=\n?="), ("w6k=\n?=", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f61803d43333d41393f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f61803d43333d41393f3d20")), (hx("3d3f69736f2d383835392d313f513f61803d43333d41393f3d20"), "")
  assert_eq wd("Zm9=?utf-8?q?QW5k=?x-unknown?q?=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9=?utf-8?q?QW5k=?x-unknown?q?=?us-ascii?q?"), ("Zm9=?utf-8?q?QW5k=?x-unknown?q?=?us-ascii?q?", "")
  assert_eq wd("=?utf-8?b??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("?=?=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=?=?us-ascii?q?"), ("?=?=?us-ascii?q?", "")
  assert_eq wd("=?utf-8?b?=3F?= =?utf-8?q?=C3=A9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3F?= =?utf-8?q?=C3=A9?= "), ("=?utf-8?b?=3F?= é ", "")
  assert_eq wd("?==4=?utf-8?q??==C3=A9=?x-unknown?q?=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==4=?utf-8?q??==C3=A9=?x-unknown?q?=?utf-8?x?"), ("?==4=C3=A9=?x-unknown?q?=?utf-8?x?", "")
  assert_eq wd("=?utf-8?b??="), ("", "")
  assert_eq wdh("=?utf-8?b??="), ("", "")
  assert_eq wd(" =?UTF-8?B??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" =?UTF-8?B??="), (" ", "")
  assert_eq wd(hx("3d3f7574662d383f623f3d33463f3d2078203d3f7574662d383f623f80613f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f3d33463f3d2078203d3f7574662d383f623f80613f3d")), (hx("3d3f7574662d383f623f3d33463f3d2078203d3f7574662d383f623f80613f3d"), "")
  assert_eq wd("=?utf-8?x?=?\r\n ?=Zm9?=\r\n _=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=?\r\n ?=Zm9?=\r\n _=?"), ("=?utf-8?x?=?\r\n ?=Zm9?=\r\n _=?", "")
  assert_eq wd("=?utf-8?b?QW5kw6k=QW5k?=\r\n\t=?UTF-8?B??=\r\n\t=?utf-8?b?Zg==Zm9v=E9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?QW5kw6k=QW5k?=\r\n\t=?UTF-8?B??=\r\n\t=?utf-8?b?Zg==Zm9v=E9?= "), ("=?utf-8?b?QW5kw6k=QW5k?=\r\n\t\r\n\t=?utf-8?b?Zg==Zm9v=E9?= ", "")
  assert_eq wd("Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v"), ("Zm9v", "")
  assert_eq wd("=?us-ascii?q?=C3=A9Zg==a?=\r\n\t=?UTF-8?B?_Zg==Zg==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=C3=A9Zg==a?=\r\n\t=?UTF-8?B?_Zg==Zg==?="), ("=?us-ascii?q?=C3=A9Zg==a?=\r\n\t=?UTF-8?B?_Zg==Zg==?=", "")
  assert_eq wd("=?iso-8859-1?Q?====Zm9v=?x-unknown?q?=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?====Zm9v=?x-unknown?q?=?us-ascii?q?"), ("=?iso-8859-1?Q?====Zm9v=?x-unknown?q?=?us-ascii?q?", "")
  assert_eq wd("=?utf-8?b??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("QW5k=E9=?x-unknown?q?=====E9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k=E9=?x-unknown?q?=====E9?="), ("QW5k=E9=?x-unknown?q?=====E9?=", "")
}

test "vectors: word decoder 4" {
  assert_eq wd("=?UTF-8?B??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??= "), (" ", "")
  assert_eq wd("é=?UTF-8?B?plain?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é=?UTF-8?B?plain?="), ("é=?UTF-8?B?plain?=", "")
  assert_eq wd(hx("3d3f7574662d383f623f63773d3d3d33465157356b3f3d2078203d3f69736f2d383835392d313f513f5a673d3d3d4539613f3d20203d3f5554462d383f423f803d43333d41395f3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f63773d3d3d33465157356b3f3d2078203d3f69736f2d383835392d313f513f5a673d3d3d4539613f3d20203d3f5554462d383f423f803d43333d41395f3f3d2020")), (hx("3d3f7574662d383f623f63773d3d3d33465157356b3f3d2078203d3f69736f2d383835392d313f513f5a673d3d3d4539613f3d20203d3f5554462d383f423f803d43333d41395f3f3d2020"), "")
  assert_eq wd("a=?utf-8?q?_\n=?utf-8?x?a=4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=?utf-8?q?_\n=?utf-8?x?a=4"), ("a=?utf-8?q?_\n=?utf-8?x?a=4", "")
  assert_eq wd("=?us-ascii?q?QW5k=E9=E9?= =?utf-8?b?__Zm9v?= =?iso-8859-1?Q?Zm9v?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?QW5k=E9=E9?= =?utf-8?b?__Zm9v?= =?iso-8859-1?Q?Zm9v?=  "), ("QW5k�� =?utf-8?b?__Zm9v?= Zm9v  ", "")
  assert_eq wd("plain=zzplain=?x-unknown?q?=?utf-8?x?=4?=a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plain=zzplain=?x-unknown?q?=?utf-8?x?=4?=a"), ("plain=zzplain=?x-unknown?q?=?utf-8?x?=4?=a", "")
  assert_eq wd("=?us-ascii?q?=E9=E9?= x =?utf-8?q??= =?iso-8859-1?Q??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=E9=E9?= x =?utf-8?q??= =?iso-8859-1?Q??= x "), ("�� x  x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("=4w6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4w6k="), ("=4w6k=", "")
  assert_eq wd("=?utf-8?b?Zg==?==?us-ascii?q??=  =?utf-8?b?Zm9v_=C3=A9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zg==?==?us-ascii?q??=  =?utf-8?b?Zm9v_=C3=A9?= "), ("f  =?utf-8?b?Zm9v_=C3=A9?= ", "")
  assert_eq wd(" QW5kplain\nw6k==?utf-8?q?=E9_a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" QW5kplain\nw6k==?utf-8?q?=E9_a"), (" QW5kplain\nw6k==?utf-8?q?=E9_a", "")
  assert_eq wd("=?utf-8?q?_?==?iso-8859-1?Q?Zm9vZg==?= =?us-ascii?q?Zm9v=C3=A9Zg==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?_?==?iso-8859-1?Q?Zm9vZg==?= =?us-ascii?q?Zm9v=C3=A9Zg==?=  "), (" =?iso-8859-1?Q?Zm9vZg==?= =?us-ascii?q?Zm9v=C3=A9Zg==?=  ", "")
  assert_eq wd("=?=zz=zz_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?=zz=zz_"), ("=?=zz=zz_", "")
  assert_eq wd("=?iso-8859-1?Q?QW5k?= =?utf-8?b?Zg==a?= =?iso-8859-1?Q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?QW5k?= =?utf-8?b?Zg==a?= =?iso-8859-1?Q??=\r\n\t"), ("QW5k =?utf-8?b?Zg==a?= \r\n\t", "")
  assert_eq wd("Zm9v=?iso-8859-1?Q?w6k==4\nplain=?iso-8859-1?Q?=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v=?iso-8859-1?Q?w6k==4\nplain=?iso-8859-1?Q?=?x-unknown?q?"), ("Zm9v=?iso-8859-1?Q?w6k==4\nplain=?iso-8859-1?Q?=?x-unknown?q?", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f63773d3d5f3f3d20203d3f7574662d383f623f3d43333d413963773d3d613f3d3d3f5554462d383f423f3d3346803f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f63773d3d5f3f3d20203d3f7574662d383f623f3d43333d413963773d3d613f3d3d3f5554462d383f423f3d3346803f3d2020")), (hx("3d3f75732d61736369693f713f63773d3d5f3f3d20203d3f7574662d383f623f3d43333d413963773d3d613f3d3d3f5554462d383f423f3d3346803f3d2020"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= x "), (" x ", "")
  assert_eq wd("=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz"), ("=zz", "")
  assert_eq wd(hx("3d3f5554462d383f423f5157356b77366b3d803f3d3d3f5554462d383f423f80803d33463f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f5157356b77366b3d803f3d3d3f5554462d383f423f80803d33463f3d2020")), (hx("3d3f5554462d383f423f5157356b77366b3d803f3d3d3f5554462d383f423f80803d33463f3d2020"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q??= x =?utf-8?b?a?==?UTF-8?B?Zg==QW5k?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= x =?utf-8?b?a?==?UTF-8?B?Zg==QW5k?= "), (" x =?utf-8?b?a?==?UTF-8?B?Zg==QW5k?= ", "")
  assert_eq wd("_QW5k=C3=A9plain\nQW5kplainplain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_QW5k=C3=A9plain\nQW5kplainplain"), ("_QW5k=C3=A9plain\nQW5kplainplain", "")
  assert_eq wd(hx("3d3f7574662d383f713f3d45393f3d3d3f5554462d383f423f805a673d3d5a6d39763f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f3d45393f3d3d3f5554462d383f423f805a673d3d5a6d39763f3d20")), (hx("e93d3f5554462d383f423f805a673d3d5a6d39763f3d20"), "")
  assert_eq wd("plain_=?iso-8859-1?Q?_=4=?iso-8859-1?Q?=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plain_=?iso-8859-1?Q?_=4=?iso-8859-1?Q?=zz"), ("plain_=?iso-8859-1?Q?_=4=?iso-8859-1?Q?=zz", "")
  assert_eq wd("=?us-ascii?q??=  =?utf-8?b?Zm9v_Zg==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=  =?utf-8?b?Zm9v_Zg==?= x "), ("  =?utf-8?b?Zm9v_Zg==?= x ", "")
  assert_eq wd("\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n "), ("\r\n ", "")
  assert_eq wd("=?iso-8859-1?Q??="), ("", "")
  assert_eq wdh("=?iso-8859-1?Q??="), ("", "")
  assert_eq wd("?==?=E9=E9=?UTF-8?B?=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==?=E9=E9=?UTF-8?B?=?x-unknown?q?"), ("?==?=E9=E9=?UTF-8?B?=?x-unknown?q?", "")
  assert_eq wd(hx("3d3f7574662d383f713f803d45393f3d3d3f5554462d383f423f805a6d397677366b3d3f3d0d0a093d3f75732d61736369693f713f3d33463d43333d41393f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f803d45393f3d3d3f5554462d383f423f805a6d397677366b3d3f3d0d0a093d3f75732d61736369693f713f3d33463d43333d41393f3d20")), (hx("3d3f7574662d383f713f803d45393f3d3d3f5554462d383f423f805a6d397677366b3d3f3d0d0a093fefbfbdefbfbd20"), "")
  assert_eq wd("a=?utf-8?x?=?utf-8?x?Zm9vQW5k_?=_=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=?utf-8?x?=?utf-8?x?Zm9vQW5k_?=_=?utf-8?x?"), ("a=?utf-8?x?=?utf-8?x?Zm9vQW5k_?=_=?utf-8?x?", "")
  assert_eq wd("=?utf-8?b?Zg==Zm9vcw==?= =?utf-8?b?=3FZm9vw6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zg==Zm9vcw==?= =?utf-8?b?=3FZm9vw6k=?= x "), ("=?utf-8?b?Zg==Zm9vcw==?= =?utf-8?b?=3FZm9vw6k=?= x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f7574662d383f713f3f3d2078203d3f5554462d383f423f5a673d3d803d45393f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f3f3d2078203d3f5554462d383f423f5a673d3d803d45393f3d2020")), (hx("2078203d3f5554462d383f423f5a673d3d803d45393f3d2020"), "")
  assert_eq wd("=?_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?_"), ("=?_", "")
  assert_eq wd("=?UTF-8?B?_?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?_?=\r\n\t"), ("=?UTF-8?B?_?=\r\n\t", "")
  assert_eq wd("\r\n cw==Zg=?iso-8859-1?Q?=?=zz=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n cw==Zg=?iso-8859-1?Q?=?=zz=?us-ascii?q?"), ("\r\n cw==Zg=?iso-8859-1?Q?=?=zz=?us-ascii?q?", "")
  assert_eq wd("=?utf-8?b??= x =?iso-8859-1?Q?Zm9v=C3=A9=E9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??= x =?iso-8859-1?Q?Zm9v=C3=A9=E9?= x "), (" x Zm9vÃ©é x ", "")
  assert_eq wd("w6k==?x-unknown?q?w6k= =?x-unknown?q?\n\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k==?x-unknown?q?w6k= =?x-unknown?q?\n\n"), ("w6k==?x-unknown?q?w6k= =?x-unknown?q?\n\n", "")
  assert_eq wd(hx("3d3f5554462d383f423f3f3d203d3f7574662d383f713f803d43333d41393f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f3f3d203d3f7574662d383f713f803d43333d41393f3d20")), (hx("203d3f7574662d383f713f803d43333d41393f3d20"), "")
  assert_eq wd("w6k==?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k==?x-unknown?q?"), ("w6k==?x-unknown?q?", "")
  assert_eq wd("=?utf-8?q?cw==w6k=_?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?cw==w6k=_?= x "), ("=?utf-8?q?cw==w6k=_?= x ", "")
  assert_eq wd("=?UTF-8?B?_é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?_é"), ("=?UTF-8?B?_é", "")
  assert_eq wd("=?us-ascii?q?=3FZg==?= x =?UTF-8?B?Zg==w6k==E9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=3FZg==?= x =?UTF-8?B?Zg==w6k==E9?="), ("=?us-ascii?q?=3FZg==?= x =?UTF-8?B?Zg==w6k==E9?=", "")
  assert_eq wd("QW5kZm9=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5kZm9=?iso-8859-1?Q?"), ("QW5kZm9=?iso-8859-1?Q?", "")
  assert_eq wd("=?us-ascii?q?cw==__?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?cw==__?=\r\n\t"), ("=?us-ascii?q?cw==__?=\r\n\t", "")
  assert_eq wd("a?Zm9aZm9vplainw6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a?Zm9aZm9vplainw6k="), ("a?Zm9aZm9vplainw6k=", "")
  assert_eq wd("=?iso-8859-1?Q?a?=  =?utf-8?q?Zg==?=\r\n\t=?us-ascii?q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?a?=  =?utf-8?q?Zg==?=\r\n\t=?us-ascii?q??="), ("a  =?utf-8?q?Zg==?=\r\n\t", "")
  assert_eq wd("=4Zm9v_=?utf-8?q?\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4Zm9v_=?utf-8?q?\n"), ("=4Zm9v_=?utf-8?q?\n", "")
}

test "vectors: word decoder 5" {
  assert_eq wd("=?utf-8?b??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=  "), ("  ", "")
  assert_eq wd("=?iso-8859-1?Q?cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?cw=="), ("=?iso-8859-1?Q?cw==", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f5a6d39765a673d3d3f3d203d3f7574662d383f713f803f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f5a6d39765a673d3d3f3d203d3f7574662d383f713f803f3d2020")), (hx("3d3f75732d61736369693f713f5a6d39765a673d3d3f3d203d3f7574662d383f713f803f3d2020"), "")
  assert_eq wd(" Zm9 =?UTF-8?B?=C3=A9====?QW5kw6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" Zm9 =?UTF-8?B?=C3=A9====?QW5kw6k="), (" Zm9 =?UTF-8?B?=C3=A9====?QW5kw6k=", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f61803f3d203d3f75732d61736369693f713f5a6d39765a673d3d3d43333d41393f3d2078203d3f7574662d383f713f77366b3d3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f61803f3d203d3f75732d61736369693f713f5a6d39765a673d3d3d43333d41393f3d2078203d3f7574662d383f713f77366b3d3f3d2020")), (hx("3d3f69736f2d383835392d313f513f61803f3d203d3f75732d61736369693f713f5a6d39765a673d3d3d43333d41393f3d2078203d3f7574662d383f713f77366b3d3f3d2020"), "")
  assert_eq wd("=C3=A9\r\n =?utf-8?q? =E9Zg=?iso-8859-1?Q?=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9\r\n =?utf-8?q? =E9Zg=?iso-8859-1?Q?=zz"), ("=C3=A9\r\n =?utf-8?q? =E9Zg=?iso-8859-1?Q?=zz", "")
  assert_eq wd("=?UTF-8?B?_=3FZg==?= x =?utf-8?q?a?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?_=3FZg==?= x =?utf-8?q?a?="), ("=?UTF-8?B?_=3FZg==?= x a", "")
  assert_eq wd("\r\n =?us-ascii?q?\r\n cw==?=?UTF-8?B?Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n =?us-ascii?q?\r\n cw==?=?UTF-8?B?Zm9v"), ("\r\n =?us-ascii?q?\r\n cw==?=?UTF-8?B?Zm9v", "")
  assert_eq wd("=?UTF-8?B?Zm9vcw==cw==?= x =?utf-8?b?cw==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zm9vcw==cw==?= x =?utf-8?b?cw==?=\r\n\t"), ("=?UTF-8?B?Zm9vcw==cw==?= x s\r\n\t", "")
  assert_eq wd("Zm9vcw===E9cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9vcw===E9cw=="), ("Zm9vcw===E9cw==", "")
  assert_eq wd("=?UTF-8?B?_Zm9vZg==?= x =?iso-8859-1?Q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?_Zm9vZg==?= x =?iso-8859-1?Q??=  "), ("=?UTF-8?B?_Zm9vZg==?= x   ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q?=C3=A9?==?utf-8?b?cw==QW5kZm9v?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9?==?utf-8?b?cw==QW5kZm9v?=\r\n\t"), ("é=?utf-8?b?cw==QW5kZm9v?=\r\n\t", "")
  assert_eq wd("a=?=?utf-8?x?Zg=4=?_QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=?=?utf-8?x?Zg=4=?_QW5k"), ("a=?=?utf-8?x?Zg=4=?_QW5k", "")
  assert_eq wd("=?UTF-8?B?Zg==cw==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zg==cw==?= x "), ("=?UTF-8?B?Zg==cw==?= x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f7574662d383f623f5f3f3d20203d3f75732d61736369693f713f805a673d3d5f3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f5f3f3d20203d3f75732d61736369693f713f805a673d3d5f3f3d0d0a09")), (hx("3d3f7574662d383f623f5f3f3d20203d3f75732d61736369693f713f805a673d3d5f3f3d0d0a09"), "")
  assert_eq wd("=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9"), ("=C3=A9", "")
  assert_eq wd("=?utf-8?b?=3F?==?utf-8?q?QW5k?==?us-ascii?q?w6k=Zg==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3F?==?utf-8?q?QW5k?==?us-ascii?q?w6k=Zg==?= "), ("=?utf-8?b?=3F?=QW5k=?us-ascii?q?w6k=Zg==?= ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f5554462d383f423f5a6d397663773d3d3f3d203d3f7574662d383f623f803f3d0d0a093d3f69736f2d383835392d313f513f615a6d39765f3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f5a6d397663773d3d3f3d203d3f7574662d383f623f803f3d0d0a093d3f69736f2d383835392d313f513f615a6d39765f3f3d2020")), (hx("666f6f73203d3f7574662d383f623f803f3d0d0a09615a6d3976202020"), "")
  assert_eq wd("=?_?=Zm9v\n?=Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?_?=Zm9v\n?=Zm9v"), ("=?_?=Zm9v\n?=Zm9v", "")
  assert_eq wd("=?utf-8?q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("?QW5kéé=E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?QW5kéé=E9"), ("?QW5kéé=E9", "")
  assert_eq wd("=?UTF-8?B?Zg==?==?iso-8859-1?Q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zg==?==?iso-8859-1?Q??="), ("f", "")
  assert_eq wd(" "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" "), (" ", "")
  assert_eq wd("=?us-ascii?q?w6k==E9?= x =?utf-8?q?=E9Zg==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?w6k==E9?= x =?utf-8?q?=E9Zg==?= "), ("=?us-ascii?q?w6k==E9?= x =?utf-8?q?=E9Zg==?= ", "")
  assert_eq wd("=?UTF-8?B?Zg=?x-unknown?q? Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zg=?x-unknown?q? Zm9"), ("=?UTF-8?B?Zg=?x-unknown?q? Zm9", "")
  assert_eq wd(hx("3d3f7574662d383f623f8077366b3d3d45393f3d3d3f69736f2d383835392d313f513f3f3d20203d3f69736f2d383835392d313f513f5a673d3d3f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f8077366b3d3d45393f3d3d3f69736f2d383835392d313f513f3f3d20203d3f69736f2d383835392d313f513f5a673d3d3f3d20")), (hx("3d3f7574662d383f623f8077366b3d3d45393f3d20203d3f69736f2d383835392d313f513f5a673d3d3f3d20"), "")
  assert_eq wd("_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_"), ("_", "")
  assert_eq wd("=?utf-8?q??==?utf-8?q?Zg==aQW5k?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??==?utf-8?q?Zg==aQW5k?=  "), ("=?utf-8?q?Zg==aQW5k?=  ", "")
  assert_eq wd("=?utf-8?q?a====é=?utf-8?x??w6k=QW5ké"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?a====é=?utf-8?x??w6k=QW5ké"), ("=?utf-8?q?a====é=?utf-8?x??w6k=QW5ké", "")
  assert_eq wd("=?iso-8859-1?Q?Zg==cw==?= =?UTF-8?B?=E9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zg==cw==?= =?UTF-8?B?=E9?=  "), ("=?iso-8859-1?Q?Zg==cw==?= =?UTF-8?B?=E9?=  ", "")
  assert_eq wd("Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v"), ("Zm9v", "")
  assert_eq wd(hx("3d3f7574662d383f713f5a6d39763d33465157356b3f3d2078203d3f5554462d383f423f5a673d3d803f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5a6d39763d33465157356b3f3d2078203d3f5554462d383f423f5a673d3d803f3d20")), (hx("5a6d39763f5157356b2078203d3f5554462d383f423f5a673d3d803f3d20"), "")
  assert_eq wd("Zm9v?=?UTF-8?B?=4=E9QW5k===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v?=?UTF-8?B?=4=E9QW5k===="), ("Zm9v?=?UTF-8?B?=4=E9QW5k====", "")
  assert_eq wd("=?us-ascii?q?w6k=?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?w6k=?=\r\n\t"), ("=?us-ascii?q?w6k=?=\r\n\t", "")
  assert_eq wd("=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9"), ("=C3=A9", "")
  assert_eq wd("=?utf-8?q?=E9w6k=cw==?="), ("", "mime: invalid hex byte 0x77")
  assert_eq wdh("=?utf-8?q?=E9w6k=cw==?="), ("=?utf-8?q?=E9w6k=cw==?=", "")
  assert_eq wd("\n\n\n?=?=w6k==?x-unknown?q??=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n\n\n?=?=w6k==?x-unknown?q??=?utf-8?q?"), ("\n\n\n?=?=w6k==?x-unknown?q??=?utf-8?q?", "")
  assert_eq wd("=?iso-8859-1?Q?=E9_?=\r\n\t=?utf-8?q?Zg==?==?utf-8?q??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=E9_?=\r\n\t=?utf-8?q?Zg==?==?utf-8?q??= x "), ("é \r\n\t=?utf-8?q?Zg==?= x ", "")
  assert_eq wd("=E9plain=zzQW5kQW5kZm9v=E9=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9plain=zzQW5kQW5kZm9v=E9=?x-unknown?q?"), ("=E9plain=zzQW5kQW5kZm9v=E9=?x-unknown?q?", "")
  assert_eq wd("=?us-ascii?q?Zg==_Zm9v?=  =?utf-8?q?_=C3=A9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zg==_Zm9v?=  =?utf-8?q?_=C3=A9?= x "), ("=?us-ascii?q?Zg==_Zm9v?=   é x ", "")
  assert_eq wd("acw==é=zza"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("acw==é=zza"), ("acw==é=zza", "")
  assert_eq wd("=?utf-8?b?=C3=A9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=C3=A9?=\r\n\t"), ("=?utf-8?b?=C3=A9?=\r\n\t", "")
  assert_eq wd("=?us-ascii?q?=?x-unknown?q?====plainw6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=?x-unknown?q?====plainw6k="), ("=?us-ascii?q?=?x-unknown?q?====plainw6k=", "")
  assert_eq wd("=?iso-8859-1?Q?cw==a?="), ("", "mime: invalid hex byte 0x3d")
  assert_eq wdh("=?iso-8859-1?Q?cw==a?="), ("=?iso-8859-1?Q?cw==a?=", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f5554462d383f423f3d43333d41393f3d0d0a093d3f7574662d383f623f3d45393d3346803f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f3d43333d41393f3d0d0a093d3f7574662d383f623f3d45393d3346803f3d207820")), (hx("3d3f5554462d383f423f3d43333d41393f3d0d0a093d3f7574662d383f623f3d45393d3346803f3d207820"), "")
  assert_eq wd("Zm9vQW5ka=?us-ascii?q?w6k=Zm9v?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9vQW5ka=?us-ascii?q?w6k=Zm9v?"), ("Zm9vQW5ka=?us-ascii?q?w6k=Zm9v?", "")
}

test "vectors: word decoder 6" {
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f5f3f3d3d3f69736f2d383835392d313f513f5a6d39763d33463d33463f3d0d0a093d3f69736f2d383835392d313f513f3d4539803f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f5f3f3d3d3f69736f2d383835392d313f513f5a6d39763d33463d33463f3d0d0a093d3f69736f2d383835392d313f513f3d4539803f3d")), (hx("205a6d39763f3f0d0a093d3f69736f2d383835392d313f513f3d4539803f3d"), "")
  assert_eq wd("\r\n ====a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n ====a"), ("\r\n ====a", "")
  assert_eq wd(hx("3d3f7574662d383f623f8077366b3d5a6d39763f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f8077366b3d5a6d39763f3d0d0a09")), (hx("3d3f7574662d383f623f8077366b3d5a6d39763f3d0d0a09"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B?aa?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?aa?= "), ("=?UTF-8?B?aa?= ", "")
  assert_eq wd("?=cw===E9 =?UTF-8?B?=====4Zm9v===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=cw===E9 =?UTF-8?B?=====4Zm9v===="), ("?=cw===E9 =?UTF-8?B?=====4Zm9v====", "")
  assert_eq wd("=?UTF-8?B?w6k=QW5k?="), ("", "illegal base64 data at input byte 4")
  assert_eq wdh("=?UTF-8?B?w6k=QW5k?="), ("=?UTF-8?B?w6k=QW5k?=", "")
  assert_eq wd("QW5k====Zm9v=?x-unknown?q??==4 "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k====Zm9v=?x-unknown?q??==4 "), ("", "mime: unhandled charset \"x-unknown\"")
  assert_eq wd("=?utf-8?q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??=  "), ("  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?b??=\r\n\t=?us-ascii?q?a=3Fa?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t=?us-ascii?q?a=3Fa?=\r\n\t"), ("a?a\r\n\t", "")
  assert_eq wd("=====?utf-8?q?=?iso-8859-1?Q?=E9plainé"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=====?utf-8?q?=?iso-8859-1?Q?=E9plainé"), ("=====?utf-8?q?=?iso-8859-1?Q?=E9plainé", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f3d4539803f3d20203d3f7574662d383f623f3d45395a673d3d3f3d2078203d3f7574662d383f623f3d3346613f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f3d4539803f3d20203d3f7574662d383f623f3d45395a673d3d3f3d2078203d3f7574662d383f623f3d3346613f3d2020")), (hx("3d3f75732d61736369693f713f3d4539803f3d20203d3f7574662d383f623f3d45395a673d3d3f3d2078203d3f7574662d383f623f3d3346613f3d2020"), "")
  assert_eq wd("Zm9v=zz===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v=zz===="), ("Zm9v=zz====", "")
  assert_eq wd("=?iso-8859-1?Q??= x =?utf-8?b??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??= x =?utf-8?b??=  "), (" x   ", "")
  assert_eq wd("=?====?==?iso-8859-1?Q?=C3=A9=C3=A9=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?====?==?iso-8859-1?Q?=C3=A9=C3=A9=?"), ("=?====?==?iso-8859-1?Q?=C3=A9=C3=A9=?", "")
  assert_eq wd("=?utf-8?b?=3F?= x =?UTF-8?B?Zm9v?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3F?= x =?UTF-8?B?Zm9v?="), ("=?utf-8?b?=3F?= x foo", "")
  assert_eq wd("\r\n plain=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n plain=?iso-8859-1?Q?"), ("\r\n plain=?iso-8859-1?Q?", "")
  assert_eq wd("=?UTF-8?B?w6k=cw===E9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?w6k=cw===E9?= x "), ("=?UTF-8?B?w6k=cw===E9?= x ", "")
  assert_eq wd("=E9=?utf-8?x?=?UTF-8?B?=E9=?us-ascii?q?Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9=?utf-8?x?=?UTF-8?B?=E9=?us-ascii?q?Zm9"), ("=E9=?utf-8?x?=?UTF-8?B?=E9=?us-ascii?q?Zm9", "")
  assert_eq wd("=?iso-8859-1?Q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??=  "), ("  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q?a?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?a?= x "), ("a x ", "")
  assert_eq wd("é\r\n QW5kZm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é\r\n QW5kZm9v"), ("é\r\n QW5kZm9v", "")
  assert_eq wd("=?UTF-8?B??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??= "), (" ", "")
  assert_eq wd("=?utf-8?q?=?QW5kplainZg cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=?QW5kplainZg cw=="), ("=?utf-8?q?=?QW5kplainZg cw==", "")
  assert_eq wd("=?iso-8859-1?Q?a_Zm9v?= =?utf-8?q?cw===C3=A9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?a_Zm9v?= =?utf-8?q?cw===C3=A9?= x "), ("a Zm9v =?utf-8?q?cw===C3=A9?= x ", "")
  assert_eq wd("=?utf-8?x??=plain\r\n w6k=cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x??=plain\r\n w6k=cw=="), ("=?utf-8?x??=plain\r\n w6k=cw==", "")
  assert_eq wd("=?UTF-8?B?aZg==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?aZg==?= "), ("=?UTF-8?B?aZg==?= ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q??=  =?iso-8859-1?Q?=3FZm9v=C3=A9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??=  =?iso-8859-1?Q?=3FZm9v=C3=A9?= "), ("?Zm9vÃ© ", "")
  assert_eq wd("=zz=?utf-8?q?\r\n cw==w6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz=?utf-8?q?\r\n cw==w6k="), ("=zz=?utf-8?q?\r\n cw==w6k=", "")
  assert_eq wd("=?us-ascii?q??=\r\n\t=?utf-8?q?Zm9v?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=\r\n\t=?utf-8?q?Zm9v?= x "), ("Zm9v x ", "")
  assert_eq wd("=zz=4_=E9w6k=_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz=4_=E9w6k=_"), ("=zz=4_=E9w6k=_", "")
  assert_eq wd("=?UTF-8?B?cw==Zg==cw==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?cw==Zg==cw==?=  "), ("=?UTF-8?B?cw==Zg==cw==?=  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q?cw==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?cw==?=\r\n\t"), ("=?utf-8?q?cw==?=\r\n\t", "")
  assert_eq wd("=4=?us-ascii?q?QW5k?=w6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4=?us-ascii?q?QW5k?=w6k="), ("=4QW5kw6k=", "")
  assert_eq wd(hx("3d3f7574662d383f713f5157356b5f5a673d3d3f3d3d3f75732d61736369693f713f803d33465a673d3d3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5157356b5f5a673d3d3f3d3d3f75732d61736369693f713f803d33465a673d3d3f3d0d0a09")), (hx("3d3f7574662d383f713f5157356b5f5a673d3d3f3d3d3f75732d61736369693f713f803d33465a673d3d3f3d0d0a09"), "")
  assert_eq wd("a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a"), ("a", "")
  assert_eq wd("=?iso-8859-1?Q?=3FQW5k?=\r\n\t=?utf-8?q?w6k=?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=3FQW5k?=\r\n\t=?utf-8?q?w6k=?=\r\n\t"), ("?QW5k\r\n\t=?utf-8?q?w6k=?=\r\n\t", "")
  assert_eq wd("=?x-unknown?q?Zg=?x-unknown?q?_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?Zg=?x-unknown?q?_"), ("=?x-unknown?q?Zg=?x-unknown?q?_", "")
  assert_eq wd(hx("3d3f7574662d383f713f8077366b3d3f3d0d0a093d3f5554462d383f423f803f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f8077366b3d3f3d0d0a093d3f5554462d383f423f803f3d")), (hx("3d3f7574662d383f713f8077366b3d3f3d0d0a093d3f5554462d383f423f803f3d"), "")
  assert_eq wd("=====?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=====?"), ("=====?", "")
  assert_eq wd("=?utf-8?q??==?utf-8?b?=E9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??==?utf-8?b?=E9?="), ("=?utf-8?b?=E9?=", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q??==?iso-8859-1?Q?w6k=w6k==3F?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??==?iso-8859-1?Q?w6k=w6k==3F?=\r\n\t"), ("=?iso-8859-1?Q?w6k=w6k==3F?=\r\n\t", "")
  assert_eq wd("cw===?iso-8859-1?Q?=zz=zzZm9=?utf-8?x?_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw===?iso-8859-1?Q?=zz=zzZm9=?utf-8?x?_"), ("cw===?iso-8859-1?Q?=zz=zzZm9=?utf-8?x?_", "")
  assert_eq wd(hx("3d3f5554462d383f423f5f3d3346803f3d203d3f5554462d383f423f613f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f5f3d3346803f3d203d3f5554462d383f423f613f3d207820")), (hx("3d3f5554462d383f423f5f3d3346803f3d203d3f5554462d383f423f613f3d207820"), "")
  assert_eq wd("=?====?=Zm9??==zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?====?=Zm9??==zz"), ("=?====?=Zm9??==zz", "")
}

test "vectors: word decoder 7" {
  assert_eq wd("=?utf-8?q?w6k=w6k==3F?=\r\n\t=?iso-8859-1?Q?Zg===C3=A9Zg==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?w6k=w6k==3F?=\r\n\t=?iso-8859-1?Q?Zg===C3=A9Zg==?=  "), ("=?utf-8?q?w6k=w6k==3F?=\r\n\t=?iso-8859-1?Q?Zg===C3=A9Zg==?=  ", "")
  assert_eq wd("=E9=====?us-ascii?q?=?us-ascii?q?é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9=====?us-ascii?q?=?us-ascii?q?é"), ("=E9=====?us-ascii?q?=?us-ascii?q?é", "")
  assert_eq wd("=?utf-8?q?=E9a_?=\r\n\t=?UTF-8?B??= =?utf-8?q?=3F=C3=A9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=E9a_?=\r\n\t=?UTF-8?B??= =?utf-8?q?=3F=C3=A9?= "), (hx("e961203fc3a920"), "")
  assert_eq wd("?é=E9=zz?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?é=E9=zz?="), ("?é=E9=zz?=", "")
  assert_eq wd("=?iso-8859-1?Q?=C3=A9=E9?= x =?utf-8?b??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=C3=A9=E9?= x =?utf-8?b??= "), ("Ã©é x  ", "")
  assert_eq wd("=?utf-8?x?cw==QW5k \r\n Zg_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?cw==QW5k \r\n Zg_"), ("=?utf-8?x?cw==QW5k \r\n Zg_", "")
  assert_eq wd("=?utf-8?q?=C3=A9cw==?==?utf-8?b?Zm9vQW5kcw==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9cw==?==?utf-8?b?Zm9vQW5kcw==?="), ("=?utf-8?q?=C3=A9cw==?=fooAnds", "")
  assert_eq wd("éé\r\n =?x-unknown?q?QW5k=?utf-8?x?=====?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("éé\r\n =?x-unknown?q?QW5k=?utf-8?x?=====?utf-8?q?"), ("éé\r\n =?x-unknown?q?QW5k=?utf-8?x?=====?utf-8?q?", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f803d45393d43333d41393f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f803d45393d43333d41393f3d")), (hx("3d3f69736f2d383835392d313f513f803d45393d43333d41393f3d"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q?Zg==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zg==?="), ("=?us-ascii?q?Zg==?=", "")
  assert_eq wd("\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n"), ("\n", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f803f3d203d3f75732d61736369693f713f3d33463f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f803f3d203d3f75732d61736369693f713f3d33463f3d207820")), (hx("3d3f69736f2d383835392d313f513f803f3d203f207820"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B??= x =?us-ascii?q?aZg==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??= x =?us-ascii?q?aZg==?= "), (" x =?us-ascii?q?aZg==?= ", "")
  assert_eq wd("=?us-ascii?q?\n=zzZm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?\n=zzZm9v"), ("=?us-ascii?q?\n=zzZm9v", "")
  assert_eq wd("=?us-ascii?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= "), (" ", "")
  assert_eq wd("=?utf-8?x?a=C3=A9=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?a=C3=A9=C3=A9"), ("=?utf-8?x?a=C3=A9=C3=A9", "")
  assert_eq wd("=?iso-8859-1?Q??= x =?UTF-8?B?cw==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??= x =?UTF-8?B?cw==?=\r\n\t"), (" x s\r\n\t", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q?=3FZg==cw==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3FZg==cw==?=\r\n\t"), ("=?utf-8?q?=3FZg==cw==?=\r\n\t", "")
  assert_eq wd("?w6k=\nZm9====?=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?w6k=\nZm9====?=?"), ("?w6k=\nZm9====?=?", "")
  assert_eq wd("=?utf-8?q?=3F?= =?utf-8?b?QW5k?= x =?us-ascii?q?Zg===E9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3F?= =?utf-8?b?QW5k?= x =?us-ascii?q?Zg===E9?="), ("?And x =?us-ascii?q?Zg===E9?=", "")
  assert_eq wd("=====?_ "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=====?_ "), ("=====?_ ", "")
  assert_eq wd("=?iso-8859-1?Q?Zg==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zg==?=\r\n\t"), ("=?iso-8859-1?Q?Zg==?=\r\n\t", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f7574662d383f623f77366b3d805157356b3f3d20203d3f7574662d383f623f3f3d0d0a093d3f7574662d383f713f5a6d3976613f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f77366b3d805157356b3f3d20203d3f7574662d383f623f3f3d0d0a093d3f7574662d383f713f5a6d3976613f3d")), (hx("3d3f7574662d383f623f77366b3d805157356b3f3d20205a6d397661"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q?Zg==?=  =?utf-8?b??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zg==?=  =?utf-8?b??="), ("=?us-ascii?q?Zg==?=  ", "")
  assert_eq wd("=====C3=A9_w6k======C3=A9Zm9 é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=====C3=A9_w6k======C3=A9Zm9 é"), ("=====C3=A9_w6k======C3=A9Zm9 é", "")
  assert_eq wd("=?iso-8859-1?Q?cw==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?cw==?=\r\n\t"), ("=?iso-8859-1?Q?cw==?=\r\n\t", "")
  assert_eq wd("=?utf-8?x?=zzZm9vé=?x-unknown?q?_=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=zzZm9vé=?x-unknown?q?_=C3=A9"), ("=?utf-8?x?=zzZm9vé=?x-unknown?q?_=C3=A9", "")
  assert_eq wd("=?utf-8?b?=E9?= x =?UTF-8?B?QW5kZg==?= =?utf-8?b?Zm9vw6k=?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=E9?= x =?UTF-8?B?QW5kZg==?= =?utf-8?b?Zm9vw6k=?=  "), ("=?utf-8?b?=E9?= x Andffooé  ", "")
  assert_eq wd("=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?"), ("=?utf-8?q?", "")
  assert_eq wd(hx("3d3f5554462d383f423f77366b3d805a6d39763f3d203d3f69736f2d383835392d313f513f63773d3d3d45395157356b3f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f77366b3d805a6d39763f3d203d3f69736f2d383835392d313f513f63773d3d3d45395157356b3f3d")), (hx("3d3f5554462d383f423f77366b3d805a6d39763f3d203d3f69736f2d383835392d313f513f63773d3d3d45395157356b3f3d"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f7574662d383f713f5157356b803f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5157356b803f3d20")), (hx("3d3f7574662d383f713f5157356b803f3d20"), "")
  assert_eq wd("\nZm9=?us-ascii?q?=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\nZm9=?us-ascii?q?=C3=A9"), ("\nZm9=?us-ascii?q?=C3=A9", "")
  assert_eq wd("=?us-ascii?q?w6k=a?= x =?utf-8?q?QW5kw6k=cw==?==?iso-8859-1?Q?cw==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?w6k=a?= x =?utf-8?q?QW5kw6k=cw==?==?iso-8859-1?Q?cw==?= "), ("=?us-ascii?q?w6k=a?= x =?utf-8?q?QW5kw6k=cw==?==?iso-8859-1?Q?cw==?= ", "")
  assert_eq wd("Zm9v====\r\n =?x-unknown?q?plain?=\n\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v====\r\n =?x-unknown?q?plain?=\n\n"), ("", "mime: unhandled charset \"x-unknown\"")
  assert_eq wd("=?utf-8?q?=E9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=E9?= x "), (hx("e9207820"), "")
  assert_eq wd("QW5kQW5k "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5kQW5k "), ("QW5kQW5k ", "")
  assert_eq wd(hx("3d3f7574662d383f713f5f3d43333d4139613f3d20203d3f75732d61736369693f713f3d45395a6d3976803f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5f3d43333d4139613f3d20203d3f75732d61736369693f713f3d45395a6d3976803f3d0d0a09")), (hx("20c3a96120203d3f75732d61736369693f713f3d45395a6d3976803f3d0d0a09"), "")
  assert_eq wd("QW5k=zz\n=C3=A9_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k=zz\n=C3=A9_"), ("QW5k=zz\n=C3=A9_", "")
  assert_eq wd("=?iso-8859-1?Q??=  =?utf-8?q?a=C3=A9=C3=A9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??=  =?utf-8?q?a=C3=A9=C3=A9?="), ("aéé", "")
  assert_eq wd("é=?utf-8?q?Zm9v=?iso-8859-1?Q?QW5k====cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é=?utf-8?q?Zm9v=?iso-8859-1?Q?QW5k====cw=="), ("é=?utf-8?q?Zm9v=?iso-8859-1?Q?QW5k====cw==", "")
  assert_eq wd("=?us-ascii?q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("=?utf-8?q?plainaZm9v?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?plainaZm9v?"), ("=?utf-8?q?plainaZm9v?", "")
  assert_eq wd("=?utf-8?q?a=3F?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?a=3F?= "), ("a? ", "")
  assert_eq wd("=E9cw===?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9cw===?UTF-8?B?"), ("=E9cw===?UTF-8?B?", "")
}

test "vectors: word decoder 8" {
  assert_eq wd("=?us-ascii?q?Zg==?=\r\n\t=?iso-8859-1?Q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zg==?=\r\n\t=?iso-8859-1?Q??= "), ("=?us-ascii?q?Zg==?=\r\n\t ", "")
  assert_eq wd(" Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" Zm9v"), (" Zm9v", "")
  assert_eq wd("=?us-ascii?q?cw==cw===C3=A9?=  =?UTF-8?B?w6k=Zm9vQW5k?=  =?utf-8?b?QW5ka=E9?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?cw==cw===C3=A9?=  =?UTF-8?B?w6k=Zm9vQW5k?=  =?utf-8?b?QW5ka=E9?= "), ("=?us-ascii?q?cw==cw===C3=A9?=  =?UTF-8?B?w6k=Zm9vQW5k?=  =?utf-8?b?QW5ka=E9?= ", "")
  assert_eq wd("=??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=??="), ("=??=", "")
  assert_eq wd(hx("3d3f7574662d383f713f3d43333d4139803d43333d41393f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f3d43333d4139803d43333d41393f3d2020")), (hx("3d3f7574662d383f713f3d43333d4139803d43333d41393f3d2020"), "")
  assert_eq wd("\r\n ===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n ===="), ("\r\n ====", "")
  assert_eq wd("=?utf-8?b?=E9aa?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=E9aa?= x "), ("=?utf-8?b?=E9aa?= x ", "")
  assert_eq wd("=?utf-8?x?=?utf-8?q?Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=?utf-8?q?Zm9"), ("=?utf-8?x?=?utf-8?q?Zm9", "")
  assert_eq wd("=?us-ascii?q?QW5k?=  =?utf-8?q?Zg==?=  =?utf-8?q?=C3=A9=E9=C3=A9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?QW5k?=  =?utf-8?q?Zg==?=  =?utf-8?q?=C3=A9=E9=C3=A9?=\r\n\t"), (hx("5157356b20203d3f7574662d383f713f5a673d3d3f3d2020c3a9e9c3a90d0a09"), "")
  assert_eq wd("ZgZg plain=?Zg=?Zg=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("ZgZg plain=?Zg=?Zg=?"), ("ZgZg plain=?Zg=?Zg=?", "")
  assert_eq wd("=?us-ascii?q??=\r\n\t=?UTF-8?B?Zg==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=\r\n\t=?UTF-8?B?Zg==?="), ("f", "")
  assert_eq wd("plainplainZm9v=C3=A9a=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plainplainZm9v=C3=A9a=?"), ("plainplainZm9v=C3=A9a=?", "")
  assert_eq wd("=?UTF-8?B?w6k=w6k=?=  =?utf-8?q?w6k=Zg==Zg==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?w6k=w6k=?=  =?utf-8?q?w6k=Zg==Zg==?="), ("=?UTF-8?B?w6k=w6k=?=  =?utf-8?q?w6k=Zg==Zg==?=", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q??=  =?utf-8?b?=E9a=E9?= x =?UTF-8?B?Zm9vcw==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??=  =?utf-8?b?=E9a=E9?= x =?UTF-8?B?Zm9vcw==?=  "), ("  =?utf-8?b?=E9a=E9?= x foos  ", "")
  assert_eq wd("=?UTF-8?B?cw===E9=?us-ascii?q?Zg=?utf-8?x?Zg=E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?cw===E9=?us-ascii?q?Zg=?utf-8?x?Zg=E9"), ("=?UTF-8?B?cw===E9=?us-ascii?q?Zg=?utf-8?x?Zg=E9", "")
  assert_eq wd("=?utf-8?b??=\r\n\t=?iso-8859-1?Q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t=?iso-8859-1?Q??="), ("", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?iso-8859-1?Q?Zm9v?= =?utf-8?q?=E9Zg==_?=  =?us-ascii?q?=E9a?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zm9v?= =?utf-8?q?=E9Zg==_?=  =?us-ascii?q?=E9a?= x "), ("Zm9v =?utf-8?q?=E9Zg==_?=  �a x ", "")
  assert_eq wd(" =?x-unknown?q?=zz "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" =?x-unknown?q?=zz "), (" =?x-unknown?q?=zz ", "")
  assert_eq wd("=?us-ascii?q?w6k==3Fa?= x =?us-ascii?q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?w6k==3Fa?= x =?us-ascii?q??=  "), ("=?us-ascii?q?w6k==3Fa?= x   ", "")
  assert_eq wd("=?utf-8?x?cw== ?=?UTF-8?B?Zm9Zm9plain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?cw== ?=?UTF-8?B?Zm9Zm9plain"), ("=?utf-8?x?cw== ?=?UTF-8?B?Zm9Zm9plain", "")
  assert_eq wd("=?utf-8?q?=3Fcw==?=\r\n\t=?iso-8859-1?Q?aaZm9v?= =?utf-8?q?QW5kcw==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3Fcw==?=\r\n\t=?iso-8859-1?Q?aaZm9v?= =?utf-8?q?QW5kcw==?=\r\n\t"), ("=?utf-8?q?=3Fcw==?=\r\n\taaZm9v =?utf-8?q?QW5kcw==?=\r\n\t", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?iso-8859-1?Q?a?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?a?=  "), ("a  ", "")
  assert_eq wd("a=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=?utf-8?x?"), ("a=?utf-8?x?", "")
  assert_eq wd("=?UTF-8?B?_=C3=A9=3F?==?us-ascii?q?Zm9v?= x =?UTF-8?B?_Zm9vZg==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?_=C3=A9=3F?==?us-ascii?q?Zm9v?= x =?UTF-8?B?_Zm9vZg==?=\r\n\t"), ("=?UTF-8?B?_=C3=A9=3F?=Zm9v x =?UTF-8?B?_Zm9vZg==?=\r\n\t", "")
  assert_eq wd("w6k==?UTF-8?B?Zm9?= a=?utf-8?x?Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k==?UTF-8?B?Zm9?= a=?utf-8?x?Zm9v"), ("w6k==?UTF-8?B?Zm9?= a=?utf-8?x?Zm9v", "")
  assert_eq wd("=?utf-8?b?=3F?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3F?= "), ("=?utf-8?b?=3F?= ", "")
  assert_eq wd(" ?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" ?="), (" ?=", "")
  assert_eq wd("=?us-ascii?q?Zg==cw==?= =?UTF-8?B?_=E9?=\r\n\t=?us-ascii?q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zg==cw==?= =?UTF-8?B?_=E9?=\r\n\t=?us-ascii?q??="), ("=?us-ascii?q?Zg==cw==?= =?UTF-8?B?_=E9?=\r\n\t", "")
  assert_eq wd("=?iso-8859-1?Q? w6k==?utf-8?x?=C3=A9=?UTF-8?B?=====?utf-8?x?plain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q? w6k==?utf-8?x?=C3=A9=?UTF-8?B?=====?utf-8?x?plain"), ("=?iso-8859-1?Q? w6k==?utf-8?x?=C3=A9=?UTF-8?B?=====?utf-8?x?plain", "")
  assert_eq wd("=?utf-8?q?=3Fw6k=?= x =?utf-8?b??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3Fw6k=?= x =?utf-8?b??= "), ("=?utf-8?q?=3Fw6k=?= x  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f5554462d383f423f5157356b3f3d0d0a093d3f69736f2d383835392d313f513f805a6d39765f3f3d3d3f7574662d383f713f613f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f5157356b3f3d0d0a093d3f69736f2d383835392d313f513f805a6d39765f3f3d3d3f7574662d383f713f613f3d207820")), (hx("416e640d0a093d3f69736f2d383835392d313f513f805a6d39765f3f3d61207820"), "")
  assert_eq wd("_=4=?utf-8?q??=?QW5k=?us-ascii?q?=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_=4=?utf-8?q??=?QW5k=?us-ascii?q?=zz"), ("_=4?QW5k=?us-ascii?q?=zz", "")
  assert_eq wd("=?iso-8859-1?Q?Zm9v?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zm9v?=\r\n\t"), ("Zm9v\r\n\t", "")
  assert_eq wd("=?iso-8859-1?Q?=?=zz=C3=A9Zm9=?UTF-8?B??"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=?=zz=C3=A9Zm9=?UTF-8?B??"), ("=?iso-8859-1?Q?=?=zz=C3=A9Zm9=?UTF-8?B??", "")
  assert_eq wd("=?us-ascii?q?=C3=A9?=  =?utf-8?b?_?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=C3=A9?=  =?utf-8?b?_?="), ("��  =?utf-8?b?_?=", "")
  assert_eq wd("plain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plain"), ("plain", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f3d334663773d3d803f3d2078203d3f5554462d383f423f615157356b63773d3d3f3d2078203d3f75732d61736369693f713f3f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f3d334663773d3d803f3d2078203d3f5554462d383f423f615157356b63773d3d3f3d2078203d3f75732d61736369693f713f3f3d20")), (hx("3d3f75732d61736369693f713f3d334663773d3d803f3d2078203d3f5554462d383f423f615157356b63773d3d3f3d20782020"), "")
  assert_eq wd("=C3=A9===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9===="), ("=C3=A9====", "")
  assert_eq wd("=?iso-8859-1?Q??=\r\n\t=?utf-8?b?w6k==C3=A9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??=\r\n\t=?utf-8?b?w6k==C3=A9?=\r\n\t"), ("\r\n\t=?utf-8?b?w6k==C3=A9?=\r\n\t", "")
  assert_eq wd("?QW5k=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?QW5k=?us-ascii?q?"), ("?QW5k=?us-ascii?q?", "")
  assert_eq wd("=?utf-8?b?QW5k?= x =?us-ascii?q?Zg==w6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?QW5k?= x =?us-ascii?q?Zg==w6k=?= x "), ("And x =?us-ascii?q?Zg==w6k=?= x ", "")
  assert_eq wd("w6k=?=?=C3=A9cw==\r\n ??Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k=?=?=C3=A9cw==\r\n ??Zm9"), ("w6k=?=?=C3=A9cw==\r\n ??Zm9", "")
  assert_eq wd("=?utf-8?b?=3F?==?utf-8?q??=  =?utf-8?b?QW5kw6k=?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=3F?==?utf-8?q??=  =?utf-8?b?QW5kw6k=?=  "), ("=?utf-8?b?=3F?=Andé  ", "")
  assert_eq wd("a=?us-ascii?q?=?x-unknown?q?é=E9\r\n \n=E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=?us-ascii?q?=?x-unknown?q?é=E9\r\n \n=E9"), ("a=?us-ascii?q?=?x-unknown?q?é=E9\r\n \n=E9", "")
}

test "vectors: word decoder 9" {
  assert_eq wd("=?utf-8?b??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("aplain=4\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("aplain=4\r\n "), ("aplain=4\r\n ", "")
  assert_eq wd("=?utf-8?b?=E9=E9_?=  =?UTF-8?B?cw==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=E9=E9_?=  =?UTF-8?B?cw==?=  "), ("=?utf-8?b?=E9=E9_?=  s  ", "")
  assert_eq wd("é=E9?w6k=?=E9acw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é=E9?w6k=?=E9acw=="), ("é=E9?w6k=?=E9acw==", "")
  assert_eq wd("=?us-ascii?q??= =?utf-8?b?cw==QW5k?= =?utf-8?b?Zm9va?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= =?utf-8?b?cw==QW5k?= =?utf-8?b?Zm9va?="), (" =?utf-8?b?cw==QW5k?= =?utf-8?b?Zm9va?=", "")
  assert_eq wd("Zm9?=?=====zz=E9Zm9v\r\n =?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9?=?=====zz=E9Zm9v\r\n =?utf-8?x?"), ("Zm9?=?=====zz=E9Zm9v\r\n =?utf-8?x?", "")
  assert_eq wd("=?iso-8859-1?Q??= =?iso-8859-1?Q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??= =?iso-8859-1?Q??= "), (" ", "")
  assert_eq wd("=? \n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=? \n"), ("=? \n", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f3f3d20203d3f75732d61736369693f713f5a673d3d803d33463f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f3f3d20203d3f75732d61736369693f713f5a673d3d803d33463f3d207820")), (hx("20203d3f75732d61736369693f713f5a673d3d803d33463f3d207820"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?us-ascii?q?Zg==Zg==?= =?utf-8?b?=3Fa?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zg==Zg==?= =?utf-8?b?=3Fa?= "), ("=?us-ascii?q?Zg==Zg==?= =?utf-8?b?=3Fa?= ", "")
  assert_eq wd("=?iso-8859-1?Q?a=C3=A9QW5k=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?a=C3=A9QW5k=?utf-8?q?"), ("=?iso-8859-1?Q?a=C3=A9QW5k=?utf-8?q?", "")
  assert_eq wd("=?iso-8859-1?Q?Zg==cw==?=  =?utf-8?b?_cw==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?Zg==cw==?=  =?utf-8?b?_cw==?= "), ("=?iso-8859-1?Q?Zg==cw==?=  =?utf-8?b?_cw==?= ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q?=C3=A9w6k=?= x =?UTF-8?B?QW5kcw==cw==?=\r\n\t=?utf-8?b?=3F?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9w6k=?= x =?UTF-8?B?QW5kcw==cw==?=\r\n\t=?utf-8?b?=3F?= "), ("=?utf-8?q?=C3=A9w6k=?= x =?UTF-8?B?QW5kcw==cw==?=\r\n\t=?utf-8?b?=3F?= ", "")
  assert_eq wd("_é=?iso-8859-1?Q?cw===4Zm9aé=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_é=?iso-8859-1?Q?cw===4Zm9aé=?us-ascii?q?"), ("_é=?iso-8859-1?Q?cw===4Zm9aé=?us-ascii?q?", "")
  assert_eq wd("=?us-ascii?q?cw==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?cw==?="), ("=?us-ascii?q?cw==?=", "")
  assert_eq wd("_?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_?"), ("_?", "")
  assert_eq wd("=?utf-8?q?_Zg==cw==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?_Zg==cw==?=  "), ("=?utf-8?q?_Zg==cw==?=  ", "")
  assert_eq wd("=?utf-8?x?=?us-ascii?q?Zm9v=C3=A9=?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=?us-ascii?q?Zm9v=C3=A9=?UTF-8?B?"), ("=?utf-8?x?=?us-ascii?q?Zm9v=C3=A9=?UTF-8?B?", "")
  assert_eq wd(hx("3d3f7574662d383f713f803d45393f3d3d3f5554462d383f423f5157356b3f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f803d45393f3d3d3f5554462d383f423f5157356b3f3d2020")), (hx("3d3f7574662d383f713f803d45393f3d416e642020"), "")
  assert_eq wd("\r\n =?iso-8859-1?Q? "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n =?iso-8859-1?Q? "), ("\r\n =?iso-8859-1?Q? ", "")
  assert_eq wd("=?utf-8?q?a=E9?=\r\n\t=?iso-8859-1?Q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?a=E9?=\r\n\t=?iso-8859-1?Q??=\r\n\t"), (hx("61e90d0a09"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f5554462d383f423f8063773d3d3f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f8063773d3d3f3d207820")), (hx("3d3f5554462d383f423f8063773d3d3f3d207820"), "")
  assert_eq wd("=E9=?us-ascii?q?cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9=?us-ascii?q?cw=="), ("=E9=?us-ascii?q?cw==", "")
  assert_eq wd(hx("3d3f5554462d383f423f77366b3d803f3d2078203d3f7574662d383f623f3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f77366b3d803f3d2078203d3f7574662d383f623f3f3d0d0a09")), (hx("3d3f5554462d383f423f77366b3d803f3d2078200d0a09"), "")
  assert_eq wd("=?cw==QW5k?Zm9cw===?a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?cw==QW5k?Zm9cw===?a"), ("=?cw==QW5k?Zm9cw===?a", "")
  assert_eq wd("=?iso-8859-1?Q?=C3=A9=C3=A9?==?us-ascii?q?QW5k?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=C3=A9=C3=A9?==?us-ascii?q?QW5k?= "), ("Ã©Ã©QW5k ", "")
  assert_eq wd("w6k=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k=?"), ("w6k=?", "")
  assert_eq wd("=?utf-8?q?cw==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?cw==?="), ("=?utf-8?q?cw==?=", "")
  assert_eq wd("=?utf-8?x?_=E9=C3=A9cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?_=E9=C3=A9cw=="), ("=?utf-8?x?_=E9=C3=A9cw==", "")
  assert_eq wd(hx("3d3f7574662d383f713f5a673d3d3f3d0d0a093d3f7574662d383f713f5a6d39765a673d3d3f3d20203d3f75732d61736369693f713f80803f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f5a673d3d3f3d0d0a093d3f7574662d383f713f5a6d39765a673d3d3f3d20203d3f75732d61736369693f713f80803f3d")), (hx("3d3f7574662d383f713f5a673d3d3f3d0d0a093d3f7574662d383f713f5a6d39765a673d3d3f3d20203d3f75732d61736369693f713f80803f3d"), "")
  assert_eq wd("=?iso-8859-1?Q? é=4Zm9v?=====?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q? é=4Zm9v?=====?x-unknown?q?"), ("=?iso-8859-1?Q? é=4Zm9v?=====?x-unknown?q?", "")
  assert_eq wd("=?iso-8859-1?Q?=3FZg==?=  =?utf-8?q?=C3=A9?= =?utf-8?b?Zg==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=3FZg==?=  =?utf-8?q?=C3=A9?= =?utf-8?b?Zg==?=\r\n\t"), ("=?iso-8859-1?Q?=3FZg==?=  éf\r\n\t", "")
  assert_eq wd("Zg===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zg===="), ("Zg====", "")
  assert_eq wd(hx("3d3f7574662d383f713f803f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f803f3d0d0a09")), (hx("3d3f7574662d383f713f803f3d0d0a09"), "")
  assert_eq wd("=C3=A9=?utf-8?x?=?iso-8859-1?Q?=?x-unknown?q? Zm9va\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9=?utf-8?x?=?iso-8859-1?Q?=?x-unknown?q? Zm9va\n"), ("=C3=A9=?utf-8?x?=?iso-8859-1?Q?=?x-unknown?q? Zm9va\n", "")
  assert_eq wd(hx("3d3f5554462d383f423f803f3d")), ("", "illegal base64 data at input byte 0")
  assert_eq wdh(hx("3d3f5554462d383f423f803f3d")), (hx("3d3f5554462d383f423f803f3d"), "")
  assert_eq wd("=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?"), ("=?us-ascii?q?", "")
  assert_eq wd("=?UTF-8?B?QW5kw6k=?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?QW5kw6k=?=  "), ("Andé  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?b?Zm9v?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zm9v?= "), ("foo ", "")
  assert_eq wd("\n?Zm9=?utf-8?x? =zzQW5k\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n?Zm9=?utf-8?x? =zzQW5k\r\n "), ("\n?Zm9=?utf-8?x? =zzQW5k\r\n ", "")
  assert_eq wd("=?utf-8?q??=  =?utf-8?q?acw==?=  =?iso-8859-1?Q?w6k=?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??=  =?utf-8?q?acw==?=  =?iso-8859-1?Q?w6k=?=  "), ("  =?utf-8?q?acw==?=  =?iso-8859-1?Q?w6k=?=  ", "")
  assert_eq wd("_?=C3=A9\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_?=C3=A9\r\n "), ("_?=C3=A9\r\n ", "")
  assert_eq wd("=?utf-8?q?QW5k?=\r\n\t=?UTF-8?B??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?QW5k?=\r\n\t=?UTF-8?B??=\r\n\t"), ("QW5k\r\n\t", "")
  assert_eq wd("=?us-ascii?q?=?utf-8?x?=?iso-8859-1?Q?QW5k=?UTF-8?B?=====?iso-8859-1?Q?QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=?utf-8?x?=?iso-8859-1?Q?QW5k=?UTF-8?B?=====?iso-8859-1?Q?QW5k"), ("=?us-ascii?q?=?utf-8?x?=?iso-8859-1?Q?QW5k=?UTF-8?B?=====?iso-8859-1?Q?QW5k", "")
  assert_eq wd("=?us-ascii?q?Zg==QW5k=E9?==?utf-8?b?a=3F_?=\r\n\t=?us-ascii?q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zg==QW5k=E9?==?utf-8?b?a=3F_?=\r\n\t=?us-ascii?q??=  "), ("=?us-ascii?q?Zg==QW5k=E9?==?utf-8?b?a=3F_?=\r\n\t  ", "")
  assert_eq wd("?==C3=A9=?UTF-8?B?QW5ka\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==C3=A9=?UTF-8?B?QW5ka\r\n "), ("?==C3=A9=?UTF-8?B?QW5ka\r\n ", "")
}

test "vectors: word decoder 10" {
  assert_eq wd("=?iso-8859-1?Q?=E9cw===C3=A9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=E9cw===C3=A9?=  "), ("=?iso-8859-1?Q?=E9cw===C3=A9?=  ", "")
  assert_eq wd("=?x-unknown?q?=4\r\n w6k=é plain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?=4\r\n w6k=é plain"), ("=?x-unknown?q?=4\r\n w6k=é plain", "")
  assert_eq wd(hx("3d3f7574662d383f623f3f3d2078203d3f7574662d383f623f5a673d3d3d43333d41393f3d3d3f75732d61736369693f713f63773d3d803f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f3f3d2078203d3f7574662d383f623f5a673d3d3d43333d41393f3d3d3f75732d61736369693f713f63773d3d803f3d0d0a09")), (hx("2078203d3f7574662d383f623f5a673d3d3d43333d41393f3d3d3f75732d61736369693f713f63773d3d803f3d0d0a09"), "")
  assert_eq wd("a=?x-unknown?q?=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=?x-unknown?q?=?iso-8859-1?Q?"), ("a=?x-unknown?q?=?iso-8859-1?Q?", "")
  assert_eq wd("=?us-ascii?q??= =?utf-8?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= =?utf-8?q??= "), (" ", "")
  assert_eq wd("=?iso-8859-1?Q?=?utf-8?x?=?a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=?utf-8?x?=?a"), ("=?iso-8859-1?Q?=?utf-8?x?=?a", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f3d33465157356b803f3d0d0a093d3f75732d61736369693f713f5a673d3d3d33465157356b3f3d203d3f5554462d383f423f5a6d39763f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f3d33465157356b803f3d0d0a093d3f75732d61736369693f713f5a673d3d3d33465157356b3f3d203d3f5554462d383f423f5a6d39763f3d207820")), (hx("3d3f69736f2d383835392d313f513f3d33465157356b803f3d0d0a093d3f75732d61736369693f713f5a673d3d3d33465157356b3f3d20666f6f207820"), "")
  assert_eq wd("=C3=A9?=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=C3=A9?=?utf-8?x?"), ("=C3=A9?=?utf-8?x?", "")
  assert_eq wd("=?utf-8?q?Zm9v?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zm9v?= x "), ("Zm9v x ", "")
  assert_eq wd("Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v"), ("Zm9v", "")
  assert_eq wd("=?UTF-8?B?QW5k=E9?=  =?utf-8?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?QW5k=E9?=  =?utf-8?q??= "), ("=?UTF-8?B?QW5k=E9?=   ", "")
  assert_eq wd("=?w6k= =?utf-8?x?=?x-unknown?q?_=?UTF-8?B?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?w6k= =?utf-8?x?=?x-unknown?q?_=?UTF-8?B?"), ("=?w6k= =?utf-8?x?=?x-unknown?q?_=?UTF-8?B?", "")
  assert_eq wd(hx("3d3f7574662d383f623f805a6d39763f3d")), ("", "illegal base64 data at input byte 0")
  assert_eq wdh(hx("3d3f7574662d383f623f805a6d39763f3d")), (hx("3d3f7574662d383f623f805a6d39763f3d"), "")
  assert_eq wd("QW5k=?us-ascii?q?Zga=====?UTF-8?B?=?us-ascii?q?Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k=?us-ascii?q?Zga=====?UTF-8?B?=?us-ascii?q?Zm9v"), ("QW5k=?us-ascii?q?Zga=====?UTF-8?B?=?us-ascii?q?Zm9v", "")
  assert_eq wd("=?UTF-8?B?QW5kcw==?= x =?utf-8?b?=E9cw==?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?QW5kcw==?= x =?utf-8?b?=E9cw==?="), ("Ands x =?utf-8?b?=E9cw==?=", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f7574662d383f623f5a6d39763f3d3d3f5554462d383f423f63773d3d805f3f3d3d3f5554462d383f423f5157356b5a673d3d3f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f5a6d39763f3d3d3f5554462d383f423f63773d3d805f3f3d3d3f5554462d383f423f5157356b5a673d3d3f3d207820")), (hx("666f6f3d3f5554462d383f423f63773d3d805f3f3d416e6466207820"), "")
  assert_eq wd("=E9Zm9=zz===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=E9Zm9=zz===="), ("=E9Zm9=zz====", "")
  assert_eq wd("=?iso-8859-1?Q?a?=  =?utf-8?b?=3F?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?a?=  =?utf-8?b?=3F?=  "), ("a  =?utf-8?b?=3F?=  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f7574662d383f623f5a673d3d5a6d39763d45393f3d20203d3f5554462d383f423f803d43333d41393f3d203d3f69736f2d383835392d313f513f3f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f5a673d3d5a6d39763d45393f3d20203d3f5554462d383f423f803d43333d41393f3d203d3f69736f2d383835392d313f513f3f3d20")), (hx("3d3f7574662d383f623f5a673d3d5a6d39763d45393f3d20203d3f5554462d383f423f803d43333d41393f3d2020"), "")
  assert_eq wd("====?==?iso-8859-1?Q?Zm9v_Zm9?Zg"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("====?==?iso-8859-1?Q?Zm9v_Zm9?Zg"), ("====?==?iso-8859-1?Q?Zm9v_Zm9?Zg", "")
  assert_eq wd("=?us-ascii?q?cw==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?cw==?=\r\n\t"), ("=?us-ascii?q?cw==?=\r\n\t", "")
  assert_eq wd("=?UTF-8?B?plain?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?plain?"), ("=?UTF-8?B?plain?", "")
  assert_eq wd(hx("3d3f7574662d383f623f5157356b803f3d20203d3f69736f2d383835392d313f513f3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f5157356b803f3d20203d3f69736f2d383835392d313f513f3f3d0d0a09")), (hx("3d3f7574662d383f623f5157356b803f3d20200d0a09"), "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?iso-8859-1?Q?w6k=w6k=?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?w6k=w6k=?=  "), ("=?iso-8859-1?Q?w6k=w6k=?=  ", "")
  assert_eq wd("_ Zm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_ Zm9v"), ("_ Zm9v", "")
  assert_eq wd("=?us-ascii?q?=C3=A9Zg==w6k=?==?UTF-8?B?aZg==QW5k?=\r\n\t=?UTF-8?B?_aw6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=C3=A9Zg==w6k=?==?UTF-8?B?aZg==QW5k?=\r\n\t=?UTF-8?B?_aw6k=?= x "), ("=?us-ascii?q?=C3=A9Zg==w6k=?==?UTF-8?B?aZg==QW5k?=\r\n\t=?UTF-8?B?_aw6k=?= x ", "")
  assert_eq wd("é=?us-ascii?q?a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é=?us-ascii?q?a"), ("é=?us-ascii?q?a", "")
  assert_eq wd("=?iso-8859-1?Q?=3F_?= x =?utf-8?q?=E9w6k=?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=3F_?= x =?utf-8?q?=E9w6k=?= "), ("?  x =?utf-8?q?=E9w6k=?= ", "")
  assert_eq wd("=?iso-8859-1?Q?=?x-unknown?q??=aa=?UTF-8?B?Zg"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=?x-unknown?q??=aa=?UTF-8?B?Zg"), ("=?iso-8859-1?Q?=?x-unknown?q??=aa=?UTF-8?B?Zg", "")
  assert_eq wd("=?us-ascii?q?_?==?us-ascii?q?=E9QW5kQW5k?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?_?==?us-ascii?q?=E9QW5kQW5k?= x "), (" �QW5kQW5k x ", "")
  assert_eq wd("_a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_a"), ("_a", "")
  assert_eq wd("=?utf-8?b?QW5kcw==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?QW5kcw==?=\r\n\t"), ("Ands\r\n\t", "")
  assert_eq wd("=?iso-8859-1?Q?\nw6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?\nw6k="), ("=?iso-8859-1?Q?\nw6k=", "")
  assert_eq wd(hx("3d3f7574662d383f713f3d4539805a673d3d3f3d3d3f7574662d383f623f5f63773d3d3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f3d4539805a673d3d3f3d3d3f7574662d383f623f5f63773d3d3f3d0d0a09")), (hx("3d3f7574662d383f713f3d4539805a673d3d3f3d3d3f7574662d383f623f5f63773d3d3f3d0d0a09"), "")
  assert_eq wd("a"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a"), ("a", "")
  assert_eq wd("=?us-ascii?q??= =?us-ascii?q?=C3=A9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= =?us-ascii?q?=C3=A9?=  "), ("��  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B??= =?iso-8859-1?Q?QW5k?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??= =?iso-8859-1?Q?QW5k?=  "), ("QW5k  ", "")
  assert_eq wd("=zz=?=?UTF-8?B??a=?utf-8?q?plaincw===C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz=?=?UTF-8?B??a=?utf-8?q?plaincw===C3=A9"), ("=zz=?=?UTF-8?B??a=?utf-8?q?plaincw===C3=A9", "")
  assert_eq wd("=?utf-8?b?QW5kZg==?=\r\n\t=?iso-8859-1?Q?=C3=A9?= x =?us-ascii?q?Zm9v=E9Zm9v?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?QW5kZg==?=\r\n\t=?iso-8859-1?Q?=C3=A9?= x =?us-ascii?q?Zm9v=E9Zm9v?=  "), ("AndfÃ© x Zm9v�Zm9v  ", "")
  assert_eq wd("=?utf-8?x?=?utf-8?x?a_=?us-ascii?q?=E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=?utf-8?x?a_=?us-ascii?q?=E9"), ("=?utf-8?x?=?utf-8?x?a_=?us-ascii?q?=E9", "")
  assert_eq wd("=?iso-8859-1?Q?=3F?= =?UTF-8?B?_=C3=A9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=3F?= =?UTF-8?B?_=C3=A9?= x "), ("? =?UTF-8?B?_=C3=A9?= x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?b??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??= x "), (" x ", "")
  assert_eq wd("w6k==?us-ascii?q?plain?==?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k==?us-ascii?q?plain?==?us-ascii?q?"), ("w6k=plain=?us-ascii?q?", "")
  assert_eq wd("=?us-ascii?q??= =?UTF-8?B?w6k=a_?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= =?UTF-8?B?w6k=a_?= "), (" =?UTF-8?B?w6k=a_?= ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
}

test "vectors: word decoder 11" {
  assert_eq wd("=?iso-8859-1?Q?=C3=A9?= x =?iso-8859-1?Q?QW5k?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=C3=A9?= x =?iso-8859-1?Q?QW5k?= x "), ("Ã© x QW5k x ", "")
  assert_eq wd("plain=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plain=C3=A9"), ("plain=C3=A9", "")
  assert_eq wd("=?utf-8?b?w6k=a?=  =?utf-8?b??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?w6k=a?=  =?utf-8?b??= "), ("=?utf-8?b?w6k=a?=   ", "")
  assert_eq wd("plain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plain"), ("plain", "")
  assert_eq wd("=?us-ascii?q?=3FZg==Zm9v?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=3FZg==Zm9v?=  "), ("=?us-ascii?q?=3FZg==Zm9v?=  ", "")
  assert_eq wd("Zg=====?utf-8?q??=cw==a=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zg=====?utf-8?q??=cw==a=C3=A9"), ("Zg====cw==a=C3=A9", "")
  assert_eq wd(hx("3d3f7574662d383f623f803f3d3d3f5554462d383f423f3d334677366b3d3f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f803f3d3d3f5554462d383f423f3d334677366b3d3f3d20")), (hx("3d3f7574662d383f623f803f3d3d3f5554462d383f423f3d334677366b3d3f3d20"), "")
  assert_eq wd("=?UTF-8?B?Zg\nplain"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zg\nplain"), ("=?UTF-8?B?Zg\nplain", "")
  assert_eq wd("=?utf-8?b??= =?utf-8?q?Zg==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??= =?utf-8?q?Zg==?= x "), (" =?utf-8?q?Zg==?= x ", "")
  assert_eq wd("?Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?Zm9"), ("?Zm9", "")
  assert_eq wd("=?us-ascii?q??= =?utf-8?q?Zm9vacw==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= =?utf-8?q?Zm9vacw==?= x "), (" =?utf-8?q?Zm9vacw==?= x ", "")
  assert_eq wd("=zz=C3=A9=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz=C3=A9=?utf-8?x?"), ("=zz=C3=A9=?utf-8?x?", "")
  assert_eq wd("=?utf-8?q?=C3=A9=E9Zg==?=  =?utf-8?b?=E9=3F?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9=E9Zg==?=  =?utf-8?b?=E9=3F?= x "), ("=?utf-8?q?=C3=A9=E9Zg==?=  =?utf-8?b?=E9=3F?= x ", "")
  assert_eq wd("=?utf-8?x?plain__"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?plain__"), ("=?utf-8?x?plain__", "")
  assert_eq wd("=?utf-8?b??=  =?utf-8?b?Zg==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=  =?utf-8?b?Zg==?=\r\n\t"), ("f\r\n\t", "")
  assert_eq wd("=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?"), ("=?us-ascii?q?", "")
  assert_eq wd("=?UTF-8?B?cw==Zg==QW5k?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?cw==Zg==QW5k?= "), ("=?UTF-8?B?cw==Zg==QW5k?= ", "")
  assert_eq wd("=?x-unknown?q?=4é=zz\r\n =?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?=4é=zz\r\n =?utf-8?x?"), ("=?x-unknown?q?=4é=zz\r\n =?utf-8?x?", "")
  assert_eq wd(hx("3d3f7574662d383f713f803f3d0d0a093d3f7574662d383f713f3d43333d41393f3d20203d3f69736f2d383835392d313f513f3d33463d33463f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f803f3d0d0a093d3f7574662d383f713f3d43333d41393f3d20203d3f69736f2d383835392d313f513f3d33463d33463f3d0d0a09")), (hx("3d3f7574662d383f713f803f3d0d0a09c3a93f3f0d0a09"), "")
  assert_eq wd(" =?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" =?utf-8?x?"), (" =?utf-8?x?", "")
  assert_eq wd("=?us-ascii?q?Zm9va?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?Zm9va?= x "), ("Zm9va x ", "")
  assert_eq wd("=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?"), ("=?x-unknown?q?", "")
  assert_eq wd("=?us-ascii?q?=E9cw==?= x =?utf-8?b?w6k=Zm9v?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=E9cw==?= x =?utf-8?b?w6k=Zm9v?=\r\n\t"), ("=?us-ascii?q?=E9cw==?= x =?utf-8?b?w6k=Zm9v?=\r\n\t", "")
  assert_eq wd("=?=?iso-8859-1?Q?=====?utf-8?x?QW5k=C3=A9\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?=?iso-8859-1?Q?=====?utf-8?x?QW5k=C3=A9\n"), ("=?=?iso-8859-1?Q?=====?utf-8?x?QW5k=C3=A9\n", "")
  assert_eq wd("=?us-ascii?q?cw===E9?=\r\n\t=?iso-8859-1?Q?w6k==E9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?cw===E9?=\r\n\t=?iso-8859-1?Q?w6k==E9?="), ("=?us-ascii?q?cw===E9?=\r\n\t=?iso-8859-1?Q?w6k==E9?=", "")
  assert_eq wd("==== Zg=====?us-ascii?q?w6k==4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("==== Zg=====?us-ascii?q?w6k==4"), ("==== Zg=====?us-ascii?q?w6k==4", "")
  assert_eq wd("=?utf-8?b??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=  "), ("  ", "")
  assert_eq wd("\r\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n "), ("\r\n ", "")
  assert_eq wd("=?utf-8?q??=  =?utf-8?b?_w6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??=  =?utf-8?b?_w6k=?= x "), ("  =?utf-8?b?_w6k=?= x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B?=E9cw==a?= x =?us-ascii?q?=C3=A9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=E9cw==a?= x =?us-ascii?q?=C3=A9?= x "), ("=?UTF-8?B?=E9cw==a?= x �� x ", "")
  assert_eq wd("\n=zzQW5k=?utf-8?q?\nplain=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n=zzQW5k=?utf-8?q?\nplain=?"), ("\n=zzQW5k=?utf-8?q?\nplain=?", "")
  assert_eq wd("=?utf-8?b?cw==?=\r\n\t=?us-ascii?q?QW5ka?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?cw==?=\r\n\t=?us-ascii?q?QW5ka?= x "), ("sQW5ka x ", "")
  assert_eq wd("w6k==?utf-8?x?a=?utf-8?x? ?Zg=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k==?utf-8?x?a=?utf-8?x? ?Zg=?utf-8?q?"), ("w6k==?utf-8?x?a=?utf-8?x? ?Zg=?utf-8?q?", "")
  assert_eq wd("=?utf-8?b?Zm9v?=  =?us-ascii?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?Zm9v?=  =?us-ascii?q??= "), ("foo ", "")
  assert_eq wd("QW5k=?us-ascii?q?=?utf-8?x?=C3=A9=?=?UTF-8?B?=?Zm9=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k=?us-ascii?q?=?utf-8?x?=C3=A9=?=?UTF-8?B?=?Zm9=?utf-8?q?"), ("QW5k=?us-ascii?q?=?utf-8?x?=C3=A9=?=?UTF-8?B?=?Zm9=?utf-8?q?", "")
  assert_eq wd("=?utf-8?b?=E9cw==_?=\r\n\t=?UTF-8?B??= =?UTF-8?B?Zm9v?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=E9cw==_?=\r\n\t=?UTF-8?B??= =?UTF-8?B?Zm9v?= x "), ("=?utf-8?b?=E9cw==_?=\r\n\tfoo x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B?_?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?_?= "), ("=?UTF-8?B?_?= ", "")
  assert_eq wd("=4=?a\n=?x-unknown?q?_plain=?us-ascii?q?cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4=?a\n=?x-unknown?q?_plain=?us-ascii?q?cw=="), ("=4=?a\n=?x-unknown?q?_plain=?us-ascii?q?cw==", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f80613d33463f3d20203d3f69736f2d383835392d313f513f5a673d3d3d43333d41393f3d0d0a093d3f69736f2d383835392d313f513f3d33463f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f80613d33463f3d20203d3f69736f2d383835392d313f513f5a673d3d3d43333d41393f3d0d0a093d3f69736f2d383835392d313f513f3d33463f3d2020")), (hx("3d3f75732d61736369693f713f80613d33463f3d20203d3f69736f2d383835392d313f513f5a673d3d3d43333d41393f3d0d0a093f2020"), "")
  assert_eq wd("=zz=E9?=Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz=E9?=Zm9"), ("=zz=E9?=Zm9", "")
  assert_eq wd("=?UTF-8?B??= =?utf-8?b?_Zm9v?= =?UTF-8?B?_?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??= =?utf-8?b?_Zm9v?= =?UTF-8?B?_?= x "), (" =?utf-8?b?_Zm9v?= =?UTF-8?B?_?= x ", "")
  assert_eq wd("=====?utf-8?x?=E9=?utf-8?x?Zm9=?utf-8?x? \n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=====?utf-8?x?=E9=?utf-8?x?Zm9=?utf-8?x? \n"), ("=====?utf-8?x?=E9=?utf-8?x?Zm9=?utf-8?x? \n", "")
  assert_eq wd(hx("3d3f7574662d383f623f5a673d3d3d453977366b3d3f3d203d3f5554462d383f423f805157356b3f3d2078203d3f7574662d383f713f3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f623f5a673d3d3d453977366b3d3f3d203d3f5554462d383f423f805157356b3f3d2078203d3f7574662d383f713f3f3d0d0a09")), (hx("3d3f7574662d383f623f5a673d3d3d453977366b3d3f3d203d3f5554462d383f423f805157356b3f3d2078200d0a09"), "")
  assert_eq wd("QW5k=?utf-8?x?QW5k=?utf-8?q?=?UTF-8?B?Zm9=?UTF-8?B?=?UTF-8?B? "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k=?utf-8?x?QW5k=?utf-8?q?=?UTF-8?B?Zm9=?UTF-8?B?=?UTF-8?B? "), ("QW5k=?utf-8?x?QW5k=?utf-8?q?=?UTF-8?B?Zm9=?UTF-8?B?=?UTF-8?B? ", "")
  assert_eq wd("=?us-ascii?q??="), ("", "")
  assert_eq wdh("=?us-ascii?q??="), ("", "")
  assert_eq wd("?=?é=?utf-8?x?cw== "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?=?é=?utf-8?x?cw== "), ("?=?é=?utf-8?x?cw== ", "")
  assert_eq wd("=?utf-8?b??= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??= x "), (" x ", "")
  assert_eq wd("=4========"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4========"), ("=4========", "")
}

test "vectors: word decoder 12" {
  assert_eq wd("=?utf-8?q??= x =?iso-8859-1?Q?_a?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= x =?iso-8859-1?Q?_a?=  "), (" x  a  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd(hx("3d3f5554462d383f423f63773d3d803f3d207820")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f63773d3d803f3d207820")), (hx("3d3f5554462d383f423f63773d3d803f3d207820"), "")
  assert_eq wd("é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é"), ("é", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f8077366b3d3f3d3d3f7574662d383f623f3f3d203d3f5554462d383f423f3f3d0d0a09")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f8077366b3d3f3d3d3f7574662d383f623f3f3d203d3f5554462d383f423f3f3d0d0a09")), (hx("3d3f75732d61736369693f713f8077366b3d3f3d0d0a09"), "")
  assert_eq wd("\n=C3=A9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n=C3=A9"), ("\n=C3=A9", "")
  assert_eq wd("=?iso-8859-1?Q?QW5kw6k=?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?QW5kw6k=?= "), ("=?iso-8859-1?Q?QW5kw6k=?= ", "")
  assert_eq wd("éé\r\n _=?x-unknown?q?=?UTF-8?B?Zg=zzZm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("éé\r\n _=?x-unknown?q?=?UTF-8?B?Zg=zzZm9v"), ("éé\r\n _=?x-unknown?q?=?UTF-8?B?Zg=zzZm9v", "")
  assert_eq wd("=?utf-8?q?aZm9vZm9v?=  =?UTF-8?B?w6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?aZm9vZm9v?=  =?UTF-8?B?w6k=?= x "), ("aZm9vZm9vé x ", "")
  assert_eq wd("=zzplainZg=?utf-8?q?=C3=A9w6k=Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zzplainZg=?utf-8?q?=C3=A9w6k=Zm9"), ("=zzplainZg=?utf-8?q?=C3=A9w6k=Zm9", "")
  assert_eq wd("=?utf-8?q?=3F=C3=A9Zg==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3F=C3=A9Zg==?= "), ("=?utf-8?q?=3F=C3=A9Zg==?= ", "")
  assert_eq wd("=?utf-8?x?=?us-ascii?q?=E9=4_"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?x?=?us-ascii?q?=E9=4_"), ("=?utf-8?x?=?us-ascii?q?=E9=4_", "")
  assert_eq wd("=?us-ascii?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= "), (" ", "")
  assert_eq wd("QW5k=?utf-8?x?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k=?utf-8?x?"), ("QW5k=?utf-8?x?", "")
  assert_eq wd("=?us-ascii?q?cw==QW5k?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?cw==QW5k?= "), ("=?us-ascii?q?cw==QW5k?= ", "")
  assert_eq wd("=4aplain\r\n ?==?x-unknown?q?====é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4aplain\r\n ?==?x-unknown?q?====é"), ("=4aplain\r\n ?==?x-unknown?q?====é", "")
  assert_eq wd("=?us-ascii?q?w6k=cw==?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?w6k=cw==?=\r\n\t"), ("=?us-ascii?q?w6k=cw==?=\r\n\t", "")
  assert_eq wd("QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("QW5k"), ("QW5k", "")
  assert_eq wd("=?us-ascii?q??= =?UTF-8?B?Zm9vZm9v?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??= =?UTF-8?B?Zm9vZm9v?=  "), ("foofoo  ", "")
  assert_eq wd("plainZg=?iso-8859-1?Q?=?iso-8859-1?Q?====éZgZm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plainZg=?iso-8859-1?Q?=?iso-8859-1?Q?====éZgZm9"), ("plainZg=?iso-8859-1?Q?=?iso-8859-1?Q?====éZgZm9", "")
  assert_eq wd("=?UTF-8?B?w6k=?= x =?utf-8?b?QW5k?= x =?utf-8?q?w6k==C3=A9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?w6k=?= x =?utf-8?b?QW5k?= x =?utf-8?q?w6k==C3=A9?=  "), ("é x And x =?utf-8?q?w6k==C3=A9?=  ", "")
  assert_eq wd("=?iso-8859-1?Q?ZgZm9v"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?ZgZm9v"), ("=?iso-8859-1?Q?ZgZm9v", "")
  assert_eq wd("=?utf-8?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q??= "), (" ", "")
  assert_eq wd("=?x-unknown?q?Zm9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?x-unknown?q?Zm9"), ("=?x-unknown?q?Zm9", "")
  assert_eq wd("=?iso-8859-1?Q??=  =?iso-8859-1?Q?w6k=QW5k?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??=  =?iso-8859-1?Q?w6k=QW5k?= x "), ("  =?iso-8859-1?Q?w6k=QW5k?= x ", "")
  assert_eq wd("Zm9v?plain=?iso-8859-1?Q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v?plain=?iso-8859-1?Q?"), ("Zm9v?plain=?iso-8859-1?Q?", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f5157356b5f77366b3d3f3d203d3f7574662d383f713f803f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f5157356b5f77366b3d3f3d203d3f7574662d383f713f803f3d2020")), (hx("3d3f69736f2d383835392d313f513f5157356b5f77366b3d3f3d203d3f7574662d383f713f803f3d2020"), "")
  assert_eq wd("_éplain?=zz=?iso-8859-1?Q?_Zg=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_éplain?=zz=?iso-8859-1?Q?_Zg=zz"), ("_éplain?=zz=?iso-8859-1?Q?_Zg=zz", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f3f3d3d3f7574662d383f713f5a6d3976803d45393f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f3f3d3d3f7574662d383f713f5a6d3976803d45393f3d")), (hx("3d3f7574662d383f713f5a6d3976803d45393f3d"), "")
  assert_eq wd("\r\n =?UTF-8?B?cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n =?UTF-8?B?cw=="), ("\r\n =?UTF-8?B?cw==", "")
  assert_eq wd("=?utf-8?q?Zg==?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zg==?= x "), ("=?utf-8?q?Zg==?= x ", "")
  assert_eq wd("=4=?Zm9aQW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=4=?Zm9aQW5k"), ("=4=?Zm9aQW5k", "")
  assert_eq wd("=?iso-8859-1?Q?=3Faw6k=?=\r\n\t=?UTF-8?B?=C3=A9QW5k?=\r\n\t=?us-ascii?q??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=3Faw6k=?=\r\n\t=?UTF-8?B?=C3=A9QW5k?=\r\n\t=?us-ascii?q??=\r\n\t"), ("=?iso-8859-1?Q?=3Faw6k=?=\r\n\t=?UTF-8?B?=C3=A9QW5k?=\r\n\t\r\n\t", "")
  assert_eq wd("_?==?utf-8?x?====w6k==E9"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_?==?utf-8?x?====w6k==E9"), ("_?==?utf-8?x?====w6k==E9", "")
  assert_eq wd("=?UTF-8?B??= x =?utf-8?q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??= x =?utf-8?q??=  "), (" x   ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?b??=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??=\r\n\t"), ("\r\n\t", "")
  assert_eq wd("=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz"), ("=zz", "")
  assert_eq wd("=?UTF-8?B??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B??=  "), ("  ", "")
  assert_eq wd("plainé=?UTF-8?B?\n "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plainé=?UTF-8?B?\n "), ("plainé=?UTF-8?B?\n ", "")
  assert_eq wd("=?utf-8?q?Zm9vw6k=w6k=?==?iso-8859-1?Q?QW5k?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?Zm9vw6k=w6k=?==?iso-8859-1?Q?QW5k?= x "), ("=?utf-8?q?Zm9vw6k=w6k=?=QW5k x ", "")
  assert_eq wd("_=?x-unknown?q?\n\nZm9=?=zz===="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("_=?x-unknown?q?\n\nZm9=?=zz===="), ("_=?x-unknown?q?\n\nZm9=?=zz====", "")
  assert_eq wd("=?utf-8?q?=3Fw6k==3F?= x =?us-ascii?q?=3Fcw===E9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=3Fw6k==3F?= x =?us-ascii?q?=3Fcw===E9?=\r\n\t"), ("=?utf-8?q?=3Fw6k==3F?= x =?us-ascii?q?=3Fcw===E9?=\r\n\t", "")
  assert_eq wd("\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n"), ("\n", "")
  assert_eq wd("=?utf-8?q?=C3=A9?=\r\n\t=?utf-8?b?QW5k=E9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=C3=A9?=\r\n\t=?utf-8?b?QW5k=E9?= x "), ("é\r\n\t=?utf-8?b?QW5k=E9?= x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?UTF-8?B?_=C3=A9?= =?us-ascii?q?a?= =?utf-8?b??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?_=C3=A9?= =?us-ascii?q?a?= =?utf-8?b??= "), ("=?UTF-8?B?_=C3=A9?= a ", "")
  assert_eq wd("=zz?Zg=4=4=?utf-8?q??=?UTF-8?B?=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz?Zg=4=4=?utf-8?q??=?UTF-8?B?=?x-unknown?q?"), ("=zz?Zg=4=4?UTF-8?B?=?x-unknown?q?", "")
  assert_eq wd("=?UTF-8?B?=3Fcw==Zm9v?= =?iso-8859-1?Q?cw===C3=A9=C3=A9?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=3Fcw==Zm9v?= =?iso-8859-1?Q?cw===C3=A9=C3=A9?="), ("=?UTF-8?B?=3Fcw==Zm9v?= =?iso-8859-1?Q?cw===C3=A9=C3=A9?=", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
}

test "vectors: word decoder 13" {
  assert_eq wd("=?iso-8859-1?Q?_?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?_?=\r\n\t"), (" \r\n\t", "")
  assert_eq wd("Zm9v?Zm9=?_=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9v?Zm9=?_=?x-unknown?q?"), ("Zm9v?Zm9=?_=?x-unknown?q?", "")
  assert_eq wd("=?utf-8?b?=C3=A9?= x =?UTF-8?B?a?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?=C3=A9?= x =?UTF-8?B?a?="), ("=?utf-8?b?=C3=A9?= x =?UTF-8?B?a?=", "")
  assert_eq wd("?==zzw6k="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==zzw6k="), ("?==zzw6k=", "")
  assert_eq wd("=?utf-8?q?=E9=C3=A9?=\r\n\t"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=E9=C3=A9?=\r\n\t"), (hx("e9c3a90d0a09"), "")
  assert_eq wd("plain\r\n QW5kQW5k=?=?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plain\r\n QW5kQW5k=?=?"), ("plain\r\n QW5kQW5k=?=?", "")
  assert_eq wd("=?iso-8859-1?Q?_?= =?us-ascii?q??==?utf-8?b?QW5k?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?_?= =?us-ascii?q??==?utf-8?b?QW5k?=  "), (" And  ", "")
  assert_eq wd(" plain=E9Zm9vé=4Zm9v=4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" plain=E9Zm9vé=4Zm9v=4"), (" plain=E9Zm9vé=4Zm9v=4", "")
  assert_eq wd("=?UTF-8?B?=E9?==?iso-8859-1?Q??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?=E9?==?iso-8859-1?Q??=  "), ("=?UTF-8?B?=E9?=  ", "")
  assert_eq wd("Zm9vZg\r\n  =?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9vZg\r\n  =?utf-8?q?"), ("Zm9vZg\r\n  =?utf-8?q?", "")
  assert_eq wd("=?iso-8859-1?Q?=E9w6k=?=\r\n\t=?us-ascii?q?=E9Zm9v=C3=A9?= x =?utf-8?b??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?=E9w6k=?=\r\n\t=?us-ascii?q?=E9Zm9v=C3=A9?= x =?utf-8?b??= "), ("=?iso-8859-1?Q?=E9w6k=?=\r\n\t�Zm9v�� x  ", "")
  assert_eq wd("\r\n Zg=E9\n=?us-ascii?q?=?x-unknown?q?=?x-unknown?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n Zg=E9\n=?us-ascii?q?=?x-unknown?q?=?x-unknown?q?"), ("\r\n Zg=E9\n=?us-ascii?q?=?x-unknown?q?=?x-unknown?q?", "")
  assert_eq wd("=?utf-8?b??= =?utf-8?q??="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??= =?utf-8?q??="), ("", "")
  assert_eq wd("é"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("é"), ("é", "")
  assert_eq wd("=?UTF-8?B?Zm9v?=\r\n\t=?us-ascii?q?=C3=A9=C3=A9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?Zm9v?=\r\n\t=?us-ascii?q?=C3=A9=C3=A9?=  "), ("foo����  ", "")
  assert_eq wd("=?us-ascii?q?=C3=A9é=?us-ascii?q?Zm9=?iso-8859-1?Q?Zg?==4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=C3=A9é=?us-ascii?q?Zm9=?iso-8859-1?Q?Zg?==4"), ("=?us-ascii?q?=C3=A9é=?us-ascii?q?Zm9=?iso-8859-1?Q?Zg?==4", "")
  assert_eq wd("=?utf-8?b??= x =?UTF-8?B?_a_?==?UTF-8?B?Zm9vZg===C3=A9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b??= x =?UTF-8?B?_a_?==?UTF-8?B?Zm9vZg===C3=A9?= x "), (" x =?UTF-8?B?_a_?==?UTF-8?B?Zm9vZg===C3=A9?= x ", "")
  assert_eq wd(" =4plain_ "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" =4plain_ "), (" =4plain_ ", "")
  assert_eq wd("=?UTF-8?B?w6k==C3=A9_?=  =?utf-8?b??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?UTF-8?B?w6k==C3=A9_?=  =?utf-8?b??=  "), ("=?UTF-8?B?w6k==C3=A9_?=    ", "")
  assert_eq wd("w6k==?utf-8?q?\r\n _"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k==?utf-8?q?\r\n _"), ("w6k==?utf-8?q?\r\n _", "")
  assert_eq wd("=?iso-8859-1?Q?cw==w6k=?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?cw==w6k=?= x "), ("=?iso-8859-1?Q?cw==w6k=?= x ", "")
  assert_eq wd("plain=?UTF-8?B?cw==\nplain?=4"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("plain=?UTF-8?B?cw==\nplain?=4"), ("plain=?UTF-8?B?cw==\nplain?=4", "")
  assert_eq wd("=?us-ascii?q?=C3=A9__?=  =?iso-8859-1?Q?Zm9vcw===3F?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?=C3=A9__?=  =?iso-8859-1?Q?Zm9vcw===3F?= "), ("��    =?iso-8859-1?Q?Zm9vcw===3F?= ", "")
  assert_eq wd("w6k=cw=="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("w6k=cw=="), ("w6k=cw==", "")
  assert_eq wd(hx("3d3f7574662d383f713f805a673d3d3f3d2078203d3f7574662d383f713f615157356b803f3d2020")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f7574662d383f713f805a673d3d3f3d2078203d3f7574662d383f713f615157356b803f3d2020")), (hx("3d3f7574662d383f713f805a673d3d3f3d2078203d3f7574662d383f713f615157356b803f3d2020"), "")
  assert_eq wd("a=C3=A9 ====?=?us-ascii?q?QW5kZg"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("a=C3=A9 ====?=?us-ascii?q?QW5kZg"), ("a=C3=A9 ====?=?us-ascii?q?QW5kZg", "")
  assert_eq wd("=?utf-8?b?QW5k?=\r\n\t=?UTF-8?B??=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?QW5k?=\r\n\t=?UTF-8?B??=  "), ("And  ", "")
  assert_eq wd("cw===E9\r\n =?=?iso-8859-1?Q?QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("cw===E9\r\n =?=?iso-8859-1?Q?QW5k"), ("cw===E9\r\n =?=?iso-8859-1?Q?QW5k", "")
  assert_eq wd("=?iso-8859-1?Q??=  =?UTF-8?B?Zm9v?="), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??=  =?UTF-8?B?Zm9v?="), ("foo", "")
  assert_eq wd("\r\n Zm9Zm9véplainZg"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\r\n Zm9Zm9véplainZg"), ("\r\n Zm9Zm9véplainZg", "")
  assert_eq wd("=?utf-8?b?w6k==C3=A9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?b?w6k==C3=A9?= x "), ("=?utf-8?b?w6k==C3=A9?= x ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?iso-8859-1?Q??= =?us-ascii?q?=C3=A9_cw==?= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q??= =?us-ascii?q?=C3=A9_cw==?= "), (" =?us-ascii?q?=C3=A9_cw==?= ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
  assert_eq wd("=?utf-8?q?w6k==C3=A9?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?w6k==C3=A9?=  "), ("=?utf-8?q?w6k==C3=A9?=  ", "")
  assert_eq wd(" ====ZgZm9v=C3=A9=?x-unknown?q?=E9=?us-ascii?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(" ====ZgZm9v=C3=A9=?x-unknown?q?=E9=?us-ascii?q?"), (" ====ZgZm9v=C3=A9=?x-unknown?q?=E9=?us-ascii?q?", "")
  assert_eq wd(hx("3d3f69736f2d383835392d313f513f805f3f3d20203d3f7574662d383f623f5f61803f3d20203d3f69736f2d383835392d313f513f3f3d")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f69736f2d383835392d313f513f805f3f3d20203d3f7574662d383f623f5f61803f3d20203d3f69736f2d383835392d313f513f3f3d")), (hx("3d3f69736f2d383835392d313f513f805f3f3d20203d3f7574662d383f623f5f61803f3d2020"), "")
  assert_eq wd("Zm9vaé"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zm9vaé"), ("Zm9vaé", "")
  assert_eq wd(hx("3d3f75732d61736369693f713f3d4539613f3d20203d3f7574662d383f713f5157356b5157356b3f3d0d0a093d3f69736f2d383835392d313f513f5a673d3d80613f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f75732d61736369693f713f3d4539613f3d20203d3f7574662d383f713f5157356b5157356b3f3d0d0a093d3f69736f2d383835392d313f513f5a673d3d80613f3d20")), (hx("efbfbd615157356b5157356b0d0a093d3f69736f2d383835392d313f513f5a673d3d80613f3d20"), "")
  assert_eq wd("=?utf-8?q?=?UTF-8?B?====?=QW5k"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?utf-8?q?=?UTF-8?B?====?=QW5k"), ("=?utf-8?q?=?UTF-8?B?====?=QW5k", "")
  assert_eq wd("=?us-ascii?q??=  =?utf-8?q?=E9_?=  =?iso-8859-1?Q?=3F=E9?= x "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q??=  =?utf-8?q?=E9_?=  =?iso-8859-1?Q?=3F=E9?= x "), (hx("e9203fc3a9207820"), "")
  assert_eq wd("?==?x-unknown?q?w6k==?us-ascii?q?=?utf-8?x?=zz?=\n"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("?==?x-unknown?q?w6k==?us-ascii?q?=?utf-8?x?=zz?=\n"), ("?==?x-unknown?q?w6k==?us-ascii?q?=?utf-8?x?=zz?=\n", "")
  assert_eq wd("=?iso-8859-1?Q?a?=  =?us-ascii?q??= "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?iso-8859-1?Q?a?=  =?us-ascii?q??= "), ("a ", "")
  assert_eq wd("\n=?utf-8?q?\nZm9=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("\n=?utf-8?q?\nZm9=zz"), ("\n=?utf-8?q?\nZm9=zz", "")
  assert_eq wd(hx("3d3f5554462d383f423f3f3d2078203d3f5554462d383f423f803f3d3d3f69736f2d383835392d313f513f5a673d3d5a6d39763f3d20")), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(hx("3d3f5554462d383f423f3f3d2078203d3f5554462d383f423f803f3d3d3f69736f2d383835392d313f513f5a673d3d5a6d39763f3d20")), (hx("2078203d3f5554462d383f423f803f3d3d3f69736f2d383835392d313f513f5a673d3d5a6d39763f3d20"), "")
  assert_eq wd("Zg=?UTF-8?B?=?utf-8?q?"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("Zg=?UTF-8?B?=?utf-8?q?"), ("Zg=?UTF-8?B?=?utf-8?q?", "")
  assert_eq wd(hx("3d3f5554462d383f423f5a673d3d805157356b3f3d")), ("", "illegal base64 data at input byte 4")
  assert_eq wdh(hx("3d3f5554462d383f423f5a673d3d805157356b3f3d")), (hx("3d3f5554462d383f423f5a673d3d805157356b3f3d"), "")
  assert_eq wd("=zz=====E9Zgplainplain=zz"), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=zz=====E9Zgplainplain=zz"), ("=zz=====E9Zgplainplain=zz", "")
  assert_eq wd("=?us-ascii?q?_w6k=Zg==?=  "), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh("=?us-ascii?q?_w6k=Zg==?=  "), ("=?us-ascii?q?_w6k=Zg==?=  ", "")
  assert_eq wd(""), ("", "mime: invalid RFC 2047 encoded-word")
  assert_eq wdh(""), ("", "")
}

