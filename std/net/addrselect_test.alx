# Go's addrselect_test.go, translated.

import "net/netip"

def ipa(s: Str) -> IPAddr { IPAddr.new(ip: parse_ip(s).unwrap, zone: "") }

def nip(s: Str) -> netip.Addr? { netip.must_parse_addr(s) }

def ipas_text(a: [IPAddr]) -> Str { a.map { |x| x.to_s }.to_a.join(" ") }

test "SortByRFC6724" {
  # (in, srcs, want, reverse: also starting backwards)
  tests: [([IPAddr], [netip.Addr?], [IPAddr], Bool)] = [
    # Examples from RFC 6724 section 10.2. Prefer matching scope.
    ([ipa("2001:db8:1::1"), ipa("198.51.100.121")], [nip("2001:db8:1::2"), nip("169.254.13.78")], [ipa("2001:db8:1::1"), ipa("198.51.100.121")], true),
    # Prefer matching scope.
    ([ipa("2001:db8:1::1"), ipa("198.51.100.121")], [nip("fe80::1"), nip("198.51.100.117")], [ipa("198.51.100.121"), ipa("2001:db8:1::1")], true),
    # Prefer higher precedence.
    ([ipa("2001:db8:1::1"), ipa("10.1.2.3")], [nip("2001:db8:1::2"), nip("10.1.2.4")], [ipa("2001:db8:1::1"), ipa("10.1.2.3")], true),
    # Prefer smaller scope.
    ([ipa("2001:db8:1::1"), ipa("fe80::1")], [nip("2001:db8:1::2"), nip("fe80::2")], [ipa("fe80::1"), ipa("2001:db8:1::1")], true),
    # golang.org/issue/13283: a 10/8 source address doesn't mean 23/8
    # destinations are preferred.
    (
      [ipa("54.83.193.112"), ipa("184.72.238.214"), ipa("23.23.172.185"), ipa("75.101.148.21"), ipa("23.23.134.56"), ipa("23.21.50.150")],
      [nip("10.2.3.4"), nip("10.2.3.4"), nip("10.2.3.4"), nip("10.2.3.4"), nip("10.2.3.4"), nip("10.2.3.4")],
      [ipa("54.83.193.112"), ipa("184.72.238.214"), ipa("23.23.172.185"), ipa("75.101.148.21"), ipa("23.23.134.56"), ipa("23.21.50.150")],
      false
    )
  ]
  for i in 0...tests.size {
    input, srcs, want, reverse = tests[i]
    in_copy = input.dup
    src_copy = srcs.dup
    sort_by_rfc6724_with_srcs(in_copy, src_copy)
    assert ipas_text(in_copy) == ipas_text(want), "test #{i}:\nin = #{ipas_text(input)}\ngot: #{ipas_text(in_copy)}\nwant: #{ipas_text(want)}"
    if reverse {
      rin = input.dup.reverse
      rsrc = srcs.dup.reverse
      sort_by_rfc6724_with_srcs(rin, rsrc)
      assert ipas_text(rin) == ipas_text(want), "test #{i}, starting backwards:\ngot: #{ipas_text(rin)}\nwant: #{ipas_text(want)}"
    }
  }
}

test "RFC6724PolicyTableOrder" {
  t = rfc6724_policy_table
  for i in 0...t.size - 1 {
    assert t[i].prefix.bits >= t[i + 1].prefix.bits, "rfc6724_policy_table item number #{i} sorted in wrong order = #{t[i].prefix.bits} bits, next item = #{t[i + 1].prefix.bits} bits"
  }
}

def pte(prefix: Str, precedence: Int, label: Int) -> PolicyTableEntry { PolicyTableEntry.new(prefix: netip.must_parse_prefix(prefix), precedence: precedence, label: label) }

def pte_text(e: PolicyTableEntry) -> Str { "#{e.prefix} #{e.precedence} #{e.label}" }

test "RFC6724PolicyTableContent" {
  want = [
    pte("::1/128", 50, 0),
    pte("::ffff:0:0/96", 35, 4),
    pte("::/96", 1, 3),
    pte("2001::/32", 5, 5),
    pte("2002::/16", 30, 2),
    pte("3ffe::/16", 1, 12),
    pte("fec0::/10", 1, 11),
    pte("fc00::/7", 3, 13),
    pte("::/0", 40, 1)
  ]
  got = rfc6724_policy_table
  assert_eq got.size, want.size
  for i in 0...want.size {
    assert got[i].prefix == want[i].prefix && got[i].precedence == want[i].precedence && got[i].label == want[i].label, "rfc6724_policy_table[#{i}] = #{pte_text(got[i])}; want #{pte_text(want[i])}"
  }
}

test "RFC6724PolicyTableClassify" {
  tests: [(Str, PolicyTableEntry)] = [
    ("127.0.0.1", pte("::ffff:0:0/96", 35, 4)),
    ("2601:645:8002:a500:986f:1db8:c836:bd65", pte("::/0", 40, 1)),
    ("::1", pte("::1/128", 50, 0)),
    ("2002::ab12", pte("2002::/16", 30, 2))
  ]
  for i in 0...tests.size {
    ip, want = tests[i]
    got = classify_policy(netip.must_parse_addr(ip))
    assert got.prefix == want.prefix && got.precedence == want.precedence && got.label == want.label, "#{i}. classify(#{ip}) = #{pte_text(got)}; want #{pte_text(want)}"
  }
}

def a16(b12: Byte, b13: Byte, b14: Byte, b15: Byte) -> netip.Addr {
  a: [Byte; 16] = [0; 16]
  a[12] = b12
  a[13] = b13
  a[14] = b14
  a[15] = b15
  netip.addr_from16(a)
}

test "RFC6724ClassifyScope" {
  tests: [(netip.Addr, Int)] = [
    # RFC 6724 section 3.2.
    (netip.must_parse_addr("127.0.0.1"), SCOPE_LINK_LOCAL),
    # RFC 4007 section 4.
    (netip.must_parse_addr("::1"), SCOPE_LINK_LOCAL),
    # RFC 6724 section 3.2.
    (netip.must_parse_addr("169.254.1.2"), SCOPE_LINK_LOCAL),
    (netip.must_parse_addr("fec0::1"), SCOPE_SITE_LOCAL),
    (netip.must_parse_addr("8.8.8.8"), SCOPE_GLOBAL),
    # IPv6 multicast.
    (netip.must_parse_addr("ff02::"), SCOPE_LINK_LOCAL),
    (netip.must_parse_addr("ff05::"), SCOPE_SITE_LOCAL),
    (netip.must_parse_addr("ff04::"), SCOPE_ADMIN_LOCAL),
    (netip.must_parse_addr("ff0e::"), SCOPE_GLOBAL),
    # IPv4 link-local and global multicast as 16 bytes and as 4.
    (a16(0xe0, 0, 0, 0), SCOPE_GLOBAL),
    (a16(0xe0, 2, 2, 2), SCOPE_GLOBAL),
    (netip.addr_from4([0xe0, 0, 0, 0]), SCOPE_GLOBAL),
    (netip.addr_from4([0xe0, 2, 2, 2]), SCOPE_GLOBAL)
  ]
  for i in 0...tests.size {
    ip, want = tests[i]
    got = classify_scope(ip)
    assert got == want, "#{i}. classify_scope(#{ip}) = #{got}; want #{want}"
  }
}

test "RFC6724CommonPrefixLength" {
  tests: [(netip.Addr, IP, Int)] = [
    (netip.must_parse_addr("fe80::1"), parse_ip("fe80::2").unwrap, 64),
    (netip.must_parse_addr("fe81::1"), parse_ip("fe80::2").unwrap, 15),
    # Different sizes.
    (netip.must_parse_addr("127.0.0.1"), parse_ip("fe80::1").unwrap, 0),
    (netip.addr_from4([1, 2, 3, 4]), ip_from([1, 2, 3, 4]), 32),
    (netip.addr_from4([1, 2, 255, 255]), ip_from([1, 2, 0, 0]), 16),
    (netip.addr_from4([1, 2, 127, 255]), ip_from([1, 2, 0, 0]), 17),
    (netip.addr_from4([1, 2, 63, 255]), ip_from([1, 2, 0, 0]), 18),
    (netip.addr_from4([1, 2, 31, 255]), ip_from([1, 2, 0, 0]), 19),
    (netip.addr_from4([1, 2, 15, 255]), ip_from([1, 2, 0, 0]), 20),
    (netip.addr_from4([1, 2, 7, 255]), ip_from([1, 2, 0, 0]), 21),
    (netip.addr_from4([1, 2, 3, 255]), ip_from([1, 2, 0, 0]), 22),
    (netip.addr_from4([1, 2, 1, 255]), ip_from([1, 2, 0, 0]), 23),
    (netip.addr_from4([1, 2, 0, 255]), ip_from([1, 2, 0, 0]), 24)
  ]
  for i in 0...tests.size {
    a, b, want = tests[i]
    got = common_prefix_len(a, b)
    assert got == want, "#{i}. common_prefix_len(#{a}, #{b}) = #{got}; want #{want}"
  }
}
