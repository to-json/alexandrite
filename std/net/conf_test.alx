# Go's conf_test.go, translated.

import "errors"
import "os"

# A dnsConfig as parsing a missing resolv.conf makes it (Go's
# defaultResolvConf).
def default_resolv_conf -> DnsConfig {
  c = new_dns_config
  c.servers = DEFAULT_NS.dup
  c.default_ns = true
  c.err = missing_file_error
  c
}

def missing_file_error -> Error {
  r = os.stat("/nonexistent-alx-net-test/resolv.conf")
  if e = r.err {
    return e
  }
  errors.new("unexpected")
}

def resolv_with_lookup(lookup: [Str]) -> DnsConfig {
  c = new_dns_config
  c.servers = DEFAULT_NS.dup
  c.default_ns = true
  c.lookup = lookup
  c
}

def missing_nss -> NssConf { NssConf.new(mtime: 0, err: missing_file_error, sources: {}) }

struct ConfTest {
  name: Str
  c: Conf
  nss: NssConf
  resolver: Resolver?
  resolv: DnsConfig
  # (host, localhost, want)
  host_tests: [(Str, Str, Int)]
}

def conf_of(goos: Str, mdns: Int) -> Conf { Conf.new(net_go: false, net_cgo: false, prefer_cgo: false, goos: goos, mdns_test: mdns) }

def ct(name: Str, c: Conf, nss: NssConf, resolv: DnsConfig, hosts: [(Str, Str, Int)]) -> ConfTest {
  ConfTest.new(name: name, c: c, nss: nss, resolver: none, resolv: resolv, host_tests: hosts)
}

def conf_host_lookup_order_tests -> [ConfTest] {
  force = conf_of("linux", MDNS_FROM_SYSTEM)
  force.prefer_cgo = true
  force.net_cgo = true
  netgo = conf_of("linux", MDNS_FROM_SYSTEM)
  netgo.net_go = true
  no_mdns = conf_of("linux", MDNS_ASSUME_DOES_NOT_EXIST)
  plain = conf_of("linux", MDNS_FROM_SYSTEM)
  unknown = new_dns_config
  unknown.servers = DEFAULT_NS.dup
  unknown.default_ns = true
  unknown.unknown_opt = true
  prefergo = ct("resolver-prefergo", force, nss_str(""), default_resolv_conf, [("localhost", "myhostname", HOST_LOOKUP_FILES_DNS)])
  prefergo.resolver = Resolver.new(prefer_go: true)
  unknown_source = ct("unknown-source", plain, nss_str("hosts: resolve files"), default_resolv_conf, [("x.com", "myhostname", HOST_LOOKUP_DNS_FILES)])
  unknown_source.resolver = Resolver.new(prefer_go: true)
  among = ct("dns-among-unknown-sources", plain, nss_str("hosts: mymachines files dns"), default_resolv_conf, [("x.com", "myhostname", HOST_LOOKUP_FILES_DNS)])
  among.resolver = Resolver.new(prefer_go: true)
  among2 = ct("dns-among-unknown-sources-2", plain, nss_str("hosts: dns mymachines files"), default_resolv_conf, [("x.com", "myhostname", HOST_LOOKUP_DNS_FILES)])
  among2.resolver = Resolver.new(prefer_go: true)
  [
    ct("force", force, nss_str("foo: bar"), default_resolv_conf, [("foo.local", "myhostname", HOST_LOOKUP_CGO), ("google.com", "myhostname", HOST_LOOKUP_CGO)]),
    ct("netgo_dns_before_files", netgo, nss_str("hosts: dns files"), default_resolv_conf, [("x.com", "myhostname", HOST_LOOKUP_DNS_FILES)]),
    ct("netgo_fallback_on_cgo", netgo, nss_str("hosts: dns files something_custom"), default_resolv_conf, [("x.com", "myhostname", HOST_LOOKUP_DNS_FILES)]),
    ct("ubuntu_trusty_avahi", no_mdns, nss_str("hosts: files mdns4_minimal [NOTFOUND=return] dns mdns4"), default_resolv_conf, [
      ("foo.local", "myhostname", HOST_LOOKUP_CGO),
      ("foo.local.", "myhostname", HOST_LOOKUP_CGO),
      ("foo.LOCAL", "myhostname", HOST_LOOKUP_CGO),
      ("foo.LOCAL.", "myhostname", HOST_LOOKUP_CGO),
      ("google.com", "myhostname", HOST_LOOKUP_FILES_DNS)
    ]),
    ct("freebsdlinux_no_resolv_conf", conf_of("freebsd", MDNS_FROM_SYSTEM), nss_str("foo: bar"), default_resolv_conf, [("google.com", "myhostname", HOST_LOOKUP_FILES_DNS)]),
    # On OpenBSD, no resolv.conf means no DNS.
    ct("openbsd_no_resolv_conf", conf_of("openbsd", MDNS_FROM_SYSTEM), nss_str(""), default_resolv_conf, [("google.com", "myhostname", HOST_LOOKUP_FILES)]),
    ct("solaris_no_nsswitch", conf_of("solaris", MDNS_FROM_SYSTEM), missing_nss, default_resolv_conf, [("google.com", "myhostname", HOST_LOOKUP_CGO)]),
    ct("openbsd_lookup_bind_file", conf_of("openbsd", MDNS_FROM_SYSTEM), nss_str(""), resolv_with_lookup(["bind", "file"]), [("google.com", "myhostname", HOST_LOOKUP_DNS_FILES), ("foo.local", "myhostname", HOST_LOOKUP_DNS_FILES)]),
    ct("openbsd_lookup_file_bind", conf_of("openbsd", MDNS_FROM_SYSTEM), nss_str(""), resolv_with_lookup(["file", "bind"]), [("google.com", "myhostname", HOST_LOOKUP_FILES_DNS)]),
    ct("openbsd_lookup_bind", conf_of("openbsd", MDNS_FROM_SYSTEM), nss_str(""), resolv_with_lookup(["bind"]), [("google.com", "myhostname", HOST_LOOKUP_DNS)]),
    ct("openbsd_lookup_file", conf_of("openbsd", MDNS_FROM_SYSTEM), nss_str(""), resolv_with_lookup(["file"]), [("google.com", "myhostname", HOST_LOOKUP_FILES)]),
    ct("openbsd_lookup_yp", conf_of("openbsd", MDNS_FROM_SYSTEM), nss_str(""), resolv_with_lookup(["file", "bind", "yp"]), [("google.com", "myhostname", HOST_LOOKUP_CGO)]),
    ct("openbsd_lookup_two", conf_of("openbsd", MDNS_FROM_SYSTEM), nss_str(""), resolv_with_lookup(["file", "foo"]), [("google.com", "myhostname", HOST_LOOKUP_CGO)]),
    ct("openbsd_lookup_empty", conf_of("openbsd", MDNS_FROM_SYSTEM), nss_str(""), resolv_with_lookup([]), [("google.com", "myhostname", HOST_LOOKUP_DNS_FILES)]),
    ct("linux_no_nsswitch.conf", conf_of("linux", MDNS_FROM_SYSTEM), missing_nss, default_resolv_conf, [("google.com", "myhostname", HOST_LOOKUP_FILES_DNS)]),
    ct("linux_empty_nsswitch.conf", conf_of("linux", MDNS_FROM_SYSTEM), nss_str(""), default_resolv_conf, [("google.com", "myhostname", HOST_LOOKUP_FILES_DNS)]),
    ct("files_mdns_dns", no_mdns, nss_str("hosts: files mdns dns"), default_resolv_conf, [("x.com", "myhostname", HOST_LOOKUP_FILES_DNS), ("x.local", "myhostname", HOST_LOOKUP_CGO)]),
    ct("dns_special_hostnames", plain, nss_str("hosts: dns"), default_resolv_conf, [
      ("x.com", "myhostname", HOST_LOOKUP_DNS),
      # Punt on weird glibc escapes,
      ("x\\.com", "myhostname", HOST_LOOKUP_CGO),
      # and IPv6 zones.
      ("foo.com%en0", "myhostname", HOST_LOOKUP_CGO)
    ]),
    ct("mdns_allow", conf_of("linux", MDNS_ASSUME_EXISTS), nss_str("hosts: files mdns dns"), default_resolv_conf, [("x.com", "myhostname", HOST_LOOKUP_CGO), ("x.local", "myhostname", HOST_LOOKUP_CGO)]),
    ct("files_dns", plain, nss_str("hosts: files dns"), default_resolv_conf, [
      ("x.com", "myhostname", HOST_LOOKUP_FILES_DNS),
      ("x", "myhostname", HOST_LOOKUP_FILES_DNS),
      ("x.local", "myhostname", HOST_LOOKUP_FILES_DNS)
    ]),
    ct("dns_files", plain, nss_str("hosts: dns files"), default_resolv_conf, [
      ("x.com", "myhostname", HOST_LOOKUP_DNS_FILES),
      ("x", "myhostname", HOST_LOOKUP_DNS_FILES),
      ("x.local", "myhostname", HOST_LOOKUP_DNS_FILES)
    ]),
    ct("something_custom", plain, nss_str("hosts: dns files something_custom"), default_resolv_conf, [("x.com", "myhostname", HOST_LOOKUP_CGO)]),
    ct("myhostname", plain, nss_str("hosts: files dns myhostname"), default_resolv_conf, [
      ("x.com", "myhostname", HOST_LOOKUP_FILES_DNS),
      ("myhostname", "myhostname", HOST_LOOKUP_CGO),
      ("myHostname", "myhostname", HOST_LOOKUP_CGO),
      ("myhostname.dot", "myhostname.dot", HOST_LOOKUP_CGO),
      ("myHostname.dot", "myhostname.dot", HOST_LOOKUP_CGO),
      ("_gateway", "myhostname", HOST_LOOKUP_CGO),
      ("_Gateway", "myhostname", HOST_LOOKUP_CGO),
      ("_outbound", "myhostname", HOST_LOOKUP_CGO),
      ("_Outbound", "myhostname", HOST_LOOKUP_CGO),
      ("localhost", "myhostname", HOST_LOOKUP_CGO),
      ("Localhost", "myhostname", HOST_LOOKUP_CGO),
      ("anything.localhost", "myhostname", HOST_LOOKUP_CGO),
      ("Anything.localhost", "myhostname", HOST_LOOKUP_CGO),
      ("localhost.localdomain", "myhostname", HOST_LOOKUP_CGO),
      ("Localhost.Localdomain", "myhostname", HOST_LOOKUP_CGO),
      ("anything.localhost.localdomain", "myhostname", HOST_LOOKUP_CGO),
      ("Anything.Localhost.Localdomain", "myhostname", HOST_LOOKUP_CGO),
      ("somehostname", "myhostname", HOST_LOOKUP_FILES_DNS)
    ]),
    ct("ubuntu14.04.02", no_mdns, nss_str("hosts: files myhostname mdns4_minimal [NOTFOUND=return] dns mdns4"), default_resolv_conf, [
      ("x.com", "myhostname", HOST_LOOKUP_FILES_DNS),
      ("somehostname", "myhostname", HOST_LOOKUP_FILES_DNS),
      ("myhostname", "myhostname", HOST_LOOKUP_CGO)
    ]),
    # Debian Squeeze is just "dns,files", but lists all the default criteria
    # for dns, then a non-standard but redundant notfound=return for files.
    ct("debian_squeeze", plain, nss_str("hosts: dns [success=return notfound=continue unavail=continue tryagain=continue] files [notfound=return]"), default_resolv_conf, [
      ("x.com", "myhostname", HOST_LOOKUP_DNS_FILES),
      ("somehostname", "myhostname", HOST_LOOKUP_DNS_FILES)
    ]),
    ct("resolv.conf-unknown", plain, nss_str("foo: bar"), unknown, [("google.com", "myhostname", HOST_LOOKUP_CGO)]),
    # golang.org/issue/24393: prefer_go acts like netgo.
    prefergo,
    unknown_source,
    among,
    among2
  ]
}

# Restores the system resolv.conf and nsswitch.conf state (Go's teardown
# and deferred setSystemNSS).
def restore_system_conf {
  HOSTNAME_OVERRIDE.store("")
  force_update_conf(dns_read_config("/etc/resolv.conf"), LONG_AGO)
  set_system_nss(parse_nss_conf_file(NSS_CONFIG_PATH), 0)
}

test "ConfHostLookupOrder" {
  defer {
    restore_system_conf
  }
  for tt in conf_host_lookup_order_tests {
    force_update_conf(tt.resolv, DISTANT_FUTURE)
    for ht in tt.host_tests {
      host, localhost, want = ht
      HOSTNAME_OVERRIDE.store(localhost)
      set_system_nss(tt.nss, 3600000000000)
      got = tt.c.host_lookup_order(tt.resolver, host)
      assert got == want, "#{tt.name}: host_lookup_order(#{host}) = #{lookup_order_name(got)}; want #{lookup_order_name(want)}"
    }
  }
}

test "AddrLookupOrder" {
  defer {
    restore_system_conf
  }
  force_update_conf(default_resolv_conf, 3600000000000)
  set_system_nss(nss_str("hosts: files myhostname dns"), 3600000000000)
  cnf = conf_of(system_goos, MDNS_FROM_SYSTEM)
  order = cnf.addr_lookup_order(none, "192.0.2.1")
  assert order == HOST_LOOKUP_CGO, "addr_lookup_order returned: #{lookup_order_name(order)}, want cgo"
  set_system_nss(nss_str("hosts: files mdns4 dns"), 3600000000000)
  order = cnf.addr_lookup_order(none, "192.0.2.1")
  assert order == HOST_LOOKUP_CGO, "addr_lookup_order returned: #{lookup_order_name(order)}, want cgo"
}

test "SystemConf" {
  system_conf
}
