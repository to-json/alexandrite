# Go's dnsclient_test.go and dnsname_test.go, translated.

import "strings"

def check_distribution(data: [SRV], margin: Float) {
  sum = 0
  for srv in data {
    sum += srv.weight
  }
  results: Map[Str, Int] = {}
  count = 10000
  for j in 0...count {
    d = data.dup
    shuffle_by_weight(d, 0, d.size)
    key = d[0].target
    results[key] = (results[key] || 0) + 1
  }
  actual = results[data[0].target] || 0
  expected = count.to_f * data[0].weight.to_f / sum.to_f
  diff = actual.to_f - expected
  diff = -diff if diff < 0.0
  assert diff <= expected * margin, "missed target weight: expected #{expected}, #{actual}"
}

def check_uniformity(size: Int, margin: Float) {
  data: [SRV] = []
  for i in 0...size {
    data << SRV.new(target: Str.from_bytes([(97 + i).to_u8]), port: 0, priority: 0, weight: 1)
  }
  check_distribution(data, margin)
}

def check_weighting(margin: Float) {
  data = [SRV.new(target: "a", port: 0, priority: 0, weight: 60), SRV.new(target: "b", port: 0, priority: 0, weight: 30), SRV.new(target: "c", port: 0, priority: 0, weight: 10)]
  check_distribution(data, margin)
}

test "DNSSRVUniformity" {
  check_uniformity(2, 0.05)
  check_uniformity(3, 0.10)
  check_uniformity(10, 0.20)
  check_weighting(0.05)
}

test "Weighting" {
  check_weighting(0.05)
}

test "DNSName" {
  tests: [(Str, Bool)] = [
    # RFC 2181, section 11.
    ("_xmpp-server._tcp.google.com", true),
    ("foo.com", true),
    ("1foo.com", true),
    ("26.0.0.73.com", true),
    ("10-0-0-1", true),
    ("fo-o.com", true),
    ("fo1o.com", true),
    ("foo1.com", true),
    ("a.b..com", false),
    ("a.b-.com", false),
    ("a.b.com-", false),
    ("a.b..", false),
    ("b.com.", true)
  ]
  char63 = strings.repeat("a", 63)
  char64 = char63 + "a"
  long_domain = strings.repeat(char63 + ".", 5) + "example"
  tests << (char63 + ".com", true)
  tests << (char64 + ".com", false)
  # The wire format is two octets longer than the presentation (length
  # octets for the first and [root] last labels). 253 is fine:
  tests << (long_domain[long_domain.size - 253...long_domain.size], true)
  # a terminal dot doesn't count:
  tests << (long_domain[long_domain.size - 253...long_domain.size] + ".", true)
  # 254 is bad:
  tests << (long_domain[long_domain.size - 254...long_domain.size], false)
  for tc in tests {
    name, want = tc
    assert domain_name?(name) == want, "domain_name?(#{name}) = #{!want}; want #{want}"
  }
}
