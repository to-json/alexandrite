def check_go_lookup_ip_cname_order_hosts_aliases(mode: Int, lookup: Str, lookup_res: Str) {
  unexpected = Atomic.new(false)
  reqs = Chan[FakeReq].new
  rh = ->(n: Str, s: Str, q: dnsmessage.Message, t: Int) -> ~dnsmessage.Message {
    unexpected.store(true) if mode != HOST_LOOKUP_DNS_FILES
    msg(hdr(q.header.id), [q.questions[0]], [])
  }
  spawn {
    fake_serve(rh, reqs)
  }
  r = go_resolver(reqs)
  for input in [lookup, abs_domain_name(lookup), strings.to_lower(lookup), strings.to_upper(lookup)] {
    res = go_lookup_ip_cname_order(r, context.background, "ip", input, mode, none)
    if e = res.err {
      assert false, "expected err == nil, but got error: #{e.message}"
      next
    }
    _, cname = res.unwrap
    assert cname.to_s == lookup_res, "go_lookup_ip_cname_order(#{input}): got #{cname.to_s}, want #{lookup_res}"
  }
  reqs.close
  assert !unexpected.load, "received unexpected DNS query"
}

