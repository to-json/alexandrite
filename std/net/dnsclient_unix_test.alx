# The queries advertise a larger DNS packet size (EDNS0) unless turned off.
def check_dns_packet_size(disable: Bool) {
  problems = Atomic.new("")
  reqs = Chan[FakeReq].new
  rh = ->(n: Str, s: Str, q: dnsmessage.Message, t: Int) -> ~dnsmessage.Message {
    if disable {
      problems.store("unexpected additional record") if q.additionals.size > 0
    } elsif q.additionals.size == 0 {
      problems.store("missing EDNS record")
    } else {
      case q.additionals[0].body {
        dnsmessage.ResourceBody.OPT(options) => {
          if options.size != 0 {
            problems.store("found #{options.size} Options, expected none")
          } elsif q.additionals[0].header.class.to_i != MAX_DNS_PACKET_SIZE {
            problems.store("EDNS packet size == #{q.additionals[0].header.class}, want #{MAX_DNS_PACKET_SIZE}")
          }
        }
        _ => problems.store("additional record isn't an OPTResource")
      }
    }
    # A dummy answer, for lookup_ip_addr to complete.
    answers: [dnsmessage.Resource] = []
    answers << a_rr(q.questions[0].name) if q.questions[0].type == dnsmessage.TYPE_A
    msg(hdr_rcode(q.header.id, dnsmessage.RCODE_SUCCESS), q.questions, answers)
  }
  spawn {
    fake_serve(rh, reqs)
  }
  NETEDNS0.store(!disable)
  defer {
    NETEDNS0.store(true)
    reqs.close
  }
  r = go_resolver(reqs)
  res = r.lookup_ip_addr(context.background, "go.dev")
  assert res.ok?, "lookup failed: #{res.err}"
  assert_eq problems.load, ""
}

test "DNSPacketSize" {
  check_dns_packet_size(false)
  check_dns_packet_size(true)
}

test "LongDNSNames" {
  long_suffix = ".go.dev."
  long_suffix_no_dot = ".go.dev"
  prefix = strings.repeat("verylongdomainlabel.", 20)
  tests: [(Str, Bool)] = [
    (prefix[0...255 - long_suffix.size] + long_suffix, true),
    (prefix[0...254 - long_suffix.size] + long_suffix, false),
    (prefix[0...253 - long_suffix.size] + long_suffix, false),
    (prefix[0...253 - long_suffix_no_dot.size] + long_suffix_no_dot, false),
    (prefix[0...254 - long_suffix_no_dot.size] + long_suffix_no_dot, true)
  ]
  reqs = Chan[FakeReq].new
  rh = ->(n: Str, s: Str, q: dnsmessage.Message, t: Int) -> ~dnsmessage.Message {
    nm = q.questions[0].name
    qt = q.questions[0].type
    rr = a_rr(nm)
    if qt == dnsmessage.TYPE_AAAA {
      rr = aaaa_rr(nm)
    } elsif qt == dnsmessage.TYPE_TXT {
      rr = txt_rr(nm, qt, ["."])
    } elsif qt == dnsmessage.TYPE_MX {
      rr = dnsmessage.Resource.new(header: rhdr(nm, qt, 0), body: dnsmessage.MXResource.new(pref: 0, mx: dnsmessage.must_new_name("go.dev.")).body)
    } elsif qt == dnsmessage.TYPE_NS {
      rr = ns_rr(nm, "go.dev.")
    } elsif qt == dnsmessage.TYPE_SRV {
      rr = srv_rr(nm, "go.dev.")
    } elsif qt == dnsmessage.TYPE_CNAME {
      rr = cname_rr(nm, "fake.cname.")
    } elsif qt != dnsmessage.TYPE_A {
      panic "unknown dnsmessage type"
    }
    msg(hdr_rcode(q.header.id, dnsmessage.RCODE_SUCCESS), q.questions, [rr])
  }
  spawn {
    fake_serve(rh, reqs)
  }
  r = go_resolver(reqs)
  ctx = context.background
  methods = ["CNAME", "Host", "IP", "IPAddr", "MX", "NS", "NetIP", "SRV", "TXT"]
  for i in 0...tests.size {
    req, should_fail = tests[i]
    for m in methods {
      err: Error? = none
      if m == "CNAME" {
        err = r.lookup_cname(ctx, req).err
      } elsif m == "Host" {
        err = r.lookup_host(ctx, req).err
      } elsif m == "IP" {
        err = r.lookup_ip(ctx, "ip", req).err
      } elsif m == "IPAddr" {
        err = r.lookup_ip_addr(ctx, req).err
      } elsif m == "MX" {
        err = r.lookup_mx(ctx, req).err
      } elsif m == "NS" {
        err = r.lookup_ns(ctx, req).err
      } elsif m == "NetIP" {
        err = r.lookup_net_ip(ctx, "ip", req).err
      } elsif m == "SRV" {
        # "_service._proto." is added again.
        err = r.lookup_srv(ctx, "service", "proto", req["service".size + "proto".size + 4...req.size]).err
      } else {
        err = r.lookup_txt(ctx, req).err
      }
      if should_fail {
        assert err.present?, "#{i}: Lookup#{m}: unexpected success"
        assert dns_error_is?(err, ERR_NO_SUCH_HOST, req, "", false, false, true), "#{i}: Lookup#{m}: unexpected error: #{err}"
        break
      }
      assert !err.present?, "#{i}: Lookup#{m}: unexpected error: #{err}"
    }
  }
  reqs.close
}

test "DNSTrustAD" {
  problems = Atomic.new("")
  reqs = Chan[FakeReq].new
  rh = ->(n: Str, s: Str, q: dnsmessage.Message, t: Int) -> ~dnsmessage.Message {
    qn = q.questions[0].name.to_s
    problems.store("unexpected AD bit") if qn == "notrustad.go.dev." && q.header.authentic_data
    problems.store("expected AD bit") if qn == "trustad.go.dev." && !q.header.authentic_data
    answers: [dnsmessage.Resource] = []
    answers << a_rr(q.questions[0].name) if q.questions[0].type == dnsmessage.TYPE_A
    msg(hdr_rcode(q.header.id, dnsmessage.RCODE_SUCCESS), q.questions, answers)
  }
  spawn {
    fake_serve(rh, reqs)
  }
  r = go_resolver(reqs)
  conf = new_resolv_conf_test
  defer {
    conf.teardown
    reqs.close
  }
  conf.write_and_update(["nameserver 127.0.0.1"])
  res = r.lookup_ip_addr(context.background, "notrustad.go.dev")
  assert res.ok?, "lookup failed: #{res.err}"
  conf.write_and_update(["nameserver 127.0.0.1", "options trust-ad"])
  res2 = r.lookup_ip_addr(context.background, "trustad.go.dev")
  assert res2.ok?, "lookup failed: #{res2.err}"
  assert_eq problems.load, ""
}

test "DNSConfigNoReload" {
  reqs = Chan[FakeReq].new
  rh = successful_rh
  spawn {
    fake_serve(rh, reqs)
  }
  fake = fake_dial(reqs, false)
  r = Resolver.new(prefer_go: true, dial: ->(ctx: context.Context, network: Str, address: Str) -> ~Conn {
    fail fake_failure("configuration unexpectedly changed") if address != "192.0.2.1:53"
    ~fake.call(ctx, network, address)
  })
  conf = new_resolv_conf_test
  defer {
    conf.teardown
    reqs.close
  }
  conf.write_and_update_with_last_checked(["nameserver 192.0.2.1", "options no-reload"], -3600000000000)
  r.lookup_host(context.background, "go.dev").unwrap
  conf.write(["nameserver 192.0.2.200"])
  r.lookup_host(context.background, "go.dev").unwrap
}

test "LookupOrderFilesNoSuchHost" {
  orig_hosts = HOSTS_FILE_PATH.load
  conf = new_resolv_conf_test
  dir = os.mkdir_temp("", "").unwrap
  defer {
    HOSTS_FILE_PATH.store(orig_hosts)
    set_system_nss(parse_nss_conf_file(NSS_CONFIG_PATH), 0)
    conf.teardown
    os.remove_all(dir)
  }
  set_system_nss(nss_str("hosts: files"), 3600000000000)
  rc = new_dns_config
  rc.servers = DEFAULT_NS.dup
  rc.default_ns = true
  force_update_conf(rc, 3600000000000)
  tmp = dir + "/hosts"
  os.write_file(tmp, [], 0o660).unwrap
  HOSTS_FILE_PATH.store(tmp)
  test_name = "test.invalid"
  order = system_conf.host_lookup_order(default_resolver, test_name)
  # Systems that don't use files only (darwin prefers the system resolver)
  # skip, as Go's test.
  return if order != HOST_LOOKUP_FILES
  r = default_resolver
  ctx = context.background
  errs: [(Str, Error?)] = [
    ("Host", r.lookup_host(ctx, test_name).err),
    ("IP", r.lookup_ip(ctx, "ip", test_name).err),
    ("IPAddr", r.lookup_ip_addr(ctx, test_name).err),
    ("NetIP", r.lookup_net_ip(ctx, "ip", test_name).err)
  ]
  for v in errs {
    name, err = v
    assert err.present?, "Lookup#{name}: unexpected success"
    assert dns_error_is?(err, ERR_NO_SUCH_HOST, test_name, "", false, false, true), "Lookup#{name}: unexpected error: #{err}"
  }
}

test "ExtendedRCode" {
  reqs = Chan[FakeReq].new
  rh = ->(n: Str, s: Str, q: dnsmessage.Message, t: Int) -> ~dnsmessage.Message {
    fraud_success = dnsmessage.RCODE_SUCCESS | (1 << 10).to_u16
    dnsmessage.Message.new(header: hdr_rcode(q.header.id, fraud_success), questions: [q.questions[0]], answers: [], authorities: [], additionals: [edns0_rr(fraud_success)])
  }
  spawn {
    fake_serve(rh, reqs)
  }
  r = go_resolver(reqs)
  res = try_one_name(r, context.background, get_system_dns_config, "go.dev.", dnsmessage.TYPE_A)
  reqs.close
  d = dns_failure(res.err)
  assert d.present? && d.unwrap.err == ERR_SERVER_MISBEHAVING, "try_one_name: unexpected error: #{res.err}"
}

# resolv.conf is checked again whatever the time since the last check while
# the default servers are used.
test "EmptyResolvConfReplacedWithConfHaingNameservers" {
  conf = new_resolv_conf_test
  defer {
    conf.teardown
  }
  conf.write_and_update_with_last_checked(["# empty resolv.conf file"], 0)
  assert get_system_dns_config_named(conf.path).default_ns, "resolv.conf was not re-loaded"
  conf.write_and_update_with_last_checked(["nameserver 192.0.2.1"], 0)
  assert !get_system_dns_config_named(conf.path).default_ns, "resolv.conf was not re-loaded"
}
