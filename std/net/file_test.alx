# Go's file_test.go, file_unix_test.go, rawconn_test.go,
# unixsock_readmsg_test.go, tcpconn_keepalive*_test.go, iprawsock_test.go
# and tcpsock_unix_test.go, translated. Go's keep-alive tests read the
# settings before they're applied through a test hook; here a fresh socket
# gives the system's defaults. TestFileFdBlocks checks the dup'ed file's
# descriptor (alx's os.File has no SyscallConn). TestEndlessWrite
# (internal poll.FD calls), TestDialContextCancelRace and
# TestTCPSpuriousConnSetupCompletionWithCancel (connect hooks; an external
# host) are left out; TestTCPSpuriousConnSetupCompletion runs 300 dials
# (Go: 10000 outside -short).

import "os"
import "time"

extern def alx_sys_fcntl(fd: I32, cmd: I32, arg: Int) -> I32

def addr_eq?(a: Addr?, b: Addr?) -> Bool {
  x = a || return !b.present?
  y = b || return false
  x.network == y.network && x.to_s == y.to_s
}

test "FileConn" {
  for network in ["tcp", "udp", "unix", "unixpacket"] {
    next unless testable_network?(network)
    nw = ""
    address = ""
    srv: Task[Unit]? = none
    pc: PacketConn? = none
    ln: Listener? = none
    if network == "udp" {
      p = new_local_packet_listener(network)
      nw = p.local_net_addr.unwrap.network
      address = p.local_addr
      pc = p
    } else {
      l = new_local_listener(network)
      ln = l
      srv = spawn {
        r = l.accept
        if r.ok? {
          c = r.unwrap
          b: [Byte] = [0]
          c.read!(b)
          c.close!
        }
      }
      nw = l.net_addr.unwrap.network
      address = l.addr
    }
    c1 = dial(nw, address).unwrap
    addr = c1.local_net_addr
    f = c1.file.unwrap
    if e = c1.close!.err {
      if p = parse_close_error(e, false) {
        assert false, p
      }
    }
    c2 = file_conn(f).unwrap
    f.close!.unwrap
    c2.write!(bytes_of("FILECONN TEST")).unwrap
    assert addr_eq?(c2.local_net_addr, addr), "#{network}: got #{addr_s(c2.local_net_addr)}; want #{addr_s(addr)}"
    c2.close!
    if p = pc {
      pp = p
      pp.close!
    }
    if t = srv {
      t.wait
    }
    if l = ln {
      ll = l
      ll.close!
    }
  }
}

test "FileListener" {
  for network in ["tcp", "unix", "unixpacket"] {
    next unless testable_network?(network)
    ln1 = new_local_listener(network)
    addr = ln1.net_addr
    f = ln1.file.unwrap
    ln1.close! if network == "tcp"
    ln2 = file_listener(f).unwrap
    f.close!.unwrap
    dialer = spawn {
      c = dial(ln2.net_addr.unwrap.network, ln2.addr).unwrap
      c.close!
    }
    c = ln2.accept.unwrap
    c.close!
    dialer.wait
    assert addr_eq?(ln2.net_addr, addr), "#{network}: got #{addr_s(ln2.net_addr)}; want #{addr_s(addr)}"
    ln2.close!
    ln1.close! if network != "tcp"
  }
}

test "FilePacketConn" {
  for network in ["udp", "unixgram"] {
    next unless testable_network?(network)
    c1 = new_local_packet_listener(network)
    addr = c1.local_net_addr
    f = c1.conn.file.unwrap
    if e = c1.close!.err {
      if p = parse_close_error(e, false) {
        assert false, p
      }
    }
    c2 = file_packet_conn(f).unwrap
    f.close!.unwrap
    c2.write_to!(bytes_of("FILEPACKETCONN TEST"), addr.unwrap).unwrap
    assert addr_eq?(c2.local_net_addr, addr), "#{network}: got #{addr_s(c2.local_net_addr)}; want #{addr_s(addr)}"
    c2.close!
    os.remove(c1.local_addr) if network == "unixgram"
  }
}

test "FileCloseRace" {
  ln = new_local_listener("tcp")
  srv = spawn {
    loop {
      r = ln.accept
      break if r.err?
      c = r.unwrap
      b: [Byte] = [0]
      c.read!(b)
      c.close!
    }
  }
  for _i in 0...100 {
    c1 = dial(ln.network, ln.addr).unwrap
    t1 = spawn {
      r = c1.file
      if r.ok? {
        f = r.unwrap
        f.close!
      }
    }
    t2 = spawn { c1.close! }
    t1.wait
    t2.wait
  }
  ln.close!
  srv.wait
}

def nonblock?(fd: Int) -> Bool {
  fl = alx_sys_fcntl(fd.to_i32, c("F_GETFL").to_i32, 0)
  fl.to_i & c("O_NONBLOCK") != 0
}

test "FileFdBlocks" {
  ln = new_local_listener("unix")
  done = Chan[Bool].new
  srv = spawn {
    r = ln.accept
    if r.ok? {
      s = r.unwrap
      done.recv
      s.close!
    }
  }
  client = dial(ln.network, ln.addr).unwrap
  rc = client.syscall_conn.unwrap
  rc.control(->(fd: Int) { assert nonblock?(fd), "unix socket is in blocking mode" }).unwrap
  file = client.file.unwrap
  assert !nonblock?(file.fd), "unix socket through os.File is non-blocking"
  file.close!
  done.close
  srv.wait
  client.close!
  ln.close!
}

# Go's readRawConn / writeRawConn.
def read_raw_conn(c: RawConn, b: [Byte]) -> ~Int {
  n = Atomic.new(-1)
  ~c.read(->(s: Int) -> Bool {
    r = c_read(s.to_i32, b, b.size)
    if r < 0 && C.errno == c("EAGAIN") {
      false
    } else {
      n.store(r)
      true
    }
  })
  n.load
}

def write_raw_conn(c: RawConn, b: [Byte]) -> ~Unit {
  ~c.write(->(s: Int) -> Bool {
    r = c_write(s.to_i32, b, b.size)
    !(r < 0 && C.errno == c("EAGAIN"))
  })
}

test "RawConnReadWrite/TCP" {
  ln = new_local_listener("tcp")
  srv = spawn {
    c = ln.~accept
    cc = ln.~syscall_conn
    called = Atomic.new(false)
    op = ->(fd: Int) -> Bool {
      called.store(true)
      true
    }
    w = cc.write(op)
    fail "Write should return an error" unless w.err?
    fail "Write shouldn't call op" if called.load
    r = cc.read(op)
    fail "Read should return an error" unless r.err?
    fail "Read shouldn't call op" if called.load
    b: [Byte] = [0; 32]
    n = c.~read!(b)
    c.~write!(b[0...n])
    c.~close!
    ""
  }
  c = dial(ln.network, ln.addr).unwrap
  cc = c.syscall_conn.unwrap
  data = bytes_of("HELLO-R-U-THERE")
  write_raw_conn(cc, data).unwrap
  b: [Byte] = [0; 32]
  n = read_raw_conn(cc, b).unwrap
  assert_eq b[0...n], data
  assert_eq srv.wait.unwrap, ""
  c.close!
  ln.close!
}

test "RawConnReadWrite/Deadline" {
  ln = new_local_listener("tcp")
  c = dial(ln.network, ln.addr).unwrap
  cc = c.syscall_conn.unwrap
  b: [Byte] = [0]
  c.set_deadline(time.Time.new)
  c.set_deadline(time.now.add(time.Duration.new(-1))).unwrap
  e1 = write_raw_conn(cc, b).err.unwrap
  if p = parse_write_error(e1) {
    assert false, p
  }
  assert deadline_exceeded?(e1), e1.message
  e2 = read_raw_conn(cc, b).err.unwrap
  if p = parse_read_error(e2) {
    assert false, p
  }
  assert deadline_exceeded?(e2), e2.message
  c.set_read_deadline(time.Time.new)
  c.set_read_deadline(time.now.add(time.Duration.new(-1))).unwrap
  e3 = read_raw_conn(cc, b).err.unwrap
  assert deadline_exceeded?(e3), e3.message
  c.set_write_deadline(time.Time.new)
  c.set_write_deadline(time.now.add(time.Duration.new(-1))).unwrap
  e4 = write_raw_conn(cc, b).err.unwrap
  assert deadline_exceeded?(e4), e4.message
  c.close!
  ln.close!
}

# Go's controlRawConn.
def control_raw_conn(c: RawConn, addr: Addr) -> ~Unit {
  operr = Atomic.new(0)
  ip = addr_ip(addr)
  ~c.control(->(s: Int) {
    r = alx_net_getsockopt(s, "SO_REUSEADDR")
    if r < 0 {
      operr.store(-r)
    } elsif ip.size > 0 && !ip.to4.present? {
      operr.store(-alx_net_setsockopt(s, "IPV6_UNICAST_HOPS", 1))
    } elsif ip.size > 0 {
      operr.store(-alx_net_setsockopt(s, "IP_TTL", 1))
    }
  })
  fail syscall_error("setsockopt", operr.load) if operr.load != 0
}

test "RawConnControl" {
  ln = new_local_listener("tcp")
  cc1 = ln.syscall_conn.unwrap
  la = ln.net_addr.unwrap
  control_raw_conn(cc1, la).unwrap
  c = dial(ln.network, ln.addr).unwrap
  cc2 = c.syscall_conn.unwrap
  ca = c.local_net_addr.unwrap
  control_raw_conn(cc2, ca).unwrap
  ln.close!
  assert control_raw_conn(cc1, la).err?, "Control after Close should fail"
  c.close!
  assert control_raw_conn(cc2, ca).err?, "Control after Close should fail"
}

test "UnixConnReadMsgUnixSCMRightsCloseOnExec" {
  scm_file = os.open("/dev/null").unwrap
  rights = unix_rights([scm_file.fd])
  wf, rf = socketpair_files("unix").unwrap
  cw = file_conn(wf).unwrap
  cr = file_conn(rf).unwrap
  oob: [Byte] = [0; 64]
  cw.set_write_deadline(time.now.add(time.second * 5)).unwrap
  empty: [Byte] = []
  cw.write_msg_unix!(empty, rights, none).unwrap
  cr.set_read_deadline(time.now.add(time.second * 5)).unwrap
  _, oobn, _, _ = cr.read_msg_unix!(empty, oob).unwrap
  got = parse_unix_rights(oob[0...oobn]).unwrap
  assert_eq got.size, 1
  flags = alx_sys_fcntl(got[0].to_i32, c("F_GETFD").to_i32, 0)
  assert flags.to_i & c("FD_CLOEXEC") != 0, "received descriptor isn't close-on-exec"
  alx_fd_close(got[0])
  cw.close!
  cr.close!
  wf.close!
  rf.close!
  scm_file.close!
}

def keepalive_configs -> [(Int, Int, Int)] {
  [(5, 3, 10), (0, 0, 0), (-1, -1, -1), (-1, 3, 10), (5, -1, 10), (5, 3, -1), (-1, -1, 10), (-1, 3, -1), (5, -1, -1), (0, 3, 10), (5, 0, 10), (5, 3, 0), (0, 0, 10), (0, 3, 0), (5, 0, 0)]
}

def ka_config(t: (Int, Int, Int)) -> KeepAliveConfig {
  idle, interval, count = t
  KeepAliveConfig.new(enable: true, idle: time.second * idle, interval: time.second * interval, count: count)
}

# (keep-alive on, idle s, interval s, count) of a socket.
def keepalive_settings(c: Conn) -> (Bool, Int, Int, Int) {
  (c.nfd.getsockopt("SO_KEEPALIVE").unwrap != 0, c.nfd.getsockopt("TCP_KEEPIDLE").unwrap, c.nfd.getsockopt("TCP_KEEPINTVL").unwrap, c.nfd.getsockopt("TCP_KEEPCNT").unwrap)
}

# The system's settings on a fresh TCP connection (Go reads them in a hook
# before applying a config).
def default_keepalive(ln: Listener) -> (Bool, Int, Int, Int) {
  c = Dialer.new(keep_alive: time.Duration.new(-1)).dial("tcp", ln.addr).unwrap
  s = keepalive_settings(c)
  c.close!
  s
}

# Go's verifyKeepAliveSettings.
def verify_keepalive(c: Conn, old: (Bool, Int, Int, Int), cfg: (Int, Int, Int)) -> Str {
  _, oidle, ointerval, ocount = old
  idle, interval, count = cfg
  idle = 15 if idle == 0
  interval = 15 if interval == 0
  count = 9 if count == 0
  idle = oidle if idle == -1
  interval = ointerval if interval == -1
  count = ocount if count == -1
  on, gidle, ginterval, gcount = keepalive_settings(c)
  return "SO_KEEPALIVE off" unless on
  return "TCP_KEEPIDLE: got #{gidle}; want #{idle}" if gidle != idle
  return "TCP_KEEPINTVL: got #{ginterval}; want #{interval}" if ginterval != interval
  return "TCP_KEEPCNT: got #{gcount}; want #{count}" if gcount != count
  ""
}

test "TCPConnKeepAliveConfigDialer" {
  ln = new_local_listener("tcp", ListenConfig.new(keep_alive: time.Duration.new(-1)))
  srv = spawn {
    loop {
      r = ln.accept
      break if r.err?
      c = r.unwrap
      c.close!
    }
  }
  old = default_keepalive(ln)
  for cfg in keepalive_configs {
    d = Dialer.new(keep_alive: time.second * 15, keep_alive_config: ka_config(cfg))
    c = d.dial("tcp", ln.addr).unwrap
    assert_eq verify_keepalive(c, old, cfg), ""
    c.close!
  }
  ln.close!
  srv.wait
}

test "TCPConnKeepAliveConfigListener" {
  for cfg in keepalive_configs {
    ln = new_local_listener("tcp", ListenConfig.new(keep_alive: time.second * 15, keep_alive_config: ka_config(cfg)))
    t = spawn { ln.~accept }
    c = Dialer.new(keep_alive: time.Duration.new(-1)).dial("tcp", ln.addr).unwrap
    old = keepalive_settings(c)
    cc = t.wait.unwrap
    assert_eq verify_keepalive(cc, old, cfg), ""
    cc.close!
    c.close!
    ln.close!
  }
}

test "TCPConnKeepAliveConfig" {
  ln = new_local_listener("tcp")
  srv = spawn {
    loop {
      r = ln.accept
      break if r.err?
      c = r.unwrap
      c.close!
    }
  }
  for cfg in keepalive_configs {
    c = Dialer.new(keep_alive: time.Duration.new(-1)).dial("tcp", ln.addr).unwrap
    old = keepalive_settings(c)
    c.set_keep_alive_config(ka_config(cfg)).unwrap
    assert_eq verify_keepalive(c, old, cfg), ""
    c.close!
  }
  ln.close!
  srv.wait
}

def ip_addr(ip: IP, zone: Str = "") -> IPAddr { IPAddr.new(ip: ip, zone: zone) }

test "ResolveIPAddr" {
  tests: [(Str, Str, IPAddr?, Str)] = [
    ("ip", "127.0.0.1", ip_addr(ipv4(127, 0, 0, 1)), ""),
    ("ip4", "127.0.0.1", ip_addr(ipv4(127, 0, 0, 1)), ""),
    ("ip4:icmp", "127.0.0.1", ip_addr(ipv4(127, 0, 0, 1)), ""),
    ("ip", "::1", ip_addr(pip("::1")), ""),
    ("ip6", "::1", ip_addr(pip("::1")), ""),
    ("ip6:ipv6-icmp", "::1", ip_addr(pip("::1")), ""),
    ("ip6:IPv6-ICMP", "::1", ip_addr(pip("::1")), ""),
    ("ip", "::1%en0", ip_addr(pip("::1"), "en0"), ""),
    ("ip6", "::1%911", ip_addr(pip("::1"), "911"), ""),
    ("", "127.0.0.1", ip_addr(ipv4(127, 0, 0, 1)), ""),
    ("", "::1", ip_addr(pip("::1")), ""),
    ("ip4:icmp", "", IPAddr.new, ""),
    ("l2tp", "127.0.0.1", none, "unknown network l2tp"),
    ("l2tp:gre", "127.0.0.1", none, "unknown network l2tp:gre"),
    ("tcp", "1.2.3.4:123", none, "unknown network tcp"),
    ("ip4", "2001:db8::1", none, "address 2001:db8::1: no suitable address found"),
    ("ip4:icmp", "2001:db8::1", none, "address 2001:db8::1: no suitable address found"),
    ("ip6", "127.0.0.1", none, "address 127.0.0.1: no suitable address found"),
    ("ip6", "::ffff:127.0.0.1", none, "address ::ffff:127.0.0.1: no suitable address found"),
    ("ip6:ipv6-icmp", "127.0.0.1", none, "address 127.0.0.1: no suitable address found"),
    ("ip6:ipv6-icmp", "::ffff:127.0.0.1", none, "address ::ffff:127.0.0.1: no suitable address found")
  ]
  for tt in tests {
    nw, lit, want, err = tt
    r = resolve_ip_addr(nw, lit)
    if w = want {
      a = r.unwrap
      assert a.ip.bytes == w.ip.bytes && a.zone == w.zone, "resolve_ip_addr(#{nw}, #{lit}) = #{a}, want #{w}"
      a2 = resolve_ip_addr(a.network, a.to_s).unwrap
      assert a2.ip.bytes == w.ip.bytes && a2.zone == w.zone, "round trip: #{a2}"
    } else {
      assert_eq r.err.unwrap.message, err
    }
  }
}

test "IPConnLocalName" {
  for laddr in [IPAddr.new(ip: ipv4(127, 0, 0, 1)), IPAddr.new] {
    next unless testable_network?("ip4:icmp")
    c = listen_ip("ip4:icmp", laddr).unwrap
    assert c.local_net_addr.present?, "should not fail"
    c.close!
  }
}

test "IPConnRemoteName" {
  if testable_network?("ip:tcp") {
    raddr = IPAddr.new(ip: ipv4(127, 0, 0, 1).to4.unwrap)
    c = dial_ip("ip:tcp", IPAddr.new(ip: ipv4(127, 0, 0, 1)), raddr).unwrap
    assert addr_eq?(c.remote_net_addr, raddr), "got #{addr_s(c.remote_net_addr)}"
    c.close!
  }
}

test "DialListenIPArgs" {
  args: [(Str, Str)] = [("ip", "127.0.0.1"), ("ip:", "127.0.0.1"), ("ip::", "127.0.0.1"), ("ip", "::1"), ("ip:", "::1"), ("ip::", "::1"), ("ip4", "127.0.0.1"), ("ip4:", "127.0.0.1"), ("ip4::", "127.0.0.1"), ("ip6", "::1"), ("ip6:", "::1"), ("ip6::", "::1")]
  for a in args {
    network, address = a
    assert dial(network, address).err?, "dial(#{network}, #{address}) should fail"
    assert listen_packet(network, address).err?, "listen_packet(#{network}, #{address}) should fail"
    ra = resolve_ip_addr("ip", address).unwrap
    assert dial_ip(network, none, ra).err?, "dial_ip(#{network}) should fail"
    assert listen_ip(network, ra).err?, "listen_ip(#{network}) should fail"
  }
}

test "TCPSpuriousConnSetupCompletion" {
  ln = new_local_listener("tcp")
  srv = spawn {
    handlers: [Task[Unit]] = []
    loop {
      r = ln.accept
      break if r.err?
      c = r.unwrap
      handlers << spawn {
        b: [Byte] = [0]
        c.read!(b)
        c.close!
        nil
      }
    }
    for h in handlers {
      h.wait
    }
  }
  addr = ln.addr
  throttle = Chan[Bool].new(16)
  dialers: [Task[Str]] = []
  for _i in 0...300 {
    throttle << true
    dialers << spawn {
      d = Dialer.new(timeout: time.millisecond * 50)
      out = ""
      r = d.dial("tcp", addr)
      if e = r.err {
        out = parse_dial_error(e) || ""
      } else {
        c = r.unwrap
        b: [Byte] = [0]
        if e = c.write!(b).err {
          out = e.message if e.message.include?("not connected")
        }
        c.close!
      }
      throttle.recv
      out
    }
  }
  for t in dialers {
    assert_eq t.wait.unwrap, ""
  }
  ln.close!
  srv.wait
}
