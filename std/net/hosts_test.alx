# Go's hosts_test.go, translated.

import "strings"

def lookup_static_host_tests -> [(Str, [(Str, [Str])])] {
  [
    ("testdata/hosts", [
      ("odin", ["127.0.0.2", "127.0.0.3", "::2"]),
      ("thor", ["127.1.1.1"]),
      ("ullr", ["127.1.1.2"]),
      ("ullrhost", ["127.1.1.2"]),
      ("localhost", ["fe80::1%lo0"])
    ]),
    # golang.org/issue/6646
    ("testdata/singleline-hosts", [("odin", ["127.0.0.2"])]),
    ("testdata/ipv4-hosts", [
      ("localhost", ["127.0.0.1", "127.0.0.2", "127.0.0.3"]),
      ("localhost.localdomain", ["127.0.0.3"])
    ]),
    # golang.org/issue/8996
    ("testdata/ipv6-hosts", [
      ("localhost", ["::1", "fe80::1", "fe80::2%lo0", "fe80::3%lo0"]),
      ("localhost.localdomain", ["fe80::3%lo0"])
    ]),
    # golang.org/issue/12806
    ("testdata/case-hosts", [
      ("PreserveMe", ["127.0.0.1", "::1"]),
      ("PreserveMe.local", ["127.0.0.1", "::1"])
    ])
  ]
}

def check_static_host(path: Str, input: Str, want: [Str]) {
  ins = [input, abs_domain_name(input), strings.to_lower(input), strings.to_upper(input)]
  for s in ins {
    addrs, _ = lookup_static_host(s)
    assert addrs == want, "#{path}, lookup_static_host(#{s}) = #{addrs}; want #{want}"
  }
}

test "LookupStaticHost" {
  orig = HOSTS_FILE_PATH.load
  defer {
    HOSTS_FILE_PATH.store(orig)
  }
  for tt in lookup_static_host_tests {
    path, ents = tt
    HOSTS_FILE_PATH.store(path)
    for ent in ents {
      name, want = ent
      check_static_host(path, name, want)
    }
  }
}

def lookup_static_addr_tests -> [(Str, [(Str, [Str])])] {
  [
    ("testdata/hosts", [
      ("255.255.255.255", ["broadcasthost"]),
      ("127.0.0.2", ["odin"]),
      ("127.0.0.3", ["odin"]),
      ("::2", ["odin"]),
      ("127.1.1.1", ["thor"]),
      ("127.1.1.2", ["ullr", "ullrhost"]),
      ("fe80::1%lo0", ["localhost"])
    ]),
    ("testdata/singleline-hosts", [("127.0.0.2", ["odin"])]),
    ("testdata/ipv4-hosts", [
      ("127.0.0.1", ["localhost"]),
      ("127.0.0.2", ["localhost"]),
      ("127.0.0.3", ["localhost", "localhost.localdomain"])
    ]),
    ("testdata/ipv6-hosts", [
      ("::1", ["localhost"]),
      ("fe80::1", ["localhost"]),
      ("fe80::2%lo0", ["localhost"]),
      ("fe80::3%lo0", ["localhost", "localhost.localdomain"])
    ]),
    ("testdata/case-hosts", [
      ("127.0.0.1", ["PreserveMe", "PreserveMe.local"]),
      ("::1", ["PreserveMe", "PreserveMe.local"])
    ])
  ]
}

def check_static_addr(path: Str, input: Str, out: [Str]) {
  hosts = lookup_static_addr(input)
  want = out.map { |o| abs_domain_name(o) }.to_a
  assert hosts == want, "#{path}, lookup_static_addr(#{input}) = #{hosts}; want #{want}"
}

test "LookupStaticAddr" {
  orig = HOSTS_FILE_PATH.load
  defer {
    HOSTS_FILE_PATH.store(orig)
  }
  for tt in lookup_static_addr_tests {
    path, ents = tt
    HOSTS_FILE_PATH.store(path)
    for ent in ents {
      name, want = ent
      check_static_addr(path, name, want)
    }
  }
}

# Programs can't modify the internals of the host cache (golang.org/issue/14212).
test "HostCacheModification" {
  orig = HOSTS_FILE_PATH.load
  defer {
    HOSTS_FILE_PATH.store(orig)
  }
  HOSTS_FILE_PATH.store("testdata/ipv4-hosts")
  want = ["127.0.0.1", "127.0.0.2", "127.0.0.3"]
  check_static_host("testdata/ipv4-hosts", "localhost", want)
  addrs, _ = lookup_static_host("localhost")
  for i in 0...addrs.size {
    addrs[i] = addrs[i] + "junk"
  }
  check_static_host("testdata/ipv4-hosts", "localhost", want)

  HOSTS_FILE_PATH.store("testdata/ipv6-hosts")
  check_static_addr("testdata/ipv6-hosts", "::1", ["localhost"])
  hosts = lookup_static_addr("::1")
  for i in 0...hosts.size {
    hosts[i] = hosts[i] + "junk"
  }
  check_static_addr("testdata/ipv6-hosts", "::1", ["localhost"])
}

def lookup_static_host_aliases_tests -> [(Str, Str)] {
  [
    # 127.0.0.1
    ("test", "test"),
    # 127.0.0.2
    ("test2.example.com", "test2.example.com"),
    ("2.test", "test2.example.com"),
    # 127.0.0.3
    ("test3.example.com", "3.test"),
    ("3.test", "3.test"),
    # 127.0.0.4
    ("example.com", "example.com"),
    # 127.0.0.5
    ("test5.example.com", "test4.example.com"),
    ("5.test", "test4.example.com"),
    ("4.test", "test4.example.com"),
    ("test4.example.com", "test4.example.com")
  ]
}

test "LookupStaticHostAliases" {
  orig = HOSTS_FILE_PATH.load
  defer {
    HOSTS_FILE_PATH.store(orig)
  }
  HOSTS_FILE_PATH.store("testdata/aliases")
  for ent in lookup_static_host_aliases_tests {
    lookup, res = ent
    want = abs_domain_name(res)
    for s in [lookup, abs_domain_name(lookup), strings.to_lower(lookup), strings.to_upper(lookup)] {
      _, got = lookup_static_host(s)
      assert_eq got, want
    }
  }
}
