# Package cgi: Go's net/http/cgi, CGI (RFC 3875) for both sides.
#
#   # a CGI program:
#   cgi.serve(->(w: http.ResponseWriter, r: http.Request) { w.write_string!("hi") })
#
#   # a server running one:
#   h = cgi.new_handler("/var/www/script.cgi")
#   h.root = "/script"
#   mux.handle("/script/", h)
#
#   Go                                   alx
#   Request() (*http.Request, error)     request -> ~http.Request
#   RequestFromMap(map) (*Request, err)  request_from_map(params) -> ~http.Request
#   Serve(handler) error                 serve(f) -> ~Unit / serve_mux(mux)
#   Handler{Path, Root, Dir, Env, ...}   new_handler(path) -> Handler (fields path,
#                                        root, dir, env, inherit_env, args, stderr,
#                                        logger, path_location_handler)
#   (*Handler).ServeHTTP                 Handler.serve_http (an http.Handler)
#
# Differences from Go:
#  - http.Request has no ContentLength, ProtoMajor/Minor or TLS fields:
#    `content_length(params)`, `proto_version(params)` and `https?(params)`
#    give what RequestFromMap would store there. `request` reads the body
#    (CONTENT_LENGTH bytes of stdin) into Request.body before the handler
#    runs (alx requests hold their whole body). The Request's `url` is the
#    full URL Go's req.URL.String() gives.
#  - The handler is a function (Go: an http.Handler; serve_mux routes through
#    a ServeMux). The response goes out through http.ResponseWriter in
#    MODE_CGI: "Status: 200 OK", the header (Content-Type sniffed when
#    missing), a blank line, then the body as written.
#  - Host side: the program runs through os/exec, which has no Start/Wait
#    split or pipes, so its whole output is read before the response is
#    written (Go streams it with io.Copy and kills the program on a copy
#    error). Handler.stderr and Handler.logger are functions taking text
#    (Go: an io.Writer and a *log.Logger); their default is this process's
#    stderr. A chunked request is refused (400) by looking at its
#    Transfer-Encoding header (alx's server has already decoded the body).
#    The program is started as "./name" in its directory when `dir` is
#    empty, as Go does.
#  - osDefaultInheritEnv is DYLD_LIBRARY_PATH and LD_LIBRARY_PATH on every
#    system (Go picks per GOOS).
#
# Not translated: TestCopyError (needs a streaming copy and
# runtime.Stack), TestHostingOurselves and the other integration tests that
# run the test binary itself as the CGI child (an alx test can't re-execute
# itself; the child side is tested through serve_params and the host side
# with a /bin/sh CGI program, which covers the same requests); the Perl-era
# X-CGI-Pid check (the script prints its pid but nothing compares it).

pub error CgiError {
  Msg(msg: Str)

  def message -> Str {
    case self {
      Msg(m) => m
    }
  }
}
