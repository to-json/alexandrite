import "bufio"
import "crypto/tls"
import "net"
import "strings"
import "strconv"
import nurl "net/url"
import "net/netip"
import "net/http/httptrace"
import "encoding/base64"

# An HTTP/1.1 client. Each request opens its own connection and sends
# `Connection: close` (no connection pool, no keep-alive on the client side).
# Responses may be length-framed, chunked or read to end of stream. Redirects
# (301, 302, 303, 307, 308) are followed up to `max_redirects` times, to http://
# locations or paths on the same host. https:// URLs go over crypto/tls with
# `tls_config` (Go's Transport.TLSClientConfig; none: the defaults, with the
# URL's host as ServerName). No timeouts (net has no deadlines), no proxies. With a `jar`, cookies are
# sent from it and Set-Cookie headers stored in it on every hop (Go's
# Client.Jar); a request's trace hooks (httptrace) fire on every hop.
pub struct Client {
  # 0 turns redirect following off.
  max_redirects: Int
  # Where cookies come from and go to (none: no cookie handling).
  jar: CookieJar?
  # The TLS configuration for https:// URLs (none: tls.Config defaults).
  tls_config: tls.Config?

  # Sends `req` and reads the whole response.
  pub def do(req: Request) -> ~Response {
    cur = req
    n = 0
    loop {
      sent = cur
      if j = jar {
        sent = with_jar_cookies(cur, j)
      }
      resp = ~send_once(sent, tls_config)
      if j = jar {
        rc = read_set_cookies(resp.header)
        pu = nurl.parse(cur.url)
        j.set_cookies(pu.unwrap, rc) if rc.size > 0 && pu.ok?
      }
      redirect = resp.status == 301 || resp.status == 302 || resp.status == 303 || resp.status == 307 || resp.status == 308
      loc = resp.header.get("Location")
      return resp if !redirect || loc.size == 0 || n >= max_redirects
      n += 1
      target = ~resolve_url(cur.url, loc)
      nxt = ~new_request(cur.method, target, cur.body)
      nxt.trace = cur.trace
      for k in cur.header.keys {
        for v in cur.header.values(k) { nxt.header.add!(k, v) }
      }
      if (resp.status == 301 || resp.status == 302 || resp.status == 303) && cur.method != "GET" && cur.method != "HEAD" {
        nxt.method = "GET"
        nxt.body = []
        nxt.header.del!("Content-Type")
        nxt.header.del!("Content-Length")
      }
      cur = nxt
    }
  }

  pub def get(url: Str) -> ~Response {
    req = ~new_request("GET", url, [])
    self.~do(req)
  }

  pub def head(url: Str) -> ~Response {
    req = ~new_request("HEAD", url, [])
    self.~do(req)
  }

  pub def post(url: Str, content_type: Str, body: Str) -> ~Response {
    self.~post_bytes(url, content_type, body.bytes.to_a)
  }

  pub def post_bytes(url: Str, content_type: Str, body: [Byte]) -> ~Response {
    req = ~new_request("POST", url, body)
    req.header.set!("Content-Type", content_type)
    self.~do(req)
  }
}

pub def new_client -> Client {
  Client.new(max_redirects: 10)
}

# The request with the jar's cookies for its URL added to a copy of its
# header.
def with_jar_cookies(r: Request, j: CookieJar) -> Request {
  out = r
  out.header = r.header.clone
  pu = nurl.parse(r.url)
  if pu.ok? {
    for c in j.cookies(pu.unwrap) {
      add_cookie(out, c)
    }
  }
  out
}

def ip_literal?(host: Str) -> Bool {
  netip.parse_addr(host).ok?
}

# The address to dial for a host name resolved to `addrs` (the first IPv4
# one, as the runtime prefers, else the first).
def first_addr(addrs: [Str]) -> Str {
  for a in addrs {
    return a unless strings.contains(a, ":")
  }
  addrs[0]
}

def send_once(req: Request, tls_config: tls.Config?) -> ~Response {
  u = ~parse_url(req.url)
  tr = req.trace || httptrace.ClientTrace.new
  tr.fire_get_conn(u.host_port)
  addr = u.host_port
  if (tr.dns_start.size > 0 || tr.dns_done.size > 0) && !ip_literal?(u.host) {
    tr.fire_dns_start(httptrace.DNSStartInfo.new(host: u.host))
    lr = net.lookup_host(u.host)
    found: [Str] = lr.unwrap_or([])
    tr.fire_dns_done(httptrace.DNSDoneInfo.new(addrs: found, err: lr.err, coalesced: false))
    ~lr
    addr = net.join_host_port(first_addr(found), strconv.itoa(u.port)) if found.size > 0
  }
  tr.fire_connect_start("tcp", addr)
  dc = net.dial("tcp", addr)
  tr.fire_connect_done("tcp", addr, dc.err)
  conn = ~dc
  tr.fire_got_conn(httptrace.GotConnInfo.new(conn: conn, reused: false, was_idle: false, idle_time: 0))
  if u.scheme == "https" {
    cfg = tls_config || tls.Config.new
    cfg.server_name = u.host if cfg.server_name == ""
    tc = tls.client(conn, cfg)
    hs = tc.handshake!
    if hs.err? {
      conn.close!
      ~hs
    }
    return ~exchange(req, u, tr, bufio.new_writer(tc), bufio.new_reader(tc), ->() {
      t2 = tc
      t2.close!
      nil
    })
  }
  ~exchange(req, u, tr, bufio.new_writer(conn), bufio.new_reader(conn), ->() {
    c2 = conn
    c2.close!
    nil
  })
}

# Writes the request and reads the response over an open connection, then
# closes it.
def exchange(req: Request, u: Url, tr: httptrace.ClientTrace, bw: bufio.Writer, br0: bufio.Reader, close: () -> Unit) -> ~Response {
  br = br0
  h = req.header.clone
  h.set!("Host", req.host) unless h.has?("Host")
  # (the request's own Connection tokens are kept, as Go's transport does)
  conn_tokens = strings.join(h.values("Connection"), ", ")
  h.add!("Connection", "close") unless has_token?(conn_tokens, "close")
  h.set!("User-Agent", "alx-http/1") unless h.has?("User-Agent")
  # An empty User-Agent means "send none" (Go).
  h.del!("User-Agent") if h.get("User-Agent") == ""
  # (Go: credentials in the URL become a Basic Authorization header)
  if !h.has?("Authorization") {
    if ui = nurl.parse(req.url).unwrap_or(nurl.Url.new).user {
      h.set!("Authorization", "Basic " + base64.std_encoding.encode_to_string((ui.username + ":" + (ui.password || "")).bytes.to_a))
    }
  }
  has_body = req.body.size > 0 || req.method == "POST" || req.method == "PUT" || req.method == "PATCH"
  h.set!("Content-Length", strconv.itoa(req.body.size)) if has_body
  wr = send_request_head(bw, req, h, u, tr)
  tr.fire_wrote_request(httptrace.WroteRequestInfo.new(err: wr.err))
  if wr.err? {
    close.call
    ~wr
  }
  pk = br.peek!(1)
  tr.fire_got_first_response_byte if pk.ok? && pk.unwrap.size > 0
  resp = read_response(br, req.method == "HEAD")
  close.call
  ~resp
}

def send_request_head(bw: bufio.Writer, req: Request, h: Header, u: Url, tr: httptrace.ClientTrace) -> ~Unit {
  w = bw
  w.~write_string!("#{req.method} #{u.request_uri} HTTP/1.1\r\n")
  for k in h.keys {
    vs: [Str] = []
    for v in h.values(k) {
      cv = clean(v)
      w.~write_string!("#{k}: #{cv}\r\n")
      vs << cv
    }
    tr.fire_wrote_header_field(k, vs)
  }
  w.~write_string!("\r\n")
  tr.fire_wrote_headers
  w.~write!(req.body) if req.body.size > 0
  w.~flush!
}

# One-off helpers using a default client.
pub def get(url: Str) -> ~Response {
  c = new_client
  c.~get(url)
}

pub def head(url: Str) -> ~Response {
  c = new_client
  c.~head(url)
}

pub def post(url: Str, content_type: Str, body: Str) -> ~Response {
  c = new_client
  c.~post(url, content_type, body)
}

pub def post_bytes(url: Str, content_type: Str, body: [Byte]) -> ~Response {
  c = new_client
  c.~post_bytes(url, content_type, body)
}
