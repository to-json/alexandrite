# What the client calls out to: a cookie jar (Go's Client.Jar) and the
# request's trace hooks (net/http/httptrace).
import nurl "net/url"
import "net/http/httptrace"

# Stores and returns cookies for the client (Go's CookieJar;
# net/http/cookiejar's Jar is one). Methods aren't `!`: an implementation
# keeps its state in shared storage (a Mutex), so copies of it are the same
# jar.
pub interface CookieJar {
  # Handles the Set-Cookie cookies of a response to a request for u.
  def set_cookies(u: nurl.Url, cookies: [Cookie])
  # The cookies to send in a request for u.
  def cookies(u: nurl.Url) -> [Cookie]
}

# The request with `trace` attached; a trace already there is composed with
# it, the new trace's hooks running first (Go's
# req.WithContext(httptrace.WithClientTrace(req.Context(), trace))).
pub def with_client_trace(r: Request, trace: httptrace.ClientTrace) -> Request {
  out = r
  out.trace = httptrace.with_client_trace(r.trace, trace)
  out
}

# The request's trace hooks, if any (Go's ContextClientTrace).
pub def client_trace(r: Request) -> httptrace.ClientTrace? {
  r.trace
}
