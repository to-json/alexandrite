# Go's net/http cookie_test.go, translated. (The GODEBUG httpcookiemaxnum
# cases are left out: alx has no GODEBUG; the default limit is tested.)
import "strings"
import "time"

def ck(name: Str, value: Str) -> Cookie {
  Cookie.new(name: name, value: value)
}

test "write set cookies" {
  tests = [
    (ck("cookie-1", "v$1"), "cookie-1=v$1"),
    (Cookie.new(name: "cookie-2", value: "two", max_age: 3600), "cookie-2=two; Max-Age=3600"),
    (Cookie.new(name: "cookie-3", value: "three", domain: ".example.com"), "cookie-3=three; Domain=example.com"),
    (Cookie.new(name: "cookie-4", value: "four", path: "/restricted/"), "cookie-4=four; Path=/restricted/"),
    (Cookie.new(name: "cookie-5", value: "five", domain: "wrong;bad.abc"), "cookie-5=five"),
    (Cookie.new(name: "cookie-6", value: "six", domain: "bad-.abc"), "cookie-6=six"),
    (Cookie.new(name: "cookie-7", value: "seven", domain: "127.0.0.1"), "cookie-7=seven; Domain=127.0.0.1"),
    (Cookie.new(name: "cookie-8", value: "eight", domain: "::1"), "cookie-8=eight"),
    (Cookie.new(name: "cookie-9", value: "expiring", expires: time.unix(1257894000, 0)), "cookie-9=expiring; Expires=Tue, 10 Nov 2009 23:00:00 GMT"),
    (Cookie.new(name: "cookie-10", value: "expiring-1601", expires: time.date(1601, 1, 1, 1, 1, 1, 1, time.utc)), "cookie-10=expiring-1601; Expires=Mon, 01 Jan 1601 01:01:01 GMT"),
    (Cookie.new(name: "cookie-11", value: "invalid-expiry", expires: time.date(1600, 1, 1, 1, 1, 1, 1, time.utc)), "cookie-11=invalid-expiry"),
    (Cookie.new(name: "cookie-12", value: "samesite-default", same_site: SAME_SITE_DEFAULT_MODE), "cookie-12=samesite-default"),
    (Cookie.new(name: "cookie-13", value: "samesite-lax", same_site: SAME_SITE_LAX_MODE), "cookie-13=samesite-lax; SameSite=Lax"),
    (Cookie.new(name: "cookie-14", value: "samesite-strict", same_site: SAME_SITE_STRICT_MODE), "cookie-14=samesite-strict; SameSite=Strict"),
    (Cookie.new(name: "cookie-15", value: "samesite-none", same_site: SAME_SITE_NONE_MODE), "cookie-15=samesite-none; SameSite=None"),
    (Cookie.new(name: "cookie-16", value: "partitioned", same_site: SAME_SITE_NONE_MODE, secure: true, path: "/", partitioned: true), "cookie-16=partitioned; Path=/; Secure; SameSite=None; Partitioned"),
    (ck("special-1", "a z"), "special-1=\"a z\""),
    (ck("special-2", " z"), "special-2=\" z\""),
    (ck("special-3", "a "), "special-3=\"a \""),
    (ck("special-4", " "), "special-4=\" \""),
    (ck("special-5", "a,z"), "special-5=\"a,z\""),
    (ck("special-6", ",z"), "special-6=\",z\""),
    (ck("special-7", "a,"), "special-7=\"a,\""),
    (ck("special-8", ","), "special-8=\",\""),
    (ck("empty-value", ""), "empty-value="),
    (ck("", ""), ""),
    (ck("\t", ""), ""),
    (ck("\r", ""), ""),
    (ck("a\nb", "v"), ""),
    (ck("a\rb", "v"), ""),
    (Cookie.new(name: "cookie", value: "quoted", quoted: true), "cookie=\"quoted\""),
    (Cookie.new(name: "cookie", value: "quoted with spaces", quoted: true), "cookie=\"quoted with spaces\""),
    (Cookie.new(name: "cookie", value: "quoted,with,commas", quoted: true), "cookie=\"quoted,with,commas\"")
  ]
  for t in tests {
    assert_eq t[0].to_s, t[1]
  }
}

test "set cookie" {
  w = new_recording_writer
  set_cookie(w, Cookie.new(name: "cookie-1", value: "one", path: "/restricted/"))
  set_cookie(w, Cookie.new(name: "cookie-2", value: "two", max_age: 3600))
  assert_eq w.header.values("Set-Cookie"), ["cookie-1=one; Path=/restricted/", "cookie-2=two; Max-Age=3600"]
}

test "add cookie" {
  tests: [([Cookie], Str)] = [
    ([], ""),
    ([ck("cookie-1", "v$1")], "cookie-1=v$1"),
    ([ck("cookie-1", "v$1"), ck("cookie-2", "v$2"), ck("cookie-3", "v$3")], "cookie-1=v$1; cookie-2=v$2; cookie-3=v$3"),
    ([Cookie.new(name: "cookie-1", value: "quoted", quoted: true), Cookie.new(name: "cookie-2", value: "quoted with spaces", quoted: true), Cookie.new(name: "cookie-3", value: "quoted,with,commas", quoted: true)], "cookie-1=\"quoted\"; cookie-2=\"quoted with spaces\"; cookie-3=\"quoted,with,commas\"")
  ]
  for t in tests {
    req = new_request("GET", "http://example.com/", []).unwrap
    for c in t[0] {
      add_cookie(req, c)
    }
    assert_eq req.header.get("Cookie"), t[1]
  }
}

def set_cookie_header(lines: [Str]) -> Header {
  h = new_header
  h.set_raw!("Set-Cookie", lines)
  h
}

def rsc(line: Str, want: Cookie) {
  assert_eq read_set_cookies(set_cookie_header([line])), [want]
  # ParseSetCookie gives the same cookie (Go's TestParseSetCookie)
  assert_eq parse_set_cookie(line).unwrap, want
}

test "read set cookies and parse set cookie" {
  rsc("Cookie-1=v$1", Cookie.new(name: "Cookie-1", value: "v$1", raw: "Cookie-1=v$1"))
  rsc("NID=99=YsDT5i3E-CXax-; expires=Wed, 23-Nov-2011 01:05:03 GMT; path=/; domain=.google.ch; HttpOnly", Cookie.new(name: "NID", value: "99=YsDT5i3E-CXax-", path: "/", domain: ".google.ch", http_only: true, expires: time.date(2011, 11, 23, 1, 5, 3, 0, time.utc), raw_expires: "Wed, 23-Nov-2011 01:05:03 GMT", raw: "NID=99=YsDT5i3E-CXax-; expires=Wed, 23-Nov-2011 01:05:03 GMT; path=/; domain=.google.ch; HttpOnly"))
  rsc(".ASPXAUTH=7E3AA; expires=Wed, 07-Mar-2012 14:25:06 GMT; path=/; HttpOnly", Cookie.new(name: ".ASPXAUTH", value: "7E3AA", path: "/", expires: time.date(2012, 3, 7, 14, 25, 6, 0, time.utc), raw_expires: "Wed, 07-Mar-2012 14:25:06 GMT", http_only: true, raw: ".ASPXAUTH=7E3AA; expires=Wed, 07-Mar-2012 14:25:06 GMT; path=/; HttpOnly"))
  rsc("ASP.NET_SessionId=foo; path=/; HttpOnly", Cookie.new(name: "ASP.NET_SessionId", value: "foo", path: "/", http_only: true, raw: "ASP.NET_SessionId=foo; path=/; HttpOnly"))
  rsc("samesitedefault=foo; SameSite", Cookie.new(name: "samesitedefault", value: "foo", same_site: SAME_SITE_DEFAULT_MODE, raw: "samesitedefault=foo; SameSite"))
  rsc("samesiteinvalidisdefault=foo; SameSite=invalid", Cookie.new(name: "samesiteinvalidisdefault", value: "foo", same_site: SAME_SITE_DEFAULT_MODE, raw: "samesiteinvalidisdefault=foo; SameSite=invalid"))
  rsc("samesitelax=foo; SameSite=Lax", Cookie.new(name: "samesitelax", value: "foo", same_site: SAME_SITE_LAX_MODE, raw: "samesitelax=foo; SameSite=Lax"))
  rsc("samesitestrict=foo; SameSite=Strict", Cookie.new(name: "samesitestrict", value: "foo", same_site: SAME_SITE_STRICT_MODE, raw: "samesitestrict=foo; SameSite=Strict"))
  rsc("samesitenone=foo; SameSite=None", Cookie.new(name: "samesitenone", value: "foo", same_site: SAME_SITE_NONE_MODE, raw: "samesitenone=foo; SameSite=None"))
  rsc("special-1=a z", Cookie.new(name: "special-1", value: "a z", raw: "special-1=a z"))
  rsc("special-2=\" z\"", Cookie.new(name: "special-2", value: " z", quoted: true, raw: "special-2=\" z\""))
  rsc("special-3=\"a \"", Cookie.new(name: "special-3", value: "a ", quoted: true, raw: "special-3=\"a \""))
  rsc("special-4=\" \"", Cookie.new(name: "special-4", value: " ", quoted: true, raw: "special-4=\" \""))
  rsc("special-5=a,z", Cookie.new(name: "special-5", value: "a,z", raw: "special-5=a,z"))
  rsc("special-6=\",z\"", Cookie.new(name: "special-6", value: ",z", quoted: true, raw: "special-6=\",z\""))
  rsc("special-7=a,", Cookie.new(name: "special-7", value: "a,", raw: "special-7=a,"))
  rsc("special-8=\",\"", Cookie.new(name: "special-8", value: ",", quoted: true, raw: "special-8=\",\""))
  rsc("special-9 =\",\"", Cookie.new(name: "special-9", value: ",", quoted: true, raw: "special-9 =\",\""))
  rsc("cookie=\"quoted\"", Cookie.new(name: "cookie", value: "quoted", quoted: true, raw: "cookie=\"quoted\""))
  lines: [Str] = []
  i = 0
  while i <= COOKIE_MAX_NUM {
    lines << "a="
    i += 1
  }
  assert_eq read_set_cookies(set_cookie_header(lines)).size, 0
  assert_eq read_set_cookies(set_cookie_header(lines[0...COOKIE_MAX_NUM])).size, COOKIE_MAX_NUM
}

test "parse set cookie errors" {
  assert_eq parse_set_cookie("").err.unwrap.message, "http: blank cookie"
  assert_eq parse_set_cookie("equal-not-found").err.unwrap.message, "http: '=' not found in cookie"
  assert_eq parse_set_cookie("=v1").err.unwrap.message, "http: invalid cookie name"
  assert_eq parse_set_cookie("k1=\\").err.unwrap.message, "http: invalid cookie value"
}

def cookie_header(lines: [Str]) -> Header {
  h = new_header
  h.set_raw!("Cookie", lines)
  h
}

test "read cookies" {
  assert_eq read_cookies(cookie_header(["Cookie-1=v$1", "c2=v2"]), ""), [ck("Cookie-1", "v$1"), ck("c2", "v2")]
  assert_eq read_cookies(cookie_header(["Cookie-1=v$1", "c2=v2"]), "c2"), [ck("c2", "v2")]
  assert_eq read_cookies(cookie_header(["Cookie-1=v$1; c2=v2"]), ""), [ck("Cookie-1", "v$1"), ck("c2", "v2")]
  assert_eq read_cookies(cookie_header(["Cookie-1=v$1; c2=v2"]), "c2"), [ck("c2", "v2")]
  assert_eq read_cookies(cookie_header(["Cookie-1=\"v$1\"; c2=\"v2\""]), ""), [Cookie.new(name: "Cookie-1", value: "v$1", quoted: true), Cookie.new(name: "c2", value: "v2", quoted: true)]
  assert_eq read_cookies(cookie_header(["Cookie-1=\"v$1\"; c2=v2;"]), ""), [Cookie.new(name: "Cookie-1", value: "v$1", quoted: true), ck("c2", "v2")]
  assert_eq read_cookies(cookie_header([""]), "").size, 0
  many = strings.repeat(";a=", COOKIE_MAX_NUM + 1)
  assert_eq read_cookies(cookie_header([many[1...many.size]]), "").size, 0
  some = strings.repeat(";a=", COOKIE_MAX_NUM)
  assert_eq read_cookies(cookie_header([some[1...some.size]]), "").size, COOKIE_MAX_NUM
}

test "set cookie double quotes" {
  h = new_header
  h.add!("Set-Cookie", "quoted0=none; max-age=30")
  h.add!("Set-Cookie", "quoted1=\"cookieValue\"; max-age=31")
  h.add!("Set-Cookie", "quoted2=cookieAV; max-age=\"32\"")
  h.add!("Set-Cookie", "quoted3=\"both\"; max-age=\"33\"")
  got = read_set_cookies(h)
  want = [("quoted0", "none", 30), ("quoted1", "cookieValue", 31), ("quoted2", "cookieAV", 0), ("quoted3", "both", 0)]
  assert_eq got.size, want.size
  i = 0
  while i < want.size {
    assert_eq (got[i].name, got[i].value, got[i].max_age), want[i]
    i += 1
  }
}

test "cookie sanitize value" {
  tests = [
    ("foo", false, "foo"),
    ("foo;bar", false, "foobar"),
    ("foo\\bar", false, "foobar"),
    ("foo\"bar", false, "foobar"),
    (Str.from_bytes([0, 0x7e, 0x7f, 0xc2, 0x80]), false, "~"),
    ("withquotes", true, "\"withquotes\""),
    ("\"withquotes\"", true, "\"withquotes\""),
    ("a z", false, "\"a z\""),
    (" z", false, "\" z\""),
    ("a ", false, "\"a \""),
    ("a,z", false, "\"a,z\""),
    (",z", false, "\",z\""),
    ("a,", false, "\"a,\""),
    ("", true, "\"\"")
  ]
  for t in tests {
    assert_eq sanitize_cookie_value(t[0], t[1]), t[2]
  }
}

test "cookie sanitize path" {
  assert_eq sanitize_cookie_path("/path"), "/path"
  assert_eq sanitize_cookie_path("/path with space/"), "/path with space/"
  assert_eq sanitize_cookie_path("/just;no;semicolon\x00orstuff/"), "/justnosemicolonorstuff/"
}

test "cookie valid" {
  tests = [
    (Cookie.new(name: ""), false),
    (Cookie.new(name: "invalid-value", value: "foo\"bar"), false),
    (Cookie.new(name: "invalid-path", path: "/foo;bar/"), false),
    (Cookie.new(name: "invalid-secure-for-partitioned", value: "foo", path: "/", secure: false, partitioned: true), false),
    (Cookie.new(name: "invalid-domain", domain: "example.com:80"), false),
    (Cookie.new(name: "invalid-expiry", value: "", expires: time.date(1600, 1, 1, 1, 1, 1, 1, time.utc)), false),
    (Cookie.new(name: "valid-empty"), true),
    (Cookie.new(name: "valid-expires", value: "foo", path: "/bar", domain: "example.com", expires: time.unix(0, 0)), true),
    (Cookie.new(name: "valid-max-age", value: "foo", path: "/bar", domain: "example.com", max_age: 60), true),
    (Cookie.new(name: "valid-all-fields", value: "foo", path: "/bar", domain: "example.com", expires: time.unix(0, 0), max_age: 0), true),
    (Cookie.new(name: "valid-partitioned", value: "foo", path: "/", secure: true, partitioned: true), true)
  ]
  for t in tests {
    assert_eq t[0].valid.ok?, t[1]
  }
  assert_eq Cookie.new(name: "x", value: "a\"b").valid.err.unwrap.message, "http: invalid byte '\"' in Cookie.Value"
}

test "cookie string benchmark value" {
  c = Cookie.new(name: "cookie-9", value: "i3e01nf61b6t23bvfmplnanol3", expires: time.unix(1257894000, 0), path: "/restricted/", domain: ".example.com", max_age: 3600)
  assert_eq c.to_s, "cookie-9=i3e01nf61b6t23bvfmplnanol3; Path=/restricted/; Domain=example.com; Expires=Tue, 10 Nov 2009 23:00:00 GMT; Max-Age=3600"
}

test "read cookies benchmark value" {
  line = "de=; client_region=0; rpld1=0:hispeed.ch|20:che|21:zh|22:zurich|23:47.36|24:8.53|; rpld0=1:08|; backplane-channel=newspaper.com:1471; devicetype=0; osfam=0; rplmct=2"
  want = [ck("de", ""), ck("client_region", "0"), ck("rpld1", "0:hispeed.ch|20:che|21:zh|22:zurich|23:47.36|24:8.53|"), ck("rpld0", "1:08|"), ck("backplane-channel", "newspaper.com:1471"), ck("devicetype", "0"), ck("osfam", "0"), ck("rplmct", "2")]
  assert_eq read_cookies(cookie_header([line]), ""), want
  assert_eq parse_cookie(line).unwrap, want
}

test "parse cookie" {
  assert_eq parse_cookie("Cookie-1=v$1").unwrap, [ck("Cookie-1", "v$1")]
  assert_eq parse_cookie("Cookie-1=v$1;c2=v2").unwrap, [ck("Cookie-1", "v$1"), ck("c2", "v2")]
  assert_eq parse_cookie("Cookie-1=\"v$1\";c2=\"v2\"").unwrap, [Cookie.new(name: "Cookie-1", value: "v$1", quoted: true), Cookie.new(name: "c2", value: "v2", quoted: true)]
  assert_eq parse_cookie("k1=").unwrap, [ck("k1", "")]
  assert_eq parse_cookie("").err.unwrap.message, "http: blank cookie"
  assert_eq parse_cookie("equal-not-found").err.unwrap.message, "http: '=' not found in cookie"
  assert_eq parse_cookie("=v1").err.unwrap.message, "http: invalid cookie name"
  assert_eq parse_cookie("k1=\\").err.unwrap.message, "http: invalid cookie value"
  many = strings.repeat(";a=", COOKIE_MAX_NUM + 1)
  assert_eq parse_cookie(many[1...many.size]).err.unwrap.message, "http: number of cookies exceeded limit"
}

test "request cookie accessors" {
  req = new_request("GET", "http://example.com/", []).unwrap
  req.header.add!("Cookie", "a=1; b=2")
  req.header.add!("Cookie", "a=3")
  assert_eq request_cookies(req).size, 3
  assert_eq request_cookie(req, "b").unwrap.value, "2"
  assert_eq request_cookies_named(req, "a").map { it.value }.to_a, ["1", "3"]
  assert_eq request_cookie(req, "zz").err.unwrap.message, "http: named cookie not present"
  assert_eq request_cookies_named(req, "").size, 0
}

# --------------------------------------------- helpers for vec_cookie_test

# A cookie as one line (the vectors' rendering).
def cs(c: Cookie) -> Str {
  exp = c.expires.is_zero ? "zero" : "#{c.expires.unix}"
  "#{c.name}|#{c.value}|#{c.quoted}|#{c.path}|#{c.domain}|#{exp}|#{c.raw_expires}|#{c.max_age}|#{c.secure}|#{c.http_only}|#{c.same_site}|#{c.partitioned}|#{strings.join(c.unparsed, ",")}"
}

def psc(line: Str) -> Str {
  r = parse_set_cookie(line)
  return "ERR " + r.err.unwrap.message if r.err?
  cs(r.unwrap)
}

def pc(line: Str) -> Str {
  r = parse_cookie(line)
  return "ERR " + r.err.unwrap.message if r.err?
  strings.join(r.unwrap.map { cs(it) }.to_a, " ; ")
}

def rc(line: Str, filter: Str) -> Str {
  strings.join(read_cookies(cookie_header([line]), filter).map { cs(it) }.to_a, " ; ")
}

def cstr(name: Str, value: Str, quoted: Bool, path: Str, domain: Str, exp: Int, max_age: Int, secure: Bool, http_only: Bool, same_site: Int, partitioned: Bool) -> Str {
  c = Cookie.new(name: name, value: value, quoted: quoted, path: path, domain: domain, max_age: max_age, secure: secure, http_only: http_only, same_site: same_site, partitioned: partitioned)
  c.expires = time.unix(exp, 0) if exp != 0
  c.to_s
}
