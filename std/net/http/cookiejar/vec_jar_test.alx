  jar = new_test_jar()
  run_jar_test(jar, "Sorting of same-name cookies.", "http://www.host.test/", ["A=1; path=/", "A=2; path=/path", "A=3; path=/quux", "A=4; path=/path/foo", "A=5; domain=.host.test; path=/path", "A=6; domain=.host.test; path=/quux", "A=7; domain=.host.test; path=/path/foo"], "A=1 A=2 A=3 A=4 A=5 A=6 A=7", [("http://www.host.test/path", "A=2 A=5 A=1"), ("http://www.host.test/path/foo", "A=4 A=7 A=2 A=5 A=1")])
  jar = new_test_jar()
  run_jar_test(jar, "Disallow domain cookie on public suffix.", "http://www.bbc.co.uk", ["a=1", "b=2; domain=co.uk"], "a=1", [("http://www.bbc.co.uk", "a=1")])
  jar = new_test_jar()
