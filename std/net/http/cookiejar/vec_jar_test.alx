  jar = new_test_jar()
  run_jar_test(jar, "Localhost only if it's a segment", "http://notlocalhost/", ["A=a; secure"], "A=a", [("http://notlocalhost", ""), ("http://notlocalhost/", ""), ("http://notlocalhost/some/path", ""), ("https://notlocalhost", "A=a"), ("https://notlocalhost/", "A=a"), ("https://notlocalhost/some/path", "A=a")])
  jar = new_test_jar()
  run_jar_test(jar, "Explicit path.", "http://www.host.test/", ["A=a; path=/some/path"], "A=a", [("http://www.host.test", ""), ("http://www.host.test/", ""), ("http://www.host.test/some", ""), ("http://www.host.test/some/", ""), ("http://www.host.test/some/path", "A=a"), ("http://www.host.test/some/paths", ""), ("http://www.host.test/some/path/foo", "A=a"), ("http://www.host.test/some/path/foo/", "A=a")])
  jar = new_test_jar()
  run_jar_test(jar, "Implicit path #1: path is a directory.", "http://www.host.test/some/path/", ["A=a"], "A=a", [("http://www.host.test", ""), ("http://www.host.test/", ""), ("http://www.host.test/some", ""), ("http://www.host.test/some/", ""), ("http://www.host.test/some/path", "A=a"), ("http://www.host.test/some/paths", ""), ("http://www.host.test/some/path/foo", "A=a"), ("http://www.host.test/some/path/foo/", "A=a")])
  jar = new_test_jar()
  run_jar_test(jar, "Implicit path #2: path is not a directory.", "http://www.host.test/some/path/index.html", ["A=a"], "A=a", [("http://www.host.test", ""), ("http://www.host.test/", ""), ("http://www.host.test/some", ""), ("http://www.host.test/some/", ""), ("http://www.host.test/some/path", "A=a"), ("http://www.host.test/some/paths", ""), ("http://www.host.test/some/path/foo", "A=a"), ("http://www.host.test/some/path/foo/", "A=a")])
  jar = new_test_jar()
