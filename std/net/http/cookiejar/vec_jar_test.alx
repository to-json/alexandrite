  run_jar_test(jar, "session 308 step 1", "http://a.b.host.test:8080/a", ["sid=0; domain=xn--bcher-kva.test; max-age=2", "a=4; domain=xn--bcher-kva.test"], "", [("ftp://www.buggy.psl:8080/a/b/c.html", ""), ("ftp://bbc.co.uk:8080/", ""), ("https://a.b.host.test:8080/a/", "")])
