test "canonical host" {
  assert_eq ch("."), ""
  assert_eq ch(".."), "."
  assert_eq ch("..."), ".."
  assert_eq ch(".net"), ".net"
  assert_eq ch(".net."), ".net"
  assert_eq ch("192.168.0.10"), "192.168.0.10"
  assert_eq ch("192.168.0.5:8080"), "192.168.0.5"
  assert_eq ch("2001:4860:0:2001::68"), "2001:4860:0:2001::68"
  assert_eq ch("WWW.EXAMPLE.COM"), "www.example.com"
  assert_eq ch("[2001:4860:0:::68]:8080"), "2001:4860:0:::68"
  assert_eq ch("[bad.unmatched.bracket:"), "error"
  assert_eq ch("a.."), "a."
  assert_eq ch("b.a.."), "b.a."
  assert_eq ch("wWw.eXAmple.CoM"), "www.example.com"
  assert_eq ch("weird.stuff..."), "weird.stuff.."
  assert_eq ch("www.bücher.de"), "www.xn--bcher-kva.de"
  assert_eq ch("www.example.com"), "www.example.com"
  assert_eq ch("www.example.com."), "www.example.com"
  assert_eq ch("www.example.com:80"), "www.example.com"
}

test "has port" {
  assert_eq has_port?("127.0.0.1"), false
  assert_eq has_port?("127.0.0.1:8080"), true
  assert_eq has_port?("2001:4860:0:2001::68"), false
  assert_eq has_port?("[2001::0:::68]:80"), true
  assert_eq has_port?("www.example.com"), false
  assert_eq has_port?("www.example.com:80"), true
}

test "jar key" {
  assert_eq jar_key("", test_psl()), ""
  assert_eq jar_key(".", test_psl()), "."
  assert_eq jar_key("..", test_psl()), "."
  assert_eq jar_key(".net", test_psl()), ".net"
  assert_eq jar_key("192.168.0.5", test_psl()), "192.168.0.5"
  assert_eq jar_key("a.", test_psl()), "a."
  assert_eq jar_key("b.a.", test_psl()), "a."
  assert_eq jar_key("bbc.co.uk", test_psl()), "bbc.co.uk"
  assert_eq jar_key("co.uk", test_psl()), "co.uk"
  assert_eq jar_key("com", test_psl()), "com"
  assert_eq jar_key("example.com", test_psl()), "example.com"
  assert_eq jar_key("foo.www.bbc.co.uk", test_psl()), "bbc.co.uk"
  assert_eq jar_key("foo.www.example.com", test_psl()), "example.com"
  assert_eq jar_key("uk", test_psl()), "uk"
  assert_eq jar_key("weird.stuff..", test_psl()), "."
  assert_eq jar_key("www.bbc.co.uk", test_psl()), "bbc.co.uk"
  assert_eq jar_key("www.buggy.psl", test_psl()), "www.buggy.psl"
  assert_eq jar_key("www.example.com", test_psl()), "example.com"
  assert_eq jar_key("www2.buggy.psl", test_psl()), "buggy.psl"
}

test "jar key nil PSL" {
  assert_eq jar_key("", none), ""
  assert_eq jar_key(".", none), "."
  assert_eq jar_key("..", none), ".."
  assert_eq jar_key(".net", none), ".net"
  assert_eq jar_key("192.168.0.5", none), "192.168.0.5"
  assert_eq jar_key("a.", none), "a."
  assert_eq jar_key("b.a.", none), "a."
  assert_eq jar_key("bbc.co.uk", none), "co.uk"
  assert_eq jar_key("co.uk", none), "co.uk"
  assert_eq jar_key("com", none), "com"
  assert_eq jar_key("example.com", none), "example.com"
  assert_eq jar_key("foo.www.bbc.co.uk", none), "co.uk"
  assert_eq jar_key("foo.www.example.com", none), "example.com"
  assert_eq jar_key("uk", none), "uk"
  assert_eq jar_key("weird.stuff..", none), "stuff.."
  assert_eq jar_key("www.bbc.co.uk", none), "co.uk"
  assert_eq jar_key("www.example.com", none), "example.com"
}

test "is IP" {
  assert_eq ip?("1.1.1.300"), false
  assert_eq ip?("1.2.3.4"), true
  assert_eq ip?("123.foo.bar.net"), false
  assert_eq ip?("127.0.0.1"), true
  assert_eq ip?("2001:4860:0:2001::68"), true
  assert_eq ip?("::1%zone"), true
  assert_eq ip?("example.com"), false
  assert_eq ip?("www.foo.bar.net"), false
}

test "default path" {
  assert_eq default_path(""), "/"
  assert_eq default_path("/"), "/"
  assert_eq default_path("//"), "/"
  assert_eq default_path("/a/../b"), "/a/.."
  assert_eq default_path("/a/./b"), "/a/."
  assert_eq default_path("/a//b"), "/a/"
  assert_eq default_path("/a/b/c.html"), "/a/b"
  assert_eq default_path("/abc"), "/"
  assert_eq default_path("/abc/"), "/abc"
  assert_eq default_path("/abc/xyz"), "/abc"
  assert_eq default_path("/abc/xyz/"), "/abc/xyz"
  assert_eq default_path("strange"), "/"
}

test "domain and type" {
  assert_eq dat("www.example.com", ""), "www.example.com|true"
  assert_eq dat("127.0.0.1", ""), "127.0.0.1|true"
  assert_eq dat("2001:4860:0:2001::68", ""), "2001:4860:0:2001::68|true"
  assert_eq dat("www.example.com", "example.com"), "example.com|false"
  assert_eq dat("www.example.com", ".example.com"), "example.com|false"
  assert_eq dat("www.example.com", "www.example.com"), "www.example.com|false"
  assert_eq dat("www.example.com", ".www.example.com"), "www.example.com|false"
  assert_eq dat("foo.sso.example.com", "sso.example.com"), "sso.example.com|false"
  assert_eq dat("bar.co.uk", "bar.co.uk"), "bar.co.uk|false"
  assert_eq dat("foo.bar.co.uk", ".bar.co.uk"), "bar.co.uk|false"
  assert_eq dat("127.0.0.1", "127.0.0.1"), "127.0.0.1|true"
  assert_eq dat("2001:4860:0:2001::68", "2001:4860:0:2001::68"), "2001:4860:0:2001::68|true"
  assert_eq dat("www.example.com", "."), "ERR cookiejar: malformed cookie domain attribute"
  assert_eq dat("www.example.com", ".."), "ERR cookiejar: malformed cookie domain attribute"
  assert_eq dat("www.example.com", "other.com"), "ERR cookiejar: illegal cookie domain attribute"
  assert_eq dat("www.example.com", "com"), "ERR cookiejar: illegal cookie domain attribute"
  assert_eq dat("www.example.com", ".com"), "ERR cookiejar: illegal cookie domain attribute"
  assert_eq dat("foo.bar.co.uk", ".co.uk"), "ERR cookiejar: illegal cookie domain attribute"
  assert_eq dat("127.www.0.0.1", "127.0.0.1"), "ERR cookiejar: illegal cookie domain attribute"
  assert_eq dat("com", ""), "com|true"
  assert_eq dat("com", "com"), "com|true"
  assert_eq dat("com", ".com"), "com|true"
  assert_eq dat("co.uk", ""), "co.uk|true"
  assert_eq dat("co.uk", "co.uk"), "co.uk|true"
  assert_eq dat("co.uk", ".co.uk"), "co.uk|true"
}

test "basics" {
  jar = new_test_jar()
  run_jar_test(jar, "Retrieval of a plain host cookie.", "http://www.host.test/", ["A=a"], "A=a", [("http://www.host.test", "A=a"), ("http://www.host.test/", "A=a"), ("http://www.host.test/some/path", "A=a"), ("https://www.host.test", "A=a"), ("https://www.host.test/", "A=a"), ("https://www.host.test/some/path", "A=a"), ("ftp://www.host.test", ""), ("ftp://www.host.test/", ""), ("ftp://www.host.test/some/path", ""), ("http://www.other.org", ""), ("http://sibling.host.test", ""), ("http://deep.www.host.test", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Secure cookies are not returned to http.", "http://www.host.test/", ["A=a; secure"], "A=a", [("http://www.host.test", ""), ("http://www.host.test/", ""), ("http://www.host.test/some/path", ""), ("https://www.host.test", "A=a"), ("https://www.host.test/", "A=a"), ("https://www.host.test/some/path", "A=a")])
  jar = new_test_jar()
  run_jar_test(jar, "Secure cookies are sent for localhost", "http://localhost:8910/", ["A=a; secure"], "A=a", [("http://localhost:8910", "A=a"), ("http://localhost:8910/", "A=a"), ("http://localhost:8910/some/path", "A=a"), ("https://localhost:8910", "A=a"), ("https://localhost:8910/", "A=a"), ("https://localhost:8910/some/path", "A=a")])
  jar = new_test_jar()
  run_jar_test(jar, "Secure cookies are sent for localhost (tld)", "http://example.LOCALHOST:8910/", ["A=a; secure"], "A=a", [("http://example.LOCALHOST:8910", "A=a"), ("http://example.LOCALHOST:8910/", "A=a"), ("http://example.LOCALHOST:8910/some/path", "A=a"), ("https://example.LOCALHOST:8910", "A=a"), ("https://example.LOCALHOST:8910/", "A=a"), ("https://example.LOCALHOST:8910/some/path", "A=a")])
  jar = new_test_jar()
