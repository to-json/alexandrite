test "vectors: jar sessions 12" {
  jar = new_test_jar()
  run_jar_test(jar, "session 300 step 0", "http://www.bücher.test:8080/a/b/c.html", ["sid=2; domain=test", "b=5; domain=HOST.TEST; max-age=100"], "", [("ftp://www.bücher.test/a/b", "")])
  run_jar_test(jar, "session 300 step 1", "http://co.uk:8080", ["b=3", "A=9; domain=co.uk; max-age=100"], "A=9 b=3", [("ftp://localhost:8080/a/b", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 301 step 0", "https://www.buggy.psl/a/b", ["A=3; domain=192.168.0.1", "b=9; path=/a/b"], "b=9", [("http://www.bbc.co.uk:8080/b", ""), ("ftp://localhost:8080/a/", ""), ("ftp://www.bbc.co.uk:8080/a", "")])
  run_jar_test(jar, "session 301 step 1", "ftp://bbc.co.uk:8080", ["b=0; domain=test", "b=5; domain=.host.test", "a=6; domain=xn--bcher-kva.test; max-age=100"], "b=9", [("https://www2.buggy.psl/a/b", ""), ("https://co.uk:8080/a/b/c.html", ""), ("https://host.test/a/b", ""), ("http://a.b.host.test:8080/a/b", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 302 step 0", "https://host.test/a/b", ["b=5", "sid=7; domain=bbc.co.uk; path=/; expires=Tue, 01 Jan 2013 11:59:50 UTC", "b=4; domain=host.test; expires=Tue, 01 Jan 2013 11:59:50 UTC"], "", [("http://www.host.test/a/", ""), ("http://192.168.0.1:8080/b", ""), ("https://WWW.Host.Test:8080/", "")])
  run_jar_test(jar, "session 302 step 1", "http://x.localhost:8080", ["A=5; domain=xn--bcher-kva.test; expires=Tue, 01 Jan 2013 12:16:40 UTC", "a=8; domain=host.test", "a=3; domain=.host.test; expires=Tue, 01 Jan 2013 11:59:50 UTC; secure"], "", [("http://www.host.test/a", ""), ("http://host.test/a/b/c.html", ""), ("https://www.buggy.psl:8080", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 303 step 0", "http://localhost:8080/a/", ["b=2", "b=3; domain=192.168.0.1; max-age=-1"], "b=2", [("https://a.b.host.test:8080/a", ""), ("http://a.b.host.test:8080/a/b/c.html", ""), ("http://localhost:8080/", "")])
  run_jar_test(jar, "session 303 step 1", "http://192.168.0.1/", ["b=1; domain=host.test; path=/a", "a=0; domain=HOST.TEST; path=/", "sid=1; domain=buggy.psl"], "b=2", [("http://www2.buggy.psl:8080", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 304 step 0", "http://co.uk/b", ["a=9; domain=other.test; path=/a", "b=4; domain=www.host.test; secure; httponly"], "", [("ftp://www.bbc.co.uk:8080", ""), ("ftp://WWW.Host.Test/a/b/c.html", "")])
  run_jar_test(jar, "session 304 step 1", "ftp://www.bücher.test:8080/a/", ["sid=2; domain=test; path=/a/b; httponly", "b=6; domain=bbc.co.uk"], "", [("http://x.localhost:8080/", "")])
  jar = new_jar(Options.new)
  run_jar_test(jar, "session 305 step 0", "http://www.bücher.test/a/", ["sid=7; domain=host.test; max-age=100", "b=1; domain=HOST.TEST"], "", [("https://x.localhost/b", ""), ("http://co.uk:8080/a/b", "")])
  run_jar_test(jar, "session 305 step 1", "http://www.bücher.test:8080/", ["sid=2; domain=HOST.TEST; httponly", "b=1; domain=bbc.co.uk; samesite=lax"], "", [("ftp://localhost:8080/a", ""), ("https://localhost:8080", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 306 step 0", "https://www.host.test:8080", ["a=6; expires=Tue, 01 Jan 2013 12:16:40 UTC", "sid=0; domain=xn--bcher-kva.test; path=/", "A=1; domain=192.168.0.1; max-age=100"], "a=6", [("https://[::1]", ""), ("http://www.bbc.co.uk:8080/a/b", "")])
