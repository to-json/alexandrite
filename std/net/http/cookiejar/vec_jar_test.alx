  assert_eq has_dot_suffix?("x", "x"), false
  assert_eq has_dot_suffix?("x", "x."), false
  assert_eq has_dot_suffix?("x", ".x"), false
  assert_eq has_dot_suffix?("x", ".x."), false
  assert_eq has_dot_suffix?(".x", ""), false
  assert_eq has_dot_suffix?(".x", "."), false
  assert_eq has_dot_suffix?(".x", ".."), false
  assert_eq has_dot_suffix?(".x", "x"), true
  assert_eq has_dot_suffix?(".x", "x."), false
  assert_eq has_dot_suffix?(".x", ".x"), false
  assert_eq has_dot_suffix?(".x", ".x."), false
  assert_eq has_dot_suffix?("x.", ""), true
  assert_eq has_dot_suffix?("x.", "."), false
  assert_eq has_dot_suffix?("x.", ".."), false
  assert_eq has_dot_suffix?("x.", "x"), false
  assert_eq has_dot_suffix?("x.", "x."), false
  assert_eq has_dot_suffix?("x.", ".x"), false
  assert_eq has_dot_suffix?("x.", ".x."), false
  assert_eq has_dot_suffix?("com", ""), false
  assert_eq has_dot_suffix?("com", "m"), false
  assert_eq has_dot_suffix?("com", "om"), false
  assert_eq has_dot_suffix?("com", "com"), false
  assert_eq has_dot_suffix?("com", ".com"), false
  assert_eq has_dot_suffix?("com", "x.com"), false
  assert_eq has_dot_suffix?("com", "xcom"), false
  assert_eq has_dot_suffix?("com", "xorg"), false
  assert_eq has_dot_suffix?("com", "org"), false
  assert_eq has_dot_suffix?("com", "rg"), false
  assert_eq has_dot_suffix?("foo.com", ""), false
  assert_eq has_dot_suffix?("foo.com", "m"), false
