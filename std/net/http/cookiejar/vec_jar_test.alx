  run_jar_test(jar, "session 309 step 1", "https://www.bücher.test", ["b=5; domain=co.uk", "sid=8; domain=bbc.co.uk; max-age=100"], "A=5", [("ftp://co.uk/a/b/c.html", ""), ("http://localhost:8080/b", "")])
