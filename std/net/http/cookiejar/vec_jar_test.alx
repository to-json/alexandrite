test "update and delete" {
  jar = new_test_jar()
  run_jar_test(jar, "Set initial cookies.", "http://www.host.test", ["a=1", "b=2; secure", "c=3; httponly", "d=4; secure; httponly"], "a=1 b=2 c=3 d=4", [("http://www.host.test", "a=1 c=3"), ("https://www.host.test", "a=1 b=2 c=3 d=4")])
  run_jar_test(jar, "Update value via http.", "http://www.host.test", ["a=w", "b=x; secure", "c=y; httponly", "d=z; secure; httponly"], "a=w b=x c=y d=z", [("http://www.host.test", "a=w c=y"), ("https://www.host.test", "a=w b=x c=y d=z")])
  run_jar_test(jar, "Clear Secure flag from an http.", "http://www.host.test/", ["b=xx", "d=zz; httponly"], "a=w b=xx c=y d=zz", [("http://www.host.test", "a=w b=xx c=y d=zz")])
  run_jar_test(jar, "Delete all.", "http://www.host.test/", ["a=1; max-Age=-1", "b=2; expires=Tue, 01 Jan 2013 11:59:50 UTC", "c=2; max-age=-1; expires=Tue, 01 Jan 2013 11:59:50 UTC", "d=4; max-age=-1; expires=Tue, 01 Jan 2013 12:00:10 UTC"], "", [("http://www.host.test", "")])
  run_jar_test(jar, "Refill #1.", "http://www.host.test", ["A=1", "A=2; path=/foo", "A=3; domain=.host.test", "A=4; path=/foo; domain=.host.test"], "A=1 A=2 A=3 A=4", [("http://www.host.test/foo", "A=2 A=4 A=1 A=3")])
  run_jar_test(jar, "Refill #2.", "http://www.google.com", ["A=6", "A=7; path=/foo", "A=8; domain=.google.com", "A=9; path=/foo; domain=.google.com"], "A=1 A=2 A=3 A=4 A=6 A=7 A=8 A=9", [("http://www.host.test/foo", "A=2 A=4 A=1 A=3"), ("http://www.google.com/foo", "A=7 A=9 A=6 A=8")])
  run_jar_test(jar, "Delete A7.", "http://www.google.com", ["A=; path=/foo; max-age=-1"], "A=1 A=2 A=3 A=4 A=6 A=8 A=9", [("http://www.host.test/foo", "A=2 A=4 A=1 A=3"), ("http://www.google.com/foo", "A=9 A=6 A=8")])
  run_jar_test(jar, "Delete A4.", "http://www.host.test", ["A=; path=/foo; domain=host.test; max-age=-1"], "A=1 A=2 A=3 A=6 A=8 A=9", [("http://www.host.test/foo", "A=2 A=1 A=3"), ("http://www.google.com/foo", "A=9 A=6 A=8")])
  run_jar_test(jar, "Delete A6.", "http://www.google.com", ["A=; max-age=-1"], "A=1 A=2 A=3 A=8 A=9", [("http://www.host.test/foo", "A=2 A=1 A=3"), ("http://www.google.com/foo", "A=9 A=8")])
  run_jar_test(jar, "Delete A3.", "http://www.host.test", ["A=; domain=host.test; max-age=-1"], "A=1 A=2 A=8 A=9", [("http://www.host.test/foo", "A=2 A=1"), ("http://www.google.com/foo", "A=9 A=8")])
  run_jar_test(jar, "No cross-domain delete.", "http://www.host.test", ["A=; domain=google.com; max-age=-1", "A=; path=/foo; domain=google.com; max-age=-1"], "A=1 A=2 A=8 A=9", [("http://www.host.test/foo", "A=2 A=1"), ("http://www.google.com/foo", "A=9 A=8")])
  run_jar_test(jar, "Delete A8 and A9.", "http://www.google.com", ["A=; domain=google.com; max-age=-1", "A=; path=/foo; domain=google.com; max-age=-1"], "A=1 A=2", [("http://www.host.test/foo", "A=2 A=1"), ("http://www.google.com/foo", "")])
}

test "expiration" {
  jar = new_test_jar()
  run_jar_test(jar, "Expiration.", "http://www.host.test", ["a=1", "b=2; max-age=3", "c=3; expires=Tue, 01 Jan 2013 12:00:03 UTC", "d=4; max-age=5", "e=5; expires=Tue, 01 Jan 2013 12:00:05 UTC", "f=6; max-age=100"], "a=1 b=2 c=3 d=4 e=5 f=6", [("http://www.host.test", "a=1 b=2 c=3 d=4 e=5 f=6"), ("http://www.host.test", "a=1 d=4 e=5 f=6"), ("http://www.host.test", "a=1 d=4 e=5 f=6"), ("http://www.host.test", "a=1 f=6"), ("http://www.host.test", "a=1 f=6")])
}

test "chromium basics" {
  jar = new_test_jar()
  run_jar_test(jar, "DomainWithTrailingDotTest.", "http://www.google.com/", ["a=1; domain=.www.google.com.", "b=2; domain=.www.google.com.."], "", [("http://www.google.com", "")])
  jar = new_test_jar()
  run_jar_test(jar, "ValidSubdomainTest #1.", "http://a.b.c.d.com", ["a=1; domain=.a.b.c.d.com", "b=2; domain=.b.c.d.com", "c=3; domain=.c.d.com", "d=4; domain=.d.com"], "a=1 b=2 c=3 d=4", [("http://a.b.c.d.com", "a=1 b=2 c=3 d=4"), ("http://b.c.d.com", "b=2 c=3 d=4"), ("http://c.d.com", "c=3 d=4"), ("http://d.com", "d=4")])
  jar = new_test_jar()
  run_jar_test(jar, "ValidSubdomainTest #2.", "http://a.b.c.d.com", ["a=1; domain=.a.b.c.d.com", "b=2; domain=.b.c.d.com", "c=3; domain=.c.d.com", "d=4; domain=.d.com", "X=bcd; domain=.b.c.d.com", "X=cd; domain=.c.d.com"], "X=bcd X=cd a=1 b=2 c=3 d=4", [("http://b.c.d.com", "b=2 c=3 d=4 X=bcd X=cd"), ("http://c.d.com", "c=3 d=4 X=cd")])
  jar = new_test_jar()
  run_jar_test(jar, "InvalidDomainTest #1.", "http://foo.bar.com", ["a=1; domain=.yo.foo.bar.com", "b=2; domain=.foo.com", "c=3; domain=.bar.foo.com", "d=4; domain=.foo.bar.com.net", "e=5; domain=ar.com", "f=6; domain=.", "g=7; domain=/", "h=8; domain=http://foo.bar.com", "i=9; domain=..foo.bar.com", "j=10; domain=..bar.com", "k=11; domain=.foo.bar.com?blah", "l=12; domain=.foo.bar.com/blah", "m=12; domain=.foo.bar.com:80", "n=14; domain=.foo.bar.com:", "o=15; domain=.foo.bar.com#sup"], "", [("http://foo.bar.com", "")])
  jar = new_test_jar()
  run_jar_test(jar, "InvalidDomainTest #2.", "http://foo.com.com", ["a=1; domain=.foo.com.com.com"], "", [("http://foo.bar.com", "")])
  jar = new_test_jar()
  run_jar_test(jar, "DomainWithoutLeadingDotTest #1.", "http://manage.hosted.filefront.com", ["a=1; domain=filefront.com"], "a=1", [("http://www.filefront.com", "a=1")])
  jar = new_test_jar()
  run_jar_test(jar, "DomainWithoutLeadingDotTest #2.", "http://www.google.com", ["a=1; domain=www.google.com"], "a=1", [("http://www.google.com", "a=1"), ("http://sub.www.google.com", "a=1"), ("http://something-else.com", "")])
  jar = new_test_jar()
  run_jar_test(jar, "CaseInsensitiveDomainTest.", "http://www.google.com", ["a=1; domain=.GOOGLE.COM", "b=2; domain=.www.gOOgLE.coM"], "a=1 b=2", [("http://www.google.com", "a=1 b=2")])
  jar = new_test_jar()
  run_jar_test(jar, "TestIpAddress #1.", "http://1.2.3.4/foo", ["a=1; path=/"], "a=1", [("http://1.2.3.4/foo", "a=1")])
  jar = new_test_jar()
  run_jar_test(jar, "TestIpAddress #2.", "http://1.2.3.4/foo", ["a=1; domain=.1.2.3.4", "b=2; domain=.3.4"], "", [("http://1.2.3.4/foo", "")])
  jar = new_test_jar()
  run_jar_test(jar, "TestIpAddress #3.", "http://1.2.3.4/foo", ["a=1; domain=1.2.3.3"], "", [("http://1.2.3.4/foo", "")])
  jar = new_test_jar()
  run_jar_test(jar, "TestIpAddress #4.", "http://1.2.3.4/foo", ["a=1; domain=1.2.3.4"], "a=1", [("http://1.2.3.4/foo", "a=1")])
  jar = new_test_jar()
  run_jar_test(jar, "TestNonDottedAndTLD #2.", "http://com./index.html", ["a=1"], "a=1", [("http://com./index.html", "a=1"), ("http://no-cookies.com./index.html", "")])
  jar = new_test_jar()
  run_jar_test(jar, "TestNonDottedAndTLD #3.", "http://a.b", ["a=1; domain=.b", "b=2; domain=b"], "", [("http://bar.foo", "")])
  jar = new_test_jar()
  run_jar_test(jar, "TestNonDottedAndTLD #4.", "http://google.com", ["a=1; domain=.com", "b=2; domain=com"], "", [("http://google.com", "")])
  jar = new_test_jar()
  run_jar_test(jar, "TestNonDottedAndTLD #5.", "http://google.co.uk", ["a=1; domain=.co.uk", "b=2; domain=.uk"], "", [("http://google.co.uk", ""), ("http://else.co.com", ""), ("http://else.uk", "")])
  jar = new_test_jar()
  run_jar_test(jar, "TestHostEndsWithDot.", "http://www.google.com", ["a=1", "b=2; domain=.www.google.com."], "a=1", [("http://www.google.com", "a=1")])
  jar = new_test_jar()
  run_jar_test(jar, "PathTest", "http://www.google.izzle", ["a=1; path=/wee"], "a=1", [("http://www.google.izzle/wee", "a=1"), ("http://www.google.izzle/wee/", "a=1"), ("http://www.google.izzle/wee/war", "a=1"), ("http://www.google.izzle/wee/war/more/more", "a=1"), ("http://www.google.izzle/weehee", ""), ("http://www.google.izzle/", "")])
}

test "chromium domain" {
  jar = new_test_jar()
  run_jar_test(jar, "Fill #1.", "http://www.google.izzle", ["A=B"], "A=B", [("http://www.google.izzle", "A=B")])
  run_jar_test(jar, "Fill #2.", "http://www.google.izzle", ["C=D; domain=.google.izzle"], "A=B C=D", [("http://www.google.izzle", "A=B C=D")])
  run_jar_test(jar, "Verify A is a host cookie and not accessible from subdomain.", "http://unused.nil", [], "A=B C=D", [("http://foo.www.google.izzle", "C=D")])
  run_jar_test(jar, "Verify domain cookies are found on proper domain.", "http://www.google.izzle", ["E=F; domain=.www.google.izzle"], "A=B C=D E=F", [("http://www.google.izzle", "A=B C=D E=F")])
  run_jar_test(jar, "Leading dots in domain attributes are optional.", "http://www.google.izzle", ["G=H; domain=www.google.izzle"], "A=B C=D E=F G=H", [("http://www.google.izzle", "A=B C=D E=F G=H")])
  run_jar_test(jar, "Verify domain enforcement works #1.", "http://www.google.izzle", ["K=L; domain=.bar.www.google.izzle"], "A=B C=D E=F G=H", [("http://bar.www.google.izzle", "C=D E=F G=H")])
  run_jar_test(jar, "Verify domain enforcement works #2.", "http://unused.nil", [], "A=B C=D E=F G=H", [("http://www.google.izzle", "A=B C=D E=F G=H")])
}

test "chromium deletion" {
  jar = new_test_jar()
  run_jar_test(jar, "Create session cookie a1.", "http://www.google.com", ["a=1"], "a=1", [("http://www.google.com", "a=1")])
  run_jar_test(jar, "Delete sc a1 via MaxAge.", "http://www.google.com", ["a=1; max-age=-1"], "", [("http://www.google.com", "")])
  run_jar_test(jar, "Create session cookie b2.", "http://www.google.com", ["b=2"], "b=2", [("http://www.google.com", "b=2")])
  run_jar_test(jar, "Delete sc b2 via Expires.", "http://www.google.com", ["b=2; expires=Tue, 01 Jan 2013 11:59:50 UTC"], "", [("http://www.google.com", "")])
  run_jar_test(jar, "Create persistent cookie c3.", "http://www.google.com", ["c=3; max-age=3600"], "c=3", [("http://www.google.com", "c=3")])
  run_jar_test(jar, "Delete pc c3 via MaxAge.", "http://www.google.com", ["c=3; max-age=-1"], "", [("http://www.google.com", "")])
  run_jar_test(jar, "Create persistent cookie d4.", "http://www.google.com", ["d=4; max-age=3600"], "d=4", [("http://www.google.com", "d=4")])
  run_jar_test(jar, "Delete pc d4 via Expires.", "http://www.google.com", ["d=4; expires=Tue, 01 Jan 2013 11:59:50 UTC"], "", [("http://www.google.com", "")])
}

test "domain handling" {
  jar = new_test_jar()
  run_jar_test(jar, "Host cookie", "http://www.host.test", ["a=1"], "a=1", [("http://www.host.test", "a=1"), ("http://host.test", ""), ("http://bar.host.test", ""), ("http://foo.www.host.test", ""), ("http://other.test", ""), ("http://test", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Domain cookie #1", "http://www.host.test", ["a=1; domain=host.test"], "a=1", [("http://www.host.test", "a=1"), ("http://host.test", "a=1"), ("http://bar.host.test", "a=1"), ("http://foo.www.host.test", "a=1"), ("http://other.test", ""), ("http://test", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Domain cookie #2", "http://www.host.test", ["a=1; domain=.host.test"], "a=1", [("http://www.host.test", "a=1"), ("http://host.test", "a=1"), ("http://bar.host.test", "a=1"), ("http://foo.www.host.test", "a=1"), ("http://other.test", ""), ("http://test", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Host cookie on IDNA domain #1", "http://www.bücher.test", ["a=1"], "a=1", [("http://www.bücher.test", "a=1"), ("http://www.xn--bcher-kva.test", "a=1"), ("http://bücher.test", ""), ("http://xn--bcher-kva.test", ""), ("http://bar.bücher.test", ""), ("http://bar.xn--bcher-kva.test", ""), ("http://foo.www.bücher.test", ""), ("http://foo.www.xn--bcher-kva.test", ""), ("http://other.test", ""), ("http://test", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Host cookie on IDNA domain #2", "http://www.xn--bcher-kva.test", ["a=1"], "a=1", [("http://www.bücher.test", "a=1"), ("http://www.xn--bcher-kva.test", "a=1"), ("http://bücher.test", ""), ("http://xn--bcher-kva.test", ""), ("http://bar.bücher.test", ""), ("http://bar.xn--bcher-kva.test", ""), ("http://foo.www.bücher.test", ""), ("http://foo.www.xn--bcher-kva.test", ""), ("http://other.test", ""), ("http://test", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Domain cookie on IDNA domain #1", "http://www.bücher.test", ["a=1; domain=xn--bcher-kva.test"], "a=1", [("http://www.bücher.test", "a=1"), ("http://www.xn--bcher-kva.test", "a=1"), ("http://bücher.test", "a=1"), ("http://xn--bcher-kva.test", "a=1"), ("http://bar.bücher.test", "a=1"), ("http://bar.xn--bcher-kva.test", "a=1"), ("http://foo.www.bücher.test", "a=1"), ("http://foo.www.xn--bcher-kva.test", "a=1"), ("http://other.test", ""), ("http://test", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Domain cookie on IDNA domain #2", "http://www.xn--bcher-kva.test", ["a=1; domain=xn--bcher-kva.test"], "a=1", [("http://www.bücher.test", "a=1"), ("http://www.xn--bcher-kva.test", "a=1"), ("http://bücher.test", "a=1"), ("http://xn--bcher-kva.test", "a=1"), ("http://bar.bücher.test", "a=1"), ("http://bar.xn--bcher-kva.test", "a=1"), ("http://foo.www.bücher.test", "a=1"), ("http://foo.www.xn--bcher-kva.test", "a=1"), ("http://other.test", ""), ("http://test", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Host cookie on TLD.", "http://com", ["a=1"], "a=1", [("http://com", "a=1"), ("http://any.com", ""), ("http://any.test", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Domain cookie on TLD becomes a host cookie.", "http://com", ["a=1; domain=com"], "a=1", [("http://com", "a=1"), ("http://any.com", ""), ("http://any.test", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Host cookie on public suffix.", "http://co.uk", ["a=1"], "a=1", [("http://co.uk", "a=1"), ("http://uk", ""), ("http://some.co.uk", ""), ("http://foo.some.co.uk", ""), ("http://any.uk", "")])
  jar = new_test_jar()
  run_jar_test(jar, "Domain cookie on public suffix is ignored.", "http://some.co.uk", ["a=1; domain=co.uk"], "", [("http://co.uk", ""), ("http://uk", ""), ("http://some.co.uk", ""), ("http://foo.some.co.uk", ""), ("http://any.uk", "")])
}

test "punycode" {
  assert_eq encode("", "").unwrap, ""
  assert_eq encode("", "-").unwrap, "--"
  assert_eq encode("", "-a").unwrap, "-a-"
  assert_eq encode("", "-a-").unwrap, "-a--"
  assert_eq encode("", "a").unwrap, "a-"
  assert_eq encode("", "a-").unwrap, "a--"
  assert_eq encode("", "a-b").unwrap, "a-b-"
  assert_eq encode("", "books").unwrap, "books-"
  assert_eq encode("", "bücher").unwrap, "bcher-kva"
  assert_eq encode("", "Hello世界").unwrap, "Hello-ck1hg65u"
  assert_eq encode("", "ü").unwrap, "tda"
  assert_eq encode("", "üý").unwrap, "tdac"
  assert_eq encode("", "ليهمابتكلموشعربي؟").unwrap, "egbpdaj6bu4bxfgehfvwxn"
  assert_eq encode("", "他们为什么不说中文").unwrap, "ihqwcrb4cv8a8dqg056pqjye"
  assert_eq encode("", "他們爲什麽不說中文").unwrap, "ihqwctvzc91f659drss3x8bo0yb"
  assert_eq encode("", "Pročprostěnemluvíčesky").unwrap, "Proprostnemluvesky-uyb24dma41a"
  assert_eq encode("", "למההםפשוטלאמדבריםעברית").unwrap, "4dbcagdahymbxekheh6e0a7fei0b"
  assert_eq encode("", "यहलोगहिन्दीक्योंनहींबोलसकतेहैं").unwrap, "i1baa7eci9glrd9b2ae1bj0hfcgg6iyaf8o0a1dig0cd"
  assert_eq encode("", "なぜみんな日本語を話してくれないのか").unwrap, "n8jok5ay5dzabd5bym9f0cm5685rrjetr6pdxa"
  assert_eq encode("", "세계의모든사람들이한국어를이해한다면얼마나좋을까").unwrap, "989aomsvi5e83db1d2a355cv1e0vak1dwrv93d5xbh15a0dt30a5jpsd879ccm6fea98c"
  assert_eq encode("", "почемужеонинеговорятпорусски").unwrap, "b1abfaaepdrnnbgefbadotcwatmq2g4l"
  assert_eq encode("", "PorquénopuedensimplementehablarenEspañol").unwrap, "PorqunopuedensimplementehablarenEspaol-fmd56a"
  assert_eq encode("", "TạisaohọkhôngthểchỉnóitiếngViệt").unwrap, "TisaohkhngthchnitingVit-kjcr8268qyxafd2f1b9g"
  assert_eq encode("", "3年B組金八先生").unwrap, "3B-ww4c5e180e575a65lsy2b"
  assert_eq encode("", "安室奈美恵-with-SUPER-MONKEYS").unwrap, "-with-SUPER-MONKEYS-pc58ag80a8qai00g7n9n"
  assert_eq encode("", "Hello-Another-Way-それぞれの場所").unwrap, "Hello-Another-Way--fc4qua05auwb3674vfr0b"
  assert_eq encode("", "ひとつ屋根の下2").unwrap, "2-u9tlzr9756bt3uc0v"
  assert_eq encode("", "MajiでKoiする5秒前").unwrap, "MajiKoi5-783gue6qz075azm5e"
  assert_eq encode("", "パフィーdeルンバ").unwrap, "de-jg4avhby1noc0d"
  assert_eq encode("", "そのスピードで").unwrap, "d9juau41awczczp"
  assert_eq encode("", "-> $1.00 <-").unwrap, "-> $1.00 <--"
}

test "vectors: jar sessions 0" {
  jar = new_jar(Options.new)
  run_jar_test(jar, "session 0 step 0", "https://x.localhost/a/b/c.html", ["a=4; domain=co.uk; max-age=2", "b=9; domain=.host.test; path=/; expires=Tue, 01 Jan 2013 11:59:50 UTC"], "", [("http://www.bücher.test:8080/b", "")])
  run_jar_test(jar, "session 0 step 1", "http://www.buggy.psl:8080/a", ["b=0; domain=.host.test; path=/"], "", [("ftp://www.buggy.psl:8080/b", ""), ("http://192.168.0.1/a/", ""), ("http://host.test:8080/a/", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 1 step 0", "ftp://a.b.host.test/a/b/c.html", ["a=9; domain=.host.test; expires=Tue, 01 Jan 2013 12:16:40 UTC", "A=9; domain=test; expires=Tue, 01 Jan 2013 12:16:40 UTC; path=a"], "", [("http://bbc.co.uk/a", ""), ("http://x.localhost:8080/b", "")])
  jar = new_jar(Options.new)
  run_jar_test(jar, "session 2 step 0", "https://a.b.host.test/", ["a=5; domain=www.host.test; expires=Tue, 01 Jan 2013 12:00:03 UTC"], "", [("ftp://www.bbc.co.uk:8080", ""), ("ftp://www.bücher.test:8080/a/b", ""), ("http://WWW.Host.Test:8080", ""), ("http://www.bbc.co.uk/a/b", "")])
  run_jar_test(jar, "session 2 step 1", "ftp://a.b.host.test:8080/", ["A=1; domain=other.test"], "", [("ftp://[::1]:8080/b", "")])
  jar = new_jar(Options.new)
  run_jar_test(jar, "session 3 step 0", "http://www2.buggy.psl:8080/b", ["A=5; domain=host.test; secure", "a=4; domain=."], "", [("http://host.test:8080/a", ""), ("http://www.buggy.psl/a/", "")])
  run_jar_test(jar, "session 3 step 1", "ftp://a.b.host.test/a/", ["A=1; domain=bbc.co.uk", "a=3; domain=www.host.test"], "", [("ftp://co.uk:8080/a/b", ""), ("https://192.168.0.1/a", "")])
  run_jar_test(jar, "session 3 step 2", "http://host.test/", ["sid=1; domain=other.test; expires=Tue, 01 Jan 2013 12:00:03 UTC", "sid=5; domain=.", "b=7", "b=2; path=a"], "b=2", [("http://bbc.co.uk/b", ""), ("http://x.localhost/a/b/c.html", ""), ("http://co.uk:8080/a/b/c.html", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 4 step 0", "http://bbc.co.uk:8080/a/b/c.html", ["sid=5; domain=buggy.psl; expires=Tue, 01 Jan 2013 12:16:40 UTC", "b=6; domain=xn--bcher-kva.test; path=/a", "sid=2; domain=buggy.psl", "sid=0; domain=.host.test"], "", [("https://www2.buggy.psl:8080/a/b", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 5 step 0", "ftp://a.b.host.test:8080/", ["b=2; domain=192.168.0.1", "b=7; domain=192.168.0.1; secure", "a=0; domain=co.uk", "b=2; domain=test"], "", [("http://co.uk:8080/a", ""), ("http://www.buggy.psl:8080/a/b", ""), ("https://co.uk:8080/a", ""), ("http://www2.buggy.psl/a/b/c.html", "")])
  jar = new_jar(Options.new)
  run_jar_test(jar, "session 6 step 0", "http://WWW.Host.Test/a/b", ["A=2; domain=HOST.TEST; httponly"], "A=2", [("ftp://a.b.host.test:8080/", ""), ("https://www.buggy.psl:8080/b", ""), ("ftp://www2.buggy.psl", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 7 step 0", "http://a.b.host.test/a/", ["A=7; domain=HOST.TEST; max-age=-1", "A=2; domain=host.test", "a=1; domain=host.test; expires=Tue, 01 Jan 2013 11:59:50 UTC; path=/"], "A=2", [("http://bbc.co.uk/a/b", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 8 step 0", "http://a.b.host.test:8080/", ["a=3; domain=host.test; max-age=2", "A=0; domain=buggy.psl"], "a=3", [("ftp://www.buggy.psl/a", ""), ("ftp://192.168.0.1/a/", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 9 step 0", "http://localhost/a/", ["b=0; domain=xn--bcher-kva.test", "A=3; domain=bbc.co.uk; expires=Tue, 01 Jan 2013 11:59:50 UTC; path=/a"], "", [("http://a.b.host.test:8080/", "")])
  run_jar_test(jar, "session 9 step 1", "http://192.168.0.1/b", ["b=1; domain=xn--bcher-kva.test; max-age=100; expires=Tue, 01 Jan 2013 12:16:40 UTC", "b=0; domain=test; path=/"], "", [("https://www.bbc.co.uk:8080/a/", "")])
  jar = new_test_jar()
  run_jar_test(jar, "session 10 step 0", "https://www.host.test", ["sid=3; domain=host.test; path=/a; httponly"], "sid=3", [("https://www.bbc.co.uk/", ""), ("ftp://a.b.host.test:8080/a/b", ""), ("http://www.buggy.psl/a/b", "")])
  run_jar_test(jar, "session 10 step 1", "https://localhost", ["A=2; domain=bbc.co.uk; expires=Tue, 01 Jan 2013 12:00:03 UTC", "b=2; domain=other.test; path=/a/b", "a=8; domain=other.test; expires=Tue, 01 Jan 2013 12:16:40 UTC; expires=Tue, 01 Jan 2013 11:59:50 UTC"], "sid=3", [("http://host.test/a/b/c.html", "sid=3")])
  jar = new_test_jar()
  run_jar_test(jar, "session 11 step 0", "http://x.localhost/a", ["sid=1; domain=HOST.TEST"], "", [("https://192.168.0.1", "")])
