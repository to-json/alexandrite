  jar = new_jar(Options.new)
  run_jar_test(jar, "session 307 step 0", "https://www.buggy.psl/a", ["A=3; domain=HOST.TEST; max-age=-1; path=/", "sid=9; domain=xn--bcher-kva.test; max-age=2; expires=Tue, 01 Jan 2013 11:59:50 UTC", "b=2; domain=.host.test"], "", [("http://192.168.0.1:8080/b", ""), ("ftp://x.localhost/a/b", ""), ("https://WWW.Host.Test/b", "")])
