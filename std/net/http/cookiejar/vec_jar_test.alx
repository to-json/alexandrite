  assert_eq has_dot_suffix?("foo.com", "com"), true
  assert_eq has_dot_suffix?("foo.com", ".com"), false
  assert_eq has_dot_suffix?("foo.com", "o.com"), false
  assert_eq has_dot_suffix?("foo.com", "oo.com"), false
