test "has dot suffix" {
  assert_eq has_dot_suffix?("", ""), false
  assert_eq has_dot_suffix?("", "."), false
  assert_eq has_dot_suffix?("", "x"), false
  assert_eq has_dot_suffix?(".", ""), true
  assert_eq has_dot_suffix?(".", "."), false
  assert_eq has_dot_suffix?(".", ".."), false
