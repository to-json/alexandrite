  assert_eq has_dot_suffix?("foo.com", ".foo.com"), false
  assert_eq has_dot_suffix?("foo.com", "x.foo.com"), false
  assert_eq has_dot_suffix?("foo.com", "xfoo.com"), false
  assert_eq has_dot_suffix?("foo.com", "xfoo.org"), false
  assert_eq has_dot_suffix?("foo.com", "foo.org"), false
  assert_eq has_dot_suffix?("foo.com", "oo.org"), false
