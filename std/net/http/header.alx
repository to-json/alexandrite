import "strings"

# A case-insensitive multi-map of header fields. Keys are stored canonically
# ("content-type" -> "Content-Type"); every method canonicalizes its key.
# Copies share the same fields (the map is shared storage), like Go's
# `http.Header` map; the mutating methods need a variable or field receiver.
pub struct Header {
  m: Map[Str, [Str]]

  # The first value of `key`, "" if there is none.
  pub def get(key: Str) -> Str {
    vs = m[canonical_key(key)]
    if v = vs {
      return v[0] if v.size > 0
    }
    ""
  }

  # Every value of `key` (empty when absent).
  pub def values(key: Str) -> [Str] {
    vs = m[canonical_key(key)]
    if v = vs {
      return v.dup
    }
    out: [Str] = []
    out
  }

  pub def has?(key: Str) -> Bool {
    m.key?(canonical_key(key))
  }

  # Replaces every value of `key` with `value`.
  pub def set!(key: Str, value: Str) {
    self.m[canonical_key(key)] = [value]
  }

  # Appends a value for `key`.
  pub def add!(key: Str, value: Str) {
    k = canonical_key(key)
    old = m[k]
    if o = old {
      ys = o.dup
      ys << value
      self.m[k] = ys
    } else {
      self.m[k] = [value]
    }
  }

  # Removes `key`.
  pub def del!(key: Str) {
    self.m.delete(canonical_key(key))
  }

  # Number of distinct keys.
  pub def size -> Int { m.size }

  # The keys, in insertion order.
  pub def keys -> [Str] {
    out: [Str] = []
    for k, _ in m { out << k }
    out
  }

  # A copy that doesn't share storage.
  pub def clone -> Header {
    out = Header.new
    for k, v in m { out.m[k] = v.dup }
    out
  }
}

pub def new_header -> Header {
  Header.new
}

# "content-type" -> "Content-Type". A key with a byte that isn't a token
# character is returned unchanged (as in Go).
pub def canonical_key(k: Str) -> Str {
  b = k.bytes.to_a
  upper = true
  changed = false
  i = 0
  while i < b.size {
    c = b[i]
    if upper && c >= 97 && c <= 122 {
      b[i] = c - 32
      changed = true
    } else if !upper && c >= 65 && c <= 90 {
      b[i] = c + 32
      changed = true
    }
    upper = c == 45
    i += 1
  }
  return k unless changed
  Str.from_bytes(b)
}

# ASCII lower case.
pub def lower(s: Str) -> Str {
  strings.to_lower(s)
}
