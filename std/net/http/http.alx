# Package net/http: an HTTP/1.1 server and client over `net` (L3).
#
#   import "net"
#   import "net/http"
#
#   mux = http.new_serve_mux
#   mux.handle_func("GET /hello/{name}") { |w, r|
#     w.write_string!("hello, #{r.path_value("name")}\n")
#   }
#   http.listen_and_serve(":8080", mux).unwrap
#
#   r = http.get("http://127.0.0.1:8080/hello/alx").unwrap
#   puts r.status, r.body_string
#
# Server: `ServeMux` (Go 1.22 patterns), `Server` (one task per connection,
# keep-alive, `shutdown`), `ResponseWriter`, `Request`, `error`, `redirect`,
# `not_found`. Client: `get`, `post`, `head`, `Client.do`. `Header` is a
# case-insensitive multi-map.
#
# Shape notes (see the types for details):
#  - Handlers are `(ResponseWriter, Request) -> Unit`. A named handler whose
#    last expression has a value (`w.write_string!(...)` is a `~Int`) needs
#    `-> Unit`; blocks and lambdas ending in a write are fine as blocks.
#  - Handlers are copied into each request's task: state shared between
#    requests belongs in an Atomic or a channel (a Mutex captured by a
#    handler lambda is currently copied with it; see the audit notes).
#  - Responses are buffered and length-framed unless they grow past
#    FLUSH_THRESHOLD or call `flush!` (then chunked); requests are read in full
#    before the handler runs.
#  - Wire parsing follows Go: `read_request` / `read_response` are Go's
#    ReadRequest / ReadResponse (readmsg.alx) with Go's error texts and its
#    Content-Length / Transfer-Encoding / trailer rules; the server makes Go's
#    request checks (Host, header names and values, protocol version) and
#    answers errors as Go does (400 / 431 / 501 / 505, Expect, OPTIONS *).
#    ServeMux redirects as Go 1.22+ (307; clean, then trailing slash).
#  - Differences from Go besides the gaps: bodies are read whole, so a
#    declared body that never arrives is an error of read_request (Go's is
#    lazy); an HTTP/1.0 keep-alive response doesn't carry "Connection:
#    keep-alive"; Date and Server headers aren't sent; the server's mux also
#    serves `new_server_func` handlers (so path cleaning applies to them).
#
# Known gaps: no TLS, HTTP/2, timeouts, hijacking, request-body streaming, host
# patterns, client keep-alive/pooling, cookies. A ServeMux can't be mounted
# inside another one (the compiler overflows its stack on the closure cycle).

# The default maximum size of a header block the server accepts is
# MAX_HEADER_BYTES, bodies MAX_BODY_BYTES (message.alx).
