test "header canonicalization and multi-values" {
  h = new_header
  h.set!("content-type", "text/plain")
  h.add!("x-multi", "a")
  h.add!("X-MULTI", "b")
  assert_eq h.get("Content-TYPE"), "text/plain"
  assert_eq h.values("x-multi").join(","), "a,b"
  assert_eq h.get("missing"), ""
  assert h.has?("x-multi")
  h.del!("X-Multi")
  assert !h.has?("x-multi")
  assert_eq canonical_key("accept-encoding"), "Accept-Encoding"
}

test "url escapes and queries" {
  assert_eq unescape("a%20b+c", false).unwrap, "a b+c"
  assert_eq unescape("a%20b+c", true).unwrap, "a b c"
  assert unescape("%zz", false).err?
  assert unescape("100%", false).err?
  assert_eq query_escape("a b&c=d/é"), "a+b%26c%3Dd%2F%C3%A9"
  assert_eq query_value("a=1&b=x%20y&c", "b").unwrap, "x y"
  assert query_value("a=1&b=2", "z").none?
  u = parse_url("http://example.com:8080/a/b?x=1").unwrap
  assert_eq u.host, "example.com"
  assert_eq u.port, 8080
  assert_eq u.path, "/a/b"
  assert_eq u.raw_query, "x=1"
  assert_eq u.request_uri, "/a/b?x=1"
  u = parse_url("http://h?q=1").unwrap
  assert_eq u.request_uri, "/?q=1"
  assert_eq u.port, 80
  assert parse_url("ftp://h/").err?
}
