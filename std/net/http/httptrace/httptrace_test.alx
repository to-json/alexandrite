# Go's net/http/httptrace trace_test.go, translated.
import "errors"
import "net/textproto"
import "strings"

def connect_start(buf: strings.Builder, b: Str) -> (Str, Str) -> Unit {
  out = buf
  f = ->(network: Str, addr: Str) {
    assert_eq addr, "addr"
    out.write_string!(b)
    return
  }
  f
}

test "with client trace" {
  buf = strings.new_builder
  oldtrace = ClientTrace.new(connect_start: connect_start(buf, "O"))
  t1 = with_client_trace(none, oldtrace)
  newtrace = ClientTrace.new(connect_start: connect_start(buf, "N"))
  trace = with_client_trace(t1, newtrace)
  if f = trace.connect_start {
    f("net", "addr")
  }
  assert_eq buf.to_s, "NO"
}

test "compose" {
  # (want, the trace has a hook, there is an old trace)
  cases = [("T", true, false), ("TO", true, true), ("O", false, true)]
  for c in cases {
    buf = strings.new_builder
    tr = ClientTrace.new
    tr.connect_start = connect_start(buf, "T") if c[1]
    if c[2] {
      tr = tr.compose(ClientTrace.new(connect_start: connect_start(buf, "O")))
    }
    if f = tr.connect_start {
      f("net", "addr")
    }
    assert_eq buf.to_s, c[0]
  }
}

# (not in Go's tests) Every hook is composed, a composed hook composes
# again, and an unset hook stays unset.
test "compose keeps every hook" {
  log = strings.new_builder
  l = log
  a = ClientTrace.new(wrote_headers: ->() {
    l.write_string!("a,")
    return
    }, got_first_response_byte: ->() {
      l.write_string!("a1,")
      return
  })
  b = ClientTrace.new(wrote_headers: ->() {
    l.write_string!("b,")
    return
    }, get_conn: ->(hp: Str) {
      l.write_string!("b:" + hp + ",")
      return
  })
  c = ClientTrace.new(wrote_headers: ->() {
    l.write_string!("c,")
    return
  })
  t = c.compose(a.compose(b))
  t.fire_wrote_headers
  t.fire_got_first_response_byte
  t.fire_get_conn("h:1")
  t.fire_dns_start(DNSStartInfo.new(host: "x"))
  assert_eq log.to_s, "c,a,b,a1,b:h:1,"
  assert !t.dns_start.present?
  assert !t.has_net_hooks?
  assert ClientTrace.new(dns_done: ->(i: DNSDoneInfo) {}).has_net_hooks?
}

# Go's compose2to1: the new hook's error is dropped, the old one's returned.
test "compose got_1xx_response" {
  log = strings.new_builder
  l = log
  t = ClientTrace.new(got_1xx_response: ->(code: Int, h: textproto.MIMEHeader) -> ~Unit {
    l.write_string!("new #{code},")
    fail errors.new("new")
  })
  old = ClientTrace.new(got_1xx_response: ->(code: Int, h: textproto.MIMEHeader) -> ~Unit {
    l.write_string!("old #{code},")
    nil
  })
  r = t.compose(old).fire_got_1xx_response(103, textproto.MIMEHeader.new)
  assert r.ok?
  r2 = old.compose(t).fire_got_1xx_response(100, textproto.MIMEHeader.new)
  assert_eq r2.err.unwrap.message, "new"
  assert_eq log.to_s, "new 103,old 103,old 100,new 100,"
}
