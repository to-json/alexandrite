# Go's net/http/httptrace trace_test.go, translated.
import "strings"

def connect_start(buf: strings.Builder, b: Str) -> (Str, Str) -> Unit {
  out = buf
  f = ->(network: Str, addr: Str) {
    assert_eq addr, "addr"
    out.write!(b)
    return
  }
  f
}

test "with client trace" {
  buf = strings.new_builder
  oldtrace = ClientTrace.new(connect_start: [connect_start(buf, "O")])
  t1 = with_client_trace(none, oldtrace)
  newtrace = ClientTrace.new(connect_start: [connect_start(buf, "N")])
  trace = with_client_trace(t1, newtrace)
  trace.fire_connect_start("net", "addr")
  assert_eq buf.to_s, "NO"
}

test "compose" {
  # (want, the trace has a hook, there is an old trace)
  cases = [("T", true, false), ("TO", true, true), ("O", false, true)]
  for c in cases {
    buf = strings.new_builder
    tr = ClientTrace.new
    tr.connect_start = [connect_start(buf, "T")] if c[1]
    if c[2] {
      tr = tr.compose(ClientTrace.new(connect_start: [connect_start(buf, "O")]))
    }
    tr.fire_connect_start("net", "addr")
    assert_eq buf.to_s, c[0]
  }
}

test "compose keeps every hook" {
  log = strings.new_builder
  l = log
  a = ClientTrace.new(wrote_headers: [->() {
    l.write!("a,")
    return
    }], got_first_response_byte: [->() {
      l.write!("a1,")
      return
  }])
  b = ClientTrace.new(wrote_headers: [->() {
    l.write!("b,")
    return
    }], get_conn: [->(hp: Str) {
      l.write!("b:" + hp)
      return
  }])
  t = a.compose(b)
  t.fire_wrote_headers
  t.fire_got_first_response_byte
  t.fire_get_conn("h:1")
  assert_eq log.to_s, "a,b,a1,b:h:1"
  assert !t.has_net_hooks?
  assert ClientTrace.new(dns_done: [->(i: DNSDoneInfo) {}]).has_net_hooks?
}
