  assert_eq dresp(7, "200 OK", "HTTP/1.1", [("Content-Type", "chunked")], "", 10, ["chunked"], false, "POST", false), "HTTP/1.1 007 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Type: chunked\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.0", [("Trailer", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], true, "GET", true), "HTTP/1.0 304 Custom Text\r\nConnection: close\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [], "", 0, [], true, "HEAD", false), "HTTP/1.1 304 200 OK\r\nConnection: close\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.0", [("Host", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "GET", true), "HTTP/1.0 007 status code 7\r\nHost: a\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
