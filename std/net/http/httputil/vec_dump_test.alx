  assert_eq dresp(200, "200 OK", "HTTP/1.0", [("x-lower", "chunked")], "hello world", 35, ["chunked"], true, "POST", false), "HTTP/1.0 200 OK\r\nConnection: close\r\nContent-Length: 35\r\nX-Lower: chunked\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [("x-lower", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "POST", false), "HTTP/1.1 500 Custom Text\r\nContent-Length: 40\r\nX-Lower: a\r\n\r\n"
