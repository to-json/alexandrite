  assert_eq dreq("POST", "https://secure.example/x", "HTTP/1.0", [("Content-Length", ""), ("Trailer", "two\nlines")], "abc", 3, ["chunked"], "", "", true), "POST /x HTTP/1.0\r\nHost: secure.example\r\nTransfer-Encoding: chunked\r\nContent-Length: \r\n\r\n3\r\nabc\r\n0\r\n\r\n"
