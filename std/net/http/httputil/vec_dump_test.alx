  assert_eq dreq("HEAD", "/", "HTTP/1.1", [("Content-Type", "two\nlines"), ("x-lower", "two\nlines")], "abc", 0, [], "example.com", "/", true), "HEAD / HTTP/1.1\r\nHost: example.com\r\nContent-Type: two lines\r\nX-Lower: two lines\r\n\r\nabc"
  assert_eq dreq("", "https://secure.example/x", "HTTP/1.0", [("Host", "")], "abc", 0, [], "other.host:81", "https://secure.example/x", true), "GET https://secure.example/x HTTP/1.0\r\n\r\nabc"
  assert_eq dreq("GET", "https://secure.example/x", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], "other.host:81", "", false), "GET /x HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("HEAD", "http://h:8080/p%20q", "HTTP/1.0", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], "", "http://h:8080/p%20q", false), "HEAD http://h:8080/p%20q HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/", "HTTP/1.0", [("Content-Type", "close"), ("Accept", "")], "", 0, [], "", "", true), "HEAD / HTTP/1.0\r\nHost: example.com\r\nAccept: \r\nContent-Type: close\r\n\r\n"
  assert_eq dreq("PUT", "http://h:8080/p%20q", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], "other.host:81", "", true), "PUT /p%20q HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\n28\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\r\n0\r\n\r\n"
  assert_eq dreq("PUT", "http://example.com/", "HTTP/1.1", [], "abc", 3, [], "", "", true), "PUT / HTTP/1.1\r\nHost: example.com\r\n\r\nabc"
  assert_eq dreq("HEAD", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [], "", 0, [], "", "", false), "HEAD /a/b?x=1&y=2 HTTP/1.1\r\nHost: example.com\r\n\r\n"
  assert_eq dreq("DELETE", "*", "HTTP/1.0", [("Transfer-Encoding", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], "example.com", "", true), "DELETE * HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\n\r\n28\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\r\n0\r\n\r\n"
  assert_eq dreq("POST", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [], "", -1, [], "other.host:81", "", false), "POST /a/b?x=1&y=2 HTTP/1.1\r\nHost: other.host:81\r\n\r\n"
  assert_eq dreq("POST", "/foo?bar", "HTTP/1.1", [], "", -1, [], "example.com", "/foo?bar", false), "POST /foo?bar HTTP/1.1\r\nHost: example.com\r\n\r\n"
}

test "vectors: dump response 0" {
  assert_eq dresp(304, "200 OK", "HTTP/1.0", [("Trailer", "chunked"), ("Content-Length", "two\nlines")], "hello world", 11, ["chunked"], true, "POST", false), "HTTP/1.0 304 200 OK\r\nConnection: close\r\nContent-Length: 11\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.1", [("Content-Length", " spaced "), ("x-lower", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "HEAD", true), "HTTP/1.1 101 200 OK\r\nConnection: close\r\nX-Lower: spaced\r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.1", [], "", -1, [], true, "HEAD", true), "HTTP/1.1 204 200 OK\r\nConnection: close\r\n\r\n"
  assert_eq dresp(200, "", "HTTP/1.1", [("Transfer-Encoding", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], false, "GET", false), "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.0", [("Content-Type", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], true, "POST", false), "HTTP/1.0 007 Custom Text\r\nConnection: close\r\nContent-Length: 0\r\nContent-Type: 10\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.0", [("Content-Type", "a")], "", -1, [], false, "HEAD", false), "HTTP/1.0 500 Internal Server Error\r\nContent-Type: a\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.0", [("X-Foo", "chunked"), ("Connection", "chunked"), ("Content-Type", " spaced ")], "abc", 3, ["chunked"], true, "HEAD", false), "HTTP/1.0 304 Custom Text\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nConnection: chunked\r\nContent-Type: spaced\r\nX-Foo: chunked\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.1", [("Connection", "text/html"), ("x-lower", "10")], "", -1, [], true, "HEAD", true), "HTTP/1.1 200 Custom Text\r\nConnection: close\r\nConnection: text/html\r\nX-Lower: 10\r\n\r\n"
  assert_eq dresp(101, "", "HTTP/1.1", [("Content-Length", "text/html"), ("Accept", "")], "abc", 28, [], true, "HEAD", true), "HTTP/1.1 101 Switching Protocols\r\nConnection: close\r\nContent-Length: 28\r\nAccept: \r\n\r\n"
  assert_eq dresp(304, "", "HTTP/1.0", [("Trailer", "chunked"), ("Content-Length", "10")], "abc", -1, [], false, "POST", false), "HTTP/1.0 304 Not Modified\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.0", [("Bad Key", "a")], "hello world", 0, [], false, "POST", false), "HTTP/1.0 200 OK\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], true, "GET", false), "HTTP/1.1 200 Custom Text\r\nConnection: close\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"
  assert_eq dresp(404, "200 OK", "HTTP/1.1", [("User-Agent", "10"), ("Content-Type", "text/html"), ("Bad Key", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], true, "GET", false), "HTTP/1.1 404 200 OK\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nContent-Type: text/html\r\nUser-Agent: 10\r\n\r\n0\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.1", [], "abc", 0, [], false, "HEAD", false), "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.1", [("x-lower", " spaced "), ("Content-Type", "text/html")], "abc", 33, [], false, "HEAD", false), "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 33\r\nContent-Type: text/html\r\nX-Lower: spaced\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.1", [("User-Agent", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 43, [], true, "POST", false), "HTTP/1.1 304 Custom Text\r\nConnection: close\r\nContent-Length: 43\r\nUser-Agent: \r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [("x-lower", "")], "hello world", 11, [], true, "GET", false), "HTTP/1.0 500 200 OK\r\nConnection: close\r\nContent-Length: 11\r\nX-Lower: \r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.0", [], "abc", 3, [], false, "HEAD", true), "HTTP/1.0 304 200 OK\r\nContent-Length: 3\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.0", [("Transfer-Encoding", "10"), ("X-Foo", "close")], "abc", -1, [], false, "POST", false), "HTTP/1.0 007 Custom Text\r\nX-Foo: close\r\n\r\n"
  assert_eq dresp(101, "Custom Text", "HTTP/1.0", [("Host", "two\nlines"), ("Trailer", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "HEAD", true), "HTTP/1.0 101 Custom Text\r\nContent-Length: 40\r\nHost: two lines\r\n\r\n"
  assert_eq dresp(204, "Custom Text", "HTTP/1.1", [("X-Foo", " spaced ")], "abc", -1, [], true, "POST", true), "HTTP/1.1 204 Custom Text\r\nConnection: close\r\nX-Foo: spaced\r\n\r\nabc"
  assert_eq dresp(404, "200 OK", "HTTP/1.1", [("X-Foo", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "GET", true), "HTTP/1.1 404 200 OK\r\nConnection: close\r\nX-Foo: two lines\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Accept", "chunked"), ("Content-Length", "close"), ("User-Agent", "two\nlines")], "abc", 3, [], false, "GET", true), "HTTP/1.1 304 200 OK\r\nContent-Length: 3\r\nAccept: chunked\r\nUser-Agent: two lines\r\n\r\nabc"
  assert_eq dresp(204, "Custom Text", "HTTP/1.1", [("Connection", ""), ("X-Foo", "a")], "hello world", -1, ["chunked"], true, "HEAD", true), "HTTP/1.1 204 Custom Text\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nConnection: \r\nX-Foo: a\r\n\r\n"
  assert_eq dresp(304, "", "HTTP/1.1", [("Content-Length", "two\nlines"), ("Content-Length", "text/html")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], false, "POST", false), "HTTP/1.1 304 Not Modified\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.1", [("Content-Length", "text/html"), ("Bad Key", "close"), ("Trailer", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 1, [], false, "POST", false), "HTTP/1.1 200 OK\r\nContent-Length: 1\r\n\r\n"
  assert_eq dresp(404, "200 OK", "HTTP/1.1", [("User-Agent", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "POST", true), "HTTP/1.1 404 200 OK\r\nContent-Length: 40\r\nUser-Agent: chunked\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(7, "", "HTTP/1.1", [("Trailer", "two\nlines"), ("Content-Type", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 37, ["chunked"], false, "GET", false), "HTTP/1.1 007 status code 7\r\nTransfer-Encoding: chunked\r\nContent-Type: a\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.0", [("Connection", ""), ("Host", "close"), ("User-Agent", " spaced ")], "abc", 6, [], false, "POST", true), "ERR http: ContentLength=6 with Body length 3"
  assert_eq dresp(101, "", "HTTP/1.0", [("Host", "two\nlines"), ("Trailer", "")], "", 0, [], true, "GET", false), "HTTP/1.0 101 Switching Protocols\r\nConnection: close\r\nHost: two lines\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.0", [("User-Agent", "two\nlines"), ("Transfer-Encoding", "10"), ("Connection", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], true, "POST", true), "HTTP/1.0 007 Custom Text\r\nConnection: close\r\nConnection: 10\r\nUser-Agent: two lines\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(101, "Custom Text", "HTTP/1.1", [("User-Agent", "text/html"), ("Content-Type", "10"), ("Host", "a")], "", 0, [], false, "POST", true), "HTTP/1.1 101 Custom Text\r\nContent-Length: 0\r\nContent-Type: 10\r\nHost: a\r\nUser-Agent: text/html\r\n\r\n"
  assert_eq dresp(101, "", "HTTP/1.0", [("User-Agent", "chunked"), ("Connection", "10"), ("Content-Type", "10")], "hello world", 0, ["chunked"], false, "GET", true), "HTTP/1.0 101 Switching Protocols\r\nConnection: 10\r\nContent-Type: 10\r\nUser-Agent: chunked\r\n\r\nhello world"
  assert_eq dresp(404, "Custom Text", "HTTP/1.0", [], "", -1, [], false, "HEAD", false), "HTTP/1.0 404 Custom Text\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.0", [("x-lower", ""), ("Content-Length", ""), ("User-Agent", " spaced ")], "abc", 47, ["chunked"], true, "POST", false), "HTTP/1.0 404 Not Found\r\nConnection: close\r\nContent-Length: 47\r\nUser-Agent: spaced\r\nX-Lower: \r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Accept", "a"), ("Bad Key", "close"), ("Host", "a")], "", -1, [], false, "HEAD", true), "HTTP/1.1 304 200 OK\r\nConnection: close\r\nAccept: a\r\nHost: a\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.0", [("Content-Type", "chunked")], "hello world", 24, [], false, "GET", true), "ERR http: ContentLength=24 with Body length 11"
  assert_eq dresp(404, "", "HTTP/1.1", [("x-lower", "10"), ("Accept", " spaced "), ("Content-Type", "close")], "abc", 0, [], false, "HEAD", true), "HTTP/1.1 404 Not Found\r\nConnection: close\r\nAccept: spaced\r\nContent-Type: close\r\nX-Lower: 10\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], true, "GET", false), "HTTP/1.1 304 Custom Text\r\nConnection: close\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [("Bad Key", "chunked")], "", 6, [], false, "POST", false), "HTTP/1.1 007 200 OK\r\nContent-Length: 6\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("User-Agent", "chunked"), ("Bad Key", "a"), ("Transfer-Encoding", "close")], "hello world", -1, [], false, "POST", true), "HTTP/1.1 304 200 OK\r\nConnection: close\r\nUser-Agent: chunked\r\n\r\nhello world"
  assert_eq dresp(200, "", "HTTP/1.0", [("Host", ""), ("Accept", "two\nlines"), ("X-Foo", "text/html")], "", 0, [], false, "POST", true), "HTTP/1.0 200 OK\r\nContent-Length: 0\r\nAccept: two lines\r\nHost: \r\nX-Foo: text/html\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.0", [], "", -1, [], false, "HEAD", false), "HTTP/1.0 007 status code 7\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.0", [("Connection", "a")], "abc", 0, ["chunked"], false, "POST", false), "HTTP/1.0 404 Not Found\r\nContent-Length: 0\r\nConnection: a\r\n\r\n"
  assert_eq dresp(404, "200 OK", "HTTP/1.1", [("Transfer-Encoding", "chunked")], "hello world", 11, [], false, "GET", false), "HTTP/1.1 404 200 OK\r\nContent-Length: 11\r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.0", [("Host", "text/html"), ("Host", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 21, [], true, "HEAD", true), "HTTP/1.0 204 200 OK\r\nConnection: close\r\nContent-Length: 21\r\nHost: text/html\r\nHost: spaced\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.0", [], "abc", 34, ["chunked"], false, "GET", true), "ERR http: ContentLength=34 with Body length 3"
  assert_eq dresp(500, "200 OK", "HTTP/1.1", [("Transfer-Encoding", " spaced ")], "hello world", 0, [], false, "POST", false), "HTTP/1.1 500 200 OK\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.1", [("Accept", " spaced "), ("Content-Type", "chunked")], "", 0, [], true, "GET", false), "HTTP/1.1 204 No Content\r\nConnection: close\r\nAccept: spaced\r\nContent-Type: chunked\r\n\r\n"
  assert_eq dresp(200, "", "HTTP/1.0", [], "abc", 32, [], true, "HEAD", false), "HTTP/1.0 200 OK\r\nConnection: close\r\nContent-Length: 32\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [("User-Agent", "two\nlines"), ("Host", "close")], "", 0, [], false, "POST", true), "HTTP/1.1 007 200 OK\r\nContent-Length: 0\r\nHost: close\r\nUser-Agent: two lines\r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.1", [("X-Foo", ""), ("Accept", ""), ("Content-Length", "text/html")], "abc", 49, ["chunked"], false, "GET", false), "HTTP/1.1 204 200 OK\r\nTransfer-Encoding: chunked\r\nAccept: \r\nX-Foo: \r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.1", [], "abc", 38, ["chunked"], false, "HEAD", true), "HTTP/1.1 204 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.1", [("X-Foo", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], true, "GET", false), "HTTP/1.1 200 OK\r\nConnection: close\r\nX-Foo: 10\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.0", [("Transfer-Encoding", "10"), ("Content-Type", "chunked")], "hello world", -1, [], true, "HEAD", false), "HTTP/1.0 204 No Content\r\nConnection: close\r\nContent-Type: chunked\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.1", [("User-Agent", "chunked")], "abc", -1, [], false, "GET", true), "HTTP/1.1 404 Not Found\r\nConnection: close\r\nUser-Agent: chunked\r\n\r\nabc"
  assert_eq dresp(101, "200 OK", "HTTP/1.1", [], "abc", 1, [], false, "POST", false), "HTTP/1.1 101 200 OK\r\nContent-Length: 1\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.0", [("X-Foo", "text/html")], "", -1, [], true, "POST", true), "HTTP/1.0 304 200 OK\r\nConnection: close\r\nX-Foo: text/html\r\n\r\n"
  assert_eq dresp(404, "200 OK", "HTTP/1.1", [], "abc", 0, ["chunked"], false, "GET", false), "HTTP/1.1 404 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.0", [], "", 4, [], true, "HEAD", true), "HTTP/1.0 007 Custom Text\r\nConnection: close\r\nContent-Length: 4\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.0", [("Trailer", "a"), ("Content-Length", "")], "", 0, ["chunked"], false, "HEAD", false), "HTTP/1.0 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.1", [("Host", "text/html")], "hello world", 0, [], true, "GET", false), "HTTP/1.1 200 OK\r\nConnection: close\r\nHost: text/html\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(404, "Custom Text", "HTTP/1.0", [("Accept", "text/html"), ("Content-Length", "close"), ("Connection", "close")], "hello world", 0, ["chunked"], true, "POST", false), "HTTP/1.0 404 Custom Text\r\nContent-Length: 0\r\nAccept: text/html\r\nConnection: close\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Connection", "text/html"), ("Content-Type", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "POST", true), "HTTP/1.1 304 200 OK\r\nConnection: close\r\nConnection: text/html\r\nContent-Type: \r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(200, "Custom Text", "HTTP/1.1", [("Connection", "two\nlines"), ("Host", "two\nlines"), ("Content-Type", "10")], "hello world", 11, [], false, "POST", true), "HTTP/1.1 200 Custom Text\r\nContent-Length: 11\r\nConnection: two lines\r\nContent-Type: 10\r\nHost: two lines\r\n\r\nhello world"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [("Bad Key", " spaced "), ("Trailer", " spaced ")], "hello world", 0, ["chunked"], false, "GET", true), "HTTP/1.1 007 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nh\r\na\r\nello world\r\n0\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.1", [("Accept", "a"), ("x-lower", "two\nlines"), ("X-Foo", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "POST", false), "HTTP/1.1 007 status code 7\r\nConnection: close\r\nAccept: a\r\nX-Foo: spaced\r\nX-Lower: two lines\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.0", [("Host", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 10, [], false, "HEAD", false), "HTTP/1.0 404 Not Found\r\nContent-Length: 10\r\nHost: close\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.0", [], "abc", 0, ["chunked"], false, "HEAD", true), "HTTP/1.0 007 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.0", [("Content-Length", "two\nlines"), ("Host", "two\nlines"), ("Trailer", "a")], "abc", 3, [], false, "HEAD", false), "HTTP/1.0 007 status code 7\r\nContent-Length: 3\r\nHost: two lines\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.0", [("User-Agent", "a"), ("Accept", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], true, "GET", true), "HTTP/1.0 007 200 OK\r\nConnection: close\r\nContent-Length: 40\r\nAccept: spaced\r\nUser-Agent: a\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(404, "200 OK", "HTTP/1.1", [("Connection", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "POST", false), "HTTP/1.1 404 200 OK\r\nConnection: close\r\nConnection: a\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [], "", -1, [], true, "HEAD", true), "HTTP/1.1 500 Custom Text\r\nConnection: close\r\n\r\n"
  assert_eq dresp(101, "Custom Text", "HTTP/1.1", [], "", 0, [], false, "HEAD", true), "HTTP/1.1 101 Custom Text\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.1", [], "hello world", 11, [], false, "GET", true), "HTTP/1.1 007 status code 7\r\nContent-Length: 11\r\n\r\nhello world"
  assert_eq dresp(304, "", "HTTP/1.0", [], "abc", 1, [], false, "POST", false), "HTTP/1.0 304 Not Modified\r\nContent-Length: 1\r\n\r\n"
  assert_eq dresp(404, "200 OK", "HTTP/1.0", [], "hello world", 26, [], false, "GET", true), "ERR http: ContentLength=26 with Body length 11"
  assert_eq dresp(200, "200 OK", "HTTP/1.1", [("Bad Key", "10")], "hello world", 7, ["chunked"], true, "GET", true), "HTTP/1.1 200 OK\r\nConnection: close\r\nTransfer-Encoding: chunked\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.1", [("Connection", "chunked")], "hello world", 11, ["chunked"], false, "GET", true), "HTTP/1.1 007 status code 7\r\nTransfer-Encoding: chunked\r\nConnection: chunked\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.0", [("Content-Type", "two\nlines"), ("Accept", "chunked"), ("x-lower", "a")], "hello world", -1, [], true, "HEAD", true), "HTTP/1.0 304 Custom Text\r\nConnection: close\r\nAccept: chunked\r\nContent-Type: two lines\r\nX-Lower: a\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.0", [], "", 36, ["chunked"], false, "POST", true), "ERR http: ContentLength=36 with Body length 0"
  assert_eq dresp(204, "", "HTTP/1.1", [("Bad Key", " spaced "), ("Content-Length", "two\nlines")], "abc", 3, [], true, "HEAD", false), "HTTP/1.1 204 No Content\r\nConnection: close\r\nContent-Length: 3\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.1", [], "", -1, [], false, "POST", true), "HTTP/1.1 101 200 OK\r\nConnection: close\r\n\r\n"
  assert_eq dresp(204, "Custom Text", "HTTP/1.0", [("Connection", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], true, "POST", false), "HTTP/1.0 204 Custom Text\r\nConnection: close\r\nConnection: a\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.0", [("Host", ""), ("Accept", "two\nlines")], "", -1, [], false, "GET", true), "HTTP/1.0 007 200 OK\r\nAccept: two lines\r\nHost: \r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.0", [("Transfer-Encoding", "two\nlines"), ("Content-Length", "a"), ("x-lower", "text/html")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "HEAD", true), "HTTP/1.0 204 200 OK\r\nX-Lower: text/html\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.1", [("X-Foo", "close")], "", 0, [], false, "HEAD", true), "HTTP/1.1 500 Internal Server Error\r\nX-Foo: close\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Trailer", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "POST", true), "HTTP/1.1 304 200 OK\r\nContent-Length: 40\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(7, "", "HTTP/1.1", [("Content-Length", "")], "hello world", 0, [], false, "POST", false), "HTTP/1.1 007 status code 7\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.1", [("User-Agent", "chunked")], "hello world", 33, ["chunked"], true, "POST", false), "HTTP/1.1 404 Not Found\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nUser-Agent: chunked\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.0", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], true, "HEAD", true), "HTTP/1.0 304 Custom Text\r\nConnection: close\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.0", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], true, "GET", false), "HTTP/1.0 500 Internal Server Error\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(404, "Custom Text", "HTTP/1.1", [], "hello world", 11, ["chunked"], false, "HEAD", false), "HTTP/1.1 404 Custom Text\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.0", [("Accept", "text/html")], "hello world", 0, [], false, "GET", false), "HTTP/1.0 204 No Content\r\nAccept: text/html\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.0", [("Trailer", "a"), ("Transfer-Encoding", "10"), ("Accept", "10")], "hello world", 0, [], true, "GET", true), "HTTP/1.0 101 200 OK\r\nConnection: close\r\nAccept: 10\r\n\r\nhello world"
  assert_eq dresp(200, "200 OK", "HTTP/1.1", [("Connection", "close"), ("Content-Length", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], false, "POST", true), "HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(7, "Custom Text", "HTTP/1.1", [("Connection", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 49, ["chunked"], false, "POST", false), "HTTP/1.1 007 Custom Text\r\nTransfer-Encoding: chunked\r\nConnection: two lines\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.0", [("Bad Key", "text/html"), ("Trailer", "two\nlines"), ("Content-Type", "two\nlines")], "hello world", 11, [], true, "POST", true), "HTTP/1.0 200 Custom Text\r\nConnection: close\r\nContent-Length: 11\r\nContent-Type: two lines\r\n\r\nhello world"
  assert_eq dresp(500, "", "HTTP/1.0", [("Host", " spaced "), ("Host", "two\nlines"), ("Accept", "")], "hello world", -1, [], false, "HEAD", true), "HTTP/1.0 500 Internal Server Error\r\nAccept: \r\nHost: spaced\r\nHost: two lines\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [], "hello world", -1, ["chunked"], true, "GET", true), "HTTP/1.1 007 200 OK\r\nConnection: close\r\nTransfer-Encoding: chunked\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
}

test "vectors: dump response 1" {
  assert_eq dresp(500, "", "HTTP/1.0", [("Bad Key", ""), ("x-lower", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "HEAD", true), "HTTP/1.0 500 Internal Server Error\r\nX-Lower: \r\n\r\n"
  assert_eq dresp(304, "", "HTTP/1.1", [("Content-Type", ""), ("User-Agent", "10"), ("X-Foo", "two\nlines")], "", -1, ["chunked"], false, "POST", false), "HTTP/1.1 304 Not Modified\r\nTransfer-Encoding: chunked\r\nContent-Type: \r\nUser-Agent: 10\r\nX-Foo: two lines\r\n\r\n"
  assert_eq dresp(404, "200 OK", "HTTP/1.1", [("Content-Length", "two\nlines")], "abc", -1, [], false, "POST", false), "HTTP/1.1 404 200 OK\r\nConnection: close\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.1", [("x-lower", "two\nlines")], "hello world", 9, [], true, "POST", true), "ERR http: ContentLength=9 with Body length 11"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [], "abc", -1, [], false, "POST", false), "HTTP/1.1 007 200 OK\r\nConnection: close\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 27, ["chunked"], true, "HEAD", false), "HTTP/1.1 304 Custom Text\r\nConnection: close\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.0", [("x-lower", "a")], "abc", 2, [], false, "POST", false), "HTTP/1.0 200 Custom Text\r\nContent-Length: 2\r\nX-Lower: a\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.1", [("Bad Key", "text/html"), ("Host", "text/html"), ("Bad Key", "chunked")], "abc", -1, [], false, "GET", true), "HTTP/1.1 304 Custom Text\r\nConnection: close\r\nHost: text/html\r\n\r\nabc"
  assert_eq dresp(204, "Custom Text", "HTTP/1.0", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 49, ["chunked"], false, "POST", false), "HTTP/1.0 204 Custom Text\r\nContent-Length: 49\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.1", [("Content-Type", "chunked")], "abc", -1, [], false, "GET", true), "HTTP/1.1 101 200 OK\r\nConnection: close\r\nContent-Type: chunked\r\n\r\nabc"
  assert_eq dresp(204, "Custom Text", "HTTP/1.1", [("Bad Key", " spaced "), ("Connection", " spaced ")], "abc", -1, ["chunked"], false, "POST", true), "HTTP/1.1 204 Custom Text\r\nTransfer-Encoding: chunked\r\nConnection: spaced\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.1", [], "", 0, [], true, "POST", true), "HTTP/1.1 500 200 OK\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.1", [("Accept", "a"), ("Content-Type", "two\nlines"), ("Host", "two\nlines")], "hello world", -1, [], true, "GET", false), "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nAccept: a\r\nContent-Type: two lines\r\nHost: two lines\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Content-Length", "chunked"), ("Trailer", "two\nlines")], "hello world", -1, [], false, "GET", true), "HTTP/1.1 304 200 OK\r\nConnection: close\r\n\r\nhello world"
  assert_eq dresp(101, "", "HTTP/1.1", [("Bad Key", "chunked")], "abc", 22, [], false, "POST", false), "HTTP/1.1 101 Switching Protocols\r\nContent-Length: 22\r\n\r\n"
  assert_eq dresp(304, "", "HTTP/1.1", [("Bad Key", "")], "abc", 0, [], true, "HEAD", false), "HTTP/1.1 304 Not Modified\r\nConnection: close\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.0", [("Host", "a"), ("Host", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "POST", true), "HTTP/1.0 200 Custom Text\r\nContent-Length: 40\r\nHost: a\r\nHost: chunked\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(101, "", "HTTP/1.0", [("Host", "close")], "hello world", 0, [], false, "HEAD", false), "HTTP/1.0 101 Switching Protocols\r\nHost: close\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [("Content-Type", "text/html"), ("User-Agent", "two\nlines"), ("x-lower", "10")], "", 4, ["chunked"], true, "POST", true), "HTTP/1.1 500 Custom Text\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nContent-Type: text/html\r\nUser-Agent: two lines\r\nX-Lower: 10\r\n\r\n0\r\n\r\n"
  assert_eq dresp(404, "200 OK", "HTTP/1.0", [("Content-Length", "two\nlines"), ("Bad Key", ""), ("Connection", "10")], "", -1, [], false, "HEAD", false), "HTTP/1.0 404 200 OK\r\nConnection: 10\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.1", [("Content-Type", "chunked"), ("Host", "close"), ("x-lower", "")], "hello world", 0, [], false, "GET", false), "HTTP/1.1 200 OK\r\nContent-Type: chunked\r\nHost: close\r\nX-Lower: \r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.0", [("Trailer", " spaced ")], "abc", 3, [], false, "HEAD", false), "HTTP/1.0 500 Custom Text\r\nContent-Length: 3\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.0", [], "", 30, [], true, "GET", false), "HTTP/1.0 304 200 OK\r\nConnection: close\r\nContent-Length: 30\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.0", [("User-Agent", "chunked"), ("Host", "chunked")], "abc", 34, [], true, "GET", true), "ERR http: ContentLength=34 with Body length 3"
  assert_eq dresp(304, "", "HTTP/1.1", [("x-lower", "a"), ("Content-Type", "close"), ("Trailer", "two\nlines")], "hello world", 11, ["chunked"], false, "GET", false), "HTTP/1.1 304 Not Modified\r\nTransfer-Encoding: chunked\r\nContent-Type: close\r\nX-Lower: a\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.0", [("Content-Type", "")], "hello world", -1, [], true, "GET", true), "HTTP/1.0 404 Not Found\r\nConnection: close\r\nContent-Type: \r\n\r\nhello world"
  assert_eq dresp(404, "", "HTTP/1.1", [("X-Foo", "a"), ("User-Agent", "10"), ("x-lower", "text/html")], "", 0, [], true, "POST", false), "HTTP/1.1 404 Not Found\r\nConnection: close\r\nContent-Length: 0\r\nUser-Agent: 10\r\nX-Foo: a\r\nX-Lower: text/html\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.1", [("Transfer-Encoding", " spaced "), ("Transfer-Encoding", " spaced "), ("Content-Length", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "GET", true), "HTTP/1.1 007 Custom Text\r\nConnection: close\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(500, "200 OK", "HTTP/1.1", [("Host", "chunked"), ("Transfer-Encoding", ""), ("x-lower", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], true, "POST", false), "HTTP/1.1 500 200 OK\r\nConnection: close\r\nHost: chunked\r\nX-Lower: close\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [("Transfer-Encoding", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 30, [], false, "HEAD", true), "HTTP/1.1 500 Custom Text\r\nContent-Length: 30\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.0", [("Trailer", "chunked"), ("X-Foo", "a")], "abc", 0, [], false, "HEAD", false), "HTTP/1.0 200 Custom Text\r\nX-Foo: a\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(101, "Custom Text", "HTTP/1.1", [("Accept", "a"), ("Accept", "close")], "abc", 11, [], true, "GET", false), "HTTP/1.1 101 Custom Text\r\nConnection: close\r\nContent-Length: 11\r\nAccept: a\r\nAccept: close\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.1", [], "hello world", 4, [], false, "POST", false), "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [], "abc", 35, [], false, "HEAD", true), "HTTP/1.1 500 Custom Text\r\nContent-Length: 35\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [("X-Foo", " spaced ")], "abc", -1, ["chunked"], true, "HEAD", true), "HTTP/1.1 007 200 OK\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nX-Foo: spaced\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.0", [("x-lower", " spaced "), ("Host", "chunked"), ("Content-Type", " spaced ")], "", 0, [], false, "GET", true), "HTTP/1.0 007 Custom Text\r\nContent-Type: spaced\r\nHost: chunked\r\nX-Lower: spaced\r\nContent-Length: 0\r\n\r\n"
