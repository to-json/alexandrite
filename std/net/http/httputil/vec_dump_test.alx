  assert_eq dreq("", "/foo", "HTTP/1.0", [], "abc", 3, [], "", "", true), "GET /foo HTTP/1.0\r\n\r\nabc"
  assert_eq dreq("GET", "*", "HTTP/1.1", [], "", 0, ["chunked"], "example.com", "*", false), "GET * HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("POST", "https://secure.example/x", "HTTP/1.1", [("Content-Length", "text/html"), ("Accept", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "", "", false), "POST /x HTTP/1.1\r\nHost: secure.example\r\nAccept: \r\nContent-Length: text/html\r\n\r\n"
  assert_eq dreq("", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [("Accept", "a"), ("Connection", "close")], "hello world", 0, [], "example.com", "", false), "GET /a/b?x=1&y=2 HTTP/1.1\r\nHost: example.com\r\nAccept: a\r\nConnection: close\r\n\r\n"
  assert_eq dreq("", "http://h:8080/p%20q", "HTTP/1.0", [], "", 0, [], "example.com", "http://h:8080/p%20q", true), "GET http://h:8080/p%20q HTTP/1.0\r\n\r\n"
  assert_eq dreq("POST", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [("Content-Type", ""), ("Host", ""), ("Host", "text/html")], "hello world", 11, ["chunked"], "", "http://example.com/a/b?x=1&y=2", false), "POST http://example.com/a/b?x=1&y=2 HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Type: \r\n\r\n"
  assert_eq dreq("", "https://secure.example/x", "HTTP/1.0", [("Transfer-Encoding", "text/html"), ("Bad Key", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], "", "https://secure.example/x", false), "GET https://secure.example/x HTTP/1.0\r\n\r\n"
  assert_eq dreq("", "*", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], "", "", true), "GET * HTTP/1.1\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("POST", "http://h:8080/p%20q", "HTTP/1.0", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], "other.host:81", "", true), "POST /p%20q HTTP/1.0\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\n28\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\r\n0\r\n\r\n"
