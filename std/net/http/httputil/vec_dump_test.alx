  assert_eq chunks([]), "0\r\n"
  assert_eq chunks(["uuu", "zzzzzzzzzzzzzzzzzzzzz"]), "3\r\nuuu\r\n15\r\nzzzzzzzzzzzzzzzzzzzzz\r\n0\r\n"
  assert_eq chunks(["qqqqqqqqqq", "vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"]), "a\r\nqqqqqqqqqq\r\n1f\r\nvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\r\n0\r\n"
  assert_eq chunks(["", "ppppppppppppppppppppppppppppp"]), "1d\r\nppppppppppppppppppppppppppppp\r\n0\r\n"
  assert_eq chunks(["s", "rrrr", "zzzzzzzzzzzzzzzzzzzz"]), "1\r\ns\r\n4\r\nrrrr\r\n14\r\nzzzzzzzzzzzzzzzzzzzz\r\n0\r\n"
}
