  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Accept", "10")], "abc", 32, [], true, "POST", false), "HTTP/1.1 304 200 OK\r\nConnection: close\r\nContent-Length: 32\r\nAccept: 10\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 43, [], false, "POST", false), "HTTP/1.1 101 200 OK\r\nContent-Length: 43\r\n\r\n"
