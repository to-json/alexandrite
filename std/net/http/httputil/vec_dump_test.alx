  assert_eq dresp(304, "200 OK", "HTTP/1.0", [("Content-Type", "close"), ("Host", "chunked")], "abc", 3, [], true, "HEAD", true), "HTTP/1.0 304 200 OK\r\nConnection: close\r\nContent-Length: 3\r\nContent-Type: close\r\nHost: chunked\r\n\r\n"
  assert_eq dresp(204, "Custom Text", "HTTP/1.1", [("Content-Type", " spaced "), ("x-lower", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], false, "POST", false), "HTTP/1.1 204 Custom Text\r\nTransfer-Encoding: chunked\r\nContent-Type: spaced\r\nX-Lower: chunked\r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.1", [("Bad Key", "close")], "", 0, ["chunked"], false, "GET", true), "HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [], "", 0, [], false, "POST", false), "HTTP/1.0 500 200 OK\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.1", [("Bad Key", "text/html"), ("Transfer-Encoding", "10"), ("Trailer", "text/html")], "abc", 0, [], true, "POST", true), "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\nabc"
  assert_eq dresp(304, "200 OK", "HTTP/1.0", [], "hello world", 0, [], false, "GET", true), "HTTP/1.0 304 200 OK\r\n\r\nhello world"
  assert_eq dresp(404, "200 OK", "HTTP/1.0", [("User-Agent", ""), ("Host", "10")], "abc", 0, [], true, "GET", false), "HTTP/1.0 404 200 OK\r\nConnection: close\r\nHost: 10\r\nUser-Agent: \r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.0", [("X-Foo", "")], "", 24, ["chunked"], true, "HEAD", true), "HTTP/1.0 304 200 OK\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nX-Foo: \r\n\r\n"
  assert_eq dresp(101, "", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "GET", true), "HTTP/1.1 101 Switching Protocols\r\nContent-Length: 40\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Content-Length", "10")], "abc", 3, [], false, "POST", false), "HTTP/1.1 304 200 OK\r\nContent-Length: 3\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.0", [("Host", "10"), ("x-lower", "two\nlines")], "abc", 3, [], false, "GET", false), "HTTP/1.0 007 status code 7\r\nContent-Length: 3\r\nHost: 10\r\nX-Lower: two lines\r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.0", [("Trailer", "10")], "hello world", 11, ["chunked"], false, "POST", true), "HTTP/1.0 204 No Content\r\nContent-Length: 11\r\n\r\nhello world"
  assert_eq dresp(7, "200 OK", "HTTP/1.0", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], false, "HEAD", false), "HTTP/1.0 007 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.0", [("Accept", "close"), ("Content-Length", "chunked"), ("X-Foo", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], false, "HEAD", false), "HTTP/1.0 500 Custom Text\r\nTransfer-Encoding: chunked\r\nAccept: close\r\nX-Foo: a\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.0", [("User-Agent", "text/html"), ("Content-Type", "a")], "hello world", 11, [], false, "HEAD", true), "HTTP/1.0 200 OK\r\nContent-Length: 11\r\nContent-Type: a\r\nUser-Agent: text/html\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [("Content-Type", " spaced ")], "", 0, [], false, "GET", true), "HTTP/1.1 500 Custom Text\r\nContent-Type: spaced\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(404, "Custom Text", "HTTP/1.1", [("Bad Key", "two\nlines")], "hello world", 36, [], true, "GET", false), "HTTP/1.1 404 Custom Text\r\nConnection: close\r\nContent-Length: 36\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.0", [("Trailer", "10"), ("Content-Length", "close"), ("Trailer", " spaced ")], "abc", 47, [], false, "GET", false), "HTTP/1.0 200 OK\r\nContent-Length: 47\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.1", [("User-Agent", "text/html")], "abc", -1, [], false, "POST", false), "HTTP/1.1 101 200 OK\r\nConnection: close\r\nUser-Agent: text/html\r\n\r\n"
  assert_eq dresp(404, "200 OK", "HTTP/1.0", [], "abc", 25, [], true, "GET", false), "HTTP/1.0 404 200 OK\r\nConnection: close\r\nContent-Length: 25\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.1", [], "abc", 0, [], true, "POST", true), "HTTP/1.1 404 Not Found\r\nConnection: close\r\n\r\nabc"
  assert_eq dresp(7, "Custom Text", "HTTP/1.0", [("Connection", " spaced ")], "abc", -1, [], false, "GET", true), "HTTP/1.0 007 Custom Text\r\nConnection: spaced\r\n\r\nabc"
  assert_eq dresp(500, "", "HTTP/1.1", [], "abc", 3, [], false, "POST", true), "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 3\r\n\r\nabc"
  assert_eq dresp(101, "Custom Text", "HTTP/1.0", [("Host", "text/html"), ("Accept", "two\nlines"), ("Trailer", "chunked")], "abc", -1, [], false, "HEAD", false), "HTTP/1.0 101 Custom Text\r\nAccept: two lines\r\nHost: text/html\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.0", [("Accept", " spaced "), ("Bad Key", "a"), ("Transfer-Encoding", " spaced ")], "hello world", 0, [], false, "HEAD", false), "HTTP/1.0 500 Custom Text\r\nAccept: spaced\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.1", [("Content-Length", " spaced "), ("Transfer-Encoding", " spaced ")], "hello world", 0, [], false, "GET", true), "HTTP/1.1 200 Custom Text\r\nConnection: close\r\n\r\nhello world"
  assert_eq dresp(404, "200 OK", "HTTP/1.1", [("Connection", " spaced ")], "", -1, [], false, "GET", false), "HTTP/1.1 404 200 OK\r\nConnection: close\r\nConnection: spaced\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [], "hello world", 16, [], false, "HEAD", false), "HTTP/1.0 500 200 OK\r\nContent-Length: 16\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.1", [("Content-Type", "two\nlines"), ("Content-Length", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], false, "POST", false), "HTTP/1.1 500 200 OK\r\nContent-Length: 0\r\nContent-Type: two lines\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.1", [("Connection", "text/html"), ("Trailer", "two\nlines")], "", 0, [], true, "HEAD", true), "HTTP/1.1 007 Custom Text\r\nConnection: close\r\nConnection: text/html\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.0", [], "", 0, [], false, "HEAD", true), "HTTP/1.0 007 200 OK\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(404, "Custom Text", "HTTP/1.1", [("Content-Length", "two\nlines"), ("X-Foo", "close"), ("X-Foo", "text/html")], "abc", 0, [], false, "HEAD", false), "HTTP/1.1 404 Custom Text\r\nX-Foo: close\r\nX-Foo: text/html\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(304, "", "HTTP/1.1", [("X-Foo", " spaced "), ("User-Agent", ""), ("X-Foo", "a")], "abc", 3, [], false, "HEAD", false), "HTTP/1.1 304 Not Modified\r\nContent-Length: 3\r\nUser-Agent: \r\nX-Foo: spaced\r\nX-Foo: a\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "GET", false), "HTTP/1.1 200 Custom Text\r\nConnection: close\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.1", [("Content-Length", "close"), ("x-lower", ""), ("Transfer-Encoding", "close")], "hello world", -1, [], false, "GET", true), "HTTP/1.1 500 200 OK\r\nConnection: close\r\nX-Lower: \r\n\r\nhello world"
  assert_eq dresp(200, "Custom Text", "HTTP/1.1", [("x-lower", "close")], "hello world", -1, ["chunked"], false, "POST", true), "HTTP/1.1 200 Custom Text\r\nTransfer-Encoding: chunked\r\nX-Lower: close\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.1", [("Host", " spaced "), ("User-Agent", "")], "", -1, [], true, "GET", true), "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nHost: spaced\r\nUser-Agent: \r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.0", [], "abc", 44, ["chunked"], false, "GET", true), "ERR http: ContentLength=44 with Body length 3"
  assert_eq dresp(404, "", "HTTP/1.0", [("User-Agent", "two\nlines")], "abc", 42, [], false, "HEAD", true), "HTTP/1.0 404 Not Found\r\nContent-Length: 42\r\nUser-Agent: two lines\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.0", [("Transfer-Encoding", "close"), ("X-Foo", "text/html")], "abc", 0, [], true, "HEAD", true), "HTTP/1.0 200 Custom Text\r\nConnection: close\r\nX-Foo: text/html\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.1", [("Content-Type", "a")], "hello world", 37, [], true, "GET", true), "ERR http: ContentLength=37 with Body length 11"
  assert_eq dresp(204, "", "HTTP/1.1", [("Transfer-Encoding", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], true, "HEAD", false), "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.1", [("Transfer-Encoding", "two\nlines"), ("User-Agent", "close")], "abc", 0, [], true, "GET", false), "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nUser-Agent: close\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.1", [("X-Foo", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], false, "HEAD", true), "HTTP/1.1 200 OK\r\nConnection: close\r\nX-Foo: \r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.1", [("Content-Type", " spaced "), ("User-Agent", "a"), ("X-Foo", "two\nlines")], "", -1, [], false, "GET", true), "HTTP/1.1 101 200 OK\r\nConnection: close\r\nContent-Type: spaced\r\nUser-Agent: a\r\nX-Foo: two lines\r\n\r\n"
  assert_eq dresp(404, "Custom Text", "HTTP/1.0", [("Transfer-Encoding", "")], "abc", 24, [], false, "POST", false), "HTTP/1.0 404 Custom Text\r\nContent-Length: 24\r\n\r\n"
  assert_eq dresp(101, "Custom Text", "HTTP/1.1", [], "hello world", -1, [], true, "GET", true), "HTTP/1.1 101 Custom Text\r\nConnection: close\r\n\r\nhello world"
  assert_eq dresp(101, "", "HTTP/1.1", [("X-Foo", "a"), ("Bad Key", "a"), ("User-Agent", "text/html")], "", 2, ["chunked"], true, "POST", false), "HTTP/1.1 101 Switching Protocols\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nUser-Agent: text/html\r\nX-Foo: a\r\n\r\n"
  assert_eq dresp(200, "", "HTTP/1.0", [("Host", "chunked"), ("Content-Type", "10")], "", 0, [], false, "GET", true), "HTTP/1.0 200 OK\r\nContent-Type: 10\r\nHost: chunked\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.1", [], "", -1, [], true, "HEAD", true), "HTTP/1.1 200 Custom Text\r\nConnection: close\r\n\r\n"
  assert_eq dresp(101, "Custom Text", "HTTP/1.1", [("Content-Type", "two\nlines"), ("Connection", ""), ("Content-Type", "")], "abc", -1, [], false, "GET", false), "HTTP/1.1 101 Custom Text\r\nConnection: close\r\nConnection: \r\nContent-Type: two lines\r\nContent-Type: \r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.0", [("Bad Key", "a"), ("User-Agent", "10")], "", 10, [], false, "POST", true), "ERR http: ContentLength=10 with Body length 0"
  assert_eq dresp(7, "200 OK", "HTTP/1.0", [], "hello world", 39, [], true, "POST", true), "ERR http: ContentLength=39 with Body length 11"
  assert_eq dresp(404, "Custom Text", "HTTP/1.0", [("Content-Type", "a"), ("Content-Type", "text/html")], "hello world", 0, [], true, "HEAD", false), "HTTP/1.0 404 Custom Text\r\nConnection: close\r\nContent-Type: a\r\nContent-Type: text/html\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Content-Type", "text/html"), ("Accept", "text/html")], "abc", 3, ["chunked"], false, "POST", true), "HTTP/1.1 304 200 OK\r\nTransfer-Encoding: chunked\r\nAccept: text/html\r\nContent-Type: text/html\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.0", [], "abc", 3, [], true, "HEAD", false), "HTTP/1.0 200 Custom Text\r\nConnection: close\r\nContent-Length: 3\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [("Transfer-Encoding", "close"), ("X-Foo", "close")], "", 0, [], true, "HEAD", false), "HTTP/1.0 500 200 OK\r\nConnection: close\r\nX-Foo: close\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(204, "Custom Text", "HTTP/1.1", [("Accept", "text/html")], "abc", 0, [], true, "HEAD", false), "HTTP/1.1 204 Custom Text\r\nConnection: close\r\nAccept: text/html\r\n\r\n"
  assert_eq dresp(304, "", "HTTP/1.0", [("User-Agent", "a"), ("Bad Key", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "GET", true), "HTTP/1.0 304 Not Modified\r\nContent-Length: 40\r\nUser-Agent: a\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(500, "200 OK", "HTTP/1.1", [("Host", ""), ("Connection", "text/html"), ("X-Foo", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 34, [], true, "GET", true), "ERR http: ContentLength=34 with Body length 40"
  assert_eq dresp(7, "", "HTTP/1.0", [("Host", "10")], "abc", 0, ["chunked"], true, "HEAD", false), "HTTP/1.0 007 status code 7\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nHost: 10\r\n\r\n"
  assert_eq dresp(101, "Custom Text", "HTTP/1.1", [("X-Foo", ""), ("Trailer", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "GET", false), "HTTP/1.1 101 Custom Text\r\nContent-Length: 40\r\nX-Foo: \r\n\r\n"
}

test "vectors: chunked writer 0" {
  assert_eq chunks(["mmmmmmmmmmmmmmmmmmmmmmmm", "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", "ppppppppppppppppppp"]), "18\r\nmmmmmmmmmmmmmmmmmmmmmmmm\r\n25\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\r\n13\r\nppppppppppppppppppp\r\n0\r\n"
  assert_eq chunks(["rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr", "hhhhhhhhhhhhhh"]), "27\r\nrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr\r\ne\r\nhhhhhhhhhhhhhh\r\n0\r\n"
  assert_eq chunks(["wwwwwwwwwwwwwwwwwwwwwwwwwwwww", "zzzzzzzzzzzzzz"]), "1d\r\nwwwwwwwwwwwwwwwwwwwwwwwwwwwww\r\ne\r\nzzzzzzzzzzzzzz\r\n0\r\n"
  assert_eq chunks([]), "0\r\n"
  assert_eq chunks(["qqqqqqqqqqqqqqqqqqqqqq", "pppppppppppppppppppppppppp"]), "16\r\nqqqqqqqqqqqqqqqqqqqqqq\r\n1a\r\npppppppppppppppppppppppppp\r\n0\r\n"
  assert_eq chunks(["pppppp"]), "6\r\npppppp\r\n0\r\n"
  assert_eq chunks([]), "0\r\n"
  assert_eq chunks(["aaaaaaaaaaaaaaaaaaaaaaaaa"]), "19\r\naaaaaaaaaaaaaaaaaaaaaaaaa\r\n0\r\n"
  assert_eq chunks([]), "0\r\n"
  assert_eq chunks(["uuuuuuuuuuuuuuuuuuuuuuuuuuuuuu", "zzzzzzzzzzzzzzz"]), "1e\r\nuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu\r\nf\r\nzzzzzzzzzzzzzzz\r\n0\r\n"
  assert_eq chunks(["qqqq", "bbbbbbbbbbb", "wwwwwwwwwwwwww"]), "4\r\nqqqq\r\nb\r\nbbbbbbbbbbb\r\ne\r\nwwwwwwwwwwwwww\r\n0\r\n"
  assert_eq chunks(["ttttttttttttt", "x"]), "d\r\nttttttttttttt\r\n1\r\nx\r\n0\r\n"
  assert_eq chunks(["xxxxxxxxxx"]), "a\r\nxxxxxxxxxx\r\n0\r\n"
  assert_eq chunks(["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "xxxxxxxxxxxxxxxxxxx"]), "21\r\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n13\r\nxxxxxxxxxxxxxxxxxxx\r\n0\r\n"
  assert_eq chunks([]), "0\r\n"
  assert_eq chunks([]), "0\r\n"
  assert_eq chunks(["qq", "vvvvvvvvvvv", "gggggggg"]), "2\r\nqq\r\nb\r\nvvvvvvvvvvv\r\n8\r\ngggggggg\r\n0\r\n"
  assert_eq chunks([]), "0\r\n"
  assert_eq chunks(["lllllll", "wwwwwwwwwwwwwwwwwwwwwwwww"]), "7\r\nlllllll\r\n19\r\nwwwwwwwwwwwwwwwwwwwwwwwww\r\n0\r\n"
  assert_eq chunks([]), "0\r\n"
  assert_eq chunks([]), "0\r\n"
  assert_eq chunks(["wwwwwwwwwwwwwwww", "kkkkkkkkkkkkkkkkkkkkkkkk", "sssssssssssssss"]), "10\r\nwwwwwwwwwwwwwwww\r\n18\r\nkkkkkkkkkkkkkkkkkkkkkkkk\r\nf\r\nsssssssssssssss\r\n0\r\n"
  assert_eq chunks(["nnnnnnnnnnnnnnnnnnnnnnnnnnn", "jjjjjjjj", "hhhhhhhhhhhhhhhh"]), "1b\r\nnnnnnnnnnnnnnnnnnnnnnnnnnnn\r\n8\r\njjjjjjjj\r\n10\r\nhhhhhhhhhhhhhhhh\r\n0\r\n"
  assert_eq chunks([]), "0\r\n"
  assert_eq chunks(["mmmmmmmmmmmmmmm"]), "f\r\nmmmmmmmmmmmmmmm\r\n0\r\n"
  assert_eq chunks(["iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii"]), "24\r\niiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii\r\n0\r\n"
  assert_eq chunks(["bbbbbbbbbbbbbbbbb", "llllllllllllllllllllllllllllllll"]), "11\r\nbbbbbbbbbbbbbbbbb\r\n20\r\nllllllllllllllllllllllllllllllll\r\n0\r\n"
  assert_eq chunks(["mmmmmm", "mmmmmmmm", "jjjjjjjjjjjjjjjjjjjjjjj"]), "6\r\nmmmmmm\r\n8\r\nmmmmmmmm\r\n17\r\njjjjjjjjjjjjjjjjjjjjjjj\r\n0\r\n"
  assert_eq chunks(["xxxxxxxxxxxxxxxxxxxxxxxxx", "ggggggggggggggggg"]), "19\r\nxxxxxxxxxxxxxxxxxxxxxxxxx\r\n11\r\nggggggggggggggggg\r\n0\r\n"
  assert_eq chunks(["qqqqqqqqqqqqqqqqqqqqq", "qqqqqqqqqqqqqqqqqqqqqq"]), "15\r\nqqqqqqqqqqqqqqqqqqqqq\r\n16\r\nqqqqqqqqqqqqqqqqqqqqqq\r\n0\r\n"
  assert_eq chunks(["iiiii", "mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm", "yyyyyyyyyyyyyyyyyyyyy"]), "5\r\niiiii\r\n27\r\nmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm\r\n15\r\nyyyyyyyyyyyyyyyyyyyyy\r\n0\r\n"
  assert_eq chunks(["lllllllllllllllll"]), "11\r\nlllllllllllllllll\r\n0\r\n"
  assert_eq chunks(["rrrrr", "hhhhhhhhhhhhhhhhhhhh"]), "5\r\nrrrrr\r\n14\r\nhhhhhhhhhhhhhhhhhhhh\r\n0\r\n"
  assert_eq chunks(["oooooooooooooooooo", "nnnnnnnn"]), "12\r\noooooooooooooooooo\r\n8\r\nnnnnnnnn\r\n0\r\n"
  assert_eq chunks(["bbbbbbbbbbbbbbbbbbbb", "kkkkkkkkkkkkkk", "mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm"]), "14\r\nbbbbbbbbbbbbbbbbbbbb\r\ne\r\nkkkkkkkkkkkkkk\r\n1f\r\nmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm\r\n0\r\n"
  assert_eq chunks(["rrrrrr", "eeeeeeeeeeeeeeeeeeeeeeeeee", "bbbbbbbbbbbbbbbbb"]), "6\r\nrrrrrr\r\n1a\r\neeeeeeeeeeeeeeeeeeeeeeeeee\r\n11\r\nbbbbbbbbbbbbbbbbb\r\n0\r\n"
  assert_eq chunks([""]), "0\r\n"
  assert_eq chunks(["gggggggggggggg"]), "e\r\ngggggggggggggg\r\n0\r\n"
  assert_eq chunks(["i", "dddddddddddddddddddd", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]), "1\r\ni\r\n14\r\ndddddddddddddddddddd\r\n1e\r\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n0\r\n"
  assert_eq chunks(["wwwwwwwwwwwwwwwwwwwwwwwwwwwww"]), "1d\r\nwwwwwwwwwwwwwwwwwwwwwwwwwwwww\r\n0\r\n"
  assert_eq chunks(["vvvvvvvvvvvvvvvvvvvvvvvvv", "iiiiiiiiiiiiiiiiiiiiiiiiiii", "ww"]), "19\r\nvvvvvvvvvvvvvvvvvvvvvvvvv\r\n1b\r\niiiiiiiiiiiiiiiiiiiiiiiiiii\r\n2\r\nww\r\n0\r\n"
  assert_eq chunks(["yyyyyyyyyyyyyyyyyyyy", "ooooooooooooooooooooooooooooo"]), "14\r\nyyyyyyyyyyyyyyyyyyyy\r\n1d\r\nooooooooooooooooooooooooooooo\r\n0\r\n"
  assert_eq chunks(["yyyyyyyyyyyyyyyyyyy"]), "13\r\nyyyyyyyyyyyyyyyyyyy\r\n0\r\n"
  assert_eq chunks(["zzzzzzzzzzzzzzzzzzzzz"]), "15\r\nzzzzzzzzzzzzzzzzzzzzz\r\n0\r\n"
  assert_eq chunks(["ffffffffffffffffff", "zzzzzzzzzzzzzzzzzzzzzzzzz"]), "12\r\nffffffffffffffffff\r\n19\r\nzzzzzzzzzzzzzzzzzzzzzzzzz\r\n0\r\n"
  assert_eq chunks(["ddddddddddddddddddddddddddddddddd", "aaaaaaaaaaaaaaaaaaaaaaa"]), "21\r\nddddddddddddddddddddddddddddddddd\r\n17\r\naaaaaaaaaaaaaaaaaaaaaaa\r\n0\r\n"
