  assert_eq dreq("HEAD", "/foo?bar", "HTTP/1.0", [("Transfer-Encoding", "chunked")], "", 0, ["chunked"], "", "/foo?bar", false), "HEAD /foo?bar HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("HEAD", "http://h:8080/p%20q", "HTTP/1.1", [("Content-Length", "10")], "hello world", 11, [], "", "", true), "HEAD /p%20q HTTP/1.1\r\nHost: h:8080\r\nContent-Length: 10\r\n\r\nhello world"
  assert_eq dreq("GET", "*", "HTTP/1.1", [], "abc", 3, [], "other.host:81", "", true), "GET * HTTP/1.1\r\nHost: other.host:81\r\n\r\nabc"
  assert_eq dreq("", "/", "HTTP/1.0", [("Content-Length", "chunked"), ("X-Foo", "a")], "abc", -1, [], "example.com", "", false), "GET / HTTP/1.0\r\nHost: example.com\r\nContent-Length: chunked\r\nX-Foo: a\r\n\r\n"
  assert_eq dreq("", "/foo", "HTTP/1.0", [], "hello world", 0, ["chunked"], "", "", true), "GET /foo HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
  assert_eq dreq("GET", "http://h:8080/p%20q", "HTTP/1.1", [("Trailer", "chunked"), ("Connection", "chunked")], "hello world", 11, [], "example.com", "", false), "GET /p%20q HTTP/1.1\r\nHost: example.com\r\nConnection: chunked\r\n\r\n"
  assert_eq dreq("HEAD", "http://h:8080/p%20q", "HTTP/1.0", [], "abc", -1, [], "", "http://h:8080/p%20q", true), "HEAD http://h:8080/p%20q HTTP/1.0\r\n\r\nabc"
  assert_eq dreq("", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [("Connection", "10"), ("Content-Type", "chunked"), ("Bad Key", "10")], "hello world", 11, [], "example.com", "http://example.com/a/b?x=1&y=2", true), "GET http://example.com/a/b?x=1&y=2 HTTP/1.1\r\nConnection: 10\r\nContent-Type: chunked\r\n\r\nhello world"
  assert_eq dreq("POST", "http://h:8080/p%20q", "HTTP/1.1", [("Trailer", "text/html"), ("User-Agent", "text/html"), ("Bad Key", "10")], "abc", 3, [], "other.host:81", "", false), "POST /p%20q HTTP/1.1\r\nHost: other.host:81\r\nUser-Agent: text/html\r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/", "HTTP/1.0", [("Content-Type", "10"), ("Transfer-Encoding", "two\nlines")], "abc", 0, ["chunked"], "other.host:81", "", false), "HEAD / HTTP/1.0\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nContent-Type: 10\r\n\r\n"
  assert_eq dreq("", "/foo", "HTTP/1.1", [("Accept", "chunked"), ("x-lower", "two\nlines")], "hello world", 11, [], "other.host:81", "/foo", true), "GET /foo HTTP/1.1\r\nHost: other.host:81\r\nAccept: chunked\r\nX-Lower: two lines\r\n\r\nhello world"
  assert_eq dreq("POST", "*", "HTTP/1.1", [], "abc", 0, [], "", "", true), "POST * HTTP/1.1\r\n\r\nabc"
  assert_eq dreq("POST", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("X-Foo", " spaced ")], "hello world", 0, ["chunked"], "example.com", "", false), "POST /a/b?x=1&y=2 HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nX-Foo: spaced\r\n\r\n"
  assert_eq dreq("GET", "/foo?bar", "HTTP/1.0", [("x-lower", "10")], "hello world", 11, [], "other.host:81", "/foo?bar", false), "GET /foo?bar HTTP/1.0\r\nHost: other.host:81\r\nX-Lower: 10\r\n\r\n"
  assert_eq dreq("GET", "/foo", "HTTP/1.1", [], "hello world", 11, [], "example.com", "", true), "GET /foo HTTP/1.1\r\nHost: example.com\r\n\r\nhello world"
  assert_eq dreq("POST", "http://h:8080/p%20q", "HTTP/1.0", [("Bad Key", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], "", "", true), "POST /p%20q HTTP/1.0\r\nHost: h:8080\r\nTransfer-Encoding: chunked\r\n\r\n28\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\r\n0\r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [], "abc", 0, [], "other.host:81", "", true), "HEAD /a/b?x=1&y=2 HTTP/1.0\r\nHost: other.host:81\r\n\r\nabc"
  assert_eq dreq("GET", "http://h:8080/p%20q", "HTTP/1.0", [("Accept", ""), ("Content-Type", "text/html"), ("x-lower", "close")], "hello world", -1, [], "other.host:81", "", true), "GET /p%20q HTTP/1.0\r\nHost: other.host:81\r\nAccept: \r\nContent-Type: text/html\r\nX-Lower: close\r\n\r\nhello world"
  assert_eq dreq("", "*", "HTTP/1.0", [], "abc", 3, ["chunked"], "other.host:81", "", false), "GET * HTTP/1.0\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("HEAD", "/foo?bar", "HTTP/1.0", [("X-Foo", "chunked"), ("Transfer-Encoding", " spaced "), ("Host", "text/html")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "example.com", "/foo?bar", false), "HEAD /foo?bar HTTP/1.0\r\nHost: example.com\r\nX-Foo: chunked\r\n\r\n"
  assert_eq dreq("", "/foo?bar", "HTTP/1.1", [("User-Agent", ""), ("X-Foo", "a")], "abc", -1, [], "example.com", "/foo?bar", false), "GET /foo?bar HTTP/1.1\r\nHost: example.com\r\nUser-Agent: \r\nX-Foo: a\r\n\r\n"
  assert_eq dreq("GET", "/foo", "HTTP/1.1", [("X-Foo", " spaced ")], "hello world", 0, ["chunked"], "other.host:81", "", true), "GET /foo HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nX-Foo: spaced\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
  assert_eq dreq("GET", "/foo?bar", "HTTP/1.0", [("Content-Length", "10")], "hello world", 11, [], "example.com", "", false), "GET /foo?bar HTTP/1.0\r\nHost: example.com\r\nContent-Length: 10\r\n\r\n"
  assert_eq dreq("PUT", "/foo", "HTTP/1.0", [("Connection", "chunked"), ("Content-Type", "close")], "abc", 3, [], "", "", true), "PUT /foo HTTP/1.0\r\nConnection: chunked\r\nContent-Type: close\r\n\r\nabc"
  assert_eq dreq("GET", "/foo", "HTTP/1.0", [("Host", "10"), ("Content-Type", "two\nlines")], "abc", -1, [], "", "/foo", true), "GET /foo HTTP/1.0\r\nContent-Type: two lines\r\n\r\nabc"
  assert_eq dreq("POST", "http://h:8080/p%20q", "HTTP/1.0", [], "", 0, [], "example.com", "http://h:8080/p%20q", true), "POST http://h:8080/p%20q HTTP/1.0\r\n\r\n"
  assert_eq dreq("HEAD", "http://h:8080/p%20q", "HTTP/1.1", [("Accept", " spaced "), ("Connection", "close"), ("X-Foo", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], "example.com", "http://h:8080/p%20q", false), "HEAD http://h:8080/p%20q HTTP/1.1\r\nAccept: spaced\r\nConnection: close\r\nX-Foo: a\r\n\r\n"
  assert_eq dreq("GET", "https://secure.example/x", "HTTP/1.1", [("Content-Length", "a"), ("x-lower", "two\nlines")], "abc", 0, [], "example.com", "", false), "GET /x HTTP/1.1\r\nHost: example.com\r\nContent-Length: a\r\nX-Lower: two lines\r\n\r\n"
  assert_eq dreq("PUT", "https://secure.example/x", "HTTP/1.0", [], "abc", 0, [], "example.com", "https://secure.example/x", true), "PUT https://secure.example/x HTTP/1.0\r\n\r\nabc"
  assert_eq dreq("POST", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("x-lower", ""), ("Content-Type", "")], "hello world", 0, [], "example.com", "", true), "POST /a/b?x=1&y=2 HTTP/1.0\r\nHost: example.com\r\nContent-Type: \r\nX-Lower: \r\n\r\nhello world"
  assert_eq dreq("", "/foo", "HTTP/1.0", [("Content-Length", "two\nlines")], "abc", -1, [], "example.com", "", false), "GET /foo HTTP/1.0\r\nHost: example.com\r\nContent-Length: two lines\r\n\r\n"
  assert_eq dreq("PUT", "http://h:8080/p%20q", "HTTP/1.1", [("Content-Type", "chunked"), ("Accept", "text/html")], "abc", 3, [], "other.host:81", "", false), "PUT /p%20q HTTP/1.1\r\nHost: other.host:81\r\nAccept: text/html\r\nContent-Type: chunked\r\n\r\n"
  assert_eq dreq("POST", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [], "", -1, [], "other.host:81", "http://example.com/a/b?x=1&y=2", true), "POST http://example.com/a/b?x=1&y=2 HTTP/1.1\r\n\r\n"
  assert_eq dreq("DELETE", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [], "abc", -1, ["chunked"], "example.com", "", false), "DELETE /a/b?x=1&y=2 HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("DELETE", "https://secure.example/x", "HTTP/1.0", [("Host", "a"), ("Content-Type", "10")], "", 0, ["chunked"], "", "", false), "DELETE /x HTTP/1.0\r\nHost: secure.example\r\nTransfer-Encoding: chunked\r\nContent-Type: 10\r\n\r\n"
  assert_eq dreq("HEAD", "/foo", "HTTP/1.1", [("Content-Type", "text/html"), ("Transfer-Encoding", "close"), ("X-Foo", "close")], "abc", 0, [], "other.host:81", "", false), "HEAD /foo HTTP/1.1\r\nHost: other.host:81\r\nContent-Type: text/html\r\nX-Foo: close\r\n\r\n"
  assert_eq dreq("", "https://secure.example/x", "HTTP/1.0", [("Transfer-Encoding", "close"), ("Connection", "close")], "hello world", 11, ["chunked"], "", "", false), "GET /x HTTP/1.0\r\nHost: secure.example\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n"
  assert_eq dreq("POST", "/foo?bar", "HTTP/1.1", [], "hello world", -1, ["chunked"], "other.host:81", "", false), "POST /foo?bar HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("GET", "/foo", "HTTP/1.0", [("Trailer", "a"), ("Trailer", "10")], "hello world", 0, [], "example.com", "/foo", false), "GET /foo HTTP/1.0\r\nHost: example.com\r\n\r\n"
  assert_eq dreq("DELETE", "/foo?bar", "HTTP/1.1", [], "hello world", 0, ["chunked"], "other.host:81", "/foo?bar", false), "DELETE /foo?bar HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("HEAD", "/foo", "HTTP/1.1", [("Bad Key", "close"), ("x-lower", " spaced "), ("Content-Length", "close")], "hello world", 0, ["chunked"], "example.com", "", true), "HEAD /foo HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: close\r\nX-Lower: spaced\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
  assert_eq dreq("GET", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [("Accept", ""), ("Accept", ""), ("User-Agent", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "other.host:81", "", true), "GET /a/b?x=1&y=2 HTTP/1.1\r\nHost: other.host:81\r\nAccept: \r\nAccept: \r\nUser-Agent: two lines\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("POST", "/", "HTTP/1.1", [("Content-Length", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], "example.com", "", false), "POST / HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: \r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [("Connection", "chunked")], "hello world", 11, [], "", "", false), "HEAD /a/b?x=1&y=2 HTTP/1.1\r\nHost: example.com\r\nConnection: chunked\r\n\r\n"
}

test "vectors: dump request 2" {
  assert_eq dreq("PUT", "/", "HTTP/1.0", [("Content-Type", " spaced ")], "abc", -1, ["chunked"], "example.com", "", false), "PUT / HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Type: spaced\r\n\r\n"
  assert_eq dreq("HEAD", "https://secure.example/x", "HTTP/1.0", [("User-Agent", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], "example.com", "https://secure.example/x", false), "HEAD https://secure.example/x HTTP/1.0\r\nUser-Agent: chunked\r\n\r\n"
  assert_eq dreq("POST", "http://example.com/", "HTTP/1.0", [("Content-Length", "two\nlines"), ("x-lower", "two\nlines")], "", 0, [], "", "", false), "POST / HTTP/1.0\r\nHost: example.com\r\nContent-Length: two lines\r\nX-Lower: two lines\r\n\r\n"
  assert_eq dreq("GET", "/foo?bar", "HTTP/1.1", [("Content-Length", "chunked")], "abc", 3, [], "", "", true), "GET /foo?bar HTTP/1.1\r\nContent-Length: chunked\r\n\r\nabc"
  assert_eq dreq("HEAD", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("x-lower", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "other.host:81", "", true), "HEAD /a/b?x=1&y=2 HTTP/1.0\r\nHost: other.host:81\r\nX-Lower: spaced\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("GET", "/foo?bar", "HTTP/1.1", [("Transfer-Encoding", "chunked")], "hello world", 11, [], "example.com", "", true), "GET /foo?bar HTTP/1.1\r\nHost: example.com\r\n\r\nhello world"
  assert_eq dreq("POST", "http://example.com/", "HTTP/1.0", [("Content-Length", ""), ("X-Foo", " spaced "), ("User-Agent", "close")], "hello world", 11, [], "example.com", "http://example.com/", false), "POST http://example.com/ HTTP/1.0\r\nContent-Length: \r\nUser-Agent: close\r\nX-Foo: spaced\r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("Content-Length", "a")], "", 0, [], "", "", false), "HEAD /a/b?x=1&y=2 HTTP/1.0\r\nHost: example.com\r\nContent-Length: a\r\n\r\n"
  assert_eq dreq("GET", "*", "HTTP/1.0", [("X-Foo", " spaced "), ("x-lower", "a")], "abc", 0, [], "", "", true), "GET * HTTP/1.0\r\nX-Foo: spaced\r\nX-Lower: a\r\n\r\nabc"
  assert_eq dreq("GET", "*", "HTTP/1.1", [("X-Foo", "text/html")], "abc", 3, [], "", "", true), "GET * HTTP/1.1\r\nX-Foo: text/html\r\n\r\nabc"
  assert_eq dreq("DELETE", "http://h:8080/p%20q", "HTTP/1.0", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "", "", true), "DELETE /p%20q HTTP/1.0\r\nHost: h:8080\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("DELETE", "https://secure.example/x", "HTTP/1.1", [("Accept", "two\nlines"), ("Content-Type", "two\nlines"), ("Content-Length", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], "example.com", "", true), "DELETE /x HTTP/1.1\r\nHost: example.com\r\nAccept: two lines\r\nContent-Length: two lines\r\nContent-Type: two lines\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("POST", "http://example.com/", "HTTP/1.0", [("Accept", "text/html"), ("Content-Length", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "example.com", "", false), "POST / HTTP/1.0\r\nHost: example.com\r\nAccept: text/html\r\nContent-Length: close\r\n\r\n"
  assert_eq dreq("PUT", "/foo", "HTTP/1.0", [("Transfer-Encoding", "10")], "hello world", 11, [], "", "", true), "PUT /foo HTTP/1.0\r\n\r\nhello world"
  assert_eq dreq("PUT", "/foo", "HTTP/1.0", [("Bad Key", "text/html"), ("Trailer", "10"), ("X-Foo", "two\nlines")], "abc", 3, [], "other.host:81", "", true), "PUT /foo HTTP/1.0\r\nHost: other.host:81\r\nX-Foo: two lines\r\n\r\nabc"
  assert_eq dreq("POST", "/foo", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "example.com", "", true), "POST /foo HTTP/1.1\r\nHost: example.com\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("GET", "/foo?bar", "HTTP/1.1", [("x-lower", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], "other.host:81", "/foo?bar", true), "GET /foo?bar HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nX-Lower: \r\n\r\n28\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\r\n0\r\n\r\n"
  assert_eq dreq("PUT", "https://secure.example/x", "HTTP/1.1", [("User-Agent", "chunked")], "", 0, [], "other.host:81", "https://secure.example/x", true), "PUT https://secure.example/x HTTP/1.1\r\nUser-Agent: chunked\r\n\r\n"
  assert_eq dreq("HEAD", "http://h:8080/p%20q", "HTTP/1.0", [("Content-Type", "10"), ("x-lower", "text/html")], "abc", 3, [], "other.host:81", "", true), "HEAD /p%20q HTTP/1.0\r\nHost: other.host:81\r\nContent-Type: 10\r\nX-Lower: text/html\r\n\r\nabc"
  assert_eq dreq("HEAD", "http://h:8080/p%20q", "HTTP/1.1", [("Host", "close"), ("Transfer-Encoding", "close")], "hello world", 11, ["chunked"], "other.host:81", "", true), "HEAD /p%20q HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
  assert_eq dreq("HEAD", "http://h:8080/p%20q", "HTTP/1.1", [], "abc", 3, ["chunked"], "other.host:81", "", true), "HEAD /p%20q HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dreq("DELETE", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("Host", "text/html")], "", 0, ["chunked"], "other.host:81", "", false), "DELETE /a/b?x=1&y=2 HTTP/1.0\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("GET", "*", "HTTP/1.1", [("Content-Length", ""), ("User-Agent", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "", "", true), "GET * HTTP/1.1\r\nContent-Length: \r\nUser-Agent: chunked\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("POST", "/foo?bar", "HTTP/1.1", [("Host", ""), ("Transfer-Encoding", "10")], "hello world", -1, [], "example.com", "/foo?bar", true), "POST /foo?bar HTTP/1.1\r\nHost: example.com\r\n\r\nhello world"
  assert_eq dreq("DELETE", "/foo", "HTTP/1.1", [("Accept", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, ["chunked"], "example.com", "/foo", false), "DELETE /foo HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nAccept: 10\r\n\r\n"
  assert_eq dreq("GET", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("Connection", "close"), ("x-lower", "close")], "hello world", 11, ["chunked"], "other.host:81", "", true), "GET /a/b?x=1&y=2 HTTP/1.0\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nConnection: close\r\nX-Lower: close\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
  assert_eq dreq("POST", "/", "HTTP/1.0", [("Content-Length", "chunked")], "abc", 3, [], "other.host:81", "", false), "POST / HTTP/1.0\r\nHost: other.host:81\r\nContent-Length: chunked\r\n\r\n"
  assert_eq dreq("DELETE", "*", "HTTP/1.1", [("Transfer-Encoding", "")], "hello world", 11, [], "example.com", "", false), "DELETE * HTTP/1.1\r\nHost: example.com\r\n\r\n"
  assert_eq dreq("PUT", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("Content-Type", "10")], "abc", 3, [], "example.com", "", false), "PUT /a/b?x=1&y=2 HTTP/1.0\r\nHost: example.com\r\nContent-Type: 10\r\n\r\n"
  assert_eq dreq("PUT", "/foo?bar", "HTTP/1.0", [("x-lower", " spaced ")], "abc", -1, ["chunked"], "other.host:81", "", false), "PUT /foo?bar HTTP/1.0\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nX-Lower: spaced\r\n\r\n"
  assert_eq dreq("DELETE", "http://h:8080/p%20q", "HTTP/1.1", [("Host", "two\nlines"), ("X-Foo", "close"), ("Accept", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, ["chunked"], "example.com", "", false), "DELETE /p%20q HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nAccept: spaced\r\nX-Foo: close\r\n\r\n"
  assert_eq dreq("PUT", "/", "HTTP/1.0", [("Connection", "chunked"), ("User-Agent", "")], "abc", 0, ["chunked"], "example.com", "", false), "PUT / HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nConnection: chunked\r\nUser-Agent: \r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/", "HTTP/1.1", [], "", 0, [], "other.host:81", "", true), "HEAD / HTTP/1.1\r\nHost: other.host:81\r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/", "HTTP/1.1", [("User-Agent", "a"), ("Trailer", "text/html"), ("Content-Length", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], "other.host:81", "", false), "HEAD / HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nContent-Length: spaced\r\nUser-Agent: a\r\n\r\n"
  assert_eq dreq("PUT", "http://h:8080/p%20q", "HTTP/1.1", [], "abc", -1, ["chunked"], "example.com", "", true), "PUT /p%20q HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dreq("HEAD", "/", "HTTP/1.0", [("Transfer-Encoding", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], "", "", false), "HEAD / HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("", "https://secure.example/x", "HTTP/1.1", [("x-lower", "10")], "", -1, ["chunked"], "", "", false), "GET /x HTTP/1.1\r\nHost: secure.example\r\nTransfer-Encoding: chunked\r\nX-Lower: 10\r\n\r\n"
  assert_eq dreq("HEAD", "*", "HTTP/1.0", [], "hello world", -1, [], "other.host:81", "", true), "HEAD * HTTP/1.0\r\nHost: other.host:81\r\n\r\nhello world"
  assert_eq dreq("DELETE", "http://example.com/", "HTTP/1.0", [("Trailer", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "example.com", "http://example.com/", true), "DELETE http://example.com/ HTTP/1.0\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("POST", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [("Host", "10"), ("Content-Type", "text/html")], "abc", 3, [], "example.com", "http://example.com/a/b?x=1&y=2", false), "POST http://example.com/a/b?x=1&y=2 HTTP/1.1\r\nContent-Type: text/html\r\n\r\n"
  assert_eq dreq("POST", "https://secure.example/x", "HTTP/1.1", [], "abc", 3, ["chunked"], "", "", false), "POST /x HTTP/1.1\r\nHost: secure.example\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("", "*", "HTTP/1.0", [("Transfer-Encoding", "text/html"), ("Content-Type", "chunked"), ("Connection", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "other.host:81", "", false), "GET * HTTP/1.0\r\nHost: other.host:81\r\nConnection: chunked\r\nContent-Type: chunked\r\n\r\n"
  assert_eq dreq("DELETE", "http://h:8080/p%20q", "HTTP/1.1", [("x-lower", "close"), ("Transfer-Encoding", "close"), ("X-Foo", "10")], "abc", 0, ["chunked"], "other.host:81", "http://h:8080/p%20q", false), "DELETE http://h:8080/p%20q HTTP/1.1\r\nTransfer-Encoding: chunked\r\nX-Foo: 10\r\nX-Lower: close\r\n\r\n"
  assert_eq dreq("PUT", "/foo?bar", "HTTP/1.1", [], "abc", -1, [], "", "", true), "PUT /foo?bar HTTP/1.1\r\n\r\nabc"
  assert_eq dreq("DELETE", "https://secure.example/x", "HTTP/1.0", [("Bad Key", "chunked"), ("Content-Length", ""), ("Transfer-Encoding", "chunked")], "hello world", -1, [], "example.com", "", true), "DELETE /x HTTP/1.0\r\nHost: example.com\r\nContent-Length: \r\n\r\nhello world"
  assert_eq dreq("PUT", "/foo?bar", "HTTP/1.0", [("Transfer-Encoding", "text/html"), ("Content-Length", "text/html")], "", 0, [], "other.host:81", "/foo?bar", false), "PUT /foo?bar HTTP/1.0\r\nHost: other.host:81\r\nContent-Length: text/html\r\n\r\n"
  assert_eq dreq("", "http://example.com/", "HTTP/1.0", [("Connection", "text/html"), ("x-lower", "two\nlines"), ("X-Foo", "chunked")], "hello world", -1, ["chunked"], "other.host:81", "http://example.com/", true), "GET http://example.com/ HTTP/1.0\r\nTransfer-Encoding: chunked\r\nConnection: text/html\r\nX-Foo: chunked\r\nX-Lower: two lines\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
  assert_eq dreq("GET", "*", "HTTP/1.1", [("Content-Length", "a")], "", 0, ["chunked"], "example.com", "", false), "GET * HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: a\r\n\r\n"
  assert_eq dreq("POST", "*", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "", "", false), "POST * HTTP/1.1\r\n\r\n"
  assert_eq dreq("GET", "http://example.com/", "HTTP/1.1", [("Trailer", "chunked")], "", 0, [], "", "http://example.com/", true), "GET http://example.com/ HTTP/1.1\r\n\r\n"
  assert_eq dreq("DELETE", "http://h:8080/p%20q", "HTTP/1.1", [], "hello world", 11, [], "", "http://h:8080/p%20q", false), "DELETE http://h:8080/p%20q HTTP/1.1\r\n\r\n"
  assert_eq dreq("", "https://secure.example/x", "HTTP/1.1", [], "hello world", 0, [], "", "https://secure.example/x", false), "GET https://secure.example/x HTTP/1.1\r\n\r\n"
  assert_eq dreq("GET", "http://h:8080/p%20q", "HTTP/1.1", [("User-Agent", " spaced "), ("Trailer", " spaced "), ("User-Agent", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "other.host:81", "http://h:8080/p%20q", true), "GET http://h:8080/p%20q HTTP/1.1\r\nUser-Agent: spaced\r\nUser-Agent: 10\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("POST", "*", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "", "", true), "POST * HTTP/1.1\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("DELETE", "http://example.com/", "HTTP/1.0", [("Content-Type", " spaced "), ("Bad Key", "close")], "abc", 3, [], "example.com", "", true), "DELETE / HTTP/1.0\r\nHost: example.com\r\nContent-Type: spaced\r\n\r\nabc"
  assert_eq dreq("", "/", "HTTP/1.1", [], "", 0, [], "", "/", true), "GET / HTTP/1.1\r\n\r\n"
  assert_eq dreq("GET", "https://secure.example/x", "HTTP/1.0", [("X-Foo", "two\nlines"), ("Bad Key", "10"), ("Content-Length", "10")], "", -1, ["chunked"], "example.com", "", true), "GET /x HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 10\r\nX-Foo: two lines\r\n\r\n"
  assert_eq dreq("POST", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [("Connection", "a")], "abc", 0, [], "", "", true), "POST /a/b?x=1&y=2 HTTP/1.1\r\nHost: example.com\r\nConnection: a\r\n\r\nabc"
  assert_eq dreq("HEAD", "http://h:8080/p%20q", "HTTP/1.1", [], "abc", 3, [], "", "", true), "HEAD /p%20q HTTP/1.1\r\nHost: h:8080\r\n\r\nabc"
  assert_eq dreq("HEAD", "/foo", "HTTP/1.0", [("Content-Length", "two\nlines")], "abc", 3, ["chunked"], "example.com", "", true), "HEAD /foo HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: two lines\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dreq("GET", "/foo", "HTTP/1.1", [], "abc", 0, ["chunked"], "", "/foo", true), "GET /foo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dreq("POST", "https://secure.example/x", "HTTP/1.1", [("x-lower", " spaced "), ("Transfer-Encoding", "close"), ("x-lower", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "example.com", "https://secure.example/x", true), "POST https://secure.example/x HTTP/1.1\r\nX-Lower: spaced\r\nX-Lower: spaced\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("PUT", "http://h:8080/p%20q", "HTTP/1.1", [], "hello world", 11, [], "", "http://h:8080/p%20q", false), "PUT http://h:8080/p%20q HTTP/1.1\r\n\r\n"
  assert_eq dreq("GET", "/foo", "HTTP/1.1", [("X-Foo", "chunked")], "", 0, [], "other.host:81", "", true), "GET /foo HTTP/1.1\r\nHost: other.host:81\r\nX-Foo: chunked\r\n\r\n"
  assert_eq dreq("GET", "/", "HTTP/1.0", [], "hello world", -1, [], "", "", false), "GET / HTTP/1.0\r\n\r\n"
  assert_eq dreq("DELETE", "http://example.com/", "HTTP/1.1", [("x-lower", "10"), ("Connection", "two\nlines"), ("x-lower", "chunked")], "hello world", -1, [], "example.com", "", false), "DELETE / HTTP/1.1\r\nHost: example.com\r\nConnection: two lines\r\nX-Lower: 10\r\nX-Lower: chunked\r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("Bad Key", " spaced ")], "abc", -1, [], "other.host:81", "", false), "HEAD /a/b?x=1&y=2 HTTP/1.0\r\nHost: other.host:81\r\n\r\n"
  assert_eq dreq("", "/", "HTTP/1.1", [("X-Foo", "close")], "hello world", 11, [], "", "/", false), "GET / HTTP/1.1\r\nX-Foo: close\r\n\r\n"
  assert_eq dreq("DELETE", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [("Accept", "text/html")], "", 0, [], "other.host:81", "", true), "DELETE /a/b?x=1&y=2 HTTP/1.1\r\nHost: other.host:81\r\nAccept: text/html\r\n\r\n"
  assert_eq dreq("GET", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [("Content-Length", "10")], "", 0, ["chunked"], "", "", true), "GET /a/b?x=1&y=2 HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 10\r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/", "HTTP/1.1", [("User-Agent", "a")], "hello world", 0, [], "example.com", "", true), "HEAD / HTTP/1.1\r\nHost: example.com\r\nUser-Agent: a\r\n\r\nhello world"
  assert_eq dreq("DELETE", "*", "HTTP/1.0", [("Transfer-Encoding", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "example.com", "*", false), "DELETE * HTTP/1.0\r\nHost: example.com\r\n\r\n"
  assert_eq dreq("PUT", "http://example.com/", "HTTP/1.0", [("x-lower", " spaced "), ("User-Agent", "a")], "", -1, [], "", "", false), "PUT / HTTP/1.0\r\nHost: example.com\r\nUser-Agent: a\r\nX-Lower: spaced\r\n\r\n"
  assert_eq dreq("GET", "/foo", "HTTP/1.1", [], "", -1, ["chunked"], "example.com", "", true), "GET /foo HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("PUT", "/foo", "HTTP/1.0", [("Bad Key", "close"), ("Transfer-Encoding", "chunked")], "abc", 3, [], "", "", false), "PUT /foo HTTP/1.0\r\n\r\n"
  assert_eq dreq("POST", "https://secure.example/x", "HTTP/1.1", [("Content-Length", "10")], "abc", -1, [], "other.host:81", "", false), "POST /x HTTP/1.1\r\nHost: other.host:81\r\nContent-Length: 10\r\n\r\n"
  assert_eq dreq("HEAD", "https://secure.example/x", "HTTP/1.0", [("X-Foo", "close"), ("Content-Type", "text/html")], "", 0, ["chunked"], "example.com", "", false), "HEAD /x HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Type: text/html\r\nX-Foo: close\r\n\r\n"
  assert_eq dreq("DELETE", "/foo", "HTTP/1.0", [("X-Foo", "text/html"), ("Content-Length", "close"), ("Bad Key", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "", "", true), "DELETE /foo HTTP/1.0\r\nContent-Length: close\r\nX-Foo: text/html\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("POST", "*", "HTTP/1.0", [("Trailer", "chunked")], "abc", 0, ["chunked"], "example.com", "*", true), "POST * HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dreq("POST", "http://example.com/", "HTTP/1.1", [], "hello world", 11, [], "other.host:81", "http://example.com/", false), "POST http://example.com/ HTTP/1.1\r\n\r\n"
  assert_eq dreq("PUT", "http://h:8080/p%20q", "HTTP/1.1", [("x-lower", ""), ("Content-Length", "10")], "hello world", 0, [], "", "http://h:8080/p%20q", false), "PUT http://h:8080/p%20q HTTP/1.1\r\nContent-Length: 10\r\nX-Lower: \r\n\r\n"
  assert_eq dreq("PUT", "http://h:8080/p%20q", "HTTP/1.0", [("Content-Length", "two\nlines"), ("User-Agent", "chunked")], "", 0, [], "other.host:81", "", true), "PUT /p%20q HTTP/1.0\r\nHost: other.host:81\r\nContent-Length: two lines\r\nUser-Agent: chunked\r\n\r\n"
  assert_eq dreq("HEAD", "https://secure.example/x", "HTTP/1.0", [("Bad Key", "10"), ("Content-Type", " spaced "), ("Host", "a")], "", 0, [], "", "https://secure.example/x", false), "HEAD https://secure.example/x HTTP/1.0\r\nContent-Type: spaced\r\n\r\n"
  assert_eq dreq("POST", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [], "abc", 0, ["chunked"], "example.com", "", true), "POST /a/b?x=1&y=2 HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dreq("GET", "*", "HTTP/1.0", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], "example.com", "", false), "GET * HTTP/1.0\r\nHost: example.com\r\n\r\n"
  assert_eq dreq("POST", "/foo", "HTTP/1.1", [("x-lower", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, ["chunked"], "other.host:81", "", false), "POST /foo HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nX-Lower: chunked\r\n\r\n"
  assert_eq dreq("", "http://h:8080/p%20q", "HTTP/1.1", [], "abc", -1, [], "", "", true), "GET /p%20q HTTP/1.1\r\nHost: h:8080\r\n\r\nabc"
  assert_eq dreq("POST", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("x-lower", "close"), ("Host", "text/html"), ("X-Foo", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "example.com", "http://example.com/a/b?x=1&y=2", false), "POST http://example.com/a/b?x=1&y=2 HTTP/1.0\r\nX-Foo: spaced\r\nX-Lower: close\r\n\r\n"
  assert_eq dreq("PUT", "https://secure.example/x", "HTTP/1.1", [("x-lower", " spaced "), ("User-Agent", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "other.host:81", "", false), "PUT /x HTTP/1.1\r\nHost: other.host:81\r\nUser-Agent: two lines\r\nX-Lower: spaced\r\n\r\n"
  assert_eq dreq("GET", "/foo", "HTTP/1.1", [("User-Agent", "a"), ("Connection", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "", "", false), "GET /foo HTTP/1.1\r\nConnection: close\r\nUser-Agent: a\r\n\r\n"
  assert_eq dreq("GET", "http://example.com/", "HTTP/1.1", [("Content-Type", ""), ("x-lower", " spaced "), ("User-Agent", "a")], "abc", -1, [], "other.host:81", "http://example.com/", false), "GET http://example.com/ HTTP/1.1\r\nContent-Type: \r\nUser-Agent: a\r\nX-Lower: spaced\r\n\r\n"
  assert_eq dreq("DELETE", "http://example.com/", "HTTP/1.1", [("Accept", "text/html"), ("Connection", ""), ("Transfer-Encoding", "a")], "", 0, [], "", "http://example.com/", true), "DELETE http://example.com/ HTTP/1.1\r\nAccept: text/html\r\nConnection: \r\n\r\n"
  assert_eq dreq("PUT", "http://h:8080/p%20q", "HTTP/1.1", [("X-Foo", "close"), ("Connection", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], "example.com", "", false), "PUT /p%20q HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nConnection: spaced\r\nX-Foo: close\r\n\r\n"
  assert_eq dreq("POST", "/foo", "HTTP/1.0", [("X-Foo", "10"), ("x-lower", "a"), ("x-lower", "")], "abc", -1, [], "", "/foo", true), "POST /foo HTTP/1.0\r\nX-Foo: 10\r\nX-Lower: a\r\nX-Lower: \r\n\r\nabc"
  assert_eq dreq("POST", "https://secure.example/x", "HTTP/1.1", [("Content-Type", "two\nlines")], "abc", 3, [], "", "https://secure.example/x", true), "POST https://secure.example/x HTTP/1.1\r\nContent-Type: two lines\r\n\r\nabc"
  assert_eq dreq("HEAD", "/foo", "HTTP/1.0", [("X-Foo", "two\nlines"), ("Host", "10")], "", 0, [], "", "/foo", false), "HEAD /foo HTTP/1.0\r\nX-Foo: two lines\r\n\r\n"
  assert_eq dreq("DELETE", "http://h:8080/p%20q", "HTTP/1.1", [("Accept", "10"), ("Host", "10")], "abc", -1, ["chunked"], "example.com", "", true), "DELETE /p%20q HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nAccept: 10\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dreq("", "http://example.com/", "HTTP/1.1", [("x-lower", "10"), ("Content-Type", "10")], "", 0, [], "example.com", "", false), "GET / HTTP/1.1\r\nHost: example.com\r\nContent-Type: 10\r\nX-Lower: 10\r\n\r\n"
  assert_eq dreq("PUT", "http://example.com/", "HTTP/1.0", [("Trailer", "10"), ("X-Foo", "text/html")], "hello world", 0, ["chunked"], "example.com", "", true), "PUT / HTTP/1.0\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nX-Foo: text/html\r\n\r\nb\r\nhello world\r\n0\r\n\r\n"
  assert_eq dreq("", "https://secure.example/x", "HTTP/1.1", [("Host", "10"), ("X-Foo", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "other.host:81", "", false), "GET /x HTTP/1.1\r\nHost: other.host:81\r\nX-Foo: \r\n\r\n"
}

test "vectors: dump request 3" {
  assert_eq dreq("GET", "http://h:8080/p%20q", "HTTP/1.0", [("Transfer-Encoding", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "other.host:81", "", false), "GET /p%20q HTTP/1.0\r\nHost: other.host:81\r\n\r\n"
  assert_eq dreq("PUT", "/foo?bar", "HTTP/1.1", [("Host", "10"), ("Connection", "two\nlines")], "", 0, [], "", "/foo?bar", false), "PUT /foo?bar HTTP/1.1\r\nConnection: two lines\r\n\r\n"
  assert_eq dreq("POST", "*", "HTTP/1.0", [("Host", "text/html"), ("Content-Type", "10")], "hello world", 11, [], "other.host:81", "*", false), "POST * HTTP/1.0\r\nHost: other.host:81\r\nContent-Type: 10\r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "", "", true), "HEAD /a/b?x=1&y=2 HTTP/1.1\r\nHost: example.com\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("PUT", "*", "HTTP/1.0", [], "", 0, ["chunked"], "other.host:81", "", false), "PUT * HTTP/1.0\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("", "/foo", "HTTP/1.0", [], "hello world", 11, [], "example.com", "/foo", false), "GET /foo HTTP/1.0\r\nHost: example.com\r\n\r\n"
  assert_eq dreq("POST", "/foo?bar", "HTTP/1.1", [("Content-Length", " spaced "), ("x-lower", "two\nlines"), ("Bad Key", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "", "", false), "POST /foo?bar HTTP/1.1\r\nContent-Length: spaced\r\nX-Lower: two lines\r\n\r\n"
  assert_eq dreq("DELETE", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("Accept", "two\nlines"), ("X-Foo", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "example.com", "", false), "DELETE /a/b?x=1&y=2 HTTP/1.0\r\nHost: example.com\r\nAccept: two lines\r\nX-Foo: two lines\r\n\r\n"
  assert_eq dreq("PUT", "/foo", "HTTP/1.1", [("X-Foo", "two\nlines"), ("Content-Length", "chunked"), ("Transfer-Encoding", "a")], "", -1, ["chunked"], "other.host:81", "/foo", true), "PUT /foo HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nContent-Length: chunked\r\nX-Foo: two lines\r\n\r\n"
  assert_eq dreq("PUT", "http://example.com/", "HTTP/1.1", [("Content-Type", "10"), ("X-Foo", ""), ("Trailer", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "example.com", "http://example.com/", true), "PUT http://example.com/ HTTP/1.1\r\nContent-Type: 10\r\nX-Foo: \r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("", "/", "HTTP/1.1", [], "abc", 0, [], "example.com", "", false), "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n"
  assert_eq dreq("HEAD", "/foo", "HTTP/1.1", [("Content-Length", "text/html")], "abc", 0, [], "other.host:81", "/foo", false), "HEAD /foo HTTP/1.1\r\nHost: other.host:81\r\nContent-Length: text/html\r\n\r\n"
