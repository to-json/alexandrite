  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [("Content-Length", "10"), ("Host", "")], "hello world", 11, [], false, "GET", true), "HTTP/1.1 500 Custom Text\r\nContent-Length: 11\r\nHost: \r\n\r\nhello world"
  assert_eq dresp(200, "", "HTTP/1.1", [("X-Foo", " spaced "), ("Content-Type", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "HEAD", false), "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: spaced\r\nX-Foo: spaced\r\n\r\n"
