  assert_eq dreq("PUT", "/foo", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], "", "/foo", true), "PUT /foo HTTP/1.1\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("", "http://h:8080/p%20q", "HTTP/1.0", [("Content-Type", " spaced ")], "abc", 0, [], "other.host:81", "", true), "GET /p%20q HTTP/1.0\r\nHost: other.host:81\r\nContent-Type: spaced\r\n\r\nabc"
  assert_eq dreq("DELETE", "https://secure.example/x", "HTTP/1.0", [("X-Foo", "a"), ("Content-Length", ""), ("Accept", "10")], "", 0, [], "other.host:81", "https://secure.example/x", false), "DELETE https://secure.example/x HTTP/1.0\r\nAccept: 10\r\nContent-Length: \r\nX-Foo: a\r\n\r\n"
  assert_eq dreq("HEAD", "/foo?bar", "HTTP/1.1", [], "hello world", 0, [], "example.com", "", false), "HEAD /foo?bar HTTP/1.1\r\nHost: example.com\r\n\r\n"
  assert_eq dreq("DELETE", "/foo", "HTTP/1.1", [], "abc", -1, [], "example.com", "/foo", false), "DELETE /foo HTTP/1.1\r\nHost: example.com\r\n\r\n"
  assert_eq dreq("POST", "*", "HTTP/1.0", [("Transfer-Encoding", "a"), ("Host", " spaced ")], "", 0, [], "other.host:81", "", false), "POST * HTTP/1.0\r\nHost: other.host:81\r\n\r\n"
  assert_eq dreq("PUT", "/", "HTTP/1.1", [("Content-Type", "10"), ("Connection", "two\nlines")], "abc", 3, [], "example.com", "/", true), "PUT / HTTP/1.1\r\nHost: example.com\r\nConnection: two lines\r\nContent-Type: 10\r\n\r\nabc"
  assert_eq dreq("GET", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [("x-lower", "text/html")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "other.host:81", "", false), "GET /a/b?x=1&y=2 HTTP/1.1\r\nHost: other.host:81\r\nX-Lower: text/html\r\n\r\n"
  assert_eq dreq("GET", "*", "HTTP/1.0", [], "hello world", 0, [], "other.host:81", "", true), "GET * HTTP/1.0\r\nHost: other.host:81\r\n\r\nhello world"
  assert_eq dreq("POST", "http://h:8080/p%20q", "HTTP/1.0", [], "", 0, [], "example.com", "http://h:8080/p%20q", false), "POST http://h:8080/p%20q HTTP/1.0\r\n\r\n"
  assert_eq dreq("POST", "http://h:8080/p%20q", "HTTP/1.1", [("Host", "chunked"), ("Connection", " spaced "), ("Content-Length", "close")], "abc", 3, ["chunked"], "other.host:81", "http://h:8080/p%20q", true), "POST http://h:8080/p%20q HTTP/1.1\r\nTransfer-Encoding: chunked\r\nConnection: spaced\r\nContent-Length: close\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dreq("PUT", "*", "HTTP/1.1", [("Connection", ""), ("User-Agent", "10"), ("Transfer-Encoding", "")], "hello world", 11, [], "other.host:81", "*", false), "PUT * HTTP/1.1\r\nHost: other.host:81\r\nConnection: \r\nUser-Agent: 10\r\n\r\n"
  assert_eq dreq("POST", "http://h:8080/p%20q", "HTTP/1.1", [], "", 0, [], "", "", true), "POST /p%20q HTTP/1.1\r\nHost: h:8080\r\n\r\n"
  assert_eq dreq("PUT", "https://secure.example/x", "HTTP/1.1", [("User-Agent", ""), ("Content-Length", "10")], "abc", -1, ["chunked"], "example.com", "", true), "PUT /x HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 10\r\nUser-Agent: \r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dreq("PUT", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], "other.host:81", "", false), "PUT /a/b?x=1&y=2 HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dreq("POST", "http://example.com/", "HTTP/1.0", [("Host", "chunked"), ("Bad Key", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "other.host:81", "http://example.com/", true), "POST http://example.com/ HTTP/1.0\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("DELETE", "/foo?bar", "HTTP/1.0", [("Connection", "chunked"), ("x-lower", "text/html")], "abc", 3, [], "", "", false), "DELETE /foo?bar HTTP/1.0\r\nConnection: chunked\r\nX-Lower: text/html\r\n\r\n"
  assert_eq dreq("DELETE", "/foo", "HTTP/1.0", [("Content-Type", "10"), ("Connection", "")], "abc", 0, [], "", "", false), "DELETE /foo HTTP/1.0\r\nConnection: \r\nContent-Type: 10\r\n\r\n"
  assert_eq dreq("", "/foo", "HTTP/1.0", [], "", 0, [], "", "", true), "GET /foo HTTP/1.0\r\n\r\n"
  assert_eq dreq("PUT", "http://h:8080/p%20q", "HTTP/1.1", [], "hello world", 11, [], "other.host:81", "", false), "PUT /p%20q HTTP/1.1\r\nHost: other.host:81\r\n\r\n"
  assert_eq dreq("", "http://example.com/", "HTTP/1.0", [], "", 0, [], "other.host:81", "", false), "GET / HTTP/1.0\r\nHost: other.host:81\r\n\r\n"
}

test "vectors: dump request 1" {
  assert_eq dreq("", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("X-Foo", "a")], "", 0, ["chunked"], "other.host:81", "", true), "GET /a/b?x=1&y=2 HTTP/1.0\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nX-Foo: a\r\n\r\n"
  assert_eq dreq("POST", "*", "HTTP/1.1", [("Content-Length", "two\nlines"), ("User-Agent", "a"), ("Trailer", "a")], "", 0, ["chunked"], "example.com", "", true), "POST * HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: two lines\r\nUser-Agent: a\r\n\r\n"
  assert_eq dreq("DELETE", "http://example.com/", "HTTP/1.1", [("X-Foo", "chunked"), ("Accept", "text/html")], "hello world", 11, [], "", "", false), "DELETE / HTTP/1.1\r\nHost: example.com\r\nAccept: text/html\r\nX-Foo: chunked\r\n\r\n"
  assert_eq dreq("", "https://secure.example/x", "HTTP/1.1", [("Host", "a"), ("X-Foo", "a")], "", 0, ["chunked"], "other.host:81", "", true), "GET /x HTTP/1.1\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nX-Foo: a\r\n\r\n"
  assert_eq dreq("DELETE", "http://h:8080/p%20q", "HTTP/1.0", [("Bad Key", "a"), ("Trailer", "a"), ("User-Agent", "text/html")], "abc", 3, [], "other.host:81", "", true), "DELETE /p%20q HTTP/1.0\r\nHost: other.host:81\r\nUser-Agent: text/html\r\n\r\nabc"
  assert_eq dreq("DELETE", "http://h:8080/p%20q", "HTTP/1.0", [("Accept", "10"), ("User-Agent", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], "example.com", "http://h:8080/p%20q", true), "DELETE http://h:8080/p%20q HTTP/1.0\r\nAccept: 10\r\nUser-Agent: 10\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("POST", "http://example.com/", "HTTP/1.0", [("Trailer", "10"), ("X-Foo", " spaced "), ("Connection", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], "other.host:81", "", true), "POST / HTTP/1.0\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nConnection: close\r\nX-Foo: spaced\r\n\r\n28\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\r\n0\r\n\r\n"
  assert_eq dreq("PUT", "/", "HTTP/1.0", [("Accept", "chunked")], "abc", -1, ["chunked"], "", "", false), "PUT / HTTP/1.0\r\nTransfer-Encoding: chunked\r\nAccept: chunked\r\n\r\n"
  assert_eq dreq("PUT", "*", "HTTP/1.0", [("Host", "two\nlines"), ("Content-Length", "two\nlines")], "", -1, [], "example.com", "*", true), "PUT * HTTP/1.0\r\nHost: example.com\r\nContent-Length: two lines\r\n\r\n"
  assert_eq dreq("", "http://example.com/", "HTTP/1.0", [], "hello world", 0, [], "", "", true), "GET / HTTP/1.0\r\nHost: example.com\r\n\r\nhello world"
  assert_eq dreq("GET", "/", "HTTP/1.0", [("Content-Length", " spaced "), ("User-Agent", "text/html")], "", 0, [], "other.host:81", "", false), "GET / HTTP/1.0\r\nHost: other.host:81\r\nContent-Length: spaced\r\nUser-Agent: text/html\r\n\r\n"
  assert_eq dreq("DELETE", "http://h:8080/p%20q", "HTTP/1.1", [("x-lower", "a"), ("Accept", "")], "abc", -1, ["chunked"], "other.host:81", "http://h:8080/p%20q", false), "DELETE http://h:8080/p%20q HTTP/1.1\r\nTransfer-Encoding: chunked\r\nAccept: \r\nX-Lower: a\r\n\r\n"
  assert_eq dreq("", "http://example.com/a/b?x=1&y=2", "HTTP/1.0", [("Accept", "a"), ("Host", "close"), ("Trailer", "text/html")], "", 0, [], "", "", false), "GET /a/b?x=1&y=2 HTTP/1.0\r\nHost: example.com\r\nAccept: a\r\n\r\n"
  assert_eq dreq("DELETE", "http://example.com/", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], "other.host:81", "http://example.com/", true), "DELETE http://example.com/ HTTP/1.1\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dreq("HEAD", "http://h:8080/p%20q", "HTTP/1.0", [("User-Agent", " spaced "), ("Trailer", "10"), ("User-Agent", "a")], "", -1, [], "other.host:81", "", true), "HEAD /p%20q HTTP/1.0\r\nHost: other.host:81\r\nUser-Agent: spaced\r\nUser-Agent: a\r\n\r\n"
  assert_eq dreq("HEAD", "http://example.com/", "HTTP/1.1", [("Trailer", "a")], "abc", 3, [], "other.host:81", "", false), "HEAD / HTTP/1.1\r\nHost: other.host:81\r\n\r\n"
  assert_eq dreq("DELETE", "/foo", "HTTP/1.1", [("Host", "text/html"), ("Connection", "chunked")], "hello world", -1, ["chunked"], "example.com", "", false), "DELETE /foo HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nConnection: chunked\r\n\r\n"
  assert_eq dreq("DELETE", "/foo", "HTTP/1.1", [("x-lower", "chunked"), ("Accept", "text/html"), ("Trailer", " spaced ")], "hello world", -1, [], "example.com", "/foo", false), "DELETE /foo HTTP/1.1\r\nHost: example.com\r\nAccept: text/html\r\nX-Lower: chunked\r\n\r\n"
