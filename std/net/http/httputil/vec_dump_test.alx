  assert_eq dreq("DELETE", "/foo", "HTTP/1.1", [("Transfer-Encoding", "close")], "", -1, [], "other.host:81", "/foo", true), "DELETE /foo HTTP/1.1\r\nHost: other.host:81\r\n\r\n"
