  assert_eq dresp(101, "", "HTTP/1.1", [("X-Foo", " spaced ")], "abc", 3, [], false, "GET", true), "HTTP/1.1 101 Switching Protocols\r\nContent-Length: 3\r\nX-Foo: spaced\r\n\r\nabc"
  assert_eq dresp(500, "Custom Text", "HTTP/1.0", [("X-Foo", "close"), ("X-Foo", "two\nlines")], "", 0, [], true, "HEAD", false), "HTTP/1.0 500 Custom Text\r\nConnection: close\r\nX-Foo: close\r\nX-Foo: two lines\r\nContent-Length: 0\r\n\r\n"
