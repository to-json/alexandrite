  assert_eq dresp(200, "200 OK", "HTTP/1.0", [("Transfer-Encoding", " spaced "), ("Host", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 30, [], false, "HEAD", true), "HTTP/1.0 200 OK\r\nContent-Length: 30\r\nHost: a\r\n\r\n"
  assert_eq dresp(101, "", "HTTP/1.0", [("User-Agent", "text/html"), ("User-Agent", "chunked")], "", 0, ["chunked"], false, "HEAD", false), "HTTP/1.0 101 Switching Protocols\r\nTransfer-Encoding: chunked\r\nUser-Agent: text/html\r\nUser-Agent: chunked\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [("Host", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "HEAD", true), "HTTP/1.1 007 200 OK\r\nContent-Length: 40\r\nHost: two lines\r\n\r\n"
  assert_eq dresp(304, "", "HTTP/1.1", [], "hello world", -1, [], false, "GET", true), "HTTP/1.1 304 Not Modified\r\nConnection: close\r\n\r\nhello world"
  assert_eq dresp(204, "", "HTTP/1.1", [("Transfer-Encoding", "text/html"), ("Trailer", ""), ("x-lower", "")], "", 0, ["chunked"], true, "HEAD", true), "HTTP/1.1 204 No Content\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nX-Lower: \r\n\r\n"
