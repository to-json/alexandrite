  assert_eq dresp(101, "", "HTTP/1.1", [("X-Foo", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "GET", false), "HTTP/1.1 101 Switching Protocols\r\nConnection: close\r\nX-Foo: \r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.0", [], "abc", 3, [], false, "HEAD", true), "HTTP/1.0 204 200 OK\r\nContent-Length: 3\r\n\r\n"
  assert_eq dresp(200, "", "HTTP/1.0", [("Host", ""), ("Content-Length", "text/html"), ("X-Foo", " spaced ")], "abc", 3, [], false, "POST", true), "HTTP/1.0 200 OK\r\nContent-Length: 3\r\nHost: \r\nX-Foo: spaced\r\n\r\nabc"
  assert_eq dresp(404, "Custom Text", "HTTP/1.0", [("Content-Length", "two\nlines"), ("x-lower", "text/html")], "abc", -1, ["chunked"], false, "HEAD", true), "HTTP/1.0 404 Custom Text\r\nTransfer-Encoding: chunked\r\nX-Lower: text/html\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.0", [("Connection", "10"), ("Bad Key", "text/html")], "", 0, ["chunked"], true, "GET", false), "HTTP/1.0 500 Internal Server Error\r\nConnection: close\r\nConnection: 10\r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.1", [("Host", "text/html"), ("x-lower", "chunked"), ("Connection", "close")], "abc", -1, [], false, "GET", false), "HTTP/1.1 204 No Content\r\nConnection: close\r\nHost: text/html\r\nX-Lower: chunked\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.0", [], "abc", 3, [], false, "GET", false), "HTTP/1.0 101 200 OK\r\nContent-Length: 3\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [], "", -1, [], true, "GET", true), "HTTP/1.1 007 200 OK\r\nConnection: close\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.0", [("Content-Length", "text/html"), ("Content-Type", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], false, "GET", false), "HTTP/1.0 007 200 OK\r\nContent-Type: 10\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.0", [], "hello world", 11, [], false, "HEAD", false), "HTTP/1.0 204 No Content\r\nContent-Length: 11\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.0", [("Accept", " spaced "), ("Transfer-Encoding", "10"), ("Host", "text/html")], "abc", 0, [], false, "GET", false), "HTTP/1.0 101 200 OK\r\nAccept: spaced\r\nHost: text/html\r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.0", [("Connection", "a"), ("Accept", "two\nlines")], "hello world", 3, [], false, "HEAD", false), "HTTP/1.0 204 200 OK\r\nContent-Length: 3\r\nAccept: two lines\r\nConnection: a\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.0", [("User-Agent", "two\nlines")], "", -1, ["chunked"], true, "GET", false), "HTTP/1.0 404 Not Found\r\nConnection: close\r\nUser-Agent: two lines\r\n\r\n"
  assert_eq dresp(101, "", "HTTP/1.0", [("Trailer", "text/html"), ("X-Foo", "a"), ("X-Foo", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], true, "GET", false), "HTTP/1.0 101 Switching Protocols\r\nConnection: close\r\nX-Foo: a\r\nX-Foo: a\r\n\r\n"
  assert_eq dresp(101, "Custom Text", "HTTP/1.1", [("Trailer", "chunked"), ("Content-Length", "a")], "", 0, ["chunked"], false, "HEAD", false), "HTTP/1.1 101 Custom Text\r\nTransfer-Encoding: chunked\r\n\r\n"
  assert_eq dresp(304, "", "HTTP/1.1", [("Trailer", "")], "abc", 0, [], false, "POST", true), "HTTP/1.1 304 Not Modified\r\nConnection: close\r\n\r\nabc"
  assert_eq dresp(404, "200 OK", "HTTP/1.0", [("Trailer", "chunked"), ("User-Agent", "a")], "hello world", 0, [], false, "POST", false), "HTTP/1.0 404 200 OK\r\nContent-Length: 0\r\nUser-Agent: a\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.1", [("Accept", "text/html"), ("Host", " spaced "), ("X-Foo", "chunked")], "", 23, [], false, "POST", false), "HTTP/1.1 500 200 OK\r\nContent-Length: 23\r\nAccept: text/html\r\nHost: spaced\r\nX-Foo: chunked\r\n\r\n"
  assert_eq dresp(101, "", "HTTP/1.0", [("Content-Length", "")], "", 49, [], true, "GET", false), "HTTP/1.0 101 Switching Protocols\r\nConnection: close\r\nContent-Length: 49\r\n\r\n"
  assert_eq dresp(200, "200 OK", "HTTP/1.0", [("Connection", "chunked"), ("Trailer", ""), ("User-Agent", "a")], "abc", 0, ["chunked"], false, "HEAD", true), "HTTP/1.0 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: chunked\r\nUser-Agent: a\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Content-Length", "a")], "", 13, ["chunked"], false, "GET", true), "HTTP/1.1 304 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"
  assert_eq dresp(101, "", "HTTP/1.0", [("Host", "close"), ("Host", "two\nlines"), ("X-Foo", "a")], "abc", 30, ["chunked"], false, "POST", true), "ERR http: ContentLength=30 with Body length 3"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Trailer", "chunked"), ("Host", "chunked"), ("User-Agent", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "POST", false), "HTTP/1.1 304 200 OK\r\nConnection: close\r\nHost: chunked\r\nUser-Agent: 10\r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.1", [("Transfer-Encoding", "close")], "abc", -1, ["chunked"], false, "POST", true), "HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.0", [], "abc", -1, [], true, "GET", true), "HTTP/1.0 007 status code 7\r\nConnection: close\r\n\r\nabc"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [("Content-Type", "10"), ("Transfer-Encoding", "close")], "hello world", 11, ["chunked"], false, "HEAD", true), "HTTP/1.0 500 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Type: 10\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.0", [("Accept", "chunked"), ("Content-Type", "chunked"), ("Connection", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], true, "POST", false), "HTTP/1.0 200 Custom Text\r\nAccept: chunked\r\nConnection: close\r\nContent-Type: chunked\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.0", [("Transfer-Encoding", "chunked"), ("User-Agent", " spaced "), ("Trailer", "")], "hello world", 0, [], false, "GET", false), "HTTP/1.0 304 Custom Text\r\nUser-Agent: spaced\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.1", [("Connection", ""), ("Content-Type", "")], "abc", -1, [], false, "GET", true), "HTTP/1.1 500 200 OK\r\nConnection: close\r\nConnection: \r\nContent-Type: \r\n\r\nabc"
  assert_eq dresp(204, "Custom Text", "HTTP/1.1", [("User-Agent", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, ["chunked"], false, "HEAD", false), "HTTP/1.1 204 Custom Text\r\nTransfer-Encoding: chunked\r\nUser-Agent: a\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [], "", -1, [], false, "POST", false), "HTTP/1.1 007 200 OK\r\nConnection: close\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.0", [], "hello world", 35, [], true, "POST", false), "HTTP/1.0 007 status code 7\r\nConnection: close\r\nContent-Length: 35\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.1", [], "", 0, [], true, "HEAD", false), "HTTP/1.1 404 Not Found\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(101, "", "HTTP/1.0", [], "hello world", 39, ["chunked"], false, "POST", true), "ERR http: ContentLength=39 with Body length 11"
  assert_eq dresp(304, "Custom Text", "HTTP/1.1", [("x-lower", "10"), ("Host", ""), ("X-Foo", "")], "", -1, ["chunked"], true, "POST", true), "HTTP/1.1 304 Custom Text\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nHost: \r\nX-Foo: \r\nX-Lower: 10\r\n\r\n0\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [("Connection", "close")], "abc", 3, [], false, "HEAD", true), "HTTP/1.1 500 Custom Text\r\nContent-Length: 3\r\nConnection: close\r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [("Host", "text/html"), ("Content-Length", "two\nlines"), ("Bad Key", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 19, ["chunked"], false, "POST", true), "HTTP/1.1 007 200 OK\r\nTransfer-Encoding: chunked\r\nHost: text/html\r\n\r\n28\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\r\n0\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.0", [("X-Foo", ""), ("Content-Type", "two\nlines"), ("User-Agent", "text/html")], "", -1, [], false, "GET", false), "HTTP/1.0 500 Custom Text\r\nContent-Type: two lines\r\nUser-Agent: text/html\r\nX-Foo: \r\n\r\n"
}

test "vectors: dump response 2" {
  assert_eq dresp(404, "Custom Text", "HTTP/1.0", [("x-lower", "10"), ("Host", "chunked")], "hello world", 11, [], false, "HEAD", true), "HTTP/1.0 404 Custom Text\r\nContent-Length: 11\r\nHost: chunked\r\nX-Lower: 10\r\n\r\n"
  assert_eq dresp(204, "Custom Text", "HTTP/1.0", [("x-lower", "10"), ("Trailer", "10")], "", 29, [], false, "GET", true), "ERR http: ContentLength=29 with Body length 0"
  assert_eq dresp(101, "", "HTTP/1.0", [("Host", "a"), ("Connection", "a"), ("Transfer-Encoding", "10")], "abc", 13, [], false, "POST", true), "ERR http: ContentLength=13 with Body length 3"
  assert_eq dresp(404, "200 OK", "HTTP/1.1", [("Connection", "chunked")], "hello world", 0, [], false, "POST", false), "HTTP/1.1 404 200 OK\r\nContent-Length: 0\r\nConnection: chunked\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.1", [("Transfer-Encoding", "two\nlines")], "hello world", 11, [], false, "POST", true), "HTTP/1.1 404 Not Found\r\nContent-Length: 11\r\n\r\nhello world"
  assert_eq dresp(500, "Custom Text", "HTTP/1.0", [("Transfer-Encoding", "close"), ("Accept", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], true, "HEAD", false), "HTTP/1.0 500 Custom Text\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nAccept: \r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.1", [("Bad Key", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "HEAD", false), "HTTP/1.1 101 200 OK\r\nContent-Length: 40\r\n\r\n"
  assert_eq dresp(200, "", "HTTP/1.0", [("User-Agent", "10"), ("Content-Type", "10")], "abc", -1, [], true, "POST", false), "HTTP/1.0 200 OK\r\nConnection: close\r\nContent-Type: 10\r\nUser-Agent: 10\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.0", [("Bad Key", "close"), ("Content-Type", "10"), ("Content-Length", " spaced ")], "", 0, ["chunked"], false, "GET", true), "HTTP/1.0 007 Custom Text\r\nContent-Type: 10\r\n\r\n"
