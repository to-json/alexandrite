  assert_eq dresp(7, "Custom Text", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "GET", true), "HTTP/1.1 007 Custom Text\r\nContent-Length: 40\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(200, "200 OK", "HTTP/1.0", [("x-lower", "two\nlines")], "abc", 0, [], false, "HEAD", true), "HTTP/1.0 200 OK\r\nX-Lower: two lines\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.0", [("Accept", "two\nlines"), ("Accept", "a")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, ["chunked"], false, "HEAD", true), "HTTP/1.0 304 200 OK\r\nTransfer-Encoding: chunked\r\nAccept: two lines\r\nAccept: a\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.0", [("Bad Key", " spaced "), ("Bad Key", "text/html"), ("Connection", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 17, ["chunked"], false, "HEAD", true), "HTTP/1.0 500 Custom Text\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.0", [("Bad Key", "close")], "", 10, [], false, "GET", false), "HTTP/1.0 404 Not Found\r\nContent-Length: 10\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.1", [("Content-Length", " spaced "), ("Content-Length", "10")], "hello world", 11, [], false, "HEAD", false), "HTTP/1.1 007 Custom Text\r\nContent-Length: 11\r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.1", [("Trailer", "")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], true, "HEAD", true), "HTTP/1.1 204 200 OK\r\nConnection: close\r\nContent-Length: 40\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.0", [("User-Agent", "text/html")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 45, [], true, "GET", true), "ERR http: ContentLength=45 with Body length 40"
  assert_eq dresp(101, "", "HTTP/1.1", [("Trailer", " spaced ")], "hello world", 11, [], false, "POST", true), "HTTP/1.1 101 Switching Protocols\r\nContent-Length: 11\r\n\r\nhello world"
  assert_eq dresp(101, "", "HTTP/1.1", [], "abc", -1, [], false, "POST", false), "HTTP/1.1 101 Switching Protocols\r\nConnection: close\r\n\r\n"
  assert_eq dresp(204, "Custom Text", "HTTP/1.0", [], "abc", -1, [], false, "HEAD", true), "HTTP/1.0 204 Custom Text\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [("Connection", "chunked")], "abc", 19, [], true, "GET", true), "ERR http: ContentLength=19 with Body length 3"
  assert_eq dresp(404, "200 OK", "HTTP/1.0", [("Transfer-Encoding", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 40, [], false, "HEAD", true), "HTTP/1.0 404 200 OK\r\nContent-Length: 40\r\n\r\n"
  assert_eq dresp(404, "Custom Text", "HTTP/1.1", [("Trailer", "two\nlines"), ("Host", " spaced ")], "abc", -1, [], true, "POST", true), "HTTP/1.1 404 Custom Text\r\nConnection: close\r\nHost: spaced\r\n\r\nabc"
  assert_eq dresp(404, "", "HTTP/1.1", [("X-Foo", "two\nlines")], "", 0, [], true, "HEAD", true), "HTTP/1.1 404 Not Found\r\nConnection: close\r\nX-Foo: two lines\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(304, "", "HTTP/1.0", [("Content-Type", "chunked"), ("Content-Type", "text/html")], "abc", -1, [], true, "GET", false), "HTTP/1.0 304 Not Modified\r\nConnection: close\r\nContent-Type: chunked\r\nContent-Type: text/html\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [("Content-Length", "close"), ("Transfer-Encoding", "10"), ("User-Agent", "10")], "", 19, [], false, "POST", false), "HTTP/1.0 500 200 OK\r\nContent-Length: 19\r\nUser-Agent: 10\r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.0", [], "hello world", 42, [], false, "HEAD", true), "HTTP/1.0 500 Custom Text\r\nContent-Length: 42\r\n\r\n"
  assert_eq dresp(304, "200 OK", "HTTP/1.0", [("Transfer-Encoding", "a")], "", 26, [], false, "HEAD", true), "HTTP/1.0 304 200 OK\r\nContent-Length: 26\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [("Transfer-Encoding", "two\nlines")], "hello world", 11, [], false, "POST", false), "HTTP/1.0 500 200 OK\r\nContent-Length: 11\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [("Accept", " spaced "), ("Connection", "a"), ("User-Agent", "text/html")], "abc", 0, [], true, "POST", true), "HTTP/1.0 500 200 OK\r\nConnection: close\r\nAccept: spaced\r\nConnection: a\r\nUser-Agent: text/html\r\n\r\nabc"
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [("Bad Key", "chunked"), ("Connection", " spaced "), ("Content-Length", "text/html")], "hello world", 0, [], false, "POST", true), "HTTP/1.1 500 Custom Text\r\nConnection: close\r\nConnection: spaced\r\n\r\nhello world"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [("User-Agent", "chunked"), ("Content-Length", "a"), ("x-lower", "close")], "", 0, [], false, "POST", true), "HTTP/1.0 500 200 OK\r\nContent-Length: 0\r\nUser-Agent: chunked\r\nX-Lower: close\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.1", [], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 6, [], true, "POST", false), "HTTP/1.1 304 Custom Text\r\nConnection: close\r\nContent-Length: 6\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.1", [("x-lower", ""), ("Content-Length", "a")], "hello world", 0, [], true, "HEAD", false), "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nX-Lower: \r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.0", [("Host", "text/html"), ("Host", "chunked"), ("Accept", "")], "abc", 3, [], false, "GET", true), "HTTP/1.0 500 Internal Server Error\r\nContent-Length: 3\r\nAccept: \r\nHost: text/html\r\nHost: chunked\r\n\r\nabc"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Transfer-Encoding", "chunked"), ("Transfer-Encoding", "close"), ("Host", "close")], "", 0, [], false, "POST", true), "HTTP/1.1 304 200 OK\r\nContent-Length: 0\r\nHost: close\r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.1", [("x-lower", "two\nlines")], "hello world", 41, ["chunked"], true, "POST", false), "HTTP/1.1 204 200 OK\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nX-Lower: two lines\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.1", [("User-Agent", " spaced ")], "abc", 0, [], false, "HEAD", true), "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nUser-Agent: spaced\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.1", [("Trailer", "chunked"), ("User-Agent", " spaced ")], "abc", 0, [], true, "POST", false), "HTTP/1.1 007 Custom Text\r\nConnection: close\r\nContent-Length: 0\r\nUser-Agent: spaced\r\n\r\n"
  assert_eq dresp(304, "", "HTTP/1.1", [("Connection", "two\nlines"), ("User-Agent", "a"), ("Content-Type", "chunked")], "hello world", -1, ["chunked"], false, "POST", false), "HTTP/1.1 304 Not Modified\r\nTransfer-Encoding: chunked\r\nConnection: two lines\r\nContent-Type: chunked\r\nUser-Agent: a\r\n\r\n"
  assert_eq dresp(404, "", "HTTP/1.0", [("Connection", "close"), ("Content-Type", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 34, [], false, "GET", false), "HTTP/1.0 404 Not Found\r\nContent-Length: 34\r\nConnection: close\r\nContent-Type: close\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.1", [("Accept", "a"), ("Bad Key", "")], "abc", 3, [], false, "POST", true), "HTTP/1.1 200 Custom Text\r\nContent-Length: 3\r\nAccept: a\r\n\r\nabc"
  assert_eq dresp(304, "200 OK", "HTTP/1.1", [("Transfer-Encoding", " spaced ")], "abc", -1, [], true, "GET", false), "HTTP/1.1 304 200 OK\r\nConnection: close\r\n\r\n"
  assert_eq dresp(204, "Custom Text", "HTTP/1.0", [("Bad Key", "text/html"), ("Connection", "")], "", 0, [], true, "GET", true), "HTTP/1.0 204 Custom Text\r\nConnection: close\r\nConnection: \r\n\r\n"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [("Connection", "two\nlines"), ("X-Foo", "two\nlines")], "", 0, [], false, "POST", true), "HTTP/1.1 007 200 OK\r\nContent-Length: 0\r\nConnection: two lines\r\nX-Foo: two lines\r\n\r\n"
  assert_eq dresp(101, "", "HTTP/1.1", [("Transfer-Encoding", "10"), ("Bad Key", "two\nlines")], "abc", 0, [], true, "GET", false), "HTTP/1.1 101 Switching Protocols\r\nConnection: close\r\n\r\n"
  assert_eq dresp(101, "200 OK", "HTTP/1.1", [], "", 0, [], false, "POST", true), "HTTP/1.1 101 200 OK\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(304, "Custom Text", "HTTP/1.1", [("Host", ""), ("Bad Key", "chunked")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 45, [], false, "GET", false), "HTTP/1.1 304 Custom Text\r\nContent-Length: 45\r\nHost: \r\n\r\n"
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [], "hello world", -1, [], false, "GET", false), "HTTP/1.1 500 Custom Text\r\nConnection: close\r\n\r\n"
  assert_eq dresp(500, "", "HTTP/1.1", [], "", 0, [], false, "HEAD", true), "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [], "", 0, [], false, "GET", true), "HTTP/1.0 500 200 OK\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(204, "", "HTTP/1.1", [("Trailer", ""), ("Connection", "two\nlines"), ("Content-Length", "10")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 37, ["chunked"], true, "HEAD", true), "HTTP/1.1 204 No Content\r\nConnection: close\r\nTransfer-Encoding: chunked\r\nConnection: two lines\r\n\r\n"
  assert_eq dresp(7, "Custom Text", "HTTP/1.0", [("Content-Type", "two\nlines")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, [], false, "GET", true), "HTTP/1.0 007 Custom Text\r\nContent-Type: two lines\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(204, "200 OK", "HTTP/1.0", [("User-Agent", "a"), ("Transfer-Encoding", " spaced ")], "", 0, ["chunked"], false, "POST", false), "HTTP/1.0 204 200 OK\r\nContent-Length: 0\r\nUser-Agent: a\r\n\r\n"
  assert_eq dresp(200, "", "HTTP/1.1", [("Accept", "text/html")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", -1, [], false, "POST", true), "HTTP/1.1 200 OK\r\nConnection: close\r\nAccept: text/html\r\n\r\nzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  assert_eq dresp(404, "", "HTTP/1.1", [], "hello world", 11, [], false, "HEAD", false), "HTTP/1.1 404 Not Found\r\nContent-Length: 11\r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.1", [("Connection", "close")], "", 0, [], false, "GET", true), "HTTP/1.1 204 200 OK\r\nConnection: close\r\n\r\n"
  assert_eq dresp(404, "Custom Text", "HTTP/1.1", [("User-Agent", "chunked"), ("Transfer-Encoding", " spaced "), ("Trailer", "two\nlines")], "", 0, [], true, "GET", false), "HTTP/1.1 404 Custom Text\r\nConnection: close\r\nUser-Agent: chunked\r\nContent-Length: 0\r\n\r\n"
}

test "vectors: dump response 3" {
  assert_eq dresp(500, "Custom Text", "HTTP/1.1", [], "", 0, [], false, "HEAD", false), "HTTP/1.1 500 Custom Text\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(200, "Custom Text", "HTTP/1.1", [("Connection", "a"), ("Accept", "")], "", -1, [], false, "GET", true), "HTTP/1.1 200 Custom Text\r\nConnection: close\r\nAccept: \r\nConnection: a\r\n\r\n"
  assert_eq dresp(500, "200 OK", "HTTP/1.0", [("Transfer-Encoding", "chunked"), ("Transfer-Encoding", " spaced "), ("x-lower", "chunked")], "", 0, [], true, "GET", false), "HTTP/1.0 500 200 OK\r\nConnection: close\r\nX-Lower: chunked\r\nContent-Length: 0\r\n\r\n"
  assert_eq dresp(7, "", "HTTP/1.0", [("Transfer-Encoding", "two\nlines"), ("Content-Type", ""), ("x-lower", "chunked")], "hello world", -1, [], false, "POST", true), "HTTP/1.0 007 status code 7\r\nContent-Type: \r\nX-Lower: chunked\r\n\r\nhello world"
  assert_eq dresp(204, "Custom Text", "HTTP/1.0", [("X-Foo", "chunked"), ("User-Agent", "close")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 0, ["chunked"], false, "GET", false), "HTTP/1.0 204 Custom Text\r\nUser-Agent: close\r\nX-Foo: chunked\r\n\r\n"
  assert_eq dresp(204, "200 OK", "HTTP/1.1", [("Accept", "close"), ("Content-Length", "10"), ("Bad Key", "10")], "hello world", -1, [], false, "GET", true), "HTTP/1.1 204 200 OK\r\nConnection: close\r\nAccept: close\r\n\r\nhello world"
  assert_eq dresp(200, "Custom Text", "HTTP/1.0", [("Trailer", "text/html"), ("Bad Key", "")], "hello world", 0, [], false, "POST", true), "HTTP/1.0 200 Custom Text\r\n\r\nhello world"
  assert_eq dresp(7, "200 OK", "HTTP/1.1", [("Content-Type", "two\nlines"), ("Connection", " spaced ")], "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", 45, [], true, "POST", true), "ERR http: ContentLength=45 with Body length 40"
