  assert_eq dreq("DELETE", "/foo", "HTTP/1.0", [("User-Agent", " spaced "), ("Trailer", "two\nlines"), ("Host", "two\nlines")], "", -1, ["chunked"], "other.host:81", "/foo", true), "DELETE /foo HTTP/1.0\r\nHost: other.host:81\r\nTransfer-Encoding: chunked\r\nUser-Agent: spaced\r\n\r\n"
  assert_eq dreq("", "http://example.com/a/b?x=1&y=2", "HTTP/1.1", [], "hello world", 0, [], "", "http://example.com/a/b?x=1&y=2", false), "GET http://example.com/a/b?x=1&y=2 HTTP/1.1\r\n\r\n"
