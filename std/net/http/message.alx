import "bufio"
import "strings"
import "strconv"
import "encoding/base64"
import nurl "net/url"
import "mime"

# Limits (the server answers 431 / 413 when a request goes over them).
pub MAX_HEADER_BYTES = 1048576
pub MAX_HEADERS = 500
pub MAX_BODY_BYTES = 33554432

# ----------------------------------------------------------------- Request

# An HTTP request, as the server received it or as the client sends it.
#
#  - Server side: `url` is the request target as sent ("/items/7?x=1"),
#    `path` its decoded path, `raw_query` the part after "?". `body` holds the
#    whole body (read before the handler runs, up to MAX_BODY_BYTES).
#  - Client side: `url` is the full URL ("http://host:port/path?q"); `path`
#    and `raw_query` are filled in by `new_request`.
pub struct Request {
  method: Str
  url: Str
  path: Str
  raw_query: Str
  proto: Str
  host: Str
  header: Header
  body: [Byte]
  remote_addr: Str
  # Values of the `{name}` wildcards of the pattern that matched.
  pathvals: Map[Str, Str]
  # Go's fields, filled in by read_request (the server) and new_request:
  # the request target as sent (Go's RequestURI; server side only), the
  # parsed URL (Go's URL), the protocol version, the declared body length
  # (-1: unknown, e.g. chunked), the transfer codings ("chunked"), whether
  # the connection closes after this request, and the trailer (keys
  # declared in "Trailer", values filled in after a chunked body).
  request_uri: Str
  parsed_url: nurl.Url
  proto_major: Int
  proto_minor: Int
  content_length: Int
  transfer_encoding: [Str]
  close: Bool
  trailer: Header
  # The parsed query and urlencoded body (after parse_form!; Go's Form),
  # and the body's values only (Go's PostForm).
  form: nurl.Values
  post_form: nurl.Values
  form_parsed: Bool
  # The ServeMux pattern that matched (Go's Pattern).
  pattern: Str

  # The path as escaped in the request (the mux matches it segment by
  # segment, unescaped, as Go's does).
  pub def escaped_path -> Str {
    return parsed_url.escaped_path if parsed_url.path.size > 0 || parsed_url.raw_path.size > 0
    path
  }

  # Sets what path_value(name) returns (Go's SetPathValue).
  pub def set_path_value!(name: Str, value: Str) {
    self.pathvals[name] = value
  }

  # The decoded value of query parameter `key` (the first one), if present.
  pub def query(key: Str) -> Str? {
    query_value(raw_query, key)
  }

  # Whether the request's protocol is at least major.minor.
  pub def proto_at_least?(major: Int, minor: Int) -> Bool {
    proto_major > major || (proto_major == major && proto_minor >= minor)
  }

  # The Referer header.
  pub def referer -> Str { header.get("Referer") }

  # The user name and password of a "Basic" Authorization header, if the
  # request has a valid one (Go's BasicAuth).
  pub def basic_auth -> (Str, Str)? {
    parse_basic_auth(header.get("Authorization"))
  }

  # Sets the Authorization header to "Basic base64(user:pass)".
  pub def set_basic_auth!(username: Str, password: Str) {
    header.set!("Authorization", "Basic " + base64.std_encoding.encode_to_string((username + ":" + password).bytes.to_a))
  }

  # Parses the query and, for POST, PUT and PATCH with an urlencoded body,
  # the body into `form` (body values first) and `post_form` (Go's
  # ParseForm). Malformed pairs are skipped; the first one's error is
  # returned after both are filled in, as Go does. A second call does
  # nothing.
  pub def parse_form! -> ~Unit {
    return if form_parsed
    self.form_parsed = true
    first: Error? = none
    pf = nurl.new_values
    if method == "POST" || method == "PUT" || method == "PATCH" {
      ct = header.get("Content-Type")
      ct = "application/octet-stream" if ct.size == 0
      mt = ""
      pm = mime.parse_media_type(ct)
      if e = pm.err {
        first = e
      } else {
        mt, _ = pm.unwrap
      }
      if mt == "application/x-www-form-urlencoded" {
        if body.size > 10485760 {
          first = HttpError.Protocol("http: POST too large")
        } else {
          v, e = nurl.parse_query_lax(body_string)
          pf = v
          if x = e { first = x }
        }
      }
    }
    self.post_form = pf
    f = nurl.new_values
    for k, vs in pf.m {
      for v in vs { f.add!(k, v) }
    }
    q, qe = nurl.parse_query_lax(raw_query)
    if first.none? {
      if x = qe { first = x }
    }
    for k, vs in q.m {
      for v in vs { f.add!(k, v) }
    }
    self.form = f
    if e = first {
      fail e
    }
  }

  # The first value of `key` in the urlencoded body (POST, PUT, PATCH), if
  # any (Go's PostFormValue).
  pub def post_form_value(key: Str) -> Str? {
    r = self
    _ = r.parse_form!
    return none unless r.post_form.has?(key)
    r.post_form.get(key)
  }

  # What the matched pattern captured for `{name}` ("" if there is no such
  # wildcard).
  pub def path_value(name: Str) -> Str {
    v = pathvals[name]
    if s = v { return s }
    ""
  }

  # The body as text.
  pub def body_string -> Str {
    Str.from_bytes(body)
  }

  # A form value: the query first, then a urlencoded body.
  # (Go's FormValue: the body's values come before the query's.)
  pub def form_value(key: Str) -> Str? {
    r = self
    _ = r.parse_form!
    return none unless r.form.has?(key)
    r.form.get(key)
  }

  pub def user_agent -> Str { header.get("User-Agent") }

  # Whether the client asked to close the connection after this request
  # (Go's shouldClose: "Connection: close", or HTTP/1.0 without
  # keep-alive).
  def wants_close -> Bool {
    close || should_close(proto_major, proto_minor, header, false)
  }
}

# A request for `method` and a full "http://host:port/path?q" URL.
pub def new_request(method0: Str, url: Str, body: [Byte]) -> ~Request {
  # (Go's NewRequest: "" means GET; a method must be a token)
  method = method0.size == 0 ? "GET" : method0
  fail HttpError.Protocol("net/http: invalid method #{strconv.quote(method)}") unless token?(method)
  u = ~parse_url(url)
  h = new_header
  pv: Map[Str, Str] = {}
  pu = nurl.parse(strings.contains(url, "://") ? url : "http://" + url).unwrap_or(nurl.Url.new)
  Request.new(method: method, url: url, path: u.path, raw_query: u.raw_query, proto: "HTTP/1.1", host: u.host_header, header: h, body: body, remote_addr: "", pathvals: pv, parsed_url: pu, proto_major: 1, proto_minor: 1, content_length: body.size, trailer: new_header, form: nurl.new_values, post_form: nurl.new_values)
}

# ---------------------------------------------------------------- Response

# An HTTP response as the client sees it.
pub struct Response {
  status: Int
  status_text: Str
  proto: Str
  header: Header
  body: [Byte]
  # Go's fields, filled in by read_response: Status ("200 OK"), the
  # protocol version, the declared body length (-1: unknown), the transfer
  # codings, whether the connection closes after it (a "Connection: close"
  # header is removed from `header`, as Go does), and the trailer.
  status_str: Str
  proto_major: Int
  proto_minor: Int
  content_length: Int
  transfer_encoding: [Str]
  close: Bool
  trailer: Header

  # Whether the response's protocol is at least major.minor.
  pub def proto_at_least?(major: Int, minor: Int) -> Bool {
    proto_major > major || (proto_major == major && proto_minor >= minor)
  }

  pub def body_string -> Str {
    Str.from_bytes(body)
  }

  # 200 <= status < 300.
  pub def ok? -> Bool { status >= 200 && status < 300 }
}

# ----------------------------------------------------------------- parsing

def zeros(n: Int) -> [Byte] {
  b: [Byte] = [0; n]
  b
}

# Reads exactly n bytes.
def read_n(br: bufio.Reader, n: Int) -> ~[Byte] {
  buf = zeros(n)
  got = 0
  while got < n {
    k = br.~read!(buf[got...n])
    fail HttpError.Eof("body") if k == 0
    got += k
  }
  buf
}

def token_byte?(c: Byte) -> Bool {
  return true if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)
  c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126
}

def token?(s: Str) -> Bool {
  return false if s.size == 0
  for c in s.bytes {
    return false unless token_byte?(c)
  }
  true
}
