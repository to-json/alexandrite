import nurl "net/url"

def h1(w: ResponseWriter, r: Request) {}

def route(mux: ServeMux, method: Str, path: Str) -> Str {
  pat, code = mux.lookup(method, path)
  code == 0 ? pat : "#{code}"
}

test "routing table" {
  mux = new_serve_mux
  mux.handle_func("/", h1)
  mux.handle_func("/{$}", h1)
  mux.handle_func("GET /items/{id}", h1)
  mux.handle_func("POST /items", h1)
  mux.handle_func("/static/", h1)
  mux.handle_func("/static/css/{file}", h1)
  mux.handle_func("/files/{path...}", h1)
  mux.handle_func("GET /items/new", h1)
  mux.handle_func("/tree/", h1)
  assert_eq route(mux, "GET", "/"), "/{$}"
  assert_eq route(mux, "GET", "/other"), "/"
  assert_eq route(mux, "GET", "/items/7"), "GET /items/{id}"
  assert_eq route(mux, "HEAD", "/items/7"), "GET /items/{id}"
  assert_eq route(mux, "GET", "/items/new"), "GET /items/new"
  assert_eq route(mux, "POST", "/items"), "POST /items"
  assert_eq route(mux, "GET", "/static/app.js"), "/static/"
  assert_eq route(mux, "GET", "/static/css/a.css"), "/static/css/{file}"
  assert_eq route(mux, "GET", "/static/css/a/b.css"), "/static/"
  assert_eq route(mux, "GET", "/files/a/b/c"), "/files/{path...}"
  assert_eq route(mux, "GET", "/files/"), "/files/{path...}"
  assert_eq route(mux, "GET", "/tree"), "307"
  assert_eq route(mux, "GET", "/tree/x/y"), "/tree/"
}

test "subtree redirect" {
  mux = new_serve_mux
  mux.handle_func("/tree/", h1)
  assert_eq route(mux, "GET", "/tree"), "307"
  assert_eq mux.find("GET", "/tree").location, "/tree/"
}

test "405 and 404" {
  mux = new_serve_mux
  mux.handle_func("GET /a", h1)
  mux.handle_func("DELETE /a", h1)
  mux.handle_func("POST /b/{x}", h1)
  assert_eq route(mux, "PUT", "/a"), "405"
  assert_eq route(mux, "POST", "/b/1"), "POST /b/{x}"
  assert_eq route(mux, "GET", "/b/1"), "405"
  assert_eq route(mux, "GET", "/c"), "404"
  assert_eq route(mux, "GET", "/b"), "404"
  m = mux.find("PUT", "/a")
  assert_eq m.allow, "DELETE, GET, HEAD"
}

test "clean path" {
  assert_eq clean_path("/a//b/./c/../d"), "/a/b/d"
  assert_eq clean_path("/a/b/"), "/a/b/"
  assert_eq clean_path("/../x"), "/x"
  assert_eq clean_path(""), "/"
}

# ------------------------------------------------ helpers for vec_mux_test

def vec_mux -> ServeMux {
  mux = new_serve_mux
  for p in VEC_PATTERNS {
    mux.handle_func(p, h1)
  }
  mux
}

# What Go's ServeMux.ServeHTTP answers for method and path: "200 pattern",
# "307 location", "405 allow" or "404".
def mux_route(mux: ServeMux, method: Str, path: Str) -> Str {
  u = nurl.parse("http://example.com" + path).unwrap
  epath = u.escaped_path
  p = method == "CONNECT" ? epath : clean_path(epath)
  m = mux.find(method, p)
  return "307 " + m.location if m.code == 307
  return "307 " + p if p != epath
  return "200 " + m.allow if m.code == 0
  return "405 " + m.allow if m.code == 405
  "#{m.code}"
}
