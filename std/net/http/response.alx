import "net"
import "strings"
import "strconv"
import "time"
import gopath "path"
import nurl "net/url"

# A body that outgrows this many buffered bytes switches the response to
# chunked transfer coding (headers go out, then each write is a chunk).
pub FLUSH_THRESHOLD = 32768

# Where a ResponseWriter's output goes and in which form:
#  - MODE_HTTP: an HTTP/1.x response on a connection ("HTTP/1.1 200 OK",
#    Content-Length or chunked framing; the server's writers).
#  - MODE_CGI: a CGI response ("Status: 200 OK" header line, then the
#    header and the raw body as it is written; net/http/cgi).
#  - MODE_FCGI: like MODE_CGI, plus a Date header and no entity headers on a
#    304 (net/http/fcgi).
#  - MODE_RECORD: nothing is sent; the status, a snapshot of the header and
#    the body are recorded (net/http/httptest's ResponseRecorder).
pub MODE_HTTP = 0
pub MODE_CGI = 1
pub MODE_FCGI = 2
pub MODE_RECORD = 3

struct RWState {
  # 0 until write_header! (or the first write).
  status: Int
  # Body bytes held back (MODE_HTTP: so Content-Length can be sent; MODE_RECORD:
  # the whole body).
  body: [Byte]
  head_sent: Bool
  chunked: Bool
  # Whether the connection must close after this response.
  close_after: Bool
  # The request used HTTP/1.1, so chunked coding is available.
  can_chunk: Bool
  head_request: Bool
  # Bytes not yet handed to the sink.
  out: [Byte]
  mode: Int
  # MODE_RECORD: flush! was called; the header when the status was set.
  flushed: Bool
  snap: Header
  # Sink failures, kept until finish!.
  failed: Bool
}

# What a handler writes its response to. Copies share state (D36), so it can
# be passed around freely.
#
# Framing (MODE_HTTP): the response is held in memory while the handler
# writes. If it finishes with less than FLUSH_THRESHOLD bytes (and never
# called `flush!`), it goes out with a `Content-Length`; otherwise the headers
# go out first with `Transfer-Encoding: chunked` and each write is a chunk.
# HTTP/1.0 clients always get a buffered, length-framed response. Without a
# Content-Type, one is sniffed from the body (detect_content_type). `Date`
# and `Server` headers are not sent. See the MODE_ constants for the other
# kinds of output.
pub struct ResponseWriter {
  st: [RWState]
  # Takes the finished bytes (the connection, a CGI's stdout, ...).
  sink: ([Byte]) -> ~Unit
  # The response headers: set them before the first write.
  header: Header

  # Sets the status. Only the first call counts; headers set after it (and
  # after a write) are not sent unless the response is still being buffered.
  pub def write_header!(code: Int) {
    return if st[0].status != 0
    c = code
    # (a recorder panics on an invalid code, as Go's checkWriteHeaderCode)
    assert c >= 100 && c <= 999, "invalid WriteHeader code #{c}" if st[0].mode == MODE_RECORD
    c = 500 if c < 100 || c > 999
    self.st[0].status = c
    m = st[0].mode
    if m == MODE_RECORD {
      self.st[0].snap = header.clone
    } else if m == MODE_FCGI {
      if c == 304 {
        header.del!("Content-Type")
        header.del!("Content-Length")
        header.del!("Transfer-Encoding")
      }
      header.set!("Date", now_http_date()) if header.get("Date") == ""
    }
    return
  }

  # The status set so far (0: none yet).
  pub def status -> Int { st[0].status }

  # Whether write_header! (or a write) has set the status.
  pub def wrote_header? -> Bool { st[0].status != 0 }

  # MODE_RECORD: the body written so far.
  pub def recorded_body -> [Byte] { st[0].body }

  # MODE_RECORD: the header as it was when the status was set (the live
  # header before that).
  pub def recorded_header -> Header {
    st[0].status == 0 ? header : st[0].snap
  }

  # MODE_RECORD: whether flush! was called.
  pub def flushed? -> Bool { st[0].flushed }

  # Appends p to the body (status 200 if none was set); p.size.
  pub def write!(p: [Byte]) -> ~Int {
    m = st[0].mode
    if st[0].status == 0 {
      if m == MODE_RECORD && !header.has?("Content-Type") && !header.has?("Transfer-Encoding") {
        header.set!("Content-Type", detect_content_type(p))
      }
      self.write_header!(200)
    }
    if m == MODE_RECORD {
      for c in p { self.st[0].body << c }
      # (the bytes are recorded anyway, as Go's recorder does)
      fail HttpError.BodyNotAllowed unless body_allowed_for_status?(st[0].status)
      return p.size
    }
    if m == MODE_CGI || m == MODE_FCGI {
      self.~send_cgi_head!(p) unless st[0].head_sent
      self.~put!(p)
      self.~flush_out! if st[0].out.size > 65536
      return p.size
    }
    return p.size if st[0].head_request && st[0].head_sent
    if st[0].head_sent {
      self.~send_chunk!(p)
      return p.size
    }
    for c in p { self.st[0].body << c }
    if st[0].body.size >= FLUSH_THRESHOLD && st[0].can_chunk {
      self.~start_stream!
    }
    p.size
  }

  pub def write_string!(s: Str) -> ~Int {
    self.~write!(s.bytes.to_a)
  }

  # Sends what's buffered now (switching to chunked coding), so the client
  # sees it before the handler is done. On HTTP/1.0 it does nothing.
  pub def flush! -> ~Unit {
    m = st[0].mode
    if m == MODE_RECORD {
      self.write_header!(200) if st[0].status == 0
      self.st[0].flushed = true
      return
    }
    if m == MODE_CGI || m == MODE_FCGI {
      self.write_header!(200)
      self.~flush_out!
      return
    }
    return if !st[0].can_chunk
    self.write_header!(200)
    self.~start_stream! unless st[0].head_sent
    self.~flush_out!
  }

  def put_string!(s: Str) -> ~Unit {
    for c in s.bytes { self.st[0].out << c }
    return
  }

  def put!(p: [Byte]) -> ~Unit {
    for c in p { self.st[0].out << c }
    return
  }

  def flush_out! -> ~Unit {
    return if st[0].out.size == 0
    o = st[0].out
    self.st[0].out = []
    s = sink
    r = s(o)
    if r.err? {
      self.st[0].failed = true
      ~r
    }
    return
  }

  def bodyless? -> Bool {
    s = st[0].status
    s < 200 || s == 204 || s == 304
  }

  # The CGI header block, before the first body bytes p.
  def send_cgi_head!(p: [Byte]) -> ~Unit {
    s = st[0].status
    self.~put_string!("Status: #{s} #{status_text(s)}\r\n")
    if !header.has?("Content-Type") && !(st[0].mode == MODE_FCGI && s == 304) {
      header.set!("Content-Type", detect_content_type(p))
    }
    self.~put_string!(header.wire_subset([]))
    self.~put_string!("\r\n")
    self.st[0].head_sent = true
    self.~flush_out!
  }

  def send_head!(content_length: Int) -> ~Unit {
    s = st[0].status
    if bodyless? {
      # (Go's suppressedHeaders: no length or coding without a body, and
      # no Content-Type on a 304)
      header.del!("Content-Length")
      header.del!("Transfer-Encoding")
      header.del!("Content-Type") if s == 304
    } else if st[0].head_request && st[0].body.size == 0 {
      # (Go: a HEAD reply without writes has no length unless the handler set one)
    } else if content_length >= 0 {
      header.set!("Content-Length", strconv.itoa(content_length))
    } else {
      header.set!("Transfer-Encoding", "chunked")
      header.del!("Content-Length")
    }
    if !header.has?("Content-Type") && st[0].body.size > 0 && !bodyless? {
      header.set!("Content-Type", detect_content_type(st[0].body))
    }
    if lower(header.get("Connection")) == "close" {
      self.st[0].close_after = true
    }
    header.set!("Connection", "close") if st[0].close_after
    self.~put_string!("HTTP/1.1 #{s} #{status_text(s)}\r\n")
    for k in header.keys {
      for v in header.values(k) {
        self.~put_string!("#{k}: #{clean(v)}\r\n")
      }
    }
    self.~put_string!("\r\n")
    self.st[0].head_sent = true
  }

  def start_stream! -> ~Unit {
    self.~send_head!(-1)
    self.st[0].chunked = true
    b = st[0].body
    self.st[0].body = []
    self.~send_chunk!(b)
  }

  def send_chunk!(p: [Byte]) -> ~Unit {
    return if p.size == 0 || st[0].head_request
    self.~put_string!(strconv.format_int(p.size, 16) + "\r\n")
    self.~put!(p)
    self.~put_string!("\r\n")
    self.~flush_out! if st[0].out.size > 65536
  }

  # Completes the response after the handler returned and flushes it to the
  # sink; true if the connection stays usable. (The server calls it; so do
  # the cgi and fcgi packages. A recorder needs no finish.)
  pub def finish! -> ~Bool {
    m = st[0].mode
    return true if m == MODE_RECORD
    if m == MODE_CGI || m == MODE_FCGI {
      self.write_header!(200)
      self.~send_cgi_head!([]) unless st[0].head_sent
      self.~flush_out!
      return true
    }
    self.write_header!(200)
    if !st[0].head_sent {
      n = st[0].body.size
      self.~send_head!(n)
      if n > 0 && !st[0].head_request && !bodyless? {
        self.~put!(st[0].body)
      }
    } else if st[0].chunked && !st[0].head_request {
      self.~put_string!("0\r\n\r\n")
    }
    self.~flush_out!
    !st[0].close_after && !st[0].failed
  }
}

# A header value with CR and LF replaced by spaces (no response splitting).
def clean(v: Str) -> Str {
  return v unless strings.contains(v, "\n") || strings.contains(v, "\r")
  strings.replace_all(strings.replace_all(v, "\r", " "), "\n", " ")
}

def now_http_date -> Str {
  time.now.utc.format(TIME_FORMAT)
}

def new_rw_state(mode: Int, head_request: Bool, can_chunk: Bool, close_after: Bool) -> [RWState] {
  b: [Byte] = []
  ob: [Byte] = []
  s: [RWState] = [RWState.new(status: 0, body: b, head_sent: false, chunked: false, close_after: close_after, can_chunk: can_chunk, head_request: head_request, out: ob, mode: mode, flushed: false, snap: new_header, failed: false)]
  s
}

def new_response_writer(conn: net.Conn, head_request: Bool, can_chunk: Bool, close_after: Bool) -> ResponseWriter {
  c = conn
  sink = ->(p: [Byte]) -> ~Unit {
    c.~write!(p)
    return
  }
  ResponseWriter.new(st: new_rw_state(MODE_HTTP, head_request, can_chunk, close_after), sink: sink, header: new_header)
}

# A ResponseWriter whose output (in the form `mode` says) goes to `sink`.
# For MODE_HTTP, `head_request` drops the body and the response is
# length-framed unless it streams (chunked); call `finish!` when the handler
# is done.
pub def new_response_writer_to(mode: Int, head_request: Bool, sink: ([Byte]) -> ~Unit) -> ResponseWriter {
  ResponseWriter.new(st: new_rw_state(mode, head_request, true, false), sink: sink, header: new_header)
}

# A ResponseWriter that records what a handler does (MODE_RECORD).
pub def new_recording_writer -> ResponseWriter {
  sink = ->(p: [Byte]) -> ~Unit {
    return
  }
  ResponseWriter.new(st: new_rw_state(MODE_RECORD, false, true, false), sink: sink, header: new_header)
}

# Replies with the status `code` and `msg` as a text/plain body.
pub def error(w: ResponseWriter, msg: Str, code: Int) {
  w.header.del!("Content-Length")
  w.header.set!("Content-Type", "text/plain; charset=utf-8")
  w.header.set!("X-Content-Type-Options", "nosniff")
  w.write_header!(code)
  w.write_string!(msg + "\n")
}

# Replies "404 page not found".
pub def not_found(w: ResponseWriter, r: Request) {
  error(w, "404 page not found", 404)
}

def html_escape(s: Str) -> Str {
  x = strings.replace_all(s, "&", "&amp;")
  x = strings.replace_all(x, "<", "&lt;")
  x = strings.replace_all(x, ">", "&gt;")
  x = strings.replace_all(x, "\"", "&#34;")
  strings.replace_all(x, "'", "&#39;")
}

# Bytes >= 0x80 as "%xx" (lower-case hex, Go's hexEscapeNonASCII).
def hex_escape_non_ascii(s: Str) -> Str {
  b = strings.new_builder
  for c in s.bytes {
    if c >= 0x80 {
      b.write!("%" + strconv.format_int(c.to_i, 16))
    } else {
      b.write_byte!(c)
    }
  }
  b.to_s
}

# Replies with a redirect to `url` and status `code` (301, 302, 303, 307
# or 308), as Go's Redirect: a path without scheme and host is made
# absolute against the request's path and cleaned (keeping a trailing
# slash and the query); non-ASCII bytes are %-escaped. The Content-Type and
# the short HTML body are set for GET/HEAD unless the handler already set a
# Content-Type.
pub def redirect(w: ResponseWriter, r: Request, url0: Str, code: Int) {
  url = url0
  pu = nurl.parse(url)
  if pu.ok? && pu.unwrap.scheme == "" && pu.unwrap.host == "" {
    oldpath = r.escaped_path
    oldpath = "/" if oldpath.size == 0
    if url.size == 0 || url[0] != 47 {
      olddir, _ = gopath.split(oldpath)
      url = olddir + url
    }
    query = ""
    i = strings.index(url, "?")
    if i >= 0 {
      query = url[i...url.size]
      url = url[0...i]
    }
    trailing = strings.has_suffix(url, "/")
    url = gopath.clean(url)
    url += "/" if trailing && !strings.has_suffix(url, "/")
    url += query
  }
  had_ct = w.header.raw("Content-Type").present?
  w.header.set!("Location", hex_escape_non_ascii(url))
  if !had_ct && (r.method == "GET" || r.method == "HEAD") {
    w.header.set!("Content-Type", "text/html; charset=utf-8")
  }
  w.write_header!(code)
  if !had_ct && r.method == "GET" {
    w.write_string!("<a href=\"" + html_escape(url) + "\">" + status_text(code) + "</a>.\n\n")
  }
}
