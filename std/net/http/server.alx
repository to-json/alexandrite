import "bufio"
import "net"
import "sync"

extern def alx_sleep_ns(ns: Int)

struct Ctl {
  shutting: Bool
  listeners: [net.Listener]
  # Connections waiting for their next request (shutdown closes them).
  idle: Map[Int, net.Conn]
}

# An HTTP/1.1 server: one task per connection, keep-alive, a handler per
# request.
#
# A Server is a handle (every field is shared state), so one task can run
# `serve` while another calls `shutdown`. The handler is copied into each
# connection's task: state it needs to share across requests belongs in a
# Mutex, an Atomic or a channel, not in captured variables.
#
# Gaps: no read/write timeouts (the net package has no deadlines), no TLS, no
# HTTP/2, no hijacking, no streaming of request bodies (a body is read in full
# before the handler runs), no `Expect: 100-continue`. A handler that panics
# kills its connection's task, not the server; the connection is not closed and
# `shutdown` will wait for it.
pub struct Server {
  mux: ServeMux
  ctl: Mutex[Ctl]
  wg: sync.WaitGroup

  # Accepts connections on `ln` until `shutdown` (then returns ok) or the
  # listener fails.
  pub def serve(ln: net.Listener) -> ~Unit {
    ctl.lock { |c| c.listeners << ln }
    loop {
      accepted = ln.accept
      if e = accepted.err {
        return if shutting? || net.is_closed(e)
        # Likely out of descriptors: back off briefly, as Go does.
        alx_sleep_ns(5000000)
        next
      }
      conn = accepted.unwrap
      wg.add(1)
      s = self
      spawn { serve_conn(conn, s) }
    }
  }

  # Listens on addr ("host:port") and serves.
  pub def listen_and_serve(addr: Str) -> ~Unit {
    ln = ~net.listen("tcp", addr)
    self.~serve(ln)
  }

  def shutting? -> Bool {
    ctl.lock { |c| c.shutting }
  }

  # Stops accepting, closes idle keep-alive connections, and waits for the
  # requests in flight to finish (their connections close afterwards).
  pub def shutdown {
    todo_l: [net.Listener] = []
    todo_c: [net.Conn] = []
    ctl.lock { |c|
      c.shutting = true
      for l in c.listeners { todo_l << l }
      c.listeners = []
      for _, cn in c.idle { todo_c << cn }
      c.idle = {}
    }
    for l in todo_l { l.close! }
    for cn in todo_c { cn.close! }
    wg.wait
  }
}

def new_server_mux(mux: ServeMux) -> Server {
  c = Ctl.new(shutting: false, listeners: [], idle: {})
  Server.new(mux: mux, ctl: Mutex.new(c), wg: sync.new_wait_group)
}

# A server for the mux's routes. (The mux is a handle: routes registered
# later are served too.)
pub def new_server(mux: ServeMux) -> Server {
  new_server_mux(mux)
}

# A server for any Handler (it answers every path).
pub def new_server_handler[H: Handler](h: H) -> Server {
  mux = new_serve_mux
  mux.handle("/", h)
  new_server_mux(mux)
}

# A server for a handler function (it answers every path).
pub def new_server_func(f: (ResponseWriter, Request) -> Unit) -> Server {
  mux = new_serve_mux
  mux.handle_func("/", f)
  new_server_mux(mux)
}

# Serves `h` on an existing listener until it is closed.
pub def serve(ln: net.Listener, mux: ServeMux) -> ~Unit {
  s = new_server(mux)
  s.~serve(ln)
}

# Listens on addr and serves `h`.
pub def listen_and_serve(addr: Str, mux: ServeMux) -> ~Unit {
  s = new_server(mux)
  s.~listen_and_serve(addr)
}

ERROR_HEADERS = "\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\n"

# Answers a request that couldn't be read, as Go's conn.serve does; network
# read errors get no answer.
def write_error_reply(conn: net.Conn, e: Error) {
  msg = ""
  case e {
    HeadersTooLarge => msg = "HTTP/1.1 431 Request Header Fields Too Large" + ERROR_HEADERS + "431 Request Header Fields Too Large"
    TooLarge => msg = "HTTP/1.1 413 Request Entity Too Large" + ERROR_HEADERS + "413 Request Entity Too Large"
    UnsupportedTE => msg = "HTTP/1.1 501 Not Implemented" + ERROR_HEADERS + "Unsupported transfer encoding"
    Status(code, text) => msg = "HTTP/1.1 #{code} #{status_text(code)}: #{text}" + ERROR_HEADERS + "#{code} #{status_text(code)}: #{text}"
    net.NetError.ConnRefused => msg = ""
    net.NetError.AddrInUse => msg = ""
    net.NetError.Timeout => msg = ""
    net.NetError.Closed => msg = ""
    net.NetError.BadAddr => msg = ""
    net.NetError.Other => msg = ""
    _ => msg = "HTTP/1.1 400 Bad Request" + ERROR_HEADERS + "400 Bad Request"
  }
  conn.write_string!(msg) if msg.size > 0
}

# Go's httpguts.ValidHostHeader: no byte outside the URI host characters.
pub def valid_host_header?(h: Str) -> Bool {
  for c in h.bytes {
    ok = (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
    ok = ok || c == 33 || c == 36 || c == 37 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 45 || c == 46 || c == 58 || c == 59 || c == 61 || c == 91 || c == 93 || c == 95 || c == 126
    return false unless ok
  }
  true
}

# The checks Go's server makes after reading a request (conn.readRequest).
def server_check(req: Request) -> HttpError? {
  h2_preface = req.proto_major == 2 && req.proto_minor == 0 && req.method == "PRI" && req.request_uri == "*"
  return HttpError.Status(505, "unsupported protocol version") if req.proto_major != 1 && !h2_preface
  hosts = req.header.raw("Host") || []
  if req.proto_at_least?(1, 1) && hosts.size == 0 && !h2_preface && req.method != "CONNECT" {
    return HttpError.Status(400, "missing required Host header")
  }
  return HttpError.Status(400, "malformed Host header") if hosts.size == 1 && !valid_host_header?(hosts[0])
  for k in req.header.keys {
    return HttpError.Status(400, "invalid header name") unless valid_header_field_name?(k)
    for v in req.header.raw(k) || [] {
      return HttpError.Status(400, "invalid header value") unless valid_header_field_value?(v)
    }
  }
  none
}

def serve_conn(conn: net.Conn, srv: Server) {
  defer srv.wg.done
  defer conn.close!
  conn.set_nodelay(true)
  br = bufio.new_reader(conn)
  fd = conn.fd
  last_post = false
  loop {
    res = read_request_head(br, last_post)
    if e = res.err {
      write_error_reply(conn, e)
      break
    }
    opt = res.unwrap
    break unless opt.present?
    req = opt.unwrap
    if bad = server_check(req) {
      write_error_reply(conn, bad)
      break
    }
    req.header.del_raw!("Host")
    req.remote_addr = conn.remote_addr
    last_post = req.method == "POST"
    srv.ctl.lock { |c| c.idle.delete(fd) }
    http10 = req.proto == "HTTP/1.0"
    expect = req.header.get("Expect")
    if expect.size > 0 && !has_token?(expect, "100-continue") {
      # Go's sendExpectationFailed
      w = new_response_writer(conn, false, !http10, true)
      w.header.set!("Connection", "close")
      w.write_header!(417)
      w.finish!
      break
    }
    if expect.size > 0 && req.proto_at_least?(1, 1) && req.content_length != 0 {
      conn.write_string!("HTTP/1.1 100 Continue\r\n\r\n")
    }
    body = read_request_body(br, req)
    if e = body.err {
      write_error_reply(conn, e)
      break
    }
    req.body = body.unwrap
    w = new_response_writer(conn, req.method == "HEAD", !http10, req.wants_close || srv.shutting?)
    epath = req.escaped_path
    clean = clean_path(epath)
    if epath != "*" && req.method != "CONNECT" && clean != epath {
      loc = req.raw_query.size > 0 ? clean + "?" + req.raw_query : clean
      redirect(w, req, loc, 307)
    } else {
      m = srv.mux.find(req.method, epath)
      # (Inline, not `dispatch(m, w, req)`: see the compiler caveat on
      # `dispatch` in mux.alx.)
      if m.code == 0 {
        rq = req
        rq.pathvals = m.pvals
        rq.pattern = m.allow
        h = m.handler
        h(w, rq)
      } else if m.code == 307 {
        loc = req.raw_query.size > 0 ? m.location + "?" + req.raw_query : m.location
        redirect(w, req, loc, 307)
      } else if m.code == 405 {
        w.header.set!("Allow", m.allow)
        error(w, "Method Not Allowed", 405)
      } else {
        not_found(w, req)
      }
    }
    done = w.finish!
    break if done.err?
    break unless done.unwrap
    # Wait for the next request; shutdown closes us while we wait.
    if br.buffered == 0 {
      stop = srv.ctl.lock { |c|
        if c.shutting {
          true
        } else {
          c.idle[fd] = conn
          false
        }
      }
      break if stop
    }
  }
  srv.ctl.lock { |c| c.idle.delete(fd) }
}
