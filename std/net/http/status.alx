# HTTP status codes and their reason phrases, after Go's status.go
# (generated from Go 1.27's constants and StatusText).

pub STATUS_CONTINUE = 100
pub STATUS_SWITCHING_PROTOCOLS = 101
pub STATUS_PROCESSING = 102
pub STATUS_EARLY_HINTS = 103
pub STATUS_OK = 200
pub STATUS_CREATED = 201
pub STATUS_ACCEPTED = 202
pub STATUS_NON_AUTHORITATIVE_INFO = 203
pub STATUS_NO_CONTENT = 204
pub STATUS_RESET_CONTENT = 205
pub STATUS_PARTIAL_CONTENT = 206
pub STATUS_MULTI_STATUS = 207
pub STATUS_ALREADY_REPORTED = 208
pub STATUS_IM_USED = 226
pub STATUS_MULTIPLE_CHOICES = 300
pub STATUS_MOVED_PERMANENTLY = 301
pub STATUS_FOUND = 302
pub STATUS_SEE_OTHER = 303
pub STATUS_NOT_MODIFIED = 304
pub STATUS_USE_PROXY = 305
pub STATUS_TEMPORARY_REDIRECT = 307
pub STATUS_PERMANENT_REDIRECT = 308
pub STATUS_BAD_REQUEST = 400
pub STATUS_UNAUTHORIZED = 401
pub STATUS_PAYMENT_REQUIRED = 402
pub STATUS_FORBIDDEN = 403
pub STATUS_NOT_FOUND = 404
pub STATUS_METHOD_NOT_ALLOWED = 405
pub STATUS_NOT_ACCEPTABLE = 406
pub STATUS_PROXY_AUTH_REQUIRED = 407
pub STATUS_REQUEST_TIMEOUT = 408
pub STATUS_CONFLICT = 409
pub STATUS_GONE = 410
pub STATUS_LENGTH_REQUIRED = 411
pub STATUS_PRECONDITION_FAILED = 412
pub STATUS_REQUEST_ENTITY_TOO_LARGE = 413
pub STATUS_REQUEST_URI_TOO_LONG = 414
pub STATUS_UNSUPPORTED_MEDIA_TYPE = 415
pub STATUS_REQUESTED_RANGE_NOT_SATISFIABLE = 416
pub STATUS_EXPECTATION_FAILED = 417
pub STATUS_TEAPOT = 418
pub STATUS_MISDIRECTED_REQUEST = 421
pub STATUS_UNPROCESSABLE_ENTITY = 422
pub STATUS_LOCKED = 423
pub STATUS_FAILED_DEPENDENCY = 424
pub STATUS_TOO_EARLY = 425
pub STATUS_UPGRADE_REQUIRED = 426
pub STATUS_PRECONDITION_REQUIRED = 428
pub STATUS_TOO_MANY_REQUESTS = 429
pub STATUS_REQUEST_HEADER_FIELDS_TOO_LARGE = 431
pub STATUS_UNAVAILABLE_FOR_LEGAL_REASONS = 451
pub STATUS_INTERNAL_SERVER_ERROR = 500
pub STATUS_NOT_IMPLEMENTED = 501
pub STATUS_BAD_GATEWAY = 502
pub STATUS_SERVICE_UNAVAILABLE = 503
pub STATUS_GATEWAY_TIMEOUT = 504
pub STATUS_HTTP_VERSION_NOT_SUPPORTED = 505
pub STATUS_VARIANT_ALSO_NEGOTIATES = 506
pub STATUS_INSUFFICIENT_STORAGE = 507
pub STATUS_LOOP_DETECTED = 508
pub STATUS_NOT_EXTENDED = 510
pub STATUS_NETWORK_AUTHENTICATION_REQUIRED = 511

# Older alx names, kept.
pub STATUS_PAYLOAD_TOO_LARGE = 413
pub STATUS_URI_TOO_LONG = 414
pub STATUS_HEADER_FIELDS_TOO_LARGE = 431
pub STATUS_VERSION_NOT_SUPPORTED = 505

pub METHOD_GET = "GET"
pub METHOD_HEAD = "HEAD"
pub METHOD_POST = "POST"
pub METHOD_PUT = "PUT"
pub METHOD_PATCH = "PATCH"
pub METHOD_DELETE = "DELETE"
pub METHOD_CONNECT = "CONNECT"
pub METHOD_OPTIONS = "OPTIONS"
pub METHOD_TRACE = "TRACE"

# The reason phrase of a status code ("Not Found"), "" for an unknown code.
pub def status_text(code: Int) -> Str {
  case code {
    100 => "Continue"
    101 => "Switching Protocols"
    102 => "Processing"
    103 => "Early Hints"
    200 => "OK"
    201 => "Created"
    202 => "Accepted"
    203 => "Non-Authoritative Information"
    204 => "No Content"
    205 => "Reset Content"
    206 => "Partial Content"
    207 => "Multi-Status"
    208 => "Already Reported"
    226 => "IM Used"
    300 => "Multiple Choices"
    301 => "Moved Permanently"
    302 => "Found"
    303 => "See Other"
    304 => "Not Modified"
    305 => "Use Proxy"
    307 => "Temporary Redirect"
    308 => "Permanent Redirect"
    400 => "Bad Request"
    401 => "Unauthorized"
    402 => "Payment Required"
    403 => "Forbidden"
    404 => "Not Found"
    405 => "Method Not Allowed"
    406 => "Not Acceptable"
    407 => "Proxy Authentication Required"
    408 => "Request Timeout"
    409 => "Conflict"
    410 => "Gone"
    411 => "Length Required"
    412 => "Precondition Failed"
    413 => "Request Entity Too Large"
    414 => "Request URI Too Long"
    415 => "Unsupported Media Type"
    416 => "Requested Range Not Satisfiable"
    417 => "Expectation Failed"
    418 => "I'm a teapot"
    421 => "Misdirected Request"
    422 => "Unprocessable Entity"
    423 => "Locked"
    424 => "Failed Dependency"
    425 => "Too Early"
    426 => "Upgrade Required"
    428 => "Precondition Required"
    429 => "Too Many Requests"
    431 => "Request Header Fields Too Large"
    451 => "Unavailable For Legal Reasons"
    500 => "Internal Server Error"
    501 => "Not Implemented"
    502 => "Bad Gateway"
    503 => "Service Unavailable"
    504 => "Gateway Timeout"
    505 => "HTTP Version Not Supported"
    506 => "Variant Also Negotiates"
    507 => "Insufficient Storage"
    508 => "Loop Detected"
    510 => "Not Extended"
    511 => "Network Authentication Required"
    _ => ""
  }
}
