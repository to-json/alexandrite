import "strings"
import "strconv"
import nurl "net/url"

pub error HttpError {
  # A malformed request (the server answers 400).
  BadRequest(why: Str)
  # A malformed response from the server.
  BadResponse(why: Str)
  # A URL the client can't use.
  BadUrl(why: Str)
  # A message over the size limits.
  TooLarge(why: Str)
  # The connection ended in the middle of a message.
  Eof(what: Str)
  # `serve` returns this once `shutdown` has been called.
  ServerClosed

  def message -> Str {
    case self {
      BadRequest(w) => "http: bad request: #{w}"
      BadResponse(w) => "http: bad response: #{w}"
      BadUrl(w) => "http: bad url: #{w}"
      TooLarge(w) => "http: too large: #{w}"
      Eof(w) => "http: unexpected EOF in #{w}"
      ServerClosed => "http: Server closed"
    }
  }
}

# Percent-decodes s (net/url's query_unescape with `plus`, where "+" is a
# space; else path_unescape, which keeps it). A malformed escape is a
# BadRequest.
pub def unescape(s: Str, plus: Bool) -> ~Str {
  r = plus ? nurl.query_unescape(s) : nurl.path_unescape(s)
  fail HttpError.BadRequest("invalid URL escape in #{s}") if r.err?
  r.unwrap
}

# Escapes s for a query component (net/url's query_escape).
pub def query_escape(s: Str) -> Str { nurl.query_escape(s) }

# Escapes s for a path segment (net/url's path_escape).
pub def path_escape(s: Str) -> Str { nurl.path_escape(s) }

# The value of `key` in a raw query string ("a=1&b=2"), decoded; the first
# one wins. none if absent. Malformed pairs are skipped (net/url's
# parse_query, as Go's Request.FormValue).
pub def query_value(raw: Str, key: Str) -> Str? {
  v, _ = nurl.parse_query_lax(raw)
  return none unless v.has?(key)
  v.get(key)
}

# Every (key, value) pair of a raw query string, decoded, in order (pairs
# that don't decode are kept as written).
pub def query_pairs(raw: Str) -> [(Str, Str)] {
  out: [(Str, Str)] = []
  for part in strings.split(raw, "&") {
    next if part.size == 0
    k = part
    v = ""
    if kv = strings.cut(part, "=") {
      k, v = kv
    }
    out << (nurl.query_unescape(k).unwrap_or(k), nurl.query_unescape(v).unwrap_or(v))
  }
  out
}

# A parsed "http://host:port/path?query" (the only scheme the client speaks).
pub struct Url {
  scheme: Str
  host: Str
  port: Int
  # the path as escaped in the URL
  path: Str
  raw_query: Str

  # "host:port" for dialing.
  pub def host_port -> Str {
    "#{host}:#{port}"
  }

  # The Host header value (the port is left out when it's the default).
  pub def host_header -> Str {
    return host if port == 80 && scheme == "http"
    return host if port == 443 && scheme == "https"
    "#{host}:#{port}"
  }

  # The request target: path plus "?query".
  pub def request_uri -> Str {
    p = path.size == 0 ? "/" : path
    raw_query.size == 0 ? p : "#{p}?#{raw_query}"
  }
}

# Parses an http URL (net/url's parse; a missing scheme means http).
pub def parse_url(u: Str) -> ~Url {
  s = strings.contains(u, "://") ? u : "http://" + u
  r = nurl.parse(s)
  fail HttpError.BadUrl(r.err.unwrap.message) if r.err?
  pu = r.unwrap
  fail HttpError.BadUrl("unsupported scheme #{pu.scheme}") if pu.scheme != "http"
  fail HttpError.BadUrl("missing host in #{u}") if pu.host.size == 0
  port = 80
  if pu.port != "" {
    port = strconv.atoi(pu.port).unwrap_or(-1)
    fail HttpError.BadUrl("invalid port in #{u}") if port < 0 || port > 65535
  }
  Url.new(scheme: pu.scheme, host: pu.hostname, port: port, path: pu.escaped_path, raw_query: pu.raw_query)
}

# `ref` (a redirect's Location) resolved against the URL `base`.
pub def resolve_url(base: Str, ref: Str) -> ~Str {
  b = nurl.parse(base)
  fail HttpError.BadUrl(b.err.unwrap.message) if b.err?
  r = nurl.parse(ref)
  fail HttpError.BadUrl(r.err.unwrap.message) if r.err?
  b.unwrap.resolve_reference(r.unwrap).to_s
}
