test "vectors: parse set cookie 1" {
  assert_eq psc("SID=99=x;samesite=STRICT; Max-Age=60 ;Expires=Wed, 23-Nov-2011 01:05:03 GMT"), "SID|99=x|false|||1322010303|Wed, 23-Nov-2011 01:05:03 GMT|60|false|false|3|false|"
