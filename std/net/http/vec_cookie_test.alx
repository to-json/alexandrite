  assert_eq rc("aa,b ; c$=;;=\"q\" ; c$=\"q\"", "SID"), ""
  assert_eq pc("\t=v ;  sp =\"a b\";c$=\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=v ;  sp =\"a b\";c$=\"a b\"", "x-y"), ""
