  assert_eq psc(" sp =; Unknown=1"), "sp||false|||zero||0|false|false|0|false|Unknown=1"
  assert_eq psc("\t==;Unknown=1"), "ERR http: invalid cookie name"
  assert_eq psc("=a,b"), "ERR http: invalid cookie name"
  assert_eq psc("c$= lead"), "c$| lead|false|||zero||0|false|false|0|false|"
  assert_eq psc("c$v ;Partitioned ;Path=\"/q\";Domain=bad-.x"), "ERR http: '=' not found in cookie"
  assert_eq psc("=\";domain=example.com; Unknown=1"), "ERR http: invalid cookie name"
  assert_eq psc("na;me=99=x;é=1;expires=Tue, 10 Nov 2009 23:00:00 GMT"), "ERR http: '=' not found in cookie"
  assert_eq psc("c$x\\y; ;SameSite=x"), "ERR http: '=' not found in cookie"
  assert_eq psc("c$=v; HttpOnly ;Domain=bad-.x;Unknown=1"), "c$|v|false||bad-.x|zero||0|false|true|0|false|Unknown=1"
  assert_eq psc(" sp x\\y; ;samesite=STRICT"), "ERR http: '=' not found in cookie"
  assert_eq psc("a=99=x;Expires=bogus"), "a|99=x|false|||zero|bogus|0|false|false|0|false|Expires=bogus"
  assert_eq psc(" sp =a z ;Unknown=1;Max-Age=abc ;"), "sp|a z|false|||zero||0|false|false|0|false|Unknown=1,Max-Age=abc"
  assert_eq psc(" sp =é ;Partitioned; Max-Age=60"), "ERR http: invalid cookie value"
  assert_eq psc(" sp =a z ;samesite=STRICT"), "sp|a z|false|||zero||0|false|false|3|false|"
  assert_eq psc("na;me=\"q\"; Max-Age=abc"), "ERR http: '=' not found in cookie"
  assert_eq psc("a b=\"; flag"), "ERR http: invalid cookie name"
  assert_eq psc("SID= lead; max-age=\"30\""), "SID| lead|false|||zero||0|false|false|0|false|max-age=\"30\""
  assert_eq psc("na;me=a,b; Path=\"/q\"; SameSite;Unknown=1"), "ERR http: '=' not found in cookie"
  assert_eq psc("a b=x\\y; max-age=\"30\""), "ERR http: invalid cookie name"
  assert_eq psc(" sp =x\\y ;Comment=\"hi\";Expires=Wed, 23-Nov-2011 01:05:03 GMT ;Comment=\"hi\""), "ERR http: invalid cookie value"
  assert_eq psc(" sp = lead;path=/a/b ;Domain=bad-.x"), "sp| lead|false|/a/b|bad-.x|zero||0|false|false|0|false|"
  assert_eq psc("SID"), "ERR http: '=' not found in cookie"
  assert_eq psc(" sp =é; domain=example.com"), "ERR http: invalid cookie value"
  assert_eq psc("a b=\"a b\";domain=example.com"), "ERR http: invalid cookie name"
  assert_eq psc("x-ya z; SameSite;max-age=0"), "ERR http: '=' not found in cookie"
  assert_eq psc("a=v;; Path=/"), "a|v|false|/||zero||0|false|false|0|false|"
  assert_eq psc(" sp =v;"), "sp|v|false|||zero||0|false|false|0|false|"
  assert_eq psc("a=a z;max-age=\"30\"; Path=\"/q\""), "a|a z|false|||zero||0|false|false|0|false|max-age=\"30\",Path=\"/q\""
  assert_eq psc("é=\"; Comment=\"hi\";  ; max-age=0"), "ERR http: invalid cookie name"
  assert_eq psc(" sp =x\\y;Partitioned"), "ERR http: invalid cookie value"
  assert_eq psc("x-y=v;max-age=\"30\"; SameSite=x ;path=/a/b"), "x-y|v|false|/a/b||zero||0|false|false|1|false|max-age=\"30\""
  assert_eq psc(" sp =\"a b\"; SameSite=None ;Expires=bogus ;httponly"), "sp|a b|true|||zero|bogus|0|false|true|4|false|Expires=bogus"
  assert_eq psc("a b=x\\y ;é=1 ;flag; Partitioned"), "ERR http: invalid cookie name"
  assert_eq psc("SID=;max-age=\"30\""), "SID||false|||zero||0|false|false|0|false|max-age=\"30\""
  assert_eq psc("é=99=x"), "ERR http: invalid cookie name"
  assert_eq psc(" sp \""), "ERR http: '=' not found in cookie"
  assert_eq psc("na;me=x\\y ;max-age=0;max-age=0"), "ERR http: '=' not found in cookie"
  assert_eq psc(" sp =\";Secure ;Path=\"/q\""), "ERR http: invalid cookie value"
  assert_eq psc("SID=\";Max-Age=-5;Secure"), "ERR http: invalid cookie value"
  assert_eq psc("== ;max-age=0;Partitioned ;Expires=bogus"), "ERR http: invalid cookie name"
  assert_eq psc("x-y=\";Partitioned; Max-Age=-5"), "ERR http: invalid cookie value"
  assert_eq psc("a=\"a b\";Unknown=1 ;Comment=\"hi\""), "a|a b|true|||zero||0|false|false|0|false|Unknown=1,Comment=\"hi\""
  assert_eq psc("éa,b ;Secure"), "ERR http: '=' not found in cookie"
  assert_eq psc("\t=é; é=1"), "ERR http: invalid cookie name"
  assert_eq psc("a b= lead; SameSite=None"), "ERR http: invalid cookie name"
  assert_eq psc("a b=99=x; Max-Age=07"), "ERR http: invalid cookie name"
  assert_eq psc("é=v; ;max-age=0; SameSite=None; Unknown=1"), "ERR http: invalid cookie name"
  assert_eq psc("SID=é; "), "ERR http: invalid cookie value"
  assert_eq psc("c$=v; ;Partitioned; SameSite=None"), "c$|v|false|||zero||0|false|false|4|true|"
  assert_eq psc("SID=99=x; Secure;Secure ;Expires=Wed, 23-Nov-2011 01:05:03 GMT"), "SID|99=x|false|||1322010303|Wed, 23-Nov-2011 01:05:03 GMT|0|true|false|0|false|"
  assert_eq psc("na;me99=x ;Max-Age=60; ; Unknown=1"), "ERR http: '=' not found in cookie"
  assert_eq psc("na;me\"a b\"; httponly;  ;Partitioned"), "ERR http: '=' not found in cookie"
  assert_eq psc("é= lead;é=1"), "ERR http: invalid cookie name"
  assert_eq psc("x-y99=x; Path=/;Max-Age=-5; "), "x-y99|x|false|/||zero||-1|false|false|0|false|"
  assert_eq psc(""), "ERR http: blank cookie"
  assert_eq psc("na;me=\" ;Max-Age=-5;path=/a/b; path=a;b"), "ERR http: '=' not found in cookie"
  assert_eq psc(" sp = lead ;Expires=Wed, 23-Nov-2011 01:05:03 GMT ;Secure"), "sp| lead|false|||1322010303|Wed, 23-Nov-2011 01:05:03 GMT|0|true|false|0|false|"
  assert_eq psc("a ba,b ;Max-Age=abc;Max-Age=60;Unknown=1"), "ERR http: '=' not found in cookie"
  assert_eq psc("a b=\"; Expires=Wed, 23-Nov-2011 01:05:03 GMT"), "ERR http: invalid cookie name"
  assert_eq psc("é=v;HttpOnly;SameSite=Lax"), "ERR http: invalid cookie name"
  assert_eq psc("SID=;samesite=STRICT; SameSite"), "SID||false|||zero||0|false|false|1|false|"
  assert_eq psc("\t==; Domain=.example.com ;samesite=STRICT ;flag"), "ERR http: invalid cookie name"
  assert_eq psc("na;me=v; SameSite"), "ERR http: '=' not found in cookie"
}

