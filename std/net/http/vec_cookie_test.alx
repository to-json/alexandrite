  assert_eq psc("SID=a,b; SameSite;Max-Age=07 ;samesite=STRICT"), "SID|a,b|false|||zero||0|false|false|3|false|Max-Age=07"
  assert_eq psc("a=\"q\""), "a|q|true|||zero||0|false|false|0|false|"
