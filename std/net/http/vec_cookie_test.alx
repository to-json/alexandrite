  assert_eq psc("=\";  ;httponly"), "ERR http: invalid cookie name"
  assert_eq psc("c$=x\\y ;path=/a/b;SameSite=None;Expires=bogus"), "ERR http: invalid cookie value"
  assert_eq psc("a b=99=x ;é=1"), "ERR http: invalid cookie name"
  assert_eq psc("\t=v"), "ERR http: invalid cookie name"
  assert_eq psc("é=a,b"), "ERR http: invalid cookie name"
  assert_eq psc("\"q\";Domain=bad-.x"), "ERR http: '=' not found in cookie"
  assert_eq psc("é=v; Path=\"/q\" ;Max-Age=abc"), "ERR http: invalid cookie name"
  assert_eq psc("\t=99=x ;Partitioned; SameSite;Max-Age=60"), "ERR http: invalid cookie name"
