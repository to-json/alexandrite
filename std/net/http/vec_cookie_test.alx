  assert_eq psc(" sp =é"), "ERR http: invalid cookie value"
  assert_eq psc("SID=\"q\"; Max-Age=abc; Comment=\"hi\""), "SID|q|true|||zero||0|false|false|0|false|Max-Age=abc,Comment=\"hi\""
  assert_eq psc("c$=a z"), "c$|a z|false|||zero||0|false|false|0|false|"
  assert_eq psc("SID=\"a b\";Domain=bad-.x"), "SID|a b|true||bad-.x|zero||0|false|false|0|false|"
  assert_eq psc("a==; Max-Age=-5 ;Max-Age=abc"), "a|=|false|||zero||-1|false|false|0|false|Max-Age=abc"
  assert_eq psc("a b=v; max-age=0"), "ERR http: invalid cookie name"
  assert_eq psc("x-y=x\\y ;Unknown=1;   ;Path=/"), "ERR http: invalid cookie value"
  assert_eq psc("x-y=a z; SameSite=None;  ;Unknown=1"), "x-y|a z|false|||zero||0|false|false|4|false|Unknown=1"
  assert_eq psc("\t=\""), "ERR http: invalid cookie name"
  assert_eq psc("=x\\y ;Unknown=1"), "ERR http: invalid cookie name"
  assert_eq psc("é=a,b; Max-Age=07; Path=/ ;é=1"), "ERR http: invalid cookie name"
  assert_eq psc("na;me= lead ;Comment=\"hi\""), "ERR http: '=' not found in cookie"
  assert_eq psc("c$99=x; samesite=STRICT;Path=/;Unknown=1"), "c$99|x|false|/||zero||0|false|false|3|false|Unknown=1"
  assert_eq psc("a,b; Domain=.example.com; SameSite=x"), "ERR http: '=' not found in cookie"
  assert_eq psc("a=v;;Comment=\"hi\""), "a|v|false|||zero||0|false|false|0|false|Comment=\"hi\""
  assert_eq psc("é"), "ERR http: '=' not found in cookie"
  assert_eq psc("SID=="), "SID|=|false|||zero||0|false|false|0|false|"
  assert_eq psc("\"; Partitioned;Comment=\"hi\""), "ERR http: '=' not found in cookie"
  assert_eq psc("c$=v; max-age=0"), "c$|v|false|||zero||-1|false|false|0|false|"
  assert_eq psc("a b=v;; SameSite=x; é=1 ;Expires=bogus"), "ERR http: invalid cookie name"
  assert_eq psc("a=a z"), "a|a z|false|||zero||0|false|false|0|false|"
  assert_eq psc(" sp =\"a b\""), "sp|a b|true|||zero||0|false|false|0|false|"
  assert_eq psc(" sp == ;Partitioned"), "sp|=|false|||zero||0|false|false|0|true|"
  assert_eq psc("SID99=x; Domain=bad-.x;flag"), "SID99|x|false||bad-.x|zero||0|false|false|0|false|flag"
  assert_eq psc("a b= lead;  ;max-age=0 ;Secure"), "ERR http: invalid cookie name"
  assert_eq psc("c$=é;SameSite=None ;Path=\"/q\""), "ERR http: invalid cookie value"
  assert_eq psc("é\"a b\" ;Domain=bad-.x;Max-Age=abc ;httponly"), "ERR http: '=' not found in cookie"
  assert_eq psc("é=v;"), "ERR http: invalid cookie name"
  assert_eq psc("SID=99=x"), "SID|99=x|false|||zero||0|false|false|0|false|"
  assert_eq psc("x-y=v;;HttpOnly ; ;SameSite"), "x-y|v|false|||zero||0|false|true|1|false|"
  assert_eq psc("= lead; Comment=\"hi\"; flag ;Max-Age=60"), "ERR http: invalid cookie name"
  assert_eq psc("x-ya,b;SameSite=Lax; expires=Tue, 10 Nov 2009 23:00:00 GMT"), "ERR http: '=' not found in cookie"
  assert_eq psc("x-y=\"a b\""), "x-y|a b|true|||zero||0|false|false|0|false|"
  assert_eq psc("a,b ;flag ;max-age=0; Expires=bogus"), "ERR http: '=' not found in cookie"
  assert_eq psc("na;me=99=x ;Partitioned;Path=\"/q\"; "), "ERR http: '=' not found in cookie"
  assert_eq psc("c$\"a b\""), "ERR http: '=' not found in cookie"
  assert_eq psc("\t=a,b"), "ERR http: invalid cookie name"
  assert_eq psc("na;me=\";path=/a/b;  ;httponly"), "ERR http: '=' not found in cookie"
  assert_eq psc("SID=é ;path=/a/b; expires=Tue, 10 Nov 2009 23:00:00 GMT; HttpOnly"), "ERR http: invalid cookie value"
  assert_eq psc("c$=x\\y ;SameSite=Lax; SameSite=x ;SameSite=x"), "ERR http: invalid cookie value"
  assert_eq psc("x-y=v; SameSite=None;SameSite=x"), "x-y|v|false|||zero||0|false|false|1|false|"
  assert_eq psc("x-y=\"q\""), "x-y|q|true|||zero||0|false|false|0|false|"
  assert_eq psc("\t=a z"), "ERR http: invalid cookie name"
  assert_eq psc("ax\\y;SameSite=None ;expires=Tue, 10 Nov 2009 23:00:00 GMT"), "ERR http: '=' not found in cookie"
  assert_eq psc("na;meé; Path=\"/q\"; SameSite=x"), "ERR http: '=' not found in cookie"
  assert_eq psc("na;me=v ;SameSite=None; Comment=\"hi\"; Max-Age=-5"), "ERR http: '=' not found in cookie"
  assert_eq psc(" sp ="), "sp||false|||zero||0|false|false|0|false|"
  assert_eq psc(" sp =\"a b\" ;Max-Age=-5"), "sp|a b|true|||zero||-1|false|false|0|false|"
  assert_eq psc("x-y= lead ;Max-Age=abc"), "x-y| lead|false|||zero||0|false|false|0|false|Max-Age=abc"
  assert_eq psc("a=é; Secure; samesite=STRICT"), "ERR http: invalid cookie value"
  assert_eq psc("é=x\\y; domain=example.com;SameSite=x"), "ERR http: invalid cookie name"
  assert_eq psc(" sp ;Max-Age=-5; max-age=\"30\"; domain=example.com"), "ERR http: '=' not found in cookie"
  assert_eq psc("a=\"q\";é=1"), "a|q|true|||zero||0|false|false|0|false|"
  assert_eq psc("SID=a,b; SameSite=x; Expires=bogus; max-age=0"), "SID|a,b|false|||zero|bogus|-1|false|false|1|false|Expires=bogus"
  assert_eq psc(" sp =a z;expires=Tue, 10 Nov 2009 23:00:00 GMT"), "sp|a z|false|||1257894000|Tue, 10 Nov 2009 23:00:00 GMT|0|false|false|0|false|"
  assert_eq psc("na;me=\"q\" ;Max-Age=60;SameSite"), "ERR http: '=' not found in cookie"
  assert_eq psc("a b=\"; Domain=.example.com;Comment=\"hi\""), "ERR http: invalid cookie name"
  assert_eq psc("é=v"), "ERR http: invalid cookie name"
  assert_eq psc("SID=a z;Comment=\"hi\""), "SID|a z|false|||zero||0|false|false|0|false|Comment=\"hi\""
  assert_eq psc("\t=x\\y; SameSite=Lax"), "ERR http: invalid cookie name"
  assert_eq psc("c$=v; Domain=bad-.x;domain=example.com ;SameSite=None"), "c$|v|false||example.com|zero||0|false|false|4|false|"
  assert_eq psc("a=99=x"), "a|99=x|false|||zero||0|false|false|0|false|"
  assert_eq psc(" sp =v ;SameSite=Lax ;Path=/; Max-Age=abc"), "sp|v|false|/||zero||0|false|false|2|false|Max-Age=abc"
  assert_eq psc("a b=\"q\"; Expires=Wed, 23-Nov-2011 01:05:03 GMT; httponly; expires=Tue, 10 Nov 2009 23:00:00 GMT"), "ERR http: invalid cookie name"
  assert_eq psc("c$é;  "), "ERR http: '=' not found in cookie"
  assert_eq psc("a b= lead"), "ERR http: invalid cookie name"
  assert_eq psc(" sp =; max-age=\"30\";domain=example.com;Secure"), "sp||false||example.com|zero||0|true|false|0|false|max-age=\"30\""
  assert_eq psc("a="), "a||false|||zero||0|false|false|0|false|"
  assert_eq psc("x-y=\"a b\";HttpOnly ;Max-Age=07; max-age=\"30\""), "x-y|a b|true|||zero||0|false|true|0|false|Max-Age=07,max-age=\"30\""
  assert_eq psc("na;me=v"), "ERR http: '=' not found in cookie"
  assert_eq psc("a bv;;Expires=Wed, 23-Nov-2011 01:05:03 GMT; SameSite"), "ERR http: '=' not found in cookie"
  assert_eq psc(" sp = lead ;path=a;b; SameSite"), "sp| lead|false|a||zero||0|false|false|1|false|b"
  assert_eq psc("é=a z"), "ERR http: invalid cookie name"
  assert_eq psc("a b=\" ;Domain=bad-.x; SameSite=None"), "ERR http: invalid cookie name"
  assert_eq psc("a=é;path=a;b;Max-Age=-5"), "ERR http: invalid cookie value"
  assert_eq psc("c$=\"q\" ;max-age=\"30\";Max-Age=abc"), "c$|q|true|||zero||0|false|false|0|false|max-age=\"30\",Max-Age=abc"
  assert_eq psc("c$=x\\y"), "ERR http: invalid cookie value"
  assert_eq psc("é= lead ;SameSite=x"), "ERR http: invalid cookie name"
  assert_eq psc("a= lead;Domain=bad-.x"), "a| lead|false||bad-.x|zero||0|false|false|0|false|"
  assert_eq psc("SID=\"a b\"; Domain=bad-.x;Expires=bogus"), "SID|a b|true||bad-.x|zero|bogus|0|false|false|0|false|Expires=bogus"
  assert_eq psc("a b=v;; Secure;SameSite=None"), "ERR http: invalid cookie name"
  assert_eq psc("a b= lead ;Max-Age=abc; path=a;b"), "ERR http: invalid cookie name"
  assert_eq psc("é lead ;é=1 ;Domain=.example.com"), "ERR http: '=' not found in cookie"
  assert_eq psc("\t\"a b\" ;expires=Tue, 10 Nov 2009 23:00:00 GMT ;Max-Age=-5 ;Path=\"/q\""), "ERR http: '=' not found in cookie"
  assert_eq psc("=99=x;   ;max-age=0"), "ERR http: invalid cookie name"
  assert_eq psc("= lead ;path=/a/b; HttpOnly"), "ERR http: invalid cookie name"
  assert_eq psc("=v; ; flag"), "ERR http: invalid cookie name"
  assert_eq psc(" sp =\"a b\";Path=\"/q\";Max-Age=abc; max-age=0"), "sp|a b|true|||zero||-1|false|false|0|false|Path=\"/q\",Max-Age=abc"
  assert_eq psc(" sp = lead ;Expires=bogus;expires=Tue, 10 Nov 2009 23:00:00 GMT"), "sp| lead|false|||1257894000|Tue, 10 Nov 2009 23:00:00 GMT|0|false|false|0|false|Expires=bogus"
  assert_eq psc("a b=a,b; SameSite=None ;samesite=STRICT"), "ERR http: invalid cookie name"
  assert_eq psc("a=a,b;Path=/ ;"), "a|a,b|false|/||zero||0|false|false|0|false|"
  assert_eq psc("a b=v"), "ERR http: invalid cookie name"
  assert_eq psc("SID=x\\y"), "ERR http: invalid cookie value"
  assert_eq psc("\t99=x"), "99|x|false|||zero||0|false|false|0|false|"
}

test "vectors: parse set cookie 3" {
  assert_eq psc("a b=\"q\"; Path=\"/q\";domain=example.com;SameSite=x"), "ERR http: invalid cookie name"
  assert_eq psc("= ;HttpOnly;flag"), "ERR http: invalid cookie name"
  assert_eq psc("\t=é; SameSite=x;é=1; expires=Tue, 10 Nov 2009 23:00:00 GMT"), "ERR http: invalid cookie name"
  assert_eq psc("a= lead ;path=/a/b"), "a| lead|false|/a/b||zero||0|false|false|0|false|"
  assert_eq psc("SID=\"q\";Path=\"/q\" ;SameSite;Path=\"/q\""), "SID|q|true|||zero||0|false|false|1|false|Path=\"/q\",Path=\"/q\""
  assert_eq psc("a=v"), "a|v|false|||zero||0|false|false|0|false|"
  assert_eq psc("SID=\"a b\";path=/a/b"), "SID|a b|true|/a/b||zero||0|false|false|0|false|"
  assert_eq psc(" sp =a z; HttpOnly"), "sp|a z|false|||zero||0|false|true|0|false|"
  assert_eq psc("av; Partitioned;Unknown=1"), "ERR http: '=' not found in cookie"
  assert_eq psc("a b=\";Path=/"), "ERR http: invalid cookie name"
  assert_eq psc("c$=é ;max-age=0; Max-Age=60;Domain=bad-.x"), "ERR http: invalid cookie value"
  assert_eq psc("c$==;SameSite=None; path=a;b;samesite=STRICT"), "c$|=|false|a||zero||0|false|false|3|false|b"
  assert_eq psc("SID=v; expires=Tue, 10 Nov 2009 23:00:00 GMT"), "SID|v|false|||1257894000|Tue, 10 Nov 2009 23:00:00 GMT|0|false|false|0|false|"
  assert_eq psc("é=99=x;Max-Age=abc"), "ERR http: invalid cookie name"
  assert_eq psc("é=\"a b\""), "ERR http: invalid cookie name"
  assert_eq psc("na;me=a z;httponly;samesite=STRICT;Unknown=1"), "ERR http: '=' not found in cookie"
  assert_eq psc("na;me=x\\y ;é=1;Expires=Wed, 23-Nov-2011 01:05:03 GMT; flag"), "ERR http: '=' not found in cookie"
  assert_eq psc("c$=v;; "), "c$|v|false|||zero||0|false|false|0|false|"
  assert_eq psc("v;; Path=\"/q\";Unknown=1"), "ERR http: '=' not found in cookie"
  assert_eq psc("=é; Unknown=1"), "ERR http: invalid cookie name"
  assert_eq psc("= lead"), "ERR http: invalid cookie name"
  assert_eq psc("c$a z;é=1"), "ERR http: '=' not found in cookie"
  assert_eq psc("\t== ;Secure ;max-age=\"30\" ;Max-Age=abc"), "ERR http: invalid cookie name"
  assert_eq psc("SID=é ;Partitioned"), "ERR http: invalid cookie value"
  assert_eq psc("=é"), "ERR http: invalid cookie name"
  assert_eq psc("na;me=v;Expires=bogus ;Path=/"), "ERR http: '=' not found in cookie"
  assert_eq psc("=a,b; Expires=bogus ;path=a;b; Max-Age=abc"), "ERR http: invalid cookie name"
  assert_eq psc("\t=\" ;path=a;b"), "ERR http: invalid cookie name"
  assert_eq psc(" sp =é;Max-Age=07; max-age=0"), "ERR http: invalid cookie value"
  assert_eq psc("na;me=v; expires=Tue, 10 Nov 2009 23:00:00 GMT; "), "ERR http: '=' not found in cookie"
  assert_eq psc("c$=v"), "c$|v|false|||zero||0|false|false|0|false|"
  assert_eq psc("a b=x\\y ;SameSite=Lax;Domain=.example.com ;Unknown=1"), "ERR http: invalid cookie name"
  assert_eq psc("a b=a z; ; Domain=bad-.x"), "ERR http: invalid cookie name"
  assert_eq psc("a=a,b; Unknown=1; SameSite=x"), "a|a,b|false|||zero||0|false|false|1|false|Unknown=1"
  assert_eq psc("a=; Max-Age=60"), "a||false|||zero||60|false|false|0|false|"
  assert_eq psc("SID=\"a b\";flag ; "), "SID|a b|true|||zero||0|false|false|0|false|flag"
  assert_eq psc("=a z; max-age=\"30\""), "ERR http: invalid cookie name"
  assert_eq psc("x-y99=x"), "x-y99|x|false|||zero||0|false|false|0|false|"
  assert_eq psc("x-y=x\\y;domain=example.com"), "ERR http: invalid cookie value"
  assert_eq psc(" sp =\"a b\" ;Domain=.example.com;Domain=.example.com; path=/a/b"), "sp|a b|true|/a/b|.example.com|zero||0|false|false|0|false|"
  assert_eq psc(" sp =99=x"), "sp|99=x|false|||zero||0|false|false|0|false|"
  assert_eq psc("a=;HttpOnly ; ;Comment=\"hi\""), "a||false|||zero||0|false|true|0|false|Comment=\"hi\""
  assert_eq psc("\t=a,b; samesite=STRICT; SameSite=x"), "ERR http: invalid cookie name"
  assert_eq psc(" sp =x\\y ;Domain=bad-.x;Expires=Wed, 23-Nov-2011 01:05:03 GMT; "), "ERR http: invalid cookie value"
  assert_eq psc("\t=v;;flag"), "ERR http: invalid cookie name"
  assert_eq psc("na;me=="), "ERR http: '=' not found in cookie"
  assert_eq psc("a b=a,b;max-age=0 ;Domain=.example.com; SameSite=Lax"), "ERR http: invalid cookie name"
  assert_eq psc(" sp ==;HttpOnly; expires=Tue, 10 Nov 2009 23:00:00 GMT; domain=example.com"), "sp|=|false||example.com|1257894000|Tue, 10 Nov 2009 23:00:00 GMT|0|false|true|0|false|"
  assert_eq psc("a b;max-age=\"30\""), "ERR http: '=' not found in cookie"
  assert_eq psc("\"q\";Max-Age=-5 ;max-age=0"), "ERR http: '=' not found in cookie"
  assert_eq psc(" sp =\"a b\" ;Secure"), "sp|a b|true|||zero||0|true|false|0|false|"
  assert_eq psc("a=v; Unknown=1"), "a|v|false|||zero||0|false|false|0|false|Unknown=1"
  assert_eq psc("\t=\"q\"; max-age=0;path=a;b ;Max-Age=07"), "ERR http: invalid cookie name"
  assert_eq psc("a b== ;Secure"), "ERR http: invalid cookie name"
  assert_eq psc("a b=a,b ;Max-Age=60; Partitioned;Max-Age=abc"), "ERR http: invalid cookie name"
  assert_eq psc("a b=99=x; Unknown=1; Expires=bogus"), "ERR http: invalid cookie name"
  assert_eq psc("c$== ;Max-Age=60"), "c$|=|false|||zero||60|false|false|0|false|"
  assert_eq psc("x-y=\"q\";Expires=Wed, 23-Nov-2011 01:05:03 GMT;Partitioned"), "x-y|q|true|||1322010303|Wed, 23-Nov-2011 01:05:03 GMT|0|false|false|0|true|"
  assert_eq psc("na;me== ;é=1;Max-Age=60;max-age=0"), "ERR http: '=' not found in cookie"
  assert_eq psc("SID=v"), "SID|v|false|||zero||0|false|false|0|false|"
  assert_eq psc("a bx\\y ;é=1;Expires=bogus"), "ERR http: '=' not found in cookie"
  assert_eq psc("\t=\"; Expires=Wed, 23-Nov-2011 01:05:03 GMT; flag"), "ERR http: invalid cookie name"
  assert_eq psc("\t=\"a b\"; Domain=.example.com"), "ERR http: invalid cookie name"
  assert_eq psc("SID=a,b;Domain=.example.com"), "SID|a,b|false||.example.com|zero||0|false|false|0|false|"
  assert_eq psc("a=a,b; ;Partitioned"), "a|a,b|false|||zero||0|false|false|0|true|"
  assert_eq psc("a=; max-age=\"30\"; Path=\"/q\""), "a||false|||zero||0|false|false|0|false|max-age=\"30\",Path=\"/q\""
  assert_eq psc("x-y=99=x ;Max-Age=60;HttpOnly ;samesite=STRICT"), "x-y|99=x|false|||zero||60|false|true|3|false|"
  assert_eq psc("c$=\"q\";max-age=0"), "c$|q|true|||zero||-1|false|false|0|false|"
  assert_eq psc("a=v;;Max-Age=abc; é=1"), "a|v|false|||zero||0|false|false|0|false|Max-Age=abc"
  assert_eq psc("a=\";domain=example.com;Secure"), "ERR http: invalid cookie value"
  assert_eq psc("=\"q\" ;SameSite=x; Secure"), "ERR http: invalid cookie name"
  assert_eq psc("x-y==;é=1 ;HttpOnly"), "x-y|=|false|||zero||0|false|true|0|false|"
  assert_eq psc("a b=a,b ;Domain=.example.com;Max-Age=07"), "ERR http: invalid cookie name"
  assert_eq psc("na;me=99=x;domain=example.com"), "ERR http: '=' not found in cookie"
  assert_eq psc("na;me99=x"), "ERR http: '=' not found in cookie"
  assert_eq psc("x-y=v;"), "x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq psc("é= lead ;max-age=\"30\""), "ERR http: invalid cookie name"
  assert_eq psc("=v ;expires=Tue, 10 Nov 2009 23:00:00 GMT;Path=/"), "ERR http: invalid cookie name"
  assert_eq psc("x-y=\";flag;é=1 ;path=/a/b"), "ERR http: invalid cookie value"
  assert_eq psc("av"), "ERR http: '=' not found in cookie"
  assert_eq psc("c$=a z ;SameSite=None; Secure; Domain=bad-.x"), "c$|a z|false||bad-.x|zero||0|true|false|4|false|"
  assert_eq psc("na;me\"a b\""), "ERR http: '=' not found in cookie"
  assert_eq psc("\t=é;Partitioned;Max-Age=-5"), "ERR http: invalid cookie name"
  assert_eq psc("x-y=\" ;Max-Age=abc; ; httponly"), "ERR http: invalid cookie value"
  assert_eq psc(" sp =v; ;Path=\"/q\" ;Max-Age=60; Path=\"/q\""), "sp|v|false|||zero||60|false|false|0|false|Path=\"/q\",Path=\"/q\""
  assert_eq psc("c$\"a b\"; Max-Age=abc;domain=example.com"), "ERR http: '=' not found in cookie"
  assert_eq psc("é=a,b;Expires=bogus;SameSite=None ;Expires=bogus"), "ERR http: invalid cookie name"
  assert_eq psc("\t= lead; Path=\"/q\";Unknown=1; Path=/"), "ERR http: invalid cookie name"
  assert_eq psc("=\" ;path=/a/b"), "ERR http: invalid cookie name"
  assert_eq psc("SID=x\\y ;Domain=bad-.x; SameSite"), "ERR http: invalid cookie value"
  assert_eq psc("na;me=\"q\";SameSite=x ;Max-Age=abc; Expires=bogus"), "ERR http: '=' not found in cookie"
  assert_eq psc(" sp =a z; expires=Tue, 10 Nov 2009 23:00:00 GMT"), "sp|a z|false|||1257894000|Tue, 10 Nov 2009 23:00:00 GMT|0|false|false|0|false|"
  assert_eq psc("é=\"a b\"; Max-Age=abc"), "ERR http: invalid cookie name"
  assert_eq psc("a=\"a b\"; Max-Age=abc"), "a|a b|true|||zero||0|false|false|0|false|Max-Age=abc"
  assert_eq psc("é=\"q\"; Expires=Wed, 23-Nov-2011 01:05:03 GMT; max-age=\"30\" ;Domain=.example.com"), "ERR http: invalid cookie name"
  assert_eq psc("SID=a,b;SameSite ;path=a;b; Max-Age=60"), "SID|a,b|false|a||zero||60|false|false|1|false|b"
  assert_eq psc("na;me=\" ;Partitioned; Path=/ ;flag"), "ERR http: '=' not found in cookie"
  assert_eq psc("é=99=x; Path=/;samesite=STRICT"), "ERR http: invalid cookie name"
  assert_eq psc("na;mev; ;Max-Age=-5; Max-Age=abc"), "ERR http: '=' not found in cookie"
  assert_eq psc("a bv; ;Path=\"/q\";Comment=\"hi\"; path=a;b"), "ERR http: '=' not found in cookie"
}

test "vectors: parse set cookie 4" {
  assert_eq psc("\t=\"q\" ;Max-Age=abc"), "ERR http: invalid cookie name"
  assert_eq psc("\t=x\\y ;path=a;b"), "ERR http: invalid cookie name"
  assert_eq psc("é=\"; domain=example.com ;  ;Path=\"/q\""), "ERR http: invalid cookie name"
  assert_eq psc("x-y==;"), "x-y|=|false|||zero||0|false|false|0|false|"
  assert_eq psc(" sp =v; SameSite=Lax ;Secure"), "sp|v|false|||zero||0|true|false|2|false|"
  assert_eq psc(" sp =99=x; HttpOnly; HttpOnly"), "sp|99=x|false|||zero||0|false|true|0|false|"
  assert_eq psc("\t=\"q\"; path=a;b"), "ERR http: invalid cookie name"
  assert_eq psc("éé;SameSite=x"), "ERR http: '=' not found in cookie"
  assert_eq psc("=v;"), "ERR http: invalid cookie name"
  assert_eq psc("na;me=a,b; "), "ERR http: '=' not found in cookie"
  assert_eq psc("SID= lead; Max-Age=-5 ;Comment=\"hi\" ;path=/a/b"), "SID| lead|false|/a/b||zero||-1|false|false|0|false|Comment=\"hi\""
  assert_eq psc("x-y=\"; SameSite=None ;Secure"), "ERR http: invalid cookie value"
  assert_eq psc("na;me=99=x; path=a;b"), "ERR http: '=' not found in cookie"
  assert_eq psc("c$=;httponly;path=/a/b ;Secure"), "c$||false|/a/b||zero||0|true|true|0|false|"
  assert_eq psc("na;me lead ;Max-Age=abc"), "ERR http: '=' not found in cookie"
  assert_eq psc("c$99=x ;domain=example.com"), "c$99|x|false||example.com|zero||0|false|false|0|false|"
  assert_eq psc("SID=99=x; httponly"), "SID|99=x|false|||zero||0|false|true|0|false|"
  assert_eq psc("c$=\"a b\";SameSite;Path=\"/q\" ;Comment=\"hi\""), "c$|a b|true|||zero||0|false|false|1|false|Path=\"/q\",Comment=\"hi\""
  assert_eq psc("é=v;;; Partitioned ;Path=/"), "ERR http: invalid cookie name"
  assert_eq psc("x-y=\"a b\";Comment=\"hi\" ;Domain=bad-.x ;SameSite"), "x-y|a b|true||bad-.x|zero||0|false|false|1|false|Comment=\"hi\""
  assert_eq psc("na;me=v; SameSite=Lax; SameSite=None"), "ERR http: '=' not found in cookie"
  assert_eq psc(" sp =\"q\"; ;Unknown=1"), "sp|q|true|||zero||0|false|false|0|false|Unknown=1"
  assert_eq psc("é99=x;Path=/; Path=\"/q\""), "ERR http: invalid cookie name"
  assert_eq psc("\t="), "ERR http: invalid cookie name"
  assert_eq psc("\t=x\\y ;Domain=bad-.x"), "ERR http: invalid cookie name"
  assert_eq psc("a\" ;max-age=0"), "ERR http: '=' not found in cookie"
  assert_eq psc("na;me=x\\y;Max-Age=-5; Domain=.example.com"), "ERR http: '=' not found in cookie"
  assert_eq psc("na;me=v; ;HttpOnly;path=a;b"), "ERR http: '=' not found in cookie"
  assert_eq psc("SID="), "SID||false|||zero||0|false|false|0|false|"
  assert_eq psc("c$=a z;Max-Age=07;Max-Age=abc"), "c$|a z|false|||zero||0|false|false|0|false|Max-Age=07,Max-Age=abc"
  assert_eq psc("x-y= lead; Expires=Wed, 23-Nov-2011 01:05:03 GMT"), "x-y| lead|false|||1322010303|Wed, 23-Nov-2011 01:05:03 GMT|0|false|false|0|false|"
  assert_eq psc("\t=\" ;Expires=bogus"), "ERR http: invalid cookie name"
  assert_eq psc(" sp =\";SameSite=Lax; HttpOnly"), "ERR http: invalid cookie value"
  assert_eq psc(" sp ;HttpOnly;path=/a/b"), "ERR http: '=' not found in cookie"
  assert_eq psc("é=v; Max-Age=07"), "ERR http: invalid cookie name"
