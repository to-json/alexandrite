test "vectors: parse set cookie 6" {
  assert_eq psc("a=é ;SameSite=Lax"), "ERR http: invalid cookie value"
  assert_eq psc("a=\"q\" ;SameSite=x"), "a|q|true|||zero||0|false|false|1|false|"
  assert_eq psc("SID=v;Domain=bad-.x"), "SID|v|false||bad-.x|zero||0|false|false|0|false|"
  assert_eq psc("x-y= lead;path=a;b;Expires=bogus; expires=Tue, 10 Nov 2009 23:00:00 GMT"), "x-y| lead|false|a||1257894000|Tue, 10 Nov 2009 23:00:00 GMT|0|false|false|0|false|b,Expires=bogus"
  assert_eq psc("=\"; domain=example.com"), "ERR http: invalid cookie name"
  assert_eq psc("c$==; Secure; path=/a/b"), "c$|=|false|/a/b||zero||0|true|false|0|false|"
  assert_eq psc(" ;HttpOnly;SameSite=Lax; SameSite=Lax"), "ERR http: '=' not found in cookie"
  assert_eq psc("na;me=;SameSite"), "ERR http: '=' not found in cookie"
  assert_eq psc(" sp = lead; Unknown=1 ;Partitioned; Max-Age=abc"), "sp| lead|false|||zero||0|false|false|0|true|Unknown=1,Max-Age=abc"
  assert_eq psc("c$=99=x ;SameSite=x; "), "c$|99=x|false|||zero||0|false|false|1|false|"
  assert_eq psc("é=v;;"), "ERR http: invalid cookie name"
  assert_eq psc(" sp =\"; Max-Age=-5; SameSite=x; httponly"), "ERR http: invalid cookie value"
  assert_eq psc("a b=a,b; SameSite=None;é=1"), "ERR http: invalid cookie name"
  assert_eq psc("x-y=99=x;Comment=\"hi\" ;Max-Age=abc"), "x-y|99=x|false|||zero||0|false|false|0|false|Comment=\"hi\",Max-Age=abc"
  assert_eq psc("c$==; Comment=\"hi\";max-age=\"30\";Max-Age=07"), "c$|=|false|||zero||0|false|false|0|false|Comment=\"hi\",max-age=\"30\",Max-Age=07"
  assert_eq psc("a b=a z; Domain=bad-.x"), "ERR http: invalid cookie name"
  assert_eq psc("=x\\y;Max-Age=07"), "ERR http: invalid cookie name"
  assert_eq psc("SIDx\\y ; ;Path=/;path=/a/b"), "ERR http: '=' not found in cookie"
  assert_eq psc("\t=é; Domain=.example.com; Expires=Wed, 23-Nov-2011 01:05:03 GMT"), "ERR http: invalid cookie name"
  assert_eq psc("SID=a,b; é=1"), "SID|a,b|false|||zero||0|false|false|0|false|"
  assert_eq psc("a b=;  ; Secure; Max-Age=60"), "ERR http: invalid cookie name"
}

test "vectors: parse cookie 0" {
  assert_eq pc("\t=é; =\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=é; =\"a b\"", "a"), ""
  assert_eq pc(" sp =\"a b\" ; x-y=é"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\"a b\" ; x-y=é", "x-y"), ""
  assert_eq pc("x-y=; na;me=\"a b\" ; SID=\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y=; na;me=\"a b\" ; SID=\"q\"", ""), "x-y||false|||zero||0|false|false|0|false| ; na||false|||zero||0|false|false|0|false| ; me|a b|true|||zero||0|false|false|0|false| ; SID|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("=a z;;a=é"), "ERR http: invalid cookie name"
  assert_eq rc("=a z;;a=é", "a"), ""
  assert_eq pc("\t=x\\y ; a b=\"q\";;c$="), "ERR http: invalid cookie name"
  assert_eq rc("\t=x\\y ; a b=\"q\";;c$=", ""), "c$||false|||zero||0|false|false|0|false|"
  assert_eq pc("c$=\"a b\""), "c$|a b|true|||zero||0|false|false|0|false|"
  assert_eq rc("c$=\"a b\"", "x-y"), ""
  assert_eq pc("a=;=v;; sp =v; ; c$= lead"), "ERR http: invalid cookie name"
  assert_eq rc("a=;=v;; sp =v; ; c$= lead", "x-y"), ""
  assert_eq pc("c$=é"), "ERR http: invalid cookie value"
  assert_eq rc("c$=é", "SID"), ""
  assert_eq pc("na;me= ; c$v"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me= ; c$v", "x-y"), ""
  assert_eq pc("é=v; ; x-y== ; na;me="), "ERR http: invalid cookie name"
  assert_eq rc("é=v; ; x-y== ; na;me=", "SID"), ""
  assert_eq pc(" sp =99=x; a b= lead"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =99=x; a b= lead", "x-y"), ""
  assert_eq pc("\t=x\\y;é=\"a b\";  sp =é"), "ERR http: invalid cookie name"
  assert_eq rc("\t=x\\y;é=\"a b\";  sp =é", "a"), ""
  assert_eq pc("é=\";é=="), "ERR http: invalid cookie name"
  assert_eq rc("é=\";é==", ""), ""
  assert_eq pc("SID=\"a b\" ; na;me=\"a b\""), "ERR http: '=' not found in cookie"
  assert_eq rc("SID=\"a b\" ; na;me=\"a b\"", "a"), ""
  assert_eq pc("na;me=v; sp =; =\"q\"; a bv"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=v; sp =; =\"q\"; a bv", "SID"), ""
  assert_eq pc("na;me=\"a b\";a b=a z;  sp =\"a b\";=a,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=\"a b\";a b=a z;  sp =\"a b\";=a,b", "SID"), ""
  assert_eq pc("na;me=a z;  sp =\" ; a= lead"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=a z;  sp =\" ; a= lead", "a"), "a| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc("=v;;é=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("=v;;é=99=x", "SID"), ""
  assert_eq pc("=\"a b\";; sp =x\\y ; \t=é"), "ERR http: invalid cookie name"
  assert_eq rc("=\"a b\";; sp =x\\y ; \t=é", "x-y"), ""
  assert_eq pc("x-y=\";a b=é;;c$=v;;;é=\"a b\""), "ERR http: invalid cookie value"
  assert_eq rc("x-y=\";a b=é;;c$=v;;;é=\"a b\"", "SID"), ""
  assert_eq pc("a=a,b"), "a|a,b|false|||zero||0|false|false|0|false|"
  assert_eq rc("a=a,b", "x-y"), ""
  assert_eq pc("x-y lead;a=;\t="), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y lead;a=;\t=", "a"), "a||false|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=\"q\";na;me=a,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=\"q\";na;me=a,b", "a"), ""
  assert_eq pc("na;me=a,b ; é== ; a b="), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=a,b ; é== ; a b=", ""), "na||false|||zero||0|false|false|0|false| ; me|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=a,b ; c$a z;  sp ==;;a b"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=a,b ; c$a z;  sp ==;;a b", ""), "na||false|||zero||0|false|false|0|false| ; me|a,b|false|||zero||0|false|false|0|false| ; sp|=|false|||zero||0|false|false|0|false|"
  assert_eq pc("é=\"a b\"; a=é"), "ERR http: invalid cookie name"
  assert_eq rc("é=\"a b\"; a=é", "SID"), ""
  assert_eq pc("x-y=x\\y ; SID="), "ERR http: invalid cookie value"
  assert_eq rc("x-y=x\\y ; SID=", "a"), ""
  assert_eq pc("SID=\"q\" ; c$=v"), "SID|q|true|||zero||0|false|false|0|false| ; c$|v|false|||zero||0|false|false|0|false|"
  assert_eq rc("SID=\"q\" ; c$=v", "a"), ""
  assert_eq pc("SID=x\\y;;c$=\"q\";x-y=v;; =x\\y"), "ERR http: invalid cookie value"
  assert_eq rc("SID=x\\y;;c$=\"q\";x-y=v;; =x\\y", "SID"), ""
  assert_eq pc("c$= lead ; é=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("c$= lead ; é=\"q\"", ""), "c$| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=;;é=v;;x-y=a,b"), "ERR http: invalid cookie name"
  assert_eq rc("\t=;;é=v;;x-y=a,b", "a"), ""
  assert_eq pc(" sp =\"q\";  sp \"q\"; é=\"q\";;=v"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\"q\";  sp \"q\"; é=\"q\";;=v", "x-y"), ""
  assert_eq pc("c$=; \t=;= lead; c$=\""), "ERR http: invalid cookie name"
  assert_eq rc("c$=; \t=;= lead; c$=\"", ""), "c$||false|||zero||0|false|false|0|false|"
  assert_eq pc("x-y=v"), "x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq rc("x-y=v", "a"), ""
  assert_eq pc("x-y=v;;SID=;; sp v"), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y=v;;SID=;; sp v", "a"), ""
  assert_eq pc("c$==; a=\"q\";;c$=a,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("c$==; a=\"q\";;c$=a,b", "a"), "a|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("SID=v;;SID=a,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("SID=v;;SID=a,b", "x-y"), ""
  assert_eq pc("\t=\"a b\" ; na;me="), "ERR http: invalid cookie name"
  assert_eq rc("\t=\"a b\" ; na;me=", "x-y"), ""
  assert_eq pc("x-y=\";SID99=x; na;me=a z; na;me=99=x"), "ERR http: invalid cookie value"
  assert_eq rc("x-y=\";SID99=x; na;me=a z; na;me=99=x", "a"), ""
  assert_eq pc("na;me==;;c$ ; \t=\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me==;;c$ ; \t=\"q\"", "SID"), ""
  assert_eq pc("\t\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("\t\"q\"", "SID"), ""
  assert_eq pc("SID=a,b;x-y= lead; c$=\"q\""), "SID|a,b|false|||zero||0|false|false|0|false| ; x-y| lead|false|||zero||0|false|false|0|false| ; c$|q|true|||zero||0|false|false|0|false|"
  assert_eq rc("SID=a,b;x-y= lead; c$=\"q\"", "a"), ""
  assert_eq pc("=\"q\";na;me=a,b"), "ERR http: invalid cookie name"
  assert_eq rc("=\"q\";na;me=a,b", "SID"), ""
  assert_eq pc("é=v;;;é==; SID==;=v;"), "ERR http: invalid cookie name"
  assert_eq rc("é=v;;;é==; SID==;=v;", "x-y"), ""
  assert_eq pc("x-y=\"; a b=é;;é=a z;c$=v;"), "ERR http: invalid cookie value"
  assert_eq rc("x-y=\"; a b=é;;é=a z;c$=v;", "SID"), ""
  assert_eq pc("a b=\"; ="), "ERR http: invalid cookie name"
  assert_eq rc("a b=\"; =", "x-y"), ""
  assert_eq pc("é=a z ; a b=a z; \t=\";x-y=="), "ERR http: invalid cookie name"
  assert_eq rc("é=a z ; a b=a z; \t=\";x-y==", "a"), ""
  assert_eq pc("SID=\"q\"; a b=é; a=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("SID=\"q\"; a b=é; a=99=x", ""), "SID|q|true|||zero||0|false|false|0|false| ; a|99=x|false|||zero||0|false|false|0|false|"
  assert_eq pc("=x\\y; =é"), "ERR http: invalid cookie name"
  assert_eq rc("=x\\y; =é", "SID"), ""
  assert_eq pc("x-y=\"a b\" ; na;me=v"), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y=\"a b\" ; na;me=v", "a"), ""
}

test "vectors: parse cookie 1" {
  assert_eq pc("SID= lead;  sp =\";;a="), "ERR http: invalid cookie name"
  assert_eq rc("SID= lead;  sp =\";;a=", "x-y"), ""
  assert_eq pc(" sp =\"q\";\t=\"q\";; sp =x\\y"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\"q\";\t=\"q\";; sp =x\\y", ""), "sp|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=\"a b\";é=v;;;SID=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=\"a b\";é=v;;;SID=v;", "x-y"), ""
  assert_eq pc(" sp =\"; a b= lead;;é=; \t="), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\"; a b= lead;;é=; \t=", "a"), ""
  assert_eq pc(" sp =a z;;a= lead;a=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =a z;;a= lead;a=x\\y", "a"), "a| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t\"q\" ; é=\"a b\";;=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("\t\"q\" ; é=\"a b\";;=v;", "x-y"), ""
  assert_eq pc("x-y==;;na;me= lead ; na;me=v;;a=\"a b\""), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y==;;na;me= lead ; na;me=v;;a=\"a b\"", "x-y"), "x-y|=|false|||zero||0|false|false|0|false|"
  assert_eq pc("c$=a z;;na;mea,b; a= lead"), "ERR http: '=' not found in cookie"
  assert_eq rc("c$=a z;;na;mea,b; a= lead", "a"), "a| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc("é=\" ; a b=a z"), "ERR http: invalid cookie name"
  assert_eq rc("é=\" ; a b=a z", "x-y"), ""
  assert_eq pc("c$="), "c$||false|||zero||0|false|false|0|false|"
  assert_eq rc("c$=", "SID"), ""
  assert_eq pc("SID=v; a=v"), "SID|v|false|||zero||0|false|false|0|false| ; a|v|false|||zero||0|false|false|0|false|"
  assert_eq rc("SID=v; a=v", ""), "SID|v|false|||zero||0|false|false|0|false| ; a|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=v;;\t="), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=v;;\t=", "SID"), ""
  assert_eq pc("SID= lead ; x-y lead"), "ERR http: '=' not found in cookie"
  assert_eq rc("SID= lead ; x-y lead", ""), "SID| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc("SID=x\\y;;=v; a b=\"q\";=\"a b\""), "ERR http: invalid cookie value"
  assert_eq rc("SID=x\\y;;=v; a b=\"q\";=\"a b\"", "a"), ""
  assert_eq pc("c$=v;; sp =99=x;x-y=\"q\" ; \ta,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("c$=v;; sp =99=x;x-y=\"q\" ; \ta,b", ""), "c$|v|false|||zero||0|false|false|0|false| ; sp|99=x|false|||zero||0|false|false|0|false| ; x-y|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("é=\" ;  sp x\\y; a bé ; c$=\""), "ERR http: invalid cookie name"
  assert_eq rc("é=\" ;  sp x\\y; a bé ; c$=\"", "a"), ""
  assert_eq pc("\t=é; c$=\"a b\"; c$=x\\y;na;me=\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=é; c$=\"a b\"; c$=x\\y;na;me=\"a b\"", ""), "c$|a b|true|||zero||0|false|false|0|false| ; na||false|||zero||0|false|false|0|false| ; me|a b|true|||zero||0|false|false|0|false|"
  assert_eq pc("SID=v ; a=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("SID=v ; a=v;", "SID"), "SID|v|false|||zero||0|false|false|0|false|"
  assert_eq pc(" sp =x\\y"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =x\\y", "SID"), ""
  assert_eq pc("a= lead ; =x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("a= lead ; =x\\y", "a"), "a| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc("x-y=99=x;;=v ; c$=a z"), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y=99=x;;=v ; c$=a z", ""), "x-y|99=x|false|||zero||0|false|false|0|false| ; c$|a z|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=\"a b\" ; \t=\"q\";a b=v"), "ERR http: invalid cookie name"
  assert_eq rc("\t=\"a b\" ; \t=\"q\";a b=v", "x-y"), ""
  assert_eq pc("é=a z;  sp 99=x;c$=99=x;;x-y="), "ERR http: invalid cookie name"
  assert_eq rc("é=a z;  sp 99=x;c$=99=x;;x-y=", "a"), ""
  assert_eq pc(" sp = lead;=\";;x-y"), "ERR http: invalid cookie name"
  assert_eq rc(" sp = lead;=\";;x-y", "x-y"), "x-y||false|||zero||0|false|false|0|false|"
  assert_eq pc("SID=v;; x-y=é;;x-y= lead"), "ERR http: '=' not found in cookie"
  assert_eq rc("SID=v;; x-y=é;;x-y= lead", "SID"), "SID|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("na;mev;;;=\"; a=\"q\";c$=\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;mev;;;=\"; a=\"q\";c$=\"q\"", ""), "na||false|||zero||0|false|false|0|false| ; mev||false|||zero||0|false|false|0|false| ; a|q|true|||zero||0|false|false|0|false| ; c$|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("c$=é;;na;me=\""), "ERR http: invalid cookie value"
  assert_eq rc("c$=é;;na;me=\"", "a"), ""
  assert_eq pc("na;me=v; na;me=\"a b\";;é=\"; a=a,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=v; na;me=\"a b\";;é=\"; a=a,b", "SID"), ""
  assert_eq pc("é=v;; na;me=\"a b\"; é\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("é=v;; na;me=\"a b\"; é\"a b\"", "x-y"), ""
  assert_eq pc("=a z;é= lead;a b=v;; sp é"), "ERR http: invalid cookie name"
  assert_eq rc("=a z;é= lead;a b=v;; sp é", "a"), ""
  assert_eq pc("c$=;c$==;\t=v;"), "ERR http: invalid cookie name"
  assert_eq rc("c$=;c$==;\t=v;", "x-y"), ""
  assert_eq pc("\t== ; SID=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("\t== ; SID=x\\y", "SID"), ""
  assert_eq pc("SID=\"q\";=v;a b=v;"), "ERR http: invalid cookie name"
  assert_eq rc("SID=\"q\";=v;a b=v;", "a"), ""
  assert_eq pc("=\" ; \t="), "ERR http: invalid cookie name"
  assert_eq rc("=\" ; \t=", ""), ""
  assert_eq pc("a=v;; SID=99=x"), "ERR http: '=' not found in cookie"
  assert_eq rc("a=v;; SID=99=x", ""), "a|v|false|||zero||0|false|false|0|false| ; SID|99=x|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=;\t=v"), "ERR http: invalid cookie name"
  assert_eq rc("\t=;\t=v", "a"), ""
  assert_eq pc("a b\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("a b\"q\"", ""), ""
  assert_eq pc("a=a z; \t=\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("a=a z; \t=\"a b\"", "x-y"), ""
  assert_eq pc("a b=v;;  sp =x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("a b=v;;  sp =x\\y", "SID"), ""
  assert_eq pc("x-y="), "x-y||false|||zero||0|false|false|0|false|"
  assert_eq rc("x-y=", "x-y"), "x-y||false|||zero||0|false|false|0|false|"
  assert_eq pc(" sp =v;; sp =;é=é"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =v;; sp =;é=é", "a"), ""
  assert_eq pc("c$99=x; \t=; sp =v"), "ERR http: invalid cookie name"
  assert_eq rc("c$99=x; \t=; sp =v", ""), "c$99|x|false|||zero||0|false|false|0|false| ; sp|v|false|||zero||0|false|false|0|false|"
  assert_eq pc(" sp =v"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =v", ""), "sp|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=é;\t=\"q\";na;me lead; é=\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=é;\t=\"q\";na;me lead; é=\"q\"", "SID"), ""
  assert_eq pc("na;me=v;; a=; a=a z ; a=x\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=v;; a=; a=a z ; a=x\\y", ""), "na||false|||zero||0|false|false|0|false| ; me|v|false|||zero||0|false|false|0|false| ; a||false|||zero||0|false|false|0|false| ; a|a z|false|||zero||0|false|false|0|false|"
  assert_eq pc("é=é;;a,b ; x-y=a z"), "ERR http: invalid cookie name"
  assert_eq rc("é=é;;a,b ; x-y=a z", "a"), ""
  assert_eq pc("=a z ; c$=\""), "ERR http: invalid cookie name"
  assert_eq rc("=a z ; c$=\"", "a"), ""
  assert_eq pc("=é ; c$== ; \t=a,b; av;"), "ERR http: invalid cookie name"
  assert_eq rc("=é ; c$== ; \t=a,b; av;", "a"), ""
  assert_eq pc(" sp =\"a b\";;c$= ; x-yv"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\"a b\";;c$= ; x-yv", "x-y"), ""
  assert_eq pc("=é ; a=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("=é ; a=\"q\"", "SID"), ""
}

test "vectors: parse cookie 2" {
  assert_eq pc(" sp =\"q\";é=;  sp \"q\"; a b=a z"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\"q\";é=;  sp \"q\"; a b=a z", "a"), ""
  assert_eq pc("a b="), "ERR http: invalid cookie name"
  assert_eq rc("a b=", "x-y"), ""
  assert_eq pc("c$=a z; sp =\"a b\" ; a b=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("c$=a z; sp =\"a b\" ; a b=x\\y", "x-y"), ""
  assert_eq pc("x-y=é ; SID=x\\y; c$=\""), "ERR http: invalid cookie value"
  assert_eq rc("x-y=é ; SID=x\\y; c$=\"", "SID"), ""
  assert_eq pc("év;;; sp =x\\y;a b\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("év;;; sp =x\\y;a b\"q\"", "SID"), ""
  assert_eq pc(" sp a z;;a b=v;;na;me=x\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc(" sp a z;;a b=v;;na;me=x\\y", ""), "na||false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=v;; sp =é;é=\"a b\"; sp =\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=v;; sp =é;é=\"a b\"; sp =\"a b\"", "SID"), ""
  assert_eq pc("é=\"q\";x-y=a z ; \t=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("é=\"q\";x-y=a z ; \t=99=x", "x-y"), "x-y|a z|false|||zero||0|false|false|0|false|"
  assert_eq pc("a=; sp =99=x"), "ERR http: invalid cookie name"
  assert_eq rc("a=; sp =99=x", "SID"), ""
  assert_eq pc("=x\\y;=a,b"), "ERR http: invalid cookie name"
  assert_eq rc("=x\\y;=a,b", ""), ""
  assert_eq pc("=99=x;;SID=\"a b\";a b=é ; é="), "ERR http: invalid cookie name"
  assert_eq rc("=99=x;;SID=\"a b\";a b=é ; é=", "SID"), "SID|a b|true|||zero||0|false|false|0|false|"
  assert_eq pc("a= lead;;a=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("a= lead;;a=v;", "SID"), ""
  assert_eq pc("a b== ; a lead;\t= lead;c$= lead"), "ERR http: invalid cookie name"
  assert_eq rc("a b== ; a lead;\t= lead;c$= lead", ""), "c$| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc("\tv;\t= lead;;x-y=a z"), "ERR http: '=' not found in cookie"
  assert_eq rc("\tv;\t= lead;;x-y=a z", "SID"), ""
  assert_eq pc("\t\"a b\";;c$\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("\t\"a b\";;c$\"q\"", ""), ""
  assert_eq pc("na;me=a,b; \t= lead"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=a,b; \t= lead", "SID"), ""
  assert_eq pc("SID==;;c$=\"q\" ; c$=\"q\";é=\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("SID==;;c$=\"q\" ; c$=\"q\";é=\"q\"", "x-y"), ""
  assert_eq pc("\"a b\";x-y=a,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("\"a b\";x-y=a,b", "SID"), ""
  assert_eq pc("é=x\\y;;c$=v; ; é=a z"), "ERR http: invalid cookie name"
  assert_eq rc("é=x\\y;;c$=v; ; é=a z", "SID"), ""
  assert_eq pc("x-y=99=x"), "x-y|99=x|false|||zero||0|false|false|0|false|"
  assert_eq rc("x-y=99=x", "x-y"), "x-y|99=x|false|||zero||0|false|false|0|false|"
  assert_eq pc("=\"q\" ; na;me=v;SID=x\\y;;é=="), "ERR http: invalid cookie name"
  assert_eq rc("=\"q\" ; na;me=v;SID=x\\y;;é==", ""), "na||false|||zero||0|false|false|0|false| ; me|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("c$=;SID=\"q\""), "c$||false|||zero||0|false|false|0|false| ; SID|q|true|||zero||0|false|false|0|false|"
  assert_eq rc("c$=;SID=\"q\"", ""), "c$||false|||zero||0|false|false|0|false| ; SID|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("SID= ; SID=é;;c$=\" ; a="), "ERR http: invalid cookie value"
  assert_eq rc("SID= ; SID=é;;c$=\" ; a=", "SID"), "SID||false|||zero||0|false|false|0|false|"
  assert_eq pc("SID=\"a b\" ; \t= lead"), "ERR http: invalid cookie name"
  assert_eq rc("SID=\"a b\" ; \t= lead", "SID"), "SID|a b|true|||zero||0|false|false|0|false|"
  assert_eq pc("é==;;é="), "ERR http: invalid cookie name"
  assert_eq rc("é==;;é=", "SID"), ""
  assert_eq pc(" sp =é; é=\" ; a b="), "ERR http: invalid cookie name"
  assert_eq rc(" sp =é; é=\" ; a b=", "x-y"), ""
  assert_eq pc("a b=é;;c$=\""), "ERR http: invalid cookie name"
  assert_eq rc("a b=é;;c$=\"", "SID"), ""
  assert_eq pc("a b=a z;;=a z ; a=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("a b=a z;;=a z ; a=\"q\"", ""), "a|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("a b=a z; na;me=99=x; c$=a,b;;x-y=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("a b=a z; na;me=99=x; c$=a,b;;x-y=99=x", "a"), ""
  assert_eq pc("na;me=\"a b\" ; = lead; = lead;;a="), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=\"a b\" ; = lead; = lead;;a=", "a"), "a||false|||zero||0|false|false|0|false|"
  assert_eq pc("a==; na;me=x\\y; é=v;a b=="), "ERR http: '=' not found in cookie"
  assert_eq rc("a==; na;me=x\\y; é=v;a b==", ""), "a|=|false|||zero||0|false|false|0|false| ; na||false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=v;"), "ERR http: invalid cookie name"
  assert_eq rc("\t=v;", ""), ""
  assert_eq pc("a b=x\\y;;\t=\""), "ERR http: invalid cookie name"
  assert_eq rc("a b=x\\y;;\t=\"", ""), ""
  assert_eq pc(" sp 99=x;na;me=v"), "ERR http: invalid cookie name"
  assert_eq rc(" sp 99=x;na;me=v", ""), "na||false|||zero||0|false|false|0|false| ; me|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("a b=a z;  sp =é; a b=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("a b=a z;  sp =é; a b=\"q\"", "SID"), ""
  assert_eq pc("\t=="), "ERR http: invalid cookie name"
  assert_eq rc("\t==", ""), ""
  assert_eq pc("SID=\"; \ta z;x-y=\""), "ERR http: invalid cookie value"
  assert_eq rc("SID=\"; \ta z;x-y=\"", "a"), ""
  assert_eq pc("=\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("=\"a b\"", ""), ""
  assert_eq pc("na;me=a z;;=\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=a z;;=\"", "SID"), ""
  assert_eq pc("c$=a z;;na;me=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("c$=a z;;na;me=v;", "a"), ""
  assert_eq pc("SID=a z ; c$=é ; a b= lead"), "ERR http: invalid cookie value"
  assert_eq rc("SID=a z ; c$=é ; a b= lead", "a"), ""
  assert_eq pc(" sp x\\y;a b==;;x-y=a,b ; é=99=x"), "ERR http: '=' not found in cookie"
  assert_eq rc(" sp x\\y;a b==;;x-y=a,b ; é=99=x", "x-y"), "x-y|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc(" sp a,b; SID=x\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc(" sp a,b; SID=x\\y", "SID"), ""
  assert_eq pc("SID= lead;\t=a,b;;a== ; c$="), "ERR http: invalid cookie name"
  assert_eq rc("SID= lead;\t=a,b;;a== ; c$=", "a"), "a|=|false|||zero||0|false|false|0|false|"
  assert_eq pc("==;;é= ; c$="), "ERR http: invalid cookie name"
  assert_eq rc("==;;é= ; c$=", "x-y"), ""
  assert_eq pc("a=a,b;SID=a,b"), "a|a,b|false|||zero||0|false|false|0|false| ; SID|a,b|false|||zero||0|false|false|0|false|"
  assert_eq rc("a=a,b;SID=a,b", "a"), "a|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("é=\"a b\"; a=x\\y ; na;me=v"), "ERR http: invalid cookie name"
  assert_eq rc("é=\"a b\"; a=x\\y ; na;me=v", ""), "na||false|||zero||0|false|false|0|false| ; me|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=\"a b\"; a b ; c$=="), "ERR http: invalid cookie name"
  assert_eq rc("\t=\"a b\"; a b ; c$==", "SID"), ""
  assert_eq pc(" sp =é; é=\""), "ERR http: invalid cookie name"
  assert_eq rc(" sp =é; é=\"", "x-y"), ""
  assert_eq pc("\t=a,b; x-y=\"q\";c$é;=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("\t=a,b; x-y=\"q\";c$é;=x\\y", ""), "x-y|q|true|||zero||0|false|false|0|false|"
}

test "vectors: parse cookie 3" {
  assert_eq pc(" sp =99=x ; na;me=\""), "ERR http: invalid cookie name"
  assert_eq rc(" sp =99=x ; na;me=\"", "SID"), ""
  assert_eq pc("a=a z;a=x\\y;;x-y=\"q\";x-y=x\\y"), "ERR http: invalid cookie value"
  assert_eq rc("a=a z;a=x\\y;;x-y=\"q\";x-y=x\\y", ""), "a|a z|false|||zero||0|false|false|0|false| ; x-y|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=x\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=x\\y", ""), "na||false|||zero||0|false|false|0|false|"
  assert_eq pc("a b=a z ; é= lead;na;me99=x;\t=v"), "ERR http: invalid cookie name"
  assert_eq rc("a b=a z ; é= lead;na;me99=x;\t=v", ""), "na||false|||zero||0|false|false|0|false| ; me99|x|false|||zero||0|false|false|0|false|"
  assert_eq pc("SID= lead;;="), "ERR http: '=' not found in cookie"
  assert_eq rc("SID= lead;;=", "a"), ""
  assert_eq pc("a b99=x;é=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("a b99=x;é=99=x", "x-y"), ""
  assert_eq pc("\t=x\\y;c$=v;c$=\"a b\" ; c$=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=x\\y;c$=v;c$=\"a b\" ; c$=\"q\"", "x-y"), ""
  assert_eq pc("=\"q\" ; é=\";éx\\y;;na;me=é"), "ERR http: invalid cookie name"
  assert_eq rc("=\"q\" ; é=\";éx\\y;;na;me=é", "a"), ""
  assert_eq pc("x-y=\"q\"; c$=é;;c$=v;SID=\"a b\""), "ERR http: invalid cookie value"
  assert_eq rc("x-y=\"q\"; c$=é;;c$=v;SID=\"a b\"", "a"), ""
  assert_eq pc("SID=a,b;=99=x;na;me="), "ERR http: invalid cookie name"
  assert_eq rc("SID=a,b;=99=x;na;me=", ""), "SID|a,b|false|||zero||0|false|false|0|false| ; na||false|||zero||0|false|false|0|false| ; me||false|||zero||0|false|false|0|false|"
  assert_eq pc("= ; na;me=\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("= ; na;me=\"a b\"", "a"), ""
  assert_eq pc("a b=v; ;  sp == ; \t=\""), "ERR http: invalid cookie name"
  assert_eq rc("a b=v; ;  sp == ; \t=\"", "a"), ""
  assert_eq pc("x-y=é;é="), "ERR http: invalid cookie value"
  assert_eq rc("x-y=é;é=", "x-y"), ""
  assert_eq pc("é==;SID ; =a z ; SID=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("é==;SID ; =a z ; SID=\"q\"", "SID"), "SID||false|||zero||0|false|false|0|false| ; SID|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("c$=a,b;a=\"q\"; c$=\""), "ERR http: invalid cookie value"
  assert_eq rc("c$=a,b;a=\"q\"; c$=\"", "a"), "a|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("x-y=x\\y; SID=v; sp = lead"), "ERR http: invalid cookie value"
  assert_eq rc("x-y=x\\y; SID=v; sp = lead", "a"), ""
  assert_eq pc("na;me=a z; \t=x\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=a z; \t=x\\y", "x-y"), ""
  assert_eq pc("=\"q\";;na;me=v;;é=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("=\"q\";;na;me=v;;é=\"q\"", "x-y"), ""
  assert_eq pc(" sp =99=x; é=a z"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =99=x; é=a z", "a"), ""
  assert_eq pc("na;me==;na;me=\";na;me=99=x"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me==;na;me=\";na;me=99=x", "x-y"), ""
  assert_eq pc("\t= ; é=\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("\t= ; é=\"a b\"", "SID"), ""
  assert_eq pc("na;mex\\y;;c$=\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;mex\\y;;c$=\"", "SID"), ""
  assert_eq pc("na;me=x\\y ; é=é"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=x\\y ; é=é", "SID"), ""
  assert_eq pc("v;é=="), "ERR http: '=' not found in cookie"
  assert_eq rc("v;é==", "a"), ""
  assert_eq pc("é=;; sp =v; ; =x\\y ; a=é"), "ERR http: invalid cookie name"
  assert_eq rc("é=;; sp =v; ; =x\\y ; a=é", "a"), ""
  assert_eq pc("\t=\"q\" ; c$=a z;;\t=\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=\"q\" ; c$=a z;;\t=\"", "SID"), ""
  assert_eq pc("a b=;;a b=\" ; \t=v;"), "ERR http: invalid cookie name"
  assert_eq rc("a b=;;a b=\" ; \t=v;", "x-y"), ""
  assert_eq pc("a b=v;;=a,b ; é=v;;;x-y=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("a b=v;;=a,b ; é=v;;;x-y=x\\y", "SID"), ""
  assert_eq pc("c$=é;;c$=\"a b\""), "ERR http: invalid cookie value"
  assert_eq rc("c$=é;;c$=\"a b\"", "x-y"), ""
  assert_eq pc("na;me99=x;;=a z;  sp =x\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me99=x;;=a z;  sp =x\\y", "SID"), ""
  assert_eq pc("a b=a z;;a b\"q\" ; é=99=x ; x-y=v"), "ERR http: invalid cookie name"
  assert_eq rc("a b=a z;;a b\"q\" ; é=99=x ; x-y=v", "x-y"), "x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("a b;  sp =\"a b\";;x-y=a z"), "ERR http: '=' not found in cookie"
  assert_eq rc("a b;  sp =\"a b\";;x-y=a z", "x-y"), "x-y|a z|false|||zero||0|false|false|0|false|"
  assert_eq pc("x-y\"q\";;=a,b;c$="), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y\"q\";;=a,b;c$=", "a"), ""
  assert_eq pc("na;me= lead;== ; SID=x\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me= lead;== ; SID=x\\y", "a"), ""
  assert_eq pc("a; SID=a,b;;na;me=\"; a=a,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("a; SID=a,b;;na;me=\"; a=a,b", "x-y"), ""
  assert_eq pc("a b=v; a b=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("a b=v; a b=x\\y", "a"), ""
  assert_eq pc("x-y=; \t=;x-y=99=x;a b=é"), "ERR http: invalid cookie name"
  assert_eq rc("x-y=; \t=;x-y=99=x;a b=é", ""), "x-y||false|||zero||0|false|false|0|false| ; x-y|99=x|false|||zero||0|false|false|0|false|"
  assert_eq pc("a b=v;;; sp \"a b\" ; a\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("a b=v;;; sp \"a b\" ; a\"a b\"", "SID"), ""
  assert_eq pc("a=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("a=v;", "x-y"), ""
  assert_eq pc("=a z"), "ERR http: invalid cookie name"
  assert_eq rc("=a z", "SID"), ""
  assert_eq pc("c$\";;SID="), "ERR http: '=' not found in cookie"
  assert_eq rc("c$\";;SID=", "a"), ""
  assert_eq pc("a=x\\y"), "ERR http: invalid cookie value"
  assert_eq rc("a=x\\y", "SID"), ""
  assert_eq pc("c$=v ; SID=="), "c$|v|false|||zero||0|false|false|0|false| ; SID|=|false|||zero||0|false|false|0|false|"
  assert_eq rc("c$=v ; SID==", "SID"), "SID|=|false|||zero||0|false|false|0|false|"
  assert_eq pc("na;me==;;é\"q\";;\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me==;;é\"q\";;\"", ""), "na||false|||zero||0|false|false|0|false| ; me|=|false|||zero||0|false|false|0|false|"
  assert_eq pc("x-y= ; \t\";;\t=v;; na;me=\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y= ; \t\";;\t=v;; na;me=\"q\"", "SID"), ""
  assert_eq pc("\t=99=x; x-y=v; ; na;me=\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=99=x; x-y=v; ; na;me=\"", "SID"), ""
  assert_eq pc("é=99=x;\t= lead;;\t= lead;=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("é=99=x;\t= lead;;\t= lead;=x\\y", "a"), ""
  assert_eq pc("na;me=v; SID=99=x; a=\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=v; SID=99=x; a=\"", ""), "na||false|||zero||0|false|false|0|false| ; me|v|false|||zero||0|false|false|0|false| ; SID|99=x|false|||zero||0|false|false|0|false|"
  assert_eq pc("a b=x\\y; é=a,b"), "ERR http: invalid cookie name"
  assert_eq rc("a b=x\\y; é=a,b", ""), ""
  assert_eq pc("=é; é=99=x;na;me=é"), "ERR http: invalid cookie name"
  assert_eq rc("=é; é=99=x;na;me=é", ""), "na||false|||zero||0|false|false|0|false|"
}

test "vectors: parse cookie 4" {
  assert_eq pc("SIDé;; sp =\" ; a b=="), "ERR http: '=' not found in cookie"
  assert_eq rc("SIDé;; sp =\" ; a b==", "x-y"), ""
  assert_eq pc("é=;;\t=a z; na;me=;SID=v"), "ERR http: invalid cookie name"
  assert_eq rc("é=;;\t=a z; na;me=;SID=v", "x-y"), ""
  assert_eq pc("SID=a,b;;c$a,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("SID=a,b;;c$a,b", "SID"), "SID|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("=a,b;;=a,b;;é=\""), "ERR http: invalid cookie name"
  assert_eq rc("=a,b;;=a,b;;é=\"", ""), ""
  assert_eq pc("a=;;x-y=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("a=;;x-y=v;", "x-y"), "x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("na;mea,b;;c$=99=x; \ta,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;mea,b;;c$=99=x; \ta,b", "x-y"), ""
  assert_eq pc("a=é ; c$ lead"), "ERR http: invalid cookie value"
  assert_eq rc("a=é ; c$ lead", "x-y"), ""
  assert_eq pc("SID=99=x; é=é ; a=;;na;me=="), "ERR http: invalid cookie name"
  assert_eq rc("SID=99=x; é=é ; a=;;na;me==", ""), "SID|99=x|false|||zero||0|false|false|0|false| ; a||false|||zero||0|false|false|0|false| ; na||false|||zero||0|false|false|0|false| ; me|=|false|||zero||0|false|false|0|false|"
  assert_eq pc("a\";SID=\"q\";;é=\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("a\";SID=\"q\";;é=\"q\"", "x-y"), ""
  assert_eq pc("c$é"), "ERR http: '=' not found in cookie"
  assert_eq rc("c$é", "x-y"), ""
  assert_eq pc("\t=\"a b\";na;me=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=\"a b\";na;me=\"q\"", "a"), ""
  assert_eq pc("a=;;a b=v;;x-y=v;;na;me=\""), "ERR http: '=' not found in cookie"
  assert_eq rc("a=;;a b=v;;x-y=v;;na;me=\"", "x-y"), "x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("\ta z"), "ERR http: '=' not found in cookie"
  assert_eq rc("\ta z", "SID"), ""
  assert_eq pc("na;me=a,b ; \t=v"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=a,b ; \t=v", ""), "na||false|||zero||0|false|false|0|false| ; me|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("=99=x;;x-y==;;a bx\\y"), "ERR http: invalid cookie name"
  assert_eq rc("=99=x;;x-y==;;a bx\\y", "SID"), ""
  assert_eq pc("na;meé ; a== ; x-y=\"a b\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;meé ; a== ; x-y=\"a b\"", "SID"), ""
  assert_eq pc("SID= lead ; na;me=x\\y; c$=v;; a b=\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("SID= lead ; na;me=x\\y; c$=v;; a b=\"q\"", "a"), ""
  assert_eq pc("a b=x\\y;a b=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("a b=x\\y;a b=99=x", "a"), ""
  assert_eq pc("a b lead ; é=\"a b\""), "ERR http: '=' not found in cookie"
  assert_eq rc("a b lead ; é=\"a b\"", "SID"), ""
  assert_eq pc("a b=é ; é=é; x-y=x\\y;;é"), "ERR http: invalid cookie name"
  assert_eq rc("a b=é ; é=é; x-y=x\\y;;é", ""), ""
  assert_eq pc("na;me=é; SID=a,b; \t=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=é; SID=a,b; \t=v;", "x-y"), ""
  assert_eq pc("SID=\";;x-y=\"; x-y= lead"), "ERR http: invalid cookie value"
  assert_eq rc("SID=\";;x-y=\"; x-y= lead", "a"), ""
  assert_eq pc("\t=é;  sp =v; ; \t=a,b; SID lead"), "ERR http: invalid cookie name"
  assert_eq rc("\t=é;  sp =v; ; \t=a,b; SID lead", "a"), ""
  assert_eq pc("x-y=é;\t=\"q\"; é=\"q\""), "ERR http: invalid cookie value"
  assert_eq rc("x-y=é;\t=\"q\"; é=\"q\"", "a"), ""
  assert_eq pc("a b=é; c$=\";c$=\" ; é=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("a b=é; c$=\";c$=\" ; é=\"q\"", "a"), ""
  assert_eq pc("é=\"a b\"; év; ; \""), "ERR http: invalid cookie name"
  assert_eq rc("é=\"a b\"; év; ; \"", ""), ""
  assert_eq pc("na;me=a z;;na;me=v;;a b=;;=="), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=a z;;na;me=v;;a b=;;==", "SID"), ""
  assert_eq pc("é=\"q\";;na;me= lead;;a=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("é=\"q\";;na;me= lead;;a=x\\y", "SID"), ""
  assert_eq pc("=99=x;;c$= lead"), "ERR http: invalid cookie name"
  assert_eq rc("=99=x;;c$= lead", ""), "c$| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc("=v;; SID=="), "ERR http: invalid cookie name"
  assert_eq rc("=v;; SID==", "SID"), "SID|=|false|||zero||0|false|false|0|false|"
  assert_eq pc("=v;;; sp =v;;;na;me=é"), "ERR http: invalid cookie name"
  assert_eq rc("=v;;; sp =v;;;na;me=é", "SID"), ""
  assert_eq pc("a=\"q\";;c$="), "ERR http: '=' not found in cookie"
  assert_eq rc("a=\"q\";;c$=", "a"), "a|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("é lead"), "ERR http: '=' not found in cookie"
  assert_eq rc("é lead", "a"), ""
  assert_eq pc("a=\"a b\";;a b=="), "ERR http: '=' not found in cookie"
  assert_eq rc("a=\"a b\";;a b==", ""), "a|a b|true|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=\"q\";SID=v; ; \t=\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=\"q\";SID=v; ; \t=\"", "SID"), "SID|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=v;;\t=a z ; c$=;;\ta z"), "ERR http: invalid cookie name"
  assert_eq rc("\t=v;;\t=a z ; c$=;;\ta z", ""), "c$||false|||zero||0|false|false|0|false|"
  assert_eq pc("SIDx\\y;é= lead;;=\"a b\""), "ERR http: '=' not found in cookie"
  assert_eq rc("SIDx\\y;é= lead;;=\"a b\"", "SID"), ""
  assert_eq pc("na;mea,b ; x-y=\"a b\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;mea,b ; x-y=\"a b\"", "a"), ""
  assert_eq pc("a b=a z;é=é"), "ERR http: invalid cookie name"
  assert_eq rc("a b=a z;é=é", "a"), ""
  assert_eq pc(" sp =\"; =a z; sp ;=a,b"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\"; =a z; sp ;=a,b", "SID"), ""
  assert_eq pc("\t=99=x; \t=v;;na;me=a z;na;me=\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=99=x; \t=v;;na;me=a z;na;me=\"", "a"), ""
  assert_eq pc("na;me= lead"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me= lead", "x-y"), ""
  assert_eq pc("a b=; na;me=\""), "ERR http: invalid cookie name"
  assert_eq rc("a b=; na;me=\"", ""), "na||false|||zero||0|false|false|0|false|"
  assert_eq pc("x-y== ; ==; SID=a z ;  sp =x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("x-y== ; ==; SID=a z ;  sp =x\\y", "x-y"), "x-y|=|false|||zero||0|false|false|0|false|"
  assert_eq pc("=\"q\"; sp =\"a b\" ; a=é"), "ERR http: invalid cookie name"
  assert_eq rc("=\"q\"; sp =\"a b\" ; a=é", ""), "sp|a b|true|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=; é=\"q\";=99=x; sp =="), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=; é=\"q\";=99=x; sp ==", "x-y"), ""
  assert_eq pc(" sp =\"a b\";; sp  lead; é=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\"a b\";; sp  lead; é=x\\y", ""), "sp|a b|true|||zero||0|false|false|0|false|"
  assert_eq pc("SID=a,b"), "SID|a,b|false|||zero||0|false|false|0|false|"
  assert_eq rc("SID=a,b", "x-y"), ""
  assert_eq pc("na;me=v;;;\t=é"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=v;;;\t=é", "a"), ""
  assert_eq pc("a b=é ; é= lead"), "ERR http: invalid cookie name"
  assert_eq rc("a b=é ; é= lead", "x-y"), ""
}

test "vectors: parse cookie 5" {
  assert_eq pc("a=a,b; ="), "ERR http: invalid cookie name"
  assert_eq rc("a=a,b; =", "x-y"), ""
  assert_eq pc("x-y=\"a b\"; \t=x\\y;;na;me="), "ERR http: invalid cookie name"
  assert_eq rc("x-y=\"a b\"; \t=x\\y;;na;me=", "a"), ""
