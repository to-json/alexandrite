  assert_eq psc("\t=a z;path=a;b;Partitioned ;Expires=Wed, 23-Nov-2011 01:05:03 GMT"), "ERR http: invalid cookie name"
  assert_eq psc(" sp =\"q\"; Domain=.example.com;  "), "sp|q|true||.example.com|zero||0|false|false|0|false|"
  assert_eq psc("SID=v;;path=/a/b"), "SID|v|false|/a/b||zero||0|false|false|0|false|"
  assert_eq psc("a b=x\\y; httponly"), "ERR http: invalid cookie name"
