  assert_eq psc("x-y=\"a b\" ;Unknown=1"), "x-y|a b|true|||zero||0|false|false|0|false|Unknown=1"
  assert_eq psc("a b=a z;flag ;; SameSite=None"), "ERR http: invalid cookie name"
  assert_eq psc("c$v"), "ERR http: '=' not found in cookie"
  assert_eq psc(" sp =; ;Max-Age=abc ;httponly"), "sp||false|||zero||0|false|true|0|false|Max-Age=abc"
