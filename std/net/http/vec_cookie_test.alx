  assert_eq rc("na;me=a z;;=\"a b\"; a=\"a b\"; a=a,b", "a"), "a|a b|true|||zero||0|false|false|0|false| ; a|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=v;a=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("\t=v;a=x\\y", "x-y"), ""
  assert_eq pc("SID=a z;;a== ; c$=x\\y; a=\""), "ERR http: '=' not found in cookie"
  assert_eq rc("SID=a z;;a== ; c$=x\\y; a=\"", ""), "SID|a z|false|||zero||0|false|false|0|false| ; a|=|false|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=\"a b\" ; \t=99=x; é=a,b;a b=="), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=\"a b\" ; \t=99=x; é=a,b;a b==", "SID"), ""
  assert_eq pc(" sp =a z;;x-y=a z"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =a z;;x-y=a z", "x-y"), "x-y|a z|false|||zero||0|false|false|0|false|"
  assert_eq pc("a z"), "ERR http: '=' not found in cookie"
  assert_eq rc("a z", ""), ""
  assert_eq pc("\t==;x-y=a z; c$=a,b"), "ERR http: invalid cookie name"
  assert_eq rc("\t==;x-y=a z; c$=a,b", ""), "x-y|a z|false|||zero||0|false|false|0|false| ; c$|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("a b=99=x;a b=\" ; =v"), "ERR http: invalid cookie name"
  assert_eq rc("a b=99=x;a b=\" ; =v", "a"), ""
  assert_eq pc("\t==;;c$=v;"), "ERR http: invalid cookie name"
  assert_eq rc("\t==;;c$=v;", "a"), ""
  assert_eq pc("ax\\y;é=é ; a=;;x-y=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("ax\\y;é=é ; a=;;x-y=v;", "a"), "a||false|||zero||0|false|false|0|false|"
  assert_eq pc("x-y== ; x-y=x\\y;é==;é=99=x"), "ERR http: invalid cookie value"
  assert_eq rc("x-y== ; x-y=x\\y;é==;é=99=x", "a"), ""
