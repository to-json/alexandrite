  assert_eq pc("=\"a b\" ;  sp =é"), "ERR http: invalid cookie name"
  assert_eq rc("=\"a b\" ;  sp =é", "a"), ""
  assert_eq pc("c$=\"a b\";; sp =x\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc("c$=\"a b\";; sp =x\\y", "a"), ""
  assert_eq pc("a= lead; é=é"), "ERR http: invalid cookie name"
  assert_eq rc("a= lead; é=é", ""), "a| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc("é\"q\"; \t=a,b;a b=x\\y ; =99=x"), "ERR http: '=' not found in cookie"
  assert_eq rc("é\"q\"; \t=a,b;a b=x\\y ; =99=x", "x-y"), ""
  assert_eq pc("a b=x\\y; c$="), "ERR http: invalid cookie name"
  assert_eq rc("a b=x\\y; c$=", ""), "c$||false|||zero||0|false|false|0|false|"
  assert_eq pc("a=v;é=\" ; é=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("a=v;é=\" ; é=99=x", "x-y"), ""
  assert_eq pc("a z ; c$="), "ERR http: '=' not found in cookie"
  assert_eq rc("a z ; c$=", "x-y"), ""
  assert_eq pc("é==;;c$=\";;\t=="), "ERR http: invalid cookie name"
  assert_eq rc("é==;;c$=\";;\t==", ""), ""
  assert_eq pc("a=\"a b\"; \t=a,b ; x-y="), "ERR http: invalid cookie name"
  assert_eq rc("a=\"a b\"; \t=a,b ; x-y=", "SID"), ""
  assert_eq pc(" sp =\";na;me=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\";na;me=\"q\"", ""), "na||false|||zero||0|false|false|0|false| ; me|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("SID=v;;na;me=v;; é=\"a b\";;x-y=x\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc("SID=v;;na;me=v;; é=\"a b\";;x-y=x\\y", ""), "SID|v|false|||zero||0|false|false|0|false| ; na||false|||zero||0|false|false|0|false| ; me|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=a,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=a,b", ""), "na||false|||zero||0|false|false|0|false| ; me|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=v;;c$=\""), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=v;;c$=\"", ""), "na||false|||zero||0|false|false|0|false| ; me|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("x-y=v;; \t=é ; a b=99=x"), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y=v;; \t=é ; a b=99=x", "x-y"), "x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("a b=a z"), "ERR http: invalid cookie name"
  assert_eq rc("a b=a z", "SID"), ""
  assert_eq pc("a=\"a b\";x-y=\"a b\""), "a|a b|true|||zero||0|false|false|0|false| ; x-y|a b|true|||zero||0|false|false|0|false|"
  assert_eq rc("a=\"a b\";x-y=\"a b\"", ""), "a|a b|true|||zero||0|false|false|0|false| ; x-y|a b|true|||zero||0|false|false|0|false|"
  assert_eq pc("a b=x\\y;;SID=a,b"), "ERR http: invalid cookie name"
  assert_eq rc("a b=x\\y;;SID=a,b", "SID"), "SID|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("c$=a z ; x-y=v; SID=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("c$=a z ; x-y=v; SID=v;", "x-y"), "x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq pc(" sp =\" ; SID=x\\y;é=x\\y;x-y=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\" ; SID=x\\y;é=x\\y;x-y=\"q\"", "a"), ""
}

test "vectors: parse cookie 6" {
  assert_eq pc("na;me=\"a b\";a b=; =="), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=\"a b\";a b=; ==", ""), "na||false|||zero||0|false|false|0|false| ; me|a b|true|||zero||0|false|false|0|false|"
  assert_eq pc("\t=;é=a,b"), "ERR http: invalid cookie name"
  assert_eq rc("\t=;é=a,b", ""), ""
  assert_eq pc("\t=\"q\" ; \t==;;x-y= lead"), "ERR http: invalid cookie name"
  assert_eq rc("\t=\"q\" ; \t==;;x-y= lead", ""), "x-y| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc(" sp =\"a b\"; a=\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\"a b\"; a=\"a b\"", "x-y"), ""
  assert_eq pc("\t==; SID=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("\t==; SID=99=x", "x-y"), ""
  assert_eq pc("na;me=x\\y;  sp =v; é= lead"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=x\\y;  sp =v; é= lead", "a"), ""
  assert_eq pc(" sp =é; c$=a z ; x-y=v;"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =é; c$=a z ; x-y=v;", ""), "c$|a z|false|||zero||0|false|false|0|false| ; x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=\"q\"; c$=\"; sp =é ; \t=a,b"), "ERR http: invalid cookie name"
  assert_eq rc("\t=\"q\"; c$=\"; sp =é ; \t=a,b", "x-y"), ""
  assert_eq pc("x-y=a z ; a b\"q\""), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y=a z ; a b\"q\"", "x-y"), "x-y|a z|false|||zero||0|false|false|0|false|"
  assert_eq pc("c$v;c$= lead ; na;me=99=x"), "ERR http: '=' not found in cookie"
  assert_eq rc("c$v;c$= lead ; na;me=99=x", "a"), ""
  assert_eq pc("a=99=x ; = lead;na;me=99=x;;=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("a=99=x ; = lead;na;me=99=x;;=99=x", "x-y"), ""
  assert_eq pc("é=;;x-y=v"), "ERR http: invalid cookie name"
  assert_eq rc("é=;;x-y=v", "a"), ""
  assert_eq pc("é=x\\y ; na;me= lead;;SID=v;;c$=v;"), "ERR http: invalid cookie name"
  assert_eq rc("é=x\\y ; na;me= lead;;SID=v;;c$=v;", "x-y"), ""
  assert_eq pc("x-y=\" ; SID= lead"), "ERR http: invalid cookie value"
  assert_eq rc("x-y=\" ; SID= lead", "a"), ""
  assert_eq pc("c$==;a= ; é=a z"), "ERR http: invalid cookie name"
  assert_eq rc("c$==;a= ; é=a z", ""), "c$|=|false|||zero||0|false|false|0|false| ; a||false|||zero||0|false|false|0|false|"
  assert_eq pc("é==;na;me=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("é==;na;me=99=x", "SID"), ""
  assert_eq pc("c$=v;  sp =;na;me=99=x;;x-y=\""), "ERR http: invalid cookie name"
  assert_eq rc("c$=v;  sp =;na;me=99=x;;x-y=\"", ""), "c$|v|false|||zero||0|false|false|0|false| ; sp||false|||zero||0|false|false|0|false| ; na||false|||zero||0|false|false|0|false| ; me|99=x|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=a z;;a b=99=x;;na;me=a z ;  sp =é"), "ERR http: invalid cookie name"
  assert_eq rc("\t=a z;;a b=99=x;;na;me=a z ;  sp =é", "SID"), ""
  assert_eq pc("SID=\"q\" ; é99=x;;=v ; \t=="), "ERR http: invalid cookie name"
  assert_eq rc("SID=\"q\" ; é99=x;;=v ; \t==", ""), "SID|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("SID=a z; a b=v;"), "ERR http: invalid cookie name"
  assert_eq rc("SID=a z; a b=v;", "a"), ""
  assert_eq pc("c$=a,b;; sp =v;;;x-yx\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc("c$=a,b;; sp =v;;;x-yx\\y", "SID"), ""
  assert_eq pc(" sp = lead;; sp  lead ; x-y=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc(" sp = lead;; sp  lead ; x-y=\"q\"", ""), "sp| lead|false|||zero||0|false|false|0|false| ; x-y|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=a z;é=v"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=a z;é=v", "a"), ""
  assert_eq pc("a b\";na;me= lead"), "ERR http: '=' not found in cookie"
  assert_eq rc("a b\";na;me= lead", "x-y"), ""
  assert_eq pc("a b=99=x ; = ; SID=a z"), "ERR http: invalid cookie name"
  assert_eq rc("a b=99=x ; = ; SID=a z", "x-y"), ""
  assert_eq pc("x-y=v ;  sp =; \t="), "ERR http: invalid cookie name"
  assert_eq rc("x-y=v ;  sp =; \t=", "x-y"), "x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("a b=\"q\";é=v;"), "ERR http: invalid cookie name"
  assert_eq rc("a b=\"q\";é=v;", ""), ""
  assert_eq pc("a b=;x-y99=x; x-y=é"), "ERR http: invalid cookie name"
  assert_eq rc("a b=;x-y99=x; x-y=é", ""), "x-y99|x|false|||zero||0|false|false|0|false|"
  assert_eq pc("=a z;;na;me=a z;;na;me=\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("=a z;;na;me=a z;;na;me=\"a b\"", "a"), ""
  assert_eq pc("a=a,b;;\t=\"a b\";;c$=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("a=a,b;;\t=\"a b\";;c$=v;", "x-y"), ""
  assert_eq pc("a bv;; x-y=a,b ; =99=x"), "ERR http: '=' not found in cookie"
  assert_eq rc("a bv;; x-y=a,b ; =99=x", ""), "x-y|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("SID==; c$==;c$==;;x-y=a,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("SID==; c$==;c$==;;x-y=a,b", "x-y"), "x-y|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("a=\"q\";;x-ya,b"), "ERR http: '=' not found in cookie"
  assert_eq rc("a=\"q\";;x-ya,b", ""), "a|q|true|||zero||0|false|false|0|false|"
  assert_eq pc("x-y= lead ; SID=v;; \t=\"q\";c$=é"), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y= lead ; SID=v;; \t=\"q\";c$=é", "x-y"), "x-y| lead|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=\"; sp a z"), "ERR http: invalid cookie name"
  assert_eq rc("\t=\"; sp a z", "x-y"), ""
  assert_eq pc("é=\" ; c$=\""), "ERR http: invalid cookie name"
  assert_eq rc("é=\" ; c$=\"", ""), ""
  assert_eq pc(" sp =x\\y ; \ta,b;é=a,b ; x-y=="), "ERR http: invalid cookie name"
  assert_eq rc(" sp =x\\y ; \ta,b;é=a,b ; x-y==", "SID"), ""
  assert_eq pc("é=\"q\" ; a b= lead"), "ERR http: invalid cookie name"
  assert_eq rc("é=\"q\" ; a b= lead", "SID"), ""
  assert_eq pc("x-y=\"a b\";\t=\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("x-y=\"a b\";\t=\"a b\"", "SID"), ""
  assert_eq pc("x-y=a,b ; é=\"q\" ; é\"; \t=v;"), "ERR http: invalid cookie name"
  assert_eq rc("x-y=a,b ; é=\"q\" ; é\"; \t=v;", "SID"), ""
  assert_eq pc("a,b ; é=a z"), "ERR http: '=' not found in cookie"
  assert_eq rc("a,b ; é=a z", "SID"), ""
  assert_eq pc(" sp =v ; c$=é ; na;me=x\\y;x-y"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =v ; c$=é ; na;me=x\\y;x-y", "a"), ""
  assert_eq pc("SID=v ; a b=é"), "ERR http: invalid cookie name"
  assert_eq rc("SID=v ; a b=é", "SID"), "SID|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("c$==;; sp =99=x;;a b=99=x"), "ERR http: '=' not found in cookie"
  assert_eq rc("c$==;; sp =99=x;;a b=99=x", ""), "c$|=|false|||zero||0|false|false|0|false| ; sp|99=x|false|||zero||0|false|false|0|false|"
  assert_eq pc("é=é; sp =a,b"), "ERR http: invalid cookie name"
  assert_eq rc("é=é; sp =a,b", "a"), ""
  assert_eq pc("a b=\"q\"; sp =v;a b= lead ;  sp =\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("a b=\"q\"; sp =v;a b= lead ;  sp =\"q\"", "x-y"), ""
  assert_eq pc("c$== ; a b=99=x; x-y99=x ; a=a,b"), "ERR http: invalid cookie name"
  assert_eq rc("c$== ; a b=99=x; x-y99=x ; a=a,b", "a"), "a|a,b|false|||zero||0|false|false|0|false|"
  assert_eq pc("=\" ; SID=x\\y ; a=\"a b\""), "ERR http: invalid cookie name"
  assert_eq rc("=\" ; SID=x\\y ; a=\"a b\"", "a"), "a|a b|true|||zero||0|false|false|0|false|"
  assert_eq pc("a b=\"q\" ; a b=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("a b=\"q\" ; a b=99=x", "x-y"), ""
  assert_eq pc("\t=\"q\";\t= lead; sp =v;; SID=x\\y"), "ERR http: invalid cookie name"
  assert_eq rc("\t=\"q\";\t= lead; sp =v;; SID=x\\y", "x-y"), ""
}

test "vectors: parse cookie 7" {
  assert_eq pc("a=a,b; x-y=v"), "a|a,b|false|||zero||0|false|false|0|false| ; x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq rc("a=a,b; x-y=v", ""), "a|a,b|false|||zero||0|false|false|0|false| ; x-y|v|false|||zero||0|false|false|0|false|"
  assert_eq pc("na;me=\"q\"; \t=v; c$=é;;a=x\\y"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=\"q\"; \t=v; c$=é;;a=x\\y", "SID"), ""
  assert_eq pc("na;me=99=x;aa z ; a b=v;"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me=99=x;aa z ; a b=v;", ""), "na||false|||zero||0|false|false|0|false| ; me|99=x|false|||zero||0|false|false|0|false|"
  assert_eq pc("\t=v; ; = lead; a b=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=v; ; = lead; a b=\"q\"", "x-y"), ""
  assert_eq pc("na;me\"q\";;SID99=x"), "ERR http: '=' not found in cookie"
  assert_eq rc("na;me\"q\";;SID99=x", "a"), ""
  assert_eq pc("x-y=a z;;c$=v;;c$=="), "ERR http: '=' not found in cookie"
  assert_eq rc("x-y=a z;;c$=v;;c$==", "x-y"), "x-y|a z|false|||zero||0|false|false|0|false|"
  assert_eq pc(" sp =a,b;;na;me=v;; sp =v;"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =a,b;;na;me=v;; sp =v;", "a"), ""
  assert_eq pc("=a z;\t=99=x"), "ERR http: invalid cookie name"
  assert_eq rc("=a z;\t=99=x", ""), ""
  assert_eq pc("é=a,b ; a b=="), "ERR http: invalid cookie name"
  assert_eq rc("é=a,b ; a b==", "SID"), ""
  assert_eq pc("\t=99=x; na;me=\"q\";;é=a,b; \t=\"q\""), "ERR http: invalid cookie name"
  assert_eq rc("\t=99=x; na;me=\"q\";;é=a,b; \t=\"q\"", "a"), ""
  assert_eq pc("c$=x\\y; c$=v ; na;me=v;; sp  lead"), "ERR http: invalid cookie value"
  assert_eq rc("c$=x\\y; c$=v ; na;me=v;; sp  lead", "x-y"), ""
  assert_eq pc(" sp =\"a b\";SID=é ; \t=v;"), "ERR http: invalid cookie name"
  assert_eq rc(" sp =\"a b\";SID=é ; \t=v;", "SID"), ""
  assert_eq pc("=; x-yv;; sp 99=x"), "ERR http: invalid cookie name"
