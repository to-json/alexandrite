# Generated from Go's net/http (go run, Go 1.27): ReadRequest and ReadResponse on readrequest_test.go's and response_test.go's inputs and on random messages; do not edit by hand.

test "vectors: read request 0" {
  assert_eq rreq("GET http://www.techcrunch.com/ HTTP/1.1\r\nHost: www.techcrunch.com\r\nUser-Agent: Fake\r\nAccept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\nAccept-Language: en-us,en;q=0.5\r\nAccept-Encoding: gzip,deflate\r\nAccept-Charset: ISO-8859-1,utf-8;q=0.7,*;q=0.7\r\nKeep-Alive: 300\r\nContent-Length: 7\r\nProxy-Connection: keep-alive\r\n\r\nabcdef\n???"), "GET|http://www.techcrunch.com/|http,www.techcrunch.com,/,|HTTP/1.1 1.1|host=www.techcrunch.com|{Accept=[text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8];Accept-Charset=[ISO-8859-1,utf-8;q=0.7,*;q=0.7];Accept-Encoding=[gzip,deflate];Accept-Language=[en-us,en;q=0.5];Content-Length=[7];Keep-Alive=[300];Proxy-Connection=[keep-alive];User-Agent=[Fake]}|cl=7|te=|close=false|tr={}|abcdef\n"
  assert_eq rreq("GET / HTTP/1.1\r\nHost: foo.com\r\n\r\n"), "GET|/|,,/,|HTTP/1.1 1.1|host=foo.com|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET //user@host/is/actually/a/path/ HTTP/1.1\r\nHost: test\r\n\r\n"), "GET|//user@host/is/actually/a/path/|,,//user@host/is/actually/a/path/,|HTTP/1.1 1.1|host=test|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET ../../../../etc/passwd HTTP/1.1\r\nHost: test\r\n\r\n"), "ERR parse \"../../../../etc/passwd\": invalid URI for request"
  assert_eq rreq("GET  HTTP/1.1\r\nHost: test\r\n\r\n"), "ERR parse \"\": empty url"
  assert_eq rreq("POST / HTTP/1.1\r\nHost: foo.com\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nfoo\r\n3\r\nbar\r\n0\r\nTrailer-Key: Trailer-Value\r\n\r\n"), "POST|/|,,/,|HTTP/1.1 1.1|host=foo.com|{}|cl=-1|te=chunked|close=false|tr={Trailer-Key=[Trailer-Value]}|foobar"
  assert_eq rreq("POST / HTTP/1.1\r\nHost: foo.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 9999\r\n\r\n3\r\nfoo\r\n3\r\nbar\r\n0\r\n\r\n"), "POST|/|,,/,|HTTP/1.1 1.1|host=foo.com|{}|cl=-1|te=chunked|close=false|tr={}|foobar"
  assert_eq rreq("POST / HTTP/1.1\r\nHost: foo.com\r\nTransfer-Encoding: chunked\r\nContent-Length: notdigits\r\n\r\n3\r\nfoo\r\n3\r\nbar\r\n0\r\n\r\n"), "ERR bad Content-Length \"notdigits\""
  assert_eq rreq("CONNECT www.google.com:443 HTTP/1.1\r\n\r\n"), "CONNECT|www.google.com:443|,www.google.com:443,,|HTTP/1.1 1.1|host=www.google.com:443|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT 127.0.0.1:6060 HTTP/1.1\r\n\r\n"), "CONNECT|127.0.0.1:6060|,127.0.0.1:6060,,|HTTP/1.1 1.1|host=127.0.0.1:6060|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT /_goRPC_ HTTP/1.1\r\n\r\n"), "CONNECT|/_goRPC_|,,/_goRPC_,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("NOTIFY * HTTP/1.1\r\nServer: foo\r\n\r\n"), "NOTIFY|*|,,*,|HTTP/1.1 1.1|host=|{Server=[foo]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("OPTIONS * HTTP/1.1\r\nServer: foo\r\n\r\n"), "OPTIONS|*|,,*,|HTTP/1.1 1.1|host=|{Server=[foo]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET / HTTP/1.1\r\nHost: issue8261.com\r\nConnection: close\r\n\r\n"), "GET|/|,,/,|HTTP/1.1 1.1|host=issue8261.com|{Connection=[close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("HEAD / HTTP/1.1\r\nHost: issue8261.com\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"), "HEAD|/|,,/,|HTTP/1.1 1.1|host=issue8261.com|{Connection=[close];Content-Length=[0]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"), "PRI|*|,,*,|HTTP/2.0 2.0|host=|{}|cl=-1|te=|close=true|tr={}|"
  assert_eq rreq("CONNECT []%20%48%54%54%50%2f%31%2e%31%0a%4d%79%48%65%61%64%65%72%3a%20%31%32%33%0a%0a HTTP/1.0\r\n\r\n"), "ERR parse \"http://[]%20%48%54%54%50%2f%31%2e%31%0a%4d%79%48%65%61%64%65%72%3a%20%31%32%33%0a%0a\": invalid port \"%20%48%54%54%50%2f%31%2e%31%0a%4d%79%48%65%61%64%65%72%3a%20%31%32%33%0a%0a\" after host"
  assert_eq rreq("POST / HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 4\r\n\r\nabc\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"3\" \"4\"]"
  assert_eq rreq("HEAD / HTTP/1.1\r\nHost: foo\r\nContent-Length: 4\r\nContent-Length: 5\r\n\r\n1234\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"4\" \"5\"]"
  assert_eq rreq("GET / HTTP/1.1\r\n Host: foo\r\n\r\n"), "ERR malformed MIME header initial line: \" Host: foo\""
  assert_eq rreq("GET / HTTP/1.1\r\n\tHost: foo\r\n\r\n"), "ERR malformed MIME header initial line: \"\\tHost: foo\""
  assert_eq rreq("GET / HTTP/1.1 x\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: gzip\r\nHost: x\r\nPragma: no-cache\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("POST /? HTTP/1.2\r\nContent-Length:\r\nbad header\r\nTrailer: Content-Length\r\nTransfer-Encoding: gzip\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("HEAD /a/b?c=d&e=f HTTP/1.10\r\nContent-Length: -1\r\nX-Empty:\r\nTransfer-Encoding: Chunked\r\nX-Sp : v\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD /%zz HTTP/1.1\r\nContent-Length: 05\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("PUT /%zz HTTP/1.1\r\nPragma: no-cache\r\nContent-Length: 05\r\nContent-Length: 5\r\nX-Dup: 2\r\n\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("get /? HTTP/1.10\r\nContent-Length: 5\r\nHost: x\r\nConnection: close\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("CONNECT /a/b?c=d&e=f HTTP/1\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\n\r\n5\r\nhel"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD //x/y HTTP/1.1\r\nContent-Length:\r\nbad header\r\nContent-Length: -1\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq("CONNECT * http/1.1\r\nCache-Control: max-age=1\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("HEAD http://[::1]:8/ HTTP/1\r\nConnection: Upgrade, Close\r\nTransfer-Encoding: chunked, gzip\r\nx-lower: v\r\nContent-Length: 3\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T / http/1.1\r\nTransfer-Encoding: chunked\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("POST http://[::1]:8/ HTTP/1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nContent-Length: 0\r\nTrailer: a, b\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PRI http://h.com/p?q http/1.1\r\nTransfer-Encoding: chunked, gzip\r\nTransfer-Encoding: Chunked\r\nX-Empty:\r\n\r\nhello"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET /a%20b http/1.1\r\nTrailer: X-T\r\nCache-Control: max-age=1\r\nContent-Length: 05\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get /a/b?c=d&e=f HTTP/1\r\nX-Sp : v\r\nConnection: keep-alive\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("HEAD //x/y HTTP/1.1\r\nTransfer-Encoding: Chunked\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "HEAD|//x/y|,,//x/y,|HTTP/1.1 1.1|host=|{}|cl=-1|te=chunked|close=false|tr={}|0123456789"
  assert_eq rreq("CONNECT / HTTP/2.0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "CONNECT|/|,,/,|HTTP/2.0 2.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST /a/b?c=d&e=f HTTP/1\r\nbad header\r\nContent-Length: 0\r\nx-lower: v\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq(" / HTTP/1.0\r\nTrailer: a, b\r\nCache-Control: max-age=1\r\nContent-Length: 3\r\nContent-Length: -1\r\n\r\nzz\r\n"), "ERR invalid method \"\""
  assert_eq rreq("CONNECT //x/y HTTP/1.0\r\nTrailer: Content-Length\r\nTrailer: Content-Length\r\n\r\n0\r\n\r\n"), "CONNECT|//x/y|,,//x/y,|HTTP/1.0 1.0|host=|{Trailer=[Content-Length|Content-Length]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET http://h.com/p?q HTTP/1.0\r\nHost: y.com:80\r\nbad header\r\n\r\n5\r\nhel"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq(" h.com:443 HTTP/1.10\r\n\r\nzz\r\n"), "ERR invalid method \"\""
  assert_eq rreq("OPTIONS http://[::1]:8/ HTTP/1.2\r\nTrailer: a, b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "OPTIONS|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.2 1.2|host=[::1]:8|{Trailer=[a, b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI /? HTTP/1.0\r\nConnection: keep-alive\r\nConnection: Upgrade, Close\r\nTransfer-Encoding: Chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "PRI|/?|,,/,|HTTP/1.0 1.0|host=|{Connection=[keep-alive|Upgrade, Close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("POST * HTTP/1.10\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq(" //x/y HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\nhello world"), "ERR invalid method \"\""
  assert_eq rreq("G(T x HTTP/2.0\r\nTransfer-Encoding: chunked, gzip\r\nX-Dup: 2\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET  / HTTP/1.1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("PUT * HTTP/2.0\r\nX-Dup: 1\r\nX-Folded: a\r\n b\r\nTrailer: a, b\r\n\r\n0\r\n\r\n"), "PUT|*|,,*,|HTTP/2.0 2.0|host=|{Trailer=[a, b];X-Dup=[1];X-Folded=[a b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("\r\nTransfer-Encoding: chunked\r\nX-Empty:\r\nContent-Length: 0\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq(" http://[::1]:8/ HTTP/1.2\r\nX-Dup: 1\r\nContent-Length: 05\r\nTrailer: Content-Length\r\nConnection: close\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("POST /? HTTP/1.1\r\nX-Empty:\r\nx-lower: v\r\nConnection: Upgrade, Close\r\n\r\n"), "POST|/?|,,/,|HTTP/1.1 1.1|host=|{Connection=[Upgrade, Close];X-Empty=[];X-Lower=[v]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("get x HTTP/3.0\r\nHost: x\r\nConnection: close\r\nConnection: keep-alive\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("OPTIONS /a%20b HTTP/1.10\r\nX-Dup: 2\r\nTrailer: X-T\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("POST /? http/1.1\r\nExpect: 100-continue\r\nTrailer: X-T\r\nTrailer: X-T\r\nContent-Length: 05\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq(" http://h.com/p?q HTTP/3.0\r\nContent-Length:\r\nTransfer-Encoding: Chunked\r\nContent-Length:\r\nContent-Length:\r\n\r\nhello"), "ERR invalid method \"\""
  assert_eq rreq("PRI /? HTTP/1.1\r\nPragma: no-cache\r\n\r\n"), "PRI|/?|,,/,|HTTP/1.1 1.1|host=|{Cache-Control=[no-cache];Pragma=[no-cache]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("OPTIONS * HTTP/1.10\r\nX-Dup: 2\r\n\r\nhello world"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("GET / HTTP/1.1 x\r\nX-Sp : v\r\nContent-Length: 0\r\nContent-Length: 3\r\nHost: y.com:80\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq(" http://h.com/p?q HTTP/1\r\nTrailer: Content-Length\r\nConnection: close\r\nTransfer-Encoding: gzip\r\nContent-Length: 0\r\n\r\nhello world"), "ERR invalid method \"\""
  assert_eq rreq("OPTIONS * HTTP/1.10\r\nContent-Length: 5\r\nX-Dup: 1\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("G(T //x/y HTTP/1.0\r\nContent-Length: 0\r\nHost: y.com:80\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get //x/y HTTP/2.0\r\nConnection: Upgrade, Close\r\n\r\n"), "get|//x/y|,,//x/y,|HTTP/2.0 2.0|host=|{Connection=[Upgrade, Close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("get * HTTP/1.0\r\nContent-Length: 5\r\nx-lower: v\r\nExpect: 100-continue\r\n\r\nhello"), "get|*|,,*,|HTTP/1.0 1.0|host=|{Content-Length=[5];Expect=[100-continue];X-Lower=[v]}|cl=5|te=|close=true|tr={}|hello"
  assert_eq rreq("HEAD http://[::1]:8/ HTTP/1\r\nTransfer-Encoding: chunked\r\nContent-Length: 0\r\nbad header\r\nTransfer-Encoding: Chunked\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PUT x HTTP/3.0\r\nHost: x\r\nCache-Control: max-age=1\r\nbad header\r\nTransfer-Encoding: Chunked\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("PUT h.com:443 HTTP/1.1\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 05\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("\r\nX-Empty:\r\nTrailer: X-T\r\nX-Dup: 1\r\nTransfer-Encoding: gzip\r\n\r\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq("HEAD http://[::1]:8/ HTTP/3.0\r\nHost: y.com:80\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "HEAD|http://[::1]:8/|http,[::1]:8,/,|HTTP/3.0 3.0|host=[::1]:8|{Connection=[Upgrade, Close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("HEAD /a%20b HTTP/1.2\r\n\r\n"), "HEAD|/a%20b|,,/a b,|HTTP/1.2 1.2|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get /a/b?c=d&e=f HTTP/1.1\r\nTransfer-Encoding: chunked\r\nCache-Control: max-age=1\r\nX-Dup: 2\r\nConnection: close\r\n\r\nzz\r\n"), "ERR invalid byte in chunk length"
  assert_eq rreq("get h.com:443 HTTP/1.1\r\nx-lower: v\r\nCache-Control: max-age=1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "get|h.com:443|h.com,,,|HTTP/1.1 1.1|host=|{Cache-Control=[max-age=1];X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get h.com:443 HTTP/1.10\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("G(T /%zz HTTP/1.2\r\nContent-Length: 5\r\nTrailer: X-T\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq(" / HTTP/1.1\r\nConnection: close\r\n\r\nhello"), "ERR invalid method \"\""
  assert_eq rreq("GET /\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP request \"GET /\""
  assert_eq rreq("GET /a%20b HTTP/3.0\r\nTransfer-Encoding: chunked\r\nX-Dup: 2\r\nTransfer-Encoding: chunked, gzip\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR too many transfer encodings: [\"chunked\" \"chunked, gzip\"]"
  assert_eq rreq("PUT x HTTP/1.0\r\nX-Folded: a\r\n b\r\nTransfer-Encoding: chunked, gzip\r\nTransfer-Encoding: Chunked\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("POST x HTTP/1.0\r\nContent-Length: 05\r\nConnection: Upgrade, Close\r\nTransfer-Encoding: gzip\r\n\r\nhello"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("OPTIONS http://[::1]:8/ HTTP/2.0\r\nTransfer-Encoding: chunked\r\nTrailer: X-T\r\nConnection: close\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "OPTIONS|http://[::1]:8/|http,[::1]:8,/,|HTTP/2.0 2.0|host=[::1]:8|{Connection=[close]}|cl=-1|te=chunked|close=true|tr={X-T=[tv]}|hello"
  assert_eq rreq("HEAD /%zz HTTP/1.10\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("G(T /a%20b http/1.1\r\nTransfer-Encoding: Chunked\r\nContent-Length: 05\r\nTrailer: a, b\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq(" //x/y HTTP/1.0\r\nContent-Length: -1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("PUT /%zz http/1.1\r\nTransfer-Encoding: gzip\r\n\r\nhello"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("CONNECT h.com:443 HTTP/1\r\nContent-Length: 05\r\nX-Empty:\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PRI /? HTTP/1.1\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "PRI|/?|,,/,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET / HTTP/1.1 x\r\nTrailer: X-T\r\nContent-Length: 5\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("PRI //x/y http/1.1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get //x/y HTTP/2.0\r\nTrailer: Content-Length\r\nTrailer: Content-Length\r\n\r\n0\r\n\r\n"), "get|//x/y|,,//x/y,|HTTP/2.0 2.0|host=|{Trailer=[Content-Length|Content-Length]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/3.0\r\nPragma: no-cache\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("POST h.com:443 HTTP/1.1\r\nTrailer: a, b\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhel"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("CONNECT http://h.com/p?q HTTP/1.1\r\n\r\n5\r\nhel"), "CONNECT|http://h.com/p?q|,http:,//h.com/p,q|HTTP/1.1 1.1|host=http:|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT //x/y HTTP/1.10\r\nX-Dup: 2\r\nX-Empty:\r\nX-Folded: a\r\n b\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("get / HTTP/2.0\r\nPragma: no-cache\r\nContent-Length: 3\r\n"), "ERR unexpected EOF"
  assert_eq rreq("POST h.com:443 HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\nbad header\r\n\r\nzz\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("CONNECT http://h.com/p?q HTTP/1.0\r\nbad header\r\nPragma: no-cache\r\nContent-Length: 0\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("get /a%20b HTTP/3.0\r\nConnection: close\r\nConnection: keep-alive\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "get|/a%20b|,,/a b,|HTTP/3.0 3.0|host=|{Connection=[close|keep-alive];Trailer=[Content-Length]}|cl=0|te=|close=true|tr={}|"
}

test "vectors: read request 1" {
  assert_eq rreq("POST /a/b?c=d&e=f HTTP/2.0\r\nX-Sp : v\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "POST|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/2.0 2.0|host=|{X-Sp =[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get * HTTP/1.10\r\nX-Dup: 1\r\nContent-Length: 0\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("POST /? HTTP/1.1\r\n"), "ERR unexpected EOF"
  assert_eq rreq("CONNECT //x/y HTTP/1.0\r\nbad header\r\nContent-Length: 3\r\nX-Dup: 2\r\nCache-Control: max-age=1\r\n\r\nhello world"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("G(T /a/b?c=d&e=f HTTP/1.1\r\nContent-Length: 05\r\nTransfer-Encoding: chunked, gzip\r\nTrailer: a, b\r\nTransfer-Encoding: Chunked\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("POST /a/b?c=d&e=f HTTP/1.1\r\nExpect: 100-continue\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "POST|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.1 1.1|host=|{Expect=[100-continue]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET http://[::1]:8/ HTTP/1\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("POST * HTTP/1\r\nPragma: no-cache\r\nTransfer-Encoding: gzip\r\nTrailer: a, b\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq(" http://[::1]:8/ HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\nPragma: no-cache\r\n\r\n5\r\nhel"), "ERR invalid method \"\""
  assert_eq rreq("HEAD x HTTP/1.2\r\nTransfer-Encoding: gzip\r\nX-Empty:\r\nConnection: Upgrade, Close\r\n\r\n5\nhello\n0\n\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("HEAD x HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\n0\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("GET /\r\nTransfer-Encoding: gzip\r\nContent-Length:\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP request \"GET /\""
  assert_eq rreq("HEAD /%zz HTTP/1.10\r\nX-Dup: 1\r\nTransfer-Encoding: chunked\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("get //x/y HTTP/1.1\r\nCache-Control: max-age=1\r\nx-lower: v\r\nConnection: close\r\nConnection: keep-alive\r\n\r\n0\r\n\r\n"), "get|//x/y|,,//x/y,|HTTP/1.1 1.1|host=|{Cache-Control=[max-age=1];Connection=[close|keep-alive];X-Lower=[v]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("PRI /%zz HTTP/1.1\r\nContent-Length: 3\r\nCache-Control: max-age=1\r\n\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq(" /a%20b HTTP/1.1\r\n\r\nhello"), "ERR invalid method \"\""
  assert_eq rreq("CONNECT x HTTP/1.2\r\nContent-Length: 05\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"05\" \"3\"]"
  assert_eq rreq("GET x HTTP/1.1\r\n\r\nhello world"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("G(T /a/b?c=d&e=f http/1.1\r\nX-Dup: 1\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET /\r\nContent-Length: 5\r\nContent-Length: 0\r\nHost: y.com:80\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP request \"GET /\""
  assert_eq rreq("get / HTTP/1\r\nHost: x\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("POST /? HTTP/1.2\r\nTrailer: Content-Length\r\nHost: y.com:80\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "POST|/?|,,/,|HTTP/1.2 1.2|host=y.com:80|{Connection=[Upgrade, Close];Trailer=[Content-Length]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("PRI x HTTP/1.1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("GET /? HTTP/1\r\nContent-Length:\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("HEAD /a%20b HTTP/1.10\r\nContent-Length: 5\r\nX-Folded: a\r\n b\r\nHost: x\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq(" /a/b?c=d&e=f HTTP/1.0\r\nContent-Length:\r\nConnection: Upgrade, Close\r\nContent-Length: 5\r\nHost: y.com:80\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"\""
  assert_eq rreq("HEAD * HTTP/1.10\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("G(T x HTTP/2.0\r\nContent-Length: 05\r\nX-Dup: 2\r\n\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT /a%20b http/1.1\r\nTransfer-Encoding: gzip\r\nX-Sp : v\r\nbad header\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq(" http://h.com/p?q HTTP/3.0\r\nHost: x\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: gzip\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("get //x/y HTTP/1.2\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"), "ERR too many transfer encodings: [\"Chunked\" \"gzip\" \"chunked\"]"
  assert_eq rreq("CONNECT /a%20b HTTP/1\r\nTransfer-Encoding: Chunked\r\nContent-Length: 0\r\nExpect: 100-continue\r\nbad header\r\n\r\nhello world"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq(" /%zz HTTP/1.1\r\nExpect: 100-continue\r\nX-Sp : v\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("POST /? HTTP/1.0\r\nCache-Control: max-age=1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "POST|/?|,,/,|HTTP/1.0 1.0|host=|{Cache-Control=[max-age=1]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET  / HTTP/1.1\r\nContent-Length: 3\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("PRI /a%20b http/1.1\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PRI * HTTP/1.1\r\nConnection: keep-alive\r\nContent-Length: 3\r\nX-Empty:\r\n\r\n5\r\nhel"), "PRI|*|,,*,|HTTP/1.1 1.1|host=|{Connection=[keep-alive];Content-Length=[3];X-Empty=[]}|cl=3|te=|close=false|tr={}|5\r\n"
  assert_eq rreq("HEAD /a/b?c=d&e=f HTTP/3.0\r\nTrailer: X-T\r\nPragma: no-cache\r\nTransfer-Encoding: Chunked\r\n"), "ERR unexpected EOF"
  assert_eq rreq("HEAD * HTTP/1.0\r\nx-lower: v\r\nContent-Length: 5\r\nTrailer: Content-Length\r\n"), "ERR unexpected EOF"
  assert_eq rreq("get http://h.com/p?q HTTP/1.2\r\nHost: y.com:80\r\nX-Folded: a\r\n b\r\n\r\nhello world"), "get|http://h.com/p?q|http,h.com,/p,q|HTTP/1.2 1.2|host=h.com|{X-Folded=[a b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T http://h.com/p?q HTTP/1.10\r\nX-Dup: 1\r\nContent-Length: -1\r\nX-Empty:\r\n\r\nhello world"), "ERR invalid method \"G(T\""
  assert_eq rreq("CONNECT h.com:443 HTTP/1.10\r\nbad header\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("OPTIONS x HTTP/1.2\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("G(T /a/b?c=d&e=f HTTP/1.2\r\nTransfer-Encoding: gzip\r\nContent-Length:\r\nConnection: close\r\n\r\nzz\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT h.com:443 HTTP/1.1\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: gzip\r\n\r\nhello world"), "ERR too many transfer encodings: [\"Chunked\" \"gzip\"]"
  assert_eq rreq("CONNECT /a%20b HTTP/1.10\r\nHost: y.com:80\r\nCache-Control: max-age=1\r\nX-Dup: 1\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("GET * HTTP/2.0\r\nContent-Length: 05\r\nExpect: 100-continue\r\nTransfer-Encoding: Chunked\r\n\r\nhello"), "ERR unexpected EOF"
  assert_eq rreq("HEAD //x/y HTTP/1.2\r\nX-Folded: a\r\n b\r\nPragma: no-cache\r\nExpect: 100-continue\r\n\r\nzz\r\n"), "HEAD|//x/y|,,//x/y,|HTTP/1.2 1.2|host=|{Cache-Control=[no-cache];Expect=[100-continue];Pragma=[no-cache];X-Folded=[a b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT http://h.com/p?q HTTP/1.1\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\nhello"), "CONNECT|http://h.com/p?q|,http:,//h.com/p,q|HTTP/1.1 1.1|host=http:|{Content-Length=[0]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T http://[::1]:8/ http/1.1\r\nConnection: close\r\nHost: y.com:80\r\n\r\nhello"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD * HTTP/1.10\r\nContent-Length: 05\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("get //x/y HTTP/1.1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "get|//x/y|,,//x/y,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT / HTTP/1.1\r\nx-lower: v\r\n\r\nhello world"), "CONNECT|/|,,/,|HTTP/1.1 1.1|host=|{X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT //x/y HTTP/1.2\r\n\r\n"), "CONNECT|//x/y|,,//x/y,|HTTP/1.2 1.2|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("OPTIONS / HTTP/2.0\r\nHost: y.com:80\r\nContent-Length: 5\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq(" h.com:443 HTTP/1.2\r\nTrailer: X-T\r\nX-Empty:\r\nContent-Length: 0\r\n\r\nhello"), "ERR invalid method \"\""
  assert_eq rreq("HEAD /? HTTP/1\r\nTrailer: a, b\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PRI /a/b?c=d&e=f HTTP/3.0\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "PRI|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/3.0 3.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T http://h.com/p?q HTTP/3.0\r\nContent-Length: 0\r\nX-Empty:\r\nContent-Length: 5\r\n\r\nzz\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT //x/y HTTP/3.0\r\n\r\nhello"), "PUT|//x/y|,,//x/y,|HTTP/3.0 3.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT h.com:443 http/1.1\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET /a%20b HTTP/1.1\r\n\r\nhello world"), "GET|/a%20b|,,/a b,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET h.com:443 HTTP/1\r\nbad header\r\nX-Sp : v\r\nConnection: keep-alive\r\nContent-Length: 3\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T h.com:443 HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\nConnection: keep-alive\r\n\r\nhello"), "ERR invalid method \"G(T\""
  assert_eq rreq("G(T x HTTP/1.1\r\nCache-Control: max-age=1\r\nHost: x\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD /a/b?c=d&e=f HTTP/1\r\nTransfer-Encoding: chunked, gzip\r\nConnection: Upgrade, Close\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("OPTIONS /%zz http/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("HEAD h.com:443 HTTP/1.10\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("get /%zz HTTP/3.0\r\nTransfer-Encoding: chunked\r\nX-Folded: a\r\n b\r\nHost: y.com:80\r\nContent-Length: 05\r\n\r\nzz\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("GET /a%20b HTTP/1.0\r\nContent-Length: 0\r\nConnection: close\r\nPragma: no-cache\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "GET|/a%20b|,,/a b,|HTTP/1.0 1.0|host=|{Cache-Control=[no-cache];Connection=[close];Content-Length=[0];Pragma=[no-cache]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("HEAD / HTTP/2.0\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "HEAD|/|,,/,|HTTP/2.0 2.0|host=|{}|cl=-1|te=chunked|close=false|tr={X-T=[tv]}|hello"
  assert_eq rreq("GET / HTTP/1.1 x\r\nConnection: Upgrade, Close\r\nTransfer-Encoding: chunked\r\nContent-Length: -1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/1.1\r\nx-lower: v\r\n\r\n5\nhello\n0\n\n"), "GET|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.1 1.1|host=|{X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT /a/b?c=d&e=f HTTP/1.1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "CONNECT|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET  / HTTP/1.1\r\nTransfer-Encoding: chunked, gzip\r\nTransfer-Encoding: chunked\r\nExpect: 100-continue\r\nContent-Length: 0\r\n\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("OPTIONS /? HTTP/1.10\r\nTrailer: Content-Length\r\nTrailer: X-T\r\nTransfer-Encoding: gzip\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("POST * HTTP/3.0\r\nConnection: Upgrade, Close\r\nTrailer: Content-Length\r\n\r\n"), "POST|*|,,*,|HTTP/3.0 3.0|host=|{Connection=[Upgrade, Close];Trailer=[Content-Length]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("OPTIONS /a/b?c=d&e=f HTTP/3.0\r\nX-Dup: 2\r\nCache-Control: max-age=1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "OPTIONS|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/3.0 3.0|host=|{Cache-Control=[max-age=1];X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST http://[::1]:8/ HTTP/3.0\r\nContent-Length: 0\r\nCache-Control: max-age=1\r\n"), "ERR unexpected EOF"
  assert_eq rreq("CONNECT /? HTTP/1.1\r\nX-Folded: a\r\n b\r\n\r\n5\r\nhel"), "CONNECT|/?|,,/,|HTTP/1.1 1.1|host=|{X-Folded=[a b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT //x/y HTTP/1.0\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "CONNECT|//x/y|,,//x/y,|HTTP/1.0 1.0|host=|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("CONNECT http://[::1]:8/ HTTP/1.0\r\n"), "ERR unexpected EOF"
  assert_eq rreq("G(T h.com:443 http/1.1\r\nExpect: 100-continue\r\nX-Sp : v\r\nContent-Length: 05\r\nTransfer-Encoding: gzip\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD /%zz HTTP/1.2\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("HEAD * http/1.1\r\nTrailer: Content-Length\r\nX-Empty:\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("POST h.com:443 HTTP/1.0\r\nContent-Length:\r\nPragma: no-cache\r\n\r\nhello"), "ERR invalid empty Content-Length \"\""
  assert_eq rreq("POST /a%20b HTTP/1\r\nTransfer-Encoding: Chunked\r\nExpect: 100-continue\r\nContent-Length: -1\r\nTrailer: X-T\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("OPTIONS x HTTP/1.2\r\nHost: y.com:80\r\nX-Folded: a\r\n b\r\nContent-Length: -1\r\nX-Dup: 1\r\n\r\n5\nhello\n0\n\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("CONNECT http://[::1]:8/ http/1.1\r\nExpect: 100-continue\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET //x/y HTTP/3.0\r\n"), "ERR unexpected EOF"
  assert_eq rreq("GET http://h.com/p?q HTTP/3.0\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "GET|http://h.com/p?q|http,h.com,/p,q|HTTP/3.0 3.0|host=h.com|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD http://[::1]:8/ HTTP/1.0\r\nX-Folded: a\r\n b\r\nContent-Length: 5\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "HEAD|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.0 1.0|host=[::1]:8|{Content-Length=[5];X-Folded=[a b]}|cl=5|te=|close=true|tr={}|1\r\nab"
  assert_eq rreq("get /a/b?c=d&e=f HTTP/3.0\r\nHost: y.com:80\r\nHost: y.com:80\r\nHost: x\r\n\r\n5\r\nhel"), "ERR too many Host headers"
  assert_eq rreq(" http://h.com/p?q HTTP/1\r\nX-Folded: a\r\n b\r\n\r\n5\r\nhel"), "ERR invalid method \"\""
  assert_eq rreq("get /%zz http/1.1\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: chunked\r\nContent-Length: 05\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("G(T http://[::1]:8/ HTTP/1.10\r\nCache-Control: max-age=1\r\nConnection: Upgrade, Close\r\nContent-Length:\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("G(T h.com:443 HTTP/2.0\r\nContent-Length:\r\nExpect: 100-continue\r\nContent-Length: -1\r\nTransfer-Encoding: chunked\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq(" /%zz http/1.1\r\nHost: y.com:80\r\nX-Dup: 1\r\n"), "ERR invalid method \"\""
  assert_eq rreq("OPTIONS /a%20b HTTP/1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq(" http://[::1]:8/ HTTP/1\r\nTrailer: a, b\r\nContent-Length: -1\r\nx-lower: v\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR invalid method \"\""
}

test "vectors: read request 2" {
  assert_eq rreq("HEAD * HTTP/1.1\r\nTransfer-Encoding: chunked, gzip\r\nHost: x\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("HEAD //x/y http/1.1\r\nTransfer-Encoding: gzip\r\nContent-Length: 5\r\nContent-Length: 05\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get x HTTP/1\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T / http/1.1\r\nX-Folded: a\r\n b\r\nX-Dup: 1\r\nTrailer: Content-Length\r\n\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get //x/y HTTP/1.10\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: gzip\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("G(T /? HTTP/2.0\r\nExpect: 100-continue\r\nContent-Length:\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT / HTTP/1\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq(" x http/1.1\r\nContent-Length:\r\n\r\n5\r\nhel"), "ERR invalid method \"\""
  assert_eq rreq("CONNECT /%zz HTTP/2.0\r\nContent-Length: 0\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("get /? HTTP/2.0\r\nTrailer: X-T\r\n"), "ERR unexpected EOF"
  assert_eq rreq("OPTIONS http://[::1]:8/ HTTP/1.10\r\nHost: x\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("GET /%zz HTTP/1\r\nContent-Length: -1\r\nX-Sp : v\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("POST /a%20b HTTP/3.0\r\nConnection: close\r\nTrailer: a, b\r\nbad header\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("G(T //x/y HTTP/1.1\r\nTrailer: Content-Length\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET http://h.com/p?q HTTP/1.10\r\nHost: x\r\nExpect: 100-continue\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/1.1\r\nx-lower: v\r\nX-Folded: a\r\n b\r\n\r\nzz\r\n"), "GET|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.1 1.1|host=|{X-Folded=[a b];X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI h.com:443 HTTP/3.0\r\nHost: x\r\nExpect: 100-continue\r\nTrailer: X-T\r\n"), "ERR unexpected EOF"
  assert_eq rreq("G(T / HTTP/1.10\r\nX-Dup: 1\r\nContent-Length: 05\r\nTrailer: X-T\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get http://[::1]:8/ HTTP/1.10\r\nContent-Length: -1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("OPTIONS * HTTP/1.10\r\nHost: y.com:80\r\nContent-Length: 0\r\nExpect: 100-continue\r\nTrailer: Content-Length\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("PRI h.com:443 HTTP/1.2\r\nContent-Length: 5\r\nExpect: 100-continue\r\nPragma: no-cache\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "PRI|h.com:443|h.com,,,|HTTP/1.2 1.2|host=|{Cache-Control=[no-cache];Content-Length=[5];Expect=[100-continue];Pragma=[no-cache]}|cl=5|te=|close=false|tr={}|5\r\nhe"
  assert_eq rreq("G(T /%zz http/1.1\r\nTrailer: X-T\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get * HTTP/1.1\r\nContent-Length: 0\r\nTransfer-Encoding: Chunked\r\n\r\nhello world"), "ERR unexpected EOF"
  assert_eq rreq("CONNECT x HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\nTransfer-Encoding: Chunked\r\n"), "ERR unexpected EOF"
  assert_eq rreq(" http://h.com/p?q HTTP/1.10\r\n"), "ERR invalid method \"\""
  assert_eq rreq("G(T /%zz HTTP/1.2\r\nContent-Length: -1\r\nContent-Length: -1\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PRI //x/y HTTP/1\r\nTrailer: a, b\r\nX-Dup: 2\r\nContent-Length: 05\r\nTransfer-Encoding: chunked, gzip\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("get /? http/1.1\r\nX-Dup: 2\r\nContent-Length:\r\nHost: y.com:80\r\nX-Empty:\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("POST / HTTP/3.0\r\nCache-Control: max-age=1\r\nExpect: 100-continue\r\n\r\n5\r\nhel"), "POST|/|,,/,|HTTP/3.0 3.0|host=|{Cache-Control=[max-age=1];Expect=[100-continue]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq(" h.com:443 http/1.1\r\nTrailer: a, b\r\nX-Dup: 2\r\nX-Dup: 2\r\nTransfer-Encoding: Chunked\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("get x HTTP/2.0\r\nTrailer: a, b\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("OPTIONS h.com:443 HTTP/1.0\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: chunked, gzip\r\nHost: y.com:80\r\nTrailer: X-T\r\n"), "ERR unexpected EOF"
  assert_eq rreq("get http://h.com/p?q HTTP/3.0\r\nConnection: keep-alive\r\nX-Sp : v\r\nTransfer-Encoding: chunked, gzip\r\nPragma: no-cache\r\n"), "ERR unexpected EOF"
  assert_eq rreq("get http://h.com/p?q HTTP/1.1\r\nHost: x\r\nX-Dup: 2\r\n\r\n0\r\n\r\n"), "get|http://h.com/p?q|http,h.com,/p,q|HTTP/1.1 1.1|host=h.com|{X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT /a/b?c=d&e=f HTTP/1.2\r\nbad header\r\n\r\nzz\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("PRI h.com:443 HTTP/1.1\r\nTrailer: Content-Length\r\nContent-Length: 05\r\nContent-Length: 05\r\n"), "ERR unexpected EOF"
  assert_eq rreq("PUT http://h.com/p?q HTTP/1.1\r\nContent-Length: 05\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "PUT|http://h.com/p?q|http,h.com,/p,q|HTTP/1.1 1.1|host=h.com|{Content-Length=[05]}|cl=5|te=|close=false|tr={}|5\r\nhe"
  assert_eq rreq("PUT //x/y HTTP/2.0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "PUT|//x/y|,,//x/y,|HTTP/2.0 2.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PUT / HTTP/2.0\r\nPragma: no-cache\r\nContent-Length: -1\r\nContent-Length: -1\r\n\r\nhello"), "ERR bad Content-Length \"-1\""
  assert_eq rreq("POST /a/b?c=d&e=f HTTP/1.0\r\n"), "ERR unexpected EOF"
  assert_eq rreq("CONNECT h.com:443 HTTP/3.0\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: gzip\r\nHost: x\r\n\r\n0\r\n\r\n"), "ERR too many transfer encodings: [\"Chunked\" \"gzip\"]"
  assert_eq rreq("GET  / HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/1.1\r\nExpect: 100-continue\r\nX-Dup: 2\r\n\r\n0\r\n\r\n"), "GET|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.1 1.1|host=|{Expect=[100-continue];X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI http://h.com/p?q HTTP/3.0\r\nContent-Length: 0\r\n"), "ERR unexpected EOF"
  assert_eq rreq("HEAD / http/1.1\r\nTrailer: Content-Length\r\nTransfer-Encoding: Chunked\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET\r\nExpect: 100-continue\r\nConnection: close\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP request \"GET\""
  assert_eq rreq("G(T / HTTP/1.1\r\nTrailer: X-T\r\nHost: x\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get http://[::1]:8/ http/1.1\r\nbad header\r\nContent-Length:\r\nX-Empty:\r\nX-Dup: 2\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PUT /%zz HTTP/2.0\r\nCache-Control: max-age=1\r\nConnection: keep-alive\r\n\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("HEAD http://[::1]:8/ http/1.1\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("\r\nbad header\r\nExpect: 100-continue\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq("OPTIONS //x/y http/1.1\r\nContent-Length:\r\nPragma: no-cache\r\nHost: x\r\nX-Dup: 2\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("HEAD /? HTTP/1.1\r\nContent-Length: 0\r\n\r\nzz\r\n"), "HEAD|/?|,,/,|HTTP/1.1 1.1|host=|{Content-Length=[0]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET  / HTTP/1.1\r\nConnection: keep-alive\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("G(T //x/y HTTP/1.2\r\n\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("CONNECT http://[::1]:8/ HTTP/1.0\r\nX-Empty:\r\nContent-Length: -1\r\nX-Dup: 2\r\nContent-Length: -1\r\n\r\n0\r\n\r\n"), "ERR bad Content-Length \"-1\""
  assert_eq rreq("G(T /? HTTP/1.0\r\n\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/3.0\r\nTransfer-Encoding: chunked, gzip\r\n\r\nhello"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("CONNECT /? HTTP/1.0\r\nContent-Length: 3\r\nX-Dup: 2\r\n\r\nzz\r\n"), "CONNECT|/?|,,/,|HTTP/1.0 1.0|host=|{Content-Length=[3];X-Dup=[2]}|cl=3|te=|close=true|tr={}|zz\r"
  assert_eq rreq("PUT /a/b?c=d&e=f http/1.1\r\nConnection: Upgrade, Close\r\nTransfer-Encoding: gzip\r\nContent-Length: 3\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PRI /%zz HTTP/1.10\r\nContent-Length: -1\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD http://[::1]:8/ HTTP/1.10\r\nTransfer-Encoding: chunked, gzip\r\nTrailer: X-T\r\nbad header\r\nContent-Length: -1\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("G(T /? HTTP/1.2\r\nContent-Length: 05\r\nTransfer-Encoding: gzip\r\nX-Sp : v\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("POST //x/y HTTP/1.0\r\nConnection: close\r\n\r\nhello world"), "POST|//x/y|,,//x/y,|HTTP/1.0 1.0|host=|{Connection=[close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET http://[::1]:8/ HTTP/1\r\nContent-Length: -1\r\nTrailer: Content-Length\r\nContent-Length: 0\r\nContent-Length: -1\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("GET /%zz HTTP/3.0\r\nHost: y.com:80\r\nHost: x\r\nConnection: Upgrade, Close\r\n\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("PRI h.com:443 http/1.1\r\nConnection: close\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("HEAD /%zz http/1.1\r\nContent-Length: 3\r\nConnection: keep-alive\r\nX-Empty:\r\nx-lower: v\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PRI /? HTTP/3.0\r\nContent-Length: 0\r\nConnection: Upgrade, Close\r\n\r\n"), "PRI|/?|,,/,|HTTP/3.0 3.0|host=|{Connection=[Upgrade, Close];Content-Length=[0]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq(" x HTTP/1.1\r\nx-lower: v\r\nConnection: keep-alive\r\nPragma: no-cache\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("GET /a%20b HTTP/1.0\r\nExpect: 100-continue\r\nPragma: no-cache\r\nHost: y.com:80\r\n\r\n5\nhello\n0\n\n"), "GET|/a%20b|,,/a b,|HTTP/1.0 1.0|host=y.com:80|{Cache-Control=[no-cache];Expect=[100-continue];Pragma=[no-cache]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("PUT h.com:443 HTTP/3.0\r\n\r\nhello world"), "PUT|h.com:443|h.com,,,|HTTP/3.0 3.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T / HTTP/3.0\r\nTrailer: a, b\r\nX-Folded: a\r\n b\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("OPTIONS /a/b?c=d&e=f HTTP/1.1\r\n\r\n"), "OPTIONS|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD /? HTTP/1\r\nContent-Length: 3\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq(" x http/1.1\r\nbad header\r\nTransfer-Encoding: chunked, gzip\r\nTransfer-Encoding: chunked, gzip\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("POST /%zz http/1.1\r\nX-Sp : v\r\nContent-Length: 05\r\nX-Sp : v\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET / HTTP/1.1\r\nX-Dup: 2\r\n\r\n0\r\n\r\n"), "GET|/|,,/,|HTTP/1.1 1.1|host=|{X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T /a/b?c=d&e=f HTTP/1.0\r\nTransfer-Encoding: gzip\r\nExpect: 100-continue\r\nExpect: 100-continue\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT x HTTP/2.0\r\nX-Sp : v\r\nTransfer-Encoding: chunked\r\nExpect: 100-continue\r\nPragma: no-cache\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("PUT /a/b?c=d&e=f HTTP/2.0\r\nContent-Length:\r\nX-Empty:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid empty Content-Length \"\""
  assert_eq rreq("POST /%zz http/1.1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get http://h.com/p?q HTTP/1.10\r\nContent-Length: 05\r\nX-Empty:\r\nContent-Length: 3\r\nContent-Length: 05\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("GET /? HTTP/1.1\r\nExpect: 100-continue\r\nContent-Length: 5\r\nCache-Control: max-age=1\r\n"), "ERR unexpected EOF"
  assert_eq rreq("GET http://h.com/p?q HTTP/1.1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "GET|http://h.com/p?q|http,h.com,/p,q|HTTP/1.1 1.1|host=h.com|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT /? HTTP/3.0\r\nContent-Length: 05\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "CONNECT|/?|,,/,|HTTP/3.0 3.0|host=|{Content-Length=[05]}|cl=5|te=|close=false|tr={}|1\r\nab"
  assert_eq rreq("GET / HTTP/1.1 x\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("PUT /a/b?c=d&e=f HTTP/1.1\r\nConnection: close\r\n\r\nzz\r\n"), "PUT|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.1 1.1|host=|{Connection=[close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("G(T x http/1.1\r\nPragma: no-cache\r\nX-Folded: a\r\n b\r\nContent-Length:\r\nConnection: close\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("G(T /? HTTP/1.1\r\nContent-Length: 0\r\nX-Dup: 1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("OPTIONS x HTTP/2.0\r\nX-Dup: 1\r\nHost: x\r\nTransfer-Encoding: gzip\r\nCache-Control: max-age=1\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("G(T /%zz HTTP/3.0\r\nbad header\r\nTransfer-Encoding: gzip\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET x HTTP/1.1\r\nTrailer: X-T\r\nTrailer: Content-Length\r\nContent-Length:\r\n\r\n5\nhello\n0\n\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("CONNECT h.com:443 HTTP/1.2\r\nConnection: keep-alive\r\nExpect: 100-continue\r\n\r\nhello world"), "CONNECT|h.com:443|,h.com:443,,|HTTP/1.2 1.2|host=h.com:443|{Connection=[keep-alive];Expect=[100-continue]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD http://h.com/p?q HTTP/1.10\r\nTransfer-Encoding: Chunked\r\nContent-Length: -1\r\nContent-Length: 0\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("POST /%zz HTTP/2.0\r\nContent-Length: 0\r\nx-lower: v\r\n\r\n5\nhello\n0\n\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("\r\nTrailer: a, b\r\nX-Dup: 1\r\nbad header\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq("CONNECT /%zz HTTP/1.2\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("PUT x http/1.1\r\nPragma: no-cache\r\nContent-Length:\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("HEAD //x/y HTTP/1.10\r\nHost: y.com:80\r\nX-Folded: a\r\n b\r\nContent-Length:\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
}

test "vectors: read request 3" {
  assert_eq rreq(" /? HTTP/1.1\r\nTrailer: Content-Length\r\nTrailer: a, b\r\nConnection: Upgrade, Close\r\nContent-Length: -1\r\n"), "ERR invalid method \"\""
  assert_eq rreq("GET / HTTP/1.1 x\r\nTransfer-Encoding: chunked, gzip\r\nConnection: Upgrade, Close\r\nTrailer: a, b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("CONNECT /%zz HTTP/1.2\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("get /? HTTP/3.0\r\nContent-Length: 3\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "get|/?|,,/,|HTTP/3.0 3.0|host=|{Content-Length=[3]}|cl=3|te=|close=false|tr={}|A\r\n"
  assert_eq rreq("GET http://h.com/p?q HTTP/1\r\nContent-Length: 3\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PRI //x/y HTTP/1\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/1.2\r\nHost: y.com:80\r\n\r\nhello"), "GET|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.2 1.2|host=y.com:80|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT http://[::1]:8/ HTTP/3.0\r\nX-Folded: a\r\n b\r\nTransfer-Encoding: chunked, gzip\r\nTrailer: X-T\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("CONNECT http://h.com/p?q HTTP/1.1\r\nConnection: keep-alive\r\n"), "ERR unexpected EOF"
  assert_eq rreq("GET  / HTTP/1.1\r\nX-Empty:\r\nContent-Length: 5\r\nContent-Length: 05\r\nX-Folded: a\r\n b\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("GET /%zz HTTP/1\r\nTransfer-Encoding: Chunked\r\nX-Dup: 1\r\nTrailer: a, b\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("get / http/1.1\r\nContent-Length: 05\r\nContent-Length: 3\r\nX-Folded: a\r\n b\r\nContent-Length: 3\r\n\r\nhello world"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PUT h.com:443 HTTP/1.2\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "PUT|h.com:443|h.com,,,|HTTP/1.2 1.2|host=|{Connection=[Upgrade, Close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET\r\nbad header\r\nTransfer-Encoding: gzip\r\nContent-Length: -1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP request \"GET\""
  assert_eq rreq("OPTIONS /a/b?c=d&e=f http/1.1\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("CONNECT x HTTP/1.1\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\nhello\n0\n\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("G(T http://h.com/p?q HTTP/1.0\r\nContent-Length: 3\r\nContent-Length: 0\r\n\r\nhello"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD x http/1.1\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("G(T /? HTTP/1.1\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get / HTTP/1.0\r\nContent-Length: -1\r\nTransfer-Encoding: gzip\r\nContent-Length:\r\nContent-Length: 5\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"-1\" \"\" \"5\"]"
  assert_eq rreq("OPTIONS /a/b?c=d&e=f HTTP/1.10\r\nContent-Length: 0\r\nX-Folded: a\r\n b\r\nX-Sp : v\r\nContent-Length: 0\r\n\r\nhello world"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD h.com:443 HTTP/1.2\r\n\r\nhello world"), "HEAD|h.com:443|h.com,,,|HTTP/1.2 1.2|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get http://h.com/p?q HTTP/1.10\r\nConnection: Upgrade, Close\r\nHost: x\r\nTrailer: Content-Length\r\nX-Dup: 2\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("POST /? HTTP/1.1\r\nx-lower: v\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "POST|/?|,,/,|HTTP/1.1 1.1|host=|{X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PUT /a%20b HTTP/1.0\r\nConnection: Upgrade, Close\r\nHost: y.com:80\r\nHost: y.com:80\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR too many Host headers"
  assert_eq rreq("get x HTTP/2.0\r\n\r\n5\r\nhel"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("GET http://h.com/p?q HTTP/1.10\r\nConnection: close\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("get / HTTP/1.10\r\nx-lower: v\r\nConnection: Upgrade, Close\r\nTrailer: X-T\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("PRI x HTTP/2.0\r\nConnection: Upgrade, Close\r\nContent-Length:\r\nTrailer: a, b\r\nConnection: Upgrade, Close\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("PUT * http/1.1\r\nContent-Length: 0\r\nExpect: 100-continue\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("HEAD /? HTTP/1.1\r\nConnection: close\r\n\r\n5\r\nhel"), "HEAD|/?|,,/,|HTTP/1.1 1.1|host=|{Connection=[close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("HEAD /a%20b HTTP/1.1\r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "HEAD|/a%20b|,,/a b,|HTTP/1.1 1.1|host=|{Connection=[keep-alive];Content-Length=[5]}|cl=5|te=|close=false|tr={}|3;ext"
  assert_eq rreq("HEAD http://[::1]:8/ HTTP/1.10\r\nX-Empty:\r\nContent-Length: -1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD / HTTP/1.0\r\nTrailer: a, b\r\nTrailer: Content-Length\r\nTrailer: a, b\r\nTransfer-Encoding: chunked\r\n\r\nhello world"), "HEAD|/|,,/,|HTTP/1.0 1.0|host=|{Trailer=[a, b|Content-Length|a, b]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET h.com:443 HTTP/1.2\r\nHost: y.com:80\r\nx-lower: v\r\nTransfer-Encoding: chunked\r\n\r\n5\nhello\n0\n\n"), "ERR chunked line ends with bare LF"
  assert_eq rreq("HEAD x HTTP/1.10\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("get /a/b?c=d&e=f HTTP/1\r\nConnection: keep-alive\r\nTransfer-Encoding: chunked\r\nTrailer: Content-Length\r\nContent-Length: -1\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("POST /a%20b HTTP/1.2\r\nContent-Length: 3\r\nX-Dup: 2\r\nContent-Length: 5\r\n\r\nhello"), "ERR http: message cannot contain multiple Content-Length headers; got [\"3\" \"5\"]"
  assert_eq rreq(" /%zz HTTP/1.1\r\n\r\nhello"), "ERR invalid method \"\""
  assert_eq rreq("GET http://[::1]:8/ HTTP/1.1\r\nX-Empty:\r\nConnection: Upgrade, Close\r\nConnection: Upgrade, Close\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.1 1.1|host=[::1]:8|{Connection=[Upgrade, Close|Upgrade, Close];X-Empty=[]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("HEAD /%zz HTTP/1.2\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("POST http://[::1]:8/ HTTP/3.0\r\n\r\n5\nhello\n0\n\n"), "POST|http://[::1]:8/|http,[::1]:8,/,|HTTP/3.0 3.0|host=[::1]:8|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get * HTTP/2.0\r\nCache-Control: max-age=1\r\nTransfer-Encoding: chunked\r\nX-Empty:\r\nTransfer-Encoding: chunked, gzip\r\n\r\nhello"), "ERR too many transfer encodings: [\"chunked\" \"chunked, gzip\"]"
  assert_eq rreq("PRI http://h.com/p?q HTTP/1.10\r\n\r\nhello world"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq(" //x/y HTTP/1\r\nX-Folded: a\r\n b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("get /%zz HTTP/1.0\r\nPragma: no-cache\r\nExpect: 100-continue\r\n\r\n5\nhello\n0\n\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("PUT * HTTP/3.0\r\nTrailer: X-T\r\nConnection: keep-alive\r\nContent-Length: 0\r\n\r\nhello world"), "PUT|*|,,*,|HTTP/3.0 3.0|host=|{Connection=[keep-alive];Content-Length=[0];Trailer=[X-T]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST h.com:443 HTTP/1\r\nX-Folded: a\r\n b\r\nX-Dup: 1\r\nHost: x\r\nTransfer-Encoding: chunked, gzip\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T /? HTTP/1.0\r\n\r\nhello world"), "ERR invalid method \"G(T\""
  assert_eq rreq("get /a/b?c=d&e=f HTTP/1.1\r\nConnection: keep-alive\r\nConnection: close\r\nX-Empty:\r\nX-Empty:\r\n\r\nhello world"), "get|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.1 1.1|host=|{Connection=[keep-alive|close];X-Empty=[|]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("G(T x HTTP/1\r\nX-Folded: a\r\n b\r\nx-lower: v\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get * HTTP/1\r\nTransfer-Encoding: chunked\r\nHost: x\r\nContent-Length: -1\r\nX-Empty:\r\n\r\nhello world"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("GET\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 05\r\n"), "ERR malformed HTTP request \"GET\""
  assert_eq rreq("get h.com:443 HTTP/1.1\r\nX-Empty:\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "get|h.com:443|h.com,,,|HTTP/1.1 1.1|host=|{X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/3.0\r\nConnection: close\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: gzip\r\nHost: x\r\n\r\nhello world"), "ERR too many transfer encodings: [\"gzip\" \"gzip\"]"
  assert_eq rreq("OPTIONS /a/b?c=d&e=f HTTP/2.0\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "OPTIONS|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/2.0 2.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T / HTTP/1\r\nx-lower: v\r\nTransfer-Encoding: chunked, gzip\r\nX-Dup: 1\r\n\r\nhello"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD /? HTTP/2.0\r\nHost: y.com:80\r\nHost: x\r\nContent-Length: 0\r\n\r\nzz\r\n"), "ERR too many Host headers"
  assert_eq rreq("PUT x HTTP/3.0\r\nHost: y.com:80\r\nHost: x\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: Chunked\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("POST / HTTP/3.0\r\nX-Folded: a\r\n b\r\nX-Sp : v\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: gzip\r\n"), "ERR unexpected EOF"
  assert_eq rreq("POST x HTTP/1.1\r\nConnection: keep-alive\r\nx-lower: v\r\nCache-Control: max-age=1\r\n\r\nzz\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("PRI /a%20b HTTP/1.1\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "PRI|/a%20b|,,/a b,|HTTP/1.1 1.1|host=y.com:80|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST / HTTP/1.1\r\nTrailer: a, b\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "POST|/|,,/,|HTTP/1.1 1.1|host=|{Trailer=[a, b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST /? HTTP/1.2\r\nbad header\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("CONNECT //x/y HTTP/1.0\r\nCache-Control: max-age=1\r\nTrailer: X-T\r\n\r\n"), "CONNECT|//x/y|,,//x/y,|HTTP/1.0 1.0|host=|{Cache-Control=[max-age=1];Trailer=[X-T]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("OPTIONS //x/y HTTP/2.0\r\nTrailer: a, b\r\nCache-Control: max-age=1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "OPTIONS|//x/y|,,//x/y,|HTTP/2.0 2.0|host=|{Cache-Control=[max-age=1];Trailer=[a, b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get //x/y HTTP/1.0\r\nX-Dup: 2\r\nX-Sp : v\r\nContent-Length: -1\r\n"), "ERR unexpected EOF"
  assert_eq rreq("POST h.com:443 HTTP/1.10\r\nX-Dup: 2\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq(" http://h.com/p?q HTTP/1.10\r\nTrailer: a, b\r\nExpect: 100-continue\r\n\r\nzz\r\n"), "ERR invalid method \"\""
  assert_eq rreq("POST /a/b?c=d&e=f HTTP/1.1\r\nContent-Length: -1\r\nTrailer: a, b\r\nConnection: keep-alive\r\nContent-Length: 5\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"-1\" \"5\"]"
  assert_eq rreq("HEAD x HTTP/1.1\r\nTrailer: a, b\r\nTrailer: X-T\r\nTrailer: a, b\r\nX-Dup: 1\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq(" /a%20b HTTP/3.0\r\nTransfer-Encoding: Chunked\r\nContent-Length: -1\r\nTrailer: Content-Length\r\nContent-Length:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("POST http://[::1]:8/ HTTP/1.10\r\nX-Dup: 2\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD http://[::1]:8/ HTTP/1.1\r\nTrailer: a, b\r\n\r\nhello"), "HEAD|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.1 1.1|host=[::1]:8|{Trailer=[a, b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get x HTTP/1.1\r\nTransfer-Encoding: Chunked\r\nTrailer: X-T\r\n\r\nhello"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("GET x http/1.1\r\nContent-Length: 5\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("G(T /? HTTP/1.2\r\nExpect: 100-continue\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET /\r\nContent-Length: 3\r\nX-Dup: 1\r\nConnection: Upgrade, Close\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP request \"GET /\""
  assert_eq rreq("get x HTTP/1.2\r\nHost: x\r\nContent-Length: -1\r\nCache-Control: max-age=1\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("G(T /%zz HTTP/3.0\r\nPragma: no-cache\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD http://[::1]:8/ HTTP/1.0\r\nContent-Length:\r\nContent-Length: -1\r\nTrailer: a, b\r\nTrailer: X-T\r\n\r\nzz\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"\" \"-1\"]"
  assert_eq rreq("GET * HTTP/1\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PUT /? http/1.1\r\n\r\nhello"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("HEAD x HTTP/1.10\r\nContent-Length: -1\r\nCache-Control: max-age=1\r\nContent-Length:\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("GET /? HTTP/1.1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "GET|/?|,,/,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET /? HTTP/1.1\r\nCache-Control: max-age=1\r\nContent-Length: 05\r\nHost: x\r\nConnection: keep-alive\r\n\r\nhello world"), "GET|/?|,,/,|HTTP/1.1 1.1|host=x|{Cache-Control=[max-age=1];Connection=[keep-alive];Content-Length=[05]}|cl=5|te=|close=false|tr={}|hello"
  assert_eq rreq("GET / HTTP/1.1 x\r\nTrailer: X-T\r\nContent-Length: -1\r\nX-Dup: 2\r\nX-Empty:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("\r\n\r\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq(" /a/b?c=d&e=f HTTP/1.2\r\nConnection: keep-alive\r\nExpect: 100-continue\r\nbad header\r\n\r\nhello world"), "ERR invalid method \"\""
  assert_eq rreq("OPTIONS http://[::1]:8/ HTTP/1.10\r\nConnection: Upgrade, Close\r\nbad header\r\nConnection: close\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("OPTIONS / http/1.1\r\nX-Dup: 1\r\nX-Dup: 2\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PUT h.com:443 HTTP/1.1\r\nContent-Length: 3\r\nTrailer: a, b\r\nConnection: keep-alive\r\n\r\n0\r\n\r\n"), "PUT|h.com:443|h.com,,,|HTTP/1.1 1.1|host=|{Connection=[keep-alive];Content-Length=[3];Trailer=[a, b]}|cl=3|te=|close=false|tr={}|0\r\n"
  assert_eq rreq("CONNECT http://h.com/p?q HTTP/3.0\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "CONNECT|http://h.com/p?q|,http:,//h.com/p,q|HTTP/3.0 3.0|host=http:|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET x HTTP/1.2\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("POST / HTTP/2.0\r\nTrailer: Content-Length\r\nContent-Length: 0\r\nContent-Length: 05\r\nTrailer: Content-Length\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"0\" \"05\"]"
  assert_eq rreq(" h.com:443 HTTP/1\r\nConnection: Upgrade, Close\r\nx-lower: v\r\nX-Dup: 1\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("CONNECT /a%20b HTTP/1.10\r\nConnection: Upgrade, Close\r\n\r\nhello world"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD /a%20b HTTP/1\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PUT //x/y HTTP/1.2\r\nX-Folded: a\r\n b\r\nTrailer: X-T\r\nX-Sp : v\r\nX-Sp : v\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "PUT|//x/y|,,//x/y,|HTTP/1.2 1.2|host=|{Trailer=[X-T];X-Folded=[a b];X-Sp =[v|v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T /%zz HTTP/1\r\nX-Sp : v\r\nContent-Length:\r\nContent-Length: 0\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
}

test "vectors: read request 4" {
  assert_eq rreq("PRI /? HTTP/1\r\nTransfer-Encoding: gzip\r\nExpect: 100-continue\r\nContent-Length: -1\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T x HTTP/3.0\r\nbad header\r\nX-Dup: 1\r\nConnection: close\r\nX-Folded: a\r\n b\r\n\r\nhello"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET /a%20b http/1.1\r\nTrailer: Content-Length\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("CONNECT /%zz HTTP/1.1\r\nTransfer-Encoding: chunked\r\nConnection: Upgrade, Close\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 5\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("CONNECT /a/b?c=d&e=f HTTP/2.0\r\nTrailer: X-T\r\n\r\n5\nhello\n0\n\n"), "CONNECT|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/2.0 2.0|host=|{Trailer=[X-T]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T /a%20b HTTP/1.1\r\nX-Empty:\r\nPragma: no-cache\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("POST /a%20b HTTP/1\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T /a%20b http/1.1\r\nHost: x\r\nExpect: 100-continue\r\nConnection: keep-alive\r\nHost: x\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET  / HTTP/1.1\r\nContent-Length: 3\r\nx-lower: v\r\nX-Folded: a\r\n b\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("POST /%zz HTTP/1.2\r\nTrailer: a, b\r\nContent-Length: 05\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("CONNECT //x/y HTTP/1.1\r\nTrailer: a, b\r\nHost: x\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "CONNECT|//x/y|,,//x/y,|HTTP/1.1 1.1|host=x|{Trailer=[a, b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T /a/b?c=d&e=f HTTP/1.10\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("CONNECT //x/y HTTP/1.1\r\nTrailer: a, b\r\n\r\nzz\r\n"), "CONNECT|//x/y|,,//x/y,|HTTP/1.1 1.1|host=|{Trailer=[a, b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST h.com:443 HTTP/1.0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "POST|h.com:443|h.com,,,|HTTP/1.0 1.0|host=|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("POST / HTTP/1.1\r\nContent-Length:\r\nTransfer-Encoding: chunked\r\nTrailer: a, b\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR invalid empty Content-Length \"\""
  assert_eq rreq("PUT /%zz HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("GET / HTTP/1.1 x\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("G(T http://h.com/p?q HTTP/1\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PRI /a%20b http/1.1\r\nCache-Control: max-age=1\r\nConnection: Upgrade, Close\r\nContent-Length: 0\r\nContent-Length: 5\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET http://h.com/p?q HTTP/1.1\r\nHost: x\r\n"), "ERR unexpected EOF"
  assert_eq rreq("G(T /? HTTP/3.0\r\nTrailer: X-T\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked, gzip\r\n\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq(" /? HTTP/1.10\r\nContent-Length: -1\r\nX-Dup: 1\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("PUT /%zz HTTP/1\r\nTrailer: X-T\r\nCache-Control: max-age=1\r\nExpect: 100-continue\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("CONNECT h.com:443 http/1.1\r\nPragma: no-cache\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq(" /a%20b HTTP/3.0\r\nTrailer: Content-Length\r\nCache-Control: max-age=1\r\nX-Folded: a\r\n b\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("POST /? HTTP/3.0\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "POST|/?|,,/,|HTTP/3.0 3.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get * HTTP/1.2\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "get|*|,,*,|HTTP/1.2 1.2|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get /? http/1.1\r\nTransfer-Encoding: gzip\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("CONNECT / HTTP/1.10\r\nTrailer: Content-Length\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq(" * http/1.1\r\nTrailer: a, b\r\nConnection: keep-alive\r\n\r\nhello world"), "ERR invalid method \"\""
  assert_eq rreq("POST http://[::1]:8/ HTTP/3.0\r\nTransfer-Encoding: chunked, gzip\r\nConnection: Upgrade, Close\r\n\r\nhello world"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("OPTIONS /a%20b HTTP/3.0\r\n\r\nhello world"), "OPTIONS|/a%20b|,,/a b,|HTTP/3.0 3.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI //x/y HTTP/1\r\nTransfer-Encoding: chunked\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T * HTTP/1.1\r\nHost: y.com:80\r\nConnection: close\r\nConnection: keep-alive\r\nTrailer: X-T\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get * HTTP/2.0\r\nPragma: no-cache\r\nX-Empty:\r\n\r\n0\r\n\r\n"), "get|*|,,*,|HTTP/2.0 2.0|host=|{Cache-Control=[no-cache];Pragma=[no-cache];X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T h.com:443 HTTP/1.0\r\nTransfer-Encoding: chunked, gzip\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT /a/b?c=d&e=f HTTP/1.0\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "PUT|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.0 1.0|host=|{Trailer=[Content-Length]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("PRI //x/y HTTP/1.1\r\nTrailer: X-T\r\nTrailer: Content-Length\r\nX-Folded: a\r\n b\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "PRI|//x/y|,,//x/y,|HTTP/1.1 1.1|host=|{Trailer=[X-T|Content-Length];X-Folded=[a b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI http://h.com/p?q HTTP/1.10\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("GET http://[::1]:8/ HTTP/1.0\r\nTrailer: Content-Length\r\nX-Folded: a\r\n b\r\nTrailer: Content-Length\r\n\r\n0\r\n\r\n"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.0 1.0|host=[::1]:8|{Trailer=[Content-Length|Content-Length];X-Folded=[a b]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET http://[::1]:8/ HTTP/2.0\r\nX-Dup: 2\r\nTrailer: X-T\r\n\r\nzz\r\n"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/2.0 2.0|host=[::1]:8|{Trailer=[X-T];X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD //x/y HTTP/1.0\r\nbad header\r\nContent-Length:\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("get x HTTP/1.2\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/1\r\nContent-Length: -1\r\nTrailer: X-T\r\nHost: y.com:80\r\nTransfer-Encoding: gzip\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("GET http://[::1]:8/ HTTP/3.0\r\nX-Dup: 2\r\nHost: y.com:80\r\n\r\nhello"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/3.0 3.0|host=[::1]:8|{X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST h.com:443 HTTP/2.0\r\nTransfer-Encoding: gzip\r\nX-Dup: 1\r\n"), "ERR unexpected EOF"
  assert_eq rreq("get http://h.com/p?q HTTP/1.1\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "get|http://h.com/p?q|http,h.com,/p,q|HTTP/1.1 1.1|host=h.com|{}|cl=-1|te=chunked|close=false|tr={X-T=[tv]}|hello"
  assert_eq rreq("G(T http://[::1]:8/ HTTP/2.0\r\nExpect: 100-continue\r\nContent-Length:\r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("G(T http://[::1]:8/ HTTP/3.0\r\nTransfer-Encoding: chunked, gzip\r\nExpect: 100-continue\r\nCache-Control: max-age=1\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD /a/b?c=d&e=f HTTP/1\r\nExpect: 100-continue\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T / HTTP/1.10\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("OPTIONS /a%20b HTTP/2.0\r\nContent-Length: 05\r\nContent-Length: 3\r\nConnection: Upgrade, Close\r\nX-Folded: a\r\n b\r\n\r\nhello world"), "ERR http: message cannot contain multiple Content-Length headers; got [\"05\" \"3\"]"
  assert_eq rreq("HEAD * HTTP/2.0\r\nTrailer: Content-Length\r\nContent-Length: -1\r\nConnection: close\r\nContent-Length: 0\r\n\r\n0\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"-1\" \"0\"]"
  assert_eq rreq("get //x/y HTTP/1.0\r\nTrailer: Content-Length\r\nHost: y.com:80\r\n"), "ERR unexpected EOF"
  assert_eq rreq("get / HTTP/1.1\r\nContent-Length:\r\nX-Empty:\r\nContent-Length: 05\r\nHost: x\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"\" \"05\"]"
  assert_eq rreq("CONNECT /a%20b HTTP/3.0\r\nConnection: keep-alive\r\nx-lower: v\r\nTrailer: Content-Length\r\nTransfer-Encoding: gzip\r\n\r\n5\nhello\n0\n\n"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("HEAD /? HTTP/2.0\r\nX-Dup: 2\r\nPragma: no-cache\r\nTransfer-Encoding: Chunked\r\n\r\nhello world"), "ERR unexpected EOF"
  assert_eq rreq("OPTIONS http://h.com/p?q HTTP/1.10\r\nX-Dup: 1\r\nContent-Length: 3\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD / HTTP/1\r\nbad header\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("POST /? HTTP/1.2\r\nTransfer-Encoding: chunked\r\nX-Dup: 2\r\nContent-Length: -1\r\n\r\nhello"), "ERR bad Content-Length \"-1\""
  assert_eq rreq("CONNECT http://[::1]:8/ HTTP/1.1\r\nContent-Length: -1\r\n\r\n5\r\nhel"), "ERR bad Content-Length \"-1\""
  assert_eq rreq("CONNECT http://[::1]:8/ http/1.1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET * HTTP/1.1\r\nConnection: keep-alive\r\nX-Empty:\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "GET|*|,,*,|HTTP/1.1 1.1|host=|{Connection=[keep-alive];X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST h.com:443 HTTP/1\r\nContent-Length: 05\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PUT /? HTTP/1.0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "PUT|/?|,,/,|HTTP/1.0 1.0|host=|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("HEAD /a/b?c=d&e=f HTTP/1.10\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD http://h.com/p?q HTTP/1.1\r\nTransfer-Encoding: chunked, gzip\r\nX-Dup: 1\r\n\r\n5\r\nhel"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("G(T http://h.com/p?q HTTP/1.0\r\nX-Dup: 1\r\nX-Folded: a\r\n b\r\n\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq(" /a/b?c=d&e=f HTTP/1.2\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length:\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n"), "ERR invalid method \"\""
  assert_eq rreq("PRI * HTTP/1.0\r\nContent-Length: 5\r\nContent-Length: 3\r\n\r\n5\r\nhel"), "ERR http: message cannot contain multiple Content-Length headers; got [\"5\" \"3\"]"
  assert_eq rreq("G(T x HTTP/2.0\r\nX-Empty:\r\n\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PRI /%zz HTTP/2.0\r\nConnection: close\r\nTrailer: a, b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("HEAD http://[::1]:8/ HTTP/1.10\r\nTrailer: X-T\r\nX-Sp : v\r\nContent-Length: -1\r\nContent-Length: 3\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("POST /%zz HTTP/2.0\r\nContent-Length: 05\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/2.0\r\n\r\nhello"), "GET|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/2.0 2.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq(" /%zz HTTP/1.10\r\nTransfer-Encoding: chunked\r\nX-Dup: 2\r\n\r\nhello world"), "ERR invalid method \"\""
  assert_eq rreq("PUT http://[::1]:8/ http/1.1\r\nHost: y.com:80\r\nHost: y.com:80\r\nCache-Control: max-age=1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PUT * HTTP/3.0\r\n"), "ERR unexpected EOF"
  assert_eq rreq("get /a/b?c=d&e=f HTTP/3.0\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "get|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/3.0 3.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST / http/1.1\r\nContent-Length:\r\nHost: x\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET x HTTP/1.1\r\nTrailer: a, b\r\nConnection: keep-alive\r\nTransfer-Encoding: Chunked\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("get http://h.com/p?q HTTP/1.1\r\nCache-Control: max-age=1\r\nHost: x\r\nTransfer-Encoding: gzip\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("get / http/1.1\r\nContent-Length: 0\r\nContent-Length: 3\r\nX-Sp : v\r\nX-Sp : v\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("POST http://h.com/p?q HTTP/3.0\r\nContent-Length: 5\r\nCache-Control: max-age=1\r\n\r\n0\r\n\r\n"), "POST|http://h.com/p?q|http,h.com,/p,q|HTTP/3.0 3.0|host=h.com|{Cache-Control=[max-age=1];Content-Length=[5]}|cl=5|te=|close=false|tr={}|0\r\n\r\n"
  assert_eq rreq("CONNECT h.com:443 HTTP/1\r\nX-Folded: a\r\n b\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: Chunked\r\nConnection: close\r\n\r\nhello world"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("POST * HTTP/1.2\r\n\r\nhello"), "POST|*|,,*,|HTTP/1.2 1.2|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD / HTTP/1.2\r\nTransfer-Encoding: Chunked\r\nX-Empty:\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "HEAD|/|,,/,|HTTP/1.2 1.2|host=|{X-Empty=[]}|cl=-1|te=chunked|close=false|tr={}|hello"
  assert_eq rreq("HEAD http://[::1]:8/ HTTP/1.10\r\nContent-Length: 05\r\nHost: x\r\nX-Empty:\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("G(T * HTTP/1.1\r\nPragma: no-cache\r\nTransfer-Encoding: gzip\r\n\r\nhello world"), "ERR invalid method \"G(T\""
  assert_eq rreq("OPTIONS h.com:443 HTTP/2.0\r\nTransfer-Encoding: gzip\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR too many transfer encodings: [\"gzip\" \"chunked\"]"
  assert_eq rreq(" /%zz http/1.1\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhel"), "ERR invalid method \"\""
  assert_eq rreq("G(T /%zz HTTP/1.0\r\nContent-Length:\r\nHost: y.com:80\r\nX-Dup: 2\r\nx-lower: v\r\n\r\nzz\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT * http/1.1\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PUT /%zz HTTP/1.1\r\nTrailer: Content-Length\r\nX-Dup: 1\r\nx-lower: v\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("GET http://h.com/p?q HTTP/1.1\r\nContent-Length: 5\r\nContent-Length: 0\r\n\r\nhello"), "ERR http: message cannot contain multiple Content-Length headers; got [\"5\" \"0\"]"
  assert_eq rreq("HEAD /? HTTP/3.0\r\nTrailer: X-T\r\nContent-Length: 3\r\nHost: x\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "HEAD|/?|,,/,|HTTP/3.0 3.0|host=x|{Content-Length=[3];Trailer=[X-T]}|cl=3|te=|close=false|tr={}|5\r\n"
  assert_eq rreq("POST http://[::1]:8/ HTTP/1.10\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("G(T /? HTTP/1.10\r\nContent-Length: -1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD /a/b?c=d&e=f HTTP/1\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("POST h.com:443 HTTP/1.0\r\n\r\nhello"), "POST|h.com:443|h.com,,,|HTTP/1.0 1.0|host=|{}|cl=0|te=|close=true|tr={}|"
}

test "vectors: read request 5" {
  assert_eq rreq("GET /? HTTP/1\r\nContent-Length: 0\r\nX-Folded: a\r\n b\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PRI h.com:443 HTTP/1.1\r\nCache-Control: max-age=1\r\nConnection: close\r\nContent-Length: -1\r\nExpect: 100-continue\r\n\r\nhello"), "ERR bad Content-Length \"-1\""
  assert_eq rreq("OPTIONS /a%20b HTTP/1.1\r\n"), "ERR unexpected EOF"
  assert_eq rreq("POST / HTTP/1.10\r\nTrailer: a, b\r\nX-Empty:\r\nPragma: no-cache\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("CONNECT / HTTP/1.10\r\nConnection: close\r\nX-Sp : v\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("OPTIONS / HTTP/1.1\r\nConnection: close\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "OPTIONS|/|,,/,|HTTP/1.1 1.1|host=|{Connection=[close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("PRI h.com:443 HTTP/1.2\r\nX-Dup: 2\r\n\r\n5\nhello\n0\n\n"), "PRI|h.com:443|h.com,,,|HTTP/1.2 1.2|host=|{X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI h.com:443 HTTP/1\r\nContent-Length: -1\r\nX-Empty:\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("get x HTTP/1.0\r\nbad header\r\nX-Empty:\r\n\r\n0\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("GET  / HTTP/1.1\r\nbad header\r\nx-lower: v\r\nContent-Length: 05\r\nbad header\r\n\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("PRI * HTTP/1.0\r\nContent-Length: 05\r\nTrailer: a, b\r\nbad header\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("CONNECT /%zz HTTP/1.1\r\nX-Dup: 1\r\nConnection: Upgrade, Close\r\nTransfer-Encoding: gzip\r\n\r\nhello world"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("OPTIONS /%zz http/1.1\r\nX-Sp : v\r\nContent-Length: 05\r\nHost: x\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PRI /a/b?c=d&e=f HTTP/1.10\r\nX-Folded: a\r\n b\r\nX-Sp : v\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("\r\nPragma: no-cache\r\nTrailer: X-T\r\nX-Dup: 2\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq("PUT /%zz HTTP/1.1\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("PUT /a/b?c=d&e=f HTTP/1.1\r\nX-Sp : v\r\nTrailer: Content-Length\r\nTransfer-Encoding: chunked, gzip\r\nTransfer-Encoding: chunked\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR too many transfer encodings: [\"chunked, gzip\" \"chunked\"]"
  assert_eq rreq("GET /? HTTP/1.1\r\n"), "ERR unexpected EOF"
  assert_eq rreq("PRI /a/b?c=d&e=f HTTP/1.1\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "PRI|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.1 1.1|host=y.com:80|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD x HTTP/2.0\r\nX-Folded: a\r\n b\r\nContent-Length: 3\r\nContent-Length: -1\r\nTrailer: a, b\r\n\r\n5\r\nhel"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("PUT /? HTTP/1.1\r\nX-Empty:\r\n\r\nhello world"), "PUT|/?|,,/,|HTTP/1.1 1.1|host=|{X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("OPTIONS / HTTP/1\r\nContent-Length: -1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("get http://h.com/p?q HTTP/1.1\r\nX-Empty:\r\nTransfer-Encoding: gzip\r\nPragma: no-cache\r\n"), "ERR unexpected EOF"
  assert_eq rreq("PUT x HTTP/1\r\nContent-Length: 3\r\nbad header\r\nHost: y.com:80\r\nx-lower: v\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("CONNECT x http/1.1\r\nX-Empty:\r\nTrailer: Content-Length\r\nX-Sp : v\r\nCache-Control: max-age=1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PUT /a/b?c=d&e=f HTTP/3.0\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "PUT|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/3.0 3.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T * http/1.1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get /a%20b HTTP/1.1\r\nHost: x\r\nHost: x\r\nConnection: close\r\nContent-Length:\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR too many Host headers"
  assert_eq rreq("G(T /a/b?c=d&e=f HTTP/1.1\r\nContent-Length: 3\r\nX-Empty:\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq(" http://[::1]:8/ HTTP/1.2\r\nx-lower: v\r\n\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("G(T /%zz HTTP/1.1\r\nContent-Length: 0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("POST /? HTTP/1.1\r\nConnection: close\r\nX-Dup: 1\r\nContent-Length: 5\r\n\r\n0\r\n\r\n"), "POST|/?|,,/,|HTTP/1.1 1.1|host=|{Connection=[close];Content-Length=[5];X-Dup=[1]}|cl=5|te=|close=true|tr={}|0\r\n\r\n"
  assert_eq rreq("CONNECT x HTTP/1.1\r\nTrailer: X-T\r\nHost: y.com:80\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("G(T / HTTP/1.0\r\nTrailer: Content-Length\r\nTrailer: X-T\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET /? HTTP/1.0\r\nContent-Length: -1\r\nContent-Length: 05\r\nConnection: keep-alive\r\nHost: x\r\n"), "ERR unexpected EOF"
  assert_eq rreq("POST / HTTP/1.1\r\nContent-Length: 0\r\nContent-Length: 05\r\nContent-Length: 05\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"0\" \"05\" \"05\"]"
  assert_eq rreq("OPTIONS h.com:443 HTTP/1.2\r\nX-Empty:\r\nx-lower: v\r\n\r\nhello world"), "OPTIONS|h.com:443|h.com,,,|HTTP/1.2 1.2|host=|{X-Empty=[];X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET /? HTTP/2.0\r\nConnection: Upgrade, Close\r\nConnection: keep-alive\r\nX-Sp : v\r\nX-Empty:\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "GET|/?|,,/,|HTTP/2.0 2.0|host=|{Connection=[Upgrade, Close|keep-alive];X-Empty=[];X-Sp =[v]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("OPTIONS /a/b?c=d&e=f HTTP/2.0\r\nTrailer: a, b\r\nCache-Control: max-age=1\r\nContent-Length: 3\r\nX-Dup: 2\r\n\r\n5\r\nhel"), "OPTIONS|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/2.0 2.0|host=|{Cache-Control=[max-age=1];Content-Length=[3];Trailer=[a, b];X-Dup=[2]}|cl=3|te=|close=false|tr={}|5\r\n"
  assert_eq rreq("GET http://[::1]:8/ http/1.1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get x http/1.1\r\nHost: y.com:80\r\nbad header\r\nTrailer: a, b\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get //x/y http/1.1\r\nX-Dup: 2\r\nTransfer-Encoding: chunked\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("HEAD * HTTP/1.1\r\nx-lower: v\r\nTransfer-Encoding: chunked, gzip\r\n\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq(" /a%20b HTTP/1.0\r\n\r\nhello world"), "ERR invalid method \"\""
  assert_eq rreq("POST /a%20b HTTP/3.0\r\nX-Folded: a\r\n b\r\nX-Folded: a\r\n b\r\nConnection: keep-alive\r\n"), "ERR unexpected EOF"
  assert_eq rreq("GET /? HTTP/1.10\r\nTrailer: X-T\r\nx-lower: v\r\nTrailer: a, b\r\nTrailer: Content-Length\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("PUT http://h.com/p?q HTTP/3.0\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "PUT|http://h.com/p?q|http,h.com,/p,q|HTTP/3.0 3.0|host=h.com|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("OPTIONS /a%20b HTTP/1.0\r\nX-Empty:\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "OPTIONS|/a%20b|,,/a b,|HTTP/1.0 1.0|host=|{X-Empty=[]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET http://[::1]:8/ HTTP/1.0\r\nX-Folded: a\r\n b\r\nContent-Length: 5\r\nX-Dup: 2\r\nTrailer: a, b\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.0 1.0|host=[::1]:8|{Content-Length=[5];Trailer=[a, b];X-Dup=[2];X-Folded=[a b]}|cl=5|te=|close=true|tr={}|5\r\nhe"
  assert_eq rreq("G(T /%zz HTTP/1\r\nCache-Control: max-age=1\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 0\r\n\r\nhello"), "ERR invalid method \"G(T\""
  assert_eq rreq("get /a%20b HTTP/1.1\r\nConnection: keep-alive\r\nX-Dup: 1\r\nTransfer-Encoding: gzip\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("GET / HTTP/1.1 x\r\nTrailer: a, b\r\nX-Sp : v\r\nContent-Length: 5\r\nTransfer-Encoding: gzip\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("get /a%20b http/1.1\r\nPragma: no-cache\r\nHost: y.com:80\r\nTransfer-Encoding: chunked\r\nCache-Control: max-age=1\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq(" /%zz HTTP/1.10\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("\r\nX-Empty:\r\nX-Folded: a\r\n b\r\nConnection: close\r\nX-Dup: 2\r\n\r\nhello world"), "ERR malformed HTTP request \"\""
  assert_eq rreq("HEAD http://h.com/p?q HTTP/1.1\r\n\r\n0\r\n\r\n"), "HEAD|http://h.com/p?q|http,h.com,/p,q|HTTP/1.1 1.1|host=h.com|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("OPTIONS x HTTP/1.1\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("G(T /a%20b HTTP/1.2\r\nConnection: Upgrade, Close\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get //x/y HTTP/1.0\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: -1\r\n\r\n5\nhello\n0\n\n"), "ERR bad Content-Length \"-1\""
  assert_eq rreq("GET /? HTTP/1.1\r\nX-Sp : v\r\nCache-Control: max-age=1\r\nHost: y.com:80\r\nX-Dup: 1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "GET|/?|,,/,|HTTP/1.1 1.1|host=y.com:80|{Cache-Control=[max-age=1];X-Dup=[1];X-Sp =[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST /a%20b HTTP/3.0\r\nTrailer: Content-Length\r\nX-Dup: 2\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "POST|/a%20b|,,/a b,|HTTP/3.0 3.0|host=|{Trailer=[Content-Length];X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST h.com:443 HTTP/2.0\r\nX-Dup: 1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "POST|h.com:443|h.com,,,|HTTP/2.0 2.0|host=|{X-Dup=[1]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PUT http://[::1]:8/ HTTP/1\r\nHost: x\r\nTrailer: X-T\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq(" /? HTTP/2.0\r\nbad header\r\nContent-Length: 0\r\nContent-Length: 05\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("PRI / http/1.1\r\nConnection: Upgrade, Close\r\nX-Dup: 2\r\nHost: x\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("OPTIONS //x/y HTTP/1.0\r\nContent-Length: -1\r\nHost: y.com:80\r\nContent-Length:\r\nX-Empty:\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"-1\" \"\"]"
  assert_eq rreq(" / http/1.1\r\nTransfer-Encoding: Chunked\r\nbad header\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq(" /%zz HTTP/1.10\r\nbad header\r\nTrailer: X-T\r\nConnection: close\r\n\r\n5\r\nhel"), "ERR invalid method \"\""
  assert_eq rreq("CONNECT http://h.com/p?q HTTP/3.0\r\nTransfer-Encoding: Chunked\r\nX-Dup: 1\r\nContent-Length: 05\r\n"), "ERR unexpected EOF"
  assert_eq rreq("CONNECT / HTTP/1.10\r\nX-Empty:\r\nX-Empty:\r\nPragma: no-cache\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("CONNECT / HTTP/1.2\r\n\r\nhello"), "CONNECT|/|,,/,|HTTP/1.2 1.2|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T /a/b?c=d&e=f HTTP/1.10\r\nCache-Control: max-age=1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET http://[::1]:8/ HTTP/3.0\r\nContent-Length: 05\r\n\r\n5\nhello\n0\n\n"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/3.0 3.0|host=[::1]:8|{Content-Length=[05]}|cl=5|te=|close=false|tr={}|5\nhel"
  assert_eq rreq("OPTIONS /a/b?c=d&e=f HTTP/1\r\nTransfer-Encoding: Chunked\r\nConnection: close\r\nTransfer-Encoding: gzip\r\nPragma: no-cache\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("OPTIONS / HTTP/1\r\nContent-Length: 0\r\nContent-Length: 5\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("\r\nHost: x\r\nHost: y.com:80\r\n\r\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq("get h.com:443 http/1.1\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PRI /a/b?c=d&e=f HTTP/1.1\r\nbad header\r\nConnection: keep-alive\r\nHost: x\r\nContent-Length: 3\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("GET / HTTP/1.1 x\r\nCache-Control: max-age=1\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("get /%zz HTTP/1.10\r\nTrailer: X-T\r\nX-Dup: 1\r\nContent-Length: 3\r\nConnection: keep-alive\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("CONNECT /a%20b HTTP/1.10\r\nConnection: close\r\nConnection: close\r\nPragma: no-cache\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("CONNECT //x/y HTTP/1.0\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "CONNECT|//x/y|,,//x/y,|HTTP/1.0 1.0|host=|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("POST //x/y HTTP/1\r\nX-Dup: 1\r\nx-lower: v\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PRI * HTTP/1.2\r\nPragma: no-cache\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR too many transfer encodings: [\"chunked\" \"chunked, gzip\"]"
  assert_eq rreq(" /%zz HTTP/3.0\r\nConnection: close\r\nPragma: no-cache\r\nbad header\r\n\r\n5\r\nhel"), "ERR invalid method \"\""
  assert_eq rreq("PRI http://h.com/p?q HTTP/1.0\r\nHost: x\r\nX-Folded: a\r\n b\r\nPragma: no-cache\r\n\r\n0\r\n\r\n"), "PRI|http://h.com/p?q|http,h.com,/p,q|HTTP/1.0 1.0|host=h.com|{Cache-Control=[no-cache];Pragma=[no-cache];X-Folded=[a b]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("POST /? HTTP/1.2\r\nHost: x\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "POST|/?|,,/,|HTTP/1.2 1.2|host=x|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST h.com:443 HTTP/1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PUT h.com:443 HTTP/1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq(" http://h.com/p?q HTTP/2.0\r\nConnection: close\r\nContent-Length: -1\r\nTransfer-Encoding: gzip\r\nContent-Length: 05\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("PUT /? HTTP/1\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T /a%20b http/1.1\r\n\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("CONNECT /%zz HTTP/1.2\r\nTransfer-Encoding: Chunked\r\nPragma: no-cache\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("POST x HTTP/1.2\r\nConnection: keep-alive\r\nPragma: no-cache\r\nTrailer: X-T\r\n\r\nhello"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("PUT x HTTP/2.0\r\nTrailer: a, b\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("HEAD /a%20b HTTP/1.1\r\nX-Folded: a\r\n b\r\nContent-Length: -1\r\nConnection: Upgrade, Close\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR bad Content-Length \"-1\""
  assert_eq rreq("PUT h.com:443 HTTP/1.1\r\n\r\n5\r\nhel"), "PUT|h.com:443|h.com,,,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT /a/b?c=d&e=f HTTP/1.0\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: gzip\r\nConnection: keep-alive\r\nX-Sp : v\r\n"), "ERR unexpected EOF"
  assert_eq rreq("HEAD /a%20b HTTP/1.0\r\nHost: x\r\nX-Sp : v\r\nHost: y.com:80\r\nTransfer-Encoding: chunked\r\n"), "ERR unexpected EOF"
  assert_eq rreq("HEAD /%zz http/1.1\r\nx-lower: v\r\n\r\nhello world"), "ERR malformed HTTP version \"http/1.1\""
}

test "vectors: read request 6" {
  assert_eq rreq("PUT /a%20b HTTP/1.1\r\nConnection: Upgrade, Close\r\n\r\nhello"), "PUT|/a%20b|,,/a b,|HTTP/1.1 1.1|host=|{Connection=[Upgrade, Close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("POST /a%20b HTTP/1.0\r\nTrailer: a, b\r\n\r\n5\r\nhel"), "POST|/a%20b|,,/a b,|HTTP/1.0 1.0|host=|{Trailer=[a, b]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("CONNECT /? HTTP/1.1\r\nX-Dup: 1\r\nExpect: 100-continue\r\n\r\nzz\r\n"), "CONNECT|/?|,,/,|HTTP/1.1 1.1|host=|{Expect=[100-continue];X-Dup=[1]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD /? http/1.1\r\nContent-Length:\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("CONNECT /a/b?c=d&e=f HTTP/1.1\r\n\r\nhello world"), "CONNECT|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq(" /%zz HTTP/1.2\r\n\r\nhello world"), "ERR invalid method \"\""
  assert_eq rreq("PUT http://h.com/p?q HTTP/1.1\r\nContent-Length: 05\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "PUT|http://h.com/p?q|http,h.com,/p,q|HTTP/1.1 1.1|host=h.com|{Content-Length=[05]}|cl=5|te=|close=false|tr={}|A\r\n01"
  assert_eq rreq("POST /? HTTP/1.1\r\nX-Dup: 1\r\nX-Dup: 1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel"), "ERR unexpected EOF"
  assert_eq rreq("GET / HTTP/1.1 x\r\nbad header\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("get /a%20b http/1.1\r\nTransfer-Encoding: gzip\r\nContent-Length: 5\r\nContent-Length: 3\r\nTrailer: X-T\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get /? HTTP/1.2\r\nCache-Control: max-age=1\r\nX-Empty:\r\nContent-Length:\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR invalid empty Content-Length \"\""
  assert_eq rreq("CONNECT /? HTTP/1.1\r\nX-Sp : v\r\nContent-Length:\r\nTransfer-Encoding: Chunked\r\nContent-Length: 05\r\n\r\n0\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"\" \"05\"]"
  assert_eq rreq("GET /\r\nTransfer-Encoding: gzip\r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP request \"GET /\""
  assert_eq rreq("GET http://h.com/p?q HTTP/1.10\r\nTransfer-Encoding: gzip\r\nContent-Length: 5\r\nPragma: no-cache\r\nX-Sp : v\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("POST / HTTP/1.10\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("POST http://[::1]:8/ HTTP/1.2\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "POST|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.2 1.2|host=[::1]:8|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD * http/1.1\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("G(T http://[::1]:8/ HTTP/2.0\r\nContent-Length:\r\nTrailer: a, b\r\nX-Dup: 1\r\n\r\nhello"), "ERR invalid method \"G(T\""
  assert_eq rreq("PRI / HTTP/1.2\r\nContent-Length: 05\r\nTransfer-Encoding: chunked, gzip\r\nTrailer: a, b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("PUT * HTTP/1.10\r\nx-lower: v\r\nHost: y.com:80\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq(" //x/y HTTP/1\r\n\r\nzz\r\n"), "ERR invalid method \"\""
  assert_eq rreq("POST / HTTP/1.1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "POST|/|,,/,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PUT /a%20b HTTP/2.0\r\nContent-Length: 05\r\nTransfer-Encoding: chunked, gzip\r\nX-Dup: 2\r\nx-lower: v\r\n\r\n5\nhello\n0\n\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("GET / HTTP/1.1 x\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("get http://h.com/p?q HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\nhello"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("PRI //x/y HTTP/1\r\nContent-Length: 5\r\nX-Dup: 2\r\nTransfer-Encoding: gzip\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("CONNECT * HTTP/1.1\r\nX-Sp : v\r\nX-Empty:\r\nX-Sp : v\r\nConnection: close\r\n\r\nhello world"), "CONNECT|*|,*,,|HTTP/1.1 1.1|host=*|{Connection=[close];X-Empty=[];X-Sp =[v|v]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("get http://[::1]:8/ HTTP/3.0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "get|http://[::1]:8/|http,[::1]:8,/,|HTTP/3.0 3.0|host=[::1]:8|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PUT /a%20b http/1.1\r\nContent-Length: -1\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("CONNECT /? HTTP/1.1\r\n\r\nhello world"), "CONNECT|/?|,,/,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST http://[::1]:8/ HTTP/1.1\r\nContent-Length: 0\r\nTrailer: X-T\r\nContent-Length:\r\nX-Dup: 1\r\n\r\nzz\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"0\" \"\"]"
  assert_eq rreq("PRI /a/b?c=d&e=f HTTP/1\r\nbad header\r\nExpect: 100-continue\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("GET\r\nX-Sp : v\r\nTrailer: Content-Length\r\nX-Sp : v\r\n\r\nhello world"), "ERR malformed HTTP request \"GET\""
  assert_eq rreq("G(T http://h.com/p?q HTTP/2.0\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PRI x http/1.1\r\nContent-Length: 05\r\nConnection: Upgrade, Close\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get x HTTP/2.0\r\nTransfer-Encoding: chunked, gzip\r\nbad header\r\nContent-Length: -1\r\nContent-Length: 5\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq(" h.com:443 HTTP/1\r\nExpect: 100-continue\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("GET / HTTP/1.1 x\r\nConnection: keep-alive\r\nContent-Length: 3\r\nContent-Length: 05\r\nContent-Length: 3\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq(" * HTTP/1.1\r\nX-Dup: 2\r\n\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("GET * HTTP/1\r\nExpect: 100-continue\r\nCache-Control: max-age=1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("get h.com:443 HTTP/1.0\r\nX-Sp : v\r\nContent-Length: 5\r\nTrailer: Content-Length\r\nTrailer: X-T\r\n\r\nzz\r\n"), "ERR unexpected EOF"
  assert_eq rreq(" / http/1.1\r\n"), "ERR invalid method \"\""
  assert_eq rreq("HEAD /a%20b HTTP/1.10\r\nCache-Control: max-age=1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("OPTIONS x HTTP/1.10\r\nConnection: keep-alive\r\nPragma: no-cache\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("PRI /a%20b HTTP/1.1\r\nTrailer: X-T\r\nTransfer-Encoding: chunked\r\nContent-Length: 05\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "PRI|/a%20b|,,/a b,|HTTP/1.1 1.1|host=|{}|cl=-1|te=chunked|close=false|tr={X-T=[]}|0123456789"
  assert_eq rreq("POST / HTTP/1.0\r\nConnection: close\r\nCache-Control: max-age=1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "POST|/|,,/,|HTTP/1.0 1.0|host=|{Cache-Control=[max-age=1];Connection=[close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("HEAD h.com:443 HTTP/2.0\r\n\r\n"), "HEAD|h.com:443|h.com,,,|HTTP/2.0 2.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T x HTTP/1.1\r\nX-Dup: 2\r\nTrailer: Content-Length\r\nbad header\r\nTransfer-Encoding: chunked\r\n\r\nhello"), "ERR invalid method \"G(T\""
  assert_eq rreq("PRI /a%20b HTTP/1.2\r\nTrailer: a, b\r\nx-lower: v\r\nTransfer-Encoding: gzip\r\n\r\nhello"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("PUT / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip\r\n"), "ERR unexpected EOF"
  assert_eq rreq("get / HTTP/1.2\r\nTransfer-Encoding: chunked\r\nExpect: 100-continue\r\nTrailer: X-T\r\nPragma: no-cache\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed chunked encoding"
  assert_eq rreq("GET /a%20b HTTP/1.1\r\nContent-Length: -1\r\n\r\n"), "ERR bad Content-Length \"-1\""
  assert_eq rreq("GET http://h.com/p?q HTTP/3.0\r\n\r\n"), "GET|http://h.com/p?q|http,h.com,/p,q|HTTP/3.0 3.0|host=h.com|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PUT /a%20b HTTP/1.1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "PUT|/a%20b|,,/a b,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get / HTTP/1\r\nX-Dup: 2\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PRI h.com:443 HTTP/2.0\r\nContent-Length:\r\nTransfer-Encoding: Chunked\r\nExpect: 100-continue\r\nX-Empty:\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid empty Content-Length \"\""
  assert_eq rreq(" /a/b?c=d&e=f HTTP/1.1\r\nContent-Length: 05\r\nExpect: 100-continue\r\nX-Empty:\r\nX-Dup: 1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq(" /a/b?c=d&e=f HTTP/1.10\r\n\r\nhello world"), "ERR invalid method \"\""
  assert_eq rreq("OPTIONS x HTTP/1.10\r\nX-Sp : v\r\nX-Sp : v\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD /a%20b HTTP/3.0\r\nx-lower: v\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "HEAD|/a%20b|,,/a b,|HTTP/3.0 3.0|host=|{X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T /? HTTP/2.0\r\nX-Dup: 2\r\n\r\n5\r\nhel"), "ERR invalid method \"G(T\""
  assert_eq rreq("get / HTTP/1.10\r\nX-Dup: 2\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD http://h.com/p?q HTTP/1\r\nX-Dup: 1\r\nTrailer: Content-Length\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("GET /%zz HTTP/1.2\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("PUT /%zz HTTP/1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("OPTIONS /? HTTP/2.0\r\n\r\n"), "OPTIONS|/?|,,/,|HTTP/2.0 2.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get /%zz HTTP/2.0\r\nExpect: 100-continue\r\nTrailer: X-T\r\nContent-Length: 3\r\n\r\nhello"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("OPTIONS * HTTP/1.0\r\nTrailer: a, b\r\nTransfer-Encoding: chunked, gzip\r\n\r\nhello world"), "OPTIONS|*|,,*,|HTTP/1.0 1.0|host=|{Trailer=[a, b]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("PUT * HTTP/1\r\nContent-Length: 5\r\nx-lower: v\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("POST /%zz HTTP/3.0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("G(T / HTTP/1.1\r\nTrailer: a, b\r\nHost: x\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: Chunked\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PRI /%zz HTTP/1\r\nExpect: 100-continue\r\nX-Empty:\r\nX-Folded: a\r\n b\r\nContent-Length:\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("HEAD /%zz HTTP/2.0\r\nConnection: close\r\nTrailer: X-T\r\nTrailer: a, b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("GET  / HTTP/1.1\r\nTrailer: Content-Length\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 5\r\nX-Sp : v\r\n\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("get /a%20b HTTP/3.0\r\nX-Empty:\r\n\r\n5\nhello\n0\n\n"), "get|/a%20b|,,/a b,|HTTP/3.0 3.0|host=|{X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT /%zz HTTP/1.0\r\n\r\nhello"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("PUT * HTTP/1.1\r\nX-Folded: a\r\n b\r\nCache-Control: max-age=1\r\nX-Empty:\r\nTrailer: X-T\r\n\r\nhello"), "PUT|*|,,*,|HTTP/1.1 1.1|host=|{Cache-Control=[max-age=1];Trailer=[X-T];X-Empty=[];X-Folded=[a b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD /a/b?c=d&e=f HTTP/1.10\r\nHost: x\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("get * HTTP/3.0\r\nTransfer-Encoding: gzip\r\nX-Dup: 1\r\nTransfer-Encoding: chunked\r\nTrailer: X-T\r\n"), "ERR unexpected EOF"
  assert_eq rreq("GET / HTTP/1.1 x\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("get /? HTTP/1.2\r\nX-Dup: 2\r\nbad header\r\nHost: y.com:80\r\nx-lower: v\r\n\r\nzz\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("POST * HTTP/1.10\r\nContent-Length: -1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("get h.com:443 HTTP/1.2\r\nPragma: no-cache\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhel"), "get|h.com:443|h.com,,,|HTTP/1.2 1.2|host=|{Cache-Control=[no-cache];Connection=[Upgrade, Close];Pragma=[no-cache]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("PRI x HTTP/1.0\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("G(T /a/b?c=d&e=f HTTP/1.1\r\nX-Empty:\r\nContent-Length: 05\r\nx-lower: v\r\nbad header\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT http://[::1]:8/ HTTP/1.1\r\nPragma: no-cache\r\n\r\n5\r\nhel"), "PUT|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.1 1.1|host=[::1]:8|{Cache-Control=[no-cache];Pragma=[no-cache]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PUT /a%20b http/1.1\r\nTrailer: Content-Length\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq(" x HTTP/1.2\r\nHost: x\r\n\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("G(T * HTTP/2.0\r\nbad header\r\nContent-Length: 5\r\nConnection: keep-alive\r\nX-Dup: 1\r\n\r\nzz\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("POST //x/y HTTP/1.0\r\n\r\n5\r\nhel"), "POST|//x/y|,,//x/y,|HTTP/1.0 1.0|host=|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET / HTTP/1.1 x\r\nX-Dup: 2\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.1 x\""
  assert_eq rreq("OPTIONS http://[::1]:8/ HTTP/1.10\r\nContent-Length: 0\r\nX-Folded: a\r\n b\r\nTransfer-Encoding: gzip\r\nTrailer: X-T\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("get /a/b?c=d&e=f HTTP/1.10\r\nContent-Length: 0\r\nContent-Length: 3\r\nbad header\r\nHost: x\r\n\r\nhello world"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD x HTTP/1.1\r\nHost: x\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("HEAD / HTTP/1\r\nContent-Length: 3\r\nHost: y.com:80\r\nX-Sp : v\r\nContent-Length: 5\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("CONNECT /%zz HTTP/3.0\r\n\r\nhello"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("PUT /? HTTP/1.0\r\n\r\nhello world"), "PUT|/?|,,/,|HTTP/1.0 1.0|host=|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("OPTIONS /a/b?c=d&e=f HTTP/3.0\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked, gzip\r\nExpect: 100-continue\r\n"), "ERR unexpected EOF"
  assert_eq rreq("G(T / HTTP/1.1\r\nExpect: 100-continue\r\nContent-Length: 0\r\nX-Folded: a\r\n b\r\nContent-Length: 05\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq(" x HTTP/1.10\r\nCache-Control: max-age=1\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"\""
}

test "vectors: read request 7" {
  assert_eq rreq("HEAD h.com:443 HTTP/1.1\r\nbad header\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("PUT h.com:443 HTTP/2.0\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "PUT|h.com:443|h.com,,,|HTTP/2.0 2.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET /%zz HTTP/1.1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("OPTIONS /? HTTP/1.1\r\nContent-Length: 05\r\nTrailer: Content-Length\r\nTransfer-Encoding: chunked, gzip\r\n\r\nhello world"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("get http://[::1]:8/ HTTP/1.1\r\n\r\nzz\r\n"), "get|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.1 1.1|host=[::1]:8|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD /a/b?c=d&e=f HTTP/1.0\r\nX-Dup: 2\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "HEAD|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.0 1.0|host=|{X-Dup=[2]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("get * HTTP/1.10\r\nTransfer-Encoding: Chunked\r\nX-Sp : v\r\nContent-Length: -1\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("GET * HTTP/1.1\r\n\r\nhello world"), "GET|*|,,*,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET * HTTP/1.2\r\nTransfer-Encoding: chunked\r\n"), "ERR unexpected EOF"
  assert_eq rreq("CONNECT / HTTP/3.0\r\nx-lower: v\r\nbad header\r\n\r\n5\r\nhel"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("GET\r\nTransfer-Encoding: chunked, gzip\r\nTrailer: a, b\r\nTransfer-Encoding: gzip\r\nContent-Length: -1\r\n"), "ERR malformed HTTP request \"GET\""
  assert_eq rreq("GET /a%20b HTTP/1\r\nX-Dup: 2\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("CONNECT h.com:443 HTTP/3.0\r\nTrailer: a, b\r\nContent-Length: 5\r\nX-Dup: 1\r\n\r\n0\r\n\r\n"), "CONNECT|h.com:443|,h.com:443,,|HTTP/3.0 3.0|host=h.com:443|{Content-Length=[5];Trailer=[a, b];X-Dup=[1]}|cl=5|te=|close=false|tr={}|0\r\n\r\n"
  assert_eq rreq("G(T /? HTTP/3.0\r\nConnection: close\r\nHost: x\r\nContent-Length: -1\r\nTrailer: X-T\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT * HTTP/1\r\nX-Folded: a\r\n b\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PRI / HTTP/1.2\r\nContent-Length: 3\r\nContent-Length:\r\n\r\n0\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"3\" \"\"]"
  assert_eq rreq("GET x HTTP/1.2\r\n\r\nhello"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("CONNECT h.com:443 HTTP/1.1\r\nTrailer: a, b\r\nx-lower: v\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "CONNECT|h.com:443|,h.com:443,,|HTTP/1.1 1.1|host=h.com:443|{Trailer=[a, b];X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("OPTIONS http://h.com/p?q HTTP/1.10\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("OPTIONS / HTTP/1.1\r\nExpect: 100-continue\r\nConnection: Upgrade, Close\r\nX-Dup: 1\r\n"), "ERR unexpected EOF"
  assert_eq rreq("POST * http/1.1\r\nContent-Length: 0\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("G(T / HTTP/3.0\r\nX-Empty:\r\nx-lower: v\r\nContent-Length: 0\r\nConnection: Upgrade, Close\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq(" http://h.com/p?q HTTP/1.1\r\nHost: y.com:80\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"\""
  assert_eq rreq("CONNECT http://h.com/p?q HTTP/1.0\r\nPragma: no-cache\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "CONNECT|http://h.com/p?q|,http:,//h.com/p,q|HTTP/1.0 1.0|host=http:|{Cache-Control=[no-cache];Pragma=[no-cache]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("OPTIONS / HTTP/1.1\r\nTransfer-Encoding: Chunked\r\nx-lower: v\r\nHost: x\r\n\r\n5\r\nhel"), "ERR unexpected EOF"
  assert_eq rreq(" /? HTTP/1.0\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: -1\r\nContent-Length: -1\r\nCache-Control: max-age=1\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("CONNECT / HTTP/1.0\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: Chunked\r\nConnection: Upgrade, Close\r\nConnection: Upgrade, Close\r\n\r\nhello world"), "CONNECT|/|,,/,|HTTP/1.0 1.0|host=|{Connection=[Upgrade, Close|Upgrade, Close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("G(T http://[::1]:8/ HTTP/2.0\r\nHost: x\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("G(T /%zz http/1.1\r\nx-lower: v\r\nTransfer-Encoding: chunked\r\nContent-Length:\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("POST x http/1.1\r\nTransfer-Encoding: chunked\r\nX-Sp : v\r\nTrailer: a, b\r\nbad header\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get * HTTP/1.0\r\nX-Empty:\r\nTrailer: X-T\r\n\r\n"), "get|*|,,*,|HTTP/1.0 1.0|host=|{Trailer=[X-T];X-Empty=[]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET /\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP request \"GET /\""
  assert_eq rreq("OPTIONS / HTTP/3.0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "OPTIONS|/|,,/,|HTTP/3.0 3.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT /a%20b HTTP/3.0\r\nContent-Length: 5\r\nContent-Length: 05\r\nTransfer-Encoding: chunked\r\n\r\nhello world"), "ERR http: message cannot contain multiple Content-Length headers; got [\"5\" \"05\"]"
  assert_eq rreq(" //x/y HTTP/1.10\r\nHost: y.com:80\r\nX-Empty:\r\nHost: y.com:80\r\n\r\nhello world"), "ERR invalid method \"\""
  assert_eq rreq("CONNECT //x/y HTTP/1.0\r\nTrailer: a, b\r\nCache-Control: max-age=1\r\n\r\n0\r\n\r\n"), "CONNECT|//x/y|,,//x/y,|HTTP/1.0 1.0|host=|{Cache-Control=[max-age=1];Trailer=[a, b]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("G(T / HTTP/1.10\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("POST /a%20b HTTP/1\r\nContent-Length: -1\r\nHost: x\r\nx-lower: v\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("GET /? HTTP/2.0\r\n\r\nhello world"), "GET|/?|,,/,|HTTP/2.0 2.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET /? HTTP/1.0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "GET|/?|,,/,|HTTP/1.0 1.0|host=|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("PUT //x/y http/1.1\r\nContent-Length: 5\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET //x/y HTTP/2.0\r\nX-Folded: a\r\n b\r\nTransfer-Encoding: Chunked\r\nContent-Length:\r\nContent-Length: -1\r\n\r\n5\r\nhel"), "ERR http: message cannot contain multiple Content-Length headers; got [\"\" \"-1\"]"
  assert_eq rreq("POST //x/y HTTP/1.0\r\nCache-Control: max-age=1\r\nX-Folded: a\r\n b\r\nX-Sp : v\r\nX-Dup: 2\r\n\r\n0\r\n\r\n"), "POST|//x/y|,,//x/y,|HTTP/1.0 1.0|host=|{Cache-Control=[max-age=1];X-Dup=[2];X-Folded=[a b];X-Sp =[v]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET x HTTP/1.0\r\n\r\nhello world"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("PRI http://[::1]:8/ HTTP/3.0\r\nTrailer: X-T\r\n\r\n"), "PRI|http://[::1]:8/|http,[::1]:8,/,|HTTP/3.0 3.0|host=[::1]:8|{Trailer=[X-T]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI h.com:443 http/1.1\r\nContent-Length: -1\r\nContent-Length: 05\r\nContent-Length: 05\r\nContent-Length: 05\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PRI /a%20b HTTP/3.0\r\nContent-Length: 0\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "PRI|/a%20b|,,/a b,|HTTP/3.0 3.0|host=|{Content-Length=[0]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT / HTTP/1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PUT http://[::1]:8/ http/1.1\r\nConnection: close\r\nContent-Length: 3\r\nHost: x\r\nbad header\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET  / HTTP/1.1\r\nX-Empty:\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("POST x HTTP/1.2\r\nCache-Control: max-age=1\r\nHost: y.com:80\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("POST http://h.com/p?q HTTP/2.0\r\nX-Empty:\r\nConnection: keep-alive\r\nTransfer-Encoding: gzip\r\nContent-Length: 0\r\n\r\n5\nhello\n0\n\n"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("HEAD * HTTP/3.0\r\nConnection: keep-alive\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "HEAD|*|,,*,|HTTP/3.0 3.0|host=|{Connection=[keep-alive]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq(" / HTTP/1.1\r\nContent-Length:\r\nContent-Length: 0\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("POST http://h.com/p?q HTTP/1\r\nX-Dup: 2\r\nX-Empty:\r\nConnection: close\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/1\r\nExpect: 100-continue\r\nX-Dup: 2\r\nConnection: close\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PUT * HTTP/1.1\r\n\r\nzz\r\n"), "PUT|*|,,*,|HTTP/1.1 1.1|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI /a/b?c=d&e=f HTTP/1.1\r\nTransfer-Encoding: gzip\r\nContent-Length: 5\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("get /a%20b HTTP/1.2\r\nContent-Length: 05\r\nPragma: no-cache\r\n\r\n"), "ERR unexpected EOF"
  assert_eq rreq("GET http://[::1]:8/ HTTP/1.2\r\nTrailer: a, b\r\nX-Dup: 2\r\nHost: y.com:80\r\n\r\nzz\r\n"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.2 1.2|host=[::1]:8|{Trailer=[a, b];X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T /? HTTP/3.0\r\nExpect: 100-continue\r\nX-Empty:\r\nHost: y.com:80\r\nX-Folded: a\r\n b\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD http://h.com/p?q http/1.1\r\nX-Folded: a\r\n b\r\n\r\nhello"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("CONNECT x HTTP/1.1\r\nContent-Length: 3\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length:\r\nx-lower: v\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("OPTIONS / http/1.1\r\nPragma: no-cache\r\nbad header\r\nContent-Length: -1\r\nX-Sp : v\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("G(T /%zz HTTP/3.0\r\nContent-Length: 0\r\nContent-Length: -1\r\n\r\nhello world"), "ERR invalid method \"G(T\""
  assert_eq rreq("CONNECT / HTTP/1.10\r\nConnection: close\r\nTrailer: a, b\r\nX-Dup: 2\r\nCache-Control: max-age=1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq(" /a/b?c=d&e=f HTTP/3.0\r\nX-Sp : v\r\nX-Dup: 1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("G(T /%zz HTTP/1\r\nX-Folded: a\r\n b\r\nExpect: 100-continue\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("\r\nConnection: Upgrade, Close\r\nExpect: 100-continue\r\nContent-Length: 05\r\n\r\nzz\r\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq("G(T /? HTTP/3.0\r\nConnection: keep-alive\r\nContent-Length: 05\r\nContent-Length: 05\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("HEAD x http/1.1\r\nCache-Control: max-age=1\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("OPTIONS /a/b?c=d&e=f HTTP/3.0\r\nX-Dup: 1\r\nContent-Length: 05\r\nExpect: 100-continue\r\n\r\nhello world"), "OPTIONS|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/3.0 3.0|host=|{Content-Length=[05];Expect=[100-continue];X-Dup=[1]}|cl=5|te=|close=false|tr={}|hello"
  assert_eq rreq("POST /a%20b HTTP/1.1\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "POST|/a%20b|,,/a b,|HTTP/1.1 1.1|host=|{Connection=[Upgrade, Close]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET http://[::1]:8/ HTTP/2.0\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/2.0 2.0|host=[::1]:8|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T x http/1.1\r\nConnection: Upgrade, Close\r\nbad header\r\n\r\n5\r\nhel"), "ERR invalid method \"G(T\""
  assert_eq rreq("get / HTTP/1.2\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "get|/|,,/,|HTTP/1.2 1.2|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI h.com:443 HTTP/2.0\r\nbad header\r\nX-Empty:\r\nConnection: close\r\nX-Empty:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("GET\r\nCache-Control: max-age=1\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP request \"GET\""
  assert_eq rreq("PUT h.com:443 HTTP/1.0\r\nContent-Length: 0\r\nX-Empty:\r\n\r\n5\r\nhel"), "PUT|h.com:443|h.com,,,|HTTP/1.0 1.0|host=|{Content-Length=[0];X-Empty=[]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("G(T h.com:443 HTTP/2.0\r\nTrailer: a, b\r\nHost: y.com:80\r\nConnection: Upgrade, Close\r\n\r\nzz\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get http://h.com/p?q HTTP/2.0\r\nCache-Control: max-age=1\r\nContent-Length: 5\r\n"), "ERR unexpected EOF"
  assert_eq rreq("PUT http://[::1]:8/ HTTP/1.1\r\nConnection: Upgrade, Close\r\nX-Dup: 2\r\nContent-Length:\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid empty Content-Length \"\""
  assert_eq rreq("HEAD /a/b?c=d&e=f http/1.1\r\nPragma: no-cache\r\nTransfer-Encoding: Chunked\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PUT /? HTTP/2.0\r\nContent-Length: 0\r\nContent-Length:\r\nbad header\r\nbad header\r\n\r\n5\r\nhel"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("POST http://h.com/p?q HTTP/1.1\r\n\r\n"), "POST|http://h.com/p?q|http,h.com,/p,q|HTTP/1.1 1.1|host=h.com|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST /a/b?c=d&e=f http/1.1\r\nX-Empty:\r\nx-lower: v\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("POST /? HTTP/1.1\r\nConnection: Upgrade, Close\r\nX-Folded: a\r\n b\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n"), "ERR invalid byte in chunk length"
  assert_eq rreq("OPTIONS /a/b?c=d&e=f http/1.1\r\nPragma: no-cache\r\nX-Dup: 2\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get / HTTP/3.0\r\n\r\nhello"), "get|/|,,/,|HTTP/3.0 3.0|host=|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get * HTTP/3.0\r\nTrailer: X-T\r\nX-Empty:\r\n\r\n0\r\n\r\n"), "get|*|,,*,|HTTP/3.0 3.0|host=|{Trailer=[X-T];X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq(" /a%20b HTTP/1.1\r\nx-lower: v\r\nX-Folded: a\r\n b\r\nTrailer: a, b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("G(T x HTTP/1.1\r\nConnection: close\r\n\r\nzz\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT http://h.com/p?q HTTP/1.2\r\nCache-Control: max-age=1\r\n\r\nzz\r\n"), "PUT|http://h.com/p?q|http,h.com,/p,q|HTTP/1.2 1.2|host=h.com|{Cache-Control=[max-age=1]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("CONNECT http://h.com/p?q HTTP/1.2\r\nExpect: 100-continue\r\nX-Folded: a\r\n b\r\nCache-Control: max-age=1\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "CONNECT|http://h.com/p?q|,http:,//h.com/p,q|HTTP/1.2 1.2|host=http:|{Cache-Control=[max-age=1];Expect=[100-continue];X-Folded=[a b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD h.com:443 HTTP/1.2\r\nTransfer-Encoding: chunked\r\nX-Empty:\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "HEAD|h.com:443|h.com,,,|HTTP/1.2 1.2|host=|{X-Empty=[]}|cl=-1|te=chunked|close=false|tr={}|abcde"
  assert_eq rreq("PUT * HTTP/1\r\nPragma: no-cache\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("get http://[::1]:8/ HTTP/1.10\r\nPragma: no-cache\r\nConnection: Upgrade, Close\r\nPragma: no-cache\r\nX-Dup: 2\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("OPTIONS h.com:443 http/1.1\r\nX-Sp : v\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("POST / HTTP/1.0\r\nConnection: keep-alive\r\nContent-Length: 05\r\nContent-Length: 3\r\nConnection: keep-alive\r\n\r\n0\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"05\" \"3\"]"
  assert_eq rreq("HEAD /? HTTP/3.0\r\nTrailer: Content-Length\r\nTransfer-Encoding: chunked, gzip\r\nExpect: 100-continue\r\nContent-Length: -1\r\n\r\nzz\r\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
}

test "vectors: read request 8" {
  assert_eq rreq("POST / HTTP/1.10\r\nContent-Length: 5\r\nX-Dup: 2\r\nContent-Length: 0\r\nTransfer-Encoding: Chunked\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("CONNECT //x/y HTTP/2.0\r\nx-lower: v\r\n\r\n5\r\nhel"), "CONNECT|//x/y|,,//x/y,|HTTP/2.0 2.0|host=|{X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq(" http://h.com/p?q http/1.1\r\n\r\nzz\r\n"), "ERR invalid method \"\""
  assert_eq rreq("GET  / HTTP/1.1\r\nExpect: 100-continue\r\nTrailer: Content-Length\r\nContent-Length: -1\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"/ HTTP/1.1\""
  assert_eq rreq("POST http://[::1]:8/ http/1.1\r\nPragma: no-cache\r\nTrailer: a, b\r\nContent-Length: -1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("OPTIONS //x/y http/1.1\r\nExpect: 100-continue\r\nTrailer: a, b\r\nTransfer-Encoding: chunked, gzip\r\nTrailer: X-T\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PUT /a/b?c=d&e=f HTTP/1.0\r\nHost: y.com:80\r\nX-Sp : v\r\n\r\n5\nhello\n0\n\n"), "PUT|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.0 1.0|host=y.com:80|{X-Sp =[v]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("get / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nx-lower: v\r\nTrailer: a, b\r\nX-Dup: 2\r\n"), "ERR unexpected EOF"
  assert_eq rreq("HEAD /a/b?c=d&e=f http/1.1\r\nX-Sp : v\r\nPragma: no-cache\r\n\r\nhello world"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq(" http://[::1]:8/ HTTP/1.10\r\nContent-Length: 05\r\n\r\n5\r\nhel"), "ERR invalid method \"\""
  assert_eq rreq("G(T http://[::1]:8/ HTTP/1.2\r\nHost: y.com:80\r\nbad header\r\nContent-Length: 5\r\nX-Empty:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PRI //x/y HTTP/1.10\r\nContent-Length: -1\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("G(T /? HTTP/1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq(" http://[::1]:8/ HTTP/1.0\r\nContent-Length: 5\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("GET /a%20b HTTP/1.1\r\nbad header\r\nTransfer-Encoding: Chunked\r\nContent-Length: -1\r\nContent-Length: 5\r\n\r\n5\nhello\n0\n\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("\r\nbad header\r\nTrailer: X-T\r\nContent-Length: 3\r\nExpect: 100-continue\r\n\r\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq("PRI * HTTP/1.0\r\nPragma: no-cache\r\nX-Dup: 1\r\nConnection: Upgrade, Close\r\n"), "ERR unexpected EOF"
  assert_eq rreq("get h.com:443 HTTP/1.2\r\nConnection: Upgrade, Close\r\nX-Dup: 2\r\nContent-Length: 0\r\nx-lower: v\r\n"), "ERR unexpected EOF"
  assert_eq rreq("PUT http://[::1]:8/ HTTP/2.0\r\nTransfer-Encoding: chunked\r\n\r\nhello"), "ERR unexpected EOF"
  assert_eq rreq("CONNECT h.com:443 HTTP/1.0\r\n\r\nzz\r\n"), "CONNECT|h.com:443|,h.com:443,,|HTTP/1.0 1.0|host=h.com:443|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("get x HTTP/3.0\r\n\r\nhello world"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("CONNECT / HTTP/3.0\r\nTransfer-Encoding: chunked\r\nTrailer: a, b\r\nCache-Control: max-age=1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "CONNECT|/|,,/,|HTTP/3.0 3.0|host=|{Cache-Control=[max-age=1]}|cl=-1|te=chunked|close=false|tr={A=[];B=[]}|0123456789"
  assert_eq rreq("PUT /? http/1.1\r\nHost: y.com:80\r\nX-Dup: 1\r\nTrailer: a, b\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("PRI /? HTTP/1.10\r\nCache-Control: max-age=1\r\nTransfer-Encoding: Chunked\r\nHost: x\r\nConnection: keep-alive\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("get / http/1.1\r\nTransfer-Encoding: chunked\r\nTrailer: X-T\r\n\r\nzz\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get http://[::1]:8/ HTTP/1\r\nTrailer: a, b\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("CONNECT /%zz HTTP/2.0\r\nContent-Length: 5\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("GET * HTTP/1.10\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("CONNECT //x/y HTTP/1.0\r\nExpect: 100-continue\r\nTrailer: a, b\r\nContent-Length: 0\r\nCache-Control: max-age=1\r\n\r\n0\r\n\r\n"), "CONNECT|//x/y|,,//x/y,|HTTP/1.0 1.0|host=|{Cache-Control=[max-age=1];Content-Length=[0];Expect=[100-continue];Trailer=[a, b]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("GET\r\n\r\nzz\r\n"), "ERR malformed HTTP request \"GET\""
  assert_eq rreq("GET x http/1.1\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: chunked, gzip\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("get /? HTTP/1.2\r\nTransfer-Encoding: chunked, gzip\r\nx-lower: v\r\nHost: x\r\nConnection: keep-alive\r\n\r\n5\nhello\n0\n\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("get * HTTP/1.1\r\nContent-Length: 3\r\nX-Sp : v\r\n\r\n5\nhello\n0\n\n"), "get|*|,,*,|HTTP/1.1 1.1|host=|{Content-Length=[3];X-Sp =[v]}|cl=3|te=|close=false|tr={}|5\nh"
  assert_eq rreq("OPTIONS /a/b?c=d&e=f HTTP/3.0\r\nTrailer: a, b\r\nHost: y.com:80\r\nExpect: 100-continue\r\n\r\nzz\r\n"), "OPTIONS|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/3.0 3.0|host=y.com:80|{Expect=[100-continue];Trailer=[a, b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET http://[::1]:8/ HTTP/2.0\r\nContent-Length: 5\r\nx-lower: v\r\nX-Empty:\r\nConnection: keep-alive\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/2.0 2.0|host=[::1]:8|{Connection=[keep-alive];Content-Length=[5];X-Empty=[];X-Lower=[v]}|cl=5|te=|close=false|tr={}|5\r\nhe"
  assert_eq rreq("OPTIONS x HTTP/1\r\nTransfer-Encoding: gzip\r\nContent-Length:\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("PRI /a%20b HTTP/1.10\r\nConnection: close\r\nPragma: no-cache\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("CONNECT http://h.com/p?q HTTP/1.10\r\nHost: y.com:80\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("PRI / HTTP/1.2\r\nContent-Length: 05\r\nX-Folded: a\r\n b\r\nTrailer: Content-Length\r\nContent-Length:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"05\" \"\"]"
  assert_eq rreq("PRI / HTTP/1.2\r\nX-Sp : v\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "PRI|/|,,/,|HTTP/1.2 1.2|host=|{X-Sp =[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET /a/b?c=d&e=f HTTP/1.1\r\nContent-Length:\r\nHost: y.com:80\r\nContent-Length:\r\n"), "ERR unexpected EOF"
  assert_eq rreq("PRI x HTTP/1.2\r\nHost: x\r\nContent-Length: 05\r\nx-lower: v\r\n\r\nzz\r\n"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("POST * HTTP/1.10\r\nContent-Length: 3\r\nConnection: close\r\nTrailer: Content-Length\r\nx-lower: v\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("PRI http://[::1]:8/ HTTP/1.2\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 3\r\nTrailer: X-T\r\nbad header\r\n\r\n5\r\nhel"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("HEAD //x/y HTTP/2.0\r\n"), "ERR unexpected EOF"
  assert_eq rreq("PRI / HTTP/1\r\nContent-Length: 3\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("CONNECT h.com:443 HTTP/1\r\nx-lower: v\r\nPragma: no-cache\r\nx-lower: v\r\n\r\nhello world"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T x HTTP/2.0\r\nExpect: 100-continue\r\nConnection: keep-alive\r\nHost: x\r\n\r\nzz\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PRI x http/1.1\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("HEAD //x/y HTTP/1\r\nConnection: close\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("OPTIONS /%zz http/1.1\r\n\r\nhello"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET http://h.com/p?q HTTP/1.1\r\nCache-Control: max-age=1\r\n\r\n5\nhello\n0\n\n"), "GET|http://h.com/p?q|http,h.com,/p,q|HTTP/1.1 1.1|host=h.com|{Cache-Control=[max-age=1]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("G(T h.com:443 HTTP/1.1\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PUT h.com:443 HTTP/1\r\nTrailer: Content-Length\r\nContent-Length: 0\r\nTransfer-Encoding: Chunked\r\n\r\nhello world"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("get //x/y http/1.1\r\nConnection: close\r\n\r\nhello"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("OPTIONS //x/y HTTP/1\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\nhello"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("HEAD /a/b?c=d&e=f HTTP/3.0\r\nX-Folded: a\r\n b\r\nContent-Length: 0\r\nCache-Control: max-age=1\r\n\r\n5\r\nhel"), "HEAD|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/3.0 3.0|host=|{Cache-Control=[max-age=1];Content-Length=[0];X-Folded=[a b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get /? HTTP/2.0\r\n"), "ERR unexpected EOF"
  assert_eq rreq("GET /\r\nContent-Length: 3\r\nConnection: close\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP request \"GET /\""
  assert_eq rreq("GET //x/y HTTP/2.0\r\nTransfer-Encoding: chunked\r\nTrailer: X-T\r\n"), "ERR unexpected EOF"
  assert_eq rreq("CONNECT //x/y HTTP/1.1\r\nPragma: no-cache\r\nTrailer: Content-Length\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "CONNECT|//x/y|,,//x/y,|HTTP/1.1 1.1|host=|{Cache-Control=[no-cache];Pragma=[no-cache];Trailer=[Content-Length]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("OPTIONS /? HTTP/1.0\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "OPTIONS|/?|,,/,|HTTP/1.0 1.0|host=|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("HEAD * http/1.1\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq(" x HTTP/2.0\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("GET / HTTP/1.1\r\nCache-Control: max-age=1\r\nContent-Length: 3\r\n\r\n5\nhello\n0\n\n"), "GET|/|,,/,|HTTP/1.1 1.1|host=|{Cache-Control=[max-age=1];Content-Length=[3]}|cl=3|te=|close=false|tr={}|5\nh"
  assert_eq rreq("POST / HTTP/1.0\r\nConnection: keep-alive\r\n\r\n0\r\n\r\n"), "POST|/|,,/,|HTTP/1.0 1.0|host=|{Connection=[keep-alive]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("GET /\r\nTrailer: Content-Length\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP request \"GET /\""
  assert_eq rreq("PRI h.com:443 HTTP/1.0\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "PRI|h.com:443|h.com,,,|HTTP/1.0 1.0|host=|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("PRI h.com:443 HTTP/1.10\r\nTransfer-Encoding: gzip\r\nTrailer: X-T\r\nCache-Control: max-age=1\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("G(T //x/y http/1.1\r\nTrailer: X-T\r\nContent-Length: 3\r\n\r\nzz\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("G(T http://[::1]:8/ HTTP/1\r\nHost: x\r\nConnection: close\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("GET http://[::1]:8/ HTTP/2.0\r\nContent-Length: 0\r\n\r\nhello"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/2.0 2.0|host=[::1]:8|{Content-Length=[0]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("POST / HTTP/3.0\r\nX-Empty:\r\nTransfer-Encoding: gzip\r\nContent-Length: 0\r\nHost: x\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("PRI /%zz HTTP/1.10\r\nTransfer-Encoding: chunked, gzip\r\nExpect: 100-continue\r\nTrailer: X-T\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("HEAD * HTTP/1.0\r\nTrailer: a, b\r\nX-Sp : v\r\nHost: y.com:80\r\nConnection: keep-alive\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "HEAD|*|,,*,|HTTP/1.0 1.0|host=y.com:80|{Connection=[keep-alive];Trailer=[a, b];X-Sp =[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("get x HTTP/1\r\nConnection: keep-alive\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("G(T / HTTP/1.1\r\nConnection: keep-alive\r\nContent-Length:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("get /%zz HTTP/1.1\r\nContent-Length: 05\r\nPragma: no-cache\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("G(T /%zz HTTP/1.10\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("G(T * http/1.1\r\nHost: x\r\nHost: x\r\nConnection: close\r\n\r\n0\r\n\r\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("\r\nX-Dup: 2\r\nConnection: Upgrade, Close\r\nx-lower: v\r\nHost: x\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR malformed HTTP request \"\""
  assert_eq rreq("CONNECT / HTTP/3.0\r\nHost: y.com:80\r\nConnection: keep-alive\r\nX-Empty:\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "CONNECT|/|,,/,|HTTP/3.0 3.0|host=y.com:80|{Connection=[keep-alive];X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PUT http://h.com/p?q HTTP/1\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("GET /a%20b HTTP/1\r\nx-lower: v\r\n\r\n5\nhello\n0\n\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("POST http://h.com/p?q HTTP/1.1\r\nContent-Length: 5\r\nContent-Length: 5\r\nContent-Length: 3\r\n\r\n5\r\nhel"), "ERR http: message cannot contain multiple Content-Length headers; got [\"5\" \"5\" \"3\"]"
  assert_eq rreq("POST * http/1.1\r\nConnection: Upgrade, Close\r\nX-Dup: 1\r\n\r\nhello world"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq("GET http://[::1]:8/ HTTP/1.2\r\n\r\n0\r\n\r\n"), "GET|http://[::1]:8/|http,[::1]:8,/,|HTTP/1.2 1.2|host=[::1]:8|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI * HTTP/1.2\r\nX-Empty:\r\nTransfer-Encoding: gzip\r\n\r\nhello world"), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rreq("OPTIONS //x/y HTTP/1.0\r\nContent-Length:\r\nExpect: 100-continue\r\nContent-Length: 05\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"\" \"05\"]"
  assert_eq rreq("GET * HTTP/1.2\r\nConnection: close\r\nHost: y.com:80\r\nTrailer: a, b\r\nTransfer-Encoding: chunked, gzip\r\n\r\n0\r\n\r\n"), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rreq("PUT /%zz HTTP/1.0\r\nX-Dup: 1\r\nTransfer-Encoding: chunked, gzip\r\nConnection: Upgrade, Close\r\nContent-Length: 3\r\n"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("G(T http://[::1]:8/ HTTP/1.0\r\nCache-Control: max-age=1\r\n\r\n5\r\nhel"), "ERR invalid method \"G(T\""
  assert_eq rreq("OPTIONS /a/b?c=d&e=f HTTP/1.0\r\nTrailer: a, b\r\nx-lower: v\r\nHost: y.com:80\r\n\r\n"), "OPTIONS|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/1.0 1.0|host=y.com:80|{Trailer=[a, b];X-Lower=[v]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("CONNECT /a%20b HTTP/3.0\r\nbad header\r\nConnection: close\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("HEAD / HTTP/1.1\r\nContent-Length: 05\r\n\r\nzz\r\n"), "ERR unexpected EOF"
  assert_eq rreq("get /a/b?c=d&e=f HTTP/2.0\r\nConnection: close\r\nTrailer: a, b\r\n\r\n0\r\n\r\n"), "get|/a/b?c=d&e=f|,,/a/b,c=d&e=f|HTTP/2.0 2.0|host=|{Connection=[close];Trailer=[a, b]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq("get h.com:443 HTTP/1\r\nTransfer-Encoding: chunked, gzip\r\nConnection: close\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("POST * HTTP/1.1\r\nbad header\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("PRI /? HTTP/1.1\r\nX-Empty:\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "PRI|/?|,,/,|HTTP/1.1 1.1|host=|{X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("HEAD h.com:443 HTTP/1.1\r\nTrailer: X-T\r\nTrailer: Content-Length\r\n\r\n5\r\nhel"), "HEAD|h.com:443|h.com,,,|HTTP/1.1 1.1|host=|{Trailer=[X-T|Content-Length]}|cl=0|te=|close=false|tr={}|"
}

test "vectors: read request 9" {
  assert_eq rreq("G(T http://[::1]:8/ HTTP/3.0\r\n\r\n5\nhello\n0\n\n"), "ERR invalid method \"G(T\""
  assert_eq rreq("PRI * HTTP/1.10\r\nCache-Control: max-age=1\r\nConnection: close\r\nCache-Control: max-age=1\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("GET /\r\nX-Dup: 1\r\nTransfer-Encoding: gzip\r\n\r\n0\r\n\r\n"), "ERR malformed HTTP request \"GET /\""
  assert_eq rreq(" http://h.com/p?q HTTP/2.0\r\nConnection: keep-alive\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("get /? HTTP/1\r\nContent-Length: 3\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1\""
  assert_eq rreq("get /%zz HTTP/1.0\r\nTransfer-Encoding: gzip\r\n\r\nhello world"), "ERR parse \"/%zz\": invalid URL escape \"%zz\""
  assert_eq rreq("PUT http://h.com/p?q HTTP/1.10\r\nContent-Length: 3\r\n\r\n"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq("PRI h.com:443 HTTP/1.0\r\nConnection: keep-alive\r\nX-Folded: a\r\n b\r\nTrailer: a, b\r\nHost: x\r\n\r\n1\r\nab\r\n0\r\n\r\n"), "PRI|h.com:443|h.com,,,|HTTP/1.0 1.0|host=x|{Connection=[keep-alive];Trailer=[a, b];X-Folded=[a b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rreq("PRI http://[::1]:8/ HTTP/1.1\r\nHost: y.com:80\r\nTransfer-Encoding: chunked\r\nbad header\r\nX-Sp : v\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rreq("HEAD /a/b?c=d&e=f HTTP/1.10\r\nExpect: 100-continue\r\nConnection: Upgrade, Close\r\nExpect: 100-continue\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel"), "ERR malformed HTTP version \"HTTP/1.10\""
  assert_eq rreq(" h.com:443 HTTP/3.0\r\nTransfer-Encoding: gzip\r\n"), "ERR invalid method \"\""
  assert_eq rreq("PUT http://h.com/p?q HTTP/1.2\r\nX-Dup: 2\r\nContent-Length: 5\r\nContent-Length: 0\r\nContent-Length:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR http: message cannot contain multiple Content-Length headers; got [\"5\" \"0\" \"\"]"
  assert_eq rreq("PRI x HTTP/1.2\r\nConnection: keep-alive\r\nHost: y.com:80\r\n\r\nhello"), "ERR parse \"x\": invalid URI for request"
  assert_eq rreq("HEAD * HTTP/1.1\r\nPragma: no-cache\r\nTrailer: X-T\r\nContent-Length: -1\r\nX-Folded: a\r\n b\r\n"), "ERR unexpected EOF"
  assert_eq rreq("POST http://[::1]:8/ http/1.1\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked, gzip\r\nX-Dup: 2\r\nX-Dup: 2\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"), "ERR malformed HTTP version \"http/1.1\""
  assert_eq rreq(" /? http/1.1\r\nContent-Length: 5\r\nTrailer: Content-Length\r\nTrailer: X-T\r\nCache-Control: max-age=1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("PUT http://h.com/p?q HTTP/1.1\r\nConnection: Upgrade, Close\r\nConnection: Upgrade, Close\r\nTrailer: X-T\r\n\r\nhello"), "PUT|http://h.com/p?q|http,h.com,/p,q|HTTP/1.1 1.1|host=h.com|{Connection=[Upgrade, Close|Upgrade, Close];Trailer=[X-T]}|cl=0|te=|close=true|tr={}|"
  assert_eq rreq(" /a/b?c=d&e=f HTTP/1.0\r\nx-lower: v\r\n\r\n0\r\n\r\n"), "ERR invalid method \"\""
  assert_eq rreq("POST //x/y HTTP/3.0\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: gzip\r\nPragma: no-cache\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"), "ERR too many transfer encodings: [\"chunked\" \"gzip\"]"
}

test "vectors: read response 0" {
  assert_eq rresp("HTTP/1.0 200 OK\r\nConnection: close\r\n\r\nBody here\n", false), "200|200 OK|HTTP/1.0 1.0|{Connection=[close]}|cl=-1|te=|close=true|tr={}|Body here\n"
  assert_eq rresp("HTTP/1.1 200 OK\r\n\r\nBody here\n", false), "200|200 OK|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|Body here\n"
  assert_eq rresp("HTTP/1.1 204 No Content\r\n\r\nBody should not be read!\n", false), "204|204 No Content|HTTP/1.1 1.1|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 200 OK\r\nContent-Length: 10\r\nConnection: close\r\n\r\nBody here\n", false), "200|200 OK|HTTP/1.0 1.0|{Connection=[close];Content-Length=[10]}|cl=10|te=|close=true|tr={}|Body here\n"
  assert_eq rresp("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0a\r\nBody here\n\r\n09\r\ncontinued\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.1 1.1|{}|cl=-1|te=chunked|close=false|tr={}|Body here\ncontinued"
  assert_eq rresp("HTTP/1.0 200 OK\r\nTrailer: Content-MD5, Content-Sources\r\nContent-Length: 10\r\nConnection: close\r\n\r\nBody here\n", false), "200|200 OK|HTTP/1.0 1.0|{Connection=[close];Content-Length=[10];Trailer=[Content-MD5, Content-Sources]}|cl=10|te=|close=true|tr={}|Body here\n"
  assert_eq rresp("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 10\r\n\r\n0a\r\nBody here\n\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.1 1.1|{}|cl=-1|te=chunked|close=false|tr={}|Body here\n"
  assert_eq rresp("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n", true), "200|200 OK|HTTP/1.1 1.1|{}|cl=-1|te=chunked|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 200 OK\r\nContent-Length: 256\r\n\r\n", true), "200|200 OK|HTTP/1.0 1.0|{Content-Length=[256]}|cl=256|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 200 OK\r\nContent-Length: 256\r\n\r\n", true), "200|200 OK|HTTP/1.1 1.1|{Content-Length=[256]}|cl=256|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 200 OK\r\n\r\n", true), "200|200 OK|HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n", false), "200|200 OK|HTTP/1.1 1.1|{Content-Length=[0]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 303 \r\n\r\n", false), "303|303 |HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.0 303\r\n\r\n", false), "303|303|HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 206 Partial Content\nConnection: close\nContent-Type: multipart/byteranges; boundary=18a75608c8f47cef\n\nsome body", false), "206|206 Partial Content|HTTP/1.1 1.1|{Content-Type=[multipart/byteranges; boundary=18a75608c8f47cef]}|cl=-1|te=|close=true|tr={}|some body"
  assert_eq rresp("HTTP/1.1 206 Partial Content\r\nContent-Type: text/plain; charset=utf-8\r\nAccept-Ranges: bytes\r\nContent-Range: bytes 0-5/1862\r\nContent-Length: 6\r\n\r\nfoobar", false), "206|206 Partial Content|HTTP/1.1 1.1|{Accept-Ranges=[bytes];Content-Length=[6];Content-Range=[bytes 0-5/1862];Content-Type=[text/plain; charset=utf-8]}|cl=6|te=|close=false|tr={}|foobar"
  assert_eq rresp("HTTP/1.1 200 OK\r\nContent-Length: 256\r\nConnection: keep-alive, close\r\n\r\n", true), "200|200 OK|HTTP/1.1 1.1|{Content-Length=[256]}|cl=256|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 200 OK\r\nContent-Length: 256\r\nConnection: keep-alive\r\nConnection: close\r\n\r\n", true), "200|200 OK|HTTP/1.1 1.1|{Content-Length=[256]}|cl=256|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.0 200 OK\r\nTransfer-Encoding: bogus\r\n\r\nBody here\n", false), "200|200 OK|HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|Body here\n"
  assert_eq rresp("HTTP/1.0 200 OK\r\nTransfer-Encoding: bogus\r\nContent-Length: 10\r\n\r\nBody here\n", false), "200|200 OK|HTTP/1.0 1.0|{Content-Length=[10]}|cl=10|te=|close=true|tr={}|Body here\n"
  assert_eq rresp("HTTP/1.0  401 Unauthorized\r\nContent-type: text/html\r\nWWW-Authenticate: Basic realm=\"\"\r\n\r\nYour Authentication failed.\r\n", false), "401|401 Unauthorized|HTTP/1.0 1.0|{Content-Type=[text/html];Www-Authenticate=[Basic realm=\"\"]}|cl=-1|te=|close=true|tr={}|Your Authentication failed.\r\n"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nConnection: close\r\nConnection: close\r\nx-lower: v\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "204|204 No Content|HTTP/1.1 1.1|{X-Lower=[v]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.0 200 OK\r\nbad header\r\nPragma: no-cache\r\nTransfer-Encoding: Chunked\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("FOO  200 OK\r\nTransfer-Encoding: chunked, gzip\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nContent-Length: 05\r\nCache-Control: max-age=1\r\nContent-Length: 0\r\nContent-Length: 5\r\n\r\n5\r\nhel", true), "ERR http: message cannot contain multiple Content-Length headers; got [\"05\" \"0\" \"5\"]"
  assert_eq rresp("HTTP/2.0 abc OK\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/2.0 abc OK\r\nX-Dup: 2\r\n\r\nhello world", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("FOO 200\r\nx-lower: v\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0  200 OK\r\nbad header\r\nContent-Length: 05\r\nConnection: Upgrade, Close\r\n\r\nzz\r\n", true), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("FOO 500 Internal Server Error\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 -12 x\r\nContent-Length: 05\r\nConnection: Upgrade, Close\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2 101 Switching\r\nContent-Length:\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.2 204 No Content\r\n\r\nzz\r\n", false), "204|204 No Content|HTTP/1.2 1.2|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nCache-Control: max-age=1\r\nTrailer: X-T\r\n\r\n5\r\nhel", false), "204|204 No Content|HTTP/1.1 1.1|{Cache-Control=[max-age=1];Trailer=[X-T]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 -12 x\r\n\r\nzz\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/2.0 500 Internal Server Error\r\nTrailer: a, b\r\nConnection: Upgrade, Close\r\nPragma: no-cache\r\n\r\n", true), "500|500 Internal Server Error|HTTP/2.0 2.0|{Cache-Control=[no-cache];Pragma=[no-cache];Trailer=[a, b]}|cl=-1|te=|close=true|tr={}|"
  assert_eq rresp("FOO  200 OK\r\nX-Folded: a\r\n b\r\nContent-Length: 3\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 404\r\nX-Dup: 1\r\n\r\nhello world", false), "404|404|HTTP/1.1 1.1|{X-Dup=[1]}|cl=-1|te=|close=true|tr={}|hello world"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n1\r\nab\r\n0\r\n\r\n", true), "204|204 No Content|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/2.0 304 Not Modified\r\n\r\n5\nhello\n0\n\n", false), "304|304 Not Modified|HTTP/2.0 2.0|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nExpect: 100-continue\r\nTrailer: a, b\r\nContent-Length: 05\r\n\r\n0\r\n\r\n", false), "304|304 Not Modified|HTTP/1.1 1.1|{Content-Length=[05];Expect=[100-continue];Trailer=[a, b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1  200 OK\r\nContent-Length:\r\nContent-Length: 3\r\nConnection: close\r\nTransfer-Encoding: chunked, gzip\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.x 302 Found\r\n\r\nhello", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nContent-Length:\r\n\r\n0\r\n\r\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nX-Sp : v\r\nHost: x\r\nContent-Length: -1\r\n\r\n5\nhello\n0\n\n", false), "ERR bad Content-Length \"-1\""
  assert_eq rresp("FOO 302 Found\r\nX-Empty:\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("FOO  200 OK\r\nExpect: 100-continue\r\nContent-Length: 05\r\nX-Dup: 1\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 404\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "404|404|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"
  assert_eq rresp("HTTP/1.2 200 OK\r\nTrailer: Content-Length\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.2 1.2|{Trailer=[Content-Length]}|cl=-1|te=|close=true|tr={}|1\r\nab\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nContent-Length: -1\r\nX-Empty:\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", true), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nTransfer-Encoding: chunked\r\nContent-Length: 0\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/2.0 200\r\nConnection: Upgrade, Close\r\nCache-Control: max-age=1\r\nTransfer-Encoding: Chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "200|200|HTTP/2.0 2.0|{Cache-Control=[max-age=1]}|cl=-1|te=chunked|close=true|tr={}|hello"
  assert_eq rresp("FOO 404\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 abc OK\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.2 abc OK\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("FOO  200 OK\r\nX-Folded: a\r\n b\r\n\r\nhello", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.0 302 Found\r\nContent-Length:\r\nx-lower: v\r\nHost: y.com:80\r\n\r\n5\r\nhel", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("FOO 200 OK\r\nTrailer: X-T\r\nContent-Length: 0\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 302 Found\r\nContent-Length: -1\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("FOO 200\r\nHost: x\r\nX-Dup: 1\r\nbad header\r\nConnection: close\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 101 Switching\r\nTransfer-Encoding: Chunked\r\nX-Dup: 1\r\n\r\nhello world", true), "101|101 Switching|HTTP/1.2 1.2|{X-Dup=[1]}|cl=-1|te=chunked|close=false|tr={}|"
  assert_eq rresp("HTTP/1.2 2000 OK\r\n\r\nzz\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1  200 OK\r\nContent-Length:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.0 302 Found\r\nContent-Length: -1\r\nTrailer: X-T\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR bad Content-Length \"-1\""
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nTrailer: Content-Length\r\nConnection: keep-alive\r\nHost: y.com:80\r\nx-lower: v\r\n\r\nhello world", true), "304|304 Not Modified|HTTP/1.1 1.1|{Connection=[keep-alive];Host=[y.com:80];Trailer=[Content-Length];X-Lower=[v]}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 abc OK\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 3\r\nX-Sp : v\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.x 302 Found\r\nbad header\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1  200 OK\r\nCache-Control: max-age=1\r\n\r\nzz\r\n", false), "200|200 OK|HTTP/1.1 1.1|{Cache-Control=[max-age=1]}|cl=-1|te=|close=true|tr={}|zz\r\n"
  assert_eq rresp("HTTP/1.1 -12 x\r\nX-Folded: a\r\n b\r\n\r\nhello world", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 abc OK\r\nX-Sp : v\r\nConnection: keep-alive\r\nX-Folded: a\r\n b\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.1 302 Found\r\nTransfer-Encoding: Chunked\r\nHost: x\r\nX-Dup: 1\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n", false), "ERR too many transfer encodings: [\"Chunked\" \"chunked\"]"
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\nX-Folded: a\r\n b\r\nConnection: keep-alive\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 204 No Content\r\nContent-Length:\r\nExpect: 100-continue\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.0 -12 x\r\nTrailer: a, b\r\nConnection: Upgrade, Close\r\nHost: x\r\nTransfer-Encoding: chunked, gzip\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/2.0  200 OK\r\nContent-Length: 0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "200|200 OK|HTTP/2.0 2.0|{Content-Length=[0]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nX-Sp : v\r\nContent-Length: 3\r\nCache-Control: max-age=1\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO 2000 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\nExpect: 100-continue\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 200 OK\r\nX-Folded: a\r\n b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.1 1.1|{X-Folded=[a b]}|cl=-1|te=|close=true|tr={}|A\r\n0123456789\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 101 Switching\r\nTransfer-Encoding: gzip\r\nConnection: Upgrade, Close\r\nX-Empty:\r\nContent-Length: 0\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.x 404\r\nTransfer-Encoding: chunked, gzip\r\nExpect: 100-continue\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nHost: x\r\nContent-Length: 5\r\n\r\nzz\r\n", false), "101|101 Switching|HTTP/1.1 1.1|{Content-Length=[5];Host=[x]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("FOO 200\r\n\r\nhello world", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 204 No Content\r\nConnection: keep-alive\r\nTrailer: Content-Length\r\nX-Sp : v\r\nbad header\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 204 No Content\r\nHost: x\r\nTransfer-Encoding: gzip\r\nContent-Length: 3\r\nx-lower: v\r\n\r\n5\nhello\n0\n\n", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.0 2000 OK\r\nTrailer: Content-Length\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.x 404\r\nTransfer-Encoding: Chunked\r\nTrailer: a, b\r\n\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 204 No Content\r\nX-Empty:\r\nTransfer-Encoding: gzip\r\n\r\n0\r\n\r\n", true), "204|204 No Content|HTTP/1.0 1.0|{X-Empty=[]}|cl=-1|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\n\r\n5\r\nhel", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 304 Not Modified\r\nHost: y.com:80\r\n\r\nhello", false), "304|304 Not Modified|HTTP/1.0 1.0|{Host=[y.com:80]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 101 Switching\r\nHost: x\r\nTrailer: a, b\r\nCache-Control: max-age=1\r\n\r\nhello", false), "101|101 Switching|HTTP/1.1 1.1|{Cache-Control=[max-age=1];Host=[x];Trailer=[a, b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nConnection: close\r\nContent-Length:\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.2 500 Internal Server Error\r\nContent-Length:\r\nTransfer-Encoding: gzip\r\n\r\n", true), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.x -12 x\r\nTransfer-Encoding: gzip\r\nTrailer: X-T\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1  200 OK\r\n\r\nzz\r\n", false), "200|200 OK|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|zz\r\n"
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nX-Dup: 2\r\n\r\n5\r\nhel", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{X-Dup=[2]}|cl=-1|te=|close=true|tr={}|5\r\nhel"
  assert_eq rresp("HTTP/1.0 -12 x\r\nX-Sp : v\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2 304 Not Modified\r\nConnection: keep-alive\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "304|304 Not Modified|HTTP/1.2 1.2|{Connection=[keep-alive]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 200 OK\r\nContent-Length: -1\r\nContent-Length: 5\r\nCache-Control: max-age=1\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"-1\" \"5\"]"
  assert_eq rresp("HTTP/1.x abc OK\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: gzip\r\nContent-Length: 5\r\nTrailer: X-T\r\n\r\nhello", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.0 204 No Content\r\nContent-Length: 5\r\nTransfer-Encoding: chunked, gzip\r\nExpect: 100-continue\r\nConnection: keep-alive\r\n\r\n0\r\n\r\n", false), "204|204 No Content|HTTP/1.0 1.0|{Connection=[keep-alive];Content-Length=[5];Expect=[100-continue]}|cl=0|te=|close=false|tr={}|"
}

test "vectors: read response 1" {
  assert_eq rresp("HTTP/1.1 200\r\nExpect: 100-continue\r\n\r\nhello", false), "200|200|HTTP/1.1 1.1|{Expect=[100-continue]}|cl=-1|te=|close=true|tr={}|hello"
  assert_eq rresp("HTTP/1.x 101 Switching\r\nTrailer: Content-Length\r\nContent-Length:\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nTransfer-Encoding: gzip\r\n\r\nhello", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.2 abc OK\r\nContent-Length:\r\nContent-Length: 5\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.0 200\r\nContent-Length: 05\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "200|200|HTTP/1.0 1.0|{Content-Length=[05]}|cl=5|te=|close=true|tr={}|A\r\n01"
  assert_eq rresp("HTTP/1.2 101 Switching\r\nX-Folded: a\r\n b\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\nContent-Length: 05\r\n\r\n5\nhello\n0\n\n", false), "101|101 Switching|HTTP/1.2 1.2|{Connection=[keep-alive];Content-Length=[05];X-Folded=[a b]}|cl=0|te=chunked|close=false|tr={}|"
  assert_eq rresp("HTTP/2.0 204 No Content\r\nExpect: 100-continue\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "204|204 No Content|HTTP/2.0 2.0|{Expect=[100-continue]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0  200 OK\r\nConnection: Upgrade, Close\r\n\r\nzz\r\n", false), "200|200 OK|HTTP/1.0 1.0|{Connection=[Upgrade, Close]}|cl=-1|te=|close=true|tr={}|zz\r\n"
  assert_eq rresp("HTTP/1.2 302 Found\r\nTransfer-Encoding: Chunked\r\nHost: x\r\nX-Dup: 1\r\nCache-Control: max-age=1\r\n\r\nhello world", false), "ERR unexpected EOF"
  assert_eq rresp("FOO 302 Found\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("FOO 302 Found\r\nConnection: Upgrade, Close\r\nExpect: 100-continue\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.0 abc OK\r\nTransfer-Encoding: chunked, gzip\r\nTrailer: Content-Length\r\nHost: x\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.2 abc OK\r\nContent-Length: 3\r\nContent-Length:\r\nX-Dup: 2\r\nContent-Length: 05\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("FOO 101 Switching\r\nConnection: Upgrade, Close\r\nTrailer: X-T\r\nTrailer: a, b\r\n\r\n", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 500 Internal Server Error\r\nx-lower: v\r\nX-Dup: 1\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "500|500 Internal Server Error|HTTP/1.2 1.2|{X-Dup=[1];X-Lower=[v]}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\nPragma: no-cache\r\nContent-Length:\r\nX-Empty:\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 204 No Content\r\nX-Dup: 2\r\nContent-Length: 5\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "204|204 No Content|HTTP/1.0 1.0|{Content-Length=[5];X-Dup=[2]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1  200 OK\r\nContent-Length: 0\r\nContent-Length: -1\r\nX-Sp : v\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"0\" \"-1\"]"
  assert_eq rresp("FOO 304 Not Modified\r\n\r\n5\nhello\n0\n\n", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 -12 x\r\nConnection: Upgrade, Close\r\nX-Dup: 2\r\nContent-Length: 3\r\nX-Empty:\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2  200 OK\r\nTransfer-Encoding: Chunked\r\nX-Dup: 1\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/2.0 abc OK\r\nX-Empty:\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/2.0 304 Not Modified\r\nContent-Length:\r\nCache-Control: max-age=1\r\nX-Dup: 1\r\n\r\n5\r\nhel", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.0 304 Not Modified\r\nTransfer-Encoding: gzip\r\n\r\nhello world", false), "304|304 Not Modified|HTTP/1.0 1.0|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nX-Empty:\r\nx-lower: v\r\nTrailer: Content-Length\r\n\r\nhello", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{Trailer=[Content-Length];X-Empty=[];X-Lower=[v]}|cl=-1|te=|close=true|tr={}|hello"
  assert_eq rresp("HTTP/1.2 302 Found\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "302|302 Found|HTTP/1.2 1.2|{}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\n\r\n"
  assert_eq rresp("FOO 101 Switching\r\nCache-Control: max-age=1\r\nContent-Length: 3\r\nx-lower: v\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.0  200 OK\r\nX-Folded: a\r\n b\r\nX-Dup: 2\r\nTrailer: Content-Length\r\nContent-Length:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.1 -12 x\r\nX-Folded: a\r\n b\r\nX-Dup: 2\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 204 No Content\r\nHost: y.com:80\r\nConnection: keep-alive\r\nContent-Length: 05\r\nTransfer-Encoding: Chunked\r\n\r\n0\r\n\r\n", false), "204|204 No Content|HTTP/1.1 1.1|{Connection=[keep-alive];Content-Length=[05];Host=[y.com:80]}|cl=0|te=chunked|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 302 Found\r\nX-Dup: 2\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n", false), "ERR invalid byte in chunk length"
  assert_eq rresp("HTTP/1.0 404\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\r\nhel", false), "404|404|HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|5\r\nhel"
  assert_eq rresp("HTTP/1.1  200 OK\r\nConnection: keep-alive\r\nConnection: Upgrade, Close\r\nPragma: no-cache\r\nbad header\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("FOO 304 Not Modified\r\nbad header\r\nContent-Length: -1\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 200\r\nContent-Length:\r\n\r\n5\r\nhel", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("FOO 200 OK\r\n\r\nhello", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 404\r\nX-Folded: a\r\n b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", true), "404|404|HTTP/1.1 1.1|{X-Folded=[a b]}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 200\r\nTrailer: Content-Length\r\n\r\n5\nhello\n0\n\n", false), "200|200|HTTP/1.0 1.0|{Trailer=[Content-Length]}|cl=-1|te=|close=true|tr={}|5\nhello\n0\n\n"
  assert_eq rresp("HTTP/1.1 101 Switching\r\nTransfer-Encoding: gzip\r\n\r\nhello world", true), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.2 abc OK\r\nX-Empty:\r\nConnection: close\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.2 200 OK\r\nContent-Length: 05\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhel", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.2  200 OK\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.2 1.2|{}|cl=-1|te=|close=true|tr={}|1\r\nab\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 101 Switching\r\nContent-Length: -1\r\nX-Empty:\r\n\r\nhello", true), "ERR bad Content-Length \"-1\""
  assert_eq rresp("HTTP/1.1  200 OK\r\nContent-Length: 5\r\n\r\n5\nhello\n0\n\n", false), "200|200 OK|HTTP/1.1 1.1|{Content-Length=[5]}|cl=5|te=|close=false|tr={}|5\nhel"
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\nX-Folded: a\r\n b\r\nTrailer: a, b\r\n\r\n5\r\nhello\r\n0\r\n\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\n\r\nhello world", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|hello world"
  assert_eq rresp("HTTP/1.x 2000 OK\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1  200 OK\r\n", true), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.2 200 OK\r\nConnection: close\r\nContent-Length: 5\r\nx-lower: v\r\n\r\n5\r\nhello\r\n0\r\n\r\n", true), "200|200 OK|HTTP/1.2 1.2|{Content-Length=[5];X-Lower=[v]}|cl=5|te=|close=true|tr={}|"
  assert_eq rresp("FOO -12 x\r\nCache-Control: max-age=1\r\nPragma: no-cache\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nbad header\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.1 404\r\nPragma: no-cache\r\nX-Folded: a\r\n b\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.x 302 Found\r\nConnection: close\r\nPragma: no-cache\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.2 302 Found\r\nContent-Length: 5\r\nPragma: no-cache\r\n\r\nzz\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nHost: x\r\nHost: x\r\nTrailer: Content-Length\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.0 -12 x\r\nExpect: 100-continue\r\n", true), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 204 No Content\r\nTransfer-Encoding: gzip\r\nX-Folded: a\r\n b\r\nContent-Length: 3\r\n\r\nhello world", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("FOO 200 OK\r\nContent-Length: 3\r\n\r\nhello", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nConnection: close\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nX-Dup: 2\r\nX-Dup: 1\r\nX-Empty:\r\n\r\n5\r\nhel", false), "204|204 No Content|HTTP/1.1 1.1|{X-Dup=[2|1];X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 200 OK\r\nContent-Length: 0\r\nx-lower: v\r\nCache-Control: max-age=1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.1 1.1|{Cache-Control=[max-age=1];Content-Length=[0];X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x 500 Internal Server Error\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/2.0 304 Not Modified\r\nx-lower: v\r\nExpect: 100-continue\r\nHost: y.com:80\r\nContent-Length: 05\r\n\r\nzz\r\n", false), "304|304 Not Modified|HTTP/2.0 2.0|{Content-Length=[05];Expect=[100-continue];Host=[y.com:80];X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x  200 OK\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: -1\r\nHost: x\r\nContent-Length: 05\r\n\r\n5\nhello\n0\n\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.2 500 Internal Server Error\r\nConnection: close\r\nTrailer: a, b\r\n\r\nhello", false), "500|500 Internal Server Error|HTTP/1.2 1.2|{Trailer=[a, b]}|cl=-1|te=|close=true|tr={}|hello"
  assert_eq rresp("HTTP/2.0 500 Internal Server Error\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", true), "500|500 Internal Server Error|HTTP/2.0 2.0|{}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x -12 x\r\n\r\nhello world", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.0 -12 x\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/2.0 304 Not Modified\r\nx-lower: v\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", true), "304|304 Not Modified|HTTP/2.0 2.0|{X-Lower=[v]}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 304 Not Modified\r\nConnection: keep-alive\r\nx-lower: v\r\nbad header\r\nConnection: keep-alive\r\n\r\n0\r\n\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.1  200 OK\r\nContent-Length: 5\r\nX-Dup: 1\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.2 2000 OK\r\nPragma: no-cache\r\nX-Empty:\r\nTrailer: a, b\r\nContent-Length:\r\n\r\nhello", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.0 200 OK\r\nTrailer: X-T\r\nbad header\r\nTransfer-Encoding: gzip\r\nConnection: close\r\n\r\nhello", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.1 404\r\nContent-Length: 5\r\nContent-Length: 0\r\nTrailer: a, b\r\nX-Sp : v\r\n\r\n1\r\nab\r\n0\r\n\r\n", true), "ERR http: message cannot contain multiple Content-Length headers; got [\"5\" \"0\"]"
  assert_eq rresp("FOO 500 Internal Server Error\r\nTransfer-Encoding: chunked\r\nContent-Length: 05\r\nTrailer: a, b\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 404\r\n\r\n5\r\nhel", false), "404|404|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|5\r\nhel"
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 abc OK\r\nTransfer-Encoding: Chunked\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("FOO 500 Internal Server Error\r\nTrailer: X-T\r\nTrailer: a, b\r\nContent-Length:\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("FOO 404\r\nConnection: close\r\n\r\nhello", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 2000 OK\r\nHost: y.com:80\r\nX-Dup: 2\r\nTransfer-Encoding: Chunked\r\nPragma: no-cache\r\n\r\nhello", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/2.0 200 OK\r\nX-Sp : v\r\nbad header\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello world", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.0  200 OK\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: -1\r\nx-lower: v\r\nExpect: 100-continue\r\n\r\n5\r\nhel", false), "ERR bad Content-Length \"-1\""
  assert_eq rresp("HTTP/1.0 101 Switching\r\nTrailer: a, b\r\nConnection: close\r\nTransfer-Encoding: chunked, gzip\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "101|101 Switching|HTTP/1.0 1.0|{Connection=[close];Trailer=[a, b]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.0 -12 x\r\nContent-Length: 5\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("FOO 204 No Content\r\nX-Sp : v\r\nTransfer-Encoding: gzip\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 2000 OK\r\nConnection: keep-alive\r\nHost: y.com:80\r\nX-Sp : v\r\nContent-Length: 05\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.x abc OK\r\nHost: y.com:80\r\nContent-Length: 5\r\nbad header\r\nTrailer: Content-Length\r\n\r\n5\r\nhel", true), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.2 200 OK\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.2 1.2|{}|cl=-1|te=|close=true|tr={}|3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.0 404\r\nX-Sp : v\r\nTrailer: a, b\r\nX-Dup: 2\r\n\r\n0\r\n\r\n", false), "404|404|HTTP/1.0 1.0|{Trailer=[a, b];X-Dup=[2];X-Sp =[v]}|cl=-1|te=|close=true|tr={}|0\r\n\r\n"
  assert_eq rresp("HTTP/1.0 204 No Content\r\n\r\n", false), "204|204 No Content|HTTP/1.0 1.0|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 200 OK\r\nContent-Length:\r\n\r\n5\nhello\n0\n\n", true), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.0 200\r\nTransfer-Encoding: Chunked\r\nPragma: no-cache\r\nX-Empty:\r\nContent-Length: 3\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "200|200|HTTP/1.0 1.0|{Cache-Control=[no-cache];Content-Length=[3];Pragma=[no-cache];X-Empty=[]}|cl=3|te=|close=true|tr={}|1\r\n"
  assert_eq rresp("HTTP/1.x 404\r\nbad header\r\nTrailer: a, b\r\nCache-Control: max-age=1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("FOO abc OK\r\nContent-Length: 3\r\nContent-Length: 3\r\nConnection: Upgrade, Close\r\n\r\nhello world", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/2.0 -12 x\r\nX-Folded: a\r\n b\r\nHost: y.com:80\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.0 101 Switching\r\nX-Folded: a\r\n b\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1  200 OK\r\nContent-Length: 5\r\nHost: y.com:80\r\n\r\n5\nhello\n0\n\n", false), "200|200 OK|HTTP/1.1 1.1|{Content-Length=[5];Host=[y.com:80]}|cl=5|te=|close=false|tr={}|5\nhel"
  assert_eq rresp("HTTP/1.1 2000 OK\r\nConnection: Upgrade, Close\r\nConnection: keep-alive\r\nConnection: close\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
}

test "vectors: read response 2" {
  assert_eq rresp("HTTP/1.0 200\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "200|200|HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/2.0 -12 x\r\nX-Dup: 2\r\nConnection: Upgrade, Close\r\n\r\nhello", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("FOO 204 No Content\r\nConnection: Upgrade, Close\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 200 OK\r\nX-Sp : v\r\nbad header\r\nContent-Length: -1\r\nContent-Length: 05\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.x 2000 OK\r\nContent-Length: 0\r\n\r\nhello", true), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.2 204 No Content\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "204|204 No Content|HTTP/1.2 1.2|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 2000 OK\r\nCache-Control: max-age=1\r\nCache-Control: max-age=1\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("FOO 204 No Content\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 2000 OK\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 302 Found\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length:\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.1 200 OK\r\nx-lower: v\r\nContent-Length: -1\r\nContent-Length: 5\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", true), "ERR http: message cannot contain multiple Content-Length headers; got [\"-1\" \"5\"]"
  assert_eq rresp("FOO 500 Internal Server Error\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 500 Internal Server Error\r\nConnection: close\r\nTransfer-Encoding: chunked, gzip\r\nX-Dup: 2\r\nX-Empty:\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/2.0 abc OK\r\nPragma: no-cache\r\nbad header\r\nHost: y.com:80\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.2 302 Found\r\nContent-Length:\r\nX-Sp : v\r\nTrailer: Content-Length\r\nContent-Length: 3\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/2.0 101 Switching\r\nX-Sp : v\r\n\r\n5\r\nhel", false), "101|101 Switching|HTTP/2.0 2.0|{X-Sp =[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x  200 OK\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 304 Not Modified\r\nContent-Length: 0\r\n\r\n0\r\n\r\n", false), "304|304 Not Modified|HTTP/1.0 1.0|{Content-Length=[0]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("FOO 304 Not Modified\r\nTrailer: Content-Length\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2  200 OK\r\nContent-Length: 05\r\nConnection: keep-alive\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "304|304 Not Modified|HTTP/1.1 1.1|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x 500 Internal Server Error\r\nContent-Length: 0\r\nHost: x\r\nTransfer-Encoding: Chunked\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nX-Sp : v\r\nHost: x\r\nX-Dup: 1\r\n\r\n5\r\nhel", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{Host=[x];X-Dup=[1];X-Sp =[v]}|cl=-1|te=|close=true|tr={}|5\r\nhel"
  assert_eq rresp("HTTP/1.1 200\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "200|200|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|1\r\nab\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.2 -12 x\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2 200\r\nX-Folded: a\r\n b\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "200|200|HTTP/1.2 1.2|{X-Folded=[a b]}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"
  assert_eq rresp("HTTP/1.x  200 OK\r\nTrailer: a, b\r\nTransfer-Encoding: chunked, gzip\r\nCache-Control: max-age=1\r\n\r\nzz\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("FOO 404\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 05\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("FOO 404\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 304 Not Modified\r\nContent-Length:\r\nx-lower: v\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", true), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.0  200 OK\r\nX-Dup: 2\r\nx-lower: v\r\nTrailer: X-T\r\nConnection: close\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/2.0 304 Not Modified\r\nTrailer: a, b\r\n\r\nzz\r\n", true), "304|304 Not Modified|HTTP/2.0 2.0|{Trailer=[a, b]}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 101 Switching\r\nConnection: keep-alive\r\n\r\n5\r\nhel", false), "101|101 Switching|HTTP/1.1 1.1|{Connection=[keep-alive]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("FOO 404\r\nHost: x\r\nX-Dup: 1\r\nbad header\r\nCache-Control: max-age=1\r\n\r\nhello", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 abc OK\r\nContent-Length: 3\r\nX-Sp : v\r\nExpect: 100-continue\r\nX-Empty:\r\n\r\nhello", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/2.0 101 Switching\r\nConnection: keep-alive\r\nTrailer: X-T\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "101|101 Switching|HTTP/2.0 2.0|{Connection=[keep-alive];Trailer=[X-T]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/2.0 200\r\nX-Dup: 1\r\n\r\n0\r\n\r\n", false), "200|200|HTTP/2.0 2.0|{X-Dup=[1]}|cl=-1|te=|close=true|tr={}|0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 200 OK\r\nHost: x\r\nConnection: close\r\n\r\nhello", false), "200|200 OK|HTTP/1.1 1.1|{Host=[x]}|cl=-1|te=|close=true|tr={}|hello"
  assert_eq rresp("HTTP/2.0  200 OK\r\nContent-Length: -1\r\nTrailer: a, b\r\nX-Sp : v\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR bad Content-Length \"-1\""
  assert_eq rresp("FOO 101 Switching\r\nConnection: close\r\nContent-Length: 05\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 2000 OK\r\nbad header\r\nContent-Length: 0\r\nx-lower: v\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", true), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.x 200\r\nContent-Length:\r\nX-Dup: 1\r\nX-Sp : v\r\n\r\n1\r\nab\r\n0\r\n\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 404\r\nx-lower: v\r\nHost: y.com:80\r\nTransfer-Encoding: Chunked\r\n\r\nhello world", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nConnection: close\r\nx-lower: v\r\nTransfer-Encoding: chunked, gzip\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/2.0 200 OK\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "200|200 OK|HTTP/2.0 2.0|{}|cl=-1|te=|close=true|tr={}|A\r\n0123456789\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/2.0 2000 OK\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nX-Sp : v\r\nTrailer: a, b\r\nX-Empty:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "101|101 Switching|HTTP/1.1 1.1|{Trailer=[a, b];X-Empty=[];X-Sp =[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nConnection: Upgrade, Close\r\nExpect: 100-continue\r\nConnection: close\r\n\r\n5\r\nhel", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{Expect=[100-continue]}|cl=-1|te=|close=true|tr={}|5\r\nhel"
  assert_eq rresp("FOO 101 Switching\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 200 OK\r\nbad header\r\n\r\n5\r\nhel", true), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.x 404\r\nTransfer-Encoding: chunked\r\nContent-Length: 0\r\nCache-Control: max-age=1\r\nHost: x\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nConnection: keep-alive\r\n\r\n0\r\n\r\n", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{Connection=[keep-alive]}|cl=-1|te=|close=true|tr={}|0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 204 No Content\r\n\r\nhello", false), "204|204 No Content|HTTP/1.1 1.1|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/2.0 101 Switching\r\nTrailer: X-T\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: Chunked\r\nContent-Length: 3\r\n\r\nhello", true), "ERR too many transfer encodings: [\"gzip\" \"Chunked\"]"
  assert_eq rresp("FOO abc OK\r\nContent-Length: 5\r\nHost: y.com:80\r\nbad header\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.0 200\r\nContent-Length: 0\r\nX-Empty:\r\nContent-Length: 0\r\nX-Folded: a\r\n b\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.0 2000 OK\r\nX-Empty:\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("FOO 500 Internal Server Error\r\nConnection: keep-alive\r\nCache-Control: max-age=1\r\nTransfer-Encoding: chunked, gzip\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 302 Found\r\nContent-Length: 05\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("FOO 204 No Content\r\nTrailer: X-T\r\nX-Dup: 2\r\nContent-Length: 05\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 2000 OK\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/2.0 200 OK\r\nTransfer-Encoding: chunked, gzip\r\nx-lower: v\r\nX-Folded: a\r\n b\r\nExpect: 100-continue\r\n\r\nzz\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.2 200\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "200|200|HTTP/1.2 1.2|{}|cl=-1|te=|close=true|tr={}|1\r\nab\r\n0\r\n\r\n"
  assert_eq rresp("FOO 204 No Content\r\nx-lower: v\r\nContent-Length: 3\r\nTrailer: X-T\r\nHost: y.com:80\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 500 Internal Server Error\r\nPragma: no-cache\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 500 Internal Server Error\r\nContent-Length: 05\r\nContent-Length: -1\r\nX-Folded: a\r\n b\r\n\r\n5\r\nhel", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"05\" \"-1\"]"
  assert_eq rresp("HTTP/1.x -12 x\r\nTrailer: X-T\r\nHost: y.com:80\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.x 404\r\n\r\nhello", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.2 204 No Content\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: Chunked\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR too many transfer encodings: [\"gzip\" \"chunked\" \"Chunked\"]"
  assert_eq rresp("HTTP/2.0 404\r\nContent-Length: 05\r\nHost: y.com:80\r\nConnection: close\r\nX-Dup: 2\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO 500 Internal Server Error\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 abc OK\r\nx-lower: v\r\n\r\nzz\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.x 404\r\nX-Dup: 2\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0  200 OK\r\nCache-Control: max-age=1\r\nContent-Length:\r\n\r\n0\r\n\r\n", true), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.x 101 Switching\r\nContent-Length: 0\r\nContent-Length: 3\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/2.0 101 Switching\r\nTrailer: Content-Length\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 404\r\nTransfer-Encoding: chunked\r\n\r\nhello", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.0 abc OK\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.0  200 OK\r\nContent-Length:\r\nHost: x\r\nTrailer: X-T\r\nPragma: no-cache\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/2.0 -12 x\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("FOO 302 Found\r\nPragma: no-cache\r\nContent-Length: 0\r\nConnection: close\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.0 2000 OK\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.2 204 No Content\r\nTransfer-Encoding: Chunked\r\n\r\n5\r\nhel", false), "204|204 No Content|HTTP/1.2 1.2|{}|cl=0|te=chunked|close=false|tr={}|"
  assert_eq rresp("HTTP/1.2 304 Not Modified\r\nContent-Length: 3\r\nTrailer: a, b\r\nContent-Length:\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"3\" \"\"]"
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"
  assert_eq rresp("HTTP/1.x -12 x\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.x 101 Switching\r\nContent-Length: -1\r\nHost: y.com:80\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 abc OK\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.2 -12 x\r\nTransfer-Encoding: gzip\r\nX-Empty:\r\nContent-Length: 5\r\n\r\nhello world", true), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 2000 OK\r\n\r\nhello", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1  200 OK\r\nX-Sp : v\r\nTrailer: X-T\r\nX-Empty:\r\nHost: y.com:80\r\n\r\n5\nhello\n0\n\n", true), "200|200 OK|HTTP/1.1 1.1|{Host=[y.com:80];Trailer=[X-T];X-Empty=[];X-Sp =[v]}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 304 Not Modified\r\nContent-Length: -1\r\nTransfer-Encoding: Chunked\r\nTrailer: X-T\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.0 304 Not Modified\r\nPragma: no-cache\r\nTransfer-Encoding: Chunked\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "304|304 Not Modified|HTTP/1.0 1.0|{Cache-Control=[no-cache];Pragma=[no-cache]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("FOO 304 Not Modified\r\nContent-Length:\r\nTrailer: a, b\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 2000 OK\r\nTrailer: a, b\r\nTrailer: Content-Length\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.0 2000 OK\r\n\r\n5\r\nhello\r\n0\r\n\r\n", true), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/2.0 2000 OK\r\nContent-Length: 0\r\nContent-Length: -1\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/2.0 abc OK\r\nCache-Control: max-age=1\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.0 500 Internal Server Error\r\nContent-Length: -1\r\nContent-Length: 05\r\nHost: y.com:80\r\n", true), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.x 404\r\nPragma: no-cache\r\nX-Folded: a\r\n b\r\n\r\n5\r\nhel", true), "ERR malformed HTTP version \"HTTP/1.x\""
}

test "vectors: read response 3" {
  assert_eq rresp("HTTP/1.x 2000 OK\r\nX-Dup: 1\r\nTransfer-Encoding: chunked, gzip\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nTrailer: a, b\r\n\r\n5\r\nhel", true), "304|304 Not Modified|HTTP/1.1 1.1|{Trailer=[a, b]}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("FOO 304 Not Modified\r\nTransfer-Encoding: chunked, gzip\r\nX-Empty:\r\n\r\nhello world", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0  200 OK\r\nX-Dup: 1\r\nX-Empty:\r\nX-Sp : v\r\nContent-Length: -1\r\n\r\n5\r\nhel", false), "ERR bad Content-Length \"-1\""
  assert_eq rresp("HTTP/2.0  200 OK\r\nCache-Control: max-age=1\r\nConnection: close\r\nContent-Length: 3\r\nX-Folded: a\r\n b\r\n\r\n5\nhello\n0\n\n", false), "200|200 OK|HTTP/2.0 2.0|{Cache-Control=[max-age=1];Content-Length=[3];X-Folded=[a b]}|cl=3|te=|close=true|tr={}|5\nh"
  assert_eq rresp("FOO 304 Not Modified\r\nConnection: keep-alive\r\nX-Empty:\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 200 OK\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 204 No Content\r\nContent-Length: 0\r\nContent-Length:\r\nContent-Length: -1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", true), "ERR http: message cannot contain multiple Content-Length headers; got [\"0\" \"\" \"-1\"]"
  assert_eq rresp("HTTP/2.0 2000 OK\r\nX-Folded: a\r\n b\r\nContent-Length: 3\r\nbad header\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.2 2000 OK\r\nX-Folded: a\r\n b\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\n\r\n", true), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 abc OK\r\nConnection: keep-alive\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/2.0 204 No Content\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "204|204 No Content|HTTP/2.0 2.0|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.2 200\r\nContent-Length:\r\nX-Dup: 2\r\n\r\nhello", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.2 500 Internal Server Error\r\nContent-Length: -1\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length:\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.2 304 Not Modified\r\nX-Dup: 2\r\nExpect: 100-continue\r\nHost: x\r\nHost: y.com:80\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "304|304 Not Modified|HTTP/1.2 1.2|{Expect=[100-continue];Host=[x|y.com:80];X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x 404\r\nTransfer-Encoding: Chunked\r\nHost: x\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/2.0 304 Not Modified\r\nConnection: Upgrade, Close\r\nTrailer: Content-Length\r\nTrailer: X-T\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.x 500 Internal Server Error\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 200\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "200|200|HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 404\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "404|404|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 -12 x\r\nTrailer: Content-Length\r\nTransfer-Encoding: gzip\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2 404\r\nHost: y.com:80\r\nExpect: 100-continue\r\nHost: y.com:80\r\n\r\nzz\r\n", false), "404|404|HTTP/1.2 1.2|{Expect=[100-continue];Host=[y.com:80|y.com:80]}|cl=-1|te=|close=true|tr={}|zz\r\n"
  assert_eq rresp("HTTP/1.1 302 Found\r\nTransfer-Encoding: Chunked\r\n\r\n5\nhello\n0\n\n", false), "ERR chunked line ends with bare LF"
  assert_eq rresp("FOO 500 Internal Server Error\r\nConnection: close\r\nContent-Length: 05\r\nX-Dup: 1\r\nX-Dup: 2\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 404\r\nX-Empty:\r\nX-Sp : v\r\nContent-Length: 5\r\nX-Dup: 2\r\n\r\n0\r\n\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1  200 OK\r\nContent-Length: 3\r\nConnection: keep-alive\r\n\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.1 1.1|{Connection=[keep-alive];Content-Length=[3]}|cl=3|te=|close=false|tr={}|0\r\n"
  assert_eq rresp("HTTP/1.0 200 OK\r\nx-lower: v\r\nTrailer: X-T\r\nContent-Length: -1\r\n\r\n5\r\nhel", false), "ERR bad Content-Length \"-1\""
  assert_eq rresp("HTTP/1.1 302 Found\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "302|302 Found|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.2 204 No Content\r\n\r\n5\r\nhello\r\n0\r\n\r\n", true), "204|204 No Content|HTTP/1.2 1.2|{}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 101 Switching\r\nContent-Length: 05\r\nTransfer-Encoding: chunked, gzip\r\n\r\n0\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("FOO 500 Internal Server Error\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 200 OK\r\nConnection: Upgrade, Close\r\nContent-Length: 5\r\n\r\nhello world", false), "200|200 OK|HTTP/1.1 1.1|{Content-Length=[5]}|cl=5|te=|close=true|tr={}|hello"
  assert_eq rresp("HTTP/1.2 304 Not Modified\r\nContent-Length: 05\r\nExpect: 100-continue\r\nConnection: keep-alive\r\n", true), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.0 304 Not Modified\r\nContent-Length: 0\r\nX-Sp : v\r\nHost: x\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "304|304 Not Modified|HTTP/1.0 1.0|{Content-Length=[0];Host=[x];X-Sp =[v]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.0 304 Not Modified\r\nTrailer: X-T\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "304|304 Not Modified|HTTP/1.0 1.0|{Trailer=[X-T]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 -12 x\r\n\r\nhello world", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2 2000 OK\r\nX-Empty:\r\nContent-Length: 0\r\n\r\nzz\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("FOO 304 Not Modified\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 0\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 404\r\nConnection: Upgrade, Close\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 abc OK\r\n", true), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("FOO 304 Not Modified\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0 -12 x\r\nContent-Length: 3\r\nConnection: close\r\n\r\nhello world", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.0 200 OK\r\n\r\nhello world", false), "200|200 OK|HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|hello world"
  assert_eq rresp("HTTP/1.0 500 Internal Server Error\r\nTransfer-Encoding: Chunked\r\nContent-Length:\r\n\r\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("FOO  200 OK\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 200\r\nX-Folded: a\r\n b\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: chunked, gzip\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR too many transfer encodings: [\"Chunked\" \"chunked, gzip\"]"
  assert_eq rresp("HTTP/2.0 304 Not Modified\r\nContent-Length: -1\r\nPragma: no-cache\r\nContent-Length: 0\r\nX-Empty:\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.2 2000 OK\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 200\r\nConnection: keep-alive\r\nContent-Length: 0\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO 304 Not Modified\r\nExpect: 100-continue\r\nX-Folded: a\r\n b\r\nConnection: keep-alive\r\nX-Empty:\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0 200 OK\r\nTrailer: a, b\r\nTrailer: X-T\r\nX-Folded: a\r\n b\r\nExpect: 100-continue\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "200|200 OK|HTTP/2.0 2.0|{Expect=[100-continue];Trailer=[a, b|X-T];X-Folded=[a b]}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"
  assert_eq rresp("HTTP/1.x abc OK\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/2.0 200 OK\r\nX-Dup: 1\r\nContent-Length: 0\r\nConnection: keep-alive\r\nbad header\r\n\r\nzz\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/2.0 200\r\nPragma: no-cache\r\n\r\n5\r\nhel", true), "200|200|HTTP/2.0 2.0|{Cache-Control=[no-cache];Pragma=[no-cache]}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.2 302 Found\r\nX-Empty:\r\nContent-Length: 05\r\nX-Sp : v\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 -12 x\r\nX-Dup: 1\r\nHost: x\r\nx-lower: v\r\nContent-Length: 05\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("FOO 304 Not Modified\r\nTrailer: X-T\r\n\r\nhello world", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 2000 OK\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.x 2000 OK\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.x -12 x\r\nTransfer-Encoding: Chunked\r\nX-Dup: 1\r\nConnection: close\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.x 500 Internal Server Error\r\nX-Sp : v\r\nContent-Length: 5\r\n\r\n5\r\nhel", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/2.0 500 Internal Server Error\r\nTrailer: a, b\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "500|500 Internal Server Error|HTTP/2.0 2.0|{Trailer=[a, b]}|cl=-1|te=|close=true|tr={}|3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 302 Found\r\nX-Empty:\r\nConnection: Upgrade, Close\r\nContent-Length: 0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "302|302 Found|HTTP/1.1 1.1|{Content-Length=[0];X-Empty=[]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("FOO abc OK\r\nX-Dup: 1\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("FOO 304 Not Modified\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0 abc OK\r\nPragma: no-cache\r\nContent-Length: 3\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.1 404\r\nTrailer: Content-Length\r\n\r\nhello", true), "404|404|HTTP/1.1 1.1|{Trailer=[Content-Length]}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 302 Found\r\nExpect: 100-continue\r\n\r\nhello", false), "302|302 Found|HTTP/1.0 1.0|{Expect=[100-continue]}|cl=-1|te=|close=true|tr={}|hello"
  assert_eq rresp("FOO 204 No Content\r\nX-Folded: a\r\n b\r\nConnection: keep-alive\r\nConnection: Upgrade, Close\r\nContent-Length: 3\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0  200 OK\r\nContent-Length: 5\r\nContent-Length:\r\nTrailer: X-T\r\nConnection: Upgrade, Close\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"5\" \"\"]"
  assert_eq rresp("HTTP/2.0 404\r\nContent-Length: 3\r\nExpect: 100-continue\r\nExpect: 100-continue\r\nX-Empty:\r\n\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.0 404\r\nX-Sp : v\r\nCache-Control: max-age=1\r\n\r\nhello", false), "404|404|HTTP/1.0 1.0|{Cache-Control=[max-age=1];X-Sp =[v]}|cl=-1|te=|close=true|tr={}|hello"
  assert_eq rresp("FOO 500 Internal Server Error\r\nX-Dup: 1\r\nx-lower: v\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 200\r\nConnection: close\r\nCache-Control: max-age=1\r\nHost: y.com:80\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "200|200|HTTP/1.1 1.1|{Cache-Control=[max-age=1];Host=[y.com:80]}|cl=-1|te=|close=true|tr={}|3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.0 204 No Content\r\nContent-Length:\r\nCache-Control: max-age=1\r\n\r\n0\r\n\r\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.0 200 OK\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO 304 Not Modified\r\nHost: y.com:80\r\nPragma: no-cache\r\nbad header\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0 500 Internal Server Error\r\n\r\n5\r\nhel", true), "500|500 Internal Server Error|HTTP/2.0 2.0|{}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x 500 Internal Server Error\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.x  200 OK\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 101 Switching\r\nX-Empty:\r\n\r\n5\nhello\n0\n\n", false), "101|101 Switching|HTTP/1.0 1.0|{X-Empty=[]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("FOO  200 OK\r\n\r\n5\nhello\n0\n\n", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 302 Found\r\nX-Sp : v\r\nContent-Length: 5\r\nX-Dup: 2\r\nPragma: no-cache\r\n\r\nhello world", true), "302|302 Found|HTTP/1.2 1.2|{Cache-Control=[no-cache];Content-Length=[5];Pragma=[no-cache];X-Dup=[2];X-Sp =[v]}|cl=5|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x 200\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.x -12 x\r\nTransfer-Encoding: gzip\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.x 204 No Content\r\nTrailer: a, b\r\nX-Sp : v\r\nTransfer-Encoding: Chunked\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/2.0  200 OK\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "200|200 OK|HTTP/2.0 2.0|{}|cl=-1|te=|close=true|tr={}|1\r\nab\r\n0\r\n\r\n"
  assert_eq rresp("FOO 500 Internal Server Error\r\nTrailer: Content-Length\r\nTrailer: Content-Length\r\nConnection: close\r\nTrailer: a, b\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0 200 OK\r\nTrailer: Content-Length\r\nX-Folded: a\r\n b\r\nContent-Length:\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.0 2000 OK\r\nContent-Length:\r\nTransfer-Encoding: chunked\r\nX-Dup: 2\r\nx-lower: v\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.0 200 OK\r\nContent-Length: 3\r\nbad header\r\nConnection: keep-alive\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nContent-Length: -1\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/2.0 200\r\nHost: y.com:80\r\nX-Dup: 1\r\nContent-Length: 0\r\n\r\nhello", false), "200|200|HTTP/2.0 2.0|{Content-Length=[0];Host=[y.com:80];X-Dup=[1]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 200 OK\r\n\r\nzz\r\n", false), "200|200 OK|HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|zz\r\n"
  assert_eq rresp("HTTP/1.1 -12 x\r\nTrailer: a, b\r\nX-Sp : v\r\nExpect: 100-continue\r\nContent-Length: -1\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.0 200 OK\r\nTransfer-Encoding: gzip\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.x 101 Switching\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 404\r\nTrailer: a, b\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel", false), "ERR unexpected EOF"
}

test "vectors: read response 4" {
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nX-Dup: 2\r\nTransfer-Encoding: chunked\r\n\r\n", false), "304|304 Not Modified|HTTP/1.1 1.1|{X-Dup=[2]}|cl=0|te=chunked|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 204 No Content\r\nCache-Control: max-age=1\r\nContent-Length: -1\r\nTransfer-Encoding: chunked\r\nContent-Length: 05\r\n\r\nhello", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"-1\" \"05\"]"
  assert_eq rresp("HTTP/1.0 302 Found\r\nX-Empty:\r\nTransfer-Encoding: gzip\r\nbad header\r\nTransfer-Encoding: chunked\r\n\r\nhello world", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\n5\nhello\n0\n\n", false), "101|101 Switching|HTTP/1.1 1.1|{Content-Length=[5]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 abc OK\r\nHost: y.com:80\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.1 302 Found\r\nTrailer: X-T\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "302|302 Found|HTTP/1.1 1.1|{Trailer=[X-T]}|cl=-1|te=|close=true|tr={}|A\r\n0123456789\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.2  200 OK\r\nTransfer-Encoding: chunked\r\nHost: y.com:80\r\nHost: y.com:80\r\nHost: x\r\n\r\nhello world", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 2000 OK\r\nTransfer-Encoding: gzip\r\nContent-Length: 3\r\nCache-Control: max-age=1\r\nConnection: Upgrade, Close\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 204 No Content\r\nx-lower: v\r\nX-Sp : v\r\nTransfer-Encoding: Chunked\r\nPragma: no-cache\r\n\r\n0\r\n\r\n", false), "204|204 No Content|HTTP/1.1 1.1|{Cache-Control=[no-cache];Pragma=[no-cache];X-Lower=[v];X-Sp =[v]}|cl=0|te=chunked|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 200\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "200|200|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|A\r\n0123456789\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nConnection: close\r\nx-lower: v\r\nx-lower: v\r\nContent-Length: 0\r\n\r\n5\r\nhel", false), "304|304 Not Modified|HTTP/1.1 1.1|{Content-Length=[0];X-Lower=[v|v]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.x 302 Found\r\nTransfer-Encoding: chunked\r\nX-Dup: 2\r\nConnection: keep-alive\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 404\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\nX-Folded: a\r\n b\r\nContent-Length: -1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR too many transfer encodings: [\"gzip\" \"chunked\"]"
  assert_eq rresp("HTTP/1.x 200\r\nContent-Length:\r\nExpect: 100-continue\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 -12 x\r\nTrailer: a, b\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2 2000 OK\r\nHost: x\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nHost: x\r\nx-lower: v\r\nX-Folded: a\r\n b\r\nHost: x\r\n\r\n5\nhello\n0\n\n", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{Host=[x|x];X-Folded=[a b];X-Lower=[v]}|cl=-1|te=|close=true|tr={}|5\nhello\n0\n\n"
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nConnection: close\r\n\r\nhello world", false), "304|304 Not Modified|HTTP/1.1 1.1|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/2.0 101 Switching\r\nTransfer-Encoding: chunked, gzip\r\nHost: y.com:80\r\nTrailer: a, b\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.2 101 Switching\r\nTransfer-Encoding: gzip\r\nContent-Length: -1\r\nTransfer-Encoding: gzip\r\nContent-Length:\r\n\r\nzz\r\n", true), "ERR too many transfer encodings: [\"gzip\" \"gzip\"]"
  assert_eq rresp("HTTP/1.2 404\r\nHost: y.com:80\r\nContent-Length: 3\r\nConnection: close\r\nContent-Length: 05\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"3\" \"05\"]"
  assert_eq rresp("HTTP/2.0 404\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "404|404|HTTP/2.0 2.0|{Host=[y.com:80]}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 204 No Content\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "204|204 No Content|HTTP/1.1 1.1|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 200\r\nContent-Length: 5\r\nContent-Length: 3\r\nTrailer: Content-Length\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 -12 x\r\nContent-Length: 05\r\nX-Dup: 1\r\nTransfer-Encoding: gzip\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/2.0 101 Switching\r\n\r\nhello", true), "101|101 Switching|HTTP/2.0 2.0|{}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nHost: y.com:80\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\nTrailer: X-T\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.2 404\r\n\r\n5\r\nhel", false), "404|404|HTTP/1.2 1.2|{}|cl=-1|te=|close=true|tr={}|5\r\nhel"
  assert_eq rresp("HTTP/1.0 -12 x\r\n\r\nhello world", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nExpect: 100-continue\r\nTransfer-Encoding: gzip\r\nConnection: keep-alive\r\n\r\nzz\r\n", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.1 404\r\nTransfer-Encoding: chunked\r\n\r\n", true), "404|404|HTTP/1.1 1.1|{}|cl=-1|te=chunked|close=false|tr={}|"
  assert_eq rresp("HTTP/2.0 200 OK\r\nContent-Length: 3\r\nCache-Control: max-age=1\r\nExpect: 100-continue\r\n\r\n5\nhello\n0\n\n", false), "200|200 OK|HTTP/2.0 2.0|{Cache-Control=[max-age=1];Content-Length=[3];Expect=[100-continue]}|cl=3|te=|close=false|tr={}|5\nh"
  assert_eq rresp("HTTP/2.0 200 OK\r\n\r\nhello world", false), "200|200 OK|HTTP/2.0 2.0|{}|cl=-1|te=|close=true|tr={}|hello world"
  assert_eq rresp("HTTP/1.1 404\r\nContent-Length: 3\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "404|404|HTTP/1.1 1.1|{Content-Length=[3]}|cl=3|te=|close=false|tr={}|5\r\n"
  assert_eq rresp("HTTP/1.1 404\r\nConnection: keep-alive\r\nTrailer: a, b\r\nContent-Length: 5\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nContent-Length: 3\r\n\r\nhello world", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{Content-Length=[3]}|cl=3|te=|close=false|tr={}|hel"
  assert_eq rresp("HTTP/1.0  200 OK\r\nContent-Length: 3\r\nContent-Length: 5\r\nConnection: Upgrade, Close\r\nConnection: close\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 abc OK\r\nX-Sp : v\r\nContent-Length: 3\r\nContent-Length: 05\r\nContent-Length:\r\n\r\nhello world", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.2 2000 OK\r\nTrailer: X-T\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.x 302 Found\r\nTrailer: a, b\r\n\r\n5\r\nhel", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("FOO 204 No Content\r\nX-Empty:\r\nX-Empty:\r\n\r\n5\nhello\n0\n\n", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("FOO 200 OK\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.0 200 OK\r\n\r\n5\nhello\n0\n\n", false), "200|200 OK|HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|5\nhello\n0\n\n"
  assert_eq rresp("HTTP/1.2  200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.2 1.2|{}|cl=-1|te=chunked|close=false|tr={}|abcde"
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\nContent-Length:\r\n\r\nhello world", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nContent-Length: 3\r\nContent-Length: 05\r\nHost: y.com:80\r\n\r\nzz\r\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"3\" \"05\"]"
  assert_eq rresp("HTTP/2.0 204 No Content\r\nContent-Length: 5\r\nConnection: Upgrade, Close\r\n\r\n0\r\n\r\n", false), "204|204 No Content|HTTP/2.0 2.0|{Content-Length=[5]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1  200 OK\r\nTransfer-Encoding: gzip\r\nX-Empty:\r\n\r\nhello world", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.2 304 Not Modified\r\nContent-Length: 0\r\nContent-Length:\r\nContent-Length:\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"0\" \"\" \"\"]"
  assert_eq rresp("HTTP/1.1 -12 x\r\nContent-Length: 0\r\nTrailer: Content-Length\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.x 200\r\nContent-Length: 05\r\nContent-Length: 3\r\nX-Folded: a\r\n b\r\nExpect: 100-continue\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 404\r\nPragma: no-cache\r\nContent-Length: 05\r\nTransfer-Encoding: chunked, gzip\r\nHost: y.com:80\r\n\r\nhello", true), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.x 500 Internal Server Error\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 abc OK\r\nX-Dup: 2\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: gzip\r\nX-Dup: 1\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.2 200\r\nContent-Length: 0\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 404\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked, gzip\r\n", true), "ERR unexpected EOF"
  assert_eq rresp("FOO -12 x\r\n\r\nhello world", true), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 204 No Content\r\nContent-Length: 5\r\nTransfer-Encoding: chunked, gzip\r\nX-Dup: 2\r\nTrailer: X-T\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.0 204 No Content\r\nTrailer: a, b\r\nX-Dup: 2\r\nHost: x\r\n\r\nhello", false), "204|204 No Content|HTTP/1.0 1.0|{Host=[x];Trailer=[a, b];X-Dup=[2]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("FOO 200\r\nContent-Length: 3\r\nContent-Length: 3\r\nContent-Length: -1\r\nContent-Length:\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 2000 OK\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 -12 x\r\nConnection: keep-alive\r\nx-lower: v\r\nHost: x\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/2.0 -12 x\r\nContent-Length:\r\n\r\nhello world", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/2.0 101 Switching\r\nX-Dup: 2\r\nTransfer-Encoding: chunked, gzip\r\nHost: x\r\n\r\nzz\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/2.0  200 OK\r\nHost: x\r\nContent-Length:\r\nTransfer-Encoding: chunked\r\nX-Folded: a\r\n b\r\n\r\nhello world", true), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.x 302 Found\r\nTransfer-Encoding: Chunked\r\nX-Sp : v\r\nHost: y.com:80\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.2 500 Internal Server Error\r\nbad header\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.2 204 No Content\r\nTrailer: Content-Length\r\nContent-Length: 5\r\nTransfer-Encoding: chunked, gzip\r\nTrailer: a, b\r\n\r\nhello world", true), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.2 101 Switching\r\nHost: y.com:80\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "101|101 Switching|HTTP/1.2 1.2|{Host=[y.com:80]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 200\r\nX-Empty:\r\nHost: y.com:80\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n", false), "ERR too many transfer encodings: [\"gzip\" \"chunked\"]"
  assert_eq rresp("FOO 302 Found\r\nx-lower: v\r\nTransfer-Encoding: gzip\r\nx-lower: v\r\nContent-Length: -1\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("FOO 302 Found\r\nConnection: Upgrade, Close\r\nContent-Length: 05\r\nTransfer-Encoding: Chunked\r\nHost: x\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 2000 OK\r\nTrailer: a, b\r\nX-Dup: 1\r\n\r\nzz\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.0 500 Internal Server Error\r\nTransfer-Encoding: chunked\r\nContent-Length:\r\nContent-Length:\r\n\r\n5\nhello\n0\n\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.1 302 Found\r\n\r\nhello", false), "302|302 Found|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|hello"
  assert_eq rresp("HTTP/2.0 304 Not Modified\r\nbad header\r\nContent-Length: 3\r\nContent-Length: 0\r\nX-Empty:\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.2 101 Switching\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.2 404\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: gzip\r\nTrailer: X-T\r\nHost: x\r\n\r\nhello world", true), "ERR too many transfer encodings: [\"gzip\" \"gzip\"]"
  assert_eq rresp("HTTP/2.0 200\r\nTransfer-Encoding: chunked, gzip\r\nHost: y.com:80\r\nCache-Control: max-age=1\r\nHost: x\r\n\r\nhello", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.1  200 OK\r\nTrailer: X-T\r\nX-Sp : v\r\n\r\nhello world", true), "200|200 OK|HTTP/1.1 1.1|{Trailer=[X-T];X-Sp =[v]}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nExpect: 100-continue\r\nTransfer-Encoding: Chunked\r\nConnection: Upgrade, Close\r\nTransfer-Encoding: chunked\r\n\r\nhello world", false), "ERR too many transfer encodings: [\"Chunked\" \"chunked\"]"
  assert_eq rresp("HTTP/1.x 101 Switching\r\nx-lower: v\r\n\r\nhello", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.2 302 Found\r\nTrailer: a, b\r\nConnection: keep-alive\r\nX-Folded: a\r\n b\r\n\r\nhello world", false), "302|302 Found|HTTP/1.2 1.2|{Connection=[keep-alive];Trailer=[a, b];X-Folded=[a b]}|cl=-1|te=|close=true|tr={}|hello world"
  assert_eq rresp("HTTP/1.x abc OK\r\n\r\n0\r\n\r\n", true), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.1 200 OK\r\nX-Sp : v\r\nConnection: keep-alive\r\nContent-Length: -1\r\nX-Dup: 1\r\n\r\n", false), "ERR bad Content-Length \"-1\""
  assert_eq rresp("HTTP/1.1 404\r\nTrailer: a, b\r\nX-Dup: 1\r\n\r\n0\r\n\r\n", false), "404|404|HTTP/1.1 1.1|{Trailer=[a, b];X-Dup=[1]}|cl=-1|te=|close=true|tr={}|0\r\n\r\n"
  assert_eq rresp("HTTP/1.0 abc OK\r\nCache-Control: max-age=1\r\nExpect: 100-continue\r\nPragma: no-cache\r\nX-Folded: a\r\n b\r\n\r\nzz\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.x 200\r\nX-Sp : v\r\n\r\nhello world", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.x  200 OK\r\nConnection: Upgrade, Close\r\nTransfer-Encoding: chunked, gzip\r\nX-Sp : v\r\nX-Dup: 1\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 abc OK\r\nExpect: 100-continue\r\nConnection: close\r\n\r\nhello world", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.1 200\r\nTransfer-Encoding: Chunked\r\nContent-Length: -1\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 0\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR too many transfer encodings: [\"Chunked\" \"chunked, gzip\"]"
  assert_eq rresp("HTTP/1.1 200 OK\r\nConnection: Upgrade, Close\r\n", true), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 101 Switching\r\nX-Empty:\r\n\r\nzz\r\n", false), "101|101 Switching|HTTP/1.1 1.1|{X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.2 404\r\nConnection: Upgrade, Close\r\nContent-Length: 3\r\nConnection: keep-alive\r\nContent-Length: 3\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "404|404|HTTP/1.2 1.2|{Content-Length=[3]}|cl=3|te=|close=true|tr={}|5\r\n"
  assert_eq rresp("HTTP/1.1 abc OK\r\nX-Dup: 2\r\nContent-Length: 0\r\nX-Dup: 2\r\nTrailer: a, b\r\n\r\n5\nhello\n0\n\n", true), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("FOO 200\r\nX-Dup: 1\r\nTransfer-Encoding: gzip\r\nX-Dup: 1\r\nConnection: Upgrade, Close\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("FOO 101 Switching\r\nPragma: no-cache\r\n", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 404\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked, gzip\r\n\r\nhello", true), "ERR too many transfer encodings: [\"gzip\" \"chunked, gzip\"]"
  assert_eq rresp("HTTP/1.2 200\r\nTrailer: X-T\r\nContent-Length: -1\r\nTransfer-Encoding: Chunked\r\n\r\n", false), "ERR bad Content-Length \"-1\""
}

test "vectors: read response 5" {
  assert_eq rresp("FOO abc OK\r\nTransfer-Encoding: Chunked\r\n\r\nhello", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.x 200 OK\r\nCache-Control: max-age=1\r\nX-Dup: 2\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/2.0 101 Switching\r\nX-Empty:\r\n\r\n5\r\nhel", false), "101|101 Switching|HTTP/2.0 2.0|{X-Empty=[]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.2 200\r\nCache-Control: max-age=1\r\nTransfer-Encoding: gzip\r\n\r\n", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.1 404\r\nx-lower: v\r\nHost: x\r\nContent-Length:\r\nHost: x\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.2  200 OK\r\nExpect: 100-continue\r\nConnection: close\r\nPragma: no-cache\r\n\r\nhello world", false), "200|200 OK|HTTP/1.2 1.2|{Cache-Control=[no-cache];Expect=[100-continue];Pragma=[no-cache]}|cl=-1|te=|close=true|tr={}|hello world"
  assert_eq rresp("HTTP/1.x 200\r\nPragma: no-cache\r\nTrailer: X-T\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.x 101 Switching\r\nContent-Length: 5\r\nContent-Length: 05\r\n\r\nhello", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("FOO 404\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: Chunked\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nContent-Length: 3\r\nTransfer-Encoding: Chunked\r\nConnection: keep-alive\r\nX-Dup: 2\r\n\r\nhello", false), "101|101 Switching|HTTP/1.1 1.1|{Connection=[keep-alive];Content-Length=[3];X-Dup=[2]}|cl=0|te=chunked|close=false|tr={}|"
  assert_eq rresp("FOO 500 Internal Server Error\r\nHost: y.com:80\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 200\r\nTransfer-Encoding: gzip\r\nContent-Length: 0\r\nX-Dup: 1\r\nX-Sp : v\r\n\r\n5\nhello\n0\n\n", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.0 -12 x\r\nContent-Length: 0\r\n\r\nzz\r\n", true), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.0 2000 OK\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("FOO 200 OK\r\nTrailer: a, b\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 404\r\nContent-Length: 0\r\nConnection: Upgrade, Close\r\n\r\nzz\r\n", false), "404|404|HTTP/1.1 1.1|{Content-Length=[0]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.x 200\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.x 204 No Content\r\nContent-Length: 05\r\nContent-Length: 05\r\nX-Folded: a\r\n b\r\nConnection: close\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 200\r\nConnection: keep-alive\r\nExpect: 100-continue\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "200|200|HTTP/1.0 1.0|{Connection=[keep-alive];Expect=[100-continue]}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.0 200\r\nExpect: 100-continue\r\nX-Empty:\r\nTransfer-Encoding: chunked, gzip\r\nConnection: close\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.x  200 OK\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 2000 OK\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.2 302 Found\r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\nzz\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.2 404\r\nx-lower: v\r\nConnection: Upgrade, Close\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "404|404|HTTP/1.2 1.2|{X-Lower=[v]}|cl=-1|te=|close=true|tr={}|3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.0 200 OK\r\nContent-Length: 3\r\nConnection: close\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.0 1.0|{Connection=[close];Content-Length=[3]}|cl=3|te=|close=true|tr={}|A\r\n"
  assert_eq rresp("HTTP/1.0 200\r\nCache-Control: max-age=1\r\nContent-Length: 0\r\nContent-Length: -1\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"0\" \"-1\"]"
  assert_eq rresp("HTTP/1.x -12 x\r\nTransfer-Encoding: gzip\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nContent-Length: 5\r\nbad header\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.x 204 No Content\r\nTrailer: Content-Length\r\nContent-Length: 5\r\nContent-Length: 0\r\nContent-Length: 0\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("FOO 101 Switching\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\nTrailer: Content-Length\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 200\r\nContent-Length: 05\r\nExpect: 100-continue\r\n\r\nhello", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/2.0 404\r\nConnection: Upgrade, Close\r\n\r\n0\r\n\r\n", false), "404|404|HTTP/2.0 2.0|{}|cl=-1|te=|close=true|tr={}|0\r\n\r\n"
  assert_eq rresp("FOO 2000 OK\r\nX-Sp : v\r\nPragma: no-cache\r\nConnection: Upgrade, Close\r\n", true), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.2 abc OK\r\nTransfer-Encoding: chunked\r\nTrailer: a, b\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.0 2000 OK\r\nTrailer: X-T\r\nX-Folded: a\r\n b\r\nHost: x\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 204 No Content\r\nTransfer-Encoding: gzip\r\nX-Dup: 2\r\nHost: y.com:80\r\nX-Empty:\r\n\r\n0\r\n\r\n", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.2 2000 OK\r\nbad header\r\nTrailer: a, b\r\nHost: y.com:80\r\nContent-Length: 5\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/2.0 -12 x\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.0 200 OK\r\nConnection: Upgrade, Close\r\nX-Sp : v\r\nConnection: close\r\nX-Folded: a\r\n b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", true), "200|200 OK|HTTP/1.0 1.0|{Connection=[Upgrade, Close|close];X-Folded=[a b];X-Sp =[v]}|cl=-1|te=|close=true|tr={}|"
  assert_eq rresp("FOO 200\r\nTransfer-Encoding: Chunked\r\nContent-Length: 0\r\n\r\nhello", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.0 404\r\nContent-Length: 3\r\nx-lower: v\r\nTransfer-Encoding: Chunked\r\nX-Folded: a\r\n b\r\n\r\nzz\r\n", false), "404|404|HTTP/1.0 1.0|{Content-Length=[3];X-Folded=[a b];X-Lower=[v]}|cl=3|te=|close=true|tr={}|zz\r"
  assert_eq rresp("HTTP/1.1 204 No Content\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "204|204 No Content|HTTP/1.1 1.1|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("FOO 404\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1  200 OK\r\nContent-Length: 0\r\nTrailer: a, b\r\nCache-Control: max-age=1\r\n\r\nzz\r\n", false), "200|200 OK|HTTP/1.1 1.1|{Cache-Control=[max-age=1];Content-Length=[0];Trailer=[a, b]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x 302 Found\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.x 404\r\nX-Dup: 1\r\nTrailer: a, b\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/2.0 101 Switching\r\nConnection: keep-alive\r\nTrailer: Content-Length\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "101|101 Switching|HTTP/2.0 2.0|{Connection=[keep-alive];Trailer=[Content-Length]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 abc OK\r\nX-Sp : v\r\nX-Empty:\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", true), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.x 101 Switching\r\nPragma: no-cache\r\nX-Empty:\r\nbad header\r\nCache-Control: max-age=1\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 200\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "200|200|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/2.0  200 OK\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.2 204 No Content\r\n\r\nhello", false), "204|204 No Content|HTTP/1.2 1.2|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("FOO 200\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 404\r\nHost: x\r\n\r\nhello", false), "404|404|HTTP/1.2 1.2|{Host=[x]}|cl=-1|te=|close=true|tr={}|hello"
  assert_eq rresp("HTTP/2.0 204 No Content\r\n\r\n5\r\nhel", false), "204|204 No Content|HTTP/2.0 2.0|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.0 200 OK\r\nConnection: Upgrade, Close\r\nX-Folded: a\r\n b\r\nTrailer: a, b\r\nTrailer: Content-Length\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO 302 Found\r\nTrailer: a, b\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0 204 No Content\r\nContent-Length: 5\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "204|204 No Content|HTTP/2.0 2.0|{Content-Length=[5]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("FOO  200 OK\r\nTransfer-Encoding: chunked, gzip\r\nContent-Length: 0\r\n\r\nhello", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 200\r\nTransfer-Encoding: gzip\r\nCache-Control: max-age=1\r\nContent-Length: 3\r\n\r\nhello world", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.x  200 OK\r\nTransfer-Encoding: gzip\r\nX-Sp : v\r\nCache-Control: max-age=1\r\nPragma: no-cache\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("FOO 304 Not Modified\r\nTrailer: X-T\r\nX-Dup: 2\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.0  200 OK\r\nContent-Length: 5\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.0 abc OK\r\nContent-Length: 05\r\nContent-Length: 3\r\n\r\nhello", true), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.0 404\r\nHost: y.com:80\r\nContent-Length: 0\r\n\r\n", false), "404|404|HTTP/1.0 1.0|{Content-Length=[0];Host=[y.com:80]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.2 200\r\nX-Folded: a\r\n b\r\nContent-Length: -1\r\nContent-Length: 0\r\nPragma: no-cache\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"-1\" \"0\"]"
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\nTrailer: X-T\r\nContent-Length: 0\r\nHost: y.com:80\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.x -12 x\r\nbad header\r\nTrailer: Content-Length\r\nContent-Length: -1\r\n\r\nhello", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2 2000 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: -1\r\nCache-Control: max-age=1\r\n\r\nzz\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.2 200\r\nConnection: keep-alive\r\nTransfer-Encoding: Chunked\r\nTrailer: Content-Length\r\n\r\n5\r\nhel", false), "ERR bad trailer key \"Content-Length\""
  assert_eq rresp("HTTP/2.0  200 OK\r\nTransfer-Encoding: Chunked\r\nHost: y.com:80\r\nConnection: close\r\nX-Folded: a\r\n b\r\n\r\n1\r\nab\r\n0\r\n\r\n", true), "200|200 OK|HTTP/2.0 2.0|{Host=[y.com:80];X-Folded=[a b]}|cl=-1|te=chunked|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 -12 x\r\nPragma: no-cache\r\nX-Dup: 1\r\nContent-Length: 5\r\nExpect: 100-continue\r\n\r\n5\nhello\n0\n\n", true), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.0 101 Switching\r\nHost: y.com:80\r\n\r\n5\nhello\n0\n\n", false), "101|101 Switching|HTTP/1.0 1.0|{Host=[y.com:80]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.2 200 OK\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.2 1.2|{}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 abc OK\r\nHost: x\r\nContent-Length:\r\nx-lower: v\r\nExpect: 100-continue\r\n\r\n5\r\nhello\r\n0\r\n\r\n", true), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.x 200\r\nTrailer: a, b\r\nX-Dup: 2\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.2 200 OK\r\nX-Dup: 1\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.2 1.2|{X-Dup=[1]}|cl=-1|te=|close=true|tr={}|1\r\nab\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 404\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "404|404|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.0 404\r\n\r\nhello", false), "404|404|HTTP/1.0 1.0|{}|cl=-1|te=|close=true|tr={}|hello"
  assert_eq rresp("HTTP/1.0  200 OK\r\nX-Dup: 2\r\nContent-Length: 3\r\nTransfer-Encoding: gzip\r\n\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.0 1.0|{Content-Length=[3];X-Dup=[2]}|cl=3|te=|close=true|tr={}|0\r\n"
  assert_eq rresp("FOO 2000 OK\r\nTransfer-Encoding: Chunked\r\nX-Sp : v\r\nTransfer-Encoding: gzip\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 abc OK\r\nX-Sp : v\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.x abc OK\r\nCache-Control: max-age=1\r\nConnection: keep-alive\r\nContent-Length: -1\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("FOO abc OK\r\nTransfer-Encoding: chunked\r\nX-Dup: 1\r\nContent-Length: 05\r\n\r\nhello world", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nConnection: Upgrade, Close\r\n\r\n5\nhello\n0\n\n", false), "101|101 Switching|HTTP/1.1 1.1|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("FOO -12 x\r\nContent-Length: 0\r\nExpect: 100-continue\r\nContent-Length: 5\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nContent-Length:\r\nExpect: 100-continue\r\nTransfer-Encoding: gzip\r\n\r\nzz\r\n", true), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.0  200 OK\r\nExpect: 100-continue\r\n\r\n5\r\nhel", false), "200|200 OK|HTTP/1.0 1.0|{Expect=[100-continue]}|cl=-1|te=|close=true|tr={}|5\r\nhel"
  assert_eq rresp("HTTP/1.2 200 OK\r\nHost: x\r\nTransfer-Encoding: chunked\r\nX-Dup: 1\r\nx-lower: v\r\n\r\n5\r\nhel", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nConnection: Upgrade, Close\r\n\r\n0\r\n\r\n", false), "500|500 Internal Server Error|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|0\r\n\r\n"
  assert_eq rresp("HTTP/2.0 404\r\nContent-Length:\r\nX-Dup: 2\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("FOO 302 Found\r\nTrailer: a, b\r\nCache-Control: max-age=1\r\nX-Sp : v\r\nContent-Length: 5\r\n\r\nhello world", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 404\r\nExpect: 100-continue\r\n", true), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 404\r\nContent-Length: -1\r\nContent-Length: 05\r\n\r\n5\r\nhel", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"-1\" \"05\"]"
  assert_eq rresp("HTTP/1.2 101 Switching\r\nX-Dup: 2\r\nConnection: close\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "101|101 Switching|HTTP/1.2 1.2|{X-Dup=[2]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 -12 x\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("FOO  200 OK\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0 204 No Content\r\nConnection: keep-alive\r\nX-Dup: 1\r\nTrailer: a, b\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "204|204 No Content|HTTP/2.0 2.0|{Connection=[keep-alive];Trailer=[a, b];X-Dup=[1]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("FOO 101 Switching\r\nTransfer-Encoding: chunked\r\nContent-Length: 05\r\nContent-Length: -1\r\nExpect: 100-continue\r\n\r\nzz\r\n", true), "ERR malformed HTTP version \"FOO\""
}

test "vectors: read response 6" {
  assert_eq rresp("HTTP/1.x 404\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 -12 x\r\nTransfer-Encoding: Chunked\r\nTrailer: Content-Length\r\n\r\n5\r\nhel", true), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nX-Empty:\r\nX-Empty:\r\nTransfer-Encoding: chunked\r\n\r\nhello", false), "304|304 Not Modified|HTTP/1.1 1.1|{X-Empty=[|]}|cl=0|te=chunked|close=false|tr={}|"
  assert_eq rresp("HTTP/2.0 204 No Content\r\nContent-Length: 0\r\nCache-Control: max-age=1\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO 302 Found\r\nTransfer-Encoding: chunked, gzip\r\n\r\nzz\r\n", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2  200 OK\r\nTransfer-Encoding: gzip\r\n\r\n", false), "ERR unsupported transfer encoding: \"gzip\""
  assert_eq rresp("HTTP/1.0 -12 x\r\nHost: x\r\n\r\nhello world", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1  200 OK\r\nTrailer: a, b\r\n\r\nzz\r\n", true), "200|200 OK|HTTP/1.1 1.1|{Trailer=[a, b]}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x  200 OK\r\nx-lower: v\r\nContent-Length: 5\r\nContent-Length:\r\n\r\n5\r\nhel", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.2 204 No Content\r\nTrailer: Content-Length\r\nConnection: close\r\nExpect: 100-continue\r\nContent-Length: 05\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "204|204 No Content|HTTP/1.2 1.2|{Content-Length=[05];Expect=[100-continue];Trailer=[Content-Length]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 2000 OK\r\nX-Folded: a\r\n b\r\nX-Dup: 2\r\nContent-Length: 05\r\nContent-Length: -1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("FOO 204 No Content\r\nConnection: keep-alive\r\nX-Empty:\r\nContent-Length: 3\r\nTransfer-Encoding: chunked, gzip\r\n\r\nzz\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.0 200 OK\r\nX-Sp : v\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "200|200 OK|HTTP/1.0 1.0|{X-Sp =[v]}|cl=-1|te=|close=true|tr={}|A\r\n0123456789\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.x 200 OK\r\nCache-Control: max-age=1\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.2 302 Found\r\nHost: y.com:80\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO abc OK\r\n\r\nzz\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.2 200 OK\r\nHost: x\r\nCache-Control: max-age=1\r\nContent-Length: 05\r\nTrailer: X-T\r\n\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/2.0  200 OK\r\nContent-Length: -1\r\nContent-Length:\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO 200 OK\r\nConnection: Upgrade, Close\r\nContent-Length: 0\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 2000 OK\r\n\r\nzz\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.2 abc OK\r\nConnection: close\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/2.0 101 Switching\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO abc OK\r\nTransfer-Encoding: Chunked\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.0 2000 OK\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.x  200 OK\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("FOO 200\r\nTransfer-Encoding: chunked\r\nHost: y.com:80\r\nX-Empty:\r\nX-Dup: 2\r\n\r\n1\r\nab\r\n0\r\n\r\n", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 -12 x\r\nX-Dup: 2\r\nConnection: Upgrade, Close\r\nConnection: Upgrade, Close\r\nX-Dup: 1\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2 -12 x\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", true), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 -12 x\r\nPragma: no-cache\r\nContent-Length: 05\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2 abc OK\r\nConnection: Upgrade, Close\r\nPragma: no-cache\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/2.0 2000 OK\r\nX-Dup: 1\r\nContent-Length: 3\r\nX-Dup: 1\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.2 101 Switching\r\nContent-Length: 3\r\n\r\n0\r\n\r\n", false), "101|101 Switching|HTTP/1.2 1.2|{Content-Length=[3]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x -12 x\r\nX-Sp : v\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.x 304 Not Modified\r\nX-Dup: 2\r\nbad header\r\nContent-Length:\r\nContent-Length: 05\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/2.0 101 Switching\r\nContent-Length: -1\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR too many transfer encodings: [\"Chunked\" \"chunked\"]"
  assert_eq rresp("HTTP/2.0 200\r\nTransfer-Encoding: chunked\r\n\r\nhello world", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 302 Found\r\nX-Sp : v\r\n\r\n0\r\n\r\n", false), "302|302 Found|HTTP/1.1 1.1|{X-Sp =[v]}|cl=-1|te=|close=true|tr={}|0\r\n\r\n"
  assert_eq rresp("HTTP/2.0  200 OK\r\nContent-Length: 0\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 -12 x\r\nHost: x\r\nTransfer-Encoding: Chunked\r\nX-Sp : v\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1  200 OK\r\nConnection: Upgrade, Close\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "200|200 OK|HTTP/1.1 1.1|{}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"
  assert_eq rresp("FOO  200 OK\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 302 Found\r\nTransfer-Encoding: chunked, gzip\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO 500 Internal Server Error\r\nX-Folded: a\r\n b\r\nHost: y.com:80\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", true), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("FOO 302 Found\r\nX-Sp : v\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nTransfer-Encoding: chunked, gzip\r\nTransfer-Encoding: Chunked\r\nTransfer-Encoding: gzip\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR too many transfer encodings: [\"chunked, gzip\" \"Chunked\" \"gzip\"]"
  assert_eq rresp("FOO -12 x\r\nContent-Length: 5\r\nX-Folded: a\r\n b\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/2.0 304 Not Modified\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "304|304 Not Modified|HTTP/2.0 2.0|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.2 200\r\nX-Dup: 1\r\nTrailer: a, b\r\nX-Sp : v\r\nCache-Control: max-age=1\r\n\r\nzz\r\n", false), "200|200|HTTP/1.2 1.2|{Cache-Control=[max-age=1];Trailer=[a, b];X-Dup=[1];X-Sp =[v]}|cl=-1|te=|close=true|tr={}|zz\r\n"
  assert_eq rresp("HTTP/1.1 101 Switching\r\nConnection: Upgrade, Close\r\nContent-Length: 5\r\nTrailer: X-T\r\nTrailer: Content-Length\r\n\r\n0\r\n\r\n", false), "101|101 Switching|HTTP/1.1 1.1|{Content-Length=[5];Trailer=[X-T|Content-Length]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked, gzip\r\nConnection: close\r\nX-Empty:\r\nContent-Length:\r\n\r\nzz\r\n", true), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nConnection: keep-alive\r\n\r\nzz\r\n", false), "101|101 Switching|HTTP/1.1 1.1|{Connection=[keep-alive]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 200\r\nContent-Length: 3\r\nTransfer-Encoding: chunked, gzip\r\nX-Folded: a\r\n b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("FOO 302 Found\r\nTransfer-Encoding: chunked, gzip\r\nTransfer-Encoding: gzip\r\nHost: x\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 -12 x\r\nHost: x\r\nConnection: Upgrade, Close\r\nX-Dup: 2\r\nx-lower: v\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.2 404\r\nTrailer: a, b\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "404|404|HTTP/1.2 1.2|{Trailer=[a, b]}|cl=-1|te=|close=true|tr={}|3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n"
  assert_eq rresp("HTTP/1.1 101 Switching\r\nX-Dup: 1\r\nX-Dup: 2\r\n\r\nhello world", false), "101|101 Switching|HTTP/1.1 1.1|{X-Dup=[1|2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/2.0 200 OK\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("FOO abc OK\r\nTrailer: X-T\r\nTrailer: a, b\r\nX-Empty:\r\nX-Dup: 1\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nx-lower: v\r\nContent-Length: 5\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "304|304 Not Modified|HTTP/1.1 1.1|{Content-Length=[5];X-Lower=[v]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/2.0 -12 x\r\nX-Dup: 2\r\nX-Sp : v\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.1 101 Switching\r\nX-Dup: 2\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "101|101 Switching|HTTP/1.1 1.1|{X-Dup=[2]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 2000 OK\r\nX-Dup: 2\r\nConnection: keep-alive\r\nX-Empty:\r\nExpect: 100-continue\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/2.0  200 OK\r\nX-Dup: 2\r\n\r\nhello", false), "200|200 OK|HTTP/2.0 2.0|{X-Dup=[2]}|cl=-1|te=|close=true|tr={}|hello"
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nHost: y.com:80\r\nContent-Length: 0\r\nPragma: no-cache\r\nContent-Length:\r\n\r\n5\nhello\n0\n\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"0\" \"\"]"
  assert_eq rresp("HTTP/1.2 500 Internal Server Error\r\nConnection: keep-alive\r\n\r\n5\nhello\n0\n\n", false), "500|500 Internal Server Error|HTTP/1.2 1.2|{Connection=[keep-alive]}|cl=-1|te=|close=true|tr={}|5\nhello\n0\n\n"
  assert_eq rresp("HTTP/1.1 2000 OK\r\nTransfer-Encoding: chunked, gzip\r\nX-Sp : v\r\nContent-Length: -1\r\n\r\n5\r\nhel", true), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked, gzip\r\nTrailer: a, b\r\nConnection: keep-alive\r\nConnection: keep-alive\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.1 304 Not Modified\r\nConnection: close\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "304|304 Not Modified|HTTP/1.1 1.1|{}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.1 101 Switching\r\n\r\n0\r\n\r\n", true), "101|101 Switching|HTTP/1.1 1.1|{}|cl=-1|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nTransfer-Encoding: Chunked\r\nConnection: Upgrade, Close\r\nConnection: Upgrade, Close\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR too many transfer encodings: [\"Chunked\" \"chunked\"]"
  assert_eq rresp("FOO 500 Internal Server Error\r\nX-Empty:\r\nTrailer: a, b\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 2000 OK\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.2 101 Switching\r\nContent-Length: 05\r\nCache-Control: max-age=1\r\n\r\n", false), "101|101 Switching|HTTP/1.2 1.2|{Cache-Control=[max-age=1];Content-Length=[05]}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("HTTP/1.x 302 Found\r\nConnection: close\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.1 abc OK\r\nPragma: no-cache\r\nHost: x\r\nTransfer-Encoding: chunked, gzip\r\nbad header\r\n\r\n5\r\nhel", true), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.2 200\r\nContent-Length:\r\nContent-Length: 0\r\nHost: x\r\nX-Folded: a\r\n b\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"\" \"0\"]"
  assert_eq rresp("FOO  200 OK\r\nHost: y.com:80\r\nTransfer-Encoding: gzip\r\nConnection: close\r\n\r\nhello", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.x 2000 OK\r\nTransfer-Encoding: gzip\r\n\r\nhello world", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.0 204 No Content\r\nbad header\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed MIME header: missing colon: \"bad header\""
  assert_eq rresp("HTTP/1.x abc OK\r\nContent-Length:\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.0 200 OK\r\nX-Dup: 2\r\nContent-Length: -1\r\n\r\n0\r\n\r\n", false), "ERR bad Content-Length \"-1\""
  assert_eq rresp("HTTP/1.0 2000 OK\r\nTrailer: X-T\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 -12 x\r\nConnection: Upgrade, Close\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", true), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("FOO 500 Internal Server Error\r\nTransfer-Encoding: chunked, gzip\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.0 200 OK\r\nContent-Length:\r\nTransfer-Encoding: chunked, gzip\r\nTransfer-Encoding: Chunked\r\nTrailer: Content-Length\r\n\r\n5\nhello\n0\n\n", false), "ERR invalid empty Content-Length \"\""
  assert_eq rresp("HTTP/1.1 -12 x\r\nCache-Control: max-age=1\r\nConnection: Upgrade, Close\r\nContent-Length: 3\r\nConnection: close\r\n\r\nhello world", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/2.0 204 No Content\r\nContent-Length: -1\r\nTransfer-Encoding: chunked, gzip\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "ERR unsupported transfer encoding: \"chunked, gzip\""
  assert_eq rresp("HTTP/1.2 404\r\n\r\n5\nhello\n0\n\n", false), "404|404|HTTP/1.2 1.2|{}|cl=-1|te=|close=true|tr={}|5\nhello\n0\n\n"
  assert_eq rresp("HTTP/1.x 500 Internal Server Error\r\nConnection: keep-alive\r\nContent-Length: 0\r\nConnection: close\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.2  200 OK\r\nx-lower: v\r\nTrailer: Content-Length\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "200|200 OK|HTTP/1.2 1.2|{Trailer=[Content-Length];X-Lower=[v]}|cl=-1|te=|close=true|tr={}|5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n"
  assert_eq rresp("HTTP/1.x  200 OK\r\nPragma: no-cache\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.2 101 Switching\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", false), "101|101 Switching|HTTP/1.2 1.2|{}|cl=0|te=|close=false|tr={}|"
  assert_eq rresp("FOO abc OK\r\nTransfer-Encoding: gzip\r\nHost: x\r\nTrailer: X-T\r\nX-Dup: 1\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/2.0 101 Switching\r\nContent-Length: 3\r\nCache-Control: max-age=1\r\nContent-Length: 5\r\nX-Sp : v\r\n\r\n5\nhello\n0\n\n", false), "ERR http: message cannot contain multiple Content-Length headers; got [\"3\" \"5\"]"
  assert_eq rresp("HTTP/1.0 500 Internal Server Error\r\nCache-Control: max-age=1\r\nContent-Length: 05\r\nTransfer-Encoding: chunked, gzip\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "500|500 Internal Server Error|HTTP/1.0 1.0|{Cache-Control=[max-age=1];Content-Length=[05]}|cl=5|te=|close=true|tr={}|3;ext"
  assert_eq rresp("HTTP/2.0 abc OK\r\nHost: x\r\nTransfer-Encoding: chunked, gzip\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/1.1 500 Internal Server Error\r\nX-Dup: 1\r\nContent-Length:\r\nx-lower: v\r\n", false), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.x 302 Found\r\nContent-Length: -1\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("HTTP/1.0 200\r\nTrailer: Content-Length\r\n", true), "ERR unexpected EOF"
  assert_eq rresp("HTTP/1.1 101 Switching\r\nTrailer: X-T\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\nX-T: tv\r\n\r\n", true), "101|101 Switching|HTTP/1.1 1.1|{Content-Length=[3]}|cl=3|te=chunked|close=false|tr={X-T=[]}|"
}

test "vectors: read response 7" {
  assert_eq rresp("HTTP/2.0 404\r\nPragma: no-cache\r\nTransfer-Encoding: chunked\r\nX-Dup: 2\r\nContent-Length: 05\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed chunked encoding"
  assert_eq rresp("HTTP/2.0 abc OK\r\nX-Sp : v\r\n\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"abc\""
  assert_eq rresp("HTTP/2.0 -12 x\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.0 -12 x\r\nX-Dup: 1\r\n\r\n3;ext=1\r\nabc\r\n2 \r\nde\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"-12\""
  assert_eq rresp("HTTP/1.0 2000 OK\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.x 101 Switching\r\nX-Sp : v\r\nTransfer-Encoding: chunked, gzip\r\nbad header\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\n\r\n", true), "ERR malformed HTTP version \"HTTP/1.x\""
  assert_eq rresp("FOO 101 Switching\r\nConnection: keep-alive\r\nX-Empty:\r\nConnection: keep-alive\r\nX-Empty:\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.2 2000 OK\r\nContent-Length: -1\r\nConnection: keep-alive\r\n\r\n5\r\nhel", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("FOO  200 OK\r\nContent-Length: 0\r\nTrailer: a, b\r\nContent-Length: 5\r\n\r\n1\r\nab\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/1.0 2000 OK\r\nConnection: close\r\nContent-Length: 0\r\nX-Folded: a\r\n b\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP status code \"2000\""
  assert_eq rresp("HTTP/1.1 302 Found\r\nContent-Length: 5\r\nHost: y.com:80\r\nHost: x\r\nContent-Length: 05\r\n\r\nzz\r\n", true), "ERR http: message cannot contain multiple Content-Length headers; got [\"5\" \"05\"]"
  assert_eq rresp("FOO 304 Not Modified\r\nContent-Length: 5\r\nHost: y.com:80\r\n\r\n5\nhello\n0\n\n", false), "ERR malformed HTTP version \"FOO\""
  assert_eq rresp("HTTP/2.0 101 Switching\r\nContent-Length: 5\r\nConnection: Upgrade, Close\r\n\r\n", false), "101|101 Switching|HTTP/2.0 2.0|{Content-Length=[5]}|cl=0|te=|close=true|tr={}|"
  assert_eq rresp("HTTP/1.x 200 OK\r\nConnection: Upgrade, Close\r\n\r\n5\r\nhello\r\n0\r\n\r\n", false), "ERR malformed HTTP version \"HTTP/1.x\""
}
