# Writing requests and responses in HTTP/1.1 wire format, after Go's
# Request.Write / WriteProxy, Response.Write and transfer.go's
# transferWriter.
#
# The body model: alx's Request and Response carry their whole body as
# bytes, so Go's "nil Body" is an empty body here, and content_length follows
# Go's ContentLength (0 with a non-empty body: unknown; -1: unknown).
import "io"
import "strings"
import "strconv"
import "net/textproto"
import nurl "net/url"

# The User-Agent write_request sends when the request has none (Go:
# "Go-http-client/1.1"; alx's client sends this one too).
pub DEFAULT_USER_AGENT = "alx-http/1"

def chunked_te?(te: [Str]) -> Bool {
  te.size > 0 && te[0] == "chunked"
}

def identity_te?(te: [Str]) -> Bool {
  te.size == 1 && te[0] == "identity"
}

def lacks_body_method?(m: Str) -> Bool {
  m == "GET" || m == "HEAD" || m == "DELETE" || m == "OPTIONS" || m == "PROPFIND" || m == "SEARCH"
}

# Go's transferWriter, for one message.
struct WireTransfer {
  method: Str
  body: [Byte]
  has_body: Bool
  response_to_head: Bool
  content_length: Int
  close: Bool
  te: [Str]
  header: Header
  trailer: Header
  has_trailer: Bool
  # Go read the body's first byte to see whether it was empty, so its
  # chunked copy starts with a one-byte chunk.
  probed: Bool

  def should_send_content_length -> Bool {
    return false if chunked_te?(te)
    return true if content_length > 0
    return false if content_length < 0
    return true if method == "POST" || method == "PUT" || method == "PATCH"
    if content_length == 0 && identity_te?(te) {
      return false if method == "GET" || method == "HEAD"
      return true
    }
    false
  }

  def write_header(b: strings.Builder) -> ~Unit {
    out = b
    if close && !has_token?(header.get("Connection"), "close") {
      out.write!("Connection: close\r\n")
    }
    if should_send_content_length {
      out.write!("Content-Length: #{content_length}\r\n")
    } else if chunked_te?(te) {
      out.write!("Transfer-Encoding: chunked\r\n")
    }
    if has_trailer {
      keys: [Str] = []
      for k0 in trailer.keys {
        k = canonical_header_key(k0)
        if k == "Transfer-Encoding" || k == "Trailer" || k == "Content-Length" {
          fail "invalid Trailer key #{strconv.quote(k)}"
        }
        keys << k
      }
      if keys.size > 0 {
        out.write!("Trailer: " + strings.join(keys.sort, ",") + "\r\n")
      }
    }
  }

  def write_body(b: strings.Builder) -> ~Unit {
    out = b
    ncopy = 0
    if !response_to_head && has_body {
      if chunked_te?(te) {
        rest = body
        if probed && rest.size > 1 {
          out.write!("1\r\n" + Str.from_bytes(rest[0...1]) + "\r\n")
          rest = rest[1...rest.size]
        }
        if rest.size > 0 {
          out.write!(strconv.format_int(rest.size, 16) + "\r\n")
          out.write!(Str.from_bytes(rest))
          out.write!("\r\n")
        }
        out.write!("0\r\n")
      } else if content_length == -1 {
        out.write!(Str.from_bytes(body))
        ncopy = body.size
      } else {
        n = content_length < body.size ? content_length : body.size
        out.write!(Str.from_bytes(body[0...n]))
        ncopy = body.size
      }
    }
    if !response_to_head && content_length != -1 && content_length != ncopy {
      fail "http: content_length=#{content_length} with body length #{ncopy}"
    }
    if !response_to_head && chunked_te?(te) {
      out.write!(trailer.wire_subset([])) if has_trailer
      out.write!("\r\n")
    }
  }
}

# Go's validateHeaders on a trailer: "" or what's wrong.
def invalid_trailer(h: Header) -> Str {
  for k in h.keys {
    return "field name #{strconv.quote(k)}" unless valid_header_field_name?(k)
    for v in h.raw(k) || [] {
      return "field value for #{strconv.quote(k)}" unless valid_header_field_value?(v)
    }
  }
  ""
}

def finish_transfer(t0: WireTransfer, at_least_11: Bool) -> ~WireTransfer {
  t = t0
  if t.response_to_head {
    t.has_body = false
    t.content_length = -1 if chunked_te?(t.te)
  } else {
    if !at_least_11 || !t.has_body {
      t.te = []
    }
    if chunked_te?(t.te) {
      t.content_length = -1
    } else if !t.has_body {
      t.content_length = 0
    }
  }
  t.has_trailer = false unless chunked_te?(t.te)
  if t.has_trailer {
    bad = invalid_trailer(t.trailer)
    fail "net/http: invalid trailer #{bad}" if bad.size > 0
  }
  t
}

def request_transfer(r: Request) -> ~WireTransfer {
  has_body = r.body.size > 0
  method = r.method == "" ? "GET" : r.method
  # Go's outgoingLength
  cl = !has_body ? 0 : (r.content_length != 0 ? r.content_length : -1)
  fail "http: Request.content_length=#{r.content_length} with no body" if r.content_length > 0 && !has_body
  te = r.transfer_encoding
  if cl < 0 && te.size == 0 && has_body && method != "CONNECT" {
    te = ["chunked"]
  }
  t = WireTransfer.new(method: method, body: r.body, has_body: has_body, response_to_head: false, content_length: cl, close: r.close, te: te, header: r.header, trailer: r.trailer, has_trailer: r.trailer.size > 0, probed: r.content_length == 0 && has_body && r.transfer_encoding.size == 0 && lacks_body_method?(method))
  ~finish_transfer(t, true)
}

# "[fe80::1%en0]:80" -> "[fe80::1]:80" (Go's removeZone).
def remove_zone(host: Str) -> Str {
  return host unless strings.has_prefix(host, "[")
  i = strings.last_index(host, "]")
  return host if i < 0
  j = strings.last_index(host[0...i], "%")
  return host if j < 0
  host[0...j] + host[i...host.size]
}

def has_ctl_byte?(s: Str) -> Bool {
  for c in s.bytes {
    return true if c < 32 || c == 0x7F
  }
  false
}

def request_wire(r: Request, using_proxy: Bool, head_only: Bool) -> ~Str {
  pr = nurl.parse(r.url)
  fail "http: invalid Request URL: #{pr.err.unwrap.message}" if pr.err?
  u = pr.unwrap
  host = r.host
  host = u.host if host == ""
  if !valid_host_header?(host) {
    fail "http: invalid Host header" if using_proxy
    host = ""
  }
  host = remove_zone(host)
  ruri = u.request_uri
  method = r.method == "" ? "GET" : r.method
  if using_proxy && u.scheme != "" && u.opaque == "" {
    ruri = u.scheme + "://" + host + ruri
  } else if method == "CONNECT" && u.path == "" {
    ruri = u.opaque != "" ? u.opaque : host
  }
  fail "net/http: can't write control character in Request.url" if has_ctl_byte?(ruri)
  b = strings.new_builder
  b.write!("#{method} #{ruri} HTTP/1.1\r\n")
  b.write!("Host: #{host}\r\n")
  ua = DEFAULT_USER_AGENT
  ua = r.header.get("User-Agent") if r.header.has?("User-Agent")
  if ua != "" {
    b.write!("User-Agent: " + textproto.trim_string(clean(ua)) + "\r\n")
  }
  t = ~request_transfer(r)
  ~t.write_header(b)
  b.write!(r.header.wire_subset(["Host", "User-Agent", "Content-Length", "Transfer-Encoding", "Trailer"]))
  b.write!("\r\n")
  return b.to_s if head_only
  ~t.write_body(b)
  b.to_s
}

# Writes r as an HTTP/1.1 client request (Go's Request.Write): the request
# line with the URL's request URI, Host, User-Agent (DEFAULT_USER_AGENT
# unless the header has one; an empty one leaves it out), the framing headers
# (Content-Length, or chunked coding when the length is unknown), the rest of
# the header sorted, and the body. Nothing is written if it fails.
pub def write_request(r: Request, w: io.Writer) -> ~Unit {
  s = ~request_wire(r, false, false)
  out = w
  out.~write!(s.bytes.to_a)
  return
}

# Like write_request, in the form a proxy expects: an absolute URI in the
# request line (Go's WriteProxy).
pub def write_proxy_request(r: Request, w: io.Writer) -> ~Unit {
  s = ~request_wire(r, true, false)
  out = w
  out.~write!(s.bytes.to_a)
  return
}

# The wire form of r (write_request into a string).
pub def request_bytes(r: Request) -> ~Str {
  ~request_wire(r, false, false)
}

def response_wire(r: Response, head_only: Bool, body_set: Bool) -> ~Str {
  major = 0
  minor = 0
  if v = parse_http_version(r.proto) {
    major, minor = v
  }
  text = r.status_text
  if text == "" {
    text = status_text(r.status)
    text = "status code #{r.status}" if text == ""
  } else {
    text = strings.trim_prefix(text, "#{r.status} ")
  }
  b = strings.new_builder
  b.write!(format("HTTP/%d.%d %03d %s\r\n", major, minor, r.status, text))
  has_body = body_set || r.body.size > 0
  cl = r.content_length
  # Go probes a body whose ContentLength is 0: it's empty, or of unknown length.
  cl = -1 if cl == 0 && r.body.size > 0
  close = r.close
  at_least_11 = major > 1 || (major == 1 && minor >= 1)
  if cl == -1 && !close && at_least_11 && !chunked_te?(r.transfer_encoding) {
    close = true
  }
  method = r.request_method
  t = WireTransfer.new(method: method, body: r.body, has_body: has_body, response_to_head: method == "HEAD", content_length: cl, close: close, te: r.transfer_encoding, header: r.header, trailer: r.trailer, has_trailer: r.trailer.size > 0, probed: r.content_length == 0 && r.body.size > 0)
  t = ~finish_transfer(t, at_least_11)
  ~t.write_header(b)
  b.write!(r.header.wire_subset(["Content-Length", "Transfer-Encoding", "Trailer"]))
  if cl == 0 && !chunked_te?(r.transfer_encoding) && !t.should_send_content_length && body_allowed_for_status?(r.status) {
    b.write!("Content-Length: 0\r\n")
  }
  b.write!("\r\n")
  return b.to_s if head_only
  ~t.write_body(b)
  b.to_s
}

# Writes r as an HTTP/1.x server response (Go's Response.Write): status
# line, framing headers (Content-Length, chunked coding, or Connection:
# close for an HTTP/1.1 body of unknown length), the header sorted, the body
# and a chunked body's trailer. A response to HEAD (request_method) has no
# body. Nothing is written if it fails.
pub def write_response(r: Response, w: io.Writer) -> ~Unit {
  s = ~response_wire(r, false, false)
  out = w
  out.~write!(s.bytes.to_a)
  return
}

# The wire form of r (write_response into a string).
pub def response_bytes(r: Response) -> ~Str {
  ~response_wire(r, false, false)
}

# What write_request writes up to and including the blank line after the
# header (framing as for r's body, which isn't written or checked).
pub def request_head(r: Request) -> ~Str {
  ~request_wire(r, false, true)
}

# What write_response writes up to and including the blank line after the
# header (framing as for r's body, which isn't written or checked).
pub def response_head(r: Response) -> ~Str {
  ~response_wire(r, true, false)
}

# Go's Response.Write output with Go's distinction between a nil and an
# empty Body: `body_set` says the body is there even when it's empty (it
# then frames as Go's non-nil empty body). `head_only` stops after the
# header (httputil's dumps).
pub def response_wire_form(r: Response, body_set: Bool, head_only: Bool) -> ~Str {
  ~response_wire(r, head_only, body_set)
}
