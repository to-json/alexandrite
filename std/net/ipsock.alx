# Host:port strings (Go's ipsock.go).

# Go's SplitHostPort: "host:port", "host%zone:port", "[host]:port" or
# "[host%zone]:port" into host (or host%zone) and port.
pub def split_host_port(hostport: Str) -> ~(Str, Str)<AddrError> {
  missing_port = "missing port in address"
  too_many_colons = "too many colons in address"
  j = 0
  k = 0
  i = last_byte(hostport, 58)
  fail addr_error(missing_port, hostport) if i < 0
  host = ""
  if hostport[0] == 91 {
    end = index_byte(hostport, 93)
    fail addr_error("missing ']' in address", hostport) if end < 0
    if end + 1 == hostport.size {
      fail addr_error(missing_port, hostport)
    } elsif end + 1 != i {
      fail addr_error(too_many_colons, hostport) if hostport[end + 1] == 58
      fail addr_error(missing_port, hostport)
    }
    host = hostport[1...end]
    j = 1
    k = end + 1
  } else {
    host = hostport[0...i]
    fail addr_error(too_many_colons, hostport) if index_byte(host, 58) >= 0
  }
  fail addr_error("unexpected '[' in address", hostport) if index_byte(hostport[j...hostport.size], 91) >= 0
  fail addr_error("unexpected ']' in address", hostport) if index_byte(hostport[k...hostport.size], 93) >= 0
  (host, hostport[i + 1...hostport.size])
}

# Go's JoinHostPort: a host with a colon (an IPv6 literal) gets brackets.
pub def join_host_port(host: Str, port: Str) -> Str {
  return "[" + host + "]:" + port if index_byte(host, 58) >= 0
  host + ":" + port
}

def index_byte(s: Str, c: Byte) -> Int {
  for i in 0...s.size {
    return i if s[i] == c
  }
  -1
}

def last_byte(s: Str, c: Byte) -> Int {
  i = s.size - 1
  while i >= 0 {
    return i if s[i] == c
    i -= 1
  }
  -1
}
