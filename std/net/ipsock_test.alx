# Go's ipsock_test.go, translated.

def ia(ip: IP, zone: Str = "") -> IPAddr { IPAddr.new(ip: ip, zone: zone) }

def ta(ip: IP, zone: Str = "") -> Addr { TCPAddr.new(ip: ip, port: 5682, zone: zone) }

def addrs_s(addrs: [Addr]) -> Str { addrs.map { it.to_s }.to_a.join(" ") }

test "AddrList" {
  if supports_ipv4? && supports_ipv6? {
    fe = pip("fe80::1")
    l4 = ipv4(127, 0, 0, 1)
    p4 = ipv4(192, 168, 0, 1)
    l6 = ipv6_loopback
    none_a: [Addr] = []
    none_i: [IPAddr] = []
    tests: [(Int, [IPAddr], Addr?, [Addr], [Addr], Bool)] = [
      (0, [ia(l4), ia(l6)], ta(l4), [ta(l4)], [ta(l6)], false),
      (0, [ia(l6), ia(l4)], ta(l4), [ta(l6)], [ta(l4)], false),
      (0, [ia(l4), ia(p4)], ta(l4), [ta(l4), ta(p4)], none_a, false),
      (0, [ia(l6), ia(fe, "eth0")], ta(l6), [ta(l6), ta(fe, "eth0")], none_a, false),
      (0, [ia(l4), ia(p4), ia(l6), ia(fe, "eth0")], ta(l4), [ta(l4), ta(p4)], [ta(l6), ta(fe, "eth0")], false),
      (0, [ia(l6), ia(fe, "eth0"), ia(l4), ia(p4)], ta(l4), [ta(l6), ta(fe, "eth0")], [ta(l4), ta(p4)], false),
      (0, [ia(l4), ia(l6), ia(p4), ia(fe, "eth0")], ta(l4), [ta(l4), ta(p4)], [ta(l6), ta(fe, "eth0")], false),
      (0, [ia(l6), ia(l4), ia(fe, "eth0"), ia(p4)], ta(l4), [ta(l6), ta(fe, "eth0")], [ta(l4), ta(p4)], false),
      (4, [ia(l4), ia(l6)], ta(l4), [ta(l4)], none_a, false),
      (4, [ia(l6), ia(l4)], ta(l4), [ta(l4)], none_a, false),
      (6, [ia(l4), ia(l6)], ta(l6), [ta(l6)], none_a, false),
      (6, [ia(l6), ia(l4)], ta(l6), [ta(l6)], none_a, false),
      (0, none_i, none, none_a, none_a, true),
      (4, none_i, none, none_a, none_a, true),
      (4, [ia(l6)], none, none_a, none_a, true),
      (6, none_i, none, none_a, none_a, true),
      (6, [ia(l4)], none, none_a, none_a, true)
    ]
    i = 0
    for tt in tests {
      filter, ips, first, primaries, fallbacks, want_err = tt
      r = filter_addr_list(filter, ips, ->(x: IPAddr) -> Addr { TCPAddr.new(ip: x.ip, port: 5682, zone: x.zone) }, "ADDR")
      if want_err {
        assert_eq r.err.unwrap.message, "address ADDR: no suitable address found"
        i += 1
        next
      }
      addrs = r.unwrap
      assert_eq first_addr(addrs, true).to_s, first.unwrap.to_s
      p, f = partition_addrs(addrs)
      assert_eq addrs_s(p), addrs_s(primaries)
      assert_eq addrs_s(f), addrs_s(fallbacks)
      assert_eq addrs.size, p.size + f.size
      i += 1
    }
  }
}

test "AddrListPartition" {
  addrs: [Addr] = [IPAddr.new(ip: pip("fe80::"), zone: "eth0"), IPAddr.new(ip: pip("fe80::1"), zone: "eth0"), IPAddr.new(ip: pip("fe80::2"), zone: "eth0")]
  none_a: [Addr] = []
  cases: [(Byte, [Addr], [Addr])] = [
    (0, [addrs[0]], [addrs[1], addrs[2]]),
    (1, [addrs[0], addrs[2]], [addrs[1]]),
    (2, [addrs[0], addrs[1]], [addrs[2]]),
    (3, [addrs[0], addrs[1], addrs[2]], none_a)
  ]
  for tt in cases {
    last, primaries, fallbacks = tt
    for invert in [false, true] {
      p, f = partition_addrs_by(addrs, ->(a: Addr) -> Bool {
        ip = addr_ip(a)
        (ip[ip.size - 1] == last) != invert
      })
      assert_eq addrs_s(p), addrs_s(primaries)
      assert_eq addrs_s(f), addrs_s(fallbacks)
    }
  }
}

test "ListenIPv6WildcardAddr" {
  if supports_ipv6? && supports_ipv4map? {
    ln = listen("tcp", "[::]:0").unwrap
    a = case ln.net_addr.unwrap {
      TCPAddr(t) => t
      _ => TCPAddr.new
    }
    assert !a.ip.to4.present?, "listen(tcp, [::]:0) bound to #{a}, want IPv6 address"
    ln.close!
  }
}
