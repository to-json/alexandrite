# Hardware (MAC) addresses (Go's mac.go).

# A physical hardware address. Go's `type HardwareAddr []byte`, as a struct
# around the bytes.
pub struct HardwareAddr {
  b: [Byte]

  pub def bytes -> [Byte] { b }
  pub def size -> Int { b.size }
  pub def [](i: Int) -> Byte { b[i] }

  # "00:00:5e:00:53:01"; "" for none.
  pub def to_s -> Str {
    return "" if b.size == 0
    out: [Byte] = []
    for i in 0...b.size {
      out << 58 if i > 0
      out << HEX_DIGIT[(b[i] >> 4).to_i]
      out << HEX_DIGIT[(b[i] & 15).to_i]
    }
    Str.from_bytes(out)
  }

  pub def string -> Str { to_s }
}

pub def hardware_addr(b: [Byte]) -> HardwareAddr { HardwareAddr.new(b: b) }

# Parses an IEEE 802 MAC-48, EUI-48, EUI-64 or 20-octet IP over InfiniBand
# link-layer address: "00:00:5e:00:53:01", "00-00-5e-00-53-01",
# "0000.5e00.5301" or "00005e005301" (and the 8- and 20-octet forms).
pub def parse_mac(s: Str) -> ~HardwareAddr<AddrError> {
  hw = parse_mac_bytes(s) || fail addr_error("invalid MAC address", s)
  HardwareAddr.new(b: hw)
}

def parse_mac_bytes(s: Str) -> [Byte]? {
  return none if s.size < 12
  if s[2] == 58 || s[2] == 45 {
    return none if (s.size + 1) % 3 != 0
    n = (s.size + 1) / 3
    return none if n != 6 && n != 8 && n != 20
    hw: [Byte] = [0; n]
    x = 0
    for i in 0...n {
      hw[i] = xtoi2(s[x...s.size], s[2]) || return none
      x += 3
    }
    return hw
  }
  if s[4] == 46 {
    return none if (s.size + 1) % 5 != 0
    n = 2 * (s.size + 1) / 5
    return none if n != 6 && n != 8 && n != 20
    hw: [Byte] = [0; n]
    x = 0
    i = 0
    while i < n {
      hw[i] = xtoi2(s[x...x + 2], 0) || return none
      hw[i + 1] = xtoi2(s[x + 2...s.size], s[4]) || return none
      x += 5
      i += 2
    }
    return hw
  }
  return none if s.size % 2 != 0
  n = s.size / 2
  return none if n != 6 && n != 8 && n != 20
  hw: [Byte] = [0; n]
  x = 0
  for i in 0...n {
    hw[i] = xtoi2(s[x...x + 2], 0) || return none
    x += 2
  }
  hw
}
