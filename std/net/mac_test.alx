# Go's mac_test.go, parse_test.go and port_test.go, translated.

import "bufio"
import "os"
import "strings"

def hwb(b: [Byte]) -> HardwareAddr { HardwareAddr.new(b: b) }

test "ParseMAC" {
  tests: [(Str, HardwareAddr?, Str)] = [
    ("00:00:5e:00:53:01", hwb([0x00, 0x00, 0x5e, 0x00, 0x53, 0x01]), ""),
    ("00-00-5e-00-53-01", hwb([0x00, 0x00, 0x5e, 0x00, 0x53, 0x01]), ""),
    ("0000.5e00.5301", hwb([0x00, 0x00, 0x5e, 0x00, 0x53, 0x01]), ""),
    ("00005e005301", hwb([0x00, 0x00, 0x5e, 0x00, 0x53, 0x01]), ""),
    ("02:00:5e:10:00:00:00:01", hwb([0x02, 0x00, 0x5e, 0x10, 0x00, 0x00, 0x00, 0x01]), ""),
    ("02-00-5e-10-00-00-00-01", hwb([0x02, 0x00, 0x5e, 0x10, 0x00, 0x00, 0x00, 0x01]), ""),
    ("0200.5e10.0000.0001", hwb([0x02, 0x00, 0x5e, 0x10, 0x00, 0x00, 0x00, 0x01]), ""),
    ("02005e1000000001", hwb([0x02, 0x00, 0x5e, 0x10, 0x00, 0x00, 0x00, 0x01]), ""),
    ("00:00:00:00:fe:80:00:00:00:00:00:00:02:00:5e:10:00:00:00:01", hwb([0x00, 0x00, 0x00, 0x00, 0xfe, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x5e, 0x10, 0x00, 0x00, 0x00, 0x01]), ""),
    ("00-00-00-00-fe-80-00-00-00-00-00-00-02-00-5e-10-00-00-00-01", hwb([0x00, 0x00, 0x00, 0x00, 0xfe, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x5e, 0x10, 0x00, 0x00, 0x00, 0x01]), ""),
    ("0000.0000.fe80.0000.0000.0000.0200.5e10.0000.0001", hwb([0x00, 0x00, 0x00, 0x00, 0xfe, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x5e, 0x10, 0x00, 0x00, 0x00, 0x01]), ""),
    ("00000000fe8000000000000002005e1000000001", hwb([0x00, 0x00, 0x00, 0x00, 0xfe, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x5e, 0x10, 0x00, 0x00, 0x00, 0x01]), ""),
    ("ab:cd:ef:AB:CD:EF", hwb([0xab, 0xcd, 0xef, 0xab, 0xcd, 0xef]), ""),
    ("ab:cd:ef:AB:CD:EF:ab:cd", hwb([0xab, 0xcd, 0xef, 0xab, 0xcd, 0xef, 0xab, 0xcd]), ""),
    ("ab:cd:ef:AB:CD:EF:ab:cd:ef:AB:CD:EF:ab:cd:ef:AB:CD:EF:ab:cd", hwb([0xab, 0xcd, 0xef, 0xab, 0xcd, 0xef, 0xab, 0xcd, 0xef, 0xab, 0xcd, 0xef, 0xab, 0xcd, 0xef, 0xab, 0xcd, 0xef, 0xab, 0xcd]), ""),
    ("01.02.03.04.05.06", none, "invalid MAC address"),
    ("01:02:03:04:05:06:", none, "invalid MAC address"),
    ("x1:02:03:04:05:06", none, "invalid MAC address"),
    ("01002:03:04:05:06", none, "invalid MAC address"),
    ("01:02003:04:05:06", none, "invalid MAC address"),
    ("01:02:03004:05:06", none, "invalid MAC address"),
    ("01:02:03:04005:06", none, "invalid MAC address"),
    ("01:02:03:04:05006", none, "invalid MAC address"),
    ("01-02:03:04:05:06", none, "invalid MAC address"),
    ("01:02-03-04-05-06", none, "invalid MAC address"),
    ("0123:4567:89AF", none, "invalid MAC address"),
    ("0123-4567-89AF", none, "invalid MAC address"),
    ("0123456789AF0", none, "invalid MAC address")
  ]
  for t in tests {
    input, want, err = t
    r = parse_mac(input)
    if w = want {
      out = r.unwrap
      assert_eq out.bytes, w.bytes
      s = out.to_s
      out2 = parse_mac(s).unwrap
      assert_eq out2.bytes, out.bytes
    } else {
      e = r.err.unwrap
      assert strings.contains(e.message, err), e.message
      assert_eq e.message, "address #{input}: invalid MAC address"
    }
  }
}

test "ReadLine" {
  filename = "/etc/services"
  fr = os.open(filename)
  return if fr.err?
  fd = fr.unwrap
  defer {
    fd.close!
  }
  br = bufio.new_reader(fd)
  file = open_lines(filename).unwrap
  lineno = 1
  loop {
    bline = br.read_string!(10).unwrap || ""
    berr = bline.size == 0 || bline[bline.size - 1] != 10
    bline = bline[0...bline.size - 1] unless berr
    line = file.read_line
    ok = line.present?
    assert berr != ok, "#{filename}:#{lineno}"
    if l = line {
      assert_eq l, bline
    }
    break unless ok
    lineno += 1
  }
}

test "Dtoi" {
  tests: [(Str, Int, Int, Bool)] = [
    ("", 0, 0, false),
    ("0", 0, 1, true),
    ("65536", 65536, 5, true),
    ("123456789", BIG, 8, false),
    ("-0", 0, 0, false),
    ("-1234", 0, 0, false)
  ]
  for t in tests {
    input, out, off, ok = t
    n, i, k = dtoi(input)
    assert n == out && i == off && k == ok, "dtoi(#{input}) = #{n}, #{i}, #{k}"
  }
}

test "ParsePort" {
  tests: [(Str, Int, Bool)] = [
    ("", 0, false),
    ("-1073741825", -1 << 30, false),
    ("-1073741824", -1 << 30, false),
    ("-1073741823", -((1 << 30) - 1), false),
    ("-123456789", -123456789, false),
    ("-1", -1, false),
    ("-0", 0, false),
    ("0", 0, false),
    ("+0", 0, false),
    ("+1", 1, false),
    ("65535", 65535, false),
    ("65536", 65536, false),
    ("123456789", 123456789, false),
    ("1073741822", (1 << 30) - 2, false),
    ("1073741823", (1 << 30) - 1, false),
    ("1073741824", (1 << 30) - 1, false),
    ("1073741825", (1 << 30) - 1, false),
    ("abc", 0, true),
    ("9pfs", 0, true),
    ("123badport", 0, true),
    ("bad123port", 0, true),
    ("badport123", 0, true),
    ("123456789badport", 0, true),
    ("-2147483649badport", 0, true),
    ("2147483649badport", 0, true)
  ]
  for t in tests {
    service, port, needs = t
    p, n = parse_port(service)
    assert p == port && n == needs, "parse_port(#{service}) = #{p}, #{n}; want #{port}, #{needs}"
  }
}
