  assert_eq pds("Fri, 32 Foo 20201 24:00:00 UTC"), "ERR mail: header could not be parsed"
  assert_eq pds("Mon, 7 OCT 7 09:55:06 XYZ (x(y))"), "ERR mail: header could not be parsed"
  assert_eq pds(" OCT 1997 09:55 -0600 (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pds(" OCT 2020 09:55  (bad"), "ERR mail: header could not be parsed"
  assert_eq pds("Fri,  OCT 97 24:00:00 UT\r"), "ERR mail: header has a CR without LF"
  assert_eq pds("Fri, 7 Jan 1997 9:55:06 +0000 junk"), "1997-01-07T09:55:06Z"
  assert_eq pds("Fri,  Jan 7 23:59:60 -1260 (MDT)"), "ERR mail: header could not be parsed"
  assert_eq pds("Mon, 32 May 97 23:59:60 -060  \r\n (c)"), "ERR mail: header could not be parsed"
  assert_eq pds("Fri, 1 Jan 2020 09:55 +1300"), "2020-01-01T09:55:00+13:00"
  assert_eq pds(" Tue, 32 Jan 20201 09:55:06 GMT (x(y))"), "ERR mail: header could not be parsed"
  assert_eq pds("Mon, 1 Nov 1997 23:59:60 -060"), "ERR mail: header could not be parsed"
  assert_eq pds("1 Nov 97 09:55:06 -060"), "ERR mail: header could not be parsed"
  assert_eq pds("Fri, 32 May 97 23:59:60 -1260 (x(y))"), "ERR mail: header could not be parsed"
}

