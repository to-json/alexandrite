  assert_eq pds(" Nov 97 9:55:06 -0600\r"), "ERR mail: header has a CR without LF"
  assert_eq pds("Mon, 7 Nov 2020 09:55 +1300   "), "2020-11-07T09:55:00+13:00"
  assert_eq pds(" Tue,  Jan 1997 24:00:00 -060 (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pds(" Tue, 7 Nov 2020 09:55 -1260"), "2020-11-07T09:55:00-13:00"
  assert_eq pds("32 Nov 1997 24:00:00 +0000"), "ERR mail: header could not be parsed"
  assert_eq pds("Fri 1 Nov 7 23:59:60 -1260  \r\n (c)"), "ERR mail: header could not be parsed"
