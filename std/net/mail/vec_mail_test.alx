  assert_eq fmt_round("日(\töa\\", "plain"), "=?utf-8?b?5pelKAnDtmFc?= <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("日", "@"), "=?utf-8?q?=E6=97=A5?= <@> => ERR mail: invalid string"
  assert_eq fmt_round(")\x01=)", "plain"), "=?utf-8?b?KQE9KQ==?= <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("B日~\x01", "a.b@x"), "=?utf-8?b?QuaXpX4B?= <a.b@x> => B日~\x01|a.b@x"
  assert_eq fmt_round("#", "a b@c"), "\"#\" <\"a b\"@c> => #|a b@c"
  assert_eq fmt_round(")a\"_ )", "\"q\"@z"), "\")a\\\"_ )\" <\"\\\"q\\\"\"@z> => )a\"_ )|\"q\"@z"
  assert_eq fmt_round("~'\t'\"?~", "ü@x"), "\"~'\t'\\\"?~\" <ü@x> => ~'\t'\"?~|ü@x"
  assert_eq fmt_round("\"?", "a b@c"), "\"\\\"?\" <\"a b\"@c> => \"?|a b@c"
}

