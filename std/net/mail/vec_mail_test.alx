  assert_eq fmt_round(")?.~日\x01\"", "plain"), "=?utf-8?b?KT8ufuaXpQEi?= <plain@> => ERR mail: invalid string"
  assert_eq fmt_round(",\ta", "ü@x"), "\",\ta\" <ü@x> => ,\ta|ü@x"
  assert_eq fmt_round(" \"~", "bob@example.com"), "\" \\\"~\" <bob@example.com> =>  \"~|bob@example.com"
  assert_eq fmt_round(".,?=(", "a..b@x"), "\".,?=(\" <\"a..b\"@x> => .,?=(|a..b@x"
  assert_eq fmt_round("\x01\"?'~\tB", "my@idiot@address@example.com"), "=?utf-8?b?ASI/J34JQg==?= <\"my@idiot@address\"@example.com> => \x01\"?'~\tB|my@idiot@address@example.com"
  assert_eq fmt_round("=,\"\") )", " @x"), "\"=,\\\"\\\") )\" <\" \"@x> => =,\"\") )| @x"
