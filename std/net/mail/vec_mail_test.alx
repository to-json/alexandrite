test "vectors: address string 2" {
  assert_eq fmt_round(",? ", "plain"), "\",? \" <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("=_=", " @x"), "\"=_=\" <\" \"@x> => =_=| @x"
  assert_eq fmt_round("_?_?a", "ü@x"), "\"_?_?a\" <ü@x> => _?_?a|ü@x"
  assert_eq fmt_round("\x01#日_=?", "a.b@x"), "=?utf-8?b?ASPml6VfPT8=?= <a.b@x> => \x01#日_=?|a.b@x"
  assert_eq fmt_round("ö(~", "a.b@x"), "=?utf-8?b?w7Yofg==?= <a.b@x> => ö(~|a.b@x"
  assert_eq fmt_round(" @", ""), "\" @\" <@> => ERR mail: invalid string"
  assert_eq fmt_round(",\"\t)\x01", "\"q\"@z"), "=?utf-8?b?LCIJKQE=?= <\"\\\"q\\\"\"@z> => ,\"\t)\x01|\"q\"@z"
  assert_eq fmt_round("<?\\a',(", " @x"), "\"<?\\\\a',(\" <\" \"@x> => <?\\a',(| @x"
  assert_eq fmt_round("\x01. ?\x01,.", "my@idiot@address@example.com"), "=?utf-8?b?AS4gPwEsLg==?= <\"my@idiot@address\"@example.com> => \x01. ?\x01,.|my@idiot@address@example.com"
  assert_eq fmt_round("~\"<<a", "\"q\"@z"), "\"~\\\"<<a\" <\"\\\"q\\\"\"@z> => ~\"<<a|\"q\"@z"
  assert_eq fmt_round("\\'\x01\\", "x.@y"), "=?utf-8?b?XCcBXA==?= <\"x.\"@y> => \\'\x01\\|x.@y"
  assert_eq fmt_round("<\t,'", "\"q\"@z"), "\"<\t,'\" <\"\\\"q\\\"\"@z> => <\t,'|\"q\"@z"
  assert_eq fmt_round(".", "a..b@x"), "\".\" <\"a..b\"@x> => .|a..b@x"
  assert_eq fmt_round("\"~(", "a.b@x"), "\"\\\"~(\" <a.b@x> => \"~(|a.b@x"
  assert_eq fmt_round("=日\x01\x01", "a.b@x"), "=?utf-8?q?=3D=E6=97=A5=01=01?= <a.b@x> => =日\x01\x01|a.b@x"
  assert_eq fmt_round("B", "ü@x"), "\"B\" <ü@x> => B|ü@x"
  assert_eq fmt_round("\t\t\x01ö?_", "a..b@x"), "=?utf-8?q?=09=09=01=C3=B6=3F=5F?= <\"a..b\"@x> => \t\t\x01ö?_|a..b@x"
  assert_eq fmt_round("ö日", "@"), "=?utf-8?q?=C3=B6=E6=97=A5?= <@> => ERR mail: invalid string"
  assert_eq fmt_round(" _", "@"), "\" _\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("(#", "plain"), "\"(#\" <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("\\\x01.", "a..b@x"), "=?utf-8?b?XAEu?= <\"a..b\"@x> => \\\x01.|a..b@x"
  assert_eq fmt_round("\t", "x.@y"), "\"\t\" <\"x.\"@y> => \t|x.@y"
  assert_eq fmt_round(")B日", "a b@c"), "=?utf-8?b?KULml6U=?= <\"a b\"@c> => )B日|a b@c"
  assert_eq fmt_round("#@<=", "a.b@x"), "\"#@<=\" <a.b@x> => #@<=|a.b@x"
  assert_eq fmt_round("#@\\日\x01ö", ".a@x"), "=?utf-8?b?I0Bc5pelAcO2?= <\".a\"@x> => #@\\日\x01ö|.a@x"
  assert_eq fmt_round(" )ö?aa)", ""), "=?utf-8?b?ICnDtj9hYSk=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("_\\)=\\@", "a b@c"), "\"_\\\\)=\\\\@\" <\"a b\"@c> => _\\)=\\@|a b@c"
  assert_eq fmt_round("'?a#日\x01?", ".a@x"), "=?utf-8?b?Jz9hI+aXpQE/?= <\".a\"@x> => '?a#日\x01?|.a@x"
  assert_eq fmt_round("\\B ", ""), "\"\\\\B \" <@> => ERR mail: invalid string"
  assert_eq fmt_round("<#~@", "a.b@x"), "\"<#~@\" <a.b@x> => <#~@|a.b@x"
  assert_eq fmt_round("\ta", ".a@x"), "\"\ta\" <\".a\"@x> => \ta|.a@x"
  assert_eq fmt_round("\"\x01\x01\t\ta(", "a b@c"), "=?utf-8?b?IgEBCQlhKA==?= <\"a b\"@c> => \"\x01\x01\t\ta(|a b@c"
  assert_eq fmt_round(".", ""), "\".\" <@> => ERR mail: invalid string"
  assert_eq fmt_round(",~(", "\"q\"@z"), "\",~(\" <\"\\\"q\\\"\"@z> => ,~(|\"q\"@z"
  assert_eq fmt_round("日\"@\"", ""), "=?utf-8?b?5pelIkAi?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("#日", "@"), "=?utf-8?b?I+aXpQ==?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("'.<日?", "a.b@x"), "=?utf-8?b?Jy485pelPw==?= <a.b@x> => '.<日?|a.b@x"
  assert_eq fmt_round("\t~\t'@", ".a@x"), "\"\t~\t'@\" <\".a\"@x> => \t~\t'@|.a@x"
  assert_eq fmt_round("\t\"<", "@"), "\"\t\\\"<\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("日~@==", "x.@y"), "=?utf-8?b?5pelfkA9PQ==?= <\"x.\"@y> => 日~@==|x.@y"
  assert_eq fmt_round("\\(@)", "my@idiot@address@example.com"), "\"\\\\(@)\" <\"my@idiot@address\"@example.com> => \\(@)|my@idiot@address@example.com"
  assert_eq fmt_round(".日~", "x.@y"), "=?utf-8?b?LuaXpX4=?= <\"x.\"@y> => .日~|x.@y"
  assert_eq fmt_round("\x01a\"a(_~", "bob@example.com"), "=?utf-8?b?AWEiYShffg==?= <bob@example.com> => \x01a\"a(_~|bob@example.com"
  assert_eq fmt_round("?(<=", "bob@example.com"), "\"?(<=\" <bob@example.com> => ?(<=|bob@example.com"
  assert_eq fmt_round("@\\<", "a.b@x"), "\"@\\\\<\" <a.b@x> => @\\<|a.b@x"
  assert_eq fmt_round("(=", "a b@c"), "\"(=\" <\"a b\"@c> => (=|a b@c"
  assert_eq fmt_round(",,a'\\", "bob@example.com"), "\",,a'\\\\\" <bob@example.com> => ,,a'\\|bob@example.com"
  assert_eq fmt_round(",", "a.b@x"), "\",\" <a.b@x> => ,|a.b@x"
  assert_eq fmt_round("'BB)", "my@idiot@address@example.com"), "\"'BB)\" <\"my@idiot@address\"@example.com> => 'BB)|my@idiot@address@example.com"
  assert_eq fmt_round("<.\\(\x01)#", ".a@x"), "=?utf-8?b?PC5cKAEpIw==?= <\".a\"@x> => <.\\(\x01)#|.a@x"
  assert_eq fmt_round("=\\", "a b@c"), "\"=\\\\\" <\"a b\"@c> => =\\|a b@c"
  assert_eq fmt_round(") a", "bob@example.com"), "\") a\" <bob@example.com> => ) a|bob@example.com"
  assert_eq fmt_round("##\t", "my@idiot@address@example.com"), "\"##\t\" <\"my@idiot@address\"@example.com> => ##\t|my@idiot@address@example.com"
  assert_eq fmt_round("<", "\"q\"@z"), "\"<\" <\"\\\"q\\\"\"@z> => <|\"q\"@z"
  assert_eq fmt_round("_)日\\", ""), "=?utf-8?b?Xynml6Vc?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("<", "a.b@x"), "\"<\" <a.b@x> => <|a.b@x"
  assert_eq fmt_round(",)\\'~\\\"", " @x"), "\",)\\\\'~\\\\\\\"\" <\" \"@x> => ,)\\'~\\\"| @x"
  assert_eq fmt_round("#a<.\tö_", "ü@x"), "=?utf-8?b?I2E8LgnDtl8=?= <ü@x> => #a<.\tö_|ü@x"
  assert_eq fmt_round(" a", ".a@x"), "\" a\" <\".a\"@x> =>  a|.a@x"
  assert_eq fmt_round("~\x01'<a", "\"q\"@z"), "=?utf-8?b?fgEnPGE=?= <\"\\\"q\\\"\"@z> => ~\x01'<a|\"q\"@z"
  assert_eq fmt_round("'\x01.<@#)", "bob@example.com"), "=?utf-8?b?JwEuPEAjKQ==?= <bob@example.com> => '\x01.<@#)|bob@example.com"
  assert_eq fmt_round("<?", "bob@example.com"), "\"<?\" <bob@example.com> => <?|bob@example.com"
  assert_eq fmt_round("~?\\?", "\"q\"@z"), "\"~?\\\\?\" <\"\\\"q\\\"\"@z> => ~?\\?|\"q\"@z"
  assert_eq fmt_round("ö\\ö~ö@a", "@"), "=?utf-8?b?w7Zcw7Z+w7ZAYQ==?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("\\~~\"", " @x"), "\"\\\\~~\\\"\" <\" \"@x> => \\~~\"| @x"
  assert_eq fmt_round(" ", " @x"), "\" \" <\" \"@x> =>  | @x"
  assert_eq fmt_round("<@~@ \x01a", " @x"), "=?utf-8?b?PEB+QCABYQ==?= <\" \"@x> => <@~@ \x01a| @x"
  assert_eq fmt_round("\t日\"#~)", ""), "=?utf-8?b?CeaXpSIjfik=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("B\x01_ö '", "bob@example.com"), "=?utf-8?b?QgFfw7YgJw==?= <bob@example.com> => B\x01_ö '|bob@example.com"
  assert_eq fmt_round(",.ö\"ö", "bob@example.com"), "=?utf-8?b?LC7DtiLDtg==?= <bob@example.com> => ,.ö\"ö|bob@example.com"
  assert_eq fmt_round("#日\\?)\\", ""), "=?utf-8?b?I+aXpVw/KVw=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("#?<\\\x01'@", ".a@x"), "=?utf-8?b?Iz88XAEnQA==?= <\".a\"@x> => #?<\\\x01'@|.a@x"
  assert_eq fmt_round("@<=a日.", "a..b@x"), "=?utf-8?b?QDw9YeaXpS4=?= <\"a..b\"@x> => @<=a日.|a..b@x"
  assert_eq fmt_round("\t@", "a.b@x"), "\"\t@\" <a.b@x> => \t@|a.b@x"
  assert_eq fmt_round("#\\", "my@idiot@address@example.com"), "\"#\\\\\" <\"my@idiot@address\"@example.com> => #\\|my@idiot@address@example.com"
  assert_eq fmt_round("日a~ö(\t\"", "@"), "=?utf-8?b?5pelYX7DtigJIg==?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("Ba日)_\"", "@"), "=?utf-8?b?QmHml6UpXyI=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round(")", " @x"), "\")\" <\" \"@x> => )| @x"
  assert_eq fmt_round("\"日\t(_日", "a.b@x"), "=?utf-8?b?IuaXpQkoX+aXpQ==?= <a.b@x> => \"日\t(_日|a.b@x"
  assert_eq fmt_round(")a.@\t", "bob@example.com"), "\")a.@\t\" <bob@example.com> => )a.@\t|bob@example.com"
  assert_eq fmt_round("\t,", "x.@y"), "\"\t,\" <\"x.\"@y> => \t,|x.@y"
  assert_eq fmt_round("=< ", "a b@c"), "\"=< \" <\"a b\"@c> => =< |a b@c"
  assert_eq fmt_round("\"<\tö('", "ü@x"), "=?utf-8?b?IjwJw7YoJw==?= <ü@x> => \"<\tö('|ü@x"
  assert_eq fmt_round(" a\x01B\x01日ö", ".a@x"), "=?utf-8?q?_a=01B=01=E6=97=A5=C3=B6?= <\".a\"@x> =>  a\x01B\x01日ö|.a@x"
  assert_eq fmt_round("?", "@"), "\"?\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("ö,日 ,a", " @x"), "=?utf-8?b?w7Ys5pelICxh?= <\" \"@x> => ö,日 ,a| @x"
  assert_eq fmt_round("~~a=))@", "\"q\"@z"), "\"~~a=))@\" <\"\\\"q\\\"\"@z> => ~~a=))@|\"q\"@z"
  assert_eq fmt_round("a\t\",", "\"q\"@z"), "\"a\t\\\",\" <\"\\\"q\\\"\"@z> => a\t\",|\"q\"@z"
  assert_eq fmt_round("aa.\t@", "a..b@x"), "\"aa.\t@\" <\"a..b\"@x> => aa.\t@|a..b@x"
  assert_eq fmt_round("?=", "@"), "\"?=\" <@> => ERR mail: invalid string"
  assert_eq fmt_round(" 日", "my@idiot@address@example.com"), "=?utf-8?q?_=E6=97=A5?= <\"my@idiot@address\"@example.com> =>  日|my@idiot@address@example.com"
  assert_eq fmt_round("\x01<", "ü@x"), "=?utf-8?b?ATw=?= <ü@x> => \x01<|ü@x"
  assert_eq fmt_round("~a'\x01@\\.", "my@idiot@address@example.com"), "=?utf-8?b?fmEnAUBcLg==?= <\"my@idiot@address\"@example.com> => ~a'\x01@\\.|my@idiot@address@example.com"
  assert_eq fmt_round("?=ö\\", "x.@y"), "=?utf-8?q?=3F=3D=C3=B6\\?= <\"x.\"@y> => ERR mail: missing '@' or angle-addr"
  assert_eq fmt_round("~日_", "a.b@x"), "=?utf-8?b?fuaXpV8=?= <a.b@x> => ~日_|a.b@x"
  assert_eq fmt_round("'(\\~=", "bob@example.com"), "\"'(\\\\~=\" <bob@example.com> => '(\\~=|bob@example.com"
  assert_eq fmt_round("a~a)?\"", "\"q\"@z"), "\"a~a)?\\\"\" <\"\\\"q\\\"\"@z> => a~a)?\"|\"q\"@z"
  assert_eq fmt_round("\\_#B", "a..b@x"), "\"\\\\_#B\" <\"a..b\"@x> => \\_#B|a..b@x"
  assert_eq fmt_round("=@\t'日", ".a@x"), "=?utf-8?b?PUAJJ+aXpQ==?= <\".a\"@x> => =@\t'日|.a@x"
  assert_eq fmt_round("_\t", "a b@c"), "\"_\t\" <\"a b\"@c> => _\t|a b@c"
}

test "vectors: address string 3" {
  assert_eq fmt_round("=_", ""), "\"=_\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("#B日aa(,", ".a@x"), "=?utf-8?b?I0Lml6VhYSgs?= <\".a\"@x> => #B日aa(,|.a@x"
  assert_eq fmt_round("ö\t\\", "bob@example.com"), "=?utf-8?q?=C3=B6=09\\?= <bob@example.com> => ERR mail: missing '@' or angle-addr"
