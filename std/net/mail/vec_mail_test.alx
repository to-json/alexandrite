test "vectors: address 8" {
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <.x@example.com> "), "ERR mail: leading dot in atom"
  assert_eq pa("ä ö <x.@[IPv6:1.2.3.4]>  (x(y)z)"), "ERR mail: trailing dot in atom"
  assert_eq pa("\"Joe Q. Public\" jdoe@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pa("\"\\\\\"@example.com  (x(y)z)"), "x(y)z|\\@example.com"
  assert_eq pa(".x@[1.2.3] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"a\\\"b\" .x@x"), "ERR mail: no angle-addr"
  assert_eq pa(".x@[256.0.0.1] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("é@[192.168.0.1]"), "|é@[192.168.0.1]"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= #!$%@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("a..b@x,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("us_er@[192.168.0.1]"), "|us_er@[192.168.0.1]"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= a..b@"), "ERR mail: no angle-addr"
  assert_eq pa("x: us_er@[::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<a@b@[256.0.0.1]> "), "ERR mail: unclosed angle-addr"
  assert_eq pa("\"Joe Q. Public\" <#!$%@x>"), "Joe Q. Public|#!$%@x"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= <jdoe@x> (comment)"), "Böb|jdoe@x"
  assert_eq pa("<.x@[a]> "), "ERR mail: leading dot in atom"
  assert_eq pa("Who? é@[::1]"), "ERR mail: no angle-addr"
  assert_eq pa("John Doe <\"\\\\\"@x>"), "John Doe|\\@x"
  assert_eq pa("John jdoe@[::1]"), "ERR mail: no angle-addr"
  assert_eq pa("<\"\"@[1.2.3]> (bad"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("<x.@[a]> (comment)"), "ERR mail: trailing dot in atom"
  assert_eq pa(" .x@x"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("Böb \"john..doe\"@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("ä ö <jdoe@x>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("<.x@x> "), "ERR mail: leading dot in atom"
  assert_eq pa("#!$%@[IPv6:::1] "), "|#!$%@[IPv6:::1]"
  assert_eq pa("<\"\"@[IPv6:::1]> (bad"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa(" a..b@a..b"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"Joe Q. Public\" john.doe@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= us_er@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pa("<\"\\\\\"@x>"), "|\\@x"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= us_er@"), "ERR mail: no angle-addr"
  assert_eq pa("(c) <x.@x> junk"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("Who? <\"john..doe\"@[::1]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("\"Joe Q. Public\" \"\\\\\"@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa(".x@[IPv6:1.2.3.4] (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa(" <john.doe@> "), "ERR mail: invalid string"
  assert_eq pa("<\"\"@[IPv6:1.2.3.4]> "), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("<#!$%@[1.2.3]> junk"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("\"Joe Q. Public\" \"\\\\\"@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= jdoe@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pa("<.x@ex-ample.org> junk"), "ERR mail: leading dot in atom"
  assert_eq pa("Asem H. <é@[256.0.0.1]> (comment)"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("<#!$%@a..b> (comment)"), "ERR mail: double dot in atom"
}

test "vectors: address list 0" {
  assert_eq pal("Who? <john.doe@[192.168.0.1]> , Böb a..b@[256.0.0.1] , jdoe@ex-ample.org (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("<\"a b\"@[256.0.0.1]> junk,x.@x  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("grp: ; , a.b john.doe@a..b"), "ERR mail: no angle-addr"
  assert_eq pal("#!$%@example.com ,, =?utf-8?b?QsO2Yg==?= a..b@example.com,, \"\" \"\\\\\"@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal("<\"\\\\\"@[::1]> (comment), <\"\"@x> junk, John Doe <john.doe@[1.2.3]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("<\"\\\\\"@a..b>  (x(y)z),grp: ;"), "ERR mail: double dot in atom"
  assert_eq pal("x: \"john..doe\"@[a]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("John Doe \"\\\\\"@[192.168.0.1] , John Doe <a@b@[256.0.0.1]> (bad , a..b@[::1]"), "ERR mail: no angle-addr"
  assert_eq pal("a.b <é@[IPv6:1.2.3.4]>,Böb <a..b@[::1]> ,grp: \"\\\\\"@[192.168.0.1] junk;"), "ERR mail: double dot in atom"
  assert_eq pal("\"a\\\"b\" jdoe@[192.168.0.1], \"\" <.x@[IPv6:::1]> "), "ERR mail: no angle-addr"
  assert_eq pal("John Doe \"\"@[256.0.0.1], Böb <x.@[192.168.0.1]> (bad, \"a b\"@[a]"), "ERR mail: no angle-addr"
  assert_eq pal("Böb <a..b@> "), "ERR mail: double dot in atom"
  assert_eq pal("(c) <\"\\\\\"@> (bad,us_er@,,grp: ä ö <john.doe@a..b>,, \"a b\"@x  (x(y)z);"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("ä ö <\"\\\\\"@[1.2.3]> junk,=?iso-8859-1?q?J=F6rg?= <a@b@> (bad,grp: =?utf-8?b?QsO2Yg==?= <jdoe@x>  (x(y)z), =?x-unknown?q?a?= \"\\\\\"@ex-ample.org;"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("grp: x: <é@>, john.doe@ex-ample.org  (x(y)z);"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("John Doe é@[IPv6:1.2.3.4], =?utf-8?q?a?= =?utf-8?q?b?= a@b@"), "ERR mail: no angle-addr"
  assert_eq pal("<x.@[1.2.3]> (bad,, <a..b@[IPv6:::1]> (comment),, Böb a..b@example.com"), "ERR mail: trailing dot in atom"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= <.x@a..b> (comment),grp: a@b@x , (c) <\"john..doe\"@[IPv6:::1]> (bad;,grp: <.x@[192.168.0.1]>;"), "ERR mail: leading dot in atom"
  assert_eq pal("x.@ex-ample.org,,, grp: <\"john..doe\"@[IPv6:::1]>  (x(y)z), (c) <\"\"@[IPv6:1.2.3.4]>;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"\" \"\\\\\"@x , grp: \"Joe Q. Public\" <a@b@[256.0.0.1]>, =?utf-8?q?J=C3=B6rg?= <.x@a..b>  (x(y)z);"), "ERR mail: no angle-addr"
  assert_eq pal("\"a\\\"b\" \"\"@[192.168.0.1] , =?iso-8859-1?q?J=F6rg?= <\"a b\"@[IPv6:::1]> "), "ERR mail: no angle-addr"
  assert_eq pal("grp: ;,, John <jdoe@example.com>,,, =?iso-8859-1?q?J=F6rg?= .x@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pal(".x@[IPv6:1.2.3.4] (bad,\"john..doe\"@[IPv6:::1] (comment),grp: ;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("x: .x@a..b,, a..b@example.com "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: ;,, <x.@x> (comment),, <é@x> (bad"), "ERR mail: trailing dot in atom"
  assert_eq pal(" <us_er@[::1]>,"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("grp: \"john..doe\"@a..b junk;,, <john.doe@[IPv6:1.2.3.4]> junk,, grp: ;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("us_er@,,=?x-unknown?q?a?= x.@[IPv6:::1],.x@ex-ample.org,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?x-unknown?q?a?= <#!$%@[1.2.3]> junk,, x.@[a],, #!$%@ex-ample.org (bad"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("ä ö <é@> junk"), "ERR mail: invalid string"
  assert_eq pal("é@x (comment),é@x,,=?utf-8?b?QsO2Yg==?= <jdoe@ex-ample.org>"), "comment|é@x;|é@x;Böb|jdoe@ex-ample.org"
  assert_eq pal("<#!$%@[::1]>  (x(y)z),, a@b@a..b (bad"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("\"\"@[::1]  (x(y)z),jdoe@ex-ample.org (bad,\"\\\\\"@ex-ample.org"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("john.doe@x (bad , =?iso-8859-1?q?J=F6rg?= <us_er@>,"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("\"john..doe\"@example.com junk,, us_er@ex-ample.org "), "ERR mail: expected comma"
  assert_eq pal("Who? é@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pal("\"\" x.@[1.2.3], a.b é@ex-ample.org, Asem H. <\"\\\\\"@[192.168.0.1]> "), "ERR mail: no angle-addr"
  assert_eq pal("\"a\\\"b\" a@b@example.com , =?utf-8?q?J=C3=B6rg?= jdoe@a..b , grp: \"a b\"@[::1] (bad;"), "ERR mail: no angle-addr"
  assert_eq pal("a..b@[::1] (bad , grp: ; , <jdoe@[1.2.3]> "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= <us_er@a..b> (comment) , grp: ;"), "ERR mail: double dot in atom"
  assert_eq pal("Böb \"\\\\\"@[::1],Who? .x@example.com,grp: ;"), "ERR mail: no angle-addr"
  assert_eq pal("<jdoe@[192.168.0.1]>  (x(y)z), grp: (c) <jdoe@[IPv6:::1]>;"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("grp: Who? <\"john..doe\"@[192.168.0.1]> junk, <a@b@[::1]> junk; , \"Joe Q. Public\" \"a b\"@[256.0.0.1]"), "ERR mail: expected comma"
  assert_eq pal("Asem H. a@b@[::1], John \"a b\"@[a]"), "ERR mail: no angle-addr"
  assert_eq pal("#!$%@a..b  (x(y)z) , <jdoe@x> (bad , \"a\\\"b\" <a..b@[a]>"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("a.b <jdoe@[256.0.0.1]>,,john.doe@[a],,<x.@[::1]>"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("#!$%@[192.168.0.1] , a@b@[::1]  (x(y)z), a.b <a..b@a..b>,"), "ERR mail: expected comma"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= \"\"@[a],, <.x@a..b> "), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <é@[::1]> (comment),, grp: ;"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("<\"john..doe\"@[IPv6:::1]> (bad, <us_er@[1.2.3]>  (x(y)z), <\"\\\\\"@a..b> junk"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("grp: ;"), ""
  assert_eq pal("grp: ;, grp:  <\"\"@> , \"\" é@[IPv6:1.2.3.4];"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("<a@b@[IPv6:1.2.3.4]> junk,Who? \"\"@a..b,grp: x: <\"john..doe\"@example.com> (bad, x.@x,;"), "ERR mail: unclosed angle-addr"
  assert_eq pal("<john.doe@ex-ample.org> "), "|john.doe@ex-ample.org"
  assert_eq pal("<us_er@x>,John Doe <a..b@[::1]>  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pal("us_er@example.com (comment)"), "comment|us_er@example.com"
  assert_eq pal("\"john..doe\"@ex-ample.org (comment)"), "comment|john..doe@ex-ample.org"
  assert_eq pal("John <é@[a]> (comment)"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal(".x@ex-ample.org (bad,a..b@[192.168.0.1]  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"a\\\"b\" é@x , \"a b\"@[1.2.3]  , \"a b\"@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pal("<é@[::1]>,, <\"\\\\\"@[::1]>"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("=?utf-8?b?QsO2Yg==?= #!$%@[192.168.0.1] , <jdoe@x> junk , =?iso-8859-1?q?J=F6rg?= .x@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= a@b@x"), "ERR mail: no angle-addr"
  assert_eq pal("<x.@[a]>  (x(y)z)"), "ERR mail: trailing dot in atom"
  assert_eq pal("\"a b\"@[192.168.0.1] junk,, #!$%@[IPv6:1.2.3.4]  (x(y)z),, \"Joe Q. Public\" \"a b\"@[IPv6:::1]"), "ERR mail: expected comma"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= <a@b@x> , Böb .x@[::1]"), "ERR mail: unclosed angle-addr"
  assert_eq pal("<jdoe@[256.0.0.1]> (bad,, \"\\\\\"@[192.168.0.1] (comment),, \"a\\\"b\" .x@[192.168.0.1]"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("#!$%@example.com (comment)"), "comment|#!$%@example.com"
  assert_eq pal("\"a\\\"b\" <a..b@[1.2.3]> (comment),, =?x-unknown?q?a?= <\"\\\\\"@[IPv6:1.2.3.4]> junk,, #!$%@[IPv6:::1]  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pal("Who? <jdoe@[192.168.0.1]> ,\"\" <#!$%@example.com> "), "Who?|jdoe@[192.168.0.1];|#!$%@example.com"
  assert_eq pal("grp: (c) us_er@[1.2.3], x.@[::1] ;"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("grp: =?iso-8859-1?q?J=F6rg?= <jdoe@[256.0.0.1]>,, \"john..doe\"@[192.168.0.1] junk;,\"Joe Q. Public\" <john.doe@[IPv6:1.2.3.4]>,jdoe@x junk"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("<\"a b\"@[IPv6:::1]> , John <#!$%@[1.2.3]> junk, =?iso-8859-1?q?J=F6rg?= .x@[a]"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("é@a..b ,, Who? <\"\\\\\"@[a]> (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"\"@[192.168.0.1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<john.doe@[::1]>  (x(y)z), x: \"\"@a..b"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("\"a\\\"b\" .x@[IPv6:::1],, <\"\\\\\"@[::1]> (bad,, Asem H. <\"\"@> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("john.doe@[256.0.0.1] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"\" <a..b@example.com> (bad, =?iso-8859-1?q?J=F6rg?= a@b@x, <a@b@[1.2.3]>  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pal("=?x-unknown?q?a?= <john.doe@[192.168.0.1]> (bad,<\"\\\\\"@ex-ample.org>,,<jdoe@[a]>  (x(y)z)"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal(".x@ex-ample.org,,<\"\"@[IPv6:::1]> (bad,=?utf-8?q?J=C3=B6rg?= <a..b@[IPv6:1.2.3.4]>  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: #!$%@ (comment), =?x-unknown?q?a?= <é@>,;,\"a\\\"b\" a..b@[IPv6:1.2.3.4], <\"\\\\\"@[a]>,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: ;,, grp: =?utf-8?b?QsO2Yg==?= <\"\"@[IPv6:::1]> (comment);,, <jdoe@[256.0.0.1]> (comment)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("x: <a..b@example.com> "), "ERR mail: double dot in atom"
  assert_eq pal("=?x-unknown?q?a?= \"a b\"@[::1],\"\" <jdoe@> "), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("<x.@[256.0.0.1]>,"), "ERR mail: trailing dot in atom"
  assert_eq pal("<us_er@ex-ample.org> "), "|us_er@ex-ample.org"
  assert_eq pal("John <us_er@[IPv6:1.2.3.4]>,, <\"\\\\\"@[IPv6:::1]> (bad,, é@x,"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("Who? \"\"@, grp: ;"), "ERR mail: no angle-addr"
  assert_eq pal("grp: \"Joe Q. Public\" <a@b@example.com>;,, =?iso-8859-1?q?J=F6rg?= us_er@[IPv6:::1]"), "ERR mail: unclosed angle-addr"
  assert_eq pal("\"a\\\"b\" a..b@[IPv6:::1], us_er@[192.168.0.1] , =?iso-8859-1?q?J=F6rg?= #!$%@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pal("Asem H. a..b@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pal(".x@x, <a..b@[IPv6:1.2.3.4]> , =?utf-8?q?J=C3=B6rg?= a..b@"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("john.doe@ex-ample.org junk, <x.@[IPv6:1.2.3.4]>,"), "ERR mail: expected comma"
  assert_eq pal("a.b #!$%@[a]"), "ERR mail: no angle-addr"
  assert_eq pal("grp: <john.doe@[IPv6:1.2.3.4]>,, Who? <john.doe@[192.168.0.1]>;, <a..b@[::1]> (bad, Asem H. <\"\"@example.com>  (x(y)z)"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("a.b \"a b\"@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pal("<\"\"@a..b> ,\"\"@[256.0.0.1] junk"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("\"a\\\"b\" <\"\"@[192.168.0.1]>"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("\"\\\\\"@[1.2.3] (comment)"), "ERR mail: no angle-addr"
}

test "vectors: address list 1" {
  assert_eq pal("John <\"john..doe\"@x> (comment),x: <a..b@[1.2.3]>,,grp: é@[256.0.0.1] ;"), "ERR mail: double dot in atom"
  assert_eq pal("\"\" <\"john..doe\"@a..b> junk"), "ERR mail: double dot in atom"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <x.@> "), "ERR mail: trailing dot in atom"
  assert_eq pal("\"\" <jdoe@a..b>  (x(y)z) , <#!$%@example.com>  (x(y)z) , \"\\\\\"@[1.2.3]  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pal("(c) é@[1.2.3]"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("<\"john..doe\"@example.com>,,, \"Joe Q. Public\" <jdoe@x>"), "|john..doe@example.com;Joe Q. Public|jdoe@x"
  assert_eq pal("\"a\\\"b\" <us_er@[::1]> (bad,, \"Joe Q. Public\" é@[256.0.0.1],, <us_er@example.com> "), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("<\"\"@example.com> , é@[256.0.0.1] (comment)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= a..b@, (c) <\"\\\\\"@ex-ample.org> junk, grp: ;"), "ERR mail: no angle-addr"
  assert_eq pal("<jdoe@example.com> (comment)"), "|jdoe@example.com"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <a@b@> (comment),Who? <a@b@[1.2.3]> (bad,=?utf-8?q?J=C3=B6rg?= <\"john..doe\"@x>,"), "ERR mail: unclosed angle-addr"
  assert_eq pal("<.x@[IPv6:1.2.3.4]> ,Who? \"john..doe\"@[a],a.b \"a b\"@[IPv6:1.2.3.4]"), "ERR mail: leading dot in atom"
  assert_eq pal("Who? us_er@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pal("grp: ä ö <us_er@ex-ample.org> junk;,<x.@example.com>,"), "ERR mail: expected comma"
  assert_eq pal("Asem H. a@b@[::1] , a.b \"\"@a..b , <#!$%@x>  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("Böb <\"\\\\\"@a..b>  (x(y)z) , <\"a b\"@[::1]> (bad"), "ERR mail: double dot in atom"
  assert_eq pal("Asem H. \"\\\\\"@x,, a..b@,"), "ERR mail: no angle-addr"
  assert_eq pal("\"Joe Q. Public\" us_er@a..b , <#!$%@> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("<jdoe@[::1]> (comment),us_er@x"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("grp: ;,, a..b@[1.2.3] (comment),, =?x-unknown?q?a?= us_er@[IPv6:::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<\"\"@example.com> "), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("grp: \"Joe Q. Public\" \"\\\\\"@ex-ample.org, =?utf-8?b?QsO2Yg==?= jdoe@ex-ample.org;,John <a..b@a..b>,a..b@[a]  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("<john.doe@x> junk , <x.@a..b> "), "ERR mail: expected comma"
  assert_eq pal("grp: <\"\"@[::1]>,, <x.@[a]> (comment);"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("<x.@a..b> (bad,, ä ö x.@[a],, grp: <us_er@[1.2.3]> (bad, jdoe@[a]  (x(y)z);"), "ERR mail: trailing dot in atom"
  assert_eq pal("john.doe@[1.2.3] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"a\\\"b\" <é@example.com> ,<\"\\\\\"@[1.2.3]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("<\"a b\"@example.com> "), "|a b@example.com"
  assert_eq pal("Who? john.doe@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pal("a@b@ex-ample.org (comment)"), "ERR mail: expected comma"
  assert_eq pal("x.@[192.168.0.1]  (x(y)z), Asem H. <john.doe@>  (x(y)z), #!$%@example.com  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("jdoe@[a] (comment),, jdoe@[256.0.0.1]  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("ä ö jdoe@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= <\"john..doe\"@>,,John Doe é@[IPv6:1.2.3.4],a@b@[256.0.0.1],"), "ERR mail: invalid string"
  assert_eq pal("<.x@x> junk"), "ERR mail: leading dot in atom"
  assert_eq pal("<us_er@x>,, =?utf-8?b?QsO2Yg==?= <a..b@[256.0.0.1]> junk"), "ERR mail: double dot in atom"
  assert_eq pal("grp: =?utf-8?b?QsO2Yg==?= <é@[a]> (bad;"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("\"john..doe\"@[192.168.0.1] (comment)"), "comment|john..doe@[192.168.0.1]"
  assert_eq pal(" #!$%@example.com"), "|#!$%@example.com"
  assert_eq pal("<x.@> (bad"), "ERR mail: trailing dot in atom"
  assert_eq pal("é@[1.2.3] (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"\\\\\"@[256.0.0.1] (comment),grp: ;,\"\" x.@"), "ERR mail: no angle-addr"
  assert_eq pal("<\"a b\"@> junk , John john.doe@x"), "ERR mail: invalid string"
  assert_eq pal("<x.@example.com>,, a.b é@[1.2.3]"), "ERR mail: trailing dot in atom"
  assert_eq pal("ä ö a@b@[a]"), "ERR mail: no angle-addr"
  assert_eq pal("x.@[192.168.0.1] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("#!$%@a..b (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= john.doe@[192.168.0.1],.x@[IPv6:1.2.3.4],.x@[a],"), "ERR mail: no angle-addr"
  assert_eq pal("grp: =?iso-8859-1?q?J=F6rg?= <\"john..doe\"@[1.2.3]> junk;, \"a\\\"b\" <x.@ex-ample.org>,, grp: =?utf-8?q?a?= =?utf-8?q?b?= us_er@example.com;"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("\"john..doe\"@[1.2.3], , \"a b\"@[IPv6:::1],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: jdoe@;,a.b <\"john..doe\"@example.com> ,<jdoe@[IPv6:1.2.3.4]>,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= <#!$%@[192.168.0.1]>"), "Jörg|#!$%@[192.168.0.1]"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= a..b@[256.0.0.1],, a.b <a..b@[192.168.0.1]>,, John .x@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pal("#!$%@[a] (bad,grp: \"\\\\\"@[256.0.0.1] (bad;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("é@[256.0.0.1] ,grp: x: .x@[IPv6:1.2.3.4];,jdoe@[1.2.3]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: =?iso-8859-1?q?J=F6rg?= <\"\\\\\"@a..b> (comment);,, <\"a b\"@a..b> (bad,, é@[1.2.3] (comment)"), "ERR mail: double dot in atom"
  assert_eq pal("<jdoe@[IPv6:1.2.3.4]>  (x(y)z)"), "|jdoe@[IPv6:1.2.3.4]"
  assert_eq pal("John Doe <john.doe@[256.0.0.1]> (comment), =?utf-8?q?a?= =?utf-8?q?b?= \"a b\"@[a]"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("a@b@[256.0.0.1] (bad"), "ERR mail: expected comma"
  assert_eq pal(".x@[IPv6:1.2.3.4] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: (c) x.@[IPv6:1.2.3.4], é@[IPv6:::1] (comment); , grp:  \"\\\\\"@[IPv6:::1], =?x-unknown?q?a?= \"\\\\\"@[256.0.0.1];"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("grp: john.doe@[a] junk, <us_er@[IPv6:::1]> (comment);"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: a@b@[1.2.3],, =?iso-8859-1?q?J=F6rg?= <a..b@[IPv6:1.2.3.4]> (bad;,, \"\"@[1.2.3]  (x(y)z)"), "ERR mail: expected comma"
  assert_eq pal("jdoe@ex-ample.org (comment) , jdoe@example.com "), "comment|jdoe@ex-ample.org;|jdoe@example.com"
  assert_eq pal("ä ö a..b@a..b"), "ERR mail: no angle-addr"
  assert_eq pal("=?x-unknown?q?a?= <\"\\\\\"@example.com> (comment), grp: ;"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal(" \"\\\\\"@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pal("<a@b@x> junk,=?x-unknown?q?a?= <.x@[192.168.0.1]> (comment),x.@ex-ample.org junk"), "ERR mail: unclosed angle-addr"
  assert_eq pal("grp: <\"\"@[256.0.0.1]> junk, x: #!$%@x;"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("<x.@>  (x(y)z), \"a\\\"b\" \"\\\\\"@[IPv6:::1]"), "ERR mail: trailing dot in atom"
  assert_eq pal("<john.doe@[IPv6:1.2.3.4]>, a..b@x (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("ä ö <a..b@[IPv6:::1]> (comment),<john.doe@>,"), "ERR mail: double dot in atom"
  assert_eq pal("John Doe \"\"@x , <\"john..doe\"@[192.168.0.1]>"), "ERR mail: no angle-addr"
  assert_eq pal(" a..b@example.com,, \"\\\\\"@x ,, =?utf-8?q?J=C3=B6rg?= <.x@a..b> "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: a..b@ex-ample.org junk, \"a\\\"b\" \"john..doe\"@example.com; , grp: x.@ex-ample.org junk, \"\" é@;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: <\"\\\\\"@a..b> junk;"), "ERR mail: double dot in atom"
  assert_eq pal("a@b@[IPv6:::1],,<\"\"@a..b> (bad"), "ERR mail: expected comma"
  assert_eq pal("<\"\\\\\"@[256.0.0.1]> "), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("<\"john..doe\"@[192.168.0.1]> ,,  <x.@[a]> (bad,, john.doe@[IPv6:1.2.3.4] (bad"), "ERR mail: trailing dot in atom"
  assert_eq pal("grp: <\"a b\"@[192.168.0.1]>  (x(y)z);"), "|a b@[192.168.0.1]"
  assert_eq pal("grp: x: <john.doe@ex-ample.org>,, <a@b@[IPv6:::1]>  (x(y)z); , (c) <\"john..doe\"@[::1]> (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"\"@example.com  (x(y)z) , grp: <\"\\\\\"@ex-ample.org> ; , grp: ;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"Joe Q. Public\" <é@[192.168.0.1]>"), "Joe Q. Public|é@[192.168.0.1]"
  assert_eq pal("john.doe@, x: a..b@"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= <é@[::1]>  , Who? <\"\\\\\"@[1.2.3]> junk"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal(" a..b@[IPv6:::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<\"john..doe\"@[IPv6:::1]> , =?utf-8?q?a?= =?utf-8?q?b?= \"\"@a..b"), "ERR mail: no angle-addr"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= <x.@a..b> ,x.@[256.0.0.1],é@[IPv6:::1]  (x(y)z)"), "ERR mail: trailing dot in atom"
  assert_eq pal("=?x-unknown?q?a?= <\"a b\"@x> (comment), Böb john.doe@[a]"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("grp: ; , grp: ; , <\"\\\\\"@a..b>  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pal("=?x-unknown?q?a?= john.doe@,, <\"john..doe\"@> (bad"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("Asem H. é@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pal("#!$%@example.com junk,, John Doe .x@[IPv6:::1]"), "ERR mail: expected comma"
  assert_eq pal("grp: ;, grp: <\"\\\\\"@[::1]>, john.doe@a..b;"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("grp: ;, a@b@[IPv6:::1] junk"), "ERR mail: expected comma"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= <\"a b\"@[a]> (comment),x.@example.com (bad,a..b@ (bad"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("John \"john..doe\"@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pal(".x@[192.168.0.1] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= a@b@[1.2.3], <a..b@ex-ample.org>, Asem H. #!$%@x"), "ERR mail: no angle-addr"
  assert_eq pal("grp: =?utf-8?b?QsO2Yg==?= \"\\\\\"@[192.168.0.1], john.doe@[a],;,John a..b@[IPv6:::1],(c) é@[a]"), "ERR mail: no angle-addr"
}

test "vectors: address list 2" {
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= é@ex-ample.org ,  <x.@[1.2.3]> (comment) , \"\\\\\"@ex-ample.org (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("ä ö \"a b\"@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pal("Böb jdoe@[1.2.3] , <é@a..b>"), "ERR mail: no angle-addr"
  assert_eq pal("x: <#!$%@ex-ample.org> (bad,grp: \"\" #!$%@x;"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("John us_er@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal("<\"\\\\\"@[192.168.0.1]>,,\"a\\\"b\" a@b@example.com,é@[192.168.0.1],"), "ERR mail: no angle-addr"
  assert_eq pal("<é@[a]>  (x(y)z),, <\"a b\"@a..b> (bad,, grp: ;"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("grp: =?iso-8859-1?q?J=F6rg?= <us_er@[::1]>, =?x-unknown?q?a?= #!$%@ex-ample.org; , \"a b\"@[a] ,  <.x@ex-ample.org>"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("<.x@a..b> (comment)"), "ERR mail: leading dot in atom"
  assert_eq pal("<\"john..doe\"@a..b> ,(c) jdoe@[::1],\"a b\"@[::1]  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pal("#!$%@[IPv6:::1]  , Asem H. us_er@[1.2.3] , John Doe <jdoe@x> junk"), "ERR mail: no angle-addr"
  assert_eq pal(".x@[192.168.0.1] ,grp: ;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<x.@[a]> (comment)"), "ERR mail: trailing dot in atom"
  assert_eq pal("grp: ;,x.@,<a@b@[IPv6:::1]>,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"a b\"@ "), "ERR mail: no angle-addr"
  assert_eq pal("<john.doe@[::1]> (bad, Who? \"john..doe\"@[192.168.0.1]"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("John Doe <.x@[IPv6:::1]> (bad"), "ERR mail: leading dot in atom"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= <.x@[a]>  , Who? \"\"@[1.2.3]"), "ERR mail: leading dot in atom"
  assert_eq pal("é@ junk, <a@b@[IPv6:::1]>  (x(y)z), =?iso-8859-1?q?J=F6rg?= <jdoe@a..b>,"), "ERR mail: unclosed angle-addr"
  assert_eq pal("<\"\\\\\"@ex-ample.org>,, jdoe@,,, =?utf-8?q?a?= =?utf-8?q?b?= <john.doe@ex-ample.org>  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("ä ö <.x@[IPv6:::1]> (bad , \"\"@ (comment) , =?utf-8?b?QsO2Yg==?= john.doe@[192.168.0.1]"), "ERR mail: leading dot in atom"
  assert_eq pal("<\"\"@[IPv6:::1]> junk,, Böb <\"a b\"@[1.2.3]>,,, =?utf-8?b?QsO2Yg==?= <\"\"@[::1]>  (x(y)z)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("a..b@[IPv6:1.2.3.4] (comment) , grp: (c) <é@ex-ample.org>  (x(y)z), \"john..doe\"@x (bad;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal(" <a..b@[1.2.3]>  , <x.@[1.2.3]> (comment)"), "ERR mail: double dot in atom"
  assert_eq pal("<\"a b\"@example.com> (bad,, John Doe \"\\\\\"@,, <\"\\\\\"@[IPv6:::1]> (comment)"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("\"\" <x.@>  , grp: .x@[IPv6:::1] junk; , grp: =?x-unknown?q?a?= é@[IPv6:1.2.3.4], =?iso-8859-1?q?J=F6rg?= us_er@a..b;"), "ERR mail: trailing dot in atom"
  assert_eq pal("=?x-unknown?q?a?= x.@[256.0.0.1] , x: \"\\\\\"@x , jdoe@[192.168.0.1] (bad"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("\"a b\"@[a] (comment), grp: ;"), "ERR mail: no angle-addr"
  assert_eq pal("<x.@[192.168.0.1]> junk"), "ERR mail: trailing dot in atom"
  assert_eq pal("\"\"@[IPv6:1.2.3.4]  , a.b <\"\"@ex-ample.org>  (x(y)z) , =?x-unknown?q?a?= \"\"@[192.168.0.1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("us_er@[::1] (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("jdoe@[a] (bad , Who? #!$%@ex-ample.org"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"\" <a..b@example.com>"), "ERR mail: double dot in atom"
  assert_eq pal("grp: ; , \"Joe Q. Public\" jdoe@[a] , grp: \"a\\\"b\" <\"\"@[256.0.0.1]> , <.x@x> ;"), "ERR mail: no angle-addr"
  assert_eq pal("grp: x: <.x@x> ;,, =?utf-8?q?J=C3=B6rg?= \"\\\\\"@ex-ample.org"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<jdoe@[1.2.3]> (comment) , <#!$%@[a]>, , grp: ;"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("grp: <a@b@> ; , Böb <jdoe@example.com> (bad"), "ERR mail: unclosed angle-addr"
  assert_eq pal("<\"\\\\\"@[192.168.0.1]> "), "|\\@[192.168.0.1]"
  assert_eq pal("\"\"@[256.0.0.1] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<x.@ex-ample.org>  (x(y)z), <\"\"@[a]> , <a..b@[1.2.3]>"), "ERR mail: trailing dot in atom"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <#!$%@[::1]> , x: <#!$%@> , <x.@[IPv6:1.2.3.4]> (comment)"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal(".x@[a]  (x(y)z),grp: ;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<\"\"@a..b>,, <jdoe@ex-ample.org> junk, (c) é@a..b"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("John é@[256.0.0.1] , grp: ; , grp: ;"), "ERR mail: no angle-addr"
  assert_eq pal("us_er@[1.2.3],,, =?utf-8?q?J=C3=B6rg?= \"a b\"@[IPv6:1.2.3.4],, john.doe@[IPv6:::1]  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<x.@[1.2.3]> junk"), "ERR mail: trailing dot in atom"
  assert_eq pal("Who? a@b@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pal("grp: \"a\\\"b\" us_er@[::1];,.x@[a] ,john.doe@[192.168.0.1] "), "ERR mail: no angle-addr"
  assert_eq pal("\"\" a@b@a..b"), "ERR mail: no angle-addr"
  assert_eq pal("<é@[IPv6:::1]>,"), "|é@[IPv6:::1]"
  assert_eq pal("<a@b@[IPv6:1.2.3.4]>  (x(y)z) , us_er@[192.168.0.1]  , \"a\\\"b\" #!$%@example.com"), "ERR mail: unclosed angle-addr"
  assert_eq pal("<\"\"@x> (bad, =?iso-8859-1?q?J=F6rg?= <a..b@[::1]> (bad, Who? \"\\\\\"@[192.168.0.1]"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("<john.doe@ex-ample.org> (bad,\"a\\\"b\" us_er@[a]"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("grp: ; , grp: ; ,  <jdoe@ex-ample.org> (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("=?x-unknown?q?a?= <\"john..doe\"@[IPv6:::1]>,, <#!$%@example.com> (comment),, =?iso-8859-1?q?J=F6rg?= x.@[IPv6:::1]"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("\"\\\\\"@[::1]  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("x.@[IPv6:::1] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: =?x-unknown?q?a?= \"\\\\\"@[a], x: <#!$%@[IPv6:::1]> ;,=?utf-8?q?J=C3=B6rg?= é@example.com"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("a.b <a..b@a..b>,,a@b@[::1] (bad,<.x@ex-ample.org>"), "ERR mail: double dot in atom"
  assert_eq pal("<\"a b\"@[256.0.0.1]> (bad"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("\"a b\"@[1.2.3],  a@b@[a]"), "ERR mail: no angle-addr"
  assert_eq pal("grp: <jdoe@[a]> ;,\"\" jdoe@ex-ample.org"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("é@[::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"a\\\"b\" <john.doe@[256.0.0.1]> (bad, grp: ;"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= <\"\"@[192.168.0.1]>  , \"Joe Q. Public\" \"\"@a..b"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("grp: ;,, x.@[a] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= .x@[256.0.0.1],  john.doe@"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= <#!$%@a..b>  , grp: <john.doe@x> (bad, a@b@[a] junk; , \"\"@[192.168.0.1]  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pal("Who? <#!$%@[IPv6:::1]> junk"), "ERR mail: expected comma"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= <us_er@[IPv6:::1]>"), "Jörg|us_er@[IPv6:::1]"
  assert_eq pal("grp: ; , John x.@ex-ample.org , Who? <us_er@[::1]>  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("John Doe \"\\\\\"@[IPv6:::1], <us_er@[1.2.3]> junk"), "ERR mail: no angle-addr"
  assert_eq pal("Böb <\"john..doe\"@[1.2.3]> junk"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("<\"\\\\\"@ex-ample.org> (comment),, grp: (c) x.@example.com, =?utf-8?q?a?= =?utf-8?q?b?= us_er@a..b;,, x: <\"a b\"@[IPv6:::1]>  (x(y)z)"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("grp: Böb <\"\"@[256.0.0.1]> junk, =?utf-8?q?J=C3=B6rg?= \"john..doe\"@example.com;"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("a@b@example.com"), "ERR mail: expected comma"
  assert_eq pal("\"Joe Q. Public\" #!$%@[a], \"Joe Q. Public\" <a..b@[a]>"), "ERR mail: no angle-addr"
  assert_eq pal("=?x-unknown?q?a?= #!$%@[1.2.3], <a@b@a..b> junk"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("\"a b\"@[a] junk"), "ERR mail: no angle-addr"
  assert_eq pal("john.doe@[::1] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"\" jdoe@[256.0.0.1], Who? a@b@[a], \"Joe Q. Public\" #!$%@[::1]"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= \"a b\"@, <\"a b\"@example.com>  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("<é@x> "), "|é@x"
  assert_eq pal("\"john..doe\"@ex-ample.org ,, us_er@[192.168.0.1] junk"), "ERR mail: expected comma"
  assert_eq pal("us_er@[IPv6:::1] (comment) , =?iso-8859-1?q?J=F6rg?= \"john..doe\"@[::1]"), "ERR mail: no angle-addr"
  assert_eq pal("\"Joe Q. Public\" john.doe@[IPv6:::1] , \"\\\\\"@[a],"), "ERR mail: no angle-addr"
  assert_eq pal("\"\"@[IPv6:1.2.3.4]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<\"\"@a..b> (comment), <jdoe@ex-ample.org> "), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("<\"john..doe\"@> junk , <\"\"@a..b> junk"), "ERR mail: invalid string"
  assert_eq pal("\"a b\"@[1.2.3],"), "ERR mail: no angle-addr"
  assert_eq pal("\"Joe Q. Public\" é@,grp: Asem H. <\"a b\"@ex-ample.org>  (x(y)z), ä ö jdoe@;,\"Joe Q. Public\" <#!$%@[192.168.0.1]> "), "ERR mail: no angle-addr"
  assert_eq pal("grp:  <é@> junk;,, =?iso-8859-1?q?J=F6rg?= <jdoe@x> (comment),, John Doe \"\\\\\"@"), "ERR mail: invalid string"
  assert_eq pal(" \"\\\\\"@[1.2.3],, #!$%@[1.2.3],"), "ERR mail: no angle-addr"
  assert_eq pal("<john.doe@[256.0.0.1]>  (x(y)z) , =?iso-8859-1?q?J=F6rg?= \"\\\\\"@x"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("\"a\\\"b\" x.@[::1] , <é@[::1]> (bad"), "ERR mail: no angle-addr"
  assert_eq pal("Asem H. #!$%@[IPv6:1.2.3.4],, ä ö <#!$%@[192.168.0.1]>,"), "ERR mail: no angle-addr"
  assert_eq pal("\"\\\\\"@[a] ,, Who? <\"a b\"@[256.0.0.1]> (bad"), "ERR mail: no angle-addr"
  assert_eq pal("grp: <é@[::1]>  (x(y)z);, a.b <\"\\\\\"@example.com> (comment), Asem H. \"a b\"@"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("grp: a.b a..b@[IPv6:::1], <é@[1.2.3]>; , Böb <john.doe@[::1]> , \"john..doe\"@[IPv6:1.2.3.4],"), "ERR mail: no angle-addr"
  assert_eq pal("grp: <\"john..doe\"@ex-ample.org> (comment), =?utf-8?q?J=C3=B6rg?= <\"\"@[a]> (bad;"), "ERR mail: empty quoted string in addr-spec"
}

test "vectors: address list 3" {
  assert_eq pal("a..b@x,=?utf-8?q?a?= =?utf-8?q?b?= é@example.com"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("John us_er@a..b"), "ERR mail: no angle-addr"
  assert_eq pal("Böb a..b@ , Asem H. <john.doe@[1.2.3]>  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("grp: \"\" .x@ex-ample.org, Asem H. <é@[a]> junk;, grp: ;"), "ERR mail: no angle-addr"
  assert_eq pal("é@[192.168.0.1]  (x(y)z),<.x@[a]> junk"), "ERR mail: leading dot in atom"
  assert_eq pal("John Doe <#!$%@a..b>,grp: ;,Asem H. <.x@[1.2.3]>,"), "ERR mail: double dot in atom"
  assert_eq pal("grp: ;, \"\"@[IPv6:::1]  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"\" us_er@example.com, <x.@[::1]> (comment), <jdoe@[::1]> (bad"), "ERR mail: no angle-addr"
  assert_eq pal("<x.@>, ,  <\"john..doe\"@ex-ample.org>  (x(y)z)"), "ERR mail: trailing dot in atom"
  assert_eq pal("grp: ;, grp: \"\\\\\"@[256.0.0.1],, \"\" <john.doe@[a]> (comment);, (c) john.doe@a..b"), "ERR mail: no angle-addr"
  assert_eq pal("<a..b@ex-ample.org> junk"), "ERR mail: double dot in atom"
  assert_eq pal("Asem H. us_er@[IPv6:::1],john.doe@[192.168.0.1] (bad,<\"\"@x> "), "ERR mail: no angle-addr"
  assert_eq pal("grp: ;, Who? <\"john..doe\"@[::1]> "), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= <x.@[a]> (comment) , grp: =?iso-8859-1?q?J=F6rg?= <john.doe@[256.0.0.1]> ;"), "ERR mail: trailing dot in atom"
  assert_eq pal("John <jdoe@[IPv6:::1]>  , Asem H. <#!$%@[192.168.0.1]>  (x(y)z) , grp: .x@x, \"\"@[IPv6:1.2.3.4] junk;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<us_er@x> (comment),=?iso-8859-1?q?J=F6rg?= <x.@ex-ample.org>,<us_er@[a]> (comment)"), "ERR mail: trailing dot in atom"
  assert_eq pal("us_er@[a]  (x(y)z), \"\" #!$%@[::1], <#!$%@[256.0.0.1]> (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"a\\\"b\" john.doe@[::1], \"\"@example.com (bad"), "ERR mail: no angle-addr"
  assert_eq pal("\"Joe Q. Public\" <\"john..doe\"@x>  , a@b@[IPv6:::1],"), "ERR mail: expected comma"
  assert_eq pal("\"\\\\\"@[256.0.0.1]  (x(y)z),=?utf-8?b?QsO2Yg==?= <x.@[256.0.0.1]> ,\"\"@[256.0.0.1] junk"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= <\"\"@[256.0.0.1]> junk , ä ö <a@b@a..b>  (x(y)z)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("grp: =?utf-8?q?a?= =?utf-8?q?b?= \"john..doe\"@[::1], <jdoe@[1.2.3]> (bad;,=?utf-8?q?J=C3=B6rg?= <us_er@[a]> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("grp: ;,, John Doe <é@x> (comment)"), "John Doe|é@x"
  assert_eq pal("Who? <john.doe@[IPv6:1.2.3.4]> junk, Who? <us_er@example.com> (bad"), "ERR mail: expected comma"
  assert_eq pal("é@ex-ample.org junk , x.@[256.0.0.1] (bad"), "ERR mail: expected comma"
  assert_eq pal("x: <a..b@[192.168.0.1]>,"), "ERR mail: double dot in atom"
  assert_eq pal("a.b é@[::1]"), "ERR mail: no angle-addr"
  assert_eq pal("<jdoe@[a]> "), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("grp: Böb <\"\\\\\"@ex-ample.org>  (x(y)z), jdoe@ex-ample.org,;"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("a.b <.x@[::1]> ,\"a\\\"b\" a..b@[1.2.3],<john.doe@[192.168.0.1]>,"), "ERR mail: leading dot in atom"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= <.x@[a]> (comment),, <john.doe@[1.2.3]>"), "ERR mail: leading dot in atom"
  assert_eq pal("a@b@  (x(y)z), =?iso-8859-1?q?J=F6rg?= <#!$%@[192.168.0.1]> junk"), "ERR mail: expected comma"
  assert_eq pal("John Doe us_er@x , =?utf-8?b?QsO2Yg==?= <a..b@[IPv6:1.2.3.4]>  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("<.x@a..b> "), "ERR mail: leading dot in atom"
  assert_eq pal("grp: ä ö <x.@ex-ample.org> (comment);"), "ERR mail: trailing dot in atom"
  assert_eq pal("grp: <x.@[::1]>  (x(y)z);,, <.x@x>,,, grp: <a@b@> (bad;"), "ERR mail: trailing dot in atom"
  assert_eq pal("a@b@[192.168.0.1] junk , =?x-unknown?q?a?= <john.doe@[IPv6:::1]> "), "ERR mail: expected comma"
  assert_eq pal("\"\" us_er@ex-ample.org,ä ö x.@[a],ä ö x.@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal("\"Joe Q. Public\" <a..b@[IPv6:1.2.3.4]> "), "ERR mail: double dot in atom"
  assert_eq pal("grp: x: \"\"@a..b, (c) \"a b\"@example.com;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: ;,, <\"\"@x> ,, John <\"a b\"@[256.0.0.1]>"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("grp: <x.@[IPv6:::1]> junk, Böb <us_er@x> (bad;"), "ERR mail: trailing dot in atom"
  assert_eq pal("<a..b@[::1]> junk, \"\" <x.@[256.0.0.1]>,"), "ERR mail: double dot in atom"
  assert_eq pal("<x.@[256.0.0.1]> , \"a b\"@[256.0.0.1], , =?x-unknown?q?a?= <us_er@[192.168.0.1]> (comment)"), "ERR mail: trailing dot in atom"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= #!$%@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pal("\"Joe Q. Public\" <a@b@x>, , <\"a b\"@[a]> junk , a..b@[a]  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pal("<\"john..doe\"@[a]> junk"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("\"Joe Q. Public\" \"\\\\\"@ex-ample.org,John Doe <é@[::1]>"), "ERR mail: no angle-addr"
  assert_eq pal("grp: a@b@[192.168.0.1];"), "ERR mail: expected comma"
  assert_eq pal("é@[192.168.0.1] (bad,<a..b@example.com>"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("John Doe .x@[a] , <\"\"@[::1]> "), "ERR mail: no angle-addr"
  assert_eq pal("grp: ; , <é@[1.2.3]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("John a..b@[IPv6:::1],grp: \"\" jdoe@[a];,\"a b\"@ex-ample.org junk"), "ERR mail: no angle-addr"
  assert_eq pal("\"Joe Q. Public\" <a@b@[256.0.0.1]>,"), "ERR mail: unclosed angle-addr"
  assert_eq pal("é@  , john.doe@[IPv6:1.2.3.4] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("John Doe <\"a b\"@ex-ample.org> (bad,, grp: <\"\"@[192.168.0.1]>,  .x@[1.2.3];,, <\"a b\"@> junk"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("Asem H. \"john..doe\"@[IPv6:1.2.3.4],=?utf-8?q?a?= =?utf-8?q?b?= #!$%@a..b,John .x@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pal("\"\"@x (comment),, John <\"john..doe\"@example.com>  (x(y)z),, john.doe@[1.2.3] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: x: \"john..doe\"@[1.2.3];, =?x-unknown?q?a?= <x.@ex-ample.org> (bad, <john.doe@[IPv6:::1]> junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<\"a b\"@[192.168.0.1]> ,, .x@[a] (comment),, =?utf-8?q?J=C3=B6rg?= <\"\"@[::1]> junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<\"\"@x> junk,, \"john..doe\"@[1.2.3],, \"john..doe\"@[256.0.0.1] (comment)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= x.@[a]"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= jdoe@[IPv6:1.2.3.4] , (c) <a@b@[a]> (bad , grp: =?iso-8859-1?q?J=F6rg?= <a..b@[256.0.0.1]> (comment);"), "ERR mail: no angle-addr"
  assert_eq pal("\"a b\"@[a]  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("grp: ; , <\"\"@[256.0.0.1]>, , grp: =?utf-8?b?QsO2Yg==?= <a..b@[256.0.0.1]> (comment), <\"john..doe\"@x>,;"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= <\"\\\\\"@> (comment), <\"\"@[1.2.3]> (bad"), "ERR mail: invalid string"
  assert_eq pal("Asem H. x.@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pal("\"a\\\"b\" <\"john..doe\"@ex-ample.org> junk, a.b <é@ex-ample.org> junk, a..b@[a] (bad"), "ERR mail: expected comma"
  assert_eq pal("jdoe@[192.168.0.1] junk, \"\"@[256.0.0.1] (comment), grp: <.x@> ;"), "ERR mail: expected comma"
  assert_eq pal("John john.doe@[IPv6:1.2.3.4],,  .x@x"), "ERR mail: no angle-addr"
  assert_eq pal("john.doe@[IPv6:1.2.3.4] "), "|john.doe@[IPv6:1.2.3.4]"
  assert_eq pal("\"\\\\\"@x junk"), "ERR mail: expected comma"
  assert_eq pal("John Doe <us_er@ex-ample.org> junk , grp: ;"), "ERR mail: expected comma"
  assert_eq pal("\"a b\"@ex-ample.org junk,, grp: <\"\\\\\"@x>,;"), "ERR mail: expected comma"
  assert_eq pal("<\"john..doe\"@[192.168.0.1]>  (x(y)z)"), "|john..doe@[192.168.0.1]"
  assert_eq pal("John <x.@[IPv6:1.2.3.4]>, a@b@[192.168.0.1],"), "ERR mail: trailing dot in atom"
  assert_eq pal("grp: ;,<us_er@[1.2.3]> junk,<us_er@[IPv6:::1]>"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("<.x@ex-ample.org> (comment)"), "ERR mail: leading dot in atom"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= john.doe@a..b"), "ERR mail: no angle-addr"
  assert_eq pal("grp: é@ex-ample.org  (x(y)z);"), "x(y)z|é@ex-ample.org"
  assert_eq pal("jdoe@ex-ample.org junk,Who? <é@>,x.@[IPv6:::1]"), "ERR mail: expected comma"
  assert_eq pal("grp: ;,grp: ä ö #!$%@[IPv6:::1];,grp: ;"), "ERR mail: no angle-addr"
  assert_eq pal("<john.doe@[a]> (bad,, a.b <\"\\\\\"@a..b> junk,, é@[256.0.0.1] junk"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("John Doe \"john..doe\"@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pal("<\"a b\"@example.com>"), "|a b@example.com"
  assert_eq pal("<é@>,, grp: ;"), "ERR mail: invalid string"
  assert_eq pal("grp: ; , Who? <x.@example.com> junk"), "ERR mail: trailing dot in atom"
  assert_eq pal("<\"a b\"@[IPv6:::1]>  (x(y)z),a@b@  (x(y)z)"), "ERR mail: expected comma"
  assert_eq pal("a.b \"john..doe\"@[192.168.0.1], grp: <john.doe@example.com>,, <#!$%@[a]> junk;, x: us_er@[a]"), "ERR mail: no angle-addr"
  assert_eq pal("Böb \"john..doe\"@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pal("\"john..doe\"@[IPv6:::1]  (x(y)z),, <\"john..doe\"@[192.168.0.1]> junk"), "ERR mail: expected comma"
  assert_eq pal("Asem H. .x@[IPv6:1.2.3.4], \"\\\\\"@[1.2.3] (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("\"a\\\"b\" <a..b@x> junk , Asem H. x.@a..b"), "ERR mail: double dot in atom"
  assert_eq pal("a..b@[IPv6:::1] (bad , a..b@example.com junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("John Doe \"john..doe\"@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal("<\"john..doe\"@[a]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("<john.doe@[::1]> junk"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("a.b <é@example.com>  , grp: ; , x: \"\"@[::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("a.b #!$%@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal("John Doe us_er@x, grp: jdoe@[192.168.0.1],;, grp: .x@x, <\"a b\"@[IPv6:1.2.3.4]> junk;"), "ERR mail: no angle-addr"
}

test "vectors: address list 4" {
  assert_eq pal("grp: Böb é@, john.doe@example.com (bad;,, \"john..doe\"@example.com ,, grp: x: jdoe@a..b, a.b <a..b@a..b> (comment);"), "ERR mail: no angle-addr"
  assert_eq pal("<#!$%@> (bad"), "ERR mail: invalid string"
  assert_eq pal("é@a..b"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal(" \"\\\\\"@x"), "|\\@x"
  assert_eq pal("grp: #!$%@ex-ample.org (comment), (c) a..b@[::1]; , \"john..doe\"@a..b  , John Doe <a@b@[a]> (bad"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= a@b@[a], =?utf-8?q?a?= =?utf-8?q?b?= <a..b@[IPv6:::1]>  (x(y)z), #!$%@[256.0.0.1] "), "ERR mail: no angle-addr"
  assert_eq pal("grp: =?utf-8?q?J=C3=B6rg?= us_er@[192.168.0.1], =?utf-8?b?QsO2Yg==?= <a@b@[IPv6:1.2.3.4]> (bad;"), "ERR mail: no angle-addr"
  assert_eq pal("Who? <\"\\\\\"@[IPv6:::1]> junk"), "ERR mail: expected comma"
  assert_eq pal("grp: a.b <x.@[a]>;, <john.doe@> "), "ERR mail: trailing dot in atom"
  assert_eq pal("<us_er@[::1]>  (x(y)z), grp: John a..b@a..b, \"\" <\"a b\"@[192.168.0.1]> (comment);"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("Asem H. us_er@example.com,grp: <us_er@[IPv6:1.2.3.4]> , <\"john..doe\"@example.com> ;"), "ERR mail: no angle-addr"
  assert_eq pal("Asem H. <é@example.com> (bad,grp: ä ö .x@[1.2.3], =?iso-8859-1?q?J=F6rg?= <\"a b\"@example.com>,;,grp: \"\"@[a],;"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <a@b@>,, grp: John Doe .x@[a], Who? <jdoe@ex-ample.org>  (x(y)z);"), "ERR mail: unclosed angle-addr"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= \"a b\"@ex-ample.org,<\"a b\"@[256.0.0.1]>  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("grp: \"\"@[IPv6:1.2.3.4] , <#!$%@ex-ample.org>  (x(y)z);"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= jdoe@ex-ample.org, =?utf-8?q?J=C3=B6rg?= <#!$%@[IPv6:::1]> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("x.@[IPv6:1.2.3.4] , a..b@[::1] junk , =?utf-8?q?J=C3=B6rg?= é@a..b"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"\\\\\"@a..b,"), "ERR mail: no angle-addr"
  assert_eq pal("grp: \"Joe Q. Public\" a..b@[256.0.0.1], Böb <a@b@[::1]> (comment);,, #!$%@[::1],"), "ERR mail: no angle-addr"
  assert_eq pal("\"a\\\"b\" <a..b@a..b>  (x(y)z), <.x@>,.x@[a] (comment)"), "ERR mail: double dot in atom"
  assert_eq pal("John Doe <\"john..doe\"@[1.2.3]> (bad,<a@b@x>  (x(y)z),grp: \"a b\"@[192.168.0.1] (comment);"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("<.x@[1.2.3]>  (x(y)z), \"\\\\\"@[256.0.0.1], a..b@[IPv6:::1],"), "ERR mail: leading dot in atom"
  assert_eq pal("Who? \"john..doe\"@[::1]"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= a@b@[256.0.0.1] , \"a\\\"b\" <.x@a..b> (bad"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <jdoe@x>, , John Doe #!$%@[a]"), "ERR mail: no angle-addr"
  assert_eq pal("John Doe <jdoe@[1.2.3]> (bad , <john.doe@a..b>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal(" \"john..doe\"@[IPv6:::1], grp: ;"), "|john..doe@[IPv6:::1]"
  assert_eq pal("jdoe@[IPv6:1.2.3.4] "), "|jdoe@[IPv6:1.2.3.4]"
  assert_eq pal("grp: #!$%@a..b (comment);"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"a\\\"b\" us_er@[256.0.0.1],, a@b@[256.0.0.1] ,, x: \"\\\\\"@example.com"), "ERR mail: no angle-addr"
  assert_eq pal("\"a\\\"b\" .x@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pal("John .x@[IPv6:1.2.3.4],, a@b@[IPv6:1.2.3.4] (comment),, john.doe@[IPv6:1.2.3.4]  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("a.b <#!$%@[IPv6:1.2.3.4]>,"), "a.b|#!$%@[IPv6:1.2.3.4]"
  assert_eq pal("#!$%@x junk,=?utf-8?q?a?= =?utf-8?q?b?= <\"john..doe\"@a..b>"), "ERR mail: expected comma"
  assert_eq pal("<a..b@a..b> , \"john..doe\"@[256.0.0.1], , <a@b@[IPv6:::1]>,"), "ERR mail: double dot in atom"
  assert_eq pal("us_er@[192.168.0.1],"), "|us_er@[192.168.0.1]"
  assert_eq pal("<\"\"@a..b> (bad , <a@b@[1.2.3]> (comment)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("Who? \"\"@ex-ample.org,grp: ;"), "ERR mail: no angle-addr"
  assert_eq pal("a.b \"a b\"@x,Asem H. <é@[::1]> "), "ERR mail: no angle-addr"
  assert_eq pal("=?x-unknown?q?a?= \"\\\\\"@[1.2.3] , \"a\\\"b\" \"\"@[256.0.0.1] , =?utf-8?q?a?= =?utf-8?q?b?= #!$%@[192.168.0.1]"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("<us_er@[192.168.0.1]> junk, Böb <a..b@[IPv6:1.2.3.4]> "), "ERR mail: expected comma"
  assert_eq pal("\"Joe Q. Public\" #!$%@example.com , <a..b@[IPv6:::1]> "), "ERR mail: no angle-addr"
  assert_eq pal("a..b@[a] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<john.doe@[256.0.0.1]>,, é@[IPv6:1.2.3.4],, =?iso-8859-1?q?J=F6rg?= john.doe@[IPv6:1.2.3.4]"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("\"Joe Q. Public\" <\"\\\\\"@[a]>  (x(y)z),<.x@[IPv6:1.2.3.4]>  (x(y)z),<x.@[1.2.3]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("<john.doe@[a]> junk,, Böb <a..b@ex-ample.org>"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= <jdoe@[192.168.0.1]>  , =?x-unknown?q?a?= <é@[::1]>  , \"a\\\"b\" \"\"@[::1]"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal(".x@[256.0.0.1] (bad, <\"john..doe\"@x> , =?utf-8?b?QsO2Yg==?= <john.doe@[1.2.3]>  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: ;,Who? #!$%@"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= x.@[256.0.0.1] , <\"john..doe\"@example.com> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("<us_er@example.com>,, grp: ;"), "|us_er@example.com"
  assert_eq pal("grp: ; , x: <é@[192.168.0.1]> "), "ERR mail: expected comma"
  assert_eq pal("Who? <a..b@example.com> (bad"), "ERR mail: double dot in atom"
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= <a@b@example.com> (comment),<a@b@example.com> ,\"a b\"@[IPv6:::1] (bad"), "ERR mail: unclosed angle-addr"
  assert_eq pal("a.b <jdoe@[IPv6:::1]> (bad, .x@[IPv6:::1] "), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("(c) \"a b\"@[::1],a.b <a..b@example.com> junk"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("John \"a b\"@[a]"), "ERR mail: no angle-addr"
  assert_eq pal("#!$%@a..b,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("us_er@a..b "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<#!$%@[1.2.3]> (comment),grp: ;"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= <\"john..doe\"@example.com> (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("grp: \"\\\\\"@a..b, a.b .x@[256.0.0.1];"), "ERR mail: no angle-addr"
  assert_eq pal("Böb <\"a b\"@example.com> (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("\"Joe Q. Public\" é@ , =?utf-8?q?J=C3=B6rg?= x.@ex-ample.org , \"a\\\"b\" \"\\\\\"@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal("<\"\\\\\"@[256.0.0.1]> (comment), =?utf-8?q?a?= =?utf-8?q?b?= .x@[IPv6:::1], grp: (c) <jdoe@example.com>,, Böb <\"john..doe\"@example.com> (bad;"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("\"a b\"@x junk,, grp: .x@x (comment);"), "ERR mail: expected comma"
  assert_eq pal("x: <#!$%@[a]>  (x(y)z),Böb <#!$%@[IPv6:1.2.3.4]>"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("grp: <é@[256.0.0.1]> , \"Joe Q. Public\" <#!$%@example.com> (comment);,\"\\\\\"@a..b (bad"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("<.x@a..b> (bad,\"a\\\"b\" \"john..doe\"@[256.0.0.1],=?iso-8859-1?q?J=F6rg?= \"a b\"@example.com"), "ERR mail: leading dot in atom"
  assert_eq pal("grp: <a@b@x>, Asem H. <\"john..doe\"@[IPv6:1.2.3.4]> (bad;,, grp: jdoe@ junk;"), "ERR mail: unclosed angle-addr"
  assert_eq pal("jdoe@[1.2.3] , \"\"@[IPv6:1.2.3.4] junk , grp: Who? <é@[::1]> (comment);"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("x: \"\\\\\"@a..b , =?utf-8?q?J=C3=B6rg?= é@example.com , =?utf-8?q?a?= =?utf-8?q?b?= <\"a b\"@[a]> (bad"), "ERR mail: no angle-addr"
  assert_eq pal("grp: é@[::1];,grp: John Doe <é@a..b> (bad, \"a\\\"b\" <john.doe@example.com> junk;,=?iso-8859-1?q?J=F6rg?= <john.doe@[IPv6:1.2.3.4]> (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<é@[1.2.3]> (comment),x: a@b@[256.0.0.1]"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("Böb <é@> junk, #!$%@ex-ample.org,, <é@[1.2.3]> junk"), "ERR mail: invalid string"
  assert_eq pal("grp: <\"\\\\\"@[192.168.0.1]>  (x(y)z); ,  <x.@> junk , John Doe \"a b\"@[a]"), "ERR mail: trailing dot in atom"
  assert_eq pal("<#!$%@> (bad , (c) <a@b@[256.0.0.1]> (comment) , john.doe@[IPv6:1.2.3.4] junk"), "ERR mail: invalid string"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= x.@[1.2.3],, =?utf-8?q?J=C3=B6rg?= <jdoe@a..b> (bad"), "ERR mail: no angle-addr"
  assert_eq pal("a.b a@b@example.com"), "ERR mail: no angle-addr"
  assert_eq pal(" <a..b@[256.0.0.1]>, \"Joe Q. Public\" us_er@a..b, \"a\\\"b\" <é@x> (bad"), "ERR mail: double dot in atom"
  assert_eq pal("a.b \"a b\"@x"), "ERR mail: no angle-addr"
  assert_eq pal("<a@b@[192.168.0.1]>, , <a@b@[192.168.0.1]> junk"), "ERR mail: unclosed angle-addr"
  assert_eq pal("\"Joe Q. Public\" é@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal(" <us_er@[256.0.0.1]> junk,us_er@[IPv6:1.2.3.4] (bad"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("\"\" <\"\"@> (comment),, <\"a b\"@>"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("grp: ;,\"\" <jdoe@[256.0.0.1]> (comment),grp: \"\"@a..b (bad;"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("John a@b@[192.168.0.1] , grp: ; , <john.doe@[1.2.3]>"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <\"john..doe\"@a..b> , <a@b@example.com> , \"a\\\"b\" <us_er@a..b>,"), "ERR mail: double dot in atom"
  assert_eq pal("us_er@a..b  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("a@b@a..b , <é@a..b> "), "ERR mail: expected comma"
  assert_eq pal("<\"\\\\\"@[1.2.3]> (comment) , John Doe <jdoe@x> (bad , John <é@[IPv6:1.2.3.4]> (comment)"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= .x@[a],, <jdoe@example.com> (bad"), "ERR mail: no angle-addr"
  assert_eq pal("grp: <us_er@example.com> , =?x-unknown?q?a?= a@b@[256.0.0.1];"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("\"\\\\\"@[1.2.3] (comment), a..b@[IPv6:1.2.3.4] junk, a@b@[192.168.0.1] junk"), "ERR mail: no angle-addr"
  assert_eq pal("\"\\\\\"@[IPv6:1.2.3.4],x.@[256.0.0.1]  (x(y)z),\"\"@  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= <a..b@[1.2.3]> "), "ERR mail: double dot in atom"
  assert_eq pal("john.doe@a..b"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal(".x@a..b (bad , <x.@[192.168.0.1]> (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("(c) <\"john..doe\"@x> junk,John Doe x.@x,(c) é@ex-ample.org"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("\"\"@[192.168.0.1],"), "ERR mail: missing '@' or angle-addr"
}

test "vectors: address list 5" {
  assert_eq pal("x.@ junk,, x.@[1.2.3] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<john.doe@[192.168.0.1]>  (x(y)z) , =?utf-8?q?a?= =?utf-8?q?b?= #!$%@[IPv6:1.2.3.4] , grp: <#!$%@[192.168.0.1]> junk;"), "ERR mail: no angle-addr"
  assert_eq pal("#!$%@a..b junk , \"Joe Q. Public\" <john.doe@>,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: <.x@[256.0.0.1]> ;,, <a..b@example.com>  (x(y)z),, <\"\\\\\"@[256.0.0.1]> (bad"), "ERR mail: leading dot in atom"
  assert_eq pal("é@example.com,,ä ö \"\\\\\"@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pal("<#!$%@[a]>,, \"a b\"@example.com junk"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("(c) <.x@[IPv6:1.2.3.4]> ,, #!$%@[::1] junk,,  é@x"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("ä ö \"a b\"@x"), "ERR mail: no angle-addr"
  assert_eq pal("Who? <a@b@x> "), "ERR mail: unclosed angle-addr"
  assert_eq pal("<a@b@>, <#!$%@example.com>, ä ö <\"john..doe\"@[192.168.0.1]> junk"), "ERR mail: unclosed angle-addr"
  assert_eq pal("grp: \"john..doe\"@[1.2.3] , Böb a@b@[IPv6:::1];"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<us_er@[192.168.0.1]> (bad, ä ö <é@[::1]> (comment), a.b jdoe@x"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("a.b .x@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?q?a?= =?utf-8?q?b?= a..b@[IPv6:::1],, =?utf-8?q?a?= =?utf-8?q?b?= john.doe@[256.0.0.1],, grp: \"Joe Q. Public\" x.@[192.168.0.1];"), "ERR mail: no angle-addr"
  assert_eq pal("#!$%@[IPv6:::1],,, (c) <a@b@[IPv6:::1]> (bad,, John Doe john.doe@x"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("Who? <a@b@example.com> ,Böb <us_er@> junk,=?iso-8859-1?q?J=F6rg?= .x@[192.168.0.1]"), "ERR mail: unclosed angle-addr"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <\"\\\\\"@[IPv6:1.2.3.4]>"), "Böb|\\@[IPv6:1.2.3.4]"
  assert_eq pal("<\"a b\"@[256.0.0.1]>  (x(y)z), Who? jdoe@example.com"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= a@b@a..b,, x: <x.@> junk"), "ERR mail: no angle-addr"
  assert_eq pal("\"a\\\"b\" \"\"@[192.168.0.1],.x@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal("Böb <jdoe@[::1]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("grp: ä ö <\"\\\\\"@[256.0.0.1]> , ä ö \"john..doe\"@[::1];, \"Joe Q. Public\" a..b@[1.2.3], <.x@x>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal("<a@b@[256.0.0.1]>  (x(y)z),, <x.@[IPv6:::1]> (bad,, grp: ;"), "ERR mail: unclosed angle-addr"
  assert_eq pal(".x@[a]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: Asem H. <\"john..doe\"@[a]> , <us_er@[a]>;"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("ä ö john.doe@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pal("<\"\"@a..b> , John Doe <jdoe@[192.168.0.1]> (bad, <\"\\\\\"@x> junk"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("<x.@[IPv6:::1]> (bad"), "ERR mail: trailing dot in atom"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= jdoe@[1.2.3],\"Joe Q. Public\" \"john..doe\"@a..b,<x.@[a]> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("a.b .x@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pal("Who? a@b@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pal("=?x-unknown?q?a?= <x.@a..b> , \"john..doe\"@[256.0.0.1]  (x(y)z) , <\"a b\"@[1.2.3]>  (x(y)z)"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("a.b \"a b\"@a..b,<#!$%@[IPv6:1.2.3.4]>"), "ERR mail: no angle-addr"
  assert_eq pal("grp: \"a\\\"b\" x.@ex-ample.org;"), "ERR mail: no angle-addr"
  assert_eq pal("<x.@ex-ample.org> ,, Who? <é@[256.0.0.1]> (comment),, a..b@x,"), "ERR mail: trailing dot in atom"
  assert_eq pal("é@a..b "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<.x@x>,,, \"\" <\"\"@x> (comment)"), "ERR mail: leading dot in atom"
  assert_eq pal("\"\" a..b@example.com"), "ERR mail: no angle-addr"
  assert_eq pal("=?x-unknown?q?a?= #!$%@[::1]"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("<#!$%@> junk"), "ERR mail: invalid string"
  assert_eq pal("Who? \"john..doe\"@"), "ERR mail: no angle-addr"
  assert_eq pal("grp: ;, ä ö jdoe@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pal("\"\\\\\"@[::1] (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= a@b@x , (c) a@b@[192.168.0.1] , =?utf-8?q?J=C3=B6rg?= <x.@a..b> (bad"), "ERR mail: no angle-addr"
  assert_eq pal("Who? <us_er@[a]> (comment)"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("\"\" a@b@[a], grp: ;, <\"john..doe\"@[256.0.0.1]>"), "ERR mail: no angle-addr"
  assert_eq pal("<\"john..doe\"@[1.2.3]>,,<#!$%@[::1]> junk,<#!$%@x>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("us_er@[1.2.3],, <.x@> (comment), grp: ä ö <us_er@>;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("John Doe john.doe@ex-ample.org,=?x-unknown?q?a?= <\"\\\\\"@example.com> "), "ERR mail: no angle-addr"
  assert_eq pal("(c) <a@b@a..b>"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <\"\"@[IPv6:1.2.3.4]> (comment)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("\"\\\\\"@ (comment), \"\"@[256.0.0.1] junk, \"\"@[a]"), "ERR mail: no angle-addr"
  assert_eq pal("\"john..doe\"@[IPv6:::1]  , <a@b@[1.2.3]> "), "ERR mail: unclosed angle-addr"
  assert_eq pal("<\"\"@[192.168.0.1]> (bad"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("<\"john..doe\"@[::1]>,John Doe <#!$%@[a]> (comment),<a@b@[IPv6:::1]> (bad"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("grp: \"Joe Q. Public\" john.doe@[1.2.3];"), "ERR mail: no angle-addr"
  assert_eq pal("ä ö <\"\"@[256.0.0.1]> ,=?utf-8?q?J=C3=B6rg?= \"\\\\\"@[::1], <john.doe@[1.2.3]> "), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("<\"a b\"@[a]> "), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pal("=?iso-8859-1?q?J=F6rg?= x.@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal("(c) #!$%@a..b,, a..b@[IPv6:1.2.3.4] ,, =?x-unknown?q?a?= x.@"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("Who? x.@a..b, x: #!$%@x, \"a\\\"b\" <a@b@[192.168.0.1]>  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("\"john..doe\"@[::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?x-unknown?q?a?= <a@b@x> junk"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("a.b <a@b@[IPv6:::1]>,,, grp: <x.@a..b>, a.b <us_er@[::1]> (bad;,, =?x-unknown?q?a?= <.x@[IPv6:::1]>  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pal("us_er@[192.168.0.1] (comment),, =?x-unknown?q?a?= a@b@"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("Who? <\"john..doe\"@>, , <\"a b\"@[::1]> junk"), "ERR mail: invalid string"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <us_er@x>,"), "Böb|us_er@x"
  assert_eq pal("é@a..b (bad,a.b \"a b\"@[IPv6:::1],x: us_er@example.com"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<john.doe@[IPv6:::1]> (bad,, a.b <.x@[IPv6:1.2.3.4]>  (x(y)z),, <#!$%@[::1]>  (x(y)z)"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("John <\"\\\\\"@example.com> (bad , \"a\\\"b\" <x.@x> (comment)"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("grp: ä ö \"a b\"@a..b; , grp: Böb \"john..doe\"@[::1];"), "ERR mail: no angle-addr"
  assert_eq pal("<a..b@a..b>, \"john..doe\"@[IPv6:::1] (bad"), "ERR mail: double dot in atom"
  assert_eq pal(" a..b@ex-ample.org"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("x.@[1.2.3] (comment), <a@b@[a]> , ä ö é@[192.168.0.1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: jdoe@  (x(y)z), \"Joe Q. Public\" <\"a b\"@[192.168.0.1]> ;,a@b@"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("x.@[1.2.3],.x@[256.0.0.1]  (x(y)z),x: .x@[256.0.0.1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <.x@[256.0.0.1]> (bad,, jdoe@[IPv6:1.2.3.4] junk"), "ERR mail: leading dot in atom"
  assert_eq pal("<.x@ex-ample.org>,"), "ERR mail: leading dot in atom"
  assert_eq pal(" x.@[a],\"\\\\\"@[IPv6:::1],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: \"a b\"@a..b (bad; , grp: ; , <jdoe@[::1]> junk"), "ERR mail: no angle-addr"
  assert_eq pal("grp: Böb <.x@x> ;,,  <é@x>  (x(y)z)"), "ERR mail: leading dot in atom"
  assert_eq pal("\"\"@[1.2.3], jdoe@[1.2.3] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<john.doe@x> junk,, Asem H. john.doe@[1.2.3],, Who? <x.@[IPv6:1.2.3.4]>  (x(y)z)"), "ERR mail: expected comma"
  assert_eq pal("<a@b@[::1]>,"), "ERR mail: unclosed angle-addr"
  assert_eq pal("us_er@example.com  , John <us_er@[IPv6:::1]> "), "|us_er@example.com;John|us_er@[IPv6:::1]"
  assert_eq pal("grp: a..b@[IPv6:::1] , é@[a]  (x(y)z);,, =?utf-8?q?a?= =?utf-8?q?b?= <x.@x> (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("x.@a..b  (x(y)z), \"john..doe\"@[a]  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("a.b john.doe@[IPv6:1.2.3.4],, John Doe <\"\\\\\"@a..b> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("\"\"@[a] (comment), <jdoe@[IPv6:::1]>"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<\"\"@[::1]> , John jdoe@"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("x: x.@example.com, grp: ;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"Joe Q. Public\" .x@"), "ERR mail: no angle-addr"
  assert_eq pal("\"\" é@, John Doe <a@b@[IPv6:::1]>  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pal("#!$%@[192.168.0.1]"), "|#!$%@[192.168.0.1]"
  assert_eq pal("grp: <a@b@[1.2.3]> (comment), =?utf-8?q?J=C3=B6rg?= john.doe@[1.2.3]; , <é@a..b> (bad , a..b@x  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pal("us_er@[192.168.0.1] (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal(".x@,, Who? <\"a b\"@[256.0.0.1]> "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("Who? <a@b@[a]> (comment)"), "ERR mail: unclosed angle-addr"
  assert_eq pal("<a..b@[IPv6:::1]>,,, <x.@x>,, grp: ;"), "ERR mail: double dot in atom"
  assert_eq pal("<jdoe@[::1]>  , =?utf-8?q?a?= =?utf-8?q?b?= <\"\"@> junk"), "ERR mail: invalid IP address in domain-literal: \"::1\""
}

test "vectors: address list 6" {
  assert_eq pal("=?x-unknown?q?a?= \"\\\\\"@"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("\"a\\\"b\" \"\\\\\"@[192.168.0.1],, \"Joe Q. Public\" <x.@ex-ample.org> "), "ERR mail: no angle-addr"
  assert_eq pal("us_er@[a] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<\"john..doe\"@ex-ample.org>  (x(y)z),, grp: John é@x, John \"\"@example.com;,, <\"john..doe\"@[1.2.3]> (bad"), "ERR mail: no angle-addr"
  assert_eq pal("a.b <é@[IPv6:::1]> junk"), "ERR mail: expected comma"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= \"\"@[192.168.0.1] , a.b <\"\"@[IPv6:::1]>,"), "ERR mail: no angle-addr"
  assert_eq pal("a.b <#!$%@[::1]> (comment),, <\"\\\\\"@ex-ample.org> junk,, \"john..doe\"@[a] junk"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("us_er@[a]  , Asem H. \"\"@[a]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?x-unknown?q?a?= <\"a b\"@ex-ample.org> junk"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= <jdoe@[IPv6:1.2.3.4]> (comment) , <\"a b\"@[192.168.0.1]> junk"), "ERR mail: expected comma"
  assert_eq pal("Asem H. <é@a..b>"), "ERR mail: double dot in atom"
  assert_eq pal("jdoe@example.com junk, =?x-unknown?q?a?= <\"john..doe\"@[IPv6:1.2.3.4]> (bad, grp: \"a\\\"b\" <\"\"@[192.168.0.1]>, <x.@[a]>;"), "ERR mail: expected comma"
  assert_eq pal("<us_er@example.com>  (x(y)z)"), "|us_er@example.com"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= \"a b\"@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal("\"\"@[a] (bad,\"a\\\"b\" john.doe@[1.2.3],\"\" <a@b@ex-ample.org>  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: \"Joe Q. Public\" <.x@ex-ample.org> (comment);,\"a\\\"b\" <x.@example.com> (comment)"), "ERR mail: leading dot in atom"
  assert_eq pal("us_er@[1.2.3],,, <a..b@ex-ample.org>  (x(y)z),, grp: ;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("John Doe <jdoe@a..b> junk,, grp: ;,, \"a\\\"b\" <\"a b\"@x>  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pal("ä ö \"john..doe\"@ex-ample.org, =?x-unknown?q?a?= <.x@[256.0.0.1]> (bad, john.doe@[256.0.0.1] junk"), "ERR mail: no angle-addr"
  assert_eq pal("grp: =?iso-8859-1?q?J=F6rg?= \"a b\"@a..b;,John \"\\\\\"@[256.0.0.1],=?utf-8?q?J=C3=B6rg?= <jdoe@[IPv6:1.2.3.4]> "), "ERR mail: no angle-addr"
  assert_eq pal("a.b \"a b\"@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pal("grp: jdoe@a..b junk; , grp: =?iso-8859-1?q?J=F6rg?= é@[1.2.3], (c) us_er@[a]; , =?utf-8?q?a?= =?utf-8?q?b?= <.x@[IPv6:1.2.3.4]>,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= <\"john..doe\"@>  (x(y)z),, grp: =?x-unknown?q?a?= é@[::1];"), "ERR mail: invalid string"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= a@b@example.com,grp: ;,<us_er@[IPv6:::1]> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("grp: #!$%@ , ä ö \"john..doe\"@[256.0.0.1];,, Who? <.x@[1.2.3]> junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?utf-8?b?QsO2Yg==?= <john.doe@>,,.x@[::1],"), "ERR mail: invalid string"
  assert_eq pal("x.@x (comment), =?utf-8?q?a?= =?utf-8?q?b?= <a@b@> junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: ;,<\"\"@[1.2.3]> junk"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("Asem H. <#!$%@example.com> (bad, <jdoe@>"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("<.x@a..b>,, #!$%@[IPv6:1.2.3.4] "), "ERR mail: leading dot in atom"
  assert_eq pal("grp: John <\"a b\"@[::1]> (comment), \"john..doe\"@ex-ample.org;,Who? <x.@[IPv6:1.2.3.4]> "), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("<a@b@a..b> , <#!$%@a..b> (bad, \"Joe Q. Public\" us_er@[1.2.3]"), "ERR mail: unclosed angle-addr"
  assert_eq pal("jdoe@[::1],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: #!$%@[1.2.3] junk, =?iso-8859-1?q?J=F6rg?= <.x@[IPv6:::1]>,;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("us_er@  (x(y)z),, #!$%@[IPv6:1.2.3.4],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("john.doe@[192.168.0.1]  (x(y)z),, grp: =?iso-8859-1?q?J=F6rg?= jdoe@[256.0.0.1], Who? a..b@x;,, <jdoe@example.com> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("<jdoe@[IPv6:1.2.3.4]> "), "|jdoe@[IPv6:1.2.3.4]"
  assert_eq pal(" us_er@[IPv6:1.2.3.4]"), "|us_er@[IPv6:1.2.3.4]"
  assert_eq pal("a.b x.@example.com"), "ERR mail: no angle-addr"
  assert_eq pal("(c) john.doe@[192.168.0.1]"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= a..b@[IPv6:1.2.3.4] , grp: <x.@[1.2.3]> (bad; , <\"john..doe\"@a..b> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("(c) .x@[::1],, John \"\"@x"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("grp: x: us_er@x;, =?utf-8?q?J=C3=B6rg?= john.doe@[::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: Böb <a@b@[a]> (bad, <.x@[256.0.0.1]>  (x(y)z);"), "ERR mail: unclosed angle-addr"
  assert_eq pal("grp: \"a\\\"b\" <é@[IPv6:::1]> junk;,, us_er@[1.2.3]  (x(y)z)"), "ERR mail: expected comma"
  assert_eq pal("<#!$%@[1.2.3]> (bad"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("grp: a.b <jdoe@example.com>; , John Doe <\"\\\\\"@[::1]> (bad , <é@[a]>,"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("John Doe <#!$%@ex-ample.org> (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pal("\"john..doe\"@[192.168.0.1] junk"), "ERR mail: expected comma"
  assert_eq pal("grp: \"john..doe\"@[a] (bad;,, <\"\\\\\"@ex-ample.org>"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("\"\" john.doe@[IPv6:::1], =?utf-8?b?QsO2Yg==?= <x.@[IPv6:::1]>, John Doe <jdoe@[::1]>"), "ERR mail: no angle-addr"
  assert_eq pal("é@x junk,, x.@[::1]"), "ERR mail: expected comma"
  assert_eq pal("a.b .x@[1.2.3] ,  <\"a b\"@[a]>, , (c) <jdoe@a..b> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("<\"\"@[a]> junk, ä ö \"a b\"@ex-ample.org, x.@x (comment)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("\"\\\\\"@x junk , =?iso-8859-1?q?J=F6rg?= <\"\"@[a]> (bad , é@[::1] junk"), "ERR mail: expected comma"
  assert_eq pal("<\"\\\\\"@[IPv6:1.2.3.4]>,, é@[IPv6:1.2.3.4] ,, John Doe <a..b@ex-ample.org> (bad"), "ERR mail: double dot in atom"
  assert_eq pal("grp: ;, grp: x: <jdoe@[192.168.0.1]> (comment), <x.@[192.168.0.1]> junk;"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("<.x@[256.0.0.1]> ,grp: <us_er@>;"), "ERR mail: leading dot in atom"
  assert_eq pal("x.@[192.168.0.1] (bad, ä ö #!$%@[IPv6:::1], <#!$%@a..b> (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("=?x-unknown?q?a?= \"\"@[192.168.0.1], grp: a..b@[a], \"\" <\"\"@[1.2.3]>;, .x@example.com (bad"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pal("<a..b@[IPv6:::1]> (bad,grp: <jdoe@ex-ample.org>  (x(y)z), <\"\\\\\"@[256.0.0.1]>,;"), "ERR mail: double dot in atom"
  assert_eq pal("John \"\\\\\"@[1.2.3],, #!$%@[1.2.3],"), "ERR mail: no angle-addr"
  assert_eq pal("us_er@[IPv6:::1]"), "|us_er@[IPv6:::1]"
  assert_eq pal("john.doe@[192.168.0.1] junk, grp: <a@b@[IPv6:::1]> (comment), #!$%@[1.2.3] junk;"), "ERR mail: expected comma"
  assert_eq pal("grp: \"\" \"a b\"@[IPv6:1.2.3.4];"), "ERR mail: no angle-addr"
  assert_eq pal("<\"\\\\\"@[1.2.3]> , <x.@x> , a.b <x.@x> (bad"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("<a..b@[192.168.0.1]>, Who? <x.@[256.0.0.1]> (comment), grp: \"\\\\\"@[IPv6:1.2.3.4] junk,  <.x@ex-ample.org>,;"), "ERR mail: double dot in atom"
  assert_eq pal("\"a b\"@[1.2.3]  , <a..b@ex-ample.org> (bad , john.doe@ junk"), "ERR mail: no angle-addr"
  assert_eq pal("grp: ;,, x: \"\\\\\"@[a],, <a@b@> (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("a@b@example.com,,, grp: =?utf-8?b?QsO2Yg==?= <x.@ex-ample.org>  (x(y)z);"), "ERR mail: expected comma"
  assert_eq pal("\"\\\\\"@ (comment)"), "ERR mail: no angle-addr"
  assert_eq pal("\"\" <a..b@[192.168.0.1]>  (x(y)z),grp: ;"), "ERR mail: double dot in atom"
  assert_eq pal("\"\" <\"john..doe\"@[256.0.0.1]> junk,, é@a..b,,, grp: ;"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pal(" a..b@example.com"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("x: <\"\"@x>"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pal("john.doe@[256.0.0.1] (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("grp: <x.@[IPv6:1.2.3.4]> (bad;"), "ERR mail: trailing dot in atom"
  assert_eq pal("<a@b@x> (comment), a.b \"john..doe\"@example.com, Asem H. <us_er@x> (comment)"), "ERR mail: unclosed angle-addr"
  assert_eq pal("Who? #!$%@[1.2.3] , grp: ;"), "ERR mail: no angle-addr"
  assert_eq pal("John Doe a..b@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pal("<\"\\\\\"@[1.2.3]>,,, =?iso-8859-1?q?J=F6rg?= <\"\\\\\"@[1.2.3]>  (x(y)z),, <jdoe@[192.168.0.1]>,"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pal("x.@ junk, john.doe@[256.0.0.1], <us_er@[::1]>,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pal("a.b <a@b@[192.168.0.1]> junk,(c) \"a b\"@a..b"), "ERR mail: unclosed angle-addr"
  assert_eq pal("grp: =?utf-8?q?J=C3=B6rg?= us_er@[1.2.3], x.@example.com (comment); , x: <x.@> (comment) , \"a b\"@ex-ample.org (bad"), "ERR mail: no angle-addr"
  assert_eq pal("grp: <us_er@example.com>;"), "|us_er@example.com"
  assert_eq pal("(c) <\"a b\"@example.com>"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("<\"\\\\\"@[::1]>  (x(y)z), <\"\"@[IPv6:::1]>,"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pal("=?utf-8?q?J=C3=B6rg?= us_er@x, (c) #!$%@x"), "ERR mail: no angle-addr"
  assert_eq pal("(c) \"\\\\\"@ex-ample.org, (c) <#!$%@[1.2.3]>,"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pal("<x.@[256.0.0.1]> (bad"), "ERR mail: trailing dot in atom"
  assert_eq pal("a@b@a..b"), "ERR mail: expected comma"
  assert_eq pal("<a@b@[IPv6:::1]> (comment)"), "ERR mail: unclosed angle-addr"
}

