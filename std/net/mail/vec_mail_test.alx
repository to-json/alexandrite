  assert_eq fmt_round(",.\x01(\t<", "@"), "=?utf-8?b?LC4BKAk8?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("#@\\=~=ö", " @x"), "=?utf-8?b?I0BcPX49w7Y=?= <\" \"@x> => #@\\=~=ö| @x"
  assert_eq fmt_round("a''.Bö", " @x"), "=?utf-8?b?YScnLkLDtg==?= <\" \"@x> => a''.Bö| @x"
