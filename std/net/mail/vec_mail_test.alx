  assert_eq fmt_round(")(,", ""), "\")(,\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("#ö@\\\"' ", "@"), "=?utf-8?b?I8O2QFwiJyA=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("',\\@,.'", "@"), "\"',\\\\@,.'\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("=日日_\\B", "a..b@x"), "=?utf-8?q?=3D=E6=97=A5=E6=97=A5=5F\\B?= <\"a..b\"@x> => ERR mail: missing '@' or angle-addr"
  assert_eq fmt_round("日\\~", "a b@c"), "=?utf-8?b?5pelXH4=?= <\"a b\"@c> => 日\\~|a b@c"
  assert_eq fmt_round("=_'a\x01", "@"), "=?utf-8?b?PV8nYQE=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("日,~= \x01", ""), "=?utf-8?b?5pelLH49IAE=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("'", "plain"), "\"'\" <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("<(@", "ü@x"), "\"<(@\" <ü@x> => <(@|ü@x"
  assert_eq fmt_round("(~_.(  ", ""), "\"(~_.(  \" <@> => ERR mail: invalid string"
  assert_eq fmt_round(")", ".a@x"), "\")\" <\".a\"@x> => )|.a@x"
  assert_eq fmt_round("(_.日 ", "a.b@x"), "=?utf-8?b?KF8u5pelIA==?= <a.b@x> => (_.日 |a.b@x"
  assert_eq fmt_round("?~日", "my@idiot@address@example.com"), "=?utf-8?b?P37ml6U=?= <\"my@idiot@address\"@example.com> => ?~日|my@idiot@address@example.com"
  assert_eq fmt_round(" ", "plain"), "\" \" <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("B_", "@"), "\"B_\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("日(\\,", "plain"), "=?utf-8?b?5pelKFws?= <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("\"<B?<\t\x01", "ü@x"), "=?utf-8?b?IjxCPzwJAQ==?= <ü@x> => \"<B?<\t\x01|ü@x"
  assert_eq fmt_round(")=#.=", "x.@y"), "\")=#.=\" <\"x.\"@y> => )=#.=|x.@y"
  assert_eq fmt_round("~", "x.@y"), "\"~\" <\"x.\"@y> => ~|x.@y"
  assert_eq fmt_round("<\"~'<.", "a.b@x"), "\"<\\\"~'<.\" <a.b@x> => <\"~'<.|a.b@x"
  assert_eq fmt_round("\"ö\x01#~(B", "plain"), "=?utf-8?b?IsO2ASN+KEI=?= <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("\x01a\x01)a", "plain"), "=?utf-8?b?AWEBKWE=?= <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("#.", " @x"), "\"#.\" <\" \"@x> => #.| @x"
  assert_eq fmt_round("<<a# ", "my@idiot@address@example.com"), "\"<<a# \" <\"my@idiot@address\"@example.com> => <<a# |my@idiot@address@example.com"
  assert_eq fmt_round("a \t?~", "@"), "\"a \t?~\" <@> => ERR mail: invalid string"
  assert_eq fmt_round(")\\\x01\"<~", "x.@y"), "=?utf-8?b?KVwBIjx+?= <\"x.\"@y> => )\\\x01\"<~|x.@y"
  assert_eq fmt_round("\"_ ?", "a..b@x"), "\"\\\"_ ?\" <\"a..b\"@x> => \"_ ?|a..b@x"
  assert_eq fmt_round("日日#@' \"", "x.@y"), "=?utf-8?b?5pel5pelI0AnICI=?= <\"x.\"@y> => 日日#@' \"|x.@y"
  assert_eq fmt_round("日~a_\\ö", "a.b@x"), "=?utf-8?b?5pelfmFfXMO2?= <a.b@x> => 日~a_\\ö|a.b@x"
  assert_eq fmt_round("\"", " @x"), "\"\\\"\" <\" \"@x> => \"| @x"
  assert_eq fmt_round("\"\t\ta=a_", "x.@y"), "\"\\\"\t\ta=a_\" <\"x.\"@y> => \"\t\ta=a_|x.@y"
  assert_eq fmt_round("?__\t~,", "x.@y"), "\"?__\t~,\" <\"x.\"@y> => ?__\t~,|x.@y"
  assert_eq fmt_round("\t,?B\x01#", "\"q\"@z"), "=?utf-8?b?CSw/QgEj?= <\"\\\"q\\\"\"@z> => \t,?B\x01#|\"q\"@z"
  assert_eq fmt_round("_'", "ü@x"), "\"_'\" <ü@x> => _'|ü@x"
  assert_eq fmt_round("\t.,a?~", "plain"), "\"\t.,a?~\" <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("a_\x01.)", "a b@c"), "=?utf-8?b?YV8BLik=?= <\"a b\"@c> => a_\x01.)|a b@c"
  assert_eq fmt_round(".<a,~", "a b@c"), "\".<a,~\" <\"a b\"@c> => .<a,~|a b@c"
}

test "vectors: address string 5" {
