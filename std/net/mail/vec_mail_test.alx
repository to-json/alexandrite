  assert_eq fmt_round("~ö <a.", "plain"), "=?utf-8?b?fsO2IDxhLg==?= <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("\\日?~\"('", "plain"), "=?utf-8?b?XOaXpT9+Iign?= <plain@> => ERR mail: invalid string"
