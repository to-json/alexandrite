  assert_eq fmt_round("##=ö\x01", ""), "=?utf-8?b?IyM9w7YB?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("#),ö\\B", "\"q\"@z"), "=?utf-8?b?Iyksw7ZcQg==?= <\"\\\"q\\\"\"@z> => #),ö\\B|\"q\"@z"
  assert_eq fmt_round("'", ""), "\"'\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("\"~=~", " @x"), "\"\\\"~=~\" <\" \"@x> => \"~=~| @x"
  assert_eq fmt_round("@_", "my@idiot@address@example.com"), "\"@_\" <\"my@idiot@address\"@example.com> => @_|my@idiot@address@example.com"
  assert_eq fmt_round("@(_'\t@)", "@"), "\"@(_'\t@)\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("'?)\",~a", "\"q\"@z"), "\"'?)\\\",~a\" <\"\\\"q\\\"\"@z> => '?)\",~a|\"q\"@z"
  assert_eq fmt_round("a", "a.b@x"), "\"a\" <a.b@x> => a|a.b@x"
  assert_eq fmt_round("_ <@._", ""), "\"_ <@._\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("日a<", "@"), "=?utf-8?b?5pelYTw=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("_\t", "x.@y"), "\"_\t\" <\"x.\"@y> => _\t|x.@y"
  assert_eq fmt_round("_B_", "my@idiot@address@example.com"), "\"_B_\" <\"my@idiot@address\"@example.com> => _B_|my@idiot@address@example.com"
  assert_eq fmt_round(" ö\t= ~ ", "bob@example.com"), "=?utf-8?b?IMO2CT0gfiA=?= <bob@example.com> =>  ö\t= ~ |bob@example.com"
  assert_eq fmt_round("@==)'a#", "my@idiot@address@example.com"), "\"@==)'a#\" <\"my@idiot@address\"@example.com> => @==)'a#|my@idiot@address@example.com"
  assert_eq fmt_round("@=(.", ".a@x"), "\"@=(.\" <\".a\"@x> => @=(.|.a@x"
  assert_eq fmt_round("ö,\\\x01", ""), "=?utf-8?b?w7YsXAE=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("B<__~~", "x.@y"), "\"B<__~~\" <\"x.\"@y> => B<__~~|x.@y"
  assert_eq fmt_round("\x01\"日a,_", ".a@x"), "=?utf-8?b?ASLml6VhLF8=?= <\".a\"@x> => \x01\"日a,_|.a@x"
  assert_eq fmt_round("B? ", ".a@x"), "\"B? \" <\".a\"@x> => B? |.a@x"
  assert_eq fmt_round("<'", "a.b@x"), "\"<'\" <a.b@x> => <'|a.b@x"
  assert_eq fmt_round("  )B", "a..b@x"), "\"  )B\" <\"a..b\"@x> =>   )B|a..b@x"
  assert_eq fmt_round("_", "@"), "\"_\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("日", " @x"), "=?utf-8?q?=E6=97=A5?= <\" \"@x> => 日| @x"
  assert_eq fmt_round(".", ".a@x"), "\".\" <\".a\"@x> => .|.a@x"
  assert_eq fmt_round(".)?", "a.b@x"), "\".)?\" <a.b@x> => .)?|a.b@x"
  assert_eq fmt_round("@\t\"_\\\"", "ü@x"), "\"@\t\\\"_\\\\\\\"\" <ü@x> => @\t\"_\\\"|ü@x"
  assert_eq fmt_round(" _", "ü@x"), "\" _\" <ü@x> =>  _|ü@x"
  assert_eq fmt_round("\t", "@"), "\"\t\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("=\\ö\t", "a..b@x"), "=?utf-8?q?=3D\\=C3=B6=09?= <\"a..b\"@x> => ERR mail: missing '@' or angle-addr"
  assert_eq fmt_round("B(a", "@"), "\"B(a\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("_(~ö')\t", ""), "=?utf-8?b?Xyh+w7YnKQk=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("==.(", "bob@example.com"), "\"==.(\" <bob@example.com> => ==.(|bob@example.com"
  assert_eq fmt_round("_(a", "ü@x"), "\"_(a\" <ü@x> => _(a|ü@x"
  assert_eq fmt_round(" \\=", "plain"), "\" \\\\=\" <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("a~\x01\ta", "bob@example.com"), "=?utf-8?b?YX4BCWE=?= <bob@example.com> => a~\x01\ta|bob@example.com"
  assert_eq fmt_round("'<", "\"q\"@z"), "\"'<\" <\"\\\"q\\\"\"@z> => '<|\"q\"@z"
  assert_eq fmt_round("日\t_'~?", "\"q\"@z"), "=?utf-8?b?5pelCV8nfj8=?= <\"\\\"q\\\"\"@z> => 日\t_'~?|\"q\"@z"
  assert_eq fmt_round("\\')ö", ""), "=?utf-8?b?XCcpw7Y=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("\x01", ""), "=?utf-8?q?=01?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("日.aB??.", "a.b@x"), "=?utf-8?b?5pelLmFCPz8u?= <a.b@x> => 日.aB??.|a.b@x"
  assert_eq fmt_round("日<<<\x01", ".a@x"), "=?utf-8?b?5pelPDw8AQ==?= <\".a\"@x> => 日<<<\x01|.a@x"
  assert_eq fmt_round("_\\'B~", "ü@x"), "\"_\\\\'B~\" <ü@x> => _\\'B~|ü@x"
  assert_eq fmt_round("##,.((\\", ""), "\"##,.((\\\\\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("(_.,", ".a@x"), "\"(_.,\" <\".a\"@x> => (_.,|.a@x"
  assert_eq fmt_round("\t(\\", "plain"), "\"\t(\\\\\" <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("'@~#", " @x"), "\"'@~#\" <\" \"@x> => '@~#| @x"
  assert_eq fmt_round("(?", ".a@x"), "\"(?\" <\".a\"@x> => (?|.a@x"
  assert_eq fmt_round("\x01ö a@#", " @x"), "=?utf-8?b?AcO2IGFAIw==?= <\" \"@x> => \x01ö a@#| @x"
  assert_eq fmt_round("@", " @x"), "\"@\" <\" \"@x> => @| @x"
  assert_eq fmt_round("a~#,", "a b@c"), "\"a~#,\" <\"a b\"@c> => a~#,|a b@c"
  assert_eq fmt_round("\"\t @\t日", "a b@c"), "=?utf-8?b?IgkgQAnml6U=?= <\"a b\"@c> => \"\t @\t日|a b@c"
  assert_eq fmt_round("日a", "a b@c"), "=?utf-8?q?=E6=97=A5a?= <\"a b\"@c> => 日a|a b@c"
  assert_eq fmt_round("#_,_\"_", " @x"), "\"#_,_\\\"_\" <\" \"@x> => #_,_\"_| @x"
  assert_eq fmt_round("_\t", ".a@x"), "\"_\t\" <\".a\"@x> => _\t|.a@x"
  assert_eq fmt_round("#\\__\"a", "bob@example.com"), "\"#\\\\__\\\"a\" <bob@example.com> => #\\__\"a|bob@example.com"
}

test "vectors: address string 4" {
  assert_eq fmt_round("\t@.", "a b@c"), "\"\t@.\" <\"a b\"@c> => \t@.|a b@c"
  assert_eq fmt_round("=,ö,ö~", " @x"), "=?utf-8?b?PSzDtizDtn4=?= <\" \"@x> => =,ö,ö~| @x"
  assert_eq fmt_round("\"_(?\x01\x01)", "a b@c"), "=?utf-8?b?Il8oPwEBKQ==?= <\"a b\"@c> => \"_(?\x01\x01)|a b@c"
  assert_eq fmt_round(",\t#?", "x.@y"), "\",\t#?\" <\"x.\"@y> => ,\t#?|x.@y"
  assert_eq fmt_round("B~a\x01\\@_", "@"), "=?utf-8?b?Qn5hAVxAXw==?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("#@", "plain"), "\"#@\" <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("(", " @x"), "\"(\" <\" \"@x> => (| @x"
  assert_eq fmt_round("=日 ", "bob@example.com"), "=?utf-8?q?=3D=E6=97=A5_?= <bob@example.com> => =日 |bob@example.com"
  assert_eq fmt_round("'@~", ".a@x"), "\"'@~\" <\".a\"@x> => '@~|.a@x"
  assert_eq fmt_round("'  (\\", ""), "\"'  (\\\\\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("<(~.,B<", "\"q\"@z"), "\"<(~.,B<\" <\"\\\"q\\\"\"@z> => <(~.,B<|\"q\"@z"
  assert_eq fmt_round(")#", "a.b@x"), "\")#\" <a.b@x> => )#|a.b@x"
  assert_eq fmt_round("\\日?", "x.@y"), "=?utf-8?q?\\=E6=97=A5=3F?= <\"x.\"@y> => ERR mail: missing '@' or angle-addr"
  assert_eq fmt_round(")", "x.@y"), "\")\" <\"x.\"@y> => )|x.@y"
  assert_eq fmt_round("\t<~", "x.@y"), "\"\t<~\" <\"x.\"@y> => \t<~|x.@y"
  assert_eq fmt_round("<),\t日a)", " @x"), "=?utf-8?b?PCksCeaXpWEp?= <\" \"@x> => <),\t日a)| @x"
  assert_eq fmt_round("?", "bob@example.com"), "\"?\" <bob@example.com> => ?|bob@example.com"
  assert_eq fmt_round("@a?\t ", "plain"), "\"@a?\t \" <plain@> => ERR mail: invalid string"
  assert_eq fmt_round(",\x01", "a b@c"), "=?utf-8?b?LAE=?= <\"a b\"@c> => ,\x01|a b@c"
  assert_eq fmt_round("@日\x01,?", "x.@y"), "=?utf-8?b?QOaXpQEsPw==?= <\"x.\"@y> => @日\x01,?|x.@y"
  assert_eq fmt_round(")\t#)(\\ö", "x.@y"), "=?utf-8?b?KQkjKShcw7Y=?= <\"x.\"@y> => )\t#)(\\ö|x.@y"
  assert_eq fmt_round("?", ""), "\"?\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("_,öB", "a b@c"), "=?utf-8?b?XyzDtkI=?= <\"a b\"@c> => _,öB|a b@c"
  assert_eq fmt_round("aö", "\"q\"@z"), "=?utf-8?q?a=C3=B6?= <\"\\\"q\\\"\"@z> => aö|\"q\"@z"
  assert_eq fmt_round("öB')\t?", "a.b@x"), "=?utf-8?b?w7ZCJykJPw==?= <a.b@x> => öB')\t?|a.b@x"
  assert_eq fmt_round("=\t日\")#'", "a..b@x"), "=?utf-8?b?PQnml6UiKSMn?= <\"a..b\"@x> => =\t日\")#'|a..b@x"
  assert_eq fmt_round("B ", "ü@x"), "\"B \" <ü@x> => B |ü@x"
