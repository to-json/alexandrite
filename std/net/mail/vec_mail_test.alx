  assert_eq fmt_round("_", ""), "\"_\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("?_a<", "a b@c"), "\"?_a<\" <\"a b\"@c> => ?_a<|a b@c"
  assert_eq fmt_round("~)\"<", " @x"), "\"~)\\\"<\" <\" \"@x> => ~)\"<| @x"
  assert_eq fmt_round("~a=\x01", "a b@c"), "=?utf-8?b?fmE9AQ==?= <\"a b\"@c> => ~a=\x01|a b@c"
  assert_eq fmt_round("@ö_", "\"q\"@z"), "=?utf-8?b?QMO2Xw==?= <\"\\\"q\\\"\"@z> => @ö_|\"q\"@z"
  assert_eq fmt_round("((\x01(", " @x"), "=?utf-8?b?KCgBKA==?= <\" \"@x> => ((\x01(| @x"
