  assert_eq fmt_round("Bö日'@", ".a@x"), "=?utf-8?b?QsO25pelJ0A=?= <\".a\"@x> => Bö日'@|.a@x"
  assert_eq fmt_round("\x01?'ö日", ""), "=?utf-8?b?AT8nw7bml6U=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("@)a日 ,,", " @x"), "=?utf-8?b?QClh5pelICws?= <\" \"@x> => @)a日 ,,| @x"
  assert_eq fmt_round("\"_\\,_\t日", " @x"), "=?utf-8?b?Il9cLF8J5pel?= <\" \"@x> => \"_\\,_\t日| @x"
  assert_eq fmt_round("~\"~.'", "a.b@x"), "\"~\\\"~.'\" <a.b@x> => ~\"~.'|a.b@x"
  assert_eq fmt_round("(=@ ", "\"q\"@z"), "\"(=@ \" <\"\\\"q\\\"\"@z> => (=@ |\"q\"@z"
