  assert_eq fmt_round("öö?\t", "@"), "=?utf-8?q?=C3=B6=C3=B6=3F=09?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("#~#\"~#", ""), "\"#~#\\\"~#\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("\x01'", "a.b@x"), "=?utf-8?b?ASc=?= <a.b@x> => \x01'|a.b@x"
  assert_eq fmt_round("?(,.", "ü@x"), "\"?(,.\" <ü@x> => ?(,.|ü@x"
  assert_eq fmt_round("\\.a\x01)", "@"), "=?utf-8?b?XC5hASk=?= <@> => ERR mail: invalid string"
