  assert_eq fmt_round(" ", "x.@y"), "\" \" <\"x.\"@y> =>  |x.@y"
  assert_eq fmt_round("ö@", "a..b@x"), "=?utf-8?b?w7ZA?= <\"a..b\"@x> => ö@|a..b@x"
  assert_eq fmt_round("\x01\x01,)),\x01", "\"q\"@z"), "=?utf-8?b?AQEsKSksAQ==?= <\"\\\"q\\\"\"@z> => \x01\x01,)),\x01|\"q\"@z"
  assert_eq fmt_round(")日@=_@", "a.b@x"), "=?utf-8?b?KeaXpUA9X0A=?= <a.b@x> => )日@=_@|a.b@x"
  assert_eq fmt_round("_~,", "bob@example.com"), "\"_~,\" <bob@example.com> => _~,|bob@example.com"
  assert_eq fmt_round("", " @x"), "<\" \"@x> => | @x"
  assert_eq fmt_round("=?_,", "a.b@x"), "\"=?_,\" <a.b@x> => =?_,|a.b@x"
  assert_eq fmt_round("<?()a日 ", "plain"), "=?utf-8?b?PD8oKWHml6Ug?= <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("#\\?", ".a@x"), "\"#\\\\?\" <\".a\"@x> => #\\?|.a@x"
  assert_eq fmt_round("~~\x01?B\\~", "a.b@x"), "=?utf-8?b?fn4BP0Jcfg==?= <a.b@x> => ~~\x01?B\\~|a.b@x"
  assert_eq fmt_round("\\(", "my@idiot@address@example.com"), "\"\\\\(\" <\"my@idiot@address\"@example.com> => \\(|my@idiot@address@example.com"
  assert_eq fmt_round("日' aö\"日", "bob@example.com"), "=?utf-8?b?5pelJyBhw7Yi5pel?= <bob@example.com> => 日' aö\"日|bob@example.com"
  assert_eq fmt_round("~ö'))_", "a..b@x"), "=?utf-8?b?fsO2JykpXw==?= <\"a..b\"@x> => ~ö'))_|a..b@x"
  assert_eq fmt_round("\\\t' ", "a..b@x"), "\"\\\\\t' \" <\"a..b\"@x> => \\\t' |a..b@x"
  assert_eq fmt_round("=\\=", "a b@c"), "\"=\\\\=\" <\"a b\"@c> => =\\=|a b@c"
  assert_eq fmt_round("<", "my@idiot@address@example.com"), "\"<\" <\"my@idiot@address\"@example.com> => <|my@idiot@address@example.com"
  assert_eq fmt_round("~_<日 #)", "a..b@x"), "=?utf-8?b?fl885pelICMp?= <\"a..b\"@x> => ~_<日 #)|a..b@x"
  assert_eq fmt_round("", ""), "<@> => ERR mail: invalid string"
  assert_eq fmt_round("~BB ", "a..b@x"), "\"~BB \" <\"a..b\"@x> => ~BB |a..b@x"
  assert_eq fmt_round("<日B<", "ü@x"), "=?utf-8?b?POaXpUI8?= <ü@x> => <日B<|ü@x"
  assert_eq fmt_round("'_) _\t)", "plain"), "\"'_) _\t)\" <plain@> => ERR mail: invalid string"
  assert_eq fmt_round("\"~\\", "a..b@x"), "\"\\\"~\\\\\" <\"a..b\"@x> => \"~\\|a..b@x"
  assert_eq fmt_round(",,\x01", "my@idiot@address@example.com"), "=?utf-8?b?LCwB?= <\"my@idiot@address\"@example.com> => ,,\x01|my@idiot@address@example.com"
  assert_eq fmt_round("B\x01\x01", "a b@c"), "=?utf-8?q?B=01=01?= <\"a b\"@c> => B\x01\x01|a b@c"
  assert_eq fmt_round("?.?\"", "ü@x"), "\"?.?\\\"\" <ü@x> => ?.?\"|ü@x"
  assert_eq fmt_round("??<日(_~", "\"q\"@z"), "=?utf-8?b?Pz885pelKF9+?= <\"\\\"q\\\"\"@z> => ??<日(_~|\"q\"@z"
  assert_eq fmt_round("~日=#\t) ", ""), "=?utf-8?b?fuaXpT0jCSkg?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("\x01<).ö", "a b@c"), "=?utf-8?b?ATwpLsO2?= <\"a b\"@c> => \x01<).ö|a b@c"
}

test "vectors: address string 1" {
  assert_eq fmt_round("\\a<a日", "my@idiot@address@example.com"), "=?utf-8?b?XGE8YeaXpQ==?= <\"my@idiot@address\"@example.com> => \\a<a日|my@idiot@address@example.com"
  assert_eq fmt_round("\\.=\x01", " @x"), "=?utf-8?b?XC49AQ==?= <\" \"@x> => \\.=\x01| @x"
  assert_eq fmt_round("", "plain"), "<plain@> => ERR mail: invalid string"
  assert_eq fmt_round("日.ö~ ", "a.b@x"), "=?utf-8?b?5pelLsO2fiA=?= <a.b@x> => 日.ö~ |a.b@x"
  assert_eq fmt_round(" \\(", "x.@y"), "\" \\\\(\" <\"x.\"@y> =>  \\(|x.@y"
