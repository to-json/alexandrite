  assert_eq fmt_round("(\x01_", "x.@y"), "=?utf-8?b?KAFf?= <\"x.\"@y> => (\x01_|x.@y"
  assert_eq fmt_round("B", "my@idiot@address@example.com"), "\"B\" <\"my@idiot@address\"@example.com> => B|my@idiot@address@example.com"
  assert_eq fmt_round(" @日\tB(~", ".a@x"), "=?utf-8?b?IEDml6UJQih+?= <\".a\"@x> =>  @日\tB(~|.a@x"
  assert_eq fmt_round("Bö\"=", " @x"), "=?utf-8?b?QsO2Ij0=?= <\" \"@x> => Bö\"=| @x"
  assert_eq fmt_round("\\a\t日~", "a b@c"), "=?utf-8?b?XGEJ5pelfg==?= <\"a b\"@c> => \\a\t日~|a b@c"
  assert_eq fmt_round("ö~@", "ü@x"), "=?utf-8?b?w7Z+QA==?= <ü@x> => ö~@|ü@x"
