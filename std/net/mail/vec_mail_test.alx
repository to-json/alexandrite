# Generated from Go's net/mail (go run, Go 1.27): addresses, lists, formatting, dates, messages; do not edit by hand.

test "vectors: address 0" {
  assert_eq pa("a@b@[::1] junk"), "ERR mail: expected single address, got \"@[::1] junk\""
  assert_eq pa("\"john..doe\"@[IPv6:::1] (comment)"), "comment|john..doe@[IPv6:::1]"
  assert_eq pa("<\"\"@[IPv6:::1]>  (x(y)z)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("<\"a b\"@a..b> (comment)"), "ERR mail: double dot in atom"
  assert_eq pa("<#!$%@[192.168.0.1]>  (x(y)z)"), "|#!$%@[192.168.0.1]"
  assert_eq pa("\"a\\\"b\" <x.@a..b> (comment)"), "ERR mail: trailing dot in atom"
  assert_eq pa("<a@b@[IPv6:::1]>  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pa("(c) us_er@[192.168.0.1]"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("a..b@ex-ample.org  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("x: <\"a b\"@[192.168.0.1]>,"), "ERR mail: no address"
  assert_eq pa("(c) <jdoe@ex-ample.org> (bad"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("<us_er@x>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa(".x@[IPv6:1.2.3.4] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"\"@[1.2.3]> (comment)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <.x@[256.0.0.1]> junk"), "ERR mail: leading dot in atom"
  assert_eq pa("Who? #!$%@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("a.b #!$%@a..b"), "ERR mail: no angle-addr"
  assert_eq pa(" é@[192.168.0.1]"), "|é@[192.168.0.1]"
  assert_eq pa("\"john..doe\"@[192.168.0.1] (comment)"), "comment|john..doe@[192.168.0.1]"
  assert_eq pa("<a@b@a..b> "), "ERR mail: unclosed angle-addr"
  assert_eq pa("\"\\\\\"@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <.x@[256.0.0.1]> "), "ERR mail: leading dot in atom"
  assert_eq pa("<a..b@a..b> junk"), "ERR mail: double dot in atom"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= a@b@example.com"), "ERR mail: no angle-addr"
  assert_eq pa("a@b@ex-ample.org (bad"), "ERR mail: expected single address, got \"@ex-ample.org (bad\""
  assert_eq pa("<.x@[1.2.3]>"), "ERR mail: leading dot in atom"
  assert_eq pa("<\"a b\"@ex-ample.org>  (x(y)z)"), "|a b@ex-ample.org"
  assert_eq pa(" <john.doe@[IPv6:::1]>  (x(y)z)"), "|john.doe@[IPv6:::1]"
  assert_eq pa("John <a..b@[IPv6:1.2.3.4]> "), "ERR mail: double dot in atom"
  assert_eq pa("<a..b@[IPv6:1.2.3.4]>  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pa("a@b@[IPv6:::1] "), "ERR mail: expected single address, got \"@[IPv6:::1] \""
  assert_eq pa("x.@[a] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("x: x.@[IPv6:1.2.3.4]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"a b\"@[192.168.0.1] (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("<\"\"@[1.2.3]> "), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("\"a\\\"b\" <jdoe@a..b>,"), "ERR mail: double dot in atom"
  assert_eq pa("<a@b@ex-ample.org>"), "ERR mail: unclosed angle-addr"
  assert_eq pa("\"a b\"@[a] (comment)"), "ERR mail: no angle-addr"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= <.x@[a]>  (x(y)z)"), "ERR mail: leading dot in atom"
  assert_eq pa("John Doe <us_er@[IPv6:::1]>  (x(y)z)"), "John Doe|us_er@[IPv6:::1]"
  assert_eq pa("Böb \"a b\"@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= a@b@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("#!$%@[IPv6:1.2.3.4] junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("ä ö .x@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("\"Joe Q. Public\" <\"\"@[IPv6:1.2.3.4]>  (x(y)z)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("=?x-unknown?q?a?= x.@[192.168.0.1]"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("us_er@ex-ample.org junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("a.b john.doe@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("<é@[192.168.0.1]> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("Asem H. \"john..doe\"@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("=?x-unknown?q?a?= <x.@>"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("\"\" \"\\\\\"@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("<a..b@ex-ample.org> (comment)"), "ERR mail: double dot in atom"
  assert_eq pa("Asem H. <\"\\\\\"@[IPv6:1.2.3.4]>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= john.doe@x"), "ERR mail: no angle-addr"
  assert_eq pa("\"\\\\\"@[192.168.0.1] "), "|\\@[192.168.0.1]"
  assert_eq pa("<#!$%@[1.2.3]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("\"\"@a..b (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("x: <\"\"@a..b>,"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("x.@,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"\"@a..b>  (x(y)z)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("\"\\\\\"@[256.0.0.1]  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pa("#!$%@[1.2.3] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= <a..b@[a]>"), "ERR mail: double dot in atom"
  assert_eq pa(" john.doe@[a]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("John john.doe@"), "ERR mail: no angle-addr"
  assert_eq pa("\"\"@[IPv6:::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("Who? x.@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("\"\\\\\"@x (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("a.b \"\"@"), "ERR mail: no angle-addr"
  assert_eq pa("\"\"@example.com "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<john.doe@[::1]>,"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("Who? <\"\"@> (bad"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("\"a b\"@[192.168.0.1] junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("x.@example.com junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("é@ex-ample.org  (x(y)z)"), "x(y)z|é@ex-ample.org"
  assert_eq pa("Asem H. <#!$%@ex-ample.org>  (x(y)z)"), "Asem H.|#!$%@ex-ample.org"
  assert_eq pa("Böb <x.@ex-ample.org> "), "ERR mail: trailing dot in atom"
  assert_eq pa("Böb \"\"@x"), "ERR mail: no angle-addr"
  assert_eq pa("ä ö <a@b@x> (bad"), "ERR mail: unclosed angle-addr"
  assert_eq pa("a.b <us_er@x> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("a..b@[IPv6:1.2.3.4] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<john.doe@[a]> (bad"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("a.b <john.doe@>"), "ERR mail: invalid string"
  assert_eq pa("us_er@[1.2.3] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("a@b@a..b junk"), "ERR mail: expected single address, got \"@a..b junk\""
  assert_eq pa("Asem H. \"john..doe\"@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("<.x@[IPv6:1.2.3.4]> "), "ERR mail: leading dot in atom"
  assert_eq pa("<a@b@a..b>  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= é@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("a.b \"a b\"@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("<a..b@[256.0.0.1]> (bad"), "ERR mail: double dot in atom"
  assert_eq pa("ä ö <é@[256.0.0.1]> (bad"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("\"\" .x@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa("<john.doe@[256.0.0.1]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <a@b@a..b>"), "ERR mail: unclosed angle-addr"
  assert_eq pa("\"Joe Q. Public\" #!$%@example.com"), "ERR mail: no angle-addr"
  assert_eq pa("Böb .x@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa("<#!$%@x> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("John Doe .x@[192.168.0.1]"), "ERR mail: no angle-addr"
}

test "vectors: address 1" {
  assert_eq pa("<a@b@[256.0.0.1]> junk"), "ERR mail: unclosed angle-addr"
  assert_eq pa("\"a\\\"b\" <\"\\\\\"@ex-ample.org> (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("x.@example.com "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<é@>  (x(y)z)"), "ERR mail: invalid string"
  assert_eq pa("<\"a b\"@a..b> "), "ERR mail: double dot in atom"
  assert_eq pa("\"john..doe\"@[::1] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= <a@b@> (bad"), "ERR mail: unclosed angle-addr"
  assert_eq pa("John \"a b\"@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("us_er@[IPv6:1.2.3.4] (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("<x.@[a]>,"), "ERR mail: trailing dot in atom"
  assert_eq pa("\"a b\"@ex-ample.org (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("<\"a b\"@[IPv6:1.2.3.4]>"), "|a b@[IPv6:1.2.3.4]"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= <\"a b\"@[::1]>,"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("#!$%@[1.2.3] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"a b\"@[1.2.3] (comment)"), "ERR mail: no angle-addr"
  assert_eq pa("ä ö <#!$%@> "), "ERR mail: invalid string"
  assert_eq pa("#!$%@ "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("a..b@[1.2.3] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("John Doe é@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pa("\"\\\\\"@[a] "), "ERR mail: no angle-addr"
  assert_eq pa("<\"john..doe\"@>"), "ERR mail: invalid string"
  assert_eq pa("x.@[a]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<us_er@[256.0.0.1]> (bad"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= <jdoe@[a]> "), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("\"\"@ junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?x-unknown?q?a?= a@b@a..b"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa(".x@[1.2.3]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("x: <us_er@example.com> junk"), "ERR mail: expected comma"
  assert_eq pa("<a..b@ex-ample.org>  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pa("a.b john.doe@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("\"john..doe\"@[192.168.0.1]"), "|john..doe@[192.168.0.1]"
  assert_eq pa("<#!$%@>  (x(y)z)"), "ERR mail: invalid string"
  assert_eq pa("<a@b@>,"), "ERR mail: unclosed angle-addr"
  assert_eq pa("<us_er@x> (comment)"), "|us_er@x"
  assert_eq pa("john.doe@x (comment)"), "comment|john.doe@x"
  assert_eq pa("\"\" <\"\"@x> (bad"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("jdoe@[IPv6:::1] junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("<\"a b\"@ex-ample.org>"), "|a b@ex-ample.org"
  assert_eq pa("Asem H. <x.@[256.0.0.1]> (comment)"), "ERR mail: trailing dot in atom"
  assert_eq pa("<\"\"@[::1]>,"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("é@a..b "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("Böb <\"\\\\\"@[192.168.0.1]>  (x(y)z)"), "Böb|\\@[192.168.0.1]"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= \"\\\\\"@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("a.b jdoe@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pa("<john.doe@x>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("us_er@x,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <#!$%@[IPv6:::1]> "), "Jörg|#!$%@[IPv6:::1]"
  assert_eq pa("<x.@[IPv6:1.2.3.4]>  (x(y)z)"), "ERR mail: trailing dot in atom"
  assert_eq pa(" .x@[::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= é@"), "ERR mail: no angle-addr"
  assert_eq pa(".x@[::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"john..doe\"@[1.2.3]>,"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("jdoe@[256.0.0.1] (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa(".x@example.com  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"\" <x.@x> (bad"), "ERR mail: trailing dot in atom"
  assert_eq pa("a.b #!$%@x"), "ERR mail: no angle-addr"
  assert_eq pa("x: a..b@[a]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("a@b@[a]"), "ERR mail: expected single address, got \"@[a]\""
  assert_eq pa("=?utf-8?b?QsO2Yg==?= jdoe@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("John <x.@x>,"), "ERR mail: trailing dot in atom"
  assert_eq pa("<é@[a]> junk"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("\"\"@"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"a b\"@[1.2.3]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("x: <us_er@[256.0.0.1]>"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("\"\"@[IPv6:::1],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa(".x@[IPv6:1.2.3.4] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"\\\\\"@example.com>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("=?x-unknown?q?a?= <\"\"@ex-ample.org> "), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= \"\\\\\"@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("<\"john..doe\"@a..b> "), "ERR mail: double dot in atom"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= <\"a b\"@[256.0.0.1]> (comment)"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("<john.doe@a..b>,"), "ERR mail: double dot in atom"
  assert_eq pa("Asem H. x.@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("jdoe@ex-ample.org,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("Asem H. <john.doe@[a]>"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("<\"\\\\\"@[::1]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("x.@example.com (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("é@[a] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<us_er@[IPv6:::1]> (comment)"), "|us_er@[IPv6:::1]"
  assert_eq pa("\"Joe Q. Public\" <x.@[192.168.0.1]> junk"), "ERR mail: trailing dot in atom"
  assert_eq pa("a.b <\"\"@a..b>,"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("x.@[1.2.3],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa(" #!$%@"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("John Doe \"john..doe\"@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("Who? <#!$%@a..b> junk"), "ERR mail: double dot in atom"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= <\"\\\\\"@[IPv6:1.2.3.4]>  (x(y)z)"), "ab|\\@[IPv6:1.2.3.4]"
  assert_eq pa("\"a\\\"b\" us_er@x"), "ERR mail: no angle-addr"
  assert_eq pa("Who? <\"john..doe\"@[a]>"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("Who? us_er@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("us_er@ex-ample.org,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <a@b@[1.2.3]> (bad"), "ERR mail: unclosed angle-addr"
  assert_eq pa("=?x-unknown?q?a?= a..b@x"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("\"a\\\"b\" a@b@"), "ERR mail: no angle-addr"
  assert_eq pa("Who? <a..b@[a]> (bad"), "ERR mail: double dot in atom"
  assert_eq pa("Who? \"a b\"@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("<#!$%@x>  (x(y)z)"), "|#!$%@x"
  assert_eq pa("\"\" <john.doe@>,"), "ERR mail: invalid string"
  assert_eq pa("a..b@[IPv6:1.2.3.4] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("us_er@[256.0.0.1],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa(".x@a..b junk"), "ERR mail: missing '@' or angle-addr"
}

test "vectors: address 2" {
  assert_eq pa("Who? <a..b@[::1]> (bad"), "ERR mail: double dot in atom"
  assert_eq pa("\"\"@[1.2.3] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<jdoe@ex-ample.org> (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("\"Joe Q. Public\" john.doe@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("(c) <é@>,"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("<#!$%@ex-ample.org>  (x(y)z)"), "|#!$%@ex-ample.org"
  assert_eq pa("<john.doe@>"), "ERR mail: invalid string"
  assert_eq pa("<\"\"@[IPv6:1.2.3.4]>,"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("John .x@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pa("Who? é@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("<\"a b\"@[1.2.3]> (bad"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("a.b john.doe@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("\"\\\\\"@a..b,"), "ERR mail: no angle-addr"
  assert_eq pa("Asem H. <john.doe@a..b>"), "ERR mail: double dot in atom"
  assert_eq pa("x: <a@b@a..b> (bad"), "ERR mail: unclosed angle-addr"
  assert_eq pa("<\"a b\"@[IPv6:1.2.3.4]> "), "|a b@[IPv6:1.2.3.4]"
  assert_eq pa("John x.@[::1]"), "ERR mail: no angle-addr"
  assert_eq pa("\"john..doe\"@[1.2.3],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<a@b@[a]>,"), "ERR mail: unclosed angle-addr"
  assert_eq pa("\"\" <jdoe@[256.0.0.1]> (comment)"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("<.x@[1.2.3]> (bad"), "ERR mail: leading dot in atom"
  assert_eq pa("Who? <.x@ex-ample.org> (comment)"), "ERR mail: leading dot in atom"
  assert_eq pa("x.@[256.0.0.1] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<a..b@[1.2.3]> (comment)"), "ERR mail: double dot in atom"
  assert_eq pa("(c) \"\\\\\"@a..b"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("a@b@[192.168.0.1]  (x(y)z)"), "ERR mail: expected single address, got \"@[192.168.0.1]  (x(y)z)\""
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= <\"john..doe\"@[1.2.3]> "), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("Böb <a@b@[a]>  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pa("ä ö x.@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("John <\"\\\\\"@[256.0.0.1]> "), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa(".x@[192.168.0.1] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("Böb \"a b\"@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("John \"a b\"@example.com"), "ERR mail: no angle-addr"
  assert_eq pa("x.@[::1]  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"\"@>,"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("<john.doe@ex-ample.org> (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("=?x-unknown?q?a?= .x@[192.168.0.1]"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("a@b@[IPv6:1.2.3.4] "), "ERR mail: expected single address, got \"@[IPv6:1.2.3.4] \""
  assert_eq pa("\"Joe Q. Public\" a..b@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("John Doe <\"a b\"@[a]> (bad"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("\"a\\\"b\" a@b@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("(c) <a..b@example.com> junk"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= <jdoe@[IPv6:::1]> "), "Jörg|jdoe@[IPv6:::1]"
  assert_eq pa("Asem H. <.x@example.com>  (x(y)z)"), "ERR mail: leading dot in atom"
  assert_eq pa("John <\"\\\\\"@[256.0.0.1]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("Who? <a@b@ex-ample.org> (bad"), "ERR mail: unclosed angle-addr"
  assert_eq pa("jdoe@ex-ample.org"), "|jdoe@ex-ample.org"
  assert_eq pa("Who? \"\"@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa("us_er@[192.168.0.1] junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("\"\\\\\"@[a]  (x(y)z)"), "ERR mail: no angle-addr"
  assert_eq pa("<.x@> (comment)"), "ERR mail: leading dot in atom"
  assert_eq pa("\"Joe Q. Public\" <é@x> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("John Doe <\"a b\"@[::1]>"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("x.@[192.168.0.1] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("us_er@example.com "), "|us_er@example.com"
  assert_eq pa("\"\" a@b@"), "ERR mail: no angle-addr"
  assert_eq pa("<\"\\\\\"@ex-ample.org>  (x(y)z)"), "|\\@ex-ample.org"
  assert_eq pa("<\"\"@[256.0.0.1]>"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("jdoe@a..b"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= <é@[1.2.3]> (comment)"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= x.@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <john.doe@ex-ample.org> "), "Jörg|john.doe@ex-ample.org"
  assert_eq pa("us_er@[::1] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("jdoe@[::1] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("jdoe@x  (x(y)z)"), "x(y)z|jdoe@x"
  assert_eq pa("<us_er@example.com>  (x(y)z)"), "|us_er@example.com"
  assert_eq pa("John <a..b@example.com> junk"), "ERR mail: double dot in atom"
  assert_eq pa("\"a\\\"b\" <x.@[a]>"), "ERR mail: trailing dot in atom"
  assert_eq pa("a.b us_er@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("<a..b@example.com>"), "ERR mail: double dot in atom"
  assert_eq pa("<a@b@ex-ample.org> junk"), "ERR mail: unclosed angle-addr"
  assert_eq pa("Who? .x@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= us_er@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("a..b@x (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("x: #!$%@[256.0.0.1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<jdoe@ex-ample.org> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("John <a@b@> junk"), "ERR mail: unclosed angle-addr"
  assert_eq pa("x.@a..b (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("#!$%@[IPv6:1.2.3.4] (comment)"), "comment|#!$%@[IPv6:1.2.3.4]"
  assert_eq pa("John Doe \"\\\\\"@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("\"a\\\"b\" <\"a b\"@[192.168.0.1]> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("\"john..doe\"@[IPv6:1.2.3.4] (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("\"a b\"@x  (x(y)z)"), "x(y)z|a b@x"
  assert_eq pa("<\"john..doe\"@a..b>,"), "ERR mail: double dot in atom"
  assert_eq pa("Asem H. \"\"@"), "ERR mail: no angle-addr"
  assert_eq pa("<é@[256.0.0.1]>,"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("<.x@[IPv6:1.2.3.4]> (bad"), "ERR mail: leading dot in atom"
  assert_eq pa("Böb \"\\\\\"@x"), "ERR mail: no angle-addr"
  assert_eq pa("<john.doe@a..b> junk"), "ERR mail: double dot in atom"
  assert_eq pa("ä ö a..b@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("x.@x,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<john.doe@[::1]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("John é@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("<\"\\\\\"@[::1]> (bad"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("us_er@example.com (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("a.b a@b@"), "ERR mail: no angle-addr"
  assert_eq pa("\"\"@[::1] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("x: <\"a b\"@[a]>"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("<us_er@x> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("\"\\\\\"@example.com "), "|\\@example.com"
}

test "vectors: address 3" {
  assert_eq pa("Böb #!$%@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("<us_er@a..b>  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= \"john..doe\"@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("john.doe@example.com "), "|john.doe@example.com"
  assert_eq pa("\"\\\\\"@ junk"), "|\\@junk"
  assert_eq pa("john.doe@[1.2.3] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<jdoe@[256.0.0.1]>,"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("\"\\\\\"@[IPv6:1.2.3.4]"), "|\\@[IPv6:1.2.3.4]"
  assert_eq pa("x.@[::1],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("(c) us_er@[256.0.0.1]"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("\"\\\\\"@[IPv6:::1] "), "|\\@[IPv6:::1]"
  assert_eq pa("<john.doe@[256.0.0.1]>"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("(c) <us_er@[a]> (comment)"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("\"a b\"@[a] (bad"), "ERR mail: no angle-addr"
  assert_eq pa("us_er@x"), "|us_er@x"
  assert_eq pa("jdoe@[256.0.0.1] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("Böb <john.doe@x>"), "Böb|john.doe@x"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= a@b@a..b"), "ERR mail: no angle-addr"
  assert_eq pa(" \"a b\"@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("jdoe@[IPv6:::1]"), "|jdoe@[IPv6:::1]"
  assert_eq pa("<us_er@[IPv6:1.2.3.4]> (comment)"), "|us_er@[IPv6:1.2.3.4]"
  assert_eq pa("us_er@example.com  (x(y)z)"), "x(y)z|us_er@example.com"
  assert_eq pa("\"john..doe\"@[::1]  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("a@b@[::1],"), "ERR mail: expected single address, got \"@[::1],\""
  assert_eq pa("<#!$%@[a]> "), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("<a@b@[1.2.3]>  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pa("\"john..doe\"@[192.168.0.1],"), "ERR mail: expected single address, got \",\""
  assert_eq pa("<\"\\\\\"@x> (comment)"), "|\\@x"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= <\"\\\\\"@[256.0.0.1]>"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= jdoe@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("John #!$%@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa("John Doe <a..b@> (comment)"), "ERR mail: double dot in atom"
  assert_eq pa("<.x@[256.0.0.1]> junk"), "ERR mail: leading dot in atom"
  assert_eq pa("<\"\"@[a]> "), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa(" \"\\\\\"@[192.168.0.1]"), "|\\@[192.168.0.1]"
  assert_eq pa("ä ö <a@b@a..b>  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= \"a b\"@example.com"), "ERR mail: no angle-addr"
  assert_eq pa("John Doe \"\\\\\"@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= a@b@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pa("\"john..doe\"@[256.0.0.1],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"a\\\"b\" jdoe@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("us_er@[192.168.0.1] (comment)"), "comment|us_er@[192.168.0.1]"
  assert_eq pa("é@[IPv6:::1]"), "|é@[IPv6:::1]"
  assert_eq pa("John <john.doe@x>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("jdoe@example.com (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa(".x@[::1] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("a..b@[256.0.0.1] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa(" <\"\\\\\"@ex-ample.org>"), "|\\@ex-ample.org"
  assert_eq pa("Böb jdoe@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("<é@ex-ample.org>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("<\"john..doe\"@x>  (x(y)z)"), "|john..doe@x"
  assert_eq pa("john.doe@example.com  (x(y)z)"), "x(y)z|john.doe@example.com"
  assert_eq pa("<a@b@[256.0.0.1]>  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pa("<jdoe@ex-ample.org>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("Böb <x.@example.com>"), "ERR mail: trailing dot in atom"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <x.@[IPv6:::1]>"), "ERR mail: trailing dot in atom"
  assert_eq pa("x: <\"\"@ex-ample.org>"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("John Doe <#!$%@[a]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("<us_er@x>  (x(y)z)"), "|us_er@x"
  assert_eq pa("<\"john..doe\"@x> "), "|john..doe@x"
  assert_eq pa("jdoe@[::1] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= a..b@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("<\"\\\\\"@> (bad"), "ERR mail: invalid string"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= \"a b\"@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("a.b #!$%@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("ä ö <a@b@example.com> "), "ERR mail: unclosed angle-addr"
  assert_eq pa(" jdoe@[a]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("jdoe@[IPv6:1.2.3.4] "), "|jdoe@[IPv6:1.2.3.4]"
  assert_eq pa("John Doe <us_er@>,"), "ERR mail: invalid string"
  assert_eq pa("<x.@[a]> "), "ERR mail: trailing dot in atom"
  assert_eq pa("a.b john.doe@[::1]"), "ERR mail: no angle-addr"
  assert_eq pa(" <é@example.com>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("<a..b@[IPv6:1.2.3.4]> (comment)"), "ERR mail: double dot in atom"
  assert_eq pa("\"Joe Q. Public\" <\"john..doe\"@[256.0.0.1]> junk"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("John <john.doe@a..b>"), "ERR mail: double dot in atom"
  assert_eq pa("<\"john..doe\"@x>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("<x.@example.com> "), "ERR mail: trailing dot in atom"
  assert_eq pa("<é@example.com> (comment)"), "|é@example.com"
  assert_eq pa("Böb \"a b\"@[::1]"), "ERR mail: no angle-addr"
  assert_eq pa("\"\"@ex-ample.org junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= \"\"@"), "ERR mail: no angle-addr"
  assert_eq pa("<\"john..doe\"@[::1]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("ä ö <#!$%@[IPv6:::1]>  (x(y)z)"), "ä ö|#!$%@[IPv6:::1]"
  assert_eq pa("<\"\"@[192.168.0.1]> (comment)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <\"\\\\\"@[1.2.3]> "), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("=?x-unknown?q?a?= a@b@x"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("<\"\"@example.com> (comment)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("<us_er@[192.168.0.1]>"), "|us_er@[192.168.0.1]"
  assert_eq pa("<\"john..doe\"@[256.0.0.1]> "), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("\"\" <é@ex-ample.org> (comment)"), "|é@ex-ample.org"
  assert_eq pa("John Doe é@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("<\"john..doe\"@[192.168.0.1]>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("x: x.@[1.2.3]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("ä ö \"\"@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("Asem H. <\"a b\"@[256.0.0.1]>,"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= a@b@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("<jdoe@[IPv6:::1]> (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("=?x-unknown?q?a?= <john.doe@a..b> (bad"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("\"\\\\\"@x (comment)"), "comment|\\@x"
  assert_eq pa("a..b@ex-ample.org (bad"), "ERR mail: missing '@' or angle-addr"
}

test "vectors: address 4" {
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= \"\"@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= <a@b@ex-ample.org> (bad"), "ERR mail: unclosed angle-addr"
  assert_eq pa(".x@[256.0.0.1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<a@b@example.com>  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pa("jdoe@[256.0.0.1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("ä ö <é@ex-ample.org> (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("a.b <john.doe@example.com> (comment)"), "a.b|john.doe@example.com"
  assert_eq pa("=?x-unknown?q?a?= john.doe@example.com"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("ä ö \"\\\\\"@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("=?x-unknown?q?a?= <#!$%@x> (comment)"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("John Doe é@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("<\"\"@> junk"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("=?x-unknown?q?a?= <.x@[192.168.0.1]> (comment)"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("\"\"@[1.2.3] (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<a..b@[a]> junk"), "ERR mail: double dot in atom"
  assert_eq pa("\"\"@[IPv6:1.2.3.4],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("(c) <é@[256.0.0.1]> (comment)"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa(".x@[a]  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<jdoe@[IPv6:::1]> (comment)"), "|jdoe@[IPv6:::1]"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= \"a b\"@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= \"\"@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("<\"\"@x> junk"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("<x.@[192.168.0.1]> "), "ERR mail: trailing dot in atom"
  assert_eq pa("<a@b@> (comment)"), "ERR mail: unclosed angle-addr"
  assert_eq pa("<\"\"@[192.168.0.1]>  (x(y)z)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("John Doe <us_er@ex-ample.org> (comment)"), "John Doe|us_er@ex-ample.org"
  assert_eq pa("Böb <jdoe@[IPv6:::1]>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("<é@> junk"), "ERR mail: invalid string"
  assert_eq pa("\"\" #!$%@example.com"), "ERR mail: no angle-addr"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= a@b@[::1]"), "ERR mail: no angle-addr"
  assert_eq pa("a.b jdoe@"), "ERR mail: no angle-addr"
  assert_eq pa("<\"john..doe\"@example.com>  (x(y)z)"), "|john..doe@example.com"
  assert_eq pa("a@b@[IPv6:1.2.3.4] junk"), "ERR mail: expected single address, got \"@[IPv6:1.2.3.4] junk\""
  assert_eq pa("\"a\\\"b\" é@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= \"a b\"@x"), "ERR mail: no angle-addr"
  assert_eq pa("<a..b@[256.0.0.1]> "), "ERR mail: double dot in atom"
  assert_eq pa("<#!$%@[1.2.3]>,"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("<\"\"@[::1]> (comment)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("John <us_er@[IPv6:1.2.3.4]>  (x(y)z)"), "John|us_er@[IPv6:1.2.3.4]"
  assert_eq pa("a.b <.x@[1.2.3]> junk"), "ERR mail: leading dot in atom"
  assert_eq pa("(c) <\"\"@[IPv6:::1]>,"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("x: é@"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("John jdoe@x"), "ERR mail: no angle-addr"
  assert_eq pa("\"a\\\"b\" \"\"@[::1]"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= #!$%@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("<a@b@example.com>,"), "ERR mail: unclosed angle-addr"
  assert_eq pa("\"john..doe\"@[a] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("#!$%@[256.0.0.1] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa(" jdoe@[IPv6:::1]"), "|jdoe@[IPv6:::1]"
  assert_eq pa("ä ö <\"\\\\\"@example.com> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("=?utf-8?b?QsO2Yg==?= \"\"@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa("<a@b@x>,"), "ERR mail: unclosed angle-addr"
  assert_eq pa("x.@ (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<john.doe@[256.0.0.1]> "), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("\"a b\"@[IPv6:::1],"), "ERR mail: expected single address, got \",\""
  assert_eq pa("\"a\\\"b\" x.@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("\"Joe Q. Public\" a@b@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pa("<john.doe@[192.168.0.1]> (comment)"), "|john.doe@[192.168.0.1]"
  assert_eq pa(" <é@ex-ample.org>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("\"a b\"@example.com "), "|a b@example.com"
  assert_eq pa("<a@b@x> "), "ERR mail: unclosed angle-addr"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= <jdoe@example.com>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa(".x@example.com (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"\"@> (bad"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("<a..b@x> (comment)"), "ERR mail: double dot in atom"
  assert_eq pa("Who? <a..b@[::1]>"), "ERR mail: double dot in atom"
  assert_eq pa("Böb <us_er@[IPv6:::1]>  (x(y)z)"), "Böb|us_er@[IPv6:::1]"
  assert_eq pa("\"a b\"@"), "ERR mail: no angle-addr"
  assert_eq pa("<#!$%@[192.168.0.1]> "), "|#!$%@[192.168.0.1]"
  assert_eq pa("<#!$%@example.com>  (x(y)z)"), "|#!$%@example.com"
  assert_eq pa("<john.doe@example.com>  (x(y)z)"), "|john.doe@example.com"
  assert_eq pa("x.@[IPv6:::1],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("a..b@[IPv6:1.2.3.4]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("Asem H. <\"john..doe\"@[::1]> (bad"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("a.b .x@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("Who? us_er@[IPv6:::1]"), "ERR mail: no angle-addr"
  assert_eq pa("Asem H. <é@[1.2.3]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("\"Joe Q. Public\" <a..b@[IPv6:1.2.3.4]> (comment)"), "ERR mail: double dot in atom"
  assert_eq pa("<#!$%@ex-ample.org>"), "|#!$%@ex-ample.org"
  assert_eq pa("<#!$%@[256.0.0.1]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= <\"john..doe\"@[IPv6:1.2.3.4]> "), "Jörg|john..doe@[IPv6:1.2.3.4]"
  assert_eq pa("\"Joe Q. Public\" \"john..doe\"@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("<a@b@[::1]> "), "ERR mail: unclosed angle-addr"
  assert_eq pa("<\"a b\"@[a]>"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("x: a..b@example.com"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"a b\"@[a]>,"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("<\"john..doe\"@[::1]>,"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("<#!$%@[IPv6:::1]>"), "|#!$%@[IPv6:::1]"
  assert_eq pa("\"\"@[192.168.0.1] (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<é@[IPv6:::1]> "), "|é@[IPv6:::1]"
  assert_eq pa("John <.x@a..b>  (x(y)z)"), "ERR mail: leading dot in atom"
  assert_eq pa("<a..b@x>  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pa("<#!$%@a..b>  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pa("x: <\"john..doe\"@[IPv6:::1]> (comment)"), "ERR mail: expected comma"
  assert_eq pa("\"Joe Q. Public\" a@b@"), "ERR mail: no angle-addr"
  assert_eq pa(" jdoe@example.com"), "|jdoe@example.com"
  assert_eq pa("us_er@[192.168.0.1] (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= jdoe@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("é@a..b"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"john..doe\"@[1.2.3]> junk"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
}

test "vectors: address 5" {
  assert_eq pa("=?x-unknown?q?a?= <.x@example.com>"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa(" \"john..doe\"@[IPv6:1.2.3.4]"), "|john..doe@[IPv6:1.2.3.4]"
  assert_eq pa("<\"\"@ex-ample.org> junk"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("x: \"john..doe\"@a..b"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= a@b@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("=?x-unknown?q?a?= <us_er@[IPv6:1.2.3.4]>  (x(y)z)"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("<#!$%@[a]> (bad"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa(" jdoe@[IPv6:1.2.3.4]"), "|jdoe@[IPv6:1.2.3.4]"
  assert_eq pa("ä ö \"\"@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("=?x-unknown?q?a?= .x@x"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("John Doe <\"john..doe\"@[a]> junk"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("a.b \"a b\"@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pa("Asem H. <é@[IPv6:::1]> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= x.@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("ä ö <a@b@[IPv6:1.2.3.4]>"), "ERR mail: unclosed angle-addr"
  assert_eq pa("x.@[IPv6:1.2.3.4] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("x.@"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"Joe Q. Public\" .x@x"), "ERR mail: no angle-addr"
  assert_eq pa("<john.doe@[192.168.0.1]> "), "|john.doe@[192.168.0.1]"
  assert_eq pa("<\"\\\\\"@a..b> (bad"), "ERR mail: double dot in atom"
  assert_eq pa("<.x@[192.168.0.1]> junk"), "ERR mail: leading dot in atom"
  assert_eq pa("Who? <jdoe@[a]>"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("john.doe@[256.0.0.1] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"a b\"@[::1]> (bad"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("<#!$%@a..b>,"), "ERR mail: double dot in atom"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= <.x@[a]> junk"), "ERR mail: leading dot in atom"
  assert_eq pa("\"a\\\"b\" \"\"@example.com"), "ERR mail: no angle-addr"
  assert_eq pa("a.b <jdoe@a..b> "), "ERR mail: double dot in atom"
  assert_eq pa("é@[IPv6:::1] (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("(c) <\"\"@> (comment)"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("\"a\\\"b\" é@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("us_er@a..b "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("John Doe \"\"@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("John \"\\\\\"@ex-ample.org"), "ERR mail: no angle-addr"
  assert_eq pa("<é@x>  (x(y)z)"), "|é@x"
  assert_eq pa("John Doe <jdoe@ex-ample.org> (comment)"), "John Doe|jdoe@ex-ample.org"
  assert_eq pa("\"john..doe\"@example.com  (x(y)z)"), "x(y)z|john..doe@example.com"
  assert_eq pa("<\"\"@[IPv6:::1]>,"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("=?x-unknown?q?a?= \"\\\\\"@[256.0.0.1]"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("John Doe <é@[::1]> "), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("ä ö \"\"@[192.168.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <a..b@[192.168.0.1]>  (x(y)z)"), "ERR mail: double dot in atom"
  assert_eq pa("=?x-unknown?q?a?= <x.@a..b>,"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa(" john.doe@[1.2.3]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= <\"john..doe\"@[256.0.0.1]>"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("=?utf-8?b?QsO2Yg==?= jdoe@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("\"a b\"@[192.168.0.1]  (x(y)z)"), "x(y)z|a b@[192.168.0.1]"
  assert_eq pa("Who? <john.doe@[IPv6:::1]> (comment)"), "Who?|john.doe@[IPv6:::1]"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= #!$%@x"), "ERR mail: no angle-addr"
  assert_eq pa("\"\"@[::1] (comment)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<é@[a]>  (x(y)z)"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= <\"\\\\\"@[192.168.0.1]> "), "ab|\\@[192.168.0.1]"
  assert_eq pa("\"john..doe\"@ex-ample.org,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("ä ö <\"\\\\\"@x>  (x(y)z)"), "ä ö|\\@x"
  assert_eq pa("\"a\\\"b\" \"\\\\\"@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("John <john.doe@[IPv6:::1]> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("<\"\"@[IPv6:1.2.3.4]>"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("x: <a@b@[::1]> (bad"), "ERR mail: unclosed angle-addr"
  assert_eq pa("\"a b\"@ (comment)"), "ERR mail: no angle-addr"
  assert_eq pa("a.b <é@[IPv6:::1]>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("Böb <a@b@[1.2.3]>"), "ERR mail: unclosed angle-addr"
  assert_eq pa("<us_er@x> "), "|us_er@x"
  assert_eq pa("<#!$%@x>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("jdoe@ (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<#!$%@[IPv6:::1]> "), "|#!$%@[IPv6:::1]"
  assert_eq pa("#!$%@example.com junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("\"a\\\"b\" <\"\"@[::1]>,"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("John Doe a..b@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("=?utf-8?q?a?= =?utf-8?q?b?= \"\"@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa("\"a\\\"b\" <a@b@example.com>"), "ERR mail: unclosed angle-addr"
  assert_eq pa("#!$%@x  (x(y)z)"), "x(y)z|#!$%@x"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= us_er@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= .x@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa("<a..b@[192.168.0.1]> junk"), "ERR mail: double dot in atom"
  assert_eq pa("jdoe@[a],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?iso-8859-1?q?J=F6rg?= \"\"@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("Asem H. <a@b@x>"), "ERR mail: unclosed angle-addr"
  assert_eq pa("\"Joe Q. Public\" <é@[256.0.0.1]> (comment)"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("(c) jdoe@[192.168.0.1]"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("<#!$%@a..b> junk"), "ERR mail: double dot in atom"
  assert_eq pa("a@b@[::1] "), "ERR mail: expected single address, got \"@[::1] \""
  assert_eq pa(".x@x,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("a.b <\"a b\"@[IPv6:::1]>  (x(y)z)"), "a.b|a b@[IPv6:::1]"
  assert_eq pa("<\"john..doe\"@x> junk"), "ERR mail: expected single address, got \"junk\""
  assert_eq pa("\"Joe Q. Public\" <a@b@[a]> junk"), "ERR mail: unclosed angle-addr"
  assert_eq pa("(c) john.doe@[256.0.0.1]"), "ERR mail: missing word in phrase: mail: invalid string"
  assert_eq pa("\"a\\\"b\" <john.doe@[1.2.3]> (bad"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("John Doe <jdoe@x> (comment)"), "John Doe|jdoe@x"
  assert_eq pa("a..b@[a]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"Joe Q. Public\" <a@b@>"), "ERR mail: unclosed angle-addr"
  assert_eq pa("<\"a b\"@[256.0.0.1]>"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("=?utf-8?b?QsO2Yg==?= <jdoe@[::1]>"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("<\"a b\"@[::1]> junk"), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("jdoe@example.com (comment)"), "comment|jdoe@example.com"
  assert_eq pa("John <\"a b\"@a..b> "), "ERR mail: double dot in atom"
  assert_eq pa("\"john..doe\"@x "), "|john..doe@x"
  assert_eq pa("ä ö \"\"@[1.2.3]"), "ERR mail: no angle-addr"
  assert_eq pa("\"a\\\"b\" \"a b\"@[::1]"), "ERR mail: no angle-addr"
  assert_eq pa("<a@b@[IPv6:1.2.3.4]>  (x(y)z)"), "ERR mail: unclosed angle-addr"
  assert_eq pa("John <a..b@[IPv6:::1]> (bad"), "ERR mail: double dot in atom"
}

test "vectors: address 6" {
  assert_eq pa("x.@ex-ample.org"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= <\"a b\"@[IPv6:::1]> (comment)"), "Böb|a b@[IPv6:::1]"
  assert_eq pa("<us_er@[IPv6:::1]> (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("#!$%@[IPv6:1.2.3.4]  (x(y)z)"), "x(y)z|#!$%@[IPv6:1.2.3.4]"
  assert_eq pa("a..b@[IPv6:::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"\"@[1.2.3]>  (x(y)z)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("<jdoe@[1.2.3]> junk"), "ERR mail: invalid IP address in domain-literal: \"1.2.3\""
  assert_eq pa("#!$%@,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= <a..b@a..b> (bad"), "ERR mail: double dot in atom"
  assert_eq pa("é@[192.168.0.1] (comment)"), "comment|é@[192.168.0.1]"
  assert_eq pa("\"a b\"@a..b "), "ERR mail: no angle-addr"
  assert_eq pa("\"\" <a..b@[1.2.3]> "), "ERR mail: double dot in atom"
  assert_eq pa("#!$%@  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("x.@a..b,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("Who? a..b@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("John Doe <a..b@ex-ample.org>"), "ERR mail: double dot in atom"
  assert_eq pa("=?utf-8?q?J=C3=B6rg?= <\"john..doe\"@[IPv6:1.2.3.4]> (comment)"), "Jörg|john..doe@[IPv6:1.2.3.4]"
  assert_eq pa("us_er@x (comment)"), "comment|us_er@x"
