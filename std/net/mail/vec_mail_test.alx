  assert_eq pa("\"a\\\"b\" <é@[192.168.0.1]> "), "a\"b|é@[192.168.0.1]"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= a..b@x"), "ERR mail: no angle-addr"
  assert_eq pa("John <.x@[::1]> (bad"), "ERR mail: leading dot in atom"
  assert_eq pa("=?x-unknown?q?a?= <x.@a..b> "), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("x.@x  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("jdoe@[IPv6:::1] (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa("=?x-unknown?q?a?= us_er@[a]"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("a..b@a..b "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"\"@[::1] (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<a@b@[a]> junk"), "ERR mail: unclosed angle-addr"
  assert_eq pa("John Doe <a..b@>"), "ERR mail: double dot in atom"
  assert_eq pa("\"Joe Q. Public\" <\"a b\"@a..b> "), "ERR mail: double dot in atom"
  assert_eq pa("john.doe@[256.0.0.1],"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa(" <\"\"@[192.168.0.1]>  (x(y)z)"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("x: \"\"@[1.2.3]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("#!$%@[1.2.3] junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("jdoe@[a]  (x(y)z)"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("=?x-unknown?q?a?= x.@ex-ample.org"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("a@b@ (comment)"), "ERR mail: expected single address, got \"@ (comment)\""
  assert_eq pa("\"\" <a..b@[256.0.0.1]>"), "ERR mail: double dot in atom"
  assert_eq pa("John \"\"@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("\"Joe Q. Public\" john.doe@[256.0.0.1]"), "ERR mail: no angle-addr"
  assert_eq pa("a.b <.x@[IPv6:::1]>  (x(y)z)"), "ERR mail: leading dot in atom"
  assert_eq pa("John Doe <\"a b\"@[192.168.0.1]> (comment)"), "John Doe|a b@[192.168.0.1]"
  assert_eq pa("\"a b\"@x "), "|a b@x"
  assert_eq pa(" .x@[IPv6:::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("x.@[::1] (bad"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("x: <\"\\\\\"@example.com>  (x(y)z)"), "ERR mail: expected comma"
  assert_eq pa("=?utf-8?b?QsO2Yg==?= <.x@a..b> (bad"), "ERR mail: leading dot in atom"
  assert_eq pa("ä ö <us_er@[256.0.0.1]> (comment)"), "ERR mail: invalid IP address in domain-literal: \"256.0.0.1\""
  assert_eq pa("Who? <john.doe@[IPv6:1.2.3.4]> (comment)"), "Who?|john.doe@[IPv6:1.2.3.4]"
  assert_eq pa("\"a\\\"b\" <a..b@[1.2.3]>,"), "ERR mail: double dot in atom"
  assert_eq pa("Böb <\"a b\"@x> "), "Böb|a b@x"
  assert_eq pa("a..b@ junk"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"a\\\"b\" #!$%@[a]"), "ERR mail: no angle-addr"
  assert_eq pa("\"a b\"@a..b (bad"), "ERR mail: no angle-addr"
  assert_eq pa(".x@"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<john.doe@[::1]> "), "ERR mail: invalid IP address in domain-literal: \"::1\""
  assert_eq pa("<#!$%@x> (comment)"), "|#!$%@x"
  assert_eq pa(".x@[IPv6:::1]"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("\"a b\"@a..b  (x(y)z)"), "ERR mail: no angle-addr"
}

