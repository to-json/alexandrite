  assert_eq pa("john.doe@,"), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<john.doe@example.com>"), "|john.doe@example.com"
  assert_eq pa("John a..b@[IPv6:1.2.3.4]"), "ERR mail: no angle-addr"
  assert_eq pa("<jdoe@x> (comment)"), "|jdoe@x"
  assert_eq pa("Böb \"john..doe\"@a..b"), "ERR mail: no angle-addr"
  assert_eq pa("<#!$%@[a]> junk"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("x: <\"\"@[192.168.0.1]> (bad"), "ERR mail: empty quoted string in addr-spec"
  assert_eq pa("a..b@[1.2.3] "), "ERR mail: missing '@' or angle-addr"
  assert_eq pa("<\"\\\\\"@example.com>"), "|\\@example.com"
  assert_eq pa(" #!$%@[IPv6:1.2.3.4]"), "|#!$%@[IPv6:1.2.3.4]"
  assert_eq pa("=?x-unknown?q?a?= a..b@ex-ample.org"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("=?x-unknown?q?a?= <john.doe@[256.0.0.1]>,"), "ERR mail: missing word in phrase: charset not supported: \"x-unknown\""
  assert_eq pa("x: <.x@x>"), "ERR mail: leading dot in atom"
  assert_eq pa("John Doe <é@[a]> (bad"), "ERR mail: invalid IP address in domain-literal: \"a\""
  assert_eq pa("\"a b\"@[IPv6:1.2.3.4] (bad"), "ERR mail: misformatted parenthetical comment"
  assert_eq pa(" \"a b\"@ex-ample.org"), "|a b@ex-ample.org"
