  assert_eq pds(" Tue, 32 Jan 97 09:55 -0600\r"), "ERR mail: header has a CR without LF"
  assert_eq pds("Fri  OCT 97 09:55 Z junk"), "ERR mail: header could not be parsed"
  assert_eq pds(" Tue, 7 Jan 7 23:59:60 UTC"), "ERR mail: header could not be parsed"
  assert_eq pds("1 Jan 97 23:59:60 +1300 (MDT)"), "ERR mail: header could not be parsed"
  assert_eq pds("7 May 7 09:55 XYZ  \r\n (c)"), "ERR mail: header could not be parsed"
  assert_eq pds("Mon, 32 May 97 9:55:06 +0000\r"), "ERR mail: header has a CR without LF"
  assert_eq pds("Mon, 7 Foo 97 9:55:06 Z (bad"), "ERR mail: header could not be parsed"
}

test "vectors: message 0" {
  assert_eq read_msg("\r\nbody line\r\nmore\n"), "\nbody line\r\nmore\n"
  assert_eq read_msg("Bad line\n: nokey\r\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Bad line\r\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Key : spaced\nTo: <x@y>, z@w\nCustom/Header: v\n\n"), "Custom/Header=[v];Key =[spaced];To=[<x@y>, z@w]\n"
  assert_eq read_msg("subject: again\r\n\r\nbody line\r\nmore\n"), "Subject=[again]\nbody line\r\nmore\n"
  assert_eq read_msg("Custom/Header: v\nCustom/Header: v\r\n\r\nbody line\r\nmore\n"), "Custom/Header=[v|v]\nbody line\r\nmore\n"
  assert_eq read_msg("Key : spaced\n\r\nbody line\r\nmore\n"), "Key =[spaced]\nbody line\r\nmore\n"
  assert_eq read_msg(": nokey\n\r\nbody line\r\nmore\n"), "\nbody line\r\nmore\n"
  assert_eq read_msg("X-Y: v1\r\nFrom x@y Mon Jun 19 00:00:00 2023\r\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("\n"), "\n"
  assert_eq read_msg("K:\r\nK:\r\n: nokey\r\n\n"), "K=[|]\n"
  assert_eq read_msg("From: a@b\nX-Y: v1\r\n\tfolded2\n\r\nbody line\r\nmore\n"), "From=[a@b];X-Y=[v1 folded2]\nbody line\r\nmore\n"
  assert_eq read_msg(""), "ERR EOF"
  assert_eq read_msg("From: a@b\nK:\r\n\tfolded2\n\r\nbody line\r\nmore\n"), "From=[a@b];K=[folded2]\nbody line\r\nmore\n"
  assert_eq read_msg("Key : spaced\nBad line\n\tfolded2\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line folded2\""
  assert_eq read_msg(": nokey\r\nX-Y: v1\r\nsubject: again\r\n\tfolded2\r\n"), "Subject=[again folded2];X-Y=[v1]\n"
  assert_eq read_msg("X-Y: v1\r\n: nokey\n"), "X-Y=[v1]\n"
  assert_eq read_msg("From: a@b\r\nsubject: again\n\tfolded2\r\n\r\nbody line\r\nmore\n"), "From=[a@b];Subject=[again folded2]\nbody line\r\nmore\n"
  assert_eq read_msg("Bad line\nFrom: a@b\r\n folded\r\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("\tfolded2\r\nK:\r\nCustom/Header: v\r\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("\tfolded2\r\nSubject: hi\r\nK:\r\n: nokey\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("X-Y: v1\r\n folded\nX-Y: v1\n\r\nbody line\r\nmore\n"), "X-Y=[v1 folded|v1]\nbody line\r\nmore\n"
  assert_eq read_msg("To: <x@y>, z@w\nFrom: a@b\r\nBad line\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("subject: again\nKey : spaced\n\tfolded2\nX-Y: v1\r\n\r\nbody line\r\nmore\n"), "Key =[spaced folded2];Subject=[again];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg(": nokey\r\n\r\nbody line\r\nmore\n"), "\nbody line\r\nmore\n"
  assert_eq read_msg("Key : spaced\nFrom x@y Mon Jun 19 00:00:00 2023\nCustom/Header: v\r\nFrom x@y Mon Jun 19 00:00:00 2023\r\n\n"), "Custom/Header=[v];From x@y Mon Jun 19 00=[00:00 2023|00:00 2023];Key =[spaced]\n"
  assert_eq read_msg("To: <x@y>, z@w\n\n"), "To=[<x@y>, z@w]\n"
  assert_eq read_msg("X-Y: v1\r\n folded\n"), "X-Y=[v1 folded]\n"
  assert_eq read_msg("Subject: hi\nFrom x@y Mon Jun 19 00:00:00 2023\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023];Subject=[hi]\nbody line\r\nmore\n"
  assert_eq read_msg("From: a@b\r\nTo: <x@y>, z@w\nTo: <x@y>, z@w\r\n folded\r\n\r\nbody line\r\nmore\n"), "From=[a@b];To=[<x@y>, z@w|<x@y>, z@w folded]\nbody line\r\nmore\n"
  assert_eq read_msg(" folded\r\n folded\r\nTo: <x@y>, z@w\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg(" folded\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg(" folded\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("From: a@b\r\nK:\r\n\n"), "From=[a@b];K=[]\n"
  assert_eq read_msg(": nokey\n: nokey\r\nKey : spaced\r\n\r\nbody line\r\nmore\n"), "Key =[spaced]\nbody line\r\nmore\n"
  assert_eq read_msg("Subject: hi\r\nsubject: again\n\r\nbody line\r\nmore\n"), "Subject=[hi|again]\nbody line\r\nmore\n"
  assert_eq read_msg("\tfolded2\nsubject: again\r\nSubject: hi\r\nCustom/Header: v\r\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("X-Y: v1\r\nK:\r\n\r\nbody line\r\nmore\n"), "K=[];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("To: <x@y>, z@w\nX-Y: v1\nX-Y: v1\n\r\nbody line\r\nmore\n"), "To=[<x@y>, z@w];X-Y=[v1|v1]\nbody line\r\nmore\n"
  assert_eq read_msg("Key : spaced\r\nTo: <x@y>, z@w\r\nFrom x@y Mon Jun 19 00:00:00 2023\nFrom x@y Mon Jun 19 00:00:00 2023\n"), "From x@y Mon Jun 19 00=[00:00 2023|00:00 2023];Key =[spaced];To=[<x@y>, z@w]\n"
  assert_eq read_msg("K:\n"), "K=[]\n"
  assert_eq read_msg("X-Y: v1\r\nKey : spaced\n"), "Key =[spaced];X-Y=[v1]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nCustom/Header: v\r\nsubject: again\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];From x@y Mon Jun 19 00=[00:00 2023];Subject=[again]\nbody line\r\nmore\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nCustom/Header: v\r\nFrom x@y Mon Jun 19 00:00:00 2023\nTo: <x@y>, z@w\n"), "Custom/Header=[v];From x@y Mon Jun 19 00=[00:00 2023|00:00 2023];To=[<x@y>, z@w]\n"
  assert_eq read_msg("Key : spaced\nsubject: again\nCustom/Header: v\r\n"), "Custom/Header=[v];Key =[spaced];Subject=[again]\n"
  assert_eq read_msg("X-Y: v1\nFrom x@y Mon Jun 19 00:00:00 2023\r\n: nokey\r\n\tfolded2\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("To: <x@y>, z@w\n folded\nKey : spaced\n\r\nbody line\r\nmore\n"), "Key =[spaced];To=[<x@y>, z@w folded]\nbody line\r\nmore\n"
  assert_eq read_msg("To: <x@y>, z@w\r\n\r\nbody line\r\nmore\n"), "To=[<x@y>, z@w]\nbody line\r\nmore\n"
  assert_eq read_msg("Subject: hi\r\n\tfolded2\r\n\n"), "Subject=[hi folded2]\n"
  assert_eq read_msg("\tfolded2\r\nK:\r\n: nokey\nX-Y: v1\r\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("\tfolded2\nFrom x@y Mon Jun 19 00:00:00 2023\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg(" folded\r\nBad line\r\nCustom/Header: v\r\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nBad line\r\nFrom: a@b\r\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Key : spaced\r\nTo: <x@y>, z@w\r\nFrom: a@b\r\n\r\nbody line\r\nmore\n"), "From=[a@b];Key =[spaced];To=[<x@y>, z@w]\nbody line\r\nmore\n"
  assert_eq read_msg("Subject: hi\r\nFrom: a@b\n"), "From=[a@b];Subject=[hi]\n"
  assert_eq read_msg("Subject: hi\n: nokey\nX-Y: v1\nFrom: a@b\n\n"), "From=[a@b];Subject=[hi];X-Y=[v1]\n"
  assert_eq read_msg("Custom/Header: v\n\tfolded2\r\nFrom: a@b\n\r\nbody line\r\nmore\n"), "Custom/Header=[v folded2];From=[a@b]\nbody line\r\nmore\n"
  assert_eq read_msg("\tfolded2\r\nCustom/Header: v\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("From: a@b\nBad line\nBad line\r\nX-Y: v1\r\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("From: a@b\n\n"), "From=[a@b]\n"
  assert_eq read_msg("K:\n\r\nbody line\r\nmore\n"), "K=[]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\n\tfolded2\n\tfolded2\r\nCustom/Header: v\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];K=[folded2 folded2]\nbody line\r\nmore\n"
  assert_eq read_msg("Custom/Header: v\nKey : spaced\n\tfolded2\nCustom/Header: v\n"), "Custom/Header=[v|v];Key =[spaced folded2]\n"
  assert_eq read_msg("Custom/Header: v\r\n folded\nTo: <x@y>, z@w\r\n\tfolded2\n"), "Custom/Header=[v folded];To=[<x@y>, z@w folded2]\n"
  assert_eq read_msg("K:\r\n\r\nbody line\r\nmore\n"), "K=[]\nbody line\r\nmore\n"
  assert_eq read_msg("Custom/Header: v\nCustom/Header: v\n\r\nbody line\r\nmore\n"), "Custom/Header=[v|v]\nbody line\r\nmore\n"
  assert_eq read_msg(" folded\nSubject: hi\nBad line\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("Custom/Header: v\r\nsubject: again\n\n"), "Custom/Header=[v];Subject=[again]\n"
  assert_eq read_msg("Custom/Header: v\r\n\n"), "Custom/Header=[v]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\n\tfolded2\nFrom x@y Mon Jun 19 00:00:00 2023\r\nsubject: again\r\n\n"), "From x@y Mon Jun 19 00=[00:00 2023 folded2|00:00 2023];Subject=[again]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023]\nbody line\r\nmore\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\n\n"), "From x@y Mon Jun 19 00=[00:00 2023]\n"
  assert_eq read_msg("To: <x@y>, z@w\nKey : spaced\nSubject: hi\r\n\r\nbody line\r\nmore\n"), "Key =[spaced];Subject=[hi];To=[<x@y>, z@w]\nbody line\r\nmore\n"
  assert_eq read_msg(" folded\n: nokey\nK:\nFrom: a@b\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("subject: again\n\tfolded2\r\n\r\nbody line\r\nmore\n"), "Subject=[again folded2]\nbody line\r\nmore\n"
  assert_eq read_msg("X-Y: v1\r\n\r\nbody line\r\nmore\n"), "X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("From: a@b\r\nFrom x@y Mon Jun 19 00:00:00 2023\r\nX-Y: v1\r\nX-Y: v1\n\n"), "From=[a@b];From x@y Mon Jun 19 00=[00:00 2023];X-Y=[v1|v1]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\n: nokey\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023]\nbody line\r\nmore\n"
  assert_eq read_msg(" folded\n folded\r\nKey : spaced\r\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("Subject: hi\nTo: <x@y>, z@w\n\n"), "Subject=[hi];To=[<x@y>, z@w]\n"
  assert_eq read_msg("Bad line\nX-Y: v1\r\nCustom/Header: v\n\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\n"), "From x@y Mon Jun 19 00=[00:00 2023]\n"
  assert_eq read_msg("Key : spaced\r\n\r\nbody line\r\nmore\n"), "Key =[spaced]\nbody line\r\nmore\n"
  assert_eq read_msg(" folded\r\n folded\n: nokey\r\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("Bad line\r\n folded\r\nFrom: a@b\nK:\r\n"), "ERR malformed header line: \"Bad line folded\""
  assert_eq read_msg("From: a@b\r\nFrom: a@b\r\n"), "From=[a@b|a@b]\n"
  assert_eq read_msg("Key : spaced\r\nX-Y: v1\r\n"), "Key =[spaced];X-Y=[v1]\n"
  assert_eq read_msg("From: a@b\r\n"), "From=[a@b]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\nFrom: a@b\n\tfolded2\n\r\nbody line\r\nmore\n"), "From=[a@b folded2];From x@y Mon Jun 19 00=[00:00 2023]\nbody line\r\nmore\n"
  assert_eq read_msg("subject: again\r\nFrom x@y Mon Jun 19 00:00:00 2023\nFrom: a@b\n"), "From=[a@b];From x@y Mon Jun 19 00=[00:00 2023];Subject=[again]\n"
  assert_eq read_msg("From: a@b\r\n folded\r\nX-Y: v1\r\n\n"), "From=[a@b folded];X-Y=[v1]\n"
  assert_eq read_msg("\tfolded2\n\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("To: <x@y>, z@w\r\n: nokey\n folded\n\n"), "To=[<x@y>, z@w]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nSubject: hi\nX-Y: v1\r\n"), "From x@y Mon Jun 19 00=[00:00 2023];Subject=[hi];X-Y=[v1]\n"
  assert_eq read_msg("K:\nTo: <x@y>, z@w\r\n folded\n"), "K=[];To=[<x@y>, z@w folded]\n"
  assert_eq read_msg(" folded\r\nBad line\r\nsubject: again\r\nsubject: again\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("Key : spaced\r\nCustom/Header: v\r\nFrom x@y Mon Jun 19 00:00:00 2023\r\n\tfolded2\r\n"), "Custom/Header=[v];From x@y Mon Jun 19 00=[00:00 2023 folded2];Key =[spaced]\n"
  assert_eq read_msg("Subject: hi\r\n\n"), "Subject=[hi]\n"
  assert_eq read_msg("Key : spaced\n"), "Key =[spaced]\n"
  assert_eq read_msg("X-Y: v1\n\r\nbody line\r\nmore\n"), "X-Y=[v1]\nbody line\r\nmore\n"
}

test "vectors: message 1" {
  assert_eq read_msg("Subject: hi\n: nokey\nX-Y: v1\r\nsubject: again\r\n\r\nbody line\r\nmore\n"), "Subject=[hi|again];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("subject: again\n\r\nbody line\r\nmore\n"), "Subject=[again]\nbody line\r\nmore\n"
  assert_eq read_msg("Custom/Header: v\n\r\nbody line\r\nmore\n"), "Custom/Header=[v]\nbody line\r\nmore\n"
  assert_eq read_msg("Subject: hi\nBad line\r\nCustom/Header: v\nK:\r\n\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("X-Y: v1\n: nokey\r\nSubject: hi\n"), "Subject=[hi];X-Y=[v1]\n"
  assert_eq read_msg("Subject: hi\r\nX-Y: v1\r\nsubject: again\n\n"), "Subject=[hi|again];X-Y=[v1]\n"
  assert_eq read_msg("K:\nFrom: a@b\n"), "From=[a@b];K=[]\n"
  assert_eq read_msg("Subject: hi\r\n folded\n\r\nbody line\r\nmore\n"), "Subject=[hi folded]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\r\n folded\nFrom x@y Mon Jun 19 00:00:00 2023\r\nFrom: a@b\r\n\r\nbody line\r\nmore\n"), "From=[a@b];From x@y Mon Jun 19 00=[00:00 2023];K=[folded]\nbody line\r\nmore\n"
  assert_eq read_msg(": nokey\n folded\nFrom: a@b\r\nTo: <x@y>, z@w\r\n\r\nbody line\r\nmore\n"), "From=[a@b];To=[<x@y>, z@w]\nbody line\r\nmore\n"
  assert_eq read_msg("Bad line\n: nokey\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("K:\nFrom: a@b\nCustom/Header: v\r\n folded\r\n"), "Custom/Header=[v folded];From=[a@b];K=[]\n"
  assert_eq read_msg("Key : spaced\r\n: nokey\n"), "Key =[spaced]\n"
  assert_eq read_msg("Subject: hi\r\n\r\nbody line\r\nmore\n"), "Subject=[hi]\nbody line\r\nmore\n"
  assert_eq read_msg(": nokey\r\n"), "ERR EOF"
  assert_eq read_msg("From: a@b\nX-Y: v1\r\n\n"), "From=[a@b];X-Y=[v1]\n"
  assert_eq read_msg("K:\r\nCustom/Header: v\nX-Y: v1\r\nFrom: a@b\r\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];From=[a@b];K=[];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("From: a@b\nSubject: hi\r\nKey : spaced\r\n\tfolded2\n\r\nbody line\r\nmore\n"), "From=[a@b];Key =[spaced folded2];Subject=[hi]\nbody line\r\nmore\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\nSubject: hi\n"), "From x@y Mon Jun 19 00=[00:00 2023];Subject=[hi]\n"
  assert_eq read_msg("Bad line\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("X-Y: v1\n folded\nSubject: hi\r\n\tfolded2\r\n"), "Subject=[hi folded2];X-Y=[v1 folded]\n"
  assert_eq read_msg(" folded\r\n: nokey\nSubject: hi\r\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("Subject: hi\nsubject: again\r\nX-Y: v1\nsubject: again\r\n\r\nbody line\r\nmore\n"), "Subject=[hi|again|again];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("X-Y: v1\nTo: <x@y>, z@w\r\nFrom x@y Mon Jun 19 00:00:00 2023\r\n: nokey\r\n\n"), "From x@y Mon Jun 19 00=[00:00 2023];To=[<x@y>, z@w];X-Y=[v1]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nK:\n"), "From x@y Mon Jun 19 00=[00:00 2023];K=[]\n"
  assert_eq read_msg("From: a@b\r\nKey : spaced\r\n\r\nbody line\r\nmore\n"), "From=[a@b];Key =[spaced]\nbody line\r\nmore\n"
  assert_eq read_msg("Subject: hi\n: nokey\nX-Y: v1\n\n"), "Subject=[hi];X-Y=[v1]\n"
  assert_eq read_msg(" folded\nX-Y: v1\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\nTo: <x@y>, z@w\nBad line\nK:\r\n\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("\tfolded2\nFrom: a@b\r\n\tfolded2\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("Key : spaced\r\n"), "Key =[spaced]\n"
  assert_eq read_msg(" folded\nBad line\r\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("\tfolded2\r\nBad line\r\nK:\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("Bad line\n\tfolded2\r\n: nokey\nsubject: again\r\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line folded2\""
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nFrom x@y Mon Jun 19 00:00:00 2023\r\nX-Y: v1\r\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023|00:00 2023];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\n folded\r\n\r\nbody line\r\nmore\n"), "K=[folded]\nbody line\r\nmore\n"
  assert_eq read_msg("From: a@b\nFrom x@y Mon Jun 19 00:00:00 2023\n\tfolded2\r\n\r\nbody line\r\nmore\n"), "From=[a@b];From x@y Mon Jun 19 00=[00:00 2023 folded2]\nbody line\r\nmore\n"
  assert_eq read_msg("Custom/Header: v\nCustom/Header: v\r\nK:\r\n\n"), "Custom/Header=[v|v];K=[]\n"
  assert_eq read_msg("X-Y: v1\nTo: <x@y>, z@w\nSubject: hi\r\n folded\n\n"), "Subject=[hi folded];To=[<x@y>, z@w];X-Y=[v1]\n"
  assert_eq read_msg("subject: again\r\nFrom: a@b\r\n"), "From=[a@b];Subject=[again]\n"
  assert_eq read_msg("X-Y: v1\nCustom/Header: v\nCustom/Header: v\r\nFrom: a@b\r\n\n"), "Custom/Header=[v|v];From=[a@b];X-Y=[v1]\n"
  assert_eq read_msg(" folded\nBad line\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg(" folded\n\tfolded2\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("Bad line\nFrom: a@b\r\nFrom: a@b\r\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Key : spaced\r\nCustom/Header: v\r\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];Key =[spaced]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\n\tfolded2\r\n folded\r\n\r\nbody line\r\nmore\n"), "K=[folded2 folded]\nbody line\r\nmore\n"
  assert_eq read_msg("Key : spaced\n: nokey\r\nCustom/Header: v\n"), "Custom/Header=[v];Key =[spaced]\n"
  assert_eq read_msg(" folded\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg(" folded\nFrom: a@b\r\nBad line\r\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("To: <x@y>, z@w\r\nBad line\r\n\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("\tfolded2\r\nBad line\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("Custom/Header: v\r\nX-Y: v1\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("X-Y: v1\r\nSubject: hi\r\nX-Y: v1\nFrom: a@b\n\n"), "From=[a@b];Subject=[hi];X-Y=[v1|v1]\n"
  assert_eq read_msg(" folded\nKey : spaced\r\nTo: <x@y>, z@w\r\n: nokey\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("Subject: hi\r\n folded\r\nX-Y: v1\r\n\n"), "Subject=[hi folded];X-Y=[v1]\n"
  assert_eq read_msg("To: <x@y>, z@w\nsubject: again\r\n\n"), "Subject=[again];To=[<x@y>, z@w]\n"
  assert_eq read_msg("Key : spaced\r\n: nokey\r\nCustom/Header: v\r\n"), "Custom/Header=[v];Key =[spaced]\n"
  assert_eq read_msg("X-Y: v1\r\nSubject: hi\nTo: <x@y>, z@w\nCustom/Header: v\r\n\n"), "Custom/Header=[v];Subject=[hi];To=[<x@y>, z@w];X-Y=[v1]\n"
  assert_eq read_msg("X-Y: v1\n\n"), "X-Y=[v1]\n"
  assert_eq read_msg("Subject: hi\nSubject: hi\r\nBad line\r\nK:\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Subject: hi\r\n\tfolded2\r\n: nokey\n"), "Subject=[hi folded2]\n"
  assert_eq read_msg("Custom/Header: v\nKey : spaced\n: nokey\nsubject: again\r\n\n"), "Custom/Header=[v];Key =[spaced];Subject=[again]\n"
  assert_eq read_msg(": nokey\r\nsubject: again\n\r\nbody line\r\nmore\n"), "Subject=[again]\nbody line\r\nmore\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\n\n"), "From x@y Mon Jun 19 00=[00:00 2023]\n"
  assert_eq read_msg("subject: again\r\n folded\nsubject: again\r\n\n"), "Subject=[again folded|again]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\n\tfolded2\r\n\n"), "From x@y Mon Jun 19 00=[00:00 2023 folded2]\n"
  assert_eq read_msg("From: a@b\r\nTo: <x@y>, z@w\n: nokey\r\n\r\nbody line\r\nmore\n"), "From=[a@b];To=[<x@y>, z@w]\nbody line\r\nmore\n"
  assert_eq read_msg("From: a@b\nKey : spaced\r\nFrom x@y Mon Jun 19 00:00:00 2023\r\n: nokey\r\n"), "From=[a@b];From x@y Mon Jun 19 00=[00:00 2023];Key =[spaced]\n"
  assert_eq read_msg("Key : spaced\r\nTo: <x@y>, z@w\r\nBad line\r\nK:\n\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Custom/Header: v\nKey : spaced\r\nBad line\r\n: nokey\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("\tfolded2\r\nCustom/Header: v\r\nK:\r\nTo: <x@y>, z@w\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg(" folded\nFrom x@y Mon Jun 19 00:00:00 2023\r\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg(": nokey\nCustom/Header: v\n: nokey\n"), "Custom/Header=[v]\n"
  assert_eq read_msg("From: a@b\nBad line\n\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Key : spaced\n folded\nX-Y: v1\r\nCustom/Header: v\r\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];Key =[spaced folded];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\r\nBad line\nFrom x@y Mon Jun 19 00:00:00 2023\r\nFrom: a@b\n\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Subject: hi\n"), "Subject=[hi]\n"
  assert_eq read_msg(" folded\nsubject: again\r\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("Key : spaced\r\nFrom x@y Mon Jun 19 00:00:00 2023\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023];Key =[spaced]\nbody line\r\nmore\n"
  assert_eq read_msg("From: a@b\nK:\n\r\nbody line\r\nmore\n"), "From=[a@b];K=[]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\r\n"), "K=[]\n"
  assert_eq read_msg(": nokey\r\nCustom/Header: v\r\nSubject: hi\nFrom x@y Mon Jun 19 00:00:00 2023\r\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];From x@y Mon Jun 19 00=[00:00 2023];Subject=[hi]\nbody line\r\nmore\n"
  assert_eq read_msg("Key : spaced\nK:\r\n\r\nbody line\r\nmore\n"), "K=[];Key =[spaced]\nbody line\r\nmore\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\n: nokey\nCustom/Header: v\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];From x@y Mon Jun 19 00=[00:00 2023]\nbody line\r\nmore\n"
  assert_eq read_msg("Bad line\r\n: nokey\r\nSubject: hi\r\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("subject: again\nK:\nKey : spaced\r\n\n"), "K=[];Key =[spaced];Subject=[again]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\nBad line\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Bad line\nsubject: again\r\nSubject: hi\r\nX-Y: v1\n\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Subject: hi\nK:\r\n\r\nbody line\r\nmore\n"), "K=[];Subject=[hi]\nbody line\r\nmore\n"
  assert_eq read_msg("Subject: hi\r\nSubject: hi\nFrom: a@b\r\n: nokey\n\n"), "From=[a@b];Subject=[hi|hi]\n"
  assert_eq read_msg("Custom/Header: v\r\nBad line\nFrom x@y Mon Jun 19 00:00:00 2023\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Subject: hi\nX-Y: v1\nTo: <x@y>, z@w\r\nBad line\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("\tfolded2\nFrom: a@b\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("Subject: hi\r\n\tfolded2\n\n"), "Subject=[hi folded2]\n"
  assert_eq read_msg("\tfolded2\r\nsubject: again\r\n: nokey\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("subject: again\r\nK:\nCustom/Header: v\n\tfolded2\n"), "Custom/Header=[v folded2];K=[];Subject=[again]\n"
  assert_eq read_msg("subject: again\r\n\tfolded2\n\r\nbody line\r\nmore\n"), "Subject=[again folded2]\nbody line\r\nmore\n"
  assert_eq read_msg("Key : spaced\nKey : spaced\nFrom: a@b\r\n\r\nbody line\r\nmore\n"), "From=[a@b];Key =[spaced|spaced]\nbody line\r\nmore\n"
  assert_eq read_msg("Subject: hi\n\n"), "Subject=[hi]\n"
}

test "vectors: message 2" {
  assert_eq read_msg("subject: again\nX-Y: v1\nX-Y: v1\r\n\r\nbody line\r\nmore\n"), "Subject=[again];X-Y=[v1|v1]\nbody line\r\nmore\n"
  assert_eq read_msg("subject: again\nFrom: a@b\r\n"), "From=[a@b];Subject=[again]\n"
  assert_eq read_msg("\tfolded2\r\n\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("\tfolded2\nX-Y: v1\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("Subject: hi\r\nX-Y: v1\nSubject: hi\n: nokey\r\n\n"), "Subject=[hi|hi];X-Y=[v1]\n"
  assert_eq read_msg("Custom/Header: v\nFrom x@y Mon Jun 19 00:00:00 2023\r\nX-Y: v1\r\nFrom: a@b\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];From=[a@b];From x@y Mon Jun 19 00=[00:00 2023];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\nK:\r\n\r\nbody line\r\nmore\n"), "K=[|]\nbody line\r\nmore\n"
  assert_eq read_msg("To: <x@y>, z@w\nTo: <x@y>, z@w\r\n\n"), "To=[<x@y>, z@w|<x@y>, z@w]\n"
  assert_eq read_msg("X-Y: v1\n: nokey\n: nokey\r\nTo: <x@y>, z@w\r\n\r\nbody line\r\nmore\n"), "To=[<x@y>, z@w];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\r\nKey : spaced\r\n"), "K=[];Key =[spaced]\n"
  assert_eq read_msg("From: a@b\nTo: <x@y>, z@w\n\r\nbody line\r\nmore\n"), "From=[a@b];To=[<x@y>, z@w]\nbody line\r\nmore\n"
  assert_eq read_msg(" folded\r\nsubject: again\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg(": nokey\r\n\n"), "\n"
  assert_eq read_msg("Subject: hi\r\n"), "Subject=[hi]\n"
  assert_eq read_msg("From: a@b\r\nFrom x@y Mon Jun 19 00:00:00 2023\n\n"), "From=[a@b];From x@y Mon Jun 19 00=[00:00 2023]\n"
  assert_eq read_msg("Key : spaced\r\n\tfolded2\n\r\nbody line\r\nmore\n"), "Key =[spaced folded2]\nbody line\r\nmore\n"
  assert_eq read_msg("Key : spaced\nCustom/Header: v\r\n: nokey\n: nokey\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];Key =[spaced]\nbody line\r\nmore\n"
  assert_eq read_msg("From: a@b\r\nBad line\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("\tfolded2\r\n: nokey\nCustom/Header: v\r\nSubject: hi\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg(" folded\r\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("Bad line\n\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("subject: again\r\nTo: <x@y>, z@w\n\n"), "Subject=[again];To=[<x@y>, z@w]\n"
  assert_eq read_msg("K:\nCustom/Header: v\r\n"), "Custom/Header=[v];K=[]\n"
  assert_eq read_msg(" folded\nFrom: a@b\r\nSubject: hi\r\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nTo: <x@y>, z@w\r\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023];To=[<x@y>, z@w]\nbody line\r\nmore\n"
  assert_eq read_msg("subject: again\r\n"), "Subject=[again]\n"
  assert_eq read_msg("Custom/Header: v\r\n\r\nbody line\r\nmore\n"), "Custom/Header=[v]\nbody line\r\nmore\n"
  assert_eq read_msg("\tfolded2\nTo: <x@y>, z@w\nSubject: hi\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("K:\r\nFrom x@y Mon Jun 19 00:00:00 2023\nK:\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023];K=[|]\nbody line\r\nmore\n"
  assert_eq read_msg("Bad line\nSubject: hi\n folded\nsubject: again\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Key : spaced\r\nTo: <x@y>, z@w\n folded\r\n\r\nbody line\r\nmore\n"), "Key =[spaced];To=[<x@y>, z@w folded]\nbody line\r\nmore\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nFrom: a@b\n\r\nbody line\r\nmore\n"), "From=[a@b];From x@y Mon Jun 19 00=[00:00 2023]\nbody line\r\nmore\n"
  assert_eq read_msg("X-Y: v1\nKey : spaced\nBad line\n folded\r\n"), "ERR malformed header line: \"Bad line folded\""
  assert_eq read_msg("X-Y: v1\r\n"), "X-Y=[v1]\n"
  assert_eq read_msg("X-Y: v1\n: nokey\r\nTo: <x@y>, z@w\n\r\nbody line\r\nmore\n"), "To=[<x@y>, z@w];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg(": nokey\r\nBad line\nFrom x@y Mon Jun 19 00:00:00 2023\r\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg(": nokey\r\nTo: <x@y>, z@w\r\nTo: <x@y>, z@w\nBad line\n\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("subject: again\nK:\n\r\nbody line\r\nmore\n"), "K=[];Subject=[again]\nbody line\r\nmore\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nKey : spaced\n folded\r\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023];Key =[spaced folded]\nbody line\r\nmore\n"
  assert_eq read_msg("subject: again\r\n folded\r\n"), "Subject=[again folded]\n"
  assert_eq read_msg("Custom/Header: v\nsubject: again\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];Subject=[again]\nbody line\r\nmore\n"
  assert_eq read_msg("Key : spaced\nsubject: again\r\nKey : spaced\r\nFrom x@y Mon Jun 19 00:00:00 2023\r\n\n"), "From x@y Mon Jun 19 00=[00:00 2023];Key =[spaced|spaced];Subject=[again]\n"
  assert_eq read_msg("Bad line\nFrom: a@b\r\nCustom/Header: v\r\nFrom x@y Mon Jun 19 00:00:00 2023\r\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("Subject: hi\r\nKey : spaced\n: nokey\r\n\r\nbody line\r\nmore\n"), "Key =[spaced];Subject=[hi]\nbody line\r\nmore\n"
  assert_eq read_msg("X-Y: v1\nsubject: again\nTo: <x@y>, z@w\n: nokey\n\r\nbody line\r\nmore\n"), "Subject=[again];To=[<x@y>, z@w];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\n folded\r\n\tfolded2\nFrom x@y Mon Jun 19 00:00:00 2023\r\n"), "From x@y Mon Jun 19 00=[00:00 2023];K=[folded folded2]\n"
  assert_eq read_msg("Key : spaced\n: nokey\r\n\tfolded2\n\n"), "Key =[spaced]\n"
  assert_eq read_msg("subject: again\r\nTo: <x@y>, z@w\nFrom: a@b\r\nKey : spaced\r\n\r\nbody line\r\nmore\n"), "From=[a@b];Key =[spaced];Subject=[again];To=[<x@y>, z@w]\nbody line\r\nmore\n"
  assert_eq read_msg("Bad line\nFrom x@y Mon Jun 19 00:00:00 2023\r\nFrom: a@b\nFrom x@y Mon Jun 19 00:00:00 2023\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("From: a@b\r\nsubject: again\nsubject: again\nKey : spaced\n\r\nbody line\r\nmore\n"), "From=[a@b];Key =[spaced];Subject=[again|again]\nbody line\r\nmore\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\nX-Y: v1\nTo: <x@y>, z@w\nsubject: again\n\n"), "From x@y Mon Jun 19 00=[00:00 2023];Subject=[again];To=[<x@y>, z@w];X-Y=[v1]\n"
  assert_eq read_msg("Subject: hi\n: nokey\r\n folded\n\r\nbody line\r\nmore\n"), "Subject=[hi]\nbody line\r\nmore\n"
  assert_eq read_msg("Custom/Header: v\r\nKey : spaced\r\nFrom: a@b\r\nX-Y: v1\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];From=[a@b];Key =[spaced];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg(" folded\r\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("From: a@b\r\nX-Y: v1\r\nSubject: hi\r\nX-Y: v1\n"), "From=[a@b];Subject=[hi];X-Y=[v1|v1]\n"
  assert_eq read_msg("\tfolded2\n: nokey\r\nSubject: hi\r\n"), "ERR malformed initial line: \"\\tfolded2\""
  assert_eq read_msg("K:\nCustom/Header: v\r\n folded\r\n"), "Custom/Header=[v folded];K=[]\n"
  assert_eq read_msg(" folded\nSubject: hi\nK:\n\r\nbody line\r\nmore\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\nsubject: again\n folded\r\n\n"), "From x@y Mon Jun 19 00=[00:00 2023];Subject=[again folded]\n"
  assert_eq read_msg("subject: again\nCustom/Header: v\r\nFrom x@y Mon Jun 19 00:00:00 2023\r\n"), "Custom/Header=[v];From x@y Mon Jun 19 00=[00:00 2023];Subject=[again]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nK:\n folded\nKey : spaced\r\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023];K=[folded];Key =[spaced]\nbody line\r\nmore\n"
  assert_eq read_msg("To: <x@y>, z@w\r\nKey : spaced\nFrom x@y Mon Jun 19 00:00:00 2023\nK:\r\n\n"), "From x@y Mon Jun 19 00=[00:00 2023];K=[];Key =[spaced];To=[<x@y>, z@w]\n"
  assert_eq read_msg("Key : spaced\r\nX-Y: v1\r\nX-Y: v1\nKey : spaced\n\n"), "Key =[spaced|spaced];X-Y=[v1|v1]\n"
  assert_eq read_msg("X-Y: v1\n folded\r\nBad line\r\n: nokey\n\r\nbody line\r\nmore\n"), "ERR malformed header line: \"Bad line\""
  assert_eq read_msg("To: <x@y>, z@w\r\nTo: <x@y>, z@w\r\n\tfolded2\nTo: <x@y>, z@w\r\n"), "To=[<x@y>, z@w|<x@y>, z@w folded2|<x@y>, z@w]\n"
  assert_eq read_msg(": nokey\nCustom/Header: v\nTo: <x@y>, z@w\r\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];To=[<x@y>, z@w]\nbody line\r\nmore\n"
  assert_eq read_msg("K:\r\nCustom/Header: v\nsubject: again\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];K=[];Subject=[again]\nbody line\r\nmore\n"
  assert_eq read_msg("Bad line\n\tfolded2\n"), "ERR malformed header line: \"Bad line folded2\""
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\nCustom/Header: v\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];From x@y Mon Jun 19 00=[00:00 2023]\nbody line\r\nmore\n"
  assert_eq read_msg("subject: again\r\nKey : spaced\nX-Y: v1\r\nFrom x@y Mon Jun 19 00:00:00 2023\r\n"), "From x@y Mon Jun 19 00=[00:00 2023];Key =[spaced];Subject=[again];X-Y=[v1]\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\nFrom: a@b\n\n"), "From=[a@b];From x@y Mon Jun 19 00=[00:00 2023]\n"
  assert_eq read_msg(" folded\nX-Y: v1\r\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("X-Y: v1\nKey : spaced\r\n\r\nbody line\r\nmore\n"), "Key =[spaced];X-Y=[v1]\nbody line\r\nmore\n"
  assert_eq read_msg(" folded\nFrom x@y Mon Jun 19 00:00:00 2023\nFrom: a@b\r\nCustom/Header: v\n\n"), "ERR malformed initial line: \" folded\""
  assert_eq read_msg("To: <x@y>, z@w\nK:\n: nokey\n\r\nbody line\r\nmore\n"), "K=[];To=[<x@y>, z@w]\nbody line\r\nmore\n"
  assert_eq read_msg("subject: again\nsubject: again\nFrom x@y Mon Jun 19 00:00:00 2023\r\nX-Y: v1\r\n"), "From x@y Mon Jun 19 00=[00:00 2023];Subject=[again|again];X-Y=[v1]\n"
  assert_eq read_msg("Custom/Header: v\r\nFrom: a@b\r\nKey : spaced\r\n\r\nbody line\r\nmore\n"), "Custom/Header=[v];From=[a@b];Key =[spaced]\nbody line\r\nmore\n"
  assert_eq read_msg("Custom/Header: v\n\tfolded2\n\r\nbody line\r\nmore\n"), "Custom/Header=[v folded2]\nbody line\r\nmore\n"
  assert_eq read_msg("From x@y Mon Jun 19 00:00:00 2023\r\nK:\n\r\nbody line\r\nmore\n"), "From x@y Mon Jun 19 00=[00:00 2023];K=[]\nbody line\r\nmore\n"
  assert_eq read_msg("Key : spaced\n\n"), "Key =[spaced]\n"
  assert_eq read_msg(" folded\r\n"), "ERR malformed initial line: \" folded\""
}
