  assert_eq pa("<\"\\\\\"@ex-ample.org>,"), "ERR mail: expected single address, got \",\""
  assert_eq pa("<a..b@[a]> (comment)"), "ERR mail: double dot in atom"
  assert_eq pa("John Doe a..b@x"), "ERR mail: no angle-addr"
