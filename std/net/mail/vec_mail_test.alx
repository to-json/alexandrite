  assert_eq pa("\"a b\"@[IPv6:1.2.3.4]  (x(y)z)"), "x(y)z|a b@[IPv6:1.2.3.4]"
  assert_eq pa("<.x@[a]>,"), "ERR mail: leading dot in atom"
