  assert_eq fmt_round("=", "a b@c"), "\"=\" <\"a b\"@c> => =|a b@c"
  assert_eq fmt_round("\t", "a.b@x"), "\"\t\" <a.b@x> => \t|a.b@x"
  assert_eq fmt_round("@=\x01. ", "@"), "=?utf-8?b?QD0BLiA=?= <@> => ERR mail: invalid string"
  assert_eq fmt_round(")a日", "a..b@x"), "=?utf-8?b?KWHml6U=?= <\"a..b\"@x> => )a日|a..b@x"
  assert_eq fmt_round("=\\\x01", "my@idiot@address@example.com"), "=?utf-8?q?=3D\\=01?= <\"my@idiot@address\"@example.com> => ERR mail: missing '@' or angle-addr"
  assert_eq fmt_round("a@日?=", "@"), "=?utf-8?b?YUDml6U/PQ==?= <@> => ERR mail: invalid string"
  assert_eq fmt_round("@\t'a\t,", "a..b@x"), "\"@\t'a\t,\" <\"a..b\"@x> => @\t'a\t,|a..b@x"
  assert_eq fmt_round("B(ö_@)", "a.b@x"), "=?utf-8?b?QijDtl9AKQ==?= <a.b@x> => B(ö_@)|a.b@x"
  assert_eq fmt_round("?.\"\t'.<", "x.@y"), "\"?.\\\"\t'.<\" <\"x.\"@y> => ?.\"\t'.<|x.@y"
  assert_eq fmt_round("", ".a@x"), "<\".a\"@x> => |.a@x"
  assert_eq fmt_round("", "a b@c"), "<\"a b\"@c> => |a b@c"
