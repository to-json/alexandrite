  assert_eq fmt_round("'aa", ".a@x"), "\"'aa\" <\".a\"@x> => 'aa|.a@x"
  assert_eq fmt_round(" ö 日~\t_", "a b@c"), "=?utf-8?b?IMO2IOaXpX4JXw==?= <\"a b\"@c> =>  ö 日~\t_|a b@c"
  assert_eq fmt_round(",", "my@idiot@address@example.com"), "\",\" <\"my@idiot@address\"@example.com> => ,|my@idiot@address@example.com"
  assert_eq fmt_round("日#=_~a", "a..b@x"), "=?utf-8?b?5pelIz1ffmE=?= <\"a..b\"@x> => 日#=_~a|a..b@x"
  assert_eq fmt_round("a)ö((<", "a b@c"), "=?utf-8?b?YSnDtigoPA==?= <\"a b\"@c> => a)ö((<|a b@c"
  assert_eq fmt_round(",#.)\t=_", "\"q\"@z"), "\",#.)\t=_\" <\"\\\"q\\\"\"@z> => ,#.)\t=_|\"q\"@z"
  assert_eq fmt_round(" @\t.<", "@"), "\" @\t.<\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("\x01'\"", " @x"), "=?utf-8?b?ASci?= <\" \"@x> => \x01'\"| @x"
  assert_eq fmt_round(")~'?(\\", "a b@c"), "\")~'?(\\\\\" <\"a b\"@c> => )~'?(\\|a b@c"
  assert_eq fmt_round("?~)", ""), "\"?~)\" <@> => ERR mail: invalid string"
  assert_eq fmt_round("\\\x01#@B", "\"q\"@z"), "=?utf-8?b?XAEjQEI=?= <\"\\\"q\\\"\"@z> => \\\x01#@B|\"q\"@z"
  assert_eq fmt_round(")_\x01", "plain"), "=?utf-8?b?KV8B?= <plain@> => ERR mail: invalid string"
