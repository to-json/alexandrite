import "io"
import "os"
import "time"

def b(s: Str) -> [Byte] { s.bytes.to_a }

# Echoes everything it reads back until end of stream.
def echo(c: Conn) -> Int {
  buf: [Byte] = [0; 256]
  total = 0
  loop {
    n = c.read!(buf).unwrap
    break if n == 0
    c.write!(buf[0...n]).unwrap
    total += n
  }
  c.close!.unwrap
  total
}

test "split and join host port" {
  h, p = split_host_port("example.com:80").unwrap
  assert_eq h, "example.com"
  assert_eq p, "80"
  h, p = split_host_port(":8080").unwrap
  assert_eq h, ""
  assert_eq p, "8080"
  h, p = split_host_port("[::1]:443").unwrap
  assert_eq h, "::1"
  assert_eq p, "443"
  assert_eq split_host_port("nohost").err.unwrap.message, "address nohost: missing port in address"
  assert_eq split_host_port("a:b:c").err.unwrap.message, "address a:b:c: too many colons in address"
  assert_eq join_host_port("::1", "80"), "[::1]:80"
  assert_eq join_host_port("h", "80"), "h:80"
  assert_eq join_host_port("", "80"), ":80"
}

test "listen picks a port" {
  l = listen("tcp", "127.0.0.1:0").unwrap
  h, p = split_host_port(l.addr).unwrap
  assert_eq h, "127.0.0.1"
  assert p != "0"
  l.close!.unwrap
  assert l.close!.err?, "second close fails"
}

test "echo server and client in one process" {
  l = listen("tcp", "127.0.0.1:0").unwrap
  addr = "127.0.0.1:#{l.port}"
  srv = spawn {
    sc = l.~accept
    echo(sc)
  }
  c = dial("tcp", addr).unwrap
  assert_eq c.remote_addr, addr
  assert c.local_addr.size > 0
  assert_eq c.write_string!("hello, net").unwrap, 10
  buf: [Byte] = [0; 64]
  got = 0
  while got < 10 {
    got += c.read!(buf[got...64]).unwrap
  }
  assert_eq Str.from_bytes(buf[0...10]), "hello, net"
  c.close_write!.unwrap
  assert_eq c.read!(buf).unwrap, 0
  assert_eq srv.wait.unwrap, 10
  c.close!.unwrap
}

test "many concurrent clients" {
  l = listen("tcp", "127.0.0.1:0").unwrap
  addr = "127.0.0.1:#{l.port}"
  n = 200
  spawn {
    handlers = (1..n).map { |_|
      c = l.~accept
      spawn { echo(c) }
    }.to_a
    handlers.sum { it.wait.unwrap }
  }
  clients = (1..n).map { |i|
    spawn {
      c = ~dial("tcp", addr)
      msg = "client #{i}"
      c.~write!(b(msg))
      c.~close_write!
      got = ~io.read_all(c)
      c.~close!
      Str.from_bytes(got) == msg ? i : 0
    }
  }.to_a
  total = clients.sum { it.wait.unwrap }
  assert_eq total, n * (n + 1) / 2
}

test "connection refused" {
  # Port 1 on loopback: nothing listens there.
  e = dial("tcp", "127.0.0.1:1").err.unwrap
  assert_eq e.message, "dial tcp 127.0.0.1:1: connect: connection refused"
  assert is_conn_refused(e)
  case e {
    ConnRefused => assert true
    _ => assert false, "expected ConnRefused"
  }
}

test "address in use" {
  l = listen("tcp", "127.0.0.1:0").unwrap
  e = listen("tcp", l.addr).err.unwrap
  case e {
    AddrInUse => assert true
    _ => assert false, "expected AddrInUse: #{e.message}"
  }
  l.close!.unwrap
}

test "read EOF after the peer closes" {
  l = listen("tcp", "127.0.0.1:0").unwrap
  addr = "127.0.0.1:#{l.port}"
  spawn {
    c = l.~accept
    c.~write_string!("bye")
    c.~close!
  }
  c = dial("tcp", addr).unwrap
  all = io.read_all(c).unwrap
  assert_eq Str.from_bytes(all), "bye"
  buf: [Byte] = [0; 8]
  assert_eq c.read!(buf).unwrap, 0
  c.close!.unwrap
}

test "closing a listener wakes accept" {
  l = listen("tcp", "127.0.0.1:0").unwrap
  t = spawn {
    r = l.accept
    r.err?
  }
  alx_sleep_ns(30_000_000)
  l.close!.unwrap
  assert t.wait.unwrap
}

test "use after close" {
  l = listen("tcp", "127.0.0.1:0").unwrap
  addr = "127.0.0.1:#{l.port}"
  spawn {
    sc = l.~accept
    echo(sc)
  }
  c = dial("tcp", addr).unwrap
  c.close!.unwrap
  e = c.write_string!("x").err.unwrap
  assert is_closed(e)
  assert_eq e.message, "write tcp #{c.local_addr}->#{addr}: use of closed network connection"
}

test "dial timeout succeeds when the peer answers" {
  l = listen("tcp", "127.0.0.1:0").unwrap
  c = dial_timeout("tcp", l.addr, time.second * 2).unwrap
  c.close!.unwrap
  l.close!.unwrap
}

test "bad network and bad address" {
  assert_eq dial("sctp", "127.0.0.1:1").err.unwrap.message, "dial sctp: unknown network sctp"
  assert dial("tcp", "nope").err?
}

test "lookup_host" {
  addrs = lookup_host("127.0.0.1").unwrap
  assert_eq addrs[0], "127.0.0.1"
}

# A short socket path in a fresh temp directory (sun_path holds ~104 bytes).
def sock_path -> Str {
  os.mkdir_temp("", "").unwrap + "/sock"
}

test "udp: dial sends datagrams to listen_packet" {
  pc = listen_packet("udp", "127.0.0.1:0").unwrap
  assert pc.local_addr.start_with?("127.0.0.1:"), pc.local_addr
  c = dial("udp", pc.local_addr).unwrap
  c.write!(b("one")).unwrap
  c.write!(b("two!")).unwrap
  buf: [Byte] = [0; 64]
  n, from = pc.read_from!(buf).unwrap
  assert_eq Str.from_bytes(buf[0...n]), "one"
  assert_eq from.unwrap.to_s, c.local_addr
  n2, _ = pc.read_from!(buf).unwrap
  assert_eq Str.from_bytes(buf[0...n2]), "two!"
  c.close!.unwrap
  pc.close!.unwrap
}

test "unixgram: dial sends datagrams to listen_packet" {
  path = sock_path
  pc = listen_packet("unixgram", path).unwrap
  assert_eq pc.local_addr, path
  c = dial("unixgram", path).unwrap
  c.write!(b("hello")).unwrap
  buf: [Byte] = [0; 64]
  n, from = pc.read_from!(buf).unwrap
  assert_eq Str.from_bytes(buf[0...n]), "hello"
  assert !from.present?
  c.close!.unwrap
  pc.close!.unwrap
  os.remove(path).unwrap
}

test "closing a packet conn wakes read_from" {
  pc = listen_packet("udp", "127.0.0.1:0").unwrap
  t = spawn {
    buf: [Byte] = [0; 8]
    pc.read_from!(buf).err?
  }
  os_sleep(20000000)
  pc.close!.unwrap
  assert t.wait.unwrap, "read_from didn't fail after close"
}

def os_sleep(ns: Int) { alx_sleep_ns(ns) }

test "unix: stream echo, and close removes the socket file" {
  path = sock_path
  l = listen("unix", path).unwrap
  t = spawn {
    c = l.accept.unwrap
    echo(c)
  }
  c = dial("unix", path).unwrap
  c.write!(b("ping")).unwrap
  c.close_write!.unwrap
  got = io.read_all(c).unwrap
  assert_eq Str.from_bytes(got), "ping"
  assert_eq t.wait.unwrap, 4
  c.close!.unwrap
  assert os.stat(path).ok?, "socket file missing while listening"
  l.close!.unwrap
  assert !os.stat(path).ok?, "close didn't remove the socket file"
}

test "unix and unixgram errors" {
  path = sock_path
  e = dial("unix", path).err.unwrap
  assert e.message.start_with?("dial unix #{path}: connect: "), e.message
  e2 = dial("unixgram", path).err.unwrap
  assert e2.message.start_with?("dial unixgram #{path}: connect: "), e2.message
  e3 = listen_packet("tcp", "127.0.0.1:0").err.unwrap
  assert_eq e3.message, "listen tcp 127.0.0.1:0: address 127.0.0.1:0: unexpected address type"
}
