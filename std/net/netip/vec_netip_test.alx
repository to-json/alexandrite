test "vectors: prefix contains overlaps 15" {
  assert_eq must_parse_prefix("165.169.74.73/26").compare(must_parse_prefix("0::0:92f1:0/122")), -1
  assert_eq must_parse_prefix("::442c:0:6be7:5c62:1389/44").overlaps?(must_parse_prefix("255.113.66.215/12")), false
  assert_eq must_parse_prefix("::442c:0:6be7:5c62:1389/44").compare(must_parse_prefix("255.113.66.215/12")), 1
  assert_eq must_parse_prefix("::ffff:153.255.48.255/80").contains?(must_parse_addr("::ffff:80.255.234.24")), true
}

