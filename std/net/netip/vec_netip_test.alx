  assert_eq psum_ab("f4a3:0:0:ff02:1:ff02:f18c:0", 77), "f4a3:0:0:ff02::/77|77|f4a3:0:0:ff02::|f4a3:0:0:ff02::/77|0|f4a300000000ff0200000000000000004d"
  assert_eq psum_ab("::ffff:93.61.39.254", 78), "::/78|78|::|::/78|0|000000000000000000000000000000004e"
