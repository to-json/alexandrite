test "vectors: parse prefix 7" {
  assert_eq psum_p("5120:4582:ff0e:0:1:cfb8:0:0/94"), "5120:4582:ff0e:0:1:cfb8::/94|94|5120:4582:ff0e:0:1:cfb8::|5120:4582:ff0e:0:1:cfb8::/94|0|51204582ff0e00000001cfb8000000005e"
