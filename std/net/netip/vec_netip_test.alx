  assert_eq psum_p("100.77.45.66/11"), "100.77.45.66/11|11|100.77.45.66|100.64.0.0/11|0|644d2d420b"
  assert_eq psum_p("::fff:f:197.13.0.168/44"), "::fff:f:c50d:a8/44|44|::fff:f:c50d:a8|::/44|0|00000000000000000fff000fc50d00a82c"
  assert_eq psum_p("12.103.172.64/118"), "ERR netip.ParsePrefix(\"12.103.172.64/118\"): prefix length out of range"
  assert_eq psum_p("255.255.102.197/134"), "ERR netip.ParsePrefix(\"255.255.102.197/134\"): prefix length out of range"
  assert_eq psum_p("::ffff:0.255.104.241/104"), "::ffff:0.255.104.241/104|104|::ffff:0.255.104.241|::ffff:0.0.0.0/104|0|00000000000000000000ffff00ff68f168"
  assert_eq psum_p("e521:0:b5a1:2bb6:8a7e:0:6190:0%en0/08"), "ERR netip.ParsePrefix(\"e521:0:b5a1:2bb6:8a7e:0:6190:0%en0/08\"): IPv6 zones cannot be present in a prefix"
  assert_eq psum_p("e521:0:b5a1:2bb6:8a7e:0:6190:0%en0/-1"), "ERR netip.ParsePrefix(\"e521:0:b5a1:2bb6:8a7e:0:6190:0%en0/-1\"): IPv6 zones cannot be present in a prefix"
  assert_eq psum_p("0:b651:4133:2001:0:0:0:3fbf/73"), "0:b651:4133:2001::3fbf/73|73|0:b651:4133:2001::3fbf|0:b651:4133:2001::/73|0|0000b651413320010000000000003fbf49"
  assert_eq psum_p("0.97.128.25/26"), "0.97.128.25/26|26|0.97.128.25|0.97.128.0/26|0|006180191a"
  assert_eq psum_p("ff0e:6767:0:232d:2001:b027:0:b3b6/106"), "ff0e:6767:0:232d:2001:b027:0:b3b6/106|106|ff0e:6767:0:232d:2001:b027:0:b3b6|ff0e:6767:0:232d:2001:b027::/106|0|ff0e67670000232d2001b0270000b3b66a"
  assert_eq psum_p("0:7405:0:ff01:0::7087/78"), "0:7405:0:ff01::7087/78|78|0:7405:0:ff01::7087|0:7405:0:ff01::/78|0|000074050000ff0100000000000070874e"
  assert_eq psum_p("168.169.95.255/62"), "ERR netip.ParsePrefix(\"168.169.95.255/62\"): prefix length out of range"
  assert_eq psum_p("::FFFF:32.92.93.76%ETH0/118"), "ERR netip.ParsePrefix(\"::FFFF:32.92.93.76%ETH0/118\"): IPv6 zones cannot be present in a prefix"
  assert_eq psum_p("f838:0:0:0::3567:ABCD/33"), "f838::3567:abcd/33|33|f838::3567:abcd|f838::/33|0|f838000000000000000000003567abcd21"
  assert_eq psum_p("255.3.172.172/22"), "255.3.172.172/22|22|255.3.172.172|255.3.172.0/22|0|ff03acac16"
  assert_eq psum_p("dbg8:0::/114"), "ERR netip.ParsePrefix(\"dbg8:0::/114\"): ParseAddr(\"dbg8:0::\"): unexpected character, want colon (at \"g8:0::\")"
  assert_eq psum_p("76.101.55.105/72"), "ERR netip.ParsePrefix(\"76.101.55.105/72\"): prefix length out of range"
  assert_eq psum_p("157.255.0.255/59"), "ERR netip.ParsePrefix(\"157.255.0.255/59\"): prefix length out of range"
  assert_eq psum_p("ABCD:eaf1:70be:bbcf:ff02:ABCD:6f05:fd00/15"), "abcd:eaf1:70be:bbcf:ff02:abcd:6f05:fd00/15|15|abcd:eaf1:70be:bbcf:ff02:abcd:6f05:fd00|abcc::/15|0|abcdeaf170bebbcfff02abcd6f05fd000f"
  assert_eq psum_p("110.131.169.198/123"), "ERR netip.ParsePrefix(\"110.131.169.198/123\"): prefix length out of range"
}

