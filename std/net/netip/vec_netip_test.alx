test "vectors: parse prefix" {
  assert_eq psum_p("255.0.140.255/102"), "ERR netip.ParsePrefix(\"255.0.140.255/102\"): prefix length out of range"
  assert_eq psum_p("0.254.255.14/23"), "0.254.255.14/23|23|0.254.255.14|0.254.254.0/23|0|00feff0e17"
  assert_eq psum_p("0.24.38.254/12"), "0.24.38.254/12|12|0.24.38.254|0.16.0.0/12|0|001826fe0c"
  assert_eq psum_p("::ffff:255.169.192.83%1/1"), "ERR netip.ParsePrefix(\"::ffff:255.169.192.83%1/1\"): IPv6 zones cannot be present in a prefix"
  assert_eq psum_p("325B:0:FD00:0:8842:0:FC00:6C53/108"), "325b:0:fd00:0:8842:0:fc00:6c53/108|108|325b:0:fd00:0:8842:0:fc00:6c53|325b:0:fd00:0:8842:0:fc00:0/108|0|325b0000fd00000088420000fc006c536c"
  assert_eq psum_p("0:fd00:2a57::/65"), "0:fd00:2a57::/65|65|0:fd00:2a57::|0:fd00:2a57::/65|0|0000fd002a570000000000000000000041"
  assert_eq psum_p("fb84:b9d5:0:573f:0:2da8:0:0%1g/126"), "ERR netip.ParsePrefix(\"fb84:b9d5:0:573f:0:2da8:0:0%1g/126\"): IPv6 zones cannot be present in a prefix"
  assert_eq psum_p("154.16.247.10/76"), "ERR netip.ParsePrefix(\"154.16.247.10/76\"): prefix length out of range"
  assert_eq psum_p("0:0:0:a06:ABCD:c2:cb1d:8f2a/1"), "::a06:abcd:c2:cb1d:8f2a/1|1|::a06:abcd:c2:cb1d:8f2a|::/1|0|0000000000000a06abcd00c2cb1d8f2a01"
