test "vectors: addr prefix" {
  assert_eq psum_ab("ea7e:4abd:c791:0:2001:0:0:9f57", 41), "ea7e:4abd:c780::/41|41|ea7e:4abd:c780::|ea7e:4abd:c780::/41|0|ea7e4abdc7800000000000000000000029"
  assert_eq psum_ab("ABCD:eaf1:70be:bbcf:ff02:ABCD:6f05:fd00", 64), "abcd:eaf1:70be:bbcf::/64|64|abcd:eaf1:70be:bbcf::|abcd:eaf1:70be:bbcf::/64|0|abcdeaf170bebbcf000000000000000040"
  assert_eq psum_ab("49.0.20.169", 117), "ERR prefix length 117 too large for IPv4"
  assert_eq psum_ab("0:0:0:61ff:5541:ff02:7f5c:a246", 24), "::/24|24|::|::/24|0|0000000000000000000000000000000018"
  assert_eq psum_ab("0.63.40.37", 101), "ERR prefix length 101 too large for IPv4"
  assert_eq psum_ab("255.168.71.255", 52), "ERR prefix length 52 too large for IPv4"
  assert_eq psum_ab("febf:ff02:9c84:96aa:0:0:b6b5:c610", 38), "febf:ff02:9c00::/38|38|febf:ff02:9c00::|febf:ff02:9c00::/38|0|febfff029c000000000000000000000026"
  assert_eq psum_ab("255.255.0.6", 67), "ERR prefix length 67 too large for IPv4"
  assert_eq psum_ab("210.10.224.0", 97), "ERR prefix length 97 too large for IPv4"
  assert_eq psum_ab("7377:f21e:7fa8:0:e3ff:c3dc:ff0e:0", 112), "7377:f21e:7fa8:0:e3ff:c3dc:ff0e:0/112|112|7377:f21e:7fa8:0:e3ff:c3dc:ff0e:0|7377:f21e:7fa8:0:e3ff:c3dc:ff0e:0/112|0|7377f21e7fa80000e3ffc3dcff0e000070"
  assert_eq psum_ab("0.255.242.0", 47), "ERR prefix length 47 too large for IPv4"
  assert_eq psum_ab("a01a::0:d718:b9ca:16c2:3bcf:0", 82), "a01a:0:0:d718:b9ca::/82|82|a01a:0:0:d718:b9ca::|a01a:0:0:d718:b9ca::/82|0|a01a00000000d718b9ca00000000000052"
  assert_eq psum_ab("0.133.110.230", 53), "ERR prefix length 53 too large for IPv4"
  assert_eq psum_ab("7ed2:ABCD:0:2001:0:0:0:fc00", 4), "7000::/4|4|7000::|7000::/4|0|7000000000000000000000000000000004"
  assert_eq psum_ab("::ffff:32.92.93.76%eth0", 70), "::/70|70|::|::/70|0|0000000000000000000000000000000046"
  assert_eq psum_ab("ff02:ABCD:0:268a:fe80:0::dbc9", 132), "ERR prefix length 132 too large for IPv6"
  assert_eq psum_ab("0:0:64f2:55b:0:0:64f2:f00a%eth0", 10), "::/10|10|::|::/10|0|000000000000000000000000000000000a"
  assert_eq psum_ab("ABCD:f5e9:ff01:5b93:0:ffff:0:f8e5", 22), "abcd:f400::/22|22|abcd:f400::|abcd:f400::/22|0|abcdf40000000000000000000000000016"
  assert_eq psum_ab("0:0:c652:FE80::8543:0", 59), "0:0:c652:fe80::/59|59|0:0:c652:fe80::|0:0:c652:fe80::/59|0|00000000c652fe8000000000000000003b"
  assert_eq psum_ab("0:ff01:0:0:b8d1:4873:195:0", -4), "ERR negative Prefix bits"
  assert_eq psum_ab("4f01:febf:0:0:0:0:ff01:aa98", 127), "4f01:febf::ff01:aa98/127|127|4f01:febf::ff01:aa98|4f01:febf::ff01:aa98/127|0|4f01febf0000000000000000ff01aa987f"
  assert_eq psum_ab("::ffff:194.0.253.128", 4), "::/4|4|::|::/4|0|0000000000000000000000000000000004"
  assert_eq psum_ab("0.0.33.103", 69), "ERR prefix length 69 too large for IPv4"
  assert_eq psum_ab("0.169.255.255", 31), "0.169.255.254/31|31|0.169.255.254|0.169.255.254/31|0|00a9fffe1f"
  assert_eq psum_ab("::ffff:255.33.0.0", 82), "::c000:0:0/82|82|::c000:0:0|::c000:0:0/82|0|00000000000000000000c0000000000052"
  assert_eq psum_ab("2fb8:90a9:0:8413:0:fc4e:b467:0", 7), "2e00::/7|7|2e00::|2e00::/7|0|2e00000000000000000000000000000007"
  assert_eq psum_ab("127.255.159.104", 108), "ERR prefix length 108 too large for IPv4"
  assert_eq psum_ab("255.127.241.207", 126), "ERR prefix length 126 too large for IPv4"
  assert_eq psum_ab("0:0:7bda:2001:e605:66b1:1146:847b", 66), "0:0:7bda:2001:c000::/66|66|0:0:7bda:2001:c000::|0:0:7bda:2001:c000::/66|0|000000007bda2001c00000000000000042"
  assert_eq psum_ab("95e8:4a7:0:FE80:b2fa:2a12:a7dc:c0cf", 30), "95e8:4a4::/30|30|95e8:4a4::|95e8:4a4::/30|0|95e804a40000000000000000000000001e"
  assert_eq psum_ab("0:6956:a5f1:0:c852:cf7e:0:0", 99), "0:6956:a5f1:0:c852:cf7e::/99|99|0:6956:a5f1:0:c852:cf7e::|0:6956:a5f1:0:c852:cf7e::/99|0|00006956a5f10000c852cf7e0000000063"
