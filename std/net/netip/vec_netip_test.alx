  assert_eq psum_p("::ffff:255.0.38.251/56::ffff:255.0.38.251/56"), "ERR netip.ParsePrefix(\"::ffff:255.0.38.251/56::ffff:255.0.38.251/56\"): ParseAddr(\"::ffff:255.0.38.251/56::ffff:255.0.38.251\"): unexpected character (at \"/56::ffff:255.0.38.251\")"
  assert_eq psum_p("0:befb:ABCD:0:0:ff01:FE80:1/85"), "0:befb:abcd::ff01:fe80:1/85|85|0:befb:abcd::ff01:fe80:1|0:befb:abcd::f800:0:0/85|0|0000befbabcd00000000ff01fe80000155"
  assert_eq psum_p("255.255.255.0/66"), "ERR netip.ParsePrefix(\"255.255.255.0/66\"): prefix length out of range"
  assert_eq psum_p("127.40.192.40/79"), "ERR netip.ParsePrefix(\"127.40.192.40/79\"): prefix length out of range"
  assert_eq psum_p("0::0:84d3:0:e58b:5dd5:ff0e/78ff0e/78"), "ERR netip.ParsePrefix(\"0::0:84d3:0:e58b:5dd5:ff0e/78ff0e/78\"): ParseAddr(\"0::0:84d3:0:e58b:5dd5:ff0e/78ff0e\"): unexpected character, want colon (at \"/78ff0e\")"
}

