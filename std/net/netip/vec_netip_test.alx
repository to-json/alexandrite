test "vectors: parse prefix 1" {
  assert_eq psum_p("::fff:253.172.30.174/51"), "::fff:fdac:1eae/51|51|::fff:fdac:1eae|::/51|0|000000000000000000000ffffdac1eae33"
  assert_eq psum_p("::ffff:255.224.168.26%en0/102"), "ERR netip.ParsePrefix(\"::ffff:255.224.168.26%en0/102\"): IPv6 zones cannot be present in a prefix"
  assert_eq psum_p("255.1.255.226/36"), "ERR netip.ParsePrefix(\"255.1.255.226/36\"): prefix length out of range"
  assert_eq psum_p("32.255.214.205/49"), "ERR netip.ParsePrefix(\"32.255.214.205/49\"): prefix length out of range"
  assert_eq psum_p("::1::"), "ERR netip.ParsePrefix(\"::1::\"): no '/'"
  assert_eq psum_p("25.22.255.145/116"), "ERR netip.ParsePrefix(\"25.22.255.145/116\"): prefix length out of range"
  assert_eq psum_p("0:0:8576:d0b5:75c:0:0:0/240:0/24"), "ERR netip.ParsePrefix(\"0:0:8576:d0b5:75c:0:0:0/240:0/24\"): ParseAddr(\"0:0:8576:d0b5:75c:0:0:0/240:0\"): unexpected character, want colon (at \"/240:0\")"
  assert_eq psum_p("0.172.238.87/97"), "ERR netip.ParsePrefix(\"0.172.238.87/97\"): prefix length out of range"
  assert_eq psum_p("::ffff:255.105.90.255/110"), "::ffff:255.105.90.255/110|110|::ffff:255.105.90.255|::ffff:255.104.0.0/110|0|00000000000000000000ffffff695aff6e"
  assert_eq psum_p("0.255.238.147/60"), "ERR netip.ParsePrefix(\"0.255.238.147/60\"): prefix length out of range"
  assert_eq psum_p("a2de:fe62:c7fd:cd36:7728:d7cc::/-1"), "ERR netip.ParsePrefix(\"a2de:fe62:c7fd:cd36:7728:d7cc::/-1\"): bad bits after slash: \"-1\""
  assert_eq psum_p("0:febf:ba2d:0:0:0:6abd:0/-1"), "ERR netip.ParsePrefix(\"0:febf:ba2d:0:0:0:6abd:0/-1\"): bad bits after slash: \"-1\""
  assert_eq psum_p("1b9e:fe80:d271:fd00:0:0:0:0/96"), "1b9e:fe80:d271:fd00::/96|96|1b9e:fe80:d271:fd00::|1b9e:fe80:d271:fd00::/96|0|1b9efe80d271fd00000000000000000060"
  assert_eq psum_p("ff02:0:283d:0:d69:d39f:0:fc00/107"), "ff02:0:283d:0:d69:d39f:0:fc00/107|107|ff02:0:283d:0:d69:d39f:0:fc00|ff02:0:283d:0:d69:d39f::/107|0|ff020000283d00000d69d39f0000fc006b"
  assert_eq psum_p("0:0:0:4754::462a:0/107"), "::4754:0:0:462a:0/107|107|::4754:0:0:462a:0|::4754:0:0:4620:0/107|0|000000000000475400000000462a00006b"
  assert_eq psum_p("ff0e:f50d:0:febf:0::/107"), "ff0e:f50d:0:febf::/107|107|ff0e:f50d:0:febf::|ff0e:f50d:0:febf::/107|0|ff0ef50d0000febf00000000000000006b"
