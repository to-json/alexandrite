# Go's nss_test.go, translated.

def ubuntu_trusty_avahi -> Str {
  [
    "# /etc/nsswitch.conf",
    "#",
    "# Example configuration of GNU Name Service Switch functionality.",
    "# If you have the libc-doc-reference' and nfo' packages installed, try:",
    "# nfo libc \"Name Service Switch\"' for information about this file.",
    "",
    "passwd:         compat",
    "group:          compat",
    "shadow:         compat",
    "",
    "hosts:          files mdns4_minimal [NOTFOUND=return] dns mdns4",
    "networks:       files",
    "",
    "protocols:      db files",
    "services:       db files",
    "ethers:         db files",
    "rpc:            db files",
    "",
    "netgroup:       nis"
  ].join("\n") + "\n"
}

# Go's nssStr: nsswitch.conf text, parsed.
def nss_str(s: Str) -> NssConf { parse_nss_conf(LineFile.new(data: s, pos: [0])) }

def src(name: Str) -> NssSource { NssSource.new(source: name, criteria: []) }

def nss_text(c: NssConf) -> Str {
  keys = c.sources.keys.to_a.sort
  out = ""
  for k in keys {
    out = out + k + ":"
    for s in c.sources[k].unwrap {
      out = out + " " + s.source
      for cr in s.criteria {
        out = out + " [#{cr.negate ? "!" : ""}#{cr.status}=#{cr.action}]"
      }
    }
    out = out + "\n"
  }
  e = c.err.present? ? "err: " + c.err.unwrap.message : ""
  out + e
}

test "ParseNSSConf" {
  ab = {"foo" => [src("a"), src("b")]}
  crit = NssSource.new(source: "b", criteria: [NssCriterion.new(negate: true, status: "a", action: "b"), NssCriterion.new(negate: false, status: "x", action: "y")])
  trusty = {
    "passwd" => [src("compat")],
    "group" => [src("compat")],
    "shadow" => [src("compat")],
    "hosts" => [src("files"), NssSource.new(source: "mdns4_minimal", criteria: [NssCriterion.new(negate: false, status: "notfound", action: "return")]), src("dns"), src("mdns4")],
    "networks" => [src("files")],
    "protocols" => [src("db"), src("files")],
    "services" => [src("db"), src("files")],
    "ethers" => [src("db"), src("files")],
    "rpc" => [src("db"), src("files")],
    "netgroup" => [src("nis")]
  }
  tests: [(Str, Str, Map[Str, [NssSource]])] = [
    ("no_newline", "foo: a b", ab),
    ("newline", "foo: a b\n", ab),
    ("whitespace", "   foo:a    b    \n", ab),
    ("comment1", "   foo:a    b#c\n", ab),
    ("comment2", "   foo:a    b #c \n", ab),
    ("crit", "   foo:a    b [!a=b    X=Y ] c#d \n", {"foo" => [src("a"), crit, src("c")]}),
    # Ubuntu Trusty with avahi-daemon, libavahi-* etc installed.
    ("ubuntu_trusty_avahi", ubuntu_trusty_avahi, trusty)
  ]
  for tt in tests {
    name, input, want = tt
    got = nss_str(input)
    w = NssConf.new(mtime: 0, sources: want)
    assert nss_text(got) == nss_text(w), "#{name}: mismatch\n got #{nss_text(got)}\nwant #{nss_text(w)}"
  }
}
