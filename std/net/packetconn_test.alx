# Go's packetconn_test.go and conn_test.go, translated.

import "os"
import "time"

test "ConnAndListener" {
  for network in stream_networks {
    next unless testable_network?(network)
    ln = new_local_listener(network)
    ch = Chan[Str].new(4)
    srv = spawn { transponder(ln, ch) }
    assert_eq ln.net_addr.unwrap.network, network
    c = dial(ln.network, ln.addr).unwrap
    assert_eq c.local_net_addr.unwrap.network, network
    assert_eq c.remote_net_addr.unwrap.network, network
    c.set_deadline(time.now.add(some_timeout))
    c.set_read_deadline(time.now.add(some_timeout))
    c.set_write_deadline(time.now.add(some_timeout))
    c.write!(bytes_of("CONN AND LISTENER TEST")).unwrap
    rb: [Byte] = [0; 128]
    c.read!(rb).unwrap
    assert_eq drain(ch), ""
    srv.wait
    c.close!
    ln.close!
  }
}

def packet_conn_rows -> [(Str, Str, Str)] { [("udp", "127.0.0.1:0", "127.0.0.1:0"), ("unixgram", test_unix_addr, test_unix_addr)] }

test "PacketConn" {
  for tt in packet_conn_rows {
    net, addr1, addr2 = tt
    next unless testable_network?(net)
    wb = bytes_of("PACKETCONN TEST")
    c1 = listen_packet(net, addr1).unwrap
    c2 = listen_packet(net, addr2).unwrap
    rb2: [Byte] = [0; 128]
    c1.write_to!(wb, c2.local_net_addr.unwrap).unwrap
    c2.read_from!(rb2).unwrap
    c2.write_to!(wb, c1.local_net_addr.unwrap).unwrap
    rb1: [Byte] = [0; 128]
    c1.read_from!(rb1).unwrap
    c1.close!
    c2.close!
    if net == "unixgram" {
      os.remove(addr1)
      os.remove(addr2)
    }
  }
}

test "ConnAndPacketConn" {
  for tt in packet_conn_rows {
    net, addr1, addr2 = tt
    next unless testable_network?(net)
    wb = bytes_of("PACKETCONN TEST")
    c1 = listen_packet(net, addr1).unwrap
    c2 = dial(net, c1.local_addr).unwrap
    c2.local_net_addr
    c2.remote_net_addr
    c2.write!(wb).unwrap
    rb1: [Byte] = [0; 128]
    c1.read_from!(rb1).unwrap
    if net != "unixgram" {
      c1.write_to!(wb, c2.local_net_addr.unwrap).unwrap
      rb2: [Byte] = [0; 128]
      c2.read!(rb2).unwrap
    }
    c2.close!
    c1.close!
    if net == "unixgram" {
      os.remove(addr1)
      os.remove(addr2)
    }
  }
}
