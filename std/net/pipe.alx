# In-memory, synchronous, full-duplex connections (Go's pipe.go).

import "time"

# Go's io.ErrClosedPipe, which a pipe end returns once either end is closed
# (alx's io has no such error).
pub error PipeError {
  ClosedPipe

  def message -> Str { "io: read/write on closed pipe" }
}

# Go's pipeAddr: both ends' address, "pipe" on network "pipe".
pub struct PipeAddr {
  pub def network -> Str { "pipe" }
  pub def to_s -> Str { "pipe" }
}

# A deadline for one direction of a pipe (Go's pipeDeadline): `cancel` is
# closed when it passes. The timer task holds only the channel and its flag
# (a compare-and-swap on the flag decides which timer may close it), not the
# Mutex.
struct PipeDeadline {
  st: Mutex[PipeDlState]

  def set(t: time.Time) {
    dur = t.is_zero ? 0 : time.until(t).ns
    # The gen of a timer to start (0: none), and what it closes.
    g, c, flag = st.lock { |s|
      s.gen += 1
      s.at = t.is_zero ? 0 : t.unix_nano
      start = 0
      cur = s.flag.load
      if t.is_zero || dur > 0 {
        # Re-arm: an older timer closes the channel only while the flag
        # holds its gen.
        if cur == -1 || !s.flag.compare_and_swap(cur, s.gen) {
          s.cancel = Chan[Bool].new
          s.flag = Atomic.new(s.gen)
        }
        start = s.gen if dur > 0
      } elsif cur != -1 && s.flag.compare_and_swap(cur, -1) {
        s.cancel.close
      }
      (start, s.cancel, s.flag)
    }
    if g > 0 {
      spawn {
        alx_sleep_ns(dur)
        c.close if flag.compare_and_swap(g, -1)
      }
    }
  }

  def wait -> Chan[Bool] { st.lock { |s| s.cancel } }

  # The deadline (Unix ns; 0: none).
  def at -> Int { st.lock { |s| s.at } }
}

struct PipeDlState {
  cancel: Chan[Bool]
  # The gen of the timer that may close `cancel`, or -1 once it is closed.
  flag: Atomic[Int]
  gen: Int
  # The deadline (Unix ns; 0: none), for tests' fake servers.
  at: Int
}

def make_pipe_deadline -> PipeDeadline { PipeDeadline.new(st: Mutex.new(PipeDlState.new(cancel: Chan[Bool].new, flag: Atomic.new(0), gen: 0, at: 0))) }

def closed_chan?(c: Chan[Bool]) -> Bool {
  r = false
  select {
    when v = c.recv => r = true
    else => r = false
  }
  r
}

# One end of a pipe (Go's pipe).
struct PipeEnd {
  wr_mu: Mutex[Int]
  rd_rx: Chan[[Byte]]
  rd_tx: Chan[Int]
  wr_tx: Chan[[Byte]]
  wr_rx: Chan[Int]
  closed_once: Atomic[Bool]
  # What a read fails with once the other end closed with
  # close_with_error! ("" for EOF), and the other end's.
  my_fail: Atomic[Str]
  remote_fail: Atomic[Str]
  local_done: Chan[Bool]
  remote_done: Chan[Bool]
  read_dl: PipeDeadline
  write_dl: PipeDeadline

  def read!(b: [Byte]) -> ~Int {
    fail PipeError.ClosedPipe if closed_chan?(local_done)
    return ~peer_eof if closed_chan?(remote_done)
    dl = read_dl.wait
    fail timeout_error("read", "pipe", "", "") if closed_chan?(dl)
    select {
      when bw = rd_rx.recv => {
        nr = copy(b, bw.unwrap)
        rd_tx << nr
        return nr
      }
      when v = local_done.recv => { fail PipeError.ClosedPipe }
      when v = remote_done.recv => { return ~peer_eof }
      when v = dl.recv => { fail timeout_error("read", "pipe", "", "") }
    }
    0
  }

  def write!(b0: [Byte]) -> ~Int {
    fail PipeError.ClosedPipe if closed_chan?(local_done) || closed_chan?(remote_done)
    dl = write_dl.wait
    fail timeout_error("write", "pipe", "", "") if closed_chan?(dl)
    me = self
    r = wr_mu.lock { |_u| me.write_locked(b0, dl) }
    ~r
  }

  def write_locked(b0: [Byte], dl: Chan[Bool]) -> ~Int {
    b = b0
    n = 0
    once = true
    while once || b.size > 0 {
      once = false
      select {
        when wr_tx.send(b.dup) => {
          nw = wr_rx.recv || 0
          b = b[nw...b.size]
          n += nw
        }
        when v = local_done.recv => { fail PipeError.ClosedPipe }
        when v = remote_done.recv => { fail PipeError.ClosedPipe }
        when v = dl.recv => { fail timeout_error("write", "pipe", "", "") }
      }
    }
    n
  }

  # mode: 1 read, 2 write, 3 both.
  def set_deadline(mode: Int, t: time.Time) -> ~Unit {
    fail PipeError.ClosedPipe if closed_chan?(local_done) || closed_chan?(remote_done)
    read_dl.set(t) if mode & 1 != 0
    write_dl.set(t) if mode & 2 != 0
  }

  def close! -> ~Unit {
    local_done.close if closed_once.compare_and_swap(false, true)
  }

  # For tests' fake servers: closes, making the other end's reads fail
  # with an error instead of reading the end of the stream: "timeout" (an
  # i/o timeout), "op:TEXT" (a failed operation, Go's *OpError) or
  # "err:TEXT" (another error).
  def close_with_error!(kind: Str) {
    remote_fail.store(kind)
    local_done.close if closed_once.compare_and_swap(false, true)
  }

  def peer_eof -> ~Int {
    f = my_fail.load
    return 0 if f == ""
    fail timeout_error("", "", "", "") if f == "timeout"
    fail wrap_error("write", "", "", "", "", f[3...f.size]) if f.start_with?("op:")
    fail client_error(f[4...f.size])
  }
}

# Go's Pipe: two connected in-memory ends; a write blocks until the other
# end has read all of it (no buffering). Both ends are Conns (network
# "pipe", addresses "pipe"); a closed end reads 0 (end of stream) on the
# other side and fails writes with PipeError.ClosedPipe.
pub def pipe -> (Conn, Conn) {
  cb1 = Chan[[Byte]].new
  cb2 = Chan[[Byte]].new
  cn1 = Chan[Int].new
  cn2 = Chan[Int].new
  done1 = Chan[Bool].new
  done2 = Chan[Bool].new
  f1 = Atomic.new("")
  f2 = Atomic.new("")
  p1 = PipeEnd.new(wr_mu: Mutex.new(0), rd_rx: cb1, rd_tx: cn1, wr_tx: cb2, wr_rx: cn2, closed_once: Atomic.new(false), my_fail: f1, remote_fail: f2, local_done: done1, remote_done: done2, read_dl: make_pipe_deadline, write_dl: make_pipe_deadline)
  p2 = PipeEnd.new(wr_mu: Mutex.new(0), rd_rx: cb2, rd_tx: cn2, wr_tx: cb1, wr_rx: cn1, closed_once: Atomic.new(false), my_fail: f2, remote_fail: f1, local_done: done2, remote_done: done1, read_dl: make_pipe_deadline, write_dl: make_pipe_deadline)
  (pipe_conn(p1), pipe_conn(p2))
}

def pipe_conn(p: PipeEnd) -> Conn {
  Conn.new(nfd: new_fd(-1, 0, 0, "pipe", none, none, false), pp: p)
}
