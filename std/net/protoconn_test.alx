# Go's protoconn_test.go, translated. TestIPConnSpecificMethods needs raw
# sockets (root): it runs only as root, as in Go.

import "os"
import "time"

# Go's mustSetDeadline.
def must_set_deadline(ln: Listener, d: time.Duration) {
  l = ln
  l.set_deadline(time.now.add(d)).unwrap
}

def timeout_or_close(r: ~Conn) {
  if e = r.err {
    assert is_timeout(e), e.message
  } else {
    c = r.unwrap
    c.close!
  }
}

test "TCPListenerSpecificMethods" {
  la = resolve_tcp_addr("tcp4", "127.0.0.1:0").unwrap
  ln = listen_tcp("tcp4", la).unwrap
  ln.net_addr
  must_set_deadline(ln, time.nanosecond * 30)
  timeout_or_close(ln.accept)
  timeout_or_close(ln.accept_tcp)
  f = ln.file.unwrap
  f.close!
  ln.close!
}

test "TCPConnSpecificMethods" {
  la = resolve_tcp_addr("tcp4", "127.0.0.1:0").unwrap
  ln = listen_tcp("tcp4", la).unwrap
  ch = Chan[Str].new(4)
  srv = spawn { transponder(ln, ch) }
  ra = resolve_tcp_addr("tcp4", ln.addr).unwrap
  c = dial_tcp("tcp4", none, ra).unwrap
  c.set_keep_alive(false).unwrap
  c.set_keep_alive_period(time.second * 3).unwrap
  c.set_linger(0).unwrap
  c.set_no_delay(false).unwrap
  c.local_net_addr
  c.remote_net_addr
  c.set_deadline(time.now.add(some_timeout)).unwrap
  c.set_read_deadline(time.now.add(some_timeout)).unwrap
  c.set_write_deadline(time.now.add(some_timeout)).unwrap
  c.write!(bytes_of("TCPCONN TEST")).unwrap
  rb: [Byte] = [0; 128]
  c.read!(rb).unwrap
  assert_eq drain(ch), ""
  srv.wait
  c.close!
  ln.close!
}

test "UDPConnSpecificMethods" {
  la = resolve_udp_addr("udp4", "127.0.0.1:0").unwrap
  c = listen_udp("udp4", la).unwrap
  me = case c.local_net_addr.unwrap {
    UDPAddr(u) => u
    _ => UDPAddr.new
  }
  c.remote_net_addr
  c.set_deadline(time.now.add(some_timeout)).unwrap
  c.set_read_deadline(time.now.add(some_timeout)).unwrap
  c.set_write_deadline(time.now.add(some_timeout)).unwrap
  c.set_read_buffer(2048).unwrap
  c.set_write_buffer(2048).unwrap
  wb = bytes_of("UDPCONN TEST")
  rb: [Byte] = [0; 128]
  empty: [Byte] = []
  c.write_to_udp!(wb, me).unwrap
  c.read_from_udp!(rb).unwrap
  c.write_msg_udp!(wb, empty, me).unwrap
  c.read_msg_udp!(rb, empty).unwrap
  f = c.file.unwrap
  f.close!
  assert c.write_to_udp!(wb, none).err?, "write_to_udp(nil) should fail"
  assert c.write_msg_udp!(wb, empty, none).err?, "write_msg_udp(nil) should fail"
  c.close!
}

test "IPConnSpecificMethods" {
  if testable_network?("ip4") {
    la = resolve_ip_addr("ip4", "127.0.0.1").unwrap
    c = listen_ip("ip4:icmp", la).unwrap
    c.local_net_addr
    c.remote_net_addr
    c.set_deadline(time.now.add(some_timeout)).unwrap
    c.set_read_deadline(time.now.add(some_timeout)).unwrap
    c.set_write_deadline(time.now.add(some_timeout)).unwrap
    c.set_read_buffer(2048).unwrap
    c.set_write_buffer(2048).unwrap
    f = c.file.unwrap
    f.close!
    wb = bytes_of("IPCONN TEST")
    empty: [Byte] = []
    assert c.write_to_ip!(wb, none).err?, "write_to_ip(nil) should fail"
    assert c.write_msg_ip!(wb, empty, none).err?, "write_msg_ip(nil) should fail"
    c.close!
  }
}

test "UnixListenerSpecificMethods" {
  addr = test_unix_addr
  la = resolve_unix_addr("unix", addr).unwrap
  ln = listen_unix("unix", la).unwrap
  ln.net_addr
  must_set_deadline(ln, time.nanosecond * 30)
  timeout_or_close(ln.accept)
  timeout_or_close(ln.accept_unix)
  f = ln.file.unwrap
  f.close!
  ln.close!
  os.remove(addr)
}

test "UnixConnSpecificMethods" {
  addr1 = test_unix_addr
  addr2 = test_unix_addr
  addr3 = test_unix_addr
  a1 = resolve_unix_addr("unixgram", addr1).unwrap
  c1 = dial_unix("unixgram", a1, none).unwrap
  a2 = resolve_unix_addr("unixgram", addr2).unwrap
  c2 = dial_unix("unixgram", a2, none).unwrap
  a3 = resolve_unix_addr("unixgram", addr3).unwrap
  c3 = listen_unixgram("unixgram", a3).unwrap
  for c in [c1, c2, c3] {
    c.local_net_addr
    c.remote_net_addr
    c.set_deadline(time.now.add(some_timeout)).unwrap
    c.set_read_deadline(time.now.add(some_timeout)).unwrap
    c.set_write_deadline(time.now.add(some_timeout)).unwrap
    c.set_read_buffer(2048).unwrap
    c.set_write_buffer(2048).unwrap
  }
  wb = bytes_of("UNIXCONN TEST")
  rb1: [Byte] = [0; 128]
  rb2: [Byte] = [0; 128]
  rb3: [Byte] = [0; 128]
  empty: [Byte] = []
  c1.write_msg_unix!(wb, empty, a2).unwrap
  c2.read_msg_unix!(rb2, empty).unwrap
  c2.write_to_unix!(wb, a1).unwrap
  c1.read_from_unix!(rb1).unwrap
  c3.write_to_unix!(wb, a1).unwrap
  c1.read_from_unix!(rb1).unwrap
  c2.write_to_unix!(wb, a3).unwrap
  c3.read_from_unix!(rb3).unwrap
  f = c1.file.unwrap
  f.close!
  assert c1.write_to_unix!(wb, none).err?, "c1 write_to_unix(nil)"
  assert c1.write_msg_unix!(wb, empty, none).err?, "c1 write_msg_unix(nil)"
  assert c3.write_to_unix!(wb, none).err?, "c3 write_to_unix(nil)"
  assert c3.write_msg_unix!(wb, empty, none).err?, "c3 write_msg_unix(nil)"
  c1.close!
  c2.close!
  c3.close!
  os.remove(addr1)
  os.remove(addr2)
  os.remove(addr3)
}
