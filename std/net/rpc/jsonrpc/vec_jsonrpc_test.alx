# Generated from Go's net/rpc/jsonrpc (go run, Go 1.27): server responses to raw requests; do not edit by hand.

test "vectors: server responses" {
  srv = start_server()
  assert_eq exchange(srv, "{\"method\": \"Arith.Add\", \"id\": 0, \"params\": [{\"A\": 0, \"B\": 1}]}"), "{\"id\":0,\"result\":{\"C\":1},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\": \"Arith.Add\", \"id\": \"123\", \"params\": [{\"A\": 1, \"B\": 2}]}"), "{\"id\":\"123\",\"result\":{\"C\":3},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\": \"Arith.Add\", \"id\": \"\\u0001\", \"params\": [{\"A\": 2, \"B\": 3}]}"), "{\"id\":\"\\u0001\",\"result\":{\"C\":5},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\": \"Arith.Add\", \"id\": null, \"params\": [{\"A\": 3, \"B\": 4}]}"), "{\"id\":null,\"result\":{\"C\":7},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\": \"Arith.Add\", \"id\": {\"x\":[1,2]}, \"params\": [{\"A\": 4, \"B\": 5}]}"), "{\"id\":{\"x\":[1,2]},\"result\":{\"C\":9},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\": \"Arith.Add\", \"id\": -7, \"params\": [{\"A\": 5, \"B\": 6}]}"), "{\"id\":-7,\"result\":{\"C\":11},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\": \"Arith.Add\", \"id\": 1.5, \"params\": [{\"A\": 6, \"B\": 7}]}"), "{\"id\":1.5,\"result\":{\"C\":13},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\": \"Arith.Add\", \"id\": \"<&>\", \"params\": [{\"A\": 7, \"B\": 8}]}"), "{\"id\":\"\\u003c\\u0026\\u003e\",\"result\":{\"C\":15},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\":\"Arith.Mul\",\"params\":[{\"A\":7,\"B\":8}],\"id\":3}"), "{\"id\":3,\"result\":{\"C\":56},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\":\"Arith.Div\",\"params\":[{\"A\":7,\"B\":0}],\"id\":4}"), "{\"id\":4,\"result\":null,\"error\":\"divide by zero\"}\n"
  assert_eq exchange(srv, "{\"method\":\"Arith.Div\",\"params\":[{\"A\":7,\"B\":2}],\"id\":5}"), "{\"id\":5,\"result\":{\"C\":3},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\":\"Arith.Nope\",\"params\":[{\"A\":7,\"B\":2}],\"id\":6}"), "{\"id\":6,\"result\":null,\"error\":\"rpc: can't find method Arith.Nope\"}\n"
  assert_eq exchange(srv, "{\"method\":\"Nope.Add\",\"params\":[{\"A\":7,\"B\":2}],\"id\":7}"), "{\"id\":7,\"result\":null,\"error\":\"rpc: can't find service Nope.Add\"}\n"
  assert_eq exchange(srv, "{\"method\":\"NoDot\",\"params\":[{\"A\":7,\"B\":2}],\"id\":8}"), "{\"id\":8,\"result\":null,\"error\":\"rpc: service/method request ill-formed: NoDot\"}\n"
  assert_eq exchange(srv, "{\"method\": \"Arith.Add\", \"id\": \"123\"}"), "{\"id\":\"123\",\"result\":null,\"error\":\"jsonrpc: request body missing params\"}\n"
  assert_eq exchange(srv, "{}"), "{\"id\":null,\"result\":null,\"error\":\"rpc: service/method request ill-formed: \"}\n"
  assert_eq exchange(srv, "{\"method\":\"Arith.Add\",\"params\":[],\"id\":9}"), "{\"id\":9,\"result\":{\"C\":0},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\":\"Arith.Add\",\"params\":[{\"A\":1,\"B\":2},{\"A\":5}],\"id\":10}"), "{\"id\":10,\"result\":{\"C\":3},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\":\"Arith.Add\",\"params\":[{\"A\":1,\"B\":2,\"Z\":3}],\"id\":11}"), "{\"id\":11,\"result\":{\"C\":3},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\":\"Arith.Add\",\"id\":12,\"params\":[{\"A\":1}]}"), "{\"id\":12,\"result\":{\"C\":1},\"error\":null}\n"
  assert_eq exchange(srv, "  {\"method\":\"Arith.Add\",\"params\":[{\"A\":-4,\"B\":2}],\"id\":13}  "), "{\"id\":13,\"result\":{\"C\":-2},\"error\":null}\n"
  assert_eq exchange(srv, "{\"method\":\"Arith.Add\",\"params\":null,\"id\":14}"), "{\"id\":14,\"result\":null,\"error\":\"jsonrpc: request body missing params\"}\n"
  assert_eq exchange(srv, "{\"method\":\"Div\\\"<x>\",\"params\":[{\"A\":1}],\"id\":15}"), "{\"id\":15,\"result\":null,\"error\":\"rpc: service/method request ill-formed: Div\\\"\\u003cx\\u003e\"}\n"
}
