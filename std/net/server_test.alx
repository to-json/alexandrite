# Go's server_test.go, translated. Rows whose server listens on a wildcard
# address are skipped, as Go skips them without an external network; the
# abstract-name rows run on Linux only, as in Go.

import "os"

test "TCPServer" {
  rows: [(Str, Str, Str, Str)] = [
    ("tcp", ":0", "tcp", "127.0.0.1"),
    ("tcp", "0.0.0.0:0", "tcp", "127.0.0.1"),
    ("tcp", "[::ffff:0.0.0.0]:0", "tcp", "127.0.0.1"),
    ("tcp", "[::]:0", "tcp", "::1"),
    ("tcp", ":0", "tcp", "::1"),
    ("tcp", "0.0.0.0:0", "tcp", "::1"),
    ("tcp", "[::ffff:0.0.0.0]:0", "tcp", "::1"),
    ("tcp", "[::]:0", "tcp", "127.0.0.1"),
    ("tcp", ":0", "tcp4", "127.0.0.1"),
    ("tcp", "0.0.0.0:0", "tcp4", "127.0.0.1"),
    ("tcp", "[::ffff:0.0.0.0]:0", "tcp4", "127.0.0.1"),
    ("tcp", "[::]:0", "tcp6", "::1"),
    ("tcp", ":0", "tcp6", "::1"),
    ("tcp", "0.0.0.0:0", "tcp6", "::1"),
    ("tcp", "[::ffff:0.0.0.0]:0", "tcp6", "::1"),
    ("tcp", "[::]:0", "tcp4", "127.0.0.1"),
    ("tcp", "127.0.0.1:0", "tcp", "127.0.0.1"),
    ("tcp", "[::ffff:127.0.0.1]:0", "tcp", "127.0.0.1"),
    ("tcp", "[::1]:0", "tcp", "::1"),
    ("tcp4", ":0", "tcp4", "127.0.0.1"),
    ("tcp4", "0.0.0.0:0", "tcp4", "127.0.0.1"),
    ("tcp4", "[::ffff:0.0.0.0]:0", "tcp4", "127.0.0.1"),
    ("tcp4", "127.0.0.1:0", "tcp4", "127.0.0.1"),
    ("tcp6", ":0", "tcp6", "::1"),
    ("tcp6", "[::]:0", "tcp6", "::1"),
    ("tcp6", "[::1]:0", "tcp6", "::1")
  ]
  for tt in rows {
    snet, saddr, tnet, taddr = tt
    next unless testable_listen_args?(snet, saddr, taddr)
    ln = listen(snet, saddr).unwrap
    n = 3
    tpchs = (0...n).map { |_i| Chan[Str].new(4) }.to_a
    servers = tpchs.map { |ch| spawn { transponder(ln, ch) } }.to_a
    _, port = split_host_port(ln.addr).unwrap
    trchs: [Chan[Str]] = []
    conns: [Conn] = []
    for _i in 0...n {
      d = Dialer.new(timeout: some_timeout)
      c = d.dial(tnet, join_host_port(taddr, port)).unwrap
      ch = Chan[Str].new(4)
      trchs << ch
      conns << c
      spawn { transceiver(c, bytes_of("TCP SERVER TEST"), ch) }
    }
    for ch in trchs {
      assert_eq drain(ch), ""
    }
    for ch in tpchs {
      assert_eq drain(ch), ""
    }
    for t in servers {
      t.wait
    }
    for c in conns {
      cc = c
      cc.close!
    }
    ln.close!
  }
}

test "UnixAndUnixpacketServer" {
  rows: [(Str, Str)] = [("unix", test_unix_addr), ("unix", "@nettest/go/unix"), ("unixpacket", test_unix_addr), ("unixpacket", "@nettest/go/unixpacket")]
  for tt in rows {
    network, address = tt
    next unless testable_listen_args?(network, address, "")
    ln = listen(network, address).unwrap
    n = 3
    tpchs = (0...n).map { |_i| Chan[Str].new(4) }.to_a
    servers = tpchs.map { |ch| spawn { transponder(ln, ch) } }.to_a
    trchs: [Chan[Str]] = []
    conns: [Conn] = []
    for _i in 0...n {
      d = Dialer.new(timeout: some_timeout)
      c = d.dial(ln.network, ln.addr).unwrap
      ch = Chan[Str].new(4)
      trchs << ch
      conns << c
      spawn { transceiver(c, bytes_of("UNIX AND UNIXPACKET SERVER TEST"), ch) }
    }
    for ch in trchs {
      assert_eq drain(ch), ""
    }
    for ch in tpchs {
      assert_eq drain(ch), ""
    }
    for t in servers {
      t.wait
    }
    for c in conns {
      cc = c
      cc.close!
    }
    ln.close!
  }
}

test "UDPServer" {
  rows: [(Str, Str, Str, Str, Bool)] = [
    ("udp", ":0", "udp", "127.0.0.1", false),
    ("udp", "0.0.0.0:0", "udp", "127.0.0.1", false),
    ("udp", "[::ffff:0.0.0.0]:0", "udp", "127.0.0.1", false),
    ("udp", "[::]:0", "udp", "::1", false),
    ("udp", ":0", "udp", "::1", false),
    ("udp", "0.0.0.0:0", "udp", "::1", false),
    ("udp", "[::ffff:0.0.0.0]:0", "udp", "::1", false),
    ("udp", "[::]:0", "udp", "127.0.0.1", false),
    ("udp", ":0", "udp4", "127.0.0.1", false),
    ("udp", "0.0.0.0:0", "udp4", "127.0.0.1", false),
    ("udp", "[::ffff:0.0.0.0]:0", "udp4", "127.0.0.1", false),
    ("udp", "[::]:0", "udp6", "::1", false),
    ("udp", ":0", "udp6", "::1", false),
    ("udp", "0.0.0.0:0", "udp6", "::1", false),
    ("udp", "[::ffff:0.0.0.0]:0", "udp6", "::1", false),
    ("udp", "[::]:0", "udp4", "127.0.0.1", false),
    ("udp", "127.0.0.1:0", "udp", "127.0.0.1", false),
    ("udp", "[::ffff:127.0.0.1]:0", "udp", "127.0.0.1", false),
    ("udp", "[::1]:0", "udp", "::1", false),
    ("udp4", ":0", "udp4", "127.0.0.1", false),
    ("udp4", "0.0.0.0:0", "udp4", "127.0.0.1", false),
    ("udp4", "[::ffff:0.0.0.0]:0", "udp4", "127.0.0.1", false),
    ("udp4", "127.0.0.1:0", "udp4", "127.0.0.1", false),
    ("udp6", ":0", "udp6", "::1", false),
    ("udp6", "[::]:0", "udp6", "::1", false),
    ("udp6", "[::1]:0", "udp6", "::1", false),
    ("udp", "127.0.0.1:0", "udp", "127.0.0.1", true),
    ("udp", "[::1]:0", "udp", "::1", true)
  ]
  for tt in rows {
    snet, saddr, tnet, taddr, use_dial = tt
    next unless testable_listen_args?(snet, saddr, taddr)
    c1 = listen_packet(snet, saddr).unwrap
    tpch = Chan[Str].new(4)
    server = spawn { packet_transponder(c1, tpch) }
    trch = Chan[Str].new(4)
    _, port = split_host_port(c1.local_addr).unwrap
    if use_dial {
      d = Dialer.new(timeout: some_timeout)
      c2 = d.dial(tnet, join_host_port(taddr, port)).unwrap
      transceiver(c2, bytes_of("UDP SERVER TEST"), trch)
      c2.close!
    } else {
      p2 = listen_packet(tnet, join_host_port(taddr, "0")).unwrap
      dst = resolve_udp_addr(tnet, join_host_port(taddr, port)).unwrap
      packet_transceiver(p2, bytes_of("UDP SERVER TEST"), dst, trch)
      p2.close!
    }
    assert_eq drain(trch), ""
    assert_eq drain(tpch), ""
    server.wait
    c1.close!
  }
}

test "UnixgramServer" {
  rows: [(Str, Str, Bool)] = [(test_unix_addr, test_unix_addr, false), (test_unix_addr, test_unix_addr, true), ("@nettest/go/unixgram/server", "@nettest/go/unixgram/client", false)]
  for tt in rows {
    saddr, caddr, use_dial = tt
    next unless testable_listen_args?("unixgram", saddr, "")
    c1 = listen_packet("unixgram", saddr).unwrap
    tpch = Chan[Str].new(4)
    server = spawn { packet_transponder(c1, tpch) }
    trch = Chan[Str].new(4)
    if use_dial {
      d = Dialer.new(timeout: some_timeout, local_addr: UnixAddr.new(net: "unixgram", name: caddr))
      c2 = d.dial("unixgram", c1.local_addr).unwrap
      transceiver(c2, bytes_of(c2.local_addr), trch)
      c2.close!
      os.remove(c2.local_addr)
    } else {
      p2 = listen_packet("unixgram", caddr).unwrap
      packet_transceiver(p2, bytes_of("UNIXGRAM SERVER TEST"), c1.local_net_addr.unwrap, trch)
      p2.close!
      os.remove(p2.local_addr)
    }
    assert_eq drain(trch), ""
    assert_eq drain(tpch), ""
    server.wait
    c1.close!
    os.remove(saddr)
  }
}
