test "vectors: dot bytes 1" {
  assert_eq dotb("a\n\na "), "ERR unexpected EOF"
  assert_eq dotb(".\r\na.\n"), ""
  assert_eq dotb("\n\n"), "ERR unexpected EOF"
  assert_eq dotb("x.y\r\n.\r\n.\r\n.\r\n"), "x.y\n"
  assert_eq dotb("\r\n."), "ERR unexpected EOF"
