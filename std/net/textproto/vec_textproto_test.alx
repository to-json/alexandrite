  assert_eq cont(" lead\t:\r\nFoo\tBar v \r\nx-Y_z: x y z\r\n \x01\nk$:a\tb\r\r\n"), "<lead\t:><Foo\tBar v><x-Y_z: x y z \x01><k$:a\tb\r>"
  assert_eq cont(" lead:1\r\na-1-c:x y z\r\nmy-key: v\r\n\n"), "<lead:1><a-1-c:x y z><my-key: v><>"
  assert_eq cont(" : v \r\nmy-key:\tv\nFoo:  v \r\n\t\x7f\n\r\n"), "<: v><my-key:\tv><Foo:  v \x7f><>"
  assert_eq cont("my-key v \n\t v \n\r\n"), "<my-key v v><>"
