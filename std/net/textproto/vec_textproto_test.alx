  assert_eq rr("2500hello world\n99-hello world\n2505.1.1 fail\n  lead\r", 2), "ERR short response: \"2500hello world\""
  assert_eq rr("x lead\n2500  lead\n- lead\r\n2500  lead\n", 4), "ERR short response: \"x lead\""
  assert_eq rr("250xhello world\n- lead", 4), "ERR short response: \"250xhello world\""
  assert_eq rr("99xok\nabcxok\nfree text\n220-\n", 1), "ERR short response: \"99xok\""
  assert_eq rr("ok\n99-\n", 250), "ERR short response: \"ok\""
  assert_eq rr("250hello world\r", 25), "ERR short response: \"250hello world\\r\""
  assert_eq rr("5.1.1 fail\r\n99- lead\r\nfree text\n lead\r\n", 550), "ERR short response: \"5.1.1 fail\""
  assert_eq rr("1234-ok\r\n220-5.1.1 fail\nfree text\n2500ok\r", 0), "ERR short response: \"1234-ok\""
  assert_eq rr("1234  lead\r\n99xok\n", 220), "ERR short response: \"1234  lead\""
  assert_eq rr("1234xhello world\n99 ok\nabcok\n2500xok\r", 4), "ERR short response: \"1234xhello world\""
  assert_eq rr(" 5.1.1 fail\n99 hello world\n", 5), "ERR short response: \" 5.1.1 fail\""
