test "vectors: response 0" {
  assert_eq rr("220hello world\n", 1), "ERR short response: \"220hello world\""
  assert_eq rr("550\r\n550x lead\r", 25), "ERR short response: \"550\""
  assert_eq rr("1234xok\n550 5.1.1 fail\r\n250xhello world\n99xok\r\n", 1), "ERR short response: \"1234xok\""
  assert_eq rr("2500-hello world\r\n220-\r\nhello world\r\n250-ok", 22), "ERR short response: \"2500-hello world\""
  assert_eq rr("550 5.1.1 fail\n2500  lead\n1234xhello world\r\n", 550), "550|5.1.1 fail"
  assert_eq rr("250 ok\n99ok\n1234 5.1.1 fail\r\nabc hello world\r\n", 25), "250|ok"
  assert_eq rr("99 5.1.1 fail\n1234\n99  lead\r\n", 220), "ERR short response: \"99 5.1.1 fail\""
  assert_eq rr("free text\n550 ok\r\n lead\nfree text\n", 220), "ERR short response: \"free text\""
  assert_eq rr("220 5.1.1 fail\n- lead\nfree text\r\n1234 ok\r", 2), "220|5.1.1 fail"
  assert_eq rr("220x\n1234 5.1.1 fail", 550), "ERR short response: \"220x\""
  assert_eq rr("220- lead\r\n550x5.1.1 fail\n", 550), "EOF"
  assert_eq rr("550hello world\r\n hello world", 2), "ERR short response: \"550hello world\""
  assert_eq rr("550xok\r\n", 1), "ERR short response: \"550xok\""
  assert_eq rr("250x lead\n220x5.1.1 fail\n", 1), "ERR short response: \"250x lead\""
  assert_eq rr("free text\nfree text\r", 220), "ERR short response: \"free text\""
  assert_eq rr("250-ok\n250ok\n99-\r\n2500x lead\r", 0), "EOF"
  assert_eq rr("free text\r\n99xok\r\n", 22), "ERR short response: \"free text\""
  assert_eq rr("1234-hello world\r\n5505.1.1 fail\n99  lead\n", 550), "ERR short response: \"1234-hello world\""
  assert_eq rr("220x5.1.1 fail\n99-hello world", 250), "ERR short response: \"220x5.1.1 fail\""
  assert_eq rr("2500x5.1.1 fail\r\n", 0), "ERR short response: \"2500x5.1.1 fail\""
  assert_eq rr("250x5.1.1 fail\r\n", 4), "ERR short response: \"250x5.1.1 fail\""
  assert_eq rr("free text\n220ok\nabc  lead\r", 5), "ERR short response: \"free text\""
  assert_eq rr("free text", 0), "ERR short response: \"free text\""
  assert_eq rr("abcx lead\n", 1), "ERR short response: \"abcx lead\""
  assert_eq rr("free text\nfree text\r\nhello world\r\n2500-hello world\n", 22), "ERR short response: \"free text\""
  assert_eq rr("550 ok\nx5.1.1 fail\n1234 \n250x\n", 250), "CODE 550|ok"
  assert_eq rr("550-\n550x lead\n", 220), "EOF"
  assert_eq rr("250hello world\n2500xhello world\n", 550), "ERR short response: \"250hello world\""
  assert_eq rr("free text\r\n550  lead\r\n2500xok\r\n220xhello world\n", 22), "ERR short response: \"free text\""
  assert_eq rr("2500  lead\r\nfree text\r\n2500 ok\r\n", 5), "ERR short response: \"2500  lead\""
  assert_eq rr("abc \n250\n99 lead\r\n99 \n", 550), "ERR invalid response code: \"abc \""
  assert_eq rr("free text\n", 550), "ERR short response: \"free text\""
  assert_eq rr("  lead\n550-\n250-hello world\r\n1234 hello world\n", 5), "ERR short response: \"  lead\""
  assert_eq rr("220hello world\r", 1), "ERR short response: \"220hello world\\r\""
  assert_eq rr("99 \n \n250x5.1.1 fail\n", 4), "ERR short response: \"99 \""
  assert_eq rr("550 5.1.1 fail\n", 220), "CODE 550|5.1.1 fail"
  assert_eq rr("2500-hello world\n99xhello world\nxok\r", 250), "ERR short response: \"2500-hello world\""
  assert_eq rr("free text\n220xok\n", 5), "ERR short response: \"free text\""
  assert_eq rr("220 \n550 5.1.1 fail", 550), "CODE 220|"
  assert_eq rr("2500\r\nfree text\n2500-5.1.1 fail\n", 22), "ERR short response: \"2500\""
  assert_eq rr("1234  lead\r\n550-\r\n2500-hello world\nhello world", 250), "ERR short response: \"1234  lead\""
  assert_eq rr("free text\n-ok\nfree text\r\n", 0), "ERR short response: \"free text\""
  assert_eq rr("220 hello world\n1234 5.1.1 fail\n550x\n", 550), "CODE 220|hello world"
  assert_eq rr("250xok\r\n250xok\n25005.1.1 fail\n550- lead\n", 0), "ERR short response: \"250xok\""
  assert_eq rr("abc  lead\n", 4), "ERR invalid response code: \"abc  lead\""
  assert_eq rr("5505.1.1 fail\n", 550), "ERR short response: \"5505.1.1 fail\""
  assert_eq rr("250x lead\r\n2500xhello world\n220 ok\n99-5.1.1 fail\r\n", 2), "ERR short response: \"250x lead\""
  assert_eq rr("free text\n550 lead\n2500hello world\r", 220), "ERR short response: \"free text\""
  assert_eq rr("250  lead\nfree text\nfree text\r\n", 250), "250| lead"
  assert_eq rr("2500x\n", 4), "ERR short response: \"2500x\""
  assert_eq rr("x lead\r", 550), "ERR short response: \"x lead\\r\""
  assert_eq rr("220 ok\nfree text\n2500 \r\n", 22), "220|ok"
  assert_eq rr("-ok\n250ok\n250 5.1.1 fail", 250), "ERR short response: \"-ok\""
  assert_eq rr("220 hello world\n550-ok\r\nfree text\r\n", 0), "220|hello world"
  assert_eq rr("2205.1.1 fail\n", 2), "ERR short response: \"2205.1.1 fail\""
  assert_eq rr("2500x lead\n220x\nfree text\n1234xok\r\n", 25), "ERR short response: \"2500x lead\""
  assert_eq rr("free text\n250-5.1.1 fail\nfree text\r\n", 5), "ERR short response: \"free text\""
  assert_eq rr("1234x5.1.1 fail\n550x5.1.1 fail\n", 0), "ERR short response: \"1234x5.1.1 fail\""
  assert_eq rr("99xok\r\nabc-hello world\nabc-ok\r\n", 25), "ERR short response: \"99xok\""
  assert_eq rr("99xok\n", 4), "ERR short response: \"99xok\""
  assert_eq rr("free text", 550), "ERR short response: \"free text\""
  assert_eq rr("220xok", 25), "ERR short response: \"220xok\""
  assert_eq rr("hello world\r\n1234hello world\n", 550), "ERR short response: \"hello world\""
  assert_eq rr("2500  lead\n", 22), "ERR short response: \"2500  lead\""
  assert_eq rr("1234  lead\r\n250x\r\n", 25), "ERR short response: \"1234  lead\""
  assert_eq rr("550x lead\nabcxok\n", 250), "ERR short response: \"550x lead\""
  assert_eq rr("995.1.1 fail\n995.1.1 fail\n2500ok\n", 1), "ERR short response: \"995.1.1 fail\""
  assert_eq rr("-ok\n250 5.1.1 fail\n", 5), "ERR short response: \"-ok\""
  assert_eq rr("220- lead\n", 220), "EOF"
  assert_eq rr("99x\n250- lead\r\n250-ok\nabcx lead\n", 250), "ERR short response: \"99x\""
  assert_eq rr("free text\r\n550  lead\r\n250hello world\n2500xok", 22), "ERR short response: \"free text\""
  assert_eq rr("250 ok\n250  lead\n1234x\n", 250), "250|ok"
  assert_eq rr("abc- lead\nfree text\n \n", 0), "EOF"
  assert_eq rr("99hello world\nx lead\r\n250x lead\nxok\n", 22), "ERR short response: \"99hello world\""
  assert_eq rr("220xok\r\n550- lead\r", 250), "ERR short response: \"220xok\""
  assert_eq rr("free text\n-hello world\r", 220), "ERR short response: \"free text\""
  assert_eq rr("free text\n \r\n550- lead\r\n99x lead", 1), "ERR short response: \"free text\""
  assert_eq rr("abcx\r", 2), "ERR short response: \"abcx\\r\""
  assert_eq rr("abc\n550-\n250-ok\r", 220), "ERR short response: \"abc\""
  assert_eq rr("250- lead\n1234\n2500-5.1.1 fail\r\n", 5), "EOF"
  assert_eq rr("1234hello world\n250x lead\r", 0), "ERR short response: \"1234hello world\""
  assert_eq rr("abc ok\r\n99 \r\n1234x lead\n", 1), "ERR invalid response code: \"abc ok\""
  assert_eq rr("2500-5.1.1 fail\n2500 lead\nfree text\r\n", 250), "ERR short response: \"2500-5.1.1 fail\""
  assert_eq rr("99  lead\r\n99xhello world\n99x5.1.1 fail", 5), "ERR invalid response code: \"99  lead\""
  assert_eq rr("1234  lead\n", 1), "ERR short response: \"1234  lead\""
  assert_eq rr("free text\nfree text\nfree text\nfree text\r", 220), "ERR short response: \"free text\""
  assert_eq rr("1234x5.1.1 fail\n", 250), "ERR short response: \"1234x5.1.1 fail\""
  assert_eq rr("abchello world", 4), "ERR short response: \"abchello world\""
  assert_eq rr("free text\r\nhello world\n99x\n220hello world\n", 5), "ERR short response: \"free text\""
  assert_eq rr("2500 hello world", 22), "ERR short response: \"2500 hello world\""
  assert_eq rr("250xhello world\n550 hello world\nfree text\n ok\r", 250), "ERR short response: \"250xhello world\""
  assert_eq rr("free text\n2500-ok\n250-ok\r\n", 0), "ERR short response: \"free text\""
  assert_eq rr("2500 5.1.1 fail\r\n220hello world\r\n", 0), "ERR short response: \"2500 5.1.1 fail\""
  assert_eq rr("1234ok\n550hello world\n550 ok\r\n", 250), "ERR short response: \"1234ok\""
  assert_eq rr("abc-5.1.1 fail\n550  lead\nx lead\n", 550), "EOF"
  assert_eq rr("1234x lead", 25), "ERR short response: \"1234x lead\""
  assert_eq rr("250 ok\r\nfree text\n550ok\r\n220 5.1.1 fail\n", 2), "250|ok"
  assert_eq rr("99 \r\n1234 \n2500 lead\r\n2500x5.1.1 fail\r", 4), "ERR short response: \"99 \""
  assert_eq rr("550-5.1.1 fail\r\n", 5), "EOF"
  assert_eq rr("250-5.1.1 fail\n2500x\r\n220x5.1.1 fail\n", 2), "EOF"
}

test "vectors: response 1" {
  assert_eq rr("550\r\n99-\r\n", 1), "ERR short response: \"550\""
  assert_eq rr("free text\n ok\n", 220), "ERR short response: \"free text\""
  assert_eq rr("free text\n", 220), "ERR short response: \"free text\""
  assert_eq rr("-\n250xhello world\r", 2), "ERR short response: \"-\""
  assert_eq rr("abc 5.1.1 fail\n99\n1234  lead\n", 220), "ERR invalid response code: \"abc 5.1.1 fail\""
  assert_eq rr("12345.1.1 fail\n1234 hello world\r\n99-hello world\r\n", 2), "ERR short response: \"12345.1.1 fail\""
  assert_eq rr(" 5.1.1 fail\r\n1234- lead\r\n2500ok\n", 220), "ERR short response: \" 5.1.1 fail\""
  assert_eq rr("xok\n2500  lead\nfree text\r\n", 2), "ERR short response: \"xok\""
  assert_eq rr("220  lead\n1234xok\r\n99 hello world\n", 5), "CODE 220| lead"
  assert_eq rr("abc-\nfree text", 25), "EOF"
  assert_eq rr("2500xok\nabc\r\n1234xok\n-\n", 22), "ERR short response: \"2500xok\""
  assert_eq rr("1234hello world\r\n220  lead", 4), "ERR short response: \"1234hello world\""
  assert_eq rr("550xok\r\nabc-ok\n250  lead\n", 250), "ERR short response: \"550xok\""
  assert_eq rr("220-ok\n", 4), "EOF"
  assert_eq rr("abcxok\nfree text", 550), "ERR short response: \"abcxok\""
  assert_eq rr("free text\r\n2500xok\n1234 5.1.1 fail\n220hello world\n", 550), "ERR short response: \"free text\""
  assert_eq rr(" \n2500x\n", 25), "ERR short response: \" \""
  assert_eq rr("2500-5.1.1 fail\r\n1234-5.1.1 fail\r\nok\n", 2), "ERR short response: \"2500-5.1.1 fail\""
  assert_eq rr("free text\nabc\n2500 5.1.1 fail\n", 250), "ERR short response: \"free text\""
  assert_eq rr("220x\nx lead\r\n99 ok\n", 550), "ERR short response: \"220x\""
  assert_eq rr("550 \nfree text\n220xhello world\n", 550), "550|"
  assert_eq rr("99 \nfree text\nhello world", 2), "ERR short response: \"99 \""
  assert_eq rr("220 hello world\n2500-\r\n2500 \nfree text\r\n", 220), "220|hello world"
  assert_eq rr("99 hello world\n", 2), "ERR short response: \"99 hello world\""
  assert_eq rr(" 5.1.1 fail", 4), "ERR short response: \" 5.1.1 fail\""
  assert_eq rr("550 ok\n", 2), "CODE 550|ok"
  assert_eq rr("2500 hello world\r\n220 lead\n\r\n1234 hello world\n", 0), "ERR short response: \"2500 hello world\""
  assert_eq rr("free text\r\nabc-5.1.1 fail\n220-ok\r", 550), "ERR short response: \"free text\""
  assert_eq rr("abcxok\n99-5.1.1 fail\n550 ok\n", 0), "ERR short response: \"abcxok\""
  assert_eq rr("550-ok\n250- lead\nfree text\n", 4), "EOF"
  assert_eq rr("220 hello world\n", 0), "220|hello world"
  assert_eq rr("2500 \n", 250), "ERR short response: \"2500 \""
  assert_eq rr("x5.1.1 fail\r\n", 25), "ERR short response: \"x5.1.1 fail\""
  assert_eq rr("free text\n\r\n2505.1.1 fail\n1234 \n", 2), "ERR short response: \"free text\""
  assert_eq rr("ok", 250), "ERR short response: \"ok\""
  assert_eq rr("99 ok\r\nfree text\nabc-5.1.1 fail\n", 2), "ERR short response: \"99 ok\""
  assert_eq rr("550xok\n99 lead\nabc 5.1.1 fail\nx5.1.1 fail\r", 0), "ERR short response: \"550xok\""
  assert_eq rr("250-5.1.1 fail\nfree text\n", 550), "EOF"
  assert_eq rr("-5.1.1 fail\r\n1234 5.1.1 fail\n99x", 550), "ERR short response: \"-5.1.1 fail\""
  assert_eq rr("99x\n", 4), "ERR short response: \"99x\""
  assert_eq rr("99 lead\r\nabc \n2505.1.1 fail\n", 1), "ERR short response: \"99 lead\""
  assert_eq rr("free text\n", 25), "ERR short response: \"free text\""
  assert_eq rr("99x5.1.1 fail\r\nfree text\r\n", 250), "ERR short response: \"99x5.1.1 fail\""
  assert_eq rr("250 ok\n550xok\r\nfree text\r\nfree text", 22), "CODE 250|ok"
  assert_eq rr("220 ok\n99-5.1.1 fail\n", 5), "CODE 220|ok"
  assert_eq rr("2500ok\r\nfree text\r\n lead\r\n", 2), "ERR short response: \"2500ok\""
  assert_eq rr("550- lead\n", 2), "EOF"
  assert_eq rr("abc hello world\n99-hello world\n1234-\nfree text\n", 0), "ERR invalid response code: \"abc hello world\""
  assert_eq rr("220-hello world\r\nfree text\n550 5.1.1 fail\n", 4), "EOF"
  assert_eq rr("220-hello world\n550 ok\r\n1234-hello world", 220), "EOF"
  assert_eq rr("220  lead\r\n99x lead\n550 ok\n\r\n", 250), "CODE 220| lead"
  assert_eq rr("free text\r\n", 5), "ERR short response: \"free text\""
  assert_eq rr("550 ok\n", 220), "CODE 550|ok"
  assert_eq rr("99-ok", 25), "ERR short response: \"99-ok\""
  assert_eq rr("abc\n", 25), "ERR short response: \"abc\""
  assert_eq rr("2500xhello world\nhello world\r\n99hello world", 22), "ERR short response: \"2500xhello world\""
  assert_eq rr("free text\n220 ok\r", 220), "ERR short response: \"free text\""
  assert_eq rr("250  lead\n550\r", 0), "250| lead"
  assert_eq rr("550-\n2500 hello world", 5), "EOF"
  assert_eq rr("250-ok\n-hello world\n550-hello world\r\n", 2), "EOF"
  assert_eq rr("free text\r\n550x\r\nfree text\nfree text\n", 25), "ERR short response: \"free text\""
  assert_eq rr("25005.1.1 fail\nx5.1.1 fail\r\n250x lead\r\n2500 5.1.1 fail\n", 25), "ERR short response: \"25005.1.1 fail\""
  assert_eq rr("2500x lead\nfree text\n550 5.1.1 fail\n", 2), "ERR short response: \"2500x lead\""
  assert_eq rr("free text\nfree text\r\nabc  lead\n", 250), "ERR short response: \"free text\""
  assert_eq rr("abc ok\n550ok\n", 250), "ERR invalid response code: \"abc ok\""
  assert_eq rr("free text\n lead\n", 220), "ERR short response: \"free text\""
  assert_eq rr("abcok\n550-\n", 5), "ERR short response: \"abcok\""
  assert_eq rr("1234  lead\r\nfree text\n2500 hello world\n", 22), "ERR short response: \"1234  lead\""
  assert_eq rr("550x5.1.1 fail\r\n550- lead\r\n", 550), "ERR short response: \"550x5.1.1 fail\""
  assert_eq rr("free text\r\n", 4), "ERR short response: \"free text\""
  assert_eq rr("abchello world\n5.1.1 fail\r\nxok\n250x lead\r\n", 4), "ERR short response: \"abchello world\""
  assert_eq rr("free text\n99x5.1.1 fail\n250 hello world\n", 5), "ERR short response: \"free text\""
  assert_eq rr("free text\nabcok\n250xok\n", 2), "ERR short response: \"free text\""
  assert_eq rr("free text\nfree text\n995.1.1 fail\r\n550-hello world\n", 2), "ERR short response: \"free text\""
  assert_eq rr("2505.1.1 fail\n220x lead\nfree text\nfree text\r\n", 0), "ERR short response: \"2505.1.1 fail\""
  assert_eq rr("2500-\n 5.1.1 fail\nfree text\r\n2500-hello world\n", 220), "ERR short response: \"2500-\""
  assert_eq rr("220hello world\r\nx5.1.1 fail\n", 25), "ERR short response: \"220hello world\""
  assert_eq rr("220ok\nabc \nxhello world\nabc 5.1.1 fail", 550), "ERR short response: \"220ok\""
  assert_eq rr("99  lead\n550 5.1.1 fail\n", 1), "ERR invalid response code: \"99  lead\""
  assert_eq rr("2500-ok\r\nfree text\r\n2500 5.1.1 fail\n", 0), "ERR short response: \"2500-ok\""
  assert_eq rr("free text\n", 1), "ERR short response: \"free text\""
  assert_eq rr("2500-hello world\n2500-\r\nx lead\n", 250), "ERR short response: \"2500-hello world\""
  assert_eq rr("550-ok\n250 ok\n", 0), "EOF"
  assert_eq rr("2500xhello world\nok\n", 250), "ERR short response: \"2500xhello world\""
  assert_eq rr("xhello world\nabc- lead\r\n", 550), "ERR short response: \"xhello world\""
  assert_eq rr("220hello world\n5505.1.1 fail\r\n", 22), "ERR short response: \"220hello world\""
  assert_eq rr("99x\r\n", 220), "ERR short response: \"99x\""
  assert_eq rr("2500-ok\r\n2500x\nfree text\n", 5), "ERR short response: \"2500-ok\""
  assert_eq rr("99ok\nabc- lead\n1234 hello world\n", 550), "ERR short response: \"99ok\""
  assert_eq rr("free text\n", 4), "ERR short response: \"free text\""
  assert_eq rr("550-\n250-hello world\r\n99x5.1.1 fail\r\n", 2), "EOF"
  assert_eq rr("free text\n220x lead\r\nfree text\r\n", 2), "ERR short response: \"free text\""
  assert_eq rr("1234x\r", 0), "ERR short response: \"1234x\\r\""
  assert_eq rr("99x5.1.1 fail\n2500 \r\n550xok\r\n", 22), "ERR short response: \"99x5.1.1 fail\""
  assert_eq rr("abcx lead\r\n1234  lead\n", 250), "ERR short response: \"abcx lead\""
  assert_eq rr("12345.1.1 fail\r\nfree text\r\n1234x\n", 0), "ERR short response: \"12345.1.1 fail\""
  assert_eq rr("free text\r\n1234 hello world\n hello world\r\n250ok\r\n", 25), "ERR short response: \"free text\""
  assert_eq rr("220x\r\n250 hello world\n99\n", 550), "ERR short response: \"220x\""
}

test "vectors: response 2" {
  assert_eq rr("250 5.1.1 fail\r\n250x lead\r\n", 550), "CODE 250|5.1.1 fail"
  assert_eq rr("free text\r\n99 \nabcx5.1.1 fail\n2500x lead\r\n", 25), "ERR short response: \"free text\""
  assert_eq rr("550-\r\n", 5), "EOF"
  assert_eq rr("550- lead\r", 22), "EOF"
  assert_eq rr("220-5.1.1 fail\n25005.1.1 fail", 220), "EOF"
  assert_eq rr("550 5.1.1 fail\r\n550 lead\r\nfree text\r", 0), "550|5.1.1 fail"
  assert_eq rr("550 5.1.1 fail\r\n2500 ok\r", 550), "550|5.1.1 fail"
  assert_eq rr("xok\r\n2500  lead\n220 5.1.1 fail\n", 250), "ERR short response: \"xok\""
  assert_eq rr("220x5.1.1 fail\nfree text\nfree text", 5), "ERR short response: \"220x5.1.1 fail\""
  assert_eq rr("550-ok\nabc 5.1.1 fail\r\n2500ok\r\nabc-ok", 250), "EOF"
  assert_eq rr("xok\n2205.1.1 fail\n25005.1.1 fail\n", 25), "ERR short response: \"xok\""
  assert_eq rr("hello world\r\n1234ok\r\n- lead\n", 250), "ERR short response: \"hello world\""
  assert_eq rr("xhello world\n", 1), "ERR short response: \"xhello world\""
  assert_eq rr("1234 hello world\nfree text", 220), "ERR short response: \"1234 hello world\""
  assert_eq rr("2500xok\r\nfree text\r\nabc \n1234 ok\n", 250), "ERR short response: \"2500xok\""
  assert_eq rr("250\n2500xok\r\nabc ok\r\nxhello world\n", 4), "ERR short response: \"250\""
  assert_eq rr("220 ok\r", 220), "220|ok\r"
  assert_eq rr("250x5.1.1 fail\r", 250), "ERR short response: \"250x5.1.1 fail\\r\""
  assert_eq rr("550-5.1.1 fail\n2500 hello world\n2500  lead\r", 220), "EOF"
  assert_eq rr("free text\n550-\r\n1234 hello world\n", 22), "ERR short response: \"free text\""
  assert_eq rr("free text\n250ok\n", 1), "ERR short response: \"free text\""
  assert_eq rr("abc-hello world", 250), "EOF"
  assert_eq rr("free text\r\n250-\r\n", 220), "ERR short response: \"free text\""
  assert_eq rr("250 hello world\r\n", 2), "250|hello world"
  assert_eq rr("abc\n995.1.1 fail\nfree text\n", 22), "ERR short response: \"abc\""
  assert_eq rr("220-hello world\nabc5.1.1 fail\nfree text\r\n2500  lead\r", 4), "EOF"
  assert_eq rr("2500 ok", 4), "ERR short response: \"2500 ok\""
  assert_eq rr("99x\r\nx\n", 2), "ERR short response: \"99x\""
  assert_eq rr("220 ok\n1234-5.1.1 fail\r\n", 1), "CODE 220|ok"
  assert_eq rr("free text\n250\r\n550-\n", 4), "ERR short response: \"free text\""
  assert_eq rr(" lead\n220xok\nfree text\nabc ok\r\n", 4), "ERR short response: \" lead\""
  assert_eq rr("220hello world\r\n220 5.1.1 fail\nabc-5.1.1 fail\r", 0), "ERR short response: \"220hello world\""
  assert_eq rr("99 \n550 lead\r\n2500 lead\n", 2), "ERR short response: \"99 \""
  assert_eq rr("220xok\n1234ok\nok\r\n", 25), "ERR short response: \"220xok\""
  assert_eq rr("2500ok\nabc-hello world\nabc- lead\n", 5), "ERR short response: \"2500ok\""
  assert_eq rr("220-hello world\n1234xhello world\n99  lead\nfree text\r\n", 250), "EOF"
  assert_eq rr("5505.1.1 fail\n", 5), "ERR short response: \"5505.1.1 fail\""
  assert_eq rr("1234 5.1.1 fail\n", 5), "ERR short response: \"1234 5.1.1 fail\""
  assert_eq rr("abc 5.1.1 fail\n220 lead\n2500  lead\r\n", 22), "ERR invalid response code: \"abc 5.1.1 fail\""
  assert_eq rr("free text\r\n550- lead\nabcx5.1.1 fail\nfree text", 550), "ERR short response: \"free text\""
  assert_eq rr("2500 lead\r\n2500x\n1234-ok\n", 22), "ERR short response: \"2500 lead\""
  assert_eq rr("ok\r\n220x\n1234 5.1.1 fail\n", 1), "ERR short response: \"ok\""
  assert_eq rr("free text\n99-\n250xok\r\n", 1), "ERR short response: \"free text\""
  assert_eq rr("1234 hello world\n250xok", 2), "ERR short response: \"1234 hello world\""
  assert_eq rr(" hello world\r\n", 2), "ERR short response: \" hello world\""
  assert_eq rr("-ok\n-hello world\r\n2500x5.1.1 fail\nfree text\n", 4), "ERR short response: \"-ok\""
  assert_eq rr("99 lead\r\n99 \n", 250), "ERR short response: \"99 lead\""
  assert_eq rr("99xok\n", 1), "ERR short response: \"99xok\""
  assert_eq rr("-hello world\n1234 lead\r", 1), "ERR short response: \"-hello world\""
  assert_eq rr("abc 5.1.1 fail\n2500-\r\n", 220), "ERR invalid response code: \"abc 5.1.1 fail\""
  assert_eq rr("220-ok\n1234 hello world\nabc-\r\nfree text\r\n", 4), "EOF"
  assert_eq rr("2500hello world\r\n99hello world\n2500- lead\n", 220), "ERR short response: \"2500hello world\""
  assert_eq rr("free text\r\nfree text\n250 hello world\n550  lead\r\n", 5), "ERR short response: \"free text\""
  assert_eq rr("250-hello world\nfree text", 550), "EOF"
  assert_eq rr("2500-5.1.1 fail\r", 220), "ERR short response: \"2500-5.1.1 fail\\r\""
  assert_eq rr("550-hello world\r\n", 0), "EOF"
  assert_eq rr("2500- lead\n5.1.1 fail\r\n 5.1.1 fail\n1234-5.1.1 fail\r\n", 220), "ERR short response: \"2500- lead\""
  assert_eq rr("99 hello world\n", 220), "ERR short response: \"99 hello world\""
  assert_eq rr("free text\r\n220hello world\r\nabc5.1.1 fail\n", 220), "ERR short response: \"free text\""
  assert_eq rr("99x lead\n", 250), "ERR invalid response code: \"99x lead\""
  assert_eq rr(" ok\n", 2), "ERR short response: \" ok\""
  assert_eq rr("220x\r\n1234x5.1.1 fail\r\n\n99ok\r\n", 22), "ERR short response: \"220x\""
  assert_eq rr("995.1.1 fail\r\n220 hello world\n250 lead\r\n", 4), "ERR short response: \"995.1.1 fail\""
  assert_eq rr("abchello world\n2500 hello world\n250x lead", 1), "ERR short response: \"abchello world\""
  assert_eq rr("2500-ok\n1234- lead\n", 22), "ERR short response: \"2500-ok\""
  assert_eq rr("free text\n250-5.1.1 fail\n2500-\n5505.1.1 fail\n", 2), "ERR short response: \"free text\""
  assert_eq rr("220  lead\nfree text\n1234  lead", 4), "CODE 220| lead"
  assert_eq rr("220 \nabcx lead\n", 5), "CODE 220|"
  assert_eq rr("1234x5.1.1 fail\n", 4), "ERR short response: \"1234x5.1.1 fail\""
  assert_eq rr("99- lead\r\n", 5), "ERR invalid response code: \"99- lead\""
  assert_eq rr("free text\n220 5.1.1 fail\r\n", 550), "ERR short response: \"free text\""
  assert_eq rr("550xhello world\nabc hello world\nxhello world", 22), "ERR short response: \"550xhello world\""
  assert_eq rr("2500x5.1.1 fail\n2500  lead\n", 250), "ERR short response: \"2500x5.1.1 fail\""
  assert_eq rr("free text\r\n", 0), "ERR short response: \"free text\""
  assert_eq rr("free text\n99-5.1.1 fail\n99x lead\n", 550), "ERR short response: \"free text\""
  assert_eq rr("250xhello world\nabcx lead\r", 1), "ERR short response: \"250xhello world\""
  assert_eq rr("220xhello world\n2500ok\r\n", 550), "ERR short response: \"220xhello world\""
  assert_eq rr("250 5.1.1 fail\n1234x5.1.1 fail\r\n220xok\n250 5.1.1 fail", 22), "CODE 250|5.1.1 fail"
  assert_eq rr("free text\r\nabcx\n99ok\nfree text", 0), "ERR short response: \"free text\""
  assert_eq rr("free text\n 5.1.1 fail\r\n", 0), "ERR short response: \"free text\""
  assert_eq rr("abc- lead\n", 25), "EOF"
  assert_eq rr("250x lead\r\n2500 hello world\n550x lead\r\nabc  lead", 22), "ERR short response: \"250x lead\""
  assert_eq rr("free text\r\n220x5.1.1 fail\n550-hello world\r\n250hello world\r\n", 5), "ERR short response: \"free text\""
  assert_eq rr("free text\r\n220ok\r\nx lead\n", 1), "ERR short response: \"free text\""
  assert_eq rr("220-ok\r\n250x5.1.1 fail\n", 4), "EOF"
  assert_eq rr("1234 5.1.1 fail\n99hello world\r\n550x lead\r\n250xhello world", 25), "ERR short response: \"1234 5.1.1 fail\""
  assert_eq rr("1234 hello world\nfree text\n", 250), "ERR short response: \"1234 hello world\""
  assert_eq rr("free text\n220ok\r\n-hello world\n", 220), "ERR short response: \"free text\""
  assert_eq rr("1234x5.1.1 fail\nfree text\nx lead\n", 1), "ERR short response: \"1234x5.1.1 fail\""
  assert_eq rr("995.1.1 fail\n", 1), "ERR short response: \"995.1.1 fail\""
  assert_eq rr("free text\nabc-\nabc \r\n1234xhello world\n", 550), "ERR short response: \"free text\""
  assert_eq rr("abc hello world\nxok\nfree text\r\n", 4), "ERR invalid response code: \"abc hello world\""
  assert_eq rr("1234  lead\nfree text\nabcx5.1.1 fail\nfree text\r\n", 1), "ERR short response: \"1234  lead\""
  assert_eq rr("220\n1234 \n", 2), "ERR short response: \"220\""
  assert_eq rr("2500\n220-5.1.1 fail\n99xok\n", 1), "ERR short response: \"2500\""
  assert_eq rr("550x lead\r\nabc- lead\n550- lead\r\n", 22), "ERR short response: \"550x lead\""
  assert_eq rr("220hello world\n550ok\r\n-hello world", 1), "ERR short response: \"220hello world\""
  assert_eq rr("abc-\r", 1), "EOF"
  assert_eq rr("2500 5.1.1 fail\n250  lead\r\n", 2), "ERR short response: \"2500 5.1.1 fail\""
}

test "vectors: response 3" {
  assert_eq rr("550ok\n", 25), "ERR short response: \"550ok\""
