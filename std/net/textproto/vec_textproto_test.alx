  assert_eq cont("foo bar : x y z\r\n\tx y z\r\n\nbody"), "<foo bar : x y z x y z><><body>"
  assert_eq cont("foo bar :\t  trailing  \r\nfoo bar : \rfoo bar :: v \r\n :\x7f\r\n  \t v \r\n\r\n"), "<foo bar :\t  trailing><foo bar : \rfoo bar :: v :\x7f v><>"
  assert_eq cont("\t:\r\nCONTENT-type :\r\n\r\n"), "<:><CONTENT-type :><>"
