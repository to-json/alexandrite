  assert_eq cont("X\r\n\nbody"), "<X><><body>"
  assert_eq cont("k$1\r"), "<k$1\r>"
  assert_eq cont("foo bar : v\r\n  \tv\ré:   trailing  \n v\r\nmy-key: v \r\n  \t1\r\nX::  trailing  \r\n\r\n"), "<foo bar : v v\ré:   trailing v><my-key: v 1><X::  trailing><>"
  assert_eq cont("Foo\tBar\t:é\n:a\tb\r\n \x7f\n\nbody"), "<Foo\tBar\t:é><:a\tb \x7f><><body>"
  assert_eq cont("Foo\tBar:\té\r\nmy-key :v\n\n"), "<Foo\tBar:\té><my-key :v><>"
  assert_eq cont(":   trailing  \n v\r\n"), "<:   trailing v>"
  assert_eq cont(": 1\r\nFoo:\t\x01\r\né:  v \n\r\nbody"), "<: 1><Foo:\t\x01><é:  v><><body>"
  assert_eq cont("foo bar \t:\x01\r  \t\r\né:\r\n\ta\tb\r\né\t: v \r\t:\x7f\r\n  \t v \r\r\n"), "<foo bar \t:\x01\r><é: a\tb><é\t: v \r\t:\x7f v \r>"
  assert_eq cont("foo bar :é\n\r\n"), "<foo bar :é><>"
  assert_eq cont(":\t v \n  v \r\n\n"), "<:\t v v><>"
  assert_eq cont("foo bar \rX\t:v\n\nbody"), "<foo bar \rX\t:v><><body>"
  assert_eq cont("X: a\tb\r\n  \t1\r\né:\tx y z\n:\x01\r\n\r\nbody"), "<X: a\tb 1><é:\tx y z><:\x01><><body>"
  assert_eq cont("a-1-c::v\n: \x01\r\nk$::x y z\ré:\tv\r\r\n"), "<a-1-c::v><: \x01><k$::x y z\ré:\tv\r>"
  assert_eq cont("Foo:\t1\r\n\r\n"), "<Foo:\t1><>"
