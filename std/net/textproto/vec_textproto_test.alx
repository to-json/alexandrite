  assert_eq dotb("...\r\n...\r.\r\n"), "ERR unexpected EOF"
  assert_eq dotb("a\r\n"), "ERR unexpected EOF"
  assert_eq dotb(" x.y\n"), "ERR unexpected EOF"
  assert_eq dotb("\r\n.\r\nx.yx.y"), "\n"
  assert_eq dotb(".ax.y "), "ERR unexpected EOF"
  assert_eq dotb("a\r...x.y"), "ERR unexpected EOF"
  assert_eq dotb("\n.a\r"), "ERR unexpected EOF"
  assert_eq dotb(".\r\n\r\n \r\n.\n"), ""
  assert_eq dotb("\r\n\ra"), "ERR unexpected EOF"
  assert_eq dotb("\r\na.."), "ERR unexpected EOF"
  assert_eq dotb("a....\n"), "ERR unexpected EOF"
  assert_eq dotb("...\r\n \r\n.\nx.y\r\n"), "..\n \n"
  assert_eq dotb("x.ya\n"), "ERR unexpected EOF"
  assert_eq dotb("a..."), "ERR unexpected EOF"
  assert_eq dotb(" \n"), "ERR unexpected EOF"
  assert_eq dotb("\r.\n\n\r\n x.y"), "ERR unexpected EOF"
  assert_eq dotb(".\r\n\nx.y\r"), ""
  assert_eq dotb(".\na\nx.y."), ""
  assert_eq dotb("\n.\r\n.\r\n"), "\n.\n"
  assert_eq dotb(".\n.\n.."), ""
  assert_eq dotb(".. .\n\n...."), "ERR unexpected EOF"
  assert_eq dotb("x.y\r\n.\n\r\n."), "x.y\n"
  assert_eq dotb("\r\n.\nx.y"), "\n"
  assert_eq dotb("a.\r\n.\r\n..\n"), "a.\n"
  assert_eq dotb("..\r...\r\na.\n"), "ERR unexpected EOF"
  assert_eq dotb("x.y\r\n.\n\r\n.\n"), "x.y\n"
  assert_eq dotb("\r\n\r\r\naaa"), "ERR unexpected EOF"
  assert_eq dotb(".\r\n.\n\r  .\r\n."), ""
  assert_eq dotb(".\n.. "), ""
  assert_eq dotb("\n\n.x.y"), "ERR unexpected EOF"
  assert_eq dotb("\r\n\r\n. "), "ERR unexpected EOF"
  assert_eq dotb(".\r\n\n .\n\r\n\r\n"), ""
  assert_eq dotb(".\r\n..\r\n"), ""
  assert_eq dotb(".. \r\n.\n  "), ". \n"
  assert_eq dotb("x.y\r..x.y\n"), "ERR unexpected EOF"
  assert_eq dotb(".\r\n\n.a a"), ""
  assert_eq dotb(".\n.\r\na"), ""
  assert_eq dotb(" .x.y.\r\n\r"), "ERR unexpected EOF"
  assert_eq dotb("\n\r\n .\n....\n"), "ERR unexpected EOF"
  assert_eq dotb("..\r\n\r\n \na"), "ERR unexpected EOF"
  assert_eq dotb("\ra.\r\n x.y\n"), "ERR unexpected EOF"
  assert_eq dotb("\r.\r\nx.yx.yx.y"), "ERR unexpected EOF"
  assert_eq dotb("a  \n "), "ERR unexpected EOF"
  assert_eq dotb(".. \r..  .."), "ERR unexpected EOF"
  assert_eq dotb("\r\n\nx.y ..\r\n.."), "ERR unexpected EOF"
  assert_eq dotb(".\na"), ""
  assert_eq dotb(".\n\r\n\naa\r\n"), ""
  assert_eq dotb("....\rx.yx.y."), "ERR unexpected EOF"
  assert_eq dotb("x.y\nx.y"), "ERR unexpected EOF"
  assert_eq dotb("aa.\r\nx.y.\r\n\r"), "ERR unexpected EOF"
  assert_eq dotb(".. ..\na\n\n"), "ERR unexpected EOF"
  assert_eq dotb("x.yx.y\r\n.\nx.y\n"), "x.yx.y\n"
  assert_eq dotb(".\na..x.y"), ""
  assert_eq dotb(" \r\nx.y"), "ERR unexpected EOF"
  assert_eq dotb("a\r\n..\r\nx.y"), "ERR unexpected EOF"
  assert_eq dotb(" .\r\n"), "ERR unexpected EOF"
  assert_eq dotb(". x.y"), "ERR unexpected EOF"
  assert_eq dotb(" .. x.y.x.y\r\n"), "ERR unexpected EOF"
  assert_eq dotb("\r.\n.\n\n.\r\n.\r\nx.y"), "\r.\n"
  assert_eq dotb(" x.yx.y.\r\n"), "ERR unexpected EOF"
  assert_eq dotb("x.ya.\n\ra"), "ERR unexpected EOF"
  assert_eq dotb("x.y ..\n...\n"), "ERR unexpected EOF"
  assert_eq dotb("x.ya.\n\n.. ."), "ERR unexpected EOF"
  assert_eq dotb(".\n\r. .\n"), ""
  assert_eq dotb("a\r\r.\r ."), "ERR unexpected EOF"
  assert_eq dotb("a.\n"), "ERR unexpected EOF"
  assert_eq dotb("x.ya.\r\n.ax.y.."), "ERR unexpected EOF"
  assert_eq dotb("\r\na\n.\n"), "\na\n"
  assert_eq dotb(".\n\r\n"), ""
  assert_eq dotb("x.ya\r\r\na\n "), "ERR unexpected EOF"
}

test "vectors: dot lines 0" {
  assert_eq dotl("\r\n\r\r\n\r\n\na\r"), "ERR unexpected EOF"
  assert_eq dotl(" "), "ERR unexpected EOF"
  assert_eq dotl("\n"), "ERR unexpected EOF"
  assert_eq dotl("\n "), "ERR unexpected EOF"
  assert_eq dotl("x.y"), "ERR unexpected EOF"
  assert_eq dotl(""), "ERR unexpected EOF"
  assert_eq dotl("a..\r\na"), "ERR unexpected EOF"
  assert_eq dotl("\r\n\n.\r\n.\r\nx.y.\r\n\n"), "|"
  assert_eq dotl(".\r\n....\r x.y"), ""
  assert_eq dotl(".."), "ERR unexpected EOF"
  assert_eq dotl("..\nx.y "), "ERR unexpected EOF"
  assert_eq dotl(".a "), "ERR unexpected EOF"
  assert_eq dotl("\n..a.\r\n.\r\n.\n"), "|.a."
  assert_eq dotl("a"), "ERR unexpected EOF"
  assert_eq dotl("\ra\r\n.\r\na \n"), "\ra"
  assert_eq dotl("\n\r\n.\r\n"), "|"
  assert_eq dotl("x.yx.y\r\n "), "ERR unexpected EOF"
  assert_eq dotl("x.y\r\n.."), "ERR unexpected EOF"
  assert_eq dotl("\n .\na"), "ERR unexpected EOF"
  assert_eq dotl("\n...\r\n\r\n\na"), "ERR unexpected EOF"
  assert_eq dotl("a.\n"), "ERR unexpected EOF"
  assert_eq dotl(".\na"), ""
  assert_eq dotl("...x.y "), "ERR unexpected EOF"
  assert_eq dotl(".x.y "), "ERR unexpected EOF"
  assert_eq dotl(".\r\n"), ""
  assert_eq dotl("x.y.\r\n"), "ERR unexpected EOF"
  assert_eq dotl("....\r\n\r"), "ERR unexpected EOF"
  assert_eq dotl(".\n"), ""
  assert_eq dotl(".\n...\r\nx.yx.y.\r"), ""
  assert_eq dotl("\n.\n\n.\nx.yx.y"), ""
  assert_eq dotl("a.\n.\r"), "ERR unexpected EOF"
  assert_eq dotl(".\n.\n\n...\r\r"), ""
  assert_eq dotl(".\nx.yx.y\n  a"), ""
  assert_eq dotl(" \n.."), "ERR unexpected EOF"
  assert_eq dotl(".\r\na"), ""
  assert_eq dotl(".x.y"), "ERR unexpected EOF"
  assert_eq dotl("x.y  ..\n "), "ERR unexpected EOF"
  assert_eq dotl("a "), "ERR unexpected EOF"
  assert_eq dotl("\r.\r\n\r\n..\r\n.\n"), "\r.||."
  assert_eq dotl("x.y \r"), "ERR unexpected EOF"
  assert_eq dotl("\n\r\n"), "ERR unexpected EOF"
  assert_eq dotl("x.y\nx.yx.y.\nx.y"), "ERR unexpected EOF"
  assert_eq dotl("\r\r\n"), "ERR unexpected EOF"
  assert_eq dotl(".\r\nx.y\r"), ""
  assert_eq dotl(".\r\naa\r\n\n"), ""
  assert_eq dotl("\r\na"), "ERR unexpected EOF"
  assert_eq dotl("\r"), "ERR unexpected EOF"
  assert_eq dotl(" ..\r\n \rx.y"), "ERR unexpected EOF"
  assert_eq dotl(".\r\n\n\r\n\r\n.\n"), ""
  assert_eq dotl(".\r\n.\n\r\n"), ""
  assert_eq dotl("\r\n.\r\nx.y.\r\n.\r\nx.y"), ""
  assert_eq dotl(" \n \r\n."), " | "
  assert_eq dotl(".\n..x.y.\r\na"), ""
  assert_eq dotl(".\r\n..\n.\n"), ""
  assert_eq dotl(".....\n.\r\n..x.yx.y"), "...."
  assert_eq dotl("x.y\r.\r\n\r\nx.y"), "ERR unexpected EOF"
  assert_eq dotl(".\r\n.\nx.y a.. "), ""
  assert_eq dotl(".\r\n\r\n .\n.\n"), ""
  assert_eq dotl("a.\r\n.\n"), "a."
  assert_eq dotl("\r\nx.y.\n\rx.y.."), "ERR unexpected EOF"
  assert_eq dotl("\n x.y.\r\n"), "ERR unexpected EOF"
  assert_eq dotl("\r.\n.\r\r"), "ERR unexpected EOF"
  assert_eq dotl("\r....x.y\r\na"), "ERR unexpected EOF"
  assert_eq dotl("\r\na...\r\n.\n.."), "|a..."
  assert_eq dotl(".\r"), "ERR unexpected EOF"
  assert_eq dotl(" \nx.y.....\r"), "ERR unexpected EOF"
  assert_eq dotl(".\r\n\r\n"), ""
  assert_eq dotl("\n\n\nx.y.\r\n.\n."), "|||x.y."
  assert_eq dotl("\r\n\r\n "), "ERR unexpected EOF"
  assert_eq dotl(".\n..\r...\n\r"), ""
  assert_eq dotl("\n.\r\n\r.\n"), ""
  assert_eq dotl(" .\n..  ..\n"), "ERR unexpected EOF"
  assert_eq dotl("\r..\na"), "ERR unexpected EOF"
  assert_eq dotl(".\r\n\r\n\n\n.\r\nx.y.."), ""
  assert_eq dotl(".\n..\n.\r\n.\r\n"), ""
}

test "vectors: dot lines 1" {
  assert_eq dotl(".\n..\r\nx.y\rx.y.."), ""
  assert_eq dotl("\n ..\nx.y\n"), "ERR unexpected EOF"
  assert_eq dotl("a .\r\n.\r\n"), "a ."
  assert_eq dotl(" a.\r\n\na.\n"), "ERR unexpected EOF"
  assert_eq dotl("a\n.x.y.\n\n"), "ERR unexpected EOF"
  assert_eq dotl("ax.y.\n.\n..\r\r"), "ax.y."
  assert_eq dotl("x.y \r\r...."), "ERR unexpected EOF"
  assert_eq dotl("\r\n\n\r\nx.y \r\n"), "ERR unexpected EOF"
  assert_eq dotl(".\n.. "), ""
  assert_eq dotl(".. "), "ERR unexpected EOF"
  assert_eq dotl("aa.\n\r\rx.y"), "ERR unexpected EOF"
  assert_eq dotl("a.."), "ERR unexpected EOF"
  assert_eq dotl(" .\r\na"), "ERR unexpected EOF"
  assert_eq dotl("..\r\n.\r\n.\r\n.\r"), "."
  assert_eq dotl("a\n\n.\r\n\r\n.\r\n\r\n"), "a|"
  assert_eq dotl("\r\n\n\n "), "ERR unexpected EOF"
  assert_eq dotl("\n\n\r"), "ERR unexpected EOF"
  assert_eq dotl("a   \n.\r\n"), "a   "
  assert_eq dotl(" \r\n\r.\naa"), "ERR unexpected EOF"
  assert_eq dotl("..a\n..a\n"), "ERR unexpected EOF"
  assert_eq dotl("\r\n"), "ERR unexpected EOF"
  assert_eq dotl("x.ya\r\nx.y\r\n\n"), "ERR unexpected EOF"
  assert_eq dotl("a.\r\nx.y"), "ERR unexpected EOF"
  assert_eq dotl("  a \r\r"), "ERR unexpected EOF"
  assert_eq dotl(".\n.\n\n"), ""
  assert_eq dotl("..\r\n...\n.."), "ERR unexpected EOF"
  assert_eq dotl("aa"), "ERR unexpected EOF"
  assert_eq dotl(". \r\n.\r\n"), " "
  assert_eq dotl(".\n.\r\n..\n\r\n .."), ""
  assert_eq dotl("\r\n.\na .\n"), ""
  assert_eq dotl("a...\r\n.\n"), "a..."
  assert_eq dotl("x.ya\r\n\r"), "ERR unexpected EOF"
  assert_eq dotl("..\r"), "ERR unexpected EOF"
  assert_eq dotl("... \r\nx.y. "), "ERR unexpected EOF"
  assert_eq dotl("a\r\nx.y"), "ERR unexpected EOF"
  assert_eq dotl("..\r\na\r.a\r\n"), "ERR unexpected EOF"
  assert_eq dotl("ax.y..\r\r\n "), "ERR unexpected EOF"
  assert_eq dotl(".\r\n..\r\n\r\n .."), ""
  assert_eq dotl("x.ya"), "ERR unexpected EOF"
  assert_eq dotl(".\n...\n"), ""
  assert_eq dotl("..a\r\n\n.."), "ERR unexpected EOF"
  assert_eq dotl("."), ""
  assert_eq dotl(".\n.\n."), ""
  assert_eq dotl("\r\n.\r\n\na "), ""
  assert_eq dotl(".\n.\n \r .\n"), ""
  assert_eq dotl("\r\r"), "ERR unexpected EOF"
  assert_eq dotl("..a.\r\n.\n"), ".a."
  assert_eq dotl("x.y. "), "ERR unexpected EOF"
  assert_eq dotl(".\nx.y"), ""
  assert_eq dotl("a..\r\n.."), "ERR unexpected EOF"
  assert_eq dotl("..\n..x.y.\r\n"), "ERR unexpected EOF"
  assert_eq dotl("\r\na "), "ERR unexpected EOF"
  assert_eq dotl("..\n\r"), "ERR unexpected EOF"
  assert_eq dotl("\n...\r\n \r\n.\r\n"), "|..| "
  assert_eq dotl("\r\r\n.\n\n\r\n "), "\r"
  assert_eq dotl("\r\n\r"), "ERR unexpected EOF"
  assert_eq dotl("x.y\r\n"), "ERR unexpected EOF"
  assert_eq dotl("\r.\r\n..\n.\n.\r\n"), "\r.|."
  assert_eq dotl("a\r\r\na"), "ERR unexpected EOF"
  assert_eq dotl(".\n.\r\n\r\n.\nx.yx.y."), ""
  assert_eq dotl("....a.\n .\n"), "ERR unexpected EOF"
  assert_eq dotl("\ra\n"), "ERR unexpected EOF"
  assert_eq dotl(".\r\n\r\n..x.y..a.\n"), ""
  assert_eq dotl("x.y.."), "ERR unexpected EOF"
  assert_eq dotl("  .\n "), "ERR unexpected EOF"
  assert_eq dotl(" .\n"), "ERR unexpected EOF"
  assert_eq dotl("a....\r\n."), "a...."
  assert_eq dotl("\r...\n.\n.\r\n"), "\r..."
  assert_eq dotl("...\n..\r\n."), "..|."
  assert_eq dotl("\r.\r\n"), "ERR unexpected EOF"
  assert_eq dotl(".\r\na...\r\n."), ""
  assert_eq dotl("x.y. .\n"), "ERR unexpected EOF"
  assert_eq dotl(".\n\r\n\r\n.."), ""
  assert_eq dotl("\nx.y"), "ERR unexpected EOF"
  assert_eq dotl("\r ax.y"), "ERR unexpected EOF"
}

test "vectors: dot lines 2" {
  assert_eq dotl("\n\r ..\r\na."), "ERR unexpected EOF"
  assert_eq dotl("a."), "ERR unexpected EOF"
  assert_eq dotl("a\n\r"), "ERR unexpected EOF"
  assert_eq dotl(".\r\nx.y"), ""
  assert_eq dotl("a.\r\n\n\n x.y"), "ERR unexpected EOF"
  assert_eq dotl(".\r\n\na.\r\n"), ""
  assert_eq dotl("\n....\r\n"), "ERR unexpected EOF"
  assert_eq dotl(" ...\n\n...\r\n"), "ERR unexpected EOF"
  assert_eq dotl("\r\nx.y.\n"), "ERR unexpected EOF"
  assert_eq dotl("\n\r..a"), "ERR unexpected EOF"
  assert_eq dotl("\na"), "ERR unexpected EOF"
  assert_eq dotl(" .x.y"), "ERR unexpected EOF"
  assert_eq dotl(".\nx.y  .\r\n\r\n\r"), ""
  assert_eq dotl(".\n ..\n\nx.y"), ""
  assert_eq dotl(" \r\n\r\n \rx.y"), "ERR unexpected EOF"
  assert_eq dotl("x.y.\r\nx.yx.y\r.\n"), "ERR unexpected EOF"
  assert_eq dotl("a...x.y\r\n\r\nx.y"), "ERR unexpected EOF"
  assert_eq dotl("\rx.y\r\n...."), "ERR unexpected EOF"
  assert_eq dotl("a\r\n..\r\nx.y"), "ERR unexpected EOF"
  assert_eq dotl("\r\nx.y\rx.y.\na"), "ERR unexpected EOF"
  assert_eq dotl(".\n.\n"), ""
  assert_eq dotl(" a\r\n..."), "ERR unexpected EOF"
  assert_eq dotl("... ax.ya"), "ERR unexpected EOF"
  assert_eq dotl("aaa.\r\n.\r\n\r.\n"), "aaa."
  assert_eq dotl(".\r\n.\n"), ""
  assert_eq dotl("\na.\r\n\n"), "ERR unexpected EOF"
  assert_eq dotl("..\r.\r\n"), "ERR unexpected EOF"
  assert_eq dotl(".\r\n\nx.y\r..\n"), ""
  assert_eq dotl("ax.ya.\n"), "ERR unexpected EOF"
  assert_eq dotl(" \n..\r\n .."), "ERR unexpected EOF"
  assert_eq dotl("..\r\n"), "ERR unexpected EOF"
  assert_eq dotl(".\r\n\rx.y.\r\n ."), ""
  assert_eq dotl(". "), "ERR unexpected EOF"
  assert_eq dotl("\rx.y\r\na\n"), "ERR unexpected EOF"
  assert_eq dotl("a..\r\n"), "ERR unexpected EOF"
  assert_eq dotl("\rx.y\r.....\r\n"), "ERR unexpected EOF"
  assert_eq dotl("x.y\r"), "ERR unexpected EOF"
  assert_eq dotl(".\rx.y"), "ERR unexpected EOF"
  assert_eq dotl("aa.\n. \r."), "ERR unexpected EOF"
  assert_eq dotl("  ..\r\n.x.y"), "ERR unexpected EOF"
  assert_eq dotl(".\r\n.\r\n\r.\n\n\r.\n"), ""
  assert_eq dotl(".\r\n\rx.y"), ""
  assert_eq dotl("a.\r\nx.y\r.\n.\n "), "a.|x.y\r."
  assert_eq dotl("x.y\ra...."), "ERR unexpected EOF"
  assert_eq dotl("\r\n\n\r\n \r\n"), "ERR unexpected EOF"
  assert_eq dotl(".\n\r\n \r\n.\r\n\r\n.."), ""
  assert_eq dotl(" \r\n\nx.y"), "ERR unexpected EOF"
  assert_eq dotl(".. .\r\n"), "ERR unexpected EOF"
  assert_eq dotl("...\n"), "ERR unexpected EOF"
  assert_eq dotl(".\n\r\r .\r\nx.y\n"), ""
  assert_eq dotl("\r\na\r\n.\r\n\n.."), "|a"
  assert_eq dotl("...\r..x.y\r\n\r"), "ERR unexpected EOF"
  assert_eq dotl("..x.y\r\r\nx.y..\r"), "ERR unexpected EOF"
  assert_eq dotl(".\nx.y.\n..\r\n"), ""
  assert_eq dotl("\r \rx.y\r.."), "ERR unexpected EOF"
  assert_eq dotl(".\n.\r\n"), ""
  assert_eq dotl("..x.y\na\r.\n.\n"), ".x.y|a\r."
  assert_eq dotl(".\r\na.... .."), ""
  assert_eq dotl(".\ra\n..\r\nx.y"), "ERR unexpected EOF"
  assert_eq dotl("\r.\nx.y\n.\r\n\r\n."), "\r.|x.y"
  assert_eq dotl("aa\r\r"), "ERR unexpected EOF"
  assert_eq dotl("\n. "), "ERR unexpected EOF"
  assert_eq dotl("...\r\n..\r.\r\n"), "ERR unexpected EOF"
  assert_eq dotl("...\n.\n.\n.x.y\r\n"), ".."
  assert_eq dotl("..\na.\r\n.\r\n"), ".|a."
  assert_eq dotl(".\n.\n...."), ""
  assert_eq dotl(" \r.  "), "ERR unexpected EOF"
  assert_eq dotl("..a.."), "ERR unexpected EOF"
  assert_eq dotl("a\n \r"), "ERR unexpected EOF"
}

test "vectors: dot writer 0" {
  assert_eq dotw("\n."), "\r\n..\r\n.\r\n"
  assert_eq dotw(".\r\ra...."), "..\r\ra....\r\n.\r\n"
  assert_eq dotw("\r\n\r\n\n\na"), "\r\n\r\n\r\n\r\na\r\n.\r\n"
  assert_eq dotw("\n"), "\r\n.\r\n"
  assert_eq dotw(".\n.\nx.y.\n"), "..\r\n..\r\nx.y.\r\n.\r\n"
  assert_eq dotw("a..\r"), "a..\r\n.\r\n"
  assert_eq dotw("\r\nx.y..."), "\r\nx.y...\r\n.\r\n"
  assert_eq dotw(" ...."), " ....\r\n.\r\n"
  assert_eq dotw(""), "\r\n.\r\n"
  assert_eq dotw(" .\r\n.x.y.\n.\na"), " .\r\n..x.y.\r\n..\r\na\r\n.\r\n"
  assert_eq dotw("\naa"), "\r\naa\r\n.\r\n"
  assert_eq dotw("x.y...a.\n."), "x.y...a.\r\n..\r\n.\r\n"
  assert_eq dotw(".\r\na "), "..\r\na \r\n.\r\n"
  assert_eq dotw(".. ."), "... .\r\n.\r\n"
  assert_eq dotw("a\r\n.\r."), "a\r\n..\r.\r\n.\r\n"
  assert_eq dotw(" \r"), " \r\n.\r\n"
  assert_eq dotw("a...\na\r"), "a...\r\na\r\n.\r\n"
  assert_eq dotw(".. x.y"), "... x.y\r\n.\r\n"
  assert_eq dotw(".\n\r\n\r\n.\r\n.\r\n.\n"), "..\r\n\r\n\r\n..\r\n..\r\n..\r\n.\r\n"
  assert_eq dotw("\r\r\nx.y "), "\r\r\r\nx.y \r\n.\r\n"
  assert_eq dotw(". \n"), ".. \r\n.\r\n"
  assert_eq dotw(".\n."), "..\r\n..\r\n.\r\n"
  assert_eq dotw("\r\n"), "\r\n.\r\n"
  assert_eq dotw(".\r\n"), "..\r\n.\r\n"
  assert_eq dotw(".\r\nx.ya\r\n"), "..\r\nx.ya\r\n.\r\n"
  assert_eq dotw(" \n\rx.y"), " \r\n\rx.y\r\n.\r\n"
  assert_eq dotw("..\r"), "...\r\n.\r\n"
  assert_eq dotw("\r\n\r\n..x.ya"), "\r\n\r\n...x.ya\r\n.\r\n"
  assert_eq dotw(" \r\n.\r\n \r\n\r\n"), " \r\n..\r\n \r\n\r\n.\r\n"
  assert_eq dotw(".\r\n.\r\n..\n.\r\nx.y"), "..\r\n..\r\n...\r\n..\r\nx.y\r\n.\r\n"
  assert_eq dotw("x.y..a"), "x.y..a\r\n.\r\n"
  assert_eq dotw("\n...\n"), "\r\n....\r\n.\r\n"
  assert_eq dotw("..\r\n\r\n.\r\n"), "...\r\n\r\n..\r\n.\r\n"
  assert_eq dotw("..a\r .. "), "...a\r .. \r\n.\r\n"
  assert_eq dotw(" "), " \r\n.\r\n"
  assert_eq dotw("."), "..\r\n.\r\n"
  assert_eq dotw(".."), "...\r\n.\r\n"
  assert_eq dotw("a\r\n.."), "a\r\n...\r\n.\r\n"
  assert_eq dotw(" . ."), " . .\r\n.\r\n"
  assert_eq dotw("\r.\n.x.y"), "\r.\r\n..x.y\r\n.\r\n"
  assert_eq dotw(" x.y\n..\n "), " x.y\r\n...\r\n \r\n.\r\n"
  assert_eq dotw("......\rx.y..."), ".......\rx.y...\r\n.\r\n"
  assert_eq dotw("  "), "  \r\n.\r\n"
  assert_eq dotw("\r\n\r\n"), "\r\n\r\n.\r\n"
  assert_eq dotw(".\r\n\n\r\n .\n"), "..\r\n\r\n\r\n .\r\n.\r\n"
  assert_eq dotw(".\n..a\r\n\ra"), "..\r\n...a\r\n\ra\r\n.\r\n"
  assert_eq dotw("...\r\n."), "....\r\n..\r\n.\r\n"
  assert_eq dotw("\r\na"), "\r\na\r\n.\r\n"
  assert_eq dotw("\r\na\r\n"), "\r\na\r\n.\r\n"
  assert_eq dotw(" \r\n \n"), " \r\n \r\n.\r\n"
  assert_eq dotw(" .\n\r"), " .\r\n\r\n.\r\n"
  assert_eq dotw("\n "), "\r\n \r\n.\r\n"
  assert_eq dotw("\r\n\r.\r\n\n.\n"), "\r\n\r.\r\n\r\n..\r\n.\r\n"
  assert_eq dotw("a...\n.\n\n.."), "a...\r\n..\r\n\r\n...\r\n.\r\n"
  assert_eq dotw(" a.\n.x.y...."), " a.\r\n..x.y....\r\n.\r\n"
  assert_eq dotw("\nx.y .."), "\r\nx.y ..\r\n.\r\n"
  assert_eq dotw("x.ya"), "x.ya\r\n.\r\n"
  assert_eq dotw("\r  "), "\r  \r\n.\r\n"
  assert_eq dotw("x.y.\r.\n"), "x.y.\r.\r\n.\r\n"
  assert_eq dotw("\r a\r\r\na"), "\r a\r\r\r\na\r\n.\r\n"
  assert_eq dotw("\ra.....\n.\r\n\r\n"), "\ra.....\r\n..\r\n\r\n.\r\n"
  assert_eq dotw("..x.y\n\r\r\r\n.\n"), "...x.y\r\n\r\r\r\n..\r\n.\r\n"
  assert_eq dotw("\r\n\r"), "\r\n\r\n.\r\n"
  assert_eq dotw("\r\r\n\n\r..x.y.\n"), "\r\r\r\n\r\n\r..x.y.\r\n.\r\n"
  assert_eq dotw(".....\n"), "......\r\n.\r\n"
  assert_eq dotw("..\r.\r\n\r\n \r"), "...\r.\r\n\r\n \r\n.\r\n"
  assert_eq dotw(".a\r\nx.yx.yx.y"), "..a\r\nx.yx.yx.y\r\n.\r\n"
  assert_eq dotw("\r\n.\n..a.\n"), "\r\n..\r\n...a.\r\n.\r\n"
  assert_eq dotw("ax.y.\r\n.\n "), "ax.y.\r\n..\r\n \r\n.\r\n"
  assert_eq dotw(".\n.\r\n a"), "..\r\n..\r\n a\r\n.\r\n"
  assert_eq dotw("\r\n\r\n...x.ya\r\n"), "\r\n\r\n....x.ya\r\n.\r\n"
  assert_eq dotw("\ra \r\n.\r\n.."), "\ra \r\n..\r\n...\r\n.\r\n"
  assert_eq dotw("\r"), "\r\n.\r\n"
  assert_eq dotw("\r.\r\n\r\n"), "\r.\r\n\r\n.\r\n"
  assert_eq dotw(".. .\r\na\n"), "... .\r\na\r\n.\r\n"
  assert_eq dotw(".\nx.y"), "..\r\nx.y\r\n.\r\n"
  assert_eq dotw(".\n\n....\n"), "..\r\n\r\n.....\r\n.\r\n"
  assert_eq dotw("\na..\rx.y"), "\r\na..\rx.y\r\n.\r\n"
  assert_eq dotw("x.y \r\n\na\r\n"), "x.y \r\n\r\na\r\n.\r\n"
  assert_eq dotw("aa .\r\nx.y"), "aa .\r\nx.y\r\n.\r\n"
  assert_eq dotw("\r\n..\r\n.\r\n.\r\n"), "\r\n...\r\n..\r\n..\r\n.\r\n"
  assert_eq dotw("\na\r"), "\r\na\r\n.\r\n"
}

test "vectors: dot writer 1" {
  assert_eq dotw("\n.\r\n\r..\r"), "\r\n..\r\n\r..\r\n.\r\n"
  assert_eq dotw("a\r"), "a\r\n.\r\n"
  assert_eq dotw("ax.y"), "ax.y\r\n.\r\n"
  assert_eq dotw("a\r\n.\r.."), "a\r\n..\r..\r\n.\r\n"
  assert_eq dotw(".\r\n.\r\n"), "..\r\n..\r\n.\r\n"
  assert_eq dotw("\r\n  \ra\r\n"), "\r\n  \ra\r\n.\r\n"
  assert_eq dotw(".\n.\n"), "..\r\n..\r\n.\r\n"
  assert_eq dotw("\n.."), "\r\n...\r\n.\r\n"
  assert_eq dotw(". \n\r\n"), ".. \r\n\r\n.\r\n"
  assert_eq dotw("\r..x.y"), "\r..x.y\r\n.\r\n"
  assert_eq dotw("a.. "), "a.. \r\n.\r\n"
  assert_eq dotw("x.y a"), "x.y a\r\n.\r\n"
  assert_eq dotw("a\n"), "a\r\n.\r\n"
  assert_eq dotw(" .a."), " .a.\r\n.\r\n"
  assert_eq dotw("\ra.\r\n\r ."), "\ra.\r\n\r .\r\n.\r\n"
  assert_eq dotw(".\n.\r\n.. x.y "), "..\r\n..\r\n... x.y \r\n.\r\n"
  assert_eq dotw("a"), "a\r\n.\r\n"
  assert_eq dotw("\r\n\naa"), "\r\n\r\naa\r\n.\r\n"
  assert_eq dotw(".\r\n\r\n .\n"), "..\r\n\r\n .\r\n.\r\n"
  assert_eq dotw("a\n.\n\r\n.\r."), "a\r\n..\r\n\r\n..\r.\r\n.\r\n"
  assert_eq dotw(".\na"), "..\r\na\r\n.\r\n"
  assert_eq dotw("..\r.\r\n\r "), "...\r.\r\n\r \r\n.\r\n"
  assert_eq dotw(".\r\n x.y\n \r\n.."), "..\r\n x.y\r\n \r\n...\r\n.\r\n"
  assert_eq dotw(".\r\nx.y..\r\n"), "..\r\nx.y..\r\n.\r\n"
  assert_eq dotw(".\n.\n.\nx.y\n"), "..\r\n..\r\n..\r\nx.y\r\n.\r\n"
  assert_eq dotw(" \n.\r\nx.ya\r\n\n"), " \r\n..\r\nx.ya\r\n\r\n.\r\n"
  assert_eq dotw(".\n.\r\n"), "..\r\n..\r\n.\r\n"
  assert_eq dotw(".a.\n\r\nx.y"), "..a.\r\n\r\nx.y\r\n.\r\n"
  assert_eq dotw("\r\r\n.\n"), "\r\r\r\n..\r\n.\r\n"
  assert_eq dotw("..."), "....\r\n.\r\n"
  assert_eq dotw(" .\n"), " .\r\n.\r\n"
  assert_eq dotw("x.y"), "x.y\r\n.\r\n"
  assert_eq dotw("x.y.\r\n\r.\r\na\r\n.."), "x.y.\r\n\r.\r\na\r\n...\r\n.\r\n"
  assert_eq dotw("\r\n\r\n\r\r\n  "), "\r\n\r\n\r\r\r\n  \r\n.\r\n"
  assert_eq dotw("..\nx.ya.\r\n\n\n"), "...\r\nx.ya.\r\n\r\n\r\n.\r\n"
  assert_eq dotw("....\n\r\n"), ".....\r\n\r\n.\r\n"
  assert_eq dotw("\rx.y\n\r"), "\rx.y\r\n\r\n.\r\n"
  assert_eq dotw(".\n"), "..\r\n.\r\n"
  assert_eq dotw("\r.."), "\r..\r\n.\r\n"
  assert_eq dotw("x.y.\r\n.\r\n"), "x.y.\r\n..\r\n.\r\n"
  assert_eq dotw("\r."), "\r.\r\n.\r\n"
  assert_eq dotw("...."), ".....\r\n.\r\n"
  assert_eq dotw(".\n\r\r\na.."), "..\r\n\r\r\r\na..\r\n.\r\n"
  assert_eq dotw("ax.y..\n\r  "), "ax.y..\r\n\r  \r\n.\r\n"
  assert_eq dotw("x.y.. \r\n..."), "x.y.. \r\n....\r\n.\r\n"
  assert_eq dotw("\r.\ra.."), "\r.\ra..\r\n.\r\n"
  assert_eq dotw(".\r\n.\nax.yx.y"), "..\r\n..\r\nax.yx.y\r\n.\r\n"
  assert_eq dotw("\r\n.\r\n.\n"), "\r\n..\r\n..\r\n.\r\n"
  assert_eq dotw(".\n\r.."), "..\r\n\r..\r\n.\r\n"
  assert_eq dotw(" \r\r..a"), " \r\r..a\r\n.\r\n"
  assert_eq dotw("\n.\na"), "\r\n..\r\na\r\n.\r\n"
  assert_eq dotw(" .\r\nx.y.\r\n a"), " .\r\nx.y.\r\n a\r\n.\r\n"
  assert_eq dotw("\n\n.."), "\r\n\r\n...\r\n.\r\n"
  assert_eq dotw("x.y.\r\n ....\r\n"), "x.y.\r\n ....\r\n.\r\n"
  assert_eq dotw(".a.x.y.. .\r\n"), "..a.x.y.. .\r\n.\r\n"
  assert_eq dotw(" \r\n   "), " \r\n   \r\n.\r\n"
  assert_eq dotw("a "), "a \r\n.\r\n"
  assert_eq dotw(".\r\n."), "..\r\n..\r\n.\r\n"
  assert_eq dotw(".\n\r\n.\r\n .\n"), "..\r\n\r\n..\r\n .\r\n.\r\n"
  assert_eq dotw(" \r\n x.y.."), " \r\n x.y..\r\n.\r\n"
  assert_eq dotw("\r\n x.y\n\n"), "\r\n x.y\r\n\r\n.\r\n"
  assert_eq dotw(".\n\r\n\r\n.\r\n.\r"), "..\r\n\r\n\r\n..\r\n..\r\n.\r\n"
  assert_eq dotw("\n...\r\n."), "\r\n....\r\n..\r\n.\r\n"
  assert_eq dotw("\n\r \r\n\r\n\r\na"), "\r\n\r \r\n\r\n\r\na\r\n.\r\n"
  assert_eq dotw("\r "), "\r \r\n.\r\n"
  assert_eq dotw(".\r\n.\n .\n.\r\n\r"), "..\r\n..\r\n .\r\n..\r\n\r\n.\r\n"
  assert_eq dotw(".\n.\n .\n\r\n\n"), "..\r\n..\r\n .\r\n\r\n\r\n.\r\n"
  assert_eq dotw(".\r\n..a\r\n"), "..\r\n...a\r\n.\r\n"
  assert_eq dotw("a\raa.\n\r\n"), "a\raa.\r\n\r\n.\r\n"
  assert_eq dotw("\r\n..\n.\r\n.\na"), "\r\n...\r\n..\r\n..\r\na\r\n.\r\n"
  assert_eq dotw("a.\r\n.\n\r "), "a.\r\n..\r\n\r \r\n.\r\n"
  assert_eq dotw(".\r\n.."), "..\r\n...\r\n.\r\n"
  assert_eq dotw("\n ax.y "), "\r\n ax.y \r\n.\r\n"
  assert_eq dotw("\n\r\n."), "\r\n\r\n..\r\n.\r\n"
  assert_eq dotw("\r\n ."), "\r\n .\r\n.\r\n"
  assert_eq dotw(" ..\n\r\n."), " ..\r\n\r\n..\r\n.\r\n"
  assert_eq dotw("\r\n\r\n.\r\n "), "\r\n\r\n..\r\n \r\n.\r\n"
}

test "vectors: dot writer 2" {
  assert_eq dotw("..\n. .\n\r.\r\n"), "...\r\n.. .\r\n\r.\r\n.\r\n"
  assert_eq dotw("\nx.y..\r\n. x.y"), "\r\nx.y..\r\n.. x.y\r\n.\r\n"
  assert_eq dotw("..\r.."), "...\r..\r\n.\r\n"
  assert_eq dotw(".\nx.yax.ya"), "..\r\nx.yax.ya\r\n.\r\n"
  assert_eq dotw("...\r\n\r\r\n.\r\na"), "....\r\n\r\r\r\n..\r\na\r\n.\r\n"
  assert_eq dotw(".\r\n.\r\n...\n\r"), "..\r\n..\r\n....\r\n\r\n.\r\n"
  assert_eq dotw("..a\r\n."), "...a\r\n..\r\n.\r\n"
  assert_eq dotw(" .\r\nx.y..\na"), " .\r\nx.y..\r\na\r\n.\r\n"
  assert_eq dotw("\r\nx.y\n.\n"), "\r\nx.y\r\n..\r\n.\r\n"
  assert_eq dotw("x.y....\r\n\r\n\n"), "x.y....\r\n\r\n\r\n.\r\n"
  assert_eq dotw("ax.yaa."), "ax.yaa.\r\n.\r\n"
  assert_eq dotw(" ..a"), " ..a\r\n.\r\n"
  assert_eq dotw("\r\n.\r\n"), "\r\n..\r\n.\r\n"
  assert_eq dotw("x.y\r\n."), "x.y\r\n..\r\n.\r\n"
  assert_eq dotw("\r.\r\na\n.\n"), "\r.\r\na\r\n..\r\n.\r\n"
  assert_eq dotw(".\n.\n .."), "..\r\n..\r\n ..\r\n.\r\n"
  assert_eq dotw(" \r.\r\n \n"), " \r.\r\n \r\n.\r\n"
  assert_eq dotw("..\n.\r\n "), "...\r\n..\r\n \r\n.\r\n"
  assert_eq dotw("\n.aa "), "\r\n..aa \r\n.\r\n"
  assert_eq dotw("..\r\n\r.\r\n\n"), "...\r\n\r.\r\n\r\n.\r\n"
  assert_eq dotw("x.y\ra .. .\r\n"), "x.y\ra .. .\r\n.\r\n"
  assert_eq dotw("x.yx.y.. .\n .."), "x.yx.y.. .\r\n ..\r\n.\r\n"
  assert_eq dotw("\r\n.\n .. "), "\r\n..\r\n .. \r\n.\r\n"
  assert_eq dotw(".\r\na\r..\r\n\r\n"), "..\r\na\r..\r\n\r\n.\r\n"
  assert_eq dotw(".\r\n.\n\r\n"), "..\r\n..\r\n\r\n.\r\n"
  assert_eq dotw(".\n\r..\r\n\r .."), "..\r\n\r..\r\n\r ..\r\n.\r\n"
  assert_eq dotw("\r\nx.y\r\n"), "\r\nx.y\r\n.\r\n"
  assert_eq dotw(".\n.."), "..\r\n...\r\n.\r\n"
  assert_eq dotw("x.y\r\n .\r\n. "), "x.y\r\n .\r\n.. \r\n.\r\n"
  assert_eq dotw(".\n \r\n"), "..\r\n \r\n.\r\n"
  assert_eq dotw(".\r\n\r..\r."), "..\r\n\r..\r.\r\n.\r\n"
  assert_eq dotw(".\r\n.. "), "..\r\n... \r\n.\r\n"
  assert_eq dotw("...\r\nx.y.\r\nx.y"), "....\r\nx.y.\r\nx.y\r\n.\r\n"
  assert_eq dotw("\r\na.\r\na.a"), "\r\na.\r\na.a\r\n.\r\n"
  assert_eq dotw("a\n..\nx.y .."), "a\r\n...\r\nx.y ..\r\n.\r\n"
  assert_eq dotw(".\r\n ..\r"), "..\r\n ..\r\n.\r\n"
  assert_eq dotw("\ra"), "\ra\r\n.\r\n"
  assert_eq dotw("\r\n\n"), "\r\n\r\n.\r\n"
  assert_eq dotw("a.\n.\n.\n"), "a.\r\n..\r\n..\r\n.\r\n"
  assert_eq dotw("x.y.\n\ra \r\n"), "x.y.\r\n\ra \r\n.\r\n"
  assert_eq dotw("\r.x.y\r"), "\r.x.y\r\n.\r\n"
  assert_eq dotw(".\r\n.\r\n.\n\r\n..."), "..\r\n..\r\n..\r\n\r\n....\r\n.\r\n"
  assert_eq dotw("a\n..\n.\n"), "a\r\n...\r\n..\r\n.\r\n"
  assert_eq dotw(".\r\n.\r\n.."), "..\r\n..\r\n...\r\n.\r\n"
  assert_eq dotw(".\r\n.\r\n\n .."), "..\r\n..\r\n\r\n ..\r\n.\r\n"
  assert_eq dotw("\r.\r\na"), "\r.\r\na\r\n.\r\n"
  assert_eq dotw("a..\n"), "a..\r\n.\r\n"
  assert_eq dotw("..\ra"), "...\ra\r\n.\r\n"
  assert_eq dotw(". .\r\n.\r\nx.y\r"), ".. .\r\n..\r\nx.y\r\n.\r\n"
  assert_eq dotw("\n\n\r\n.\r"), "\r\n\r\n\r\n..\r\n.\r\n"
  assert_eq dotw("a\r\nx.y.\r\n.\r\n  "), "a\r\nx.y.\r\n..\r\n  \r\n.\r\n"
  assert_eq dotw("x.y .."), "x.y ..\r\n.\r\n"
  assert_eq dotw("\r\n\na"), "\r\n\r\na\r\n.\r\n"
  assert_eq dotw(".\r\naa\r\n"), "..\r\naa\r\n.\r\n"
  assert_eq dotw("\r\n\r\na"), "\r\n\r\na\r\n.\r\n"
  assert_eq dotw("\rx.y\r...."), "\rx.y\r....\r\n.\r\n"
  assert_eq dotw("...\n\r\r\n"), "....\r\n\r\r\r\n.\r\n"
  assert_eq dotw("x.yx.y\nx.y"), "x.yx.y\r\nx.y\r\n.\r\n"
  assert_eq dotw(".ax.yx.y"), "..ax.yx.y\r\n.\r\n"
  assert_eq dotw("x.y "), "x.y \r\n.\r\n"
  assert_eq dotw("x.y\r\n.\r\n\r\n\r "), "x.y\r\n..\r\n\r\n\r \r\n.\r\n"
  assert_eq dotw("\r\n.\r\n\r\n.\nx.yx.y"), "\r\n..\r\n\r\n..\r\nx.yx.y\r\n.\r\n"
}
