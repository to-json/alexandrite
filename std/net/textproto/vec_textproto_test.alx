  assert_eq rcl("2500 ok\n1234 \n", 220), "ERR short response: \"2500 ok\""
  assert_eq rcl("2500 \r\n1234-5.1.1 fail\r\n1234 hello world\n2500 ok\r\n", 250), "ERR short response: \"2500 \""
  assert_eq rcl("550 ok\n1234  lead\n550 5.1.1 fail\n", 220), "CODE 550|ok"
  assert_eq rcl("2500- lead\n \r\n99-hello world\n25005.1.1 fail\n", 25), "ERR short response: \"2500- lead\""
  assert_eq rcl("\r\n220ok\r\n", 5), "ERR short response: \"\""
  assert_eq rcl("250- lead\n220 ok\n", 25), "ERR unexpected multi-line response: \" lead\""
  assert_eq rcl("550\nabc-5.1.1 fail\r\n5.1.1 fail\n99 hello world\r\n", 220), "ERR short response: \"550\""
  assert_eq rcl("free text", 220), "ERR short response: \"free text\""
  assert_eq rcl("550\r\n250 \r\n", 4), "ERR short response: \"550\""
  assert_eq rcl("99-\r\n550\nfree text\n99x lead\n", 550), "ERR short response: \"99-\""
  assert_eq rcl("250xok\nfree text\n2500\nabc \n", 0), "ERR short response: \"250xok\""
  assert_eq rcl("1234- lead\n550xok\r\n1234x lead\n2500x\r\n", 5), "ERR short response: \"1234- lead\""
  assert_eq rcl("99-5.1.1 fail\r\n", 4), "ERR short response: \"99-5.1.1 fail\""
  assert_eq rcl("250-ok\r\n", 1), "CODE 250|ok"
  assert_eq rcl("550xok\n", 0), "ERR short response: \"550xok\""
  assert_eq rcl("free text\n", 25), "ERR short response: \"free text\""
}

