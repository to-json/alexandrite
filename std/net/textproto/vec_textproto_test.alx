  assert_eq rr("1234xhello world\r", 25), "ERR short response: \"1234xhello world\\r\""
  assert_eq rr("2500-5.1.1 fail\r\n", 2), "ERR short response: \"2500-5.1.1 fail\""
  assert_eq rr("1234xok\n", 5), "ERR short response: \"1234xok\""
  assert_eq rr("abc 5.1.1 fail\r\n550-ok\r\n550x5.1.1 fail\nfree text\n", 550), "ERR invalid response code: \"abc 5.1.1 fail\""
  assert_eq rr("abcxhello world\n220 \r\n2500-\r\n250x", 4), "ERR short response: \"abcxhello world\""
  assert_eq rr("250-5.1.1 fail\nabc-hello world\r\n2500-\r\n550hello world\n", 550), "EOF"
  assert_eq rr("2500\n", 0), "ERR short response: \"2500\""
  assert_eq rr("250xok\n550-ok\n1234ok\r\n ok\r\n", 22), "ERR short response: \"250xok\""
