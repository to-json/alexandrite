  assert_eq cont("x-Y_z:  v \r\n  v \nFoo\tBar:\rFoo\t:\x7f\n  \t\x7f\r\né :x y z\r\n"), "<x-Y_z:  v v><Foo\tBar:\rFoo\t:\x7f \x7f><é :x y z>"
  assert_eq cont("X\t:é\r\nk$\t:\r  \tx y z\n\r\n"), "<X\t:é><k$\t:\r  \tx y z><>"
  assert_eq cont(" lead: 1\nx-Y_z:\r\nx-Y_z: 1\r\n\r\nbody"), "<lead: 1><x-Y_z:><x-Y_z: 1><><body>"
  assert_eq cont("Foox y z\r \x01\r"), "<Foox y z\r \x01\r>"
