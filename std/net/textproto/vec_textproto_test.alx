  assert_eq cont("CONTENT-type:\t\x01\r\n\t  trailing  \nFoo:   trailing  \r\n\t  trailing  \nfoo bar :\ta\tb\na-1-c\t:\n v\r\r\n"), "<CONTENT-type:\t\x01 trailing><Foo:   trailing trailing><foo bar :\ta\tb><a-1-c\t: v\r>"
  assert_eq cont(" lead:v\né:1\nfoo bar :\t1\n  \t1\r\nbody"), "<lead:v><é:1><foo bar :\t1 1><body>"
  assert_eq cont(":\té\r\n  \t\x7f\nx-Y_z: \x01\nFoo\tBar: \x01\r\n   trailing  \r\n\r\n"), "<:\té \x7f><x-Y_z: \x01><Foo\tBar: \x01 trailing><>"
  assert_eq cont("é :\r\nCONTENT-type\t:v\r\n\r\n"), "<é :><CONTENT-type\t:v><>"
  assert_eq cont("my-key\t:\r\né :\x7f\n 1\r\né: 1\r\n\n"), "<my-key\t:><é :\x7f 1><é: 1><>"
  assert_eq cont("Foo\tBar :  trailing  \r\n  \tx y z\r\n\n"), "<Foo\tBar :  trailing x y z><>"
  assert_eq cont("Foo:   trailing  \r\n lead:\tv\r\nx-Y_z:x y z\r\n x y z\n"), "<Foo:   trailing lead:\tv><x-Y_z:x y z x y z>"
  assert_eq cont("Foo\tBar :é\n:   trailing  \rFoo\tBar1\n\n"), "<Foo\tBar :é><:   trailing  \rFoo\tBar1><>"
  assert_eq cont("Foo\tBar:\x01\n"), "<Foo\tBar:\x01>"
  assert_eq cont("X::\x7f\n"), "<X::\x7f>"
