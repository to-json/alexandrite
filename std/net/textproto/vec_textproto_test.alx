}

test "vectors: code line 3" {
  assert_eq rcl("abc5.1.1 fail\n250 5.1.1 fail\n550x\n550-ok\r\n", 22), "ERR short response: \"abc5.1.1 fail\""
  assert_eq rcl("220-\n2500hello world\n550xhello world\r\n", 0), "ERR unexpected multi-line response: \"\""
  assert_eq rcl("\r\nfree text\r\n", 1), "ERR short response: \"\""
  assert_eq rcl("99x\r\n550ok\r\n250-ok\nx lead\n", 220), "ERR short response: \"99x\""
  assert_eq rcl("1234x lead\r\nok\n99- lead\r\n", 5), "ERR short response: \"1234x lead\""
  assert_eq rcl("free text\r\n99 hello world\nabcx5.1.1 fail\r\n220 lead\n", 5), "ERR short response: \"free text\""
  assert_eq rcl("250 hello world\r\nabc-\r\n220x5.1.1 fail\n550x\n", 2), "250|hello world"
  assert_eq rcl("free text\r\n99x\n2500ok", 22), "ERR short response: \"free text\""
  assert_eq rcl("x5.1.1 fail\nabc  lead\n- lead\n2500ok", 550), "ERR short response: \"x5.1.1 fail\""
  assert_eq rcl("abc ok\n2500 hello world\r\nxhello world\r", 25), "ERR invalid response code: \"abc ok\""
  assert_eq rcl("abc  lead\r\nxhello world\r\nabcxok\r\n", 4), "ERR invalid response code: \"abc  lead\""
  assert_eq rcl("25005.1.1 fail\nabc5.1.1 fail\n250- lead\nfree text\r\n", 0), "ERR short response: \"25005.1.1 fail\""
  assert_eq rcl("2500x\r\n2500 lead\n25005.1.1 fail\n250  lead\r\n", 250), "ERR short response: \"2500x\""
  assert_eq rcl("250  lead\n220ok\n", 2), "250| lead"
  assert_eq rcl("250  lead\r\n2500hello world\r\nabc5.1.1 fail\r\nabc  lead\r", 22), "CODE 250| lead"
  assert_eq rcl("1234hello world\nabc\n5505.1.1 fail\n", 2), "ERR short response: \"1234hello world\""
  assert_eq rcl("1234x5.1.1 fail\n lead\n", 4), "ERR short response: \"1234x5.1.1 fail\""
  assert_eq rcl("free text\n550-\r\n220  lead\nabc5.1.1 fail\r\n", 4), "ERR short response: \"free text\""
  assert_eq rcl("2500 lead\r\n220x lead\n550  lead\n250xhello world", 25), "ERR short response: \"2500 lead\""
  assert_eq rcl("2500-hello world\r\nfree text\n", 25), "ERR short response: \"2500-hello world\""
  assert_eq rcl("550 ok\r\n", 5), "550|ok"
  assert_eq rcl("abc- lead\nx lead\nabc ok", 550), "ERR invalid response code: \"abc- lead\""
  assert_eq rcl("550xhello world\n99x5.1.1 fail\n2500ok\n", 4), "ERR short response: \"550xhello world\""
  assert_eq rcl("2500ok", 25), "ERR short response: \"2500ok\""
  assert_eq rcl("free text\n1234x5.1.1 fail\n250xhello world\r\n", 250), "ERR short response: \"free text\""
  assert_eq rcl("99 hello world\r\n1234x lead\r\n220ok\r\n", 25), "ERR short response: \"99 hello world\""
  assert_eq rcl("2500ok\nfree text\n12345.1.1 fail\n25005.1.1 fail\n", 220), "ERR short response: \"2500ok\""
  assert_eq rcl("free text\r\nfree text", 4), "ERR short response: \"free text\""
  assert_eq rcl("220xok\nfree text\nfree text\n-5.1.1 fail\r\n", 1), "ERR short response: \"220xok\""
  assert_eq rcl("2500  lead", 5), "ERR short response: \"2500  lead\""
  assert_eq rcl("abc 5.1.1 fail\r\nfree text\r\n2505.1.1 fail\n", 2), "ERR invalid response code: \"abc 5.1.1 fail\""
  assert_eq rcl("550 \r\nfree text\r\n", 220), "CODE 550|"
  assert_eq rcl("2505.1.1 fail\n", 2), "ERR short response: \"2505.1.1 fail\""
  assert_eq rcl("99- lead", 0), "ERR invalid response code: \"99- lead\""
  assert_eq rcl("99xhello world\nabcxok\n", 5), "ERR short response: \"99xhello world\""
  assert_eq rcl("abchello world\n1234 \n1234x lead\n2500  lead\n", 25), "ERR short response: \"abchello world\""
  assert_eq rcl("1234hello world\n2505.1.1 fail\nfree text\n250- lead\n", 220), "ERR short response: \"1234hello world\""
  assert_eq rcl("250 lead\r\n1234hello world\r\nfree text\n250\n", 1), "CODE 250|lead"
  assert_eq rcl("free text\n1234 lead\n550-\n", 5), "ERR short response: \"free text\""
  assert_eq rcl("free text\n1234 5.1.1 fail\r\n220x\n550ok\r\n", 25), "ERR short response: \"free text\""
  assert_eq rcl("250x5.1.1 fail\nfree text\n250-hello world\nxok\n", 250), "ERR short response: \"250x5.1.1 fail\""
  assert_eq rcl("2500 lead\r\n220 lead\n  lead\n", 25), "ERR short response: \"2500 lead\""
  assert_eq rcl("250  lead\n550 lead\r\n", 0), "250| lead"
  assert_eq rcl("free text\n", 1), "ERR short response: \"free text\""
  assert_eq rcl("abcxhello world\n2205.1.1 fail\n", 25), "ERR short response: \"abcxhello world\""
  assert_eq rcl("220 5.1.1 fail\r\n99-5.1.1 fail\n2500 5.1.1 fail\r", 25), "CODE 220|5.1.1 fail"
  assert_eq rcl("2500-\nabc \r\n550x lead\r\n550 \r\n", 2), "ERR short response: \"2500-\""
  assert_eq rcl("550xhello world\r\nfree text\r\n", 1), "ERR short response: \"550xhello world\""
  assert_eq rcl("abc-\n1234\r\n99 \nabc \r\n", 22), "ERR invalid response code: \"abc-\""
  assert_eq rcl("free text\nabcx lead\nabc- lead\n", 22), "ERR short response: \"free text\""
  assert_eq rcl("2205.1.1 fail\r\n2500x lead", 2), "ERR short response: \"2205.1.1 fail\""
  assert_eq rcl("2500-5.1.1 fail\nabc- lead\r\n", 250), "ERR short response: \"2500-5.1.1 fail\""
  assert_eq rcl("2205.1.1 fail\r\n220-ok\r\nabc-hello world\n", 22), "ERR short response: \"2205.1.1 fail\""
  assert_eq rcl("220- lead\n250 hello world\r\n220 5.1.1 fail\r\n", 25), "CODE 220| lead"
  assert_eq rcl("free text\r\nabc lead\n2500x5.1.1 fail\n1234 ", 22), "ERR short response: \"free text\""
  assert_eq rcl(" lead\nfree text\n", 25), "ERR short response: \" lead\""
  assert_eq rcl("1234 hello world\n2500  lead\nfree text\r\n250ok\n", 0), "ERR short response: \"1234 hello world\""
  assert_eq rcl("2500- lead\n1234x\r\n", 22), "ERR short response: \"2500- lead\""
  assert_eq rcl("free text\n", 5), "ERR short response: \"free text\""
  assert_eq rcl("2500-\n-hello world\n550 lead\r", 22), "ERR short response: \"2500-\""
  assert_eq rcl("free text\r\n lead\r\n99ok\r\n", 550), "ERR short response: \"free text\""
  assert_eq rcl("2500\r\n99 hello world\r\n", 220), "ERR short response: \"2500\""
  assert_eq rcl("abcxhello world\r\n2505.1.1 fail\n550-hello world\n220 ok\n", 22), "ERR short response: \"abcxhello world\""
  assert_eq rcl("2500-hello world\r\n", 550), "ERR short response: \"2500-hello world\""
  assert_eq rcl("220  lead\r\nabcok\r\nfree text\n", 1), "CODE 220| lead"
  assert_eq rcl("1234\r\n2500- lead\n99- lead\n", 550), "ERR short response: \"1234\""
  assert_eq rcl("99 \r\n220xok\n550 ok\r\n550-ok\n", 250), "ERR short response: \"99 \""
  assert_eq rcl("  lead\r\nfree text\n", 0), "ERR short response: \"  lead\""
  assert_eq rcl("1234-ok\r\nabc lead", 2), "ERR short response: \"1234-ok\""
  assert_eq rcl("1234  lead\n550 ok\n220xok", 5), "ERR short response: \"1234  lead\""
  assert_eq rcl("220xhello world\n1234hello world\n220x\n", 0), "ERR short response: \"220xhello world\""
  assert_eq rcl("250- lead\n", 220), "CODE 250| lead"
  assert_eq rcl("2500 hello world\r\n-ok", 550), "ERR short response: \"2500 hello world\""
  assert_eq rcl("2500xhello world\n", 220), "ERR short response: \"2500xhello world\""
  assert_eq rcl("99 ok\r\n250x lead\r\n", 220), "ERR short response: \"99 ok\""
  assert_eq rcl("free text\n1234 ok\n250 5.1.1 fail\n2500 \r\n", 1), "ERR short response: \"free text\""
  assert_eq rcl("2500 hello world\n", 22), "ERR short response: \"2500 hello world\""
  assert_eq rcl("free text\nabc-ok\n  lead\r\n1234xhello world\r\n", 250), "ERR short response: \"free text\""
  assert_eq rcl("550-ok\r\nabc lead\n", 220), "CODE 550|ok"
  assert_eq rcl("550 \n250ok\r\n", 22), "CODE 550|"
  assert_eq rcl("220 ok\n99-\r\n", 5), "CODE 220|ok"
  assert_eq rcl("free text\n250 ", 220), "ERR short response: \"free text\""
  assert_eq rcl("99  lead\nabc 5.1.1 fail\r\n550x lead\r\n1234xok\n", 4), "ERR invalid response code: \"99  lead\""
  assert_eq rcl("250-\n99 lead\r\n1234\n250 ok\r\n", 250), "ERR unexpected multi-line response: \"\""
  assert_eq rcl("1234 5.1.1 fail\n", 550), "ERR short response: \"1234 5.1.1 fail\""
  assert_eq rcl("550x\n250 5.1.1 fail\n", 0), "ERR short response: \"550x\""
  assert_eq rcl("1234-hello world\n", 550), "ERR short response: \"1234-hello world\""
  assert_eq rcl("abc-hello world\n", 250), "ERR invalid response code: \"abc-hello world\""
  assert_eq rcl("free text\r\n550 ok\nok\n550x5.1.1 fail\n", 22), "ERR short response: \"free text\""
  assert_eq rcl("x lead\r\nabc-ok\r\n550- lead\nfree text\n", 25), "ERR short response: \"x lead\""
  assert_eq rcl("abcx\n550-hello world\n99  lead\r\n1234  lead\n", 0), "ERR short response: \"abcx\""
  assert_eq rcl(" lead\n1234\n99hello world\r\n99 \r\n", 0), "ERR short response: \" lead\""
  assert_eq rcl("250 hello world\n550x\r\n2500-ok\n2500-hello world\r\n", 220), "CODE 250|hello world"
  assert_eq rcl("free text\n", 0), "ERR short response: \"free text\""
  assert_eq rcl("25005.1.1 fail\r\n550hello world\r\n2500 lead\n", 250), "ERR short response: \"25005.1.1 fail\""
  assert_eq rcl("250- lead\n", 2), "ERR unexpected multi-line response: \" lead\""
  assert_eq rcl("250-ok\r\nabchello world\n", 220), "CODE 250|ok"
  assert_eq rcl("2500- lead\n550ok\nabchello world\n", 22), "ERR short response: \"2500- lead\""
}

test "vectors: continued line 0" {
  assert_eq cont(""), ""
  assert_eq cont("a-1-c::\x01\nFoo\t:a\tb\r\r\n"), "<a-1-c::\x01><Foo\t:a\tb\r>"
  assert_eq cont("::1\r\nk$:\tx y z\r\né :  trailing  \rmy-key: v\n\n"), "<::1><k$:\tx y z><é :  trailing  \rmy-key: v><>"
  assert_eq cont("::é\r"), "<::é\r>"
  assert_eq cont("X:\t1\r\n  \t1\na b\t:1\né::x y z\n  \t\x01\r\n\r\nbody"), "<X:\t1 1><a b\t:1><é::x y z \x01><><body>"
  assert_eq cont("my-key: é\r\nCONTENT-type:\té\nFoo:v\n\t\x7f\r\n\n"), "<my-key: é><CONTENT-type:\té><Foo:v \x7f><>"
  assert_eq cont(" v \r: \r\nbody"), "<v \r:><body>"
  assert_eq cont(" lead: x y z\r  \t v \r\nCONTENT-type:\tv\r\n\n"), "<lead: x y z\r  \t v><CONTENT-type:\tv><>"
  assert_eq cont("CONTENT-type: a\tb\r\nbody"), "<CONTENT-type: a\tb><body>"
  assert_eq cont("é: \x01\r\n\t\x01\n lead : v \nmy-key::v\r\n\n"), "<é: \x01 \x01 lead : v><my-key::v><>"
  assert_eq cont("Foo::\x7f\rXa\tb\r  \t1\r\n\n"), "<Foo::\x7f\rXa\tb\r  \t1><>"
  assert_eq cont("\n"), "<>"
  assert_eq cont("my-key:\t\x01\r a\tb\r\n\n"), "<my-key:\t\x01\r a\tb><>"
  assert_eq cont("CONTENT-type\x7f\rFoo\tBar\t:é\na-1-c\t:\x7f\n\r\n"), "<CONTENT-type\x7f\rFoo\tBar\t:é><a-1-c\t:\x7f><>"
  assert_eq cont("Foo : v \n lead\t:\nCONTENT-type:\tx y z\nFoo\tBar::x y z\r\nbody"), "<Foo : v lead\t:><CONTENT-type:\tx y z><Foo\tBar::x y z><body>"
  assert_eq cont("X: \x01\r\n  \ta\tb\nbody"), "<X: \x01 a\tb><body>"
  assert_eq cont("é: \r\n\r\n"), "<é:><>"
  assert_eq cont("\t:a\tb\nX: v \r v\r\na-1-c :\x7f\n\r\n"), "<:a\tb><X: v \r v><a-1-c :\x7f><>"
  assert_eq cont(":\t\x01\r\nX:\t\r\n\r\n"), "<:\t\x01><X:><>"
  assert_eq cont("CONTENT-type:x y z\n:\té\n\r\n"), "<CONTENT-type:x y z><:\té><>"
  assert_eq cont("Foo\tBar::a\tb\nfoo bar ::x y z\r a\tb\r lead:\t  trailing  \r\na b1\n"), "<Foo\tBar::a\tb><foo bar ::x y z\r a\tb\r lead:\t  trailing><a b1>"
  assert_eq cont("é :a\tb\r\n\té\nmy-key: \x7f\r\t\x7f\ra b :x y z\r\r\n"), "<é :a\tb é><my-key: \x7f\r\t\x7f\ra b :x y z\r>"
  assert_eq cont("Foo\tBar :\x01\nfoo bar :: v \r\n v\rfoo bar :\t v \n \r\né\x01\r\n \r\n\r\n"), "<Foo\tBar :\x01><foo bar :: v v\rfoo bar :\t v ><é\x01 ><>"
  assert_eq cont("k$: \nX v \r\n\tx y z\r\né:é\r\n   trailing  \nbody"), "<k$:><X v x y z><é:é trailing><body>"
  assert_eq cont("foo bar :  v \n  \té\nmy-key :\x01\r\nk$: \r\n"), "<foo bar :  v é><my-key :\x01><k$:>"
  assert_eq cont(" lead\t:a\tb\n\t\r\nFoo\tBar:\x01\r\n leadv\r\na b:\ta\tb\n\r\n"), "<lead\t:a\tb ><Foo\tBar:\x01 leadv><a b:\ta\tb><>"
  assert_eq cont("foo bar ::\x01\r\na b :x y z\r\na-1-c::\x01\r\n  \tv\r\n\r\n"), "<foo bar ::\x01><a b :x y z><a-1-c::\x01 v><>"
  assert_eq cont("a b : v \n\r\n"), "<a b : v><>"
  assert_eq cont("é:\x7f\né::\n lead\t:x y z\r\n\tv\r\nk$\t:1\n\r\n"), "<é:\x7f><é:: lead\t:x y z v><k$\t:1><>"
  assert_eq cont("\r\nbody"), "<><body>"
  assert_eq cont("a bx y z\r\t v \rk$: 1\r\t\r\n\r\n"), "<a bx y z\r\t v \rk$: 1\r><>"
  assert_eq cont("::\na b :x y z\n\n"), "<::><a b :x y z><>"
  assert_eq cont("\r\n"), "<>"
  assert_eq cont("X::a\tb\na b :a\tb\rFoo\tBar :\r\n 1\r\r\n"), "<X::a\tb><a b :a\tb\rFoo\tBar : 1\r>"
  assert_eq cont("a b::a\tb\rmy-key\t:1\r\nmy-key::x y z\n lead: v\n\nbody"), "<a b::a\tb\rmy-key\t:1><my-key::x y z lead: v><><body>"
  assert_eq cont("1\r\nfoo bar : \n  \tv\rmy-key:v\r::  trailing  \n  \ta\tb\r\r\nbody"), "<1><foo bar : v\rmy-key:v\r::  trailing a\tb\r><body>"
  assert_eq cont("x-Y_z::1\n  \t v \n\n"), "<x-Y_z::1 v><>"
  assert_eq cont("a-1-c:\t\x01\n\n"), "<a-1-c:\t\x01><>"
  assert_eq cont("my-key:: v \nmy-key :\x01\n lead:\t\x01\r\n\r\n"), "<my-key:: v><my-key :\x01 lead:\t\x01><>"
  assert_eq cont("CONTENT-type\t:1\nFoo\tBar:a\tb\r\na-1-c:\té\nx-Y_z: \r\r\n"), "<CONTENT-type\t:1><Foo\tBar:a\tb><a-1-c:\té><x-Y_z: \r>"
  assert_eq cont("body"), "<body>"
  assert_eq cont("x-Y_z :x y z\n\r\nbody"), "<x-Y_z :x y z><><body>"
  assert_eq cont("a-1-c:x y z\r\nk$::\x01\nX::v\nX  trailing  \r\t  trailing  \n\nbody"), "<a-1-c:x y z><k$::\x01><X::v><X  trailing  \r\t  trailing><><body>"
  assert_eq cont(" lead:  v \n\r\nbody"), "<lead:  v><><body>"
  assert_eq cont("é:: v \nmy-key1\r\nk$: v\r\nFoo\tBar1\r\n  \t v \r\nbody"), "<é:: v><my-key1><k$: v><Foo\tBar1 v><body>"
  assert_eq cont("foo bar : \x7f\nk$ :\x7f\nfoo bar ::v\na-1-c:\t1\r"), "<foo bar : \x7f><k$ :\x7f><foo bar ::v><a-1-c:\t1\r>"
  assert_eq cont("my-key :\n\tx y z\r\na b:\x7f\nCONTENT-typea\tb\n  \t1\nk$::\x7f\n\t  trailing  \r\n\r\nbody"), "<my-key : x y z><a b:\x7f><CONTENT-typea\tb 1><k$::\x7f trailing><><body>"
  assert_eq cont("foo bar \t:é\r\n   trailing  \n"), "<foo bar \t:é trailing>"
  assert_eq cont(" lead::\x01\r\nfoo bar : \nCONTENT-type\x7f\n\n"), "<lead::\x01><foo bar :><CONTENT-type\x7f><>"
  assert_eq cont("my-key :\nx-Y_z\t:é\n\r\nbody"), "<my-key :><x-Y_z\t:é><><body>"
  assert_eq cont(" lead:\x7f\n :  trailing  \r\n\nbody"), "<lead:\x7f :  trailing><><body>"
  assert_eq cont("é\t:  trailing  \nfoo bar ::v\né :  trailing  \nFoo\t:  trailing  \r\n"), "<é\t:  trailing><foo bar ::v><é :  trailing><Foo\t:  trailing>"
  assert_eq cont("my-key:\x01\r\nCONTENT-type\rx-Y_z:\t\x7f\r\n lead :a\tb\r\n\r\nbody"), "<my-key:\x01><CONTENT-type\rx-Y_z:\t\x7f lead :a\tb><><body>"
  assert_eq cont("foo bar  :é\n\nbody"), "<foo bar  :é><><body>"
  assert_eq cont("\nbody"), "<><body>"
  assert_eq cont(" lead: 1\na-1-c\t:1\r\nFoo\tBar::v\nX :\x01\r\n\nbody"), "<lead: 1><a-1-c\t:1><Foo\tBar::v><X :\x01><><body>"
  assert_eq cont("X: a\tb\r\n\r\nbody"), "<X: a\tb><><body>"
  assert_eq cont("x-Y_z\x01\r  \t\x01\n\r\nbody"), "<x-Y_z\x01\r  \t\x01><><body>"
  assert_eq cont("Foo\t:v\r\nk$: \x01\r\n\t  trailing  \nmy-key::x y z\r\nX\t:é\r\n \x01\n\nbody"), "<Foo\t:v><k$: \x01 trailing><my-key::x y z><X\t:é \x01><><body>"
  assert_eq cont("a-1-c:\x01\r\n\ta\tb\r\nmy-key :v\r\nCONTENT-type\t:  trailing  \r\r\nbody"), "<a-1-c:\x01 a\tb><my-key :v><CONTENT-type\t:  trailing  \r><body>"
  assert_eq cont(" lead:\t\x7f\n\r\nbody"), "<lead:\t\x7f><><body>"
  assert_eq cont("CONTENT-type: \x01\r\nx-Y_z:\t  trailing  \n\r\nbody"), "<CONTENT-type: \x01><x-Y_z:\t  trailing><><body>"
  assert_eq cont(":: v \rFoo:\r \n\r\nbody"), "<:: v \rFoo:\r><><body>"
  assert_eq cont("x-Y_z::\nFoo\tBar :\nX:\tv\r\n\t\x7f\r\nfoo bar  : v \n\r\n"), "<x-Y_z::><Foo\tBar :><X:\tv \x7f><foo bar  : v><>"
  assert_eq cont("é  trailing  \né\x7f\r\nx-Y_z\t:a\tb\n \x7f\r\nX:\tx y z\r\nbody"), "<é  trailing><é\x7f><x-Y_z\t:a\tb \x7f><X:\tx y z><body>"
  assert_eq cont("a-1-c: v\nk$: a\tb\r\n\r\nbody"), "<a-1-c: v><k$: a\tb><><body>"
  assert_eq cont("k$::\x7f\r\nx-Y_z\t:1\r v\n :\r\n  \tx y z\r\n\r\nbody"), "<k$::\x7f><x-Y_z\t:1\r v : x y z><><body>"
  assert_eq cont(": v \nx-Y_z::a\tb\r\nx-Y_z:\t v \rbody"), "<: v><x-Y_z::a\tb><x-Y_z:\t v \rbody>"
  assert_eq cont("my-key::v\na-1-c:\t1\r\tv\nmy-key:\t v \n\nbody"), "<my-key::v><a-1-c:\t1\r\tv><my-key:\t v><><body>"
  assert_eq cont("Fooé\nCONTENT-type\t: v \r\nFoo\x7f\n"), "<Fooé><CONTENT-type\t: v><Foo\x7f>"
  assert_eq cont("X v \r\n\t\x01\r\na b: \x01\nbody"), "<X v \x01><a b: \x01><body>"
  assert_eq cont("CONTENT-type:a\tb\r \x01\r\r\n"), "<CONTENT-type:a\tb\r \x01\r>"
  assert_eq cont(":\x01\na-1-c: x y z\nx-Y_z::\x7f\r\na b:\x7f\n é\n\r\n"), "<:\x01><a-1-c: x y z><x-Y_z::\x7f><a b:\x7f é><>"
  assert_eq cont("my-key:\ta\tb\r\nX:   trailing  \r\nCONTENT-type:é\rFoo :v\r\n\n"), "<my-key:\ta\tb><X:   trailing><CONTENT-type:é\rFoo :v><>"
  assert_eq cont("a b:x y z\ra-1-c :\x01\r\n\r\n"), "<a b:x y z\ra-1-c :\x01><>"
  assert_eq cont("Foo:\t  trailing  \r\n a\tb\rX:\t\x01\r\n  \tx y z\nmy-key:\tx y z\n\r\n"), "<Foo:\t  trailing a\tb\rX:\t\x01 x y z><my-key:\tx y z><>"
  assert_eq cont("x-Y_z:x y z\na-1-c::v\nX:\n 1\r\nbody"), "<x-Y_z:x y z><a-1-c::v><X: 1><body>"
  assert_eq cont("X:\x7f\rFoo:é\r\n"), "<X:\x7f\rFoo:é>"
  assert_eq cont("my-key::  trailing  \r\nfoo bar : a\tb\rbody"), "<my-key::  trailing><foo bar : a\tb\rbody>"
  assert_eq cont("Foo\tBar:é\r\nk$ : v \r\r\n"), "<Foo\tBar:é><k$ : v \r>"
  assert_eq cont("my-key: v \r\nk$:\rFoo :  trailing  \r"), "<my-key: v><k$:\rFoo :  trailing  \r>"
  assert_eq cont("CONTENT-type::\n  \ta\tb\r\nk$: é\rCONTENT-type:\tv\n\n"), "<CONTENT-type:: a\tb><k$: é\rCONTENT-type:\tv><>"
  assert_eq cont("CONTENT-type:a\tb\n  \tv\r\nX\t:v\nmy-key :é\r\n\nbody"), "<CONTENT-type:a\tb v><X\t:v><my-key :é><><body>"
  assert_eq cont(" lead\t:\r\n \x7f\rFoo\tBar:: v \n"), "<lead\t: \x7f\rFoo\tBar:: v>"
}

test "vectors: continued line 1" {
