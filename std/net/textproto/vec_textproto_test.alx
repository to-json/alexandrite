  assert_eq cont("a-1-c: 1\r\nX::\x01\rX :1\r"), "<a-1-c: 1><X::\x01\rX :1\r>"
  assert_eq cont("my-key :\x01\r\nbody"), "<my-key :\x01><body>"
  assert_eq cont("Foo\t:é\r\na b :1\rk$: \x7f\r\r\n"), "<Foo\t:é><a b :1\rk$: \x7f\r>"
  assert_eq cont("CONTENT-type\t:\r\n\r\n"), "<CONTENT-type\t:><>"
  assert_eq cont(" lead: a\tb\r\na b:\t  trailing  \n\t v \r\r\n"), "<lead: a\tb><a b:\t  trailing v \r>"
