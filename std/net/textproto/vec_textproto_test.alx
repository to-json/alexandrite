  assert_eq rr("550x lead\r\n2500-5.1.1 fail\r\n1234 \r\n", 25), "ERR short response: \"550x lead\""
  assert_eq rr("1234  lead", 5), "ERR short response: \"1234  lead\""
  assert_eq rr("1234 lead\nabcok\n2500-5.1.1 fail\nabc ", 4), "ERR short response: \"1234 lead\""
  assert_eq rr("550-\n1234 lead\r\n250-\nfree text\r", 0), "EOF"
  assert_eq rr("2500-\r\n", 22), "ERR short response: \"2500-\""
