test "vectors: continued line 2" {
  assert_eq cont("a b:\t\na b\t:\nk$:: v \n\r\nbody"), "<a b:><a b\t:><k$:: v><><body>"
  assert_eq cont("x-Y_zv\na b\t:é\r\na-1-c::\x01\r\n"), "<x-Y_zv><a b\t:é><a-1-c::\x01>"
  assert_eq cont("\t:1\r\nmy-key\t:a\tb\n"), "<:1><my-key\t:a\tb>"
  assert_eq cont(" lead: v\r\n\n"), "<lead: v><>"
  assert_eq cont("k$::x y z\r\nk$::é\nfoo bar :\t v \r"), "<k$::x y z><k$::é><foo bar :\t v \r>"
