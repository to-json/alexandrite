  assert_eq rcl("99 ok\r\n", 550), "ERR short response: \"99 ok\""
  assert_eq rcl("1234x5.1.1 fail", 2), "ERR short response: \"1234x5.1.1 fail\""
  assert_eq rcl(" lead\nx lead\r\n", 22), "ERR short response: \" lead\""
