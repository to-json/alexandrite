  assert_eq rcl(" 5.1.1 fail\r", 25), "ERR short response: \" 5.1.1 fail\\r\""
  assert_eq rcl("free text\n99 5.1.1 fail\r\n", 0), "ERR short response: \"free text\""
  assert_eq rcl(" hello world\r\n220xhello world\n2500\n550-ok\n", 4), "ERR short response: \" hello world\""
  assert_eq rcl("free text\n220hello world\n", 22), "ERR short response: \"free text\""
  assert_eq rcl("220 \nabchello world\n99x\n", 5), "CODE 220|"
  assert_eq rcl("free text\nfree text\r\n250- lead\n", 550), "ERR short response: \"free text\""
  assert_eq rcl("550hello world\nfree text\n550xok\r\nfree text\r\n", 5), "ERR short response: \"550hello world\""
  assert_eq rcl("550x5.1.1 fail\n  lead\n250-5.1.1 fail\n", 550), "ERR short response: \"550x5.1.1 fail\""
  assert_eq rcl("free text\n99-5.1.1 fail\n250 \n", 220), "ERR short response: \"free text\""
  assert_eq rcl("99-\r\n", 250), "ERR short response: \"99-\""
  assert_eq rcl("1234xhello world", 22), "ERR short response: \"1234xhello world\""
  assert_eq rcl("2500x lead\r\nfree text\n1234 5.1.1 fail\n99- lead", 1), "ERR short response: \"2500x lead\""
  assert_eq rcl("550x\r\n", 1), "ERR short response: \"550x\""
  assert_eq rcl("220x5.1.1 fail\r\n-\n", 22), "ERR short response: \"220x5.1.1 fail\""
  assert_eq rcl("1234 5.1.1 fail\r\n2500-\r\n1234-5.1.1 fail\n", 4), "ERR short response: \"1234 5.1.1 fail\""
  assert_eq rcl("550hello world\n ok\r\n1234 \r\n", 0), "ERR short response: \"550hello world\""
