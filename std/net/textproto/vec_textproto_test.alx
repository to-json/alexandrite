  assert_eq rr("-\r", 22), "ERR short response: \"-\\r\""
  assert_eq rr("- lead\r\nabc hello world\nabcxok\n", 4), "ERR short response: \"- lead\""
  assert_eq rr("free text\n \nfree text\n1234x5.1.1 fail\n", 1), "ERR short response: \"free text\""
  assert_eq rr("abc-5.1.1 fail\r\n1234\n", 5), "EOF"
  assert_eq rr("free text\n1234 \r\n250hello world", 220), "ERR short response: \"free text\""
  assert_eq rr("1234 lead\r\nfree text", 5), "ERR short response: \"1234 lead\""
  assert_eq rr("2500 lead\n", 22), "ERR short response: \"2500 lead\""
  assert_eq rr("220  lead\r", 4), "CODE 220| lead\r"
  assert_eq rr("12345.1.1 fail\n", 250), "ERR short response: \"12345.1.1 fail\""
  assert_eq rr("220hello world\r\nabc lead\r\n", 0), "ERR short response: \"220hello world\""
  assert_eq rr("550 5.1.1 fail\n99 hello world", 550), "550|5.1.1 fail"
  assert_eq rr("250x5.1.1 fail\n2500-hello world\n  lead\n", 220), "ERR short response: \"250x5.1.1 fail\""
  assert_eq rr("free text\n99 ok\r\n1234 5.1.1 fail", 4), "ERR short response: \"free text\""
  assert_eq rr("1234-ok\r\n220ok\r\nfree text\n", 220), "ERR short response: \"1234-ok\""
  assert_eq rr("free text\nfree text\r\n", 25), "ERR short response: \"free text\""
  assert_eq rr("free text\n-ok\r\nabcx5.1.1 fail\r\n", 250), "ERR short response: \"free text\""
  assert_eq rr("1234-5.1.1 fail\n-5.1.1 fail\n1234 ok\r\n", 550), "ERR short response: \"1234-5.1.1 fail\""
  assert_eq rr("free text\n", 0), "ERR short response: \"free text\""
  assert_eq rr("free text\r\n", 550), "ERR short response: \"free text\""
  assert_eq rr("99 \n220\n99 5.1.1 fail\r\n", 4), "ERR short response: \"99 \""
  assert_eq rr("250x5.1.1 fail\r", 550), "ERR short response: \"250x5.1.1 fail\\r\""
  assert_eq rr("250hello world\n", 22), "ERR short response: \"250hello world\""
  assert_eq rr("2500xok\r\n", 25), "ERR short response: \"2500xok\""
  assert_eq rr("99xhello world", 4), "ERR short response: \"99xhello world\""
  assert_eq rr(" 5.1.1 fail", 550), "ERR short response: \" 5.1.1 fail\""
  assert_eq rr("220ok\r\n", 22), "ERR short response: \"220ok\""
  assert_eq rr("2500-hello world\nabchello world\n", 2), "ERR short response: \"2500-hello world\""
  assert_eq rr("220 lead\n1234\r\n", 25), "CODE 220|lead"
  assert_eq rr("abc lead\n", 250), "ERR invalid response code: \"abc lead\""
  assert_eq rr("free text\n", 5), "ERR short response: \"free text\""
  assert_eq rr("1234x5.1.1 fail\n220x\n", 250), "ERR short response: \"1234x5.1.1 fail\""
  assert_eq rr("1234hello world\n2500x5.1.1 fail\n", 22), "ERR short response: \"1234hello world\""
  assert_eq rr(" ok\nabc 5.1.1 fail\nfree text\r", 0), "ERR short response: \" ok\""
  assert_eq rr("220xok\r", 22), "ERR short response: \"220xok\\r\""
  assert_eq rr("free text\r\n", 1), "ERR short response: \"free text\""
  assert_eq rr("free text\n2205.1.1 fail\n550x5.1.1 fail\n220 hello world", 5), "ERR short response: \"free text\""
  assert_eq rr("xhello world\r", 220), "ERR short response: \"xhello world\\r\""
  assert_eq rr("2500x5.1.1 fail\nx lead\r", 22), "ERR short response: \"2500x5.1.1 fail\""
}

test "vectors: response 4" {
  assert_eq rr("2500x lead\n", 220), "ERR short response: \"2500x lead\""
  assert_eq rr("99xok\n550  lead\r\n99xhello world\r\n220 \n", 4), "ERR short response: \"99xok\""
  assert_eq rr("1234 hello world\r\nhello world\r\nabc lead\n", 550), "ERR short response: \"1234 hello world\""
  assert_eq rr("-5.1.1 fail\n", 5), "ERR short response: \"-5.1.1 fail\""
  assert_eq rr("2500-\r\n1234- lead\r\n99 lead\n", 0), "ERR short response: \"2500-\""
  assert_eq rr("1234- lead\r\n550x lead\n", 250), "ERR short response: \"1234- lead\""
  assert_eq rr("free text\r\nabcx lead", 25), "ERR short response: \"free text\""
  assert_eq rr("1234x lead\n1234x\r\n", 1), "ERR short response: \"1234x lead\""
  assert_eq rr("99xhello world\r", 0), "ERR short response: \"99xhello world\\r\""
  assert_eq rr(" lead\nfree text\n2500-5.1.1 fail\n99xhello world\r", 25), "ERR short response: \" lead\""
  assert_eq rr("220-hello world\n99x5.1.1 fail\r\n99\r\n220ok\r\n", 550), "EOF"
  assert_eq rr("1234- lead\nfree text\r", 1), "ERR short response: \"1234- lead\""
  assert_eq rr("free text\n1234-ok\r\n250xok\n", 2), "ERR short response: \"free text\""
  assert_eq rr("220xok\r\n", 2), "ERR short response: \"220xok\""
  assert_eq rr("1234 5.1.1 fail\r\n220x\n550-ok\r\n", 25), "ERR short response: \"1234 5.1.1 fail\""
  assert_eq rr("abc \n99 lead\n", 250), "ERR invalid response code: \"abc \""
  assert_eq rr("250ok\r\n", 5), "ERR short response: \"250ok\""
  assert_eq rr("220 lead\r\n99 ok\n250 5.1.1 fail\n550ok\n", 0), "220|lead"
  assert_eq rr("550xhello world\nabc\n220-hello world\n220-\n", 0), "ERR short response: \"550xhello world\""
  assert_eq rr("2500-hello world\n", 5), "ERR short response: \"2500-hello world\""
  assert_eq rr("99 \n220-5.1.1 fail\r\nfree text\nabc-hello world\n", 1), "ERR short response: \"99 \""
  assert_eq rr("220 ok\r\n250 5.1.1 fail\n \n99xok\r\n", 2), "220|ok"
  assert_eq rr("220x5.1.1 fail\n2500 \r\n", 550), "ERR short response: \"220x5.1.1 fail\""
  assert_eq rr("abcx lead\r\n220-ok\nx5.1.1 fail\r", 1), "ERR short response: \"abcx lead\""
  assert_eq rr("99 hello world\r\n2500ok\n", 5), "ERR short response: \"99 hello world\""
  assert_eq rr("99 ok\r\n2500-hello world\r\n250\r\nfree text\r\n", 4), "ERR short response: \"99 ok\""
  assert_eq rr("99 hello world", 1), "ERR short response: \"99 hello world\""
  assert_eq rr("x lead\r\nfree text\n1234\nfree text\n", 2), "ERR short response: \"x lead\""
  assert_eq rr("abc lead\n", 220), "ERR invalid response code: \"abc lead\""
  assert_eq rr("free text\n220xhello world\n250 5.1.1 fail\n-ok\r\n", 22), "ERR short response: \"free text\""
  assert_eq rr("free text\r\nfree text\r\n", 220), "ERR short response: \"free text\""
  assert_eq rr("abcx5.1.1 fail\n99xok\nfree text\r\n99  lead\r\n", 550), "ERR short response: \"abcx5.1.1 fail\""
  assert_eq rr("-ok\n220-ok\n", 22), "ERR short response: \"-ok\""
  assert_eq rr("250 lead\n", 220), "CODE 250|lead"
  assert_eq rr("1234 5.1.1 fail\n550ok\n", 220), "ERR short response: \"1234 5.1.1 fail\""
  assert_eq rr("220ok\n220-ok\r", 2), "ERR short response: \"220ok\""
  assert_eq rr("free text", 22), "ERR short response: \"free text\""
  assert_eq rr("free text\r\n", 220), "ERR short response: \"free text\""
  assert_eq rr("free text\n220x lead\nx lead\n250x\n", 250), "ERR short response: \"free text\""
  assert_eq rr("free text\n250x5.1.1 fail", 5), "ERR short response: \"free text\""
  assert_eq rr("550-ok\r\n99x5.1.1 fail\n", 1), "EOF"
  assert_eq rr("220x\r\nabc-\r", 0), "ERR short response: \"220x\""
  assert_eq rr("abc5.1.1 fail\r\n", 5), "ERR short response: \"abc5.1.1 fail\""
  assert_eq rr("99-hello world\r\n1234hello world", 5), "ERR short response: \"99-hello world\""
  assert_eq rr("220x5.1.1 fail\r\n1234ok\n1234  lead\r\n", 4), "ERR short response: \"220x5.1.1 fail\""
  assert_eq rr("1234 ok\r", 250), "ERR short response: \"1234 ok\\r\""
  assert_eq rr("2500x5.1.1 fail\r\n2505.1.1 fail\n99\r\n99 hello world\n", 4), "ERR short response: \"2500x5.1.1 fail\""
  assert_eq rr("99xok\r\n250 lead\r\n2500 5.1.1 fail\n", 5), "ERR short response: \"99xok\""
  assert_eq rr("2500\n550hello world\nabc lead\r\n1234\n", 0), "ERR short response: \"2500\""
  assert_eq rr("free text\n550\n", 2), "ERR short response: \"free text\""
  assert_eq rr("550 hello world\r\n250  lead\n220xhello world\r", 220), "CODE 550|hello world"
  assert_eq rr("550-5.1.1 fail\r\n1234\r\n", 5), "EOF"
  assert_eq rr("1234-\r\n", 0), "ERR short response: \"1234-\""
  assert_eq rr("250xhello world\r\nabc\r\n220xhello world", 1), "ERR short response: \"250xhello world\""
  assert_eq rr("abc\nfree text\nabc- lead\n", 4), "ERR short response: \"abc\""
  assert_eq rr("220-\n", 1), "EOF"
  assert_eq rr("2500ok\n550x5.1.1 fail\n550 lead\r\n hello world\n", 220), "ERR short response: \"2500ok\""
  assert_eq rr("220 hello world\n1234-hello world\n12345.1.1 fail\n220x5.1.1 fail\r\n", 2), "220|hello world"
  assert_eq rr("995.1.1 fail\r\nxhello world\n250-\n1234\r\n", 1), "ERR short response: \"995.1.1 fail\""
  assert_eq rr("220 hello world\n", 550), "CODE 220|hello world"
  assert_eq rr("2500-\nabc- lead\n25005.1.1 fail\r", 550), "ERR short response: \"2500-\""
  assert_eq rr("2500-ok\n1234 lead\n  lead", 22), "ERR short response: \"2500-ok\""
  assert_eq rr("220-\n2500x lead\n 5.1.1 fail\n99 hello world", 220), "EOF"
  assert_eq rr("99x\n", 220), "ERR short response: \"99x\""
  assert_eq rr("1234x lead\nfree text\r\nabc5.1.1 fail\r\n250 lead", 250), "ERR short response: \"1234x lead\""
  assert_eq rr("1234-ok\r\n1234xhello world\nhello world\n550 5.1.1 fail\n", 5), "ERR short response: \"1234-ok\""
  assert_eq rr("550x lead\n1234xok\r\n99hello world\nabc\r", 220), "ERR short response: \"550x lead\""
  assert_eq rr("free text\nhello world\r\n", 5), "ERR short response: \"free text\""
  assert_eq rr("99-\nfree text\nfree text\n", 220), "ERR short response: \"99-\""
  assert_eq rr("2500x lead\r\nfree text\nhello world\n", 0), "ERR short response: \"2500x lead\""
  assert_eq rr("1234x\r", 2), "ERR short response: \"1234x\\r\""
  assert_eq rr(" \r", 22), "ERR short response: \" \\r\""
  assert_eq rr("free text\r\n99 \n2500x\r\n", 22), "ERR short response: \"free text\""
  assert_eq rr("1234\r\n lead\n", 25), "ERR short response: \"1234\""
  assert_eq rr(" \nfree text\r\n2500hello world\n550-\n", 1), "ERR short response: \" \""
  assert_eq rr("-\n", 22), "ERR short response: \"-\""
  assert_eq rr(" ok\n550-\nfree text\nfree text\r\n", 2), "ERR short response: \" ok\""
  assert_eq rr("99-\nfree text\n250-\n", 550), "ERR short response: \"99-\""
  assert_eq rr("2500-ok\n", 2), "ERR short response: \"2500-ok\""
  assert_eq rr("abc5.1.1 fail\nfree text\n2500ok\r\n550-ok\n", 2), "ERR short response: \"abc5.1.1 fail\""
  assert_eq rr("2500 hello world\n", 0), "ERR short response: \"2500 hello world\""
  assert_eq rr(" \n220\n99 \r\n", 4), "ERR short response: \" \""
  assert_eq rr("abc\r", 550), "ERR short response: \"abc\\r\""
  assert_eq rr("99-hello world\r\n550xhello world\n1234 ok\r\n", 4), "ERR short response: \"99-hello world\""
  assert_eq rr(" hello world\nfree text\n250ok\r\n1234-hello world", 220), "ERR short response: \" hello world\""
  assert_eq rr("abc hello world\r\nabcxhello world\n220 lead\r\nfree text\r", 220), "ERR invalid response code: \"abc hello world\""
  assert_eq rr("2500 hello world\n", 5), "ERR short response: \"2500 hello world\""
  assert_eq rr("99xok\nfree text\r", 220), "ERR short response: \"99xok\""
  assert_eq rr("abc-\r\nok\n1234-\n550 ok\r\n", 1), "EOF"
  assert_eq rr("99- lead\n-hello world\n", 25), "ERR invalid response code: \"99- lead\""
  assert_eq rr("free text\r\n250xok\r\nxhello world\n", 5), "ERR short response: \"free text\""
  assert_eq rr("250-ok\r\n", 25), "EOF"
  assert_eq rr("free text\n995.1.1 fail\nfree text\n", 22), "ERR short response: \"free text\""
  assert_eq rr("2500 ok", 220), "ERR short response: \"2500 ok\""
  assert_eq rr("-5.1.1 fail\n99 ok\n550\n", 250), "ERR short response: \"-5.1.1 fail\""
  assert_eq rr("abc-5.1.1 fail\r\n220 ok\r\n lead\r\n", 22), "EOF"
  assert_eq rr("", 22), "EOF"
  assert_eq rr("free text\n99- lead\n220\n550 \r\n", 0), "ERR short response: \"free text\""
  assert_eq rr("250-\n99hello world\n1234 hello world\n", 250), "EOF"
}

