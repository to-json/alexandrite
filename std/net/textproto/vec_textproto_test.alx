  assert_eq cont("é\r\nbody"), "<é><body>"
  assert_eq cont("é :x y z\nCONTENT-type:  trailing  \n\r\n"), "<é :x y z><CONTENT-type:  trailing><>"
  assert_eq cont("é:\t\x01\r\na-1-c\t:\x7f\r\nmy-key:v\rX::é\n\r\n"), "<é:\t\x01><a-1-c\t:\x7f><my-key:v\rX::é><>"
  assert_eq cont("x-Y_z::é\r\nFoo\tBar:1\r\n\r\n"), "<x-Y_z::é><Foo\tBar:1><>"
  assert_eq cont("my-key :é\r\n\t v \r lead:\ta\tb\nmy-keyv\n  \tv\r"), "<my-key :é v \r lead:\ta\tb><my-keyv v\r>"
  assert_eq cont("my-key : v \r lead:\tv\nfoo bar :\t\x01\n  \tv\n\r\n"), "<my-key : v \r lead:\tv><foo bar :\t\x01 v><>"
  assert_eq cont(":: v \n x y z\r\n lead\t:\rmy-key::  trailing  \r\n \nbody"), "<:: v x y z lead\t:\rmy-key::  trailing ><body>"
  assert_eq cont("k$:a\tb\n  \tx y z\nFoo\tBar :v\n  \tx y z\n:\t\r\n::v\r\n\nbody"), "<k$:a\tb x y z><Foo\tBar :v x y z><:><::v><><body>"
  assert_eq cont("x-Y_z :v\ra-1-c: v\r\nfoo bar ::\x7f\n\r\n"), "<x-Y_z :v\ra-1-c: v><foo bar ::\x7f><>"
  assert_eq cont("a b:\t  trailing  \r lead\n\t v \nFoo:x y z\n é\r\n\t:a\tb\n\t1\n\r\nbody"), "<a b:\t  trailing  \r lead v><Foo:x y z é :a\tb 1><><body>"
  assert_eq cont("a b\x01\r\n lead : v \nfoo bar  :v\r\n\n"), "<a b\x01 lead : v><foo bar  :v><>"
  assert_eq cont("X :x y z\n  \t v \nk$:\t1\r\nx-Y_z: v\n lead:\ta\tb\r\n\r\nbody"), "<X :x y z v><k$:\t1><x-Y_z: v lead:\ta\tb><><body>"
  assert_eq cont("X:   trailing  \r\nmy-key:   trailing  \nXé\nFoo\tBar:x y z\nbody"), "<X:   trailing><my-key:   trailing><Xé><Foo\tBar:x y z><body>"
  assert_eq cont("k$::  trailing  \n lead:\tv\r\né::1\r\nCONTENT-type:\tx y z\n"), "<k$::  trailing lead:\tv><é::1><CONTENT-type:\tx y z>"
  assert_eq cont("a-1-c: \r\nX: v\nCONTENT-type:: v \r\n"), "<a-1-c:><X: v><CONTENT-type:: v>"
  assert_eq cont("my-key::é\rCONTENT-type:\ta\tb\r\n"), "<my-key::é\rCONTENT-type:\ta\tb>"
  assert_eq cont(" lead :\r lead :  trailing  \r\n\r\n"), "<lead :\r lead :  trailing><>"
  assert_eq cont("Foo\tBar\t:x y z\n leadx y z\r\nmy-key : v \n  \tv\r\nbody"), "<Foo\tBar\t:x y z leadx y z><my-key : v v><body>"
  assert_eq cont("foo bar \t:v\r\nk$: a\tb\n\n"), "<foo bar \t:v><k$: a\tb><>"
  assert_eq cont("a b::\x01\n\t1\r\n lead:\tv\rFoo\tBar: x y z\r\nx-Y_z:\t v \r\r\n"), "<a b::\x01 1 lead:\tv\rFoo\tBar: x y z><x-Y_z:\t v \r>"
  assert_eq cont("x-Y_z::é\r\n\r\nbody"), "<x-Y_z::é><><body>"
  assert_eq cont("x-Y_z::é\rbody"), "<x-Y_z::é\rbody>"
}

