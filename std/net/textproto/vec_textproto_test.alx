# Generated from Go's net/textproto (go run, Go 1.27): MIME headers, keys, code lines, dot encoding; do not edit by hand.

test "vectors: mime header 0" {
  assert_eq mh("Foo\tBar:\t v \n"), "ERR malformed MIME header line: \"Foo\\tBar:\\t v\""
  assert_eq mh("\r\n"), ""
  assert_eq mh("k$ : v \r\na b:\x01\n\r\n"), "ERR malformed MIME header line: \"a b:\\x01\""
  assert_eq mh("x-Y_z: \x01\r\nfoo bar \t: v \r\nXé\n\r\n"), "ERR malformed MIME header line: \"X-Y_z: \\x01\""
  assert_eq mh("X\t: v \rmy-key :\x01\nfoo bar \nFoo :\x7f\n"), "ERR malformed MIME header line: \"X\\t: v \\rmy-key :\\x01\""
  assert_eq mh("a-1-c: \x7f\n \x7f\r\nk$: \x7f\n::x y z\r\n\ta\tb\n\n"), "ERR malformed MIME header line: \"A-1-C: \\x7f \\x7f\""
  assert_eq mh("\r\nbody"), ""
  assert_eq mh("Xv\r\n:  v \r\n\t1\r\n\r\nbody"), "ERR malformed MIME header: missing colon: \"Xv\""
  assert_eq mh("X\t:x y z\r\n\r\n"), "ERR malformed MIME header line: \"X\\t:x y z\""
  assert_eq mh("a b: v\r\n"), "a b=[v] +EOF"
  assert_eq mh("Foo:\ta\tb\r\n  \tv\n:: v \r  \t\x7f\né :1\nk$\t:a\tb\nbody"), "ERR malformed MIME header line: \":: v \\r  \\t\\x7f\""
  assert_eq mh("my-key\t: v \rmy-key  trailing  \r\nx-Y_z: v\r\nCONTENT-type\x01\n\r\n"), "ERR malformed MIME header line: \"my-key\\t: v \\rmy-key  trailing\""
  assert_eq mh("foo bar :\t1\n  \ta\tb\r\n"), "foo bar =[1 a\tb] +EOF"
  assert_eq mh("x-Y_z::x y z\r\nbody"), "ERR malformed MIME header: missing colon: \"body\""
  assert_eq mh("\n"), ""
  assert_eq mh("\nbody"), ""
  assert_eq mh(""), " +EOF"
  assert_eq mh("k$a\tb\rCONTENT-type  trailing  \r  v \n\nbody"), "ERR malformed MIME header: missing colon: \"k$a\\tb\\rCONTENT-type  trailing  \\r  v \""
  assert_eq mh(" lead:   trailing  \r\néa\tb\r\n  \t\x7f\r\n:é\r"), "ERR malformed MIME header initial line: \" lead:   trailing  \""
  assert_eq mh("my-key:1\rCONTENT-type:v\r\n\n"), "ERR malformed MIME header line: \"My-Key:1\\rCONTENT-type:v\""
  assert_eq mh("é:\t\nk$\t:1\n\t\x7f\r"), "ERR malformed MIME header line: \"é:\""
  assert_eq mh("X :1\r\t:é\r\nFoo\tBar: x y z\n x y z\r\nX: \r\n\r\n"), "ERR malformed MIME header line: \"X :1\\r\\t:é\""
  assert_eq mh("k$ :\nk$ v \r\n x y z\nXé\r\né\t:v\n\nbody"), "ERR malformed MIME header: missing colon: \"k$ v \""
  assert_eq mh("k$:\x7f\r\nFoo\tBar::\x01\n lead: v \r\né: v\n\r\n"), "ERR malformed MIME header line: \"K$:\\x7f\""
  assert_eq mh("CONTENT-type::\r\n\r\nbody"), "Content-Type=[:]"
  assert_eq mh("foo bar é\rfoo bar :\té\r\n  \té\r\nFoo:  v \r\nFoo::a\tb\r\n\r\n"), "ERR malformed MIME header line: \"foo bar é\\rfoo bar :\\té é\""
  assert_eq mh("CONTENT-type :\nmy-key:a\tb\n\r\n"), "CONTENT-type =[];My-Key=[a\tb]"
  assert_eq mh("foo bar : v \r\nk$:  v \r  \té\nx-Y_z::x y z\r\n"), "ERR malformed MIME header line: \"K$:  v \\r  \\té\""
  assert_eq mh(" lead: v \rmy-key:\x7f\r\nCONTENT-typeé\r\n  \t v \rmy-key:\t\n\r\n"), "ERR malformed MIME header initial line: \" lead: v \\rmy-key:\\x7f\""
  assert_eq mh("é:\n\tx y z\r\r\nbody"), "ERR malformed MIME header line: \"é: x y z\\r\""
  assert_eq mh(": \r\nk$ :  trailing  \r\n::a\tb\n\r\nbody"), "ERR malformed MIME header line: \":\""
  assert_eq mh("a b::x y z\ra-1-c::  trailing  \r\n\n"), "ERR malformed MIME header line: \"a b::x y z\\ra-1-c::  trailing\""
  assert_eq mh("foo bar :\t v \nx-Y_z:  v \r\nCONTENT-type: v \nFoo\tBar: x y z\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar: x y z\""
  assert_eq mh(" :x y z\n  \t\x01\r\nmy-key: \x7f\rCONTENT-type:: v \r\nx-Y_z :\x01\r\n\r\n"), "ERR malformed MIME header initial line: \" :x y z\""
  assert_eq mh("é:  trailing  \n leada\tb\ré: \x01\r\n\tv\n\r\nbody"), "ERR malformed MIME header line: \"é:  trailing leada\\tb\\ré: \\x01 v\""
  assert_eq mh("CONTENT-type : v \r\n  \t\x7f\r\nFoo\tBar\t:v\nmy-key : v \r\na-1-c:v\r\n\nbody"), "ERR malformed MIME header line: \"CONTENT-type : v \\x7f\""
  assert_eq mh("X::a\tb\r\né:\t\x7f\na b:   trailing  \n\r\n"), "ERR malformed MIME header line: \"é:\\t\\x7f\""
  assert_eq mh("a-1-c  trailing  \na b: x y z\rFoo\tBar::é\n  \tv\n\r\nbody"), "ERR malformed MIME header: missing colon: \"a-1-c  trailing  \""
  assert_eq mh("Foo:\t\x7f\n\t:\r\n lead:\t\x01\r\n\r\nbody"), "ERR malformed MIME header line: \"Foo:\\t\\x7f : lead:\\t\\x01\""
  assert_eq mh("x-Y_z:\tv\r\né::\x01\n\r\n"), "ERR malformed MIME header line: \"é::\\x01\""
  assert_eq mh(" :a\tb\n\t v \nX::\x01\r \x01\n\r\n"), "ERR malformed MIME header initial line: \" :a\\tb\""
  assert_eq mh("Foo\tBar: \x01\r\nk$: a\tb\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar: \\x01\""
  assert_eq mh("Foo  trailing  \r\na-1-c:\t\nFoo::a\tb\n   trailing  \nCONTENT-type:1\r\n  \t\x7f\n\r\nbody"), "ERR malformed MIME header: missing colon: \"Foo  trailing  \""
  assert_eq mh("foo bar :x y z\r\nFoo\tBar: v\r\nFoo::\x7f\n\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar: v\""
  assert_eq mh("my-key:\tx y z\n   trailing  \nfoo bar : \x7f\nFoo:\t v \n a\tb\n\r\nbody"), "ERR malformed MIME header line: \"foo bar : \\x7f\""
  assert_eq mh("CONTENT-type:\t\x7f\na b:x y z\r\n\nbody"), "ERR malformed MIME header line: \"Content-Type:\\t\\x7f\""
  assert_eq mh("a b :  trailing  \r\nCONTENT-type\x7f\r\na-1-c:\x01\nfoo bar :   trailing  \r\nbody"), "ERR malformed MIME header: missing colon: \"CONTENT-type\\x7f\""
  assert_eq mh("a bv\nX:\t\r\n\ta\tb\rbody"), "ERR malformed MIME header: missing colon: \"a bv\""
  assert_eq mh("a-1-c:\t\x01\n\t:\x7f\nfoo bar \t:v\nbody"), "ERR malformed MIME header line: \"A-1-C:\\t\\x01 :\\x7f\""
  assert_eq mh("Foo\tBar\t:\x7f\nFoo :a\tb\n  \ta\tb\r\nFoo\tBar:\t\x01\r\n  \t\nFoo:   trailing  \r\r\n"), "ERR malformed MIME header line: \"Foo\\tBar\\t:\\x7f\""
  assert_eq mh("CONTENT-type:\t\x7f\rFoo\tBar::\x01\n\r\n"), "ERR malformed MIME header line: \"Content-Type:\\t\\x7f\\rFoo\\tBar::\\x01\""
  assert_eq mh("k$:a\tb\r\nmy-key\t:\r\r\n"), "ERR malformed MIME header line: \"my-key\\t:\\r\""
  assert_eq mh("foo bar  :v\n\n"), "foo bar  =[v]"
  assert_eq mh("Foo\tBar: é\nX::\x7f\r\n\t:1\rmy-key1\r\n"), "ERR malformed MIME header line: \"Foo\\tBar: é\""
  assert_eq mh("Foo\tBar:a\tb\r 1\na-1-c::1\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:a\\tb\\r 1\""
  assert_eq mh("my-key\t:1\n\n"), "ERR malformed MIME header line: \"my-key\\t:1\""
  assert_eq mh("Foo\tBar: \x01\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar: \\x01\""
  assert_eq mh("k$:\t  trailing  \nFoo\tBar:\té\n\nbody"), "ERR malformed MIME header line: \"Foo\\tBar:\\té\""
  assert_eq mh(" :1\r\nbody"), "ERR malformed MIME header initial line: \" :1\""
  assert_eq mh(" lead :x y z\r\nFoo\tBar\t:\x7f\r\n  \té\nk$: v \n\r\nbody"), "ERR malformed MIME header initial line: \" lead :x y z\""
  assert_eq mh("foo bar  v \na b : v \r\n  \té\r\nX:é\r\n\n"), "ERR malformed MIME header: missing colon: \"foo bar  v \""
  assert_eq mh("k$:v\n\r\n"), "K$=[v]"
  assert_eq mh("Foo: v\r\n \x01\rbody"), "ERR malformed MIME header line: \"Foo: v \\x01\\rbody\""
  assert_eq mh("a b\x7f\n"), "ERR malformed MIME header: missing colon: \"a b\\x7f\""
  assert_eq mh("Foo\tBar\t:\x01\ré\t:x y z\r\nX:\x7f\r\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar\\t:\\x01\\ré\\t:x y z\""
  assert_eq mh("Foo :x y z\r\nx-Y_z:\t\x7f\rFoo\tBar\t:v\r\nFoo\tBar::a\tb\n  v \r\n\n"), "ERR malformed MIME header line: \"X-Y_z:\\t\\x7f\\rFoo\\tBar\\t:v\""
  assert_eq mh("é\t:a\tb\r\n  \tv\r"), "ERR malformed MIME header line: \"é\\t:a\\tb v\\r\""
  assert_eq mh("X:  trailing  \r\n\r\n"), "X=[trailing]"
  assert_eq mh("é\t:v\r v\ra b :x y z\r\n\tx y z\nCONTENT-type:é\nmy-key: 1\n\r\n"), "ERR malformed MIME header line: \"é\\t:v\\r v\\ra b :x y z x y z\""
  assert_eq mh(" lead :\x7f\n  \t1\n\r\nbody"), "ERR malformed MIME header initial line: \" lead :\\x7f\""
  assert_eq mh("k$:é\r\nbody"), "ERR malformed MIME header: missing colon: \"body\""
  assert_eq mh("Foo\tBar\t: v \r  \ta\tb\r\nx-Y_z:: v \rmy-key :1\ré:a\tb\n\nbody"), "ERR malformed MIME header line: \"Foo\\tBar\\t: v \\r  \\ta\\tb\""
  assert_eq mh("Foo\tBar :\r\nFoo\tBar::  trailing  \r   trailing  \n lead: é\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar :\""
  assert_eq mh("k$:\ta\tb\r\n\r\n"), "K$=[a\tb]"
  assert_eq mh("a-1-c:\r\na b:: v \na-1-c::1\r\nCONTENT-type :é\n\n"), "A-1-C=[|:1];CONTENT-type =[é];a b=[: v]"
  assert_eq mh("a-1-c\t: v \nX:\t1\n  \ta\tb\rFoo\t:é\n \x7f\n\nbody"), "ERR malformed MIME header line: \"a-1-c\\t: v\""
  assert_eq mh("x-Y_z :\r\n lead::\x7f\n\r\n"), "ERR malformed MIME header line: \"x-Y_z : lead::\\x7f\""
}

test "vectors: mime header 1" {
  assert_eq mh("foo bar :é\r\nX:\t\r\n"), "X=[];foo bar =[é] +EOF"
  assert_eq mh("Foo\tBar :\x01\r\n lead:1\r\n  \t  trailing  \nX: \x7f\nfoo bar  :\x01\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar :\\x01 lead:1 trailing\""
  assert_eq mh("my-key:\ta\tb\r\r\n"), "ERR malformed MIME header line: \"My-Key:\\ta\\tb\\r\""
  assert_eq mh("x-Y_z:\tx y z\nFoo\tBar :\rx-Y_z :  trailing  \r\n\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar :\\rx-Y_z :  trailing\""
  assert_eq mh("é :\x7f\n  \t  trailing  \nx-Y_z::1\r\n"), "ERR malformed MIME header line: \"é :\\x7f trailing\""
  assert_eq mh("Foo\tBar: é\r\n  \t\x7f\n"), "ERR malformed MIME header line: \"Foo\\tBar: é \\x7f\""
  assert_eq mh("my-key :v\r\n \x7f\nk$:é\r\r\nbody"), "ERR malformed MIME header line: \"my-key :v \\x7f\""
  assert_eq mh(" : v \n\r\n"), "ERR malformed MIME header initial line: \" : v \""
  assert_eq mh("a-1-c::v\rx-Y_z\t:é\r \r\n\r\n"), "ERR malformed MIME header line: \"A-1-C::v\\rx-Y_z\\t:é\\r\""
  assert_eq mh("X v \r\n\r\nbody"), "ERR malformed MIME header: missing colon: \"X v \""
  assert_eq mh("my-key: 1\r\tx y z\r\n: é\r\na-1-c\t:x y z\na-1-c:\x01\r\n\n"), "ERR malformed MIME header line: \"My-Key: 1\\r\\tx y z\""
  assert_eq mh("my-key:  trailing  \r\n  \t1\r\nk$:\t\rfoo bar :\x7f\r\nbody"), "ERR malformed MIME header line: \"K$:\\t\\rfoo bar :\\x7f\""
  assert_eq mh("k$::1\r\n"), "K$=[:1] +EOF"
  assert_eq mh("é:x y z\n  \t1\n lead::\r\n\tv\n"), "ERR malformed MIME header line: \"é:x y z 1 lead:: v\""
  assert_eq mh(" leadx y z\r\n\nbody"), "ERR malformed MIME header initial line: \" leadx y z\""
  assert_eq mh("a b :\x7f\rFoo::\x7f\ré:\t  trailing  \r\r\n"), "ERR malformed MIME header line: \"a b :\\x7f\\rFoo::\\x7f\\ré:\\t  trailing  \\r\""
  assert_eq mh("a-1-c\x01\r\n leadx y z\nbody"), "ERR malformed MIME header: missing colon: \"a-1-c\\x01\""
  assert_eq mh("CONTENT-type:\t1\n lead\t:a\tb\r lead :x y z\r\n\r\n"), "ERR malformed MIME header line: \"Content-Type:\\t1 lead\\t:a\\tb\\r lead :x y z\""
  assert_eq mh("X: é\né::1\n  v \r\né:x y z\n"), "ERR malformed MIME header line: \"é::1 v\""
  assert_eq mh(" lead: \x7f\r\n\nbody"), "ERR malformed MIME header initial line: \" lead: \\x7f\""
  assert_eq mh("X:\n\t\x01\na-1-c:\t1\r\nfoo bar ::v\r\n\t\x01\rmy-key: v\r\nbody"), "ERR malformed MIME header line: \"X: \\x01\""
  assert_eq mh(" lead:\rfoo bar \t:\x01\r\na b:\t\x7f\r"), "ERR malformed MIME header initial line: \" lead:\\rfoo bar \\t:\\x01\""
  assert_eq mh("é:\t\x7f\r é\nx-Y_z::  trailing  \rx-Y_z :v\n\n"), "ERR malformed MIME header line: \"é:\\t\\x7f\\r é\""
  assert_eq mh("é\t:a\tb\n  \t1\r\na b:   trailing  \n\r\nbody"), "ERR malformed MIME header line: \"é\\t:a\\tb 1\""
  assert_eq mh("k$: v \r\n"), "K$=[v] +EOF"
  assert_eq mh("a b\t: v \r\nX: a\tb\rFoo:\té\r\nmy-key:\tv\n é\n\r\nbody"), "ERR malformed MIME header line: \"a b\\t: v\""
  assert_eq mh("foo bar  :  trailing  \r\n\r\n"), "foo bar  =[trailing]"
  assert_eq mh(" lead:  v \r\nfoo bar :1\n  \t v \rCONTENT-type\x7f\n\t\x7f\rFoo\tBar\t:é\r\n\r\n"), "ERR malformed MIME header initial line: \" lead:  v \""
  assert_eq mh(" lead: v \r  \té\nFoo\t:\x01\r\n  \t\x7f\r\nX: \x01\n\n"), "ERR malformed MIME header initial line: \" lead: v \\r  \\té\""
  assert_eq mh(" lead:  trailing  \r\nx-Y_z\t:  trailing  \nx-Y_z::é\r\n\t\x01\r\n\n"), "ERR malformed MIME header initial line: \" lead:  trailing  \""
  assert_eq mh("body"), "ERR malformed MIME header: missing colon: \"body\""
  assert_eq mh("Foo:é\r\na b\t:\r\n lead: \x7f\r\nFoo\tBar :é\r\n\nbody"), "ERR malformed MIME header line: \"a b\\t: lead: \\x7f\""
  assert_eq mh(" lead\t:\r\n\t  trailing  \nFoo\tBar: v \r\nX::v\nk$: v\n\r\n"), "ERR malformed MIME header initial line: \" lead\\t:\""
  assert_eq mh("my-key\t:\név\rmy-key:\t\x01\r: x y z\nbody"), "ERR malformed MIME header line: \"my-key\\t:\""
  assert_eq mh("k$a\tb\r\nFoo\tBar: é\r\na b:\n\nbody"), "ERR malformed MIME header: missing colon: \"k$a\\tb\""
  assert_eq mh("a b:v\r\n\t1\n\r\n"), "a b=[v 1]"
  assert_eq mh("X: é\n\r\n"), "X=[é]"
  assert_eq mh("x-Y_z :v\rFoo: é\nmy-keyx y z\n\r\n"), "ERR malformed MIME header line: \"x-Y_z :v\\rFoo: é\""
  assert_eq mh(" lead:é\n\r\n"), "ERR malformed MIME header initial line: \" lead:é\""
  assert_eq mh("Foo\tBar: \x7f\r\nk$\t:1\r\nX:\r   trailing  \nFoo\tBar v \r\n\t\x7f\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar: \\x7f\""
  assert_eq mh("a b:\t\x7f\r\n\r\nbody"), "ERR malformed MIME header line: \"a b:\\t\\x7f\""
  assert_eq mh("Foo\t:  trailing  \nCONTENT-type:: v \nCONTENT-type:\tx y z\r\n"), "ERR malformed MIME header line: \"Foo\\t:  trailing\""
  assert_eq mh(":\té\n  \ta\tb\rX\x01\r\n  \t\r\n"), "ERR malformed MIME header line: \":\\té a\\tb\\rX\\x01 \""
  assert_eq mh("a ba\tb\nFoo\tBar:\tv\r\nfoo bar \t:x y z\n\n"), "ERR malformed MIME header: missing colon: \"a ba\\tb\""
  assert_eq mh("Foo :x y z\r\n\r\nbody"), "Foo =[x y z]"
  assert_eq mh("a-1-c::  trailing  \na-1-c :a\tb\r\n\r\n"), "A-1-C=[:  trailing];a-1-c =[a\tb]"
  assert_eq mh("foo bar :\ta\tb\nx-Y_z::é\n  \t  trailing  \r\n"), "X-Y_z=[:é trailing];foo bar =[a\tb] +EOF"
  assert_eq mh("é\t:\r\né\t:a\tb\r\n\r\n"), "ERR malformed MIME header line: \"é\\t:\""
  assert_eq mh("foo bar :é\nFoo:: v \r\né  trailing  \n  v \nbody"), "ERR malformed MIME header: missing colon: \"é  trailing  \""
  assert_eq mh("a-1-c: \r\n\r\nbody"), "A-1-C=[]"
  assert_eq mh("foo bar : v\r"), "ERR malformed MIME header line: \"foo bar : v\\r\""
  assert_eq mh("Foo:1\n x y z\nk$::x y z\r\n:\t v \r\nfoo bar \t:é\r\n\r\n"), "ERR malformed MIME header line: \":\\t v\""
  assert_eq mh("my-key:é\r\r\n"), "ERR malformed MIME header line: \"My-Key:é\\r\""
  assert_eq mh("foo bar :\tv\r\nfoo bar ::  trailing  \r\na-1-c : v \r\nfoo bar :x y z\n\r\nbody"), "a-1-c =[v];foo bar =[v|:  trailing|x y z]"
  assert_eq mh("a b\t:  trailing  \r\n\n"), "ERR malformed MIME header line: \"a b\\t:  trailing\""
  assert_eq mh("CONTENT-type\t:x y z\r\r\nbody"), "ERR malformed MIME header line: \"CONTENT-type\\t:x y z\\r\""
  assert_eq mh("my-key:\t\x01\na-1-c v \rk$::a\tb\nFoo\tBar :v\n\r\n"), "ERR malformed MIME header line: \"My-Key:\\t\\x01\""
  assert_eq mh("x-Y_z:a\tb\n\r\n"), "X-Y_z=[a\tb]"
  assert_eq mh("Foo\tBar:\té\r\na-1-c1\n\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\té\""
  assert_eq mh("CONTENT-type::1\r\r\n"), "ERR malformed MIME header line: \"Content-Type::1\\r\""
  assert_eq mh("CONTENT-type\t:v\r\n\r\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:v\""
  assert_eq mh("Fooa\tb\nX\t:  trailing  \n \n\r\n"), "ERR malformed MIME header: missing colon: \"Fooa\\tb\""
  assert_eq mh("a-1-c :\x7f\r\n\t:é\r\n lead: v\na b:\tx y z\r\n\n"), "ERR malformed MIME header line: \"a-1-c :\\x7f :é lead: v\""
  assert_eq mh("a b\t:\x7f\rFoo\t:1\n\r\nbody"), "ERR malformed MIME header line: \"a b\\t:\\x7f\\rFoo\\t:1\""
  assert_eq mh("a b::\x7f\r\nmy-key :1\na-1-c :1\n"), "ERR malformed MIME header line: \"a b::\\x7f\""
  assert_eq mh("k$ v \r lead :v\r\n\nbody"), "ERR malformed MIME header line: \"k$ v \\r lead :v\""
  assert_eq mh("foo bar ::x y z\n\r\n"), "foo bar =[:x y z]"
  assert_eq mh("x-Y_z:\r\nbody"), "ERR malformed MIME header: missing colon: \"body\""
  assert_eq mh("foo bar a\tb\na-1-c: \x7f\n\ta\tb\nmy-key: x y z\n  \t\n\n"), "ERR malformed MIME header: missing colon: \"foo bar a\\tb\""
  assert_eq mh("é\x7f\r\n  \tv\nk$:\r\n\r\n"), "ERR malformed MIME header: missing colon: \"é\\x7f\""
  assert_eq mh("Foo\tBar:\x7f\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\x7f\""
  assert_eq mh("Foo\tBar\x01\n   trailing  \n\r\nbody"), "ERR malformed MIME header: missing colon: \"Foo\\tBar\\x01\""
  assert_eq mh("x-Y_z  trailing  \r\n\t1\r\na-1-c: \x7f\r\n lead\t:\r\n\n"), "ERR malformed MIME header: missing colon: \"x-Y_z  trailing  \""
  assert_eq mh(" :\x7f\n\t\nFoo\tBar\t: v \na-1-c: a\tb\n  \tv\r\nbody"), "ERR malformed MIME header initial line: \" :\\x7f\""
  assert_eq mh(" :  trailing  \r\nCONTENT-type\t:1\r\n \x7f\n lead:x y z\n\r\n"), "ERR malformed MIME header initial line: \" :  trailing  \""
  assert_eq mh(" lead :\x7f\rFoo: é\n  \t\r\r\n"), "ERR malformed MIME header initial line: \" lead :\\x7f\\rFoo: é\""
  assert_eq mh("Foo:\ta\tb\nFoo\tBarx y z\r\nX :x y z\r\na b\t:\x7f\n\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBarx y z\""
  assert_eq mh("a b:\t  trailing  \n v\r\nCONTENT-typex y z\ra b: \x7f\n  \t\x7f\r\n\nbody"), "ERR malformed MIME header line: \"CONTENT-typex y z\\ra b: \\x7f \\x7f\""
  assert_eq mh("X:\t\x7f\r\n\n"), "ERR malformed MIME header line: \"X:\\t\\x7f\""
}

test "vectors: mime header 2" {
  assert_eq mh("X:a\tb\r\n\t  trailing  \r\na b\t:\x01\n\r\n"), "ERR malformed MIME header line: \"a b\\t:\\x01\""
  assert_eq mh("Foo\tBar :  trailing  \r\n lead:\t v \r\r\n"), "ERR malformed MIME header line: \"Foo\\tBar :  trailing lead:\\t v \\r\""
  assert_eq mh("CONTENT-type:\t v \r\n lead:a\tb\nCONTENT-type::1\r\nk$:\tx y z\r"), "ERR malformed MIME header line: \"K$:\\tx y z\\r\""
  assert_eq mh("a b :v\r\n:\té\n  v \r\n\n"), "ERR malformed MIME header line: \":\\té v\""
  assert_eq mh("foo bar  :\r\n\té\n"), "foo bar  =[é] +EOF"
  assert_eq mh("CONTENT-type v \rFoo\tBar:\t\x01\r\n  \t\n"), "ERR malformed MIME header line: \"CONTENT-type v \\rFoo\\tBar:\\t\\x01 \""
  assert_eq mh("X::\x01\n\t  trailing  \nbody"), "ERR malformed MIME header line: \"X::\\x01 trailing\""
  assert_eq mh("x-Y_z:1\né: x y z\n\nbody"), "ERR malformed MIME header line: \"é: x y z\""
  assert_eq mh("Foov\r\nk$: é\na-1-c::\r\nbody"), "ERR malformed MIME header: missing colon: \"Foov\""
  assert_eq mh("a b:\x7f\r\n"), "ERR malformed MIME header line: \"a b:\\x7f\""
  assert_eq mh(" :\r\n\té\rmy-keyé\rFoo\tBar :\x7f\n v\r\n"), "ERR malformed MIME header initial line: \" :\""
  assert_eq mh("CONTENT-type:\t\x7f\n lead: \x7f\r\nX\x01\ra b: v\r\tx y z\r\n"), "ERR malformed MIME header line: \"Content-Type:\\t\\x7f lead: \\x7f\""
  assert_eq mh("x-Y_z :1\n\n"), "x-Y_z =[1]"
  assert_eq mh(" lead::a\tb\r\nk$: 1\r\nX::\x7f\r\t  trailing  \r\r\n"), "ERR malformed MIME header initial line: \" lead::a\\tb\""
  assert_eq mh("my-key\t:  trailing  \r\nFoo :1\nCONTENT-type :a\tb\nFoo\tBar:v\r\r\n"), "ERR malformed MIME header line: \"my-key\\t:  trailing\""
  assert_eq mh("my-key::v\n\tx y z\r\nFoo\tBar: \x7f\n\t:a\tb\n  \t v \nx-Y_z:: v \n  \t1\r\n"), "ERR malformed MIME header line: \"Foo\\tBar: \\x7f :a\\tb v\""
  assert_eq mh("Foo:   trailing  \n\r\n"), "Foo=[trailing]"
  assert_eq mh("foo bar :\t\r\na b:\t\ra b::x y z\r\n\n"), "ERR malformed MIME header line: \"a b:\\t\\ra b::x y z\""
  assert_eq mh("a-1-c::a\tb\na b\x01\n\r\n"), "ERR malformed MIME header: missing colon: \"a b\\x01\""
  assert_eq mh("a-1-c\t:\x01\na b\t:\r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:\\x01\""
  assert_eq mh("a-1-c\t:\x7f\nFoo\tBar:x y z\né:x y z\n\r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:\\x7f\""
  assert_eq mh("CONTENT-type::x y z\né:\t\r\r\n"), "ERR malformed MIME header line: \"é:\\t\\r\""
  assert_eq mh("::1\r\nfoo bar :\r v\na-1-ca\tb\nCONTENT-type:  v \r\n\r\n"), "ERR malformed MIME header line: \"::1\""
  assert_eq mh("k$a\tb\rCONTENT-type:\ta\tb\né:  trailing  \r\na-1-c :1\n\nbody"), "ERR malformed MIME header line: \"k$a\\tb\\rCONTENT-type:\\ta\\tb\""
  assert_eq mh("foo bar : 1\r\nx-Y_z :v\r\n\t  trailing  \n\r\n"), "foo bar =[1];x-Y_z =[v trailing]"
  assert_eq mh("k$::\na-1-c::\nmy-key::1\r\nX\n\r\nbody"), "ERR malformed MIME header: missing colon: \"X\""
  assert_eq mh("x-Y_z:\t v \r\n x y z\nX::\x7f\ré :a\tb\r\nmy-key\t:\r\r\nbody"), "ERR malformed MIME header line: \"X::\\x7f\\ré :a\\tb\""
  assert_eq mh("Foo :\x7f\r\n"), "ERR malformed MIME header line: \"Foo :\\x7f\""
  assert_eq mh("my-keya\tb\r\n\r\nbody"), "ERR malformed MIME header: missing colon: \"my-keya\\tb\""
  assert_eq mh("k$ :1\r\n"), "k$ =[1] +EOF"
  assert_eq mh("Foo\tBar:\t v \n \x01\ré :\x01\r\nFoo\x7f\r\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\t v \\x01\\ré :\\x01\""
  assert_eq mh("Foo\tBar: v\r\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar: v\\r\""
  assert_eq mh("my-key:\tx y z\n\tx y z\rx-Y_z: x y z\r\nFoo: v\r\n"), "ERR malformed MIME header line: \"My-Key:\\tx y z x y z\\rx-Y_z: x y z\""
  assert_eq mh(" lead::x y z\né :x y z\r\r\n"), "ERR malformed MIME header initial line: \" lead::x y z\""
  assert_eq mh("a-1-c\t:\n\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:\""
  assert_eq mh("CONTENT-type: v \r\n  \t\n\r\n"), "Content-Type=[v ]"
  assert_eq mh(" lead:a\tb\n  \t  trailing  \n\n"), "ERR malformed MIME header initial line: \" lead:a\\tb\""
  assert_eq mh("foo bar : 1\r  \té\na-1-c\t:  trailing  \nFoo:\té\r\t  trailing  \n\r\n"), "ERR malformed MIME header line: \"foo bar : 1\\r  \\té\""
  assert_eq mh("x-Y_z :é\r\n\n"), "x-Y_z =[é]"
  assert_eq mh(" lead:\t  trailing  \r\n: 1\nmy-key: v\r\r\n"), "ERR malformed MIME header initial line: \" lead:\\t  trailing  \""
  assert_eq mh("Foo:\t1\r 1\r\na b\t:x y z\r\n \né\t:\x7f\r\nCONTENT-type\t:1\r\n\r\n"), "ERR malformed MIME header line: \"Foo:\\t1\\r 1\""
  assert_eq mh("k$\t:a\tb\nx-Y_z::é\n\r\nbody"), "ERR malformed MIME header line: \"k$\\t:a\\tb\""
  assert_eq mh("é :é\n:\t v \r\nFoo:\té\r\n\r\nbody"), "ERR malformed MIME header line: \"é :é\""
  assert_eq mh("CONTENT-typex y z\nfoo bar ::a\tb\rFoo\tBar\t:  trailing  \n\té\n\r\n"), "ERR malformed MIME header: missing colon: \"CONTENT-typex y z\""
  assert_eq mh("é::\x7f\né :a\tb\r\n: v\né :1\n\r\n"), "ERR malformed MIME header line: \"é::\\x7f\""
  assert_eq mh("X :\x7f\na-1-c:\ta\tb\na b::é\nk$::x y z\n\r\n"), "ERR malformed MIME header line: \"X :\\x7f\""
  assert_eq mh("Foo\t:\r\na-1-c: \r\n"), "ERR malformed MIME header line: \"Foo\\t:\""
  assert_eq mh("k$: v \rFoo\tBar\t:  trailing  \n::v\n\nbody"), "ERR malformed MIME header line: \"K$: v \\rFoo\\tBar\\t:  trailing\""
  assert_eq mh("a-1-c: a\tb\n\r\n"), "A-1-C=[a\tb]"
  assert_eq mh("a b :1\n  \t\x7f\ra-1-c :a\tb\rx-Y_z:a\tb\r   trailing  \r\nbody"), "ERR malformed MIME header line: \"a b :1 \\x7f\\ra-1-c :a\\tb\\rx-Y_z:a\\tb\\r   trailing\""
  assert_eq mh("CONTENT-type::x y z\n\tx y z\rk$: x y z\nCONTENT-type:é\n"), "ERR malformed MIME header line: \"Content-Type::x y z x y z\\rk$: x y z\""
  assert_eq mh(":\t1\ra b : v \n\r\n"), "ERR malformed MIME header line: \":\\t1\\ra b : v\""
  assert_eq mh("a-1-c:\x01\r\n x y z\r\nfoo bar \r\nfoo bar ::a\tb\r\n\ta\tb\r\n"), "ERR malformed MIME header line: \"A-1-C:\\x01 x y z\""
  assert_eq mh("k$:\x01\n  \té\n lead:\t\x7f\r\n lead::1\r\n  \t  trailing  \r\nbody"), "ERR malformed MIME header line: \"K$:\\x01 é lead:\\t\\x7f lead::1 trailing\""
  assert_eq mh("a-1-c::é\rx-Y_z :\x01\nCONTENT-type:\t v \né:\x7f\r\n\n"), "ERR malformed MIME header line: \"A-1-C::é\\rx-Y_z :\\x01\""
  assert_eq mh("Foo:\t1\na b:\tv\nfoo bar  :\x7f\r\n\r\n"), "ERR malformed MIME header line: \"foo bar  :\\x7f\""
  assert_eq mh("foo bar  :a\tb\r\nFoo\tBar  trailing  \r \x01\rfoo bar  :v\n\t\x01\r\n lead:   trailing  \r\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar  trailing  \\r \\x01\\rfoo bar  :v \\x01 lead:   trailing  \\r\""
  assert_eq mh("Foo\tBar  trailing  \r  \t\x01\n\r\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBar  trailing  \\r  \\t\\x01\""
  assert_eq mh("x-Y_za\tb\n  \t  trailing  \nFoo:\té\r\n"), "ERR malformed MIME header: missing colon: \"x-Y_za\\tb\""
  assert_eq mh("a-1-c::a\tb\r\n\r\n"), "A-1-C=[:a\tb]"
  assert_eq mh("foo bar \t:\x7f\né:  v \r\nx-Y_z :v\r\tx y z\r\nbody"), "ERR malformed MIME header line: \"foo bar \\t:\\x7f\""
  assert_eq mh("a b  trailing  \r\n \nx-Y_z:\té\nx-Y_z: \r"), "ERR malformed MIME header: missing colon: \"a b  trailing  \""
  assert_eq mh("a b: v \nCONTENT-type:1\n v\r\n\r\nbody"), "Content-Type=[1 v];a b=[v]"
  assert_eq mh("x-Y_z\t:1\n  \t\r\nX :é\nX :\r\r\n"), "ERR malformed MIME header line: \"x-Y_z\\t:1 \""
  assert_eq mh("a-1-c: v \r\nfoo bar : x y z\n\r\n"), "A-1-C=[v];foo bar =[x y z]"
  assert_eq mh("Foo:\t\x01\r\n\ta\tb\r\n\nbody"), "ERR malformed MIME header line: \"Foo:\\t\\x01 a\\tb\""
  assert_eq mh("my-key: a\tb\r\t v \n lead:\tx y z\r  \tv\n\r\n"), "ERR malformed MIME header line: \"My-Key: a\\tb\\r\\t v lead:\\tx y z\\r  \\tv\""
  assert_eq mh("my-key :é\r\nmy-key::\x7f\n\nbody"), "ERR malformed MIME header line: \"My-Key::\\x7f\""
  assert_eq mh("my-key\t:v\r\nbody"), "ERR malformed MIME header line: \"my-key\\t:v\""
  assert_eq mh("x-Y_z\t:é\nmy-key::v\n 1\r\nmy-key:  trailing  \r\n"), "ERR malformed MIME header line: \"x-Y_z\\t:é\""
  assert_eq mh("a bé\n é\ra b v \r  trailing  \nk$:\t\r\r\n"), "ERR malformed MIME header: missing colon: \"a bé\""
  assert_eq mh("my-key:  trailing  \r\na-1-c: 1\r\n"), "A-1-C=[1];My-Key=[trailing] +EOF"
  assert_eq mh("x-Y_z:\ta\tb\nFoo::\x7f\r\nCONTENT-type::é\n\r\n"), "ERR malformed MIME header line: \"Foo::\\x7f\""
  assert_eq mh("Fooa\tb\ré\t:v\rFoo\tBar:\t\x7f\n  \t v \rx-Y_z\t:\x01\r é\r\n\r\nbody"), "ERR malformed MIME header line: \"Fooa\\tb\\ré\\t:v\\rFoo\\tBar:\\t\\x7f v \\rx-Y_z\\t:\\x01\\r é\""
  assert_eq mh("k$:a\tb\nmy-key::v\nFoo\tBar::\x7f\r\n \r\n::\x7f\n"), "ERR malformed MIME header line: \"Foo\\tBar::\\x7f \""
  assert_eq mh("my-key:\t\x01\ra b\t:x y z\r::\x01\na-1-c :a\tb\r\n\n"), "ERR malformed MIME header line: \"My-Key:\\t\\x01\\ra b\\t:x y z\\r::\\x01\""
  assert_eq mh("Foox y z\n\r\nbody"), "ERR malformed MIME header: missing colon: \"Foox y z\""
  assert_eq mh("my-key :  trailing  \n\tx y z\r\n lead:\ta\tb\n  \tv\r\nx-Y_z\t:x y z\n x y z\r\n\r\n"), "ERR malformed MIME header line: \"x-Y_z\\t:x y z x y z\""
  assert_eq mh("CONTENT-type :\x7f\r\nCONTENT-typev\n"), "ERR malformed MIME header line: \"CONTENT-type :\\x7f\""
  assert_eq mh("Foo\tBar: x y z\r\nFoo:  trailing  \r\nk$::é\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar: x y z\""
  assert_eq mh("foo bar é\r\n lead\x01\r\n \x01\nmy-key:é\r \n"), "ERR malformed MIME header: missing colon: \"foo bar é\""
}

test "vectors: mime header 3" {
  assert_eq mh("a b: \na b: 1\r\nFoo::  trailing  \r\n  \ta\tb\r\r\nbody"), "ERR malformed MIME header line: \"Foo::  trailing a\\tb\\r\""
  assert_eq mh("x-Y_z:a\tb\ré :a\tb\r\n\r\nbody"), "ERR malformed MIME header line: \"X-Y_z:a\\tb\\ré :a\\tb\""
  assert_eq mh("Foo:\r\n\t\x01\r\nFoo\tBar::\x7f\nbody"), "ERR malformed MIME header line: \"Foo: \\x01\""
  assert_eq mh("x-Y_z: v \na-1-c:\t\n\nbody"), "A-1-C=[];X-Y_z=[v]"
  assert_eq mh("a b: v \r\n:\x7f\r\t  trailing  \n\nbody"), "ERR malformed MIME header line: \":\\x7f\\r\\t  trailing\""
  assert_eq mh("::a\tb\r\n   trailing  \r\né :\r\n\n"), "ERR malformed MIME header line: \"::a\\tb trailing\""
  assert_eq mh("a b: v \né:\tx y z\na b: \x7f\r\n \r\nfoo bar :v\n\t v \n\r\n"), "ERR malformed MIME header line: \"é:\\tx y z\""
  assert_eq mh("foo bar :1\nmy-key:é\r\n a\tb\n\r\n"), "My-Key=[é a\tb];foo bar =[1]"
  assert_eq mh("a-1-c v \ré:v\nk$\x01\r\n lead :x y z\n"), "ERR malformed MIME header line: \"a-1-c v \\ré:v\""
  assert_eq mh("Foo\tBar\x01\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBar\\x01\""
  assert_eq mh("a b :x y z\n lead :v\n lead: x y z\n\r\n"), "a b =[x y z lead :v lead: x y z]"
  assert_eq mh("a-1-c:a\tb\nFoo\tBar:\r\t\x01\nFoo\tBar: \x7f\n  \té\nCONTENT-type: x y z\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar:\\r\\t\\x01\""
  assert_eq mh("foo bar \t:\x01\r\n  \t  trailing  \nCONTENT-type::\x7f\n\r\n"), "ERR malformed MIME header line: \"foo bar \\t:\\x01 trailing\""
  assert_eq mh("a-1-c:1\n\r\n"), "A-1-C=[1]"
  assert_eq mh("a-1-c::é\r\n  \t\x01\na b:é\nbody"), "ERR malformed MIME header line: \"A-1-C::é \\x01\""
  assert_eq mh("a b\t:\r\nk$: é\n\r\n"), "ERR malformed MIME header line: \"a b\\t:\""
  assert_eq mh(":: v \r\nbody"), "ERR malformed MIME header line: \":: v\""
  assert_eq mh(" leadx y z\r\n"), "ERR malformed MIME header initial line: \" leadx y z\""
  assert_eq mh("Foo\t:x y z\n\r\n"), "ERR malformed MIME header line: \"Foo\\t:x y z\""
  assert_eq mh("a-1-c:\ta\tb\r\n\r\n"), "A-1-C=[a\tb]"
  assert_eq mh("Foo\tBar:é\r\n\tv\rCONTENT-type: \x7f\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:é v\\rCONTENT-type: \\x7f\""
  assert_eq mh("a b:\tx y z\r é\n"), "ERR malformed MIME header line: \"a b:\\tx y z\\r é\""
  assert_eq mh("CONTENT-type::v\r\n\r\n"), "Content-Type=[:v]"
  assert_eq mh("a b  trailing  \n\ta\tb\r\nFoo\tBar:x y z\r\nX:\t v \n  \t\x01\nmy-key :\r\n\r\nbody"), "ERR malformed MIME header: missing colon: \"a b  trailing  \""
  assert_eq mh("foo bar \t:x y z\r  \t  trailing  \r\nCONTENT-type::a\tb\né: x y z\r\n\tv\r\n\r\n"), "ERR malformed MIME header line: \"foo bar \\t:x y z\\r  \\t  trailing\""
  assert_eq mh("my-key\ré: \x01\r\nX:   trailing  \r\n"), "ERR malformed MIME header line: \"my-key\\ré: \\x01\""
  assert_eq mh("foo bar  :\x01\n\r\n"), "ERR malformed MIME header line: \"foo bar  :\\x01\""
  assert_eq mh("a-1-c:\tx y z\r\nx-Y_z\t:\x7f\rmy-key\x01\n\r\nbody"), "ERR malformed MIME header line: \"x-Y_z\\t:\\x7f\\rmy-key\\x01\""
  assert_eq mh("a b :\x7f\r\na-1-c\t:\rFoo:\t v \r lead::é\r"), "ERR malformed MIME header line: \"a b :\\x7f\""
  assert_eq mh("a-1-c :x y z\r\n lead: é\na-1-c : v \r\t1\nX:\ta\tb\n\n"), "ERR malformed MIME header line: \"a-1-c : v \\r\\t1\""
  assert_eq mh("foo bar  :x y z\n \na-1-c v \nx-Y_z :\x7f\nmy-key:   trailing  \r\nbody"), "ERR malformed MIME header: missing colon: \"a-1-c v \""
  assert_eq mh("a-1-c\x7f\r\n\r\n"), "ERR malformed MIME header: missing colon: \"a-1-c\\x7f\""
  assert_eq mh("é:\t\x01\r\nx-Y_z\t:\r\nFoo:é\r\n\n"), "ERR malformed MIME header line: \"é:\\t\\x01\""
  assert_eq mh("Foo\tBar\x01\r\r\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBar\\x01\\r\""
  assert_eq mh("k$: \n lead\t:x y z\ra-1-c\t:1\r\n\r\nbody"), "ERR malformed MIME header line: \"K$: lead\\t:x y z\\ra-1-c\\t:1\""
  assert_eq mh("foo bar : \x01\r\nx-Y_z :\rk$\t:  trailing  \r\n"), "ERR malformed MIME header line: \"foo bar : \\x01\""
  assert_eq mh("my-key::x y z\r\r\nbody"), "ERR malformed MIME header line: \"My-Key::x y z\\r\""
  assert_eq mh("CONTENT-type:\t  trailing  \nFoo :  trailing  \r\nk$::x y z\n\n"), "Content-Type=[trailing];Foo =[trailing];K$=[:x y z]"
  assert_eq mh("Foo:x y z\n lead: x y z\r\nmy-key:\t\x01\r\nFoo\tBar\t:\x01\n  \tv\r\n\r\n"), "ERR malformed MIME header line: \"My-Key:\\t\\x01\""
  assert_eq mh("my-key: é\r é\nFoo\tBar:\x7f\né\t:v\r\n  \t\r\nbody"), "ERR malformed MIME header line: \"My-Key: é\\r é\""
  assert_eq mh("X\t:\x7f\r\n \r\n\r\n"), "ERR malformed MIME header line: \"X\\t:\\x7f \""
  assert_eq mh("a-1-c\t:é\r: v\nfoo bar é\n  \té\n:a\tb\r\r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:é\\r: v\""
  assert_eq mh(" lead:x y z\n\nbody"), "ERR malformed MIME header initial line: \" lead:x y z\""
  assert_eq mh("Foo\tBarx y z\r lead  trailing  \r\nbody"), "ERR malformed MIME header: missing colon: \"Foo\\tBarx y z\\r lead  trailing  \""
  assert_eq mh("é\x7f\nx-Y_z:\tv\n\n"), "ERR malformed MIME header: missing colon: \"é\\x7f\""
  assert_eq mh("X: \x7f\r\t\r\n"), "ERR malformed MIME header line: \"X: \\x7f\\r\""
  assert_eq mh("é:\t\x7f\n lead:\tv\nx-Y_z\t:é\n:\x01\n\r\n"), "ERR malformed MIME header line: \"é:\\t\\x7f lead:\\tv\""
  assert_eq mh("Foo :  trailing  \na b::x y z\n a\tb\r\né::\r"), "ERR malformed MIME header line: \"é::\\r\""
  assert_eq mh("Foo\t:  trailing  \nFoo\tBar\t:1\n\t1\r\n:\t\r\nmy-key:\tv\n\r\nbody"), "ERR malformed MIME header line: \"Foo\\t:  trailing\""
  assert_eq mh("é\t:  trailing  \n\r\nbody"), "ERR malformed MIME header line: \"é\\t:  trailing\""
  assert_eq mh("x-Y_z: v\r\t\x01\n"), "ERR malformed MIME header line: \"X-Y_z: v\\r\\t\\x01\""
  assert_eq mh(":\t\r\nmy-key:\té\r\n  \té\nx-Y_z\t:v\r\r\n"), "ERR malformed MIME header line: \":\""
  assert_eq mh("é:  trailing  \rfoo bar a\tb\r\nFoo:1\r\nfoo bar  :x y z\r\n"), "ERR malformed MIME header line: \"é:  trailing  \\rfoo bar a\\tb\""
  assert_eq mh(" leadé\n   trailing  \rCONTENT-type: \x01\r\n\tv\n\r\n"), "ERR malformed MIME header initial line: \" leadé\""
  assert_eq mh("Foo:a\tb\r\n  \t\r"), "ERR malformed MIME header line: \"Foo:a\\tb \\r\""
  assert_eq mh(" lead\t:  trailing  \na-1-c:a\tb\r\na b: a\tb\r\na b:é\n\r\n"), "ERR malformed MIME header initial line: \" lead\\t:  trailing  \""
  assert_eq mh("my-key:a\tb\r"), "ERR malformed MIME header line: \"My-Key:a\\tb\\r\""
  assert_eq mh("my-key::v\nFoo\tBar :\r\n\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar :\""
  assert_eq mh("X\t:x y z\r\n\t\r\na b : v \n   trailing  \r\na-1-c : v \n\t\x7f\nk$::1\r\n\n"), "ERR malformed MIME header line: \"X\\t:x y z \""
  assert_eq mh("foo bar :é\n\t\x7f\r\na b: a\tb\r\n\r\n"), "ERR malformed MIME header line: \"foo bar :é \\x7f\""
  assert_eq mh("é:x y z\r\n:\ta\tb\nCONTENT-type: a\tb\r\r\nbody"), "ERR malformed MIME header line: \"é:x y z\""
  assert_eq mh(" lead\r\na b:   trailing  \rCONTENT-type::a\tb\né : v \n\r\n"), "ERR malformed MIME header initial line: \" lead\""
  assert_eq mh("CONTENT-type :\x7f\r\n   trailing  \nX:\t v \né\t:a\tb\r\n  \ta\tb\né :\x7f\r\n\nbody"), "ERR malformed MIME header line: \"CONTENT-type :\\x7f trailing\""
  assert_eq mh("my-key\t:é\r\r\n"), "ERR malformed MIME header line: \"my-key\\t:é\\r\""
  assert_eq mh(" lead: v\r\n  \tx y z\ra-1-c: 1\ra b:   trailing  \r\n\r\n"), "ERR malformed MIME header initial line: \" lead: v\""
  assert_eq mh("é\t:v\r\n lead\t:\x7f\r\nFoo\tBar:\x01\r\n  \tx y z\r\nbody"), "ERR malformed MIME header line: \"é\\t:v lead\\t:\\x7f\""
  assert_eq mh("a-1-c\t:x y z\nFoo\tBar :\r\nmy-key\t:v\r\n\r\n"), "ERR malformed MIME header line: \"a-1-c\\t:x y z\""
  assert_eq mh("k$ :\n lead:é\nmy-key: 1\n\r\nbody"), "My-Key=[1];k$ =[lead:é]"
  assert_eq mh("CONTENT-type :é\n lead::\x7f\nfoo bar ::1\nbody"), "ERR malformed MIME header line: \"CONTENT-type :é lead::\\x7f\""
  assert_eq mh("CONTENT-type\t:\x7f\r\na b\t:\n\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:\\x7f\""
  assert_eq mh(" lead\t:  trailing  \r\n"), "ERR malformed MIME header initial line: \" lead\\t:  trailing  \""
  assert_eq mh("x-Y_z:\x7f\r\r\n"), "ERR malformed MIME header line: \"X-Y_z:\\x7f\\r\""
  assert_eq mh(" lead:\tx y z\n  \t  trailing  \nbody"), "ERR malformed MIME header initial line: \" lead:\\tx y z\""
  assert_eq mh("k$::\x01\n\nbody"), "ERR malformed MIME header line: \"K$::\\x01\""
  assert_eq mh("\t:1\r\nmy-key\t:1\rx-Y_z::\rbody"), "ERR malformed MIME header initial line: \"\\t:1\""
  assert_eq mh(" lead\t:v\na b:\ta\tb\r\n"), "ERR malformed MIME header initial line: \" lead\\t:v\""
  assert_eq mh(" lead::é\n  \t\r\nmy-key:\tv\r\nbody"), "ERR malformed MIME header initial line: \" lead::é\""
  assert_eq mh("a-1-c:\t\x01\r\n \r:\ta\tb\rX:\x7f\n\r\nbody"), "ERR malformed MIME header line: \"A-1-C:\\t\\x01 \\r:\\ta\\tb\\rX:\\x7f\""
  assert_eq mh("CONTENT-type:  v \r  \ta\tb\r\n\nbody"), "ERR malformed MIME header line: \"Content-Type:  v \\r  \\ta\\tb\""
  assert_eq mh("CONTENT-type::1\rx-Y_z :v\r\n\n"), "ERR malformed MIME header line: \"Content-Type::1\\rx-Y_z :v\""
  assert_eq mh("my-key\t:\n a\tb\r\nbody"), "ERR malformed MIME header line: \"my-key\\t: a\\tb\""
}

test "vectors: mime header 4" {
  assert_eq mh("a b :  trailing  \r\n\ta\tb\r\n\r\nbody"), "a b =[trailing a\tb]"
  assert_eq mh(": v \né:\t\x7f\n   trailing  \nFoov\na b\x01\n\t\x7f\n\r\n"), "ERR malformed MIME header line: \": v\""
  assert_eq mh("foo bar ::\r\nFoo\tBar v \nk$: é\nfoo bar  :\x7f\r\r\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBar v \""
  assert_eq mh("é :  trailing  \r\nfoo bar ::x y z\r\nX\x01\nFoo\tBar :\x01\r\n\t\x01\r\n"), "ERR malformed MIME header line: \"é :  trailing\""
  assert_eq mh("X\t:v\r\n\nbody"), "ERR malformed MIME header line: \"X\\t:v\""
  assert_eq mh("X:é\rfoo bar :\tx y z\n\n"), "ERR malformed MIME header line: \"X:é\\rfoo bar :\\tx y z\""
  assert_eq mh("é :x y z\r\n\tx y z\r\nfoo bar ::v\r\nx-Y_z:v\n  \tx y z\r\nbody"), "ERR malformed MIME header line: \"é :x y z x y z\""
  assert_eq mh("X\t:\x01\n\n"), "ERR malformed MIME header line: \"X\\t:\\x01\""
  assert_eq mh("a bx y z\r\r\nbody"), "ERR malformed MIME header: missing colon: \"a bx y z\\r\""
  assert_eq mh("x-Y_z::\x7f\r\nFoo:\t\x7f\n  \t v \rFoox y z\r x y z\r\n\n"), "ERR malformed MIME header line: \"X-Y_z::\\x7f\""
  assert_eq mh("X :\r\n\t\né: é\n\r\nbody"), "ERR malformed MIME header line: \"é: é\""
  assert_eq mh(" lead:\t\x7f\n:1\n"), "ERR malformed MIME header initial line: \" lead:\\t\\x7f\""
  assert_eq mh("Foo:é\n\r\n"), "Foo=[é]"
  assert_eq mh("foo bar :x y z\nCONTENT-type: v \nFoo\t:\r\nFoo:\t v \n  \t1\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\t:\""
  assert_eq mh("é\t:v\nx-Y_za\tb\r\nFoo\tBar: \x01\n\r\n"), "ERR malformed MIME header line: \"é\\t:v\""
  assert_eq mh("X:\t  trailing  \r\na-1-c\t:  trailing  \n  \t\x7f\nx-Y_z:\t\x01\r\n::v\n  v \r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:  trailing \\x7f\""
  assert_eq mh("X v \nFoo\r\na b:é\r\nX:1\r\nbody"), "ERR malformed MIME header: missing colon: \"X v \""
  assert_eq mh("foo bar é\r \x7f\n :1\nmy-key :x y z\r\n  \tv\nFoo\tBar:  v \r\n  \t1\r\n"), "ERR malformed MIME header: missing colon: \"foo bar é\\r \\x7f\""
  assert_eq mh("a b\x7f\na b:a\tb\r\na b:\tv\nbody"), "ERR malformed MIME header: missing colon: \"a b\\x7f\""
  assert_eq mh("foo bar :\tv\r\na b::x y z\r\na-1-c\t:x y z\na-1-c  trailing  \r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:x y z\""
  assert_eq mh("a b::x y z\r \x01\r\n"), "ERR malformed MIME header line: \"a b::x y z\\r \\x01\""
  assert_eq mh("Foo:v\na-1-c:\ta\tb\r\n\r\n"), "A-1-C=[a\tb];Foo=[v]"
  assert_eq mh("a-1-c:x y z\r\nFoo:   trailing  \r\n a\tb\n\n"), "A-1-C=[x y z];Foo=[trailing a\tb]"
  assert_eq mh(" lead::\r\né:a\tb\r\na b::a\tb\n"), "ERR malformed MIME header initial line: \" lead::\""
  assert_eq mh("a-1-c:1\nCONTENT-typeé\ra b::\x7f\r\n\t\x7f\r\n\r\n"), "ERR malformed MIME header line: \"CONTENT-typeé\\ra b::\\x7f \\x7f\""
  assert_eq mh("CONTENT-type:\t\r\t:a\tb\r\nfoo bar  v \n  \tv\nx-Y_z: é\r\n\r\n"), "ERR malformed MIME header line: \"Content-Type:\\t\\r\\t:a\\tb\""
  assert_eq mh("k$::1\r\t:\n\t\n\n"), "ERR malformed MIME header line: \"K$::1\\r\\t: \""
  assert_eq mh("x-Y_z::  trailing  \r\nFoo:\tv\r\nFoo\t: v \r\nfoo bar :\t\x01\n\n"), "ERR malformed MIME header line: \"Foo\\t: v\""
  assert_eq mh("a b::v\r\n\r\n"), "a b=[:v]"
  assert_eq mh("X::é\nFoo\tBar: x y z\nFoo: a\tb\r\nmy-key: é\r\r\n"), "ERR malformed MIME header line: \"Foo\\tBar: x y z\""
  assert_eq mh("my-key:a\tb\n\t:\x7f\rX:x y z\n"), "ERR malformed MIME header line: \"My-Key:a\\tb :\\x7f\\rX:x y z\""
  assert_eq mh(" lead:a\tb\na b :\x01\rmy-key :1\r\n\r\nbody"), "ERR malformed MIME header initial line: \" lead:a\\tb\""
  assert_eq mh("foo bar ::x y z\n\té\r\na-1-c :x y z\n  \ta\tb\r\na-1-c :\x7f\r\n \x01\na-1-c\t:a\tb\n"), "ERR malformed MIME header line: \"a-1-c :\\x7f \\x01\""
  assert_eq mh("Foo\tBar: \x7f\n  \té\rFoo\tBar\t:  trailing  \n\tx y z\n\n"), "ERR malformed MIME header line: \"Foo\\tBar: \\x7f é\\rFoo\\tBar\\t:  trailing x y z\""
  assert_eq mh("my-key :a\tb\r\n\nbody"), "my-key =[a\tb]"
  assert_eq mh("my-key :  trailing  \n\t1\r"), "ERR malformed MIME header line: \"my-key :  trailing 1\\r\""
  assert_eq mh("CONTENT-type:\tx y z\n\tx y z\r\n\r\nbody"), "Content-Type=[x y z x y z]"
  assert_eq mh("X\t: v \rx-Y_z: 1\r\n  \t v \r\n lead\t:\x7f\n\r\nbody"), "ERR malformed MIME header line: \"X\\t: v \\rx-Y_z: 1 v lead\\t:\\x7f\""
  assert_eq mh("X : v \r:\tx y z\r\n"), "ERR malformed MIME header line: \"X : v \\r:\\tx y z\""
  assert_eq mh("a-1-c\t:\x7f\r\nfoo bar   trailing  \rFoo:\té\r\n 1\nFoo :\x01\r\n\n"), "ERR malformed MIME header line: \"a-1-c\\t:\\x7f\""
  assert_eq mh("foo bar : v \r\né : v \na-1-cx y z\n\r\nbody"), "ERR malformed MIME header line: \"é : v\""
  assert_eq mh("Xx y z\nFoo\t:x y z\n \x7f\n:\tv\n 1\r\n\r\n"), "ERR malformed MIME header: missing colon: \"Xx y z\""
  assert_eq mh("x-Y_z:\t1\n\t\x01\r\nmy-key: \x7f\nFoo:é\n  \t\n\n"), "ERR malformed MIME header line: \"X-Y_z:\\t1 \\x01\""
  assert_eq mh("::é\r\n\r\n"), "ERR malformed MIME header line: \"::é\""
  assert_eq mh("Foo\tBar::é\nmy-key::é\r\nCONTENT-type:é\nX:\ta\tb\r\n\n"), "ERR malformed MIME header line: \"Foo\\tBar::é\""
  assert_eq mh("my-key v \r  \t  trailing  \r\n\r\nbody"), "ERR malformed MIME header: missing colon: \"my-key v \\r  \\t  trailing  \""
  assert_eq mh("Foo\tBar:\t\x7f\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\t\\x7f\""
  assert_eq mh("é::\x7f\r\nfoo bar v\r\r\n"), "ERR malformed MIME header line: \"é::\\x7f\""
  assert_eq mh("::x y z\rfoo bar ::a\tb\n\r\n"), "ERR malformed MIME header line: \"::x y z\\rfoo bar ::a\\tb\""
  assert_eq mh("Foo\tBar::é\n\t\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar::é \""
  assert_eq mh("a-1-c:: v \r\né::\n:\ta\tb\n\nbody"), "ERR malformed MIME header line: \"é::\""
  assert_eq mh("X:\tx y z\r\n:é\r\n\r\n"), "ERR malformed MIME header line: \":é\""
  assert_eq mh("k$:\t v \na-1-c\t:\r\nmy-key : v \nFoo\tBar:\tv\n\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:\""
  assert_eq mh("CONTENT-type :v\r\nXv\r\n 1\r\nk$:é\nX :\x7f\n\n"), "ERR malformed MIME header: missing colon: \"Xv\""
  assert_eq mh("é:\t\nfoo bar :\ta\tb\r  \t\n\r\nbody"), "ERR malformed MIME header line: \"é:\""
  assert_eq mh(":   trailing  \r\n\r\n"), "ERR malformed MIME header line: \":   trailing\""
  assert_eq mh("foo bar :\té\r\n\n"), "foo bar =[é]"
  assert_eq mh("my-key\t:a\tb\r\né: \x7f\nmy-key :é\r\n  \t\r\n"), "ERR malformed MIME header line: \"my-key\\t:a\\tb\""
  assert_eq mh("x-Y_z:\x01\r\na b:a\tb\nCONTENT-type:v\nFoo\tBarx y z\r\n"), "ERR malformed MIME header line: \"X-Y_z:\\x01\""
  assert_eq mh("my-key :1\r\né:\t\x7f\nx-Y_z\t:1\n\tx y z\nfoo bar \t: v \r\n\r\n"), "ERR malformed MIME header line: \"é:\\t\\x7f\""
  assert_eq mh("CONTENT-type :  trailing  \n  \té\r\n\nbody"), "CONTENT-type =[trailing é]"
  assert_eq mh("CONTENT-type\x7f\r\nfoo bar ::\r\n\n"), "ERR malformed MIME header: missing colon: \"CONTENT-type\\x7f\""
  assert_eq mh("X:\t v \rfoo bar \t:\r\n\tv\n\n"), "ERR malformed MIME header line: \"X:\\t v \\rfoo bar \\t: v\""
  assert_eq mh("CONTENT-type\t:\x7f\n  \t1\r\nX::  trailing  \r\n\r\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:\\x7f 1\""
  assert_eq mh("CONTENT-typev\r\n\r\n"), "ERR malformed MIME header: missing colon: \"CONTENT-typev\""
  assert_eq mh("X:\t1\n lead v \r\n"), "X=[1 lead v] +EOF"
  assert_eq mh("::  trailing  \r\t\r\n\nbody"), "ERR malformed MIME header line: \"::  trailing  \\r\""
  assert_eq mh(" lead:\x7f\r\n  \t1\r\né\t:1\nk$::\n\n"), "ERR malformed MIME header initial line: \" lead:\\x7f\""
  assert_eq mh(": v\rk$::a\tb\r\nfoo bar  :\r\n \x01\r\nx-Y_z: é\r  \t\x01\n\n"), "ERR malformed MIME header line: \": v\\rk$::a\\tb\""
  assert_eq mh("k$:\t\x01\r\na-1-c::v\r\n   trailing  \r\nFoo\tBar\t:é\r"), "ERR malformed MIME header line: \"K$:\\t\\x01\""
  assert_eq mh("é::x y z\r\n  v \rx-Y_z  trailing  \na-1-c::\x7f\r\n\n"), "ERR malformed MIME header line: \"é::x y z v \\rx-Y_z  trailing\""
  assert_eq mh(" lead: é\r\n\t1\nx-Y_z :\x7f\r  \ta\tb\nfoo bar :\t\n\n"), "ERR malformed MIME header initial line: \" lead: é\""
  assert_eq mh("Foo:\t\n:v\r\nX :é\r\na-1-c:x y z\n\r\n"), "ERR malformed MIME header line: \":v\""
  assert_eq mh("foo bar :\t\r\nfoo bar :  v \n  v \né\t:\n  \t  trailing  \r\nx-Y_z:\x01\n v\r\n\nbody"), "ERR malformed MIME header line: \"é\\t: trailing\""
  assert_eq mh("a b:\t  trailing  \r\n\ta\tb\r\nx-Y_zv\n\r\n"), "ERR malformed MIME header: missing colon: \"x-Y_zv\""
  assert_eq mh("CONTENT-type\t:\x01\n  \t\x7f\rCONTENT-type:\x01\r\n\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:\\x01 \\x7f\\rCONTENT-type:\\x01\""
  assert_eq mh("Foo\t:x y z\r\n  \t\x01\r\nFoo\t:\x01\n\nbody"), "ERR malformed MIME header line: \"Foo\\t:x y z \\x01\""
  assert_eq mh(" lead:\x01\n\t\x01\r\nfoo bar \t:1\n\x7f\r v\r\n\r\n"), "ERR malformed MIME header initial line: \" lead:\\x01\""
}

test "vectors: mime header 5" {
  assert_eq mh("Foo\tBar :a\tb\r\n  \t\x01\r\nfoo bar ::é\r\n  \tx y z\r\né: \x7f\nfoo bar :\tx y z\r\n v\n\n"), "ERR malformed MIME header line: \"Foo\\tBar :a\\tb \\x01\""
  assert_eq mh("my-key::\x01\nx-Y_z :é\nX:\t\x7f\r\nmy-key: \r\n\ta\tb\n"), "ERR malformed MIME header line: \"My-Key::\\x01\""
  assert_eq mh("foo bar : x y z\r\r\n"), "ERR malformed MIME header line: \"foo bar : x y z\\r\""
  assert_eq mh("CONTENT-type\t:x y z\n\r\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:x y z\""
  assert_eq mh(": v\n\tx y z\r\nFoo\tBar\t:\x01\r\n  \t  trailing  \nX: \n"), "ERR malformed MIME header line: \": v x y z\""
  assert_eq mh("Foo:\tx y z\r"), "ERR malformed MIME header line: \"Foo:\\tx y z\\r\""
  assert_eq mh("x-Y_z :v\r\n  \t1\r\n lead:\t  trailing  \r\nFoo\tBar: a\tb\né:\t\r\n\nbody"), "ERR malformed MIME header line: \"Foo\\tBar: a\\tb\""
  assert_eq mh("X:\r\n\r\n"), "X=[]"
  assert_eq mh("x-Y_z\t:x y z\r"), "ERR malformed MIME header line: \"x-Y_z\\t:x y z\\r\""
  assert_eq mh("k$:\ta\tb\r\nFoo :v\r\nFoo\tBar: v \r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar: v\""
  assert_eq mh(" lead:1\r\n\t\rfoo bar \t:\x7f\na b :é\r\nFoo\tBar:   trailing  \r\n\n"), "ERR malformed MIME header initial line: \" lead:1\""
  assert_eq mh("k$::\x01\n  \t\x7f\n\r\n"), "ERR malformed MIME header line: \"K$::\\x01 \\x7f\""
  assert_eq mh("Foo:   trailing  \na-1-c :\x01\r\nfoo bar :\t\r a\tb\r\n\r\n"), "ERR malformed MIME header line: \"a-1-c :\\x01\""
  assert_eq mh(" lead\t:\n a\tb\nk$ :  trailing  \nk$:\x7f\r\nfoo bar \x7f\r\nbody"), "ERR malformed MIME header initial line: \" lead\\t:\""
  assert_eq mh("k$:a\tb\nmy-key v \rX::a\tb\nbody"), "ERR malformed MIME header line: \"my-key v \\rX::a\\tb\""
  assert_eq mh("é:a\tb\r\n  \té\na b:\tv\r\nmy-key\t:\x7f\rx-Y_z:: v \n\r\n"), "ERR malformed MIME header line: \"é:a\\tb é\""
  assert_eq mh("CONTENT-type\t:é\r\né\t:\r\nFoo\t:v\r  \tx y z\n\r\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:é\""
  assert_eq mh("my-key\t:a\tb\n\ta\tb\nfoo bar ::x y z\n"), "ERR malformed MIME header line: \"my-key\\t:a\\tb a\\tb\""
  assert_eq mh("X:\t1\r"), "ERR malformed MIME header line: \"X:\\t1\\r\""
  assert_eq mh("Foo\tBar::é\r é\r\nFoo\tBar:\x7f\n  \t\x7f\r"), "ERR malformed MIME header line: \"Foo\\tBar::é\\r é\""
  assert_eq mh("my-key :é\r\n\n"), "my-key =[é]"
  assert_eq mh(": 1\nCONTENT-type::\x7f\r  \t\nbody"), "ERR malformed MIME header line: \": 1\""
  assert_eq mh("a b : v \rFoo:\t\x7f\r\n\r\nbody"), "ERR malformed MIME header line: \"a b : v \\rFoo:\\t\\x7f\""
  assert_eq mh("a b v \r\t v \nmy-key\t:é\ra-1-c: v \r\n\r\n"), "ERR malformed MIME header: missing colon: \"a b v \\r\\t v \""
  assert_eq mh("x-Y_z:\té\nFoo\tBar:\t\x01\r\n lead\t:1\nmy-key: \n\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\t\\x01 lead\\t:1\""
  assert_eq mh(" :\x01\r\nX:\t\r\n"), "ERR malformed MIME header initial line: \" :\\x01\""
  assert_eq mh("é :é\r\nX v \n\té\n\n"), "ERR malformed MIME header line: \"é :é\""
  assert_eq mh("k$::v\r\n\tv\r\n"), "K$=[:v v] +EOF"
  assert_eq mh("Foo\tBar: a\tb\rx-Y_z1\ra b:: v \r\n 1\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar: a\\tb\\rx-Y_z1\\ra b:: v 1\""
  assert_eq mh("a b::1\r\nk$\t:\rFoo::\x7f\r\n\ta\tb\ra-1-c: \x01\n  \tv\nbody"), "ERR malformed MIME header line: \"k$\\t:\\rFoo::\\x7f a\\tb\\ra-1-c: \\x01 v\""
  assert_eq mh("\x7f\r\n  \tv\nk$:   trailing  \r\n  \tv\r\na-1-c\t:a\tb\n\r\nbody"), "ERR malformed MIME header: missing colon: \"\\x7f\""
  assert_eq mh("a-1-c::\x7f\r\n\r\n"), "ERR malformed MIME header line: \"A-1-C::\\x7f\""
  assert_eq mh("Foo\t:  trailing  \r\né  trailing  \na\tb\r   trailing  \r\nfoo bar :é\n a\tb\r\r\nbody"), "ERR malformed MIME header line: \"Foo\\t:  trailing\""
  assert_eq mh("foo bar ::\r\né\t:\r\nFoo\tBar\t:1\r\n"), "ERR malformed MIME header line: \"é\\t:\""
  assert_eq mh("foo bar \t:é\r\n\ta\tb\r\nCONTENT-type\t:v\ra b:  trailing  \r\nFoo\tBar\t:\r\r\n"), "ERR malformed MIME header line: \"foo bar \\t:é a\\tb\""
  assert_eq mh("foo bar \t:  trailing  \na b\t:v\r\n\t:é\r\r\n"), "ERR malformed MIME header line: \"foo bar \\t:  trailing\""
  assert_eq mh("my-key::\x01\rFoo\tBar:1\rk$\t:a\tb\r\nFoo\tBar:\x7f\r\n\r\nbody"), "ERR malformed MIME header line: \"My-Key::\\x01\\rFoo\\tBar:1\\rk$\\t:a\\tb\""
  assert_eq mh("k$:\ta\tb\r"), "ERR malformed MIME header line: \"K$:\\ta\\tb\\r\""
  assert_eq mh("x-Y_z:\t v \rfoo bar ::v\r\n\r\nbody"), "ERR malformed MIME header line: \"X-Y_z:\\t v \\rfoo bar ::v\""
  assert_eq mh("my-key::  trailing  \na b\t:é\n\t  trailing  \na-1-c :\r 1\r\n"), "ERR malformed MIME header line: \"a b\\t:é trailing\""
  assert_eq mh(" lead: a\tb\r  \té\n"), "ERR malformed MIME header initial line: \" lead: a\\tb\\r  \\té\""
  assert_eq mh("a-1-c:a\tb\n"), "A-1-C=[a\tb] +EOF"
  assert_eq mh("Foo:é\n lead::a\tb\n 1\n lead::\x01\ra-1-c::x y z\n"), "ERR malformed MIME header line: \"Foo:é lead::a\\tb 1 lead::\\x01\\ra-1-c::x y z\""
  assert_eq mh("a bé\ré:   trailing  \n\n"), "ERR malformed MIME header line: \"a bé\\ré:   trailing\""
  assert_eq mh("CONTENT-typea\tb\n\n"), "ERR malformed MIME header: missing colon: \"CONTENT-typea\\tb\""
  assert_eq mh("é :1\r  \ta\tb\r\na-1-c :1\r  \tv\n\n"), "ERR malformed MIME header line: \"é :1\\r  \\ta\\tb\""
  assert_eq mh("X: \x7f\nk$ :  trailing  \n\t v \r\n\nbody"), "ERR malformed MIME header line: \"X: \\x7f\""
  assert_eq mh(": \n\r\n"), "ERR malformed MIME header line: \":\""
  assert_eq mh("::a\tb\nk$v\né :a\tb\n\r\nbody"), "ERR malformed MIME header line: \"::a\\tb\""
  assert_eq mh("X : v \r\nk$::x y z\na b:\tv\r\n\t\r\na b:\x7f\n\r\n"), "ERR malformed MIME header line: \"a b:\\x7f\""
  assert_eq mh("a-1-c\t:\x7f\r\né::é\r \x7f\r\n\r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:\\x7f\""
  assert_eq mh("k$\t: v \r\nmy-key\t:a\tb\r\né :\r\r\nbody"), "ERR malformed MIME header line: \"k$\\t: v\""
  assert_eq mh("a-1-c:\t v \r\n"), "A-1-C=[v] +EOF"
  assert_eq mh("é::x y z\n lead:a\tb\r"), "ERR malformed MIME header line: \"é::x y z lead:a\\tb\\r\""
  assert_eq mh("é :x y z\r\nFoo\tBar::v\nmy-key::é\n  \t v \ra b:\té\r\n"), "ERR malformed MIME header line: \"é :x y z\""
  assert_eq mh("a-1-c:\x7f\r\né:\té\nCONTENT-type:\t\n\n"), "ERR malformed MIME header line: \"A-1-C:\\x7f\""
  assert_eq mh("foo bar ::x y z\nk$:\t1\n"), "K$=[1];foo bar =[:x y z] +EOF"
  assert_eq mh("x-Y_z:\tx y z\r\nFoo: x y z\n::é\r\n\n"), "ERR malformed MIME header line: \"::é\""
  assert_eq mh("Foo\t:\r\n\n"), "ERR malformed MIME header line: \"Foo\\t:\""
  assert_eq mh("Foo\t:é\r\nCONTENT-type :\x7f\ra b\x01\r\tv\rCONTENT-type :\x7f\r\n"), "ERR malformed MIME header line: \"Foo\\t:é\""
  assert_eq mh("CONTENT-type :v\r\n\t:\x7f\r\nCONTENT-type\t:  trailing  \r\n"), "ERR malformed MIME header line: \"CONTENT-type :v :\\x7f\""
  assert_eq mh("x-Y_z::\x7f\r\nFoo : v \ra b: \x01\n  \t1\n"), "ERR malformed MIME header line: \"X-Y_z::\\x7f\""
  assert_eq mh("my-key:  trailing  \r\nFoo\tBar\t:a\tb\r\né:\t1\r\nmy-key::  trailing  \n  \t\n\n"), "ERR malformed MIME header line: \"Foo\\tBar\\t:a\\tb\""
  assert_eq mh(" lead:\t\n lead: v\r\na b::x y z\r\n  \t\x7f\r lead:\t  trailing  \n\r\n"), "ERR malformed MIME header initial line: \" lead:\\t\""
  assert_eq mh("é\t:é\r v\n:é\n  \t\x7f\r\n\nbody"), "ERR malformed MIME header line: \"é\\t:é\\r v\""
  assert_eq mh("k$\t:a\tb\rx-Y_z::  trailing  \né :\x7f\n  \ta\tb\r\n\nbody"), "ERR malformed MIME header line: \"k$\\t:a\\tb\\rx-Y_z::  trailing\""
  assert_eq mh("foo bar ::1\nx-Y_z:\t\n\r\n"), "X-Y_z=[];foo bar =[:1]"
  assert_eq mh("CONTENT-type: v\rCONTENT-type :a\tb\n  \t\x7f\r\nX::é\n\r\n"), "ERR malformed MIME header line: \"Content-Type: v\\rCONTENT-type :a\\tb \\x7f\""
  assert_eq mh("é\t:\nx-Y_z:a\tb\r\n  \t\r\n"), "ERR malformed MIME header line: \"é\\t:\""
  assert_eq mh("X::x y z\r\nfoo bar 1\r\n\r\n"), "ERR malformed MIME header: missing colon: \"foo bar 1\""
  assert_eq mh("X\t:\r\nX::\x7f\n   trailing  \n\r\n"), "ERR malformed MIME header line: \"X\\t:\""
  assert_eq mh(" lead :\x01\rFoo\tBar:\t\x7f\r\nfoo bar ::\x7f\n v\rX::\r\r\n"), "ERR malformed MIME header initial line: \" lead :\\x01\\rFoo\\tBar:\\t\\x7f\""
  assert_eq mh("é:v\ra b::v\n x y z\r\nmy-key::v\r\n lead\t:\x7f\r\n\r\n"), "ERR malformed MIME header line: \"é:v\\ra b::v x y z\""
  assert_eq mh("k$x y z\r \nX:\x01\r lead::1\r\né:é\r\n \r"), "ERR malformed MIME header: missing colon: \"k$x y z\\r \""
  assert_eq mh("\t:\x01\rmy-key:é\r\n\r\n"), "ERR malformed MIME header initial line: \"\\t:\\x01\\rmy-key:é\""
  assert_eq mh("CONTENT-type\t:\x7f\n a\tb\r\r\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:\\x7f a\\tb\\r\""
  assert_eq mh("CONTENT-type:\t\r\né: x y z\r\nFoo\tBar: 1\n \x7f\r\nFoo\tBar\x7f\r\n"), "ERR malformed MIME header line: \"é: x y z\""
  assert_eq mh("my-key:\t\r\n\r\n"), "My-Key=[]"
  assert_eq mh("foo bar :\x7f\nCONTENT-type\t:  trailing  \r\nmy-key:\té\r  \t  trailing  \n\r\nbody"), "ERR malformed MIME header line: \"foo bar :\\x7f\""
  assert_eq mh("foo bar ::\x7f\r\n lead::  trailing  \né:\tv\r\n  \t1\r\na b:1\r\n\r\n"), "ERR malformed MIME header line: \"foo bar ::\\x7f lead::  trailing\""
  assert_eq mh("a b:v\nCONTENT-type:\ta\tb\r\n:\té\n  \tv\n"), "ERR malformed MIME header line: \":\\té v\""
  assert_eq mh("k$x y z\r\r\n"), "ERR malformed MIME header: missing colon: \"k$x y z\\r\""
  assert_eq mh("CONTENT-type :\x01\nx-Y_z:\t v \r\n"), "ERR malformed MIME header line: \"CONTENT-type :\\x01\""
  assert_eq mh(" lead :1\n\r\n"), "ERR malformed MIME header initial line: \" lead :1\""
  assert_eq mh("k$é\ra b\t:  trailing  \r\n\r\nbody"), "ERR malformed MIME header line: \"k$é\\ra b\\t:  trailing\""
  assert_eq mh("a ba\tb\r\n é\nX :x y z\r\n"), "ERR malformed MIME header: missing colon: \"a ba\\tb\""
}

test "vectors: mime header 6" {
  assert_eq mh(" lead\t:  trailing  \r\n\n"), "ERR malformed MIME header initial line: \" lead\\t:  trailing  \""
  assert_eq mh(" lead\t:\x01\rk$:\t  trailing  \r\n  \t1\nFoo:\t\x7f\r"), "ERR malformed MIME header initial line: \" lead\\t:\\x01\\rk$:\\t  trailing  \""
  assert_eq mh("CONTENT-type:\x7f\na-1-c :  trailing  \nbody"), "ERR malformed MIME header line: \"Content-Type:\\x7f\""
  assert_eq mh("Foo :\x01\r\r\n"), "ERR malformed MIME header line: \"Foo :\\x01\\r\""
  assert_eq mh("x-Y_z: 1\r\n\t\x7f\na-1-c:v\r lead: é\n\n"), "ERR malformed MIME header line: \"X-Y_z: 1 \\x7f\""
  assert_eq mh("x-Y_z:a\tb\r\nfoo bar é\nFoo\t:\x7f\n  \t  trailing  \nX:\t\x01\n"), "ERR malformed MIME header: missing colon: \"foo bar é\""
  assert_eq mh(":\tx y z\r\n\n"), "ERR malformed MIME header line: \":\\tx y z\""
  assert_eq mh("k$:x y z\r\n\r\n"), "K$=[x y z]"
  assert_eq mh("X:\x01\r\nk$:x y z\r\nmy-key:\t  trailing  \r\n  \té\r\n\r\n"), "ERR malformed MIME header line: \"X:\\x01\""
  assert_eq mh("a\tb\n\t\x7f\n\nbody"), "ERR malformed MIME header: missing colon: \"a\\tb\""
  assert_eq mh("Foo\tBar:\t v \r\nX:\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\t v\""
  assert_eq mh("x-Y_z: 1\nx-Y_z v \r\n\t1\na b: \x7f\n\r\n"), "ERR malformed MIME header: missing colon: \"x-Y_z v \""
  assert_eq mh("X:\x7f\r\n\n"), "ERR malformed MIME header line: \"X:\\x7f\""
  assert_eq mh(":\t\x01\nCONTENT-type::\x01\r"), "ERR malformed MIME header line: \":\\t\\x01\""
  assert_eq mh("Foo\tBar:\x7f\n   trailing  \r\né\t:\x7f\né::a\tb\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\x7f trailing\""
  assert_eq mh("X:\t  trailing  \nmy-keyé\r\nx-Y_z :\r\nmy-key: a\tb\n"), "ERR malformed MIME header: missing colon: \"my-keyé\""
  assert_eq mh("my-key: v\r\na-1-c\t: v \nFoo\tBar\t:é\n lead: \x7f\r\n"), "ERR malformed MIME header line: \"a-1-c\\t: v\""
  assert_eq mh("x-Y_z:\tx y z\n1\r\n"), "ERR malformed MIME header: missing colon: \"1\""
  assert_eq mh("é: \r\n\t\r\n\r\n"), "ERR malformed MIME header line: \"é: \""
  assert_eq mh("a-1-c\t:\r\n\t: v \r\n\r\n"), "ERR malformed MIME header line: \"a-1-c\\t: : v\""
  assert_eq mh(":1\rX:\tx y z\nfoo bar \t:v\r\n\r\n"), "ERR malformed MIME header line: \":1\\rX:\\tx y z\""
  assert_eq mh("Xa\tb\r\na ba\tb\n\r\n"), "ERR malformed MIME header: missing colon: \"Xa\\tb\""
  assert_eq mh(" lead:x y z\n  \t v \r"), "ERR malformed MIME header initial line: \" lead:x y z\""
  assert_eq mh("é:\té\n\ta\tb\né::\r\nFoo\tBar:  v \r\n  \t v \r\na-1-c :  trailing  \n"), "ERR malformed MIME header line: \"é:\\té a\\tb\""
  assert_eq mh("Foo\tBar\x7f\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBar\\x7f\""
  assert_eq mh("é:\t v \r\n  \tx y z\n\r\n"), "ERR malformed MIME header line: \"é:\\t v x y z\""
  assert_eq mh("X:\nFoo\tBar: v\r\n\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar: v\""
  assert_eq mh("Foo\tBar:\r\nfoo bar :  trailing  \né:\t\x01\n\n"), "ERR malformed MIME header line: \"Foo\\tBar:\""
  assert_eq mh("k$ :x y z\r\n  v \r\n lead:\t\n\t\r\nX\x01\n\nbody"), "ERR malformed MIME header: missing colon: \"X\\x01\""
  assert_eq mh("Foo:   trailing  \rfoo bar :\x01\nfoo bar \t: v \n\r\nbody"), "ERR malformed MIME header line: \"Foo:   trailing  \\rfoo bar :\\x01\""
  assert_eq mh("é::\x01\r\n\r\n"), "ERR malformed MIME header line: \"é::\\x01\""
  assert_eq mh("X:: v \nbody"), "ERR malformed MIME header: missing colon: \"body\""
  assert_eq mh("Foo\tBar::a\tb\nk$:\t1\r\n\t\x01\r\n"), "ERR malformed MIME header line: \"Foo\\tBar::a\\tb\""
  assert_eq mh(":\t  trailing  \r\nFoo:\t  trailing  \n\r\n"), "ERR malformed MIME header line: \":\\t  trailing\""
  assert_eq mh("é:  v \rfoo bar ::a\tb\r\na b: a\tb\rx-Y_z\t:v\n\nbody"), "ERR malformed MIME header line: \"é:  v \\rfoo bar ::a\\tb\""
  assert_eq mh("a-1-c\t:\nFoo\t:\x7f\r\na b::x y z\ré: a\tb\n\r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:\""
  assert_eq mh("Foo\x7f\n  \té\r\né1\n a\tb\r\nFoo\tBar\t:1\n leadx y z\r\nbody"), "ERR malformed MIME header: missing colon: \"Foo\\x7f\""
  assert_eq mh("é::1\r\nFoo\t:\r\n\r\n"), "ERR malformed MIME header line: \"é::1\""
  assert_eq mh("x-Y_z::\n:\ta\tb\r   trailing  \rCONTENT-type: \r\n\r\n"), "ERR malformed MIME header line: \":\\ta\\tb\\r   trailing  \\rCONTENT-type:\""
  assert_eq mh("Foo\tBar\t:\x01\r\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar\\t:\\x01\\r\""
  assert_eq mh("Foo:  v \r\n: \x7f\n\tx y z\r\nmy-key :\na b:\t\x01\n\t v \n\nbody"), "ERR malformed MIME header line: \": \\x7f x y z\""
  assert_eq mh("k$:\t\rfoo bar :  v \r\n \x01\na-1-c\t:1\na-1-c\t:\x7f\r\n\r\n"), "ERR malformed MIME header line: \"K$:\\t\\rfoo bar :  v \\x01\""
  assert_eq mh("a-1-c :1\n  \t\x01\r\nXa\tb\nx-Y_z\t:  trailing  \r\n"), "ERR malformed MIME header line: \"a-1-c :1 \\x01\""
  assert_eq mh("Fooé\n  \té\na-1-c\t:  trailing  \n\t\x7f\r\nFoo:\x01\n\té\r\n\n"), "ERR malformed MIME header: missing colon: \"Fooé\""
  assert_eq mh("é::é\n\r\n"), "ERR malformed MIME header line: \"é::é\""
  assert_eq mh("CONTENT-type:a\tb\r\n  \té\ré\t: v \nFoo\t:1\rx-Y_z :\x7f\r\t1\n\r\n"), "ERR malformed MIME header line: \"Content-Type:a\\tb é\\ré\\t: v\""
  assert_eq mh("Foo\tBar:\ta\tb\r\na-1-c:   trailing  \r\n  \t\x01\nbody"), "ERR malformed MIME header line: \"Foo\\tBar:\\ta\\tb\""
  assert_eq mh("Foo::v\n\r\nbody"), "Foo=[:v]"
  assert_eq mh("X:\t\x7f\nCONTENT-type\t:v\na-1-c :\x7f\r\n  v \r\n"), "ERR malformed MIME header line: \"X:\\t\\x7f\""
  assert_eq mh("a b:\ta\tb\r\n\n"), "a b=[a\tb]"
  assert_eq mh(" lead\t:\né :\x01\n \rbody"), "ERR malformed MIME header initial line: \" lead\\t:\""
  assert_eq mh("CONTENT-type: \n\ta\tb\nk$: v \n é\nFoo\tBar:x y z\r\n :  trailing  \r \x7f\n\nbody"), "ERR malformed MIME header line: \"Foo\\tBar:x y z :  trailing  \\r \\x7f\""
  assert_eq mh("my-key:\t  trailing  \n\tv\rfoo bar :\tx y z\n leadx y z\n"), "ERR malformed MIME header line: \"My-Key:\\t  trailing v\\rfoo bar :\\tx y z leadx y z\""
  assert_eq mh("foo bar 1\r\n"), "ERR malformed MIME header: missing colon: \"foo bar 1\""
  assert_eq mh("X :\x01\r\né:1\rFoo :x y z\n\r\n"), "ERR malformed MIME header line: \"X :\\x01\""
  assert_eq mh("my-key:\nFoo : v \n  \t1\r\nCONTENT-typeé\nbody"), "ERR malformed MIME header: missing colon: \"CONTENT-typeé\""
  assert_eq mh("X: \x7f\r\nx-Y_z:\t\n  \t v \nX: é\r  \t\nk$::a\tb\r\n\n"), "ERR malformed MIME header line: \"X: \\x7f\""
  assert_eq mh("a-1-c::\x7f\rFoo\tBar :  trailing  \nFoo\tBaré\n:\tx y z\n\tv\r\n\n"), "ERR malformed MIME header line: \"A-1-C::\\x7f\\rFoo\\tBar :  trailing\""
  assert_eq mh("a-1-c:\x01\n lead:\té\rFoo\tBaré\r\nX :a\tb\n\r\nbody"), "ERR malformed MIME header line: \"A-1-C:\\x01 lead:\\té\\rFoo\\tBaré\""
  assert_eq mh("a-1-c::  trailing  \n\x7f\rFoo\tBar::  trailing  \r\n"), "ERR malformed MIME header line: \"\\x7f\\rFoo\\tBar::  trailing\""
  assert_eq mh(" lead:\ta\tb\r\n\nbody"), "ERR malformed MIME header initial line: \" lead:\\ta\\tb\""
  assert_eq mh("é:\r\nbody"), "ERR malformed MIME header line: \"é:\""
  assert_eq mh("foo bar \t:é\r \x7f\r\na b::a\tb\r\n  \t\x01\r\né::é\r\r\nbody"), "ERR malformed MIME header line: \"foo bar \\t:é\\r \\x7f\""
  assert_eq mh("a b:: v \n"), "a b=[: v] +EOF"
  assert_eq mh("a-1-c: \x01\r\n"), "ERR malformed MIME header line: \"A-1-C: \\x01\""
  assert_eq mh("my-key::v\r\n\té\nFoo:1\n\t1\r\nmy-key: \x01\ra-1-c\t:\r\t\n\n"), "ERR malformed MIME header line: \"My-Key: \\x01\\ra-1-c\\t:\\r\""
  assert_eq mh("foo bar \t:x y z\nX :\x01\r\nFoo\tBar\t:v\nX::\x7f\r\n \x7f\n\n"), "ERR malformed MIME header line: \"foo bar \\t:x y z\""
  assert_eq mh("a b\t:1\r\nbody"), "ERR malformed MIME header line: \"a b\\t:1\""
  assert_eq mh("X:: v \r  \t1\n\r\nbody"), "ERR malformed MIME header line: \"X:: v \\r  \\t1\""
  assert_eq mh("X\t:\nfoo bar \t:\x01\nfoo bar \t:é\r\n\t1\rFoo\tBar:v\r\n\r\n"), "ERR malformed MIME header line: \"X\\t:\""
  assert_eq mh("k$ :1\nfoo bar \t:1\r\na-1-c:\t  trailing  \r\n\r\nbody"), "ERR malformed MIME header line: \"foo bar \\t:1\""
  assert_eq mh("x-Y_z::1\na b : v \r\n\r\n"), "X-Y_z=[:1];a b =[v]"
  assert_eq mh("Foo\t:\x7f\r\nCONTENT-type:\ta\tb\r a\tb\nCONTENT-type:\t v \r\nx-Y_z: v \r\n\tx y z\r\r\nbody"), "ERR malformed MIME header line: \"Foo\\t:\\x7f\""
  assert_eq mh("x-Y_z\t:\x7f\n"), "ERR malformed MIME header line: \"x-Y_z\\t:\\x7f\""
  assert_eq mh("a b\t:é\nFoo\tBar:\t  trailing  \né::\rX\t:\n\r\n"), "ERR malformed MIME header line: \"a b\\t:é\""
  assert_eq mh("foo bar  :\x01\rCONTENT-type:\x7f\r\nCONTENT-type::  trailing  \r\n  \t\r\n\r\n"), "ERR malformed MIME header line: \"foo bar  :\\x01\\rCONTENT-type:\\x7f\""
  assert_eq mh(" lead\t:v\r\n  \t v \né:\tx y z\rFoo\tBar\t:\x7f\n\r\nbody"), "ERR malformed MIME header initial line: \" lead\\t:v\""
  assert_eq mh("my-key :  trailing  \na-1-c:a\tb\nmy-key::\x01\r\n\n"), "ERR malformed MIME header line: \"My-Key::\\x01\""
  assert_eq mh("foo bar :\t\na bé\n\n"), "ERR malformed MIME header: missing colon: \"a bé\""
}

test "vectors: mime header 7" {
  assert_eq mh("é:\té\r\n\n"), "ERR malformed MIME header line: \"é:\\té\""
  assert_eq mh("v\r\n lead:\té\nk$: v \n\tv\r\n\n"), "ERR malformed MIME header: missing colon: \"v\""
  assert_eq mh("foo bar ::\r a\tb\r\né:   trailing  \r\na-1-c\t:x y z\n"), "ERR malformed MIME header line: \"foo bar ::\\r a\\tb\""
  assert_eq mh("\t:\x01\r  \t\x01\n\r\n"), "ERR malformed MIME header initial line: \"\\t:\\x01\\r  \\t\\x01\""
  assert_eq mh("Foo\tBar:\t\x01\nX :v\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\t\\x01\""
  assert_eq mh("a b : v \r\nk$:\t\n\r\n"), "K$=[];a b =[v]"
  assert_eq mh(" lead:\té\r\n lead  trailing  \n \r\nfoo bar :  v \nX:   trailing  \r\n\n"), "ERR malformed MIME header initial line: \" lead:\\té\""
  assert_eq mh(":\té\r\n\r\n"), "ERR malformed MIME header line: \":\\té\""
  assert_eq mh("é :\rfoo bar : v\rFoo:\té\r  \t v \nx-Y_z :x y z\n\r\nbody"), "ERR malformed MIME header line: \"é :\\rfoo bar : v\\rFoo:\\té\\r  \\t v\""
  assert_eq mh("Foo\t:  trailing  \nk$: v \r\n"), "ERR malformed MIME header line: \"Foo\\t:  trailing\""
  assert_eq mh("X: \r\na b:\té\r\tv\n lead: 1\r\n\tx y z\rX :é\n é\r\nbody"), "ERR malformed MIME header line: \"a b:\\té\\r\\tv lead: 1 x y z\\rX :é é\""
  assert_eq mh("X::é\n 1\r\na-1-c\x7f\r\n"), "ERR malformed MIME header: missing colon: \"a-1-c\\x7f\""
  assert_eq mh("X :v\r\na b :\r\né:\x7f\n"), "ERR malformed MIME header line: \"é:\\x7f\""
  assert_eq mh(" lead::\x01\r\n  \tv\r\nmy-key :  trailing  \n  \tx y z\na b::\x01\nFoo :x y z\r\n\n"), "ERR malformed MIME header initial line: \" lead::\\x01\""
  assert_eq mh("X::1\ra b: \x7f\r\nfoo bar  :v\r lead: \x01\r\n 1\r\n"), "ERR malformed MIME header line: \"X::1\\ra b: \\x7f\""
  assert_eq mh("k$ :v\r\n :é\r\nX: v \n  \tx y z\nk$::\x01\r\n  \tv\n\r\n"), "ERR malformed MIME header line: \"K$::\\x01 v\""
  assert_eq mh(" :\x7f\nX\t:a\tb\r\n"), "ERR malformed MIME header initial line: \" :\\x7f\""
  assert_eq mh("a b\t:a\tb\r\nk$: v\r\n"), "ERR malformed MIME header line: \"a b\\t:a\\tb\""
  assert_eq mh("a-1-ca\tb\r\nbody"), "ERR malformed MIME header: missing colon: \"a-1-ca\\tb\""
  assert_eq mh("X::a\tb\r\na bx y z\r\n lead:1\r\n  \tv\n"), "ERR malformed MIME header: missing colon: \"a bx y z\""
  assert_eq mh("my-key::a\tb\r\nFoo\tBar::  trailing  \n é\r\nk$:1\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar::  trailing é\""
  assert_eq mh("::a\tb\n\n"), "ERR malformed MIME header line: \"::a\\tb\""
  assert_eq mh("x-Y_z\t:\x7f\ra-1-c:v\n\n"), "ERR malformed MIME header line: \"x-Y_z\\t:\\x7f\\ra-1-c:v\""
  assert_eq mh("x-Y_z:\t\x7f\n\ta\tb\nX v \r\n  \t1\r\nCONTENT-type:\x01\r\n\r\n"), "ERR malformed MIME header line: \"X-Y_z:\\t\\x7f a\\tb\""
  assert_eq mh("a-1-c :v\nCONTENT-type :\x01\r\n   trailing  \r\nFoo\tBar:é\r\n  \t  trailing  \n\r\nbody"), "ERR malformed MIME header line: \"CONTENT-type :\\x01 trailing\""
  assert_eq mh("Foo\tBar :  trailing  \n\t:a\tb\n\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar :  trailing :a\\tb\""
  assert_eq mh("CONTENT-type:\ta\tb\rk$ :é\r\n\n"), "ERR malformed MIME header line: \"Content-Type:\\ta\\tb\\rk$ :é\""
  assert_eq mh(" lead:: v \né : v \r\nmy-key::\x7f\n\r\nbody"), "ERR malformed MIME header initial line: \" lead:: v \""
  assert_eq mh("x-Y_z:\tv\r \r\n\r\n"), "ERR malformed MIME header line: \"X-Y_z:\\tv\\r\""
  assert_eq mh("foo bar \t:\x7f\r\n\n"), "ERR malformed MIME header line: \"foo bar \\t:\\x7f\""
  assert_eq mh("é:\ta\tb\n \x7f\nfoo bar :\tx y z\r\n lead :  trailing  \n\t v \r"), "ERR malformed MIME header line: \"é:\\ta\\tb \\x7f\""
  assert_eq mh("Foo:\t  trailing  \r\n  \t\x01\r lead :é\nfoo bar \t:a\tb\n\r\nbody"), "ERR malformed MIME header line: \"Foo:\\t  trailing \\x01\\r lead :é\""
  assert_eq mh("Foo :1\r\n\t v \na b:\t v \r\n\r\nbody"), "Foo =[1 v];a b=[v]"
  assert_eq mh("CONTENT-type:  trailing  \n: \rFoo::v\ré:   trailing  \r\n\n"), "ERR malformed MIME header line: \": \\rFoo::v\\ré:   trailing\""
  assert_eq mh("CONTENT-type :x y z\r\nFoo:\t  trailing  \nbody"), "ERR malformed MIME header: missing colon: \"body\""
  assert_eq mh("my-key:\t\r\r\n"), "ERR malformed MIME header line: \"My-Key:\\t\\r\""
  assert_eq mh("k$ :x y z\nCONTENT-type:\t v \r\nx-Y_z: \x7f\r\n  \té\r\n\n"), "ERR malformed MIME header line: \"X-Y_z: \\x7f é\""
  assert_eq mh("my-key: \n\r\n"), "My-Key=[]"
  assert_eq mh("k$ :a\tb\rk$:  trailing  \r\nmy-key:\té\n"), "ERR malformed MIME header line: \"k$ :a\\tb\\rk$:  trailing\""
  assert_eq mh("Foo::1\r \x01\r\na-1-c:   trailing  \n\r\n"), "ERR malformed MIME header line: \"Foo::1\\r \\x01\""
  assert_eq mh(":  v \r\n  \tv\r\n lead:1\nfoo bar x y z\r\n\r\n"), "ERR malformed MIME header line: \":  v v lead:1\""
  assert_eq mh(":  trailing  \n"), "ERR malformed MIME header line: \":  trailing\""
  assert_eq mh("a b\t:a\tb\rCONTENT-type::\x01\r\n  \t v \né:x y z\n\r\n"), "ERR malformed MIME header line: \"a b\\t:a\\tb\\rCONTENT-type::\\x01 v\""
  assert_eq mh("x-Y_z\t:  trailing  \nFoo\tBar: v\r\nbody"), "ERR malformed MIME header line: \"x-Y_z\\t:  trailing\""
  assert_eq mh("x-Y_z:: v \n  v \r :\x7f\r\n 1\ra b :\x01\r\n"), "ERR malformed MIME header line: \"X-Y_z:: v v \\r :\\x7f 1\\ra b :\\x01\""
  assert_eq mh("foo bar :\ra b:a\tb\r\n 1\na b:\x01\r\n lead\t:  trailing  \n\nbody"), "ERR malformed MIME header line: \"foo bar :\\ra b:a\\tb 1\""
  assert_eq mh("foo bar :\x7f\r\né :é\n\n"), "ERR malformed MIME header line: \"foo bar :\\x7f\""
  assert_eq mh("Foo\tBar:x y z\rk$\t:é\r\n lead\t:v\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:x y z\\rk$\\t:é lead\\t:v\""
  assert_eq mh("é\t:\x7f\nbody"), "ERR malformed MIME header line: \"é\\t:\\x7f\""
  assert_eq mh("é: a\tb\nx-Y_z\t: v \nFoo\tBar:a\tb\n\nbody"), "ERR malformed MIME header line: \"é: a\\tb\""
  assert_eq mh("my-key\t:  trailing  \nCONTENT-type:\ta\tb\rFoo\tBar :\r\n\r\n"), "ERR malformed MIME header line: \"my-key\\t:  trailing\""
  assert_eq mh("x-Y_z : v \nX: v \nFoo:\t v \r\n"), "Foo=[v];X=[v];x-Y_z =[v] +EOF"
  assert_eq mh("Foo:1\ré: \x01\r"), "ERR malformed MIME header line: \"Foo:1\\ré: \\x01\\r\""
  assert_eq mh("foo bar : v\na b: v\n\r\n"), "a b=[v];foo bar =[v]"
  assert_eq mh("::\x01\r\n\ta\tb\r\na b:a\tb\n\n"), "ERR malformed MIME header line: \"::\\x01 a\\tb\""
  assert_eq mh("a-1-ca\tb\r\n:\x7f\r\ta\tb\n\nbody"), "ERR malformed MIME header: missing colon: \"a-1-ca\\tb\""
  assert_eq mh("foo bar :: v \n  v \né\t:1\r\r\n"), "ERR malformed MIME header line: \"é\\t:1\\r\""
  assert_eq mh(":  trailing  \r\n\r\n"), "ERR malformed MIME header line: \":  trailing\""
  assert_eq mh("x-Y_zx y z\r\nx-Y_z: é\n   trailing  \nmy-key::v\n\tv\r\nFoo\tBar:v\n\r\nbody"), "ERR malformed MIME header: missing colon: \"x-Y_zx y z\""
  assert_eq mh("x-Y_z\t:é\r\n\n"), "ERR malformed MIME header line: \"x-Y_z\\t:é\""
  assert_eq mh("é::a\tb\r\nFoo\tBar\t: v \n\nbody"), "ERR malformed MIME header line: \"é::a\\tb\""
  assert_eq mh("Foo\tBar:\ta\tb\r\né\t:x y z\r\nmy-key:a\tb\nk$ v \r\n\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar:\\ta\\tb\""
  assert_eq mh("é :\x7f\r\n\r\n"), "ERR malformed MIME header line: \"é :\\x7f\""
  assert_eq mh("X::é\r\n\n"), "X=[:é]"
  assert_eq mh("my-key:a\tb\n \ra-1-c: \n a\tb\r lead:\x01\r\n v\r\n"), "ERR malformed MIME header line: \"My-Key:a\\tb \\ra-1-c: a\\tb\\r lead:\\x01 v\""
  assert_eq mh("a b\x01\r\nFoo:\t  trailing  \n  \t\x7f\nFoo::1\r\nX:\t  trailing  \n\r\nbody"), "ERR malformed MIME header: missing colon: \"a b\\x01\""
  assert_eq mh("é\t:a\tb\rX:\t\r\t1\na b\t:\x01\rk$: a\tb\n\n"), "ERR malformed MIME header line: \"é\\t:a\\tb\\rX:\\t\\r\\t1\""
  assert_eq mh("k$:\tx y z\ra-1-c:\tx y z\r\n lead: \n\r\n"), "ERR malformed MIME header line: \"K$:\\tx y z\\ra-1-c:\\tx y z lead:\""
  assert_eq mh("foo bar :a\tb\r\tv\r\nmy-key\t:v\r\n\r\n"), "ERR malformed MIME header line: \"foo bar :a\\tb\\r\\tv\""
  assert_eq mh(" lead:x y z\rmy-key: x y z\n lead:\t  trailing  \r\n\r\n"), "ERR malformed MIME header initial line: \" lead:x y z\\rmy-key: x y z\""
  assert_eq mh("a-1-c:v\r\nk$: v\r\n \x01\r\nX:\t  trailing  \r\nFoo\t:\n\r\n"), "ERR malformed MIME header line: \"K$: v \\x01\""
  assert_eq mh(":x y z\n"), "ERR malformed MIME header line: \":x y z\""
  assert_eq mh("foo bar :\t\rFoo\tBar::\n\r\n"), "ERR malformed MIME header line: \"foo bar :\\t\\rFoo\\tBar::\""
  assert_eq mh("foo bar \x7f\n  \tv\r\nFoo\t:\x7f\n lead:é\n  \té\n\r\n"), "ERR malformed MIME header: missing colon: \"foo bar \\x7f\""
  assert_eq mh("Foo\tBar v \r \na b:\t\x7f\r\nFoo:v\r\né: a\tb\n \x7f\r\n\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBar v \\r \""
  assert_eq mh("x-Y_z1\nmy-key :v\n  v \r\nfoo bar :\t\x7f\r\n   trailing  \r\n\r\n"), "ERR malformed MIME header: missing colon: \"x-Y_z1\""
  assert_eq mh(":\t1\n \x01\r\nFoo\nCONTENT-type:\t1\r\na b :\x01\r\n\r\n"), "ERR malformed MIME header line: \":\\t1 \\x01\""
  assert_eq mh("é:\ra b :v\r\nCONTENT-type\n"), "ERR malformed MIME header line: \"é:\\ra b :v\""
  assert_eq mh("x-Y_z:\t1\r lead::v\r\n :\x7f\n\r\n"), "ERR malformed MIME header line: \"X-Y_z:\\t1\\r lead::v :\\x7f\""
  assert_eq mh("foo bar ::\x7f\n  \ta\tb\r\nFoo\tBar:\t\x01\n\t\x01\nFoo\tBar:\t v \n  \tv\n leadx y z\r\n\r\n"), "ERR malformed MIME header line: \"foo bar ::\\x7f a\\tb\""
  assert_eq mh("k$\t:é\nk$::a\tb\n \x01\r\r\nbody"), "ERR malformed MIME header line: \"k$\\t:é\""
  assert_eq mh("foo bar :\r\nFoo\tBar:\té\nfoo bar : é\r\t v \r\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\té\""
  assert_eq mh("CONTENT-typex y z\nfoo bar \t:\r\nX::  trailing  \né\t:\nbody"), "ERR malformed MIME header: missing colon: \"CONTENT-typex y z\""
  assert_eq mh("é\x01\r\n:\tx y z\r\r\nbody"), "ERR malformed MIME header: missing colon: \"é\\x01\""
  assert_eq mh("Foo\t:1\r\nmy-key :\nbody"), "ERR malformed MIME header line: \"Foo\\t:1\""
  assert_eq mh("CONTENT-type:v\r\r\n"), "ERR malformed MIME header line: \"Content-Type:v\\r\""
  assert_eq mh("Foo\tBar:1\r\nmy-key: a\tb\n\n"), "ERR malformed MIME header line: \"Foo\\tBar:1\""
}

test "vectors: mime header 8" {
  assert_eq mh(":v\nx-Y_z  trailing  \ra b: \x7f\r \x01\nFoo:\t\r\n\n"), "ERR malformed MIME header line: \":v\""
  assert_eq mh(" lead:\té\rFoo\tBar: a\tb\n é\r\n\r\nbody"), "ERR malformed MIME header initial line: \" lead:\\té\\rFoo\\tBar: a\\tb\""
  assert_eq mh(" lead:1\r\n  \t1\r\na-1-c :\n\tx y z\r\nbody"), "ERR malformed MIME header initial line: \" lead:1\""
  assert_eq mh("é: a\tb\n"), "ERR malformed MIME header line: \"é: a\\tb\""
  assert_eq mh(" :1\ra b:   trailing  \nCONTENT-type\t:\x7f\r\n"), "ERR malformed MIME header initial line: \" :1\\ra b:   trailing  \""
  assert_eq mh("Foo\tBar :é\r\nCONTENT-type:\tv\ra-1-c:v\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar :é\""
  assert_eq mh("a-1-c:\tx y z\r\nFoo\tBar::1\n"), "ERR malformed MIME header line: \"Foo\\tBar::1\""
  assert_eq mh("my-key\ré:a\tb\r\na b:  trailing  \n\n"), "ERR malformed MIME header line: \"my-key\\ré:a\\tb\""
  assert_eq mh("X :\rmy-key::\x01\nmy-key\t:x y z\r\n\r\n"), "ERR malformed MIME header line: \"X :\\rmy-key::\\x01\""
  assert_eq mh("my-key::  trailing  \nfoo bar :\t1\r\nk$ :é\r\n  \t  trailing  \r\n\r\n"), "My-Key=[:  trailing];foo bar =[1];k$ =[é trailing]"
  assert_eq mh("k$::  trailing  \r\nFoo\tBar: é\n lead :\ré: é\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar: é lead :\\ré: é\""
  assert_eq mh("a-1-c: a\tb\n lead: \x7f\r\nX\t:\r\nfoo bar ::a\tb\r\r\nbody"), "ERR malformed MIME header line: \"A-1-C: a\\tb lead: \\x7f\""
  assert_eq mh("é:é\ré::\n\n"), "ERR malformed MIME header line: \"é:é\\ré::\""
  assert_eq mh("X :é\nCONTENT-type\t:\r\nX\t:  trailing  \r\nfoo bar  :é\r\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:\""
  assert_eq mh("k$:\t\x01\nk$\t:a\tb\n\r\nbody"), "ERR malformed MIME header line: \"K$:\\t\\x01\""
  assert_eq mh(" lead::\nfoo bar : é\n\r\n"), "ERR malformed MIME header initial line: \" lead::\""
  assert_eq mh("a b1\r\na b:: v \n\nbody"), "ERR malformed MIME header: missing colon: \"a b1\""
  assert_eq mh("foo bar :1\n\r\n"), "foo bar =[1]"
  assert_eq mh("é:v\nx-Y_z:\x7f\r\nX: \x01\nk$x y z\r  \ta\tb\nbody"), "ERR malformed MIME header line: \"é:v\""
  assert_eq mh("::  trailing  \ra bé\n:\tv\rx-Y_z: é\r\n\t  trailing  \n\r\n"), "ERR malformed MIME header line: \"::  trailing  \\ra bé\""
  assert_eq mh("Foo\tBar\t:\n 1\rFoo\tBaré\ra-1-c::\r"), "ERR malformed MIME header line: \"Foo\\tBar\\t: 1\\rFoo\\tBaré\\ra-1-c::\\r\""
  assert_eq mh("foo bar ::v\r\nFoo\tBar\t:a\tb\r\té\nbody"), "ERR malformed MIME header line: \"Foo\\tBar\\t:a\\tb\\r\\té\""
  assert_eq mh("foo bar :\x7f\n  \té\r\nx-Y_z:\t\x7f\r\t\nx-Y_z:x y z\n\n"), "ERR malformed MIME header line: \"foo bar :\\x7f é\""
  assert_eq mh("foo bar :a\tb\n\tx y z\ré: v \r\n\nbody"), "ERR malformed MIME header line: \"foo bar :a\\tb x y z\\ré: v\""
  assert_eq mh("x-Y_z: \x7f\r  \tv\nk$ :1\rCONTENT-type::  trailing  \r\n\r\n"), "ERR malformed MIME header line: \"X-Y_z: \\x7f\\r  \\tv\""
  assert_eq mh(" :\x01\r\n\t\x7f\r\nCONTENT-type:\t\r\nX:v\n"), "ERR malformed MIME header initial line: \" :\\x01\""
  assert_eq mh("a b:v\r\nmy-key: v \n\t\x7f\nfoo bar ::v\n  \tv\n\r\n"), "ERR malformed MIME header line: \"My-Key: v \\x7f\""
  assert_eq mh("Foo\t:a\tb\n\ta\tb\r\nk$::  trailing  \r\n  \tx y z\ra-1-c:é\r\nbody"), "ERR malformed MIME header line: \"Foo\\t:a\\tb a\\tb\""
  assert_eq mh(" lead  trailing  \n lead\t: v \r\n\r\nbody"), "ERR malformed MIME header initial line: \" lead  trailing  \""
  assert_eq mh("x-Y_z:  v \rk$: \r\n\n"), "ERR malformed MIME header line: \"X-Y_z:  v \\rk$:\""
  assert_eq mh("éx y z\r"), "ERR malformed MIME header: missing colon: \"éx y z\\r\""
  assert_eq mh("Foo:\t  trailing  \n  v \nFoo\tBar:é\nFoox y z\r\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:é\""
  assert_eq mh("x-Y_z:\ta\tb\n\ta\tb\r\nbody"), "ERR malformed MIME header: missing colon: \"body\""
  assert_eq mh("Foo\tBar::1\rmy-key:é\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar::1\\rmy-key:é\""
  assert_eq mh("Foo: \x7f\r\nx-Y_z\t:\x01\n  \t1\na-1-c :x y z\nbody"), "ERR malformed MIME header line: \"Foo: \\x7f\""
  assert_eq mh("CONTENT-type: v\n\r\n"), "Content-Type=[v]"
  assert_eq mh(": é\r\n"), "ERR malformed MIME header line: \": é\""
  assert_eq mh("x-Y_z:\tx y z\r\n\t  trailing  \r\n"), "X-Y_z=[x y z trailing] +EOF"
  assert_eq mh("foo bar : v\rFoo\tBar\t:v\r\na b:\té\r\nFoo :\x01\r\n \x01\n"), "ERR malformed MIME header line: \"foo bar : v\\rFoo\\tBar\\t:v\""
  assert_eq mh("a b: 1\n\r\n"), "a b=[1]"
  assert_eq mh("my-key:v\r\n::v\r\n  \tv\r\né : v \n\t v \r\n\n"), "ERR malformed MIME header line: \"::v v\""
  assert_eq mh("a-1-c: 1\r\n\t v \nx-Y_z:\t1\r  \t\x7f\r\n lead::\x7f\r\nbody"), "ERR malformed MIME header line: \"X-Y_z:\\t1\\r  \\t\\x7f lead::\\x7f\""
  assert_eq mh("foo bar ::v\nCONTENT-type:\t v \r\n\r\n"), "Content-Type=[v];foo bar =[:v]"
  assert_eq mh("Foo::\x7f\r"), "ERR malformed MIME header line: \"Foo::\\x7f\\r\""
  assert_eq mh("x-Y_z:x y z\ra b:é\r\n\n"), "ERR malformed MIME header line: \"X-Y_z:x y z\\ra b:é\""
  assert_eq mh("Foo::1\r\nfoo bar ::é\r\n\n"), "Foo=[:1];foo bar =[:é]"
  assert_eq mh("x-Y_z\t:\x01\rFoo\tBar:\t\x7f\r é\r\n\nbody"), "ERR malformed MIME header line: \"x-Y_z\\t:\\x01\\rFoo\\tBar:\\t\\x7f\\r é\""
  assert_eq mh("Foo\tBar\t:  trailing  \n\tv\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar\\t:  trailing v\""
  assert_eq mh("my-key :x y z\nFoo\tBar :x y z\n  \ta\tb\n: é\n\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar :x y z a\\tb\""
  assert_eq mh("Foo\tBarx y z\r\n  \tx y z\nx-Y_z\ra b\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBarx y z\""
  assert_eq mh("Foo\tBar::x y z\r\nFoo: \x01\n \x01\r\na-1-c: \x01\r\nCONTENT-type\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar::x y z\""
  assert_eq mh(" lead::\n\r\nbody"), "ERR malformed MIME header initial line: \" lead::\""
  assert_eq mh("k$::x y z\r\nFoox y z\r\n\n"), "ERR malformed MIME header: missing colon: \"Foox y z\""
  assert_eq mh("k$1\ra b:\tv\n\té\nCONTENT-type\t:x y z\r\n é\n\r\nbody"), "ERR malformed MIME header line: \"k$1\\ra b:\\tv é\""
  assert_eq mh("a-1-c\t:\r lead\t: v \r\n\r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:\\r lead\\t: v\""
  assert_eq mh("X::x y z\rX\t:  trailing  \nCONTENT-type :a\tb\n  \t\x7f\rFoo:\tv\r\n   trailing  \n\n"), "ERR malformed MIME header line: \"X::x y z\\rX\\t:  trailing\""
  assert_eq mh(" lead :x y z\r\n a\tb\na-1-c\t:a\tb\n  \t v \r\na-1-c::1\r\tv\r\n\r\nbody"), "ERR malformed MIME header initial line: \" lead :x y z\""
  assert_eq mh("Foo::  trailing  \na b\x01\r\n v\rmy-key:x y z\r\n\r\n"), "ERR malformed MIME header: missing colon: \"a b\\x01\""
  assert_eq mh("x-Y_z: \x7f\r é\n"), "ERR malformed MIME header line: \"X-Y_z: \\x7f\\r é\""
  assert_eq mh("CONTENT-type: é\n  v \r\nk$\t:\x01\nCONTENT-type\t:\x01\n\r\n"), "ERR malformed MIME header line: \"k$\\t:\\x01\""
  assert_eq mh("foo bar \t:a\tb\nCONTENT-type1\r\n\r\nbody"), "ERR malformed MIME header line: \"foo bar \\t:a\\tb\""
  assert_eq mh("CONTENT-type: \nx y z\r\n :a\tb\r\n"), "ERR malformed MIME header: missing colon: \"x y z\""
  assert_eq mh("k$::\x7f\nfoo bar  :1\r\ta\tb\r\né :\r\r\nbody"), "ERR malformed MIME header line: \"K$::\\x7f\""
  assert_eq mh("Foo\tBar  trailing  \na-1-c::\r\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBar  trailing  \""
  assert_eq mh(":\t\nXa\tb\n\r\n"), "ERR malformed MIME header line: \":\""
  assert_eq mh("a b\x7f\r\na-1-c:é\r\n  \tx y z\r\n lead:\t\r\n"), "ERR malformed MIME header: missing colon: \"a b\\x7f\""
  assert_eq mh("my-key:a\tb\nFoo\tBar: v \r\n: x y z\r\n"), "ERR malformed MIME header line: \"Foo\\tBar: v\""
  assert_eq mh("foo bar :\t\né\t:\x7f\r\n\t:1\r\n\r\nbody"), "ERR malformed MIME header line: \"é\\t:\\x7f :1\""
  assert_eq mh("a-1-c\t:  trailing  \r\nFoo:\t\n\r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:  trailing\""
  assert_eq mh("k$x y z\rk$:\tv\r\n  \tv\r\n lead:x y z\n"), "ERR malformed MIME header line: \"k$x y z\\rk$:\\tv v lead:x y z\""
  assert_eq mh("Foo\tBar:x y z\n\t\nFoo::1\r\nfoo bar : \x01\nFoo:\tx y z\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:x y z \""
  assert_eq mh("x-Y_z :1\né::é\na b:1\r"), "ERR malformed MIME header line: \"é::é\""
  assert_eq mh("é :x y z\r\nmy-key::  trailing  \n\r\nbody"), "ERR malformed MIME header line: \"é :x y z\""
  assert_eq mh("x-Y_z:\t\x7f\na-1-c::\né: x y z\r\nfoo bar \t: v \n\r\n"), "ERR malformed MIME header line: \"X-Y_z:\\t\\x7f\""
  assert_eq mh(" lead:\t\r:\r\n\t:1\n\r\nbody"), "ERR malformed MIME header initial line: \" lead:\\t\\r:\""
  assert_eq mh("X:\tv\r\nmy-key: v\r\nx-Y_z: \r\n:v\n\r\n"), "ERR malformed MIME header line: \":v\""
  assert_eq mh(" :a\tb\nX :\x01\n v\né:\t\r\na-1-c : v \r\n\r\n"), "ERR malformed MIME header initial line: \" :a\\tb\""
  assert_eq mh("a-1-c:: v \nX: a\tb\r\n x y z\r\nk$ :é\r\n\n"), "A-1-C=[: v];X=[a\tb x y z];k$ =[é]"
  assert_eq mh("foo bar ::x y z\nmy-key:\x7f\né:\t\r \x7f\r\n\n"), "ERR malformed MIME header line: \"My-Key:\\x7f\""
  assert_eq mh("k$:x y z\r \x01\r\nx-Y_z\né: é\n   trailing  \r\n\r\n"), "ERR malformed MIME header line: \"K$:x y z\\r \\x01\""
}

test "vectors: mime header 9" {
  assert_eq mh("X: 1\r\nFoo: a\tb\na b::a\tb\ra-1-c: 1\n\nbody"), "ERR malformed MIME header line: \"a b::a\\tb\\ra-1-c: 1\""
  assert_eq mh("é:  v \r\nX:  v \r\n lead:x y z\nCONTENT-type::1\r\r\n"), "ERR malformed MIME header line: \"é:  v\""
  assert_eq mh("CONTENT-type\t:\x01\r\na b: \x7f\n\r\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:\\x01\""
  assert_eq mh("CONTENT-type\t:1\rk$:  v \r\n\r\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:1\\rk$:  v\""
  assert_eq mh("a-1-c\t:x y z\r\na ba\tb\r\n lead :\n\r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:x y z\""
  assert_eq mh("Foo::  trailing  \n: a\tb\r\na-1-c::v\rFoo\tBar\x7f\r\n\r\nbody"), "ERR malformed MIME header line: \": a\\tb\""
  assert_eq mh("a-1-c:\x01\nbody"), "ERR malformed MIME header line: \"A-1-C:\\x01\""
  assert_eq mh("Foo::\x01\nk$::\r\na b::\x01\n\r\n"), "ERR malformed MIME header line: \"Foo::\\x01\""
  assert_eq mh(" lead:\tv\r\n \x01\r\n"), "ERR malformed MIME header initial line: \" lead:\\tv\""
  assert_eq mh("my-key\t:\x7f\r\nX\t:\r\nk$\x7f\rFoo:\x7f\r\n"), "ERR malformed MIME header line: \"my-key\\t:\\x7f\""
  assert_eq mh("a-1-c::\x01\r\nbody"), "ERR malformed MIME header line: \"A-1-C::\\x01\""
  assert_eq mh("k$:é\na b :\x01\nCONTENT-type:\x7f\r\nfoo bar :a\tb\r v\r\nbody"), "ERR malformed MIME header line: \"a b :\\x01\""
  assert_eq mh("my-key\t:v\r\n 1\r\na b::a\tb\r\r\nbody"), "ERR malformed MIME header line: \"my-key\\t:v 1\""
  assert_eq mh("x-Y_z\t:1\nx-Y_z :\x01\r\nmy-key : v \r\nFoo:\té\n\r\n"), "ERR malformed MIME header line: \"x-Y_z\\t:1\""
  assert_eq mh("my-key:\t v \r\nfoo bar \x01\nFoo v \n"), "ERR malformed MIME header: missing colon: \"foo bar \\x01\""
  assert_eq mh("x-Y_z :\x01\r\né:1\na-1-c: \x7f\r\nFoo\tBar::\r\n\n"), "ERR malformed MIME header line: \"x-Y_z :\\x01\""
  assert_eq mh(" lead\n\n"), "ERR malformed MIME header initial line: \" lead\""
  assert_eq mh("my-key::v\r\na b:\t\r\n"), "My-Key=[:v];a b=[] +EOF"
  assert_eq mh(" lead:\x01\r\nFoo :\x7f\r\n\nbody"), "ERR malformed MIME header initial line: \" lead:\\x01\""
  assert_eq mh("x-Y_z :v\r\nX:1\r\nmy-key:  v \n"), "My-Key=[v];X=[1];x-Y_z =[v] +EOF"
  assert_eq mh("CONTENT-type:\ta\tb\nk$: \x7f\ra b:x y z\nfoo bar \t:\x01\r\r\n"), "ERR malformed MIME header line: \"K$: \\x7f\\ra b:x y z\""
  assert_eq mh("é::\nx-Y_z :\n\r\n"), "ERR malformed MIME header line: \"é::\""
  assert_eq mh("CONTENT-type: x y z\r  \t\x01\na b\t:é\n\r\n"), "ERR malformed MIME header line: \"Content-Type: x y z\\r  \\t\\x01\""
  assert_eq mh(" :\nk$:  v \r\nbody"), "ERR malformed MIME header initial line: \" :\""
  assert_eq mh(" lead :é\r\t:x y z\n\nbody"), "ERR malformed MIME header initial line: \" lead :é\\r\\t:x y z\""
  assert_eq mh("a b:: v \n\r\n"), "a b=[: v]"
  assert_eq mh("my-key::a\tb\nmy-key\t: v \r lead:\t1\r\n"), "ERR malformed MIME header line: \"my-key\\t: v \\r lead:\\t1\""
  assert_eq mh("k$:\té\r\nX :1\r\nx-Y_za\tb\r\na b: v \r\n\n"), "ERR malformed MIME header: missing colon: \"x-Y_za\\tb\""
  assert_eq mh("my-key: v \r\nX:\t\x01\nx-Y_z: é\r\n\r\n"), "ERR malformed MIME header line: \"X:\\t\\x01\""
  assert_eq mh(" lead: 1\r\nk$ :  trailing  \r\né::1\n  \t\x7f\r\n"), "ERR malformed MIME header initial line: \" lead: 1\""
  assert_eq mh("a-1-c\t:\x01\r\n\t v \n lead:\té\nx-Y_z::1\r\n\r\n"), "ERR malformed MIME header line: \"a-1-c\\t:\\x01 v lead:\\té\""
  assert_eq mh("k$:\x01\r\n \x7f\r\nmy-key::1\r\n\r\n"), "ERR malformed MIME header line: \"K$:\\x01 \\x7f\""
  assert_eq mh(" lead :x y z\r\n:\r\nk$:a\tb\r\nbody"), "ERR malformed MIME header initial line: \" lead :x y z\""
  assert_eq mh("é : v \r\n lead:\t1\r\t v \r\n\r\n"), "ERR malformed MIME header line: \"é : v lead:\\t1\\r\\t v\""
  assert_eq mh(" lead\t:\x7f\r\n\r\nbody"), "ERR malformed MIME header initial line: \" lead\\t:\\x7f\""
  assert_eq mh("é:\r\nfoo bar \t:\x7f\n\t1\r"), "ERR malformed MIME header line: \"é:\""
  assert_eq mh("my-key: é\r\n v\n\r\nbody"), "My-Key=[é v]"
  assert_eq mh("é: \r :\x01\nmy-key :\x01\n\t\x01\n\r\n"), "ERR malformed MIME header line: \"é: \\r :\\x01\""
  assert_eq mh("CONTENT-type\t:  trailing  \r\na b :é\n\r\n"), "ERR malformed MIME header line: \"CONTENT-type\\t:  trailing\""
  assert_eq mh("my-key:\tx y z\nfoo bar  : v \r\n\n"), "My-Key=[x y z];foo bar  =[v]"
  assert_eq mh("Foo\tBara\tb\r\né: v \r\nFoo\t:é\n\r\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBara\\tb\""
  assert_eq mh("Foo:\t\rFoo :\n\r\n"), "ERR malformed MIME header line: \"Foo:\\t\\rFoo :\""
  assert_eq mh(": é\nCONTENT-type:\ta\tb\r:\t\x01\rFoo\tBar\t:1\r\n\r\n"), "ERR malformed MIME header line: \": é\""
  assert_eq mh("X\t:1\nx-Y_z: \x7f\r\n\r\n"), "ERR malformed MIME header line: \"X\\t:1\""
  assert_eq mh("CONTENT-typex y z\r\na-1-c\t:\x01\r\nfoo bar :\t\x7f\n\n"), "ERR malformed MIME header: missing colon: \"CONTENT-typex y z\""
  assert_eq mh("Foo::\r 1\nFoo :\r\n  \té\r\n\r\n"), "ERR malformed MIME header line: \"Foo::\\r 1\""
  assert_eq mh(" lead\x01\r\nCONTENT-type\t:1\r\nX:x y z\r\n:\t1\n\n"), "ERR malformed MIME header initial line: \" lead\\x01\""
  assert_eq mh("Foo\tBar :\x01\r\n   trailing  \r\nCONTENT-type :\r\nmy-key::  trailing  \r\né:\t v \n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar :\\x01 trailing\""
  assert_eq mh("CONTENT-type\t:\rx-Y_z:\x7f\r"), "ERR malformed MIME header line: \"CONTENT-type\\t:\\rx-Y_z:\\x7f\\r\""
  assert_eq mh(" lead:x y z\r\nX:\x7f\r\n\n"), "ERR malformed MIME header initial line: \" lead:x y z\""
  assert_eq mh("a-1-c:\ta\tb\r x y z\r\nmy-key: v \na b v \r\n\n"), "ERR malformed MIME header line: \"A-1-C:\\ta\\tb\\r x y z\""
  assert_eq mh("Foo\tBar:\t\na-1-c:\t  trailing  \n\té\r\n\nbody"), "ERR malformed MIME header line: \"Foo\\tBar:\""
  assert_eq mh("my-key : v \r\r\n"), "ERR malformed MIME header line: \"my-key : v \\r\""
  assert_eq mh("X:\tx y z\r\nx-Y_z: x y z\na-1-c :x y z\r\n\r\nbody"), "X=[x y z];X-Y_z=[x y z];a-1-c =[x y z]"
  assert_eq mh("X: a\tb\nFoo\tBar::\x7f\nfoo bar a\tb\r\nCONTENT-type :a\tb\n"), "ERR malformed MIME header line: \"Foo\\tBar::\\x7f\""
  assert_eq mh("é1\nfoo bar ::\x01\r\n\r\n"), "ERR malformed MIME header: missing colon: \"é1\""
  assert_eq mh(": \n"), "ERR malformed MIME header line: \":\""
  assert_eq mh(" lead :v\r 1\n\r\nbody"), "ERR malformed MIME header initial line: \" lead :v\\r 1\""
  assert_eq mh("foo bar  :1\r\n:\tx y z\r  trailing  \r\r\nbody"), "ERR malformed MIME header line: \":\\tx y z\\r  trailing  \\r\""
  assert_eq mh("k$\t:\x01\r\nFoo: a\tb\r\n"), "ERR malformed MIME header line: \"k$\\t:\\x01\""
  assert_eq mh("foo bar \t:\x7f\r\n\r\n"), "ERR malformed MIME header line: \"foo bar \\t:\\x7f\""
  assert_eq mh("a b\t:\x01\r\na b:\t  trailing  \rCONTENT-type:  trailing  \r:\tv\r\r\n"), "ERR malformed MIME header line: \"a b\\t:\\x01\""
  assert_eq mh("k$\t:é\n  \tv\nmy-key\t:v\r\nmy-key:x y z\n\n"), "ERR malformed MIME header line: \"k$\\t:é v\""
  assert_eq mh("é :\r::  trailing  \r\té\rfoo bar \t:  trailing  \r\n\t\x7f\n\r\n"), "ERR malformed MIME header line: \"é :\\r::  trailing  \\r\\té\\rfoo bar \\t:  trailing \\x7f\""
  assert_eq mh("a b::v\nfoo bar  :v\r\n"), "a b=[:v];foo bar  =[v] +EOF"
  assert_eq mh("a b:\t\r\nx-Y_z:\té\n  \ta\tb\nmy-key::1\ré\r"), "ERR malformed MIME header line: \"My-Key::1\\ré\\r\""
  assert_eq mh("a-1-c\x7f\r\r\n"), "ERR malformed MIME header: missing colon: \"a-1-c\\x7f\\r\""
  assert_eq mh("Foo\tBar\x01\r\né : v \r\r\n"), "ERR malformed MIME header: missing colon: \"Foo\\tBar\\x01\""
  assert_eq mh("Foo :x y z\n  \tx y z\r\nCONTENT-type::é\r\n  \t\x01\na b :  trailing  \r\n\r\n"), "ERR malformed MIME header line: \"Content-Type::é \\x01\""
  assert_eq mh("X :\x01\n\r\nbody"), "ERR malformed MIME header line: \"X :\\x01\""
  assert_eq mh("CONTENT-type::x y z\r\nX\t:\x7f\n"), "ERR malformed MIME header line: \"X\\t:\\x7f\""
  assert_eq mh("a-1-c\t:  trailing  \r\n lead\t:v\r\n\tx y z\r\t:x y z\rFoo:\tx y z\n\r\n"), "ERR malformed MIME header line: \"a-1-c\\t:  trailing lead\\t:v x y z\\r\\t:x y z\\rFoo:\\tx y z\""
  assert_eq mh("my-key v \ra bv\r\n  \t v \nmy-key:: v \rFoo\tBar:\t\x01\r\n\tx y z\nbody"), "ERR malformed MIME header: missing colon: \"my-key v \\ra bv\""
  assert_eq mh("a b:1\r\n  \t\x7f\r\n leada\tb\r \r\n\n"), "ERR malformed MIME header line: \"a b:1 \\x7f leada\\tb\\r\""
  assert_eq mh("x-Y_z\t:  trailing  \r\né:x y z\r\nx-Y_z:\x7f\n\nbody"), "ERR malformed MIME header line: \"x-Y_z\\t:  trailing\""
  assert_eq mh("X:\t1\r\nfoo bar :\t\r\nk$: é\r\né::1\r\n"), "ERR malformed MIME header line: \"é::1\""
  assert_eq mh(" lead:\x01\nx-Y_z\r\nX: v\r\n: 1\r\n\n"), "ERR malformed MIME header initial line: \" lead:\\x01\""
  assert_eq mh("x-Y_z :\x7f\r\nx-Y_z::1\né: 1\r\n v\r\n lead:x y z\r\n\n"), "ERR malformed MIME header line: \"x-Y_z :\\x7f\""
}

test "vectors: mime header 10" {
  assert_eq mh("a b:\té\r\nCONTENT-type\t: v \n: \x7f\r\na-1-c:\ta\tb\r  \ta\tb\r"), "ERR malformed MIME header line: \"CONTENT-type\\t: v\""
  assert_eq mh("Foo\tBar: \x7f\n  \ta\tb\r\na b:\té\nFoo: \x01\nk$::1\r\n\n"), "ERR malformed MIME header line: \"Foo\\tBar: \\x7f a\\tb\""
  assert_eq mh("X::a\tb\r\n\t\nFoo:\t\x01\n lead:  trailing  \r\n  \t\x01\rFoo v \r\n  \t1\r\n\r\n"), "ERR malformed MIME header line: \"Foo:\\t\\x01 lead:  trailing \\x01\\rFoo v 1\""
  assert_eq mh("x y z\r\n v\r\n: a\tb\r  \té\na-1-c\nCONTENT-type:\t\n\r\n"), "ERR malformed MIME header: missing colon: \"x y z\""
  assert_eq mh("X :é\n\ta\tb\nFoo: 1\r\r\n"), "ERR malformed MIME header line: \"Foo: 1\\r\""
  assert_eq mh("CONTENT-type: v \r\n\n"), "Content-Type=[v]"
  assert_eq mh("Foo:v\n   trailing  \né:a\tb\nFoo\tBar :1\r\na-1-c\t:x y z\nbody"), "ERR malformed MIME header line: \"é:a\\tb\""
  assert_eq mh("x-Y_z\x7f\n\r\n"), "ERR malformed MIME header: missing colon: \"x-Y_z\\x7f\""
  assert_eq mh("CONTENT-type:\t  trailing  \r\nbody"), "ERR malformed MIME header: missing colon: \"body\""
  assert_eq mh("CONTENT-type :v\r\n\r\n"), "CONTENT-type =[v]"
  assert_eq mh("a b: é\nk$\x7f\r  \t1\nmy-keyé\n\tx y z\r\r\nbody"), "ERR malformed MIME header: missing colon: \"k$\\x7f\\r  \\t1\""
  assert_eq mh("x-Y_z\t:\x01\n\nbody"), "ERR malformed MIME header line: \"x-Y_z\\t:\\x01\""
  assert_eq mh("k$: x y z\n\té\rx-Y_z:v\r\t\r\na b::é\n"), "ERR malformed MIME header line: \"K$: x y z é\\rx-Y_z:v\\r\""
  assert_eq mh("foo bar :1\nFoo:\n \r lead: x y z\nCONTENT-type: v\r\n\t\x01\n\n"), "ERR malformed MIME header line: \"Foo: \\r lead: x y z\""
  assert_eq mh("x-Y_z:\t\x7f\r\nCONTENT-type: x y z\rFoo\tBar\x01\r\n\r\n"), "ERR malformed MIME header line: \"X-Y_z:\\t\\x7f\""
  assert_eq mh("a b :x y z\n\n"), "a b =[x y z]"
  assert_eq mh("a b:\t\x01\n  \t  trailing  \r\n::\x7f\r:x y z\rFoo\tBar:\t\x01\r\n"), "ERR malformed MIME header line: \"a b:\\t\\x01 trailing\""
  assert_eq mh("k$\r\nCONTENT-typex y z\na b::\r"), "ERR malformed MIME header: missing colon: \"k$\""
  assert_eq mh(": \x01\r\nX: 1\r\n::v\n"), "ERR malformed MIME header line: \": \\x01\""
  assert_eq mh("Foo\tBar:\n \x7f\ré v \nmy-key:é\rX:\t\x7f\r\n"), "ERR malformed MIME header line: \"Foo\\tBar: \\x7f\\ré v\""
  assert_eq mh("a b :v\nFoo :a\tb\nx-Y_z::\x7f\r  \t v \n"), "ERR malformed MIME header line: \"X-Y_z::\\x7f\\r  \\t v\""
  assert_eq mh("Foo:\t  trailing  \r\n  \t\x7f\r lead\t:1\r\na b :é\r\n\r\n"), "ERR malformed MIME header line: \"Foo:\\t  trailing \\x7f\\r lead\\t:1\""
  assert_eq mh("é::é\r\nbody"), "ERR malformed MIME header line: \"é::é\""
  assert_eq mh("CONTENT-type::1\r\n  \t  trailing  \r\nFoo\tBar\t:é\n\n"), "ERR malformed MIME header line: \"Foo\\tBar\\t:é\""
  assert_eq mh("Foo:\x7f\r\né::\x7f\rFoo\tBar:  trailing  \n\n"), "ERR malformed MIME header line: \"Foo:\\x7f\""
  assert_eq mh("Foo\tBar :x y z\nk$:v\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar :x y z\""
  assert_eq mh("Foo\tBar:\t1\r\n\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar:\\t1\""
  assert_eq mh("CONTENT-type:\tv\n\r\nbody"), "Content-Type=[v]"
  assert_eq mh("é :1\r\nFoo\t:\r  \t\x7f\nFoo\tBar: \x01\r\n\r\n"), "ERR malformed MIME header line: \"é :1\""
  assert_eq mh("é\x01\r\n  \té\rFoo:1\n\té\n"), "ERR malformed MIME header: missing colon: \"é\\x01\""
  assert_eq mh("k$x y z\n"), "ERR malformed MIME header: missing colon: \"k$x y z\""
  assert_eq mh("Foo: x y z\ré :\x01\r\n\r\n"), "ERR malformed MIME header line: \"Foo: x y z\\ré :\\x01\""
  assert_eq mh("a b:\tv\na b\t:v\rCONTENT-type: \x7f\rFoo\tBar\t:é\r\n  \té\r\n"), "ERR malformed MIME header line: \"a b\\t:v\\rCONTENT-type: \\x7f\\rFoo\\tBar\\t:é é\""
  assert_eq mh("foo bar \t: v \nFoo\tBaré\n lead: v\r\nFoo\tBar\t:\x7f\n\nbody"), "ERR malformed MIME header line: \"foo bar \\t: v\""
  assert_eq mh("é\x7f\n  \tx y z\nmy-key: a\tb\n\n"), "ERR malformed MIME header: missing colon: \"é\\x7f\""
  assert_eq mh("CONTENT-type\t: v \ra-1-c :  trailing  \r\nx-Y_z:é\r\n  \t\x01\r\n"), "ERR malformed MIME header line: \"CONTENT-type\\t: v \\ra-1-c :  trailing\""
  assert_eq mh(" : v \n lead1\nFoo: v\r\n\n"), "ERR malformed MIME header initial line: \" : v \""
  assert_eq mh("foo bar :\t\x01\r\nX:1\r\n  \t\x01\nmy-key :\r\n\r\n"), "ERR malformed MIME header line: \"foo bar :\\t\\x01\""
  assert_eq mh("Foo :\x7f\rFoo v \r\n\r\nbody"), "ERR malformed MIME header line: \"Foo :\\x7f\\rFoo v\""
  assert_eq mh("Foo\tBar\t:x y z\r :\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar\\t:x y z\\r :\""
  assert_eq mh("Foo:\t\x7f\r\nx-Y_z :a\tb\r\nbody"), "ERR malformed MIME header line: \"Foo:\\t\\x7f\""
  assert_eq mh("k$:\t  trailing  \rmy-key :x y z\n\nbody"), "ERR malformed MIME header line: \"K$:\\t  trailing  \\rmy-key :x y z\""
  assert_eq mh("é\t:\x01\r\nx-Y_z : v \r\né:\tv\r\nFoo1\r\n\nbody"), "ERR malformed MIME header line: \"é\\t:\\x01\""
  assert_eq mh("Foo v \ré\t: v \r\nX: 1\r\n\t1\rFoo\t:é\n \r\n\r\n"), "ERR malformed MIME header line: \"Foo v \\ré\\t: v\""
  assert_eq mh("my-key :x y z\r\nX:\t\r\n  \t\x01\r\n\r\nbody"), "ERR malformed MIME header line: \"X: \\x01\""
  assert_eq mh("foo bar :  trailing  \nx-Y_z:\t1\r\na b : v \nx-Y_z:é\n\r\nbody"), "X-Y_z=[1|é];a b =[v];foo bar =[trailing]"
  assert_eq mh("k$\x7f\r\n  \t1\r\nmy-key:  v \r\né:\n\r\nbody"), "ERR malformed MIME header: missing colon: \"k$\\x7f\""
  assert_eq mh("Foo:\t\x7f\n x y z\n\r\n"), "ERR malformed MIME header line: \"Foo:\\t\\x7f x y z\""
  assert_eq mh("éé\nx-Y_z: v\n 1\na-1-c: 1\n v\nFoo\tBar: é\r\n"), "ERR malformed MIME header: missing colon: \"éé\""
  assert_eq mh("k$1\r\n\r\n"), "ERR malformed MIME header: missing colon: \"k$1\""
  assert_eq mh("a b:\t  trailing  \n lead:\x7f\r\n"), "ERR malformed MIME header line: \"a b:\\t  trailing lead:\\x7f\""
  assert_eq mh(":\té\r\n:\té\nFoo:\tx y z\n\r\n"), "ERR malformed MIME header line: \":\\té\""
  assert_eq mh("X\t:v\r\nX:\x01\ré : v \rmy-key:\x01\r\n  \t\r\n\r\nbody"), "ERR malformed MIME header line: \"X\\t:v\""
  assert_eq mh("CONTENT-type: \x7f\r\n\t v \r"), "ERR malformed MIME header line: \"Content-Type: \\x7f v \\r\""
  assert_eq mh(" lead::é\r\n a\tb\na b :1\r\n lead: \x01\r\n lead::v\r\n\r\nbody"), "ERR malformed MIME header initial line: \" lead::é\""
  assert_eq mh("foo bar  :\x01\r\nCONTENT-type:\x01\ra b\t:é\r\nk$:\té\r\n é\r\n\r\nbody"), "ERR malformed MIME header line: \"foo bar  :\\x01\""
  assert_eq mh("x-Y_z:\t1\nx-Y_z :1\r  v \r\n: 1\n\r\n"), "ERR malformed MIME header line: \"x-Y_z :1\\r  v\""
  assert_eq mh("x-Y_z:1\n::é\r\n  \té\na-1-c: 1\r\n\n"), "ERR malformed MIME header line: \"::é é\""
  assert_eq mh("foo bar \t:a\tb\na-1-c:  v \r\nbody"), "ERR malformed MIME header line: \"foo bar \\t:a\\tb\""
  assert_eq mh("é:\x7f\r\n\t\x01\r\nmy-key\t:  trailing  \n\té\r\n"), "ERR malformed MIME header line: \"é:\\x7f \\x01\""
  assert_eq mh("foo bar ::é\ra bé\n\r\n"), "ERR malformed MIME header line: \"foo bar ::é\\ra bé\""
  assert_eq mh("X: v\r\na-1-c: x y z\rCONTENT-type:\tx y z\r\r\n"), "ERR malformed MIME header line: \"A-1-C: x y z\\rCONTENT-type:\\tx y z\\r\""
  assert_eq mh("é: v \nx-Y_z\t:\x7f\r\n"), "ERR malformed MIME header line: \"é: v\""
  assert_eq mh("CONTENT-type: v\nfoo bar  :1\nFoo\tBar:\t\x7f\r\nX::\x7f\n \x7f\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\t\\x7f\""
  assert_eq mh("my-key::v\n\r\n"), "My-Key=[:v]"
  assert_eq mh(" lead\nFoo\t:a\tb\n  \t\r\n\nbody"), "ERR malformed MIME header initial line: \" lead\""
  assert_eq mh("k$::é\nFoo\tBar\x7f\r\n\r\nbody"), "ERR malformed MIME header: missing colon: \"Foo\\tBar\\x7f\""
  assert_eq mh("my-key :  trailing  \nx-Y_z:\tv\nk$:1\rX: x y z\r\n\nbody"), "ERR malformed MIME header line: \"K$:1\\rX: x y z\""
  assert_eq mh("Foo\tBar:\t v \rFoo\tBar\t:é\né:\tx y z\n  \t\x7f\r\n\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\t v \\rFoo\\tBar\\t:é\""
  assert_eq mh("CONTENT-type::\x7f\r\nCONTENT-type :\x7f\rFoo\tBar\t:\r\n  \té\r\nFoo: \x01\n\r\nbody"), "ERR malformed MIME header line: \"Content-Type::\\x7f\""
  assert_eq mh("k$:\t  trailing  \né::x y z\nX : v \r\r\n"), "ERR malformed MIME header line: \"é::x y z\""
  assert_eq mh("é::1\n é\r\nCONTENT-type:: v \r\n\t\x01\nFoo\tBarx y z\r\n lead:\t\r\n é\rbody"), "ERR malformed MIME header line: \"é::1 é\""
  assert_eq mh("foo bar :\t  trailing  \r\n::\r\nx-Y_z:  trailing  \r \x01\r\n"), "ERR malformed MIME header line: \"::\""
  assert_eq mh("CONTENT-type::1\r\nx-Y_z:   trailing  \nmy-key: v\r\n\r\nbody"), "Content-Type=[:1];My-Key=[v];X-Y_z=[trailing]"
  assert_eq mh("k$\x7f\n \x7f\n\t:a\tb\nFoo\tBar\t:x y z\r x y z\rFoo::a\tb\r\n"), "ERR malformed MIME header: missing colon: \"k$\\x7f\""
  assert_eq mh("X :a\tb\r\n"), "X =[a\tb] +EOF"
  assert_eq mh("CONTENT-type :v\r\nx-Y_z v \nX::x y z\r\n\t\x01\r\nFoo\tBar : v \r\n\r\nbody"), "ERR malformed MIME header: missing colon: \"x-Y_z v \""
  assert_eq mh("my-key :1\r\n\r\n"), "my-key =[1]"
  assert_eq mh("Foo\tBar:\té\nFoo\t:  trailing  \n  \t  trailing  \r\n lead\t:v\r\n x y z\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\té\""
  assert_eq mh("é :\x7f\nk$::\x01\n\r\n"), "ERR malformed MIME header line: \"é :\\x7f\""
  assert_eq mh(" lead\r\n\r\nbody"), "ERR malformed MIME header initial line: \" lead\""
}

test "vectors: mime header 11" {
  assert_eq mh("é:\ta\tb\n::\x7f\r\nCONTENT-typeé\r\n\nbody"), "ERR malformed MIME header line: \"é:\\ta\\tb\""
  assert_eq mh("Foo:\tx y z\nfoo bar \t:  trailing  \r\nFoo\tBar\t:\x7f\nFoo\tBar::é\n  \tx y z\r\n\r\nbody"), "ERR malformed MIME header line: \"foo bar \\t:  trailing\""
  assert_eq mh("CONTENT-type: \x7f\r\nmy-key :  trailing  \nx-Y_z:é\r  v \r\nmy-key::\r\n\nbody"), "ERR malformed MIME header line: \"Content-Type: \\x7f\""
  assert_eq mh("\t:\x01\nFoo\tBar: a\tb\n \nmy-key :\x01\r\r\n"), "ERR malformed MIME header initial line: \"\\t:\\x01\""
  assert_eq mh("Foo:\t\r\n\n"), "Foo=[]"
  assert_eq mh("k$:\ta\tb\r\n\t\x7f\na b\t:x y z\r\n\r\n"), "ERR malformed MIME header line: \"K$:\\ta\\tb \\x7f\""
  assert_eq mh("a-1-c :  trailing  \r\n\r\n"), "a-1-c =[trailing]"
  assert_eq mh("a b\x7f\r\n:\ta\tb\nFoo\tBar:\ta\tb\r\n"), "ERR malformed MIME header: missing colon: \"a b\\x7f\""
  assert_eq mh("a b::a\tb\r\n\tv\r\nmy-key::  trailing  \r\n v\n\n"), "My-Key=[:  trailing v];a b=[:a\tb v]"
  assert_eq mh("my-key: é\nFoo:   trailing  \r\n lead:\tx y z\na b: a\tb\n\n"), "Foo=[trailing lead:\tx y z];My-Key=[é];a b=[a\tb]"
  assert_eq mh("a b:é\r\né\t:\nbody"), "ERR malformed MIME header line: \"é\\t:\""
  assert_eq mh("a b v \r\nCONTENT-type\t: v \nX\t:\n  \tx y z\rX:1\r\n"), "ERR malformed MIME header: missing colon: \"a b v \""
  assert_eq mh("my-key::1\r\n 1\nXv\na-1-c:\t\r\n:x y z\n   trailing  \r"), "ERR malformed MIME header: missing colon: \"Xv\""
  assert_eq mh("k$:\té\r\na\tb\r\nX::\n\r\n"), "ERR malformed MIME header: missing colon: \"a\\tb\""
  assert_eq mh("k$\t:  trailing  \ra-1-c:: v \nk$: v \n \r\r\n"), "ERR malformed MIME header line: \"k$\\t:  trailing  \\ra-1-c:: v\""
  assert_eq mh("x-Y_z :a\tb\né\t:\x01\r\nfoo bar : v \r\n\n"), "ERR malformed MIME header line: \"é\\t:\\x01\""
  assert_eq mh("a-1-c\t: v \r \x01\nFoo\t:  trailing  \n"), "ERR malformed MIME header line: \"a-1-c\\t: v \\r \\x01\""
  assert_eq mh(" lead:\tv\r  \t1\r\n"), "ERR malformed MIME header initial line: \" lead:\\tv\\r  \\t1\""
  assert_eq mh("k$:\t\x7f\n\t\x01\r\nmy-key\t:  trailing  \n\r\n"), "ERR malformed MIME header line: \"K$:\\t\\x7f \\x01\""
  assert_eq mh(" lead:\t\x01\n::a\tb\r \x7f\na-1-c:\t1\n\r\nbody"), "ERR malformed MIME header initial line: \" lead:\\t\\x01\""
  assert_eq mh("a-1-c::\x7f\r\n 1\n leada\tb\rX\t:1\rCONTENT-typea\tb\r\nbody"), "ERR malformed MIME header line: \"A-1-C::\\x7f 1 leada\\tb\\rX\\t:1\\rCONTENT-typea\\tb\""
  assert_eq mh(" lead::a\tb\r\nx-Y_z:\t  trailing  \r  \t v \n\r\nbody"), "ERR malformed MIME header initial line: \" lead::a\\tb\""
  assert_eq mh("foo bar \r\tx y z\ré: 1\r\n\t v \nX\t:\x01\n\n"), "ERR malformed MIME header line: \"foo bar \\r\\tx y z\\ré: 1 v\""
  assert_eq mh("Foo:\t\r\n  \té\r\né::\x7f\r\n\r\n"), "ERR malformed MIME header line: \"é::\\x7f\""
  assert_eq mh("a b:\tv\r\n\té\r\na b:\x7f\n\té\nmy-key  trailing  \n"), "ERR malformed MIME header line: \"a b:\\x7f é\""
  assert_eq mh("k$::\nX\t: v \ré:\té\n\n"), "ERR malformed MIME header line: \"X\\t: v \\ré:\\té\""
  assert_eq mh("a-1-c\t: v \nX :\x7f\nk$: \nFoo\tBar :  trailing  \r\n\r\nbody"), "ERR malformed MIME header line: \"a-1-c\\t: v\""
  assert_eq mh("CONTENT-type:\ta\tb\r\n v\rFoo\tBar\t:é\n\n"), "ERR malformed MIME header line: \"Content-Type:\\ta\\tb v\\rFoo\\tBar\\t:é\""
  assert_eq mh("CONTENT-type::  trailing  \r\nk$: v \nfoo bar ::1\r\n a\tb\r\n lead:\t\x7f\n\tx y z\n\r\n"), "ERR malformed MIME header line: \"foo bar ::1 a\\tb lead:\\t\\x7f x y z\""
  assert_eq mh("X: \x7f\r\nmy-key :\x01\n"), "ERR malformed MIME header line: \"X: \\x7f\""
  assert_eq mh("X:\t\x01\n:a\tb\r\n\r\n"), "ERR malformed MIME header line: \"X:\\t\\x01\""
  assert_eq mh("foo bar :a\tb\n:\ta\tb\nk$: 1\r\n  \t\n\r\nbody"), "ERR malformed MIME header line: \":\\ta\\tb\""
  assert_eq mh("CONTENT-type:\x7f\r\n  \t\x7f\ré :x y z\rmy-key:\r\n"), "ERR malformed MIME header line: \"Content-Type:\\x7f \\x7f\\ré :x y z\\rmy-key:\""
  assert_eq mh("a b::\r\t\x7f\r\nfoo bar \t:\x01\r\nFoo\tBar\t:a\tb\n \r\nX: a\tb\r\n\r\n"), "ERR malformed MIME header line: \"a b::\\r\\t\\x7f\""
  assert_eq mh("Foo\tBar: v\r\na bx y z\r\n leadé\n\r\nbody"), "ERR malformed MIME header line: \"Foo\\tBar: v\""
  assert_eq mh("Foo\tBar:\x01\nfoo bar  :  trailing  \rFoo\tBar:\t v \nX\t:\x01\r\n\nbody"), "ERR malformed MIME header line: \"Foo\\tBar:\\x01\""
  assert_eq mh("a-1-c:\t1\r\n  \ta\tb\nfoo bar \t:\x01\n\t  trailing  \nCONTENT-type :\x7f\r\né: \x01\r\r\nbody"), "ERR malformed MIME header line: \"foo bar \\t:\\x01 trailing\""
  assert_eq mh("CONTENT-type: a\tb\rfoo bar ::1\n\r\n"), "ERR malformed MIME header line: \"Content-Type: a\\tb\\rfoo bar ::1\""
  assert_eq mh("a-1-c:\t  trailing  \n\r\n"), "A-1-C=[trailing]"
  assert_eq mh(" lead :1\r\nmy-key\t:\x01\nbody"), "ERR malformed MIME header initial line: \" lead :1\""
  assert_eq mh("x-Y_z\t:\x01\n\r\n"), "ERR malformed MIME header line: \"x-Y_z\\t:\\x01\""
  assert_eq mh(" lead: \x01\nk$: 1\r\n\n"), "ERR malformed MIME header initial line: \" lead: \\x01\""
  assert_eq mh("é\n  \t1\na b  trailing  \r\n\n"), "ERR malformed MIME header: missing colon: \"é\""
  assert_eq mh("x-Y_z::v\nmy-key:\t\r\n"), "My-Key=[];X-Y_z=[:v] +EOF"
  assert_eq mh("a b: v\na-1-c :\x7f\r\n"), "ERR malformed MIME header line: \"a-1-c :\\x7f\""
  assert_eq mh("x-Y_z :v\r\nFoo\tBar\t: v \r\nmy-key:\tx y z\n   trailing  \r\nfoo bar  :v\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar\\t: v\""
  assert_eq mh("a b :1\r\n\t\x7f\ré: a\tb\rFoo\tBar :1\r\n  \t\x7f\nfoo bar : \x7f\r\n"), "ERR malformed MIME header line: \"a b :1 \\x7f\\ré: a\\tb\\rFoo\\tBar :1 \\x7f\""
  assert_eq mh("é\t:1\n :\x7f\r\nFoo\tBar:\t\n\r\n"), "ERR malformed MIME header line: \"é\\t:1 :\\x7f\""
  assert_eq mh("Foo\x01\r\nmy-key: x y z\r\n\n"), "ERR malformed MIME header: missing colon: \"Foo\\x01\""
  assert_eq mh("k$:  trailing  \r\r\n"), "ERR malformed MIME header line: \"K$:  trailing  \\r\""
  assert_eq mh(" lead\t:a\tb\r\t  trailing  \n\n"), "ERR malformed MIME header initial line: \" lead\\t:a\\tb\\r\\t  trailing  \""
  assert_eq mh("::1\r\nk$v\n"), "ERR malformed MIME header line: \"::1\""
  assert_eq mh("a b1\n\t\na-1-c:  trailing  \na-1-c\r\r\n"), "ERR malformed MIME header: missing colon: \"a b1\""
  assert_eq mh("a b:  trailing  \r\nx-Y_zé\r\n"), "ERR malformed MIME header: missing colon: \"x-Y_zé\""
  assert_eq mh("a-1-c\t:a\tb\r\nk$:\t\x7f\n lead : v \r\nFoo:\t v \n\nbody"), "ERR malformed MIME header line: \"a-1-c\\t:a\\tb\""
  assert_eq mh(":\x7f\rbody"), "ERR malformed MIME header line: \":\\x7f\\rbody\""
  assert_eq mh("a b:\t\x01\r\n lead\t:a\tb\r 1\r\nx-Y_z :\x7f\n\r\nbody"), "ERR malformed MIME header line: \"a b:\\t\\x01 lead\\t:a\\tb\\r 1\""
  assert_eq mh("X::v\r\n\r\n"), "X=[:v]"
  assert_eq mh(":\x7f\r\n\nbody"), "ERR malformed MIME header line: \":\\x7f\""
  assert_eq mh("foo bar \t:  trailing  \n\r\n"), "ERR malformed MIME header line: \"foo bar \\t:  trailing\""
  assert_eq mh("a b\t:\x01\rbody"), "ERR malformed MIME header line: \"a b\\t:\\x01\\rbody\""
  assert_eq mh(": x y z\r\n lead:\t v \r\nFoo\tBar:\tv\r  v \r\n\n"), "ERR malformed MIME header line: \": x y z lead:\\t v\""
  assert_eq mh("é::  trailing  \nmy-key:\ta\tb\n:\tv\r v\nCONTENT-type\t:  trailing  \r\n"), "ERR malformed MIME header line: \"é::  trailing\""
  assert_eq mh("Foo\tBar:\tx y z\r\nfoo bar :\t\x01\rx-Y_z::1\r\n\r\n"), "ERR malformed MIME header line: \"Foo\\tBar:\\tx y z\""
  assert_eq mh("foo bar a\tb\n\n"), "ERR malformed MIME header: missing colon: \"foo bar a\\tb\""
  assert_eq mh("foo bar  :\x7f\né:\tx y z\r\nFoo\tBar:   trailing  \r\n\r\n"), "ERR malformed MIME header line: \"foo bar  :\\x7f\""
  assert_eq mh("a-1-c :\r\n\ta\tb\n\r\n"), "a-1-c =[a\tb]"
  assert_eq mh(":1\r\nCONTENT-type: \x7f\r\n\r\n"), "ERR malformed MIME header line: \":1\""
  assert_eq mh("é:   trailing  \r\nmy-key:v\nFoo\tBar::é\rCONTENT-type\t:\x01\r\n\n"), "ERR malformed MIME header line: \"é:   trailing\""
  assert_eq mh("Foo\tBar: \x01\n\t1\rbody"), "ERR malformed MIME header line: \"Foo\\tBar: \\x01 1\\rbody\""
  assert_eq mh("a-1-c:\ta\tb\nbody"), "ERR malformed MIME header: missing colon: \"body\""
  assert_eq mh(" lead :1\nX:\t1\n\nbody"), "ERR malformed MIME header initial line: \" lead :1\""
  assert_eq mh("X::\x7f\r\nfoo bar  :\x01\r\nx-Y_z : v \n\t:\x01\n \x7f\r\n\n"), "ERR malformed MIME header line: \"X::\\x7f\""
  assert_eq mh("x-Y_z::\r\nFoo: a\tb\rmy-key\t:\x7f\r\n\r\n"), "ERR malformed MIME header line: \"Foo: a\\tb\\rmy-key\\t:\\x7f\""
  assert_eq mh("k$:\t  trailing  \r\nX:\tv\n"), "K$=[trailing];X=[v] +EOF"
}

test "vectors: canonical key 0" {
  assert_eq canonical_mime_header_key("é-xcontent-type"), "é-xcontent-type"
  assert_eq canonical_mime_header_key("1a-b2a.b-c---a"), "1a-B2a.b-C---A"
  assert_eq canonical_mime_header_key("cOnTeNt-TyPeCONTENT-TYPE-x_y-z"), "Content-Typecontent-Type-X_y-Z"
  assert_eq canonical_mime_header_key("1a-b2cOnTeNt-TyPe"), "1a-B2content-Type"
  assert_eq canonical_mime_header_key("é-xa:b-cOnTeNt-TyPe"), "é-xa:b-cOnTeNt-TyPe"
  assert_eq canonical_mime_header_key("1a-b2-foo"), "1a-B2-Foo"
  assert_eq canonical_mime_header_key("WWW-AUTHENTICATEé-x"), "WWW-AUTHENTICATEé-x"
  assert_eq canonical_mime_header_key("x-forwarded-for-a"), "X-Forwarded-For-A"
  assert_eq canonical_mime_header_key("x\tyx y--"), "x\tyx y--"
  assert_eq canonical_mime_header_key("x\ty-foo--"), "x\ty-foo--"
  assert_eq canonical_mime_header_key("-cOnTeNt-TyPe-foo-"), "-Content-Type-Foo-"
  assert_eq canonical_mime_header_key("-CONTENT-TYPE-a.b-c"), "-Content-Type-A.b-C"
  assert_eq canonical_mime_header_key("-~-~"), "-~-~"
  assert_eq canonical_mime_header_key("--ax_y-z-content-type"), "--Ax_y-Z-Content-Type"
  assert_eq canonical_mime_header_key("-a:b"), "-a:b"
  assert_eq canonical_mime_header_key("1a-b2a.b-c-foo-"), "1a-B2a.b-C-Foo-"
  assert_eq canonical_mime_header_key("foo-a:b"), "foo-a:b"
  assert_eq canonical_mime_header_key("a.b-cx-forwarded-for-~-~"), "A.b-Cx-Forwarded-For-~-~"
  assert_eq canonical_mime_header_key("CONTENT-TYPEWWW-AUTHENTICATE-x y"), "CONTENT-TYPEWWW-AUTHENTICATE-x y"
  assert_eq canonical_mime_header_key("cOnTeNt-TyPeCONTENT-TYPE"), "Content-Typecontent-Type"
  assert_eq canonical_mime_header_key("--acOnTeNt-TyPe"), "--Acontent-Type"
  assert_eq canonical_mime_header_key("WWW-AUTHENTICATEcontent-type-x\ty"), "WWW-AUTHENTICATEcontent-type-x\ty"
  assert_eq canonical_mime_header_key("~-~cOnTeNt-TyPe"), "~-~content-Type"
  assert_eq canonical_mime_header_key("a--bx-forwarded-for"), "A--Bx-Forwarded-For"
  assert_eq canonical_mime_header_key("aA"), "Aa"
  assert_eq canonical_mime_header_key("content-typex_y-z-foo-"), "Content-Typex_y-Z-Foo-"
  assert_eq canonical_mime_header_key("a:b--a-x-forwarded-for"), "a:b--a-x-forwarded-for"
  assert_eq canonical_mime_header_key("a:bfoo---foo"), "a:bfoo---foo"
