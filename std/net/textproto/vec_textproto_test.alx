  assert_eq dotb("aaax.y"), "ERR unexpected EOF"
  assert_eq dotb("...\r.\r\n .\r\n"), "ERR unexpected EOF"
  assert_eq dotb(".\r\n....\r.\r\n"), ""
  assert_eq dotb(" \n.."), "ERR unexpected EOF"
  assert_eq dotb("..\r.\nx.yx.y"), "ERR unexpected EOF"
  assert_eq dotb("\n \n\r\n.\r\n\n\r\n"), "\n \n\n"
  assert_eq dotb("..\nx.y.\r\n\r\n"), "ERR unexpected EOF"
  assert_eq dotb(".\r\nx.y.\n\r\n"), ""
  assert_eq dotb("\r\n\n"), "ERR unexpected EOF"
  assert_eq dotb("..\n..x.y"), "ERR unexpected EOF"
  assert_eq dotb("..\r\n .\r\n\r\nx.y\n"), "ERR unexpected EOF"
  assert_eq dotb("\r.\r\n\r.\r\n"), "ERR unexpected EOF"
  assert_eq dotb("\n.\n..\n.a"), "ERR unexpected EOF"
  assert_eq dotb("a\r\n.\n"), "a\n"
  assert_eq dotb("....x.y...\r\n"), "ERR unexpected EOF"
  assert_eq dotb("aa.\n.\r\n a"), "aa.\n"
  assert_eq dotb("x.y..\r\n"), "ERR unexpected EOF"
  assert_eq dotb(".\r\nx.y\r\n...\n"), ""
  assert_eq dotb("\na.\r\n.\r\n\r\r\n\r"), "\na.\n"
  assert_eq dotb("\r\n\r\n\r\n.\n.."), "\n\n\n"
  assert_eq dotb(".\r\na..a.."), ""
  assert_eq dotb("a...\r\n\n .\nx.y"), "ERR unexpected EOF"
  assert_eq dotb("x.y..x.y\r\n.\r\n\n"), "x.y..x.y\n"
  assert_eq dotb("\r..\r"), "ERR unexpected EOF"
  assert_eq dotb("a..\n.\r"), "ERR unexpected EOF"
  assert_eq dotb("..."), "ERR unexpected EOF"
  assert_eq dotb("\n.\nx.y\r\n\r"), "ERR unexpected EOF"
  assert_eq dotb(".\n\r\n.."), ""
  assert_eq dotb("\r.."), "ERR unexpected EOF"
  assert_eq dotb(".\r\n...\n\r\n"), ""
  assert_eq dotb("..ax.y\r.\n"), "ERR unexpected EOF"
  assert_eq dotb(".a\r\n..  "), "ERR unexpected EOF"
  assert_eq dotb(".\r\n.\n"), ""
  assert_eq dotb(".\r\n\r\nx.y\r"), ""
  assert_eq dotb(".\n\ra ax.y"), ""
  assert_eq dotb("x.y\r"), "ERR unexpected EOF"
  assert_eq dotb(".\r\n.\r\n.\na\r\n "), ""
  assert_eq dotb("\ra.\n\n .."), "ERR unexpected EOF"
  assert_eq dotb("x.y\na x.y "), "ERR unexpected EOF"
  assert_eq dotb("..\r\r"), "ERR unexpected EOF"
  assert_eq dotb("\r\ra\n .\r\n "), "ERR unexpected EOF"
  assert_eq dotb("\r\r..\n\r.\n"), "ERR unexpected EOF"
  assert_eq dotb("x.ya."), "ERR unexpected EOF"
  assert_eq dotb("\r\r.\n.\r\n.\n.\r\n.."), "\r\r.\n"
  assert_eq dotb("   .."), "ERR unexpected EOF"
  assert_eq dotb("..\r."), "ERR unexpected EOF"
  assert_eq dotb(".\n\r\n "), ""
  assert_eq dotb("\nx.y\n...a.."), "ERR unexpected EOF"
  assert_eq dotb(".x.y\n.\r\n\n"), "x.y\n"
  assert_eq dotb("..a..\r\n\r"), "ERR unexpected EOF"
  assert_eq dotb("\r\n\r"), "ERR unexpected EOF"
  assert_eq dotb("x.y...\r\n"), "ERR unexpected EOF"
}

test "vectors: dot bytes 2" {
  assert_eq dotb(".\r\n\n.\nx.y.\r\nx.y"), ""
  assert_eq dotb(" . .\r\n"), "ERR unexpected EOF"
  assert_eq dotb(".\n.\r\n.."), ""
  assert_eq dotb("\r\r\n.\nx.y"), "\r\n"
