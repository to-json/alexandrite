test "vectors: code line 0" {
  assert_eq rcl("250x5.1.1 fail\n99x lead\n2500x lead\n", 4), "ERR short response: \"250x5.1.1 fail\""
  assert_eq rcl(" hello world\nfree text\r\nxok", 25), "ERR short response: \" hello world\""
  assert_eq rcl("free text\n550 5.1.1 fail\n99x lead", 0), "ERR short response: \"free text\""
  assert_eq rcl("1234 5.1.1 fail\nfree text\n2500x5.1.1 fail\n1234hello world\n", 2), "ERR short response: \"1234 5.1.1 fail\""
  assert_eq rcl("free text\nabc5.1.1 fail", 550), "ERR short response: \"free text\""
  assert_eq rcl("free text\r\n1234-\r\n  lead\n220 \n", 220), "ERR short response: \"free text\""
  assert_eq rcl("1234 ok\n250x5.1.1 fail\n", 1), "ERR short response: \"1234 ok\""
  assert_eq rcl("-\n", 22), "ERR short response: \"-\""
  assert_eq rcl("free text\r\n99-hello world\n", 550), "ERR short response: \"free text\""
  assert_eq rcl("250- lead\r\n", 250), "ERR unexpected multi-line response: \" lead\""
  assert_eq rcl("2505.1.1 fail\r\n", 5), "ERR short response: \"2505.1.1 fail\""
  assert_eq rcl("550 hello world\n", 22), "CODE 550|hello world"
  assert_eq rcl("2500 5.1.1 fail\n", 1), "ERR short response: \"2500 5.1.1 fail\""
  assert_eq rcl("free text\nfree text\n", 250), "ERR short response: \"free text\""
  assert_eq rcl("free text\r\n220  lead\r\n2500 hello world\r\n", 2), "ERR short response: \"free text\""
  assert_eq rcl("220  lead\nabc \n250 ok\n", 5), "CODE 220| lead"
  assert_eq rcl("2500-\nxhello world\r\n250- lead\n", 1), "ERR short response: \"2500-\""
  assert_eq rcl("free text", 4), "ERR short response: \"free text\""
  assert_eq rcl("abchello world\r\n", 0), "ERR short response: \"abchello world\""
