  assert_eq rr("99 5.1.1 fail\r\n250-5.1.1 fail\n", 220), "ERR short response: \"99 5.1.1 fail\""
  assert_eq rr("220 \n250 5.1.1 fail\nabc\n550hello world\n", 0), "220|"
