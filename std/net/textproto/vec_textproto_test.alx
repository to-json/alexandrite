  assert_eq rcl("550 hello world\n", 550), "550|hello world"
  assert_eq rcl("220x\n", 25), "ERR short response: \"220x\""
  assert_eq rcl("250  lead\nx lead\r\nabcxhello world\nabc hello world", 1), "CODE 250| lead"
  assert_eq rcl("free text\r\n220-hello world\nfree text\r", 2), "ERR short response: \"free text\""
