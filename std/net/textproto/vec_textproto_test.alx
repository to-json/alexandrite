  assert_eq rcl("220hello world\n220  lead\nfree text\n  lead", 2), "ERR short response: \"220hello world\""
  assert_eq rcl("abcok\r\n2500  lead\n220x5.1.1 fail\n1234-ok", 25), "ERR short response: \"abcok\""
