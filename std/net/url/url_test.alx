  [
    ("http://www.google.com", Url.new(scheme: "http", host: "www.google.com"), ""),
    ("http://www.google.com/", Url.new(scheme: "http", host: "www.google.com", path: "/"), ""),
    ("http://www.google.com/file%20one%26two", Url.new(scheme: "http", host: "www.google.com", path: "/file one&two", raw_path: "/file%20one%26two"), ""),
    ("http://www.google.com/\#file%20one%26two", Url.new(scheme: "http", host: "www.google.com", path: "/", fragment: "file one&two", raw_fragment: "file%20one%26two"), ""),
    ("ftp://webmaster@www.google.com/", Url.new(scheme: "ftp", user: user("webmaster"), host: "www.google.com", path: "/"), ""),
