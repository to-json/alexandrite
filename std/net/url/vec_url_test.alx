  assert_eq usum_p("=é[..(]?;\#%%20%2F "), "ERR parse \"=é[..(]?;\#%%20%2F \": invalid URL escape \"%%2\""
  assert_eq usum_p("a+b.c-d:/^p%40w^@[fe80::1%25en0]a"), "opaque=\"\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"/^p@w^@[fe80::1%en0]a\", rawpath=\"/^p%40w^@[fe80::1%25en0]a\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | a+b.c-d:/%5Ep@w%5E@%5Bfe80::1%25en0%5Da | /%5Ep@w%5E@%5Bfe80::1%25en0%5Da |  | /%5Ep@w%5E@%5Bfe80::1%25en0%5Da |  |  | a+b.c-d:/%5Ep@w%5E@%5Bfe80::1%25en0%5Da | true"
