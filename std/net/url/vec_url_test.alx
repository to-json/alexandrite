  assert_eq usum_p("https:"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https: |  |  | / |  |  | https: | true"
  assert_eq usum_p("http:!.%zz@*"), "opaque=\"!.%zz@*\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:!.%zz@* |  |  | !.%zz@* |  |  | http:!.%zz@* | true"
  assert_eq usum_p("//[::1?+"), "ERR parse \"//[::1?+\": missing ']' in host"
  assert_eq usum_p("1x:(?a=1;"), "ERR parse \"1x:(?a=1;\": first path segment in URL cannot contain colon"
  assert_eq usum_p("mailto:EXAMPLE.org:*%20a ?"), "opaque=\"EXAMPLE.org:*%20a \", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | mailto:EXAMPLE.org:*%20a ? |  |  | EXAMPLE.org:*%20a ? |  |  | mailto:EXAMPLE.org:*%20a ? | true"
  assert_eq usum_p("s_c://[::ffff:1.2.3.4]';p+?é\#/%20é"), "ERR parse \"s_c://[::ffff:1.2.3.4]';p+?é\": first path segment in URL cannot contain colon"
  assert_eq usum_p("http:/x%41:\#\#!é/"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"/xA:\", rawpath=\"/x%41:\", rawq=\"\", frag=\"\#!é/\", rawfrag=\"\#!é/\", forcequery=false, omithost=true | http:/x%41:\#%23!%C3%A9/ | /x%41: | %23!%C3%A9/ | /x%41: |  |  | http:/x%41:\#%23!%C3%A9/ | true"
  assert_eq usum_p("1x://[1.2.3.4]?\#f!!"), "ERR parse \"1x://[1.2.3.4]?\": first path segment in URL cannot contain colon"
  assert_eq usum_p("https:"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https: |  |  | / |  |  | https: | true"
  assert_eq usum_p("s_c:host1:1,host2:2\#"), "ERR parse \"s_c:host1:1,host2:2\": first path segment in URL cannot contain colon"
  assert_eq usum_p("https:/[::1:80:%zz%20(@"), "ERR parse \"https:/[::1:80:%zz%20(@\": invalid URL escape \"%zz\""
  assert_eq usum_p("mailto:/h%C3%A9 %25(?"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"/hé %(\", rawpath=\"/h%C3%A9 %25(\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=true | mailto:/h%C3%A9%20%25%28? | /h%C3%A9%20%25%28 |  | /h%C3%A9%20%25%28? |  |  | mailto:/h%C3%A9%20%25%28? | true"
  assert_eq usum_p("s_c://[fe80::1%en0]:80)'(%20..??&é"), "ERR parse \"s_c://[fe80::1%en0]:80)'(%20..??&é\": first path segment in URL cannot contain colon"
  assert_eq usum_p("//1.2.3.4:/ %25.\#$&'()*+,;=é$&'()*+,;="), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"1.2.3.4:\", path=\"/ %.\", rawpath=\"/ %25.\", rawq=\"\", frag=\"$&'()*+,;=é$&'()*+,;=\", rawfrag=\"$&'()*+,;=é$&'()*+,;=\", forcequery=false, omithost=false | //1.2.3.4:/%20%25.\#$&%27()*+,;=%C3%A9$&%27()*+,;= | /%20%25. | $&%27()*+,;=%C3%A9$&%27()*+,;= | /%20%25. | 1.2.3.4 |  | //1.2.3.4:/%20%25.\#$&%27()*+,;=%C3%A9$&%27()*+,;= | false"
  assert_eq usum_p("https://%20@u^@x%41:8080?"), "ERR parse \"https://%20@u^@x%41:8080?\": invalid URL escape \"%41\""
  assert_eq usum_p("postgres:/:p%40w@+/!%25?"), "opaque=\"\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"/:p@w@+/!%\", rawpath=\"/:p%40w@+/!%25\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=true | postgres:/:p%40w@+/!%25? | /:p%40w@+/!%25 |  | /:p%40w@+/!%25? |  |  | postgres:/:p%40w@+/!%25? | true"
  assert_eq usum_p("x:b%2Fc%zz?="), "opaque=\"b%2Fc%zz\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"=\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | x:b%2Fc%zz?= |  |  | b%2Fc%zz?= |  |  | x:b%2Fc%zz?= | true"
  assert_eq usum_p("mailto:host1:1,host2:2é'~.%20\#f\#/%20"), "opaque=\"host1:1,host2:2é'~.%20\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"f\#/ \", rawfrag=\"f\#/%20\", forcequery=false, omithost=false | mailto:host1:1,host2:2é'~.%20\#f%23/%20 |  | f%23/%20 | host1:1,host2:2é'~.%20 |  |  | mailto:host1:1,host2:2é'~.%20\#f%23/%20 | true"
  assert_eq usum_p("mailto:/host1:1,host2:2:%38%30//[)]*+"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"/host1:1,host2:2:80//[)]*+\", rawpath=\"/host1:1,host2:2:%38%30//[)]*+\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | mailto:/host1:1,host2:2:%38%30//[)]*+ | /host1:1,host2:2:%38%30//[)]*+ |  | /host1:1,host2:2:%38%30//[)]*+ |  |  | mailto:/host1:1,host2:2:%38%30//[)]*+ | true"
  assert_eq usum_p("mailto://host1:1,host2:2://a[\#%2F%"), "ERR parse \"mailto://host1:1,host2:2://a[\#%2F%\": invalid URL escape \"%\""
  assert_eq usum_p("ftp:&(//"), "opaque=\"&(//\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:&(// |  |  | &(// |  |  | ftp:&(// | true"
  assert_eq usum_p("ftp:/[1.2.3.4]+=?%20=\#%é"), "ERR parse \"ftp:/[1.2.3.4]+=?%20=\#%é\": invalid URL escape \"%é\""
  assert_eq usum_p("file://local_host:80%"), "ERR parse \"file://local_host:80%\": invalid port \":80%\" after host"
  assert_eq usum_p("HTTP://[::1]!%zza?=b%zz%zz\#"), "ERR parse \"HTTP://[::1]!%zza?=b%zz%zz\": invalid port \"!%zza\" after host"
  assert_eq usum_p("ftp://%20%20@EXAMPLE.org]!%25]\#\#f/"), "opaque=\"\", scheme=\"ftp\", user=\"  \", pass=nil, host=\"EXAMPLE.org]!%]\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\#f/\", rawfrag=\"\#f/\", forcequery=false, omithost=false | ftp://%20%20@EXAMPLE.org]!%25]\#%23f/ |  | %23f/ | / | EXAMPLE.org]!%] |  | ftp://%20%20@EXAMPLE.org]!%25]\#%23f/ | true"
  assert_eq usum_p("ftp://^u%20%20@[1.2.3.4]:':;p)\#"), "ERR parse \"ftp://^u%20%20@[1.2.3.4]:':;p)\": invalid port \":':;p)\" after host"
  assert_eq usum_p("http:/[1.2.3.4]:80:/]%('@"), "ERR parse \"http:/[1.2.3.4]:80:/]%('@\": invalid URL escape \"%('\""
  assert_eq usum_p("ftp:/:%38%30(//.?a=1+%20a=1"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"/:80(//.\", rawpath=\"/:%38%30(//.\", rawq=\"a=1+%20a=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | ftp:/:%38%30(//.?a=1+%20a=1 | /:%38%30(//. |  | /:%38%30(//.?a=1+%20a=1 |  |  | ftp:/:%38%30(//.?a=1+%20a=1 | true"
  assert_eq usum_p("https:%%%25?a=1a=1%20\#!!f"), "opaque=\"%%%25\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"a=1a=1%20\", frag=\"!!f\", rawfrag=\"\", forcequery=false, omithost=false | https:%%%25?a=1a=1%20\#!!f |  | !!f | %%%25?a=1a=1%20 |  |  | https:%%%25?a=1a=1%20\#!!f | true"
  assert_eq usum_p("http:&:?é&="), "opaque=\"&:\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"é&=\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:&:?é&= |  |  | &:?é&= |  |  | http:&:?é&= | true"
  assert_eq usum_p("https:[1.2.3.4]'"), "opaque=\"[1.2.3.4]'\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:[1.2.3.4]' |  |  | [1.2.3.4]' |  |  | https:[1.2.3.4]' | true"
  assert_eq usum_p("ftp://[fe80::1%en0]:!+&?;%20"), "ERR parse \"ftp://[fe80::1%en0]:!+&?;%20\": invalid port \":!+&\" after host"
  assert_eq usum_p("[::1]?a=1é/é"), "ERR parse \"[::1]?a=1é/é\": first path segment in URL cannot contain colon"
}

test "vectors: parse request uri" {
  assert_eq usum_rq("https:///example.com:80:=é//"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"/example.com:80:=é//\", rawpath=\"/example.com:80:=é//\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:///example.com:80:=%C3%A9// | /example.com:80:=%C3%A9// |  | /example.com:80:=%C3%A9// |  |  | https:///example.com:80:=%C3%A9// | true"
  assert_eq usum_rq("file:EXAMPLE.org:%38%30/é"), "opaque=\"EXAMPLE.org:%38%30/é\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | file:EXAMPLE.org:%38%30/é |  |  | EXAMPLE.org:%38%30/é |  |  | file:EXAMPLE.org:%38%30/é | true"
  assert_eq usum_rq("/ftp://[::ffff:1.2.3.4]++=..//@?&?"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/ftp://[::ffff:1.2.3.4]++=..//@\", rawpath=\"/ftp://[::ffff:1.2.3.4]++=..//@\", rawq=\"&?\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /ftp://[::ffff:1.2.3.4]++=..//@?&? | /ftp://[::ffff:1.2.3.4]++=..//@ |  | /ftp://[::ffff:1.2.3.4]++=..//@?&? |  |  | /ftp://[::ffff:1.2.3.4]++=..//@?&? | false"
  assert_eq usum_rq("/!@//?=;"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/!@//\", rawpath=\"/!@//\", rawq=\"=;\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /!@//?=; | /!@// |  | /!@//?=; |  |  | /!@//?=; | false"
  assert_eq usum_rq("s_c://!!p%40w^@[fe80::1%en0]:8080@!*+~\#"), "ERR parse \"s_c://!!p%40w^@[fe80::1%en0]:8080@!*+~\#\": invalid URI for request"
  assert_eq usum_rq("mailto://example.com:%38%30b%2Fc[:~*%20?"), "ERR parse \"mailto://example.com:%38%30b%2Fc[:~*%20?\": invalid IP-literal"
  assert_eq usum_rq("a+b.c-d:///example.com(..//%25+.?a=1\#éf%2F%2F"), "opaque=\"\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"/example.com(..//%+.\", rawpath=\"/example.com(..//%25+.\", rawq=\"a=1\#éf%2F%2F\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:///example.com(..//%25+.?a=1\#éf%2F%2F | /example.com(..//%25+. |  | /example.com(..//%25+.?a=1\#éf%2F%2F |  |  | a+b.c-d:///example.com(..//%25+.?a=1\#éf%2F%2F | true"
  assert_eq usum_rq("HTTP:"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http: |  |  | / |  |  | http: | true"
  assert_eq usum_rq("http://x%41"), "ERR parse \"http://x%41\": invalid URL escape \"%41\""
  assert_eq usum_rq("a+b.c-d://[::ffff:1.2.3.4];p/?"), "ERR parse \"a+b.c-d://[::ffff:1.2.3.4];p/?\": invalid port \";p\" after host"
  assert_eq usum_rq("/a+b.c-d://serp%40w@1.2.3.4:8080&+'*"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/a+b.c-d://serp@w@1.2.3.4:8080&+'*\", rawpath=\"/a+b.c-d://serp%40w@1.2.3.4:8080&+'*\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /a+b.c-d://serp%40w@1.2.3.4:8080&+'* | /a+b.c-d://serp%40w@1.2.3.4:8080&+'* |  | /a+b.c-d://serp%40w@1.2.3.4:8080&+'* |  |  | /a+b.c-d://serp%40w@1.2.3.4:8080&+'* | false"
  assert_eq usum_rq("/mailto://[fe80::1%en0]/]"), "ERR parse \"/mailto://[fe80::1%en0]/]\": invalid URL escape \"%en\""
  assert_eq usum_rq("a+b.c-d://[1.2.3.4]::] "), "ERR parse \"a+b.c-d://[1.2.3.4]::] \": invalid port \" \" after host"
  assert_eq usum_rq("https:/1.2.3.4%20"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"/1.2.3.4 \", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | https:/1.2.3.4%20 | /1.2.3.4%20 |  | /1.2.3.4%20 |  |  | https:/1.2.3.4%20 | true"
  assert_eq usum_rq("https:"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https: |  |  | / |  |  | https: | true"
  assert_eq usum_rq("\#%!\#f"), "ERR parse \"\#%!\#f\": invalid URI for request"
  assert_eq usum_rq("ftp://[1.2.3.4]"), "ERR parse \"ftp://[1.2.3.4]\": invalid IP-literal"
  assert_eq usum_rq("https:///[::1]: =@%zz??"), "ERR parse \"https:///[::1]: =@%zz??\": invalid URL escape \"%zz\""
  assert_eq usum_rq("a+b.c-d:///:%38%30/:/:%25?/+"), "opaque=\"\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"/:80/:/:%\", rawpath=\"/:%38%30/:/:%25\", rawq=\"/+\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:///:%38%30/:/:%25?/+ | /:%38%30/:/:%25 |  | /:%38%30/:/:%25?/+ |  |  | a+b.c-d:///:%38%30/:/:%25?/+ | true"
  assert_eq usum_rq("file:///[fe80::1%en0]*]\#%2F\#é"), "ERR parse \"file:///[fe80::1%en0]*]\#%2F\#é\": invalid URL escape \"%en\""
  assert_eq usum_rq("1x: [%25?bb"), "ERR parse \"1x: [%25?bb\": invalid URI for request"
  assert_eq usum_rq("a+b.c-d:@?%20=%zza=1"), "opaque=\"@\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"%20=%zza=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:@?%20=%zza=1 |  |  | @?%20=%zza=1 |  |  | a+b.c-d:@?%20=%zza=1 | true"
  assert_eq usum_rq("//[1.2.3.4]b%2Fc"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"//[1.2.3.4]b/c\", rawpath=\"//[1.2.3.4]b%2Fc\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | //[1.2.3.4]b%2Fc | //[1.2.3.4]b%2Fc |  | //[1.2.3.4]b%2Fc |  |  | //[1.2.3.4]b%2Fc | false"
  assert_eq usum_rq("/ftp://p%40w@@x%41//+b%2Fc..b%2Fc\#%2F\#é\#"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/ftp://p@w@@xA//+b/c..b/c\#/\#é\#\", rawpath=\"/ftp://p%40w@@x%41//+b%2Fc..b%2Fc\#%2F\#é\#\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /ftp://p@w@@xA//+b/c..b/c%23/%23%C3%A9%23 | /ftp://p@w@@xA//+b/c..b/c%23/%23%C3%A9%23 |  | /ftp://p@w@@xA//+b/c..b/c%23/%23%C3%A9%23 |  |  | /ftp://p@w@@xA//+b/c..b/c%23/%23%C3%A9%23 | false"
  assert_eq usum_rq("/ftp://[fe80::1%25en0]~\#%/"), "ERR parse \"/ftp://[fe80::1%25en0]~\#%/\": invalid URL escape \"%/\""
  assert_eq usum_rq("//[fe80::1%25en0]%'/=é!"), "ERR parse \"//[fe80::1%25en0]%'/=é!\": invalid URL escape \"%'/\""
  assert_eq usum_rq("/http:/%20^:p%40w@[::ffff:1.2.3.4]!//:%25+??&a=1é"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/http:/ ^:p@w@[::ffff:1.2.3.4]!//:%+\", rawpath=\"/http:/%20^:p%40w@[::ffff:1.2.3.4]!//:%25+\", rawq=\"?&a=1é\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /http:/%20%5E:p@w@%5B::ffff:1.2.3.4%5D%21//:%25+??&a=1é | /http:/%20%5E:p@w@%5B::ffff:1.2.3.4%5D%21//:%25+ |  | /http:/%20%5E:p@w@%5B::ffff:1.2.3.4%5D%21//:%25+??&a=1é |  |  | /http:/%20%5E:p@w@%5B::ffff:1.2.3.4%5D%21//:%25+??&a=1é | false"
  assert_eq usum_rq("http://[::1]:80:///=*)@"), "ERR parse \"http://[::1]:80:///=*)@\": invalid port \":80:\" after host"
  assert_eq usum_rq("HTTP:h%C3%A9%?éa=1&"), "opaque=\"h%C3%A9%\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"éa=1&\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:h%C3%A9%?éa=1& |  |  | h%C3%A9%?éa=1& |  |  | http:h%C3%A9%?éa=1& | true"
  assert_eq usum_rq("HTTP:[fe80::1%25en0]:x&"), "opaque=\"[fe80::1%25en0]:x&\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:[fe80::1%25en0]:x& |  |  | [fe80::1%25en0]:x& |  |  | http:[fe80::1%25en0]:x& | true"
  assert_eq usum_rq("postgres://h%C3%A9:%38%30\#"), "ERR parse \"postgres://h%C3%A9:%38%30\#\": invalid port \":%38%30\#\" after host"
  assert_eq usum_rq("/ftp:..!%25"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/ftp:..!%\", rawpath=\"/ftp:..!%25\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /ftp:..!%25 | /ftp:..!%25 |  | /ftp:..!%25 |  |  | /ftp:..!%25 | false"
  assert_eq usum_rq("/https:/a b"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/https:/a b\", rawpath=\"/https:/a b\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /https:/a%20b | /https:/a%20b |  | /https:/a%20b |  |  | /https:/a%20b | false"
  assert_eq usum_rq("//(a\#$&'()*+,;=%20/$&'()*+,;="), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"//(a\#$&'()*+,;= /$&'()*+,;=\", rawpath=\"//(a\#$&'()*+,;=%20/$&'()*+,;=\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | //%28a%23$&%27%28%29%2A+,;=%20/$&%27%28%29%2A+,;= | //%28a%23$&%27%28%29%2A+,;=%20/$&%27%28%29%2A+,;= |  | //%28a%23$&%27%28%29%2A+,;=%20/$&%27%28%29%2A+,;= |  |  | //%28a%23$&%27%28%29%2A+,;=%20/$&%27%28%29%2A+,;= | false"
  assert_eq usum_rq("s_c:%zz!%20%20%20"), "ERR parse \"s_c:%zz!%20%20%20\": invalid URI for request"
  assert_eq usum_rq("x:local_host[b%2Fc=\#\# \#"), "opaque=\"local_host[b%2Fc=\#\# \#\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | x:local_host[b%2Fc=\#\# \# |  |  | local_host[b%2Fc=\#\# \# |  |  | x:local_host[b%2Fc=\#\# \# | true"
  assert_eq usum_rq("s_c://!:ser@h%C3%A9'?%zz&bé"), "ERR parse \"s_c://!:ser@h%C3%A9'?%zz&bé\": invalid URI for request"
  assert_eq usum_rq("/file:ser%20@a b"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/file:ser @a b\", rawpath=\"/file:ser%20@a b\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /file:ser%20@a%20b | /file:ser%20@a%20b |  | /file:ser%20@a%20b |  |  | /file:ser%20@a%20b | false"
