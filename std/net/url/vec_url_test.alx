  assert_eq usum_p("ftp:///!%20"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"/! \", rawpath=\"/!%20\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:///!%20 | /!%20 |  | /!%20 |  |  | ftp:///!%20 | true"
  assert_eq usum_p("file://:x:%%\# "), "ERR parse \"file://:x:%%\": invalid port \":%%\" after host"
  assert_eq usum_p("https:..b%2Fc:"), "opaque=\"..b%2Fc:\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:..b%2Fc: |  |  | ..b%2Fc: |  |  | https:..b%2Fc: | true"
  assert_eq usum_p("++é?"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"++é\", rawpath=\"++é\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | ++%C3%A9? | ++%C3%A9 |  | ++%C3%A9? |  |  | ++%C3%A9? | false"
  assert_eq usum_p("1x:ser@[fe80::1%25en0]!!a%\#$&'()*+,;=/"), "ERR parse \"1x:ser@[fe80::1%25en0]!!a%\": first path segment in URL cannot contain colon"
  assert_eq usum_p(" .%\#f%f "), "ERR parse \" .%\": invalid URL escape \"%\""
  assert_eq usum_p("mailto:/@p%40w^@:8080a]a*@%25?a=1bb/\# "), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"/@p@w^@:8080a]a*@%\", rawpath=\"/@p%40w^@:8080a]a*@%25\", rawq=\"a=1bb/\", frag=\" \", rawfrag=\" \", forcequery=false, omithost=true | mailto:/@p@w%5E@:8080a%5Da%2A@%25?a=1bb/\#%20 | /@p@w%5E@:8080a%5Da%2A@%25 | %20 | /@p@w%5E@:8080a%5Da%2A@%25?a=1bb/ |  |  | mailto:/@p@w%5E@:8080a%5Da%2A@%25?a=1bb/\#%20 | true"
}

test "vectors: parse 10" {
