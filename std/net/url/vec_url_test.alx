  assert_eq esc("a)|~Z"), ("a%29%7C~Z", "a%29%7C~Z", "a)|~Z", "a)|~Z")
  assert_eq esc("\\%&`+\#."), ("%5C%25%26%60%2B%23.", "%5C%25&%60+%23.", "ERR invalid URL escape \"%&`\"", "ERR invalid URL escape \"%&`\"")
  assert_eq esc(hx("017c40ff5b01")), ("%01%7C%40%FF%5B%01", "%01%7C@%FF%5B%01", hx("017c40ff5b01"), hx("017c40ff5b01"))
