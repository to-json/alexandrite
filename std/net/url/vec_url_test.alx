  assert_eq jp("é[!;p*[", ["b/b/", "a"]), "%C3%A9%5B%21;p%2A%5B/b/b/a"
}

test "vectors: join path 3" {
  assert_eq jp("file:a b&]+) ?&", ["%2F"]), "file:a b&]+) ?&"
  assert_eq jp("https:///EXAMPLE.org:80&\#f", ["/%c d"]), "ERR invalid URL escape \"%c \""
  assert_eq jp("file:/p%40wu@p%40w@1.2.3.4:\# %2Féé", ["//%2F..", ".c d//"]), "file:/p@wu@p@w@1.2.3.4://../.c%20d/\#%20/%C3%A9%C3%A9"
  assert_eq jp("file:/%20!%20u@local_host:%38%30;p=.?+?", ["b/."]), "file:/%20!%20u@local_host:%38%30;p=./b?+?"
  assert_eq jp("mailto:%zz:@(", ["."]), "mailto:%zz:@("
  assert_eq jp("mailto:///a b?=é;", ["//.%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("https:[fe80::1%25en0]%25%20.*~..?%20é==", ["b///."]), "https:[fe80::1%25en0]%25%20.*~..?%20é=="
  assert_eq jp("x:?%20%zz?%zz", ["...."]), "x://....?%20%zz?%zz"
  assert_eq jp("http:=:é/?%zza=1%zz", ["%...."]), "ERR invalid URL escape \"%..\""
  assert_eq jp("postgres:1.2.3.4;p .%25", []), "postgres:1.2.3.4;p .%25"
  assert_eq jp("file:/example.com..~??\#  ", ["b/a//"]), "file:/example.com..~/b/a/??\#%20%20"
  assert_eq jp("https:/1.2.3.4:x!*@a!", ["c d", "c d"]), "https:/1.2.3.4:x%21%2A@a%21/c%20d/c%20d"
  assert_eq jp("x:/example.com;p\#!//", ["c d%", ".."]), "x:/example.com;p\#!//"
  assert_eq jp("mailto:///@ser:%20@[::ffff:1.2.3.4]?%zzé=", []), "mailto:///@ser:%20@[::ffff:1.2.3.4]?%zzé="
  assert_eq jp("ftp: //", []), "ftp: //"
  assert_eq jp("///x%41 &~%25::", ["a///", "c d//.."]), "/xA%20&~%25::/a"
  assert_eq jp("http:///x%41: ~!\#!!é", ["b/"]), "http:///xA:%20~%21/b/\#!!%C3%A9"
  assert_eq jp("= ", ["a.%2F", "/b/"]), "=%20/a.%2F/b/"
  assert_eq jp("http:/@ser^p%40w@[fe80::1%25en0]:80:\#$&'()*+,;=", []), "http:/@ser%5Ep@w@%5Bfe80::1%25en0%5D:80:\#$&'()*+,;="
  assert_eq jp("https:p%40w@[1.2.3.4]%20%zz", ["%..c d"]), "ERR invalid URL escape \"%..\""
  assert_eq jp("x:%20@[fe80::1%25en0](')?&?é", []), "x:%20@[fe80::1%25en0](')?&?é"
  assert_eq jp("postgres:?é&\#é", []), "postgres:///?é&\#%C3%A9"
  assert_eq jp("http:?+", []), "http:///?+"
  assert_eq jp("mailto::@[fe80::1%en0]:80:a!%zzb%2Fc?", []), "mailto::@[fe80::1%en0]:80:a!%zzb%2Fc?"
  assert_eq jp("mailto:?%20", ["....%2F", "//c d%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("http:", []), "http:///"
  assert_eq jp("https:[?b+=é", []), "https:[?b+=é"
  assert_eq jp("a+b.c-d:&", []), "a+b.c-d:&"
  assert_eq jp("mailto:local_host:%38%30@=.)", ["..//"]), "mailto:local_host:%38%30@=.)"
  assert_eq jp("https:///1.2.3.4 &?&=+a=1\#é", ["%2Fb/", "ac db/"]), "https:///1.2.3.4%20&//b/ac%20db/?&=+a=1\#%C3%A9"
  assert_eq jp("http:!.%zz@*", []), "http:!.%zz@*"
  assert_eq jp("a+b.c-d:/host1:1,host2:2:", ["%c d//", ".a"]), "ERR invalid URL escape \"%c \""
  assert_eq jp("file:/[1.2.3.4]?b", []), "file:/[1.2.3.4]?b"
  assert_eq jp("http:///p%40wp%40wp%40w@[1.2.3.4]%20@.a~ ", ["a%2F%2F", "b/%a"]), "ERR invalid URL escape \"%a\""
  assert_eq jp("postgres:/:@@local_host[a(é?\#", []), "postgres:/:@@local_host%5Ba%28%C3%A9?"
  assert_eq jp("http:", ["b/b/"]), "http://b/b/"
  assert_eq jp("http:///1.2.3.4:xa", ["//.", "%2Fc d//"]), "http:///1.2.3.4:xa//c%20d/"
  assert_eq jp("ftp:/:..';p", []), "ftp:/:..';p"
  assert_eq jp("a+b.c-d:/%20p%40wu^@a b:xa**;p..@?+a=1", ["%2F"]), "a+b.c-d:/%20p@wu%5E@a%20b:xa%2A%2A;p..@/%2F?+a=1"
  assert_eq jp("mailto:&//é?%20\#/é$&'()*+,;=", ["%c d", "//"]), "ERR invalid URL escape \"%c \""
  assert_eq jp("mailto:/[1.2.3.4](..b%2Fc", ["//b/", "."]), "mailto:/[1.2.3.4](..b%2Fc/b"
  assert_eq jp("x:///%20p%40w@[fe80::1%25en0]", ["c d."]), "x:///%20p@w@%5Bfe80::1%25en0%5D/c%20d."
  assert_eq jp("host1:1,host2:2'%20*]+?=;\#", ["%2Fb/"]), "host1:1,host2:2'%20*]+?=;"
  assert_eq jp("/local_host:8080)@(&@%20", ["//c d", "%%", "/%"]), "ERR invalid URL escape \"%%/\""
  assert_eq jp("a+b.c-d:/a b;p ~= .?", []), "a+b.c-d:/a%20b;p%20~=%20.?"
  assert_eq jp("ftp:p%40wp%40wu^@x%41:~", ["a", "/%//"]), "ERR invalid URL escape \"%/\""
  assert_eq jp("file:a=*..%20:?", ["%2F.."]), "file:a=*..%20:?"
  assert_eq jp("HTTP://p%40wserp%40wp%40w@//", ["c d//."]), "http://p%40wserp%40wp%40w@/c%20d"
  assert_eq jp("HTTP:///a ba?&?", []), "http:///a%20ba?&?"
  assert_eq jp("http:", ["b/"]), "http://b/"
  assert_eq jp("(..", ["///%", "//b/"]), "ERR invalid URL escape \"%/b\""
  assert_eq jp("///up%40w^@[::1]@[é?", ["a..c d"]), "/up@w%5E@%5B::1%5D@%5B%C3%A9/a..c%20d?"
  assert_eq jp("mailto:///p%40w@[1.2.3.4]:80=:'((?//", ["%2F", ".."]), "mailto:///p%40w@[1.2.3.4]:80=:'((?//"
  assert_eq jp("ftp: ", []), "ftp: "
  assert_eq jp("http://'/", []), "http://'/"
  assert_eq jp("example.com/:=b%2Fc[(\#", ["b//", "//c da"]), "example.com/:=b/c%5B%28/b/c%20da"
  assert_eq jp("a+b.c-d:()a..", ["%2Fc d", "a", "a"]), "a+b.c-d:()a.."
  assert_eq jp("file:@^ser@[fe80::1%en0]:8080éé]%zz+?b=", ["%%", "."]), "ERR invalid URL escape \"%%\""
  assert_eq jp("file:/x%41;p!?", ["a..%", "b/"]), "ERR invalid URL escape \"%/b\""
  assert_eq jp("x:/host1:1,host2:2~ +", ["b/%", "%2Fa."]), "ERR invalid URL escape \"%/%\""
  assert_eq jp("https:/p%40w:@%20@[fe80::1%25en0]:x) %25", ["..c d//", "c d", "%%2F"]), "ERR invalid URL escape \"%%2\""
  assert_eq jp("postgres:[fe80::1%en0]..(;p@+?é%20=%20", ["..c d"]), "postgres:[fe80::1%en0]..(;p@+?é%20=%20"
  assert_eq jp("x:1.2.3.4%20?/", []), "x:1.2.3.4%20?/"
  assert_eq jp("file:", []), "file:///"
  assert_eq jp("file:example.com/?%zz", []), "file:example.com/?%zz"
  assert_eq jp("https:[%zz.", ["./", ".."]), "https:[%zz."
  assert_eq jp("https:///[fe80::1%25en0]:%38%30??%20&\#ff!", [".b/%2F", "."]), "https:///[fe80::1%25en0]:%38%30/.b/%2F??%20&\#ff!"
  assert_eq jp("postgres:+%20é?%20é=\#!", []), "postgres:+%20é?%20é=\#!"
  assert_eq jp("HTTP:[::1[a&%*?é+%zz", ["//b/."]), "http:[::1[a&%*?é+%zz"
  assert_eq jp("mailto:(&%zz%zz/?%20", []), "mailto:(&%zz%zz/?%20"
  assert_eq jp(")+)~]?;a=1a=1\#$&'()*+,;=f", ["a/"]), ")+)~]/a/?;a=1a=1\#$&'()*+,;=f"
  assert_eq jp("file:///h%C3%A9@//?", []), "file:///h%C3%A9@/?"
  assert_eq jp("postgres:/:@@local_host[a(é?\#", ["a%", "a..c d"]), "ERR invalid URL escape \"%/a\""
  assert_eq jp("postgres:a bé%zz//..", []), "postgres:a bé%zz//.."
  assert_eq jp("https:", ["///", "."]), "https:"
  assert_eq jp("postgres:/host1:1,host2:2b%2Fc%20b%2Fcé ?ba=1", ["/", ".b/c d", ".%2Fc d"]), "postgres:/host1:1,host2:2b/c%20b/c%C3%A9%20/.b/c%20d/./c%20d?ba=1"
  assert_eq jp("mailto:example.com", ["..//a"]), "mailto:example.com"
  assert_eq jp("ftp:///^uu!@local_host:8080'..", [".....", "a/a"]), "ftp:///%5Euu%21@local_host:8080%27../...../a/a"
  assert_eq jp("HTTP:&?&&", [".", "%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("postgres:///[::1]:%38%30//!/a?%20%zz;/", ["%2F..%2F"]), "postgres:///[::1]:%38%30/!/a/%2F..%2F?%20%zz;/"
  assert_eq jp("/=!+\#/ ", ["c d/", "/"]), "/=%21+/c%20d/\#/%20"
  assert_eq jp("\#f", ["c d", "%//c d"]), "ERR invalid URL escape \"%/c\""
  assert_eq jp("a+b.c-d: +%25", ["c dc d"]), "a+b.c-d: +%25"
  assert_eq jp("file:.?%zzéb&\#éf", ["%a%", "..."]), "ERR invalid URL escape \"%a%\""
  assert_eq jp("mailto:+\#ff!/", ["a%2F", "c d"]), "mailto:+\#ff!/"
  assert_eq jp("HTTP:[::1[a&%*?é+%zz", ["c d", "%%%2F"]), "ERR invalid URL escape \"%%%\""
  assert_eq jp("/%20:@EXAMPLE.org).?b&", ["//b/", "c d//.."]), "/%20:@EXAMPLE.org)./b?b&"
  assert_eq jp("mailto:///host1:1,host2:2([/)?", [".", "..%c d", "/.%2F"]), "ERR invalid URL escape \"%c \""
  assert_eq jp("https:uu@[::1]+''%20!?/", ["%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("a b%25?=/&&", ["..//", "//b/a"]), "b/a?=/&&"
  assert_eq jp("mailto:&%zz%zz..+", ["/b/a", "..%%2F"]), "ERR invalid URL escape \"%%2\""
  assert_eq jp("ftp://%20%20@EXAMPLE.org]!%25]\#\#f/", ["."]), "ftp://%20%20@EXAMPLE.org]!%25]\#%23f/"
  assert_eq jp("ftp:/+(*%20 ", [".%%"]), "ERR invalid URL escape \"%%\""
  assert_eq jp("postgres: ][!", ["//.b/", "..c d"]), "postgres: ][!"
  assert_eq jp("///EXAMPLE.org&!a*", ["b/a.", "c d"]), "/EXAMPLE.org&%21a%2A/b/a./c%20d"
  assert_eq jp("///EXAMPLE.org&!a*", ["..%%2F"]), "ERR invalid URL escape \"%%2\""
  assert_eq jp("x:/[::ffff:1.2.3.4]?b", []), "x:/[::ffff:1.2.3.4]?b"
  assert_eq jp("file:///x%41:%38%30?é", []), "file:///x%41:%38%30?é"
  assert_eq jp("//*%25", ["b/b/.", "..b/"]), "//*%25/b/b/..b/"
  assert_eq jp("HTTP:*", ["//..%2F", "%.."]), "ERR invalid URL escape \"%..\""
}
