  assert_eq esc("%zz.`_"), ("%25zz.%60_", "%25zz.%60_", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("."), (".", ".", ".", ".")
  assert_eq esc(")!/)[-;|,"), ("%29%21%2F%29%5B-%3B%7C%2C", "%29%21%2F%29%5B-%3B%7C%2C", ")!/)[-;|,", ")!/)[-;|,")
  assert_eq esc("(}(~/``"), ("%28%7D%28~%2F%60%60", "%28%7D%28~%2F%60%60", "(}(~/``", "(}(~/``")
  assert_eq esc("Z%zz%41"), ("Z%25zz%2541", "Z%25zz%2541", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("\x01Z;,//%"), ("%01Z%3B%2C%2F%2F%25", "%01Z%3B%2C%2F%2F%25", "ERR invalid URL escape \"%\"", "ERR invalid URL escape \"%\"")
  assert_eq esc(",{%"), ("%2C%7B%25", "%2C%7B%25", "ERR invalid URL escape \"%\"", "ERR invalid URL escape \"%\"")
  assert_eq esc("[(@&\x01"), ("%5B%28%40%26%01", "%5B%28@&%01", "[(@&\x01", "[(@&\x01")
  assert_eq esc("~"), ("~", "~", "~", "~")
  assert_eq esc("_{%?."), ("_%7B%25%3F.", "_%7B%25%3F.", "ERR invalid URL escape \"%?.\"", "ERR invalid URL escape \"%?.\"")
  assert_eq esc(hx("013a2b2e2d5cff2b20")), ("%01%3A%2B.-%5C%FF%2B+", "%01:+.-%5C%FF+%20", hx("013a202e2d5cff2020"), hx("013a2b2e2d5cff2b20"))
