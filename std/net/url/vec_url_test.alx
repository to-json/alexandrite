  assert_eq usum_rq("/HTTP:ser!u%20@[::ffff:1.2.3.4]b%2Fc*:?;%20%zz"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/HTTP:ser!u @[::ffff:1.2.3.4]b/c*:\", rawpath=\"/HTTP:ser!u%20@[::ffff:1.2.3.4]b%2Fc*:\", rawq=\";%20%zz\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /HTTP:ser!u%20@[::ffff:1.2.3.4]b%2Fc*:?;%20%zz | /HTTP:ser!u%20@[::ffff:1.2.3.4]b%2Fc*: |  | /HTTP:ser!u%20@[::ffff:1.2.3.4]b%2Fc*:?;%20%zz |  |  | /HTTP:ser!u%20@[::ffff:1.2.3.4]b%2Fc*:?;%20%zz | false"
