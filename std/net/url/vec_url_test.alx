  assert_eq esc("$/][€;%zza"), ("%24%2F%5D%5B%E2%82%AC%3B%25zza", "$%2F%5D%5B%E2%82%AC%3B%25zza", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("::.€`>"), ("%3A%3A.%E2%82%AC%60%3E", "::.%E2%82%AC%60%3E", "::.€`>", "::.€`>")
