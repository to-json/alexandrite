  assert_eq usum_p("/[::1]:8080][ ?a=1"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/[::1]:8080][ \", rawpath=\"/[::1]:8080][ \", rawq=\"a=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /%5B::1%5D:8080%5D%5B%20?a=1 | /%5B::1%5D:8080%5D%5B%20 |  | /%5B::1%5D:8080%5D%5B%20?a=1 |  |  | /%5B::1%5D:8080%5D%5B%20?a=1 | false"
