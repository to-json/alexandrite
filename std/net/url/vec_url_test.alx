}

test "vectors: join path" {
  assert_eq jp(")+)~]?;a=1a=1\#$&'()*+,;=f", ["b/..b/", "aac d"]), "%29+%29~%5D/b/..b/aac%20d?;a=1a=1\#$&'()*+,;=f"
  assert_eq jp("https:p%40wu@@[fe80::1%25en0];p~%25\#%2F", ["%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("x:///%20p%40w@[fe80::1%25en0]", ["b/c d%", "."]), "ERR invalid URL escape \"%\""
  assert_eq jp("a+b.c-d:[fe80::1%en0]:80// %zz", [".", "c d"]), "a+b.c-d:[fe80::1%en0]:80// %zz"
  assert_eq jp("mailto:[1.2.3.4]%20=:'!=?b=b\#%2F%20%20\#", ["a", "b//"]), "mailto:[1.2.3.4]%20=:'!=?b=b\#/%20%20%23"
  assert_eq jp("postgres:///1.2.3.4 b%2Fc?a=1", []), "postgres:///1.2.3.4%20b/c?a=1"
  assert_eq jp("x:///EXAMPLE.org!)/é'?", []), "x:///EXAMPLE.org%21%29/%C3%A9%27?"
  assert_eq jp("a+b.c-d:/h%C3%A9:%38%30b%2Fc&%25?", ["%2F..", "b/b/"]), "a+b.c-d:/h%C3%A9:%38%30b%2Fc&%25/%2F../b/b/?"
  assert_eq jp("///x%41[", ["b/", "%%a", ".."]), "/x%41[/b"
  assert_eq jp("a+b.c-d:&//*@;p", ["..", "b/%b/"]), "ERR invalid URL escape \"%b/\""
  assert_eq jp("https://x%41@a~:", ["/", "//"]), "https://xA@a~:/"
  assert_eq jp("ftp:%20", ["b/", ".."]), "ftp:%20"
  assert_eq jp("///EXAMPLE.org&!a*", []), "/EXAMPLE.org&!a*"
  assert_eq jp("http:///:80:a~.?&é\#é/", ["%a.", "%a"]), "ERR invalid URL escape \"%a.\""
  assert_eq jp("?%zza=1é\#é%2Ff$&'()*+,;=", []), "/?%zza=1é\#%C3%A9/f$&%27()*+,;="
  assert_eq jp("mailto:+a)", ["//.a", "."]), "mailto:+a)"
  assert_eq jp("mailto:a b:[%20&()?=é", ["c db/%2F"]), "mailto:a b:[%20&()?=é"
  assert_eq jp("mailto:/1.2.3.4+..", ["%%"]), "ERR invalid URL escape \"%%\""
  assert_eq jp("HTTP:a=&", []), "http:a=&"
  assert_eq jp("https: []&%zz??+/", []), "https: []&%zz??+/"
  assert_eq jp("postgres:a//b%2Fc?", []), "postgres:a//b%2Fc?"
  assert_eq jp("https:///[fe80::1%25en0]:%38%30??%20&\#ff!", ["a/", "%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("https:", ["%.."]), "ERR invalid URL escape \"%..\""
  assert_eq jp("file:///!u@local_host]%25", []), "file:///!u@local_host]%25"
  assert_eq jp("http:!.%zz@*", ["b///b/"]), "http:!.%zz@*"
  assert_eq jp("a+b.c-d:!", ["ac d//"]), "a+b.c-d:!"
  assert_eq jp("postgres:%20++//", ["%", "."]), "ERR invalid URL escape \"%\""
  assert_eq jp("file:/x%41~a*@&?", ["b/", "/."]), "file:/x%41~a*@&/b?"
  assert_eq jp("mailto:///example.com.?", []), "mailto:///example.com.?"
  assert_eq jp("postgres:///p%40w:@1.2.3.4&@~()?a=1", ["%2Fa/", "..", "c d."]), "postgres:///p@w:@1.2.3.4&@~%28%29/c%20d.?a=1"
  assert_eq jp("http:[fe80::1%25en0];p):&\#f /", [".", "b/a.."]), "http:[fe80::1%25en0];p):&\#f%20/"
  assert_eq jp("file:host1:1,host2:2%zz%25é]=", ["b/"]), "file:host1:1,host2:2%zz%25é]="
  assert_eq jp("mailto:/u^%20:@[fe80::1%25en0]&", ["b/..."]), "mailto:/u%5E%20:@%5Bfe80::1%25en0%5D&/b/..."
  assert_eq jp("ftp:///x%41/+!!.?/a=1+?", ["....a", "b/"]), "ftp:///x%41/+!!./....a/b/?/a=1+?"
  assert_eq jp("///x%41 &~%25::", []), "/xA%20&~%25::"
  assert_eq jp("http://[::1]\#", ["/"]), "http://[::1]/"
  assert_eq jp("ftp:/ ?/b+a=1", [".%2F"]), "ftp:/%20/.%2F?/b+a=1"
  assert_eq jp("mailto:'[!?%zzé", ["c da"]), "mailto:'[!?%zzé"
  assert_eq jp("a+b.c-d://.@+\#%20%20", ["//a"]), "a+b.c-d://.@+/a\#%20%20"
  assert_eq jp("%20^ser@x%41%20+*=//", ["a", "%%2F..", "b/"]), "ERR invalid URL escape \"%%2\""
  assert_eq jp("ftp:[fe80::1%25en0]/&/'??%zz", []), "ftp:[fe80::1%25en0]/&/'??%zz"
  assert_eq jp("file:a b:a?+a=1;", []), "file:a b:a?+a=1;"
  assert_eq jp("//%20@1.2.3.4=)]!!'?", ["."]), "//%20@1.2.3.4=)]!!'?"
  assert_eq jp("ftp:///!%20", ["/////"]), "ftp:///!%20/"
  assert_eq jp("postgres:[::1]:xa/%20", []), "postgres:[::1]:xa/%20"
  assert_eq jp("file:///:@:@:80;p!..&.?/bb", ["///"]), "file:///:@:@:80;p!..&./?/bb"
  assert_eq jp("HTTP:///local_host:80", ["b/%2F..", ".b/", "b/"]), "http:///local_host:80/b/%2F../.b/b/"
  assert_eq jp("HTTP://:ser@example.com~;p", ["////"]), "http://:ser@example.com~;p/"
  assert_eq jp("a+b.c-d://p%40w!p%40w@:8080\#\#f$&'()*+,;=", ["/", "b/a"]), "a+b.c-d://p%40w%21p%40w@:8080/b/a\#%23f$&%27()*+,;="
  assert_eq jp("http:[fe80::1%25en0]:x[..", ["a", "%", "/"]), "ERR invalid URL escape \"%/\""
  assert_eq jp("HTTP:=a'?%zz", ["/%", "//"]), "ERR invalid URL escape \"%/\""
  assert_eq jp("///1.2.3.4é~;pb%2Fc?a=1\#é", ["///"]), "/1.2.3.4%C3%A9~;pb/c/?a=1\#%C3%A9"
  assert_eq jp("HTTP://EXAMPLE.org\#", ["/", "c d/a"]), "http://EXAMPLE.org/c%20d/a"
  assert_eq jp("ftp:/[fe80::1%25en0](=a\#", ["///"]), "ftp:/[fe80::1%25en0](=a/"
  assert_eq jp("///local_host:%38%30[/[!a+", ["/"]), "/local_host:%38%30[/[!a+/"
  assert_eq jp("é!//?b%20&a=1", ["%2F%b/", "/c d"]), "ERR invalid URL escape \"%b/\""
  assert_eq jp("//host1:1,host2:2:80:", ["%2F//c d", "c db/.."]), "//host1:1,host2:2:80://c%20d"
  assert_eq jp("a+b.c-d://[fe80::1%25en0]", ["..", "...."]), "a+b.c-d://[fe80::1%25en0]/...."
  assert_eq jp("ftp:p%40wp%40wu^@x%41:~", ["%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("ftp:///!%20", []), "ftp:///!%20"
  assert_eq jp("HTTP:///host1:1,host2:2@..\#", ["%2F"]), "http:///host1:1,host2:2@../%2F"
  assert_eq jp("//local_host\#!f$&'()*+,;=", []), "//local_host/\#!f$&'()*+,;="
  assert_eq jp("ftp:example.com:80:;p?b%20%20\#%20é!\#", ["ac d//", "/"]), "ftp:example.com:80:;p?b%20%20\#%20%C3%A9!%23"
  assert_eq jp("postgres:+%20é?%20é=\#!", []), "postgres:+%20é?%20é=\#!"
  assert_eq jp("a+b.c-d://h%C3%A9a~a.?a=1é", ["//...", "%c d"]), "ERR invalid URL escape \"%c \""
  assert_eq jp("x:/host1:1,host2:2:%38%30;p:///(", [".a/", "..%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("a+b.c-d:/^p%40w^@[fe80::1%25en0]a", ["%%", "/%"]), "ERR invalid URL escape \"%%/\""
  assert_eq jp("postgres:[fe80::1%en0]..(;p@+?é%20=%20", ["/a."]), "postgres:[fe80::1%en0]..(;p@+?é%20=%20"
  assert_eq jp("file:=", ["c d%2F.."]), "file:="
  assert_eq jp("postgres:..", []), "postgres:.."
  assert_eq jp("x:.//", ["/..", ".", "c d/."]), "x:.//"
  assert_eq jp("mailto:///@:@[::1]:x!]%25:!(?b%zzé", ["%2Fa%", ".c d", "c d."]), "ERR invalid URL escape \"%/.\""
  assert_eq jp("x::?", ["."]), "x::?"
  assert_eq jp("mailto:[::1!??b%zz?", []), "mailto:[::1!??b%zz?"
  assert_eq jp("http:/@ser^p%40w@[fe80::1%25en0]:80:\#$&'()*+,;=", ["%//%2F", "c d%", "%//"]), "ERR invalid URL escape \"%/%\""
  assert_eq jp("http:///1.2.3.4:xa", ["%", "%"]), "ERR invalid URL escape \"%/%\""
  assert_eq jp("postgres:///EXAMPLE.org)b%2Fc.@%25;p", [".%."]), "ERR invalid URL escape \"%.\""
  assert_eq jp("a+b.c-d:/a b;p ~= .?", ["..c d//"]), "a+b.c-d:/a%20b;p%20~=%20./..c%20d/?"
  assert_eq jp("é)?b", ["b/c d/"]), "%C3%A9%29/b/c%20d/?b"
  assert_eq jp("postgres:/host1:1,host2:2b%2Fc%20b%2Fcé ?ba=1", ["//b/%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("x:///h%C3%A9?/é=", ["b/a%", "c d"]), "ERR invalid URL escape \"%/c\""
  assert_eq jp("a+b.c-d:///:p%40w!@:80*~", []), "a+b.c-d:///:p%40w!@:80*~"
  assert_eq jp("HTTP:x%41a..[&?", ["b/", ".c dc d"]), "http:x%41a..[&?"
  assert_eq jp("x:/[::ffff:1.2.3.4]?b", ["b/."]), "x:/[::ffff:1.2.3.4]/b?b"
  assert_eq jp("https:", []), "https:///"
  assert_eq jp("mailto:/[1.2.3.4]\#", []), "mailto:/[1.2.3.4]"
  assert_eq jp("HTTP:.%//!", [".///", "//b/"]), "http:.%//!"
  assert_eq jp("a+b.c-d:a b.é?/", ["%", "ac d%", "/"]), "ERR invalid URL escape \"%/a\""
  assert_eq jp("HTTP:+'![=//", ["b/"]), "http:+'![=//"
  assert_eq jp("';p/?/=?", ["c d", "%//%2F"]), "ERR invalid URL escape \"%/%\""
  assert_eq jp("HTTP:..&*!=", ["%2F", "..a%2F"]), "http:..&*!="
  assert_eq jp("https:..%zzb%2Fc(\#é!", ["//"]), "https:..%zzb%2Fc(\#%C3%A9!"
  assert_eq jp("(a!+.?&?&", ["."]), "(a!+.?&?&"
  assert_eq jp("HTTP:/h%C3%A9:80:%25&%20aa;p", ["/."]), "http:/h%C3%A9:80:%25&%20aa;p"
  assert_eq jp("http:///1.2.3.4:xa", []), "http:///1.2.3.4:xa"
  assert_eq jp("/:@[1.2.3.4])[..!]\#$&'()*+,;=ff", ["c d..c d", "a"]), "/:@%5B1.2.3.4%5D%29%5B..%21%5D/c%20d..c%20d/a\#$&'()*+,;=ff"
  assert_eq jp("http:///[1.2.3.4] ?=\#$&'()*+,;=%20é ", ["%2F"]), "http:///%5B1.2.3.4%5D%20/%2F?=\#$&%27()*+,;=%20%C3%A9%20"
  assert_eq jp("a+b.c-d:[::1]&] !/%20?a=1", ["a", "/c d", "/..%2F"]), "a+b.c-d:[::1]&] !/%20?a=1"
  assert_eq jp("?\#f!", ["//%2F"]), "%2F?\#f!"
  assert_eq jp("postgres:.[:;p?=;%20", ["//.%"]), "ERR invalid URL escape \"%\""
}

test "vectors: join path 1" {
  assert_eq jp("postgres:/example.com:xb%2Fc@*/", ["."]), "postgres:/example.com:xb%2Fc@*"
  assert_eq jp("x:?%20=?", []), "x:///?%20=?"
  assert_eq jp("mailto:+!'!;p;p", ["%2Fc d"]), "mailto:+!'!;p;p"
  assert_eq jp("ftp:///[fe80::1%25en0];p?+/a=1", ["%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("file:.?%zzéb&\#éf", []), "file:.?%zzéb&\#%C3%A9f"
  assert_eq jp("ftp:?/é;%20", ["///", "//"]), "ftp:///?/é;%20"
  assert_eq jp("HTTP:[", []), "http:["
  assert_eq jp("ftp:/^p%40w!p%40w@%20é?+;", ["/", "."]), "ftp:/%5Ep@w%21p@w@%20%C3%A9?+;"
  assert_eq jp("ftp:é%25!%?=a=1é?", []), "ftp:é%25!%?=a=1é?"
  assert_eq jp("http:&:?é&=", ["//c d"]), "http:&:?é&="
  assert_eq jp("ftp:///!%20", ["%2F..", "."]), "ftp:///!%20/%2F.."
  assert_eq jp("postgres://h%C3%A9?%20=\#", []), "postgres://h%C3%A9/?%20="
  assert_eq jp("mailto:&//é?%20\#/é$&'()*+,;=", []), "mailto:&//é?%20\#/%C3%A9$&%27()*+,;="
  assert_eq jp("x:1.2.3.4%20?/", ["b/", "////%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("%20^ser@x%41%20+*=//", ["ac d/", "//.%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("/:@[1.2.3.4])[..!]\#$&'()*+,;=ff", ["%/"]), "ERR invalid URL escape \"%/\""
  assert_eq jp("file:/[1.2.3.4]?b", ["%2F", "c d."]), "file:/%5B1.2.3.4%5D///c%20d.?b"
  assert_eq jp("postgres:%20++//", ["%b/a", "c d", "%2F.."]), "ERR invalid URL escape \"%b/\""
  assert_eq jp("postgres:?%20é+", []), "postgres:///?%20é+"
  assert_eq jp("//host1:1,host2:2:80:", ["..", "c d"]), "//host1:1,host2:2:80:/c%20d"
  assert_eq jp("a+b.c-d:&//*@;p", []), "a+b.c-d:&//*@;p"
  assert_eq jp("a+b.c-d:/host1:1,host2:2:", ["c d%2F", "b/", "b/%"]), "ERR invalid URL escape \"%\""
  assert_eq jp("https:[::1'/?%20%20?", ["b/", "//.b/"]), "https:[::1'/?%20%20?"
  assert_eq jp("http:?", []), "http:///?"
  assert_eq jp("http:%%20?%20a=1", []), "http:%%20?%20a=1"
  assert_eq jp("HTTP:///[fe80::1%25en0]", ["c dc db/", "%."]), "ERR invalid URL escape \"%.\""
  assert_eq jp("https://x%41@a~:", ["%//", "a%.."]), "ERR invalid URL escape \"%/a\""
  assert_eq jp("///x%41:8080.//?", ["b//b/", "/ab/"]), "/x%41:8080./b/b/ab/?"
