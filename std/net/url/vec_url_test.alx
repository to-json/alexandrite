  assert_eq usum_p("@\#éf/é"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"@\", rawpath=\"\", rawq=\"\", frag=\"éf/é\", rawfrag=\"éf/é\", forcequery=false, omithost=false | @\#%C3%A9f/%C3%A9 | @ | %C3%A9f/%C3%A9 | @ |  |  | @\#%C3%A9f/%C3%A9 | false"
  assert_eq usum_p("file://x%41"), "ERR parse \"file://x%41\": invalid URL escape \"%41\""
  assert_eq usum_p("1x://!!!@h%C3%A9:??+?"), "ERR parse \"1x://!!!@h%C3%A9:??+?\": first path segment in URL cannot contain colon"
  assert_eq usum_p("https://example.com:8080*[%20%20)"), "ERR parse \"https://example.com:8080*[%20%20)\": invalid IP-literal"
  assert_eq usum_p("HTTP:?bbba=1"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"bbba=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:?bbba=1 |  |  | /?bbba=1 |  |  | http:?bbba=1 | true"
  assert_eq usum_p("https:userser:@[fe80::1%en0]!//a?b\#!%2F"), "opaque=\"userser:@[fe80::1%en0]!//a\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"b\", frag=\"!/\", rawfrag=\"!%2F\", forcequery=false, omithost=false | https:userser:@[fe80::1%en0]!//a?b\#!%2F |  | !%2F | userser:@[fe80::1%en0]!//a?b |  |  | https:userser:@[fe80::1%en0]!//a?b\#!%2F | true"
