  assert_eq usum_rq("/https:/[fe80::1%en0]?a=1"), "ERR parse \"/https:/[fe80::1%en0]?a=1\": invalid URL escape \"%en\""
  assert_eq usum_rq("/x://%20%20:@[::1\#!f"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/x://  :@[::1\#!f\", rawpath=\"/x://%20%20:@[::1\#!f\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /x://%20%20:@%5B::1%23%21f | /x://%20%20:@%5B::1%23%21f |  | /x://%20%20:@%5B::1%23%21f |  |  | /x://%20%20:@%5B::1%23%21f | false"
  assert_eq usum_rq("postgres://[::ffff:1.2.3.4]%25///&~?;"), "ERR parse \"postgres://[::ffff:1.2.3.4]%25///&~?;\": invalid port \"%25\" after host"
  assert_eq usum_rq("//[fe80::1%en0]:[~\# \#! "), "ERR parse \"//[fe80::1%en0]:[~\# \#! \": invalid URL escape \"%en\""
  assert_eq usum_rq("ftp://[fe80::1%en0]:80&%25??é\#$&'()*+,;=%2F "), "ERR parse \"ftp://[fe80::1%en0]:80&%25??é\#$&'()*+,;=%2F \": invalid port \":80&%25\" after host"
  assert_eq usum_rq("///:@EXAMPLE.org%zz?;bb"), "ERR parse \"///:@EXAMPLE.org%zz?;bb\": invalid URL escape \"%zz\""
  assert_eq usum_rq("mailto://:?%zz&\#/\#%"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\":\", path=\"\", rawpath=\"\", rawq=\"%zz&\#/\#%\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto://:?%zz&\#/\#% |  |  | /?%zz&\#/\#% |  |  | mailto://:?%zz&\#/\#% | true"
  assert_eq usum_rq("file://h%C3%A9["), "ERR parse \"file://h%C3%A9[\": invalid IP-literal"
  assert_eq usum_rq("b%2Fcé?%20\#$&'()*+,;=!"), "ERR parse \"b%2Fcé?%20\#$&'()*+,;=!\": invalid URI for request"
  assert_eq usum_rq("/1x:///[1.2.3.4];p?;b%zz"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/1x:///[1.2.3.4];p\", rawpath=\"/1x:///[1.2.3.4];p\", rawq=\";b%zz\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /1x:///[1.2.3.4];p?;b%zz | /1x:///[1.2.3.4];p |  | /1x:///[1.2.3.4];p?;b%zz |  |  | /1x:///[1.2.3.4];p?;b%zz | false"
  assert_eq usum_rq("s_c:/?é?/"), "ERR parse \"s_c:/?é?/\": invalid URI for request"
  assert_eq usum_rq("mailto://ser@host1:1,host2:2.(a&;p?%zzé/%zz"), "ERR parse \"mailto://ser@host1:1,host2:2.(a&;p?%zzé/%zz\": invalid port \":2.(a&;p\" after host"
  assert_eq usum_rq("/1x:%%zza]+"), "ERR parse \"/1x:%%zza]+\": invalid URL escape \"%%z\""
  assert_eq usum_rq("é"), "ERR parse \"é\": invalid URI for request"
  assert_eq usum_rq(":%20(a%25!"), "ERR parse \":%20(a%25!\": missing protocol scheme"
  assert_eq usum_rq("https:@p%40w@[1.2.3.4];p!%20/'b%2Fc"), "opaque=\"@p%40w@[1.2.3.4];p!%20/'b%2Fc\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:@p%40w@[1.2.3.4];p!%20/'b%2Fc |  |  | @p%40w@[1.2.3.4];p!%20/'b%2Fc |  |  | https:@p%40w@[1.2.3.4];p!%20/'b%2Fc | true"
  assert_eq usum_rq("/ftp://u!p%40w:@[1.2.3.4]&[[%25\#"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/ftp://u!p@w:@[1.2.3.4]&[[%\#\", rawpath=\"/ftp://u!p%40w:@[1.2.3.4]&[[%25\#\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /ftp://u%21p@w:@%5B1.2.3.4%5D&%5B%5B%25%23 | /ftp://u%21p@w:@%5B1.2.3.4%5D&%5B%5B%25%23 |  | /ftp://u%21p@w:@%5B1.2.3.4%5D&%5B%5B%25%23 |  |  | /ftp://u%21p@w:@%5B1.2.3.4%5D&%5B%5B%25%23 | false"
  assert_eq usum_rq("//1.2.3.4?%zz"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"//1.2.3.4\", rawpath=\"\", rawq=\"%zz\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | //1.2.3.4?%zz | //1.2.3.4 |  | //1.2.3.4?%zz |  |  | //1.2.3.4?%zz | false"
  assert_eq usum_rq("s_c:/ser@x%41](&:%25*?+a=1a=1b"), "ERR parse \"s_c:/ser@x%41](&:%25*?+a=1a=1b\": invalid URI for request"
  assert_eq usum_rq("HTTP:!..)\#/"), "opaque=\"!..)\#/\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:!..)\#/ |  |  | !..)\#/ |  |  | http:!..)\#/ | true"
  assert_eq usum_rq("a+b.c-d:[fe80::1%en0]\#"), "opaque=\"[fe80::1%en0]\#\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:[fe80::1%en0]\# |  |  | [fe80::1%en0]\# |  |  | a+b.c-d:[fe80::1%en0]\# | true"
  assert_eq usum_rq("/[fe80::1%25en0]?b%20;/"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/[fe80::1%en0]\", rawpath=\"/[fe80::1%25en0]\", rawq=\"b%20;/\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /[fe80::1%25en0]?b%20;/ | /[fe80::1%25en0] |  | /[fe80::1%25en0]?b%20;/ |  |  | /[fe80::1%25en0]?b%20;/ | false"
  assert_eq usum_rq("/s_c://p%40wserp%40w!@1.2.3.4:80:@!' &?;b"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/s_c://p@wserp@w!@1.2.3.4:80:@!' &\", rawpath=\"/s_c://p%40wserp%40w!@1.2.3.4:80:@!' &\", rawq=\";b\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /s_c://p@wserp@w%21@1.2.3.4:80:@%21%27%20&?;b | /s_c://p@wserp@w%21@1.2.3.4:80:@%21%27%20& |  | /s_c://p@wserp@w%21@1.2.3.4:80:@%21%27%20&?;b |  |  | /s_c://p@wserp@w%21@1.2.3.4:80:@%21%27%20&?;b | false"
  assert_eq usum_rq("/[::ffff:1.2.3.4]:x%25!\#%$&'()*+,;=%2F\#"), "ERR parse \"/[::ffff:1.2.3.4]:x%25!\#%$&'()*+,;=%2F\#\": invalid URL escape \"%$&\""
  assert_eq usum_rq("/[fe80::1%en0]:%38%30[//a&?&=b"), "ERR parse \"/[fe80::1%en0]:%38%30[//a&?&=b\": invalid URL escape \"%en\""
}

test "vectors: resolve reference" {
  assert_eq rr("///:%20^@1.2.3.4.('!//:?=\#", "?x=1/.."), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"///: ^@1.2.3.4.('!//:\", rawpath=\"\", rawq=\"x=1/..\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ///:%20%5E@1.2.3.4.%28%27%21//:?x=1/.."
  assert_eq rr("mailto:///p%40w@[1.2.3.4]:80=:'((?//", "%2F?b/"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"//\", rawpath=\"/%2F\", rawq=\"b/\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto:///%2F?b/"
  assert_eq rr("https:///[::ffff:1.2.3.4]!", "\#f?\#f./"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"/[::ffff:1.2.3.4]!\", rawpath=\"/[::ffff:1.2.3.4]!\", rawq=\"\", frag=\"f?\#f./\", rawfrag=\"f?\#f./\", forcequery=false, omithost=false | https:///[::ffff:1.2.3.4]!\#f?%23f./"
  assert_eq rr("http:[fe80::1%25en0]:x[..", ""), "opaque=\"[fe80::1%25en0]:x[..\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:[fe80::1%25en0]:x[.."
