  assert_eq usum_p("[1.2.3.4]:%38%30&é*b%2Fc:(\#//"), "ERR parse \"[1.2.3.4]:%38%30&é*b%2Fc:(\": first path segment in URL cannot contain colon"
  assert_eq usum_p("a+b.c-d:=.?&"), "opaque=\"=.\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"&\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:=.?& |  |  | =.?& |  |  | a+b.c-d:=.?& | true"
  assert_eq usum_p(".)+?;%zz\#!%//"), "ERR parse \".)+?;%zz\#!%//\": invalid URL escape \"%//\""
  assert_eq usum_p("postgres://[1.2.3.4]..'**%20//?&"), "ERR parse \"postgres://[1.2.3.4]..'**%20//?&\": invalid port \"..'**%20\" after host"
  assert_eq usum_p("ftp://EXAMPLE.org:80é;p"), "ERR parse \"ftp://EXAMPLE.org:80é;p\": invalid port \":80é;p\" after host"
  assert_eq usum_p("mailto://[fe80::1%25en0]:x%%/%20///\#é "), "ERR parse \"mailto://[fe80::1%25en0]:x%%/%20///\": invalid port \":x%%\" after host"
  assert_eq usum_p("file:"), "opaque=\"\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | file: |  |  | / |  |  | file: | true"
  assert_eq usum_p("postgres://local_host!%20&\#"), "ERR parse \"postgres://local_host!%20&\": invalid URL escape \"%20\""
  assert_eq usum_p("mailto:/^p%40w@x%41=\#//"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"/^p@w@xA=\", rawpath=\"/^p%40w@x%41=\", rawq=\"\", frag=\"//\", rawfrag=\"\", forcequery=false, omithost=true | mailto:/%5Ep@w@xA=\#// | /%5Ep@w@xA= | // | /%5Ep@w@xA= |  |  | mailto:/%5Ep@w@xA=\#// | true"
  assert_eq usum_p("s_c:p%40w@@EXAMPLE.org"), "ERR parse \"s_c:p%40w@@EXAMPLE.org\": first path segment in URL cannot contain colon"
  assert_eq usum_p("HTTP:~@@\#%20"), "opaque=\"~@@\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\" \", rawfrag=\"\", forcequery=false, omithost=false | http:~@@\#%20 |  | %20 | ~@@ |  |  | http:~@@\#%20 | true"
  assert_eq usum_p("s_c:/local_host:x%25 "), "ERR parse \"s_c:/local_host:x%25 \": first path segment in URL cannot contain colon"
  assert_eq usum_p("HTTP:&?&&"), "opaque=\"&\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"&&\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:&?&& |  |  | &?&& |  |  | http:&?&& | true"
  assert_eq usum_p("https:%zz+"), "opaque=\"%zz+\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:%zz+ |  |  | %zz+ |  |  | https:%zz+ | true"
  assert_eq usum_p("s_c:///@u!@%zz;p=."), "ERR parse \"s_c:///@u!@%zz;p=.\": first path segment in URL cannot contain colon"
  assert_eq usum_p("+[éé]?;"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"+[éé]\", rawpath=\"+[éé]\", rawq=\";\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | +%5B%C3%A9%C3%A9%5D?; | +%5B%C3%A9%C3%A9%5D |  | +%5B%C3%A9%C3%A9%5D?; |  |  | +%5B%C3%A9%C3%A9%5D?; | false"
  assert_eq usum_p("x://EXAMPLE.org:x&/%%25 *\#"), "ERR parse \"x://EXAMPLE.org:x&/%%25 *\": invalid port \":x&\" after host"
  assert_eq usum_p("a b:?%20+?"), "ERR parse \"a b:?%20+?\": first path segment in URL cannot contain colon"
  assert_eq usum_p("http:///[::ffff:1.2.3.4]"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"/[::ffff:1.2.3.4]\", rawpath=\"/[::ffff:1.2.3.4]\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:///[::ffff:1.2.3.4] | /[::ffff:1.2.3.4] |  | /[::ffff:1.2.3.4] |  |  | http:///[::ffff:1.2.3.4] | true"
}

test "vectors: parse 2" {
