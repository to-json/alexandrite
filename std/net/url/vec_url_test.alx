  assert_eq usum_p("https:'!:// ?=\#/%2F"), "opaque=\"'!:// \", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"=\", frag=\"//\", rawfrag=\"/%2F\", forcequery=false, omithost=false | https:'!:// ?=\#/%2F |  | /%2F | '!:// ?= |  |  | https:'!:// ?=\#/%2F | true"
}

