  assert_eq esc("^€€?é\x01"), ("%5E%E2%82%AC%E2%82%AC%3F%C3%A9%01", "%5E%E2%82%AC%E2%82%AC%3F%C3%A9%01", "^€€?é\x01", "^€€?é\x01")
