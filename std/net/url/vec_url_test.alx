  assert_eq usum_p("///x%41~)=+"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"///xA~)=+\", rawpath=\"///x%41~)=+\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ///x%41~)=+ | ///x%41~)=+ |  | ///x%41~)=+ |  |  | ///x%41~)=+ | false"
  assert_eq usum_p("postgres:[::1%'?a=1;"), "opaque=\"[::1%'\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"a=1;\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | postgres:[::1%'?a=1; |  |  | [::1%'?a=1; |  |  | postgres:[::1%'?a=1; | true"
  assert_eq usum_p("file://example.com:x!&?+"), "ERR parse \"file://example.com:x!&?+\": invalid port \":x!&\" after host"
}

test "vectors: parse 7" {
  assert_eq usum_p("a+b.c-d:%zz!//b%2Fc=(\#$&'()*+,;=%20f!"), "opaque=\"%zz!//b%2Fc=(\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"$&'()*+,;= f!\", rawfrag=\"$&'()*+,;=%20f!\", forcequery=false, omithost=false | a+b.c-d:%zz!//b%2Fc=(\#$&'()*+,;=%20f! |  | $&'()*+,;=%20f! | %zz!//b%2Fc=( |  |  | a+b.c-d:%zz!//b%2Fc=(\#$&'()*+,;=%20f! | true"
