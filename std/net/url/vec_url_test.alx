  assert_eq usum_p("postgres:[fe80::1%25en0]?a=1%20+a=1\#!"), "opaque=\"[fe80::1%25en0]\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"a=1%20+a=1\", frag=\"!\", rawfrag=\"\", forcequery=false, omithost=false | postgres:[fe80::1%25en0]?a=1%20+a=1\#! |  | ! | [fe80::1%25en0]?a=1%20+a=1 |  |  | postgres:[fe80::1%25en0]?a=1%20+a=1\#! | true"
