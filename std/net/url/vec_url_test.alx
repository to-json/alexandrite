  assert_eq esc("(,"), ("%28%2C", "%28%2C", "(,", "(,")
  assert_eq esc("\""), ("%22", "%22", "\"", "\"")
}

test "vectors: escaping 7" {
  assert_eq esc("/;"), ("%2F%3B", "%2F%3B", "/;", "/;")
  assert_eq esc(">|}}%2a]]"), ("%3E%7C%7D%7D%252a%5D%5D", "%3E%7C%7D%7D%252a%5D%5D", ">|}}*]]", ">|}}*]]")
