  assert_eq usum_rq("///h%C3%A9:80"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"///hé:80\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ///h%C3%A9:80 | ///h%C3%A9:80 |  | ///h%C3%A9:80 |  |  | ///h%C3%A9:80 | false"
