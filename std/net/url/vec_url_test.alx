  assert_eq usum_p("1x:/[1.2.3.4][)%20"), "ERR parse \"1x:/[1.2.3.4][)%20\": first path segment in URL cannot contain colon"
  assert_eq usum_p("https:///^u:@[fe80::1%25en0]&%25+%zz*)\#/%$&'()*+,;=%2F"), "ERR parse \"https:///^u:@[fe80::1%25en0]&%25+%zz*)\": invalid URL escape \"%zz\""
  assert_eq usum_p("http:/example.com].%:/?b"), "ERR parse \"http:/example.com].%:/?b\": invalid URL escape \"%:/\""
