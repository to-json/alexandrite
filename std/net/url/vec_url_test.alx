test "vectors: escaping 14" {
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("%zz"), ("%25zz", "%25zz", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("+)=~"), ("%2B%29%3D~", "+%29=~", " )=~", "+)=~")
  assert_eq esc(hx("217d2d3a28ff")), ("%21%7D-%3A%28%FF", "%21%7D-:%28%FF", hx("217d2d3a28ff"), hx("217d2d3a28ff"))
  assert_eq esc("\x01.=\\!$_€"), ("%01.%3D%5C%21%24_%E2%82%AC", "%01.=%5C%21$_%E2%82%AC", "\x01.=\\!$_€", "\x01.=\\!$_€")
  assert_eq esc("~Z@>%2&=)"), ("~Z%40%3E%252%26%3D%29", "~Z@%3E%252&=%29", "ERR invalid URL escape \"%2&\"", "ERR invalid URL escape \"%2&\"")
  assert_eq esc("~"), ("~", "~", "~", "~")
  assert_eq esc("("), ("%28", "%28", "(", "(")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("%zz}\"<?<\\"), ("%25zz%7D%22%3C%3F%3C%5C", "%25zz%7D%22%3C%3F%3C%5C", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("=&$|.`\#"), ("%3D%26%24%7C.%60%23", "=&$%7C.%60%23", "=&$|.`\#", "=&$|.`\#")
  assert_eq esc("\#<"), ("%23%3C", "%23%3C", "\#<", "\#<")
  assert_eq esc(">!>-{$;"), ("%3E%21%3E-%7B%24%3B", "%3E%21%3E-%7B$%3B", ">!>-{$;", ">!>-{$;")
  assert_eq esc("%zz}| (%&~"), ("%25zz%7D%7C+%28%25%26~", "%25zz%7D%7C%20%28%25&~", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("\#\#&"), ("%23%23%26", "%23%23&", "\#\#&", "\#\#&")
  assert_eq esc("{$ "), ("%7B%24+", "%7B$%20", "{$ ", "{$ ")
  assert_eq esc(hx("3eff29")), ("%3E%FF%29", "%3E%FF%29", hx("3eff29"), hx("3eff29"))
  assert_eq esc(")<'*@%zz`*"), ("%29%3C%27%2A%40%25zz%60%2A", "%29%3C%27%2A@%25zz%60%2A", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("@"), ("%40", "@", "@", "@")
  assert_eq esc("\x01&=/]"), ("%01%26%3D%2F%5D", "%01&=%2F%5D", "\x01&=/]", "\x01&=/]")
