  assert_eq esc("\x01<*%2"), ("%01%3C%2A%252", "%01%3C%2A%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc(".\"![0"), (".%22%21%5B0", ".%22%21%5B0", ".\"![0", ".\"![0")
