  assert_eq esc("-"), ("-", "-", "-", "-")
  assert_eq esc("@) +<é"), ("%40%29+%2B%3C%C3%A9", "@%29%20+%3C%C3%A9", "@)  <é", "@) +<é")
  assert_eq esc("<"), ("%3C", "%3C", "<", "<")
  assert_eq esc("|?%&[."), ("%7C%3F%25%26%5B.", "%7C%3F%25&%5B.", "ERR invalid URL escape \"%&[\"", "ERR invalid URL escape \"%&[\"")
  assert_eq esc(hx("5d5c013d24ff")), ("%5D%5C%01%3D%24%FF", "%5D%5C%01=$%FF", hx("5d5c013d24ff"), hx("5d5c013d24ff"))
