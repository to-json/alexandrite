  assert_eq usum_p("b%2Fc.)''?b&&&\#%20%2F"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"b/c.)''\", rawpath=\"b%2Fc.)''\", rawq=\"b&&&\", frag=\" /\", rawfrag=\"%20%2F\", forcequery=false, omithost=false | b%2Fc.)''?b&&&\#%20%2F | b%2Fc.)'' | %20%2F | b%2Fc.)''?b&&& |  |  | b%2Fc.)''?b&&&\#%20%2F | false"
