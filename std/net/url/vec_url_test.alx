  assert_eq usum_p("https:?=?b\#%20"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"=?b\", frag=\" \", rawfrag=\"\", forcequery=false, omithost=false | https:?=?b\#%20 |  | %20 | /?=?b |  |  | https:?=?b\#%20 | true"
