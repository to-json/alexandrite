test "vectors: escaping 6" {
  assert_eq esc("\x01,:."), ("%01%2C%3A.", "%01%2C:.", "\x01,:.", "\x01,:.")
  assert_eq esc("é%2"), ("%C3%A9%252", "%C3%A9%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc("%%41\#|*<"), ("%25%2541%23%7C%2A%3C", "%25%2541%23%7C%2A%3C", "ERR invalid URL escape \"%%4\"", "ERR invalid URL escape \"%%4\"")
  assert_eq esc(">"), ("%3E", "%3E", ">", ">")
  assert_eq esc(hx("3d2b3b21ff")), ("%3D%2B%3B%21%FF", "=+%3B%21%FF", hx("3d203b21ff"), hx("3d2b3b21ff"))
  assert_eq esc(hx("ff7c")), ("%FF%7C", "%FF%7C", hx("ff7c"), hx("ff7c"))
  assert_eq esc("%2%2%zz\")]!"), ("%252%252%25zz%22%29%5D%21", "%252%252%25zz%22%29%5D%21", "ERR invalid URL escape \"%2%\"", "ERR invalid URL escape \"%2%\"")
  assert_eq esc("-%2\x01\x01a-,"), ("-%252%01%01a-%2C", "-%252%01%01a-%2C", "ERR invalid URL escape \"%2\\x01\"", "ERR invalid URL escape \"%2\\x01\"")
  assert_eq esc("](}%41-^"), ("%5D%28%7D%2541-%5E", "%5D%28%7D%2541-%5E", "](}A-^", "](}A-^")
  assert_eq esc("%2;,<.é]/"), ("%252%3B%2C%3C.%C3%A9%5D%2F", "%252%3B%2C%3C.%C3%A9%5D%2F", "ERR invalid URL escape \"%2;\"", "ERR invalid URL escape \"%2;\"")
  assert_eq esc("%2!\\..-:)%zz"), ("%252%21%5C..-%3A%29%25zz", "%252%21%5C..-:%29%25zz", "ERR invalid URL escape \"%2!\"", "ERR invalid URL escape \"%2!\"")
  assert_eq esc("~$^{"), ("~%24%5E%7B", "~$%5E%7B", "~$^{", "~$^{")
  assert_eq esc("\\\"Z*>_="), ("%5C%22Z%2A%3E_%3D", "%5C%22Z%2A%3E_=", "\\\"Z*>_=", "\\\"Z*>_=")
  assert_eq esc("[}"), ("%5B%7D", "%5B%7D", "[}", "[}")
  assert_eq esc("~="), ("~%3D", "~=", "~=", "~=")
  assert_eq esc("/<,,%2"), ("%2F%3C%2C%2C%252", "%2F%3C%2C%2C%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc("["), ("%5B", "%5B", "[", "[")
  assert_eq esc("(<:"), ("%28%3C%3A", "%28%3C:", "(<:", "(<:")
  assert_eq esc(",(\\|0|}?Z"), ("%2C%28%5C%7C0%7C%7D%3FZ", "%2C%28%5C%7C0%7C%7D%3FZ", ",(\\|0|}?Z", ",(\\|0|}?Z")
  assert_eq esc(">0]>"), ("%3E0%5D%3E", "%3E0%5D%3E", ">0]>", ">0]>")
  assert_eq esc("0\")="), ("0%22%29%3D", "0%22%29=", "0\")=", "0\")=")
  assert_eq esc("{"), ("%7B", "%7B", "{", "{")
  assert_eq esc(hx("3c5aff2c")), ("%3CZ%FF%2C", "%3CZ%FF%2C", hx("3c5aff2c"), hx("3c5aff2c"))
  assert_eq esc("{"), ("%7B", "%7B", "{", "{")
  assert_eq esc("-'\x01\#$"), ("-%27%01%23%24", "-%27%01%23$", "-'\x01\#$", "-'\x01\#$")
  assert_eq esc("}@"), ("%7D%40", "%7D@", "}@", "}@")
  assert_eq esc("\#a{\# %2@|\x01"), ("%23a%7B%23+%252%40%7C%01", "%23a%7B%23%20%252@%7C%01", "ERR invalid URL escape \"%2@\"", "ERR invalid URL escape \"%2@\"")
  assert_eq esc(hx("ff277e3a2f253431615c")), ("%FF%27~%3A%2F%2541a%5C", "%FF%27~:%2F%2541a%5C", hx("ff277e3a2f41615c"), hx("ff277e3a2f41615c"))
  assert_eq esc("@=%zz%41:+-"), ("%40%3D%25zz%2541%3A%2B-", "@=%25zz%2541:+-", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(hx("257a7affff3d303f7cc3a9")), ("%25zz%FF%FF%3D0%3F%7C%C3%A9", "%25zz%FF%FF=0%3F%7C%C3%A9", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(hx("223c2532ff2425323a")), ("%22%3C%252%FF%24%252%3A", "%22%3C%252%FF$%252:", "ERR invalid URL escape \"%2\\xff\"", "ERR invalid URL escape \"%2\\xff\"")
  assert_eq esc("\#]'>~%zz0\#="), ("%23%5D%27%3E~%25zz0%23%3D", "%23%5D%27%3E~%25zz0%23=", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(hx("ff5c7c30257a7a22013f")), ("%FF%5C%7C0%25zz%22%01%3F", "%FF%5C%7C0%25zz%22%01%3F", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("~\").*"), ("~%22%29.%2A", "~%22%29.%2A", "~\").*", "~\").*")
  assert_eq esc("{[_?"), ("%7B%5B_%3F", "%7B%5B_%3F", "{[_?", "{[_?")
  assert_eq esc("{"), ("%7B", "%7B", "{", "{")
  assert_eq esc("a:=%zz"), ("a%3A%3D%25zz", "a:=%25zz", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("}:é-."), ("%7D%3A%C3%A9-.", "%7D:%C3%A9-.", "}:é-.", "}:é-.")
  assert_eq esc(hx("e282acff2c2c5c5a")), ("%E2%82%AC%FF%2C%2C%5CZ", "%E2%82%AC%FF%2C%2C%5CZ", hx("e282acff2c2c5c5a"), hx("e282acff2c2c5c5a"))
  assert_eq esc("Z_'/"), ("Z_%27%2F", "Z_%27%2F", "Z_'/", "Z_'/")
  assert_eq esc("!.[$"), ("%21.%5B%24", "%21.%5B$", "!.[$", "!.[$")
  assert_eq esc(",=&:"), ("%2C%3D%26%3A", "%2C=&:", ",=&:", ",=&:")
