  assert_eq usum_p("//serserseru@EXAMPLE.org:x/~?;bb\#f!"), "ERR parse \"//serserseru@EXAMPLE.org:x/~?;bb\": invalid port \":x\" after host"
  assert_eq usum_p("s_c:?%zz&a=1\#/! "), "ERR parse \"s_c:?%zz&a=1\": first path segment in URL cannot contain colon"
  assert_eq usum_p("x://[::1:\#%"), "ERR parse \"x://[::1:\": missing ']' in host"
  assert_eq usum_p("ftp://[::ffff:1.2.3.4]~?+?+"), "ERR parse \"ftp://[::ffff:1.2.3.4]~?+?+\": invalid port \"~\" after host"
  assert_eq usum_p("a+b.c-d::?&=+é"), "opaque=\":\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"&=+é\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d::?&=+é |  |  | :?&=+é |  |  | a+b.c-d::?&=+é | true"
