  assert_eq usum_p("a+b.c-d://example.com:x:???"), "opaque=\"\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"example.com:x:\", path=\"\", rawpath=\"\", rawq=\"??\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d://example.com:x:??? |  |  | /??? | example.com:x |  | a+b.c-d://example.com:x:??? | true"
  assert_eq usum_p("http:(:?&+=a=1"), "opaque=\"(:\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"&+=a=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:(:?&+=a=1 |  |  | (:?&+=a=1 |  |  | http:(:?&+=a=1 | true"
  assert_eq usum_p("ftp:é%25!%?=a=1é?"), "opaque=\"é%25!%\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"=a=1é?\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:é%25!%?=a=1é? |  |  | é%25!%?=a=1é? |  |  | ftp:é%25!%?=a=1é? | true"
  assert_eq usum_p("1x://[1.2.3.4]:x;p!]%20)%?;?\#%20"), "ERR parse \"1x://[1.2.3.4]:x;p!]%20)%?;?\": first path segment in URL cannot contain colon"
  assert_eq usum_p("!%"), "ERR parse \"!%\": invalid URL escape \"%\""
  assert_eq usum_p("s_c:/[1.2.3.4] "), "ERR parse \"s_c:/[1.2.3.4] \": first path segment in URL cannot contain colon"
  assert_eq usum_p("file:[::1;p?==\# "), "opaque=\"[::1;p\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"==\", frag=\" \", rawfrag=\" \", forcequery=false, omithost=false | file:[::1;p?==\#%20 |  | %20 | [::1;p?== |  |  | file:[::1;p?==\#%20 | true"
  assert_eq usum_p("postgres:.[:;p?=;%20"), "opaque=\".[:;p\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"=;%20\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | postgres:.[:;p?=;%20 |  |  | .[:;p?=;%20 |  |  | postgres:.[:;p?=;%20 | true"
  assert_eq usum_p("a+b.c-d:[::1]!]+=//?+\#"), "opaque=\"[::1]!]+=//\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"+\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:[::1]!]+=//?+ |  |  | [::1]!]+=//?+ |  |  | a+b.c-d:[::1]!]+=//?+ | true"
  assert_eq usum_p("mailto:+a)"), "opaque=\"+a)\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto:+a) |  |  | +a) |  |  | mailto:+a) | true"
  assert_eq usum_p("s_c:1.2.3.4:%38%30 +~~?"), "ERR parse \"s_c:1.2.3.4:%38%30 +~~?\": first path segment in URL cannot contain colon"
  assert_eq usum_p("https://@@x%41:%20"), "ERR parse \"https://@@x%41:%20\": invalid port \":%20\" after host"
  assert_eq usum_p("http://[::ffff:1.2.3.4]:%38%30b%2Fc+%%:b%2Fc"), "ERR parse \"http://[::ffff:1.2.3.4]:%38%30b%2Fc+%%:b%2Fc\": invalid port \":%38%30b%2Fc+%%:b%2Fc\" after host"
  assert_eq usum_p("x://@@1.2.3.4:80:!%25?"), "ERR parse \"x://@@1.2.3.4:80:!%25?\": invalid port \":!%25\" after host"
  assert_eq usum_p("//!^%20@h%C3%A9@&?%zz&b?"), "ERR parse \"//!^%20@h%C3%A9@&?%zz&b?\": net/url: invalid userinfo"
  assert_eq usum_p("//!@?+%20+\#/\# %"), "ERR parse \"//!@?+%20+\#/\# %\": invalid URL escape \"%\""
  assert_eq usum_p("ftp:;p?%zz"), "opaque=\";p\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"%zz\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:;p?%zz |  |  | ;p?%zz |  |  | ftp:;p?%zz | true"
  assert_eq usum_p("file:/example.com&+é(]"), "opaque=\"\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"/example.com&+é(]\", rawpath=\"/example.com&+é(]\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | file:/example.com&+%C3%A9%28%5D | /example.com&+%C3%A9%28%5D |  | /example.com&+%C3%A9%28%5D |  |  | file:/example.com&+%C3%A9%28%5D | true"
  assert_eq usum_p("https://example.com:)a?/é"), "ERR parse \"https://example.com:)a?/é\": invalid port \":)a\" after host"
  assert_eq usum_p("[::1:80][é! "), "ERR parse \"[::1:80][é! \": first path segment in URL cannot contain colon"
  assert_eq usum_p("mailto:example.com"), "opaque=\"example.com\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto:example.com |  |  | example.com |  |  | mailto:example.com | true"
  assert_eq usum_p("http://a b!é%%(?\# %20é"), "ERR parse \"http://a b!é%%(?\": invalid character \" \" in host name"
  assert_eq usum_p("https:;p@@(?%zz;?\#%$&'()*+,;= "), "ERR parse \"https:;p@@(?%zz;?\#%$&'()*+,;= \": invalid URL escape \"%$&\""
  assert_eq usum_p("//host1:1,host2:2:/[]%20%20"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"host1:1,host2:2:\", path=\"/[]  \", rawpath=\"/[]%20%20\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | //host1:1,host2:2:/[]%20%20 | /[]%20%20 |  | /[]%20%20 | host1:1,host2:2 |  | //host1:1,host2:2:/[]%20%20 | false"
  assert_eq usum_p("1x:///p%40wser@local_host:80//.\#%2F/!"), "ERR parse \"1x:///p%40wser@local_host:80//.\": first path segment in URL cannot contain colon"
  assert_eq usum_p("file://[fe80::1%25en0]://)=.*"), "opaque=\"\", scheme=\"file\", user=nil, pass=nil, host=\"[fe80::1%en0]:\", path=\"//)=.*\", rawpath=\"//)=.*\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | file://[fe80::1%25en0]://)=.* | //)=.* |  | //)=.* | fe80::1%en0 |  | file://[fe80::1%25en0]://)=.* | true"
  assert_eq usum_p("///%20@local_host'\# %20!/"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/// @local_host'\", rawpath=\"///%20@local_host'\", rawq=\"\", frag=\"  !/\", rawfrag=\" %20!/\", forcequery=false, omithost=false | ///%20@local_host'\#%20%20!/ | ///%20@local_host' | %20%20!/ | ///%20@local_host' |  |  | ///%20@local_host'\#%20%20!/ | false"
  assert_eq usum_p("postgres://[::1]~ab%2Fc~é(?&a=1+"), "ERR parse \"postgres://[::1]~ab%2Fc~é(?&a=1+\": invalid port \"~ab%2Fc~é(\" after host"
  assert_eq usum_p("1x: @&\# é/"), "ERR parse \"1x: @&\": first path segment in URL cannot contain colon"
  assert_eq usum_p("HTTP:' %]=?a=1?"), "opaque=\"' %]=\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"a=1?\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:' %]=?a=1? |  |  | ' %]=?a=1? |  |  | http:' %]=?a=1? | true"
  assert_eq usum_p("postgres:///^ser@x%41)[+?&&="), "opaque=\"\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"/^ser@xA)[+\", rawpath=\"/^ser@x%41)[+\", rawq=\"&&=\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | postgres:///%5Eser@xA%29%5B+?&&= | /%5Eser@xA%29%5B+ |  | /%5Eser@xA%29%5B+?&&= |  |  | postgres:///%5Eser@xA%29%5B+?&&= | true"
  assert_eq usum_p("1x:'b%2Fc+ \#!é$&'()*+,;=$&'()*+,;="), "ERR parse \"1x:'b%2Fc+ \": first path segment in URL cannot contain colon"
  assert_eq usum_p("file://[::1]%20?%20=;?"), "ERR parse \"file://[::1]%20?%20=;?\": invalid port \"%20\" after host"
  assert_eq usum_p("//x%41:80?&a=1"), "ERR parse \"//x%41:80?&a=1\": invalid URL escape \"%41\""
  assert_eq usum_p("ftp:/:..';p"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"/:..';p\", rawpath=\"/:..';p\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | ftp:/:..';p | /:..';p |  | /:..';p |  |  | ftp:/:..';p | true"
  assert_eq usum_p("mailto:+!'!;p;p"), "opaque=\"+!'!;p;p\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto:+!'!;p;p |  |  | +!'!;p;p |  |  | mailto:+!'!;p;p | true"
  assert_eq usum_p("é[!;p*["), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"é[!;p*[\", rawpath=\"é[!;p*[\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | %C3%A9%5B%21;p%2A%5B | %C3%A9%5B%21;p%2A%5B |  | %C3%A9%5B%21;p%2A%5B |  |  | %C3%A9%5B%21;p%2A%5B | false"
  assert_eq usum_p("/host1:1,host2:2:%38%30?%zz=b+\#\#"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/host1:1,host2:2:80\", rawpath=\"/host1:1,host2:2:%38%30\", rawq=\"%zz=b+\", frag=\"\#\", rawfrag=\"\#\", forcequery=false, omithost=false | /host1:1,host2:2:%38%30?%zz=b+\#%23 | /host1:1,host2:2:%38%30 | %23 | /host1:1,host2:2:%38%30?%zz=b+ |  |  | /host1:1,host2:2:%38%30?%zz=b+\#%23 | false"
  assert_eq usum_p("host1:1,host2:2++"), "opaque=\"1,host2:2++\", scheme=\"host1\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | host1:1,host2:2++ |  |  | 1,host2:2++ |  |  | host1:1,host2:2++ | true"
  assert_eq usum_p("x://x%41%25!+;p%"), "ERR parse \"x://x%41%25!+;p%\": invalid URL escape \"%41\""
  assert_eq usum_p("ftp://1.2.3.4: &:é \#%2F"), "ERR parse \"ftp://1.2.3.4: &:é \": invalid port \":é \" after host"
  assert_eq usum_p("a+b.c-d://p%40w!p%40w@:8080\#\#f$&'()*+,;="), "opaque=\"\", scheme=\"a+b.c-d\", user=\"p@w!p@w\", pass=nil, host=\":8080\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\#f$&'()*+,;=\", rawfrag=\"\#f$&'()*+,;=\", forcequery=false, omithost=false | a+b.c-d://p%40w%21p%40w@:8080\#%23f$&%27()*+,;= |  | %23f$&%27()*+,;= | / |  | 8080 | a+b.c-d://p%40w%21p%40w@:8080\#%23f$&%27()*+,;= | true"
}

test "vectors: parse 5" {
  assert_eq usum_p("https:/h%C3%A9&b%2Fc"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"/hé&b/c\", rawpath=\"/h%C3%A9&b%2Fc\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | https:/h%C3%A9&b%2Fc | /h%C3%A9&b%2Fc |  | /h%C3%A9&b%2Fc |  |  | https:/h%C3%A9&b%2Fc | true"
  assert_eq usum_p("1x://[::1]%..é?=b"), "ERR parse \"1x://[::1]%..é?=b\": first path segment in URL cannot contain colon"
  assert_eq usum_p("éa%?%20b\# /f"), "ERR parse \"éa%?%20b\": invalid URL escape \"%\""
  assert_eq usum_p("https:!"), "opaque=\"!\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:! |  |  | ! |  |  | https:! | true"
  assert_eq usum_p("HTTP:ser:%20p%40w@[::ffff:1.2.3.4]//?%20éa=1a=1\#"), "opaque=\"ser:%20p%40w@[::ffff:1.2.3.4]//\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"%20éa=1a=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:ser:%20p%40w@[::ffff:1.2.3.4]//?%20éa=1a=1 |  |  | ser:%20p%40w@[::ffff:1.2.3.4]//?%20éa=1a=1 |  |  | http:ser:%20p%40w@[::ffff:1.2.3.4]//?%20éa=1a=1 | true"
  assert_eq usum_p("x:?%20%zz?%zz"), "opaque=\"\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"%20%zz?%zz\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | x:?%20%zz?%zz |  |  | /?%20%zz?%zz |  |  | x:?%20%zz?%zz | true"
  assert_eq usum_p("postgres:///:ser@@[fe80::1%25en0]:b%2Fc%("), "ERR parse \"postgres:///:ser@@[fe80::1%25en0]:b%2Fc%(\": invalid URL escape \"%(\""
  assert_eq usum_p("HTTP:///ser@p%40w@[fe80::1%en0]:%38%30%25%b%2Fc?"), "ERR parse \"HTTP:///ser@p%40w@[fe80::1%en0]:%38%30%25%b%2Fc?\": invalid URL escape \"%en\""
  assert_eq usum_p("postgres:///u@x%41:x] @"), "opaque=\"\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"/u@xA:x] @\", rawpath=\"/u@x%41:x] @\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | postgres:///u@xA:x%5D%20@ | /u@xA:x%5D%20@ |  | /u@xA:x%5D%20@ |  |  | postgres:///u@xA:x%5D%20@ | true"
  assert_eq usum_p("mailto://[::ffff:1.2.3.4]b%2Fcb%2Fc\#$&'()*+,;=$&'()*+,;="), "ERR parse \"mailto://[::ffff:1.2.3.4]b%2Fcb%2Fc\": invalid port \"b%2Fcb%2Fc\" after host"
  assert_eq usum_p("///host1:1,host2:2:8080/??;%20"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"///host1:1,host2:2:8080/\", rawpath=\"\", rawq=\"?;%20\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ///host1:1,host2:2:8080/??;%20 | ///host1:1,host2:2:8080/ |  | ///host1:1,host2:2:8080/??;%20 |  |  | ///host1:1,host2:2:8080/??;%20 | false"
  assert_eq usum_p("ftp:^!^@a b%20&="), "opaque=\"^!^@a b%20&=\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:^!^@a b%20&= |  |  | ^!^@a b%20&= |  |  | ftp:^!^@a b%20&= | true"
  assert_eq usum_p("//=]*%25\#!%%2F!"), "ERR parse \"//=]*%25\#!%%2F!\": invalid URL escape \"%%2\""
  assert_eq usum_p("mailto:///local_host:80~+..:\#$&'()*+,;=%%2F%2F"), "ERR parse \"mailto:///local_host:80~+..:\#$&'()*+,;=%%2F%2F\": invalid URL escape \"%%2\""
  assert_eq usum_p("file:a b:a?+a=1;"), "opaque=\"a b:a\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"+a=1;\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | file:a b:a?+a=1; |  |  | a b:a?+a=1; |  |  | file:a b:a?+a=1; | true"
  assert_eq usum_p("HTTP:[fe80::1%en0]%zz+[%[&\#!$&'()*+,;="), "opaque=\"[fe80::1%en0]%zz+[%[&\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"!$&'()*+,;=\", rawfrag=\"!$&'()*+,;=\", forcequery=false, omithost=false | http:[fe80::1%en0]%zz+[%[&\#!$&'()*+,;= |  | !$&'()*+,;= | [fe80::1%en0]%zz+[%[& |  |  | http:[fe80::1%en0]%zz+[%[&\#!$&'()*+,;= | true"
  assert_eq usum_p("HTTP://example.com"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"example.com\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http://example.com |  |  | / | example.com |  | http://example.com | true"
  assert_eq usum_p("a+b.c-d:+é.*@&?\#é$&'()*+,;=%20"), "opaque=\"+é.*@&\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"é$&'()*+,;= \", rawfrag=\"é$&'()*+,;=%20\", forcequery=true, omithost=false | a+b.c-d:+é.*@&?\#%C3%A9$&%27()*+,;=%20 |  | %C3%A9$&%27()*+,;=%20 | +é.*@&? |  |  | a+b.c-d:+é.*@&?\#%C3%A9$&%27()*+,;=%20 | true"
  assert_eq usum_p("a+b.c-d:[fe80::1%en0]:80// %zz"), "opaque=\"[fe80::1%en0]:80// %zz\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:[fe80::1%en0]:80// %zz |  |  | [fe80::1%en0]:80// %zz |  |  | a+b.c-d:[fe80::1%en0]:80// %zz | true"
  assert_eq usum_p("http://[fe80::1%25en0]:80://%%;p*?%zz%zz+\#/f"), "ERR parse \"http://[fe80::1%25en0]:80://%%;p*?%zz%zz+\": invalid port \":80:\" after host"
  assert_eq usum_p("http:"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http: |  |  | / |  |  | http: | true"
  assert_eq usum_p("x://local_host:%38%30"), "ERR parse \"x://local_host:%38%30\": invalid port \":%38%30\" after host"
  assert_eq usum_p("1x:)=.*é?=="), "ERR parse \"1x:)=.*é?==\": first path segment in URL cannot contain colon"
  assert_eq usum_p("a+b.c-d:///x%41[]?+="), "opaque=\"\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"/xA[]\", rawpath=\"/x%41[]\", rawq=\"+=\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:///x%41[]?+= | /x%41[] |  | /x%41[]?+= |  |  | a+b.c-d:///x%41[]?+= | true"
  assert_eq usum_p("s_c://[1.2.3.4]%%20%20([*"), "ERR parse \"s_c://[1.2.3.4]%%20%20([*\": first path segment in URL cannot contain colon"
  assert_eq usum_p("http:[fe80::1%25en0];p):&\#f /"), "opaque=\"[fe80::1%25en0];p):&\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"f /\", rawfrag=\"f /\", forcequery=false, omithost=false | http:[fe80::1%25en0];p):&\#f%20/ |  | f%20/ | [fe80::1%25en0];p):& |  |  | http:[fe80::1%25en0];p):&\#f%20/ | true"
  assert_eq usum_p("file:///[1.2.3.4])%20&&%25"), "opaque=\"\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"/[1.2.3.4]) &&%\", rawpath=\"/[1.2.3.4])%20&&%25\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | file:///[1.2.3.4])%20&&%25 | /[1.2.3.4])%20&&%25 |  | /[1.2.3.4])%20&&%25 |  |  | file:///[1.2.3.4])%20&&%25 | true"
  assert_eq usum_p("http:/@uu@[1.2.3.4]:x.?é?=="), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"/@uu@[1.2.3.4]:x.\", rawpath=\"/@uu@[1.2.3.4]:x.\", rawq=\"é?==\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | http:/@uu@[1.2.3.4]:x.?é?== | /@uu@[1.2.3.4]:x. |  | /@uu@[1.2.3.4]:x.?é?== |  |  | http:/@uu@[1.2.3.4]:x.?é?== | true"
  assert_eq usum_p("file://@!@@1.2.3.4[a\#"), "ERR parse \"file://@!@@1.2.3.4[a\": invalid IP-literal"
  assert_eq usum_p("http:=:é/?%zza=1%zz"), "opaque=\"=:é/\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"%zza=1%zz\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:=:é/?%zza=1%zz |  |  | =:é/?%zza=1%zz |  |  | http:=:é/?%zza=1%zz | true"
  assert_eq usum_p("mailto:[fe80::1%en0]=%)b%2Fc\#"), "opaque=\"[fe80::1%en0]=%)b%2Fc\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto:[fe80::1%en0]=%)b%2Fc |  |  | [fe80::1%en0]=%)b%2Fc |  |  | mailto:[fe80::1%en0]=%)b%2Fc | true"
