  assert_eq esc("<é\#}! "), ("%3C%C3%A9%23%7D%21+", "%3C%C3%A9%23%7D%21%20", "<é\#}! ", "<é\#}! ")
  assert_eq esc("$]"), ("%24%5D", "$%5D", "$]", "$]")
  assert_eq esc("~}"), ("~%7D", "~%7D", "~}", "~}")
