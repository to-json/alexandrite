  assert_eq esc("$~,*"), ("%24~%2C%2A", "$~%2C%2A", "$~,*", "$~,*")
  assert_eq esc("<?`'|\\"), ("%3C%3F%60%27%7C%5C", "%3C%3F%60%27%7C%5C", "<?`'|\\", "<?`'|\\")
  assert_eq esc("/é|é\\"), ("%2F%C3%A9%7C%C3%A9%5C", "%2F%C3%A9%7C%C3%A9%5C", "/é|é\\", "/é|é\\")
  assert_eq esc(hx("5d7bff257a7a257a7a5f273c")), ("%5D%7B%FF%25zz%25zz_%27%3C", "%5D%7B%FF%25zz%25zz_%27%3C", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(",\x01_\"~-"), ("%2C%01_%22~-", "%2C%01_%22~-", ",\x01_\"~-", ",\x01_\"~-")
  assert_eq esc("=é;_0a]%41+"), ("%3D%C3%A9%3B_0a%5D%2541%2B", "=%C3%A9%3B_0a%5D%2541+", "=é;_0a]A ", "=é;_0a]A+")
  assert_eq esc(">< "), ("%3E%3C+", "%3E%3C%20", ">< ", ">< ")
  assert_eq esc(hx("7d240125327d7cff29")), ("%7D%24%01%252%7D%7C%FF%29", "%7D$%01%252%7D%7C%FF%29", "ERR invalid URL escape \"%2}\"", "ERR invalid URL escape \"%2}\"")
  assert_eq esc(hx("5f2f5aff5d5e")), ("_%2FZ%FF%5D%5E", "_%2FZ%FF%5D%5E", hx("5f2f5aff5d5e"), hx("5f2f5aff5d5e"))
  assert_eq esc("//.*Z/?"), ("%2F%2F.%2AZ%2F%3F", "%2F%2F.%2AZ%2F%3F", "//.*Z/?", "//.*Z/?")
  assert_eq esc(hx("5eff")), ("%5E%FF", "%5E%FF", hx("5eff"), hx("5eff"))
  assert_eq esc(";^Z_\#/"), ("%3B%5EZ_%23%2F", "%3B%5EZ_%23%2F", ";^Z_\#/", ";^Z_\#/")
  assert_eq esc("Z?"), ("Z%3F", "Z%3F", "Z?", "Z?")
  assert_eq esc("<_]\#^||~0"), ("%3C_%5D%23%5E%7C%7C~0", "%3C_%5D%23%5E%7C%7C~0", "<_]\#^||~0", "<_]\#^||~0")
  assert_eq esc("|"), ("%7C", "%7C", "|", "|")
  assert_eq esc("@Z&}"), ("%40Z%26%7D", "@Z&%7D", "@Z&}", "@Z&}")
  assert_eq esc(hx("28ff2b3f273e60")), ("%28%FF%2B%3F%27%3E%60", "%28%FF+%3F%27%3E%60", hx("28ff203f273e60"), hx("28ff2b3f273e60"))
  assert_eq esc("a!\x01?é0+;{"), ("a%21%01%3F%C3%A90%2B%3B%7B", "a%21%01%3F%C3%A90+%3B%7B", "a!\x01?é0 ;{", "a!\x01?é0+;{")
  assert_eq esc(hx("2a5e3c242534313cff5c21")), ("%2A%5E%3C%24%2541%3C%FF%5C%21", "%2A%5E%3C$%2541%3C%FF%5C%21", hx("2a5e3c24413cff5c21"), hx("2a5e3c24413cff5c21"))
  assert_eq esc("€?,"), ("%E2%82%AC%3F%2C", "%E2%82%AC%3F%2C", "€?,", "€?,")
  assert_eq esc(";"), ("%3B", "%3B", ";", ";")
  assert_eq esc(":\"\x01.Z"), ("%3A%22%01.Z", ":%22%01.Z", ":\"\x01.Z", ":\"\x01.Z")
  assert_eq esc("=a-`,%zz|}"), ("%3Da-%60%2C%25zz%7C%7D", "=a-%60%2C%25zz%7C%7D", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("%41/"), ("%2541%2F", "%2541%2F", "A/", "A/")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(")"), ("%29", "%29", ")", ")")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("%zzé%41+"), ("%25zz%C3%A9%2541%2B", "%25zz%C3%A9%2541+", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(hx("2a2a5b3f3dff3b257a7a01")), ("%2A%2A%5B%3F%3D%FF%3B%25zz%01", "%2A%2A%5B%3F=%FF%3B%25zz%01", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("{Z<\\=)]^"), ("%7BZ%3C%5C%3D%29%5D%5E", "%7BZ%3C%5C=%29%5D%5E", "{Z<\\=)]^", "{Z<\\=)]^")
  assert_eq esc("}-"), ("%7D-", "%7D-", "}-", "}-")
  assert_eq esc("$%2;^"), ("%24%252%3B%5E", "$%252%3B%5E", "ERR invalid URL escape \"%2;\"", "ERR invalid URL escape \"%2;\"")
  assert_eq esc(hx("ff5a")), ("%FFZ", "%FFZ", hx("ff5a"), hx("ff5a"))
  assert_eq esc("=a&@`=* )"), ("%3Da%26%40%60%3D%2A+%29", "=a&@%60=%2A%20%29", "=a&@`=* )", "=a&@`=* )")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(hx("3ac3a97c3a3cff27225d")), ("%3A%C3%A9%7C%3A%3C%FF%27%22%5D", ":%C3%A9%7C:%3C%FF%27%22%5D", hx("3ac3a97c3a3cff27225d"), hx("3ac3a97c3a3cff27225d"))
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(".*!,"), (".%2A%21%2C", ".%2A%21%2C", ".*!,", ".*!,")
  assert_eq esc(hx("257a7ae282acff3f")), ("%25zz%E2%82%AC%FF%3F", "%25zz%E2%82%AC%FF%3F", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("$\x010%2%\# ]"), ("%24%010%252%25%23+%5D", "$%010%252%25%23%20%5D", "ERR invalid URL escape \"%2%\"", "ERR invalid URL escape \"%2%\"")
  assert_eq esc("[0?"), ("%5B0%3F", "%5B0%3F", "[0?", "[0?")
  assert_eq esc("{<_\\\\"), ("%7B%3C_%5C%5C", "%7B%3C_%5C%5C", "{<_\\\\", "{<_\\\\")
  assert_eq esc("Z"), ("Z", "Z", "Z", "Z")
  assert_eq esc("/-?:$:\#~"), ("%2F-%3F%3A%24%3A%23~", "%2F-%3F:$:%23~", "/-?:$:\#~", "/-?:$:\#~")
  assert_eq esc(hx("22c3a93a22ff255b22")), ("%22%C3%A9%3A%22%FF%25%5B%22", "%22%C3%A9:%22%FF%25%5B%22", "ERR invalid URL escape \"%[\\\"\"", "ERR invalid URL escape \"%[\\\"\"")
  assert_eq esc("\x01 -~'(["), ("%01+-~%27%28%5B", "%01%20-~%27%28%5B", "\x01 -~'([", "\x01 -~'([")
  assert_eq esc(",\#%2~.){"), ("%2C%23%252~.%29%7B", "%2C%23%252~.%29%7B", "ERR invalid URL escape \"%2~\"", "ERR invalid URL escape \"%2~\"")
  assert_eq esc("<`_{@/!%2:"), ("%3C%60_%7B%40%2F%21%252%3A", "%3C%60_%7B@%2F%21%252:", "ERR invalid URL escape \"%2:\"", "ERR invalid URL escape \"%2:\"")
  assert_eq esc(">;!)%}:€{"), ("%3E%3B%21%29%25%7D%3A%E2%82%AC%7B", "%3E%3B%21%29%25%7D:%E2%82%AC%7B", "ERR invalid URL escape \"%}:\"", "ERR invalid URL escape \"%}:\"")
  assert_eq esc("\\="), ("%5C%3D", "%5C=", "\\=", "\\=")
  assert_eq esc(" ;\x01@\#}"), ("+%3B%01%40%23%7D", "%20%3B%01@%23%7D", " ;\x01@\#}", " ;\x01@\#}")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("'{$$%zz}"), ("%27%7B%24%24%25zz%7D", "%27%7B$$%25zz%7D", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("%zz^_,{`>/"), ("%25zz%5E_%2C%7B%60%3E%2F", "%25zz%5E_%2C%7B%60%3E%2F", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(hx("ff7c7b01235c7eff2d")), ("%FF%7C%7B%01%23%5C~%FF-", "%FF%7C%7B%01%23%5C~%FF-", hx("ff7c7b01235c7eff2d"), hx("ff7c7b01235c7eff2d"))
  assert_eq esc("%(_^`<^)"), ("%25%28_%5E%60%3C%5E%29", "%25%28_%5E%60%3C%5E%29", "ERR invalid URL escape \"%(_\"", "ERR invalid URL escape \"%(_\"")
  assert_eq esc("^?\x01)"), ("%5E%3F%01%29", "%5E%3F%01%29", "^?\x01)", "^?\x01)")
  assert_eq esc("@-"), ("%40-", "@-", "@-", "@-")
  assert_eq esc("$`,"), ("%24%60%2C", "$%60%2C", "$`,", "$`,")
  assert_eq esc("`?=~$%zz["), ("%60%3F%3D~%24%25zz%5B", "%60%3F=~$%25zz%5B", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(")%2"), ("%29%252", "%29%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc(""), ("", "", "", "")
}

test "vectors: escaping 2" {
  assert_eq esc("_*.'{_"), ("_%2A.%27%7B_", "_%2A.%27%7B_", "_*.'{_", "_*.'{_")
  assert_eq esc("?{{;€`"), ("%3F%7B%7B%3B%E2%82%AC%60", "%3F%7B%7B%3B%E2%82%AC%60", "?{{;€`", "?{{;€`")
  assert_eq esc(".\\&\#"), (".%5C%26%23", ".%5C&%23", ".\\&\#", ".\\&\#")
