  assert_eq usum_p("file:.?%zzéb&\#éf"), "opaque=\".\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"%zzéb&\", frag=\"éf\", rawfrag=\"éf\", forcequery=false, omithost=false | file:.?%zzéb&\#%C3%A9f |  | %C3%A9f | .?%zzéb& |  |  | file:.?%zzéb&\#%C3%A9f | true"
  assert_eq usum_p("file:/x%41:80:+"), "opaque=\"\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"/xA:80:+\", rawpath=\"/x%41:80:+\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | file:/x%41:80:+ | /x%41:80:+ |  | /x%41:80:+ |  |  | file:/x%41:80:+ | true"
