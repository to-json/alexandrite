test "vectors: escaping" {
  assert_eq esc(hx("232534317c3bff28")), ("%23%2541%7C%3B%FF%28", "%23%2541%7C%3B%FF%28", hx("23417c3bff28"), hx("23417c3bff28"))
  assert_eq esc("~"), ("~", "~", "~", "~")
  assert_eq esc("_>.\x01!~:"), ("_%3E.%01%21~%3A", "_%3E.%01%21~:", "_>.\x01!~:", "_>.\x01!~:")
  assert_eq esc("\\%zz{€)(:%"), ("%5C%25zz%7B%E2%82%AC%29%28%3A%25", "%5C%25zz%7B%E2%82%AC%29%28:%25", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("]\"<}\x01"), ("%5D%22%3C%7D%01", "%5D%22%3C%7D%01", "]\"<}\x01", "]\"<}\x01")
  assert_eq esc("'?@@>%2"), ("%27%3F%40%40%3E%252", "%27%3F@@%3E%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc("?%zz+-"), ("%3F%25zz%2B-", "%3F%25zz+-", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("'€"), ("%27%E2%82%AC", "%27%E2%82%AC", "'€", "'€")
  assert_eq esc("é!~&"), ("%C3%A9%21~%26", "%C3%A9%21~&", "é!~&", "é!~&")
  assert_eq esc("*' []€"), ("%2A%27+%5B%5D%E2%82%AC", "%2A%27%20%5B%5D%E2%82%AC", "*' []€", "*' []€")
  assert_eq esc(",€-(a,€"), ("%2C%E2%82%AC-%28a%2C%E2%82%AC", "%2C%E2%82%AC-%28a%2C%E2%82%AC", ",€-(a,€", ",€-(a,€")
  assert_eq esc("@"), ("%40", "@", "@", "@")
  assert_eq esc(",*%zz%{"), ("%2C%2A%25zz%25%7B", "%2C%2A%25zz%25%7B", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("'<|\"a%:"), ("%27%3C%7C%22a%25%3A", "%27%3C%7C%22a%25:", "ERR invalid URL escape \"%:\"", "ERR invalid URL escape \"%:\"")
  assert_eq esc("a{"), ("a%7B", "a%7B", "a{", "a{")
  assert_eq esc("a!*\x01~"), ("a%21%2A%01~", "a%21%2A%01~", "a!*\x01~", "a!*\x01~")
  assert_eq esc("\x01"), ("%01", "%01", "\x01", "\x01")
  assert_eq esc("("), ("%28", "%28", "(", "(")
  assert_eq esc(">+"), ("%3E%2B", "%3E+", "> ", ">+")
