  assert_eq usum_p("mailto://h%C3%A9//]é;p];p"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"hé\", path=\"//]é;p];p\", rawpath=\"//]é;p];p\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto://h%C3%A9//%5D%C3%A9;p%5D;p | //%5D%C3%A9;p%5D;p |  | //%5D%C3%A9;p%5D;p | hé |  | mailto://h%C3%A9//%5D%C3%A9;p%5D;p | true"
