  assert_eq usum_p("http:'(+ ??;"), "opaque=\"'(+ \", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"?;\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:'(+ ??; |  |  | '(+ ??; |  |  | http:'(+ ??; | true"
  assert_eq usum_p("x:a bé?%zzé=\#/"), "opaque=\"a bé\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"%zzé=\", frag=\"/\", rawfrag=\"\", forcequery=false, omithost=false | x:a bé?%zzé=\#/ |  | / | a bé?%zzé= |  |  | x:a bé?%zzé=\#/ | true"
  assert_eq usum_p("s_c: ?+/a=1%20\#$&'()*+,;="), "ERR parse \"s_c: ?+/a=1%20\": first path segment in URL cannot contain colon"
  assert_eq usum_p("a+b.c-d:[?é;=\#"), "opaque=\"[\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"é;=\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:[?é;= |  |  | [?é;= |  |  | a+b.c-d:[?é;= | true"
  assert_eq usum_p(")?=?\#!%2F%!"), "ERR parse \")?=?\#!%2F%!\": invalid URL escape \"%!\""
  assert_eq usum_p("HTTP:[::1:"), "opaque=\"[::1:\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:[::1: |  |  | [::1: |  |  | http:[::1: | true"
  assert_eq usum_p("/@ser@[::1]:%25%25\#f \#"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/@ser@[::1]:%%\", rawpath=\"/@ser@[::1]:%25%25\", rawq=\"\", frag=\"f \#\", rawfrag=\"f \#\", forcequery=false, omithost=false | /@ser@[::1]:%25%25\#f%20%23 | /@ser@[::1]:%25%25 | f%20%23 | /@ser@[::1]:%25%25 |  |  | /@ser@[::1]:%25%25\#f%20%23 | false"
  assert_eq usum_p("postgres:a b=/=);p"), "opaque=\"a b=/=);p\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | postgres:a b=/=);p |  |  | a b=/=);p |  |  | postgres:a b=/=);p | true"
  assert_eq usum_p("mailto::@[fe80::1%en0]:80:a!%zzb%2Fc?"), "opaque=\":@[fe80::1%en0]:80:a!%zzb%2Fc\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | mailto::@[fe80::1%en0]:80:a!%zzb%2Fc? |  |  | :@[fe80::1%en0]:80:a!%zzb%2Fc? |  |  | mailto::@[fe80::1%en0]:80:a!%zzb%2Fc? | true"
  assert_eq usum_p("s_c://a b+"), "ERR parse \"s_c://a b+\": first path segment in URL cannot contain colon"
  assert_eq usum_p("s_c:/!@@local_host:..?é&\#"), "ERR parse \"s_c:/!@@local_host:..?é&\": first path segment in URL cannot contain colon"
  assert_eq usum_p("///[1.2.3.4]:80=b%2Fc;p~%25"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"///[1.2.3.4]:80=b/c;p~%\", rawpath=\"///[1.2.3.4]:80=b%2Fc;p~%25\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ///[1.2.3.4]:80=b%2Fc;p~%25 | ///[1.2.3.4]:80=b%2Fc;p~%25 |  | ///[1.2.3.4]:80=b%2Fc;p~%25 |  |  | ///[1.2.3.4]:80=b%2Fc;p~%25 | false"
  assert_eq usum_p("x:/EXAMPLE.orgb%2Fc?&"), "opaque=\"\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"/EXAMPLE.orgb/c\", rawpath=\"/EXAMPLE.orgb%2Fc\", rawq=\"&\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | x:/EXAMPLE.orgb%2Fc?& | /EXAMPLE.orgb%2Fc |  | /EXAMPLE.orgb%2Fc?& |  |  | x:/EXAMPLE.orgb%2Fc?& | true"
  assert_eq usum_p("http:@@@[1.2.3.4]]')%25%20'\#//"), "opaque=\"@@@[1.2.3.4]]')%25%20'\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"//\", rawfrag=\"\", forcequery=false, omithost=false | http:@@@[1.2.3.4]]')%25%20'\#// |  | // | @@@[1.2.3.4]]')%25%20' |  |  | http:@@@[1.2.3.4]]')%25%20'\#// | true"
  assert_eq usum_p("s_c:[::ffff:1.2.3.4]:x..%zz:]:?"), "ERR parse \"s_c:[::ffff:1.2.3.4]:x..%zz:]:?\": first path segment in URL cannot contain colon"
  assert_eq usum_p("HTTP://[::1'?"), "ERR parse \"HTTP://[::1'?\": missing ']' in host"
  assert_eq usum_p("x:?é/b\#//"), "opaque=\"\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"é/b\", frag=\"//\", rawfrag=\"\", forcequery=false, omithost=false | x:?é/b\#// |  | // | /?é/b |  |  | x:?é/b\#// | true"
  assert_eq usum_p("x://[::1b%2Fc:)\#"), "ERR parse \"x://[::1b%2Fc:)\": missing ']' in host"
  assert_eq usum_p("//@%20"), "ERR parse \"//@%20\": invalid URL escape \"%20\""
  assert_eq usum_p("//EXAMPLE.org"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"EXAMPLE.org\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | //EXAMPLE.org |  |  | / | EXAMPLE.org |  | //EXAMPLE.org | false"
  assert_eq usum_p("a+b.c-d://%20p%40w%20@@[fe80::1%25en0]:%38%30%25%%25:éé"), "ERR parse \"a+b.c-d://%20p%40w%20@@[fe80::1%25en0]:%38%30%25%%25:éé\": invalid port \":%38%30%25%%25:éé\" after host"
  assert_eq usum_p("http:*!)"), "opaque=\"*!)\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:*!) |  |  | *!) |  |  | http:*!) | true"
  assert_eq usum_p("x://a b;pa'"), "ERR parse \"x://a b;pa'\": invalid character \" \" in host name"
  assert_eq usum_p("x://[fe80::1%25en0]:80(..\#!%/ "), "ERR parse \"x://[fe80::1%25en0]:80(..\": invalid port \":80(..\" after host"
  assert_eq usum_p("mailto:///host1:1,host2:2([/)?"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"/host1:1,host2:2([/)\", rawpath=\"/host1:1,host2:2([/)\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | mailto:///host1:1,host2:2([/)? | /host1:1,host2:2([/) |  | /host1:1,host2:2([/)? |  |  | mailto:///host1:1,host2:2([/)? | true"
  assert_eq usum_p("file:///b%2Fc:%\#%2F"), "ERR parse \"file:///b%2Fc:%\": invalid URL escape \"%\""
  assert_eq usum_p("https://a b.;p'//:\#f!"), "ERR parse \"https://a b.;p'//:\": invalid character \" \" in host name"
  assert_eq usum_p("postgres:a bé%zz//.."), "opaque=\"a bé%zz//..\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | postgres:a bé%zz//.. |  |  | a bé%zz//.. |  |  | postgres:a bé%zz//.. | true"
  assert_eq usum_p("postgres://+é\# !"), "opaque=\"\", scheme=\"postgres\", user=nil, pass=nil, host=\"+é\", path=\"\", rawpath=\"\", rawq=\"\", frag=\" !\", rawfrag=\" !\", forcequery=false, omithost=false | postgres://+%C3%A9\#%20! |  | %20! | / | +é |  | postgres://+%C3%A9\#%20! | true"
  assert_eq usum_p("file://x%41//?%zz+"), "ERR parse \"file://x%41//?%zz+\": invalid URL escape \"%41\""
  assert_eq usum_p("https:@a)b%2Fc?=?%zz\#$&'()*+,;=%"), "ERR parse \"https:@a)b%2Fc?=?%zz\#$&'()*+,;=%\": invalid URL escape \"%\""
  assert_eq usum_p("HTTP:..]//?%20==%20\#%$&'()*+,;=f"), "ERR parse \"HTTP:..]//?%20==%20\#%$&'()*+,;=f\": invalid URL escape \"%$&\""
  assert_eq usum_p("postgres:?%zz/?&\#% %20"), "ERR parse \"postgres:?%zz/?&\#% %20\": invalid URL escape \"% %\""
  assert_eq usum_p("x:///example.com%25..:!."), "opaque=\"\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"/example.com%..:!.\", rawpath=\"/example.com%25..:!.\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | x:///example.com%25..:!. | /example.com%25..:!. |  | /example.com%25..:!. |  |  | x:///example.com%25..:!. | true"
  assert_eq usum_p("mailto:/user@[::1;p:?bb?"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"/user@[::1;p:\", rawpath=\"/user@[::1;p:\", rawq=\"bb?\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | mailto:/user@[::1;p:?bb? | /user@[::1;p: |  | /user@[::1;p:?bb? |  |  | mailto:/user@[::1;p:?bb? | true"
  assert_eq usum_p("file:u!@local_host[+&:&~\#%"), "ERR parse \"file:u!@local_host[+&:&~\#%\": invalid URL escape \"%\""
  assert_eq usum_p("a+b.c-d://a b!=.%20=%"), "ERR parse \"a+b.c-d://a b!=.%20=%\": invalid character \" \" in host name"
  assert_eq usum_p("ftp:///[fe80::1%en0]:\#%f"), "ERR parse \"ftp:///[fe80::1%en0]:\": invalid URL escape \"%en\""
  assert_eq usum_p("ftp://EXAMPLE.org=..[%25?=b"), "ERR parse \"ftp://EXAMPLE.org=..[%25?=b\": invalid IP-literal"
  assert_eq usum_p("http:///...&?+%20"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"/...&\", rawpath=\"\", rawq=\"+%20\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:///...&?+%20 | /...& |  | /...&?+%20 |  |  | http:///...&?+%20 | true"
  assert_eq usum_p("ftp:///a b*?"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"/a b*\", rawpath=\"/a b*\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | ftp:///a%20b%2A? | /a%20b%2A |  | /a%20b%2A? |  |  | ftp:///a%20b%2A? | true"
  assert_eq usum_p("//[::1*]?/b%20"), "ERR parse \"//[::1*]?/b%20\": invalid host: ParseAddr(\"::1*\"): unexpected character, want colon (at \"*\")"
  assert_eq usum_p("x://^@[fe80::1%25en0]:[.b%2Fc+[)?\#%2F $&'()*+,;="), "ERR parse \"x://^@[fe80::1%25en0]:[.b%2Fc+[)?\": invalid IP-literal"
  assert_eq usum_p("x:[1.2.3.4]b%2Fc*[?b&é\#/%2F%"), "ERR parse \"x:[1.2.3.4]b%2Fc*[?b&é\#/%2F%\": invalid URL escape \"%\""
  assert_eq usum_p("https:///host1:1,host2:2:x@"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"/host1:1,host2:2:x@\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:///host1:1,host2:2:x@ | /host1:1,host2:2:x@ |  | /host1:1,host2:2:x@ |  |  | https:///host1:1,host2:2:x@ | true"
  assert_eq usum_p("s_c:%25.@??b\#%20"), "ERR parse \"s_c:%25.@??b\": first path segment in URL cannot contain colon"
}

test "vectors: parse 12" {
  assert_eq usum_p("https://^!!@[::1@\#/%%2F "), "ERR parse \"https://^!!@[::1@\": net/url: invalid userinfo"
  assert_eq usum_p("http://[fe80::1%en0]%:"), "ERR parse \"http://[fe80::1%en0]%:\": invalid port \"%:\" after host"
  assert_eq usum_p("HTTP://@ser@x%41:8080@"), "opaque=\"\", scheme=\"http\", user=\"@ser@xA\", pass=\"8080\", host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http://%40ser%40xA:8080@ |  |  | / |  |  | http://%40ser%40xA:xxxxx@ | true"
  assert_eq usum_p("mailto:[1.2.3.4]%20=:'!=?b=b\#%2F%20%20\#"), "opaque=\"[1.2.3.4]%20=:'!=\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"b=b\", frag=\"/  \#\", rawfrag=\"%2F%20%20\#\", forcequery=false, omithost=false | mailto:[1.2.3.4]%20=:'!=?b=b\#/%20%20%23 |  | /%20%20%23 | [1.2.3.4]%20=:'!=?b=b |  |  | mailto:[1.2.3.4]%20=:'!=?b=b\#/%20%20%23 | true"
  assert_eq usum_p("http://[1.2.3.4]* /"), "ERR parse \"http://[1.2.3.4]* /\": invalid port \"* \" after host"
  assert_eq usum_p("http:/!p%40w%20@host1:1,host2:2:%38%30%25;p%zz"), "ERR parse \"http:/!p%40w%20@host1:1,host2:2:%38%30%25;p%zz\": invalid URL escape \"%zz\""
  assert_eq usum_p("http://EXAMPLE.org&~%20)??a=1é"), "ERR parse \"http://EXAMPLE.org&~%20)??a=1é\": invalid URL escape \"%20\""
  assert_eq usum_p("https:p%40wu@@[fe80::1%25en0];p~%25\#%2F"), "opaque=\"p%40wu@@[fe80::1%25en0];p~%25\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"/\", rawfrag=\"%2F\", forcequery=false, omithost=false | https:p%40wu@@[fe80::1%25en0];p~%25\#%2F |  | %2F | p%40wu@@[fe80::1%25en0];p~%25 |  |  | https:p%40wu@@[fe80::1%25en0];p~%25\#%2F | true"
  assert_eq usum_p("x://^ser@[fe80::1%en0]]%zz?/=%zz=\#"), "ERR parse \"x://^ser@[fe80::1%en0]]%zz?/=%zz=\": invalid port \"%zz\" after host"
  assert_eq usum_p("x:"), "opaque=\"\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | x: |  |  | / |  |  | x: | true"
  assert_eq usum_p("///[::ffff:1.2.3.4]"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"///[::ffff:1.2.3.4]\", rawpath=\"///[::ffff:1.2.3.4]\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ///[::ffff:1.2.3.4] | ///[::ffff:1.2.3.4] |  | ///[::ffff:1.2.3.4] |  |  | ///[::ffff:1.2.3.4] | false"
  assert_eq usum_p("local_host+%25%zz*)?;/"), "ERR parse \"local_host+%25%zz*)?;/\": invalid URL escape \"%zz\""
  assert_eq usum_p("1x:local_host"), "ERR parse \"1x:local_host\": first path segment in URL cannot contain colon"
  assert_eq usum_p("HTTP://host1:1,host2:2=?+"), "ERR parse \"HTTP://host1:1,host2:2=?+\": invalid port \":1,host2:2=\" after host"
  assert_eq usum_p("a+b.c-d://local_host:80)*//'[ ?%zz\#"), "ERR parse \"a+b.c-d://local_host:80)*//'[ ?%zz\": invalid port \":80)*\" after host"
  assert_eq usum_p("https:?é%20%20="), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"é%20%20=\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:?é%20%20= |  |  | /?é%20%20= |  |  | https:?é%20%20= | true"
  assert_eq usum_p("https:/a b].."), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"/a b]..\", rawpath=\"/a b]..\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | https:/a%20b%5D.. | /a%20b%5D.. |  | /a%20b%5D.. |  |  | https:/a%20b%5D.. | true"
  assert_eq usum_p("1x://!@1.2.3.4~\#é%20%2F\#"), "ERR parse \"1x://!@1.2.3.4~\": first path segment in URL cannot contain colon"
  assert_eq usum_p("//[fe80::1%25en0]*"), "ERR parse \"//[fe80::1%25en0]*\": invalid port \"*\" after host"
  assert_eq usum_p("example.com:xa&//é("), "opaque=\"xa&//é(\", scheme=\"example.com\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | example.com:xa&//é( |  |  | xa&//é( |  |  | example.com:xa&//é( | true"
  assert_eq usum_p("ftp:///x%41/+!!.?/a=1+?"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"/xA/+!!.\", rawpath=\"/x%41/+!!.\", rawq=\"/a=1+?\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:///x%41/+!!.?/a=1+? | /x%41/+!!. |  | /x%41/+!!.?/a=1+? |  |  | ftp:///x%41/+!!.?/a=1+? | true"
  assert_eq usum_p("ftp:///a b"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"/a b\", rawpath=\"/a b\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:///a%20b | /a%20b |  | /a%20b |  |  | ftp:///a%20b | true"
  assert_eq usum_p("//[1.2.3.4]:80:/:%20?a=1"), "ERR parse \"//[1.2.3.4]:80:/:%20?a=1\": invalid port \":80:\" after host"
  assert_eq usum_p("x:EXAMPLE.org:80:.%: /?=a=1/\# f "), "opaque=\"EXAMPLE.org:80:.%: /\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"=a=1/\", frag=\" f \", rawfrag=\" f \", forcequery=false, omithost=false | x:EXAMPLE.org:80:.%: /?=a=1/\#%20f%20 |  | %20f%20 | EXAMPLE.org:80:.%: /?=a=1/ |  |  | x:EXAMPLE.org:80:.%: /?=a=1/\#%20f%20 | true"
  assert_eq usum_p("example.com(%25?"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"example.com(%\", rawpath=\"example.com(%25\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | example.com(%25? | example.com(%25 |  | example.com(%25? |  |  | example.com(%25? | false"
  assert_eq usum_p("s_c:!@@host1:1,host2:2.%25%zz%zz \#"), "ERR parse \"s_c:!@@host1:1,host2:2.%25%zz%zz \": first path segment in URL cannot contain colon"
  assert_eq usum_p("x:u@p%40w@1.2.3.4:%38%30';p]%20.?\#$&'()*+,;="), "opaque=\"u@p%40w@1.2.3.4:%38%30';p]%20.\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"$&'()*+,;=\", rawfrag=\"$&'()*+,;=\", forcequery=true, omithost=false | x:u@p%40w@1.2.3.4:%38%30';p]%20.?\#$&'()*+,;= |  | $&'()*+,;= | u@p%40w@1.2.3.4:%38%30';p]%20.? |  |  | x:u@p%40w@1.2.3.4:%38%30';p]%20.?\#$&'()*+,;= | true"
  assert_eq usum_p("http://a b+*%+!?é\#%20$&'()*+,;=%2F$&'()*+,;="), "ERR parse \"http://a b+*%+!?é\": invalid character \" \" in host name"
  assert_eq usum_p("mailto::%zz['%25"), "opaque=\":%zz['%25\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto::%zz['%25 |  |  | :%zz['%25 |  |  | mailto::%zz['%25 | true"
  assert_eq usum_p("http://EXAMPLE.org:80:%25%zzé&%25"), "ERR parse \"http://EXAMPLE.org:80:%25%zzé&%25\": invalid port \":80:%25%zzé&%25\" after host"
  assert_eq usum_p("1x:/example.com:x%25..é!)%zz"), "ERR parse \"1x:/example.com:x%25..é!)%zz\": first path segment in URL cannot contain colon"
  assert_eq usum_p("//[fe80::1%en0]é?"), "ERR parse \"//[fe80::1%en0]é?\": invalid port \"é\" after host"
  assert_eq usum_p("postgres:///h%C3%A9.%zz;p%20..é??é?"), "ERR parse \"postgres:///h%C3%A9.%zz;p%20..é??é?\": invalid URL escape \"%zz\""
  assert_eq usum_p("//h%C3%A9:é%\#% \#"), "ERR parse \"//h%C3%A9:é%\": invalid port \":é%\" after host"
  assert_eq usum_p("https:?%zzé\#fé/!"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"%zzé\", frag=\"fé/!\", rawfrag=\"fé/!\", forcequery=false, omithost=false | https:?%zzé\#f%C3%A9/! |  | f%C3%A9/! | /?%zzé |  |  | https:?%zzé\#f%C3%A9/! | true"
  assert_eq usum_p("x::?"), "opaque=\":\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | x::? |  |  | :? |  |  | x::? | true"
  assert_eq usum_p("postgres:/x%41%zz%25[//%zz?%20\#é"), "ERR parse \"postgres:/x%41%zz%25[//%zz?%20\": invalid URL escape \"%zz\""
