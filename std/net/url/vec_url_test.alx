  assert_eq esc(")"), ("%29", "%29", ")", ")")
  assert_eq esc("]^?|€Z"), ("%5D%5E%3F%7C%E2%82%ACZ", "%5D%5E%3F%7C%E2%82%ACZ", "]^?|€Z", "]^?|€Z")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("'$`$\x01"), ("%27%24%60%24%01", "%27$%60$%01", "'$`$\x01", "'$`$\x01")
  assert_eq esc("?\x01("), ("%3F%01%28", "%3F%01%28", "?\x01(", "?\x01(")
  assert_eq esc("?*-@(]"), ("%3F%2A-%40%28%5D", "%3F%2A-@%28%5D", "?*-@(]", "?*-@(]")
  assert_eq esc("%zz~\x01%zz:"), ("%25zz~%01%25zz%3A", "%25zz~%01%25zz:", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
