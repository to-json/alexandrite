test "vectors: parse request uri 3" {
  assert_eq usum_rq("mailto:[::1]b%2Fc&['a*\#%2F!"), "opaque=\"[::1]b%2Fc&['a*\#%2F!\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto:[::1]b%2Fc&['a*\#%2F! |  |  | [::1]b%2Fc&['a*\#%2F! |  |  | mailto:[::1]b%2Fc&['a*\#%2F! | true"
  assert_eq usum_rq("HTTP://\#é\#%"), "ERR parse \"HTTP://\#é\#%\": invalid character \"\#\" in host name"
  assert_eq usum_rq("https://[::1]:8080.//b%2Fc\#%20! %"), "ERR parse \"https://[::1]:8080.//b%2Fc\#%20! %\": invalid port \":8080.\" after host"
