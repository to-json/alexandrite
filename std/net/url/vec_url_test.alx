  assert_eq esc("*"), ("%2A", "%2A", "*", "*")
  assert_eq esc("\"~]]^&"), ("%22~%5D%5D%5E%26", "%22~%5D%5D%5E&", "\"~]]^&", "\"~]]^&")
  assert_eq esc("}%2"), ("%7D%252", "%7D%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
