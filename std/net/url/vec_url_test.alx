  assert_eq esc("[}^`"), ("%5B%7D%5E%60", "%5B%7D%5E%60", "[}^`", "[}^`")
  assert_eq esc("?>.>"), ("%3F%3E.%3E", "%3F%3E.%3E", "?>.>", "?>.>")
