  assert_eq usum_rq("file://[::1]+ %?"), "ERR parse \"file://[::1]+ %?\": invalid port \"+ %\" after host"
  assert_eq usum_rq("s_c:/:!u@[::1;p\#"), "ERR parse \"s_c:/:!u@[::1;p\#\": invalid URI for request"
  assert_eq usum_rq("/ftp://x%41/%zz*@?é&bb"), "ERR parse \"/ftp://x%41/%zz*@?é&bb\": invalid URL escape \"%zz\""
  assert_eq usum_rq("////[fe80::1%25en0]?b&?"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"////[fe80::1%en0]\", rawpath=\"////[fe80::1%25en0]\", rawq=\"b&?\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ////[fe80::1%25en0]?b&? | ////[fe80::1%25en0] |  | ////[fe80::1%25en0]?b&? |  |  | ////[fe80::1%25en0]?b&? | false"
