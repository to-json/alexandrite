  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("\#\"é'"), ("%23%22%C3%A9%27", "%23%22%C3%A9%27", "\#\"é'", "\#\"é'")
  assert_eq esc(")@+.'=%zz&"), ("%29%40%2B.%27%3D%25zz%26", "%29@+.%27=%25zz&", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
