  assert_eq esc("."), (".", ".", ".", ".")
  assert_eq esc(",??"), ("%2C%3F%3F", "%2C%3F%3F", ",??", ",??")
  assert_eq esc(": %41}/%zz\\(%2"), ("%3A+%2541%7D%2F%25zz%5C%28%252", ":%20%2541%7D%2F%25zz%5C%28%252", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(hx("3f257a7a2d7e3cff3a7c")), ("%3F%25zz-~%3C%FF%3A%7C", "%3F%25zz-~%3C%FF:%7C", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("-`+{`\x01+|"), ("-%60%2B%7B%60%01%2B%7C", "-%60+%7B%60%01+%7C", "-` {`\x01 |", "-`+{`\x01+|")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(" ~'Z^*<,"), ("+~%27Z%5E%2A%3C%2C", "%20~%27Z%5E%2A%3C%2C", " ~'Z^*<,", " ~'Z^*<,")
