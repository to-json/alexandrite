  assert_eq usum_p("x://example.comé~ .)"), "ERR parse \"x://example.comé~ .)\": invalid character \" \" in host name"
  assert_eq usum_p("//@@[fe80::1%25en0]:80:!*.."), "ERR parse \"//@@[fe80::1%25en0]:80:!*..\": invalid port \":80:!*..\" after host"
  assert_eq usum_p("postgres:/example.com:xb%2Fc@*/"), "opaque=\"\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"/example.com:xb/c@*/\", rawpath=\"/example.com:xb%2Fc@*/\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | postgres:/example.com:xb%2Fc@*/ | /example.com:xb%2Fc@*/ |  | /example.com:xb%2Fc@*/ |  |  | postgres:/example.com:xb%2Fc@*/ | true"
  assert_eq usum_p("s_c://][&?&="), "ERR parse \"s_c://][&?&=\": first path segment in URL cannot contain colon"
  assert_eq usum_p("//1.2.3.4: ( =:a"), "ERR parse \"//1.2.3.4: ( =:a\": invalid port \":a\" after host"
  assert_eq usum_p("http:/1.2.3.4:8080%(%25@ ["), "ERR parse \"http:/1.2.3.4:8080%(%25@ [\": invalid URL escape \"%(%\""
  assert_eq usum_p("ftp:]!*?//"), "opaque=\"]!*\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"//\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:]!*?// |  |  | ]!*?// |  |  | ftp:]!*?// | true"
  assert_eq usum_p("HTTP://[fe80::1%en0]~//?=&"), "ERR parse \"HTTP://[fe80::1%en0]~//?=&\": invalid port \"~\" after host"
  assert_eq usum_p("//x%41*a/b%2Fc"), "ERR parse \"//x%41*a/b%2Fc\": invalid URL escape \"%41\""
  assert_eq usum_p("https:/;p&!("), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"/;p&!(\", rawpath=\"/;p&!(\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | https:/;p&!( | /;p&!( |  | /;p&!( |  |  | https:/;p&!( | true"
  assert_eq usum_p("file:*?%zz%20\#"), "opaque=\"*\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"%zz%20\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | file:*?%zz%20 |  |  | *?%zz%20 |  |  | file:*?%zz%20 | true"
  assert_eq usum_p("[::1]~.."), "ERR parse \"[::1]~..\": first path segment in URL cannot contain colon"
  assert_eq usum_p("https:%20%zz&/%20?&b%zz\#/%!"), "ERR parse \"https:%20%zz&/%20?&b%zz\#/%!\": invalid URL escape \"%!\""
  assert_eq usum_p("x:&.@"), "opaque=\"&.@\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | x:&.@ |  |  | &.@ |  |  | x:&.@ | true"
  assert_eq usum_p("http:EXAMPLE.org?a=1ba=1\#"), "opaque=\"EXAMPLE.org\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"a=1ba=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:EXAMPLE.org?a=1ba=1 |  |  | EXAMPLE.org?a=1ba=1 |  |  | http:EXAMPLE.org?a=1ba=1 | true"
  assert_eq usum_p("x:///EXAMPLE.org.?"), "opaque=\"\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"/EXAMPLE.org.\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | x:///EXAMPLE.org.? | /EXAMPLE.org. |  | /EXAMPLE.org.? |  |  | x:///EXAMPLE.org.? | true"
  assert_eq usum_p("https://example.com!%zz//(&//"), "ERR parse \"https://example.com!%zz//(&//\": invalid URL escape \"%zz\""
  assert_eq usum_p("^^!!@[::1]..b%2Fc.;p\#%é%2F"), "ERR parse \"^^!!@[::1]..b%2Fc.;p\": first path segment in URL cannot contain colon"
  assert_eq usum_p("[fe80::1%25en0]?/b?a=1"), "ERR parse \"[fe80::1%25en0]?/b?a=1\": first path segment in URL cannot contain colon"
  assert_eq usum_p("///up%40w^@[::1]@[é?"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"///up@w^@[::1]@[é\", rawpath=\"///up%40w^@[::1]@[é\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | ///up@w%5E@%5B::1%5D@%5B%C3%A9? | ///up@w%5E@%5B::1%5D@%5B%C3%A9 |  | ///up@w%5E@%5B::1%5D@%5B%C3%A9? |  |  | ///up@w%5E@%5B::1%5D@%5B%C3%A9? | false"
  assert_eq usum_p("http://[::1]:80//:?"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"[::1]:80\", path=\"//:\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | http://[::1]:80//:? | //: |  | //:? | ::1 | 80 | http://[::1]:80//:? | true"
  assert_eq usum_p("postgres:h%C3%A9:80/~\#\#"), "opaque=\"h%C3%A9:80/~\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\#\", rawfrag=\"\#\", forcequery=false, omithost=false | postgres:h%C3%A9:80/~\#%23 |  | %23 | h%C3%A9:80/~ |  |  | postgres:h%C3%A9:80/~\#%23 | true"
  assert_eq usum_p("a+b.c-d://1.2.3.4a)(//?"), "opaque=\"\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"1.2.3.4a)(\", path=\"//\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | a+b.c-d://1.2.3.4a)(//? | // |  | //? | 1.2.3.4a)( |  | a+b.c-d://1.2.3.4a)(//? | true"
  assert_eq usum_p("ftp://host1:1,host2:2 !"), "ERR parse \"ftp://host1:1,host2:2 !\": invalid port \":2 !\" after host"
  assert_eq usum_p("HTTP:///[::ffff:1.2.3.4]="), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"/[::ffff:1.2.3.4]=\", rawpath=\"/[::ffff:1.2.3.4]=\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:///[::ffff:1.2.3.4]= | /[::ffff:1.2.3.4]= |  | /[::ffff:1.2.3.4]= |  |  | http:///[::ffff:1.2.3.4]= | true"
}

