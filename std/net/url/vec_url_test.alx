  assert_eq usum_rq("/x:.%20%20"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/x:.  \", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /x:.%20%20 | /x:.%20%20 |  | /x:.%20%20 |  |  | /x:.%20%20 | false"
  assert_eq usum_rq("/a+b.c-d:[fe80::1%en0]&&. ?&éé\#"), "ERR parse \"/a+b.c-d:[fe80::1%en0]&&. ?&éé\#\": invalid URL escape \"%en\""
