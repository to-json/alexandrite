  assert_eq esc("[é~"), ("%5B%C3%A9~", "%5B%C3%A9~", "[é~", "[é~")
  assert_eq esc("\x01/=%zz "), ("%01%2F%3D%25zz+", "%01%2F=%25zz%20", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("~]/"), ("~%5D%2F", "~%5D%2F", "~]/", "~]/")
  assert_eq esc("\x01"), ("%01", "%01", "\x01", "\x01")
  assert_eq esc("(!"), ("%28%21", "%28%21", "(!", "(!")
  assert_eq esc("&!:€é."), ("%26%21%3A%E2%82%AC%C3%A9.", "&%21:%E2%82%AC%C3%A9.", "&!:€é.", "&!:€é.")
  assert_eq esc("}Z\\0$\\"), ("%7DZ%5C0%24%5C", "%7DZ%5C0$%5C", "}Z\\0$\\", "}Z\\0$\\")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("-&/\x01="), ("-%26%2F%01%3D", "-&%2F%01=", "-&/\x01=", "-&/\x01=")
  assert_eq esc("/%41\#\"<\\"), ("%2F%2541%23%22%3C%5C", "%2F%2541%23%22%3C%5C", "/A\#\"<\\", "/A\#\"<\\")
  assert_eq esc("'%Z"), ("%27%25Z", "%27%25Z", "ERR invalid URL escape \"%Z\"", "ERR invalid URL escape \"%Z\"")
  assert_eq esc("."), (".", ".", ".", ".")
  assert_eq esc("é:"), ("%C3%A9%3A", "%C3%A9:", "é:", "é:")
  assert_eq esc("'_"), ("%27_", "%27_", "'_", "'_")
  assert_eq esc("€<*€\x01-|%:"), ("%E2%82%AC%3C%2A%E2%82%AC%01-%7C%25%3A", "%E2%82%AC%3C%2A%E2%82%AC%01-%7C%25:", "ERR invalid URL escape \"%:\"", "ERR invalid URL escape \"%:\"")
  assert_eq esc("_\x01\\}}_%2\#%2"), ("_%01%5C%7D%7D_%252%23%252", "_%01%5C%7D%7D_%252%23%252", "ERR invalid URL escape \"%2\#\"", "ERR invalid URL escape \"%2\#\"")
  assert_eq esc("€@>€\#>@'%zz"), ("%E2%82%AC%40%3E%E2%82%AC%23%3E%40%27%25zz", "%E2%82%AC@%3E%E2%82%AC%23%3E@%27%25zz", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
