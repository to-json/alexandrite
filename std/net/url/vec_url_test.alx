test "vectors: escaping 1" {
  assert_eq esc(hx("617bff3f29")), ("a%7B%FF%3F%29", "a%7B%FF%3F%29", hx("617bff3f29"), hx("617bff3f29"))
  assert_eq esc("'$%zz*%"), ("%27%24%25zz%2A%25", "%27$%25zz%2A%25", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("-_}[[?%Z€"), ("-_%7D%5B%5B%3F%25Z%E2%82%AC", "-_%7D%5B%5B%3F%25Z%E2%82%AC", "ERR invalid URL escape \"%Z\\xe2\"", "ERR invalid URL escape \"%Z\\xe2\"")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("<\\<[<**^"), ("%3C%5C%3C%5B%3C%2A%2A%5E", "%3C%5C%3C%5B%3C%2A%2A%5E", "<\\<[<**^", "<\\<[<**^")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(";%41:/<;]^€"), ("%3B%2541%3A%2F%3C%3B%5D%5E%E2%82%AC", "%3B%2541:%2F%3C%3B%5D%5E%E2%82%AC", ";A:/<;]^€", ";A:/<;]^€")
  assert_eq esc(hx("7eff5e402660012328")), ("~%FF%5E%40%26%60%01%23%28", "~%FF%5E@&%60%01%23%28", hx("7eff5e402660012328"), hx("7eff5e402660012328"))
  assert_eq esc("[  "), ("%5B++", "%5B%20%20", "[  ", "[  ")
  assert_eq esc("="), ("%3D", "=", "=", "=")
  assert_eq esc(">'/"), ("%3E%27%2F", "%3E%27%2F", ">'/", ">'/")
  assert_eq esc(";\x01"), ("%3B%01", "%3B%01", ";\x01", ";\x01")
  assert_eq esc(")%41"), ("%29%2541", "%29%2541", ")A", ")A")
  assert_eq esc(" 0+)€"), ("+0%2B%29%E2%82%AC", "%200+%29%E2%82%AC", " 0 )€", " 0+)€")
  assert_eq esc("!\x01@%zz{'"), ("%21%01%40%25zz%7B%27", "%21%01@%25zz%7B%27", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("(>}?"), ("%28%3E%7D%3F", "%28%3E%7D%3F", "(>}?", "(>}?")
  assert_eq esc("*!=;)]_0"), ("%2A%21%3D%3B%29%5D_0", "%2A%21=%3B%29%5D_0", "*!=;)]_0", "*!=;)]_0")
  assert_eq esc(")%>]]&}"), ("%29%25%3E%5D%5D%26%7D", "%29%25%3E%5D%5D&%7D", "ERR invalid URL escape \"%>]\"", "ERR invalid URL escape \"%>]\"")
  assert_eq esc("!\x01@+a\x01Z`{"), ("%21%01%40%2Ba%01Z%60%7B", "%21%01@+a%01Z%60%7B", "!\x01@ a\x01Z`{", "!\x01@+a\x01Z`{")
  assert_eq esc("Za(@!\\@%2"), ("Za%28%40%21%5C%40%252", "Za%28@%21%5C@%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc("$\"<%'"), ("%24%22%3C%25%27", "$%22%3C%25%27", "ERR invalid URL escape \"%'\"", "ERR invalid URL escape \"%'\"")
  assert_eq esc("?é<$$\".~."), ("%3F%C3%A9%3C%24%24%22.~.", "%3F%C3%A9%3C$$%22.~.", "?é<$$\".~.", "?é<$$\".~.")
  assert_eq esc("€-"), ("%E2%82%AC-", "%E2%82%AC-", "€-", "€-")
  assert_eq esc("~^{\"`\"|"), ("~%5E%7B%22%60%22%7C", "~%5E%7B%22%60%22%7C", "~^{\"`\"|", "~^{\"`\"|")
  assert_eq esc(hx("2e3c2826c3a92532ff")), (".%3C%28%26%C3%A9%252%FF", ".%3C%28&%C3%A9%252%FF", "ERR invalid URL escape \"%2\\xff\"", "ERR invalid URL escape \"%2\\xff\"")
  assert_eq esc(";!^|;*,^"), ("%3B%21%5E%7C%3B%2A%2C%5E", "%3B%21%5E%7C%3B%2A%2C%5E", ";!^|;*,^", ";!^|;*,^")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("$'%41(%2+|*a"), ("%24%27%2541%28%252%2B%7C%2Aa", "$%27%2541%28%252+%7C%2Aa", "ERR invalid URL escape \"%2+\"", "ERR invalid URL escape \"%2+\"")
  assert_eq esc("<(\#%zz"), ("%3C%28%23%25zz", "%3C%28%23%25zz", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
