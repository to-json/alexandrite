# Generated from Go's net/url (go run, Go 1.27): parsing, formatting, escaping, references and queries; do not edit by hand.

test "vectors: parse" {
  assert_eq usum_p("http://EXAMPLE.orgb%2Fc@?éa=1éé"), "opaque=\"\", scheme=\"http\", user=\"EXAMPLE.orgb/c\", pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"éa=1éé\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http://EXAMPLE.orgb%2Fc@?éa=1éé |  |  | /?éa=1éé |  |  | http://EXAMPLE.orgb%2Fc@?éa=1éé | true"
  assert_eq usum_p("a+b.c-d:/a b[..%%]+?;b?"), "ERR parse \"a+b.c-d:/a b[..%%]+?;b?\": invalid URL escape \"%%]\""
  assert_eq usum_p("http:/[::ffff:1.2.3.4]:80:%(\#é  \#"), "ERR parse \"http:/[::ffff:1.2.3.4]:80:%(\": invalid URL escape \"%(\""
  assert_eq usum_p("file:&%25\#$&'()*+,;=$&'()*+,;="), "opaque=\"&%25\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"$&'()*+,;=$&'()*+,;=\", rawfrag=\"$&'()*+,;=$&'()*+,;=\", forcequery=false, omithost=false | file:&%25\#$&'()*+,;=$&'()*+,;= |  | $&'()*+,;=$&'()*+,;= | &%25 |  |  | file:&%25\#$&'()*+,;=$&'()*+,;= | true"
  assert_eq usum_p("postgres:%20++//"), "opaque=\"%20++//\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | postgres:%20++// |  |  | %20++// |  |  | postgres:%20++// | true"
  assert_eq usum_p("x://:xb%2Fc/éé?é+;a=1\#%"), "ERR parse \"x://:xb%2Fc/éé?é+;a=1\": invalid port \":xb%2Fc\" after host"
  assert_eq usum_p("x:///1.2.3.4%zz;p%25~b%2Fc;p"), "ERR parse \"x:///1.2.3.4%zz;p%25~b%2Fc;p\": invalid URL escape \"%zz\""
  assert_eq usum_p("1x://p%40wser^@[::1]:80:.?é+;="), "ERR parse \"1x://p%40wser^@[::1]:80:.?é+;=\": first path segment in URL cannot contain colon"
  assert_eq usum_p("http://example.com.."), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"example.com..\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http://example.com.. |  |  | / | example.com.. |  | http://example.com.. | true"
  assert_eq usum_p("///:^^p%40w@local_host:?"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"///:^^p@w@local_host:\", rawpath=\"///:^^p%40w@local_host:\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | ///:%5E%5Ep@w@local_host:? | ///:%5E%5Ep@w@local_host: |  | ///:%5E%5Ep@w@local_host:? |  |  | ///:%5E%5Ep@w@local_host:? | false"
  assert_eq usum_p("http:///!p%40wp%40wu@[::1:80 &é..%zz\#/ "), "ERR parse \"http:///!p%40wp%40wu@[::1:80 &é..%zz\": invalid URL escape \"%zz\""
  assert_eq usum_p("http://[::1]\#"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"[::1]\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http://[::1] |  |  | / | ::1 |  | http://[::1] | true"
  assert_eq usum_p("?b"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"b\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ?b |  |  | /?b |  |  | ?b | false"
  assert_eq usum_p("mailto:///[1.2.3.4]!=)=%?a=1;=?"), "ERR parse \"mailto:///[1.2.3.4]!=)=%?a=1;=?\": invalid URL escape \"%\""
  assert_eq usum_p("s_c://!@[fe80::1%en0]??%zz"), "ERR parse \"s_c://!@[fe80::1%en0]??%zz\": first path segment in URL cannot contain colon"
  assert_eq usum_p("http:///p%40w%20@host1:1,host2:2:%38%30(=&"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"/p@w @host1:1,host2:2:80(=&\", rawpath=\"/p%40w%20@host1:1,host2:2:%38%30(=&\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:///p%40w%20@host1:1,host2:2:%38%30(=& | /p%40w%20@host1:1,host2:2:%38%30(=& |  | /p%40w%20@host1:1,host2:2:%38%30(=& |  |  | http:///p%40w%20@host1:1,host2:2:%38%30(=& | true"
  assert_eq usum_p("///a\#/%f"), "ERR parse \"///a\#/%f\": invalid URL escape \"%f\""
  assert_eq usum_p("a+b.c-d:%('[...."), "opaque=\"%('[....\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:%('[.... |  |  | %('[.... |  |  | a+b.c-d:%('[.... | true"
  assert_eq usum_p("'* "), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"'* \", rawpath=\"'* \", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | %27%2A%20 | %27%2A%20 |  | %27%2A%20 |  |  | %27%2A%20 | false"
  assert_eq usum_p("mailto:/[1.2.3.4](..b%2Fc"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"/[1.2.3.4](..b/c\", rawpath=\"/[1.2.3.4](..b%2Fc\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | mailto:/[1.2.3.4](..b%2Fc | /[1.2.3.4](..b%2Fc |  | /[1.2.3.4](..b%2Fc |  |  | mailto:/[1.2.3.4](..b%2Fc | true"
  assert_eq usum_p("&%25/\#/\#"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"&%/\", rawpath=\"\", rawq=\"\", frag=\"/\#\", rawfrag=\"/\#\", forcequery=false, omithost=false | &%25/\#/%23 | &%25/ | /%23 | &%25/ |  |  | &%25/\#/%23 | false"
  assert_eq usum_p("https://[fe80::1%en0]a??bb"), "ERR parse \"https://[fe80::1%en0]a??bb\": invalid port \"a\" after host"
  assert_eq usum_p("a+b.c-d:[::1]:%*é\#$&'()*+,;=f"), "opaque=\"[::1]:%*é\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"$&'()*+,;=f\", rawfrag=\"$&'()*+,;=f\", forcequery=false, omithost=false | a+b.c-d:[::1]:%*é\#$&'()*+,;=f |  | $&'()*+,;=f | [::1]:%*é |  |  | a+b.c-d:[::1]:%*é\#$&'()*+,;=f | true"
  assert_eq usum_p("http:/1.2.3.4&(\#f"), "opaque=\"\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"/1.2.3.4&(\", rawpath=\"/1.2.3.4&(\", rawq=\"\", frag=\"f\", rawfrag=\"\", forcequery=false, omithost=true | http:/1.2.3.4&(\#f | /1.2.3.4&( | f | /1.2.3.4&( |  |  | http:/1.2.3.4&(\#f | true"
  assert_eq usum_p("HTTP:%?\#"), "opaque=\"%\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | http:%? |  |  | %? |  |  | http:%? | true"
  assert_eq usum_p("https:[%zz."), "opaque=\"[%zz.\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:[%zz. |  |  | [%zz. |  |  | https:[%zz. | true"
  assert_eq usum_p("ftp:///[::1+%%?a=1;"), "ERR parse \"ftp:///[::1+%%?a=1;\": invalid URL escape \"%%\""
  assert_eq usum_p("https:///[::ffff:1.2.3.4]!a./:;p\#é"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"/[::ffff:1.2.3.4]!a./:;p\", rawpath=\"/[::ffff:1.2.3.4]!a./:;p\", rawq=\"\", frag=\"é\", rawfrag=\"é\", forcequery=false, omithost=false | https:///[::ffff:1.2.3.4]!a./:;p\#%C3%A9 | /[::ffff:1.2.3.4]!a./:;p | %C3%A9 | /[::ffff:1.2.3.4]!a./:;p |  |  | https:///[::ffff:1.2.3.4]!a./:;p\#%C3%A9 | true"
  assert_eq usum_p("/h%C3%A9~b%2Fcb%2Fc*'?b/\#/%20%20"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/hé~b/cb/c*'\", rawpath=\"/h%C3%A9~b%2Fcb%2Fc*'\", rawq=\"b/\", frag=\"/  \", rawfrag=\"\", forcequery=false, omithost=false | /h%C3%A9~b%2Fcb%2Fc*'?b/\#/%20%20 | /h%C3%A9~b%2Fcb%2Fc*' | /%20%20 | /h%C3%A9~b%2Fcb%2Fc*'?b/ |  |  | /h%C3%A9~b%2Fcb%2Fc*'?b/\#/%20%20 | false"
  assert_eq usum_p("file:"), "opaque=\"\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | file: |  |  | / |  |  | file: | true"
  assert_eq usum_p("file:[::1:%zz~;p~+a?+\#%20"), "opaque=\"[::1:%zz~;p~+a\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"+\", frag=\" \", rawfrag=\"\", forcequery=false, omithost=false | file:[::1:%zz~;p~+a?+\#%20 |  | %20 | [::1:%zz~;p~+a?+ |  |  | file:[::1:%zz~;p~+a?+\#%20 | true"
  assert_eq usum_p("mailto:///local_host\#\#é"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"/local_host\", rawpath=\"\", rawq=\"\", frag=\"\#é\", rawfrag=\"\#é\", forcequery=false, omithost=false | mailto:///local_host\#%23%C3%A9 | /local_host | %23%C3%A9 | /local_host |  |  | mailto:///local_host\#%23%C3%A9 | true"
  assert_eq usum_p("a+b.c-d://:@[::ffff:1.2.3.4]:8080!@?/;"), "ERR parse \"a+b.c-d://:@[::ffff:1.2.3.4]:8080!@?/;\": net/url: invalid userinfo"
  assert_eq usum_p("postgres://^@[::ffff:1.2.3.4]:80."), "ERR parse \"postgres://^@[::ffff:1.2.3.4]:80.\": invalid port \":80.\" after host"
  assert_eq usum_p("postgres://!@!:@example.com:x..+;p("), "ERR parse \"postgres://!@!:@example.com:x..+;p(\": invalid port \":x..+;p(\" after host"
  assert_eq usum_p("https:/h%C3%A9:%38%30a(%20a'.."), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"/hé:80a( a'..\", rawpath=\"/h%C3%A9:%38%30a(%20a'..\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | https:/h%C3%A9:%38%30a(%20a'.. | /h%C3%A9:%38%30a(%20a'.. |  | /h%C3%A9:%38%30a(%20a'.. |  |  | https:/h%C3%A9:%38%30a(%20a'.. | true"
  assert_eq usum_p("a//')+!?b/=\#  \#"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"a//')+!\", rawpath=\"a//')+!\", rawq=\"b/=\", frag=\"  \#\", rawfrag=\"  \#\", forcequery=false, omithost=false | a//')+!?b/=\#%20%20%23 | a//')+! | %20%20%23 | a//')+!?b/= |  |  | a//')+!?b/=\#%20%20%23 | false"
  assert_eq usum_p(")+//.!\#%2F"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\")+//.!\", rawpath=\")+//.!\", rawq=\"\", frag=\"/\", rawfrag=\"%2F\", forcequery=false, omithost=false | )+//.!\#%2F | )+//.! | %2F | )+//.! |  |  | )+//.!\#%2F | false"
  assert_eq usum_p("]??&/;\#$&'()*+,;=\#%20"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"]\", rawpath=\"]\", rawq=\"?&/;\", frag=\"$&'()*+,;=\# \", rawfrag=\"$&'()*+,;=\#%20\", forcequery=false, omithost=false | ]??&/;\#$&%27()*+,;=%23%20 | ] | $&%27()*+,;=%23%20 | ]??&/; |  |  | ]??&/;\#$&%27()*+,;=%23%20 | false"
  assert_eq usum_p("s_c:///a b:8080+%20;p&a?+%20/\#!\#%20%20"), "ERR parse \"s_c:///a b:8080+%20;p&a?+%20/\": first path segment in URL cannot contain colon"
  assert_eq usum_p("mailto:&%zz%zz..+"), "opaque=\"&%zz%zz..+\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto:&%zz%zz..+ |  |  | &%zz%zz..+ |  |  | mailto:&%zz%zz..+ | true"
  assert_eq usum_p("mailto:x%41;p%20;p] //?;é+"), "opaque=\"x%41;p%20;p] //\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\";é+\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto:x%41;p%20;p] //?;é+ |  |  | x%41;p%20;p] //?;é+ |  |  | mailto:x%41;p%20;p] //?;é+ | true"
  assert_eq usum_p("ftp:/[fe80::1%25en0](=a\#"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"/[fe80::1%en0](=a\", rawpath=\"/[fe80::1%25en0](=a\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | ftp:/[fe80::1%25en0](=a | /[fe80::1%25en0](=a |  | /[fe80::1%25en0](=a |  |  | ftp:/[fe80::1%25en0](=a | true"
  assert_eq usum_p("postgres://%20p%40w@[::1]:x!%20]"), "ERR parse \"postgres://%20p%40w@[::1]:x!%20]\": invalid URL escape \"%20\""
  assert_eq usum_p("//h%C3%A9:80]=:%zz@//"), "ERR parse \"//h%C3%A9:80]=:%zz@//\": net/url: invalid userinfo"
  assert_eq usum_p("ftp:?/é;%20"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"/é;%20\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:?/é;%20 |  |  | /?/é;%20 |  |  | ftp:?/é;%20 | true"
  assert_eq usum_p("postgres://@@@h%C3%A9"), "opaque=\"\", scheme=\"postgres\", user=\"@@\", pass=nil, host=\"hé\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | postgres://%40%40@h%C3%A9 |  |  | / | hé |  | postgres://%40%40@h%C3%A9 | true"
  assert_eq usum_p("//[::1]'(%%@"), "ERR parse \"//[::1]'(%%@\": net/url: invalid userinfo"
  assert_eq usum_p("ftp://u@[::1:80:&%zz:(@@?%zza=1&%zz"), "ERR parse \"ftp://u@[::1:80:&%zz:(@@?%zza=1&%zz\": net/url: invalid userinfo"
  assert_eq usum_p("ftp:"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp: |  |  | / |  |  | ftp: | true"
  assert_eq usum_p("é&%zz&b%2Fc?bé??\#/ "), "ERR parse \"é&%zz&b%2Fc?bé??\": invalid URL escape \"%zz\""
  assert_eq usum_p("s_c:///:@local_hosté?%20/%20"), "ERR parse \"s_c:///:@local_hosté?%20/%20\": first path segment in URL cannot contain colon"
  assert_eq usum_p("//h%C3%A9/\#%20//"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"hé\", path=\"/\", rawpath=\"\", rawq=\"\", frag=\" //\", rawfrag=\"\", forcequery=false, omithost=false | //h%C3%A9/\#%20// | / | %20// | / | hé |  | //h%C3%A9/\#%20// | false"
  assert_eq usum_p("https:=!//~?+=?\#"), "opaque=\"=!//~\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"+=?\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:=!//~?+=? |  |  | =!//~?+=? |  |  | https:=!//~?+=? | true"
  assert_eq usum_p("s_c:/x%41!+..?b"), "ERR parse \"s_c:/x%41!+..?b\": first path segment in URL cannot contain colon"
  assert_eq usum_p("a+b.c-d:=.a[?/"), "opaque=\"=.a[\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"/\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:=.a[?/ |  |  | =.a[?/ |  |  | a+b.c-d:=.a[?/ | true"
  assert_eq usum_p("//h%C3%A9:%38%30//=b%2Fc]%zz?&a=1"), "ERR parse \"//h%C3%A9:%38%30//=b%2Fc]%zz?&a=1\": invalid port \":%38%30\" after host"
  assert_eq usum_p("//@p%40wser@example.com:8080:?;%zz%20\#%20$&'()*+,;=%\#"), "ERR parse \"//@p%40wser@example.com:8080:?;%zz%20\#%20$&'()*+,;=%\#\": invalid URL escape \"%\#\""
  assert_eq usum_p("1x://[::ffff:1.2.3.4]:8080;p?b="), "ERR parse \"1x://[::ffff:1.2.3.4]:8080;p?b=\": first path segment in URL cannot contain colon"
  assert_eq usum_p("//a b![ .?%20%20+?"), "ERR parse \"//a b![ .?%20%20+?\": invalid IP-literal"
  assert_eq usum_p("s_c://@@[::ffff:1.2.3.4]:x//?"), "ERR parse \"s_c://@@[::ffff:1.2.3.4]:x//?\": first path segment in URL cannot contain colon"
  assert_eq usum_p("+é"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"+é\", rawpath=\"+é\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | +%C3%A9 | +%C3%A9 |  | +%C3%A9 |  |  | +%C3%A9 | false"
  assert_eq usum_p("ftp:*//&?;"), "opaque=\"*//&\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\";\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:*//&?; |  |  | *//&?; |  |  | ftp:*//&?; | true"
  assert_eq usum_p("s_c:%zz\#\#"), "ERR parse \"s_c:%zz\": first path segment in URL cannot contain colon"
  assert_eq usum_p("/=!+\#/ "), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/=!+\", rawpath=\"/=!+\", rawq=\"\", frag=\"/ \", rawfrag=\"/ \", forcequery=false, omithost=false | /=!+\#/%20 | /=!+ | /%20 | /=!+ |  |  | /=!+\#/%20 | false"
  assert_eq usum_p("ftp:/x%41*%20?"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"/xA* \", rawpath=\"/x%41*%20\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=true | ftp:/x%41*%20? | /x%41*%20 |  | /x%41*%20? |  |  | ftp:/x%41*%20? | true"
  assert_eq usum_p("s_c:/%20@h%C3%A9b%2Fcé*?%20\#"), "ERR parse \"s_c:/%20@h%C3%A9b%2Fcé*?%20\": first path segment in URL cannot contain colon"
  assert_eq usum_p("a+b.c-d:]@%"), "opaque=\"]@%\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:]@% |  |  | ]@% |  |  | a+b.c-d:]@% | true"
  assert_eq usum_p("//host1:1,host2:2'/]@?+"), "ERR parse \"//host1:1,host2:2'/]@?+\": invalid port \":2'\" after host"
  assert_eq usum_p("postgres:/[fe80::1%en0]:%38%30\#\#%20$&'()*+,;="), "ERR parse \"postgres:/[fe80::1%en0]:%38%30\": invalid URL escape \"%en\""
  assert_eq usum_p("file:[::ffff:1.2.3.4]%25%zz"), "opaque=\"[::ffff:1.2.3.4]%25%zz\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | file:[::ffff:1.2.3.4]%25%zz |  |  | [::ffff:1.2.3.4]%25%zz |  |  | file:[::ffff:1.2.3.4]%25%zz | true"
  assert_eq usum_p("https:///ser!@!@[fe80::1%en0]é\#/é/ "), "ERR parse \"https:///ser!@!@[fe80::1%en0]é\": invalid URL escape \"%en\""
  assert_eq usum_p("s_c://ser@[fe80::1%25en0]))&%25"), "ERR parse \"s_c://ser@[fe80::1%25en0]))&%25\": first path segment in URL cannot contain colon"
  assert_eq usum_p("http:/^@example.com///;p@%20??%20?\#%%!!"), "ERR parse \"http:/^@example.com///;p@%20??%20?\#%%!!\": invalid URL escape \"%%!\""
  assert_eq usum_p("s_c:/:%20?"), "ERR parse \"s_c:/:%20?\": first path segment in URL cannot contain colon"
  assert_eq usum_p("s_c:///example.com;p(@\#"), "ERR parse \"s_c:///example.com;p(@\": first path segment in URL cannot contain colon"
  assert_eq usum_p("ftp:%20%20@local_host%20=']%zz?b&%zza=1"), "opaque=\"%20%20@local_host%20=']%zz\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"b&%zza=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:%20%20@local_host%20=']%zz?b&%zza=1 |  |  | %20%20@local_host%20=']%zz?b&%zza=1 |  |  | ftp:%20%20@local_host%20=']%zz?b&%zza=1 | true"
  assert_eq usum_p("a+b.c-d:.]&a%20~\#/f "), "opaque=\".]&a%20~\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"/f \", rawfrag=\"/f \", forcequery=false, omithost=false | a+b.c-d:.]&a%20~\#/f%20 |  | /f%20 | .]&a%20~ |  |  | a+b.c-d:.]&a%20~\#/f%20 | true"
  assert_eq usum_p("a+b.c-d:[::1]&] !/%20?a=1"), "opaque=\"[::1]&] !/%20\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"a=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | a+b.c-d:[::1]&] !/%20?a=1 |  |  | [::1]&] !/%20?a=1 |  |  | a+b.c-d:[::1]&] !/%20?a=1 | true"
  assert_eq usum_p("//EXAMPLE.org:8080)&?é&é\#f"), "ERR parse \"//EXAMPLE.org:8080)&?é&é\": invalid port \":8080)&\" after host"
  assert_eq usum_p("mailto:///h%C3%A9:~.b%2Fc&:\#é"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"/hé:~.b/c&:\", rawpath=\"/h%C3%A9:~.b%2Fc&:\", rawq=\"\", frag=\"é\", rawfrag=\"é\", forcequery=false, omithost=false | mailto:///h%C3%A9:~.b%2Fc&:\#%C3%A9 | /h%C3%A9:~.b%2Fc&: | %C3%A9 | /h%C3%A9:~.b%2Fc&: |  |  | mailto:///h%C3%A9:~.b%2Fc&:\#%C3%A9 | true"
  assert_eq usum_p("*[.~"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"*[.~\", rawpath=\"*[.~\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | *[.~ | *[.~ |  | *[.~ |  |  | *[.~ | false"
  assert_eq usum_p("x:///h%C3%A9?/é="), "opaque=\"\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"/hé\", rawpath=\"\", rawq=\"/é=\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | x:///h%C3%A9?/é= | /h%C3%A9 |  | /h%C3%A9?/é= |  |  | x:///h%C3%A9?/é= | true"
  assert_eq usum_p("file:[::ffff:1.2.3.4]:80:[?\# %\#$&'()*+,;="), "ERR parse \"file:[::ffff:1.2.3.4]:80:[?\# %\#$&'()*+,;=\": invalid URL escape \"%\#$\""
  assert_eq usum_p("mailto://[1.2.3.4];p(.\#%éé"), "ERR parse \"mailto://[1.2.3.4];p(.\": invalid port \";p(.\" after host"
  assert_eq usum_p("//!^ser@[::ffff:1.2.3.4]...!]"), "ERR parse \"//!^ser@[::ffff:1.2.3.4]...!]\": invalid host: ParseAddr(\"::ffff:1.2.3.4]...!\"): unexpected character (at \"]...!\")"
  assert_eq usum_p(": é.."), "ERR parse \": é..\": missing protocol scheme"
  assert_eq usum_p("x:///x%41@"), "opaque=\"\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"/xA@\", rawpath=\"/x%41@\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | x:///x%41@ | /x%41@ |  | /x%41@ |  |  | x:///x%41@ | true"
  assert_eq usum_p("postgres:;p[..?b%20?\#/!/$&'()*+,;="), "opaque=\";p[..\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"b%20?\", frag=\"/!/$&'()*+,;=\", rawfrag=\"/!/$&'()*+,;=\", forcequery=false, omithost=false | postgres:;p[..?b%20?\#/!/$&'()*+,;= |  | /!/$&'()*+,;= | ;p[..?b%20? |  |  | postgres:;p[..?b%20?\#/!/$&'()*+,;= | true"
  assert_eq usum_p("s_c://[fe80::1%en0].// "), "ERR parse \"s_c://[fe80::1%en0].// \": first path segment in URL cannot contain colon"
  assert_eq usum_p("HTTP:/!@[fe80::1%en0]:\#!%"), "ERR parse \"HTTP:/!@[fe80::1%en0]:\": invalid URL escape \"%en\""
  assert_eq usum_p("s_c:=a@:"), "ERR parse \"s_c:=a@:\": first path segment in URL cannot contain colon"
  assert_eq usum_p("http://1.2.3.4 @\#é\#/%20"), "ERR parse \"http://1.2.3.4 @\": net/url: invalid userinfo"
  assert_eq usum_p("s_c:///!p%40w@ser@[::1//(\#é"), "ERR parse \"s_c:///!p%40w@ser@[::1//(\": first path segment in URL cannot contain colon"
  assert_eq usum_p("file://:%20@[1.2.3.4]?"), "ERR parse \"file://:%20@[1.2.3.4]?\": invalid IP-literal"
  assert_eq usum_p("file://local_host:80:b%2Fc=/(//=?/"), "ERR parse \"file://local_host:80:b%2Fc=/(//=?/\": invalid port \":b%2Fc=\" after host"
  assert_eq usum_p("postgres://[::ffff:1.2.3.4]=)???;+"), "ERR parse \"postgres://[::ffff:1.2.3.4]=)???;+\": invalid port \"=)\" after host"
  assert_eq usum_p("mailto:\#%20é"), "opaque=\"\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\" é\", rawfrag=\"%20é\", forcequery=false, omithost=false | mailto:\#%20%C3%A9 |  | %20%C3%A9 | / |  |  | mailto:\#%20%C3%A9 | true"
  assert_eq usum_p("file:///[fe80::1%en0]+!]=%20]?%20"), "ERR parse \"file:///[fe80::1%en0]+!]=%20]?%20\": invalid URL escape \"%en\""
  assert_eq usum_p("userser@a b%]~  +"), "ERR parse \"userser@a b%]~  +\": invalid URL escape \"%]~\""
}

test "vectors: parse 1" {
