  assert_eq esc("."), (".", ".", ".", ".")
  assert_eq esc("[_€_?,:"), ("%5B_%E2%82%AC_%3F%2C%3A", "%5B_%E2%82%AC_%3F%2C:", "[_€_?,:", "[_€_?,:")
  assert_eq esc(",%2&"), ("%2C%252%26", "%2C%252&", "ERR invalid URL escape \"%2&\"", "ERR invalid URL escape \"%2&\"")
  assert_eq esc(" *`Z"), ("+%2A%60Z", "%20%2A%60Z", " *`Z", " *`Z")
  assert_eq esc(":(?`0%+::"), ("%3A%28%3F%600%25%2B%3A%3A", ":%28%3F%600%25+::", "ERR invalid URL escape \"%+:\"", "ERR invalid URL escape \"%+:\"")
  assert_eq esc("&`=€==/\x01"), ("%26%60%3D%E2%82%AC%3D%3D%2F%01", "&%60=%E2%82%AC==%2F%01", "&`=€==/\x01", "&`=€==/\x01")
  assert_eq esc("\x01"), ("%01", "%01", "\x01", "\x01")
  assert_eq esc(hx("ff3d285f2f5b5b2f")), ("%FF%3D%28_%2F%5B%5B%2F", "%FF=%28_%2F%5B%5B%2F", hx("ff3d285f2f5b5b2f"), hx("ff3d285f2f5b5b2f"))
  assert_eq esc("0|"), ("0%7C", "0%7C", "0|", "0|")
  assert_eq esc("[<>\x01"), ("%5B%3C%3E%01", "%5B%3C%3E%01", "[<>\x01", "[<>\x01")
}

