test "vectors: parse 3" {
  assert_eq usum_p("a+b.c-d:/a b;p ~= .?"), "opaque=\"\", scheme=\"a+b.c-d\", user=nil, pass=nil, host=\"\", path=\"/a b;p ~= .\", rawpath=\"/a b;p ~= .\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=true | a+b.c-d:/a%20b;p%20~=%20.? | /a%20b;p%20~=%20. |  | /a%20b;p%20~=%20.? |  |  | a+b.c-d:/a%20b;p%20~=%20.? | true"
  assert_eq usum_p("ftp:///local_host:%38%30%]]..?"), "ERR parse \"ftp:///local_host:%38%30%]]..?\": invalid URL escape \"%]]\""
  assert_eq usum_p("ftp://[::1]?\#"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"[::1]\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | ftp://[::1]? |  |  | /? | ::1 |  | ftp://[::1]? | true"
  assert_eq usum_p("HTTP:%25a:%zza"), "opaque=\"%25a:%zza\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:%25a:%zza |  |  | %25a:%zza |  |  | http:%25a:%zza | true"
