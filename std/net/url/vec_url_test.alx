test "vectors: parse request uri 1" {
  assert_eq usum_rq("HTTP:ser@[::ffff:1.2.3.4]..)*//;p..?;a=1+/"), "opaque=\"ser@[::ffff:1.2.3.4]..)*//;p..\", scheme=\"http\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\";a=1+/\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | http:ser@[::ffff:1.2.3.4]..)*//;p..?;a=1+/ |  |  | ser@[::ffff:1.2.3.4]..)*//;p..?;a=1+/ |  |  | http:ser@[::ffff:1.2.3.4]..)*//;p..?;a=1+/ | true"
  assert_eq usum_rq("/postgres:[::1]'"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/postgres:[::1]'\", rawpath=\"/postgres:[::1]'\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /postgres:[::1]' | /postgres:[::1]' |  | /postgres:[::1]' |  |  | /postgres:[::1]' | false"
  assert_eq usum_rq("/HTTP:?\#/fé"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/HTTP:\", rawpath=\"\", rawq=\"\#/fé\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /HTTP:?\#/fé | /HTTP: |  | /HTTP:?\#/fé |  |  | /HTTP:?\#/fé | false"
  assert_eq usum_rq("mailto:=\#%2F\#$&'()*+,;=/"), "opaque=\"=\#%2F\#$&'()*+,;=/\", scheme=\"mailto\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | mailto:=\#%2F\#$&'()*+,;=/ |  |  | =\#%2F\#$&'()*+,;=/ |  |  | mailto:=\#%2F\#$&'()*+,;=/ | true"
  assert_eq usum_rq("/x://up%40wp%40wu@1.2.3.4~/()'?%20\#"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/x://up@wp@wu@1.2.3.4~/()'\", rawpath=\"/x://up%40wp%40wu@1.2.3.4~/()'\", rawq=\"%20\#\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /x://up%40wp%40wu@1.2.3.4~/()'?%20\# | /x://up%40wp%40wu@1.2.3.4~/()' |  | /x://up%40wp%40wu@1.2.3.4~/()'?%20\# |  |  | /x://up%40wp%40wu@1.2.3.4~/()'?%20\# | false"
