test "vectors: parse 6" {
  assert_eq usum_p("ftp:%zz%25%=%25]?%20%zzé?"), "opaque=\"%zz%25%=%25]\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"%20%zzé?\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:%zz%25%=%25]?%20%zzé? |  |  | %zz%25%=%25]?%20%zzé? |  |  | ftp:%zz%25%=%25]?%20%zzé? | true"
  assert_eq usum_p("?+/+"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"+/+\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ?+/+ |  |  | /?+/+ |  |  | ?+/+ | false"
  assert_eq usum_p("file:/[1.2.3.4]?b"), "opaque=\"\", scheme=\"file\", user=nil, pass=nil, host=\"\", path=\"/[1.2.3.4]\", rawpath=\"/[1.2.3.4]\", rawq=\"b\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | file:/[1.2.3.4]?b | /[1.2.3.4] |  | /[1.2.3.4]?b |  |  | file:/[1.2.3.4]?b | true"
  assert_eq usum_p("//[fe80::1%25en0]:80:?&éb"), "ERR parse \"//[fe80::1%25en0]:80:?&éb\": invalid port \":80:\" after host"
  assert_eq usum_p("postgres:a//b%2Fc?"), "opaque=\"a//b%2Fc\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | postgres:a//b%2Fc? |  |  | a//b%2Fc? |  |  | postgres:a//b%2Fc? | true"
  assert_eq usum_p("https:a.+%+\#%%%2F"), "ERR parse \"https:a.+%+\#%%%2F\": invalid URL escape \"%%%\""
  assert_eq usum_p("1x:!/[[]~?\#é \#%"), "ERR parse \"1x:!/[[]~?\": first path segment in URL cannot contain colon"
