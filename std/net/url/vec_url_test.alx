  assert_eq usum_p("ftp:."), "opaque=\".\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ftp:. |  |  | . |  |  | ftp:. | true"
