  assert_eq usum_p("https://[fe80::1%en0])&%20(:"), "ERR parse \"https://[fe80::1%en0])&%20(:\": invalid port \")&%20(:\" after host"
  assert_eq usum_p("1x://b%2Fc?/"), "ERR parse \"1x://b%2Fc?/\": first path segment in URL cannot contain colon"
  assert_eq usum_p("postgres://@%20@h%C3%A9;p @*?a=1\#$&'()*+,;=é%$&'()*+,;="), "ERR parse \"postgres://@%20@h%C3%A9;p @*?a=1\": net/url: invalid userinfo"
  assert_eq usum_p("x:(:(?"), "opaque=\"(:(\", scheme=\"x\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=true, omithost=false | x:(:(? |  |  | (:(? |  |  | x:(:(? | true"
