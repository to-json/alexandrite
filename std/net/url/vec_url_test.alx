  assert_eq usum_rq("///host1:1,host2:2]*b%2Fc?ba=1?\#"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"///host1:1,host2:2]*b/c\", rawpath=\"///host1:1,host2:2]*b%2Fc\", rawq=\"ba=1?\#\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ///host1:1,host2:2]*b%2Fc?ba=1?\# | ///host1:1,host2:2]*b%2Fc |  | ///host1:1,host2:2]*b%2Fc?ba=1?\# |  |  | ///host1:1,host2:2]*b%2Fc?ba=1?\# | false"
  assert_eq usum_rq("///[::1a!aa*=?;a=1"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"///[::1a!aa*=\", rawpath=\"///[::1a!aa*=\", rawq=\";a=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | ///[::1a!aa*=?;a=1 | ///[::1a!aa*= |  | ///[::1a!aa*=?;a=1 |  |  | ///[::1a!aa*=?;a=1 | false"
  assert_eq usum_rq("postgres://[1.2.3.4]"), "ERR parse \"postgres://[1.2.3.4]\": invalid IP-literal"
