  assert_eq esc("{="), ("%7B%3D", "%7B=", "{=", "{=")
  assert_eq esc("-&.@\\{|é?"), ("-%26.%40%5C%7B%7C%C3%A9%3F", "-&.@%5C%7B%7C%C3%A9%3F", "-&.@\\{|é?", "-&.@\\{|é?")
  assert_eq esc("\#"), ("%23", "%23", "\#", "\#")
  assert_eq esc("@| "), ("%40%7C+", "@%7C%20", "@| ", "@| ")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("%2\\"), ("%252%5C", "%252%5C", "ERR invalid URL escape \"%2\\\\\"", "ERR invalid URL escape \"%2\\\\\"")
  assert_eq esc("\"%41"), ("%22%2541", "%22%2541", "\"A", "\"A")
  assert_eq esc("$Z%41:Z[\"a"), ("%24Z%2541%3AZ%5B%22a", "$Z%2541:Z%5B%22a", "$ZA:Z[\"a", "$ZA:Z[\"a")
  assert_eq esc("&"), ("%26", "&", "&", "&")
  assert_eq esc("\"?%2"), ("%22%3F%252", "%22%3F%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc("["), ("%5B", "%5B", "[", "[")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("é"), ("%C3%A9", "%C3%A9", "é", "é")
  assert_eq esc("?^ 0&`0"), ("%3F%5E+0%26%600", "%3F%5E%200&%600", "?^ 0&`0", "?^ 0&`0")
  assert_eq esc(hx("7e7b25ff22ff3f")), ("~%7B%25%FF%22%FF%3F", "~%7B%25%FF%22%FF%3F", "ERR invalid URL escape \"%\\xff\\\"\"", "ERR invalid URL escape \"%\\xff\\\"\"")
  assert_eq esc("`|{"), ("%60%7C%7B", "%60%7C%7B", "`|{", "`|{")
  assert_eq esc("%"), ("%25", "%25", "ERR invalid URL escape \"%\"", "ERR invalid URL escape \"%\"")
  assert_eq esc("\"\""), ("%22%22", "%22%22", "\"\"", "\"\"")
  assert_eq esc(" "), ("+", "%20", " ", " ")
  assert_eq esc("@>=*"), ("%40%3E%3D%2A", "@%3E=%2A", "@>=*", "@>=*")
  assert_eq esc("~"), ("~", "~", "~", "~")
  assert_eq esc("|]@-%41"), ("%7C%5D%40-%2541", "%7C%5D@-%2541", "|]@-A", "|]@-A")
  assert_eq esc("?%zz*?{%)"), ("%3F%25zz%2A%3F%7B%25%29", "%3F%25zz%2A%3F%7B%25%29", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(")"), ("%29", "%29", ")", ")")
  assert_eq esc("?+{%2~_"), ("%3F%2B%7B%252~_", "%3F+%7B%252~_", "ERR invalid URL escape \"%2~\"", "ERR invalid URL escape \"%2~\"")
  assert_eq esc("<,^}"), ("%3C%2C%5E%7D", "%3C%2C%5E%7D", "<,^}", "<,^}")
  assert_eq esc(":\x01'0\#>"), ("%3A%01%270%23%3E", ":%01%270%23%3E", ":\x01'0\#>", ":\x01'0\#>")
  assert_eq esc(hx("2c5f7cff7b")), ("%2C_%7C%FF%7B", "%2C_%7C%FF%7B", hx("2c5f7cff7b"), hx("2c5f7cff7b"))
  assert_eq esc(":"), ("%3A", ":", ":", ":")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("."), (".", ".", ".", ".")
  assert_eq esc("^"), ("%5E", "%5E", "^", "^")
  assert_eq esc("0%€\#_$\\}&"), ("0%25%E2%82%AC%23_%24%5C%7D%26", "0%25%E2%82%AC%23_$%5C%7D&", "ERR invalid URL escape \"%\\xe2\\x82\"", "ERR invalid URL escape \"%\\xe2\\x82\"")
  assert_eq esc("]&^! "), ("%5D%26%5E%21+", "%5D&%5E%21%20", "]&^! ", "]&^! ")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("}&a"), ("%7D%26a", "%7D&a", "}&a", "}&a")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("][_ <"), ("%5D%5B_+%3C", "%5D%5B_%20%3C", "][_ <", "][_ <")
  assert_eq esc("%zz_0"), ("%25zz_0", "%25zz_0", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("]*="), ("%5D%2A%3D", "%5D%2A=", "]*=", "]*=")
  assert_eq esc("~Z\x01?$|€("), ("~Z%01%3F%24%7C%E2%82%AC%28", "~Z%01%3F$%7C%E2%82%AC%28", "~Z\x01?$|€(", "~Z\x01?$|€(")
  assert_eq esc(">|%zz$?]"), ("%3E%7C%25zz%24%3F%5D", "%3E%7C%25zz$%3F%5D", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(" `\x01+;+^"), ("+%60%01%2B%3B%2B%5E", "%20%60%01+%3B+%5E", " `\x01 ; ^", " `\x01+;+^")
  assert_eq esc("%"), ("%25", "%25", "ERR invalid URL escape \"%\"", "ERR invalid URL escape \"%\"")
  assert_eq esc("]%41/^\"*;*%2"), ("%5D%2541%2F%5E%22%2A%3B%2A%252", "%5D%2541%2F%5E%22%2A%3B%2A%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc(">,.)."), ("%3E%2C.%29.", "%3E%2C.%29.", ">,.).", ">,.).")
  assert_eq esc(hx("ff222532")), ("%FF%22%252", "%FF%22%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc("]('@=`"), ("%5D%28%27%40%3D%60", "%5D%28%27@=%60", "]('@=`", "]('@=`")
  assert_eq esc(hx("ff5c3d7b2c2524")), ("%FF%5C%3D%7B%2C%25%24", "%FF%5C=%7B%2C%25$", "ERR invalid URL escape \"%$\"", "ERR invalid URL escape \"%$\"")
  assert_eq esc("(<! %41"), ("%28%3C%21+%2541", "%28%3C%21%20%2541", "(<! A", "(<! A")
  assert_eq esc("'-^`Z%2!"), ("%27-%5E%60Z%252%21", "%27-%5E%60Z%252%21", "ERR invalid URL escape \"%2!\"", "ERR invalid URL escape \"%2!\"")
  assert_eq esc("::a[@"), ("%3A%3Aa%5B%40", "::a%5B@", "::a[@", "::a[@")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("]&@é(^}"), ("%5D%26%40%C3%A9%28%5E%7D", "%5D&@%C3%A9%28%5E%7D", "]&@é(^}", "]&@é(^}")
}

test "vectors: escaping 3" {
  assert_eq esc(" ;`}["), ("+%3B%60%7D%5B", "%20%3B%60%7D%5B", " ;`}[", " ;`}[")
  assert_eq esc(";*]:"), ("%3B%2A%5D%3A", "%3B%2A%5D:", ";*]:", ";*]:")
  assert_eq esc(",)/%2? €%zz!"), ("%2C%29%2F%252%3F+%E2%82%AC%25zz%21", "%2C%29%2F%252%3F%20%E2%82%AC%25zz%21", "ERR invalid URL escape \"%2?\"", "ERR invalid URL escape \"%2?\"")
  assert_eq esc("@!Z;;"), ("%40%21Z%3B%3B", "@%21Z%3B%3B", "@!Z;;", "@!Z;;")
  assert_eq esc("%zz/`("), ("%25zz%2F%60%28", "%25zz%2F%60%28", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("{,"), ("%7B%2C", "%7B%2C", "{,", "{,")
  assert_eq esc("'a)%\x01-}"), ("%27a%29%25%01-%7D", "%27a%29%25%01-%7D", "ERR invalid URL escape \"%\\x01-\"", "ERR invalid URL escape \"%\\x01-\"")
  assert_eq esc("\#:"), ("%23%3A", "%23:", "\#:", "\#:")
  assert_eq esc("$"), ("%24", "$", "$", "$")
  assert_eq esc("_=[,@"), ("_%3D%5B%2C%40", "_=%5B%2C@", "_=[,@", "_=[,@")
  assert_eq esc("0€%2@%zz`"), ("0%E2%82%AC%252%40%25zz%60", "0%E2%82%AC%252@%25zz%60", "ERR invalid URL escape \"%2@\"", "ERR invalid URL escape \"%2@\"")
  assert_eq esc("%."), ("%25.", "%25.", "ERR invalid URL escape \"%.\"", "ERR invalid URL escape \"%.\"")
  assert_eq esc("*}€&\\\\."), ("%2A%7D%E2%82%AC%26%5C%5C.", "%2A%7D%E2%82%AC&%5C%5C.", "*}€&\\\\.", "*}€&\\\\.")
  assert_eq esc("Z^<"), ("Z%5E%3C", "Z%5E%3C", "Z^<", "Z^<")
  assert_eq esc("*\#€,"), ("%2A%23%E2%82%AC%2C", "%2A%23%E2%82%AC%2C", "*\#€,", "*\#€,")
  assert_eq esc("$>>\">aZ)%"), ("%24%3E%3E%22%3EaZ%29%25", "$%3E%3E%22%3EaZ%29%25", "ERR invalid URL escape \"%\"", "ERR invalid URL escape \"%\"")
  assert_eq esc(".a?{"), (".a%3F%7B", ".a%3F%7B", ".a?{", ".a?{")
  assert_eq esc("=;&"), ("%3D%3B%26", "=%3B&", "=;&", "=;&")
  assert_eq esc("=!\x01"), ("%3D%21%01", "=%21%01", "=!\x01", "=!\x01")
  assert_eq esc("}:\x01"), ("%7D%3A%01", "%7D:%01", "}:\x01", "}:\x01")
  assert_eq esc("]"), ("%5D", "%5D", "]", "]")
  assert_eq esc(">/~^\#)"), ("%3E%2F~%5E%23%29", "%3E%2F~%5E%23%29", ">/~^\#)", ">/~^\#)")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(";"), ("%3B", "%3B", ";", ";")
  assert_eq esc("]\#%41 -"), ("%5D%23%2541+-", "%5D%23%2541%20-", "]\#A -", "]\#A -")
  assert_eq esc("$%\\€[!<"), ("%24%25%5C%E2%82%AC%5B%21%3C", "$%25%5C%E2%82%AC%5B%21%3C", "ERR invalid URL escape \"%\\\\\\xe2\"", "ERR invalid URL escape \"%\\\\\\xe2\"")
  assert_eq esc("\x01"), ("%01", "%01", "\x01", "\x01")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("\x01.€"), ("%01.%E2%82%AC", "%01.%E2%82%AC", "\x01.€", "\x01.€")
  assert_eq esc("=>+<>0"), ("%3D%3E%2B%3C%3E0", "=%3E+%3C%3E0", "=> <>0", "=>+<>0")
  assert_eq esc(hx("5aff30247e2f")), ("Z%FF0%24~%2F", "Z%FF0$~%2F", hx("5aff30247e2f"), hx("5aff30247e2f"))
  assert_eq esc("*/~"), ("%2A%2F~", "%2A%2F~", "*/~", "*/~")
  assert_eq esc(hx("ff")), ("%FF", "%FF", hx("ff"), hx("ff"))
  assert_eq esc(">"), ("%3E", "%3E", ">", ">")
  assert_eq esc("~\\%2='[}"), ("~%5C%252%3D%27%5B%7D", "~%5C%252=%27%5B%7D", "ERR invalid URL escape \"%2=\"", "ERR invalid URL escape \"%2=\"")
  assert_eq esc(">%41$=.€~+a"), ("%3E%2541%24%3D.%E2%82%AC~%2Ba", "%3E%2541$=.%E2%82%AC~+a", ">A$=.€~ a", ">A$=.€~+a")
  assert_eq esc("€|]_)/-_0"), ("%E2%82%AC%7C%5D_%29%2F-_0", "%E2%82%AC%7C%5D_%29%2F-_0", "€|]_)/-_0", "€|]_)/-_0")
  assert_eq esc("%2a"), ("%252a", "%252a", "*", "*")
  assert_eq esc("<"), ("%3C", "%3C", "<", "<")
  assert_eq esc("$>"), ("%24%3E", "$%3E", "$>", "$>")
  assert_eq esc("-!,"), ("-%21%2C", "-%21%2C", "-!,", "-!,")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("%%2-Z(a"), ("%25%252-Z%28a", "%25%252-Z%28a", "ERR invalid URL escape \"%%2\"", "ERR invalid URL escape \"%%2\"")
  assert_eq esc(":%*__}_*"), ("%3A%25%2A__%7D_%2A", ":%25%2A__%7D_%2A", "ERR invalid URL escape \"%*_\"", "ERR invalid URL escape \"%*_\"")
  assert_eq esc("~:?%zz}[-0"), ("~%3A%3F%25zz%7D%5B-0", "~:%3F%25zz%7D%5B-0", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(hx("ff257a7a")), ("%FF%25zz", "%FF%25zz", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("0&*^\":->@"), ("0%26%2A%5E%22%3A-%3E%40", "0&%2A%5E%22:-%3E@", "0&*^\":->@", "0&*^\":->@")
  assert_eq esc("!-=)/*\#<%2"), ("%21-%3D%29%2F%2A%23%3C%252", "%21-=%29%2F%2A%23%3C%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc("?!']{ /"), ("%3F%21%27%5D%7B+%2F", "%3F%21%27%5D%7B%20%2F", "?!']{ /", "?!']{ /")
  assert_eq esc("-+|\#`["), ("-%2B%7C%23%60%5B", "-+%7C%23%60%5B", "- |\#`[", "-+|\#`[")
  assert_eq esc("_~%zz'_"), ("_~%25zz%27_", "_~%25zz%27_", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("0<+0]"), ("0%3C%2B0%5D", "0%3C+0%5D", "0< 0]", "0<+0]")
  assert_eq esc(" |?%41"), ("+%7C%3F%2541", "%20%7C%3F%2541", " |?A", " |?A")
  assert_eq esc("Z`($<"), ("Z%60%28%24%3C", "Z%60%28$%3C", "Z`($<", "Z`($<")
  assert_eq esc(";|@/,$"), ("%3B%7C%40%2F%2C%24", "%3B%7C@%2F%2C$", ";|@/,$", ";|@/,$")
  assert_eq esc("$:%zzé%2"), ("%24%3A%25zz%C3%A9%252", "$:%25zz%C3%A9%252", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("}€"), ("%7D%E2%82%AC", "%7D%E2%82%AC", "}€", "}€")
  assert_eq esc(hx("012fff7be282ac2a2534315e253431")), ("%01%2F%FF%7B%E2%82%AC%2A%2541%5E%2541", "%01%2F%FF%7B%E2%82%AC%2A%2541%5E%2541", hx("012fff7be282ac2a415e41"), hx("012fff7be282ac2a415e41"))
  assert_eq esc("\"><=%_-;"), ("%22%3E%3C%3D%25_-%3B", "%22%3E%3C=%25_-%3B", "ERR invalid URL escape \"%_-\"", "ERR invalid URL escape \"%_-\"")
  assert_eq esc("\#"), ("%23", "%23", "\#", "\#")
  assert_eq esc("€.&%41"), ("%E2%82%AC.%26%2541", "%E2%82%AC.&%2541", "€.&A", "€.&A")
  assert_eq esc("%2?%2?>|[&"), ("%252%3F%252%3F%3E%7C%5B%26", "%252%3F%252%3F%3E%7C%5B&", "ERR invalid URL escape \"%2?\"", "ERR invalid URL escape \"%2?\"")
  assert_eq esc(";\"'>^<[[)"), ("%3B%22%27%3E%5E%3C%5B%5B%29", "%3B%22%27%3E%5E%3C%5B%5B%29", ";\"'>^<[[)", ";\"'>^<[[)")
  assert_eq esc("\\_*)"), ("%5C_%2A%29", "%5C_%2A%29", "\\_*)", "\\_*)")
  assert_eq esc("& */`&"), ("%26+%2A%2F%60%26", "&%20%2A%2F%60&", "& */`&", "& */`&")
  assert_eq esc("*`"), ("%2A%60", "%2A%60", "*`", "*`")
  assert_eq esc(")"), ("%29", "%29", ")", ")")
  assert_eq esc(":"), ("%3A", ":", ":", ":")
  assert_eq esc("/"), ("%2F", "%2F", "/", "/")
  assert_eq esc("`"), ("%60", "%60", "`", "`")
  assert_eq esc(hx("3bff")), ("%3B%FF", "%3B%FF", hx("3bff"), hx("3bff"))
  assert_eq esc(hx("2534313f7c615b257a7a5eff")), ("%2541%3F%7Ca%5B%25zz%5E%FF", "%2541%3F%7Ca%5B%25zz%5E%FF", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("`<\"@?"), ("%60%3C%22%40%3F", "%60%3C%22@%3F", "`<\"@?", "`<\"@?")
  assert_eq esc("_a_$"), ("_a_%24", "_a_$", "_a_$", "_a_$")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("a!a"), ("a%21a", "a%21a", "a!a", "a!a")
  assert_eq esc("].%zz"), ("%5D.%25zz", "%5D.%25zz", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("'$*~;';"), ("%27%24%2A~%3B%27%3B", "%27$%2A~%3B%27%3B", "'$*~;';", "'$*~;';")
  assert_eq esc("/] \x01"), ("%2F%5D+%01", "%2F%5D%20%01", "/] \x01", "/] \x01")
  assert_eq esc("a<<$"), ("a%3C%3C%24", "a%3C%3C$", "a<<$", "a<<$")
  assert_eq esc("'\x01~%2"), ("%27%01~%252", "%27%01~%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc(hx("ff5b3de282ac2723ff23")), ("%FF%5B%3D%E2%82%AC%27%23%FF%23", "%FF%5B=%E2%82%AC%27%23%FF%23", hx("ff5b3de282ac2723ff23"), hx("ff5b3de282ac2723ff23"))
  assert_eq esc("\"*_{Z"), ("%22%2A_%7BZ", "%22%2A_%7BZ", "\"*_{Z", "\"*_{Z")
  assert_eq esc(hx("ff27")), ("%FF%27", "%FF%27", hx("ff27"), hx("ff27"))
  assert_eq esc("<+"), ("%3C%2B", "%3C+", "< ", "<+")
  assert_eq esc(")Z%2!$=:"), ("%29Z%252%21%24%3D%3A", "%29Z%252%21$=:", "ERR invalid URL escape \"%2!\"", "ERR invalid URL escape \"%2!\"")
  assert_eq esc("?"), ("%3F", "%3F", "?", "?")
  assert_eq esc("=+\"€  "), ("%3D%2B%22%E2%82%AC++", "=+%22%E2%82%AC%20%20", "= \"€  ", "=+\"€  ")
  assert_eq esc("?%41Z-€$=~="), ("%3F%2541Z-%E2%82%AC%24%3D~%3D", "%3F%2541Z-%E2%82%AC$=~=", "?AZ-€$=~=", "?AZ-€$=~=")
  assert_eq esc("~|*a,%+"), ("~%7C%2Aa%2C%25%2B", "~%7C%2Aa%2C%25+", "ERR invalid URL escape \"%+\"", "ERR invalid URL escape \"%+\"")
  assert_eq esc("~{,"), ("~%7B%2C", "~%7B%2C", "~{,", "~{,")
  assert_eq esc("\#$%41/(\\%41a\x01"), ("%23%24%2541%2F%28%5C%2541a%01", "%23$%2541%2F%28%5C%2541a%01", "\#$A/(\\Aa\x01", "\#$A/(\\Aa\x01")
  assert_eq esc(hx("7b5e3a3fff60")), ("%7B%5E%3A%3F%FF%60", "%7B%5E:%3F%FF%60", hx("7b5e3a3fff60"), hx("7b5e3a3fff60"))
  assert_eq esc("%zz%zzé"), ("%25zz%25zz%C3%A9", "%25zz%25zz%C3%A9", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("`)=}"), ("%60%29%3D%7D", "%60%29=%7D", "`)=}", "`)=}")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("\x01€[}~'"), ("%01%E2%82%AC%5B%7D~%27", "%01%E2%82%AC%5B%7D~%27", "\x01€[}~'", "\x01€[}~'")
  assert_eq esc("\x01-\#&"), ("%01-%23%26", "%01-%23&", "\x01-\#&", "\x01-\#&")
  assert_eq esc("\x01==\"%zz)"), ("%01%3D%3D%22%25zz%29", "%01==%22%25zz%29", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(""), ("", "", "", "")
}

test "vectors: escaping 4" {
  assert_eq esc(",\#'%41+*"), ("%2C%23%27%2541%2B%2A", "%2C%23%27%2541+%2A", ",\#'A *", ",\#'A+*")
  assert_eq esc("\\<%41\x01~_/%41é"), ("%5C%3C%2541%01~_%2F%2541%C3%A9", "%5C%3C%2541%01~_%2F%2541%C3%A9", "\\<A\x01~_/Aé", "\\<A\x01~_/Aé")
  assert_eq esc("~:"), ("~%3A", "~:", "~:", "~:")
  assert_eq esc("%)++}<"), ("%25%29%2B%2B%7D%3C", "%25%29++%7D%3C", "ERR invalid URL escape \"%)+\"", "ERR invalid URL escape \"%)+\"")
  assert_eq esc("`&.-"), ("%60%26.-", "%60&.-", "`&.-", "`&.-")
  assert_eq esc("&!%41+"), ("%26%21%2541%2B", "&%21%2541+", "&!A ", "&!A+")
  assert_eq esc(hx("5f5b402c5bff")), ("_%5B%40%2C%5B%FF", "_%5B@%2C%5B%FF", hx("5f5b402c5bff"), hx("5f5b402c5bff"))
  assert_eq esc("__ ;"), ("__+%3B", "__%20%3B", "__ ;", "__ ;")
  assert_eq esc(hx("7eff5e5e3c26300124")), ("~%FF%5E%5E%3C%260%01%24", "~%FF%5E%5E%3C&0%01$", hx("7eff5e5e3c26300124"), hx("7eff5e5e3c26300124"))
  assert_eq esc("a\x01=[aZ+"), ("a%01%3D%5BaZ%2B", "a%01=%5BaZ+", "a\x01=[aZ ", "a\x01=[aZ+")
  assert_eq esc("-}}%2 "), ("-%7D%7D%252+", "-%7D%7D%252%20", "ERR invalid URL escape \"%2 \"", "ERR invalid URL escape \"%2 \"")
  assert_eq esc(hx("ffff253431602fc3a9")), ("%FF%FF%2541%60%2F%C3%A9", "%FF%FF%2541%60%2F%C3%A9", hx("ffff41602fc3a9"), hx("ffff41602fc3a9"))
  assert_eq esc("^%zz %41]\x01]"), ("%5E%25zz+%2541%5D%01%5D", "%5E%25zz%20%2541%5D%01%5D", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(hx("5d3c3cff")), ("%5D%3C%3C%FF", "%5D%3C%3C%FF", hx("5d3c3cff"), hx("5d3c3cff"))
  assert_eq esc("\x01+\\[a\#%41&"), ("%01%2B%5C%5Ba%23%2541%26", "%01+%5C%5Ba%23%2541&", "\x01 \\[a\#A&", "\x01+\\[a\#A&")
  assert_eq esc(">\#%41"), ("%3E%23%2541", "%3E%23%2541", ">\#A", ">\#A")
  assert_eq esc(hx("243f2534315c23ff01302f")), ("%24%3F%2541%5C%23%FF%010%2F", "$%3F%2541%5C%23%FF%010%2F", hx("243f415c23ff01302f"), hx("243f415c23ff01302f"))
  assert_eq esc("0"), ("0", "0", "0", "0")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(">a%zz~=\\_|:"), ("%3Ea%25zz~%3D%5C_%7C%3A", "%3Ea%25zz~=%5C_%7C:", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(">`@=\x01Z$?*"), ("%3E%60%40%3D%01Z%24%3F%2A", "%3E%60@=%01Z$%3F%2A", ">`@=\x01Z$?*", ">`@=\x01Z$?*")
  assert_eq esc("'*\\("), ("%27%2A%5C%28", "%27%2A%5C%28", "'*\\(", "'*\\(")
  assert_eq esc(" %zz%zz"), ("+%25zz%25zz", "%20%25zz%25zz", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("* \\>\"\x01:-"), ("%2A+%5C%3E%22%01%3A-", "%2A%20%5C%3E%22%01:-", "* \\>\"\x01:-", "* \\>\"\x01:-")
  assert_eq esc("-\\"), ("-%5C", "-%5C", "-\\", "-\\")
  assert_eq esc(" %?:!~"), ("+%25%3F%3A%21~", "%20%25%3F:%21~", "ERR invalid URL escape \"%?:\"", "ERR invalid URL escape \"%?:\"")
  assert_eq esc("._<(]"), ("._%3C%28%5D", "._%3C%28%5D", "._<(]", "._<(]")
  assert_eq esc("<-"), ("%3C-", "%3C-", "<-", "<-")
  assert_eq esc("\"?^->:"), ("%22%3F%5E-%3E%3A", "%22%3F%5E-%3E:", "\"?^->:", "\"?^->:")
  assert_eq esc("}*,&[';+"), ("%7D%2A%2C%26%5B%27%3B%2B", "%7D%2A%2C&%5B%27%3B+", "}*,&['; ", "}*,&[';+")
  assert_eq esc("@@^\\?)"), ("%40%40%5E%5C%3F%29", "@@%5E%5C%3F%29", "@@^\\?)", "@@^\\?)")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("&-)"), ("%26-%29", "&-%29", "&-)", "&-)")
  assert_eq esc(":`:%'0\\0!"), ("%3A%60%3A%25%270%5C0%21", ":%60:%25%270%5C0%21", "ERR invalid URL escape \"%'0\"", "ERR invalid URL escape \"%'0\"")
