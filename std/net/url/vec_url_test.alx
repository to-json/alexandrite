test "vectors: escaping 12" {
  assert_eq esc("*\\Z:+€'"), ("%2A%5CZ%3A%2B%E2%82%AC%27", "%2A%5CZ:+%E2%82%AC%27", "*\\Z: €'", "*\\Z:+€'")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("'>€\x01>&{?"), ("%27%3E%E2%82%AC%01%3E%26%7B%3F", "%27%3E%E2%82%AC%01%3E&%7B%3F", "'>€\x01>&{?", "'>€\x01>&{?")
  assert_eq esc("!/?/"), ("%21%2F%3F%2F", "%21%2F%3F%2F", "!/?/", "!/?/")
