  assert_eq esc("\\a€%2Z='"), ("%5Ca%E2%82%AC%252Z%3D%27", "%5Ca%E2%82%AC%252Z=%27", "ERR invalid URL escape \"%2Z\"", "ERR invalid URL escape \"%2Z\"")
