  assert_eq usum_p("https:[?b+=é"), "opaque=\"[\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"b+=é\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:[?b+=é |  |  | [?b+=é |  |  | https:[?b+=é | true"
  assert_eq usum_p("//[fe80::1%25en0]:;p\#/!$&'()*+,;=\#"), "ERR parse \"//[fe80::1%25en0]:;p\": invalid port \":;p\" after host"
  assert_eq usum_p("1x://p%40w!up%40w@x%41"), "ERR parse \"1x://p%40w!up%40w@x%41\": first path segment in URL cannot contain colon"
  assert_eq usum_p("https:é%(%25"), "opaque=\"é%(%25\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https:é%(%25 |  |  | é%(%25 |  |  | https:é%(%25 | true"
  assert_eq usum_p("https:"), "opaque=\"\", scheme=\"https\", user=nil, pass=nil, host=\"\", path=\"\", rawpath=\"\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | https: |  |  | / |  |  | https: | true"
