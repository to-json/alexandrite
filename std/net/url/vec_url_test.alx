  assert_eq usum_p("postgres:/host1:1,host2:2b%2Fc%20b%2Fcé ?ba=1"), "opaque=\"\", scheme=\"postgres\", user=nil, pass=nil, host=\"\", path=\"/host1:1,host2:2b/c b/cé \", rawpath=\"/host1:1,host2:2b%2Fc%20b%2Fcé \", rawq=\"ba=1\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | postgres:/host1:1,host2:2b/c%20b/c%C3%A9%20?ba=1 | /host1:1,host2:2b/c%20b/c%C3%A9%20 |  | /host1:1,host2:2b/c%20b/c%C3%A9%20?ba=1 |  |  | postgres:/host1:1,host2:2b/c%20b/c%C3%A9%20?ba=1 | true"
