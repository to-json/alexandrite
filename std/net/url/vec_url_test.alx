  assert_eq esc(hx("e282ac2f2e7dff255c")), ("%E2%82%AC%2F.%7D%FF%25%5C", "%E2%82%AC%2F.%7D%FF%25%5C", "ERR invalid URL escape \"%\\\\\"", "ERR invalid URL escape \"%\\\\\"")
  assert_eq esc(":%41Z"), ("%3A%2541Z", ":%2541Z", ":AZ", ":AZ")
  assert_eq esc(hx("2eff40e282ac2e202d")), (".%FF%40%E2%82%AC.+-", ".%FF@%E2%82%AC.%20-", hx("2eff40e282ac2e202d"), hx("2eff40e282ac2e202d"))
  assert_eq esc("%[*_"), ("%25%5B%2A_", "%25%5B%2A_", "ERR invalid URL escape \"%[*\"", "ERR invalid URL escape \"%[*\"")
  assert_eq esc("\"_,;"), ("%22_%2C%3B", "%22_%2C%3B", "\"_,;", "\"_,;")
