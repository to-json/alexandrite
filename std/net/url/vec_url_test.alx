  assert_eq esc("_\#.:"), ("_%23.%3A", "_%23.:", "_\#.:", "_\#.:")
  assert_eq esc("%zz +a€<"), ("%25zz+%2Ba%E2%82%AC%3C", "%25zz%20+a%E2%82%AC%3C", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("Z\x01"), ("Z%01", "Z%01", "Z\x01", "Z\x01")
  assert_eq esc(hx("2eff607c2d")), (".%FF%60%7C-", ".%FF%60%7C-", hx("2eff607c2d"), hx("2eff607c2d"))
  assert_eq esc("(''(é"), ("%28%27%27%28%C3%A9", "%28%27%27%28%C3%A9", "(''(é", "(''(é")
  assert_eq esc("| +0=0[%2"), ("%7C+%2B0%3D0%5B%252", "%7C%20+0=0%5B%252", "ERR invalid URL escape \"%2\"", "ERR invalid URL escape \"%2\"")
  assert_eq esc("+ Z+&$"), ("%2B+Z%2B%26%24", "+%20Z+&$", "  Z &$", "+ Z+&$")
  assert_eq esc(hx("25322a2f2eff")), ("%252%2A%2F.%FF", "%252%2A%2F.%FF", "ERR invalid URL escape \"%2*\"", "ERR invalid URL escape \"%2*\"")
  assert_eq esc(hx("2828243cc3a9ff60")), ("%28%28%24%3C%C3%A9%FF%60", "%28%28$%3C%C3%A9%FF%60", hx("2828243cc3a9ff60"), hx("2828243cc3a9ff60"))
  assert_eq esc("{*)>"), ("%7B%2A%29%3E", "%7B%2A%29%3E", "{*)>", "{*)>")
  assert_eq esc("&\#"), ("%26%23", "&%23", "&\#", "&\#")
  assert_eq esc("%$>Z?]%aa"), ("%25%24%3EZ%3F%5D%25aa", "%25$%3EZ%3F%5D%25aa", "ERR invalid URL escape \"%$>\"", "ERR invalid URL escape \"%$>\"")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc(":a!`?$;."), ("%3Aa%21%60%3F%24%3B.", ":a%21%60%3F$%3B.", ":a!`?$;.", ":a!`?$;.")
  assert_eq esc("é}%41^ %\""), ("%C3%A9%7D%2541%5E+%25%22", "%C3%A9%7D%2541%5E%20%25%22", "ERR invalid URL escape \"%\\\"\"", "ERR invalid URL escape \"%\\\"\"")
  assert_eq esc("?0|"), ("%3F0%7C", "%3F0%7C", "?0|", "?0|")
  assert_eq esc(",~&%zz%zz"), ("%2C~%26%25zz%25zz", "%2C~&%25zz%25zz", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc(")é^-"), ("%29%C3%A9%5E-", "%29%C3%A9%5E-", ")é^-", ")é^-")
  assert_eq esc(""), ("", "", "", "")
  assert_eq esc("0a\#{Z"), ("0a%23%7BZ", "0a%23%7BZ", "0a\#{Z", "0a\#{Z")
  assert_eq esc("/,%%41"), ("%2F%2C%25%2541", "%2F%2C%25%2541", "ERR invalid URL escape \"%%4\"", "ERR invalid URL escape \"%%4\"")
  assert_eq esc("("), ("%28", "%28", "(", "(")
  assert_eq esc("*+{"), ("%2A%2B%7B", "%2A+%7B", "* {", "*+{")
  assert_eq esc(";*%zz>>]*\\~"), ("%3B%2A%25zz%3E%3E%5D%2A%5C~", "%3B%2A%25zz%3E%3E%5D%2A%5C~", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
  assert_eq esc("/0a$%${@"), ("%2F0a%24%25%24%7B%40", "%2F0a$%25$%7B@", "ERR invalid URL escape \"%${\"", "ERR invalid URL escape \"%${\"")
  assert_eq esc("%zz€&"), ("%25zz%E2%82%AC%26", "%25zz%E2%82%AC&", "ERR invalid URL escape \"%zz\"", "ERR invalid URL escape \"%zz\"")
}

test "vectors: query" {
  assert_eq pq("=b"), ("\"\":\"b\"", "=b", "")
  assert_eq pq("&&;;bx=1%3D"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("a"), ("\"a\":\"\"", "a=", "")
  assert_eq pq("%zza="), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq("%20é&%20"), ("\" \":\"\" \" é\":\"\"", "+=&+%C3%A9=", "")
  assert_eq pq(";%26&&a&%20"), ("\" \":\"\" \"a\":\"\"", "+=&a=", "invalid semicolon separator in query")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("+%20;&&"), ("", "", "invalid semicolon separator in query")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("=%3D"), ("\"\":\"=\"", "=%3D", "")
  assert_eq pq("&bé="), ("\"bé\":\"\"", "b%C3%A9=", "")
  assert_eq pq("a+&&"), ("\"a \":\"\"", "a+=", "")
  assert_eq pq("a%3D%26="), ("\"a=&\":\"\"", "a%3D%26=", "")
  assert_eq pq("%20&&=a%20%20"), ("\"\":\"a  \" \" \":\"\"", "=a++&+=", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("+a%zz"), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq(""), ("", "", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq(";&&%26a=%20%zz"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("%3D=%26;x=1;"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("&&&&%zza;"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("x=1"), ("\"x\":\"1\"", "x=1", "")
  assert_eq pq("%3D=&é"), ("\"=\":\"\" \"é\":\"\"", "%3D=&%C3%A9=", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("x=1%zz%zz;&&é"), ("\"é\":\"\"", "%C3%A9=", "invalid semicolon separator in query")
  assert_eq pq("%zz"), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq("%20"), ("\" \":\"\"", "+=", "")
  assert_eq pq("&%26;&&%zz"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("%3D"), ("\"=\":\"\"", "%3D=", "")
  assert_eq pq("b"), ("\"b\":\"\"", "b=", "")
  assert_eq pq("é%3D;&&a"), ("\"a\":\"\"", "a=", "invalid semicolon separator in query")
  assert_eq pq("x=1%20="), ("\"x\":\"1 =\"", "x=1+%3D", "")
  assert_eq pq("%26é%3Db%3D%26"), ("\"&é=b=&\":\"\"", "%26%C3%A9%3Db%3D%26=", "")
  assert_eq pq("b&+%3D%20&"), ("\" = \":\"\" \"b\":\"\"", "+%3D+=&b=", "")
  assert_eq pq("x=1&&%20"), ("\" \":\"\" \"x\":\"1\"", "+=&x=1", "")
  assert_eq pq("%3D%20%26"), ("\"= &\":\"\"", "%3D+%26=", "")
  assert_eq pq("=éa=%3D"), ("\"\":\"éa==\"", "=%C3%A9a%3D%3D", "")
  assert_eq pq("é"), ("\"é\":\"\"", "%C3%A9=", "")
  assert_eq pq("&&"), ("", "", "")
  assert_eq pq("%zz&&%3D%3Déa%3D"), ("\"==éa=\":\"\"", "%3D%3D%C3%A9a%3D=", "invalid URL escape \"%zz\"")
  assert_eq pq("&éé;x=1"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("a;%26&&"), ("", "", "invalid semicolon separator in query")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("a%zzx=1%zzx=1x=1"), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq(";%26+%3D%zz"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("%20+=%20"), ("\"  \":\" \"", "++=+", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("x=1éx=1&"), ("\"x\":\"1éx=1\"", "x=1%C3%A9x%3D1", "")
  assert_eq pq("b%3D%26x=1%26&&&&"), ("\"b=&x\":\"1&\"", "b%3D%26x=1%26", "")
  assert_eq pq("é=a&&&;a"), ("\"é\":\"a\"", "%C3%A9=a", "invalid semicolon separator in query")
  assert_eq pq("&+"), ("\" \":\"\"", "+=", "")
  assert_eq pq("a%20;+é"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("a%26"), ("\"a&\":\"\"", "a%26=", "")
  assert_eq pq("a+%3Dé"), ("\"a =é\":\"\"", "a+%3D%C3%A9=", "")
  assert_eq pq("%26%zz&+%zz"), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq("ééx=1"), ("\"ééx\":\"1\"", "%C3%A9%C3%A9x=1", "")
  assert_eq pq("é&é=%zzb"), ("\"é\":\"\"", "%C3%A9=", "invalid URL escape \"%zz\"")
  assert_eq pq("+aaé%3Dé%20"), ("\" aaé=é \":\"\"", "+aa%C3%A9%3D%C3%A9+=", "")
  assert_eq pq("&b"), ("\"b\":\"\"", "b=", "")
  assert_eq pq("%zz&&"), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq("a;b;&=%26"), ("\"\":\"&\"", "=%26", "invalid semicolon separator in query")
  assert_eq pq("ba%zz%3D&&&&="), ("\"\":\"\"", "=", "invalid URL escape \"%zz\"")
  assert_eq pq("=%20%20bé%3Dx=1"), ("\"\":\"  bé=x=1\"", "=++b%C3%A9%3Dx%3D1", "")
  assert_eq pq("%20;%20%zz%20"), ("", "", "invalid semicolon separator in query")
  assert_eq pq(""), ("", "", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("%3D"), ("\"=\":\"\"", "%3D=", "")
  assert_eq pq("%zz+x=1"), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq("éx=1"), ("\"éx\":\"1\"", "%C3%A9x=1", "")
  assert_eq pq("%26bx=1éb"), ("\"&bx\":\"1éb\"", "%26bx=1%C3%A9b", "")
  assert_eq pq("x=1b&&;%3D"), ("\"x\":\"1b\"", "x=1b", "invalid semicolon separator in query")
  assert_eq pq("%26x=1%zz&éx=1"), ("\"éx\":\"1\"", "%C3%A9x=1", "invalid URL escape \"%zz\"")
  assert_eq pq("%26%20+=%20%20;"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("x=1;"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("%zz"), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("%26é"), ("\"&é\":\"\"", "%26%C3%A9=", "")
  assert_eq pq("%26a"), ("\"&a\":\"\"", "%26a=", "")
  assert_eq pq("&&"), ("", "", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("=éé"), ("\"\":\"éé\"", "=%C3%A9%C3%A9", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("="), ("\"\":\"\"", "=", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("=%3Déx=1%20"), ("\"\":\"=éx=1 \"", "=%3D%C3%A9x%3D1+", "")
  assert_eq pq("=&"), ("\"\":\"\"", "=", "")
  assert_eq pq("%3Dx=1"), ("\"=x\":\"1\"", "%3Dx=1", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("a"), ("\"a\":\"\"", "a=", "")
  assert_eq pq("+%26%3D&%3D=;"), ("\" &=\":\"\"", "+%26%3D=", "invalid semicolon separator in query")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("a%20a;"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("%zzx=1%zz%20a"), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq("%26a"), ("\"&a\":\"\"", "%26a=", "")
  assert_eq pq("é%20%20+&x=1"), ("\"x\":\"1\" \"é   \":\"\"", "x=1&%C3%A9+++=", "")
  assert_eq pq("&%26&%26"), ("\"&\":\",\"", "%26=&%26=", "")
  assert_eq pq("=&"), ("\"\":\"\"", "=", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("&%zz%20%26&&"), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq("%20%3D&"), ("\" =\":\"\"", "+%3D=", "")
}

test "vectors: query 1" {
  assert_eq pq("%zz&aa=%20"), ("\"aa\":\" \"", "aa=+", "invalid URL escape \"%zz\"")
  assert_eq pq("&%3D"), ("\"=\":\"\"", "%3D=", "")
  assert_eq pq("bb+%20="), ("\"bb  \":\"\"", "bb++=", "")
  assert_eq pq("%zz&x=1"), ("\"x\":\"1\"", "x=1", "invalid URL escape \"%zz\"")
  assert_eq pq(";a"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("%3D%26é;"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("&&%3D%20%26x=1"), ("\"= &x\":\"1\"", "%3D+%26x=1", "")
  assert_eq pq("%26é"), ("\"&é\":\"\"", "%26%C3%A9=", "")
  assert_eq pq("ab%26%3D%zz+"), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("%26="), ("\"&\":\"\"", "%26=", "")
  assert_eq pq("ba%26=+"), ("\"ba&\":\" \"", "ba%26=+", "")
  assert_eq pq("++x=1&%26;"), ("\"  x\":\"1\"", "++x=1", "invalid semicolon separator in query")
  assert_eq pq("b;%3D%20a&"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("="), ("\"\":\"\"", "=", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("%26%3Da"), ("\"&=a\":\"\"", "%26%3Da=", "")
  assert_eq pq("a&&é"), ("\"a\":\"\" \"é\":\"\"", "a=&%C3%A9=", "")
  assert_eq pq("=="), ("\"\":\"=\"", "=%3D", "")
  assert_eq pq("%26%20="), ("\"& \":\"\"", "%26+=", "")
  assert_eq pq("="), ("\"\":\"\"", "=", "")
  assert_eq pq("éaa="), ("\"éaa\":\"\"", "%C3%A9aa=", "")
  assert_eq pq("x=1%zz;+%20é"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("%zz="), ("", "", "invalid URL escape \"%zz\"")
  assert_eq pq("b;%zzx=1"), ("", "", "invalid semicolon separator in query")
  assert_eq pq(";%zz"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("%3D%26+ax=1a"), ("\"=& ax\":\"1a\"", "%3D%26+ax=1a", "")
  assert_eq pq("x=1%26%26%20"), ("\"x\":\"1&& \"", "x=1%26%26+", "")
  assert_eq pq("é&&;b"), ("\"é\":\"\"", "%C3%A9=", "invalid semicolon separator in query")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("&&&x=1x=1ab"), ("\"x\":\"1x=1ab\"", "x=1x%3D1ab", "")
  assert_eq pq("éa"), ("\"éa\":\"\"", "%C3%A9a=", "")
  assert_eq pq("%26é%zz%20;x=1"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("é%3Daé&&;"), ("\"é=aé\":\"\"", "%C3%A9%3Da%C3%A9=", "invalid semicolon separator in query")
  assert_eq pq(""), ("", "", "")
  assert_eq pq("&x=1%20b;"), ("", "", "invalid semicolon separator in query")
  assert_eq pq("++x=1+"), ("\"  x\":\"1 \"", "++x=1+", "")
  assert_eq pq("%3D&&%zz+x=1a"), ("\"=\":\"\"", "%3D=", "invalid URL escape \"%zz\"")
  assert_eq pq("&&"), ("", "", "")
  assert_eq pq("x=1b%20"), ("\"x\":\"1b \"", "x=1b+", "")
  assert_eq pq("é&%zz="), ("\"é\":\"\"", "%C3%A9=", "invalid URL escape \"%zz\"")
  assert_eq pq(""), ("", "", "")
  assert_eq pq(""), ("", "", "")
  assert_eq pq(";&&%zz=+"), ("", "", "invalid semicolon separator in query")
