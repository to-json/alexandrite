}

test "vectors: parse request uri 2" {
  assert_eq usum_rq("ftp:/!@local_host!a%25(@..\#!"), "opaque=\"\", scheme=\"ftp\", user=nil, pass=nil, host=\"\", path=\"/!@local_host!a%(@..\#!\", rawpath=\"/!@local_host!a%25(@..\#!\", rawq=\"\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=true | ftp:/%21@local_host%21a%25%28@..%23%21 | /%21@local_host%21a%25%28@..%23%21 |  | /%21@local_host%21a%25%28@..%23%21 |  |  | ftp:/%21@local_host%21a%25%28@..%23%21 | true"
