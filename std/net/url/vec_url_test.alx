  assert_eq usum_p("/a b;p*&:..)?a=1é+"), "opaque=\"\", scheme=\"\", user=nil, pass=nil, host=\"\", path=\"/a b;p*&:..)\", rawpath=\"/a b;p*&:..)\", rawq=\"a=1é+\", frag=\"\", rawfrag=\"\", forcequery=false, omithost=false | /a%20b;p%2A&:..%29?a=1é+ | /a%20b;p%2A&:..%29 |  | /a%20b;p%2A&:..%29?a=1é+ |  |  | /a%20b;p%2A&:..%29?a=1é+ | false"
