# Summaries for the generated vectors (vec_net_test.alx); each mirrors the
# Go generator's function of the same name.

import "context"
import "encoding/hex"

def b01(x: Bool) -> Str { x ? "1" : "0" }

def hx(b: [Byte]) -> Str { hex.encode_to_string(b) }

def hxo(ip: IP?) -> Str {
  x = ip || return "nil"
  hx(x.bytes)
}

def unhex(s: Str) -> [Byte] {
  return [] if s == "nil"
  hex.decode_string(s).unwrap
}

def ipsum(ip: IP) -> Str {
  flags = b01(ip.unspecified?) + b01(ip.loopback?) + b01(ip.private?) + b01(ip.multicast?) + b01(ip.interface_local_multicast?) + b01(ip.link_local_multicast?) + b01(ip.link_local_unicast?) + b01(ip.global_unicast?)
  dm = "nil"
  if m = ip.default_mask {
    dm = m.to_s
  }
  mt = ip.marshal_text
  ms = mt.err? ? "ERR " + mt.err.unwrap.message : Str.from_bytes(mt.unwrap)
  "#{hx(ip.bytes)}|#{ip}|#{hxo(ip.to4)}|#{hxo(ip.to16)}|#{flags}|#{dm}|#{ms}"
}

def ipsum_p(s: Str) -> Str {
  ip = parse_ip(s) || return "nil"
  ipsum(ip)
}

def ipsum_b(h: Str) -> Str { ipsum(ip_from(unhex(h))) }

def mask_eq(a: Str, m: Str, b: Str) -> Str {
  x = ip_from(unhex(a))
  out = hxo(x.mask(mask_from(unhex(m))))
  out + "|" + b01(x.equal?(ip_from(unhex(b))))
}

def cidr_sum(ones: Int, bits: Int) -> Str {
  m = cidr_mask(ones, bits) || return "nil"
  o, b = m.size_bits
  "#{m}|#{o}|#{b}"
}

def mask_sum(h: Str) -> Str {
  m = mask_from(unhex(h))
  o, b = m.size_bits
  "#{m}|#{o}|#{b}"
}

def cidr_parse(s: Str, probe_s: Str) -> Str {
  r = parse_cidr(s)
  return "ERR " + r.err.unwrap.message if r.err?
  ip, n = r.unwrap
  probe = parse_ip(probe_s) || ip
  "#{hx(ip.bytes)}|#{hx(n.ip.bytes)}|#{hx(n.mask.bytes)}|#{n}|#{hx(probe.bytes)}|#{b01(n.contains?(probe))}"
}

def ipnet_sum(ip: Str, m: Str, probe: Str) -> Str {
  n = IPNet.new(ip: ip_from(unhex(ip)), mask: mask_from(unhex(m)))
  n.to_s + "|" + b01(n.contains?(ip_from(unhex(probe))))
}

def shp(s: Str) -> Str {
  r = split_host_port(s)
  return "ERR " + r.err.unwrap.message if r.err?
  h, p = r.unwrap
  h + "|" + p
}

def mac_sum(s: Str) -> Str {
  r = parse_mac(s)
  return "ERR " + r.err.unwrap.message if r.err?
  hw = r.unwrap
  hx(hw.bytes) + "|" + hw.to_s
}

def addr_strs(ip: Str, port: Int, zone: Str) -> Str {
  x = ip_from(unhex(ip))
  ta = TCPAddr.new(ip: x, port: port, zone: zone)
  ua = UDPAddr.new(ip: x, port: port, zone: zone)
  ia = IPAddr.new(ip: x, zone: zone)
  "#{ta}|#{ua}|#{ia}|#{ta.network}#{ua.network}#{ia.network}"
}

def resolve_sum(nw: Str, l: Str) -> Str {
  t = resolve_tcp_addr(nw, l)
  out = t.err? ? "ERR " + t.err.unwrap.message : t.unwrap.to_s
  u = resolve_udp_addr(nw, l)
  out + " || " + (u.err? ? "ERR " + u.err.unwrap.message : u.unwrap.to_s)
}

def resolve_ip_sum(nw: Str, l: Str) -> Str {
  r = resolve_ip_addr(nw, l)
  r.err? ? "ERR " + r.err.unwrap.message : r.unwrap.to_s
}

def port_sum(nw: Str, p: Str) -> Str {
  r = lookup_port(nw, p)
  r.err? ? "ERR " + r.err.unwrap.message : "#{r.unwrap}"
}
