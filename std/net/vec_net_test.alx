  assert_eq mac_sum("526f0c425ae6a5fc"), "526f0c425ae6a5fc|52:6f:0c:42:5a:e6:a5:fc"
  assert_eq mac_sum("a9-c5-93-9d-44-56-71-03"), "a9c5939d44567103|a9:c5:93:9d:44:56:71:03"
  assert_eq mac_sum("7FC-9.8fe964.B:3fEFABff9CA"), "ERR address 7FC-9.8fe964.B:3fEFABff9CA: invalid MAC address"
  assert_eq mac_sum("5B90.9230.93FD"), "5b90923093fd|5b:90:92:30:93:fd"
