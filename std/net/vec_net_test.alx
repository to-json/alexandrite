test "vectors: Mask and Equal" {
  assert_eq mask_eq("00000000000000000000ffff6f807514", "ee60940d", "00000000000000000000ffff6f807514"), "6e001404|1"
  assert_eq mask_eq("8091ff2d040f5fdc0000000000000000", "d6d18ba1", "8091ff2d040f5fdc0000000000000000"), "nil|1"
  assert_eq mask_eq("00000000000000000000ffff4d4e2132", "e68d039f", "00000000000000000000ffff4d4e2132"), "440c0112|1"
  assert_eq mask_eq("00000000000000000000ffffecce30f0", "479726e2", "00000000000000000000ffffecce30f0"), "448620e0|1"
  assert_eq mask_eq("00080001000104e000040a6f00040390", "fffffffffffffffffffffffffffffff0", "00080001000104e000040a6f00040390"), "00080001000104e000040a6f00040390|1"
  assert_eq mask_eq("00480822000400a0003303f201eb0006", "ffffffffff0000000000000000000000", "02af133e66db0021001d0003000000d7"), "00480822000000000000000000000000|0"
  assert_eq mask_eq("00000000000000000000ffffeab74621", "118a33c7", "00000000000000000000ffff1d027b65"), "00820201|0"
  assert_eq mask_eq("89010203", "4e8a7f", "00000000000000000000ffff10126bf5"), "nil|0"
  assert_eq mask_eq("9f866f9e", "fffffff0", "00000000000000000000ffff9f866f9e"), "9f866f90|1"
  assert_eq mask_eq("97010203", "fe000000", "00000000000000000000ffff6c00e603"), "96000000|0"
  assert_eq mask_eq("9eb201eb004e00281c2b005e0001025f", "ff800000", "00000000000000000000ffff5876f02f"), "nil|0"
  assert_eq mask_eq("53da9bb83b54000000000000000000c9", "fffffffffffffffffffffffff343b846", "00000000000000000000ffff9a1d8b09"), "53da9bb83b5400000000000000000040|0"
  assert_eq mask_eq("0059039e09b50030011d0006003f13d8", "ffffc000", "0059039e09b50030011d0006003f13d8"), "nil|1"
  assert_eq mask_eq("00000000000000000000ffffb8d00f4d", "fffffe00", "nil"), "b8d00e00|0"
  assert_eq mask_eq("20010db8000000000000000000000001", "ffffffffffffffffffffffff7b790f23", "000001c5005e00140000000316940002"), "20010db8000000000000000000000001|0"
  assert_eq mask_eq("60eaff67", "ffffffffffffffffffffffffb779edf5", "0016015200010000286d00ae00070001"), "2068ed65|0"
  assert_eq mask_eq("00041dbe02bd5fae000302a40de91dc0", "ffffffffffffffffffffffe000000000", "nil"), "00041dbe02bd5fae000302a000000000|0"
  assert_eq mask_eq("ca7c7140", "51895284", "00060047000d1727003741b7000517a5"), "40085000|0"
  assert_eq mask_eq("00631f90003e12880226a35800070f9a", "4c74dc6d", "00631f90003e12880226a35800070f9a"), "nil|1"
  assert_eq mask_eq("5f010203", "d8cf59", "014b001200020008218302fc001300f9"), "nil|0"
  assert_eq mask_eq("ac200001", "fffffffffffffffffffffe0000000000", "00000000000000000000ffff327f0dfb"), "nil|0"
  assert_eq mask_eq("2f010203", "adfe953f", "00000000000000000000ffff2f010203"), "2d000003|1"
  assert_eq mask_eq("00000000000000000000ffff78010203", "5399291f", "00000000000000000000ffff78010203"), "50010003|1"
  assert_eq mask_eq("b6010203", "d59dfb6949d09f014c0388d2826ec785", "nil"), "nil|0"
  assert_eq mask_eq("00000000000000000000ffff42010203", "02fec9dc", "365898bb83b6bd6130480000006d00f8"), "02000000|0"
  assert_eq mask_eq("00002e1b07910225001e00131a17023e", "0a1d9485213ca8792e697ca9381cbb72", "nil"), "00000401011000210008000118140232|0"
  assert_eq mask_eq("c6aa02173d4a0051fd0c000100610134", "fffffffffffffffffffffffffffffff8", "c6aa02173d4a0051fd0c000100610134"), "c6aa02173d4a0051fd0c000100610130|1"
  assert_eq mask_eq("a89652af", "ffffe000", "00000000000000000000ffff51e04629"), "a8964000|0"
  assert_eq mask_eq("005e0003000624435ffa1e5a018700f1", "ffffffffffffffffffffffffffe00000", "00000000000000000000ffff9cde9194"), "005e0003000624435ffa1e5a01800000|0"
