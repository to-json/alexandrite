test "vectors: ParseMAC" {
  assert_eq mac_sum("Ef1::f3x6g"), "ERR address Ef1::f3x6g: invalid MAC address"
  assert_eq mac_sum("c8:16:4b:91:5d:cd:d5:8f"), "c8164b915dcdd58f|c8:16:4b:91:5d:cd:d5:8f"
  assert_eq mac_sum("Abb-FbD5B:daa"), "ERR address Abb-FbD5B:daa: invalid MAC address"
