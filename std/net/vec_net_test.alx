  assert_eq cidr_sum(32, 128), "ffffffff000000000000000000000000|32|128"
  assert_eq cidr_sum(33, 128), "ffffffff800000000000000000000000|33|128"
  assert_eq cidr_sum(64, 128), "ffffffffffffffff0000000000000000|64|128"
  assert_eq cidr_sum(127, 128), "fffffffffffffffffffffffffffffffe|127|128"
  assert_eq cidr_sum(128, 128), "ffffffffffffffffffffffffffffffff|128|128"
  assert_eq cidr_sum(129, 128), "nil"
  assert_eq cidr_sum(1, 129), "nil"
}

