  assert_eq cidr_sum(1, 126), "nil"
  assert_eq cidr_sum(1, 127), "nil"
  assert_eq cidr_sum(-1, 128), "nil"
  assert_eq cidr_sum(0, 128), "00000000000000000000000000000000|0|128"
  assert_eq cidr_sum(1, 128), "80000000000000000000000000000000|1|128"
  assert_eq cidr_sum(7, 128), "fe000000000000000000000000000000|7|128"
  assert_eq cidr_sum(8, 128), "ff000000000000000000000000000000|8|128"
  assert_eq cidr_sum(9, 128), "ff800000000000000000000000000000|9|128"
  assert_eq cidr_sum(16, 128), "ffff0000000000000000000000000000|16|128"
  assert_eq cidr_sum(24, 128), "ffffff00000000000000000000000000|24|128"
