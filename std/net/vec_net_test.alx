  assert_eq cidr_parse("e7:e1e:8:1:24:63c:8848:3/-2", "74a41636ec%7"), "ERR invalid CIDR address: e7:e1e:8:1:24:63c:8848:3/-2"
  assert_eq cidr_parse("4:d1e:.b1d/05", "c:21d:1d9:2e:66bb:0:dbc9:4ae"), "ERR invalid CIDR address: 4:d1e:.b1d/05"
  assert_eq cidr_parse("39.251.171.120/37", "1.2.3"), "ERR invalid CIDR address: 39.251.171.120/37"
  assert_eq cidr_parse("170.47.90.25/76", ":a2a33661f630"), "ERR invalid CIDR address: 170.47.90.25/76"
  assert_eq cidr_parse("248.55.6.154/39", "6:1:b1:7:e49b:7:189:2"), "ERR invalid CIDR address: 248.55.6.154/39"
  assert_eq cidr_parse("11.57.15.91", "2e:f0:d00fd199"), "ERR invalid CIDR address: 11.57.15.91"
  assert_eq cidr_parse("179.204.147.104/91", "1:757c:9:a:20a:38:38:3"), "ERR invalid CIDR address: 179.204.147.104/91"
}

