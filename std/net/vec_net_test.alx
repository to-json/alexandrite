test "vectors: SplitHostPort" {
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp(":"), "|"
  assert_eq shp("::"), "ERR address ::: too many colons in address"
  assert_eq shp("a:"), "a|"
  assert_eq shp(":b"), "|b"
  assert_eq shp("[::1]:80"), "::1|80"
  assert_eq shp("[::1%lo0]:http"), "::1%lo0|http"
  assert_eq shp("a:b:c"), "ERR address a:b:c: too many colons in address"
  assert_eq shp("[a]:b"), "a|b"
  assert_eq shp("[a]b:c"), "ERR address [a]b:c: missing port in address"
  assert_eq shp("a[b]:c"), "ERR address a[b]:c: unexpected '[' in address"
  assert_eq shp("a]b:c"), "ERR address a]b:c: unexpected ']' in address"
  assert_eq shp("[a:b]:c"), "a:b|c"
  assert_eq shp("[[a]]:b"), "ERR address [[a]]:b: missing port in address"
  assert_eq shp("[a]:[b]:c"), "ERR address [a]:[b]:c: too many colons in address"
  assert_eq shp("[]:"), "|"
  assert_eq shp("[]"), "ERR address []: missing port in address"
  assert_eq shp("["), "ERR address [: missing port in address"
  assert_eq shp("]"), "ERR address ]: missing port in address"
  assert_eq shp("[:]:x"), ":|x"
  assert_eq shp(":."), "|."
  assert_eq shp("%.::]%"), "ERR address %.::]%: too many colons in address"
  assert_eq shp("a[[b:%1a"), "ERR address a[[b:%1a: unexpected '[' in address"
  assert_eq shp("1:%.a[:]"), "ERR address 1:%.a[:]: too many colons in address"
  assert_eq shp("]1a"), "ERR address ]1a: missing port in address"
  assert_eq shp("]"), "ERR address ]: missing port in address"
  assert_eq shp("1:][]"), "ERR address 1:][]: unexpected '[' in address"
  assert_eq shp("]ba."), "ERR address ]ba.: missing port in address"
  assert_eq shp("."), "ERR address .: missing port in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp("1]1"), "ERR address 1]1: missing port in address"
  assert_eq shp("b]b:.[b]"), "ERR address b]b:.[b]: unexpected '[' in address"
  assert_eq shp("[]"), "ERR address []: missing port in address"
  assert_eq shp("%[%"), "ERR address %[%: missing port in address"
  assert_eq shp(":.:]["), "ERR address :.:][: too many colons in address"
  assert_eq shp(".1[a"), "ERR address .1[a: missing port in address"
  assert_eq shp(".]:%.]"), "ERR address .]:%.]: unexpected ']' in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp("1"), "ERR address 1: missing port in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp(".%b["), "ERR address .%b[: missing port in address"
  assert_eq shp("1]]"), "ERR address 1]]: missing port in address"
  assert_eq shp(":"), "|"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp(".:%b]."), "ERR address .:%b].: unexpected ']' in address"
  assert_eq shp("[:]:]%1a"), "ERR address [:]:]%1a: unexpected ']' in address"
  assert_eq shp(":"), "|"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp("%:%1"), "%|%1"
  assert_eq shp("]a]"), "ERR address ]a]: missing port in address"
  assert_eq shp("]]"), "ERR address ]]: missing port in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp("bb"), "ERR address bb: missing port in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp("a1"), "ERR address a1: missing port in address"
  assert_eq shp("a[].]."), "ERR address a[].].: missing port in address"
  assert_eq shp("%[]%b"), "ERR address %[]%b: missing port in address"
  assert_eq shp("[:a.%]"), "ERR address [:a.%]: missing port in address"
  assert_eq shp("]["), "ERR address ][: missing port in address"
  assert_eq shp("%:aa["), "ERR address %:aa[: unexpected '[' in address"
  assert_eq shp("ba"), "ERR address ba: missing port in address"
  assert_eq shp("1"), "ERR address 1: missing port in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp("]"), "ERR address ]: missing port in address"
  assert_eq shp("a:][bb."), "ERR address a:][bb.: unexpected '[' in address"
  assert_eq shp("1a[]"), "ERR address 1a[]: missing port in address"
  assert_eq shp("ab%"), "ERR address ab%: missing port in address"
  assert_eq shp(".."), "ERR address ..: missing port in address"
  assert_eq shp("b"), "ERR address b: missing port in address"
  assert_eq shp("ba"), "ERR address ba: missing port in address"
  assert_eq shp("b."), "ERR address b.: missing port in address"
  assert_eq shp("1"), "ERR address 1: missing port in address"
  assert_eq shp(".%"), "ERR address .%: missing port in address"
  assert_eq shp("]"), "ERR address ]: missing port in address"
  assert_eq shp(":b:1[1:"), "ERR address :b:1[1:: too many colons in address"
  assert_eq shp("."), "ERR address .: missing port in address"
  assert_eq shp(".:b["), "ERR address .:b[: unexpected '[' in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp("1a[.1"), "ERR address 1a[.1: missing port in address"
  assert_eq shp("::"), "ERR address ::: too many colons in address"
  assert_eq shp("a%%:."), "a%%|."
  assert_eq shp(":]a11[%"), "ERR address :]a11[%: unexpected '[' in address"
  assert_eq shp("a1[b[["), "ERR address a1[b[[: missing port in address"
  assert_eq shp("baaaba:1"), "baaaba|1"
  assert_eq shp("a1[b%]"), "ERR address a1[b%]: missing port in address"
  assert_eq shp("11]b1"), "ERR address 11]b1: missing port in address"
  assert_eq shp(".aa%b]"), "ERR address .aa%b]: missing port in address"
  assert_eq shp("]b.[1"), "ERR address ]b.[1: missing port in address"
  assert_eq shp("1.]:["), "ERR address 1.]:[: unexpected '[' in address"
  assert_eq shp("%%[a"), "ERR address %%[a: missing port in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp("1b."), "ERR address 1b.: missing port in address"
  assert_eq shp(":a]"), "ERR address :a]: unexpected ']' in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp("[[]]%1["), "ERR address [[]]%1[: missing port in address"
  assert_eq shp(".%1b1:]1"), "ERR address .%1b1:]1: unexpected ']' in address"
  assert_eq shp("1[b%a%"), "ERR address 1[b%a%: missing port in address"
  assert_eq shp(""), "ERR missing port in address"
  assert_eq shp("%1]%[%]b"), "ERR address %1]%[%]b: missing port in address"
}

