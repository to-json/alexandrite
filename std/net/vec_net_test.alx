test "vectors: SplitHostPort 3" {
  assert_eq shp("["), "ERR address [: missing port in address"
  assert_eq shp("a1a[a%%"), "ERR address a1a[a%%: missing port in address"
  assert_eq shp("%][b"), "ERR address %][b: missing port in address"
  assert_eq shp("1%b["), "ERR address 1%b[: missing port in address"
  assert_eq shp("[]%:"), "ERR address []%:: missing port in address"
  assert_eq shp("1:"), "1|"
  assert_eq shp("a"), "ERR address a: missing port in address"
  assert_eq shp("[["), "ERR address [[: missing port in address"
  assert_eq shp("]"), "ERR address ]: missing port in address"
  assert_eq shp(":.1"), "|.1"
  assert_eq shp("%"), "ERR address %: missing port in address"
  assert_eq shp("a[[bb:[1"), "ERR address a[[bb:[1: unexpected '[' in address"
  assert_eq shp("[b"), "ERR address [b: missing port in address"
  assert_eq shp("b.1[%"), "ERR address b.1[%: missing port in address"
  assert_eq shp("]baa["), "ERR address ]baa[: missing port in address"
  assert_eq shp("."), "ERR address .: missing port in address"
  assert_eq shp(".b"), "ERR address .b: missing port in address"
  assert_eq shp("b1a"), "ERR address b1a: missing port in address"
  assert_eq shp("[a1"), "ERR address [a1: missing port in address"
  assert_eq shp("aba]:"), "ERR address aba]:: unexpected ']' in address"
  assert_eq shp("1.."), "ERR address 1..: missing port in address"
  assert_eq shp("::%.%a"), "ERR address ::%.%a: too many colons in address"
  assert_eq shp("1[b"), "ERR address 1[b: missing port in address"
  assert_eq shp(":b[.1:"), "ERR address :b[.1:: too many colons in address"
  assert_eq shp("].%]"), "ERR address ].%]: missing port in address"
  assert_eq shp("a:%"), "a|%"
  assert_eq shp("b]"), "ERR address b]: missing port in address"
  assert_eq shp("%b["), "ERR address %b[: missing port in address"
  assert_eq shp(":["), "ERR address :[: unexpected '[' in address"
  assert_eq shp(".["), "ERR address .[: missing port in address"
  assert_eq shp("1..%a"), "ERR address 1..%a: missing port in address"
