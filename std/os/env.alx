# The environment, the program's arguments, the working directory and the
# user's directories.

# Go's os.Args: the program's arguments; ARGS.load[0] is the program (under
# `alx run`, the .alx file). Package state (R11): a program may replace it.
pub ARGS = Atomic.new(c_args)

def c_args -> [Str] {
  out: [Str] = []
  n = alx_argc
  i = 0
  while i < n {
    out << Str.from_cstr(alx_argv(i))
    i += 1
  }
  out
}

# The program's arguments (ARGS's value).
pub def args -> [Str] { ARGS.load }

# The value of an environment variable, or none if it isn't set (Go's
# LookupEnv). `getenv("X") || ""` is Go's Getenv.
pub def getenv(key: Str) -> Str? {
  return none if key.bytes.any? { |b| b == 0 }
  p = c_getenv(key)
  return none if p.null?
  Str.from_cstr(p)
}

# Go's LookupEnv (the same as getenv).
pub def lookup_env(key: Str) -> Str? { getenv(key) }

# Go's Setenv: fails with EINVAL ("setenv: invalid argument") for an empty
# key or one holding "=" or NUL, or a value holding NUL.
pub def setenv(key: Str, value: Str) -> ~Unit<FsError> {
  bad = key.size == 0 || key.bytes.any? { |b| b == 61 || b == 0 } || value.bytes.any? { |b| b == 0 }
  fail ferr("setenv", c("EINVAL")) if bad
  r = c_setenv(key, value, 1)
  fail ferr("setenv", C.errno) if r != 0
}

# Go's Unsetenv.
pub def unsetenv(key: Str) -> ~Unit<FsError> {
  return if key.size == 0 || key.bytes.any? { |b| b == 61 || b == 0 }
  r = c_unsetenv(key)
  fail ferr("unsetenv", C.errno) if r != 0
}

# Go's Clearenv: removes every variable.
pub def clearenv {
  for kv in environ {
    i = 0
    while i < kv.size && kv[i] != 61 {
      i += 1
    }
    # An entry "=x" has an empty name (Go skips it too).
    c_unsetenv(kv[0...i]) if i > 0
  }
}

# The environment as "KEY=value" strings.
pub def environ -> [Str] {
  out: [Str] = []
  i = 0
  loop {
    p = alx_environ(i)
    break if p.null?
    out << Str.from_cstr(p)
    i += 1
  }
  out
}

# Go's Expand: replaces $var and ${var} in s by mapping(var). A `$` before
# no name stays; bad syntax ("${}", an unclosed "${") is dropped.
pub def expand(s: Str, mapping: (Str) -> Str) -> Str {
  buf: [Byte] = []
  used = false
  i = 0
  j = 0
  while j < s.size {
    if s[j] == 36 && j + 1 < s.size {
      used = true
      for b in s[i...j].bytes { buf << b }
      name, w = shell_name(s[j + 1...s.size])
      if name == "" && w > 0 {
        # Bad syntax: eat it.
      } elsif name == "" {
        buf << s[j]
      } else {
        for b in mapping.call(name).bytes { buf << b }
      }
      j += w
      i = j + 1
    }
    j += 1
  }
  return s if !used
  Str.from_bytes(buf) + s[i...s.size]
}

# Go's ExpandEnv: expand with getenv (unset variables become "").
pub def expand_env(s: Str) -> Str {
  expand(s, ->(k: Str) -> Str { getenv(k) || "" })
}

def shell_special?(b: Byte) -> Bool {
  b == 42 || b == 35 || b == 36 || b == 64 || b == 33 || b == 63 || b == 45 || (b >= 48 && b <= 57)
}

def alpha_num?(b: Byte) -> Bool {
  b == 95 || (b >= 48 && b <= 57) || (b >= 97 && b <= 122) || (b >= 65 && b <= 90)
}

# The variable name at the start of s, and how many bytes it takes.
def shell_name(s: Str) -> (Str, Int) {
  if s[0] == 123 {
    return (s[1...2], 3) if s.size > 2 && shell_special?(s[1]) && s[2] == 125
    i = 1
    while i < s.size {
      if s[i] == 125 {
        return ("", 2) if i == 1
        return (s[1...i], i + 1)
      }
      i += 1
    }
    return ("", 1)
  }
  return (s[0...1], 1) if shell_special?(s[0])
  i = 0
  while i < s.size && alpha_num?(s[i]) {
    i += 1
  }
  (s[0...i], i)
}

# The current working directory (Go's Getwd: $PWD when it names the same
# directory as ".").
pub def getwd -> ~Str<FsError> {
  dot = ~stat(".")
  if pwd = getenv("PWD") {
    if pwd.size > 0 && pwd[0] == 47 {
      d = stat(pwd)
      return pwd if d.ok? && same_file(dot, d.unwrap)
    }
  }
  buf = zeros(4096)
  p = c_getcwd(buf, 4096)
  return cstr_of(buf) if !p.null?
  code = C.errno
  long = code == c("ENAMETOOLONG") || code == c("EINVAL") || code == c("ERANGE") || code == c("ENOMEM")
  fail ferr("getwd", code) if !long
  # Deeper than getcwd can tell: walk up through "..", as Go does.
  cached = GETWD_CACHE.load
  if cached.size > 0 {
    d = stat(cached)
    return cached if d.ok? && same_file(dot, d.unwrap)
  }
  root = ~stat("/")
  return "/" if same_file(root, dot)
  dir = ""
  parent = ".."
  cur = dot
  loop {
    fail ferr("getwd", c("ENAMETOOLONG")) if parent.size >= 1024
    fd = ~open(parent)
    found = false
    loop {
      names = fd.readdirnames!(100)
      if names.err? || names.unwrap.size == 0 {
        _ = fd.close!
        fail ferr("getwd", c("ENAMETOOLONG"))
      }
      for name in names.unwrap {
        l = lstat(parent + "/" + name)
        if l.ok? && same_file(l.unwrap, cur) {
          dir = "/" + name + dir
          found = true
          break
        }
      }
      break if found
    }
    pd = fd.stat
    _ = fd.close!
    pdi = ~pd
    break if same_file(pdi, root)
    cur = pdi
    parent = "../" + parent
  }
  GETWD_CACHE.store(dir)
  dir
}

# Go's getwdCache: the last directory the slow path of getwd found.
GETWD_CACHE = Atomic.new("")

pub def chdir(dir: Str) -> ~Unit<FsError> {
  fail ferr("chdir" + " " + dir, c("EINVAL")) if nul?(dir)
  r = c_chdir(dir)
  fail ferr("chdir" + " " + dir, C.errno) if r != 0
}

# The directory for temporary files: $TMPDIR, else /tmp.
pub def temp_dir -> Str {
  d = getenv("TMPDIR") || ""
  return "/tmp" if d.size == 0
  d
}

# Go's UserHomeDir: $HOME.
pub def user_home_dir -> ~Str<FsError> {
  d = getenv("HOME") || ""
  fail ferr("", ERR_NO_HOME) if d.size == 0
  d
}

# Go's UserConfigDir: ~/Library/Application Support on macOS; else
# $XDG_CONFIG_HOME (absolute) or ~/.config.
pub def user_config_dir -> ~Str<FsError> {
  if darwin? {
    h = getenv("HOME") || ""
    fail ferr("", ERR_NO_HOME) if h.size == 0
    return h + "/Library/Application Support"
  }
  d = getenv("XDG_CONFIG_HOME") || ""
  if d.size > 0 {
    fail ferr("", ERR_CONFIG_RELATIVE) if d[0] != 47
    return d
  }
  h = getenv("HOME") || ""
  fail ferr("", ERR_NO_CONFIG_HOME) if h.size == 0
  h + "/.config"
}

# Go's UserCacheDir: ~/Library/Caches on macOS; else $XDG_CACHE_HOME
# (absolute) or ~/.cache.
pub def user_cache_dir -> ~Str<FsError> {
  if darwin? {
    h = getenv("HOME") || ""
    fail ferr("", ERR_NO_HOME) if h.size == 0
    return h + "/Library/Caches"
  }
  d = getenv("XDG_CACHE_HOME") || ""
  if d.size > 0 {
    fail ferr("", ERR_CACHE_RELATIVE) if d[0] != 47
    return d
  }
  h = getenv("HOME") || ""
  fail ferr("", ERR_NO_CACHE_HOME) if h.size == 0
  h + "/.cache"
}

pub def hostname -> ~Str<FsError> {
  buf = zeros(256)
  r = c_gethostname(buf, 255)
  fail ferr("hostname", C.errno) if r != 0
  cstr_of(buf)
}

# The path of the running executable (Go's Executable). Under `alx run` (the
# JIT) that is the alx compiler itself.
pub def executable -> ~Str<FsError> {
  buf = zeros(4096)
  n = alx_sys_executable(buf, 4096)
  fail ferr("executable", -n) if n < 0
  Str.from_bytes(buf[0...n])
}
