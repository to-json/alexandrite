#![test(external)]
# Go's os/env_test.go and env_unix_test.go, translated.

import "os"

def test_getenv(s: Str) -> Str {
  case s {
    "*" => "all the args"
    "#" => "NARGS"
    "$" => "PID"
    "1" => "ARGUMENT1"
    "HOME" => "/usr/gopher"
    "H" => "(Value of H)"
    "home_1" => "/usr/foo"
    "_" => "underscore"
    _ => ""
  }
}

def expand_tests -> [(Str, Str)] {
  [
  ("", ""),
  ("$*", "all the args"),
  ("$$", "PID"),
  ("${*}", "all the args"),
  ("$1", "ARGUMENT1"),
  ("${1}", "ARGUMENT1"),
  ("now is the time", "now is the time"),
  ("$HOME", "/usr/gopher"),
  ("$home_1", "/usr/foo"),
  ("${HOME}", "/usr/gopher"),
  ("${H}OME", "(Value of H)OME"),
  ("A$$$#$1$H$home_1*B", "APIDNARGSARGUMENT1(Value of H)/usr/foo*B"),
  ("start$+middle$^end$", "start$+middle$^end$"),
  ("mixed$|bag$$$", "mixed$|bagPID$"),
  ("$", "$"),
  ("$}", "$}"),
  ("${", ""),  # invalid syntax; eat up the characters
  ("${}", ""), # invalid syntax; eat up the characters
  ]
}

test "Expand" {
  for tc in expand_tests {
    assert_eq os.expand(tc[0]) { |k| test_getenv(k) }, tc[1]
  }
}

test "ConsistentEnviron" {
  e0 = os.environ
  for _i in 0...10 {
    assert e0 == os.environ, "environment changed"
  }
}

test "Unsetenv" {
  test_key = "GO_TEST_UNSETENV"
  set = ->() -> Bool { os.environ.any? { |kv| kv.start_with?("GO_TEST_UNSETENV=") } }
  os.setenv(test_key, "1").unwrap
  assert set.call, "Setenv didn't set TestUnsetenv"
  os.unsetenv(test_key).unwrap
  assert !set.call, "Unsetenv didn't clear TestUnsetenv"
}

test "Clearenv" {
  test_key = "GO_TEST_CLEARENV"
  orig = os.environ
  os.setenv(test_key, "1").unwrap
  assert os.lookup_env(test_key) != none, "Setenv didn't set $#{test_key}"
  os.clearenv
  got = os.lookup_env(test_key)
  restore(orig)
  assert got == none, "Clearenv() didn't clear $#{test_key}, remained with value #{got}"
  assert_eq os.environ.size, orig.size
}

def restore(env: [Str]) {
  for pair in env {
    i = 1
    while i < pair.size && pair[i] != 61 {
      i += 1
    }
    os.setenv(pair[0...i], pair[i + 1...pair.size]).unwrap
  }
}

test "LookupEnv" {
  smallpox = "SMALLPOX" # No one has smallpox.
  assert os.lookup_env(smallpox) == none, "#{smallpox} is set"
  os.setenv(smallpox, "virus").unwrap
  ok = os.lookup_env(smallpox) != none
  os.unsetenv(smallpox).unwrap
  assert ok, "smallpox release failed; world remains safe but LookupEnv is broken"
}

test "EnvironConsistency" {
  for kv in os.environ {
    i = 1
    while i < kv.size && kv[i] != 61 {
      i += 1
    }
    assert i < kv.size, "Environ entry missing '=': #{kv}"
    k = kv[0...i]
    v = kv[i + 1...kv.size]
    v2 = os.lookup_env(k)
    assert v2 == v, "Environ contains #{kv}, but LookupEnv(#{k}) = #{v2}"
    r = os.setenv(k, v)
    assert r.ok?, "Environ contains #{kv}, but SetEnv(#{k}, #{v}) = #{r.err}"
  }
}

test "SetenvUnixEinval" {
  nul = Str.from_bytes([0])
  for tc in [("", ""), ("k=v", ""), (nul, ""), ("k", nul)] {
    e = os.setenv(tc[0], tc[1]).err
    assert e != none, "Setenv(#{tc[0]}, #{tc[1]}) == nil, want error"
    assert_eq e.unwrap.message, "setenv: invalid argument"
  }
}

test "ExpandEnvShellSpecialVar" {
  for tc in [("*", "asterisk"), ("#", "pound"), ("$", "dollar"), ("@", "at"), ("!", "exclamation mark"), ("?", "question mark"), ("-", "dash")] {
    os.setenv(tc[0], tc[1]).unwrap
    raw = os.expand_env("$" + tc[0])
    brace = os.expand_env("${" + tc[0] + "}")
    os.unsetenv(tc[0]).unwrap
    assert raw == brace, "ExpandEnv($#{tc[0]}) = #{raw}, ExpandEnv(${#{tc[0]}}) = #{brace}; expect them to be equal"
    assert_eq raw, tc[1]
  }
}
