#![test(external)]
# Go's os/example_test.go, translated. Go only compiles the examples without
# an Output comment; here they run too, in a temp directory.

import "os"
import "fmt"
import "path/filepath"

# Runs f in a fresh temp directory, then removes it.
def in_temp_dir(f: () -> Unit) {
  wd = os.getwd.unwrap
  d = os.mkdir_temp("", "alx-os-example").unwrap
  os.chdir(d).unwrap
  f.call
  os.chdir(wd).unwrap
  os.remove_all(d).unwrap
}

example "OpenFile" {
  in_temp_dir {
    f = os.open_file("notes.txt", os.O_RDWR | os.O_CREATE, 0o644).unwrap
    f.close!.unwrap
  }
} outputs ""

example "OpenFile append" {
  in_temp_dir {
    f = os.open_file("access.log", os.O_APPEND | os.O_CREATE | os.O_WRONLY, 0o644).unwrap
    f.write!("appended some data\n".bytes.to_a).unwrap
    f.close!.unwrap
  }
} outputs ""

example "Chmod" {
  in_temp_dir {
    os.write_file("some-filename", [], 0o600).unwrap
    os.chmod("some-filename", 0o644).unwrap
  }
} outputs ""

example "Chtimes" {
  in_temp_dir {
    os.write_file("some-filename", [], 0o600).unwrap
    mtime = 1138763045 * 1_000_000_000 # 2006-02-01 03:04:05 UTC
    atime = 1172808306 * 1_000_000_000 # 2007-03-02 04:05:06 UTC
    os.chtimes("some-filename", atime, mtime).unwrap
  }
} outputs ""

example "FileMode" {
  in_temp_dir {
    os.write_file("some-filename", [], 0o400).unwrap
    fi = os.lstat("some-filename").unwrap
    puts fmt.sprintf("permissions: %#o", fi.perm)
    if fi.is_regular {
      puts "regular file"
    } elsif fi.is_dir {
      puts "directory"
    } elsif fi.is_symlink {
      puts "symbolic link"
    } elsif fi.is_named_pipe {
      puts "named pipe"
    }
  }
} outputs "permissions: 0400\nregular file\n"

example "ErrNotExist" {
  filename = "a-nonexistent-file"
  if e = os.stat(filename).err {
    puts "file does not exist" if os.is_not_exist(e)
  }
} outputs "file does not exist\n"

example "Expand" {
  mapper = ->(placeholder_name: Str) -> Str {
    case placeholder_name {
      "DAY_PART" => "morning"
      "NAME" => "Gopher"
      _ => ""
    }
  }
  puts os.expand("Good ${DAY_PART}, $NAME!", mapper)
} outputs "Good morning, Gopher!\n"

example "ExpandEnv" {
  os.setenv("NAME", "gopher").unwrap
  os.setenv("BURROW", "/usr/gopher").unwrap
  puts os.expand_env("$NAME lives in ${BURROW}.")
} outputs "gopher lives in /usr/gopher.\n"

example "LookupEnv" {
  show = ->(key: Str) {
    if val = os.lookup_env(key) {
      puts "#{key}=#{val}"
    } else {
      puts "#{key} not set"
    }
  }
  os.setenv("SOME_KEY", "value").unwrap
  os.setenv("EMPTY_KEY", "").unwrap
  show.call("SOME_KEY")
  show.call("EMPTY_KEY")
  show.call("MISSING_KEY")
} outputs "SOME_KEY=value\nEMPTY_KEY=\nMISSING_KEY not set\n"

example "Getenv" {
  os.setenv("NAME", "gopher").unwrap
  os.setenv("BURROW", "/usr/gopher").unwrap
  puts "#{os.getenv("NAME") || ""} lives in #{os.getenv("BURROW") || ""}."
} outputs "gopher lives in /usr/gopher.\n"

example "Unsetenv" {
  old = os.getenv("TMPDIR")
  os.setenv("TMPDIR", "/my/tmp").unwrap
  os.unsetenv("TMPDIR").unwrap
  if o = old {
    os.setenv("TMPDIR", o).unwrap
  }
} outputs ""

example "ReadDir" {
  in_temp_dir {
    os.write_file("b.txt", [], 0o644).unwrap
    os.mkdir("a", 0o755).unwrap
    for file in os.read_dir(".").unwrap {
      puts file.name
    }
  }
} outputs "a\nb.txt\n"

example "MkdirTemp" {
  dir = os.mkdir_temp("", "example").unwrap
  file = filepath.join([dir, "tmpfile"])
  os.write_file(file, "content".bytes, 0o666).unwrap
  os.remove_all(dir).unwrap
} outputs ""

example "MkdirTemp suffix" {
  logs_dir = os.mkdir_temp("", "*-logs").unwrap
  assert logs_dir.end_with?("-logs")
  os.remove_all(logs_dir).unwrap
} outputs ""

example "CreateTemp" {
  f = os.create_temp("", "example").unwrap
  f.write!("content".bytes.to_a).unwrap
  f.close!.unwrap
  os.remove(f.name).unwrap
} outputs ""

example "CreateTemp suffix" {
  f = os.create_temp("", "example.*.txt").unwrap
  f.write!("content".bytes.to_a).unwrap
  f.close!.unwrap
  os.remove(f.name).unwrap
} outputs ""

example "ReadFile" {
  in_temp_dir {
    os.mkdir("testdata", 0o755).unwrap
    os.write_file("testdata/hello", "Hello, Gophers!".bytes, 0o644).unwrap
    data = os.read_file("testdata/hello").unwrap
    out = os.stdout
    out.write!(data).unwrap
  }
} outputs "Hello, Gophers!"

example "WriteFile" {
  in_temp_dir {
    os.mkdir("testdata", 0o755).unwrap
    os.write_file("testdata/hello", "Hello, Gophers!".bytes, 0o666).unwrap
  }
} outputs ""

example "Mkdir" {
  in_temp_dir {
    r = os.mkdir("testdir", 0o750)
    if e = r.err {
      assert os.is_exist(e)
    }
    os.write_file("testdir/testfile.txt", "Hello, Gophers!".bytes, 0o660).unwrap
  }
} outputs ""

example "MkdirAll" {
  in_temp_dir {
    os.mkdir_all("test/subdir", 0o750).unwrap
    os.write_file("test/subdir/testfile.txt", "Hello, Gophers!".bytes, 0o660).unwrap
  }
} outputs ""

example "Readlink" {
  d = os.mkdir_temp("", "").unwrap
  target_path = filepath.join([d, "hello.txt"])
  os.write_file(target_path, "Hello, Gophers!".bytes, 0o644).unwrap
  link_path = filepath.join([d, "hello.link"])
  os.symlink("hello.txt", link_path).unwrap
  dst = os.readlink(link_path).unwrap
  puts "#{filepath.base(link_path)} links to #{dst}"
  dst_abs = filepath.is_abs(dst) ? dst : filepath.join([filepath.dir(link_path), dst])
  dst_info = os.stat(dst_abs).unwrap
  target_info = os.stat(target_path).unwrap
  assert os.same_file(dst_info, target_info), "link destination (#{dst_abs}) is not the same file as #{target_path}"
  os.remove_all(d).unwrap
} outputs "hello.link links to hello.txt\n"

example "UserCacheDir" {
  r = os.user_cache_dir
  dir = r.ok? ? filepath.join([r.unwrap, "ExampleUserCacheDir"]) : ""
  _ = dir
} outputs ""

example "UserConfigDir" {
  r = os.user_config_dir
  if d = r.ok {
    config_path = filepath.join([d, "ExampleUserConfigDir", "example.conf"])
    orig = os.read_file(config_path)
    if e = orig.err {
      assert os.is_not_exist(e)
    }
  }
} outputs ""
