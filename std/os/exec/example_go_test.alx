#![test(external)]
# Go's os/exec example_test.go, translated. Go only compiles the examples
# without an Output comment; those run here too, with outputs that don't
# depend on the machine.

import "os"
import "os/exec"
import "io"
import "bytes"
import "strings"
import "strconv"
import "context"
import "time"
import "encoding/json"

example "LookPath" {
  r = exec.look_path("sh")
  puts r.ok? ? "sh is available" : "installing sh is in your future"
} outputs "sh is available\n"

example "Command" {
  cmd = exec.command("tr", ["a-z", "A-Z"])
  cmd.stdin_reader = strings.new_reader("some input")
  out = bytes.new_buffer([])
  cmd.stdout = out
  cmd.run.unwrap
  puts "in all caps: #{strconv.quote(out.string)}"
} outputs "in all caps: \"SOME INPUT\"\n"

example "Command environment" {
  cmd = exec.command("/bin/sh", ["-c", "echo $FOO"])
  cmd.env = os.environ + ["FOO=duplicate_value", "FOO=actual_value"]
  print cmd.output.unwrap
} outputs "actual_value\n"

example "Cmd Output" {
  out = exec.command("date", ["-u", "-r", "0"]).output
  # (macOS's date; GNU date reads -r as a file.)
  if o = out.ok {
    puts o.size > 0
  } else {
    puts true
  }
} outputs "true\n"

example "Cmd Run" {
  cmd = exec.command("sleep", ["0.01"])
  r = cmd.run
  puts "Command finished with error: #{r.err}"
} outputs "Command finished with error: none\n"

example "Cmd Start" {
  cmd = exec.command("sleep", ["0.01"])
  cmd.start!.unwrap
  r = cmd.wait!
  puts "Command finished with error: #{r.err}"
} outputs "Command finished with error: none\n"

example "Cmd StdoutPipe" {
  cmd = exec.command("echo", ["-n", "{\"Name\": \"Bob\", \"Age\": 32}"])
  stdout = cmd.stdout_pipe!.unwrap
  cmd.start!.unwrap
  data = io.read_all(stdout).unwrap
  v = json.parse(Str.from_bytes(data)).unwrap
  cmd.wait!.unwrap
  puts "#{v.get("Name").unwrap.as_str.unwrap} is #{v.get("Age").unwrap.as_int.unwrap} years old"
} outputs "Bob is 32 years old\n"

example "Cmd StdinPipe" {
  cmd = exec.command("cat", [])
  stdin = cmd.stdin_pipe!.unwrap
  w = stdin
  writer = spawn {
    f = w
    f.write_string!("values written to stdin are passed to cmd's standard input").unwrap
    f.close!.unwrap
    0
  }
  # Go's CombinedOutput runs while the goroutine writes; the writer task
  # does here.
  out = cmd.combined_output.unwrap
  writer.wait.unwrap
  puts out
} outputs "values written to stdin are passed to cmd's standard input\n"

example "Cmd StderrPipe" {
  cmd = exec.command("sh", ["-c", "echo stdout; echo 1>&2 stderr"])
  stderr = cmd.stderr_pipe!.unwrap
  cmd.start!.unwrap
  slurp = io.read_all(stderr).unwrap
  puts Str.from_bytes(slurp)
  cmd.wait!.unwrap
} outputs "stderr\n\n"

example "Cmd CombinedOutput" {
  cmd = exec.command("sh", ["-c", "echo stdout; echo 1>&2 stderr"])
  puts cmd.combined_output.unwrap
} outputs "stdout\nstderr\n\n"

example "Cmd Environ" {
  cmd = exec.command("/bin/sh", ["-c", "pwd"])
  cmd.dir = "/"
  cmd.env = cmd.environ + ["POSIXLY_CORRECT=1"]
  puts cmd.output.unwrap
} outputs "/\n\n"

example "CommandContext" {
  ctx, cancel = context.with_timeout(context.background, time.millisecond * 100)
  r = exec.command_context(ctx, "sleep", ["5"]).run
  cancel.call
  puts r.err?
} outputs "true\n"
