# Package exec: Go's os/exec — run other programs — plus pipelines and
# redirects, so scripts don't need a shell.
#
#   c = exec.command("go", ["build", "-o", "app", "."])
#   c.dir = "/src/app"                     # Go: cmd.Dir
#   c.env = os.environ + ["CGO_ENABLED=0"] # Go: cmd.Env (none: inherit ours)
#   out = c.~output                        # stdout; fails on a nonzero exit
#
# The same, as a command literal (backticks; each #{} is one argument, never
# split or re-parsed, so there is nothing to quote):
#
#   out = `go build -o #{name} .`.~output
#   n = `cat #{f} | grep -c error`.~output
#   `make 2>&1 > build.log`.~run
#
# A literal understands words, '...' and "..." quoting, `|` and the redirects
# `< f`, `> f`, `>> f`, `2> f`, `2>> f`, `&> f`, `2>&1` and `>&2` (applied left
# to right, as in sh). There is no globbing, no variables and no `&&` / `;`:
# that is what the surrounding program is for. Relative redirect paths are
# relative to `dir`.
#
#   Go                                      alx
#   Command(name, args...)                  command(name, args) (looks name up now; a
#                                             failure is kept in `err`, Go's Cmd.Err)
#   CommandContext(ctx, name, args...)      command_context(ctx, name, args)
#   Cmd.Path / Args / Dir / Env             path (lpath) / args / dir / env ([Str]?)
#   Cmd.Stdin / Stdout / Stderr             stdin_reader (io.Reader?), stdin (a Str: the
#                                             text to give), stdout / stderr (io.Writer?);
#                                             an os.File is handed to the child as is
#   Cmd.ExtraFiles / WaitDelay / Err        extra_files / wait_delay (ns) / err
#   Cmd.Cancel                              cancel: ((os.Process) -> ~Unit)?, given the process;
#                                             command_context's default (kill) is
#                                             `kill_on_cancel` (Go's `Cancel = nil`: set it false)
#   Cmd.Process / ProcessState              process -> os.Process? / process_state -> os.ProcessState?
#   Run / Start / Wait                      run -> ~os.ProcessState / start! / wait!
#   Output / CombinedOutput                 output -> ~Str / combined_output -> ~Str
#   StdinPipe / StdoutPipe / StderrPipe     stdin_pipe! / stdout_pipe! / stderr_pipe! -> ~os.File
#   String / Environ                        string (Go's) / environ; to_s is the sh-quoted line
#   LookPath(file)                          look_path(file) -> ~Str<ExecError>
#   Error{Name, Err}                        ExecError.NotFound(name) / Lookup(name, errno) /
#                                             Dot(name, path); e.name
#   ErrNotFound / ErrDot / ErrWaitDelay     not_found?(e) / dot?(e) / wait_delay?(e)
#   ExitError{ProcessState, Stderr}         ExecError.Exit(ExitInfo(cmd, state, stderr));
#                                             exit_info(e) -> ExitInfo?; info.exit_code
#   (not in Go)                             capture -> ~Captured (stdout, stderr, state,
#                                             states; no failure on a nonzero exit),
#                                             pipe(other) (`a | b`), exec (syscall.Exec),
#                                             passthrough, check
#
# A nonzero exit fails with ExecError.Exit (like `set -e`). With the
# environment variable ALX_EXEC_NOFAIL=1, run/output/combined_output/wait!
# return normally instead and the status is the caller's to check;
# `c.check = false` does the same for one command. A pipeline fails if any
# stage does (`pipefail`), except an earlier stage killed by SIGPIPE
# (`yes | head`). `run` sends output nowhere (Go) unless `passthrough` (a
# literal sets it: `make`.~run shows make's output) or stdout/stderr are set.
#
# A ProcessState (os's) has what Go's has, plus measurements taken by the
# wait: `exit_code` (-1 if killed), `signal` (0 if not killed), `success`,
# `user_ns` / `sys_ns` (CPU time), `max_rss` (peak resident set, bytes) and
# `wall_ns` (spawn to exit).
#
# Differences from Go:
#  - ExitError's message names the command and adds its stderr text:
#    "`sh -c 'exit 4'`: exit status 4: bad" (Go: "exit status 4", which
#    `info.go_message` is); scripts print the error and want to know what
#    failed. (S10: alx's text where alx deliberately differs.)
#  - The copying between the program and stdin_reader / stdout / stderr
#    (when they aren't os.Files) happens in wait!, in the waiting task (Go:
#    goroutines from Start on): the writer is the caller's, and a task can't
#    share it unsynchronized (R4). A program that writes more than a pipe
#    holds waits for wait!; read a *_pipe! instead to consume output before
#    waiting.
#  - Cancel gets the process (Go's closures reach cmd.Process; an alx
#    closure made before Start can't), and Cancel = nil is
#    `kill_on_cancel = false`.
#  - Wait's errors: as Go's, but "exec: canceling Cmd: ..." is a plain
#    ExecError.Usage (no %w unwrapping); the context's own error is
#    returned as is.
#  - wait_delay is an Int of nanoseconds (Go: time.Duration).
#  - `c.timeout = time.Duration` (not in Go; CommandContext with a deadline
#    in one field): a deadline wait! keeps itself (no context or task), as
#    well as `ctx`'s. When it passes before the command (every stage)
#    has exited, the stages are killed (SIGKILL; Cancel instead when set),
#    reaped, and the wait fails with ExecError.Timeout, whatever `check`
#    says; its info has the stderr captured so far and the ProcessState
#    (signal 9). Only the stages are killed, not their children (no process
#    groups; wait_delay bounds the copying after). Zero (the default) means
#    no limit.
#  - Memory (port-issues #273): no task runs per command unless a context
#    is watched (command_context with a cancelable ctx); a Cmd doesn't hold
#    its context (a slot in CTXS, taken out at start: a copy of a Cmd made
#    before start and started after the original runs without it), and
#    command copies the name and args. wait! finds the exits by wait4 once
#    the pipes are done, or by polling them (1-50 ms) while a WaitDelay or
#    a timeout with no pipes needs them sooner.
#  - SysProcAttr doesn't exist (no syscall package).
#  - Output's ExitError.Stderr keeps Go's 32 KiB prefix and suffix; capture
#    keeps everything.
#
# Tests: Go's exec_test.go, exec_posix_test.go, lp_unix_test.go,
# lp_test.go, dot_test.go, env_test.go (dedupEnv), internal_test.go
# (prefixSuffixSaver) and example_test.go are translated; Go re-runs its test
# binary as the helper commands (echo, cat, pipetest, stdinClose, exit,
# stderrfail, yes, hang, pwd), which are sh scripts and standard tools here.
# Vectors from Go: vec_exec_test.alx (Cmd.String, exec.Error and ExitError
# texts). Not translated: TestCredentialNoSetGroups (SysProcAttr),
# TestSIGCHLD (a helper notifying SIGCHLD in a Go child), the SIGQUIT case of
# TestWaitInterrupt (a Go goroutine dump), TestExtraFiles' listener and TLS
# parts (a file stands in), lp_windows/exec_windows/exec_linux tests,
# benchmarks.

import "context"
import "io"
import "os"
import "path"
import "strconv"
import "strings"
import "time"

extern def alx_sys_spawn2(path: Str, argv: [Byte], argc: Int, env: [Byte], envc: Int, dir: Str, fds: [Byte], nfds: Int) -> Int
extern def alx_sys_exec(argv: [Byte], argc: Int, env: [Byte], envc: Int, dir: Str, fd0: Int, fd1: Int, fd2: Int) -> Int
extern def alx_sys_wait(pid: Int, out: [Byte]) -> Int
extern def alx_sys_pipe(out: [Byte], nonblock: Int) -> Int
extern def alx_sys_polln_until(blob: [Byte], n: Int, until: Int) -> Int
extern def alx_sys_wait_nohang(pid: Int, out: [Byte]) -> Int
extern def alx_fd_wait(fd: Int, mode: Int) -> Int
extern def alx_fd_close(fd: Int) -> Int
extern def alx_sys_open(p: Str, flags: I32, mode: I32) -> I32
extern def alx_sys_const(name: Str) -> Int
extern def alx_mono_ns -> Int
extern def c_read(fd: I32, buf: [Byte], n: Int) -> Int = "read"
extern def c_write(fd: I32, buf: [Byte], n: Int) -> Int = "write"
extern def c_access(p: Str, mode: I32) -> I32 = "access"

# A run that exited nonzero or was killed (Go's ExitError): the command line
# (`to_s`), the ProcessState and the stderr text (output: what the command
# wrote to stderr, when stderr wasn't set; Go's ExitError.Stderr).
pub struct ExitInfo {
  cmd: Str
  state: os.ProcessState
  stderr: Str

  # Go's ExitError.Error(): the ProcessState's text, "exit status 1".
  pub def go_message -> Str { state.to_s }
  # Go's ExitError.ExitCode().
  pub def exit_code -> Int { state.exit_code }
}

pub error ExecError {
  # Go's exec.Error{Name, ErrNotFound}.
  NotFound(name: Str)
  # The spawn failed (Go's "fork/exec name: errno").
  Start(name: Str, code: Int)
  # A redirect's file can't be opened (command literals).
  Redirect(file: Str, code: Int)
  # Ran and exited nonzero or was killed (Go's ExitError).
  Exit(info: ExitInfo)
  # Go's exec.Error{Name, Err} for another reason: an errno (EACCES: not
  # executable, EISDIR, ENOENT for a path).
  Lookup(name: Str, code: Int)
  # Go's exec.Error{Name, ErrDot}: found only relative to "." (at `path`).
  Dot(name: Str, path: Str)
  # Go's errors.New("exec: ...") misuse and state errors: "exec: already
  # started", "exec: not started", "exec: Wait was already called",
  # "exec: Stdout already set", "exec: no command", "exec: environment
  # variable contains NUL", ErrWaitDelay, "exec: canceling Cmd: ...".
  Usage(msg: Str)
  # `timeout` passed before the command exited: it was killed (not in Go;
  # Go's is the context's DeadlineExceeded).
  Timeout(info: ExitInfo)

  def message -> Str {
    case self {
      NotFound(n) => "exec: #{strconv.quote(n)}: executable file not found in $PATH"
      Start(n, code) => "fork/exec #{n}: #{os.errno_message(code)}"
      Redirect(f, code) => "open #{f}: #{os.errno_message(code)}"
      Exit(info) => exit_message(info)
      Lookup(n, code) => "exec: #{strconv.quote(n)}: #{os.errno_message(code)}"
      Dot(n, _p) => "exec: #{strconv.quote(n)}: cannot run executable found relative to current directory"
      Usage(m) => m
      Timeout(info) => "`#{info.cmd}`: timed out after #{info.state.wall_ns / 1000000}ms, killed"
    }
  }

  # Go's exec.Error.Name (none for the other errors).
  pub def name -> Str? {
    case self {
      NotFound(n) => n
      Lookup(n, _c) => n
      Dot(n, _p) => n
      _ => none
    }
  }
}

# Go's ErrWaitDelay text.
pub ERR_WAIT_DELAY = "exec: WaitDelay expired before I/O complete"

def exit_message(info: ExitInfo) -> Str {
  m = "`#{info.cmd}`: #{info.state.to_s}"
  err = strings.trim_space(info.stderr)
  return m if err.size == 0
  "#{m}: #{err}"
}

# Go's errors.Is(err, exec.ErrNotFound) / ErrDot / ErrWaitDelay, and
# errors.As(err, &exitErr).
pub def not_found?(e: Error) -> Bool {
  case e {
    ExecError.NotFound => true
    _ => false
  }
}

pub def dot?(e: Error) -> Bool {
  case e {
    ExecError.Dot => true
    _ => false
  }
}

pub def wait_delay?(e: Error) -> Bool {
  case e {
    ExecError.Usage(m) => m == ERR_WAIT_DELAY
    _ => false
  }
}

# The ExitInfo of an ExecError.Exit (Go's errors.As(err, &*ExitError)).
pub def exit_info(e: Error) -> ExitInfo? {
  case e {
    ExecError.Exit(info) => info
    _ => none
  }
}

# What `capture` returns: the output and how the process ended (for a
# pipeline, `state` decides the status and `states` has every stage's).
pub struct Captured {
  stdout: Str
  stderr: Str
  state: os.ProcessState
  states: [os.ProcessState]

  pub def success -> Bool { state.success }
}

# A redirect of one stage, applied in order: kind is one of the R_* below.
pub struct Redir {
  kind: Int
  file: Str
}

pub R_IN = 0         # < file
pub R_OUT = 1        # > file
pub R_APPEND = 2     # >> file
pub R_ERR = 3        # 2> file
pub R_ERR_APPEND = 4 # 2>> file
pub R_ERR_TO_OUT = 5 # 2>&1
pub R_OUT_TO_ERR = 6 # >&2
pub R_BOTH = 7       # &> file

# One program of a pipeline: its argv and its redirects.
pub struct Stage {
  args: [Str]
  redirs: [Redir]
}

# The state of a started Cmd, shared by its copies (D36).
struct RunState {
  pids: [Int]
  t0s: [Int]
  procs: [os.Process]
  # The copying wait! does, one per pipe: kind P_FEED (stdin_reader into
  # fd), P_POUR_OUT / P_POUR_ERR (fd into stdout / stderr), P_CAP_OUT /
  # P_CAP_ERR (fd captured). fd is the parent's (non-blocking) end; -1 once
  # done.
  pumps: [Pump]
  # `timeout`'s deadline (alx_mono_ns; 0: none), and whether it passed
  # and wait! killed the stages.
  deadline: Int
  timed_out: Bool
  # The first error copying to or from stdin_reader / stdout / stderr.
  copy_err: ExecError?
  # The context watcher (a task), when there is one.
  watch: [Watch]
  states: [os.ProcessState]
  waited: Bool
  out: [Byte]
  errb: [Byte]

  # The bytes captured for kind 1 (stdout) or 2 (stderr).
  def out_bytes(kind: Int) -> [Byte] { kind == 1 ? out : errb }
}

# The task watching a Cmd's context: wait! closes `finished` when the
# processes have ended; the watcher answers the context's error on `res`.
# Only a Cmd with a cancelable context has one. Everything a task holds
# lives in the program region, so neither the Cmd nor its RunState may
# reach one: the watcher gets its context from CTXS, not from the Cmd
# (port-issues #273).
struct Watch {
  finished: Chan[Bool]
  res: Chan[Error?]
}

P_FEED = 0
P_POUR_OUT = 1
P_POUR_ERR = 2
P_CAP_OUT = 3
P_CAP_ERR = 4

struct Pump {
  kind: Int
  fd: Int
}

# What to run: one or more stages (`a | b`). `args` of the first stage are
# Go's cmd.Args (args[0] is the program); `path` is Go's cmd.Path.
pub struct Cmd {
  stages: [Stage]
  dir: Str                         # "" = this process's directory
  env: [Str]?                      # "KEY=value" entries; none = this process's environment
  stdin: Str?                      # the text to give the program (Go: Stdin = strings.NewReader(s))
  passthrough: Bool                # run: stdout/stderr to ours instead of the null device
  check: Bool                      # fail on a nonzero exit (default: unless ALX_EXEC_NOFAIL=1)
  stdin_reader: io.Reader?         # Go's Stdin (an os.File is passed to the child as is)
  stdout: io.Writer?               # Go's Stdout
  stderr: io.Writer?               # Go's Stderr
  extra_files: [os.File]           # Go's ExtraFiles: the child's 3, 4, ...
  wait_delay: Int                  # Go's WaitDelay (nanoseconds; 0: none)
  cancel: ((os.Process) -> ~Unit)? # Go's Cancel, given the process
  kill_on_cancel: Bool             # Go's default Cancel (command_context): kill it
  ctx_id: Int                      # Go's ctx (command_context): its slot in CTXS (0: none)
  err: ExecError?                  # Go's Err: a lookup failure from command()
  lpath: Str                       # Go's Path when it differs from args[0]
  child_files: [os.File]           # the child's ends of the *_pipe! pipes
  parent_files: [os.File]          # their parent ends (closed by wait!)
  st: [RunState]                   # once started
  started: Bool                    # start was called (even if it failed)
  timeout: time.Duration           # > 0: kill it after this long, fail with ExecError.Timeout (not in Go)

  # Go's cmd.Path: the program's path (looked up in $PATH by command()).
  pub def path -> Str { lpath.size > 0 || stages.size == 0 || stages[0].args.size == 0 ? lpath : stages[0].args[0] }
  # Go's cmd.Args, of the first stage ([path] if none, as Go's argv()).
  pub def args -> [Str] { stages.size == 0 || stages[0].args.size == 0 ? [path] : stages[0].args }

  # Go's cmd.Process: the (last stage's) process once started.
  pub def process -> os.Process? {
    return none if st.size == 0 || st[0].procs.size == 0
    st[0].procs[st[0].procs.size - 1]
  }

  # Go's cmd.ProcessState: how it ended, once waited for.
  pub def process_state -> os.ProcessState? {
    return none if st.size == 0 || st[0].states.size == 0
    deciding(st[0].states)
  }

  # Runs to completion (Go's Run). Output is discarded unless `passthrough`
  # or stdout/stderr are set.
  pub def run -> ~os.ProcessState {
    sa = [~start_run(0)]
    ~finish(sa, check)
    deciding(sa[0].states)
  }

  # Its standard output (Go's Output). A nonzero exit is ExecError.Exit with
  # the stderr text (when stderr isn't set).
  pub def output -> ~Str {
    fail ExecError.Usage("exec: Stdout already set") if stdout != none
    sa = [~start_run(1)]
    ~finish(sa, check)
    Str.from_bytes(sa[0].out)
  }

  # Standard output and error, interleaved as written (Go's CombinedOutput).
  pub def combined_output -> ~Str {
    fail ExecError.Usage("exec: Stdout already set") if stdout != none
    fail ExecError.Usage("exec: Stderr already set") if stderr != none
    sa = [~start_run(3)]
    ~finish(sa, check)
    Str.from_bytes(sa[0].out)
  }

  # Runs it and returns both outputs and the ProcessState; fails only if it
  # can't be started (a nonzero exit is in `state`). Not in Go.
  #
  # run, output, combined_output and capture keep the run's state in a
  # local (`sa`), not in a copy of the Cmd: what is stored into a copy of a
  # parameter goes to the program region (port-issues #273).
  pub def capture -> ~Captured {
    sa = [~start_run(1)]
    ~finish(sa, false)
    s = sa[0]
    Captured.new(stdout: Str.from_bytes(s.out_bytes(1)), stderr: Str.from_bytes(s.out_bytes(2)), state: deciding(s.states), states: s.states.dup)
  }

  # Starts it (Go's Start); wait! waits for it.
  pub def start! -> ~Unit {
    self.~start_with!(0)
  }

  # Waits for it to exit and its I/O copying to finish (Go's Wait). The
  # copying between the program and stdin_reader / stdout / stderr happens
  # here, in the waiting task: a program writing more than a pipe holds
  # waits for wait! (Go copies from Start on, in goroutines; an alx task
  # can't share the writer with the caller unsynchronized).
  pub def wait! -> ~Unit {
    fail ExecError.Usage("exec: not started") if st.size == 0
    fail ExecError.Usage("exec: Wait was already called") if st[0].waited
    self.st[0].waited = true
    ~finish(st, check)
  }

  # wait! for the state in sa[0] (`chk`: fail on a nonzero exit). Its
  # errors are copies: one holding both self's and sa's storage would tie
  # the two together (and send sa to the program region).
  def finish(sa: [RunState], chk: Bool) -> ~Unit {
    s = sa[0]
    pump(sa)
    copy_err = sa[0].copy_err
    states = sa[0].states
    for p in s.procs {
      q = p
      q.release!.unwrap
    }
    state = deciding(states)
    failure: Error? = none
    if chk && !state.success {
      failure = ExecError.Exit(ExitInfo.new(cmd: own(to_s), state: state, stderr: Str.from_bytes(prefix_suffix(sa[0].errb, 32 << 10).dup)))
    }
    werr: Error? = none
    if s.watch.size > 0 {
      wt = s.watch[0]
      wt.finished.close
      w = wt.res.recv
      if e = w {
        werr = e
      }
    }
    if sa[0].timed_out {
      failure = ExecError.Timeout(ExitInfo.new(cmd: own(to_s), state: state, stderr: Str.from_bytes(sa[0].errb.dup)))
    } elsif failure == none {
      if e = werr {
        failure = e
      }
    }
    if failure == none {
      if ce = copy_err {
        failure = ce
      }
    }
    close_files(parent_files)
    if e = failure {
      fail e
    }
  }

  # Copies between the pipes and the readers / writers until every pipe is
  # done and the processes have exited (WaitDelay bounds the copying once
  # they have), and reaps them; kills them when `timeout` passes. No task
  # waits for the processes: a task's storage lives in the program region
  # (port-issues #273). Exits are found by blocking waits once the pipes
  # are done, or by polling (wait4 WNOHANG, every 1-50 ms) while something
  # needs them earlier: a WaitDelay with pipes still open, a deadline with
  # no pipes. The first copy error goes to `copy_err` (not returned: a
  # result tied to self would send all it touches to the program region).
  def pump(sa: [RunState]) {
    s = sa[0]
    pumps = s.pumps
    pids = s.pids
    np = pids.size
    # Made at their size, not pushed onto `[]`: a push onto an empty array
    # placed in another's region allocates in the program region (an
    # empty array has no storage to find its region by; port-issues #273).
    sts: [os.ProcessState] = [os.ProcessState.new; np]
    reaped: [Bool] = [false; np]
    nreaped = 0
    wb: [Byte] = [0; 40]
    deadline = s.deadline
    killed = false
    delay_at = 0 # when WaitDelay ends (alx_mono_ns), once they have exited
    delay_over = false
    kill_at = 0 # Cancel was called at the deadline: kill after WaitDelay
    backoff = 1000000
    first: ExecError? = none
    pending: [Byte] = []
    feed_eof = false
    buf: [Byte] = [0; 65536]
    # stdin_reader and the stdout / stderr writers get their own buffer:
    # what an interface call is given lives in the program region
    # (port-issues #178, #273), so `buf` stays out of their reach and this
    # one is made only when a reader or writer is set (once per run).
    xbuf: [Byte] = []
    eagain = alx_sys_const("EAGAIN")
    loop {
      open = pumps.any? { |p| p.fd >= 0 }
      break if nreaped == np && !open
      if !open && (deadline == 0 || killed) && kill_at == 0 {
        # Only the processes are left, and nothing to watch the clock for.
        for j in 0...np {
          next if reaped[j]
          alx_sys_wait(pids[j], wb)
          sts[j] = state_of(pids[j], wb, alx_mono_ns - s.t0s[j])
          reaped[j] = true
          nreaped += 1
        }
        next
      }
      # Exits are needed before the pipes are done: poll for them.
      watch_exit = nreaped < np && (!open || (wait_delay > 0 && delay_at == 0))
      until = 0
      until = deadline if deadline > 0 && !killed
      until = delay_at if delay_at > 0 && !delay_over && (until == 0 || delay_at < until)
      until = kill_at if kill_at > 0 && (until == 0 || kill_at < until)
      if watch_exit {
        t = alx_mono_ns + backoff
        until = t if until == 0 || t < until
        backoff = backoff * 2 if backoff < 50000000
      }
      n = 0
      for p in pumps { n += 1 if p.fd >= 0 }
      blob: [Byte] = [0; 16 * (n > 0 ? n : 1)]
      n = 0
      for p in pumps {
        next if p.fd < 0
        set_pair(blob, n, p.fd, p.kind == P_FEED ? 2 : 1)
        n += 1
      }
      # A feed with bytes waiting to be read from its reader doesn't wait.
      feeding = pumps.any? { |p| p.kind == P_FEED && p.fd >= 0 } && pending.size == 0 && !feed_eof
      alx_sys_polln_until(blob, n, until) if !feeding
      if watch_exit {
        for j in 0...np {
          next if reaped[j]
          if alx_sys_wait_nohang(pids[j], wb) == 1 {
            sts[j] = state_of(pids[j], wb, alx_mono_ns - s.t0s[j])
            reaped[j] = true
            nreaped += 1
          }
        }
      }
      now = alx_mono_ns
      if nreaped == np && wait_delay > 0 && delay_at == 0 && open {
        delay_at = now + wait_delay
      }
      # `timeout` passed: kill what hasn't exited (Cancel, when set, gets
      # the last stage, as from a context).
      if deadline > 0 && !killed && now >= deadline && nreaped < np {
        killed = true
        sa[0].timed_out = true
        live: [Int] = []
        for j in 0...np { live << pids[j] if !reaped[j] }
        if f0 = cancel {
          g = f0.dup
          _ = g.call(os.new_process(pids[np - 1]))
          kill_at = now + wait_delay if wait_delay > 0
        } else {
          _ = kill_all(live)
        }
      }
      if kill_at > 0 && now >= kill_at {
        kill_at = 0
        live: [Int] = []
        for j in 0...np { live << pids[j] if !reaped[j] }
        _ = kill_all(live)
      }
      # WaitDelay expired: Go closes the pipes and returns ErrWaitDelay.
      if delay_at > 0 && !delay_over && now >= delay_at {
        delay_over = true
        for i in 0...pumps.size {
          if pumps[i].fd >= 0 {
            alx_fd_close(pumps[i].fd)
            pumps[i].fd = -1
          }
        }
        first = ExecError.Usage(ERR_WAIT_DELAY) if first == none
        next
      }
      for i in 0...pumps.size {
        p = pumps[i]
        next if p.fd < 0
        if p.kind == P_FEED {
          if pending.size == 0 && !feed_eof {
            if r = stdin_reader {
              rd = r
              xbuf = [0.as_u8; 65536] if xbuf.size == 0
              got = rd.read!(xbuf)
              if e = got.err {
                first = ExecError.Usage(own(e.message)) if first == none
                feed_eof = true
              } elsif got.unwrap == 0 {
                feed_eof = true
              } else {
                pending = xbuf[0...got.unwrap].dup
              }
            }
          }
          if pending.size > 0 {
            w = c_write(p.fd.to_i32, pending, pending.size)
            if w > 0 {
              pending = pending[w...pending.size]
            } elsif w < 0 && C.errno != eagain {
              # The program stopped reading (EPIPE): no error, as in Go.
              alx_fd_close(p.fd)
              pumps[i].fd = -1
              pending = []
            }
          } elsif feed_eof {
            alx_fd_close(p.fd)
            pumps[i].fd = -1
          }
          next
        }
        r = c_read(p.fd.to_i32, buf, buf.size)
        if r > 0 {
          chunk = buf[0...r]
          if p.kind == P_CAP_OUT {
            for x in chunk { sa[0].out << x }
          } elsif p.kind == P_CAP_ERR {
            for x in chunk { sa[0].errb << x }
          } else {
            wr = p.kind == P_POUR_OUT ? stdout : stderr
            if w = wr {
              dst = w
              xbuf = [0.as_u8; 65536] if xbuf.size == 0
              copy(xbuf, chunk)
              res = dst.write!(xbuf[0...r])
              if e = res.err {
                # Go's copier stops, closing its end (the writer gets EPIPE).
                first = ExecError.Usage(own(e.message)) if first == none
                alx_fd_close(p.fd)
                pumps[i].fd = -1
              }
            }
          }
        } elsif r == 0 || C.errno != eagain {
          alx_fd_close(p.fd)
          pumps[i].fd = -1
        }
      }
    }
    sa[0].states = sts
    sa[0].copy_err = first
  }

  # Go's StdinPipe: the write end of a pipe that will be the program's
  # stdin; close it to send end of file.
  pub def stdin_pipe! -> ~os.File {
    fail ExecError.Usage("exec: Stdin already set") if stdin_reader != none || stdin != none
    fail ExecError.Usage("exec: StdinPipe after process started") if st.size > 0
    r, w = ~os.pipe
    self.stdin_reader = r
    self.child_files << r
    self.parent_files << w
    w
  }

  # Go's StdoutPipe: the read end of a pipe the program's stdout writes to.
  # Read it to the end before wait! (wait! closes it).
  pub def stdout_pipe! -> ~os.File {
    fail ExecError.Usage("exec: Stdout already set") if stdout != none
    fail ExecError.Usage("exec: StdoutPipe after process started") if st.size > 0
    r, w = ~os.pipe
    self.stdout = w
    self.child_files << w
    self.parent_files << r
    r
  }

  # Go's StderrPipe.
  pub def stderr_pipe! -> ~os.File {
    fail ExecError.Usage("exec: Stderr already set") if stderr != none
    fail ExecError.Usage("exec: StderrPipe after process started") if st.size > 0
    r, w = ~os.pipe
    self.stderr = w
    self.child_files << w
    self.parent_files << r
    r
  }

  # This command's stdout feeding `to`'s stdin (`a | b`). The result keeps
  # this command's dir, env, stdin and flags. Not in Go.
  pub def pipe(to: Cmd) -> Cmd {
    r = self
    r.stages = stages + to.stages
    r
  }

  # Replaces this process with the command (Go's syscall.Exec, applying dir,
  # env and redirects). Returns only if that fails.
  pub def exec -> ~Unit {
    fail ExecError.Start("exec", alx_sys_const("EINVAL")) if stages.size != 1
    st0 = stages[0]
    fd0 = ~stdin_fd
    fds = ~apply_redirs(st0.redirs, [fd0, -1, -1])
    env_v = ~environ_checked
    r = alx_sys_exec(argv_blob(prog_args(st0.args)), st0.args.size, env_blob(env_v), env_count(env_v), dir, fds[0], fds[1], fds[2])
    fail ExecError.NotFound(st0.args[0]) if r == -alx_sys_const("ENOENT")
    fail ExecError.Start(st0.args[0], -r)
  }

  # The command line, for messages: `go build -o app .`, quoted for sh.
  pub def to_s -> Str {
    parts: [Str] = []
    for st0 in stages {
      words: [Str] = []
      for a in st0.args { words << show_word(a) }
      for r in st0.redirs { words << show_redir(r) }
      parts << words.join(" ")
    }
    parts.join(" | ")
  }

  # Go's Cmd.String: the path (resolved) and the arguments, space-separated
  # (args as given when the lookup failed).
  pub def string -> Str {
    a = args
    return a.join(" ") if err != none
    ([path] + a[1...a.size]).join(" ")
  }

  # Go's Cmd.Environ: the environment the command would run with (env, or
  # ours plus PWD=dir; duplicates dropped, the last one kept).
  pub def environ -> [Str] {
    r = environ_of
    r[0]
  }

  def environ_checked -> ~[Str]? {
    if e = env {
      r = dedup_env(e)
      fail ExecError.Usage(r[1]) if r[1] != ""
      return r[0]
    }
    return none if dir == ""
    r = environ_of
    fail ExecError.Usage(r[1]) if r[1] != ""
    r[0]
  }

  def environ_of -> ([Str], Str) {
    e = env || os.environ
    if env == none && dir != "" {
      wd = (os.getwd.ok || "")
      d = strings.has_prefix(dir, "/") ? dir : path.join([wd, dir])
      e = e + ["PWD=" + path.clean(d)]
    }
    dedup_env(e)
  }

  # Starts every stage. mode: 0 per the fields (Go's Start), 1 stdout and
  # stderr captured (stderr only if unset), 3 both captured together.
  def start_with!(mode: Int) -> ~Unit {
    r = start_run(mode)
    self.started = true
    s = ~r
    self.st = [s]
  }

  # Starts every stage (start_with! without the bookkeeping in self): the
  # run's state, which holds nothing of self's (see capture).
  def start_run(mode: Int) -> ~RunState {
    fail ExecError.Usage("exec: already started") if st.size > 0 || started
    # The context leaves CTXS here: only the watcher needs it from now on.
    ctx = take_ctx(ctx_id)
    r0 = self.prepare_check(ctx)
    if r0.err? {
      close_files(child_files)
      close_files(parent_files)
      ~r0
    }
    env_v = r0.unwrap
    s = RunState.new(out: empty_bytes, errb: empty_bytes)
    to_close: [Int] = []
    pumps: [Pump] = []
    failure: Error? = none
    # stdin of the first stage.
    in_fd = -1
    if r = stdin_reader {
      case r {
        os.File(f) => in_fd = f.fd
        _ => {
          p = os_pipe(2)
          if p.ok? {
            pr, pw = p.unwrap
            in_fd = pr
            to_close << pr
            pumps << Pump.new(kind: P_FEED, fd: pw)
          } else {
            failure = p.err
          }
        }
      }
    } elsif text = stdin {
      fd = feeder_fd(text)
      if fd.ok? {
        in_fd = fd.unwrap
        to_close << in_fd
      } else {
        failure = fd.err
      }
    } else {
      fd = open_null(0)
      if fd.ok? {
        in_fd = fd.unwrap
        to_close << in_fd
      } else {
        failure = fd.err
      }
    }
    # stdout and stderr of the stages.
    out_fd = -1
    err_fd = -1
    if failure == none {
      o = writer_fd(stdout, mode == 1 || mode == 3, P_POUR_OUT, P_CAP_OUT)
      if o.ok? {
        w = o.unwrap
        out_fd = w[0]
        to_close << w[0] if w[1]
        pumps << w[2] if w[2].fd >= 0
      } else {
        failure = o.err
      }
    }
    if failure == none {
      if mode == 3 || (stderr != none && stdout != none && stderr == stdout) {
        err_fd = out_fd
      } else {
        er = writer_fd(stderr, mode == 1 && stderr == none, P_POUR_ERR, P_CAP_ERR)
        if er.ok? {
          w = er.unwrap
          err_fd = w[0]
          to_close << w[0] if w[1]
          pumps << w[2] if w[2].fd >= 0
        } else {
          failure = er.err
        }
      }
    }
    # The stages (a Cmd made with only a path runs [path]).
    stages_v = stages
    stages_v = [Stage.new(args: args, redirs: [])] if stages.size == 0 || stages[0].args.size == 0
    n = stages_v.size
    prev_read = in_fd
    i = 0
    while i < n && failure == none {
      st0 = stages_v[i]
      link = (-1, -1)
      if i + 1 < n {
        r = os_pipe(0)
        if !r.ok? {
          failure = r.err
          break
        }
        link = r.unwrap
        to_close << link[0]
        to_close << link[1]
      }
      stage_out = i + 1 < n ? link[1] : out_fd
      fds_r = apply_redirs(st0.redirs, [prev_read, stage_out, err_fd])
      if !fds_r.ok? {
        failure = fds_r.err
        break
      }
      fds = fds_r.unwrap
      for k in 3...fds.size { to_close << fds[k] }
      prog = i == 0 ? path : stages_v[i].args[0]
      # A Path given without lookup runs relative to dir (Go).
      if !strings.contains(prog, "/") && !(i == 0 && lpath != "") {
        lp = look_path(prog)
        if e = lp.err {
          failure = e
          break
        }
        prog = lp.unwrap
      }
      prog = prog_path(prog, i == 0 && lpath != "")
      all: [Int] = [fds[0], fds[1], fds[2]]
      for f in extra_files { all << f.fd }
      t0 = alx_mono_ns
      pid = alx_sys_spawn2(prog, argv_blob(st0.args), st0.args.size, env_blob(env_v), env_count(env_v), dir, fd_blob(all), all.size)
      if pid < 0 {
        failure = ExecError.Start(i == 0 ? path : prog, -pid)
        break
      }
      s.pids << pid
      s.t0s << t0
      s.procs << os.new_process(pid)
      prev_read = link[0]
      i += 1
    }
    # The parent keeps only its ends.
    for fd in to_close { alx_fd_close(fd) if fd >= 0 }
    close_files(child_files)
    if f = failure {
      close_files(parent_files)
      for p in pumps { alx_fd_close(p.fd) }
      # Stages already started are waited for.
      for pid in s.pids {
        b: [Byte] = [0; 40]
        alx_sys_wait(pid, b)
      }
      fail f
    }
    s.pumps = pumps
    s.deadline = s.t0s[0] + timeout.ns if timeout.ns > 0
    # Go's watchCtx: on cancellation, call Cancel (and kill after WaitDelay).
    if c = ctx {
      if c.cancelable? && (cancel != none || kill_on_cancel || wait_delay != 0) {
        cx = c # a Context is #[shareable]: tasks may hold it
        cf: ((os.Process) -> ~Unit)? = none
        if f0 = cancel {
          cf = f0.dup
        }
        kill = kill_on_cancel
        wpids = s.pids.dup
        fin = Chan[Bool].new(0)
        res = Chan[Error?].new(1)
        s.watch = [Watch.new(finished: fin, res: res)]
        delay = wait_delay
        spawn {
          canceled = false
          select {
            when _ = fin.recv => canceled = false
            when _ = cx.done.recv => canceled = true
          }
          e: Error? = none
          if canceled {
            last = os.new_process(wpids[wpids.size - 1])
            r: ~Unit = ok_unit
            interrupted = false
            if f = cf {
              r = f.call(last)
              interrupted = true
            } elsif kill {
              r = kill_all(wpids)
              interrupted = true
            }
            if interrupted {
              if er = r.err {
                e = ExecError.Usage("exec: canceling Cmd: #{er.message}") if !os.is_process_done(er)
              } else {
                e = cx.err.unwrap
              }
            }
            if delay > 0 {
              killed = false
              select {
                when _ = fin.recv => killed = false
                when _ = time.after(time.nanosecond * delay).recv => killed = true
              }
              if killed {
                _ = kill_all(wpids)
              }
            }
          }
          res << e
        }
      }
    }
    s
  }

  # Checks before a start (Go's Start): the lookup error, no command, a
  # Cancel without a context, a cancelled context, a NUL in the
  # environment. The environment to run with (none: ours).
  def prepare_check(ctx: context.Context?) -> ~[Str]? {
    if e = err {
      fail e
    }
    fail ExecError.Usage("exec: no command") if path == ""
    fail ExecError.Usage("exec: command with a non-nil Cancel was not created with CommandContext") if (cancel != none || kill_on_cancel) && ctx == none
    if c = ctx {
      if e = c.err {
        fail e
      }
    }
    ~environ_checked
  }

  # The child's stdout or stderr descriptor for writer w: (fd, whether the
  # parent closes it after the start, the pump wait! runs (fd -1: none)).
  # An os.File is passed as is; another writer gets a pipe poured into it;
  # `cap` captures; else the null device, or ours with passthrough.
  def writer_fd(w: io.Writer?, cap: Bool, pour: Int, capk: Int) -> ~(Int, Bool, Pump) {
    nop = Pump.new(kind: 0, fd: -1)
    if cap {
      pr, pw = ~os_pipe(1)
      return (pw, true, Pump.new(kind: capk, fd: pr))
    }
    if wr = w {
      case wr {
        os.File(f) => return (f.fd, false, nop)
        _ => {
          pr, pw = ~os_pipe(1)
          return (pw, true, Pump.new(kind: pour, fd: pr))
        }
      }
    }
    return (-1, false, nop) if passthrough
    fd = ~open_null(1)
    (fd, true, nop)
  }

  # The child's stdin for a `stdin` text: a pipe already holding it,
  # written by a task while the child reads, so any size works.
  def feeder_fd(s: Str) -> ~Int {
    # The write end is non-blocking: see alx_fd_wait below.
    b: [Byte] = [0; 16]
    r = alx_sys_pipe(b, 2)
    fail ExecError.Start("pipe", -r) if r < 0
    p = (get64(b, 0), get64(b, 1))
    w = p[1]
    # What the pipe holds at once goes in now; a task writes the rest
    # (only then: what a task holds is never freed, port-issues #273).
    data0 = s.bytes
    n0 = data0.size == 0 ? 0 : c_write(w.to_i32, data0, data0.size)
    n0 = 0 if n0 < 0
    if n0 == data0.size {
      alx_fd_close(w)
      return p[0]
    }
    data = data0[n0...data0.size].dup
    spawn {
      eagain = alx_sys_const("EAGAIN")
      off = 0
      while off < data.size {
        n = c_write(w.to_i32, data[off...data.size], data.size - off)
        if n < 0 {
          break if C.errno != eagain
          break if alx_fd_wait(w, 2) < 0
          next
        }
        off += n
      }
      alx_fd_close(w)
    }
    p[0]
  }

  def stdin_fd -> ~Int {
    if s = stdin {
      return ~feeder_fd(s)
    }
    ~open_null(0)
  }

  # A relative program path with a slash (or any relative Path given as
  # such) is relative to `dir` (as in Go).
  def prog_path(p: Str, given: Bool) -> Str {
    return p if strings.has_prefix(p, "/") || (!given && !strings.contains(p, "/"))
    return "./" + p if dir == "" && !strings.contains(p, "/")
    return p if dir == ""
    path.join([dir, p])
  }

  def prog_args(a: [Str]) -> [Str] {
    [prog_path(a[0], false)] + a[1...a.size]
  }

  # fds [stdin, stdout, stderr] after the redirects, in order; files opened
  # are appended (for the caller to close).
  def apply_redirs(rs: [Redir], start: [Int]) -> ~[Int] {
    fds = start
    opened: [Int] = []
    for r in rs {
      k = r.kind
      if k == R_ERR_TO_OUT {
        fds[2] = fds[1]
      } elsif k == R_OUT_TO_ERR {
        fds[1] = fds[2]
      } else {
        fd = open_redir(r)
        if !fd.ok? {
          for o in opened { alx_fd_close(o) }
        }
        f = ~fd
        opened << f
        fds[0] = f if k == R_IN
        fds[1] = f if k == R_OUT || k == R_APPEND || k == R_BOTH
        fds[2] = f if k == R_ERR || k == R_ERR_APPEND || k == R_BOTH
      }
    }
    fds + opened
  }

  def open_redir(r: Redir) -> ~Int {
    p = r.file
    p = path.join([dir, p]) if dir != "" && !strings.has_prefix(p, "/")
    k = r.kind
    flags = alx_sys_const("O_CLOEXEC")
    if k == R_IN {
      flags |= alx_sys_const("O_RDONLY")
    } else {
      flags |= alx_sys_const("O_WRONLY") | alx_sys_const("O_CREAT")
      flags |= (k == R_APPEND || k == R_ERR_APPEND) ? alx_sys_const("O_APPEND") : alx_sys_const("O_TRUNC")
    }
    fd = alx_sys_open(p, flags.to_i32, 0o644)
    fail ExecError.Redirect(r.file, C.errno) if fd < 0
    fd.to_i
  }
}

def ok_unit -> ~Unit {}

def kill_all(pids: [Int]) -> ~Unit {
  first: Error? = none
  for pid in pids {
    r = os.new_process(pid).kill
    first = r.err if first == none && r.err?
  }
  if e = first {
    fail e
  }
}

def close_files(fs: [os.File]) {
  for f in fs {
    g = f
    _ = g.close!
  }
}

# Pair i of b set to (fd, mode), two native-endian int64s.
def set_pair(b: [Byte], i: Int, fd: Int, mode: Int) {
  k = 0
  while k < 8 {
    b[16 * i + k] = ((fd >> (8 * k)) & 255).as_u8
    b[16 * i + 8 + k] = ((mode >> (8 * k)) & 255).as_u8
    k += 1
  }
}

# An empty byte array with storage (a slice of one byte): pushing onto it
# allocates in the region it was made in, where a push onto `[]` of an
# array placed in another's region allocates in the program region
# (port-issues #273).
def empty_bytes -> [Byte] {
  b: [Byte] = [0; 1]
  b[0...0]
}

# The contexts of Cmds made by command_context and not started yet: a Cmd
# holds its slot number (ctx_id), start takes it out. A Cmd holding the
# context itself would follow it into the program region, with all it
# holds, as soon as the watcher task got it (port-issues #273). Slots are
# reused; a Cmd never started keeps its slot.
CTXS = Mutex[[context.Context?]].new([])

def hold_ctx(c: context.Context) -> Int {
  CTXS.lock { |xs|
    i = 0
    while i < xs.size && xs[i] != none { i += 1 }
    if i == xs.size {
      xs << c
    } else {
      xs[i] = c
    }
    i + 1
  }
}

def take_ctx(id: Int) -> context.Context? {
  return none if id <= 0
  CTXS.lock { |xs|
    c: context.Context? = none
    if id <= xs.size {
      c = xs[id - 1]
      xs[id - 1] = none
    }
    c
  }
}

# A Cmd for `name args...` (Go's Command): a name without a slash is looked
# up in $PATH now; a failure is kept in `err` and returned by run/start!.
pub def command(name: Str, args: [Str]) -> Cmd {
  # Copies of the strings: a Cmd holding its caller's strings ties them
  # to everything later stored in it, and a helper that builds and returns
  # a Cmd from its parameters would put all of it in the program region
  # (port-issues #271, #273). Not `[name] + args` either: combining two
  # parameters ties each to the other (#272).
  argv: [Str] = []
  argv << own(name)
  for a in args { argv << own(a) }
  c = Cmd.new(stages: [Stage.new(args: argv, redirs: [])], dir: "", env: none, stdin: none, passthrough: false, check: default_check)
  if !strings.contains(name, "/") && name != "" {
    # The lookup's result is kept and may hold the name (an error): given
    # the caller's string, it and all the lookup made (a stat per $PATH
    # entry) would live in the program region.
    nm = own(name)
    lp = look_path(nm)
    if e = lp.err {
      c.err = e
      if p = lookup_path(nm) {
        c.lpath = p
      }
    } else {
      c.lpath = lp.unwrap
    }
  }
  c
}

# A copy of s that shares nothing with it (see command).
def own(s: Str) -> Str {
  b: [Byte] = []
  for x in s.bytes { b << x }
  Str.from_bytes(b)
}

# Go's CommandContext: command(name, args) whose process is killed (Go's
# default Cancel) when ctx is done before it exits.
pub def command_context(ctx: context.Context, name: Str, args: [Str]) -> Cmd {
  c = command(name, args)
  c.ctx_id = hold_ctx(ctx)
  c.kill_on_cancel = true
  c
}

# The Cmd a command literal builds, from the parser's split: one group per
# word ([w]), per `#{*xs}` (xs, kind 10) and per operator ([""], kind: 1 `|`,
# 2.. a redirect R_* + 2, whose file is the next group's word).
pub def from_literal(groups: [[Str]], kinds: [Int]) -> Cmd {
  stages: [Stage] = []
  args: [Str] = []
  redirs: [Redir] = []
  i = 0
  while i < groups.size {
    k = kinds[i]
    if k == 0 || k == 10 {
      for w in groups[i] { args << w }
    } elsif k == 1 {
      stages << Stage.new(args: args, redirs: redirs)
      args = []
      redirs = []
    } elsif k - 2 == R_ERR_TO_OUT || k - 2 == R_OUT_TO_ERR {
      redirs << Redir.new(kind: k - 2, file: "")
    } else {
      redirs << Redir.new(kind: k - 2, file: groups[i + 1][0])
      i += 1
    }
    i += 1
  }
  stages << Stage.new(args: args, redirs: redirs)
  c = Cmd.new(stages: stages, dir: "", env: none, stdin: none, passthrough: true, check: default_check)
  name = stages[0].args.size > 0 ? stages[0].args[0] : ""
  if name != "" && !strings.contains(name, "/") {
    lp = look_path(name)
    if e = lp.err {
      c.err = e
    } else {
      c.lpath = lp.unwrap
    }
  }
  c
}

def default_check -> Bool { (os.getenv("ALX_EXEC_NOFAIL") || "") != "1" }

# The path of the executable `name` would run (Go's LookPath): itself if it
# has a slash, else the first match in $PATH. A match relative to the
# current directory (a "." or relative $PATH entry) fails with Dot (Go's
# ErrDot; the path is returned by lookup_path).
pub def look_path(name: Str) -> ~Str<ExecError> {
  fail ExecError.NotFound(name) if name == "" || name == "." || name == ".."
  if strings.contains(name, "/") {
    code = find_executable(name)
    return name if code == 0
    fail ExecError.Lookup(name, code)
  }
  if p = lookup_path(name) {
    fail ExecError.Dot(name, p) if !strings.has_prefix(p, "/") && !strings.contains(os.getenv("GODEBUG") || "", "execerrdot=0")
    return p
  }
  fail ExecError.NotFound(name)
}

# The first $PATH match for name, relative or not.
def lookup_path(name: Str) -> Str? {
  pv = os.getenv("PATH") || ""
  # Go's filepath.SplitList: an empty $PATH has no entries.
  dirs: [Str] = pv == "" ? [] : pv.split(":")
  for d in dirs {
    p = path.join([d == "" ? "." : d, name])
    return p if find_executable(p) == 0
  }
  none
}

# Go's findExecutable: 0, or the errno why the file isn't one.
def find_executable(p: Str) -> Int {
  # A copy: the stat's result (and its error) holds the name, and would
  # be placed with p's storage, which may be the program region's.
  r = os.stat(own(p))
  if e = r.err {
    return e.errno
  }
  info = r.unwrap
  return alx_sys_const("EISDIR") if info.is_dir
  return 0 if c_access(p, 1) == 0
  return C.errno if (info.mode & 0o111) == 0
  0
}

# Go's dedupEnv: later entries win, order kept; an entry with NUL is dropped
# (and reported). (The environment, the error text or "".)
pub def dedup_env(env: [Str]) -> ([Str], Str) {
  dedup_env_case(false, false, env)
}

# Go's dedupEnvCase: keys compared without case if no_case; NUL allowed if
# nul_ok.
def dedup_env_case(no_case: Bool, nul_ok: Bool, env: [Str]) -> ([Str], Str) {
  err = ""
  out: [Str] = []
  saw: Map[Str, Bool] = {}
  n = env.size
  while n > 0 {
    kv = env[n - 1]
    n -= 1
    if !nul_ok && kv.bytes.any? { |b| b == 0 } {
      err = "exec: environment variable contains NUL"
      next
    }
    i = strings.index(kv, "=")
    i = strings.index(kv[1...kv.size], "=") + 1 if i == 0
    if i < 0 {
      out << own(kv) if kv != ""
      next
    }
    k = kv[0...i]
    k = strings.to_lower(k) if no_case
    next if saw.key?(k)
    saw[k] = true
    # Copies: a result holding the caller's strings would be tied to them
    # (a Cmd's environment, for start: port-issues #273).
    out << own(kv)
  }
  (out.reverse, err)
}

# Go's prefixSuffixSaver over the bytes b: the first and last n bytes, with
# "... omitting N bytes ..." between when there were more.
def prefix_suffix(b: [Byte], n: Int) -> [Byte] {
  return b if b.size <= 2 * n
  out = b[0...n].dup
  for x in "\n... omitting #{b.size - 2 * n} bytes ...\n".bytes { out << x }
  for x in b[b.size - n...b.size] { out << x }
  out
}

def env_count(e: [Str]?) -> Int {
  if v = e {
    return v.size
  }
  -1
}

def env_blob(e: [Str]?) -> [Byte] {
  b: [Byte] = []
  if v = e {
    b = argv_blob(v)
  }
  b << 0
  b
}

def fd_blob(fds: [Int]) -> [Byte] {
  b: [Byte] = [0; 8 * fds.size]
  i = 0
  while i < fds.size {
    v = fds[i]
    k = 0
    while k < 8 {
      b[i * 8 + k] = ((v >> (8 * k)) & 255).as_u8
      k += 1
    }
    i += 1
  }
  b
}

def state_of(pid: Int, b: [Byte], wall: Int) -> os.ProcessState {
  killed = get64(b, 0) == 1
  code = get64(b, 1)
  os.ProcessState.new(pid: pid, exit_code: killed ? -1 : code, signal: killed ? code : 0, user_ns: get64(b, 2), sys_ns: get64(b, 3), max_rss: get64(b, 4), wall_ns: wall)
}

# The state deciding a pipeline's status: the last stage's, unless an earlier
# one failed (not by SIGPIPE).
def deciding(states: [os.ProcessState]) -> os.ProcessState {
  i = 0
  while i + 1 < states.size {
    s = states[i]
    return s if !s.success && s.signal != alx_sys_const("SIGPIPE")
    i += 1
  }
  states[states.size - 1]
}

def argv_blob(xs: [Str]) -> [Byte] {
  b: [Byte] = []
  for a in xs {
    for x in a.bytes { b << x }
    b << 0
  }
  b
}

def show_word(w: Str) -> Str {
  return "''" if w.size == 0
  i = 0
  while i < w.size {
    c = w[i]
    plain = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46 || c == 47 || c == 61 || c == 58 || c == 44 || c == 43 || c == 64
    return "'" + strings.replace_all(w, "'", "'\\''") + "'" if !plain
    i += 1
  }
  w
}

def show_redir(r: Redir) -> Str {
  case r.kind {
    0 => "< #{show_word(r.file)}"
    1 => "> #{show_word(r.file)}"
    2 => ">> #{show_word(r.file)}"
    3 => "2> #{show_word(r.file)}"
    4 => "2>> #{show_word(r.file)}"
    5 => "2>&1"
    6 => ">&2"
    _ => "&> #{show_word(r.file)}"
  }
}

# Two pipe ends: (read, write); nonblock: bit 0 the read end, bit 1 the
# write end.
def os_pipe(nonblock: Int) -> ~(Int, Int)<ExecError> {
  b: [Byte] = [0; 16]
  r = alx_sys_pipe(b, nonblock)
  fail ExecError.Start("pipe", -r) if r < 0
  (get64(b, 0), get64(b, 1))
}

def open_null(mode: Int) -> ~Int<ExecError> {
  fd = alx_sys_open("/dev/null", (mode | alx_sys_const("O_CLOEXEC")).to_i32, 0)
  fail ExecError.Start("/dev/null", C.errno) if fd < 0
  fd.to_i
}

# The k-th native-endian (little-endian) Int of b.
def get64(b: [Byte], k: Int) -> Int {
  v = 0
  i = 7
  while i >= 0 {
    v = (v << 8) | b[k * 8 + i].to_i
    i -= 1
  }
  v
}
