import "os"
import "strings"
import "time"

def t(s: Str) -> Str { strings.trim_space(s) }

test "output, args stay whole" {
  assert_eq t(command("printf", ["%s|", "a b", "c"]).output.unwrap), "a b|c|"
}

test "capture: status, both streams, resources" {
  c = command("sh", ["-c", "echo out; echo err >&2; exit 3"]).capture.unwrap
  assert_eq t(c.stdout), "out"
  assert_eq t(c.stderr), "err"
  assert_eq c.state.exit_code, 3
  assert !c.state.success
  assert_eq c.state.to_s, "exit status 3"
  assert c.state.max_rss > 0
  assert c.state.wall_ns > 0
}

test "a nonzero exit fails, with stderr in the message" {
  r = command("sh", ["-c", "echo bad >&2; exit 4"]).output
  assert r.err?
  assert_eq r.err.unwrap.message, "`sh -c 'echo bad >&2; exit 4'`: exit status 4: bad"
}

test "check = false returns the status" {
  c = command("sh", ["-c", "exit 5"])
  c.check = false
  assert_eq c.run.unwrap.exit_code, 5
}

test "not found" {
  r = command("no-such-program-alx", []).run
  assert_eq r.err.unwrap.message, "exec: \"no-such-program-alx\": executable file not found in $PATH"
}

test "dir, env, stdin" {
  c = command("pwd", [])
  c.dir = "/"
  assert_eq t(c.output.unwrap), "/"
  e = command("sh", ["-c", "echo $ALX_T"])
  e.env = ["ALX_T=yes"]
  assert_eq t(e.output.unwrap), "yes"
  w = command("wc", ["-c"])
  w.stdin = strings.repeat("x", 100000)
  assert_eq t(w.output.unwrap), "100000"
}

test "large outputs on both streams don't deadlock" {
  c = command("sh", ["-c", "head -c 300000 /dev/zero; head -c 200000 /dev/zero >&2"]).capture.unwrap
  assert_eq c.stdout.size, 300000
  assert_eq c.stderr.size, 200000
}

test "signals" {
  c = command("sh", ["-c", "kill -9 $$"]).capture.unwrap
  assert_eq c.state.signal, 9
  assert_eq c.state.exit_code, -1
  assert_eq c.state.to_s, "signal: killed"
}

test "pipelines: pipe, pipefail, SIGPIPE" {
  p = command("printf", ["a\nb\nc\n"]).pipe(command("grep", ["-c", "."]))
  assert_eq t(p.output.unwrap), "3"
  assert_eq p.to_s, "printf 'a\nb\nc\n' | grep -c ."
  f = command("false", []).pipe(command("cat", []))
  assert !f.capture.unwrap.success
  y = command("yes", []).pipe(command("head", ["-n", "1"]))
  assert_eq t(y.output.unwrap), "y"
}

test "from_literal: stages and redirects in order" {
  d = os.mkdir_temp("", "alx-exec-test-*").unwrap
  # `sh -c '...' > both.txt 2>&1`
  c = from_literal([["sh"], ["-c"], ["echo out; echo err >&2"], [""], ["both.txt"], [""]], [0, 0, 0, 3, 0, 7])
  c.dir = d
  assert_eq c.to_s, "sh -c 'echo out; echo err >&2' > both.txt 2>&1"
  c.run.unwrap
  assert_eq os.read_file_string(d + "/both.txt").unwrap, "out\nerr\n"
  # `wc -l < both.txt | tr -d ' '` with #{*xs} splicing ["-l"]
  r = from_literal([["wc"], ["-l"], [""], ["both.txt"], [""], ["tr"], ["-d", " "]], [0, 10, 2, 0, 1, 0, 10])
  r.dir = d
  assert_eq t(r.output.unwrap), "2"
  os.remove_all(d).unwrap
}

test "look_path" {
  assert strings.has_suffix(look_path("sh").unwrap, "/sh")
  assert look_path("no-such-program-alx").err?
}


def ms(n: Int) -> time.Duration { time.Duration.new(n * 1000000) }

def timeout_case -> ~Bool {
  c = command("sleep", ["5"])
  c.timeout = ms(100)
  t0 = time.now
  r = c.capture
  dt = time.now.sub(t0).ns / 1000000
  assert r.err?, "timed out"
  assert dt >= 90 && dt < 3000, "returned in #{dt}ms"
  e = r.err.unwrap
  assert strings.contains(e.message, "timed out"), e.message
  case e {
    Timeout(info) => {
      assert_eq info.state.signal, 9
      assert c_kill(info.state.pid.to_i32, 0) != 0, "child was reaped (no zombie)"
    }
    _ => assert false, "wrong error: #{e.message}"
  }
  true
}

test "timeout kills a hung command, reaps it" { timeout_case.unwrap }

test "timeout in a task" {
  t = spawn { timeout_case.unwrap }
  assert t.~wait
}

test "timeout kills a command whose output is discarded (run)" {
  c = command("sleep", ["5"])
  c.timeout = ms(100)
  t0 = time.now
  assert c.run.err?
  assert time.now.sub(t0).ns / 1000000 < 3000
}

test "timeout kills every stage of a pipeline" {
  c = command("sleep", ["5"]).pipe(command("cat", []))
  c.timeout = ms(100)
  t0 = time.now
  assert c.capture.err?
  assert time.now.sub(t0).ns / 1000000 < 3000
}

test "a command finishing before the timeout is unaffected" {
  c = command("sh", ["-c", "echo out; echo err >&2"])
  c.timeout = ms(10000)
  r = c.capture.unwrap
  assert_eq t(r.stdout), "out"
  assert_eq t(r.stderr), "err"
  assert r.state.success
  d = command("true", [])
  d.timeout = ms(10000)
  assert d.run.unwrap.success
  e = command("false", [])
  e.timeout = ms(10000)
  assert e.run.err?
  assert_eq e.run.err.unwrap.message, "`false`: exit status 1"
}
