# Go's os/exec env_test.go (TestDedupEnv) and internal_test.go
# (TestPrefixSuffixSaver), translated: in-package, as Go's are.

def nul_in(s: Str) -> Str { strings.replace_all(s, "\\0", Str.from_bytes([0])) }

test "DedupEnv" {
  # (no_case, nul_ok, in, want, want_err)
  tests = [
    (true, false, ["k1=v1", "k2=v2", "K1=v3"], ["k2=v2", "K1=v3"], false),
    (false, false, ["k1=v1", "K1=V2", "k1=v3"], ["K1=V2", "k1=v3"], false),
    (false, false, ["=a", "=b", "foo", "bar"], ["=b", "foo", "bar"], false),
    (true, false, ["=C:=C:\\golang", "=D:=D:\\tmp", "=D:=D:\\"], ["=C:=C:\\golang", "=D:=D:\\"], false),
    (false, false, ["dodgy", "entries"], ["dodgy", "entries"], false),
    (false, false, [nul_in("A=a\\0b"), "B=b", nul_in("C\\0C=c")], ["B=b"], true),
    (false, true, [nul_in("path=one\\0two")], [nul_in("path=one\\0two")], false),
  ]
  for tt in tests {
    got, err = dedup_env_case(tt[0], tt[1], tt[2])
    assert got == tt[3] && (err != "") == tt[4], "Dedup(#{tt[0]}, #{tt[2]}) = #{got}, #{err}; want #{tt[3]}, error:#{tt[4]}"
  }
}

test "PrefixSuffixSaver" {
  tests = [
    (2, [], ""),
    (2, ["a"], "a"),
    (2, ["abc", "d"], "abcd"),
    (2, ["abc", "d", "e"], "ab\n... omitting 1 bytes ...\nde"),
    (2, ["ab______________________yz"], "ab\n... omitting 22 bytes ...\nyz"),
    (2, ["ab_______________________y", "z"], "ab\n... omitting 23 bytes ...\nyz"),
  ]
  for tt in tests {
    all: [Byte] = []
    for s in tt[1] {
      for x in s.bytes { all << x }
    }
    assert_eq Str.from_bytes(prefix_suffix(all, tt[0])), tt[2]
  }
}
