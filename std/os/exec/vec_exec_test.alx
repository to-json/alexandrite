test "Error texts" {
  assert_eq ExecError.NotFound("prog").message, "exec: \"prog\": executable file not found in $PATH"
  assert_eq ExecError.Dot("prog", "").message, "exec: \"prog\": cannot run executable found relative to current directory"
  assert_eq ExecError.Lookup("prog", 13).message, "exec: \"prog\": permission denied"
  assert_eq ExecError.NotFound("a b").message, "exec: \"a b\": executable file not found in $PATH"
  assert_eq ExecError.Dot("a b", "").message, "exec: \"a b\": cannot run executable found relative to current directory"
  assert_eq ExecError.Lookup("a b", 13).message, "exec: \"a b\": permission denied"
  assert_eq ExecError.NotFound("q\"uote").message, "exec: \"q\\\"uote\": executable file not found in $PATH"
  assert_eq ExecError.Dot("q\"uote", "").message, "exec: \"q\\\"uote\": cannot run executable found relative to current directory"
  assert_eq ExecError.Lookup("q\"uote", 13).message, "exec: \"q\\\"uote\": permission denied"
  assert_eq ExecError.NotFound("é").message, "exec: \"é\": executable file not found in $PATH"
  assert_eq ExecError.Dot("é", "").message, "exec: \"é\": cannot run executable found relative to current directory"
  assert_eq ExecError.Lookup("é", 13).message, "exec: \"é\": permission denied"
  assert_eq ExecError.NotFound("").message, "exec: \"\": executable file not found in $PATH"
  assert_eq ExecError.Dot("", "").message, "exec: \"\": cannot run executable found relative to current directory"
  assert_eq ExecError.Lookup("", 13).message, "exec: \"\": permission denied"
  assert_eq ExecError.NotFound("x\ty").message, "exec: \"x\\ty\": executable file not found in $PATH"
  assert_eq ExecError.Dot("x\ty", "").message, "exec: \"x\\ty\": cannot run executable found relative to current directory"
  assert_eq ExecError.Lookup("x\ty", 13).message, "exec: \"x\\ty\": permission denied"
  assert_eq look_path("").err.unwrap.message, "exec: \"\": executable file not found in $PATH"
  assert_eq look_path(".").err.unwrap.message, "exec: \".\": executable file not found in $PATH"
  assert_eq look_path("..").err.unwrap.message, "exec: \"..\": executable file not found in $PATH"
  assert_eq ERR_WAIT_DELAY, "exec: WaitDelay expired before I/O complete"
}

test "ExitError texts" {
  c1 = command("/bin/sh", ["-c", "exit 1"])
  assert_eq exit_info(c1.run.err.unwrap).unwrap.go_message, "exit status 1"
  c2 = command("/bin/sh", ["-c", "exit 2"])
  assert_eq exit_info(c2.run.err.unwrap).unwrap.go_message, "exit status 2"
  c42 = command("/bin/sh", ["-c", "exit 42"])
  assert_eq exit_info(c42.run.err.unwrap).unwrap.go_message, "exit status 42"
  c127 = command("/bin/sh", ["-c", "exit 127"])
  assert_eq exit_info(c127.run.err.unwrap).unwrap.go_message, "exit status 127"
  c255 = command("/bin/sh", ["-c", "exit 255"])
  assert_eq exit_info(c255.run.err.unwrap).unwrap.go_message, "exit status 255"
  sKILL = command("/bin/sh", ["-c", "kill -KILL $$"])
  assert_eq exit_info(sKILL.run.err.unwrap).unwrap.go_message, "signal: killed"
  sTERM = command("/bin/sh", ["-c", "kill -TERM $$"])
  assert_eq exit_info(sTERM.run.err.unwrap).unwrap.go_message, "signal: terminated"
  sINT = command("/bin/sh", ["-c", "kill -INT $$"])
  assert_eq exit_info(sINT.run.err.unwrap).unwrap.go_message, "signal: interrupt"
  sHUP = command("/bin/sh", ["-c", "kill -HUP $$"])
  assert_eq exit_info(sHUP.run.err.unwrap).unwrap.go_message, "signal: hangup"
  sQUIT = command("/bin/sh", ["-c", "kill -QUIT $$"])
  assert_eq exit_info(sQUIT.run.err.unwrap).unwrap.go_message, "signal: quit"
  sUSR1 = command("/bin/sh", ["-c", "kill -USR1 $$"])
  assert_eq exit_info(sUSR1.run.err.unwrap).unwrap.go_message, "signal: user defined signal 1"
}
