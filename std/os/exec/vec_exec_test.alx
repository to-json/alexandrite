# Generated from Go's os/exec (Cmd.String, Error and ExitError texts) by a throwaway program; do not edit by hand.

test "Cmd.String vectors" {
  assert_eq command("/usr/bin/env", []).string, "/usr/bin/env"
  assert_eq command("/no/such/prog", ["\"q\"", "tab\there", "*"]).string, "/no/such/prog \"q\" tab\there *"
  assert_eq command("./rel/prog", ["", "--flag=1"]).string, "./rel/prog  --flag=1"
  assert_eq command("/usr/bin/env", []).string, "/usr/bin/env"
  assert_eq command("/bin/sh", [""]).string, "/bin/sh "
  assert_eq command("./rel/prog", ["it's", ""]).string, "./rel/prog it's "
  assert_eq command("a/b", ["a/b"]).string, "a/b a/b"
  assert_eq command("/usr/bin/env", []).string, "/usr/bin/env"
