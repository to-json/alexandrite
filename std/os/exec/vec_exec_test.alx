  assert_eq command("./rel/prog", ["line\nbreak", "$HOME", "$HOME", "a"]).string, "./rel/prog line\nbreak $HOME $HOME a"
  assert_eq command("/no/such/prog", ["*", "$HOME", "\#x"]).string, "/no/such/prog * $HOME \#x"
