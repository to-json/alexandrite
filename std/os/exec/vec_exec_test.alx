  assert_eq command("./rel/prog", ["a", "-x", "\#x", "b c"]).string, "./rel/prog a -x \#x b c"
  assert_eq command("/bin/sh", ["--flag=1"]).string, "/bin/sh --flag=1"
  assert_eq command("a/b", ["line\nbreak", "b c"]).string, "a/b line\nbreak b c"
