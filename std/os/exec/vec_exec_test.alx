  assert_eq command("./rel/prog", ["--flag=1", "a"]).string, "./rel/prog --flag=1 a"
  assert_eq command("/no/such/prog", ["\#x"]).string, "/no/such/prog \#x"
  assert_eq command("/usr/bin/env", ["b c", "a/b", "tab\there"]).string, "/usr/bin/env b c a/b tab\there"
  assert_eq command("/usr/bin/env", ["$HOME", "b c"]).string, "/usr/bin/env $HOME b c"
