  assert_eq command("./rel/prog", ["it's", "tab\there", "-x"]).string, "./rel/prog it's tab\there -x"
  assert_eq command("/usr/bin/env", ["it's", "line\nbreak", "a/b", "it's"]).string, "/usr/bin/env it's line\nbreak a/b it's"
