# Package os: Go's os for Unix (macOS, Linux), over the C FFI (L2).
#
#   Go                                      alx
#   Open / Create / OpenFile(name, flag, perm)  open / create / open_file -> ~File
#   O_RDONLY ... O_TRUNC, syscall.O_NONBLOCK    O_RDONLY ... O_TRUNC, O_NONBLOCK (portable values)
#   File.Read / Write / WriteString         read! / write! / write_string!
#   File.ReadAt / WriteAt / Seek            read_at / write_at / seek!(off, whence)
#   File.Close / Sync / Truncate / Chmod /  close! / sync! / truncate! / chmod! /
#     Chown / Chdir / Stat / Fd / Name        chown! / chdir! / stat / fd / name
#   File.ReadDir / Readdir / Readdirnames   read_dir!(n) / readdir!(n) / readdirnames!(n)
#   File.ReadFrom / WriteTo                 read_from!(r) / write_to!(w)
#   NewFile(fd, name)                       new_file(fd, name) -> File? (none for fd < 0)
#   Pipe()                                  pipe -> ~(File, File)
#   Stdin / Stdout / Stderr (vars)          STDIN / STDOUT / STDERR (Atomic[File], R11);
#                                             stdin / stdout / stderr load them
#   Stat / Lstat / SameFile                 stat / lstat -> ~FileInfo; same_file(a, b)
#   FileInfo (Name, Size, Mode, ModTime,    struct FileInfo: name, size, mode (st_mode bits),
#     IsDir, Sys)                             mod_time (ns), access_time, change_time, ino,
#                                             nlink, dev, uid, gid, rdev; is_dir, is_regular,
#                                             is_symlink, is_named_pipe, is_char_device, perm,
#                                             go_mode (Go's FileMode bits)
#   FileMode, ModePerm, ModeDir ...         io/fs's FileMode (fs.FileMode.new(bits: i.go_mode));
#                                             here MODE_PERM, MODE_DIR ... are st_mode bits
#   DirEntry, ReadDir(name)                 DirEntry (name, is_dir, type, info, to_s);
#                                             read_dir(name), sorted
#   ReadFile / WriteFile                    read_file / write_file (and read_file_string)
#   Mkdir / MkdirAll / Remove / RemoveAll   mkdir / mkdir_all / remove / remove_all
#   Rename / Link / Symlink / Readlink      rename / link / symlink / readlink
#   Chmod / Chown / Lchown / Chtimes /      chmod / chown / lchown / chtimes(name, atime, mtime)
#     Truncate                                (Int? ns; none = Go's zero Time: leave it) / truncate
#   MkdirTemp / CreateTemp / TempDir        mkdir_temp / create_temp / temp_dir
#   DirFS(dir)                              io/fs's dir_fs(dir) (io/fs imports os)
#   CopyFS(dir, fsys)                       copy_fs(dir, fsys) (generic over the FS type)
#   Getenv / LookupEnv / Setenv / Unsetenv  getenv(k) -> Str? (Go's LookupEnv; Getenv is
#     / Clearenv / Environ                    `getenv(k) || ""`), lookup_env, setenv, unsetenv,
#                                             clearenv, environ
#   Expand / ExpandEnv                      expand(s) { |name| ... } / expand_env(s)
#   Args (var)                              ARGS (Atomic[[Str]], R11); args loads it
#   Exit / Getpid / Getppid / Getuid /      exit / getpid / getppid / getuid / geteuid / getgid /
#     Geteuid / Getgid / Getegid /            getegid / getgroups / getpagesize
#     Getgroups / Getpagesize
#   Hostname / Getwd / Chdir / Executable   hostname / getwd / chdir / executable
#   UserHomeDir / UserCacheDir /            user_home_dir / user_cache_dir / user_config_dir
#     UserConfigDir
#   StartProcess(name, argv, *ProcAttr)     start_process(name, argv, ProcAttr(dir, env, files))
#   FindProcess / Process.Signal / Kill /   find_process / signal(sig: Int) / kill / wait! /
#     Wait / Release / Pid                    release! / pid; new_process(pid) (for os/exec)
#   ProcessState (ExitCode, Exited,         ProcessState: exit_code, exited, success, signal,
#     Success, String, UserTime, ...)         to_s, user_time, system_time, max_rss, wall_ns
#   Interrupt, Kill (Signals)               INTERRUPT, KILL (signal numbers); signal_name(n)
#   PathError / LinkError / SyscallError    FsError, see below; fs_error / link_error /
#     / NewSyscallError                        new_syscall_error
#   ErrNotExist / ErrExist / ErrPermission  is_not_exist / is_exist / is_permission /
#     / ErrClosed / ErrInvalid /              is_closed / is_invalid / is_process_done /
#     ErrProcessDone; IsTimeout               is_timeout (and the ERR_* codes)
#   DevNull, PathSeparator,                 DEV_NULL, PATH_SEPARATOR, PATH_LIST_SEPARATOR,
#     PathListSeparator, IsPathSeparator      is_path_separator
#
# Errors: one error type, FsError, by kind (the variants are what programs
# branch on: NotExist, Exist, Permission, IsDir, NotDir, NotEmpty, Other).
# Each holds an FsFailure with Go's fields: `op`, `path` (a LinkError's Old),
# `new_path` (its New), `code` (the errno, or an ERR_* code for Go's error
# values: ERR_CLOSED "file already closed", ERR_PROCESS_DONE, ...) and
# `kind` (PATH_ERROR, LINK_ERROR, SYSCALL_ERROR, PLAIN_ERROR: which of Go's
# types it is; `e.link_error?` ... ask). Messages are Go's: "open /x: no such
# file or directory", "rename a b: file exists", "setenv: invalid argument".
# The functions declare `~T<FsError>`, so a held result's `.err` is an
# FsError (S7).
#
# Differences from Go:
#  - End of file is not an error: `read!` returns 0 (GO-VS-RUBY F3);
#    read_dir!(n) etc. return an empty slice at the end where Go returns
#    io.EOF, and read_at returns a short count where Go adds io.EOF.
#  - Open flags are portable alexandrite constants, translated to the
#    platform's by open_file (Go's are the platform's own values).
#  - A File's state (descriptor, directory stream) lives in Atomics: copies
#    are the same file (D36), and tasks may share one, as goroutines share an
#    *os.File; close! by any of them wakes the others' pending reads and
#    writes, which fail with ErrClosed. new_file(fd) returns none for a
#    negative fd (Go's nil *File; alx has no nil, so Go's nil-File tests use a
#    closed File). STDOUT.load is a copy: closing it doesn't mark other
#    loads closed.
#  - Reads and writes never block a task's worker (port-issues #166): in a
#    task, a pipe, FIFO, terminal or socket that isn't ready parks the task
#    on the runtime's poller (or a helper thread runs the call), so the tasks
#    pinned to the same worker keep running; an O_NONBLOCK descriptor waits
#    the same way (Go: an EAGAIN error from a descriptor it didn't make
#    non-blocking itself). Opening a FIFO waits on a helper thread.
#  - SIGPIPE is Go's: a write to a broken pipe or socket fails with EPIPE,
#    except on stdout/stderr, where SIGPIPE ends the program.
#  - No deadlines: SetDeadline / SetReadDeadline / SetWriteDeadline and
#    ErrDeadlineExceeded / ErrNoDeadline are missing on Files (port-issues
#    #241). An extension instead: `File.wait_readable(timeout: time.Duration) ->
#    ~Bool`, true when a read would not block (data, end of file, hangup or
#    an error pending), false when the timeout passes first.
#  - No os.Root / OpenRoot / OpenInRoot yet (port-issues #242).
#  - Signals are numbers (INTERRUPT, KILL, or `signal.sigterm.number` from
#    os/signal, which imports os); Process.signal(sig: Int).
#  - ProcAttr.files: none is the null device for 0-2 (Go: closed), closed
#    above. A Process is waited for with wait! (it changes state shared by
#    its copies).
#  - Times are Ints: nanoseconds since the Unix epoch (os imports time
#    only for wait_readable's Duration). chtimes takes Int?: none leaves that time as it is.
#  - FileInfo is a struct, not an interface; `mode` is st_mode (MODE_* are
#    st_mode's bits), `go_mode` Go's FileMode bits. FileInfo.Sys doesn't
#    exist: dev, uid, gid, rdev and the times are fields.
#  - Getwd keeps Go's algorithm ($PWD when it names "."; getcwd; walking up
#    through ".." for paths getcwd can't return).
#  - executable under `alx run` (the JIT) is the alx compiler.
#  - File.SyscallConn and ProcessState.Sys/SysUsage: no syscall package
#    (max_rss, user_time, system_time are fields instead).
#  - In the browser (GO-VS-RUBY D77), as in Go's js/wasm: stdout and stderr
#    are the page's output, stdin is empty, the environment starts empty
#    (setenv works), `args` is the program's name, and there is no file
#    system: file operations fail with ENOSYS ("function not implemented").
#
# Tests: Go's os_test.go, file_test.go, path_test.go, env_test.go,
# env_unix_test.go, error_test.go, error_unix_test.go, tempfile_test.go,
# removeall_test.go, read_test.go, stat_test.go, os_unix_test.go,
# pipe_test.go, fifo_test.go, exec_test.go, exec_unix_test.go,
# getwd_unix_test.go, executable_test.go, copy_test.go (CopyFileToFile) and
# example_test.go are translated (*_go_test.alx, env/error/... by file), with
# vectors from Go (vec_expand_test.alx: Expand/ExpandEnv; vec_errors_test.alx:
# errno, PathError/LinkError/SyscallError and signal texts). Not translated:
#  - root_test.go, root_unix_test.go, TestRootDirFS and the rooted halves of
#    testMaybeRooted tests: no os.Root yet.
#  - timeout_test.go, timeout_unix_test.go, TestNewFileNonBlock,
#    TestNonpollableDeadline: no deadlines.
#  - TestFileChdirTestlog (Go's internal testlog), TestStatStdin's child
#    half, TestStdPipe, TestReadNonblockingFd, TestLargeWriteToConsole
#    (re-run the test binary as a helper that writes to its own stdout/stdin;
#    the EPIPE half is TestEPIPE), TestReaddirRemoveRace (Go's internal stat
#    hook; ReaddirStatFailures covers vanishing entries), TestNilProcessState
#    String (no nil), TestWriteStringAlloc (allocation counting),
#    TestMkdirAllAtSlash (non-hermetic: Go skips it outside its builders),
#    TestRemoveAllNoFcntl (strace), TestLargeCopyViaNetwork and
#    readfrom_unix_test.go / writeto_linux_test.go (copy_file_range /
#    sendfile / splice internals); benchmarks.

