# Package os: Go's os for Unix, over the C FFI (L2).
#
# Conventions:
#  - Failures are `FsError` values (`~T` results), carrying the operation, the
#    path and the errno; the message reads like Go's: `open /x: no such file or
#    directory`. Match with `case`:
#        case e { NotExist => ...; Permission => ...; _ => ... }
#    or use `is_not_exist(e)` / `is_exist(e)` / `is_permission(e)`.
#    `e.failure` has the operation, path and errno (`e.errno` too); `Other`
#    covers every other errno (`errno_message(code)` is its text).
#  - End of file is not an error: `File.read!` returns 0 (GO-VS-RUBY F3).
#  - `getenv(k)` is Go's LookupEnv: a `Str?`. Go's Getenv is `getenv(k) || ""`.
#  - Open flags are portable alexandrite constants (`O_RDONLY`, `O_WRONLY`,
#    `O_RDWR`, `O_APPEND`, `O_CREATE`, `O_EXCL`, `O_SYNC`, `O_TRUNC`), combined
#    with `|` and translated to the platform's values by `open_file`. (Go's are
#    the platform's own values, fixed at compile time; the runtime's constant
#    table, `alx_sys_const`, is a runtime lookup here, so these are stable
#    stand-ins.) Permissions are plain Ints: `0o644`.
#  - `File` holds a file descriptor (in shared state, GO-VS-RUBY D36) and a
#    name. Its `!` methods need a variable as receiver (`f = ~os.open(p);
#    f.read!(buf)`). Copies of a File are the same file: `close!` on one copy
#    closes them all, so a second close on any copy fails, as in Go.
#  - `stdin` / `stdout` / `stderr` are functions returning those Files. Output
#    through them is unbuffered; use bufio.Writer.
#  - `File.wait_readable(timeout: time.Duration) -> ~Bool` is an extension (Go:
#    SetReadDeadline): true when a read would not block (data, EOF, hangup or
#    error pending), false on timeout.
#  - `pipe` returns the two Files as a tuple: `(r, w) = ~os.pipe`.
#  - Times are Ints: nanoseconds since the Unix epoch.
#  - Everything blocks the calling worker thread (the event loop arrives with
#    L3).
#  - In the browser (GO-VS-RUBY D77), as in Go's js/wasm: stdout and stderr
#    are the page's output, stdin is empty, the environment starts empty
#    (setenv works), `args` is the program's name, and there is no file
#    system: file operations fail with ENOSYS ("function not implemented").

import "path"
import "slices"
import "time"

extern def c_read(fd: I32, buf: [Byte], n: Int) -> Int = "read"
extern def c_write(fd: I32, buf: [Byte], n: Int) -> Int = "write"
extern def c_pread(fd: I32, buf: [Byte], n: Int, off: Int) -> Int = "pread"
extern def c_pwrite(fd: I32, buf: [Byte], n: Int, off: Int) -> Int = "pwrite"
extern def c_close(fd: I32) -> I32 = "close"
extern def c_lseek(fd: I32, off: Int, whence: I32) -> Int = "lseek"
extern def c_fsync(fd: I32) -> I32 = "fsync"
extern def c_ftruncate(fd: I32, len: Int) -> I32 = "ftruncate"
extern def c_truncate(p: Str, len: Int) -> I32 = "truncate"
extern def c_fchmod(fd: I32, mode: I32) -> I32 = "fchmod"
extern def c_chmod(p: Str, mode: I32) -> I32 = "chmod"
extern def c_mkdir(p: Str, mode: I32) -> I32 = "mkdir"
extern def c_rmdir(p: Str) -> I32 = "rmdir"
extern def c_unlink(p: Str) -> I32 = "unlink"
extern def c_rename(a: Str, b: Str) -> I32 = "rename"
extern def c_link(a: Str, b: Str) -> I32 = "link"
extern def c_symlink(a: Str, b: Str) -> I32 = "symlink"
extern def c_readlink(p: Str, buf: [Byte], n: Int) -> Int = "readlink"
extern def c_chdir(p: Str) -> I32 = "chdir"
extern def c_getcwd(buf: [Byte], n: Int) -> Ptr = "getcwd"
extern def c_gethostname(buf: [Byte], n: Int) -> I32 = "gethostname"
extern def c_getpid -> I32 = "getpid"
extern def c_getppid -> I32 = "getppid"
extern def c_getuid -> I32 = "getuid"
extern def c_getgid -> I32 = "getgid"
extern def c_getenv(name: Str) -> Ptr = "getenv"
extern def c_setenv(name: Str, value: Str, overwrite: I32) -> I32 = "setenv"
extern def c_unsetenv(name: Str) -> I32 = "unsetenv"
extern def c_exit(code: I32) = "exit"
extern def c_isatty(fd: I32) -> Bool = "isatty"
extern def alx_sys_open(p: Str, flags: I32, mode: I32) -> I32
extern def alx_sys_const(name: Str) -> Int
extern def alx_sys_pipe(out: [Byte], nonblock: Int) -> Int
extern def alx_fd_wait_timeout(fd: Int, mode: Int, timeout_ns: Int) -> Int
extern def alx_sys_stat(p: Str, out: [Byte], follow: I32) -> I32
extern def alx_sys_fstat(fd: I32, out: [Byte]) -> I32
extern def alx_sys_dir_open(p: Str) -> Int
extern def alx_sys_dir_next(h: Int, kind: [Byte]) -> Ptr
extern def alx_sys_dir_close(h: Int)
extern def alx_environ(i: Int) -> Ptr
extern def alx_argc -> Int
extern def alx_argv(i: Int) -> Ptr
extern def alx_mono_ns -> Int

# ------------------------------------------------------------------ constants

# Open flags (see the header). The access mode is the low two bits.
pub O_RDONLY = 0
pub O_WRONLY = 1
pub O_RDWR = 2
pub O_APPEND = 8
pub O_CREATE = 16
pub O_EXCL = 32
pub O_SYNC = 64
pub O_TRUNC = 128

# Go's os.ModePerm, and the file type bits of FileInfo.mode.
pub MODE_PERM = 0o777
pub MODE_TYPE = 0o170000
pub MODE_DIR = 0o040000
pub MODE_REGULAR = 0o100000
pub MODE_SYMLINK = 0o120000
pub MODE_NAMED_PIPE = 0o010000
pub MODE_CHAR_DEVICE = 0o020000
pub MODE_DEVICE = 0o060000
pub MODE_SOCKET = 0o140000

pub PATH_SEPARATOR = "/"

# The FsFailure code (not an errno) of a temp-file pattern containing "/".
pub ERR_PATTERN_SEP = -1

def c(name: Str) -> Int { alx_sys_const(name) }

# ---------------------------------------------------------------------- errors

# What failed: the operation (`open`, `mkdir`, ...), the path it was for ("" if
# none) and errno.
pub struct FsFailure {
  op: Str
  path: Str
  code: Int
}

# A failed system call, by kind: the variants are what programs branch on;
# `Other` is everything else. Each holds the FsFailure. (One payload per
# variant keeps the closed `Error` sum narrow, which the Rust oracle needs.)
pub error FsError {
  NotExist(at: FsFailure)
  Exist(at: FsFailure)
  Permission(at: FsFailure)
  IsDir(at: FsFailure)
  NotDir(at: FsFailure)
  NotEmpty(at: FsFailure)
  Other(at: FsFailure)

  def message -> Str {
    f = failure
    describe(f.op, f.path, f.code)
  }

  # The failed call's details.
  pub def failure -> FsFailure {
    case self {
      NotExist(at) => at
      Exist(at) => at
      Permission(at) => at
      IsDir(at) => at
      NotDir(at) => at
      NotEmpty(at) => at
      Other(at) => at
    }
  }

  # The errno.
  pub def errno -> Int {
    f = failure
    f.code
  }
}

# C's message for an errno, in Go's lower case: "no such file or directory".
pub def errno_message(code: Int) -> Str {
  # Not an errno: Go's errPatternHasSeparator (mkdir_temp, create_temp).
  return "pattern contains path separator" if code == ERR_PATTERN_SEP
  s = C.strerror(code)
  return s if s.size == 0 || s[0] < 65 || s[0] > 90
  # "I/O error" style messages keep their capitals.
  return s if s.size > 1 && s[1] >= 65 && s[1] <= 90
  b = s.bytes.to_a
  b[0] = b[0] + 32
  Str.from_bytes(b)
}

def describe(op: Str, path: Str, code: Int) -> Str {
  m = errno_message(code)
  return "#{op}: #{m}" if path.size == 0
  "#{op} #{path}: #{m}"
}

# The FsError for errno `code`.
pub def fs_error(op: Str, path: Str, code: Int) -> FsError {
  ferr(op + " " + path, code)
}

# fs_error with the operation and the path as one string, "op path" (the
# operation has no spaces). One argument, because the region analysis makes
# a function that stores two of its Str parameters into one object keep both
# alive for the whole program: that would leak on every I/O call.
def ferr(where: Str, code: Int) -> FsError {
  i = 0
  while i < where.size && where[i] != 32 {
    i += 1
  }
  at = FsFailure.new(op: where[0...i], path: i < where.size ? where[i + 1...where.size] : "", code: code)
  return FsError.NotExist(at) if code == c("ENOENT")
  return FsError.Exist(at) if code == c("EEXIST")
  return FsError.Permission(at) if code == c("EACCES") || code == c("EPERM")
  return FsError.IsDir(at) if code == c("EISDIR")
  return FsError.NotDir(at) if code == c("ENOTDIR")
  return FsError.NotEmpty(at) if code == c("ENOTEMPTY")
  FsError.Other(at)
}

# Go's os.IsNotExist: the file or directory doesn't exist.
pub def is_not_exist(e: Error) -> Bool {
  case e {
    NotExist => true
    _ => false
  }
}

pub def is_exist(e: Error) -> Bool {
  case e {
    Exist => true
    NotEmpty => true
    _ => false
  }
}

pub def is_permission(e: Error) -> Bool {
  case e {
    Permission => true
    _ => false
  }
}

# ------------------------------------------------------------------- bytes in/out

# The k-th native-endian (little-endian) Int of a stat buffer.
def get64(b: [Byte], k: Int) -> Int {
  v = 0
  i = 7
  while i >= 0 {
    v = (v << 8) | b[k * 8 + i].to_i
    i -= 1
  }
  v
}

# The C string in b (up to the first NUL).
def cstr_of(b: [Byte]) -> Str {
  n = 0
  while n < b.size && b[n] != 0 {
    n += 1
  }
  Str.from_bytes(b[0...n])
}

def zeros(n: Int) -> [Byte] {
  b: [Byte] = [0; n]
  b
}

# ----------------------------------------------------------------- file info

# What stat(2) says about a file. `mode` is st_mode: the type bits
# (MODE_TYPE) and the permission bits (MODE_PERM).
pub struct FileInfo {
  name: Str
  size: Int
  mode: Int
  mod_time: Int
  access_time: Int
  ino: Int
  nlink: Int

  pub def perm -> Int { mode & 0o777 }
  pub def is_dir -> Bool { (mode & 0o170000) == 0o040000 }
  pub def is_regular -> Bool { (mode & 0o170000) == 0o100000 }
  pub def is_symlink -> Bool { (mode & 0o170000) == 0o120000 }
}

def info_of(name: Str, st: [Byte]) -> FileInfo {
  FileInfo.new(name: base_name(name), size: get64(st, 1), mode: get64(st, 0), mod_time: get64(st, 2), access_time: get64(st, 3), ino: get64(st, 4), nlink: get64(st, 5))
}

# The last element of a path ("/" for "/", "." for "").
def base_name(p: Str) -> Str {
  path.base(p)
}

# Information about the named file, following a final symlink.
pub def stat(name: Str) -> ~FileInfo {
  st = zeros(48)
  r = alx_sys_stat(name, st, 1)
  fail ferr("stat" + " " + name, -r.to_i) if r != 0
  info_of(name, st)
}

# Like stat, but a final symlink is described rather than followed.
pub def lstat(name: Str) -> ~FileInfo {
  st = zeros(48)
  r = alx_sys_stat(name, st, 0)
  fail ferr("lstat" + " " + name, -r.to_i) if r != 0
  info_of(name, st)
}

# ----------------------------------------------------------------------- File

# An open file: its descriptor and the name it was opened with. The descriptor
# lives in a one-element slice (GO-VS-RUBY D36), so copies of a File share it:
# `close!` on one copy closes them all (a second close, on any copy, fails).
pub struct File {
  cell: [Int]
  name: Str

  # The descriptor; -1 once closed (or for a File made without one).
  pub def fd -> Int { cell.size == 0 ? -1 : cell[0] }

  # Reads up to p.size bytes; returns the count, 0 at the end of the file.
  pub def read!(p: [Byte]) -> ~Int {
    return 0 if p.size == 0
    n = c_read(fd.to_i32, p, p.size)
    while n < 0 {
      code = C.errno
      fail ferr("read" + " " + name, code) if code != c("EINTR")
      n = c_read(fd.to_i32, p, p.size)
    }
    n
  }

  # Waits until a read would not block (data, end of file, hangup or an error
  # is pending): true; false if timeout passes first. An alx extension (Go has
  # SetReadDeadline). A task parks with a deadline, so its worker runs other
  # tasks; the main thread poll(2)s. Not supported in the browser.
  pub def wait_readable(timeout: time.Duration) -> ~Bool {
    fail ferr("read" + " " + name, c("EBADF")) if fd < 0
    r = alx_fd_wait_timeout(fd, 1, timeout.ns)
    fail ferr("read" + " " + name, -r) if r < 0
    r == 1
  }

  # Writes all of p; returns p.size.
  pub def write!(p: [Byte]) -> ~Int {
    off = 0
    while off < p.size {
      n = c_write(fd.to_i32, p[off...p.size], p.size - off)
      while n < 0 {
        code = C.errno
        fail ferr("write" + " " + name, code) if code != c("EINTR")
        n = c_write(fd.to_i32, p[off...p.size], p.size - off)
      }
      off += n
    }
    p.size
  }

  pub def write_string!(s: Str) -> ~Int {
    self.~write!(s.bytes.to_a)
  }

  # Reads at offset `off` without moving the file offset.
  pub def read_at(p: [Byte], off: Int) -> ~Int {
    return 0 if p.size == 0
    n = c_pread(fd.to_i32, p, p.size, off)
    while n < 0 {
      code = C.errno
      fail ferr("read" + " " + name, code) if code != c("EINTR")
      n = c_pread(fd.to_i32, p, p.size, off)
    }
    n
  }

  # Writes all of p at offset `off` without moving the file offset.
  pub def write_at(p: [Byte], off: Int) -> ~Int {
    done = 0
    while done < p.size {
      n = c_pwrite(fd.to_i32, p[done...p.size], p.size - done, off + done)
      while n < 0 {
        code = C.errno
        fail ferr("write" + " " + name, code) if code != c("EINTR")
        n = c_pwrite(fd.to_i32, p[done...p.size], p.size - done, off + done)
      }
      done += n
    }
    p.size
  }

  # Moves the offset (whence: 0 start, 1 current, 2 end); returns the new
  # offset from the start.
  pub def seek!(offset: Int, whence: Int) -> ~Int {
    r = c_lseek(fd.to_i32, offset, whence.to_i32)
    fail ferr("seek" + " " + name, C.errno) if r < 0
    r
  }

  # Closes the descriptor. A second close fails.
  pub def close! -> ~Unit {
    fail ferr("close" + " " + name, c("EBADF")) if fd < 0
    r = c_close(fd.to_i32)
    code = C.errno
    self.cell[0] = -1
    fail ferr("close" + " " + name, code) if r != 0
  }

  # Flushes the file's data to the device.
  pub def sync! -> ~Unit {
    r = c_fsync(fd.to_i32)
    fail ferr("sync" + " " + name, C.errno) if r != 0
  }

  pub def truncate!(size: Int) -> ~Unit {
    r = c_ftruncate(fd.to_i32, size)
    fail ferr("truncate" + " " + name, C.errno) if r != 0
  }

  pub def chmod!(mode: Int) -> ~Unit {
    r = c_fchmod(fd.to_i32, mode.to_i32)
    fail ferr("chmod" + " " + name, C.errno) if r != 0
  }

  pub def stat -> ~FileInfo {
    st = zeros(48)
    r = alx_sys_fstat(fd.to_i32, st)
    fail ferr("stat" + " " + name, -r.to_i) if r != 0
    info_of(name, st)
  }

  # Is this a terminal?
  pub def is_terminal -> Bool { c_isatty(fd.to_i32) }
}

# A File over an existing descriptor.
pub def new_file(fd: Int, name: Str) -> File {
  cell: [Int] = [fd]
  File.new(cell: cell, name: name)
}

# Go's os.Pipe: (read end, write end), both blocking and close-on-exec.
pub def pipe -> ~(File, File) {
  b: [Byte] = [0; 16]
  r = alx_sys_pipe(b, 0)
  fail ferr("pipe", -r) if r < 0
  (new_file(b[0].to_i, "|0"), new_file(b[8].to_i, "|1"))
}

pub def stdin -> File { new_file(0, "/dev/stdin") }
pub def stdout -> File { new_file(1, "/dev/stdout") }
pub def stderr -> File { new_file(2, "/dev/stderr") }

# The platform's O_* value for the portable flags.
def native_flags(flags: Int) -> Int {
  v = flags & 3
  v |= c("O_APPEND") if (flags & 8) != 0
  v |= c("O_CREAT") if (flags & 16) != 0
  v |= c("O_EXCL") if (flags & 32) != 0
  v |= c("O_SYNC") if (flags & 64) != 0
  v |= c("O_TRUNC") if (flags & 128) != 0
  v | c("O_CLOEXEC")
}

# Opens the named file with the given O_* flags; a new file gets permissions
# `perm` (before the umask).
pub def open_file(name: Str, flags: Int, perm: Int) -> ~File {
  fd = ~open_fd(name, flags, perm)
  new_file(fd, Str.from_bytes(name.bytes.to_a))
}

def open_fd(name: Str, flags: Int, perm: Int) -> ~Int {
  nf = native_flags(flags).to_i32
  fd = alx_sys_open(name, nf, perm.to_i32)
  while fd < 0 {
    code = C.errno
    fail ferr("open" + " " + name, code) if code != c("EINTR")
    fd = alx_sys_open(name, nf, perm.to_i32)
  }
  fd.to_i
}

# Opens for reading. (open and create call open_fd, not open_file: a File,
# whose descriptor is in a slice, returned through two fallible calls in a row
# is corrupted by a compiler bug.)
pub def open(name: Str) -> ~File {
  fd = ~open_fd(name, O_RDONLY, 0)
  new_file(fd, Str.from_bytes(name.bytes.to_a))
}

# Creates or truncates for reading and writing (permissions 0o666).
pub def create(name: Str) -> ~File {
  fd = ~open_fd(name, O_RDWR | O_CREATE | O_TRUNC, 0o666)
  new_file(fd, Str.from_bytes(name.bytes.to_a))
}

# The whole content of a file.
pub def read_file(name: Str) -> ~[Byte] {
  f = ~open(name)
  r = read_all_fd(f)
  c_close(f.fd.to_i32)
  ~r
}

def read_all_fd(f: File) -> ~[Byte] {
  st = zeros(48)
  hint = 0
  if alx_sys_fstat(f.fd.to_i32, st) == 0 {
    hint = get64(st, 1)
    hint = 0 if hint < 0
  }
  buf = zeros(hint + 512)
  len = 0
  loop {
    if len == buf.size {
      bigger = zeros(buf.size * 2)
      copy(bigger[0...len], buf[0...len])
      buf = bigger
    }
    n = c_read(f.fd.to_i32, buf[len...buf.size], buf.size - len)
    while n < 0 {
      code = C.errno
      fail ferr("read" + " " + f.name, code) if code != c("EINTR")
      n = c_read(f.fd.to_i32, buf[len...buf.size], buf.size - len)
    }
    break if n == 0
    len += n
  }
  buf[0...len]
}

# Writes data to the named file, creating it with `perm` or truncating it.
pub def write_file(name: Str, data: [Byte], perm: Int) -> ~Unit {
  f = ~open_file(name, O_WRONLY | O_CREATE | O_TRUNC, perm)
  r = f.write!(data)
  r2 = f.close!
  ~r
  ~r2
}

# The whole content of a file as a string.
pub def read_file_string(name: Str) -> ~Str {
  b = ~read_file(name)
  Str.from_bytes(b)
}

# ---------------------------------------------------------------- directories

# An entry of a directory listing. `kind` is 1 regular, 2 directory,
# 3 symlink, 4 other.
pub struct DirEntry {
  name: Str
  dir: Str
  kind: Int

  pub def is_dir -> Bool { kind == 2 }
  pub def is_regular -> Bool { kind == 1 }
  pub def is_symlink -> Bool { kind == 3 }
  # The directory joined with the name.
  pub def path -> Str { path.join([dir, name]) }
  # The entry's FileInfo (not following a symlink).
  pub def info -> ~FileInfo {
    ~lstat(path.join([dir, name]))
  }
}

def by_name(a: DirEntry, b: DirEntry) -> Int {
  return -1 if a.name < b.name
  return 1 if a.name > b.name
  0
}

# The entries of a directory, sorted by name ("." and ".." left out).
pub def read_dir(name: Str) -> ~[DirEntry] {
  h = alx_sys_dir_open(name)
  fail ferr("open" + " " + name, -h) if h < 0
  out: [DirEntry] = []
  kind = zeros(1)
  loop {
    p = alx_sys_dir_next(h, kind)
    break if p.null?
    en = Str.from_cstr(p)
    k = kind[0].to_i
    if k == 0 {
      # The file system didn't say: ask.
      st = zeros(48)
      k = 4
      if alx_sys_stat(path.join([name, en]), st, 0) == 0 {
        t = get64(st, 0) & 0o170000
        k = 1 if t == 0o100000
        k = 2 if t == 0o040000
        k = 3 if t == 0o120000
      }
    }
    out << DirEntry.new(name: en, dir: name, kind: k)
  }
  alx_sys_dir_close(h)
  slices.sort_func(out, by_name)
  out
}

# Creates a directory; its parent must exist.
pub def mkdir(name: Str, perm: Int) -> ~Unit {
  r = c_mkdir(name, perm.to_i32)
  fail ferr("mkdir" + " " + name, C.errno) if r != 0
}

# Creates a directory and any missing parents; nothing to do if it exists.
pub def mkdir_all(name: Str, perm: Int) -> ~Unit {
  s = stat(name)
  if s.ok? {
    fail ferr("mkdir" + " " + name, c("ENOTDIR")) if !s.unwrap.is_dir
    return
  }
  # Missing ancestors, nearest first.
  todo: [Str] = []
  p = path.clean(name)
  loop {
    break if p == "/" || p == "." || p.size == 0
    st = stat(p)
    break if st.ok?
    todo << p
    p = path.dir(p)
  }
  i = todo.size - 1
  while i >= 0 {
    r = c_mkdir(todo[i], perm.to_i32)
    if r != 0 {
      code = C.errno
      # Lost a race to another creator: fine if it is a directory now.
      ok = false
      if code == c("EEXIST") {
        st = stat(todo[i])
        ok = st.ok? && st.unwrap.is_dir
      }
      fail ferr("mkdir" + " " + todo[i], code) if !ok
    }
    i -= 1
  }
}

# Removes a file or an empty directory.
pub def remove(name: Str) -> ~Unit {
  return if c_unlink(name) == 0
  e1 = C.errno
  return if c_rmdir(name) == 0
  e2 = C.errno
  code = e1
  code = e2 if e2 != c("ENOTDIR")
  fail ferr("remove" + " " + name, code)
}

# Removes the path and everything below it; not an error if it doesn't exist.
pub def remove_all(name: Str) -> ~Unit {
  st = lstat(name)
  if st.err? {
    e = st.err.unwrap
    return if is_not_exist(e)
    fail e
  }
  if st.unwrap.is_dir {
    entries = ~read_dir(name)
    for en in entries {
      ~remove_all(path.join([name, en.name]))
    }
  }
  ~remove(name)
}

# Moves (renames) old to new, replacing a file at new.
pub def rename(old: Str, new: Str) -> ~Unit {
  r = c_rename(old, new)
  fail ferr("rename" + " " + old + " " + new, C.errno) if r != 0
}

pub def chmod(name: Str, mode: Int) -> ~Unit {
  r = c_chmod(name, mode.to_i32)
  fail ferr("chmod" + " " + name, C.errno) if r != 0
}

pub def truncate(name: Str, size: Int) -> ~Unit {
  r = c_truncate(name, size)
  fail ferr("truncate" + " " + name, C.errno) if r != 0
}

# A hard link `new` to `old`.
pub def link(old: Str, new: Str) -> ~Unit {
  r = c_link(old, new)
  fail ferr("link" + " " + old + " " + new, C.errno) if r != 0
}

# A symbolic link at `new` pointing to `old`.
pub def symlink(old: Str, new: Str) -> ~Unit {
  r = c_symlink(old, new)
  fail ferr("symlink" + " " + old + " " + new, C.errno) if r != 0
}

# The target of a symbolic link.
pub def readlink(name: Str) -> ~Str {
  buf = zeros(4096)
  n = c_readlink(name, buf, 4096)
  fail ferr("readlink" + " " + name, C.errno) if n < 0
  Str.from_bytes(buf[0...n])
}

# A new directory in `dir` (the temp dir if ""), named pattern with its last
# `*` replaced by a random string (or the string appended). Returns its path.
pub def mkdir_temp(dir: Str, pattern: Str) -> ~Str {
  fail ferr("mkdirtemp " + pattern, ERR_PATTERN_SEP) if pattern.bytes.any? { |b| b == 47 }
  base = dir
  base = temp_dir if base.size == 0
  i = 0
  while i < 10000 {
    name = temp_name(base, pattern, i)
    r = c_mkdir(name, 0o700)
    return name if r == 0
    code = C.errno
    # A missing directory is reported for the directory (Go).
    fail ferr("mkdirtemp " + base, code) if code == c("ENOENT") && stat(base).err != none
    fail ferr("mkdir" + " " + name, code) if code != c("EEXIST")
    i += 1
  }
  fail ferr("mkdir" + " " + base, c("EEXIST"))
}

# Creates and opens (read-write) a new file the same way; see mkdir_temp.
pub def create_temp(dir: Str, pattern: Str) -> ~File {
  fail ferr("createtemp " + pattern, ERR_PATTERN_SEP) if pattern.bytes.any? { |b| b == 47 }
  base = dir
  base = temp_dir if base.size == 0
  i = 0
  while i < 10000 {
    name = temp_name(base, pattern, i)
    fd = alx_sys_open(name, native_flags(O_RDWR | O_CREATE | O_EXCL).to_i32, 0o600)
    return new_file(fd.to_i, name) if fd >= 0
    code = C.errno
    fail ferr("open" + " " + name, code) if code != c("EEXIST")
    i += 1
  }
  fail ferr("open" + " " + base, c("EEXIST"))
}

def temp_name(base: Str, pattern: Str, attempt: Int) -> Str {
  t = alx_mono_ns
  r = ((t ^ (getpid << 20) ^ (attempt * 2654435761)) & 0x7fffffff).to_s
  star = -1
  i = pattern.size - 1
  while i >= 0 && star < 0 {
    star = i if pattern[i] == 42
    i -= 1
  }
  name = pattern + r
  name = pattern[0...star] + r + pattern[star + 1...pattern.size] if star >= 0
  path.join([base, name])
}

# ---------------------------------------------------------------- environment

# The program's arguments; args[0] is the program (under `alx run`, the .alx
# file).
pub def args -> [Str] {
  out: [Str] = []
  n = alx_argc
  i = 0
  while i < n {
    out << Str.from_cstr(alx_argv(i))
    i += 1
  }
  out
}

# The value of an environment variable, or none if it isn't set (Go's
# LookupEnv). `getenv("X") || ""` is Go's Getenv.
pub def getenv(key: Str) -> Str? {
  p = c_getenv(key)
  return none if p.null?
  Str.from_cstr(p)
}

pub def setenv(key: Str, value: Str) -> ~Unit {
  r = c_setenv(key, value, 1)
  fail ferr("setenv" + " " + key, C.errno) if r != 0
}

pub def unsetenv(key: Str) -> ~Unit {
  r = c_unsetenv(key)
  fail ferr("unsetenv" + " " + key, C.errno) if r != 0
}

# The environment as "KEY=value" strings.
pub def environ -> [Str] {
  out: [Str] = []
  i = 0
  loop {
    p = alx_environ(i)
    break if p.null?
    out << Str.from_cstr(p)
    i += 1
  }
  out
}

# Ends the program at once with this status (deferred calls don't run).
pub def exit(code: Int) {
  c_exit(code.to_i32)
}

pub def getpid -> Int { c_getpid.to_i }
pub def getppid -> Int { c_getppid.to_i }
pub def getuid -> Int { c_getuid.to_i }
pub def getgid -> Int { c_getgid.to_i }

pub def hostname -> ~Str {
  buf = zeros(256)
  r = c_gethostname(buf, 255)
  fail ferr("hostname" + " " + "", C.errno) if r != 0
  cstr_of(buf)
}

# The current working directory.
pub def getwd -> ~Str {
  buf = zeros(4096)
  p = c_getcwd(buf, 4096)
  fail ferr("getwd" + " " + "", C.errno) if p.null?
  cstr_of(buf)
}

pub def chdir(dir: Str) -> ~Unit {
  r = c_chdir(dir)
  fail ferr("chdir" + " " + dir, C.errno) if r != 0
}

# The directory for temporary files: $TMPDIR, else /tmp.
pub def temp_dir -> Str {
  d = getenv("TMPDIR") || ""
  return "/tmp" if d.size == 0
  d
}

pub def user_home_dir -> ~Str {
  d = getenv("HOME") || ""
  fail ferr("home" + " " + "$HOME", c("ENOENT")) if d.size == 0
  d
}

pub def user_config_dir -> ~Str {
  d = getenv("XDG_CONFIG_HOME") || ""
  return d if d.size > 0
  h = ~user_home_dir
  h + "/.config"
}

pub def user_cache_dir -> ~Str {
  d = getenv("XDG_CACHE_HOME") || ""
  return d if d.size > 0
  h = ~user_home_dir
  h + "/.cache"
}
