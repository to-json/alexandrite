# ------------------------------------------------------------------ constants

# Open flags (see the header). The access mode is the low two bits.
pub O_RDONLY = 0
pub O_WRONLY = 1
pub O_RDWR = 2
pub O_APPEND = 8
pub O_CREATE = 16
pub O_EXCL = 32
pub O_SYNC = 64
pub O_TRUNC = 128
pub O_NONBLOCK = 256 # Go: syscall.O_NONBLOCK (reads and writes still wait, see read!)

# Go's os.ModePerm, and the file type bits of FileInfo.mode (st_mode's).
pub MODE_PERM = 0o777
pub MODE_TYPE = 0o170000
pub MODE_DIR = 0o040000
pub MODE_REGULAR = 0o100000
pub MODE_SYMLINK = 0o120000
pub MODE_NAMED_PIPE = 0o010000
pub MODE_CHAR_DEVICE = 0o020000
pub MODE_DEVICE = 0o060000
pub MODE_SOCKET = 0o140000
pub MODE_SETUID = 0o4000
pub MODE_SETGID = 0o2000
pub MODE_STICKY = 0o1000

pub PATH_SEPARATOR = "/"
pub PATH_LIST_SEPARATOR = ":"
pub DEV_NULL = "/dev/null"

# Seek whence values (Go's io.SeekStart ..., the deprecated os.SEEK_SET ...).
pub SEEK_SET = 0
pub SEEK_CUR = 1
pub SEEK_END = 2

# FsFailure codes that are not errnos: Go's error values without an errno.
pub ERR_PATTERN_SEP = -1      # "pattern contains path separator"
pub ERR_CLOSED = -2           # Go's ErrClosed: "file already closed"
pub ERR_NEGATIVE_OFFSET = -3  # "negative offset" (read_at / write_at)
pub ERR_PROCESS_DONE = -4     # Go's ErrProcessDone: "os: process already finished"
pub ERR_PROCESS_RELEASED = -5 # "os: process already released"
pub ERR_WRITE_AT_APPEND = -6  # "os: invalid use of WriteAt on file opened with O_APPEND"
pub ERR_INVALID = -7          # Go's ErrInvalid: "invalid argument"
pub ERR_NO_HOME = -8          # "$HOME is not defined"
pub ERR_NO_CACHE_HOME = -9    # "neither $XDG_CACHE_HOME nor $HOME are defined"
pub ERR_NO_CONFIG_HOME = -10  # "neither $XDG_CONFIG_HOME nor $HOME are defined"
pub ERR_CACHE_RELATIVE = -11  # "path in $XDG_CACHE_HOME is relative"
pub ERR_CONFIG_RELATIVE = -12 # "path in $XDG_CONFIG_HOME is relative"
pub ERR_EXIST = -13           # Go's ErrExist: "file already exists"
pub ERR_NOT_EXIST = -14       # Go's ErrNotExist: "file does not exist"
pub ERR_PROCESS_UNSET = -15   # "os: process not initialized"

# What an FsFailure is, as Go's error types.
pub PATH_ERROR = 0    # PathError: "op path: err"
pub LINK_ERROR = 1    # LinkError: "op old new: err"
pub SYSCALL_ERROR = 2 # SyscallError: "syscall: err"
pub PLAIN_ERROR = 3   # an error value of its own (ErrProcessDone): "err"

def c(name: Str) -> Int { alx_sys_const(name) }

# macOS (else Linux): the errno numbers tell.
def darwin? -> Bool { c("EAGAIN") == 35 }

# ---------------------------------------------------------------------- errors

# What failed, as Go's PathError / LinkError / SyscallError: the operation
# (`open`, `rename`; a SyscallError's syscall), the path ("" for a
# SyscallError; a LinkError's old name), a LinkError's new name, and the
# errno (or one of the ERR_* codes above). `kind` is PATH_ERROR, ...
pub struct FsFailure {
  op: Str
  path: Str
  new_path: Str
  code: Int
  kind: Int

  # Go's e.Err.Error(): "no such file or directory".
  pub def err -> Str { errno_message(code) }
}

# A failed system call, by kind: the variants are what programs branch on;
# `Other` is everything else. Each holds the FsFailure. (One payload per
# variant keeps the closed `Error` sum narrow, which the Rust oracle needs.)
pub error FsError {
  NotExist(at: FsFailure)
  Exist(at: FsFailure)
  Permission(at: FsFailure)
  IsDir(at: FsFailure)
  NotDir(at: FsFailure)
  NotEmpty(at: FsFailure)
  Other(at: FsFailure)

  def message -> Str {
    f = failure
    describe(f)
  }

  # The failed call's details.
  pub def failure -> FsFailure {
    case self {
      NotExist(at) => at
      Exist(at) => at
      Permission(at) => at
      IsDir(at) => at
      NotDir(at) => at
      NotEmpty(at) => at
      Other(at) => at
    }
  }

  # The errno (or ERR_* code).
  pub def errno -> Int {
    f = failure
    f.code
  }

  # Go's PathError.Op / LinkError.Op / SyscallError.Syscall.
  pub def op -> Str {
    f = failure
    f.op
  }

  # Go's PathError.Path (LinkError.Old).
  pub def path -> Str {
    f = failure
    f.path
  }

  # Go's err.(*LinkError) / err.(*SyscallError) / err.(*PathError).
  pub def link_error? -> Bool { failure.kind == LINK_ERROR }
  pub def syscall_error? -> Bool { failure.kind == SYSCALL_ERROR }
  pub def path_error? -> Bool { failure.kind == PATH_ERROR }

  # Go's SyscallError.Timeout / os.IsTimeout: never, here (no deadlines).
  pub def timeout? -> Bool { false }
}

# C's message for an errno, in Go's lower case: "no such file or directory";
# the ERR_* codes' messages for those.
pub def errno_message(code: Int) -> Str {
  return "pattern contains path separator" if code == ERR_PATTERN_SEP
  return "file already closed" if code == ERR_CLOSED
  return "negative offset" if code == ERR_NEGATIVE_OFFSET
  return "os: process already finished" if code == ERR_PROCESS_DONE
  return "os: process already released" if code == ERR_PROCESS_RELEASED
  return "os: invalid use of WriteAt on file opened with O_APPEND" if code == ERR_WRITE_AT_APPEND
  return "invalid argument" if code == ERR_INVALID
  return "$HOME is not defined" if code == ERR_NO_HOME
  return "neither $XDG_CACHE_HOME nor $HOME are defined" if code == ERR_NO_CACHE_HOME
  return "neither $XDG_CONFIG_HOME nor $HOME are defined" if code == ERR_NO_CONFIG_HOME
  return "path in $XDG_CACHE_HOME is relative" if code == ERR_CACHE_RELATIVE
  return "path in $XDG_CONFIG_HOME is relative" if code == ERR_CONFIG_RELATIVE
  return "file already exists" if code == ERR_EXIST
  return "file does not exist" if code == ERR_NOT_EXIST
  return "os: process not initialized" if code == ERR_PROCESS_UNSET
  s = C.strerror(code)
  # Go's syscall table differs from macOS's strerror in a few places.
  return "operation not supported" if s == "Operation not supported on socket"
  return s if s.size == 0 || s[0] < 65 || s[0] > 90
  # "I/O error" style messages keep their capitals.
  return s if s.size > 1 && s[1] >= 65 && s[1] <= 90
  b = s.bytes.to_a
  b[0] = b[0] + 32
  Str.from_bytes(b)
}

def describe(f: FsFailure) -> Str {
  m = errno_message(f.code)
  case f.kind {
    0 => "#{f.op} #{f.path}: #{m}"
    1 => "#{f.op} #{f.path} #{f.new_path}: #{m}"
    2 => "#{f.op}: #{m}"
    _ => m
  }
}

# The FsError (a PathError) for errno `code`.
pub def fs_error(op: Str, path: Str, code: Int) -> FsError {
  ferr(op + " " + path, code)
}

# Go's NewSyscallError(syscall, errno): "syscall: message".
pub def new_syscall_error(syscall: Str, code: Int) -> FsError {
  ferr(syscall, code)
}

# A LinkError: "op old new: message".
pub def link_error(op: Str, old: Str, new: Str, code: Int) -> FsError {
  ferr(op + " " + old + nul + new, code)
}

def nul -> Str { Str.from_bytes([0]) }

# The FsError for `where` and the code. `where` is one string (the region
# analysis makes a function that stores two of its Str parameters into one
# object keep both alive for the whole program: that would leak on every I/O
# call): "op path" (a PathError), "op old\0new" (a LinkError), "op" (no
# space: a SyscallError) or "" (a plain error: just the message).
def ferr(where: Str, code: Int) -> FsError {
  i = 0
  while i < where.size && where[i] != 32 {
    i += 1
  }
  kind = PATH_ERROR
  kind = SYSCALL_ERROR if i == where.size
  kind = PLAIN_ERROR if where.size == 0
  rest = i < where.size ? where[i + 1...where.size] : ""
  j = 0
  while j < rest.size && rest[j] != 0 {
    j += 1
  }
  new_path = ""
  if j < rest.size {
    kind = LINK_ERROR
    new_path = rest[j + 1...rest.size]
    rest = rest[0...j]
  }
  at = FsFailure.new(op: where[0...i], path: rest, new_path: new_path, code: code, kind: kind)
  return FsError.NotExist(at) if code == c("ENOENT") || code == ERR_NOT_EXIST
  return FsError.Exist(at) if code == c("EEXIST") || code == ERR_EXIST
  return FsError.Permission(at) if code == c("EACCES") || code == c("EPERM")
  return FsError.IsDir(at) if code == c("EISDIR")
  return FsError.NotDir(at) if code == c("ENOTDIR")
  return FsError.NotEmpty(at) if code == c("ENOTEMPTY")
  FsError.Other(at)
}

# Go's os.IsNotExist / errors.Is(err, ErrNotExist): the file or directory
# doesn't exist.
pub def is_not_exist(e: Error) -> Bool {
  case e {
    NotExist => true
    _ => false
  }
}

# Go's os.IsExist / errors.Is(err, ErrExist) (a non-empty directory too).
pub def is_exist(e: Error) -> Bool {
  case e {
    Exist => true
    NotEmpty => true
    _ => false
  }
}

# Go's os.IsPermission / errors.Is(err, ErrPermission).
pub def is_permission(e: Error) -> Bool {
  case e {
    Permission => true
    _ => false
  }
}

# Go's os.IsTimeout: never true here (files have no deadlines).
pub def is_timeout(e: Error) -> Bool { false }

# Go's errors.Is(err, ErrClosed): the File was already closed.
pub def is_closed(e: Error) -> Bool { code_of(e) == ERR_CLOSED }

# Go's errors.Is(err, ErrProcessDone).
pub def is_process_done(e: Error) -> Bool { code_of(e) == ERR_PROCESS_DONE }

# Go's errors.Is(err, ErrInvalid) (EINVAL too, as in Go's syscall.Errno.Is).
pub def is_invalid(e: Error) -> Bool {
  k = code_of(e)
  k == ERR_INVALID || k == c("EINVAL")
}

# The FsError's code (0 for another error).
def code_of(e: Error) -> Int {
  case e {
    NotExist(at) => at.code
    Exist(at) => at.code
    Permission(at) => at.code
    IsDir(at) => at.code
    NotDir(at) => at.code
    NotEmpty(at) => at.code
    Other(at) => at.code
    _ => 0
  }
}

# A NUL byte: no C path holds one (Go's syscall.ByteSliceFromString fails
# with EINVAL).
def nul?(s: Str) -> Bool { s.bytes.any? { |b| b == 0 } }

# Go's os.IsPathSeparator.
pub def is_path_separator(b: Byte) -> Bool { b == 47 }

# ------------------------------------------------------------------- bytes in/out

# The k-th native-endian (little-endian) Int of a stat buffer.
def get64(b: [Byte], k: Int) -> Int {
  v = 0
  i = 7
  while i >= 0 {
    v = (v << 8) | b[k * 8 + i].to_i
    i -= 1
  }
  v
}

def put64(b: [Byte], k: Int, v: Int) {
  i = 0
  while i < 8 {
    b[k * 8 + i] = ((v >> (8 * i)) & 255).as_u8
    i += 1
  }
}

# The C string in b (up to the first NUL).
def cstr_of(b: [Byte]) -> Str {
  n = 0
  while n < b.size && b[n] != 0 {
    n += 1
  }
  Str.from_bytes(b[0...n])
}

def zeros(n: Int) -> [Byte] {
  b: [Byte] = [0; n]
  b
}

# The stat buffer's size: ALX_STAT_FIELDS Ints.
STAT_SIZE = 88
