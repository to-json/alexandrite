test "OpenFileKeepsPermissions" { |t|
  name = t.temp_dir + "/x"
  touch(name)
  f = os.open_file(name, os.O_WRONLY | os.O_CREATE | os.O_TRUNC, 0).unwrap
  assert (f.stat.unwrap.mode & 0o222) != 0, "f.Stat.Mode after OpenFile should be writable"
  f.close!.unwrap
  assert (os.stat(name).unwrap.mode & 0o222) != 0, "Stat after OpenFile should be writable"
}

test "FileIOCloseRace" { |t|
  file = os.create(t.temp_dir + "/test.txt").unwrap
  a = file.dup
  b = file.dup
  t1 = spawn {
    tmp: [Byte] = [0; 100]
    f = a
    r = f.write!(tmp)
    assert r.ok? || os.is_closed(r.err.unwrap) || r.err.unwrap.message.include?("bad file descriptor"), "#{r.err}"
    0
  }
  t2 = spawn {
    tmp: [Byte] = [0; 100]
    f = b
    r = f.read!(tmp)
    assert r.ok? || os.is_closed(r.err.unwrap) || r.err.unwrap.message.include?("bad file descriptor"), "#{r.err}"
    0
  }
  file.close!.unwrap
  t1.wait.unwrap
  t2.wait.unwrap
}

test "PipeIOCloseRace" {
  r, w = os.pipe.unwrap
  wa = w.dup
  ra = r.dup
  writer = spawn {
    f = wa
    loop {
      res = f.write!("hi".bytes.to_a)
      if e = res.err {
        ok = os.is_closed(e) || e.message.include?("broken pipe") || e.message.include?("bad file descriptor")
        assert ok, e.message
        break
      }
      assert_eq res.unwrap, 2
    }
    0
  }
  reader = spawn {
    f = ra
    buf: [Byte] = [0; 2]
    loop {
      res = f.read!(buf)
      if e = res.err {
        ok = os.is_closed(e) || e.message.include?("bad file descriptor")
        assert ok, e.message
        break
      }
      break if res.unwrap == 0
    }
    0
  }
  time.sleep(time.millisecond)
  r.close!.unwrap
  w.close!.unwrap
  writer.wait.unwrap
  reader.wait.unwrap
}

# Go closes the same pipe from two goroutines: one close of each end wins.
# Copies of a File share its state (D36), as Go's goroutines share *File.
test "PipeCloseRace" {
  r, w = os.pipe.unwrap
  c = Chan[Bool].new(4)
  st = Mutex.new((r, w))
  for _i in 0...2 {
    s = st
    ch = c
    spawn {
      p = s.lock { |p| p }
      rr = p[0]
      ww = p[1]
      ch << rr.close!.ok?
      ch << ww.close!.ok?
    }
  }
  nils = 0
  errs = 0
  for _i in 0...4 {
    if c.recv.unwrap {
      nils += 1
    } else {
      errs += 1
    }
  }
  assert nils == 2 && errs == 2, "got nils #{nils} errs #{errs}, want 2 2"
}

test "RandomLen" { |t|
  for _i in 0...5 {
    dir = os.mkdir_temp(t.temp_dir, "*").unwrap
    base = filepath.base(dir)
    assert base.size <= 10, "MkdirTemp returned len #{base.size}: #{base}"
  }
  for _i in 0...5 {
    f = os.create_temp(t.temp_dir, "*").unwrap
    base = filepath.base(f.name)
    f.close!.unwrap
    assert base.size <= 10, "CreateTemp returned len #{base.size}: #{base}"
  }
}

test "AppendDoesntOverwrite" { |t|
  t.chdir(t.temp_dir)
  name = "file"
  os.write_file(name, "hello".bytes, 0o666).unwrap
  f = os.open_file(name, os.O_APPEND | os.O_WRONLY, 0).unwrap
  f.write!(" world".bytes.to_a).unwrap
  f.close!.unwrap
  assert_eq os.read_file_string(name).unwrap, "hello world"
}

test "RemoveReadOnlyFile" { |t|
  t.chdir(t.temp_dir)
  os.write_file("file", "1".bytes, 0).unwrap
  os.remove("file").unwrap
  assert os.is_not_exist(os.stat("file").err.unwrap)
}

test "OpenFileDevNull" {
  f = os.open_file(os.DEV_NULL, os.O_WRONLY | os.O_CREATE | os.O_TRUNC, 0o644).unwrap
  f.close!.unwrap
}
