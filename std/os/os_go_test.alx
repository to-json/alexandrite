# Go lists the working directory; a fixture here.
test "DirSeek" { |t|
  f = os.open(dotdir(t)).unwrap
  dirnames1 = f.readdirnames!(0).unwrap
  assert_eq f.seek!(0, 0).unwrap, 0
  dirnames2 = f.readdirnames!(0).unwrap
  assert_eq dirnames1, dirnames2
  assert_eq dirnames1.size, DOT.size
