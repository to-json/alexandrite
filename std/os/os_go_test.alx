}

test "SameFile" { |t|
  t.chdir(t.temp_dir)
  touch("a")
  touch("b")
  ia1 = os.stat("a").unwrap
  ia2 = os.stat("a").unwrap
  assert os.same_file(ia1, ia2), "files should be same"
  ib = os.stat("b").unwrap
  assert !os.same_file(ia1, ib), "files should be different"
}

def test_dev_null_file_info(statname: Str, fi: os.FileInfo) {
  pre = "#{statname}(#{os.DEV_NULL}): "
  assert fi.size == 0, pre + "wrong file size have #{fi.size} want 0"
  m = fi.go_mode
  assert (m & (1 << 26)) != 0, pre + "ModeDevice is not set"
  assert (m & (1 << 21)) != 0, pre + "ModeCharDevice is not set"
  assert !fi.is_regular, pre + "IsRegular returns true"
}

test "DevNullFile" {
  f = os.open(os.DEV_NULL).unwrap
  test_dev_null_file_info("f.Stat", f.stat.unwrap)
  test_dev_null_file_info("Stat", os.stat(os.DEV_NULL).unwrap)
  f.close!.unwrap
}

test "StatDirModeExec" { |t|
  path = t.temp_dir
  os.chmod(path, 0o777).unwrap
  dir = os.stat(path).unwrap
  assert (dir.mode & 0o111) == 0o111, "Stat #{path}: mode #{dir.mode & 0o111} want 0o111"
}

# Go re-runs the test binary with a pipe as stdin; here a pipe's read end
# (what that child's stdin would be) is checked directly.
test "StatStdin" {
  fi = os.stdin.stat.unwrap
  # (A regular file or a socket too: alx test passes its own stdin on.)
  ok = fi.is_char_device || fi.is_named_pipe || fi.is_regular || (fi.mode & os.MODE_TYPE) == os.MODE_SOCKET
  assert ok, "unexpected Stdin mode (#{fi.mode}), want ModeCharDevice or ModeNamedPipe"
  r, w = os.pipe.unwrap
  assert r.stat.unwrap.is_named_pipe, "a pipe is not a named pipe"
  r.close!.unwrap
  w.close!.unwrap
}

test "StatRelativeSymlink" { |t|
  tmpdir = t.temp_dir
  target = tmpdir + "/target"
  f = os.create(target).unwrap
  st = f.stat.unwrap
  link = tmpdir + "/link"
  os.symlink(filepath.base(target), link).unwrap
  st1 = os.stat(link).unwrap
  assert os.same_file(st, st1), "Stat doesn't follow relative symlink"
  f.close!.unwrap
}

# Go's io.EOF from a short ReadAt is a short count here.
test "ReadAtEOF" { |t|
  f = new_file(t)
  b: [Byte] = [0; 10]
  assert_eq f.read_at(b, 0).unwrap, 0
}

test "LongPath" { |t|
  tmpdir = t.temp_dir
  while tmpdir.size < 400 {
    tmpdir += "/dir3456789"
  }
  for sz in [247, 248, 249, 400] {
    t.run("length=#{sz}") { |t|
      sized = tmpdir[0...sz - 1] + "x"
      os.mkdir_all(sized, 0o755).unwrap
      data = "hello world\n"
      os.write_file(sized + "/foo.txt", data.bytes, 0o644).unwrap
      os.rename(sized + "/foo.txt", sized + "/bar.txt").unwrap
      mtime = 1_700_000_000 * SECOND
      os.chtimes(sized + "/bar.txt", mtime, mtime).unwrap
      os.symlink(sized + "/bar.txt", sized + "/symlink.txt").unwrap
      os.link(sized + "/bar.txt", sized + "/link.txt").unwrap
      names = ["bar.txt", "symlink.txt", "link.txt"]
      for want_size in [data.size, 0] {
        for name in names {
          path = sized + "/" + name
          dir = os.stat(path).unwrap
          filesize = size(path)
          assert dir.size == filesize && filesize == want_size, "Size(#{path}) is #{dir.size}, len(ReadFile()) is #{filesize}, want #{want_size}"
          os.chmod(path, dir.perm).unwrap
        }
        os.truncate(sized + "/bar.txt", 0).unwrap
      }
    }
  }
}

# Go's testKillProcess re-runs the test binary as a child that drains its
# stdin; here `cat` does, with its stdin a pipe kept open.
def test_kill_process(killer: (os.Process) -> Unit) {
  r, w = os.pipe.unwrap
  files: [os.File?] = [r, none, none]
  p = os.start_process("/bin/cat", ["cat"], os.ProcAttr.new(dir: "", env: none, files: files)).unwrap
  r.close!.unwrap
  killer.call(p)
  st = p.wait!.unwrap
  assert !st.success, "Test process succeeded, but expected to fail"
  w.close!.unwrap
}

test "KillStartProcess" {
  test_kill_process { |p| p.kill.unwrap }
}

# Go's child prints Getppid; here sh prints $PPID.
test "Getppid" {
  r, w = os.pipe.unwrap
  files: [os.File?] = [none, w, none]
  p = os.start_process("/bin/sh", ["sh", "-c", "printf %s $PPID"], os.ProcAttr.new(dir: "", env: none, files: files)).unwrap
  w.close!.unwrap
  child_ppid = Str.from_bytes(io.read_all(r).unwrap)
  r.close!.unwrap
  p.wait!.unwrap
  assert_eq child_ppid, os.getpid.to_s
}

test "KillFindProcess" {
  test_kill_process { |p|
    p2 = os.find_process(p.pid).unwrap
    p2.kill.unwrap
  }
}

# Go calls each method on a nil *File (ErrInvalid); alx has no nil File
# (new_file(-1) is none), so the same methods on a closed File fail with
# ErrClosed instead.
test "NilFileMethods" { |t|
  f = os.create(t.temp_dir + "/f").unwrap
  f.close!.unwrap
  e: [Byte] = []
  checks = [
    ("Chdir", f.chdir!.err),
    ("Close", f.close!.err),
    ("Chmod", f.chmod!(0).err),
    ("Chown", f.chown!(0, 0).err),
    ("Read", f.read!(e).err),
    ("ReadAt", f.read_at(e, 0).err),
    ("Readdir", f.readdir!(1).err),
    ("Readdirnames", f.readdirnames!(1).err),
    ("Seek", f.seek!(0, io.SEEK_START).err),
    ("Stat", f.stat.err),
    ("Sync", f.sync!.err),
    ("Truncate", f.truncate!(0).err),
    ("Write", f.write!(e).err),
    ("WriteAt", f.write_at(e, 0).err),
    ("WriteString", f.write_string!("").err),
  ]
  for c in checks {
    got = c[1]
    assert got != none && os.is_closed(got.unwrap), "#{c[0]} should fail when f is closed; got #{got}"
  }
}

def mkdir_tree(root: Str, level: Int, max: Int) -> Unit {
  return if level >= max
  for c in ["a", "b"] {
    dir = root + "/" + c
    os.mkdir(dir, 0o700).unwrap
    mkdir_tree(dir, level + 1, max)
  }
}

test "RemoveAllRace" { |t|
  root = t.temp_dir
  mkdir_tree(root, 1, 6)
  hold = Chan[Int].new(0)
  tasks: [Task[Int]] = []
  for _i in 0...4 {
    h = hold
    rt = root
    tasks << spawn {
      h.recv
      r = os.remove_all(rt)
      assert r.ok?, "unexpected error: #{r.err}"
      0
    }
  }
  hold.close
  for tk in tasks { tk.wait.unwrap }
}

# 100 tasks each blocked reading its own pipe (port-issues #166: none may
# block a worker).
test "PipeThreads" {
  threads = 100
  rs: [os.File] = []
  ws: [os.File] = []
  for _i in 0...threads {
    r, w = os.pipe.unwrap
    rs << r
    ws << w
  }
  creading = Chan[Bool].new(threads)
  cdone = Chan[Bool].new(threads)
  for i in 0...threads {
    r = rs[i].dup
    cr = creading
    cd = cdone
    spawn {
      b: [Byte] = [0; 1]
      cr << true
      f = r
      f.read!(b).unwrap
      f.close!.unwrap
      cd << true
    }
  }
  for _i in 0...threads { creading.recv }
  for i in 0...threads {
    w = ws[i]
    w.write!([0]).unwrap
    w.close!.unwrap
    cdone.recv
  }
}

def test_double_close_error(path: Str) {
  file = os.open(path).unwrap
  file.close!.unwrap
  e = file.close!.err
  assert e != none, "second Close did not fail"
  pe = e.unwrap
  assert pe.path_error?, "second Close: want a PathError"
  assert os.is_closed(pe), "second Close: got #{pe}, want ErrClosed"
}

test "DoubleCloseError" { |t|
  d = sysdir(t)
  t.run("file") { |_t| test_double_close_error(d + "/group") }
  t.run("dir") { |_t| test_double_close_error(d) }
}

test "UserCacheDir" { |t|
