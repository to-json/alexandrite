#![test(external)]
# Go's os/os_test.go, translated. Differences: Go reads /etc, /usr/bin and
# the os package's own sources; here a fixture directory in a temp dir
# stands in (the tests stay hermetic). Untranslated tests are listed in
# os.alx's header.

import "os"
import "os/exec"
import "io"
import "path/filepath"
import "strings"
import "testing"
import "time"

# Go's sysdir: a directory with known files (here made in a temp dir).
def sysdir(t: testing.T) -> Str {
  d = t.temp_dir + "/etc"
  os.mkdir(d, 0o755).unwrap
  os.write_file(d + "/group", "wheel:*:0:root\n".bytes, 0o644).unwrap
  os.write_file(d + "/hosts", "127.0.0.1 localhost\n".bytes, 0o644).unwrap
  os.write_file(d + "/passwd", "root:*:0:0::/root:/bin/sh\n".bytes, 0o644).unwrap
  d
}

SYSFILES = ["group", "hosts", "passwd"]

# Go's dot: files of the current directory (here, of a fixture).
DOT = ["dir_unix.go", "env.go", "error.go", "file.go", "os_test.go", "types.go", "stat_darwin.go", "stat_linux.go"]

def dotdir(t: testing.T) -> Str {
  d = t.temp_dir + "/dot"
  os.mkdir(d, 0o755).unwrap
  for n in DOT {
    os.write_file(d + "/" + n, "package os\n".bytes, 0o644).unwrap
  }
  d
}

# The size of the named file, by reading it.
def size(name: Str) -> Int {
  f = os.open(name).unwrap
  n = 0
  buf: [Byte] = [0; 512]
  loop {
    k = f.read!(buf).unwrap
    break if k == 0
    n += k
  }
  f.close!.unwrap
  n
}

# Go's newFile: a temp file, closed and removed after the test.
def new_file(t: testing.T) -> os.File {
  f = os.create_temp("", "_Go_" + strings.replace_all(t.name, " ", "_")).unwrap
  g = f
  t.cleanup {
    c = g.close!
    if e = c.err {
      t.fatal(e.message) if !os.is_closed(e)
    }
    os.remove(g.name).unwrap
  }
  f
}

def touch(name: Str) {
  f = os.create(name).unwrap
  f.close!.unwrap
}

test "Stat" { |t|
  path = sysdir(t) + "/group"
  dir = os.stat(path).unwrap
  assert_eq dir.name, "group"
  assert_eq dir.size, size(path)
}

test "StatError" { |t|
  t.chdir(t.temp_dir)
  path = "no-such-file"
  r = os.stat(path)
  assert r.err?, "got nil, want error"
  assert r.err.unwrap.path_error?
  os.symlink(path, "symlink").unwrap
  r2 = os.stat("symlink")
  assert r2.err?, "got nil, want error"
  assert r2.err.unwrap.path_error?
}

test "StatSymlinkLoop" { |t|
  t.chdir(t.temp_dir)
  os.symlink("x", "y").unwrap
  os.symlink("y", "x").unwrap
  r = os.stat("x")
  assert r.err.unwrap.path_error?, "expected PathError"
  assert_eq r.err.unwrap.message, "stat x: too many levels of symbolic links"
}

test "Fstat" { |t|
  path = sysdir(t) + "/group"
  file = os.open(path).unwrap
  dir = file.stat.unwrap
  assert_eq dir.name, "group"
  assert_eq dir.size, size(path)
  file.close!.unwrap
}

test "Lstat" { |t|
  path = sysdir(t) + "/group"
  dir = os.lstat(path).unwrap
  assert_eq dir.name, "group"
  assert_eq dir.size, size(path) if !dir.is_symlink
}

test "Read0" { |t|
  f = os.open(sysdir(t) + "/group").unwrap
  b: [Byte] = []
  assert_eq f.read!(b).unwrap, 0
  b2: [Byte] = [0; 100]
  assert f.read!(b2).unwrap > 0
  f.close!.unwrap
}

test "ReadClosed" { |t|
  file = os.open(sysdir(t) + "/group").unwrap
  file.close!.unwrap
  b: [Byte] = [0; 100]
  e = file.read!(b).err.unwrap
  assert e.path_error?
  assert os.is_closed(e)
}

def check_names(t: testing.T, got: [Str], contents: [Str]) {
  for m in contents {
    found = false
    for n in got {
      t.error("got #{n} in directory") if n == "." || n == ".."
      next if n != m
      t.error("present twice: #{m}") if found
      found = true
    }
    t.error("could not find #{m}") if !found
  }
}

def test_readdirnames(t: testing.T, dir: Str, contents: [Str]) {
  file = os.open(dir).unwrap
  s = file.readdirnames!(-1).unwrap
  check_names(t, s, contents)
  file.close!.unwrap
}

def test_readdir(t: testing.T, dir: Str, contents: [Str]) {
  file = os.open(dir).unwrap
  s = file.readdir!(-1).unwrap
  check_names(t, s.map { it.name }, contents)
  file.close!.unwrap
}

def test_read_dir(t: testing.T, dir: Str, contents: [Str]) {
  file = os.open(dir).unwrap
  s = file.read_dir!(-1).unwrap
  check_names(t, s.map { it.name }, contents)
  for n in s {
    next if !contents.include?(n.name)
    lstat = os.lstat(dir + "/" + n.name).unwrap
    assert_eq n.is_dir, lstat.is_dir
    want_type = lstat.is_regular ? 0 : lstat.mode & os.MODE_TYPE
    assert_eq n.type, want_type
    info = n.info.unwrap
    assert os.same_file(info, lstat), "#{n.name}: Info: SameFile(info, lstat) = false"
  }
  file.close!.unwrap
}

test "FileReaddirnames" { |t|
  t.run(".") { |t| test_readdirnames(t, dotdir(t), DOT) }
  t.run("sysdir") { |t| test_readdirnames(t, sysdir(t), SYSFILES) }
  t.run("TempDir") { |t| test_readdirnames(t, t.temp_dir, []) }
}

test "FileReaddir" { |t|
  t.run(".") { |t| test_readdir(t, dotdir(t), DOT) }
  t.run("sysdir") { |t| test_readdir(t, sysdir(t), SYSFILES) }
  t.run("TempDir") { |t| test_readdir(t, t.temp_dir, []) }
}

test "FileReadDir" { |t|
  t.run(".") { |t| test_read_dir(t, dotdir(t), DOT) }
  t.run("sysdir") { |t| test_read_dir(t, sysdir(t), SYSFILES) }
  t.run("TempDir") { |t| test_read_dir(t, t.temp_dir, []) }
}

# Go reads /usr/bin; a directory of 300 files here.
test "ReaddirnamesOneAtATime" { |t|
  dir = t.temp_dir
  for i in 0...300 { touch("#{dir}/f#{i}") }
  file = os.open(dir).unwrap
  all = file.readdirnames!(-1).unwrap
  file1 = os.open(dir).unwrap
  small: [Str] = []
  loop {
    d = file1.readdirnames!(1).unwrap
    break if d.size == 0
    small << d[0]
  }
  assert small.size >= all.size, "len(small) is #{small.size}, less than #{all.size}"
  for i in 0...all.size { assert_eq small[i], all[i] }
  file.close!.unwrap
  file1.close!.unwrap
}

test "ReaddirNValues" { |t|
  dir = t.temp_dir
  for i in 1..105 {
    f = os.create("#{dir}/#{i}").unwrap
    f.write!(("X" * i).bytes.to_a).unwrap
    f.close!.unwrap
  }
  # n, want (Go's io.EOF at the end is an empty result here).
  cases = [[0, 105], [0, 0], [-1, 105], [-2, 0], [0, 0], [1, 1], [2, 2], [105, 102], [3, 0]]
  reopen = [0, 2, 5] # case indexes that open the directory afresh
  for kind in 0...3 {
    d = os.open(dir).unwrap
    for i in 0...cases.size {
      c = cases[i]
      if reopen.include?(i) {
        d.close!.unwrap
        d = os.open(dir).unwrap
      }
      n = case kind {
        0 => d.readdir!(c[0]).unwrap.size
        1 => d.readdirnames!(c[0]).unwrap.size
        _ => d.read_dir!(c[0]).unwrap.size
      }
      assert n == c[1], "kind #{kind}: #{c[0]}: got #{n}, want #{c[1]}"
    }
    d.close!.unwrap
  }
}

# Go's TestReaddirStatFailures hooks lstat (SetStatHook, an export_test.go
# hook); here a file removed between listing and lstat is the vanishing
# entry Go simulates, and readdir! leaves it out.
test "ReaddirStatFailures" { |t|
  dir = t.temp_dir
  touch(dir + "/good1")
  touch(dir + "/x")
  touch(dir + "/good2")
  names = ->(fis: [os.FileInfo]) -> [Str] { fis.map { it.name }.sort }
  d = os.open(dir).unwrap
  assert_eq names.call(d.readdir!(-1).unwrap), ["good1", "good2", "x"]
  d.close!.unwrap
  d2 = os.open(dir).unwrap
  es = d2.read_dir!(1).unwrap
  os.remove(dir + "/x").unwrap
  rest = d2.readdir!(-1).unwrap
  got = names.call(rest + es.select { it.name != "x" }.map { it.info.unwrap })
  assert_eq got, ["good1", "good2"]
  d2.close!.unwrap
}

test "ReaddirOfFile" { |t|
  f = os.create_temp(t.temp_dir, "_Go_ReaddirOfFile").unwrap
  f.write!("foo".bytes.to_a).unwrap
  f.close!.unwrap
  reg = os.open(f.name).unwrap
  r = reg.readdirnames!(-1)
  assert r.err?, "Readdirnames succeeded; want non-nil error"
  e = r.err.unwrap
  assert e.path_error? && e.path == f.name, "Readdirnames returned #{e.message}; want a PathError with path #{f.name}"
  reg.close!.unwrap
}

test "HardLink" { |t|
  t.chdir(t.temp_dir)
  from = "hardlinktestfrom"
  to = "hardlinktestto"
  file = os.create(to).unwrap
  file.close!.unwrap
  os.link(to, from).unwrap
  nn = "hardlinktestnone"
  e0 = os.link(nn, nn).err.unwrap
  assert e0.link_error? && e0.message != "", "link #{nn} failed to return a valid error"
  tostat = os.stat(to).unwrap
  fromstat = os.stat(from).unwrap
  assert os.same_file(tostat, fromstat), "link #{to}, #{from} did not create hard link"
  e = os.link(to, from).err.unwrap
  assert e.link_error?
  f = e.failure
  assert_eq f.op, "link"
  assert_eq f.path, to
  assert_eq f.new_path, from
  assert os.is_exist(e)
}

test "Symlink" { |t|
  t.chdir(t.temp_dir)
  from = "symlinktestfrom"
  to = "symlinktestto"
  file = os.create(to).unwrap
  file.close!.unwrap
  os.symlink(to, from).unwrap
  tostat = os.lstat(to).unwrap
  assert !tostat.is_symlink
  fromstat = os.stat(from).unwrap
  assert os.same_file(tostat, fromstat), "Symlink(#{to}, #{from}) did not create symlink"
  fromstat = os.lstat(from).unwrap
  assert fromstat.is_symlink
  fromstat = os.stat(from).unwrap
  assert_eq fromstat.name, from
  assert !fromstat.is_symlink
  assert_eq os.readlink(from).unwrap, to
  f = os.open(from).unwrap
  f.close!.unwrap
}

test "LongSymlink" { |t|
  t.chdir(t.temp_dir)
  s = "0123456789abcdef" * 15
  from = "longsymlinktestfrom"
  os.symlink(s, from).unwrap
  assert_eq os.readlink(from).unwrap, s
}

test "Rename" { |t|
  t.chdir(t.temp_dir)
  from = "renamefrom"
  to = "renameto"
  file = os.create(from).unwrap
  file.close!.unwrap
  os.rename(from, to).unwrap
  os.stat(to).unwrap
}

test "RenameOverwriteDest" { |t|
  t.chdir(t.temp_dir)
  from = "renamefrom"
  to = "renameto"
  os.write_file(to, "to".bytes, 0o777).unwrap
  os.write_file(from, "from".bytes, 0o777).unwrap
  os.rename(from, to).unwrap
  r = os.stat(from)
  assert r.err?, "from file still exists"
  assert os.is_not_exist(r.err.unwrap)
  assert_eq os.stat(to).unwrap.size, 4
}

test "RenameFailed" { |t|
  t.chdir(t.temp_dir)
  from = "renamefrom"
  to = "renameto"
  e = os.rename(from, to).err.unwrap
  assert e.link_error?
  assert_eq e.op, "rename"
  assert_eq e.failure.path, from
  assert_eq e.failure.new_path, to
}

test "RenameNotExisting" { |t|
  t.chdir(t.temp_dir)
  from = "doesnt-exist"
  to = "dest"
  _ = os.mkdir(to, 0o777)
  assert os.is_not_exist(os.rename(from, to).err.unwrap)
}

test "RenameToDirFailed" { |t|
  t.chdir(t.temp_dir)
  from = "renamefrom"
  to = "renameto"
  _ = os.mkdir(from, 0o777)
  _ = os.mkdir(to, 0o777)
  e = os.rename(from, to).err.unwrap
  assert e.link_error?
  assert_eq e.op, "rename"
  assert_eq e.failure.path, from
  assert_eq e.failure.new_path, to
}

test "RenameCaseDifference" { |pt|
  from = "renameFROM"
  to = "RENAMEfrom"
  for kind in ["dir", "file"] {
    pt.run(kind) { |t|
      t.chdir(t.temp_dir)
      if kind == "dir" {
        os.mkdir(from, 0o777).unwrap
      } else {
        touch(from)
      }
      r = os.stat(to)
      if e = r.err {
        t.skip("case sensitive filesystem") if os.is_not_exist(e)
        t.fatal("stat #{to}, got: #{e}")
      }
      os.rename(from, to).unwrap
      fd = os.open(".").unwrap
      names = fd.readdirnames!(-1).unwrap
      fd.close!.unwrap
      assert_eq names.size, 1
      assert_eq names[0], to
    }
  }
}

def test_start_process(dir: Str, cmd: Str, args: [Str], expect: Str) {
  r, w = os.pipe.unwrap
  files: [os.File?] = [none, w, os.stderr]
  attr = os.ProcAttr.new(dir: dir, env: none, files: files)
  p = os.start_process(cmd, args, attr).unwrap
  w.close!.unwrap
  out = Str.from_bytes(io.read_all(r).unwrap)
  fi1 = os.stat(out.strip).unwrap
  fi2 = os.stat(expect).unwrap
  assert os.same_file(fi1, fi2), "exec #{cmd} returned #{out} wanted #{expect}"
  p.wait!.unwrap
  r.close!.unwrap
}

test "StartProcess" { |t|
  cmd = exec.look_path("pwd").unwrap
  dir = "/"
  cmddir = filepath.dir(cmd)
  cmdbase = filepath.base(cmd)
  t.run("absolute") { |_t| test_start_process(dir, cmd, [cmdbase], dir) }
  t.run("relative") { |_t| test_start_process(cmddir, cmdbase, [cmdbase], cmddir) }
}

def check_mode(path: Str, mode: Int) {
  dir = os.stat(path).unwrap
  assert dir.perm == mode, "Stat #{path}: mode #{dir.perm} want #{mode}"
}

test "Chmod" { |t|
  f = new_file(t)
  os.chmod(f.name, 0o456).unwrap
  check_mode(f.name, 0o456)
  f.chmod!(0o123).unwrap
  check_mode(f.name, 0o123)
}

def check_size(f: os.File, size: Int) {
  assert_eq f.stat.unwrap.size, size
}

test "FTruncate" { |t|
  f = new_file(t)
  check_size(f, 0)
  f.write!("hello, world\n".bytes.to_a).unwrap
  check_size(f, 13)
  f.truncate!(10).unwrap
  check_size(f, 10)
  f.truncate!(1024).unwrap
  check_size(f, 1024)
  f.truncate!(0).unwrap
  check_size(f, 0)
  if f.write!("surprise!".bytes.to_a).ok? {
    check_size(f, 13 + 9) # wrote at offset past where hello, world was.
  }
}

test "Truncate" { |t|
  f = new_file(t)
  check_size(f, 0)
  f.write!("hello, world\n".bytes.to_a).unwrap
  check_size(f, 13)
  os.truncate(f.name, 10).unwrap
  check_size(f, 10)
  os.truncate(f.name, 1024).unwrap
  check_size(f, 1024)
  os.truncate(f.name, 0).unwrap
  check_size(f, 0)
  if f.write!("surprise!".bytes.to_a).ok? {
    check_size(f, 13 + 9)
  }
}

test "TruncateNonexistentFile" { |t|
  path = t.temp_dir + "/nonexistent"
  e = os.truncate(path, 1).err.unwrap
  assert e.path_error? && os.is_not_exist(e) && e.path == path, "got error: #{e}"
  e2 = os.stat(path).err.unwrap
  assert e2.path_error? && os.is_not_exist(e2) && e2.path == path, "got error: #{e2}"
}

SECOND = 1_000_000_000

def test_chtimes(name: Str) {
  pre = os.stat(name).unwrap
  at = pre.access_time
  mt = pre.mod_time
  os.chtimes(name, at - SECOND, mt - SECOND).unwrap
  post = os.stat(name).unwrap
  assert post.access_time < at, "AccessTime didn't go backwards; was=#{at}, after=#{post.access_time}"
  assert post.mod_time < mt, "ModTime didn't go backwards; was=#{mt}, after=#{post.mod_time}"
}

test "Chtimes" { |t|
  f = new_file(t)
  f.close!.unwrap
  test_chtimes(f.name)
}

def test_chtimes_omit(t: testing.T, omit_at: Bool, omit_mt: Bool) {
  file = new_file(t)
  name = file.name
  file.close!.unwrap
  fs = os.stat(name).unwrap
  want_atime = fs.access_time
  want_mtime = fs.mod_time
  set_atime: Int? = none
  set_mtime: Int? = none
  if !omit_at {
    want_atime -= SECOND
    set_atime = want_atime
  }
  if !omit_mt {
    want_mtime -= SECOND
    set_mtime = want_mtime
  }
  os.chtimes(name, set_atime, set_mtime).unwrap
  fs2 = os.stat(name).unwrap
  assert_eq fs2.access_time, want_atime
  assert_eq fs2.mod_time, want_mtime
}

test "ChtimesOmit" { |t|
  test_chtimes_omit(t, true, false)
  test_chtimes_omit(t, false, true)
  test_chtimes_omit(t, true, true)
  test_chtimes_omit(t, false, false)
}

test "ChtimesDir" { |t|
  test_chtimes(t.temp_dir)
}

test "ChtimesToUnixZero" { |t|
  file = new_file(t)
  file.write!("hi".bytes.to_a).unwrap
  file.close!.unwrap
  os.chtimes(file.name, 0, 0).unwrap
  assert_eq os.stat(file.name).unwrap.mod_time, 0
}

test "FileChdir" { |t|
  wd = os.getwd.unwrap
  t.chdir(".") # Ensure wd is restored after the test.
  fd = os.open(".").unwrap
  os.chdir("/").unwrap
  fd.chdir!.unwrap
  wd_new = os.getwd.unwrap
  wd_info = fd.stat.unwrap
  new_info = os.stat(wd_new).unwrap
  assert os.same_file(wd_info, new_info), "fd.Chdir failed: got #{wd_new}, want #{wd}"
  fd.close!.unwrap
}

# The directory's path with symlinks resolved (filepath.EvalSymlinks).
def real_path(d: Str) -> Str {
  wd = os.getwd.unwrap
  os.chdir(d).unwrap
  r = os.getwd.unwrap
  os.chdir(wd).unwrap
  r
}

# Go chdirs to "/", "/usr/bin" and "/tmp"; "/" and two temp dirs (symlinks
# resolved, as on Go's ios/windows) here.
test "ChdirAndGetwd" { |t|
  t.chdir(t.temp_dir)
  dirs = ["/", real_path(t.temp_dir), real_path(t.temp_dir)]
  for mode in 0...2 {
    for d in dirs {
      if mode == 0 {
        os.chdir(d).unwrap
      } else {
        fd1 = os.open(d).unwrap
        fd1.chdir!.unwrap
        fd1.close!.unwrap
      }
      assert_eq os.getwd.unwrap, d
    }
  }
}

test "ProgWideChdir" { |t|
  d = t.temp_dir
  t.chdir(d)
  hold = Chan[Int].new(0)
  os.chdir(d).unwrap
  want = os.getwd.unwrap
  tasks: [Task[Int]] = []
  for _i in 0...10 {
    h = hold
    w = want
    tasks << spawn {
      h.recv
      f0 = os.stat(".").unwrap
      pwd = os.getwd.unwrap
      assert_eq pwd, w
      f1 = os.stat(pwd).unwrap
      assert os.same_file(f0, f1), "Samefile(Stat(\".\"), Getwd()) reports false"
      0
    }
  }
  hold.close
  for tk in tasks { tk.wait.unwrap }
}

test "Seek" { |t|
  f = new_file(t)
  data = "hello, world\n"
  f.write_string!(data).unwrap
  tests = [
    [0, io.SEEK_CURRENT, data.size],
    [0, io.SEEK_START, 0],
    [5, io.SEEK_START, 5],
    [0, io.SEEK_END, data.size],
    [0, io.SEEK_START, 0],
    [-1, io.SEEK_END, data.size - 1],
    [1 << 33, io.SEEK_START, 1 << 33],
    [1 << 33, io.SEEK_END, (1 << 33) + data.size],
    [(1 << 32) - 1, io.SEEK_START, (1 << 32) - 1],
    [0, io.SEEK_CURRENT, (1 << 32) - 1],
    [(2 << 32) - 1, io.SEEK_START, (2 << 32) - 1],
    [0, io.SEEK_CURRENT, (2 << 32) - 1],
  ]
  for i in 0...tests.size {
    tt = tests[i]
    off = f.seek!(tt[0], tt[1]).unwrap
    assert off == tt[2], "##{i}: Seek(#{tt[0]}, #{tt[1]}) = #{off} want #{tt[2]}"
  }
}

test "SeekError" {
  r, w = os.pipe.unwrap
  e = r.seek!(0, 0).err.unwrap
  assert e.path_error? && e.failure.err == "illegal seek", "Seek returned error #{e}, want ESPIPE"
  e2 = w.seek!(0, 0).err.unwrap
  assert e2.path_error? && e2.failure.err == "illegal seek", "Seek returned error #{e2}, want ESPIPE"
  r.close!.unwrap
  w.close!.unwrap
}

# Go's makefs: files, and directories for names ending in "/".
def makefs(t: testing.T, names: [Str]) -> Str {
  dir = t.temp_dir
  for n in names {
    parts = n.split(" => ")
    if parts.size == 2 {
      os.mkdir_all(filepath.dir(dir + "/" + parts[0]), 0o777).unwrap
      os.symlink(parts[1], dir + "/" + parts[0]).unwrap
    } elsif n.end_with?("/") {
      os.mkdir_all(dir + "/" + n, 0o777).unwrap
    } else {
      os.mkdir_all(filepath.dir(dir + "/" + n), 0o777).unwrap
      os.write_file(dir + "/" + n, [], 0o666).unwrap
    }
  }
  dir
}

test "OpenError" { |t|
  dir = makefs(t, ["is-a-file", "is-a-dir/"])
  cases = [("no-such-file", os.O_RDONLY, "no such file or directory"), ("is-a-dir", os.O_WRONLY, "is a directory"), ("is-a-file/no-such-file", os.O_WRONLY, "not a directory")]
  for tt in cases {
    path = dir + "/" + tt[0]
    r = os.open_file(path, tt[1], 0)
    if r.ok? {
      t.error("OpenFile(#{path}, #{tt[1]}) succeeded")
      next
    }
    e = r.err.unwrap
    assert e.path_error?
    assert_eq e.failure.err, tt[2]
  }
}

test "OpenNoName" {
  assert os.open("").err?, "Open(\"\") succeeded"
}

def run_bin_hostname(t: testing.T) -> Str {
  r, w = os.pipe.unwrap
  path = exec.look_path("hostname")
  t.skip("skipping test; test requires hostname but it does not exist") if path.err?
  files: [os.File?] = [none, w, os.stderr]
  p = os.start_process(path.unwrap, ["hostname"], os.ProcAttr.new(dir: "", env: none, files: files)).unwrap
  w.close!.unwrap
  out = Str.from_bytes(io.read_all(r).unwrap)
  r.close!.unwrap
  p.wait!.unwrap
  assert p.kill.err?, "expected an error from Kill running 'hostname'"
  out = out[0...out.size - 1] if out.end_with?("\n")
  t.fatal("/bin/hostname produced no output") if out == ""
  out
}

test "Hostname" { |t|
  hostname = os.hostname.unwrap
  t.fatal("Hostname returned empty string and no error") if hostname == ""
  assert !hostname.bytes.to_a.include?(0), "unexpected zero byte in hostname"
  want = run_bin_hostname(t)
  if hostname != want {
    host = hostname.split(".")[0]
    assert host == want, "Hostname() = #{hostname}, want #{want}"
  }
}

test "ReadAt" { |t|
  f = new_file(t)
  f.write_string!("hello, world\n").unwrap
  b: [Byte] = [0; 5]
  assert_eq f.read_at(b, 7).unwrap, 5
  assert_eq Str.from_bytes(b), "world"
}

test "ReadAtOffset" { |t|
  f = new_file(t)
  f.write_string!("hello, world\n").unwrap
  f.seek!(0, 0).unwrap
  b: [Byte] = [0; 5]
  assert_eq f.read_at(b, 7).unwrap, 5
  assert_eq Str.from_bytes(b), "world"
  assert_eq f.read!(b).unwrap, 5
  assert_eq Str.from_bytes(b), "hello"
}

test "ReadAtNegativeOffset" { |t|
  f = new_file(t)
  f.write_string!("hello, world\n").unwrap
  f.seek!(0, 0).unwrap
  b: [Byte] = [0; 5]
  e = f.read_at(b, -10).err.unwrap
  assert e.message.include?("negative offset"), "ReadAt(-10) = #{e}"
}

test "WriteAt" { |t|
  f = new_file(t)
  f.write_string!("hello, world").unwrap
  assert_eq f.write_at("WOR".bytes.to_a, 7).unwrap, 3
  assert_eq f.write_string!("!").unwrap, 1 # WriteAt doesn't change the file offset
  assert_eq os.read_file_string(f.name).unwrap, "hello, WORld!"
}

test "WriteAtConcurrent" { |t|
  f = new_file(t)
  f.write_string!("0000000000").unwrap
  tasks: [Task[Int]] = []
  for i in 0...10 {
    g = f.dup
    tasks << spawn {
      assert_eq g.write_at(i.to_s.bytes.to_a, i).unwrap, 1
      assert_eq g.write_string!("!").unwrap, 1
      0
    }
  }
  for tk in tasks { tk.wait.unwrap }
  assert_eq os.read_file_string(f.name).unwrap, "0123456789!!!!!!!!!!"
}

test "WriteAtNegativeOffset" { |t|
  f = new_file(t)
  e = f.write_at("WORLD".bytes.to_a, -10).err.unwrap
  assert e.message.include?("negative offset"), "WriteAt(-10) = #{e}"
}

test "WriteAtInAppendMode" { |t|
  t.chdir(t.temp_dir)
  f = os.open_file("write_at_in_append_mode.txt", os.O_APPEND | os.O_CREATE, 0o666).unwrap
  e = f.write_at([], 1).err.unwrap
  assert_eq e.errno, os.ERR_WRITE_AT_APPEND
  assert_eq e.message, "os: invalid use of WriteAt on file opened with O_APPEND"
  f.close!.unwrap
}

def write_file_flag(fname: Str, flag: Int, text: Str) -> Str {
  f = os.open_file(fname, flag, 0o666).unwrap
  f.write_string!(text).unwrap
  f.close!.unwrap
  os.read_file_string(fname).unwrap
}

test "Append" { |t|
  t.chdir(t.temp_dir)
  f = "append.txt"
  assert_eq write_file_flag(f, os.O_CREATE | os.O_TRUNC | os.O_RDWR, "new"), "new"
  assert_eq write_file_flag(f, os.O_APPEND | os.O_RDWR, "|append"), "new|append"
  assert_eq write_file_flag(f, os.O_CREATE | os.O_APPEND | os.O_RDWR, "|append"), "new|append|append"
  os.remove(f).unwrap
  assert_eq write_file_flag(f, os.O_CREATE | os.O_APPEND | os.O_RDWR, "new&append"), "new&append"
  assert_eq write_file_flag(f, os.O_CREATE | os.O_RDWR, "old"), "old&append"
  assert_eq write_file_flag(f, os.O_CREATE | os.O_TRUNC | os.O_RDWR, "new"), "new"
}

test "FilePermissions" { |pt|
  pt.skip("skipping test when running as root") if os.getuid == 0
  for tc in [("r", 0o444), ("w", 0o222), ("rw", 0o666)] {
    pt.run(tc[0]) { |t|
      mode = tc[1]
      t.chdir(t.temp_dir)
      filename = "f"
      f = os.open_file(filename, os.O_RDWR | os.O_CREATE | os.O_EXCL, mode).unwrap
      f.close!.unwrap
      b = os.read_file(filename)
      if (mode & 0o444) != 0 {
        assert b.ok?, "ReadFile = #{b.err}; want success"
      } else {
        assert b.err?, "ReadFile succeeded; want failure"
      }
      os.stat(filename).unwrap
      w = os.write_file(filename, [], 0o666)
      if (mode & 0o222) != 0 {
        assert w.ok?, "WriteFile = #{w.err}; want success"
      } else {
        assert w.err?, "WriteFile(#{filename}) = <nil>; want failure"
      }
    }
  }
}

test "OpenFileCreateExclDanglingSymlink" { |t|
  t.chdir(t.temp_dir)
  link = "link"
  os.symlink("does_not_exist", link).unwrap
  r = os.open_file(link, os.O_WRONLY | os.O_CREATE | os.O_EXCL, 0o444)
  assert r.err? && os.is_exist(r.err.unwrap), "OpenFile of a dangling symlink with O_CREATE|O_EXCL = #{r.err}, want ErrExist"
  assert os.stat(link).err?, "OpenFile of a dangling symlink with O_CREATE|O_EXCL created a file"
}

test "FileRDWRFlags" { |pt|
  for tc in [("O_RDONLY", os.O_RDONLY), ("O_WRONLY", os.O_WRONLY), ("O_RDWR", os.O_RDWR)] {
    pt.run(tc[0]) { |t|
      flag = tc[1]
      t.chdir(t.temp_dir)
      filename = "f"
      os.write_file(filename, "content".bytes, 0o666).unwrap
      f = os.open_file(filename, flag, 0).unwrap
      got = io.read_all(f)
      if flag == os.O_WRONLY {
        assert got.err?, "read file: want error"
      } else {
        assert_eq Str.from_bytes(got.unwrap), "content"
      }
      f.seek!(0, 0).unwrap
      w = f.write!("CONTENT".bytes.to_a)
      if flag == os.O_RDONLY {
        assert w.err?, "write file: succeeded, want error"
      } else {
        assert w.ok?, "write file: #{w.err}, want success"
      }
      f.close!.unwrap
      want = flag == os.O_RDONLY ? "content" : "CONTENT"
      assert_eq os.read_file_string(filename).unwrap, want
    }
  }
}

