#![test(external)]
# Go's os/tempfile_test.go, translated.

import "os"
import "path/filepath"
import "regexp"

test "CreateTemp" { |t|
  nonexistent = t.temp_dir + "/_not_exists_"
  r = os.create_temp(nonexistent, "foo")
  assert r.err?, "CreateTemp(#{nonexistent}, `foo`) succeeded"
}

test "CreateTempPattern" {
  for tc in [("tempfile_test", "tempfile_test", ""), ("tempfile_test*", "tempfile_test", ""), ("tempfile_test*xyz", "tempfile_test", "xyz")] {
    f = os.create_temp("", tc[0]).unwrap
    base = filepath.base(f.name)
    f.close!.unwrap
    os.remove(f.name).unwrap
    assert base.start_with?(tc[1]) && base.end_with?(tc[2]), "CreateTemp pattern #{tc[0]} created bad name #{base}; want prefix #{tc[1]} & suffix #{tc[2]}"
  }
}

def bad_patterns -> [(Str, Bool)] {
  sep = os.PATH_SEPARATOR
  [
    ("ioutil*test", false),
    ("tempfile_test*foo", false),
    ("tempfile_test" + sep + "foo", true),
    ("tempfile_test*" + sep + "foo", true),
    ("tempfile_test" + sep + "*foo", true),
    (sep + "tempfile_test" + sep + "*foo", true),
    ("tempfile_test*foo" + sep, true),
  ]
}

test "CreateTempBadPattern" { |pt|
  tmp_dir = pt.temp_dir
  for tt in bad_patterns {
    pt.run(tt[0]) { |t|
      r = os.create_temp(tmp_dir, tt[0])
      if tt[1] {
        t.fatal("CreateTemp(..., #{tt[0]}) succeeded, expected error") if r.ok?
        e = r.err.unwrap
        assert e.errno == os.ERR_PATTERN_SEP, "CreateTemp(..., #{tt[0]}): #{e}, expected ErrPatternHasSeparator"
      } else {
        assert r.ok?, "CreateTemp(..., #{tt[0]}): #{r.err}"
        f = r.unwrap
        f.close!.unwrap
      }
    }
  }
}

test "MkdirTemp" { |pt|
  r = os.mkdir_temp("/_not_exists_", "foo")
  assert r.err?, "MkdirTemp(`/_not_exists_`, `foo`) succeeded"
  dir = filepath.clean(os.temp_dir)
  run = ->(t: testing.T, pattern: Str, want: Str) -> Unit {
    name = os.mkdir_temp(dir, pattern).unwrap
    re = regexp.must_compile(want)
    ok = re.match_string?(name)
    os.remove(name).unwrap
    t.error("MkdirTemp(#{dir}, #{pattern}) created bad name #{name} did not match pattern #{want}") if !ok
  }
  for tc in [("tempfile_test", "tempfile_test", ""), ("tempfile_test*", "tempfile_test", ""), ("tempfile_test*xyz", "tempfile_test", "xyz")] {
    pt.run(tc[0]) { |t|
      want = "^" + regexp.quote_meta(filepath.join([dir, tc[1]])) + "[0-9]+" + regexp.quote_meta(tc[2]) + "$"
      run.call(t, tc[0], want)
    }
  }
  pt.run("*xyz") { |t|
    want = "^" + regexp.quote_meta(dir) + regexp.quote_meta("/") + "[0-9]+xyz$"
    run.call(t, "*xyz", want)
  }
}

test "MkdirTempBadDir" { |t|
  bad_dir = t.temp_dir + "/not-exist"
  e = os.mkdir_temp(bad_dir, "foo").err.unwrap
  assert e.path_error? && os.is_not_exist(e) && e.path == bad_dir, "TempDir error = #{e}; want PathError for path #{bad_dir} satisfying IsNotExist"
}

test "MkdirTempBadPattern" { |pt|
  tmp_dir = pt.temp_dir
  for tt in bad_patterns {
    pt.run(tt[0]) { |t|
      r = os.mkdir_temp(tmp_dir, tt[0])
      if tt[1] {
        t.fatal("MkdirTemp(..., #{tt[0]}) succeeded, expected error") if r.ok?
        e = r.err.unwrap
        assert e.errno == os.ERR_PATTERN_SEP, "MkdirTemp(..., #{tt[0]}): #{e}, expected ErrPatternHasSeparator"
      } else {
        assert r.ok?, "MkdirTemp(..., #{tt[0]}): #{r.err}"
      }
    }
  }
}
