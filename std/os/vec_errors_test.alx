# Generated from Go's os and syscall (PathError, LinkError, SyscallError, Errno and Signal texts on darwin) by a throwaway program; do not edit by hand.

# errno texts: Go's syscall table for darwin (alx uses C's strerror, so
# the platform's own; the table is checked on macOS only).
test "errno messages (darwin)" {
  return if !darwin?
  assert_eq errno_message(c("E2BIG")), "argument list too long"
  assert_eq errno_message(c("EACCES")), "permission denied"
  assert_eq errno_message(c("EADDRINUSE")), "address already in use"
  assert_eq errno_message(c("EAGAIN")), "resource temporarily unavailable"
  assert_eq errno_message(c("EBADF")), "bad file descriptor"
  assert_eq errno_message(c("EBUSY")), "resource busy"
  assert_eq errno_message(c("ECHILD")), "no child processes"
  assert_eq errno_message(c("ECONNREFUSED")), "connection refused"
  assert_eq errno_message(c("ECONNRESET")), "connection reset by peer"
  assert_eq errno_message(c("EDOM")), "numerical argument out of domain"
  assert_eq errno_message(c("EEXIST")), "file exists"
  assert_eq errno_message(c("EFAULT")), "bad address"
  assert_eq errno_message(c("EFBIG")), "file too large"
  assert_eq errno_message(c("EINTR")), "interrupted system call"
  assert_eq errno_message(c("EINVAL")), "invalid argument"
  assert_eq errno_message(c("EIO")), "input/output error"
  assert_eq errno_message(c("EISDIR")), "is a directory"
  assert_eq errno_message(c("ELOOP")), "too many levels of symbolic links"
  assert_eq errno_message(c("EMFILE")), "too many open files"
  assert_eq errno_message(c("EMLINK")), "too many links"
  assert_eq errno_message(c("ENAMETOOLONG")), "file name too long"
  assert_eq errno_message(c("ENFILE")), "too many open files in system"
  assert_eq errno_message(c("ENODEV")), "operation not supported by device"
  assert_eq errno_message(c("ENOENT")), "no such file or directory"
  assert_eq errno_message(c("ENOEXEC")), "exec format error"
  assert_eq errno_message(c("ENOMEM")), "cannot allocate memory"
  assert_eq errno_message(c("ENOSPC")), "no space left on device"
  assert_eq errno_message(c("ENOSYS")), "function not implemented"
  assert_eq errno_message(c("ENOTDIR")), "not a directory"
  assert_eq errno_message(c("ENOTEMPTY")), "directory not empty"
  assert_eq errno_message(c("ENOTSUP")), "operation not supported"
  assert_eq errno_message(c("ENOTTY")), "inappropriate ioctl for device"
  assert_eq errno_message(c("ENXIO")), "device not configured"
  assert_eq errno_message(c("EPERM")), "operation not permitted"
  assert_eq errno_message(c("EPIPE")), "broken pipe"
  assert_eq errno_message(c("ERANGE")), "result too large"
  assert_eq errno_message(c("EROFS")), "read-only file system"
  assert_eq errno_message(c("ESPIPE")), "illegal seek"
  assert_eq errno_message(c("ESRCH")), "no such process"
  assert_eq errno_message(c("ETIMEDOUT")), "operation timed out"
  assert_eq errno_message(c("ETXTBSY")), "text file busy"
  assert_eq errno_message(c("EXDEV")), "cross-device link"
}

test "error types (darwin)" {
  return if !darwin?
  assert_eq fs_error("open", "/a/b", c("E2BIG")).message, "open /a/b: argument list too long"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("E2BIG")).message, "rename /a/b /a/b.new: argument list too long"
  assert_eq new_syscall_error("getwd", c("E2BIG")).message, "getwd: argument list too long"
  assert_eq fs_error("stat", "x", c("EACCES")).message, "stat x: permission denied"
  assert_eq link_error("rename", "x", "x.new", c("EACCES")).message, "rename x x.new: permission denied"
  assert_eq new_syscall_error("getwd", c("EACCES")).message, "getwd: permission denied"
  assert_eq fs_error("lstat", "z", c("EADDRINUSE")).message, "lstat z: address already in use"
  assert_eq link_error("rename", "z", "z.new", c("EADDRINUSE")).message, "rename z z.new: address already in use"
  assert_eq new_syscall_error("getwd", c("EADDRINUSE")).message, "getwd: address already in use"
  assert_eq fs_error("mkdir", "dir/with space", c("EAGAIN")).message, "mkdir dir/with space: resource temporarily unavailable"
  assert_eq link_error("rename", "dir/with space", "dir/with space.new", c("EAGAIN")).message, "rename dir/with space dir/with space.new: resource temporarily unavailable"
  assert_eq new_syscall_error("getwd", c("EAGAIN")).message, "getwd: resource temporarily unavailable"
  assert_eq fs_error("remove", "/a/b", c("EBADF")).message, "remove /a/b: bad file descriptor"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("EBADF")).message, "rename /a/b /a/b.new: bad file descriptor"
  assert_eq new_syscall_error("getwd", c("EBADF")).message, "getwd: bad file descriptor"
  assert_eq fs_error("chdir", "x", c("EBUSY")).message, "chdir x: resource busy"
  assert_eq link_error("rename", "x", "x.new", c("EBUSY")).message, "rename x x.new: resource busy"
  assert_eq new_syscall_error("getwd", c("EBUSY")).message, "getwd: resource busy"
  assert_eq fs_error("readlink", "z", c("ECHILD")).message, "readlink z: no child processes"
  assert_eq link_error("rename", "z", "z.new", c("ECHILD")).message, "rename z z.new: no child processes"
  assert_eq new_syscall_error("getwd", c("ECHILD")).message, "getwd: no child processes"
  assert_eq fs_error("unlinkat", "dir/with space", c("ECONNREFUSED")).message, "unlinkat dir/with space: connection refused"
  assert_eq link_error("rename", "dir/with space", "dir/with space.new", c("ECONNREFUSED")).message, "rename dir/with space dir/with space.new: connection refused"
  assert_eq new_syscall_error("getwd", c("ECONNREFUSED")).message, "getwd: connection refused"
  assert_eq fs_error("fork/exec", "/a/b", c("ECONNRESET")).message, "fork/exec /a/b: connection reset by peer"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("ECONNRESET")).message, "rename /a/b /a/b.new: connection reset by peer"
  assert_eq new_syscall_error("getwd", c("ECONNRESET")).message, "getwd: connection reset by peer"
  assert_eq fs_error("open", "x", c("EDOM")).message, "open x: numerical argument out of domain"
  assert_eq link_error("rename", "x", "x.new", c("EDOM")).message, "rename x x.new: numerical argument out of domain"
  assert_eq new_syscall_error("getwd", c("EDOM")).message, "getwd: numerical argument out of domain"
  assert_eq fs_error("stat", "z", c("EEXIST")).message, "stat z: file exists"
  assert_eq link_error("rename", "z", "z.new", c("EEXIST")).message, "rename z z.new: file exists"
  assert_eq new_syscall_error("getwd", c("EEXIST")).message, "getwd: file exists"
  assert_eq fs_error("lstat", "dir/with space", c("EFAULT")).message, "lstat dir/with space: bad address"
  assert_eq link_error("rename", "dir/with space", "dir/with space.new", c("EFAULT")).message, "rename dir/with space dir/with space.new: bad address"
  assert_eq new_syscall_error("getwd", c("EFAULT")).message, "getwd: bad address"
  assert_eq fs_error("mkdir", "/a/b", c("EFBIG")).message, "mkdir /a/b: file too large"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("EFBIG")).message, "rename /a/b /a/b.new: file too large"
  assert_eq new_syscall_error("getwd", c("EFBIG")).message, "getwd: file too large"
  assert_eq fs_error("remove", "x", c("EINTR")).message, "remove x: interrupted system call"
  assert_eq link_error("rename", "x", "x.new", c("EINTR")).message, "rename x x.new: interrupted system call"
  assert_eq new_syscall_error("getwd", c("EINTR")).message, "getwd: interrupted system call"
  assert_eq fs_error("chdir", "z", c("EINVAL")).message, "chdir z: invalid argument"
  assert_eq link_error("rename", "z", "z.new", c("EINVAL")).message, "rename z z.new: invalid argument"
  assert_eq new_syscall_error("getwd", c("EINVAL")).message, "getwd: invalid argument"
  assert_eq fs_error("readlink", "dir/with space", c("EIO")).message, "readlink dir/with space: input/output error"
  assert_eq link_error("rename", "dir/with space", "dir/with space.new", c("EIO")).message, "rename dir/with space dir/with space.new: input/output error"
  assert_eq new_syscall_error("getwd", c("EIO")).message, "getwd: input/output error"
  assert_eq fs_error("unlinkat", "/a/b", c("EISDIR")).message, "unlinkat /a/b: is a directory"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("EISDIR")).message, "rename /a/b /a/b.new: is a directory"
  assert_eq new_syscall_error("getwd", c("EISDIR")).message, "getwd: is a directory"
  assert_eq fs_error("fork/exec", "x", c("ELOOP")).message, "fork/exec x: too many levels of symbolic links"
  assert_eq link_error("rename", "x", "x.new", c("ELOOP")).message, "rename x x.new: too many levels of symbolic links"
  assert_eq new_syscall_error("getwd", c("ELOOP")).message, "getwd: too many levels of symbolic links"
  assert_eq fs_error("open", "z", c("EMFILE")).message, "open z: too many open files"
  assert_eq link_error("rename", "z", "z.new", c("EMFILE")).message, "rename z z.new: too many open files"
  assert_eq new_syscall_error("getwd", c("EMFILE")).message, "getwd: too many open files"
  assert_eq fs_error("stat", "dir/with space", c("EMLINK")).message, "stat dir/with space: too many links"
  assert_eq link_error("rename", "dir/with space", "dir/with space.new", c("EMLINK")).message, "rename dir/with space dir/with space.new: too many links"
  assert_eq new_syscall_error("getwd", c("EMLINK")).message, "getwd: too many links"
  assert_eq fs_error("lstat", "/a/b", c("ENAMETOOLONG")).message, "lstat /a/b: file name too long"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("ENAMETOOLONG")).message, "rename /a/b /a/b.new: file name too long"
  assert_eq new_syscall_error("getwd", c("ENAMETOOLONG")).message, "getwd: file name too long"
  assert_eq fs_error("mkdir", "x", c("ENFILE")).message, "mkdir x: too many open files in system"
  assert_eq link_error("rename", "x", "x.new", c("ENFILE")).message, "rename x x.new: too many open files in system"
  assert_eq new_syscall_error("getwd", c("ENFILE")).message, "getwd: too many open files in system"
  assert_eq fs_error("remove", "z", c("ENODEV")).message, "remove z: operation not supported by device"
  assert_eq link_error("rename", "z", "z.new", c("ENODEV")).message, "rename z z.new: operation not supported by device"
  assert_eq new_syscall_error("getwd", c("ENODEV")).message, "getwd: operation not supported by device"
  assert_eq fs_error("chdir", "dir/with space", c("ENOENT")).message, "chdir dir/with space: no such file or directory"
  assert_eq link_error("rename", "dir/with space", "dir/with space.new", c("ENOENT")).message, "rename dir/with space dir/with space.new: no such file or directory"
  assert_eq new_syscall_error("getwd", c("ENOENT")).message, "getwd: no such file or directory"
  assert_eq fs_error("readlink", "/a/b", c("ENOEXEC")).message, "readlink /a/b: exec format error"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("ENOEXEC")).message, "rename /a/b /a/b.new: exec format error"
  assert_eq new_syscall_error("getwd", c("ENOEXEC")).message, "getwd: exec format error"
  assert_eq fs_error("unlinkat", "x", c("ENOMEM")).message, "unlinkat x: cannot allocate memory"
  assert_eq link_error("rename", "x", "x.new", c("ENOMEM")).message, "rename x x.new: cannot allocate memory"
  assert_eq new_syscall_error("getwd", c("ENOMEM")).message, "getwd: cannot allocate memory"
  assert_eq fs_error("fork/exec", "z", c("ENOSPC")).message, "fork/exec z: no space left on device"
  assert_eq link_error("rename", "z", "z.new", c("ENOSPC")).message, "rename z z.new: no space left on device"
  assert_eq new_syscall_error("getwd", c("ENOSPC")).message, "getwd: no space left on device"
  assert_eq fs_error("open", "dir/with space", c("ENOSYS")).message, "open dir/with space: function not implemented"
  assert_eq link_error("rename", "dir/with space", "dir/with space.new", c("ENOSYS")).message, "rename dir/with space dir/with space.new: function not implemented"
  assert_eq new_syscall_error("getwd", c("ENOSYS")).message, "getwd: function not implemented"
  assert_eq fs_error("stat", "/a/b", c("ENOTDIR")).message, "stat /a/b: not a directory"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("ENOTDIR")).message, "rename /a/b /a/b.new: not a directory"
  assert_eq new_syscall_error("getwd", c("ENOTDIR")).message, "getwd: not a directory"
  assert_eq fs_error("lstat", "x", c("ENOTEMPTY")).message, "lstat x: directory not empty"
  assert_eq link_error("rename", "x", "x.new", c("ENOTEMPTY")).message, "rename x x.new: directory not empty"
  assert_eq new_syscall_error("getwd", c("ENOTEMPTY")).message, "getwd: directory not empty"
  assert_eq fs_error("mkdir", "z", c("ENOTSUP")).message, "mkdir z: operation not supported"
  assert_eq link_error("rename", "z", "z.new", c("ENOTSUP")).message, "rename z z.new: operation not supported"
  assert_eq new_syscall_error("getwd", c("ENOTSUP")).message, "getwd: operation not supported"
  assert_eq fs_error("remove", "dir/with space", c("ENOTTY")).message, "remove dir/with space: inappropriate ioctl for device"
  assert_eq link_error("rename", "dir/with space", "dir/with space.new", c("ENOTTY")).message, "rename dir/with space dir/with space.new: inappropriate ioctl for device"
  assert_eq new_syscall_error("getwd", c("ENOTTY")).message, "getwd: inappropriate ioctl for device"
  assert_eq fs_error("chdir", "/a/b", c("ENXIO")).message, "chdir /a/b: device not configured"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("ENXIO")).message, "rename /a/b /a/b.new: device not configured"
  assert_eq new_syscall_error("getwd", c("ENXIO")).message, "getwd: device not configured"
  assert_eq fs_error("readlink", "x", c("EPERM")).message, "readlink x: operation not permitted"
  assert_eq link_error("rename", "x", "x.new", c("EPERM")).message, "rename x x.new: operation not permitted"
  assert_eq new_syscall_error("getwd", c("EPERM")).message, "getwd: operation not permitted"
  assert_eq fs_error("unlinkat", "z", c("EPIPE")).message, "unlinkat z: broken pipe"
  assert_eq link_error("rename", "z", "z.new", c("EPIPE")).message, "rename z z.new: broken pipe"
  assert_eq new_syscall_error("getwd", c("EPIPE")).message, "getwd: broken pipe"
  assert_eq fs_error("fork/exec", "dir/with space", c("ERANGE")).message, "fork/exec dir/with space: result too large"
  assert_eq link_error("rename", "dir/with space", "dir/with space.new", c("ERANGE")).message, "rename dir/with space dir/with space.new: result too large"
  assert_eq new_syscall_error("getwd", c("ERANGE")).message, "getwd: result too large"
  assert_eq fs_error("open", "/a/b", c("EROFS")).message, "open /a/b: read-only file system"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("EROFS")).message, "rename /a/b /a/b.new: read-only file system"
  assert_eq new_syscall_error("getwd", c("EROFS")).message, "getwd: read-only file system"
  assert_eq fs_error("stat", "x", c("ESPIPE")).message, "stat x: illegal seek"
  assert_eq link_error("rename", "x", "x.new", c("ESPIPE")).message, "rename x x.new: illegal seek"
  assert_eq new_syscall_error("getwd", c("ESPIPE")).message, "getwd: illegal seek"
  assert_eq fs_error("lstat", "z", c("ESRCH")).message, "lstat z: no such process"
  assert_eq link_error("rename", "z", "z.new", c("ESRCH")).message, "rename z z.new: no such process"
  assert_eq new_syscall_error("getwd", c("ESRCH")).message, "getwd: no such process"
  assert_eq fs_error("mkdir", "dir/with space", c("ETIMEDOUT")).message, "mkdir dir/with space: operation timed out"
  assert_eq link_error("rename", "dir/with space", "dir/with space.new", c("ETIMEDOUT")).message, "rename dir/with space dir/with space.new: operation timed out"
  assert_eq new_syscall_error("getwd", c("ETIMEDOUT")).message, "getwd: operation timed out"
  assert_eq fs_error("remove", "/a/b", c("ETXTBSY")).message, "remove /a/b: text file busy"
  assert_eq link_error("rename", "/a/b", "/a/b.new", c("ETXTBSY")).message, "rename /a/b /a/b.new: text file busy"
  assert_eq new_syscall_error("getwd", c("ETXTBSY")).message, "getwd: text file busy"
  assert_eq fs_error("chdir", "x", c("EXDEV")).message, "chdir x: cross-device link"
  assert_eq link_error("rename", "x", "x.new", c("EXDEV")).message, "rename x x.new: cross-device link"
  assert_eq new_syscall_error("getwd", c("EXDEV")).message, "getwd: cross-device link"
}

test "signal names (darwin)" {
  return if !darwin?
  assert_eq signal_name(1), "hangup"
  assert_eq signal_name(2), "interrupt"
  assert_eq signal_name(3), "quit"
  assert_eq signal_name(4), "illegal instruction"
  assert_eq signal_name(5), "trace/BPT trap"
  assert_eq signal_name(6), "abort trap"
  assert_eq signal_name(7), "EMT trap"
  assert_eq signal_name(8), "floating point exception"
  assert_eq signal_name(9), "killed"
  assert_eq signal_name(10), "bus error"
  assert_eq signal_name(11), "segmentation fault"
  assert_eq signal_name(12), "bad system call"
  assert_eq signal_name(13), "broken pipe"
  assert_eq signal_name(14), "alarm clock"
  assert_eq signal_name(15), "terminated"
  assert_eq signal_name(16), "urgent I/O condition"
  assert_eq signal_name(17), "suspended (signal)"
  assert_eq signal_name(18), "suspended"
  assert_eq signal_name(19), "continued"
  assert_eq signal_name(20), "child exited"
  assert_eq signal_name(21), "stopped (tty input)"
  assert_eq signal_name(22), "stopped (tty output)"
  assert_eq signal_name(23), "I/O possible"
  assert_eq signal_name(24), "cputime limit exceeded"
  assert_eq signal_name(25), "filesize limit exceeded"
  assert_eq signal_name(26), "virtual timer expired"
  assert_eq signal_name(27), "profiling timer expired"
  assert_eq signal_name(28), "window size changes"
  assert_eq signal_name(29), "information request"
  assert_eq signal_name(30), "user defined signal 1"
  assert_eq signal_name(31), "user defined signal 2"
}

test "sentinel texts" {
  assert_eq errno_message(ERR_CLOSED), "file already closed"
  assert_eq errno_message(ERR_PROCESS_DONE), "os: process already finished"
  assert_eq errno_message(ERR_INVALID), "invalid argument"
  assert_eq errno_message(ERR_EXIST), "file already exists"
  assert_eq errno_message(ERR_NOT_EXIST), "file does not exist"
}
