  assert_eq expand("*$$*bx_") { |k| vmap(k) }, "*<$>*bx_"
  assert_eq expand(".?1}19") { |k| vmap(k) }, ".?1}19"
  assert_eq expand(". $!_x}9") { |k| vmap(k) }, ". <!>_x}9"
  assert_eq expand("}\#}_*emptyempty") { |k| vmap(k) }, "}\#}_*emptyempty"
  assert_eq expand("-\#") { |k| vmap(k) }, "-\#"
  assert_eq expand("a$a$@}@_$") { |k| vmap(k) }, "a<a><@>}@_$"
  assert_eq expand("\#$\#?9 $") { |k| vmap(k) }, "\#<\#>?9 $"
  assert_eq expand("$*") { |k| vmap(k) }, "<*>"
  assert_eq expand("}") { |k| vmap(k) }, "}"
  assert_eq expand("x-$$ }") { |k| vmap(k) }, "x-<$> }"
}

test "expand_env vectors" {
  setenv("ALX_VEC_A", "alpha").unwrap
  setenv("ALX_VEC_B", "").unwrap
  unsetenv("ALX_VEC_UNSET").unwrap
  assert_eq expand_env("$ALX_VEC_A"), "alpha"
  assert_eq expand_env("${ALX_VEC_A}x"), "alphax"
  assert_eq expand_env("$ALX_VEC_Ax"), ""
  assert_eq expand_env("[$ALX_VEC_B]"), "[]"
  assert_eq expand_env("[$ALX_VEC_UNSET]"), "[]"
  assert_eq expand_env("${ALX_VEC_A"), "ALX_VEC_A"
  assert_eq expand_env("$"), "$"
  assert_eq expand_env("$$ALX_VEC_A"), "ALX_VEC_A"
  assert_eq expand_env("a$ALX_VEC_A/$ALX_VEC_A"), "aalpha/alpha"
  assert_eq expand_env("${ALX_VEC_A}${ALX_VEC_B}${ALX_VEC_UNSET}"), "alpha"
  unsetenv("ALX_VEC_A").unwrap
  unsetenv("ALX_VEC_B").unwrap
}
