  assert_eq expand(" -$ \#- ") { |k| vmap(k) }, " -$ \#- "
  assert_eq expand("{!b") { |k| vmap(k) }, "{!b"
  assert_eq expand("$_a{") { |k| vmap(k) }, "<_a>{"
  assert_eq expand("${a$${b") { |k| vmap(k) }, "a<$>{b"
  assert_eq expand("") { |k| vmap(k) }, ""
  assert_eq expand("a") { |k| vmap(k) }, "a"
}

