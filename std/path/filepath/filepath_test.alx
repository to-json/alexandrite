#![test(external)]
# Go's path_test.go, match_test.go and the Unix examples (package
# filepath_test), translated. TestWalkFileError needs Go's export_test hook
# and is in walk_hook_test.alx. Not translated: the Windows and Plan 9 tables
# and tests (this port is Unix-only), TestGlobUNC, TestVolumeName and
# TestDriveLetterInEvalSymlinks (Windows-only), TestBug3486 (walks GOROOT),
# the allocation checks in TestClean, the benchmarks.

import "io/fs"
import "os"
import "path"
import "path/filepath"
import "slices"
import "strings"

#[track_caller]
def check[T](got: T, want: T, what: Str) {
  assert got == want, "#{what} = #{got}, want #{want} (at #{caller_location})"
}

# A fresh temporary directory (Go's t.TempDir); the caller removes it.
def temp_dir -> Str {
  os.mkdir_temp("", "alx-filepath-*").unwrap
}

def touch(name: Str) {
  f = os.create(name).unwrap
  f.close!.unwrap
}

# --------------------------------------------------------------- path_test.go

test "Clean" {
  tests = [
    # Already clean
    ["abc", "abc"],
    ["abc/def", "abc/def"],
    ["a/b/c", "a/b/c"],
    [".", "."],
    ["..", ".."],
    ["../..", "../.."],
    ["../../abc", "../../abc"],
    ["/abc", "/abc"],
    ["/", "/"],
    # Empty is current dir
    ["", "."],
    # Remove trailing slash
    ["abc/", "abc"],
    ["abc/def/", "abc/def"],
    ["a/b/c/", "a/b/c"],
    ["./", "."],
    ["../", ".."],
    ["../../", "../.."],
    ["/abc/", "/abc"],
    # Remove doubled slash
    ["abc//def//ghi", "abc/def/ghi"],
    ["abc//", "abc"],
    # Remove . elements
    ["abc/./def", "abc/def"],
    ["/./abc/def", "/abc/def"],
    ["abc/.", "abc"],
    # Remove .. elements
    ["abc/def/ghi/../jkl", "abc/def/jkl"],
    ["abc/def/../ghi/../jkl", "abc/jkl"],
    ["abc/def/..", "abc"],
    ["abc/def/../..", "."],
    ["/abc/def/../..", "/"],
    ["abc/def/../../..", ".."],
    ["/abc/def/../../..", "/"],
    ["abc/def/../../../ghi/jkl/../../../mno", "../../mno"],
    ["/../abc", "/abc"],
    ["a/../b:/../../c", "../c"],
    # Combinations
    ["abc/./../def", "def"],
    ["abc//./../def", "def"],
    ["abc/../../././../def", "../../def"],
    # nonwincleantests
    ["//abc", "/abc"],
    ["///abc", "/abc"],
    ["//abc//", "/abc"],
  ]
  for t in tests {
    check(filepath.clean(t[0]), t[1], "Clean(#{t[0]})")
    check(filepath.clean(t[1]), t[1], "Clean(#{t[1]})")
  }
}

test "IsLocal" {
  tests: [(Str, Bool)] = [
    ("", false),
    (".", true),
    ("..", false),
    ("../a", false),
    ("/", false),
    ("/a", false),
    ("/a/../..", false),
    ("a", true),
    ("a/../a", true),
    ("a/", true),
    ("a/.", true),
    ("a/./b/./c", true),
    ("a/../b:/../../c", false),
  ]
  for t in tests {
    check(filepath.local?(t[0]), t[1], "IsLocal(#{t[0]})")
  }
}

test "Localize" {
  tests = [
    ["", ""],
    [".", "."],
    ["..", ""],
    ["a/..", ""],
    ["/", ""],
    ["/a", ""],
    ["a" + Str.from_bytes([0xff]) + "b", ""],
    ["a/", ""],
    ["a/./b", ""],
    ["\0", ""],
    ["a", "a"],
    ["a/b/c", "a/b/c"],
    # unixlocalizetests
    ["\#a", "\#a"],
    ["a\\b:c", "a\\b:c"],
  ]
  for t in tests {
    r = filepath.localize(t[0])
    if e = r.err {
      check(t[1], "", "Localize(#{t[0]}) failed")
      check(e.message, "invalid path", "Localize(#{t[0]}) error")
    } else {
      check(r.unwrap, t[1], "Localize(#{t[0]})")
    }
  }
}

test "FromAndToSlash" {
  tests = [["", ""], ["/", "/"], ["/a/b", "/a/b"], ["a//b", "a//b"]]
  for t in tests {
    check(filepath.from_slash(t[0]), t[1], "FromSlash(#{t[0]})")
    check(filepath.to_slash(t[1]), t[0], "ToSlash(#{t[1]})")
  }
}

test "SplitList" {
  tests: [(Str, [Str])] = [("", []), ("a:b", ["a", "b"]), (":a:b", ["", "a", "b"])]
  for t in tests {
    check(filepath.split_list(t[0]), t[1], "SplitList(#{t[0]})")
  }
}

test "Split" {
  tests = [["a/b", "a/", "b"], ["a/b/", "a/b/", ""], ["a/", "a/", ""], ["a", "", "a"], ["/", "/", ""]]
  for t in tests {
    d, f = filepath.split(t[0])
    check(d, t[1], "Split(#{t[0]}) dir")
    check(f, t[2], "Split(#{t[0]}) file")
  }
}

test "Join" {
  tests: [([Str], Str)] = [
    # zero parameters
    ([], ""),
    # one parameter
    ([""], ""),
    (["/"], "/"),
    (["a"], "a"),
    # two parameters
    (["a", "b"], "a/b"),
    (["a", ""], "a"),
    (["", "b"], "b"),
    (["/", "a"], "/a"),
    (["/", "a/b"], "/a/b"),
    (["/", ""], "/"),
    (["/a", "b"], "/a/b"),
    (["a", "/b"], "a/b"),
    (["/a", "/b"], "/a/b"),
    (["a/", "b"], "a/b"),
    (["a/", ""], "a"),
    (["", ""], ""),
    # three parameters
    (["/", "a", "b"], "/a/b"),
    # nonwinjointests
    (["//", "a"], "/a"),
  ]
  for t in tests {
    check(filepath.join(t[0]), t[1], "Join(#{t[0]})")
  }
}

test "Ext" {
  tests = [["path.go", ".go"], ["path.pb.go", ".go"], ["a.dir/b", ""], ["a.dir/b.go", ".go"], ["a.dir/", ""]]
  for t in tests {
    check(filepath.ext(t[0]), t[1], "Ext(#{t[0]})")
  }
}

