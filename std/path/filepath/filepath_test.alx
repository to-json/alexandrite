test "IsAbs" {
  tests: [(Str, Bool)] = [
    ("", false),
    ("/", true),
    ("/usr/bin/gcc", true),
    ("..", false),
    ("/a/../bb", true),
    (".", false),
    ("./", false),
    ("lala", false),
