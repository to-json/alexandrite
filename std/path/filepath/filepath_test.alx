test "Rel" {
  tests = [
    ["a/b", "a/b", "."],
    ["a/b/.", "a/b", "."],
    ["a/b", "a/b/.", "."],
    ["./a/b", "a/b", "."],
    ["a/b", "./a/b", "."],
    ["ab/cd", "ab/cde", "../cde"],
    ["ab/cd", "ab/c", "../c"],
    ["a/b", "a/b/c/d", "c/d"],
    ["a/b", "a/b/../c", "../c"],
    ["a/b/../c", "a/b", "../b"],
    ["a/b/c", "a/c/d", "../../c/d"],
    ["a/b", "c/d", "../../c/d"],
    ["a/b/c/d", "a/b", "../.."],
    ["a/b/c/d", "a/b/", "../.."],
    ["a/b/c/d/", "a/b", "../.."],
    ["a/b/c/d/", "a/b/", "../.."],
    ["../../a/b", "../../a/b/c/d", "c/d"],
    ["/a/b", "/a/b", "."],
    ["/a/b/.", "/a/b", "."],
    ["/a/b", "/a/b/.", "."],
    ["/ab/cd", "/ab/cde", "../cde"],
    ["/ab/cd", "/ab/c", "../c"],
    ["/a/b", "/a/b/c/d", "c/d"],
    ["/a/b", "/a/b/../c", "../c"],
    ["/a/b/../c", "/a/b", "../b"],
    ["/a/b/c", "/a/c/d", "../../c/d"],
    ["/a/b", "/c/d", "../../c/d"],
    ["/a/b/c/d", "/a/b", "../.."],
    ["/a/b/c/d", "/a/b/", "../.."],
    ["/a/b/c/d/", "/a/b", "../.."],
    ["/a/b/c/d/", "/a/b/", "../.."],
    ["/../../a/b", "/../../a/b/c/d", "c/d"],
    [".", "a/b", "a/b"],
    [".", "..", ".."],
    ["", "../../.", "../.."],
    # can't do purely lexically
    ["..", ".", "err"],
    ["..", "a", "err"],
    ["../..", "..", "err"],
    ["a", "/a", "err"],
    ["/a", "a", "err"],
  ]
  for t in tests {
    r = filepath.rel(t[0], t[1])
    if t[2] == "err" {
      assert r.err?, "Rel(#{t[0]}, #{t[1]}) = #{r.ok || ""}, want error"
      check(r.err.unwrap.message, "Rel: can't make #{t[1]} relative to #{t[0]}", "Rel error")
    } else {
      check(r.unwrap, t[2], "Rel(#{t[0]}, #{t[1]})")
    }
  }
}

# --------------------------------------------------------------- Walk, WalkDir

# Go's tree: testdata/{a, b/, c, d/{x, y/, z/{u, v}}}; marks by (unique) name.
def tree_rows -> [(Str, Bool)] {
  [
    ("testdata", true),
    ("testdata/a", false),
    ("testdata/b", true),
    ("testdata/c", false),
    ("testdata/d", true),
    ("testdata/d/x", false),
    ("testdata/d/y", true),
    ("testdata/d/z", true),
    ("testdata/d/z/u", false),
    ("testdata/d/z/v", false),
  ]
}

def make_tree {
  for r in tree_rows() {
    if r[1] {
      os.mkdir(r[0], 0o770).unwrap
    } else {
      touch(r[0])
    }
  }
}

def zero_marks -> Map[Str, Int] {
  m: Map[Str, Int] = {}
  for r in tree_rows() {
    m[path.base(r[0])] = 0
  }
  m
}

# Go's markTree: a subtree's names, each marked once.
def mark_subtree(marks: Map[Str, Int], top: Str) {
  for r in tree_rows() {
    if r[0] == top || r[0].start_with?(top + "/") {
      b = path.base(r[0])
      marks[b] = (marks[b] || 0) + 1
    }
  }
}

#[track_caller]
def check_marks(marks: Map[Str, Int]) {
  for r in tree_rows() {
    b = path.base(r[0])
    assert_eq "#{r[0]} #{marks[b] || 0}", "#{r[0]} 1"
  }
}

# Go's testWalk, for Walk (err_visit 1) or WalkDir (err_visit 2).
def test_walk(use_walk_dir: Bool, err_visit: Int) {
  wd = os.getwd.unwrap
  td = temp_dir()
  os.chdir(td).unwrap
  defer {
    os.chdir(wd).unwrap
    os.remove_all(td).unwrap
  }
  make_tree()
  marks = zero_marks()
  errors: [Error] = []
  clear = true
  run = -> -> ~Unit {
    if use_walk_dir {
      ~filepath.walk_dir("testdata") { |_p, d, err|
        name = d?.name || ""
        marks[name] = (marks[name] || 0) + 1
        if e = err {
          errors << e
          fail e if !clear
        }
      }
    } else {
      ~filepath.walk("testdata") { |_p, info, err|
        name = info?.name || ""
        marks[name] = (marks[name] || 0) + 1
        if e = err {
          errors << e
          fail e if !clear
        }
      }
    }
  }
  # Expect no errors.
  run.call.unwrap
  assert_eq errors.size, 0
  check_marks(marks)
  marks = zero_marks()
  errors = []

  # PermErr: only possible if we're not root.
  return if os.getuid == 0
  # Introduce 2 errors: chmod top-level directories to 0.
  os.chmod("testdata/b", 0).unwrap
  os.chmod("testdata/d", 0).unwrap
  # Capture errors, expect two; mark the respective subtrees manually,
  # correcting the double-marking of the directory itself.
  mark_subtree(marks, "testdata/b")
  mark_subtree(marks, "testdata/d")
  marks["b"] = (marks["b"] || 0) - err_visit
  marks["d"] = (marks["d"] || 0) - err_visit
  run.call.unwrap
  assert_eq errors.size, 2
  check_marks(marks)
  marks = zero_marks()
  errors = []

  # Capture errors, stop after the first one.
  clear = false
  r = run.call
  assert r.err?, "expected an error from the walk"
  assert_eq errors.size, 1
  # Restore permissions.
  os.chmod("testdata/b", 0o770).unwrap
  os.chmod("testdata/d", 0o770).unwrap
}

test "Walk" {
  test_walk(false, 1)
}

test "WalkDir" {
  test_walk(true, 2)
}

test "WalkSkipDirOnFile" {
  td = temp_dir()
  defer { os.remove_all(td).unwrap }
  os.mkdir_all(filepath.join([td, "dir"]), 0o755).unwrap
  touch(filepath.join([td, "dir/foo1"]))
  touch(filepath.join([td, "dir/foo2"]))
  for root in [td, filepath.join([td, "dir"])] {
    saw_foo2 = false
    ~filepath.walk(root) { |p, _i, _e|
      saw_foo2 = true if p.end_with?("foo2")
      fail fs.FsError.SkipDir if p.end_with?("foo1")
    }
    assert !saw_foo2, "Walk: SkipDir on file foo1 did not block processing of foo2"
    saw_foo2 = false
    ~filepath.walk_dir(root) { |p, _d, _e|
      saw_foo2 = true if p.end_with?("foo2")
      fail fs.FsError.SkipDir if p.end_with?("foo1")
    }
    assert !saw_foo2, "WalkDir: SkipDir on file foo1 did not block processing of foo2"
  }
}

test "WalkSkipAllOnFile" {
  td = temp_dir()
  defer { os.remove_all(td).unwrap }
  os.mkdir_all(filepath.join([td, "dir", "subdir"]), 0o755).unwrap
  os.mkdir_all(filepath.join([td, "dir2"]), 0o755).unwrap
  touch(filepath.join([td, "dir", "foo1"]))
  touch(filepath.join([td, "dir", "foo2"]))
  touch(filepath.join([td, "dir", "subdir", "foo3"]))
  touch(filepath.join([td, "dir", "foo4"]))
  touch(filepath.join([td, "dir2", "bar"]))
  touch(filepath.join([td, "last"]))
  later = ["foo3", "foo4", "bar", "last"]
  for root in [td, filepath.join([td, "dir"])] {
    remaining_were_skipped = true
    ~filepath.walk(root) { |p, _i, _e|
      fail fs.FsError.SkipAll if p.end_with?("foo2")
      remaining_were_skipped = false if later.any? { p.end_with?(it) }
    }
    assert remaining_were_skipped, "Walk: SkipAll on file foo2 did not block processing of remaining files and directories"
    remaining_were_skipped = true
    ~filepath.walk_dir(root) { |p, _d, _e|
      fail fs.FsError.SkipAll if p.end_with?("foo2")
      remaining_were_skipped = false if later.any? { p.end_with?(it) }
    }
    assert remaining_were_skipped, "WalkDir: SkipAll on file foo2 did not block processing of remaining files and directories"
  }
}

test "WalkSymlinkRoot" {
  td = temp_dir()
  defer { os.remove_all(td).unwrap }
  d = filepath.join([td, "dir"])
  os.mkdir_all(d, 0o755).unwrap
  touch(filepath.join([d, "foo"]))
  link = filepath.join([td, "link"])
  os.symlink("dir", link).unwrap
  abslink = filepath.join([td, "abslink"])
  os.symlink(d, abslink).unwrap
  linklink = filepath.join([td, "linklink"])
  os.symlink("link", linklink).unwrap
  # Walk doesn't traverse symlinks itself: without a trailing slash it
  # reports the link; with one, the path resolves to the directory.
  tests: [(Str, Str, [Str], Bool)] = [
    ("no slash", link, [link], false),
    ("slash", link + "/", [link, filepath.join([link, "foo"])], false),
    ("abs no slash", abslink, [abslink], false),
    ("abs with slash", abslink + "/", [abslink, filepath.join([abslink, "foo"])], false),
    ("double link no slash", linklink, [linklink], false),
    # https://go.dev/issue/59586: buggy on darwin and ios.
    ("double link with slash", linklink + "/", [linklink, filepath.join([linklink, "foo"])], true),
  ]
  for t in tests {
    walked: [Str] = []
    ~filepath.walk(t[1]) { |p, _info, err|
      fail err.unwrap if err.some?
      walked << filepath.clean(p)
    }
    check(walked, t[2], t[0]) if !t[3] || !darwin?()
  }
}

def darwin? -> Bool {
  # macOS has /System; Go's runtime.GOOS == "darwin".
  os.stat("/System/Library").ok?
}

test "Issue51617" {
  td = temp_dir()
  defer {
    os.chmod(filepath.join([td, "a", "bad"]), 0o700)
    os.remove_all(td).unwrap
  }
  for sub in ["a", filepath.join(["a", "bad"]), filepath.join(["a", "next"])] {
    os.mkdir(filepath.join([td, sub]), 0o755).unwrap
  }
  bad = filepath.join([td, "a", "bad"])
  os.chmod(bad, 0).unwrap
  saw: [Str] = []
  ~filepath.walk_dir(td) { |p, d, err|
    fail fs.FsError.SkipDir if err.some?
    if e = d {
      saw << ~filepath.rel(td, p) if e.is_dir
    }
  }
  check(saw, [".", "a", filepath.join(["a", "bad"]), filepath.join(["a", "next"])], "directories")
}

test "WalkSymlink" {
  td = temp_dir()
  wd = os.getwd.unwrap
  os.chdir(td).unwrap
  defer {
    os.chdir(wd).unwrap
    os.remove_all(td).unwrap
  }
  os.symlink(td, "link").unwrap
  visited: [Str] = []
  ~filepath.walk(td) { |p, _info, err|
    fail err.unwrap if err.some?
    visited << ~filepath.rel(td, p)
  }
  slices.sort(visited)
  check(visited, [".", "link"], "visited")
}

# A walk whose root can't be lstat'ed calls f once, with no entry.
test "walk missing root" {
  td = temp_dir()
  defer { os.remove_all(td).unwrap }
  n = 0
  r = filepath.walk_dir(filepath.join([td, "nope"])) { |_p, d, err|
    n += 1
    assert d.none?, "no entry for a missing root"
    fail err.unwrap if err.some?
  }
  assert os.is_not_exist(r.err.unwrap), "walk_dir error"
  r2 = filepath.walk(filepath.join([td, "nope"])) { |_p, info, err|
    n += 1
    assert info.none?, "no info for a missing root"
    fail err.unwrap if err.some?
  }
  assert os.is_not_exist(r2.err.unwrap), "walk error"
  assert_eq n, 2
}

# ------------------------------------------------------------- EvalSymlinks

def eval_symlinks_test_dirs -> [[Str]] {
  [
    ["test", ""],
    ["test/dir", ""],
    ["test/dir/link3", "../../"],
    ["test/link1", "../test"],
    ["test/link2", "dir"],
    ["test/linkabs", "/"],
    ["test/link4", "../test2"],
    ["test2", "test/dir"],
    # Issue 23444.
    ["src", ""],
    ["src/pool", ""],
    ["src/pool/test", ""],
    ["src/versions", ""],
    ["src/versions/current", "../../version"],
    ["src/versions/v1", ""],
    ["src/versions/v1/modules", ""],
    ["src/versions/v1/modules/test", "../../../pool/test"],
    ["version", "src/versions/v1"],
  ]
}

def eval_symlinks_tests -> [[Str]] {
  [
    ["test", "test"],
    ["test/dir", "test/dir"],
    ["test/dir/../..", "."],
    ["test/link1", "test"],
    ["test/link2", "test/dir"],
    ["test/link1/dir", "test/dir"],
    ["test/link2/..", "test"],
    ["test/dir/link3", "."],
    ["test/link2/link3/test", "test"],
    ["test/linkabs", "/"],
    ["test/link4/..", "test"],
    ["src/versions/current/modules/test", "src/pool/test"],
  ]
}

# Joins without evaluating "..".
def simple_join(d: Str, p: Str) -> Str {
  d + "/" + p
}

#[track_caller]
def test_eval_symlinks(p: Str, want: Str) {
  r = filepath.eval_symlinks(p)
  if e = r.err {
    assert false, "EvalSymlinks(#{p}) error: #{e.message}"
  } else {
    check(filepath.clean(r.unwrap), filepath.clean(want), "EvalSymlinks(#{p})")
  }
}

#[track_caller]
def test_eval_symlinks_after_chdir(wd: Str, p: Str, want: Str) {
  old = os.getwd.unwrap
  os.chdir(wd).unwrap
  r = filepath.eval_symlinks(p)
  os.chdir(old).unwrap
  if e = r.err {
    assert false, "EvalSymlinks(#{p}) in #{wd} error: #{e.message}"
  } else {
    check(filepath.clean(r.unwrap), filepath.clean(want), "EvalSymlinks(#{p}) in #{wd}")
  }
}

test "EvalSymlinks" {
  td0 = temp_dir()
  defer { os.remove_all(td0).unwrap }
  # The temp dir may itself be a symlink (macOS: /var -> /private/var).
  td = ~filepath.eval_symlinks(td0)
  for d in eval_symlinks_test_dirs() {
    p = simple_join(td, d[0])
    if d[1] == "" {
      ~os.mkdir(p, 0o755)
    } else {
      ~os.symlink(d[1], p)
    }
  }
  for t in eval_symlinks_tests() {
    p = simple_join(td, t[0])
    dest = filepath.is_abs(t[1]) ? t[1] : simple_join(td, t[1])
    test_eval_symlinks(p, dest)
    # EvalSymlinks(".")
    test_eval_symlinks_after_chdir(p, ".", ".")
    # EvalSymlinks(".." + path)
    dotdot = filepath.is_abs(t[1]) ? t[1] : simple_join("..", t[1])
    test_eval_symlinks_after_chdir(simple_join(td, "test"), simple_join("..", t[0]), dotdot)
    # EvalSymlinks(p) where p is a relative path
    test_eval_symlinks_after_chdir(td, t[0], t[1])
  }
}

test "EvalSymlinksIsNotExist" {
  td = temp_dir()
  wd = os.getwd.unwrap
  os.chdir(td).unwrap
  defer {
    os.chdir(wd).unwrap
    os.remove_all(td).unwrap
  }
  r = filepath.eval_symlinks("notexist")
  assert os.is_not_exist(r.err.unwrap), "notexist"
  os.symlink("notexist", "link").unwrap
  r2 = filepath.eval_symlinks("link")
  assert os.is_not_exist(r2.err.unwrap), "link"
}

test "Issue13582" {
  td = temp_dir()
  defer { os.remove_all(td).unwrap }
  d = filepath.join([td, "dir"])
  ~os.mkdir(d, 0o755)
  link_to_dir = filepath.join([td, "link_to_dir"])
  ~os.symlink(d, link_to_dir)
  file = filepath.join([link_to_dir, "file"])
  ~os.write_file(file, [], 0o644)
  link1 = filepath.join([link_to_dir, "link1"])
  ~os.symlink(file, link1)
  link2 = filepath.join([link_to_dir, "link2"])
  ~os.symlink(link1, link2)
  # The temp dir may itself be a symlink.
  real_tmp = ~filepath.eval_symlinks(td)
  real_dir = filepath.join([real_tmp, "dir"])
  real_file = filepath.join([real_dir, "file"])
  tests = [[d, real_dir], [link_to_dir, real_dir], [file, real_file], [link1, real_file], [link2, real_file]]
  for t in tests {
    check(~filepath.eval_symlinks(t[0]), t[1], "EvalSymlinks(#{t[0]})")
  }
}

# Issue 57905.
test "RelativeSymlinkToAbsolute" {
  td = temp_dir()
  wd = os.getwd.unwrap
  os.chdir(td).unwrap
  defer {
    os.chdir(wd).unwrap
    os.remove_all(td).unwrap
  }
  ~os.symlink(td, "link")
  p = ~filepath.eval_symlinks("link")
  want = ~filepath.eval_symlinks(td)
