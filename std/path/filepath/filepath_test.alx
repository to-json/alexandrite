}

test "Issue29372" {
  td = temp_dir()
  defer { os.remove_all(td).unwrap }
  p = filepath.join([td, "file.txt"])
  ~os.write_file(p, [], 0o644)
  tests = [p + "/", p + "//", p + "/.", p + "//.", p + "/..", p + "//.."]
  for t in tests {
    r = filepath.eval_symlinks(t)
    if e = r.err {
      case e {
        filepath.FilepathError.NotDir => check(e.message, "not a directory", "ENOTDIR text")
        _ => assert false, "EvalSymlinks(#{t}): want ENOTDIR, got #{e.message}"
      }
    } else {
      assert false, "EvalSymlinks(#{t}): want ENOTDIR, got #{r.unwrap}"
    }
  }
}

# Issue 30520 part 1.
test "EvalSymlinksAboveRoot" {
  td = temp_dir()
  defer { os.remove_all(td).unwrap }
  eval_tmp = ~filepath.eval_symlinks(td)
  ~os.mkdir(filepath.join([eval_tmp, "a"]), 0o777)
  ~os.symlink(filepath.join([eval_tmp, "a"]), filepath.join([eval_tmp, "b"]))
  ~os.write_file(filepath.join([eval_tmp, "a", "file"]), [], 0o666)
  # Count the ".." elements to get to the root directory.
  c = strings.count(eval_tmp, "/")
  dd: [Str] = []
  i = 0
  while i < c + 2 {
    dd << ".."
    i += 1
  }
  want_suffix = "a/file"
  for k in [c, c + 1, c + 2] {
    chk = strings.join([eval_tmp, strings.join(dd[0...k], "/"), eval_tmp[1...eval_tmp.size], "b", "file"], "/")
    resolved = ~filepath.eval_symlinks(chk)
    assert resolved.end_with?(want_suffix), "EvalSymlinks(#{chk}) = #{resolved} does not end with #{want_suffix}"
  }
}

# Issue 30520 part 2.
test "EvalSymlinksAboveRootChdir" {
  td = temp_dir()
  wd = os.getwd.unwrap
  os.chdir(td).unwrap
  defer {
    os.chdir(wd).unwrap
    os.remove_all(td).unwrap
  }
  subdir = filepath.join(["a", "b"])
  ~os.mkdir_all(subdir, 0o777)
  ~os.symlink(subdir, "c")
  ~os.write_file(filepath.join([subdir, "file"]), [], 0o666)
  subdir = filepath.join(["d", "e", "f"])
  ~os.mkdir_all(subdir, 0o777)
  ~os.chdir(subdir)
  chk = filepath.join(["..", "..", "..", "c", "file"])
  want_suffix = filepath.join(["a", "b", "file"])
  resolved = ~filepath.eval_symlinks(chk)
  assert resolved.end_with?(want_suffix), "EvalSymlinks(#{chk}) = #{resolved} does not end with #{want_suffix}"
}

test "Escaping" {
  d = temp_dir()
  d2 = temp_dir()
  wd = os.getwd.unwrap
  os.chdir(d2).unwrap
  defer {
    os.chdir(wd).unwrap
    os.remove_all(d).unwrap
    os.remove_all(d2).unwrap
  }
  for p in [filepath.join([d, "x"])] {
    next if !filepath.local?(p)
    os.create(p)
    ents = ~os.read_dir(d)
    for e in ents {
      assert false, "found: #{e.name}"
    }
  }
}

test "EvalSymlinksTooManyLinks" {
  td = temp_dir()
  defer { os.remove_all(td).unwrap }
  d = filepath.join([td, "dir"])
  ~os.symlink(d, d)
  r = filepath.eval_symlinks(d)
  assert r.err?, "expected error"
  check(r.err.unwrap.message, "EvalSymlinks: too many links", "error")
}

# --------------------------------------------------------------------- Abs

test "Abs" {
  root0 = temp_dir()
  root = ~filepath.eval_symlinks(root0)
  wd = os.getwd.unwrap
  os.chdir(root).unwrap
  defer {
    os.chdir(wd).unwrap
    os.remove_all(root).unwrap
  }
  for d in ["a", "a/b", "a/b/c"] {
    ~os.mkdir(d, 0o777)
  }
  ~os.chdir("a")
  tests = [
    ".",
    "b",
    "b/",
    "../a",
    "../a/b",
    "../a/b/./c/../../.././a",
    "../a/b/./c/../../.././a/",
    "$",
    "$/.",
    "$/a/../a/b",
    "$/a/b/c/../../.././a",
    "$/a/b/c/../../.././a/",
  ]
  for t in tests {
    p = strings.replace_all(t, "$", root)
    info = ~os.stat(p)
    abspath = ~filepath.abs(p)
    absinfo = ~os.stat(abspath)
    assert absinfo.ino == info.ino, "Abs(#{p}) = #{abspath}, not the same file"
    assert filepath.is_abs(abspath), "Abs(#{p}) = #{abspath}, not an absolute path"
    check(abspath, filepath.clean(abspath), "Abs(#{p}) is clean")
  }
}

test "AbsEmptyString" {
  root = temp_dir()
  wd = os.getwd.unwrap
  os.chdir(root).unwrap
  defer {
    os.chdir(wd).unwrap
    os.remove_all(root).unwrap
  }
  info = ~os.stat(root)
  abspath = ~filepath.abs("")
  absinfo = ~os.stat(abspath)
  assert absinfo.ino == info.ino, "Abs(\"\") = #{abspath}, not the same file"
  assert filepath.is_abs(abspath), "Abs(\"\") = #{abspath}, not an absolute path"
  check(abspath, filepath.clean(abspath), "Abs(\"\") is clean")
}

# ------------------------------------------------------------ match_test.go

struct MatchTest {
  pattern: Str
  s: Str
  match: Bool
  bad: Bool
}

def mt(pattern: Str, s: Str, m: Bool, bad: Bool = false) -> MatchTest {
  MatchTest.new(pattern: pattern, s: s, match: m, bad: bad)
}

def match_tests -> [MatchTest] {
  [
    mt("abc", "abc", true),
    mt("*", "abc", true),
    mt("*c", "abc", true),
    mt("a*", "a", true),
    mt("a*", "abc", true),
    mt("a*", "ab/c", false),
    mt("a*/b", "abc/b", true),
    mt("a*/b", "a/c/b", false),
    mt("a*b*c*d*e*/f", "axbxcxdxe/f", true),
    mt("a*b*c*d*e*/f", "axbxcxdxexxx/f", true),
    mt("a*b*c*d*e*/f", "axbxcxdxe/xxx/f", false),
    mt("a*b*c*d*e*/f", "axbxcxdxexxx/fff", false),
    mt("a*b?c*x", "abxbbxdbxebxczzx", true),
    mt("a*b?c*x", "abxbbxdbxebxczzy", false),
    mt("ab[c]", "abc", true),
    mt("ab[b-d]", "abc", true),
    mt("ab[e-g]", "abc", false),
    mt("ab[^c]", "abc", false),
    mt("ab[^b-d]", "abc", false),
    mt("ab[^e-g]", "abc", true),
    mt("a\\*b", "a*b", true),
    mt("a\\*b", "ab", false),
    mt("a?b", "a☺b", true),
    mt("a[^a]b", "a☺b", true),
    mt("a???b", "a☺b", false),
    mt("a[^a][^a][^a]b", "a☺b", false),
    mt("[a-ζ]*", "α", true),
    mt("*[a-ζ]", "A", false),
    mt("a?b", "a/b", false),
    mt("a*b", "a/b", false),
    mt("[\\]a]", "]", true),
    mt("[\\-]", "-", true),
    mt("[x\\-]", "x", true),
    mt("[x\\-]", "-", true),
    mt("[x\\-]", "z", false),
    mt("[\\-x]", "x", true),
    mt("[\\-x]", "-", true),
    mt("[\\-x]", "a", false),
    mt("[]a]", "]", false, bad: true),
    mt("[-]", "-", false, bad: true),
    mt("[x-]", "x", false, bad: true),
    mt("[x-]", "-", false, bad: true),
    mt("[x-]", "z", false, bad: true),
    mt("[-x]", "x", false, bad: true),
    mt("[-x]", "-", false, bad: true),
    mt("[-x]", "a", false, bad: true),
    mt("\\", "a", false, bad: true),
    mt("[a-b-c]", "a", false, bad: true),
    mt("[", "a", false, bad: true),
    mt("[^", "a", false, bad: true),
    mt("[^bc", "a", false, bad: true),
    mt("a[", "a", false, bad: true),
    mt("a[", "ab", false, bad: true),
    mt("a[", "x", false, bad: true),
    mt("a/b[", "x", false, bad: true),
    mt("*x", "xxx", true),
  ]
}

def bad_pattern?(e: Error) -> Bool {
  case e {
    filepath.FilepathError.ErrBadPattern => true
    _ => false
  }
}

test "Match" {
  for tt in match_tests() {
    r = filepath.match(tt.pattern, tt.s)
    if e = r.err {
      assert tt.bad, "Match(#{tt.pattern}, #{tt.s}): unexpected error #{e.message}"
      assert bad_pattern?(e), "Match(#{tt.pattern}, #{tt.s}): wrong error #{e.message}"
    } else {
      assert !tt.bad, "Match(#{tt.pattern}, #{tt.s}): want ErrBadPattern"
      check(r.unwrap, tt.match, "Match(#{tt.pattern}, #{tt.s})")
    }
  }
}

# Go's globTests run in the package directory (match.go there is filepath.alx
# here).
test "Glob" {
  tests = [["filepath.alx", "filepath.alx"], ["filepat?.alx", "filepath.alx"], ["*", "filepath.alx"], ["../*/filepath.alx", "../filepath/filepath.alx"]]
  for t in tests {
    matches = ~filepath.glob(t[0])
    assert matches.include?(t[1]), "Glob(#{t[0]}) = #{matches}, want #{t[1]}"
  }
  for p in ["no_match", "../*/no_match"] {
    check(~filepath.glob(p), [], "Glob(#{p})")
  }
}

test "CVE202230632" {
  # Prior to CVE-2022-30632, this would exhaust the stack given a large
  # number of separators; now there is a limit of 10,000.
  r = filepath.glob("/*" + "/" * 10001)
  assert bad_pattern?(r.err.unwrap), "want ErrBadPattern"
}

test "GlobError" {
  for p in ["[]", "nonexist/[]"] {
    r = filepath.glob(p)
    assert r.err? && bad_pattern?(r.err.unwrap), "Glob(#{p}): want ErrBadPattern"
  }
}

test "GlobSymlink" {
  td = temp_dir()
  defer { os.remove_all(td).unwrap }
  tests: [(Str, Str, Bool)] = [("test1", "link1", false), ("test2", "link2", true)]
  for t in tests {
    p = filepath.join([td, t[0]])
    dest = filepath.join([td, t[1]])
    touch(p)
    ~os.symlink(p, dest)
    # Break the symlink.
    ~os.remove(p) if t[2]
    matches = ~filepath.glob(dest)
    assert matches.include?(dest), "Glob(#{dest}) = #{matches}, want #{dest}"
  }
}

test "NonWindowsGlobEscape" {
  check(~filepath.glob("\\filepath.alx"), ["filepath.alx"], "Glob(\\filepath.alx)")
}

# ------------------------------------------------------------- examples

example "SplitList" {
  puts "On Unix: #{filepath.split_list("/a/b/c:/usr/bin")}"
} outputs "On Unix: [/a/b/c /usr/bin]\n"

example "Rel" {
  base = "/a"
  puts "On Unix:"
  for p in ["/a/b/c", "/b/c", "./b/c"] {
    r = filepath.rel(base, p)
    if e = r.err {
      puts format("%q: %q %s", p, "", e.message)
    } else {
      puts format("%q: %q <nil>", p, r.unwrap)
    }
  }
} outputs <<~'EOS'
  On Unix:
  "/a/b/c": "b/c" <nil>
  "/b/c": "../b/c" <nil>
  "./b/c": "" Rel: can't make ./b/c relative to /a
EOS

example "Split" {
  puts "On Unix:"
  for p in ["/home/arnie/amelia.jpg", "/mnt/photos/", "rabbit.jpg", "/usr/local//go"] {
    d, f = filepath.split(p)
    puts format("input: %q\n\tdir: %q\n\tfile: %q", p, d, f)
  }
} outputs "On Unix:\ninput: \"/home/arnie/amelia.jpg\"\n\tdir: \"/home/arnie/\"\n\tfile: \"amelia.jpg\"\ninput: \"/mnt/photos/\"\n\tdir: \"/mnt/photos/\"\n\tfile: \"\"\ninput: \"rabbit.jpg\"\n\tdir: \"\"\n\tfile: \"rabbit.jpg\"\ninput: \"/usr/local//go\"\n\tdir: \"/usr/local//\"\n\tfile: \"go\"\n"

example "Join" {
  puts "On Unix:"
  puts filepath.join(["a", "b", "c"])
  puts filepath.join(["a", "b/c"])
  puts filepath.join(["a/b", "c"])
  puts filepath.join(["a/b", "/c"])
  puts filepath.join(["a/b", "../../../xyz"])
} outputs "On Unix:\na/b/c\na/b/c\na/b/c\na/b/c\n../xyz\n"

example "Match" {
  puts "On Unix:"
  puts filepath.match("/home/catch/*", "/home/catch/foo").unwrap
  puts filepath.match("/home/catch/*", "/home/catch/foo/bar").unwrap
  puts filepath.match("/home/?opher", "/home/gopher").unwrap
  puts filepath.match("/home/\\*", "/home/*").unwrap
} outputs "On Unix:\ntrue\nfalse\ntrue\ntrue\n"

example "Base" {
  puts "On Unix:"
  for p in ["/foo/bar/baz.js", "/foo/bar/baz", "/foo/bar/baz/", "dev.txt", "../todo.txt", "..", ".", "/", ""] {
    puts filepath.base(p)
  }
} outputs "On Unix:\nbaz.js\nbaz\nbaz\ndev.txt\ntodo.txt\n..\n.\n/\n.\n"

example "Dir" {
  puts "On Unix:"
  for p in ["/foo/bar/baz.js", "/foo/bar/baz", "/foo/bar/baz/", "/dirty//path///", "dev.txt", "../todo.txt", "..", ".", "/", ""] {
    puts filepath.dir(p)
  }
} outputs "On Unix:\n/foo/bar\n/foo/bar\n/foo/bar/baz\n/dirty/path\n.\n..\n.\n.\n/\n.\n"

example "IsAbs" {
  puts "On Unix:"
  for p in ["/home/gopher", ".bashrc", "..", ".", "/", ""] {
    puts filepath.is_abs(p)
  }
} outputs "On Unix:\ntrue\nfalse\nfalse\nfalse\ntrue\nfalse\n"

example "Ext" {
  puts format("No dots: %q", filepath.ext("index"))
  puts format("One dot: %q", filepath.ext("index.js"))
  puts format("Two dots: %q", filepath.ext("main.test.js"))
} outputs "No dots: \"\"\nOne dot: \".js\"\nTwo dots: \".js\"\n"

example "Walk" {
  tmp = os.mkdir_temp("", "").unwrap
  os.mkdir_all(filepath.join([tmp, "dir/to/walk/skip"]), 0o755).unwrap
  wd = os.getwd.unwrap
  os.chdir(tmp).unwrap
  puts "On Unix:"
  r = filepath.walk(".") { |p, info, err|
    if e = err {
      puts format("prevent panic by handling failure accessing a path %q: %s", p, e.message)
      fail e
    }
    if i = info {
      if i.is_dir && i.name == "skip" {
        puts "skipping a dir without errors: #{i.name} "
        fail fs.FsError.SkipDir
      }
    }
    puts format("visited file or dir: %q", p)
  }
  if e = r.err {
    puts format("error walking the path %q: %s", tmp, e.message)
  }
  os.chdir(wd).unwrap
  os.remove_all(tmp).unwrap
} outputs <<~'EOS'
  On Unix:
  visited file or dir: "."
  visited file or dir: "dir"
  visited file or dir: "dir/to"
  visited file or dir: "dir/to/walk"
  skipping a dir without errors: skip
EOS
