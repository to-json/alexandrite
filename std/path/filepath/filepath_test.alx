import "os"

test "rel" {
  cases = [["a/b", "a/b", "."], ["a/b/.", "a/b", "."], ["a/b", "a/b/.", "."], ["./a/b", "a/b", "."], ["a/b", "./a/b", "."], ["ab/cd", "ab/cde", "../cde"], ["ab/cd", "ab/c", "../c"],
    ["a/b", "a/b/c/d", "c/d"], ["a/b", "a/b/../c", "../c"], ["a/b/../c", "a/b", "../b"], ["a/b/c", "a/c/d", "../../c/d"], ["a/b", "c/d", "../../c/d"], ["a/b/c/d", "a/b", "../.."],
    ["a/b/c/d", "a/b/", "../.."], ["a/b/c/d/", "a/b", "../.."], ["a/b/c/d/", "a/b/", "../.."], ["../../a/b", "../../a/b/c/d", "c/d"], ["/a/b", "/a/b", "."], ["/a/b/.", "/a/b", "."],
    ["/a/b", "/a/b/.", "."], ["/ab/cd", "/ab/cde", "../cde"], ["/ab/cd", "/ab/c", "../c"], ["/a/b", "/a/b/c/d", "c/d"], ["/a/b", "/a/b/../c", "../c"], ["/a/b/../c", "/a/b", "../b"],
    ["/a/b/c", "/a/c/d", "../../c/d"], ["/a/b", "/c/d", "../../c/d"], ["/a/b/c/d", "/a/b", "../.."], ["/a/b/c/d", "/a/b/", "../.."], ["/a/b/c/d/", "/a/b", "../.."],
    ["/a/b/c/d/", "/a/b/", "../.."], ["/../../a/b", "/../../a/b/c/d", "c/d"], [".", "a/b", "a/b"], [".", "..", ".."]]
  for c in cases {
    assert_eq rel(c[0], c[1]).unwrap, c[2]
  }
  for c in [["../..", "."], ["../..", "a"], ["../../a/b", "../a"], ["/a", "a"], ["a", "/a"]] {
    assert rel(c[0], c[1]).err?, "#{c[0]} -> #{c[1]} should fail"
  }
}

test "split_list and wrappers" {
  assert_eq split_list("").size, 0
  assert_eq split_list("a:b:c").size, 3
  assert_eq split_list("a::b")[1], ""
  assert_eq join(["a", "b"]), "a/b"
  d, f = split("x/y")
  assert_eq d + f, "x/y"
  assert match("*.go", "x.go").unwrap
}

# ---------------------------------------------------------- with the os package

def tree -> Str {
  d = os.mkdir_temp("", "alx-fp-test-*").unwrap
  os.mkdir_all(d + "/a/b", 0o755).unwrap
  os.mkdir_all(d + "/c", 0o755).unwrap
  os.write_file(d + "/a/one.txt", "1".bytes.to_a, 0o644).unwrap
  os.write_file(d + "/a/b/two.go", "22".bytes.to_a, 0o644).unwrap
  os.write_file(d + "/a/b/three.txt", "333".bytes.to_a, 0o644).unwrap
  os.write_file(d + "/z.txt", "4444".bytes.to_a, 0o644).unwrap
  d
}

test "abs" {
  assert_eq abs("/a/../b/./c").unwrap, "/b/c"
  wd = os.getwd.unwrap
  assert_eq abs(".").unwrap, wd
  assert_eq abs("x/y").unwrap, wd + "/x/y"
  assert_eq abs("../x").unwrap, dir(wd) + "/x" if wd != "/"
}

test "walk_dir visits in lexical order" {
  d = tree
  seen = ""
  count = 0
  walk_dir(d) { |p, e|
    seen = seen + p[d.size...p.size] + (e.is_dir ? "/" : "") + " "
    count += 1
    WalkAction.Continue
  }.unwrap
  assert_eq seen, "/ /a/ /a/b/ /a/b/three.txt /a/b/two.go /a/one.txt /c/ /z.txt "
  assert_eq count, 8
  os.remove_all(d).unwrap
}

test "walk_dir: SkipDir and Stop" {
  d = tree
  seen = ""
  walk_dir(d) { |p, e|
    seen = seen + e.name + " "
    e.name == "b" ? WalkAction.SkipDir : WalkAction.Continue
  }.unwrap
  assert_eq seen, "#{base(d)} a b one.txt c z.txt "
  seen = ""
  walk_dir(d) { |p, e|
    seen = seen + e.name + " "
    e.name == "two.go" ? WalkAction.Stop : WalkAction.Continue
  }.unwrap
  assert_eq seen, "#{base(d)} a b three.txt two.go "
  # SkipDir on a file skips the rest of its directory.
  seen = ""
  walk_dir(d) { |p, e|
    seen = seen + e.name + " "
    e.name == "three.txt" ? WalkAction.SkipDir : WalkAction.Continue
  }.unwrap
  assert_eq seen, "#{base(d)} a b three.txt one.txt c z.txt "
  os.remove_all(d).unwrap
}

test "walk_dir: a file root and a missing root" {
  d = tree
  n = 0
  walk_dir(d + "/z.txt") { |p, e|
    n += 1
    WalkAction.Continue
  }.unwrap
  assert_eq n, 1
  r = walk_dir(d + "/nope") { |p, e| WalkAction.Continue }
  assert os.is_not_exist(r.err.unwrap)
  os.remove_all(d).unwrap
}

test "glob" {
  d = tree
  g = glob(d + "/a/*.txt").unwrap
  assert_eq g.size, 1
  assert_eq g[0], d + "/a/one.txt"
  g2 = glob(d + "/*/b/*.txt").unwrap
  assert_eq g2.size, 1
  assert_eq g2[0], d + "/a/b/three.txt"
  assert_eq glob(d + "/*").unwrap.size, 3
  assert_eq glob(d + "/nothing*").unwrap.size, 0
  assert_eq glob(d + "/z.txt").unwrap.size, 1
  assert_eq glob(d + "/missing.txt").unwrap.size, 0
  assert glob(d + "/[").err?
  os.remove_all(d).unwrap
}
