  assert_eq [clean(Str.from_bytes([254, 47, 46, 46, 46])), base(Str.from_bytes([254, 47, 46, 46, 46])), dir(Str.from_bytes([254, 47, 46, 46, 46])), ext(Str.from_bytes([254, 47, 46, 46, 46]))], [Str.from_bytes([254, 47, 46, 46, 46]), "...", Str.from_bytes([254]), "."]
  assert_eq [clean("a.b///./..."), base("a.b///./..."), dir("a.b///./..."), ext("a.b///./...")], ["a.b/...", "...", "a.b", "."]
  assert_eq [clean(Str.from_bytes([47, 46, 46, 47, 47, 254, 47])), base(Str.from_bytes([47, 46, 46, 47, 47, 254, 47])), dir(Str.from_bytes([47, 46, 46, 47, 47, 254, 47])), ext(Str.from_bytes([47, 46, 46, 47, 47, 254, 47]))], [Str.from_bytes([47, 254]), Str.from_bytes([254]), Str.from_bytes([47, 254]), ""]
  assert_eq [clean("..././é"), base("..././é"), dir("..././é"), ext("..././é")], [".../é", "é", "...", ""]
  assert_eq [clean("b/.../"), base("b/.../"), dir("b/.../"), ext("b/.../")], ["b/...", "...", "b/...", ""]
  assert_eq [clean("/ab/b"), base("/ab/b"), dir("/ab/b"), ext("/ab/b")], ["/ab/b", "b", "/ab", ""]
  assert_eq [clean("b/../a"), base("b/../a"), dir("b/../a"), ext("b/../a")], ["a", "a", ".", ""]
  assert_eq [clean("/a/..."), base("/a/..."), dir("/a/..."), ext("/a/...")], ["/a/...", "...", "/a", "."]
  assert_eq [clean(Str.from_bytes([98, 47, 47, 47, 254, 47, 46, 46])), base(Str.from_bytes([98, 47, 47, 47, 254, 47, 46, 46])), dir(Str.from_bytes([98, 47, 47, 47, 254, 47, 46, 46])), ext(Str.from_bytes([98, 47, 47, 47, 254, 47, 46, 46]))], ["b", "..", Str.from_bytes([98, 47, 254]), "."]
  assert_eq [clean("/...//ab//"), base("/...//ab//"), dir("/...//ab//"), ext("/...//ab//")], ["/.../ab", "ab", "/.../ab", ""]
  assert_eq [clean("/b/"), base("/b/"), dir("/b/"), ext("/b/")], ["/b", "b", "/b", ""]
  assert_eq [clean("é/////"), base("é/////"), dir("é/////"), ext("é/////")], ["é", "é", "é", ""]
  assert_eq [clean(Str.from_bytes([254, 47, 47, 47])), base(Str.from_bytes([254, 47, 47, 47])), dir(Str.from_bytes([254, 47, 47, 47])), ext(Str.from_bytes([254, 47, 47, 47]))], [Str.from_bytes([254]), Str.from_bytes([254]), Str.from_bytes([254]), ""]
  assert_eq [clean(Str.from_bytes([47, 254, 47, 254])), base(Str.from_bytes([47, 254, 47, 254])), dir(Str.from_bytes([47, 254, 47, 254])), ext(Str.from_bytes([47, 254, 47, 254]))], [Str.from_bytes([47, 254, 47, 254]), Str.from_bytes([254]), Str.from_bytes([47, 254]), ""]
  assert_eq [clean("é///ab/é"), base("é///ab/é"), dir("é///ab/é"), ext("é///ab/é")], ["é/ab/é", "é", "é/ab", ""]
  assert_eq [clean("é/../..."), base("é/../..."), dir("é/../..."), ext("é/../...")], ["...", "...", ".", "."]
  assert_eq [clean("a//a.b"), base("a//a.b"), dir("a//a.b"), ext("a//a.b")], ["a/a.b", "a.b", "a", ".b"]
  assert_eq [clean("a.b/é/.."), base("a.b/é/.."), dir("a.b/é/.."), ext("a.b/é/..")], ["a.b", "..", "a.b/é", "."]
  assert_eq [clean(Str.from_bytes([47, 47, 46, 47, 97, 98, 47, 254])), base(Str.from_bytes([47, 47, 46, 47, 97, 98, 47, 254])), dir(Str.from_bytes([47, 47, 46, 47, 97, 98, 47, 254])), ext(Str.from_bytes([47, 47, 46, 47, 97, 98, 47, 254]))], [Str.from_bytes([47, 97, 98, 47, 254]), Str.from_bytes([254]), "/ab", ""]
  assert_eq [clean("///..."), base("///..."), dir("///..."), ext("///...")], ["/...", "...", "/", "."]
  assert_eq [clean("a.b//////"), base("a.b//////"), dir("a.b//////"), ext("a.b//////")], ["a.b", "a.b", "a.b", ""]
  assert_eq [clean("//b/..."), base("//b/..."), dir("//b/..."), ext("//b/...")], ["/b/...", "...", "/b", "."]
  assert_eq [clean("a/a.b/é/"), base("a/a.b/é/"), dir("a/a.b/é/"), ext("a/a.b/é/")], ["a/a.b/é", "é", "a/a.b/é", ""]
  assert_eq [clean(Str.from_bytes([47, 254, 47, 98, 47, 46, 46, 46])), base(Str.from_bytes([47, 254, 47, 98, 47, 46, 46, 46])), dir(Str.from_bytes([47, 254, 47, 98, 47, 46, 46, 46])), ext(Str.from_bytes([47, 254, 47, 98, 47, 46, 46, 46]))], [Str.from_bytes([47, 254, 47, 98, 47, 46, 46, 46]), "...", Str.from_bytes([47, 254, 47, 98]), "."]
}

