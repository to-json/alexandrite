  chk_match("[a-]é", "x?", 2)
  chk_match("[^a-c]", "-abc", 0)
  chk_match("/é", ".abca/", 0)
  chk_match("[^a]a", "..é", 0)
  chk_match(Str.from_bytes([98, 91, 255, 93]), "", 2)
  chk_match("b[^a-c]c", "", 0)
  chk_match("[a-b-c][^é][a-c]", Str.from_bytes([97, 255]), 2)
  chk_match("***[-a]\\?", "c.", 2)
  chk_match(Str.from_bytes([91, 255, 93, 92, 91, 97, 92, 93, 98, 93, 98]), "]", 2)
  chk_match(Str.from_bytes([91, 255, 93, 92, 92, 42, 91, 255, 93]), Str.from_bytes([42, 92, 255]), 2)
  chk_match("\\[\\*]", "]/", 0)
  chk_match("é", "é", 1)
  chk_match("[a\\]b]", "[?", 0)
  chk_match("**[^?*", ".-bc", 2)
  chk_match(Str.from_bytes([255, 91, 97, 98, 93, 91, 94, 97, 45, 99, 93, 92, 92]), "***", 0)
  chk_match("[a\\]b]é", "a[", 0)
  chk_match("\\[\\[", "x", 0)
  chk_match("[]a]\\\\[é-ü][-a]", "", 2)
  chk_match("]é**[a-]", "babc", 0)
  chk_match("\\[[a-b-c]c", "[", 2)
  chk_match("[a-c]", "]\\/", 0)
  chk_match("[\\]]-[^a-c]", "aba", 0)
  chk_match(Str.from_bytes([91, 92, 93, 93, 255, 91, 120, 91, 94, 97, 93]), "ab-", 0)
  chk_match("[^a-c][^", ".ab/", 2)
  chk_match("**\\?a", "", 0)
  chk_match("[]a][é-ü][a\\]b]", "", 2)
  chk_match("**[]a]*\\?", "-\\ab", 2)
  chk_match("]\\", "]/*", 2)
  chk_match("\\\\[^é]c", ".c]", 0)
  chk_match("?a\\\\\\", "?babc]", 2)
}
