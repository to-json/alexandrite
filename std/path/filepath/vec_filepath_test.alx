# Generated from Go's path/filepath (`go run` in a scratch directory, on Unix); do not edit by hand.
# chk_match's want: 0 no match, 1 match, 2 ErrBadPattern.

#[track_caller]
def chk_rel_err(b: Str, t: Str) {
  r = rel(b, t)
  assert r.err?, format("rel(%q, %q) = %q, want an error at %s", b, t, r.ok || "", caller_location)
  assert_eq r.err.unwrap.message, "Rel: can't make #{t} relative to #{b}"
}

#[track_caller]
def chk_match(pattern: Str, name: Str, want: Int) {
  r = match(pattern, name)
  got = 0
  if e = r.err {
    assert_eq e.message, "syntax error in pattern"
    got = 2
  } else if r.unwrap {
    got = 1
  }
  assert got == want, format("match(%q, %q) = %d, want %d at %s", pattern, name, got, want, caller_location)
}

test "rel 1" {
  chk_rel_err("/", "é//...//")
  chk_rel_err("/", ".../")
  assert_eq rel("a.b", "a/.../a/").unwrap, "../a/.../a"
  chk_rel_err("/", "b")
  assert_eq rel("b", "").unwrap, ".."
  assert_eq rel("//...//", "///b").unwrap, "../b"
  assert_eq rel("////", "/ab").unwrap, "ab"
  assert_eq rel("b/..", "é/é/ab").unwrap, "é/é/ab"
  assert_eq rel("a.b", "").unwrap, ".."
  assert_eq rel(Str.from_bytes([47, 254]), "////").unwrap, ".."
  chk_rel_err(Str.from_bytes([98, 47, 98, 47, 254, 47, 46, 46]), "////")
  chk_rel_err(Str.from_bytes([46, 47, 254, 47, 47, 47]), "/./ab/a/")
  assert_eq rel("////", "//..").unwrap, "."
  assert_eq rel(Str.from_bytes([47, 97, 46, 98, 47, 254]), "/a.b/...//").unwrap, "../..."
  chk_rel_err(Str.from_bytes([47, 254, 47, 46, 46, 46]), "")
  assert_eq rel(Str.from_bytes([254]), "ab/ab////").unwrap, "../ab/ab"
  chk_rel_err("////b/./", "")
  assert_eq rel("a", ".//b/...").unwrap, "../b/..."
  assert_eq rel("/", "/...").unwrap, "..."
  assert_eq rel("///é/b/", "////...").unwrap, "../../..."
  assert_eq rel("b", "ab/a.b///").unwrap, "../ab/a.b"
  chk_rel_err("./", "//a/a")
  chk_rel_err("/./////", Str.from_bytes([97, 46, 98, 47, 254, 47, 98, 47, 46, 46]))
  chk_rel_err("", "/a.b")
  chk_rel_err("", "/ab/../..")
  assert_eq rel("", "").unwrap, "."
  chk_rel_err("é/", "///./a.b")
  assert_eq rel("//b/b/b", Str.from_bytes([47, 47, 47, 46, 47, 254, 47, 98, 47])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 254, 47, 98])
  chk_rel_err("/", "...")
  assert_eq rel("/", "/.../..//b").unwrap, "b"
  assert_eq rel(Str.from_bytes([254, 47, 46, 47, 97]), "a/ab").unwrap, "../../a/ab"
  assert_eq rel("/b/a.b/ab/b", "/a/////").unwrap, "../../../../a"
  assert_eq rel("b/é/a.b/a.b", ".../...").unwrap, "../../../../.../..."
  assert_eq rel(Str.from_bytes([47, 254, 47, 47, 98, 47, 47]), "////").unwrap, "../.."
  chk_rel_err("", "/a///")
  assert_eq rel("//", Str.from_bytes([47, 46, 46, 46, 47, 97, 46, 98, 47, 254, 47])).unwrap, Str.from_bytes([46, 46, 46, 47, 97, 46, 98, 47, 254])
  chk_rel_err("/a.b", "")
  assert_eq rel(Str.from_bytes([47, 47, 97, 98, 47, 254, 47, 97, 46, 98]), "//").unwrap, "../../.."
  chk_rel_err("é//b", "//")
  assert_eq rel(Str.from_bytes([47, 254, 47, 98]), "//a.b////é/").unwrap, "../../a.b/é"
  chk_rel_err("/", "b/../a")
  assert_eq rel("/", "/").unwrap, "."
  assert_eq rel("/", Str.from_bytes([47, 254])).unwrap, Str.from_bytes([254])
  chk_rel_err(".///", "/a.b/é/a/a.b")
  assert_eq rel("/", "///").unwrap, "."
  assert_eq rel("", "é").unwrap, "é"
  chk_rel_err("/a.b/a.b/b", "b////ab/a.b")
  chk_rel_err("a.b////../", "/")
  chk_rel_err(Str.from_bytes([47, 254, 47, 97, 98, 47, 47, 47]), "")
  assert_eq rel("a", "ab///é").unwrap, "../ab/é"
  assert_eq rel("/.////", "/b/b/.").unwrap, "b/b"
  assert_eq rel("", "../é/").unwrap, "../é"
  assert_eq rel("//", "/..").unwrap, "."
  assert_eq rel("...///a.b/", Str.from_bytes([97, 46, 98, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 97, 46, 98, 47, 254])
  chk_rel_err("/./é", "")
  assert_eq rel("/", Str.from_bytes([47, 47, 254, 47, 97, 47, 47])).unwrap, Str.from_bytes([254, 47, 97])
  chk_rel_err("///", ".///")
  chk_rel_err("a/b", Str.from_bytes([47, 47, 47, 47, 47, 254, 47, 98]))
  chk_rel_err("/..././", "a.b")
  chk_rel_err("a.b////a", "/")
  chk_rel_err("/", ".")
  assert_eq rel("///../", "/b//").unwrap, "b"
  chk_rel_err("", Str.from_bytes([47, 254, 47, 195, 169, 47, 97, 46, 98, 47, 46]))
  assert_eq rel("", "...").unwrap, "..."
  assert_eq rel("é/./b", "./b/a.b").unwrap, "../../b/a.b"
  assert_eq rel(".", "b/ab/../a").unwrap, "b/a"
  assert_eq rel(Str.from_bytes([47, 254]), "///.../b/a.b").unwrap, "../.../b/a.b"
  chk_rel_err("ab/...//////", "/./ab//")
  chk_rel_err("/", Str.from_bytes([254]))
  chk_rel_err("/", "")
  chk_rel_err("/...//a.b", Str.from_bytes([46, 46, 47, 254]))
  chk_rel_err("ab//a.b/", "///b")
  chk_rel_err("/", "ab////é/")
  assert_eq rel("b/ab", "ab/a").unwrap, "../../ab/a"
  assert_eq rel("//", "/b").unwrap, "b"
  chk_rel_err("../a/b/", "/b/é")
  assert_eq rel(".../.", ".///").unwrap, ".."
  assert_eq rel("é/é", "a.b").unwrap, "../../a.b"
  assert_eq rel("/é/", "//.").unwrap, ".."
  assert_eq rel(Str.from_bytes([97, 46, 98, 47, 254, 47, 47]), ".../...").unwrap, "../../.../..."
  chk_rel_err("/ab/a/...", "./a")
  chk_rel_err("", "/")
  chk_rel_err("./", "/")
  assert_eq rel("///ab", "/").unwrap, ".."
  assert_eq rel("/", "///..").unwrap, "."
  assert_eq rel("../a/", ".././../").unwrap, "../.."
  assert_eq rel(".///", "a.b/b/b").unwrap, "a.b/b/b"
  assert_eq rel("/", "/é").unwrap, "é"
  chk_rel_err("////", "a.b")
  assert_eq rel("/", "//a").unwrap, "a"
  assert_eq rel("b///b/é", "b/a.b/a.b").unwrap, "../../a.b/a.b"
  chk_rel_err("/..///ab", "...//")
  chk_rel_err("ab/../é", "/..////")
  chk_rel_err("ab/../ab/./", "/.../...")
  chk_rel_err("/./..", "a")
  assert_eq rel("ab/a.b/.", "./é/é").unwrap, "../../é/é"
  assert_eq rel("//a/", "//é").unwrap, "../é"
  chk_rel_err("/...///", Str.from_bytes([97, 98, 47, 195, 169, 47, 254, 47, 97, 46, 98]))
  chk_rel_err("//", "a///.")
  chk_rel_err("./.", "/")
}

test "rel 2" {
  chk_rel_err("//a.b////...", Str.from_bytes([254]))
  chk_rel_err("/ab", "a//")
  assert_eq rel("ab/a.b", Str.from_bytes([254, 47, 97, 98, 47, 46, 46, 46, 47])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 254, 47, 97, 98, 47, 46, 46, 46])
  assert_eq rel("/", "/é/é").unwrap, "é/é"
  assert_eq rel("a.b/////////", ".../a.b//./").unwrap, "../.../a.b"
  chk_rel_err(".///./...", "/")
  chk_rel_err("//a/..", "")
  chk_rel_err("a.b/", "/a.b/b/a.b/.")
  chk_rel_err("///../a", "b////a.b")
  chk_rel_err(".../.", "/")
  chk_rel_err("/a/a/", ".../ab/a")
  chk_rel_err("//", "a.b")
  chk_rel_err("./é/é", "/")
  chk_rel_err("b/b/../a", "/")
  chk_rel_err("a.b", "/..")
  assert_eq rel("", "./a.b").unwrap, "a.b"
  assert_eq rel(Str.from_bytes([98, 47, 195, 169, 47, 254]), Str.from_bytes([254, 47, 46])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 254])
  chk_rel_err("", "/a.b/./a.b/..")
  chk_rel_err("/...", "b/a.b/é")
  assert_eq rel("/.", "/").unwrap, "."
  chk_rel_err("//é////a", "a///é")
  chk_rel_err("/", ".../a/")
  chk_rel_err("", "/./b")
  assert_eq rel(Str.from_bytes([195, 169, 47, 254, 47, 97, 46, 98, 47, 47]), "").unwrap, "../../.."
  assert_eq rel(Str.from_bytes([47, 47, 46, 47, 254, 47, 47, 47]), Str.from_bytes([47, 254, 47, 46, 46, 46])).unwrap, "..."
  assert_eq rel("ab/./", "a//").unwrap, "../a"
  assert_eq rel("/./b/../..", "//////b/").unwrap, "b"
  assert_eq rel(Str.from_bytes([46, 47, 46, 47, 254]), "").unwrap, ".."
  chk_rel_err("/a////a//", "a.b/é///")
  assert_eq rel("b", "../.../").unwrap, "../../..."
  chk_rel_err("b/b/b/ab", Str.from_bytes([47, 195, 169, 47, 195, 169, 47, 46, 47, 254]))
  chk_rel_err("////é/a.b", "b///..")
  assert_eq rel("ab///.../ab", "a/a.b/...").unwrap, "../../../a/a.b/..."
  assert_eq rel("/", "//").unwrap, "."
  assert_eq rel("/./a/./a.b/", "/.../../b/.").unwrap, "../../b"
  chk_rel_err("//", "a.b///ab/...")
  assert_eq rel(Str.from_bytes([254, 47, 47, 47, 97, 98]), Str.from_bytes([195, 169, 47, 47, 46, 46, 46, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 195, 169, 47, 46, 46, 46, 47, 254])
  assert_eq rel("a.b/", ".../////a/").unwrap, "../.../a"
  assert_eq rel("/a", "/..././//").unwrap, "../..."
  chk_rel_err("", "/a/ab/a/a.b/")
  assert_eq rel(Str.from_bytes([254, 47, 97, 98]), "").unwrap, "../.."
  chk_rel_err("", "/./é/a/ab")
  assert_eq rel("//", Str.from_bytes([47, 47, 47, 47, 254])).unwrap, Str.from_bytes([254])
  chk_rel_err("", "///")
  assert_eq rel("", ".//").unwrap, "."
  assert_eq rel("/", "/./b").unwrap, "b"
  assert_eq rel("", "a.b/é/ab").unwrap, "a.b/é/ab"
  chk_rel_err("/ab/../.", ".././//")
  chk_rel_err("//", "..")
  chk_rel_err(Str.from_bytes([46, 47, 46, 46, 46, 47, 254]), "//")
  chk_rel_err("//", "é/./")
  chk_rel_err("../b", "//../ab")
  assert_eq rel("./", "./a.b/./..").unwrap, "."
  assert_eq rel("b////a", ".../../a//").unwrap, "../../a"
  chk_rel_err("/", "ab/é/.////")
  chk_rel_err("..//ab///", "////é/a")
  assert_eq rel("", "a.b/a.b/b/a.b").unwrap, "a.b/a.b/b/a.b"
  chk_rel_err("//", Str.from_bytes([98, 47, 254, 47, 97, 47]))
  chk_rel_err("/ab/.", "../ab/")
  assert_eq rel("ab/é///", "ab///.../ab").unwrap, "../.../ab"
  chk_rel_err(Str.from_bytes([47, 47, 47, 98, 47, 254, 47]), Str.from_bytes([46, 47, 47, 47, 254, 47, 98]))
  assert_eq rel("///./a.b", "/.../").unwrap, "../..."
  chk_rel_err("/ab/é/../..", ".../../é")
  assert_eq rel(Str.from_bytes([254, 47, 195, 169, 47]), Str.from_bytes([254, 47, 97])).unwrap, "../a"
  chk_rel_err("..//é//", "/")
  assert_eq rel("ab/...//", "é").unwrap, "../../é"
  assert_eq rel("/./..///", "//é/é").unwrap, "é/é"
  assert_eq rel("//a///", "//é//").unwrap, "../é"
  assert_eq rel("", "./b").unwrap, "b"
  chk_rel_err("/./.", "ab/é/...")
  chk_rel_err("/a.b", Str.from_bytes([195, 169, 47, 254]))
  chk_rel_err("/.////", Str.from_bytes([97, 46, 98, 47, 46, 47, 254]))
  chk_rel_err("/...", "")
  chk_rel_err("/a/ab", "ab")
  chk_rel_err("a/.", "/ab/a.b/a")
  assert_eq rel("////a/", "///../a/a.b").unwrap, "a.b"
  chk_rel_err("", "//////...")
  assert_eq rel("", Str.from_bytes([254, 47, 195, 169, 47, 254, 47, 97, 46, 98, 47])).unwrap, Str.from_bytes([254, 47, 195, 169, 47, 254, 47, 97, 46, 98])
  chk_rel_err(Str.from_bytes([195, 169, 47, 254, 47, 46, 47]), "/..")
  chk_rel_err("/a/a///", ".../")
  assert_eq rel("/////é/../", "/é").unwrap, "é"
  chk_rel_err("a.b////", "/")
  chk_rel_err("/...//", "...///")
  chk_rel_err("b/é/é", "////é/")
  chk_rel_err("////a/a.b", "a.b/a")
  chk_rel_err("///", "")
  assert_eq rel("//", "/").unwrap, "."
  assert_eq rel("//.././é", "/a.b/../").unwrap, ".."
  chk_rel_err("//", "./ab/")
  assert_eq rel("///", "/a/.").unwrap, "a"
  chk_rel_err("..", "/a/a.b/")
  chk_rel_err("././a.b", "//ab")
  chk_rel_err("a.b///a///", "//////..//")
  chk_rel_err("", "///a.b/")
  chk_rel_err("/", "..//")
  assert_eq rel("/ab", "///é/é/.").unwrap, "../é/é"
  chk_rel_err("", "/./ab/b/b")
  assert_eq rel("/a.b", "/b").unwrap, "../b"
  chk_rel_err("/", "ab")
  chk_rel_err("////a.b/../..", Str.from_bytes([98, 47, 46, 46, 47, 254]))
}

test "rel 3" {
  assert_eq rel("é", "b/a.b").unwrap, "../b/a.b"
  assert_eq rel("", Str.from_bytes([254, 47, 97, 98])).unwrap, Str.from_bytes([254, 47, 97, 98])
  chk_rel_err("/./", "a")
  chk_rel_err("", "/a.b/b")
  assert_eq rel("/////", "//").unwrap, "."
  assert_eq rel(Str.from_bytes([254, 47, 98, 47, 195, 169, 47, 47, 47, 47]), "").unwrap, "../../.."
  chk_rel_err("a.b/é", Str.from_bytes([47, 97, 98, 47, 47, 47, 47, 47, 254, 47]))
  chk_rel_err("/./...", Str.from_bytes([254, 47, 195, 169, 47, 254]))
  assert_eq rel(".", "b").unwrap, "b"
  assert_eq rel("é///", "").unwrap, ".."
  assert_eq rel("é/a.b/", Str.from_bytes([46, 46, 47, 47, 254, 47, 46, 46])).unwrap, "../../.."
  chk_rel_err("", "/..//./")
  assert_eq rel(Str.from_bytes([254]), "../ab").unwrap, "../../ab"
  chk_rel_err("/.../..", ".../b/.../")
  chk_rel_err("/.../b///..", "b/.../a/..")
  chk_rel_err("", "/é///b")
  chk_rel_err("../..", Str.from_bytes([98, 47, 98, 47, 254]))
  assert_eq rel("/../", "//").unwrap, "."
  chk_rel_err("/.", Str.from_bytes([254, 47, 254, 47, 46, 46, 47]))
  assert_eq rel(".///", "b").unwrap, "b"
  chk_rel_err("...////", Str.from_bytes([47, 254]))
  chk_rel_err("/b/b/..", "a.b///b/ab")
  assert_eq rel("/./.../é/...", "/../ab////").unwrap, "../../../ab"
  assert_eq rel("", Str.from_bytes([97, 98, 47, 47, 47, 47, 97, 98, 47, 254])).unwrap, Str.from_bytes([97, 98, 47, 97, 98, 47, 254])
  chk_rel_err("..", "./")
  assert_eq rel("é", Str.from_bytes([254, 47, 195, 169, 47])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 195, 169])
  assert_eq rel(Str.from_bytes([46, 46, 46, 47, 254, 47, 97, 46, 98]), "a.b///").unwrap, "../../../a.b"
  assert_eq rel("", ".../").unwrap, "..."
  assert_eq rel(Str.from_bytes([254]), "é").unwrap, "../é"
  chk_rel_err("a///", "/ab/é")
  chk_rel_err("ab///...//", Str.from_bytes([47, 254, 47]))
  chk_rel_err(".", Str.from_bytes([47, 254, 47, 98]))
  assert_eq rel("/é/..", "//").unwrap, "."
  assert_eq rel("ab/..././///", ".../é//").unwrap, "../../.../é"
  assert_eq rel("/a///b", "/./...///").unwrap, "../../..."
  chk_rel_err("/./../..", "")
  assert_eq rel("a.b///.", "./").unwrap, ".."
  chk_rel_err("", Str.from_bytes([47, 46, 46, 47, 46, 46, 47, 254, 47]))
  assert_eq rel("/b//.", Str.from_bytes([47, 254, 47, 46, 46, 46])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 46, 46, 46])
  assert_eq rel("/...", "/").unwrap, ".."
  chk_rel_err("/é/a.b", "../..")
  assert_eq rel("////...", "////a.b").unwrap, "../a.b"
  chk_rel_err("/a///", ".////")
  assert_eq rel("a", "é").unwrap, "../é"
  assert_eq rel(Str.from_bytes([254, 47, 47, 47, 254, 47]), Str.from_bytes([46, 46, 46, 47, 254, 47, 97, 46, 98])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 46, 47, 254, 47, 97, 46, 98])
  chk_rel_err(Str.from_bytes([254]), "/")
  chk_rel_err("", "//")
  chk_rel_err(".", "/é/.")
  assert_eq rel("//a.b/a.b/..", Str.from_bytes([47, 46, 47, 195, 169, 47, 47, 47, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 195, 169, 47, 254])
  assert_eq rel("...////", Str.from_bytes([254, 47, 98])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 98])
  assert_eq rel("b/...", "").unwrap, "../.."
  chk_rel_err("é", "///.")
  chk_rel_err("..", "b/a.b")
  assert_eq rel(Str.from_bytes([47, 254]), "/a//a.b/").unwrap, "../a/a.b"
  assert_eq rel("a.b///b/ab", "").unwrap, "../../.."
  assert_eq rel("", ".../.").unwrap, "..."
  chk_rel_err("/", "a.b/ab")
  chk_rel_err("ab/.", "/")
  assert_eq rel("b/é/", "..///").unwrap, "../../.."
  chk_rel_err("/../a//é", Str.from_bytes([254, 47, 47, 47, 47, 47, 47]))
  assert_eq rel("", "a.b/..////").unwrap, "."
  assert_eq rel("/...", "/a.b/").unwrap, "../a.b"
  chk_rel_err("/", "é/")
  chk_rel_err("/ab/é/..", "b")
  chk_rel_err("/", ".../a.b/b/.")
  assert_eq rel("///a.b/a", "/").unwrap, "../.."
  assert_eq rel("b/./../a", "...").unwrap, "../..."
  chk_rel_err("/b", Str.from_bytes([254, 47, 46, 46, 46, 47, 254, 47, 47, 47]))
  assert_eq rel("a.b/ab////", "é/a.b").unwrap, "../../é/a.b"
  assert_eq rel("///a.b", "/").unwrap, ".."
  assert_eq rel("/", "///.").unwrap, "."
  chk_rel_err("é", "/")
  chk_rel_err(".././a", Str.from_bytes([46, 46, 46, 47, 254, 47, 97, 47, 46, 47]))
  chk_rel_err(".../b", "///a.b/./")
  chk_rel_err("/.///...", "../")
  assert_eq rel("b/a.b/ab//", Str.from_bytes([254, 47, 46, 47, 47, 47, 47, 46, 46, 46])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 254, 47, 46, 46, 46])
  assert_eq rel(Str.from_bytes([47, 47, 254, 47, 98]), "/").unwrap, "../.."
  chk_rel_err(Str.from_bytes([97, 98, 47, 254, 47, 97, 98, 47, 97, 98]), "////...////")
  assert_eq rel(Str.from_bytes([47, 46, 46, 46, 47, 254, 47, 195, 169, 47, 47]), "//////b/...").unwrap, "../../../b/..."
  chk_rel_err("///b/b", "é")
  assert_eq rel("b/", "a.b///a").unwrap, "../a.b/a"
  chk_rel_err("/", "./a.b")
  assert_eq rel("/", "/é/...///").unwrap, "é/..."
  chk_rel_err("./...///", "///../ab///")
  chk_rel_err("/...////ab/...", "a")
  chk_rel_err(Str.from_bytes([254, 47, 47, 47, 47, 97, 46, 98, 47, 47, 47]), "/ab/a.b")
  assert_eq rel("/a.b", "/").unwrap, ".."
  chk_rel_err("//", "")
  assert_eq rel("/", "/a/./.../").unwrap, "a/..."
  chk_rel_err("", "/..")
  assert_eq rel("", "é/../").unwrap, "."
  assert_eq rel("", ".////...//").unwrap, "..."
  assert_eq rel("/////é", "/").unwrap, ".."
  assert_eq rel("a", Str.from_bytes([97, 98, 47, 47, 47, 47, 98, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 97, 98, 47, 98, 47, 254])
  chk_rel_err("...", "/")
  assert_eq rel("/.../.../", "/").unwrap, "../.."
  assert_eq rel("/a/a.b/", "/.").unwrap, "../.."
  chk_rel_err(Str.from_bytes([254, 47, 47, 47, 47, 47]), "/")
  assert_eq rel("ab/b///", Str.from_bytes([254, 47, 47, 47, 97, 46, 98, 47, 46, 46])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 254])
  assert_eq rel("/.", Str.from_bytes([47, 47, 46, 46, 46, 47, 254])).unwrap, Str.from_bytes([46, 46, 46, 47, 254])
}

test "rel 4" {
  chk_rel_err("", "/ab/a")
  assert_eq rel("", "ab/...////").unwrap, "ab/..."
  chk_rel_err("/", "a/b/ab/..")
  chk_rel_err("b", "/é/.")
  chk_rel_err("/", "ab/.../")
  assert_eq rel("...", "a.b/..").unwrap, ".."
  assert_eq rel("", ".").unwrap, "."
  assert_eq rel(Str.from_bytes([97, 98, 47, 97, 47, 97, 47, 254]), "").unwrap, "../../../.."
  chk_rel_err("b/...", "/.././/ab")
  chk_rel_err("/", "a.b//a.b")
  assert_eq rel("é/b////..", "ab///").unwrap, "../ab"
  assert_eq rel(Str.from_bytes([254]), "a/é/a/b/").unwrap, "../a/é/a/b"
  chk_rel_err(Str.from_bytes([47, 254, 47, 195, 169, 47, 46]), "a.b")
  chk_rel_err("ab///", "/...//é")
  chk_rel_err("...", "/é/ab/.")
  assert_eq rel("/a/../b//", "/").unwrap, ".."
  assert_eq rel("///..", "//.//é").unwrap, "é"
  chk_rel_err("b/...", "/././.")
  assert_eq rel(Str.from_bytes([47, 195, 169, 47, 97, 98, 47, 254, 47]), "/.../...").unwrap, "../../../.../..."
  chk_rel_err("a/ab", Str.from_bytes([47, 98, 47, 254]))
  chk_rel_err(Str.from_bytes([254, 47, 98]), Str.from_bytes([47, 47, 47, 254, 47, 47, 47, 47, 254]))
  chk_rel_err("ab", Str.from_bytes([47, 46, 47, 254, 47, 98, 47, 254]))
  chk_rel_err("///..//", "")
  assert_eq rel("//", "/a.b").unwrap, "a.b"
  chk_rel_err("//", Str.from_bytes([97, 46, 98, 47, 254]))
  chk_rel_err("b", "/a//é/./")
  assert_eq rel("/a/a.b/é/", "/é/a/./a").unwrap, "../../../é/a/a"
  assert_eq rel("///./é", Str.from_bytes([47, 195, 169, 47, 98, 47, 254, 47])).unwrap, Str.from_bytes([98, 47, 254])
  assert_eq rel("/b", "/ab/b/é").unwrap, "../ab/b/é"
  assert_eq rel(Str.from_bytes([47, 47, 47, 254, 47, 98, 47]), "/a").unwrap, "../../a"
  assert_eq rel("/", "//.../").unwrap, "..."
  assert_eq rel("//.", "//").unwrap, "."
  assert_eq rel("a/.//", "a.b/../.../").unwrap, "../..."
  assert_eq rel(".../a/...", ".").unwrap, "../../.."
  assert_eq rel("/ab", "///").unwrap, ".."
  chk_rel_err("é", "//./a.b/...")
  chk_rel_err("a.b", "///é//")
  chk_rel_err("", "/./é/ab/a.b/")
  chk_rel_err("b/.///", "///////..///")
  assert_eq rel("/é/a", "//é//").unwrap, ".."
  assert_eq rel("./.", "").unwrap, "."
  chk_rel_err("é", "/a/..///")
  assert_eq rel(Str.from_bytes([47, 97, 46, 98, 47, 47, 47, 47, 254]), "///a").unwrap, "../../a"
  assert_eq rel("/a.b//a.b", Str.from_bytes([47, 254, 47, 195, 169, 47, 46, 46])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 254])
  assert_eq rel("/./a.b/a.b/a", "//...//").unwrap, "../../../..."
  assert_eq rel("a/.../...", "").unwrap, "../../.."
  chk_rel_err("a.b/b/../", "/b///a")
  assert_eq rel("///../", Str.from_bytes([47, 254])).unwrap, Str.from_bytes([254])
  assert_eq rel(Str.from_bytes([97, 98, 47, 46, 47, 254, 47, 46, 46, 46]), Str.from_bytes([46, 46, 47, 46, 47, 46, 46, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 46, 46, 47, 46, 46, 47, 254])
  chk_rel_err("//b/b/é", "...")
  assert_eq rel("/////", Str.from_bytes([47, 46, 47, 254])).unwrap, Str.from_bytes([254])
  chk_rel_err("a.b/b///b", "///a.b/")
  chk_rel_err("b/a.b//a.b", "/")
  assert_eq rel("b//////", "ab").unwrap, "../ab"
  chk_rel_err("..", "/é/")
  assert_eq rel("/b/é", "/").unwrap, "../.."
  assert_eq rel("/", "/../b").unwrap, "b"
  assert_eq rel("./ab", Str.from_bytes([254, 47, 254, 47, 46, 46, 47, 97, 98])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 97, 98])
  assert_eq rel("///a.b///", "/é/..").unwrap, ".."
  chk_rel_err("/", "a.b")
  assert_eq rel("", "a/...///b").unwrap, "a/.../b"
  assert_eq rel("/.././a/", "//").unwrap, ".."
  assert_eq rel("/a/b/a.b", "/..").unwrap, "../../.."
  chk_rel_err("..////b/.", "/")
  assert_eq rel("/../../..", "/a.b/.../..").unwrap, "a.b"
  chk_rel_err("é/a.b/...", "/b/")
  assert_eq rel(Str.from_bytes([254, 47, 97, 46, 98]), "").unwrap, "../.."
  chk_rel_err("../..", "b")
  chk_rel_err(Str.from_bytes([47, 254]), "..")
  assert_eq rel("///////", "/").unwrap, "."
  chk_rel_err("/ab", "a.b/a/...")
  assert_eq rel("", "../...").unwrap, "../..."
  assert_eq rel(Str.from_bytes([47, 97, 47, 254, 47, 97, 98, 47, 46]), Str.from_bytes([47, 254, 47, 98, 47, 47, 97, 46, 98])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 254, 47, 98, 47, 97, 46, 98])
  assert_eq rel("///////", Str.from_bytes([47, 98, 47, 46, 47, 47, 254])).unwrap, Str.from_bytes([98, 47, 254])
  chk_rel_err("a", "////")
  chk_rel_err(Str.from_bytes([47, 47, 47, 47, 46, 47, 47, 47, 47, 254]), "...")
  chk_rel_err("ab/", "/")
  chk_rel_err(Str.from_bytes([254, 47, 98, 47, 195, 169]), "/a.b")
  chk_rel_err("/", "...////é")
  assert_eq rel("/", "//./b").unwrap, "b"
  chk_rel_err("//.///a", "")
  assert_eq rel("./.", Str.from_bytes([254])).unwrap, Str.from_bytes([254])
  chk_rel_err("../..////", "././/")
  chk_rel_err("ab/a.b", "/../")
  assert_eq rel("/./ab/é/é", "/").unwrap, "../../.."
  chk_rel_err("/../a.b/é/a", "b/é")
  assert_eq rel(Str.from_bytes([46, 47, 254, 47]), Str.from_bytes([254])).unwrap, "."
  chk_rel_err("a", "/b/a")
  assert_eq rel(Str.from_bytes([195, 169, 47, 46, 46, 46, 47, 254, 47, 97, 98]), "b").unwrap, "../../../../b"
  chk_rel_err("é/a", "//////...")
  assert_eq rel("/./../b/é", "//").unwrap, "../.."
  chk_rel_err("/.../é/", "a/..")
  chk_rel_err("a.b/é/..", "/b/a///")
  chk_rel_err("/../...", "a/../..")
  chk_rel_err("/a/a/", ".///////")
  assert_eq rel("/é/..", "/é/a/").unwrap, "é/a"
  assert_eq rel("a.b////a.b/b", Str.from_bytes([97, 47, 46, 46, 46, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 97, 47, 46, 46, 46, 47, 254])
  chk_rel_err("/.../.../", "")
  chk_rel_err("a.b/a.b/./..", "/ab/ab/ab")
  assert_eq rel("/a.b", Str.from_bytes([47, 254, 47, 97, 46, 98, 47, 47])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 97, 46, 98])
}

test "rel 5" {
  chk_rel_err("", "////")
  chk_rel_err("a////../...", "//é/a//")
  chk_rel_err("a.b", "/a.b///")
  assert_eq rel("a.b", "é//é/a").unwrap, "../é/é/a"
  assert_eq rel("./ab/.../", "ab/...").unwrap, "."
  assert_eq rel("ab/../ab", "../a.b/a").unwrap, "../../a.b/a"
  chk_rel_err("///a.b/.../b", "...//ab/é")
  assert_eq rel("/", "/.").unwrap, "."
  assert_eq rel(Str.from_bytes([47, 47, 47, 47, 47, 97, 98, 47, 254]), "/é//.../ab").unwrap, "../../é/.../ab"
  chk_rel_err("/", Str.from_bytes([254, 47, 97, 46, 98, 47, 98]))
  chk_rel_err("./a.b/é", "/..")
  chk_rel_err("/.../////a", "./a")
  assert_eq rel("/", "/.../../é").unwrap, "é"
  assert_eq rel("", "a.b/./a.b").unwrap, "a.b/a.b"
  chk_rel_err("/a.b/", Str.from_bytes([195, 169, 47, 254, 47, 47, 47, 195, 169]))
  assert_eq rel("//", "/é/...").unwrap, "é/..."
  chk_rel_err("a.b/ab", "/")
  chk_rel_err(".", "/é/a/../.../")
  chk_rel_err("/", Str.from_bytes([254, 47, 46, 46]))
  assert_eq rel("", ".../a.b").unwrap, ".../a.b"
  assert_eq rel("/", "/é///ab/a/").unwrap, "é/ab/a"
  chk_rel_err(Str.from_bytes([97, 46, 98, 47, 98, 47, 254, 47, 195, 169]), "/./...")
  assert_eq rel("/a", "//b").unwrap, "../b"
  chk_rel_err("a////..////", "//a.b")
  assert_eq rel("/é/b/ab/ab/", "///").unwrap, "../../../.."
  assert_eq rel("/../", "/a/a/../a").unwrap, "a/a"
  assert_eq rel("/ab/.../...///", "//").unwrap, "../../.."
  assert_eq rel("///b///.", Str.from_bytes([47, 46, 46, 47, 46, 46, 46, 47, 97, 98, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 46, 47, 97, 98, 47, 254])
  chk_rel_err("a/./", "/ab/a/ab/a.b")
  assert_eq rel("", "a.b/").unwrap, "a.b"
  assert_eq rel("///../", "/").unwrap, "."
  assert_eq rel("a.b/...//ab", "").unwrap, "../../.."
  assert_eq rel("é/é", "").unwrap, "../.."
  chk_rel_err("a.b/", "////")
  chk_rel_err("../", "a/a.b")
  chk_rel_err("é/ab/ab//", "//")
  chk_rel_err("...", "//b/b/")
  assert_eq rel("/", "/a.b/..").unwrap, "."
  chk_rel_err("ab/.", Str.from_bytes([47, 254, 47, 195, 169, 47, 98]))
  assert_eq rel("a.b////é/..", "").unwrap, ".."
  chk_rel_err("ab/.../..", "/")
  assert_eq rel("/b/é/a.b/ab", "////a/é/..").unwrap, "../../../../a"
  chk_rel_err("ab///", "//")
  assert_eq rel("ab/a.b/.", "é/.../a.b").unwrap, "../../é/.../a.b"
  assert_eq rel("/b/.../.", "/////").unwrap, "../.."
  chk_rel_err(Str.from_bytes([195, 169, 47, 254, 47, 97, 98]), "/")
  chk_rel_err("/", Str.from_bytes([97, 46, 98, 47, 97, 46, 98, 47, 254]))
  assert_eq rel(Str.from_bytes([97, 47, 254, 47, 97, 98, 47, 254]), "ab/").unwrap, "../../../../ab"
  chk_rel_err("..", Str.from_bytes([46, 46, 46, 47, 254]))
  assert_eq rel("ab/./ab", "").unwrap, "../.."
  chk_rel_err("/./", "é///ab/é")
  chk_rel_err("a.b//", "/.../é")
  chk_rel_err("..", "/../ab")
  chk_rel_err("./../../a.b", "///a.b")
  assert_eq rel("a.b", "a.b/é///").unwrap, "é"
  chk_rel_err("/ab/ab/...", Str.from_bytes([254, 47, 254]))
  chk_rel_err(Str.from_bytes([47, 254, 47, 195, 169, 47, 47, 47, 47, 47, 47]), "a.b/")
  assert_eq rel("..///", "../").unwrap, "."
  assert_eq rel(Str.from_bytes([195, 169, 47, 254, 47]), "").unwrap, "../.."
  chk_rel_err("ab/é///", Str.from_bytes([47, 46, 46, 47, 97, 46, 98, 47, 254]))
  assert_eq rel("", Str.from_bytes([97, 47, 254, 47, 98])).unwrap, Str.from_bytes([97, 47, 254, 47, 98])
  chk_rel_err("", "/.")
  assert_eq rel("", Str.from_bytes([46, 46, 47, 254, 47, 46, 47])).unwrap, Str.from_bytes([46, 46, 47, 254])
  chk_rel_err("/.../.../", ".")
  chk_rel_err(Str.from_bytes([97, 46, 98, 47, 254]), "///")
  assert_eq rel("é/./a.b/", "").unwrap, "../.."
  chk_rel_err("./.", "//")
  assert_eq rel("...", "b/").unwrap, "../b"
  assert_eq rel(".////a.b", "a.b//").unwrap, "."
  assert_eq rel(Str.from_bytes([46, 47, 97, 98, 47, 254, 47, 46, 46, 46]), "../ab").unwrap, "../../../../ab"
  assert_eq rel(".///a/...", "é////./...").unwrap, "../../é/..."
  chk_rel_err("../../a.b", "/")
  assert_eq rel("/", Str.from_bytes([47, 97, 47, 46, 47, 97, 47, 254])).unwrap, Str.from_bytes([97, 47, 97, 47, 254])
  chk_rel_err("ab/..", Str.from_bytes([47, 97, 47, 254, 47]))
  assert_eq rel("/a//ab/é", "/é/ab").unwrap, "../../../é/ab"
  chk_rel_err("////é", "a.b")
  assert_eq rel("ab", "").unwrap, ".."
  assert_eq rel("./.../a", "é///").unwrap, "../../é"
  chk_rel_err("é//.../b", Str.from_bytes([47, 254, 47]))
  chk_rel_err("a.b/../", "//a.b")
  assert_eq rel("b", "ab").unwrap, "../ab"
  assert_eq rel("/..././a.b/.", "/.").unwrap, "../.."
  chk_rel_err("/b//", ".../a/")
  chk_rel_err("../b", "/./b/ab/.")
  chk_rel_err("ab//a.b", "/a/b/../.")
  assert_eq rel("/", "/b/a.b///...").unwrap, "b/a.b/..."
  chk_rel_err("ab/é", "/.../ab")
  chk_rel_err("/./a", "b")
  assert_eq rel(".../a.b/é/a.b", "../b////").unwrap, "../../../../../b"
  assert_eq rel("/../b/..././", "/a.b/.///").unwrap, "../../a.b"
  assert_eq rel("/", "////").unwrap, "."
  assert_eq rel("///...", "//é/../é").unwrap, "../é"
  chk_rel_err("", "/ab")
  chk_rel_err(".../.../", "/")
  assert_eq rel("b", Str.from_bytes([254, 47, 47, 46, 46, 46])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 46, 46, 46])
  chk_rel_err("/ab/////a", "b/..")
  chk_rel_err("", "/../a///")
  assert_eq rel("/./..", "/b/ab/").unwrap, "b/ab"
  assert_eq rel("///a.b/a.b", "/").unwrap, "../.."
  assert_eq rel("/b//", "/a.b/ab/...").unwrap, "../a.b/ab/..."
}

test "rel 6" {
  chk_rel_err("//.../ab///", "a")
  assert_eq rel("/", "/a/a/./a.b").unwrap, "a/a/a.b"
  chk_rel_err("../", "")
  chk_rel_err(Str.from_bytes([47, 97, 47, 47, 254, 47, 195, 169]), "a.b")
  assert_eq rel("b", "ab/ab/.../.").unwrap, "../ab/ab/..."
  chk_rel_err("é/ab/.", "/./")
  chk_rel_err(Str.from_bytes([254]), "/a")
  assert_eq rel("//ab/a/..", "/b/").unwrap, "../b"
  assert_eq rel(Str.from_bytes([254, 47, 46, 46, 46, 47, 97, 46, 98]), "ab/").unwrap, "../../../ab"
  chk_rel_err("/", Str.from_bytes([97, 98, 47, 254, 47]))
  assert_eq rel("", "a/b/a").unwrap, "a/b/a"
  assert_eq rel("/..", "/.").unwrap, "."
  chk_rel_err("//ab/./a", ".../////é/")
  assert_eq rel("///..", "/./.../.").unwrap, "..."
  chk_rel_err("é/b", "/")
  chk_rel_err("a//", "/")
  assert_eq rel("a.b/.///", ".").unwrap, ".."
  chk_rel_err("/", "é/a.b//a/")
  chk_rel_err("///./...", Str.from_bytes([254, 47, 46]))
  chk_rel_err(Str.from_bytes([46, 46, 47, 254, 47, 97, 98, 47, 97]), Str.from_bytes([97, 47, 47, 47, 47, 254]))
  chk_rel_err("//", Str.from_bytes([254, 47, 47, 47, 47, 195, 169, 47]))
  assert_eq rel("ab/a/ab", "./b/b").unwrap, "../../../b/b"
  assert_eq rel("/a.b/a", "/b").unwrap, "../../b"
  chk_rel_err(Str.from_bytes([46, 46, 47, 97, 46, 98, 47, 98, 47, 254]), Str.from_bytes([46, 47, 254]))
  chk_rel_err("...//b/é", "/b///")
  assert_eq rel("", Str.from_bytes([254, 47, 46])).unwrap, Str.from_bytes([254])
  assert_eq rel("", "../.../b/ab").unwrap, "../.../b/ab"
  assert_eq rel("", "a/...//é/").unwrap, "a/.../é"
  chk_rel_err("///a.b/../", "a.b/")
  assert_eq rel("a/.../a.b/", ".../b////").unwrap, "../../../.../b"
  assert_eq rel("././a//", "a.b/./a.b/b").unwrap, "../a.b/a.b/b"
  chk_rel_err("", "//é/b/")
  assert_eq rel(".../", "").unwrap, ".."
  assert_eq rel("/", "//a.b/../.").unwrap, "."
  chk_rel_err(Str.from_bytes([47, 97, 46, 98, 47, 46, 46, 46, 47, 254]), "b/a/.")
  chk_rel_err("a.b///", "///.")
  chk_rel_err("../..", Str.from_bytes([46, 46, 46, 47, 254, 47, 47, 46, 46, 46]))
  chk_rel_err("a", "///../b")
  chk_rel_err("é///", "/a.b")
  chk_rel_err("//a.b/...///", "./b/")
  assert_eq rel("//.../b", "/").unwrap, "../.."
  chk_rel_err("/.//...", "ab")
  assert_eq rel("a", "a.b/..////ab").unwrap, "../ab"
  assert_eq rel("", Str.from_bytes([254, 47, 254, 47, 46, 46, 46])).unwrap, Str.from_bytes([254, 47, 254, 47, 46, 46, 46])
  chk_rel_err("..///", "////")
  assert_eq rel("a.b/b/a.b", "").unwrap, "../../.."
  chk_rel_err("///////é/b/", "")
  assert_eq rel("é/a////", "a.b/a").unwrap, "../../a.b/a"
  assert_eq rel("/a.b/...", "/./ab").unwrap, "../../ab"
  chk_rel_err("././/////", "///")
  assert_eq rel("", "././//..").unwrap, ".."
  assert_eq rel("/", "/é/../ab//").unwrap, "ab"
  chk_rel_err("/", ".../a/é")
  chk_rel_err(Str.from_bytes([254, 47, 46]), "/...")
  chk_rel_err("", Str.from_bytes([47, 254, 47, 46, 46, 46, 47, 97, 98]))
  chk_rel_err("//", "ab/...////")
  chk_rel_err("..", "/...")
  chk_rel_err("/", Str.from_bytes([254, 47, 98, 47, 98]))
  assert_eq rel(Str.from_bytes([254]), Str.from_bytes([254])).unwrap, "."
  chk_rel_err("/////.../", "b/b")
  chk_rel_err(".", "/")
  chk_rel_err("a.b//./", "/")
  assert_eq rel("/.//b", Str.from_bytes([47, 254, 47, 195, 169, 47])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 195, 169])
  assert_eq rel(Str.from_bytes([254, 47, 46, 46, 47]), ".../é/..").unwrap, "..."
  chk_rel_err("é", "///a.b///")
  assert_eq rel("/../...", "/./b").unwrap, "../b"
  chk_rel_err("//..", "")
  assert_eq rel("/", "/.///").unwrap, "."
  assert_eq rel(Str.from_bytes([47, 254, 47, 47, 47, 47, 97, 46, 98]), "/").unwrap, "../.."
  assert_eq rel("./ab/./...", "é////ab/").unwrap, "../../é/ab"
  assert_eq rel("", Str.from_bytes([254, 47, 97, 98, 47, 46, 46, 46])).unwrap, Str.from_bytes([254, 47, 97, 98, 47, 46, 46, 46])
  assert_eq rel("/a.b/..", "/").unwrap, "."
  chk_rel_err("", "/é/a///ab")
  chk_rel_err("/...//", "..")
  chk_rel_err(Str.from_bytes([254, 47, 46, 46, 46, 47, 97]), "/a/.../é/ab")
  assert_eq rel("b", Str.from_bytes([254, 47, 47, 47, 47, 46, 47, 97, 46, 98])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 97, 46, 98])
  assert_eq rel(Str.from_bytes([97, 98, 47, 97, 46, 98, 47, 46, 46, 47, 254]), "").unwrap, "../.."
  assert_eq rel("b/a/../é/", "").unwrap, "../.."
  assert_eq rel("b/.../é", Str.from_bytes([254])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 254])
  assert_eq rel("//.../a", "/../").unwrap, "../.."
  assert_eq rel("/", "/b/é/.").unwrap, "b/é"
  assert_eq rel("//./.../...", "/a").unwrap, "../../a"
  assert_eq rel("////.", "/.././///").unwrap, "."
  chk_rel_err("/", ".../a.b/ab")
  chk_rel_err("/a.b//...//", "")
  assert_eq rel("/", "/ab/ab").unwrap, "ab/ab"
  chk_rel_err(Str.from_bytes([97, 47, 47, 47, 47, 254]), "/")
  chk_rel_err(Str.from_bytes([47, 254, 47, 46, 46]), "b/..")
  chk_rel_err(".///", "/")
  assert_eq rel("/", Str.from_bytes([47, 46, 46, 46, 47, 254, 47, 195, 169, 47, 46, 47])).unwrap, Str.from_bytes([46, 46, 46, 47, 254, 47, 195, 169])
  chk_rel_err("b/a//", "/ab/b/a/")
  chk_rel_err(Str.from_bytes([47, 254, 47, 97, 46, 98, 47]), Str.from_bytes([46, 46, 46, 47, 254]))
  assert_eq rel("/ab/", "/../../a.b").unwrap, "../a.b"
  chk_rel_err("/./a.b/...//", "a/./b///")
  assert_eq rel("/", Str.from_bytes([47, 254, 47, 47])).unwrap, Str.from_bytes([254])
  assert_eq rel("ab/../é/ab", Str.from_bytes([254, 47, 46, 46, 46, 47, 97, 98, 47, 98])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 254, 47, 46, 46, 46, 47, 97, 98, 47, 98])
  assert_eq rel("a.b", "é////...").unwrap, "../é/..."
  assert_eq rel(Str.from_bytes([97, 46, 98, 47, 47, 47, 254, 47]), "a.b/...").unwrap, "../..."
  chk_rel_err("../é//", "/../é//")
  chk_rel_err(Str.from_bytes([47, 254]), "...///a.b/")
}

test "rel 7" {
  assert_eq rel("ab", Str.from_bytes([97, 98, 47, 97, 46, 98, 47, 47, 47, 47, 254, 47])).unwrap, Str.from_bytes([97, 46, 98, 47, 254])
  chk_rel_err(Str.from_bytes([46, 47, 46, 46, 47, 98, 47, 254, 47]), "b")
  assert_eq rel("/", "/b").unwrap, "b"
  chk_rel_err("../.../", "")
  chk_rel_err("/", ".////")
  chk_rel_err("//.", Str.from_bytes([97, 98, 47, 195, 169, 47, 254, 47]))
  chk_rel_err("a.b/ab////b", "/a.b")
  chk_rel_err("/", "../")
  assert_eq rel("////..", Str.from_bytes([47, 97, 46, 98, 47, 98, 47, 254])).unwrap, Str.from_bytes([97, 46, 98, 47, 98, 47, 254])
  chk_rel_err("", "/../.../../b")
  assert_eq rel(Str.from_bytes([254, 47]), "b/a").unwrap, "../b/a"
  assert_eq rel("/ab", "/ab/.").unwrap, "."
  chk_rel_err("/./", "a.b")
  assert_eq rel("////", "/a").unwrap, "a"
  chk_rel_err("b/...///", "////../")
  chk_rel_err("a.b/..", "/b/a/é")
  assert_eq rel("//./", "/a/.///.../").unwrap, "a/..."
  assert_eq rel("/../..//ab", "/").unwrap, ".."
  assert_eq rel(".", Str.from_bytes([254, 47, 46, 46, 46, 47, 46, 46, 46, 47, 97, 46, 98])).unwrap, Str.from_bytes([254, 47, 46, 46, 46, 47, 46, 46, 46, 47, 97, 46, 98])
  chk_rel_err(Str.from_bytes([254, 47, 97, 46, 98]), "/a/b////b")
  assert_eq rel("//", "//ab/././").unwrap, "ab"
  chk_rel_err("/./ab/.../a", Str.from_bytes([254]))
  assert_eq rel("é/..", Str.from_bytes([195, 169, 47, 254, 47, 46, 47, 97, 98])).unwrap, Str.from_bytes([195, 169, 47, 254, 47, 97, 98])
  assert_eq rel(Str.from_bytes([47, 47, 47, 195, 169, 47, 254, 47, 47]), "//a").unwrap, "../../a"
  chk_rel_err("..", "")
  assert_eq rel("é/../...", Str.from_bytes([254, 47, 97, 98])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 97, 98])
  assert_eq rel("/a.b//é/.../", "//").unwrap, "../../.."
  chk_rel_err(Str.from_bytes([46, 46, 46, 47, 47, 47, 47, 97, 46, 98, 47, 254]), Str.from_bytes([47, 47, 47, 254, 47, 97, 46, 98]))
  assert_eq rel("/a.b/é/a.b/a", "/é///////...").unwrap, "../../../../é/..."
  assert_eq rel("", "b/.../.").unwrap, "b/..."
  chk_rel_err("/ab///../é", "")
  assert_eq rel(".", "../ab/ab").unwrap, "../ab/ab"
  chk_rel_err(Str.from_bytes([47, 47, 47, 195, 169, 47, 254]), "")
  assert_eq rel("a.b", "../é/b").unwrap, "../../é/b"
  chk_rel_err("///é/é///", "ab/../.")
  assert_eq rel("ab/./", "a.b//").unwrap, "../a.b"
  chk_rel_err("ab////", "/////a.b")
  assert_eq rel("b/ab/a/.", "...").unwrap, "../../../..."
  assert_eq rel("a/", "ab").unwrap, "../ab"
  assert_eq rel("/../b/a.b/", "////a.b/./é").unwrap, "../../a.b/é"
  assert_eq rel(Str.from_bytes([254, 47, 97, 46, 98, 47, 47]), "../a/.../").unwrap, "../../../a/..."
  assert_eq rel("//b", "//...//é").unwrap, "../.../é"
  chk_rel_err("////./ab", "./a.b/a.b/")
  chk_rel_err(Str.from_bytes([195, 169, 47, 254, 47, 97, 98]), "/é////")
  chk_rel_err("//", "é/a.b")
  assert_eq rel("///a.b/ab", Str.from_bytes([47, 47, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 254])
  assert_eq rel("", "a///").unwrap, "a"
  chk_rel_err("////a.b", "")
  chk_rel_err("./ab/a.b///", "////")
  assert_eq rel("a.b/a.b///", "a/b/ab").unwrap, "../../a/b/ab"
  assert_eq rel(Str.from_bytes([47, 254, 47, 97, 98, 47, 98, 47, 46, 46]), "/").unwrap, "../.."
  chk_rel_err("//a/b/", "a.b")
  assert_eq rel("", "./").unwrap, "."
  assert_eq rel("a.b", "..").unwrap, "../.."
  chk_rel_err(Str.from_bytes([254, 47, 46, 46, 47, 47, 46, 46, 46]), "///")
  assert_eq rel("//b/", "/a.b/..").unwrap, ".."
  chk_rel_err("/ab/ab", "a")
  chk_rel_err("./", Str.from_bytes([47, 254, 47, 46, 46, 46, 47, 98]))
  assert_eq rel("/", "/é////a/").unwrap, "é/a"
  assert_eq rel(".../../a/", "").unwrap, ".."
  assert_eq rel("/ab", "/.../.../b").unwrap, "../.../.../b"
  assert_eq rel("b/..////.", Str.from_bytes([254, 47, 97])).unwrap, Str.from_bytes([254, 47, 97])
  chk_rel_err(Str.from_bytes([47, 46, 46, 47, 195, 169, 47, 46, 46, 46, 47, 254]), "a.b/a.b")
  chk_rel_err("", "/b/./..")
  chk_rel_err("/a/a", Str.from_bytes([254, 47]))
  chk_rel_err("/.////////", "..")
  assert_eq rel("a.b/b/", "a/").unwrap, "../../a"
  assert_eq rel("/", "///..///").unwrap, "."
  assert_eq rel("b/", Str.from_bytes([254, 47, 47, 47, 47, 46, 46])).unwrap, ".."
  chk_rel_err(Str.from_bytes([47, 254, 47, 47, 46]), "ab/ab/a")
  chk_rel_err("/ab/", "./...//")
  assert_eq rel("/..", "/").unwrap, "."
  assert_eq rel("/a/a.b", "/é/a").unwrap, "../../é/a"
  assert_eq rel("", "a.b/é/.").unwrap, "a.b/é"
  assert_eq rel("é////", "é/.../a.b///").unwrap, ".../a.b"
  chk_rel_err("/", ".../a.b")
  assert_eq rel(Str.from_bytes([254, 47, 46, 46, 47, 98]), "a").unwrap, "../a"
  chk_rel_err("", "/../.../é/é")
  chk_rel_err("//ab/b", "...//")
  assert_eq rel("/../a/é", "///.../a/ab").unwrap, "../../.../a/ab"
  chk_rel_err("../a.b", ".//.")
  assert_eq rel("a.b/é", "").unwrap, "../.."
  assert_eq rel(Str.from_bytes([47, 254, 47, 46, 46, 47, 97, 46, 98]), "/.../a///b").unwrap, "../.../a/b"
  assert_eq rel(Str.from_bytes([254, 47, 46, 46, 46, 47, 46, 46, 47, 46, 46, 46, 47]), "ab/.////é").unwrap, "../../ab/é"
  chk_rel_err("", "/.///é/.")
  chk_rel_err("/ab", ".../a")
  chk_rel_err("", "/...")
  chk_rel_err("b/é", "/")
  assert_eq rel("/.////a.b", "/ab").unwrap, "../ab"
  chk_rel_err("/", "a.b////")
  chk_rel_err("////b///", ".../")
  chk_rel_err("/", Str.from_bytes([254, 47, 97, 98]))
  chk_rel_err("..", "a/.../a/")
  chk_rel_err("/.../b", "")
  chk_rel_err(Str.from_bytes([97, 98, 47, 254]), "/")
  chk_rel_err(Str.from_bytes([47, 195, 169, 47, 254]), "ab//ab")
  assert_eq rel("/ab/./...", Str.from_bytes([47, 254, 47, 47, 47])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 254])
  assert_eq rel(Str.from_bytes([47, 47, 195, 169, 47, 47, 47, 254]), "//../../").unwrap, "../.."
  assert_eq rel("/../", "/").unwrap, "."
  assert_eq rel("", Str.from_bytes([97, 47, 254, 47])).unwrap, Str.from_bytes([97, 47, 254])
}

test "rel 8" {
  assert_eq rel("/b/ab/.", "//.../").unwrap, "../../..."
  assert_eq rel(".", "b/b/a.b///").unwrap, "b/b/a.b"
  chk_rel_err("/.../b/", Str.from_bytes([97, 47, 254, 47, 195, 169, 47]))
  chk_rel_err(Str.from_bytes([254, 47, 97, 98, 47, 46, 46, 46]), "/ab////a.b/")
  chk_rel_err("///.../a.b", "")
  chk_rel_err("a/./a/...", "/./ab/")
  assert_eq rel(Str.from_bytes([47, 254, 47, 47, 97, 98, 47, 98]), "////////.../").unwrap, "../../../..."
  chk_rel_err("//", "./a.b/a")
  chk_rel_err("ab/a/b", "//")
  assert_eq rel("///", "///ab").unwrap, "ab"
  assert_eq rel(Str.from_bytes([47, 254, 47, 47, 47, 47, 46, 46, 47]), Str.from_bytes([47, 254])).unwrap, Str.from_bytes([254])
  assert_eq rel("/ab/..////", "/").unwrap, "."
  assert_eq rel(".../ab/b/a", "").unwrap, "../../../.."
  assert_eq rel("", Str.from_bytes([97, 46, 98, 47, 97, 46, 98, 47, 254, 47, 97])).unwrap, Str.from_bytes([97, 46, 98, 47, 97, 46, 98, 47, 254, 47, 97])
  assert_eq rel("/a////", "/é/b/é").unwrap, "../é/b/é"
  assert_eq rel("ab/../a/", "ab").unwrap, "../ab"
  chk_rel_err("é/é/", "//")
  assert_eq rel("ab/", "").unwrap, ".."
  chk_rel_err(".../", "//../a")
  chk_rel_err(Str.from_bytes([254, 47, 46, 46, 47, 46, 46]), "/../")
  assert_eq rel("", "../b").unwrap, "../b"
  chk_rel_err("/a.b/é/", Str.from_bytes([98, 47, 254, 47, 47]))
  chk_rel_err("/b///", Str.from_bytes([97, 47, 46, 46, 47, 254, 47, 254]))
  chk_rel_err("//...", "..")
  chk_rel_err(".../é", "/")
  assert_eq rel("", "ab/b/b").unwrap, "ab/b/b"
  assert_eq rel(Str.from_bytes([97, 46, 98, 47, 254]), "b/.../..").unwrap, "../../b"
  chk_rel_err(Str.from_bytes([47, 97, 47, 97, 46, 98, 47, 97, 47, 254]), "")
  assert_eq rel(Str.from_bytes([254, 47, 46, 46, 46, 47, 46, 46, 47, 46, 46, 47]), "").unwrap, "."
  assert_eq rel("/", "/.../").unwrap, "..."
  assert_eq rel(".", "../ab/b/.../").unwrap, "../ab/b/..."
  chk_rel_err("../a///./", "//")
  assert_eq rel("b/a.b/", "").unwrap, "../.."
  chk_rel_err("../a", "a")
  assert_eq rel("//", Str.from_bytes([47, 47, 47, 254])).unwrap, Str.from_bytes([254])
  chk_rel_err("é/.../../a", "/")
  assert_eq rel(Str.from_bytes([47, 97, 47, 46, 46, 46, 47, 98, 47, 254]), "/a.b///").unwrap, "../../../../a.b"
  assert_eq rel("/", Str.from_bytes([47, 47, 98, 47, 254])).unwrap, Str.from_bytes([98, 47, 254])
  chk_rel_err("//////é/", "ab")
  assert_eq rel("é/a.b/", "ab/b/.../").unwrap, "../../ab/b/..."
  assert_eq rel("/", "/b/a.b/a/").unwrap, "b/a.b/a"
  chk_rel_err("///a////", "")
  chk_rel_err("/", "../...")
  assert_eq rel("", "b").unwrap, "b"
  chk_rel_err("/b/a.b////", "b/../a.b/")
  chk_rel_err("//", "b/a")
  assert_eq rel("ab/...", "").unwrap, "../.."
  chk_rel_err(Str.from_bytes([254, 47, 97, 47, 46, 46, 46]), "/é/ab")
  assert_eq rel("ab/é/", "").unwrap, "../.."
  chk_rel_err("/b/", "")
  chk_rel_err("/.../", "...")
  chk_rel_err("///", "./..././.")
  chk_rel_err("/./ab/////", "a.b/b////")
  assert_eq rel("b///b/b/", "../b").unwrap, "../../../../b"
  assert_eq rel(Str.from_bytes([47, 254]), "/a.b").unwrap, "../a.b"
  assert_eq rel("/b//////", "////.").unwrap, ".."
  chk_rel_err("/.../../..", "ab/ab/a.b/..")
  chk_rel_err("/é///", "a/a.b/b/")
  assert_eq rel("///ab", "/...").unwrap, "../..."
  assert_eq rel("", Str.from_bytes([46, 46, 47, 254, 47, 47, 47, 98])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 98])
  assert_eq rel(Str.from_bytes([47, 47, 254]), "/").unwrap, ".."
  assert_eq rel("/", "///a.b/b/").unwrap, "a.b/b"
  assert_eq rel("///a/a", "///b/ab").unwrap, "../../b/ab"
  chk_rel_err("a.b/ab////b", "///")
  chk_rel_err(".../b/", "/")
  chk_rel_err("a/", "///b///ab")
  chk_rel_err("//ab/ab", "ab////é")
  chk_rel_err(Str.from_bytes([47, 254]), "ab/b/b")
  assert_eq rel("./", Str.from_bytes([254, 47, 46, 46, 47, 195, 169])).unwrap, "é"
  assert_eq rel("/b/..", "/").unwrap, "."
  chk_rel_err(Str.from_bytes([47, 47, 254]), "ab/a/é")
  assert_eq rel("///a.b", "/b/").unwrap, "../b"
  assert_eq rel("...", "").unwrap, ".."
  assert_eq rel("/", "////a/b/../").unwrap, "a"
  assert_eq rel(Str.from_bytes([47, 254, 47, 46, 46, 46]), "/a/a.b").unwrap, "../../a/a.b"
  assert_eq rel("é/b/é/.", "a.b").unwrap, "../../../a.b"
  chk_rel_err(Str.from_bytes([47, 254, 47, 195, 169, 47, 47]), Str.from_bytes([46, 46, 46, 47, 254, 47, 46, 46, 47, 47, 47, 47]))
  chk_rel_err("a.b/..", "//...")
  assert_eq rel("/", Str.from_bytes([47, 97, 98, 47, 254, 47, 254, 47, 46, 46, 46])).unwrap, Str.from_bytes([97, 98, 47, 254, 47, 254, 47, 46, 46, 46])
  chk_rel_err("../ab/", "")
  chk_rel_err("..////a.b/..", "/../a.b")
  assert_eq rel("a/ab", "a.b/../a/é/").unwrap, "../é"
  chk_rel_err(Str.from_bytes([254, 47, 47, 47, 47, 47]), "//")
  assert_eq rel("a.b/...////é", Str.from_bytes([97, 98, 47, 254, 47, 97, 46, 98])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 97, 98, 47, 254, 47, 97, 46, 98])
  assert_eq rel("/.../.././", "/").unwrap, "."
  assert_eq rel(Str.from_bytes([254, 47, 46, 46]), "b/ab").unwrap, "b/ab"
  chk_rel_err("", "///a.b/a")
  chk_rel_err(".///", Str.from_bytes([47, 254, 47, 97, 98, 47, 97]))
  assert_eq rel(Str.from_bytes([254]), "./").unwrap, ".."
  chk_rel_err("b/a.b/ab/../", "/")
  assert_eq rel("é///a.b/a/", "").unwrap, "../../.."
  chk_rel_err(Str.from_bytes([47, 254, 47, 47, 47, 47]), "é//////")
  chk_rel_err("../é", "///")
  assert_eq rel("a.b/ab////é", "ab///").unwrap, "../../../ab"
  assert_eq rel("///a/./...", "////////").unwrap, "../.."
  chk_rel_err("a/.", "////...")
  assert_eq rel(Str.from_bytes([47, 254, 47, 195, 169, 47, 47, 47]), "/").unwrap, "../.."
  chk_rel_err("/./", "é/b")
  chk_rel_err("é/é", Str.from_bytes([47, 46, 46, 46, 47, 254, 47, 47]))
  chk_rel_err(Str.from_bytes([254, 47, 46, 46, 46, 47, 97, 47, 254]), "/é/b")
}

test "rel 9" {
  chk_rel_err("a.b/a////", "/é/./../é/")
  chk_rel_err("/a.b/../../é", "...///")
  assert_eq rel("b/.../é////", "../").unwrap, "../../../.."
  assert_eq rel(".../...", "").unwrap, "../.."
  chk_rel_err("a", "/./../")
  assert_eq rel(Str.from_bytes([47, 97, 46, 98, 47, 97, 47, 254, 47, 254]), "//a/a/a.b").unwrap, "../../../../a/a/a.b"
  assert_eq rel("////", Str.from_bytes([47, 46, 46, 47, 46, 46, 46, 47, 97, 46, 98, 47, 254])).unwrap, Str.from_bytes([46, 46, 46, 47, 97, 46, 98, 47, 254])
  chk_rel_err("/..././ab", ".../b/ab//")
  assert_eq rel(".", "ab///////a.b/").unwrap, "ab/a.b"
  chk_rel_err("/", "..")
  chk_rel_err("ab/", "/a.b/é/a.b/a.b")
  chk_rel_err("///é//", "ab/../é/")
  chk_rel_err("/b/a", "..")
  assert_eq rel(Str.from_bytes([195, 169, 47, 46, 46, 47, 47, 47, 254]), Str.from_bytes([46, 46, 47, 254, 47, 47, 47, 47])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 254])
  chk_rel_err(Str.from_bytes([254, 47]), "/")
  chk_rel_err("a.b/.", "/")
  assert_eq rel("", Str.from_bytes([254])).unwrap, Str.from_bytes([254])
  assert_eq rel("/a/..", "/b/ab").unwrap, "b/ab"
  assert_eq rel("/b/.../..", "/").unwrap, ".."
  chk_rel_err("////", Str.from_bytes([254, 47]))
  assert_eq rel("/a", Str.from_bytes([47, 254, 47, 97, 98, 47, 97, 46, 98, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 97, 98, 47, 97, 46, 98, 47, 254])
  assert_eq rel(Str.from_bytes([47, 254, 47, 254, 47]), "///").unwrap, "../.."
  chk_rel_err("..", "/")
  assert_eq rel("...", "a.b").unwrap, "../a.b"
  assert_eq rel(Str.from_bytes([47, 46, 46, 46, 47, 195, 169, 47, 254]), "//").unwrap, "../../.."
  assert_eq rel("", "ab/..//").unwrap, "."
  chk_rel_err(Str.from_bytes([47, 195, 169, 47, 254, 47, 254, 47]), "")
  chk_rel_err("/", Str.from_bytes([46, 46, 46, 47, 46, 46, 46, 47, 254, 47, 97]))
  chk_rel_err("/./", "ab/a/./é")
  chk_rel_err(Str.from_bytes([46, 46, 46, 47, 254]), "//")
  assert_eq rel("..././a.b/a", "..").unwrap, "../../../.."
  chk_rel_err("/a", "b/é/")
  chk_rel_err("/ab", Str.from_bytes([195, 169, 47, 254, 47, 97, 98, 47, 46]))
  assert_eq rel("é/..", "...").unwrap, "..."
  assert_eq rel("", "a.b/b/.").unwrap, "a.b/b"
  assert_eq rel(Str.from_bytes([98, 47, 254]), "é/../").unwrap, "../.."
  chk_rel_err("", "/./é")
  chk_rel_err("a.b//b", "/")
  chk_rel_err("", "//../ab")
  chk_rel_err(Str.from_bytes([46, 46, 47, 47, 47, 47, 254, 47, 97, 47]), "/a/a.b/..")
  assert_eq rel("/b", "/ab").unwrap, "../ab"
  assert_eq rel(Str.from_bytes([47, 254, 47, 97]), "/").unwrap, "../.."
  assert_eq rel(Str.from_bytes([254]), "").unwrap, ".."
  chk_rel_err("é", "///é")
  assert_eq rel("/..././/", Str.from_bytes([47, 47, 47, 195, 169, 47, 46, 46, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 254])
  assert_eq rel(Str.from_bytes([47, 47, 254, 47]), "/ab/a").unwrap, "../ab/a"
  chk_rel_err("..//a", "/")
  assert_eq rel("///", "/é").unwrap, "é"
  chk_rel_err(Str.from_bytes([254, 47, 98, 47, 195, 169, 47, 46, 46]), "/../a.b///")
  chk_rel_err("a.b////", Str.from_bytes([47, 254, 47, 97, 46, 98, 47, 47]))
  chk_rel_err("////b/b", "ab/ab/...///")
  chk_rel_err(Str.from_bytes([46, 47, 46, 47, 254, 47, 46, 46]), Str.from_bytes([47, 254, 47, 47, 47, 195, 169]))
  assert_eq rel("a/.../a", Str.from_bytes([46, 46, 47, 46, 47, 98, 47, 254])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 46, 46, 47, 98, 47, 254])
  chk_rel_err(".../", "/")
  assert_eq rel("///.././", "///a.b").unwrap, "a.b"
  chk_rel_err(".../.", "///ab/a/a.b/")
  chk_rel_err(Str.from_bytes([47, 254, 47, 195, 169]), "b")
  chk_rel_err("///.../a.b", ".../a.b/é/.")
  assert_eq rel("", "a").unwrap, "a"
  chk_rel_err("///a/b", "./..///a")
  assert_eq rel("", Str.from_bytes([254, 47, 46, 46, 47, 98, 47, 46, 46, 46])).unwrap, "b/..."
  chk_rel_err("../b////b", "é////a")
  assert_eq rel("b/", "").unwrap, ".."
  chk_rel_err(Str.from_bytes([47, 47, 47, 254]), Str.from_bytes([97, 47, 254, 47]))
  assert_eq rel("a/a/a.b/a", "ab/é////a.b").unwrap, "../../../../ab/é/a.b"
  chk_rel_err("../a.b", "")
  chk_rel_err("a", "/a.b/")
  assert_eq rel("./", "..././a///").unwrap, ".../a"
  chk_rel_err("b", "/.../é/")
  chk_rel_err("a.b///", "/.../é/.../b/")
  chk_rel_err("a/..", "/..././//.")
  assert_eq rel("/", "/////..").unwrap, "."
  assert_eq rel(Str.from_bytes([254, 47, 46, 46, 47, 97, 46, 98, 47, 254]), ".").unwrap, "../.."
  chk_rel_err(Str.from_bytes([46, 46, 47, 254]), "////.../a.b/.")
  chk_rel_err("/./../.../a", Str.from_bytes([97, 47, 254, 47, 46, 46, 46, 47, 254, 47]))
  assert_eq rel(Str.from_bytes([46, 47, 254, 47]), "a.b/a.b/a/").unwrap, "../a.b/a.b/a"
  assert_eq rel("ab", Str.from_bytes([254, 47, 97])).unwrap, Str.from_bytes([46, 46, 47, 254, 47, 97])
  chk_rel_err("é/../a.b/", Str.from_bytes([47, 47, 254]))
  assert_eq rel("a/b", "é/a.b").unwrap, "../../é/a.b"
  assert_eq rel("///", "/é/.../ab").unwrap, "é/.../ab"
  assert_eq rel("é", "../a.b/é").unwrap, "../../a.b/é"
  chk_rel_err(Str.from_bytes([254, 47, 97, 46, 98, 47, 46, 46, 46]), "/.../é/a.b/../")
  assert_eq rel(Str.from_bytes([97, 46, 98, 47, 195, 169, 47, 254, 47, 46]), "...").unwrap, "../../../..."
  assert_eq rel("//./é/a.b", "/").unwrap, "../.."
  assert_eq rel("a", "é/b///b").unwrap, "../é/b/b"
  assert_eq rel("/", "/...//./ab").unwrap, ".../ab"
  assert_eq rel(Str.from_bytes([97, 98, 47, 47, 47, 254]), "ab/..").unwrap, "../.."
  assert_eq rel("/é/a.b/a.b/", "/./..").unwrap, "../../.."
  assert_eq rel(".///a.b", "...").unwrap, "../..."
  chk_rel_err("///ab/ab/..", "..//b///")
  chk_rel_err("..//", "é/../a/.")
  assert_eq rel("//a", "/ab/").unwrap, "../ab"
  assert_eq rel("/", "//a/../b").unwrap, "b"
  chk_rel_err("///../ab///", "ab/é/a")
  chk_rel_err("/", "ab//////..")
  chk_rel_err("a", "/a.b/b")
  assert_eq rel("", Str.from_bytes([195, 169, 47, 254, 47, 97, 46, 98, 47, 97, 98])).unwrap, Str.from_bytes([195, 169, 47, 254, 47, 97, 46, 98, 47, 97, 98])
  chk_rel_err("/", "é/...")
  chk_rel_err("a/a//////", "/////ab")
  chk_rel_err("ab//", Str.from_bytes([47, 254, 47, 47, 47, 254, 47, 46]))
}

test "rel 10" {
  assert_eq rel("./", Str.from_bytes([46, 46, 46, 47, 254, 47, 47, 47, 47, 254])).unwrap, Str.from_bytes([46, 46, 46, 47, 254, 47, 254])
  chk_rel_err(".././/", "é//")
  chk_rel_err(Str.from_bytes([254, 47, 254]), "//")
  chk_rel_err("..////", "a")
  assert_eq rel("/.../ab", "///").unwrap, "../.."
  assert_eq rel("/...", "/b/").unwrap, "../b"
  chk_rel_err(Str.from_bytes([98, 47, 254, 47, 47, 47, 47, 47, 47]), Str.from_bytes([47, 46, 46, 46, 47, 254, 47, 46]))
  chk_rel_err(Str.from_bytes([47, 254, 47, 46, 46, 46, 47, 47, 47]), Str.from_bytes([254]))
  chk_rel_err("/b//", "..")
  assert_eq rel("/a", "///").unwrap, ".."
  chk_rel_err(Str.from_bytes([47, 47, 47, 47, 254, 47, 97, 47, 47]), "a")
  chk_rel_err("///a", "b////b")
  chk_rel_err("/", "é/b/...")
  chk_rel_err("//", "../a/ab")
  chk_rel_err("...", "/..///...////")
  assert_eq rel("a.b/a.b/é", "a").unwrap, "../../../a"
  chk_rel_err("/", Str.from_bytes([254, 47, 46, 46, 46]))
  chk_rel_err("..//////", "///a/..")
  assert_eq rel("//", "/a/").unwrap, "a"
  assert_eq rel("/ab///", "/ab/a").unwrap, "a"
  chk_rel_err("/é", "é/a.b/b")
  assert_eq rel("ab/", "...").unwrap, "../..."
  chk_rel_err("ab/é", "/é/")
  assert_eq rel("/", "/.//").unwrap, "."
  chk_rel_err("//a.b", "")
  chk_rel_err("..//a/a.b", "")
  chk_rel_err(Str.from_bytes([47, 98, 47, 254, 47, 47]), "")
  assert_eq rel("ab/.", "../é").unwrap, "../../é"
  assert_eq rel("///", "/").unwrap, "."
  chk_rel_err("", Str.from_bytes([47, 46, 47, 46, 47, 254]))
  assert_eq rel("a.b/a/b", "a.b/b/").unwrap, "../../b"
  assert_eq rel("é/é/é", "../a.b").unwrap, "../../../../a.b"
  chk_rel_err("../a/..", "/")
  chk_rel_err(".../b/.../b", "//")
  assert_eq rel("/.../a.b/b///", "/////").unwrap, "../../.."
  chk_rel_err("/.../...//..", "..//a///")
  chk_rel_err("/ab/", "a.b/b/é//")
  chk_rel_err("/", "a")
  chk_rel_err(".///.../é", "//")
  chk_rel_err("", "///./a")
  chk_rel_err("//b/../é/", "")
  assert_eq rel("a/../ab/...", Str.from_bytes([97, 98, 47, 46, 46, 47, 254, 47])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 254])
  assert_eq rel("", "ab").unwrap, "ab"
  assert_eq rel("/../", "/a.b///").unwrap, "a.b"
  chk_rel_err("/../a.b/.", "..")
  assert_eq rel(Str.from_bytes([254, 47, 46]), "...////../").unwrap, ".."
  chk_rel_err(Str.from_bytes([47, 97, 98, 47, 254, 47, 97, 98, 47, 47, 47]), "")
  chk_rel_err("", "/...///a.b/..")
  chk_rel_err("/é//", "")
  assert_eq rel("/ab/b", "///").unwrap, "../.."
  chk_rel_err("/.", "../é")
  chk_rel_err("//é", "ab/")
  chk_rel_err("/", "ab/.")
  assert_eq rel("/é/.", "/./ab/ab/").unwrap, "../ab/ab"
  assert_eq rel("///b/./", "//").unwrap, ".."
  assert_eq rel(".../a.b/a.b", "b/").unwrap, "../../../b"
  chk_rel_err("a.b", "/ab/")
  assert_eq rel(Str.from_bytes([47, 254]), "/").unwrap, ".."
  assert_eq rel("/./.", Str.from_bytes([47, 46, 47, 254])).unwrap, Str.from_bytes([254])
  chk_rel_err("///a.b/..", ".///")
  assert_eq rel(Str.from_bytes([254, 47, 46, 46, 47, 97, 46, 98]), Str.from_bytes([254])).unwrap, Str.from_bytes([46, 46, 47, 254])
  chk_rel_err("a/b", "/")
  assert_eq rel("///é/..//", "////").unwrap, "."
  chk_rel_err("", "///////é")
  chk_rel_err(Str.from_bytes([254, 47]), "/...////.")
  chk_rel_err(".", Str.from_bytes([47, 46, 46, 46, 47, 47, 47, 254]))
  chk_rel_err("//./.../", "")
  assert_eq rel("é/.../a.b", "ab/ab").unwrap, "../../../ab/ab"
  chk_rel_err(Str.from_bytes([97, 46, 98, 47, 98, 47, 254, 47, 97]), Str.from_bytes([47, 97, 98, 47, 254]))
  assert_eq rel(Str.from_bytes([254, 47, 97, 47, 195, 169, 47, 97, 46, 98]), "").unwrap, "../../../.."
  assert_eq rel("", Str.from_bytes([254, 47, 97, 46, 98, 47, 98, 47, 97])).unwrap, Str.from_bytes([254, 47, 97, 46, 98, 47, 98, 47, 97])
  chk_rel_err(Str.from_bytes([46, 46, 47, 254, 47, 47, 47, 46, 46]), Str.from_bytes([195, 169, 47, 46, 47, 254, 47]))
  assert_eq rel("/", Str.from_bytes([47, 47, 47, 254])).unwrap, Str.from_bytes([254])
  assert_eq rel("////é//", "/").unwrap, ".."
  assert_eq rel("é/../.", Str.from_bytes([98, 47, 254, 47, 46, 46, 46, 47, 97])).unwrap, Str.from_bytes([98, 47, 254, 47, 46, 46, 46, 47, 97])
  chk_rel_err("b/a.b/...", "/a.b/a.b/a/")
  chk_rel_err("a//...", "/")
  assert_eq rel("./", "../ab/a").unwrap, "../ab/a"
  assert_eq rel("a.b/b/b/", Str.from_bytes([254])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 254])
  chk_rel_err(Str.from_bytes([47, 97, 98, 47, 254, 47, 47, 47]), "")
  chk_rel_err("/.../", "é//a.b/a.b")
  assert_eq rel("///ab/é/a.b", "///a/../é/").unwrap, "../../../é"
  chk_rel_err("/é/./", "./a.b")
  assert_eq rel("///ab/ab/é", Str.from_bytes([47, 254, 47])).unwrap, Str.from_bytes([46, 46, 47, 46, 46, 47, 46, 46, 47, 254])
  assert_eq rel("/", Str.from_bytes([47, 254, 47, 47, 46])).unwrap, Str.from_bytes([254])
  chk_rel_err("/", ".../../a.b/..")
  assert_eq rel(".////a.b///", "ab///b/..").unwrap, "../ab"
  assert_eq rel("/é", "////...///").unwrap, "../..."
  assert_eq rel("./b/é", "").unwrap, "../.."
  chk_rel_err("a/a", "/////b")
  chk_rel_err("../a//ab", "")
  assert_eq rel("/a/.../.", "/b").unwrap, "../../b"
  chk_rel_err("../ab/", "/a/")
  chk_rel_err("/.../..././b", "a")
  assert_eq rel(Str.from_bytes([47, 254, 47, 97, 46, 98, 47, 47]), "/../...").unwrap, "../../..."
  chk_rel_err("...", "/ab")
  chk_rel_err("/é/b/é/é", "")
  assert_eq rel(Str.from_bytes([47, 46, 47, 254, 47, 98]), "/a/../").unwrap, "../.."
  chk_rel_err("", Str.from_bytes([47, 46, 46, 46, 47, 46, 46, 47, 47, 254, 47]))
  chk_rel_err(Str.from_bytes([47, 47, 47, 98, 47, 254, 47, 46, 46, 46, 47]), "b/")
}

test "local? localize 1" {
  assert_eq local?(""), false
  assert localize("").err?
  assert_eq local?("/"), false
  assert localize("/").err?
  assert_eq local?("/../"), false
  assert localize("/../").err?
  assert_eq local?("/./x"), false
  assert localize("/./x").err?
  assert_eq local?("./"), true
  assert localize("./").err?
  assert_eq local?("../"), false
  assert localize("../").err?
  assert_eq local?("a"), true
  assert_eq localize("a").unwrap, "a"
  assert_eq local?("a/"), true
  assert localize("a/").err?
  assert_eq local?("/a"), false
  assert localize("/a").err?
  assert_eq local?("a/../a"), true
  assert localize("a/../a").err?
  assert_eq local?("a/./x"), true
  assert localize("a/./x").err?
  assert_eq local?("./a"), true
  assert localize("./a").err?
  assert_eq local?("../a"), false
  assert localize("../a").err?
  assert_eq local?("b"), true
  assert_eq localize("b").unwrap, "b"
  assert_eq local?("b/"), true
  assert localize("b/").err?
  assert_eq local?("/b"), false
  assert localize("/b").err?
  assert_eq local?("b/../b"), true
  assert localize("b/../b").err?
  assert_eq local?("b/./x"), true
  assert localize("b/./x").err?
  assert_eq local?("./b"), true
  assert localize("./b").err?
  assert_eq local?("../b"), false
  assert localize("../b").err?
  assert_eq local?("abc"), true
  assert_eq localize("abc").unwrap, "abc"
  assert_eq local?("abc/"), true
  assert localize("abc/").err?
  assert_eq local?("/abc"), false
  assert localize("/abc").err?
  assert_eq local?("abc/../abc"), true
  assert localize("abc/../abc").err?
  assert_eq local?("abc/./x"), true
  assert localize("abc/./x").err?
  assert_eq local?("./abc"), true
  assert localize("./abc").err?
  assert_eq local?("../abc"), false
  assert localize("../abc").err?
  assert_eq local?("."), true
  assert_eq localize(".").unwrap, "."
  assert_eq local?("/."), false
  assert localize("/.").err?
  assert_eq local?("./../."), false
  assert localize("./../.").err?
  assert_eq local?("././x"), true
  assert localize("././x").err?
  assert_eq local?("./."), true
  assert localize("./.").err?
  assert_eq local?("../."), false
  assert localize("../.").err?
  assert_eq local?(".."), false
  assert localize("..").err?
  assert_eq local?("/.."), false
  assert localize("/..").err?
  assert_eq local?("../../.."), false
  assert localize("../../..").err?
  assert_eq local?(".././x"), false
  assert localize(".././x").err?
  assert_eq local?("./.."), false
  assert localize("./..").err?
  assert_eq local?("../.."), false
  assert localize("../..").err?
  assert_eq local?("..."), true
  assert_eq localize("...").unwrap, "..."
  assert_eq local?(".../"), true
  assert localize(".../").err?
  assert_eq local?("/..."), false
  assert localize("/...").err?
  assert_eq local?(".../../..."), true
  assert localize(".../../...").err?
  assert_eq local?("..././x"), true
  assert localize("..././x").err?
  assert_eq local?("./..."), true
  assert localize("./...").err?
  assert_eq local?("../..."), false
  assert localize("../...").err?
  assert_eq local?("//"), false
  assert localize("//").err?
  assert_eq local?("//..//"), false
  assert localize("//..//").err?
  assert_eq local?("//./x"), false
  assert localize("//./x").err?
  assert_eq local?(".//"), true
  assert localize(".//").err?
}

test "local? localize 2" {
  assert_eq local?("..//"), false
  assert localize("..//").err?
  assert_eq local?("///"), false
  assert localize("///").err?
  assert_eq local?("///..///"), false
  assert localize("///..///").err?
  assert_eq local?("///./x"), false
  assert localize("///./x").err?
  assert_eq local?(".///"), true
  assert localize(".///").err?
  assert_eq local?("..///"), false
  assert localize("..///").err?
  assert_eq local?("a.b"), true
  assert_eq localize("a.b").unwrap, "a.b"
  assert_eq local?("a.b/"), true
  assert localize("a.b/").err?
  assert_eq local?("/a.b"), false
  assert localize("/a.b").err?
  assert_eq local?("a.b/../a.b"), true
  assert localize("a.b/../a.b").err?
  assert_eq local?("a.b/./x"), true
  assert localize("a.b/./x").err?
  assert_eq local?("./a.b"), true
  assert localize("./a.b").err?
  assert_eq local?("../a.b"), false
  assert localize("../a.b").err?
  assert_eq local?(".x"), true
  assert_eq localize(".x").unwrap, ".x"
  assert_eq local?(".x/"), true
  assert localize(".x/").err?
  assert_eq local?("/.x"), false
  assert localize("/.x").err?
  assert_eq local?(".x/../.x"), true
  assert localize(".x/../.x").err?
  assert_eq local?(".x/./x"), true
  assert localize(".x/./x").err?
  assert_eq local?("./.x"), true
  assert localize("./.x").err?
  assert_eq local?("../.x"), false
  assert localize("../.x").err?
  assert_eq local?("x."), true
  assert_eq localize("x.").unwrap, "x."
  assert_eq local?("x./"), true
  assert localize("x./").err?
  assert_eq local?("/x."), false
  assert localize("/x.").err?
  assert_eq local?("x./../x."), true
  assert localize("x./../x.").err?
  assert_eq local?("x././x"), true
  assert localize("x././x").err?
  assert_eq local?("./x."), true
  assert localize("./x.").err?
  assert_eq local?("../x."), false
  assert localize("../x.").err?
  assert_eq local?("é"), true
  assert_eq localize("é").unwrap, "é"
  assert_eq local?("é/"), true
  assert localize("é/").err?
  assert_eq local?("/é"), false
  assert localize("/é").err?
  assert_eq local?("é/../é"), true
  assert localize("é/../é").err?
  assert_eq local?("é/./x"), true
  assert localize("é/./x").err?
  assert_eq local?("./é"), true
  assert localize("./é").err?
  assert_eq local?("../é"), false
  assert localize("../é").err?
  assert_eq local?("日本.語"), true
  assert_eq localize("日本.語").unwrap, "日本.語"
  assert_eq local?("日本.語/"), true
  assert localize("日本.語/").err?
  assert_eq local?("/日本.語"), false
  assert localize("/日本.語").err?
  assert_eq local?("日本.語/../日本.語"), true
  assert localize("日本.語/../日本.語").err?
  assert_eq local?("日本.語/./x"), true
  assert localize("日本.語/./x").err?
  assert_eq local?("./日本.語"), true
  assert localize("./日本.語").err?
  assert_eq local?("../日本.語"), false
  assert localize("../日本.語").err?
  assert_eq local?(Str.from_bytes([255])), true
  assert localize(Str.from_bytes([255])).err?
  assert_eq local?(Str.from_bytes([255, 47])), true
  assert localize(Str.from_bytes([255, 47])).err?
  assert_eq local?(Str.from_bytes([47, 255])), false
  assert localize(Str.from_bytes([47, 255])).err?
  assert_eq local?(Str.from_bytes([255, 47, 46, 46, 47, 255])), true
  assert localize(Str.from_bytes([255, 47, 46, 46, 47, 255])).err?
  assert_eq local?(Str.from_bytes([255, 47, 46, 47, 120])), true
  assert localize(Str.from_bytes([255, 47, 46, 47, 120])).err?
  assert_eq local?(Str.from_bytes([46, 47, 255])), true
  assert localize(Str.from_bytes([46, 47, 255])).err?
  assert_eq local?(Str.from_bytes([46, 46, 47, 255])), false
  assert localize(Str.from_bytes([46, 46, 47, 255])).err?
  assert_eq local?(Str.from_bytes([97, 195])), true
  assert localize(Str.from_bytes([97, 195])).err?
  assert_eq local?(Str.from_bytes([97, 195, 47])), true
  assert localize(Str.from_bytes([97, 195, 47])).err?
}

test "local? localize 3" {
  assert_eq local?(Str.from_bytes([47, 97, 195])), false
  assert localize(Str.from_bytes([47, 97, 195])).err?
  assert_eq local?(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195])), true
  assert localize(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195])).err?
  assert_eq local?(Str.from_bytes([97, 195, 47, 46, 47, 120])), true
  assert localize(Str.from_bytes([97, 195, 47, 46, 47, 120])).err?
  assert_eq local?(Str.from_bytes([46, 47, 97, 195])), true
  assert localize(Str.from_bytes([46, 47, 97, 195])).err?
  assert_eq local?(Str.from_bytes([46, 46, 47, 97, 195])), false
  assert localize(Str.from_bytes([46, 46, 47, 97, 195])).err?
  assert_eq local?(" "), true
  assert_eq localize(" ").unwrap, " "
  assert_eq local?(" /"), true
  assert localize(" /").err?
  assert_eq local?("/ "), false
  assert localize("/ ").err?
  assert_eq local?(" /../ "), true
  assert localize(" /../ ").err?
  assert_eq local?(" /./x"), true
  assert localize(" /./x").err?
  assert_eq local?("./ "), true
  assert localize("./ ").err?
  assert_eq local?("../ "), false
  assert localize("../ ").err?
  assert_eq local?("a b"), true
  assert_eq localize("a b").unwrap, "a b"
  assert_eq local?("a b/"), true
  assert localize("a b/").err?
  assert_eq local?("/a b"), false
  assert localize("/a b").err?
  assert_eq local?("a b/../a b"), true
  assert localize("a b/../a b").err?
  assert_eq local?("a b/./x"), true
  assert localize("a b/./x").err?
  assert_eq local?("./a b"), true
  assert localize("./a b").err?
  assert_eq local?("../a b"), false
  assert localize("../a b").err?
  assert_eq local?("\#{x}"), true
  assert_eq localize("\#{x}").unwrap, "\#{x}"
  assert_eq local?("\#{x}/"), true
  assert localize("\#{x}/").err?
  assert_eq local?("/\#{x}"), false
  assert localize("/\#{x}").err?
  assert_eq local?("\#{x}/../\#{x}"), true
  assert localize("\#{x}/../\#{x}").err?
  assert_eq local?("\#{x}/./x"), true
  assert localize("\#{x}/./x").err?
  assert_eq local?("./\#{x}"), true
  assert localize("./\#{x}").err?
  assert_eq local?("../\#{x}"), false
  assert localize("../\#{x}").err?
  assert_eq local?("\\"), true
  assert_eq localize("\\").unwrap, "\\"
  assert_eq local?("\\/"), true
  assert localize("\\/").err?
  assert_eq local?("/\\"), false
  assert localize("/\\").err?
  assert_eq local?("\\/../\\"), true
  assert localize("\\/../\\").err?
  assert_eq local?("\\/./x"), true
  assert localize("\\/./x").err?
  assert_eq local?("./\\"), true
  assert localize("./\\").err?
  assert_eq local?("../\\"), false
  assert localize("../\\").err?
  assert_eq local?(".a.b.c"), true
  assert_eq localize(".a.b.c").unwrap, ".a.b.c"
  assert_eq local?(".a.b.c/"), true
  assert localize(".a.b.c/").err?
  assert_eq local?("/.a.b.c"), false
  assert localize("/.a.b.c").err?
  assert_eq local?(".a.b.c/../.a.b.c"), true
  assert localize(".a.b.c/../.a.b.c").err?
  assert_eq local?(".a.b.c/./x"), true
  assert localize(".a.b.c/./x").err?
  assert_eq local?("./.a.b.c"), true
  assert localize("./.a.b.c").err?
  assert_eq local?("../.a.b.c"), false
  assert localize("../.a.b.c").err?
  assert_eq local?("/////b/../"), false
  assert localize("/////b/../").err?
  assert_eq local?("////b/a.b"), false
  assert localize("////b/a.b").err?
  assert_eq local?(Str.from_bytes([254, 47, 97, 47, 97, 98])), true
  assert localize(Str.from_bytes([254, 47, 97, 47, 97, 98])).err?
  assert_eq local?("a/a//////"), true
  assert localize("a/a//////").err?
  assert_eq local?(Str.from_bytes([47, 254, 47, 46, 46, 47, 46, 46])), false
  assert localize(Str.from_bytes([47, 254, 47, 46, 46, 47, 46, 46])).err?
  assert_eq local?("/../é/a/ab"), false
  assert localize("/../é/a/ab").err?
  assert_eq local?(".../ab/é"), true
  assert_eq localize(".../ab/é").unwrap, ".../ab/é"
  assert_eq local?("a.b/.///"), true
  assert localize("a.b/.///").err?
  assert_eq local?("/b/.../ab/a.b"), false
  assert localize("/b/.../ab/a.b").err?
  assert_eq local?("//////a/ab/"), false
  assert localize("//////a/ab/").err?
}

test "local? localize 4" {
  assert_eq local?("b//"), true
  assert localize("b//").err?
  assert_eq local?(Str.from_bytes([47, 47, 47, 47, 254, 47, 46, 46])), false
  assert localize(Str.from_bytes([47, 47, 47, 47, 254, 47, 46, 46])).err?
  assert_eq local?("/a/a.b/////"), false
  assert localize("/a/a.b/////").err?
  assert_eq local?("//./é///"), false
  assert localize("//./é///").err?
  assert_eq local?("..//é/b/"), false
  assert localize("..//é/b/").err?
  assert_eq local?(Str.from_bytes([97, 98, 47, 254, 47, 47, 97, 46, 98])), true
  assert localize(Str.from_bytes([97, 98, 47, 254, 47, 47, 97, 46, 98])).err?
  assert_eq local?("/a.b/"), false
  assert localize("/a.b/").err?
  assert_eq local?("../.../"), false
  assert localize("../.../").err?
  assert_eq local?(Str.from_bytes([46, 46, 46, 47, 254, 47, 46, 46, 47, 98])), true
  assert localize(Str.from_bytes([46, 46, 46, 47, 254, 47, 46, 46, 47, 98])).err?
  assert_eq local?("/ab"), false
  assert localize("/ab").err?
  assert_eq local?("///b/é/"), false
  assert localize("///b/é/").err?
  assert_eq local?("///./b"), false
  assert localize("///./b").err?
  assert_eq local?("/é/.../ab"), false
  assert localize("/é/.../ab").err?
  assert_eq local?("../a.b///ab/"), false
  assert localize("../a.b///ab/").err?
  assert_eq local?("b/a.b/./../"), true
  assert localize("b/a.b/./../").err?
  assert_eq local?("/.../"), false
  assert localize("/.../").err?
  assert_eq local?("/./a.b"), false
  assert localize("/./a.b").err?
  assert_eq local?("/..////a.b/"), false
  assert localize("/..////a.b/").err?
  assert_eq local?(Str.from_bytes([47, 47, 254, 47, 97, 46, 98])), false
  assert localize(Str.from_bytes([47, 47, 254, 47, 97, 46, 98])).err?
