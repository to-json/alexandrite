  assert localize("/.../ab///a.b/").err?
  assert_eq local?(Str.from_bytes([47, 254])), false
  assert localize(Str.from_bytes([47, 254])).err?
  assert_eq local?(".../.../ab/."), true
  assert localize(".../.../ab/.").err?
  assert_eq local?("...//////."), true
  assert localize("...//////.").err?
  assert_eq local?("a.b/b"), true
  assert_eq localize("a.b/b").unwrap, "a.b/b"
  assert_eq local?("///../b"), false
  assert localize("///../b").err?
  assert_eq local?(Str.from_bytes([47, 47, 254, 47, 46])), false
  assert localize(Str.from_bytes([47, 47, 254, 47, 46])).err?
  assert_eq local?(Str.from_bytes([46, 46, 47, 98, 47, 195, 169, 47, 254])), false
  assert localize(Str.from_bytes([46, 46, 47, 98, 47, 195, 169, 47, 254])).err?
  assert_eq local?("////"), false
  assert localize("////").err?
  assert_eq local?(Str.from_bytes([254, 47, 254, 47, 47, 47, 47, 47])), true
  assert localize(Str.from_bytes([254, 47, 254, 47, 47, 47, 47, 47])).err?
  assert_eq local?("/a/ab/"), false
  assert localize("/a/ab/").err?
  assert_eq local?("../a.b/a"), false
  assert localize("../a.b/a").err?
  assert_eq local?("a.b/////"), true
  assert localize("a.b/////").err?
  assert_eq local?("/a.b/."), false
  assert localize("/a.b/.").err?
  assert_eq local?("//.."), false
  assert localize("//..").err?
  assert_eq local?(Str.from_bytes([97, 98, 47, 46, 47, 254])), true
  assert localize(Str.from_bytes([97, 98, 47, 46, 47, 254])).err?
  assert_eq local?(Str.from_bytes([254, 47, 97, 47, 47, 47, 47, 47])), true
  assert localize(Str.from_bytes([254, 47, 97, 47, 47, 47, 47, 47])).err?
  assert_eq local?("//a/...///"), false
  assert localize("//a/...///").err?
  assert_eq local?("////../b"), false
  assert localize("////../b").err?
}

