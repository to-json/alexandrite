test "join 1" {
  assert_eq join(["//"]), "/"
  assert_eq join(["/", "", "."]), "/"
  assert_eq join(["..."]), "..."
  assert_eq join(["/", "a", ".", "a"]), "/a/a"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["a.b"]), "a.b"
  assert_eq join([".", "b", "..", ".."]), ".."
  assert_eq join(["..", "é", "é"]), "../é/é"
  assert_eq join(["", ".."]), ".."
  assert_eq join(["", "...", "", ".."]), "."
  assert_eq join([]), ""
  assert_eq join(["é", "é", "/", ""]), "é/é"
  assert_eq join(["...", ".."]), "."
  assert_eq join(["...", Str.from_bytes([254]), "//", "a.b"]), Str.from_bytes([46, 46, 46, 47, 254, 47, 97, 46, 98])
  assert_eq join(["b"]), "b"
  assert_eq join(["a.b"]), "a.b"
  assert_eq join(["/", ".", "//", "é"]), "/é"
  assert_eq join(["ab", "ab", "é"]), "ab/ab/é"
  assert_eq join([]), ""
  assert_eq join(["/", ""]), "/"
  assert_eq join(["...", "a.b", "..."]), ".../a.b/..."
  assert_eq join(["a", "", "a.b", Str.from_bytes([254])]), Str.from_bytes([97, 47, 97, 46, 98, 47, 254])
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["/", "b"]), "/b"
  assert_eq join(["...", "b"]), ".../b"
  assert_eq join(["a.b", "//", ".", "a"]), "a.b/a"
  assert_eq join([]), ""
  assert_eq join(["//", "..."]), "/..."
  assert_eq join([""]), ""
  assert_eq join([".."]), ".."
  assert_eq join(["//", "..."]), "/..."
  assert_eq join(["a", "ab", "/", "//"]), "a/ab"
  assert_eq join(["a.b", "//", Str.from_bytes([254]), ".."]), "a.b"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["ab"]), "ab"
  assert_eq join(["ab"]), "ab"
  assert_eq join(["/", "//", "", "ab"]), "/ab"
  assert_eq join(["b", "/"]), "b"
  assert_eq join(["//"]), "/"
  assert_eq join(["b", "...", "a.b", "/"]), "b/.../a.b"
  assert_eq join(["a"]), "a"
  assert_eq join(["a", "a.b", Str.from_bytes([254]), "a"]), Str.from_bytes([97, 47, 97, 46, 98, 47, 254, 47, 97])
  assert_eq join(["", "", "//", "/"]), "/"
  assert_eq join(["", "/", ".."]), "/"
  assert_eq join(["//", "b"]), "/b"
  assert_eq join(["é", "..", "//", "."]), "."
  assert_eq join(["//", "//", "ab", "//"]), "/ab"
  assert_eq join(["/", "//", "b"]), "/b"
  assert_eq join(["b", "a.b", "..."]), "b/a.b/..."
  assert_eq join([Str.from_bytes([254]), "ab", "//", "é"]), Str.from_bytes([254, 47, 97, 98, 47, 195, 169])
  assert_eq join([]), ""
  assert_eq join(["..", "...", "ab"]), "../.../ab"
  assert_eq join(["..."]), "..."
  assert_eq join([Str.from_bytes([254]), "..", ".", "b"]), "b"
  assert_eq join(["a", "é", "/"]), "a/é"
  assert_eq join([".."]), ".."
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["...", "a.b", "ab"]), ".../a.b/ab"
  assert_eq join(["."]), "."
  assert_eq join(["a"]), "a"
  assert_eq join(["é", "b", ".", "a.b"]), "é/b/a.b"
  assert_eq join(["...", ".."]), "."
  assert_eq join(["a.b"]), "a.b"
  assert_eq join(["é", "b"]), "é/b"
  assert_eq join(["a.b", "...", "a"]), "a.b/.../a"
  assert_eq join(["b", "a.b", Str.from_bytes([254]), "a"]), Str.from_bytes([98, 47, 97, 46, 98, 47, 254, 47, 97])
  assert_eq join(["."]), "."
  assert_eq join([]), ""
  assert_eq join(["a", "/"]), "a"
  assert_eq join(["/", "", ""]), "/"
  assert_eq join(["a.b", "a"]), "a.b/a"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["é", Str.from_bytes([254]), ""]), Str.from_bytes([195, 169, 47, 254])
  assert_eq join([]), ""
  assert_eq join(["/", "ab", "b", "ab"]), "/ab/b/ab"
  assert_eq join(["...", "a.b"]), ".../a.b"
  assert_eq join(["ab", "...", "ab"]), "ab/.../ab"
  assert_eq join(["/", "a.b", "..."]), "/a.b/..."
  assert_eq join([]), ""
  assert_eq join(["a.b"]), "a.b"
  assert_eq join(["a", "", "a.b", Str.from_bytes([254])]), Str.from_bytes([97, 47, 97, 46, 98, 47, 254])
  assert_eq join([Str.from_bytes([254]), "é", "é"]), Str.from_bytes([254, 47, 195, 169, 47, 195, 169])
  assert_eq join(["a.b"]), "a.b"
  assert_eq join(["..", "..", "...", "//"]), "../../..."
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["/", "//", "ab", "."]), "/ab"
  assert_eq join([]), ""
  assert_eq join(["..", "a", "//"]), "../a"
  assert_eq join([Str.from_bytes([254]), "."]), Str.from_bytes([254])
  assert_eq join([""]), ""
  assert_eq join([]), ""
  assert_eq join(["//"]), "/"
  assert_eq join(["..", "...", "a.b", "b"]), "../.../a.b/b"
}

test "join 2" {
  assert_eq join(["/", "a"]), "/a"
  assert_eq join(["...", "//", "", "ab"]), ".../ab"
  assert_eq join(["b"]), "b"
  assert_eq join([]), ""
  assert_eq join([Str.from_bytes([254]), ".", "a", ""]), Str.from_bytes([254, 47, 97])
  assert_eq join(["//"]), "/"
  assert_eq join(["a.b", "ab", "ab", "a.b"]), "a.b/ab/ab/a.b"
  assert_eq join(["a.b", "//", "ab", "//"]), "a.b/ab"
  assert_eq join(["é", "/", "b"]), "é/b"
  assert_eq join(["", ".."]), ".."
  assert_eq join(["..", "..", "a", "..."]), "../../a/..."
  assert_eq join(["//"]), "/"
  assert_eq join(["b", "a.b"]), "b/a.b"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([Str.from_bytes([254])]), Str.from_bytes([254])
  assert_eq join(["é", "a"]), "é/a"
  assert_eq join([]), ""
  assert_eq join([Str.from_bytes([254])]), Str.from_bytes([254])
  assert_eq join(["a"]), "a"
  assert_eq join(["b", "é"]), "b/é"
  assert_eq join([".", ".", "/", "ab"]), "ab"
  assert_eq join(["//", "b", "ab", "."]), "/b/ab"
  assert_eq join(["a", "...", "//"]), "a/..."
  assert_eq join(["a", "/", "ab", ".."]), "a"
  assert_eq join([]), ""
  assert_eq join(["a", "//"]), "a"
  assert_eq join([".."]), ".."
  assert_eq join(["", "/", "//", "/"]), "/"
  assert_eq join(["/", "a.b", "é", "b"]), "/a.b/é/b"
  assert_eq join([Str.from_bytes([254]), "//", "...", "é"]), Str.from_bytes([254, 47, 46, 46, 46, 47, 195, 169])
  assert_eq join(["", ".."]), ".."
  assert_eq join(["", "b", "a.b", "b"]), "b/a.b/b"
  assert_eq join([]), ""
  assert_eq join(["//", ".", "/"]), "/"
  assert_eq join(["ab"]), "ab"
  assert_eq join(["//", "ab", "..."]), "/ab/..."
  assert_eq join(["ab", "."]), "ab"
  assert_eq join(["b", Str.from_bytes([254]), "//"]), Str.from_bytes([98, 47, 254])
  assert_eq join(["...", "//"]), "..."
  assert_eq join([".", "é", "é", "..."]), "é/é/..."
  assert_eq join([]), ""
  assert_eq join(["//", ".", "..", Str.from_bytes([254])]), Str.from_bytes([47, 254])
  assert_eq join(["..", ".."]), "../.."
  assert_eq join(["...", "..."]), ".../..."
  assert_eq join(["...", "ab", "."]), ".../ab"
  assert_eq join(["é", "é", "/"]), "é/é"
  assert_eq join([Str.from_bytes([254]), "b"]), Str.from_bytes([254, 47, 98])
  assert_eq join([".", "ab"]), "ab"
  assert_eq join(["b", "a.b", "/", "//"]), "b/a.b"
  assert_eq join([".", ""]), "."
  assert_eq join([]), ""
  assert_eq join(["a", "ab", "//"]), "a/ab"
  assert_eq join(["..", "ab", "a", Str.from_bytes([254])]), Str.from_bytes([46, 46, 47, 97, 98, 47, 97, 47, 254])
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([Str.from_bytes([254]), "b", "ab"]), Str.from_bytes([254, 47, 98, 47, 97, 98])
  assert_eq join([]), ""
  assert_eq join(["ab", "..."]), "ab/..."
  assert_eq join(["..", "b", "", "//"]), "../b"
  assert_eq join(["/", ".", Str.from_bytes([254]), "b"]), Str.from_bytes([47, 254, 47, 98])
  assert_eq join(["a.b"]), "a.b"
  assert_eq join([".."]), ".."
  assert_eq join([".", "..."]), "..."
  assert_eq join([]), ""
  assert_eq join(["a"]), "a"
  assert_eq join(["//", "b", "//"]), "/b"
  assert_eq join(["", "ab"]), "ab"
  assert_eq join([Str.from_bytes([254])]), Str.from_bytes([254])
  assert_eq join([".", ""]), "."
  assert_eq join(["", "...", "ab"]), ".../ab"
  assert_eq join(["a"]), "a"
  assert_eq join(["...", "a.b", "//"]), ".../a.b"
  assert_eq join(["..", "é"]), "../é"
  assert_eq join(["", "//"]), "/"
  assert_eq join([]), ""
  assert_eq join(["a", Str.from_bytes([254]), ".", ".."]), "a"
  assert_eq join([".", "ab", "ab"]), "ab/ab"
  assert_eq join(["é", "ab"]), "é/ab"
  assert_eq join([]), ""
  assert_eq join(["", "."]), "."
  assert_eq join(["/", "é", "/", "a"]), "/é/a"
  assert_eq join(["..."]), "..."
  assert_eq join(["a"]), "a"
  assert_eq join(["...", ""]), "..."
  assert_eq join(["."]), "."
  assert_eq join([""]), ""
  assert_eq join([]), ""
  assert_eq join(["", "é", "//", "a.b"]), "é/a.b"
  assert_eq join([]), ""
  assert_eq join(["", Str.from_bytes([254]), "a.b", "b"]), Str.from_bytes([254, 47, 97, 46, 98, 47, 98])
  assert_eq join(["a.b", "é", ".."]), "a.b"
  assert_eq join([]), ""
  assert_eq join(["é", "//", Str.from_bytes([254]), "..."]), Str.from_bytes([195, 169, 47, 254, 47, 46, 46, 46])
  assert_eq join(["a", "ab", "ab", "ab"]), "a/ab/ab/ab"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([]), ""
}

test "join 3" {
  assert_eq join(["", Str.from_bytes([254])]), Str.from_bytes([254])
  assert_eq join(["ab", "..", ""]), "."
  assert_eq join([]), ""
  assert_eq join(["..."]), "..."
  assert_eq join([]), ""
  assert_eq join(["", "a.b", "a", "é"]), "a.b/a/é"
  assert_eq join(["b", "...", "é", "é"]), "b/.../é/é"
  assert_eq join(["", "/", "ab"]), "/ab"
  assert_eq join(["a.b", ".."]), "."
  assert_eq join(["ab", "a", Str.from_bytes([254]), "."]), Str.from_bytes([97, 98, 47, 97, 47, 254])
  assert_eq join([".."]), ".."
  assert_eq join(["a.b", ".", ""]), "a.b"
  assert_eq join(["a"]), "a"
  assert_eq join(["a"]), "a"
  assert_eq join(["."]), "."
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["/", "//"]), "/"
  assert_eq join(["a"]), "a"
  assert_eq join([Str.from_bytes([254]), "ab", "ab"]), Str.from_bytes([254, 47, 97, 98, 47, 97, 98])
  assert_eq join(["...", "ab"]), ".../ab"
  assert_eq join(["/"]), "/"
  assert_eq join(["", ".."]), ".."
  assert_eq join(["//"]), "/"
  assert_eq join(["//", "a"]), "/a"
  assert_eq join(["a", "//"]), "a"
  assert_eq join(["/", "//", "a.b", Str.from_bytes([254])]), Str.from_bytes([47, 97, 46, 98, 47, 254])
  assert_eq join(["é"]), "é"
  assert_eq join(["a.b", "a.b", "a.b"]), "a.b/a.b/a.b"
  assert_eq join(["/", "/", Str.from_bytes([254])]), Str.from_bytes([47, 254])
  assert_eq join([Str.from_bytes([254])]), Str.from_bytes([254])
  assert_eq join(["é"]), "é"
  assert_eq join(["", Str.from_bytes([254]), "/", "."]), Str.from_bytes([254])
  assert_eq join(["b", "/", "a"]), "b/a"
  assert_eq join(["é", Str.from_bytes([254]), ".", "/"]), Str.from_bytes([195, 169, 47, 254])
  assert_eq join(["...", "b", "a"]), ".../b/a"
  assert_eq join(["ab", ".", "a.b"]), "ab/a.b"
  assert_eq join(["é", "..", "", "ab"]), "ab"
  assert_eq join([]), ""
  assert_eq join(["..", "..", ".", ""]), "../.."
  assert_eq join(["ab", "é", "."]), "ab/é"
  assert_eq join([]), ""
  assert_eq join(["/", Str.from_bytes([254])]), Str.from_bytes([47, 254])
  assert_eq join([]), ""
  assert_eq join(["//", "a.b"]), "/a.b"
  assert_eq join(["é", "b"]), "é/b"
  assert_eq join(["b", "a", "a", "..."]), "b/a/a/..."
  assert_eq join(["é", "a.b", "a.b", "a.b"]), "é/a.b/a.b/a.b"
  assert_eq join(["/", "a"]), "/a"
  assert_eq join(["..", Str.from_bytes([254]), "a.b", "ab"]), Str.from_bytes([46, 46, 47, 254, 47, 97, 46, 98, 47, 97, 98])
  assert_eq join(["a.b"]), "a.b"
  assert_eq join([Str.from_bytes([254]), "a", "//", "/"]), Str.from_bytes([254, 47, 97])
  assert_eq join([]), ""
  assert_eq join(["...", "é", "//", Str.from_bytes([254])]), Str.from_bytes([46, 46, 46, 47, 195, 169, 47, 254])
  assert_eq join(["a.b", "//"]), "a.b"
  assert_eq join(["a.b", "a", "b", "a.b"]), "a.b/a/b/a.b"
  assert_eq join([".", ".", "b"]), "b"
  assert_eq join([""]), ""
  assert_eq join([".", ".", Str.from_bytes([254]), ".."]), "."
  assert_eq join(["..", "...", "...", "b"]), "../.../.../b"
  assert_eq join(["..", "a", ".."]), ".."
  assert_eq join([]), ""
  assert_eq join(["..."]), "..."
  assert_eq join(["/", Str.from_bytes([254])]), Str.from_bytes([47, 254])
  assert_eq join([]), ""
  assert_eq join(["a.b"]), "a.b"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([Str.from_bytes([254]), Str.from_bytes([254]), ".", "//"]), Str.from_bytes([254, 47, 254])
  assert_eq join(["//"]), "/"
  assert_eq join(["b", "."]), "b"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["", "//", "..."]), "/..."
  assert_eq join(["a"]), "a"
  assert_eq join([]), ""
  assert_eq join(["a", "a.b", "...", "..."]), "a/a.b/.../..."
  assert_eq join(["ab", "a.b", "a", "a.b"]), "ab/a.b/a/a.b"
  assert_eq join([".", "é", "//"]), "é"
  assert_eq join([]), ""
  assert_eq join(["é"]), "é"
  assert_eq join([]), ""
  assert_eq join(["b", "//", "b"]), "b/b"
  assert_eq join(["a", "b", "//"]), "a/b"
  assert_eq join([]), ""
  assert_eq join(["/", "b", "a.b"]), "/b/a.b"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["...", "é", "..", "/"]), "..."
  assert_eq join([]), ""
  assert_eq join(["a", "/", "ab"]), "a/ab"
  assert_eq join([".", "a.b"]), "a.b"
  assert_eq join(["..", "/"]), ".."
  assert_eq join(["..."]), "..."
  assert_eq join(["//"]), "/"
  assert_eq join([]), ""
  assert_eq join(["a", "é"]), "a/é"
  assert_eq join(["ab"]), "ab"
  assert_eq join(["b"]), "b"
}

