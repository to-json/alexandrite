  assert_eq local?("/...//ab//"), false
  assert localize("/...//ab//").err?
  assert_eq local?("/b/"), false
  assert localize("/b/").err?
  assert_eq local?("é/////"), true
  assert localize("é/////").err?
  assert_eq local?(Str.from_bytes([254, 47, 47, 47])), true
  assert localize(Str.from_bytes([254, 47, 47, 47])).err?
  assert_eq local?(Str.from_bytes([47, 254, 47, 254])), false
  assert localize(Str.from_bytes([47, 254, 47, 254])).err?
  assert_eq local?("é///ab/é"), true
  assert localize("é///ab/é").err?
  assert_eq local?("é/../..."), true
  assert localize("é/../...").err?
  assert_eq local?("a//a.b"), true
  assert localize("a//a.b").err?
  assert_eq local?("a.b/é/.."), true
  assert localize("a.b/é/..").err?
  assert_eq local?(Str.from_bytes([47, 47, 46, 47, 97, 98, 47, 254])), false
  assert localize(Str.from_bytes([47, 47, 46, 47, 97, 98, 47, 254])).err?
  assert_eq local?("///..."), false
  assert localize("///...").err?
  assert_eq local?("a.b//////"), true
  assert localize("a.b//////").err?
  assert_eq local?("//b/..."), false
  assert localize("//b/...").err?
  assert_eq local?("a/a.b/é/"), true
  assert localize("a/a.b/é/").err?
  assert_eq local?(Str.from_bytes([47, 254, 47, 98, 47, 46, 46, 46])), false
  assert localize(Str.from_bytes([47, 254, 47, 98, 47, 46, 46, 46])).err?
}

test "clean base dir ext 1" {
  assert_eq [clean(""), base(""), dir(""), ext("")], [".", ".", ".", ""]
  assert_eq [clean("/"), base("/"), dir("/"), ext("/")], ["/", "/", "/", ""]
  assert_eq [clean("/../"), base("/../"), dir("/../"), ext("/../")], ["/", "..", "/", ""]
  assert_eq [clean("/./x"), base("/./x"), dir("/./x"), ext("/./x")], ["/x", "x", "/", ""]
  assert_eq [clean("./"), base("./"), dir("./"), ext("./")], [".", ".", ".", ""]
  assert_eq [clean("../"), base("../"), dir("../"), ext("../")], ["..", "..", "..", ""]
  assert_eq [clean("a"), base("a"), dir("a"), ext("a")], ["a", "a", ".", ""]
  assert_eq [clean("a/"), base("a/"), dir("a/"), ext("a/")], ["a", "a", "a", ""]
  assert_eq [clean("/a"), base("/a"), dir("/a"), ext("/a")], ["/a", "a", "/", ""]
  assert_eq [clean("a/../a"), base("a/../a"), dir("a/../a"), ext("a/../a")], ["a", "a", ".", ""]
  assert_eq [clean("a/./x"), base("a/./x"), dir("a/./x"), ext("a/./x")], ["a/x", "x", "a", ""]
  assert_eq [clean("./a"), base("./a"), dir("./a"), ext("./a")], ["a", "a", ".", ""]
  assert_eq [clean("../a"), base("../a"), dir("../a"), ext("../a")], ["../a", "a", "..", ""]
  assert_eq [clean("b"), base("b"), dir("b"), ext("b")], ["b", "b", ".", ""]
  assert_eq [clean("b/"), base("b/"), dir("b/"), ext("b/")], ["b", "b", "b", ""]
  assert_eq [clean("/b"), base("/b"), dir("/b"), ext("/b")], ["/b", "b", "/", ""]
  assert_eq [clean("b/../b"), base("b/../b"), dir("b/../b"), ext("b/../b")], ["b", "b", ".", ""]
  assert_eq [clean("b/./x"), base("b/./x"), dir("b/./x"), ext("b/./x")], ["b/x", "x", "b", ""]
  assert_eq [clean("./b"), base("./b"), dir("./b"), ext("./b")], ["b", "b", ".", ""]
  assert_eq [clean("../b"), base("../b"), dir("../b"), ext("../b")], ["../b", "b", "..", ""]
  assert_eq [clean("abc"), base("abc"), dir("abc"), ext("abc")], ["abc", "abc", ".", ""]
  assert_eq [clean("abc/"), base("abc/"), dir("abc/"), ext("abc/")], ["abc", "abc", "abc", ""]
  assert_eq [clean("/abc"), base("/abc"), dir("/abc"), ext("/abc")], ["/abc", "abc", "/", ""]
  assert_eq [clean("abc/../abc"), base("abc/../abc"), dir("abc/../abc"), ext("abc/../abc")], ["abc", "abc", ".", ""]
  assert_eq [clean("abc/./x"), base("abc/./x"), dir("abc/./x"), ext("abc/./x")], ["abc/x", "x", "abc", ""]
  assert_eq [clean("./abc"), base("./abc"), dir("./abc"), ext("./abc")], ["abc", "abc", ".", ""]
  assert_eq [clean("../abc"), base("../abc"), dir("../abc"), ext("../abc")], ["../abc", "abc", "..", ""]
  assert_eq [clean("."), base("."), dir("."), ext(".")], [".", ".", ".", "."]
  assert_eq [clean("/."), base("/."), dir("/."), ext("/.")], ["/", ".", "/", "."]
  assert_eq [clean("./../."), base("./../."), dir("./../."), ext("./../.")], ["..", ".", "..", "."]
  assert_eq [clean("././x"), base("././x"), dir("././x"), ext("././x")], ["x", "x", ".", ""]
  assert_eq [clean("./."), base("./."), dir("./."), ext("./.")], [".", ".", ".", "."]
  assert_eq [clean("../."), base("../."), dir("../."), ext("../.")], ["..", ".", "..", "."]
  assert_eq [clean(".."), base(".."), dir(".."), ext("..")], ["..", "..", ".", "."]
  assert_eq [clean("/.."), base("/.."), dir("/.."), ext("/..")], ["/", "..", "/", "."]
  assert_eq [clean("../../.."), base("../../.."), dir("../../.."), ext("../../..")], ["../../..", "..", "../..", "."]
  assert_eq [clean(".././x"), base(".././x"), dir(".././x"), ext(".././x")], ["../x", "x", "..", ""]
  assert_eq [clean("./.."), base("./.."), dir("./.."), ext("./..")], ["..", "..", ".", "."]
  assert_eq [clean("../.."), base("../.."), dir("../.."), ext("../..")], ["../..", "..", "..", "."]
  assert_eq [clean("..."), base("..."), dir("..."), ext("...")], ["...", "...", ".", "."]
  assert_eq [clean(".../"), base(".../"), dir(".../"), ext(".../")], ["...", "...", "...", ""]
  assert_eq [clean("/..."), base("/..."), dir("/..."), ext("/...")], ["/...", "...", "/", "."]
  assert_eq [clean(".../../..."), base(".../../..."), dir(".../../..."), ext(".../../...")], ["...", "...", ".", "."]
  assert_eq [clean("..././x"), base("..././x"), dir("..././x"), ext("..././x")], [".../x", "x", "...", ""]
  assert_eq [clean("./..."), base("./..."), dir("./..."), ext("./...")], ["...", "...", ".", "."]
  assert_eq [clean("../..."), base("../..."), dir("../..."), ext("../...")], ["../...", "...", "..", "."]
  assert_eq [clean("//"), base("//"), dir("//"), ext("//")], ["/", "/", "/", ""]
  assert_eq [clean("//..//"), base("//..//"), dir("//..//"), ext("//..//")], ["/", "..", "/", ""]
  assert_eq [clean("//./x"), base("//./x"), dir("//./x"), ext("//./x")], ["/x", "x", "/", ""]
  assert_eq [clean(".//"), base(".//"), dir(".//"), ext(".//")], [".", ".", ".", ""]
  assert_eq [clean("..//"), base("..//"), dir("..//"), ext("..//")], ["..", "..", "..", ""]
  assert_eq [clean("///"), base("///"), dir("///"), ext("///")], ["/", "/", "/", ""]
  assert_eq [clean("///..///"), base("///..///"), dir("///..///"), ext("///..///")], ["/", "..", "/", ""]
  assert_eq [clean("///./x"), base("///./x"), dir("///./x"), ext("///./x")], ["/x", "x", "/", ""]
  assert_eq [clean(".///"), base(".///"), dir(".///"), ext(".///")], [".", ".", ".", ""]
  assert_eq [clean("..///"), base("..///"), dir("..///"), ext("..///")], ["..", "..", "..", ""]
  assert_eq [clean("a.b"), base("a.b"), dir("a.b"), ext("a.b")], ["a.b", "a.b", ".", ".b"]
  assert_eq [clean("a.b/"), base("a.b/"), dir("a.b/"), ext("a.b/")], ["a.b", "a.b", "a.b", ""]
  assert_eq [clean("/a.b"), base("/a.b"), dir("/a.b"), ext("/a.b")], ["/a.b", "a.b", "/", ".b"]
  assert_eq [clean("a.b/../a.b"), base("a.b/../a.b"), dir("a.b/../a.b"), ext("a.b/../a.b")], ["a.b", "a.b", ".", ".b"]
  assert_eq [clean("a.b/./x"), base("a.b/./x"), dir("a.b/./x"), ext("a.b/./x")], ["a.b/x", "x", "a.b", ""]
  assert_eq [clean("./a.b"), base("./a.b"), dir("./a.b"), ext("./a.b")], ["a.b", "a.b", ".", ".b"]
  assert_eq [clean("../a.b"), base("../a.b"), dir("../a.b"), ext("../a.b")], ["../a.b", "a.b", "..", ".b"]
  assert_eq [clean(".x"), base(".x"), dir(".x"), ext(".x")], [".x", ".x", ".", ".x"]
  assert_eq [clean(".x/"), base(".x/"), dir(".x/"), ext(".x/")], [".x", ".x", ".x", ""]
  assert_eq [clean("/.x"), base("/.x"), dir("/.x"), ext("/.x")], ["/.x", ".x", "/", ".x"]
  assert_eq [clean(".x/../.x"), base(".x/../.x"), dir(".x/../.x"), ext(".x/../.x")], [".x", ".x", ".", ".x"]
  assert_eq [clean(".x/./x"), base(".x/./x"), dir(".x/./x"), ext(".x/./x")], [".x/x", "x", ".x", ""]
  assert_eq [clean("./.x"), base("./.x"), dir("./.x"), ext("./.x")], [".x", ".x", ".", ".x"]
  assert_eq [clean("../.x"), base("../.x"), dir("../.x"), ext("../.x")], ["../.x", ".x", "..", ".x"]
  assert_eq [clean("x."), base("x."), dir("x."), ext("x.")], ["x.", "x.", ".", "."]
  assert_eq [clean("x./"), base("x./"), dir("x./"), ext("x./")], ["x.", "x.", "x.", ""]
  assert_eq [clean("/x."), base("/x."), dir("/x."), ext("/x.")], ["/x.", "x.", "/", "."]
  assert_eq [clean("x./../x."), base("x./../x."), dir("x./../x."), ext("x./../x.")], ["x.", "x.", ".", "."]
  assert_eq [clean("x././x"), base("x././x"), dir("x././x"), ext("x././x")], ["x./x", "x", "x.", ""]
  assert_eq [clean("./x."), base("./x."), dir("./x."), ext("./x.")], ["x.", "x.", ".", "."]
  assert_eq [clean("../x."), base("../x."), dir("../x."), ext("../x.")], ["../x.", "x.", "..", "."]
  assert_eq [clean("é"), base("é"), dir("é"), ext("é")], ["é", "é", ".", ""]
  assert_eq [clean("é/"), base("é/"), dir("é/"), ext("é/")], ["é", "é", "é", ""]
  assert_eq [clean("/é"), base("/é"), dir("/é"), ext("/é")], ["/é", "é", "/", ""]
  assert_eq [clean("é/../é"), base("é/../é"), dir("é/../é"), ext("é/../é")], ["é", "é", ".", ""]
  assert_eq [clean("é/./x"), base("é/./x"), dir("é/./x"), ext("é/./x")], ["é/x", "x", "é", ""]
  assert_eq [clean("./é"), base("./é"), dir("./é"), ext("./é")], ["é", "é", ".", ""]
  assert_eq [clean("../é"), base("../é"), dir("../é"), ext("../é")], ["../é", "é", "..", ""]
  assert_eq [clean("日本.語"), base("日本.語"), dir("日本.語"), ext("日本.語")], ["日本.語", "日本.語", ".", ".語"]
  assert_eq [clean("日本.語/"), base("日本.語/"), dir("日本.語/"), ext("日本.語/")], ["日本.語", "日本.語", "日本.語", ""]
  assert_eq [clean("/日本.語"), base("/日本.語"), dir("/日本.語"), ext("/日本.語")], ["/日本.語", "日本.語", "/", ".語"]
  assert_eq [clean("日本.語/../日本.語"), base("日本.語/../日本.語"), dir("日本.語/../日本.語"), ext("日本.語/../日本.語")], ["日本.語", "日本.語", ".", ".語"]
  assert_eq [clean("日本.語/./x"), base("日本.語/./x"), dir("日本.語/./x"), ext("日本.語/./x")], ["日本.語/x", "x", "日本.語", ""]
  assert_eq [clean("./日本.語"), base("./日本.語"), dir("./日本.語"), ext("./日本.語")], ["日本.語", "日本.語", ".", ".語"]
  assert_eq [clean("../日本.語"), base("../日本.語"), dir("../日本.語"), ext("../日本.語")], ["../日本.語", "日本.語", "..", ".語"]
  assert_eq [clean(Str.from_bytes([255])), base(Str.from_bytes([255])), dir(Str.from_bytes([255])), ext(Str.from_bytes([255]))], [Str.from_bytes([255]), Str.from_bytes([255]), ".", ""]
  assert_eq [clean(Str.from_bytes([255, 47])), base(Str.from_bytes([255, 47])), dir(Str.from_bytes([255, 47])), ext(Str.from_bytes([255, 47]))], [Str.from_bytes([255]), Str.from_bytes([255]), Str.from_bytes([255]), ""]
  assert_eq [clean(Str.from_bytes([47, 255])), base(Str.from_bytes([47, 255])), dir(Str.from_bytes([47, 255])), ext(Str.from_bytes([47, 255]))], [Str.from_bytes([47, 255]), Str.from_bytes([255]), "/", ""]
  assert_eq [clean(Str.from_bytes([255, 47, 46, 46, 47, 255])), base(Str.from_bytes([255, 47, 46, 46, 47, 255])), dir(Str.from_bytes([255, 47, 46, 46, 47, 255])), ext(Str.from_bytes([255, 47, 46, 46, 47, 255]))], [Str.from_bytes([255]), Str.from_bytes([255]), ".", ""]
  assert_eq [clean(Str.from_bytes([255, 47, 46, 47, 120])), base(Str.from_bytes([255, 47, 46, 47, 120])), dir(Str.from_bytes([255, 47, 46, 47, 120])), ext(Str.from_bytes([255, 47, 46, 47, 120]))], [Str.from_bytes([255, 47, 120]), "x", Str.from_bytes([255]), ""]
  assert_eq [clean(Str.from_bytes([46, 47, 255])), base(Str.from_bytes([46, 47, 255])), dir(Str.from_bytes([46, 47, 255])), ext(Str.from_bytes([46, 47, 255]))], [Str.from_bytes([255]), Str.from_bytes([255]), ".", ""]
  assert_eq [clean(Str.from_bytes([46, 46, 47, 255])), base(Str.from_bytes([46, 46, 47, 255])), dir(Str.from_bytes([46, 46, 47, 255])), ext(Str.from_bytes([46, 46, 47, 255]))], [Str.from_bytes([46, 46, 47, 255]), Str.from_bytes([255]), "..", ""]
  assert_eq [clean(Str.from_bytes([97, 195])), base(Str.from_bytes([97, 195])), dir(Str.from_bytes([97, 195])), ext(Str.from_bytes([97, 195]))], [Str.from_bytes([97, 195]), Str.from_bytes([97, 195]), ".", ""]
  assert_eq [clean(Str.from_bytes([97, 195, 47])), base(Str.from_bytes([97, 195, 47])), dir(Str.from_bytes([97, 195, 47])), ext(Str.from_bytes([97, 195, 47]))], [Str.from_bytes([97, 195]), Str.from_bytes([97, 195]), Str.from_bytes([97, 195]), ""]
}

test "clean base dir ext 2" {
  assert_eq [clean(Str.from_bytes([47, 97, 195])), base(Str.from_bytes([47, 97, 195])), dir(Str.from_bytes([47, 97, 195])), ext(Str.from_bytes([47, 97, 195]))], [Str.from_bytes([47, 97, 195]), Str.from_bytes([97, 195]), "/", ""]
  assert_eq [clean(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195])), base(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195])), dir(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195])), ext(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195]))], [Str.from_bytes([97, 195]), Str.from_bytes([97, 195]), ".", ""]
  assert_eq [clean(Str.from_bytes([97, 195, 47, 46, 47, 120])), base(Str.from_bytes([97, 195, 47, 46, 47, 120])), dir(Str.from_bytes([97, 195, 47, 46, 47, 120])), ext(Str.from_bytes([97, 195, 47, 46, 47, 120]))], [Str.from_bytes([97, 195, 47, 120]), "x", Str.from_bytes([97, 195]), ""]
  assert_eq [clean(Str.from_bytes([46, 47, 97, 195])), base(Str.from_bytes([46, 47, 97, 195])), dir(Str.from_bytes([46, 47, 97, 195])), ext(Str.from_bytes([46, 47, 97, 195]))], [Str.from_bytes([97, 195]), Str.from_bytes([97, 195]), ".", ""]
  assert_eq [clean(Str.from_bytes([46, 46, 47, 97, 195])), base(Str.from_bytes([46, 46, 47, 97, 195])), dir(Str.from_bytes([46, 46, 47, 97, 195])), ext(Str.from_bytes([46, 46, 47, 97, 195]))], [Str.from_bytes([46, 46, 47, 97, 195]), Str.from_bytes([97, 195]), "..", ""]
  assert_eq [clean(" "), base(" "), dir(" "), ext(" ")], [" ", " ", ".", ""]
  assert_eq [clean(" /"), base(" /"), dir(" /"), ext(" /")], [" ", " ", " ", ""]
  assert_eq [clean("/ "), base("/ "), dir("/ "), ext("/ ")], ["/ ", " ", "/", ""]
  assert_eq [clean(" /../ "), base(" /../ "), dir(" /../ "), ext(" /../ ")], [" ", " ", ".", ""]
  assert_eq [clean(" /./x"), base(" /./x"), dir(" /./x"), ext(" /./x")], [" /x", "x", " ", ""]
  assert_eq [clean("./ "), base("./ "), dir("./ "), ext("./ ")], [" ", " ", ".", ""]
  assert_eq [clean("../ "), base("../ "), dir("../ "), ext("../ ")], ["../ ", " ", "..", ""]
  assert_eq [clean("a b"), base("a b"), dir("a b"), ext("a b")], ["a b", "a b", ".", ""]
  assert_eq [clean("a b/"), base("a b/"), dir("a b/"), ext("a b/")], ["a b", "a b", "a b", ""]
  assert_eq [clean("/a b"), base("/a b"), dir("/a b"), ext("/a b")], ["/a b", "a b", "/", ""]
  assert_eq [clean("a b/../a b"), base("a b/../a b"), dir("a b/../a b"), ext("a b/../a b")], ["a b", "a b", ".", ""]
  assert_eq [clean("a b/./x"), base("a b/./x"), dir("a b/./x"), ext("a b/./x")], ["a b/x", "x", "a b", ""]
  assert_eq [clean("./a b"), base("./a b"), dir("./a b"), ext("./a b")], ["a b", "a b", ".", ""]
  assert_eq [clean("../a b"), base("../a b"), dir("../a b"), ext("../a b")], ["../a b", "a b", "..", ""]
  assert_eq [clean("\#{x}"), base("\#{x}"), dir("\#{x}"), ext("\#{x}")], ["\#{x}", "\#{x}", ".", ""]
  assert_eq [clean("\#{x}/"), base("\#{x}/"), dir("\#{x}/"), ext("\#{x}/")], ["\#{x}", "\#{x}", "\#{x}", ""]
  assert_eq [clean("/\#{x}"), base("/\#{x}"), dir("/\#{x}"), ext("/\#{x}")], ["/\#{x}", "\#{x}", "/", ""]
  assert_eq [clean("\#{x}/../\#{x}"), base("\#{x}/../\#{x}"), dir("\#{x}/../\#{x}"), ext("\#{x}/../\#{x}")], ["\#{x}", "\#{x}", ".", ""]
  assert_eq [clean("\#{x}/./x"), base("\#{x}/./x"), dir("\#{x}/./x"), ext("\#{x}/./x")], ["\#{x}/x", "x", "\#{x}", ""]
  assert_eq [clean("./\#{x}"), base("./\#{x}"), dir("./\#{x}"), ext("./\#{x}")], ["\#{x}", "\#{x}", ".", ""]
  assert_eq [clean("../\#{x}"), base("../\#{x}"), dir("../\#{x}"), ext("../\#{x}")], ["../\#{x}", "\#{x}", "..", ""]
  assert_eq [clean("\\"), base("\\"), dir("\\"), ext("\\")], ["\\", "\\", ".", ""]
  assert_eq [clean("\\/"), base("\\/"), dir("\\/"), ext("\\/")], ["\\", "\\", "\\", ""]
  assert_eq [clean("/\\"), base("/\\"), dir("/\\"), ext("/\\")], ["/\\", "\\", "/", ""]
  assert_eq [clean("\\/../\\"), base("\\/../\\"), dir("\\/../\\"), ext("\\/../\\")], ["\\", "\\", ".", ""]
  assert_eq [clean("\\/./x"), base("\\/./x"), dir("\\/./x"), ext("\\/./x")], ["\\/x", "x", "\\", ""]
  assert_eq [clean("./\\"), base("./\\"), dir("./\\"), ext("./\\")], ["\\", "\\", ".", ""]
  assert_eq [clean("../\\"), base("../\\"), dir("../\\"), ext("../\\")], ["../\\", "\\", "..", ""]
  assert_eq [clean(".a.b.c"), base(".a.b.c"), dir(".a.b.c"), ext(".a.b.c")], [".a.b.c", ".a.b.c", ".", ".c"]
  assert_eq [clean(".a.b.c/"), base(".a.b.c/"), dir(".a.b.c/"), ext(".a.b.c/")], [".a.b.c", ".a.b.c", ".a.b.c", ""]
  assert_eq [clean("/.a.b.c"), base("/.a.b.c"), dir("/.a.b.c"), ext("/.a.b.c")], ["/.a.b.c", ".a.b.c", "/", ".c"]
  assert_eq [clean(".a.b.c/../.a.b.c"), base(".a.b.c/../.a.b.c"), dir(".a.b.c/../.a.b.c"), ext(".a.b.c/../.a.b.c")], [".a.b.c", ".a.b.c", ".", ".c"]
  assert_eq [clean(".a.b.c/./x"), base(".a.b.c/./x"), dir(".a.b.c/./x"), ext(".a.b.c/./x")], [".a.b.c/x", "x", ".a.b.c", ""]
  assert_eq [clean("./.a.b.c"), base("./.a.b.c"), dir("./.a.b.c"), ext("./.a.b.c")], [".a.b.c", ".a.b.c", ".", ".c"]
  assert_eq [clean("../.a.b.c"), base("../.a.b.c"), dir("../.a.b.c"), ext("../.a.b.c")], ["../.a.b.c", ".a.b.c", "..", ".c"]
  assert_eq [clean("/////b/../"), base("/////b/../"), dir("/////b/../"), ext("/////b/../")], ["/", "..", "/", ""]
  assert_eq [clean("////b/a.b"), base("////b/a.b"), dir("////b/a.b"), ext("////b/a.b")], ["/b/a.b", "a.b", "/b", ".b"]
  assert_eq [clean(Str.from_bytes([254, 47, 97, 47, 97, 98])), base(Str.from_bytes([254, 47, 97, 47, 97, 98])), dir(Str.from_bytes([254, 47, 97, 47, 97, 98])), ext(Str.from_bytes([254, 47, 97, 47, 97, 98]))], [Str.from_bytes([254, 47, 97, 47, 97, 98]), "ab", Str.from_bytes([254, 47, 97]), ""]
  assert_eq [clean("a/a//////"), base("a/a//////"), dir("a/a//////"), ext("a/a//////")], ["a/a", "a", "a/a", ""]
  assert_eq [clean(Str.from_bytes([47, 254, 47, 46, 46, 47, 46, 46])), base(Str.from_bytes([47, 254, 47, 46, 46, 47, 46, 46])), dir(Str.from_bytes([47, 254, 47, 46, 46, 47, 46, 46])), ext(Str.from_bytes([47, 254, 47, 46, 46, 47, 46, 46]))], ["/", "..", "/", "."]
  assert_eq [clean("/../é/a/ab"), base("/../é/a/ab"), dir("/../é/a/ab"), ext("/../é/a/ab")], ["/é/a/ab", "ab", "/é/a", ""]
