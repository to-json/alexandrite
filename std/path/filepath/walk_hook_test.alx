# Go's TestWalkFileError: needs the lstat hook (Go's export_test.go LstatP),
# which is walk_with here, so this file is in the package.

error StatErr {
  Some

  def message -> Str {
    "some stat error"
  }
}

test "WalkFileError" {
  td = os.mkdir_temp("", "alx-filepath-*").unwrap
  defer { os.remove_all(td).unwrap }
  for n in ["foo", "bar"] {
    ~os.write_file(join([td, n]), [], 0o644)
  }
  d = join([td, "dir"])
  ~os.mkdir_all(d, 0o755)
  ~os.write_file(join([d, "baz"]), [], 0o644)
  ~os.write_file(join([d, "stat-error"]), [], 0o644)
  lstat = ->(p: Str) -> ~os.FileInfo {
    fail StatErr.Some if p.end_with?("stat-error")
    ~os.lstat(p)
  }
  got: Map[Str, Str] = {}
  ~walk_with(td, lstat) { |p, _fi, err|
    r = ~rel(td, p)
    got[to_slash(r)] = err.some? ? err.unwrap.message : "<nil>"
  }
  want: Map[Str, Str] = {}
  want["."] = "<nil>"
  want["bar"] = "<nil>"
  want["dir"] = "<nil>"
  want["dir/baz"] = "<nil>"
  want["dir/stat-error"] = "some stat error"
  want["foo"] = "<nil>"
  assert_eq got.size, want.size
  for k, v in want {
    assert_eq "#{k}: #{got[k] || "missing"}", "#{k}: #{v}"
  }
}
