# Package path: Go's path — slash-separated paths (URLs, archive entries).
# Use path/filepath for the operating system's paths.
#
#   Go                              alx
#   Base / Clean / Dir / Ext        base / clean / dir / ext
#   IsAbs                           is_abs
#   Join(elem ...string)            join(elems: [Str])
#   Split -> (dir, file)            split -> (Str, Str)
#   Match -> (bool, error)          match -> ~Bool<PathError>
#   ErrBadPattern                   PathError.ErrBadPattern ("syntax error in pattern")
#
# Differences from Go: `join` takes a [Str] (no variadics). Nothing else.
# Tests: Go's path_test.go, match_test.go and example_test.go, translated
# (path_test.alx); TestCleanMallocs (allocation counts) has no alx
# equivalent. vec_path_test.alx holds vectors generated from Go.

import "unicode/utf8"

pub error PathError {
  # A malformed `match` pattern.
  ErrBadPattern

  def message -> Str {
    case self {
      ErrBadPattern => "syntax error in pattern"
    }
  }
}

# The shortest path equivalent to `p`: one slash between elements, no `.`,
# `..` resolved against what precedes it, no trailing slash (except "/").
pub def clean(p: Str) -> Str {
  return "." if p.size == 0
  rooted = p[0] == 47
  n = p.size
  out: [Byte] = []
  r = 0
  dotdot = 0
  if rooted {
    out << 47
    r = 1
    dotdot = 1
  }
  while r < n {
    if p[r] == 47 {
      r += 1
    } else if p[r] == 46 && (r + 1 == n || p[r + 1] == 47) {
      r += 1
    } else if p[r] == 46 && p[r + 1] == 46 && (r + 2 == n || p[r + 2] == 47) {
      r += 2
      if out.size > dotdot {
        # Back up to the previous slash.
        w = out.size - 1
        while w > dotdot && out[w] != 47 {
          w -= 1
        }
        out = out[0...w]
      } else if !rooted {
        if out.size > 0 {
          out << 47
        }
        out << 46
        out << 46
        dotdot = out.size
      }
    } else {
      if (rooted && out.size != 1) || (!rooted && out.size != 0) {
        out << 47
      }
      while r < n && p[r] != 47 {
        out << p[r]
        r += 1
      }
    }
  }
  return "." if out.size == 0
  Str.from_bytes(out)
}

# The non-empty elements joined with slashes, cleaned; "" if all are empty.
pub def join(elems: [Str]) -> Str {
  parts: [Str] = []
  for e in elems {
    parts << e if e.size > 0
  }
  return "" if parts.size == 0
  s = parts[0]
  i = 1
  while i < parts.size {
    s = s + "/" + parts[i]
    i += 1
  }
  clean(s)
}

# `p` split after its last slash: (dir, file); dir keeps the slash.
pub def split(p: Str) -> (Str, Str) {
  i = p.size - 1
  while i >= 0 && p[i] != 47 {
    i -= 1
  }
  (p[0...i + 1], p[i + 1...p.size])
}

# The last element; "." for "", "/" for only slashes.
pub def base(p: Str) -> Str {
  return "." if p.size == 0
  e = p.size
  while e > 0 && p[e - 1] == 47 {
    e -= 1
  }
  return "/" if e == 0
  s = p[0...e]
  i = s.size - 1
  while i >= 0 && s[i] != 47 {
    i -= 1
  }
  s[i + 1...s.size]
}

# All but the last element, cleaned.
pub def dir(p: Str) -> Str {
  d, _ = split(p)
  clean(d)
}

# The extension of the last element, dot included; "" if none.
pub def ext(p: Str) -> Str {
  i = p.size - 1
  while i >= 0 && p[i] != 47 {
    return p[i...p.size] if p[i] == 46
    i -= 1
  }
  ""
}

# Whether `p` starts with a slash.
pub def is_abs(p: Str) -> Bool {
  p.size > 0 && p[0] == 47
}

# Whether `name` matches the shell pattern (Go's Match):
#
#   pattern:     { term }
#   term:        '*'         any sequence of non-/ characters
#                '?'         any single non-/ character
#                '[' [ '^' ] { character-range } ']'
#                c           matches character c (c != '*', '?', '\\', '[')
#                '\\' c      matches character c
#   character-range: c, or lo '-' hi
#
# The whole name must match. Fails with ErrBadPattern for a malformed
# pattern; as in Go, the rest of the pattern is checked even after a
# mismatch.
pub def match(pattern: Str, name: Str) -> ~Bool<PathError> {
  pat = pattern
  nm = name
  while pat.size > 0 {
    star, chunk, rest = scan_chunk(pat)
    pat = rest
    if star && chunk.size == 0 {
      # Trailing * matches the rest of the name unless it has a /.
      return !has_slash(nm)
    }
    # Look for a match at the current position.
    t, ok, bad = match_chunk(chunk, nm)
    # If we're the last chunk, make sure we've exhausted the name;
    # otherwise we'd give a false result even if we could still match
    # using the star.
    if ok && (t.size == 0 || pat.size > 0) {
      nm = t
      next
    }
    fail PathError.ErrBadPattern if bad
    if star {
      # Look for a match skipping i+1 bytes. Cannot skip /.
      found = false
      i = 0
      while i < nm.size && nm[i] != 47 {
        t2, ok2, bad2 = match_chunk(chunk, nm[i + 1...nm.size])
        if ok2 {
          # If we're the last chunk, make sure we exhausted the name.
          if pat.size == 0 && t2.size > 0 {
            i += 1
            next
          }
          nm = t2
          found = true
          break
        }
        fail PathError.ErrBadPattern if bad2
        i += 1
      }
      next if found
    }
    # Before returning false with no error, check that the remainder of
    # the pattern is syntactically valid.
    while pat.size > 0 {
      _s, c2, r2 = scan_chunk(pat)
      pat = r2
      _t, _ok, bad3 = match_chunk(c2, "")
      fail PathError.ErrBadPattern if bad3
    }
    return false
  }
  nm.size == 0
}

def has_slash(s: Str) -> Bool {
  i = 0
  while i < s.size {
    return true if s[i] == 47
    i += 1
  }
  false
}

# The leading `*`s of the pattern, the chunk up to the next `*` outside a
# class, and the rest.
def scan_chunk(pattern: Str) -> (Bool, Str, Str) {
  p = pattern
  star = false
  while p.size > 0 && p[0] == 42 {
    p = p[1...p.size]
    star = true
  }
  inrange = false
  i = 0
  while i < p.size {
    c = p[i]
    if c == 92 {
      # The error check is done in match_chunk.
      i += 1 if i + 1 < p.size
    } else if c == 91 {
      inrange = true
    } else if c == 93 {
      inrange = false
    } else if c == 42 && !inrange {
      return (star, p[0...i], p[i...p.size])
    }
    i += 1
  }
  (star, p, "")
}

# Whether chunk matches the start of s: (rest of s, matched, bad pattern).
# The whole chunk is always scanned, so a malformed one is reported even
# when s doesn't match.
def match_chunk(chunk_in: Str, s_in: Str) -> (Str, Bool, Bool) {
  chunk = chunk_in
  s = s_in
  failed = false
  while chunk.size > 0 {
    failed = failed || s.size == 0
    c = chunk[0]
    if c == 91 {
      # A character class.
      r: Rune = 0
      if !failed {
        r1, n = utf8.decode_rune_in_string(s)
        r = r1
        s = s[n...s.size]
      }
      chunk = chunk[1...chunk.size]
      negated = false
      if chunk.size > 0 && chunk[0] == 94 {
        negated = true
        chunk = chunk[1...chunk.size]
      }
      matched = false
      nrange = 0
      loop {
        if chunk.size > 0 && chunk[0] == 93 && nrange > 0 {
          chunk = chunk[1...chunk.size]
          break
        }
        lo, rest, bad = get_esc(chunk)
        return ("", false, true) if bad
        chunk = rest
        hi = lo
        if chunk[0] == 45 {
          hi2, rest2, bad2 = get_esc(chunk[1...chunk.size])
          return ("", false, true) if bad2
          hi = hi2
          chunk = rest2
        }
        matched = matched || (lo <= r && r <= hi)
        nrange += 1
      }
      failed = failed || matched == negated
    } else if c == 63 {
      if !failed {
        failed = s[0] == 47
        _r, n2 = utf8.decode_rune_in_string(s)
        s = s[n2...s.size]
      }
      chunk = chunk[1...chunk.size]
    } else {
      if c == 92 {
        chunk = chunk[1...chunk.size]
        return ("", false, true) if chunk.size == 0
      }
      if !failed {
        failed = chunk[0] != s[0]
        s = s[1...s.size]
      }
      chunk = chunk[1...chunk.size]
    }
  }
  return ("", false, false) if failed
  (s, true, false)
}

# One (possibly escaped) character of a class: (rune, rest, bad pattern).
def get_esc(chunk_in: Str) -> (Rune, Str, Bool) {
  chunk = chunk_in
  return (0, chunk, true) if chunk.size == 0 || chunk[0] == 45 || chunk[0] == 93
  if chunk[0] == 92 {
    chunk = chunk[1...chunk.size]
    return (0, chunk, true) if chunk.size == 0
  }
  r, n = utf8.decode_rune_in_string(chunk)
  bad = r == 0xFFFD && n == 1
  rest = chunk[n...chunk.size]
  bad = true if rest.size == 0
  (r, rest, bad)
}
