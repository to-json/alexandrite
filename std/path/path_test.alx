#![test(external)]
# Go's path_test.go, match_test.go and example_test.go (package path_test).
# Not translated: TestCleanMallocs (allocation counts), the benchmarks.

import "path"

#[track_caller]
def check[T](got: T, want: T, what: Str) {
  assert got == want, "#{what} = #{got}, want #{want} (at #{caller_location})"
}

def cleantests -> [[Str]] {
  [
    # Already clean
    ["", "."],
    ["abc", "abc"],
    ["abc/def", "abc/def"],
    ["a/b/c", "a/b/c"],
    [".", "."],
    ["..", ".."],
    ["../..", "../.."],
    ["../../abc", "../../abc"],
    ["/abc", "/abc"],
    ["/", "/"],
    # Remove trailing slash
    ["abc/", "abc"],
    ["abc/def/", "abc/def"],
    ["a/b/c/", "a/b/c"],
    ["./", "."],
    ["../", ".."],
    ["../../", "../.."],
    ["/abc/", "/abc"],
    # Remove doubled slash
    ["abc//def//ghi", "abc/def/ghi"],
    ["//abc", "/abc"],
    ["///abc", "/abc"],
    ["//abc//", "/abc"],
    ["abc//", "abc"],
    # Remove . elements
    ["abc/./def", "abc/def"],
    ["/./abc/def", "/abc/def"],
    ["abc/.", "abc"],
    # Remove .. elements
    ["abc/def/ghi/../jkl", "abc/def/jkl"],
    ["abc/def/../ghi/../jkl", "abc/jkl"],
    ["abc/def/..", "abc"],
    ["abc/def/../..", "."],
    ["/abc/def/../..", "/"],
    ["abc/def/../../..", ".."],
    ["/abc/def/../../..", "/"],
    ["abc/def/../../../ghi/jkl/../../../mno", "../../mno"],
    # Combinations
    ["abc/./../def", "def"],
    ["abc//./../def", "def"],
    ["abc/../../././../def", "../../def"],
  ]
}

test "Clean" {
  for t in cleantests() {
    check(path.clean(t[0]), t[1], "Clean(#{t[0]})")
    check(path.clean(t[1]), t[1], "Clean(#{t[1]})")
  }
}

test "Split" {
  tests = [["a/b", "a/", "b"], ["a/b/", "a/b/", ""], ["a/", "a/", ""], ["a", "", "a"], ["/", "/", ""]]
  for t in tests {
    d, f = path.split(t[0])
    check(d, t[1], "Split(#{t[0]}) dir")
    check(f, t[2], "Split(#{t[0]}) file")
  }
}

test "Join" {
  tests: [([Str], Str)] = [
    # zero parameters
    ([], ""),
    # one parameter
    ([""], ""),
    (["a"], "a"),
    # two parameters
    (["a", "b"], "a/b"),
    (["a", ""], "a"),
    (["", "b"], "b"),
    (["/", "a"], "/a"),
    (["/", ""], "/"),
    (["a/", "b"], "a/b"),
    (["a/", ""], "a"),
    (["", ""], ""),
  ]
  for t in tests {
    check(path.join(t[0]), t[1], "Join(#{t[0]})")
  }
}

test "Ext" {
  tests = [["path.go", ".go"], ["path.pb.go", ".go"], ["a.dir/b", ""], ["a.dir/b.go", ".go"], ["a.dir/", ""]]
  for t in tests {
    check(path.ext(t[0]), t[1], "Ext(#{t[0]})")
  }
}

test "Base" {
  tests = [
    # Already clean
    ["", "."],
    [".", "."],
    ["/.", "."],
    ["/", "/"],
    ["////", "/"],
    ["x/", "x"],
    ["abc", "abc"],
    ["abc/def", "def"],
    ["a/b/.x", ".x"],
    ["a/b/c.", "c."],
    ["a/b/c.x", "c.x"],
  ]
  for t in tests {
    check(path.base(t[0]), t[1], "Base(#{t[0]})")
  }
}

test "Dir" {
  tests = [
    ["", "."],
    [".", "."],
    ["/.", "/"],
    ["/", "/"],
    ["////", "/"],
    ["/foo", "/"],
    ["x/", "x"],
    ["abc", "."],
    ["abc/def", "abc"],
    ["abc////def", "abc"],
    ["a/b/.x", "a/b"],
    ["a/b/c.", "a/b"],
    ["a/b/c.x", "a/b"],
  ]
  for t in tests {
    check(path.dir(t[0]), t[1], "Dir(#{t[0]})")
  }
}

test "IsAbs" {
  tests: [(Str, Bool)] = [
    ("", false),
    ("/", true),
    ("/usr/bin/gcc", true),
    ("..", false),
    ("/a/../bb", true),
    (".", false),
    ("./", false),
    ("lala", false),
  ]
  for t in tests {
    check(path.is_abs(t[0]), t[1], "IsAbs(#{t[0]})")
  }
}

# ------------------------------------------------------------ match_test.go

struct MatchTest {
  pattern: Str
  s: Str
  match: Bool
  bad: Bool
}

def mt(pattern: Str, s: Str, m: Bool, bad: Bool = false) -> MatchTest {
  MatchTest.new(pattern: pattern, s: s, match: m, bad: bad)
}

def match_tests -> [MatchTest] {
  [
    mt("abc", "abc", true),
    mt("*", "abc", true),
    mt("*c", "abc", true),
    mt("a*", "a", true),
    mt("a*", "abc", true),
    mt("a*", "ab/c", false),
    mt("a*/b", "abc/b", true),
    mt("a*/b", "a/c/b", false),
    mt("a*b*c*d*e*/f", "axbxcxdxe/f", true),
    mt("a*b*c*d*e*/f", "axbxcxdxexxx/f", true),
    mt("a*b*c*d*e*/f", "axbxcxdxe/xxx/f", false),
    mt("a*b*c*d*e*/f", "axbxcxdxexxx/fff", false),
    mt("a*b?c*x", "abxbbxdbxebxczzx", true),
    mt("a*b?c*x", "abxbbxdbxebxczzy", false),
    mt("ab[c]", "abc", true),
    mt("ab[b-d]", "abc", true),
    mt("ab[e-g]", "abc", false),
    mt("ab[^c]", "abc", false),
    mt("ab[^b-d]", "abc", false),
    mt("ab[^e-g]", "abc", true),
    mt("a\\*b", "a*b", true),
    mt("a\\*b", "ab", false),
    mt("a?b", "a☺b", true),
    mt("a[^a]b", "a☺b", true),
    mt("a???b", "a☺b", false),
    mt("a[^a][^a][^a]b", "a☺b", false),
    mt("[a-ζ]*", "α", true),
    mt("*[a-ζ]", "A", false),
    mt("a?b", "a/b", false),
    mt("a*b", "a/b", false),
    mt("[\\]a]", "]", true),
    mt("[\\-]", "-", true),
    mt("[x\\-]", "x", true),
    mt("[x\\-]", "-", true),
    mt("[x\\-]", "z", false),
    mt("[\\-x]", "x", true),
    mt("[\\-x]", "-", true),
    mt("[\\-x]", "a", false),
    mt("[]a]", "]", false, bad: true),
    mt("[-]", "-", false, bad: true),
    mt("[x-]", "x", false, bad: true),
    mt("[x-]", "-", false, bad: true),
    mt("[x-]", "z", false, bad: true),
    mt("[-x]", "x", false, bad: true),
    mt("[-x]", "-", false, bad: true),
    mt("[-x]", "a", false, bad: true),
    mt("\\", "a", false, bad: true),
    mt("[a-b-c]", "a", false, bad: true),
    mt("[", "a", false, bad: true),
    mt("[^", "a", false, bad: true),
    mt("[^bc", "a", false, bad: true),
    mt("a[", "a", false, bad: true),
    mt("a[", "ab", false, bad: true),
    mt("a[", "x", false, bad: true),
    mt("a/b[", "x", false, bad: true),
    mt("*x", "xxx", true),
  ]
}

test "Match" {
  for tt in match_tests() {
    r = path.match(tt.pattern, tt.s)
    if e = r.err {
      assert tt.bad, "Match(#{tt.pattern}, #{tt.s}): unexpected error #{e.message}"
      case e {
        path.PathError.ErrBadPattern => assert_eq e.message, "syntax error in pattern"
        _ => assert false, "Match(#{tt.pattern}, #{tt.s}): wrong error #{e.message}"
      }
    } else {
      assert !tt.bad, "Match(#{tt.pattern}, #{tt.s}): want ErrBadPattern"
      check(r.unwrap, tt.match, "Match(#{tt.pattern}, #{tt.s})")
    }
  }
}

# ---------------------------------------------------------- example_test.go

example "Base" {
  puts path.base("/a/b")
  puts path.base("/")
  puts path.base("")
} outputs "b\n/\n.\n"

example "Clean" {
  paths = ["a/c", "a//c", "a/c/.", "a/c/b/..", "../a/c", "../a/b/../././/c", "/../a/c", "/../a/b/../././/c", ""]
  for p in paths {
    puts format("Clean(%q) = %q", p, path.clean(p))
  }
} outputs <<~'EOS'
  Clean("a/c") = "a/c"
  Clean("a//c") = "a/c"
  Clean("a/c/.") = "a/c"
  Clean("a/c/b/..") = "a/c"
  Clean("../a/c") = "../a/c"
  Clean("../a/b/../././/c") = "../a/c"
  Clean("/../a/c") = "/a/c"
  Clean("/../a/b/../././/c") = "/a/c"
  Clean("") = "."
EOS

example "Dir" {
  puts path.dir("/a/b/c")
  puts path.dir("a/b/c")
  puts path.dir("/a/")
  puts path.dir("a/")
  puts path.dir("/")
  puts path.dir("")
} outputs "/a/b\na/b\n/a\na\n/\n.\n"

example "Ext" {
  puts path.ext("/a/b/c/bar.css")
  puts path.ext("/")
  puts path.ext("")
} outputs ".css\n\n\n"

example "IsAbs" {
  puts path.is_abs("/dev/null")
} outputs "true\n"

example "Join" {
  puts path.join(["a", "b", "c"])
  puts path.join(["a", "b/c"])
  puts path.join(["a/b", "c"])
  puts path.join(["a/b", "../../../xyz"])
  puts path.join(["", ""])
  puts path.join(["a", ""])
  puts path.join(["", "a"])
} outputs "a/b/c\na/b/c\na/b/c\n../xyz\n\na\na\n"

example "Match" {
  puts path.match("abc", "abc").unwrap
  puts path.match("a*", "abc").unwrap
  puts path.match("a*/b", "a/c/b").unwrap
} outputs "true\ntrue\nfalse\n"

example "Split" {
  for s in ["static/myfile.css", "myfile.css", ""] {
    d, f = path.split(s)
    puts format("path.Split(%q) = dir: %q, file: %q", s, d, f)
  }
} outputs <<~'EOS'
  path.Split("static/myfile.css") = dir: "static/", file: "myfile.css"
  path.Split("myfile.css") = dir: "", file: "myfile.css"
  path.Split("") = dir: "", file: ""
EOS
