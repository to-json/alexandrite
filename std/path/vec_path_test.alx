  assert_eq split(".../é/"), (".../é/", "")
  assert_eq split("a b/a\\////"), ("a b/a\\////", "")
  assert_eq split("abc/日本.語.../"), ("abc/日本.語.../", "")
  assert_eq split("./\#{x}\#{x}/..日本.語/"), ("./\#{x}\#{x}/..日本.語/", "")
