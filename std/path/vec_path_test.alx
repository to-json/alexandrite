  assert_eq is_abs(Str.from_bytes([92, 47, 92, 47, 46, 46, 97, 195])), false
  assert_eq [base("a.b...///"), dir("a.b...///"), ext("a.b...///")], ["a.b...", "a.b...", ""]
  assert_eq is_abs("a.b...///"), false
  assert_eq [base(Str.from_bytes([47, 47, 46, 47, 97, 195, 47])), dir(Str.from_bytes([47, 47, 46, 47, 97, 195, 47])), ext(Str.from_bytes([47, 47, 46, 47, 97, 195, 47]))], [Str.from_bytes([97, 195]), Str.from_bytes([47, 97, 195]), ""]
  assert_eq is_abs(Str.from_bytes([47, 47, 46, 47, 97, 195, 47])), true
  assert_eq [base(" /\#{x}/a/"), dir(" /\#{x}/a/"), ext(" /\#{x}/a/")], ["a", " /\#{x}/a", ""]
  assert_eq is_abs(" /\#{x}/a/"), false
  assert_eq [base(Str.from_bytes([97, 195, 47, 46, 46, 46, 195, 169])), dir(Str.from_bytes([97, 195, 47, 46, 46, 46, 195, 169])), ext(Str.from_bytes([97, 195, 47, 46, 46, 46, 195, 169]))], ["...é", Str.from_bytes([97, 195]), ".é"]
  assert_eq is_abs(Str.from_bytes([97, 195, 47, 46, 46, 46, 195, 169])), false
  assert_eq [base("\\/......"), dir("\\/......"), ext("\\/......")], ["......", "\\", "."]
  assert_eq is_abs("\\/......"), false
  assert_eq [base(".a.b.c a.b"), dir(".a.b.c a.b"), ext(".a.b.c a.b")], [".a.b.c a.b", ".", ".b"]
  assert_eq is_abs(".a.b.c a.b"), false
  assert_eq [base(".a.b.c/.../a/"), dir(".a.b.c/.../a/"), ext(".a.b.c/.../a/")], ["a", ".a.b.c/.../a", ""]
  assert_eq is_abs(".a.b.c/.../a/"), false
  assert_eq [base("a b...a.b.c"), dir("a b...a.b.c"), ext("a b...a.b.c")], ["a b...a.b.c", ".", ".c"]
  assert_eq is_abs("a b...a.b.c"), false
  assert_eq [base(" /a/.x/"), dir(" /a/.x/"), ext(" /a/.x/")], [".x", " /a/.x", ""]
  assert_eq is_abs(" /a/.x/"), false
  assert_eq [base(" /..."), dir(" /..."), ext(" /...")], ["...", " ", "."]
  assert_eq is_abs(" /..."), false
  assert_eq [base(Str.from_bytes([195, 169, 97, 98, 99, 97, 195, 46, 97, 46, 98, 46, 99])), dir(Str.from_bytes([195, 169, 97, 98, 99, 97, 195, 46, 97, 46, 98, 46, 99])), ext(Str.from_bytes([195, 169, 97, 98, 99, 97, 195, 46, 97, 46, 98, 46, 99]))], [Str.from_bytes([195, 169, 97, 98, 99, 97, 195, 46, 97, 46, 98, 46, 99]), ".", ".c"]
  assert_eq is_abs(Str.from_bytes([195, 169, 97, 98, 99, 97, 195, 46, 97, 46, 98, 46, 99])), false
  assert_eq [base("x./\\///b"), dir("x./\\///b"), ext("x./\\///b")], ["b", "x./\\", ""]
  assert_eq is_abs("x./\\///b"), false
  assert_eq [base(".a.b.cé/./\\a/"), dir(".a.b.cé/./\\a/"), ext(".a.b.cé/./\\a/")], ["\\a", ".a.b.cé/\\a", ""]
  assert_eq is_abs(".a.b.cé/./\\a/"), false
  assert_eq [base("日本.語a.b//\\/"), dir("日本.語a.b//\\/"), ext("日本.語a.b//\\/")], ["\\", "日本.語a.b/\\", ""]
  assert_eq is_abs("日本.語a.b//\\/"), false
  assert_eq [base("....."), dir("....."), ext(".....")], [".....", ".", "."]
  assert_eq is_abs("....."), false
  assert_eq [base("é.a.b.c/./"), dir("é.a.b.c/./"), ext("é.a.b.c/./")], [".", "é.a.b.c", ""]
  assert_eq is_abs("é.a.b.c/./"), false
  assert_eq [base(Str.from_bytes([255, 46, 47, 92, 46, 120, 47, 46, 120])), dir(Str.from_bytes([255, 46, 47, 92, 46, 120, 47, 46, 120])), ext(Str.from_bytes([255, 46, 47, 92, 46, 120, 47, 46, 120]))], [".x", Str.from_bytes([255, 46, 47, 92, 46, 120]), ".x"]
  assert_eq is_abs(Str.from_bytes([255, 46, 47, 92, 46, 120, 47, 46, 120])), false
  assert_eq [base(".a.b.cé/../a.b"), dir(".a.b.cé/../a.b"), ext(".a.b.cé/../a.b")], ["a.b", ".", ".b"]
  assert_eq is_abs(".a.b.cé/../a.b"), false
}

test "base dir ext is_abs 4" {
  assert_eq [base("abc/ \\a/"), dir("abc/ \\a/"), ext("abc/ \\a/")], [" \\a", "abc/ \\a", ""]
