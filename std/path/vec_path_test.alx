  assert_eq is_abs("a/ /..a b/"), false
  assert_eq [base("//a.b/"), dir("//a.b/"), ext("//a.b/")], ["a.b", "/a.b", ""]
  assert_eq is_abs("//a.b/"), true
  assert_eq [base("\\/a/"), dir("\\/a/"), ext("\\/a/")], ["a", "\\/a", ""]
  assert_eq is_abs("\\/a/"), false
  assert_eq [base(".x\#{x}a.ba.b/"), dir(".x\#{x}a.ba.b/"), ext(".x\#{x}a.ba.b/")], [".x\#{x}a.ba.b", ".x\#{x}a.ba.b", ""]
  assert_eq is_abs(".x\#{x}a.ba.b/"), false
  assert_eq [base("a.b/../a b/./"), dir("a.b/../a b/./"), ext("a.b/../a b/./")], [".", "a b", ""]
  assert_eq is_abs("a.b/../a b/./"), false
  assert_eq [base("/.a.b.c/"), dir("/.a.b.c/"), ext("/.a.b.c/")], [".a.b.c", "/.a.b.c", ""]
  assert_eq is_abs("/.a.b.c/"), true
