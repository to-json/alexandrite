  assert_eq clean("\\.."), "\\.."
  assert_eq clean("日本.語a b/"), "日本.語a b"
  assert_eq clean(Str.from_bytes([97, 32, 98, 47, 255, 120, 46, 47, 47])), Str.from_bytes([97, 32, 98, 47, 255, 120, 46])
  assert_eq clean("a "), "a "
  assert_eq clean(Str.from_bytes([97, 32, 98, 47, 97, 195, 32, 47, 46, 97, 46, 98, 46, 99, 47, 97, 195, 47])), Str.from_bytes([97, 32, 98, 47, 97, 195, 32, 47, 46, 97, 46, 98, 46, 99, 47, 97, 195])
  assert_eq clean("éabc/.x /"), "éabc/.x "
  assert_eq clean("b/a/\#{x}"), "b/a/\#{x}"
  assert_eq clean("日本.語abc/...."), "日本.語abc/...."
  assert_eq clean(".../.a.b.c"), ".../.a.b.c"
  assert_eq clean("../x./"), "../x."
  assert_eq clean("a.b/abc/"), "a.b/abc"
  assert_eq clean("...日本.語/"), "...日本.語"
  assert_eq clean("x.../é/"), "x.../é"
  assert_eq clean(Str.from_bytes([47, 47, 47, 92, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 120, 46, 47])), Str.from_bytes([47, 92, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 120, 46])
  assert_eq clean(".xx./.éb/"), ".xx./.éb"
  assert_eq clean("/..日本.語"), "/..日本.語"
  assert_eq clean("../日本.語/./"), "../日本.語"
  assert_eq clean(" /a bx../"), " /a bx.."
  assert_eq clean("///../.a.b.c/..a.b/"), "/.a.b.c/..a.b"
  assert_eq clean(Str.from_bytes([97, 195, 195, 169])), Str.from_bytes([97, 195, 195, 169])
  assert_eq clean(".a.b.c/.../.../"), ".a.b.c/.../..."
  assert_eq clean("//abcabc/.../.a.b.c/"), "/abcabc/.../.a.b.c"
  assert_eq clean("a/ /\#{x}"), "a/ /\#{x}"
  assert_eq clean("é/...é////"), "é/...é"
  assert_eq clean("/x./"), "/x."
  assert_eq clean("\#{x}/a/日本.語/.x"), "\#{x}/a/日本.語/.x"
  assert_eq clean("é/./"), "é"
  assert_eq clean("\#{x}x./b/"), "\#{x}x./b"
  assert_eq clean("x./.a.b.cabc/"), "x./.a.b.cabc"
}

test "clean 5" {
  assert_eq clean(" /.a.b.c/.a.b.c/"), " /.a.b.c/.a.b.c"
  assert_eq clean("b/a/.x/\\/"), "b/a/.x/\\"
  assert_eq clean(Str.from_bytes([46, 120, 47, 97, 195])), Str.from_bytes([46, 120, 47, 97, 195])
  assert_eq clean("x./b/"), "x./b"
  assert_eq clean(" /é/abc////."), " /é/abc"
  assert_eq clean(" //"), " "
  assert_eq clean(Str.from_bytes([97, 195, 46, 47, 46, 97, 46, 98, 46, 99, 47, 92, 47])), Str.from_bytes([97, 195, 46, 47, 46, 97, 46, 98, 46, 99, 47, 92])
  assert_eq clean(Str.from_bytes([98, 47, 255, 47, 47, 98, 47])), Str.from_bytes([98, 47, 255, 47, 98])
