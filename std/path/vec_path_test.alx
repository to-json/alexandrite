  assert_eq split(Str.from_bytes([47, 32, 47, 97, 195, 46, 46, 47, 35, 123, 120, 125, 47])), (Str.from_bytes([47, 32, 47, 97, 195, 46, 46, 47, 35, 123, 120, 125, 47]), "")
  assert_eq split("x.a.b./"), ("x.a.b./", "")
  assert_eq split("b/a.b.x/é/b"), ("b/a.b.x/é/", "b")
