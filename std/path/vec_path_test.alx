  assert_eq clean("a.b///.x/"), "a.b/.x"
  assert_eq clean("aa b/../"), "."
  assert_eq clean("b/\#{x}abc/"), "b/\#{x}abc"
  assert_eq clean("日本.語/a/"), "日本.語/a"
  assert_eq clean("a.b/./.x/.a.b.c/x./"), "a.b/.x/.a.b.c/x."
