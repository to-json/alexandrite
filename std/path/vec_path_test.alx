  assert_eq split("b.a.b.c/"), ("b.a.b.c/", "")
  assert_eq split(".a.b.c/\#{x}/a/"), (".a.b.c/\#{x}/a/", "")
  assert_eq split("日本.語/\#{x}/../"), ("日本.語/\#{x}/../", "")
  assert_eq split("/abc "), ("/", "abc ")
  assert_eq split("bb/"), ("bb/", "")
  assert_eq split(Str.from_bytes([97, 195, 47, 97, 47, 97, 47, 98, 47])), (Str.from_bytes([97, 195, 47, 97, 47, 97, 47, 98, 47]), "")
  assert_eq split("\\x.//.a.b.c///"), ("\\x.//.a.b.c///", "")
  assert_eq split("//\\/.a.b.c"), ("//\\/", ".a.b.c")
  assert_eq split("//b/\\"), ("//b/", "\\")
  assert_eq split(Str.from_bytes([97, 46, 98, 47, 32, 47, 255])), ("a.b/ /", Str.from_bytes([255]))
  assert_eq split("b////日本.語/\#{x}"), ("b////日本.語/", "\#{x}")
  assert_eq split(Str.from_bytes([255, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47])), (Str.from_bytes([255, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47]), "")
  assert_eq split("..a.b/  /"), ("..a.b/  /", "")
  assert_eq split("b/a.b/b"), ("b/a.b/", "b")
  assert_eq split(".././a/abc /"), (".././a/abc /", "")
  assert_eq split("..///x.///.x/"), ("..///x.///.x/", "")
  assert_eq split("a/a/.x/"), ("a/a/.x/", "")
  assert_eq split(Str.from_bytes([47, 46, 46, 46, 35, 123, 120, 125, 47, 255, 47, 46, 46, 47])), (Str.from_bytes([47, 46, 46, 46, 35, 123, 120, 125, 47, 255, 47, 46, 46, 47]), "")
  assert_eq split("///a b/"), ("///a b/", "")
  assert_eq split(Str.from_bytes([255, 47, 46, 46, 46, 47])), (Str.from_bytes([255, 47, 46, 46, 46, 47]), "")
  assert_eq split("///é/"), ("///é/", "")
  assert_eq split("../x.////a/"), ("../x.////a/", "")
  assert_eq split("/abc.x/ /"), ("/abc.x/ /", "")
  assert_eq split(Str.from_bytes([97, 32, 98, 35, 123, 120, 125, 46, 120, 97, 195])), ("", Str.from_bytes([97, 32, 98, 35, 123, 120, 125, 46, 120, 97, 195]))
  assert_eq split("///."), ("///", ".")
  assert_eq split("é/\#{x}/ /a b/\#{x}"), ("é/\#{x}/ /a b/", "\#{x}")
  assert_eq split("日本.語/..."), ("日本.語/", "...")
  assert_eq split(Str.from_bytes([47, 47, 97, 195, 35, 123, 120, 125, 97, 46, 98, 47])), (Str.from_bytes([47, 47, 97, 195, 35, 123, 120, 125, 97, 46, 98, 47]), "")
  assert_eq split("/\#{x}/"), ("/\#{x}/", "")
  assert_eq split("\#{x}/a b/"), ("\#{x}/a b/", "")
  assert_eq split(Str.from_bytes([97, 255, 47, 47, 47, 47])), (Str.from_bytes([97, 255, 47, 47, 47, 47]), "")
  assert_eq split(".x\\/"), (".x\\/", "")
  assert_eq split("b/é/"), ("b/é/", "")
  assert_eq split(" /a.b////"), (" /a.b////", "")
  assert_eq split("b/b/日本.語/\#{x}/"), ("b/b/日本.語/\#{x}/", "")
  assert_eq split(".....//"), (".....//", "")
  assert_eq split(" /日本.語/"), (" /日本.語/", "")
  assert_eq split("a/ abc\#{x}"), ("a/", " abc\#{x}")
  assert_eq split(Str.from_bytes([46, 46, 47, 35, 123, 120, 125, 47, 97, 32, 98, 97, 195, 47])), (Str.from_bytes([46, 46, 47, 35, 123, 120, 125, 47, 97, 32, 98, 97, 195, 47]), "")
  assert_eq split(Str.from_bytes([195, 169, 255, 47])), (Str.from_bytes([195, 169, 255, 47]), "")
  assert_eq split("///x./x. /a"), ("///x./x. /", "a")
}

test "split 3" {
  assert_eq split("a.b/.xb"), ("a.b/", ".xb")
  assert_eq split("éabc///"), ("éabc///", "")
  assert_eq split("a./"), ("a./", "")
  assert_eq split("b../.../../"), ("b../.../../", "")
  assert_eq split(Str.from_bytes([255, 47, 92, 47])), (Str.from_bytes([255, 47, 92, 47]), "")
  assert_eq split(".a.b.c/\\/a.b/é/x./"), (".a.b.c/\\/a.b/é/x./", "")
  assert_eq split("b/b/"), ("b/b/", "")
  assert_eq split("\#{x}a b/\\"), ("\#{x}a b/", "\\")
  assert_eq split(".x/\#{x}/abc/"), (".x/\#{x}/abc/", "")
  assert_eq split(Str.from_bytes([46, 120, 47, 255, 47])), (Str.from_bytes([46, 120, 47, 255, 47]), "")
  assert_eq split("a/é/./"), ("a/é/./", "")
  assert_eq split("éa.b/ /.a.b.c/"), ("éa.b/ /.a.b.c/", "")
  assert_eq split("//\\a"), ("//", "\\a")
  assert_eq split("./\\/ ///"), ("./\\/ ///", "")
  assert_eq split(Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 47])), (Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 47]), "")
  assert_eq split("/b///.../"), ("/b///.../", "")
  assert_eq split(".../ /b/a b.x/"), (".../ /b/a b.x/", "")
  assert_eq split("/.../a.b/"), ("/.../a.b/", "")
  assert_eq split("éé/"), ("éé/", "")
  assert_eq split(Str.from_bytes([97, 98, 99, 47, 46, 46, 97, 195, 47])), (Str.from_bytes([97, 98, 99, 47, 46, 46, 97, 195, 47]), "")
  assert_eq split(".x/.a.b.c"), (".x/", ".a.b.c")
  assert_eq split(".../日本.語/../日本.語/"), (".../日本.語/../日本.語/", "")
  assert_eq split("a.b/日本.語.a.b.c\\"), ("a.b/", "日本.語.a.b.c\\")
  assert_eq split("//abc.a.b.c//.a.b.c/"), ("//abc.a.b.c//.a.b.c/", "")
  assert_eq split(".x/a.b/"), (".x/a.b/", "")
  assert_eq split("日本.語/..x.../"), ("日本.語/..x.../", "")
  assert_eq split("///a///日本.語"), ("///a///", "日本.語")
  assert_eq split("é//....////"), ("é//....////", "")
  assert_eq split(" /\\a.b/"), (" /\\a.b/", "")
  assert_eq split(" é//.a.b.ca/"), (" é//.a.b.ca/", "")
  assert_eq split("a/b../.a.b.c/../"), ("a/b../.a.b.c/../", "")
  assert_eq split("///.."), ("///", "..")
  assert_eq split(".../\#{x}x./"), (".../\#{x}x./", "")
  assert_eq split(Str.from_bytes([47, 97, 98, 99, 47, 97, 195, 195, 169])), ("/abc/", Str.from_bytes([97, 195, 195, 169]))
  assert_eq split("日本.語a.b/é/日本.語////"), ("日本.語a.b/é/日本.語////", "")
  assert_eq split("//\\/\#{x}////"), ("//\\/\#{x}////", "")
  assert_eq split("a/..../"), ("a/..../", "")
  assert_eq split(Str.from_bytes([97, 46, 98, 47, 255, 195, 169, 47, 46, 46, 46])), (Str.from_bytes([97, 46, 98, 47, 255, 195, 169, 47]), "...")
  assert_eq split(Str.from_bytes([97, 32, 98, 47, 97, 195, 47, 97, 47])), (Str.from_bytes([97, 32, 98, 47, 97, 195, 47, 97, 47]), "")
  assert_eq split("\\/ ///x./"), ("\\/ ///x./", "")
  assert_eq split(Str.from_bytes([97, 47, 46, 97, 46, 98, 46, 99, 255, 47])), (Str.from_bytes([97, 47, 46, 97, 46, 98, 46, 99, 255, 47]), "")
  assert_eq split("x.a b/a b/.a.b.c\#{x}"), ("x.a b/a b/", ".a.b.c\#{x}")
  assert_eq split(".x/abc/.../"), (".x/abc/.../", "")
  assert_eq split(" x./\#{x}/"), (" x./\#{x}/", "")
  assert_eq split("./.../..a b"), ("./.../", "..a b")
  assert_eq split(".a.b.c/././...a/"), (".a.b.c/././...a/", "")
  assert_eq split(Str.from_bytes([195, 169, 47, 97, 98, 99, 47, 46, 46, 47, 35, 123, 120, 125, 47, 255, 47])), (Str.from_bytes([195, 169, 47, 97, 98, 99, 47, 46, 46, 47, 35, 123, 120, 125, 47, 255, 47]), "")
  assert_eq split(Str.from_bytes([46, 97, 46, 98, 46, 99, 47, 47, 47, 98, 47, 255, 47])), (Str.from_bytes([46, 97, 46, 98, 46, 99, 47, 47, 47, 98, 47, 255, 47]), "")
  assert_eq split("./.b/日本.語/.a.b.c"), ("./.b/日本.語/", ".a.b.c")
  assert_eq split("/\\a.b/a/"), ("/\\a.b/a/", "")
  assert_eq split("..a.b.c/"), ("..a.b.c/", "")
  assert_eq split(".a.b.c/b/.a.b.c"), (".a.b.c/b/", ".a.b.c")
  assert_eq split(Str.from_bytes([97, 195, 255, 47, 46, 46, 46, 47, 46, 97, 46, 98, 46, 99, 47, 46, 46, 46, 47])), (Str.from_bytes([97, 195, 255, 47, 46, 46, 46, 47, 46, 97, 46, 98, 46, 99, 47, 46, 46, 46, 47]), "")
  assert_eq split("a.a.b.c.../a bé/"), ("a.a.b.c.../a bé/", "")
  assert_eq split(".a.b.c///"), (".a.b.c///", "")
  assert_eq split("日本.語/x./\#{x}"), ("日本.語/x./", "\#{x}")
  assert_eq split(Str.from_bytes([32, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 97, 32, 98, 97, 32, 98, 47])), (Str.from_bytes([32, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 97, 32, 98, 97, 32, 98, 47]), "")
  assert_eq split("\#{x}/a b../\#{x}/ /"), ("\#{x}/a b../\#{x}/ /", "")
  assert_eq split(".a.b.c/ ///é/"), (".a.b.c/ ///é/", "")
  assert_eq split(Str.from_bytes([97, 195, 47, 97, 32, 98, 46, 46, 46, 46, 120, 47, 97, 46, 98, 47])), (Str.from_bytes([97, 195, 47, 97, 32, 98, 46, 46, 46, 46, 120, 47, 97, 46, 98, 47]), "")
  assert_eq split(Str.from_bytes([98, 47, 46, 46, 46, 47, 255, 47, 97, 47])), (Str.from_bytes([98, 47, 46, 46, 46, 47, 255, 47, 97, 47]), "")
  assert_eq split(Str.from_bytes([97, 32, 98, 47, 195, 169, 46, 97, 46, 98, 46, 99, 46, 97, 46, 98, 46, 99, 255])), ("a b/", Str.from_bytes([195, 169, 46, 97, 46, 98, 46, 99, 46, 97, 46, 98, 46, 99, 255]))
  assert_eq split("//b/日本.語日本.語/.x/"), ("//b/日本.語日本.語/.x/", "")
  assert_eq split(".../日本.語\\/b/a.b/"), (".../日本.語\\/b/a.b/", "")
  assert_eq split("b/..a.b.c/é"), ("b/..a.b.c/", "é")
  assert_eq split(Str.from_bytes([46, 46, 47, 47, 97, 195, 47, 255])), (Str.from_bytes([46, 46, 47, 47, 97, 195, 47]), Str.from_bytes([255]))
  assert_eq split("b/a///a b"), ("b/a///", "a b")
  assert_eq split("\\a.b"), ("", "\\a.b")
  assert_eq split("///../"), ("///../", "")
  assert_eq split(Str.from_bytes([47, 47, 97, 195, 47, 46, 120, 47, 47, 98, 47])), (Str.from_bytes([47, 47, 97, 195, 47, 46, 120, 47, 47, 98, 47]), "")
  assert_eq split("..a.b.c"), ("", "..a.b.c")
  assert_eq split("日本.語///x."), ("日本.語///", "x.")
  assert_eq split("abc/ /aé/"), ("abc/ /aé/", "")
  assert_eq split("a b/a/ \\"), ("a b/a/", " \\")
  assert_eq split(".\#{x}a b/é/"), (".\#{x}a b/é/", "")
  assert_eq split(Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 255, 47, 46, 46, 46, 47])), (Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 255, 47, 46, 46, 46, 47]), "")
  assert_eq split("b\#{x}/a b"), ("b\#{x}/", "a b")
  assert_eq split("é/ /a/a b"), ("é/ /a/", "a b")
  assert_eq split(Str.from_bytes([46, 47, 120, 46, 97, 195, 46, 92, 47])), (Str.from_bytes([46, 47, 120, 46, 97, 195, 46, 92, 47]), "")
  assert_eq split("//\#{x}/x./.a.b.c/"), ("//\#{x}/x./.a.b.c/", "")
  assert_eq split(Str.from_bytes([97, 195, 47, 92, 47])), (Str.from_bytes([97, 195, 47, 92, 47]), "")
  assert_eq split("x.abc/\#{x}/./ /"), ("x.abc/\#{x}/./ /", "")
  assert_eq split(".x.x/"), (".x.x/", "")
  assert_eq split("日本.語/.x//"), ("日本.語/.x//", "")
  assert_eq split(".x.x"), ("", ".x.x")
  assert_eq split(Str.from_bytes([32, 46, 120, 255, 47])), (Str.from_bytes([32, 46, 120, 255, 47]), "")
  assert_eq split(".../.x/.a.b.c"), (".../.x/", ".a.b.c")
  assert_eq split(Str.from_bytes([97, 195, 97, 98, 99, 47, 47, 47, 35, 123, 120, 125, 47, 98, 47])), (Str.from_bytes([97, 195, 97, 98, 99, 47, 47, 47, 35, 123, 120, 125, 47, 98, 47]), "")
  assert_eq split(Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 35, 123, 120, 125, 47])), (Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 35, 123, 120, 125, 47]), "")
  assert_eq split("a.b/\\/a.b"), ("a.b/\\/", "a.b")
  assert_eq split(Str.from_bytes([46, 46, 46, 47, 92, 97, 195, 47])), (Str.from_bytes([46, 46, 46, 47, 92, 97, 195, 47]), "")
  assert_eq split(".a b/"), (".a b/", "")
  assert_eq split(Str.from_bytes([98, 47, 97, 46, 98, 255, 47, 46, 97, 46, 98, 46, 99, 47])), (Str.from_bytes([98, 47, 97, 46, 98, 255, 47, 46, 97, 46, 98, 46, 99, 47]), "")
  assert_eq split("../.a.b.cabc"), ("../", ".a.b.cabc")
  assert_eq split(Str.from_bytes([97, 47, 120, 46, 47, 46, 47, 97, 195])), ("a/x././", Str.from_bytes([97, 195]))
  assert_eq split(" /.////a.b/"), (" /.////a.b/", "")
  assert_eq split("日本.語/.a.b.c/\#{x}/./abc/"), ("日本.語/.a.b.c/\#{x}/./abc/", "")
  assert_eq split("..../ /.a.b.c/b/"), ("..../ /.a.b.c/b/", "")
  assert_eq split("a b./"), ("a b./", "")
  assert_eq split("b.x/"), ("b.x/", "")
}

test "base dir ext is_abs 1" {
  assert_eq [base(""), dir(""), ext("")], [".", ".", ""]
  assert_eq is_abs(""), false
  assert_eq [base("/"), dir("/"), ext("/")], ["/", "/", ""]
  assert_eq is_abs("/"), true
  assert_eq [base("//"), dir("//"), ext("//")], ["/", "/", ""]
  assert_eq is_abs("//"), true
  assert_eq [base("/../"), dir("/../"), ext("/../")], ["..", "/", ""]
  assert_eq is_abs("/../"), true
  assert_eq [base("a"), dir("a"), ext("a")], ["a", ".", ""]
  assert_eq is_abs("a"), false
  assert_eq [base("a/"), dir("a/"), ext("a/")], ["a", "a", ""]
  assert_eq is_abs("a/"), false
  assert_eq [base("/a"), dir("/a"), ext("/a")], ["a", "/", ""]
  assert_eq is_abs("/a"), true
  assert_eq [base("/a/a"), dir("/a/a"), ext("/a/a")], ["a", "/a", ""]
  assert_eq is_abs("/a/a"), true
  assert_eq [base("a/../a"), dir("a/../a"), ext("a/../a")], ["a", ".", ""]
  assert_eq is_abs("a/../a"), false
  assert_eq [base("b"), dir("b"), ext("b")], ["b", ".", ""]
  assert_eq is_abs("b"), false
  assert_eq [base("b/"), dir("b/"), ext("b/")], ["b", "b", ""]
  assert_eq is_abs("b/"), false
  assert_eq [base("/b"), dir("/b"), ext("/b")], ["b", "/", ""]
  assert_eq is_abs("/b"), true
  assert_eq [base("/b/b"), dir("/b/b"), ext("/b/b")], ["b", "/b", ""]
  assert_eq is_abs("/b/b"), true
  assert_eq [base("b/../b"), dir("b/../b"), ext("b/../b")], ["b", ".", ""]
  assert_eq is_abs("b/../b"), false
  assert_eq [base("abc"), dir("abc"), ext("abc")], ["abc", ".", ""]
  assert_eq is_abs("abc"), false
  assert_eq [base("abc/"), dir("abc/"), ext("abc/")], ["abc", "abc", ""]
  assert_eq is_abs("abc/"), false
  assert_eq [base("/abc"), dir("/abc"), ext("/abc")], ["abc", "/", ""]
  assert_eq is_abs("/abc"), true
  assert_eq [base("/abc/abc"), dir("/abc/abc"), ext("/abc/abc")], ["abc", "/abc", ""]
  assert_eq is_abs("/abc/abc"), true
  assert_eq [base("abc/../abc"), dir("abc/../abc"), ext("abc/../abc")], ["abc", ".", ""]
  assert_eq is_abs("abc/../abc"), false
  assert_eq [base("."), dir("."), ext(".")], [".", ".", "."]
  assert_eq is_abs("."), false
  assert_eq [base("./"), dir("./"), ext("./")], [".", ".", ""]
  assert_eq is_abs("./"), false
  assert_eq [base("/."), dir("/."), ext("/.")], [".", "/", "."]
  assert_eq is_abs("/."), true
  assert_eq [base("/./."), dir("/./."), ext("/./.")], [".", "/", "."]
  assert_eq is_abs("/./."), true
  assert_eq [base("./../."), dir("./../."), ext("./../.")], [".", "..", "."]
  assert_eq is_abs("./../."), false
  assert_eq [base(".."), dir(".."), ext("..")], ["..", ".", "."]
  assert_eq is_abs(".."), false
  assert_eq [base("../"), dir("../"), ext("../")], ["..", "..", ""]
  assert_eq is_abs("../"), false
  assert_eq [base("/.."), dir("/.."), ext("/..")], ["..", "/", "."]
  assert_eq is_abs("/.."), true
  assert_eq [base("/../.."), dir("/../.."), ext("/../..")], ["..", "/", "."]
  assert_eq is_abs("/../.."), true
  assert_eq [base("../../.."), dir("../../.."), ext("../../..")], ["..", "../..", "."]
  assert_eq is_abs("../../.."), false
  assert_eq [base("..."), dir("..."), ext("...")], ["...", ".", "."]
  assert_eq is_abs("..."), false
  assert_eq [base(".../"), dir(".../"), ext(".../")], ["...", "...", ""]
  assert_eq is_abs(".../"), false
  assert_eq [base("/..."), dir("/..."), ext("/...")], ["...", "/", "."]
  assert_eq is_abs("/..."), true
  assert_eq [base("/.../..."), dir("/.../..."), ext("/.../...")], ["...", "/...", "."]
  assert_eq is_abs("/.../..."), true
  assert_eq [base(".../../..."), dir(".../../..."), ext(".../../...")], ["...", ".", "."]
  assert_eq is_abs(".../../..."), false
  assert_eq [base("////"), dir("////"), ext("////")], ["/", "/", ""]
  assert_eq is_abs("////"), true
  assert_eq [base("//..//"), dir("//..//"), ext("//..//")], ["..", "/", ""]
  assert_eq is_abs("//..//"), true
  assert_eq [base("///"), dir("///"), ext("///")], ["/", "/", ""]
  assert_eq is_abs("///"), true
  assert_eq [base("//////"), dir("//////"), ext("//////")], ["/", "/", ""]
  assert_eq is_abs("//////"), true
  assert_eq [base("///..///"), dir("///..///"), ext("///..///")], ["..", "/", ""]
  assert_eq is_abs("///..///"), true
  assert_eq [base("a.b"), dir("a.b"), ext("a.b")], ["a.b", ".", ".b"]
  assert_eq is_abs("a.b"), false
  assert_eq [base("a.b/"), dir("a.b/"), ext("a.b/")], ["a.b", "a.b", ""]
  assert_eq is_abs("a.b/"), false
  assert_eq [base("/a.b"), dir("/a.b"), ext("/a.b")], ["a.b", "/", ".b"]
  assert_eq is_abs("/a.b"), true
  assert_eq [base("/a.b/a.b"), dir("/a.b/a.b"), ext("/a.b/a.b")], ["a.b", "/a.b", ".b"]
  assert_eq is_abs("/a.b/a.b"), true
  assert_eq [base("a.b/../a.b"), dir("a.b/../a.b"), ext("a.b/../a.b")], ["a.b", ".", ".b"]
  assert_eq is_abs("a.b/../a.b"), false
  assert_eq [base(".x"), dir(".x"), ext(".x")], [".x", ".", ".x"]
  assert_eq is_abs(".x"), false
  assert_eq [base(".x/"), dir(".x/"), ext(".x/")], [".x", ".x", ""]
  assert_eq is_abs(".x/"), false
  assert_eq [base("/.x"), dir("/.x"), ext("/.x")], [".x", "/", ".x"]
  assert_eq is_abs("/.x"), true
  assert_eq [base("/.x/.x"), dir("/.x/.x"), ext("/.x/.x")], [".x", "/.x", ".x"]
  assert_eq is_abs("/.x/.x"), true
  assert_eq [base(".x/../.x"), dir(".x/../.x"), ext(".x/../.x")], [".x", ".", ".x"]
  assert_eq is_abs(".x/../.x"), false
  assert_eq [base("x."), dir("x."), ext("x.")], ["x.", ".", "."]
  assert_eq is_abs("x."), false
}

test "base dir ext is_abs 2" {
  assert_eq [base("x./"), dir("x./"), ext("x./")], ["x.", "x.", ""]
  assert_eq is_abs("x./"), false
  assert_eq [base("/x."), dir("/x."), ext("/x.")], ["x.", "/", "."]
  assert_eq is_abs("/x."), true
  assert_eq [base("/x./x."), dir("/x./x."), ext("/x./x.")], ["x.", "/x.", "."]
  assert_eq is_abs("/x./x."), true
  assert_eq [base("x./../x."), dir("x./../x."), ext("x./../x.")], ["x.", ".", "."]
  assert_eq is_abs("x./../x."), false
  assert_eq [base("é"), dir("é"), ext("é")], ["é", ".", ""]
  assert_eq is_abs("é"), false
  assert_eq [base("é/"), dir("é/"), ext("é/")], ["é", "é", ""]
  assert_eq is_abs("é/"), false
  assert_eq [base("/é"), dir("/é"), ext("/é")], ["é", "/", ""]
  assert_eq is_abs("/é"), true
  assert_eq [base("/é/é"), dir("/é/é"), ext("/é/é")], ["é", "/é", ""]
  assert_eq is_abs("/é/é"), true
  assert_eq [base("é/../é"), dir("é/../é"), ext("é/../é")], ["é", ".", ""]
  assert_eq is_abs("é/../é"), false
  assert_eq [base("日本.語"), dir("日本.語"), ext("日本.語")], ["日本.語", ".", ".語"]
  assert_eq is_abs("日本.語"), false
  assert_eq [base("日本.語/"), dir("日本.語/"), ext("日本.語/")], ["日本.語", "日本.語", ""]
  assert_eq is_abs("日本.語/"), false
  assert_eq [base("/日本.語"), dir("/日本.語"), ext("/日本.語")], ["日本.語", "/", ".語"]
  assert_eq is_abs("/日本.語"), true
  assert_eq [base("/日本.語/日本.語"), dir("/日本.語/日本.語"), ext("/日本.語/日本.語")], ["日本.語", "/日本.語", ".語"]
  assert_eq is_abs("/日本.語/日本.語"), true
  assert_eq [base("日本.語/../日本.語"), dir("日本.語/../日本.語"), ext("日本.語/../日本.語")], ["日本.語", ".", ".語"]
  assert_eq is_abs("日本.語/../日本.語"), false
  assert_eq [base(Str.from_bytes([255])), dir(Str.from_bytes([255])), ext(Str.from_bytes([255]))], [Str.from_bytes([255]), ".", ""]
  assert_eq is_abs(Str.from_bytes([255])), false
  assert_eq [base(Str.from_bytes([255, 47])), dir(Str.from_bytes([255, 47])), ext(Str.from_bytes([255, 47]))], [Str.from_bytes([255]), Str.from_bytes([255]), ""]
  assert_eq is_abs(Str.from_bytes([255, 47])), false
  assert_eq [base(Str.from_bytes([47, 255])), dir(Str.from_bytes([47, 255])), ext(Str.from_bytes([47, 255]))], [Str.from_bytes([255]), "/", ""]
  assert_eq is_abs(Str.from_bytes([47, 255])), true
  assert_eq [base(Str.from_bytes([47, 255, 47, 255])), dir(Str.from_bytes([47, 255, 47, 255])), ext(Str.from_bytes([47, 255, 47, 255]))], [Str.from_bytes([255]), Str.from_bytes([47, 255]), ""]
  assert_eq is_abs(Str.from_bytes([47, 255, 47, 255])), true
  assert_eq [base(Str.from_bytes([255, 47, 46, 46, 47, 255])), dir(Str.from_bytes([255, 47, 46, 46, 47, 255])), ext(Str.from_bytes([255, 47, 46, 46, 47, 255]))], [Str.from_bytes([255]), ".", ""]
  assert_eq is_abs(Str.from_bytes([255, 47, 46, 46, 47, 255])), false
  assert_eq [base(Str.from_bytes([97, 195])), dir(Str.from_bytes([97, 195])), ext(Str.from_bytes([97, 195]))], [Str.from_bytes([97, 195]), ".", ""]
  assert_eq is_abs(Str.from_bytes([97, 195])), false
  assert_eq [base(Str.from_bytes([97, 195, 47])), dir(Str.from_bytes([97, 195, 47])), ext(Str.from_bytes([97, 195, 47]))], [Str.from_bytes([97, 195]), Str.from_bytes([97, 195]), ""]
  assert_eq is_abs(Str.from_bytes([97, 195, 47])), false
  assert_eq [base(Str.from_bytes([47, 97, 195])), dir(Str.from_bytes([47, 97, 195])), ext(Str.from_bytes([47, 97, 195]))], [Str.from_bytes([97, 195]), "/", ""]
  assert_eq is_abs(Str.from_bytes([47, 97, 195])), true
  assert_eq [base(Str.from_bytes([47, 97, 195, 47, 97, 195])), dir(Str.from_bytes([47, 97, 195, 47, 97, 195])), ext(Str.from_bytes([47, 97, 195, 47, 97, 195]))], [Str.from_bytes([97, 195]), Str.from_bytes([47, 97, 195]), ""]
  assert_eq is_abs(Str.from_bytes([47, 97, 195, 47, 97, 195])), true
  assert_eq [base(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195])), dir(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195])), ext(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195]))], [Str.from_bytes([97, 195]), ".", ""]
  assert_eq is_abs(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195])), false
  assert_eq [base(" "), dir(" "), ext(" ")], [" ", ".", ""]
  assert_eq is_abs(" "), false
  assert_eq [base(" /"), dir(" /"), ext(" /")], [" ", " ", ""]
  assert_eq is_abs(" /"), false
  assert_eq [base("/ "), dir("/ "), ext("/ ")], [" ", "/", ""]
  assert_eq is_abs("/ "), true
  assert_eq [base("/ / "), dir("/ / "), ext("/ / ")], [" ", "/ ", ""]
  assert_eq is_abs("/ / "), true
  assert_eq [base(" /../ "), dir(" /../ "), ext(" /../ ")], [" ", ".", ""]
  assert_eq is_abs(" /../ "), false
  assert_eq [base("a b"), dir("a b"), ext("a b")], ["a b", ".", ""]
  assert_eq is_abs("a b"), false
  assert_eq [base("a b/"), dir("a b/"), ext("a b/")], ["a b", "a b", ""]
  assert_eq is_abs("a b/"), false
  assert_eq [base("/a b"), dir("/a b"), ext("/a b")], ["a b", "/", ""]
  assert_eq is_abs("/a b"), true
  assert_eq [base("/a b/a b"), dir("/a b/a b"), ext("/a b/a b")], ["a b", "/a b", ""]
  assert_eq is_abs("/a b/a b"), true
  assert_eq [base("a b/../a b"), dir("a b/../a b"), ext("a b/../a b")], ["a b", ".", ""]
  assert_eq is_abs("a b/../a b"), false
  assert_eq [base("\#{x}"), dir("\#{x}"), ext("\#{x}")], ["\#{x}", ".", ""]
  assert_eq is_abs("\#{x}"), false
  assert_eq [base("\#{x}/"), dir("\#{x}/"), ext("\#{x}/")], ["\#{x}", "\#{x}", ""]
  assert_eq is_abs("\#{x}/"), false
  assert_eq [base("/\#{x}"), dir("/\#{x}"), ext("/\#{x}")], ["\#{x}", "/", ""]
  assert_eq is_abs("/\#{x}"), true
  assert_eq [base("/\#{x}/\#{x}"), dir("/\#{x}/\#{x}"), ext("/\#{x}/\#{x}")], ["\#{x}", "/\#{x}", ""]
  assert_eq is_abs("/\#{x}/\#{x}"), true
  assert_eq [base("\#{x}/../\#{x}"), dir("\#{x}/../\#{x}"), ext("\#{x}/../\#{x}")], ["\#{x}", ".", ""]
  assert_eq is_abs("\#{x}/../\#{x}"), false
  assert_eq [base("\\"), dir("\\"), ext("\\")], ["\\", ".", ""]
  assert_eq is_abs("\\"), false
  assert_eq [base("\\/"), dir("\\/"), ext("\\/")], ["\\", "\\", ""]
  assert_eq is_abs("\\/"), false
  assert_eq [base("/\\"), dir("/\\"), ext("/\\")], ["\\", "/", ""]
  assert_eq is_abs("/\\"), true
  assert_eq [base("/\\/\\"), dir("/\\/\\"), ext("/\\/\\")], ["\\", "/\\", ""]
  assert_eq is_abs("/\\/\\"), true
  assert_eq [base("\\/../\\"), dir("\\/../\\"), ext("\\/../\\")], ["\\", ".", ""]
  assert_eq is_abs("\\/../\\"), false
  assert_eq [base(".a.b.c"), dir(".a.b.c"), ext(".a.b.c")], [".a.b.c", ".", ".c"]
  assert_eq is_abs(".a.b.c"), false
  assert_eq [base(".a.b.c/"), dir(".a.b.c/"), ext(".a.b.c/")], [".a.b.c", ".a.b.c", ""]
  assert_eq is_abs(".a.b.c/"), false
  assert_eq [base("/.a.b.c"), dir("/.a.b.c"), ext("/.a.b.c")], [".a.b.c", "/", ".c"]
  assert_eq is_abs("/.a.b.c"), true
  assert_eq [base("/.a.b.c/.a.b.c"), dir("/.a.b.c/.a.b.c"), ext("/.a.b.c/.a.b.c")], [".a.b.c", "/.a.b.c", ".c"]
  assert_eq is_abs("/.a.b.c/.a.b.c"), true
  assert_eq [base(".a.b.c/../.a.b.c"), dir(".a.b.c/../.a.b.c"), ext(".a.b.c/../.a.b.c")], [".a.b.c", ".", ".c"]
  assert_eq is_abs(".a.b.c/../.a.b.c"), false
  assert_eq [base(Str.from_bytes([97, 46, 98, 47, 255, 47, 35, 123, 120, 125, 47, 46, 46, 47, 97, 195, 47])), dir(Str.from_bytes([97, 46, 98, 47, 255, 47, 35, 123, 120, 125, 47, 46, 46, 47, 97, 195, 47])), ext(Str.from_bytes([97, 46, 98, 47, 255, 47, 35, 123, 120, 125, 47, 46, 46, 47, 97, 195, 47]))], [Str.from_bytes([97, 195]), Str.from_bytes([97, 46, 98, 47, 255, 47, 97, 195]), ""]
  assert_eq is_abs(Str.from_bytes([97, 46, 98, 47, 255, 47, 35, 123, 120, 125, 47, 46, 46, 47, 97, 195, 47])), false
}

test "base dir ext is_abs 3" {
  assert_eq [base("x..a.b.c/../a.b/"), dir("x..a.b.c/../a.b/"), ext("x..a.b.c/../a.b/")], ["a.b", "a.b", ""]
  assert_eq is_abs("x..a.b.c/../a.b/"), false
  assert_eq [base(Str.from_bytes([97, 195, 47, 97, 47, 35, 123, 120, 125, 47])), dir(Str.from_bytes([97, 195, 47, 97, 47, 35, 123, 120, 125, 47])), ext(Str.from_bytes([97, 195, 47, 97, 47, 35, 123, 120, 125, 47]))], ["\#{x}", Str.from_bytes([97, 195, 47, 97, 47, 35, 123, 120, 125]), ""]
  assert_eq is_abs(Str.from_bytes([97, 195, 47, 97, 47, 35, 123, 120, 125, 47])), false
  assert_eq [base("x..a.b.c/\#{x}/.x/"), dir("x..a.b.c/\#{x}/.x/"), ext("x..a.b.c/\#{x}/.x/")], [".x", "x..a.b.c/\#{x}/.x", ""]
  assert_eq is_abs("x..a.b.c/\#{x}/.x/"), false
  assert_eq [base("日本.語a/日本.語"), dir("日本.語a/日本.語"), ext("日本.語a/日本.語")], ["日本.語", "日本.語a", ".語"]
  assert_eq is_abs("日本.語a/日本.語"), false
  assert_eq [base("//./"), dir("//./"), ext("//./")], [".", "/", ""]
  assert_eq is_abs("//./"), true
  assert_eq [base("abc/x.////"), dir("abc/x.////"), ext("abc/x.////")], ["x.", "abc/x.", ""]
  assert_eq is_abs("abc/x.////"), false
  assert_eq [base("a///"), dir("a///"), ext("a///")], ["a", "a", ""]
  assert_eq is_abs("a///"), false
  assert_eq [base("\#{x}///.."), dir("\#{x}///.."), ext("\#{x}///..")], ["..", "\#{x}", "."]
  assert_eq is_abs("\#{x}///.."), false
  assert_eq [base("//../x./"), dir("//../x./"), ext("//../x./")], ["x.", "/x.", ""]
  assert_eq is_abs("//../x./"), true
  assert_eq [base("\\/.x\\..../"), dir("\\/.x\\..../"), ext("\\/.x\\..../")], [".x\\....", "\\/.x\\....", ""]
  assert_eq is_abs("\\/.x\\..../"), false
  assert_eq [base(".../é/"), dir(".../é/"), ext(".../é/")], ["é", ".../é", ""]
  assert_eq is_abs(".../é/"), false
  assert_eq [base("a b/a\\////"), dir("a b/a\\////"), ext("a b/a\\////")], ["a\\", "a b/a\\", ""]
  assert_eq is_abs("a b/a\\////"), false
  assert_eq [base("abc/日本.語.../"), dir("abc/日本.語.../"), ext("abc/日本.語.../")], ["日本.語...", "abc/日本.語...", ""]
  assert_eq is_abs("abc/日本.語.../"), false
  assert_eq [base("./\#{x}\#{x}/..日本.語/"), dir("./\#{x}\#{x}/..日本.語/"), ext("./\#{x}\#{x}/..日本.語/")], ["..日本.語", "\#{x}\#{x}/..日本.語", ""]
  assert_eq is_abs("./\#{x}\#{x}/..日本.語/"), false
  assert_eq [base("abcabc/"), dir("abcabc/"), ext("abcabc/")], ["abcabc", "abcabc", ""]
  assert_eq is_abs("abcabc/"), false
  assert_eq [base(Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 120, 46, 47, 255, 47, 97, 32, 98, 47])), dir(Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 120, 46, 47, 255, 47, 97, 32, 98, 47])), ext(Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 120, 46, 47, 255, 47, 97, 32, 98, 47]))], ["a b", Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 120, 46, 47, 255, 47, 97, 32, 98]), ""]
  assert_eq is_abs(Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 120, 46, 47, 255, 47, 97, 32, 98, 47])), false
  assert_eq [base(Str.from_bytes([46, 120, 47, 255, 47, 47])), dir(Str.from_bytes([46, 120, 47, 255, 47, 47])), ext(Str.from_bytes([46, 120, 47, 255, 47, 47]))], [Str.from_bytes([255]), Str.from_bytes([46, 120, 47, 255]), ""]
  assert_eq is_abs(Str.from_bytes([46, 120, 47, 255, 47, 47])), false
  assert_eq [base(Str.from_bytes([47, 32, 47, 97, 195, 46, 46, 47, 35, 123, 120, 125, 47])), dir(Str.from_bytes([47, 32, 47, 97, 195, 46, 46, 47, 35, 123, 120, 125, 47])), ext(Str.from_bytes([47, 32, 47, 97, 195, 46, 46, 47, 35, 123, 120, 125, 47]))], ["\#{x}", Str.from_bytes([47, 32, 47, 97, 195, 46, 46, 47, 35, 123, 120, 125]), ""]
  assert_eq is_abs(Str.from_bytes([47, 32, 47, 97, 195, 46, 46, 47, 35, 123, 120, 125, 47])), true
  assert_eq [base("x.a.b./"), dir("x.a.b./"), ext("x.a.b./")], ["x.a.b.", "x.a.b.", ""]
  assert_eq is_abs("x.a.b./"), false
