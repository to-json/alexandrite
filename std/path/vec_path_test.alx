  assert_eq is_abs("日本.語/..."), false
  assert_eq [base(Str.from_bytes([47, 47, 97, 195, 35, 123, 120, 125, 97, 46, 98, 47])), dir(Str.from_bytes([47, 47, 97, 195, 35, 123, 120, 125, 97, 46, 98, 47])), ext(Str.from_bytes([47, 47, 97, 195, 35, 123, 120, 125, 97, 46, 98, 47]))], [Str.from_bytes([97, 195, 35, 123, 120, 125, 97, 46, 98]), Str.from_bytes([47, 97, 195, 35, 123, 120, 125, 97, 46, 98]), ""]
  assert_eq is_abs(Str.from_bytes([47, 47, 97, 195, 35, 123, 120, 125, 97, 46, 98, 47])), true
