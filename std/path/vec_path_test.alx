  assert_eq is_abs(Str.from_bytes([47, 46, 46, 46, 35, 123, 120, 125, 47, 255, 47, 46, 46, 47])), true
  assert_eq [base("///a b/"), dir("///a b/"), ext("///a b/")], ["a b", "/a b", ""]
  assert_eq is_abs("///a b/"), true
  assert_eq [base(Str.from_bytes([255, 47, 46, 46, 46, 47])), dir(Str.from_bytes([255, 47, 46, 46, 46, 47])), ext(Str.from_bytes([255, 47, 46, 46, 46, 47]))], ["...", Str.from_bytes([255, 47, 46, 46, 46]), ""]
  assert_eq is_abs(Str.from_bytes([255, 47, 46, 46, 46, 47])), false
  assert_eq [base("///é/"), dir("///é/"), ext("///é/")], ["é", "/é", ""]
  assert_eq is_abs("///é/"), true
  assert_eq [base("../x.////a/"), dir("../x.////a/"), ext("../x.////a/")], ["a", "../x./a", ""]
  assert_eq is_abs("../x.////a/"), false
  assert_eq [base("/abc.x/ /"), dir("/abc.x/ /"), ext("/abc.x/ /")], [" ", "/abc.x/ ", ""]
  assert_eq is_abs("/abc.x/ /"), true
  assert_eq [base(Str.from_bytes([97, 32, 98, 35, 123, 120, 125, 46, 120, 97, 195])), dir(Str.from_bytes([97, 32, 98, 35, 123, 120, 125, 46, 120, 97, 195])), ext(Str.from_bytes([97, 32, 98, 35, 123, 120, 125, 46, 120, 97, 195]))], [Str.from_bytes([97, 32, 98, 35, 123, 120, 125, 46, 120, 97, 195]), ".", Str.from_bytes([46, 120, 97, 195])]
  assert_eq is_abs(Str.from_bytes([97, 32, 98, 35, 123, 120, 125, 46, 120, 97, 195])), false
  assert_eq [base("///."), dir("///."), ext("///.")], [".", "/", "."]
  assert_eq is_abs("///."), true
  assert_eq [base("é/\#{x}/ /a b/\#{x}"), dir("é/\#{x}/ /a b/\#{x}"), ext("é/\#{x}/ /a b/\#{x}")], ["\#{x}", "é/\#{x}/ /a b", ""]
