  assert_eq clean(Str.from_bytes([46, 46, 98, 97, 46, 98, 255, 47, 97, 98, 99, 47])), Str.from_bytes([46, 46, 98, 97, 46, 98, 255, 47, 97, 98, 99])
  assert_eq clean(".x///.a.b.c/../b/"), ".x/b"
  assert_eq clean(Str.from_bytes([255, 97, 98, 99, 47])), Str.from_bytes([255, 97, 98, 99])
  assert_eq clean(Str.from_bytes([255, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47])), Str.from_bytes([255, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158])
  assert_eq clean("\\..x./ /日本.語"), "\\..x./ /日本.語"
  assert_eq clean("é/../b/ a b/"), "b/ a b"
  assert_eq clean(Str.from_bytes([97, 195, 47, 97, 98, 99, 97, 195, 97, 98, 99, 47])), Str.from_bytes([97, 195, 47, 97, 98, 99, 97, 195, 97, 98, 99])
  assert_eq clean(" /\#{x}/"), " /\#{x}"
  assert_eq clean(Str.from_bytes([92, 47, 255, 47, 98, 47])), Str.from_bytes([92, 47, 255, 47, 98])
  assert_eq clean(".a.b.c/b/"), ".a.b.c/b"
  assert_eq clean("./é/"), "é"
  assert_eq clean("x./abc/"), "x./abc"
  assert_eq clean(".a.b.c/\\/ /b/"), ".a.b.c/\\/ /b"
  assert_eq clean(Str.from_bytes([97, 195, 47, 46, 97, 46, 98, 46, 99, 47, 47, 47, 47, 97, 32, 98, 47])), Str.from_bytes([97, 195, 47, 46, 97, 46, 98, 46, 99, 47, 97, 32, 98])
  assert_eq clean("///x./"), "/x."
  assert_eq clean(Str.from_bytes([98, 97, 195, 47, 46, 46, 46, 47, 120, 46, 47, 97])), Str.from_bytes([98, 97, 195, 47, 46, 46, 46, 47, 120, 46, 47, 97])
  assert_eq clean("\\é////"), "\\é"
  assert_eq clean(Str.from_bytes([255, 47, 47, 47, 97, 47, 195, 169])), Str.from_bytes([255, 47, 97, 47, 195, 169])
  assert_eq clean(".x/// /"), ".x/ "
  assert_eq clean(Str.from_bytes([97, 98, 99, 47, 97, 195, 47])), Str.from_bytes([97, 98, 99, 47, 97, 195])
  assert_eq clean("a b/x./abc"), "a b/x./abc"
  assert_eq clean(Str.from_bytes([46, 120, 47, 47, 255, 47])), Str.from_bytes([46, 120, 47, 255])
  assert_eq clean(Str.from_bytes([97, 195, 120, 46, 97, 32, 98, 47, 46, 120, 47, 97, 195])), Str.from_bytes([97, 195, 120, 46, 97, 32, 98, 47, 46, 120, 47, 97, 195])
  assert_eq clean(Str.from_bytes([255, 47, 46, 97, 46, 98, 46, 99, 47, 98, 97, 195, 120, 46, 47])), Str.from_bytes([255, 47, 46, 97, 46, 98, 46, 99, 47, 98, 97, 195, 120, 46])
  assert_eq clean("//.a.b.c/"), "/.a.b.c"
  assert_eq clean(Str.from_bytes([32, 47, 46, 46, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 47])), Str.from_bytes([32, 47, 46, 46, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195])
  assert_eq clean(Str.from_bytes([255, 47, 120, 46, 47])), Str.from_bytes([255, 47, 120, 46])
  assert_eq clean("../b/日本.語a.b"), "../b/日本.語a.b"
  assert_eq clean("a.b/./x./\\a b/"), "a.b/x./\\a b"
  assert_eq clean(Str.from_bytes([255, 97, 195, 169, 47, 97, 32, 98, 47])), Str.from_bytes([255, 97, 195, 169, 47, 97, 32, 98])
  assert_eq clean(Str.from_bytes([46, 46, 47, 120, 46, 47, 255, 255, 47])), Str.from_bytes([46, 46, 47, 120, 46, 47, 255, 255])
  assert_eq clean(Str.from_bytes([92, 32, 47, 46, 47, 255, 47, 255, 47])), Str.from_bytes([92, 32, 47, 255, 47, 255])
  assert_eq clean("a/\#{x}//abc/"), "a/\#{x}/abc"
  assert_eq clean(Str.from_bytes([46, 47, 255, 47, 47, 47])), Str.from_bytes([255])
  assert_eq clean("//../a/"), "/a"
  assert_eq clean("///\\a"), "/\\a"
  assert_eq clean(Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 47, 47, 255, 47, 46, 46, 47])), "日本.語"
  assert_eq clean("//.../...../\#{x}/"), "/.../...../\#{x}"
  assert_eq clean("日本.語a ba/.a.b.c"), "日本.語a ba/.a.b.c"
  assert_eq clean(".x/x.a.b/ /"), ".x/x.a.b/ "
  assert_eq clean("b../"), "b.."
  assert_eq clean(Str.from_bytes([47, 47, 35, 123, 120, 125, 47, 255])), Str.from_bytes([47, 35, 123, 120, 125, 47, 255])
  assert_eq clean("日本.語é....../"), "日本.語é......"
  assert_eq clean("abc/a.b/.."), "abc"
  assert_eq clean("b//./"), "b"
  assert_eq clean("b/日本.語\#{x}/\\/"), "b/日本.語\#{x}/\\"
  assert_eq clean("//..\\/"), "/..\\"
  assert_eq clean(Str.from_bytes([97, 195, 47, 46, 47, 46, 120, 47, 47])), Str.from_bytes([97, 195, 47, 46, 120])
  assert_eq clean("\\/abc/.x/"), "\\/abc/.x"
  assert_eq clean(".x/\\/日本.語a.b/"), ".x/\\/日本.語a.b"
  assert_eq clean("\#{x}//é/.x/"), "\#{x}/é/.x"
  assert_eq clean(Str.from_bytes([47, 47, 92, 97, 195, 47, 97, 98, 99, 47])), Str.from_bytes([47, 92, 97, 195, 47, 97, 98, 99])
  assert_eq clean("a.a.b.c\#{x}/"), "a.a.b.c\#{x}"
  assert_eq clean(Str.from_bytes([92, 97, 195, 47, 195, 169, 47, 46, 47])), Str.from_bytes([92, 97, 195, 47, 195, 169])
  assert_eq clean("a.b/abc/.x/"), "a.b/abc/.x"
  assert_eq clean(Str.from_bytes([92, 97, 32, 98, 97, 195, 97, 46, 98])), Str.from_bytes([92, 97, 32, 98, 97, 195, 97, 46, 98])
  assert_eq clean("x./\\.../b/a/"), "x./\\.../b/a"
  assert_eq clean("x../.../"), "x../..."
  assert_eq clean("b/a.b/\#{x}/"), "b/a.b/\#{x}"
  assert_eq clean("日本.語/é/./"), "日本.語/é"
  assert_eq clean(".a.b.c/\\"), ".a.b.c/\\"
  assert_eq clean("bé/x./../"), "bé"
  assert_eq clean(" /x./"), " /x."
  assert_eq clean(Str.from_bytes([46, 120, 47, 35, 123, 120, 125, 255, 47, 47, 97, 32, 98, 47])), Str.from_bytes([46, 120, 47, 35, 123, 120, 125, 255, 47, 97, 32, 98])
  assert_eq clean(".a.b.cabc/"), ".a.b.cabc"
  assert_eq clean(".a/x."), ".a/x."
  assert_eq clean(Str.from_bytes([97, 46, 98, 255, 47, 98, 47, 35, 123, 120, 125, 35, 123, 120, 125, 47])), Str.from_bytes([97, 46, 98, 255, 47, 98, 47, 35, 123, 120, 125, 35, 123, 120, 125])
  assert_eq clean("//x./"), "/x."
  assert_eq clean(".a.b.c./"), ".a.b.c."
  assert_eq clean("/a/"), "/a"
  assert_eq clean(Str.from_bytes([46, 47, 46, 120, 47, 32, 47, 255, 47, 47])), Str.from_bytes([46, 120, 47, 32, 47, 255])
  assert_eq clean("a.x/a.b.a.b.c/"), "a.x/a.b.a.b.c"
  assert_eq clean("bx./abc"), "bx./abc"
  assert_eq clean("x...."), "x...."
  assert_eq clean("../abc"), "../abc"
  assert_eq clean(Str.from_bytes([255, 47, 97, 32, 98, 47])), Str.from_bytes([255, 47, 97, 32, 98])
  assert_eq clean("x./..."), "x./..."
  assert_eq clean("a/日本.語/b"), "a/日本.語/b"
  assert_eq clean("/a.b/.../"), "/a.b/..."
  assert_eq clean(" ///日本.語/日本.語"), " /日本.語/日本.語"
  assert_eq clean("日本.語/a.b/ ///\#{x}"), "日本.語/a.b/ /\#{x}"
  assert_eq clean("\#{x}/\\a b/日本.語b/"), "\#{x}/\\a b/日本.語b"
  assert_eq clean(".x/é/é/"), ".x/é/é"
  assert_eq clean("x.x./"), "x.x."
  assert_eq clean(Str.from_bytes([97, 195, 47, 47])), Str.from_bytes([97, 195])
  assert_eq clean("\#{x}/.a.b.c"), "\#{x}/.a.b.c"
  assert_eq clean("é/.a.b.c/.."), "é"
  assert_eq clean("/b日本.語"), "/b日本.語"
  assert_eq clean("日本.語./x./"), "日本.語./x."
  assert_eq clean(".x/x./"), ".x/x."
  assert_eq clean("\#{x}///"), "\#{x}"
}

test "split 1" {
  assert_eq split(""), ("", "")
  assert_eq split("/"), ("/", "")
  assert_eq split("//"), ("//", "")
  assert_eq split("/../"), ("/../", "")
  assert_eq split("a"), ("", "a")
  assert_eq split("a/"), ("a/", "")
  assert_eq split("/a"), ("/", "a")
  assert_eq split("/a/a"), ("/a/", "a")
  assert_eq split("a/../a"), ("a/../", "a")
  assert_eq split("b"), ("", "b")
  assert_eq split("b/"), ("b/", "")
  assert_eq split("/b"), ("/", "b")
  assert_eq split("/b/b"), ("/b/", "b")
  assert_eq split("b/../b"), ("b/../", "b")
  assert_eq split("abc"), ("", "abc")
  assert_eq split("abc/"), ("abc/", "")
  assert_eq split("/abc"), ("/", "abc")
  assert_eq split("/abc/abc"), ("/abc/", "abc")
  assert_eq split("abc/../abc"), ("abc/../", "abc")
  assert_eq split("."), ("", ".")
  assert_eq split("./"), ("./", "")
  assert_eq split("/."), ("/", ".")
  assert_eq split("/./."), ("/./", ".")
  assert_eq split("./../."), ("./../", ".")
  assert_eq split(".."), ("", "..")
  assert_eq split("../"), ("../", "")
  assert_eq split("/.."), ("/", "..")
  assert_eq split("/../.."), ("/../", "..")
  assert_eq split("../../.."), ("../../", "..")
  assert_eq split("..."), ("", "...")
  assert_eq split(".../"), (".../", "")
  assert_eq split("/..."), ("/", "...")
  assert_eq split("/.../..."), ("/.../", "...")
  assert_eq split(".../../..."), (".../../", "...")
  assert_eq split("////"), ("////", "")
  assert_eq split("//..//"), ("//..//", "")
  assert_eq split("///"), ("///", "")
  assert_eq split("//////"), ("//////", "")
  assert_eq split("///..///"), ("///..///", "")
  assert_eq split("a.b"), ("", "a.b")
  assert_eq split("a.b/"), ("a.b/", "")
  assert_eq split("/a.b"), ("/", "a.b")
  assert_eq split("/a.b/a.b"), ("/a.b/", "a.b")
  assert_eq split("a.b/../a.b"), ("a.b/../", "a.b")
  assert_eq split(".x"), ("", ".x")
  assert_eq split(".x/"), (".x/", "")
  assert_eq split("/.x"), ("/", ".x")
  assert_eq split("/.x/.x"), ("/.x/", ".x")
  assert_eq split(".x/../.x"), (".x/../", ".x")
  assert_eq split("x."), ("", "x.")
  assert_eq split("x./"), ("x./", "")
  assert_eq split("/x."), ("/", "x.")
  assert_eq split("/x./x."), ("/x./", "x.")
  assert_eq split("x./../x."), ("x./../", "x.")
  assert_eq split("é"), ("", "é")
  assert_eq split("é/"), ("é/", "")
  assert_eq split("/é"), ("/", "é")
  assert_eq split("/é/é"), ("/é/", "é")
  assert_eq split("é/../é"), ("é/../", "é")
  assert_eq split("日本.語"), ("", "日本.語")
  assert_eq split("日本.語/"), ("日本.語/", "")
  assert_eq split("/日本.語"), ("/", "日本.語")
  assert_eq split("/日本.語/日本.語"), ("/日本.語/", "日本.語")
  assert_eq split("日本.語/../日本.語"), ("日本.語/../", "日本.語")
  assert_eq split(Str.from_bytes([255])), ("", Str.from_bytes([255]))
  assert_eq split(Str.from_bytes([255, 47])), (Str.from_bytes([255, 47]), "")
  assert_eq split(Str.from_bytes([47, 255])), ("/", Str.from_bytes([255]))
  assert_eq split(Str.from_bytes([47, 255, 47, 255])), (Str.from_bytes([47, 255, 47]), Str.from_bytes([255]))
  assert_eq split(Str.from_bytes([255, 47, 46, 46, 47, 255])), (Str.from_bytes([255, 47, 46, 46, 47]), Str.from_bytes([255]))
  assert_eq split(Str.from_bytes([97, 195])), ("", Str.from_bytes([97, 195]))
  assert_eq split(Str.from_bytes([97, 195, 47])), (Str.from_bytes([97, 195, 47]), "")
  assert_eq split(Str.from_bytes([47, 97, 195])), ("/", Str.from_bytes([97, 195]))
  assert_eq split(Str.from_bytes([47, 97, 195, 47, 97, 195])), (Str.from_bytes([47, 97, 195, 47]), Str.from_bytes([97, 195]))
  assert_eq split(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195])), (Str.from_bytes([97, 195, 47, 46, 46, 47]), Str.from_bytes([97, 195]))
  assert_eq split(" "), ("", " ")
  assert_eq split(" /"), (" /", "")
  assert_eq split("/ "), ("/", " ")
  assert_eq split("/ / "), ("/ /", " ")
  assert_eq split(" /../ "), (" /../", " ")
  assert_eq split("a b"), ("", "a b")
  assert_eq split("a b/"), ("a b/", "")
  assert_eq split("/a b"), ("/", "a b")
  assert_eq split("/a b/a b"), ("/a b/", "a b")
  assert_eq split("a b/../a b"), ("a b/../", "a b")
  assert_eq split("\#{x}"), ("", "\#{x}")
  assert_eq split("\#{x}/"), ("\#{x}/", "")
  assert_eq split("/\#{x}"), ("/", "\#{x}")
  assert_eq split("/\#{x}/\#{x}"), ("/\#{x}/", "\#{x}")
  assert_eq split("\#{x}/../\#{x}"), ("\#{x}/../", "\#{x}")
  assert_eq split("\\"), ("", "\\")
  assert_eq split("\\/"), ("\\/", "")
  assert_eq split("/\\"), ("/", "\\")
  assert_eq split("/\\/\\"), ("/\\/", "\\")
  assert_eq split("\\/../\\"), ("\\/../", "\\")
  assert_eq split(".a.b.c"), ("", ".a.b.c")
  assert_eq split(".a.b.c/"), (".a.b.c/", "")
  assert_eq split("/.a.b.c"), ("/", ".a.b.c")
  assert_eq split("/.a.b.c/.a.b.c"), ("/.a.b.c/", ".a.b.c")
  assert_eq split(".a.b.c/../.a.b.c"), (".a.b.c/../", ".a.b.c")
  assert_eq split(Str.from_bytes([97, 46, 98, 47, 255, 47, 35, 123, 120, 125, 47, 46, 46, 47, 97, 195, 47])), (Str.from_bytes([97, 46, 98, 47, 255, 47, 35, 123, 120, 125, 47, 46, 46, 47, 97, 195, 47]), "")
}

test "split 2" {
  assert_eq split("x..a.b.c/../a.b/"), ("x..a.b.c/../a.b/", "")
  assert_eq split(Str.from_bytes([97, 195, 47, 97, 47, 35, 123, 120, 125, 47])), (Str.from_bytes([97, 195, 47, 97, 47, 35, 123, 120, 125, 47]), "")
  assert_eq split("x..a.b.c/\#{x}/.x/"), ("x..a.b.c/\#{x}/.x/", "")
  assert_eq split("日本.語a/日本.語"), ("日本.語a/", "日本.語")
  assert_eq split("//./"), ("//./", "")
  assert_eq split("abc/x.////"), ("abc/x.////", "")
  assert_eq split("a///"), ("a///", "")
