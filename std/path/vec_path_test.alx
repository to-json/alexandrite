  assert_eq split(Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 120, 46, 47, 255, 47, 97, 32, 98, 47])), (Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 120, 46, 47, 255, 47, 97, 32, 98, 47]), "")
