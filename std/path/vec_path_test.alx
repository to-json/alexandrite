# Generated from Go's path (`go run` in a scratch directory); do not edit by hand.
# chk_match's want: 0 no match, 1 match, 2 ErrBadPattern.

#[track_caller]
def chk_match(pattern: Str, name: Str, want: Int) {
  r = match(pattern, name)
  got = 0
  if e = r.err {
    assert_eq e.message, "syntax error in pattern"
    got = 2
  } else if r.unwrap {
    got = 1
  }
  assert got == want, format("match(%q, %q) = %d, want %d at %s", pattern, name, got, want, caller_location)
}

test "clean 1" {
  assert_eq clean(""), "."
  assert_eq clean("/"), "/"
  assert_eq clean("//"), "/"
  assert_eq clean("/../"), "/"
  assert_eq clean("a"), "a"
  assert_eq clean("a/"), "a"
  assert_eq clean("/a"), "/a"
  assert_eq clean("/a/a"), "/a/a"
  assert_eq clean("a/../a"), "a"
  assert_eq clean("b"), "b"
  assert_eq clean("b/"), "b"
  assert_eq clean("/b"), "/b"
  assert_eq clean("/b/b"), "/b/b"
  assert_eq clean("b/../b"), "b"
  assert_eq clean("abc"), "abc"
  assert_eq clean("abc/"), "abc"
  assert_eq clean("/abc"), "/abc"
  assert_eq clean("/abc/abc"), "/abc/abc"
  assert_eq clean("abc/../abc"), "abc"
  assert_eq clean("."), "."
  assert_eq clean("./"), "."
  assert_eq clean("/."), "/"
  assert_eq clean("/./."), "/"
  assert_eq clean("./../."), ".."
  assert_eq clean(".."), ".."
  assert_eq clean("../"), ".."
  assert_eq clean("/.."), "/"
  assert_eq clean("/../.."), "/"
  assert_eq clean("../../.."), "../../.."
  assert_eq clean("..."), "..."
  assert_eq clean(".../"), "..."
  assert_eq clean("/..."), "/..."
  assert_eq clean("/.../..."), "/.../..."
  assert_eq clean(".../../..."), "..."
  assert_eq clean("////"), "/"
  assert_eq clean("//..//"), "/"
  assert_eq clean("///"), "/"
  assert_eq clean("//////"), "/"
  assert_eq clean("///..///"), "/"
  assert_eq clean("a.b"), "a.b"
  assert_eq clean("a.b/"), "a.b"
  assert_eq clean("/a.b"), "/a.b"
  assert_eq clean("/a.b/a.b"), "/a.b/a.b"
  assert_eq clean("a.b/../a.b"), "a.b"
  assert_eq clean(".x"), ".x"
  assert_eq clean(".x/"), ".x"
  assert_eq clean("/.x"), "/.x"
  assert_eq clean("/.x/.x"), "/.x/.x"
  assert_eq clean(".x/../.x"), ".x"
  assert_eq clean("x."), "x."
  assert_eq clean("x./"), "x."
  assert_eq clean("/x."), "/x."
  assert_eq clean("/x./x."), "/x./x."
  assert_eq clean("x./../x."), "x."
  assert_eq clean("é"), "é"
  assert_eq clean("é/"), "é"
  assert_eq clean("/é"), "/é"
  assert_eq clean("/é/é"), "/é/é"
  assert_eq clean("é/../é"), "é"
  assert_eq clean("日本.語"), "日本.語"
  assert_eq clean("日本.語/"), "日本.語"
  assert_eq clean("/日本.語"), "/日本.語"
  assert_eq clean("/日本.語/日本.語"), "/日本.語/日本.語"
  assert_eq clean("日本.語/../日本.語"), "日本.語"
  assert_eq clean(Str.from_bytes([255])), Str.from_bytes([255])
  assert_eq clean(Str.from_bytes([255, 47])), Str.from_bytes([255])
  assert_eq clean(Str.from_bytes([47, 255])), Str.from_bytes([47, 255])
  assert_eq clean(Str.from_bytes([47, 255, 47, 255])), Str.from_bytes([47, 255, 47, 255])
  assert_eq clean(Str.from_bytes([255, 47, 46, 46, 47, 255])), Str.from_bytes([255])
  assert_eq clean(Str.from_bytes([97, 195])), Str.from_bytes([97, 195])
  assert_eq clean(Str.from_bytes([97, 195, 47])), Str.from_bytes([97, 195])
  assert_eq clean(Str.from_bytes([47, 97, 195])), Str.from_bytes([47, 97, 195])
  assert_eq clean(Str.from_bytes([47, 97, 195, 47, 97, 195])), Str.from_bytes([47, 97, 195, 47, 97, 195])
  assert_eq clean(Str.from_bytes([97, 195, 47, 46, 46, 47, 97, 195])), Str.from_bytes([97, 195])
  assert_eq clean(" "), " "
  assert_eq clean(" /"), " "
  assert_eq clean("/ "), "/ "
  assert_eq clean("/ / "), "/ / "
  assert_eq clean(" /../ "), " "
  assert_eq clean("a b"), "a b"
  assert_eq clean("a b/"), "a b"
  assert_eq clean("/a b"), "/a b"
  assert_eq clean("/a b/a b"), "/a b/a b"
  assert_eq clean("a b/../a b"), "a b"
  assert_eq clean("\#{x}"), "\#{x}"
  assert_eq clean("\#{x}/"), "\#{x}"
  assert_eq clean("/\#{x}"), "/\#{x}"
  assert_eq clean("/\#{x}/\#{x}"), "/\#{x}/\#{x}"
  assert_eq clean("\#{x}/../\#{x}"), "\#{x}"
  assert_eq clean("\\"), "\\"
  assert_eq clean("\\/"), "\\"
  assert_eq clean("/\\"), "/\\"
  assert_eq clean("/\\/\\"), "/\\/\\"
  assert_eq clean("\\/../\\"), "\\"
  assert_eq clean(".a.b.c"), ".a.b.c"
  assert_eq clean(".a.b.c/"), ".a.b.c"
  assert_eq clean("/.a.b.c"), "/.a.b.c"
  assert_eq clean("/.a.b.c/.a.b.c"), "/.a.b.c/.a.b.c"
  assert_eq clean(".a.b.c/../.a.b.c"), ".a.b.c"
  assert_eq clean(Str.from_bytes([97, 46, 98, 47, 255, 47, 35, 123, 120, 125, 47, 46, 46, 47, 97, 195, 47])), Str.from_bytes([97, 46, 98, 47, 255, 47, 97, 195])
}

test "clean 2" {
  assert_eq clean("x..a.b.c/../a.b/"), "a.b"
  assert_eq clean(Str.from_bytes([97, 195, 47, 97, 47, 35, 123, 120, 125, 47])), Str.from_bytes([97, 195, 47, 97, 47, 35, 123, 120, 125])
  assert_eq clean("x..a.b.c/\#{x}/.x/"), "x..a.b.c/\#{x}/.x"
  assert_eq clean("日本.語a/日本.語"), "日本.語a/日本.語"
  assert_eq clean("//./"), "/"
  assert_eq clean("abc/x.////"), "abc/x."
  assert_eq clean("a///"), "a"
  assert_eq clean("\#{x}///.."), "."
  assert_eq clean("//../x./"), "/x."
  assert_eq clean("\\/.x\\..../"), "\\/.x\\...."
  assert_eq clean(".../é/"), ".../é"
  assert_eq clean("a b/a\\////"), "a b/a\\"
  assert_eq clean("abc/日本.語.../"), "abc/日本.語..."
  assert_eq clean("./\#{x}\#{x}/..日本.語/"), "\#{x}\#{x}/..日本.語"
  assert_eq clean("abcabc/"), "abcabc"
  assert_eq clean(Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 120, 46, 47, 255, 47, 97, 32, 98, 47])), Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 120, 46, 47, 255, 47, 97, 32, 98])
  assert_eq clean(Str.from_bytes([46, 120, 47, 255, 47, 47])), Str.from_bytes([46, 120, 47, 255])
  assert_eq clean(Str.from_bytes([47, 32, 47, 97, 195, 46, 46, 47, 35, 123, 120, 125, 47])), Str.from_bytes([47, 32, 47, 97, 195, 46, 46, 47, 35, 123, 120, 125])
  assert_eq clean("x.a.b./"), "x.a.b."
  assert_eq clean("b/a.b.x/é/b"), "b/a.b.x/é/b"
  assert_eq clean("\\/b//é/abc/"), "\\/b/é/abc"
  assert_eq clean("é/b/...\\/"), "é/b/...\\"
  assert_eq clean(" /x./x./abc/"), " /x./x./abc"
  assert_eq clean(" /abcé/"), " /abcé"
  assert_eq clean("a b/.x"), "a b/.x"
  assert_eq clean("a/ /..a b/"), "a/ /..a b"
  assert_eq clean("//a.b/"), "/a.b"
  assert_eq clean("\\/a/"), "\\/a"
  assert_eq clean(".x\#{x}a.ba.b/"), ".x\#{x}a.ba.b"
  assert_eq clean("a.b/../a b/./"), "a b"
  assert_eq clean("/.a.b.c/"), "/.a.b.c"
  assert_eq clean(Str.from_bytes([92, 47, 92, 47, 46, 46, 97, 195])), Str.from_bytes([92, 47, 92, 47, 46, 46, 97, 195])
  assert_eq clean("a.b...///"), "a.b..."
  assert_eq clean(Str.from_bytes([47, 47, 46, 47, 97, 195, 47])), Str.from_bytes([47, 97, 195])
  assert_eq clean(" /\#{x}/a/"), " /\#{x}/a"
  assert_eq clean(Str.from_bytes([97, 195, 47, 46, 46, 46, 195, 169])), Str.from_bytes([97, 195, 47, 46, 46, 46, 195, 169])
  assert_eq clean("\\/......"), "\\/......"
  assert_eq clean(".a.b.c a.b"), ".a.b.c a.b"
  assert_eq clean(".a.b.c/.../a/"), ".a.b.c/.../a"
  assert_eq clean("a b...a.b.c"), "a b...a.b.c"
  assert_eq clean(" /a/.x/"), " /a/.x"
  assert_eq clean(" /..."), " /..."
  assert_eq clean(Str.from_bytes([195, 169, 97, 98, 99, 97, 195, 46, 97, 46, 98, 46, 99])), Str.from_bytes([195, 169, 97, 98, 99, 97, 195, 46, 97, 46, 98, 46, 99])
  assert_eq clean("x./\\///b"), "x./\\/b"
  assert_eq clean(".a.b.cé/./\\a/"), ".a.b.cé/\\a"
  assert_eq clean("日本.語a.b//\\/"), "日本.語a.b/\\"
  assert_eq clean("....."), "....."
  assert_eq clean("é.a.b.c/./"), "é.a.b.c"
  assert_eq clean(Str.from_bytes([255, 46, 47, 92, 46, 120, 47, 46, 120])), Str.from_bytes([255, 46, 47, 92, 46, 120, 47, 46, 120])
  assert_eq clean(".a.b.cé/../a.b"), "a.b"
  assert_eq clean("abc/ \\a/"), "abc/ \\a"
  assert_eq clean("x.///x.a b/"), "x./x.a b"
  assert_eq clean(Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 46, 47, 32, 47, 97, 195, 47])), Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 46, 47, 32, 47, 97, 195])
  assert_eq clean("////a b"), "/a b"
  assert_eq clean("\\/\\b//.x/"), "\\/\\b/.x"
  assert_eq clean("\#{x}/\\/"), "\#{x}/\\"
  assert_eq clean(Str.from_bytes([46, 120, 47, 97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158])), Str.from_bytes([46, 120, 47, 97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158])
  assert_eq clean("a.b.x/"), "a.b.x"
  assert_eq clean(Str.from_bytes([98, 47, 47, 255, 98, 47])), Str.from_bytes([98, 47, 255, 98])
  assert_eq clean("b.a.b.c/"), "b.a.b.c"
  assert_eq clean(".a.b.c/\#{x}/a/"), ".a.b.c/\#{x}/a"
  assert_eq clean("日本.語/\#{x}/../"), "日本.語"
  assert_eq clean("/abc "), "/abc "
  assert_eq clean("bb/"), "bb"
  assert_eq clean(Str.from_bytes([97, 195, 47, 97, 47, 97, 47, 98, 47])), Str.from_bytes([97, 195, 47, 97, 47, 97, 47, 98])
  assert_eq clean("\\x.//.a.b.c///"), "\\x./.a.b.c"
  assert_eq clean("//\\/.a.b.c"), "/\\/.a.b.c"
  assert_eq clean("//b/\\"), "/b/\\"
  assert_eq clean(Str.from_bytes([97, 46, 98, 47, 32, 47, 255])), Str.from_bytes([97, 46, 98, 47, 32, 47, 255])
  assert_eq clean("b////日本.語/\#{x}"), "b/日本.語/\#{x}"
  assert_eq clean(Str.from_bytes([255, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47])), Str.from_bytes([255, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158])
  assert_eq clean("..a.b/  /"), "..a.b/  "
  assert_eq clean("b/a.b/b"), "b/a.b/b"
  assert_eq clean(".././a/abc /"), "../a/abc "
  assert_eq clean("..///x.///.x/"), "../x./.x"
  assert_eq clean("a/a/.x/"), "a/a/.x"
  assert_eq clean(Str.from_bytes([47, 46, 46, 46, 35, 123, 120, 125, 47, 255, 47, 46, 46, 47])), "/...\#{x}"
  assert_eq clean("///a b/"), "/a b"
  assert_eq clean(Str.from_bytes([255, 47, 46, 46, 46, 47])), Str.from_bytes([255, 47, 46, 46, 46])
  assert_eq clean("///é/"), "/é"
  assert_eq clean("../x.////a/"), "../x./a"
  assert_eq clean("/abc.x/ /"), "/abc.x/ "
  assert_eq clean(Str.from_bytes([97, 32, 98, 35, 123, 120, 125, 46, 120, 97, 195])), Str.from_bytes([97, 32, 98, 35, 123, 120, 125, 46, 120, 97, 195])
  assert_eq clean("///."), "/"
  assert_eq clean("é/\#{x}/ /a b/\#{x}"), "é/\#{x}/ /a b/\#{x}"
  assert_eq clean("日本.語/..."), "日本.語/..."
  assert_eq clean(Str.from_bytes([47, 47, 97, 195, 35, 123, 120, 125, 97, 46, 98, 47])), Str.from_bytes([47, 97, 195, 35, 123, 120, 125, 97, 46, 98])
  assert_eq clean("/\#{x}/"), "/\#{x}"
  assert_eq clean("\#{x}/a b/"), "\#{x}/a b"
  assert_eq clean(Str.from_bytes([97, 255, 47, 47, 47, 47])), Str.from_bytes([97, 255])
  assert_eq clean(".x\\/"), ".x\\"
  assert_eq clean("b/é/"), "b/é"
  assert_eq clean(" /a.b////"), " /a.b"
  assert_eq clean("b/b/日本.語/\#{x}/"), "b/b/日本.語/\#{x}"
  assert_eq clean(".....//"), "....."
  assert_eq clean(" /日本.語/"), " /日本.語"
  assert_eq clean("a/ abc\#{x}"), "a/ abc\#{x}"
  assert_eq clean(Str.from_bytes([46, 46, 47, 35, 123, 120, 125, 47, 97, 32, 98, 97, 195, 47])), Str.from_bytes([46, 46, 47, 35, 123, 120, 125, 47, 97, 32, 98, 97, 195])
  assert_eq clean(Str.from_bytes([195, 169, 255, 47])), Str.from_bytes([195, 169, 255])
  assert_eq clean("///x./x. /a"), "/x./x. /a"
}

test "clean 3" {
  assert_eq clean("a.b/.xb"), "a.b/.xb"
  assert_eq clean("éabc///"), "éabc"
  assert_eq clean("a./"), "a."
  assert_eq clean("b../.../../"), "b.."
  assert_eq clean(Str.from_bytes([255, 47, 92, 47])), Str.from_bytes([255, 47, 92])
  assert_eq clean(".a.b.c/\\/a.b/é/x./"), ".a.b.c/\\/a.b/é/x."
  assert_eq clean("b/b/"), "b/b"
  assert_eq clean("\#{x}a b/\\"), "\#{x}a b/\\"
  assert_eq clean(".x/\#{x}/abc/"), ".x/\#{x}/abc"
  assert_eq clean(Str.from_bytes([46, 120, 47, 255, 47])), Str.from_bytes([46, 120, 47, 255])
  assert_eq clean("a/é/./"), "a/é"
  assert_eq clean("éa.b/ /.a.b.c/"), "éa.b/ /.a.b.c"
  assert_eq clean("//\\a"), "/\\a"
  assert_eq clean("./\\/ ///"), "\\/ "
  assert_eq clean(Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 47])), Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158])
  assert_eq clean("/b///.../"), "/b/..."
  assert_eq clean(".../ /b/a b.x/"), ".../ /b/a b.x"
  assert_eq clean("/.../a.b/"), "/.../a.b"
  assert_eq clean("éé/"), "éé"
  assert_eq clean(Str.from_bytes([97, 98, 99, 47, 46, 46, 97, 195, 47])), Str.from_bytes([97, 98, 99, 47, 46, 46, 97, 195])
  assert_eq clean(".x/.a.b.c"), ".x/.a.b.c"
  assert_eq clean(".../日本.語/../日本.語/"), ".../日本.語"
  assert_eq clean("a.b/日本.語.a.b.c\\"), "a.b/日本.語.a.b.c\\"
  assert_eq clean("//abc.a.b.c//.a.b.c/"), "/abc.a.b.c/.a.b.c"
  assert_eq clean(".x/a.b/"), ".x/a.b"
  assert_eq clean("日本.語/..x.../"), "日本.語/..x..."
  assert_eq clean("///a///日本.語"), "/a/日本.語"
  assert_eq clean("é//....////"), "é/...."
  assert_eq clean(" /\\a.b/"), " /\\a.b"
  assert_eq clean(" é//.a.b.ca/"), " é/.a.b.ca"
  assert_eq clean("a/b../.a.b.c/../"), "a/b.."
  assert_eq clean("///.."), "/"
  assert_eq clean(".../\#{x}x./"), ".../\#{x}x."
  assert_eq clean(Str.from_bytes([47, 97, 98, 99, 47, 97, 195, 195, 169])), Str.from_bytes([47, 97, 98, 99, 47, 97, 195, 195, 169])
  assert_eq clean("日本.語a.b/é/日本.語////"), "日本.語a.b/é/日本.語"
  assert_eq clean("//\\/\#{x}////"), "/\\/\#{x}"
  assert_eq clean("a/..../"), "a/...."
  assert_eq clean(Str.from_bytes([97, 46, 98, 47, 255, 195, 169, 47, 46, 46, 46])), Str.from_bytes([97, 46, 98, 47, 255, 195, 169, 47, 46, 46, 46])
  assert_eq clean(Str.from_bytes([97, 32, 98, 47, 97, 195, 47, 97, 47])), Str.from_bytes([97, 32, 98, 47, 97, 195, 47, 97])
  assert_eq clean("\\/ ///x./"), "\\/ /x."
  assert_eq clean(Str.from_bytes([97, 47, 46, 97, 46, 98, 46, 99, 255, 47])), Str.from_bytes([97, 47, 46, 97, 46, 98, 46, 99, 255])
  assert_eq clean("x.a b/a b/.a.b.c\#{x}"), "x.a b/a b/.a.b.c\#{x}"
  assert_eq clean(".x/abc/.../"), ".x/abc/..."
  assert_eq clean(" x./\#{x}/"), " x./\#{x}"
  assert_eq clean("./.../..a b"), ".../..a b"
  assert_eq clean(".a.b.c/././...a/"), ".a.b.c/...a"
  assert_eq clean(Str.from_bytes([195, 169, 47, 97, 98, 99, 47, 46, 46, 47, 35, 123, 120, 125, 47, 255, 47])), Str.from_bytes([195, 169, 47, 35, 123, 120, 125, 47, 255])
  assert_eq clean(Str.from_bytes([46, 97, 46, 98, 46, 99, 47, 47, 47, 98, 47, 255, 47])), Str.from_bytes([46, 97, 46, 98, 46, 99, 47, 98, 47, 255])
  assert_eq clean("./.b/日本.語/.a.b.c"), ".b/日本.語/.a.b.c"
  assert_eq clean("/\\a.b/a/"), "/\\a.b/a"
  assert_eq clean("..a.b.c/"), "..a.b.c"
  assert_eq clean(".a.b.c/b/.a.b.c"), ".a.b.c/b/.a.b.c"
  assert_eq clean(Str.from_bytes([97, 195, 255, 47, 46, 46, 46, 47, 46, 97, 46, 98, 46, 99, 47, 46, 46, 46, 47])), Str.from_bytes([97, 195, 255, 47, 46, 46, 46, 47, 46, 97, 46, 98, 46, 99, 47, 46, 46, 46])
  assert_eq clean("a.a.b.c.../a bé/"), "a.a.b.c.../a bé"
  assert_eq clean(".a.b.c///"), ".a.b.c"
  assert_eq clean("日本.語/x./\#{x}"), "日本.語/x./\#{x}"
  assert_eq clean(Str.from_bytes([32, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 97, 32, 98, 97, 32, 98, 47])), Str.from_bytes([32, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 97, 32, 98, 97, 32, 98])
  assert_eq clean("\#{x}/a b../\#{x}/ /"), "\#{x}/a b../\#{x}/ "
  assert_eq clean(".a.b.c/ ///é/"), ".a.b.c/ /é"
  assert_eq clean(Str.from_bytes([97, 195, 47, 97, 32, 98, 46, 46, 46, 46, 120, 47, 97, 46, 98, 47])), Str.from_bytes([97, 195, 47, 97, 32, 98, 46, 46, 46, 46, 120, 47, 97, 46, 98])
  assert_eq clean(Str.from_bytes([98, 47, 46, 46, 46, 47, 255, 47, 97, 47])), Str.from_bytes([98, 47, 46, 46, 46, 47, 255, 47, 97])
  assert_eq clean(Str.from_bytes([97, 32, 98, 47, 195, 169, 46, 97, 46, 98, 46, 99, 46, 97, 46, 98, 46, 99, 255])), Str.from_bytes([97, 32, 98, 47, 195, 169, 46, 97, 46, 98, 46, 99, 46, 97, 46, 98, 46, 99, 255])
  assert_eq clean("//b/日本.語日本.語/.x/"), "/b/日本.語日本.語/.x"
  assert_eq clean(".../日本.語\\/b/a.b/"), ".../日本.語\\/b/a.b"
  assert_eq clean("b/..a.b.c/é"), "b/..a.b.c/é"
  assert_eq clean(Str.from_bytes([46, 46, 47, 47, 97, 195, 47, 255])), Str.from_bytes([46, 46, 47, 97, 195, 47, 255])
  assert_eq clean("b/a///a b"), "b/a/a b"
  assert_eq clean("\\a.b"), "\\a.b"
  assert_eq clean("///../"), "/"
  assert_eq clean(Str.from_bytes([47, 47, 97, 195, 47, 46, 120, 47, 47, 98, 47])), Str.from_bytes([47, 97, 195, 47, 46, 120, 47, 98])
  assert_eq clean("..a.b.c"), "..a.b.c"
  assert_eq clean("日本.語///x."), "日本.語/x."
  assert_eq clean("abc/ /aé/"), "abc/ /aé"
  assert_eq clean("a b/a/ \\"), "a b/a/ \\"
  assert_eq clean(".\#{x}a b/é/"), ".\#{x}a b/é"
  assert_eq clean(Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 255, 47, 46, 46, 46, 47])), Str.from_bytes([230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 255, 47, 46, 46, 46])
  assert_eq clean("b\#{x}/a b"), "b\#{x}/a b"
  assert_eq clean("é/ /a/a b"), "é/ /a/a b"
  assert_eq clean(Str.from_bytes([46, 47, 120, 46, 97, 195, 46, 92, 47])), Str.from_bytes([120, 46, 97, 195, 46, 92])
  assert_eq clean("//\#{x}/x./.a.b.c/"), "/\#{x}/x./.a.b.c"
  assert_eq clean(Str.from_bytes([97, 195, 47, 92, 47])), Str.from_bytes([97, 195, 47, 92])
  assert_eq clean("x.abc/\#{x}/./ /"), "x.abc/\#{x}/ "
  assert_eq clean(".x.x/"), ".x.x"
  assert_eq clean("日本.語/.x//"), "日本.語/.x"
  assert_eq clean(".x.x"), ".x.x"
  assert_eq clean(Str.from_bytes([32, 46, 120, 255, 47])), Str.from_bytes([32, 46, 120, 255])
  assert_eq clean(".../.x/.a.b.c"), ".../.x/.a.b.c"
  assert_eq clean(Str.from_bytes([97, 195, 97, 98, 99, 47, 47, 47, 35, 123, 120, 125, 47, 98, 47])), Str.from_bytes([97, 195, 97, 98, 99, 47, 35, 123, 120, 125, 47, 98])
  assert_eq clean(Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 35, 123, 120, 125, 47])), Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 35, 123, 120, 125])
  assert_eq clean("a.b/\\/a.b"), "a.b/\\/a.b"
  assert_eq clean(Str.from_bytes([46, 46, 46, 47, 92, 97, 195, 47])), Str.from_bytes([46, 46, 46, 47, 92, 97, 195])
  assert_eq clean(".a b/"), ".a b"
  assert_eq clean(Str.from_bytes([98, 47, 97, 46, 98, 255, 47, 46, 97, 46, 98, 46, 99, 47])), Str.from_bytes([98, 47, 97, 46, 98, 255, 47, 46, 97, 46, 98, 46, 99])
  assert_eq clean("../.a.b.cabc"), "../.a.b.cabc"
  assert_eq clean(Str.from_bytes([97, 47, 120, 46, 47, 46, 47, 97, 195])), Str.from_bytes([97, 47, 120, 46, 47, 97, 195])
  assert_eq clean(" /.////a.b/"), " /a.b"
  assert_eq clean("日本.語/.a.b.c/\#{x}/./abc/"), "日本.語/.a.b.c/\#{x}/abc"
  assert_eq clean("..../ /.a.b.c/b/"), "..../ /.a.b.c/b"
  assert_eq clean("a b./"), "a b."
  assert_eq clean("b.x/"), "b.x"
}

test "clean 4" {
  assert_eq clean(Str.from_bytes([120, 46, 46, 46, 46, 47, 47, 97, 195, 46, 46, 47])), Str.from_bytes([120, 46, 46, 46, 46, 47, 97, 195, 46, 46])
  assert_eq clean("é 日本.語/日本.語"), "é 日本.語/日本.語"
  assert_eq clean(Str.from_bytes([46, 46, 46, 32, 255, 195, 169])), Str.from_bytes([46, 46, 46, 32, 255, 195, 169])
  assert_eq clean(".../.."), "."
  assert_eq clean("abc/é/"), "abc/é"
  assert_eq clean("日本.語/\\/"), "日本.語/\\"
  assert_eq clean("////a b...a/"), "/a b...a"
  assert_eq clean("\#{x}// "), "\#{x}/ "
  assert_eq clean(".x../a/\#{x}///"), ".x../a/\#{x}"
  assert_eq clean("a b/a.b\#{x}/a/"), "a b/a.b\#{x}/a"
  assert_eq clean(Str.from_bytes([255, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 47, 92, 47])), Str.from_bytes([255, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 97, 195, 47, 92])
  assert_eq clean("日本.語.x/"), "日本.語.x"
  assert_eq clean("../a.b/./"), "../a.b"
  assert_eq clean("é/x."), "é/x."
