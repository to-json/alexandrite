  assert_eq [base(".../.x/.a.b.c"), dir(".../.x/.a.b.c"), ext(".../.x/.a.b.c")], [".a.b.c", ".../.x", ".c"]
  assert_eq is_abs(".../.x/.a.b.c"), false
  assert_eq [base(Str.from_bytes([97, 195, 97, 98, 99, 47, 47, 47, 35, 123, 120, 125, 47, 98, 47])), dir(Str.from_bytes([97, 195, 97, 98, 99, 47, 47, 47, 35, 123, 120, 125, 47, 98, 47])), ext(Str.from_bytes([97, 195, 97, 98, 99, 47, 47, 47, 35, 123, 120, 125, 47, 98, 47]))], ["b", Str.from_bytes([97, 195, 97, 98, 99, 47, 35, 123, 120, 125, 47, 98]), ""]
  assert_eq is_abs(Str.from_bytes([97, 195, 97, 98, 99, 47, 47, 47, 35, 123, 120, 125, 47, 98, 47])), false
  assert_eq [base(Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 35, 123, 120, 125, 47])), dir(Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 35, 123, 120, 125, 47])), ext(Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 35, 123, 120, 125, 47]))], ["\#{x}", Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 35, 123, 120, 125]), ""]
  assert_eq is_abs(Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 35, 123, 120, 125, 47])), false
  assert_eq [base("a.b/\\/a.b"), dir("a.b/\\/a.b"), ext("a.b/\\/a.b")], ["a.b", "a.b/\\", ".b"]
  assert_eq is_abs("a.b/\\/a.b"), false
  assert_eq [base(Str.from_bytes([46, 46, 46, 47, 92, 97, 195, 47])), dir(Str.from_bytes([46, 46, 46, 47, 92, 97, 195, 47])), ext(Str.from_bytes([46, 46, 46, 47, 92, 97, 195, 47]))], [Str.from_bytes([92, 97, 195]), Str.from_bytes([46, 46, 46, 47, 92, 97, 195]), ""]
  assert_eq is_abs(Str.from_bytes([46, 46, 46, 47, 92, 97, 195, 47])), false
  assert_eq [base(".a b/"), dir(".a b/"), ext(".a b/")], [".a b", ".a b", ""]
  assert_eq is_abs(".a b/"), false
  assert_eq [base(Str.from_bytes([98, 47, 97, 46, 98, 255, 47, 46, 97, 46, 98, 46, 99, 47])), dir(Str.from_bytes([98, 47, 97, 46, 98, 255, 47, 46, 97, 46, 98, 46, 99, 47])), ext(Str.from_bytes([98, 47, 97, 46, 98, 255, 47, 46, 97, 46, 98, 46, 99, 47]))], [".a.b.c", Str.from_bytes([98, 47, 97, 46, 98, 255, 47, 46, 97, 46, 98, 46, 99]), ""]
  assert_eq is_abs(Str.from_bytes([98, 47, 97, 46, 98, 255, 47, 46, 97, 46, 98, 46, 99, 47])), false
  assert_eq [base("../.a.b.cabc"), dir("../.a.b.cabc"), ext("../.a.b.cabc")], [".a.b.cabc", "..", ".cabc"]
  assert_eq is_abs("../.a.b.cabc"), false
  assert_eq [base(Str.from_bytes([97, 47, 120, 46, 47, 46, 47, 97, 195])), dir(Str.from_bytes([97, 47, 120, 46, 47, 46, 47, 97, 195])), ext(Str.from_bytes([97, 47, 120, 46, 47, 46, 47, 97, 195]))], [Str.from_bytes([97, 195]), "a/x.", ""]
  assert_eq is_abs(Str.from_bytes([97, 47, 120, 46, 47, 46, 47, 97, 195])), false
  assert_eq [base(" /.////a.b/"), dir(" /.////a.b/"), ext(" /.////a.b/")], ["a.b", " /a.b", ""]
  assert_eq is_abs(" /.////a.b/"), false
  assert_eq [base("日本.語/.a.b.c/\#{x}/./abc/"), dir("日本.語/.a.b.c/\#{x}/./abc/"), ext("日本.語/.a.b.c/\#{x}/./abc/")], ["abc", "日本.語/.a.b.c/\#{x}/abc", ""]
  assert_eq is_abs("日本.語/.a.b.c/\#{x}/./abc/"), false
  assert_eq [base("..../ /.a.b.c/b/"), dir("..../ /.a.b.c/b/"), ext("..../ /.a.b.c/b/")], ["b", "..../ /.a.b.c/b", ""]
  assert_eq is_abs("..../ /.a.b.c/b/"), false
  assert_eq [base("a b./"), dir("a b./"), ext("a b./")], ["a b.", "a b.", ""]
  assert_eq is_abs("a b./"), false
  assert_eq [base("b.x/"), dir("b.x/"), ext("b.x/")], ["b.x", "b.x", ""]
  assert_eq is_abs("b.x/"), false
}

test "join 1" {
  assert_eq join([]), ""
  assert_eq join([Str.from_bytes([97, 195]), "日本.語", "b", "日本.語"]), Str.from_bytes([97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 98, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158])
  assert_eq join(["b"]), "b"
  assert_eq join(["abc", "\#{x}"]), "abc/\#{x}"
  assert_eq join([]), ""
  assert_eq join(["a b", "a"]), "a b/a"
  assert_eq join(["b", "\#{x}", Str.from_bytes([97, 195]), ""]), Str.from_bytes([98, 47, 35, 123, 120, 125, 47, 97, 195])
  assert_eq join([]), ""
  assert_eq join(["\#{x}"]), "\#{x}"
  assert_eq join([Str.from_bytes([255]), "é", "."]), Str.from_bytes([255, 47, 195, 169])
  assert_eq join(["", ".a.b.c"]), ".a.b.c"
  assert_eq join(["..", "\#{x}"]), "../\#{x}"
  assert_eq join(["a.b", "//", ".", "x."]), "a.b/x."
  assert_eq join(["a b"]), "a b"
  assert_eq join([Str.from_bytes([97, 195]), ".a.b.c"]), Str.from_bytes([97, 195, 47, 46, 97, 46, 98, 46, 99])
  assert_eq join([".x", ".a.b.c", "日本.語"]), ".x/.a.b.c/日本.語"
  assert_eq join(["//", "//"]), "/"
  assert_eq join(["x.", Str.from_bytes([97, 195]), "."]), Str.from_bytes([120, 46, 47, 97, 195])
  assert_eq join([".x", ".x"]), ".x/.x"
  assert_eq join([]), ""
  assert_eq join([Str.from_bytes([255])]), Str.from_bytes([255])
  assert_eq join([".."]), ".."
  assert_eq join(["日本.語", "", "x.", ".."]), "日本.語"
  assert_eq join([".", "x.", Str.from_bytes([255]), ".."]), "x."
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["/", "...", "a.b"]), "/.../a.b"
  assert_eq join([".x", " ", Str.from_bytes([255]), ".."]), ".x/ "
  assert_eq join([".a.b.c", " ", "a", "a.b"]), ".a.b.c/ /a/a.b"
  assert_eq join(["..."]), "..."
  assert_eq join([Str.from_bytes([255]), "\\", ".a.b.c"]), Str.from_bytes([255, 47, 92, 47, 46, 97, 46, 98, 46, 99])
  assert_eq join([]), ""
  assert_eq join(["/", "a"]), "/a"
  assert_eq join([".", " ", "."]), " "
  assert_eq join([".", "b"]), "b"
  assert_eq join([".a.b.c", ".", "abc", ".a.b.c"]), ".a.b.c/abc/.a.b.c"
  assert_eq join(["a", "a", ""]), "a/a"
  assert_eq join([".", "b"]), "b"
  assert_eq join(["\#{x}", "a.b", "..."]), "\#{x}/a.b/..."
  assert_eq join(["abc"]), "abc"
  assert_eq join(["x."]), "x."
  assert_eq join(["a.b"]), "a.b"
  assert_eq join([Str.from_bytes([97, 195]), "b", "//", ".x"]), Str.from_bytes([97, 195, 47, 98, 47, 46, 120])
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["é"]), "é"
  assert_eq join(["a.b", "\#{x}"]), "a.b/\#{x}"
  assert_eq join([Str.from_bytes([97, 195]), "/", Str.from_bytes([255]), ".a.b.c"]), Str.from_bytes([97, 195, 47, 255, 47, 46, 97, 46, 98, 46, 99])
  assert_eq join([" ", "b"]), " /b"
  assert_eq join(["é", "a", "a b"]), "é/a/a b"
  assert_eq join([Str.from_bytes([97, 195]), "/"]), Str.from_bytes([97, 195])
  assert_eq join(["x.", ".", "\#{x}", Str.from_bytes([255])]), Str.from_bytes([120, 46, 47, 35, 123, 120, 125, 47, 255])
  assert_eq join(["\\", "\\"]), "\\/\\"
  assert_eq join([" "]), " "
  assert_eq join(["a.b", "b"]), "a.b/b"
  assert_eq join(["x.", "\#{x}", "\#{x}", "b"]), "x./\#{x}/\#{x}/b"
  assert_eq join([Str.from_bytes([97, 195]), "\#{x}", "/", "日本.語"]), Str.from_bytes([97, 195, 47, 35, 123, 120, 125, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158])
  assert_eq join(["\#{x}", "日本.語", "/"]), "\#{x}/日本.語"
  assert_eq join(["a"]), "a"
  assert_eq join([".", "日本.語"]), "日本.語"
  assert_eq join([".x", "é", "/", ".x"]), ".x/é/.x"
  assert_eq join(["..."]), "..."
  assert_eq join(["//", "\#{x}", ".a.b.c"]), "/\#{x}/.a.b.c"
  assert_eq join(["\\", "日本.語", " "]), "\\/日本.語/ "
  assert_eq join(["a", ".x"]), "a/.x"
  assert_eq join(["a", "/", "b"]), "a/b"
  assert_eq join([" ", Str.from_bytes([255]), "\\", "x."]), Str.from_bytes([32, 47, 255, 47, 92, 47, 120, 46])
  assert_eq join([]), ""
  assert_eq join(["日本.語", " ", "日本.語"]), "日本.語/ /日本.語"
  assert_eq join(["...", "..", "b"]), "b"
  assert_eq join([Str.from_bytes([97, 195]), "a b", "a", ".x"]), Str.from_bytes([97, 195, 47, 97, 32, 98, 47, 97, 47, 46, 120])
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["\\", "é"]), "\\/é"
  assert_eq join([".", "..", "日本.語"]), "../日本.語"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["/", "日本.語"]), "/日本.語"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["//", "b", "a"]), "/b/a"
  assert_eq join([Str.from_bytes([97, 195]), ".."]), "."
  assert_eq join(["/"]), "/"
  assert_eq join(["a", "a.b", Str.from_bytes([255])]), Str.from_bytes([97, 47, 97, 46, 98, 47, 255])
  assert_eq join(["//", "/", "abc"]), "/abc"
  assert_eq join(["a.b", ".a.b.c", "\\", "a.b"]), "a.b/.a.b.c/\\/a.b"
  assert_eq join([]), ""
  assert_eq join(["a b", "/", ".a.b.c"]), "a b/.a.b.c"
  assert_eq join(["é", "", "é"]), "é/é"
  assert_eq join([]), ""
  assert_eq join(["\\", "x.", "é", Str.from_bytes([255])]), Str.from_bytes([92, 47, 120, 46, 47, 195, 169, 47, 255])
  assert_eq join(["b"]), "b"
  assert_eq join(["/", "...", ".a.b.c"]), "/.../.a.b.c"
  assert_eq join([]), ""
  assert_eq join(["日本.語", "a b", " "]), "日本.語/a b/ "
  assert_eq join([".."]), ".."
  assert_eq join(["...", "abc", "//"]), ".../abc"
  assert_eq join([]), ""
}

test "join 2" {
  assert_eq join(["\\", "..."]), "\\/..."
  assert_eq join([".a.b.c"]), ".a.b.c"
  assert_eq join(["//", ".x"]), "/.x"
  assert_eq join(["/"]), "/"
  assert_eq join(["//", "\\", ".."]), "/"
  assert_eq join(["x."]), "x."
  assert_eq join([]), ""
  assert_eq join(["//", ".x", "a"]), "/.x/a"
  assert_eq join([]), ""
  assert_eq join(["//", "/", "x.", Str.from_bytes([97, 195])]), Str.from_bytes([47, 120, 46, 47, 97, 195])
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([".a.b.c", "\#{x}", "", "a.b"]), ".a.b.c/\#{x}/a.b"
  assert_eq join([Str.from_bytes([97, 195]), "abc", " "]), Str.from_bytes([97, 195, 47, 97, 98, 99, 47, 32])
  assert_eq join(["//", Str.from_bytes([97, 195])]), Str.from_bytes([47, 97, 195])
  assert_eq join([".x", "a", "a.b"]), ".x/a/a.b"
  assert_eq join([]), ""
  assert_eq join([Str.from_bytes([97, 195]), "a", "//"]), Str.from_bytes([97, 195, 47, 97])
  assert_eq join(["b", "日本.語", "\#{x}", ".a.b.c"]), "b/日本.語/\#{x}/.a.b.c"
  assert_eq join(["\#{x}", ".", "a.b", " "]), "\#{x}/a.b/ "
  assert_eq join(["abc"]), "abc"
  assert_eq join(["//"]), "/"
  assert_eq join(["...", "abc", "日本.語", ".x"]), ".../abc/日本.語/.x"
  assert_eq join(["..", "日本.語", ".."]), ".."
  assert_eq join(["..", Str.from_bytes([97, 195])]), Str.from_bytes([46, 46, 47, 97, 195])
  assert_eq join(["\#{x}", ".a.b.c", "//"]), "\#{x}/.a.b.c"
  assert_eq join(["\#{x}", Str.from_bytes([97, 195]), "...", "x."]), Str.from_bytes([35, 123, 120, 125, 47, 97, 195, 47, 46, 46, 46, 47, 120, 46])
  assert_eq join(["..."]), "..."
  assert_eq join([]), ""
  assert_eq join([Str.from_bytes([97, 195]), Str.from_bytes([97, 195])]), Str.from_bytes([97, 195, 47, 97, 195])
  assert_eq join([".", "/"]), "."
  assert_eq join(["x.", "a.b", "é"]), "x./a.b/é"
  assert_eq join([" ", "", "a.b"]), " /a.b"
  assert_eq join(["a", ".a.b.c", "\\"]), "a/.a.b.c/\\"
  assert_eq join([" "]), " "
  assert_eq join([]), ""
  assert_eq join(["/"]), "/"
  assert_eq join(["x.", "/", "日本.語", Str.from_bytes([255])]), Str.from_bytes([120, 46, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 255])
  assert_eq join(["a.b", Str.from_bytes([97, 195])]), Str.from_bytes([97, 46, 98, 47, 97, 195])
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["\\", "\\", Str.from_bytes([97, 195])]), Str.from_bytes([92, 47, 92, 47, 97, 195])
  assert_eq join([Str.from_bytes([255]), "é"]), Str.from_bytes([255, 47, 195, 169])
  assert_eq join([]), ""
  assert_eq join(["a.b"]), "a.b"
  assert_eq join(["a b", ""]), "a b"
  assert_eq join(["a.b"]), "a.b"
  assert_eq join(["...", "日本.語"]), ".../日本.語"
  assert_eq join([]), ""
  assert_eq join([" ", Str.from_bytes([97, 195]), ".", "\#{x}"]), Str.from_bytes([32, 47, 97, 195, 47, 35, 123, 120, 125])
  assert_eq join([""]), ""
  assert_eq join([" ", "\#{x}"]), " /\#{x}"
  assert_eq join([]), ""
  assert_eq join(["é"]), "é"
  assert_eq join([]), ""
  assert_eq join(["b", ".."]), "."
  assert_eq join(["x.", "x.", "..."]), "x./x./..."
  assert_eq join([".x"]), ".x"
  assert_eq join([Str.from_bytes([97, 195]), "...", ".x", ".x"]), Str.from_bytes([97, 195, 47, 46, 46, 46, 47, 46, 120, 47, 46, 120])
  assert_eq join(["//", Str.from_bytes([255])]), Str.from_bytes([47, 255])
  assert_eq join([]), ""
  assert_eq join([".x", Str.from_bytes([255]), "..", ".a.b.c"]), ".x/.a.b.c"
  assert_eq join([]), ""
  assert_eq join(["..."]), "..."
  assert_eq join([" ", "é", Str.from_bytes([97, 195])]), Str.from_bytes([32, 47, 195, 169, 47, 97, 195])
  assert_eq join([]), ""
  assert_eq join([Str.from_bytes([97, 195]), Str.from_bytes([255]), "", ""]), Str.from_bytes([97, 195, 47, 255])
  assert_eq join(["a"]), "a"
  assert_eq join([".."]), ".."
  assert_eq join(["."]), "."
  assert_eq join(["..."]), "..."
  assert_eq join([]), ""
  assert_eq join(["//"]), "/"
  assert_eq join([" "]), " "
  assert_eq join(["x.", "/", Str.from_bytes([255]), ".x"]), Str.from_bytes([120, 46, 47, 255, 47, 46, 120])
  assert_eq join(["//"]), "/"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["//", Str.from_bytes([97, 195])]), Str.from_bytes([47, 97, 195])
  assert_eq join(["."]), "."
  assert_eq join(["a", "."]), "a"
  assert_eq join(["...", "\#{x}", "/"]), ".../\#{x}"
  assert_eq join([".a.b.c", "a"]), ".a.b.c/a"
  assert_eq join(["é", Str.from_bytes([255]), "abc", "\#{x}"]), Str.from_bytes([195, 169, 47, 255, 47, 97, 98, 99, 47, 35, 123, 120, 125])
  assert_eq join(["/"]), "/"
  assert_eq join(["", "."]), "."
  assert_eq join(["b", "/"]), "b"
  assert_eq join([Str.from_bytes([255]), "", "."]), Str.from_bytes([255])
  assert_eq join(["b", ".a.b.c", "a"]), "b/.a.b.c/a"
  assert_eq join([Str.from_bytes([255]), ".", ".", ""]), Str.from_bytes([255])
  assert_eq join([]), ""
  assert_eq join(["x.", "a b"]), "x./a b"
  assert_eq join(["", Str.from_bytes([97, 195])]), Str.from_bytes([97, 195])
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["a b", "\#{x}", "//", ".a.b.c"]), "a b/\#{x}/.a.b.c"
  assert_eq join(["\#{x}", "x.", "abc"]), "\#{x}/x./abc"
  assert_eq join(["", ".x", "a b", "\\"]), ".x/a b/\\"
  assert_eq join(["x.", "日本.語", "...", "é"]), "x./日本.語/.../é"
  assert_eq join([".x", ".x"]), ".x/.x"
}

test "join 3" {
  assert_eq join(["é", "...", "é"]), "é/.../é"
  assert_eq join(["x."]), "x."
  assert_eq join(["a"]), "a"
  assert_eq join([".."]), ".."
  assert_eq join(["/", ".", "x.", "a"]), "/x./a"
  assert_eq join(["\#{x}"]), "\#{x}"
  assert_eq join(["\\", " ", "a.b", ".."]), "\\/ "
  assert_eq join([".", ".a.b.c", "a b", "//"]), ".a.b.c/a b"
  assert_eq join([".a.b.c"]), ".a.b.c"
  assert_eq join(["é"]), "é"
  assert_eq join(["..", "/"]), ".."
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["a b", Str.from_bytes([97, 195])]), Str.from_bytes([97, 32, 98, 47, 97, 195])
  assert_eq join(["...", "\#{x}"]), ".../\#{x}"
  assert_eq join(["a b", " ", ".x"]), "a b/ /.x"
  assert_eq join(["...", "..."]), ".../..."
  assert_eq join([".."]), ".."
  assert_eq join([]), ""
  assert_eq join(["a.b", "\\", "b"]), "a.b/\\/b"
  assert_eq join(["..", "//", "abc", "..."]), "../abc/..."
  assert_eq join([""]), ""
  assert_eq join([]), ""
  assert_eq join(["..", ".x", "/"]), "../.x"
  assert_eq join([" "]), " "
  assert_eq join([Str.from_bytes([255]), "..", "é", ".a.b.c"]), "é/.a.b.c"
  assert_eq join(["a.b", ".", "b", ".x"]), "a.b/b/.x"
  assert_eq join([]), ""
  assert_eq join(["/", Str.from_bytes([97, 195]), "a.b"]), Str.from_bytes([47, 97, 195, 47, 97, 46, 98])
  assert_eq join([".", ".", ".", "x."]), "x."
  assert_eq join(["é", Str.from_bytes([255]), "b"]), Str.from_bytes([195, 169, 47, 255, 47, 98])
  assert_eq join([".."]), ".."
  assert_eq join(["//"]), "/"
  assert_eq join(["//", "\#{x}", " "]), "/\#{x}/ "
  assert_eq join([]), ""
  assert_eq join(["x.", "b", "", Str.from_bytes([255])]), Str.from_bytes([120, 46, 47, 98, 47, 255])
  assert_eq join(["a"]), "a"
  assert_eq join(["...", Str.from_bytes([255])]), Str.from_bytes([46, 46, 46, 47, 255])
  assert_eq join(["a", "..", "a"]), "a"
  assert_eq join([]), ""
  assert_eq join(["..."]), "..."
  assert_eq join([".a.b.c", "\\", "é", "..."]), ".a.b.c/\\/é/..."
  assert_eq join(["é"]), "é"
  assert_eq join([]), ""
  assert_eq join(["//", "日本.語"]), "/日本.語"
  assert_eq join(["", ".", ".x", "b"]), ".x/b"
  assert_eq join([" ", Str.from_bytes([255]), "\\", Str.from_bytes([255])]), Str.from_bytes([32, 47, 255, 47, 92, 47, 255])
  assert_eq join(["\\", ".x", "a.b"]), "\\/.x/a.b"
  assert_eq join([]), ""
  assert_eq join(["\#{x}"]), "\#{x}"
  assert_eq join(["", "\#{x}", "a.b", ".x"]), "\#{x}/a.b/.x"
  assert_eq join(["\#{x}", "\#{x}", "b"]), "\#{x}/\#{x}/b"
  assert_eq join(["a b", Str.from_bytes([97, 195]), ".a.b.c", "a b"]), Str.from_bytes([97, 32, 98, 47, 97, 195, 47, 46, 97, 46, 98, 46, 99, 47, 97, 32, 98])
  assert_eq join(["\\", Str.from_bytes([97, 195]), "..."]), Str.from_bytes([92, 47, 97, 195, 47, 46, 46, 46])
  assert_eq join([]), ""
  assert_eq join(["\#{x}"]), "\#{x}"
  assert_eq join(["日本.語"]), "日本.語"
  assert_eq join(["é", "//", "x.", ".."]), "é"
  assert_eq join(["...", Str.from_bytes([97, 195]), "日本.語", ".x"]), Str.from_bytes([46, 46, 46, 47, 97, 195, 47, 230, 151, 165, 230, 156, 172, 46, 232, 170, 158, 47, 46, 120])
  assert_eq join([]), ""
  assert_eq join([".a.b.c", "b", "."]), ".a.b.c/b"
  assert_eq join([" "]), " "
  assert_eq join([".x", "\\", "日本.語", ".a.b.c"]), ".x/\\/日本.語/.a.b.c"
  assert_eq join(["x."]), "x."
  assert_eq join([Str.from_bytes([97, 195])]), Str.from_bytes([97, 195])
  assert_eq join(["é", "a.b"]), "é/a.b"
  assert_eq join([".", "é"]), "é"
  assert_eq join(["a.b", Str.from_bytes([255]), "abc"]), Str.from_bytes([97, 46, 98, 47, 255, 47, 97, 98, 99])
  assert_eq join([" ", ".a.b.c"]), " /.a.b.c"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join(["."]), "."
  assert_eq join([Str.from_bytes([255]), "\\", "a", "a.b"]), Str.from_bytes([255, 47, 92, 47, 97, 47, 97, 46, 98])
  assert_eq join(["abc", " ", ".x"]), "abc/ /.x"
  assert_eq join([".a.b.c"]), ".a.b.c"
  assert_eq join([".", Str.from_bytes([97, 195])]), Str.from_bytes([97, 195])
  assert_eq join([Str.from_bytes([255])]), Str.from_bytes([255])
  assert_eq join(["/", "日本.語"]), "/日本.語"
  assert_eq join(["日本.語", ".a.b.c", "//", "\#{x}"]), "日本.語/.a.b.c/\#{x}"
  assert_eq join([]), ""
  assert_eq join([]), ""
  assert_eq join([".", " ", "\#{x}"]), " /\#{x}"
  assert_eq join([]), ""
  assert_eq join(["\\", ".x"]), "\\/.x"
  assert_eq join(["/", "é", "é"]), "/é/é"
  assert_eq join([".", "a b", " "]), "a b/ "
  assert_eq join([]), ""
  assert_eq join(["...", " ", "abc", "..."]), ".../ /abc/..."
  assert_eq join(["."]), "."
  assert_eq join(["a.b"]), "a.b"
  assert_eq join(["a.b", "\\"]), "a.b/\\"
  assert_eq join([]), ""
  assert_eq join(["abc"]), "abc"
  assert_eq join([" ", "日本.語", "\\"]), " /日本.語/\\"
  assert_eq join(["x.", "b"]), "x./b"
  assert_eq join(["\\", Str.from_bytes([255])]), Str.from_bytes([92, 47, 255])
  assert_eq join(["a.b", "b"]), "a.b/b"
  assert_eq join(["\\", "b"]), "\\/b"
  assert_eq join([]), ""
}

