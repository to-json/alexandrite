  assert_eq is_abs(" /x./x./abc/"), false
  assert_eq [base(" /abcé/"), dir(" /abcé/"), ext(" /abcé/")], ["abcé", " /abcé", ""]
  assert_eq is_abs(" /abcé/"), false
  assert_eq [base("a b/.x"), dir("a b/.x"), ext("a b/.x")], [".x", "a b", ".x"]
  assert_eq is_abs("a b/.x"), false
