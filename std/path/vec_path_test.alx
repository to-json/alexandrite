  assert_eq is_abs("b.a.b.c/"), false
  assert_eq [base(".a.b.c/\#{x}/a/"), dir(".a.b.c/\#{x}/a/"), ext(".a.b.c/\#{x}/a/")], ["a", ".a.b.c/\#{x}/a", ""]
  assert_eq is_abs(".a.b.c/\#{x}/a/"), false
