  assert_eq split("é/b/...\\/"), ("é/b/...\\/", "")
  assert_eq split(" /x./x./abc/"), (" /x./x./abc/", "")
  assert_eq split(" /abcé/"), (" /abcé/", "")
  assert_eq split("a b/.x"), ("a b/", ".x")
  assert_eq split("a/ /..a b/"), ("a/ /..a b/", "")
  assert_eq split("//a.b/"), ("//a.b/", "")
  assert_eq split("\\/a/"), ("\\/a/", "")
  assert_eq split(".x\#{x}a.ba.b/"), (".x\#{x}a.ba.b/", "")
  assert_eq split("a.b/../a b/./"), ("a.b/../a b/./", "")
  assert_eq split("/.a.b.c/"), ("/.a.b.c/", "")
  assert_eq split(Str.from_bytes([92, 47, 92, 47, 46, 46, 97, 195])), ("\\/\\/", Str.from_bytes([46, 46, 97, 195]))
  assert_eq split("a.b...///"), ("a.b...///", "")
  assert_eq split(Str.from_bytes([47, 47, 46, 47, 97, 195, 47])), (Str.from_bytes([47, 47, 46, 47, 97, 195, 47]), "")
  assert_eq split(" /\#{x}/a/"), (" /\#{x}/a/", "")
  assert_eq split(Str.from_bytes([97, 195, 47, 46, 46, 46, 195, 169])), (Str.from_bytes([97, 195, 47]), "...é")
  assert_eq split("\\/......"), ("\\/", "......")
  assert_eq split(".a.b.c a.b"), ("", ".a.b.c a.b")
  assert_eq split(".a.b.c/.../a/"), (".a.b.c/.../a/", "")
  assert_eq split("a b...a.b.c"), ("", "a b...a.b.c")
  assert_eq split(" /a/.x/"), (" /a/.x/", "")
  assert_eq split(" /..."), (" /", "...")
  assert_eq split(Str.from_bytes([195, 169, 97, 98, 99, 97, 195, 46, 97, 46, 98, 46, 99])), ("", Str.from_bytes([195, 169, 97, 98, 99, 97, 195, 46, 97, 46, 98, 46, 99]))
  assert_eq split("x./\\///b"), ("x./\\///", "b")
  assert_eq split(".a.b.cé/./\\a/"), (".a.b.cé/./\\a/", "")
  assert_eq split("日本.語a.b//\\/"), ("日本.語a.b//\\/", "")
  assert_eq split("....."), ("", ".....")
  assert_eq split("é.a.b.c/./"), ("é.a.b.c/./", "")
