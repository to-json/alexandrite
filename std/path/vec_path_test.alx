}

test "base dir ext is_abs 5" {
  assert_eq [base("a.b/.xb"), dir("a.b/.xb"), ext("a.b/.xb")], [".xb", "a.b", ".xb"]
  assert_eq is_abs("a.b/.xb"), false
  assert_eq [base("éabc///"), dir("éabc///"), ext("éabc///")], ["éabc", "éabc", ""]
  assert_eq is_abs("éabc///"), false
  assert_eq [base("a./"), dir("a./"), ext("a./")], ["a.", "a.", ""]
  assert_eq is_abs("a./"), false
  assert_eq [base("b../.../../"), dir("b../.../../"), ext("b../.../../")], ["..", "b..", ""]
  assert_eq is_abs("b../.../../"), false
  assert_eq [base(Str.from_bytes([255, 47, 92, 47])), dir(Str.from_bytes([255, 47, 92, 47])), ext(Str.from_bytes([255, 47, 92, 47]))], ["\\", Str.from_bytes([255, 47, 92]), ""]
  assert_eq is_abs(Str.from_bytes([255, 47, 92, 47])), false
  assert_eq [base(".a.b.c/\\/a.b/é/x./"), dir(".a.b.c/\\/a.b/é/x./"), ext(".a.b.c/\\/a.b/é/x./")], ["x.", ".a.b.c/\\/a.b/é/x.", ""]
  assert_eq is_abs(".a.b.c/\\/a.b/é/x./"), false
  assert_eq [base("b/b/"), dir("b/b/"), ext("b/b/")], ["b", "b/b", ""]
  assert_eq is_abs("b/b/"), false
  assert_eq [base("\#{x}a b/\\"), dir("\#{x}a b/\\"), ext("\#{x}a b/\\")], ["\\", "\#{x}a b", ""]
  assert_eq is_abs("\#{x}a b/\\"), false
  assert_eq [base(".x/\#{x}/abc/"), dir(".x/\#{x}/abc/"), ext(".x/\#{x}/abc/")], ["abc", ".x/\#{x}/abc", ""]
  assert_eq is_abs(".x/\#{x}/abc/"), false
  assert_eq [base(Str.from_bytes([46, 120, 47, 255, 47])), dir(Str.from_bytes([46, 120, 47, 255, 47])), ext(Str.from_bytes([46, 120, 47, 255, 47]))], [Str.from_bytes([255]), Str.from_bytes([46, 120, 47, 255]), ""]
  assert_eq is_abs(Str.from_bytes([46, 120, 47, 255, 47])), false
  assert_eq [base("a/é/./"), dir("a/é/./"), ext("a/é/./")], [".", "a/é", ""]
  assert_eq is_abs("a/é/./"), false
