# Common Key Codes
pub KEY_SPACE = 32
pub KEY_ESCAPE = 256
pub KEY_ENTER = 257
pub KEY_TAB = 258
pub KEY_BACKSPACE = 259
pub KEY_RIGHT = 262
pub KEY_LEFT = 263
pub KEY_DOWN = 264
pub KEY_UP = 265

# Mouse Buttons
pub MOUSE_BUTTON_LEFT = 0
pub MOUSE_BUTTON_RIGHT = 1
pub MOUSE_BUTTON_MIDDLE = 2
