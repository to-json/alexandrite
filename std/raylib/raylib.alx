# Package raylib: Alexandrite bindings for raylib (latest / 6.0+)
#
# Provides FFI bindings for window management, frame timing, drawing,
# basic shapes, text, colors, and input handling.

# --- C FFI Definitions ---
pub extern def init_window(width: I32, height: I32, title: Str) = "InitWindow"
pub extern def close_window = "CloseWindow"
pub extern def window_should_close -> Bool = "WindowShouldClose"
pub extern def is_window_ready -> Bool = "IsWindowReady"
pub extern def is_window_fullscreen -> Bool = "IsWindowFullscreen"
pub extern def is_window_hidden -> Bool = "IsWindowHidden"
pub extern def is_window_minimized -> Bool = "IsWindowMinimized"
pub extern def is_window_maximized -> Bool = "IsWindowMaximized"
pub extern def is_window_focused -> Bool = "IsWindowFocused"
pub extern def is_window_resized -> Bool = "IsWindowResized"

pub extern def set_window_state(flags: U32) = "SetWindowState"
pub extern def clear_window_state(flags: U32) = "ClearWindowState"
pub extern def toggle_fullscreen = "ToggleFullscreen"
pub extern def toggle_borderless_windowed = "ToggleBorderlessWindowed"
pub extern def maximize_window = "MaximizeWindow"
pub extern def minimize_window = "MinimizeWindow"
pub extern def restore_window = "RestoreWindow"

pub extern def set_window_title(title: Str) = "SetWindowTitle"
pub extern def set_window_position(x: I32, y: I32) = "SetWindowPosition"
pub extern def set_window_monitor(monitor: I32) = "SetWindowMonitor"
pub extern def set_window_min_size(width: I32, height: I32) = "SetWindowMinSize"
pub extern def set_window_max_size(width: I32, height: I32) = "SetWindowMaxSize"
pub extern def set_window_size(width: I32, height: I32) = "SetWindowSize"
pub extern def set_window_opacity(opacity: Float) = "SetWindowOpacity"
pub extern def set_window_focused = "SetWindowFocused"

pub extern def get_screen_width -> I32 = "GetScreenWidth"
pub extern def get_screen_height -> I32 = "GetScreenHeight"
pub extern def get_render_width -> I32 = "GetRenderWidth"
pub extern def get_render_height -> I32 = "GetRenderHeight"

# Cursor
pub extern def show_cursor = "ShowCursor"
pub extern def hide_cursor = "HideCursor"
pub extern def is_cursor_hidden -> Bool = "IsCursorHidden"
pub extern def enable_cursor = "EnableCursor"
pub extern def disable_cursor = "DisableCursor"
pub extern def is_cursor_on_screen -> Bool = "IsCursorOnScreen"

# Timing
pub extern def set_target_fps(fps: I32) = "SetTargetFPS"
pub extern def get_fps -> I32 = "GetFPS"
pub extern def get_frame_time -> Float = "GetFrameTime"
pub extern def get_time -> Float = "GetTime"

# Drawing
pub extern def begin_drawing = "BeginDrawing"
pub extern def end_drawing = "EndDrawing"
pub extern def c_clear_background(color: U32) = "ClearBackground"

# Text
pub extern def draw_fps(posX: I32, posY: I32) = "DrawFPS"
pub extern def c_draw_text(text: Str, posX: I32, posY: I32, fontSize: I32, color: U32) = "DrawText"

# Basic Shapes (Color passed as 32-bit RGBA integer matching SysV ABI)
pub extern def c_draw_pixel(posX: I32, posY: I32, color: U32) = "DrawPixel"
pub extern def c_draw_line(startX: I32, startY: I32, endX: I32, endY: I32, color: U32) = "DrawLine"
pub extern def c_draw_rectangle(posX: I32, posY: I32, width: I32, height: I32, color: U32) = "DrawRectangle"
pub extern def c_draw_rectangle_lines(posX: I32, posY: I32, width: I32, height: I32, color: U32) = "DrawRectangleLines"
pub extern def c_draw_circle(centerX: I32, centerY: I32, radius: Float, color: U32) = "DrawCircle"
pub extern def c_draw_circle_lines(centerX: I32, centerY: I32, radius: Float, color: U32) = "DrawCircleLines"

# Input - Keyboard
pub extern def is_key_pressed(key: I32) -> Bool = "IsKeyPressed"
pub extern def is_key_pressed_repeat(key: I32) -> Bool = "IsKeyPressedRepeat"
pub extern def is_key_down(key: I32) -> Bool = "IsKeyDown"
pub extern def is_key_released(key: I32) -> Bool = "IsKeyReleased"
pub extern def is_key_up(key: I32) -> Bool = "IsKeyUp"
pub extern def get_key_pressed -> I32 = "GetKeyPressed"
pub extern def get_char_pressed -> I32 = "GetCharPressed"

# Input - Mouse
pub extern def is_mouse_button_pressed(button: I32) -> Bool = "IsMouseButtonPressed"
pub extern def is_mouse_button_down(button: I32) -> Bool = "IsMouseButtonDown"
pub extern def is_mouse_button_released(button: I32) -> Bool = "IsMouseButtonReleased"
pub extern def is_mouse_button_up(button: I32) -> Bool = "IsMouseButtonUp"
pub extern def get_mouse_x -> I32 = "GetMouseX"
pub extern def get_mouse_y -> I32 = "GetMouseY"
pub extern def get_mouse_wheel_move -> Float = "GetMouseWheelMove"

# --- Types & Structs ---

pub struct Color {
  r: U8
  g: U8
  b: U8
  a: U8

  pub def to_u32 -> U32 {
    r.to_u32 | (g.to_u32 << 8) | (b.to_u32 << 16) | (a.to_u32 << 24)
  }
}

pub struct Vector2 {
  x: Float
  y: Float
}

pub struct Rectangle {
  x: Float
  y: Float
  width: Float
  height: Float
}

# --- Color Constructors & Helpers ---

pub def rgba(r: Int, g: Int, b: Int, a: Int) -> Color {
  Color.new(r: r.to_u8, g: g.to_u8, b: b.to_u8, a: a.to_u8)
}

pub def rgb(r: Int, g: Int, b: Int) -> Color {
  rgba(r, g, b, 255)
}

pub def color_from_u32(u: U32) -> Color {
  Color.new(
    r: (u & 0xff).to_u8,
    g: ((u >> 8) & 0xff).to_u8,
    b: ((u >> 16) & 0xff).to_u8,
    a: ((u >> 24) & 0xff).to_u8,
  )
}

# --- High-level wrappers ---

pub def clear_background(color: Color) {
  c_clear_background(color.to_u32)
}

pub def draw_text(text: Str, posX: Int, posY: Int, fontSize: Int, color: Color) {
  c_draw_text(text, posX.to_i32, posY.to_i32, fontSize.to_i32, color.to_u32)
}

pub def draw_pixel(posX: Int, posY: Int, color: Color) {
  c_draw_pixel(posX.to_i32, posY.to_i32, color.to_u32)
}

pub def draw_line(startX: Int, startY: Int, endX: Int, endY: Int, color: Color) {
  c_draw_line(startX.to_i32, startY.to_i32, endX.to_i32, endY.to_i32, color.to_u32)
}

pub def draw_rectangle(posX: Int, posY: Int, width: Int, height: Int, color: Color) {
  c_draw_rectangle(posX.to_i32, posY.to_i32, width.to_i32, height.to_i32, color.to_u32)
}

pub def draw_rectangle_lines(posX: Int, posY: Int, width: Int, height: Int, color: Color) {
  c_draw_rectangle_lines(posX.to_i32, posY.to_i32, width.to_i32, height.to_i32, color.to_u32)
}

pub def draw_circle(centerX: Int, centerY: Int, radius: Float, color: Color) {
  c_draw_circle(centerX.to_i32, centerY.to_i32, radius, color.to_u32)
}

pub def draw_circle_lines(centerX: Int, centerY: Int, radius: Float, color: Color) {
  c_draw_circle_lines(centerX.to_i32, centerY.to_i32, radius, color.to_u32)
}

# Predicate aliases
pub def window_should_close? -> Bool { window_should_close }
pub def window_ready? -> Bool { is_window_ready }
pub def key_pressed?(key: Int) -> Bool { is_key_pressed(key.to_i32) }
pub def key_down?(key: Int) -> Bool { is_key_down(key.to_i32) }
pub def key_released?(key: Int) -> Bool { is_key_released(key.to_i32) }
pub def key_up?(key: Int) -> Bool { is_key_up(key.to_i32) }
pub def mouse_button_pressed?(button: Int) -> Bool { is_mouse_button_pressed(button.to_i32) }
pub def mouse_button_down?(button: Int) -> Bool { is_mouse_button_down(button.to_i32) }
pub def mouse_position -> Vector2 { Vector2.new(x: get_mouse_x.to_f, y: get_mouse_y.to_f) }

