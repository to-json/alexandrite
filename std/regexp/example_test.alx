# Go's regexp example_test.go as examples. fmt's %q of a list is spelled out
# with quote_list.

import "strconv"
import "strings"

# Go's %q of a []string / [][]byte.
def quote_list(xs: [Str]) -> Str {
  parts: [Str] = []
  for x in xs { parts << strconv.quote(x) }
  "[" + strings.join(parts, " ") + "]"
}

def bquote_list(xs: [[Byte]?]) -> Str {
  parts: [Str] = []
  for x in xs { parts << strconv.quote(x.present? ? Str.from_bytes(x.unwrap) : "") }
  "[" + strings.join(parts, " ") + "]"
}

example "regexp" {
  # Compile the expression once, usually at init time.
  valid_id = must_compile("^[a-z]+\\[[0-9]+\\]$")
  puts valid_id.match_string?("adam[23]")
  puts valid_id.match_string?("eve[7]")
  puts valid_id.match_string?("Job[48]")
  puts valid_id.match_string?("snakey")
} outputs "true\ntrue\nfalse\nfalse"

example "match" {
  puts match("foo.*", "seafood".bytes).unwrap
  puts match("bar.*", "seafood".bytes).unwrap
  puts match("a(b", "seafood".bytes).err.unwrap.message
} outputs "true\nfalse\nerror parsing regexp: missing closing ): `a(b`"

example "match_string" {
  puts match_string("foo.*", "seafood").unwrap
  puts match_string("bar.*", "seafood").unwrap
  puts match_string("a(b", "seafood").err.unwrap.message
} outputs "true\nfalse\nerror parsing regexp: missing closing ): `a(b`"

example "quote_meta" {
  puts quote_meta("Escaping symbols like: .+*?()|[]{}^$")
} outputs "Escaping symbols like: \\.\\+\\*\\?\\(\\)\\|\\[\\]\\{\\}\\^\\$"

example "find" {
  re = must_compile("foo.?")
  puts strconv.quote(Str.from_bytes(re.find("seafood fool".bytes).unwrap))
} outputs "\"food\""

example "find_all" {
  re = must_compile("foo.?")
  puts quote_list(re.find_all("seafood fool".bytes, -1).map { |b| Str.from_bytes(b) })
} outputs "[\"food\" \"fool\"]"

example "find_all_submatch" {
  re = must_compile("foo(.?)")
  parts: [Str] = []
  for m in re.find_all_submatch("seafood fool".bytes, -1) { parts << bquote_list(m) }
  puts "[" + strings.join(parts, " ") + "]"
} outputs "[[\"food\" \"d\"] [\"fool\" \"l\"]]"

example "find_submatch" {
  re = must_compile("foo(.?)")
  puts bquote_list(re.find_submatch("seafood fool".bytes).unwrap)
} outputs "[\"food\" \"d\"]"

example "match?" {
  re = must_compile("foo.?")
  puts re.match?("seafood fool".bytes)
  puts re.match?("something else".bytes)
} outputs "true\nfalse"

example "find_string" {
  re = must_compile("foo.?")
  puts strconv.quote(re.find_string("seafood fool"))
  puts strconv.quote(re.find_string("meat"))
} outputs "\"food\"\n\"\""

example "find_string_index" {
  re = must_compile("ab?")
  puts re.find_string_index("tablett").unwrap
  puts re.find_string_index("foo").none?
} outputs "[1 3]\ntrue"

example "find_string_submatch" {
  re = must_compile("a(x*)b(y|z)c")
  puts quote_list(re.find_string_submatch("-axxxbyc-").unwrap)
  puts quote_list(re.find_string_submatch("-abzc-").unwrap)
} outputs "[\"axxxbyc\" \"xxx\" \"y\"]\n[\"abzc\" \"\" \"z\"]"

example "find_all_string" {
  re = must_compile("a.")
  puts re.find_all_string("paranormal", -1)
  puts re.find_all_string("paranormal", 2)
  puts re.find_all_string("graal", -1)
  puts re.find_all_string("none", -1)
} outputs "[ar an al]\n[ar an]\n[aa]\n[]"

example "find_all_string_submatch" {
  re = must_compile("a(x*)b")
  for s in ["-ab-", "-axxb-", "-ab-axb-", "-axxb-ab-"] {
    parts: [Str] = []
    for m in re.find_all_string_submatch(s, -1) { parts << quote_list(m) }
    puts "[" + strings.join(parts, " ") + "]"
  }
} outputs "[[\"ab\" \"\"]]\n[[\"axxb\" \"xx\"]]\n[[\"ab\" \"\"] [\"axb\" \"x\"]]\n[[\"axxb\" \"xx\"] [\"ab\" \"\"]]"

example "find_all_string_submatch_index" {
  re = must_compile("a(x*)b")
  # Indices:
  #    01234567   012345678
  #    -ab-axb-   -axxb-ab-
  puts re.find_all_string_submatch_index("-ab-", -1)
  puts re.find_all_string_submatch_index("-axxb-", -1)
  puts re.find_all_string_submatch_index("-ab-axb-", -1)
  puts re.find_all_string_submatch_index("-axxb-ab-", -1)
  puts re.find_all_string_submatch_index("-foo-", -1)
} outputs "[[1 3 2 2]]\n[[1 5 2 4]]\n[[1 3 2 2] [4 7 5 6]]\n[[1 5 2 4] [6 8 7 7]]\n[]"

example "find_submatch_index" {
  re = must_compile("a(x*)b")
  puts re.find_submatch_index("-ab-".bytes) || []
  puts re.find_submatch_index("-axxb-".bytes) || []
  puts re.find_submatch_index("-ab-axb-".bytes) || []
  puts re.find_submatch_index("-axxb-ab-".bytes) || []
  puts re.find_submatch_index("-foo-".bytes) || []
} outputs "[1 3 2 2]\n[1 5 2 4]\n[1 3 2 2]\n[1 5 2 4]\n[]"

example "longest" {
  re = must_compile("a(|b)")
  puts re.find_string("ab")
  re.longest!
  puts re.find_string("ab")
} outputs "a\nab"

example "match_string?" {
  re = must_compile("(gopher){2}")
  puts re.match_string?("gopher")
  puts re.match_string?("gophergopher")
  puts re.match_string?("gophergophergopher")
} outputs "false\ntrue\ntrue"

example "num_subexp" {
  re0 = must_compile("a.")
  puts re0.num_subexp
  re = must_compile("(.*)((a)b)(.*)a")
  puts re.num_subexp
} outputs "0\n4"

example "replace_all" {
  re = must_compile("a(x*)b")
  puts Str.from_bytes(re.replace_all("-ab-axxb-".bytes, "T".bytes))
  puts Str.from_bytes(re.replace_all("-ab-axxb-".bytes, "$1".bytes))
  puts Str.from_bytes(re.replace_all("-ab-axxb-".bytes, "$1W".bytes))
  puts Str.from_bytes(re.replace_all("-ab-axxb-".bytes, "${1}W".bytes))
  re2 = must_compile("a(?P<1W>x*)b")
  puts Str.from_bytes(re2.replace_all("-ab-axxb-".bytes, "$1W".bytes))
  puts Str.from_bytes(re2.replace_all("-ab-axxb-".bytes, "${1}W".bytes))
} outputs "-T-T-\n--xx-\n---\n-W-xxW-\n--xx-\n-W-xxW-"

example "replace_all_literal_string" {
  re = must_compile("a(x*)b")
  puts re.replace_all_literal_string("-ab-axxb-", "T")
  puts re.replace_all_literal_string("-ab-axxb-", "$1")
  puts re.replace_all_literal_string("-ab-axxb-", "${1}")
} outputs "-T-T-\n-$1-$1-\n-${1}-${1}-"

example "replace_all_string" {
  re = must_compile("a(x*)b")
  puts re.replace_all_string("-ab-axxb-", "T")
  puts re.replace_all_string("-ab-axxb-", "$1")
  puts re.replace_all_string("-ab-axxb-", "$1W")
  puts re.replace_all_string("-ab-axxb-", "${1}W")
  re2 = must_compile("a(?P<1W>x*)b")
  puts re2.replace_all_string("-ab-axxb-", "$1W")
  puts re.replace_all_string("-ab-axxb-", "${1}W")
} outputs "-T-T-\n--xx-\n---\n-W-xxW-\n--xx-\n-W-xxW-"

example "replace_all_string_func" {
  re = must_compile("[^aeiou]")
  puts re.replace_all_string_func("seafood fool", ->(s: Str) -> Str { strings.to_upper(s) })
} outputs "SeaFooD FooL"

example "subexp_names" {
  re = must_compile("(?P<first>[a-zA-Z]+) (?P<last>[a-zA-Z]+)")
  puts re.match_string?("Alan Turing")
  puts quote_list(re.subexp_names)
  reversed = "${" + re.subexp_names[2] + "} ${" + re.subexp_names[1] + "}"
  puts reversed
  puts re.replace_all_string("Alan Turing", reversed)
} outputs "true\n[\"\" \"first\" \"last\"]\n${last} ${first}\nTuring Alan"

example "subexp_index" {
  re = must_compile("(?P<first>[a-zA-Z]+) (?P<last>[a-zA-Z]+)")
  puts re.match_string?("Alan Turing")
  matches = re.find_string_submatch("Alan Turing").unwrap
  last_index = re.subexp_index("last")
  puts "last => #{last_index}"
  puts matches[last_index]
} outputs "true\nlast => 2\nTuring"

example "split" {
  a = must_compile("a")
  puts a.split("banana", -1)
  puts a.split("banana", 0)
  puts a.split("banana", 1)
  puts a.split("banana", 2)
  zp = must_compile("z+")
  puts zp.split("pizza", -1)
  puts zp.split("pizza", 0)
  puts zp.split("pizza", 1)
  puts zp.split("pizza", 2)
} outputs "[b n n ]\n[]\n[banana]\n[b nana]\n[pi a]\n[]\n[pizza]\n[pi a]"

example "expand" {
  content = "\n\t# comment line\n\toption1: value1\n\toption2: value2\n\n\t# another comment line\n\toption3: value3\n".bytes
  # Regex pattern captures "key: value" pair from the content.
  pattern = must_compile("(?m)(?P<key>\\w+):\\s+(?P<value>\\w+)$")
  # Template to convert "key: value" to "key=value" by referencing the
  # values captured by the regex pattern.
  template = "$key=$value\n".bytes
  result: [Byte] = []
  # For each match of the regex in the content.
  for submatches in pattern.find_all_submatch_index(content, -1) {
    # Apply the captured submatches to the template and append the output
    # to the result.
    result = pattern.expand(result, template, content, submatches)
  }
  puts Str.from_bytes(result)
} outputs "option1=value1\noption2=value2\noption3=value3\n"

example "expand_string" {
  content = "\n\t# comment line\n\toption1: value1\n\toption2: value2\n\n\t# another comment line\n\toption3: value3\n"
  pattern = must_compile("(?m)(?P<key>\\w+):\\s+(?P<value>\\w+)$")
  template = "$key=$value\n"
  result: [Byte] = []
  for submatches in pattern.find_all_string_submatch_index(content, -1) {
    result = pattern.expand_string(result, template, content, submatches)
  }
  puts Str.from_bytes(result)
} outputs "option1=value1\noption2=value2\noption3=value3\n"

example "find_index" {
  content = "\n\t# comment line\n\toption1: value1\n\toption2: value2\n".bytes
  pattern = must_compile("(?m)(?P<key>\\w+):\\s+(?P<value>\\w+)$")
  loc = pattern.find_index(content).unwrap
  puts loc
  puts Str.from_bytes(content[loc[0]...loc[1]])
} outputs "[18 33]\noption1: value1"

example "find_all_submatch_index" {
  content = "\n\t# comment line\n\toption1: value1\n\toption2: value2\n".bytes
  pattern = must_compile("(?m)(?P<key>\\w+):\\s+(?P<value>\\w+)$")
  for loc in pattern.find_all_submatch_index(content, -1) {
    puts loc
    puts Str.from_bytes(content[loc[0]...loc[1]])
    puts Str.from_bytes(content[loc[2]...loc[3]])
    puts Str.from_bytes(content[loc[4]...loc[5]])
  }
} outputs "[18 33 18 25 27 33]\noption1: value1\noption1\nvalue1\n[35 50 35 42 44 50]\noption2: value2\noption2\nvalue2"

example "find_all_index" {
  content = "London".bytes
  re = must_compile("o.")
  puts re.find_all_index(content, 1)
  puts re.find_all_index(content, -1)
} outputs "[[1 3]]\n[[1 3] [4 6]]"
