# The Perl (\d \s \w) and POSIX ([:alpha:] ...) character groups, after Go's
# regexp/syntax/perl_groups.go.

# A character group: sign +1 or -1 (negated) and its class (range pairs).
struct CharGroup {
  sign: Int
  class: [Rune]
}

# The group for \c (c a byte: d D s S w W), or none.
def perl_group(c: Byte) -> CharGroup? {
  case c {
    100 => CharGroup.new(sign: 1, class: [0x30, 0x39])                                     # \d
    68 => CharGroup.new(sign: -1, class: [0x30, 0x39])                                     # \D
    115 => CharGroup.new(sign: 1, class: [0x9, 0xa, 0xc, 0xd, 0x20, 0x20])                 # \s
    83 => CharGroup.new(sign: -1, class: [0x9, 0xa, 0xc, 0xd, 0x20, 0x20])                 # \S
    119 => CharGroup.new(sign: 1, class: [0x30, 0x39, 0x41, 0x5a, 0x5f, 0x5f, 0x61, 0x7a]) # \w
    87 => CharGroup.new(sign: -1, class: [0x30, 0x39, 0x41, 0x5a, 0x5f, 0x5f, 0x61, 0x7a]) # \W
    _ => none
  }
}

# The class of a POSIX group name ("alnum", ...), or [].
def posix_class(name: Str) -> [Int] {
  case name {
    "alnum" => [0x30, 0x39, 0x41, 0x5a, 0x61, 0x7a]
    "alpha" => [0x41, 0x5a, 0x61, 0x7a]
    "ascii" => [0x0, 0x7f]
    "blank" => [0x9, 0x9, 0x20, 0x20]
    "cntrl" => [0x0, 0x1f, 0x7f, 0x7f]
    "digit" => [0x30, 0x39]
    "graph" => [0x21, 0x7e]
    "lower" => [0x61, 0x7a]
    "print" => [0x20, 0x7e]
    "punct" => [0x21, 0x2f, 0x3a, 0x40, 0x5b, 0x60, 0x7b, 0x7e]
    "space" => [0x9, 0xd, 0x20, 0x20]
    "upper" => [0x41, 0x5a]
    "word" => [0x30, 0x39, 0x41, 0x5a, 0x5f, 0x5f, 0x61, 0x7a]
    "xdigit" => [0x30, 0x39, 0x41, 0x46, 0x61, 0x66]
    _ => []
  }
}

# The group for a POSIX class like "[:alnum:]" or "[:^alnum:]", or none.
def posix_group(full: Str) -> CharGroup? {
  return none if full.size < 5
  name = full[2...full.size - 2]
  sign = 1
  if name.size > 0 && name[0] == 94 {
    sign = -1
    name = name[1...name.size]
  }
  c = posix_class(name)
  return none if c.size == 0
  rs: [Rune] = []
  for x in c { rs << x.to_i32 }
  CharGroup.new(sign: sign, class: rs)
}
