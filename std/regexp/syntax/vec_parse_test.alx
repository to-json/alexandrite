  check_string_equivalent("a{2}")
  assert_eq dump_of("a{2,3}", 204), "rep{2,3 lit{a}}"
  assert_eq parse("a{2,3}", 204).unwrap.to_s, "a{2,3}"
  check_string_equivalent("a{2,3}")
  assert_eq dump_of("a{2,}", 204), "rep{2,-1 lit{a}}"
  assert_eq parse("a{2,}", 204).unwrap.to_s, "a{2,}"
  check_string_equivalent("a{2,}")
  assert_eq dump_of("a*?", 204), "nstar{lit{a}}"
  assert_eq parse("a*?", 204).unwrap.to_s, "a*?"
}

test "parse simple 2" {
  check_string_equivalent("a*?")
  assert_eq dump_of("a+?", 204), "nplus{lit{a}}"
  assert_eq parse("a+?", 204).unwrap.to_s, "a+?"
  check_string_equivalent("a+?")
  assert_eq dump_of("a??", 204), "nque{lit{a}}"
  assert_eq parse("a??", 204).unwrap.to_s, "a??"
  check_string_equivalent("a??")
  assert_eq dump_of("a{2}?", 204), "nrep{2,2 lit{a}}"
  assert_eq parse("a{2}?", 204).unwrap.to_s, "a{2}?"
  check_string_equivalent("a{2}?")
  assert_eq dump_of("a{2,3}?", 204), "nrep{2,3 lit{a}}"
  assert_eq parse("a{2,3}?", 204).unwrap.to_s, "a{2,3}?"
  check_string_equivalent("a{2,3}?")
  assert_eq dump_of("a{2,}?", 204), "nrep{2,-1 lit{a}}"
