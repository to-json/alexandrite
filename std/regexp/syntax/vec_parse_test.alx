  assert_eq dump_of("\\\\", 204), "lit{\\}"
  assert_eq parse("\\\\", 204).unwrap.to_s, "\\\\"
  check_string_equivalent("\\\\")
  assert_eq dump_of("[ace]", 204), "cc{0x61 0x63 0x65}"
  assert_eq parse("[ace]", 204).unwrap.to_s, "[ace]"
  check_string_equivalent("[ace]")
  assert_eq dump_of("[abc]", 204), "cc{0x61-0x63}"
