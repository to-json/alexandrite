test "parse simple 8" {
  check_string_equivalent("\\S")
  assert_eq dump_of("\\w", 204), "cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}"
  assert_eq parse("\\w", 204).unwrap.to_s, "[0-9A-Z_a-z]"
  check_string_equivalent("\\w")
  assert_eq dump_of("\\W", 204), "cc{0x0-0x2f 0x3a-0x40 0x5b-0x5e 0x60 0x7b-0x10ffff}"
  assert_eq parse("\\W", 204).unwrap.to_s, "[^0-9A-Z_a-z]"
  check_string_equivalent("\\W")
  assert_eq dump_of("(?i)\\w", 204), "cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a 0x17f 0x212a}"
  assert_eq parse("(?i)\\w", 204).unwrap.to_s, "[0-9A-Z_a-zſK]"
  check_string_equivalent("(?i)\\w")
  assert_eq dump_of("(?i)\\W", 204), "cc{0x0-0x2f 0x3a-0x40 0x5b-0x5e 0x60 0x7b-0x17e 0x180-0x2129 0x212b-0x10ffff}"
  assert_eq parse("(?i)\\W", 204).unwrap.to_s, "[^0-9A-Z_a-zſK]"
  check_string_equivalent("(?i)\\W")
  assert_eq dump_of("[^\\\\]", 204), "cc{0x0-0x5b 0x5d-0x10ffff}"
  assert_eq parse("[^\\\\]", 204).unwrap.to_s, "[^\\\\]"
  check_string_equivalent("[^\\\\]")
  assert_eq dump_of("\\p{Braille}", 204), "cc{0x2800-0x28ff}"
  assert_eq parse("\\p{Braille}", 204).unwrap.to_s, "[⠀-⣿]"
  check_string_equivalent("\\p{Braille}")
  assert_eq dump_of("\\P{Braille}", 204), "cc{0x0-0x27ff 0x2900-0x10ffff}"
  assert_eq parse("\\P{Braille}", 204).unwrap.to_s, "[^⠀-⣿]"
  check_string_equivalent("\\P{Braille}")
  assert_eq dump_of("\\p{^Braille}", 204), "cc{0x0-0x27ff 0x2900-0x10ffff}"
  assert_eq parse("\\p{^Braille}", 204).unwrap.to_s, "[^⠀-⣿]"
  check_string_equivalent("\\p{^Braille}")
}

