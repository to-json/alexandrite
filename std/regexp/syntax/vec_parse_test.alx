  assert_eq parse("\\p{^Any}", 204).unwrap.to_s, "[^\\x00-\\x{10FFFF}]"
  check_string_equivalent("\\p{^Any}")
  assert_eq dump_of("(?i)\\p{ascii}", 204), "cc{0x0-0x7f 0x17f 0x212a}"
  assert_eq parse("(?i)\\p{ascii}", 204).unwrap.to_s, "[\\x00-\\x7fſK]"
}

