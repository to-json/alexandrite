d}-\\x{1e12f}\\x{1e13e}\\x{1e13f}\\x{1e14a}-\\x{1e14d}\\x{1e150}-\\x{1e28f}\\x{1e2af}-\\x{1e2bf}\\x{1e2fa}-\\x{1e2fe}\\x{1e300}-\\x{1e4cf}\\x{1e4fa}-\\x{1e5cf}\\x{1e5fb}-\\x{1e5fe}\\x{1e600}-\\x{1e6bf}\\x{1e6df}\\x{1e6f6}-\\x{1e6fd}\\x{1e700}-\\x{1e7df}\\x{1e7e7}\\x{1e7ec}\\x{1e7ef}\\x{1e7ff}\\x{1e8c5}\\x{1e8c6}\\x{1e8d7}-\\x{1e8ff}\\x{1e94c}-\\x{1e94f}\\x{1e95a}-\\x{1e95d}\\x{1e960}-\\x{1ec70}\\x{1ecb5}-\\x{1ed00}\\x{1ed3e}-\\x{1edff}\\x{1ee04}\\x{1ee20}\\x{1ee23}\\x{1ee25}\\x{1ee26}\\x{1ee28}\\x{1ee33}\\x{1ee38}\\x{1ee3a}\\x{1ee3c}-\\x{1ee41}\\x{1ee43}-\\x{1ee46}\\x{1ee48}\\x{1ee4a}\\x{1ee4c}\\x{1ee50}\\x{1ee53}\\x{1ee55}\\x{1ee56}\\x{1ee58}\\x{1ee5a}\\x{1ee5c}\\x{1ee5e}\\x{1ee60}\\x{1ee63}\\x{1ee65}\\x{1ee66}\\x{1ee6b}\\x{1ee73}\\x{1ee78}\\x{1ee7d}\\x{1ee7f}\\x{1ee8a}\\x{1ee9c}-\\x{1eea0}\\x{1eea4}\\x{1eeaa}\\x{1eebc}-\\x{1eeef}\\x{1eef2}-\\x{1efff}\\x{1f02c}-\\x{1f02f}\\x{1f094}-\\x{1f09f}\\x{1f0af}\\x{1f0b0}\\x{1f0c0}\\x{1f0d0}\\x{1f0f6}-\\x{1f0ff}\\x{1f1ae}-\\x{1f1e5}\\x{1f203}-\\x{1f20f}\\x{1f23c}-\\x{1f23f}\\x{1f249}-\\x{1f24f}\\x{1f252}-\\x{1f25f}\\x{1f266}-\\x{1f2ff}\\x{1f6d9}-\\x{1f6db}\\x{1f6ed}-\\x{1f6ef}\\x{1f6fd}-\\x{1f6ff}\\x{1f7da}-\\x{1f7df}\\x{1f7ec}-\\x{1f7ef}\\x{1f7f1}-\\x{1f7ff}\\x{1f80c}-\\x{1f80f}\\x{1f848}-\\x{1f84f}\\x{1f85a}-\\x{1f85f}\\x{1f888}-\\x{1f88f}\\x{1f8ae}\\x{1f8af}\\x{1f8bc}-\\x{1f8bf}\\x{1f8c2}-\\x{1f8cf}\\x{1f8d9}-\\x{1f8ff}\\x{1fa58}-\\x{1fa5f}\\x{1fa6e}\\x{1fa6f}\\x{1fa7d}-\\x{1fa7f}\\x{1fa8b}-\\x{1fa8d}\\x{1fac7}\\x{1fac9}-\\x{1facc}\\x{1fadd}\\x{1fade}\\x{1faeb}-\\x{1faee}\\x{1faf9}-\\x{1faff}\\x{1fb93}\\x{1fbfb}-\\x{1ffff}\\x{2a6e0}-\\x{2a6ff}\\x{2b81e}\\x{2b81f}\\x{2ceae}\\x{2ceaf}\\x{2ebe1}-\\x{2ebef}\\x{2ee5e}-\\x{2f7ff}\\x{2fa1e}-\\x{2ffff}\\x{3134b}-\\x{3134f}\\x{3347a}-\\x{e0000}\\x{e0002}-\\x{e001f}\\x{e0080}-\\x{e00ff}\\x{e01f0}-\\x{effff}\\x{ffffe}\\x{fffff}\\x{10fffe}\\x{10ffff}]"
  check_string_equivalent("\\p{^Assigned}")
  assert_eq dump_of("[\\012-\\234]\\141", 204), "cat{cc{0xa-0x9c}lit{a}}"
  assert_eq parse("[\\012-\\234]\\141", 204).unwrap.to_s, "[\\n-\\x9c]a"
  check_string_equivalent("[\\012-\\234]\\141")
  assert_eq dump_of("[\\x{41}-\\x7a]\\x61", 204), "cat{cc{0x41-0x7a}lit{a}}"
  assert_eq parse("[\\x{41}-\\x7a]\\x61", 204).unwrap.to_s, "[A-z]a"
  check_string_equivalent("[\\x{41}-\\x7a]\\x61")
  assert_eq dump_of("a{,2}", 204), "str{a{,2}}"
  assert_eq parse("a{,2}", 204).unwrap.to_s, "a\\{,2\\}"
  check_string_equivalent("a{,2}")
  assert_eq dump_of("\\.\\^\\$\\\\", 204), "str{.^$\\}"
  assert_eq parse("\\.\\^\\$\\\\", 204).unwrap.to_s, "\\.\\^\\$\\\\"
  check_string_equivalent("\\.\\^\\$\\\\")
  assert_eq dump_of("[a-zABC]", 204), "cc{0x41-0x43 0x61-0x7a}"
  assert_eq parse("[a-zABC]", 204).unwrap.to_s, "[A-Ca-z]"
  check_string_equivalent("[a-zABC]")
  assert_eq dump_of("[^a]", 204), "cc{0x0-0x60 0x62-0x10ffff}"
  assert_eq parse("[^a]", 204).unwrap.to_s, "[^a]"
  check_string_equivalent("[^a]")
}

test "parse simple 12" {
  assert_eq dump_of("[α-ε☺]", 204), "cc{0x3b1-0x3b5 0x263a}"
  assert_eq parse("[α-ε☺]", 204).unwrap.to_s, "[α-ε☺]"
  check_string_equivalent("[α-ε☺]")
  assert_eq dump_of("a*{", 204), "cat{star{lit{a}}lit{{}}"
  assert_eq parse("a*{", 204).unwrap.to_s, "a*\\{"
  check_string_equivalent("a*{")
  assert_eq dump_of("(?:ab)*", 204), "star{str{ab}}"
  assert_eq parse("(?:ab)*", 204).unwrap.to_s, "(?:ab)*"
  check_string_equivalent("(?:ab)*")
  assert_eq dump_of("(ab)*", 204), "star{cap{str{ab}}}"
  assert_eq parse("(ab)*", 204).unwrap.to_s, "(ab)*"
  check_string_equivalent("(ab)*")
  assert_eq dump_of("ab|cd", 204), "alt{str{ab}str{cd}}"
  assert_eq parse("ab|cd", 204).unwrap.to_s, "ab|cd"
  check_string_equivalent("ab|cd")
  assert_eq dump_of("a(b|c)d", 204), "cat{lit{a}cap{cc{0x62-0x63}}lit{d}}"
  assert_eq parse("a(b|c)d", 204).unwrap.to_s, "a([bc])d"
  check_string_equivalent("a(b|c)d")
  assert_eq dump_of("(?:a)", 204), "lit{a}"
  assert_eq parse("(?:a)", 204).unwrap.to_s, "a"
  check_string_equivalent("(?:a)")
  assert_eq dump_of("(?:ab)(?:cd)", 204), "str{abcd}"
  assert_eq parse("(?:ab)(?:cd)", 204).unwrap.to_s, "abcd"
  check_string_equivalent("(?:ab)(?:cd)")
  assert_eq dump_of("(?:a+b+)(?:c+d+)", 204), "cat{plus{lit{a}}plus{lit{b}}plus{lit{c}}plus{lit{d}}}"
}

test "parse simple 13" {
  assert_eq parse("(?:a+b+)(?:c+d+)", 204).unwrap.to_s, "a+b+c+d+"
  check_string_equivalent("(?:a+b+)(?:c+d+)")
  assert_eq dump_of("(?:a+|b+)|(?:c+|d+)", 204), "alt{plus{lit{a}}plus{lit{b}}plus{lit{c}}plus{lit{d}}}"
  assert_eq parse("(?:a+|b+)|(?:c+|d+)", 204).unwrap.to_s, "a+|b+|c+|d+"
  check_string_equivalent("(?:a+|b+)|(?:c+|d+)")
  assert_eq dump_of("(?:a|b)|(?:c|d)", 204), "cc{0x61-0x64}"
  assert_eq parse("(?:a|b)|(?:c|d)", 204).unwrap.to_s, "[a-d]"
  check_string_equivalent("(?:a|b)|(?:c|d)")
  assert_eq dump_of("a|.", 204), "dot{}"
  assert_eq parse("a|.", 204).unwrap.to_s, "(?s:.)"
  check_string_equivalent("a|.")
  assert_eq dump_of(".|a", 204), "dot{}"
  assert_eq parse(".|a", 204).unwrap.to_s, "(?s:.)"
  check_string_equivalent(".|a")
  assert_eq dump_of("(?:[abc]|A|Z|hello|world)", 204), "alt{cc{0x41 0x5a 0x61-0x63}str{hello}str{world}}"
  assert_eq parse("(?:[abc]|A|Z|hello|world)", 204).unwrap.to_s, "[AZa-c]|hello|world"
  check_string_equivalent("(?:[abc]|A|Z|hello|world)")
  assert_eq dump_of("(?:[abc]|A|Z)", 204), "cc{0x41 0x5a 0x61-0x63}"
  assert_eq parse("(?:[abc]|A|Z)", 204).unwrap.to_s, "[AZa-c]"
  check_string_equivalent("(?:[abc]|A|Z)")
  assert_eq dump_of("\\Q+|*?{[\\E", 204), "str{+|*?{[}"
  assert_eq parse("\\Q+|*?{[\\E", 204).unwrap.to_s, "\\+\\|\\*\\?\\{\\["
  check_string_equivalent("\\Q+|*?{[\\E")
  assert_eq dump_of("\\Q+\\E+", 204), "plus{lit{+}}"
  assert_eq parse("\\Q+\\E+", 204).unwrap.to_s, "\\++"
}

test "parse simple 14" {
  check_string_equivalent("\\Q+\\E+")
  assert_eq dump_of("\\Qab\\E+", 204), "cat{lit{a}plus{lit{b}}}"
  assert_eq parse("\\Qab\\E+", 204).unwrap.to_s, "ab+"
  check_string_equivalent("\\Qab\\E+")
  assert_eq dump_of("\\Q\\\\E", 204), "lit{\\}"
  assert_eq parse("\\Q\\\\E", 204).unwrap.to_s, "\\\\"
  check_string_equivalent("\\Q\\\\E")
  assert_eq dump_of("\\Q\\\\\\E", 204), "str{\\\\}"
  assert_eq parse("\\Q\\\\\\E", 204).unwrap.to_s, "\\\\\\\\"
  check_string_equivalent("\\Q\\\\\\E")
  assert_eq dump_of("(?m)^", 204), "bol{}"
  assert_eq parse("(?m)^", 204).unwrap.to_s, "(?m:^)"
  check_string_equivalent("(?m)^")
  assert_eq dump_of("(?m)$", 204), "eol{}"
  assert_eq parse("(?m)$", 204).unwrap.to_s, "(?m:$)"
  check_string_equivalent("(?m)$")
  assert_eq dump_of("(?-m)^", 204), "bot{}"
  assert_eq parse("(?-m)^", 204).unwrap.to_s, "\\A"
  check_string_equivalent("(?-m)^")
  assert_eq dump_of("(?-m)$", 204), "eot{}"
  assert_eq parse("(?-m)$", 204).unwrap.to_s, "(?-m:$)"
  check_string_equivalent("(?-m)$")
  assert_eq dump_of("(?m)\\A", 204), "bot{}"
  assert_eq parse("(?m)\\A", 204).unwrap.to_s, "\\A"
  check_string_equivalent("(?m)\\A")
}

test "parse simple 15" {
  assert_eq dump_of("(?m)\\z", 204), "eot{\\z}"
  assert_eq parse("(?m)\\z", 204).unwrap.to_s, "\\z"
  check_string_equivalent("(?m)\\z")
  assert_eq dump_of("(?-m)\\A", 204), "bot{}"
  assert_eq parse("(?-m)\\A", 204).unwrap.to_s, "\\A"
  check_string_equivalent("(?-m)\\A")
  assert_eq dump_of("(?-m)\\z", 204), "eot{\\z}"
  assert_eq parse("(?-m)\\z", 204).unwrap.to_s, "\\z"
  check_string_equivalent("(?-m)\\z")
  assert_eq dump_of("(?P<name>a)", 204), "cap{name:lit{a}}"
  assert_eq parse("(?P<name>a)", 204).unwrap.to_s, "(?P<name>a)"
  check_string_equivalent("(?P<name>a)")
  assert_eq dump_of("(?<name>a)", 204), "cap{name:lit{a}}"
  assert_eq parse("(?<name>a)", 204).unwrap.to_s, "(?P<name>a)"
  check_string_equivalent("(?<name>a)")
  assert_eq dump_of("[Aa]", 204), "litfold{A}"
  assert_eq parse("[Aa]", 204).unwrap.to_s, "(?i:A)"
  check_string_equivalent("[Aa]")
  assert_eq dump_of("[\\x{100}\\x{101}]", 204), "litfold{Ā}"
  assert_eq parse("[\\x{100}\\x{101}]", 204).unwrap.to_s, "(?i:Ā)"
  check_string_equivalent("[\\x{100}\\x{101}]")
  assert_eq dump_of("[Δδ]", 204), "litfold{Δ}"
  assert_eq parse("[Δδ]", 204).unwrap.to_s, "(?i:Δ)"
  check_string_equivalent("[Δδ]")
  assert_eq dump_of("abcde", 204), "str{abcde}"
}

test "parse simple 16" {
  assert_eq parse("abcde", 204).unwrap.to_s, "abcde"
  check_string_equivalent("abcde")
  assert_eq dump_of("[Aa][Bb]cd", 204), "cat{strfold{AB}str{cd}}"
  assert_eq parse("[Aa][Bb]cd", 204).unwrap.to_s, "(?i:AB)cd"
  check_string_equivalent("[Aa][Bb]cd")
  assert_eq dump_of("abc|abd|aef|bcx|bcy", 204), "alt{cat{lit{a}alt{cat{lit{b}cc{0x63-0x64}}str{ef}}}cat{str{bc}cc{0x78-0x79}}}"
  assert_eq parse("abc|abd|aef|bcx|bcy", 204).unwrap.to_s, "a(?:b[cd]|ef)|bc[xy]"
  check_string_equivalent("abc|abd|aef|bcx|bcy")
  assert_eq dump_of("ax+y|ax+z|ay+w", 204), "cat{lit{a}alt{cat{plus{lit{x}}lit{y}}cat{plus{lit{x}}lit{z}}cat{plus{lit{y}}lit{w}}}}"
  assert_eq parse("ax+y|ax+z|ay+w", 204).unwrap.to_s, "a(?:x+y|x+z|y+w)"
  check_string_equivalent("ax+y|ax+z|ay+w")
  assert_eq dump_of("(?:.)", 204), "dot{}"
  assert_eq parse("(?:.)", 204).unwrap.to_s, "(?s:.)"
  check_string_equivalent("(?:.)")
  assert_eq dump_of("(?:x|(?:xa))", 204), "cat{lit{x}alt{emp{}lit{a}}}"
  assert_eq parse("(?:x|(?:xa))", 204).unwrap.to_s, "x(?:(?:)|a)"
  check_string_equivalent("(?:x|(?:xa))")
  assert_eq dump_of("(?:.|(?:.a))", 204), "cat{dot{}alt{emp{}lit{a}}}"
  assert_eq parse("(?:.|(?:.a))", 204).unwrap.to_s, "(?s:.(?:(?:)|a))"
  check_string_equivalent("(?:.|(?:.a))")
  assert_eq dump_of("(?:A(?:A|a))", 204), "cat{lit{A}litfold{A}}"
  assert_eq parse("(?:A(?:A|a))", 204).unwrap.to_s, "A(?i:A)"
  check_string_equivalent("(?:A(?:A|a))")
  assert_eq dump_of("(?:A|a)", 204), "litfold{A}"
  assert_eq parse("(?:A|a)", 204).unwrap.to_s, "(?i:A)"
}

test "parse simple 17" {
  check_string_equivalent("(?:A|a)")
  assert_eq dump_of("A|(?:A|a)", 204), "litfold{A}"
  assert_eq parse("A|(?:A|a)", 204).unwrap.to_s, "(?i:A)"
  check_string_equivalent("A|(?:A|a)")
  assert_eq dump_of("(?s).", 204), "dot{}"
  assert_eq parse("(?s).", 204).unwrap.to_s, "(?s:.)"
  check_string_equivalent("(?s).")
  assert_eq dump_of("(?-s).", 204), "dnl{}"
  assert_eq parse("(?-s).", 204).unwrap.to_s, "(?-s:.)"
  check_string_equivalent("(?-s).")
  assert_eq dump_of("(?:(?:^).)", 204), "cat{bol{}dot{}}"
  assert_eq parse("(?:(?:^).)", 204).unwrap.to_s, "(?ms:^.)"
  check_string_equivalent("(?:(?:^).)")
  assert_eq dump_of("(?-s)(?:(?:^).)", 204), "cat{bol{}dnl{}}"
  assert_eq parse("(?-s)(?:(?:^).)", 204).unwrap.to_s, "(?m-s:^.)"
  check_string_equivalent("(?-s)(?:(?:^).)")
  assert_eq dump_of("[\\s\\S]a", 204), "cat{cc{0x0-0x10ffff}lit{a}}"
  assert_eq parse("[\\s\\S]a", 204).unwrap.to_s, "[\\x00-\\x{10ffff}]a"
  check_string_equivalent("[\\s\\S]a")
  assert_eq dump_of("abc|abd", 204), "cat{str{ab}cc{0x63-0x64}}"
  assert_eq parse("abc|abd", 204).unwrap.to_s, "ab[cd]"
  check_string_equivalent("abc|abd")
  assert_eq dump_of("a(?:b)c|abd", 204), "cat{str{ab}cc{0x63-0x64}}"
  assert_eq parse("a(?:b)c|abd", 204).unwrap.to_s, "ab[cd]"
  check_string_equivalent("a(?:b)c|abd")
}

test "parse simple 18" {
  assert_eq dump_of("abc|abd|aef|bcx|bcy", 204), "alt{cat{lit{a}alt{cat{lit{b}cc{0x63-0x64}}str{ef}}}cat{str{bc}cc{0x78-0x79}}}"
  assert_eq parse("abc|abd|aef|bcx|bcy", 204).unwrap.to_s, "a(?:b[cd]|ef)|bc[xy]"
  check_string_equivalent("abc|abd|aef|bcx|bcy")
  assert_eq dump_of("abc|x|abd", 204), "alt{str{abc}lit{x}str{abd}}"
  assert_eq parse("abc|x|abd", 204).unwrap.to_s, "abc|x|abd"
  check_string_equivalent("abc|x|abd")
  assert_eq dump_of("(?i)abc|ABD", 204), "cat{strfold{AB}cc{0x43-0x44 0x63-0x64}}"
  assert_eq parse("(?i)abc|ABD", 204).unwrap.to_s, "(?i:AB[CDcd])"
  check_string_equivalent("(?i)abc|ABD")
  assert_eq dump_of("[ab]c|[ab]d", 204), "cat{cc{0x61-0x62}cc{0x63-0x64}}"
  assert_eq parse("[ab]c|[ab]d", 204).unwrap.to_s, "[ab][cd]"
  check_string_equivalent("[ab]c|[ab]d")
  assert_eq dump_of(".c|.d", 204), "cat{dot{}cc{0x63-0x64}}"
  assert_eq parse(".c|.d", 204).unwrap.to_s, "(?s:.[cd])"
  check_string_equivalent(".c|.d")
  assert_eq dump_of("x{2}|x{2}[0-9]", 204), "cat{rep{2,2 lit{x}}alt{emp{}cc{0x30-0x39}}}"
  assert_eq parse("x{2}|x{2}[0-9]", 204).unwrap.to_s, "x{2}(?:(?:)|[0-9])"
  check_string_equivalent("x{2}|x{2}[0-9]")
  assert_eq dump_of("x{2}y|x{2}[0-9]y", 204), "cat{rep{2,2 lit{x}}alt{lit{y}cat{cc{0x30-0x39}lit{y}}}}"
  assert_eq parse("x{2}y|x{2}[0-9]y", 204).unwrap.to_s, "x{2}(?:y|[0-9]y)"
  check_string_equivalent("x{2}y|x{2}[0-9]y")
  assert_eq dump_of("a.*?c|a.*?b", 204), "cat{lit{a}alt{cat{nstar{dot{}}lit{c}}cat{nstar{dot{}}lit{b}}}}"
  assert_eq parse("a.*?c|a.*?b", 204).unwrap.to_s, "(?s:a(?:.*?c|.*?b))"
  check_string_equivalent("a.*?c|a.*?b")
  assert_eq dump_of("((((((((((x{2}){2}){2}){2}){2}){2}){2}){2}){2}))", 204), "cap{cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 lit{x}}}}}}}}}}}}}}}}}}}}"
}

test "parse simple 19" {
  assert_eq parse("((((((((((x{2}){2}){2}){2}){2}){2}){2}){2}){2}))", 204).unwrap.to_s, "((((((((((x{2}){2}){2}){2}){2}){2}){2}){2}){2}))"
  assert_eq dump_of("((((((((((x{1}){2}){2}){2}){2}){2}){2}){2}){2}){2})", 204), "cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{2,2 cap{rep{1,1 lit{x}}}}}}}}}}}}}}}}}}}}}"
  assert_eq parse("((((((((((x{1}){2}){2}){2}){2}){2}){2}){2}){2}){2})", 204).unwrap.to_s, "((((((((((x{1}){2}){2}){2}){2}){2}){2}){2}){2}){2})"
}

test "parse foldcase 0" {
  assert_eq dump_of("AbCdE", 1), "strfold{ABCDE}"
  assert_eq parse("AbCdE", 1).unwrap.to_s, "(?i:ABCDE)"
  assert_eq dump_of("[Aa]", 1), "litfold{A}"
  assert_eq parse("[Aa]", 1).unwrap.to_s, "(?i:A)"
  assert_eq dump_of("a", 1), "litfold{A}"
  assert_eq parse("a", 1).unwrap.to_s, "(?i:A)"
  assert_eq dump_of("A[F-g]", 1), "cat{litfold{A}cc{0x41-0x7a 0x17f 0x212a}}"
  assert_eq parse("A[F-g]", 1).unwrap.to_s, "(?i:A[A-zſK])"
  assert_eq dump_of("[[:upper:]]", 1), "cc{0x41-0x5a 0x61-0x7a 0x17f 0x212a}"
  assert_eq parse("[[:upper:]]", 1).unwrap.to_s, "[A-Za-zſK]"
  assert_eq dump_of("[[:lower:]]", 1), "cc{0x41-0x5a 0x61-0x7a 0x17f 0x212a}"
  assert_eq parse("[[:lower:]]", 1).unwrap.to_s, "[A-Za-zſK]"
}

test "parse literal 0" {
  assert_eq dump_of("(|)^$.[*+?]{5,10},\\", 2), "str{(|)^$.[*+?]{5,10},\\}"
  assert_eq parse("(|)^$.[*+?]{5,10},\\", 2).unwrap.to_s, "\\(\\|\\)\\^\\$\\.\\[\\*\\+\\?\\]\\{5,10\\},\\\\"
}

test "parse matchnl 0" {
  assert_eq dump_of(".", 12), "dot{}"
  assert_eq parse(".", 12).unwrap.to_s, "(?s:.)"
  assert_eq dump_of("\n", 12), "lit{\n}"
  assert_eq parse("\n", 12).unwrap.to_s, "\\n"
  assert_eq dump_of("[^a]", 12), "cc{0x0-0x60 0x62-0x10ffff}"
  assert_eq parse("[^a]", 12).unwrap.to_s, "[^a]"
  assert_eq dump_of("[a\\n]", 12), "cc{0xa 0x61}"
  assert_eq parse("[a\\n]", 12).unwrap.to_s, "[\\na]"
}

test "parse nomatchnl 0" {
  assert_eq dump_of(".", 0), "dnl{}"
  assert_eq parse(".", 0).unwrap.to_s, "(?-s:.)"
  assert_eq dump_of("\n", 0), "lit{\n}"
  assert_eq parse("\n", 0).unwrap.to_s, "\\n"
  assert_eq dump_of("[^a]", 0), "cc{0x0-0x9 0xb-0x60 0x62-0x10ffff}"
  assert_eq parse("[^a]", 0).unwrap.to_s, "[^\\na]"
  assert_eq dump_of("[a\\n]", 0), "cc{0xa 0x61}"
  assert_eq parse("[a\\n]", 0).unwrap.to_s, "[\\na]"
}

test "invalid regexps 0" {
  assert_eq parse_error("(", PERL), "error parsing regexp: missing closing ): `(`"
  assert_eq parse_error("(", POSIX), "error parsing regexp: missing closing ): `(`"
  assert_eq parse_error(")", PERL), "error parsing regexp: unexpected ): `)`"
  assert_eq parse_error(")", POSIX), "error parsing regexp: unexpected ): `)`"
  assert_eq parse_error("(a", PERL), "error parsing regexp: missing closing ): `(a`"
  assert_eq parse_error("(a", POSIX), "error parsing regexp: missing closing ): `(a`"
  assert_eq parse_error("a)", PERL), "error parsing regexp: unexpected ): `a)`"
  assert_eq parse_error("a)", POSIX), "error parsing regexp: unexpected ): `a)`"
  assert_eq parse_error("(a))", PERL), "error parsing regexp: unexpected ): `(a))`"
  assert_eq parse_error("(a))", POSIX), "error parsing regexp: unexpected ): `(a))`"
  assert_eq parse_error("(a|b|", PERL), "error parsing regexp: missing closing ): `(a|b|`"
  assert_eq parse_error("(a|b|", POSIX), "error parsing regexp: missing closing ): `(a|b|`"
  assert_eq parse_error("a|b|)", PERL), "error parsing regexp: unexpected ): `a|b|)`"
  assert_eq parse_error("a|b|)", POSIX), "error parsing regexp: unexpected ): `a|b|)`"
  assert_eq parse_error("(a|b|))", PERL), "error parsing regexp: unexpected ): `(a|b|))`"
  assert_eq parse_error("(a|b|))", POSIX), "error parsing regexp: unexpected ): `(a|b|))`"
  assert_eq parse_error("(a|b", PERL), "error parsing regexp: missing closing ): `(a|b`"
  assert_eq parse_error("(a|b", POSIX), "error parsing regexp: missing closing ): `(a|b`"
  assert_eq parse_error("a|b)", PERL), "error parsing regexp: unexpected ): `a|b)`"
  assert_eq parse_error("a|b)", POSIX), "error parsing regexp: unexpected ): `a|b)`"
  assert_eq parse_error("(a|b))", PERL), "error parsing regexp: unexpected ): `(a|b))`"
  assert_eq parse_error("(a|b))", POSIX), "error parsing regexp: unexpected ): `(a|b))`"
  assert_eq parse_error("[a-z", PERL), "error parsing regexp: missing closing ]: `[a-z`"
  assert_eq parse_error("[a-z", POSIX), "error parsing regexp: missing closing ]: `[a-z`"
  assert_eq parse_error("([a-z)", PERL), "error parsing regexp: missing closing ]: `[a-z)`"
  assert_eq parse_error("([a-z)", POSIX), "error parsing regexp: missing closing ]: `[a-z)`"
  assert_eq parse_error("[a-z)", PERL), "error parsing regexp: missing closing ]: `[a-z)`"
  assert_eq parse_error("[a-z)", POSIX), "error parsing regexp: missing closing ]: `[a-z)`"
  assert_eq parse_error("([a-z]))", PERL), "error parsing regexp: unexpected ): `([a-z]))`"
  assert_eq parse_error("([a-z]))", POSIX), "error parsing regexp: unexpected ): `([a-z]))`"
  assert_eq parse_error("x{1001}", PERL), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("x{1001}", POSIX), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("x{9876543210}", PERL), "error parsing regexp: invalid repeat count: `{9876543210}`"
  assert_eq parse_error("x{9876543210}", POSIX), "error parsing regexp: invalid repeat count: `{9876543210}`"
  assert_eq parse_error("x{2,1}", PERL), "error parsing regexp: invalid repeat count: `{2,1}`"
  assert_eq parse_error("x{2,1}", POSIX), "error parsing regexp: invalid repeat count: `{2,1}`"
  assert_eq parse_error("x{1,9876543210}", PERL), "error parsing regexp: invalid repeat count: `{1,9876543210}`"
  assert_eq parse_error("x{1,9876543210}", POSIX), "error parsing regexp: invalid repeat count: `{1,9876543210}`"
  assert_eq parse_error(raw([255]), PERL), raw([101, 114, 114, 111, 114, 32, 112, 97, 114, 115, 105, 110, 103, 32, 114, 101, 103, 101, 120, 112, 58, 32, 105, 110, 118, 97, 108, 105, 100, 32, 85, 84, 70, 45, 56, 58, 32, 96, 255, 96])
  assert_eq parse_error(raw([255]), POSIX), raw([101, 114, 114, 111, 114, 32, 112, 97, 114, 115, 105, 110, 103, 32, 114, 101, 103, 101, 120, 112, 58, 32, 105, 110, 118, 97, 108, 105, 100, 32, 85, 84, 70, 45, 56, 58, 32, 96, 255, 96])
}

test "invalid regexps 1" {
  assert_eq parse_error(raw([91, 255, 93]), PERL), raw([101, 114, 114, 111, 114, 32, 112, 97, 114, 115, 105, 110, 103, 32, 114, 101, 103, 101, 120, 112, 58, 32, 105, 110, 118, 97, 108, 105, 100, 32, 85, 84, 70, 45, 56, 58, 32, 96, 255, 93, 96])
  assert_eq parse_error(raw([91, 255, 93]), POSIX), raw([101, 114, 114, 111, 114, 32, 112, 97, 114, 115, 105, 110, 103, 32, 114, 101, 103, 101, 120, 112, 58, 32, 105, 110, 118, 97, 108, 105, 100, 32, 85, 84, 70, 45, 56, 58, 32, 96, 255, 93, 96])
  assert_eq parse_error(raw([91, 92, 255, 93]), PERL), raw([101, 114, 114, 111, 114, 32, 112, 97, 114, 115, 105, 110, 103, 32, 114, 101, 103, 101, 120, 112, 58, 32, 105, 110, 118, 97, 108, 105, 100, 32, 85, 84, 70, 45, 56, 58, 32, 96, 255, 93, 96])
  assert_eq parse_error(raw([91, 92, 255, 93]), POSIX), raw([101, 114, 114, 111, 114, 32, 112, 97, 114, 115, 105, 110, 103, 32, 114, 101, 103, 101, 120, 112, 58, 32, 105, 110, 118, 97, 108, 105, 100, 32, 85, 84, 70, 45, 56, 58, 32, 96, 255, 93, 96])
  assert_eq parse_error(raw([92, 255]), PERL), raw([101, 114, 114, 111, 114, 32, 112, 97, 114, 115, 105, 110, 103, 32, 114, 101, 103, 101, 120, 112, 58, 32, 105, 110, 118, 97, 108, 105, 100, 32, 85, 84, 70, 45, 56, 58, 32, 96, 255, 96])
  assert_eq parse_error(raw([92, 255]), POSIX), raw([101, 114, 114, 111, 114, 32, 112, 97, 114, 115, 105, 110, 103, 32, 114, 101, 103, 101, 120, 112, 58, 32, 105, 110, 118, 97, 108, 105, 100, 32, 85, 84, 70, 45, 56, 58, 32, 96, 255, 96])
  assert_eq parse_error("(?P<name>a", PERL), "error parsing regexp: missing closing ): `(?P<name>a`"
  assert_eq parse_error("(?P<name>a", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?P<name>", PERL), "error parsing regexp: missing closing ): `(?P<name>`"
  assert_eq parse_error("(?P<name>", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?P<name", PERL), "error parsing regexp: invalid named capture: `(?P<name`"
  assert_eq parse_error("(?P<name", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?P<x y>a)", PERL), "error parsing regexp: invalid named capture: `(?P<x y>`"
  assert_eq parse_error("(?P<x y>a)", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?P<>a)", PERL), "error parsing regexp: invalid named capture: `(?P<>`"
  assert_eq parse_error("(?P<>a)", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?<name>a", PERL), "error parsing regexp: missing closing ): `(?<name>a`"
  assert_eq parse_error("(?<name>a", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?<name>", PERL), "error parsing regexp: missing closing ): `(?<name>`"
  assert_eq parse_error("(?<name>", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?<name", PERL), "error parsing regexp: invalid named capture: `(?<name`"
  assert_eq parse_error("(?<name", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?<x y>a)", PERL), "error parsing regexp: invalid named capture: `(?<x y>`"
  assert_eq parse_error("(?<x y>a)", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?<>a)", PERL), "error parsing regexp: invalid named capture: `(?<>`"
  assert_eq parse_error("(?<>a)", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("[a-Z]", PERL), "error parsing regexp: invalid character class range: `a-Z`"
  assert_eq parse_error("[a-Z]", POSIX), "error parsing regexp: invalid character class range: `a-Z`"
  assert_eq parse_error("(?i)[a-Z]", PERL), "error parsing regexp: invalid character class range: `a-Z`"
  assert_eq parse_error("(?i)[a-Z]", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("\\Q\\E*", PERL), "error parsing regexp: missing argument to repetition operator: `*`"
  assert_eq parse_error("\\Q\\E*", POSIX), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("a{100000}", PERL), "error parsing regexp: invalid repeat count: `{100000}`"
  assert_eq parse_error("a{100000}", POSIX), "error parsing regexp: invalid repeat count: `{100000}`"
  assert_eq parse_error("a{100000,}", PERL), "error parsing regexp: invalid repeat count: `{100000,}`"
  assert_eq parse_error("a{100000,}", POSIX), "error parsing regexp: invalid repeat count: `{100000,}`"
  assert_eq parse_error("((((((((((x{2}){2}){2}){2}){2}){2}){2}){2}){2}){2})", PERL), "error parsing regexp: invalid repeat count: `{2}`"
  assert_eq parse_error("((((((((((x{2}){2}){2}){2}){2}){2}){2}){2}){2}){2})", POSIX), "error parsing regexp: invalid repeat count: `{2}`"
}

test "only perl 0" {
  assert_eq parse_error("[a-b-c]", PERL), ""
  assert_eq parse_error("[a-b-c]", POSIX), "error parsing regexp: invalid character class range: `-c`"
  assert_eq parse_error("\\Qabc\\E", PERL), ""
  assert_eq parse_error("\\Qabc\\E", POSIX), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("\\Q*+?{[\\E", PERL), ""
  assert_eq parse_error("\\Q*+?{[\\E", POSIX), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("\\Q\\\\E", PERL), ""
  assert_eq parse_error("\\Q\\\\E", POSIX), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("\\Q\\\\\\E", PERL), ""
  assert_eq parse_error("\\Q\\\\\\E", POSIX), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("\\Q\\\\\\\\E", PERL), ""
  assert_eq parse_error("\\Q\\\\\\\\E", POSIX), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("\\Q\\\\\\\\\\E", PERL), ""
  assert_eq parse_error("\\Q\\\\\\\\\\E", POSIX), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("(?:a)", PERL), ""
  assert_eq parse_error("(?:a)", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?P<name>a)", PERL), ""
  assert_eq parse_error("(?P<name>a)", POSIX), "error parsing regexp: missing argument to repetition operator: `?`"
}

test "only posix 0" {
  assert_eq parse_error("a++", PERL), "error parsing regexp: invalid nested repetition operator: `++`"
  assert_eq parse_error("a++", POSIX), ""
  assert_eq parse_error("a**", PERL), "error parsing regexp: invalid nested repetition operator: `**`"
  assert_eq parse_error("a**", POSIX), ""
  assert_eq parse_error("a?*", PERL), "error parsing regexp: invalid nested repetition operator: `?*`"
  assert_eq parse_error("a?*", POSIX), ""
  assert_eq parse_error("a+*", PERL), "error parsing regexp: invalid nested repetition operator: `+*`"
  assert_eq parse_error("a+*", POSIX), ""
  assert_eq parse_error("a{1}*", PERL), "error parsing regexp: invalid nested repetition operator: `{1}*`"
  assert_eq parse_error("a{1}*", POSIX), ""
  assert_eq parse_error(".{1}{2}.{3}", PERL), "error parsing regexp: invalid nested repetition operator: `{1}{2}`"
  assert_eq parse_error(".{1}{2}.{3}", POSIX), ""
}

test "string 0" {
  assert_eq parse("x(?i:ab*c|d?e)1", PERL).unwrap.to_s, "x(?i:AB*C|D?E)1"
  assert_eq parse("x(?i:ab*cd?e)1", PERL).unwrap.to_s, "x(?i:AB*CD?E)1"
  assert_eq parse("0(?i:ab*c|d?e)1", PERL).unwrap.to_s, "(?i:0(?:AB*C|D?E)1)"
  assert_eq parse("0(?i:ab*cd?e)1", PERL).unwrap.to_s, "(?i:0AB*CD?E1)"
  assert_eq parse("x(?i:ab*c|d?e)", PERL).unwrap.to_s, "x(?i:AB*C|D?E)"
  assert_eq parse("x(?i:ab*cd?e)", PERL).unwrap.to_s, "x(?i:AB*CD?E)"
  assert_eq parse("0(?i:ab*c|d?e)", PERL).unwrap.to_s, "(?i:0(?:AB*C|D?E))"
  assert_eq parse("0(?i:ab*cd?e)", PERL).unwrap.to_s, "(?i:0AB*CD?E)"
  assert_eq parse("(?i:ab*c|d?e)1", PERL).unwrap.to_s, "(?i:(?:AB*C|D?E)1)"
  assert_eq parse("(?i:ab*cd?e)1", PERL).unwrap.to_s, "(?i:AB*CD?E1)"
  assert_eq parse("(?i:ab)[123](?i:cd)", PERL).unwrap.to_s, "(?i:AB[1-3]CD)"
  assert_eq parse("(?i:ab*c|d?e)", PERL).unwrap.to_s, "(?i:AB*C|D?E)"
  assert_eq parse("[Aa][Bb]", PERL).unwrap.to_s, "(?i:AB)"
  assert_eq parse("[Aa][Bb]*[Cc]", PERL).unwrap.to_s, "(?i:AB*C)"
  assert_eq parse("A(?:[Bb][Cc]|[Dd])[Zz]", PERL).unwrap.to_s, "A(?i:(?:BC|D)Z)"
  assert_eq parse("[Aa](?:[Bb][Cc]|[Dd])Z", PERL).unwrap.to_s, "(?i:A(?:BC|D))Z"
}
