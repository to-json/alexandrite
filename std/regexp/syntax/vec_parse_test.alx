  assert_eq dump_of("x{1001", 204), "str{x{1001}"
  assert_eq parse("x{1001", 204).unwrap.to_s, "x\\{1001"
  check_string_equivalent("x{1001")
  assert_eq dump_of("x{9876543210", 204), "str{x{9876543210}"
  assert_eq parse("x{9876543210", 204).unwrap.to_s, "x\\{9876543210"
  check_string_equivalent("x{9876543210")
  assert_eq dump_of("x{9876543210,", 204), "str{x{9876543210,}"
  assert_eq parse("x{9876543210,", 204).unwrap.to_s, "x\\{9876543210,"
  check_string_equivalent("x{9876543210,")
}

