# results for them) by a generator; do not edit by hand.

test "parse simple 0" {
  assert_eq dump_of("a", 204), "lit{a}"
  assert_eq parse("a", 204).unwrap.to_s, "a"
  check_string_equivalent("a")
  assert_eq dump_of("a.", 204), "cat{lit{a}dot{}}"
  assert_eq parse("a.", 204).unwrap.to_s, "(?s:a.)"
  check_string_equivalent("a.")
  assert_eq dump_of("a.b", 204), "cat{lit{a}dot{}lit{b}}"
  assert_eq parse("a.b", 204).unwrap.to_s, "(?s:a.b)"
  check_string_equivalent("a.b")
  assert_eq dump_of("ab", 204), "str{ab}"
  assert_eq parse("ab", 204).unwrap.to_s, "ab"
  check_string_equivalent("ab")
  assert_eq dump_of("a.b.c", 204), "cat{lit{a}dot{}lit{b}dot{}lit{c}}"
  assert_eq parse("a.b.c", 204).unwrap.to_s, "(?s:a.b.c)"
  check_string_equivalent("a.b.c")
  assert_eq dump_of("abc", 204), "str{abc}"
  assert_eq parse("abc", 204).unwrap.to_s, "abc"
  check_string_equivalent("abc")
  assert_eq dump_of("a|^", 204), "alt{lit{a}bol{}}"
  assert_eq parse("a|^", 204).unwrap.to_s, "(?m:a|^)"
  check_string_equivalent("a|^")
  assert_eq dump_of("a|b", 204), "cc{0x61-0x62}"
  assert_eq parse("a|b", 204).unwrap.to_s, "[ab]"
  check_string_equivalent("a|b")
  assert_eq dump_of("(a)", 204), "cap{lit{a}}"
}

test "parse simple 1" {
  assert_eq parse("(a)", 204).unwrap.to_s, "(a)"
  check_string_equivalent("(a)")
  assert_eq dump_of("(a)|b", 204), "alt{cap{lit{a}}lit{b}}"
