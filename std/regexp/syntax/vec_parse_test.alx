  assert_eq parse("a*", 204).unwrap.to_s, "a*"
  check_string_equivalent("a*")
  assert_eq dump_of("a+", 204), "plus{lit{a}}"
  assert_eq parse("a+", 204).unwrap.to_s, "a+"
  check_string_equivalent("a+")
  assert_eq dump_of("a?", 204), "que{lit{a}}"
  assert_eq parse("a?", 204).unwrap.to_s, "a?"
  check_string_equivalent("a?")
  assert_eq dump_of("a{2}", 204), "rep{2,2 lit{a}}"
