  check_all("\\[a-c][α-ω]", 213, "cat{strfold{[A-C]}cc{0xb5 0x345 0x391-0x3a1 0x3a3-0x3a9 0x3b1-0x3c9 0x3d0-0x3d1 0x3d5-0x3d6 0x3f0-0x3f1 0x3f4-0x3f5 0x1fbe 0x2126}}", "(?i:\\[A-C\\][µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ])", "(?i:\\[A-C\\][µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ])", "  0\tfail\n  1*\trune1 \"[\" -> 2\n  2\trune \"A\"/i -> 3\n  3\trune1 \"-\" -> 4\n  4\trune \"C\"/i -> 5\n  5\trune1 \"]\" -> 6\n  6\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0391\\u03a1\\u03a3\\u03a9\\u03b1\\u03c9\\u03d0\\u03d1\\u03d5\\u03d6\\u03f0\\u03f1\\u03f4\\u03f5\\u1fbe\\u1fbe\\u2126\\u2126\" -> 7\n  7\tmatch\n")
