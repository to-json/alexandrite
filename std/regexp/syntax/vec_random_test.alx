  check_all("^(?-s:.)", 204, "cat{bol{}dnl{}}", "(?m-s:^.)", "(?m-s:^.)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\tanynotnl -> 3\n  3\tmatch\n")
  check_all("\\sé]\\wx*", 204, "cat{cc{0x9-0xa 0xc-0xd 0x20}str{é]}cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}star{lit{x}}}", "[\\t\\n\\f\\r ]é\\][0-9A-Z_a-z]x*", "[\\t\\n\\f\\r ]é\\][0-9A-Z_a-z]x*", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\trune1 \"\\u00e9\" -> 3\n  3\trune1 \"]\" -> 4\n  4\trune \"09AZ__az\" -> 6\n  5\trune1 \"x\" -> 6\n  6\talt -> 5, 7\n  7\tmatch\n")
  assert_eq parse_error("[a-c][^b]\\b[α-ω]", 0), "error parsing regexp: invalid escape sequence: `\\b`"
  check_all("ſ", 196, "lit{ſ}", "ſ", "ſ", "  0\tfail\n  1*\trune1 \"\\u017f\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("(?:ab|ac)|(a|b)[\\p{Lu}0-9]a", 0), "error parsing regexp: missing argument to repetition operator: `?`"
}

test "random parse 48" {
  check_all("ab\\w", 212, "cat{str{ab}cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}}", "ab[0-9A-Z_a-z]", "ab[0-9A-Z_a-z]", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"b\" -> 3\n  3\trune \"09AZ__az\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("\\s", 0), "error parsing regexp: invalid escape sequence: `\\s`"
