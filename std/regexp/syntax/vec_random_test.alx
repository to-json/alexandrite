  check_all("c{2,}", 0, "rep{2,-1 lit{c}}", "c{2,}", "cc+", "  0\tfail\n  1*\trune1 \"c\" -> 2\n  2\trune1 \"c\" -> 3\n  3\talt -> 2, 4\n  4\tmatch\n")
