\uaa5a\\uabef\\uabfa\\uff0f\\uff1a\\U00010106\\U00010134\\U0001013f\\U00010179\\U00010189\\U0001018c\\U000102e0\\U000102fc\\U0001031f\\U00010324\\U00010340\\U00010342\\U00010349\\U0001034b\\U000103d0\\U000103d6\\U0001049f\\U000104aa\\U00010857\\U00010860\\U00010878\\U00010880\\U000108a6\\U000108b0\\U000108fa\\U00010900\\U00010915\\U0001091c\\U000109bb\\U000109be\\U000109bf\\U000109d0\\U000109d1\\U00010a00\\U00010a3f\\U00010a49\\U00010a7c\\U00010a7f\\U00010a9c\\U00010aa0\\U00010aea\\U00010af0\\U00010b57\\U00010b60\\U00010b77\\U00010b80\\U00010ba8\\U00010bb0\\U00010cf9\\U00010d00\\U00010d2f\\U00010d3a\\U00010d3f\\U00010d4a\\U00010e5f\\U00010e7f\\U00010f1c\\U00010f27\\U00010f50\\U00010f55\\U00010fc4\\U00010fcc\\U00011051\\U00011070\\U000110ef\\U000110fa\\U00011135\\U00011140\\U000111cf\\U000111da\\U000111e0\\U000111f5\\U000112ef\\U000112fa\\U0001144f\\U0001145a\\U000114cf\\U000114da\\U0001164f\\U0001165a\\U000116bf\\U000116ca\\U000116cf\\U000116e4\\U0001172f\\U0001173c\\U000118df\\U000118f3\\U0001194f\\U0001195a\\U00011bef\\U00011bfa\\U00011c4f\\U00011c6d\\U00011d4f\\U00011d5a\\U00011d9f\\U00011daa\\U00011ddf\\U00011dea\\U00011f4f\\U00011f5a\\U00011fbf\\U00011fd5\\U000123ff\\U0001246f\\U0001612f\\U0001613a\\U00016a5f\\U00016a6a\\U00016abf\\U00016aca\\U00016b4f\\U00016b5a\\U00016b5a\\U00016b62\\U00016d6f\\U00016d7a\\U00016e7f\\U00016e97\\U00016ff3\\U00016ff7\\U0001ccef\\U0001ccfa\\U0001d2bf\\U0001d2d4\\U0001d2df\\U0001d2f4\\U0001d35f\\U0001d379\\U0001d7cd\\U0001d800\\U0001e13f\\U0001e14a\\U0001e2ef\\U0001e2fa\\U0001e4ef\\U0001e4fa\\U0001e5f0\\U0001e5fb\\U0001e8c6\\U0001e8d0\\U0001e94f\\U0001e95a\\U0001ec70\\U0001ecac\\U0001ecac\\U0001ecb0\\U0001ecb0\\U0001ecb5\\U0001ed00\\U0001ed2e\\U0001ed2e\\U0001ed3e\\U0001f0ff\\U0001f10d\\U0001fbef\\U0001fbfa\\U0010ffff\" -> 3\n  3\trune1 \".\" -> 4\n  4\trune1 \"*\" -> 5\n  5\tmatch\n")
