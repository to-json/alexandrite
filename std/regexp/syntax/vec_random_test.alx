  check_all("(?s:.)\\p{Greek}(?-s:.)\\b", 212, "cat{dot{}cc{0x370-0x373 0x375-0x377 0x37a-0x37d 0x37f 0x384 0x386 0x388-0x38a 0x38c 0x38e-0x3a1 0x3a3-0x3e1 0x3f0-0x3ff 0x1d26-0x1d2a 0x1d5d-0x1d61 0x1d66-0x1d6a 0x1dbf 0x1f00-0x1f15 0x1f18-0x1f1d 0x1f20-0x1f45 0x1f48-0x1f4d 0x1f50-0x1f57 0x1f59 0x1f5b 0x1f5d 0x1f5f-0x1f7d 0x1f80-0x1fb4 0x1fb6-0x1fc4 0x1fc6-0x1fd3 0x1fd6-0x1fdb 0x1fdd-0x1fef 0x1ff2-0x1ff4 0x1ff6-0x1ffe 0x2126 0xab65 0x10140-0x1018e 0x101a0 0x1d200-0x1d245}dnl{}wb{}}", "(?-s:(?s:.)[Ͱ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅].\\b)", "(?-s:(?s:.)[Ͱ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅].\\b)", "  0\tfail\n  1*\tany -> 2\n  2\trune \"\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 3\n  3\tanynotnl -> 4\n  4\tempty 16 -> 5\n  5\tmatch\n")
  assert_eq parse_error("\\w(?s:.)\\p{Greek}", 0), "error parsing regexp: invalid escape sequence: `\\w`"
  check_all("[α-ω]", 213, "cc{0xb5 0x345 0x391-0x3a1 0x3a3-0x3a9 0x3b1-0x3c9 0x3d0-0x3d1 0x3d5-0x3d6 0x3f0-0x3f1 0x3f4-0x3f5 0x1fbe 0x2126}", "[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ]", "[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ]", "  0\tfail\n  1*\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0391\\u03a1\\u03a3\\u03a9\\u03b1\\u03c9\\u03d0\\u03d1\\u03d5\\u03d6\\u03f0\\u03f1\\u03f4\\u03f5\\u1fbe\\u1fbe\\u2126\\u2126\" -> 2\n  2\tmatch\n")
}

test "random parse 38" {
  check_all("^{,", 196, "cat{bol{}str{{,}}", "(?m:^\\{,)", "(?m:^\\{,)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune1 \"{\" -> 3\n  3\trune1 \",\" -> 4\n  4\tmatch\n")
  check_all("\\b\\wc{2,}{,(?U)a+", 196, "cat{wb{}cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}rep{2,-1 lit{c}}str{{,}nplus{lit{a}}}", "\\b[0-9A-Z_a-z]c{2,}\\{,a+?", "\\b[0-9A-Z_a-z]cc+\\{,a+?", "  0\tfail\n  1*\tempty 16 -> 2\n  2\trune \"09AZ__az\" -> 3\n  3\trune1 \"c\" -> 4\n  4\trune1 \"c\" -> 5\n  5\talt -> 4, 6\n  6\trune1 \"{\" -> 7\n  7\trune1 \",\" -> 8\n  8\trune1 \"a\" -> 9\n  9\talt -> 10, 8\n 10\tmatch\n")
  assert_eq parse_error("(", 204), "error parsing regexp: missing closing ): `(`"
  assert_eq parse_error("\\B[a-z&&](\\z", 204), "error parsing regexp: missing closing ): `\\B[a-z&&](\\z`"
  assert_eq parse_error("x*)ab\\zx*", 0), "error parsing regexp: unexpected ): `x*)ab\\zx*`"
  check_all("(?U)a+", 212, "nplus{lit{a}}", "a+?", "a+?", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\talt -> 3, 1\n  3\tmatch\n")
  check_all("ab", 213, "strfold{AB}", "(?i:AB)", "(?i:AB)", "  0\tfail\n  1*\trune \"A\"/i -> 2\n  2\trune \"B\"/i -> 3\n  3\tmatch\n")
  assert_eq parse_error("x{1001}[$[^\\x00-\\x{10FFFF}]", 0), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("\\z[a-z&&]ſ", 0), "error parsing regexp: invalid escape sequence: `\\z`"
  check_all("\\p{Greek}(?P<n>z)\\sb{1,3}", 213, "cat{cc{0xb5 0x345 0x370-0x373 0x375-0x377 0x37a-0x37d 0x37f 0x384 0x386 0x388-0x38a 0x38c 0x38e-0x3a1 0x3a3-0x3e1 0x3f0-0x3ff 0x1d26-0x1d2a 0x1d5d-0x1d61 0x1d66-0x1d6a 0x1dbf 0x1f00-0x1f15 0x1f18-0x1f1d 0x1f20-0x1f45 0x1f48-0x1f4d 0x1f50-0x1f57 0x1f59 0x1f5b 0x1f5d 0x1f5f-0x1f7d 0x1f80-0x1fb4 0x1fb6-0x1fc4 0x1fc6-0x1fd3 0x1fd6-0x1fdb 0x1fdd-0x1fef 0x1ff2-0x1ff4 0x1ff6-0x1ffe 0x2126 0xab65 0x10140-0x1018e 0x101a0 0x1d200-0x1d245}cap{n:litfold{Z}}cc{0x9-0xa 0xc-0xd 0x20}rep{1,3 litfold{B}}}", "(?i:[µͅͰ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅](?P<n>Z)[\\t\\n\\f\\r ]B{1,3})", "(?i:[µͅͰ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅](?P<n>Z)[\\t\\n\\f\\r ]B(?:BB?)?)", "  0\tfail\n  1*\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 2\n  2\tcap 2 -> 3\n  3\trune \"Z\"/i -> 4\n  4\tcap 3 -> 5\n  5\trune \"\\t\\n\\f\\r  \" -> 6\n  6\trune \"B\"/i -> 10\n  7\trune \"B\"/i -> 9\n  8\trune \"B\"/i -> 11\n  9\talt -> 8, 11\n 10\talt -> 7, 11\n 11\tmatch\n")
  assert_eq parse_error("(?i)k\\Q.*\\E(?i:Σ)(?-s:.)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("abéé[α-ω]", 212, "cat{str{abéé}cc{0x3b1-0x3c9}}", "abéé[α-ω]", "abéé[α-ω]", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"b\" -> 3\n  3\trune1 \"\\u00e9\" -> 4\n  4\trune1 \"\\u00e9\" -> 5\n  5\trune \"\\u03b1\\u03c9\" -> 6\n  6\tmatch\n")
  assert_eq parse_error("**\\A", 0), "error parsing regexp: missing argument to repetition operator: `*`"
  check_all("b{1,3}.", 212, "cat{rep{1,3 lit{b}}dnl{}}", "(?-s:b{1,3}.)", "(?-s:b(?:bb?)?.)", "  0\tfail\n  1*\trune1 \"b\" -> 5\n  2\trune1 \"b\" -> 4\n  3\trune1 \"b\" -> 6\n  4\talt -> 3, 6\n  5\talt -> 2, 6\n  6\tanynotnl -> 7\n  7\tmatch\n")
  check_all("](?m:^x$)[α-ω]", 204, "cat{lit{]}bol{}lit{x}eol{}cc{0x3b1-0x3c9}}", "(?m:\\]^x$[α-ω])", "(?m:\\]^x$[α-ω])", "  0\tfail\n  1*\trune1 \"]\" -> 2\n  2\tempty 1 -> 3\n  3\trune1 \"x\" -> 4\n  4\tempty 2 -> 5\n  5\trune \"\\u03b1\\u03c9\" -> 6\n  6\tmatch\n")
  check_all("x*\\\\x{2a}\\a", 213, "cat{star{litfold{X}}strfold{\\X{2A}\x07}}", "(?i:X*\\\\X\\{2A\\}\\a)", "(?i:X*\\\\X\\{2A\\}\\a)", "  0\tfail\n  1\trune \"X\"/i -> 2\n  2*\talt -> 1, 3\n  3\trune1 \"\\\\\" -> 4\n  4\trune \"X\"/i -> 5\n  5\trune1 \"{\" -> 6\n  6\trune1 \"2\" -> 7\n  7\trune \"A\"/i -> 8\n  8\trune1 \"}\" -> 9\n  9\trune1 \"\\a\" -> 10\n 10\tmatch\n")
