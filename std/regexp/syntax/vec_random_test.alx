  check_all("ſ\\sé(?i)kb{1,3}", 212, "cat{lit{ſ}cc{0x9-0xa 0xc-0xd 0x20}lit{é}litfold{K}rep{1,3 litfold{B}}}", "ſ[\\t\\n\\f\\r ]é(?i:KB{1,3})", "ſ[\\t\\n\\f\\r ]é(?i:KB(?:BB?)?)", "  0\tfail\n  1*\trune1 \"\\u017f\" -> 2\n  2\trune \"\\t\\n\\f\\r  \" -> 3\n  3\trune1 \"\\u00e9\" -> 4\n  4\trune \"K\"/i -> 5\n  5\trune \"B\"/i -> 9\n  6\trune \"B\"/i -> 8\n  7\trune \"B\"/i -> 10\n  8\talt -> 7, 10\n  9\talt -> 6, 10\n 10\tmatch\n")
