  check_all("\\x{2a}]\\w", 196, "cat{str{*]}cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}}", "\\*\\][0-9A-Z_a-z]", "\\*\\][0-9A-Z_a-z]", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\trune1 \"]\" -> 3\n  3\trune \"09AZ__az\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("x{1001}K", 196), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("(?U)a+[", 213), "error parsing regexp: missing closing ]: `[`"
  assert_eq parse_error("{,[\\p{Lu}0-9](?m:^x$)[a-z&&]", 0), "error parsing regexp: invalid escape sequence: `\\p`"
  assert_eq parse_error("\\p{Greek}", 0), "error parsing regexp: invalid escape sequence: `\\p`"
