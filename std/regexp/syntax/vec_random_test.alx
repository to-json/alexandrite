test "random parse 47" {
  assert_eq parse_error("\\*(?U)a+", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?<", 196), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
  check_all("b{1,3}K[a-z&&]", 0, "cat{rep{1,3 lit{b}}lit{K}cc{0x26 0x61-0x7a}}", "b{1,3}K[&a-z]", "b(?:bb?)?K[&a-z]", "  0\tfail\n  1*\trune1 \"b\" -> 5\n  2\trune1 \"b\" -> 4\n  3\trune1 \"b\" -> 6\n  4\talt -> 3, 6\n  5\talt -> 2, 6\n  6\trune1 \"K\" -> 7\n  7\trune \"&&az\" -> 8\n  8\tmatch\n")
  check_all("{,(a|b)c{2,}(?i)k\\B", 213, "cat{str{{,}cap{cc{0x41-0x42 0x61-0x62}}rep{2,-1 litfold{C}}litfold{K}nwb{}}", "(?i:\\{,([ABab])C{2,}K\\B)", "(?i:\\{,([ABab])CC+K\\B)", "  0\tfail\n  1*\trune1 \"{\" -> 2\n  2\trune1 \",\" -> 3\n  3\tcap 2 -> 4\n  4\trune \"ABab\" -> 5\n  5\tcap 3 -> 6\n  6\trune \"C\"/i -> 7\n  7\trune \"C\"/i -> 8\n  8\talt -> 7, 9\n  9\trune \"K\"/i -> 10\n 10\tempty 32 -> 11\n 11\tmatch\n")
  check_all("日本", 212, "str{日本}", "日本", "日本", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("{,a(?i)k(?m:^x$)$", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("(?s:.)\\B", 212, "cat{dot{}nwb{}}", "(?s:.\\B)", "(?s:.\\B)", "  0\tfail\n  1*\tany -> 2\n  2\tempty 32 -> 3\n  3\tmatch\n")
  assert_eq parse_error("(?i:Σ)*", 0), "error parsing regexp: missing argument to repetition operator: `?`"
