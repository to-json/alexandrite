  check_all("(a|b)c{2,}\\B*", 196, "cat{cap{cc{0x61-0x62}}rep{2,-1 lit{c}}star{nwb{}}}", "([ab])c{2,}\\B*", "([ab])cc+\\B*", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune \"ab\" -> 3\n  3\tcap 3 -> 4\n  4\trune1 \"c\" -> 5\n  5\trune1 \"c\" -> 6\n  6\talt -> 5, 9\n  7\tempty 32 -> 8\n  8\talt -> 7, 10\n  9\talt -> 7, 10\n 10\tmatch\n")
  check_all("\\w(?i)k\\dab", 204, "cat{cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}litfold{K}cc{0x30-0x39}strfold{AB}}", "[0-9A-Z_a-z](?i:K[0-9]AB)", "[0-9A-Z_a-z](?i:K[0-9]AB)", "  0\tfail\n  1*\trune \"09AZ__az\" -> 2\n  2\trune \"K\"/i -> 3\n  3\trune \"09\" -> 4\n  4\trune \"A\"/i -> 5\n  5\trune \"B\"/i -> 6\n  6\tmatch\n")
  check_all("(?U)a+a{2}b", 204, "cat{nplus{lit{a}}nrep{2,2 lit{a}}lit{b}}", "a+?a{2}?b", "a+?aab", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\talt -> 3, 1\n  3\trune1 \"a\" -> 4\n  4\trune1 \"a\" -> 5\n  5\trune1 \"b\" -> 6\n  6\tmatch\n")
  assert_eq parse_error("c{2,})", 204), "error parsing regexp: unexpected ): `c{2,})`"
  assert_eq parse_error("\\8)", 212), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("日本", 204, "str{日本}", "日本", "日本", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\tmatch\n")
}

test "random parse 36" {
  check_all("é(?s:.)(?:ab|ac)éé", 212, "cat{lit{é}dot{}lit{a}cc{0x62-0x63}str{éé}}", "(?s:é.a[bc]éé)", "(?s:é.a[bc]éé)", "  0\tfail\n  1*\trune1 \"\\u00e9\" -> 2\n  2\tany -> 3\n  3\trune1 \"a\" -> 4\n  4\trune \"bc\" -> 5\n  5\trune1 \"\\u00e9\" -> 6\n  6\trune1 \"\\u00e9\" -> 7\n  7\tmatch\n")
  check_all("^", 212, "bot{}", "\\A", "\\A", "  0\tfail\n  1*\tempty 4 -> 2\n  2\tmatch\n")
  assert_eq parse_error("[ſab", 213), "error parsing regexp: missing closing ]: `[ſab`"
  check_all("\\b", 212, "wb{}", "\\b", "\\b", "  0\tfail\n  1*\tempty 16 -> 2\n  2\tmatch\n")
  assert_eq parse_error("(a|b)\\Q.*\\E", 0), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("+?\\b(?i)k\\8", 204), "error parsing regexp: missing argument to repetition operator: `+?`"
  check_all(".\\b", 213, "cat{dnl{}wb{}}", "(?-s:.\\b)", "(?-s:.\\b)", "  0\tfail\n  1*\tanynotnl -> 2\n  2\tempty 16 -> 3\n  3\tmatch\n")
  check_all("b[a-z&&]", 0, "cat{lit{b}cc{0x26 0x61-0x7a}}", "b[&a-z]", "b[&a-z]", "  0\tfail\n  1*\trune1 \"b\" -> 2\n  2\trune \"&&az\" -> 3\n  3\tmatch\n")
