\U00016aed\\U00016b00\\U00016b2f\\U00016b40\\U00016b43\\U00016b63\\U00016b77\\U00016b7d\\U00016b8f\\U00016d40\\U00016d6c\\U00016e40\\U00016e7f\\U00016ea0\\U00016eb8\\U00016ebb\\U00016ed3\\U00016f00\\U00016f4a\\U00016f50\\U00016f50\\U00016f93\\U00016f9f\\U00016fe0\\U00016fe1\\U00016fe3\\U00016fe3\\U00016ff2\\U00016ff3\\U00017000\\U00018cd5\\U00018cff\\U00018d1e\\U00018d80\\U00018df2\\U0001aff0\\U0001aff3\\U0001aff5\\U0001affb\\U0001affd\\U0001affe\\U0001b000\\U0001b122\\U0001b132\\U0001b132\\U0001b150\\U0001b152\\U0001b155\\U0001b155\\U0001b164\\U0001b167\\U0001b170\\U0001b2fb\\U0001bc00\\U0001bc6a\\U0001bc70\\U0001bc7c\\U0001bc80\\U0001bc88\\U0001bc90\\U0001bc99\\U0001d400\\U0001d454\\U0001d456\\U0001d49c\\U0001d49e\\U0001d49f\\U0001d4a2\\U0001d4a2\\U0001d4a5\\U0001d4a6\\U0001d4a9\\U0001d4ac\\U0001d4ae\\U0001d4b9\\U0001d4bb\\U0001d4bb\\U0001d4bd\\U0001d4c3\\U0001d4c5\\U0001d505\\U0001d507\\U0001d50a\\U0001d50d\\U0001d514\\U0001d516\\U0001d51c\\U0001d51e\\U0001d539\\U0001d53b\\U0001d53e\\U0001d540\\U0001d544\\U0001d546\\U0001d546\\U0001d54a\\U0001d550\\U0001d552\\U0001d6a5\\U0001d6a8\\U0001d6c0\\U0001d6c2\\U0001d6da\\U0001d6dc\\U0001d6fa\\U0001d6fc\\U0001d714\\U0001d716\\U0001d734\\U0001d736\\U0001d74e\\U0001d750\\U0001d76e\\U0001d770\\U0001d788\\U0001d78a\\U0001d7a8\\U0001d7aa\\U0001d7c2\\U0001d7c4\\U0001d7cb\\U0001df00\\U0001df1e\\U0001df25\\U0001df2a\\U0001e030\\U0001e06d\\U0001e100\\U0001e12c\\U0001e137\\U0001e13d\\U0001e14e\\U0001e14e\\U0001e290\\U0001e2ad\\U0001e2c0\\U0001e2eb\\U0001e4d0\\U0001e4eb\\U0001e5d0\\U0001e5ed\\U0001e5f0\\U0001e5f0\\U0001e6c0\\U0001e6de\\U0001e6e0\\U0001e6e2\\U0001e6e4\\U0001e6e5\\U0001e6e7\\U0001e6ed\\U0001e6f0\\U0001e6f4\\U0001e6fe\\U0001e6ff\\U0001e7e0\\U0001e7e6\\U0001e7e8\\U0001e7eb\\U0001e7ed\\U0001e7ee\\U0001e7f0\\U0001e7fe\\U0001e800\\U0001e8c4\\U0001e900\\U0001e943\\U0001e94b\\U0001e94b\\U0001ee00\\U0001ee03\\U0001ee05\\U0001ee1f\\U0001ee21\\U0001ee22\\U0001ee24\\U0001ee24\\U0001ee27\\U0001ee27\\U0001ee29\\U0001ee32\\U0001ee34\\U0001ee37\\U0001ee39\\U0001ee39\\U0001ee3b\\U0001ee3b\\U0001ee42\\U0001ee42\\U0001ee47\\U0001ee47\\U0001ee49\\U0001ee49\\U0001ee4b\\U0001ee4b\\U0001ee4d\\U0001ee4f\\U0001ee51\\U0001ee52\\U0001ee54\\U0001ee54\\U0001ee57\\U0001ee57\\U0001ee59\\U0001ee59\\U0001ee5b\\U0001ee5b\\U0001ee5d\\U0001ee5d\\U0001ee5f\\U0001ee5f\\U0001ee61\\U0001ee62\\U0001ee64\\U0001ee64\\U0001ee67\\U0001ee6a\\U0001ee6c\\U0001ee72\\U0001ee74\\U0001ee77\\U0001ee79\\U0001ee7c\\U0001ee7e\\U0001ee7e\\U0001ee80\\U0001ee89\\U0001ee8b\\U0001ee9b\\U0001eea1\\U0001eea3\\U0001eea5\\U0001eea9\\U0001eeab\\U0001eebb\\U00020000\\U0002a6df\\U0002a700\\U0002b81d\\U0002b820\\U0002cead\\U0002ceb0\\U0002ebe0\\U0002ebf0\\U0002ee5d\\U0002f800\\U0002fa1d\\U00030000\\U0003134a\\U00031350\\U00033479\" -> 5\n  3\trune \"\\t\\n\\f\\r  \" -> 5\n  4*\talt -> 1, 3\n  5\tmatch\n")
  assert_eq parse_error("+?[[:alpha:]](?U)a+c{2,}", 196), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error("\\8[α-ω]\\\\x{2a}", 196), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("|(a|b)b", 204, "alt{emp{}cat{cap{cc{0x61-0x62}}lit{b}}}", "(?:)|([ab])b", "(?:)|([ab])b", "  0\tfail\n  1\tnop -> 7\n  2\tcap 2 -> 3\n  3\trune \"ab\" -> 4\n  4\tcap 3 -> 5\n  5\trune1 \"b\" -> 7\n  6*\talt -> 1, 2\n  7\tmatch\n")
  check_all("(?U)a+[[:alpha:]](?U)a+", 213, "cat{nplus{litfold{A}}cc{0x41-0x5a 0x61-0x7a 0x17f 0x212a}nplus{litfold{A}}}", "(?i:A+?[A-Za-zſK]A+?)", "(?i:A+?[A-Za-zſK]A+?)", "  0\tfail\n  1*\trune \"A\"/i -> 2\n  2\talt -> 3, 1\n  3\trune \"AZaz\\u017f\\u017f\\u212a\\u212a\" -> 4\n  4\trune \"A\"/i -> 5\n  5\talt -> 6, 4\n  6\tmatch\n")
  assert_eq parse_error("\\B(?s:.)(?:ab|ac)*\\8", 213), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("+?(?U)a+c{2,}[[:alpha:]]日本", 204), "error parsing regexp: missing argument to repetition operator: `+?`"
  check_all("..", 196, "cat{dnl{}dnl{}}", "(?-s:..)", "(?-s:..)", "  0\tfail\n  1*\tanynotnl -> 2\n  2\tanynotnl -> 3\n  3\tmatch\n")
  assert_eq parse_error("(?<{,(a|b)a{2}", 204), "error parsing regexp: invalid named capture: `(?<{,(a|b)a{2}`"
  check_all("ſ日本b{1,3}", 196, "cat{str{ſ日本}rep{1,3 lit{b}}}", "ſ日本b{1,3}", "ſ日本b(?:bb?)?", "  0\tfail\n  1*\trune1 \"\\u017f\" -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 4\n  4\trune1 \"b\" -> 8\n  5\trune1 \"b\" -> 7\n  6\trune1 \"b\" -> 9\n  7\talt -> 6, 9\n  8\talt -> 5, 9\n  9\tmatch\n")
  assert_eq parse_error("(?<", 212), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
  check_all("\\za{2}", 196, "cat{eot{\\z}rep{2,2 lit{a}}}", "\\za{2}", "\\zaa", "  0\tfail\n  1*\tempty 8 -> 2\n  2\trune1 \"a\" -> 3\n  3\trune1 \"a\" -> 4\n  4\tmatch\n")
  check_all("[α-ω]\\\\x{2a}\\z", 204, "cat{cc{0x3b1-0x3c9}str{\\x{2a}}eot{\\z}}", "[α-ω]\\\\x\\{2a\\}\\z", "[α-ω]\\\\x\\{2a\\}\\z", "  0\tfail\n  1*\trune \"\\u03b1\\u03c9\" -> 2\n  2\trune1 \"\\\\\" -> 3\n  3\trune1 \"x\" -> 4\n  4\trune1 \"{\" -> 5\n  5\trune1 \"2\" -> 6\n  6\trune1 \"a\" -> 7\n  7\trune1 \"}\" -> 8\n  8\tempty 8 -> 9\n  9\tmatch\n")
  assert_eq parse_error("\\", 196), "error parsing regexp: trailing backslash at end of expression: ``"
  check_all("a日本|(?i)k", 196, "alt{str{a日本}litfold{K}}", "a日本|(?i:K)", "a日本|(?i:K)", "  0\tfail\n  1\trune1 \"a\" -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 6\n  4\trune \"K\"/i -> 6\n  5*\talt -> 1, 4\n  6\tmatch\n")
  assert_eq parse_error("(?<((?<*\\s", 0), "error parsing regexp: missing argument to repetition operator: `?`"
}

