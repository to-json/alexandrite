\uaa5a\\uabef\\uabfa\\uff0f\\uff1a\\U00010106\\U00010134\\U0001013f\\U00010179\\U00010189\\U0001018c\\U000102e0\\U000102fc\\U0001031f\\U00010324\\U00010340\\U00010342\\U00010349\\U0001034b\\U000103d0\\U000103d6\\U0001049f\\U000104aa\\U00010857\\U00010860\\U00010878\\U00010880\\U000108a6\\U000108b0\\U000108fa\\U00010900\\U00010915\\U0001091c\\U000109bb\\U000109be\\U000109bf\\U000109d0\\U000109d1\\U00010a00\\U00010a3f\\U00010a49\\U00010a7c\\U00010a7f\\U00010a9c\\U00010aa0\\U00010aea\\U00010af0\\U00010b57\\U00010b60\\U00010b77\\U00010b80\\U00010ba8\\U00010bb0\\U00010cf9\\U00010d00\\U00010d2f\\U00010d3a\\U00010d3f\\U00010d4a\\U00010e5f\\U00010e7f\\U00010f1c\\U00010f27\\U00010f50\\U00010f55\\U00010fc4\\U00010fcc\\U00011051\\U00011070\\U000110ef\\U000110fa\\U00011135\\U00011140\\U000111cf\\U000111da\\U000111e0\\U000111f5\\U000112ef\\U000112fa\\U0001144f\\U0001145a\\U000114cf\\U000114da\\U0001164f\\U0001165a\\U000116bf\\U000116ca\\U000116cf\\U000116e4\\U0001172f\\U0001173c\\U000118df\\U000118f3\\U0001194f\\U0001195a\\U00011bef\\U00011bfa\\U00011c4f\\U00011c6d\\U00011d4f\\U00011d5a\\U00011d9f\\U00011daa\\U00011ddf\\U00011dea\\U00011f4f\\U00011f5a\\U00011fbf\\U00011fd5\\U000123ff\\U0001246f\\U0001612f\\U0001613a\\U00016a5f\\U00016a6a\\U00016abf\\U00016aca\\U00016b4f\\U00016b5a\\U00016b5a\\U00016b62\\U00016d6f\\U00016d7a\\U00016e7f\\U00016e97\\U00016ff3\\U00016ff7\\U0001ccef\\U0001ccfa\\U0001d2bf\\U0001d2d4\\U0001d2df\\U0001d2f4\\U0001d35f\\U0001d379\\U0001d7cd\\U0001d800\\U0001e13f\\U0001e14a\\U0001e2ef\\U0001e2fa\\U0001e4ef\\U0001e4fa\\U0001e5f0\\U0001e5fb\\U0001e8c6\\U0001e8d0\\U0001e94f\\U0001e95a\\U0001ec70\\U0001ecac\\U0001ecac\\U0001ecb0\\U0001ecb0\\U0001ecb5\\U0001ed00\\U0001ed2e\\U0001ed2e\\U0001ed3e\\U0001f0ff\\U0001f10d\\U0001fbef\\U0001fbfa\\U0010ffff\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("\\s(?<(?i:Σ)", 212), "error parsing regexp: invalid named capture: `(?<(?i:Σ)`"
  assert_eq parse_error("+?a{2}", 196), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error("*x{1001}c{2,}[a-z&&]", 0), "error parsing regexp: missing argument to repetition operator: `*`"
  assert_eq parse_error("a{2}ab\\C\\z", 212), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("c{2,}|ſ\\A[α-ω]", 213, "alt{rep{2,-1 litfold{C}}cat{litfold{S}bot{}cc{0xb5 0x345 0x391-0x3a1 0x3a3-0x3a9 0x3b1-0x3c9 0x3d0-0x3d1 0x3d5-0x3d6 0x3f0-0x3f1 0x3f4-0x3f5 0x1fbe 0x2126}}}", "(?i:C{2,}|S\\A[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ])", "(?i:CC+|S\\A[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ])", "  0\tfail\n  1\trune \"C\"/i -> 2\n  2\trune \"C\"/i -> 3\n  3\talt -> 2, 8\n  4\trune \"S\"/i -> 5\n  5\tempty 4 -> 6\n  6\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0391\\u03a1\\u03a3\\u03a9\\u03b1\\u03c9\\u03d0\\u03d1\\u03d5\\u03d6\\u03f0\\u03f1\\u03f4\\u03f5\\u1fbe\\u1fbe\\u2126\\u2126\" -> 8\n  7*\talt -> 1, 4\n  8\tmatch\n")
  assert_eq parse_error("日本(?s:.)[a-z&&]\\8", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("K", 213, "litfold{K}", "(?i:K)", "(?i:K)", "  0\tfail\n  1*\trune \"K\"/i -> 2\n  2\tmatch\n")
  check_all("a(?U)a+", 213, "cat{litfold{A}nplus{litfold{A}}}", "(?i:AA+?)", "(?i:AA+?)", "  0\tfail\n  1*\trune \"A\"/i -> 2\n  2\trune \"A\"/i -> 3\n  3\talt -> 4, 2\n  4\tmatch\n")
  check_all("(?s:.)", 204, "dot{}", "(?s:.)", "(?s:.)", "  0\tfail\n  1*\tany -> 2\n  2\tmatch\n")
  check_all("a", 196, "lit{a}", "a", "a", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\tmatch\n")
}

test "random parse 5" {
  assert_eq parse_error(")K\\d[^b]é", 213), "error parsing regexp: unexpected ): `)K\\d[^b]é`"
  assert_eq parse_error("\\x{2a}[b{1,3}K", 213), "error parsing regexp: missing closing ]: `[b{1,3}K`"
  check_all("]a", 212, "str{]a}", "\\]a", "\\]a", "  0\tfail\n  1*\trune1 \"]\" -> 2\n  2\trune1 \"a\" -> 3\n  3\tmatch\n")
  check_all("(a|b)", 213, "cap{cc{0x41-0x42 0x61-0x62}}", "([ABab])", "([ABab])", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune \"ABab\" -> 3\n  3\tcap 3 -> 4\n  4\tmatch\n")
  assert_eq parse_error("x{1001}(?U)a+(?:ab|ac)(", 212), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("[α-ω][a-c]", 0, "cat{cc{0x3b1-0x3c9}cc{0x61-0x63}}", "[α-ω][a-c]", "[α-ω][a-c]", "  0\tfail\n  1*\trune \"\\u03b1\\u03c9\" -> 2\n  2\trune \"ac\" -> 3\n  3\tmatch\n")
  check_all("c{2,}[α-ω](?:ab|ac)", 213, "cat{rep{2,-1 litfold{C}}cc{0xb5 0x345 0x391-0x3a1 0x3a3-0x3a9 0x3b1-0x3c9 0x3d0-0x3d1 0x3d5-0x3d6 0x3f0-0x3f1 0x3f4-0x3f5 0x1fbe 0x2126}litfold{A}cc{0x42-0x43 0x62-0x63}}", "(?i:C{2,}[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ]A[BCbc])", "(?i:CC+[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ]A[BCbc])", "  0\tfail\n  1*\trune \"C\"/i -> 2\n  2\trune \"C\"/i -> 3\n  3\talt -> 2, 4\n  4\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0391\\u03a1\\u03a3\\u03a9\\u03b1\\u03c9\\u03d0\\u03d1\\u03d5\\u03d6\\u03f0\\u03f1\\u03f4\\u03f5\\u1fbe\\u1fbe\\u2126\\u2126\" -> 5\n  5\trune \"A\"/i -> 6\n  6\trune \"BCbc\" -> 7\n  7\tmatch\n")
  assert_eq parse_error("\\C\\Bb", 204), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("a[a-c]x{1001}(?-s:.)\\8", 204), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("\\s\\z\\b", 212, "cat{cc{0x9-0xa 0xc-0xd 0x20}eot{\\z}wb{}}", "[\\t\\n\\f\\r ]\\z\\b", "[\\t\\n\\f\\r ]\\z\\b", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\tempty 8 -> 3\n  3\tempty 16 -> 4\n  4\tmatch\n")
  check_all("(?i)k日本(?m:^x$){,.", 213, "cat{strfold{K日本}bol{}litfold{X}eol{}str{{,}dnl{}}", "(?im-s:K日本^X$\\{,.)", "(?im-s:K日本^X$\\{,.)", "  0\tfail\n  1*\trune \"K\"/i -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 4\n  4\tempty 1 -> 5\n  5\trune \"X\"/i -> 6\n  6\tempty 2 -> 7\n  7\trune1 \"{\" -> 8\n  8\trune1 \",\" -> 9\n  9\tanynotnl -> 10\n 10\tmatch\n")
  assert_eq parse_error("a{2}(?<(?-s:.)\\A", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("$ab\\Q.*\\E[a-c]\\d", 0), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("(?<", 213), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
