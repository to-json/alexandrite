  check_all("日本b{1,3}[α-ω]", 212, "cat{str{日本}rep{1,3 lit{b}}cc{0x3b1-0x3c9}}", "日本b{1,3}[α-ω]", "日本b(?:bb?)?[α-ω]", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\trune1 \"b\" -> 7\n  4\trune1 \"b\" -> 6\n  5\trune1 \"b\" -> 8\n  6\talt -> 5, 8\n  7\talt -> 4, 8\n  8\trune \"\\u03b1\\u03c9\" -> 9\n  9\tmatch\n")
  assert_eq parse_error("+?\\d\\(?m:^x$)", 213), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error("c{2,}(a|b)(?s:.))[", 196), "error parsing regexp: unexpected ): `c{2,}(a|b)(?s:.))[`"
  check_all("c{2,}[^b]", 0, "cat{rep{2,-1 lit{c}}cc{0x0-0x9 0xb-0x61 0x63-0x10ffff}}", "c{2,}[^\\nb]", "cc+[^\\nb]", "  0\tfail\n  1*\trune1 \"c\" -> 2\n  2\trune1 \"c\" -> 3\n  3\talt -> 2, 4\n  4\trune \"\\x00\\t\\vac\\U0010ffff\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("(?i:Σ)[α-ω]x{1001}c{2,}", 204), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("\\A", 196, "bot{}", "\\A", "\\A", "  0\tfail\n  1*\tempty 4 -> 2\n  2\tmatch\n")
  check_all(".\\z", 196, "cat{dnl{}eot{\\z}}", "(?-s:.\\z)", "(?-s:.\\z)", "  0\tfail\n  1*\tanynotnl -> 2\n  2\tempty 8 -> 3\n  3\tmatch\n")
}

test "random parse 49" {
  assert_eq parse_error("[^b][\\B(?i)k", 204), "error parsing regexp: invalid escape sequence: `\\B`"
  check_all("(?i:Σ)\\s(?i)k", 212, "cat{litfold{Σ}cc{0x9-0xa 0xc-0xd 0x20}litfold{K}}", "(?i:Σ[\\t\\n\\f\\r ]K)", "(?i:Σ[\\t\\n\\f\\r ]K)", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 2\n  2\trune \"\\t\\n\\f\\r  \" -> 3\n  3\trune \"K\"/i -> 4\n  4\tmatch\n")
  assert_eq parse_error("\\d\\p{Greek}.\\Q.*\\E", 0), "error parsing regexp: invalid escape sequence: `\\d`"
  assert_eq parse_error("\\Q.*\\E(?:ab|ac))[a-z&&]", 212), "error parsing regexp: unexpected ): `\\Q.*\\E(?:ab|ac))[a-z&&]`"
  check_all("(?s:.)+?\\b日本", 196, "cat{nplus{dot{}}wb{}str{日本}}", "(?s:.+?\\b日本)", "(?s:.+?\\b日本)", "  0\tfail\n  1*\tany -> 2\n  2\talt -> 3, 1\n  3\tempty 16 -> 4\n  4\trune1 \"\\u65e5\" -> 5\n  5\trune1 \"\\u672c\" -> 6\n  6\tmatch\n")
  check_all("\\z[a-c]", 212, "cat{eot{\\z}cc{0x61-0x63}}", "\\z[a-c]", "\\z[a-c]", "  0\tfail\n  1*\tempty 8 -> 2\n  2\trune \"ac\" -> 3\n  3\tmatch\n")
  check_all("é", 204, "lit{é}", "é", "é", "  0\tfail\n  1*\trune1 \"\\u00e9\" -> 2\n  2\tmatch\n")
