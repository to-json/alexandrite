  assert_eq parse_error("\\C", 0), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("(?-s:.)", 213, "dnl{}", "(?-s:.)", "(?-s:.)", "  0\tfail\n  1*\tanynotnl -> 2\n  2\tmatch\n")
  assert_eq parse_error("(\\z[a-z&&](a|b)ſ", 204), "error parsing regexp: missing closing ): `(\\z[a-z&&](a|b)ſ`"
  assert_eq parse_error("(?i:Σ)\\b[α-ω](?s:.)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("\\(?U)a+\\z", 196), "error parsing regexp: unexpected ): `\\(?U)a+\\z`"
  check_all("\\w\\w", 212, "cat{cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}}", "[0-9A-Z_a-z][0-9A-Z_a-z]", "[0-9A-Z_a-z][0-9A-Z_a-z]", "  0\tfail\n  1*\trune \"09AZ__az\" -> 2\n  2\trune \"09AZ__az\" -> 3\n  3\tmatch\n")
  check_all("[^\\x00-\\x{10FFFF}]", 204, "cc{}", "[^\\x00-\\x{10FFFF}]", "[^\\x00-\\x{10FFFF}]", "  0\tfail\n  1*\trune \"\" -> 2\n  2\tmatch\n")
