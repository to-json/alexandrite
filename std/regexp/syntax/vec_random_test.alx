  check_all("]\\p{Greek}\\A\\b", 204, "cat{lit{]}cc{0x370-0x373 0x375-0x377 0x37a-0x37d 0x37f 0x384 0x386 0x388-0x38a 0x38c 0x38e-0x3a1 0x3a3-0x3e1 0x3f0-0x3ff 0x1d26-0x1d2a 0x1d5d-0x1d61 0x1d66-0x1d6a 0x1dbf 0x1f00-0x1f15 0x1f18-0x1f1d 0x1f20-0x1f45 0x1f48-0x1f4d 0x1f50-0x1f57 0x1f59 0x1f5b 0x1f5d 0x1f5f-0x1f7d 0x1f80-0x1fb4 0x1fb6-0x1fc4 0x1fc6-0x1fd3 0x1fd6-0x1fdb 0x1fdd-0x1fef 0x1ff2-0x1ff4 0x1ff6-0x1ffe 0x2126 0xab65 0x10140-0x1018e 0x101a0 0x1d200-0x1d245}bot{}wb{}}", "\\][Ͱ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]\\A\\b", "\\][Ͱ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]\\A\\b", "  0\tfail\n  1*\trune1 \"]\" -> 2\n  2\trune \"\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 3\n  3\tempty 4 -> 4\n  4\tempty 16 -> 5\n  5\tmatch\n")
  check_all("(?-s:.)[[:alpha:]]", 196, "cat{dnl{}cc{0x41-0x5a 0x61-0x7a}}", "(?-s:.[A-Za-z])", "(?-s:.[A-Za-z])", "  0\tfail\n  1*\tanynotnl -> 2\n  2\trune \"AZaz\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("*(a|b)", 213), "error parsing regexp: missing argument to repetition operator: `*`"
  check_all("[α-ω]日本", 212, "cat{cc{0x3b1-0x3c9}str{日本}}", "[α-ω]日本", "[α-ω]日本", "  0\tfail\n  1*\trune \"\\u03b1\\u03c9\" -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 4\n  4\tmatch\n")
  check_all("b", 212, "lit{b}", "b", "b", "  0\tfail\n  1*\trune1 \"b\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("\\Q.*\\E(?<", 196), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
  assert_eq parse_error("\\Q.*\\E", 0), "error parsing regexp: invalid escape sequence: `\\Q`"
}

test "random parse 21" {
