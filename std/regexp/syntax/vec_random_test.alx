  check_all("a{2}ſa{,", 213, "cat{rep{2,2 litfold{A}}strfold{SA{,}}", "(?i:A{2}SA\\{,)", "(?i:AASA\\{,)", "  0\tfail\n  1*\trune \"A\"/i -> 2\n  2\trune \"A\"/i -> 3\n  3\trune \"S\"/i -> 4\n  4\trune \"A\"/i -> 5\n  5\trune1 \"{\" -> 6\n  6\trune1 \",\" -> 7\n  7\tmatch\n")
