  check_all("ab", 212, "str{ab}", "ab", "ab", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"b\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("(a|b)\\B[\\p{Lu}0-9][^b][", 204), "error parsing regexp: missing closing ]: `[`"
}

test "random parse 14" {
  assert_eq parse_error("[\\z", 0), "error parsing regexp: invalid escape sequence: `\\z`"
  assert_eq parse_error("*(a|b)", 212), "error parsing regexp: missing argument to repetition operator: `*`"
  check_all("\\A\\sa(?P<n>z)", 213, "cat{bot{}cc{0x9-0xa 0xc-0xd 0x20}litfold{A}cap{n:litfold{Z}}}", "(?i:\\A[\\t\\n\\f\\r ]A(?P<n>Z))", "(?i:\\A[\\t\\n\\f\\r ]A(?P<n>Z))", "  0\tfail\n  1*\tempty 4 -> 2\n  2\trune \"\\t\\n\\f\\r  \" -> 3\n  3\trune \"A\"/i -> 4\n  4\tcap 2 -> 5\n  5\trune \"Z\"/i -> 6\n  6\tcap 3 -> 7\n  7\tmatch\n")
  assert_eq parse_error("(b\\\\x{2a}(?s:.)", 212), "error parsing regexp: missing closing ): `(b\\\\x{2a}(?s:.)`"
  check_all("日本a{2}[^b]", 212, "cat{str{日本}rep{2,2 lit{a}}cc{0x0-0x61 0x63-0x10ffff}}", "日本a{2}[^b]", "日本aa[^b]", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\trune1 \"a\" -> 4\n  4\trune1 \"a\" -> 5\n  5\trune \"\\x00ac\\U0010ffff\" -> 6\n  6\tmatch\n")
  check_all("\\[^\\x00-\\x{10FFFF}]", 213, "cat{lit{[}bot{}str{\x00-\U0010ffff]}}", "\\[\\A\\x00-\\x{10ffff}\\]", "\\[\\A\\x00-\\x{10ffff}\\]", "  0\tfail\n  1*\trune1 \"[\" -> 2\n  2\tempty 4 -> 3\n  3\trune1 \"\\x00\" -> 4\n  4\trune1 \"-\" -> 5\n  5\trune1 \"\\U0010ffff\" -> 6\n  6\trune1 \"]\" -> 7\n  7\tmatch\n")
  assert_eq parse_error("\\b\\Pn\\x{2a}[^\\x00-\\x{10FFFF}]", 0), "error parsing regexp: invalid escape sequence: `\\b`"
  check_all("(?i:Σ)\\s*]", 213, "cat{litfold{Σ}star{cc{0x9-0xa 0xc-0xd 0x20}}lit{]}}", "(?i:Σ[\\t\\n\\f\\r ]*\\])", "(?i:Σ[\\t\\n\\f\\r ]*\\])", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 3\n  2\trune \"\\t\\n\\f\\r  \" -> 3\n  3\talt -> 2, 4\n  4\trune1 \"]\" -> 5\n  5\tmatch\n")
