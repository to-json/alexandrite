test "random parse 44" {
  check_all("ſ\\d(?i)k", 196, "cat{lit{ſ}cc{0x30-0x39}litfold{K}}", "ſ[0-9](?i:K)", "ſ[0-9](?i:K)", "  0\tfail\n  1*\trune1 \"\\u017f\" -> 2\n  2\trune \"09\" -> 3\n  3\trune \"K\"/i -> 4\n  4\tmatch\n")
