\U0001ee5d\\U0001ee5d\\U0001ee5f\\U0001ee5f\\U0001ee61\\U0001ee62\\U0001ee64\\U0001ee64\\U0001ee67\\U0001ee6a\\U0001ee6c\\U0001ee72\\U0001ee74\\U0001ee77\\U0001ee79\\U0001ee7c\\U0001ee7e\\U0001ee7e\\U0001ee80\\U0001ee89\\U0001ee8b\\U0001ee9b\\U0001eea1\\U0001eea3\\U0001eea5\\U0001eea9\\U0001eeab\\U0001eebb\\U00020000\\U0002a6df\\U0002a700\\U0002b81d\\U0002b820\\U0002cead\\U0002ceb0\\U0002ebe0\\U0002ebf0\\U0002ee5d\\U0002f800\\U0002fa1d\\U00030000\\U0003134a\\U00031350\\U00033479\" -> 4\n  4\trune \"\\u03b1\\u03c9\" -> 5\n  5\tcap 2 -> 6\n  6\trune \"ab\" -> 7\n  7\tcap 3 -> 8\n  8\tmatch\n")
  check_all("K(?:ab|ac)", 204, "cat{lit{K}lit{a}cc{0x62-0x63}}", "Ka[bc]", "Ka[bc]", "  0\tfail\n  1*\trune1 \"K\" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune \"bc\" -> 4\n  4\tmatch\n")
  check_all("\\zx*", 196, "cat{eot{\\z}star{lit{x}}}", "\\zx*", "\\zx*", "  0\tfail\n  1*\tempty 8 -> 3\n  2\trune1 \"x\" -> 3\n  3\talt -> 2, 4\n  4\tmatch\n")
  check_all("(?i:Σ)", 204, "litfold{Σ}", "(?i:Σ)", "(?i:Σ)", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 2\n  2\tmatch\n")
  check_all("a{2}\\z", 212, "cat{rep{2,2 lit{a}}eot{\\z}}", "a{2}\\z", "aa\\z", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"a\" -> 3\n  3\tempty 8 -> 4\n  4\tmatch\n")
  check_all("(a|b)", 0, "cap{cc{0x61-0x62}}", "([ab])", "([ab])", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune \"ab\" -> 3\n  3\tcap 3 -> 4\n  4\tmatch\n")
  assert_eq parse_error("$a{2}(?U)a+", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("\\s[^b]éb", 196, "cat{cc{0x9-0xa 0xc-0xd 0x20}cc{0x0-0x61 0x63-0x10ffff}str{éb}}", "[\\t\\n\\f\\r ][^b]éb", "[\\t\\n\\f\\r ][^b]éb", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\trune \"\\x00ac\\U0010ffff\" -> 3\n  3\trune1 \"\\u00e9\" -> 4\n  4\trune1 \"b\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("(?-s:.)日本.K[α-ω]", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("\\p{Greek}\\C", 213), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("\\pL\\C\\b", 196), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("\\pLſ(?i:Σ)[\\w", 0), "error parsing regexp: invalid escape sequence: `\\p`"
  assert_eq parse_error("{,[", 213), "error parsing regexp: missing closing ]: `[`"
  assert_eq parse_error("ab]\\8x*", 213), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("{,", 0, "str{{,}", "\\{,", "\\{,", "  0\tfail\n  1*\trune1 \"{\" -> 2\n  2\trune1 \",\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("\\Pn^*[[:alpha:]][", 196), "error parsing regexp: missing closing ]: `[`"
  assert_eq parse_error("x*[^\\x00-\\x{10FFFF}]\\C+?[^b]", 204), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("a", 212, "lit{a}", "a", "a", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("[^b]\\x{2a}a\\b", 0), "error parsing regexp: invalid escape sequence: `\\b`"
