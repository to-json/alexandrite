  check_all("bab", 196, "str{bab}", "bab", "bab", "  0\tfail\n  1*\trune1 \"b\" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune1 \"b\" -> 4\n  4\tmatch\n")
