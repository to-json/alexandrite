  check_all("[(?U)a+)c{2,}[^b]", 0, "cc{0x28-0x29 0x2b-0x2c 0x32 0x3f 0x55 0x5b 0x5e 0x61-0x63 0x7b 0x7d}", "[\\(\\)\\+,2\\?U\\[\\^a-c\\{\\}]", "[\\(\\)\\+,2\\?U\\[\\^a-c\\{\\}]", "  0\tfail\n  1*\trune \"()+,22??UU[[^^ac{{}}\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("b\\8.", 212), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("[α-ω]x{1001}K", 213), "error parsing regexp: invalid repeat count: `{1001}`"
}

test "random parse 35" {
  assert_eq parse_error("(?-s:.)(\\C", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("a", 204, "lit{a}", "a", "a", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\tmatch\n")
  check_all("(?i)k(?i)k", 196, "strfold{KK}", "(?i:KK)", "(?i:KK)", "  0\tfail\n  1*\trune \"K\"/i -> 2\n  2\trune \"K\"/i -> 3\n  3\tmatch\n")
  check_all("[[:alpha:]]c{2,}(?i)k", 196, "cat{cc{0x41-0x5a 0x61-0x7a}rep{2,-1 lit{c}}litfold{K}}", "[A-Za-z]c{2,}(?i:K)", "[A-Za-z]cc+(?i:K)", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\trune1 \"c\" -> 3\n  3\trune1 \"c\" -> 4\n  4\talt -> 3, 5\n  5\trune \"K\"/i -> 6\n  6\tmatch\n")
  assert_eq parse_error("[[:alpha:]]\\C(?i)kc{2,}", 213), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("\\B日本ſ", 204, "cat{nwb{}str{日本ſ}}", "\\B日本ſ", "\\B日本ſ", "  0\tfail\n  1*\tempty 32 -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 4\n  4\trune1 \"\\u017f\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("\\\\wa)[^b]", 204), "error parsing regexp: unexpected ): `\\\\wa)[^b]`"
  assert_eq parse_error("*\\b\\B]", 196), "error parsing regexp: missing argument to repetition operator: `*`"
  check_all("\\w", 204, "cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}", "[0-9A-Z_a-z]", "[0-9A-Z_a-z]", "  0\tfail\n  1*\trune \"09AZ__az\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("[ab(?U)a+", 204), "error parsing regexp: missing closing ]: `[ab(?U)a+`"
  assert_eq parse_error("\\d{,x*K", 0), "error parsing regexp: invalid escape sequence: `\\d`"
  assert_eq parse_error("b{1,3}(?i:Σ)[(?<", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("[a-z&&]", 204, "cc{0x26 0x61-0x7a}", "[&a-z]", "[&a-z]", "  0\tfail\n  1*\trune \"&&az\" -> 2\n  2\tmatch\n")
