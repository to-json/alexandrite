  check_all(".(?i)kx*(?s:.){,", 212, "cat{dnl{}litfold{K}star{litfold{X}}dot{}str{{,}}", "(?-s:.(?i:KX*)(?s:.)\\{,)", "(?-s:.(?i:KX*)(?s:.)\\{,)", "  0\tfail\n  1*\tanynotnl -> 2\n  2\trune \"K\"/i -> 4\n  3\trune \"X\"/i -> 4\n  4\talt -> 3, 5\n  5\tany -> 6\n  6\trune1 \"{\" -> 7\n  7\trune1 \",\" -> 8\n  8\tmatch\n")
}

test "random parse 26" {
  check_all("b{1,3}(?U)a+[α-ω]", 213, "cat{rep{1,3 litfold{B}}nplus{litfold{A}}cc{0xb5 0x345 0x391-0x3a1 0x3a3-0x3a9 0x3b1-0x3c9 0x3d0-0x3d1 0x3d5-0x3d6 0x3f0-0x3f1 0x3f4-0x3f5 0x1fbe 0x2126}}", "(?i:B{1,3}A+?[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ])", "(?i:B(?:BB?)?A+?[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ])", "  0\tfail\n  1*\trune \"B\"/i -> 5\n  2\trune \"B\"/i -> 4\n  3\trune \"B\"/i -> 6\n  4\talt -> 3, 6\n  5\talt -> 2, 6\n  6\trune \"A\"/i -> 7\n  7\talt -> 8, 6\n  8\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0391\\u03a1\\u03a3\\u03a9\\u03b1\\u03c9\\u03d0\\u03d1\\u03d5\\u03d6\\u03f0\\u03f1\\u03f4\\u03f5\\u1fbe\\u1fbe\\u2126\\u2126\" -> 9\n  9\tmatch\n")
  assert_eq parse_error("(?<b{1,3}\\p{Greek}", 196), "error parsing regexp: invalid named capture: `(?<b{1,3}\\p{Greek}`"
  check_all("[α-ω](a|b)(?U)a+[[:alpha:]].", 204, "cat{cc{0x3b1-0x3c9}cap{cc{0x61-0x62}}nplus{lit{a}}cc{0x41-0x5a 0x61-0x7a}dot{}}", "(?s:[α-ω]([ab])a+?[A-Za-z].)", "(?s:[α-ω]([ab])a+?[A-Za-z].)", "  0\tfail\n  1*\trune \"\\u03b1\\u03c9\" -> 2\n  2\tcap 2 -> 3\n  3\trune \"ab\" -> 4\n  4\tcap 3 -> 5\n  5\trune1 \"a\" -> 6\n  6\talt -> 7, 5\n  7\trune \"AZaz\" -> 8\n  8\tany -> 9\n  9\tmatch\n")
  assert_eq parse_error(")[^b]", 196), "error parsing regexp: unexpected ): `)[^b]`"
  check_all("ſ", 204, "lit{ſ}", "ſ", "ſ", "  0\tfail\n  1*\trune1 \"\\u017f\" -> 2\n  2\tmatch\n")
  check_all("Kſ", 213, "strfold{KS}", "(?i:KS)", "(?i:KS)", "  0\tfail\n  1*\trune \"K\"/i -> 2\n  2\trune \"S\"/i -> 3\n  3\tmatch\n")
  check_all("(?:ab|ac)", 196, "cat{lit{a}cc{0x62-0x63}}", "a[bc]", "a[bc]", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune \"bc\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("]*\\8[α-ω][^b]", 204), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("b(?i:Σ)ab($", 196), "error parsing regexp: missing closing ): `b(?i:Σ)ab($`"
  check_all("(?U)a+\\[|", 213, "alt{cat{nplus{litfold{A}}lit{[}}emp{}}", "(?i:A+?\\[|(?:))", "(?i:A+?\\[|(?:))", "  0\tfail\n  1\trune \"A\"/i -> 2\n  2\talt -> 3, 1\n  3\trune1 \"[\" -> 6\n  4\tnop -> 6\n  5*\talt -> 1, 4\n  6\tmatch\n")
  check_all("\\s", 204, "cc{0x9-0xa 0xc-0xd 0x20}", "[\\t\\n\\f\\r ]", "[\\t\\n\\f\\r ]", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\tmatch\n")
  assert_eq parse_error("[[:alpha:]]\\C[\\p{Lu}0-9]x{1001}\\w", 196), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("|", 213, "emp{}", "(?:)", "(?:)", "  0\tfail\n  1*\tnop -> 2\n  2\tmatch\n")
  check_all("(?P<n>z)", 212, "cap{n:lit{z}}", "(?P<n>z)", "(?P<n>z)", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"z\" -> 3\n  3\tcap 3 -> 4\n  4\tmatch\n")
  assert_eq parse_error("|\\zK(a|b))", 204), "error parsing regexp: unexpected ): `|\\zK(a|b))`"
  assert_eq parse_error("[a-z&&]^(a{2}+?", 196), "error parsing regexp: invalid nested repetition operator: `{2}+?`"
  assert_eq parse_error("\\sab", 0), "error parsing regexp: invalid escape sequence: `\\s`"
  assert_eq parse_error("\\z\\bx*.[", 212), "error parsing regexp: missing closing ]: `[`"
  assert_eq parse_error("\\Cab\\C\\C", 212), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("\\x{2a})ab", 212), "error parsing regexp: unexpected ): `\\x{2a})ab`"
  assert_eq parse_error("\\8\\p{Greek}", 213), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("{,", 213, "str{{,}", "\\{,", "\\{,", "  0\tfail\n  1*\trune1 \"{\" -> 2\n  2\trune1 \",\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("x{1001}[^b]\\d$", 204), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("a{2}+?\\8.\\w", 0), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("[α-ω]\\p{Greek}a{2}(?s:.)", 213, "cat{cc{0xb5 0x345 0x391-0x3a1 0x3a3-0x3a9 0x3b1-0x3c9 0x3d0-0x3d1 0x3d5-0x3d6 0x3f0-0x3f1 0x3f4-0x3f5 0x1fbe 0x2126}cc{0xb5 0x345 0x370-0x373 0x375-0x377 0x37a-0x37d 0x37f 0x384 0x386 0x388-0x38a 0x38c 0x38e-0x3a1 0x3a3-0x3e1 0x3f0-0x3ff 0x1d26-0x1d2a 0x1d5d-0x1d61 0x1d66-0x1d6a 0x1dbf 0x1f00-0x1f15 0x1f18-0x1f1d 0x1f20-0x1f45 0x1f48-0x1f4d 0x1f50-0x1f57 0x1f59 0x1f5b 0x1f5d 0x1f5f-0x1f7d 0x1f80-0x1fb4 0x1fb6-0x1fc4 0x1fc6-0x1fd3 0x1fd6-0x1fdb 0x1fdd-0x1fef 0x1ff2-0x1ff4 0x1ff6-0x1ffe 0x2126 0xab65 0x10140-0x1018e 0x101a0 0x1d200-0x1d245}rep{2,2 litfold{A}}dot{}}", "(?is:[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ][µͅͰ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]A{2}.)", "(?is:[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ][µͅͰ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]AA.)", "  0\tfail\n  1*\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0391\\u03a1\\u03a3\\u03a9\\u03b1\\u03c9\\u03d0\\u03d1\\u03d5\\u03d6\\u03f0\\u03f1\\u03f4\\u03f5\\u1fbe\\u1fbe\\u2126\\u2126\" -> 2\n  2\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 3\n  3\trune \"A\"/i -> 4\n  4\trune \"A\"/i -> 5\n  5\tany -> 6\n  6\tmatch\n")
  assert_eq parse_error("(?:ab|ac)(?<.", 204), "error parsing regexp: invalid named capture: `(?<.`"
  assert_eq parse_error("(?<(?U)a+\\b\\s", 212), "error parsing regexp: invalid named capture: `(?<(?U)a+\\b\\s`"
  assert_eq parse_error("|(?:ab|ac)(?s:.)[a-z&&]\\z", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("((?P<n>z)é(?i)k(?U)a+", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("\\C", 212), "error parsing regexp: invalid escape sequence: `\\C`"
}

test "random parse 27" {
  check_all("[^b]", 0, "cc{0x0-0x9 0xb-0x61 0x63-0x10ffff}", "[^\\nb]", "[^\\nb]", "  0\tfail\n  1*\trune \"\\x00\\t\\vac\\U0010ffff\" -> 2\n  2\tmatch\n")
