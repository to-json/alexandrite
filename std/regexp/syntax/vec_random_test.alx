  check_all("(?-s:.)c{2,}", 212, "cat{dnl{}rep{2,-1 lit{c}}}", "(?-s:.c{2,})", "(?-s:.cc+)", "  0\tfail\n  1*\tanynotnl -> 2\n  2\trune1 \"c\" -> 3\n  3\trune1 \"c\" -> 4\n  4\talt -> 3, 5\n  5\tmatch\n")
}

test "random parse 19" {
  check_all("日本\\B[a-z&&]\\d*", 213, "cat{str{日本}nwb{}cc{0x26 0x41-0x5a 0x61-0x7a 0x17f 0x212a}star{cc{0x30-0x39}}}", "日本\\B[&A-Za-zſK][0-9]*", "日本\\B[&A-Za-zſK][0-9]*", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\tempty 32 -> 4\n  4\trune \"&&AZaz\\u017f\\u017f\\u212a\\u212a\" -> 6\n  5\trune \"09\" -> 6\n  6\talt -> 5, 7\n  7\tmatch\n")
  check_all("a{2}\\s(?:ab|ac)", 212, "cat{rep{2,2 lit{a}}cc{0x9-0xa 0xc-0xd 0x20}lit{a}cc{0x62-0x63}}", "a{2}[\\t\\n\\f\\r ]a[bc]", "aa[\\t\\n\\f\\r ]a[bc]", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune \"\\t\\n\\f\\r  \" -> 4\n  4\trune1 \"a\" -> 5\n  5\trune \"bc\" -> 6\n  6\tmatch\n")
  assert_eq parse_error("[a-z&&](a|b)b{1,3}*|", 196), "error parsing regexp: invalid nested repetition operator: `{1,3}*`"
  check_all("[^b]日本\\A", 196, "cat{cc{0x0-0x61 0x63-0x10ffff}str{日本}bot{}}", "[^b]日本\\A", "[^b]日本\\A", "  0\tfail\n  1*\trune \"\\x00ac\\U0010ffff\" -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 4\n  4\tempty 4 -> 5\n  5\tmatch\n")
  assert_eq parse_error("x{1001}\\B", 213), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("[a-c][^\\x00-\\x{10FFFF}][a-c]\\x{2a}(a|b)", 213, "cat{cc{0x41-0x43 0x61-0x63}cc{}cc{0x41-0x43 0x61-0x63}lit{*}cap{cc{0x41-0x42 0x61-0x62}}}", "[A-Ca-c][^\\x00-\\x{10FFFF}][A-Ca-c]\\*([ABab])", "[A-Ca-c][^\\x00-\\x{10FFFF}][A-Ca-c]\\*([ABab])", "  0\tfail\n  1*\trune \"ACac\" -> 2\n  2\trune \"\" -> 3\n  3\trune \"ACac\" -> 4\n  4\trune1 \"*\" -> 5\n  5\tcap 2 -> 6\n  6\trune \"ABab\" -> 7\n  7\tcap 3 -> 8\n  8\tmatch\n")
  assert_eq parse_error(")(?m:^x$)[^b](?m:^x$)", 204), "error parsing regexp: unexpected ): `)(?m:^x$)[^b](?m:^x$)`"
  assert_eq parse_error("{,\\8\\z|a{2}", 204), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("[^\\x00-\\x{10FFFF}]\\z", 0), "error parsing regexp: invalid escape sequence: `\\z`"
  check_all("\\s(?i)k", 212, "cat{cc{0x9-0xa 0xc-0xd 0x20}litfold{K}}", "(?i:[\\t\\n\\f\\r ]K)", "(?i:[\\t\\n\\f\\r ]K)", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\trune \"K\"/i -> 3\n  3\tmatch\n")
  check_all("[[:alpha:]][^b]", 212, "cat{cc{0x41-0x5a 0x61-0x7a}cc{0x0-0x61 0x63-0x10ffff}}", "[A-Za-z][^b]", "[A-Za-z][^b]", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\trune \"\\x00ac\\U0010ffff\" -> 3\n  3\tmatch\n")
  check_all("(?i:Σ)(?-s:.)(?i:Σ)[a-z&&]", 213, "cat{litfold{Σ}dnl{}litfold{Σ}cc{0x26 0x41-0x5a 0x61-0x7a 0x17f 0x212a}}", "(?i-s:Σ.Σ[&A-Za-zſK])", "(?i-s:Σ.Σ[&A-Za-zſK])", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 2\n  2\tanynotnl -> 3\n  3\trune \"\\u03a3\"/i -> 4\n  4\trune \"&&AZaz\\u017f\\u017f\\u212a\\u212a\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("\\pL\\C\\pL", 204), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("(?i)k(?i:Σ))\\", 0), "error parsing regexp: missing argument to repetition operator: `?`"
