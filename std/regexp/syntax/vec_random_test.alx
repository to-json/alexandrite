1ee5b\\U0001ee5b\\U0001ee5d\\U0001ee5d\\U0001ee5f\\U0001ee5f\\U0001ee61\\U0001ee62\\U0001ee64\\U0001ee64\\U0001ee67\\U0001ee6a\\U0001ee6c\\U0001ee72\\U0001ee74\\U0001ee77\\U0001ee79\\U0001ee7c\\U0001ee7e\\U0001ee7e\\U0001ee80\\U0001ee89\\U0001ee8b\\U0001ee9b\\U0001eea1\\U0001eea3\\U0001eea5\\U0001eea9\\U0001eeab\\U0001eebb\\U00020000\\U0002a6df\\U0002a700\\U0002b81d\\U0002b820\\U0002cead\\U0002ceb0\\U0002ebe0\\U0002ebf0\\U0002ee5d\\U0002f800\\U0002fa1d\\U00030000\\U0003134a\\U00031350\\U00033479\" -> 2\n  2\tanynotnl -> 3\n  3\trune \"09AZ__az\\u017f\\u017f\\u212a\\u212a\" -> 4\n  4\tany -> 5\n  5\tmatch\n")
  check_all("|", 213, "emp{}", "(?:)", "(?:)", "  0\tfail\n  1*\tnop -> 2\n  2\tmatch\n")
  check_all("(?U)a+]", 204, "cat{nplus{lit{a}}lit{]}}", "a+?\\]", "a+?\\]", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\talt -> 3, 1\n  3\trune1 \"]\" -> 4\n  4\tmatch\n")
  check_all("\\z\\z(?P<n>z)[^\\x00-\\x{10FFFF}]{,", 213, "cat{eot{\\z}eot{\\z}cap{n:litfold{Z}}cc{}str{{,}}", "(?i:\\z\\z(?P<n>Z)[^\\x00-\\x{10FFFF}]\\{,)", "(?i:\\z\\z(?P<n>Z)[^\\x00-\\x{10FFFF}]\\{,)", "  0\tfail\n  1*\tempty 8 -> 2\n  2\tempty 8 -> 3\n  3\tcap 2 -> 4\n  4\trune \"Z\"/i -> 5\n  5\tcap 3 -> 6\n  6\trune \"\" -> 7\n  7\trune1 \"{\" -> 8\n  8\trune1 \",\" -> 9\n  9\tmatch\n")
  assert_eq parse_error("*(?U)a+", 0), "error parsing regexp: missing argument to repetition operator: `*`"
  assert_eq parse_error("(?<\\b\\w+?$", 213), "error parsing regexp: invalid named capture: `(?<\\b\\w+?$`"
  assert_eq parse_error("(", 212), "error parsing regexp: missing closing ): `(`"
  assert_eq parse_error("(?s:.)\\x{2a}$", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("\\z^[^b]\\8(?i)k", 196), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("$\\A(a|b)\\s(", 204), "error parsing regexp: missing closing ): `$\\A(a|b)\\s(`"
  check_all("\\sab", 196, "cat{cc{0x9-0xa 0xc-0xd 0x20}str{ab}}", "[\\t\\n\\f\\r ]ab", "[\\t\\n\\f\\r ]ab", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune1 \"b\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("|(?<b\\z", 196), "error parsing regexp: invalid named capture: `(?<b\\z`"
  check_all("(?P<n>z)", 204, "cap{n:lit{z}}", "(?P<n>z)", "(?P<n>z)", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"z\" -> 3\n  3\tcap 3 -> 4\n  4\tmatch\n")
  assert_eq parse_error("(", 204), "error parsing regexp: missing closing ): `(`"
  assert_eq parse_error("+?K(?i)k\\d", 213), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error("\\w日本[\\s(?P<n>z)", 204), "error parsing regexp: missing closing ]: `[\\s(?P<n>z)`"
  assert_eq parse_error("\\Ca{2}$b", 0), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("b\\x{2a})[^b](?-s:.)", 196), "error parsing regexp: unexpected ): `b\\x{2a})[^b](?-s:.)`"
  assert_eq parse_error("(a|b)x{1001}", 213), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("\\d|(?U)a+x*.", 204, "alt{cc{0x30-0x39}cat{nplus{lit{a}}nstar{lit{x}}dot{}}}", "(?s:[0-9]|a+?x*?.)", "(?s:[0-9]|a+?x*?.)", "  0\tfail\n  1\trune \"09\" -> 8\n  2\trune1 \"a\" -> 3\n  3\talt -> 5, 2\n  4\trune1 \"x\" -> 5\n  5\talt -> 6, 4\n  6\tany -> 8\n  7*\talt -> 1, 2\n  8\tmatch\n")
  assert_eq parse_error("\\pL(?:ab|ac)])", 212), "error parsing regexp: unexpected ): `\\pL(?:ab|ac)])`"
  check_all("(?i:Σ)b", 196, "cat{litfold{Σ}lit{b}}", "(?i:Σ)b", "(?i:Σ)b", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 2\n  2\trune1 \"b\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("^\\A\\A(?i:Σ)", 0), "error parsing regexp: invalid escape sequence: `\\A`"
  check_all("(?P<n>z)", 196, "cap{n:lit{z}}", "(?P<n>z)", "(?P<n>z)", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"z\" -> 3\n  3\tcap 3 -> 4\n  4\tmatch\n")
}

test "random parse 28" {
  assert_eq parse_error("x*[α-ω]\\zab", 0), "error parsing regexp: invalid escape sequence: `\\z`"
  check_all("\\sb{1,3}(?i:Σ)", 204, "cat{cc{0x9-0xa 0xc-0xd 0x20}rep{1,3 lit{b}}litfold{Σ}}", "[\\t\\n\\f\\r ]b{1,3}(?i:Σ)", "[\\t\\n\\f\\r ]b(?:bb?)?(?i:Σ)", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\trune1 \"b\" -> 6\n  3\trune1 \"b\" -> 5\n  4\trune1 \"b\" -> 7\n  5\talt -> 4, 7\n  6\talt -> 3, 7\n  7\trune \"\\u03a3\"/i -> 8\n  8\tmatch\n")
  assert_eq parse_error("x*\\Pn\\B", 0), "error parsing regexp: invalid escape sequence: `\\P`"
  assert_eq parse_error("\\C(a|b)ſ", 0), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("(+?{,", 0), "error parsing regexp: missing argument to repetition operator: `+`"
  check_all("(?-s:.)x*(?s:.)", 213, "cat{dnl{}star{litfold{X}}dot{}}", "(?-s:.(?i:X*)(?s:.))", "(?-s:.(?i:X*)(?s:.))", "  0\tfail\n  1*\tanynotnl -> 3\n  2\trune \"X\"/i -> 3\n  3\talt -> 2, 4\n  4\tany -> 5\n  5\tmatch\n")
  assert_eq parse_error("{,+?\\A", 0), "error parsing regexp: invalid escape sequence: `\\A`"
