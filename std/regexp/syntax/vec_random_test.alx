  check_all("[[:alpha:]]", 204, "cc{0x41-0x5a 0x61-0x7a}", "[A-Za-z]", "[A-Za-z]", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\tmatch\n")
  check_all("x*", 204, "star{lit{x}}", "x*", "x*", "  0\tfail\n  1\trune1 \"x\" -> 2\n  2*\talt -> 1, 3\n  3\tmatch\n")
  assert_eq parse_error("é(?m:^x$)ab(?-s:.)a", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("ab\\s[\\x{2a}[a-c]", 0), "error parsing regexp: invalid escape sequence: `\\s`"
  assert_eq parse_error("(?i:Σ)(?U)a+(?-s:.)c{2,}+?", 196), "error parsing regexp: invalid nested repetition operator: `{2,}+?`"
  check_all("x*\\z", 196, "cat{star{lit{x}}eot{\\z}}", "x*\\z", "x*\\z", "  0\tfail\n  1\trune1 \"x\" -> 2\n  2*\talt -> 1, 3\n  3\tempty 8 -> 4\n  4\tmatch\n")
  check_all("(?:ab|ac)a[^b](?P<n>z)", 213, "cat{litfold{A}cc{0x42-0x43 0x62-0x63}litfold{A}cc{0x0-0x41 0x43-0x61 0x63-0x10ffff}cap{n:litfold{Z}}}", "(?i:A[BCbc]A[^Bb](?P<n>Z))", "(?i:A[BCbc]A[^Bb](?P<n>Z))", "  0\tfail\n  1*\trune \"A\"/i -> 2\n  2\trune \"BCbc\" -> 3\n  3\trune \"A\"/i -> 4\n  4\trune \"\\x00ACac\\U0010ffff\" -> 5\n  5\tcap 2 -> 6\n  6\trune \"Z\"/i -> 7\n  7\tcap 3 -> 8\n  8\tmatch\n")
  assert_eq parse_error("(?s:.)).[[:alpha:]]", 196), "error parsing regexp: unexpected ): `(?s:.)).[[:alpha:]]`"
  assert_eq parse_error("+?ſ(?-s:.)", 212), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error(")c{2,}", 212), "error parsing regexp: unexpected ): `)c{2,}`"
  assert_eq parse_error("\\s[a-z&&]x{1001}c{2,}", 213), "error parsing regexp: invalid repeat count: `{1001}`"
}

test "random parse 33" {
  check_all("ab{,", 196, "str{ab{,}", "ab\\{,", "ab\\{,", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"b\" -> 3\n  3\trune1 \"{\" -> 4\n  4\trune1 \",\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("+?", 204), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error("x{1001}(?i)k(a|b)", 204), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("ſ", 196, "lit{ſ}", "ſ", "ſ", "  0\tfail\n  1*\trune1 \"\\u017f\" -> 2\n  2\tmatch\n")
  check_all("(?:ab|ac)", 213, "cat{litfold{A}cc{0x42-0x43 0x62-0x63}}", "(?i:A[BCbc])", "(?i:A[BCbc])", "  0\tfail\n  1*\trune \"A\"/i -> 2\n  2\trune \"BCbc\" -> 3\n  3\tmatch\n")
  assert_eq parse_error(")[\\p{Lu}0-9]", 196), "error parsing regexp: unexpected ): `)[\\p{Lu}0-9]`"
  check_all("(?:ab|ac)[a-c]", 213, "cat{litfold{A}cc{0x42-0x43 0x62-0x63}cc{0x41-0x43 0x61-0x63}}", "(?i:A[BCbc][A-Ca-c])", "(?i:A[BCbc][A-Ca-c])", "  0\tfail\n  1*\trune \"A\"/i -> 2\n  2\trune \"BCbc\" -> 3\n  3\trune \"ACac\" -> 4\n  4\tmatch\n")
  check_all("[a-z&&]x*[^\\x00-\\x{10FFFF}](?P<n>z)", 196, "cat{cc{0x26 0x61-0x7a}star{lit{x}}cc{}cap{n:lit{z}}}", "[&a-z]x*[^\\x00-\\x{10FFFF}](?P<n>z)", "[&a-z]x*[^\\x00-\\x{10FFFF}](?P<n>z)", "  0\tfail\n  1*\trune \"&&az\" -> 3\n  2\trune1 \"x\" -> 3\n  3\talt -> 2, 4\n  4\trune \"\" -> 5\n  5\tcap 2 -> 6\n  6\trune1 \"z\" -> 7\n  7\tcap 3 -> 8\n  8\tmatch\n")
  assert_eq parse_error("\\bx{1001}", 196), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("ab)b{1,3}", 196), "error parsing regexp: unexpected ): `ab)b{1,3}`"
  assert_eq parse_error(")[[:alpha:]]", 204), "error parsing regexp: unexpected ): `)[[:alpha:]]`"
  assert_eq parse_error("(?i)k]\\", 213), "error parsing regexp: trailing backslash at end of expression: ``"
  assert_eq parse_error("(?s:.)\\8\\B", 204), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("日本\\d", 213, "cat{str{日本}cc{0x30-0x39}}", "日本[0-9]", "日本[0-9]", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\trune \"09\" -> 4\n  4\tmatch\n")
  check_all("[[:alpha:]](?s:.)", 196, "cat{cc{0x41-0x5a 0x61-0x7a}dot{}}", "(?s:[A-Za-z].)", "(?s:[A-Za-z].)", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\tany -> 3\n  3\tmatch\n")
  assert_eq parse_error("ſ$)\\w", 213), "error parsing regexp: unexpected ): `ſ$)\\w`"
  assert_eq parse_error("|\\p{Greek}\\pLx{1001}b", 0), "error parsing regexp: invalid escape sequence: `\\p`"
  assert_eq parse_error("(a|b)x*\\d(?s:.)(", 204), "error parsing regexp: missing closing ): `(a|b)x*\\d(?s:.)(`"
  check_all("\\x{2a}é", 213, "strfold{*É}", "(?i:\\*É)", "(?i:\\*É)", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\trune \"\\u00c9\"/i -> 3\n  3\tmatch\n")
  assert_eq parse_error("\\C", 212), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("(?-s:.)(?<", 196), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
  check_all("\\b", 212, "wb{}", "\\b", "\\b", "  0\tfail\n  1*\tempty 16 -> 2\n  2\tmatch\n")
  check_all("\\z.", 204, "cat{eot{\\z}dot{}}", "(?s:\\z.)", "(?s:\\z.)", "  0\tfail\n  1*\tempty 8 -> 2\n  2\tany -> 3\n  3\tmatch\n")
  check_all("\\b\\A(?i:Σ)(?i)k]", 204, "cat{wb{}bot{}strfold{ΣK]}}", "(?i:\\b\\AΣK\\])", "(?i:\\b\\AΣK\\])", "  0\tfail\n  1*\tempty 16 -> 2\n  2\tempty 4 -> 3\n  3\trune \"\\u03a3\"/i -> 4\n  4\trune \"K\"/i -> 5\n  5\trune1 \"]\" -> 6\n  6\tmatch\n")
  check_all("[[:alpha:]](?-s:.)", 196, "cat{cc{0x41-0x5a 0x61-0x7a}dnl{}}", "(?-s:[A-Za-z].)", "(?-s:[A-Za-z].)", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\tanynotnl -> 3\n  3\tmatch\n")
