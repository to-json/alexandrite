  check_all("(?i)k(?U)a+", 196, "cat{litfold{K}nplus{litfold{A}}}", "(?i:KA+?)", "(?i:KA+?)", "  0\tfail\n  1*\trune \"K\"/i -> 2\n  2\trune \"A\"/i -> 3\n  3\talt -> 4, 2\n  4\tmatch\n")
