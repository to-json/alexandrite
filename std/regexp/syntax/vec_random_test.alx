  check_all("\\s[α-ω]||", 204, "alt{cat{cc{0x9-0xa 0xc-0xd 0x20}cc{0x3b1-0x3c9}}emp{}}", "[\\t\\n\\f\\r ][α-ω]|(?:)", "[\\t\\n\\f\\r ][α-ω]|(?:)", "  0\tfail\n  1\trune \"\\t\\n\\f\\r  \" -> 2\n  2\trune \"\\u03b1\\u03c9\" -> 5\n  3\tnop -> 5\n  4*\talt -> 1, 3\n  5\tmatch\n")
  assert_eq parse_error("[[:alpha:]][^b]Kx{1001}", 204), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("[)\\A", 196), "error parsing regexp: invalid escape sequence: `\\A`"
  assert_eq parse_error("\\z|a{2}\\pL(a|b)", 0), "error parsing regexp: invalid escape sequence: `\\z`"
  check_all("(?s:.)[[:alpha:]]", 213, "cat{dot{}cc{0x41-0x5a 0x61-0x7a 0x17f 0x212a}}", "(?s:.[A-Za-zſK])", "(?s:.[A-Za-zſK])", "  0\tfail\n  1*\tany -> 2\n  2\trune \"AZaz\\u017f\\u017f\\u212a\\u212a\" -> 3\n  3\tmatch\n")
  assert_eq parse_error(".\\A(?i:Σ)[^b]é", 0), "error parsing regexp: invalid escape sequence: `\\A`"
  assert_eq parse_error("*a{2}b{1,3}", 212), "error parsing regexp: missing argument to repetition operator: `*`"
  assert_eq parse_error("+?(?s:.)\\d\\8", 196), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error("\\C$b{1,3}", 196), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("\\8a{2}\\p{Greek}^\\b", 204), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("\\8日本+?*", 204), "error parsing regexp: invalid escape sequence: `\\8`"
}

test "random parse 30" {
  assert_eq parse_error("\\z[\\p{Lu}0-9](?:ab|ac).(?<", 204), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
  assert_eq parse_error("[a-z&&](x*.(?s:.)", 196), "error parsing regexp: missing closing ): `[a-z&&](x*.(?s:.)`"
  check_all("[[:alpha:]]](?P<n>z)[a-z&&]", 212, "cat{cc{0x41-0x5a 0x61-0x7a}lit{]}cap{n:lit{z}}cc{0x26 0x61-0x7a}}", "[A-Za-z]\\](?P<n>z)[&a-z]", "[A-Za-z]\\](?P<n>z)[&a-z]", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\trune1 \"]\" -> 3\n  3\tcap 2 -> 4\n  4\trune1 \"z\" -> 5\n  5\tcap 3 -> 6\n  6\trune \"&&az\" -> 7\n  7\tmatch\n")
  check_all("x*", 204, "star{lit{x}}", "x*", "x*", "  0\tfail\n  1\trune1 \"x\" -> 2\n  2*\talt -> 1, 3\n  3\tmatch\n")
  check_all("^[^\\x00-\\x{10FFFF}]", 204, "cat{bol{}cc{}}", "(?m:^[^\\x00-\\x{10FFFF}])", "(?m:^[^\\x00-\\x{10FFFF}])", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune \"\" -> 3\n  3\tmatch\n")
  check_all("(?U)a+(?P<n>z)", 204, "cat{nplus{lit{a}}cap{n:lit{z}}}", "a+?(?P<n>z)", "a+?(?P<n>z)", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\talt -> 3, 1\n  3\tcap 2 -> 4\n  4\trune1 \"z\" -> 5\n  5\tcap 3 -> 6\n  6\tmatch\n")
  assert_eq parse_error("x{1001}[^b]\\s+?", 0), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("[[:alpha:]]\\Q.*\\E(?:ab|ac)[\\b", 213), "error parsing regexp: invalid escape sequence: `\\b`"
  check_all("\\x{2a}Kbab[[:alpha:]]", 204, "cat{str{*Kbab}cc{0x41-0x5a 0x61-0x7a}}", "\\*Kbab[A-Za-z]", "\\*Kbab[A-Za-z]", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\trune1 \"K\" -> 3\n  3\trune1 \"b\" -> 4\n  4\trune1 \"a\" -> 5\n  5\trune1 \"b\" -> 6\n  6\trune \"AZaz\" -> 7\n  7\tmatch\n")
  check_all("[a-c]\\A", 196, "cat{cc{0x61-0x63}bot{}}", "[a-c]\\A", "[a-c]\\A", "  0\tfail\n  1*\trune \"ac\" -> 2\n  2\tempty 4 -> 3\n  3\tmatch\n")
  assert_eq parse_error("x{1001}\\C\\A(a|b)K", 213), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("(", 212), "error parsing regexp: missing closing ): `(`"
  check_all("[α-ω]", 196, "cc{0x3b1-0x3c9}", "[α-ω]", "[α-ω]", "  0\tfail\n  1*\trune \"\\u03b1\\u03c9\" -> 2\n  2\tmatch\n")
  check_all("c{2,}", 196, "rep{2,-1 lit{c}}", "c{2,}", "cc+", "  0\tfail\n  1*\trune1 \"c\" -> 2\n  2\trune1 \"c\" -> 3\n  3\talt -> 2, 4\n  4\tmatch\n")
  assert_eq parse_error("\\8)", 0), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("[α-ω](?<[a-c](?U)a+", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("\\pL", 0), "error parsing regexp: invalid escape sequence: `\\p`"
  assert_eq parse_error("b\\Q.*\\E\\B\\8", 212), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("\\(?:ab|ac)[a-z&&][[:alpha:]][", 213), "error parsing regexp: unexpected ): `\\(?:ab|ac)[a-z&&][[:alpha:]][`"
  assert_eq parse_error("\\p{Greek}(\\b\\B[\\p{Lu}0-9]", 204), "error parsing regexp: missing closing ): `\\p{Greek}(\\b\\B[\\p{Lu}0-9]`"
  assert_eq parse_error("((?:ab|ac)", 204), "error parsing regexp: missing closing ): `((?:ab|ac)`"
  assert_eq parse_error(".K(\\pL", 212), "error parsing regexp: missing closing ): `.K(\\pL`"
  check_all("é", 204, "lit{é}", "é", "é", "  0\tfail\n  1*\trune1 \"\\u00e9\" -> 2\n  2\tmatch\n")
  check_all("\\d", 204, "cc{0x30-0x39}", "[0-9]", "[0-9]", "  0\tfail\n  1*\trune \"09\" -> 2\n  2\tmatch\n")
  check_all("(?P<n>z)a{2}", 204, "cat{cap{n:lit{z}}rep{2,2 lit{a}}}", "(?P<n>z)a{2}", "(?P<n>z)aa", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"z\" -> 3\n  3\tcap 3 -> 4\n  4\trune1 \"a\" -> 5\n  5\trune1 \"a\" -> 6\n  6\tmatch\n")
  check_all("(?U)a+[a-c]", 212, "cat{nplus{lit{a}}cc{0x61-0x63}}", "a+?[a-c]", "a+?[a-c]", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\talt -> 3, 1\n  3\trune \"ac\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("日本\\d$\\C", 0), "error parsing regexp: invalid escape sequence: `\\d`"
  check_all("(?m:^x$)[a-z&&]ab", 213, "cat{bol{}litfold{X}eol{}cc{0x26 0x41-0x5a 0x61-0x7a 0x17f 0x212a}strfold{AB}}", "(?im:^X$[&A-Za-zſK]AB)", "(?im:^X$[&A-Za-zſK]AB)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune \"X\"/i -> 3\n  3\tempty 2 -> 4\n  4\trune \"&&AZaz\\u017f\\u017f\\u212a\\u212a\" -> 5\n  5\trune \"A\"/i -> 6\n  6\trune \"B\"/i -> 7\n  7\tmatch\n")
  assert_eq parse_error("a{2}(?s:.)[α-ω](?i)k)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("\\\\8[^b]", 213, "cat{str{\\8}cc{0x0-0x41 0x43-0x61 0x63-0x10ffff}}", "\\\\8[^Bb]", "\\\\8[^Bb]", "  0\tfail\n  1*\trune1 \"\\\\\" -> 2\n  2\trune1 \"8\" -> 3\n  3\trune \"\\x00ACac\\U0010ffff\" -> 4\n  4\tmatch\n")
}

