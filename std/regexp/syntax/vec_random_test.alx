ua9fa\\uaa4f\\uaa5a\\uabef\\uabfa\\uff0f\\uff1a\\U00010106\\U00010134\\U0001013f\\U00010179\\U00010189\\U0001018c\\U000102e0\\U000102fc\\U0001031f\\U00010324\\U00010340\\U00010342\\U00010349\\U0001034b\\U000103d0\\U000103d6\\U0001049f\\U000104aa\\U00010857\\U00010860\\U00010878\\U00010880\\U000108a6\\U000108b0\\U000108fa\\U00010900\\U00010915\\U0001091c\\U000109bb\\U000109be\\U000109bf\\U000109d0\\U000109d1\\U00010a00\\U00010a3f\\U00010a49\\U00010a7c\\U00010a7f\\U00010a9c\\U00010aa0\\U00010aea\\U00010af0\\U00010b57\\U00010b60\\U00010b77\\U00010b80\\U00010ba8\\U00010bb0\\U00010cf9\\U00010d00\\U00010d2f\\U00010d3a\\U00010d3f\\U00010d4a\\U00010e5f\\U00010e7f\\U00010f1c\\U00010f27\\U00010f50\\U00010f55\\U00010fc4\\U00010fcc\\U00011051\\U00011070\\U000110ef\\U000110fa\\U00011135\\U00011140\\U000111cf\\U000111da\\U000111e0\\U000111f5\\U000112ef\\U000112fa\\U0001144f\\U0001145a\\U000114cf\\U000114da\\U0001164f\\U0001165a\\U000116bf\\U000116ca\\U000116cf\\U000116e4\\U0001172f\\U0001173c\\U000118df\\U000118f3\\U0001194f\\U0001195a\\U00011bef\\U00011bfa\\U00011c4f\\U00011c6d\\U00011d4f\\U00011d5a\\U00011d9f\\U00011daa\\U00011ddf\\U00011dea\\U00011f4f\\U00011f5a\\U00011fbf\\U00011fd5\\U000123ff\\U0001246f\\U0001612f\\U0001613a\\U00016a5f\\U00016a6a\\U00016abf\\U00016aca\\U00016b4f\\U00016b5a\\U00016b5a\\U00016b62\\U00016d6f\\U00016d7a\\U00016e7f\\U00016e97\\U00016ff3\\U00016ff7\\U0001ccef\\U0001ccfa\\U0001d2bf\\U0001d2d4\\U0001d2df\\U0001d2f4\\U0001d35f\\U0001d379\\U0001d7cd\\U0001d800\\U0001e13f\\U0001e14a\\U0001e2ef\\U0001e2fa\\U0001e4ef\\U0001e4fa\\U0001e5f0\\U0001e5fb\\U0001e8c6\\U0001e8d0\\U0001e94f\\U0001e95a\\U0001ec70\\U0001ecac\\U0001ecac\\U0001ecb0\\U0001ecb0\\U0001ecb5\\U0001ed00\\U0001ed2e\\U0001ed2e\\U0001ed3e\\U0001f0ff\\U0001f10d\\U0001fbef\\U0001fbfa\\U0010ffff\" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune \"bc\" -> 4\n  4\trune \"\\x00ac\\U0010ffff\" -> 5\n  5\tmatch\n")
}

test "random parse 39" {
  assert_eq parse_error("\\B\\8", 213), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("(?P<n>z)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("ab(?P<n>z)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("[a-z&&]b{1,3}", 212, "cat{cc{0x26 0x61-0x7a}rep{1,3 lit{b}}}", "[&a-z]b{1,3}", "[&a-z]b(?:bb?)?", "  0\tfail\n  1*\trune \"&&az\" -> 2\n  2\trune1 \"b\" -> 6\n  3\trune1 \"b\" -> 5\n  4\trune1 \"b\" -> 7\n  5\talt -> 4, 7\n  6\talt -> 3, 7\n  7\tmatch\n")
  assert_eq parse_error("(?<a{2}{,K", 196), "error parsing regexp: invalid named capture: `(?<a{2}{,K`"
  check_all("\\A", 196, "bot{}", "\\A", "\\A", "  0\tfail\n  1*\tempty 4 -> 2\n  2\tmatch\n")
  assert_eq parse_error("*[\\p{Lu}0-9]\\A\\A\\d", 0), "error parsing regexp: missing argument to repetition operator: `*`"
  check_all("${,", 196, "cat{eol{}str{{,}}", "(?m:$\\{,)", "(?m:$\\{,)", "  0\tfail\n  1*\tempty 2 -> 2\n  2\trune1 \"{\" -> 3\n  3\trune1 \",\" -> 4\n  4\tmatch\n")
  check_all("ab|\\s^", 196, "alt{str{ab}cat{cc{0x9-0xa 0xc-0xd 0x20}bol{}}}", "(?m:ab|[\\t\\n\\f\\r ]^)", "(?m:ab|[\\t\\n\\f\\r ]^)", "  0\tfail\n  1\trune1 \"a\" -> 2\n  2\trune1 \"b\" -> 6\n  3\trune \"\\t\\n\\f\\r  \" -> 4\n  4\tempty 1 -> 6\n  5*\talt -> 1, 3\n  6\tmatch\n")
  assert_eq parse_error("[a-z&&](?P<n>z){,(?P<n>z)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("(?m:^x$)^", 213, "cat{bol{}litfold{X}eol{}bot{}}", "(?im:^X$\\A)", "(?im:^X$\\A)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune \"X\"/i -> 3\n  3\tempty 2 -> 4\n  4\tempty 4 -> 5\n  5\tmatch\n")
  check_all("\\z", 213, "eot{\\z}", "\\z", "\\z", "  0\tfail\n  1*\tempty 8 -> 2\n  2\tmatch\n")
  check_all("\\w", 213, "cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a 0x17f 0x212a}", "[0-9A-Z_a-zſK]", "[0-9A-Z_a-zſK]", "  0\tfail\n  1*\trune \"09AZ__az\\u017f\\u017f\\u212a\\u212a\" -> 2\n  2\tmatch\n")
  check_all("b{1,3}\\Bb{1,3}[α-ω]", 212, "cat{rep{1,3 lit{b}}nwb{}rep{1,3 lit{b}}cc{0x3b1-0x3c9}}", "b{1,3}\\Bb{1,3}[α-ω]", "b(?:bb?)?\\Bb(?:bb?)?[α-ω]", "  0\tfail\n  1*\trune1 \"b\" -> 5\n  2\trune1 \"b\" -> 4\n  3\trune1 \"b\" -> 6\n  4\talt -> 3, 6\n  5\talt -> 2, 6\n  6\tempty 32 -> 7\n  7\trune1 \"b\" -> 11\n  8\trune1 \"b\" -> 10\n  9\trune1 \"b\" -> 12\n 10\talt -> 9, 12\n 11\talt -> 8, 12\n 12\trune \"\\u03b1\\u03c9\" -> 13\n 13\tmatch\n")
  assert_eq parse_error("(日本", 196), "error parsing regexp: missing closing ): `(日本`"
  check_all("b{1,3}", 204, "rep{1,3 lit{b}}", "b{1,3}", "b(?:bb?)?", "  0\tfail\n  1*\trune1 \"b\" -> 5\n  2\trune1 \"b\" -> 4\n  3\trune1 \"b\" -> 6\n  4\talt -> 3, 6\n  5\talt -> 2, 6\n  6\tmatch\n")
  assert_eq parse_error("\\K\\d", 213), "error parsing regexp: invalid escape sequence: `\\K`"
  assert_eq parse_error("ſ|*(?<", 213), "error parsing regexp: missing argument to repetition operator: `*`"
  check_all("[^\\x00-\\x{10FFFF}]日本|c{2,}", 196, "alt{cat{cc{}str{日本}}rep{2,-1 lit{c}}}", "[^\\x00-\\x{10FFFF}]日本|c{2,}", "[^\\x00-\\x{10FFFF}]日本|cc+", "  0\tfail\n  1\trune \"\" -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 8\n  4\trune1 \"c\" -> 5\n  5\trune1 \"c\" -> 6\n  6\talt -> 5, 8\n  7*\talt -> 1, 4\n  8\tmatch\n")
  check_all("\\s(?s:.)日本(?P<n>z)", 212, "cat{cc{0x9-0xa 0xc-0xd 0x20}dot{}str{日本}cap{n:lit{z}}}", "(?s:[\\t\\n\\f\\r ].日本(?P<n>z))", "(?s:[\\t\\n\\f\\r ].日本(?P<n>z))", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\tany -> 3\n  3\trune1 \"\\u65e5\" -> 4\n  4\trune1 \"\\u672c\" -> 5\n  5\tcap 2 -> 6\n  6\trune1 \"z\" -> 7\n  7\tcap 3 -> 8\n  8\tmatch\n")
  check_all("(?:ab|ac)]", 212, "cat{lit{a}cc{0x62-0x63}lit{]}}", "a[bc]\\]", "a[bc]\\]", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune \"bc\" -> 3\n  3\trune1 \"]\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("(?-s:.)日本)", 196), "error parsing regexp: unexpected ): `(?-s:.)日本)`"
  check_all("(a|b)(?-s:.)[^\\x00-\\x{10FFFF}]日本", 204, "cat{cap{cc{0x61-0x62}}dnl{}cc{}str{日本}}", "(?-s:([ab]).[^\\x00-\\x{10FFFF}]日本)", "(?-s:([ab]).[^\\x00-\\x{10FFFF}]日本)", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune \"ab\" -> 3\n  3\tcap 3 -> 4\n  4\tanynotnl -> 5\n  5\trune \"\" -> 6\n  6\trune1 \"\\u65e5\" -> 7\n  7\trune1 \"\\u672c\" -> 8\n  8\tmatch\n")
  check_all("c{2,}", 204, "rep{2,-1 lit{c}}", "c{2,}", "cc+", "  0\tfail\n  1*\trune1 \"c\" -> 2\n  2\trune1 \"c\" -> 3\n  3\talt -> 2, 4\n  4\tmatch\n")
  check_all("\\x{2a}", 204, "lit{*}", "\\*", "\\*", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("(?U)a+K", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?<]\\w[a-c](a|b)", 212), "error parsing regexp: invalid named capture: `(?<]\\w[a-c](a|b)`"
  check_all("(?i)k", 196, "litfold{K}", "(?i:K)", "(?i:K)", "  0\tfail\n  1*\trune \"K\"/i -> 2\n  2\tmatch\n")
  assert_eq parse_error("|\\A+?", 0), "error parsing regexp: invalid escape sequence: `\\A`"
