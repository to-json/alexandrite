  check_all("$[a-c]", 196, "cat{eol{}cc{0x61-0x63}}", "(?m:$[a-c])", "(?m:$[a-c])", "  0\tfail\n  1*\tempty 2 -> 2\n  2\trune \"ac\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("[^b]x{1001}", 0), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("(?:ab|ac)\\B\\8ſ", 213), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("[a-z&&]", 204, "cc{0x26 0x61-0x7a}", "[&a-z]", "[&a-z]", "  0\tfail\n  1*\trune \"&&az\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("*(a|b)", 213), "error parsing regexp: missing argument to repetition operator: `*`"
  assert_eq parse_error("[^\\x00-\\x{10FFFF}]ab+?*", 213), "error parsing regexp: invalid nested repetition operator: `+?*`"
  check_all("\\B日本\\p{Greek}", 213, "cat{nwb{}str{日本}cc{0xb5 0x345 0x370-0x373 0x375-0x377 0x37a-0x37d 0x37f 0x384 0x386 0x388-0x38a 0x38c 0x38e-0x3a1 0x3a3-0x3e1 0x3f0-0x3ff 0x1d26-0x1d2a 0x1d5d-0x1d61 0x1d66-0x1d6a 0x1dbf 0x1f00-0x1f15 0x1f18-0x1f1d 0x1f20-0x1f45 0x1f48-0x1f4d 0x1f50-0x1f57 0x1f59 0x1f5b 0x1f5d 0x1f5f-0x1f7d 0x1f80-0x1fb4 0x1fb6-0x1fc4 0x1fc6-0x1fd3 0x1fd6-0x1fdb 0x1fdd-0x1fef 0x1ff2-0x1ff4 0x1ff6-0x1ffe 0x2126 0xab65 0x10140-0x1018e 0x101a0 0x1d200-0x1d245}}", "\\B日本[µͅͰ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]", "\\B日本[µͅͰ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]", "  0\tfail\n  1*\tempty 32 -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 4\n  4\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 5\n  5\tmatch\n")
  check_all("é(a|b)c{2,}\\s", 204, "cat{lit{é}cap{cc{0x61-0x62}}rep{2,-1 lit{c}}cc{0x9-0xa 0xc-0xd 0x20}}", "é([ab])c{2,}[\\t\\n\\f\\r ]", "é([ab])cc+[\\t\\n\\f\\r ]", "  0\tfail\n  1*\trune1 \"\\u00e9\" -> 2\n  2\tcap 2 -> 3\n  3\trune \"ab\" -> 4\n  4\tcap 3 -> 5\n  5\trune1 \"c\" -> 6\n  6\trune1 \"c\" -> 7\n  7\talt -> 6, 8\n  8\trune \"\\t\\n\\f\\r  \" -> 9\n  9\tmatch\n")
  check_all("a(?s:.)ſ", 196, "cat{lit{a}dot{}lit{ſ}}", "(?s:a.ſ)", "(?s:a.ſ)", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\tany -> 3\n  3\trune1 \"\\u017f\" -> 4\n  4\tmatch\n")
  check_all("\\B", 196, "nwb{}", "\\B", "\\B", "  0\tfail\n  1*\tempty 32 -> 2\n  2\tmatch\n")
  assert_eq parse_error("(?m:^x$)é\\8(?i:Σ)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("(a|b)(?-s:.)", 212, "cat{cap{cc{0x61-0x62}}dnl{}}", "(?-s:([ab]).)", "(?-s:([ab]).)", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune \"ab\" -> 3\n  3\tcap 3 -> 4\n  4\tanynotnl -> 5\n  5\tmatch\n")
  check_all("ſ\\d\\z", 213, "cat{litfold{S}cc{0x30-0x39}eot{\\z}}", "(?i:S[0-9]\\z)", "(?i:S[0-9]\\z)", "  0\tfail\n  1*\trune \"S\"/i -> 2\n  2\trune \"09\" -> 3\n  3\tempty 8 -> 4\n  4\tmatch\n")
  check_all("\\x{2a}日本(?-s:.)", 212, "cat{str{*日本}dnl{}}", "(?-s:\\*日本.)", "(?-s:\\*日本.)", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 4\n  4\tanynotnl -> 5\n  5\tmatch\n")
}

