0\\U0001e6f4\\U0001e6fe\\U0001e6ff\\U0001e7e0\\U0001e7e6\\U0001e7e8\\U0001e7eb\\U0001e7ed\\U0001e7ee\\U0001e7f0\\U0001e7fe\\U0001e800\\U0001e8c4\\U0001e900\\U0001e943\\U0001e94b\\U0001e94b\\U0001ee00\\U0001ee03\\U0001ee05\\U0001ee1f\\U0001ee21\\U0001ee22\\U0001ee24\\U0001ee24\\U0001ee27\\U0001ee27\\U0001ee29\\U0001ee32\\U0001ee34\\U0001ee37\\U0001ee39\\U0001ee39\\U0001ee3b\\U0001ee3b\\U0001ee42\\U0001ee42\\U0001ee47\\U0001ee47\\U0001ee49\\U0001ee49\\U0001ee4b\\U0001ee4b\\U0001ee4d\\U0001ee4f\\U0001ee51\\U0001ee52\\U0001ee54\\U0001ee54\\U0001ee57\\U0001ee57\\U0001ee59\\U0001ee59\\U0001ee5b\\U0001ee5b\\U0001ee5d\\U0001ee5d\\U0001ee5f\\U0001ee5f\\U0001ee61\\U0001ee62\\U0001ee64\\U0001ee64\\U0001ee67\\U0001ee6a\\U0001ee6c\\U0001ee72\\U0001ee74\\U0001ee77\\U0001ee79\\U0001ee7c\\U0001ee7e\\U0001ee7e\\U0001ee80\\U0001ee89\\U0001ee8b\\U0001ee9b\\U0001eea1\\U0001eea3\\U0001eea5\\U0001eea9\\U0001eeab\\U0001eebb\\U00020000\\U0002a6df\\U0002a700\\U0002b81d\\U0002b820\\U0002cead\\U0002ceb0\\U0002ebe0\\U0002ebf0\\U0002ee5d\\U0002f800\\U0002fa1d\\U00030000\\U0003134a\\U00031350\\U00033479\" -> 4\n  4\trune \"K\"/i -> 5\n  5\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 6\n  6\tmatch\n")
  check_all("\\Q.*\\E[^b](?U)a+", 212, "cat{str{.*}cc{0x0-0x61 0x63-0x10ffff}nplus{lit{a}}}", "\\.\\*[^b]a+?", "\\.\\*[^b]a+?", "  0\tfail\n  1*\trune1 \".\" -> 2\n  2\trune1 \"*\" -> 3\n  3\trune \"\\x00ac\\U0010ffff\" -> 4\n  4\trune1 \"a\" -> 5\n  5\talt -> 6, 4\n  6\tmatch\n")
  check_all("]c{2,}[[:alpha:]](?i)k\\d", 212, "cat{lit{]}rep{2,-1 lit{c}}cc{0x41-0x5a 0x61-0x7a}litfold{K}cc{0x30-0x39}}", "\\]c{2,}[A-Za-z](?i:K)[0-9]", "\\]cc+[A-Za-z](?i:K)[0-9]", "  0\tfail\n  1*\trune1 \"]\" -> 2\n  2\trune1 \"c\" -> 3\n  3\trune1 \"c\" -> 4\n  4\talt -> 3, 5\n  5\trune \"AZaz\" -> 6\n  6\trune \"K\"/i -> 7\n  7\trune \"09\" -> 8\n  8\tmatch\n")
  assert_eq parse_error("{,.\\z(", 0), "error parsing regexp: invalid escape sequence: `\\z`"
  check_all("\\z(?U)a+", 212, "cat{eot{\\z}nplus{lit{a}}}", "\\za+?", "\\za+?", "  0\tfail\n  1*\tempty 8 -> 2\n  2\trune1 \"a\" -> 3\n  3\talt -> 4, 2\n  4\tmatch\n")
  check_all("ab日本b{1,3}", 196, "cat{str{ab日本}rep{1,3 lit{b}}}", "ab日本b{1,3}", "ab日本b(?:bb?)?", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"b\" -> 3\n  3\trune1 \"\\u65e5\" -> 4\n  4\trune1 \"\\u672c\" -> 5\n  5\trune1 \"b\" -> 9\n  6\trune1 \"b\" -> 8\n  7\trune1 \"b\" -> 10\n  8\talt -> 7, 10\n  9\talt -> 6, 10\n 10\tmatch\n")
  assert_eq parse_error("x**\\x{2a}(?i:Σ)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("(?i)k", 196, "litfold{K}", "(?i:K)", "(?i:K)", "  0\tfail\n  1*\trune \"K\"/i -> 2\n  2\tmatch\n")
  assert_eq parse_error("x{1001}ſ", 213), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("(?<(?<|.\\w", 213), "error parsing regexp: invalid named capture: `(?<(?<|.\\w`"
  assert_eq parse_error("\\C\\d", 213), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("\\Ac{2,}", 204, "cat{bot{}rep{2,-1 lit{c}}}", "\\Ac{2,}", "\\Acc+", "  0\tfail\n  1*\tempty 4 -> 2\n  2\trune1 \"c\" -> 3\n  3\trune1 \"c\" -> 4\n  4\talt -> 3, 5\n  5\tmatch\n")
}

test "random parse 11" {
  check_all("[a-c]*", 0, "star{cc{0x61-0x63}}", "[a-c]*", "[a-c]*", "  0\tfail\n  1\trune \"ac\" -> 2\n  2*\talt -> 1, 3\n  3\tmatch\n")
