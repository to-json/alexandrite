7\tmatch\n")
  check_all("^ſ", 196, "cat{bol{}lit{ſ}}", "(?m:^ſ)", "(?m:^ſ)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune1 \"\\u017f\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("\\z)\\B+?.", 204), "error parsing regexp: unexpected ): `\\z)\\B+?.`"
  assert_eq parse_error("(?:ab|ac)\\x{2a}(?:ab|ac)|", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("\\x{2a}(?m:^x$)(?:ab|ac)\\B^", 196, "cat{lit{*}bol{}lit{x}eol{}lit{a}cc{0x62-0x63}nwb{}bol{}}", "(?m:\\*^x$a[bc]\\B^)", "(?m:\\*^x$a[bc]\\B^)", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\tempty 1 -> 3\n  3\trune1 \"x\" -> 4\n  4\tempty 2 -> 5\n  5\trune1 \"a\" -> 6\n  6\trune \"bc\" -> 7\n  7\tempty 32 -> 8\n  8\tempty 1 -> 9\n  9\tmatch\n")
  check_all("\\Q.*\\E", 212, "str{.*}", "\\.\\*", "\\.\\*", "  0\tfail\n  1*\trune1 \".\" -> 2\n  2\trune1 \"*\" -> 3\n  3\tmatch\n")
  check_all("(?i:Σ)\\B.[a-c]", 204, "cat{litfold{Σ}nwb{}dot{}cc{0x61-0x63}}", "(?is:Σ\\B.)[a-c]", "(?is:Σ\\B.)[a-c]", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 2\n  2\tempty 32 -> 3\n  3\tany -> 4\n  4\trune \"ac\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("\\w\\p{Greek})x*", 212), "error parsing regexp: unexpected ): `\\w\\p{Greek})x*`"
  check_all("\\x{2a}", 213, "lit{*}", "\\*", "\\*", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\tmatch\n")
  check_all("\\Bab", 196, "cat{nwb{}str{ab}}", "\\Bab", "\\Bab", "  0\tfail\n  1*\tempty 32 -> 2\n  2\trune1 \"a\" -> 3\n  3\trune1 \"b\" -> 4\n  4\tmatch\n")
  check_all("\\z\\Q.*\\Eb", 213, "cat{eot{\\z}strfold{.*B}}", "(?i:\\z\\.\\*B)", "(?i:\\z\\.\\*B)", "  0\tfail\n  1*\tempty 8 -> 2\n  2\trune1 \".\" -> 3\n  3\trune1 \"*\" -> 4\n  4\trune \"B\"/i -> 5\n  5\tmatch\n")
  assert_eq parse_error("(?U)a+[bc{2,}", 213), "error parsing regexp: missing closing ]: `[bc{2,}`"
  assert_eq parse_error("\\8+?{,", 0), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("(.(?-s:.)a", 213), "error parsing regexp: missing closing ): `(.(?-s:.)a`"
  assert_eq parse_error("[", 204), "error parsing regexp: missing closing ]: `[`"
  assert_eq parse_error("x*$(", 0), "error parsing regexp: missing closing ): `x*$(`"
  assert_eq parse_error("\\A([^b]ab\\b", 213), "error parsing regexp: missing closing ): `\\A([^b]ab\\b`"
  check_all("[^\\x00-\\x{10FFFF}]\\B[a-c]", 213, "cat{cc{}nwb{}cc{0x41-0x43 0x61-0x63}}", "[^\\x00-\\x{10FFFF}]\\B[A-Ca-c]", "[^\\x00-\\x{10FFFF}]\\B[A-Ca-c]", "  0\tfail\n  1*\trune \"\" -> 2\n  2\tempty 32 -> 3\n  3\trune \"ACac\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("(?m:^x$)\\Q.*\\E|", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("(?s:.)]\\((?m:^x$)", 212, "cat{dot{}str{](}bol{}lit{x}eol{}}", "(?ms:.\\]\\(^x$)", "(?ms:.\\]\\(^x$)", "  0\tfail\n  1*\tany -> 2\n  2\trune1 \"]\" -> 3\n  3\trune1 \"(\" -> 4\n  4\tempty 1 -> 5\n  5\trune1 \"x\" -> 6\n  6\tempty 2 -> 7\n  7\tmatch\n")
  assert_eq parse_error("(?i:Σ))[^b][α-ω]", 212), "error parsing regexp: unexpected ): `(?i:Σ))[^b][α-ω]`"
  check_all("\\b", 213, "wb{}", "\\b", "\\b", "  0\tfail\n  1*\tempty 16 -> 2\n  2\tmatch\n")
  check_all("\\s", 204, "cc{0x9-0xa 0xc-0xd 0x20}", "[\\t\\n\\f\\r ]", "[\\t\\n\\f\\r ]", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\tmatch\n")
  assert_eq parse_error("[]Kx*", 196), "error parsing regexp: missing closing ]: `[]Kx*`"
  check_all("a{2}", 0, "rep{2,2 lit{a}}", "a{2}", "aa", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"a\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("\\A)(?i)k\\w\\x{2a}", 196), "error parsing regexp: unexpected ): `\\A)(?i)k\\w\\x{2a}`"
  assert_eq parse_error("\\C", 204), "error parsing regexp: invalid escape sequence: `\\C`"
}

test "random parse 43" {
  check_all("(?U)a+\\w*\\Q.*\\E", 196, "cat{nplus{lit{a}}nstar{cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}}str{.*}}", "a+?[0-9A-Z_a-z]*?\\.\\*", "a+?[0-9A-Z_a-z]*?\\.\\*", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\talt -> 4, 1\n  3\trune \"09AZ__az\" -> 4\n  4\talt -> 5, 3\n  5\trune1 \".\" -> 6\n  6\trune1 \"*\" -> 7\n  7\tmatch\n")
  check_all("^", 204, "bol{}", "(?m:^)", "(?m:^)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\tmatch\n")
