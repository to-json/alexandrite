  assert_eq parse_error("\\8]", 0), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("(?P<n>z)a{2}\\pL[\\p{Lu}0-9]\\", 213), "error parsing regexp: trailing backslash at end of expression: ``"
  assert_eq parse_error("(?P<n>z)(?i)k[α-ω][α-ω]", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?i)k\\Pn(?i)k[a-z&&]", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("|]\\z", 212, "alt{emp{}cat{lit{]}eot{\\z}}}", "(?:)|\\]\\z", "(?:)|\\]\\z", "  0\tfail\n  1\tnop -> 5\n  2\trune1 \"]\" -> 3\n  3\tempty 8 -> 5\n  4*\talt -> 1, 2\n  5\tmatch\n")
  check_all("(?m:^x$)\\z", 212, "cat{bol{}lit{x}eol{}eot{\\z}}", "(?m:^x$\\z)", "(?m:^x$\\z)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune1 \"x\" -> 3\n  3\tempty 2 -> 4\n  4\tempty 8 -> 5\n  5\tmatch\n")
  assert_eq parse_error("(?<\\b", 213), "error parsing regexp: invalid named capture: `(?<\\b`"
  check_all("[a-z&&]", 196, "cc{0x26 0x61-0x7a}", "[&a-z]", "[&a-z]", "  0\tfail\n  1*\trune \"&&az\" -> 2\n  2\tmatch\n")
  check_all("[[:alpha:]]b{1,3}(?-s:.)(?U)a+[^\\x00-\\x{10FFFF}]", 204, "cat{cc{0x41-0x5a 0x61-0x7a}rep{1,3 lit{b}}dnl{}nplus{lit{a}}cc{}}", "(?-s:[A-Za-z]b{1,3}.a+?[^\\x00-\\x{10FFFF}])", "(?-s:[A-Za-z]b(?:bb?)?.a+?[^\\x00-\\x{10FFFF}])", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\trune1 \"b\" -> 6\n  3\trune1 \"b\" -> 5\n  4\trune1 \"b\" -> 7\n  5\talt -> 4, 7\n  6\talt -> 3, 7\n  7\tanynotnl -> 8\n  8\trune1 \"a\" -> 9\n  9\talt -> 10, 8\n 10\trune \"\" -> 11\n 11\tmatch\n")
  assert_eq parse_error("Kx{1001}a{2}", 213), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("a{2}\\s", 0), "error parsing regexp: invalid escape sequence: `\\s`"
  check_all("K*[^\\x00-\\x{10FFFF}]", 196, "cat{star{lit{K}}cc{}}", "K*[^\\x00-\\x{10FFFF}]", "K*[^\\x00-\\x{10FFFF}]", "  0\tfail\n  1\trune1 \"K\" -> 2\n  2*\talt -> 1, 3\n  3\trune \"\" -> 4\n  4\tmatch\n")
}

test "random parse 24" {
  assert_eq parse_error("[[:alpha:]]x{1001}(?P<n>z)(?i:Σ)", 213), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("[a-c]((?i)k(?U)a+", 212), "error parsing regexp: missing closing ): `[a-c]((?i)k(?U)a+`"
  assert_eq parse_error("a{2}ab\\Q.*\\E(", 0), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("a{2}\\C\\s[a-z&&]", 0), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("|éc{2,}", 213, "alt{emp{}cat{litfold{É}rep{2,-1 litfold{C}}}}", "(?i:(?:)|ÉC{2,})", "(?i:(?:)|ÉCC+)", "  0\tfail\n  1\tnop -> 7\n  2\trune \"\\u00c9\"/i -> 3\n  3\trune \"C\"/i -> 4\n  4\trune \"C\"/i -> 5\n  5\talt -> 4, 7\n  6*\talt -> 1, 2\n  7\tmatch\n")
  assert_eq parse_error("[\\p{Lu}0-9]Kſ", 0), "error parsing regexp: invalid escape sequence: `\\p`"
  assert_eq parse_error("\\Pn)(a|b)c{2,}(?m:^x$)", 0), "error parsing regexp: invalid escape sequence: `\\P`"
  assert_eq parse_error("(?-s:.).\\8", 204), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("日本(?<x{1001}a{2}", 204), "error parsing regexp: invalid named capture: `(?<x{1001}a{2}`"
  assert_eq parse_error("x{1001}", 212), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("(?i:Σ)\\\\b", 212, "cat{litfold{Σ}str{\\b}}", "(?i:Σ)\\\\b", "(?i:Σ)\\\\b", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 2\n  2\trune1 \"\\\\\" -> 3\n  3\trune1 \"b\" -> 4\n  4\tmatch\n")
  check_all(".", 204, "dot{}", "(?s:.)", "(?s:.)", "  0\tfail\n  1*\tany -> 2\n  2\tmatch\n")
  check_all("[a-z&&]", 196, "cc{0x26 0x61-0x7a}", "[&a-z]", "[&a-z]", "  0\tfail\n  1*\trune \"&&az\" -> 2\n  2\tmatch\n")
  check_all("\\x{2a}(a|b)c{2,}.", 196, "cat{lit{*}cap{cc{0x61-0x62}}rep{2,-1 lit{c}}dnl{}}", "(?-s:\\*([ab])c{2,}.)", "(?-s:\\*([ab])cc+.)", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\tcap 2 -> 3\n  3\trune \"ab\" -> 4\n  4\tcap 3 -> 5\n  5\trune1 \"c\" -> 6\n  6\trune1 \"c\" -> 7\n  7\talt -> 6, 8\n  8\tanynotnl -> 9\n  9\tmatch\n")
  assert_eq parse_error("{,(?<", 204), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
  assert_eq parse_error("[α-ω](", 0), "error parsing regexp: missing closing ): `[α-ω](`"
  assert_eq parse_error("$(", 204), "error parsing regexp: missing closing ): `$(`"
  assert_eq parse_error("(bb{1,3}", 212), "error parsing regexp: missing closing ): `(bb{1,3}`"
  check_all("\\ab(?U)a+", 196, "cat{str{\x07b}nplus{lit{a}}}", "\\aba+?", "\\aba+?", "  0\tfail\n  1*\trune1 \"\\a\" -> 2\n  2\trune1 \"b\" -> 3\n  3\trune1 \"a\" -> 4\n  4\talt -> 5, 3\n  5\tmatch\n")
  check_all("^[^b]", 196, "cat{bol{}cc{0x0-0x61 0x63-0x10ffff}}", "(?m:^[^b])", "(?m:^[^b])", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune \"\\x00ac\\U0010ffff\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("\\Q.*\\E[[:alpha:]]\\p{Greek}\\w\\b", 0), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error(")", 0), "error parsing regexp: unexpected ): `)`"
