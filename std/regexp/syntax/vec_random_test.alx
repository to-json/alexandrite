fb0\\U00011fb0\\U00012000\\U00012399\\U00012480\\U00012543\\U00012f90\\U00012ff0\\U00013000\\U0001342f\\U00013441\\U00013446\\U00013460\\U000143fa\\U00014400\\U00014646\\U00016100\\U0001611d\\U00016800\\U00016a38\\U00016a40\\U00016a5e\\U00016a70\\U00016abe\\U00016ad0\\U00016aed\\U00016b00\\U00016b2f\\U00016b40\\U00016b43\\U00016b63\\U00016b77\\U00016b7d\\U00016b8f\\U00016d40\\U00016d6c\\U00016e40\\U00016e7f\\U00016ea0\\U00016eb8\\U00016ebb\\U00016ed3\\U00016f00\\U00016f4a\\U00016f50\\U00016f50\\U00016f93\\U00016f9f\\U00016fe0\\U00016fe1\\U00016fe3\\U00016fe3\\U00016ff2\\U00016ff3\\U00017000\\U00018cd5\\U00018cff\\U00018d1e\\U00018d80\\U00018df2\\U0001aff0\\U0001aff3\\U0001aff5\\U0001affb\\U0001affd\\U0001affe\\U0001b000\\U0001b122\\U0001b132\\U0001b132\\U0001b150\\U0001b152\\U0001b155\\U0001b155\\U0001b164\\U0001b167\\U0001b170\\U0001b2fb\\U0001bc00\\U0001bc6a\\U0001bc70\\U0001bc7c\\U0001bc80\\U0001bc88\\U0001bc90\\U0001bc99\\U0001d400\\U0001d454\\U0001d456\\U0001d49c\\U0001d49e\\U0001d49f\\U0001d4a2\\U0001d4a2\\U0001d4a5\\U0001d4a6\\U0001d4a9\\U0001d4ac\\U0001d4ae\\U0001d4b9\\U0001d4bb\\U0001d4bb\\U0001d4bd\\U0001d4c3\\U0001d4c5\\U0001d505\\U0001d507\\U0001d50a\\U0001d50d\\U0001d514\\U0001d516\\U0001d51c\\U0001d51e\\U0001d539\\U0001d53b\\U0001d53e\\U0001d540\\U0001d544\\U0001d546\\U0001d546\\U0001d54a\\U0001d550\\U0001d552\\U0001d6a5\\U0001d6a8\\U0001d6c0\\U0001d6c2\\U0001d6da\\U0001d6dc\\U0001d6fa\\U0001d6fc\\U0001d714\\U0001d716\\U0001d734\\U0001d736\\U0001d74e\\U0001d750\\U0001d76e\\U0001d770\\U0001d788\\U0001d78a\\U0001d7a8\\U0001d7aa\\U0001d7c2\\U0001d7c4\\U0001d7cb\\U0001df00\\U0001df1e\\U0001df25\\U0001df2a\\U0001e030\\U0001e06d\\U0001e100\\U0001e12c\\U0001e137\\U0001e13d\\U0001e14e\\U0001e14e\\U0001e290\\U0001e2ad\\U0001e2c0\\U0001e2eb\\U0001e4d0\\U0001e4eb\\U0001e5d0\\U0001e5ed\\U0001e5f0\\U0001e5f0\\U0001e6c0\\U0001e6de\\U0001e6e0\\U0001e6e2\\U0001e6e4\\U0001e6e5\\U0001e6e7\\U0001e6ed\\U0001e6f0\\U0001e6f4\\U0001e6fe\\U0001e6ff\\U0001e7e0\\U0001e7e6\\U0001e7e8\\U0001e7eb\\U0001e7ed\\U0001e7ee\\U0001e7f0\\U0001e7fe\\U0001e800\\U0001e8c4\\U0001e900\\U0001e943\\U0001e94b\\U0001e94b\\U0001ee00\\U0001ee03\\U0001ee05\\U0001ee1f\\U0001ee21\\U0001ee22\\U0001ee24\\U0001ee24\\U0001ee27\\U0001ee27\\U0001ee29\\U0001ee32\\U0001ee34\\U0001ee37\\U0001ee39\\U0001ee39\\U0001ee3b\\U0001ee3b\\U0001ee42\\U0001ee42\\U0001ee47\\U0001ee47\\U0001ee49\\U0001ee49\\U0001ee4b\\U0001ee4b\\U0001ee4d\\U0001ee4f\\U0001ee51\\U0001ee52\\U0001ee54\\U0001ee54\\U0001ee57\\U0001ee57\\U0001ee59\\U0001ee59\\U0001ee5b\\U0001ee5b\\U0001ee5d\\U0001ee5d\\U0001ee5f\\U0001ee5f\\U0001ee61\\U0001ee62\\U0001ee64\\U0001ee64\\U0001ee67\\U0001ee6a\\U0001ee6c\\U0001ee72\\U0001ee74\\U0001ee77\\U0001ee79\\U0001ee7c\\U0001ee7e\\U0001ee7e\\U0001ee80\\U0001ee89\\U0001ee8b\\U0001ee9b\\U0001eea1\\U0001eea3\\U0001eea5\\U0001eea9\\U0001eeab\\U0001eebb\\U00020000\\U0002a6df\\U0002a700\\U0002b81d\\U0002b820\\U0002cead\\U0002ceb0\\U0002ebe0\\U0002ebf0\\U0002ee5d\\U0002f800\\U0002fa1d\\U00030000\\U0003134a\\U00031350\\U00033479\" -> 2\n  2\trune \"\\u03a3\"/i -> 3\n  3\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 4\n  4\tempty 16 -> 5\n  5\tmatch\n")
  check_all("{,", 212, "str{{,}", "\\{,", "\\{,", "  0\tfail\n  1*\trune1 \"{\" -> 2\n  2\trune1 \",\" -> 3\n  3\tmatch\n")
  check_all("[[:alpha:]]", 213, "cc{0x41-0x5a 0x61-0x7a 0x17f 0x212a}", "[A-Za-zſK]", "[A-Za-zſK]", "  0\tfail\n  1*\trune \"AZaz\\u017f\\u017f\\u212a\\u212a\" -> 2\n  2\tmatch\n")
  check_all("[[:alpha:]](a|b)", 212, "cat{cc{0x41-0x5a 0x61-0x7a}cap{cc{0x61-0x62}}}", "[A-Za-z]([ab])", "[A-Za-z]([ab])", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\tcap 2 -> 3\n  3\trune \"ab\" -> 4\n  4\tcap 3 -> 5\n  5\tmatch\n")
  check_all("[^b][[:alpha:]]", 212, "cat{cc{0x0-0x61 0x63-0x10ffff}cc{0x41-0x5a 0x61-0x7a}}", "[^b][A-Za-z]", "[^b][A-Za-z]", "  0\tfail\n  1*\trune \"\\x00ac\\U0010ffff\" -> 2\n  2\trune \"AZaz\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("é\\Q.*\\E(?<[\\p{Lu}0-9]", 0), "error parsing regexp: invalid escape sequence: `\\Q`"
  check_all("日本\\w", 212, "cat{str{日本}cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}}", "日本[0-9A-Z_a-z]", "日本[0-9A-Z_a-z]", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\trune \"09AZ__az\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("\\s日本(?m:^x$)", 0), "error parsing regexp: invalid escape sequence: `\\s`"
  check_all("[a-c]\\w\\x{2a}+?", 213, "cat{cc{0x41-0x43 0x61-0x63}cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a 0x17f 0x212a}nplus{lit{*}}}", "[A-Ca-c][0-9A-Z_a-zſK]\\*+?", "[A-Ca-c][0-9A-Z_a-zſK]\\*+?", "  0\tfail\n  1*\trune \"ACac\" -> 2\n  2\trune \"09AZ__az\\u017f\\u017f\\u212a\\u212a\" -> 3\n  3\trune1 \"*\" -> 4\n  4\talt -> 5, 3\n  5\tmatch\n")
  check_all("$日本(a|b)", 204, "cat{eol{}str{日本}cap{cc{0x61-0x62}}}", "(?m:$日本([ab]))", "(?m:$日本([ab]))", "  0\tfail\n  1*\tempty 2 -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 4\n  4\tcap 2 -> 5\n  5\trune \"ab\" -> 6\n  6\tcap 3 -> 7\n  7\tmatch\n")
  check_all("日本éb", 213, "strfold{日本ÉB}", "(?i:日本ÉB)", "(?i:日本ÉB)", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\trune \"\\u00c9\"/i -> 4\n  4\trune \"B\"/i -> 5\n  5\tmatch\n")
  check_all("\\wſé", 204, "cat{cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}str{ſé}}", "[0-9A-Z_a-z]ſé", "[0-9A-Z_a-z]ſé", "  0\tfail\n  1*\trune \"09AZ__az\" -> 2\n  2\trune1 \"\\u017f\" -> 3\n  3\trune1 \"\\u00e9\" -> 4\n  4\tmatch\n")
}

test "random parse 16" {
  assert_eq parse_error("\\Pn\\d(?U)a+K", 0), "error parsing regexp: invalid escape sequence: `\\P`"
  check_all("(?m:^x$)\\.$", 196, "cat{bol{}lit{x}eol{}lit{.}eol{}}", "(?m:^x$\\.$)", "(?m:^x$\\.$)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune1 \"x\" -> 3\n  3\tempty 2 -> 4\n  4\trune1 \".\" -> 5\n  5\tempty 2 -> 6\n  6\tmatch\n")
  check_all("[α-ω]", 213, "cc{0xb5 0x345 0x391-0x3a1 0x3a3-0x3a9 0x3b1-0x3c9 0x3d0-0x3d1 0x3d5-0x3d6 0x3f0-0x3f1 0x3f4-0x3f5 0x1fbe 0x2126}", "[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ]", "[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ]", "  0\tfail\n  1*\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0391\\u03a1\\u03a3\\u03a9\\u03b1\\u03c9\\u03d0\\u03d1\\u03d5\\u03d6\\u03f0\\u03f1\\u03f4\\u03f5\\u1fbe\\u1fbe\\u2126\\u2126\" -> 2\n  2\tmatch\n")
  check_all("^x*[^\\x00-\\x{10FFFF}]", 0, "cat{bol{}star{lit{x}}cc{}}", "(?m:^x*[^\\x00-\\x{10FFFF}])", "(?m:^x*[^\\x00-\\x{10FFFF}])", "  0\tfail\n  1*\tempty 1 -> 3\n  2\trune1 \"x\" -> 3\n  3\talt -> 2, 4\n  4\trune \"\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("](?m:^x$)|]", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error(")\\pL*\\zx{1001}", 0), "error parsing regexp: unexpected ): `)\\pL*\\zx{1001}`"
  check_all("(?m:^x$)[a-z&&]", 196, "cat{bol{}lit{x}eol{}cc{0x26 0x61-0x7a}}", "(?m:^x$[&a-z])", "(?m:^x$[&a-z])", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune1 \"x\" -> 3\n  3\tempty 2 -> 4\n  4\trune \"&&az\" -> 5\n  5\tmatch\n")
