  assert_eq parse_error("\\w(?s:.)x{1001}\\b(", 196), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("日本", 196, "str{日本}", "日本", "日本", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\tmatch\n")
  check_all("ſ[^b]", 204, "cat{lit{ſ}cc{0x0-0x61 0x63-0x10ffff}}", "ſ[^b]", "ſ[^b]", "  0\tfail\n  1*\trune1 \"\\u017f\" -> 2\n  2\trune \"\\x00ac\\U0010ffff\" -> 3\n  3\tmatch\n")
  check_all("[^\\x00-\\x{10FFFF}]|ab", 212, "alt{cc{}str{ab}}", "[^\\x00-\\x{10FFFF}]|ab", "[^\\x00-\\x{10FFFF}]|ab", "  0\tfail\n  1\trune \"\" -> 5\n  2\trune1 \"a\" -> 3\n  3\trune1 \"b\" -> 5\n  4*\talt -> 1, 2\n  5\tmatch\n")
  assert_eq parse_error("*[α-ω]", 212), "error parsing regexp: missing argument to repetition operator: `*`"
