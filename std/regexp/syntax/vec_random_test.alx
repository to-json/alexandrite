  assert_eq parse_error("(?<[α-ω]\\", 213), "error parsing regexp: invalid named capture: `(?<[α-ω]\\`"
  assert_eq parse_error("\\Q.*\\E[^b]\\C\\s\\s", 0), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("\\Q.*\\Ex*K", 0), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("[a-z&&]x{1001}[^b]b", 212), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("(?<(?i)kb{1,3}\\8K", 196), "error parsing regexp: invalid named capture: `(?<(?i)kb{1,3}\\8K`"
  check_all("^", 204, "bol{}", "(?m:^)", "(?m:^)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\tmatch\n")
  assert_eq parse_error("x{1001}b{1,3}\\B*", 213), "error parsing regexp: invalid repeat count: `{1001}`"
