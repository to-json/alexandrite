  check_all("ac{2,}", 196, "cat{lit{a}rep{2,-1 lit{c}}}", "ac{2,}", "acc+", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"c\" -> 3\n  3\trune1 \"c\" -> 4\n  4\talt -> 3, 5\n  5\tmatch\n")
  assert_eq parse_error("[[:alpha:]]\\", 196), "error parsing regexp: trailing backslash at end of expression: ``"
  check_all("\\s\\Q.*\\E\\x{2a}", 204, "cat{cc{0x9-0xa 0xc-0xd 0x20}str{.**}}", "[\\t\\n\\f\\r ]\\.\\*\\*", "[\\t\\n\\f\\r ]\\.\\*\\*", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\trune1 \".\" -> 3\n  3\trune1 \"*\" -> 4\n  4\trune1 \"*\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("[\\p{Lu}0-9]c{2,}\\C", 0), "error parsing regexp: invalid escape sequence: `\\p`"
  assert_eq parse_error("[[:alpha:]](", 212), "error parsing regexp: missing closing ): `[[:alpha:]](`"
  check_all("[[:alpha:]](?s:.)[a-c]", 196, "cat{cc{0x41-0x5a 0x61-0x7a}dot{}cc{0x61-0x63}}", "(?s:[A-Za-z].[a-c])", "(?s:[A-Za-z].[a-c])", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\tany -> 3\n  3\trune \"ac\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("\\p{Greek}\\w", 0), "error parsing regexp: invalid escape sequence: `\\p`"
  assert_eq parse_error("+?", 0), "error parsing regexp: missing argument to repetition operator: `+`"
  check_all("](?i:Σ)[α-ω]\\x{2a}", 196, "cat{lit{]}litfold{Σ}cc{0x3b1-0x3c9}lit{*}}", "\\](?i:Σ)[α-ω]\\*", "\\](?i:Σ)[α-ω]\\*", "  0\tfail\n  1*\trune1 \"]\" -> 2\n  2\trune \"\\u03a3\"/i -> 3\n  3\trune \"\\u03b1\\u03c9\" -> 4\n  4\trune1 \"*\" -> 5\n  5\tmatch\n")
}

