  check_all("^\\d(?i)k", 213, "cat{bot{}cc{0x30-0x39}litfold{K}}", "(?i:\\A[0-9]K)", "(?i:\\A[0-9]K)", "  0\tfail\n  1*\tempty 4 -> 2\n  2\trune \"09\" -> 3\n  3\trune \"K\"/i -> 4\n  4\tmatch\n")
