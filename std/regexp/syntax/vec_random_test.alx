  check_all("\\s\\p{Greek}", 213, "cat{cc{0x9-0xa 0xc-0xd 0x20}cc{0xb5 0x345 0x370-0x373 0x375-0x377 0x37a-0x37d 0x37f 0x384 0x386 0x388-0x38a 0x38c 0x38e-0x3a1 0x3a3-0x3e1 0x3f0-0x3ff 0x1d26-0x1d2a 0x1d5d-0x1d61 0x1d66-0x1d6a 0x1dbf 0x1f00-0x1f15 0x1f18-0x1f1d 0x1f20-0x1f45 0x1f48-0x1f4d 0x1f50-0x1f57 0x1f59 0x1f5b 0x1f5d 0x1f5f-0x1f7d 0x1f80-0x1fb4 0x1fb6-0x1fc4 0x1fc6-0x1fd3 0x1fd6-0x1fdb 0x1fdd-0x1fef 0x1ff2-0x1ff4 0x1ff6-0x1ffe 0x2126 0xab65 0x10140-0x1018e 0x101a0 0x1d200-0x1d245}}", "[\\t\\n\\f\\r ][µͅͰ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]", "[\\t\\n\\f\\r ][µͅͰ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 3\n  3\tmatch\n")
  check_all("[[:alpha:]]\\A[^b]*", 204, "cat{cc{0x41-0x5a 0x61-0x7a}bot{}star{cc{0x0-0x61 0x63-0x10ffff}}}", "[A-Za-z]\\A[^b]*", "[A-Za-z]\\A[^b]*", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\tempty 4 -> 4\n  3\trune \"\\x00ac\\U0010ffff\" -> 4\n  4\talt -> 3, 5\n  5\tmatch\n")
  check_all("]K", 213, "strfold{]K}", "(?i:\\]K)", "(?i:\\]K)", "  0\tfail\n  1*\trune1 \"]\" -> 2\n  2\trune \"K\"/i -> 3\n  3\tmatch\n")
  assert_eq parse_error("{,x*\\s", 0), "error parsing regexp: invalid escape sequence: `\\s`"
  assert_eq parse_error("*", 212), "error parsing regexp: missing argument to repetition operator: `*`"
  check_all("Kx*", 204, "cat{lit{K}star{lit{x}}}", "Kx*", "Kx*", "  0\tfail\n  1*\trune1 \"K\" -> 3\n  2\trune1 \"x\" -> 3\n  3\talt -> 2, 4\n  4\tmatch\n")
}

test "random parse 23" {
  assert_eq parse_error("(?s:.)c{2,}([a-c]+?", 196), "error parsing regexp: missing closing ): `(?s:.)c{2,}([a-c]+?`"
  assert_eq parse_error("\\", 204), "error parsing regexp: trailing backslash at end of expression: ``"
  assert_eq parse_error("x{1001}ababſ[", 212), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("(?m:^x$)](?m:^x$)", 213, "cat{bol{}litfold{X}eol{}lit{]}bol{}litfold{X}eol{}}", "(?im:^X$\\]^X$)", "(?im:^X$\\]^X$)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune \"X\"/i -> 3\n  3\tempty 2 -> 4\n  4\trune1 \"]\" -> 5\n  5\tempty 1 -> 6\n  6\trune \"X\"/i -> 7\n  7\tempty 2 -> 8\n  8\tmatch\n")
  assert_eq parse_error("\\B日本(?U)a+(?<b", 196), "error parsing regexp: invalid named capture: `(?<b`"
  assert_eq parse_error("[[:alpha:]]\\C(", 213), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error(")\\Q.*\\E\\Q.*\\E]", 204), "error parsing regexp: unexpected ): `)\\Q.*\\E\\Q.*\\E]`"
  check_all("$K\\bé", 204, "cat{eol{}lit{K}wb{}lit{é}}", "(?m:$K\\bé)", "(?m:$K\\bé)", "  0\tfail\n  1*\tempty 2 -> 2\n  2\trune1 \"K\" -> 3\n  3\tempty 16 -> 4\n  4\trune1 \"\\u00e9\" -> 5\n  5\tmatch\n")
  check_all("(?i:Σ)[^\\x00-\\x{10FFFF}]K[^b]", 212, "cat{litfold{Σ}cc{}lit{K}cc{0x0-0x61 0x63-0x10ffff}}", "(?i:Σ)[^\\x00-\\x{10FFFF}]K[^b]", "(?i:Σ)[^\\x00-\\x{10FFFF}]K[^b]", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 2\n  2\trune \"\" -> 3\n  3\trune1 \"K\" -> 4\n  4\trune \"\\x00ac\\U0010ffff\" -> 5\n  5\tmatch\n")
  check_all("\\p{Greek}{,[^b]", 212, "cat{cc{0x370-0x373 0x375-0x377 0x37a-0x37d 0x37f 0x384 0x386 0x388-0x38a 0x38c 0x38e-0x3a1 0x3a3-0x3e1 0x3f0-0x3ff 0x1d26-0x1d2a 0x1d5d-0x1d61 0x1d66-0x1d6a 0x1dbf 0x1f00-0x1f15 0x1f18-0x1f1d 0x1f20-0x1f45 0x1f48-0x1f4d 0x1f50-0x1f57 0x1f59 0x1f5b 0x1f5d 0x1f5f-0x1f7d 0x1f80-0x1fb4 0x1fb6-0x1fc4 0x1fc6-0x1fd3 0x1fd6-0x1fdb 0x1fdd-0x1fef 0x1ff2-0x1ff4 0x1ff6-0x1ffe 0x2126 0xab65 0x10140-0x1018e 0x101a0 0x1d200-0x1d245}str{{,}cc{0x0-0x61 0x63-0x10ffff}}", "[Ͱ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]\\{,[^b]", "[Ͱ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]\\{,[^b]", "  0\tfail\n  1*\trune \"\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 2\n  2\trune1 \"{\" -> 3\n  3\trune1 \",\" -> 4\n  4\trune \"\\x00ac\\U0010ffff\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("[\\p{Lu}0-9](?<\\Q.*\\E", 212), "error parsing regexp: invalid named capture: `(?<\\Q.*\\E`"
  check_all("ſ{,", 204, "str{ſ{,}", "ſ\\{,", "ſ\\{,", "  0\tfail\n  1*\trune1 \"\\u017f\" -> 2\n  2\trune1 \"{\" -> 3\n  3\trune1 \",\" -> 4\n  4\tmatch\n")
  check_all("a{2}", 196, "rep{2,2 lit{a}}", "a{2}", "aa", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"a\" -> 3\n  3\tmatch\n")
  check_all("(?P<n>z)", 212, "cap{n:lit{z}}", "(?P<n>z)", "(?P<n>z)", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"z\" -> 3\n  3\tcap 3 -> 4\n  4\tmatch\n")
  check_all("{,", 0, "str{{,}", "\\{,", "\\{,", "  0\tfail\n  1*\trune1 \"{\" -> 2\n  2\trune1 \",\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("\\8\\d|", 212), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("\\B(?<", 0), "error parsing regexp: invalid escape sequence: `\\B`"
