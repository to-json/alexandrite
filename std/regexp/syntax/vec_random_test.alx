U00011a00\\U00011a00\\U00011a0b\\U00011a32\\U00011a3a\\U00011a3a\\U00011a50\\U00011a50\\U00011a5c\\U00011a89\\U00011a9d\\U00011a9d\\U00011ab0\\U00011af8\\U00011bc0\\U00011be0\\U00011c00\\U00011c08\\U00011c0a\\U00011c2e\\U00011c40\\U00011c40\\U00011c72\\U00011c8f\\U00011d00\\U00011d06\\U00011d08\\U00011d09\\U00011d0b\\U00011d30\\U00011d46\\U00011d46\\U00011d60\\U00011d65\\U00011d67\\U00011d68\\U00011d6a\\U00011d89\\U00011d98\\U00011d98\\U00011db0\\U00011ddb\\U00011ee0\\U00011ef2\\U00011f02\\U00011f02\\U00011f04\\U00011f10\\U00011f12\\U00011f33\\U00011fb0\\U00011fb0\\U00012000\\U00012399\\U00012480\\U00012543\\U00012f90\\U00012ff0\\U00013000\\U0001342f\\U00013441\\U00013446\\U00013460\\U000143fa\\U00014400\\U00014646\\U00016100\\U0001611d\\U00016800\\U00016a38\\U00016a40\\U00016a5e\\U00016a70\\U00016abe\\U00016ad0\\U00016aed\\U00016b00\\U00016b2f\\U00016b40\\U00016b43\\U00016b63\\U00016b77\\U00016b7d\\U00016b8f\\U00016d40\\U00016d6c\\U00016e40\\U00016e7f\\U00016ea0\\U00016eb8\\U00016ebb\\U00016ed3\\U00016f00\\U00016f4a\\U00016f50\\U00016f50\\U00016f93\\U00016f9f\\U00016fe0\\U00016fe1\\U00016fe3\\U00016fe3\\U00016ff2\\U00016ff3\\U00017000\\U00018cd5\\U00018cff\\U00018d1e\\U00018d80\\U00018df2\\U0001aff0\\U0001aff3\\U0001aff5\\U0001affb\\U0001affd\\U0001affe\\U0001b000\\U0001b122\\U0001b132\\U0001b132\\U0001b150\\U0001b152\\U0001b155\\U0001b155\\U0001b164\\U0001b167\\U0001b170\\U0001b2fb\\U0001bc00\\U0001bc6a\\U0001bc70\\U0001bc7c\\U0001bc80\\U0001bc88\\U0001bc90\\U0001bc99\\U0001d400\\U0001d454\\U0001d456\\U0001d49c\\U0001d49e\\U0001d49f\\U0001d4a2\\U0001d4a2\\U0001d4a5\\U0001d4a6\\U0001d4a9\\U0001d4ac\\U0001d4ae\\U0001d4b9\\U0001d4bb\\U0001d4bb\\U0001d4bd\\U0001d4c3\\U0001d4c5\\U0001d505\\U0001d507\\U0001d50a\\U0001d50d\\U0001d514\\U0001d516\\U0001d51c\\U0001d51e\\U0001d539\\U0001d53b\\U0001d53e\\U0001d540\\U0001d544\\U0001d546\\U0001d546\\U0001d54a\\U0001d550\\U0001d552\\U0001d6a5\\U0001d6a8\\U0001d6c0\\U0001d6c2\\U0001d6da\\U0001d6dc\\U0001d6fa\\U0001d6fc\\U0001d714\\U0001d716\\U0001d734\\U0001d736\\U0001d74e\\U0001d750\\U0001d76e\\U0001d770\\U0001d788\\U0001d78a\\U0001d7a8\\U0001d7aa\\U0001d7c2\\U0001d7c4\\U0001d7cb\\U0001df00\\U0001df1e\\U0001df25\\U0001df2a\\U0001e030\\U0001e06d\\U0001e100\\U0001e12c\\U0001e137\\U0001e13d\\U0001e14e\\U0001e14e\\U0001e290\\U0001e2ad\\U0001e2c0\\U0001e2eb\\U0001e4d0\\U0001e4eb\\U0001e5d0\\U0001e5ed\\U0001e5f0\\U0001e5f0\\U0001e6c0\\U0001e6de\\U0001e6e0\\U0001e6e2\\U0001e6e4\\U0001e6e5\\U0001e6e7\\U0001e6ed\\U0001e6f0\\U0001e6f4\\U0001e6fe\\U0001e6ff\\U0001e7e0\\U0001e7e6\\U0001e7e8\\U0001e7eb\\U0001e7ed\\U0001e7ee\\U0001e7f0\\U0001e7fe\\U0001e800\\U0001e8c4\\U0001e900\\U0001e943\\U0001e94b\\U0001e94b\\U0001ee00\\U0001ee03\\U0001ee05\\U0001ee1f\\U0001ee21\\U0001ee22\\U0001ee24\\U0001ee24\\U0001ee27\\U0001ee27\\U0001ee29\\U0001ee32\\U0001ee34\\U0001ee37\\U0001ee39\\U0001ee39\\U0001ee3b\\U0001ee3b\\U0001ee42\\U0001ee42\\U0001ee47\\U0001ee47\\U0001ee49\\U0001ee49\\U0001ee4b\\U0001ee4b\\U0001ee4d\\U0001ee4f\\U0001ee51\\U0001ee52\\U0001ee54\\U0001ee54\\U0001ee57\\U0001ee57\\U0001ee59\\U0001ee59\\U0001ee5b\\U0001ee5b\\U0001ee5d\\U0001ee5d\\U0001ee5f\\U0001ee5f\\U0001ee61\\U0001ee62\\U0001ee64\\U0001ee64\\U0001ee67\\U0001ee6a\\U0001ee6c\\U0001ee72\\U0001ee74\\U0001ee77\\U0001ee79\\U0001ee7c\\U0001ee7e\\U0001ee7e\\U0001ee80\\U0001ee89\\U0001ee8b\\U0001ee9b\\U0001eea1\\U0001eea3\\U0001eea5\\U0001eea9\\U0001eeab\\U0001eebb\\U00020000\\U0002a6df\\U0002a700\\U0002b81d\\U0002b820\\U0002cead\\U0002ceb0\\U0002ebe0\\U0002ebf0\\U0002ee5d\\U0002f800\\U0002fa1d\\U00030000\\U0003134a\\U00031350\\U00033479\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("(?<((?i)k\\dſ", 196), "error parsing regexp: invalid named capture: `(?<((?i)k\\dſ`"
  assert_eq parse_error("\\8[\\p{Lu}0-9]\\A(?m:^x$)(?P<n>z)", 212), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("\\s", 212, "cc{0x9-0xa 0xc-0xd 0x20}", "[\\t\\n\\f\\r ]", "[\\t\\n\\f\\r ]", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\tmatch\n")
  check_all("(?-s:.)(?i)kb$", 196, "cat{dnl{}strfold{KB}eol{}}", "(?im-s:.KB$)", "(?im-s:.KB$)", "  0\tfail\n  1*\tanynotnl -> 2\n  2\trune \"K\"/i -> 3\n  3\trune \"B\"/i -> 4\n  4\tempty 2 -> 5\n  5\tmatch\n")
  assert_eq parse_error("*b{1,3}[a-z&&]", 204), "error parsing regexp: missing argument to repetition operator: `*`"
  assert_eq parse_error("(", 212), "error parsing regexp: missing closing ): `(`"
  assert_eq parse_error("\\C(?s:.)(?P<n>z)日本[[:alpha:]]", 204), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("日本[a-c].", 204, "cat{str{日本}cc{0x61-0x63}dot{}}", "(?s:日本[a-c].)", "(?s:日本[a-c].)", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\trune \"ac\" -> 4\n  4\tany -> 5\n  5\tmatch\n")
  assert_eq parse_error("(?<", 196), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
  assert_eq parse_error(")\\(?i)k\\x{2a}[a-c]", 204), "error parsing regexp: unexpected ): `)\\(?i)k\\x{2a}[a-c]`"
  check_all("\\b", 196, "wb{}", "\\b", "\\b", "  0\tfail\n  1*\tempty 16 -> 2\n  2\tmatch\n")
  assert_eq parse_error("^(?<ſſb{1,3}", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("[\\p{Lu}0-9](\\A\\Bx*", 204), "error parsing regexp: missing closing ): `[\\p{Lu}0-9](\\A\\Bx*`"
  assert_eq parse_error("K\\z\\pL[[:alpha:]]", 0), "error parsing regexp: invalid escape sequence: `\\z`"
  assert_eq parse_error(")*", 204), "error parsing regexp: unexpected ): `)*`"
  check_all("$*", 212, "star{eot{}}", "(?-m:$*)", "(?-m:$*)", "  0\tfail\n  1\tempty 8 -> 2\n  2\talt -> 1, 4\n  3*\talt -> 1, 4\n  4\tmatch\n")
  assert_eq parse_error("\\pL{,\\wc{2,}\\8", 196), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("[^\\x00-\\x{10FFFF}](a|b)|(?s:.)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("\\d(a|b)\\(?-s:.)x*", 0), "error parsing regexp: invalid escape sequence: `\\d`"
  check_all("ſK(?i:Σ)ab(?s:.)", 213, "cat{strfold{SKΣAB}dot{}}", "(?is:SKΣAB.)", "(?is:SKΣAB.)", "  0\tfail\n  1*\trune \"S\"/i -> 2\n  2\trune \"K\"/i -> 3\n  3\trune \"\\u03a3\"/i -> 4\n  4\trune \"A\"/i -> 5\n  5\trune \"B\"/i -> 6\n  6\tany -> 7\n  7\tmatch\n")
  check_all("(?U)a+.", 212, "cat{nplus{lit{a}}dnl{}}", "(?-s:a+?.)", "(?-s:a+?.)", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\talt -> 3, 1\n  3\tanynotnl -> 4\n  4\tmatch\n")
  check_all("][α-ω]", 212, "cat{lit{]}cc{0x3b1-0x3c9}}", "\\][α-ω]", "\\][α-ω]", "  0\tfail\n  1*\trune1 \"]\" -> 2\n  2\trune \"\\u03b1\\u03c9\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("[", 204), "error parsing regexp: missing closing ]: `[`"
  assert_eq parse_error("(?m:^x$)\\pL(?<b{1,3}", 213), "error parsing regexp: invalid named capture: `(?<b{1,3}`"
  check_all("(?s:.)", 204, "dot{}", "(?s:.)", "(?s:.)", "  0\tfail\n  1*\tany -> 2\n  2\tmatch\n")
  check_all("a|", 213, "alt{litfold{A}emp{}}", "(?i:A|(?:))", "(?i:A|(?:))", "  0\tfail\n  1\trune \"A\"/i -> 4\n  2\tnop -> 4\n  3*\talt -> 1, 2\n  4\tmatch\n")
  check_all("[α-ω]", 212, "cc{0x3b1-0x3c9}", "[α-ω]", "[α-ω]", "  0\tfail\n  1*\trune \"\\u03b1\\u03c9\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("|\\8(?P<n>z)[α-ω]", 0), "error parsing regexp: invalid escape sequence: `\\8`"
