  check_all("\\x{2a}", 0, "lit{*}", "\\*", "\\*", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\tmatch\n")
  check_all("(?-s:.)*\\s", 212, "cat{star{dnl{}}cc{0x9-0xa 0xc-0xd 0x20}}", "(?-s:.*[\\t\\n\\f\\r ])", "(?-s:.*[\\t\\n\\f\\r ])", "  0\tfail\n  1\tanynotnl -> 2\n  2*\talt -> 1, 3\n  3\trune \"\\t\\n\\f\\r  \" -> 4\n  4\tmatch\n")
  assert_eq parse_error("[\\Pn|ab", 196), "error parsing regexp: missing closing ]: `[\\Pn|ab`"
  check_all("$", 204, "eol{}", "(?m:$)", "(?m:$)", "  0\tfail\n  1*\tempty 2 -> 2\n  2\tmatch\n")
  assert_eq parse_error("(?m:^x$)\\d\\w($", 204), "error parsing regexp: missing closing ): `(?m:^x$)\\d\\w($`"
  assert_eq parse_error("+?\\B(?i:Σ)(?U)a+[\\p{Lu}0-9]", 213), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error("*", 212), "error parsing regexp: missing argument to repetition operator: `*`"
  assert_eq parse_error("x*\\x{2a})\\pL(?<", 204), "error parsing regexp: unexpected ): `x*\\x{2a})\\pL(?<`"
  assert_eq parse_error("\\B(?P<n>z)[^b]b{1,3}", 0), "error parsing regexp: invalid escape sequence: `\\B`"
