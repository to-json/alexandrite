  check_all("\\Pn(?:ab|ac)[^b]", 196, "cat{cc{0x0-0x2f 0x3a-0xb1 0xb4-0xb8 0xba-0xbb 0xbf-0x65f 0x66a-0x6ef 0x6fa-0x7bf 0x7ca-0x965 0x970-0x9e5 0x9f0-0x9f3 0x9fa-0xa65 0xa70-0xae5 0xaf0-0xb65 0xb70-0xb71 0xb78-0xbe5 0xbf3-0xc65 0xc70-0xc77 0xc7f-0xce5 0xcf0-0xd57 0xd5f-0xd65 0xd79-0xde5 0xdf0-0xe4f 0xe5a-0xecf 0xeda-0xf1f 0xf34-0x103f 0x104a-0x108f 0x109a-0x1368 0x137d-0x16ed 0x16f1-0x17df 0x17ea-0x17ef 0x17fa-0x180f 0x181a-0x1945 0x1950-0x19cf 0x19db-0x1a7f 0x1a8a-0x1a8f 0x1a9a-0x1b4f 0x1b5a-0x1baf 0x1bba-0x1c3f 0x1c4a-0x1c4f 0x1c5a-0x206f 0x2071-0x2073 0x207a-0x207f 0x208a-0x214f 0x2183-0x2184 0x218a-0x245f 0x249c-0x24e9 0x2500-0x2775 0x2794-0x2cfc 0x2cfe-0x3006 0x3008-0x3020 0x302a-0x3037 0x303b-0x3191 0x3196-0x321f 0x322a-0x3247 0x3250 0x3260-0x327f 0x328a-0x32b0 0x32c0-0xa61f 0xa62a-0xa6e5 0xa6f0-0xa82f 0xa836-0xa8cf 0xa8da-0xa8ff 0xa90a-0xa9cf 0xa9da-0xa9ef 0xa9fa-0xaa4f 0xaa5a-0xabef 0xabfa-0xff0f 0xff1a-0x10106 0x10134-0x1013f 0x10179-0x10189 0x1018c-0x102e0 0x102fc-0x1031f 0x10324-0x10340 0x10342-0x10349 0x1034b-0x103d0 0x103d6-0x1049f 0x104aa-0x10857 0x10860-0x10878 0x10880-0x108a6 0x108b0-0x108fa 0x10900-0x10915 0x1091c-0x109bb 0x109be-0x109bf 0x109d0-0x109d1 0x10a00-0x10a3f 0x10a49-0x10a7c 0x10a7f-0x10a9c 0x10aa0-0x10aea 0x10af0-0x10b57 0x10b60-0x10b77 0x10b80-0x10ba8 0x10bb0-0x10cf9 0x10d00-0x10d2f 0x10d3a-0x10d3f 0x10d4a-0x10e5f 0x10e7f-0x10f1c 0x10f27-0x10f50 0x10f55-0x10fc4 0x10fcc-0x11051 0x11070-0x110ef 0x110fa-0x11135 0x11140-0x111cf 0x111da-0x111e0 0x111f5-0x112ef 0x112fa-0x1144f 0x1145a-0x114cf 0x114da-0x1164f 0x1165a-0x116bf 0x116ca-0x116cf 0x116e4-0x1172f 0x1173c-0x118df 0x118f3-0x1194f 0x1195a-0x11bef 0x11bfa-0x11c4f 0x11c6d-0x11d4f 0x11d5a-0x11d9f 0x11daa-0x11ddf 0x11dea-0x11f4f 0x11f5a-0x11fbf 0x11fd5-0x123ff 0x1246f-0x1612f 0x1613a-0x16a5f 0x16a6a-0x16abf 0x16aca-0x16b4f 0x16b5a 0x16b62-0x16d6f 0x16d7a-0x16e7f 0x16e97-0x16ff3 0x16ff7-0x1ccef 0x1ccfa-0x1d2bf 0x1d2d4-0x1d2df 0x1d2f4-0x1d35f 0x1d379-0x1d7cd 0x1d800-0x1e13f 0x1e14a-0x1e2ef 0x1