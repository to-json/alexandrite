  assert_eq parse_error("\\C", 196), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("\\B[α-ω]", 196, "cat{nwb{}cc{0x3b1-0x3c9}}", "\\B[α-ω]", "\\B[α-ω]", "  0\tfail\n  1*\tempty 32 -> 2\n  2\trune \"\\u03b1\\u03c9\" -> 3\n  3\tmatch\n")
  check_all(".[(c{2,}[^b]", 213, "cat{dnl{}cc{0x28 0x2c 0x32 0x42-0x43 0x5b 0x5e 0x62-0x63 0x7b 0x7d}}", "(?-s:.[\\(,2BC\\[\\^bc\\{\\}])", "(?-s:.[\\(,2BC\\[\\^bc\\{\\}])", "  0\tfail\n  1*\tanynotnl -> 2\n  2\trune \"((,,22BC[[^^bc{{}}\" -> 3\n  3\tmatch\n")
  check_all("[a-z&&]ab\\sb", 196, "cat{cc{0x26 0x61-0x7a}str{ab}cc{0x9-0xa 0xc-0xd 0x20}lit{b}}", "[&a-z]ab[\\t\\n\\f\\r ]b", "[&a-z]ab[\\t\\n\\f\\r ]b", "  0\tfail\n  1*\trune \"&&az\" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune1 \"b\" -> 4\n  4\trune \"\\t\\n\\f\\r  \" -> 5\n  5\trune1 \"b\" -> 6\n  6\tmatch\n")
}

