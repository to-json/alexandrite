  check_all("(?m:^x$)$\\b", 213, "cat{bol{}litfold{X}eol{}eot{}wb{}}", "(?-m:(?im:^X$)$\\b)", "(?-m:(?im:^X$)$\\b)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune \"X\"/i -> 3\n  3\tempty 2 -> 4\n  4\tempty 8 -> 5\n  5\tempty 16 -> 6\n  6\tmatch\n")
