}

test "random parse 18" {
  check_all("[^b][a-z&&]\\w(?i:Σ)", 196, "cat{cc{0x0-0x61 0x63-0x10ffff}cc{0x26 0x61-0x7a}cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}litfold{Σ}}", "[^b][&a-z][0-9A-Z_a-z](?i:Σ)", "[^b][&a-z][0-9A-Z_a-z](?i:Σ)", "  0\tfail\n  1*\trune \"\\x00ac\\U0010ffff\" -> 2\n  2\trune \"&&az\" -> 3\n  3\trune \"09AZ__az\" -> 4\n  4\trune \"\\u03a3\"/i -> 5\n  5\tmatch\n")
  check_all("(?i:Σ)", 196, "litfold{Σ}", "(?i:Σ)", "(?i:Σ)", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 2\n  2\tmatch\n")
  assert_eq parse_error("+?[\\p{Lu}0-9]", 204), "error parsing regexp: missing argument to repetition operator: `+?`"
