  assert_eq parse_error("(?s:.)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("[a-c]\\8|", 212), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("ſ", 213, "litfold{S}", "(?i:S)", "(?i:S)", "  0\tfail\n  1*\trune \"S\"/i -> 2\n  2\tmatch\n")
  check_all("\\B", 204, "nwb{}", "\\B", "\\B", "  0\tfail\n  1*\tempty 32 -> 2\n  2\tmatch\n")
  assert_eq parse_error("x{1001}", 212), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("(?P<n>z)(?P<n>z)", 204, "cat{cap{n:lit{z}}cap{n:lit{z}}}", "(?P<n>z)(?P<n>z)", "(?P<n>z)(?P<n>z)", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"z\" -> 3\n  3\tcap 3 -> 4\n  4\tcap 4 -> 5\n  5\trune1 \"z\" -> 6\n  6\tcap 5 -> 7\n  7\tmatch\n")
  check_all("^", 204, "bol{}", "(?m:^)", "(?m:^)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\tmatch\n")
  assert_eq parse_error("(?i)k\\pL(?s:.)x{1001}", 213), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("((?i)k+?", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("\\C[α-ω]^", 212), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("(?i)k|(?:ab|ac)(?U)a+", 212, "alt{litfold{K}cat{litfold{A}cc{0x42-0x43 0x62-0x63}nplus{litfold{A}}}}", "(?i:K|A[BCbc]A+?)", "(?i:K|A[BCbc]A+?)", "  0\tfail\n  1\trune \"K\"/i -> 7\n  2\trune \"A\"/i -> 3\n  3\trune \"BCbc\" -> 4\n  4\trune \"A\"/i -> 5\n  5\talt -> 7, 4\n  6*\talt -> 1, 2\n  7\tmatch\n")
  check_all("[a-z&&]$", 0, "cat{cc{0x26 0x61-0x7a}eol{}}", "(?m:[&a-z]$)", "(?m:[&a-z]$)", "  0\tfail\n  1*\trune \"&&az\" -> 2\n  2\tempty 2 -> 3\n  3\tmatch\n")
  assert_eq parse_error("\\8b{1,3}(?<(?-s:.)", 0), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("\\s日本\\s", 196, "cat{cc{0x9-0xa 0xc-0xd 0x20}str{日本}cc{0x9-0xa 0xc-0xd 0x20}}", "[\\t\\n\\f\\r ]日本[\\t\\n\\f\\r ]", "[\\t\\n\\f\\r ]日本[\\t\\n\\f\\r ]", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\trune1 \"\\u65e5\" -> 3\n  3\trune1 \"\\u672c\" -> 4\n  4\trune \"\\t\\n\\f\\r  \" -> 5\n  5\tmatch\n")
  check_all("(?-s:.)", 212, "dnl{}", "(?-s:.)", "(?-s:.)", "  0\tfail\n  1*\tanynotnl -> 2\n  2\tmatch\n")
}

test "random parse 46" {
  check_all("(?m:^x$)", 204, "cat{bol{}lit{x}eol{}}", "(?m:^x$)", "(?m:^x$)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune1 \"x\" -> 3\n  3\tempty 2 -> 4\n  4\tmatch\n")
  check_all("(?P<n>z)[[:alpha:]]+?", 212, "cat{cap{n:lit{z}}nplus{cc{0x41-0x5a 0x61-0x7a}}}", "(?P<n>z)[A-Za-z]+?", "(?P<n>z)[A-Za-z]+?", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"z\" -> 3\n  3\tcap 3 -> 4\n  4\trune \"AZaz\" -> 5\n  5\talt -> 6, 4\n  6\tmatch\n")
  check_all("K", 204, "lit{K}", "K", "K", "  0\tfail\n  1*\trune1 \"K\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("[\\p{Lu}0-9]|+?[a-z&&]{,", 0), "error parsing regexp: invalid escape sequence: `\\p`"
