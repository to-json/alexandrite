  assert_eq parse_error("*", 212), "error parsing regexp: missing argument to repetition operator: `*`"
  check_all("b{1,3}", 212, "rep{1,3 lit{b}}", "b{1,3}", "b(?:bb?)?", "  0\tfail\n  1*\trune1 \"b\" -> 5\n  2\trune1 \"b\" -> 4\n  3\trune1 \"b\" -> 6\n  4\talt -> 3, 6\n  5\talt -> 2, 6\n  6\tmatch\n")
  assert_eq parse_error("(?<\\8ſ\\d", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("\\Q.*\\E(a|b)", 204, "cat{str{.*}cap{cc{0x61-0x62}}}", "\\.\\*([ab])", "\\.\\*([ab])", "  0\tfail\n  1*\trune1 \".\" -> 2\n  2\trune1 \"*\" -> 3\n  3\tcap 2 -> 4\n  4\trune \"ab\" -> 5\n  5\tcap 3 -> 6\n  6\tmatch\n")
  assert_eq parse_error(")\\w", 196), "error parsing regexp: unexpected ): `)\\w`"
  assert_eq parse_error(")\\d\\A+?", 0), "error parsing regexp: unexpected ): `)\\d\\A+?`"
  check_all("日本", 213, "str{日本}", "日本", "日本", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\tmatch\n")
  check_all("\\[\\s(?:ab|ac)ab", 196, "cat{lit{[}cc{0x9-0xa 0xc-0xd 0x20}lit{a}cc{0x62-0x63}str{ab}}", "\\[[\\t\\n\\f\\r ]a[bc]ab", "\\[[\\t\\n\\f\\r ]a[bc]ab", "  0\tfail\n  1*\trune1 \"[\" -> 2\n  2\trune \"\\t\\n\\f\\r  \" -> 3\n  3\trune1 \"a\" -> 4\n  4\trune \"bc\" -> 5\n  5\trune1 \"a\" -> 6\n  6\trune1 \"b\" -> 7\n  7\tmatch\n")
  assert_eq parse_error("\\C", 0), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("日本[^\\x00-\\x{10FFFF}]]", 0, "cat{str{日本}cc{}lit{]}}", "日本[^\\x00-\\x{10FFFF}]\\]", "日本[^\\x00-\\x{10FFFF}]\\]", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\trune \"\" -> 4\n  4\trune1 \"]\" -> 5\n  5\tmatch\n")
  check_all("$\\w(?:ab|ac)a(a|b)", 196, "cat{eol{}cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}lit{a}cc{0x62-0x63}lit{a}cap{cc{0x61-0x62}}}", "(?m:$[0-9A-Z_a-z]a[bc]a([ab]))", "(?m:$[0-9A-Z_a-z]a[bc]a([ab]))", "  0\tfail\n  1*\tempty 2 -> 2\n  2\trune \"09AZ__az\" -> 3\n  3\trune1 \"a\" -> 4\n  4\trune \"bc\" -> 5\n  5\trune1 \"a\" -> 6\n  6\tcap 2 -> 7\n  7\trune \"ab\" -> 8\n  8\tcap 3 -> 9\n  9\tmatch\n")
  assert_eq parse_error("$\\z", 0), "error parsing regexp: invalid escape sequence: `\\z`"
  assert_eq parse_error("(?-s:.)(?i)k\\ſ(?:ab|ac)", 212), "error parsing regexp: invalid escape sequence: `\\ſ`"
  assert_eq parse_error("(?<b{1,3}\\d(?-s:.)", 212), "error parsing regexp: invalid named capture: `(?<b{1,3}\\d(?-s:.)`"
  assert_eq parse_error("(?:ab|ac)(?<", 212), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
  check_all("b{1,3}c{2,}\\wc{2,}", 196, "cat{rep{1,3 lit{b}}rep{2,-1 lit{c}}cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a}rep{2,-1 lit{c}}}", "b{1,3}c{2,}[0-9A-Z_a-z]c{2,}", "b(?:bb?)?cc+[0-9A-Z_a-z]cc+", "  0\tfail\n  1*\trune1 \"b\" -> 5\n  2\trune1 \"b\" -> 4\n  3\trune1 \"b\" -> 6\n  4\talt -> 3, 6\n  5\talt -> 2, 6\n  6\trune1 \"c\" -> 7\n  7\trune1 \"c\" -> 8\n  8\talt -> 7, 9\n  9\trune \"09AZ__az\" -> 10\n 10\trune1 \"c\" -> 11\n 11\trune1 \"c\" -> 12\n 12\talt -> 11, 13\n 13\tmatch\n")
  assert_eq parse_error("|(", 196), "error parsing regexp: missing closing ): `|(`"
  check_all("[[:alpha:]]", 204, "cc{0x41-0x5a 0x61-0x7a}", "[A-Za-z]", "[A-Za-z]", "  0\tfail\n  1*\trune \"AZaz\" -> 2\n  2\tmatch\n")
  check_all("^a{2}", 213, "cat{bot{}rep{2,2 litfold{A}}}", "(?i:\\AA{2})", "(?i:\\AAA)", "  0\tfail\n  1*\tempty 4 -> 2\n  2\trune \"A\"/i -> 3\n  3\trune \"A\"/i -> 4\n  4\tmatch\n")
  check_all("(a|b)ab\\s", 212, "cat{cap{cc{0x61-0x62}}str{ab}cc{0x9-0xa 0xc-0xd 0x20}}", "([ab])ab[\\t\\n\\f\\r ]", "([ab])ab[\\t\\n\\f\\r ]", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune \"ab\" -> 3\n  3\tcap 3 -> 4\n  4\trune1 \"a\" -> 5\n  5\trune1 \"b\" -> 6\n  6\trune \"\\t\\n\\f\\r  \" -> 7\n  7\tmatch\n")
  assert_eq parse_error(")", 204), "error parsing regexp: unexpected ): `)`"
  check_all("K", 212, "lit{K}", "K", "K", "  0\tfail\n  1*\trune1 \"K\" -> 2\n  2\tmatch\n")
}

