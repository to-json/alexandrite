  check_all("^(?i)k\\b(?i:Σ)\\A", 212, "cat{bot{}litfold{K}wb{}litfold{Σ}bot{}}", "(?i:\\AK\\bΣ\\A)", "(?i:\\AK\\bΣ\\A)", "  0\tfail\n  1*\tempty 4 -> 2\n  2\trune \"K\"/i -> 3\n  3\tempty 16 -> 4\n  4\trune \"\\u03a3\"/i -> 5\n  5\tempty 4 -> 6\n  6\tmatch\n")
  assert_eq parse_error("\\b{,\\8K", 196), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("[α-ω]\\da(a|b)", 196, "cat{cc{0x3b1-0x3c9}cc{0x30-0x39}lit{a}cap{cc{0x61-0x62}}}", "[α-ω][0-9]a([ab])", "[α-ω][0-9]a([ab])", "  0\tfail\n  1*\trune \"\\u03b1\\u03c9\" -> 2\n  2\trune \"09\" -> 3\n  3\trune1 \"a\" -> 4\n  4\tcap 2 -> 5\n  5\trune \"ab\" -> 6\n  6\tcap 3 -> 7\n  7\tmatch\n")
  assert_eq parse_error("x*\\8\\]", 204), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("éKé", 0, "str{éKé}", "éKé", "éKé", "  0\tfail\n  1*\trune1 \"\\u00e9\" -> 2\n  2\trune1 \"K\" -> 3\n  3\trune1 \"\\u00e9\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("\\b[$ſ", 0), "error parsing regexp: invalid escape sequence: `\\b`"
  check_all("c{2,}K", 204, "cat{rep{2,-1 lit{c}}lit{K}}", "c{2,}K", "cc+K", "  0\tfail\n  1*\trune1 \"c\" -> 2\n  2\trune1 \"c\" -> 3\n  3\talt -> 2, 4\n  4\trune1 \"K\" -> 5\n  5\tmatch\n")
  check_all("a{2}", 0, "rep{2,2 lit{a}}", "a{2}", "aa", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"a\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("x{1001}x*(?-s:.)^", 204), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("\\", 213), "error parsing regexp: trailing backslash at end of expression: ``"
  check_all("\\x{2a}", 0, "lit{*}", "\\*", "\\*", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\tmatch\n")
  check_all("(?s:.)\\p{Greek}", 213, "cat{dot{}cc{0xb5 0x345 0x370-0x373 0x375-0x377 0x37a-0x37d 0x37f 0x384 0x386 0x388-0x38a 0x38c 0x38e-0x3a1 0x3a3-0x3e1 0x3f0-0x3ff 0x1d26-0x1d2a 0x1d5d-0x1d61 0x1d66-0x1d6a 0x1dbf 0x1f00-0x1f15 0x1f18-0x1f1d 0x1f20-0x1f45 0x1f48-0x1f4d 0x1f50-0x1f57 0x1f59 0x1f5b 0x1f5d 0x1f5f-0x1f7d 0x1f80-0x1fb4 0x1fb6-0x1fc4 0x1fc6-0x1fd3 0x1fd6-0x1fdb 0x1fdd-0x1fef 0x1ff2-0x1ff4 0x1ff6-0x1ffe 0x2126 0xab65 0x10140-0x1018e 0x101a0 0x1d200-0x1d245}}", "(?s:.[µͅͰ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅])", "(?s:.[µͅͰ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅])", "  0\tfail\n  1*\tany -> 2\n  2\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 3\n  3\tmatch\n")
  assert_eq parse_error(")(?m:^x$)(?s:.)ſc{2,}", 196), "error parsing regexp: unexpected ): `)(?m:^x$)(?s:.)ſc{2,}`"
  check_all("c{2,}", 0, "rep{2,-1 lit{c}}", "c{2,}", "cc+", "  0\tfail\n  1*\trune1 \"c\" -> 2\n  2\trune1 \"c\" -> 3\n  3\talt -> 2, 4\n  4\tmatch\n")
  assert_eq parse_error("\\p{Greek}", 0), "error parsing regexp: invalid escape sequence: `\\p`"
  check_all("]ac{2,}[a-z&&]", 196, "cat{str{]a}rep{2,-1 lit{c}}cc{0x26 0x61-0x7a}}", "\\]ac{2,}[&a-z]", "\\]acc+[&a-z]", "  0\tfail\n  1*\trune1 \"]\" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune1 \"c\" -> 4\n  4\trune1 \"c\" -> 5\n  5\talt -> 4, 6\n  6\trune \"&&az\" -> 7\n  7\tmatch\n")
  assert_eq parse_error("[[:alpha:]](?<\\", 204), "error parsing regexp: invalid named capture: `(?<\\`"
}

test "random parse 41" {
  assert_eq parse_error("(?m:^x$)|(?m:^x$)\\C|", 204), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("[a-z&&][[:alpha:]]", 204, "cat{cc{0x26 0x61-0x7a}cc{0x41-0x5a 0x61-0x7a}}", "[&a-z][A-Za-z]", "[&a-z][A-Za-z]", "  0\tfail\n  1*\trune \"&&az\" -> 2\n  2\trune \"AZaz\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("\\x{2a}\\", 212), "error parsing regexp: trailing backslash at end of expression: ``"
  assert_eq parse_error("[a-c]\\8$", 204), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("(?s:.)\\pL[\\z(?s:.)", 204), "error parsing regexp: invalid escape sequence: `\\z`"
  check_all("a{2}a{2}(?U)a+b{1,3}b", 196, "cat{rep{2,2 lit{a}}rep{2,2 lit{a}}nplus{lit{a}}nrep{1,3 lit{b}}lit{b}}", "a{2}a{2}a+?b{1,3}?b", "aaaaa+?b(?:bb??)??b", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune1 \"a\" -> 4\n  4\trune1 \"a\" -> 5\n  5\trune1 \"a\" -> 6\n  6\talt -> 7, 5\n  7\trune1 \"b\" -> 11\n  8\trune1 \"b\" -> 10\n  9\trune1 \"b\" -> 12\n 10\talt -> 12, 9\n 11\talt -> 12, 8\n 12\trune1 \"b\" -> 13\n 13\tmatch\n")
  assert_eq parse_error("\\s\\d(?-s:.)[α-ω]x{1001}", 0), "error parsing regexp: invalid escape sequence: `\\s`"
  assert_eq parse_error("\\", 196), "error parsing regexp: trailing backslash at end of expression: ``"
  assert_eq parse_error("éx{1001}[\\p{Lu}0-9]", 204), "error parsing regexp: invalid repeat count: `{1001}`"
  assert_eq parse_error("\\C", 0), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("(?U)a+(?i:Σ)(ab\\x{2a}", 204), "error parsing regexp: missing closing ): `(?U)a+(?i:Σ)(ab\\x{2a}`"
  check_all("b{1,3}", 213, "rep{1,3 litfold{B}}", "(?i:B{1,3})", "(?i:B(?:BB?)?)", "  0\tfail\n  1*\trune \"B\"/i -> 5\n  2\trune \"B\"/i -> 4\n  3\trune \"B\"/i -> 6\n  4\talt -> 3, 6\n  5\talt -> 2, 6\n  6\tmatch\n")
  check_all("(?m:^x$)", 212, "cat{bol{}lit{x}eol{}}", "(?m:^x$)", "(?m:^x$)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune1 \"x\" -> 3\n  3\tempty 2 -> 4\n  4\tmatch\n")
  assert_eq parse_error("*\\B日本[\\p{Lu}0-9]\\B", 204), "error parsing regexp: missing argument to repetition operator: `*`"
  check_all("b", 213, "litfold{B}", "(?i:B)", "(?i:B)", "  0\tfail\n  1*\trune \"B\"/i -> 2\n  2\tmatch\n")
  check_all("\\b", 212, "wb{}", "\\b", "\\b", "  0\tfail\n  1*\tempty 16 -> 2\n  2\tmatch\n")
  assert_eq parse_error("((?-s:.)[a-z&&]éK", 212), "error parsing regexp: missing closing ): `((?-s:.)[a-z&&]éK`"
  assert_eq parse_error("(", 196), "error parsing regexp: missing closing ): `(`"
  check_all("(?s:.)", 212, "dot{}", "(?s:.)", "(?s:.)", "  0\tfail\n  1*\tany -> 2\n  2\tmatch\n")
  check_all("(?i:Σ).ſ", 196, "cat{litfold{Σ}dnl{}lit{ſ}}", "(?-s:(?i:Σ).ſ)", "(?-s:(?i:Σ).ſ)", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 2\n  2\tanynotnl -> 3\n  3\trune1 \"\\u017f\" -> 4\n  4\tmatch\n")
  assert_eq parse_error("日本[^b]a(?m:^x$)\\Pn", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all("(a|b)^a{2}(?U)a+", 213, "cat{cap{cc{0x41-0x42 0x61-0x62}}bot{}rep{2,2 litfold{A}}nplus{litfold{A}}}", "(?i:([ABab])\\AA{2}A+?)", "(?i:([ABab])\\AAAA+?)", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune \"ABab\" -> 3\n  3\tcap 3 -> 4\n  4\tempty 4 -> 5\n  5\trune \"A\"/i -> 6\n  6\trune \"A\"/i -> 7\n  7\trune \"A\"/i -> 8\n  8\talt -> 9, 7\n  9\tmatch\n")
  check_all("\\p{Greek}", 196, "cc{0x370-0x373 0x375-0x377 0x37a-0x37d 0x37f 0x384 0x386 0x388-0x38a 0x38c 0x38e-0x3a1 0x3a3-0x3e1 0x3f0-0x3ff 0x1d26-0x1d2a 0x1d5d-0x1d61 0x1d66-0x1d6a 0x1dbf 0x1f00-0x1f15 0x1f18-0x1f1d 0x1f20-0x1f45 0x1f48-0x1f4d 0x1f50-0x1f57 0x1f59 0x1f5b 0x1f5d 0x1f5f-0x1f7d 0x1f80-0x1fb4 0x1fb6-0x1fc4 0x1fc6-0x1fd3 0x1fd6-0x1fdb 0x1fdd-0x1fef 0x1ff2-0x1ff4 0x1ff6-0x1ffe 0x2126 0xab65 0x10140-0x1018e 0x101a0 0x1d200-0x1d245}", "[Ͱ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]", "[Ͱ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]", "  0\tfail\n  1*\trune \"\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("[\\Q.*\\E", 204), "error parsing regexp: invalid escape sequence: `\\Q`"
  assert_eq parse_error("*a\\z", 212), "error parsing regexp: missing argument to repetition operator: `*`"
  assert_eq parse_error("(a|b)b{1,3}\\B", 0), "error parsing regexp: invalid escape sequence: `\\B`"
  assert_eq parse_error("[^\\x00-\\x{10FFFF}](?P<n>z)+?\\pL", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("+?", 196), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error("(?U)a+\\8", 213), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("\\z\\Q.*\\E\\x{2a}\\z", 196, "cat{eot{\\z}str{.**}eot{\\z}}", "\\z\\.\\*\\*\\z", "\\z\\.\\*\\*\\z", "  0\tfail\n  1*\tempty 8 -> 2\n  2\trune1 \".\" -> 3\n  3\trune1 \"*\" -> 4\n  4\trune1 \"*\" -> 5\n  5\tempty 8 -> 6\n  6\tmatch\n")
}

test "random parse 42" {
  assert_eq parse_error("b\\", 204), "error parsing regexp: trailing backslash at end of expression: ``"
  assert_eq parse_error("\\w\\x{2a}b{1,3}(?m:^x$)", 0), "error parsing regexp: invalid escape sequence: `\\w`"
  check_all("\\Q.*\\E(?s:.){,é", 213, "cat{str{.*}dot{}strfold{{,É}}", "(?is:\\.\\*.\\{,É)", "(?is:\\.\\*.\\{,É)", "  0\tfail\n  1*\trune1 \".\" -> 2\n  2\trune1 \"*\" -> 3\n  3\tany -> 4\n  4\trune1 \"{\" -> 5\n  5\trune1 \",\" -> 6\n  6\trune \"\\u00c9\"/i -> 7\n  7\tmatch\n")
