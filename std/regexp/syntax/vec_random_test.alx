a8ff\\ua90a\\ua9cf\\ua9da\\ua9ef\\ua9fa\\uaa4f\\uaa5a\\uabef\\uabfa\\uff0f\\uff1a\\U00010106\\U00010134\\U0001013f\\U00010179\\U00010189\\U0001018c\\U000102e0\\U000102fc\\U0001031f\\U00010324\\U00010340\\U00010342\\U00010349\\U0001034b\\U000103d0\\U000103d6\\U0001049f\\U000104aa\\U00010857\\U00010860\\U00010878\\U00010880\\U000108a6\\U000108b0\\U000108fa\\U00010900\\U00010915\\U0001091c\\U000109bb\\U000109be\\U000109bf\\U000109d0\\U000109d1\\U00010a00\\U00010a3f\\U00010a49\\U00010a7c\\U00010a7f\\U00010a9c\\U00010aa0\\U00010aea\\U00010af0\\U00010b57\\U00010b60\\U00010b77\\U00010b80\\U00010ba8\\U00010bb0\\U00010cf9\\U00010d00\\U00010d2f\\U00010d3a\\U00010d3f\\U00010d4a\\U00010e5f\\U00010e7f\\U00010f1c\\U00010f27\\U00010f50\\U00010f55\\U00010fc4\\U00010fcc\\U00011051\\U00011070\\U000110ef\\U000110fa\\U00011135\\U00011140\\U000111cf\\U000111da\\U000111e0\\U000111f5\\U000112ef\\U000112fa\\U0001144f\\U0001145a\\U000114cf\\U000114da\\U0001164f\\U0001165a\\U000116bf\\U000116ca\\U000116cf\\U000116e4\\U0001172f\\U0001173c\\U000118df\\U000118f3\\U0001194f\\U0001195a\\U00011bef\\U00011bfa\\U00011c4f\\U00011c6d\\U00011d4f\\U00011d5a\\U00011d9f\\U00011daa\\U00011ddf\\U00011dea\\U00011f4f\\U00011f5a\\U00011fbf\\U00011fd5\\U000123ff\\U0001246f\\U0001612f\\U0001613a\\U00016a5f\\U00016a6a\\U00016abf\\U00016aca\\U00016b4f\\U00016b5a\\U00016b5a\\U00016b62\\U00016d6f\\U00016d7a\\U00016e7f\\U00016e97\\U00016ff3\\U00016ff7\\U0001ccef\\U0001ccfa\\U0001d2bf\\U0001d2d4\\U0001d2df\\U0001d2f4\\U0001d35f\\U0001d379\\U0001d7cd\\U0001d800\\U0001e13f\\U0001e14a\\U0001e2ef\\U0001e2fa\\U0001e4ef\\U0001e4fa\\U0001e5f0\\U0001e5fb\\U0001e8c6\\U0001e8d0\\U0001e94f\\U0001e95a\\U0001ec70\\U0001ecac\\U0001ecac\\U0001ecb0\\U0001ecb0\\U0001ecb5\\U0001ed00\\U0001ed2e\\U0001ed2e\\U0001ed3e\\U0001f0ff\\U0001f10d\\U0001fbef\\U0001fbfa\\U0010ffff\" -> 4\n  4\tanynotnl -> 5\n  5\tmatch\n")
  assert_eq parse_error("b\\s\\8ab", 204), "error parsing regexp: invalid escape sequence: `\\8`"
  assert_eq parse_error("\\Pn\\s[\\p{Lu}0-9]\\C[", 212), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("+?ſ", 212), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error("\\C[a-c]\\Pn(?-s:.)\\s", 204), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all(".", 196, "dnl{}", "(?-s:.)", "(?-s:.)", "  0\tfail\n  1*\tanynotnl -> 2\n  2\tmatch\n")
  assert_eq parse_error("b\\s[a-c]\\x{2a}(?<", 196), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
  assert_eq parse_error("(?-s:.)", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error(")", 213), "error parsing regexp: unexpected ): `)`"
  assert_eq parse_error("é\\z^", 0), "error parsing regexp: invalid escape sequence: `\\z`"
  check_all("x*", 196, "star{lit{x}}", "x*", "x*", "  0\tfail\n  1\trune1 \"x\" -> 2\n  2*\talt -> 1, 3\n  3\tmatch\n")
  check_all("ſ(?:ab|ac)", 204, "cat{lit{ſ}lit{a}cc{0x62-0x63}}", "ſa[bc]", "ſa[bc]", "  0\tfail\n  1*\trune1 \"\\u017f\" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune \"bc\" -> 4\n  4\tmatch\n")
  check_all("a{2}\\\\p{Greek}", 204, "cat{rep{2,2 lit{a}}str{\\p{Greek}}}", "a{2}\\\\p\\{Greek\\}", "aa\\\\p\\{Greek\\}", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune1 \"\\\\\" -> 4\n  4\trune1 \"p\" -> 5\n  5\trune1 \"{\" -> 6\n  6\trune1 \"G\" -> 7\n  7\trune1 \"r\" -> 8\n  8\trune1 \"e\" -> 9\n  9\trune1 \"e\" -> 10\n 10\trune1 \"k\" -> 11\n 11\trune1 \"}\" -> 12\n 12\tmatch\n")
  check_all("(?i)k\\Q.*\\E", 213, "strfold{K.*}", "(?i:K\\.\\*)", "(?i:K\\.\\*)", "  0\tfail\n  1*\trune \"K\"/i -> 2\n  2\trune1 \".\" -> 3\n  3\trune1 \"*\" -> 4\n  4\tmatch\n")
  check_all("K(a|b)|日本[a-c]", 213, "alt{cat{litfold{K}cap{cc{0x41-0x42 0x61-0x62}}}cat{str{日本}cc{0x41-0x43 0x61-0x63}}}", "(?i:K([ABab])|日本[A-Ca-c])", "(?i:K([ABab])|日本[A-Ca-c])", "  0\tfail\n  1\trune \"K\"/i -> 2\n  2\tcap 2 -> 3\n  3\trune \"ABab\" -> 4\n  4\tcap 3 -> 9\n  5\trune1 \"\\u65e5\" -> 6\n  6\trune1 \"\\u672c\" -> 7\n  7\trune \"ACac\" -> 9\n  8*\talt -> 1, 5\n  9\tmatch\n")
  assert_eq parse_error("\\A", 0), "error parsing regexp: invalid escape sequence: `\\A`"
  check_all("\\x{2a}", 196, "lit{*}", "\\*", "\\*", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\tmatch\n")
  assert_eq parse_error("+?a{2}\\p{Greek}(?U)a+", 212), "error parsing regexp: missing argument to repetition operator: `+?`"
  assert_eq parse_error("(.(?U)a+", 204), "error parsing regexp: missing closing ): `(.(?U)a+`"
  check_all("^", 196, "bol{}", "(?m:^)", "(?m:^)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\tmatch\n")
  check_all("(?s:.)a", 204, "cat{dot{}lit{a}}", "(?s:.a)", "(?s:.a)", "  0\tfail\n  1*\tany -> 2\n  2\trune1 \"a\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("(?P<n>z)\\Bb", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("(?i:Σ)\\[\\p{Lu}0-9]", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("\\Pn(.", 212), "error parsing regexp: missing closing ): `\\Pn(.`"
  assert_eq parse_error("(?i)k\\b\\B(?i)k[^\\x00-\\x{10FFFF}]", 0), "error parsing regexp: missing argument to repetition operator: `?`"
}

test "random parse 12" {
  assert_eq parse_error("\\C\\b[^\\x00-\\x{10FFFF}]c{2,}(?i)k", 213), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error("\\C[a-z&&][\\A", 204), "error parsing regexp: invalid escape sequence: `\\C`"
  assert_eq parse_error(".\\(?m:^x$)(?P<n>z)(?-s:.)", 196), "error parsing regexp: unexpected ): `.\\(?m:^x$)(?P<n>z)(?-s:.)`"
  assert_eq parse_error("(?s:.)[a-c]|b{1,3}", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all(".", 212, "dnl{}", "(?-s:.)", "(?-s:.)", "  0\tfail\n  1*\tanynotnl -> 2\n  2\tmatch\n")
  check_all("\\w\\d", 213, "cat{cc{0x30-0x39 0x41-0x5a 0x5f 0x61-0x7a 0x17f 0x212a}cc{0x30-0x39}}", "[0-9A-Z_a-zſK][0-9]", "[0-9A-Z_a-zſK][0-9]", "  0\tfail\n  1*\trune \"09AZ__az\\u017f\\u017f\\u212a\\u212a\" -> 2\n  2\trune \"09\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("+?ab[α-ω]ſ", 0), "error parsing regexp: missing argument to repetition operator: `+`"
  check_all("\\x{2a}c{2,}\\x{2a}[^b]c{2,}", 204, "cat{lit{*}rep{2,-1 lit{c}}lit{*}cc{0x0-0x61 0x63-0x10ffff}rep{2,-1 lit{c}}}", "\\*c{2,}\\*[^b]c{2,}", "\\*cc+\\*[^b]cc+", "  0\tfail\n  1*\trune1 \"*\" -> 2\n  2\trune1 \"c\" -> 3\n  3\trune1 \"c\" -> 4\n  4\talt -> 3, 5\n  5\trune1 \"*\" -> 6\n  6\trune \"\\x00ac\\U0010ffff\" -> 7\n  7\trune1 \"c\" -> 8\n  8\trune1 \"c\" -> 9\n  9\talt -> 8, 10\n 10\tmatch\n")
  check_all("a{2}ab", 0, "cat{rep{2,2 lit{a}}str{ab}}", "a{2}ab", "aaab", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"a\" -> 3\n  3\trune1 \"a\" -> 4\n  4\trune1 \"b\" -> 5\n  5\tmatch\n")
  assert_eq parse_error(")[^\\x00-\\x{10FFFF}]", 196), "error parsing regexp: unexpected ): `)[^\\x00-\\x{10FFFF}]`"
  check_all("a{2}", 212, "rep{2,2 lit{a}}", "a{2}", "aa", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"a\" -> 3\n  3\tmatch\n")
  check_all("\\sa+?", 204, "cat{cc{0x9-0xa 0xc-0xd 0x20}nplus{lit{a}}}", "[\\t\\n\\f\\r ]a+?", "[\\t\\n\\f\\r ]a+?", "  0\tfail\n  1*\trune \"\\t\\n\\f\\r  \" -> 2\n  2\trune1 \"a\" -> 3\n  3\talt -> 4, 2\n  4\tmatch\n")
  check_all("$\\b(?i)k", 213, "cat{eot{}wb{}litfold{K}}", "(?i-m:$\\bK)", "(?i-m:$\\bK)", "  0\tfail\n  1*\tempty 8 -> 2\n  2\tempty 16 -> 3\n  3\trune \"K\"/i -> 4\n  4\tmatch\n")
  check_all("a*", 213, "star{litfold{A}}", "(?i:A*)", "(?i:A*)", "  0\tfail\n  1\trune \"A\"/i -> 2\n  2*\talt -> 1, 3\n  3\tmatch\n")
  check_all("[a-z&&](?s:.)$$", 196, "cat{cc{0x26 0x61-0x7a}dot{}eol{}eol{}}", "(?ms:[&a-z].$$)", "(?ms:[&a-z].$$)", "  0\tfail\n  1*\trune \"&&az\" -> 2\n  2\tany -> 3\n  3\tempty 2 -> 4\n  4\tempty 2 -> 5\n  5\tmatch\n")
  check_all("(?P<n>z)Kb$.", 204, "cat{cap{n:lit{z}}str{Kb}eol{}dot{}}", "(?ms:(?P<n>z)Kb$.)", "(?ms:(?P<n>z)Kb$.)", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"z\" -> 3\n  3\tcap 3 -> 4\n  4\trune1 \"K\" -> 5\n  5\trune1 \"b\" -> 6\n  6\tempty 2 -> 7\n  7\tany -> 8\n  8\tmatch\n")
  assert_eq parse_error("x{1001}[[:alpha:]]\\pLK", 212), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all(".[^\\x00-\\x{10FFFF}]", 0, "cat{dnl{}cc{}}", "(?-s:.[^\\x00-\\x{10FFFF}])", "(?-s:.[^\\x00-\\x{10FFFF}])", "  0\tfail\n  1*\tanynotnl -> 2\n  2\trune \"\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("é$[a-z&&]\\pL\\pL", 0), "error parsing regexp: invalid escape sequence: `\\p`"
  check_all("(a|b)|\\z", 204, "alt{cap{cc{0x61-0x62}}eot{\\z}}", "([ab])|\\z", "([ab])|\\z", "  0\tfail\n  1\tcap 2 -> 2\n  2\trune \"ab\" -> 3\n  3\tcap 3 -> 6\n  4\tempty 8 -> 6\n  5*\talt -> 1, 4\n  6\tmatch\n")
  assert_eq parse_error("a{2}(?:ab|ac)a", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  check_all(".(?U)a+[^\\x00-\\x{10FFFF}]", 213, "cat{dnl{}nplus{litfold{A}}cc{}}", "(?i-s:.A+?[^\\x00-\\x{10FFFF}])", "(?i-s:.A+?[^\\x00-\\x{10FFFF}])", "  0\tfail\n  1*\tanynotnl -> 2\n  2\trune \"A\"/i -> 3\n  3\talt -> 4, 2\n  4\trune \"\" -> 5\n  5\tmatch\n")
  check_all("(?m:^x$)", 213, "cat{bol{}litfold{X}eol{}}", "(?im:^X$)", "(?im:^X$)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune \"X\"/i -> 3\n  3\tempty 2 -> 4\n  4\tmatch\n")
  check_all("(?-s:.)(?m:^x$)*(?m:^x$)", 204, "cat{dnl{}star{cat{bol{}lit{x}eol{}}}bol{}lit{x}eol{}}", "(?m-s:.(?:^x$)*^x$)", "(?m-s:.(?:^x$)*^x$)", "  0\tfail\n  1*\tanynotnl -> 5\n  2\tempty 1 -> 3\n  3\trune1 \"x\" -> 4\n  4\tempty 2 -> 5\n  5\talt -> 2, 6\n  6\tempty 1 -> 7\n  7\trune1 \"x\" -> 8\n  8\tempty 2 -> 9\n  9\tmatch\n")
  check_all("(?i:Σ)", 213, "litfold{Σ}", "(?i:Σ)", "(?i:Σ)", "  0\tfail\n  1*\trune \"\\u03a3\"/i -> 2\n  2\tmatch\n")
  assert_eq parse_error("*]K\\pL\\Pn", 0), "error parsing regexp: missing argument to repetition operator: `*`"
  assert_eq parse_error("b{1,3}\\bb{1,3}](?:ab|ac)", 0), "error parsing regexp: invalid escape sequence: `\\b`"
  check_all("b$ab", 0, "cat{lit{b}eol{}str{ab}}", "(?m:b$ab)", "(?m:b$ab)", "  0\tfail\n  1*\trune1 \"b\" -> 2\n  2\tempty 2 -> 3\n  3\trune1 \"a\" -> 4\n  4\trune1 \"b\" -> 5\n  5\tmatch\n")
  check_all("日本\\Q.*\\E+?é", 213, "cat{str{日本.}nplus{lit{*}}litfold{É}}", "(?i:日本\\.\\*+?É)", "(?i:日本\\.\\*+?É)", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\trune1 \".\" -> 4\n  4\trune1 \"*\" -> 5\n  5\talt -> 6, 4\n  6\trune \"\\u00c9\"/i -> 7\n  7\tmatch\n")
  assert_eq parse_error("c{2,}[a-z&&]a\\(?i)k", 213), "error parsing regexp: unexpected ): `c{2,}[a-z&&]a\\(?i)k`"
}

test "random parse 13" {
  assert_eq parse_error("x{1001}b[a-c]", 213), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("\\z\\s{,", 196, "cat{eot{\\z}cc{0x9-0xa 0xc-0xd 0x20}str{{,}}", "\\z[\\t\\n\\f\\r ]\\{,", "\\z[\\t\\n\\f\\r ]\\{,", "  0\tfail\n  1*\tempty 8 -> 2\n  2\trune \"\\t\\n\\f\\r  \" -> 3\n  3\trune1 \"{\" -> 4\n  4\trune1 \",\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("(?P<n>z)b{1,3}[α-ω]", 0), "error parsing regexp: missing argument to repetition operator: `?`"
  assert_eq parse_error("x{1001}\\x{2a}", 196), "error parsing regexp: invalid repeat count: `{1001}`"
  check_all("\\zc{2,}", 213, "cat{eot{\\z}rep{2,-1 litfold{C}}}", "(?i:\\zC{2,})", "(?i:\\zCC+)", "  0\tfail\n  1*\tempty 8 -> 2\n  2\trune \"C\"/i -> 3\n  3\trune \"C\"/i -> 4\n  4\talt -> 3, 5\n  5\tmatch\n")
  assert_eq parse_error("{,ſ)a{2}[α-ω]", 196), "error parsing regexp: unexpected ): `{,ſ)a{2}[α-ω]`"
  assert_eq parse_error("]c{2,}[日本\\s", 196), "error parsing regexp: missing closing ]: `[日本\\s`"
  assert_eq parse_error("(", 213), "error parsing regexp: missing closing ): `(`"
  check_all("[a-c]\\x{2a}[^b]", 212, "cat{cc{0x61-0x63}lit{*}cc{0x0-0x61 0x63-0x10ffff}}", "[a-c]\\*[^b]", "[a-c]\\*[^b]", "  0\tfail\n  1*\trune \"ac\" -> 2\n  2\trune1 \"*\" -> 3\n  3\trune \"\\x00ac\\U0010ffff\" -> 4\n  4\tmatch\n")
  check_all("[α-ω]", 0, "cc{0x3b1-0x3c9}", "[α-ω]", "[α-ω]", "  0\tfail\n  1*\trune \"\\u03b1\\u03c9\" -> 2\n  2\tmatch\n")
  assert_eq parse_error(")", 0), "error parsing regexp: unexpected ): `)`"
  check_all("(?m:^x$)]", 204, "cat{bol{}lit{x}eol{}lit{]}}", "(?m:^x$\\])", "(?m:^x$\\])", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune1 \"x\" -> 3\n  3\tempty 2 -> 4\n  4\trune1 \"]\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("\\C", 212), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("$", 213, "eot{}", "(?-m:$)", "(?-m:$)", "  0\tfail\n  1*\tempty 8 -> 2\n  2\tmatch\n")
  check_all("b*a[α-ω](?s:.)", 212, "cat{star{lit{b}}lit{a}cc{0x3b1-0x3c9}dot{}}", "(?s:b*a[α-ω].)", "(?s:b*a[α-ω].)", "  0\tfail\n  1\trune1 \"b\" -> 2\n  2*\talt -> 1, 3\n  3\trune1 \"a\" -> 4\n  4\trune \"\\u03b1\\u03c9\" -> 5\n  5\tany -> 6\n  6\tmatch\n")
  assert_eq parse_error("^(?<", 196), "error parsing regexp: invalid or unsupported Perl syntax: `(?<`"
  check_all("^é", 212, "cat{bot{}lit{é}}", "\\Aé", "\\Aé", "  0\tfail\n  1*\tempty 4 -> 2\n  2\trune1 \"\\u00e9\" -> 3\n  3\tmatch\n")
