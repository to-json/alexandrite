  check_all("x*[a-z&&]x*[a-c]", 213, "cat{star{litfold{X}}cc{0x26 0x41-0x5a 0x61-0x7a 0x17f 0x212a}star{litfold{X}}cc{0x41-0x43 0x61-0x63}}", "(?i:X*[&A-Za-zſK]X*[A-Ca-c])", "(?i:X*[&A-Za-zſK]X*[A-Ca-c])", "  0\tfail\n  1\trune \"X\"/i -> 2\n  2*\talt -> 1, 3\n  3\trune \"&&AZaz\\u017f\\u017f\\u212a\\u212a\" -> 5\n  4\trune \"X\"/i -> 5\n  5\talt -> 4, 6\n  6\trune \"ACac\" -> 7\n  7\tmatch\n")
