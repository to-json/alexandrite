test "random parse 29" {
  check_all("日本[[:alpha:]][a-z&&][^b](?i:Σ)", 212, "cat{str{日本}cc{0x41-0x5a 0x61-0x7a}cc{0x26 0x61-0x7a}cc{0x0-0x61 0x63-0x10ffff}litfold{Σ}}", "日本[A-Za-z][&a-z][^b](?i:Σ)", "日本[A-Za-z][&a-z][^b](?i:Σ)", "  0\tfail\n  1*\trune1 \"\\u65e5\" -> 2\n  2\trune1 \"\\u672c\" -> 3\n  3\trune \"AZaz\" -> 4\n  4\trune \"&&az\" -> 5\n  5\trune \"\\x00ac\\U0010ffff\" -> 6\n  6\trune \"\\u03a3\"/i -> 7\n  7\tmatch\n")
  check_all("^", 0, "bol{}", "(?m:^)", "(?m:^)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\tmatch\n")
  assert_eq parse_error("\\w(\\", 212), "error parsing regexp: trailing backslash at end of expression: ``"
  check_all("\\b\\z\\z[α-ω]", 213, "cat{wb{}eot{\\z}eot{\\z}cc{0xb5 0x345 0x391-0x3a1 0x3a3-0x3a9 0x3b1-0x3c9 0x3d0-0x3d1 0x3d5-0x3d6 0x3f0-0x3f1 0x3f4-0x3f5 0x1fbe 0x2126}}", "\\b\\z\\z[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ]", "\\b\\z\\z[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ]", "  0\tfail\n  1*\tempty 16 -> 2\n  2\tempty 8 -> 3\n  3\tempty 8 -> 4\n  4\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0391\\u03a1\\u03a3\\u03a9\\u03b1\\u03c9\\u03d0\\u03d1\\u03d5\\u03d6\\u03f0\\u03f1\\u03f4\\u03f5\\u1fbe\\u1fbe\\u2126\\u2126\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("\\", 213), "error parsing regexp: trailing backslash at end of expression: ``"
  check_all("b{1,3}", 212, "rep{1,3 lit{b}}", "b{1,3}", "b(?:bb?)?", "  0\tfail\n  1*\trune1 \"b\" -> 5\n  2\trune1 \"b\" -> 4\n  3\trune1 \"b\" -> 6\n  4\talt -> 3, 6\n  5\talt -> 2, 6\n  6\tmatch\n")
  check_all("\\z\\x{1001}é\\x{2a}", 213, "cat{eot{\\z}strfold{ခÉ*}}", "(?i:\\zခÉ\\*)", "(?i:\\zခÉ\\*)", "  0\tfail\n  1*\tempty 8 -> 2\n  2\trune1 \"\\u1001\" -> 3\n  3\trune \"\\u00c9\"/i -> 4\n  4\trune1 \"*\" -> 5\n  5\tmatch\n")
  assert_eq parse_error("(?s:.)é\\b)[^\\x00-\\x{10FFFF}]", 0), "error parsing regexp: missing argument to repetition operator: `?`"
