  check_all("(?P<n>z)[[^\\x00-\\x{10FFFF}]ab[a-c]", 212, "cat{cap{n:lit{z}}cc{0x0-0x10ffff}str{ab}cc{0x61-0x63}}", "(?P<n>z)[\\x00-\\x{10ffff}]ab[a-c]", "(?P<n>z)[\\x00-\\x{10ffff}]ab[a-c]", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"z\" -> 3\n  3\tcap 3 -> 4\n  4\tany -> 5\n  5\trune1 \"a\" -> 6\n  6\trune1 \"b\" -> 7\n  7\trune \"ac\" -> 8\n  8\tmatch\n")
  check_all("(?P<n>z)\\Q.*\\E\\p{Greek}\\[α-ω]", 196, "cat{cap{n:lit{z}}str{.*}cc{0x370-0x373 0x375-0x377 0x37a-0x37d 0x37f 0x384 0x386 0x388-0x38a 0x38c 0x38e-0x3a1 0x3a3-0x3e1 0x3f0-0x3ff 0x1d26-0x1d2a 0x1d5d-0x1d61 0x1d66-0x1d6a 0x1dbf 0x1f00-0x1f15 0x1f18-0x1f1d 0x1f20-0x1f45 0x1f48-0x1f4d 0x1f50-0x1f57 0x1f59 0x1f5b 0x1f5d 0x1f5f-0x1f7d 0x1f80-0x1fb4 0x1fb6-0x1fc4 0x1fc6-0x1fd3 0x1fd6-0x1fdb 0x1fdd-0x1fef 0x1ff2-0x1ff4 0x1ff6-0x1ffe 0x2126 0xab65 0x10140-0x1018e 0x101a0 0x1d200-0x1d245}str{[α-ω]}}", "(?P<n>z)\\.\\*[Ͱ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]\\[α-ω\\]", "(?P<n>z)\\.\\*[Ͱ-ͳ͵-ͷͺ-ͽͿ΄ΆΈ-ΊΌΎ-ΡΣ-ϡϰ-Ͽᴦ-ᴪᵝ-ᵡᵦ-ᵪᶿἀ-ἕἘ-Ἕἠ-ὅὈ-Ὅὐ-ὗὙὛὝὟ-ώᾀ-ᾴᾶ-ῄῆ-ΐῖ-Ί῝-`ῲ-ῴῶ-῾Ωꭥ𐅀-𐆎𐆠𝈀-𝉅]\\[α-ω\\]", "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"z\" -> 3\n  3\tcap 3 -> 4\n  4\trune1 \".\" -> 5\n  5\trune1 \"*\" -> 6\n  6\trune \"\\u0370\\u0373\\u0375\\u0377\\u037a\\u037d\\u037f\\u037f\\u0384\\u0384\\u0386\\u0386\\u0388\\u038a\\u038c\\u038c\\u038e\\u03a1\\u03a3\\u03e1\\u03f0\\u03ff\\u1d26\\u1d2a\\u1d5d\\u1d61\\u1d66\\u1d6a\\u1dbf\\u1dbf\\u1f00\\u1f15\\u1f18\\u1f1d\\u1f20\\u1f45\\u1f48\\u1f4d\\u1f50\\u1f57\\u1f59\\u1f59\\u1f5b\\u1f5b\\u1f5d\\u1f5d\\u1f5f\\u1f7d\\u1f80\\u1fb4\\u1fb6\\u1fc4\\u1fc6\\u1fd3\\u1fd6\\u1fdb\\u1fdd\\u1fef\\u1ff2\\u1ff4\\u1ff6\\u1ffe\\u2126\\u2126\\uab65\\uab65\\U00010140\\U0001018e\\U000101a0\\U000101a0\\U0001d200\\U0001d245\" -> 7\n  7\trune1 \"[\" -> 8\n  8\trune1 \"\\u03b1\" -> 9\n  9\trune1 \"-\" -> 10\n 10\trune1 \"\\u03c9\" -> 11\n 11\trune1 \"]\" -> 12\n 12\tmatch\n")
  check_all("(?m:^x$)$", 196, "cat{bol{}lit{x}eol{}eol{}}", "(?m:^x$$)", "(?m:^x$$)", "  0\tfail\n  1*\tempty 1 -> 2\n  2\trune1 \"x\" -> 3\n  3\tempty 2 -> 4\n  4\tempty 2 -> 5\n  5\tmatch\n")
  assert_eq parse_error("(?s:.))", 213), "error parsing regexp: unexpected ): `(?s:.))`"
  assert_eq parse_error("[a-z&&]\\pL", 0), "error parsing regexp: invalid escape sequence: `\\p`"
}

test "random parse 4" {
  check_all("{,", 212, "str{{,}", "\\{,", "\\{,", "  0\tfail\n  1*\trune1 \"{\" -> 2\n  2\trune1 \",\" -> 3\n  3\tmatch\n")
  assert_eq parse_error("[^\\x00-\\x{10FFFF}]\\A$]x*", 0), "error parsing regexp: invalid escape sequence: `\\A`"
  assert_eq parse_error("[", 204), "error parsing regexp: missing closing ]: `[`"
  check_all("b{1,3}$", 204, "cat{rep{1,3 lit{b}}eol{}}", "(?m:b{1,3}$)", "(?m:b(?:bb?)?$)", "  0\tfail\n  1*\trune1 \"b\" -> 5\n  2\trune1 \"b\" -> 4\n  3\trune1 \"b\" -> 6\n  4\talt -> 3, 6\n  5\talt -> 2, 6\n  6\tempty 2 -> 7\n  7\tmatch\n")
  check_all("c{2,}a(?P<n>z)", 212, "cat{rep{2,-1 lit{c}}lit{a}cap{n:lit{z}}}", "c{2,}a(?P<n>z)", "cc+a(?P<n>z)", "  0\tfail\n  1*\trune1 \"c\" -> 2\n  2\trune1 \"c\" -> 3\n  3\talt -> 2, 4\n  4\trune1 \"a\" -> 5\n  5\tcap 2 -> 6\n  6\trune1 \"z\" -> 7\n  7\tcap 3 -> 8\n  8\tmatch\n")
  assert_eq parse_error(")b{1,3}c{2,}\\A", 212), "error parsing regexp: unexpected ): `)b{1,3}c{2,}\\A`"
  check_all("abab\\B", 204, "cat{str{abab}nwb{}}", "abab\\B", "abab\\B", "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\trune1 \"b\" -> 3\n  3\trune1 \"a\" -> 4\n  4\trune1 \"b\" -> 5\n  5\tempty 32 -> 6\n  6\tmatch\n")
  check_all("\\z", 196, "eot{\\z}", "\\z", "\\z", "  0\tfail\n  1*\tempty 8 -> 2\n  2\tmatch\n")
  assert_eq parse_error("é\\8[α-ω]", 213), "error parsing regexp: invalid escape sequence: `\\8`"
  check_all("\\b[α-ω]$(?U)a+", 213, "cat{wb{}cc{0xb5 0x345 0x391-0x3a1 0x3a3-0x3a9 0x3b1-0x3c9 0x3d0-0x3d1 0x3d5-0x3d6 0x3f0-0x3f1 0x3f4-0x3f5 0x1fbe 0x2126}eot{}nplus{litfold{A}}}", "(?i-m:\\b[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ]$A+?)", "(?i-m:\\b[µͅΑ-ΡΣ-Ωα-ωϐϑϕϖϰϱϴϵιΩ]$A+?)", "  0\tfail\n  1*\tempty 16 -> 2\n  2\trune \"\\u00b5\\u00b5\\u0345\\u0345\\u0391\\u03a1\\u03a3\\u03a9\\u03b1\\u03c9\\u03d0\\u03d1\\u03d5\\u03d6\\u03f0\\u03f1\\u03f4\\u03f5\\u1fbe\\u1fbe\\u2126\\u2126\" -> 3\n  3\tempty 8 -> 4\n  4\trune \"A\"/i -> 5\n  5\talt -> 6, 4\n  6\tmatch\n")
  check_all("$(?m:^x$)b(?-s:.)é", 212, "cat{eot{}bol{}lit{x}eol{}lit{b}dnl{}lit{é}}", "(?-ms:$(?m:^x$)b.é)", "(?-ms:$(?m:^x$)b.é)", "  0\tfail\n  1*\tempty 8 -> 2\n  2\tempty 1 -> 3\n  3\trune1 \"x\" -> 4\n  4\tempty 2 -> 5\n  5\trune1 \"b\" -> 6\n  6\tanynotnl -> 7\n  7\trune1 \"\\u00e9\" -> 8\n  8\tmatch\n")
  assert_eq parse_error("(?i)kK[\\x{2a}{,", 196), "error parsing regexp: missing closing ]: `[\\x{2a}{,`"
  assert_eq parse_error("aa\\Cx*]", 196), "error parsing regexp: invalid escape sequence: `\\C`"
  check_all("x*", 204, "star{lit{x}}", "x*", "x*", "  0\tfail\n  1\trune1 \"x\" -> 2\n  2*\talt -> 1, 3\n  3\tmatch\n")
  check_all("[^b].", 213, "cat{cc{0x0-0x41 0x43-0x61 0x63-0x10ffff}dnl{}}", "(?-s:[^Bb].)", "(?-s:[^Bb].)", "  0\tfail\n  1*\trune \"\\x00ACac\\U0010ffff\" -> 2\n  2\tanynotnl -> 3\n  3\tmatch\n")
