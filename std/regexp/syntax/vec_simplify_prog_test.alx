test "simplify 1" {
  assert_eq parse("(a){0,2}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?:(a)(a)?)?"
  assert_eq parse("(a){0,4}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?:(a)(?:(a)(?:(a)(a)?)?)?)?"
  assert_eq parse("(a){2,6}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(a)(a)(?:(a)(?:(a)(?:(a)(a)?)?)?)?"
  assert_eq parse("a{0,2}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?:aa?)?"
  assert_eq parse("a{0,4}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?:a(?:a(?:aa?)?)?)?"
  assert_eq parse("a{2,6}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "aa(?:a(?:a(?:aa?)?)?)?"
  assert_eq parse("a{0,}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "a*"
  assert_eq parse("a{1,}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "a+"
  assert_eq parse("a{2,}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "aa+"
  assert_eq parse("a{5,}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "aaaaa+"
  assert_eq parse("(?:a{1,}){1,}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "a+"
  assert_eq parse("(a{1,}b{1,})", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(a+b+)"
  assert_eq parse("a{1,}|b{1,}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "a+|b+"
  assert_eq parse("(?:a{1,})*", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?:a+)*"
  assert_eq parse("(?:a{1,})+", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "a+"
  assert_eq parse("(?:a{1,})?", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?:a+)?"
  assert_eq parse("", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?:)"
  assert_eq parse("a{0}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?:)"
  assert_eq parse("[ab]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[ab]"
  assert_eq parse("[abc]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[a-c]"
  assert_eq parse("[a-za-za-z]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[a-z]"
  assert_eq parse("[A-Za-zA-Za-z]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[A-Za-z]"
  assert_eq parse("[ABCDEFGH]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[A-H]"
  assert_eq parse("[AB-CD-EF-GH]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[A-H]"
  assert_eq parse("[W-ZP-XE-R]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[E-Z]"
  assert_eq parse("[a-ee-gg-m]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[a-m]"
  assert_eq parse("[a-ea-ha-m]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[a-m]"
  assert_eq parse("[a-ma-ha-e]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[a-m]"
  assert_eq parse("[a-zA-Z0-9 -~]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[ -~]"
  assert_eq parse("[^[:cntrl:][:^cntrl:]]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[^\\x00-\\x{10FFFF}]"
  assert_eq parse("[[:cntrl:][:^cntrl:]]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?s:.)"
  assert_eq parse("(?i)A", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?i:A)"
  assert_eq parse("(?i)a", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?i:A)"
  assert_eq parse("(?i)[A]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?i:A)"
  assert_eq parse("(?i)[a]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?i:A)"
  assert_eq parse("(?i)K", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?i:K)"
  assert_eq parse("(?i)k", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?i:K)"
  assert_eq parse("(?i)\\x{212a}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?i:K)"
  assert_eq parse("(?i)[K]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[KkK]"
  assert_eq parse("(?i)[k]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[KkK]"
}

test "simplify 2" {
  assert_eq parse("(?i)[\\x{212a}]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[KkK]"
  assert_eq parse("(?i)[a-z]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[A-Za-zſK]"
  assert_eq parse("(?i)[\\x00-\\x{FFFD}]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "[\\x00-�]"
  assert_eq parse("(?i)[\\x00-\\x{10FFFF}]", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?s:.)"
  assert_eq parse("(a|b|c|)", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "([a-c]|(?:))"
  assert_eq parse("(a|b|)", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "([ab]|(?:))"
  assert_eq parse("(|)", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "()"
  assert_eq parse("a()", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "a()"
  assert_eq parse("(()|())", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(()|())"
  assert_eq parse("(a|)", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(a|(?:))"
  assert_eq parse("ab()cd()", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "ab()cd()"
  assert_eq parse("()", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "()"
  assert_eq parse("()*", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "()*"
  assert_eq parse("()+", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "()+"
  assert_eq parse("()?", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "()?"
  assert_eq parse("(){0}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?:)"
  assert_eq parse("(){1}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "()"
  assert_eq parse("(){1,}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "()+"
  assert_eq parse("(){0,2}", MATCH_NL | (PERL & ^ONE_LINE)).unwrap.simplify.to_s, "(?:()()?)?"
}

test "compile 0" {
  assert_eq compile(parse("a", PERL).unwrap).to_s, "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\tmatch\n"
  assert_eq compile(parse("[A-M][n-z]", PERL).unwrap).to_s, "  0\tfail\n  1*\trune \"AM\" -> 2\n  2\trune \"nz\" -> 3\n  3\tmatch\n"
  assert_eq compile(parse("", PERL).unwrap).to_s, "  0\tfail\n  1*\tnop -> 2\n  2\tmatch\n"
  assert_eq compile(parse("a?", PERL).unwrap).to_s, "  0\tfail\n  1\trune1 \"a\" -> 3\n  2*\talt -> 1, 3\n  3\tmatch\n"
  assert_eq compile(parse("a??", PERL).unwrap).to_s, "  0\tfail\n  1\trune1 \"a\" -> 3\n  2*\talt -> 3, 1\n  3\tmatch\n"
  assert_eq compile(parse("a+", PERL).unwrap).to_s, "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\talt -> 1, 3\n  3\tmatch\n"
  assert_eq compile(parse("a+?", PERL).unwrap).to_s, "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\talt -> 3, 1\n  3\tmatch\n"
  assert_eq compile(parse("a*", PERL).unwrap).to_s, "  0\tfail\n  1\trune1 \"a\" -> 2\n  2*\talt -> 1, 3\n  3\tmatch\n"
  assert_eq compile(parse("a*?", PERL).unwrap).to_s, "  0\tfail\n  1\trune1 \"a\" -> 2\n  2*\talt -> 3, 1\n  3\tmatch\n"
  assert_eq compile(parse("a+b+", PERL).unwrap).to_s, "  0\tfail\n  1*\trune1 \"a\" -> 2\n  2\talt -> 1, 3\n  3\trune1 \"b\" -> 4\n  4\talt -> 3, 5\n  5\tmatch\n"
}

test "compile 1" {
  assert_eq compile(parse("(a+)(b+)", PERL).unwrap).to_s, "  0\tfail\n  1*\tcap 2 -> 2\n  2\trune1 \"a\" -> 3\n  3\talt -> 2, 4\n  4\tcap 3 -> 5\n  5\tcap 4 -> 6\n  6\trune1 \"b\" -> 7\n  7\talt -> 6, 8\n  8\tcap 5 -> 9\n  9\tmatch\n"
  assert_eq compile(parse("a+|b+", PERL).unwrap).to_s, "  0\tfail\n  1\trune1 \"a\" -> 2\n  2\talt -> 1, 6\n  3\trune1 \"b\" -> 4\n  4\talt -> 3, 6\n  5*\talt -> 1, 3\n  6\tmatch\n"
  assert_eq compile(parse("A[Aa]", PERL).unwrap).to_s, "  0\tfail\n  1*\trune1 \"A\" -> 2\n  2\trune \"A\"/i -> 3\n  3\tmatch\n"
  assert_eq compile(parse("(?:(?:^).)", PERL).unwrap).to_s, "  0\tfail\n  1*\tempty 4 -> 2\n  2\tanynotnl -> 3\n  3\tmatch\n"
  assert_eq compile(parse("(?:|a)+", PERL).unwrap).to_s, "  0\tfail\n  1\tnop -> 4\n  2\trune1 \"a\" -> 4\n  3*\talt -> 1, 2\n  4\talt -> 3, 5\n  5\tmatch\n"
  assert_eq compile(parse("(?:|a)*", PERL).unwrap).to_s, "  0\tfail\n  1\tnop -> 4\n  2\trune1 \"a\" -> 4\n  3\talt -> 1, 2\n  4\talt -> 3, 6\n  5*\talt -> 3, 6\n  6\tmatch\n"
}
