import "os"
import "slices"
import "strings"

def tmp -> Str { os.mkdir_temp("", "alx-sh-test-*").unwrap }

test "files: write, append, read_lines, exists, rm_f, touch" {
  d = tmp
  write(d + "/a.txt", "one\n").unwrap
  append(d + "/a.txt", "two\n").unwrap
  assert slices.equal(read_lines(d + "/a.txt").unwrap, ["one", "two"])
  assert exists?(d + "/a.txt")
  assert file?(d + "/a.txt")
  assert dir?(d)
  rm_f(d + "/nothing").unwrap
  touch(d + "/new").unwrap
  assert file?(d + "/new")
  touch(d + "/new").unwrap
  rm_rf(d).unwrap
  assert !exists?(d)
}

test "cp, cp_r, mv into directories" {
  d = tmp
  mkdir_p(d + "/src/deep").unwrap
  write(d + "/src/deep/f.txt", "x").unwrap
  mkdir_p(d + "/out").unwrap
  cp(d + "/src/deep/f.txt", d + "/out").unwrap
  assert file?(d + "/out/f.txt")
  cp_r(d + "/src", d + "/out").unwrap
  assert file?(d + "/out/src/deep/f.txt")
  cp_r(d + "/src", d + "/copy").unwrap
  assert file?(d + "/copy/deep/f.txt")
  mv(d + "/copy", d + "/out").unwrap
  assert dir?(d + "/out/copy")
  assert !exists?(d + "/copy")
  rm_rf(d).unwrap
}

test "glob with ** and hidden files" {
  d = tmp
  mkdir_p(d + "/a/b").unwrap
  write(d + "/a/x.c", "").unwrap
  write(d + "/a/b/y.c", "").unwrap
  write(d + "/a/b/.z.c", "").unwrap
  write(d + "/top.h", "").unwrap
  names = glob(d + "/**/*.c").unwrap.map { it[d.size + 1...it.size] }.to_a
  assert slices.equal(names, ["a/b/y.c", "a/x.c"])
  assert_eq glob(d + "/**/.*.c").unwrap.size, 1
  assert_eq glob(d + "/*.h").unwrap.size, 1
  assert_eq glob(d + "/nothing*").unwrap.size, 0
  assert_eq walk(d).unwrap.size, 6
  rm_rf(d).unwrap
}

test "in_dir and with_env restore" {
  before = pwd.unwrap
  in_dir("/") { assert_eq pwd.unwrap, "/" }.unwrap
  assert_eq pwd.unwrap, before
  with_env(["ALX_SH_T=1"]) { assert_eq os.getenv("ALX_SH_T") || "", "1" }.unwrap
  assert os.getenv("ALX_SH_T").none?
  r = in_dir("/") { fail "inside" }
  assert r.err?
  assert_eq pwd.unwrap, before
}

test "lines_of and env" {
  assert slices.equal(lines_of("a\nb\n"), ["a", "b"])
  assert_eq lines_of("").size, 0
  assert_eq env("ALX_SURELY_UNSET", "dflt"), "dflt"
}

test "parallel: all run, first failure by element" {
  ok = parallel([1, 2, 3, 4, 5], 2) { |n| fail "neg" if n < 0 }
  assert ok.ok?
  bad = parallel([1, -2, 3, -4], 3) { |n| fail "bad #{n}" if n < 0 }
  assert_eq bad.err.unwrap.message, "bad -2"
}
