struct Person {
  name: Str
  age: Int
}

def nan -> Float {
  z = 0.0
  z / z
}

# Deterministic pseudo-random Ints in [0, m).
def rand_ints(n: Int, m: Int, seed: Int) -> [Int] {
  out: [Int] = []
  x = seed
  for _ in 0...n {
    x = (x * 1103515245 + 12345) % 2147483648
    out << (x / 16) % m
  }
  out
}

def sorted_ok(xs: [Int]) -> Bool {
  for i in 1...xs.size {
    return false if xs[i] < xs[i - 1]
  }
  true
}

def asc(a: Int, b: Int) -> Int {
  return -1 if a < b
  return 1 if a > b
  0
}

test "index and contains" {
  assert_eq index([1, 2, 3], 3), 2
  assert_eq index([1, 2, 3], 9), -1
  assert_eq index(ints(), 1), -1
  assert_eq index(["a", "b"], "b"), 1
  assert_eq index_func([1, 2, 3], ->(x: Int) -> Bool { x == 2 }), 1
  assert_eq index_func([1, 2, 3], ->(x: Int) -> Bool { x > 5 }), -1
  assert contains([1, 2], 2)
  assert !contains([1, 2], 3)
  assert contains_func(["a", "bb"], ->(s: Str) -> Bool { s.size == 2 })
  assert !contains_func(strs(), ->(s: Str) -> Bool { true })
}

test "equal and compare" {
  assert equal([1, 2], [1, 2])
  assert equal(ints(), ints())
  assert !equal([1, 2], [1, 3])
  assert !equal([1, 2], [1, 2, 3])
  assert equal_func([1, 2], ["a", "bb"], ->(i: Int, s: Str) -> Bool { s.size == i })
  assert !equal_func([1], ["a", "b"], ->(i: Int, s: Str) -> Bool { true })
  assert_eq compare([1, 2], [1, 2]), 0
  assert_eq compare([1, 2], [1, 3]), -1
  assert_eq compare([1, 3], [1, 2]), 1
  assert_eq compare([1, 2], [1, 2, 0]), -1
  assert_eq compare([1, 2, 0], [1, 2]), 1
  assert_eq compare(ints(), ints()), 0
  assert_eq compare(["b"], ["a", "z"]), 1
  assert_eq compare([nan], [1.0]), -1
  assert_eq compare([1.0], [nan]), 1
  assert_eq compare([nan], [nan]), 0
  assert_eq compare_func([3, 2], [1, 2], ->(a: Int, b: Int) -> Int { asc(b, a) }), -1
  assert_eq compare_func([1], [1, 2], ->(a: Int, b: Int) -> Int { asc(a, b) }), -1
}

test "binary_search" {
  xs = [1, 3, 5, 7, 9]
  pos, found = binary_search(xs, 5)
  assert found
  assert_eq pos, 2
  pos, found = binary_search(xs, 6)
  assert !found
  assert_eq pos, 3
  pos, found = binary_search(xs, 0)
  assert !found
  assert_eq pos, 0
  pos, found = binary_search(xs, 10)
  assert !found
  assert_eq pos, 5
  pos, found = binary_search(ints(), 1)
  assert !found
  assert_eq pos, 0
  pos, found = binary_search([2, 2, 2, 4], 2)
  assert found
  assert_eq pos, 0
  pos, found = binary_search(["a", "c"], "b")
  assert !found
  assert_eq pos, 1
  pos, found = binary_search([nan, 1.0, 2.0], nan)
  assert found
  assert_eq pos, 0
  pos, found = binary_search([1.0, 2.0], nan)
  assert !found
  assert_eq pos, 0
}

test "binary_search_func" {
  people = [Person.new(name: "a", age: 20), Person.new(name: "b", age: 30), Person.new(name: "c", age: 40)]
  by_age = ->(p: Person, age: Int) -> Int { asc(p.age, age) }
  pos, found = binary_search_func(people, 30, by_age)
  assert found
  assert_eq pos, 1
  pos, found = binary_search_func(people, 35, by_age)
  assert !found
  assert_eq pos, 2
  pos, found = binary_search_func(people, 99, by_age)
  assert_eq pos, 3
  assert !found
}

test "clone and clip" {
  a = [1, 2, 3]
  b = clone(a)
  b[0] = 9
  assert_eq a[0], 1
  c = clip(a)
  c << 4
  assert_eq a.size, 3
  assert_eq c.size, 4
  assert_eq clone(ints()).size, 0
}

test "compact" {
  assert equal(compact([1, 1, 2, 2, 2, 3, 1, 1]), [1, 2, 3, 1])
  assert equal(compact(ints()), ints())
  assert equal(compact([5]), [5])
  assert equal(compact([4, 4, 4]), [4])
  assert equal(compact(["a", "a", "b"]), ["a", "b"])
  assert_eq compact([nan, nan]).size, 2
  assert equal(compact_func([1, 2, 4, 5, 8], ->(a: Int, b: Int) -> Bool { a % 2 == b % 2 }), [1, 2, 5, 8])
  assert_eq compact_func(ints(), ->(a: Int, b: Int) -> Bool { true }).size, 0
}

test "delete" {
  assert equal(delete([1, 2, 3, 4, 5], 1, 3), [1, 4, 5])
  assert equal(delete([1, 2, 3], 0, 3), ints())
  assert equal(delete([1, 2, 3], 1, 1), [1, 2, 3])
  assert equal(delete([1, 2, 3], 3, 3), [1, 2, 3])
  assert equal(delete([1, 2, 3], 0, 1), [2, 3])
  assert equal(delete([1, 2, 3], 2, 3), [1, 2])
  assert_eq delete(ints(), 0, 0).size, 0
  xs = [1, 2, 3, 4]
  ys = delete(xs, 0, 2)
  assert equal(ys, [3, 4])
  assert_eq xs[0], 3
  assert equal(delete_func([1, 2, 3, 4, 5, 6], ->(x: Int) -> Bool { x % 2 == 0 }), [1, 3, 5])
  assert_eq delete_func([2, 4], ->(x: Int) -> Bool { true }).size, 0
  assert equal(delete_func([1, 3], ->(x: Int) -> Bool { false }), [1, 3])
}

test "grow" {
  xs = grow([1, 2], 100)
  assert equal(xs, [1, 2])
}

test "insert" {
  assert equal(insert([1, 2, 5], 2, [3, 4]), [1, 2, 3, 4, 5])
  assert equal(insert([1, 2], 0, [0]), [0, 1, 2])
  assert equal(insert([1, 2], 2, [3]), [1, 2, 3])
  assert equal(insert([1, 2], 1, ints()), [1, 2])
  assert equal(insert(ints(), 0, [7, 8]), [7, 8])
  assert_eq insert(ints(), 0, ints()).size, 0
  a = [1, 2]
  b = insert(a, 1, [9])
  b[0] = 100
  assert_eq a[0], 1
  assert equal(insert(["a"], 1, ["b"]), ["a", "b"])
}

test "min and max" {
  assert_eq max([3, 9, 2]), 9
  assert_eq min([3, 9, 2]), 2
  assert_eq max([7]), 7
  assert_eq min(["b", "a", "c"]), "a"
  assert_eq max(["b", "a", "c"]), "c"
  assert_eq max([1.5, 2.5, -1.0]), 2.5
  assert max([1.0, nan, 3.0]) != max([1.0, nan, 3.0])
  assert min([1.0, 3.0, nan]) != min([1.0, 3.0, nan])
  assert min([nan, 1.0]) != min([nan, 1.0])
  people = [Person.new(name: "a", age: 30), Person.new(name: "b", age: 40), Person.new(name: "c", age: 40), Person.new(name: "d", age: 30)]
  by_age = ->(x: Person, y: Person) -> Int { asc(x.age, y.age) }
  assert_eq max_func(people, by_age).name, "b"
  assert_eq min_func(people, by_age).name, "a"
}

test "min and max panic on empty" {
  empty: [Int] = []
  int_cmp = ->(a: Int, b: Int) -> Int { a - b }
  assert_panics { min(empty) }
  assert_panics { max(empty) }
  assert_panics { min_func(empty, int_cmp) }
  assert_panics { max_func(empty, int_cmp) }
}

test "replace" {
  assert equal(replace([1, 2, 3, 4], 1, 3, [9]), [1, 9, 4])
  assert equal(replace([1, 2, 3], 1, 1, [7, 8]), [1, 7, 8, 2, 3])
  assert_eq replace([1, 2, 3], 0, 3, ints()).size, 0
  assert equal(replace([1, 2, 3], 0, 3, [4]), [4])
  assert equal(replace(ints(), 0, 0, [4]), [4])
  assert equal(replace([1, 2], 2, 2, [3]), [1, 2, 3])
}

test "reverse" {
  a = [1, 2, 3, 4]
  reverse(a)
  assert equal(a, [4, 3, 2, 1])
  b = [1, 2, 3]
  reverse(b)
  assert equal(b, [3, 2, 1])
  c: [Int] = []
  reverse(c)
  assert_eq c.size, 0
  d = [1]
  reverse(d)
  assert equal(d, [1])
  e = [1, 2, 3, 4, 5]
  reverse(e[1...4])
  assert equal(e, [1, 4, 3, 2, 5])
}

test "repeat and concat" {
  assert equal(repeat([1, 2], 3), [1, 2, 1, 2, 1, 2])
  assert_eq repeat([1, 2], 0).size, 0
  assert_eq repeat(ints(), 5).size, 0
  assert equal(repeat(["x"], 2), ["x", "x"])
  assert equal(concat([[1, 2], ints(), [3], [4, 5]]), [1, 2, 3, 4, 5])
  assert_eq concat(nested()).size, 0
  assert_eq concat([ints(), ints()]).size, 0
  assert equal(concat([["a"], ["b"]]), ["a", "b"])
}

test "is_sorted" {
  assert is_sorted(ints())
  assert is_sorted([1])
  assert is_sorted([1, 1, 2])
  assert !is_sorted([2, 1])
  assert is_sorted([nan, 1.0, 2.0])
  assert !is_sorted([1.0, nan])
  assert is_sorted(["a", "b"])
  assert is_sorted_func([3, 2, 1], ->(a: Int, b: Int) -> Int { asc(b, a) })
  assert !is_sorted_func([1, 2, 1], ->(a: Int, b: Int) -> Int { asc(a, b) })
}

test "sort small" {
  a = [5, 2, 8, 1, 9, 3]
  sort(a)
  assert equal(a, [1, 2, 3, 5, 8, 9])
  b: [Int] = []
  sort(b)
  assert_eq b.size, 0
  c = [1]
  sort(c)
  assert equal(c, [1])
  d = [2, 1]
  sort(d)
  assert equal(d, [1, 2])
  s = ["pear", "apple", "fig"]
  sort(s)
  assert equal(s, ["apple", "fig", "pear"])
}

test "sort patterns" {
  for n in [0, 1, 2, 3, 12, 13, 14, 50, 101, 257, 1000, 5000] {
    # random, many duplicates, all equal, sorted, reversed, organ pipe, sawtooth
    cases = [rand_ints(n, 1000000, n + 1), rand_ints(n, 5, n + 2), rand_ints(n, 1, 3)]
    asc_ = rand_ints(n, 1000000, 7)
    sort(asc_)
    desc = clone(asc_)
    reverse(desc)
    pipe: [Int] = []
    saw: [Int] = []
    for i in 0...n {
      pipe << (i < n / 2 ? i : n - i)
      saw << i % 17
    }
    cases << asc_
    cases << desc
    cases << pipe
    cases << saw
    for c in cases {
      want = c.sort
      got = clone(c)
      sort(got)
      assert sorted_ok(got)
      assert equal(got, want)
      got2 = clone(c)
      sort_func(got2, ->(a: Int, b: Int) -> Int { asc(a, b) })
      assert equal(got2, want)
      got3 = clone(c)
      sort_stable_func(got3, ->(a: Int, b: Int) -> Int { asc(a, b) })
      assert equal(got3, want)
    }
  }
}

test "sort adversarial" {
  # the classic quicksort killer: median-of-3 "organ" and interleaved patterns
  n = 20000
  a: [Int] = []
  for i in 0...n {
    a << (i % 2 == 0 ? i / 2 : n - i / 2)
  }
  sort(a)
  assert sorted_ok(a)
  b: [Int] = []
  for i in 0...n {
    b << (i * 7919) % n
  }
  sort_func(b, ->(a: Int, b: Int) -> Int { asc(a, b) })
  assert sorted_ok(b)
}

test "sort floats with NaN" {
  a = [3.0, nan, 1.0, nan, 2.0, -1.0]
  sort(a)
  assert a[0] != a[0]
  assert a[1] != a[1]
  assert_eq a[2], -1.0
  assert_eq a[3], 1.0
  assert_eq a[4], 2.0
  assert_eq a[5], 3.0
  b = [nan, nan]
  sort(b)
  assert_eq b.size, 2
  c = [2.5, 1.5, 0.5]
  sort(c)
  assert equal(c, [0.5, 1.5, 2.5])
}

test "sort_func with a descending order" {
  a = [3, 1, 2, 5, 4, 3]
  sort_func(a, ->(x: Int, y: Int) -> Int { asc(y, x) })
  assert equal(a, [5, 4, 3, 3, 2, 1])
}

test "sort_stable_func keeps the order of equals" {
  people: [Person] = []
  x = 1
  for i in 0...500 {
    x = (x * 1103515245 + 12345) % 2147483648
    people << Person.new(name: "p#{i}", age: (x / 16) % 10)
  }
  sort_stable_func(people, ->(a: Person, b: Person) -> Int { asc(a.age, b.age) })
  for i in 1...people.size {
    assert people[i - 1].age <= people[i].age
    if people[i - 1].age == people[i].age {
      assert people[i - 1].name.size < people[i].name.size || (people[i - 1].name.size == people[i].name.size && people[i - 1].name < people[i].name)
    }
  }
  # sort_func on the same data is a permutation sorted by age
  other = clone(people)
  sort_func(other, ->(a: Person, b: Person) -> Int { asc(a.age, b.age) })
  assert_eq other.size, 500
  assert is_sorted_func(other, ->(a: Person, b: Person) -> Int { asc(a.age, b.age) })
}

test "sorting structs and strings by key" {
  words = ["banana", "kiwi", "apple", "fig", "cherry"]
  sort_func(words, ->(a: Str, b: Str) -> Int { asc(a.size, b.size) })
  assert_eq words[0], "fig"
  assert_eq words[4].size, 6
}

test "sorts a subslice in place" {
  a = [9, 8, 7, 6, 5, 4]
  sort(a[1...5])
  assert equal(a, [9, 5, 6, 7, 8, 4])
}

def ints -> [Int] {
  out: [Int] = []
  out
}

def strs -> [Str] {
  out: [Str] = []
  out
}

def nested -> [[Int]] {
  out: [[Int]] = []
  out
}

bench "sort 100k random Ints" {
  xs = rand_ints(100000, 1000000000, 42)
  sort(xs)
}

bench "sort_func 100k random Ints" {
  xs = rand_ints(100000, 1000000000, 42)
  sort_func(xs, ->(a: Int, b: Int) -> Int { asc(a, b) })
}

bench "builtin sort 100k random Ints" {
  xs = rand_ints(100000, 1000000000, 42)
  ys = xs.sort
  assert ys.size == 100000
}

bench "rand_ints 100k (baseline)" {
  xs = rand_ints(100000, 1000000000, 42)
  assert xs.size == 100000
}
