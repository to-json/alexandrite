# Sorting kernels, instantiated three ways by gen_sort.py (see the header of
# the generated file): ordered (`<`), `cmp` (a function returning an Int that
# is negative, zero or positive) and `less` (a function returning a Bool).
# LT(a, b) is "a sorts before b". All ranges are [lo, hi).

# Insertion sort. Stable: an element moves past only strictly greater ones.
def insertion_sort{S}[T](xs: [T], lo: Int, hi: Int{P}) {
  i = lo + 1
  while i < hi {
    v = xs[i]
    j = i
    while j > lo && LT(v, xs[j - 1]) {
      xs[j] = xs[j - 1]
      j -= 1
    }
    xs[j] = v
    i += 1
  }
}

def sift_down{S}[T](xs: [T], lo: Int, first: Int, n: Int{P}) {
  root = first
  while true {
    child = 2 * root + 1
    break if child >= n
    child += 1 if child + 1 < n && LT(xs[lo + child], xs[lo + child + 1])
    break if !LT(xs[lo + root], xs[lo + child])
    t = xs[lo + root]
    xs[lo + root] = xs[lo + child]
    xs[lo + child] = t
    root = child
  }
}

# The fallback that bounds the worst case at O(n log n).
def heap_sort{S}[T](xs: [T], lo: Int, hi: Int{P}) {
  n = hi - lo
  i = (n - 1) / 2
  while i >= 0 {
    sift_down{S}(xs, lo, i, n{A})
    i -= 1
  }
  i = n - 1
  while i >= 1 {
    t = xs[lo]
    xs[lo] = xs[lo + i]
    xs[lo + i] = t
    sift_down{S}(xs, lo, 0, i{A})
    i -= 1
  }
}

# The index of the median of xs[a], xs[b], xs[c].
def median3{S}[T](xs: [T], a: Int, b: Int, c: Int{P}) -> Int {
  if LT(xs[a], xs[b]) {
    return b if LT(xs[b], xs[c])
    return c if LT(xs[a], xs[c])
    return a
  }
  return a if LT(xs[a], xs[c])
  return c if LT(xs[b], xs[c])
  b
}

# Moves a median-of-3 (median of medians for long ranges) pivot to xs[lo].
def choose_pivot{S}[T](xs: [T], lo: Int, hi: Int{P}) {
  n = hi - lo
  m = lo + n / 2
  p = 0
  if n > 100 {
    s = n / 8
    a = median3{S}(xs, lo, lo + s, lo + 2 * s{A})
    b = median3{S}(xs, m - s, m, m + s{A})
    c = median3{S}(xs, hi - 1 - 2 * s, hi - 1 - s, hi - 1{A})
    p = median3{S}(xs, a, b, c{A})
  } else {
    p = median3{S}(xs, lo, m, hi - 1{A})
  }
  t = xs[lo]
  xs[lo] = xs[p]
  xs[p] = t
}

# Introsort: Hoare-partition quicksort (equal keys stop both scans, so runs of
# duplicates split evenly), insertion sort for short ranges, heapsort when the
# recursion gets deeper than 2 log2 n. Recurses into the shorter side.
def quick_sort{S}[T](xs: [T], lo: Int, hi: Int, limit: Int{P}) -> Unit {
  while hi - lo > 12 {
    if limit == 0 {
      heap_sort{S}(xs, lo, hi{A})
      return
    }
    limit -= 1
    choose_pivot{S}(xs, lo, hi{A})
    pv = xs[lo]
    i = lo - 1
    j = hi
    while true {
      i += 1
      while LT(xs[i], pv) { i += 1 }
      j -= 1
      while LT(pv, xs[j]) { j -= 1 }
      break if i >= j
      t = xs[i]
      xs[i] = xs[j]
      xs[j] = t
    }
    if j + 1 - lo < hi - j - 1 {
      quick_sort{S}(xs, lo, j + 1, limit{A})
      lo = j + 1
    } else {
      quick_sort{S}(xs, j + 1, hi, limit{A})
      hi = j + 1
    }
  }
  insertion_sort{S}(xs, lo, hi{A})
}

def reverse_range{S}[T](xs: [T], lo: Int, hi: Int) {
  i = lo
  j = hi - 1
  while i < j {
    t = xs[i]
    xs[i] = xs[j]
    xs[j] = t
    i += 1
    j -= 1
  }
}

# Sorts xs[lo...hi]: O(n) when it is already sorted or strictly descending.
def sort_range{S}[T](xs: [T], lo: Int, hi: Int{P}) {
  return if hi - lo < 2
  i = lo + 1
  while i < hi && !LT(xs[i], xs[i - 1]) { i += 1 }
  return if i == hi
  j = lo + 1
  while j < hi && LT(xs[j], xs[j - 1]) { j += 1 }
  if j == hi {
    reverse_range{S}(xs, lo, hi)
    return
  }
  limit = 0
  n = hi - lo
  while n > 0 {
    limit += 2
    n = n / 2
  }
  quick_sort{S}(xs, lo, hi, limit{A})
}

# Stable merge sort; `buf` is scratch space the size of xs.
def merge_sort{S}[T](xs: [T], buf: [T], lo: Int, hi: Int{P}) -> Unit {
  if hi - lo <= 12 {
    insertion_sort{S}(xs, lo, hi{A})
    return
  }
  mid = lo + (hi - lo) / 2
  merge_sort{S}(xs, buf, lo, mid{A})
  merge_sort{S}(xs, buf, mid, hi{A})
  return if !LT(xs[mid], xs[mid - 1])
  copy(buf[lo...mid], xs[lo...mid])
  i = lo
  j = mid
  k = lo
  while i < mid && j < hi {
    if LT(xs[j], buf[i]) {
      xs[k] = xs[j]
      j += 1
    } else {
      xs[k] = buf[i]
      i += 1
    }
    k += 1
  }
  while i < mid {
    xs[k] = buf[i]
    i += 1
    k += 1
  }
}

def stable_sort{S}[T](xs: [T]{P}) {
  return if xs.size < 2
  buf = xs.dup
  merge_sort{S}(xs, buf, 0, xs.size{A})
}
