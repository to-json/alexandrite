# Go's zsortordered.go (twice: `<`, and cmp.Less for floats) and zsortanyfunc.go.

# Sorts data[a...b] using insertion sort.
def insertion_sort_ordered[T](data: [T], a: Int, b: Int) {
  i = a + 1
  while i < b {
    j = i
    while j > a && (data[j] < data[j - 1]) {
      t = data[j]
      data[j] = data[j - 1]
      data[j - 1] = t
      j -= 1
    }
    i += 1
  }
}

# Implements the heap property on data[lo...hi]; first is an offset into the
# array where the root of the heap lies.
def sift_down_ordered[T](data: [T], lo: Int, hi: Int, first: Int) {
  root = lo
  loop {
    child = 2 * root + 1
    break if child >= hi
    if child + 1 < hi && (data[first + child] < data[first + child + 1]) {
      child += 1
    }
    return if !(data[first + root] < data[first + child])
    t = data[first + root]
    data[first + root] = data[first + child]
    data[first + child] = t
    root = child
  }
}

def heap_sort_ordered[T](data: [T], a: Int, b: Int) {
  first = a
  lo = 0
  hi = b - a
  # Build heap with greatest element at top.
  i = (hi - 1) / 2
  while i >= 0 {
    sift_down_ordered(data, i, hi, first)
    i -= 1
  }
  # Pop elements, largest first, into end of data.
  i = hi - 1
  while i >= 0 {
    t = data[first]
    data[first] = data[first + i]
    data[first + i] = t
    sift_down_ordered(data, lo, i, first)
    i -= 1
  }
}

# Sorts data[a...b]. The algorithm is based on pattern-defeating quicksort
# (pdqsort), but without the optimizations from BlockQuicksort
# (https://github.com/orlp/pdqsort). limit is the number of allowed bad
# (very unbalanced) pivots before falling back to heapsort.
def pdqsort_ordered[T](data: [T], a: Int, b: Int, limit: Int) -> Unit {
  max_insertion = 12
  # whether the last partitioning was reasonably balanced
  was_balanced = true
  # whether the slice was already partitioned
  was_partitioned = true
  loop {
    length = b - a
    if length <= max_insertion {
      insertion_sort_ordered(data, a, b)
      return
    }
    # Fall back to heapsort if too many bad choices were made.
    if limit == 0 {
      heap_sort_ordered(data, a, b)
      return
    }
    # If the last partitioning was imbalanced, we need to break patterns.
    if !was_balanced {
      break_patterns_ordered(data, a, b)
      limit -= 1
    }
    pivot, hint = choose_pivot_ordered(data, a, b)
    if hint == DECREASING_HINT {
      reverse_range_ordered(data, a, b)
      # The chosen pivot was pivot-a elements after the start of the array.
      # After reversing it is pivot-a elements before the end of the array.
      # The idea came from Rust's implementation.
      pivot = (b - 1) - (pivot - a)
      hint = INCREASING_HINT
    }
    # The slice is likely already sorted.
    if was_balanced && was_partitioned && hint == INCREASING_HINT {
      return if partial_insertion_sort_ordered(data, a, b)
    }
    # Probably the slice contains many duplicate elements, partition the
    # slice into elements equal to and elements greater than the pivot.
    if a > 0 && !(data[a - 1] < data[pivot]) {
      a = partition_equal_ordered(data, a, b, pivot)
      next
    }
    mid, already_partitioned = partition_ordered(data, a, b, pivot)
    was_partitioned = already_partitioned
    left_len = mid - a
    right_len = b - mid
    balance_threshold = length / 8
    if left_len < right_len {
      was_balanced = left_len >= balance_threshold
      pdqsort_ordered(data, a, mid, limit)
      a = mid + 1
    } else {
      was_balanced = right_len >= balance_threshold
      pdqsort_ordered(data, mid + 1, b, limit)
      b = mid
    }
  }
}

# Does one quicksort partition. Let p = data[pivot]. Moves elements in
# data[a...b] around, so that data[i] < p and data[j] >= p for i < newpivot
# and j > newpivot. On return, data[newpivot] = p.
def partition_ordered[T](data: [T], a: Int, b: Int, pivot: Int) -> (Int, Bool) {
  t = data[a]
  data[a] = data[pivot]
  data[pivot] = t
  i = a + 1
  j = b - 1 # i and j are inclusive of the elements remaining to be partitioned
  while i <= j && (data[i] < data[a]) { i += 1 }
  while i <= j && !(data[j] < data[a]) { j -= 1 }
  if i > j {
    t = data[j]
    data[j] = data[a]
    data[a] = t
    return (j, true)
  }
  t = data[i]
  data[i] = data[j]
  data[j] = t
  i += 1
  j -= 1
  loop {
    while i <= j && (data[i] < data[a]) { i += 1 }
    while i <= j && !(data[j] < data[a]) { j -= 1 }
    break if i > j
    t = data[i]
    data[i] = data[j]
    data[j] = t
    i += 1
    j -= 1
  }
  t = data[j]
  data[j] = data[a]
  data[a] = t
  (j, false)
}

# Partitions data[a...b] into elements equal to data[pivot] followed by
# elements greater than data[pivot]. It assumes that data[a...b] does not
# contain elements smaller than the data[pivot].
def partition_equal_ordered[T](data: [T], a: Int, b: Int, pivot: Int) -> Int {
  t = data[a]
  data[a] = data[pivot]
  data[pivot] = t
  i = a + 1
  j = b - 1 # i and j are inclusive of the elements remaining to be partitioned
  loop {
    while i <= j && !(data[a] < data[i]) { i += 1 }
    while i <= j && (data[a] < data[j]) { j -= 1 }
    break if i > j
    t = data[i]
    data[i] = data[j]
    data[j] = t
    i += 1
    j -= 1
  }
  i
}

# Partially sorts a slice, returns true if the slice is sorted at the end.
def partial_insertion_sort_ordered[T](data: [T], a: Int, b: Int) -> Bool {
  # maximum number of adjacent out-of-order pairs that will get shifted
  max_steps = 5
  # don't shift any elements on short arrays
  shortest_shifting = 50
  i = a + 1
  step = 0
  while step < max_steps {
    while i < b && !(data[i] < data[i - 1]) { i += 1 }
    return true if i == b
    return false if b - a < shortest_shifting
    t = data[i]
    data[i] = data[i - 1]
    data[i - 1] = t
    # Shift the smaller one to the left.
    if i - a >= 2 {
      j = i - 1
      while j >= 1 {
        break if !(data[j] < data[j - 1])
        t = data[j]
        data[j] = data[j - 1]
        data[j - 1] = t
        j -= 1
      }
    }
    # Shift the greater one to the right.
    if b - i >= 2 {
      j = i + 1
      while j < b {
        break if !(data[j] < data[j - 1])
        t = data[j]
        data[j] = data[j - 1]
        data[j - 1] = t
        j += 1
      }
    }
    step += 1
  }
  false
}

# Scatters some elements around in an attempt to break some patterns that
# might cause imbalanced partitions in quicksort.
def break_patterns_ordered[T](data: [T], a: Int, b: Int) {
  length = b - a
  if length >= 8 {
    random = length.as_u64 # Go's xorshift
    modulus = next_power_of_two(length)
    idx = a + (length / 4) * 2 - 1
    while idx <= a + (length / 4) * 2 + 1 {
      random ^= random << 13
      random ^= random >> 7
      random ^= random << 17
      other = (random & (modulus - 1)).as_i64
      other -= length if other >= length
      t = data[idx]
      data[idx] = data[a + other]
      data[a + other] = t
      idx += 1
    }
  }
}

# Chooses a pivot in data[a...b]: the median of 3, or the Tukey ninther
# (median of medians) for slices of 50 or more. Also returns a hint about
# the order: INCREASING_HINT if no swaps were needed (possibly sorted),
# DECREASING_HINT if all were (possibly reverse sorted), else UNKNOWN_HINT.
def choose_pivot_ordered[T](data: [T], a: Int, b: Int) -> (Int, Int) {
  shortest_ninther = 50
  max_swaps = 4 * 3
  l = b - a
  swaps = 0
  i = a + l / 4 * 1
  j = a + l / 4 * 2
  k = a + l / 4 * 3
  if l >= 8 {
    if l >= shortest_ninther {
      # Tukey ninther method, the idea came from Rust's implementation.
      i, swaps = median_adjacent_ordered(data, i, swaps)
      j, swaps = median_adjacent_ordered(data, j, swaps)
      k, swaps = median_adjacent_ordered(data, k, swaps)
    }
    # Find the median among i, j, k and stores it into j.
    j, swaps = median_ordered(data, i, j, k, swaps)
  }
  return (j, INCREASING_HINT) if swaps == 0
  return (j, DECREASING_HINT) if swaps == max_swaps
  (j, UNKNOWN_HINT)
}

# Returns (x, y, swaps) where data[x] <= data[y], with (x, y) one of (a, b)
# and (b, a).
def order2_ordered[T](data: [T], a: Int, b: Int, swaps: Int) -> (Int, Int, Int) {
  return (b, a, swaps + 1) if (data[b] < data[a])
  (a, b, swaps)
}

# Returns x where data[x] is the median of data[a], data[b], data[c], with x
# one of a, b, c, and the updated swap count.
def median_ordered[T](data: [T], a: Int, b: Int, c: Int, swaps: Int) -> (Int, Int) {
  a, b, swaps = order2_ordered(data, a, b, swaps)
  b, _, swaps = order2_ordered(data, b, c, swaps)
  _, b, swaps = order2_ordered(data, a, b, swaps)
  (b, swaps)
}

# Finds the median of data[a - 1], data[a], data[a + 1] and stores the
# index into a.
def median_adjacent_ordered[T](data: [T], a: Int, swaps: Int) -> (Int, Int) {
  median_ordered(data, a - 1, a, a + 1, swaps)
}

def reverse_range_ordered[T](data: [T], a: Int, b: Int) {
  i = a
  j = b - 1
  while i < j {
    t = data[i]
    data[i] = data[j]
    data[j] = t
    i += 1
    j -= 1
  }
}

def swap_range_ordered[T](data: [T], a: Int, b: Int, n: Int) {
  i = 0
  while i < n {
    t = data[a + i]
    data[a + i] = data[b + i]
    data[b + i] = t
    i += 1
  }
}

# Insertion sort on blocks of 20, then SymMerge on doubling block sizes: a
# stable sort with O(n*log(n)) calls to LESS and O(n*log(n)*log(n)) calls to
# SWAP, in place.
def stable_sort_ordered[T](data: [T], n: Int) {
  block_size = 20 # must be > 0
  a = 0
  b = block_size
  while b <= n {
    insertion_sort_ordered(data, a, b)
    a = b
    b += block_size
  }
  insertion_sort_ordered(data, a, n)
  while block_size < n {
    a = 0
    b = 2 * block_size
    while b <= n {
      sym_merge_ordered(data, a, a + block_size, b)
      a = b
      b += 2 * block_size
    }
    m = a + block_size
    if m < n {
      sym_merge_ordered(data, a, m, n)
    }
    block_size *= 2
  }
}

# Merges the two sorted subsequences data[a...m] and data[m...b] using the
# SymMerge algorithm from Pok-Son Kim and Arne Kutzner, "Stable Minimum
# Storage Merging by Symmetric Comparisons", in Susanne Albers and Tomasz
# Radzik, editors, Algorithms - ESA 2004, volume 3221 of Lecture Notes in
# Computer Science, pages 714-723. Springer, 2004.
def sym_merge_ordered[T](data: [T], a: Int, m: Int, b: Int) -> Unit {
  # Avoid unnecessary recursions of sym_merge by direct insertion of
  # data[a] into data[m...b] if data[a...m] only contains one element.
  if m - a == 1 {
    # Use binary search to find the lowest index i such that
    # data[i] >= data[a] for m <= i < b. Exit the search loop with i == b in
    # case no such index exists.
    i = m
    j = b
    while i < j {
      h = (i + j) / 2
      if (data[h] < data[a]) {
        i = h + 1
      } else {
        j = h
      }
    }
    # Swap values until data[a] reaches the position before i.
    k = a
    while k < i - 1 {
      t = data[k]
      data[k] = data[k + 1]
      data[k + 1] = t
      k += 1
    }
    return
  }
  # Avoid unnecessary recursions of sym_merge by direct insertion of
  # data[m] into data[a...m] if data[m...b] only contains one element.
  if b - m == 1 {
    # Use binary search to find the lowest index i such that
    # data[i] > data[m] for a <= i < m. Exit the search loop with i == m in
    # case no such index exists.
    i = a
    j = m
    while i < j {
      h = (i + j) / 2
      if !(data[m] < data[h]) {
        i = h + 1
      } else {
        j = h
      }
    }
    # Swap values until data[m] reaches the position i.
    k = m
    while k > i {
      t = data[k]
      data[k] = data[k - 1]
      data[k - 1] = t
      k -= 1
    }
    return
  }
  mid = (a + b) / 2
  n = mid + m
  start = 0
  r = 0
  if m > mid {
    start = n - b
    r = mid
  } else {
    start = a
    r = m
  }
  p = n - 1
  while start < r {
    c = (start + r) / 2
    if !(data[p - c] < data[c]) {
      start = c + 1
    } else {
      r = c
    }
  }
  end = n - start
  if start < m && m < end {
    rotate_ordered(data, start, m, end)
  }
  if a < start && start < mid {
    sym_merge_ordered(data, a, start, mid)
  }
  if mid < end && end < b {
    sym_merge_ordered(data, mid, end, b)
  }
}

# Rotates two consecutive blocks u = data[a...m] and v = data[m...b]:
# data[a...b] becomes v + u. Uses at most b - a swaps.
def rotate_ordered[T](data: [T], a: Int, m: Int, b: Int) {
  i = m - a
  j = b - m
  while i != j {
    if i > j {
      swap_range_ordered(data, m - i, m, j)
      i -= j
    } else {
      swap_range_ordered(data, m - i, m + j - i, i)
      j -= i
    }
  }
  # i == j
  swap_range_ordered(data, m - i, m, i)
}

# Sorts data[a...b] using insertion sort.
def insertion_sort_ordered_nan[T](data: [T], a: Int, b: Int) {
  i = a + 1
  while i < b {
    j = i
    while j > a && (data[j] < data[j - 1] || (data[j] != data[j] && data[j - 1] == data[j - 1])) {
      t = data[j]
      data[j] = data[j - 1]
      data[j - 1] = t
      j -= 1
    }
    i += 1
  }
}

# Implements the heap property on data[lo...hi]; first is an offset into the
# array where the root of the heap lies.
def sift_down_ordered_nan[T](data: [T], lo: Int, hi: Int, first: Int) {
  root = lo
  loop {
    child = 2 * root + 1
    break if child >= hi
    if child + 1 < hi && (data[first + child] < data[first + child + 1] || (data[first + child] != data[first + child] && data[first + child + 1] == data[first + child + 1])) {
      child += 1
    }
    return if !(data[first + root] < data[first + child] || (data[first + root] != data[first + root] && data[first + child] == data[first + child]))
    t = data[first + root]
    data[first + root] = data[first + child]
    data[first + child] = t
    root = child
  }
}

def heap_sort_ordered_nan[T](data: [T], a: Int, b: Int) {
  first = a
  lo = 0
  hi = b - a
  # Build heap with greatest element at top.
  i = (hi - 1) / 2
  while i >= 0 {
    sift_down_ordered_nan(data, i, hi, first)
    i -= 1
  }
  # Pop elements, largest first, into end of data.
  i = hi - 1
  while i >= 0 {
    t = data[first]
    data[first] = data[first + i]
    data[first + i] = t
    sift_down_ordered_nan(data, lo, i, first)
    i -= 1
  }
}

# Sorts data[a...b]. The algorithm is based on pattern-defeating quicksort
# (pdqsort), but without the optimizations from BlockQuicksort
# (https://github.com/orlp/pdqsort). limit is the number of allowed bad
# (very unbalanced) pivots before falling back to heapsort.
def pdqsort_ordered_nan[T](data: [T], a: Int, b: Int, limit: Int) -> Unit {
  max_insertion = 12
  # whether the last partitioning was reasonably balanced
  was_balanced = true
  # whether the slice was already partitioned
  was_partitioned = true
  loop {
    length = b - a
    if length <= max_insertion {
      insertion_sort_ordered_nan(data, a, b)
      return
    }
    # Fall back to heapsort if too many bad choices were made.
    if limit == 0 {
      heap_sort_ordered_nan(data, a, b)
      return
    }
    # If the last partitioning was imbalanced, we need to break patterns.
    if !was_balanced {
      break_patterns_ordered_nan(data, a, b)
      limit -= 1
    }
    pivot, hint = choose_pivot_ordered_nan(data, a, b)
    if hint == DECREASING_HINT {
      reverse_range_ordered_nan(data, a, b)
      # The chosen pivot was pivot-a elements after the start of the array.
      # After reversing it is pivot-a elements before the end of the array.
      # The idea came from Rust's implementation.
      pivot = (b - 1) - (pivot - a)
      hint = INCREASING_HINT
    }
    # The slice is likely already sorted.
    if was_balanced && was_partitioned && hint == INCREASING_HINT {
      return if partial_insertion_sort_ordered_nan(data, a, b)
    }
    # Probably the slice contains many duplicate elements, partition the
    # slice into elements equal to and elements greater than the pivot.
    if a > 0 && !(data[a - 1] < data[pivot] || (data[a - 1] != data[a - 1] && data[pivot] == data[pivot])) {
      a = partition_equal_ordered_nan(data, a, b, pivot)
      next
    }
    mid, already_partitioned = partition_ordered_nan(data, a, b, pivot)
    was_partitioned = already_partitioned
    left_len = mid - a
    right_len = b - mid
    balance_threshold = length / 8
    if left_len < right_len {
      was_balanced = left_len >= balance_threshold
      pdqsort_ordered_nan(data, a, mid, limit)
      a = mid + 1
    } else {
      was_balanced = right_len >= balance_threshold
      pdqsort_ordered_nan(data, mid + 1, b, limit)
      b = mid
    }
  }
}

# Does one quicksort partition. Let p = data[pivot]. Moves elements in
# data[a...b] around, so that data[i] < p and data[j] >= p for i < newpivot
# and j > newpivot. On return, data[newpivot] = p.
def partition_ordered_nan[T](data: [T], a: Int, b: Int, pivot: Int) -> (Int, Bool) {
  t = data[a]
  data[a] = data[pivot]
  data[pivot] = t
  i = a + 1
  j = b - 1 # i and j are inclusive of the elements remaining to be partitioned
  while i <= j && (data[i] < data[a] || (data[i] != data[i] && data[a] == data[a])) { i += 1 }
  while i <= j && !(data[j] < data[a] || (data[j] != data[j] && data[a] == data[a])) { j -= 1 }
  if i > j {
    t = data[j]
    data[j] = data[a]
    data[a] = t
    return (j, true)
  }
  t = data[i]
  data[i] = data[j]
  data[j] = t
  i += 1
  j -= 1
  loop {
    while i <= j && (data[i] < data[a] || (data[i] != data[i] && data[a] == data[a])) { i += 1 }
    while i <= j && !(data[j] < data[a] || (data[j] != data[j] && data[a] == data[a])) { j -= 1 }
    break if i > j
    t = data[i]
    data[i] = data[j]
    data[j] = t
    i += 1
    j -= 1
  }
  t = data[j]
  data[j] = data[a]
  data[a] = t
  (j, false)
}

# Partitions data[a...b] into elements equal to data[pivot] followed by
# elements greater than data[pivot]. It assumes that data[a...b] does not
# contain elements smaller than the data[pivot].
def partition_equal_ordered_nan[T](data: [T], a: Int, b: Int, pivot: Int) -> Int {
  t = data[a]
  data[a] = data[pivot]
  data[pivot] = t
  i = a + 1
  j = b - 1 # i and j are inclusive of the elements remaining to be partitioned
  loop {
    while i <= j && !(data[a] < data[i] || (data[a] != data[a] && data[i] == data[i])) { i += 1 }
    while i <= j && (data[a] < data[j] || (data[a] != data[a] && data[j] == data[j])) { j -= 1 }
    break if i > j
    t = data[i]
    data[i] = data[j]
    data[j] = t
    i += 1
    j -= 1
  }
  i
}

# Partially sorts a slice, returns true if the slice is sorted at the end.
def partial_insertion_sort_ordered_nan[T](data: [T], a: Int, b: Int) -> Bool {
  # maximum number of adjacent out-of-order pairs that will get shifted
  max_steps = 5
  # don't shift any elements on short arrays
  shortest_shifting = 50
  i = a + 1
  step = 0
  while step < max_steps {
    while i < b && !(data[i] < data[i - 1] || (data[i] != data[i] && data[i - 1] == data[i - 1])) { i += 1 }
    return true if i == b
    return false if b - a < shortest_shifting
    t = data[i]
    data[i] = data[i - 1]
    data[i - 1] = t
    # Shift the smaller one to the left.
    if i - a >= 2 {
      j = i - 1
      while j >= 1 {
        break if !(data[j] < data[j - 1] || (data[j] != data[j] && data[j - 1] == data[j - 1]))
        t = data[j]
        data[j] = data[j - 1]
        data[j - 1] = t
        j -= 1
      }
    }
    # Shift the greater one to the right.
    if b - i >= 2 {
      j = i + 1
      while j < b {
        break if !(data[j] < data[j - 1] || (data[j] != data[j] && data[j - 1] == data[j - 1]))
        t = data[j]
        data[j] = data[j - 1]
        data[j - 1] = t
        j += 1
      }
    }
    step += 1
  }
  false
}

# Scatters some elements around in an attempt to break some patterns that
# might cause imbalanced partitions in quicksort.
def break_patterns_ordered_nan[T](data: [T], a: Int, b: Int) {
  length = b - a
  if length >= 8 {
    random = length.as_u64 # Go's xorshift
    modulus = next_power_of_two(length)
    idx = a + (length / 4) * 2 - 1
    while idx <= a + (length / 4) * 2 + 1 {
      random ^= random << 13
      random ^= random >> 7
      random ^= random << 17
      other = (random & (modulus - 1)).as_i64
      other -= length if other >= length
      t = data[idx]
      data[idx] = data[a + other]
      data[a + other] = t
      idx += 1
    }
  }
}

# Chooses a pivot in data[a...b]: the median of 3, or the Tukey ninther
# (median of medians) for slices of 50 or more. Also returns a hint about
# the order: INCREASING_HINT if no swaps were needed (possibly sorted),
# DECREASING_HINT if all were (possibly reverse sorted), else UNKNOWN_HINT.
def choose_pivot_ordered_nan[T](data: [T], a: Int, b: Int) -> (Int, Int) {
  shortest_ninther = 50
  max_swaps = 4 * 3
  l = b - a
  swaps = 0
  i = a + l / 4 * 1
  j = a + l / 4 * 2
  k = a + l / 4 * 3
  if l >= 8 {
    if l >= shortest_ninther {
      # Tukey ninther method, the idea came from Rust's implementation.
      i, swaps = median_adjacent_ordered_nan(data, i, swaps)
      j, swaps = median_adjacent_ordered_nan(data, j, swaps)
      k, swaps = median_adjacent_ordered_nan(data, k, swaps)
    }
    # Find the median among i, j, k and stores it into j.
    j, swaps = median_ordered_nan(data, i, j, k, swaps)
  }
  return (j, INCREASING_HINT) if swaps == 0
  return (j, DECREASING_HINT) if swaps == max_swaps
  (j, UNKNOWN_HINT)
}

# Returns (x, y, swaps) where data[x] <= data[y], with (x, y) one of (a, b)
# and (b, a).
def order2_ordered_nan[T](data: [T], a: Int, b: Int, swaps: Int) -> (Int, Int, Int) {
  return (b, a, swaps + 1) if (data[b] < data[a] || (data[b] != data[b] && data[a] == data[a]))
  (a, b, swaps)
}

# Returns x where data[x] is the median of data[a], data[b], data[c], with x
# one of a, b, c, and the updated swap count.
def median_ordered_nan[T](data: [T], a: Int, b: Int, c: Int, swaps: Int) -> (Int, Int) {
  a, b, swaps = order2_ordered_nan(data, a, b, swaps)
  b, _, swaps = order2_ordered_nan(data, b, c, swaps)
  _, b, swaps = order2_ordered_nan(data, a, b, swaps)
  (b, swaps)
}

# Finds the median of data[a - 1], data[a], data[a + 1] and stores the
# index into a.
def median_adjacent_ordered_nan[T](data: [T], a: Int, swaps: Int) -> (Int, Int) {
  median_ordered_nan(data, a - 1, a, a + 1, swaps)
}

def reverse_range_ordered_nan[T](data: [T], a: Int, b: Int) {
  i = a
  j = b - 1
  while i < j {
    t = data[i]
    data[i] = data[j]
    data[j] = t
    i += 1
    j -= 1
  }
}

def swap_range_ordered_nan[T](data: [T], a: Int, b: Int, n: Int) {
  i = 0
  while i < n {
    t = data[a + i]
    data[a + i] = data[b + i]
    data[b + i] = t
    i += 1
  }
}

# Insertion sort on blocks of 20, then SymMerge on doubling block sizes: a
# stable sort with O(n*log(n)) calls to LESS and O(n*log(n)*log(n)) calls to
# SWAP, in place.
def stable_sort_ordered_nan[T](data: [T], n: Int) {
  block_size = 20 # must be > 0
  a = 0
  b = block_size
  while b <= n {
    insertion_sort_ordered_nan(data, a, b)
    a = b
    b += block_size
  }
  insertion_sort_ordered_nan(data, a, n)
  while block_size < n {
    a = 0
    b = 2 * block_size
    while b <= n {
      sym_merge_ordered_nan(data, a, a + block_size, b)
      a = b
      b += 2 * block_size
    }
    m = a + block_size
    if m < n {
      sym_merge_ordered_nan(data, a, m, n)
    }
    block_size *= 2
  }
}

# Merges the two sorted subsequences data[a...m] and data[m...b] using the
# SymMerge algorithm from Pok-Son Kim and Arne Kutzner, "Stable Minimum
# Storage Merging by Symmetric Comparisons", in Susanne Albers and Tomasz
# Radzik, editors, Algorithms - ESA 2004, volume 3221 of Lecture Notes in
# Computer Science, pages 714-723. Springer, 2004.
def sym_merge_ordered_nan[T](data: [T], a: Int, m: Int, b: Int) -> Unit {
  # Avoid unnecessary recursions of sym_merge by direct insertion of
  # data[a] into data[m...b] if data[a...m] only contains one element.
  if m - a == 1 {
    # Use binary search to find the lowest index i such that
    # data[i] >= data[a] for m <= i < b. Exit the search loop with i == b in
    # case no such index exists.
    i = m
    j = b
    while i < j {
      h = (i + j) / 2
      if (data[h] < data[a] || (data[h] != data[h] && data[a] == data[a])) {
        i = h + 1
      } else {
        j = h
      }
    }
    # Swap values until data[a] reaches the position before i.
    k = a
    while k < i - 1 {
      t = data[k]
      data[k] = data[k + 1]
      data[k + 1] = t
      k += 1
    }
    return
  }
  # Avoid unnecessary recursions of sym_merge by direct insertion of
  # data[m] into data[a...m] if data[m...b] only contains one element.
  if b - m == 1 {
    # Use binary search to find the lowest index i such that
    # data[i] > data[m] for a <= i < m. Exit the search loop with i == m in
    # case no such index exists.
    i = a
    j = m
    while i < j {
      h = (i + j) / 2
      if !(data[m] < data[h] || (data[m] != data[m] && data[h] == data[h])) {
        i = h + 1
      } else {
        j = h
      }
    }
    # Swap values until data[m] reaches the position i.
    k = m
    while k > i {
      t = data[k]
      data[k] = data[k - 1]
      data[k - 1] = t
      k -= 1
    }
    return
  }
  mid = (a + b) / 2
  n = mid + m
  start = 0
  r = 0
  if m > mid {
    start = n - b
    r = mid
  } else {
    start = a
    r = m
  }
  p = n - 1
  while start < r {
    c = (start + r) / 2
    if !(data[p - c] < data[c] || (data[p - c] != data[p - c] && data[c] == data[c])) {
      start = c + 1
    } else {
      r = c
    }
  }
  end = n - start
  if start < m && m < end {
    rotate_ordered_nan(data, start, m, end)
  }
  if a < start && start < mid {
    sym_merge_ordered_nan(data, a, start, mid)
  }
  if mid < end && end < b {
    sym_merge_ordered_nan(data, mid, end, b)
  }
}

# Rotates two consecutive blocks u = data[a...m] and v = data[m...b]:
# data[a...b] becomes v + u. Uses at most b - a swaps.
def rotate_ordered_nan[T](data: [T], a: Int, m: Int, b: Int) {
  i = m - a
  j = b - m
  while i != j {
    if i > j {
      swap_range_ordered_nan(data, m - i, m, j)
      i -= j
    } else {
      swap_range_ordered_nan(data, m - i, m + j - i, i)
      j -= i
    }
  }
  # i == j
  swap_range_ordered_nan(data, m - i, m, i)
}

# Sorts data[a...b] using insertion sort.
def insertion_sort_cmp_func[T](data: [T], a: Int, b: Int, cmp: (T, T) -> Int) {
  i = a + 1
  while i < b {
    j = i
    while j > a && (cmp(data[j], data[j - 1]) < 0) {
      t = data[j]
      data[j] = data[j - 1]
      data[j - 1] = t
      j -= 1
    }
    i += 1
  }
}

# Implements the heap property on data[lo...hi]; first is an offset into the
# array where the root of the heap lies.
def sift_down_cmp_func[T](data: [T], lo: Int, hi: Int, first: Int, cmp: (T, T) -> Int) {
  root = lo
  loop {
    child = 2 * root + 1
    break if child >= hi
    if child + 1 < hi && (cmp(data[first + child], data[first + child + 1]) < 0) {
      child += 1
    }
    return if !(cmp(data[first + root], data[first + child]) < 0)
    t = data[first + root]
    data[first + root] = data[first + child]
    data[first + child] = t
    root = child
  }
}

def heap_sort_cmp_func[T](data: [T], a: Int, b: Int, cmp: (T, T) -> Int) {
  first = a
  lo = 0
  hi = b - a
  # Build heap with greatest element at top.
  i = (hi - 1) / 2
  while i >= 0 {
    sift_down_cmp_func(data, i, hi, first, cmp)
    i -= 1
  }
  # Pop elements, largest first, into end of data.
  i = hi - 1
  while i >= 0 {
    t = data[first]
    data[first] = data[first + i]
    data[first + i] = t
    sift_down_cmp_func(data, lo, i, first, cmp)
    i -= 1
  }
}

# Sorts data[a...b]. The algorithm is based on pattern-defeating quicksort
# (pdqsort), but without the optimizations from BlockQuicksort
# (https://github.com/orlp/pdqsort). limit is the number of allowed bad
# (very unbalanced) pivots before falling back to heapsort.
def pdqsort_cmp_func[T](data: [T], a: Int, b: Int, limit: Int, cmp: (T, T) -> Int) -> Unit {
  max_insertion = 12
  # whether the last partitioning was reasonably balanced
  was_balanced = true
  # whether the slice was already partitioned
  was_partitioned = true
  loop {
    length = b - a
    if length <= max_insertion {
      insertion_sort_cmp_func(data, a, b, cmp)
      return
    }
    # Fall back to heapsort if too many bad choices were made.
    if limit == 0 {
      heap_sort_cmp_func(data, a, b, cmp)
      return
    }
    # If the last partitioning was imbalanced, we need to break patterns.
    if !was_balanced {
      break_patterns_cmp_func(data, a, b, cmp)
      limit -= 1
    }
    pivot, hint = choose_pivot_cmp_func(data, a, b, cmp)
    if hint == DECREASING_HINT {
      reverse_range_cmp_func(data, a, b, cmp)
      # The chosen pivot was pivot-a elements after the start of the array.
      # After reversing it is pivot-a elements before the end of the array.
      # The idea came from Rust's implementation.
      pivot = (b - 1) - (pivot - a)
      hint = INCREASING_HINT
    }
    # The slice is likely already sorted.
    if was_balanced && was_partitioned && hint == INCREASING_HINT {
      return if partial_insertion_sort_cmp_func(data, a, b, cmp)
    }
    # Probably the slice contains many duplicate elements, partition the
    # slice into elements equal to and elements greater than the pivot.
    if a > 0 && !(cmp(data[a - 1], data[pivot]) < 0) {
      a = partition_equal_cmp_func(data, a, b, pivot, cmp)
      next
    }
    mid, already_partitioned = partition_cmp_func(data, a, b, pivot, cmp)
    was_partitioned = already_partitioned
    left_len = mid - a
    right_len = b - mid
    balance_threshold = length / 8
    if left_len < right_len {
      was_balanced = left_len >= balance_threshold
      pdqsort_cmp_func(data, a, mid, limit, cmp)
      a = mid + 1
    } else {
      was_balanced = right_len >= balance_threshold
      pdqsort_cmp_func(data, mid + 1, b, limit, cmp)
      b = mid
    }
  }
}

# Does one quicksort partition. Let p = data[pivot]. Moves elements in
# data[a...b] around, so that data[i] < p and data[j] >= p for i < newpivot
# and j > newpivot. On return, data[newpivot] = p.
def partition_cmp_func[T](data: [T], a: Int, b: Int, pivot: Int, cmp: (T, T) -> Int) -> (Int, Bool) {
  t = data[a]
  data[a] = data[pivot]
  data[pivot] = t
  i = a + 1
  j = b - 1 # i and j are inclusive of the elements remaining to be partitioned
  while i <= j && (cmp(data[i], data[a]) < 0) { i += 1 }
  while i <= j && !(cmp(data[j], data[a]) < 0) { j -= 1 }
  if i > j {
    t = data[j]
    data[j] = data[a]
    data[a] = t
    return (j, true)
  }
  t = data[i]
  data[i] = data[j]
  data[j] = t
  i += 1
  j -= 1
  loop {
    while i <= j && (cmp(data[i], data[a]) < 0) { i += 1 }
    while i <= j && !(cmp(data[j], data[a]) < 0) { j -= 1 }
    break if i > j
    t = data[i]
    data[i] = data[j]
    data[j] = t
    i += 1
    j -= 1
  }
  t = data[j]
  data[j] = data[a]
  data[a] = t
  (j, false)
}

# Partitions data[a...b] into elements equal to data[pivot] followed by
# elements greater than data[pivot]. It assumes that data[a...b] does not
# contain elements smaller than the data[pivot].
def partition_equal_cmp_func[T](data: [T], a: Int, b: Int, pivot: Int, cmp: (T, T) -> Int) -> Int {
  t = data[a]
  data[a] = data[pivot]
  data[pivot] = t
  i = a + 1
  j = b - 1 # i and j are inclusive of the elements remaining to be partitioned
  loop {
    while i <= j && !(cmp(data[a], data[i]) < 0) { i += 1 }
    while i <= j && (cmp(data[a], data[j]) < 0) { j -= 1 }
    break if i > j
    t = data[i]
    data[i] = data[j]
    data[j] = t
    i += 1
    j -= 1
  }
  i
}

# Partially sorts a slice, returns true if the slice is sorted at the end.
def partial_insertion_sort_cmp_func[T](data: [T], a: Int, b: Int, cmp: (T, T) -> Int) -> Bool {
  # maximum number of adjacent out-of-order pairs that will get shifted
  max_steps = 5
  # don't shift any elements on short arrays
  shortest_shifting = 50
  i = a + 1
  step = 0
  while step < max_steps {
    while i < b && !(cmp(data[i], data[i - 1]) < 0) { i += 1 }
    return true if i == b
    return false if b - a < shortest_shifting
    t = data[i]
    data[i] = data[i - 1]
    data[i - 1] = t
    # Shift the smaller one to the left.
    if i - a >= 2 {
      j = i - 1
      while j >= 1 {
        break if !(cmp(data[j], data[j - 1]) < 0)
        t = data[j]
        data[j] = data[j - 1]
        data[j - 1] = t
        j -= 1
      }
    }
    # Shift the greater one to the right.
    if b - i >= 2 {
      j = i + 1
      while j < b {
        break if !(cmp(data[j], data[j - 1]) < 0)
        t = data[j]
        data[j] = data[j - 1]
        data[j - 1] = t
        j += 1
      }
    }
    step += 1
  }
  false
}

# Scatters some elements around in an attempt to break some patterns that
# might cause imbalanced partitions in quicksort.
def break_patterns_cmp_func[T](data: [T], a: Int, b: Int, cmp: (T, T) -> Int) {
  length = b - a
  if length >= 8 {
    random = length.as_u64 # Go's xorshift
    modulus = next_power_of_two(length)
    idx = a + (length / 4) * 2 - 1
    while idx <= a + (length / 4) * 2 + 1 {
      random ^= random << 13
      random ^= random >> 7
      random ^= random << 17
      other = (random & (modulus - 1)).as_i64
      other -= length if other >= length
      t = data[idx]
      data[idx] = data[a + other]
      data[a + other] = t
      idx += 1
    }
  }
}

# Chooses a pivot in data[a...b]: the median of 3, or the Tukey ninther
# (median of medians) for slices of 50 or more. Also returns a hint about
# the order: INCREASING_HINT if no swaps were needed (possibly sorted),
# DECREASING_HINT if all were (possibly reverse sorted), else UNKNOWN_HINT.
def choose_pivot_cmp_func[T](data: [T], a: Int, b: Int, cmp: (T, T) -> Int) -> (Int, Int) {
  shortest_ninther = 50
  max_swaps = 4 * 3
  l = b - a
  swaps = 0
  i = a + l / 4 * 1
  j = a + l / 4 * 2
  k = a + l / 4 * 3
  if l >= 8 {
    if l >= shortest_ninther {
      # Tukey ninther method, the idea came from Rust's implementation.
      i, swaps = median_adjacent_cmp_func(data, i, swaps, cmp)
      j, swaps = median_adjacent_cmp_func(data, j, swaps, cmp)
      k, swaps = median_adjacent_cmp_func(data, k, swaps, cmp)
    }
    # Find the median among i, j, k and stores it into j.
    j, swaps = median_cmp_func(data, i, j, k, swaps, cmp)
  }
  return (j, INCREASING_HINT) if swaps == 0
  return (j, DECREASING_HINT) if swaps == max_swaps
  (j, UNKNOWN_HINT)
}

# Returns (x, y, swaps) where data[x] <= data[y], with (x, y) one of (a, b)
# and (b, a).
def order2_cmp_func[T](data: [T], a: Int, b: Int, swaps: Int, cmp: (T, T) -> Int) -> (Int, Int, Int) {
  return (b, a, swaps + 1) if (cmp(data[b], data[a]) < 0)
  (a, b, swaps)
}

# Returns x where data[x] is the median of data[a], data[b], data[c], with x
# one of a, b, c, and the updated swap count.
def median_cmp_func[T](data: [T], a: Int, b: Int, c: Int, swaps: Int, cmp: (T, T) -> Int) -> (Int, Int) {
  a, b, swaps = order2_cmp_func(data, a, b, swaps, cmp)
  b, _, swaps = order2_cmp_func(data, b, c, swaps, cmp)
  _, b, swaps = order2_cmp_func(data, a, b, swaps, cmp)
  (b, swaps)
}

# Finds the median of data[a - 1], data[a], data[a + 1] and stores the
# index into a.
def median_adjacent_cmp_func[T](data: [T], a: Int, swaps: Int, cmp: (T, T) -> Int) -> (Int, Int) {
  median_cmp_func(data, a - 1, a, a + 1, swaps, cmp)
}

def reverse_range_cmp_func[T](data: [T], a: Int, b: Int, cmp: (T, T) -> Int) {
  i = a
  j = b - 1
  while i < j {
    t = data[i]
    data[i] = data[j]
    data[j] = t
    i += 1
    j -= 1
  }
}

def swap_range_cmp_func[T](data: [T], a: Int, b: Int, n: Int, cmp: (T, T) -> Int) {
  i = 0
  while i < n {
    t = data[a + i]
    data[a + i] = data[b + i]
    data[b + i] = t
    i += 1
  }
}

# Insertion sort on blocks of 20, then SymMerge on doubling block sizes: a
# stable sort with O(n*log(n)) calls to LESS and O(n*log(n)*log(n)) calls to
# SWAP, in place.
def stable_sort_cmp_func[T](data: [T], n: Int, cmp: (T, T) -> Int) {
  block_size = 20 # must be > 0
  a = 0
  b = block_size
  while b <= n {
    insertion_sort_cmp_func(data, a, b, cmp)
    a = b
    b += block_size
  }
  insertion_sort_cmp_func(data, a, n, cmp)
  while block_size < n {
    a = 0
    b = 2 * block_size
    while b <= n {
      sym_merge_cmp_func(data, a, a + block_size, b, cmp)
      a = b
      b += 2 * block_size
    }
    m = a + block_size
    if m < n {
      sym_merge_cmp_func(data, a, m, n, cmp)
    }
    block_size *= 2
  }
}

# Merges the two sorted subsequences data[a...m] and data[m...b] using the
# SymMerge algorithm from Pok-Son Kim and Arne Kutzner, "Stable Minimum
# Storage Merging by Symmetric Comparisons", in Susanne Albers and Tomasz
# Radzik, editors, Algorithms - ESA 2004, volume 3221 of Lecture Notes in
# Computer Science, pages 714-723. Springer, 2004.
def sym_merge_cmp_func[T](data: [T], a: Int, m: Int, b: Int, cmp: (T, T) -> Int) -> Unit {
  # Avoid unnecessary recursions of sym_merge by direct insertion of
  # data[a] into data[m...b] if data[a...m] only contains one element.
  if m - a == 1 {
    # Use binary search to find the lowest index i such that
    # data[i] >= data[a] for m <= i < b. Exit the search loop with i == b in
    # case no such index exists.
    i = m
    j = b
    while i < j {
      h = (i + j) / 2
      if (cmp(data[h], data[a]) < 0) {
        i = h + 1
      } else {
        j = h
      }
    }
    # Swap values until data[a] reaches the position before i.
    k = a
    while k < i - 1 {
      t = data[k]
      data[k] = data[k + 1]
      data[k + 1] = t
      k += 1
    }
    return
  }
  # Avoid unnecessary recursions of sym_merge by direct insertion of
  # data[m] into data[a...m] if data[m...b] only contains one element.
  if b - m == 1 {
    # Use binary search to find the lowest index i such that
    # data[i] > data[m] for a <= i < m. Exit the search loop with i == m in
    # case no such index exists.
    i = a
    j = m
    while i < j {
      h = (i + j) / 2
      if !(cmp(data[m], data[h]) < 0) {
        i = h + 1
      } else {
        j = h
      }
    }
    # Swap values until data[m] reaches the position i.
    k = m
    while k > i {
      t = data[k]
      data[k] = data[k - 1]
      data[k - 1] = t
      k -= 1
    }
    return
  }
  mid = (a + b) / 2
  n = mid + m
  start = 0
  r = 0
  if m > mid {
    start = n - b
    r = mid
  } else {
    start = a
    r = m
  }
  p = n - 1
  while start < r {
    c = (start + r) / 2
    if !(cmp(data[p - c], data[c]) < 0) {
      start = c + 1
    } else {
      r = c
    }
  }
  end = n - start
  if start < m && m < end {
    rotate_cmp_func(data, start, m, end, cmp)
  }
  if a < start && start < mid {
    sym_merge_cmp_func(data, a, start, mid, cmp)
  }
  if mid < end && end < b {
    sym_merge_cmp_func(data, mid, end, b, cmp)
  }
}

# Rotates two consecutive blocks u = data[a...m] and v = data[m...b]:
# data[a...b] becomes v + u. Uses at most b - a swaps.
def rotate_cmp_func[T](data: [T], a: Int, m: Int, b: Int, cmp: (T, T) -> Int) {
  i = m - a
  j = b - m
  while i != j {
    if i > j {
      swap_range_cmp_func(data, m - i, m, j, cmp)
      i -= j
    } else {
      swap_range_cmp_func(data, m - i, m + j - i, i, cmp)
      j -= i
    }
  }
  # i == j
  swap_range_cmp_func(data, m - i, m, i, cmp)
}
