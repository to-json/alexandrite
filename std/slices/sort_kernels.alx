# Sorting kernels: ordered and cmp-function variants.

# Insertion sort. Stable: an element moves past only strictly greater ones.
def insertion_sort[T](xs: [T], lo: Int, hi: Int) {
  i = lo + 1
  while i < hi {
    v = xs[i]
    j = i
    while j > lo && (v < xs[j - 1]) {
      xs[j] = xs[j - 1]
      j -= 1
    }
    xs[j] = v
    i += 1
  }
}

def sift_down[T](xs: [T], lo: Int, first: Int, n: Int) {
  root = first
  while true {
    child = 2 * root + 1
    break if child >= n
    child += 1 if child + 1 < n && (xs[lo + child] < xs[lo + child + 1])
    break if !(xs[lo + root] < xs[lo + child])
    t = xs[lo + root]
    xs[lo + root] = xs[lo + child]
    xs[lo + child] = t
    root = child
  }
}

# The fallback that bounds the worst case at O(n log n).
def heap_sort[T](xs: [T], lo: Int, hi: Int) {
  n = hi - lo
  i = (n - 1) / 2
  while i >= 0 {
    sift_down(xs, lo, i, n)
    i -= 1
  }
  i = n - 1
  while i >= 1 {
    t = xs[lo]
    xs[lo] = xs[lo + i]
    xs[lo + i] = t
    sift_down(xs, lo, 0, i)
    i -= 1
  }
}

# The index of the median of xs[a], xs[b], xs[c].
def median3[T](xs: [T], a: Int, b: Int, c: Int) -> Int {
  if (xs[a] < xs[b]) {
    return b if (xs[b] < xs[c])
    return c if (xs[a] < xs[c])
    return a
  }
  return a if (xs[a] < xs[c])
  return c if (xs[b] < xs[c])
  b
}

# Moves a median-of-3 (median of medians for long ranges) pivot to xs[lo].
def choose_pivot[T](xs: [T], lo: Int, hi: Int) {
  n = hi - lo
  m = lo + n / 2
  p = 0
  if n > 100 {
    s = n / 8
    a = median3(xs, lo, lo + s, lo + 2 * s)
    b = median3(xs, m - s, m, m + s)
    c = median3(xs, hi - 1 - 2 * s, hi - 1 - s, hi - 1)
    p = median3(xs, a, b, c)
  } else {
    p = median3(xs, lo, m, hi - 1)
  }
  t = xs[lo]
  xs[lo] = xs[p]
  xs[p] = t
}

# Introsort: Hoare-partition quicksort (equal keys stop both scans, so runs of
# duplicates split evenly), insertion sort for short ranges, heapsort when the
# recursion gets deeper than 2 log2 n. Recurses into the shorter side.
def quick_sort[T](xs: [T], lo: Int, hi: Int, limit: Int) -> Unit {
  while hi - lo > 12 {
    if limit == 0 {
      heap_sort(xs, lo, hi)
      return
    }
    limit -= 1
    choose_pivot(xs, lo, hi)
    pv = xs[lo]
    i = lo - 1
    j = hi
    while true {
      i += 1
      while (xs[i] < pv) { i += 1 }
      j -= 1
      while (pv < xs[j]) { j -= 1 }
      break if i >= j
      t = xs[i]
      xs[i] = xs[j]
      xs[j] = t
    }
    if j + 1 - lo < hi - j - 1 {
      quick_sort(xs, lo, j + 1, limit)
      lo = j + 1
    } else {
      quick_sort(xs, j + 1, hi, limit)
      hi = j + 1
    }
  }
  insertion_sort(xs, lo, hi)
}

def reverse_range[T](xs: [T], lo: Int, hi: Int) {
  i = lo
  j = hi - 1
  while i < j {
    t = xs[i]
    xs[i] = xs[j]
    xs[j] = t
    i += 1
    j -= 1
  }
}

# Sorts xs[lo...hi]: O(n) when it is already sorted or strictly descending.
def sort_range[T](xs: [T], lo: Int, hi: Int) {
  return if hi - lo < 2
  i = lo + 1
  while i < hi && !(xs[i] < xs[i - 1]) { i += 1 }
  return if i == hi
  j = lo + 1
  while j < hi && (xs[j] < xs[j - 1]) { j += 1 }
  if j == hi {
    reverse_range(xs, lo, hi)
    return
  }
  limit = 0
  n = hi - lo
  while n > 0 {
    limit += 2
    n = n / 2
  }
  quick_sort(xs, lo, hi, limit)
}

# Stable merge sort; `buf` is scratch space the size of xs.
def merge_sort[T](xs: [T], buf: [T], lo: Int, hi: Int) -> Unit {
  if hi - lo <= 12 {
    insertion_sort(xs, lo, hi)
    return
  }
  mid = lo + (hi - lo) / 2
  merge_sort(xs, buf, lo, mid)
  merge_sort(xs, buf, mid, hi)
  return if !(xs[mid] < xs[mid - 1])
  copy(buf[lo...mid], xs[lo...mid])
  i = lo
  j = mid
  k = lo
  while i < mid && j < hi {
    if (xs[j] < buf[i]) {
      xs[k] = xs[j]
      j += 1
    } else {
      xs[k] = buf[i]
      i += 1
    }
    k += 1
  }
  while i < mid {
    xs[k] = buf[i]
    i += 1
    k += 1
  }
}

def stable_sort[T](xs: [T]) {
  return if xs.size < 2
  buf = xs.dup
  merge_sort(xs, buf, 0, xs.size)
}

