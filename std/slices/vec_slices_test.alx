test "vectors: binary_search 12" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq binary_search([nan, -2.5, -2.5, -1.0, 0.0, 1.0], inf), (6, false)
  assert_eq binary_search([nan, nz, 2.5, inf], nan), (0, true)
  assert_eq binary_search([nan, nz, 2.5, inf], ninf), (1, false)
  assert_eq binary_search([nan, nz, 2.5, inf], -2.5), (1, false)
  assert_eq binary_search([nan, nz, 2.5, inf], -1.0), (1, false)
  assert_eq binary_search([nan, nz, 2.5, inf], nz), (1, true)
  assert_eq binary_search([nan, nz, 2.5, inf], 0.0), (1, true)
  assert_eq binary_search([nan, nz, 2.5, inf], 1.0), (2, false)
  assert_eq binary_search([nan, nz, 2.5, inf], 2.5), (2, true)
  assert_eq binary_search([nan, nz, 2.5, inf], inf), (3, true)
  assert_eq binary_search(["", "\t", "A", "Z", "a\x00", "日本"], ""), (0, true)
  assert_eq binary_search(["", "\t", "A", "Z", "a\x00", "日本"], "a"), (4, false)
  assert_eq binary_search(["", "\t", "A", "Z", "a\x00", "日本"], "b"), (5, false)
  assert_eq binary_search(["", "\t", "A", "Z", "a\x00", "日本"], "日"), (5, false)
  assert_eq binary_search(["", "\t", "A", "Z", "a\x00", "日本"], "~"), (5, false)
  assert_eq binary_search(["", "\t", "A", "Z", "a\x00", "日本"], "zz"), (5, false)
  assert_eq binary_search(["a\x00", "ab", "ab", "ß"], ""), (0, false)
  assert_eq binary_search(["a\x00", "ab", "ab", "ß"], "a"), (0, false)
  assert_eq binary_search(["a\x00", "ab", "ab", "ß"], "b"), (3, false)
  assert_eq binary_search(["a\x00", "ab", "ab", "ß"], "日"), (4, false)
  assert_eq binary_search(["a\x00", "ab", "ab", "ß"], "~"), (3, false)
  assert_eq binary_search(["a\x00", "ab", "ab", "ß"], "zz"), (3, false)
  assert_eq binary_search(vec_strs(), ""), (0, false)
  assert_eq binary_search(vec_strs(), "a"), (0, false)
  assert_eq binary_search(vec_strs(), "b"), (0, false)
  assert_eq binary_search(vec_strs(), "日"), (0, false)
  assert_eq binary_search(vec_strs(), "~"), (0, false)
  assert_eq binary_search(vec_strs(), "zz"), (0, false)
  assert_eq binary_search(["", "aB", "ss", "ÿ", "ﬀ", "😀"], ""), (0, true)
  assert_eq binary_search(["", "aB", "ss", "ÿ", "ﬀ", "😀"], "a"), (1, false)
  assert_eq binary_search(["", "aB", "ss", "ÿ", "ﬀ", "😀"], "b"), (2, false)
  assert_eq binary_search(["", "aB", "ss", "ÿ", "ﬀ", "😀"], "日"), (4, false)
  assert_eq binary_search(["", "aB", "ss", "ÿ", "ﬀ", "😀"], "~"), (3, false)
  assert_eq binary_search(["", "aB", "ss", "ÿ", "ﬀ", "😀"], "zz"), (3, false)
  assert_eq binary_search(["é", "日本"], ""), (0, false)
  assert_eq binary_search(["é", "日本"], "a"), (0, false)
  assert_eq binary_search(["é", "日本"], "b"), (0, false)
  assert_eq binary_search(["é", "日本"], "日"), (1, false)
  assert_eq binary_search(["é", "日本"], "~"), (1, false)
  assert_eq binary_search(["é", "日本"], "zz"), (1, false)
  assert_eq binary_search(["a\x00"], ""), (0, false)
  assert_eq binary_search(["a\x00"], "a"), (0, false)
  assert_eq binary_search(["a\x00"], "b"), (1, false)
  assert_eq binary_search(["a\x00"], "日"), (1, false)
  assert_eq binary_search(["a\x00"], "~"), (1, false)
  assert_eq binary_search(["a\x00"], "zz"), (1, false)
  assert_eq binary_search(["ss", "😀"], ""), (0, false)
  assert_eq binary_search(["ss", "😀"], "a"), (0, false)
  assert_eq binary_search(["ss", "😀"], "b"), (0, false)
  assert_eq binary_search(["ss", "😀"], "日"), (1, false)
  assert_eq binary_search(["ss", "😀"], "~"), (1, false)
  assert_eq binary_search(["ss", "😀"], "zz"), (1, false)
  assert_eq binary_search(["Z", "z", "~", "日本", "ﬀ"], ""), (0, false)
  assert_eq binary_search(["Z", "z", "~", "日本", "ﬀ"], "a"), (1, false)
  assert_eq binary_search(["Z", "z", "~", "日本", "ﬀ"], "b"), (1, false)
  assert_eq binary_search(["Z", "z", "~", "日本", "ﬀ"], "日"), (3, false)
  assert_eq binary_search(["Z", "z", "~", "日本", "ﬀ"], "~"), (2, true)
  assert_eq binary_search(["Z", "z", "~", "日本", "ﬀ"], "zz"), (2, false)
  assert_eq binary_search(["A", "Z", "a", "a\x00", "a\x00", "ab", "日"], ""), (0, false)
  assert_eq binary_search(["A", "Z", "a", "a\x00", "a\x00", "ab", "日"], "a"), (2, true)
  assert_eq binary_search(["A", "Z", "a", "a\x00", "a\x00", "ab", "日"], "b"), (6, false)
  assert_eq binary_search(["A", "Z", "a", "a\x00", "a\x00", "ab", "日"], "日"), (6, true)
  assert_eq binary_search(["A", "Z", "a", "a\x00", "a\x00", "ab", "日"], "~"), (6, false)
  assert_eq binary_search(["A", "Z", "a", "a\x00", "a\x00", "ab", "日"], "zz"), (6, false)
  assert_eq binary_search(vec_strs(), ""), (0, false)
  assert_eq binary_search(vec_strs(), "a"), (0, false)
  assert_eq binary_search(vec_strs(), "b"), (0, false)
  assert_eq binary_search(vec_strs(), "日"), (0, false)
  assert_eq binary_search(vec_strs(), "~"), (0, false)
  assert_eq binary_search(vec_strs(), "zz"), (0, false)
  assert_eq binary_search(["a\x00", "aB", "aB"], ""), (0, false)
  assert_eq binary_search(["a\x00", "aB", "aB"], "a"), (0, false)
  assert_eq binary_search(["a\x00", "aB", "aB"], "b"), (3, false)
  assert_eq binary_search(["a\x00", "aB", "aB"], "日"), (3, false)
  assert_eq binary_search(["a\x00", "aB", "aB"], "~"), (3, false)
  assert_eq binary_search(["a\x00", "aB", "aB"], "zz"), (3, false)
  assert_eq binary_search(["", "é", "日"], ""), (0, true)
  assert_eq binary_search(["", "é", "日"], "a"), (1, false)
  assert_eq binary_search(["", "é", "日"], "b"), (1, false)
  assert_eq binary_search(["", "é", "日"], "日"), (2, true)
  assert_eq binary_search(["", "é", "日"], "~"), (2, false)
  assert_eq binary_search(["", "é", "日"], "zz"), (2, false)
  assert_eq binary_search(["ab", "b", "😀", "😀"], ""), (0, false)
  assert_eq binary_search(["ab", "b", "😀", "😀"], "a"), (0, false)
  assert_eq binary_search(["ab", "b", "😀", "😀"], "b"), (1, true)
  assert_eq binary_search(["ab", "b", "😀", "😀"], "日"), (2, false)
  assert_eq binary_search(["ab", "b", "😀", "😀"], "~"), (2, false)
  assert_eq binary_search(["ab", "b", "😀", "😀"], "zz"), (2, false)
  assert_eq binary_search(["a", "z", "ÿ", "日本"], ""), (0, false)
  assert_eq binary_search(["a", "z", "ÿ", "日本"], "a"), (0, true)
  assert_eq binary_search(["a", "z", "ÿ", "日本"], "b"), (1, false)
  assert_eq binary_search(["a", "z", "ÿ", "日本"], "日"), (3, false)
  assert_eq binary_search(["a", "z", "ÿ", "日本"], "~"), (2, false)
  assert_eq binary_search(["a", "z", "ÿ", "日本"], "zz"), (2, false)
  assert_eq binary_search(["ab", "ﬀ"], ""), (0, false)
  assert_eq binary_search(["ab", "ﬀ"], "a"), (0, false)
  assert_eq binary_search(["ab", "ﬀ"], "b"), (1, false)
  assert_eq binary_search(["ab", "ﬀ"], "日"), (1, false)
  assert_eq binary_search(["ab", "ﬀ"], "~"), (1, false)
  assert_eq binary_search(["ab", "ﬀ"], "zz"), (1, false)
}

test "vectors: binary_search 13" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq binary_search(["b", "é", "ss", "ÿ", "ÿ", "日本", "ﬀ"], ""), (0, false)
  assert_eq binary_search(["b", "é", "ss", "ÿ", "ÿ", "日本", "ﬀ"], "a"), (0, false)
  assert_eq binary_search(["b", "é", "ss", "ÿ", "ÿ", "日本", "ﬀ"], "b"), (0, true)
  assert_eq binary_search(["b", "é", "ss", "ÿ", "ÿ", "日本", "ﬀ"], "日"), (5, false)
  assert_eq binary_search(["b", "é", "ss", "ÿ", "ÿ", "日本", "ﬀ"], "~"), (3, false)
  assert_eq binary_search(["b", "é", "ss", "ÿ", "ÿ", "日本", "ﬀ"], "zz"), (3, false)
  assert_eq binary_search(["\t", "é", "é"], ""), (0, false)
  assert_eq binary_search(["\t", "é", "é"], "a"), (1, false)
  assert_eq binary_search(["\t", "é", "é"], "b"), (1, false)
  assert_eq binary_search(["\t", "é", "é"], "日"), (3, false)
  assert_eq binary_search(["\t", "é", "é"], "~"), (3, false)
  assert_eq binary_search(["\t", "é", "é"], "zz"), (3, false)
  assert_eq binary_search(["Z", "Z", "a\x00", "a\x00", "z", "ﬀ", "😀"], ""), (0, false)
  assert_eq binary_search(["Z", "Z", "a\x00", "a\x00", "z", "ﬀ", "😀"], "a"), (2, false)
  assert_eq binary_search(["Z", "Z", "a\x00", "a\x00", "z", "ﬀ", "😀"], "b"), (4, false)
  assert_eq binary_search(["Z", "Z", "a\x00", "a\x00", "z", "ﬀ", "😀"], "日"), (5, false)
  assert_eq binary_search(["Z", "Z", "a\x00", "a\x00", "z", "ﬀ", "😀"], "~"), (5, false)
  assert_eq binary_search(["Z", "Z", "a\x00", "a\x00", "z", "ﬀ", "😀"], "zz"), (5, false)
  assert_eq binary_search(["A", "aB", "ab", "~"], ""), (0, false)
  assert_eq binary_search(["A", "aB", "ab", "~"], "a"), (1, false)
  assert_eq binary_search(["A", "aB", "ab", "~"], "b"), (3, false)
  assert_eq binary_search(["A", "aB", "ab", "~"], "日"), (4, false)
  assert_eq binary_search(["A", "aB", "ab", "~"], "~"), (3, true)
  assert_eq binary_search(["A", "aB", "ab", "~"], "zz"), (3, false)
  assert_eq binary_search(["A", "aB", "ß", "ÿ", "日", "😀"], ""), (0, false)
  assert_eq binary_search(["A", "aB", "ß", "ÿ", "日", "😀"], "a"), (1, false)
  assert_eq binary_search(["A", "aB", "ß", "ÿ", "日", "😀"], "b"), (2, false)
  assert_eq binary_search(["A", "aB", "ß", "ÿ", "日", "😀"], "日"), (4, true)
  assert_eq binary_search(["A", "aB", "ß", "ÿ", "日", "😀"], "~"), (2, false)
  assert_eq binary_search(["A", "aB", "ß", "ÿ", "日", "😀"], "zz"), (2, false)
}

test "vectors: compact 1" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq compact([3, 3, 0, 3, 0]), [3, 0, 3, 0]
  assert_eq compact_func([3, 3, 0, 3, 0]) { |a, b| a == b + 1 }, [3, 3, 0, 3, 0]
  assert_eq delete_func([3, 3, 0, 3, 0]) { it % 2 == 1 }, [0, 0]
  assert_eq compact([2, 1, 0]), [2, 1, 0]
  assert_eq compact_func([2, 1, 0]) { |a, b| a == b + 1 }, [2, 1, 0]
  assert_eq delete_func([2, 1, 0]) { it % 2 == 1 }, [2, 0]
  assert_eq compact([2, 0]), [2, 0]
  assert_eq compact_func([2, 0]) { |a, b| a == b + 1 }, [2, 0]
  assert_eq delete_func([2, 0]) { it % 2 == 1 }, [2, 0]
  assert_eq compact([1, 0, 0, 0, 3, 3, 1]), [1, 0, 3, 1]
  assert_eq compact_func([1, 0, 0, 0, 3, 3, 1]) { |a, b| a == b + 1 }, [1, 0, 0, 0, 3, 3, 1]
  assert_eq delete_func([1, 0, 0, 0, 3, 3, 1]) { it % 2 == 1 }, [0, 0, 0]
  assert_eq compact([3, 3, 2, 2, 0, 2]), [3, 2, 0, 2]
  assert_eq compact_func([3, 3, 2, 2, 0, 2]) { |a, b| a == b + 1 }, [3, 3, 2, 2, 0, 2]
  assert_eq delete_func([3, 3, 2, 2, 0, 2]) { it % 2 == 1 }, [2, 2, 0, 2]
  assert_eq compact([2, 2]), [2]
  assert_eq compact_func([2, 2]) { |a, b| a == b + 1 }, [2, 2]
  assert_eq delete_func([2, 2]) { it % 2 == 1 }, [2, 2]
  assert_eq compact([3, 0, 2, 0, 0, 0]), [3, 0, 2, 0]
  assert_eq compact_func([3, 0, 2, 0, 0, 0]) { |a, b| a == b + 1 }, [3, 0, 2, 0, 0, 0]
  assert_eq delete_func([3, 0, 2, 0, 0, 0]) { it % 2 == 1 }, [0, 2, 0, 0, 0]
  assert_eq compact([0, 0, 2, 0, 3, 0, 2, 2]), [0, 2, 0, 3, 0, 2]
  assert_eq compact_func([0, 0, 2, 0, 3, 0, 2, 2]) { |a, b| a == b + 1 }, [0, 0, 2, 0, 3, 0, 2, 2]
  assert_eq delete_func([0, 0, 2, 0, 3, 0, 2, 2]) { it % 2 == 1 }, [0, 0, 2, 0, 0, 2, 2]
  assert_eq compact([2, 3, 3, 3, 3, 2]), [2, 3, 2]
  assert_eq compact_func([2, 3, 3, 3, 3, 2]) { |a, b| a == b + 1 }, [2, 3, 3, 3, 2]
  assert_eq delete_func([2, 3, 3, 3, 3, 2]) { it % 2 == 1 }, [2, 2]
  assert_eq compact([2, 1, 0, 2, 1, 2]), [2, 1, 0, 2, 1, 2]
  assert_eq compact_func([2, 1, 0, 2, 1, 2]) { |a, b| a == b + 1 }, [2, 1, 0, 2, 1]
  assert_eq delete_func([2, 1, 0, 2, 1, 2]) { it % 2 == 1 }, [2, 0, 2, 2]
  assert_eq compact([1, 0, 0]), [1, 0]
  assert_eq compact_func([1, 0, 0]) { |a, b| a == b + 1 }, [1, 0, 0]
  assert_eq delete_func([1, 0, 0]) { it % 2 == 1 }, [0, 0]
  assert_eq compact([0, 0, 1, 3, 3, 2, 1, 1, 3]), [0, 1, 3, 2, 1, 3]
  assert_eq compact_func([0, 0, 1, 3, 3, 2, 1, 1, 3]) { |a, b| a == b + 1 }, [0, 0, 3, 3, 2, 1, 1, 3]
  assert_eq delete_func([0, 0, 1, 3, 3, 2, 1, 1, 3]) { it % 2 == 1 }, [0, 0, 2]
  assert_eq compact([0, 1, 0, 2, 3, 3, 3, 3, 1]), [0, 1, 0, 2, 3, 1]
  assert_eq compact_func([0, 1, 0, 2, 3, 3, 3, 3, 1]) { |a, b| a == b + 1 }, [0, 0, 2, 3, 3, 3, 1]
  assert_eq delete_func([0, 1, 0, 2, 3, 3, 3, 3, 1]) { it % 2 == 1 }, [0, 0, 2]
  assert_eq compact([1, 3, 2, 0, 0, 0, 2]), [1, 3, 2, 0, 2]
  assert_eq compact_func([1, 3, 2, 0, 0, 0, 2]) { |a, b| a == b + 1 }, [1, 3, 2, 0, 0, 0, 2]
  assert_eq delete_func([1, 3, 2, 0, 0, 0, 2]) { it % 2 == 1 }, [2, 0, 0, 0, 2]
  assert_eq compact([1, 3, 1, 2]), [1, 3, 1, 2]
  assert_eq compact_func([1, 3, 1, 2]) { |a, b| a == b + 1 }, [1, 3, 1]
  assert_eq delete_func([1, 3, 1, 2]) { it % 2 == 1 }, [2]
  assert_eq compact([3, 2, 2, 1, 2, 1, 1, 2, 2]), [3, 2, 1, 2, 1, 2]
  assert_eq compact_func([3, 2, 2, 1, 2, 1, 1, 2, 2]) { |a, b| a == b + 1 }, [3, 2, 2, 1, 1, 1, 2]
  assert_eq delete_func([3, 2, 2, 1, 2, 1, 1, 2, 2]) { it % 2 == 1 }, [2, 2, 2, 2, 2]
  assert_eq compact([1, 2, 3, 3]), [1, 2, 3]
  assert_eq compact_func([1, 2, 3, 3]) { |a, b| a == b + 1 }, [1, 3]
  assert_eq delete_func([1, 2, 3, 3]) { it % 2 == 1 }, [2]
  assert_eq compact([2]), [2]
  assert_eq compact_func([2]) { |a, b| a == b + 1 }, [2]
  assert_eq delete_func([2]) { it % 2 == 1 }, [2]
  assert_eq compact(vec_ints()), vec_ints()
  assert_eq compact_func(vec_ints()) { |a, b| a == b + 1 }, vec_ints()
  assert_eq delete_func(vec_ints()) { it % 2 == 1 }, vec_ints()
  assert_eq compact(vec_ints()), vec_ints()
  assert_eq compact_func(vec_ints()) { |a, b| a == b + 1 }, vec_ints()
  assert_eq delete_func(vec_ints()) { it % 2 == 1 }, vec_ints()
  assert_eq compact([0, 2, 1, 0, 3, 0, 2]), [0, 2, 1, 0, 3, 0, 2]
  assert_eq compact_func([0, 2, 1, 0, 3, 0, 2]) { |a, b| a == b + 1 }, [0, 2, 1, 0, 3, 0, 2]
  assert_eq delete_func([0, 2, 1, 0, 3, 0, 2]) { it % 2 == 1 }, [0, 2, 0, 0, 2]
  assert_eq compact([3]), [3]
  assert_eq compact_func([3]) { |a, b| a == b + 1 }, [3]
  assert_eq delete_func([3]) { it % 2 == 1 }, vec_ints()
  assert_eq compact([3, 1, 3, 2, 2, 0, 3]), [3, 1, 3, 2, 0, 3]
  assert_eq compact_func([3, 1, 3, 2, 2, 0, 3]) { |a, b| a == b + 1 }, [3, 1, 3, 2, 2, 0, 3]
  assert_eq delete_func([3, 1, 3, 2, 2, 0, 3]) { it % 2 == 1 }, [2, 2, 0]
  assert_eq compact([2, 0, 1, 1, 1, 3]), [2, 0, 1, 3]
  assert_eq compact_func([2, 0, 1, 1, 1, 3]) { |a, b| a == b + 1 }, [2, 0, 1, 1, 3]
  assert_eq delete_func([2, 0, 1, 1, 1, 3]) { it % 2 == 1 }, [2, 0]
  assert_eq compact([0, 3, 1, 2, 2]), [0, 3, 1, 2]
  assert_eq compact_func([0, 3, 1, 2, 2]) { |a, b| a == b + 1 }, [0, 3, 1, 2]
  assert_eq delete_func([0, 3, 1, 2, 2]) { it % 2 == 1 }, [0, 2, 2]
  assert_eq compact([1, 2, 0, 1, 3, 1, 0, 2]), [1, 2, 0, 1, 3, 1, 0, 2]
  assert_eq compact_func([1, 2, 0, 1, 3, 1, 0, 2]) { |a, b| a == b + 1 }, [1, 0, 3, 1, 0, 2]
  assert_eq delete_func([1, 2, 0, 1, 3, 1, 0, 2]) { it % 2 == 1 }, [2, 0, 0, 2]
  assert_eq compact([1, 0]), [1, 0]
  assert_eq compact_func([1, 0]) { |a, b| a == b + 1 }, [1, 0]
  assert_eq delete_func([1, 0]) { it % 2 == 1 }, [0]
  assert_eq compact([1, 2, 1, 3]), [1, 2, 1, 3]
  assert_eq compact_func([1, 2, 1, 3]) { |a, b| a == b + 1 }, [1, 1, 3]
  assert_eq delete_func([1, 2, 1, 3]) { it % 2 == 1 }, [2]
  assert_eq compact([3, 2, 3]), [3, 2, 3]
  assert_eq compact_func([3, 2, 3]) { |a, b| a == b + 1 }, [3, 2]
  assert_eq delete_func([3, 2, 3]) { it % 2 == 1 }, [2]
  assert_eq compact([3, 2, 2, 2, 0, 0, 3, 1, 0]), [3, 2, 0, 3, 1, 0]
  assert_eq compact_func([3, 2, 2, 2, 0, 0, 3, 1, 0]) { |a, b| a == b + 1 }, [3, 2, 2, 2, 0, 0, 3, 1, 0]
  assert_eq delete_func([3, 2, 2, 2, 0, 0, 3, 1, 0]) { it % 2 == 1 }, [2, 2, 2, 0, 0, 0]
  assert_eq compact([2, 1, 3, 3, 1, 0]), [2, 1, 3, 1, 0]
  assert_eq compact_func([2, 1, 3, 3, 1, 0]) { |a, b| a == b + 1 }, [2, 1, 3, 3, 1, 0]
  assert_eq delete_func([2, 1, 3, 3, 1, 0]) { it % 2 == 1 }, [2, 0]
  assert_eq compact([1, 3, 3, 3]), [1, 3]
  assert_eq compact_func([1, 3, 3, 3]) { |a, b| a == b + 1 }, [1, 3, 3, 3]
  assert_eq delete_func([1, 3, 3, 3]) { it % 2 == 1 }, vec_ints()
  assert_eq compact(vec_ints()), vec_ints()
  assert_eq compact_func(vec_ints()) { |a, b| a == b + 1 }, vec_ints()
  assert_eq delete_func(vec_ints()) { it % 2 == 1 }, vec_ints()
  assert_eq compact([0, 2, 3]), [0, 2, 3]
}

test "vectors: compact 2" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq compact_func([0, 2, 3]) { |a, b| a == b + 1 }, [0, 2]
  assert_eq delete_func([0, 2, 3]) { it % 2 == 1 }, [0, 2]
  assert_eq compact([3, 2, 1, 3, 3]), [3, 2, 1, 3]
  assert_eq compact_func([3, 2, 1, 3, 3]) { |a, b| a == b + 1 }, [3, 2, 1, 3, 3]
  assert_eq delete_func([3, 2, 1, 3, 3]) { it % 2 == 1 }, [2]
  assert_eq compact([1, 2, 3, 1]), [1, 2, 3, 1]
  assert_eq compact_func([1, 2, 3, 1]) { |a, b| a == b + 1 }, [1, 1]
  assert_eq delete_func([1, 2, 3, 1]) { it % 2 == 1 }, [2]
  assert_eq compact(vec_ints()), vec_ints()
  assert_eq compact_func(vec_ints()) { |a, b| a == b + 1 }, vec_ints()
  assert_eq delete_func(vec_ints()) { it % 2 == 1 }, vec_ints()
  assert_eq compact([3, 1, 0, 3, 1, 3, 0]), [3, 1, 0, 3, 1, 3, 0]
  assert_eq compact_func([3, 1, 0, 3, 1, 3, 0]) { |a, b| a == b + 1 }, [3, 1, 0, 3, 1, 3, 0]
  assert_eq delete_func([3, 1, 0, 3, 1, 3, 0]) { it % 2 == 1 }, [0, 0]
  assert_eq compact([0, 1, 2, 2]), [0, 1, 2]
  assert_eq compact_func([0, 1, 2, 2]) { |a, b| a == b + 1 }, [0, 2]
  assert_eq delete_func([0, 1, 2, 2]) { it % 2 == 1 }, [0, 2, 2]
  assert_eq compact([2]), [2]
