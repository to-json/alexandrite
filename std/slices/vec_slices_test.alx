  assert_eq binary_search_func([0, 1, 2, 2, 3, 7, 8, 9], 4) { |a, b| a - b }, (5, false)
  assert_eq binary_search([0, 1, 2, 2, 3, 7, 8, 9], 7), (5, true)
  assert_eq binary_search_func([0, 1, 2, 2, 3, 7, 8, 9], 7) { |a, b| a - b }, (5, true)
  assert_eq binary_search([0, 1, 2, 2, 3, 7, 8, 9], 9), (7, true)
  assert_eq binary_search_func([0, 1, 2, 2, 3, 7, 8, 9], 9) { |a, b| a - b }, (7, true)
  assert_eq binary_search([0, 1, 2, 2, 3, 7, 8, 9], 10), (8, false)
  assert_eq binary_search_func([0, 1, 2, 2, 3, 7, 8, 9], 10) { |a, b| a - b }, (8, false)
  assert_eq binary_search([0, 4, 4, 4, 8, 8, 9], -1), (0, false)
  assert_eq binary_search_func([0, 4, 4, 4, 8, 8, 9], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([0, 4, 4, 4, 8, 8, 9], 0), (0, true)
  assert_eq binary_search_func([0, 4, 4, 4, 8, 8, 9], 0) { |a, b| a - b }, (0, true)
  assert_eq binary_search([0, 4, 4, 4, 8, 8, 9], 3), (1, false)
  assert_eq binary_search_func([0, 4, 4, 4, 8, 8, 9], 3) { |a, b| a - b }, (1, false)
  assert_eq binary_search([0, 4, 4, 4, 8, 8, 9], 5), (4, false)
  assert_eq binary_search_func([0, 4, 4, 4, 8, 8, 9], 5) { |a, b| a - b }, (4, false)
  assert_eq binary_search([0, 4, 4, 4, 8, 8, 9], 6), (4, false)
  assert_eq binary_search_func([0, 4, 4, 4, 8, 8, 9], 6) { |a, b| a - b }, (4, false)
  assert_eq binary_search([0, 4, 4, 4, 8, 8, 9], 7), (4, false)
  assert_eq binary_search_func([0, 4, 4, 4, 8, 8, 9], 7) { |a, b| a - b }, (4, false)
