  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq insert([25, 55, 44, 10, 98, 20], 4, [49, 36, 3]), [25, 55, 44, 10, 49, 36, 3, 98, 20]
  assert_eq delete([25, 55, 44, 10, 98, 20], 4, 4), [25, 55, 44, 10, 98, 20]
  assert_eq replace([25, 55, 44, 10, 98, 20], 4, 4, [49, 36, 3]), [25, 55, 44, 10, 49, 36, 3, 98, 20]
  assert_eq insert([41, 39, 75, 78], 0, [7, 25]), [7, 25, 41, 39, 75, 78]
  assert_eq delete([41, 39, 75, 78], 0, 2), [75, 78]
  assert_eq replace([41, 39, 75, 78], 0, 2, [7, 25]), [7, 25, 75, 78]
  assert_eq insert([71, 96, 43, 3, 60, 56, 86], 1, [30, 63, 33]), [71, 30, 63, 33, 96, 43, 3, 60, 56, 86]
  assert_eq delete([71, 96, 43, 3, 60, 56, 86], 1, 5), [71, 56, 86]
  assert_eq replace([71, 96, 43, 3, 60, 56, 86], 1, 5, [30, 63, 33]), [71, 30, 63, 33, 56, 86]
  assert_eq insert([86, 55, 16, 7, 29, 17, 25], 7, vec_ints()), [86, 55, 16, 7, 29, 17, 25]
  assert_eq delete([86, 55, 16, 7, 29, 17, 25], 7, 7), [86, 55, 16, 7, 29, 17, 25]
