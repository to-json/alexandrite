test "vectors: binary_search 4" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq binary_search([0, 2, 2, 2, 6, 7, 7, 7, 7, 9, 9], 9), (9, true)
  assert_eq binary_search_func([0, 2, 2, 2, 6, 7, 7, 7, 7, 9, 9], 9) { |a, b| a - b }, (9, true)
  assert_eq binary_search([0, 3, 5, 7, 8], -1), (0, false)
