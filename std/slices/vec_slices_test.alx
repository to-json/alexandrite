  assert_eq vec_sort(["ab", "Z", "A", "A", "ﬀ", "b", "b", "é", "ss", "b", "é", "z", "Z", "日本", "ss", "ss", "~", "ss", "ß", "a\x00", "~", "b", "A", "\t", "Z", "ab", "ÿ", "b", "a\x00", "日", "A", "ab", "A", "Z", "ÿ", "日", "Z", "😀", "a", "Z"]), ["\t", "A", "A", "A", "A", "A", "Z", "Z", "Z", "Z", "Z", "Z", "a", "a\x00", "a\x00", "ab", "ab", "ab", "b", "b", "b", "b", "b", "é", "ss", "ss", "ss", "ss", "z", "~", "~", "ß", "é", "ÿ", "ÿ", "日", "日", "日本", "ﬀ", "😀"]
