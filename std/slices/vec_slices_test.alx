  assert_eq delete_func([3, 0, 2, 2, 3]) { it % 2 == 1 }, [0, 2, 2]
  assert_eq compact([1]), [1]
  assert_eq compact_func([1]) { |a, b| a == b + 1 }, [1]
  assert_eq delete_func([1]) { it % 2 == 1 }, vec_ints()
  assert_eq compact([1]), [1]
