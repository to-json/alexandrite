  assert_eq compact_func([1, 2, 1, 3, 0, 0, 0, 0, 2]) { |a, b| a == b + 1 }, [1, 1, 3, 0, 0, 0, 0, 2]
  assert_eq delete_func([1, 2, 1, 3, 0, 0, 0, 0, 2]) { it % 2 == 1 }, [2, 0, 0, 0, 0, 2]
