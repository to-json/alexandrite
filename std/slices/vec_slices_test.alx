  assert_eq binary_search_func([1, 2, 2, 2, 3, 3, 3, 6], 3) { |a, b| a - b }, (4, true)
  assert_eq binary_search([1, 2, 2, 2, 3, 3, 3, 6], 6), (7, true)
  assert_eq binary_search_func([1, 2, 2, 2, 3, 3, 3, 6], 6) { |a, b| a - b }, (7, true)
  assert_eq binary_search([1, 2, 2, 2, 3, 3, 3, 6], 9), (8, false)
  assert_eq binary_search_func([1, 2, 2, 2, 3, 3, 3, 6], 9) { |a, b| a - b }, (8, false)
  assert_eq binary_search(vec_ints(), -1), (0, false)
  assert_eq binary_search_func(vec_ints(), -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 2), (0, false)
  assert_eq binary_search_func(vec_ints(), 2) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 3), (0, false)
  assert_eq binary_search_func(vec_ints(), 3) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 6), (0, false)
  assert_eq binary_search_func(vec_ints(), 6) { |a, b| a - b }, (0, false)
