  assert_eq compact_func([2, 3]) { |a, b| a == b + 1 }, [2]
  assert_eq delete_func([2, 3]) { it % 2 == 1 }, [2]
  assert_eq compact([1, 3, 2, 3, 2, 3, 2, 2]), [1, 3, 2, 3, 2, 3, 2]
  assert_eq compact_func([1, 3, 2, 3, 2, 3, 2, 2]) { |a, b| a == b + 1 }, [1, 3, 2, 2, 2, 2]
  assert_eq delete_func([1, 3, 2, 3, 2, 3, 2, 2]) { it % 2 == 1 }, [2, 2, 2, 2]
