  assert_eq binary_search([0, 1, 1, 2, 3, 3, 5, 7, 9], 3), (4, true)
  assert_eq binary_search_func([0, 1, 1, 2, 3, 3, 5, 7, 9], 3) { |a, b| a - b }, (4, true)
  assert_eq binary_search([0, 1, 1, 2, 3, 3, 5, 7, 9], 6), (7, false)
  assert_eq binary_search_func([0, 1, 1, 2, 3, 3, 5, 7, 9], 6) { |a, b| a - b }, (7, false)
  assert_eq binary_search([0, 1, 1, 2, 3, 3, 5, 7, 9], 7), (7, true)
  assert_eq binary_search_func([0, 1, 1, 2, 3, 3, 5, 7, 9], 7) { |a, b| a - b }, (7, true)
  assert_eq binary_search([0, 1, 1, 2, 3, 3, 5, 7, 9], 9), (8, true)
  assert_eq binary_search_func([0, 1, 1, 2, 3, 3, 5, 7, 9], 9) { |a, b| a - b }, (8, true)
  assert_eq binary_search([0, 1, 1, 2, 3, 3, 5, 7, 9], 10), (9, false)
  assert_eq binary_search_func([0, 1, 1, 2, 3, 3, 5, 7, 9], 10) { |a, b| a - b }, (9, false)
  assert_eq binary_search([0, 3, 3, 4, 4, 5, 6], -1), (0, false)
  assert_eq binary_search_func([0, 3, 3, 4, 4, 5, 6], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([0, 3, 3, 4, 4, 5, 6], 0), (0, true)
  assert_eq binary_search_func([0, 3, 3, 4, 4, 5, 6], 0) { |a, b| a - b }, (0, true)
  assert_eq binary_search([0, 3, 3, 4, 4, 5, 6], 1), (1, false)
  assert_eq binary_search_func([0, 3, 3, 4, 4, 5, 6], 1) { |a, b| a - b }, (1, false)
  assert_eq binary_search([0, 3, 3, 4, 4, 5, 6], 2), (1, false)
  assert_eq binary_search_func([0, 3, 3, 4, 4, 5, 6], 2) { |a, b| a - b }, (1, false)
  assert_eq binary_search([0, 3, 3, 4, 4, 5, 6], 4), (3, true)
  assert_eq binary_search_func([0, 3, 3, 4, 4, 5, 6], 4) { |a, b| a - b }, (3, true)
  assert_eq binary_search([0, 3, 3, 4, 4, 5, 6], 6), (6, true)
  assert_eq binary_search_func([0, 3, 3, 4, 4, 5, 6], 6) { |a, b| a - b }, (6, true)
  assert_eq binary_search([0, 3, 3, 4, 4, 5, 6], 8), (7, false)
  assert_eq binary_search_func([0, 3, 3, 4, 4, 5, 6], 8) { |a, b| a - b }, (7, false)
  assert_eq binary_search([2, 5, 5, 8, 9], -1), (0, false)
  assert_eq binary_search_func([2, 5, 5, 8, 9], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([2, 5, 5, 8, 9], 2), (0, true)
  assert_eq binary_search_func([2, 5, 5, 8, 9], 2) { |a, b| a - b }, (0, true)
  assert_eq binary_search([2, 5, 5, 8, 9], 4), (1, false)
  assert_eq binary_search_func([2, 5, 5, 8, 9], 4) { |a, b| a - b }, (1, false)
}

