test "vectors: min max 1" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq vec_fcode(min([nz])), 4
  assert_eq vec_fcode(max([nz])), 4
  assert_eq vec_fcode(min([nz])), 4
  assert_eq vec_fcode(max([nz])), 4
  assert_eq vec_fcode(min([-1.0])), 3
  assert_eq vec_fcode(max([-1.0])), 3
  assert_eq vec_fcode(min([0.0])), 5
  assert_eq vec_fcode(max([0.0])), 5
  assert_eq vec_fcode(min([inf])), 8
  assert_eq vec_fcode(max([inf])), 8
  assert_eq vec_fcode(min([0.0])), 5
  assert_eq vec_fcode(max([0.0])), 5
  assert_eq vec_fcode(min([-2.5])), 2
  assert_eq vec_fcode(max([-2.5])), 2
  assert_eq vec_fcode(min([inf])), 8
  assert_eq vec_fcode(max([inf])), 8
  assert_eq vec_fcode(min([0.0])), 5
  assert_eq vec_fcode(max([0.0])), 5
  assert_eq vec_fcode(min([0.0])), 5
  assert_eq vec_fcode(max([0.0])), 5
  assert_eq vec_fcode(min([2.5])), 7
  assert_eq vec_fcode(max([2.5])), 7
  assert_eq vec_fcode(min([inf])), 8
  assert_eq vec_fcode(max([inf])), 8
  assert_eq vec_fcode(min([-1.0, 0.0])), 3
  assert_eq vec_fcode(max([-1.0, 0.0])), 5
  assert_eq vec_fcode(min([nan, 2.5])), 0
  assert_eq vec_fcode(max([nan, 2.5])), 0
  assert_eq vec_fcode(min([2.5, inf])), 7
  assert_eq vec_fcode(max([2.5, inf])), 8
  assert_eq vec_fcode(min([0.0, 2.5])), 5
  assert_eq vec_fcode(max([0.0, 2.5])), 7
  assert_eq vec_fcode(min([0.0, 0.0])), 5
  assert_eq vec_fcode(max([0.0, 0.0])), 5
  assert_eq vec_fcode(min([ninf, 0.0])), 1
  assert_eq vec_fcode(max([ninf, 0.0])), 5
  assert_eq vec_fcode(min([-1.0, -2.5])), 2
  assert_eq vec_fcode(max([-1.0, -2.5])), 3
  assert_eq vec_fcode(min([-1.0, 0.0])), 3
  assert_eq vec_fcode(max([-1.0, 0.0])), 5
  assert_eq vec_fcode(min([1.0, ninf])), 1
  assert_eq vec_fcode(max([1.0, ninf])), 6
  assert_eq vec_fcode(min([2.5, 1.0])), 6
  assert_eq vec_fcode(max([2.5, 1.0])), 7
  assert_eq vec_fcode(min([-1.0, nan])), 0
  assert_eq vec_fcode(max([-1.0, nan])), 0
  assert_eq vec_fcode(min([1.0, 0.0])), 5
  assert_eq vec_fcode(max([1.0, 0.0])), 6
  assert_eq vec_fcode(min([nan, 0.0, 2.5])), 0
  assert_eq vec_fcode(max([nan, 0.0, 2.5])), 0
  assert_eq vec_fcode(min([2.5, inf, 2.5])), 7
  assert_eq vec_fcode(max([2.5, inf, 2.5])), 8
  assert_eq vec_fcode(min([nz, inf, 0.0])), 4
  assert_eq vec_fcode(max([nz, inf, 0.0])), 8
  assert_eq vec_fcode(min([nz, inf, 0.0])), 4
  assert_eq vec_fcode(max([nz, inf, 0.0])), 8
  assert_eq vec_fcode(min([-1.0, 1.0, 0.0])), 3
  assert_eq vec_fcode(max([-1.0, 1.0, 0.0])), 6
  assert_eq vec_fcode(min([-1.0, -2.5, -2.5])), 2
  assert_eq vec_fcode(max([-1.0, -2.5, -2.5])), 3
  assert_eq vec_fcode(min([-2.5, -1.0, nz])), 2
  assert_eq vec_fcode(max([-2.5, -1.0, nz])), 4
  assert_eq vec_fcode(min([-2.5, 0.0, nan])), 0
  assert_eq vec_fcode(max([-2.5, 0.0, nan])), 0
  assert_eq vec_fcode(min([ninf, nz, ninf])), 1
  assert_eq vec_fcode(max([ninf, nz, ninf])), 4
  assert_eq vec_fcode(min([inf, 0.0, inf])), 5
  assert_eq vec_fcode(max([inf, 0.0, inf])), 8
  assert_eq vec_fcode(min([inf, nz, 0.0])), 4
  assert_eq vec_fcode(max([inf, nz, 0.0])), 8
  assert_eq vec_fcode(min([-1.0, 0.0, nan])), 0
  assert_eq vec_fcode(max([-1.0, 0.0, nan])), 0
  assert_eq vec_fcode(min([nan, 2.5, 2.5, nan])), 0
  assert_eq vec_fcode(max([nan, 2.5, 2.5, nan])), 0
  assert_eq vec_fcode(min([nan, -1.0, 1.0, ninf])), 0
  assert_eq vec_fcode(max([nan, -1.0, 1.0, ninf])), 0
  assert_eq vec_fcode(min([-1.0, -1.0, nan, nan])), 0
  assert_eq vec_fcode(max([-1.0, -1.0, nan, nan])), 0
  assert_eq vec_fcode(min([1.0, -2.5, 0.0, nan])), 0
  assert_eq vec_fcode(max([1.0, -2.5, 0.0, nan])), 0
  assert_eq vec_fcode(min([0.0, 1.0, nz, ninf])), 1
  assert_eq vec_fcode(max([0.0, 1.0, nz, ninf])), 6
  assert_eq vec_fcode(min([nz, -1.0, 1.0, 1.0])), 3
  assert_eq vec_fcode(max([nz, -1.0, 1.0, 1.0])), 6
  assert_eq vec_fcode(min([-2.5, nz, inf, nz])), 2
  assert_eq vec_fcode(max([-2.5, nz, inf, nz])), 8
  assert_eq vec_fcode(min([0.0, ninf, inf, ninf])), 1
  assert_eq vec_fcode(max([0.0, ninf, inf, ninf])), 8
  assert_eq vec_fcode(min([0.0, nan, -2.5, nz])), 0
  assert_eq vec_fcode(max([0.0, nan, -2.5, nz])), 0
  assert_eq vec_fcode(min([-1.0, 1.0, 1.0, ninf])), 1
  assert_eq vec_fcode(max([-1.0, 1.0, 1.0, ninf])), 6
  assert_eq vec_fcode(min([ninf, ninf, inf, 1.0])), 1
  assert_eq vec_fcode(max([ninf, ninf, inf, 1.0])), 8
  assert_eq vec_fcode(min([-1.0, nz, inf, 1.0])), 3
  assert_eq vec_fcode(max([-1.0, nz, inf, 1.0])), 8
  assert_eq vec_fcode(min([nan, nz, nan, nan, 1.0])), 0
  assert_eq vec_fcode(max([nan, nz, nan, nan, 1.0])), 0
  assert_eq vec_fcode(min([1.0, nz, 0.0, ninf, ninf])), 1
  assert_eq vec_fcode(max([1.0, nz, 0.0, ninf, ninf])), 6
}

test "vectors: min max 2" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq vec_fcode(min([inf, inf, nan, ninf, -1.0])), 0
  assert_eq vec_fcode(max([inf, inf, nan, ninf, -1.0])), 0
  assert_eq vec_fcode(min([-1.0, nz, -2.5, -1.0, 0.0])), 2
  assert_eq vec_fcode(max([-1.0, nz, -2.5, -1.0, 0.0])), 5
  assert_eq vec_fcode(min([ninf, 2.5, nz, ninf, inf])), 1
  assert_eq vec_fcode(max([ninf, 2.5, nz, ninf, inf])), 8
  assert_eq vec_fcode(min([nz, 0.0, nz, 1.0, inf])), 4
  assert_eq vec_fcode(max([nz, 0.0, nz, 1.0, inf])), 8
  assert_eq vec_fcode(min([0.0, 0.0, 2.5, 0.0, -2.5])), 2
  assert_eq vec_fcode(max([0.0, 0.0, 2.5, 0.0, -2.5])), 7
  assert_eq vec_fcode(min([-1.0, -2.5, 0.0, inf, 0.0])), 2
  assert_eq vec_fcode(max([-1.0, -2.5, 0.0, inf, 0.0])), 8
  assert_eq vec_fcode(min([nz, nz, 0.0, -1.0, -1.0])), 3
  assert_eq vec_fcode(max([nz, nz, 0.0, -1.0, -1.0])), 5
  assert_eq vec_fcode(min([-2.5, 1.0, 1.0, nz, 2.5])), 2
  assert_eq vec_fcode(max([-2.5, 1.0, 1.0, nz, 2.5])), 7
  assert_eq vec_fcode(min([nz, nz, 2.5, 0.0, 1.0])), 4
  assert_eq vec_fcode(max([nz, nz, 2.5, 0.0, 1.0])), 7
  assert_eq vec_fcode(min([1.0, 2.5, 1.0, 1.0, 2.5])), 6
  assert_eq vec_fcode(max([1.0, 2.5, 1.0, 1.0, 2.5])), 7
  assert_eq vec_fcode(min([nan, 0.0, -2.5, inf, 0.0, 0.0])), 0
  assert_eq vec_fcode(max([nan, 0.0, -2.5, inf, 0.0, 0.0])), 0
  assert_eq vec_fcode(min([nz, inf, nz, 2.5, ninf, -2.5])), 1
  assert_eq vec_fcode(max([nz, inf, nz, 2.5, ninf, -2.5])), 8
  assert_eq vec_fcode(min([-1.0, -2.5, nan, inf, nan, 1.0])), 0
  assert_eq vec_fcode(max([-1.0, -2.5, nan, inf, nan, 1.0])), 0
  assert_eq vec_fcode(min([inf, nan, nz, 0.0, nan, ninf])), 0
  assert_eq vec_fcode(max([inf, nan, nz, 0.0, nan, ninf])), 0
  assert_eq vec_fcode(min([1.0, 0.0, 1.0, 2.5, 0.0, nz])), 4
  assert_eq vec_fcode(max([1.0, 0.0, 1.0, 2.5, 0.0, nz])), 7
  assert_eq vec_fcode(min([2.5, nan, 0.0, ninf, -2.5, 2.5])), 0
  assert_eq vec_fcode(max([2.5, nan, 0.0, ninf, -2.5, 2.5])), 0
  assert_eq vec_fcode(min([-2.5, 0.0, inf, 1.0, ninf, -2.5])), 1
  assert_eq vec_fcode(max([-2.5, 0.0, inf, 1.0, ninf, -2.5])), 8
  assert_eq vec_fcode(min([-1.0, 2.5, ninf, -1.0, nz, nan])), 0
  assert_eq vec_fcode(max([-1.0, 2.5, ninf, -1.0, nz, nan])), 0
  assert_eq vec_fcode(min([2.5, 0.0, nz, 0.0, -2.5, nan])), 0
  assert_eq vec_fcode(max([2.5, 0.0, nz, 0.0, -2.5, nan])), 0
  assert_eq vec_fcode(min([nan, nan, 2.5, -1.0, -1.0, nan])), 0
  assert_eq vec_fcode(max([nan, nan, 2.5, -1.0, -1.0, nan])), 0
  assert_eq vec_fcode(min([-1.0, nan, -1.0, nan, inf, -1.0])), 0
  assert_eq vec_fcode(max([-1.0, nan, -1.0, nan, inf, -1.0])), 0
  assert_eq vec_fcode(min([inf, nan, -1.0, 0.0, 1.0, ninf])), 0
  assert_eq vec_fcode(max([inf, nan, -1.0, 0.0, 1.0, ninf])), 0
  assert_eq vec_fcode(min([-2.5, 1.0, -2.5, 2.5, nz, 1.0, 2.5])), 2
  assert_eq vec_fcode(max([-2.5, 1.0, -2.5, 2.5, nz, 1.0, 2.5])), 7
  assert_eq vec_fcode(min([-1.0, nan, -2.5, 1.0, -1.0, ninf, nz])), 0
  assert_eq vec_fcode(max([-1.0, nan, -2.5, 1.0, -1.0, ninf, nz])), 0
  assert_eq vec_fcode(min([0.0, 2.5, 2.5, inf, 1.0, nz, ninf])), 1
  assert_eq vec_fcode(max([0.0, 2.5, 2.5, inf, 1.0, nz, ninf])), 8
  assert_eq vec_fcode(min([1.0, nz, inf, 2.5, ninf, 1.0, -1.0])), 1
  assert_eq vec_fcode(max([1.0, nz, inf, 2.5, ninf, 1.0, -1.0])), 8
  assert_eq vec_fcode(min([1.0, 2.5, 1.0, ninf, nz, 0.0, nan])), 0
  assert_eq vec_fcode(max([1.0, 2.5, 1.0, ninf, nz, 0.0, nan])), 0
  assert_eq vec_fcode(min([1.0, nz, -1.0, ninf, inf, nan, nz])), 0
  assert_eq vec_fcode(max([1.0, nz, -1.0, ninf, inf, nan, nz])), 0
  assert_eq vec_fcode(min([inf, -1.0, ninf, nz, inf, 2.5, inf])), 1
  assert_eq vec_fcode(max([inf, -1.0, ninf, nz, inf, 2.5, inf])), 8
  assert_eq vec_fcode(min([ninf, inf, 2.5, -1.0, inf, inf, nan])), 0
  assert_eq vec_fcode(max([ninf, inf, 2.5, -1.0, inf, inf, nan])), 0
  assert_eq vec_fcode(min([0.0, ninf, nan, inf, nan, -1.0, -1.0])), 0
  assert_eq vec_fcode(max([0.0, ninf, nan, inf, nan, -1.0, -1.0])), 0
  assert_eq vec_fcode(min([ninf, nan, -2.5, ninf, nan, 0.0, ninf])), 0
  assert_eq vec_fcode(max([ninf, nan, -2.5, ninf, nan, 0.0, ninf])), 0
  assert_eq vec_fcode(min([0.0, 1.0, nz, 1.0, nan, ninf, nan])), 0
  assert_eq vec_fcode(max([0.0, 1.0, nz, 1.0, nan, ninf, nan])), 0
  assert_eq vec_fcode(min([-2.5, inf, -2.5, -1.0, 1.0, 0.0, -2.5])), 2
  assert_eq vec_fcode(max([-2.5, inf, -2.5, -1.0, 1.0, 0.0, -2.5])), 8
  assert_eq vec_fcode(min([nan, -1.0, inf, 1.0, 1.0, inf, nz, inf])), 0
  assert_eq vec_fcode(max([nan, -1.0, inf, 1.0, 1.0, inf, nz, inf])), 0
  assert_eq vec_fcode(min([0.0, 0.0, nz, 1.0, -1.0, 0.0, ninf, -1.0])), 1
  assert_eq vec_fcode(max([0.0, 0.0, nz, 1.0, -1.0, 0.0, ninf, -1.0])), 6
  assert_eq vec_fcode(min([0.0, inf, -2.5, inf, nz, 0.0, -1.0, -2.5])), 2
  assert_eq vec_fcode(max([0.0, inf, -2.5, inf, nz, 0.0, -1.0, -2.5])), 8
  assert_eq vec_fcode(min([nz, nan, inf, -1.0, ninf, ninf, nan, nz])), 0
  assert_eq vec_fcode(max([nz, nan, inf, -1.0, ninf, ninf, nan, nz])), 0
  assert_eq vec_fcode(min([2.5, 1.0, nan, 2.5, 2.5, -2.5, 1.0, nz])), 0
  assert_eq vec_fcode(max([2.5, 1.0, nan, 2.5, 2.5, -2.5, 1.0, nz])), 0
  assert_eq vec_fcode(min([-1.0, 2.5, -1.0, -1.0, 2.5, -2.5, 1.0, 1.0])), 2
  assert_eq vec_fcode(max([-1.0, 2.5, -1.0, -1.0, 2.5, -2.5, 1.0, 1.0])), 7
  assert_eq vec_fcode(min([nan, nan, ninf, ninf, ninf, 2.5, -1.0, inf])), 0
  assert_eq vec_fcode(max([nan, nan, ninf, ninf, ninf, 2.5, -1.0, inf])), 0
  assert_eq vec_fcode(min([1.0, 0.0, 1.0, 2.5, 0.0, nz, -2.5, 0.0])), 2
  assert_eq vec_fcode(max([1.0, 0.0, 1.0, 2.5, 0.0, nz, -2.5, 0.0])), 7
  assert_eq vec_fcode(min([1.0, ninf, nan, inf, -1.0, ninf, ninf, nz])), 0
  assert_eq vec_fcode(max([1.0, ninf, nan, inf, -1.0, ninf, ninf, nz])), 0
  assert_eq vec_fcode(min([-2.5, inf, 2.5, ninf, 2.5, ninf, 2.5, 1.0])), 1
  assert_eq vec_fcode(max([-2.5, inf, 2.5, ninf, 2.5, ninf, 2.5, 1.0])), 8
  assert_eq vec_fcode(min([nan, 2.5, -1.0, 2.5, -2.5, nz, nz, ninf])), 0
  assert_eq vec_fcode(max([nan, 2.5, -1.0, 2.5, -2.5, nz, nz, ninf])), 0
  assert_eq vec_fcode(min([2.5, 1.0, 1.0, inf, ninf, ninf, nan, ninf])), 0
  assert_eq vec_fcode(max([2.5, 1.0, 1.0, inf, ninf, ninf, nan, ninf])), 0
  assert_eq vec_fcode(min([0.0, nz])), 4
  assert_eq vec_fcode(max([0.0, nz])), 5
  assert_eq vec_fcode(min([nz, 0.0])), 4
  assert_eq vec_fcode(max([nz, 0.0])), 5
  assert_eq vec_fcode(min([0.0, 0.0])), 5
  assert_eq vec_fcode(max([0.0, 0.0])), 5
  assert_eq vec_fcode(min([nz, nz])), 4
  assert_eq vec_fcode(max([nz, nz])), 4
}

test "vectors: min max 3" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq min([-1, 2, -4, 8, 4, 2, 6]), -4
  assert_eq max([-1, 2, -4, 8, 4, 2, 6]), 8
  assert_eq min_func([-1, 2, -4, 8, 4, 2, 6]) { |a, b| a / 3 - b / 3 }, -4
  assert_eq max_func([-1, 2, -4, 8, 4, 2, 6]) { |a, b| a / 3 - b / 3 }, 8
  assert_eq min([-3, -1, -3, 1, -10]), -10
  assert_eq max([-3, -1, -3, 1, -10]), 1
  assert_eq min_func([-3, -1, -3, 1, -10]) { |a, b| a / 3 - b / 3 }, -10
  assert_eq max_func([-3, -1, -3, 1, -10]) { |a, b| a / 3 - b / 3 }, -1
  assert_eq min([-7, 6, -5]), -7
  assert_eq max([-7, 6, -5]), 6
  assert_eq min_func([-7, 6, -5]) { |a, b| a / 3 - b / 3 }, -7
  assert_eq max_func([-7, 6, -5]) { |a, b| a / 3 - b / 3 }, 6
  assert_eq min([-10, -7, 4, -2, 7, 3]), -10
  assert_eq max([-10, -7, 4, -2, 7, 3]), 7
  assert_eq min_func([-10, -7, 4, -2, 7, 3]) { |a, b| a / 3 - b / 3 }, -10
  assert_eq max_func([-10, -7, 4, -2, 7, 3]) { |a, b| a / 3 - b / 3 }, 7
  assert_eq min([-9, 9, -8, 2, -9, -3]), -9
  assert_eq max([-9, 9, -8, 2, -9, -3]), 9
  assert_eq min_func([-9, 9, -8, 2, -9, -3]) { |a, b| a / 3 - b / 3 }, -9
  assert_eq max_func([-9, 9, -8, 2, -9, -3]) { |a, b| a / 3 - b / 3 }, 9
  assert_eq min([-3]), -3
  assert_eq max([-3]), -3
  assert_eq min_func([-3]) { |a, b| a / 3 - b / 3 }, -3
  assert_eq max_func([-3]) { |a, b| a / 3 - b / 3 }, -3
  assert_eq min([-8, -3, 7, -5, 1, -8, 7, 4, -3]), -8
  assert_eq max([-8, -3, 7, -5, 1, -8, 7, 4, -3]), 7
  assert_eq min_func([-8, -3, 7, -5, 1, -8, 7, 4, -3]) { |a, b| a / 3 - b / 3 }, -8
  assert_eq max_func([-8, -3, 7, -5, 1, -8, 7, 4, -3]) { |a, b| a / 3 - b / 3 }, 7
  assert_eq min([-1, -10, 3, -5, 9, -7, 6]), -10
  assert_eq max([-1, -10, 3, -5, 9, -7, 6]), 9
  assert_eq min_func([-1, -10, 3, -5, 9, -7, 6]) { |a, b| a / 3 - b / 3 }, -10
  assert_eq max_func([-1, -10, 3, -5, 9, -7, 6]) { |a, b| a / 3 - b / 3 }, 9
  assert_eq min([0, -9, 0]), -9
  assert_eq max([0, -9, 0]), 0
  assert_eq min_func([0, -9, 0]) { |a, b| a / 3 - b / 3 }, -9
  assert_eq max_func([0, -9, 0]) { |a, b| a / 3 - b / 3 }, 0
  assert_eq min([-10, -1, 5, 1, 8, 5, -7, 1]), -10
  assert_eq max([-10, -1, 5, 1, 8, 5, -7, 1]), 8
  assert_eq min_func([-10, -1, 5, 1, 8, 5, -7, 1]) { |a, b| a / 3 - b / 3 }, -10
  assert_eq max_func([-10, -1, 5, 1, 8, 5, -7, 1]) { |a, b| a / 3 - b / 3 }, 8
  assert_eq min([-2, 5, -3, 5, 4, 7]), -3
  assert_eq max([-2, 5, -3, 5, 4, 7]), 7
  assert_eq min_func([-2, 5, -3, 5, 4, 7]) { |a, b| a / 3 - b / 3 }, -3
  assert_eq max_func([-2, 5, -3, 5, 4, 7]) { |a, b| a / 3 - b / 3 }, 7
  assert_eq min([6, -1, -9, 7, -4]), -9
  assert_eq max([6, -1, -9, 7, -4]), 7
  assert_eq min_func([6, -1, -9, 7, -4]) { |a, b| a / 3 - b / 3 }, -9
  assert_eq max_func([6, -1, -9, 7, -4]) { |a, b| a / 3 - b / 3 }, 6
  assert_eq min([-7, 2, -5, -4, -5]), -7
  assert_eq max([-7, 2, -5, -4, -5]), 2
  assert_eq min_func([-7, 2, -5, -4, -5]) { |a, b| a / 3 - b / 3 }, -7
  assert_eq max_func([-7, 2, -5, -4, -5]) { |a, b| a / 3 - b / 3 }, 2
  assert_eq min([-2, 0, 4, 0, 7, -10, 3, -8]), -10
  assert_eq max([-2, 0, 4, 0, 7, -10, 3, -8]), 7
  assert_eq min_func([-2, 0, 4, 0, 7, -10, 3, -8]) { |a, b| a / 3 - b / 3 }, -10
  assert_eq max_func([-2, 0, 4, 0, 7, -10, 3, -8]) { |a, b| a / 3 - b / 3 }, 7
  assert_eq min([8, -8, 5, 1, -5, 1, -5]), -8
  assert_eq max([8, -8, 5, 1, -5, 1, -5]), 8
  assert_eq min_func([8, -8, 5, 1, -5, 1, -5]) { |a, b| a / 3 - b / 3 }, -8
  assert_eq max_func([8, -8, 5, 1, -5, 1, -5]) { |a, b| a / 3 - b / 3 }, 8
  assert_eq min([0, -2, -7, -7, -10]), -10
  assert_eq max([0, -2, -7, -7, -10]), 0
  assert_eq min_func([0, -2, -7, -7, -10]) { |a, b| a / 3 - b / 3 }, -10
  assert_eq max_func([0, -2, -7, -7, -10]) { |a, b| a / 3 - b / 3 }, 0
  assert_eq min([-5, -9, 2, -5, -2, 1, -2]), -9
  assert_eq max([-5, -9, 2, -5, -2, 1, -2]), 2
  assert_eq min_func([-5, -9, 2, -5, -2, 1, -2]) { |a, b| a / 3 - b / 3 }, -9
  assert_eq max_func([-5, -9, 2, -5, -2, 1, -2]) { |a, b| a / 3 - b / 3 }, 2
  assert_eq min([6, -8, 8, -2, 1, 4]), -8
  assert_eq max([6, -8, 8, -2, 1, 4]), 8
  assert_eq min_func([6, -8, 8, -2, 1, 4]) { |a, b| a / 3 - b / 3 }, -8
  assert_eq max_func([6, -8, 8, -2, 1, 4]) { |a, b| a / 3 - b / 3 }, 6
  assert_eq min([-10, 5, 0, -1]), -10
  assert_eq max([-10, 5, 0, -1]), 5
  assert_eq min_func([-10, 5, 0, -1]) { |a, b| a / 3 - b / 3 }, -10
  assert_eq max_func([-10, 5, 0, -1]) { |a, b| a / 3 - b / 3 }, 5
  assert_eq min([5, 4, -2, 3, -9, 8, 0, 1]), -9
  assert_eq max([5, 4, -2, 3, -9, 8, 0, 1]), 8
  assert_eq min_func([5, 4, -2, 3, -9, 8, 0, 1]) { |a, b| a / 3 - b / 3 }, -9
  assert_eq max_func([5, 4, -2, 3, -9, 8, 0, 1]) { |a, b| a / 3 - b / 3 }, 8
  assert_eq min([4, -9]), -9
  assert_eq max([4, -9]), 4
  assert_eq min_func([4, -9]) { |a, b| a / 3 - b / 3 }, -9
  assert_eq max_func([4, -9]) { |a, b| a / 3 - b / 3 }, 4
  assert_eq min([7, -6]), -6
  assert_eq max([7, -6]), 7
  assert_eq min_func([7, -6]) { |a, b| a / 3 - b / 3 }, -6
  assert_eq max_func([7, -6]) { |a, b| a / 3 - b / 3 }, 7
  assert_eq min([8]), 8
  assert_eq max([8]), 8
  assert_eq min_func([8]) { |a, b| a / 3 - b / 3 }, 8
  assert_eq max_func([8]) { |a, b| a / 3 - b / 3 }, 8
  assert_eq min([6, -5, 4, -1, 3, 7, -7]), -7
  assert_eq max([6, -5, 4, -1, 3, 7, -7]), 7
  assert_eq min_func([6, -5, 4, -1, 3, 7, -7]) { |a, b| a / 3 - b / 3 }, -7
  assert_eq max_func([6, -5, 4, -1, 3, 7, -7]) { |a, b| a / 3 - b / 3 }, 6
  assert_eq min([-9, -3, -8, -9, -5, -5]), -9
  assert_eq max([-9, -3, -8, -9, -5, -5]), -3
  assert_eq min_func([-9, -3, -8, -9, -5, -5]) { |a, b| a / 3 - b / 3 }, -9
  assert_eq max_func([-9, -3, -8, -9, -5, -5]) { |a, b| a / 3 - b / 3 }, -3
}

test "vectors: min max 4" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq min([9, 0, -7, -1, -7, -4]), -7
  assert_eq max([9, 0, -7, -1, -7, -4]), 9
  assert_eq min_func([9, 0, -7, -1, -7, -4]) { |a, b| a / 3 - b / 3 }, -7
  assert_eq max_func([9, 0, -7, -1, -7, -4]) { |a, b| a / 3 - b / 3 }, 9
  assert_eq min([-10, 3, 0, -7, -2, 5, -4]), -10
  assert_eq max([-10, 3, 0, -7, -2, 5, -4]), 5
  assert_eq min_func([-10, 3, 0, -7, -2, 5, -4]) { |a, b| a / 3 - b / 3 }, -10
  assert_eq max_func([-10, 3, 0, -7, -2, 5, -4]) { |a, b| a / 3 - b / 3 }, 3
  assert_eq min([6, -10, 8, 2, -8, -6, 7, -1, -9]), -10
  assert_eq max([6, -10, 8, 2, -8, -6, 7, -1, -9]), 8
  assert_eq min_func([6, -10, 8, 2, -8, -6, 7, -1, -9]) { |a, b| a / 3 - b / 3 }, -10
  assert_eq max_func([6, -10, 8, 2, -8, -6, 7, -1, -9]) { |a, b| a / 3 - b / 3 }, 6
  assert_eq min([-2, 4, 3]), -2
  assert_eq max([-2, 4, 3]), 4
  assert_eq min_func([-2, 4, 3]) { |a, b| a / 3 - b / 3 }, -2
  assert_eq max_func([-2, 4, 3]) { |a, b| a / 3 - b / 3 }, 4
  assert_eq min([-2, -4, -4]), -4
  assert_eq max([-2, -4, -4]), -2
  assert_eq min_func([-2, -4, -4]) { |a, b| a / 3 - b / 3 }, -4
  assert_eq max_func([-2, -4, -4]) { |a, b| a / 3 - b / 3 }, -2
}

test "vectors: binary_search 1" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq binary_search([1, 2, 2, 2, 3, 3, 3, 6], -1), (0, false)
  assert_eq binary_search_func([1, 2, 2, 2, 3, 3, 3, 6], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([1, 2, 2, 2, 3, 3, 3, 6], 1), (0, true)
  assert_eq binary_search_func([1, 2, 2, 2, 3, 3, 3, 6], 1) { |a, b| a - b }, (0, true)
  assert_eq binary_search([1, 2, 2, 2, 3, 3, 3, 6], 2), (1, true)
  assert_eq binary_search_func([1, 2, 2, 2, 3, 3, 3, 6], 2) { |a, b| a - b }, (1, true)
