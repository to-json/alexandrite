  assert_eq binary_search_func([0, 5, 5, 6], 10) { |a, b| a - b }, (4, false)
  assert_eq binary_search(vec_ints(), -1), (0, false)
  assert_eq binary_search_func(vec_ints(), -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 0), (0, false)
  assert_eq binary_search_func(vec_ints(), 0) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 1), (0, false)
  assert_eq binary_search_func(vec_ints(), 1) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 4), (0, false)
  assert_eq binary_search_func(vec_ints(), 4) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 5), (0, false)
  assert_eq binary_search_func(vec_ints(), 5) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 8), (0, false)
  assert_eq binary_search_func(vec_ints(), 8) { |a, b| a - b }, (0, false)
  assert_eq binary_search([0, 2, 4], -1), (0, false)
  assert_eq binary_search_func([0, 2, 4], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([0, 2, 4], 0), (0, true)
  assert_eq binary_search_func([0, 2, 4], 0) { |a, b| a - b }, (0, true)
  assert_eq binary_search([0, 2, 4], 1), (1, false)
  assert_eq binary_search_func([0, 2, 4], 1) { |a, b| a - b }, (1, false)
  assert_eq binary_search([0, 2, 4], 2), (1, true)
  assert_eq binary_search_func([0, 2, 4], 2) { |a, b| a - b }, (1, true)
  assert_eq binary_search([0, 2, 4], 5), (3, false)
  assert_eq binary_search_func([0, 2, 4], 5) { |a, b| a - b }, (3, false)
  assert_eq binary_search([0, 2, 4], 6), (3, false)
  assert_eq binary_search_func([0, 2, 4], 6) { |a, b| a - b }, (3, false)
  assert_eq binary_search([0, 2, 4], 8), (3, false)
  assert_eq binary_search_func([0, 2, 4], 8) { |a, b| a - b }, (3, false)
  assert_eq binary_search([0, 2, 4], 10), (3, false)
  assert_eq binary_search_func([0, 2, 4], 10) { |a, b| a - b }, (3, false)
  assert_eq binary_search([0, 0, 1, 2, 5, 6, 6, 6, 7, 7, 8], -1), (0, false)
  assert_eq binary_search_func([0, 0, 1, 2, 5, 6, 6, 6, 7, 7, 8], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([0, 0, 1, 2, 5, 6, 6, 6, 7, 7, 8], 1), (2, true)
  assert_eq binary_search_func([0, 0, 1, 2, 5, 6, 6, 6, 7, 7, 8], 1) { |a, b| a - b }, (2, true)
  assert_eq binary_search([0, 0, 1, 2, 5, 6, 6, 6, 7, 7, 8], 4), (4, false)
  assert_eq binary_search_func([0, 0, 1, 2, 5, 6, 6, 6, 7, 7, 8], 4) { |a, b| a - b }, (4, false)
  assert_eq binary_search([0, 0, 1, 2, 5, 6, 6, 6, 7, 7, 8], 7), (8, true)
  assert_eq binary_search_func([0, 0, 1, 2, 5, 6, 6, 6, 7, 7, 8], 7) { |a, b| a - b }, (8, true)
  assert_eq binary_search([0, 0, 1, 2, 5, 6, 6, 6, 7, 7, 8], 8), (10, true)
  assert_eq binary_search_func([0, 0, 1, 2, 5, 6, 6, 6, 7, 7, 8], 8) { |a, b| a - b }, (10, true)
  assert_eq binary_search([1], -1), (0, false)
  assert_eq binary_search_func([1], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([1], 1), (0, true)
  assert_eq binary_search_func([1], 1) { |a, b| a - b }, (0, true)
  assert_eq binary_search([1], 2), (1, false)
  assert_eq binary_search_func([1], 2) { |a, b| a - b }, (1, false)
  assert_eq binary_search([1], 5), (1, false)
  assert_eq binary_search_func([1], 5) { |a, b| a - b }, (1, false)
  assert_eq binary_search([1], 7), (1, false)
  assert_eq binary_search_func([1], 7) { |a, b| a - b }, (1, false)
  assert_eq binary_search([1], 9), (1, false)
  assert_eq binary_search_func([1], 9) { |a, b| a - b }, (1, false)
  assert_eq binary_search([2, 3, 4, 5, 5, 6, 8, 9], -1), (0, false)
  assert_eq binary_search_func([2, 3, 4, 5, 5, 6, 8, 9], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([2, 3, 4, 5, 5, 6, 8, 9], 2), (0, true)
  assert_eq binary_search_func([2, 3, 4, 5, 5, 6, 8, 9], 2) { |a, b| a - b }, (0, true)
  assert_eq binary_search([2, 3, 4, 5, 5, 6, 8, 9], 4), (2, true)
  assert_eq binary_search_func([2, 3, 4, 5, 5, 6, 8, 9], 4) { |a, b| a - b }, (2, true)
  assert_eq binary_search([2, 3, 4, 5, 5, 6, 8, 9], 5), (3, true)
  assert_eq binary_search_func([2, 3, 4, 5, 5, 6, 8, 9], 5) { |a, b| a - b }, (3, true)
  assert_eq binary_search([2, 3, 4, 5, 5, 6, 8, 9], 6), (5, true)
  assert_eq binary_search_func([2, 3, 4, 5, 5, 6, 8, 9], 6) { |a, b| a - b }, (5, true)
  assert_eq binary_search([2, 3, 4, 5, 5, 6, 8, 9], 7), (6, false)
  assert_eq binary_search_func([2, 3, 4, 5, 5, 6, 8, 9], 7) { |a, b| a - b }, (6, false)
  assert_eq binary_search([2, 3, 4, 5, 5, 6, 8, 9], 10), (8, false)
  assert_eq binary_search_func([2, 3, 4, 5, 5, 6, 8, 9], 10) { |a, b| a - b }, (8, false)
  assert_eq binary_search([2, 3, 3, 5, 6], -1), (0, false)
  assert_eq binary_search_func([2, 3, 3, 5, 6], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([2, 3, 3, 5, 6], 1), (0, false)
  assert_eq binary_search_func([2, 3, 3, 5, 6], 1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([2, 3, 3, 5, 6], 3), (1, true)
  assert_eq binary_search_func([2, 3, 3, 5, 6], 3) { |a, b| a - b }, (1, true)
  assert_eq binary_search([2, 3, 3, 5, 6], 4), (3, false)
  assert_eq binary_search_func([2, 3, 3, 5, 6], 4) { |a, b| a - b }, (3, false)
  assert_eq binary_search([2, 3, 3, 5, 6], 6), (4, true)
  assert_eq binary_search_func([2, 3, 3, 5, 6], 6) { |a, b| a - b }, (4, true)
  assert_eq binary_search([2, 3, 3, 5, 6], 8), (5, false)
  assert_eq binary_search_func([2, 3, 3, 5, 6], 8) { |a, b| a - b }, (5, false)
  assert_eq binary_search([2, 3, 3, 5, 6], 10), (5, false)
  assert_eq binary_search_func([2, 3, 3, 5, 6], 10) { |a, b| a - b }, (5, false)
  assert_eq binary_search([3, 5], -1), (0, false)
  assert_eq binary_search_func([3, 5], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([3, 5], 2), (0, false)
  assert_eq binary_search_func([3, 5], 2) { |a, b| a - b }, (0, false)
  assert_eq binary_search([3, 5], 5), (1, true)
  assert_eq binary_search_func([3, 5], 5) { |a, b| a - b }, (1, true)
  assert_eq binary_search([3, 5], 6), (2, false)
  assert_eq binary_search_func([3, 5], 6) { |a, b| a - b }, (2, false)
  assert_eq binary_search([3, 5], 9), (2, false)
  assert_eq binary_search_func([3, 5], 9) { |a, b| a - b }, (2, false)
  assert_eq binary_search([3, 5], 10), (2, false)
  assert_eq binary_search_func([3, 5], 10) { |a, b| a - b }, (2, false)
}

test "vectors: binary_search 8" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq binary_search([3, 4, 7, 8], -1), (0, false)
  assert_eq binary_search_func([3, 4, 7, 8], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([3, 4, 7, 8], 0), (0, false)
  assert_eq binary_search_func([3, 4, 7, 8], 0) { |a, b| a - b }, (0, false)
  assert_eq binary_search([3, 4, 7, 8], 2), (0, false)
  assert_eq binary_search_func([3, 4, 7, 8], 2) { |a, b| a - b }, (0, false)
  assert_eq binary_search([3, 4, 7, 8], 3), (0, true)
  assert_eq binary_search_func([3, 4, 7, 8], 3) { |a, b| a - b }, (0, true)
  assert_eq binary_search([3, 4, 7, 8], 6), (2, false)
  assert_eq binary_search_func([3, 4, 7, 8], 6) { |a, b| a - b }, (2, false)
  assert_eq binary_search([3, 4, 7, 8], 7), (2, true)
  assert_eq binary_search_func([3, 4, 7, 8], 7) { |a, b| a - b }, (2, true)
  assert_eq binary_search([3, 4, 7, 8], 8), (3, true)
  assert_eq binary_search_func([3, 4, 7, 8], 8) { |a, b| a - b }, (3, true)
  assert_eq binary_search([3, 4, 7, 8], 10), (4, false)
  assert_eq binary_search_func([3, 4, 7, 8], 10) { |a, b| a - b }, (4, false)
  assert_eq binary_search([1, 2, 3, 3, 3, 3], -1), (0, false)
  assert_eq binary_search_func([1, 2, 3, 3, 3, 3], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([1, 2, 3, 3, 3, 3], 1), (0, true)
  assert_eq binary_search_func([1, 2, 3, 3, 3, 3], 1) { |a, b| a - b }, (0, true)
  assert_eq binary_search([1, 2, 3, 3, 3, 3], 2), (1, true)
  assert_eq binary_search_func([1, 2, 3, 3, 3, 3], 2) { |a, b| a - b }, (1, true)
  assert_eq binary_search([1, 2, 3, 3, 3, 3], 5), (6, false)
  assert_eq binary_search_func([1, 2, 3, 3, 3, 3], 5) { |a, b| a - b }, (6, false)
  assert_eq binary_search([1, 2, 3, 3, 3, 3], 8), (6, false)
  assert_eq binary_search_func([1, 2, 3, 3, 3, 3], 8) { |a, b| a - b }, (6, false)
  assert_eq binary_search([1, 2, 3, 3, 3, 3], 9), (6, false)
  assert_eq binary_search_func([1, 2, 3, 3, 3, 3], 9) { |a, b| a - b }, (6, false)
  assert_eq binary_search(vec_ints(), -1), (0, false)
  assert_eq binary_search_func(vec_ints(), -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 2), (0, false)
  assert_eq binary_search_func(vec_ints(), 2) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 5), (0, false)
  assert_eq binary_search_func(vec_ints(), 5) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 8), (0, false)
  assert_eq binary_search_func(vec_ints(), 8) { |a, b| a - b }, (0, false)
  assert_eq binary_search(vec_ints(), 10), (0, false)
  assert_eq binary_search_func(vec_ints(), 10) { |a, b| a - b }, (0, false)
  assert_eq binary_search([0, 0, 1, 4, 8, 9, 9], -1), (0, false)
  assert_eq binary_search_func([0, 0, 1, 4, 8, 9, 9], -1) { |a, b| a - b }, (0, false)
  assert_eq binary_search([0, 0, 1, 4, 8, 9, 9], 0), (0, true)
  assert_eq binary_search_func([0, 0, 1, 4, 8, 9, 9], 0) { |a, b| a - b }, (0, true)
  assert_eq binary_search([0, 0, 1, 4, 8, 9, 9], 3), (3, false)
  assert_eq binary_search_func([0, 0, 1, 4, 8, 9, 9], 3) { |a, b| a - b }, (3, false)
  assert_eq binary_search([0, 0, 1, 4, 8, 9, 9], 4), (3, true)
  assert_eq binary_search_func([0, 0, 1, 4, 8, 9, 9], 4) { |a, b| a - b }, (3, true)
  assert_eq binary_search([0, 0, 1, 4, 8, 9, 9], 7), (4, false)
  assert_eq binary_search_func([0, 0, 1, 4, 8, 9, 9], 7) { |a, b| a - b }, (4, false)
  assert_eq binary_search([0, 0, 1, 4, 8, 9, 9], 9), (5, true)
  assert_eq binary_search_func([0, 0, 1, 4, 8, 9, 9], 9) { |a, b| a - b }, (5, true)
  assert_eq binary_search([nz], nan), (0, false)
  assert_eq binary_search([nz], ninf), (0, false)
  assert_eq binary_search([nz], -2.5), (0, false)
  assert_eq binary_search([nz], -1.0), (0, false)
  assert_eq binary_search([nz], nz), (0, true)
  assert_eq binary_search([nz], 0.0), (0, true)
  assert_eq binary_search([nz], 1.0), (1, false)
  assert_eq binary_search([nz], 2.5), (1, false)
  assert_eq binary_search([nz], inf), (1, false)
  assert_eq binary_search([nan, 0.0, 2.5, inf, inf], nan), (0, true)
  assert_eq binary_search([nan, 0.0, 2.5, inf, inf], ninf), (1, false)
  assert_eq binary_search([nan, 0.0, 2.5, inf, inf], -2.5), (1, false)
  assert_eq binary_search([nan, 0.0, 2.5, inf, inf], -1.0), (1, false)
  assert_eq binary_search([nan, 0.0, 2.5, inf, inf], nz), (1, true)
  assert_eq binary_search([nan, 0.0, 2.5, inf, inf], 0.0), (1, true)
  assert_eq binary_search([nan, 0.0, 2.5, inf, inf], 1.0), (2, false)
  assert_eq binary_search([nan, 0.0, 2.5, inf, inf], 2.5), (2, true)
  assert_eq binary_search([nan, 0.0, 2.5, inf, inf], inf), (3, true)
  assert_eq binary_search([ninf, nz, nz, 1.0], nan), (0, false)
  assert_eq binary_search([ninf, nz, nz, 1.0], ninf), (0, true)
  assert_eq binary_search([ninf, nz, nz, 1.0], -2.5), (1, false)
  assert_eq binary_search([ninf, nz, nz, 1.0], -1.0), (1, false)
  assert_eq binary_search([ninf, nz, nz, 1.0], nz), (1, true)
  assert_eq binary_search([ninf, nz, nz, 1.0], 0.0), (1, true)
  assert_eq binary_search([ninf, nz, nz, 1.0], 1.0), (3, true)
  assert_eq binary_search([ninf, nz, nz, 1.0], 2.5), (4, false)
  assert_eq binary_search([ninf, nz, nz, 1.0], inf), (4, false)
  assert_eq binary_search(vec_floats(), nan), (0, false)
  assert_eq binary_search(vec_floats(), ninf), (0, false)
  assert_eq binary_search(vec_floats(), -2.5), (0, false)
  assert_eq binary_search(vec_floats(), -1.0), (0, false)
  assert_eq binary_search(vec_floats(), nz), (0, false)
  assert_eq binary_search(vec_floats(), 0.0), (0, false)
  assert_eq binary_search(vec_floats(), 1.0), (0, false)
  assert_eq binary_search(vec_floats(), 2.5), (0, false)
  assert_eq binary_search(vec_floats(), inf), (0, false)
  assert_eq binary_search([ninf, nz], nan), (0, false)
  assert_eq binary_search([ninf, nz], ninf), (0, true)
  assert_eq binary_search([ninf, nz], -2.5), (1, false)
  assert_eq binary_search([ninf, nz], -1.0), (1, false)
  assert_eq binary_search([ninf, nz], nz), (1, true)
  assert_eq binary_search([ninf, nz], 0.0), (1, true)
  assert_eq binary_search([ninf, nz], 1.0), (2, false)
  assert_eq binary_search([ninf, nz], 2.5), (2, false)
  assert_eq binary_search([ninf, nz], inf), (2, false)
  assert_eq binary_search([-2.5, 0.0, nz, inf], nan), (0, false)
  assert_eq binary_search([-2.5, 0.0, nz, inf], ninf), (0, false)
  assert_eq binary_search([-2.5, 0.0, nz, inf], -2.5), (0, true)
  assert_eq binary_search([-2.5, 0.0, nz, inf], -1.0), (1, false)
  assert_eq binary_search([-2.5, 0.0, nz, inf], nz), (1, true)
}

test "vectors: binary_search 9" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq binary_search([-2.5, 0.0, nz, inf], 0.0), (1, true)
  assert_eq binary_search([-2.5, 0.0, nz, inf], 1.0), (3, false)
  assert_eq binary_search([-2.5, 0.0, nz, inf], 2.5), (3, false)
  assert_eq binary_search([-2.5, 0.0, nz, inf], inf), (3, true)
  assert_eq binary_search([-2.5, 1.0, 2.5], nan), (0, false)
  assert_eq binary_search([-2.5, 1.0, 2.5], ninf), (0, false)
  assert_eq binary_search([-2.5, 1.0, 2.5], -2.5), (0, true)
  assert_eq binary_search([-2.5, 1.0, 2.5], -1.0), (1, false)
  assert_eq binary_search([-2.5, 1.0, 2.5], nz), (1, false)
  assert_eq binary_search([-2.5, 1.0, 2.5], 0.0), (1, false)
  assert_eq binary_search([-2.5, 1.0, 2.5], 1.0), (1, true)
  assert_eq binary_search([-2.5, 1.0, 2.5], 2.5), (2, true)
  assert_eq binary_search([-2.5, 1.0, 2.5], inf), (3, false)
  assert_eq binary_search([ninf, 1.0, inf], nan), (0, false)
  assert_eq binary_search([ninf, 1.0, inf], ninf), (0, true)
  assert_eq binary_search([ninf, 1.0, inf], -2.5), (1, false)
  assert_eq binary_search([ninf, 1.0, inf], -1.0), (1, false)
  assert_eq binary_search([ninf, 1.0, inf], nz), (1, false)
  assert_eq binary_search([ninf, 1.0, inf], 0.0), (1, false)
  assert_eq binary_search([ninf, 1.0, inf], 1.0), (1, true)
  assert_eq binary_search([ninf, 1.0, inf], 2.5), (2, false)
  assert_eq binary_search([ninf, 1.0, inf], inf), (2, true)
  assert_eq binary_search([1.0, 2.5], nan), (0, false)
  assert_eq binary_search([1.0, 2.5], ninf), (0, false)
  assert_eq binary_search([1.0, 2.5], -2.5), (0, false)
  assert_eq binary_search([1.0, 2.5], -1.0), (0, false)
  assert_eq binary_search([1.0, 2.5], nz), (0, false)
  assert_eq binary_search([1.0, 2.5], 0.0), (0, false)
  assert_eq binary_search([1.0, 2.5], 1.0), (0, true)
  assert_eq binary_search([1.0, 2.5], 2.5), (1, true)
  assert_eq binary_search([1.0, 2.5], inf), (2, false)
  assert_eq binary_search([nan, -2.5, -1.0, nz, 2.5, 2.5], nan), (0, true)
  assert_eq binary_search([nan, -2.5, -1.0, nz, 2.5, 2.5], ninf), (1, false)
  assert_eq binary_search([nan, -2.5, -1.0, nz, 2.5, 2.5], -2.5), (1, true)
  assert_eq binary_search([nan, -2.5, -1.0, nz, 2.5, 2.5], -1.0), (2, true)
  assert_eq binary_search([nan, -2.5, -1.0, nz, 2.5, 2.5], nz), (3, true)
  assert_eq binary_search([nan, -2.5, -1.0, nz, 2.5, 2.5], 0.0), (3, true)
  assert_eq binary_search([nan, -2.5, -1.0, nz, 2.5, 2.5], 1.0), (4, false)
  assert_eq binary_search([nan, -2.5, -1.0, nz, 2.5, 2.5], 2.5), (4, true)
  assert_eq binary_search([nan, -2.5, -1.0, nz, 2.5, 2.5], inf), (6, false)
  assert_eq binary_search([-1.0, 0.0, 1.0], nan), (0, false)
  assert_eq binary_search([-1.0, 0.0, 1.0], ninf), (0, false)
  assert_eq binary_search([-1.0, 0.0, 1.0], -2.5), (0, false)
  assert_eq binary_search([-1.0, 0.0, 1.0], -1.0), (0, true)
  assert_eq binary_search([-1.0, 0.0, 1.0], nz), (1, true)
  assert_eq binary_search([-1.0, 0.0, 1.0], 0.0), (1, true)
  assert_eq binary_search([-1.0, 0.0, 1.0], 1.0), (2, true)
  assert_eq binary_search([-1.0, 0.0, 1.0], 2.5), (3, false)
  assert_eq binary_search([-1.0, 0.0, 1.0], inf), (3, false)
  assert_eq binary_search([-1.0, 2.5, inf], nan), (0, false)
  assert_eq binary_search([-1.0, 2.5, inf], ninf), (0, false)
  assert_eq binary_search([-1.0, 2.5, inf], -2.5), (0, false)
  assert_eq binary_search([-1.0, 2.5, inf], -1.0), (0, true)
  assert_eq binary_search([-1.0, 2.5, inf], nz), (1, false)
  assert_eq binary_search([-1.0, 2.5, inf], 0.0), (1, false)
  assert_eq binary_search([-1.0, 2.5, inf], 1.0), (1, false)
  assert_eq binary_search([-1.0, 2.5, inf], 2.5), (1, true)
  assert_eq binary_search([-1.0, 2.5, inf], inf), (2, true)
  assert_eq binary_search(vec_floats(), nan), (0, false)
  assert_eq binary_search(vec_floats(), ninf), (0, false)
  assert_eq binary_search(vec_floats(), -2.5), (0, false)
  assert_eq binary_search(vec_floats(), -1.0), (0, false)
  assert_eq binary_search(vec_floats(), nz), (0, false)
  assert_eq binary_search(vec_floats(), 0.0), (0, false)
  assert_eq binary_search(vec_floats(), 1.0), (0, false)
  assert_eq binary_search(vec_floats(), 2.5), (0, false)
  assert_eq binary_search(vec_floats(), inf), (0, false)
  assert_eq binary_search([ninf, inf], nan), (0, false)
  assert_eq binary_search([ninf, inf], ninf), (0, true)
  assert_eq binary_search([ninf, inf], -2.5), (1, false)
  assert_eq binary_search([ninf, inf], -1.0), (1, false)
  assert_eq binary_search([ninf, inf], nz), (1, false)
  assert_eq binary_search([ninf, inf], 0.0), (1, false)
  assert_eq binary_search([ninf, inf], 1.0), (1, false)
  assert_eq binary_search([ninf, inf], 2.5), (1, false)
  assert_eq binary_search([ninf, inf], inf), (1, true)
  assert_eq binary_search([0.0, nz, 2.5, 2.5], nan), (0, false)
  assert_eq binary_search([0.0, nz, 2.5, 2.5], ninf), (0, false)
  assert_eq binary_search([0.0, nz, 2.5, 2.5], -2.5), (0, false)
  assert_eq binary_search([0.0, nz, 2.5, 2.5], -1.0), (0, false)
  assert_eq binary_search([0.0, nz, 2.5, 2.5], nz), (0, true)
  assert_eq binary_search([0.0, nz, 2.5, 2.5], 0.0), (0, true)
  assert_eq binary_search([0.0, nz, 2.5, 2.5], 1.0), (2, false)
  assert_eq binary_search([0.0, nz, 2.5, 2.5], 2.5), (2, true)
  assert_eq binary_search([0.0, nz, 2.5, 2.5], inf), (4, false)
  assert_eq binary_search([nan, ninf, -1.0, nz, 0.0, nz, 1.0], nan), (0, true)
  assert_eq binary_search([nan, ninf, -1.0, nz, 0.0, nz, 1.0], ninf), (1, true)
  assert_eq binary_search([nan, ninf, -1.0, nz, 0.0, nz, 1.0], -2.5), (2, false)
  assert_eq binary_search([nan, ninf, -1.0, nz, 0.0, nz, 1.0], -1.0), (2, true)
  assert_eq binary_search([nan, ninf, -1.0, nz, 0.0, nz, 1.0], nz), (3, true)
  assert_eq binary_search([nan, ninf, -1.0, nz, 0.0, nz, 1.0], 0.0), (3, true)
  assert_eq binary_search([nan, ninf, -1.0, nz, 0.0, nz, 1.0], 1.0), (6, true)
  assert_eq binary_search([nan, ninf, -1.0, nz, 0.0, nz, 1.0], 2.5), (7, false)
  assert_eq binary_search([nan, ninf, -1.0, nz, 0.0, nz, 1.0], inf), (7, false)
  assert_eq binary_search([2.5], nan), (0, false)
  assert_eq binary_search([2.5], ninf), (0, false)
  assert_eq binary_search([2.5], -2.5), (0, false)
  assert_eq binary_search([2.5], -1.0), (0, false)
  assert_eq binary_search([2.5], nz), (0, false)
  assert_eq binary_search([2.5], 0.0), (0, false)
}

