  assert_eq delete_func([3, 3, 3, 3, 0]) { it % 2 == 1 }, [0]
  assert_eq compact([2, 1, 2, 0, 1, 2]), [2, 1, 2, 0, 1, 2]
  assert_eq compact_func([2, 1, 2, 0, 1, 2]) { |a, b| a == b + 1 }, [2, 1, 0]
}

test "vectors: compact 3" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq delete_func([2, 1, 2, 0, 1, 2]) { it % 2 == 1 }, [2, 2, 0, 2]
  assert_eq compact([1, 2, 3, 0, 2, 3, 1, 0]), [1, 2, 3, 0, 2, 3, 1, 0]
