  assert_eq vec_stable_key([0, 3001, 3002, 2003, 4, 3005, 4006, 4007, 8, 2009, 2010, 1011, 1012, 1013, 3014, 3015, 3016, 3017, 1018, 1019]), [0, 4, 8, 1011, 1012, 1013, 1018, 1019, 2003, 2009, 2010, 3001, 3002, 3005, 3014, 3015, 3016, 3017, 4006, 4007]
