  assert_eq binary_search([0, 2, 3, 4, 6, 7, 7, 7, 9], 2), (1, true)
  assert_eq binary_search_func([0, 2, 3, 4, 6, 7, 7, 7, 9], 2) { |a, b| a - b }, (1, true)
