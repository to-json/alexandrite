test "vectors: sort strings 1" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq vec_sort(vec_strs()), vec_strs()
  assert_eq vec_sort(["aB"]), ["aB"]
  assert_eq vec_sort(["aB", "😀"]), ["aB", "😀"]
  assert_eq vec_sort(["~", "ss", "ab"]), ["ab", "ss", "~"]
  assert_eq vec_sort(["😀", "b", "A", "ab"]), ["A", "ab", "b", "😀"]
  assert_eq vec_sort(["ss", "日本", "日", "aB", "z"]), ["aB", "ss", "z", "日", "日本"]
  assert_eq vec_sort(["b", "ab", "\t", "ab", "aB", ""]), ["", "\t", "aB", "ab", "ab", "b"]
  assert_eq vec_sort(["Z", "b", "ab", "aB", "é", "ÿ", "~"]), ["Z", "aB", "ab", "b", "~", "é", "ÿ"]
  assert_eq vec_sort(["😀", "\t", "a", "A", "z", "ß", "A", "日本"]), ["\t", "A", "A", "a", "z", "ß", "日本", "😀"]
  assert_eq vec_sort(["z", "Z", "~", "ﬀ", "é", "a\x00", "😀", "ﬀ", ""]), ["", "Z", "a\x00", "z", "~", "é", "ﬀ", "ﬀ", "😀"]
  assert_eq vec_sort(["a", "b", "ﬀ", "日", "A", "ab", "z", "😀", "😀", "Z"]), ["A", "Z", "a", "ab", "b", "z", "日", "ﬀ", "😀", "😀"]
  assert_eq vec_sort(["ﬀ", "", "ﬀ", "", "😀", "z", "\t", "日本", "ß", "ﬀ", "é"]), ["", "", "\t", "é", "z", "ß", "日本", "ﬀ", "ﬀ", "ﬀ", "😀"]
  assert_eq vec_sort(["é", "é", "", "ﬀ", "z", "\t", "ÿ", "a\x00", "b", "\t", "😀", "ab"]), ["", "\t", "\t", "a\x00", "ab", "b", "é", "z", "é", "ÿ", "ﬀ", "😀"]
  assert_eq vec_sort(["ﬀ", "é", "a\x00", "ss", "é", "aB", "é", "Z", "ß", "ß", "~", "Z", "\t"]), ["\t", "Z", "Z", "a\x00", "aB", "é", "ss", "~", "ß", "ß", "é", "é", "ﬀ"]
  assert_eq vec_sort(["", "日", "日", "ss", "ss", "ÿ", "😀", "\t", "z", "é", "b", "a", "日", "ab"]), ["", "\t", "a", "ab", "b", "é", "ss", "ss", "z", "ÿ", "日", "日", "日", "😀"]
  assert_eq vec_sort(["ß", "aB", "a\x00", "ÿ", "ß", "\t", "ab", "Z", "A", "😀", "ab", "aB", "ss", "ab", "a"]), ["\t", "A", "Z", "a", "a\x00", "aB", "aB", "ab", "ab", "ab", "ss", "ß", "ß", "ÿ", "😀"]
  assert_eq vec_sort(["ﬀ", "z", "aB", "", "~", "z", "😀", "ÿ", "a", "é", "b", "ss", "z", "日本", "ﬀ", "A"]), ["", "A", "a", "aB", "b", "ss", "z", "z", "z", "~", "é", "ÿ", "日本", "ﬀ", "ﬀ", "😀"]
  assert_eq vec_sort(["~", "", "a\x00", "A", "ß", "ab", "\t", "日本", "ﬀ", "ÿ", "日本", "a\x00", "~", "ﬀ", "ß", "z", "é"]), ["", "\t", "A", "a\x00", "a\x00", "ab", "z", "~", "~", "ß", "ß", "é", "ÿ", "日本", "日本", "ﬀ", "ﬀ"]
  assert_eq vec_sort(["aB", "é", "A", "", "", "A", "ﬀ", "ÿ", "ﬀ", "ab", "ab", "😀", "é", "ﬀ", "😀", "z", "ÿ", "ﬀ"]), ["", "", "A", "A", "aB", "ab", "ab", "é", "é", "z", "ÿ", "ÿ", "ﬀ", "ﬀ", "ﬀ", "ﬀ", "😀", "😀"]
  assert_eq vec_sort(["é", "ß", "~", "ß", "a", "😀", "日", "\t", "A", "a\x00", "ﬀ", "b", "ÿ", "Z", "ß", "", "a", "~", ""]), ["", "", "\t", "A", "Z", "a", "a", "a\x00", "b", "~", "~", "ß", "ß", "ß", "é", "ÿ", "日", "ﬀ", "😀"]
  assert_eq vec_sort(["é", "ﬀ", "a", "aB", "日", "b", "ß", "日本", "日本", "a", "z", "\t", "ﬀ", "Z", "~", "ﬀ", "a", "😀", "ß", "aB"]), ["\t", "Z", "a", "a", "a", "aB", "aB", "b", "z", "~", "ß", "ß", "é", "日", "日本", "日本", "ﬀ", "ﬀ", "ﬀ", "😀"]
  assert_eq vec_sort(["", "aB", "a", "b", "ÿ", "ÿ", "é", "a\x00", "a\x00", "ﬀ", "日本", "a", "", "é", "\t", "z", "日本", "日本", "😀", "A", "ﬀ"]), ["", "", "\t", "A", "a", "a", "a\x00", "a\x00", "aB", "b", "é", "z", "é", "ÿ", "ÿ", "日本", "日本", "日本", "ﬀ", "ﬀ", "😀"]
  assert_eq vec_sort(["Z", "ab", "ÿ", "😀", "日", "A", "日本", "a\x00", "~", "é", "ﬀ", "A", "a\x00", "A", "", "a\x00", "z", "A", "ﬀ", "aB", "Z", "é"]), ["", "A", "A", "A", "A", "Z", "Z", "a\x00", "a\x00", "a\x00", "aB", "ab", "é", "é", "z", "~", "ÿ", "日", "日本", "ﬀ", "ﬀ", "😀"]
  assert_eq vec_sort(["z", "ﬀ", "Z", "", "A", "日本", "Z", "b", "日本", "~", "z", "", "ß", "a", "A", "Z", "ÿ", "~", "é", "😀", "~", "日本", "a"]), ["", "", "A", "A", "Z", "Z", "Z", "a", "a", "b", "z", "z", "~", "~", "~", "ß", "é", "ÿ", "日本", "日本", "日本", "ﬀ", "😀"]
  assert_eq vec_sort(["ﬀ", "😀", "a", "ÿ", "Z", "ß", "ÿ", "😀", "a", "ab", "日本", "😀", "a\x00", "é", "ﬀ", "z", "Z", "é", "ss", "é", "😀", "~", "ß", "日本"]), ["Z", "Z", "a", "a", "a\x00", "ab", "é", "é", "ss", "z", "~", "ß", "ß", "é", "ÿ", "ÿ", "日本", "日本", "ﬀ", "ﬀ", "😀", "😀", "😀", "😀"]
  assert_eq vec_sort(["~", "ﬀ", "ß", "aB", "", "日", "a\x00", "a", "日", "ÿ", "ﬀ", "ss", "é", "\t", "Z", "", "ß", "\t", "é", "z", "Z", "a\x00", "A", "😀", "ab"]), ["", "", "\t", "\t", "A", "Z", "Z", "a", "a\x00", "a\x00", "aB", "ab", "ss", "z", "~", "ß", "ß", "é", "é", "ÿ", "日", "日", "ﬀ", "ﬀ", "😀"]
  assert_eq vec_sort(["A", "ss", "日本", "z", "日本", "ﬀ", "ss", "ab", "日本", "~", "~", "Z", "日本", "日", "é", "é", "ß", "ab", "日本", "Z", "ab", "日本", "ss", "", "z", "ss"]), ["", "A", "Z", "Z", "ab", "ab", "ab", "é", "ss", "ss", "ss", "ss", "z", "z", "~", "~", "ß", "é", "日", "日本", "日本", "日本", "日本", "日本", "日本", "ﬀ"]
  assert_eq vec_sort(["aB", "ab", "z", "", "b", "", "😀", "ÿ", "ÿ", "é", "a\x00", "z", "a", "ab", "z", "", "😀", "A", "日", "😀", "ab", "~", "aB", "😀", "é", "é", "aB"]), ["", "", "", "A", "a", "a\x00", "aB", "aB", "aB", "ab", "ab", "ab", "b", "é", "é", "z", "z", "z", "~", "é", "ÿ", "ÿ", "日", "😀", "😀", "😀", "😀"]
  assert_eq vec_sort(["😀", "😀", "ss", "", "a\x00", "ﬀ", "ß", "日", "日本", "b", "ab", "é", "日", "日本", "日本", "Z", "", "ss", "~", "ß", "ß", "ÿ", "Z", "é", "ÿ", "日本", "a\x00", "é"]), ["", "", "Z", "Z", "a\x00", "a\x00", "ab", "b", "é", "ss", "ss", "~", "ß", "ß", "ß", "é", "é", "ÿ", "ÿ", "日", "日", "日本", "日本", "日本", "日本", "ﬀ", "😀", "😀"]
  assert_eq vec_sort(["Z", "Z", "😀", "\t", "ss", "😀", "", "é", "A", "ab", "z", "ab", "aB", "日", "z", "é", "b", "ß", "é", "é", "ss", "Z", "a\x00", "é", "ﬀ", "é", "ss", "z", "日本"]), ["", "\t", "A", "Z", "Z", "Z", "a\x00", "aB", "ab", "ab", "b", "é", "é", "ss", "ss", "ss", "z", "z", "z", "ß", "é", "é", "é", "é", "日", "日本", "ﬀ", "😀", "😀"]
  assert_eq vec_sort(["aB", "ÿ", "ss", "ß", "日", "A", "a", "😀", "ÿ", "é", "ß", "ÿ", "aB", "b", "日本", "a\x00", "ß", "ab", "Z", "z", "z", "~", "\t", "ß", "ss", "aB", "a", "b", "A", "Z"]), ["\t", "A", "A", "Z", "Z", "a", "a", "a\x00", "aB", "aB", "aB", "ab", "b", "b", "é", "ss", "ss", "z", "z", "~", "ß", "ß", "ß", "ß", "ÿ", "ÿ", "ÿ", "日", "日本", "😀"]
  assert_eq vec_sort(["Z", "a\x00", "日本", "", "aB", "ÿ", "a", "ss", "~", "ß", "~", "😀", "ﬀ", "Z", "z", "\t", "ÿ", "ﬀ", "a", "ss", "", "😀", "a\x00", "Z", "é", "aB", "a\x00", "~", "~", "Z", "ss"]), ["", "", "\t", "Z", "Z", "Z", "Z", "a", "a", "a\x00", "a\x00", "a\x00", "aB", "aB", "ss", "ss", "ss", "z", "~", "~", "~", "~", "ß", "é", "ÿ", "ÿ", "日本", "ﬀ", "ﬀ", "😀", "😀"]
  assert_eq vec_sort(["a", "日本", "é", "é", "~", "ab", "A", "ss", "\t", "ab", "é", "a\x00", "~", "a", "ss", "日", "ss", "A", "", "é", "é", "~", "ss", "~", "日本", "ß", "ÿ", "\t", "ﬀ", "é", "a", ""]), ["", "", "\t", "\t", "A", "A", "a", "a", "a", "a\x00", "ab", "ab", "é", "é", "ss", "ss", "ss", "ss", "~", "~", "~", "~", "ß", "é", "é", "é", "é", "ÿ", "日", "日本", "日本", "ﬀ"]
  assert_eq vec_sort(["\t", "~", "b", "aB", "\t", "日", "", "ss", "ÿ", "~", "é", "😀", "ﬀ", "ss", "😀", "日本", "ss", "aB", "😀", "日本", "b", "", "b", "日", "ss", "z", "ÿ", "~", "ÿ", "b", "ÿ", "ÿ", "é"]), ["", "", "\t", "\t", "aB", "aB", "b", "b", "b", "b", "é", "ss", "ss", "ss", "ss", "z", "~", "~", "~", "é", "ÿ", "ÿ", "ÿ", "ÿ", "ÿ", "日", "日", "日本", "日本", "ﬀ", "😀", "😀", "😀"]
  assert_eq vec_sort(["a", "", "aB", "ab", "a", "ß", "a\x00", "ss", "b", "~", "é", "ab", "aB", "ß", "Z", "é", "~", "é", "A", "b", "", "ÿ", "~", "A", "é", "ß", "a\x00", "Z", "ab", "ÿ", "ß", "日", "ab", "a\x00"]), ["", "", "A", "A", "Z", "Z", "a", "a", "a\x00", "a\x00", "a\x00", "aB", "aB", "ab", "ab", "ab", "ab", "b", "b", "é", "é", "é", "ss", "~", "~", "~", "ß", "ß", "ß", "ß", "é", "ÿ", "ÿ", "日"]
  assert_eq vec_sort(["~", "\t", "", "ab", "z", "a\x00", "a\x00", "ab", "a", "Z", "ﬀ", "~", "z", "z", "aB", "aB", "日本", "😀", "ÿ", "\t", "ss", "aB", "z", "😀", "ß", "\t", "b", "日", "a\x00", "z", "ss", "日", "a", "ÿ", "ß"]), ["", "\t", "\t", "\t", "Z", "a", "a", "a\x00", "a\x00", "a\x00", "aB", "aB", "aB", "ab", "ab", "b", "ss", "ss", "z", "z", "z", "z", "z", "~", "~", "ß", "ß", "ÿ", "ÿ", "日", "日", "日本", "ﬀ", "😀", "😀"]
  assert_eq vec_sort(["\t", "é", "日", "ß", "😀", "~", "~", "aB", "é", "b", "a", "ß", "日", "ab", "ß", "b", "~", "ss", "A", "😀", "aB", "ab", "Z", "aB", "z", "ab", "a", "", "A", "z", "~", "日", "é", "a", "", "日本"]), ["", "", "\t", "A", "A", "Z", "a", "a", "a", "aB", "aB", "aB", "ab", "ab", "ab", "b", "b", "é", "ss", "z", "z", "~", "~", "~", "~", "ß", "ß", "ß", "é", "é", "日", "日", "日", "日本", "😀", "😀"]
  assert_eq vec_sort(["b", "z", "é", "~", "é", "日本", "日", "z", "é", "ÿ", "日本", "ﬀ", "A", "~", "日本", "~", "😀", "A", "a\x00", "😀", "z", "ß", "a\x00", "z", "", "ÿ", "\t", "A", "aB", "Z", "ÿ", "A", "", "ﬀ", "ab", "b", "b"]), ["", "", "\t", "A", "A", "A", "A", "Z", "a\x00", "a\x00", "aB", "ab", "b", "b", "b", "é", "z", "z", "z", "z", "~", "~", "~", "ß", "é", "é", "ÿ", "ÿ", "ÿ", "日", "日本", "日本", "日本", "ﬀ", "ﬀ", "😀", "😀"]
