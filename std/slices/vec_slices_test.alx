  assert_eq binary_search_func([0, 4, 4, 4, 8, 8, 9], 8) { |a, b| a - b }, (4, true)
  assert_eq binary_search([0, 4, 4, 4, 8, 8, 9], 10), (7, false)
  assert_eq binary_search_func([0, 4, 4, 4, 8, 8, 9], 10) { |a, b| a - b }, (7, false)
  assert_eq binary_search([0, 1, 1, 3, 5, 5, 6, 8, 8, 9], -1), (0, false)
  assert_eq binary_search_func([0, 1, 1, 3, 5, 5, 6, 8, 8, 9], -1) { |a, b| a - b }, (0, false)
