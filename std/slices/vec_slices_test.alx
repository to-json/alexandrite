  assert_eq delete_func(vec_ints()) { it % 2 == 1 }, vec_ints()
  assert_eq compact([1, 2, 3, 0]), [1, 2, 3, 0]
  assert_eq compact_func([1, 2, 3, 0]) { |a, b| a == b + 1 }, [1, 0]
  assert_eq delete_func([1, 2, 3, 0]) { it % 2 == 1 }, [2, 0]
  assert_eq compact([3, 2]), [3, 2]
