  assert_eq compare_func([2], [2]) { |a, b| (a - b) * 7 }, 0
  assert_eq equal([2], [2]), true
  assert_eq is_sorted([2]), true
  assert_eq vec_reverse([2]), [2]
  assert_eq index(vec_ints(), 4), -1
  assert_eq contains(vec_ints(), 4), false
  assert_eq compare(vec_ints(), [2, 2, 3]), -1
  assert_eq compare_func(vec_ints(), [2, 2, 3]) { |a, b| (a - b) * 7 }, -1
  assert_eq equal(vec_ints(), [2, 2, 3]), false
  assert_eq is_sorted(vec_ints()), true
  assert_eq vec_reverse(vec_ints()), vec_ints()
  assert_eq index([1, 1], 2), -1
  assert_eq contains([1, 1], 2), false
  assert_eq compare([1, 1], [0]), 1
  assert_eq compare_func([1, 1], [0]) { |a, b| (a - b) * 7 }, 7
  assert_eq equal([1, 1], [0]), false
  assert_eq is_sorted([1, 1]), true
  assert_eq vec_reverse([1, 1]), [1, 1]
  assert_eq index([1, 1, 3], 1), 0
  assert_eq contains([1, 1, 3], 1), true
  assert_eq compare([1, 1, 3], [1, 2, 2, 1, 2]), -1
  assert_eq compare_func([1, 1, 3], [1, 2, 2, 1, 2]) { |a, b| (a - b) * 7 }, -7
  assert_eq equal([1, 1, 3], [1, 2, 2, 1, 2]), false
  assert_eq is_sorted([1, 1, 3]), true
  assert_eq vec_reverse([1, 1, 3]), [3, 1, 1]
  assert_eq index([3], 3), 0
  assert_eq contains([3], 3), true
  assert_eq compare([3], vec_ints()), 1
  assert_eq compare_func([3], vec_ints()) { |a, b| (a - b) * 7 }, 1
  assert_eq equal([3], vec_ints()), false
  assert_eq is_sorted([3]), true
  assert_eq vec_reverse([3]), [3]
  assert_eq index(vec_ints(), 4), -1
  assert_eq contains(vec_ints(), 4), false
  assert_eq compare(vec_ints(), [1, 0, 0, 2]), -1
  assert_eq compare_func(vec_ints(), [1, 0, 0, 2]) { |a, b| (a - b) * 7 }, -1
  assert_eq equal(vec_ints(), [1, 0, 0, 2]), false
  assert_eq is_sorted(vec_ints()), true
  assert_eq vec_reverse(vec_ints()), vec_ints()
  assert_eq index([3, 0, 2, 0, 1], 0), 1
  assert_eq contains([3, 0, 2, 0, 1], 0), true
  assert_eq compare([3, 0, 2, 0, 1], [0, 0, 2, 1]), 1
  assert_eq compare_func([3, 0, 2, 0, 1], [0, 0, 2, 1]) { |a, b| (a - b) * 7 }, 21
  assert_eq equal([3, 0, 2, 0, 1], [0, 0, 2, 1]), false
  assert_eq is_sorted([3, 0, 2, 0, 1]), false
  assert_eq vec_reverse([3, 0, 2, 0, 1]), [1, 0, 2, 0, 3]
  assert_eq index([0, 0, 3, 2, 3], 2), 3
  assert_eq contains([0, 0, 3, 2, 3], 2), true
  assert_eq compare([0, 0, 3, 2, 3], [2]), -1
  assert_eq compare_func([0, 0, 3, 2, 3], [2]) { |a, b| (a - b) * 7 }, -14
  assert_eq equal([0, 0, 3, 2, 3], [2]), false
  assert_eq is_sorted([0, 0, 3, 2, 3]), false
  assert_eq vec_reverse([0, 0, 3, 2, 3]), [3, 2, 3, 0, 0]
  assert_eq index([3, 0, 1, 3], 4), -1
  assert_eq contains([3, 0, 1, 3], 4), false
  assert_eq compare([3, 0, 1, 3], vec_ints()), 1
  assert_eq compare_func([3, 0, 1, 3], vec_ints()) { |a, b| (a - b) * 7 }, 1
  assert_eq equal([3, 0, 1, 3], vec_ints()), false
  assert_eq is_sorted([3, 0, 1, 3]), false
  assert_eq vec_reverse([3, 0, 1, 3]), [3, 1, 0, 3]
  assert_eq index([0], 4), -1
  assert_eq contains([0], 4), false
  assert_eq compare([0], [0]), 0
  assert_eq compare_func([0], [0]) { |a, b| (a - b) * 7 }, 0
  assert_eq equal([0], [0]), true
  assert_eq is_sorted([0]), true
  assert_eq vec_reverse([0]), [0]
  assert_eq index([1, 1, 1, 3], 0), -1
  assert_eq contains([1, 1, 1, 3], 0), false
  assert_eq compare([1, 1, 1, 3], [0]), 1
  assert_eq compare_func([1, 1, 1, 3], [0]) { |a, b| (a - b) * 7 }, 7
  assert_eq equal([1, 1, 1, 3], [0]), false
  assert_eq is_sorted([1, 1, 1, 3]), true
  assert_eq vec_reverse([1, 1, 1, 3]), [3, 1, 1, 1]
  assert_eq index([3, 0, 0, 1, 0], 1), 3
  assert_eq contains([3, 0, 0, 1, 0], 1), true
  assert_eq compare([3, 0, 0, 1, 0], vec_ints()), 1
  assert_eq compare_func([3, 0, 0, 1, 0], vec_ints()) { |a, b| (a - b) * 7 }, 1
  assert_eq equal([3, 0, 0, 1, 0], vec_ints()), false
  assert_eq is_sorted([3, 0, 0, 1, 0]), false
  assert_eq vec_reverse([3, 0, 0, 1, 0]), [0, 1, 0, 0, 3]
  assert_eq index([0, 3, 1, 0], 2), -1
  assert_eq contains([0, 3, 1, 0], 2), false
  assert_eq compare([0, 3, 1, 0], [0, 3, 1, 0]), 0
}

test "vectors: index compare equal 6" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq compare_func([0, 3, 1, 0], [0, 3, 1, 0]) { |a, b| (a - b) * 7 }, 0
  assert_eq equal([0, 3, 1, 0], [0, 3, 1, 0]), true
  assert_eq is_sorted([0, 3, 1, 0]), false
  assert_eq vec_reverse([0, 3, 1, 0]), [0, 1, 3, 0]
  assert_eq index([3, 3], 4), -1
  assert_eq contains([3, 3], 4), false
  assert_eq compare([3, 3], [2, 1, 3, 3, 0]), 1
  assert_eq compare_func([3, 3], [2, 1, 3, 3, 0]) { |a, b| (a - b) * 7 }, 7
  assert_eq equal([3, 3], [2, 1, 3, 3, 0]), false
  assert_eq is_sorted([3, 3]), true
  assert_eq vec_reverse([3, 3]), [3, 3]
  assert_eq index([1], 4), -1
  assert_eq contains([1], 4), false
  assert_eq compare([1], [3, 0, 2]), -1
  assert_eq compare_func([1], [3, 0, 2]) { |a, b| (a - b) * 7 }, -14
  assert_eq equal([1], [3, 0, 2]), false
  assert_eq is_sorted([1]), true
  assert_eq vec_reverse([1]), [1]
  assert_eq index(vec_ints(), 1), -1
  assert_eq contains(vec_ints(), 1), false
  assert_eq compare(vec_ints(), [2, 3, 0, 3]), -1
  assert_eq compare_func(vec_ints(), [2, 3, 0, 3]) { |a, b| (a - b) * 7 }, -1
  assert_eq equal(vec_ints(), [2, 3, 0, 3]), false
  assert_eq is_sorted(vec_ints()), true
  assert_eq vec_reverse(vec_ints()), vec_ints()
  assert_eq index([3, 3, 2, 1], 4), -1
  assert_eq contains([3, 3, 2, 1], 4), false
  assert_eq compare([3, 3, 2, 1], [0, 1, 3]), 1
  assert_eq compare_func([3, 3, 2, 1], [0, 1, 3]) { |a, b| (a - b) * 7 }, 21
  assert_eq equal([3, 3, 2, 1], [0, 1, 3]), false
  assert_eq is_sorted([3, 3, 2, 1]), false
  assert_eq vec_reverse([3, 3, 2, 1]), [1, 2, 3, 3]
  assert_eq index([2, 3], 0), -1
  assert_eq contains([2, 3], 0), false
  assert_eq compare([2, 3], [3, 3]), -1
  assert_eq compare_func([2, 3], [3, 3]) { |a, b| (a - b) * 7 }, -7
  assert_eq equal([2, 3], [3, 3]), false
  assert_eq is_sorted([2, 3]), true
  assert_eq vec_reverse([2, 3]), [3, 2]
  assert_eq index([2], 0), -1
  assert_eq contains([2], 0), false
  assert_eq compare([2], vec_ints()), 1
  assert_eq compare_func([2], vec_ints()) { |a, b| (a - b) * 7 }, 1
  assert_eq equal([2], vec_ints()), false
  assert_eq is_sorted([2]), true
  assert_eq vec_reverse([2]), [2]
  assert_eq index([2, 0], 4), -1
  assert_eq contains([2, 0], 4), false
  assert_eq compare([2, 0], vec_ints()), 1
  assert_eq compare_func([2, 0], vec_ints()) { |a, b| (a - b) * 7 }, 1
  assert_eq equal([2, 0], vec_ints()), false
  assert_eq is_sorted([2, 0]), false
  assert_eq vec_reverse([2, 0]), [0, 2]
  assert_eq index([3, 2], 0), -1
  assert_eq contains([3, 2], 0), false
  assert_eq compare([3, 2], vec_ints()), 1
  assert_eq compare_func([3, 2], vec_ints()) { |a, b| (a - b) * 7 }, 1
  assert_eq equal([3, 2], vec_ints()), false
  assert_eq is_sorted([3, 2]), false
  assert_eq vec_reverse([3, 2]), [2, 3]
  assert_eq index([0, 2], 1), -1
  assert_eq contains([0, 2], 1), false
  assert_eq compare([0, 2], [2, 0, 1]), -1
  assert_eq compare_func([0, 2], [2, 0, 1]) { |a, b| (a - b) * 7 }, -14
  assert_eq equal([0, 2], [2, 0, 1]), false
  assert_eq is_sorted([0, 2]), true
  assert_eq vec_reverse([0, 2]), [2, 0]
  assert_eq index([0], 2), -1
  assert_eq contains([0], 2), false
  assert_eq compare([0], [1]), -1
  assert_eq compare_func([0], [1]) { |a, b| (a - b) * 7 }, -7
  assert_eq equal([0], [1]), false
  assert_eq is_sorted([0]), true
  assert_eq vec_reverse([0]), [0]
  assert_eq index([1, 2], 4), -1
  assert_eq contains([1, 2], 4), false
  assert_eq compare([1, 2], [1, 2]), 0
  assert_eq compare_func([1, 2], [1, 2]) { |a, b| (a - b) * 7 }, 0
  assert_eq equal([1, 2], [1, 2]), true
  assert_eq is_sorted([1, 2]), true
  assert_eq vec_reverse([1, 2]), [2, 1]
  assert_eq index([3, 2, 0], 1), -1
  assert_eq contains([3, 2, 0], 1), false
  assert_eq compare([3, 2, 0], [1]), 1
  assert_eq compare_func([3, 2, 0], [1]) { |a, b| (a - b) * 7 }, 14
  assert_eq equal([3, 2, 0], [1]), false
  assert_eq is_sorted([3, 2, 0]), false
  assert_eq vec_reverse([3, 2, 0]), [0, 2, 3]
  assert_eq index([0, 1, 2, 0, 1], 1), 1
  assert_eq contains([0, 1, 2, 0, 1], 1), true
  assert_eq compare([0, 1, 2, 0, 1], [3, 3, 0]), -1
  assert_eq compare_func([0, 1, 2, 0, 1], [3, 3, 0]) { |a, b| (a - b) * 7 }, -21
  assert_eq equal([0, 1, 2, 0, 1], [3, 3, 0]), false
  assert_eq is_sorted([0, 1, 2, 0, 1]), false
  assert_eq vec_reverse([0, 1, 2, 0, 1]), [1, 0, 2, 1, 0]
  assert_eq index([0, 0, 1, 2, 2], 3), -1
  assert_eq contains([0, 0, 1, 2, 2], 3), false
  assert_eq compare([0, 0, 1, 2, 2], [0, 0, 1, 2, 2]), 0
  assert_eq compare_func([0, 0, 1, 2, 2], [0, 0, 1, 2, 2]) { |a, b| (a - b) * 7 }, 0
  assert_eq equal([0, 0, 1, 2, 2], [0, 0, 1, 2, 2]), true
}

test "vectors: index compare equal 7" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq is_sorted([0, 0, 1, 2, 2]), true
  assert_eq vec_reverse([0, 0, 1, 2, 2]), [2, 2, 1, 0, 0]
  assert_eq index([1], 1), 0
  assert_eq contains([1], 1), true
  assert_eq compare([1], [1]), 0
  assert_eq compare_func([1], [1]) { |a, b| (a - b) * 7 }, 0
  assert_eq equal([1], [1]), true
  assert_eq is_sorted([1]), true
  assert_eq vec_reverse([1]), [1]
  assert_eq index([1, 1], 4), -1
  assert_eq contains([1, 1], 4), false
  assert_eq compare([1, 1], [0, 3, 1, 3]), 1
  assert_eq compare_func([1, 1], [0, 3, 1, 3]) { |a, b| (a - b) * 7 }, 7
  assert_eq equal([1, 1], [0, 3, 1, 3]), false
  assert_eq is_sorted([1, 1]), true
  assert_eq vec_reverse([1, 1]), [1, 1]
  assert_eq index([1, 2], 1), 0
  assert_eq contains([1, 2], 1), true
  assert_eq compare([1, 2], [2, 3, 3, 3]), -1
  assert_eq compare_func([1, 2], [2, 3, 3, 3]) { |a, b| (a - b) * 7 }, -7
  assert_eq equal([1, 2], [2, 3, 3, 3]), false
  assert_eq is_sorted([1, 2]), true
  assert_eq vec_reverse([1, 2]), [2, 1]
  assert_eq index(vec_ints(), 0), -1
  assert_eq contains(vec_ints(), 0), false
  assert_eq compare(vec_ints(), [2, 0, 2, 1, 0]), -1
  assert_eq compare_func(vec_ints(), [2, 0, 2, 1, 0]) { |a, b| (a - b) * 7 }, -1
  assert_eq equal(vec_ints(), [2, 0, 2, 1, 0]), false
  assert_eq is_sorted(vec_ints()), true
  assert_eq vec_reverse(vec_ints()), vec_ints()
  assert_eq index([1, 1, 0, 0, 0], 3), -1
  assert_eq contains([1, 1, 0, 0, 0], 3), false
  assert_eq compare([1, 1, 0, 0, 0], [3]), -1
  assert_eq compare_func([1, 1, 0, 0, 0], [3]) { |a, b| (a - b) * 7 }, -14
  assert_eq equal([1, 1, 0, 0, 0], [3]), false
  assert_eq is_sorted([1, 1, 0, 0, 0]), false
  assert_eq vec_reverse([1, 1, 0, 0, 0]), [0, 0, 0, 1, 1]
  assert_eq index([0, 2, 0], 2), 1
  assert_eq contains([0, 2, 0], 2), true
  assert_eq compare([0, 2, 0], vec_ints()), 1
  assert_eq compare_func([0, 2, 0], vec_ints()) { |a, b| (a - b) * 7 }, 1
  assert_eq equal([0, 2, 0], vec_ints()), false
  assert_eq is_sorted([0, 2, 0]), false
  assert_eq vec_reverse([0, 2, 0]), [0, 2, 0]
  assert_eq index([1, 2, 2], 1), 0
  assert_eq contains([1, 2, 2], 1), true
  assert_eq compare([1, 2, 2], [0]), 1
  assert_eq compare_func([1, 2, 2], [0]) { |a, b| (a - b) * 7 }, 7
  assert_eq equal([1, 2, 2], [0]), false
  assert_eq is_sorted([1, 2, 2]), true
  assert_eq vec_reverse([1, 2, 2]), [2, 2, 1]
  assert_eq index([3, 0], 3), 0
  assert_eq contains([3, 0], 3), true
  assert_eq compare([3, 0], [3, 3]), -1
  assert_eq compare_func([3, 0], [3, 3]) { |a, b| (a - b) * 7 }, -21
  assert_eq equal([3, 0], [3, 3]), false
  assert_eq is_sorted([3, 0]), false
  assert_eq vec_reverse([3, 0]), [0, 3]
  assert_eq index(vec_ints(), 1), -1
  assert_eq contains(vec_ints(), 1), false
  assert_eq compare(vec_ints(), [0, 3, 3, 2]), -1
  assert_eq compare_func(vec_ints(), [0, 3, 3, 2]) { |a, b| (a - b) * 7 }, -1
  assert_eq equal(vec_ints(), [0, 3, 3, 2]), false
  assert_eq is_sorted(vec_ints()), true
  assert_eq vec_reverse(vec_ints()), vec_ints()
  assert_eq index([1, 1, 3, 2, 3], 2), 3
  assert_eq contains([1, 1, 3, 2, 3], 2), true
  assert_eq compare([1, 1, 3, 2, 3], [1, 1, 2, 1, 0]), 1
  assert_eq compare_func([1, 1, 3, 2, 3], [1, 1, 2, 1, 0]) { |a, b| (a - b) * 7 }, 7
  assert_eq equal([1, 1, 3, 2, 3], [1, 1, 2, 1, 0]), false
  assert_eq is_sorted([1, 1, 3, 2, 3]), false
  assert_eq vec_reverse([1, 1, 3, 2, 3]), [3, 2, 3, 1, 1]
  assert_eq index([0], 4), -1
  assert_eq contains([0], 4), false
  assert_eq compare([0], [0]), 0
  assert_eq compare_func([0], [0]) { |a, b| (a - b) * 7 }, 0
  assert_eq equal([0], [0]), true
  assert_eq is_sorted([0]), true
  assert_eq vec_reverse([0]), [0]
  assert_eq index([2, 3, 1], 2), 0
  assert_eq contains([2, 3, 1], 2), true
  assert_eq compare([2, 3, 1], [2, 3, 1]), 0
  assert_eq compare_func([2, 3, 1], [2, 3, 1]) { |a, b| (a - b) * 7 }, 0
  assert_eq equal([2, 3, 1], [2, 3, 1]), true
  assert_eq is_sorted([2, 3, 1]), false
  assert_eq vec_reverse([2, 3, 1]), [1, 3, 2]
  assert_eq index([2, 1, 2, 0], 0), 3
  assert_eq contains([2, 1, 2, 0], 0), true
  assert_eq compare([2, 1, 2, 0], [2, 1, 2, 0]), 0
  assert_eq compare_func([2, 1, 2, 0], [2, 1, 2, 0]) { |a, b| (a - b) * 7 }, 0
  assert_eq equal([2, 1, 2, 0], [2, 1, 2, 0]), true
  assert_eq is_sorted([2, 1, 2, 0]), false
  assert_eq vec_reverse([2, 1, 2, 0]), [0, 2, 1, 2]
  assert_eq index([0, 1, 3], 1), 1
  assert_eq contains([0, 1, 3], 1), true
  assert_eq compare([0, 1, 3], [0, 1, 3]), 0
  assert_eq compare_func([0, 1, 3], [0, 1, 3]) { |a, b| (a - b) * 7 }, 0
  assert_eq equal([0, 1, 3], [0, 1, 3]), true
  assert_eq is_sorted([0, 1, 3]), true
  assert_eq vec_reverse([0, 1, 3]), [3, 1, 0]
}

test "vectors: index compare equal 8" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq compare([nz, 1.0], [inf, 1.0]), -1
  assert_eq equal([nz, 1.0], [inf, 1.0]), false
  assert_eq is_sorted([nz, 1.0]), true
  assert_eq index([nz, 1.0], 1.0), 1
  assert_eq compare([nz, inf, nz], vec_floats()), 1
  assert_eq equal([nz, inf, nz], vec_floats()), false
  assert_eq is_sorted([nz, inf, nz]), false
  assert_eq index([nz, inf, nz], nan), -1
  assert_eq compare(vec_floats(), vec_floats()), 0
  assert_eq equal(vec_floats(), vec_floats()), true
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 1.0), -1
  assert_eq compare([2.5, -1.0, -1.0], [2.5, -1.0, -1.0]), 0
  assert_eq equal([2.5, -1.0, -1.0], [2.5, -1.0, -1.0]), true
  assert_eq is_sorted([2.5, -1.0, -1.0]), false
  assert_eq index([2.5, -1.0, -1.0], 2.5), 0
  assert_eq compare([ninf, 0.0, inf], [ninf, 0.0, inf]), 0
  assert_eq equal([ninf, 0.0, inf], [ninf, 0.0, inf]), true
  assert_eq is_sorted([ninf, 0.0, inf]), true
  assert_eq index([ninf, 0.0, inf], 2.5), -1
  assert_eq compare([2.5], vec_floats()), 1
  assert_eq equal([2.5], vec_floats()), false
  assert_eq is_sorted([2.5]), true
  assert_eq index([2.5], inf), -1
  assert_eq compare([nz, -1.0], [nan, 2.5]), 1
  assert_eq equal([nz, -1.0], [nan, 2.5]), false
  assert_eq is_sorted([nz, -1.0]), false
  assert_eq index([nz, -1.0], -2.5), -1
  assert_eq compare([nz], [nz]), 0
  assert_eq equal([nz], [nz]), true
  assert_eq is_sorted([nz]), true
  assert_eq index([nz], 2.5), -1
  assert_eq compare([nan, -1.0], [0.0, -1.0]), -1
  assert_eq equal([nan, -1.0], [0.0, -1.0]), false
  assert_eq is_sorted([nan, -1.0]), true
  assert_eq index([nan, -1.0], nan), -1
  assert_eq compare(vec_floats(), vec_floats()), 0
  assert_eq equal(vec_floats(), vec_floats()), true
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 0.0), -1
  assert_eq compare([nan], [nan]), 0
  assert_eq equal([nan], [nan]), false
  assert_eq is_sorted([nan]), true
  assert_eq index([nan], 2.5), -1
  assert_eq compare([-2.5, -1.0, 1.0], [-1.0]), -1
  assert_eq equal([-2.5, -1.0, 1.0], [-1.0]), false
  assert_eq is_sorted([-2.5, -1.0, 1.0]), true
  assert_eq index([-2.5, -1.0, 1.0], nan), -1
  assert_eq compare([inf], [inf]), 0
  assert_eq equal([inf], [inf]), true
  assert_eq is_sorted([inf]), true
  assert_eq index([inf], inf), 0
  assert_eq compare([-2.5, -2.5], [-2.5, -2.5]), 0
  assert_eq equal([-2.5, -2.5], [-2.5, -2.5]), true
  assert_eq is_sorted([-2.5, -2.5]), true
  assert_eq index([-2.5, -2.5], 0.0), -1
  assert_eq compare([-2.5], [-1.0, -2.5, ninf]), -1
  assert_eq equal([-2.5], [-1.0, -2.5, ninf]), false
  assert_eq is_sorted([-2.5]), true
  assert_eq index([-2.5], nan), -1
  assert_eq compare([nz, ninf], [ninf]), 1
  assert_eq equal([nz, ninf], [ninf]), false
  assert_eq is_sorted([nz, ninf]), false
  assert_eq index([nz, ninf], 1.0), -1
  assert_eq compare([ninf, nz, 2.5], [ninf, nz, 2.5]), 0
  assert_eq equal([ninf, nz, 2.5], [ninf, nz, 2.5]), true
  assert_eq is_sorted([ninf, nz, 2.5]), true
  assert_eq index([ninf, nz, 2.5], 2.5), 2
  assert_eq compare([2.5, nz, nz], [1.0, 1.0, nz]), 1
  assert_eq equal([2.5, nz, nz], [1.0, 1.0, nz]), false
  assert_eq is_sorted([2.5, nz, nz]), false
  assert_eq index([2.5, nz, nz], nz), 1
  assert_eq compare([ninf], [2.5, nan]), -1
  assert_eq equal([ninf], [2.5, nan]), false
  assert_eq is_sorted([ninf]), true
  assert_eq index([ninf], nan), -1
  assert_eq compare(vec_floats(), [-2.5]), -1
  assert_eq equal(vec_floats(), [-2.5]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), -2.5), -1
  assert_eq compare(vec_floats(), [ninf, -2.5]), -1
  assert_eq equal(vec_floats(), [ninf, -2.5]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 2.5), -1
  assert_eq compare(vec_floats(), vec_floats()), 0
  assert_eq equal(vec_floats(), vec_floats()), true
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), nan), -1
  assert_eq compare(vec_floats(), [nz, nz]), -1
  assert_eq equal(vec_floats(), [nz, nz]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 0.0), -1
  assert_eq compare(vec_floats(), [0.0, -2.5]), -1
  assert_eq equal(vec_floats(), [0.0, -2.5]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 1.0), -1
  assert_eq compare(vec_floats(), [inf]), -1
  assert_eq equal(vec_floats(), [inf]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), inf), -1
}

test "vectors: index compare equal 9" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq compare([2.5], [nz]), 1
  assert_eq equal([2.5], [nz]), false
  assert_eq is_sorted([2.5]), true
  assert_eq index([2.5], -2.5), -1
  assert_eq compare([0.0, nan], [nz, nz, ninf]), -1
  assert_eq equal([0.0, nan], [nz, nz, ninf]), false
  assert_eq is_sorted([0.0, nan]), false
  assert_eq index([0.0, nan], 2.5), -1
  assert_eq compare(vec_floats(), [-2.5, nz]), -1
  assert_eq equal(vec_floats(), [-2.5, nz]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 1.0), -1
  assert_eq compare(vec_floats(), vec_floats()), 0
  assert_eq equal(vec_floats(), vec_floats()), true
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 2.5), -1
  assert_eq compare([ninf], [nan]), 1
  assert_eq equal([ninf], [nan]), false
  assert_eq is_sorted([ninf]), true
  assert_eq index([ninf], -2.5), -1
  assert_eq compare(vec_floats(), vec_floats()), 0
  assert_eq equal(vec_floats(), vec_floats()), true
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), ninf), -1
  assert_eq compare([nz, inf], [nz, inf]), 0
  assert_eq equal([nz, inf], [nz, inf]), true
  assert_eq is_sorted([nz, inf]), true
  assert_eq index([nz, inf], -2.5), -1
  assert_eq compare([-2.5], [-2.5]), 0
  assert_eq equal([-2.5], [-2.5]), true
  assert_eq is_sorted([-2.5]), true
  assert_eq index([-2.5], ninf), -1
  assert_eq compare(vec_floats(), vec_floats()), 0
  assert_eq equal(vec_floats(), vec_floats()), true
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), ninf), -1
  assert_eq compare([-2.5], [-2.5]), 0
  assert_eq equal([-2.5], [-2.5]), true
  assert_eq is_sorted([-2.5]), true
  assert_eq index([-2.5], nz), -1
  assert_eq compare(vec_floats(), [nan, ninf, -2.5]), -1
  assert_eq equal(vec_floats(), [nan, ninf, -2.5]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 1.0), -1
  assert_eq compare([2.5, inf, nz], vec_floats()), 1
  assert_eq equal([2.5, inf, nz], vec_floats()), false
  assert_eq is_sorted([2.5, inf, nz]), false
  assert_eq index([2.5, inf, nz], inf), 1
  assert_eq compare([ninf], [ninf]), 0
  assert_eq equal([ninf], [ninf]), true
  assert_eq is_sorted([ninf]), true
  assert_eq index([ninf], 0.0), -1
  assert_eq compare(vec_floats(), [nan, 2.5, nan]), -1
  assert_eq equal(vec_floats(), [nan, 2.5, nan]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), -1.0), -1
  assert_eq compare(vec_floats(), vec_floats()), 0
  assert_eq equal(vec_floats(), vec_floats()), true
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 2.5), -1
  assert_eq compare([ninf], [ninf, -2.5]), -1
  assert_eq equal([ninf], [ninf, -2.5]), false
  assert_eq is_sorted([ninf]), true
  assert_eq index([ninf], -1.0), -1
  assert_eq compare(vec_floats(), vec_floats()), 0
  assert_eq equal(vec_floats(), vec_floats()), true
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 1.0), -1
  assert_eq compare([-1.0], [-1.0]), 0
  assert_eq equal([-1.0], [-1.0]), true
  assert_eq is_sorted([-1.0]), true
  assert_eq index([-1.0], inf), -1
  assert_eq compare(vec_floats(), [nz]), -1
  assert_eq equal(vec_floats(), [nz]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), -2.5), -1
  assert_eq compare(vec_floats(), [nan, 1.0, -2.5]), -1
  assert_eq equal(vec_floats(), [nan, 1.0, -2.5]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), nz), -1
  assert_eq compare([-2.5, 2.5], [-2.5, 2.5]), 0
  assert_eq equal([-2.5, 2.5], [-2.5, 2.5]), true
  assert_eq is_sorted([-2.5, 2.5]), true
  assert_eq index([-2.5, 2.5], nz), -1
  assert_eq compare(vec_floats(), [nz, -1.0]), -1
  assert_eq equal(vec_floats(), [nz, -1.0]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 0.0), -1
  assert_eq compare(vec_floats(), vec_floats()), 0
  assert_eq equal(vec_floats(), vec_floats()), true
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), -2.5), -1
  assert_eq compare([2.5, nz], [inf, nz]), -1
  assert_eq equal([2.5, nz], [inf, nz]), false
  assert_eq is_sorted([2.5, nz]), false
  assert_eq index([2.5, nz], 2.5), 0
  assert_eq compare([inf], [inf]), 0
  assert_eq equal([inf], [inf]), true
  assert_eq is_sorted([inf]), true
  assert_eq index([inf], ninf), -1
}

test "vectors: index compare equal 10" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq compare([-2.5], [1.0, inf, 0.0]), -1
  assert_eq equal([-2.5], [1.0, inf, 0.0]), false
  assert_eq is_sorted([-2.5]), true
  assert_eq index([-2.5], 2.5), -1
  assert_eq compare([inf, -1.0, -1.0], [inf, -1.0, -1.0]), 0
  assert_eq equal([inf, -1.0, -1.0], [inf, -1.0, -1.0]), true
  assert_eq is_sorted([inf, -1.0, -1.0]), false
  assert_eq index([inf, -1.0, -1.0], 2.5), -1
  assert_eq compare(vec_floats(), [2.5]), -1
  assert_eq equal(vec_floats(), [2.5]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 0.0), -1
  assert_eq compare([nan], [nan]), 0
  assert_eq equal([nan], [nan]), false
  assert_eq is_sorted([nan]), true
  assert_eq index([nan], 1.0), -1
  assert_eq compare(vec_floats(), [-2.5, 0.0, nan]), -1
  assert_eq equal(vec_floats(), [-2.5, 0.0, nan]), false
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), nan), -1
  assert_eq compare(vec_floats(), vec_floats()), 0
  assert_eq equal(vec_floats(), vec_floats()), true
  assert_eq is_sorted(vec_floats()), true
  assert_eq index(vec_floats(), 1.0), -1
  assert_eq compare([inf, 0.0, -2.5], [inf, 0.0, -2.5]), 0
  assert_eq equal([inf, 0.0, -2.5], [inf, 0.0, -2.5]), true
  assert_eq is_sorted([inf, 0.0, -2.5]), false
  assert_eq index([inf, 0.0, -2.5], 2.5), -1
  assert_eq compare([inf], [1.0, 2.5, nz]), 1
  assert_eq equal([inf], [1.0, 2.5, nz]), false
  assert_eq is_sorted([inf]), true
  assert_eq index([inf], 1.0), -1
  assert_eq compare([ninf, 2.5, 2.5], [ninf, 2.5, 2.5]), 0
  assert_eq equal([ninf, 2.5, 2.5], [ninf, 2.5, 2.5]), true
  assert_eq is_sorted([ninf, 2.5, 2.5]), true
  assert_eq index([ninf, 2.5, 2.5], -1.0), -1
  assert_eq compare([nz, 2.5], [nz, 2.5]), 0
  assert_eq equal([nz, 2.5], [nz, 2.5]), true
  assert_eq is_sorted([nz, 2.5]), true
  assert_eq index([nz, 2.5], ninf), -1
}

test "vectors: repeat concat chunk 1" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq repeat(vec_ints(), 2), vec_ints()
  assert_eq concat([[2], vec_ints(), [6, 8]]), [2, 6, 8]
  assert_eq chunk(vec_ints(), 2), vec_intss()
  assert_eq repeat([9], 1), [9]
  assert_eq concat([[5, 7], vec_ints()]), [5, 7]
  assert_eq chunk([9], 4), [[9]]
  assert_eq repeat([7, 2], 2), [7, 2, 7, 2]
  assert_eq concat([[9, 8]]), [9, 8]
  assert_eq chunk([7, 2], 2), [[7, 2]]
  assert_eq repeat([6, 5], 0), vec_ints()
  assert_eq concat([[5, 8]]), [5, 8]
  assert_eq chunk([6, 5], 4), [[6, 5]]
  assert_eq repeat([6, 7], 3), [6, 7, 6, 7, 6, 7]
  assert_eq concat([vec_ints()]), vec_ints()
  assert_eq chunk([6, 7], 2), [[6, 7]]
  assert_eq repeat([3, 3], 2), [3, 3, 3, 3]
  assert_eq concat([[7], [2, 1], [5, 4]]), [7, 2, 1, 5, 4]
  assert_eq chunk([3, 3], 3), [[3, 3]]
  assert_eq repeat([6], 0), vec_ints()
  assert_eq concat([[0], [7, 3], vec_ints()]), [0, 7, 3]
  assert_eq chunk([6], 1), [[6]]
  assert_eq repeat([0], 3), [0, 0, 0]
  assert_eq concat([[5, 7]]), [5, 7]
  assert_eq chunk([0], 1), [[0]]
  assert_eq repeat([4, 8, 0], 2), [4, 8, 0, 4, 8, 0]
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([4, 8, 0], 2), [[4, 8], [0]]
  assert_eq repeat(vec_ints(), 0), vec_ints()
  assert_eq concat([[2]]), [2]
  assert_eq chunk(vec_ints(), 3), vec_intss()
  assert_eq repeat(vec_ints(), 2), vec_ints()
  assert_eq concat([[4]]), [4]
  assert_eq chunk(vec_ints(), 2), vec_intss()
  assert_eq repeat(vec_ints(), 3), vec_ints()
  assert_eq concat([[5], [3, 9]]), [5, 3, 9]
  assert_eq chunk(vec_ints(), 4), vec_intss()
  assert_eq repeat([0], 0), vec_ints()
  assert_eq concat([[8]]), [8]
  assert_eq chunk([0], 1), [[0]]
  assert_eq repeat([3, 8], 1), [3, 8]
  assert_eq concat([vec_ints()]), vec_ints()
  assert_eq chunk([3, 8], 1), [[3], [8]]
  assert_eq repeat([9, 3], 3), [9, 3, 9, 3, 9, 3]
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([9, 3], 2), [[9, 3]]
  assert_eq repeat(vec_ints(), 1), vec_ints()
  assert_eq concat([[4, 9]]), [4, 9]
  assert_eq chunk(vec_ints(), 3), vec_intss()
  assert_eq repeat([3, 9], 3), [3, 9, 3, 9, 3, 9]
  assert_eq concat([[8], vec_ints(), [7, 7]]), [8, 7, 7]
  assert_eq chunk([3, 9], 1), [[3], [9]]
  assert_eq repeat([3, 4], 0), vec_ints()
  assert_eq concat([[2], [1]]), [2, 1]
  assert_eq chunk([3, 4], 3), [[3, 4]]
  assert_eq repeat([4, 7], 0), vec_ints()
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([4, 7], 4), [[4, 7]]
  assert_eq repeat([3, 1, 1], 3), [3, 1, 1, 3, 1, 1, 3, 1, 1]
  assert_eq concat([[8, 6], [8, 9], [9, 7]]), [8, 6, 8, 9, 9, 7]
  assert_eq chunk([3, 1, 1], 3), [[3, 1, 1]]
  assert_eq repeat([9], 1), [9]
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([9], 4), [[9]]
  assert_eq repeat([7], 3), [7, 7, 7]
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([7], 2), [[7]]
  assert_eq repeat([3, 9, 6], 3), [3, 9, 6, 3, 9, 6, 3, 9, 6]
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([3, 9, 6], 3), [[3, 9, 6]]
  assert_eq repeat(vec_ints(), 0), vec_ints()
  assert_eq concat([[6, 2]]), [6, 2]
  assert_eq chunk(vec_ints(), 4), vec_intss()
  assert_eq repeat(vec_ints(), 0), vec_ints()
  assert_eq concat([[2]]), [2]
  assert_eq chunk(vec_ints(), 2), vec_intss()
  assert_eq repeat([2, 5, 7], 1), [2, 5, 7]
  assert_eq concat([[4, 4]]), [4, 4]
  assert_eq chunk([2, 5, 7], 4), [[2, 5, 7]]
  assert_eq repeat([9, 7, 4], 2), [9, 7, 4, 9, 7, 4]
  assert_eq concat([[1, 2], [6]]), [1, 2, 6]
  assert_eq chunk([9, 7, 4], 2), [[9, 7], [4]]
  assert_eq repeat([1, 7, 8], 3), [1, 7, 8, 1, 7, 8, 1, 7, 8]
  assert_eq concat([[4]]), [4]
  assert_eq chunk([1, 7, 8], 4), [[1, 7, 8]]
  assert_eq repeat([1], 3), [1, 1, 1]
  assert_eq concat([[8], [6, 5]]), [8, 6, 5]
  assert_eq chunk([1], 2), [[1]]
  assert_eq repeat([5], 3), [5, 5, 5]
  assert_eq concat([vec_ints()]), vec_ints()
  assert_eq chunk([5], 2), [[5]]
  assert_eq repeat(vec_ints(), 0), vec_ints()
  assert_eq concat([vec_ints()]), vec_ints()
  assert_eq chunk(vec_ints(), 4), vec_intss()
  assert_eq repeat([5, 4], 3), [5, 4, 5, 4, 5, 4]
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([5, 4], 2), [[5, 4]]
  assert_eq repeat([0], 1), [0]
  assert_eq concat([vec_ints(), [9], [5]]), [9, 5]
  assert_eq chunk([0], 2), [[0]]
  assert_eq repeat([9, 7], 1), [9, 7]
}

test "vectors: repeat concat chunk 2" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([9, 7], 3), [[9, 7]]
  assert_eq repeat(vec_ints(), 0), vec_ints()
  assert_eq concat([[4], [8]]), [4, 8]
  assert_eq chunk(vec_ints(), 2), vec_intss()
  assert_eq repeat([2, 2, 7], 3), [2, 2, 7, 2, 2, 7, 2, 2, 7]
  assert_eq concat([[3, 6], [9], vec_ints()]), [3, 6, 9]
  assert_eq chunk([2, 2, 7], 1), [[2], [2], [7]]
  assert_eq repeat([2, 4, 8], 3), [2, 4, 8, 2, 4, 8, 2, 4, 8]
  assert_eq concat([[8, 6]]), [8, 6]
  assert_eq chunk([2, 4, 8], 2), [[2, 4], [8]]
  assert_eq repeat([6], 0), vec_ints()
  assert_eq concat([vec_ints(), vec_ints(), vec_ints()]), vec_ints()
  assert_eq chunk([6], 2), [[6]]
  assert_eq repeat(vec_ints(), 0), vec_ints()
  assert_eq concat([[6], [8, 2], vec_ints()]), [6, 8, 2]
  assert_eq chunk(vec_ints(), 2), vec_intss()
  assert_eq repeat([5, 2, 9], 0), vec_ints()
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([5, 2, 9], 2), [[5, 2], [9]]
  assert_eq repeat([1, 1], 0), vec_ints()
  assert_eq concat([[7, 4], vec_ints(), [7]]), [7, 4, 7]
  assert_eq chunk([1, 1], 1), [[1], [1]]
  assert_eq repeat(vec_ints(), 2), vec_ints()
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk(vec_ints(), 2), vec_intss()
  assert_eq repeat([1, 1, 8], 1), [1, 1, 8]
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([1, 1, 8], 2), [[1, 1], [8]]
  assert_eq repeat([3, 7], 2), [3, 7, 3, 7]
  assert_eq concat([[8]]), [8]
  assert_eq chunk([3, 7], 2), [[3, 7]]
  assert_eq repeat([1], 1), [1]
  assert_eq concat([[6], vec_ints()]), [6]
  assert_eq chunk([1], 1), [[1]]
  assert_eq repeat([8, 9, 8], 0), vec_ints()
  assert_eq concat([vec_ints()]), vec_ints()
  assert_eq chunk([8, 9, 8], 1), [[8], [9], [8]]
  assert_eq repeat([9], 2), [9, 9]
  assert_eq concat([[4, 4], [1, 5]]), [4, 4, 1, 5]
  assert_eq chunk([9], 2), [[9]]
  assert_eq repeat([5, 5], 0), vec_ints()
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([5, 5], 1), [[5], [5]]
  assert_eq repeat(vec_ints(), 3), vec_ints()
  assert_eq concat([vec_ints()]), vec_ints()
  assert_eq chunk(vec_ints(), 2), vec_intss()
  assert_eq repeat(vec_ints(), 3), vec_ints()
  assert_eq concat([[9], [7], vec_ints()]), [9, 7]
  assert_eq chunk(vec_ints(), 3), vec_intss()
  assert_eq repeat([2, 3, 6], 3), [2, 3, 6, 2, 3, 6, 2, 3, 6]
  assert_eq concat([[0, 4]]), [0, 4]
  assert_eq chunk([2, 3, 6], 1), [[2], [3], [6]]
  assert_eq repeat([0], 2), [0, 0]
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([0], 3), [[0]]
  assert_eq repeat([9, 0, 3], 0), vec_ints()
  assert_eq concat([[3]]), [3]
  assert_eq chunk([9, 0, 3], 1), [[9], [0], [3]]
  assert_eq repeat([6, 0, 6], 0), vec_ints()
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([6, 0, 6], 2), [[6, 0], [6]]
  assert_eq repeat(vec_ints(), 1), vec_ints()
  assert_eq concat([vec_ints(), [2, 7]]), [2, 7]
  assert_eq chunk(vec_ints(), 4), vec_intss()
  assert_eq repeat([2, 4, 1], 3), [2, 4, 1, 2, 4, 1, 2, 4, 1]
  assert_eq concat([[6], vec_ints()]), [6]
  assert_eq chunk([2, 4, 1], 2), [[2, 4], [1]]
  assert_eq repeat(vec_ints(), 3), vec_ints()
  assert_eq concat([[4, 3], [3], vec_ints()]), [4, 3, 3]
  assert_eq chunk(vec_ints(), 1), vec_intss()
  assert_eq repeat([6], 0), vec_ints()
  assert_eq concat([[1], [9]]), [1, 9]
  assert_eq chunk([6], 2), [[6]]
  assert_eq repeat([0, 1], 1), [0, 1]
  assert_eq concat(vec_intss()), vec_ints()
  assert_eq chunk([0, 1], 2), [[0, 1]]
  assert_eq repeat([5, 0], 0), vec_ints()
  assert_eq concat([[1, 2], [2]]), [1, 2, 2]
  assert_eq chunk([5, 0], 1), [[5], [0]]
}
