  assert_eq binary_search([ninf, ninf, ninf, nz, 1.0, 1.0, 1.0], ninf), (0, true)
  assert_eq binary_search([ninf, ninf, ninf, nz, 1.0, 1.0, 1.0], -2.5), (3, false)
  assert_eq binary_search([ninf, ninf, ninf, nz, 1.0, 1.0, 1.0], -1.0), (3, false)
