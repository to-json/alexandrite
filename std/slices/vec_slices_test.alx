# Generated from Go's slices (go1.27.1, .scratch/gen/slices); do not edit by hand.
import "math"

def vec_negzero -> Float { math.copysign(0.0, -1.0) }

def vec_ints -> [Int] {
  e: [Int] = []
  e
}

def vec_intss -> [[Int]] {
  e: [[Int]] = []
  e
}

def vec_floats -> [Float] {
  e: [Float] = []
  e
}

def vec_strs -> [Str] {
  e: [Str] = []
  e
}

# The position of x in Go's generator's float set (NaN, -Inf, -2.5, -1, -0,
# 0, 1, 2.5, +Inf), telling -0 from 0.
def vec_fcode(x: Float) -> Int {
  set = [math.nan, math.inf(-1), -2.5, -1.0, vec_negzero(), 0.0, 1.0, 2.5, math.inf(1)]
  for i in 0...set.size {
    v = set[i]
    return i if x != x && v != v
    return i if x == v && math.signbit(x) == math.signbit(v)
  }
  -1
}

def vec_fcodes(xs: [Float]) -> [Int] {
  xs.map { vec_fcode(it) }
}

# sort_func on keys tagged with their positions (key * 1000 + i): where Go's
# pdqsort leaves equal keys.
def vec_sort_key(xs: [Int]) -> [Int] {
  sort_func(xs) { |a, b| a / 1000 - b / 1000 }
  xs
}

def vec_stable_key(xs: [Int]) -> [Int] {
  sort_stable_func(xs) { |a, b| a / 1000 - b / 1000 }
  xs
}

def vec_sort[T](xs: [T]) -> [T] {
  sort(xs)
  xs
}

def vec_fsort(xs: [Float]) -> [Int] {
  sort(xs)
  vec_fcodes(xs)
}

def vec_reverse(xs: [Int]) -> [Int] {
  reverse(xs)
  xs
}

test "vectors: sort_func ties 1" {
  nan = math.nan
  nz = vec_negzero()
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq vec_sort_key(vec_ints()), vec_ints()
  assert_eq vec_sort_key(vec_ints()), vec_ints()
  assert_eq vec_sort_key(vec_ints()), vec_ints()
  assert_eq vec_sort_key([1000]), [1000]
  assert_eq vec_sort_key([0]), [0]
  assert_eq vec_sort_key([1000]), [1000]
  assert_eq vec_sort_key([1000, 1001]), [1000, 1001]
  assert_eq vec_sort_key([0, 1001]), [0, 1001]
  assert_eq vec_sort_key([2000, 1001]), [1001, 2000]
  assert_eq vec_sort_key([0, 1, 1002]), [0, 1, 1002]
  assert_eq vec_sort_key([0, 1001, 2]), [0, 2, 1001]
  assert_eq vec_sort_key([2000, 3001, 1002]), [1002, 2000, 3001]
  assert_eq vec_sort_key([1000, 1, 1002, 3]), [1, 3, 1000, 1002]
  assert_eq vec_sort_key([2000, 1001, 2, 1003]), [2, 1001, 1003, 2000]
  assert_eq vec_sort_key([2000, 3001, 2, 3]), [2, 3, 2000, 3001]
  assert_eq vec_sort_key([1000, 1, 1002, 1003, 1004]), [1, 1000, 1002, 1003, 1004]
  assert_eq vec_sort_key([2000, 1, 1002, 3, 4]), [1, 3, 4, 1002, 2000]
  assert_eq vec_sort_key([1000, 4001, 4002, 3003, 1004]), [1000, 1004, 3003, 4001, 4002]
  assert_eq vec_sort_key([1000, 1, 2, 1003, 1004, 1005]), [1, 2, 1000, 1003, 1004, 1005]
  assert_eq vec_sort_key([1000, 1001, 3002, 3, 1004, 5]), [3, 5, 1000, 1001, 1004, 3002]
  assert_eq vec_sort_key([3000, 5001, 6002, 5003, 4, 1005]), [4, 1005, 3000, 5001, 5003, 6002]
  assert_eq vec_sort_key([0, 1, 2, 1003, 4, 1005, 6]), [0, 1, 2, 4, 6, 1003, 1005]
  assert_eq vec_sort_key([3000, 1, 2002, 2003, 3004, 2005, 1006]), [1, 1006, 2002, 2003, 2005, 3000, 3004]
  assert_eq vec_sort_key([7000, 4001, 4002, 7003, 1004, 1005, 5006]), [1004, 1005, 4001, 4002, 5006, 7000, 7003]
  assert_eq vec_sort_key([1000, 1001, 1002, 1003, 1004, 5, 6, 7]), [5, 6, 7, 1000, 1001, 1002, 1003, 1004]
  assert_eq vec_sort_key([1000, 2001, 2, 3003, 2004, 3005, 6, 3007]), [2, 6, 1000, 2001, 2004, 3003, 3005, 3007]
  assert_eq vec_sort_key([3000, 4001, 3002, 8003, 5004, 2005, 1006, 4007]), [1006, 2005, 3000, 3002, 4001, 4007, 5004, 8003]
  assert_eq vec_sort_key([0, 1, 2, 1003, 1004, 5, 6, 1007, 1008]), [0, 1, 2, 5, 6, 1003, 1004, 1007, 1008]
  assert_eq vec_sort_key([2000, 1001, 4002, 1003, 2004, 1005, 4006, 1007, 8]), [8, 1001, 1003, 1005, 1007, 2000, 2004, 4002, 4006]
  assert_eq vec_sort_key([3000, 6001, 9002, 1003, 2004, 5005, 5006, 7, 7008]), [7, 1003, 2004, 3000, 5005, 5006, 6001, 7008, 9002]
  assert_eq vec_sort_key([1000, 1, 2, 3, 1004, 5, 1006, 7, 8, 9]), [1, 2, 3, 5, 7, 8, 9, 1000, 1004, 1006]
  assert_eq vec_sort_key([5000, 2001, 2002, 5003, 2004, 4005, 1006, 4007, 4008, 5009]), [1006, 2001, 2002, 2004, 4005, 4007, 4008, 5000, 5003, 5009]
  assert_eq vec_sort_key([1000, 3001, 5002, 7003, 2004, 8005, 3006, 6007, 4008, 9]), [9, 1000, 2004, 3001, 3006, 4008, 5002, 6007, 7003, 8005]
  assert_eq vec_sort_key([1000, 1, 2, 1003, 4, 5, 6, 1007, 8, 9, 10]), [1, 2, 4, 5, 6, 8, 9, 10, 1000, 1003, 1007]
  assert_eq vec_sort_key([1000, 3001, 3002, 5003, 4004, 3005, 4006, 3007, 2008, 3009, 10]), [10, 1000, 2008, 3001, 3002, 3005, 3007, 3009, 4004, 4006, 5003]
  assert_eq vec_sort_key([0, 7001, 10002, 5003, 2004, 5005, 6, 7, 4008, 11009, 6010]), [0, 6, 7, 2004, 4008, 5003, 5005, 6010, 7001, 10002, 11009]
  assert_eq vec_sort_key([0, 1, 1002, 3, 1004, 1005, 6, 7, 1008, 9, 1010, 11]), [0, 1, 3, 6, 7, 9, 11, 1002, 1004, 1005, 1008, 1010]
