#![test(external)]
# Go's sort example_test.go, example_search_test.go, example_interface_test.go,
# example_keys_test.go, example_multi_test.go and example_wrapper_test.go,
# translated. Go's pointer receivers (`*multiSorter`, `[]*Organ`) become
# structs whose slices share storage; Go's String methods become `to_s`.
import "math"
import "sort"
import "strings"

example "Search" {
  a = [1, 3, 6, 10, 15, 21, 28, 36, 45, 55]
  x = 6
  i = sort.search(a.size) { |i| a[i] >= x }
  if i < a.size && a[i] == x {
    puts "found #{x} at index #{i} in #{a}"
  } else {
    puts "#{x} not found in #{a}"
  }
} outputs "found 6 at index 2 in [1 3 6 10 15 21 28 36 45 55]\n"

# Searching a list sorted in descending order: the condition is inverted.
example "Search descendingOrder" {
  a = [55, 45, 36, 28, 21, 15, 10, 6, 3, 1]
  x = 6
  i = sort.search(a.size) { |i| a[i] <= x }
  if i < a.size && a[i] == x {
    puts "found #{x} at index #{i} in #{a}"
  } else {
    puts "#{x} not found in #{a}"
  }
} outputs "found 6 at index 7 in [55 45 36 28 21 15 10 6 3 1]\n"

example "Find" {
  a = ["apple", "banana", "lemon", "mango", "pear", "strawberry"]
  for x in ["banana", "orange"] {
    i, found = sort.find(a.size) { |i| strings.compare(x, a[i]) }
    if found {
      puts "found #{x} at index #{i}"
    } else {
      puts "#{x} not found, would insert at #{i}"
    }
  }
} outputs "found banana at index 1\norange not found, would insert at 4\n"

example "SearchFloat64s" {
  a = [1.0, 2.0, 3.3, 4.6, 6.1, 7.2, 8.0]
  x = 2.0
  i = sort.search_float64s(a, x)
  puts format("found %g at index %d in %v", x, i, a)
  x = 0.5
  i = sort.search_float64s(a, x)
  puts format("%g not found, can be inserted at index %d in %v", x, i, a)
} outputs <<~EOS
  found 2 at index 1 in [1 2 3.3 4.6 6.1 7.2 8]
  0.5 not found, can be inserted at index 0 in [1 2 3.3 4.6 6.1 7.2 8]
EOS

example "SearchInts" {
  a = [1, 2, 3, 4, 6, 7, 8]
  x = 2
  i = sort.search_ints(a, x)
  puts "found #{x} at index #{i} in #{a}"
  x = 5
  i = sort.search_ints(a, x)
  puts "#{x} not found, can be inserted at index #{i} in #{a}"
} outputs "found 2 at index 1 in [1 2 3 4 6 7 8]\n5 not found, can be inserted at index 4 in [1 2 3 4 6 7 8]\n"

example "SearchStrings" {
  a = ["apple", "banana", "cherry", "date", "fig", "grape"]
  x = "banana"
  i = sort.search_strings(a, x)
  puts "found #{x} at index #{i} in #{a}"
  x = "coconut"
  i = sort.search_strings(a, x)
  puts "#{x} not found, can be inserted at index #{i} in #{a}"
} outputs <<~EOS
  found banana at index 1 in [apple banana cherry date fig grape]
  coconut not found, can be inserted at index 3 in [apple banana cherry date fig grape]
EOS

example "Ints" {
  s = [5, 2, 6, 3, 1, 4] # unsorted
  sort.ints(s)
  puts s
} outputs "[1 2 3 4 5 6]\n"

example "IntsAreSorted" {
  s = [1, 2, 3, 4, 5, 6] # sorted ascending
  puts sort.ints_are_sorted(s)
  s = [6, 5, 4, 3, 2, 1] # sorted descending
  puts sort.ints_are_sorted(s)
  s = [3, 2, 4, 1, 5] # unsorted
  puts sort.ints_are_sorted(s)
} outputs "true\nfalse\nfalse\n"

example "Float64s" {
  s = [5.2, -1.3, 0.7, -3.8, 2.6] # unsorted
  sort.float64s(s)
  puts format("%v", s)
  s = [math.inf(1), math.nan, math.inf(-1), 0.0] # unsorted
  sort.float64s(s)
  puts format("%v", s)
} outputs "[-3.8 -1.3 0.7 2.6 5.2]\n[NaN -Inf 0 +Inf]\n"

example "Float64sAreSorted" {
  s = [0.7, 1.3, 2.6, 3.8, 5.2] # sorted ascending
  puts sort.float64s_are_sorted(s)
  s = [5.2, 3.8, 2.6, 1.3, 0.7] # sorted descending
  puts sort.float64s_are_sorted(s)
  s = [5.2, 1.3, 0.7, 3.8, 2.6] # unsorted
  puts sort.float64s_are_sorted(s)
} outputs "true\nfalse\nfalse\n"

example "Reverse" {
  s = [5, 2, 6, 3, 1, 4] # unsorted
  sort.sort(sort.reverse(sort.IntSlice.new(s)))
  puts s
} outputs "[6 5 4 3 2 1]\n"

struct NameAge {
  name: Str
  age: Int
}

example "Slice" {
  people = [NameAge.new("Gopher", 7), NameAge.new("Alice", 55), NameAge.new("Vera", 24), NameAge.new("Bob", 75)]
  sort.slice(people) { |i, j| people[i].name < people[j].name }
  puts "By name: #{people}"
  sort.slice(people) { |i, j| people[i].age < people[j].age }
  puts "By age: #{people}"
} outputs "By name: [{Alice 55} {Bob 75} {Gopher 7} {Vera 24}]\nBy age: [{Gopher 7} {Vera 24} {Alice 55} {Bob 75}]\n"

example "SliceIsSorted" {
  numbers = [1, 2, 3, 4, 5, 6]
  is_sorted_asc = sort.slice_is_sorted(numbers) { |i, j| numbers[i] < numbers[j] }
  puts "#{numbers} sorted ascending: #{is_sorted_asc}"
  numbers_desc = [6, 5, 4, 3, 2, 1]
  is_sorted_desc = sort.slice_is_sorted(numbers_desc) { |i, j| numbers_desc[i] > numbers_desc[j] }
  puts "#{numbers} sorted descending: #{is_sorted_desc}"
  unsorted_numbers = [1, 3, 2, 4, 5]
  is_sorted_unsorted = sort.slice_is_sorted(unsorted_numbers) { |i, j| unsorted_numbers[i] < unsorted_numbers[j] }
  puts "#{unsorted_numbers} unsorted slice sorted: #{is_sorted_unsorted}"
} outputs <<~EOS
  [1 2 3 4 5 6] sorted ascending: true
  [1 2 3 4 5 6] sorted descending: true
  [1 3 2 4 5] unsorted slice sorted: false
EOS

example "SliceStable" {
  people = [
    NameAge.new("Alice", 25),
    NameAge.new("Elizabeth", 75),
    NameAge.new("Alice", 75),
    NameAge.new("Bob", 75),
    NameAge.new("Alice", 75),
    NameAge.new("Bob", 25),
    NameAge.new("Colin", 25),
    NameAge.new("Elizabeth", 25),
  ]
  # Sort by name, preserving original order
  sort.slice_stable(people) { |i, j| people[i].name < people[j].name }
  puts "By name: #{people}"
  # Sort by age preserving name order
  sort.slice_stable(people) { |i, j| people[i].age < people[j].age }
  puts "By age,name: #{people}"
} outputs <<~EOS
  By name: [{Alice 25} {Alice 75} {Alice 75} {Bob 75} {Bob 25} {Colin 25} {Elizabeth 75} {Elizabeth 25}]
  By age,name: [{Alice 25} {Bob 25} {Colin 25} {Elizabeth 25} {Alice 75} {Alice 75} {Bob 75} {Elizabeth 75}]
EOS

example "Strings" {
  s = ["Go", "Bravo", "Gopher", "Alpha", "Grin", "Delta"]
  sort.strings(s)
  puts s
} outputs "[Alpha Bravo Delta Go Gopher Grin]\n"

# --- example_interface_test.go ---

struct Person {
  name: Str
  age: Int

  def to_s -> Str { "#{name}: #{age}" }
}

def show_people(ps: [Person]) -> Str {
  "[" + strings.join(ps.map { it.to_s }.to_a, " ") + "]"
}

# A sort.Interface for [Person] based on the age field.
struct ByAge {
  ps: [Person]

  def len -> Int { ps.size }

  def swap!(i: Int, j: Int) {
    x = ps
    x[i], x[j] = x[j], x[i]
  }

  def less(i: Int, j: Int) -> Bool { ps[i].age < ps[j].age }
}

example "Interface" {
  people = [Person.new("Bob", 31), Person.new("John", 42), Person.new("Michael", 17), Person.new("Jenny", 26)]
  puts show_people(people)
  # There are two ways to sort a slice. First, one can define a set of
  # methods for the slice type, as with ByAge, and call sort.sort. In this
  # first example we use that technique.
  sort.sort(ByAge.new(people))
  puts show_people(people)
  # The other way is to use sort.slice with a custom less function, which
  # can be provided as a closure. In this case no methods are needed.
  sort.slice(people) { |i, j| people[i].age > people[j].age }
  puts show_people(people)
} outputs <<~EOS
  [Bob: 31 John: 42 Michael: 17 Jenny: 26]
  [Michael: 17 Jenny: 26 Bob: 31 John: 42]
  [John: 42 Bob: 31 Jenny: 26 Michael: 17]
EOS

# --- example_keys_test.go ---

struct Planet {
  name: Str
  mass: Float
  distance: Float
}

# Sorts planets with `by` as the less function (Go's By.Sort).
struct PlanetSorter {
  planets: [Planet]
  by: (Planet, Planet) -> Bool # closure used in the less method

  def len -> Int { planets.size }

  def swap!(i: Int, j: Int) {
    x = planets
    x[i], x[j] = x[j], x[i]
  }

  def less(i: Int, j: Int) -> Bool { by(planets[i], planets[j]) }
}

def sort_planets_by(planets: [Planet], by: (Planet, Planet) -> Bool) {
  sort.sort(PlanetSorter.new(planets: planets, by: by))
}

def show_planets(ps: [Planet]) -> Str {
  "[" + strings.join(ps.map { format("{%s %v %v}", it.name, it.mass, it.distance) }.to_a, " ") + "]"
}

example "sortKeys" {
  planets = [
    Planet.new("Mercury", 0.055, 0.4),
    Planet.new("Venus", 0.815, 0.7),
    Planet.new("Earth", 1.0, 1.0),
    Planet.new("Mars", 0.107, 1.5),
  ]
  # Closures that order the Planet structure.
  name = ->(p1: Planet, p2: Planet) -> Bool { p1.name < p2.name }
  mass = ->(p1: Planet, p2: Planet) -> Bool { p1.mass < p2.mass }
  distance = ->(p1: Planet, p2: Planet) -> Bool { p1.distance < p2.distance }
  decreasing_distance = ->(p1: Planet, p2: Planet) -> Bool { distance(p2, p1) }
  # Sort the planets by the various criteria.
  sort_planets_by(planets, name)
  puts "By name: #{show_planets(planets)}"
  sort_planets_by(planets, mass)
  puts "By mass: #{show_planets(planets)}"
  sort_planets_by(planets, distance)
  puts "By distance: #{show_planets(planets)}"
  sort_planets_by(planets, decreasing_distance)
  puts "By decreasing distance: #{show_planets(planets)}"
} outputs <<~EOS
  By name: [{Earth 1 1} {Mars 0.107 1.5} {Mercury 0.055 0.4} {Venus 0.815 0.7}]
  By mass: [{Mercury 0.055 0.4} {Mars 0.107 1.5} {Venus 0.815 0.7} {Earth 1 1}]
  By distance: [{Mercury 0.055 0.4} {Venus 0.815 0.7} {Earth 1 1} {Mars 0.107 1.5}]
  By decreasing distance: [{Mars 0.107 1.5} {Earth 1 1} {Venus 0.815 0.7} {Mercury 0.055 0.4}]
EOS

# --- example_multi_test.go ---

struct Change {
  user: Str
  language: Str
  lines: Int
}

# A sort.Interface sorting by a list of less functions, earlier ones first.
struct MultiSorter {
  changes: [Change]
  less_fns: [(Change, Change) -> Bool]

  def len -> Int { changes.size }

  def swap!(i: Int, j: Int) {
    x = changes
    x[i], x[j] = x[j], x[i]
  }

  # Loops along the less functions until it finds a comparison that
  # discriminates between the two items (one is less than the other); the
  # last function decides the rest.
  def less(i: Int, j: Int) -> Bool {
    p = changes[i]
    q = changes[j]
    k = 0
    while k < less_fns.size - 1 {
      f = less_fns[k]
      return true if f(p, q)
      return false if f(q, p)
      k += 1
    }
    f = less_fns[k]
    f(p, q)
  }
}

# Sorts `changes` by the less functions, in order (Go's OrderedBy(...).Sort).
def ordered_by(less_fns: [(Change, Change) -> Bool], changes: [Change]) {
  sort.sort(MultiSorter.new(changes: changes, less_fns: less_fns))
}

example "sortMultiKeys" {
  changes = [
    Change.new("gri", "Go", 100),
    Change.new("ken", "C", 150),
    Change.new("glenda", "Go", 200),
    Change.new("rsc", "Go", 200),
    Change.new("r", "Go", 100),
    Change.new("ken", "Go", 200),
    Change.new("dmr", "C", 100),
    Change.new("r", "C", 150),
    Change.new("gri", "Smalltalk", 80),
  ]
  # Closures that order the Change structure.
  user = ->(c1: Change, c2: Change) -> Bool { c1.user < c2.user }
  language = ->(c1: Change, c2: Change) -> Bool { c1.language < c2.language }
  increasing_lines = ->(c1: Change, c2: Change) -> Bool { c1.lines < c2.lines }
  decreasing_lines = ->(c1: Change, c2: Change) -> Bool { c1.lines > c2.lines } # Note: > orders downwards.
  # Simple use: Sort by user.
  ordered_by([user], changes)
  puts "By user: #{changes}"
  # More examples.
  ordered_by([user, increasing_lines], changes)
  puts "By user,<lines: #{changes}"
  ordered_by([user, decreasing_lines], changes)
  puts "By user,>lines: #{changes}"
  ordered_by([language, increasing_lines], changes)
  puts "By language,<lines: #{changes}"
  ordered_by([language, increasing_lines, user], changes)
  puts "By language,<lines,user: #{changes}"
} outputs <<~EOS
  By user: [{dmr C 100} {glenda Go 200} {gri Go 100} {gri Smalltalk 80} {ken C 150} {ken Go 200} {r Go 100} {r C 150} {rsc Go 200}]
  By user,<lines: [{dmr C 100} {glenda Go 200} {gri Smalltalk 80} {gri Go 100} {ken C 150} {ken Go 200} {r Go 100} {r C 150} {rsc Go 200}]
  By user,>lines: [{dmr C 100} {glenda Go 200} {gri Go 100} {gri Smalltalk 80} {ken Go 200} {ken C 150} {r C 150} {r Go 100} {rsc Go 200}]
  By language,<lines: [{dmr C 100} {ken C 150} {r C 150} {gri Go 100} {r Go 100} {glenda Go 200} {ken Go 200} {rsc Go 200} {gri Smalltalk 80}]
  By language,<lines,user: [{dmr C 100} {ken C 150} {r C 150} {gri Go 100} {r Go 100} {glenda Go 200} {ken Go 200} {rsc Go 200} {gri Smalltalk 80}]
EOS

# --- example_wrapper_test.go ---

struct Organ {
  name: Str
  weight: Int # grams
}

# Go's Organs with the Less of an embedding wrapper: by_weight picks
# ByWeight (else ByName).
struct Organs {
  s: [Organ]
  by_weight: Bool

  def len -> Int { s.size }

  def swap!(i: Int, j: Int) {
    x = s
    x[i], x[j] = x[j], x[i]
  }

  def less(i: Int, j: Int) -> Bool {
    return s[i].weight < s[j].weight if by_weight
    s[i].name < s[j].name
  }
}

def print_organs(s: [Organ]) {
  for o in s {
    puts format("%-8s (%dg)", o.name, o.weight)
  }
}

example "sortWrapper" {
  s = [
    Organ.new("brain", 1340),
    Organ.new("heart", 290),
    Organ.new("liver", 1494),
    Organ.new("pancreas", 131),
    Organ.new("prostate", 62),
    Organ.new("spleen", 162),
  ]
  sort.sort(Organs.new(s, true))
  puts "Organs by weight:"
  print_organs(s)
  sort.sort(Organs.new(s, false))
  puts "Organs by name:"
  print_organs(s)
} outputs <<~EOS
  Organs by weight:
  prostate (62g)
  pancreas (131g)
  spleen   (162g)
  heart    (290g)
  brain    (1340g)
  liver    (1494g)
  Organs by name:
  brain    (1340g)
  heart    (290g)
  liver    (1494g)
  pancreas (131g)
  prostate (62g)
  spleen   (162g)
EOS
