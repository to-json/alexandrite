# Package sort: Go's sort, on top of `slices` (S2).
#
# Everything sorts in place and ascending. Differences from Go:
#   - `slice` and `slice_stable` take `less(a, b)` over the *elements*, not
#     Go's `less(i, j)` over indexes (an element function can't see a
#     half-sorted slice, and doesn't need reflection to swap).
#   - No `sort.Interface`/`sort.Sort`: use `slices.sort_func` or `slice`.
#   - `float64s` takes `[Float]` and orders NaNs first.
import "slices"

# Sorts ints ascending.
pub def ints(xs: [Int]) {
  slices.sort(xs)
}

# Sorts strings ascending (bytewise).
pub def strings(xs: [Str]) {
  slices.sort(xs)
}

# Sorts floats ascending, NaNs first.
pub def float64s(xs: [Float]) {
  slices.sort(xs)
}

pub def ints_are_sorted(xs: [Int]) -> Bool {
  slices.is_sorted(xs)
}

pub def strings_are_sorted(xs: [Str]) -> Bool {
  slices.is_sorted(xs)
}

pub def float64s_are_sorted(xs: [Float]) -> Bool {
  slices.is_sorted(xs)
}

# The smallest index i in 0...n for which `f(i)` is true, assuming `f` is
# false up to some index and true from there on; n if it is never true.
pub def search(n: Int, f: (Int) -> Bool) -> Int {
  i = 0
  j = n
  while i < j {
    h = i + (j - i) / 2
    if !f(h) {
      i = h + 1
    } else {
      j = h
    }
  }
  i
}

# The index at which `x` is, or would be inserted, in the sorted `xs`.
pub def search_ints(xs: [Int], x: Int) -> Int {
  i = 0
  j = xs.size
  while i < j {
    h = i + (j - i) / 2
    if xs[h] < x {
      i = h + 1
    } else {
      j = h
    }
  }
  i
}

pub def search_strings(xs: [Str], x: Str) -> Int {
  i = 0
  j = xs.size
  while i < j {
    h = i + (j - i) / 2
    if xs[h] < x {
      i = h + 1
    } else {
      j = h
    }
  }
  i
}

pub def search_float64s(xs: [Float], x: Float) -> Int {
  slices.binary_search(xs, x)[0]
}

# Sorts `xs` in place; `less(a, b)` says a sorts before b. Not stable.
pub def slice[T](xs: [T], less: (T, T) -> Bool) {
  sort_range_less(xs, 0, xs.size, less)
}

# Like `slice`, keeping equal elements in their original order.
pub def slice_stable[T](xs: [T], less: (T, T) -> Bool) {
  stable_sort_less(xs, less)
}

# Whether `xs` is already sorted by `less`.
pub def slice_is_sorted[T](xs: [T], less: (T, T) -> Bool) -> Bool {
  i = 1
  while i < xs.size {
    return false if less(xs[i], xs[i - 1])
    i += 1
  }
  true
}
