#![test(external)]
# Go's sort_test.go and search_test.go, translated (Go's package sort_test).
# Not translated: TestSearchWrappersDontAlloc (allocation counts), and
# TestCountStableOps / TestCountSortOps, which only log in verbose mode.
# Go's math/rand calls are a local LCG (the tests need some distribution,
# not Go's numbers).
import "cmp"
import "math"
import "slices"
import "sort"
import "strings"

def ints -> [Int] {
  [74, 59, 238, -784, 9845, 959, 905, 0, 0, 42, 7586, -5467984, 7586]
}

def float64s -> [Float] {
  [74.3, 59.0, math.inf(1), 238.2, -784.0, 2.3, math.nan, math.nan, math.inf(-1), 9845.768, -959.7485, 905.0, 7.8, 7.8]
}

def strings_data -> [Str] {
  ["", "Hello", "foo", "bar", "foo", "f00", "%*&^*&^&", "***"]
}

# A deterministic stand-in for Go's rand.IntN.
struct Lcg {
  st: [U64]

  def intn!(n: Int) -> Int {
    x = self.st[0] *% 6364136223846793005 +% 1442695040888963407
    self.st[0] = x
    ((x >> 33) % n.as_u64).as_i64
  }
}

def new_lcg(seed: Int) -> Lcg {
  Lcg.new(st: [seed.as_u64])
}

test "SortIntSlice" {
  data = ints
  a = sort.IntSlice.new(data)
  sort.sort(a)
  assert sort.is_sorted(a), "got #{data}"
}

test "SortFloat64Slice" {
  data = float64s
  a = sort.Float64Slice.new(data)
  sort.sort(a)
  assert sort.is_sorted(a), "got #{data}"
}

# Compare sort with slices.sort sorting a float slice containing NaNs.
test "SortFloat64sCompareSlicesSort" {
  slice1 = slices.clone(float64s)
  slice2 = slices.clone(float64s)
  sort.sort(sort.Float64Slice.new(slice1))
  slices.sort(slice2)
  # Compare for equality using cmp.compare, which considers NaNs equal.
  assert slices.equal_func(slice1, slice2) { |a, b| cmp.compare(a, b) == 0 }, "got #{slice1}, want #{slice2}"
}

test "SortStringSlice" {
  data = strings_data
  a = sort.StringSlice.new(data)
  sort.sort(a)
  assert sort.is_sorted(a), "got #{data}"
}

test "Ints" {
  data = ints
  sort.ints(data)
  assert sort.ints_are_sorted(data), "got #{data}"
}

test "Float64s" {
  data = float64s
  sort.float64s(data)
  assert sort.float64s_are_sorted(data), "got #{data}"
}

test "Strings" {
  data = strings_data
  sort.strings(data)
  assert sort.strings_are_sorted(data), "got #{data}"
}

test "Slice" {
  data = strings_data
  sort.slice(data) { |i, j| data[i] < data[j] }
  assert sort.slice_is_sorted(data) { |i, j| data[i] < data[j] }, "got #{data}"
}

test "SortLarge_Random" {
  n = 1000000
  r = new_lcg(1)
  data = [0; 1000000]
  for i in 0...n { data[i] = r.intn!(100) }
  assert !sort.ints_are_sorted(data), "terrible rand"
  sort.ints(data)
  assert sort.ints_are_sorted(data), "sort didn't sort - 1M ints"
}

test "ReverseSortIntSlice" {
  data = ints
  data1 = ints
  a = sort.IntSlice.new(data)
  sort.sort(a)
  r = sort.IntSlice.new(data1)
  sort.sort(sort.reverse(r))
  for i in 0...data.size {
    assert data[i] == data1[data.size - 1 - i], "reverse sort didn't sort"
    break if i > data.size / 2
  }
}

test "BreakPatterns" {
  # Special slice used to trigger break_patterns.
  data = [10; 30]
  data[(data.size / 4) * 1] = 0
  data[(data.size / 4) * 2] = 1
  data[(data.size / 4) * 3] = 2
  sort.sort(sort.IntSlice.new(data))
  assert sort.ints_are_sorted(data)
}

test "ReverseRange" {
  data = [1, 2, 3, 4, 5, 6, 7]
  sort.export_reverse_range(sort.IntSlice.new(data), 0, data.size)
  i = data.size - 1
  while i > 0 {
    assert data[i] <= data[i - 1], "reverse_range didn't work"
    i -= 1
  }
  data1 = [1, 2, 3, 4, 5, 6, 7]
  data2 = [1, 2, 5, 4, 3, 6, 7]
  sort.export_reverse_range(sort.IntSlice.new(data1), 2, 5)
  assert_eq data1, data2
}

# Less answers at random; swap! checks its indexes.
struct NonDeterministicTestingData {
  r: Lcg

  def len -> Int { 500 }

  def less(i: Int, j: Int) -> Bool {
    panic "nondeterministic comparison out of bounds" if i < 0 || j < 0 || i >= self.len || j >= self.len
    g = r
    g.intn!(2) == 0
  }

  def swap!(i: Int, j: Int) {
    panic "nondeterministic comparison out of bounds" if i < 0 || j < 0 || i >= self.len || j >= self.len
  }
}

# sort.sort does not panic when less returns inconsistent results
# (golang.org/issue/14377).
test "NonDeterministicComparison" {
  td = NonDeterministicTestingData.new(r: new_lcg(0))
  for _ in 0...10 { sort.sort(td) }
}

SAWTOOTH = 0
RAND = 1
STAGGER = 2
PLATEAU = 3
SHUFFLE = 4
N_DIST = 5

COPY = 0
REVERSE = 1
REVERSE_FIRST_HALF = 2
REVERSE_SECOND_HALF = 3
SORTED = 4
DITHER = 5
N_MODE = 6

# Counts compares and swaps; panics past maxswap swaps.
struct TestingData {
  desc: Str
  data: [Int]
  maxswap: Int
  counts: [Int] # [ncmp, nswap]

  def len -> Int { data.size }

  def less(i: Int, j: Int) -> Bool {
    c = counts
    c[0] += 1
    data[i] < data[j]
  }

  def swap!(i: Int, j: Int) {
    if counts[1] >= maxswap {
      panic "#{desc}: used #{counts[1]} swaps sorting slice of #{data.size}"
    }
    c = counts
    c[1] += 1
    x = data
    x[i], x[j] = x[j], x[i]
  }
}

def lg(n: Int) -> Int {
  i = 0
  while (1 << i) < n { i += 1 }
  i
}

# algo: 0 sort.sort, 1 sort.heapsort, 2 sort.stable.
def test_bentley_mc_ilroy(algo: Int, maxswap: (Int) -> Int) {
  sizes = [100, 1023, 1024, 1025]
  dists = ["sawtooth", "rand", "stagger", "plateau", "shuffle"]
  modes = ["copy", "reverse", "reverse1", "reverse2", "sort", "dither"]
  r = new_lcg(7)
  for n in sizes {
    m = 1
    while m < 2 * n {
      for dist in 0...N_DIST {
        j = 0
        k = 1
        data = [0; n]
        for i in 0...n {
          case dist {
            SAWTOOTH => data[i] = i % m
            RAND => data[i] = r.intn!(m)
            STAGGER => data[i] = (i * m + i) % n
            PLATEAU => data[i] = i < m ? i : m
            _ => {
              if r.intn!(m) != 0 {
                j += 2
                data[i] = j
              } else {
                k += 2
                data[i] = k
              }
            }
          }
        }
        for mode in 0...N_MODE {
          mdata = [0; n]
          case mode {
            COPY => copy(mdata, data)
            REVERSE => {
              for i in 0...n { mdata[i] = data[n - i - 1] }
            }
            REVERSE_FIRST_HALF => {
              for i in 0...n / 2 { mdata[i] = data[n / 2 - i - 1] }
              for i in n / 2...n { mdata[i] = data[i] }
            }
            REVERSE_SECOND_HALF => {
              for i in 0...n / 2 { mdata[i] = data[i] }
              for i in n / 2...n { mdata[i] = data[n - (i - n / 2) - 1] }
            }
            SORTED => {
              copy(mdata, data)
              # ints is known to be correct because mode SORTED runs after
              # mode COPY.
              sort.ints(mdata)
            }
            _ => {
              for i in 0...n { mdata[i] = data[i] + i % 5 }
            }
          }
          desc = "n=#{n} m=#{m} dist=#{dists[dist]} mode=#{modes[mode]}"
          d = TestingData.new(desc: desc, data: mdata, maxswap: maxswap(n), counts: [0, 0])
          case algo {
            0 => sort.sort(d)
            1 => sort.heapsort(d)
            _ => sort.stable(d)
          }
          assert sort.ints_are_sorted(mdata), "#{desc}: ints not sorted\n\t#{mdata}"
        }
      }
      m *= 2
    }
  }
}

test "SortBM" {
  test_bentley_mc_ilroy(0) { |n| n * lg(n) * 12 / 10 }
}

test "HeapsortBM" {
  test_bentley_mc_ilroy(1) { |n| n * lg(n) * 12 / 10 }
}

test "StableBM" {
  test_bentley_mc_ilroy(2) { |n| n * lg(n) * lg(n) / 3 }
}

# M. Douglas McIlroy's "antiquicksort"
# (https://www.cs.dartmouth.edu/~doug/mdmspe.pdf): less fixes values as
# it is asked about them so as to make quicksort quadratic.
struct AdversaryTestingData {
  data: [Int] # item values, initialized to the gas value and changed by less
  maxcmp: Int # number of comparisons allowed
  st: [Int]   # [ncmp, nsolid, candidate]: comparisons, frozen elements, the guessed pivot
  gas: Int    # the value of unset elements, higher than everything else

  def len -> Int { data.size }

  def less(i: Int, j: Int) -> Bool {
    s = st
    d = data
    panic "used #{s[0]} comparisons sorting adversary data with size #{d.size}" if s[0] >= maxcmp
    s[0] += 1
    if d[i] == gas && d[j] == gas {
      if i == s[2] {
        # freeze i
        d[i] = s[1]
      } else {
        # freeze j
        d[j] = s[1]
      }
      s[1] += 1
    }
    if d[i] == gas {
      s[2] = i
    } else if d[j] == gas {
      s[2] = j
    }
    d[i] < d[j]
  }

  def swap!(i: Int, j: Int) {
    x = data
    x[i], x[j] = x[j], x[i]
  }
}

def new_adversary_testing_data(size: Int, maxcmp: Int) -> AdversaryTestingData {
  gas = size - 1
  AdversaryTestingData.new(data: [gas; size], maxcmp: maxcmp, st: [0, 0, 0], gas: gas)
}

test "Adversary" {
  size = 10000                 # large enough to distinguish between O(n^2) and O(n*log(n))
  maxcmp = size * lg(size) * 4 # the factor 4 was found by trial and error
  d = new_adversary_testing_data(size, maxcmp)
  sort.sort(d) # This should degenerate to heapsort.
  # Check data is fully populated and sorted.
  for i in 0...d.data.size {
    assert d.data[i] == i, "adversary data not fully sorted"
  }
}

test "StableInts" {
  data = ints
  sort.stable(sort.IntSlice.new(data))
  assert sort.ints_are_sorted(data), "got #{data}"
}

struct IntPair {
  a: Int
  b: Int
}

# Pairs compare on a only.
struct IntPairs {
  d: [IntPair]

  def len -> Int { d.size }

  def less(i: Int, j: Int) -> Bool { d[i].a < d[j].a }

  def swap!(i: Int, j: Int) {
    x = d
    x[i], x[j] = x[j], x[i]
  }

  # Records the initial order in b.
  def init_b! {
    for i in 0...d.size { self.d[i].b = i }
  }

  # Whether a-equal elements were not reordered.
  def in_order -> Bool {
    last_a = -1
    last_b = 0
    for p in d {
      if last_a != p.a {
        last_a = p.a
        last_b = p.b
        next
      }
      return false if p.b <= last_b
      last_b = p.b
    }
    true
  }
}

test "Stability" {
  n = 100000
  m = 1000
  data = IntPairs.new([IntPair.new; 100000])
  r = new_lcg(2)
  # random distribution
  for i in 0...n { data.d[i].a = r.intn!(m) }
  assert !sort.is_sorted(data), "terrible rand"
  data.init_b!
  sort.stable(data)
  assert sort.is_sorted(data), "Stable didn't sort #{n} ints"
  assert data.in_order, "Stable wasn't stable on #{n} ints"
  # already sorted
  data.init_b!
  sort.stable(data)
  assert sort.is_sorted(data), "Stable shuffled sorted #{n} ints (order)"
  assert data.in_order, "Stable shuffled sorted #{n} ints (stability)"
  # sorted reversed
  for i in 0...n { data.d[i].a = n - i }
  data.init_b!
  sort.stable(data)
  assert sort.is_sorted(data), "Stable didn't sort #{n} ints"
  assert data.in_order, "Stable wasn't stable on #{n} ints"
}

# --- search_test.go ---

def search_data -> [Int] {
  [-10, -5, 0, 1, 2, 3, 5, 7, 11, 100, 100, 100, 1000, 10000]
}

test "Search" {
  data = search_data
  tests: [(Str, Int, (Int) -> Bool, Int)] = [
    ("empty", 0, ->(_i: Int) -> Bool { false }, 0),
    ("1 1", 1, ->(i: Int) -> Bool { i >= 1 }, 1),
    ("1 true", 1, ->(_i: Int) -> Bool { true }, 0),
    ("1 false", 1, ->(_i: Int) -> Bool { false }, 1),
    ("1e9 991", 1000000000, ->(i: Int) -> Bool { i >= 991 }, 991),
    ("1e9 true", 1000000000, ->(_i: Int) -> Bool { true }, 0),
    ("1e9 false", 1000000000, ->(_i: Int) -> Bool { false }, 1000000000),
    ("data -20", data.size, ->(i: Int) -> Bool { data[i] >= -20 }, 0),
    ("data -10", data.size, ->(i: Int) -> Bool { data[i] >= -10 }, 0),
    ("data -9", data.size, ->(i: Int) -> Bool { data[i] >= -9 }, 1),
    ("data -6", data.size, ->(i: Int) -> Bool { data[i] >= -6 }, 1),
    ("data -5", data.size, ->(i: Int) -> Bool { data[i] >= -5 }, 1),
    ("data 3", data.size, ->(i: Int) -> Bool { data[i] >= 3 }, 5),
    ("data 11", data.size, ->(i: Int) -> Bool { data[i] >= 11 }, 8),
    ("data 99", data.size, ->(i: Int) -> Bool { data[i] >= 99 }, 9),
    ("data 100", data.size, ->(i: Int) -> Bool { data[i] >= 100 }, 9),
    ("data 101", data.size, ->(i: Int) -> Bool { data[i] >= 101 }, 12),
    ("data 10000", data.size, ->(i: Int) -> Bool { data[i] >= 10000 }, 13),
    ("data 10001", data.size, ->(i: Int) -> Bool { data[i] >= 10001 }, 14),
    ("descending a", 7, ->(i: Int) -> Bool { [99, 99, 59, 42, 7, 0, -1, -1][i] <= 7 }, 4),
    ("descending 7", 1000000000, ->(i: Int) -> Bool { 1000000000 - i <= 7 }, 1000000000 - 7),
    ("overflow", 2000000000, ->(_i: Int) -> Bool { false }, 2000000000),
  ]
  for e in tests {
    assert sort.search(e[1], e[2]) == e[3], "#{e[0]}: expected index #{e[3]}; got #{sort.search(e[1], e[2])}"
  }
}

test "Find" {
  str1 = ["foo"]
  str2 = ["ab", "ca"]
  str3 = ["mo", "qo", "vo"]
  str4 = ["ab", "ad", "ca", "xy"]
  # slice with repeating elements
  str_repeats = ["ba", "ca", "da", "da", "da", "ka", "ma", "ma", "ta"]
  # slice with all element equal
  str_same = ["xx", "xx", "xx"]
  empty: [Str] = []
  tests: [([Str], Str, Int, Bool)] = [
    (empty, "foo", 0, false),
    (empty, "", 0, false),
    (str1, "foo", 0, true),
    (str1, "bar", 0, false),
    (str1, "zx", 1, false),
    (str2, "aa", 0, false),
    (str2, "ab", 0, true),
    (str2, "ad", 1, false),
    (str2, "ca", 1, true),
    (str2, "ra", 2, false),
    (str3, "bb", 0, false),
    (str3, "mo", 0, true),
    (str3, "nb", 1, false),
    (str3, "qo", 1, true),
    (str3, "tr", 2, false),
    (str3, "vo", 2, true),
    (str3, "xr", 3, false),
    (str4, "aa", 0, false),
    (str4, "ab", 0, true),
    (str4, "ac", 1, false),
    (str4, "ad", 1, true),
    (str4, "ax", 2, false),
    (str4, "ca", 2, true),
    (str4, "cc", 3, false),
    (str4, "dd", 3, false),
    (str4, "xy", 3, true),
    (str4, "zz", 4, false),
    (str_repeats, "da", 2, true),
    (str_repeats, "db", 5, false),
    (str_repeats, "ma", 6, true),
    (str_repeats, "mb", 8, false),
    (str_same, "xx", 0, true),
    (str_same, "ab", 0, false),
    (str_same, "zz", 3, false),
  ]
  for tt in tests {
    d = tt[0]
    target = tt[1]
    assert_eq sort.find(d.size) { |i| strings.compare(target, d[i]) }, (tt[2], tt[3])
  }
}

# The binary logarithm of x, rounded up to the next integer.
def log2(x: Int) -> Int {
  return 0 if x < 1
  n = 0
  v = x - 1
  while v > 0 {
    n += 1
    v = v >> 1
  }
  n
}

test "SearchEfficiency" {
  n = 100
  step = 1
  for _exp in 2...10 {
    # n == 10**exp, step == 10**(exp-2)
    max = log2(n)
    x = 0
    while x < n {
      count = [0]
      i = sort.search(n) { |i|
        count[0] += 1
        i >= x
      }
      assert i == x, "n = #{n}: expected index #{x}; got #{i}"
      assert count[0] <= max, "n = #{n}, x = #{x}: expected <= #{max} calls; got #{count[0]}"
      x += step
    }
    n *= 10
    step *= 10
  }
}

# Smoke tests for convenience wrappers - not comprehensive.
test "SearchWrappers" {
  data = search_data
  fdata = [-3.14, 0.0, 1.0, 2.0, 1000.7]
  sdata = ["f", "foo", "foobar", "x"]
  tests = [
    ("SearchInts", sort.search_ints(data, 11), 8),
    ("SearchFloat64s", sort.search_float64s(fdata, 2.1), 4),
    ("SearchStrings", sort.search_strings(sdata, ""), 0),
    ("IntSlice.Search", sort.IntSlice.new(data).search(0), 2),
    ("Float64Slice.Search", sort.Float64Slice.new(fdata).search(2.0), 3),
    ("StringSlice.Search", sort.StringSlice.new(sdata).search("x"), 3),
  ]
  for e in tests {
    assert e[1] == e[2], "#{e[0]}: expected index #{e[2]}; got #{e[1]}"
  }
}

# Abstract exhaustive test: all sizes up to 100, all possible return values.
test "SearchExhaustive" {
  for size in 0..100 {
    for targ in 0..size {
      i = sort.search(size) { |i| i >= targ }
      assert i == targ, "search(#{size}, #{targ}) = #{i}"
    }
  }
}

# Abstract exhaustive test for find: for each size, the (unmaterialized)
# sequence 2, 4, ... size * 2, and every integer from 1 to size * 2 + 1.
test "FindExhaustive" {
  for size in 0..100 {
    for x in 1..size * 2 + 1 {
      pos, found = sort.find(size) { |i| x - (i + 1) * 2 }
      want_pos = x % 2 == 0 ? x / 2 - 1 : x / 2
      want_found = x % 2 == 0
      assert found == want_found && pos == want_pos, "find(#{size}, #{x}): got (#{pos}, #{found}), want (#{want_pos}, #{want_found})"
    }
  }
}
