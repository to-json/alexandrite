# GENERATED by std/slices/gen_sort.py from sort.tmpl; do not edit.
# Sorting kernels: less-function variant.

# Insertion sort. Stable: an element moves past only strictly greater ones.
def insertion_sort_less[T](xs: [T], lo: Int, hi: Int, less: (T, T) -> Bool) {
  i = lo + 1
  while i < hi {
    v = xs[i]
    j = i
    while j > lo && less(v, xs[j - 1]) {
      xs[j] = xs[j - 1]
      j -= 1
    }
    xs[j] = v
    i += 1
  }
}

def sift_down_less[T](xs: [T], lo: Int, first: Int, n: Int, less: (T, T) -> Bool) {
  root = first
  while true {
    child = 2 * root + 1
    break if child >= n
    child += 1 if child + 1 < n && less(xs[lo + child], xs[lo + child + 1])
    break if !less(xs[lo + root], xs[lo + child])
    t = xs[lo + root]
    xs[lo + root] = xs[lo + child]
    xs[lo + child] = t
    root = child
  }
}

# The fallback that bounds the worst case at O(n log n).
def heap_sort_less[T](xs: [T], lo: Int, hi: Int, less: (T, T) -> Bool) {
  n = hi - lo
  i = (n - 1) / 2
  while i >= 0 {
    sift_down_less(xs, lo, i, n, less)
    i -= 1
  }
  i = n - 1
  while i >= 1 {
    t = xs[lo]
    xs[lo] = xs[lo + i]
    xs[lo + i] = t
    sift_down_less(xs, lo, 0, i, less)
    i -= 1
  }
}

# The index of the median of xs[a], xs[b], xs[c].
def median3_less[T](xs: [T], a: Int, b: Int, c: Int, less: (T, T) -> Bool) -> Int {
  if less(xs[a], xs[b]) {
    return b if less(xs[b], xs[c])
    return c if less(xs[a], xs[c])
    return a
  }
  return a if less(xs[a], xs[c])
  return c if less(xs[b], xs[c])
  b
}

# Moves a median-of-3 (median of medians for long ranges) pivot to xs[lo].
def choose_pivot_less[T](xs: [T], lo: Int, hi: Int, less: (T, T) -> Bool) {
  n = hi - lo
  m = lo + n / 2
  p = 0
  if n > 100 {
    s = n / 8
    a = median3_less(xs, lo, lo + s, lo + 2 * s, less)
    b = median3_less(xs, m - s, m, m + s, less)
    c = median3_less(xs, hi - 1 - 2 * s, hi - 1 - s, hi - 1, less)
    p = median3_less(xs, a, b, c, less)
  } else {
    p = median3_less(xs, lo, m, hi - 1, less)
  }
  t = xs[lo]
  xs[lo] = xs[p]
  xs[p] = t
}

# Introsort: Hoare-partition quicksort (equal keys stop both scans, so runs of
# duplicates split evenly), insertion sort for short ranges, heapsort when the
# recursion gets deeper than 2 log2 n. Recurses into the shorter side.
def quick_sort_less[T](xs: [T], lo: Int, hi: Int, limit: Int, less: (T, T) -> Bool) -> Unit {
  while hi - lo > 12 {
    if limit == 0 {
      heap_sort_less(xs, lo, hi, less)
      return
    }
    limit -= 1
    choose_pivot_less(xs, lo, hi, less)
    pv = xs[lo]
    i = lo - 1
    j = hi
    while true {
      i += 1
      while less(xs[i], pv) { i += 1 }
      j -= 1
      while less(pv, xs[j]) { j -= 1 }
      break if i >= j
      t = xs[i]
      xs[i] = xs[j]
      xs[j] = t
    }
    if j + 1 - lo < hi - j - 1 {
      quick_sort_less(xs, lo, j + 1, limit, less)
      lo = j + 1
    } else {
      quick_sort_less(xs, j + 1, hi, limit, less)
      hi = j + 1
    }
  }
  insertion_sort_less(xs, lo, hi, less)
}

def reverse_range_less[T](xs: [T], lo: Int, hi: Int) {
  i = lo
  j = hi - 1
  while i < j {
    t = xs[i]
    xs[i] = xs[j]
    xs[j] = t
    i += 1
    j -= 1
  }
}

# Sorts xs[lo...hi]: O(n) when it is already sorted or strictly descending.
def sort_range_less[T](xs: [T], lo: Int, hi: Int, less: (T, T) -> Bool) {
  return if hi - lo < 2
  i = lo + 1
  while i < hi && !less(xs[i], xs[i - 1]) { i += 1 }
  return if i == hi
  j = lo + 1
  while j < hi && less(xs[j], xs[j - 1]) { j += 1 }
  if j == hi {
    reverse_range_less(xs, lo, hi)
    return
  }
  limit = 0
  n = hi - lo
  while n > 0 {
    limit += 2
    n = n / 2
  }
  quick_sort_less(xs, lo, hi, limit, less)
}

# Stable merge sort; `buf` is scratch space the size of xs.
def merge_sort_less[T](xs: [T], buf: [T], lo: Int, hi: Int, less: (T, T) -> Bool) -> Unit {
  if hi - lo <= 12 {
    insertion_sort_less(xs, lo, hi, less)
    return
  }
  mid = lo + (hi - lo) / 2
  merge_sort_less(xs, buf, lo, mid, less)
  merge_sort_less(xs, buf, mid, hi, less)
  return if !less(xs[mid], xs[mid - 1])
  copy(buf[lo...mid], xs[lo...mid])
  i = lo
  j = mid
  k = lo
  while i < mid && j < hi {
    if less(xs[j], buf[i]) {
      xs[k] = xs[j]
      j += 1
    } else {
      xs[k] = buf[i]
      i += 1
    }
    k += 1
  }
  while i < mid {
    xs[k] = buf[i]
    i += 1
    k += 1
  }
}

def stable_sort_less[T](xs: [T], less: (T, T) -> Bool) {
  return if xs.size < 2
  buf = xs.dup
  merge_sort_less(xs, buf, 0, xs.size, less)
}
