struct Person {
  name: Str
  age: Int
}

def nan -> Float {
  z = 0.0
  z / z
}

def rand_ints(n: Int, m: Int, seed: Int) -> [Int] {
  out: [Int] = []
  x = seed
  for _ in 0...n {
    x = (x * 1103515245 + 12345) % 2147483648
    out << (x / 16) % m
  }
  out
}

test "ints, strings, float64s" {
  a = [5, 2, 9, 1, 5, 6]
  ints(a)
  assert slices.equal(a, [1, 2, 5, 5, 6, 9])
  assert ints_are_sorted(a)
  assert !ints_are_sorted([2, 1])
  s = ["pear", "apple", "fig", "apple"]
  strings(s)
  assert slices.equal(s, ["apple", "apple", "fig", "pear"])
  assert strings_are_sorted(s)
  f = [2.5, nan, -1.0, 0.0]
  float64s(f)
  assert f[0] != f[0]
  assert_eq f[1], -1.0
  assert_eq f[3], 2.5
  assert float64s_are_sorted(f)
  e: [Int] = []
  ints(e)
  assert ints_are_sorted(e)
}

test "search" {
  xs = [1, 3, 5, 7, 9]
  assert_eq search(xs.size, ->(i: Int) -> Bool { xs[i] >= 5 }), 2
  assert_eq search(xs.size, ->(i: Int) -> Bool { xs[i] >= 6 }), 3
  assert_eq search(xs.size, ->(i: Int) -> Bool { xs[i] >= 100 }), 5
  assert_eq search(xs.size, ->(i: Int) -> Bool { xs[i] >= -100 }), 0
  assert_eq search(0, ->(i: Int) -> Bool { true }), 0
  assert_eq search(100, ->(i: Int) -> Bool { i * i >= 2000 }), 45
}

test "search_ints, search_strings, search_float64s" {
  xs = [1, 3, 3, 3, 9]
  assert_eq search_ints(xs, 3), 1
  assert_eq search_ints(xs, 4), 4
  assert_eq search_ints(xs, 0), 0
  assert_eq search_ints(xs, 10), 5
  empty: [Int] = []
  assert_eq search_ints(empty, 1), 0
  ss = ["a", "c", "e"]
  assert_eq search_strings(ss, "c"), 1
  assert_eq search_strings(ss, "d"), 2
  assert_eq search_strings(ss, "z"), 3
  assert_eq search_float64s([1.0, 2.0, 3.0], 2.5), 2
}

test "slice and slice_stable" {
  people: [Person] = []
  r = rand_ints(300, 8, 5)
  for i in 0...300 {
    people << Person.new(name: "p#{i}", age: r[i])
  }
  a = slices.clone(people)
  slice(a) { |i, j| a[i].age < a[j].age }
  assert slice_is_sorted(a) { |i, j| a[i].age < a[j].age }
  assert_eq a.size, 300
  b = slices.clone(people)
  slice_stable(b) { |i, j| b[i].age < b[j].age }
  assert slice_is_sorted(b) { |i, j| b[i].age < b[j].age }
  for i in 1...b.size {
    if b[i - 1].age == b[i].age {
      n0 = b[i - 1].name[1..].to_i
      n1 = b[i].name[1..].to_i
      assert n0 < n1
    }
  }
  assert !slice_is_sorted(people) { |i, j| people[i].age < people[j].age }
  c = [3, 1, 2]
  slice(c) { |i, j| c[i] > c[j] }
  assert slices.equal(c, [3, 2, 1])
  e: [Int] = []
  slice(e) { |i, j| e[i] > e[j] }
  slice_stable(e) { |i, j| e[i] > e[j] }
  assert slice_is_sorted(e) { |i, j| e[i] > e[j] }
}

test "slice on big inputs" {
  for n in [13, 100, 1000, 20000] {
    xs = rand_ints(n, 1000, n)
    slice(xs) { |i, j| xs[i] < xs[j] }
    assert ints_are_sorted(xs)
    ys = rand_ints(n, 1000000, n + 1)
    slice_stable(ys) { |i, j| ys[i] < ys[j] }
    assert ints_are_sorted(ys)
  }
}

test "method sugar from slices" {
  xs = [4, 8, 15, 16, 23, 42]
  assert_eq xs.index(15), 2
  assert xs.contains(42)
  assert !xs.contains(1)
  assert xs.binary_search(16)[1]
  assert_eq xs.binary_search(17)[0], 4
  assert xs.is_sorted
  ys = xs.clone
  ys.reverse!
  assert_eq ys[0], 42
  assert_eq xs[0], 4
  zs = xs.clone.delete(1, 3)
  assert slices.equal(zs, [4, 16, 23, 42])
  assert_eq ["b", "a"].index("a"), 1
  fs = [1.5, 2.5]
  assert fs.contains(2.5)
  assert_eq xs.index_func(->(x: Int) -> Bool { x > 10 }), 2
  assert xs.equal([4, 8, 15, 16, 23, 42])
  assert_eq xs.compare([4, 9]), -1
}
