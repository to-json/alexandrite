  assert_eq search_float64s([nan, ninf, nz, 1.0, 2.5, inf], 1.0), 3
  assert_eq search_float64s([nan, ninf, nz, 1.0, 2.5, inf], 2.5), 4
  assert_eq search_float64s([nan, ninf, nz, 1.0, 2.5, inf], inf), 5
  assert_eq search_float64s(vec_floats(), nan), 0
  assert_eq search_float64s(vec_floats(), ninf), 0
  assert_eq search_float64s(vec_floats(), -2.5), 0
  assert_eq search_float64s(vec_floats(), -1.0), 0
  assert_eq search_float64s(vec_floats(), nz), 0
  assert_eq search_float64s(vec_floats(), 0.0), 0
  assert_eq search_float64s(vec_floats(), 1.0), 0
  assert_eq search_float64s(vec_floats(), 2.5), 0
  assert_eq search_float64s(vec_floats(), inf), 0
  assert_eq search_float64s([nan, ninf, -2.5, -1.0, -1.0, 0.0], nan), 6
  assert_eq search_float64s([nan, ninf, -2.5, -1.0, -1.0, 0.0], ninf), 1
  assert_eq search_float64s([nan, ninf, -2.5, -1.0, -1.0, 0.0], -2.5), 2
  assert_eq search_float64s([nan, ninf, -2.5, -1.0, -1.0, 0.0], -1.0), 3
  assert_eq search_float64s([nan, ninf, -2.5, -1.0, -1.0, 0.0], nz), 5
  assert_eq search_float64s([nan, ninf, -2.5, -1.0, -1.0, 0.0], 0.0), 5
  assert_eq search_float64s([nan, ninf, -2.5, -1.0, -1.0, 0.0], 1.0), 6
  assert_eq search_float64s([nan, ninf, -2.5, -1.0, -1.0, 0.0], 2.5), 6
  assert_eq search_float64s([nan, ninf, -2.5, -1.0, -1.0, 0.0], inf), 6
  assert_eq search_float64s([ninf, nz, inf], nan), 3
  assert_eq search_float64s([ninf, nz, inf], ninf), 0
  assert_eq search_float64s([ninf, nz, inf], -2.5), 1
  assert_eq search_float64s([ninf, nz, inf], -1.0), 1
  assert_eq search_float64s([ninf, nz, inf], nz), 1
  assert_eq search_float64s([ninf, nz, inf], 0.0), 1
  assert_eq search_float64s([ninf, nz, inf], 1.0), 2
  assert_eq search_float64s([ninf, nz, inf], 2.5), 2
  assert_eq search_float64s([ninf, nz, inf], inf), 2
  assert_eq search_float64s(vec_floats(), nan), 0
  assert_eq search_float64s(vec_floats(), ninf), 0
  assert_eq search_float64s(vec_floats(), -2.5), 0
  assert_eq search_float64s(vec_floats(), -1.0), 0
  assert_eq search_float64s(vec_floats(), nz), 0
  assert_eq search_float64s(vec_floats(), 0.0), 0
  assert_eq search_float64s(vec_floats(), 1.0), 0
  assert_eq search_float64s(vec_floats(), 2.5), 0
  assert_eq search_float64s(vec_floats(), inf), 0
  assert_eq search_float64s([nan, ninf, -1.0, nz, nz], nan), 5
  assert_eq search_float64s([nan, ninf, -1.0, nz, nz], ninf), 1
  assert_eq search_float64s([nan, ninf, -1.0, nz, nz], -2.5), 2
  assert_eq search_float64s([nan, ninf, -1.0, nz, nz], -1.0), 2
}

