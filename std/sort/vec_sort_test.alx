  assert_eq search_ints([-3, -2, -2, -1, -1, 0, 1, 4, 6], -4), 0
  assert_eq IntSlice.new([-3, -2, -2, -1, -1, 0, 1, 4, 6]).search(-4), 0
  assert_eq find(9) { |i| -4 - [-3, -2, -2, -1, -1, 0, 1, 4, 6][i] }, (0, false)
}

