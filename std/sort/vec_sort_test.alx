  assert_eq IntSlice.new([-3, -3, -2, -2, -1, 1, 1, 4]).search(1), 5
  assert_eq find(8) { |i| 1 - [-3, -3, -2, -2, -1, 1, 1, 4][i] }, (5, true)
  assert_eq search_ints([-3, -3, -2, -2, -1, 1, 1, 4], 4), 7
  assert_eq IntSlice.new([-3, -3, -2, -2, -1, 1, 1, 4]).search(4), 7
  assert_eq find(8) { |i| 4 - [-3, -3, -2, -2, -1, 1, 1, 4][i] }, (7, true)
  assert_eq search_ints([-3, -3, -2, -2, -1, 1, 1, 4], 7), 8
  assert_eq IntSlice.new([-3, -3, -2, -2, -1, 1, 1, 4]).search(7), 8
  assert_eq find(8) { |i| 7 - [-3, -3, -2, -2, -1, 1, 1, 4][i] }, (8, false)
  assert_eq search_ints([-1, 2, 2, 2, 2, 3, 5], -4), 0
  assert_eq IntSlice.new([-1, 2, 2, 2, 2, 3, 5]).search(-4), 0
  assert_eq find(7) { |i| -4 - [-1, 2, 2, 2, 2, 3, 5][i] }, (0, false)
  assert_eq search_ints([-1, 2, 2, 2, 2, 3, 5], -2), 0
  assert_eq IntSlice.new([-1, 2, 2, 2, 2, 3, 5]).search(-2), 0
  assert_eq find(7) { |i| -2 - [-1, 2, 2, 2, 2, 3, 5][i] }, (0, false)
  assert_eq search_ints([-1, 2, 2, 2, 2, 3, 5], 1), 1
  assert_eq IntSlice.new([-1, 2, 2, 2, 2, 3, 5]).search(1), 1
  assert_eq find(7) { |i| 1 - [-1, 2, 2, 2, 2, 3, 5][i] }, (1, false)
  assert_eq search_ints([-1, 2, 2, 2, 2, 3, 5], 4), 6
  assert_eq IntSlice.new([-1, 2, 2, 2, 2, 3, 5]).search(4), 6
}

