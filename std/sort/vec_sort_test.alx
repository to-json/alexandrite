  assert_eq vec_sort_reverse([1000, 1001, 2, 3, 4, 5, 6, 1007, 8, 9, 1010, 11, 12, 1013, 1014, 1015, 1016, 1017]), [1010, 1001, 1017, 1016, 1015, 1014, 1013, 1007, 1000, 8, 9, 11, 12, 6, 5, 4, 3, 2]
  assert_eq vec_sort([4000, 4001, 6002, 2003, 4, 4005, 3006, 2007, 2008, 3009, 10, 3011, 6012, 13, 14, 6015, 4016, 1017]), [10, 14, 13, 4, 1017, 2008, 2007, 2003, 3006, 3009, 3011, 4000, 4005, 4016, 4001, 6012, 6002, 6015]
