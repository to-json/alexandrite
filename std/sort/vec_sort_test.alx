  assert_eq search_float64s([-1.0, 0.0, 0.0, 1.0, inf, inf], 2.5), 4
  assert_eq search_float64s([-1.0, 0.0, 0.0, 1.0, inf, inf], inf), 4
  assert_eq search_float64s([nan, ninf, 0.0, nz, inf], nan), 5
  assert_eq search_float64s([nan, ninf, 0.0, nz, inf], ninf), 1
  assert_eq search_float64s([nan, ninf, 0.0, nz, inf], -2.5), 2
  assert_eq search_float64s([nan, ninf, 0.0, nz, inf], -1.0), 2
  assert_eq search_float64s([nan, ninf, 0.0, nz, inf], nz), 2
  assert_eq search_float64s([nan, ninf, 0.0, nz, inf], 0.0), 2
  assert_eq search_float64s([nan, ninf, 0.0, nz, inf], 1.0), 4
  assert_eq search_float64s([nan, ninf, 0.0, nz, inf], 2.5), 4
  assert_eq search_float64s([nan, ninf, 0.0, nz, inf], inf), 4
  assert_eq search_float64s([nan, -1.0, 0.0, 1.0, 2.5, inf], nan), 6
  assert_eq search_float64s([nan, -1.0, 0.0, 1.0, 2.5, inf], ninf), 1
  assert_eq search_float64s([nan, -1.0, 0.0, 1.0, 2.5, inf], -2.5), 1
  assert_eq search_float64s([nan, -1.0, 0.0, 1.0, 2.5, inf], -1.0), 1
  assert_eq search_float64s([nan, -1.0, 0.0, 1.0, 2.5, inf], nz), 2
  assert_eq search_float64s([nan, -1.0, 0.0, 1.0, 2.5, inf], 0.0), 2
  assert_eq search_float64s([nan, -1.0, 0.0, 1.0, 2.5, inf], 1.0), 3
  assert_eq search_float64s([nan, -1.0, 0.0, 1.0, 2.5, inf], 2.5), 4
  assert_eq search_float64s([nan, -1.0, 0.0, 1.0, 2.5, inf], inf), 5
  assert_eq search_float64s([2.5], nan), 1
  assert_eq search_float64s([2.5], ninf), 0
  assert_eq search_float64s([2.5], -2.5), 0
  assert_eq search_float64s([2.5], -1.0), 0
  assert_eq search_float64s([2.5], nz), 0
  assert_eq search_float64s([2.5], 0.0), 0
  assert_eq search_float64s([2.5], 1.0), 0
  assert_eq search_float64s([2.5], 2.5), 0
  assert_eq search_float64s([2.5], inf), 1
  assert_eq search_float64s([nz, nz, 1.0, 2.5, 2.5, inf], nan), 6
  assert_eq search_float64s([nz, nz, 1.0, 2.5, 2.5, inf], ninf), 0
  assert_eq search_float64s([nz, nz, 1.0, 2.5, 2.5, inf], -2.5), 0
  assert_eq search_float64s([nz, nz, 1.0, 2.5, 2.5, inf], -1.0), 0
