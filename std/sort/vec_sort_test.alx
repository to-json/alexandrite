  assert_eq vec_sort_reverse([1000, 1001, 2002, 1003, 2004, 1005, 6]), [2002, 2004, 1000, 1001, 1003, 1005, 6]
  assert_eq vec_sort([6000, 5001, 7002, 4003, 6004, 5, 3006]), [5, 3006, 4003, 5001, 6000, 6004, 7002]
  assert_eq vec_sort_reverse([6000, 5001, 7002, 4003, 6004, 5, 3006]), [7002, 6000, 6004, 5001, 4003, 3006, 5]
  assert_eq vec_sort([1000, 1, 1002, 1003, 4, 5, 6, 1007]), [1, 4, 5, 6, 1000, 1002, 1003, 1007]
  assert_eq vec_sort_reverse([1000, 1, 1002, 1003, 4, 5, 6, 1007]), [1000, 1002, 1003, 1007, 1, 4, 5, 6]
