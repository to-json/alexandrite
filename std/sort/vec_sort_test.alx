  assert_eq search_float64s([ninf, ninf, -2.5, -1.0], nan), 4
  assert_eq search_float64s([ninf, ninf, -2.5, -1.0], ninf), 0
  assert_eq search_float64s([ninf, ninf, -2.5, -1.0], -2.5), 2
  assert_eq search_float64s([ninf, ninf, -2.5, -1.0], -1.0), 3
  assert_eq search_float64s([ninf, ninf, -2.5, -1.0], nz), 4
  assert_eq search_float64s([ninf, ninf, -2.5, -1.0], 0.0), 4
  assert_eq search_float64s([ninf, ninf, -2.5, -1.0], 1.0), 4
  assert_eq search_float64s([ninf, ninf, -2.5, -1.0], 2.5), 4
  assert_eq search_float64s([ninf, ninf, -2.5, -1.0], inf), 4
  assert_eq search_float64s([nan, 0.0, 0.0, 2.5], nan), 4
  assert_eq search_float64s([nan, 0.0, 0.0, 2.5], ninf), 1
  assert_eq search_float64s([nan, 0.0, 0.0, 2.5], -2.5), 1
  assert_eq search_float64s([nan, 0.0, 0.0, 2.5], -1.0), 1
  assert_eq search_float64s([nan, 0.0, 0.0, 2.5], nz), 1
  assert_eq search_float64s([nan, 0.0, 0.0, 2.5], 0.0), 1
  assert_eq search_float64s([nan, 0.0, 0.0, 2.5], 1.0), 3
  assert_eq search_float64s([nan, 0.0, 0.0, 2.5], 2.5), 3
  assert_eq search_float64s([nan, 0.0, 0.0, 2.5], inf), 4
  assert_eq search_float64s([nz, 1.0, 2.5, inf, inf, inf], nan), 6
  assert_eq search_float64s([nz, 1.0, 2.5, inf, inf, inf], ninf), 0
  assert_eq search_float64s([nz, 1.0, 2.5, inf, inf, inf], -2.5), 0
  assert_eq search_float64s([nz, 1.0, 2.5, inf, inf, inf], -1.0), 0
  assert_eq search_float64s([nz, 1.0, 2.5, inf, inf, inf], nz), 0
  assert_eq search_float64s([nz, 1.0, 2.5, inf, inf, inf], 0.0), 0
  assert_eq search_float64s([nz, 1.0, 2.5, inf, inf, inf], 1.0), 1
  assert_eq search_float64s([nz, 1.0, 2.5, inf, inf, inf], 2.5), 2
  assert_eq search_float64s([nz, 1.0, 2.5, inf, inf, inf], inf), 3
  assert_eq search_float64s([nan, -2.5, -1.0, 0.0, 1.0, inf], nan), 6
  assert_eq search_float64s([nan, -2.5, -1.0, 0.0, 1.0, inf], ninf), 1
  assert_eq search_float64s([nan, -2.5, -1.0, 0.0, 1.0, inf], -2.5), 1
  assert_eq search_float64s([nan, -2.5, -1.0, 0.0, 1.0, inf], -1.0), 2
  assert_eq search_float64s([nan, -2.5, -1.0, 0.0, 1.0, inf], nz), 3
}

test "vectors: search 15" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
