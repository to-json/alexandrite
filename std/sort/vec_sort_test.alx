test "vectors: sort ties 2" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq vec_sort([13000, 10001, 3002, 12003, 15004, 9005, 2006, 9007, 1008, 4009, 10010, 7011, 5012, 11013, 9014, 15]), [15, 1008, 2006, 3002, 4009, 5012, 7011, 9005, 9007, 9014, 10010, 10001, 11013, 12003, 13000, 15004]
  assert_eq vec_sort_reverse([13000, 10001, 3002, 12003, 15004, 9005, 2006, 9007, 1008, 4009, 10010, 7011, 5012, 11013, 9014, 15]), [15004, 13000, 12003, 11013, 10010, 10001, 9014, 9005, 9007, 7011, 5012, 4009, 3002, 2006, 1008, 15]
  assert_eq vec_sort([0, 1001, 2, 1003, 1004, 1005, 1006, 7, 1008, 1009, 1010, 1011, 12, 1013, 1014, 15, 1016]), [7, 15, 2, 12, 0, 1004, 1006, 1005, 1008, 1009, 1010, 1011, 1003, 1013, 1014, 1001, 1016]
  assert_eq vec_sort_reverse([0, 1001, 2, 1003, 1004, 1005, 1006, 7, 1008, 1009, 1010, 1011, 12, 1013, 1014, 15, 1016]), [1008, 1009, 1016, 1003, 1004, 1005, 1006, 1014, 1001, 1010, 1013, 1011, 12, 0, 7, 15, 2]
  assert_eq vec_sort([4000, 1001, 2002, 1003, 3004, 1005, 6, 4007, 3008, 9, 5010, 11, 5012, 4013, 4014, 5015, 3016]), [9, 11, 6, 1001, 1003, 1005, 2002, 3008, 3004, 3016, 4000, 4007, 4013, 4014, 5010, 5012, 5015]
  assert_eq vec_sort_reverse([4000, 1001, 2002, 1003, 3004, 1005, 6, 4007, 3008, 9, 5010, 11, 5012, 4013, 4014, 5015, 3016]), [5015, 5012, 5010, 4007, 4014, 4013, 4000, 3004, 3008, 3016, 2002, 1005, 1003, 1001, 9, 6, 11]
