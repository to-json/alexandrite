  assert_eq find(5) { |i| 4 - [-2, -1, -1, 1, 4][i] }, (4, true)
  assert_eq search_ints([-2, -1, -1, 1, 4], 7), 5
  assert_eq IntSlice.new([-2, -1, -1, 1, 4]).search(7), 5
  assert_eq find(5) { |i| 7 - [-2, -1, -1, 1, 4][i] }, (5, false)
  assert_eq search_ints([-3, 0, 1, 3, 3, 4, 4, 6], -4), 0
  assert_eq IntSlice.new([-3, 0, 1, 3, 3, 4, 4, 6]).search(-4), 0
  assert_eq find(8) { |i| -4 - [-3, 0, 1, 3, 3, 4, 4, 6][i] }, (0, false)
  assert_eq search_ints([-3, 0, 1, 3, 3, 4, 4, 6], -1), 1
  assert_eq IntSlice.new([-3, 0, 1, 3, 3, 4, 4, 6]).search(-1), 1
  assert_eq find(8) { |i| -1 - [-3, 0, 1, 3, 3, 4, 4, 6][i] }, (1, false)
}

test "vectors: search 13" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq search_ints([-3, 0, 1, 3, 3, 4, 4, 6], 2), 3
  assert_eq IntSlice.new([-3, 0, 1, 3, 3, 4, 4, 6]).search(2), 3
