test "vectors: search 1" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq search_ints([-3, -3, -1, 0, 1, 1, 3, 6, 6], -4), 0
  assert_eq IntSlice.new([-3, -3, -1, 0, 1, 1, 3, 6, 6]).search(-4), 0
  assert_eq find(9) { |i| -4 - [-3, -3, -1, 0, 1, 1, 3, 6, 6][i] }, (0, false)
  assert_eq search_ints([-3, -3, -1, 0, 1, 1, 3, 6, 6], -3), 0
  assert_eq IntSlice.new([-3, -3, -1, 0, 1, 1, 3, 6, 6]).search(-3), 0
  assert_eq find(9) { |i| -3 - [-3, -3, -1, 0, 1, 1, 3, 6, 6][i] }, (0, true)
  assert_eq search_ints([-3, -3, -1, 0, 1, 1, 3, 6, 6], -2), 2
  assert_eq IntSlice.new([-3, -3, -1, 0, 1, 1, 3, 6, 6]).search(-2), 2
  assert_eq find(9) { |i| -2 - [-3, -3, -1, 0, 1, 1, 3, 6, 6][i] }, (2, false)
  assert_eq search_ints([-3, -3, -1, 0, 1, 1, 3, 6, 6], 0), 3
  assert_eq IntSlice.new([-3, -3, -1, 0, 1, 1, 3, 6, 6]).search(0), 3
  assert_eq find(9) { |i| 0 - [-3, -3, -1, 0, 1, 1, 3, 6, 6][i] }, (3, true)
  assert_eq search_ints([-3, -3, -1, 0, 1, 1, 3, 6, 6], 1), 4
  assert_eq IntSlice.new([-3, -3, -1, 0, 1, 1, 3, 6, 6]).search(1), 4
  assert_eq find(9) { |i| 1 - [-3, -3, -1, 0, 1, 1, 3, 6, 6][i] }, (4, true)
  assert_eq search_ints([-3, -3, -1, 0, 1, 1, 3, 6, 6], 2), 6
  assert_eq IntSlice.new([-3, -3, -1, 0, 1, 1, 3, 6, 6]).search(2), 6
  assert_eq find(9) { |i| 2 - [-3, -3, -1, 0, 1, 1, 3, 6, 6][i] }, (6, false)
  assert_eq search_ints([-3, -3, -1, 0, 1, 1, 3, 6, 6], 5), 7
  assert_eq IntSlice.new([-3, -3, -1, 0, 1, 1, 3, 6, 6]).search(5), 7
  assert_eq find(9) { |i| 5 - [-3, -3, -1, 0, 1, 1, 3, 6, 6][i] }, (7, false)
  assert_eq search_ints([-3, -3, -1, 0, 1, 1, 3, 6, 6], 6), 7
  assert_eq IntSlice.new([-3, -3, -1, 0, 1, 1, 3, 6, 6]).search(6), 7
  assert_eq find(9) { |i| 6 - [-3, -3, -1, 0, 1, 1, 3, 6, 6][i] }, (7, true)
  assert_eq search_ints([-3, -3, -1, 0, 1, 1, 3, 6, 6], 7), 9
  assert_eq IntSlice.new([-3, -3, -1, 0, 1, 1, 3, 6, 6]).search(7), 9
  assert_eq find(9) { |i| 7 - [-3, -3, -1, 0, 1, 1, 3, 6, 6][i] }, (9, false)
  assert_eq search_ints([-3, -3, -1, 0, 1, 1, 3, 6, 6], 8), 9
  assert_eq IntSlice.new([-3, -3, -1, 0, 1, 1, 3, 6, 6]).search(8), 9
  assert_eq find(9) { |i| 8 - [-3, -3, -1, 0, 1, 1, 3, 6, 6][i] }, (9, false)
  assert_eq search_ints([-2, 0, 0, 1, 2, 4, 6], -4), 0
  assert_eq IntSlice.new([-2, 0, 0, 1, 2, 4, 6]).search(-4), 0
  assert_eq find(7) { |i| -4 - [-2, 0, 0, 1, 2, 4, 6][i] }, (0, false)
  assert_eq search_ints([-2, 0, 0, 1, 2, 4, 6], -1), 1
  assert_eq IntSlice.new([-2, 0, 0, 1, 2, 4, 6]).search(-1), 1
  assert_eq find(7) { |i| -1 - [-2, 0, 0, 1, 2, 4, 6][i] }, (1, false)
  assert_eq search_ints([-2, 0, 0, 1, 2, 4, 6], 2), 4
  assert_eq IntSlice.new([-2, 0, 0, 1, 2, 4, 6]).search(2), 4
  assert_eq find(7) { |i| 2 - [-2, 0, 0, 1, 2, 4, 6][i] }, (4, true)
  assert_eq search_ints([-2, 0, 0, 1, 2, 4, 6], 5), 6
  assert_eq IntSlice.new([-2, 0, 0, 1, 2, 4, 6]).search(5), 6
  assert_eq find(7) { |i| 5 - [-2, 0, 0, 1, 2, 4, 6][i] }, (6, false)
  assert_eq search_ints([-2, 0, 0, 1, 2, 4, 6], 6), 6
  assert_eq IntSlice.new([-2, 0, 0, 1, 2, 4, 6]).search(6), 6
  assert_eq find(7) { |i| 6 - [-2, 0, 0, 1, 2, 4, 6][i] }, (6, true)
  assert_eq search_ints([-2, 0, 0, 1, 2, 4, 6], 8), 7
  assert_eq IntSlice.new([-2, 0, 0, 1, 2, 4, 6]).search(8), 7
  assert_eq find(7) { |i| 8 - [-2, 0, 0, 1, 2, 4, 6][i] }, (7, false)
  assert_eq search_ints([0, 5, 6], -4), 0
  assert_eq IntSlice.new([0, 5, 6]).search(-4), 0
  assert_eq find(3) { |i| -4 - [0, 5, 6][i] }, (0, false)
  assert_eq search_ints([0, 5, 6], -3), 0
  assert_eq IntSlice.new([0, 5, 6]).search(-3), 0
  assert_eq find(3) { |i| -3 - [0, 5, 6][i] }, (0, false)
  assert_eq search_ints([0, 5, 6], 0), 0
  assert_eq IntSlice.new([0, 5, 6]).search(0), 0
  assert_eq find(3) { |i| 0 - [0, 5, 6][i] }, (0, true)
  assert_eq search_ints([0, 5, 6], 3), 1
  assert_eq IntSlice.new([0, 5, 6]).search(3), 1
  assert_eq find(3) { |i| 3 - [0, 5, 6][i] }, (1, false)
  assert_eq search_ints([0, 5, 6], 6), 2
  assert_eq IntSlice.new([0, 5, 6]).search(6), 2
  assert_eq find(3) { |i| 6 - [0, 5, 6][i] }, (2, true)
  assert_eq search_ints([0, 5, 6], 7), 3
  assert_eq IntSlice.new([0, 5, 6]).search(7), 3
  assert_eq find(3) { |i| 7 - [0, 5, 6][i] }, (3, false)
  assert_eq search_ints([0, 5, 6], 8), 3
  assert_eq IntSlice.new([0, 5, 6]).search(8), 3
  assert_eq find(3) { |i| 8 - [0, 5, 6][i] }, (3, false)
  assert_eq search_ints([-3, 0, 0, 2, 2, 4, 4, 4, 5], -4), 0
  assert_eq IntSlice.new([-3, 0, 0, 2, 2, 4, 4, 4, 5]).search(-4), 0
  assert_eq find(9) { |i| -4 - [-3, 0, 0, 2, 2, 4, 4, 4, 5][i] }, (0, false)
  assert_eq search_ints([-3, 0, 0, 2, 2, 4, 4, 4, 5], -2), 1
  assert_eq IntSlice.new([-3, 0, 0, 2, 2, 4, 4, 4, 5]).search(-2), 1
  assert_eq find(9) { |i| -2 - [-3, 0, 0, 2, 2, 4, 4, 4, 5][i] }, (1, false)
  assert_eq search_ints([-3, 0, 0, 2, 2, 4, 4, 4, 5], 0), 1
  assert_eq IntSlice.new([-3, 0, 0, 2, 2, 4, 4, 4, 5]).search(0), 1
  assert_eq find(9) { |i| 0 - [-3, 0, 0, 2, 2, 4, 4, 4, 5][i] }, (1, true)
  assert_eq search_ints([-3, 0, 0, 2, 2, 4, 4, 4, 5], 3), 5
  assert_eq IntSlice.new([-3, 0, 0, 2, 2, 4, 4, 4, 5]).search(3), 5
  assert_eq find(9) { |i| 3 - [-3, 0, 0, 2, 2, 4, 4, 4, 5][i] }, (5, false)
  assert_eq search_ints([-3, 0, 0, 2, 2, 4, 4, 4, 5], 6), 9
  assert_eq IntSlice.new([-3, 0, 0, 2, 2, 4, 4, 4, 5]).search(6), 9
  assert_eq find(9) { |i| 6 - [-3, 0, 0, 2, 2, 4, 4, 4, 5][i] }, (9, false)
  assert_eq search_ints([-3, 0, 0, 2, 2, 4, 4, 4, 5], 7), 9
  assert_eq IntSlice.new([-3, 0, 0, 2, 2, 4, 4, 4, 5]).search(7), 9
  assert_eq find(9) { |i| 7 - [-3, 0, 0, 2, 2, 4, 4, 4, 5][i] }, (9, false)
  assert_eq search_ints([0, 1, 2, 4, 5], -4), 0
  assert_eq IntSlice.new([0, 1, 2, 4, 5]).search(-4), 0
  assert_eq find(5) { |i| -4 - [0, 1, 2, 4, 5][i] }, (0, false)
  assert_eq search_ints([0, 1, 2, 4, 5], -3), 0
  assert_eq IntSlice.new([0, 1, 2, 4, 5]).search(-3), 0
  assert_eq find(5) { |i| -3 - [0, 1, 2, 4, 5][i] }, (0, false)
  assert_eq search_ints([0, 1, 2, 4, 5], -1), 0
  assert_eq IntSlice.new([0, 1, 2, 4, 5]).search(-1), 0
  assert_eq find(5) { |i| -1 - [0, 1, 2, 4, 5][i] }, (0, false)
  assert_eq search_ints([0, 1, 2, 4, 5], 1), 1
  assert_eq IntSlice.new([0, 1, 2, 4, 5]).search(1), 1
  assert_eq find(5) { |i| 1 - [0, 1, 2, 4, 5][i] }, (1, true)
  assert_eq search_ints([0, 1, 2, 4, 5], 4), 3
}

test "vectors: search 2" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq IntSlice.new([0, 1, 2, 4, 5]).search(4), 3
  assert_eq find(5) { |i| 4 - [0, 1, 2, 4, 5][i] }, (3, true)
  assert_eq search_ints([0, 1, 2, 4, 5], 5), 4
  assert_eq IntSlice.new([0, 1, 2, 4, 5]).search(5), 4
