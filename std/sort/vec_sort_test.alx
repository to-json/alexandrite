test "vectors: sort patterns 1" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq vec_sort([0, 1001, 2, 1003, 4, 1005, 6, 1007, 8, 1009, 10, 1011, 12, 1013, 14, 1015, 16, 1017, 18, 1019]), [10, 18, 2, 16, 4, 0, 6, 14, 8, 12, 1005, 1011, 1009, 1013, 1007, 1015, 1003, 1017, 1001, 1019]
  assert_eq vec_slice([0, 1001, 2, 1003, 4, 1005, 6, 1007, 8, 1009, 10, 1011, 12, 1013, 14, 1015, 16, 1017, 18, 1019]), [10, 18, 2, 16, 4, 0, 6, 14, 8, 12, 1005, 1011, 1009, 1013, 1007, 1015, 1003, 1017, 1001, 1019]
  assert_eq vec_sort([0, 1001, 2002, 3003, 4004, 5, 1006, 2007, 3008, 4009, 10, 1011, 2012, 3013, 4014, 15, 1016, 2017, 3018, 4019]), [10, 5, 15, 0, 1001, 1016, 1006, 1011, 2007, 2012, 2017, 2002, 3018, 3008, 3003, 3013, 4009, 4014, 4004, 4019]
  assert_eq vec_slice([0, 1001, 2002, 3003, 4004, 5, 1006, 2007, 3008, 4009, 10, 1011, 2012, 3013, 4014, 15, 1016, 2017, 3018, 4019]), [10, 5, 15, 0, 1001, 1016, 1006, 1011, 2007, 2012, 2017, 2002, 3018, 3008, 3003, 3013, 4009, 4014, 4004, 4019]
  assert_eq vec_sort([0, 1, 2, 1003, 4, 5, 6, 1007, 1008, 1009, 1010, 1011, 1012, 1013, 14, 1015, 1016, 17, 1018, 19]), [0, 1, 2, 19, 4, 5, 6, 17, 14, 1010, 1009, 1011, 1012, 1013, 1008, 1015, 1016, 1007, 1018, 1003]
  assert_eq vec_slice([0, 1, 2, 1003, 4, 5, 6, 1007, 1008, 1009, 1010, 1011, 1012, 1013, 14, 1015, 1016, 17, 1018, 19]), [0, 1, 2, 19, 4, 5, 6, 17, 14, 1010, 1009, 1011, 1012, 1013, 1008, 1015, 1016, 1007, 1018, 1003]
  assert_eq vec_sort([3000, 1, 2002, 4003, 1004, 1005, 4006, 7, 1008, 3009, 4010, 3011, 2012, 1013, 1014, 3015, 3016, 17, 4018, 3019]), [1, 17, 7, 1004, 1005, 1014, 1008, 1013, 2012, 2002, 3015, 3011, 3009, 3000, 3016, 3019, 4010, 4006, 4003, 4018]
  assert_eq vec_slice([3000, 1, 2002, 4003, 1004, 1005, 4006, 7, 1008, 3009, 4010, 3011, 2012, 1013, 1014, 3015, 3016, 17, 4018, 3019]), [1, 17, 7, 1004, 1005, 1014, 1008, 1013, 2012, 2002, 3015, 3011, 3009, 3000, 3016, 3019, 4010, 4006, 4003, 4018]
