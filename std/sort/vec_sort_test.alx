  assert_eq search_float64s([nz, nz, 1.0, 2.5, 2.5, inf], 2.5), 3
  assert_eq search_float64s([nz, nz, 1.0, 2.5, 2.5, inf], inf), 5
  assert_eq search_float64s([-1.0, nz, 0.0, inf], nan), 4
  assert_eq search_float64s([-1.0, nz, 0.0, inf], ninf), 0
  assert_eq search_float64s([-1.0, nz, 0.0, inf], -2.5), 0
  assert_eq search_float64s([-1.0, nz, 0.0, inf], -1.0), 0
  assert_eq search_float64s([-1.0, nz, 0.0, inf], nz), 1
  assert_eq search_float64s([-1.0, nz, 0.0, inf], 0.0), 1
  assert_eq search_float64s([-1.0, nz, 0.0, inf], 1.0), 3
  assert_eq search_float64s([-1.0, nz, 0.0, inf], 2.5), 3
  assert_eq search_float64s([-1.0, nz, 0.0, inf], inf), 3
  assert_eq search_float64s([inf, inf], nan), 2
  assert_eq search_float64s([inf, inf], ninf), 0
  assert_eq search_float64s([inf, inf], -2.5), 0
  assert_eq search_float64s([inf, inf], -1.0), 0
  assert_eq search_float64s([inf, inf], nz), 0
  assert_eq search_float64s([inf, inf], 0.0), 0
  assert_eq search_float64s([inf, inf], 1.0), 0
  assert_eq search_float64s([inf, inf], 2.5), 0
  assert_eq search_float64s([inf, inf], inf), 0
  assert_eq search_float64s([-2.5, -1.0, 2.5], nan), 3
  assert_eq search_float64s([-2.5, -1.0, 2.5], ninf), 0
  assert_eq search_float64s([-2.5, -1.0, 2.5], -2.5), 0
  assert_eq search_float64s([-2.5, -1.0, 2.5], -1.0), 1
  assert_eq search_float64s([-2.5, -1.0, 2.5], nz), 2
  assert_eq search_float64s([-2.5, -1.0, 2.5], 0.0), 2
  assert_eq search_float64s([-2.5, -1.0, 2.5], 1.0), 2
  assert_eq search_float64s([-2.5, -1.0, 2.5], 2.5), 2
  assert_eq search_float64s([-2.5, -1.0, 2.5], inf), 3
  assert_eq search_float64s([nan, 1.0, 2.5, inf], nan), 4
  assert_eq search_float64s([nan, 1.0, 2.5, inf], ninf), 1
  assert_eq search_float64s([nan, 1.0, 2.5, inf], -2.5), 1
  assert_eq search_float64s([nan, 1.0, 2.5, inf], -1.0), 1
  assert_eq search_float64s([nan, 1.0, 2.5, inf], nz), 1
  assert_eq search_float64s([nan, 1.0, 2.5, inf], 0.0), 1
  assert_eq search_float64s([nan, 1.0, 2.5, inf], 1.0), 1
  assert_eq search_float64s([nan, 1.0, 2.5, inf], 2.5), 2
  assert_eq search_float64s([nan, 1.0, 2.5, inf], inf), 3
  assert_eq search_float64s(vec_floats(), nan), 0
  assert_eq search_float64s(vec_floats(), ninf), 0
  assert_eq search_float64s(vec_floats(), -2.5), 0
  assert_eq search_float64s(vec_floats(), -1.0), 0
  assert_eq search_float64s(vec_floats(), nz), 0
  assert_eq search_float64s(vec_floats(), 0.0), 0
  assert_eq search_float64s(vec_floats(), 1.0), 0
  assert_eq search_float64s(vec_floats(), 2.5), 0
  assert_eq search_float64s(vec_floats(), inf), 0
  assert_eq search_float64s(vec_floats(), nan), 0
  assert_eq search_float64s(vec_floats(), ninf), 0
  assert_eq search_float64s(vec_floats(), -2.5), 0
  assert_eq search_float64s(vec_floats(), -1.0), 0
  assert_eq search_float64s(vec_floats(), nz), 0
  assert_eq search_float64s(vec_floats(), 0.0), 0
  assert_eq search_float64s(vec_floats(), 1.0), 0
}

test "vectors: search 17" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq search_float64s(vec_floats(), 2.5), 0
  assert_eq search_float64s(vec_floats(), inf), 0
  assert_eq search_float64s([-2.5], nan), 1
  assert_eq search_float64s([-2.5], ninf), 0
  assert_eq search_float64s([-2.5], -2.5), 0
  assert_eq search_float64s([-2.5], -1.0), 1
  assert_eq search_float64s([-2.5], nz), 1
  assert_eq search_float64s([-2.5], 0.0), 1
  assert_eq search_float64s([-2.5], 1.0), 1
  assert_eq search_float64s([-2.5], 2.5), 1
  assert_eq search_float64s([-2.5], inf), 1
  assert_eq search_strings(["b", "~", "é", "日", "日本"], ""), 0
  assert_eq search_strings(["b", "~", "é", "日", "日本"], "a"), 0
  assert_eq search_strings(["b", "~", "é", "日", "日本"], "aa"), 0
  assert_eq search_strings(["b", "~", "é", "日", "日本"], "日"), 3
  assert_eq search_strings(["b", "~", "é", "日", "日本"], "zz"), 1
  assert_eq search_strings(["z", "~", "😀"], ""), 0
  assert_eq search_strings(["z", "~", "😀"], "a"), 0
  assert_eq search_strings(["z", "~", "😀"], "aa"), 0
  assert_eq search_strings(["z", "~", "😀"], "日"), 2
  assert_eq search_strings(["z", "~", "😀"], "zz"), 1
  assert_eq search_strings(vec_strs(), ""), 0
  assert_eq search_strings(vec_strs(), "a"), 0
  assert_eq search_strings(vec_strs(), "aa"), 0
  assert_eq search_strings(vec_strs(), "日"), 0
  assert_eq search_strings(vec_strs(), "zz"), 0
  assert_eq search_strings(["", "A", "z", "~", "~"], ""), 0
  assert_eq search_strings(["", "A", "z", "~", "~"], "a"), 2
  assert_eq search_strings(["", "A", "z", "~", "~"], "aa"), 2
  assert_eq search_strings(["", "A", "z", "~", "~"], "日"), 5
  assert_eq search_strings(["", "A", "z", "~", "~"], "zz"), 3
  assert_eq search_strings(["", "日", "日本", "😀"], ""), 0
  assert_eq search_strings(["", "日", "日本", "😀"], "a"), 1
  assert_eq search_strings(["", "日", "日本", "😀"], "aa"), 1
  assert_eq search_strings(["", "日", "日本", "😀"], "日"), 1
  assert_eq search_strings(["", "日", "日本", "😀"], "zz"), 1
  assert_eq search_strings(["a", "ab", "ab", "z", "😀", "😀"], ""), 0
  assert_eq search_strings(["a", "ab", "ab", "z", "😀", "😀"], "a"), 0
  assert_eq search_strings(["a", "ab", "ab", "z", "😀", "😀"], "aa"), 1
  assert_eq search_strings(["a", "ab", "ab", "z", "😀", "😀"], "日"), 4
  assert_eq search_strings(["a", "ab", "ab", "z", "😀", "😀"], "zz"), 4
  assert_eq search_strings(["é", "日"], ""), 0
  assert_eq search_strings(["é", "日"], "a"), 0
  assert_eq search_strings(["é", "日"], "aa"), 0
  assert_eq search_strings(["é", "日"], "日"), 1
  assert_eq search_strings(["é", "日"], "zz"), 0
  assert_eq search_strings(["~", "😀"], ""), 0
  assert_eq search_strings(["~", "😀"], "a"), 0
  assert_eq search_strings(["~", "😀"], "aa"), 0
  assert_eq search_strings(["~", "😀"], "日"), 1
  assert_eq search_strings(["~", "😀"], "zz"), 0
  assert_eq search_strings(["日"], ""), 0
  assert_eq search_strings(["日"], "a"), 0
  assert_eq search_strings(["日"], "aa"), 0
  assert_eq search_strings(["日"], "日"), 0
  assert_eq search_strings(["日"], "zz"), 0
  assert_eq search_strings(["b", "😀"], ""), 0
  assert_eq search_strings(["b", "😀"], "a"), 0
  assert_eq search_strings(["b", "😀"], "aa"), 0
  assert_eq search_strings(["b", "😀"], "日"), 1
  assert_eq search_strings(["b", "😀"], "zz"), 1
  assert_eq search_strings(vec_strs(), ""), 0
  assert_eq search_strings(vec_strs(), "a"), 0
  assert_eq search_strings(vec_strs(), "aa"), 0
  assert_eq search_strings(vec_strs(), "日"), 0
  assert_eq search_strings(vec_strs(), "zz"), 0
  assert_eq search_strings(["", "", "A", "b", "日", "日本"], ""), 0
  assert_eq search_strings(["", "", "A", "b", "日", "日本"], "a"), 3
  assert_eq search_strings(["", "", "A", "b", "日", "日本"], "aa"), 3
  assert_eq search_strings(["", "", "A", "b", "日", "日本"], "日"), 4
  assert_eq search_strings(["", "", "A", "b", "日", "日本"], "zz"), 4
  assert_eq search_strings(["", "A", "A", "a"], ""), 0
  assert_eq search_strings(["", "A", "A", "a"], "a"), 3
  assert_eq search_strings(["", "A", "A", "a"], "aa"), 4
  assert_eq search_strings(["", "A", "A", "a"], "日"), 4
  assert_eq search_strings(["", "A", "A", "a"], "zz"), 4
  assert_eq search_strings(["A", "a", "~", "日本", "😀"], ""), 0
  assert_eq search_strings(["A", "a", "~", "日本", "😀"], "a"), 1
  assert_eq search_strings(["A", "a", "~", "日本", "😀"], "aa"), 2
  assert_eq search_strings(["A", "a", "~", "日本", "😀"], "日"), 3
  assert_eq search_strings(["A", "a", "~", "日本", "😀"], "zz"), 2
  assert_eq search_strings(["z", "😀"], ""), 0
  assert_eq search_strings(["z", "😀"], "a"), 0
  assert_eq search_strings(["z", "😀"], "aa"), 0
  assert_eq search_strings(["z", "😀"], "日"), 1
  assert_eq search_strings(["z", "😀"], "zz"), 1
  assert_eq search_strings(["", "A", "a", "a", "~"], ""), 0
  assert_eq search_strings(["", "A", "a", "a", "~"], "a"), 2
  assert_eq search_strings(["", "A", "a", "a", "~"], "aa"), 4
  assert_eq search_strings(["", "A", "a", "a", "~"], "日"), 5
  assert_eq search_strings(["", "A", "a", "a", "~"], "zz"), 4
  assert_eq search_strings(["", "ab"], ""), 0
  assert_eq search_strings(["", "ab"], "a"), 1
  assert_eq search_strings(["", "ab"], "aa"), 1
  assert_eq search_strings(["", "ab"], "日"), 2
  assert_eq search_strings(["", "ab"], "zz"), 2
  assert_eq search_strings(["A", "A", "a", "a", "日", "日本"], ""), 0
  assert_eq search_strings(["A", "A", "a", "a", "日", "日本"], "a"), 2
  assert_eq search_strings(["A", "A", "a", "a", "日", "日本"], "aa"), 4
  assert_eq search_strings(["A", "A", "a", "a", "日", "日本"], "日"), 4
}

test "vectors: search 18" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq search_strings(["A", "A", "a", "a", "日", "日本"], "zz"), 4
  assert_eq search_strings(["A"], ""), 0
  assert_eq search_strings(["A"], "a"), 1
  assert_eq search_strings(["A"], "aa"), 1
  assert_eq search_strings(["A"], "日"), 1
  assert_eq search_strings(["A"], "zz"), 1
  assert_eq search_strings(["ab", "b"], ""), 0
  assert_eq search_strings(["ab", "b"], "a"), 0
  assert_eq search_strings(["ab", "b"], "aa"), 0
  assert_eq search_strings(["ab", "b"], "日"), 2
  assert_eq search_strings(["ab", "b"], "zz"), 2
  assert_eq search_strings(["A", "ab", "b", "z", "z", "日"], ""), 0
  assert_eq search_strings(["A", "ab", "b", "z", "z", "日"], "a"), 1
  assert_eq search_strings(["A", "ab", "b", "z", "z", "日"], "aa"), 1
  assert_eq search_strings(["A", "ab", "b", "z", "z", "日"], "日"), 5
  assert_eq search_strings(["A", "ab", "b", "z", "z", "日"], "zz"), 5
  assert_eq search_strings(["ab", "é", "日"], ""), 0
  assert_eq search_strings(["ab", "é", "日"], "a"), 0
  assert_eq search_strings(["ab", "é", "日"], "aa"), 0
  assert_eq search_strings(["ab", "é", "日"], "日"), 2
  assert_eq search_strings(["ab", "é", "日"], "zz"), 1
  assert_eq search_strings(["ab", "ab", "z", "~", "日本"], ""), 0
  assert_eq search_strings(["ab", "ab", "z", "~", "日本"], "a"), 0
  assert_eq search_strings(["ab", "ab", "z", "~", "日本"], "aa"), 0
  assert_eq search_strings(["ab", "ab", "z", "~", "日本"], "日"), 4
  assert_eq search_strings(["ab", "ab", "z", "~", "日本"], "zz"), 3
  assert_eq search_strings(["~", "é"], ""), 0
  assert_eq search_strings(["~", "é"], "a"), 0
  assert_eq search_strings(["~", "é"], "aa"), 0
  assert_eq search_strings(["~", "é"], "日"), 2
  assert_eq search_strings(["~", "é"], "zz"), 0
  assert_eq search_strings(["ab", "ab", "~", "日本"], ""), 0
  assert_eq search_strings(["ab", "ab", "~", "日本"], "a"), 0
  assert_eq search_strings(["ab", "ab", "~", "日本"], "aa"), 0
  assert_eq search_strings(["ab", "ab", "~", "日本"], "日"), 3
  assert_eq search_strings(["ab", "ab", "~", "日本"], "zz"), 2
  assert_eq search(0) { |i| i >= 0 }, 0
  assert_eq search(0) { |i| i >= 1 }, 0
  assert_eq search(0) { |i| i >= 2 }, 0
  assert_eq search(0) { |i| i >= 999 }, 0
  assert_eq search(0) { |i| i >= 549755813888 }, 0
  assert_eq search(0) { |i| i >= 9223372036854775806 }, 0
  assert_eq search(0) { |i| i >= 9223372036854775807 }, 0
  assert_eq search(1) { |i| i >= 0 }, 0
  assert_eq search(1) { |i| i >= 1 }, 1
  assert_eq search(1) { |i| i >= 2 }, 1
  assert_eq search(1) { |i| i >= 999 }, 1
  assert_eq search(1) { |i| i >= 549755813888 }, 1
  assert_eq search(1) { |i| i >= 9223372036854775806 }, 1
  assert_eq search(1) { |i| i >= 9223372036854775807 }, 1
  assert_eq search(2) { |i| i >= 0 }, 0
  assert_eq search(2) { |i| i >= 1 }, 1
  assert_eq search(2) { |i| i >= 2 }, 2
  assert_eq search(2) { |i| i >= 999 }, 2
  assert_eq search(2) { |i| i >= 549755813888 }, 2
  assert_eq search(2) { |i| i >= 9223372036854775806 }, 2
  assert_eq search(2) { |i| i >= 9223372036854775807 }, 2
  assert_eq search(3) { |i| i >= 0 }, 0
  assert_eq search(3) { |i| i >= 1 }, 1
  assert_eq search(3) { |i| i >= 2 }, 2
  assert_eq search(3) { |i| i >= 999 }, 3
  assert_eq search(3) { |i| i >= 549755813888 }, 3
  assert_eq search(3) { |i| i >= 9223372036854775806 }, 3
  assert_eq search(3) { |i| i >= 9223372036854775807 }, 3
  assert_eq search(1000) { |i| i >= 0 }, 0
  assert_eq search(1000) { |i| i >= 1 }, 1
  assert_eq search(1000) { |i| i >= 2 }, 2
  assert_eq search(1000) { |i| i >= 999 }, 999
  assert_eq search(1000) { |i| i >= 549755813888 }, 1000
  assert_eq search(1000) { |i| i >= 9223372036854775806 }, 1000
  assert_eq search(1000) { |i| i >= 9223372036854775807 }, 1000
  assert_eq search(1099511627776) { |i| i >= 0 }, 0
  assert_eq search(1099511627776) { |i| i >= 1 }, 1
  assert_eq search(1099511627776) { |i| i >= 2 }, 2
  assert_eq search(1099511627776) { |i| i >= 999 }, 999
  assert_eq search(1099511627776) { |i| i >= 549755813888 }, 549755813888
  assert_eq search(1099511627776) { |i| i >= 9223372036854775806 }, 1099511627776
  assert_eq search(1099511627776) { |i| i >= 9223372036854775807 }, 1099511627776
  assert_eq search(9223372036854775807) { |i| i >= 0 }, 0
  assert_eq search(9223372036854775807) { |i| i >= 1 }, 1
  assert_eq search(9223372036854775807) { |i| i >= 2 }, 2
  assert_eq search(9223372036854775807) { |i| i >= 999 }, 999
  assert_eq search(9223372036854775807) { |i| i >= 549755813888 }, 549755813888
  assert_eq search(9223372036854775807) { |i| i >= 9223372036854775806 }, 9223372036854775806
  assert_eq search(9223372036854775807) { |i| i >= 9223372036854775807 }, 9223372036854775807
}
