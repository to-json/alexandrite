  assert_eq vec_sort_reverse([1000, 8001, 5002, 1003, 11004, 8005, 16006, 12007, 15008, 5009, 10, 6011, 10012, 5013, 2014, 9015, 16016]), [16006, 16016, 15008, 12007, 11004, 10012, 9015, 8005, 8001, 6011, 5002, 5009, 5013, 2014, 1000, 1003, 10]
