  assert_eq search_ints([0], 4), 1
  assert_eq IntSlice.new([0]).search(4), 1
  assert_eq find(1) { |i| 4 - [0][i] }, (1, false)
  assert_eq search_ints([0], 5), 1
  assert_eq IntSlice.new([0]).search(5), 1
  assert_eq find(1) { |i| 5 - [0][i] }, (1, false)
  assert_eq search_ints([0], 6), 1
  assert_eq IntSlice.new([0]).search(6), 1
  assert_eq find(1) { |i| 6 - [0][i] }, (1, false)
  assert_eq search_ints([1, 2, 6, 6], -4), 0
