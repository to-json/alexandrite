  assert_eq search_ints([-3, 0, 2, 4, 5], 4), 3
  assert_eq IntSlice.new([-3, 0, 2, 4, 5]).search(4), 3
  assert_eq find(5) { |i| 4 - [-3, 0, 2, 4, 5][i] }, (3, true)
  assert_eq search_ints([-3, 0, 2, 4, 5], 5), 4
  assert_eq IntSlice.new([-3, 0, 2, 4, 5]).search(5), 4
  assert_eq find(5) { |i| 5 - [-3, 0, 2, 4, 5][i] }, (4, true)
  assert_eq search_ints([-3, 0, 2, 4, 5], 6), 5
  assert_eq IntSlice.new([-3, 0, 2, 4, 5]).search(6), 5
  assert_eq find(5) { |i| 6 - [-3, 0, 2, 4, 5][i] }, (5, false)
  assert_eq search_ints([-2, 4], -4), 0
  assert_eq IntSlice.new([-2, 4]).search(-4), 0
  assert_eq find(2) { |i| -4 - [-2, 4][i] }, (0, false)
  assert_eq search_ints([-2, 4], -2), 0
  assert_eq IntSlice.new([-2, 4]).search(-2), 0
  assert_eq find(2) { |i| -2 - [-2, 4][i] }, (0, true)
  assert_eq search_ints([-2, 4], -1), 1
  assert_eq IntSlice.new([-2, 4]).search(-1), 1
  assert_eq find(2) { |i| -1 - [-2, 4][i] }, (1, false)
  assert_eq search_ints([-2, 4], 1), 1
  assert_eq IntSlice.new([-2, 4]).search(1), 1
  assert_eq find(2) { |i| 1 - [-2, 4][i] }, (1, false)
  assert_eq search_ints([-2, 4], 4), 1
  assert_eq IntSlice.new([-2, 4]).search(4), 1
  assert_eq find(2) { |i| 4 - [-2, 4][i] }, (1, true)
  assert_eq search_ints([-2, 4], 5), 2
  assert_eq IntSlice.new([-2, 4]).search(5), 2
  assert_eq find(2) { |i| 5 - [-2, 4][i] }, (2, false)
  assert_eq search_ints([-2, 4], 8), 2
  assert_eq IntSlice.new([-2, 4]).search(8), 2
  assert_eq find(2) { |i| 8 - [-2, 4][i] }, (2, false)
  assert_eq search_ints([-2, 1, 2, 3, 4], -4), 0
}

