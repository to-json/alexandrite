  assert_eq search_float64s([1.0], -2.5), 0
  assert_eq search_float64s([1.0], -1.0), 0
  assert_eq search_float64s([1.0], nz), 0
  assert_eq search_float64s([1.0], 0.0), 0
  assert_eq search_float64s([1.0], 1.0), 0
  assert_eq search_float64s([1.0], 2.5), 1
  assert_eq search_float64s([1.0], inf), 1
  assert_eq search_float64s([ninf, nz, inf], nan), 3
  assert_eq search_float64s([ninf, nz, inf], ninf), 0
  assert_eq search_float64s([ninf, nz, inf], -2.5), 1
  assert_eq search_float64s([ninf, nz, inf], -1.0), 1
  assert_eq search_float64s([ninf, nz, inf], nz), 1
  assert_eq search_float64s([ninf, nz, inf], 0.0), 1
  assert_eq search_float64s([ninf, nz, inf], 1.0), 2
  assert_eq search_float64s([ninf, nz, inf], 2.5), 2
  assert_eq search_float64s([ninf, nz, inf], inf), 2
  assert_eq search_float64s([nan, -2.5, nz], nan), 3
  assert_eq search_float64s([nan, -2.5, nz], ninf), 1
  assert_eq search_float64s([nan, -2.5, nz], -2.5), 1
  assert_eq search_float64s([nan, -2.5, nz], -1.0), 2
  assert_eq search_float64s([nan, -2.5, nz], nz), 2
  assert_eq search_float64s([nan, -2.5, nz], 0.0), 2
  assert_eq search_float64s([nan, -2.5, nz], 1.0), 3
  assert_eq search_float64s([nan, -2.5, nz], 2.5), 3
  assert_eq search_float64s([nan, -2.5, nz], inf), 3
  assert_eq search_float64s([0.0, 2.5, inf], nan), 3
  assert_eq search_float64s([0.0, 2.5, inf], ninf), 0
  assert_eq search_float64s([0.0, 2.5, inf], -2.5), 0
  assert_eq search_float64s([0.0, 2.5, inf], -1.0), 0
  assert_eq search_float64s([0.0, 2.5, inf], nz), 0
  assert_eq search_float64s([0.0, 2.5, inf], 0.0), 0
  assert_eq search_float64s([0.0, 2.5, inf], 1.0), 1
  assert_eq search_float64s([0.0, 2.5, inf], 2.5), 1
  assert_eq search_float64s([0.0, 2.5, inf], inf), 2
  assert_eq search_float64s([nan, nz, 0.0, 0.0, 2.5], nan), 5
  assert_eq search_float64s([nan, nz, 0.0, 0.0, 2.5], ninf), 1
  assert_eq search_float64s([nan, nz, 0.0, 0.0, 2.5], -2.5), 1
  assert_eq search_float64s([nan, nz, 0.0, 0.0, 2.5], -1.0), 1
  assert_eq search_float64s([nan, nz, 0.0, 0.0, 2.5], nz), 1
  assert_eq search_float64s([nan, nz, 0.0, 0.0, 2.5], 0.0), 1
}

test "vectors: search 16" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq search_float64s([nan, nz, 0.0, 0.0, 2.5], 1.0), 4
  assert_eq search_float64s([nan, nz, 0.0, 0.0, 2.5], 2.5), 4
  assert_eq search_float64s([nan, nz, 0.0, 0.0, 2.5], inf), 5
  assert_eq search_float64s([-1.0, 0.0, 0.0, 1.0, inf, inf], nan), 6
  assert_eq search_float64s([-1.0, 0.0, 0.0, 1.0, inf, inf], ninf), 0
