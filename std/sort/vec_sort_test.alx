  assert_eq search_ints([0], -1), 0
  assert_eq IntSlice.new([0]).search(-1), 0
  assert_eq find(1) { |i| -1 - [0][i] }, (0, false)
  assert_eq search_ints([0], 1), 1
  assert_eq IntSlice.new([0]).search(1), 1
  assert_eq find(1) { |i| 1 - [0][i] }, (1, false)
  assert_eq search_ints([0], 3), 1
  assert_eq IntSlice.new([0]).search(3), 1
