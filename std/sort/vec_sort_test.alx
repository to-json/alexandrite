  assert_eq vec_sort_reverse([3000, 2001, 7002, 4003, 7004, 2005, 2006, 7]), [7002, 7004, 4003, 3000, 2001, 2005, 2006, 7]
  assert_eq vec_sort([0, 1, 2, 1003, 1004, 1005, 6, 1007, 8]), [0, 1, 2, 6, 8, 1003, 1004, 1005, 1007]
  assert_eq vec_sort_reverse([0, 1, 2, 1003, 1004, 1005, 6, 1007, 8]), [1003, 1004, 1005, 1007, 0, 1, 2, 6, 8]
