  assert_eq search_ints([1, 2, 6, 6], 1), 0
  assert_eq IntSlice.new([1, 2, 6, 6]).search(1), 0
  assert_eq find(4) { |i| 1 - [1, 2, 6, 6][i] }, (0, true)
  assert_eq search_ints([1, 2, 6, 6], 4), 2
  assert_eq IntSlice.new([1, 2, 6, 6]).search(4), 2
  assert_eq find(4) { |i| 4 - [1, 2, 6, 6][i] }, (2, false)
  assert_eq search_ints([1, 2, 6, 6], 5), 2
  assert_eq IntSlice.new([1, 2, 6, 6]).search(5), 2
  assert_eq find(4) { |i| 5 - [1, 2, 6, 6][i] }, (2, false)
  assert_eq search_ints([1, 2, 6, 6], 6), 2
  assert_eq IntSlice.new([1, 2, 6, 6]).search(6), 2
  assert_eq find(4) { |i| 6 - [1, 2, 6, 6][i] }, (2, true)
  assert_eq search_ints([1, 2, 6, 6], 7), 4
  assert_eq IntSlice.new([1, 2, 6, 6]).search(7), 4
  assert_eq find(4) { |i| 7 - [1, 2, 6, 6][i] }, (4, false)
  assert_eq search_ints([1, 2, 6, 6], 8), 4
  assert_eq IntSlice.new([1, 2, 6, 6]).search(8), 4
  assert_eq find(4) { |i| 8 - [1, 2, 6, 6][i] }, (4, false)
  assert_eq search_ints([-2, 1], -4), 0
  assert_eq IntSlice.new([-2, 1]).search(-4), 0
  assert_eq find(2) { |i| -4 - [-2, 1][i] }, (0, false)
  assert_eq search_ints([-2, 1], -1), 1
  assert_eq IntSlice.new([-2, 1]).search(-1), 1
  assert_eq find(2) { |i| -1 - [-2, 1][i] }, (1, false)
  assert_eq search_ints([-2, 1], 1), 1
  assert_eq IntSlice.new([-2, 1]).search(1), 1
  assert_eq find(2) { |i| 1 - [-2, 1][i] }, (1, true)
  assert_eq search_ints([-2, 1], 2), 2
  assert_eq IntSlice.new([-2, 1]).search(2), 2
  assert_eq find(2) { |i| 2 - [-2, 1][i] }, (2, false)
  assert_eq search_ints([-2, 1], 5), 2
  assert_eq IntSlice.new([-2, 1]).search(5), 2
  assert_eq find(2) { |i| 5 - [-2, 1][i] }, (2, false)
  assert_eq search_ints([-2, 1], 7), 2
  assert_eq IntSlice.new([-2, 1]).search(7), 2
  assert_eq find(2) { |i| 7 - [-2, 1][i] }, (2, false)
  assert_eq search_ints([-1, 1, 2, 2, 4, 4], -4), 0
  assert_eq IntSlice.new([-1, 1, 2, 2, 4, 4]).search(-4), 0
  assert_eq find(6) { |i| -4 - [-1, 1, 2, 2, 4, 4][i] }, (0, false)
  assert_eq search_ints([-1, 1, 2, 2, 4, 4], -3), 0
  assert_eq IntSlice.new([-1, 1, 2, 2, 4, 4]).search(-3), 0
  assert_eq find(6) { |i| -3 - [-1, 1, 2, 2, 4, 4][i] }, (0, false)
  assert_eq search_ints([-1, 1, 2, 2, 4, 4], -2), 0
  assert_eq IntSlice.new([-1, 1, 2, 2, 4, 4]).search(-2), 0
  assert_eq find(6) { |i| -2 - [-1, 1, 2, 2, 4, 4][i] }, (0, false)
  assert_eq search_ints([-1, 1, 2, 2, 4, 4], 1), 1
  assert_eq IntSlice.new([-1, 1, 2, 2, 4, 4]).search(1), 1
  assert_eq find(6) { |i| 1 - [-1, 1, 2, 2, 4, 4][i] }, (1, true)
  assert_eq search_ints([-1, 1, 2, 2, 4, 4], 2), 2
  assert_eq IntSlice.new([-1, 1, 2, 2, 4, 4]).search(2), 2
  assert_eq find(6) { |i| 2 - [-1, 1, 2, 2, 4, 4][i] }, (2, true)
  assert_eq search_ints([-1, 1, 2, 2, 4, 4], 3), 4
  assert_eq IntSlice.new([-1, 1, 2, 2, 4, 4]).search(3), 4
  assert_eq find(6) { |i| 3 - [-1, 1, 2, 2, 4, 4][i] }, (4, false)
  assert_eq search_ints([-1, 1, 2, 2, 4, 4], 6), 6
  assert_eq IntSlice.new([-1, 1, 2, 2, 4, 4]).search(6), 6
  assert_eq find(6) { |i| 6 - [-1, 1, 2, 2, 4, 4][i] }, (6, false)
  assert_eq search_ints([5], -4), 0
  assert_eq IntSlice.new([5]).search(-4), 0
  assert_eq find(1) { |i| -4 - [5][i] }, (0, false)
  assert_eq search_ints([5], -2), 0
  assert_eq IntSlice.new([5]).search(-2), 0
  assert_eq find(1) { |i| -2 - [5][i] }, (0, false)
  assert_eq search_ints([5], -1), 0
  assert_eq IntSlice.new([5]).search(-1), 0
}

