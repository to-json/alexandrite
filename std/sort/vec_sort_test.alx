  assert_eq search_ints([-3], -1), 1
  assert_eq IntSlice.new([-3]).search(-1), 1
  assert_eq find(1) { |i| -1 - [-3][i] }, (1, false)
  assert_eq search_ints([-3], 1), 1
}

