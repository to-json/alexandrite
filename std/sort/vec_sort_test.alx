  assert_eq IntSlice.new([0, 1, 6]).search(1), 1
  assert_eq find(3) { |i| 1 - [0, 1, 6][i] }, (1, true)
  assert_eq search_ints([0, 1, 6], 2), 2
  assert_eq IntSlice.new([0, 1, 6]).search(2), 2
  assert_eq find(3) { |i| 2 - [0, 1, 6][i] }, (2, false)
  assert_eq search_ints([0, 1, 6], 5), 2
  assert_eq IntSlice.new([0, 1, 6]).search(5), 2
  assert_eq find(3) { |i| 5 - [0, 1, 6][i] }, (2, false)
  assert_eq search_ints([0, 1, 6], 6), 2
  assert_eq IntSlice.new([0, 1, 6]).search(6), 2
