# Generated from Go's sort (go1.27.1, .scratch/gen/sort); do not edit by hand.
import "math"

def vec_ints -> [Int] {
  e: [Int] = []
  e
}

def vec_floats -> [Float] {
  e: [Float] = []
  e
}

def vec_strs -> [Str] {
  e: [Str] = []
  e
}

# Keys tagged with their positions (key * 1000 + i), compared on the key: an
# Interface whose unstable sort shows where Go's pdqsort leaves equal keys.
struct VecTagged {
  xs: [Int]

  def len -> Int { xs.size }

  def less(i: Int, j: Int) -> Bool { xs[i] / 1000 < xs[j] / 1000 }

  def swap!(i: Int, j: Int) {
    x = xs
    x[i], x[j] = x[j], x[i]
  }
}

def vec_sort(xs: [Int]) -> [Int] {
  sort(VecTagged.new(xs))
  xs
}

def vec_sort_reverse(xs: [Int]) -> [Int] {
  sort(reverse(VecTagged.new(xs)))
  xs
}

def vec_stable(xs: [Int]) -> [Int] {
  stable(VecTagged.new(xs))
  xs
}

def vec_slice(xs: [Int]) -> [Int] {
  slice(xs) { |i, j| xs[i] / 1000 < xs[j] / 1000 }
  xs
}

def vec_slice_stable(xs: [Int]) -> [Int] {
  slice_stable(xs) { |i, j| xs[i] / 1000 < xs[j] / 1000 }
  xs
}

def vec_heapsort(xs: [Int]) -> [Int] {
  heapsort(VecTagged.new(xs))
  xs
}

test "vectors: sort ties 1" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq vec_sort(vec_ints()), vec_ints()
  assert_eq vec_sort_reverse(vec_ints()), vec_ints()
  assert_eq vec_sort(vec_ints()), vec_ints()
  assert_eq vec_sort_reverse(vec_ints()), vec_ints()
  assert_eq vec_sort(vec_ints()), vec_ints()
  assert_eq vec_sort_reverse(vec_ints()), vec_ints()
  assert_eq vec_sort([0]), [0]
  assert_eq vec_sort_reverse([0]), [0]
  assert_eq vec_sort([0]), [0]
  assert_eq vec_sort_reverse([0]), [0]
  assert_eq vec_sort([0]), [0]
  assert_eq vec_sort_reverse([0]), [0]
  assert_eq vec_sort([0, 1]), [0, 1]
  assert_eq vec_sort_reverse([0, 1]), [0, 1]
  assert_eq vec_sort([0, 1]), [0, 1]
  assert_eq vec_sort_reverse([0, 1]), [0, 1]
  assert_eq vec_sort([0, 1001]), [0, 1001]
  assert_eq vec_sort_reverse([0, 1001]), [1001, 0]
  assert_eq vec_sort([0, 1, 1002]), [0, 1, 1002]
  assert_eq vec_sort_reverse([0, 1, 1002]), [1002, 0, 1]
  assert_eq vec_sort([1000, 1, 2]), [1, 2, 1000]
  assert_eq vec_sort_reverse([1000, 1, 2]), [1000, 1, 2]
  assert_eq vec_sort([3000, 3001, 2]), [2, 3000, 3001]
  assert_eq vec_sort_reverse([3000, 3001, 2]), [3000, 3001, 2]
  assert_eq vec_sort([1000, 1001, 2, 3]), [2, 3, 1000, 1001]
  assert_eq vec_sort_reverse([1000, 1001, 2, 3]), [1000, 1001, 2, 3]
  assert_eq vec_sort([1000, 1, 2, 1003]), [1, 2, 1000, 1003]
  assert_eq vec_sort_reverse([1000, 1, 2, 1003]), [1000, 1003, 1, 2]
  assert_eq vec_sort([3000, 1, 4002, 4003]), [1, 3000, 4002, 4003]
  assert_eq vec_sort_reverse([3000, 1, 4002, 4003]), [4002, 4003, 3000, 1]
  assert_eq vec_sort([1000, 1, 2, 1003, 1004]), [1, 2, 1000, 1003, 1004]
  assert_eq vec_sort_reverse([1000, 1, 2, 1003, 1004]), [1000, 1003, 1004, 1, 2]
  assert_eq vec_sort([0, 1001, 1002, 1003, 4]), [0, 4, 1001, 1002, 1003]
  assert_eq vec_sort_reverse([0, 1001, 1002, 1003, 4]), [1001, 1002, 1003, 0, 4]
  assert_eq vec_sort([1000, 2001, 2002, 4003, 5004]), [1000, 2001, 2002, 4003, 5004]
  assert_eq vec_sort_reverse([1000, 2001, 2002, 4003, 5004]), [5004, 4003, 2001, 2002, 1000]
  assert_eq vec_sort([1000, 1, 1002, 3, 1004, 1005]), [1, 3, 1000, 1002, 1004, 1005]
  assert_eq vec_sort_reverse([1000, 1, 1002, 3, 1004, 1005]), [1000, 1002, 1004, 1005, 1, 3]
  assert_eq vec_sort([1000, 1, 1002, 1003, 4, 2005]), [1, 4, 1000, 1002, 1003, 2005]
  assert_eq vec_sort_reverse([1000, 1, 1002, 1003, 4, 2005]), [2005, 1000, 1002, 1003, 1, 4]
  assert_eq vec_sort([2000, 6001, 5002, 3003, 4004, 2005]), [2000, 2005, 3003, 4004, 5002, 6001]
  assert_eq vec_sort_reverse([2000, 6001, 5002, 3003, 4004, 2005]), [6001, 5002, 4004, 3003, 2000, 2005]
  assert_eq vec_sort([1000, 1001, 2, 3, 1004, 5, 6]), [2, 3, 5, 6, 1000, 1001, 1004]
  assert_eq vec_sort_reverse([1000, 1001, 2, 3, 1004, 5, 6]), [1000, 1001, 1004, 2, 3, 5, 6]
