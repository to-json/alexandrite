test "vectors: heapsort 1" {
  nan = math.nan
  nz = math.copysign(0.0, -1.0)
  inf = math.inf(1)
  ninf = math.inf(-1)
  _ = nan + nz + inf + ninf
  assert_eq vec_heapsort(vec_ints()), vec_ints()
  assert_eq vec_heapsort([3000]), [3000]
  assert_eq vec_heapsort([4000, 1]), [1, 4000]
  assert_eq vec_heapsort([3000, 1001, 4002, 4003, 3004, 5, 2006]), [5, 1001, 2006, 3004, 3000, 4002, 4003]
  assert_eq vec_heapsort([2000, 3001, 1002, 3, 1004, 2005, 4006, 1007, 8, 2009, 4010, 2011, 1012, 2013, 14, 3015, 1016, 17, 2018, 2019, 1020, 3021, 4022, 2023, 3024, 25, 1026, 4027, 1028, 2029, 1030]), [25, 17, 8, 14, 3, 1002, 1012, 1026, 1028, 1004, 1030, 1016, 1007, 1020, 2029, 2013, 2023, 2005, 2011, 2000, 2019, 2009, 2018, 3024, 3021, 3001, 3015, 4027, 4006, 4022, 4010]
