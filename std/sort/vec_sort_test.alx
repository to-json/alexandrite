  assert_eq search_ints([-3, 0, 1, 3, 3, 4, 4, 6], 3), 3
  assert_eq IntSlice.new([-3, 0, 1, 3, 3, 4, 4, 6]).search(3), 3
  assert_eq find(8) { |i| 3 - [-3, 0, 1, 3, 3, 4, 4, 6][i] }, (3, true)
  assert_eq search_ints([-3, 0, 1, 3, 3, 4, 4, 6], 5), 7
  assert_eq IntSlice.new([-3, 0, 1, 3, 3, 4, 4, 6]).search(5), 7
  assert_eq find(8) { |i| 5 - [-3, 0, 1, 3, 3, 4, 4, 6][i] }, (7, false)
  assert_eq search_ints([-3, 0, 1, 3, 3, 4, 4, 6], 8), 8
  assert_eq IntSlice.new([-3, 0, 1, 3, 3, 4, 4, 6]).search(8), 8
  assert_eq find(8) { |i| 8 - [-3, 0, 1, 3, 3, 4, 4, 6][i] }, (8, false)
  assert_eq search_ints([-2, -2, 0, 0, 4], -4), 0
  assert_eq IntSlice.new([-2, -2, 0, 0, 4]).search(-4), 0
  assert_eq find(5) { |i| -4 - [-2, -2, 0, 0, 4][i] }, (0, false)
  assert_eq search_ints([-2, -2, 0, 0, 4], -3), 0
  assert_eq IntSlice.new([-2, -2, 0, 0, 4]).search(-3), 0
  assert_eq find(5) { |i| -3 - [-2, -2, 0, 0, 4][i] }, (0, false)
  assert_eq search_ints([-2, -2, 0, 0, 4], -1), 2
  assert_eq IntSlice.new([-2, -2, 0, 0, 4]).search(-1), 2
  assert_eq find(5) { |i| -1 - [-2, -2, 0, 0, 4][i] }, (2, false)
  assert_eq search_ints([-2, -2, 0, 0, 4], 0), 2
  assert_eq IntSlice.new([-2, -2, 0, 0, 4]).search(0), 2
  assert_eq find(5) { |i| 0 - [-2, -2, 0, 0, 4][i] }, (2, true)
  assert_eq search_ints([-2, -2, 0, 0, 4], 3), 4
  assert_eq IntSlice.new([-2, -2, 0, 0, 4]).search(3), 4
  assert_eq find(5) { |i| 3 - [-2, -2, 0, 0, 4][i] }, (4, false)
  assert_eq search_ints([-2, -2, 0, 0, 4], 5), 5
  assert_eq IntSlice.new([-2, -2, 0, 0, 4]).search(5), 5
  assert_eq find(5) { |i| 5 - [-2, -2, 0, 0, 4][i] }, (5, false)
  assert_eq search_ints([-2, -2, 0, 0, 4], 7), 5
  assert_eq IntSlice.new([-2, -2, 0, 0, 4]).search(7), 5
  assert_eq find(5) { |i| 7 - [-2, -2, 0, 0, 4][i] }, (5, false)
  assert_eq search_ints([-3, -3, -1, -1, 0, 0, 1, 3, 4], -4), 0
  assert_eq IntSlice.new([-3, -3, -1, -1, 0, 0, 1, 3, 4]).search(-4), 0
  assert_eq find(9) { |i| -4 - [-3, -3, -1, -1, 0, 0, 1, 3, 4][i] }, (0, false)
  assert_eq search_ints([-3, -3, -1, -1, 0, 0, 1, 3, 4], -1), 2
  assert_eq IntSlice.new([-3, -3, -1, -1, 0, 0, 1, 3, 4]).search(-1), 2
  assert_eq find(9) { |i| -1 - [-3, -3, -1, -1, 0, 0, 1, 3, 4][i] }, (2, true)
  assert_eq search_ints([-3, -3, -1, -1, 0, 0, 1, 3, 4], 1), 6
  assert_eq IntSlice.new([-3, -3, -1, -1, 0, 0, 1, 3, 4]).search(1), 6
  assert_eq find(9) { |i| 1 - [-3, -3, -1, -1, 0, 0, 1, 3, 4][i] }, (6, true)
  assert_eq search_ints([-3, -3, -1, -1, 0, 0, 1, 3, 4], 3), 7
  assert_eq IntSlice.new([-3, -3, -1, -1, 0, 0, 1, 3, 4]).search(3), 7
  assert_eq find(9) { |i| 3 - [-3, -3, -1, -1, 0, 0, 1, 3, 4][i] }, (7, true)
  assert_eq search_ints([-3, -3, -1, -1, 0, 0, 1, 3, 4], 5), 9
  assert_eq IntSlice.new([-3, -3, -1, -1, 0, 0, 1, 3, 4]).search(5), 9
  assert_eq find(9) { |i| 5 - [-3, -3, -1, -1, 0, 0, 1, 3, 4][i] }, (9, false)
  assert_eq search_ints([-3, -3, -1, -1, 0, 0, 1, 3, 4], 8), 9
  assert_eq IntSlice.new([-3, -3, -1, -1, 0, 0, 1, 3, 4]).search(8), 9
  assert_eq find(9) { |i| 8 - [-3, -3, -1, -1, 0, 0, 1, 3, 4][i] }, (9, false)
  assert_eq search_float64s([nan, ninf, nz, 1.0, 2.5, inf], nan), 6
  assert_eq search_float64s([nan, ninf, nz, 1.0, 2.5, inf], ninf), 1
  assert_eq search_float64s([nan, ninf, nz, 1.0, 2.5, inf], -2.5), 2
  assert_eq search_float64s([nan, ninf, nz, 1.0, 2.5, inf], -1.0), 2
  assert_eq search_float64s([nan, ninf, nz, 1.0, 2.5, inf], nz), 2
