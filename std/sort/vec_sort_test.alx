  assert_eq find(7) { |i| 7 - [-3, 1, 3, 3, 4, 6, 6][i] }, (7, false)
  assert_eq search_ints([-3, -3, -2, -2, -1, 1, 1, 4], -4), 0
  assert_eq IntSlice.new([-3, -3, -2, -2, -1, 1, 1, 4]).search(-4), 0
  assert_eq find(8) { |i| -4 - [-3, -3, -2, -2, -1, 1, 1, 4][i] }, (0, false)
  assert_eq search_ints([-3, -3, -2, -2, -1, 1, 1, 4], -3), 0
  assert_eq IntSlice.new([-3, -3, -2, -2, -1, 1, 1, 4]).search(-3), 0
  assert_eq find(8) { |i| -3 - [-3, -3, -2, -2, -1, 1, 1, 4][i] }, (0, true)
  assert_eq search_ints([-3, -3, -2, -2, -1, 1, 1, 4], -1), 4
  assert_eq IntSlice.new([-3, -3, -2, -2, -1, 1, 1, 4]).search(-1), 4
  assert_eq find(8) { |i| -1 - [-3, -3, -2, -2, -1, 1, 1, 4][i] }, (4, true)
