# Go's internal/strconv/atob_test.go (and strconv/number_test.go), translated: the
# tables are emitted from Go's own by a Go program; Go's results with alx's
# names in the messages. Go's range errors also return the clamped value; a
# ~T carries only the error (see the header of strconv.alx).

#[track_caller]
def pb_chk(s: Str, want: Str) {
  r = parse_bool(s)
  got = "?"
  if v = r.ok {
    got = "ok #{v}"
  } else if e = r.err {
    got = "#{e}"
  }
  assert got == want, "parse_bool(#{quote(s)}) = #{got}, want #{want} (#{caller_location})"
}

test "ParseBool" {
  pb_chk("", "strconv.parse_bool: parsing \"\": invalid syntax")
  pb_chk("asdf", "strconv.parse_bool: parsing \"asdf\": invalid syntax")
  pb_chk("0", "ok false")
  pb_chk("f", "ok false")
  pb_chk("F", "ok false")
  pb_chk("FALSE", "ok false")
  pb_chk("false", "ok false")
  pb_chk("False", "ok false")
  pb_chk("1", "ok true")
  pb_chk("t", "ok true")
  pb_chk("T", "ok true")
  pb_chk("TRUE", "ok true")
  pb_chk("true", "ok true")
  pb_chk("True", "ok true")
}

test "FormatBool" {
  assert_eq format_bool(true), "true"
  assert_eq format_bool(false), "false"
}

test "AppendBool" {
  assert_eq Str.from_bytes(append_bool("foo ".bytes.to_a, true)), "foo true"
  assert_eq Str.from_bytes(append_bool("foo ".bytes.to_a, false)), "foo false"
}
