  atoc_chk("+0x1p1024", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+0x1p1024\": value out of range")
  atoc_chk("+0x1p1024", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+0x1p1024\": value out of range")
  atoc_chk("-0x1p1024", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-0x1p1024\": value out of range")
