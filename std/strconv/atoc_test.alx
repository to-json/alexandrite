  atoc_chk("+0x1p1024-0x1p1024i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+0x1p1024-0x1p1024i\": value out of range")
  atoc_chk("-0x1p1024+0x1p1024i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-0x1p1024+0x1p1024i\": value out of range")
  atoc_chk("-0x1p1024+0x1p1024i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-0x1p1024+0x1p1024i\": value out of range")
  atoc_chk("-0x1p1024-0x1p1024i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-0x1p1024-0x1p1024i\": value out of range")
  atoc_chk("-0x1p1024-0x1p1024i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-0x1p1024-0x1p1024i\": value out of range")
  atoc_chk("+0x1.fffffffffffff7fffp1023+0x1.fffffffffffff7fffp1023i", 128, 1.7976931348623157e308, 1.7976931348623157e308, "")
  atoc_chk("+0x1.fffffffffffff7fffp1023-0x1.fffffffffffff7fffp1023i", 128, 1.7976931348623157e308, (-1.7976931348623157e308), "")
  atoc_chk("-0x1.fffffffffffff7fffp1023+0x1.fffffffffffff7fffp1023i", 128, (-1.7976931348623157e308), 1.7976931348623157e308, "")
  atoc_chk("-0x1.fffffffffffff7fffp1023-0x1.fffffffffffff7fffp1023i", 128, (-1.7976931348623157e308), (-1.7976931348623157e308), "")
  atoc_chk("+0x1.fffffffffffff8p1023", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+0x1.fffffffffffff8p1023\": value out of range")
  atoc_chk("+0x1.fffffffffffff8p1023", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+0x1.fffffffffffff8p1023\": value out of range")
  atoc_chk("-0x1fffffffffffff.8p+971", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-0x1fffffffffffff.8p+971\": value out of range")
  atoc_chk("-0x1fffffffffffff.8p+971", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-0x1fffffffffffff.8p+971\": value out of range")
  atoc_chk("+0x1.fffffffffffff8p1023i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+0x1.fffffffffffff8p1023i\": value out of range")
