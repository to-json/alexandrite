  atoc_chk("0x_10.3p-8+0x3p3i", 128, 0.063232421875, 24.0, "")
  atoc_chk("0x_10.3p-8+0x3p3i", 64, 0.063232421875, 24.0, "")
  atoc_chk("+0x_1_0.3p-8+0x_3_0p3i", 128, 0.063232421875, 384.0, "")
  atoc_chk("+0x_1_0.3p-8+0x_3_0p3i", 64, 0.063232421875, 384.0, "")
  atoc_chk("0x1_0.3p+8-0x_3p3i", 128, 4144.0, (-24.0), "")
  atoc_chk("0x1_0.3p+8-0x_3p3i", 64, 4144.0, (-24.0), "")
  atoc_chk("0x10.3p-8+0x3p3i", 128, 0.063232421875, 24.0, "")
  atoc_chk("0x10.3p-8+0x3p3i", 64, 0.063232421875, 24.0, "")
  atoc_chk("+0x10.3p-8+0x3p3i", 128, 0.063232421875, 24.0, "")
  atoc_chk("+0x10.3p-8+0x3p3i", 64, 0.063232421875, 24.0, "")
  atoc_chk("0x10.3p+8-0x3p3i", 128, 4144.0, (-24.0), "")
  atoc_chk("0x10.3p+8-0x3p3i", 64, 4144.0, (-24.0), "")
  atoc_chk("0x1p0", 128, 1.0, 0.0, "")
