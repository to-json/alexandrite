  atoc_chk("-0x1fffffffffffff8p+967-0x1fffffffffffff8p+967i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-0x1fffffffffffff8p+967-0x1fffffffffffff8p+967i\": value out of range")
  atoc_chk("-0x1fffffffffffff8p+967-0x1fffffffffffff8p+967i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-0x1fffffffffffff8p+967-0x1fffffffffffff8p+967i\": value out of range")
  atoc_chk("1e308+1e308i", 128, 1e308, 1e308, "")
  atoc_chk("2e308+2e308i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"2e308+2e308i\": value out of range")
  atoc_chk("2e308+2e308i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"2e308+2e308i\": value out of range")
}

test "ParseComplex 3" {
  atoc_chk("1e309+1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+1e309i\": value out of range")
