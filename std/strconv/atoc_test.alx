test "ParseComplexIncorrectBitSize" {
  atoc_chk("1.5e308+1.0e307i", 0, 1.5e308, 1.0e307, "")
  atoc_chk("1.5e308+1.0e307i", 10, 1.5e308, 1.0e307, "")
  atoc_chk("1.5e308+1.0e307i", 100, 1.5e308, 1.0e307, "")
  atoc_chk("1.5e308+1.0e307i", 256, 1.5e308, 1.0e307, "")
}
