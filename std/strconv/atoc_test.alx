  atoc_chk("-1i", 64, 0.0, (-1.0), "")
  atoc_chk("+3+1i", 128, 3.0, 1.0, "")
  atoc_chk("+3+1i", 64, 3.0, 1.0, "")
  atoc_chk("30+3i", 128, 30.0, 3.0, "")
  atoc_chk("30+3i", 64, 30.0, 3.0, "")
  atoc_chk("+3e+3-3e+3i", 128, 3000.0, (-3000.0), "")
  atoc_chk("+3e+3-3e+3i", 64, 3000.0, (-3000.0), "")
  atoc_chk("+3e+3+3e+3i", 128, 3000.0, 3000.0, "")
  atoc_chk("+3e+3+3e+3i", 64, 3000.0, 3000.0, "")
  atoc_chk("+3e+3+3e+3i+", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+3e+3+3e+3i+\": invalid syntax")
  atoc_chk("+3e+3+3e+3i+", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+3e+3+3e+3i+\": invalid syntax")
  atoc_chk("0.1", 128, 0.1, 0.0, "")
  atoc_chk("0.1i", 128, 0.0, 0.1, "")
  atoc_chk("0.1_2_3", 128, 0.123, 0.0, "")
  atoc_chk("+0x_3p3i", 128, 0.0, 24.0, "")
