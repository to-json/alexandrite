test "ParseFloatPrefix" {
  prefix_chk("1 ", 1)
  prefix_chk("1q", 1)
  prefix_chk("1+", 1)
  prefix_chk("1-", 1)
  prefix_chk("1<", 1)
  prefix_chk("1=", 1)
  prefix_chk("1>", 1)
  prefix_chk("1(", 1)
