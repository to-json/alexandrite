  atof_chk("1.7976931348623158e308", 64, "ok 1.7976931348623157e+308")
  atof_chk("-1.7976931348623158e308", 64, "ok -1.7976931348623157e+308")
  atof_chk("0x1.fffffffffffff7fffp1023", 64, "ok 1.7976931348623157e+308")
  atof_chk("-0x1.fffffffffffff7fffp1023", 64, "ok -1.7976931348623157e+308")
  atof_chk("1.797693134862315808e308", 64, "strconv.parse_float: parsing \"1.797693134862315808e308\": value out of range")
  atof_chk("1.797693134862315808e308", 32, "strconv.parse_float: parsing \"1.797693134862315808e308\": value out of range")
