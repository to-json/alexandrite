# Go's internal/strconv/atof_test.go (and strconv/number_test.go), translated: the
# tables are emitted from Go's own by a Go program; Go's results with alx's
# names in the messages. Go's range errors also return the clamped value; a
# ~T carries only the error (see the header of strconv.alx).

# Not translated: TestAtofSlow (Go's slow path switched on; alx has only
# the exact path, which every test here runs), the benchmarks. TestAtofRandom's
# random inputs are vectors (vec_atof_random_test.alx).
import "math"

#[track_caller]
def atof_chk(s: Str, bits: Int, want: Str) {
  r = parse_float(s, bits)
  got = "?"
  if v = r.ok {
    got = "ok #{format_float(v, "g", -1, bits == 32 ? 32 : 64)}"
  } else if e = r.err {
    got = "#{e}"
  }
  assert got == want, "parse_float(#{quote(s)}, #{bits}) = #{got}, want #{want} (#{caller_location})"
}

# Go's parseFloatPrefix: consumes want bytes of s, without an error.
#[track_caller]
def prefix_chk(s: Str, want: Int) {
  _, n, st = atof_core(s, 64)
  assert st == ST_OK && n == want, "parse_float_prefix(#{quote(s)}, 64) = #{n}, #{st}, want #{want} (#{caller_location})"
}

test "Atof" {
  atof_chk("", 64, "strconv.parse_float: parsing \"\": invalid syntax")
  atof_chk("", 32, "strconv.parse_float: parsing \"\": invalid syntax")
  atof_chk("1", 64, "ok 1")
  atof_chk("1", 32, "ok 1")
  atof_chk("+1", 64, "ok 1")
  atof_chk("+1", 32, "ok 1")
  atof_chk("1x", 64, "strconv.parse_float: parsing \"1x\": invalid syntax")
  atof_chk("1x", 32, "strconv.parse_float: parsing \"1x\": invalid syntax")
  atof_chk("1.1.", 64, "strconv.parse_float: parsing \"1.1.\": invalid syntax")
  atof_chk("1.1.", 32, "strconv.parse_float: parsing \"1.1.\": invalid syntax")
  atof_chk("1e23", 64, "ok 1e+23")
  atof_chk("1E23", 64, "ok 1e+23")
  atof_chk("100000000000000000000000", 64, "ok 1e+23")
  atof_chk("1e-100", 64, "ok 1e-100")
  atof_chk("123456700", 64, "ok 1.234567e+08")
  atof_chk("99999999999999974834176", 64, "ok 9.999999999999997e+22")
  atof_chk("100000000000000000000001", 64, "ok 1.0000000000000001e+23")
  atof_chk("100000000000000008388608", 64, "ok 1.0000000000000001e+23")
  atof_chk("100000000000000016777215", 64, "ok 1.0000000000000001e+23")
  atof_chk("100000000000000016777216", 64, "ok 1.0000000000000003e+23")
  atof_chk("-1", 64, "ok -1")
  atof_chk("-1", 32, "ok -1")
  atof_chk("-0.1", 64, "ok -0.1")
  atof_chk("-0", 64, "ok -0")
  atof_chk("-0", 32, "ok -0")
  atof_chk("1e-20", 64, "ok 1e-20")
  atof_chk("625e-3", 64, "ok 0.625")
  atof_chk("625e-3", 32, "ok 0.625")
  atof_chk("0x1p0", 64, "ok 1")
  atof_chk("0x1p0", 32, "ok 1")
  atof_chk("0x1p1", 64, "ok 2")
  atof_chk("0x1p1", 32, "ok 2")
  atof_chk("0x1p-1", 64, "ok 0.5")
  atof_chk("0x1p-1", 32, "ok 0.5")
  atof_chk("0x1ep-1", 64, "ok 15")
  atof_chk("0x1ep-1", 32, "ok 15")
  atof_chk("-0x1ep-1", 64, "ok -15")
  atof_chk("-0x1ep-1", 32, "ok -15")
  atof_chk("-0x1_ep-1", 64, "ok -15")
  atof_chk("-0x1_ep-1", 32, "ok -15")
  atof_chk("0x1p-200", 64, "ok 6.223015277861142e-61")
  atof_chk("0x1p200", 64, "ok 1.6069380442589903e+60")
  atof_chk("0x1fFe2.p0", 64, "ok 131042")
  atof_chk("0x1fFe2.p0", 32, "ok 131042")
  atof_chk("0x1fFe2.P0", 64, "ok 131042")
  atof_chk("0x1fFe2.P0", 32, "ok 131042")
  atof_chk("-0x2p3", 64, "ok -16")
  atof_chk("-0x2p3", 32, "ok -16")
  atof_chk("0x0.fp4", 64, "ok 15")
  atof_chk("0x0.fp4", 32, "ok 15")
  atof_chk("0x0.fp0", 64, "ok 0.9375")
  atof_chk("0x0.fp0", 32, "ok 0.9375")
  atof_chk("0x1e2", 64, "strconv.parse_float: parsing \"0x1e2\": invalid syntax")
  atof_chk("0x1e2", 32, "strconv.parse_float: parsing \"0x1e2\": invalid syntax")
  atof_chk("1p2", 64, "strconv.parse_float: parsing \"1p2\": invalid syntax")
  atof_chk("1p2", 32, "strconv.parse_float: parsing \"1p2\": invalid syntax")
  atof_chk("0", 64, "ok 0")
  atof_chk("0", 32, "ok 0")
  atof_chk("0e0", 64, "ok 0")
  atof_chk("0e0", 32, "ok 0")
  atof_chk("-0e0", 64, "ok -0")
  atof_chk("-0e0", 32, "ok -0")
  atof_chk("+0e0", 64, "ok 0")
  atof_chk("+0e0", 32, "ok 0")
  atof_chk("0e-0", 64, "ok 0")
  atof_chk("0e-0", 32, "ok 0")
  atof_chk("-0e-0", 64, "ok -0")
  atof_chk("-0e-0", 32, "ok -0")
  atof_chk("+0e-0", 64, "ok 0")
  atof_chk("+0e-0", 32, "ok 0")
  atof_chk("0e+0", 64, "ok 0")
  atof_chk("0e+0", 32, "ok 0")
  atof_chk("-0e+0", 64, "ok -0")
  atof_chk("-0e+0", 32, "ok -0")
  atof_chk("+0e+0", 64, "ok 0")
  atof_chk("+0e+0", 32, "ok 0")
  atof_chk("0e+01234567890123456789", 64, "ok 0")
  atof_chk("0e+01234567890123456789", 32, "ok 0")
  atof_chk("0.00e-01234567890123456789", 64, "ok 0")
  atof_chk("0.00e-01234567890123456789", 32, "ok 0")
  atof_chk("-0e+01234567890123456789", 64, "ok -0")
  atof_chk("-0e+01234567890123456789", 32, "ok -0")
  atof_chk("-0.00e-01234567890123456789", 64, "ok -0")
  atof_chk("-0.00e-01234567890123456789", 32, "ok -0")
  atof_chk("0x0p+01234567890123456789", 64, "ok 0")
  atof_chk("0x0p+01234567890123456789", 32, "ok 0")
  atof_chk("0x0.00p-01234567890123456789", 64, "ok 0")
  atof_chk("0x0.00p-01234567890123456789", 32, "ok 0")
  atof_chk("-0x0p+01234567890123456789", 64, "ok -0")
  atof_chk("-0x0p+01234567890123456789", 32, "ok -0")
  atof_chk("-0x0.00p-01234567890123456789", 64, "ok -0")
  atof_chk("-0x0.00p-01234567890123456789", 32, "ok -0")
  atof_chk("0e291", 64, "ok 0")
  atof_chk("0e291", 32, "ok 0")
  atof_chk("0e292", 64, "ok 0")
  atof_chk("0e292", 32, "ok 0")
  atof_chk("0e347", 64, "ok 0")
  atof_chk("0e347", 32, "ok 0")
  atof_chk("0e348", 64, "ok 0")
  atof_chk("0e348", 32, "ok 0")
}

