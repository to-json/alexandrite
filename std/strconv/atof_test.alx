  atof_chk("-1.797693134862315808e308", 32, "strconv.parse_float: parsing \"-1.797693134862315808e308\": value out of range")
  atof_chk("0x1.fffffffffffff8p1023", 64, "strconv.parse_float: parsing \"0x1.fffffffffffff8p1023\": value out of range")
}

