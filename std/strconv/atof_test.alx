test "RoundTrip" {
  assert_eq format_float(4.87402195346389e27, "g", -1, 64), "4.87402195346389e+27"
  assert_eq parse_float("4.87402195346389e+27").unwrap, 4.87402195346389e27
  assert_eq format_float(4.8740219534638903e27, "g", -1, 64), "4.8740219534638903e+27"
  assert_eq parse_float("4.8740219534638903e+27").unwrap, 4.8740219534638903e27
}

test "ParseFloatIncorrectBitSize" {
  assert_eq parse_float("1.5e308", 0).unwrap, 1.5e308
  assert_eq parse_float("1.5e308", 10).unwrap, 1.5e308
  assert_eq parse_float("1.5e308", 100).unwrap, 1.5e308
  assert_eq parse_float("1.5e308", 128).unwrap, 1.5e308
}
