# Go's internal/strconv/atoi_test.go (and strconv/number_test.go), translated: the
# tables are emitted from Go's own by a Go program; Go's results with alx's
# names in the messages. Go's range errors also return the clamped value; a
# ~T carries only the error (see the header of strconv.alx).

#[track_caller]
def pu_chk(s: Str, base: Int, bits: Int, want: Str) {
  r = parse_uint(s, base, bits)
  got = "?"
  if v = r.ok {
    got = "ok #{v}"
  } else if e = r.err {
    got = "#{e}"
  }
  assert got == want, "parse_uint(#{quote(s)}, #{base}, #{bits}) = #{got}, want #{want} (#{caller_location})"
}

#[track_caller]
def pi_chk(s: Str, base: Int, bits: Int, want: Str) {
  r = parse_int(s, base, bits)
  got = "?"
  if v = r.ok {
    got = "ok #{v}"
  } else if e = r.err {
    got = "#{e}"
  }
  assert got == want, "parse_int(#{quote(s)}, #{base}, #{bits}) = #{got}, want #{want} (#{caller_location})"
}

#[track_caller]
def atoi_chk(s: Str, want: Str) {
  r = atoi(s)
  got = "?"
  if v = r.ok {
    got = "ok #{v}"
  } else if e = r.err {
    got = "#{e}"
  }
  assert got == want, "atoi(#{quote(s)}) = #{got}, want #{want} (#{caller_location})"
}

test "ParseUint32" {
  pu_chk("", 10, 32, "strconv.parse_uint: parsing \"\": invalid syntax")
  pu_chk("0", 10, 32, "ok 0")
  pu_chk("1", 10, 32, "ok 1")
  pu_chk("12345", 10, 32, "ok 12345")
  pu_chk("012345", 10, 32, "ok 12345")
  pu_chk("12345x", 10, 32, "strconv.parse_uint: parsing \"12345x\": invalid syntax")
  pu_chk("987654321", 10, 32, "ok 987654321")
  pu_chk("4294967295", 10, 32, "ok 4294967295")
  pu_chk("4294967296", 10, 32, "strconv.parse_uint: parsing \"4294967296\": value out of range")
  pu_chk("1_2_3_4_5", 10, 32, "strconv.parse_uint: parsing \"1_2_3_4_5\": invalid syntax")
  pu_chk("_12345", 10, 32, "strconv.parse_uint: parsing \"_12345\": invalid syntax")
  pu_chk("_12345", 10, 32, "strconv.parse_uint: parsing \"_12345\": invalid syntax")
  pu_chk("1__2345", 10, 32, "strconv.parse_uint: parsing \"1__2345\": invalid syntax")
  pu_chk("12345_", 10, 32, "strconv.parse_uint: parsing \"12345_\": invalid syntax")
}

test "ParseUint64" {
  pu_chk("", 10, 64, "strconv.parse_uint: parsing \"\": invalid syntax")
  pu_chk("0", 10, 64, "ok 0")
  pu_chk("1", 10, 64, "ok 1")
  pu_chk("12345", 10, 64, "ok 12345")
  pu_chk("012345", 10, 64, "ok 12345")
  pu_chk("12345x", 10, 64, "strconv.parse_uint: parsing \"12345x\": invalid syntax")
  pu_chk("98765432100", 10, 64, "ok 98765432100")
  pu_chk("18446744073709551615", 10, 64, "ok 18446744073709551615")
  pu_chk("18446744073709551616", 10, 64, "strconv.parse_uint: parsing \"18446744073709551616\": value out of range")
  pu_chk("18446744073709551620", 10, 64, "strconv.parse_uint: parsing \"18446744073709551620\": value out of range")
  pu_chk("1_2_3_4_5", 10, 64, "strconv.parse_uint: parsing \"1_2_3_4_5\": invalid syntax")
  pu_chk("_12345", 10, 64, "strconv.parse_uint: parsing \"_12345\": invalid syntax")
  pu_chk("1__2345", 10, 64, "strconv.parse_uint: parsing \"1__2345\": invalid syntax")
  pu_chk("12345_", 10, 64, "strconv.parse_uint: parsing \"12345_\": invalid syntax")
  pu_chk("-0", 10, 64, "strconv.parse_uint: parsing \"-0\": invalid syntax")
  pu_chk("-1", 10, 64, "strconv.parse_uint: parsing \"-1\": invalid syntax")
  pu_chk("+1", 10, 64, "strconv.parse_uint: parsing \"+1\": invalid syntax")
}

test "ParseUint64Base" {
  pu_chk("", 0, 64, "strconv.parse_uint: parsing \"\": invalid syntax")
  pu_chk("0", 0, 64, "ok 0")
  pu_chk("0x", 0, 64, "strconv.parse_uint: parsing \"0x\": invalid syntax")
  pu_chk("0X", 0, 64, "strconv.parse_uint: parsing \"0X\": invalid syntax")
  pu_chk("1", 0, 64, "ok 1")
  pu_chk("12345", 0, 64, "ok 12345")
  pu_chk("012345", 0, 64, "ok 5349")
  pu_chk("0x12345", 0, 64, "ok 74565")
  pu_chk("0X12345", 0, 64, "ok 74565")
  pu_chk("12345x", 0, 64, "strconv.parse_uint: parsing \"12345x\": invalid syntax")
  pu_chk("0xabcdefg123", 0, 64, "strconv.parse_uint: parsing \"0xabcdefg123\": invalid syntax")
  pu_chk("123456789abc", 0, 64, "strconv.parse_uint: parsing \"123456789abc\": invalid syntax")
  pu_chk("98765432100", 0, 64, "ok 98765432100")
  pu_chk("18446744073709551615", 0, 64, "ok 18446744073709551615")
  pu_chk("18446744073709551616", 0, 64, "strconv.parse_uint: parsing \"18446744073709551616\": value out of range")
  pu_chk("18446744073709551620", 0, 64, "strconv.parse_uint: parsing \"18446744073709551620\": value out of range")
  pu_chk("0xFFFFFFFFFFFFFFFF", 0, 64, "ok 18446744073709551615")
  pu_chk("0x10000000000000000", 0, 64, "strconv.parse_uint: parsing \"0x10000000000000000\": value out of range")
  pu_chk("01777777777777777777777", 0, 64, "ok 18446744073709551615")
  pu_chk("01777777777777777777778", 0, 64, "strconv.parse_uint: parsing \"01777777777777777777778\": invalid syntax")
  pu_chk("02000000000000000000000", 0, 64, "strconv.parse_uint: parsing \"02000000000000000000000\": value out of range")
  pu_chk("0200000000000000000000", 0, 64, "ok 2305843009213693952")
  pu_chk("0b", 0, 64, "strconv.parse_uint: parsing \"0b\": invalid syntax")
  pu_chk("0B", 0, 64, "strconv.parse_uint: parsing \"0B\": invalid syntax")
  pu_chk("0b101", 0, 64, "ok 5")
  pu_chk("0B101", 0, 64, "ok 5")
  pu_chk("0o", 0, 64, "strconv.parse_uint: parsing \"0o\": invalid syntax")
  pu_chk("0O", 0, 64, "strconv.parse_uint: parsing \"0O\": invalid syntax")
  pu_chk("0o377", 0, 64, "ok 255")
  pu_chk("0O377", 0, 64, "ok 255")
  pu_chk("1_2_3_4_5", 0, 64, "ok 12345")
  pu_chk("_12345", 0, 64, "strconv.parse_uint: parsing \"_12345\": invalid syntax")
  pu_chk("1__2345", 0, 64, "strconv.parse_uint: parsing \"1__2345\": invalid syntax")
  pu_chk("12345_", 0, 64, "strconv.parse_uint: parsing \"12345_\": invalid syntax")
  pu_chk("1_2_3_4_5", 10, 64, "strconv.parse_uint: parsing \"1_2_3_4_5\": invalid syntax")
  pu_chk("_12345", 10, 64, "strconv.parse_uint: parsing \"_12345\": invalid syntax")
  pu_chk("1__2345", 10, 64, "strconv.parse_uint: parsing \"1__2345\": invalid syntax")
  pu_chk("12345_", 10, 64, "strconv.parse_uint: parsing \"12345_\": invalid syntax")
  pu_chk("0x_1_2_3_4_5", 0, 64, "ok 74565")
  pu_chk("_0x12345", 0, 64, "strconv.parse_uint: parsing \"_0x12345\": invalid syntax")
  pu_chk("0x__12345", 0, 64, "strconv.parse_uint: parsing \"0x__12345\": invalid syntax")
  pu_chk("0x1__2345", 0, 64, "strconv.parse_uint: parsing \"0x1__2345\": invalid syntax")
  pu_chk("0x1234__5", 0, 64, "strconv.parse_uint: parsing \"0x1234__5\": invalid syntax")
  pu_chk("0x12345_", 0, 64, "strconv.parse_uint: parsing \"0x12345_\": invalid syntax")
  pu_chk("1_2_3_4_5", 16, 64, "strconv.parse_uint: parsing \"1_2_3_4_5\": invalid syntax")
  pu_chk("_12345", 16, 64, "strconv.parse_uint: parsing \"_12345\": invalid syntax")
  pu_chk("1__2345", 16, 64, "strconv.parse_uint: parsing \"1__2345\": invalid syntax")
  pu_chk("1234__5", 16, 64, "strconv.parse_uint: parsing \"1234__5\": invalid syntax")
  pu_chk("12345_", 16, 64, "strconv.parse_uint: parsing \"12345_\": invalid syntax")
  pu_chk("0_1_2_3_4_5", 0, 64, "ok 5349")
  pu_chk("_012345", 0, 64, "strconv.parse_uint: parsing \"_012345\": invalid syntax")
  pu_chk("0__12345", 0, 64, "strconv.parse_uint: parsing \"0__12345\": invalid syntax")
  pu_chk("01234__5", 0, 64, "strconv.parse_uint: parsing \"01234__5\": invalid syntax")
  pu_chk("012345_", 0, 64, "strconv.parse_uint: parsing \"012345_\": invalid syntax")
  pu_chk("0o_1_2_3_4_5", 0, 64, "ok 5349")
  pu_chk("_0o12345", 0, 64, "strconv.parse_uint: parsing \"_0o12345\": invalid syntax")
  pu_chk("0o__12345", 0, 64, "strconv.parse_uint: parsing \"0o__12345\": invalid syntax")
  pu_chk("0o1234__5", 0, 64, "strconv.parse_uint: parsing \"0o1234__5\": invalid syntax")
  pu_chk("0o12345_", 0, 64, "strconv.parse_uint: parsing \"0o12345_\": invalid syntax")
  pu_chk("0_1_2_3_4_5", 8, 64, "strconv.parse_uint: parsing \"0_1_2_3_4_5\": invalid syntax")
  pu_chk("_012345", 8, 64, "strconv.parse_uint: parsing \"_012345\": invalid syntax")
  pu_chk("0__12345", 8, 64, "strconv.parse_uint: parsing \"0__12345\": invalid syntax")
  pu_chk("01234__5", 8, 64, "strconv.parse_uint: parsing \"01234__5\": invalid syntax")
  pu_chk("012345_", 8, 64, "strconv.parse_uint: parsing \"012345_\": invalid syntax")
  pu_chk("0b_1_0_1", 0, 64, "ok 5")
  pu_chk("_0b101", 0, 64, "strconv.parse_uint: parsing \"_0b101\": invalid syntax")
  pu_chk("0b__101", 0, 64, "strconv.parse_uint: parsing \"0b__101\": invalid syntax")
  pu_chk("0b1__01", 0, 64, "strconv.parse_uint: parsing \"0b1__01\": invalid syntax")
  pu_chk("0b10__1", 0, 64, "strconv.parse_uint: parsing \"0b10__1\": invalid syntax")
  pu_chk("0b101_", 0, 64, "strconv.parse_uint: parsing \"0b101_\": invalid syntax")
  pu_chk("1_0_1", 2, 64, "strconv.parse_uint: parsing \"1_0_1\": invalid syntax")
  pu_chk("_101", 2, 64, "strconv.parse_uint: parsing \"_101\": invalid syntax")
  pu_chk("1_01", 2, 64, "strconv.parse_uint: parsing \"1_01\": invalid syntax")
  pu_chk("10_1", 2, 64, "strconv.parse_uint: parsing \"10_1\": invalid syntax")
  pu_chk("101_", 2, 64, "strconv.parse_uint: parsing \"101_\": invalid syntax")
