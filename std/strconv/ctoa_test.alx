# Go's internal/strconv/ctoa_test.go (and strconv/number_test.go), translated: the
# tables are emitted from Go's own by a Go program; Go's results with alx's
# names in the messages. Go's range errors also return the clamped value; a
# ~T carries only the error (see the header of strconv.alx).

test "FormatComplex" {
  assert_eq format_complex(Complex.new(1.0, 2.0), "g", -1, 128), "(1+2i)"
  assert_eq format_complex(Complex.new(3.0, (-4.0)), "g", -1, 128), "(3-4i)"
  assert_eq format_complex(Complex.new((-5.0), 6.0), "g", -1, 128), "(-5+6i)"
  assert_eq format_complex(Complex.new((-7.0), (-8.0)), "g", -1, 128), "(-7-8i)"
  assert_eq format_complex(Complex.new(3.14159, 0.00123), "e", 3, 128), "(3.142e+00+1.230e-03i)"
  assert_eq format_complex(Complex.new(3.14159, 0.00123), "f", 3, 128), "(3.142+0.001i)"
  assert_eq format_complex(Complex.new(3.14159, 0.00123), "g", 3, 128), "(3.14+0.00123i)"
  assert_eq format_complex(Complex.new(1.2345678901234567, 9.876543210987654), "f", -1, 128), "(1.2345678901234567+9.876543210987654i)"
  assert_eq format_complex(Complex.new(1.2345678901234567, 9.876543210987654), "f", -1, 64), "(1.2345679+9.876543i)"
}

test "FormatComplexInvalidBitSize" {
  assert_panics("illegal format_complex bit_size") { format_complex(Complex.new(1.0, 2.0), "g", -1, 100) }
}
