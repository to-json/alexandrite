# Go's internal/strconv/decimal_test.go (and strconv/number_test.go), translated: the
# tables are emitted from Go's own by a Go program; Go's results with alx's
# names in the messages. Go's range errors also return the clamped value; a
# ~T carries only the error (see the header of strconv.alx).

# Go's decimal.String.
def dec_s(a: Dec) -> Str {
  buf: [U8] = []
  if a.nd == 0 {
    return "0"
  }
  if a.dp <= 0 {
    buf << 48
    buf << 46
    for _ in 0...-a.dp {
      buf << 48
    }
    for i in 0...a.nd {
      buf << a.d[i]
    }
  } else if a.dp < a.nd {
    for i in 0...a.dp {
      buf << a.d[i]
    }
    buf << 46
    for i in a.dp...a.nd {
      buf << a.d[i]
    }
  } else {
    for i in 0...a.nd {
      buf << a.d[i]
    }
    for _ in a.nd...a.dp {
      buf << 48
    }
  }
  Str.from_bytes(buf)
}

def new_decimal(i: U64) -> Dec {
  d = new_dec()
  d.assign!(i)
  d
}

#[track_caller]
def shift_chk(i: U64, shift: Int, want: Str) {
  d = new_decimal(i)
  d.shift!(shift)
  assert_eq dec_s(d), want
}

#[track_caller]
def round_chk(i: U64, nd: Int, down: Str, round: Str, up: Str) {
  d = new_decimal(i)
  d.round_down!(nd)
  assert_eq dec_s(d), down
  d = new_decimal(i)
  d.round!(nd)
  assert_eq dec_s(d), round
  d = new_decimal(i)
  d.round_up!(nd)
  assert_eq dec_s(d), up
}

#[track_caller]
def rounded_int_chk(i: U64, shift: Int, want: U64) {
  d = new_decimal(i)
  d.shift!(shift)
  assert_eq d.rounded_integer, want
}

test "DecimalShift" {
  shift_chk(0, -100, "0")
  shift_chk(0, 100, "0")
  shift_chk(1, 100, "1267650600228229401496703205376")
  shift_chk(1, -100, "0.0000000000000000000000000000007888609052210118054117285652827862296732064351090230047702789306640625")
  shift_chk(12345678, 8, "3160493568")
  shift_chk(12345678, -8, "48225.3046875")
  shift_chk(195312, 9, "99999744")
  shift_chk(1953125, 9, "1000000000")
}

test "DecimalRound" {
  round_chk(0, 4, "0", "0", "0")
  round_chk(12344999, 4, "12340000", "12340000", "12350000")
  round_chk(12345000, 4, "12340000", "12340000", "12350000")
  round_chk(12345001, 4, "12340000", "12350000", "12350000")
  round_chk(23454999, 4, "23450000", "23450000", "23460000")
  round_chk(23455000, 4, "23450000", "23460000", "23460000")
  round_chk(23455001, 4, "23450000", "23460000", "23460000")
  round_chk(99994999, 4, "99990000", "99990000", "100000000")
  round_chk(99995000, 4, "99990000", "100000000", "100000000")
  round_chk(99999999, 4, "99990000", "100000000", "100000000")
  round_chk(12994999, 4, "12990000", "12990000", "13000000")
  round_chk(12995000, 4, "12990000", "13000000", "13000000")
  round_chk(12999999, 4, "12990000", "13000000", "13000000")
}

test "DecimalRoundedInteger" {
  rounded_int_chk(0, 100, 0)
  rounded_int_chk(512, -8, 2)
  rounded_int_chk(513, -8, 2)
  rounded_int_chk(640, -8, 2)
  rounded_int_chk(641, -8, 3)
  rounded_int_chk(384, -8, 2)
  rounded_int_chk(385, -8, 2)
  rounded_int_chk(383, -8, 1)
  rounded_int_chk(1, 100, 18446744073709551615)
  rounded_int_chk(1000, 0, 1000)
}
