#![test(external)]
# Go's strconv/example_test.go, translated. `%T` prints alx's type names
# (Int, Str, Float, U64, Bool); Go's `<nil>` error is printed by hand.
import "fmt"
import "strconv"

example "AppendBool" {
  b = "bool:".bytes.to_a
  b = strconv.append_bool(b, true)
  puts Str.from_bytes(b)
} outputs "bool:true\n"

example "AppendFloat" {
  b32 = strconv.append_float("float32:".bytes.to_a, 3.1415926535, "E", -1, 32)
  puts Str.from_bytes(b32)
  b64 = strconv.append_float("float64:".bytes.to_a, 3.1415926535, "E", -1, 64)
  puts Str.from_bytes(b64)
} outputs "float32:3.1415927E+00\nfloat64:3.1415926535E+00\n"

example "AppendInt" {
  puts Str.from_bytes(strconv.append_int("int (base 10):".bytes.to_a, -42, 10))
  puts Str.from_bytes(strconv.append_int("int (base 16):".bytes.to_a, -42, 16))
} outputs "int (base 10):-42\nint (base 16):-2a\n"

example "AppendQuote" {
  puts Str.from_bytes(strconv.append_quote("quote:".bytes.to_a, "\"Fran & Freddie's Diner\""))
} outputs "quote:\"\\\"Fran & Freddie's Diner\\\"\"\n"

example "AppendQuoteRune" {
  puts Str.from_bytes(strconv.append_quote_rune("rune:".bytes.to_a, 0x263a))
} outputs "rune:'☺'\n"

example "AppendQuoteRuneToASCII" {
  puts Str.from_bytes(strconv.append_quote_rune_to_ascii("rune (ascii):".bytes.to_a, 0x263a))
} outputs "rune (ascii):'\\u263a'\n"

example "AppendQuoteToASCII" {
  puts Str.from_bytes(strconv.append_quote_to_ascii("quote (ascii):".bytes.to_a, "\"Fran & Freddie's Diner\""))
} outputs "quote (ascii):\"\\\"Fran & Freddie's Diner\\\"\"\n"

example "AppendUint" {
  puts Str.from_bytes(strconv.append_uint("uint (base 10):".bytes.to_a, 42, 10))
  puts Str.from_bytes(strconv.append_uint("uint (base 16):".bytes.to_a, 42, 16))
} outputs "uint (base 10):42\nuint (base 16):2a\n"

example "Atoi" {
  if s = strconv.atoi("10").ok {
    print fmt.sprintf("%T, %v", s, s)
  }
} outputs "Int, 10"

example "CanBackquote" {
  puts strconv.can_backquote("Fran & Freddie's Diner ☺")
  puts strconv.can_backquote("`can't backquote this`")
} outputs "true\nfalse\n"

example "FormatBool" {
  s = strconv.format_bool(true)
  puts fmt.sprintf("%T, %v", s, s)
} outputs "Str, true\n"

example "FormatFloat" {
  v = 3.1415926535
  s32 = strconv.format_float(v, "E", -1, 32)
  puts fmt.sprintf("%T, %v", s32, s32)
  s64 = strconv.format_float(v, "E", -1, 64)
  puts fmt.sprintf("%T, %v", s64, s64)
  fmt64 = strconv.format_float(v, "g", -1, 64)
  puts fmt.sprintf("%T, %v", fmt64, fmt64)
} outputs "Str, 3.1415927E+00\nStr, 3.1415926535E+00\nStr, 3.1415926535\n"

example "FormatInt" {
  puts strconv.format_int(-42, 10)
  puts strconv.format_int(-42, 16)
} outputs "-42\n-2a\n"

example "FormatUint" {
  puts strconv.format_uint(42, 10)
  puts strconv.format_uint(42, 16)
} outputs "42\n2a\n"

example "IsGraphic" {
  puts strconv.is_graphic(0x2618)
  puts strconv.is_graphic(97)
  puts strconv.is_graphic(7)
} outputs "true\ntrue\nfalse\n"

example "IsPrint" {
  puts strconv.is_print(0x263a)
  puts strconv.is_print(7)
} outputs "true\nfalse\n"

example "Itoa" {
  s = strconv.itoa(10)
  puts fmt.sprintf("%T, %v", s, s)
} outputs "Str, 10\n"

example "ParseBool" {
  if s = strconv.parse_bool("true").ok {
    puts fmt.sprintf("%T, %v", s, s)
  }
} outputs "Bool, true\n"

example "ParseFloat" {
  v = "3.1415926535"
  for s, bits in [(v, 32), (v, 64), ("NaN", 32), ("nan", 32), ("inf", 32), ("+Inf", 32), ("-Inf", 32), ("-0", 32), ("+0", 32)] {
    if f = strconv.parse_float(s, bits).ok {
      puts fmt.sprintf("%T, %v", f, f)
    }
  }
} outputs "Float, 3.1415927410125732\nFloat, 3.1415926535\nFloat, NaN\nFloat, NaN\nFloat, +Inf\nFloat, +Inf\nFloat, -Inf\nFloat, -0\nFloat, 0\n"

example "ParseInt" {
  v32 = "-354634382"
  if s = strconv.parse_int(v32, 10, 32).ok {
    puts fmt.sprintf("%T, %v", s, s)
  }
  if s = strconv.parse_int(v32, 16, 32).ok {
    puts fmt.sprintf("%T, %v", s, s)
  }
  v64 = "-3546343826724305832"
  if s = strconv.parse_int(v64, 10, 64).ok {
    puts fmt.sprintf("%T, %v", s, s)
  }
  if s = strconv.parse_int(v64, 16, 64).ok {
    puts fmt.sprintf("%T, %v", s, s)
  }
} outputs "Int, -354634382\nInt, -3546343826724305832\n"

example "ParseUint" {
  if s = strconv.parse_uint("42", 10, 32).ok {
    puts fmt.sprintf("%T, %v", s, s)
  }
  if s = strconv.parse_uint("42", 10, 64).ok {
    puts fmt.sprintf("%T, %v", s, s)
  }
} outputs "U64, 42\nU64, 42\n"

example "Quote" {
  puts strconv.quote("\"Fran & Freddie's Diner\t☺\"")
} outputs "\"\\\"Fran & Freddie's Diner\\t☺\\\"\"\n"

example "QuoteRune" {
  puts strconv.quote_rune(0x263a)
} outputs "'☺'\n"

example "QuoteRuneToASCII" {
  puts strconv.quote_rune_to_ascii(0x263a)
} outputs "'\\u263a'\n"

example "QuoteRuneToGraphic" {
  puts strconv.quote_rune_to_graphic(0x263a)
  puts strconv.quote_rune_to_graphic(0x263a)
  puts strconv.quote_rune_to_graphic(10)
  puts strconv.quote_rune_to_graphic(9)
} outputs "'☺'\n'☺'\n'\\n'\n'\\t'\n"

example "QuoteToASCII" {
  puts strconv.quote_to_ascii("\"Fran & Freddie's Diner\t☺\"")
} outputs "\"\\\"Fran & Freddie's Diner\\t\\u263a\\\"\"\n"

example "QuoteToGraphic" {
  puts strconv.quote_to_graphic("☺")
  puts strconv.quote_to_graphic("This is a \u263a\t\n")
  puts strconv.quote_to_graphic("\" This is a ☺ \\n \"")
} outputs "\"☺\"\n\"This is a ☺\\t\\n\"\n\"\\\" This is a ☺ \\\\n \\\"\"\n"

def show(r: ~Str) -> Str {
  if e = r.err {
    return fmt.sprintf("%q, %v", "", e.message)
  }
  fmt.sprintf("%q, <nil>", r.unwrap)
}

example "QuotedPrefix" {
  puts show(strconv.quoted_prefix("not a quoted string"))
  puts show(strconv.quoted_prefix("\"double-quoted string\" with trailing text"))
  puts show(strconv.quoted_prefix("`or backquoted` with more trailing text"))
  puts show(strconv.quoted_prefix("'\u263a' is also okay"))
} outputs "\"\", invalid syntax\n\"\\\"double-quoted string\\\"\", <nil>\n\"`or backquoted`\", <nil>\n\"'☺'\", <nil>\n"

example "Unquote" {
  puts show(strconv.unquote("You can't unquote a string without quotes"))
  puts show(strconv.unquote("\"The string must be either double-quoted\""))
  puts show(strconv.unquote("`or backquoted.`"))
  puts show(strconv.unquote("'\u263a'"))
  puts show(strconv.unquote("'\u2639\u2639'"))
} outputs "\"\", invalid syntax\n\"The string must be either double-quoted\", <nil>\n\"or backquoted.\", <nil>\n\"☺\", <nil>\n\"\", invalid syntax\n"

example "UnquoteChar" {
  v, mb, t = strconv.unquote_char("\\\"Fran & Freddie's Diner\\\"", 34).unwrap
  puts "value: #{Str.from_bytes([v.as_u8])}"
  puts "multibyte: #{mb}"
  puts "tail: #{t}"
} outputs "value: \"\nmultibyte: false\ntail: Fran & Freddie's Diner\\\"\n"

example "NumError" {
  if e = strconv.parse_float("Not a number", 64).err {
    puts "Func: #{e.func_name}"
    puts "Num: #{e.num}"
    puts "Err: #{e.unwrap?.message || ""}"
    puts e
  }
} outputs "Func: parse_float\nNum: Not a number\nErr: invalid syntax\nstrconv.parse_float: parsing \"Not a number\": invalid syntax\n"
