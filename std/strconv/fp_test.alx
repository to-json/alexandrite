# Go's internal/strconv/fp_test.go, and the loops of atof_test.go
# (TestRoundTrip32) and ftoa_test.go (TestFtoaPowersOfTwo), translated.
#
# Go's TestParseFloatTestdata and TestFormatFloatTestdata compare its
# optimized and unoptimized paths on testdata/atof1k.txt and ftoa1k.txt; alx
# has one (exact) path, so they compare with Go's results instead
# (testdata/*-go.txt, generated by a Go program). The -testbase flag (the
# full data set, downloaded) isn't translated. TestRoundTrip32 takes Go's
# -short step.
import "math"
import "os"

# Go's float32(f): f rounded to the nearest float32 (ties to even), as a
# Float.
def to_f32(f: Float) -> Float {
  return f if f != f || f == 0.0 || math.is_inf(f, 0)
  b = math.float64bits(f)
  neg = (b >> 63) == 1
  e = ((b >> 52) & 0x7FF).to_i
  return neg ? math.float64frombits(0x8000000000000000) : 0.0 if e == 0
  m = (b & 0xFFFFFFFFFFFFF) | 0x10000000000000
  ue = e - 1023
  shift = 29
  shift += -126 - ue if ue < -126
  return neg ? math.float64frombits(0x8000000000000000) : 0.0 if shift > 54
  one: U64 = 1
  half = one << (shift - 1)
  low = m & ((one << shift) - 1)
  r = m >> shift
  r += 1 if low > half || (low == half && (r & 1) == 1)
  v = math.ldexp(r.to_f, e - 1075 + shift)
  if v > 3.4028234663852886e38 {
    v = math.inf(1)
  }
  neg ? -v : v
}

# Go's math.Float32frombits, as a Float.
def f32_from_bits(u: U32) -> Float {
  neg = (u >> 31) == 1
  e = ((u >> 23) & 0xFF).to_i
  m = (u & 0x7FFFFF).to_u64
  v = 0.0
  if e == 0xFF {
    v = m == 0 ? math.inf(1) : math.nan()
  } else if e == 0 {
    v = math.ldexp(m.to_f, -149)
  } else {
    v = math.ldexp((m | 0x800000).to_f, e - 150)
  }
  neg ? -v : v
}

def fp_pow2(i: Int) -> Float {
  return 1.0 / fp_pow2(-i) if i < 0
  return 1.0 if i == 0
  return 2.0 if i == 1
  fp_pow2(i / 2) * fp_pow2(i - i / 2)
}

# Go's myatof64: ParseFloat, plus the dddddp+ddd binary exponent form.
def myatof64(s: Str) -> Float? {
  if k = fp_index(s, "p") {
    n = parse_int(s[0...k], 10, 64).ok || return none
    e = atoi(s[k + 1...s.size]).ok || return none
    v = n.to_f
    if e <= -1000 {
      v *= fp_pow2(-1000)
      e += 1000
      while e < 0 {
        v /= 2.0
        e += 1
      }
      return v
    }
    if e >= 1000 {
      v *= fp_pow2(1000)
      e -= 1000
      while e > 0 {
        v *= 2.0
        e -= 1
      }
      return v
    }
    return v * fp_pow2(e)
  }
  parse_float(s, 64).ok
}

# Go's myatof32.
def myatof32(s: Str) -> Float? {
  if k = fp_index(s, "p") {
    n = atoi(s[0...k]).ok || return none
    e = atoi(s[k + 1...s.size]).ok || return none
    return to_f32(n.to_f * fp_pow2(e))
  }
  to_f32(parse_float(s, 32).ok || return none)
}

# fmt.Sprintf(format, v) for the formats testfp.txt uses (%b, %.Ne).
def sprintf_fp(format: Str, v: Float, bits: Int) -> Str {
  return format_float(v, "b", -1, bits) if format == "%b"
  prec = atoi(format[2...format.size - 1]).unwrap
  format_float(v, "e", prec, bits)
}

test "Fp" {
  lineno = 0
  for line0 in Str.from_bytes(os.read_file("testdata/testfp.txt").unwrap).lines {
    lineno += 1
    line = line0
    if k = fp_index(line, "#") {
      line = line[0...k]
    }
    line = line.strip
    next if line == ""
    a = line.split(" ")
    assert a.size == 4, "testdata/testfp.txt:#{lineno}: wrong field count"
    s = ""
    if a[0] == "float64" {
      v = myatof64(a[2]) || 0.0
      assert myatof64(a[2]) != none, "testdata/testfp.txt:#{lineno}: cannot atof64 #{a[2]}"
      s = sprintf_fp(a[1], v, 64)
    } else {
      v = myatof32(a[2]) || 0.0
      assert myatof32(a[2]) != none, "testdata/testfp.txt:#{lineno}: cannot atof32 #{a[2]}"
      s = sprintf_fp(a[1], v, 32)
    }
    assert s == a[3], "testdata/testfp.txt:#{lineno}: #{line}: have #{s} want #{a[3]}"
  }
}

test "ParseFloatTestdata" {
  for line in Str.from_bytes(os.read_file("testdata/atof1k-go.txt").unwrap).lines {
    next if line.start_with?("#") || line.strip == ""
    f = line.strip.split(" ")
    want = parse_uint(f[1], 16, 64).unwrap
    have = parse_float(f[0], 64).unwrap
    assert math.float64bits(have) == want, "parse_float(#{f[0]}) = #{have}"
  }
}

test "FormatFloatTestdata" {
  for line in Str.from_bytes(os.read_file("testdata/ftoa1k-go.txt").unwrap).lines {
    next if line.start_with?("#") || line.strip == ""
    f = line.strip.split(" ")
    v = parse_float(f[0], 64).unwrap
    for i in 0...19 {
      assert_eq format_float(v, "e", i, 64), f[i + 1]
    }
  }
}

test "FtoaPowersOfTwo" {
  for exp in -2048..2048 {
    f = math.ldexp(1.0, exp)
    if !math.is_inf(f, 0) {
      s = format_float(f, "e", -1, 64)
      assert parse_float(s, 64).unwrap == f, "failed roundtrip #{f} => #{s}"
    }
    f32 = to_f32(f)
    if !math.is_inf(f32, 0) {
      s = format_float(f32, "e", -1, 32)
      x = parse_float(s, 32).unwrap
      assert to_f32(x) == f32, "failed roundtrip #{f32} => #{s} => #{x}"
    }
  }
}

# A fraction of all finite positive float32 values (Go's -short step).
test "RoundTrip32" {
  step: U32 = 99991
  i: U32 = 0
  while i < 0xFF << 23 {
    f = f32_from_bits(i)
    f = -f if i & 1 == 1
    s = format_float(f, "g", -1, 32)
    r = parse_float(s, 32)
    if e = r.err {
      assert false, "parse_float(#{quote(s)}, 32) gave error #{e}"
    }
    parsed = r.unwrap
    assert to_f32(parsed) == parsed, "parse_float(#{quote(s)}, 32) = #{parsed}, not a float32"
    assert parsed == f, "parse_float(#{quote(s)}, 32) = #{parsed}, want #{f}"
    i += step
  }
}

test "to_f32 helper" {
  assert_eq to_f32(0.1), 0.10000000149011612
  assert_eq to_f32(1.0000000596046448), 1.0
  assert_eq to_f32(1.0000000596046449), 1.0000001192092896
  assert_eq to_f32(1e-46), 0.0
  assert_eq to_f32(1e-45), 1.401298464324817e-45
  assert math.is_inf(to_f32(3.5e38), 1)
  assert_eq f32_from_bits(0x3F800000), 1.0
  assert_eq f32_from_bits(1), 1.401298464324817e-45
}

# The index of sub in s, if it is there.
def fp_index(s: Str, sub: Str) -> Int? {
  k = s.byteindex(sub)
  return none if k < 0
  k
}
