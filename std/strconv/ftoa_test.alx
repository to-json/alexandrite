# Go's internal/strconv/ftoa_test.go (and strconv/number_test.go), translated: the
# tables are emitted from Go's own by a Go program; Go's results with alx's
# names in the messages. Go's range errors also return the clamped value; a
# ~T carries only the error (see the header of strconv.alx).

# Not translated: the benchmarks. TestFtoaRandom compares Go's fast and slow
# paths; alx has one (exact) path, so its random inputs are vectors against
# Go's output instead (vec_ftoa_random_test.alx).
import "math"

#[track_caller]
def ftoa_chk(f: Float, fmt: Str, prec: Int, bits: Int, want: Str) {
  assert_eq format_float(f, fmt, prec, bits), want
  assert_eq Str.from_bytes(append_float("abc".bytes.to_a, f, fmt, prec, bits)), "abc" + want
}

test "Ftoa" {
  ftoa_chk(1.0, "e", 5, 64, "1.00000e+00")
  ftoa_chk(1.0, "e", 5, 32, "1.00000e+00")
  ftoa_chk(1.0, "f", 5, 64, "1.00000")
  ftoa_chk(1.0, "f", 5, 32, "1.00000")
  ftoa_chk(1.0, "g", 5, 64, "1")
  ftoa_chk(1.0, "g", 5, 32, "1")
  ftoa_chk(1.0, "g", -1, 64, "1")
  ftoa_chk(1.0, "g", -1, 32, "1")
  ftoa_chk(1.0, "x", -1, 64, "0x1p+00")
  ftoa_chk(1.0, "x", -1, 32, "0x1p+00")
  ftoa_chk(1.0, "x", 5, 64, "0x1.00000p+00")
  ftoa_chk(1.0, "x", 5, 32, "0x1.00000p+00")
  ftoa_chk(20.0, "g", -1, 64, "20")
  ftoa_chk(20.0, "g", -1, 32, "20")
  ftoa_chk(20.0, "x", -1, 64, "0x1.4p+04")
  ftoa_chk(20.0, "x", -1, 32, "0x1.4p+04")
  ftoa_chk(1.2345678e06, "g", -1, 64, "1.2345678e+06")
  ftoa_chk(1.2345678e06, "x", -1, 64, "0x1.2d687cccccccdp+20")
  ftoa_chk(200000.0, "g", -1, 64, "200000")
  ftoa_chk(200000.0, "g", -1, 32, "200000")
  ftoa_chk(200000.0, "x", -1, 64, "0x1.86ap+17")
  ftoa_chk(200000.0, "x", -1, 32, "0x1.86ap+17")
  ftoa_chk(200000.0, "X", -1, 64, "0X1.86AP+17")
  ftoa_chk(200000.0, "X", -1, 32, "0X1.86AP+17")
  ftoa_chk(2e06, "g", -1, 64, "2e+06")
  ftoa_chk(2e06, "g", -1, 32, "2e+06")
  ftoa_chk(1e10, "g", -1, 64, "1e+10")
  ftoa_chk(1e10, "g", -1, 32, "1e+10")
  ftoa_chk(12345.0, "f", 2, 64, "12345.00")
  ftoa_chk(12345.0, "f", 2, 32, "12345.00")
  ftoa_chk(1234.5, "f", 2, 64, "1234.50")
  ftoa_chk(1234.5, "f", 2, 32, "1234.50")
  ftoa_chk(123.45, "f", 2, 64, "123.45")
  ftoa_chk(12.345, "f", 2, 64, "12.35")
  ftoa_chk(1.2345, "f", 2, 64, "1.23")
  ftoa_chk(0.12345, "f", 2, 64, "0.12")
  ftoa_chk(0.12945, "f", 2, 64, "0.13")
  ftoa_chk(0.012345, "f", 2, 64, "0.01")
  ftoa_chk(0.015, "f", 2, 64, "0.01")
  ftoa_chk(0.016, "f", 2, 64, "0.02")
  ftoa_chk(0.0052345, "f", 2, 64, "0.01")
  ftoa_chk(0.0012345, "f", 2, 64, "0.00")
  ftoa_chk(0.00012345, "f", 2, 64, "0.00")
  ftoa_chk(1.2345e-05, "f", 2, 64, "0.00")
  ftoa_chk(0.996644984, "f", 6, 64, "0.996645")
  ftoa_chk(0.996644984, "f", 5, 64, "0.99664")
  ftoa_chk(0.996644984, "f", 4, 64, "0.9966")
  ftoa_chk(0.996644984, "f", 3, 64, "0.997")
  ftoa_chk(0.996644984, "f", 2, 64, "1.00")
  ftoa_chk(0.996644984, "f", 1, 64, "1.0")
  ftoa_chk(400.0, "g", 2, 64, "4e+02")
  ftoa_chk(400.0, "g", 2, 32, "4e+02")
  ftoa_chk(40.0, "g", 2, 64, "40")
  ftoa_chk(40.0, "g", 2, 32, "40")
  ftoa_chk(4.0, "g", 2, 64, "4")
  ftoa_chk(4.0, "g", 2, 32, "4")
  ftoa_chk(0.4, "g", 2, 64, "0.4")
  ftoa_chk(0.04, "g", 2, 64, "0.04")
  ftoa_chk(0.004, "g", 2, 64, "0.004")
  ftoa_chk(0.0004, "g", 2, 64, "0.0004")
  ftoa_chk(4e-05, "g", 2, 64, "4e-05")
  ftoa_chk(4e-06, "g", 2, 64, "4e-06")
  ftoa_chk(0.0, "e", 5, 64, "0.00000e+00")
  ftoa_chk(0.0, "e", 5, 32, "0.00000e+00")
  ftoa_chk(0.0, "f", 5, 64, "0.00000")
  ftoa_chk(0.0, "f", 5, 32, "0.00000")
  ftoa_chk(0.0, "g", 5, 64, "0")
  ftoa_chk(0.0, "g", 5, 32, "0")
  ftoa_chk(0.0, "g", -1, 64, "0")
  ftoa_chk(0.0, "g", -1, 32, "0")
  ftoa_chk(0.0, "x", 5, 64, "0x0.00000p+00")
  ftoa_chk(0.0, "x", 5, 32, "0x0.00000p+00")
  ftoa_chk((-1.0), "e", 5, 64, "-1.00000e+00")
  ftoa_chk((-1.0), "e", 5, 32, "-1.00000e+00")
  ftoa_chk((-1.0), "f", 5, 64, "-1.00000")
  ftoa_chk((-1.0), "f", 5, 32, "-1.00000")
  ftoa_chk((-1.0), "g", 5, 64, "-1")
  ftoa_chk((-1.0), "g", 5, 32, "-1")
  ftoa_chk((-1.0), "g", -1, 64, "-1")
  ftoa_chk((-1.0), "g", -1, 32, "-1")
  ftoa_chk(12.0, "e", 5, 64, "1.20000e+01")
  ftoa_chk(12.0, "e", 5, 32, "1.20000e+01")
  ftoa_chk(12.0, "f", 5, 64, "12.00000")
  ftoa_chk(12.0, "f", 5, 32, "12.00000")
  ftoa_chk(12.0, "g", 5, 64, "12")
  ftoa_chk(12.0, "g", 5, 32, "12")
  ftoa_chk(12.0, "g", -1, 64, "12")
  ftoa_chk(12.0, "g", -1, 32, "12")
  ftoa_chk(1.234567e08, "e", 5, 64, "1.23457e+08")
  ftoa_chk(1.234567e08, "f", 5, 64, "123456700.00000")
  ftoa_chk(1.234567e08, "g", 5, 64, "1.2346e+08")
  ftoa_chk(1.234567e08, "g", -1, 64, "1.234567e+08")
  ftoa_chk(1.2345e06, "e", 5, 64, "1.23450e+06")
  ftoa_chk(1.2345e06, "e", 5, 32, "1.23450e+06")
  ftoa_chk(1.2345e06, "f", 5, 64, "1234500.00000")
  ftoa_chk(1.2345e06, "f", 5, 32, "1234500.00000")
  ftoa_chk(1.2345e06, "g", 5, 64, "1.2345e+06")
  ftoa_chk(1.2345e06, "g", 5, 32, "1.2345e+06")
  ftoa_chk(1.2345e06, "e", 3, 64, "1.234e+06")
  ftoa_chk(1.2345e06, "e", 3, 32, "1.234e+06")
}

test "Ftoa 2" {
  ftoa_chk(1.2355e06, "e", 3, 64, "1.236e+06")
  ftoa_chk(1.2355e06, "e", 3, 32, "1.236e+06")
  ftoa_chk(1.2345, "f", 3, 64, "1.234")
  ftoa_chk(1.2355, "f", 3, 64, "1.236")
  ftoa_chk(1.2345678901234565e15, "e", 15, 64, "1.234567890123456e+15")
  ftoa_chk(1.2345678901234575e15, "e", 15, 64, "1.234567890123458e+15")
  ftoa_chk(1.0867823635813762e14, "g", -1, 64, "1.0867823635813762e+14")
  ftoa_chk(1e23, "e", 17, 64, "9.99999999999999916e+22")
  ftoa_chk(1e23, "f", 17, 64, "99999999999999991611392.00000000000000000")
  ftoa_chk(1e23, "g", 17, 64, "9.9999999999999992e+22")
  ftoa_chk(1e23, "e", -1, 64, "1e+23")
  ftoa_chk(1e23, "f", -1, 64, "100000000000000000000000")
  ftoa_chk(1e23, "g", -1, 64, "1e+23")
  ftoa_chk(9.999999999999997e22, "e", 17, 64, "9.99999999999999748e+22")
  ftoa_chk(9.999999999999997e22, "f", 17, 64, "99999999999999974834176.00000000000000000")
  ftoa_chk(9.999999999999997e22, "g", 17, 64, "9.9999999999999975e+22")
  ftoa_chk(9.999999999999997e22, "e", -1, 64, "9.999999999999997e+22")
  ftoa_chk(9.999999999999997e22, "f", -1, 64, "99999999999999970000000")
  ftoa_chk(9.999999999999997e22, "g", -1, 64, "9.999999999999997e+22")
  ftoa_chk(1.0000000000000001e23, "e", 17, 64, "1.00000000000000008e+23")
  ftoa_chk(1.0000000000000001e23, "f", 17, 64, "100000000000000008388608.00000000000000000")
  ftoa_chk(1.0000000000000001e23, "g", 17, 64, "1.0000000000000001e+23")
  ftoa_chk(1.0000000000000001e23, "e", -1, 64, "1.0000000000000001e+23")
  ftoa_chk(1.0000000000000001e23, "f", -1, 64, "100000000000000010000000")
  ftoa_chk(1.0000000000000001e23, "g", -1, 64, "1.0000000000000001e+23")
  ftoa_chk(5e-324, "g", -1, 64, "5e-324")
  ftoa_chk((-5e-324), "g", -1, 64, "-5e-324")
  ftoa_chk(5e-324, "e", -1, 64, "5e-324")
  ftoa_chk(32.0, "g", -1, 64, "32")
  ftoa_chk(32.0, "g", -1, 32, "32")
  ftoa_chk(32.0, "g", 0, 64, "3e+01")
  ftoa_chk(32.0, "g", 0, 32, "3e+01")
  ftoa_chk(100.0, "x", -1, 64, "0x1.9p+06")
  ftoa_chk(100.0, "x", -1, 32, "0x1.9p+06")
  ftoa_chk(100.0, "y", -1, 64, "%y")
  ftoa_chk(100.0, "y", -1, 32, "%y")
  ftoa_chk(math.nan(), "g", -1, 64, "NaN")
  ftoa_chk(math.nan(), "g", -1, 64, "NaN")
  ftoa_chk(math.inf(1), "g", -1, 64, "+Inf")
  ftoa_chk(math.inf(1), "g", -1, 32, "+Inf")
  ftoa_chk(math.inf(-1), "g", -1, 64, "-Inf")
  ftoa_chk(math.inf(-1), "g", -1, 32, "-Inf")
  ftoa_chk(math.inf(-1), "g", -1, 64, "-Inf")
  ftoa_chk(math.inf(-1), "g", -1, 32, "-Inf")
  ftoa_chk((-1.0), "b", -1, 64, "-4503599627370496p-52")
  ftoa_chk(0.9, "f", 1, 64, "0.9")
  ftoa_chk(0.09, "f", 1, 64, "0.1")
  ftoa_chk(0.0999, "f", 1, 64, "0.1")
  ftoa_chk(0.05, "f", 1, 64, "0.1")
  ftoa_chk(0.05, "f", 0, 64, "0")
  ftoa_chk(0.5, "f", 1, 64, "0.5")
  ftoa_chk(0.5, "f", 1, 32, "0.5")
  ftoa_chk(0.5, "f", 0, 64, "0")
  ftoa_chk(0.5, "f", 0, 32, "0")
  ftoa_chk(1.5, "f", 0, 64, "2")
  ftoa_chk(1.5, "f", 0, 32, "2")
  ftoa_chk(2.2250738585072014e-308, "g", -1, 64, "2.2250738585072014e-308")
  ftoa_chk(2.225073858507201e-308, "g", -1, 64, "2.225073858507201e-308")
  ftoa_chk(3.8326057576481645e17, "f", 0, 64, "383260575764816448")
  ftoa_chk(3.8326057576481645e17, "g", -1, 64, "3.8326057576481645e+17")
  ftoa_chk(4.9848468198408557e17, "f", -1, 64, "498484681984085570")
  ftoa_chk((-5.8339553793802237e23), "g", -1, 64, "-5.8339553793802237e+23")
  ftoa_chk(123.45, "?", 0, 64, "%?")
  ftoa_chk(123.45, "?", 1, 64, "%?")
  ftoa_chk(123.45, "?", -1, 64, "%?")
  ftoa_chk(2.275555555555555, "x", -1, 64, "0x1.23456789abcdep+01")
  ftoa_chk(2.275555555555555, "x", 0, 64, "0x1p+01")
  ftoa_chk(2.275555555555555, "x", 2, 64, "0x1.23p+01")
  ftoa_chk(2.275555555555555, "x", 16, 64, "0x1.23456789abcde000p+01")
  ftoa_chk(2.275555555555555, "x", 21, 64, "0x1.23456789abcde00000000p+01")
  ftoa_chk(2.2755555510520935, "x", -1, 64, "0x1.2345678p+01")
  ftoa_chk(2.2755555510520935, "x", 6, 64, "0x1.234568p+01")
  ftoa_chk(2.275555431842804, "x", -1, 64, "0x1.2345668p+01")
  ftoa_chk(2.275555431842804, "x", 6, 64, "0x1.234566p+01")
  ftoa_chk(3.999969482421875, "x", -1, 64, "0x1.ffffp+01")
  ftoa_chk(3.999969482421875, "x", -1, 32, "0x1.ffffp+01")
  ftoa_chk(3.999969482421875, "x", 4, 64, "0x1.ffffp+01")
  ftoa_chk(3.999969482421875, "x", 4, 32, "0x1.ffffp+01")
  ftoa_chk(3.999969482421875, "x", 3, 64, "0x1.000p+02")
  ftoa_chk(3.999969482421875, "x", 3, 32, "0x1.000p+02")
  ftoa_chk(3.999969482421875, "x", 2, 64, "0x1.00p+02")
  ftoa_chk(3.999969482421875, "x", 2, 32, "0x1.00p+02")
  ftoa_chk(3.999969482421875, "x", 1, 64, "0x1.0p+02")
  ftoa_chk(3.999969482421875, "x", 1, 32, "0x1.0p+02")
  ftoa_chk(3.999969482421875, "x", 0, 64, "0x1p+02")
  ftoa_chk(3.999969482421875, "x", 0, 32, "0x1p+02")
  ftoa_chk(1.801439850948199e16, "g", -1, 64, "1.801439850948199e+16")
  ftoa_chk(5.960464477539063e-08, "g", -1, 64, "5.960464477539063e-08")
  ftoa_chk(1.012e-320, "g", -1, 64, "1.012e-320")
  ftoa_chk(1.635576033861676e16, "e", 14, 64, "1.63557603386168e+16")
  ftoa_chk(1.6786757313153776e16, "e", 15, 64, "1.678675731315378e+16")
  ftoa_chk(1.3981882498049002e17, "e", 16, 64, "1.3981882498049002e+17")
  ftoa_chk(7.721625636509932e06, "e", 5, 64, "7.72163e+06")
  ftoa_chk(7.345688459479448e-09, "e", 16, 64, "7.3456884594794477e-09")
  ftoa_chk(9.765625e18, "e", 5, 64, "9.76562e+18")
  ftoa_chk(1.953125e19, "e", 5, 64, "1.95312e+19")
  ftoa_chk(2.3611832414348645e21, "e", 16, 64, "2.3611832414348645e+21")
  ftoa_chk(7.450580596923828e-09, "e", 17, 64, "7.45058059692382812e-09")
  ftoa_chk(7.450580596923828e-09, "e", 17, 32, "7.45058059692382812e-09")
  ftoa_chk(4.547473508864641e-13, "e", 17, 64, "4.54747350886464119e-13")
}

test "Ftoa 3" {
  ftoa_chk(4.547473508864641e-13, "e", 17, 32, "4.54747350886464119e-13")
  ftoa_chk(9.3564868367555e-19, "f", 150, 64, "0.000000000000000000935648683675550014820074270847655141588693848715273682775661612254225474316626787185668945312500000000000000000000000000000000000000")
}

test "FormatFloatInvalidBitSize" {
  assert_panics("illegal format_float bit_size") { format_float(3.14, "g", -1, 100) }
}
