}

test "ParseComplex 3" {
  atoc_chk("1e309+1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+1e309i\": value out of range")
  atoc_chk("1e309+1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+1e309i\": value out of range")
  atoc_chk("0x1p1025+0x1p1025i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p1025+0x1p1025i\": value out of range")
  atoc_chk("0x1p1025+0x1p1025i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p1025+0x1p1025i\": value out of range")
  atoc_chk("2e308", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"2e308\": value out of range")
  atoc_chk("2e308", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"2e308\": value out of range")
  atoc_chk("1e309", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309\": value out of range")
  atoc_chk("1e309", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309\": value out of range")
  atoc_chk("0x1p1025", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p1025\": value out of range")
  atoc_chk("0x1p1025", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p1025\": value out of range")
  atoc_chk("2e308i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"2e308i\": value out of range")
  atoc_chk("2e308i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"2e308i\": value out of range")
  atoc_chk("1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309i\": value out of range")
  atoc_chk("1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309i\": value out of range")
  atoc_chk("0x1p1025i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p1025i\": value out of range")
  atoc_chk("0x1p1025i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p1025i\": value out of range")
  atoc_chk("+1e310+1e310i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+1e310+1e310i\": value out of range")
  atoc_chk("+1e310+1e310i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+1e310+1e310i\": value out of range")
  atoc_chk("+1e310-1e310i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+1e310-1e310i\": value out of range")
  atoc_chk("+1e310-1e310i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+1e310-1e310i\": value out of range")
  atoc_chk("-1e310+1e310i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e310+1e310i\": value out of range")
  atoc_chk("-1e310+1e310i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e310+1e310i\": value out of range")
  atoc_chk("-1e310-1e310i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e310-1e310i\": value out of range")
  atoc_chk("-1e310-1e310i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e310-1e310i\": value out of range")
  atoc_chk("1e-4294967296", 128, 0.0, 0.0, "")
  atoc_chk("1e-4294967296", 64, 0.0, 0.0, "")
  atoc_chk("1e-4294967296i", 128, 0.0, 0.0, "")
  atoc_chk("1e-4294967296i", 64, 0.0, 0.0, "")
  atoc_chk("1e-4294967296+1i", 128, 0.0, 1.0, "")
  atoc_chk("1e-4294967296+1i", 64, 0.0, 1.0, "")
  atoc_chk("1+1e-4294967296i", 128, 1.0, 0.0, "")
  atoc_chk("1+1e-4294967296i", 64, 1.0, 0.0, "")
  atoc_chk("1e-4294967296+1e-4294967296i", 128, 0.0, 0.0, "")
  atoc_chk("1e-4294967296+1e-4294967296i", 64, 0.0, 0.0, "")
  atoc_chk("1e+4294967296", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e+4294967296\": value out of range")
  atoc_chk("1e+4294967296", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e+4294967296\": value out of range")
  atoc_chk("1e+4294967296i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e+4294967296i\": value out of range")
  atoc_chk("1e+4294967296i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e+4294967296i\": value out of range")
  atoc_chk("1e+4294967296+1e+4294967296i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e+4294967296+1e+4294967296i\": value out of range")
  atoc_chk("1e+4294967296+1e+4294967296i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e+4294967296+1e+4294967296i\": value out of range")
  atoc_chk("1e+4294967296-1e+4294967296i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e+4294967296-1e+4294967296i\": value out of range")
  atoc_chk("1e+4294967296-1e+4294967296i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e+4294967296-1e+4294967296i\": value out of range")
}

test "Atof" {
  atof_chk("", 64, "strconv.parse_float: parsing \"\": invalid syntax")
  atof_chk("", 32, "strconv.parse_float: parsing \"\": invalid syntax")
  atof_chk("1.25", 64, "ok 1.25")
  atof_chk("1.25", 32, "ok 1.25")
  atof_chk("+1", 64, "ok 1")
  atof_chk("+1", 32, "ok 1")
  atof_chk("1x", 64, "strconv.parse_float: parsing \"1x\": invalid syntax")
  atof_chk("1x", 32, "strconv.parse_float: parsing \"1x\": invalid syntax")
  atof_chk("1.1.", 64, "strconv.parse_float: parsing \"1.1.\": invalid syntax")
  atof_chk("1.1.", 32, "strconv.parse_float: parsing \"1.1.\": invalid syntax")
  atof_chk("1e23", 64, "ok 1e+23")
  atof_chk("1E23", 64, "ok 1e+23")
  atof_chk("0x1fFe2.p0", 64, "ok 131042")
  atof_chk("0x1fFe2.p0", 32, "ok 131042")
  atof_chk("0x1fFe2.P0", 64, "ok 131042")
  atof_chk("0x1fFe2.P0", 32, "ok 131042")
  atof_chk("-0x2p3", 64, "ok -16")
  atof_chk("-0x2p3", 32, "ok -16")
  atof_chk("0x0.fp4", 64, "ok 15")
  atof_chk("0x0.fp4", 32, "ok 15")
  atof_chk("0x0.fp0", 64, "ok 0.9375")
  atof_chk("0x0.fp0", 32, "ok 0.9375")
  atof_chk("0x1e2", 64, "strconv.parse_float: parsing \"0x1e2\": invalid syntax")
  atof_chk("0x1e2", 32, "strconv.parse_float: parsing \"0x1e2\": invalid syntax")
  atof_chk("1p2", 64, "strconv.parse_float: parsing \"1p2\": invalid syntax")
  atof_chk("1p2", 32, "strconv.parse_float: parsing \"1p2\": invalid syntax")
  atof_chk("0x1p1024", 64, "strconv.parse_float: parsing \"0x1p1024\": value out of range")
  atof_chk("0x1p1024", 32, "strconv.parse_float: parsing \"0x1p1024\": value out of range")
  atof_chk("-0x1p1024", 64, "strconv.parse_float: parsing \"-0x1p1024\": value out of range")
  atof_chk("-0x1p1024", 32, "strconv.parse_float: parsing \"-0x1p1024\": value out of range")
  atof_chk("0x1.fffffffffffff7fffp1023", 64, "ok 1.7976931348623157e+308")
  atof_chk("-0x1.fffffffffffff7fffp1023", 64, "ok -1.7976931348623157e+308")
  atof_chk("1.797693134862315808e308", 64, "strconv.parse_float: parsing \"1.797693134862315808e308\": value out of range")
  atof_chk("1.797693134862315808e308", 32, "strconv.parse_float: parsing \"1.797693134862315808e308\": value out of range")
  atof_chk("-1.797693134862315808e308", 64, "strconv.parse_float: parsing \"-1.797693134862315808e308\": value out of range")
  atof_chk("-1.797693134862315808e308", 32, "strconv.parse_float: parsing \"-1.797693134862315808e308\": value out of range")
}

test "ParseUint32" {
  pu_chk("", 10, 32, "strconv.parse_uint: parsing \"\": invalid syntax")
  pu_chk("0", 10, 32, "ok 0")
  pu_chk("1", 10, 32, "ok 1")
  pu_chk("12345", 10, 32, "ok 12345")
  pu_chk("12345x", 10, 32, "strconv.parse_uint: parsing \"12345x\": invalid syntax")
  pu_chk("987654321", 10, 32, "ok 987654321")
  pu_chk("4294967296", 10, 32, "strconv.parse_uint: parsing \"4294967296\": value out of range")
  pu_chk("1_2_3_4_5", 10, 32, "strconv.parse_uint: parsing \"1_2_3_4_5\": invalid syntax")
  pu_chk("12345_", 10, 32, "strconv.parse_uint: parsing \"12345_\": invalid syntax")
}

test "ParseUint64" {
  pu_chk("", 10, 64, "strconv.parse_uint: parsing \"\": invalid syntax")
  pu_chk("0", 10, 64, "ok 0")
  pu_chk("1", 10, 64, "ok 1")
  pu_chk("12345", 10, 64, "ok 12345")
  pu_chk("012345", 10, 64, "ok 12345")
  pu_chk("18446744073709551616", 10, 64, "strconv.parse_uint: parsing \"18446744073709551616\": value out of range")
  pu_chk("-1", 10, 64, "strconv.parse_uint: parsing \"-1\": invalid syntax")
}

test "ParseUint64Base" {
  pu_chk("", 0, 64, "strconv.parse_uint: parsing \"\": invalid syntax")
  pu_chk("0", 0, 64, "ok 0")
  pu_chk("1", 0, 64, "ok 1")
  pu_chk("-1", 0, 64, "strconv.parse_uint: parsing \"-1\": invalid syntax")
  pu_chk("12345", 0, 64, "ok 12345")
  pu_chk("012345", 0, 64, "ok 5349")
  pu_chk("18446744073709551616", 0, 64, "strconv.parse_uint: parsing \"18446744073709551616\": value out of range")
  pu_chk("0b", 0, 64, "strconv.parse_uint: parsing \"0b\": invalid syntax")
  pu_chk("101", 2, 64, "ok 5")
  pu_chk("101_", 2, 64, "strconv.parse_uint: parsing \"101_\": invalid syntax")
}

test "ParseInt32" {
  pi_chk("", 10, 32, "strconv.parse_int: parsing \"\": invalid syntax")
  pi_chk("0", 10, 32, "ok 0")
  pi_chk("-0", 10, 32, "ok 0")
  pi_chk("1", 10, 32, "ok 1")
  pi_chk("-1", 10, 32, "ok -1")
  pi_chk("12345", 10, 32, "ok 12345")
  pi_chk("-12345", 10, 32, "ok -12345")
  pi_chk("2147483648", 10, 32, "strconv.parse_int: parsing \"2147483648\": value out of range")
  pi_chk("12345_", 10, 32, "strconv.parse_int: parsing \"12345_\": invalid syntax")
}

test "ParseInt64" {
  pi_chk("", 10, 64, "strconv.parse_int: parsing \"\": invalid syntax")
  pi_chk("0", 10, 64, "ok 0")
  pi_chk("1", 10, 64, "ok 1")
  pi_chk("-1", 10, 64, "ok -1")
  pi_chk("12345", 10, 64, "ok 12345")
  pi_chk("9223372036854775808", 10, 64, "strconv.parse_int: parsing \"9223372036854775808\": value out of range")
  pi_chk("123%45", 10, 64, "strconv.parse_int: parsing \"123%45\": invalid syntax")
}

test "ParseInt64Base" {
  pi_chk("", 0, 64, "strconv.parse_int: parsing \"\": invalid syntax")
  pi_chk("0", 0, 64, "ok 0")
  pi_chk("1", 0, 64, "ok 1")
  pi_chk("-1", 0, 64, "ok -1")
  pi_chk("12345", 0, 64, "ok 12345")
  pi_chk("12345", 9, 64, "ok 8303")
  pi_chk("012345", 0, 64, "ok 5349")
  pi_chk("9223372036854775808", 10, 64, "strconv.parse_int: parsing \"9223372036854775808\": value out of range")
  pi_chk("0b", 0, 64, "strconv.parse_int: parsing \"0b\": invalid syntax")
  pi_chk("101", 2, 64, "ok 5")
  pi_chk("101_", 2, 64, "strconv.parse_int: parsing \"101_\": invalid syntax")
}

test "ParseUint" {
  pu_chk("", 10, 0, "strconv.parse_uint: parsing \"\": invalid syntax")
  pu_chk("0", 10, 0, "ok 0")
  pu_chk("1", 10, 0, "ok 1")
  pu_chk("12345", 10, 0, "ok 12345")
  pu_chk("012345", 10, 0, "ok 12345")
  pu_chk("18446744073709551616", 10, 0, "strconv.parse_uint: parsing \"18446744073709551616\": value out of range")
  pu_chk("-1", 10, 0, "strconv.parse_uint: parsing \"-1\": invalid syntax")
}

test "ParseInt" {
  pi_chk("", 10, 0, "strconv.parse_int: parsing \"\": invalid syntax")
  pi_chk("0", 10, 0, "ok 0")
  pi_chk("1", 10, 0, "ok 1")
  pi_chk("-1", 10, 0, "ok -1")
  pi_chk("12345", 10, 0, "ok 12345")
  pi_chk("9223372036854775808", 10, 0, "strconv.parse_int: parsing \"9223372036854775808\": value out of range")
  pi_chk("123%45", 10, 0, "strconv.parse_int: parsing \"123%45\": invalid syntax")
}

test "Atoi" {
  atoi_chk("", "strconv.atoi: parsing \"\": invalid syntax")
  atoi_chk("0", "ok 0")
  atoi_chk("1", "ok 1")
  atoi_chk("-1", "ok -1")
  atoi_chk("12345", "ok 12345")
  atoi_chk("9223372036854775808", "strconv.atoi: parsing \"9223372036854775808\": value out of range")
  atoi_chk("123%45", "strconv.atoi: parsing \"123%45\": invalid syntax")
}

test "ParseIntBitSize" {
  pi_chk("0", 0, -1, "strconv.parse_int: parsing \"0\": invalid bit size -1")
  pi_chk("0", 0, 0, "ok 0")
  pi_chk("0", 0, 64, "ok 0")
  pi_chk("0", 0, 65, "strconv.parse_int: parsing \"0\": invalid bit size 65")
}

test "ParseUintBitSize" {
  pu_chk("0", 0, -1, "strconv.parse_uint: parsing \"0\": invalid bit size -1")
  pu_chk("0", 0, 0, "ok 0")
  pu_chk("0", 0, 64, "ok 0")
  pu_chk("0", 0, 65, "strconv.parse_uint: parsing \"0\": invalid bit size 65")
}

test "ParseIntBase" {
  pi_chk("0", -1, 0, "strconv.parse_int: parsing \"0\": invalid base -1")
  pi_chk("0", 0, 0, "ok 0")
  pi_chk("0", 1, 0, "strconv.parse_int: parsing \"0\": invalid base 1")
  pi_chk("0", 2, 0, "ok 0")
  pi_chk("0", 36, 0, "ok 0")
  pi_chk("0", 37, 0, "strconv.parse_int: parsing \"0\": invalid base 37")
}

test "ParseUintBase" {
  pu_chk("0", -1, 0, "strconv.parse_uint: parsing \"0\": invalid base -1")
  pu_chk("0", 0, 0, "ok 0")
  pu_chk("0", 1, 0, "strconv.parse_uint: parsing \"0\": invalid base 1")
  pu_chk("0", 2, 0, "ok 0")
  pu_chk("0", 36, 0, "ok 0")
  pu_chk("0", 37, 0, "strconv.parse_uint: parsing \"0\": invalid base 37")
}

test "NumError" {
  assert_eq "#{NumError.ErrSyntax(func_name: "parse_float", num: "0")}", "strconv.parse_float: parsing \"0\": invalid syntax"
  assert_eq "#{NumError.ErrSyntax(func_name: "parse_float", num: "`")}", "strconv.parse_float: parsing \"`\": invalid syntax"
  assert_eq "#{NumError.ErrSyntax(func_name: "parse_float", num: "1\x00.2")}", "strconv.parse_float: parsing \"1\\x00.2\": invalid syntax"
}

test "NumErrorUnwrap" {
  assert errors.is?(NumError.ErrSyntax(func_name: "", num: ""), ERR_SYNTAX)
  assert errors.is?(NumError.ErrRange(func_name: "", num: ""), ERR_RANGE)
  assert !errors.is?(NumError.ErrRange(func_name: "", num: ""), ERR_SYNTAX)
  assert errors.is?(parse_int("99999999999999999999", 10, 64).err, ERR_RANGE)
  assert_eq errors.unwrap(parse_int("0", 1, 64).err)?.message, "invalid base 1"
  assert_eq errors.unwrap(parse_int("0", 10, 65).err)?.message, "invalid bit size 65"
}

test "FormatComplex" {
  assert_eq format_complex(Complex.new(1.0, 2.0), "g", -1, 128), "(1+2i)"
  assert_eq format_complex(Complex.new(3.0, (-4.0)), "g", -1, 128), "(3-4i)"
  assert_eq format_complex(Complex.new((-5.0), 6.0), "g", -1, 128), "(-5+6i)"
  assert_eq format_complex(Complex.new((-7.0), (-8.0)), "g", -1, 128), "(-7-8i)"
  assert_eq format_complex(Complex.new(3.14159, 0.00123), "e", 3, 128), "(3.142e+00+1.230e-03i)"
  assert_eq format_complex(Complex.new(3.14159, 0.00123), "f", 3, 128), "(3.142+0.001i)"
  assert_eq format_complex(Complex.new(3.14159, 0.00123), "g", 3, 128), "(3.14+0.00123i)"
  assert_eq format_complex(Complex.new(1.2345678901234567, 9.876543210987654), "f", -1, 128), "(1.2345678901234567+9.876543210987654i)"
  assert_eq format_complex(Complex.new(1.2345678901234567, 9.876543210987654), "f", -1, 64), "(1.2345679+9.876543i)"
  assert_panics("illegal format_complex bit_size") { format_complex(Complex.new(1.0, 2.0), "g", -1, 100) }
}

test "Itoa" {
  fi_chk(0, 10, "0")
  fi_chk(1, 10, "1")
  fi_chk((-1), 10, "-1")
  fi_chk(12345678, 10, "12345678")
  fi_chk(-9223372036854775807 - 1, 10, "-9223372036854775808")
  fi_chk(16, 17, "g")
  fi_chk(25, 25, "10")
  fi_chk(38493362624, 36, "holycow")
  assert_panics("illegal") { format_uint(12345678, 1) }
}

test "Uitoa" {
  fu_chk(9223372036854775807, 10, "9223372036854775807")
  fu_chk(9223372036854775808, 10, "9223372036854775808")
  fu_chk(9223372036854775809, 10, "9223372036854775809")
  fu_chk(18446744073709551614, 10, "18446744073709551614")
  fu_chk(18446744073709551615, 10, "18446744073709551615")
  fu_chk(18446744073709551615, 2, "1111111111111111111111111111111111111111111111111111111111111111")
}

test "FormatUintVarlen" {
  assert_eq format_uint(1, 10), "1"
  assert_eq format_uint(12, 10), "12"
  assert_eq format_uint(123, 10), "123"
  assert_eq format_uint(1234, 10), "1234"
  assert_eq format_uint(12345, 10), "12345"
  assert_eq format_uint(123456, 10), "123456"
  assert_eq format_uint(1234567, 10), "1234567"
  assert_eq format_uint(12345678, 10), "12345678"
  assert_eq format_uint(123456789, 10), "123456789"
  assert_eq format_uint(1234567890, 10), "1234567890"
  assert_eq format_uint(12345678901, 10), "12345678901"
  assert_eq format_uint(123456789012, 10), "123456789012"
  assert_eq format_uint(1234567890123, 10), "1234567890123"
  assert_eq format_uint(12345678901234, 10), "12345678901234"
  assert_eq format_uint(123456789012345, 10), "123456789012345"
  assert_eq format_uint(1234567890123456, 10), "1234567890123456"
  assert_eq format_uint(12345678901234567, 10), "12345678901234567"
  assert_eq format_uint(123456789012345678, 10), "123456789012345678"
  assert_eq format_uint(1234567890123456789, 10), "1234567890123456789"
  assert_eq format_uint(12345678901234567890, 10), "12345678901234567890"
}

test "ErrorPrefixes" {
  assert_eq atoi("INVALID").err?.func_name, "atoi"
  assert_eq parse_bool("INVALID").err?.func_name, "parse_bool"
  assert_eq parse_float("INVALID", 64).err?.func_name, "parse_float"
  assert_eq parse_int("INVALID", 10, 64).err?.func_name, "parse_int"
  assert_eq parse_uint("INVALID", 10, 64).err?.func_name, "parse_uint"
}
