# Go's strconv/number_test.go and strconv_test.go, translated: the tables are emitted from Go's own by a
# Go program; Go's results with alx's names in the messages. Go's range
# errors also return the clamped value; a ~T carries only the error (see
# the header of strconv.alx).

# Not translated: TestCountMallocs and TestAllocationsFromBytes
# (allocation counts). TestNumError builds NumErrors with Err "failed"; alx's
# NumError variants carry their own reasons, so it checks the quoting of Num
# through ErrSyntax instead.
import "errors"

test "ParseBool" {
  pb_chk("", "strconv.parse_bool: parsing \"\": invalid syntax")
  pb_chk("asdf", "strconv.parse_bool: parsing \"asdf\": invalid syntax")
  pb_chk("0", "ok false")
  pb_chk("false", "ok false")
  pb_chk("true", "ok true")
}

test "FormatBool" {
  assert_eq format_bool(true), "true"
  assert_eq format_bool(false), "false"
}

test "AppendBool" {
  assert_eq Str.from_bytes(append_bool("foo ".bytes.to_a, true)), "foo true"
  assert_eq Str.from_bytes(append_bool("foo ".bytes.to_a, false)), "foo false"
}

test "ParseComplex" {
  atoc_chk("", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"\": invalid syntax")
  atoc_chk("", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"\": invalid syntax")
  atoc_chk(" ", 128, 0.0, 0.0, "strconv.parse_complex: parsing \" \": invalid syntax")
  atoc_chk(" ", 64, 0.0, 0.0, "strconv.parse_complex: parsing \" \": invalid syntax")
  atoc_chk("(", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(\": invalid syntax")
  atoc_chk("(", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(\": invalid syntax")
  atoc_chk(")", 128, 0.0, 0.0, "strconv.parse_complex: parsing \")\": invalid syntax")
  atoc_chk(")", 64, 0.0, 0.0, "strconv.parse_complex: parsing \")\": invalid syntax")
  atoc_chk("i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"i\": invalid syntax")
  atoc_chk("i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"i\": invalid syntax")
  atoc_chk("+i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+i\": invalid syntax")
  atoc_chk("+i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+i\": invalid syntax")
  atoc_chk("-i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-i\": invalid syntax")
  atoc_chk("-i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-i\": invalid syntax")
  atoc_chk("1I", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1I\": invalid syntax")
  atoc_chk("1I", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1I\": invalid syntax")
  atoc_chk("10  + 5i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"10  + 5i\": invalid syntax")
  atoc_chk("10  + 5i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"10  + 5i\": invalid syntax")
  atoc_chk("3+", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"3+\": invalid syntax")
  atoc_chk("3+", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3+\": invalid syntax")
  atoc_chk("3+5", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"3+5\": invalid syntax")
  atoc_chk("3+5", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3+5\": invalid syntax")
  atoc_chk("3+5+5i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"3+5+5i\": invalid syntax")
  atoc_chk("3+5+5i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3+5+5i\": invalid syntax")
  atoc_chk("()", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"()\": invalid syntax")
  atoc_chk("()", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"()\": invalid syntax")
  atoc_chk("(i)", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(i)\": invalid syntax")
  atoc_chk("(i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(i)\": invalid syntax")
  atoc_chk("(0)", 128, 0.0, 0.0, "")
  atoc_chk("(0)", 64, 0.0, 0.0, "")
  atoc_chk("(1i)", 128, 0.0, 1.0, "")
  atoc_chk("(1i)", 64, 0.0, 1.0, "")
  atoc_chk("(3.0+5.5i)", 128, 3.0, 5.5, "")
  atoc_chk("(3.0+5.5i)", 64, 3.0, 5.5, "")
  atoc_chk("(1)+1i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(1)+1i\": invalid syntax")
  atoc_chk("(1)+1i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(1)+1i\": invalid syntax")
  atoc_chk("(3.0+5.5i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(3.0+5.5i\": invalid syntax")
  atoc_chk("(3.0+5.5i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(3.0+5.5i\": invalid syntax")
  atoc_chk("3.0+5.5i)", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"3.0+5.5i)\": invalid syntax")
  atoc_chk("3.0+5.5i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.0+5.5i)\": invalid syntax")
  atoc_chk("NaN", 128, math.nan(), 0.0, "")
  atoc_chk("NANi", 128, 0.0, math.nan(), "")
  atoc_chk("nan+nAni", 128, math.nan(), math.nan(), "")
  atoc_chk("+NaN", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+NaN\": invalid syntax")
  atoc_chk("+NaN", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+NaN\": invalid syntax")
  atoc_chk("-NaN", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-NaN\": invalid syntax")
  atoc_chk("-NaN", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-NaN\": invalid syntax")
  atoc_chk("NaN-NaNi", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN-NaNi\": invalid syntax")
  atoc_chk("NaN-NaNi", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN-NaNi\": invalid syntax")
  atoc_chk("Inf", 128, math.inf(1), 0.0, "")
  atoc_chk("Inf", 64, math.inf(1), 0.0, "")
  atoc_chk("+inf", 128, math.inf(1), 0.0, "")
  atoc_chk("+inf", 64, math.inf(1), 0.0, "")
  atoc_chk("-inf", 128, math.inf(-1), 0.0, "")
  atoc_chk("-inf", 64, math.inf(-1), 0.0, "")
  atoc_chk("Infinity", 128, math.inf(1), 0.0, "")
  atoc_chk("Infinity", 64, math.inf(1), 0.0, "")
  atoc_chk("+INFINITY", 128, math.inf(1), 0.0, "")
  atoc_chk("+INFINITY", 64, math.inf(1), 0.0, "")
  atoc_chk("-infinity", 128, math.inf(-1), 0.0, "")
  atoc_chk("-infinity", 64, math.inf(-1), 0.0, "")
  atoc_chk("+infi", 128, 0.0, math.inf(1), "")
  atoc_chk("+infi", 64, 0.0, math.inf(1), "")
  atoc_chk("0-infinityi", 128, 0.0, math.inf(-1), "")
  atoc_chk("0-infinityi", 64, 0.0, math.inf(-1), "")
  atoc_chk("Inf+Infi", 128, math.inf(1), math.inf(1), "")
  atoc_chk("Inf+Infi", 64, math.inf(1), math.inf(1), "")
  atoc_chk("+Inf-Infi", 128, math.inf(1), math.inf(-1), "")
  atoc_chk("+Inf-Infi", 64, math.inf(1), math.inf(-1), "")
  atoc_chk("-Infinity+Infi", 128, math.inf(-1), math.inf(1), "")
  atoc_chk("-Infinity+Infi", 64, math.inf(-1), math.inf(1), "")
  atoc_chk("inf-inf", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"inf-inf\": invalid syntax")
  atoc_chk("inf-inf", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"inf-inf\": invalid syntax")
  atoc_chk("0", 128, 0.0, 0.0, "")
  atoc_chk("0", 64, 0.0, 0.0, "")
  atoc_chk("0i", 128, 0.0, 0.0, "")
  atoc_chk("0i", 64, 0.0, 0.0, "")
  atoc_chk("-0.0i", 128, 0.0, math.float64frombits(0x8000000000000000), "")
  atoc_chk("-0.0i", 64, 0.0, math.float64frombits(0x8000000000000000), "")
  atoc_chk("0+0.0i", 128, 0.0, 0.0, "")
  atoc_chk("0+0.0i", 64, 0.0, 0.0, "")
  atoc_chk("0e+0i", 128, 0.0, 0.0, "")
  atoc_chk("0e+0i", 64, 0.0, 0.0, "")
  atoc_chk("0e-0+0i", 128, 0.0, 0.0, "")
  atoc_chk("0e-0+0i", 64, 0.0, 0.0, "")
  atoc_chk("-0.0-0.0i", 128, math.float64frombits(0x8000000000000000), math.float64frombits(0x8000000000000000), "")
  atoc_chk("-0.0-0.0i", 64, math.float64frombits(0x8000000000000000), math.float64frombits(0x8000000000000000), "")
  atoc_chk("0e+012345", 128, 0.0, 0.0, "")
  atoc_chk("0e+012345", 64, 0.0, 0.0, "")
  atoc_chk("0x0p+012345i", 128, 0.0, 0.0, "")
  atoc_chk("0x0p+012345i", 64, 0.0, 0.0, "")
  atoc_chk("0x0.00p-012345i", 128, 0.0, 0.0, "")
  atoc_chk("0x0.00p-012345i", 64, 0.0, 0.0, "")
  atoc_chk("+0e-0+0e-0i", 128, 0.0, 0.0, "")
  atoc_chk("+0e-0+0e-0i", 64, 0.0, 0.0, "")
  atoc_chk("0e+0+0e+0i", 128, 0.0, 0.0, "")
  atoc_chk("0e+0+0e+0i", 64, 0.0, 0.0, "")
  atoc_chk("-0e+0-0e+0i", 128, math.float64frombits(0x8000000000000000), math.float64frombits(0x8000000000000000), "")
  atoc_chk("-0e+0-0e+0i", 64, math.float64frombits(0x8000000000000000), math.float64frombits(0x8000000000000000), "")
  atoc_chk("0.1", 128, 0.1, 0.0, "")
}

test "ParseComplex 2" {
  atoc_chk("0.1i", 128, 0.0, 0.1, "")
  atoc_chk("0.123", 128, 0.123, 0.0, "")
  atoc_chk("0.123i", 128, 0.0, 0.123, "")
  atoc_chk("0.123+0.123i", 128, 0.123, 0.123, "")
  atoc_chk("99", 128, 99.0, 0.0, "")
  atoc_chk("99", 64, 99.0, 0.0, "")
  atoc_chk("+99", 128, 99.0, 0.0, "")
  atoc_chk("+99", 64, 99.0, 0.0, "")
  atoc_chk("-99", 128, (-99.0), 0.0, "")
  atoc_chk("-99", 64, (-99.0), 0.0, "")
  atoc_chk("+1i", 128, 0.0, 1.0, "")
  atoc_chk("+1i", 64, 0.0, 1.0, "")
