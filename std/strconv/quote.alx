# Quoting and unquoting, after Go's strconv/quote.go.
import "unicode"
import "unicode/utf8"

HEX = "0123456789abcdef"

# Whether `r` is printable by Go's definition (letters, marks, numbers,
# punctuation, symbols and the ASCII space); same as unicode.is_print.
pub def is_print(r: Rune) -> Bool {
  unicode.is_print(r)
}

# Whether `r` is a graphic character: printable, or a space separator.
pub def is_graphic(r: Rune) -> Bool {
  unicode.is_graphic(r)
}

# Appends the escaped form of `r` for a literal quoted with `quote`.
def append_escaped_rune(buf: [U8], r: Rune, quote: Byte, ascii_only: Bool, graphic_only: Bool) -> [U8] {
  if r == quote.to_i32 || r == 92 {
    buf << 92
    buf << r.as_u8
    return buf
  }
  if ascii_only {
    if r < 0x80 && unicode.is_print(r) {
      buf << r.as_u8
      return buf
    }
  } else if unicode.is_print(r) || (graphic_only && unicode.is_graphic(r)) {
    return utf8.append_rune(buf, r)
  }
  if r == 7 {
    buf << 92
    buf << 97
  } else if r == 8 {
    buf << 92
    buf << 98
  } else if r == 12 {
    buf << 92
    buf << 102
  } else if r == 10 {
    buf << 92
    buf << 110
  } else if r == 13 {
    buf << 92
    buf << 114
  } else if r == 9 {
    buf << 92
    buf << 116
  } else if r == 11 {
    buf << 92
    buf << 118
  } else if r < 32 || r == 0x7F {
    buf << 92
    buf << 120
    buf << HEX[(r >> 4) & 15]
    buf << HEX[r & 15]
  } else {
    c: Rune = r
    c = 0xFFFD unless utf8.valid_rune(r)
    if c < 0x10000 {
      buf << 92
      buf << 117
      buf << HEX[(c >> 12) & 15]
      buf << HEX[(c >> 8) & 15]
      buf << HEX[(c >> 4) & 15]
      buf << HEX[c & 15]
    } else {
      buf << 92
      buf << 85
      buf << HEX[(c >> 28) & 15]
      buf << HEX[(c >> 24) & 15]
      buf << HEX[(c >> 20) & 15]
      buf << HEX[(c >> 16) & 15]
      buf << HEX[(c >> 12) & 15]
      buf << HEX[(c >> 8) & 15]
      buf << HEX[(c >> 4) & 15]
      buf << HEX[c & 15]
    }
  }
  buf
}

def quote_with(s: Str, quote: Byte, ascii_only: Bool, graphic_only: Bool) -> Str {
  buf: [U8] = []
  Str.from_bytes(append_quoted_with(buf, s, quote, ascii_only, graphic_only))
}

def append_quoted_with(dst: [U8], s: Str, quote: Byte, ascii_only: Bool, graphic_only: Bool) -> [U8] {
  buf = dst
  buf << quote
  i = 0
  while i < s.size {
    r = s[i].to_i32
    width = 1
    if r >= 0x80 {
      r, width = utf8.decode_rune_at(s, i)
    }
    if width == 1 && r == 0xFFFD {
      buf << 92
      buf << 120
      buf << HEX[s[i] >> 4]
      buf << HEX[s[i] & 15]
    } else {
      buf = append_escaped_rune(buf, r, quote, ascii_only, graphic_only)
    }
    i += width
  }
  buf << quote
  buf
}

def quote_rune_with(r0: Rune, quote: Byte, ascii_only: Bool, graphic_only: Bool) -> Str {
  buf: [U8] = []
  Str.from_bytes(append_quoted_rune_with(buf, r0, quote, ascii_only, graphic_only))
}

def append_quoted_rune_with(dst: [U8], r0: Rune, quote: Byte, ascii_only: Bool, graphic_only: Bool) -> [U8] {
  r: Rune = r0
  r = 0xFFFD unless utf8.valid_rune(r0)
  buf = dst
  buf << quote
  buf = append_escaped_rune(buf, r, quote, ascii_only, graphic_only)
  buf << quote
  buf
}

# `s` as a double-quoted literal with Go escapes: printable runes stay as
# they are, control characters become \n \t \x.. and so on, invalid UTF-8
# bytes become \x...
pub def quote(s: Str) -> Str {
  quote_with(s, 34, false, false)
}

# Like quote, but every non-ASCII rune is escaped (\u.... or \U........).
pub def quote_to_ascii(s: Str) -> Str {
  quote_with(s, 34, true, false)
}

# Like quote, but graphic non-printable runes (e.g. U+00A0, U+3000) stay as is.
pub def quote_to_graphic(s: Str) -> Str {
  quote_with(s, 34, false, true)
}

# `r` as a single-quoted literal. An invalid rune is quoted as U+FFFD.
pub def quote_rune(r: Rune) -> Str {
  quote_rune_with(r, 39, false, false)
}

pub def quote_rune_to_ascii(r: Rune) -> Str {
  quote_rune_with(r, 39, true, false)
}

pub def quote_rune_to_graphic(r: Rune) -> Str {
  quote_rune_with(r, 39, false, true)
}

# Go's AppendQuote: dst with quote(s) appended.
pub def append_quote(dst: [Byte], s: Str) -> [Byte] {
  append_quoted_with(dst, s, 34, false, false)
}

# Go's AppendQuoteToASCII: dst with quote_to_ascii(s) appended.
pub def append_quote_to_ascii(dst: [Byte], s: Str) -> [Byte] {
  append_quoted_with(dst, s, 34, true, false)
}

# Go's AppendQuoteToGraphic: dst with quote_to_graphic(s) appended.
pub def append_quote_to_graphic(dst: [Byte], s: Str) -> [Byte] {
  append_quoted_with(dst, s, 34, false, true)
}

# Go's AppendQuoteRune: dst with quote_rune(r) appended.
pub def append_quote_rune(dst: [Byte], r: Rune) -> [Byte] {
  append_quoted_rune_with(dst, r, 39, false, false)
}

# Go's AppendQuoteRuneToASCII: dst with quote_rune_to_ascii(r) appended.
pub def append_quote_rune_to_ascii(dst: [Byte], r: Rune) -> [Byte] {
  append_quoted_rune_with(dst, r, 39, true, false)
}

# Go's AppendQuoteRuneToGraphic: dst with quote_rune_to_graphic(r) appended.
pub def append_quote_rune_to_graphic(dst: [Byte], r: Rune) -> [Byte] {
  append_quoted_rune_with(dst, r, 39, false, true)
}

# Whether `s` can be written as a single-line back-quoted raw string literal
# (no back quote, control characters other than tab, DEL, or U+FEFF).
pub def can_backquote(s: Str) -> Bool {
  i = 0
  while i < s.size {
    r, wid = utf8.decode_rune_at(s, i)
    i += wid
    if wid > 1 {
      return false if r == 0xFEFF
      next
    }
    return false if r == 0xFFFD
    return false if (r < 32 && r != 9) || r == 96 || r == 0x7F
  }
  true
}

def unhex(b: Byte) -> Int {
  c = b.to_i
  if c >= 48 && c <= 57 {
    c - 48
  } else if (c | 32) >= 97 && (c | 32) <= 102 {
    (c | 32) - 97 + 10
  } else {
    -1
  }
}

# Decodes the first character of the quoted-literal body `s` (which may be an
# escape sequence). Returns (value, multibyte, rest, ok).
def unquote_char_core(s: Str, quote: Byte) -> (Rune, Bool, Str, Bool) {
  fail_: (Rune, Bool, Str, Bool) = (0, false, "", false)
  return fail_ if s.size == 0
  c = s[0]
  return fail_ if c == quote && (quote == 39 || quote == 34)
  if c >= 0x80 {
    r, size = utf8.decode_rune_at(s, 0)
    return (r, true, s[size...s.size], true)
  }
  if c != 92 {
    return (c.to_i32, false, s[1...s.size], true)
  }
  # a backslash
  return fail_ if s.size <= 1
  e = s[1]
  rest = s[2...s.size]
  value: Rune = 0
  multibyte = false
  if e == 97 {
    value = 7
  } else if e == 98 {
    value = 8
  } else if e == 102 {
    value = 12
  } else if e == 110 {
    value = 10
  } else if e == 114 {
    value = 13
  } else if e == 116 {
    value = 9
  } else if e == 118 {
    value = 11
  } else if e == 120 || e == 117 || e == 85 {
    n = e == 120 ? 2 : (e == 117 ? 4 : 8)
    return fail_ if rest.size < n
    v = 0
    j = 0
    while j < n {
      x = unhex(rest[j])
      return fail_ if x < 0
      v = (v << 4) | x
      j += 1
    }
    rest = rest[n...rest.size]
    if e != 120 {
      return fail_ unless v <= 0x10FFFF && utf8.valid_rune(v.to_i32)
      multibyte = true
    }
    value = v.to_i32
  } else if e >= 48 && e <= 55 {
    return fail_ if rest.size < 2
    v = e.to_i - 48
    j = 0
    while j < 2 {
      x = rest[j].to_i - 48
      return fail_ if x < 0 || x > 7
      v = (v << 3) | x
      j += 1
    }
    rest = rest[2...rest.size]
    return fail_ if v > 255
    value = v.to_i32
  } else if e == 92 {
    value = 92
  } else if e == 39 || e == 34 {
    return fail_ if e != quote
    value = e.to_i32
  } else {
    return fail_
  }
  (value, multibyte, rest, true)
}

# The first character of the quoted-literal body `s`, which may be an escape
# sequence, for a literal quoted with `quote` (39, 34 or 0). Returns
# (value, multibyte, rest); `multibyte` says the value is a rune to be encoded
# as UTF-8 rather than a single byte (as with \x80).
pub def unquote_char(s: Str, quote: Byte) -> ~(Rune, Bool, Str)<StrconvError> {
  r, mb, rest, ok = unquote_char_core(s, quote)
  fail StrconvError.Syntax unless ok
  (r, mb, rest)
}

# The core of unquote and quoted_prefix: (value or literal, rest, ok).
# With `unescape` the value is the unquoted string, else the quoted prefix.
def unquote_core(input: Str, unescape: Bool) -> (Str, Str, Bool) {
  bad = ("", input, false)
  return bad if input.size < 2
  quote = input[0]
  # find the terminating quote
  end_ = -1
  k = 1
  while k < input.size {
    if input[k] == quote {
      end_ = k
      break
    }
    k += 1
  }
  return bad if end_ < 0
  end_ += 1 # position after the terminating quote
  if quote == 96 {
    # raw string literal
    body = input[1...end_ - 1]
    out = input[0...end_]
    if unescape {
      buf: [U8] = []
      for b in body.bytes {
        buf << b if b != 13 # carriage returns inside raw strings are discarded
      }
      out = Str.from_bytes(buf)
    }
    return (out, input[end_...input.size], true)
  }
  return bad unless quote == 34 || quote == 39
  # a quoted string without escapes or newlines
  has_esc = false
  j = 0
  while j < end_ {
    has_esc = true if input[j] == 92 || input[j] == 10
    j += 1
  }
  if !has_esc {
    inner = input[1...end_ - 1]
    valid = false
    if quote == 34 {
      valid = utf8.valid_string(inner)
    } else {
      r, n = utf8.decode_rune_in_string(inner)
      valid = 2 + n == end_ && (r != 0xFFFD || n != 1)
    }
    if valid {
      out = unescape ? inner : input[0...end_]
      return (out, input[end_...input.size], true)
    }
  }
  # with escapes
  rest = input[1...input.size]
  buf: [U8] = []
  while rest.size > 0 && rest[0] != quote {
    r, mb, tail, ok = unquote_char_core(rest, quote)
    return bad if rest[0] == 10 || !ok
    rest = tail
    if r < 0x80 || !mb {
      buf << r.as_u8
    } else {
      buf = utf8.append_rune(buf, r)
    }
    break if quote == 39
  }
  return bad unless rest.size > 0 && rest[0] == quote
  rest = rest[1...rest.size]
  if unescape {
    return (Str.from_bytes(buf), rest, true)
  }
  (input[0...input.size - rest.size], rest, true)
}

# Interprets `s` as a single-quoted, double-quoted or back-quoted Go string
# literal and returns the string it denotes. A single-quoted literal must
# hold exactly one character.
pub def unquote(s: Str) -> ~Str<StrconvError> {
  out, rest, ok = unquote_core(s, true)
  fail StrconvError.Syntax if !ok || rest.size > 0
  out
}

# The quoted string (as a literal, quotes included) at the start of `s`.
pub def quoted_prefix(s: Str) -> ~Str<StrconvError> {
  out, _, ok = unquote_core(s, false)
  fail StrconvError.Syntax unless ok
  out
}
