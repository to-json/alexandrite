# Go's strconv/quote_test.go, translated: the tables are emitted from Go's own by a
# Go program; Go's results with alx's names in the messages. Go's range
# errors also return the clamped value; a ~T carries only the error (see
# the header of strconv.alx).

# Not translated: the benchmarks.
import "unicode"

#[track_caller]
def q_chk(s: Str, out: Str, ascii: Str, graphic: Str) {
  assert_eq quote(s), out
  assert_eq Str.from_bytes(append_quote("abc".bytes.to_a, s)), "abc" + out
  assert_eq quote_to_ascii(s), ascii
  assert_eq Str.from_bytes(append_quote_to_ascii("abc".bytes.to_a, s)), "abc" + ascii
  assert_eq quote_to_graphic(s), graphic
  assert_eq Str.from_bytes(append_quote_to_graphic("abc".bytes.to_a, s)), "abc" + graphic
}

#[track_caller]
def qr_chk(r: Rune, out: Str, ascii: Str, graphic: Str) {
  assert_eq quote_rune(r), out
  assert_eq Str.from_bytes(append_quote_rune("abc".bytes.to_a, r)), "abc" + out
  assert_eq quote_rune_to_ascii(r), ascii
  assert_eq Str.from_bytes(append_quote_rune_to_ascii("abc".bytes.to_a, r)), "abc" + ascii
  assert_eq quote_rune_to_graphic(r), graphic
  assert_eq Str.from_bytes(append_quote_rune_to_graphic("abc".bytes.to_a, r)), "abc" + graphic
}

# Go's testUnquote: unquote, then quoted_prefix with a suffix of special
# characters added.
#[track_caller]
def unq_chk(in0: Str, want0: Str, want_err0: Bool) {
  r = unquote(in0)
  got = r.ok || ""
  got_err = r.err?
  assert got == want0 && got_err == want_err0, "unquote(#{quote(in0)}) = (#{quote(got)}, #{got_err}), want (#{quote(want0)}, #{want_err0}) (#{caller_location})"
  if e = r.err {
    assert_eq "#{e}", "invalid syntax"
  }
  want = got_err ? want0 : in0
  want_err = want_err0
  sb: [Byte] = []
  for c in "\n\r\\\"`'".bytes {
    sb << c if in0.size == 0 || c != in0[0]
  }
  inp = in0 + Str.from_bytes(sb)
  p = quoted_prefix(inp)
  got2 = p.ok || ""
  err2 = p.err?
  if !err2 && want_err {
    want_err = unquote(got2).err?
    want = got2
  }
  assert got2 == want && err2 == want_err, "quoted_prefix(#{quote(inp)}) = (#{quote(got2)}, #{err2}), want (#{quote(want)}, #{want_err}) (#{caller_location})"
}

test "IsPrint" {
  r: Rune = 0
  while r <= unicode.MAX_RUNE {
    assert is_print(r) == unicode.is_print(r), "is_print(#{r})"
    r += 1
  }
}

test "IsGraphic" {
  r: Rune = 0
  while r <= unicode.MAX_RUNE {
    assert is_graphic(r) == unicode.is_graphic(r), "is_graphic(#{r})"
    r += 1
  }
}

test "Quote" {
  q_chk("\a\b\f\r\n\t\v", "\"\\a\\b\\f\\r\\n\\t\\v\"", "\"\\a\\b\\f\\r\\n\\t\\v\"", "\"\\a\\b\\f\\r\\n\\t\\v\"")
  q_chk("\\", "\"\\\\\"", "\"\\\\\"", "\"\\\\\"")
  q_chk(Str.from_bytes([0x61, 0x62, 0x63, 0xff, 0x64, 0x65, 0x66]), "\"abc\\xffdef\"", "\"abc\\xffdef\"", "\"abc\\xffdef\"")
  q_chk("☺", "\"☺\"", "\"\\u263a\"", "\"☺\"")
  q_chk("\U0010ffff", "\"\\U0010ffff\"", "\"\\U0010ffff\"", "\"\\U0010ffff\"")
  q_chk("\x04", "\"\\x04\"", "\"\\x04\"", "\"\\x04\"")
  q_chk("!\u00a0!\u2000!\u3000!", "\"!\\u00a0!\\u2000!\\u3000!\"", "\"!\\u00a0!\\u2000!\\u3000!\"", "\"!\u00a0!\u2000!\u3000!\"")
  q_chk("\x7f", "\"\\x7f\"", "\"\\x7f\"", "\"\\x7f\"")
}

test "QuoteRune" {
  qr_chk(97, "'a'", "'a'", "'a'")
  qr_chk(7, "'\\a'", "'\\a'", "'\\a'")
  qr_chk(92, "'\\\\'", "'\\\\'", "'\\\\'")
  qr_chk(255, "'ÿ'", "'\\u00ff'", "'ÿ'")
  qr_chk(9786, "'☺'", "'\\u263a'", "'☺'")
  qr_chk(57005, "'�'", "'\\ufffd'", "'�'")
  qr_chk(65533, "'�'", "'\\ufffd'", "'�'")
  qr_chk(1114111, "'\\U0010ffff'", "'\\U0010ffff'", "'\\U0010ffff'")
  qr_chk(1114112, "'�'", "'\\ufffd'", "'�'")
  qr_chk(4, "'\\x04'", "'\\x04'", "'\\x04'")
  qr_chk(160, "'\\u00a0'", "'\\u00a0'", "'\u00a0'")
  qr_chk(8192, "'\\u2000'", "'\\u2000'", "'\u2000'")
  qr_chk(12288, "'\\u3000'", "'\\u3000'", "'\u3000'")
}

test "CanBackquote" {
  assert can_backquote("`") == false
  assert can_backquote("\x00") == false
  assert can_backquote("\x01") == false
  assert can_backquote("\x02") == false
  assert can_backquote("\x03") == false
  assert can_backquote("\x04") == false
  assert can_backquote("\x05") == false
  assert can_backquote("\x06") == false
  assert can_backquote("\a") == false
  assert can_backquote("\b") == false
  assert can_backquote("\t") == true
  assert can_backquote("\n") == false
  assert can_backquote("\v") == false
  assert can_backquote("\f") == false
  assert can_backquote("\r") == false
  assert can_backquote("\x0e") == false
  assert can_backquote("\x0f") == false
  assert can_backquote("\x10") == false
  assert can_backquote("\x11") == false
  assert can_backquote("\x12") == false
  assert can_backquote("\x13") == false
  assert can_backquote("\x14") == false
  assert can_backquote("\x15") == false
  assert can_backquote("\x16") == false
  assert can_backquote("\x17") == false
  assert can_backquote("\x18") == false
  assert can_backquote("\x19") == false
  assert can_backquote("\x1a") == false
  assert can_backquote("\x1b") == false
  assert can_backquote("\x1c") == false
  assert can_backquote("\x1d") == false
  assert can_backquote("\x1e") == false
  assert can_backquote("\x1f") == false
  assert can_backquote("\x7f") == false
  assert can_backquote("' !\"#$%&'()*+,-./:;<=>?@[\\]^_{|}~") == true
  assert can_backquote("0123456789") == true
  assert can_backquote("ABCDEFGHIJKLMNOPQRSTUVWXYZ") == true
  assert can_backquote("abcdefghijklmnopqrstuvwxyz") == true
  assert can_backquote("☺") == true
  assert can_backquote(Str.from_bytes([0x80])) == false
  assert can_backquote(Str.from_bytes([0x61, 0xe0, 0xa0, 0x7a])) == false
  assert can_backquote("\ufeffabc") == false
  assert can_backquote("a\ufeffz") == false
}

test "Unquote" {
  unq_chk("\"\"", "", false)
  unq_chk("\"a\"", "a", false)
  unq_chk("\"abc\"", "abc", false)
  unq_chk("\"☺\"", "☺", false)
  unq_chk("\"hello world\"", "hello world", false)
  unq_chk("\"\\xFF\"", Str.from_bytes([0xff]), false)
  unq_chk("\"\\377\"", Str.from_bytes([0xff]), false)
  unq_chk("\"\\u1234\"", "ሴ", false)
  unq_chk("\"\\U00010111\"", "𐄑", false)
  unq_chk("\"\\U0001011111\"", "𐄑11", false)
  unq_chk("\"\\a\\b\\f\\n\\r\\t\\v\\\\\\\"\"", "\a\b\f\n\r\t\v\\\"", false)
  unq_chk("\"'\"", "'", false)
  unq_chk("'a'", "a", false)
  unq_chk("'☹'", "☹", false)
  unq_chk("'\\a'", "\a", false)
  unq_chk("'\\x10'", "\x10", false)
  unq_chk("'\\377'", Str.from_bytes([0xff]), false)
  unq_chk("'\\u1234'", "ሴ", false)
  unq_chk("'\\U00010111'", "𐄑", false)
  unq_chk("'\\t'", "\t", false)
  unq_chk("' '", " ", false)
  unq_chk("'\\''", "'", false)
  unq_chk("'\"'", "\"", false)
  unq_chk("``", "", false)
  unq_chk("`a`", "a", false)
  unq_chk("`abc`", "abc", false)
  unq_chk("`☺`", "☺", false)
  unq_chk("`hello world`", "hello world", false)
  unq_chk("`\\xFF`", "\\xFF", false)
  unq_chk("`\\377`", "\\377", false)
  unq_chk("`\\`", "\\", false)
  unq_chk("`\n`", "\n", false)
  unq_chk("`\t`", "\t", false)
  unq_chk("` `", " ", false)
  unq_chk("`a\rb`", "ab", false)
  unq_chk("\"\\a\\b\\f\\r\\n\\t\\v\"", "\a\b\f\r\n\t\v", false)
  unq_chk("\"\\\\\"", "\\", false)
  unq_chk("\"abc\\xffdef\"", Str.from_bytes([0x61, 0x62, 0x63, 0xff, 0x64, 0x65, 0x66]), false)
  unq_chk("\"☺\"", "☺", false)
  unq_chk("\"\\U0010ffff\"", "\U0010ffff", false)
  unq_chk("\"\\x04\"", "\x04", false)
  unq_chk("\"!\\u00a0!\\u2000!\\u3000!\"", "!\u00a0!\u2000!\u3000!", false)
  unq_chk("\"\\x7f\"", "\x7f", false)
  unq_chk("", "", true)
  unq_chk("\"", "", true)
  unq_chk("\"a", "", true)
  unq_chk("\"'", "", true)
  unq_chk("b\"", "", true)
  unq_chk("\"\\\"", "", true)
  unq_chk("\"\\9\"", "", true)
  unq_chk("\"\\19\"", "", true)
  unq_chk("\"\\129\"", "", true)
  unq_chk("'\\'", "", true)
  unq_chk("'\\9'", "", true)
  unq_chk("'\\19'", "", true)
  unq_chk("'\\129'", "", true)
  unq_chk("'ab'", "", true)
  unq_chk("\"\\x1!\"", "", true)
  unq_chk("\"\\U12345678\"", "", true)
  unq_chk("\"\\z\"", "", true)
  unq_chk("`", "", true)
  unq_chk("`xxx", "", true)
  unq_chk("``x\r", "", true)
  unq_chk("`\"", "", true)
  unq_chk("\"\\'\"", "", true)
  unq_chk("'\\\"'", "", true)
  unq_chk("\"\n\"", "", true)
  unq_chk("\"\\n\n\"", "", true)
  unq_chk("'\n'", "", true)
  unq_chk("\"\\udead\"", "", true)
  unq_chk("\"\\ud83d\\ude4f\"", "", true)
}

test "UnquoteInvalidUTF8" {
  unq_chk("\"foo\"", "foo", false)
  unq_chk("\"foo", "", true)
  unq_chk(Str.from_bytes([0x22, 0xc0, 0x22]), "�", false)
  unq_chk(Str.from_bytes([0x22, 0x61, 0xc0, 0x22]), "a�", false)
  unq_chk(Str.from_bytes([0x22, 0x5c, 0x74, 0xc0, 0x22]), "\t�", false)
}
