test "error values" {
  e = atoi("x1").err
  assert e.present?
  if err = e {
    case err {
      ErrSyntax(f, n) => assert_eq f + "|" + n, "atoi|x1"
      _ => assert false
    }
  }
  if err = parse_int("300", 10, 8).err {
    case err {
      ErrRange(f, n) => assert_eq f + "|" + n, "parse_int|300"
      _ => assert false
    }
  }
  if err = parse_int("1", 99, 8).err {
    case err {
      ErrBase(_, _, b) => assert_eq b, 99
      _ => assert false
    }
  }
  if err = parse_uint("1", 10, 65).err {
    case err {
      ErrBitSize(_, _, b) => assert_eq b, 65
      _ => assert false
    }
  }
}

def double(s: Str) -> ~Int<NumError> {
  n = ~atoi(s)
  n * 2
}

test "propagation" {
  assert_eq double("21").unwrap, 42
  assert_eq double("x").ok?, false
  assert_eq double("x").unwrap_or(-1), -1
}

test "itoa and format_int" {
  assert_eq itoa(0), "0"
  assert_eq itoa(-9223372036854775807 - 1), "-9223372036854775808"
  assert_eq format_int(35, 36), "z"
  assert_eq format_uint(18446744073709551615, 2).size, 64
}

test "decompose and round_to_format" {
  m, q = decompose(1.0)
  assert_eq m, 4503599627370496
  assert_eq q, -52
  m, q = decompose(5e-324)
  assert_eq m, 4503599627370496
  assert_eq q, -1126
  m, q = decompose(1.7976931348623157e308)
  assert_eq m, 9007199254740991
  assert_eq q, 971
  # 5e-324 is the smallest denormal: mant 1 at the minimum exponent
  m1, q1 = decompose(5e-324)
  mant, exp, ovf = round_to_format(m1, q1, float_info(64))
  assert_eq mant, 1
  assert_eq exp, -1022
  # 1 as float32: mant 2^23, exp 0
  m2, q2 = decompose(1.0)
  mant, exp, ovf = round_to_format(m2, q2, float_info(32))
  assert_eq mant, 8388608
  assert_eq exp, 0
  assert !ovf
  # a float64 beyond the float32 range overflows it
  m3, q3 = decompose(1e39)
  mant, exp, ovf = round_to_format(m3, q3, float_info(32))
  assert ovf
}

test "float edge values" {
  assert_eq format_float(pos_inf(), "g", -1, 64), "+Inf"
  assert_eq format_float(neg_inf(), "f", 2, 64), "-Inf"
  assert_eq format_float(nan_value(), "e", 3, 32), "NaN"
  assert_eq format_float(1e300, "f", -1, 32), "+Inf"
  assert_eq format_float(1.5, "q", 2, 64), "%q"
  assert_eq format_float(1.5, "", 2, 64), "%"
  assert_eq parse_float("1e400").ok?, false
  assert_eq parse_float("-1e400").ok?, false
  assert_eq parse_float_bits("1e39", 32).ok?, false
  assert_eq parse_float("1e-400").unwrap, 0.0
  assert_eq parse_float(" 1").ok?, false
  assert_eq parse_float("").ok?, false
}

test "parse then format round trips" {
  for s in ["0.1", "123.456", "1e100", "2.5e-8", "98765.4321", "1.7976931348623157e308", "5e-324", "0.3", "4.35"] {
    f = parse_float(s).unwrap
    assert_eq parse_float(format_float(f, "g", -1, 64)).unwrap, f
    assert_eq parse_float(format_float(f, "e", -1, 64)).unwrap, f
    assert_eq f.to_s, format_float(f, "g", -1, 64)
  }
}
