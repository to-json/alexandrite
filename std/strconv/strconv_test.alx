def bs(xs: [U8]) -> Str { Str.from_bytes(xs) }

def dstr(a: Dec) -> Str {
  Str.from_bytes(a.d[0...a.nd]) + "e" + a.dp.to_s
}

test "dec basics" {
  a = new_dec()
  a.assign!(12345)
  assert_eq dstr(a), "12345e5"
  a.shift!(3)
  assert_eq dstr(a), "9876e5"
  a.shift!(-3)
  assert_eq dstr(a), "12345e5"
  b = new_dec()
  b.assign!(1)
  b.shift!(100)
  assert_eq dstr(b), "1267650600228229401496703205376e31"
  b.shift!(-100)
  assert_eq dstr(b), "1e1"
  c = new_dec()
  c.assign!(1)
  c.shift!(-10)
  assert_eq dstr(c), "9765625e-3"
}

test "dec set and float_bits" {
  a = new_dec()
  assert a.set!("3.14159")
  m, e, ovf = a.float_bits!(float_info(64))
  assert !ovf
  assert_eq make_float(m, e, false, float_info(64)), 3.14159
  b = new_dec()
  assert b.set!("1e-320")
  m, e, ovf = b.float_bits!(float_info(64))
  assert_eq make_float(m, e, false, float_info(64)), 1e-320
  c = new_dec()
  assert c.set!("1e400")
  m, e, ovf = c.float_bits!(float_info(64))
  assert ovf
}

test "smoke" {
  assert_eq atoi("42").unwrap, 42
  assert_eq atoi("-42").unwrap, -42
  assert_eq parse_int("-ff", 16, 64).unwrap, -255
  assert_eq format_int(-255, 16), "-ff"
  assert_eq parse_float("3.14159").unwrap, 3.14159
  assert_eq parse_float("1e23").unwrap, 1e23
  assert_eq format_float(3.14159, "g", -1, 64), "3.14159"
  assert_eq format_float(1e23, "g", -1, 64), "1e+23"
  assert_eq format_float(0.1, "f", 20, 64), "0.10000000000000000555"
  assert_eq quote("hi\n"), "\"hi\\n\""
  assert_eq unquote("\"a\\tb\"").unwrap, "a\tb"
}
