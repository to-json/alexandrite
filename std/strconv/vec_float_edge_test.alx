  assert_eq format_float(100.0, "X", 30, 32), "0X1.900000000000000000000000000000P+06"
}

test "format_float unknown verb" {
  assert_eq format_float(1.5, "a", -1, 64), "%a"
  assert_eq format_float(1.5, "z", -1, 64), "%z"
  assert_eq format_float(1.5, "%", -1, 64), "%%"
  assert_eq format_float(1.5, "v", -1, 64), "%v"
}

