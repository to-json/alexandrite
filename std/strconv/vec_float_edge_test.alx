test "format_float edge 32 10" {
  assert_eq format_float(100.0, "e", 2, 32), "1.00e+02"
  assert_eq format_float(100.0, "e", 5, 32), "1.00000e+02"
  assert_eq format_float(100.0, "e", 17, 32), "1.00000000000000000e+02"
  assert_eq format_float(100.0, "e", 30, 32), "1.000000000000000000000000000000e+02"
