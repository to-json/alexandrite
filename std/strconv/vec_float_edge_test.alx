test "parse_float edge 64 2" {
  atof_chk("1.000000059604644775390624999", 64, "ok 1.0000000596046448")
  atof_chk("9007199254740993", 64, "ok 9.007199254740992e+15")
  atof_chk("9007199254740992.9999999999", 64, "ok 9.007199254740992e+15")
  atof_chk("9007199254740993.0000000001", 64, "ok 9.007199254740994e+15")
  atof_chk("123456789012345678901234567890", 64, "ok 1.2345678901234568e+29")
  atof_chk("0.000000000000000000000000000000000000000000000000001", 64, "ok 1e-51")
  atof_chk("   1", 64, "strconv.parse_float: parsing \"   1\": invalid syntax")
  atof_chk("1 ", 64, "strconv.parse_float: parsing \"1 \": invalid syntax")
  atof_chk("+-1", 64, "strconv.parse_float: parsing \"+-1\": invalid syntax")
  atof_chk("--1", 64, "strconv.parse_float: parsing \"--1\": invalid syntax")
  atof_chk("1e+-1", 64, "strconv.parse_float: parsing \"1e+-1\": invalid syntax")
  atof_chk("١", 64, "strconv.parse_float: parsing \"١\": invalid syntax")
  atof_chk("1\x00", 64, "strconv.parse_float: parsing \"1\\x00\": invalid syntax")
  atof_chk(Str.from_bytes([0xff, 0x31]), 64, "strconv.parse_float: parsing \"\\xff1\": invalid syntax")
  atof_chk("18446744073709551616", 64, "ok 1.8446744073709552e+19")
  atof_chk("1e23", 64, "ok 1e+23")
  atof_chk("8.41e21", 64, "ok 8.41e+21")
  atof_chk("5e-324", 64, "ok 5e-324")
  atof_chk("2e-324", 64, "ok 0")
  atof_chk("3e-324", 64, "ok 5e-324")
  atof_chk("-700", 64, "ok 1.111111111111111e+99")
  atof_chk("0.", 64, "ok 0.1")
}

