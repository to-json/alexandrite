test "format_float edge 32" {
  assert_eq format_float(0.0, "b", -1, 32), "0p-149"
  assert_eq format_float(0.0, "b", 0, 32), "0p-149"
  assert_eq format_float(0.0, "b", 1, 32), "0p-149"
  assert_eq format_float(0.0, "b", 2, 32), "0p-149"
  assert_eq format_float(0.0, "b", 5, 32), "0p-149"
  assert_eq format_float(0.0, "b", 17, 32), "0p-149"
  assert_eq format_float(0.0, "b", 30, 32), "0p-149"
  assert_eq format_float(0.0, "e", -1, 32), "0e+00"
  assert_eq format_float(0.0, "e", 0, 32), "0e+00"
  assert_eq format_float(0.0, "e", 1, 32), "0.0e+00"
  assert_eq format_float(0.0, "e", 2, 32), "0.00e+00"
  assert_eq format_float(0.0, "e", 5, 32), "0.00000e+00"
  assert_eq format_float(0.0, "e", 17, 32), "0.00000000000000000e+00"
  assert_eq format_float(0.0, "e", 30, 32), "0.000000000000000000000000000000e+00"
  assert_eq format_float(0.0, "E", -1, 32), "0E+00"
  assert_eq format_float(0.0, "E", 0, 32), "0E+00"
  assert_eq format_float(0.0, "E", 1, 32), "0.0E+00"
  assert_eq format_float(0.0, "E", 2, 32), "0.00E+00"
  assert_eq format_float(0.0, "E", 5, 32), "0.00000E+00"
  assert_eq format_float(0.0, "E", 17, 32), "0.00000000000000000E+00"
  assert_eq format_float(0.0, "E", 30, 32), "0.000000000000000000000000000000E+00"
  assert_eq format_float(0.0, "f", -1, 32), "0"
  assert_eq format_float(0.0, "f", 0, 32), "0"
  assert_eq format_float(0.0, "f", 1, 32), "0.0"
  assert_eq format_float(0.0, "f", 2, 32), "0.00"
  assert_eq format_float(0.0, "f", 5, 32), "0.00000"
  assert_eq format_float(0.0, "f", 17, 32), "0.00000000000000000"
  assert_eq format_float(0.0, "f", 30, 32), "0.000000000000000000000000000000"
  assert_eq format_float(0.0, "g", -1, 32), "0"
  assert_eq format_float(0.0, "g", 0, 32), "0"
  assert_eq format_float(0.0, "g", 1, 32), "0"
  assert_eq format_float(0.0, "g", 2, 32), "0"
  assert_eq format_float(0.0, "g", 5, 32), "0"
  assert_eq format_float(0.0, "g", 17, 32), "0"
  assert_eq format_float(0.0, "g", 30, 32), "0"
  assert_eq format_float(0.0, "G", -1, 32), "0"
  assert_eq format_float(0.0, "G", 0, 32), "0"
  assert_eq format_float(0.0, "G", 1, 32), "0"
  assert_eq format_float(0.0, "G", 2, 32), "0"
  assert_eq format_float(0.0, "G", 5, 32), "0"
  assert_eq format_float(0.0, "G", 17, 32), "0"
  assert_eq format_float(0.0, "G", 30, 32), "0"
  assert_eq format_float(0.0, "x", -1, 32), "0x0p+00"
  assert_eq format_float(0.0, "x", 0, 32), "0x0p+00"
  assert_eq format_float(0.0, "x", 1, 32), "0x0.0p+00"
  assert_eq format_float(0.0, "x", 2, 32), "0x0.00p+00"
  assert_eq format_float(0.0, "x", 5, 32), "0x0.00000p+00"
  assert_eq format_float(0.0, "x", 17, 32), "0x0.00000000000000000p+00"
  assert_eq format_float(0.0, "x", 30, 32), "0x0.000000000000000000000000000000p+00"
  assert_eq format_float(0.0, "X", -1, 32), "0X0P+00"
  assert_eq format_float(0.0, "X", 0, 32), "0X0P+00"
  assert_eq format_float(0.0, "X", 1, 32), "0X0.0P+00"
  assert_eq format_float(0.0, "X", 2, 32), "0X0.00P+00"
  assert_eq format_float(0.0, "X", 5, 32), "0X0.00000P+00"
  assert_eq format_float(0.0, "X", 17, 32), "0X0.00000000000000000P+00"
  assert_eq format_float(0.0, "X", 30, 32), "0X0.000000000000000000000000000000P+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "b", -1, 32), "-0p-149"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "b", 0, 32), "-0p-149"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "b", 1, 32), "-0p-149"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "b", 2, 32), "-0p-149"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "b", 5, 32), "-0p-149"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "b", 17, 32), "-0p-149"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "b", 30, 32), "-0p-149"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "e", -1, 32), "-0e+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "e", 0, 32), "-0e+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "e", 1, 32), "-0.0e+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "e", 2, 32), "-0.00e+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "e", 5, 32), "-0.00000e+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "e", 17, 32), "-0.00000000000000000e+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "e", 30, 32), "-0.000000000000000000000000000000e+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "E", -1, 32), "-0E+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "E", 0, 32), "-0E+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "E", 1, 32), "-0.0E+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "E", 2, 32), "-0.00E+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "E", 5, 32), "-0.00000E+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "E", 17, 32), "-0.00000000000000000E+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "E", 30, 32), "-0.000000000000000000000000000000E+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "f", -1, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "f", 0, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "f", 1, 32), "-0.0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "f", 2, 32), "-0.00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "f", 5, 32), "-0.00000"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "f", 17, 32), "-0.00000000000000000"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "f", 30, 32), "-0.000000000000000000000000000000"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "g", -1, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "g", 0, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "g", 1, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "g", 2, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "g", 5, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "g", 17, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "g", 30, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "G", -1, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "G", 0, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "G", 1, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "G", 2, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "G", 5, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "G", 17, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "G", 30, 32), "-0"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "x", -1, 32), "-0x0p+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "x", 0, 32), "-0x0p+00"
}

test "format_float edge 32 2" {
  assert_eq format_float(math.float64frombits(0x8000000000000000), "x", 1, 32), "-0x0.0p+00"
  assert_eq format_float(math.float64frombits(0x8000000000000000), "x", 2, 32), "-0x0.00p+00"
