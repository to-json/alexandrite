  assert_eq format_float(100.0, "G", 5, 32), "100"
  assert_eq format_float(100.0, "G", 17, 32), "100"
  assert_eq format_float(100.0, "G", 30, 32), "100"
  assert_eq format_float(100.0, "x", -1, 32), "0x1.9p+06"
  assert_eq format_float(100.0, "x", 0, 32), "0x1p+07"
  assert_eq format_float(100.0, "x", 1, 32), "0x1.9p+06"
  assert_eq format_float(100.0, "x", 2, 32), "0x1.90p+06"
  assert_eq format_float(100.0, "x", 5, 32), "0x1.90000p+06"
  assert_eq format_float(100.0, "x", 17, 32), "0x1.90000000000000000p+06"
  assert_eq format_float(100.0, "x", 30, 32), "0x1.900000000000000000000000000000p+06"
  assert_eq format_float(100.0, "X", -1, 32), "0X1.9P+06"
