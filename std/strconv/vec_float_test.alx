  chk_ferr("0x1.fffffffffffffp1023", 32, "strconv.parse_float: parsing \"0x1.fffffffffffffp1023\": value out of range")
  chk_ferr("0x1.fffffffffffff8p1023", 32, "strconv.parse_float: parsing \"0x1.fffffffffffff8p1023\": value out of range")
  chk_ferr("0x1p1024", 32, "strconv.parse_float: parsing \"0x1p1024\": value out of range")
  chk_f("0x1p-1074", 32, 0.0)
