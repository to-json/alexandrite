  chk_ferr("1e", 32, "strconv.parse_float: parsing \"1e\": invalid syntax")
  chk_ferr("1e+", 32, "strconv.parse_float: parsing \"1e+\": invalid syntax")
  chk_ferr("1e-", 32, "strconv.parse_float: parsing \"1e-\": invalid syntax")
  chk_f("1e5", 32, 100000.0)
  chk_f("1E5", 32, 100000.0)
  chk_f("1e+5", 32, 100000.0)
  chk_f("1e-5", 32, 9.999999747378752e-06)
  chk_f("1.e5", 32, 100000.0)
  chk_f("1_0", 32, 10.0)
  chk_f("1_0.5", 32, 10.5)
  chk_ferr("1._5", 32, "strconv.parse_float: parsing \"1._5\": invalid syntax")
