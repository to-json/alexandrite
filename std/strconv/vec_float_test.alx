test "parse_float vectors 32" {
  chk_f("0", 32, 0.0)
  chk_f("-0", 32, neg_zero())
  chk_f("+0", 32, 0.0)
  chk_f("0.0", 32, 0.0)
  chk_f("00", 32, 0.0)
  chk_f("1", 32, 1.0)
  chk_f("-1", 32, -1.0)
  chk_f("+1", 32, 1.0)
  chk_f("1.", 32, 1.0)
  chk_f(".5", 32, 0.5)
  chk_f("-.5", 32, -0.5)
  chk_f("+.5", 32, 0.5)
  chk_ferr(".", 32, "strconv.parse_float: parsing \".\": invalid syntax")
