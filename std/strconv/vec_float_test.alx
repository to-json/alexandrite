# Generated from Go's strconv (go run): expected results of parse_float and format_float.

def neg_zero -> Float {
  z = 0.0
  z * -1.0
}

def same_sign(a: Float, b: Float) -> Bool {
  (a < 0.0 || (a == 0.0 && 1.0 / a < 0.0)) == (b < 0.0 || (b == 0.0 && 1.0 / b < 0.0))
}

# parse_float(s, bits) must be exactly the float of 'want' (a literal).
def chk_f(s: Str, bits: Int, want: Float) {
  r = parse_float_bits(s, bits)
  if v = r.ok {
    assert_eq v, want
    assert same_sign(v, want)
  } else {
    assert_eq "#{r.err}", "ok"
  }
}

def chk_inf(s: Str, bits: Int, sign: Int) {
  r = parse_float_bits(s, bits)
  if v = r.ok {
    assert v > 1.7976931348623157e308 if sign > 0
    assert v < -1.7976931348623157e308 if sign < 0
  } else {
    assert_eq "#{r.err}", "ok"
  }
}

def chk_nan(s: Str, bits: Int) {
  r = parse_float_bits(s, bits)
  if v = r.ok {
    assert v != v
  } else {
    assert_eq "#{r.err}", "ok"
  }
}

def chk_ferr(s: Str, bits: Int, want: Str) {
  r = parse_float_bits(s, bits)
  if v = r.ok {
    assert_eq "ok #{v}", want
  } else if e = r.err {
    assert_eq "#{e}", want
  }
}

def chk_fmt(f: Float, fmt: Str, prec: Int, bits: Int, want: Str) {
  assert_eq format_float(f, fmt, prec, bits), want
}

def chk_rt(f: Float, e_shortest: Str, g_shortest: Str) {
  assert_eq format_float(f, "e", -1, 64), e_shortest
  assert_eq format_float(f, "g", -1, 64), g_shortest
  assert_eq f.to_s, g_shortest
  r = parse_float(e_shortest)
  if v = r.ok {
    assert_eq v, f
  } else {
    assert_eq "#{r.err}", "ok"
  }
}

test "parse_float vectors 64" {
  chk_f("0", 64, 0.0)
  chk_f("-0", 64, neg_zero())
  chk_f("+0", 64, 0.0)
  chk_f("0.0", 64, 0.0)
  chk_f("00", 64, 0.0)
  chk_f("1", 64, 1.0)
  chk_f("-1", 64, -1.0)
  chk_f("+1", 64, 1.0)
  chk_f("1.", 64, 1.0)
