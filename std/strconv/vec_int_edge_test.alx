test "bounds 32" {
  pi_chk("1111111111111111111111111111111", 2, 32, "ok 2147483647")
  pu_chk("1111111111111111111111111111111", 2, 32, "ok 2147483647")
  pi_chk("-10000000000000000000000000000000", 2, 32, "ok -2147483648")
  pu_chk("-10000000000000000000000000000000", 2, 32, "strconv.parse_uint: parsing \"-10000000000000000000000000000000\": invalid syntax")
  pi_chk("10000000000000000000000000000000", 2, 32, "strconv.parse_int: parsing \"10000000000000000000000000000000\": value out of range")
  pu_chk("10000000000000000000000000000000", 2, 32, "ok 2147483648")
  pi_chk("-10000000000000000000000000000001", 2, 32, "strconv.parse_int: parsing \"-10000000000000000000000000000001\": value out of range")
  pu_chk("-10000000000000000000000000000001", 2, 32, "strconv.parse_uint: parsing \"-10000000000000000000000000000001\": invalid syntax")
  pi_chk("11111111111111111111111111111111", 2, 32, "strconv.parse_int: parsing \"11111111111111111111111111111111\": value out of range")
  pu_chk("11111111111111111111111111111111", 2, 32, "ok 4294967295")
  pi_chk("0", 2, 32, "ok 0")
  pu_chk("0", 2, 32, "ok 0")
  pi_chk("-0", 2, 32, "ok 0")
  pu_chk("-0", 2, 32, "strconv.parse_uint: parsing \"-0\": invalid syntax")
  pi_chk("+1111111111111111111111111111111", 2, 32, "ok 2147483647")
  pu_chk("+1111111111111111111111111111111", 2, 32, "strconv.parse_uint: parsing \"+1111111111111111111111111111111\": invalid syntax")
  pi_chk("100000000000000000000000000000000", 2, 32, "strconv.parse_int: parsing \"100000000000000000000000000000000\": value out of range")
  pu_chk("100000000000000000000000000000000", 2, 32, "strconv.parse_uint: parsing \"100000000000000000000000000000000\": value out of range")
