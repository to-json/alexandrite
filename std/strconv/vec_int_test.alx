  chk_int("-0", -2, 64, "strconv.parse_int: parsing \"-0\": invalid base -2")
  chk_int("-0", 0, 63, "ok 0")
  chk_int("+0", 10, 64, "ok 0")
  chk_int("+0", 10, 0, "ok 0")
  chk_int("+0", 0, 64, "ok 0")
  chk_int("+0", 16, 64, "ok 0")
  chk_int("+0", 2, 8, "ok 0")
  chk_int("+0", 10, 8, "ok 0")
  chk_int("+0", 36, 64, "ok 0")
  chk_int("+0", 8, 16, "ok 0")
