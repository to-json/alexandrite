  chk_int("-0", 0, 8, "ok 0")
  chk_int("-0", 2, 64, "ok 0")
  chk_int("-0", 10, 65, "strconv.parse_int: parsing \"-0\": invalid bit size 65")
  chk_int("-0", 10, -1, "strconv.parse_int: parsing \"-0\": invalid bit size -1")
