  chk_int("1", 0, 8, "ok 1")
  chk_int("1", 2, 64, "ok 1")
  chk_int("1", 10, 65, "strconv.parse_int: parsing \"1\": invalid bit size 65")
  chk_int("1", 10, -1, "strconv.parse_int: parsing \"1\": invalid bit size -1")
  chk_int("1", 1, 64, "strconv.parse_int: parsing \"1\": invalid base 1")
