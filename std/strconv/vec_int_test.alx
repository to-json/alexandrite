test "parse_bool vectors" {
  chk_bool("1", "ok true")
  chk_bool("t", "ok true")
  chk_bool("T", "ok true")
  chk_bool("TRUE", "ok true")
  chk_bool("true", "ok true")
  chk_bool("True", "ok true")
  chk_bool("0", "ok false")
  chk_bool("f", "ok false")
  chk_bool("F", "ok false")
  chk_bool("FALSE", "ok false")
  chk_bool("false", "ok false")
  chk_bool("False", "ok false")
  chk_bool("", "strconv.parse_bool: parsing \"\": invalid syntax")
  chk_bool("yes", "strconv.parse_bool: parsing \"yes\": invalid syntax")
  chk_bool("no", "strconv.parse_bool: parsing \"no\": invalid syntax")
  chk_bool("tRUE", "strconv.parse_bool: parsing \"tRUE\": invalid syntax")
  chk_bool("TrUe", "strconv.parse_bool: parsing \"TrUe\": invalid syntax")
  chk_bool("2", "strconv.parse_bool: parsing \"2\": invalid syntax")
  chk_bool(" true", "strconv.parse_bool: parsing \" true\": invalid syntax")
  chk_bool("true ", "strconv.parse_bool: parsing \"true \": invalid syntax")
  chk_bool("y", "strconv.parse_bool: parsing \"y\": invalid syntax")
  chk_bool("n", "strconv.parse_bool: parsing \"n\": invalid syntax")
}

