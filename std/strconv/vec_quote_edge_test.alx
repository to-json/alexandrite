# Generated from Go's strconv (quote, quote_to_ascii, quote_to_graphic, quote_rune*, unquote, unquote_char, quoted_prefix, can_backquote on edge and random inputs); do not edit by hand.

#[track_caller]
def uc_chk(s: Str, q: Byte, want: Str) {
  r = unquote_char(s, q)
  got = "err"
  if t = r.ok {
    got = "#{t[0]} #{t[1]} #{t[2]}"
  }
  assert got == want, "unquote_char(#{quote(s)}, #{q}) = #{got}, want #{want} (#{caller_location})"
}

test "quote" {
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk("\x00", "\"\\x00\"", "\"\\x00\"", "\"\\x00\"")
  assert can_backquote("\x00") == false
  q_chk("\x7f", "\"\\x7f\"", "\"\\x7f\"", "\"\\x7f\"")
  assert can_backquote("\x7f") == false
  q_chk(Str.from_bytes([0x80]), "\"\\x80\"", "\"\\x80\"", "\"\\x80\"")
  assert can_backquote(Str.from_bytes([0x80])) == false
  q_chk(Str.from_bytes([0xff]), "\"\\xff\"", "\"\\xff\"", "\"\\xff\"")
  assert can_backquote(Str.from_bytes([0xff])) == false
  q_chk(Str.from_bytes([0xc0, 0x80]), "\"\\xc0\\x80\"", "\"\\xc0\\x80\"", "\"\\xc0\\x80\"")
  assert can_backquote(Str.from_bytes([0xc0, 0x80])) == false
  q_chk(Str.from_bytes([0xed, 0xa0, 0x80]), "\"\\xed\\xa0\\x80\"", "\"\\xed\\xa0\\x80\"", "\"\\xed\\xa0\\x80\"")
  assert can_backquote(Str.from_bytes([0xed, 0xa0, 0x80])) == false
  q_chk(Str.from_bytes([0xf4, 0x90, 0x80, 0x80]), "\"\\xf4\\x90\\x80\\x80\"", "\"\\xf4\\x90\\x80\\x80\"", "\"\\xf4\\x90\\x80\\x80\"")
  assert can_backquote(Str.from_bytes([0xf4, 0x90, 0x80, 0x80])) == false
  q_chk(Str.from_bytes([0xf0, 0x9f, 0x98]), "\"\\xf0\\x9f\\x98\"", "\"\\xf0\\x9f\\x98\"", "\"\\xf0\\x9f\\x98\"")
  assert can_backquote(Str.from_bytes([0xf0, 0x9f, 0x98])) == false
  q_chk(Str.from_bytes([0x61, 0xff, 0x62, 0xfe]), "\"a\\xffb\\xfe\"", "\"a\\xffb\\xfe\"", "\"a\\xffb\\xfe\"")
  assert can_backquote(Str.from_bytes([0x61, 0xff, 0x62, 0xfe])) == false
  q_chk("\u00ad", "\"\\u00ad\"", "\"\\u00ad\"", "\"\\u00ad\"")
  assert can_backquote("\u00ad") == true
  q_chk("\u200b", "\"\\u200b\"", "\"\\u200b\"", "\"\\u200b\"")
  assert can_backquote("\u200b") == true
  q_chk("\u2028", "\"\\u2028\"", "\"\\u2028\"", "\"\\u2028\"")
  assert can_backquote("\u2028") == true
  q_chk("\ufeff", "\"\\ufeff\"", "\"\\ufeff\"", "\"\\ufeff\"")
  assert can_backquote("\ufeff") == false
  q_chk("😀", "\"😀\"", "\"\\U0001f600\"", "\"😀\"")
  assert can_backquote("😀") == true
  q_chk("\U000e0001", "\"\\U000e0001\"", "\"\\U000e0001\"", "\"\\U000e0001\"")
  assert can_backquote("\U000e0001") == true
  q_chk("\U0010ffff", "\"\\U0010ffff\"", "\"\\U0010ffff\"", "\"\\U0010ffff\"")
  assert can_backquote("\U0010ffff") == true
  q_chk("�", "\"�\"", "\"\\ufffd\"", "\"�\"")
  assert can_backquote("�") == true
  q_chk("�", "\"�\"", "\"\\ufffd\"", "\"�\"")
  assert can_backquote("�") == true
  q_chk(Str.from_bytes([0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x80, 0xe8, 0xaa, 0x9e]), "\"日本\\x80語\"", "\"\\u65e5\\u672c\\x80\\u8a9e\"", "\"日本\\x80語\"")
  assert can_backquote(Str.from_bytes([0xe6, 0x97, 0xa5, 0xe6, 0x9c, 0xac, 0x80, 0xe8, 0xaa, 0x9e])) == false
  q_chk("\t\n\r\v\f\a\b", "\"\\t\\n\\r\\v\\f\\a\\b\"", "\"\\t\\n\\r\\v\\f\\a\\b\"", "\"\\t\\n\\r\\v\\f\\a\\b\"")
  assert can_backquote("\t\n\r\v\f\a\b") == false
  q_chk("\\", "\"\\\\\"", "\"\\\\\"", "\"\\\\\"")
  assert can_backquote("\\") == true
  q_chk("\"", "\"\\\"\"", "\"\\\"\"", "\"\\\"\"")
  assert can_backquote("\"") == true
  q_chk("'", "\"'\"", "\"'\"", "\"'\"")
  assert can_backquote("'") == true
  q_chk("`", "\"`\"", "\"`\"", "\"`\"")
  assert can_backquote("`") == false
  q_chk("\#{x}", "\"\#{x}\"", "\"\#{x}\"", "\"\#{x}\"")
  assert can_backquote("\#{x}") == true
  q_chk("̀", "\"̀\"", "\"\\u0300\"", "\"̀\"")
  assert can_backquote("̀") == true
  q_chk("é", "\"é\"", "\"e\\u0301\"", "\"é\"")
  assert can_backquote("é") == true
  q_chk("𝄞", "\"𝄞\"", "\"\\U0001d11e\"", "\"𝄞\"")
  assert can_backquote("𝄞") == true
  q_chk("\u3000\u00a0\u2000", "\"\\u3000\\u00a0\\u2000\"", "\"\\u3000\\u00a0\\u2000\"", "\"\u3000\u00a0\u2000\"")
  assert can_backquote("\u3000\u00a0\u2000") == true
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk(Str.from_bytes([0xe4, 0x25, 0xd7, 0x0e, 0xb1, 0x64, 0x6f]), "\"\\xe4%\\xd7\\x0e\\xb1do\"", "\"\\xe4%\\xd7\\x0e\\xb1do\"", "\"\\xe4%\\xd7\\x0e\\xb1do\"")
  assert can_backquote(Str.from_bytes([0xe4, 0x25, 0xd7, 0x0e, 0xb1, 0x64, 0x6f])) == false
  q_chk(Str.from_bytes([0x69, 0xcb, 0x43, 0x72, 0xfd, 0xf4]), "\"i\\xcbCr\\xfd\\xf4\"", "\"i\\xcbCr\\xfd\\xf4\"", "\"i\\xcbCr\\xfd\\xf4\"")
  assert can_backquote(Str.from_bytes([0x69, 0xcb, 0x43, 0x72, 0xfd, 0xf4])) == false
  q_chk(Str.from_bytes([0x5f, 0x3b, 0xbe, 0x38, 0x63, 0x7b, 0xd7]), "\"_;\\xbe8c{\\xd7\"", "\"_;\\xbe8c{\\xd7\"", "\"_;\\xbe8c{\\xd7\"")
  assert can_backquote(Str.from_bytes([0x5f, 0x3b, 0xbe, 0x38, 0x63, 0x7b, 0xd7])) == false
  q_chk(";$", "\";$\"", "\";$\"", "\";$\"")
  assert can_backquote(";$") == true
  q_chk("h-V\x12", "\"h-V\\x12\"", "\"h-V\\x12\"", "\"h-V\\x12\"")
  assert can_backquote("h-V\x12") == false
  q_chk(Str.from_bytes([0x3b, 0x08, 0x99, 0xbe, 0x45, 0x60]), "\";\\b\\x99\\xbeE`\"", "\";\\b\\x99\\xbeE`\"", "\";\\b\\x99\\xbeE`\"")
  assert can_backquote(Str.from_bytes([0x3b, 0x08, 0x99, 0xbe, 0x45, 0x60])) == false
  q_chk(Str.from_bytes([0x2a, 0x70, 0x6a, 0x6f, 0x57, 0xcc]), "\"*pjoW\\xcc\"", "\"*pjoW\\xcc\"", "\"*pjoW\\xcc\"")
  assert can_backquote(Str.from_bytes([0x2a, 0x70, 0x6a, 0x6f, 0x57, 0xcc])) == false
  q_chk("\x15tE", "\"\\x15tE\"", "\"\\x15tE\"", "\"\\x15tE\"")
  assert can_backquote("\x15tE") == false
  q_chk(Str.from_bytes([0x9a]), "\"\\x9a\"", "\"\\x9a\"", "\"\\x9a\"")
  assert can_backquote(Str.from_bytes([0x9a])) == false
  q_chk(Str.from_bytes([0x7b, 0x0d, 0xed, 0x5f]), "\"{\\r\\xed_\"", "\"{\\r\\xed_\"", "\"{\\r\\xed_\"")
  assert can_backquote(Str.from_bytes([0x7b, 0x0d, 0xed, 0x5f])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk("T", "\"T\"", "\"T\"", "\"T\"")
  assert can_backquote("T") == true
  q_chk("\x0f{W", "\"\\x0f{W\"", "\"\\x0f{W\"", "\"\\x0f{W\"")
  assert can_backquote("\x0f{W") == false
  q_chk(")Z6", "\")Z6\"", "\")Z6\"", "\")Z6\"")
  assert can_backquote(")Z6") == true
  q_chk("#", "\"#\"", "\"#\"", "\"#\"")
  assert can_backquote("#") == true
  q_chk(Str.from_bytes([0x22, 0x6c, 0x78, 0x30, 0xe6, 0x0b]), "\"\\\"lx0\\xe6\\v\"", "\"\\\"lx0\\xe6\\v\"", "\"\\\"lx0\\xe6\\v\"")
  assert can_backquote(Str.from_bytes([0x22, 0x6c, 0x78, 0x30, 0xe6, 0x0b])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk(Str.from_bytes([0x85, 0x5d, 0x75]), "\"\\x85]u\"", "\"\\x85]u\"", "\"\\x85]u\"")
  assert can_backquote(Str.from_bytes([0x85, 0x5d, 0x75])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
}

test "quote 2" {
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk(Str.from_bytes([0xe7, 0x34, 0xad, 0x30, 0x36, 0x27, 0x25]), "\"\\xe74\\xad06'%\"", "\"\\xe74\\xad06'%\"", "\"\\xe74\\xad06'%\"")
  assert can_backquote(Str.from_bytes([0xe7, 0x34, 0xad, 0x30, 0x36, 0x27, 0x25])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk(Str.from_bytes([0xe3, 0x6e, 0xff, 0x8a, 0x31]), "\"\\xe3n\\xff\\x8a1\"", "\"\\xe3n\\xff\\x8a1\"", "\"\\xe3n\\xff\\x8a1\"")
  assert can_backquote(Str.from_bytes([0xe3, 0x6e, 0xff, 0x8a, 0x31])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk(Str.from_bytes([0x94, 0xe6, 0x96, 0x53, 0x2d]), "\"\\x94\\xe6\\x96S-\"", "\"\\x94\\xe6\\x96S-\"", "\"\\x94\\xe6\\x96S-\"")
  assert can_backquote(Str.from_bytes([0x94, 0xe6, 0x96, 0x53, 0x2d])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk(Str.from_bytes([0x38, 0x9e, 0x2f, 0x5d, 0x60, 0x66, 0xa8]), "\"8\\x9e/]`f\\xa8\"", "\"8\\x9e/]`f\\xa8\"", "\"8\\x9e/]`f\\xa8\"")
  assert can_backquote(Str.from_bytes([0x38, 0x9e, 0x2f, 0x5d, 0x60, 0x66, 0xa8])) == false
  q_chk("C", "\"C\"", "\"C\"", "\"C\"")
  assert can_backquote("C") == true
  q_chk(Str.from_bytes([0xab]), "\"\\xab\"", "\"\\xab\"", "\"\\xab\"")
  assert can_backquote(Str.from_bytes([0xab])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk(Str.from_bytes([0x2a, 0x8a]), "\"*\\x8a\"", "\"*\\x8a\"", "\"*\\x8a\"")
  assert can_backquote(Str.from_bytes([0x2a, 0x8a])) == false
  q_chk(Str.from_bytes([0x59, 0x75, 0x28, 0xc2, 0x2d, 0x26]), "\"Yu(\\xc2-&\"", "\"Yu(\\xc2-&\"", "\"Yu(\\xc2-&\"")
  assert can_backquote(Str.from_bytes([0x59, 0x75, 0x28, 0xc2, 0x2d, 0x26])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk(Str.from_bytes([0xbe, 0x5f, 0x45, 0x74, 0x66, 0xf6]), "\"\\xbe_Etf\\xf6\"", "\"\\xbe_Etf\\xf6\"", "\"\\xbe_Etf\\xf6\"")
  assert can_backquote(Str.from_bytes([0xbe, 0x5f, 0x45, 0x74, 0x66, 0xf6])) == false
  q_chk(Str.from_bytes([0x5d, 0xa5, 0x5f, 0x2e]), "\"]\\xa5_.\"", "\"]\\xa5_.\"", "\"]\\xa5_.\"")
  assert can_backquote(Str.from_bytes([0x5d, 0xa5, 0x5f, 0x2e])) == false
  q_chk("߷", "\"߷\"", "\"\\u07f7\"", "\"߷\"")
  assert can_backquote("߷") == true
  q_chk(Str.from_bytes([0x87, 0x23]), "\"\\x87#\"", "\"\\x87#\"", "\"\\x87#\"")
  assert can_backquote(Str.from_bytes([0x87, 0x23])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk(Str.from_bytes([0xcc, 0x6d, 0x54, 0x26, 0x38, 0x12, 0xce]), "\"\\xccmT&8\\x12\\xce\"", "\"\\xccmT&8\\x12\\xce\"", "\"\\xccmT&8\\x12\\xce\"")
  assert can_backquote(Str.from_bytes([0xcc, 0x6d, 0x54, 0x26, 0x38, 0x12, 0xce])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk(Str.from_bytes([0xa8, 0x35, 0x42]), "\"\\xa85B\"", "\"\\xa85B\"", "\"\\xa85B\"")
  assert can_backquote(Str.from_bytes([0xa8, 0x35, 0x42])) == false
  q_chk(Str.from_bytes([0x04, 0x47, 0x5d, 0x5b, 0x33, 0xe5, 0xce]), "\"\\x04G][3\\xe5\\xce\"", "\"\\x04G][3\\xe5\\xce\"", "\"\\x04G][3\\xe5\\xce\"")
  assert can_backquote(Str.from_bytes([0x04, 0x47, 0x5d, 0x5b, 0x33, 0xe5, 0xce])) == false
  q_chk(Str.from_bytes([0x86, 0x2a]), "\"\\x86*\"", "\"\\x86*\"", "\"\\x86*\"")
  assert can_backquote(Str.from_bytes([0x86, 0x2a])) == false
  q_chk(Str.from_bytes([0xcb, 0xf4, 0x4b, 0x0b, 0x51, 0x54, 0x1b]), "\"\\xcb\\xf4K\\vQT\\x1b\"", "\"\\xcb\\xf4K\\vQT\\x1b\"", "\"\\xcb\\xf4K\\vQT\\x1b\"")
  assert can_backquote(Str.from_bytes([0xcb, 0xf4, 0x4b, 0x0b, 0x51, 0x54, 0x1b])) == false
  q_chk(Str.from_bytes([0xca]), "\"\\xca\"", "\"\\xca\"", "\"\\xca\"")
  assert can_backquote(Str.from_bytes([0xca])) == false
  q_chk("", "\"\"", "\"\"", "\"\"")
  assert can_backquote("") == true
  q_chk("Lgŏ", "\"Lgŏ\"", "\"Lg\\u014f\"", "\"Lgŏ\"")
  assert can_backquote("Lgŏ") == true
  q_chk(Str.from_bytes([0xce, 0x2b, 0xd2, 0x84]), "\"\\xce+҄\"", "\"\\xce+\\u0484\"", "\"\\xce+҄\"")
  assert can_backquote(Str.from_bytes([0xce, 0x2b, 0xd2, 0x84])) == false
  q_chk(Str.from_bytes([0x39, 0x19, 0x6c, 0x73, 0x30, 0xf7]), "\"9\\x19ls0\\xf7\"", "\"9\\x19ls0\\xf7\"", "\"9\\x19ls0\\xf7\"")
  assert can_backquote(Str.from_bytes([0x39, 0x19, 0x6c, 0x73, 0x30, 0xf7])) == false
  q_chk(":Oo?zw", "\":Oo?zw\"", "\":Oo?zw\"", "\":Oo?zw\"")
  assert can_backquote(":Oo?zw") == true
  q_chk(Str.from_bytes([0x1c, 0xc8, 0x22, 0x69]), "\"\\x1c\\xc8\\\"i\"", "\"\\x1c\\xc8\\\"i\"", "\"\\x1c\\xc8\\\"i\"")
  assert can_backquote(Str.from_bytes([0x1c, 0xc8, 0x22, 0x69])) == false
  q_chk(Str.from_bytes([0x2d, 0x45, 0x27, 0x3d, 0x9a, 0x68]), "\"-E'=\\x9ah\"", "\"-E'=\\x9ah\"", "\"-E'=\\x9ah\"")
  assert can_backquote(Str.from_bytes([0x2d, 0x45, 0x27, 0x3d, 0x9a, 0x68])) == false
  q_chk(Str.from_bytes([0x56, 0x66, 0x33, 0xb2]), "\"Vf3\\xb2\"", "\"Vf3\\xb2\"", "\"Vf3\\xb2\"")
  assert can_backquote(Str.from_bytes([0x56, 0x66, 0x33, 0xb2])) == false
  q_chk("6=wX;q", "\"6=wX;q\"", "\"6=wX;q\"", "\"6=wX;q\"")
  assert can_backquote("6=wX;q") == true
  q_chk("sM", "\"sM\"", "\"sM\"", "\"sM\"")
  assert can_backquote("sM") == true
  q_chk(Str.from_bytes([0xf8, 0x50, 0xe3, 0x87, 0x38, 0x2a, 0x36]), "\"\\xf8P\\xe3\\x878*6\"", "\"\\xf8P\\xe3\\x878*6\"", "\"\\xf8P\\xe3\\x878*6\"")
  assert can_backquote(Str.from_bytes([0xf8, 0x50, 0xe3, 0x87, 0x38, 0x2a, 0x36])) == false
  q_chk("q}ŪXX", "\"q}ŪXX\"", "\"q}\\u016aXX\"", "\"q}ŪXX\"")
  assert can_backquote("q}ŪXX") == true
}

test "quote_rune" {
  qr_chk(-1, "'�'", "'\\ufffd'", "'�'")
  assert is_print(-1) == false && is_graphic(-1) == false
  qr_chk(0, "'\\x00'", "'\\x00'", "'\\x00'")
  assert is_print(0) == false && is_graphic(0) == false
  qr_chk(7, "'\\a'", "'\\a'", "'\\a'")
  assert is_print(7) == false && is_graphic(7) == false
  qr_chk(31, "'\\x1f'", "'\\x1f'", "'\\x1f'")
  assert is_print(31) == false && is_graphic(31) == false
  qr_chk(32, "' '", "' '", "' '")
  assert is_print(32) == true && is_graphic(32) == true
  qr_chk(127, "'\\x7f'", "'\\x7f'", "'\\x7f'")
  assert is_print(127) == false && is_graphic(127) == false
  qr_chk(128, "'\\u0080'", "'\\u0080'", "'\\u0080'")
  assert is_print(128) == false && is_graphic(128) == false
  qr_chk(159, "'\\u009f'", "'\\u009f'", "'\\u009f'")
  assert is_print(159) == false && is_graphic(159) == false
  qr_chk(160, "'\\u00a0'", "'\\u00a0'", "'\u00a0'")
  assert is_print(160) == false && is_graphic(160) == true
  qr_chk(173, "'\\u00ad'", "'\\u00ad'", "'\\u00ad'")
  assert is_print(173) == false && is_graphic(173) == false
  qr_chk(255, "'ÿ'", "'\\u00ff'", "'ÿ'")
  assert is_print(255) == true && is_graphic(255) == true
  qr_chk(8232, "'\\u2028'", "'\\u2028'", "'\\u2028'")
  assert is_print(8232) == false && is_graphic(8232) == false
  qr_chk(55296, "'�'", "'\\ufffd'", "'�'")
  assert is_print(55296) == false && is_graphic(55296) == false
  qr_chk(57343, "'�'", "'\\ufffd'", "'�'")
  assert is_print(57343) == false && is_graphic(57343) == false
  qr_chk(65279, "'\\ufeff'", "'\\ufeff'", "'\\ufeff'")
  assert is_print(65279) == false && is_graphic(65279) == false
  qr_chk(65533, "'�'", "'\\ufffd'", "'�'")
  assert is_print(65533) == true && is_graphic(65533) == true
  qr_chk(65535, "'\\uffff'", "'\\uffff'", "'\\uffff'")
  assert is_print(65535) == false && is_graphic(65535) == false
  qr_chk(65536, "'𐀀'", "'\\U00010000'", "'𐀀'")
  assert is_print(65536) == true && is_graphic(65536) == true
  qr_chk(128512, "'😀'", "'\\U0001f600'", "'😀'")
  assert is_print(128512) == true && is_graphic(128512) == true
  qr_chk(917505, "'\\U000e0001'", "'\\U000e0001'", "'\\U000e0001'")
  assert is_print(917505) == false && is_graphic(917505) == false
  qr_chk(1114111, "'\\U0010ffff'", "'\\U0010ffff'", "'\\U0010ffff'")
  assert is_print(1114111) == false && is_graphic(1114111) == false
  qr_chk(1114112, "'�'", "'\\ufffd'", "'�'")
  assert is_print(1114112) == false && is_graphic(1114112) == false
  qr_chk(2147483647, "'�'", "'\\ufffd'", "'�'")
  assert is_print(2147483647) == false && is_graphic(2147483647) == false
  qr_chk(-2147483648, "'�'", "'\\ufffd'", "'�'")
  assert is_print(-2147483648) == false && is_graphic(-2147483648) == false
  qr_chk(977577, "'\\U000eeaa9'", "'\\U000eeaa9'", "'\\U000eeaa9'")
  assert is_print(977577) == false && is_graphic(977577) == false
  qr_chk(355916, "'\\U00056e4c'", "'\\U00056e4c'", "'\\U00056e4c'")
  assert is_print(355916) == false && is_graphic(355916) == false
  qr_chk(671341, "'\\U000a3e6d'", "'\\U000a3e6d'", "'\\U000a3e6d'")
  assert is_print(671341) == false && is_graphic(671341) == false
  qr_chk(850086, "'\\U000cf8a6'", "'\\U000cf8a6'", "'\\U000cf8a6'")
  assert is_print(850086) == false && is_graphic(850086) == false
