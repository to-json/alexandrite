test "unquote 4" {
  unq_chk(Str.from_bytes([0x27, 0x2d, 0x45, 0x27, 0x3d, 0x9a, 0x68, 0x27]), "", true)
  unq_chk(Str.from_bytes([0x60, 0x2d, 0x45, 0x27, 0x3d, 0x9a, 0x68, 0x60]), Str.from_bytes([0x2d, 0x45, 0x27, 0x3d, 0x9a, 0x68]), false)
  unq_chk("\"Vf3\\xb2\"", Str.from_bytes([0x56, 0x66, 0x33, 0xb2]), false)
  unq_chk(Str.from_bytes([0x27, 0x56, 0x66, 0x33, 0xb2, 0x27]), "", true)
  unq_chk(Str.from_bytes([0x60, 0x56, 0x66, 0x33, 0xb2, 0x60]), Str.from_bytes([0x56, 0x66, 0x33, 0xb2]), false)
  unq_chk("\"6=wX;q\"", "6=wX;q", false)
  unq_chk("'6=wX;q'", "", true)
  unq_chk("`6=wX;q`", "6=wX;q", false)
  unq_chk("\"sM\"", "sM", false)
  unq_chk("'sM'", "", true)
  unq_chk("`sM`", "sM", false)
  unq_chk("\"\\xf8P\\xe3\\x878*6\"", Str.from_bytes([0xf8, 0x50, 0xe3, 0x87, 0x38, 0x2a, 0x36]), false)
  unq_chk(Str.from_bytes([0x27, 0xf8, 0x50, 0xe3, 0x87, 0x38, 0x2a, 0x36, 0x27]), "", true)
  unq_chk(Str.from_bytes([0x60, 0xf8, 0x50, 0xe3, 0x87, 0x38, 0x2a, 0x36, 0x60]), Str.from_bytes([0xf8, 0x50, 0xe3, 0x87, 0x38, 0x2a, 0x36]), false)
  unq_chk("\"q}ŪXX\"", "q}ŪXX", false)
  unq_chk("'q}ŪXX'", "", true)
  unq_chk("`q}ŪXX`", "q}ŪXX", false)
}

test "unquote_char" {
  uc_chk("\\x41rest", 39, "65 false rest")
  uc_chk("\\x41rest", 34, "65 false rest")
  uc_chk("\\x41rest", 0, "65 false rest")
  uc_chk("\\x41rest", 96, "65 false rest")
  uc_chk("\\101", 39, "65 false ")
  uc_chk("\\101", 34, "65 false ")
  uc_chk("\\101", 0, "65 false ")
  uc_chk("\\101", 96, "65 false ")
  uc_chk("\\u00e9x", 39, "233 true x")
  uc_chk("\\u00e9x", 34, "233 true x")
  uc_chk("\\u00e9x", 0, "233 true x")
  uc_chk("\\u00e9x", 96, "233 true x")
  uc_chk("\\U0001F600", 39, "128512 true ")
  uc_chk("\\U0001F600", 34, "128512 true ")
  uc_chk("\\U0001F600", 0, "128512 true ")
  uc_chk("\\U0001F600", 96, "128512 true ")
  uc_chk("\\'", 39, "39 false ")
  uc_chk("\\'", 34, "err")
  uc_chk("\\'", 0, "err")
  uc_chk("\\'", 96, "err")
  uc_chk("\\\"", 39, "err")
  uc_chk("\\\"", 34, "34 false ")
  uc_chk("\\\"", 0, "err")
  uc_chk("\\\"", 96, "err")
  uc_chk("\\n", 39, "10 false ")
  uc_chk("\\n", 34, "10 false ")
  uc_chk("\\n", 0, "10 false ")
  uc_chk("\\n", 96, "10 false ")
  uc_chk("\\z", 39, "err")
  uc_chk("\\z", 34, "err")
  uc_chk("\\z", 0, "err")
  uc_chk("\\z", 96, "err")
  uc_chk("\\", 39, "err")
  uc_chk("\\", 34, "err")
  uc_chk("\\", 0, "err")
  uc_chk("\\", 96, "err")
  uc_chk("é", 39, "233 true ")
  uc_chk("é", 34, "233 true ")
  uc_chk("é", 0, "233 true ")
  uc_chk("é", 96, "233 true ")
  uc_chk(Str.from_bytes([0xff]), 39, "65533 true ")
  uc_chk(Str.from_bytes([0xff]), 34, "65533 true ")
  uc_chk(Str.from_bytes([0xff]), 0, "65533 true ")
  uc_chk(Str.from_bytes([0xff]), 96, "65533 true ")
  uc_chk("\\x8", 39, "err")
  uc_chk("\\x8", 34, "err")
  uc_chk("\\x8", 0, "err")
  uc_chk("\\x8", 96, "err")
  uc_chk("\\400", 39, "err")
  uc_chk("\\400", 34, "err")
  uc_chk("\\400", 0, "err")
  uc_chk("\\400", 96, "err")
  uc_chk("\\ud800", 39, "err")
  uc_chk("\\ud800", 34, "err")
  uc_chk("\\ud800", 0, "err")
  uc_chk("\\ud800", 96, "err")
  uc_chk("a", 39, "97 false ")
  uc_chk("a", 34, "97 false ")
  uc_chk("a", 0, "97 false ")
  uc_chk("a", 96, "97 false ")
  uc_chk("", 39, "err")
  uc_chk("", 34, "err")
  uc_chk("", 0, "err")
  uc_chk("", 96, "err")
}
