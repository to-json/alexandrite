# Generated from Go's strconv (go run): expected results of the quoting functions.

def chk_unq(s: Str, want: Str) {
  r = unquote(s)
  if v = r.ok {
    assert_eq v, want
  } else {
    assert_eq "#{r.err}", "ok"
  }
}

def chk_unq_err(s: Str) {
  r = unquote(s)
  if v = r.ok {
    assert_eq v, "error expected"
  } else {
    assert_eq "#{r.err}", "invalid syntax"
  }
}

def chk_prefix(s: Str, want: Str) {
  r = quoted_prefix(s)
  if v = r.ok {
    assert_eq v, want
  } else {
    assert_eq "#{r.err}", "ok"
  }
}

def chk_prefix_err(s: Str) {
  r = quoted_prefix(s)
  if v = r.ok {
    assert_eq v, "error expected"
  } else {
    assert_eq "#{r.err}", "invalid syntax"
  }
}

test "quote vectors" {
  assert_eq quote(""), "\"\""
  assert_eq quote_to_ascii(""), "\"\""
  assert_eq quote_to_graphic(""), "\"\""
  assert can_backquote("")
  assert_eq quote("hello"), "\"hello\""
  assert_eq quote_to_ascii("hello"), "\"hello\""
  assert_eq quote_to_graphic("hello"), "\"hello\""
  assert can_backquote("hello")
  assert_eq quote("hello world"), "\"hello world\""
  assert_eq quote_to_ascii("hello world"), "\"hello world\""
  assert_eq quote_to_graphic("hello world"), "\"hello world\""
  assert can_backquote("hello world")
  assert_eq quote("a\"b"), "\"a\\\"b\""
  assert_eq quote_to_ascii("a\"b"), "\"a\\\"b\""
  assert_eq quote_to_graphic("a\"b"), "\"a\\\"b\""
  assert can_backquote("a\"b")
  assert_eq quote("a'b"), "\"a'b\""
  assert_eq quote_to_ascii("a'b"), "\"a'b\""
  assert_eq quote_to_graphic("a'b"), "\"a'b\""
  assert can_backquote("a'b")
  assert_eq quote("back\\slash"), "\"back\\\\slash\""
  assert_eq quote_to_ascii("back\\slash"), "\"back\\\\slash\""
  assert_eq quote_to_graphic("back\\slash"), "\"back\\\\slash\""
  assert can_backquote("back\\slash")
  assert_eq quote("tab\there"), "\"tab\\there\""
  assert_eq quote_to_ascii("tab\there"), "\"tab\\there\""
  assert_eq quote_to_graphic("tab\there"), "\"tab\\there\""
  assert can_backquote("tab\there")
  assert_eq quote("nl\nhere"), "\"nl\\nhere\""
  assert_eq quote_to_ascii("nl\nhere"), "\"nl\\nhere\""
  assert_eq quote_to_graphic("nl\nhere"), "\"nl\\nhere\""
  assert !can_backquote("nl\nhere")
  assert_eq quote(bs([0x63, 0x72, 0x0d, 0x68, 0x65, 0x72, 0x65])), "\"cr\\rhere\""
  assert_eq quote_to_ascii(bs([0x63, 0x72, 0x0d, 0x68, 0x65, 0x72, 0x65])), "\"cr\\rhere\""
  assert_eq quote_to_graphic(bs([0x63, 0x72, 0x0d, 0x68, 0x65, 0x72, 0x65])), "\"cr\\rhere\""
  assert !can_backquote(bs([0x63, 0x72, 0x0d, 0x68, 0x65, 0x72, 0x65]))
  assert_eq quote(bs([0x07, 0x08, 0x0c, 0x0b])), "\"\\a\\b\\f\\v\""
  assert_eq quote_to_ascii(bs([0x07, 0x08, 0x0c, 0x0b])), "\"\\a\\b\\f\\v\""
  assert_eq quote_to_graphic(bs([0x07, 0x08, 0x0c, 0x0b])), "\"\\a\\b\\f\\v\""
  assert !can_backquote(bs([0x07, 0x08, 0x0c, 0x0b]))
  assert_eq quote(bs([0x6e, 0x75, 0x6c, 0x00, 0x62, 0x79, 0x74, 0x65])), "\"nul\\x00byte\""
  assert_eq quote_to_ascii(bs([0x6e, 0x75, 0x6c, 0x00, 0x62, 0x79, 0x74, 0x65])), "\"nul\\x00byte\""
  assert_eq quote_to_graphic(bs([0x6e, 0x75, 0x6c, 0x00, 0x62, 0x79, 0x74, 0x65])), "\"nul\\x00byte\""
  assert !can_backquote(bs([0x6e, 0x75, 0x6c, 0x00, 0x62, 0x79, 0x74, 0x65]))
  assert_eq quote(bs([0x01, 0x1f, 0x7f])), "\"\\x01\\x1f\\x7f\""
  assert_eq quote_to_ascii(bs([0x01, 0x1f, 0x7f])), "\"\\x01\\x1f\\x7f\""
  assert_eq quote_to_graphic(bs([0x01, 0x1f, 0x7f])), "\"\\x01\\x1f\\x7f\""
  assert !can_backquote(bs([0x01, 0x1f, 0x7f]))
  assert_eq quote("héllo"), "\"héllo\""
  assert_eq quote_to_ascii("héllo"), "\"h\\u00e9llo\""
  assert_eq quote_to_graphic("héllo"), "\"héllo\""
  assert can_backquote("héllo")
  assert_eq quote("日本語"), "\"日本語\""
  assert_eq quote_to_ascii("日本語"), "\"\\u65e5\\u672c\\u8a9e\""
  assert_eq quote_to_graphic("日本語"), "\"日本語\""
  assert can_backquote("日本語")
  assert_eq quote("😀 emoji"), "\"😀 emoji\""
  assert_eq quote_to_ascii("😀 emoji"), "\"\\U0001f600 emoji\""
  assert_eq quote_to_graphic("😀 emoji"), "\"😀 emoji\""
  assert can_backquote("😀 emoji")
  assert_eq quote(" nbsp"), "\"\\u00a0nbsp\""
  assert_eq quote_to_ascii(" nbsp"), "\"\\u00a0nbsp\""
  assert_eq quote_to_graphic(" nbsp"), "\" nbsp\""
  assert can_backquote(" nbsp")
  assert_eq quote(" sep"), "\"\\u2028sep\""
  assert_eq quote_to_ascii(" sep"), "\"\\u2028sep\""
  assert_eq quote_to_graphic(" sep"), "\"\\u2028sep\""
  assert can_backquote(" sep")
  assert_eq quote("　ideographic"), "\"\\u3000ideographic\""
  assert_eq quote_to_ascii("　ideographic"), "\"\\u3000ideographic\""
  assert_eq quote_to_graphic("　ideographic"), "\"　ideographic\""
  assert can_backquote("　ideographic")
  assert_eq quote("﻿bom"), "\"\\ufeffbom\""
  assert_eq quote_to_ascii("﻿bom"), "\"\\ufeffbom\""
  assert_eq quote_to_graphic("﻿bom"), "\"\\ufeffbom\""
  assert !can_backquote("﻿bom")
  assert_eq quote(bs([0xff, 0xfe])), "\"\\xff\\xfe\""
  assert_eq quote_to_ascii(bs([0xff, 0xfe])), "\"\\xff\\xfe\""
  assert_eq quote_to_graphic(bs([0xff, 0xfe])), "\"\\xff\\xfe\""
  assert !can_backquote(bs([0xff, 0xfe]))
  assert_eq quote(bs([0x6f, 0x6b, 0x80, 0x62, 0x61, 0x64])), "\"ok\\x80bad\""
  assert_eq quote_to_ascii(bs([0x6f, 0x6b, 0x80, 0x62, 0x61, 0x64])), "\"ok\\x80bad\""
  assert_eq quote_to_graphic(bs([0x6f, 0x6b, 0x80, 0x62, 0x61, 0x64])), "\"ok\\x80bad\""
  assert !can_backquote(bs([0x6f, 0x6b, 0x80, 0x62, 0x61, 0x64]))
  assert_eq quote(bs([0xc3])), "\"\\xc3\""
  assert_eq quote_to_ascii(bs([0xc3])), "\"\\xc3\""
  assert_eq quote_to_graphic(bs([0xc3])), "\"\\xc3\""
  assert !can_backquote(bs([0xc3]))
  assert_eq quote(bs([0xed, 0xa0, 0x80])), "\"\\xed\\xa0\\x80\""
  assert_eq quote_to_ascii(bs([0xed, 0xa0, 0x80])), "\"\\xed\\xa0\\x80\""
  assert_eq quote_to_graphic(bs([0xed, 0xa0, 0x80])), "\"\\xed\\xa0\\x80\""
  assert !can_backquote(bs([0xed, 0xa0, 0x80]))
  assert_eq quote(bs([0xf4, 0x90, 0x80, 0x80])), "\"\\xf4\\x90\\x80\\x80\""
  assert_eq quote_to_ascii(bs([0xf4, 0x90, 0x80, 0x80])), "\"\\xf4\\x90\\x80\\x80\""
  assert_eq quote_to_graphic(bs([0xf4, 0x90, 0x80, 0x80])), "\"\\xf4\\x90\\x80\\x80\""
  assert !can_backquote(bs([0xf4, 0x90, 0x80, 0x80]))
  assert_eq quote(bs([0x6d, 0x69, 0x78, 0x20, 0xe2, 0x82, 0x20, 0x65, 0x6e, 0x64])), "\"mix \\xe2\\x82 end\""
  assert_eq quote_to_ascii(bs([0x6d, 0x69, 0x78, 0x20, 0xe2, 0x82, 0x20, 0x65, 0x6e, 0x64])), "\"mix \\xe2\\x82 end\""
  assert_eq quote_to_graphic(bs([0x6d, 0x69, 0x78, 0x20, 0xe2, 0x82, 0x20, 0x65, 0x6e, 0x64])), "\"mix \\xe2\\x82 end\""
  assert !can_backquote(bs([0x6d, 0x69, 0x78, 0x20, 0xe2, 0x82, 0x20, 0x65, 0x6e, 0x64]))
  assert_eq quote("􏿿"), "\"\\U0010ffff\""
  assert_eq quote_to_ascii("􏿿"), "\"\\U0010ffff\""
  assert_eq quote_to_graphic("􏿿"), "\"\\U0010ffff\""
  assert can_backquote("􏿿")
  assert_eq quote("􏿾"), "\"\\U0010fffe\""
  assert_eq quote_to_ascii("􏿾"), "\"\\U0010fffe\""
  assert_eq quote_to_graphic("􏿾"), "\"\\U0010fffe\""
  assert can_backquote("􏿾")
  assert_eq quote("͸unassigned"), "\"\\u0378unassigned\""
  assert_eq quote_to_ascii("͸unassigned"), "\"\\u0378unassigned\""
  assert_eq quote_to_graphic("͸unassigned"), "\"\\u0378unassigned\""
  assert can_backquote("͸unassigned")
  assert_eq quote("​zwsp"), "\"\\u200bzwsp\""
  assert_eq quote_to_ascii("​zwsp"), "\"\\u200bzwsp\""
  assert_eq quote_to_graphic("​zwsp"), "\"\\u200bzwsp\""
  assert can_backquote("​zwsp")
  assert_eq quote("­soft"), "\"\\u00adsoft\""
  assert_eq quote_to_ascii("­soft"), "\"\\u00adsoft\""
  assert_eq quote_to_graphic("­soft"), "\"\\u00adsoft\""
  assert can_backquote("­soft")
  assert_eq quote("☃"), "\"☃\""
  assert_eq quote_to_ascii("☃"), "\"\\u2603\""
  assert_eq quote_to_graphic("☃"), "\"☃\""
  assert can_backquote("☃")
  assert_eq quote("`tick`"), "\"`tick`\""
  assert_eq quote_to_ascii("`tick`"), "\"`tick`\""
  assert_eq quote_to_graphic("`tick`"), "\"`tick`\""
  assert !can_backquote("`tick`")
  assert_eq quote("it's"), "\"it's\""
  assert_eq quote_to_ascii("it's"), "\"it's\""
  assert_eq quote_to_graphic("it's"), "\"it's\""
  assert can_backquote("it's")
  assert_eq quote("say \"hi\""), "\"say \\\"hi\\\"\""
  assert_eq quote_to_ascii("say \"hi\""), "\"say \\\"hi\\\"\""
  assert_eq quote_to_graphic("say \"hi\""), "\"say \\\"hi\\\"\""
  assert can_backquote("say \"hi\"")
  assert_eq quote("\\n"), "\"\\\\n\""
  assert_eq quote_to_ascii("\\n"), "\"\\\\n\""
  assert_eq quote_to_graphic("\\n"), "\"\\\\n\""
  assert can_backquote("\\n")
  assert_eq quote(""), "\"\\u0085\""
  assert_eq quote_to_ascii(""), "\"\\u0085\""
  assert_eq quote_to_graphic(""), "\"\\u0085\""
  assert can_backquote("")
  assert_eq quote(""), "\"\\u009f\""
  assert_eq quote_to_ascii(""), "\"\\u009f\""
  assert_eq quote_to_graphic(""), "\"\\u009f\""
  assert can_backquote("")
  assert_eq quote("¡"), "\"¡\""
  assert_eq quote_to_ascii("¡"), "\"\\u00a1\""
  assert_eq quote_to_graphic("¡"), "\"¡\""
  assert can_backquote("¡")
  assert_eq quote("ÿ"), "\"ÿ\""
  assert_eq quote_to_ascii("ÿ"), "\"\\u00ff\""
  assert_eq quote_to_graphic("ÿ"), "\"ÿ\""
  assert can_backquote("ÿ")
  assert_eq quote("private"), "\"\\ue000private\""
  assert_eq quote_to_ascii("private"), "\"\\ue000private\""
  assert_eq quote_to_graphic("private"), "\"\\ue000private\""
  assert can_backquote("private")
  assert_eq quote("؀"), "\"\\u0600\""
  assert_eq quote_to_ascii("؀"), "\"\\u0600\""
  assert_eq quote_to_graphic("؀"), "\"\\u0600\""
  assert can_backquote("؀")
  assert_eq quote("😀😁"), "\"😀😁\""
  assert_eq quote_to_ascii("😀😁"), "\"\\U0001f600\\U0001f601\""
  assert_eq quote_to_graphic("😀😁"), "\"😀😁\""
  assert can_backquote("😀😁")
  assert_eq quote("à"), "\"à\""
  assert_eq quote_to_ascii("à"), "\"a\\u0300\""
  assert_eq quote_to_graphic("à"), "\"à\""
  assert can_backquote("à")
  assert_eq quote("‮"), "\"\\u202e\""
  assert_eq quote_to_ascii("‮"), "\"\\u202e\""
  assert_eq quote_to_graphic("‮"), "\"\\u202e\""
  assert can_backquote("‮")
  assert_eq quote("�"), "\"�\""
  assert_eq quote_to_ascii("�"), "\"\\ufffd\""
  assert_eq quote_to_graphic("�"), "\"�\""
  assert can_backquote("�")
  assert_eq quote("𐀀"), "\"𐀀\""
  assert_eq quote_to_ascii("𐀀"), "\"\\U00010000\""
  assert_eq quote_to_graphic("𐀀"), "\"𐀀\""
  assert can_backquote("𐀀")
}

test "quote_rune vectors" {
  assert_eq quote_rune(0x61), "'a'"
  assert_eq quote_rune_to_ascii(0x61), "'a'"
  assert_eq quote_rune_to_graphic(0x61), "'a'"
  assert_eq quote_rune(0x41), "'A'"
  assert_eq quote_rune_to_ascii(0x41), "'A'"
  assert_eq quote_rune_to_graphic(0x41), "'A'"
  assert_eq quote_rune(0x30), "'0'"
  assert_eq quote_rune_to_ascii(0x30), "'0'"
  assert_eq quote_rune_to_graphic(0x30), "'0'"
  assert_eq quote_rune(0x20), "' '"
  assert_eq quote_rune_to_ascii(0x20), "' '"
  assert_eq quote_rune_to_graphic(0x20), "' '"
  assert_eq quote_rune(0x27), "'\\''"
  assert_eq quote_rune_to_ascii(0x27), "'\\''"
  assert_eq quote_rune_to_graphic(0x27), "'\\''"
  assert_eq quote_rune(0x22), "'\"'"
  assert_eq quote_rune_to_ascii(0x22), "'\"'"
  assert_eq quote_rune_to_graphic(0x22), "'\"'"
  assert_eq quote_rune(0x5c), "'\\\\'"
  assert_eq quote_rune_to_ascii(0x5c), "'\\\\'"
  assert_eq quote_rune_to_graphic(0x5c), "'\\\\'"
  assert_eq quote_rune(0xa), "'\\n'"
  assert_eq quote_rune_to_ascii(0xa), "'\\n'"
  assert_eq quote_rune_to_graphic(0xa), "'\\n'"
  assert_eq quote_rune(0x9), "'\\t'"
  assert_eq quote_rune_to_ascii(0x9), "'\\t'"
  assert_eq quote_rune_to_graphic(0x9), "'\\t'"
  assert_eq quote_rune(0x0), "'\\x00'"
  assert_eq quote_rune_to_ascii(0x0), "'\\x00'"
  assert_eq quote_rune_to_graphic(0x0), "'\\x00'"
  assert_eq quote_rune(0x7), "'\\a'"
  assert_eq quote_rune_to_ascii(0x7), "'\\a'"
  assert_eq quote_rune_to_graphic(0x7), "'\\a'"
  assert_eq quote_rune(0x1f), "'\\x1f'"
  assert_eq quote_rune_to_ascii(0x1f), "'\\x1f'"
  assert_eq quote_rune_to_graphic(0x1f), "'\\x1f'"
  assert_eq quote_rune(0x7f), "'\\x7f'"
  assert_eq quote_rune_to_ascii(0x7f), "'\\x7f'"
  assert_eq quote_rune_to_graphic(0x7f), "'\\x7f'"
  assert_eq quote_rune(0x80), "'\\u0080'"
  assert_eq quote_rune_to_ascii(0x80), "'\\u0080'"
  assert_eq quote_rune_to_graphic(0x80), "'\\u0080'"
  assert_eq quote_rune(0xa0), "'\\u00a0'"
  assert_eq quote_rune_to_ascii(0xa0), "'\\u00a0'"
  assert_eq quote_rune_to_graphic(0xa0), "' '"
  assert_eq quote_rune(0xad), "'\\u00ad'"
  assert_eq quote_rune_to_ascii(0xad), "'\\u00ad'"
  assert_eq quote_rune_to_graphic(0xad), "'\\u00ad'"
  assert_eq quote_rune(0xe9), "'é'"
  assert_eq quote_rune_to_ascii(0xe9), "'\\u00e9'"
  assert_eq quote_rune_to_graphic(0xe9), "'é'"
  assert_eq quote_rune(0x263a), "'☺'"
  assert_eq quote_rune_to_ascii(0x263a), "'\\u263a'"
  assert_eq quote_rune_to_graphic(0x263a), "'☺'"
  assert_eq quote_rune(0x1f600), "'😀'"
  assert_eq quote_rune_to_ascii(0x1f600), "'\\U0001f600'"
  assert_eq quote_rune_to_graphic(0x1f600), "'😀'"
  assert_eq quote_rune(0x10ffff), "'\\U0010ffff'"
  assert_eq quote_rune_to_ascii(0x10ffff), "'\\U0010ffff'"
  assert_eq quote_rune_to_graphic(0x10ffff), "'\\U0010ffff'"
  assert_eq quote_rune(0x110000), "'�'"
  assert_eq quote_rune_to_ascii(0x110000), "'\\ufffd'"
  assert_eq quote_rune_to_graphic(0x110000), "'�'"
  assert_eq quote_rune((0 - 1)), "'�'"
  assert_eq quote_rune_to_ascii((0 - 1)), "'\\ufffd'"
  assert_eq quote_rune_to_graphic((0 - 1)), "'�'"
  assert_eq quote_rune(0xd800), "'�'"
  assert_eq quote_rune_to_ascii(0xd800), "'\\ufffd'"
  assert_eq quote_rune_to_graphic(0xd800), "'�'"
  assert_eq quote_rune(0xdfff), "'�'"
  assert_eq quote_rune_to_ascii(0xdfff), "'\\ufffd'"
  assert_eq quote_rune_to_graphic(0xdfff), "'�'"
  assert_eq quote_rune(0xfffd), "'�'"
  assert_eq quote_rune_to_ascii(0xfffd), "'\\ufffd'"
  assert_eq quote_rune_to_graphic(0xfffd), "'�'"
  assert_eq quote_rune(0xffff), "'\\uffff'"
  assert_eq quote_rune_to_ascii(0xffff), "'\\uffff'"
  assert_eq quote_rune_to_graphic(0xffff), "'\\uffff'"
  assert_eq quote_rune(0x10000), "'𐀀'"
  assert_eq quote_rune_to_ascii(0x10000), "'\\U00010000'"
  assert_eq quote_rune_to_graphic(0x10000), "'𐀀'"
  assert_eq quote_rune(0x3000), "'\\u3000'"
  assert_eq quote_rune_to_ascii(0x3000), "'\\u3000'"
  assert_eq quote_rune_to_graphic(0x3000), "'　'"
  assert_eq quote_rune(0x2028), "'\\u2028'"
  assert_eq quote_rune_to_ascii(0x2028), "'\\u2028'"
  assert_eq quote_rune_to_graphic(0x2028), "'\\u2028'"
  assert_eq quote_rune(0x200b), "'\\u200b'"
  assert_eq quote_rune_to_ascii(0x200b), "'\\u200b'"
  assert_eq quote_rune_to_graphic(0x200b), "'\\u200b'"
  assert_eq quote_rune(0xe000), "'\\ue000'"
  assert_eq quote_rune_to_ascii(0xe000), "'\\ue000'"
  assert_eq quote_rune_to_graphic(0xe000), "'\\ue000'"
}

test "unquote vectors" {
  chk_unq("\"\"", "")
  chk_prefix("\"\"", "\"\"")
  chk_unq("\"abc\"", "abc")
  chk_prefix("\"abc\"", "\"abc\"")
  chk_unq("\"a\\nb\"", "a\nb")
  chk_prefix("\"a\\nb\"", "\"a\\nb\"")
  chk_unq("\"\\a\\b\\f\\n\\r\\t\\v\\\\\\\"\"", bs([0x07, 0x08, 0x0c, 0x0a, 0x0d, 0x09, 0x0b, 0x5c, 0x22]))
  chk_prefix("\"\\a\\b\\f\\n\\r\\t\\v\\\\\\\"\"", "\"\\a\\b\\f\\n\\r\\t\\v\\\\\\\"\"")
  chk_unq("\"\\x41\\x42\"", "AB")
  chk_prefix("\"\\x41\\x42\"", "\"\\x41\\x42\"")
  chk_unq("\"é\\U0001f600\"", "é😀")
  chk_prefix("\"é\\U0001f600\"", "\"é\\U0001f600\"")
  chk_unq("\"\\101\\102\"", "AB")
  chk_prefix("\"\\101\\102\"", "\"\\101\\102\"")
  chk_unq("\"\\377\"", bs([0xff]))
  chk_prefix("\"\\377\"", "\"\\377\"")
  chk_unq("\"\\xff\"", bs([0xff]))
  chk_prefix("\"\\xff\"", "\"\\xff\"")
  chk_unq_err("\"\\400\"")
  chk_prefix_err("\"\\400\"")
  chk_unq_err("\"\\x4\"")
  chk_prefix_err("\"\\x4\"")
  chk_unq_err("\"\\u12\"")
  chk_prefix_err("\"\\u12\"")
  chk_unq_err("\"\\U00110000\"")
  chk_prefix_err("\"\\U00110000\"")
  chk_unq_err("\"\\ud800\"")
  chk_prefix_err("\"\\ud800\"")
  chk_unq_err("\"abc")
  chk_prefix_err("\"abc")
  chk_unq_err("abc\"")
  chk_prefix_err("abc\"")
  chk_unq_err("\"abc\" ")
  chk_prefix("\"abc\" ", "\"abc\"")
  chk_unq_err(" \"abc\"")
  chk_prefix_err(" \"abc\"")
  chk_unq_err("\"a\"b\"")
  chk_prefix("\"a\"b\"", "\"a\"")
  chk_unq("'a'", "a")
  chk_prefix("'a'", "'a'")
  chk_unq_err("'ab'")
  chk_prefix_err("'ab'")
  chk_unq("''", "")
  chk_prefix("''", "''")
  chk_unq("'\\n'", "\n")
  chk_prefix("'\\n'", "'\\n'")
  chk_unq("'\\''", "'")
  chk_prefix("'\\''", "'\\''")
  chk_unq("'\"'", "\"")
  chk_prefix("'\"'", "'\"'")
  chk_unq("\"'\"", "'")
  chk_prefix("\"'\"", "\"'\"")
  chk_unq_err("\"\\'\"")
  chk_prefix_err("\"\\'\"")
  chk_unq_err("'\\\"'")
  chk_prefix_err("'\\\"'")
  chk_unq("'\\x41'", "A")
  chk_prefix("'\\x41'", "'\\x41'")
  chk_unq("'é'", "é")
  chk_prefix("'é'", "'é'")
  chk_unq("'日'", "日")
  chk_prefix("'日'", "'日'")
