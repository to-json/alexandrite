test "complex" {
  atoc_chk("(-2.5e-3+-1i)", 128, (-0.0025), (-1.0), "")
  assert_eq format_complex(Complex.new((-0.0025), (-1.0)), "g", -1, 128), "(-0.0025-1i)"
  assert_eq format_complex(Complex.new((-0.0025), (-1.0)), "e", 3, 128), "(-2.500e-03-1.000e+00i)"
  assert_eq format_complex(Complex.new((-0.0025), (-1.0)), "f", 3, 128), "(-0.003-1.000i)"
  atoc_chk("(-2.5e-3+-1i)", 64, (-0.0024999999441206455), (-1.0), "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), (-1.0)), "g", 3, 64), "(-0.0025-1i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), (-1.0)), "e", 1, 64), "(-2.5e-03-1.0e+00i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), (-1.0)), "f", 0, 64), "(-0-1i)"
  atoc_chk("-Infi", 128, 0.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "g", 0, 128), "(0-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "e", 2, 128), "(0.00e+00-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "f", 4, 128), "(0.0000-Infi)"
  atoc_chk("-Infi", 64, 0.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "g", 1, 64), "(0-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "e", 3, 64), "(0.000e+00-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "f", 4, 64), "(0.0000-Infi)"
  atoc_chk("-Inf", 128, math.inf(-1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "g", -1, 128), "(-Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "e", 1, 128), "(-Inf+0.0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "f", -1, 128), "(-Inf+0i)"
  atoc_chk("-Inf", 64, math.inf(-1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "g", 2, 64), "(-Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "e", 1, 64), "(-Inf+0.0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "f", 2, 64), "(-Inf+0.00i)"
  atoc_chk("-Inf+0x1p-2i", 128, math.inf(-1), 0.25, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 0.25), "g", 3, 128), "(-Inf+0.25i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.25), "e", 1, 128), "(-Inf+2.5e-01i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.25), "f", 0, 128), "(-Inf+0i)"
  atoc_chk("-Inf+0x1p-2i", 64, math.inf(-1), 0.25, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 0.25), "g", -1, 64), "(-Inf+0.25i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.25), "e", 0, 64), "(-Inf+2e-01i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.25), "f", 3, 64), "(-Inf+0.250i)"
  atoc_chk("3.4028236e38i", 128, 0.0, 3.4028236e38, "")
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "g", 4, 128), "(0+3.403e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "e", 4, 128), "(0.0000e+00+3.4028e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "f", 4, 128), "(0.0000+340282359999999991113723490719674400768.0000i)"
  atoc_chk("3.4028236e38i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38i\": value out of range")
  atoc_chk("(1.5+1i)", 128, 1.5, 1.0, "")
  assert_eq format_complex(Complex.new(1.5, 1.0), "g", 4, 128), "(1.5+1i)"
  assert_eq format_complex(Complex.new(1.5, 1.0), "e", 1, 128), "(1.5e+00+1.0e+00i)"
  assert_eq format_complex(Complex.new(1.5, 1.0), "f", 3, 128), "(1.500+1.000i)"
  atoc_chk("(1.5+1i)", 64, 1.5, 1.0, "")
  assert_eq format_complex(Complex.new(1.5, 1.0), "g", 2, 64), "(1.5+1i)"
  assert_eq format_complex(Complex.new(1.5, 1.0), "e", 2, 64), "(1.50e+00+1.00e+00i)"
  assert_eq format_complex(Complex.new(1.5, 1.0), "f", 2, 64), "(1.50+1.00i)"
  atoc_chk("1e309+1e-400i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+1e-400i\": value out of range")
  atoc_chk("1e309+1e-400i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+1e-400i\": value out of range")
  atoc_chk("0x1p-2", 128, 0.25, 0.0, "")
  assert_eq format_complex(Complex.new(0.25, 0.0), "g", -1, 128), "(0.25+0i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "e", 1, 128), "(2.5e-01+0.0e+00i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "f", 1, 128), "(0.2+0.0i)"
  atoc_chk("0x1p-2", 64, 0.25, 0.0, "")
  assert_eq format_complex(Complex.new(0.25, 0.0), "g", 2, 64), "(0.25+0i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "e", 4, 64), "(2.5000e-01+0.0000e+00i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "f", 3, 64), "(0.250+0.000i)"
  atoc_chk("-1e309+0i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e309+0i\": value out of range")
  atoc_chk("-1e309+0i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e309+0i\": value out of range")
  atoc_chk("-Inf+1i", 128, math.inf(-1), 1.0, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "g", 1, 128), "(-Inf+1i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "e", 2, 128), "(-Inf+1.00e+00i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "f", 4, 128), "(-Inf+1.0000i)"
  atoc_chk("-Inf+1i", 64, math.inf(-1), 1.0, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "g", 0, 64), "(-Inf+1i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "e", -1, 64), "(-Inf+1e+00i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "f", 0, 64), "(-Inf+1i)"
  atoc_chk("(1e-400+Infi)", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 0, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 4, 128), "(0.0000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 3, 128), "(0.000+Infi)"
  atoc_chk("(1e-400+Infi)", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 0, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 4, 64), "(0.0000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 3, 64), "(0.000+Infi)"
  atoc_chk("(0+-Infi)", 128, 0.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "g", 2, 128), "(0-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "e", 4, 128), "(0.0000e+00-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "f", 0, 128), "(0-Infi)"
  atoc_chk("(0+-Infi)", 64, 0.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "g", 2, 64), "(0-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "e", -1, 64), "(0e+00-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "f", 1, 64), "(0.0-Infi)"
  atoc_chk("-1-Infj", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1-Infj\": invalid syntax")
  atoc_chk("-1-Infj", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1-Infj\": invalid syntax")
  atoc_chk("1e-400+Infi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 2, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 2, 128), "(0.00e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", -1, 128), "(0+Infi)"
  atoc_chk("1e-400+Infi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 3, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 1, 64), "(0.0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 0, 64), "(0+Infi)"
  atoc_chk("1e-400+3.4028236e38i", 128, 0.0, 3.4028236e38, "")
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "g", 2, 128), "(0+3.4e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "e", 1, 128), "(0.0e+00+3.4e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "f", 0, 128), "(0+340282359999999991113723490719674400768i)"
  atoc_chk("1e-400+3.4028236e38i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e-400+3.4028236e38i\": value out of range")
  atoc_chk("0i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 4, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 128), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 2, 128), "(0.00+0.00i)"
}

test "complex 2" {
  atoc_chk("0i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 4, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 2, 64), "(0.00e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 1, 64), "(0.0+0.0i)"
  atoc_chk("1e309+0x1p-2i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+0x1p-2i\": value out of range")
  atoc_chk("1e309+0x1p-2i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+0x1p-2i\": value out of range")
  atoc_chk("+33.4028236e38j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+33.4028236e38j\": invalid syntax")
  atoc_chk("+33.4028236e38j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+33.4028236e38j\": invalid syntax")
  atoc_chk("Inf1e309j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"Inf1e309j\": invalid syntax")
  atoc_chk("Inf1e309j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"Inf1e309j\": invalid syntax")
  atoc_chk("1.50j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1.50j\": invalid syntax")
  atoc_chk("1.50j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1.50j\": invalid syntax")
  atoc_chk("-1", 128, (-1.0), 0.0, "")
  assert_eq format_complex(Complex.new((-1.0), 0.0), "g", 3, 128), "(-1+0i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "e", 2, 128), "(-1.00e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "f", -1, 128), "(-1+0i)"
  atoc_chk("-1", 64, (-1.0), 0.0, "")
  assert_eq format_complex(Complex.new((-1.0), 0.0), "g", 1, 64), "(-1+0i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "e", 1, 64), "(-1.0e+00+0.0e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "f", 0, 64), "(-1+0i)"
  atoc_chk("0x1p-2", 128, 0.25, 0.0, "")
  assert_eq format_complex(Complex.new(0.25, 0.0), "g", 0, 128), "(0.2+0i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "e", -1, 128), "(2.5e-01+0e+00i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "f", 3, 128), "(0.250+0.000i)"
  atoc_chk("0x1p-2", 64, 0.25, 0.0, "")
  assert_eq format_complex(Complex.new(0.25, 0.0), "g", 4, 64), "(0.25+0i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "e", 2, 64), "(2.50e-01+0.00e+00i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "f", 2, 64), "(0.25+0.00i)"
  atoc_chk("Infi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", -1, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 3, 128), "(0.000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 1, 128), "(0.0+Infi)"
  atoc_chk("Infi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 0, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 2, 64), "(0.00e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", -1, 64), "(0+Infi)"
  atoc_chk("0i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 2, 128), "(0.00e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 1, 128), "(0.0+0.0i)"
  atoc_chk("0i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 0, 64), "(0e+00+0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 2, 64), "(0.00+0.00i)"
  atoc_chk("1e309", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309\": value out of range")
  atoc_chk("1e309", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309\": value out of range")
  atoc_chk("infinity+3j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"infinity+3j\": invalid syntax")
  atoc_chk("infinity+3j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"infinity+3j\": invalid syntax")
  atoc_chk("infinity+3j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"infinity+3j\": invalid syntax")
  atoc_chk("infinity+3j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"infinity+3j\": invalid syntax")
  atoc_chk("0x1p-2i", 128, 0.0, 0.25, "")
  assert_eq format_complex(Complex.new(0.0, 0.25), "g", 1, 128), "(0+0.2i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "e", 2, 128), "(0.00e+00+2.50e-01i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "f", 0, 128), "(0+0i)"
  atoc_chk("0x1p-2i", 64, 0.0, 0.25, "")
  assert_eq format_complex(Complex.new(0.0, 0.25), "g", 3, 64), "(0+0.25i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "e", -1, 64), "(0e+00+2.5e-01i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "f", 3, 64), "(0.000+0.250i)"
  atoc_chk("+3infinityj", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+3infinityj\": invalid syntax")
  atoc_chk("+3infinityj", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+3infinityj\": invalid syntax")
  atoc_chk("-1i", 128, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 2, 128), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", 2, 128), "(0.00e+00-1.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", -1, 128), "(0-1i)"
  atoc_chk("-1i", 64, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 0, 64), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", 2, 64), "(0.00e+00-1.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", 4, 64), "(0.0000-1.0000i)"
  atoc_chk("(1.5+Infi)", 128, 1.5, math.inf(1), "")
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "g", 3, 128), "(1.5+Infi)"
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "e", 0, 128), "(2e+00+Infi)"
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "f", 0, 128), "(2+Infi)"
  atoc_chk("(1.5+Infi)", 64, 1.5, math.inf(1), "")
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "g", -1, 64), "(1.5+Infi)"
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "e", 0, 64), "(2e+00+Infi)"
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "f", 3, 64), "(1.500+Infi)"
  atoc_chk("(-1+-Infi)", 128, (-1.0), math.inf(-1), "")
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "g", 3, 128), "(-1-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "e", -1, 128), "(-1e+00-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "f", 0, 128), "(-1-Infi)"
  atoc_chk("(-1+-Infi)", 64, (-1.0), math.inf(-1), "")
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "g", 2, 64), "(-1-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "e", 0, 64), "(-1e+00-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "f", 2, 64), "(-1.00-Infi)"
  atoc_chk("Infi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", -1, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 4, 128), "(0.0000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 1, 128), "(0.0+Infi)"
  atoc_chk("Infi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 4, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 4, 64), "(0.0000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 3, 64), "(0.000+Infi)"
  atoc_chk("-2.5e-3+1e-400i", 128, (-0.0025), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "g", 2, 128), "(-0.0025+0i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "e", 4, 128), "(-2.5000e-03+0.0000e+00i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "f", -1, 128), "(-0.0025+0i)"
  atoc_chk("-2.5e-3+1e-400i", 64, (-0.0024999999441206455), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "g", 1, 64), "(-0.002+0i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "e", 1, 64), "(-2.5e-03+0.0e+00i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "f", 0, 64), "(-0+0i)"
}

test "complex 3" {
  atoc_chk("NaN-Infj", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN-Infj\": invalid syntax")
  atoc_chk("NaN-Infj", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN-Infj\": invalid syntax")
  atoc_chk("(0x1p-2+-2.5e-3i)", 128, 0.25, (-0.0025), "")
  assert_eq format_complex(Complex.new(0.25, (-0.0025)), "g", 0, 128), "(0.2-0.003i)"
  assert_eq format_complex(Complex.new(0.25, (-0.0025)), "e", 4, 128), "(2.5000e-01-2.5000e-03i)"
  assert_eq format_complex(Complex.new(0.25, (-0.0025)), "f", 2, 128), "(0.25-0.00i)"
  atoc_chk("(0x1p-2+-2.5e-3i)", 64, 0.25, (-0.0024999999441206455), "")
  assert_eq format_complex(Complex.new(0.25, (-0.0024999999441206455)), "g", 0, 64), "(0.2-0.002i)"
  assert_eq format_complex(Complex.new(0.25, (-0.0024999999441206455)), "e", 2, 64), "(2.50e-01-2.50e-03i)"
  assert_eq format_complex(Complex.new(0.25, (-0.0024999999441206455)), "f", 0, 64), "(0-0i)"
  atoc_chk("+3", 128, 3.0, 0.0, "")
  assert_eq format_complex(Complex.new(3.0, 0.0), "g", 2, 128), "(3+0i)"
  assert_eq format_complex(Complex.new(3.0, 0.0), "e", 2, 128), "(3.00e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new(3.0, 0.0), "f", 0, 128), "(3+0i)"
  atoc_chk("+3", 64, 3.0, 0.0, "")
  assert_eq format_complex(Complex.new(3.0, 0.0), "g", 3, 64), "(3+0i)"
  assert_eq format_complex(Complex.new(3.0, 0.0), "e", 4, 64), "(3.0000e+00+0.0000e+00i)"
  assert_eq format_complex(Complex.new(3.0, 0.0), "f", 4, 64), "(3.0000+0.0000i)"
  atoc_chk("(NaN+infinityi)", 128, math.nan(), math.inf(1), "")
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "g", 3, 128), "(NaN+Infi)"
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "e", 2, 128), "(NaN+Infi)"
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "f", 3, 128), "(NaN+Infi)"
  atoc_chk("(NaN+infinityi)", 64, math.nan(), math.inf(1), "")
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "g", 1, 64), "(NaN+Infi)"
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "e", 1, 64), "(NaN+Infi)"
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "f", 4, 64), "(NaN+Infi)"
  atoc_chk("1e-400i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 0, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", -1, 128), "(0e+00+0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 0, 128), "(0+0i)"
  atoc_chk("1e-400i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 4, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 4, 64), "(0.0000e+00+0.0000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 3, 64), "(0.000+0.000i)"
  atoc_chk("1i", 128, 0.0, 1.0, "")
  assert_eq format_complex(Complex.new(0.0, 1.0), "g", 1, 128), "(0+1i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "e", 0, 128), "(0e+00+1e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "f", 4, 128), "(0.0000+1.0000i)"
  atoc_chk("1i", 64, 0.0, 1.0, "")
  assert_eq format_complex(Complex.new(0.0, 1.0), "g", 3, 64), "(0+1i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "e", 0, 64), "(0e+00+1e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "f", 1, 64), "(0.0+1.0i)"
  atoc_chk("infinity-2.5e-3i", 128, math.inf(1), (-0.0025), "")
  assert_eq format_complex(Complex.new(math.inf(1), (-0.0025)), "g", 3, 128), "(+Inf-0.0025i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-0.0025)), "e", 3, 128), "(+Inf-2.500e-03i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-0.0025)), "f", 3, 128), "(+Inf-0.003i)"
  atoc_chk("infinity-2.5e-3i", 64, math.inf(1), (-0.0024999999441206455), "")
  assert_eq format_complex(Complex.new(math.inf(1), (-0.0024999999441206455)), "g", 0, 64), "(+Inf-0.002i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-0.0024999999441206455)), "e", 2, 64), "(+Inf-2.50e-03i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-0.0024999999441206455)), "f", 2, 64), "(+Inf-0.00i)"
  atoc_chk("1.5i", 128, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 1, 128), "(0+2i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", -1, 128), "(0e+00+1.5e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 1, 128), "(0.0+1.5i)"
  atoc_chk("1.5i", 64, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 1, 64), "(0+2i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 0, 64), "(0e+00+2e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", -1, 64), "(0+1.5i)"
  atoc_chk("0+infinityi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 0, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 4, 128), "(0.0000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 3, 128), "(0.000+Infi)"
  atoc_chk("0+infinityi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", -1, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 1, 64), "(0.0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 0, 64), "(0+Infi)"
  atoc_chk("-1e3091e-400j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e3091e-400j\": invalid syntax")
  atoc_chk("-1e3091e-400j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e3091e-400j\": invalid syntax")
  atoc_chk("1e-400", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 2, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 1, 128), "(0.0e+00+0.0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 1, 128), "(0.0+0.0i)"
  atoc_chk("1e-400", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 3, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 64), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 2, 64), "(0.00+0.00i)"
  atoc_chk("-1i", 128, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 1, 128), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", -1, 128), "(0e+00-1e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", 2, 128), "(0.00-1.00i)"
  atoc_chk("-1i", 64, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 0, 64), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", 2, 64), "(0.00e+00-1.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", 0, 64), "(0-1i)"
  atoc_chk("-1+1i", 128, (-1.0), 1.0, "")
  assert_eq format_complex(Complex.new((-1.0), 1.0), "g", 2, 128), "(-1+1i)"
  assert_eq format_complex(Complex.new((-1.0), 1.0), "e", 3, 128), "(-1.000e+00+1.000e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 1.0), "f", 2, 128), "(-1.00+1.00i)"
  atoc_chk("-1+1i", 64, (-1.0), 1.0, "")
  assert_eq format_complex(Complex.new((-1.0), 1.0), "g", 0, 64), "(-1+1i)"
  assert_eq format_complex(Complex.new((-1.0), 1.0), "e", 0, 64), "(-1e+00+1e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 1.0), "f", 4, 64), "(-1.0000+1.0000i)"
  atoc_chk("-1e309", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e309\": value out of range")
  atoc_chk("-1e309", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e309\": value out of range")
  atoc_chk("-1", 128, (-1.0), 0.0, "")
  assert_eq format_complex(Complex.new((-1.0), 0.0), "g", 0, 128), "(-1+0i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "e", -1, 128), "(-1e+00+0e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "f", 2, 128), "(-1.00+0.00i)"
  atoc_chk("-1", 64, (-1.0), 0.0, "")
  assert_eq format_complex(Complex.new((-1.0), 0.0), "g", 3, 64), "(-1+0i)"
}

test "complex 4" {
  assert_eq format_complex(Complex.new((-1.0), 0.0), "e", 2, 64), "(-1.00e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "f", 2, 64), "(-1.00+0.00i)"
  atoc_chk("(0++3i)", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(0++3i)\": invalid syntax")
  atoc_chk("(0++3i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(0++3i)\": invalid syntax")
  atoc_chk("infinity-2.5e-3j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"infinity-2.5e-3j\": invalid syntax")
  atoc_chk("infinity-2.5e-3j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"infinity-2.5e-3j\": invalid syntax")
  atoc_chk("Infi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 3, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", -1, 128), "(0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 0, 128), "(0+Infi)"
  atoc_chk("Infi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 4, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 4, 64), "(0.0000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 2, 64), "(0.00+Infi)"
  atoc_chk("-2.5e-3+infinityi", 128, (-0.0025), math.inf(1), "")
  assert_eq format_complex(Complex.new((-0.0025), math.inf(1)), "g", 3, 128), "(-0.0025+Infi)"
  assert_eq format_complex(Complex.new((-0.0025), math.inf(1)), "e", 2, 128), "(-2.50e-03+Infi)"
  assert_eq format_complex(Complex.new((-0.0025), math.inf(1)), "f", 3, 128), "(-0.003+Infi)"
  atoc_chk("-2.5e-3+infinityi", 64, (-0.0024999999441206455), math.inf(1), "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), math.inf(1)), "g", 0, 64), "(-0.002+Infi)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), math.inf(1)), "e", 2, 64), "(-2.50e-03+Infi)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), math.inf(1)), "f", -1, 64), "(-0.0025+Infi)"
  atoc_chk("NaNi", 128, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 2, 128), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", -1, 128), "(0e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 0, 128), "(0+NaNi)"
  atoc_chk("NaNi", 64, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", -1, 64), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 4, 64), "(0.0000e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 3, 64), "(0.000+NaNi)"
  atoc_chk("-1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e309i\": value out of range")
  atoc_chk("-1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e309i\": value out of range")
  atoc_chk("-2.5e-31j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-2.5e-31j\": invalid syntax")
  atoc_chk("-2.5e-31j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-2.5e-31j\": invalid syntax")
  atoc_chk("1i", 128, 0.0, 1.0, "")
  assert_eq format_complex(Complex.new(0.0, 1.0), "g", 2, 128), "(0+1i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "e", 0, 128), "(0e+00+1e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "f", 4, 128), "(0.0000+1.0000i)"
  atoc_chk("1i", 64, 0.0, 1.0, "")
  assert_eq format_complex(Complex.new(0.0, 1.0), "g", 4, 64), "(0+1i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "e", 3, 64), "(0.000e+00+1.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "f", 4, 64), "(0.0000+1.0000i)"
  atoc_chk("+33.4028236e38j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+33.4028236e38j\": invalid syntax")
  atoc_chk("+33.4028236e38j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+33.4028236e38j\": invalid syntax")
  atoc_chk("(1e-400+-2.5e-3i)", 128, 0.0, (-0.0025), "")
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "g", -1, 128), "(0-0.0025i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "e", 4, 128), "(0.0000e+00-2.5000e-03i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "f", 4, 128), "(0.0000-0.0025i)"
  atoc_chk("(1e-400+-2.5e-3i)", 64, 0.0, (-0.0024999999441206455), "")
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "g", 3, 64), "(0-0.0025i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "e", 4, 64), "(0.0000e+00-2.5000e-03i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "f", 3, 64), "(0.000-0.002i)"
  atoc_chk("-2.5e-3", 128, (-0.0025), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "g", -1, 128), "(-0.0025+0i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "e", 2, 128), "(-2.50e-03+0.00e+00i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "f", 3, 128), "(-0.003+0.000i)"
  atoc_chk("-2.5e-3", 64, (-0.0024999999441206455), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "g", 4, 64), "(-0.0025+0i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "e", -1, 64), "(-2.5e-03+0e+00i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "f", 0, 64), "(-0+0i)"
  atoc_chk("1.5", 128, 1.5, 0.0, "")
  assert_eq format_complex(Complex.new(1.5, 0.0), "g", 1, 128), "(2+0i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "e", 1, 128), "(1.5e+00+0.0e+00i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "f", 1, 128), "(1.5+0.0i)"
  atoc_chk("1.5", 64, 1.5, 0.0, "")
  assert_eq format_complex(Complex.new(1.5, 0.0), "g", 2, 64), "(1.5+0i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "e", 4, 64), "(1.5000e+00+0.0000e+00i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "f", 1, 64), "(1.5+0.0i)"
  atoc_chk("-1+1.5i", 128, (-1.0), 1.5, "")
  assert_eq format_complex(Complex.new((-1.0), 1.5), "g", 4, 128), "(-1+1.5i)"
  assert_eq format_complex(Complex.new((-1.0), 1.5), "e", 4, 128), "(-1.0000e+00+1.5000e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 1.5), "f", 4, 128), "(-1.0000+1.5000i)"
  atoc_chk("-1+1.5i", 64, (-1.0), 1.5, "")
  assert_eq format_complex(Complex.new((-1.0), 1.5), "g", -1, 64), "(-1+1.5i)"
  assert_eq format_complex(Complex.new((-1.0), 1.5), "e", 4, 64), "(-1.0000e+00+1.5000e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 1.5), "f", -1, 64), "(-1+1.5i)"
  atoc_chk("NaN-1e309j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN-1e309j\": invalid syntax")
  atoc_chk("NaN-1e309j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN-1e309j\": invalid syntax")
  atoc_chk("(infinity+Infi)", 128, math.inf(1), math.inf(1), "")
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "g", 3, 128), "(+Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "e", 0, 128), "(+Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "f", -1, 128), "(+Inf+Infi)"
  atoc_chk("(infinity+Infi)", 64, math.inf(1), math.inf(1), "")
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "g", -1, 64), "(+Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "e", -1, 64), "(+Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "f", 0, 64), "(+Inf+Infi)"
  atoc_chk("-1+1i", 128, (-1.0), 1.0, "")
  assert_eq format_complex(Complex.new((-1.0), 1.0), "g", 3, 128), "(-1+1i)"
  assert_eq format_complex(Complex.new((-1.0), 1.0), "e", 1, 128), "(-1.0e+00+1.0e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 1.0), "f", 2, 128), "(-1.00+1.00i)"
  atoc_chk("-1+1i", 64, (-1.0), 1.0, "")
  assert_eq format_complex(Complex.new((-1.0), 1.0), "g", 2, 64), "(-1+1i)"
  assert_eq format_complex(Complex.new((-1.0), 1.0), "e", 1, 64), "(-1.0e+00+1.0e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 1.0), "f", 3, 64), "(-1.000+1.000i)"
  atoc_chk("1.5", 128, 1.5, 0.0, "")
  assert_eq format_complex(Complex.new(1.5, 0.0), "g", 3, 128), "(1.5+0i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "e", 0, 128), "(2e+00+0e+00i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "f", 1, 128), "(1.5+0.0i)"
  atoc_chk("1.5", 64, 1.5, 0.0, "")
  assert_eq format_complex(Complex.new(1.5, 0.0), "g", 4, 64), "(1.5+0i)"
}

test "complex 5" {
  assert_eq format_complex(Complex.new(1.5, 0.0), "e", 2, 64), "(1.50e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "f", 4, 64), "(1.5000+0.0000i)"
  atoc_chk("1e-400-1j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e-400-1j\": invalid syntax")
  atoc_chk("1e-400-1j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e-400-1j\": invalid syntax")
  atoc_chk("-11e-400j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-11e-400j\": invalid syntax")
  atoc_chk("-11e-400j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-11e-400j\": invalid syntax")
  atoc_chk("infinity", 128, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 1, 128), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 3, 128), "(+Inf+0.000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 4, 128), "(+Inf+0.0000i)"
  atoc_chk("infinity", 64, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 3, 64), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 4, 64), "(+Inf+0.0000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", -1, 64), "(+Inf+0i)"
  atoc_chk("Infi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 1, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 2, 128), "(0.00e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 2, 128), "(0.00+Infi)"
  atoc_chk("Infi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", -1, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", -1, 64), "(0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", -1, 64), "(0+Infi)"
  atoc_chk("(-Inf+1i)", 128, math.inf(-1), 1.0, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "g", 4, 128), "(-Inf+1i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "e", 0, 128), "(-Inf+1e+00i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "f", -1, 128), "(-Inf+1i)"
  atoc_chk("(-Inf+1i)", 64, math.inf(-1), 1.0, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "g", -1, 64), "(-Inf+1i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "e", 3, 64), "(-Inf+1.000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 1.0), "f", 0, 64), "(-Inf+1i)"
  atoc_chk("NaNi", 128, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 1, 128), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 0, 128), "(0e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", -1, 128), "(0+NaNi)"
  atoc_chk("NaNi", 64, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", -1, 64), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", -1, 64), "(0e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 0, 64), "(0+NaNi)"
  atoc_chk("1e-400i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 2, 128), "(0.00e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", -1, 128), "(0+0i)"
  atoc_chk("1e-400i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 64), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 3, 64), "(0.000+0.000i)"
  atoc_chk("3.4028236e38i", 128, 0.0, 3.4028236e38, "")
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "g", -1, 128), "(0+3.4028236e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "e", 1, 128), "(0.0e+00+3.4e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "f", 4, 128), "(0.0000+340282359999999991113723490719674400768.0000i)"
  atoc_chk("3.4028236e38i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38i\": value out of range")
  atoc_chk("(0+0i)", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 4, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 0, 128), "(0e+00+0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", -1, 128), "(0+0i)"
  atoc_chk("(0+0i)", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 1, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 64), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 1, 64), "(0.0+0.0i)"
  atoc_chk("(1+-Infi)", 128, 1.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(1.0, math.inf(-1)), "g", 2, 128), "(1-Infi)"
  assert_eq format_complex(Complex.new(1.0, math.inf(-1)), "e", -1, 128), "(1e+00-Infi)"
  assert_eq format_complex(Complex.new(1.0, math.inf(-1)), "f", 1, 128), "(1.0-Infi)"
  atoc_chk("(1+-Infi)", 64, 1.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(1.0, math.inf(-1)), "g", 1, 64), "(1-Infi)"
  assert_eq format_complex(Complex.new(1.0, math.inf(-1)), "e", 0, 64), "(1e+00-Infi)"
  assert_eq format_complex(Complex.new(1.0, math.inf(-1)), "f", 3, 64), "(1.000-Infi)"
  atoc_chk("NaNi", 128, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 4, 128), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 2, 128), "(0.00e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 2, 128), "(0.00+NaNi)"
  atoc_chk("NaNi", 64, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 4, 64), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 4, 64), "(0.0000e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 1, 64), "(0.0+NaNi)"
  atoc_chk("-Inf-1j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-Inf-1j\": invalid syntax")
  atoc_chk("-Inf-1j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-Inf-1j\": invalid syntax")
  atoc_chk("infinity+0i", 128, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 0, 128), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 4, 128), "(+Inf+0.0000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 0, 128), "(+Inf+0i)"
  atoc_chk("infinity+0i", 64, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", -1, 64), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 3, 64), "(+Inf+0.000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 3, 64), "(+Inf+0.000i)"
  atoc_chk("-2.5e-3", 128, (-0.0025), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "g", 1, 128), "(-0.003+0i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "e", -1, 128), "(-2.5e-03+0e+00i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "f", 4, 128), "(-0.0025+0.0000i)"
  atoc_chk("-2.5e-3", 64, (-0.0024999999441206455), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "g", -1, 64), "(-0.0025+0i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "e", 2, 64), "(-2.50e-03+0.00e+00i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "f", 4, 64), "(-0.0025+0.0000i)"
  atoc_chk("0x1p-2i", 128, 0.0, 0.25, "")
  assert_eq format_complex(Complex.new(0.0, 0.25), "g", 3, 128), "(0+0.25i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "e", -1, 128), "(0e+00+2.5e-01i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "f", 4, 128), "(0.0000+0.2500i)"
  atoc_chk("0x1p-2i", 64, 0.0, 0.25, "")
  assert_eq format_complex(Complex.new(0.0, 0.25), "g", 2, 64), "(0+0.25i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "e", 1, 64), "(0.0e+00+2.5e-01i)"
}

test "complex 6" {
  assert_eq format_complex(Complex.new(0.0, 0.25), "f", 1, 64), "(0.0+0.2i)"
  atoc_chk("(1+1e309i)", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(1+1e309i)\": value out of range")
  atoc_chk("(1+1e309i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(1+1e309i)\": value out of range")
  atoc_chk("-Inf+0i", 128, math.inf(-1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "g", -1, 128), "(-Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "e", 4, 128), "(-Inf+0.0000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "f", 2, 128), "(-Inf+0.00i)"
  atoc_chk("-Inf+0i", 64, math.inf(-1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "g", 2, 64), "(-Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "e", 4, 64), "(-Inf+0.0000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 0.0), "f", 3, 64), "(-Inf+0.000i)"
  atoc_chk("1.5-1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1.5-1e309i\": value out of range")
  atoc_chk("1.5-1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1.5-1e309i\": value out of range")
  atoc_chk("infinity-Infi", 128, math.inf(1), math.inf(-1), "")
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(-1)), "g", -1, 128), "(+Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(-1)), "e", 0, 128), "(+Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(-1)), "f", 3, 128), "(+Inf-Infi)"
  atoc_chk("infinity-Infi", 64, math.inf(1), math.inf(-1), "")
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(-1)), "g", 1, 64), "(+Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(-1)), "e", 0, 64), "(+Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(-1)), "f", 0, 64), "(+Inf-Infi)"
  atoc_chk("infinity+0i", 128, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", -1, 128), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 0, 128), "(+Inf+0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 3, 128), "(+Inf+0.000i)"
  atoc_chk("infinity+0i", 64, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", -1, 64), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", -1, 64), "(+Inf+0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 1, 64), "(+Inf+0.0i)"
  atoc_chk("NaN-Infj", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN-Infj\": invalid syntax")
  atoc_chk("NaN-Infj", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN-Infj\": invalid syntax")
  atoc_chk("(1.5+0i)", 128, 1.5, 0.0, "")
  assert_eq format_complex(Complex.new(1.5, 0.0), "g", 2, 128), "(1.5+0i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "e", 4, 128), "(1.5000e+00+0.0000e+00i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "f", -1, 128), "(1.5+0i)"
  atoc_chk("(1.5+0i)", 64, 1.5, 0.0, "")
  assert_eq format_complex(Complex.new(1.5, 0.0), "g", 4, 64), "(1.5+0i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "e", -1, 64), "(1.5e+00+0e+00i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "f", 2, 64), "(1.50+0.00i)"
  atoc_chk("(-2.5e-3+Infi)", 128, (-0.0025), math.inf(1), "")
  assert_eq format_complex(Complex.new((-0.0025), math.inf(1)), "g", -1, 128), "(-0.0025+Infi)"
  assert_eq format_complex(Complex.new((-0.0025), math.inf(1)), "e", -1, 128), "(-2.5e-03+Infi)"
  assert_eq format_complex(Complex.new((-0.0025), math.inf(1)), "f", 2, 128), "(-0.00+Infi)"
  atoc_chk("(-2.5e-3+Infi)", 64, (-0.0024999999441206455), math.inf(1), "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), math.inf(1)), "g", 1, 64), "(-0.002+Infi)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), math.inf(1)), "e", 3, 64), "(-2.500e-03+Infi)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), math.inf(1)), "f", 3, 64), "(-0.002+Infi)"
  atoc_chk("(1e-400+NaNi)", 128, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", -1, 128), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", -1, 128), "(0e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", -1, 128), "(0+NaNi)"
  atoc_chk("(1e-400+NaNi)", 64, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 2, 64), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 1, 64), "(0.0e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", -1, 64), "(0+NaNi)"
  atoc_chk("3.4028236e38+1.5i", 128, 3.4028236e38, 1.5, "")
  assert_eq format_complex(Complex.new(3.4028236e38, 1.5), "g", 0, 128), "(3e+38+2i)"
  assert_eq format_complex(Complex.new(3.4028236e38, 1.5), "e", 4, 128), "(3.4028e+38+1.5000e+00i)"
  assert_eq format_complex(Complex.new(3.4028236e38, 1.5), "f", -1, 128), "(340282360000000000000000000000000000000+1.5i)"
  atoc_chk("3.4028236e38+1.5i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38+1.5i\": value out of range")
  atoc_chk("(0+1.5i)", 128, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 2, 128), "(0+1.5i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 0, 128), "(0e+00+2e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 0, 128), "(0+2i)"
  atoc_chk("(0+1.5i)", 64, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 0, 64), "(0+2i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 4, 64), "(0.0000e+00+1.5000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 0, 64), "(0+2i)"
  atoc_chk("(3.4028236e38+-2.5e-3i)", 128, 3.4028236e38, (-0.0025), "")
  assert_eq format_complex(Complex.new(3.4028236e38, (-0.0025)), "g", 3, 128), "(3.4e+38-0.0025i)"
  assert_eq format_complex(Complex.new(3.4028236e38, (-0.0025)), "e", 1, 128), "(3.4e+38-2.5e-03i)"
  assert_eq format_complex(Complex.new(3.4028236e38, (-0.0025)), "f", 1, 128), "(340282359999999991113723490719674400768.0-0.0i)"
  atoc_chk("(3.4028236e38+-2.5e-3i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(3.4028236e38+-2.5e-3i)\": value out of range")
  atoc_chk("-2.5e-3", 128, (-0.0025), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "g", 3, 128), "(-0.0025+0i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "e", 3, 128), "(-2.500e-03+0.000e+00i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "f", 2, 128), "(-0.00+0.00i)"
  atoc_chk("-2.5e-3", 64, (-0.0024999999441206455), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "g", -1, 64), "(-0.0025+0i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "e", 0, 64), "(-2e-03+0e+00i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "f", -1, 64), "(-0.0025+0i)"
  atoc_chk("Infi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", -1, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 3, 128), "(0.000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", -1, 128), "(0+Infi)"
  atoc_chk("Infi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 2, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", -1, 64), "(0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 4, 64), "(0.0000+Infi)"
  atoc_chk("-1i", 128, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 4, 128), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", 4, 128), "(0.0000e+00-1.0000e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", 3, 128), "(0.000-1.000i)"
  atoc_chk("-1i", 64, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 3, 64), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", 0, 64), "(0e+00-1e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", 2, 64), "(0.00-1.00i)"
  atoc_chk("1.5i", 128, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 3, 128), "(0+1.5i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", -1, 128), "(0e+00+1.5e+00i)"
}

test "complex 7" {
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 1, 128), "(0.0+1.5i)"
  atoc_chk("1.5i", 64, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 2, 64), "(0+1.5i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 1, 64), "(0.0e+00+1.5e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 2, 64), "(0.00+1.50i)"
  atoc_chk("1e-400i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 1, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 1, 128), "(0.0e+00+0.0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 2, 128), "(0.00+0.00i)"
  atoc_chk("1e-400i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 0, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 0, 64), "(0e+00+0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 0, 64), "(0+0i)"
  atoc_chk("(-Inf+-Infi)", 128, math.inf(-1), math.inf(-1), "")
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "g", 0, 128), "(-Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "e", 2, 128), "(-Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "f", 2, 128), "(-Inf-Infi)"
  atoc_chk("(-Inf+-Infi)", 64, math.inf(-1), math.inf(-1), "")
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "g", 4, 64), "(-Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "e", 0, 64), "(-Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "f", 4, 64), "(-Inf-Infi)"
  atoc_chk("NaNi", 128, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 4, 128), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 4, 128), "(0.0000e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 2, 128), "(0.00+NaNi)"
  atoc_chk("NaNi", 64, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 3, 64), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 4, 64), "(0.0000e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 0, 64), "(0+NaNi)"
  atoc_chk("+3-1e309j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+3-1e309j\": invalid syntax")
  atoc_chk("+3-1e309j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+3-1e309j\": invalid syntax")
  atoc_chk("0", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 2, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 128), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 0, 128), "(0+0i)"
  atoc_chk("0", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 2, 64), "(0.00e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 1, 64), "(0.0+0.0i)"
  atoc_chk("-1-2.5e-3i", 128, (-1.0), (-0.0025), "")
  assert_eq format_complex(Complex.new((-1.0), (-0.0025)), "g", 2, 128), "(-1-0.0025i)"
  assert_eq format_complex(Complex.new((-1.0), (-0.0025)), "e", 4, 128), "(-1.0000e+00-2.5000e-03i)"
  assert_eq format_complex(Complex.new((-1.0), (-0.0025)), "f", 1, 128), "(-1.0-0.0i)"
  atoc_chk("-1-2.5e-3i", 64, (-1.0), (-0.0024999999441206455), "")
  assert_eq format_complex(Complex.new((-1.0), (-0.0024999999441206455)), "g", 3, 64), "(-1-0.0025i)"
  assert_eq format_complex(Complex.new((-1.0), (-0.0024999999441206455)), "e", -1, 64), "(-1e+00-2.5e-03i)"
  assert_eq format_complex(Complex.new((-1.0), (-0.0024999999441206455)), "f", 4, 64), "(-1.0000-0.0025i)"
  atoc_chk("1e309+1.5i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+1.5i\": value out of range")
  atoc_chk("1e309+1.5i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+1.5i\": value out of range")
  atoc_chk("(+3+1e309i)", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(+3+1e309i)\": value out of range")
  atoc_chk("(+3+1e309i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(+3+1e309i)\": value out of range")
  atoc_chk("-Infi", 128, 0.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "g", 1, 128), "(0-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "e", 2, 128), "(0.00e+00-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "f", -1, 128), "(0-Infi)"
  atoc_chk("-Infi", 64, 0.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "g", 1, 64), "(0-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "e", 0, 64), "(0e+00-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "f", 0, 64), "(0-Infi)"
  atoc_chk("3.4028236e38i", 128, 0.0, 3.4028236e38, "")
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "g", 1, 128), "(0+3e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "e", 0, 128), "(0e+00+3e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "f", 3, 128), "(0.000+340282359999999991113723490719674400768.000i)"
  atoc_chk("3.4028236e38i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38i\": value out of range")
  atoc_chk("0-2.5e-3i", 128, 0.0, (-0.0025), "")
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "g", 0, 128), "(0-0.003i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "e", 4, 128), "(0.0000e+00-2.5000e-03i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "f", 0, 128), "(0-0i)"
  atoc_chk("0-2.5e-3i", 64, 0.0, (-0.0024999999441206455), "")
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "g", 0, 64), "(0-0.002i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "e", 2, 64), "(0.00e+00-2.50e-03i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "f", 0, 64), "(0-0i)"
  atoc_chk("-1-2.5e-3j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1-2.5e-3j\": invalid syntax")
  atoc_chk("-1-2.5e-3j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1-2.5e-3j\": invalid syntax")
  atoc_chk("+3i", 128, 0.0, 3.0, "")
  assert_eq format_complex(Complex.new(0.0, 3.0), "g", 0, 128), "(0+3i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "e", -1, 128), "(0e+00+3e+00i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "f", 3, 128), "(0.000+3.000i)"
  atoc_chk("+3i", 64, 0.0, 3.0, "")
  assert_eq format_complex(Complex.new(0.0, 3.0), "g", 4, 64), "(0+3i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "e", -1, 64), "(0e+00+3e+00i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "f", 3, 64), "(0.000+3.000i)"
  atoc_chk("1e309+0x1p-2i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+0x1p-2i\": value out of range")
  atoc_chk("1e309+0x1p-2i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+0x1p-2i\": value out of range")
  atoc_chk("0i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 1, 128), "(0.0e+00+0.0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 1, 128), "(0.0+0.0i)"
  atoc_chk("0i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", -1, 64), "(0e+00+0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 0, 64), "(0+0i)"
  atoc_chk("1e-400", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 3, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 1, 128), "(0.0e+00+0.0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", -1, 128), "(0+0i)"
  atoc_chk("1e-400", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 2, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 64), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 0, 64), "(0+0i)"
}

test "complex 8" {
  atoc_chk("+33.4028236e38j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+33.4028236e38j\": invalid syntax")
  atoc_chk("+33.4028236e38j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+33.4028236e38j\": invalid syntax")
  atoc_chk("0", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 128), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 2, 128), "(0.00+0.00i)"
  atoc_chk("0", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 0, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 2, 64), "(0.00e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 3, 64), "(0.000+0.000i)"
  atoc_chk("-1-Infi", 128, (-1.0), math.inf(-1), "")
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "g", 2, 128), "(-1-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "e", 2, 128), "(-1.00e+00-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "f", -1, 128), "(-1-Infi)"
  atoc_chk("-1-Infi", 64, (-1.0), math.inf(-1), "")
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "g", 4, 64), "(-1-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "e", 3, 64), "(-1.000e+00-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "f", 2, 64), "(-1.00-Infi)"
  atoc_chk("3.4028236e38NaNj", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38NaNj\": invalid syntax")
  atoc_chk("3.4028236e38NaNj", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38NaNj\": invalid syntax")
  atoc_chk("-1", 128, (-1.0), 0.0, "")
  assert_eq format_complex(Complex.new((-1.0), 0.0), "g", 0, 128), "(-1+0i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "e", 3, 128), "(-1.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "f", -1, 128), "(-1+0i)"
  atoc_chk("-1", 64, (-1.0), 0.0, "")
  assert_eq format_complex(Complex.new((-1.0), 0.0), "g", -1, 64), "(-1+0i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "e", 3, 64), "(-1.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "f", 3, 64), "(-1.000+0.000i)"
  atoc_chk("(1+0i)", 128, 1.0, 0.0, "")
  assert_eq format_complex(Complex.new(1.0, 0.0), "g", -1, 128), "(1+0i)"
  assert_eq format_complex(Complex.new(1.0, 0.0), "e", 4, 128), "(1.0000e+00+0.0000e+00i)"
  assert_eq format_complex(Complex.new(1.0, 0.0), "f", 2, 128), "(1.00+0.00i)"
  atoc_chk("(1+0i)", 64, 1.0, 0.0, "")
  assert_eq format_complex(Complex.new(1.0, 0.0), "g", 4, 64), "(1+0i)"
  assert_eq format_complex(Complex.new(1.0, 0.0), "e", 3, 64), "(1.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(1.0, 0.0), "f", 0, 64), "(1+0i)"
  atoc_chk("NaNi", 128, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 4, 128), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 2, 128), "(0.00e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 4, 128), "(0.0000+NaNi)"
  atoc_chk("NaNi", 64, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", -1, 64), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 3, 64), "(0.000e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 3, 64), "(0.000+NaNi)"
  atoc_chk("1NaNj", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1NaNj\": invalid syntax")
  atoc_chk("1NaNj", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1NaNj\": invalid syntax")
  atoc_chk("(+3+0i)", 128, 3.0, 0.0, "")
  assert_eq format_complex(Complex.new(3.0, 0.0), "g", 2, 128), "(3+0i)"
  assert_eq format_complex(Complex.new(3.0, 0.0), "e", 3, 128), "(3.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(3.0, 0.0), "f", 3, 128), "(3.000+0.000i)"
  atoc_chk("(+3+0i)", 64, 3.0, 0.0, "")
  assert_eq format_complex(Complex.new(3.0, 0.0), "g", 3, 64), "(3+0i)"
  assert_eq format_complex(Complex.new(3.0, 0.0), "e", -1, 64), "(3e+00+0e+00i)"
  assert_eq format_complex(Complex.new(3.0, 0.0), "f", 3, 64), "(3.000+0.000i)"
  atoc_chk("+3i", 128, 0.0, 3.0, "")
  assert_eq format_complex(Complex.new(0.0, 3.0), "g", -1, 128), "(0+3i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "e", 1, 128), "(0.0e+00+3.0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "f", -1, 128), "(0+3i)"
  atoc_chk("+3i", 64, 0.0, 3.0, "")
  assert_eq format_complex(Complex.new(0.0, 3.0), "g", 4, 64), "(0+3i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "e", 1, 64), "(0.0e+00+3.0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "f", 2, 64), "(0.00+3.00i)"
  atoc_chk("(3.4028236e38+infinityi)", 128, 3.4028236e38, math.inf(1), "")
  assert_eq format_complex(Complex.new(3.4028236e38, math.inf(1)), "g", -1, 128), "(3.4028236e+38+Infi)"
  assert_eq format_complex(Complex.new(3.4028236e38, math.inf(1)), "e", -1, 128), "(3.4028236e+38+Infi)"
  assert_eq format_complex(Complex.new(3.4028236e38, math.inf(1)), "f", 2, 128), "(340282359999999991113723490719674400768.00+Infi)"
  atoc_chk("(3.4028236e38+infinityi)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(3.4028236e38+infinityi)\": value out of range")
  atoc_chk("NaN1e309j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN1e309j\": invalid syntax")
  atoc_chk("NaN1e309j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN1e309j\": invalid syntax")
  atoc_chk("-Inf3.4028236e38j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-Inf3.4028236e38j\": invalid syntax")
  atoc_chk("-Inf3.4028236e38j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-Inf3.4028236e38j\": invalid syntax")
  atoc_chk("0", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 1, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 1, 128), "(0.0e+00+0.0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 2, 128), "(0.00+0.00i)"
  atoc_chk("0", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 0, 64), "(0e+00+0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 3, 64), "(0.000+0.000i)"
  atoc_chk("(-Inf+-1e309i)", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(-Inf+-1e309i)\": value out of range")
  atoc_chk("(-Inf+-1e309i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(-Inf+-1e309i)\": value out of range")
  atoc_chk("0+3.4028236e38i", 128, 0.0, 3.4028236e38, "")
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "g", 4, 128), "(0+3.403e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "e", 3, 128), "(0.000e+00+3.403e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "f", 2, 128), "(0.00+340282359999999991113723490719674400768.00i)"
  atoc_chk("0+3.4028236e38i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"0+3.4028236e38i\": value out of range")
  atoc_chk("-1e3090j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e3090j\": invalid syntax")
  atoc_chk("-1e3090j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e3090j\": invalid syntax")
  atoc_chk("-10j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-10j\": invalid syntax")
  atoc_chk("-10j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-10j\": invalid syntax")
  atoc_chk("3.4028236e38+1e-400i", 128, 3.4028236e38, 0.0, "")
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "g", -1, 128), "(3.4028236e+38+0i)"
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "e", 3, 128), "(3.403e+38+0.000e+00i)"
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "f", 2, 128), "(340282359999999991113723490719674400768.00+0.00i)"
  atoc_chk("3.4028236e38+1e-400i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38+1e-400i\": value out of range")
  atoc_chk("(-Inf+3.4028236e38i)", 128, math.inf(-1), 3.4028236e38, "")
  assert_eq format_complex(Complex.new(math.inf(-1), 3.4028236e38), "g", 0, 128), "(-Inf+3e+38i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 3.4028236e38), "e", 0, 128), "(-Inf+3e+38i)"
  assert_eq format_complex(Complex.new(math.inf(-1), 3.4028236e38), "f", 0, 128), "(-Inf+340282359999999991113723490719674400768i)"
  atoc_chk("(-Inf+3.4028236e38i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(-Inf+3.4028236e38i)\": value out of range")
}

test "complex 9" {
  atoc_chk("+3+1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+3+1e309i\": value out of range")
  atoc_chk("+3+1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+3+1e309i\": value out of range")
  atoc_chk("0i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 1, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", -1, 128), "(0e+00+0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", -1, 128), "(0+0i)"
  atoc_chk("0i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 4, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 64), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 2, 64), "(0.00+0.00i)"
  atoc_chk("3.4028236e38i", 128, 0.0, 3.4028236e38, "")
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "g", 1, 128), "(0+3e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "e", 2, 128), "(0.00e+00+3.40e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "f", 0, 128), "(0+340282359999999991113723490719674400768i)"
  atoc_chk("3.4028236e38i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38i\": value out of range")
  atoc_chk("1e-400", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 0, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 128), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 2, 128), "(0.00+0.00i)"
  atoc_chk("1e-400", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 0, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 64), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 4, 64), "(0.0000+0.0000i)"
  atoc_chk("-2.5e-3+1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-2.5e-3+1e309i\": value out of range")
  atoc_chk("-2.5e-3+1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-2.5e-3+1e309i\": value out of range")
  atoc_chk("(0x1p-2+-1e309i)", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(0x1p-2+-1e309i)\": value out of range")
  atoc_chk("(0x1p-2+-1e309i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(0x1p-2+-1e309i)\": value out of range")
  atoc_chk("0", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 2, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 128), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", -1, 128), "(0+0i)"
  atoc_chk("0", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 0, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 2, 64), "(0.00e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 0, 64), "(0+0i)"
  atoc_chk("1e-400", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 3, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 128), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 3, 128), "(0.000+0.000i)"
  atoc_chk("1e-400", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 4, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 4, 64), "(0.0000e+00+0.0000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 2, 64), "(0.00+0.00i)"
  atoc_chk("1e309", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309\": value out of range")
  atoc_chk("1e309", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309\": value out of range")
  atoc_chk("-2.5e-3+Infi", 128, (-0.0025), math.inf(1), "")
  assert_eq format_complex(Complex.new((-0.0025), math.inf(1)), "g", 1, 128), "(-0.003+Infi)"
  assert_eq format_complex(Complex.new((-0.0025), math.inf(1)), "e", -1, 128), "(-2.5e-03+Infi)"
  assert_eq format_complex(Complex.new((-0.0025), math.inf(1)), "f", 4, 128), "(-0.0025+Infi)"
  atoc_chk("-2.5e-3+Infi", 64, (-0.0024999999441206455), math.inf(1), "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), math.inf(1)), "g", 0, 64), "(-0.002+Infi)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), math.inf(1)), "e", 0, 64), "(-2e-03+Infi)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), math.inf(1)), "f", 1, 64), "(-0.0+Infi)"
  atoc_chk("1i", 128, 0.0, 1.0, "")
  assert_eq format_complex(Complex.new(0.0, 1.0), "g", 4, 128), "(0+1i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "e", 0, 128), "(0e+00+1e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "f", 0, 128), "(0+1i)"
  atoc_chk("1i", 64, 0.0, 1.0, "")
  assert_eq format_complex(Complex.new(0.0, 1.0), "g", -1, 64), "(0+1i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "e", 3, 64), "(0.000e+00+1.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "f", 1, 64), "(0.0+1.0i)"
  atoc_chk("1.5", 128, 1.5, 0.0, "")
  assert_eq format_complex(Complex.new(1.5, 0.0), "g", -1, 128), "(1.5+0i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "e", 0, 128), "(2e+00+0e+00i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "f", 4, 128), "(1.5000+0.0000i)"
  atoc_chk("1.5", 64, 1.5, 0.0, "")
  assert_eq format_complex(Complex.new(1.5, 0.0), "g", 1, 64), "(2+0i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "e", 2, 64), "(1.50e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new(1.5, 0.0), "f", -1, 64), "(1.5+0i)"
  atoc_chk("NaNi", 128, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 1, 128), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 3, 128), "(0.000e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 0, 128), "(0+NaNi)"
  atoc_chk("NaNi", 64, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 3, 64), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 0, 64), "(0e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 0, 64), "(0+NaNi)"
  atoc_chk("-2.5e-3i", 128, 0.0, (-0.0025), "")
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "g", 0, 128), "(0-0.003i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "e", 0, 128), "(0e+00-3e-03i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "f", -1, 128), "(0-0.0025i)"
  atoc_chk("-2.5e-3i", 64, 0.0, (-0.0024999999441206455), "")
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "g", 4, 64), "(0-0.0025i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "e", -1, 64), "(0e+00-2.5e-03i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "f", 0, 64), "(0-0i)"
  atoc_chk("NaN+1i", 128, math.nan(), 1.0, "")
  assert_eq format_complex(Complex.new(math.nan(), 1.0), "g", 2, 128), "(NaN+1i)"
  assert_eq format_complex(Complex.new(math.nan(), 1.0), "e", 3, 128), "(NaN+1.000e+00i)"
  assert_eq format_complex(Complex.new(math.nan(), 1.0), "f", 1, 128), "(NaN+1.0i)"
  atoc_chk("NaN+1i", 64, math.nan(), 1.0, "")
  assert_eq format_complex(Complex.new(math.nan(), 1.0), "g", 2, 64), "(NaN+1i)"
  assert_eq format_complex(Complex.new(math.nan(), 1.0), "e", 2, 64), "(NaN+1.00e+00i)"
  assert_eq format_complex(Complex.new(math.nan(), 1.0), "f", -1, 64), "(NaN+1i)"
  atoc_chk("Infi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 0, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", -1, 128), "(0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 2, 128), "(0.00+Infi)"
  atoc_chk("Infi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", -1, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 1, 64), "(0.0e+00+Infi)"
}

test "complex 10" {
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 3, 64), "(0.000+Infi)"
  atoc_chk("1e-4000j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e-4000j\": invalid syntax")
  atoc_chk("1e-4000j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e-4000j\": invalid syntax")
  atoc_chk("01e309j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"01e309j\": invalid syntax")
  atoc_chk("01e309j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"01e309j\": invalid syntax")
  atoc_chk("(0+-2.5e-3i)", 128, 0.0, (-0.0025), "")
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "g", 0, 128), "(0-0.003i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "e", 1, 128), "(0.0e+00-2.5e-03i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0025)), "f", 4, 128), "(0.0000-0.0025i)"
  atoc_chk("(0+-2.5e-3i)", 64, 0.0, (-0.0024999999441206455), "")
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "g", 0, 64), "(0-0.002i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "e", 3, 64), "(0.000e+00-2.500e-03i)"
  assert_eq format_complex(Complex.new(0.0, (-0.0024999999441206455)), "f", 4, 64), "(0.0000-0.0025i)"
  atoc_chk("0x1p-2", 128, 0.25, 0.0, "")
  assert_eq format_complex(Complex.new(0.25, 0.0), "g", 0, 128), "(0.2+0i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "e", -1, 128), "(2.5e-01+0e+00i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "f", -1, 128), "(0.25+0i)"
  atoc_chk("0x1p-2", 64, 0.25, 0.0, "")
  assert_eq format_complex(Complex.new(0.25, 0.0), "g", 0, 64), "(0.2+0i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "e", 4, 64), "(2.5000e-01+0.0000e+00i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "f", 4, 64), "(0.2500+0.0000i)"
  atoc_chk("1.5i", 128, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", -1, 128), "(0+1.5i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 0, 128), "(0e+00+2e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 2, 128), "(0.00+1.50i)"
  atoc_chk("1.5i", 64, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 3, 64), "(0+1.5i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 2, 64), "(0.00e+00+1.50e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 3, 64), "(0.000+1.500i)"
  atoc_chk("-InfNaNj", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-InfNaNj\": invalid syntax")
  atoc_chk("-InfNaNj", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-InfNaNj\": invalid syntax")
  atoc_chk("(+3+-Infi)", 128, 3.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(3.0, math.inf(-1)), "g", 3, 128), "(3-Infi)"
  assert_eq format_complex(Complex.new(3.0, math.inf(-1)), "e", 2, 128), "(3.00e+00-Infi)"
  assert_eq format_complex(Complex.new(3.0, math.inf(-1)), "f", 1, 128), "(3.0-Infi)"
  atoc_chk("(+3+-Infi)", 64, 3.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(3.0, math.inf(-1)), "g", 0, 64), "(3-Infi)"
  assert_eq format_complex(Complex.new(3.0, math.inf(-1)), "e", -1, 64), "(3e+00-Infi)"
  assert_eq format_complex(Complex.new(3.0, math.inf(-1)), "f", -1, 64), "(3-Infi)"
  atoc_chk("Inf", 128, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 3, 128), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 0, 128), "(+Inf+0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 2, 128), "(+Inf+0.00i)"
  atoc_chk("Inf", 64, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 2, 64), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 2, 64), "(+Inf+0.00e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 0, 64), "(+Inf+0i)"
  atoc_chk("0x1p-2+1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p-2+1e309i\": value out of range")
  atoc_chk("0x1p-2+1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p-2+1e309i\": value out of range")
  atoc_chk("1infinityj", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1infinityj\": invalid syntax")
  atoc_chk("1infinityj", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1infinityj\": invalid syntax")
  atoc_chk("11.5j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"11.5j\": invalid syntax")
  atoc_chk("11.5j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"11.5j\": invalid syntax")
  atoc_chk("-1-2.5e-3i", 128, (-1.0), (-0.0025), "")
  assert_eq format_complex(Complex.new((-1.0), (-0.0025)), "g", 1, 128), "(-1-0.003i)"
  assert_eq format_complex(Complex.new((-1.0), (-0.0025)), "e", 1, 128), "(-1.0e+00-2.5e-03i)"
  assert_eq format_complex(Complex.new((-1.0), (-0.0025)), "f", 4, 128), "(-1.0000-0.0025i)"
  atoc_chk("-1-2.5e-3i", 64, (-1.0), (-0.0024999999441206455), "")
  assert_eq format_complex(Complex.new((-1.0), (-0.0024999999441206455)), "g", 3, 64), "(-1-0.0025i)"
  assert_eq format_complex(Complex.new((-1.0), (-0.0024999999441206455)), "e", 3, 64), "(-1.000e+00-2.500e-03i)"
  assert_eq format_complex(Complex.new((-1.0), (-0.0024999999441206455)), "f", 1, 64), "(-1.0-0.0i)"
  atoc_chk("+3i", 128, 0.0, 3.0, "")
  assert_eq format_complex(Complex.new(0.0, 3.0), "g", 0, 128), "(0+3i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "e", 3, 128), "(0.000e+00+3.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "f", 3, 128), "(0.000+3.000i)"
  atoc_chk("+3i", 64, 0.0, 3.0, "")
  assert_eq format_complex(Complex.new(0.0, 3.0), "g", 4, 64), "(0+3i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "e", 3, 64), "(0.000e+00+3.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 3.0), "f", 4, 64), "(0.0000+3.0000i)"
  atoc_chk("infinityi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 4, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 3, 128), "(0.000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 3, 128), "(0.000+Infi)"
  atoc_chk("infinityi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 0, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", -1, 64), "(0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 3, 64), "(0.000+Infi)"
  atoc_chk("0x1p-21j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p-21j\": invalid syntax")
  atoc_chk("0x1p-21j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p-21j\": invalid syntax")
  atoc_chk("NaN1j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN1j\": invalid syntax")
  atoc_chk("NaN1j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN1j\": invalid syntax")
  atoc_chk("Infi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", -1, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", -1, 128), "(0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 0, 128), "(0+Infi)"
  atoc_chk("Infi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 2, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 0, 64), "(0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 2, 64), "(0.00+Infi)"
  atoc_chk("1+infinityi", 128, 1.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(1.0, math.inf(1)), "g", 4, 128), "(1+Infi)"
  assert_eq format_complex(Complex.new(1.0, math.inf(1)), "e", 0, 128), "(1e+00+Infi)"
  assert_eq format_complex(Complex.new(1.0, math.inf(1)), "f", -1, 128), "(1+Infi)"
  atoc_chk("1+infinityi", 64, 1.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(1.0, math.inf(1)), "g", 1, 64), "(1+Infi)"
  assert_eq format_complex(Complex.new(1.0, math.inf(1)), "e", 2, 64), "(1.00e+00+Infi)"
  assert_eq format_complex(Complex.new(1.0, math.inf(1)), "f", 2, 64), "(1.00+Infi)"
  atoc_chk("0x1p-2+3.4028236e38i", 128, 0.25, 3.4028236e38, "")
  assert_eq format_complex(Complex.new(0.25, 3.4028236e38), "g", 0, 128), "(0.2+3e+38i)"
  assert_eq format_complex(Complex.new(0.25, 3.4028236e38), "e", 4, 128), "(2.5000e-01+3.4028e+38i)"
}

test "complex 11" {
  assert_eq format_complex(Complex.new(0.25, 3.4028236e38), "f", 4, 128), "(0.2500+340282359999999991113723490719674400768.0000i)"
  atoc_chk("0x1p-2+3.4028236e38i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p-2+3.4028236e38i\": value out of range")
  atoc_chk("+30j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+30j\": invalid syntax")
  atoc_chk("+30j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+30j\": invalid syntax")
  atoc_chk("(3.4028236e38+1e309i)", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(3.4028236e38+1e309i)\": value out of range")
  atoc_chk("(3.4028236e38+1e309i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(3.4028236e38+1e309i)\": value out of range")
  atoc_chk("Inf", 128, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 3, 128), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 1, 128), "(+Inf+0.0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 1, 128), "(+Inf+0.0i)"
  atoc_chk("Inf", 64, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 0, 64), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", -1, 64), "(+Inf+0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", -1, 64), "(+Inf+0i)"
  atoc_chk("1e-400+NaNi", 128, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 4, 128), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 1, 128), "(0.0e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 1, 128), "(0.0+NaNi)"
  atoc_chk("1e-400+NaNi", 64, 0.0, math.nan(), "")
  assert_eq format_complex(Complex.new(0.0, math.nan()), "g", 1, 64), "(0+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "e", 0, 64), "(0e+00+NaNi)"
  assert_eq format_complex(Complex.new(0.0, math.nan()), "f", 0, 64), "(0+NaNi)"
  atoc_chk("NaN-2.5e-3j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN-2.5e-3j\": invalid syntax")
  atoc_chk("NaN-2.5e-3j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"NaN-2.5e-3j\": invalid syntax")
  atoc_chk("1e3090j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e3090j\": invalid syntax")
  atoc_chk("1e3090j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e3090j\": invalid syntax")
  atoc_chk("3.4028236e38i", 128, 0.0, 3.4028236e38, "")
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "g", 3, 128), "(0+3.4e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "e", 4, 128), "(0.0000e+00+3.4028e+38i)"
  assert_eq format_complex(Complex.new(0.0, 3.4028236e38), "f", 4, 128), "(0.0000+340282359999999991113723490719674400768.0000i)"
  atoc_chk("3.4028236e38i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38i\": value out of range")
  atoc_chk("-1-1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1-1e309i\": value out of range")
  atoc_chk("-1-1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1-1e309i\": value out of range")
  atoc_chk("Inf", 128, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 2, 128), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 1, 128), "(+Inf+0.0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 1, 128), "(+Inf+0.0i)"
  atoc_chk("Inf", 64, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 1, 64), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 3, 64), "(+Inf+0.000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 4, 64), "(+Inf+0.0000i)"
  atoc_chk("Infi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 3, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 4, 128), "(0.0000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 1, 128), "(0.0+Infi)"
  atoc_chk("Infi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 3, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 3, 64), "(0.000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 4, 64), "(0.0000+Infi)"
  atoc_chk("(0x1p-2+1.5i)", 128, 0.25, 1.5, "")
  assert_eq format_complex(Complex.new(0.25, 1.5), "g", 0, 128), "(0.2+2i)"
  assert_eq format_complex(Complex.new(0.25, 1.5), "e", 0, 128), "(2e-01+2e+00i)"
  assert_eq format_complex(Complex.new(0.25, 1.5), "f", -1, 128), "(0.25+1.5i)"
  atoc_chk("(0x1p-2+1.5i)", 64, 0.25, 1.5, "")
  assert_eq format_complex(Complex.new(0.25, 1.5), "g", 2, 64), "(0.25+1.5i)"
  assert_eq format_complex(Complex.new(0.25, 1.5), "e", 3, 64), "(2.500e-01+1.500e+00i)"
  assert_eq format_complex(Complex.new(0.25, 1.5), "f", 4, 64), "(0.2500+1.5000i)"
  atoc_chk("+3+3j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+3+3j\": invalid syntax")
  atoc_chk("+3+3j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+3+3j\": invalid syntax")
  atoc_chk("-1e3090x1p-2j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e3090x1p-2j\": invalid syntax")
  atoc_chk("-1e3090x1p-2j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e3090x1p-2j\": invalid syntax")
  atoc_chk("Inf", 128, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 0, 128), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 3, 128), "(+Inf+0.000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 4, 128), "(+Inf+0.0000i)"
  atoc_chk("Inf", 64, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 4, 64), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 1, 64), "(+Inf+0.0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 4, 64), "(+Inf+0.0000i)"
  atoc_chk("NaN", 128, math.nan(), 0.0, "")
  assert_eq format_complex(Complex.new(math.nan(), 0.0), "g", 2, 128), "(NaN+0i)"
  assert_eq format_complex(Complex.new(math.nan(), 0.0), "e", 4, 128), "(NaN+0.0000e+00i)"
  assert_eq format_complex(Complex.new(math.nan(), 0.0), "f", 1, 128), "(NaN+0.0i)"
  atoc_chk("NaN", 64, math.nan(), 0.0, "")
  assert_eq format_complex(Complex.new(math.nan(), 0.0), "g", 0, 64), "(NaN+0i)"
  assert_eq format_complex(Complex.new(math.nan(), 0.0), "e", 3, 64), "(NaN+0.000e+00i)"
  assert_eq format_complex(Complex.new(math.nan(), 0.0), "f", 4, 64), "(NaN+0.0000i)"
  atoc_chk("-1-Infi", 128, (-1.0), math.inf(-1), "")
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "g", 2, 128), "(-1-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "e", 1, 128), "(-1.0e+00-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "f", 3, 128), "(-1.000-Infi)"
  atoc_chk("-1-Infi", 64, (-1.0), math.inf(-1), "")
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "g", 1, 64), "(-1-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "e", 1, 64), "(-1.0e+00-Infi)"
  assert_eq format_complex(Complex.new((-1.0), math.inf(-1)), "f", 0, 64), "(-1-Infi)"
  atoc_chk("-2.5e-31j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-2.5e-31j\": invalid syntax")
  atoc_chk("-2.5e-31j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-2.5e-31j\": invalid syntax")
  atoc_chk("(3.4028236e38+1e-400i)", 128, 3.4028236e38, 0.0, "")
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "g", 1, 128), "(3e+38+0i)"
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "e", 1, 128), "(3.4e+38+0.0e+00i)"
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "f", -1, 128), "(340282360000000000000000000000000000000+0i)"
  atoc_chk("(3.4028236e38+1e-400i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(3.4028236e38+1e-400i)\": value out of range")
  atoc_chk("(NaN+-1e309i)", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(NaN+-1e309i)\": value out of range")
  atoc_chk("(NaN+-1e309i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(NaN+-1e309i)\": value out of range")
  atoc_chk("0x1p-2-2.5e-3j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p-2-2.5e-3j\": invalid syntax")
  atoc_chk("0x1p-2-2.5e-3j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"0x1p-2-2.5e-3j\": invalid syntax")
  atoc_chk("1e309-1j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309-1j\": invalid syntax")
  atoc_chk("1e309-1j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309-1j\": invalid syntax")
  atoc_chk("(-1+NaNi)", 128, (-1.0), math.nan(), "")
  assert_eq format_complex(Complex.new((-1.0), math.nan()), "g", -1, 128), "(-1+NaNi)"
}

test "complex 12" {
  assert_eq format_complex(Complex.new((-1.0), math.nan()), "e", 1, 128), "(-1.0e+00+NaNi)"
  assert_eq format_complex(Complex.new((-1.0), math.nan()), "f", 4, 128), "(-1.0000+NaNi)"
  atoc_chk("(-1+NaNi)", 64, (-1.0), math.nan(), "")
  assert_eq format_complex(Complex.new((-1.0), math.nan()), "g", 4, 64), "(-1+NaNi)"
  assert_eq format_complex(Complex.new((-1.0), math.nan()), "e", 3, 64), "(-1.000e+00+NaNi)"
  assert_eq format_complex(Complex.new((-1.0), math.nan()), "f", 3, 64), "(-1.000+NaNi)"
  atoc_chk("-13.4028236e38j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-13.4028236e38j\": invalid syntax")
  atoc_chk("-13.4028236e38j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-13.4028236e38j\": invalid syntax")
  atoc_chk("0x1p-2i", 128, 0.0, 0.25, "")
  assert_eq format_complex(Complex.new(0.0, 0.25), "g", 2, 128), "(0+0.25i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "e", 1, 128), "(0.0e+00+2.5e-01i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "f", 1, 128), "(0.0+0.2i)"
  atoc_chk("0x1p-2i", 64, 0.0, 0.25, "")
  assert_eq format_complex(Complex.new(0.0, 0.25), "g", 0, 64), "(0+0.2i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "e", 1, 64), "(0.0e+00+2.5e-01i)"
  assert_eq format_complex(Complex.new(0.0, 0.25), "f", -1, 64), "(0+0.25i)"
  atoc_chk("1e309-1i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309-1i\": value out of range")
  atoc_chk("1e309-1i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309-1i\": value out of range")
  atoc_chk("1e309", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309\": value out of range")
  atoc_chk("1e309", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309\": value out of range")
  atoc_chk("0i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 0, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 128), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 4, 128), "(0.0000+0.0000i)"
  atoc_chk("0i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 64), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", -1, 64), "(0+0i)"
  atoc_chk("-1", 128, (-1.0), 0.0, "")
  assert_eq format_complex(Complex.new((-1.0), 0.0), "g", 2, 128), "(-1+0i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "e", 0, 128), "(-1e+00+0e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "f", 2, 128), "(-1.00+0.00i)"
  atoc_chk("-1", 64, (-1.0), 0.0, "")
  assert_eq format_complex(Complex.new((-1.0), 0.0), "g", 0, 64), "(-1+0i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "e", 1, 64), "(-1.0e+00+0.0e+00i)"
  assert_eq format_complex(Complex.new((-1.0), 0.0), "f", 0, 64), "(-1+0i)"
  atoc_chk("Inf1e309j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"Inf1e309j\": invalid syntax")
  atoc_chk("Inf1e309j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"Inf1e309j\": invalid syntax")
  atoc_chk("(3.4028236e38+-1i)", 128, 3.4028236e38, (-1.0), "")
  assert_eq format_complex(Complex.new(3.4028236e38, (-1.0)), "g", 3, 128), "(3.4e+38-1i)"
  assert_eq format_complex(Complex.new(3.4028236e38, (-1.0)), "e", 2, 128), "(3.40e+38-1.00e+00i)"
  assert_eq format_complex(Complex.new(3.4028236e38, (-1.0)), "f", 4, 128), "(340282359999999991113723490719674400768.0000-1.0000i)"
  atoc_chk("(3.4028236e38+-1i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(3.4028236e38+-1i)\": value out of range")
  atoc_chk("1.5-Infj", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1.5-Infj\": invalid syntax")
  atoc_chk("1.5-Infj", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1.5-Infj\": invalid syntax")
  atoc_chk("Inf-1i", 128, math.inf(1), (-1.0), "")
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "g", 3, 128), "(+Inf-1i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "e", 1, 128), "(+Inf-1.0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "f", -1, 128), "(+Inf-1i)"
  atoc_chk("Inf-1i", 64, math.inf(1), (-1.0), "")
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "g", 2, 64), "(+Inf-1i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "e", 4, 64), "(+Inf-1.0000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "f", 1, 64), "(+Inf-1.0i)"
  atoc_chk("+3NaNj", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+3NaNj\": invalid syntax")
  atoc_chk("+3NaNj", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+3NaNj\": invalid syntax")
  atoc_chk("(1e-400++3i)", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"(1e-400++3i)\": invalid syntax")
  atoc_chk("(1e-400++3i)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(1e-400++3i)\": invalid syntax")
  atoc_chk("-1i", 128, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", -1, 128), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", 1, 128), "(0.0e+00-1.0e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", -1, 128), "(0-1i)"
  atoc_chk("-1i", 64, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 4, 64), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", 2, 64), "(0.00e+00-1.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", 2, 64), "(0.00-1.00i)"
  atoc_chk("1e-400i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 4, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", -1, 128), "(0e+00+0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 0, 128), "(0+0i)"
  atoc_chk("1e-400i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 3, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 4, 64), "(0.0000e+00+0.0000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 1, 64), "(0.0+0.0i)"
  atoc_chk("Inf+1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"Inf+1e309i\": value out of range")
  atoc_chk("Inf+1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"Inf+1e309i\": value out of range")
  atoc_chk("(infinity+-1i)", 128, math.inf(1), (-1.0), "")
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "g", -1, 128), "(+Inf-1i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "e", 4, 128), "(+Inf-1.0000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "f", -1, 128), "(+Inf-1i)"
  atoc_chk("(infinity+-1i)", 64, math.inf(1), (-1.0), "")
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "g", 0, 64), "(+Inf-1i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "e", 3, 64), "(+Inf-1.000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), (-1.0)), "f", 0, 64), "(+Inf-1i)"
  atoc_chk("infinity-1e309j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"infinity-1e309j\": invalid syntax")
  atoc_chk("infinity-1e309j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"infinity-1e309j\": invalid syntax")
  atoc_chk("1.5i", 128, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 3, 128), "(0+1.5i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 2, 128), "(0.00e+00+1.50e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 1, 128), "(0.0+1.5i)"
  atoc_chk("1.5i", 64, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 3, 64), "(0+1.5i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 0, 64), "(0e+00+2e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 2, 64), "(0.00+1.50i)"
  atoc_chk("1i", 128, 0.0, 1.0, "")
  assert_eq format_complex(Complex.new(0.0, 1.0), "g", 1, 128), "(0+1i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "e", 1, 128), "(0.0e+00+1.0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "f", -1, 128), "(0+1i)"
  atoc_chk("1i", 64, 0.0, 1.0, "")
  assert_eq format_complex(Complex.new(0.0, 1.0), "g", -1, 64), "(0+1i)"
  assert_eq format_complex(Complex.new(0.0, 1.0), "e", 1, 64), "(0.0e+00+1.0e+00i)"
}

test "complex 13" {
  assert_eq format_complex(Complex.new(0.0, 1.0), "f", 4, 64), "(0.0000+1.0000i)"
  atoc_chk("1.5i", 128, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 4, 128), "(0+1.5i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 2, 128), "(0.00e+00+1.50e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 4, 128), "(0.0000+1.5000i)"
  atoc_chk("1.5i", 64, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", -1, 64), "(0+1.5i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 4, 64), "(0.0000e+00+1.5000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 2, 64), "(0.00+1.50i)"
  atoc_chk("+30x1p-2j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"+30x1p-2j\": invalid syntax")
  atoc_chk("+30x1p-2j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"+30x1p-2j\": invalid syntax")
  atoc_chk("(-2.5e-3+0x1p-2i)", 128, (-0.0025), 0.25, "")
  assert_eq format_complex(Complex.new((-0.0025), 0.25), "g", -1, 128), "(-0.0025+0.25i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.25), "e", 4, 128), "(-2.5000e-03+2.5000e-01i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.25), "f", 4, 128), "(-0.0025+0.2500i)"
  atoc_chk("(-2.5e-3+0x1p-2i)", 64, (-0.0024999999441206455), 0.25, "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.25), "g", 3, 64), "(-0.0025+0.25i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.25), "e", 0, 64), "(-2e-03+2e-01i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.25), "f", 2, 64), "(-0.00+0.25i)"
  atoc_chk("-2.5e-3", 128, (-0.0025), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "g", 2, 128), "(-0.0025+0i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "e", 4, 128), "(-2.5000e-03+0.0000e+00i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "f", 0, 128), "(-0+0i)"
  atoc_chk("-2.5e-3", 64, (-0.0024999999441206455), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "g", 1, 64), "(-0.002+0i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "e", 3, 64), "(-2.500e-03+0.000e+00i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "f", 4, 64), "(-0.0025+0.0000i)"
  atoc_chk("infinity1e309j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"infinity1e309j\": invalid syntax")
  atoc_chk("infinity1e309j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"infinity1e309j\": invalid syntax")
  atoc_chk("(0x1p-2+-Infi)", 128, 0.25, math.inf(-1), "")
  assert_eq format_complex(Complex.new(0.25, math.inf(-1)), "g", 2, 128), "(0.25-Infi)"
  assert_eq format_complex(Complex.new(0.25, math.inf(-1)), "e", 2, 128), "(2.50e-01-Infi)"
  assert_eq format_complex(Complex.new(0.25, math.inf(-1)), "f", -1, 128), "(0.25-Infi)"
  atoc_chk("(0x1p-2+-Infi)", 64, 0.25, math.inf(-1), "")
  assert_eq format_complex(Complex.new(0.25, math.inf(-1)), "g", -1, 64), "(0.25-Infi)"
  assert_eq format_complex(Complex.new(0.25, math.inf(-1)), "e", -1, 64), "(2.5e-01-Infi)"
  assert_eq format_complex(Complex.new(0.25, math.inf(-1)), "f", 4, 64), "(0.2500-Infi)"
  atoc_chk("(-Inf+-Infi)", 128, math.inf(-1), math.inf(-1), "")
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "g", -1, 128), "(-Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "e", -1, 128), "(-Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "f", 4, 128), "(-Inf-Infi)"
  atoc_chk("(-Inf+-Infi)", 64, math.inf(-1), math.inf(-1), "")
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "g", 0, 64), "(-Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "e", 4, 64), "(-Inf-Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(-1)), "f", 1, 64), "(-Inf-Infi)"
  atoc_chk("1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309i\": value out of range")
  atoc_chk("1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309i\": value out of range")
  atoc_chk("-Inf+Infi", 128, math.inf(-1), math.inf(1), "")
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(1)), "g", 2, 128), "(-Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(1)), "e", 0, 128), "(-Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(1)), "f", 2, 128), "(-Inf+Infi)"
  atoc_chk("-Inf+Infi", 64, math.inf(-1), math.inf(1), "")
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(1)), "g", -1, 64), "(-Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(1)), "e", 0, 64), "(-Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(-1), math.inf(1)), "f", 4, 64), "(-Inf+Infi)"
  atoc_chk("1e-400-1e309i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e-400-1e309i\": value out of range")
  atoc_chk("1e-400-1e309i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e-400-1e309i\": value out of range")
  atoc_chk("infinityi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 2, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 3, 128), "(0.000e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 3, 128), "(0.000+Infi)"
  atoc_chk("infinityi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 0, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 0, 64), "(0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 2, 64), "(0.00+Infi)"
  atoc_chk("1e-400i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 3, 128), "(0.000e+00+0.000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 1, 128), "(0.0+0.0i)"
  atoc_chk("1e-400i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 4, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 4, 64), "(0.0000e+00+0.0000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", -1, 64), "(0+0i)"
  atoc_chk("1.5i", 128, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 0, 128), "(0+2i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", -1, 128), "(0e+00+1.5e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 1, 128), "(0.0+1.5i)"
  atoc_chk("1.5i", 64, 0.0, 1.5, "")
  assert_eq format_complex(Complex.new(0.0, 1.5), "g", 2, 64), "(0+1.5i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "e", 4, 64), "(0.0000e+00+1.5000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 1.5), "f", 0, 64), "(0+2i)"
  atoc_chk("(Inf+infinityi)", 128, math.inf(1), math.inf(1), "")
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "g", 2, 128), "(+Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "e", 3, 128), "(+Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "f", 4, 128), "(+Inf+Infi)"
  atoc_chk("(Inf+infinityi)", 64, math.inf(1), math.inf(1), "")
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "g", 4, 64), "(+Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "e", 4, 64), "(+Inf+Infi)"
  assert_eq format_complex(Complex.new(math.inf(1), math.inf(1)), "f", -1, 64), "(+Inf+Infi)"
  atoc_chk("3.4028236e38", 128, 3.4028236e38, 0.0, "")
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "g", -1, 128), "(3.4028236e+38+0i)"
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "e", 0, 128), "(3e+38+0e+00i)"
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "f", 4, 128), "(340282359999999991113723490719674400768.0000+0.0000i)"
  atoc_chk("3.4028236e38", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38\": value out of range")
  atoc_chk("+3+3i", 128, 3.0, 3.0, "")
  assert_eq format_complex(Complex.new(3.0, 3.0), "g", 0, 128), "(3+3i)"
  assert_eq format_complex(Complex.new(3.0, 3.0), "e", 2, 128), "(3.00e+00+3.00e+00i)"
  assert_eq format_complex(Complex.new(3.0, 3.0), "f", 2, 128), "(3.00+3.00i)"
  atoc_chk("+3+3i", 64, 3.0, 3.0, "")
  assert_eq format_complex(Complex.new(3.0, 3.0), "g", 3, 64), "(3+3i)"
}

test "complex 14" {
  assert_eq format_complex(Complex.new(3.0, 3.0), "e", 1, 64), "(3.0e+00+3.0e+00i)"
  assert_eq format_complex(Complex.new(3.0, 3.0), "f", -1, 64), "(3+3i)"
  atoc_chk("-1e309+1i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e309+1i\": value out of range")
  atoc_chk("-1e309+1i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1e309+1i\": value out of range")
  atoc_chk("Inf0j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"Inf0j\": invalid syntax")
  atoc_chk("Inf0j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"Inf0j\": invalid syntax")
  atoc_chk("3.4028236e38", 128, 3.4028236e38, 0.0, "")
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "g", 4, 128), "(3.403e+38+0i)"
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "e", 2, 128), "(3.40e+38+0.00e+00i)"
  assert_eq format_complex(Complex.new(3.4028236e38, 0.0), "f", 2, 128), "(340282359999999991113723490719674400768.00+0.00i)"
  atoc_chk("3.4028236e38", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"3.4028236e38\": value out of range")
  atoc_chk("1e309+1i", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+1i\": value out of range")
  atoc_chk("1e309+1i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309+1i\": value out of range")
  atoc_chk("1e-400+Infi", 128, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 0, 128), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", 1, 128), "(0.0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 3, 128), "(0.000+Infi)"
  atoc_chk("1e-400+Infi", 64, 0.0, math.inf(1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "g", 0, 64), "(0+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "e", -1, 64), "(0e+00+Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(1)), "f", 4, 64), "(0.0000+Infi)"
  atoc_chk("1e3090x1p-2j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e3090x1p-2j\": invalid syntax")
  atoc_chk("1e3090x1p-2j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e3090x1p-2j\": invalid syntax")
  atoc_chk("(1.5+Infi)", 128, 1.5, math.inf(1), "")
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "g", 2, 128), "(1.5+Infi)"
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "e", 3, 128), "(1.500e+00+Infi)"
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "f", 0, 128), "(2+Infi)"
  atoc_chk("(1.5+Infi)", 64, 1.5, math.inf(1), "")
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "g", 1, 64), "(2+Infi)"
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "e", -1, 64), "(1.5e+00+Infi)"
  assert_eq format_complex(Complex.new(1.5, math.inf(1)), "f", 4, 64), "(1.5000+Infi)"
  atoc_chk("1.5+3.4028236e38i", 128, 1.5, 3.4028236e38, "")
  assert_eq format_complex(Complex.new(1.5, 3.4028236e38), "g", 4, 128), "(1.5+3.403e+38i)"
  assert_eq format_complex(Complex.new(1.5, 3.4028236e38), "e", 3, 128), "(1.500e+00+3.403e+38i)"
  assert_eq format_complex(Complex.new(1.5, 3.4028236e38), "f", 2, 128), "(1.50+340282359999999991113723490719674400768.00i)"
  atoc_chk("1.5+3.4028236e38i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1.5+3.4028236e38i\": value out of range")
  atoc_chk("(3.4028236e38+NaNi)", 128, 3.4028236e38, math.nan(), "")
  assert_eq format_complex(Complex.new(3.4028236e38, math.nan()), "g", 1, 128), "(3e+38+NaNi)"
  assert_eq format_complex(Complex.new(3.4028236e38, math.nan()), "e", 2, 128), "(3.40e+38+NaNi)"
  assert_eq format_complex(Complex.new(3.4028236e38, math.nan()), "f", 3, 128), "(340282359999999991113723490719674400768.000+NaNi)"
  atoc_chk("(3.4028236e38+NaNi)", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"(3.4028236e38+NaNi)\": value out of range")
  atoc_chk("-2.5e-3", 128, (-0.0025), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "g", 4, 128), "(-0.0025+0i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "e", 0, 128), "(-3e-03+0e+00i)"
  assert_eq format_complex(Complex.new((-0.0025), 0.0), "f", 0, 128), "(-0+0i)"
  atoc_chk("-2.5e-3", 64, (-0.0024999999441206455), 0.0, "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "g", 3, 64), "(-0.0025+0i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "e", 0, 64), "(-2e-03+0e+00i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 0.0), "f", 1, 64), "(-0.0+0.0i)"
  atoc_chk("1e-400i", 128, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 0, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", -1, 128), "(0e+00+0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 0, 128), "(0+0i)"
  atoc_chk("1e-400i", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 3, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 4, 64), "(0.0000e+00+0.0000e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 3, 64), "(0.000+0.000i)"
  atoc_chk("Inf", 128, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 1, 128), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", -1, 128), "(+Inf+0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 0, 128), "(+Inf+0i)"
  atoc_chk("Inf", 64, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 1, 64), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 1, 64), "(+Inf+0.0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 2, 64), "(+Inf+0.00i)"
  atoc_chk("1e-4001e-400j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e-4001e-400j\": invalid syntax")
  atoc_chk("1e-4001e-400j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e-4001e-400j\": invalid syntax")
  atoc_chk("(1e-400+-1i)", 128, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 0, 128), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", 2, 128), "(0.00e+00-1.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", 1, 128), "(0.0-1.0i)"
  atoc_chk("(1e-400+-1i)", 64, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 3, 64), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", 0, 64), "(0e+00-1e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", 0, 64), "(0-1i)"
  atoc_chk("Inf", 128, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 4, 128), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 0, 128), "(+Inf+0e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 3, 128), "(+Inf+0.000i)"
  atoc_chk("Inf", 64, math.inf(1), 0.0, "")
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "g", 3, 64), "(+Inf+0i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "e", 3, 64), "(+Inf+0.000e+00i)"
  assert_eq format_complex(Complex.new(math.inf(1), 0.0), "f", 0, 64), "(+Inf+0i)"
  atoc_chk("(NaN+Infi)", 128, math.nan(), math.inf(1), "")
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "g", 0, 128), "(NaN+Infi)"
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "e", 3, 128), "(NaN+Infi)"
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "f", 2, 128), "(NaN+Infi)"
  atoc_chk("(NaN+Infi)", 64, math.nan(), math.inf(1), "")
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "g", -1, 64), "(NaN+Infi)"
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "e", 2, 64), "(NaN+Infi)"
  assert_eq format_complex(Complex.new(math.nan(), math.inf(1)), "f", -1, 64), "(NaN+Infi)"
  atoc_chk("-2.5e-3+3i", 128, (-0.0025), 3.0, "")
  assert_eq format_complex(Complex.new((-0.0025), 3.0), "g", -1, 128), "(-0.0025+3i)"
  assert_eq format_complex(Complex.new((-0.0025), 3.0), "e", 1, 128), "(-2.5e-03+3.0e+00i)"
  assert_eq format_complex(Complex.new((-0.0025), 3.0), "f", 0, 128), "(-0+3i)"
  atoc_chk("-2.5e-3+3i", 64, (-0.0024999999441206455), 3.0, "")
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 3.0), "g", 0, 64), "(-0.002+3i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 3.0), "e", 1, 64), "(-2.5e-03+3.0e+00i)"
  assert_eq format_complex(Complex.new((-0.0024999999441206455), 3.0), "f", 1, 64), "(-0.0+3.0i)"
  atoc_chk("0", 128, 0.0, 0.0, "")
}

test "complex 15" {
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", -1, 128), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 2, 128), "(0.00e+00+0.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 4, 128), "(0.0000+0.0000i)"
  atoc_chk("0", 64, 0.0, 0.0, "")
  assert_eq format_complex(Complex.new(0.0, 0.0), "g", 1, 64), "(0+0i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "e", 0, 64), "(0e+00+0e+00i)"
  assert_eq format_complex(Complex.new(0.0, 0.0), "f", 2, 64), "(0.00+0.00i)"
  atoc_chk("1-1i", 128, 1.0, (-1.0), "")
  assert_eq format_complex(Complex.new(1.0, (-1.0)), "g", -1, 128), "(1-1i)"
  assert_eq format_complex(Complex.new(1.0, (-1.0)), "e", -1, 128), "(1e+00-1e+00i)"
  assert_eq format_complex(Complex.new(1.0, (-1.0)), "f", 4, 128), "(1.0000-1.0000i)"
  atoc_chk("1-1i", 64, 1.0, (-1.0), "")
  assert_eq format_complex(Complex.new(1.0, (-1.0)), "g", 1, 64), "(1-1i)"
  assert_eq format_complex(Complex.new(1.0, (-1.0)), "e", 4, 64), "(1.0000e+00-1.0000e+00i)"
  assert_eq format_complex(Complex.new(1.0, (-1.0)), "f", 0, 64), "(1-1i)"
  atoc_chk("1e309", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309\": value out of range")
  atoc_chk("1e309", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"1e309\": value out of range")
  atoc_chk("-Infi", 128, 0.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "g", 2, 128), "(0-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "e", 4, 128), "(0.0000e+00-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "f", 2, 128), "(0.00-Infi)"
  atoc_chk("-Infi", 64, 0.0, math.inf(-1), "")
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "g", 3, 64), "(0-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "e", 1, 64), "(0.0e+00-Infi)"
  assert_eq format_complex(Complex.new(0.0, math.inf(-1)), "f", 3, 64), "(0.000-Infi)"
  atoc_chk("0x1p-2", 128, 0.25, 0.0, "")
  assert_eq format_complex(Complex.new(0.25, 0.0), "g", 3, 128), "(0.25+0i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "e", 1, 128), "(2.5e-01+0.0e+00i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "f", -1, 128), "(0.25+0i)"
  atoc_chk("0x1p-2", 64, 0.25, 0.0, "")
  assert_eq format_complex(Complex.new(0.25, 0.0), "g", 0, 64), "(0.2+0i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "e", 0, 64), "(2e-01+0e+00i)"
  assert_eq format_complex(Complex.new(0.25, 0.0), "f", 4, 64), "(0.2500+0.0000i)"
  atoc_chk("00x1p-2j", 128, 0.0, 0.0, "strconv.parse_complex: parsing \"00x1p-2j\": invalid syntax")
  atoc_chk("00x1p-2j", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"00x1p-2j\": invalid syntax")
  atoc_chk("-1+3.4028236e38i", 128, (-1.0), 3.4028236e38, "")
  assert_eq format_complex(Complex.new((-1.0), 3.4028236e38), "g", 1, 128), "(-1+3e+38i)"
  assert_eq format_complex(Complex.new((-1.0), 3.4028236e38), "e", 4, 128), "(-1.0000e+00+3.4028e+38i)"
  assert_eq format_complex(Complex.new((-1.0), 3.4028236e38), "f", 1, 128), "(-1.0+340282359999999991113723490719674400768.0i)"
  atoc_chk("-1+3.4028236e38i", 64, 0.0, 0.0, "strconv.parse_complex: parsing \"-1+3.4028236e38i\": value out of range")
  atoc_chk("1e-400-1i", 128, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 4, 128), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", -1, 128), "(0e+00-1e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", -1, 128), "(0-1i)"
  atoc_chk("1e-400-1i", 64, 0.0, (-1.0), "")
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "g", 1, 64), "(0-1i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "e", 2, 64), "(0.00e+00-1.00e+00i)"
  assert_eq format_complex(Complex.new(0.0, (-1.0)), "f", -1, 64), "(0-1i)"
}
