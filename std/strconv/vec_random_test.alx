test "Ftoa32Random" {
  assert_eq format_float(math.float64frombits(0x3b08db9420000000), "b", 8, 32), "13032609p-102"
  assert_eq parse_float("2.570229e-24", 32).unwrap, math.float64frombits(0x3b08db9420000000)
  assert_eq format_float(math.float64frombits(0x3cda94cdc0000000), "e", 1, 32), "1.5e-15"
  assert_eq parse_float("1.4755566e-15", 32).unwrap, math.float64frombits(0x3cda94cdc0000000)
  assert_eq format_float(math.float64frombits(0x444676d4e0000000), "G", -1, 32), "8.287822E+20"
  assert_eq parse_float("8.287822e+20", 32).unwrap, math.float64frombits(0x444676d4e0000000)
  assert_eq format_float(math.float64frombits(0xc44d6168e0000000), "b", 4, 32), "-15403847p+46"
  assert_eq parse_float("-1.0839494e+21", 32).unwrap, math.float64frombits(0xc44d6168e0000000)
  assert_eq format_float(math.float64frombits(0xc059d50740000000), "E", 8, 32), "-1.03328568E+02"
  assert_eq parse_float("-103.32857", 32).unwrap, math.float64frombits(0xc059d50740000000)
  assert_eq format_float(math.float64frombits(0xbc8006b200000000), "x", 7, 32), "-0x1.006b200p-55"
  assert_eq parse_float("-2.7800945e-17", 32).unwrap, math.float64frombits(0xbc8006b200000000)
  assert_eq format_float(math.float64frombits(0x3d5ad6d0c0000000), "x", 4, 32), "0x1.ad6dp-42"
  assert_eq parse_float("3.8140687e-13", 32).unwrap, math.float64frombits(0x3d5ad6d0c0000000)
  assert_eq format_float(math.float64frombits(0xc63f692e80000000), "e", 3, 32), "-2.489e+30"
  assert_eq parse_float("-2.4886252e+30", 32).unwrap, math.float64frombits(0xc63f692e80000000)
  assert_eq format_float(math.float64frombits(0x39ac1845c0000000), "x", 8, 32), "0x1.c1845c00p-101"
  assert_eq parse_float("6.9259065e-31", 32).unwrap, math.float64frombits(0x39ac1845c0000000)
  assert_eq format_float(math.float64frombits(0x3972128640000000), "f", 5, 32), "0.00000"
  assert_eq parse_float("5.568976e-32", 32).unwrap, math.float64frombits(0x3972128640000000)
  assert_eq format_float(math.float64frombits(0x3e5ddcae20000000), "e", 5, 32), "2.78112e-08"
  assert_eq parse_float("2.7811184e-08", 32).unwrap, math.float64frombits(0x3e5ddcae20000000)
  assert_eq format_float(math.float64frombits(0xc519562b40000000), "X", 1, 32), "-0X1.9P+82"
  assert_eq parse_float("-7.6575167e+24", 32).unwrap, math.float64frombits(0xc519562b40000000)
  assert_eq format_float(math.float64frombits(0x3f46e3f9a0000000), "b", 3, 32), "12001229p-34"
  assert_eq parse_float("0.00069856347", 32).unwrap, math.float64frombits(0x3f46e3f9a0000000)
  assert_eq format_float(math.float64frombits(0x44ef36f060000000), "e", 5, 32), "1.17925e+24"
  assert_eq parse_float("1.17925445e+24", 32).unwrap, math.float64frombits(0x44ef36f060000000)
  assert_eq format_float(math.float64frombits(0xbe16201080000000), "E", 7, 32), "-1.2878592E-09"
  assert_eq parse_float("-1.2878592e-09", 32).unwrap, math.float64frombits(0xbe16201080000000)
  assert_eq format_float(math.float64frombits(0xc5f36b7580000000), "X", 0, 32), "-0X1P+96"
  assert_eq parse_float("-9.6162e+28", 32).unwrap, math.float64frombits(0xc5f36b7580000000)
  assert_eq format_float(math.float64frombits(0x458038dbc0000000), "G", 7, 32), "6.275622E+26"
  assert_eq parse_float("6.275622e+26", 32).unwrap, math.float64frombits(0x458038dbc0000000)
  assert_eq format_float(math.float64frombits(0xb8c8abfa00000000), "x", 4, 32), "-0x1.8ac0p-115"
  assert_eq parse_float("-3.7121974e-35", 32).unwrap, math.float64frombits(0xb8c8abfa00000000)
  assert_eq format_float(math.float64frombits(0x469ba90fa0000000), "X", 1, 32), "0X1.CP+106"
  assert_eq parse_float("1.4025486e+32", 32).unwrap, math.float64frombits(0x469ba90fa0000000)
  assert_eq format_float(math.float64frombits(0xc3c150aee0000000), "b", 5, 32), "-9078135p+38"
  assert_eq parse_float("-2.4953787e+18", 32).unwrap, math.float64frombits(0xc3c150aee0000000)
  assert_eq format_float(math.float64frombits(0xbfb6e372e0000000), "E", 4, 32), "-8.9408E-02"
  assert_eq parse_float("-0.08940809", 32).unwrap, math.float64frombits(0xbfb6e372e0000000)
  assert_eq format_float(math.float64frombits(0x41c3de23a0000000), "x", 0, 32), "0x1p+29"
  assert_eq parse_float("6.6665043e+08", 32).unwrap, math.float64frombits(0x41c3de23a0000000)
