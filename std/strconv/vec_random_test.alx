test "FtoaRandom 10" {
  assert_eq format_float(math.float64frombits(0x61c5b4c775e7b0cd), "g", -1, 64), "9.765418101150198e+162"
  assert_eq format_float(math.float64frombits(0x61c5b4c775e7b0cd), "e", 10, 64), "9.7654181012e+162"
  assert_eq format_float(math.float64frombits(0x2d47fd4ee952a4df), "g", -1, 64), "1.472082821644533e-90"
  assert_eq format_float(math.float64frombits(0x2d47fd4ee952a4df), "e", 5, 64), "1.47208e-90"
