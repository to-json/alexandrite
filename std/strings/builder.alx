# Go's strings.Builder: a growable byte buffer; appends are amortized O(1),
# string copies once.
#
# State sharing (GO-VS-RUBY D36): the bytes live in a one-element slice `st`,
# so copies of a Builder are the same builder (Go's *strings.Builder). Go
# panics when a copied non-zero Builder is written; alx copies share the
# buffer instead, so there is no such panic. The zero value `Builder.new` has
# no state yet: it reads as empty and its first write creates the state, so
# copies taken before that first write don't share it (write once, or use
# `new_builder`, before handing out copies).
#
# The write methods can't fail (Go returns a nil error); a Builder is an
# io.Writer and an io.StringWriter.
pub struct Builder {
  st: [[Byte]]

  # (Writers create the state of a zero-value Builder inline, `if st.size == 0`.)

  # Appends s[a...b] (bytes).
  def put_str!(s: Str, a: Int, b: Int) {
    if st.size == 0 { self.st = [[]] }
    i = a
    while i < b {
      self.st[0] << s[i]
      i += 1
    }
  }

  # Appends the UTF-8 encoding of rune value c (invalid values become U+FFFD).
  def put_rune!(c: Int) -> Int {
    if st.size == 0 { self.st = [[]] }
    r = c
    r = 0xFFFD if !valid_rune(r)
    if r < 0x80 {
      self.st[0] << r.as_u8
      return 1
    }
    if r < 0x800 {
      self.st[0] << (0xC0 | (r >> 6)).as_u8
      self.st[0] << (0x80 | (r & 0x3F)).as_u8
      return 2
    }
    if r < 0x10000 {
      self.st[0] << (0xE0 | (r >> 12)).as_u8
      self.st[0] << (0x80 | ((r >> 6) & 0x3F)).as_u8
      self.st[0] << (0x80 | (r & 0x3F)).as_u8
      return 3
    }
    self.st[0] << (0xF0 | (r >> 18)).as_u8
    self.st[0] << (0x80 | ((r >> 12) & 0x3F)).as_u8
    self.st[0] << (0x80 | ((r >> 6) & 0x3F)).as_u8
    self.st[0] << (0x80 | (r & 0x3F)).as_u8
    4
  }

  # Appends the bytes of p; returns p.size.
  pub def write!(p: [Byte]) -> Int {
    if st.size == 0 { self.st = [[]] }
    for c in p { self.st[0] << c }
    p.size
  }

  # Appends s; returns s.size.
  pub def write_string!(s: Str) -> Int {
    put_str!(s, 0, s.size)
    s.size
  }

  # Appends the byte c.
  pub def write_byte!(c: Byte) {
    if st.size == 0 { self.st = [[]] }
    self.st[0] << c
  }

  # Appends the UTF-8 encoding of r (U+FFFD for an invalid rune); returns
  # the number of bytes written.
  pub def write_rune!(r: Rune) -> Int { put_rune!(r.to_i) }

  # The accumulated string (a copy).
  pub def string -> Str { st.size == 0 ? "" : Str.from_bytes(st[0]) }
  pub def to_s -> Str { st.size == 0 ? "" : Str.from_bytes(st[0]) }

  # The number of accumulated bytes (len and size are the same).
  pub def len -> Int { st.size == 0 ? 0 : st[0].size }
  pub def size -> Int { st.size == 0 ? 0 : st[0].size }

  # Go's Cap. There is no capacity primitive yet: the length.
  pub def cap -> Int { st.size == 0 ? 0 : st[0].size }

  # Empties the builder (strings returned earlier keep their contents).
  pub def reset! {
    if st.size > 0 {
      self.st[0] = []
    }
  }

  # Go's Grow(n): panics if n is negative. Appends are already amortized
  # O(1), so there is nothing else to do.
  pub def grow!(n: Int) {
    panic "strings.Builder.grow!: negative count" if n < 0
  }
}

# A Builder whose state exists already, so copies share it from the start.
pub def new_builder -> Builder {
  cell: [[Byte]] = [[]]
  Builder.new(st: cell)
}
