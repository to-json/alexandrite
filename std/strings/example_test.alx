#![test(external)]
# Go's example_test.go, translated. ExampleToUpperSpecial,
# ExampleToLowerSpecial and ExampleToTitleSpecial need unicode.TurkishCase,
# which std/unicode doesn't have yet (strings_go_test.alx's SpecialCase test
# runs the to_title_special example with a Turkish case built there).
# ExampleClone's second line (unsafe.StringData) has no alx equivalent.

import "fmt"
import "strings"
import "unicode"

example "Clone" {
  s = "abc"
  clone = strings.clone(s)
  puts s == clone
} outputs "true\n"

example "Builder" {
  b = strings.new_builder
  i = 3
  while i >= 1 {
    fmt.fprintf(b, "%d...", i)
    i -= 1
  }
  b.write_string!("ignition")
  puts b.string
} outputs "3...2...1...ignition\n"

example "Compare" {
  puts strings.compare("a", "b")
  puts strings.compare("a", "a")
  puts strings.compare("b", "a")
} outputs "-1\n0\n1\n"

example "Contains" {
  puts strings.contains("seafood", "foo")
  puts strings.contains("seafood", "bar")
  puts strings.contains("seafood", "")
  puts strings.contains("", "")
} outputs "true\nfalse\ntrue\ntrue\n"

example "ContainsAny" {
  puts strings.contains_any("team", "i")
  puts strings.contains_any("fail", "ui")
  puts strings.contains_any("ure", "ui")
  puts strings.contains_any("failure", "ui")
  puts strings.contains_any("foo", "")
  puts strings.contains_any("", "")
} outputs "false\ntrue\ntrue\ntrue\nfalse\nfalse\n"

example "ContainsRune" {
  # Finds whether a string contains a particular Unicode code point.
  # The code point for the lowercase letter "a", for example, is 97.
  puts strings.contains_rune("aardvark", 97)
  puts strings.contains_rune("timeout", 97)
} outputs "true\nfalse\n"

example "ContainsFunc" {
  f = ->(r: Rune) -> Bool { r == 97 || r == 101 || r == 105 || r == 111 || r == 117 }
  puts strings.contains_func("hello", f)
  puts strings.contains_func("rhythms", f)
} outputs "true\nfalse\n"

example "Count" {
  puts strings.count("cheese", "e")
  puts strings.count("five", "") # before & after each rune
} outputs "3\n5\n"

example "Cut" {
  show = ->(s: Str, sep: Str) {
    if c = strings.cut(s, sep) {
      fmt.printf("Cut(%q, %q) = %q, %q, %v\n", s, sep, c[0], c[1], true)
    } else {
      fmt.printf("Cut(%q, %q) = %q, %q, %v\n", s, sep, s, "", false)
    }
  }
  show.call("Gopher", "Go")
  show.call("Gopher", "ph")
  show.call("Gopher", "er")
  show.call("Gopher", "Badger")
} outputs <<~'EOS'
  Cut("Gopher", "Go") = "", "pher", true
  Cut("Gopher", "ph") = "Go", "er", true
  Cut("Gopher", "er") = "Goph", "", true
  Cut("Gopher", "Badger") = "Gopher", "", false
EOS

example "CutPrefix" {
  show = ->(s: Str, prefix: Str) {
    after = strings.cut_prefix(s, prefix)
    fmt.printf("CutPrefix(%q, %q) = %q, %v\n", s, prefix, after || s, after.some?)
  }
  show.call("Gopher", "Go")
  show.call("Gopher", "ph")
} outputs <<~'EOS'
  CutPrefix("Gopher", "Go") = "pher", true
  CutPrefix("Gopher", "ph") = "Gopher", false
EOS

example "CutSuffix" {
  show = ->(s: Str, suffix: Str) {
    before = strings.cut_suffix(s, suffix)
    fmt.printf("CutSuffix(%q, %q) = %q, %v\n", s, suffix, before || s, before.some?)
  }
  show.call("Gopher", "Go")
  show.call("Gopher", "er")
} outputs <<~'EOS'
  CutSuffix("Gopher", "Go") = "Gopher", false
  CutSuffix("Gopher", "er") = "Goph", true
EOS

example "EqualFold" {
  puts strings.equal_fold("Go", "go")
  puts strings.equal_fold("AB", "ab") # true because comparison uses simple case-folding
  puts strings.equal_fold("ß", "ss")  # false because comparison does not use full case-folding
} outputs "true\ntrue\nfalse\n"

example "Fields" {
  fmt.printf("Fields are: %q", strings.fields("  foo bar  baz   "))
} outputs "Fields are: [\"foo\" \"bar\" \"baz\"]"

example "FieldsFunc" {
  f = ->(c: Rune) -> Bool { !unicode.is_letter(c) && !unicode.is_number(c) }
  fmt.printf("Fields are: %q", strings.fields_func("  foo1;bar2,baz3...", f))
} outputs "Fields are: [\"foo1\" \"bar2\" \"baz3\"]"

example "HasPrefix" {
  puts strings.has_prefix("Gopher", "Go")
  puts strings.has_prefix("Gopher", "C")
  puts strings.has_prefix("Gopher", "")
} outputs "true\nfalse\ntrue\n"

example "HasSuffix" {
  puts strings.has_suffix("Amigo", "go")
  puts strings.has_suffix("Amigo", "O")
  puts strings.has_suffix("Amigo", "Ami")
  puts strings.has_suffix("Amigo", "")
} outputs "true\nfalse\nfalse\ntrue\n"

example "Index" {
  puts strings.index("chicken", "ken")
  puts strings.index("chicken", "dmr")
} outputs "4\n-1\n"

example "IndexFunc" {
  han = unicode.script("Han").unwrap
  f = ->(c: Rune) -> Bool { unicode.is(han, c) }
  puts strings.index_func("Hello, 世界", f)
  puts strings.index_func("Hello, world", f)
} outputs "7\n-1\n"

example "IndexAny" {
  puts strings.index_any("chicken", "aeiouy")
  puts strings.index_any("crwth", "aeiouy")
} outputs "2\n-1\n"

example "IndexByte" {
  puts strings.index_byte("golang", 103)
  puts strings.index_byte("gophers", 104)
  puts strings.index_byte("golang", 120)
} outputs "0\n3\n-1\n"

example "IndexRune" {
  puts strings.index_rune("chicken", 107)
  puts strings.index_rune("chicken", 100)
} outputs "4\n-1\n"

example "LastIndex" {
  puts strings.index("go gopher", "go")
  puts strings.last_index("go gopher", "go")
  puts strings.last_index("go gopher", "rodent")
} outputs "0\n3\n-1\n"

example "LastIndexAny" {
  puts strings.last_index_any("go gopher", "go")
  puts strings.last_index_any("go gopher", "rodent")
  puts strings.last_index_any("go gopher", "fail")
} outputs "4\n8\n-1\n"

example "LastIndexByte" {
  puts strings.last_index_byte("Hello, world", 108)
  puts strings.last_index_byte("Hello, world", 111)
  puts strings.last_index_byte("Hello, world", 120)
} outputs "10\n8\n-1\n"

example "LastIndexFunc" {
  f = ->(r: Rune) -> Bool { unicode.is_number(r) }
  puts strings.last_index_func("go 123", f)
  puts strings.last_index_func("123 go", f)
  puts strings.last_index_func("go", f)
} outputs "5\n2\n-1\n"

example "Join" {
  s = ["foo", "bar", "baz"]
  puts strings.join(s, ", ")
} outputs "foo, bar, baz\n"

example "Repeat" {
  puts "ba" + strings.repeat("na", 2)
} outputs "banana\n"

example "Replace" {
  puts strings.replace("oink oink oink", "k", "ky", 2)
  puts strings.replace("oink oink oink", "oink", "moo", -1)
} outputs "oinky oinky oink\nmoo moo moo\n"

example "ReplaceAll" {
  puts strings.replace_all("oink oink oink", "oink", "moo")
} outputs "moo moo moo\n"

example "Split" {
  fmt.printf("%q\n", strings.split("a,b,c", ","))
  fmt.printf("%q\n", strings.split("a man a plan a canal panama", "a "))
  fmt.printf("%q\n", strings.split(" xyz ", ""))
  fmt.printf("%q\n", strings.split("", "Bernardo O'Higgins"))
} outputs <<~'EOS'
  ["a" "b" "c"]
  ["" "man " "plan " "canal panama"]
  [" " "x" "y" "z" " "]
  [""]
EOS

example "SplitN" {
  fmt.printf("%q\n", strings.split_n("a,b,c", ",", 2))
  z = strings.split_n("a,b,c", ",", 0)
  fmt.printf("%q (empty = %v)\n", z, z.size == 0)
} outputs "[\"a\" \"b,c\"]\n[] (empty = true)\n"

example "SplitAfter" {
  fmt.printf("%q\n", strings.split_after("a,b,c", ","))
} outputs "[\"a,\" \"b,\" \"c\"]\n"

example "SplitAfterN" {
  fmt.printf("%q\n", strings.split_after_n("a,b,c", ",", 2))
} outputs "[\"a,\" \"b,c\"]\n"

example "Title" {
  # Compare this example to the ToTitle example.
  puts strings.title("her royal highness")
  puts strings.title("loud noises")
  puts strings.title("брат")
} outputs "Her Royal Highness\nLoud Noises\nБрат\n"

example "ToTitle" {
  # Compare this example to the Title example.
  puts strings.to_title("her royal highness")
  puts strings.to_title("loud noises")
  puts strings.to_title("брат")
} outputs "HER ROYAL HIGHNESS\nLOUD NOISES\nБРАТ\n"

example "Map" {
  rot13 = ->(r: Rune) -> Rune {
    return 65 + (r - 65 + 13) % 26 if r >= 65 && r <= 90
    return 97 + (r - 97 + 13) % 26 if r >= 97 && r <= 122
    r
  }
  puts strings.map(rot13, "'Twas brillig and the slithy gopher...")
} outputs "'Gjnf oevyyvt naq gur fyvgul tbcure...\n"

example "NewReplacer" {
  r = strings.new_replacer(["<", "&lt;", ">", "&gt;"])
  puts r.replace("This is <b>HTML</b>!")
} outputs "This is &lt;b&gt;HTML&lt;/b&gt;!\n"

example "ToUpper" {
  puts strings.to_upper("Gopher")
} outputs "GOPHER\n"

example "ToLower" {
  puts strings.to_lower("Gopher")
} outputs "gopher\n"

example "Trim" {
  print strings.trim("¡¡¡Hello, Gophers!!!", "!¡")
} outputs "Hello, Gophers"

example "TrimSpace" {
  puts strings.trim_space(" \t\n Hello, Gophers \n\t\r\n")
} outputs "Hello, Gophers\n"

example "TrimPrefix" {
  s = "¡¡¡Hello, Gophers!!!"
  s = strings.trim_prefix(s, "¡¡¡Hello, ")
  s = strings.trim_prefix(s, "¡¡¡Howdy, ")
  print s
} outputs "Gophers!!!"

example "TrimSuffix" {
  s = "¡¡¡Hello, Gophers!!!"
  s = strings.trim_suffix(s, ", Gophers!!!")
  s = strings.trim_suffix(s, ", Marmots!!!")
  print s
} outputs "¡¡¡Hello"

example "TrimFunc" {
  print strings.trim_func("¡¡¡Hello, Gophers!!!", ->(r: Rune) -> Bool { !unicode.is_letter(r) && !unicode.is_number(r) })
} outputs "Hello, Gophers"

example "TrimLeft" {
  print strings.trim_left("¡¡¡Hello, Gophers!!!", "!¡")
} outputs "Hello, Gophers!!!"

example "TrimLeftFunc" {
  print strings.trim_left_func("¡¡¡Hello, Gophers!!!", ->(r: Rune) -> Bool { !unicode.is_letter(r) && !unicode.is_number(r) })
} outputs "Hello, Gophers!!!"

example "TrimRight" {
  print strings.trim_right("¡¡¡Hello, Gophers!!!", "!¡")
} outputs "¡¡¡Hello, Gophers"

example "TrimRightFunc" {
  print strings.trim_right_func("¡¡¡Hello, Gophers!!!", ->(r: Rune) -> Bool { !unicode.is_letter(r) && !unicode.is_number(r) })
} outputs "¡¡¡Hello, Gophers"

example "ToValidUTF8" {
  fmt.printf("%s\n", strings.to_valid_utf8("abc", "�"))
  fmt.printf("%s\n", strings.to_valid_utf8("a" + bs([0xff]) + "b" + bs([0xC0, 0xAF]) + "c" + bs([0xff]), ""))
  fmt.printf("%s\n", strings.to_valid_utf8(bs([0xed, 0xa0, 0x80]), "abc"))
} outputs "abc\nabc\nabc\n"

example "Lines" {
  text = "Hello\nWorld\nGo Programming\n"
  for line in strings.lines(text) {
    fmt.printf("%q\n", line)
  }
} outputs "\"Hello\\n\"\n\"World\\n\"\n\"Go Programming\\n\"\n"

example "SplitSeq" {
  s = "a,b,c,d"
  for part in strings.split_seq(s, ",") {
    fmt.printf("%q\n", part)
  }
} outputs "\"a\"\n\"b\"\n\"c\"\n\"d\"\n"

example "SplitAfterSeq" {
  s = "a,b,c,d"
  for part in strings.split_after_seq(s, ",") {
    fmt.printf("%q\n", part)
  }
} outputs "\"a,\"\n\"b,\"\n\"c,\"\n\"d\"\n"

example "FieldsSeq" {
  text = "The quick brown fox"
  puts "Split string into fields:"
  for word in strings.fields_seq(text) {
    fmt.printf("%q\n", word)
  }
  text_with_spaces = "  lots   of   spaces  "
  puts "\nSplit string with multiple spaces:"
  for word in strings.fields_seq(text_with_spaces) {
    fmt.printf("%q\n", word)
  }
} outputs <<~'EOS'
  Split string into fields:
  "The"
  "quick"
  "brown"
  "fox"

  Split string with multiple spaces:
  "lots"
  "of"
  "spaces"
EOS

example "FieldsFuncSeq" {
  text = "The quick brown fox"
  puts "Split on whitespace(similar to FieldsSeq):"
  for word in strings.fields_func_seq(text, ->(r: Rune) -> Bool { unicode.is_space(r) }) {
    fmt.printf("%q\n", word)
  }
  mixed_text = "abc123def456ghi"
  puts "\nSplit on digits:"
  for word in strings.fields_func_seq(mixed_text, ->(r: Rune) -> Bool { unicode.is_digit(r) }) {
    fmt.printf("%q\n", word)
  }
} outputs <<~'EOS'
  Split on whitespace(similar to FieldsSeq):
  "The"
  "quick"
  "brown"
  "fox"

  Split on digits:
  "abc"
  "def"
  "ghi"
EOS
