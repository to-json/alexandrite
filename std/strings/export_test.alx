# The Go tests that use export_test.go's hooks into private code, in-package:
# replace_test.go's TestPickAlgorithm and TestGenericTrieBuilding, and
# search_test.go (Boyer-Moore).

test "PickAlgorithm" {
  cases = [
    (new_replacer(["a", "A", "b", "B"]), "*strings.byteReplacer"),
    (new_replacer(["&", "&amp;", "<", "&lt;", ">", "&gt;", "\"", "&quot;", "'", "&apos;"]), "*strings.byteStringReplacer"),
    (new_replacer(["12", "123"]), "*strings.singleStringReplacer"),
    (new_replacer(["1", "12"]), "*strings.byteStringReplacer"),
    (new_replacer(["", "X"]), "*strings.genericReplacer"),
    (new_replacer(["a", "1", "b", "12", "cde", "123"]), "*strings.genericReplacer"),
  ]
  for c in cases {
    assert_eq c[0].algorithm, c[1]
  }
}

# Each line of a want: the key ending on that line is in the trie if it ends
# with "+".
test "GenericTrieBuilding" {
  cases = [
    ("abc;abdef;abdefgh;xx;xy;z", "-\na-\n.b-\n..c+\n..d-\n...ef+\n.....gh+\nx-\n.x+\n.y+\nz+\n"),
    ("abracadabra;abracadabrakazam;abraham;abrasion", "-\na-\n.bra-\n....c-\n.....adabra+\n...........kazam+\n....h-\n.....am+\n....s-\n.....ion+\n"),
    ("aaa;aa;a;i;longerst;longer;long;xx;x;X;Y", "-\nX+\nY+\na+\n.a+\n..a+\ni+\nl-\n.ong+\n....er+\n......st+\nx+\n.x+\n"),
    ("foo;;foo;foo1", "+\nf-\n.oo+\n...1+\n"),
  ]
  for c in cases {
    keys = split(c[0], ";")
    args: [Str] = []
    for k in keys {
      args << k
      args << ""
    }
    assert_eq new_replacer(args).print_trie, c[1]
  }
}

test "FinderNext" {
  cases = [
    ("", "", 0), ("", "abc", 0), ("abc", "", -1), ("abc", "abc", 0), ("d", "abcdefg", 3), ("nan", "banana", 2),
    ("pan", "anpanman", 2), ("nnaaman", "anpanmanam", -1), ("abcd", "abc", -1), ("abcd", "bcd", -1), ("bcd", "abcd", 1),
    ("abc", "acca", -1), ("aa", "aaa", 0), ("baa", "aaaaa", -1), ("at that", "which finally halts.  at that point", 22),
  ]
  for c in cases {
    assert_eq make_string_finder(c[0]).next(c[1]), c[2]
  }
}

# bad: the non-default bad_char_skip entries (byte, skip); every other byte
# skips the pattern size.
test "FinderCreation" {
  cases: [(Str, [(Int, Int)], [Int])] = [
    ("abc", [(97, 2), (98, 1), (99, 3)], [5, 4, 1]),
    ("mississi", [(105, 3), (109, 7), (115, 1)], [15, 14, 13, 7, 11, 10, 7, 1]),
    ("abcxxxabc", [(97, 2), (98, 1), (99, 6), (120, 3)], [14, 13, 12, 11, 10, 9, 11, 10, 1]),
    ("abyxcdeyx", [(97, 8), (98, 7), (99, 4), (100, 3), (101, 2), (121, 1), (120, 5)], [17, 16, 15, 14, 13, 12, 7, 10, 1]),
  ]
  for c in cases {
    f = make_string_finder(c[0])
    want: [Int] = [c[0].size; 256]
    for e in c[1] { want[e[0]] = e[1] }
    assert_eq f.bad_char_skip, want
    assert_eq f.good_suffix_skip, c[2]
  }
}
