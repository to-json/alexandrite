#![test(external)]
# Go's reader_test.go, translated. End of input is not an error here
# (GO-VS-RUBY F3): where Go expects io.EOF, read! returns 0 and read_at a
# short count.
#
# Not translated: TestReaderAtConcurrent and TestEmptyReaderConcurrent (race
# detector checks of Go's implementation), the benchmarks.

import "bytes"
import "io"
import "strings"

struct SeekCase {
  off: Int
  seek: Int
  n: Int
  want: Str
  wantpos: Int
  seekerr: Str
}

test "Reader" {
  r = strings.new_reader("0123456789")
  tests = [
    SeekCase.new(seek: io.SEEK_START, off: 0, n: 20, want: "0123456789"),
    SeekCase.new(seek: io.SEEK_START, off: 1, n: 1, want: "1"),
    SeekCase.new(seek: io.SEEK_CURRENT, off: 1, wantpos: 3, n: 2, want: "34"),
    SeekCase.new(seek: io.SEEK_START, off: -1, seekerr: "strings.Reader.seek!: negative position"),
    SeekCase.new(seek: io.SEEK_START, off: 1 << 33, wantpos: 1 << 33),
    SeekCase.new(seek: io.SEEK_CURRENT, off: 1, wantpos: (1 << 33) + 1),
    SeekCase.new(seek: io.SEEK_START, n: 5, want: "01234"),
    SeekCase.new(seek: io.SEEK_CURRENT, n: 5, want: "56789"),
    SeekCase.new(seek: io.SEEK_END, off: -1, n: 1, wantpos: 9, want: "9"),
  ]
  for tt in tests {
    res = r.seek!(tt.off, tt.seek)
    if e = res.err {
      assert_eq e.message, tt.seekerr
      next
    }
    assert tt.seekerr == "", "want seek error"
    assert_eq res.unwrap, tt.wantpos if tt.wantpos != 0
    buf: [Byte] = [0; tt.n]
    n = r.read!(buf)
    assert_eq Str.from_bytes(buf[0...n]), tt.want
  }
}

test "ReadAfterBigSeek" {
  r = strings.new_reader("0123456789")
  r.~seek!((1 << 31) + 5, io.SEEK_START)
  buf: [Byte] = [0; 10]
  assert_eq r.read!(buf), 0
}

test "ReaderAt" {
  r = strings.new_reader("0123456789")
  tests = [(0, 10, "0123456789", ""), (1, 10, "123456789", ""), (1, 9, "123456789", ""), (11, 10, "", ""), (0, 0, "", ""), (-1, 0, "", "strings.Reader.read_at: negative offset")]
  for tt in tests {
    b: [Byte] = [0; tt[1]]
    res = r.read_at(b, tt[0])
    if e = res.err {
      assert_eq e.message, tt[3]
      next
    }
    assert tt[3] == "", "want error #{tt[3]}"
    assert_eq Str.from_bytes(b[0...res.unwrap]), tt[2]
  }
}

test "WriteTo" {
  str = "0123456789"
  for i in 0..str.size {
    s = str[i...str.size]
    r = strings.new_reader(s)
    b = bytes.new_buffer([])
    assert_eq r.~write_to!(b), s.size
    assert_eq b.to_s, s
    assert_eq r.len, 0
  }
}

test "ReaderLenSize" {
  r = strings.new_reader("abc")
  io.~copy_n(io.Discard.new(), r, 1)
  assert_eq r.len, 2
  assert_eq r.size, 3
}

test "ReaderReset" {
  r = strings.new_reader("世界")
  assert r.read_rune!.some?, "read_rune"
  r.reset!("abcdef")
  assert !r.unread_rune!.ok?, "unread_rune after reset!: expected error"
  assert_eq Str.from_bytes(io.~read_all(r)), "abcdef"
}

test "ReaderZero" {
  assert_eq strings.Reader.new().len, 0
  e: [Byte] = []
  r = strings.Reader.new()
  assert_eq r.read!(e), 0
  assert_eq strings.Reader.new().~read_at(e, 11), 0
  r = strings.Reader.new()
  assert r.read_byte!.none?, "read_byte!"
  r = strings.Reader.new()
  assert r.read_rune!.none?, "read_rune!"
  r = strings.Reader.new()
  assert_eq r.~seek!(11, io.SEEK_START), 11
  assert_eq strings.Reader.new().size, 0
  r = strings.Reader.new()
  assert !r.unread_byte!.ok?, "unread_byte!: want error"
  r = strings.Reader.new()
  assert !r.unread_rune!.ok?, "unread_rune!: want error"
  r = strings.Reader.new()
  assert_eq r.~write_to!(io.Discard.new()), 0
}

test "ReaderErrorTexts" {
  r = strings.new_reader("ab")
  assert_eq r.unread_byte!.err.unwrap.message, "strings.Reader.unread_byte!: at beginning of string"
  assert_eq r.unread_rune!.err.unwrap.message, "strings.Reader.unread_rune!: at beginning of string"
  r.read_byte!
  assert_eq r.unread_rune!.err.unwrap.message, "strings.Reader.unread_rune!: previous operation was not read_rune!"
  assert_eq r.seek!(0, 7).err.unwrap.message, "strings.Reader.seek!: invalid whence"
}
