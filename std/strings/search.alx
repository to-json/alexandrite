# Go's stringFinder (search.go): Boyer-Moore search for one pattern, used by
# the single-string Replacer. Private, as in Go.

struct StringFinder {
  # The string being searched for.
  pattern: Str
  # bad_char_skip[b]: how far the pattern can shift when the text byte b
  # doesn't match (the distance from b's last occurrence, excluding the last
  # pattern byte, to the end; the pattern size if b doesn't occur).
  bad_char_skip: [Int]
  # good_suffix_skip[i]: how far the pattern can shift when pattern[i] fails
  # to match after pattern[i+1...] did.
  good_suffix_skip: [Int]

  # The index of the first instance of the pattern in text, or -1.
  def next(text: Str) -> Int {
    m = pattern.size
    i = m - 1
    while i < text.size {
      j = m - 1
      while j >= 0 && text[i] == pattern[j] {
        i -= 1
        j -= 1
      }
      return i + 1 if j < 0
      a = bad_char_skip[text[i].to_i]
      b = good_suffix_skip[j]
      i += a > b ? a : b
    }
    -1
  }
}

def make_string_finder(pattern: Str) -> StringFinder {
  m = pattern.size
  bad: [Int] = [m; 256]
  good: [Int] = [0; m]
  last = m - 1
  i = 0
  while i < last {
    bad[pattern[i].to_i] = last - i
    i += 1
  }
  # First pass: a mismatch at i after the suffix pattern[i+1...] matched
  # shifts to the last prefix of the pattern that is also that suffix.
  last_prefix = last
  i = last
  while i >= 0 {
    last_prefix = i + 1 if has_prefix(pattern, pattern[i + 1...m])
    good[i] = last_prefix + last - i
    i -= 1
  }
  # Second pass: find repeats of the pattern's suffix starting from the front.
  i = 0
  while i < last {
    len_suffix = longest_common_suffix(pattern, pattern[1...i + 1])
    if pattern[i - len_suffix] != pattern[last - len_suffix] {
      good[last - len_suffix] = len_suffix + last - i
    }
    i += 1
  }
  StringFinder.new(pattern: pattern, bad_char_skip: bad, good_suffix_skip: good)
}

def longest_common_suffix(a: Str, b: Str) -> Int {
  i = 0
  while i < a.size && i < b.size {
    break if a[a.size - 1 - i] != b[b.size - 1 - i]
    i += 1
  }
  i
}
