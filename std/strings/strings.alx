# Package strings: Go's strings, with alx idioms (S2).
#
#   Go                                        alx
#   Compare / Contains / ContainsAny          compare / contains / contains_any
#   ContainsRune / ContainsFunc               contains_rune / contains_func
#   Count / Clone                             count / clone
#   Cut(s, sep) (before, after, found)        cut(s, sep) -> (Str, Str)?
#   CutLast(s, sep)                           cut_last(s, sep) -> (Str, Str)?
#   CutPrefix / CutSuffix (s, bool)           cut_prefix / cut_suffix -> Str?
#   EqualFold / HasPrefix / HasSuffix         equal_fold / has_prefix / has_suffix
#   Index / IndexAny / IndexByte              index / index_any / index_byte
#   IndexFunc / IndexRune                     index_func / index_rune
#   LastIndex / LastIndexAny / LastIndexByte  last_index / last_index_any / last_index_byte
#   LastIndexFunc                             last_index_func
#   Fields / FieldsFunc                       fields / fields_func
#   Split / SplitN / SplitAfter / SplitAfterN split / split_n / split_after / split_after_n
#   Lines / SplitSeq / SplitAfterSeq          lines / split_seq / split_after_seq -> [Str]
#   FieldsSeq / FieldsFuncSeq                 fields_seq / fields_func_seq -> [Str]
#   Join / Repeat / Map                       join / repeat / map(mapping, s)
#   Replace / ReplaceAll                      replace / replace_all
#   ToUpper / ToLower / ToTitle / Title       to_upper / to_lower / to_title / title
#   ToUpperSpecial(c, s) ...                  to_upper_special(c, s) / to_lower_special / to_title_special
#   ToValidUTF8                               to_valid_utf8
#   Trim / TrimLeft / TrimRight               trim / trim_left / trim_right
#   TrimFunc / TrimLeftFunc / TrimRightFunc   trim_func / trim_left_func / trim_right_func
#   TrimPrefix / TrimSuffix / TrimSpace       trim_prefix / trim_suffix / trim_space
#   Builder (builder.alx)                     Builder.new / new_builder; write!, write_string!,
#                                             write_byte!, write_rune!, string (to_s), len (size),
#                                             cap, grow!, reset!
#   Reader (reader.alx), NewReader            Reader, new_reader(s); read!, read_at, read_byte!,
#                                             unread_byte!, read_rune!, unread_rune!, seek!,
#                                             write_to!, reset!, len, size
#   Replacer (replace.alx), NewReplacer       Replacer, new_replacer([old, new, ...]);
#                                             replace(s), write_string(w, s)
#
# Conventions and differences from Go (GO-VS-RUBY S2):
#  - Strings are immutable UTF-8 byte strings; every index and size is in
#    BYTES, as in Go. "Not found" for the index family stays Go's -1 (an Int):
#    S2 only rewrites (T, bool) and (T, error) pairs, and -1 keeps ported code
#    one-to-one (`if i >= 0`).
#  - (T, bool) pairs become options: cut and cut_last return `(Str, Str)?`
#    (before, after), cut_prefix / cut_suffix return `Str?`. Where Go returns
#    (s, "", false), alx returns none.
#  - Runes are `Rune` (I32), bytes are `Byte` (U8). Invalid UTF-8 decodes as
#    U+FFFD with width 1, as in Go; functions that rebuild a string rune by
#    rune (map, to_upper/to_lower on non-ASCII input, to_title, title, the
#    *_special functions) write U+FFFD for each invalid byte, as Go's Map does.
#  - Case mapping and folding are unicode's (simple mappings over all of
#    Unicode, as Go). The *_special functions take any value with Go's
#    SpecialCase methods (to_upper/to_lower/to_title on a Rune); std/unicode
#    has no SpecialCase tables yet, so there is no TurkishCase to pass.
#  - Go's iterator functions (Lines, SplitSeq, SplitAfterSeq, FieldsSeq,
#    FieldsFuncSeq) return slices (alx has no iter.Seq); the elements are the
#    ones Go's iterator yields.
#  - split is Go's: an empty separator splits into UTF-8 sequences, and empty
#    pieces are kept ("a,," -> ["a", "", ""], "" -> [""]). The builtin
#    `Str#split` is Ruby's (panics on an empty separator, drops trailing
#    empty pieces). Builtin methods win over method sugar, so `s.split(x)` is
#    the builtin; call `strings.split(s, x)` for Go's. split_n(s, sep, 0)
#    returns an empty slice (Go: nil).
#  - repeat panics like Go's, with alx names in the message ("strings:
#    negative repeat count", "strings: repeat output length overflow"); a
#    result too large to allocate panics with "... out of range".
#  - Builder: copies share the same buffer (D36), so Go's copy check (a
#    panic when a copied non-zero Builder is written) doesn't exist; cap is
#    the length (no capacity primitive yet) and grow! only validates n.
#  - Reader / Replacer: see their files. End of input is not an error
#    (GO-VS-RUBY F3): reads return 0 or none at the end.
#  - Building is linear: everything that assembles a string goes through a
#    byte buffer (Builder), never repeated concatenation.
#
# Not translated from Go's tests: the allocation counts (AllocsPerRun),
# unsafe.StringData identity checks (Clone, Map's no-copy case), the
# concurrency race-detector tests of Reader, the benchmarks, and the
# Turkish TestSpecialCase / ExampleTo*Special (no unicode.TurkishCase; the
# *_special functions are tested with a Turkish SpecialCase built in the test).

import "unicode"

# ---------------------------------------------------------------- UTF-8 core
# Private helpers. A decoded rune is packed into one Int as `rune * 8 + width`
# (no tuples yet), so decoding allocates nothing.

BAD = 0xFFFD * 8 + 1

def is_cont(b: Int) -> Bool { b >= 0x80 && b <= 0xBF }

# Decode the rune starting at byte i (i < s.size).
def dec(s: Str, i: Int) -> Int {
  n = s.size
  b0 = s[i].to_i
  return b0 * 8 + 1 if b0 < 0x80
  return BAD if b0 < 0xC2 || b0 > 0xF4
  return BAD if i + 1 >= n
  b1 = s[i + 1].to_i
  if b0 < 0xE0 {
    return BAD if !is_cont(b1)
    return (((b0 & 0x1F) << 6) | (b1 & 0x3F)) * 8 + 2
  }
  lo = 0x80
  hi = 0xBF
  if b0 == 0xE0 { lo = 0xA0 }
  if b0 == 0xED { hi = 0x9F }
  if b0 == 0xF0 { lo = 0x90 }
  if b0 == 0xF4 { hi = 0x8F }
  return BAD if b1 < lo || b1 > hi
  return BAD if i + 2 >= n
  b2 = s[i + 2].to_i
  return BAD if !is_cont(b2)
  if b0 < 0xF0 {
    return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)) * 8 + 3
  }
  return BAD if i + 3 >= n
  b3 = s[i + 3].to_i
  return BAD if !is_cont(b3)
  (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)) * 8 + 4
}

# Decode the rune ending just before byte e (e > 0).
def dec_last(s: Str, e: Int) -> Int {
  start = e - 1
  b = s[start].to_i
  return b * 8 + 1 if b < 0x80
  lim = e - 4
  lim = 0 if lim < 0
  start -= 1
  while start >= lim {
    break if !is_cont(s[start].to_i)
    start -= 1
  }
  start = lim if start < lim
  v = dec(s, start)
  return BAD if start + (v & 7) != e
  v
}

def valid_rune(c: Int) -> Bool { c >= 0 && c <= 0x10FFFF && !(c >= 0xD800 && c <= 0xDFFF) }

def rune_count(s: Str) -> Int {
  n = s.size
  i = 0
  c = 0
  while i < n {
    i += dec(s, i) & 7
    c += 1
  }
  c
}

def is_space_rune(r: Int) -> Bool {
  if r < 0x100 { return r == 32 || (r >= 9 && r <= 13) || r == 0x85 || r == 0xA0 }
  r == 0x1680 || (r >= 0x2000 && r <= 0x200A) || r == 0x2028 || r == 0x2029 || r == 0x202F || r == 0x205F || r == 0x3000
}

# The UTF-8 encoding of rune value c (invalid values become U+FFFD).
def rune_str(c: Int) -> Str {
  b = Builder.new
  b.put_rune!(c)
  b.to_s
}

# ------------------------------------------------------------------- search

# Whether s[i...] begins with sub (caller ensures i + sub.size <= s.size).
def match_at(s: Str, i: Int, sub: Str) -> Bool {
  m = sub.size
  j = 0
  while j < m {
    return false if s[i + j] != sub[j]
    j += 1
  }
  true
}

# First index >= start where sub occurs, or -1.
def index_from(s: Str, sub: Str, start: Int) -> Int {
  m = sub.size
  return start if m == 0
  first = sub[0]
  last = s.size - m
  i = start
  while i <= last {
    return i if s[i] == first && match_at(s, i, sub)
    i += 1
  }
  -1
}

# Whether s begins with prefix.
pub def has_prefix(s: Str, prefix: Str) -> Bool {
  s.size >= prefix.size && match_at(s, 0, prefix)
}

# Whether s ends with suffix.
pub def has_suffix(s: Str, suffix: Str) -> Bool {
  s.size >= suffix.size && match_at(s, s.size - suffix.size, suffix)
}

# Index of the first instance of substr in s, or -1.
pub def index(s: Str, substr: Str) -> Int { index_from(s, substr, 0) }

# Index of the last instance of substr in s, or -1.
pub def last_index(s: Str, substr: Str) -> Int {
  m = substr.size
  return s.size if m == 0
  i = s.size - m
  while i >= 0 {
    return i if s[i] == substr[0] && match_at(s, i, substr)
    i -= 1
  }
  -1
}

# Index of the first byte c in s, or -1.
pub def index_byte(s: Str, c: Byte) -> Int {
  i = 0
  n = s.size
  while i < n {
    return i if s[i] == c
    i += 1
  }
  -1
}

# Index of the last byte c in s, or -1.
pub def last_index_byte(s: Str, c: Byte) -> Int {
  i = s.size - 1
  while i >= 0 {
    return i if s[i] == c
    i -= 1
  }
  -1
}

# Index of the first instance of the rune r, or -1. U+FFFD also matches
# invalid UTF-8 bytes (Go); an invalid rune value matches nothing.
pub def index_rune(s: Str, r: Rune) -> Int {
  c = r.to_i
  return index_byte(s, c.as_u8) if c >= 0 && c < 0x80
  n = s.size
  if c == 0xFFFD {
    i = 0
    while i < n {
      v = dec(s, i)
      return i if (v >> 3) == 0xFFFD
      i += v & 7
    }
    return -1
  }
  return -1 if !valid_rune(c)
  index(s, rune_str(c))
}

# Index of the first rune of s for which f is true, or -1.
pub def index_func(s: Str, f: (Rune) -> Bool) -> Int {
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    return i if f((v >> 3).as_i32)
    i += v & 7
  }
  -1
}

# Index of the last rune of s for which f is true, or -1.
pub def last_index_func(s: Str, f: (Rune) -> Bool) -> Int {
  e = s.size
  while e > 0 {
    v = dec_last(s, e)
    e -= v & 7
    return e if f((v >> 3).as_i32)
  }
  -1
}

# Index of the first rune of s that is in chars, or -1.
pub def index_any(s: Str, chars: Str) -> Int {
  return -1 if chars.size == 0
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    return i if index_rune(chars, (v >> 3).as_i32) >= 0
    i += v & 7
  }
  -1
}

# Index of the last rune of s that is in chars, or -1.
pub def last_index_any(s: Str, chars: Str) -> Int {
  return -1 if chars.size == 0
  e = s.size
  while e > 0 {
    v = dec_last(s, e)
    e -= v & 7
    return e if index_rune(chars, (v >> 3).as_i32) >= 0
  }
  -1
}

pub def contains(s: Str, substr: Str) -> Bool { index(s, substr) >= 0 }
pub def contains_any(s: Str, chars: Str) -> Bool { index_any(s, chars) >= 0 }
pub def contains_rune(s: Str, r: Rune) -> Bool { index_rune(s, r) >= 0 }
pub def contains_func(s: Str, f: (Rune) -> Bool) -> Bool { index_func(s, f) >= 0 }

# Number of non-overlapping instances of substr in s; with an empty substr,
# the number of runes plus one.
pub def count(s: Str, substr: Str) -> Int {
  return rune_count(s) + 1 if substr.size == 0
  c = 0
  i = 0
  loop {
    j = index_from(s, substr, i)
    break if j < 0
    c += 1
    i = j + substr.size
  }
  c
}

# Three-way comparison: -1, 0 or +1 (bytewise).
pub def compare(a: Str, b: Str) -> Int {
  return 0 if a == b
  a < b ? -1 : 1
}

# A copy of s (Go's Clone: Strs are immutable values, so this is s itself
# with fresh storage).
pub def clone(s: Str) -> Str {
  return "" if s.size == 0
  Str.from_bytes(s.bytes.to_a)
}

# Slices s around the first instance of sep: the text before and after it;
# none if sep is absent.
pub def cut(s: Str, sep: Str) -> (Str, Str)? {
  i = index(s, sep)
  return none if i < 0
  (s[0...i], s[i + sep.size...s.size])
}

# Slices s around the last instance of sep: the text before and after it;
# none if sep is absent.
pub def cut_last(s: Str, sep: Str) -> (Str, Str)? {
  i = last_index(s, sep)
  return none if i < 0
  (s[0...i], s[i + sep.size...s.size])
}

# s without the leading prefix; none if s doesn't start with it.
pub def cut_prefix(s: Str, prefix: Str) -> Str? {
  return none if !has_prefix(s, prefix)
  s[prefix.size...s.size]
}

# s without the trailing suffix; none if s doesn't end with it.
pub def cut_suffix(s: Str, suffix: Str) -> Str? {
  return none if !has_suffix(s, suffix)
  s[0...s.size - suffix.size]
}

# Whether s and t are equal under simple Unicode case folding (Go's
# EqualFold, the same algorithm).
pub def equal_fold(s: Str, t: Str) -> Bool {
  i = 0
  j = 0
  while i < s.size {
    return false if j >= t.size
    a = dec(s, i)
    b = dec(t, j)
    i += a & 7
    j += b & 7
    sr = a >> 3
    tr = b >> 3
    next if sr == tr
    if tr < sr {
      x = tr
      tr = sr
      sr = x
    }
    if tr < 0x80 {
      next if sr >= 65 && sr <= 90 && tr == sr + 32
      return false
    }
    r = unicode.simple_fold(sr.as_i32).to_i
    while r != sr && r < tr {
      r = unicode.simple_fold(r.as_i32).to_i
    }
    return false if r != tr
  }
  j == t.size
}

# ---------------------------------------------------------------- splitting

# Go's explode: s split into at most n UTF-8 sequences (n < 0: all).
def explode(s: Str, n: Int) -> [Str] {
  out: [Str] = []
  size = s.size
  i = 0
  while i < size {
    if n > 0 && out.size == n - 1 {
      out << s[i...size]
      return out
    }
    w = dec(s, i) & 7
    out << s[i...i + w]
    i += w
  }
  out
}

def gen_split(s: Str, sep: Str, save: Int, n: Int) -> [Str] {
  out: [Str] = []
  return out if n == 0
  return explode(s, n) if sep.size == 0
  start = 0
  loop {
    break if n > 0 && out.size >= n - 1
    j = index_from(s, sep, start)
    break if j < 0
    out << s[start...j + save]
    start = j + sep.size
  }
  out << s[start...s.size]
  out
}

# Splits s around every instance of sep. An empty sep splits into UTF-8
# sequences.
pub def split(s: Str, sep: Str) -> [Str] { gen_split(s, sep, 0, -1) }
# Like split, but keeps sep at the end of each piece.
pub def split_after(s: Str, sep: Str) -> [Str] { gen_split(s, sep, sep.size, -1) }
# At most n pieces (n < 0: all; n == 0: none); the last holds the remainder.
pub def split_n(s: Str, sep: Str, n: Int) -> [Str] { gen_split(s, sep, 0, n) }
pub def split_after_n(s: Str, sep: Str, n: Int) -> [Str] { gen_split(s, sep, sep.size, n) }

# Go's SplitSeq / SplitAfterSeq, as slices: the same pieces as split /
# split_after.
pub def split_seq(s: Str, sep: Str) -> [Str] { gen_split(s, sep, 0, -1) }
pub def split_after_seq(s: Str, sep: Str) -> [Str] { gen_split(s, sep, sep.size, -1) }

# The newline-terminated lines of s, each with its "\n"; the last one has
# none if s doesn't end in a newline. No lines for an empty s (Go's Lines).
pub def lines(s: Str) -> [Str] {
  out: [Str] = []
  n = s.size
  i = 0
  while i < n {
    j = index_from_byte(s, 10, i)
    if j < 0 {
      out << s[i...n]
      break
    }
    out << s[i...j + 1]
    i = j + 1
  }
  out
}

def index_from_byte(s: Str, c: Byte, start: Int) -> Int {
  i = start
  n = s.size
  while i < n {
    return i if s[i] == c
    i += 1
  }
  -1
}

# Splits s around runs of runes for which f is true; no empty pieces.
pub def fields_func(s: Str, f: (Rune) -> Bool) -> [Str] {
  out: [Str] = []
  n = s.size
  start = -1
  i = 0
  while i < n {
    v = dec(s, i)
    if f((v >> 3).as_i32) {
      if start >= 0 {
        out << s[start...i]
        start = -1
      }
    } else if start < 0 {
      start = i
    }
    i += v & 7
  }
  out << s[start...n] if start >= 0
  out
}

# Splits s around runs of Unicode white space; no empty pieces.
pub def fields(s: Str) -> [Str] {
  out: [Str] = []
  n = s.size
  start = -1
  i = 0
  while i < n {
    v = dec(s, i)
    if is_space_rune(v >> 3) {
      if start >= 0 {
        out << s[start...i]
        start = -1
      }
    } else if start < 0 {
      start = i
    }
    i += v & 7
  }
  out << s[start...n] if start >= 0
  out
}

# Go's FieldsSeq / FieldsFuncSeq, as slices.
pub def fields_seq(s: Str) -> [Str] { fields(s) }
pub def fields_func_seq(s: Str, f: (Rune) -> Bool) -> [Str] { fields_func(s, f) }

# Concatenates elems with sep between them.
pub def join(elems: [Str], sep: Str) -> Str {
  return "" if elems.size == 0
  return elems[0] if elems.size == 1
  b = Builder.new
  i = 0
  while i < elems.size {
    b.put_str!(sep, 0, sep.size) if i > 0
    b.put_str!(elems[i], 0, elems[i].size)
    i += 1
  }
  b.to_s
}

# The largest result repeat builds (a larger one can't be allocated; Go's
# makeslice panics with "len out of range").
REPEAT_MAX = 1 << 48

# s repeated count times. Panics if count is negative or the result's length
# overflows an Int.
pub def repeat(s: Str, count: Int) -> Str {
  return "" if count == 0
  return s if count == 1
  panic "strings: negative repeat count" if count < 0
  panic "strings: repeat output length overflow" if s.size > 0 && count > 0x7FFF_FFFF_FFFF_FFFF / s.size
  n = s.size * count
  return "" if n == 0
  panic "strings: repeat output length out of range" if n > REPEAT_MAX
  buf: [Byte] = [0; n]
  m = copy(buf, s.bytes)
  while m < n {
    m += copy(buf[m...n], buf[0...m])
  }
  Str.from_bytes(buf)
}

# ---------------------------------------------------------------- replacing

# s with the first n non-overlapping instances of old replaced by new
# (n < 0: all). An empty old matches before every rune and at the end.
pub def replace(s: Str, old: Str, new: Str, n: Int) -> Str {
  return s if old == new || n == 0
  m = count(s, old)
  return s if m == 0
  limit = n
  limit = m if n < 0 || m < n
  b = Builder.new
  start = 0
  k = 0
  while k < limit {
    j = start
    if old.size == 0 {
      j += dec(s, start) & 7 if k > 0
    } else {
      j = index_from(s, old, start)
    }
    b.put_str!(s, start, j)
    b.put_str!(new, 0, new.size)
    start = j + old.size
    k += 1
  }
  b.put_str!(s, start, s.size)
  b.to_s
}

pub def replace_all(s: Str, old: Str, new: Str) -> Str { replace(s, old, new, -1) }

# Whether map(f, s) can return s as it is: f keeps every rune and s has no
# invalid UTF-8 (Go's Map rewrites each invalid byte as f(U+FFFD)).
def maps_to_itself(s: Str, f: (Rune) -> Rune) -> Bool {
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    return false if v == BAD
    c = v >> 3
    return false if f(c.as_i32).to_i != c
    i += v & 7
  }
  true
}

# s with every rune mapped through mapping; runes mapped to a negative value
# are dropped. Invalid UTF-8 bytes reach mapping as U+FFFD.
pub def map(mapping: (Rune) -> Rune, s: Str) -> Str {
  b = Builder.new
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    m = mapping((v >> 3).as_i32).to_i
    b.put_rune!(m) if m >= 0
    i += v & 7
  }
  b.to_s
}

# s with each run of invalid UTF-8 bytes replaced by replacement.
pub def to_valid_utf8(s: Str, replacement: Str) -> Str {
  b = Builder.new
  n = s.size
  i = 0
  bad = false
  while i < n {
    v = dec(s, i)
    w = v & 7
    if v == BAD {
      b.put_str!(replacement, 0, replacement.size) if !bad
      bad = true
    } else {
      b.put_str!(s, i, i + w)
      bad = false
    }
    i += w
  }
  b.to_s
}

# ------------------------------------------------------------------- case

# The ASCII-only case change of s (up or down), or none if s has a byte
# >= 0x80.
def ascii_case(s: Str, up: Bool) -> Str? {
  n = s.size
  work = false
  i = 0
  while i < n {
    c = s[i].to_i
    return none if c >= 0x80
    work = true if up && c >= 97 && c <= 122
    work = true if !up && c >= 65 && c <= 90
    i += 1
  }
  return s if !work
  out: [Byte] = [0; n]
  i = 0
  while i < n {
    c = s[i]
    if up && c >= 97 && c <= 122 {
      c -= 32
    } else if !up && c >= 65 && c <= 90 {
      c += 32
    }
    out[i] = c
    i += 1
  }
  Str.from_bytes(out)
}

# s with every rune mapped by f, or s itself when nothing changes (Go's Map,
# for the case functions).
def map_runes(s: Str, f: (Rune) -> Rune) -> Str {
  return s if maps_to_itself(s, f)
  map(f, s)
}

# s with all Unicode letters mapped to their upper case.
pub def to_upper(s: Str) -> Str {
  if a = ascii_case(s, true) { return a }
  map_runes(s, ->(r: Rune) -> Rune { unicode.to_upper(r) })
}

# s with all Unicode letters mapped to their lower case.
pub def to_lower(s: Str) -> Str {
  if a = ascii_case(s, false) { return a }
  map_runes(s, ->(r: Rune) -> Rune { unicode.to_lower(r) })
}

# s with all Unicode letters mapped to their title case.
pub def to_title(s: Str) -> Str { map_runes(s, ->(r: Rune) -> Rune { unicode.to_title(r) }) }

# Go's ToUpperSpecial / ToLowerSpecial / ToTitleSpecial: c is a special-case
# mapping (Go's unicode.SpecialCase): anything with to_upper / to_lower /
# to_title methods from Rune to Rune.
pub def to_upper_special[C](c: C, s: Str) -> Str { map_runes(s, ->(r: Rune) -> Rune { c.to_upper(r) }) }
pub def to_lower_special[C](c: C, s: Str) -> Str { map_runes(s, ->(r: Rune) -> Rune { c.to_lower(r) }) }
pub def to_title_special[C](c: C, s: Str) -> Str { map_runes(s, ->(r: Rune) -> Rune { c.to_title(r) }) }

# Whether r could mark a word boundary (Go's isSeparator, for title).
def is_separator(r: Int) -> Bool {
  if r <= 0x7F {
    return false if r >= 48 && r <= 57
    return false if r >= 97 && r <= 122
    return false if r >= 65 && r <= 90
    return false if r == 95
    return true
  }
  rr = r.as_i32
  return false if unicode.is_letter(rr) || unicode.is_digit(rr)
  unicode.is_space(rr)
}

# s with the letters that begin words mapped to title case (Go's deprecated
# Title: a word starts after a separator, see is_separator).
pub def title(s: Str) -> Str {
  n = s.size
  prev = 32
  changed = false
  i = 0
  while i < n {
    v = dec(s, i)
    c = v >> 3
    if v == BAD || (is_separator(prev) && unicode.to_title(c.as_i32).to_i != c) {
      changed = true
      break
    }
    prev = c
    i += v & 7
  }
  return s if !changed
  b = Builder.new
  prev = 32
  i = 0
  while i < n {
    v = dec(s, i)
    c = v >> 3
    if is_separator(prev) {
      b.put_rune!(unicode.to_title(c.as_i32).to_i)
    } else {
      b.put_rune!(c)
    }
    prev = c
    i += v & 7
  }
  b.to_s
}

# ------------------------------------------------------------------ trimming

# s without leading runes for which f is true.
pub def trim_left_func(s: Str, f: (Rune) -> Bool) -> Str {
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    break if !f((v >> 3).as_i32)
    i += v & 7
  }
  return s if i == 0
  s[i...n]
}

# s without trailing runes for which f is true.
pub def trim_right_func(s: Str, f: (Rune) -> Bool) -> Str {
  e = s.size
  while e > 0 {
    v = dec_last(s, e)
    break if !f((v >> 3).as_i32)
    e -= v & 7
  }
  return s if e == s.size
  s[0...e]
}

pub def trim_func(s: Str, f: (Rune) -> Bool) -> Str { trim_right_func(trim_left_func(s, f), f) }

# s without any leading runes contained in cutset.
pub def trim_left(s: Str, cutset: Str) -> Str {
  return s if s.size == 0 || cutset.size == 0
  trim_left_func(s, ->(r: Rune) -> Bool { index_rune(cutset, r) >= 0 })
}

# s without any trailing runes contained in cutset.
pub def trim_right(s: Str, cutset: Str) -> Str {
  return s if s.size == 0 || cutset.size == 0
  trim_right_func(s, ->(r: Rune) -> Bool { index_rune(cutset, r) >= 0 })
}

# s without any leading or trailing runes contained in cutset.
pub def trim(s: Str, cutset: Str) -> Str {
  return s if s.size == 0 || cutset.size == 0
  trim_right(trim_left(s, cutset), cutset)
}

# s without the leading prefix, if present.
pub def trim_prefix(s: Str, prefix: Str) -> Str {
  return s if !has_prefix(s, prefix)
  s[prefix.size...s.size]
}

# s without the trailing suffix, if present.
pub def trim_suffix(s: Str, suffix: Str) -> Str {
  return s if !has_suffix(s, suffix)
  s[0...s.size - suffix.size]
}

# s without leading and trailing Unicode white space.
pub def trim_space(s: Str) -> Str {
  n = s.size
  i = 0
  while i < n {
    v = dec(s, i)
    break if !is_space_rune(v >> 3)
    i += v & 7
  }
  e = n
  while e > i {
    v = dec_last(s, e)
    break if !is_space_rune(v >> 3)
    e -= v & 7
  }
  return s if i == 0 && e == n
  s[i...e]
}
