#![test(external)]
# Go's strings_test.go tables, translated: the rows are Go's, copied by a
# generator; the expected values are the tables', not computed. The helpers
# (check_split, ...) are in strings_go_test.alx.

import "strings"
import "unicode"

test "Lines" {
  assert_eq strings.lines("abc\nabc\n"), ["abc\n", "abc\n"]
  assert_eq strings.lines("abc\r\nabc"), ["abc\r\n", "abc"]
  assert_eq strings.lines("abc\r\n"), ["abc\r\n"]
  assert_eq strings.lines("\nabc"), ["\n", "abc"]
  assert_eq strings.lines("\nabc\n\n"), ["\n", "abc\n", "\n"]
}

test "Index" {
  assert_eq strings.index("", ""), 0
  assert_eq strings.index("", "a"), -1
  assert_eq strings.index("", "foo"), -1
  assert_eq strings.index("fo", "foo"), -1
  assert_eq strings.index("foo", "foo"), 0
  assert_eq strings.index("oofofoofooo", "f"), 2
  assert_eq strings.index("oofofoofooo", "foo"), 4
  assert_eq strings.index("barfoobarfoo", "foo"), 3
  assert_eq strings.index("foo", ""), 0
  assert_eq strings.index("foo", "o"), 1
  assert_eq strings.index("abcABCabc", "A"), 3
  assert_eq strings.index("jrzm6jjhorimglljrea4w3rlgosts0w2gia17hno2td4qd1jz", "jz"), 47
  assert_eq strings.index("ekkuk5oft4eq0ocpacknhwouic1uua46unx12l37nioq9wbpnocqks6", "ks6"), 52
  assert_eq strings.index("999f2xmimunbuyew5vrkla9cpwhmxan8o98ec", "98ec"), 33
  assert_eq strings.index("9lpt9r98i04k8bz6c6dsrthb96bhi", "96bhi"), 24
  assert_eq strings.index("55u558eqfaod2r2gu42xxsu631xf0zobs5840vl", "5840vl"), 33
  assert_eq strings.index("", "a"), -1
  assert_eq strings.index("x", "a"), -1
  assert_eq strings.index("x", "x"), 0
  assert_eq strings.index("abc", "a"), 0
  assert_eq strings.index("abc", "b"), 1
  assert_eq strings.index("abc", "c"), 2
  assert_eq strings.index("abc", "x"), -1
  assert_eq strings.index("", "ab"), -1
  assert_eq strings.index("bc", "ab"), -1
  assert_eq strings.index("ab", "ab"), 0
  assert_eq strings.index("xab", "ab"), 1
  assert_eq strings.index("xa", "ab"), -1
  assert_eq strings.index("", "abc"), -1
  assert_eq strings.index("xbc", "abc"), -1
  assert_eq strings.index("abc", "abc"), 0
  assert_eq strings.index("xabc", "abc"), 1
  assert_eq strings.index("xab", "abc"), -1
  assert_eq strings.index("xabxc", "abc"), -1
  assert_eq strings.index("", "abcd"), -1
  assert_eq strings.index("xbcd", "abcd"), -1
  assert_eq strings.index("abcd", "abcd"), 0
  assert_eq strings.index("xabcd", "abcd"), 1
  assert_eq strings.index("xyabc", "abcd"), -1
  assert_eq strings.index("xbcqq", "abcqq"), -1
  assert_eq strings.index("abcqq", "abcqq"), 0
  assert_eq strings.index("xabcqq", "abcqq"), 1
  assert_eq strings.index("xyabcq", "abcqq"), -1
  assert_eq strings.index("xabxcqq", "abcqq"), -1
  assert_eq strings.index("xabcqxq", "abcqq"), -1
  assert_eq strings.index("", "01234567"), -1
  assert_eq strings.index("32145678", "01234567"), -1
  assert_eq strings.index("01234567", "01234567"), 0
  assert_eq strings.index("x01234567", "01234567"), 1
  assert_eq strings.index("x0123456x01234567", "01234567"), 9
  assert_eq strings.index("xx0123456", "01234567"), -1
  assert_eq strings.index("", "0123456789"), -1
  assert_eq strings.index("3214567844", "0123456789"), -1
  assert_eq strings.index("0123456789", "0123456789"), 0
  assert_eq strings.index("x0123456789", "0123456789"), 1
  assert_eq strings.index("x012345678x0123456789", "0123456789"), 11
  assert_eq strings.index("xyz012345678", "0123456789"), -1
  assert_eq strings.index("x01234567x89", "0123456789"), -1
  assert_eq strings.index("", "0123456789012345"), -1
  assert_eq strings.index("3214567889012345", "0123456789012345"), -1
  assert_eq strings.index("0123456789012345", "0123456789012345"), 0
  assert_eq strings.index("x0123456789012345", "0123456789012345"), 1
  assert_eq strings.index("x012345678901234x0123456789012345", "0123456789012345"), 17
  assert_eq strings.index("", "01234567890123456789"), -1
  assert_eq strings.index("32145678890123456789", "01234567890123456789"), -1
  assert_eq strings.index("01234567890123456789", "01234567890123456789"), 0
  assert_eq strings.index("x01234567890123456789", "01234567890123456789"), 1
  assert_eq strings.index("x0123456789012345678x01234567890123456789", "01234567890123456789"), 21
  assert_eq strings.index("xyz0123456789012345678", "01234567890123456789"), -1
  assert_eq strings.index("", "0123456789012345678901234567890"), -1
  assert_eq strings.index("321456788901234567890123456789012345678911", "0123456789012345678901234567890"), -1
  assert_eq strings.index("0123456789012345678901234567890", "0123456789012345678901234567890"), 0
  assert_eq strings.index("x0123456789012345678901234567890", "0123456789012345678901234567890"), 1
  assert_eq strings.index("x012345678901234567890123456789x0123456789012345678901234567890", "0123456789012345678901234567890"), 32
  assert_eq strings.index("xyz012345678901234567890123456789", "0123456789012345678901234567890"), -1
  assert_eq strings.index("", "01234567890123456789012345678901"), -1
  assert_eq strings.index("32145678890123456789012345678901234567890211", "01234567890123456789012345678901"), -1
  assert_eq strings.index("01234567890123456789012345678901", "01234567890123456789012345678901"), 0
  assert_eq strings.index("x01234567890123456789012345678901", "01234567890123456789012345678901"), 1
  assert_eq strings.index("x0123456789012345678901234567890x01234567890123456789012345678901", "01234567890123456789012345678901"), 33
  assert_eq strings.index("xyz0123456789012345678901234567890", "01234567890123456789012345678901"), -1
  assert_eq strings.index("xxxxxx012345678901234567890123456789012345678901234567890123456789012", "012345678901234567890123456789012345678901234567890123456789012"), 6
  assert_eq strings.index("", "0123456789012345678901234567890123456789"), -1
  assert_eq strings.index("xx012345678901234567890123456789012345678901234567890123456789012", "0123456789012345678901234567890123456789"), 2
  assert_eq strings.index("xx012345678901234567890123456789012345678", "0123456789012345678901234567890123456789"), -1
  assert_eq strings.index("xx012345678901234567890123456789012345678901234567890123456789012", "0123456789012345678901234567890123456xxx"), -1
  assert_eq strings.index("xx0123456789012345678901234567890123456789012345678901234567890120123456789012345678901234567890123456xxx", "0123456789012345678901234567890123456xxx"), 65
  assert_eq strings.index("oxoxoxoxoxoxoxoxoxoxoxoy", "oy"), 22
  assert_eq strings.index("oxoxoxoxoxoxoxoxoxoxoxox", "oy"), -1
  assert_eq strings.index("oxoxoxoxoxoxoxoxoxoxox☺", "☺"), 22
  assert_eq strings.index("xx0123456789012345678901234567890123456789012345678901234567890120123456789012345678901234567890123456xxx" + bs([0xed, 0x9f, 0xc0]), bs([0xed, 0x9f, 0xc0])), 105
}

test "LastIndex" {
  assert_eq strings.last_index("", ""), 0
  assert_eq strings.last_index("", "a"), -1
  assert_eq strings.last_index("", "foo"), -1
  assert_eq strings.last_index("fo", "foo"), -1
  assert_eq strings.last_index("foo", "foo"), 0
  assert_eq strings.last_index("foo", "f"), 0
  assert_eq strings.last_index("oofofoofooo", "f"), 7
  assert_eq strings.last_index("oofofoofooo", "foo"), 7
  assert_eq strings.last_index("barfoobarfoo", "foo"), 9
  assert_eq strings.last_index("foo", ""), 3
  assert_eq strings.last_index("foo", "o"), 2
  assert_eq strings.last_index("abcABCabc", "A"), 3
  assert_eq strings.last_index("abcABCabc", "a"), 6
}

test "IndexAny" {
  assert_eq strings.index_any("", ""), -1
  assert_eq strings.index_any("", "a"), -1
  assert_eq strings.index_any("", "abc"), -1
  assert_eq strings.index_any("a", ""), -1
  assert_eq strings.index_any("a", "a"), 0
  assert_eq strings.index_any(bs([0x80]), bs([0xff]) + "b"), 0
  assert_eq strings.index_any("aaa", "a"), 0
  assert_eq strings.index_any("abc", "xyz"), -1
  assert_eq strings.index_any("abc", "xcz"), 2
  assert_eq strings.index_any("ab☺c", "x☺yz"), 2
  assert_eq strings.index_any("a☺b☻c☹d", "cx"), 8
  assert_eq strings.index_any("a☺b☻c☹d", "uvw☻xyz"), 5
  assert_eq strings.index_any("aRegExp*", ".(|)*+?^$[]"), 7
  assert_eq strings.index_any("1....2....3....41....2....3....41....2....3....4", " "), -1
  assert_eq strings.index_any("012abcba210", bs([0xff]) + "b"), 4
  assert_eq strings.index_any("012" + bs([0x80]) + "bcb" + bs([0x80]) + "210", bs([0xff]) + "b"), 3
  assert_eq strings.index_any("0123456πabc", bs([0xcf]) + "b" + bs([0x80])), 10
}

test "LastIndexAny" {
  assert_eq strings.last_index_any("", ""), -1
  assert_eq strings.last_index_any("", "a"), -1
  assert_eq strings.last_index_any("", "abc"), -1
  assert_eq strings.last_index_any("a", ""), -1
  assert_eq strings.last_index_any("a", "a"), 0
  assert_eq strings.last_index_any(bs([0x80]), bs([0xff]) + "b"), 0
  assert_eq strings.last_index_any("aaa", "a"), 2
  assert_eq strings.last_index_any("abc", "xyz"), -1
  assert_eq strings.last_index_any("abc", "ab"), 1
  assert_eq strings.last_index_any("ab☺c", "x☺yz"), 2
  assert_eq strings.last_index_any("a☺b☻c☹d", "cx"), 8
  assert_eq strings.last_index_any("a☺b☻c☹d", "uvw☻xyz"), 5
  assert_eq strings.last_index_any("a.RegExp*", ".(|)*+?^$[]"), 8
  assert_eq strings.last_index_any("1....2....3....41....2....3....41....2....3....4", " "), -1
  assert_eq strings.last_index_any("012abcba210", bs([0xff]) + "b"), 6
  assert_eq strings.last_index_any("012" + bs([0x80]) + "bcb" + bs([0x80]) + "210", bs([0xff]) + "b"), 7
  assert_eq strings.last_index_any("0123456πabc", bs([0xcf]) + "b" + bs([0x80])), 10
}

test "IndexByte" {
  assert_eq strings.index_byte("", 97), -1
  assert_eq strings.index_byte("oofofoofooo", 102), 2
  assert_eq strings.index_byte("foo", 111), 1
  assert_eq strings.index_byte("abcABCabc", 65), 3
  assert_eq strings.index_byte("", 97), -1
  assert_eq strings.index_byte("x", 97), -1
  assert_eq strings.index_byte("x", 120), 0
  assert_eq strings.index_byte("abc", 97), 0
  assert_eq strings.index_byte("abc", 98), 1
  assert_eq strings.index_byte("abc", 99), 2
  assert_eq strings.index_byte("abc", 120), -1
}

test "Split" {
  check_split("", "", -1, no_strs())
  check_split("abcd", "", 2, ["a", "bcd"])
  check_split("abcd", "", 4, ["a", "b", "c", "d"])
  check_split("abcd", "", -1, ["a", "b", "c", "d"])
  check_split("☺☻☹", "", -1, ["☺", "☻", "☹"])
  check_split("☺☻☹", "", 3, ["☺", "☻", "☹"])
  check_split("☺☻☹", "", 17, ["☺", "☻", "☹"])
  check_split("☺�☹", "", -1, ["☺", "�", "☹"])
  check_split("abcd", "a", 0, no_strs())
  check_split("abcd", "a", -1, ["", "bcd"])
  check_split("abcd", "z", -1, ["abcd"])
  check_split("1,2,3,4", ",", -1, ["1", "2", "3", "4"])
  check_split("1....2....3....4", "...", -1, ["1", ".2", ".3", ".4"])
  check_split("☺☻☹", "☹", -1, ["☺☻", ""])
  check_split("☺☻☹", "~", -1, ["☺☻☹"])
  check_split("1 2 3 4", " ", 3, ["1", "2", "3 4"])
  check_split("1 2", " ", 3, ["1", "2"])
  check_split("", "T", 0x1FFF_FFFF_FFFF_FFFF, [""])
  check_split(bs([0xff]) + "-" + bs([0xff]), "", -1, [bs([0xff]), "-", bs([0xff])])
  check_split(bs([0xff]) + "-" + bs([0xff]), "-", -1, [bs([0xff]), bs([0xff])])
}

test "SplitAfter" {
  check_split_after("abcd", "a", -1, ["a", "bcd"])
  check_split_after("abcd", "z", -1, ["abcd"])
  check_split_after("abcd", "", -1, ["a", "b", "c", "d"])
  check_split_after("1,2,3,4", ",", -1, ["1,", "2,", "3,", "4"])
  check_split_after("1....2....3....4", "...", -1, ["1...", ".2...", ".3...", ".4"])
  check_split_after("☺☻☹", "☹", -1, ["☺☻☹", ""])
  check_split_after("☺☻☹", "~", -1, ["☺☻☹"])
  check_split_after("☺☻☹", "", -1, ["☺", "☻", "☹"])
  check_split_after("1 2 3 4", " ", 3, ["1 ", "2 ", "3 4"])
  check_split_after("1 2 3", " ", 3, ["1 ", "2 ", "3"])
  check_split_after("1 2", " ", 3, ["1 ", "2"])
  check_split_after("123", "", 2, ["1", "23"])
  check_split_after("123", "", 17, ["1", "2", "3"])
}

test "Fields" {
  check_fields("", no_strs())
  check_fields(" ", no_strs())
  check_fields(" \t ", no_strs())
  check_fields("\u2000", no_strs())
  check_fields("  abc  ", ["abc"])
  check_fields("1 2 3 4", ["1", "2", "3", "4"])
  check_fields("1  2  3  4", ["1", "2", "3", "4"])
  check_fields("1\t\t2\t\t3\t4", ["1", "2", "3", "4"])
  check_fields("1\u20002\u20013\u20024", ["1", "2", "3", "4"])
  check_fields("\u2000\u2001\u2002", no_strs())
  check_fields("\n™\t™\n", ["™", "™"])
  check_fields("\n\u20001™2\u2000 \u2001 ™", ["1™2", "™"])
  check_fields("\n1� �2\u20003�4", ["1�", "�2", "3�4"])
  check_fields("1" + bs([0xff]) + "\u2000" + bs([0xff]) + "2" + bs([0xff]) + " " + bs([0xff]), ["1" + bs([0xff]), bs([0xff]) + "2" + bs([0xff]), bs([0xff])])
  check_fields("☺☻☹", ["☺☻☹"])
}

test "FieldsFunc" {
  assert_eq strings.fields_func("", ->(r: Rune) -> Bool { unicode.is_space(r) }), no_strs()
  assert_eq strings.fields_func(" ", ->(r: Rune) -> Bool { unicode.is_space(r) }), no_strs()
  assert_eq strings.fields_func(" \t ", ->(r: Rune) -> Bool { unicode.is_space(r) }), no_strs()
  assert_eq strings.fields_func("\u2000", ->(r: Rune) -> Bool { unicode.is_space(r) }), no_strs()
  assert_eq strings.fields_func("  abc  ", ->(r: Rune) -> Bool { unicode.is_space(r) }), ["abc"]
  assert_eq strings.fields_func("1 2 3 4", ->(r: Rune) -> Bool { unicode.is_space(r) }), ["1", "2", "3", "4"]
  assert_eq strings.fields_func("1  2  3  4", ->(r: Rune) -> Bool { unicode.is_space(r) }), ["1", "2", "3", "4"]
  assert_eq strings.fields_func("1\t\t2\t\t3\t4", ->(r: Rune) -> Bool { unicode.is_space(r) }), ["1", "2", "3", "4"]
  assert_eq strings.fields_func("1\u20002\u20013\u20024", ->(r: Rune) -> Bool { unicode.is_space(r) }), ["1", "2", "3", "4"]
  assert_eq strings.fields_func("\u2000\u2001\u2002", ->(r: Rune) -> Bool { unicode.is_space(r) }), no_strs()
  assert_eq strings.fields_func("\n™\t™\n", ->(r: Rune) -> Bool { unicode.is_space(r) }), ["™", "™"]
  assert_eq strings.fields_func("\n\u20001™2\u2000 \u2001 ™", ->(r: Rune) -> Bool { unicode.is_space(r) }), ["1™2", "™"]
  assert_eq strings.fields_func("\n1� �2\u20003�4", ->(r: Rune) -> Bool { unicode.is_space(r) }), ["1�", "�2", "3�4"]
  assert_eq strings.fields_func("1" + bs([0xff]) + "\u2000" + bs([0xff]) + "2" + bs([0xff]) + " " + bs([0xff]), ->(r: Rune) -> Bool { unicode.is_space(r) }), ["1" + bs([0xff]), bs([0xff]) + "2" + bs([0xff]), bs([0xff])]
  assert_eq strings.fields_func("☺☻☹", ->(r: Rune) -> Bool { unicode.is_space(r) }), ["☺☻☹"]
  assert_eq strings.fields_func("", ->(r: Rune) -> Bool { r == 88 }), no_strs()
  assert_eq strings.fields_func_seq("", ->(r: Rune) -> Bool { r == 88 }), no_strs()
  assert_eq strings.fields_func("XX", ->(r: Rune) -> Bool { r == 88 }), no_strs()
  assert_eq strings.fields_func_seq("XX", ->(r: Rune) -> Bool { r == 88 }), no_strs()
  assert_eq strings.fields_func("XXhiXXX", ->(r: Rune) -> Bool { r == 88 }), ["hi"]
  assert_eq strings.fields_func_seq("XXhiXXX", ->(r: Rune) -> Bool { r == 88 }), ["hi"]
  assert_eq strings.fields_func("aXXbXXXcX", ->(r: Rune) -> Bool { r == 88 }), ["a", "b", "c"]
  assert_eq strings.fields_func_seq("aXXbXXXcX", ->(r: Rune) -> Bool { r == 88 }), ["a", "b", "c"]
}

test "ToUpper" {
  assert_eq strings.to_upper(""), ""
  assert_eq strings.to_upper("ONLYUPPER"), "ONLYUPPER"
  assert_eq strings.to_upper("abc"), "ABC"
  assert_eq strings.to_upper("AbC123"), "ABC123"
  assert_eq strings.to_upper("azAZ09_"), "AZAZ09_"
  assert_eq strings.to_upper("longStrinGwitHmixofsmaLLandcAps"), "LONGSTRINGWITHMIXOFSMALLANDCAPS"
  assert_eq strings.to_upper("RENAN BASTOS 93 AOSDAJDJAIDJAIDAJIaidsjjaidijadsjiadjiOOKKO"), "RENAN BASTOS 93 AOSDAJDJAIDJAIDAJIAIDSJJAIDIJADSJIADJIOOKKO"
  assert_eq strings.to_upper("longɐstringɐwithɐnonasciiⱯchars"), "LONGⱯSTRINGⱯWITHⱯNONASCIIⱯCHARS"
  assert_eq strings.to_upper("ɐɐɐɐɐ"), "ⱯⱯⱯⱯⱯ"
  assert_eq strings.to_upper("a\u0080\U0010FFFF"), "A\u0080\U0010FFFF"
}

test "ToLower" {
  assert_eq strings.to_lower(""), ""
  assert_eq strings.to_lower("abc"), "abc"
  assert_eq strings.to_lower("AbC123"), "abc123"
  assert_eq strings.to_lower("azAZ09_"), "azaz09_"
  assert_eq strings.to_lower("longStrinGwitHmixofsmaLLandcAps"), "longstringwithmixofsmallandcaps"
  assert_eq strings.to_lower("renan bastos 93 AOSDAJDJAIDJAIDAJIaidsjjaidijadsjiadjiOOKKO"), "renan bastos 93 aosdajdjaidjaidajiaidsjjaidijadsjiadjiookko"
  assert_eq strings.to_lower("LONGⱯSTRINGⱯWITHⱯNONASCIIⱯCHARS"), "longɐstringɐwithɐnonasciiɐchars"
  assert_eq strings.to_lower("ⱭⱭⱭⱭⱭ"), "ɑɑɑɑɑ"
  assert_eq strings.to_lower("A\u0080\U0010FFFF"), "a\u0080\U0010FFFF"
}

test "TrimSpace" {
  assert_eq strings.trim_space(""), ""
  assert_eq strings.trim_space("abc"), "abc"
  assert_eq strings.trim_space("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000abc\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000"), "abc"
  assert_eq strings.trim_space(" "), ""
  assert_eq strings.trim_space(" \t\r\n \t\t\r\r\n\n "), ""
  assert_eq strings.trim_space(" \t\r\n x\t\t\r\r\n\n "), "x"
  assert_eq strings.trim_space(" \u2000\t\r\n x\t\t\r\r\ny\n \u3000"), "x\t\t\r\r\ny"
  assert_eq strings.trim_space("1 \t\r\n2"), "1 \t\r\n2"
  assert_eq strings.trim_space(" x" + bs([0x80])), "x" + bs([0x80])
  assert_eq strings.trim_space(" x" + bs([0xc0])), "x" + bs([0xc0])
  assert_eq strings.trim_space("x " + bs([0xc0, 0xc0]) + " "), "x " + bs([0xc0, 0xc0])
  assert_eq strings.trim_space("x " + bs([0xc0])), "x " + bs([0xc0])
  assert_eq strings.trim_space("x " + bs([0xc0]) + " "), "x " + bs([0xc0])
  assert_eq strings.trim_space("x " + bs([0xc0, 0xc0]) + " "), "x " + bs([0xc0, 0xc0])
  assert_eq strings.trim_space("x ☺" + bs([0xc0, 0xc0]) + " "), "x ☺" + bs([0xc0, 0xc0])
  assert_eq strings.trim_space("x ☺ "), "x ☺"
}

test "ToValidUTF8" {
  assert_eq strings.to_valid_utf8("", "�"), ""
  assert_eq strings.to_valid_utf8("abc", "�"), "abc"
  assert_eq strings.to_valid_utf8("\uFDDD", "�"), "\uFDDD"
  assert_eq strings.to_valid_utf8("a" + bs([0xff]) + "b", "�"), "a�b"
  assert_eq strings.to_valid_utf8("a" + bs([0xff]) + "b�", "X"), "aXb�"
  assert_eq strings.to_valid_utf8("a☺" + bs([0xff]) + "b☺" + bs([0xc0, 0xaf]) + "c☺" + bs([0xff]), ""), "a☺b☺c☺"
  assert_eq strings.to_valid_utf8("a☺" + bs([0xff]) + "b☺" + bs([0xc0, 0xaf]) + "c☺" + bs([0xff]), "日本語"), "a☺日本語b☺日本語c☺日本語"
  assert_eq strings.to_valid_utf8(bs([0xc0, 0xaf]), "�"), "�"
  assert_eq strings.to_valid_utf8(bs([0xe0, 0x80, 0xaf]), "�"), "�"
  assert_eq strings.to_valid_utf8(bs([0xed, 0xa0, 0x80]), "abc"), "abc"
  assert_eq strings.to_valid_utf8(bs([0xed, 0xbf, 0xbf]), "�"), "�"
  assert_eq strings.to_valid_utf8(bs([0xf0, 0x80, 0x80, 0xaf]), "☺"), "☺"
  assert_eq strings.to_valid_utf8(bs([0xf8, 0x80, 0x80, 0x80, 0xaf]), "�"), "�"
  assert_eq strings.to_valid_utf8(bs([0xfc, 0x80, 0x80, 0x80, 0x80, 0xaf]), "�"), "�"
}

test "Trim" {
  assert_eq strings.trim("abba", "a"), "bb"
  assert_eq strings.trim("abba", "ab"), ""
  assert_eq strings.trim_left("abba", "ab"), ""
  assert_eq strings.trim_right("abba", "ab"), ""
  assert_eq strings.trim_left("abba", "a"), "bba"
  assert_eq strings.trim_left("abba", "b"), "abba"
  assert_eq strings.trim_right("abba", "a"), "abb"
  assert_eq strings.trim_right("abba", "b"), "abba"
  assert_eq strings.trim("<tag>", "<>"), "tag"
  assert_eq strings.trim("* listitem", " *"), "listitem"
  assert_eq strings.trim("\"quote\"", "\""), "quote"
  assert_eq strings.trim("ⱯⱯɐɐⱯⱯ", "Ɐ"), "ɐɐ"
  assert_eq strings.trim(bs([0x80]) + "test" + bs([0xff]), bs([0xff])), "test"
  assert_eq strings.trim(" Ġ ", " "), "Ġ"
  assert_eq strings.trim(" Ġİ0", "0 "), "Ġİ"
  assert_eq strings.trim("abba", ""), "abba"
  assert_eq strings.trim("", "123"), ""
  assert_eq strings.trim("", ""), ""
  assert_eq strings.trim_left("abba", ""), "abba"
  assert_eq strings.trim_left("", "123"), ""
  assert_eq strings.trim_left("", ""), ""
  assert_eq strings.trim_right("abba", ""), "abba"
  assert_eq strings.trim_right("", "123"), ""
  assert_eq strings.trim_right("", ""), ""
  assert_eq strings.trim_right("☺" + bs([0xc0]), "☺"), "☺" + bs([0xc0])
  assert_eq strings.trim_prefix("aabb", "a"), "abb"
  assert_eq strings.trim_prefix("aabb", "b"), "aabb"
  assert_eq strings.trim_suffix("aabb", "a"), "aabb"
  assert_eq strings.trim_suffix("aabb", "b"), "aab"
}

test "TrimFunc" {
  assert_eq strings.trim_func("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000 hello \t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000", is_space_p), "hello"
  assert_eq strings.trim_left_func("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000 hello \t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000", is_space_p), "hello \t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000"
  assert_eq strings.trim_right_func("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000 hello \t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000", is_space_p), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000 hello"
  assert_eq strings.trim_func("๐๒12hello34๐๑", is_digit_p), "hello"
  assert_eq strings.trim_left_func("๐๒12hello34๐๑", is_digit_p), "hello34๐๑"
  assert_eq strings.trim_right_func("๐๒12hello34๐๑", is_digit_p), "๐๒12hello"
  assert_eq strings.trim_func("ⱯⱯⱯⱯABCDhelloEFⱯⱯGHⱯⱯ", is_upper_p), "hello"
  assert_eq strings.trim_left_func("ⱯⱯⱯⱯABCDhelloEFⱯⱯGHⱯⱯ", is_upper_p), "helloEFⱯⱯGHⱯⱯ"
  assert_eq strings.trim_right_func("ⱯⱯⱯⱯABCDhelloEFⱯⱯGHⱯⱯ", is_upper_p), "ⱯⱯⱯⱯABCDhello"
  assert_eq strings.trim_func("hello\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000hello", not_is_space_p), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000"
  assert_eq strings.trim_left_func("hello\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000hello", not_is_space_p), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000hello"
  assert_eq strings.trim_right_func("hello\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000hello", not_is_space_p), "hello\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000"
  assert_eq strings.trim_func("hello๐๒1234๐๑helo", not_is_digit_p), "๐๒1234๐๑"
  assert_eq strings.trim_left_func("hello๐๒1234๐๑helo", not_is_digit_p), "๐๒1234๐๑helo"
  assert_eq strings.trim_right_func("hello๐๒1234๐๑helo", not_is_digit_p), "hello๐๒1234๐๑"
  assert_eq strings.trim_func("ab" + bs([0xc0]) + "a" + bs([0xc0]) + "cd", is_valid_rune_p), bs([0xc0]) + "a" + bs([0xc0])
  assert_eq strings.trim_left_func("ab" + bs([0xc0]) + "a" + bs([0xc0]) + "cd", is_valid_rune_p), bs([0xc0]) + "a" + bs([0xc0]) + "cd"
  assert_eq strings.trim_right_func("ab" + bs([0xc0]) + "a" + bs([0xc0]) + "cd", is_valid_rune_p), "ab" + bs([0xc0]) + "a" + bs([0xc0])
  assert_eq strings.trim_func(bs([0xc0]) + "a" + bs([0xc0]), not_is_valid_rune_p), "a"
  assert_eq strings.trim_left_func(bs([0xc0]) + "a" + bs([0xc0]), not_is_valid_rune_p), "a" + bs([0xc0])
  assert_eq strings.trim_right_func(bs([0xc0]) + "a" + bs([0xc0]), not_is_valid_rune_p), bs([0xc0]) + "a"
  assert_eq strings.trim_func("", is_space_p), ""
  assert_eq strings.trim_left_func("", is_space_p), ""
  assert_eq strings.trim_right_func("", is_space_p), ""
  assert_eq strings.trim_func(" ", is_space_p), ""
  assert_eq strings.trim_left_func(" ", is_space_p), ""
  assert_eq strings.trim_right_func(" ", is_space_p), ""
}

test "IndexFunc" {
  assert_eq strings.index_func("", is_valid_rune_p), -1
  assert_eq strings.last_index_func("", is_valid_rune_p), -1
  assert_eq strings.index_func("abc", is_digit_p), -1
  assert_eq strings.last_index_func("abc", is_digit_p), -1
  assert_eq strings.index_func("0123", is_digit_p), 0
  assert_eq strings.last_index_func("0123", is_digit_p), 3
  assert_eq strings.index_func("a1b", is_digit_p), 1
  assert_eq strings.last_index_func("a1b", is_digit_p), 1
  assert_eq strings.index_func("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000", is_space_p), 0
  assert_eq strings.last_index_func("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000", is_space_p), 12
  assert_eq strings.index_func("๐๒12hello34๐๑", is_digit_p), 0
  assert_eq strings.last_index_func("๐๒12hello34๐๑", is_digit_p), 18
  assert_eq strings.index_func("ⱯⱯⱯⱯABCDhelloEFⱯⱯGHⱯⱯ", is_upper_p), 0
  assert_eq strings.last_index_func("ⱯⱯⱯⱯABCDhelloEFⱯⱯGHⱯⱯ", is_upper_p), 34
  assert_eq strings.index_func("12๐๒hello34๐๑", not_is_digit_p), 8
  assert_eq strings.last_index_func("12๐๒hello34๐๑", not_is_digit_p), 12
  assert_eq strings.index_func(bs([0x80]) + "1", is_digit_p), 1
  assert_eq strings.last_index_func(bs([0x80]) + "1", is_digit_p), 1
  assert_eq strings.index_func(bs([0x80]) + "abc", is_digit_p), -1
  assert_eq strings.last_index_func(bs([0x80]) + "abc", is_digit_p), -1
  assert_eq strings.index_func(bs([0xc0]) + "a" + bs([0xc0]), is_valid_rune_p), 1
  assert_eq strings.last_index_func(bs([0xc0]) + "a" + bs([0xc0]), is_valid_rune_p), 1
  assert_eq strings.index_func(bs([0xc0]) + "a" + bs([0xc0]), not_is_valid_rune_p), 0
  assert_eq strings.last_index_func(bs([0xc0]) + "a" + bs([0xc0]), not_is_valid_rune_p), 2
  assert_eq strings.index_func(bs([0xc0]) + "☺" + bs([0xc0]), not_is_valid_rune_p), 0
  assert_eq strings.last_index_func(bs([0xc0]) + "☺" + bs([0xc0]), not_is_valid_rune_p), 4
  assert_eq strings.index_func(bs([0xc0]) + "☺" + bs([0xc0, 0xc0]), not_is_valid_rune_p), 0
  assert_eq strings.last_index_func(bs([0xc0]) + "☺" + bs([0xc0, 0xc0]), not_is_valid_rune_p), 5
  assert_eq strings.index_func("ab" + bs([0xc0]) + "a" + bs([0xc0]) + "cd", not_is_valid_rune_p), 2
  assert_eq strings.last_index_func("ab" + bs([0xc0]) + "a" + bs([0xc0]) + "cd", not_is_valid_rune_p), 4
  assert_eq strings.index_func("a" + bs([0xe0, 0x80]) + "cd", not_is_valid_rune_p), 1
  assert_eq strings.last_index_func("a" + bs([0xe0, 0x80]) + "cd", not_is_valid_rune_p), 2
  assert_eq strings.index_func(bs([0x80, 0x80, 0x80, 0x80]), not_is_valid_rune_p), 0
  assert_eq strings.last_index_func(bs([0x80, 0x80, 0x80, 0x80]), not_is_valid_rune_p), 3
}

test "Replace" {
  assert_eq strings.replace("hello", "l", "L", 0), "hello"
  assert_eq strings.replace("hello", "l", "L", -1), "heLLo"
  assert_eq strings.replace_all("hello", "l", "L"), "heLLo"
  assert_eq strings.replace("hello", "x", "X", -1), "hello"
  assert_eq strings.replace_all("hello", "x", "X"), "hello"
  assert_eq strings.replace("", "x", "X", -1), ""
  assert_eq strings.replace_all("", "x", "X"), ""
  assert_eq strings.replace("radar", "r", "<r>", -1), "<r>ada<r>"
  assert_eq strings.replace_all("radar", "r", "<r>"), "<r>ada<r>"
  assert_eq strings.replace("", "", "<>", -1), "<>"
  assert_eq strings.replace_all("", "", "<>"), "<>"
  assert_eq strings.replace("banana", "a", "<>", -1), "b<>n<>n<>"
  assert_eq strings.replace_all("banana", "a", "<>"), "b<>n<>n<>"
  assert_eq strings.replace("banana", "a", "<>", 1), "b<>nana"
  assert_eq strings.replace("banana", "a", "<>", 1000), "b<>n<>n<>"
  assert_eq strings.replace("banana", "an", "<>", -1), "b<><>a"
  assert_eq strings.replace_all("banana", "an", "<>"), "b<><>a"
  assert_eq strings.replace("banana", "ana", "<>", -1), "b<>na"
  assert_eq strings.replace_all("banana", "ana", "<>"), "b<>na"
  assert_eq strings.replace("banana", "", "<>", -1), "<>b<>a<>n<>a<>n<>a<>"
  assert_eq strings.replace_all("banana", "", "<>"), "<>b<>a<>n<>a<>n<>a<>"
  assert_eq strings.replace("banana", "", "<>", 10), "<>b<>a<>n<>a<>n<>a<>"
  assert_eq strings.replace("banana", "", "<>", 6), "<>b<>a<>n<>a<>n<>a"
  assert_eq strings.replace("banana", "", "<>", 5), "<>b<>a<>n<>a<>na"
  assert_eq strings.replace("banana", "", "<>", 1), "<>banana"
  assert_eq strings.replace("banana", "a", "a", -1), "banana"
  assert_eq strings.replace_all("banana", "a", "a"), "banana"
  assert_eq strings.replace("banana", "a", "a", 1), "banana"
  assert_eq strings.replace("☺☻☹", "", "<>", -1), "<>☺<>☻<>☹<>"
  assert_eq strings.replace_all("☺☻☹", "", "<>"), "<>☺<>☻<>☹<>"
}

test "Title" {
  assert_eq strings.title(""), ""
  assert_eq strings.title("a"), "A"
  assert_eq strings.title(" aaa aaa aaa "), " Aaa Aaa Aaa "
  assert_eq strings.title(" Aaa Aaa Aaa "), " Aaa Aaa Aaa "
  assert_eq strings.title("123a456"), "123a456"
  assert_eq strings.title("double-blind"), "Double-Blind"
  assert_eq strings.title("ÿøû"), "Ÿøû"
  assert_eq strings.title("with_underscore"), "With_underscore"
  assert_eq strings.title("unicode \u2028 line separator"), "Unicode \u2028 Line Separator"
}

test "Contains" {
  assert_eq strings.contains("abc", "bc"), true
  assert_eq strings.contains("abc", "bcd"), false
  assert_eq strings.contains("abc", ""), true
  assert_eq strings.contains("", "a"), false
  assert_eq strings.contains("xxxxxx", "01"), false
  assert_eq strings.contains("01xxxx", "01"), true
  assert_eq strings.contains("xx01xx", "01"), true
  assert_eq strings.contains("xxxx01", "01"), true
  assert_eq strings.contains("1xxxxx", "01"), false
  assert_eq strings.contains("xxxxx0", "01"), false
  assert_eq strings.contains("xxxxxxx", "012"), false
  assert_eq strings.contains("012xxxx", "012"), true
  assert_eq strings.contains("xx012xx", "012"), true
  assert_eq strings.contains("xxxx012", "012"), true
  assert_eq strings.contains("12xxxxx", "012"), false
  assert_eq strings.contains("xxxxx01", "012"), false
  assert_eq strings.contains("xxxxxxxx", "0123"), false
  assert_eq strings.contains("0123xxxx", "0123"), true
  assert_eq strings.contains("xx0123xx", "0123"), true
  assert_eq strings.contains("xxxx0123", "0123"), true
  assert_eq strings.contains("123xxxxx", "0123"), false
  assert_eq strings.contains("xxxxx012", "0123"), false
  assert_eq strings.contains("xxxxxxxxx", "01234"), false
  assert_eq strings.contains("01234xxxx", "01234"), true
  assert_eq strings.contains("xx01234xx", "01234"), true
  assert_eq strings.contains("xxxx01234", "01234"), true
  assert_eq strings.contains("1234xxxxx", "01234"), false
  assert_eq strings.contains("xxxxx0123", "01234"), false
  assert_eq strings.contains("xxxxxxxxxxxx", "01234567"), false
  assert_eq strings.contains("01234567xxxx", "01234567"), true
  assert_eq strings.contains("xx01234567xx", "01234567"), true
  assert_eq strings.contains("xxxx01234567", "01234567"), true
  assert_eq strings.contains("1234567xxxxx", "01234567"), false
  assert_eq strings.contains("xxxxx0123456", "01234567"), false
  assert_eq strings.contains("xxxxxxxxxxxxx", "012345678"), false
  assert_eq strings.contains("012345678xxxx", "012345678"), true
  assert_eq strings.contains("xx012345678xx", "012345678"), true
  assert_eq strings.contains("xxxx012345678", "012345678"), true
  assert_eq strings.contains("12345678xxxxx", "012345678"), false
  assert_eq strings.contains("xxxxx01234567", "012345678"), false
  assert_eq strings.contains("xxxxxxxxxxxxxxxxxxxx", "0123456789ABCDEF"), false
  assert_eq strings.contains("0123456789ABCDEFxxxx", "0123456789ABCDEF"), true
  assert_eq strings.contains("xx0123456789ABCDEFxx", "0123456789ABCDEF"), true
  assert_eq strings.contains("xxxx0123456789ABCDEF", "0123456789ABCDEF"), true
  assert_eq strings.contains("123456789ABCDEFxxxxx", "0123456789ABCDEF"), false
  assert_eq strings.contains("xxxxx0123456789ABCDE", "0123456789ABCDEF"), false
  assert_eq strings.contains("xxxxxxxxxxxxxxxxxxxxx", "0123456789ABCDEFG"), false
  assert_eq strings.contains("0123456789ABCDEFGxxxx", "0123456789ABCDEFG"), true
  assert_eq strings.contains("xx0123456789ABCDEFGxx", "0123456789ABCDEFG"), true
  assert_eq strings.contains("xxxx0123456789ABCDEFG", "0123456789ABCDEFG"), true
  assert_eq strings.contains("123456789ABCDEFGxxxxx", "0123456789ABCDEFG"), false
  assert_eq strings.contains("xxxxx0123456789ABCDEF", "0123456789ABCDEFG"), false
  assert_eq strings.contains("xx01x", "012"), false
  assert_eq strings.contains("xx0123x", "01234"), false
  assert_eq strings.contains("xx01234567x", "012345678"), false
  assert_eq strings.contains("xx0123456789ABCDEFx", "0123456789ABCDEFG"), false
}

test "ContainsAny" {
  assert_eq strings.contains_any("", ""), false
  assert_eq strings.contains_any("", "a"), false
  assert_eq strings.contains_any("", "abc"), false
  assert_eq strings.contains_any("a", ""), false
  assert_eq strings.contains_any("a", "a"), true
  assert_eq strings.contains_any("aaa", "a"), true
  assert_eq strings.contains_any("abc", "xyz"), false
  assert_eq strings.contains_any("abc", "xcz"), true
  assert_eq strings.contains_any("a☺b☻c☹d", "uvw☻xyz"), true
  assert_eq strings.contains_any("aRegExp*", ".(|)*+?^$[]"), true
  assert_eq strings.contains_any("1....2....3....41....2....3....41....2....3....4", " "), false
}

test "ContainsRune" {
  assert_eq strings.contains_rune("", 97), false
  assert_eq strings.contains_rune("a", 97), true
  assert_eq strings.contains_rune("aaa", 97), true
  assert_eq strings.contains_rune("abc", 121), false
  assert_eq strings.contains_rune("abc", 99), true
  assert_eq strings.contains_rune("a☺b☻c☹d", 120), false
  assert_eq strings.contains_rune("a☺b☻c☹d", 9787), true
  assert_eq strings.contains_rune("aRegExp*", 42), true
}

test "ContainsFunc" {
  assert_eq strings.contains_func("", ->(r: Rune) -> Bool { r == 97 }), false
  assert_eq strings.contains_func("a", ->(r: Rune) -> Bool { r == 97 }), true
  assert_eq strings.contains_func("aaa", ->(r: Rune) -> Bool { r == 97 }), true
  assert_eq strings.contains_func("abc", ->(r: Rune) -> Bool { r == 121 }), false
  assert_eq strings.contains_func("abc", ->(r: Rune) -> Bool { r == 99 }), true
  assert_eq strings.contains_func("a☺b☻c☹d", ->(r: Rune) -> Bool { r == 120 }), false
  assert_eq strings.contains_func("a☺b☻c☹d", ->(r: Rune) -> Bool { r == 9787 }), true
  assert_eq strings.contains_func("aRegExp*", ->(r: Rune) -> Bool { r == 42 }), true
}

test "EqualFold" {
  assert_eq strings.equal_fold("abc", "abc"), true
  assert_eq strings.equal_fold("abc", "abc"), true
  assert_eq strings.equal_fold("ABcd", "ABcd"), true
  assert_eq strings.equal_fold("ABcd", "ABcd"), true
  assert_eq strings.equal_fold("123abc", "123ABC"), true
  assert_eq strings.equal_fold("123ABC", "123abc"), true
  assert_eq strings.equal_fold("αβδ", "ΑΒΔ"), true
  assert_eq strings.equal_fold("ΑΒΔ", "αβδ"), true
  assert_eq strings.equal_fold("abc", "xyz"), false
  assert_eq strings.equal_fold("xyz", "abc"), false
  assert_eq strings.equal_fold("abc", "XYZ"), false
  assert_eq strings.equal_fold("XYZ", "abc"), false
  assert_eq strings.equal_fold("abcdefghijk", "abcdefghijX"), false
  assert_eq strings.equal_fold("abcdefghijX", "abcdefghijk"), false
  assert_eq strings.equal_fold("abcdefghijk", "abcdefghijK"), true
  assert_eq strings.equal_fold("abcdefghijK", "abcdefghijk"), true
  assert_eq strings.equal_fold("abcdefghijK", "abcdefghijK"), true
  assert_eq strings.equal_fold("abcdefghijK", "abcdefghijK"), true
  assert_eq strings.equal_fold("abcdefghijkz", "abcdefghijKy"), false
  assert_eq strings.equal_fold("abcdefghijKy", "abcdefghijkz"), false
  assert_eq strings.equal_fold("abcdefghijKz", "abcdefghijKy"), false
  assert_eq strings.equal_fold("abcdefghijKy", "abcdefghijKz"), false
  assert_eq strings.equal_fold("1", "2"), false
  assert_eq strings.equal_fold("2", "1"), false
  assert_eq strings.equal_fold("utf-8", "US-ASCII"), false
  assert_eq strings.equal_fold("US-ASCII", "utf-8"), false
}

test "Count" {
  assert_eq strings.count("", ""), 1
  assert_eq strings.count("", "notempty"), 0
  assert_eq strings.count("notempty", ""), 9
  assert_eq strings.count("smaller", "not smaller"), 0
  assert_eq strings.count("12345678987654321", "6"), 2
  assert_eq strings.count("611161116", "6"), 3
  assert_eq strings.count("notequal", "NotEqual"), 0
  assert_eq strings.count("equal", "equal"), 1
  assert_eq strings.count("abc1231231123q", "123"), 3
  assert_eq strings.count("11111", "11"), 2
}

test "Cut" {
  check_cut(strings.cut("abc", "b"), "a", "c", true)
  check_cut(strings.cut("abc", "a"), "", "bc", true)
  check_cut(strings.cut("abc", "c"), "ab", "", true)
  check_cut(strings.cut("abc", "abc"), "", "", true)
  check_cut(strings.cut("abc", ""), "", "abc", true)
  check_cut(strings.cut("abc", "d"), "abc", "", false)
  check_cut(strings.cut("", "d"), "", "", false)
  check_cut(strings.cut("", ""), "", "", true)
}

test "CutPrefix" {
  check_cut1(strings.cut_prefix("abc", "a"), "bc", true)
  check_cut1(strings.cut_prefix("abc", "abc"), "", true)
  check_cut1(strings.cut_prefix("abc", ""), "abc", true)
  check_cut1(strings.cut_prefix("abc", "d"), "abc", false)
  check_cut1(strings.cut_prefix("", "d"), "", false)
  check_cut1(strings.cut_prefix("", ""), "", true)
}

test "CutSuffix" {
  check_cut1(strings.cut_suffix("abc", "bc"), "a", true)
  check_cut1(strings.cut_suffix("abc", "abc"), "", true)
  check_cut1(strings.cut_suffix("abc", ""), "abc", true)
  check_cut1(strings.cut_suffix("abc", "d"), "abc", false)
  check_cut1(strings.cut_suffix("", "d"), "", false)
  check_cut1(strings.cut_suffix("", ""), "", true)
}

test "Runes" {
  check_runes("", [], false)
  check_runes(" ", [32], false)
  check_runes("ABC", [65, 66, 67], false)
  check_runes("abc", [97, 98, 99], false)
  check_runes("日本語", [26085, 26412, 35486], false)
  check_runes("ab" + bs([0x80]) + "c", [97, 98, 65533, 99], true)
  check_runes("ab" + bs([0xc0]) + "c", [97, 98, 65533, 99], true)
}
