def lst(xs: [Str]) -> Str { "#{xs.size}:" + join(xs, "|") }
def raw(b: [Byte]) -> Str { Str.from_bytes(b) }

test "has_prefix / has_suffix" {
  assert has_prefix("hello", "he")
  assert !has_prefix("hello", "lo")
  assert has_prefix("", "")
  assert !has_prefix("h", "hello")
  assert has_suffix("hello", "llo")
  assert !has_suffix("hello", "he")
  assert has_suffix("x", "")
  assert !has_suffix("o", "hello")
}

test "index family" {
  assert_eq index("chicken", "ken"), 4
  assert_eq index("chicken", "dmr"), -1
  assert_eq index("abc", ""), 0
  assert_eq index("", ""), 0
  assert_eq index("", "a"), -1
  assert_eq index("aaab", "aab"), 1
  assert_eq index("a", "ab"), -1
  assert_eq index("héllo", "llo"), 3
  assert_eq last_index("go gopher", "go"), 3
  assert_eq last_index("go gopher", "rodent"), -1
  assert_eq last_index("abc", ""), 3
  assert_eq last_index("aaa", "aa"), 1
  assert_eq index_byte("golang", 108), 2
  assert_eq index_byte("golang", 120), -1
  assert_eq index_byte("", 120), -1
  assert_eq last_index_byte("go gopher", 111), 4
  assert_eq last_index_byte("go gopher", 120), -1
  assert_eq index_rune("chicken", 107), 4
  assert_eq index_rune("chicken", 100), -1
  assert_eq index_rune("héllo", 233), 1
  assert_eq index_rune("日本語", 26412), 3
  assert_eq index_rune("a" + raw([255]) + "b", 65533), 1
  assert_eq index_rune("abc", 65533), -1
  assert_eq index_rune("abc", -1), -1
  assert_eq index_rune("abc", 55296), -1
  assert_eq index_any("golang", "y"), -1
  assert_eq index_any("golang", "ng"), 0
  assert_eq index_any("héllo", "éx"), 1
  assert_eq index_any("golang", ""), -1
  assert_eq index_any("", "a"), -1
  assert_eq last_index_any("go gopher", "ordent"), 8
  assert_eq last_index_any("go gopher", "xyz"), -1
  assert_eq last_index_any("héllo", "é"), 1
  assert_eq index_func("Hello, 世界", ->(r: Rune) -> Bool { r > 127 }), 7
  assert_eq index_func("abc", ->(r: Rune) -> Bool { r == 120 }), -1
  assert_eq last_index_func("go 世界x", ->(r: Rune) -> Bool { r > 127 }), 6
  assert_eq last_index_func("abc", ->(r: Rune) -> Bool { r == 120 }), -1
}

test "contains" {
  assert contains("seafood", "foo")
  assert !contains("seafood", "bar")
  assert contains("seafood", "")
  assert contains("", "")
  assert contains_any("failure", "ui")
  assert !contains_any("foo", "")
  assert !contains_any("", "")
  assert contains_rune("aardvark", 97)
  assert !contains_rune("timothy", 97)
  assert contains_rune("日本", 26412)
  assert contains_func("abc1", ->(r: Rune) -> Bool { r >= 48 && r <= 57 })
  assert !contains_func("abc", ->(r: Rune) -> Bool { r >= 48 && r <= 57 })
}

test "count" {
  assert_eq count("cheese", "e"), 3
  assert_eq count("five", ""), 5
  assert_eq count("héé", ""), 4
  assert_eq count("", ""), 1
  assert_eq count("aaaa", "aa"), 2
  assert_eq count("abc", "d"), 0
  assert_eq count("", "a"), 0
}

test "compare" {
  assert_eq compare("a", "b"), -1
  assert_eq compare("b", "a"), 1
  assert_eq compare("a", "a"), 0
  assert_eq compare("", "a"), -1
}

test "cut" {
  c = cut("Gopher", "ph")
  assert !c.none?
  before, after = c || ("", "")
  assert_eq before, "Go"
  assert_eq after, "er"
  assert cut("Gopher", "x").none?
  b2, a2 = cut("a=b=c", "=") || ("", "")
  assert_eq b2, "a"
  assert_eq a2, "b=c"
  b3, a3 = cut("abc", "") || ("x", "")
  assert_eq b3, ""
  assert_eq a3, "abc"
  b4, a4 = cut("abc", "c") || ("x", "")
  assert_eq b4, "ab"
  assert_eq a4, ""
}

test "cut_prefix / cut_suffix" {
  assert_eq cut_prefix("Gopher", "Go") || "?", "pher"
  assert cut_prefix("Gopher", "ph").none?
  assert_eq cut_prefix("Go", "Go") || "?", ""
  assert_eq cut_prefix("Go", "") || "?", "Go"
  assert_eq cut_suffix("Gopher", "er") || "?", "Goph"
  assert cut_suffix("Gopher", "Go").none?
  assert_eq cut_suffix("Go", "Go") || "?", ""
}

test "equal_fold" {
  assert equal_fold("Go", "GO")
  assert equal_fold("", "")
  assert !equal_fold("Go", "Goo")
  assert !equal_fold("Go", "Gp")
  assert equal_fold("Élan", "éLAN")
  assert equal_fold("ΑΒΓ", "αβγ")
  assert equal_fold("ΣΑΣ", "σας")
  assert equal_fold("привет", "ПРИВЕТ")
  assert !equal_fold("привет", "приветы")
}

test "split" {
  assert_eq lst(split("a,b,c", ",")), lst(["a", "b", "c"])
  assert_eq lst(split("a man a plan", " a ")), lst(["a man", "plan"])
  assert_eq lst(split("abc", "")), lst(["a", "b", "c"])
  assert_eq lst(split("héy", "")), lst(["h", "é", "y"])
  assert_eq lst(split("", "")), lst([])
  assert_eq lst(split("", ",")), lst([""])
  assert_eq lst(split("a,,b", ",")), lst(["a", "", "b"])
  assert_eq lst(split(",a,", ",")), lst(["", "a", ""])
  assert_eq lst(split("abc", "x")), lst(["abc"])
  assert_eq lst(split("a--b--c", "--")), lst(["a", "b", "c"])
  assert_eq lst(split("aaa", "aa")), lst(["", "a"])
}

test "split_after" {
  assert_eq lst(split_after("a,b,c", ",")), lst(["a,", "b,", "c"])
  assert_eq lst(split_after("abc", "")), lst(["a", "b", "c"])
  assert_eq lst(split_after("a,", ",")), lst(["a,", ""])
  assert_eq lst(split_after("", ",")), lst([""])
}

test "split_n" {
  assert_eq lst(split_n("a,b,c,d", ",", 2)), lst(["a", "b,c,d"])
  assert_eq lst(split_n("a,b,c,d", ",", 0)), lst([])
  assert_eq lst(split_n("a,b,c,d", ",", -1)), lst(["a", "b", "c", "d"])
  assert_eq lst(split_n("a,b,c,d", ",", 1)), lst(["a,b,c,d"])
  assert_eq lst(split_n("a,b,c,d", ",", 10)), lst(["a", "b", "c", "d"])
  assert_eq lst(split_n("a,b,c,d", ",", 4)), lst(["a", "b", "c", "d"])
  assert_eq lst(split_n("abcd", "", 2)), lst(["a", "bcd"])
  assert_eq lst(split_n("héy", "", 2)), lst(["h", "éy"])
  assert_eq lst(split_n("abc", "", 10)), lst(["a", "b", "c"])
  assert_eq lst(split_n("abc", "", 0)), lst([])
  assert_eq lst(split_n("abc", "", -1)), lst(["a", "b", "c"])
  assert_eq lst(split_n("", ",", 3)), lst([""])
}

test "split_after_n" {
  assert_eq lst(split_after_n("a,b,c,d", ",", 2)), lst(["a,", "b,c,d"])
  assert_eq lst(split_after_n("a,b,c,d", ",", 0)), lst([])
  assert_eq lst(split_after_n("a,b,c,d", ",", -1)), lst(["a,", "b,", "c,", "d"])
  assert_eq lst(split_after_n("abc", "", 2)), lst(["a", "bc"])
}

# The builtin Str#split is Ruby's (drops trailing empty pieces); strings.split
# is Go's (keeps them). They agree when there are none.
test "split agrees with the builtin when no trailing empties" {
  for s in ["a,b,c", "x", ",a", ",,a", "héllo,wörld"] {
    assert_eq lst(split(s, ",")), lst(s.split(","))
  }
}

test "fields" {
  assert_eq lst(fields("  foo bar  baz   ")), lst(["foo", "bar", "baz"])
  assert_eq lst(fields("")), lst([])
  assert_eq lst(fields("   ")), lst([])
  assert_eq lst(fields("a")), lst(["a"])
  assert_eq lst(fields("a\tb\nc" + raw([13]) + "\nd e　f")), lst(["a", "b", "c", "d", "e", "f"])
  assert_eq lst(fields("héllo wörld")), lst(["héllo", "wörld"])
}

test "fields_func" {
  f = ->(r: Rune) -> Bool { !(r >= 97 && r <= 122) }
  assert_eq lst(fields_func("  foo1;bar2,baz3...", f)), lst(["foo", "bar", "baz"])
  assert_eq lst(fields_func("", f)), lst([])
  assert_eq lst(fields_func("abc", f)), lst(["abc"])
  assert_eq lst(fields_func("123", f)), lst([])
}

test "join" {
  assert_eq join(["foo", "bar", "baz"], ", "), "foo, bar, baz"
  assert_eq join([], ","), ""
  assert_eq join(["a"], ","), "a"
  assert_eq join(["", ""], ","), ","
  assert_eq join(["a", "b"], ""), "ab"
}

test "repeat" {
  assert_eq repeat("na", 3), "nanana"
  assert_eq repeat("na", 0), ""
  assert_eq repeat("", 5), ""
  assert_eq repeat("é", 2), "éé"
  assert_eq repeat("ab", 1), "ab"
}

test "replace" {
  assert_eq replace("oink oink oink", "k", "ky", 2), "oinky oinky oink"
  assert_eq replace("oink oink oink", "oink", "moo", -1), "moo moo moo"
  assert_eq replace("oink oink oink", "oink", "moo", 0), "oink oink oink"
  assert_eq replace("oink oink oink", "oink", "moo", 1), "moo oink oink"
  assert_eq replace("oink oink oink", "oink", "moo", 99), "moo moo moo"
  assert_eq replace("abc", "x", "y", -1), "abc"
  assert_eq replace("aaa", "a", "", -1), ""
  assert_eq replace("aaa", "aa", "b", -1), "ba"
  assert_eq replace("abc", "b", "b", -1), "abc"
  assert_eq replace("", "a", "b", -1), ""
  # empty old: before every rune and at the end
  assert_eq replace("ab", "", "-", -1), "-a-b-"
  assert_eq replace("ab", "", "-", 2), "-a-b"
  assert_eq replace("ab", "", "-", 1), "-ab"
  assert_eq replace("", "", "-", -1), "-"
  assert_eq replace("héy", "", "|", -1), "|h|é|y|"
  assert_eq replace("日本", "本", "語", -1), "日語"
}

test "replace_all" {
  assert_eq replace_all("oink oink oink", "oink", "moo"), "moo moo moo"
  assert_eq replace_all("a.b.c", ".", "::"), "a::b::c"
  assert_eq replace_all("aaaa", "aa", "b"), "bb"
}

test "map" {
  rot13 = ->(r: Rune) -> Rune {
    if r >= 97 && r <= 122 {
      (r - 97 + 13) % 26 + 97
    } else if r >= 65 && r <= 90 {
      (r - 65 + 13) % 26 + 65
    } else {
      r
    }
  }
  assert_eq map(rot13, "'Twas brillig and the slithy gopher..."), "'Gjnf oevyyvt naq gur fyvgul tbcure..."
  assert_eq map(rot13, ""), ""
  neg: Rune = -1
  drop_e = ->(r: Rune) -> Rune { r == 101 ? neg : r }
  assert_eq map(drop_e, "excellent"), "xcllnt"
  e_acute: Rune = 233
  widen = ->(r: Rune) -> Rune { r == 97 ? e_acute : r }
  assert_eq map(widen, "banana"), "bénéné"
}

test "to_valid_utf8" {
  assert_eq to_valid_utf8("abc", "?"), "abc"
  assert_eq to_valid_utf8("a" + raw([255]) + "b", "?"), "a?b"
  assert_eq to_valid_utf8("a" + raw([255, 254, 253]) + "b", "?"), "a?b"
  assert_eq to_valid_utf8("a" + raw([255]) + "b" + raw([254]), "¿"), "a¿b¿"
  assert_eq to_valid_utf8(raw([255]), ""), ""
  assert_eq to_valid_utf8("é" + raw([195]), "?"), "é?"
  assert_eq to_valid_utf8("", "?"), ""
}

test "to_upper / to_lower: ASCII" {
  assert_eq to_upper("Hello, World 123"), "HELLO, WORLD 123"
  assert_eq to_lower("Hello, World 123"), "hello, world 123"
  assert_eq to_upper(""), ""
  assert_eq to_lower("already lower"), "already lower"
  assert_eq to_upper("ALREADY UPPER"), "ALREADY UPPER"
  assert_eq to_upper("@[`{"), "@[`{"
}

test "to_upper / to_lower: Unicode" {
  assert_eq to_upper("héllo wörld"), "HÉLLO WÖRLD"
  assert_eq to_lower("HÉLLO WÖRLD"), "héllo wörld"
  assert_eq to_upper("ÿ"), "Ÿ"
  assert_eq to_lower("Ÿ"), "ÿ"
  assert_eq to_upper("ß"), "ß"
  assert_eq to_upper("×÷"), "×÷"
  assert_eq to_lower("×÷"), "×÷"
  assert_eq to_upper("µ"), "Μ"
  assert_eq to_upper("ąčęž"), "ĄČĘŽ"
  assert_eq to_lower("ĄČĘŽ"), "ąčęž"
  assert_eq to_upper("łódź"), "ŁÓDŹ"
  assert_eq to_lower("İ"), "i"
  assert_eq to_upper("ı"), "I"
  assert_eq to_upper("αβγ ςσ"), "ΑΒΓ ΣΣ"
  assert_eq to_lower("ΑΒΓ ΣΣ"), "αβγ σσ"
  assert_eq to_upper("άέήίόύώ"), "ΆΈΉΊΌΎΏ"
  assert_eq to_lower("ΆΈΉΊΌΎΏ"), "άέήίόύώ"
  assert_eq to_upper("привет, мир"), "ПРИВЕТ, МИР"
  assert_eq to_lower("ПРИВЕТ, МИР"), "привет, мир"
  assert_eq to_upper("ёж"), "ЁЖ"
  assert_eq to_lower("ЁЖ"), "ёж"
  assert_eq to_upper("日本語 abc"), "日本語 ABC"
  assert_eq to_lower("日本語 ABC"), "日本語 abc"
  assert_eq to_upper("a" + raw([255]) + "b"), "A\uFFFDB" # Go: invalid bytes become U+FFFD
}

test "trim_space" {
  assert_eq trim_space(" \t\n Hello, Gophers \n\t" + raw([13]) + "\n"), "Hello, Gophers"
  assert_eq trim_space(""), ""
  assert_eq trim_space("   "), ""
  assert_eq trim_space("x"), "x"
  assert_eq trim_space(" 　é  "), "é"
  assert_eq trim_space("a b"), "a b"
  assert_eq trim_space(raw([194, 133]) + "x" + raw([226, 128, 168])), "x"
}

test "trim / trim_left / trim_right" {
  assert_eq trim("¡¡¡Hello, Gophers!!!", "!¡"), "Hello, Gophers"
  assert_eq trim_left("¡¡¡Hello, Gophers!!!", "!¡"), "Hello, Gophers!!!"
  assert_eq trim_right("¡¡¡Hello, Gophers!!!", "!¡"), "¡¡¡Hello, Gophers"
  assert_eq trim("abc", ""), "abc"
  assert_eq trim("", "abc"), ""
  assert_eq trim("aaa", "a"), ""
  assert_eq trim("xxéxx", "x"), "é"
  assert_eq trim("éaé", "é"), "a"
  assert_eq trim_left("abcba", "ab"), "cba"
  assert_eq trim_right("abcba", "ab"), "abc"
}

test "trim_func family" {
  digit = ->(r: Rune) -> Bool { r >= 48 && r <= 57 }
  assert_eq trim_func("123go1ph3er456", digit), "go1ph3er"
  assert_eq trim_left_func("123go1ph3er456", digit), "go1ph3er456"
  assert_eq trim_right_func("123go1ph3er456", digit), "123go1ph3er"
  assert_eq trim_func("", digit), ""
  assert_eq trim_func("123", digit), ""
  assert_eq trim_func("é1é", ->(r: Rune) -> Bool { r == 233 }), "1"
}

test "trim_prefix / trim_suffix" {
  assert_eq trim_prefix("Goodbye,, world!", "Goodbye,"), ", world!"
  assert_eq trim_prefix("abc", "x"), "abc"
  assert_eq trim_prefix("abc", ""), "abc"
  assert_eq trim_prefix("abc", "abc"), ""
  assert_eq trim_suffix("Hello, goodbye, etc!", "goodbye, etc!"), "Hello, "
  assert_eq trim_suffix("abc", "x"), "abc"
  assert_eq trim_suffix("abc", "abc"), ""
  assert_eq trim_suffix("abc", ""), "abc"
}

test "Builder" {
  b = Builder.new
  assert_eq b.size, 0
  assert_eq b.to_s, ""
  assert_eq b.write_string!("Hello"), 5
  b.write_byte!(44)
  b.write_byte!(32)
  assert_eq b.write_rune!(19990), 3
  assert_eq b.write_rune!(233), 2
  assert_eq b.write_rune!(97), 1
  assert_eq b.write_rune!(128512), 4
  assert_eq b.write_rune!(-5), 3
  assert_eq b.to_s, "Hello, 世éa😀" + raw([239, 191, 189])
  assert_eq b.string, b.to_s
  assert_eq b.size, 5 + 2 + 3 + 2 + 1 + 4 + 3
  b.grow!(100)
  b.reset!
  assert_eq b.size, 0
  b.write_string!("again")
  assert_eq b.to_s, "again"
}

test "Builder is linear" {
  b = Builder.new
  i = 0
  while i < 100000 {
    b.write_string!("ab")
    i += 1
  }
  assert_eq b.size, 200000
  s = b.to_s
  assert_eq s.size, 200000
  assert has_prefix(s, "abab")
  assert_eq count(s, "ab"), 100000
}

test "large inputs" {
  big = repeat("x,", 50000)
  parts = split(big, ",")
  assert_eq parts.size, 50001
  assert_eq join(parts, ","), big
  assert_eq replace_all(big, ",", ";").size, 100000
  assert_eq index(big + "needle", "needle"), 100000
}

test "UTF-8 decoding edge cases" {
  # overlong, surrogate, too large, truncated sequences each decode byte by byte
  assert_eq lst(split(raw([192, 128]), "")), lst([raw([192]), raw([128])])
  assert_eq lst(split(raw([237, 160, 128]), "")), lst([raw([237]), raw([160]), raw([128])])
  assert_eq split(raw([244, 144, 128, 128]), "").size, 4
  assert_eq split(raw([226, 130]), "").size, 2
  assert_eq lst(split("a€b", "")), lst(["a", "€", "b"])
  assert_eq lst(split("😀x", "")), lst(["😀", "x"])
  assert_eq trim_right("ab" + raw([255]), "�"), "ab"
  assert_eq trim_space(raw([255]) + " x " + raw([255])), raw([255]) + " x " + raw([255])
}

def add_to(b: Builder, s: Str) {
  x = b
  x.write_string!(s)
  x.write_byte!(33)
}

test "Builder copies share state" {
  b = new_builder
  add_to(b, "hi")
  add_to(b, " there")
  assert_eq b.to_s, "hi! there!"
  assert_eq b.size, 10
  c = b
  c.reset!
  assert_eq b.size, 0
  # The zero value is empty and works in place.
  z = Builder.new
  assert_eq z.to_s, ""
  z.write_string!("x")
  assert_eq z.to_s, "x"
}
