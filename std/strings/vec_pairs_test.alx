  assert_eq strings.trim_right("abc", "a"), "abc"
  assert_eq strings.replace("abc", "a", "<>", 2), "<>bc"
  assert_eq strings.replace_all("abc", "a", "#"), "\#bc"
  assert_eq strings.index("abc", ","), -1
  assert_eq strings.last_index("abc", ","), -1
  assert_eq strings.index_any("abc", ","), -1
  assert_eq strings.last_index_any("abc", ","), -1
  assert_eq strings.count("abc", ","), 0
  assert_eq strings.split("abc", ","), ["abc"]
  assert_eq strings.split_after_n("abc", ",", 2), ["abc"]
  chk_cut(strings.cut("abc", ","), "abc", "", false)
  chk_cut(strings.cut_last("abc", ","), "abc", "", false)
  assert_eq strings.trim("abc", ","), "abc"
  assert_eq strings.trim_left("abc", ","), "abc"
  assert_eq strings.trim_right("abc", ","), "abc"
  assert_eq strings.replace("abc", ",", "<>", 2), "abc"
  assert_eq strings.replace_all("abc", ",", "#"), "abc"
  assert_eq strings.index("abc", "ab"), 0
  assert_eq strings.last_index("abc", "ab"), 0
  assert_eq strings.index_any("abc", "ab"), 0
  assert_eq strings.last_index_any("abc", "ab"), 1
  assert_eq strings.count("abc", "ab"), 1
  assert_eq strings.split("abc", "ab"), ["", "c"]
  assert_eq strings.split_after_n("abc", "ab", 2), ["ab", "c"]
  chk_cut(strings.cut("abc", "ab"), "", "c", true)
  chk_cut(strings.cut_last("abc", "ab"), "", "c", true)
  assert_eq strings.trim("abc", "ab"), "c"
}

