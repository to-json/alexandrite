test "pairs (3)" {
  assert_eq strings.count(" ", "é"), 0
  assert_eq strings.split(" ", "é"), [" "]
  assert_eq strings.split_after_n(" ", "é", 2), [" "]
  chk_cut(strings.cut(" ", "é"), " ", "", false)
  chk_cut(strings.cut_last(" ", "é"), " ", "", false)
  assert_eq strings.trim(" ", "é"), " "
  assert_eq strings.trim_left(" ", "é"), " "
  assert_eq strings.trim_right(" ", "é"), " "
  assert_eq strings.replace(" ", "é", "<>", 2), " "
  assert_eq strings.replace_all(" ", "é", "#"), " "
  assert_eq strings.index(" ", bs([0xff])), -1
  assert_eq strings.last_index(" ", bs([0xff])), -1
  assert_eq strings.index_any(" ", bs([0xff])), -1
  assert_eq strings.last_index_any(" ", bs([0xff])), -1
