  assert_eq strings.index("a", "a"), 0
  assert_eq strings.last_index("a", "a"), 0
  assert_eq strings.index_any("a", "a"), 0
  assert_eq strings.last_index_any("a", "a"), 0
  assert_eq strings.count("a", "a"), 1
  assert_eq strings.split("a", "a"), ["", ""]
