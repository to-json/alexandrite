  assert_eq strings.trim_left("A", bs([0xff])), "A"
  assert_eq strings.trim_right("A", bs([0xff])), "A"
  assert_eq strings.replace("A", bs([0xff]), "<>", 2), "A"
  assert_eq strings.replace_all("A", bs([0xff]), "#"), "A"
  assert_eq strings.index("abc", ""), 0
  assert_eq strings.last_index("abc", ""), 3
  assert_eq strings.index_any("abc", ""), -1
  assert_eq strings.last_index_any("abc", ""), -1
  assert_eq strings.count("abc", ""), 4
  assert_eq strings.split("abc", ""), ["a", "b", "c"]
  assert_eq strings.split_after_n("abc", "", 2), ["a", "bc"]
  chk_cut(strings.cut("abc", ""), "", "abc", true)
  chk_cut(strings.cut_last("abc", ""), "abc", "", true)
  assert_eq strings.trim("abc", ""), "abc"
  assert_eq strings.trim_left("abc", ""), "abc"
  assert_eq strings.trim_right("abc", ""), "abc"
  assert_eq strings.replace("abc", "", "<>", 2), "<>a<>bc"
  assert_eq strings.replace_all("abc", "", "#"), "\#a\#b\#c\#"
  assert_eq strings.index("abc", "a"), 0
  assert_eq strings.last_index("abc", "a"), 0
  assert_eq strings.index_any("abc", "a"), 0
  assert_eq strings.last_index_any("abc", "a"), 0
  assert_eq strings.count("abc", "a"), 1
  assert_eq strings.split("abc", "a"), ["", "bc"]
  assert_eq strings.split_after_n("abc", "a", 2), ["a", "bc"]
