  assert_eq strings.trim_left("a", "ab"), ""
  assert_eq strings.trim_right("a", "ab"), ""
  assert_eq strings.replace("a", "ab", "<>", 2), "a"
  assert_eq strings.replace_all("a", "ab", "#"), "a"
  assert_eq strings.index("a", " "), -1
  assert_eq strings.last_index("a", " "), -1
  assert_eq strings.index_any("a", " "), -1
  assert_eq strings.last_index_any("a", " "), -1
  assert_eq strings.count("a", " "), 0
  assert_eq strings.split("a", " "), ["a"]
