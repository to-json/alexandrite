  assert_eq strings.index_any("a", "�"), -1
  assert_eq strings.last_index_any("a", "�"), -1
  assert_eq strings.count("a", "�"), 0
  assert_eq strings.split("a", "�"), ["a"]
}

test "pairs (4)" {
  assert_eq strings.split_after_n("a", "�", 2), ["a"]
  chk_cut(strings.cut("a", "�"), "a", "", false)
  chk_cut(strings.cut_last("a", "�"), "a", "", false)
  assert_eq strings.trim("a", "�"), "a"
  assert_eq strings.trim_left("a", "�"), "a"
  assert_eq strings.trim_right("a", "�"), "a"
  assert_eq strings.replace("a", "�", "<>", 2), "a"
  assert_eq strings.replace_all("a", "�", "#"), "a"
  assert_eq strings.index("a", "é"), -1
  assert_eq strings.last_index("a", "é"), -1
  assert_eq strings.index_any("a", "é"), -1
  assert_eq strings.last_index_any("a", "é"), -1
  assert_eq strings.count("a", "é"), 0
  assert_eq strings.split("a", "é"), ["a"]
  assert_eq strings.split_after_n("a", "é", 2), ["a"]
  chk_cut(strings.cut("a", "é"), "a", "", false)
  chk_cut(strings.cut_last("a", "é"), "a", "", false)
  assert_eq strings.trim("a", "é"), "a"
  assert_eq strings.trim_left("a", "é"), "a"
  assert_eq strings.trim_right("a", "é"), "a"
  assert_eq strings.replace("a", "é", "<>", 2), "a"
  assert_eq strings.replace_all("a", "é", "#"), "a"
  assert_eq strings.index("a", bs([0xff])), -1
  assert_eq strings.last_index("a", bs([0xff])), -1
  assert_eq strings.index_any("a", bs([0xff])), -1
  assert_eq strings.last_index_any("a", bs([0xff])), -1
  assert_eq strings.count("a", bs([0xff])), 0
  assert_eq strings.split("a", bs([0xff])), ["a"]
  assert_eq strings.split_after_n("a", bs([0xff]), 2), ["a"]
  chk_cut(strings.cut("a", bs([0xff])), "a", "", false)
  chk_cut(strings.cut_last("a", bs([0xff])), "a", "", false)
  assert_eq strings.trim("a", bs([0xff])), "a"
  assert_eq strings.trim_left("a", bs([0xff])), "a"
  assert_eq strings.trim_right("a", bs([0xff])), "a"
  assert_eq strings.replace("a", bs([0xff]), "<>", 2), "a"
  assert_eq strings.replace_all("a", bs([0xff]), "#"), "a"
  assert_eq strings.index("A", ""), 0
  assert_eq strings.last_index("A", ""), 1
  assert_eq strings.index_any("A", ""), -1
  assert_eq strings.last_index_any("A", ""), -1
  assert_eq strings.count("A", ""), 2
  assert_eq strings.split("A", ""), ["A"]
