test "pairs (32)" {
  assert_eq strings.split_after_n("x" + bs([0xc0, 0xaf]) + "y", "�", 2), ["x" + bs([0xc0, 0xaf]) + "y"]
  chk_cut(strings.cut("x" + bs([0xc0, 0xaf]) + "y", "�"), "x" + bs([0xc0, 0xaf]) + "y", "", false)
  chk_cut(strings.cut_last("x" + bs([0xc0, 0xaf]) + "y", "�"), "x" + bs([0xc0, 0xaf]) + "y", "", false)
