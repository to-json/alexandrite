#![test(external)]
# Generated from Go's strings (go run in a scratch dir); do not edit by hand.
# String x separator pairs; chk_cut is in vec_strings_test.alx.

import "strings"

test "pairs" {
  assert_eq strings.index("", ""), 0
  assert_eq strings.last_index("", ""), 0
  assert_eq strings.index_any("", ""), -1
  assert_eq strings.last_index_any("", ""), -1
  assert_eq strings.count("", ""), 1
  assert_eq strings.split("", ""), no_strs()
  assert_eq strings.split_after_n("", "", 2), no_strs()
  chk_cut(strings.cut("", ""), "", "", true)
  chk_cut(strings.cut_last("", ""), "", "", true)
  assert_eq strings.trim("", ""), ""
  assert_eq strings.trim_left("", ""), ""
  assert_eq strings.trim_right("", ""), ""
  assert_eq strings.replace("", "", "<>", 2), "<>"
  assert_eq strings.replace_all("", "", "#"), "\#"
  assert_eq strings.index("", "a"), -1
  assert_eq strings.last_index("", "a"), -1
  assert_eq strings.index_any("", "a"), -1
  assert_eq strings.last_index_any("", "a"), -1
  assert_eq strings.count("", "a"), 0
  assert_eq strings.split("", "a"), [""]
  assert_eq strings.split_after_n("", "a", 2), [""]
  chk_cut(strings.cut("", "a"), "", "", false)
  chk_cut(strings.cut_last("", "a"), "", "", false)
  assert_eq strings.trim("", "a"), ""
  assert_eq strings.trim_left("", "a"), ""
  assert_eq strings.trim_right("", "a"), ""
  assert_eq strings.replace("", "a", "<>", 2), ""
  assert_eq strings.replace_all("", "a", "#"), ""
  assert_eq strings.index("", ","), -1
  assert_eq strings.last_index("", ","), -1
  assert_eq strings.index_any("", ","), -1
  assert_eq strings.last_index_any("", ","), -1
  assert_eq strings.count("", ","), 0
  assert_eq strings.split("", ","), [""]
  assert_eq strings.split_after_n("", ",", 2), [""]
  chk_cut(strings.cut("", ","), "", "", false)
  chk_cut(strings.cut_last("", ","), "", "", false)
  assert_eq strings.trim("", ","), ""
  assert_eq strings.trim_left("", ","), ""
  assert_eq strings.trim_right("", ","), ""
  assert_eq strings.replace("", ",", "<>", 2), ""
  assert_eq strings.replace_all("", ",", "#"), ""
  assert_eq strings.index("", "ab"), -1
  assert_eq strings.last_index("", "ab"), -1
  assert_eq strings.index_any("", "ab"), -1
  assert_eq strings.last_index_any("", "ab"), -1
  assert_eq strings.count("", "ab"), 0
  assert_eq strings.split("", "ab"), [""]
  assert_eq strings.split_after_n("", "ab", 2), [""]
  chk_cut(strings.cut("", "ab"), "", "", false)
  chk_cut(strings.cut_last("", "ab"), "", "", false)
  assert_eq strings.trim("", "ab"), ""
  assert_eq strings.trim_left("", "ab"), ""
  assert_eq strings.trim_right("", "ab"), ""
  assert_eq strings.replace("", "ab", "<>", 2), ""
  assert_eq strings.replace_all("", "ab", "#"), ""
  assert_eq strings.index("", " "), -1
  assert_eq strings.last_index("", " "), -1
  assert_eq strings.index_any("", " "), -1
  assert_eq strings.last_index_any("", " "), -1
  assert_eq strings.count("", " "), 0
  assert_eq strings.split("", " "), [""]
  assert_eq strings.split_after_n("", " ", 2), [""]
  chk_cut(strings.cut("", " "), "", "", false)
  chk_cut(strings.cut_last("", " "), "", "", false)
  assert_eq strings.trim("", " "), ""
  assert_eq strings.trim_left("", " "), ""
  assert_eq strings.trim_right("", " "), ""
  assert_eq strings.replace("", " ", "<>", 2), ""
  assert_eq strings.replace_all("", " ", "#"), ""
  assert_eq strings.index("", "�"), -1
  assert_eq strings.last_index("", "�"), -1
  assert_eq strings.index_any("", "�"), -1
  assert_eq strings.last_index_any("", "�"), -1
  assert_eq strings.count("", "�"), 0
  assert_eq strings.split("", "�"), [""]
  assert_eq strings.split_after_n("", "�", 2), [""]
  chk_cut(strings.cut("", "�"), "", "", false)
  chk_cut(strings.cut_last("", "�"), "", "", false)
  assert_eq strings.trim("", "�"), ""
  assert_eq strings.trim_left("", "�"), ""
  assert_eq strings.trim_right("", "�"), ""
  assert_eq strings.replace("", "�", "<>", 2), ""
  assert_eq strings.replace_all("", "�", "#"), ""
  assert_eq strings.index("", "é"), -1
  assert_eq strings.last_index("", "é"), -1
  assert_eq strings.index_any("", "é"), -1
  assert_eq strings.last_index_any("", "é"), -1
  assert_eq strings.count("", "é"), 0
  assert_eq strings.split("", "é"), [""]
  assert_eq strings.split_after_n("", "é", 2), [""]
  chk_cut(strings.cut("", "é"), "", "", false)
  chk_cut(strings.cut_last("", "é"), "", "", false)
  assert_eq strings.trim("", "é"), ""
  assert_eq strings.trim_left("", "é"), ""
  assert_eq strings.trim_right("", "é"), ""
  assert_eq strings.replace("", "é", "<>", 2), ""
  assert_eq strings.replace_all("", "é", "#"), ""
  assert_eq strings.index("", bs([0xff])), -1
  assert_eq strings.last_index("", bs([0xff])), -1
}

