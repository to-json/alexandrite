  chk_cut(strings.cut_last("A", ""), "A", "", true)
  assert_eq strings.trim("A", ""), "A"
  assert_eq strings.trim_left("A", ""), "A"
  assert_eq strings.trim_right("A", ""), "A"
  assert_eq strings.replace("A", "", "<>", 2), "<>A<>"
  assert_eq strings.replace_all("A", "", "#"), "\#A\#"
  assert_eq strings.index("A", "a"), -1
  assert_eq strings.last_index("A", "a"), -1
  assert_eq strings.index_any("A", "a"), -1
  assert_eq strings.last_index_any("A", "a"), -1
  assert_eq strings.count("A", "a"), 0
  assert_eq strings.split("A", "a"), ["A"]
  assert_eq strings.split_after_n("A", "a", 2), ["A"]
  chk_cut(strings.cut("A", "a"), "A", "", false)
  chk_cut(strings.cut_last("A", "a"), "A", "", false)
  assert_eq strings.trim("A", "a"), "A"
