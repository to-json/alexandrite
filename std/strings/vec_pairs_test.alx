  chk_cut(strings.cut("a,b,c", ","), "a", "b,c", true)
  chk_cut(strings.cut_last("a,b,c", ","), "a,b", "c", true)
  assert_eq strings.trim("a,b,c", ","), "a,b,c"
  assert_eq strings.trim_left("a,b,c", ","), "a,b,c"
  assert_eq strings.trim_right("a,b,c", ","), "a,b,c"
}

