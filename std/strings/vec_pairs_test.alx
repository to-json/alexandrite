test "pairs (28)" {
  assert_eq strings.replace("a" + bs([0xff]) + "b", "", "<>", 2), "<>a<>" + bs([0xff]) + "b"
  assert_eq strings.replace_all("a" + bs([0xff]) + "b", "", "#"), "\#a\#" + bs([0xff]) + "\#b\#"
