  chk_cut(strings.cut_last("A", ","), "A", "", false)
  assert_eq strings.trim("A", ","), "A"
  assert_eq strings.trim_left("A", ","), "A"
  assert_eq strings.trim_right("A", ","), "A"
  assert_eq strings.replace("A", ",", "<>", 2), "A"
  assert_eq strings.replace_all("A", ",", "#"), "A"
  assert_eq strings.index("A", "ab"), -1
  assert_eq strings.last_index("A", "ab"), -1
  assert_eq strings.index_any("A", "ab"), -1
  assert_eq strings.last_index_any("A", "ab"), -1
  assert_eq strings.count("A", "ab"), 0
  assert_eq strings.split("A", "ab"), ["A"]
  assert_eq strings.split_after_n("A", "ab", 2), ["A"]
