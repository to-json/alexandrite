  assert_eq strings.trim(",a,,b,", "a"), ",a,,b,"
  assert_eq strings.trim_left(",a,,b,", "a"), ",a,,b,"
  assert_eq strings.trim_right(",a,,b,", "a"), ",a,,b,"
