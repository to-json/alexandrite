  assert_eq strings.index_any("a", ""), -1
  assert_eq strings.last_index_any("a", ""), -1
  assert_eq strings.count("a", ""), 2
  assert_eq strings.split("a", ""), ["a"]
  assert_eq strings.split_after_n("a", "", 2), ["a"]
  chk_cut(strings.cut("a", ""), "", "a", true)
  chk_cut(strings.cut_last("a", ""), "a", "", true)
  assert_eq strings.trim("a", ""), "a"
  assert_eq strings.trim_left("a", ""), "a"
  assert_eq strings.trim_right("a", ""), "a"
  assert_eq strings.replace("a", "", "<>", 2), "<>a<>"
