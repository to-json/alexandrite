  assert_eq strings.index_func(bs([0xf4, 0x90, 0x80, 0x80]), ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func(bs([0xf4, 0x90, 0x80, 0x80]), ->(r: Rune) -> Bool { unicode.is_letter(r) }), -1
  assert_eq strings.trim_func(bs([0xf4, 0x90, 0x80, 0x80]), ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ""
  assert_eq strings.index_rune(bs([0xf4, 0x90, 0x80, 0x80]), 97), -1
  assert_eq strings.index_rune(bs([0xf4, 0x90, 0x80, 0x80]), 65533), 0
  assert_eq strings.index_rune(bs([0xf4, 0x90, 0x80, 0x80]), 233), -1
  assert_eq strings.index_rune(bs([0xf4, 0x90, 0x80, 0x80]), 128512), -1
  assert_eq strings.index_rune(bs([0xf4, 0x90, 0x80, 0x80]), -1), -1
  assert_eq strings.index_rune(bs([0xf4, 0x90, 0x80, 0x80]), 55296), -1
  assert_eq strings.index_rune(bs([0xf4, 0x90, 0x80, 0x80]), 1114112), -1
  assert_eq strings.equal_fold(bs([0xf4, 0x90, 0x80, 0x80]), "aaaa"), false
  assert_eq strings.equal_fold(bs([0xf4, 0x90, 0x80, 0x80]), "x" + bs([0xc0, 0xaf]) + "y"), false
  assert_eq strings.equal_fold(bs([0xf4, 0x90, 0x80, 0x80]), bs([0xed, 0xa0, 0x80]) + "z"), false
  assert_eq strings.equal_fold(bs([0xf4, 0x90, 0x80, 0x80]), bs([0xf4, 0x90, 0x80, 0x80])), true
  assert_eq strings.equal_fold(bs([0xf4, 0x90, 0x80, 0x80]), "����"), true
  assert_eq strings.equal_fold(bs([0xf4, 0x90, 0x80, 0x80]), "����"), true
  assert_eq strings.equal_fold(bs([0xf4, 0x90, 0x80, 0x80]), "����"), true
  assert_eq strings.to_upper("a\x00b"), "A\x00B"
  assert_eq strings.to_lower("a\x00b"), "a\x00b"
  assert_eq strings.to_title("a\x00b"), "A\x00B"
  assert_eq strings.title("a\x00b"), "A\x00B"
  assert_eq strings.trim_space("a\x00b"), "a\x00b"
  assert_eq strings.fields("a\x00b"), ["a\x00b"]
  assert_eq strings.lines("a\x00b"), ["a\x00b"]
  assert_eq strings.to_valid_utf8("a\x00b", "?"), "a\x00b"
  assert_eq strings.count("a\x00b", ""), 4
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "a\x00b"), "a\x00b"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "a\x00b"), "\x01c"
  assert_eq strings.index_func("a\x00b", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
}

test "per string (9)" {
  assert_eq strings.last_index_func("a\x00b", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 2
  assert_eq strings.trim_func("a\x00b", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "a\x00b"
  assert_eq strings.index_rune("a\x00b", 97), 0
  assert_eq strings.index_rune("a\x00b", 65533), -1
  assert_eq strings.index_rune("a\x00b", 233), -1
  assert_eq strings.index_rune("a\x00b", 128512), -1
  assert_eq strings.index_rune("a\x00b", -1), -1
  assert_eq strings.index_rune("a\x00b", 55296), -1
  assert_eq strings.index_rune("a\x00b", 1114112), -1
  assert_eq strings.equal_fold("a\x00b", "abc"), false
  assert_eq strings.equal_fold("a\x00b", "a" + bs([0xff]) + "b"), false
  assert_eq strings.equal_fold("a\x00b", "a\x00b"), true
  assert_eq strings.equal_fold("a\x00b", "A\x00B"), true
  assert_eq strings.equal_fold("a\x00b", "a\x00b"), true
  assert_eq strings.equal_fold("a\x00b", "A\x00B"), true
  assert_eq strings.to_upper("�" + bs([0xff]) + "�"), "���"
  assert_eq strings.to_lower("�" + bs([0xff]) + "�"), "���"
  assert_eq strings.to_title("�" + bs([0xff]) + "�"), "���"
  assert_eq strings.title("�" + bs([0xff]) + "�"), "���"
  assert_eq strings.trim_space("�" + bs([0xff]) + "�"), "�" + bs([0xff]) + "�"
  assert_eq strings.fields("�" + bs([0xff]) + "�"), ["�" + bs([0xff]) + "�"]
  assert_eq strings.lines("�" + bs([0xff]) + "�"), ["�" + bs([0xff]) + "�"]
  assert_eq strings.to_valid_utf8("�" + bs([0xff]) + "�", "?"), "�?�"
  assert_eq strings.count("�" + bs([0xff]) + "�", ""), 4
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "�" + bs([0xff]) + "�"), "���"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "�" + bs([0xff]) + "�"), "\uFFFE\uFFFE\uFFFE"
  assert_eq strings.index_func("�" + bs([0xff]) + "�", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("�" + bs([0xff]) + "�", ->(r: Rune) -> Bool { unicode.is_letter(r) }), -1
  assert_eq strings.trim_func("�" + bs([0xff]) + "�", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ""
  assert_eq strings.index_rune("�" + bs([0xff]) + "�", 97), -1
  assert_eq strings.index_rune("�" + bs([0xff]) + "�", 65533), 0
  assert_eq strings.index_rune("�" + bs([0xff]) + "�", 233), -1
  assert_eq strings.index_rune("�" + bs([0xff]) + "�", 128512), -1
  assert_eq strings.index_rune("�" + bs([0xff]) + "�", -1), -1
  assert_eq strings.index_rune("�" + bs([0xff]) + "�", 55296), -1
  assert_eq strings.index_rune("�" + bs([0xff]) + "�", 1114112), -1
  assert_eq strings.equal_fold("�" + bs([0xff]) + "�", "�" + bs([0xff]) + "�"), true
  assert_eq strings.equal_fold("�" + bs([0xff]) + "�", "���"), true
  assert_eq strings.equal_fold("�" + bs([0xff]) + "�", "���"), true
  assert_eq strings.equal_fold("�" + bs([0xff]) + "�", "���"), true
  assert_eq strings.to_upper("line1\nline2\r\nline3"), "LINE1\nLINE2\r\nLINE3"
  assert_eq strings.to_lower("line1\nline2\r\nline3"), "line1\nline2\r\nline3"
  assert_eq strings.to_title("line1\nline2\r\nline3"), "LINE1\nLINE2\r\nLINE3"
  assert_eq strings.title("line1\nline2\r\nline3"), "Line1\nLine2\r\nLine3"
  assert_eq strings.trim_space("line1\nline2\r\nline3"), "line1\nline2\r\nline3"
  assert_eq strings.fields("line1\nline2\r\nline3"), ["line1", "line2", "line3"]
  assert_eq strings.lines("line1\nline2\r\nline3"), ["line1\n", "line2\r\n", "line3"]
  assert_eq strings.to_valid_utf8("line1\nline2\r\nline3", "?"), "line1\nline2\r\nline3"
  assert_eq strings.count("line1\nline2\r\nline3", ""), 19
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "line1\nline2\r\nline3"), "line1\nline2\r\nline3"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "line1\nline2\r\nline3"), "mjof2\x0bmjof3\x0e\x0bmjof4"
  assert_eq strings.index_func("line1\nline2\r\nline3", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("line1\nline2\r\nline3", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 16
  assert_eq strings.trim_func("line1\nline2\r\nline3", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "line1\nline2\r\nline"
  assert_eq strings.index_rune("line1\nline2\r\nline3", 97), -1
  assert_eq strings.index_rune("line1\nline2\r\nline3", 65533), -1
  assert_eq strings.index_rune("line1\nline2\r\nline3", 233), -1
  assert_eq strings.index_rune("line1\nline2\r\nline3", 128512), -1
  assert_eq strings.index_rune("line1\nline2\r\nline3", -1), -1
  assert_eq strings.index_rune("line1\nline2\r\nline3", 55296), -1
  assert_eq strings.index_rune("line1\nline2\r\nline3", 1114112), -1
  assert_eq strings.equal_fold("line1\nline2\r\nline3", "line1\nline2\r\nline3"), true
  assert_eq strings.equal_fold("line1\nline2\r\nline3", "LINE1\nLINE2\r\nLINE3"), true
  assert_eq strings.equal_fold("line1\nline2\r\nline3", "line1\nline2\r\nline3"), true
  assert_eq strings.equal_fold("line1\nline2\r\nline3", "LINE1\nLINE2\r\nLINE3"), true
}

