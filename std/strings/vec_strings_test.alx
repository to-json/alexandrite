test "replacer (3)" {
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("a"), "a"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("A"), "A"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("abc"), "abc"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("a,b,c"), "a,b,c"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace(",a,,b,"), ",a,,b,"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("aaaa"), "aaaa"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("abcabcabc"), "abcabcabc"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("Hello, World"), "Hello, World"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("  lots   of\tspace \n"), "  lots   of\tspace \n"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"
