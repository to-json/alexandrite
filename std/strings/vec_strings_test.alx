  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "|\t|\x0b|\r|\x0c|\n|" + bs([0xc2]) + "|" + bs([0x85]) + "|" + bs([0xc2]) + "|" + bs([0xa0]) + "|" + bs([0xe2]) + "|" + bs([0x80]) + "|" + bs([0x80]) + "|" + bs([0xe3]) + "|" + bs([0x80]) + "|" + bs([0x80]) + "|x|" + bs([0xe3]) + "|" + bs([0x80]) + "|" + bs([0x80]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("héllo wörld"), "|h|" + bs([0xc3]) + "|" + bs([0xa9]) + "|l|l|o| |w|" + bs([0xc3]) + "|" + bs([0xb6]) + "|r|l|d|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("ÀÉÎÕÜ àéîõü"), "|" + bs([0xc3]) + "|" + bs([0x80]) + "|" + bs([0xc3]) + "|" + bs([0x89]) + "|" + bs([0xc3]) + "|" + bs([0x8e]) + "|" + bs([0xc3]) + "|" + bs([0x95]) + "|" + bs([0xc3]) + "|" + bs([0x9c]) + "| |" + bs([0xc3]) + "|" + bs([0xa0]) + "|" + bs([0xc3]) + "|" + bs([0xa9]) + "|" + bs([0xc3]) + "|" + bs([0xae]) + "|" + bs([0xc3]) + "|" + bs([0xb5]) + "|" + bs([0xc3]) + "|" + bs([0xbc]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("ǅǆǄ ǈǉ"), "|" + bs([0xc7]) + "|" + bs([0x85]) + "|" + bs([0xc7]) + "|" + bs([0x86]) + "|" + bs([0xc7]) + "|" + bs([0x84]) + "| |" + bs([0xc7]) + "|" + bs([0x88]) + "|" + bs([0xc7]) + "|" + bs([0x89]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("straße STRASSE"), "|s|t|r|a|" + bs([0xc3]) + "|" + bs([0x9f]) + "|e| |S|T|R|A|S|S|E|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("İstanbul ıi"), "|" + bs([0xc4]) + "|" + bs([0xb0]) + "|s|t|a|n|b|u|l| |" + bs([0xc4]) + "|" + bs([0xb1]) + "|i|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("Kelvin K k K"), "|K|e|l|v|i|n| |" + bs([0xe2]) + "|" + bs([0x84]) + "|" + bs([0xaa]) + "| |k| |K|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("ſ S s"), "|" + bs([0xc5]) + "|" + bs([0xbf]) + "| |S| |s|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("αβγ ΣΣ ς"), "|" + bs([0xce]) + "|" + bs([0xb1]) + "|" + bs([0xce]) + "|" + bs([0xb2]) + "|" + bs([0xce]) + "|" + bs([0xb3]) + "| ss| |" + bs([0xcf]) + "|" + bs([0x82]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("привет МИР"), "|" + bs([0xd0]) + "|" + bs([0xbf]) + "|" + bs([0xd1]) + "|" + bs([0x80]) + "|" + bs([0xd0]) + "|" + bs([0xb8]) + "|" + bs([0xd0]) + "|" + bs([0xb2]) + "|" + bs([0xd0]) + "|" + bs([0xb5]) + "|" + bs([0xd1]) + "|" + bs([0x82]) + "| |" + bs([0xd0]) + "|" + bs([0x9c]) + "|" + bs([0xd0]) + "|" + bs([0x98]) + "|" + bs([0xd0]) + "|" + bs([0xa0]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("日本語 テキスト"), "|" + bs([0xe6]) + "|" + bs([0x97]) + "|" + bs([0xa5]) + "|" + bs([0xe6]) + "|" + bs([0x9c]) + "|" + bs([0xac]) + "|" + bs([0xe8]) + "|" + bs([0xaa]) + "|" + bs([0x9e]) + "| |" + bs([0xe3]) + "|" + bs([0x83]) + "|" + bs([0x86]) + "|" + bs([0xe3]) + "|" + bs([0x82]) + "|" + bs([0xad]) + "|" + bs([0xe3]) + "|" + bs([0x82]) + "|" + bs([0xb9]) + "|" + bs([0xe3]) + "|" + bs([0x83]) + "|" + bs([0x88]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("😀 smile 😀"), "|" + bs([0xf0]) + "|" + bs([0x9f]) + "|" + bs([0x98]) + "|" + bs([0x80]) + "| |s|m|i|l|e| |" + bs([0xf0]) + "|" + bs([0x9f]) + "|" + bs([0x98]) + "|" + bs([0x80]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("𐐨𐐀"), "|" + bs([0xf0]) + "|" + bs([0x90]) + "|" + bs([0x90]) + "|" + bs([0xa8]) + "|" + bs([0xf0]) + "|" + bs([0x90]) + "|" + bs([0x90]) + "|" + bs([0x80]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("a" + bs([0xff]) + "b"), "|a|" + bs([0xff]) + "|b|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace(bs([0xff, 0xfe])), "|" + bs([0xff]) + "|" + bs([0xfe]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace(bs([0xe2, 0x98])), "|" + bs([0xe2]) + "|" + bs([0x98]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("x" + bs([0xc0, 0xaf]) + "y"), "|x|" + bs([0xc0]) + "|" + bs([0xaf]) + "|y|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace(bs([0xed, 0xa0, 0x80]) + "z"), "|" + bs([0xed]) + "|" + bs([0xa0]) + "|" + bs([0x80]) + "|z|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace(bs([0xf4, 0x90, 0x80, 0x80])), "|" + bs([0xf4]) + "|" + bs([0x90]) + "|" + bs([0x80]) + "|" + bs([0x80]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("a\x00b"), "|a|\x00|b|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("�" + bs([0xff]) + "�"), "|" + bs([0xef]) + "|" + bs([0xbf]) + "|" + bs([0xbd]) + "|" + bs([0xff]) + "|" + bs([0xef]) + "|" + bs([0xbf]) + "|" + bs([0xbd]) + "|"
  assert_eq strings.new_replacer(["Σ", "s", "", "|"]).replace("line1\nline2\r\nline3"), "|l|i|n|e|1|\n|l|i|n|e|2|\r|\n|l|i|n|e|3|"
}

test "repeat and split_n" {
  assert_eq strings.repeat("", 0), ""
  assert_eq strings.repeat("", 1), ""
  assert_eq strings.repeat("", 2), ""
  assert_eq strings.repeat("", 3), ""
  assert_eq strings.repeat("", 7), ""
  assert_eq strings.repeat("", 64), ""
  assert_eq strings.repeat("", 129), ""
  assert_eq strings.repeat("a", 0), ""
  assert_eq strings.repeat("a", 1), "a"
  assert_eq strings.repeat("a", 2), "aa"
  assert_eq strings.repeat("a", 3), "aaa"
  assert_eq strings.repeat("a", 7), "aaaaaaa"
  assert_eq strings.repeat("a", 64), "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  assert_eq strings.repeat("a", 129), "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  assert_eq strings.repeat("ab", 0), ""
  assert_eq strings.repeat("ab", 1), "ab"
  assert_eq strings.repeat("ab", 2), "abab"
  assert_eq strings.repeat("ab", 3), "ababab"
  assert_eq strings.repeat("ab", 7), "ababababababab"
  assert_eq strings.repeat("ab", 64), "abababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababab"
  assert_eq strings.repeat("ab", 129), "ababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababab"
  assert_eq strings.repeat(bs([0xff]), 0), ""
  assert_eq strings.repeat(bs([0xff]), 1), bs([0xff])
  assert_eq strings.repeat(bs([0xff]), 2), bs([0xff, 0xff])
  assert_eq strings.repeat(bs([0xff]), 3), bs([0xff, 0xff, 0xff])
  assert_eq strings.repeat(bs([0xff]), 7), bs([0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff])
  assert_eq strings.repeat(bs([0xff]), 64), bs([0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff])
  assert_eq strings.repeat(bs([0xff]), 129), bs([0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff])
  assert_eq strings.repeat("é☺", 0), ""
  assert_eq strings.repeat("é☺", 1), "é☺"
  assert_eq strings.repeat("é☺", 2), "é☺é☺"
  assert_eq strings.repeat("é☺", 3), "é☺é☺é☺"
  assert_eq strings.repeat("é☺", 7), "é☺é☺é☺é☺é☺é☺é☺"
  assert_eq strings.repeat("é☺", 64), "é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺"
  assert_eq strings.repeat("é☺", 129), "é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺é☺"
  assert_eq strings.split_n("", ",", -1), [""]
  assert_eq strings.split_n("", "", -1), no_strs()
  assert_eq strings.split_n("", ",", 0), no_strs()
  assert_eq strings.split_n("", "", 0), no_strs()
  assert_eq strings.split_n("", ",", 1), [""]
  assert_eq strings.split_n("", "", 1), no_strs()
  assert_eq strings.split_n("", ",", 2), [""]
  assert_eq strings.split_n("", "", 2), no_strs()
  assert_eq strings.split_n("", ",", 5), [""]
  assert_eq strings.split_n("", "", 5), no_strs()
  assert_eq strings.fields_func("", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), no_strs()
  assert_eq strings.split_n(" ", ",", -1), [" "]
  assert_eq strings.split_n(" ", "", -1), [" "]
  assert_eq strings.split_n(" ", ",", 0), no_strs()
  assert_eq strings.split_n(" ", "", 0), no_strs()
  assert_eq strings.split_n(" ", ",", 1), [" "]
  assert_eq strings.split_n(" ", "", 1), [" "]
  assert_eq strings.split_n(" ", ",", 2), [" "]
  assert_eq strings.split_n(" ", "", 2), [" "]
  assert_eq strings.split_n(" ", ",", 5), [" "]
  assert_eq strings.split_n(" ", "", 5), [" "]
  assert_eq strings.fields_func(" ", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), no_strs()
  assert_eq strings.split_n("a", ",", -1), ["a"]
  assert_eq strings.split_n("a", "", -1), ["a"]
  assert_eq strings.split_n("a", ",", 0), no_strs()
  assert_eq strings.split_n("a", "", 0), no_strs()
  assert_eq strings.split_n("a", ",", 1), ["a"]
  assert_eq strings.split_n("a", "", 1), ["a"]
  assert_eq strings.split_n("a", ",", 2), ["a"]
  assert_eq strings.split_n("a", "", 2), ["a"]
  assert_eq strings.split_n("a", ",", 5), ["a"]
  assert_eq strings.split_n("a", "", 5), ["a"]
  assert_eq strings.fields_func("a", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["a"]
  assert_eq strings.split_n("A", ",", -1), ["A"]
  assert_eq strings.split_n("A", "", -1), ["A"]
  assert_eq strings.split_n("A", ",", 0), no_strs()
  assert_eq strings.split_n("A", "", 0), no_strs()
  assert_eq strings.split_n("A", ",", 1), ["A"]
  assert_eq strings.split_n("A", "", 1), ["A"]
  assert_eq strings.split_n("A", ",", 2), ["A"]
  assert_eq strings.split_n("A", "", 2), ["A"]
  assert_eq strings.split_n("A", ",", 5), ["A"]
  assert_eq strings.split_n("A", "", 5), ["A"]
  assert_eq strings.fields_func("A", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["A"]
  assert_eq strings.split_n("abc", ",", -1), ["abc"]
  assert_eq strings.split_n("abc", "", -1), ["a", "b", "c"]
  assert_eq strings.split_n("abc", ",", 0), no_strs()
  assert_eq strings.split_n("abc", "", 0), no_strs()
  assert_eq strings.split_n("abc", ",", 1), ["abc"]
  assert_eq strings.split_n("abc", "", 1), ["abc"]
  assert_eq strings.split_n("abc", ",", 2), ["abc"]
  assert_eq strings.split_n("abc", "", 2), ["a", "bc"]
  assert_eq strings.split_n("abc", ",", 5), ["abc"]
  assert_eq strings.split_n("abc", "", 5), ["a", "b", "c"]
  assert_eq strings.fields_func("abc", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["abc"]
  assert_eq strings.split_n("a,b,c", ",", -1), ["a", "b", "c"]
  assert_eq strings.split_n("a,b,c", "", -1), ["a", ",", "b", ",", "c"]
  assert_eq strings.split_n("a,b,c", ",", 0), no_strs()
  assert_eq strings.split_n("a,b,c", "", 0), no_strs()
  assert_eq strings.split_n("a,b,c", ",", 1), ["a,b,c"]
  assert_eq strings.split_n("a,b,c", "", 1), ["a,b,c"]
  assert_eq strings.split_n("a,b,c", ",", 2), ["a", "b,c"]
  assert_eq strings.split_n("a,b,c", "", 2), ["a", ",b,c"]
  assert_eq strings.split_n("a,b,c", ",", 5), ["a", "b", "c"]
  assert_eq strings.split_n("a,b,c", "", 5), ["a", ",", "b", ",", "c"]
}

test "repeat and split_n (2)" {
  assert_eq strings.fields_func("a,b,c", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["a", "b", "c"]
  assert_eq strings.split_n(",a,,b,", ",", -1), ["", "a", "", "b", ""]
  assert_eq strings.split_n(",a,,b,", "", -1), [",", "a", ",", ",", "b", ","]
  assert_eq strings.split_n(",a,,b,", ",", 0), no_strs()
  assert_eq strings.split_n(",a,,b,", "", 0), no_strs()
  assert_eq strings.split_n(",a,,b,", ",", 1), [",a,,b,"]
  assert_eq strings.split_n(",a,,b,", "", 1), [",a,,b,"]
  assert_eq strings.split_n(",a,,b,", ",", 2), ["", "a,,b,"]
  assert_eq strings.split_n(",a,,b,", "", 2), [",", "a,,b,"]
  assert_eq strings.split_n(",a,,b,", ",", 5), ["", "a", "", "b", ""]
  assert_eq strings.split_n(",a,,b,", "", 5), [",", "a", ",", ",", "b,"]
  assert_eq strings.fields_func(",a,,b,", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["a", "b"]
  assert_eq strings.split_n("aaaa", ",", -1), ["aaaa"]
  assert_eq strings.split_n("aaaa", "", -1), ["a", "a", "a", "a"]
  assert_eq strings.split_n("aaaa", ",", 0), no_strs()
  assert_eq strings.split_n("aaaa", "", 0), no_strs()
  assert_eq strings.split_n("aaaa", ",", 1), ["aaaa"]
  assert_eq strings.split_n("aaaa", "", 1), ["aaaa"]
  assert_eq strings.split_n("aaaa", ",", 2), ["aaaa"]
  assert_eq strings.split_n("aaaa", "", 2), ["a", "aaa"]
  assert_eq strings.split_n("aaaa", ",", 5), ["aaaa"]
  assert_eq strings.split_n("aaaa", "", 5), ["a", "a", "a", "a"]
  assert_eq strings.fields_func("aaaa", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["aaaa"]
  assert_eq strings.split_n("abcabcabc", ",", -1), ["abcabcabc"]
  assert_eq strings.split_n("abcabcabc", "", -1), ["a", "b", "c", "a", "b", "c", "a", "b", "c"]
  assert_eq strings.split_n("abcabcabc", ",", 0), no_strs()
  assert_eq strings.split_n("abcabcabc", "", 0), no_strs()
  assert_eq strings.split_n("abcabcabc", ",", 1), ["abcabcabc"]
  assert_eq strings.split_n("abcabcabc", "", 1), ["abcabcabc"]
  assert_eq strings.split_n("abcabcabc", ",", 2), ["abcabcabc"]
  assert_eq strings.split_n("abcabcabc", "", 2), ["a", "bcabcabc"]
  assert_eq strings.split_n("abcabcabc", ",", 5), ["abcabcabc"]
  assert_eq strings.split_n("abcabcabc", "", 5), ["a", "b", "c", "a", "bcabc"]
  assert_eq strings.fields_func("abcabcabc", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["abcabcabc"]
  assert_eq strings.split_n("Hello, World", ",", -1), ["Hello", " World"]
  assert_eq strings.split_n("Hello, World", "", -1), ["H", "e", "l", "l", "o", ",", " ", "W", "o", "r", "l", "d"]
  assert_eq strings.split_n("Hello, World", ",", 0), no_strs()
  assert_eq strings.split_n("Hello, World", "", 0), no_strs()
  assert_eq strings.split_n("Hello, World", ",", 1), ["Hello, World"]
  assert_eq strings.split_n("Hello, World", "", 1), ["Hello, World"]
  assert_eq strings.split_n("Hello, World", ",", 2), ["Hello", " World"]
  assert_eq strings.split_n("Hello, World", "", 2), ["H", "ello, World"]
  assert_eq strings.split_n("Hello, World", ",", 5), ["Hello", " World"]
  assert_eq strings.split_n("Hello, World", "", 5), ["H", "e", "l", "l", "o, World"]
  assert_eq strings.fields_func("Hello, World", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["Hello", "World"]
  assert_eq strings.split_n("  lots   of\tspace \n", ",", -1), ["  lots   of\tspace \n"]
  assert_eq strings.split_n("  lots   of\tspace \n", "", -1), [" ", " ", "l", "o", "t", "s", " ", " ", " ", "o", "f", "\t", "s", "p", "a", "c", "e", " ", "\n"]
  assert_eq strings.split_n("  lots   of\tspace \n", ",", 0), no_strs()
  assert_eq strings.split_n("  lots   of\tspace \n", "", 0), no_strs()
  assert_eq strings.split_n("  lots   of\tspace \n", ",", 1), ["  lots   of\tspace \n"]
  assert_eq strings.split_n("  lots   of\tspace \n", "", 1), ["  lots   of\tspace \n"]
  assert_eq strings.split_n("  lots   of\tspace \n", ",", 2), ["  lots   of\tspace \n"]
  assert_eq strings.split_n("  lots   of\tspace \n", "", 2), [" ", " lots   of\tspace \n"]
  assert_eq strings.split_n("  lots   of\tspace \n", ",", 5), ["  lots   of\tspace \n"]
  assert_eq strings.split_n("  lots   of\tspace \n", "", 5), [" ", " ", "l", "o", "ts   of\tspace \n"]
  assert_eq strings.fields_func("  lots   of\tspace \n", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["lots", "of", "space"]
  assert_eq strings.split_n("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", ",", -1), ["\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"]
  assert_eq strings.split_n("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "", -1), ["\t", "\x0b", "\r", "\x0c", "\n", "\u0085", "\u00A0", "\u2000", "\u3000", "x", "\u3000"]
  assert_eq strings.split_n("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", ",", 0), no_strs()
  assert_eq strings.split_n("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "", 0), no_strs()
  assert_eq strings.split_n("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", ",", 1), ["\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"]
  assert_eq strings.split_n("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "", 1), ["\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"]
  assert_eq strings.split_n("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", ",", 2), ["\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"]
  assert_eq strings.split_n("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "", 2), ["\t", "\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"]
  assert_eq strings.split_n("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", ",", 5), ["\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"]
  assert_eq strings.split_n("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "", 5), ["\t", "\x0b", "\r", "\x0c", "\n\u0085\u00A0\u2000\u3000x\u3000"]
  assert_eq strings.fields_func("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["x"]
  assert_eq strings.split_n("héllo wörld", ",", -1), ["héllo wörld"]
  assert_eq strings.split_n("héllo wörld", "", -1), ["h", "é", "l", "l", "o", " ", "w", "ö", "r", "l", "d"]
  assert_eq strings.split_n("héllo wörld", ",", 0), no_strs()
  assert_eq strings.split_n("héllo wörld", "", 0), no_strs()
  assert_eq strings.split_n("héllo wörld", ",", 1), ["héllo wörld"]
  assert_eq strings.split_n("héllo wörld", "", 1), ["héllo wörld"]
  assert_eq strings.split_n("héllo wörld", ",", 2), ["héllo wörld"]
  assert_eq strings.split_n("héllo wörld", "", 2), ["h", "éllo wörld"]
  assert_eq strings.split_n("héllo wörld", ",", 5), ["héllo wörld"]
  assert_eq strings.split_n("héllo wörld", "", 5), ["h", "é", "l", "l", "o wörld"]
  assert_eq strings.fields_func("héllo wörld", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["héllo", "wörld"]
  assert_eq strings.split_n("ÀÉÎÕÜ àéîõü", ",", -1), ["ÀÉÎÕÜ àéîõü"]
  assert_eq strings.split_n("ÀÉÎÕÜ àéîõü", "", -1), ["À", "É", "Î", "Õ", "Ü", " ", "à", "é", "î", "õ", "ü"]
  assert_eq strings.split_n("ÀÉÎÕÜ àéîõü", ",", 0), no_strs()
  assert_eq strings.split_n("ÀÉÎÕÜ àéîõü", "", 0), no_strs()
  assert_eq strings.split_n("ÀÉÎÕÜ àéîõü", ",", 1), ["ÀÉÎÕÜ àéîõü"]
  assert_eq strings.split_n("ÀÉÎÕÜ àéîõü", "", 1), ["ÀÉÎÕÜ àéîõü"]
  assert_eq strings.split_n("ÀÉÎÕÜ àéîõü", ",", 2), ["ÀÉÎÕÜ àéîõü"]
  assert_eq strings.split_n("ÀÉÎÕÜ àéîõü", "", 2), ["À", "ÉÎÕÜ àéîõü"]
  assert_eq strings.split_n("ÀÉÎÕÜ àéîõü", ",", 5), ["ÀÉÎÕÜ àéîõü"]
  assert_eq strings.split_n("ÀÉÎÕÜ àéîõü", "", 5), ["À", "É", "Î", "Õ", "Ü àéîõü"]
  assert_eq strings.fields_func("ÀÉÎÕÜ àéîõü", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["ÀÉÎÕÜ", "àéîõü"]
  assert_eq strings.split_n("ǅǆǄ ǈǉ", ",", -1), ["ǅǆǄ ǈǉ"]
  assert_eq strings.split_n("ǅǆǄ ǈǉ", "", -1), ["ǅ", "ǆ", "Ǆ", " ", "ǈ", "ǉ"]
  assert_eq strings.split_n("ǅǆǄ ǈǉ", ",", 0), no_strs()
  assert_eq strings.split_n("ǅǆǄ ǈǉ", "", 0), no_strs()
  assert_eq strings.split_n("ǅǆǄ ǈǉ", ",", 1), ["ǅǆǄ ǈǉ"]
  assert_eq strings.split_n("ǅǆǄ ǈǉ", "", 1), ["ǅǆǄ ǈǉ"]
  assert_eq strings.split_n("ǅǆǄ ǈǉ", ",", 2), ["ǅǆǄ ǈǉ"]
  assert_eq strings.split_n("ǅǆǄ ǈǉ", "", 2), ["ǅ", "ǆǄ ǈǉ"]
  assert_eq strings.split_n("ǅǆǄ ǈǉ", ",", 5), ["ǅǆǄ ǈǉ"]
  assert_eq strings.split_n("ǅǆǄ ǈǉ", "", 5), ["ǅ", "ǆ", "Ǆ", " ", "ǈǉ"]
  assert_eq strings.fields_func("ǅǆǄ ǈǉ", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["ǅǆǄ", "ǈǉ"]
}

test "repeat and split_n (3)" {
  assert_eq strings.split_n("straße STRASSE", ",", -1), ["straße STRASSE"]
  assert_eq strings.split_n("straße STRASSE", "", -1), ["s", "t", "r", "a", "ß", "e", " ", "S", "T", "R", "A", "S", "S", "E"]
  assert_eq strings.split_n("straße STRASSE", ",", 0), no_strs()
  assert_eq strings.split_n("straße STRASSE", "", 0), no_strs()
  assert_eq strings.split_n("straße STRASSE", ",", 1), ["straße STRASSE"]
  assert_eq strings.split_n("straße STRASSE", "", 1), ["straße STRASSE"]
  assert_eq strings.split_n("straße STRASSE", ",", 2), ["straße STRASSE"]
  assert_eq strings.split_n("straße STRASSE", "", 2), ["s", "traße STRASSE"]
  assert_eq strings.split_n("straße STRASSE", ",", 5), ["straße STRASSE"]
  assert_eq strings.split_n("straße STRASSE", "", 5), ["s", "t", "r", "a", "ße STRASSE"]
  assert_eq strings.fields_func("straße STRASSE", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["straße", "STRASSE"]
  assert_eq strings.split_n("İstanbul ıi", ",", -1), ["İstanbul ıi"]
  assert_eq strings.split_n("İstanbul ıi", "", -1), ["İ", "s", "t", "a", "n", "b", "u", "l", " ", "ı", "i"]
  assert_eq strings.split_n("İstanbul ıi", ",", 0), no_strs()
  assert_eq strings.split_n("İstanbul ıi", "", 0), no_strs()
  assert_eq strings.split_n("İstanbul ıi", ",", 1), ["İstanbul ıi"]
  assert_eq strings.split_n("İstanbul ıi", "", 1), ["İstanbul ıi"]
  assert_eq strings.split_n("İstanbul ıi", ",", 2), ["İstanbul ıi"]
  assert_eq strings.split_n("İstanbul ıi", "", 2), ["İ", "stanbul ıi"]
  assert_eq strings.split_n("İstanbul ıi", ",", 5), ["İstanbul ıi"]
  assert_eq strings.split_n("İstanbul ıi", "", 5), ["İ", "s", "t", "a", "nbul ıi"]
  assert_eq strings.fields_func("İstanbul ıi", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["İstanbul", "ıi"]
  assert_eq strings.split_n("Kelvin K k K", ",", -1), ["Kelvin K k K"]
  assert_eq strings.split_n("Kelvin K k K", "", -1), ["K", "e", "l", "v", "i", "n", " ", "K", " ", "k", " ", "K"]
  assert_eq strings.split_n("Kelvin K k K", ",", 0), no_strs()
  assert_eq strings.split_n("Kelvin K k K", "", 0), no_strs()
  assert_eq strings.split_n("Kelvin K k K", ",", 1), ["Kelvin K k K"]
  assert_eq strings.split_n("Kelvin K k K", "", 1), ["Kelvin K k K"]
  assert_eq strings.split_n("Kelvin K k K", ",", 2), ["Kelvin K k K"]
  assert_eq strings.split_n("Kelvin K k K", "", 2), ["K", "elvin K k K"]
  assert_eq strings.split_n("Kelvin K k K", ",", 5), ["Kelvin K k K"]
  assert_eq strings.split_n("Kelvin K k K", "", 5), ["K", "e", "l", "v", "in K k K"]
  assert_eq strings.fields_func("Kelvin K k K", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["Kelvin", "K", "k", "K"]
  assert_eq strings.split_n("ſ S s", ",", -1), ["ſ S s"]
  assert_eq strings.split_n("ſ S s", "", -1), ["ſ", " ", "S", " ", "s"]
  assert_eq strings.split_n("ſ S s", ",", 0), no_strs()
  assert_eq strings.split_n("ſ S s", "", 0), no_strs()
  assert_eq strings.split_n("ſ S s", ",", 1), ["ſ S s"]
  assert_eq strings.split_n("ſ S s", "", 1), ["ſ S s"]
  assert_eq strings.split_n("ſ S s", ",", 2), ["ſ S s"]
  assert_eq strings.split_n("ſ S s", "", 2), ["ſ", " S s"]
  assert_eq strings.split_n("ſ S s", ",", 5), ["ſ S s"]
  assert_eq strings.split_n("ſ S s", "", 5), ["ſ", " ", "S", " ", "s"]
  assert_eq strings.fields_func("ſ S s", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["ſ", "S", "s"]
  assert_eq strings.split_n("αβγ ΣΣ ς", ",", -1), ["αβγ ΣΣ ς"]
  assert_eq strings.split_n("αβγ ΣΣ ς", "", -1), ["α", "β", "γ", " ", "Σ", "Σ", " ", "ς"]
  assert_eq strings.split_n("αβγ ΣΣ ς", ",", 0), no_strs()
  assert_eq strings.split_n("αβγ ΣΣ ς", "", 0), no_strs()
  assert_eq strings.split_n("αβγ ΣΣ ς", ",", 1), ["αβγ ΣΣ ς"]
  assert_eq strings.split_n("αβγ ΣΣ ς", "", 1), ["αβγ ΣΣ ς"]
  assert_eq strings.split_n("αβγ ΣΣ ς", ",", 2), ["αβγ ΣΣ ς"]
  assert_eq strings.split_n("αβγ ΣΣ ς", "", 2), ["α", "βγ ΣΣ ς"]
  assert_eq strings.split_n("αβγ ΣΣ ς", ",", 5), ["αβγ ΣΣ ς"]
  assert_eq strings.split_n("αβγ ΣΣ ς", "", 5), ["α", "β", "γ", " ", "ΣΣ ς"]
  assert_eq strings.fields_func("αβγ ΣΣ ς", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["αβγ", "ΣΣ", "ς"]
  assert_eq strings.split_n("привет МИР", ",", -1), ["привет МИР"]
  assert_eq strings.split_n("привет МИР", "", -1), ["п", "р", "и", "в", "е", "т", " ", "М", "И", "Р"]
  assert_eq strings.split_n("привет МИР", ",", 0), no_strs()
  assert_eq strings.split_n("привет МИР", "", 0), no_strs()
  assert_eq strings.split_n("привет МИР", ",", 1), ["привет МИР"]
  assert_eq strings.split_n("привет МИР", "", 1), ["привет МИР"]
  assert_eq strings.split_n("привет МИР", ",", 2), ["привет МИР"]
  assert_eq strings.split_n("привет МИР", "", 2), ["п", "ривет МИР"]
  assert_eq strings.split_n("привет МИР", ",", 5), ["привет МИР"]
  assert_eq strings.split_n("привет МИР", "", 5), ["п", "р", "и", "в", "ет МИР"]
  assert_eq strings.fields_func("привет МИР", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["привет", "МИР"]
  assert_eq strings.split_n("日本語 テキスト", ",", -1), ["日本語 テキスト"]
  assert_eq strings.split_n("日本語 テキスト", "", -1), ["日", "本", "語", " ", "テ", "キ", "ス", "ト"]
  assert_eq strings.split_n("日本語 テキスト", ",", 0), no_strs()
  assert_eq strings.split_n("日本語 テキスト", "", 0), no_strs()
  assert_eq strings.split_n("日本語 テキスト", ",", 1), ["日本語 テキスト"]
  assert_eq strings.split_n("日本語 テキスト", "", 1), ["日本語 テキスト"]
  assert_eq strings.split_n("日本語 テキスト", ",", 2), ["日本語 テキスト"]
  assert_eq strings.split_n("日本語 テキスト", "", 2), ["日", "本語 テキスト"]
  assert_eq strings.split_n("日本語 テキスト", ",", 5), ["日本語 テキスト"]
  assert_eq strings.split_n("日本語 テキスト", "", 5), ["日", "本", "語", " ", "テキスト"]
  assert_eq strings.fields_func("日本語 テキスト", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["日本語", "テキスト"]
  assert_eq strings.split_n("😀 smile 😀", ",", -1), ["😀 smile 😀"]
  assert_eq strings.split_n("😀 smile 😀", "", -1), ["😀", " ", "s", "m", "i", "l", "e", " ", "😀"]
  assert_eq strings.split_n("😀 smile 😀", ",", 0), no_strs()
  assert_eq strings.split_n("😀 smile 😀", "", 0), no_strs()
  assert_eq strings.split_n("😀 smile 😀", ",", 1), ["😀 smile 😀"]
  assert_eq strings.split_n("😀 smile 😀", "", 1), ["😀 smile 😀"]
  assert_eq strings.split_n("😀 smile 😀", ",", 2), ["😀 smile 😀"]
  assert_eq strings.split_n("😀 smile 😀", "", 2), ["😀", " smile 😀"]
  assert_eq strings.split_n("😀 smile 😀", ",", 5), ["😀 smile 😀"]
  assert_eq strings.split_n("😀 smile 😀", "", 5), ["😀", " ", "s", "m", "ile 😀"]
  assert_eq strings.fields_func("😀 smile 😀", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["smile"]
  assert_eq strings.split_n("𐐨𐐀", ",", -1), ["𐐨𐐀"]
  assert_eq strings.split_n("𐐨𐐀", "", -1), ["𐐨", "𐐀"]
  assert_eq strings.split_n("𐐨𐐀", ",", 0), no_strs()
  assert_eq strings.split_n("𐐨𐐀", "", 0), no_strs()
  assert_eq strings.split_n("𐐨𐐀", ",", 1), ["𐐨𐐀"]
  assert_eq strings.split_n("𐐨𐐀", "", 1), ["𐐨𐐀"]
  assert_eq strings.split_n("𐐨𐐀", ",", 2), ["𐐨𐐀"]
  assert_eq strings.split_n("𐐨𐐀", "", 2), ["𐐨", "𐐀"]
  assert_eq strings.split_n("𐐨𐐀", ",", 5), ["𐐨𐐀"]
  assert_eq strings.split_n("𐐨𐐀", "", 5), ["𐐨", "𐐀"]
  assert_eq strings.fields_func("𐐨𐐀", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["𐐨𐐀"]
  assert_eq strings.split_n("a" + bs([0xff]) + "b", ",", -1), ["a" + bs([0xff]) + "b"]
}

test "repeat and split_n (4)" {
  assert_eq strings.split_n("a" + bs([0xff]) + "b", "", -1), ["a", bs([0xff]), "b"]
  assert_eq strings.split_n("a" + bs([0xff]) + "b", ",", 0), no_strs()
  assert_eq strings.split_n("a" + bs([0xff]) + "b", "", 0), no_strs()
  assert_eq strings.split_n("a" + bs([0xff]) + "b", ",", 1), ["a" + bs([0xff]) + "b"]
  assert_eq strings.split_n("a" + bs([0xff]) + "b", "", 1), ["a" + bs([0xff]) + "b"]
  assert_eq strings.split_n("a" + bs([0xff]) + "b", ",", 2), ["a" + bs([0xff]) + "b"]
  assert_eq strings.split_n("a" + bs([0xff]) + "b", "", 2), ["a", bs([0xff]) + "b"]
  assert_eq strings.split_n("a" + bs([0xff]) + "b", ",", 5), ["a" + bs([0xff]) + "b"]
  assert_eq strings.split_n("a" + bs([0xff]) + "b", "", 5), ["a", bs([0xff]), "b"]
  assert_eq strings.fields_func("a" + bs([0xff]) + "b", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["a", "b"]
  assert_eq strings.split_n(bs([0xff, 0xfe]), ",", -1), [bs([0xff, 0xfe])]
  assert_eq strings.split_n(bs([0xff, 0xfe]), "", -1), [bs([0xff]), bs([0xfe])]
  assert_eq strings.split_n(bs([0xff, 0xfe]), ",", 0), no_strs()
  assert_eq strings.split_n(bs([0xff, 0xfe]), "", 0), no_strs()
  assert_eq strings.split_n(bs([0xff, 0xfe]), ",", 1), [bs([0xff, 0xfe])]
  assert_eq strings.split_n(bs([0xff, 0xfe]), "", 1), [bs([0xff, 0xfe])]
  assert_eq strings.split_n(bs([0xff, 0xfe]), ",", 2), [bs([0xff, 0xfe])]
  assert_eq strings.split_n(bs([0xff, 0xfe]), "", 2), [bs([0xff]), bs([0xfe])]
  assert_eq strings.split_n(bs([0xff, 0xfe]), ",", 5), [bs([0xff, 0xfe])]
  assert_eq strings.split_n(bs([0xff, 0xfe]), "", 5), [bs([0xff]), bs([0xfe])]
  assert_eq strings.fields_func(bs([0xff, 0xfe]), ->(r: Rune) -> Bool { !unicode.is_letter(r) }), no_strs()
  assert_eq strings.split_n(bs([0xe2, 0x98]), ",", -1), [bs([0xe2, 0x98])]
  assert_eq strings.split_n(bs([0xe2, 0x98]), "", -1), [bs([0xe2]), bs([0x98])]
  assert_eq strings.split_n(bs([0xe2, 0x98]), ",", 0), no_strs()
  assert_eq strings.split_n(bs([0xe2, 0x98]), "", 0), no_strs()
  assert_eq strings.split_n(bs([0xe2, 0x98]), ",", 1), [bs([0xe2, 0x98])]
  assert_eq strings.split_n(bs([0xe2, 0x98]), "", 1), [bs([0xe2, 0x98])]
  assert_eq strings.split_n(bs([0xe2, 0x98]), ",", 2), [bs([0xe2, 0x98])]
  assert_eq strings.split_n(bs([0xe2, 0x98]), "", 2), [bs([0xe2]), bs([0x98])]
  assert_eq strings.split_n(bs([0xe2, 0x98]), ",", 5), [bs([0xe2, 0x98])]
  assert_eq strings.split_n(bs([0xe2, 0x98]), "", 5), [bs([0xe2]), bs([0x98])]
  assert_eq strings.fields_func(bs([0xe2, 0x98]), ->(r: Rune) -> Bool { !unicode.is_letter(r) }), no_strs()
  assert_eq strings.split_n("x" + bs([0xc0, 0xaf]) + "y", ",", -1), ["x" + bs([0xc0, 0xaf]) + "y"]
  assert_eq strings.split_n("x" + bs([0xc0, 0xaf]) + "y", "", -1), ["x", bs([0xc0]), bs([0xaf]), "y"]
  assert_eq strings.split_n("x" + bs([0xc0, 0xaf]) + "y", ",", 0), no_strs()
  assert_eq strings.split_n("x" + bs([0xc0, 0xaf]) + "y", "", 0), no_strs()
  assert_eq strings.split_n("x" + bs([0xc0, 0xaf]) + "y", ",", 1), ["x" + bs([0xc0, 0xaf]) + "y"]
  assert_eq strings.split_n("x" + bs([0xc0, 0xaf]) + "y", "", 1), ["x" + bs([0xc0, 0xaf]) + "y"]
  assert_eq strings.split_n("x" + bs([0xc0, 0xaf]) + "y", ",", 2), ["x" + bs([0xc0, 0xaf]) + "y"]
  assert_eq strings.split_n("x" + bs([0xc0, 0xaf]) + "y", "", 2), ["x", bs([0xc0, 0xaf]) + "y"]
  assert_eq strings.split_n("x" + bs([0xc0, 0xaf]) + "y", ",", 5), ["x" + bs([0xc0, 0xaf]) + "y"]
  assert_eq strings.split_n("x" + bs([0xc0, 0xaf]) + "y", "", 5), ["x", bs([0xc0]), bs([0xaf]), "y"]
  assert_eq strings.fields_func("x" + bs([0xc0, 0xaf]) + "y", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["x", "y"]
  assert_eq strings.split_n(bs([0xed, 0xa0, 0x80]) + "z", ",", -1), [bs([0xed, 0xa0, 0x80]) + "z"]
  assert_eq strings.split_n(bs([0xed, 0xa0, 0x80]) + "z", "", -1), [bs([0xed]), bs([0xa0]), bs([0x80]), "z"]
  assert_eq strings.split_n(bs([0xed, 0xa0, 0x80]) + "z", ",", 0), no_strs()
  assert_eq strings.split_n(bs([0xed, 0xa0, 0x80]) + "z", "", 0), no_strs()
  assert_eq strings.split_n(bs([0xed, 0xa0, 0x80]) + "z", ",", 1), [bs([0xed, 0xa0, 0x80]) + "z"]
  assert_eq strings.split_n(bs([0xed, 0xa0, 0x80]) + "z", "", 1), [bs([0xed, 0xa0, 0x80]) + "z"]
  assert_eq strings.split_n(bs([0xed, 0xa0, 0x80]) + "z", ",", 2), [bs([0xed, 0xa0, 0x80]) + "z"]
  assert_eq strings.split_n(bs([0xed, 0xa0, 0x80]) + "z", "", 2), [bs([0xed]), bs([0xa0, 0x80]) + "z"]
  assert_eq strings.split_n(bs([0xed, 0xa0, 0x80]) + "z", ",", 5), [bs([0xed, 0xa0, 0x80]) + "z"]
  assert_eq strings.split_n(bs([0xed, 0xa0, 0x80]) + "z", "", 5), [bs([0xed]), bs([0xa0]), bs([0x80]), "z"]
  assert_eq strings.fields_func(bs([0xed, 0xa0, 0x80]) + "z", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["z"]
  assert_eq strings.split_n(bs([0xf4, 0x90, 0x80, 0x80]), ",", -1), [bs([0xf4, 0x90, 0x80, 0x80])]
  assert_eq strings.split_n(bs([0xf4, 0x90, 0x80, 0x80]), "", -1), [bs([0xf4]), bs([0x90]), bs([0x80]), bs([0x80])]
  assert_eq strings.split_n(bs([0xf4, 0x90, 0x80, 0x80]), ",", 0), no_strs()
  assert_eq strings.split_n(bs([0xf4, 0x90, 0x80, 0x80]), "", 0), no_strs()
  assert_eq strings.split_n(bs([0xf4, 0x90, 0x80, 0x80]), ",", 1), [bs([0xf4, 0x90, 0x80, 0x80])]
  assert_eq strings.split_n(bs([0xf4, 0x90, 0x80, 0x80]), "", 1), [bs([0xf4, 0x90, 0x80, 0x80])]
  assert_eq strings.split_n(bs([0xf4, 0x90, 0x80, 0x80]), ",", 2), [bs([0xf4, 0x90, 0x80, 0x80])]
  assert_eq strings.split_n(bs([0xf4, 0x90, 0x80, 0x80]), "", 2), [bs([0xf4]), bs([0x90, 0x80, 0x80])]
  assert_eq strings.split_n(bs([0xf4, 0x90, 0x80, 0x80]), ",", 5), [bs([0xf4, 0x90, 0x80, 0x80])]
  assert_eq strings.split_n(bs([0xf4, 0x90, 0x80, 0x80]), "", 5), [bs([0xf4]), bs([0x90]), bs([0x80]), bs([0x80])]
  assert_eq strings.fields_func(bs([0xf4, 0x90, 0x80, 0x80]), ->(r: Rune) -> Bool { !unicode.is_letter(r) }), no_strs()
  assert_eq strings.split_n("a\x00b", ",", -1), ["a\x00b"]
  assert_eq strings.split_n("a\x00b", "", -1), ["a", "\x00", "b"]
  assert_eq strings.split_n("a\x00b", ",", 0), no_strs()
  assert_eq strings.split_n("a\x00b", "", 0), no_strs()
  assert_eq strings.split_n("a\x00b", ",", 1), ["a\x00b"]
  assert_eq strings.split_n("a\x00b", "", 1), ["a\x00b"]
  assert_eq strings.split_n("a\x00b", ",", 2), ["a\x00b"]
  assert_eq strings.split_n("a\x00b", "", 2), ["a", "\x00b"]
  assert_eq strings.split_n("a\x00b", ",", 5), ["a\x00b"]
  assert_eq strings.split_n("a\x00b", "", 5), ["a", "\x00", "b"]
  assert_eq strings.fields_func("a\x00b", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["a", "b"]
  assert_eq strings.split_n("�" + bs([0xff]) + "�", ",", -1), ["�" + bs([0xff]) + "�"]
  assert_eq strings.split_n("�" + bs([0xff]) + "�", "", -1), ["�", bs([0xff]), "�"]
  assert_eq strings.split_n("�" + bs([0xff]) + "�", ",", 0), no_strs()
  assert_eq strings.split_n("�" + bs([0xff]) + "�", "", 0), no_strs()
  assert_eq strings.split_n("�" + bs([0xff]) + "�", ",", 1), ["�" + bs([0xff]) + "�"]
  assert_eq strings.split_n("�" + bs([0xff]) + "�", "", 1), ["�" + bs([0xff]) + "�"]
  assert_eq strings.split_n("�" + bs([0xff]) + "�", ",", 2), ["�" + bs([0xff]) + "�"]
  assert_eq strings.split_n("�" + bs([0xff]) + "�", "", 2), ["�", bs([0xff]) + "�"]
  assert_eq strings.split_n("�" + bs([0xff]) + "�", ",", 5), ["�" + bs([0xff]) + "�"]
  assert_eq strings.split_n("�" + bs([0xff]) + "�", "", 5), ["�", bs([0xff]), "�"]
  assert_eq strings.fields_func("�" + bs([0xff]) + "�", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), no_strs()
  assert_eq strings.split_n("line1\nline2\r\nline3", ",", -1), ["line1\nline2\r\nline3"]
  assert_eq strings.split_n("line1\nline2\r\nline3", "", -1), ["l", "i", "n", "e", "1", "\n", "l", "i", "n", "e", "2", "\r", "\n", "l", "i", "n", "e", "3"]
  assert_eq strings.split_n("line1\nline2\r\nline3", ",", 0), no_strs()
  assert_eq strings.split_n("line1\nline2\r\nline3", "", 0), no_strs()
  assert_eq strings.split_n("line1\nline2\r\nline3", ",", 1), ["line1\nline2\r\nline3"]
  assert_eq strings.split_n("line1\nline2\r\nline3", "", 1), ["line1\nline2\r\nline3"]
  assert_eq strings.split_n("line1\nline2\r\nline3", ",", 2), ["line1\nline2\r\nline3"]
  assert_eq strings.split_n("line1\nline2\r\nline3", "", 2), ["l", "ine1\nline2\r\nline3"]
  assert_eq strings.split_n("line1\nline2\r\nline3", ",", 5), ["line1\nline2\r\nline3"]
  assert_eq strings.split_n("line1\nline2\r\nline3", "", 5), ["l", "i", "n", "e", "1\nline2\r\nline3"]
  assert_eq strings.fields_func("line1\nline2\r\nline3", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ["line", "line", "line"]
}
