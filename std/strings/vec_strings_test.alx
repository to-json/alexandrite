  assert_eq strings.index_rune(bs([0xff, 0xfe]), 233), -1
  assert_eq strings.index_rune(bs([0xff, 0xfe]), 128512), -1
  assert_eq strings.index_rune(bs([0xff, 0xfe]), -1), -1
  assert_eq strings.index_rune(bs([0xff, 0xfe]), 55296), -1
  assert_eq strings.index_rune(bs([0xff, 0xfe]), 1114112), -1
  assert_eq strings.equal_fold(bs([0xff, 0xfe]), bs([0xff, 0xfe])), true
  assert_eq strings.equal_fold(bs([0xff, 0xfe]), bs([0xe2, 0x98])), true
