}

test "per string (8)" {
  assert_eq strings.equal_fold(bs([0xe2, 0x98]), bs([0xe2, 0x98])), true
  assert_eq strings.equal_fold(bs([0xe2, 0x98]), "��"), true
  assert_eq strings.equal_fold(bs([0xe2, 0x98]), "��"), true
  assert_eq strings.equal_fold(bs([0xe2, 0x98]), "��"), true
  assert_eq strings.to_upper("x" + bs([0xc0, 0xaf]) + "y"), "X��Y"
  assert_eq strings.to_lower("x" + bs([0xc0, 0xaf]) + "y"), "x��y"
  assert_eq strings.to_title("x" + bs([0xc0, 0xaf]) + "y"), "X��Y"
  assert_eq strings.title("x" + bs([0xc0, 0xaf]) + "y"), "X��y"
  assert_eq strings.trim_space("x" + bs([0xc0, 0xaf]) + "y"), "x" + bs([0xc0, 0xaf]) + "y"
  assert_eq strings.fields("x" + bs([0xc0, 0xaf]) + "y"), ["x" + bs([0xc0, 0xaf]) + "y"]
  assert_eq strings.lines("x" + bs([0xc0, 0xaf]) + "y"), ["x" + bs([0xc0, 0xaf]) + "y"]
  assert_eq strings.to_valid_utf8("x" + bs([0xc0, 0xaf]) + "y", "?"), "x?y"
  assert_eq strings.count("x" + bs([0xc0, 0xaf]) + "y", ""), 5
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "x" + bs([0xc0, 0xaf]) + "y"), "x��y"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "x" + bs([0xc0, 0xaf]) + "y"), "y\uFFFE\uFFFEz"
  assert_eq strings.index_func("x" + bs([0xc0, 0xaf]) + "y", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("x" + bs([0xc0, 0xaf]) + "y", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 3
