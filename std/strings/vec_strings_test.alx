#![test(external)]
# Generated from Go's strings (go run in a scratch dir); do not edit by hand.

import "strings"
import "unicode"

#[track_caller]
def chk_cut(got: (Str, Str)?, before: Str, after: Str, found: Bool) {
  if v = got {
    assert found, "found at #{caller_location}"
    assert_eq v[0], before
    assert_eq v[1], after
  } else {
    assert !found, "not found at #{caller_location}"
  }
}

test "per string" {
  assert_eq strings.to_upper(""), ""
  assert_eq strings.to_lower(""), ""
  assert_eq strings.to_title(""), ""
  assert_eq strings.title(""), ""
  assert_eq strings.trim_space(""), ""
  assert_eq strings.fields(""), no_strs()
  assert_eq strings.lines(""), no_strs()
  assert_eq strings.to_valid_utf8("", "?"), ""
  assert_eq strings.count("", ""), 1
  assert_eq strings.map(->(r: Rune) -> Rune { r }, ""), ""
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, ""), ""
  assert_eq strings.index_func("", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("", ->(r: Rune) -> Bool { unicode.is_letter(r) }), -1
  assert_eq strings.trim_func("", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ""
  assert_eq strings.index_rune("", 97), -1
  assert_eq strings.index_rune("", 65533), -1
  assert_eq strings.index_rune("", 233), -1
  assert_eq strings.index_rune("", 128512), -1
  assert_eq strings.index_rune("", -1), -1
  assert_eq strings.index_rune("", 55296), -1
  assert_eq strings.index_rune("", 1114112), -1
  assert_eq strings.equal_fold("", ""), true
  assert_eq strings.equal_fold("", ""), true
  assert_eq strings.equal_fold("", ""), true
  assert_eq strings.equal_fold("", ""), true
  assert_eq strings.to_upper(" "), " "
  assert_eq strings.to_lower(" "), " "
  assert_eq strings.to_title(" "), " "
  assert_eq strings.title(" "), " "
  assert_eq strings.trim_space(" "), ""
  assert_eq strings.fields(" "), no_strs()
  assert_eq strings.lines(" "), [" "]
  assert_eq strings.to_valid_utf8(" ", "?"), " "
  assert_eq strings.count(" ", ""), 2
  assert_eq strings.map(->(r: Rune) -> Rune { r }, " "), " "
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, " "), "!"
  assert_eq strings.index_func(" ", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func(" ", ->(r: Rune) -> Bool { unicode.is_letter(r) }), -1
  assert_eq strings.trim_func(" ", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ""
  assert_eq strings.index_rune(" ", 97), -1
  assert_eq strings.index_rune(" ", 65533), -1
  assert_eq strings.index_rune(" ", 233), -1
  assert_eq strings.index_rune(" ", 128512), -1
  assert_eq strings.index_rune(" ", -1), -1
  assert_eq strings.index_rune(" ", 55296), -1
  assert_eq strings.index_rune(" ", 1114112), -1
  assert_eq strings.equal_fold(" ", " "), true
  assert_eq strings.equal_fold(" ", "a"), false
  assert_eq strings.equal_fold(" ", "A"), false
  assert_eq strings.equal_fold(" ", " "), true
  assert_eq strings.equal_fold(" ", " "), true
  assert_eq strings.equal_fold(" ", " "), true
  assert_eq strings.to_upper("a"), "A"
  assert_eq strings.to_lower("a"), "a"
  assert_eq strings.to_title("a"), "A"
  assert_eq strings.title("a"), "A"
  assert_eq strings.trim_space("a"), "a"
  assert_eq strings.fields("a"), ["a"]
  assert_eq strings.lines("a"), ["a"]
  assert_eq strings.to_valid_utf8("a", "?"), "a"
  assert_eq strings.count("a", ""), 2
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "a"), "a"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "a"), ""
  assert_eq strings.index_func("a", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("a", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 0
  assert_eq strings.trim_func("a", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "a"
  assert_eq strings.index_rune("a", 97), 0
  assert_eq strings.index_rune("a", 65533), -1
  assert_eq strings.index_rune("a", 233), -1
  assert_eq strings.index_rune("a", 128512), -1
  assert_eq strings.index_rune("a", -1), -1
  assert_eq strings.index_rune("a", 55296), -1
  assert_eq strings.index_rune("a", 1114112), -1
  assert_eq strings.equal_fold("a", " "), false
  assert_eq strings.equal_fold("a", "a"), true
  assert_eq strings.equal_fold("a", "A"), true
  assert_eq strings.equal_fold("a", "A"), true
  assert_eq strings.equal_fold("a", "a"), true
  assert_eq strings.equal_fold("a", "A"), true
  assert_eq strings.to_upper("A"), "A"
  assert_eq strings.to_lower("A"), "a"
  assert_eq strings.to_title("A"), "A"
  assert_eq strings.title("A"), "A"
  assert_eq strings.trim_space("A"), "A"
  assert_eq strings.fields("A"), ["A"]
  assert_eq strings.lines("A"), ["A"]
  assert_eq strings.to_valid_utf8("A", "?"), "A"
  assert_eq strings.count("A", ""), 2
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "A"), "A"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "A"), "B"
  assert_eq strings.index_func("A", ->(r: Rune) -> Bool { unicode.is_upper(r) }), 0
  assert_eq strings.last_index_func("A", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 0
  assert_eq strings.trim_func("A", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "A"
  assert_eq strings.index_rune("A", 97), -1
  assert_eq strings.index_rune("A", 65533), -1
  assert_eq strings.index_rune("A", 233), -1
  assert_eq strings.index_rune("A", 128512), -1
  assert_eq strings.index_rune("A", -1), -1
  assert_eq strings.index_rune("A", 55296), -1
  assert_eq strings.index_rune("A", 1114112), -1
}

test "per string (2)" {
  assert_eq strings.equal_fold("A", " "), false
  assert_eq strings.equal_fold("A", "a"), true
  assert_eq strings.equal_fold("A", "A"), true
  assert_eq strings.equal_fold("A", "A"), true
  assert_eq strings.equal_fold("A", "a"), true
  assert_eq strings.equal_fold("A", "A"), true
  assert_eq strings.to_upper("abc"), "ABC"
  assert_eq strings.to_lower("abc"), "abc"
  assert_eq strings.to_title("abc"), "ABC"
  assert_eq strings.title("abc"), "Abc"
  assert_eq strings.trim_space("abc"), "abc"
  assert_eq strings.fields("abc"), ["abc"]
  assert_eq strings.lines("abc"), ["abc"]
  assert_eq strings.to_valid_utf8("abc", "?"), "abc"
  assert_eq strings.count("abc", ""), 4
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "abc"), "abc"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "abc"), "cd"
  assert_eq strings.index_func("abc", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("abc", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 2
  assert_eq strings.trim_func("abc", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "abc"
  assert_eq strings.index_rune("abc", 97), 0
  assert_eq strings.index_rune("abc", 65533), -1
  assert_eq strings.index_rune("abc", 233), -1
  assert_eq strings.index_rune("abc", 128512), -1
  assert_eq strings.index_rune("abc", -1), -1
  assert_eq strings.index_rune("abc", 55296), -1
  assert_eq strings.index_rune("abc", 1114112), -1
  assert_eq strings.equal_fold("abc", "abc"), true
  assert_eq strings.equal_fold("abc", "a" + bs([0xff]) + "b"), false
  assert_eq strings.equal_fold("abc", "a\x00b"), false
  assert_eq strings.equal_fold("abc", "ABC"), true
  assert_eq strings.equal_fold("abc", "abc"), true
  assert_eq strings.equal_fold("abc", "ABC"), true
  assert_eq strings.to_upper("a,b,c"), "A,B,C"
  assert_eq strings.to_lower("a,b,c"), "a,b,c"
  assert_eq strings.to_title("a,b,c"), "A,B,C"
  assert_eq strings.title("a,b,c"), "A,B,C"
  assert_eq strings.trim_space("a,b,c"), "a,b,c"
  assert_eq strings.fields("a,b,c"), ["a,b,c"]
  assert_eq strings.lines("a,b,c"), ["a,b,c"]
  assert_eq strings.to_valid_utf8("a,b,c", "?"), "a,b,c"
  assert_eq strings.count("a,b,c", ""), 6
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "a,b,c"), "a,b,c"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "a,b,c"), "-c-d"
  assert_eq strings.index_func("a,b,c", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("a,b,c", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 4
  assert_eq strings.trim_func("a,b,c", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "a,b,c"
  assert_eq strings.index_rune("a,b,c", 97), 0
  assert_eq strings.index_rune("a,b,c", 65533), -1
  assert_eq strings.index_rune("a,b,c", 233), -1
  assert_eq strings.index_rune("a,b,c", 128512), -1
  assert_eq strings.index_rune("a,b,c", -1), -1
  assert_eq strings.index_rune("a,b,c", 55296), -1
  assert_eq strings.index_rune("a,b,c", 1114112), -1
  assert_eq strings.equal_fold("a,b,c", "a,b,c"), true
  assert_eq strings.equal_fold("a,b,c", "A,B,C"), true
  assert_eq strings.equal_fold("a,b,c", "a,b,c"), true
  assert_eq strings.equal_fold("a,b,c", "A,B,C"), true
  assert_eq strings.to_upper(",a,,b,"), ",A,,B,"
  assert_eq strings.to_lower(",a,,b,"), ",a,,b,"
  assert_eq strings.to_title(",a,,b,"), ",A,,B,"
  assert_eq strings.title(",a,,b,"), ",A,,B,"
  assert_eq strings.trim_space(",a,,b,"), ",a,,b,"
  assert_eq strings.fields(",a,,b,"), [",a,,b,"]
  assert_eq strings.lines(",a,,b,"), [",a,,b,"]
  assert_eq strings.to_valid_utf8(",a,,b,", "?"), ",a,,b,"
  assert_eq strings.count(",a,,b,", ""), 7
  assert_eq strings.map(->(r: Rune) -> Rune { r }, ",a,,b,"), ",a,,b,"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, ",a,,b,"), "---c-"
  assert_eq strings.index_func(",a,,b,", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func(",a,,b,", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 4
  assert_eq strings.trim_func(",a,,b,", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "a,,b"
  assert_eq strings.index_rune(",a,,b,", 97), 1
  assert_eq strings.index_rune(",a,,b,", 65533), -1
  assert_eq strings.index_rune(",a,,b,", 233), -1
  assert_eq strings.index_rune(",a,,b,", 128512), -1
  assert_eq strings.index_rune(",a,,b,", -1), -1
  assert_eq strings.index_rune(",a,,b,", 55296), -1
  assert_eq strings.index_rune(",a,,b,", 1114112), -1
  assert_eq strings.equal_fold(",a,,b,", ",a,,b,"), true
  assert_eq strings.equal_fold(",a,,b,", "ſ S s"), false
  assert_eq strings.equal_fold(",a,,b,", ",A,,B,"), true
  assert_eq strings.equal_fold(",a,,b,", ",a,,b,"), true
  assert_eq strings.equal_fold(",a,,b,", ",A,,B,"), true
  assert_eq strings.to_upper("aaaa"), "AAAA"
  assert_eq strings.to_lower("aaaa"), "aaaa"
  assert_eq strings.to_title("aaaa"), "AAAA"
  assert_eq strings.title("aaaa"), "Aaaa"
  assert_eq strings.trim_space("aaaa"), "aaaa"
  assert_eq strings.fields("aaaa"), ["aaaa"]
  assert_eq strings.lines("aaaa"), ["aaaa"]
  assert_eq strings.to_valid_utf8("aaaa", "?"), "aaaa"
  assert_eq strings.count("aaaa", ""), 5
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "aaaa"), "aaaa"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "aaaa"), ""
  assert_eq strings.index_func("aaaa", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("aaaa", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 3
  assert_eq strings.trim_func("aaaa", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "aaaa"
  assert_eq strings.index_rune("aaaa", 97), 0
  assert_eq strings.index_rune("aaaa", 65533), -1
}

test "per string (3)" {
  assert_eq strings.index_rune("aaaa", 233), -1
  assert_eq strings.index_rune("aaaa", 128512), -1
  assert_eq strings.index_rune("aaaa", -1), -1
  assert_eq strings.index_rune("aaaa", 55296), -1
  assert_eq strings.index_rune("aaaa", 1114112), -1
  assert_eq strings.equal_fold("aaaa", "aaaa"), true
  assert_eq strings.equal_fold("aaaa", "x" + bs([0xc0, 0xaf]) + "y"), false
  assert_eq strings.equal_fold("aaaa", bs([0xed, 0xa0, 0x80]) + "z"), false
  assert_eq strings.equal_fold("aaaa", bs([0xf4, 0x90, 0x80, 0x80])), false
  assert_eq strings.equal_fold("aaaa", "AAAA"), true
  assert_eq strings.equal_fold("aaaa", "aaaa"), true
  assert_eq strings.equal_fold("aaaa", "AAAA"), true
  assert_eq strings.to_upper("abcabcabc"), "ABCABCABC"
  assert_eq strings.to_lower("abcabcabc"), "abcabcabc"
  assert_eq strings.to_title("abcabcabc"), "ABCABCABC"
  assert_eq strings.title("abcabcabc"), "Abcabcabc"
  assert_eq strings.trim_space("abcabcabc"), "abcabcabc"
  assert_eq strings.fields("abcabcabc"), ["abcabcabc"]
  assert_eq strings.lines("abcabcabc"), ["abcabcabc"]
  assert_eq strings.to_valid_utf8("abcabcabc", "?"), "abcabcabc"
  assert_eq strings.count("abcabcabc", ""), 10
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "abcabcabc"), "abcabcabc"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "abcabcabc"), "cdcdcd"
  assert_eq strings.index_func("abcabcabc", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("abcabcabc", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 8
  assert_eq strings.trim_func("abcabcabc", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "abcabcabc"
  assert_eq strings.index_rune("abcabcabc", 97), 0
  assert_eq strings.index_rune("abcabcabc", 65533), -1
  assert_eq strings.index_rune("abcabcabc", 233), -1
  assert_eq strings.index_rune("abcabcabc", 128512), -1
  assert_eq strings.index_rune("abcabcabc", -1), -1
  assert_eq strings.index_rune("abcabcabc", 55296), -1
  assert_eq strings.index_rune("abcabcabc", 1114112), -1
  assert_eq strings.equal_fold("abcabcabc", "abcabcabc"), true
  assert_eq strings.equal_fold("abcabcabc", "ABCABCABC"), true
  assert_eq strings.equal_fold("abcabcabc", "abcabcabc"), true
  assert_eq strings.equal_fold("abcabcabc", "ABCABCABC"), true
  assert_eq strings.to_upper("Hello, World"), "HELLO, WORLD"
  assert_eq strings.to_lower("Hello, World"), "hello, world"
  assert_eq strings.to_title("Hello, World"), "HELLO, WORLD"
  assert_eq strings.title("Hello, World"), "Hello, World"
  assert_eq strings.trim_space("Hello, World"), "Hello, World"
  assert_eq strings.fields("Hello, World"), ["Hello,", "World"]
  assert_eq strings.lines("Hello, World"), ["Hello, World"]
  assert_eq strings.to_valid_utf8("Hello, World", "?"), "Hello, World"
  assert_eq strings.count("Hello, World", ""), 13
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "Hello, World"), "Hello, World"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "Hello, World"), "Ifmmp-!Xpsme"
  assert_eq strings.index_func("Hello, World", ->(r: Rune) -> Bool { unicode.is_upper(r) }), 0
  assert_eq strings.last_index_func("Hello, World", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 11
  assert_eq strings.trim_func("Hello, World", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "Hello, World"
  assert_eq strings.index_rune("Hello, World", 97), -1
  assert_eq strings.index_rune("Hello, World", 65533), -1
  assert_eq strings.index_rune("Hello, World", 233), -1
  assert_eq strings.index_rune("Hello, World", 128512), -1
  assert_eq strings.index_rune("Hello, World", -1), -1
  assert_eq strings.index_rune("Hello, World", 55296), -1
  assert_eq strings.index_rune("Hello, World", 1114112), -1
  assert_eq strings.equal_fold("Hello, World", "Hello, World"), true
  assert_eq strings.equal_fold("Hello, World", "HELLO, WORLD"), true
  assert_eq strings.equal_fold("Hello, World", "hello, world"), true
  assert_eq strings.equal_fold("Hello, World", "HELLO, WORLD"), true
  assert_eq strings.to_upper("  lots   of\tspace \n"), "  LOTS   OF\tSPACE \n"
  assert_eq strings.to_lower("  lots   of\tspace \n"), "  lots   of\tspace \n"
  assert_eq strings.to_title("  lots   of\tspace \n"), "  LOTS   OF\tSPACE \n"
  assert_eq strings.title("  lots   of\tspace \n"), "  Lots   Of\tSpace \n"
  assert_eq strings.trim_space("  lots   of\tspace \n"), "lots   of\tspace"
  assert_eq strings.fields("  lots   of\tspace \n"), ["lots", "of", "space"]
  assert_eq strings.lines("  lots   of\tspace \n"), ["  lots   of\tspace \n"]
  assert_eq strings.to_valid_utf8("  lots   of\tspace \n", "?"), "  lots   of\tspace \n"
  assert_eq strings.count("  lots   of\tspace \n", ""), 20
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "  lots   of\tspace \n"), "  lots   of\tspace \n"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "  lots   of\tspace \n"), "!!mput!!!pg\ntqdf!\x0b"
  assert_eq strings.index_func("  lots   of\tspace \n", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("  lots   of\tspace \n", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 16
  assert_eq strings.trim_func("  lots   of\tspace \n", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "lots   of\tspace"
  assert_eq strings.index_rune("  lots   of\tspace \n", 97), 14
  assert_eq strings.index_rune("  lots   of\tspace \n", 65533), -1
  assert_eq strings.index_rune("  lots   of\tspace \n", 233), -1
  assert_eq strings.index_rune("  lots   of\tspace \n", 128512), -1
  assert_eq strings.index_rune("  lots   of\tspace \n", -1), -1
  assert_eq strings.index_rune("  lots   of\tspace \n", 55296), -1
  assert_eq strings.index_rune("  lots   of\tspace \n", 1114112), -1
  assert_eq strings.equal_fold("  lots   of\tspace \n", "  lots   of\tspace \n"), true
  assert_eq strings.equal_fold("  lots   of\tspace \n", "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), false
  assert_eq strings.equal_fold("  lots   of\tspace \n", "привет МИР"), false
  assert_eq strings.equal_fold("  lots   of\tspace \n", "  LOTS   OF\tSPACE \n"), true
  assert_eq strings.equal_fold("  lots   of\tspace \n", "  lots   of\tspace \n"), true
  assert_eq strings.equal_fold("  lots   of\tspace \n", "  LOTS   OF\tSPACE \n"), true
  assert_eq strings.to_upper("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000X\u3000"
  assert_eq strings.to_lower("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"
  assert_eq strings.to_title("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000X\u3000"
  assert_eq strings.title("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000X\u3000"
  assert_eq strings.trim_space("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "x"
  assert_eq strings.fields("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), ["x"]
  assert_eq strings.lines("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), ["\t\x0b\r\x0c\n", "\u0085\u00A0\u2000\u3000x\u3000"]
  assert_eq strings.to_valid_utf8("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "?"), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"
  assert_eq strings.count("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", ""), 12
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "\n\x0c\x0e\r\x0b\u0086¡\u2001、y、"
}

test "per string (4)" {
  assert_eq strings.index_func("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 15
  assert_eq strings.trim_func("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "x"
  assert_eq strings.index_rune("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", 97), -1
  assert_eq strings.index_rune("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", 65533), -1
  assert_eq strings.index_rune("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", 233), -1
  assert_eq strings.index_rune("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", 128512), -1
  assert_eq strings.index_rune("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", -1), -1
  assert_eq strings.index_rune("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", 55296), -1
  assert_eq strings.index_rune("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", 1114112), -1
  assert_eq strings.equal_fold("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "  lots   of\tspace \n"), false
  assert_eq strings.equal_fold("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), true
  assert_eq strings.equal_fold("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "привет МИР"), false
  assert_eq strings.equal_fold("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000X\u3000"), true
  assert_eq strings.equal_fold("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), true
  assert_eq strings.equal_fold("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000", "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000X\u3000"), true
  assert_eq strings.to_upper("héllo wörld"), "HÉLLO WÖRLD"
  assert_eq strings.to_lower("héllo wörld"), "héllo wörld"
  assert_eq strings.to_title("héllo wörld"), "HÉLLO WÖRLD"
  assert_eq strings.title("héllo wörld"), "Héllo Wörld"
  assert_eq strings.trim_space("héllo wörld"), "héllo wörld"
  assert_eq strings.fields("héllo wörld"), ["héllo", "wörld"]
  assert_eq strings.lines("héllo wörld"), ["héllo wörld"]
  assert_eq strings.to_valid_utf8("héllo wörld", "?"), "héllo wörld"
  assert_eq strings.count("héllo wörld", ""), 12
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "héllo wörld"), "héllo wörld"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "héllo wörld"), "iêmmp!x÷sme"
  assert_eq strings.index_func("héllo wörld", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("héllo wörld", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 12
  assert_eq strings.trim_func("héllo wörld", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "héllo wörld"
  assert_eq strings.index_rune("héllo wörld", 97), -1
  assert_eq strings.index_rune("héllo wörld", 65533), -1
  assert_eq strings.index_rune("héllo wörld", 233), 1
  assert_eq strings.index_rune("héllo wörld", 128512), -1
  assert_eq strings.index_rune("héllo wörld", -1), -1
  assert_eq strings.index_rune("héllo wörld", 55296), -1
  assert_eq strings.index_rune("héllo wörld", 1114112), -1
  assert_eq strings.equal_fold("héllo wörld", "héllo wörld"), true
  assert_eq strings.equal_fold("héllo wörld", "İstanbul ıi"), false
  assert_eq strings.equal_fold("héllo wörld", "HÉLLO WÖRLD"), true
  assert_eq strings.equal_fold("héllo wörld", "héllo wörld"), true
  assert_eq strings.equal_fold("héllo wörld", "HÉLLO WÖRLD"), true
  assert_eq strings.to_upper("ÀÉÎÕÜ àéîõü"), "ÀÉÎÕÜ ÀÉÎÕÜ"
  assert_eq strings.to_lower("ÀÉÎÕÜ àéîõü"), "àéîõü àéîõü"
  assert_eq strings.to_title("ÀÉÎÕÜ àéîõü"), "ÀÉÎÕÜ ÀÉÎÕÜ"
  assert_eq strings.title("ÀÉÎÕÜ àéîõü"), "ÀÉÎÕÜ Àéîõü"
  assert_eq strings.trim_space("ÀÉÎÕÜ àéîõü"), "ÀÉÎÕÜ àéîõü"
  assert_eq strings.fields("ÀÉÎÕÜ àéîõü"), ["ÀÉÎÕÜ", "àéîõü"]
  assert_eq strings.lines("ÀÉÎÕÜ àéîõü"), ["ÀÉÎÕÜ àéîõü"]
  assert_eq strings.to_valid_utf8("ÀÉÎÕÜ àéîõü", "?"), "ÀÉÎÕÜ àéîõü"
  assert_eq strings.count("ÀÉÎÕÜ àéîõü", ""), 12
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "ÀÉÎÕÜ àéîõü"), "ÀÉÎÕÜ àéîõü"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "ÀÉÎÕÜ àéîõü"), "ÁÊÏÖÝ!áêïöý"
  assert_eq strings.index_func("ÀÉÎÕÜ àéîõü", ->(r: Rune) -> Bool { unicode.is_upper(r) }), 0
  assert_eq strings.last_index_func("ÀÉÎÕÜ àéîõü", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 19
  assert_eq strings.trim_func("ÀÉÎÕÜ àéîõü", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "ÀÉÎÕÜ àéîõü"
  assert_eq strings.index_rune("ÀÉÎÕÜ àéîõü", 97), -1
  assert_eq strings.index_rune("ÀÉÎÕÜ àéîõü", 65533), -1
  assert_eq strings.index_rune("ÀÉÎÕÜ àéîõü", 233), 13
  assert_eq strings.index_rune("ÀÉÎÕÜ àéîõü", 128512), -1
  assert_eq strings.index_rune("ÀÉÎÕÜ àéîõü", -1), -1
  assert_eq strings.index_rune("ÀÉÎÕÜ àéîõü", 55296), -1
  assert_eq strings.index_rune("ÀÉÎÕÜ àéîõü", 1114112), -1
  assert_eq strings.equal_fold("ÀÉÎÕÜ àéîõü", "ÀÉÎÕÜ àéîõü"), true
  assert_eq strings.equal_fold("ÀÉÎÕÜ àéîõü", "ÀÉÎÕÜ ÀÉÎÕÜ"), true
  assert_eq strings.equal_fold("ÀÉÎÕÜ àéîõü", "àéîõü àéîõü"), true
  assert_eq strings.equal_fold("ÀÉÎÕÜ àéîõü", "ÀÉÎÕÜ ÀÉÎÕÜ"), true
  assert_eq strings.to_upper("ǅǆǄ ǈǉ"), "ǄǄǄ ǇǇ"
  assert_eq strings.to_lower("ǅǆǄ ǈǉ"), "ǆǆǆ ǉǉ"
  assert_eq strings.to_title("ǅǆǄ ǈǉ"), "ǅǅǅ ǈǈ"
  assert_eq strings.title("ǅǆǄ ǈǉ"), "ǅǆǄ ǈǉ"
  assert_eq strings.trim_space("ǅǆǄ ǈǉ"), "ǅǆǄ ǈǉ"
  assert_eq strings.fields("ǅǆǄ ǈǉ"), ["ǅǆǄ", "ǈǉ"]
  assert_eq strings.lines("ǅǆǄ ǈǉ"), ["ǅǆǄ ǈǉ"]
  assert_eq strings.to_valid_utf8("ǅǆǄ ǈǉ", "?"), "ǅǆǄ ǈǉ"
  assert_eq strings.count("ǅǆǄ ǈǉ", ""), 7
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "ǅǆǄ ǈǉ"), "ǅǆǄ ǈǉ"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "ǅǆǄ ǈǉ"), "ǆǇǅ!ǉǊ"
  assert_eq strings.index_func("ǅǆǄ ǈǉ", ->(r: Rune) -> Bool { unicode.is_upper(r) }), 4
  assert_eq strings.last_index_func("ǅǆǄ ǈǉ", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 9
  assert_eq strings.trim_func("ǅǆǄ ǈǉ", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "ǅǆǄ ǈǉ"
  assert_eq strings.index_rune("ǅǆǄ ǈǉ", 97), -1
  assert_eq strings.index_rune("ǅǆǄ ǈǉ", 65533), -1
  assert_eq strings.index_rune("ǅǆǄ ǈǉ", 233), -1
  assert_eq strings.index_rune("ǅǆǄ ǈǉ", 128512), -1
  assert_eq strings.index_rune("ǅǆǄ ǈǉ", -1), -1
  assert_eq strings.index_rune("ǅǆǄ ǈǉ", 55296), -1
  assert_eq strings.index_rune("ǅǆǄ ǈǉ", 1114112), -1
  assert_eq strings.equal_fold("ǅǆǄ ǈǉ", "ǅǆǄ ǈǉ"), true
  assert_eq strings.equal_fold("ǅǆǄ ǈǉ", "ǄǄǄ ǇǇ"), true
  assert_eq strings.equal_fold("ǅǆǄ ǈǉ", "ǆǆǆ ǉǉ"), true
  assert_eq strings.equal_fold("ǅǆǄ ǈǉ", "ǅǅǅ ǈǈ"), true
  assert_eq strings.to_upper("straße STRASSE"), "STRAßE STRASSE"
  assert_eq strings.to_lower("straße STRASSE"), "straße strasse"
  assert_eq strings.to_title("straße STRASSE"), "STRAßE STRASSE"
  assert_eq strings.title("straße STRASSE"), "Straße STRASSE"
  assert_eq strings.trim_space("straße STRASSE"), "straße STRASSE"
  assert_eq strings.fields("straße STRASSE"), ["straße", "STRASSE"]
  assert_eq strings.lines("straße STRASSE"), ["straße STRASSE"]
  assert_eq strings.to_valid_utf8("straße STRASSE", "?"), "straße STRASSE"
}

test "per string (5)" {
  assert_eq strings.count("straße STRASSE", ""), 15
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "straße STRASSE"), "straße STRASSE"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "straße STRASSE"), "tusàf!TUSBTTF"
  assert_eq strings.index_func("straße STRASSE", ->(r: Rune) -> Bool { unicode.is_upper(r) }), 8
  assert_eq strings.last_index_func("straße STRASSE", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 14
  assert_eq strings.trim_func("straße STRASSE", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "straße STRASSE"
  assert_eq strings.index_rune("straße STRASSE", 97), 3
  assert_eq strings.index_rune("straße STRASSE", 65533), -1
  assert_eq strings.index_rune("straße STRASSE", 233), -1
  assert_eq strings.index_rune("straße STRASSE", 128512), -1
  assert_eq strings.index_rune("straße STRASSE", -1), -1
  assert_eq strings.index_rune("straße STRASSE", 55296), -1
  assert_eq strings.index_rune("straße STRASSE", 1114112), -1
  assert_eq strings.equal_fold("straße STRASSE", "straße STRASSE"), true
  assert_eq strings.equal_fold("straße STRASSE", "😀 smile 😀"), false
  assert_eq strings.equal_fold("straße STRASSE", "STRAßE STRASSE"), true
  assert_eq strings.equal_fold("straße STRASSE", "straße strasse"), true
  assert_eq strings.equal_fold("straße STRASSE", "STRAßE STRASSE"), true
  assert_eq strings.to_upper("İstanbul ıi"), "İSTANBUL II"
  assert_eq strings.to_lower("İstanbul ıi"), "istanbul ıi"
  assert_eq strings.to_title("İstanbul ıi"), "İSTANBUL II"
  assert_eq strings.title("İstanbul ıi"), "İstanbul Ii"
  assert_eq strings.trim_space("İstanbul ıi"), "İstanbul ıi"
  assert_eq strings.fields("İstanbul ıi"), ["İstanbul", "ıi"]
  assert_eq strings.lines("İstanbul ıi"), ["İstanbul ıi"]
  assert_eq strings.to_valid_utf8("İstanbul ıi", "?"), "İstanbul ıi"
  assert_eq strings.count("İstanbul ıi", ""), 12
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "İstanbul ıi"), "İstanbul ıi"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "İstanbul ıi"), "ıtuocvm!Ĳj"
  assert_eq strings.index_func("İstanbul ıi", ->(r: Rune) -> Bool { unicode.is_upper(r) }), 0
  assert_eq strings.last_index_func("İstanbul ıi", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 12
  assert_eq strings.trim_func("İstanbul ıi", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "İstanbul ıi"
  assert_eq strings.index_rune("İstanbul ıi", 97), 4
  assert_eq strings.index_rune("İstanbul ıi", 65533), -1
  assert_eq strings.index_rune("İstanbul ıi", 233), -1
  assert_eq strings.index_rune("İstanbul ıi", 128512), -1
  assert_eq strings.index_rune("İstanbul ıi", -1), -1
  assert_eq strings.index_rune("İstanbul ıi", 55296), -1
  assert_eq strings.index_rune("İstanbul ıi", 1114112), -1
  assert_eq strings.equal_fold("İstanbul ıi", "héllo wörld"), false
  assert_eq strings.equal_fold("İstanbul ıi", "İstanbul ıi"), true
  assert_eq strings.equal_fold("İstanbul ıi", "İSTANBUL II"), false
  assert_eq strings.equal_fold("İstanbul ıi", "istanbul ıi"), false
  assert_eq strings.equal_fold("İstanbul ıi", "İSTANBUL II"), false
  assert_eq strings.to_upper("Kelvin K k K"), "KELVIN K K K"
  assert_eq strings.to_lower("Kelvin K k K"), "kelvin k k k"
  assert_eq strings.to_title("Kelvin K k K"), "KELVIN K K K"
  assert_eq strings.title("Kelvin K k K"), "Kelvin K K K"
  assert_eq strings.trim_space("Kelvin K k K"), "Kelvin K k K"
  assert_eq strings.fields("Kelvin K k K"), ["Kelvin", "K", "k", "K"]
  assert_eq strings.lines("Kelvin K k K"), ["Kelvin K k K"]
  assert_eq strings.to_valid_utf8("Kelvin K k K", "?"), "Kelvin K k K"
  assert_eq strings.count("Kelvin K k K", ""), 13
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "Kelvin K k K"), "Kelvin K k K"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "Kelvin K k K"), "Lfmwjo!Å!l!L"
  assert_eq strings.index_func("Kelvin K k K", ->(r: Rune) -> Bool { unicode.is_upper(r) }), 0
  assert_eq strings.last_index_func("Kelvin K k K", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 13
  assert_eq strings.trim_func("Kelvin K k K", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "Kelvin K k K"
  assert_eq strings.index_rune("Kelvin K k K", 97), -1
  assert_eq strings.index_rune("Kelvin K k K", 65533), -1
  assert_eq strings.index_rune("Kelvin K k K", 233), -1
  assert_eq strings.index_rune("Kelvin K k K", 128512), -1
  assert_eq strings.index_rune("Kelvin K k K", -1), -1
  assert_eq strings.index_rune("Kelvin K k K", 55296), -1
  assert_eq strings.index_rune("Kelvin K k K", 1114112), -1
  assert_eq strings.equal_fold("Kelvin K k K", "Kelvin K k K"), true
  assert_eq strings.equal_fold("Kelvin K k K", "αβγ ΣΣ ς"), false
  assert_eq strings.equal_fold("Kelvin K k K", "KELVIN K K K"), true
  assert_eq strings.equal_fold("Kelvin K k K", "kelvin k k k"), true
  assert_eq strings.equal_fold("Kelvin K k K", "KELVIN K K K"), true
  assert_eq strings.to_upper("ſ S s"), "S S S"
  assert_eq strings.to_lower("ſ S s"), "ſ s s"
  assert_eq strings.to_title("ſ S s"), "S S S"
  assert_eq strings.title("ſ S s"), "S S S"
  assert_eq strings.trim_space("ſ S s"), "ſ S s"
  assert_eq strings.fields("ſ S s"), ["ſ", "S", "s"]
  assert_eq strings.lines("ſ S s"), ["ſ S s"]
  assert_eq strings.to_valid_utf8("ſ S s", "?"), "ſ S s"
  assert_eq strings.count("ſ S s", ""), 6
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "ſ S s"), "ſ S s"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "ſ S s"), "ƀ!T!t"
  assert_eq strings.index_func("ſ S s", ->(r: Rune) -> Bool { unicode.is_upper(r) }), 3
  assert_eq strings.last_index_func("ſ S s", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 5
  assert_eq strings.trim_func("ſ S s", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "ſ S s"
  assert_eq strings.index_rune("ſ S s", 97), -1
  assert_eq strings.index_rune("ſ S s", 65533), -1
  assert_eq strings.index_rune("ſ S s", 233), -1
  assert_eq strings.index_rune("ſ S s", 128512), -1
  assert_eq strings.index_rune("ſ S s", -1), -1
  assert_eq strings.index_rune("ſ S s", 55296), -1
  assert_eq strings.index_rune("ſ S s", 1114112), -1
  assert_eq strings.equal_fold("ſ S s", ",a,,b,"), false
  assert_eq strings.equal_fold("ſ S s", "ſ S s"), true
  assert_eq strings.equal_fold("ſ S s", "S S S"), true
  assert_eq strings.equal_fold("ſ S s", "ſ s s"), true
  assert_eq strings.equal_fold("ſ S s", "S S S"), true
  assert_eq strings.to_upper("αβγ ΣΣ ς"), "ΑΒΓ ΣΣ Σ"
  assert_eq strings.to_lower("αβγ ΣΣ ς"), "αβγ σσ ς"
  assert_eq strings.to_title("αβγ ΣΣ ς"), "ΑΒΓ ΣΣ Σ"
  assert_eq strings.title("αβγ ΣΣ ς"), "Αβγ ΣΣ Σ"
}

test "per string (6)" {
  assert_eq strings.trim_space("αβγ ΣΣ ς"), "αβγ ΣΣ ς"
  assert_eq strings.fields("αβγ ΣΣ ς"), ["αβγ", "ΣΣ", "ς"]
  assert_eq strings.lines("αβγ ΣΣ ς"), ["αβγ ΣΣ ς"]
  assert_eq strings.to_valid_utf8("αβγ ΣΣ ς", "?"), "αβγ ΣΣ ς"
  assert_eq strings.count("αβγ ΣΣ ς", ""), 9
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "αβγ ΣΣ ς"), "αβγ ΣΣ ς"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "αβγ ΣΣ ς"), "βγδ!ΤΤ!σ"
  assert_eq strings.index_func("αβγ ΣΣ ς", ->(r: Rune) -> Bool { unicode.is_upper(r) }), 7
  assert_eq strings.last_index_func("αβγ ΣΣ ς", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 12
  assert_eq strings.trim_func("αβγ ΣΣ ς", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "αβγ ΣΣ ς"
  assert_eq strings.index_rune("αβγ ΣΣ ς", 97), -1
  assert_eq strings.index_rune("αβγ ΣΣ ς", 65533), -1
  assert_eq strings.index_rune("αβγ ΣΣ ς", 233), -1
  assert_eq strings.index_rune("αβγ ΣΣ ς", 128512), -1
  assert_eq strings.index_rune("αβγ ΣΣ ς", -1), -1
  assert_eq strings.index_rune("αβγ ΣΣ ς", 55296), -1
  assert_eq strings.index_rune("αβγ ΣΣ ς", 1114112), -1
  assert_eq strings.equal_fold("αβγ ΣΣ ς", "Kelvin K k K"), false
  assert_eq strings.equal_fold("αβγ ΣΣ ς", "αβγ ΣΣ ς"), true
  assert_eq strings.equal_fold("αβγ ΣΣ ς", "ΑΒΓ ΣΣ Σ"), true
  assert_eq strings.equal_fold("αβγ ΣΣ ς", "αβγ σσ ς"), true
  assert_eq strings.equal_fold("αβγ ΣΣ ς", "ΑΒΓ ΣΣ Σ"), true
  assert_eq strings.to_upper("привет МИР"), "ПРИВЕТ МИР"
  assert_eq strings.to_lower("привет МИР"), "привет мир"
  assert_eq strings.to_title("привет МИР"), "ПРИВЕТ МИР"
  assert_eq strings.title("привет МИР"), "Привет МИР"
  assert_eq strings.trim_space("привет МИР"), "привет МИР"
  assert_eq strings.fields("привет МИР"), ["привет", "МИР"]
  assert_eq strings.lines("привет МИР"), ["привет МИР"]
  assert_eq strings.to_valid_utf8("привет МИР", "?"), "привет МИР"
  assert_eq strings.count("привет МИР", ""), 11
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "привет МИР"), "привет МИР"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "привет МИР"), "рсйгжу!НЙС"
  assert_eq strings.index_func("привет МИР", ->(r: Rune) -> Bool { unicode.is_upper(r) }), 13
  assert_eq strings.last_index_func("привет МИР", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 17
  assert_eq strings.trim_func("привет МИР", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "привет МИР"
  assert_eq strings.index_rune("привет МИР", 97), -1
  assert_eq strings.index_rune("привет МИР", 65533), -1
  assert_eq strings.index_rune("привет МИР", 233), -1
  assert_eq strings.index_rune("привет МИР", 128512), -1
