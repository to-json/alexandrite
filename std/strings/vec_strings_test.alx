  assert_eq strings.to_title("𞤠𞤡𞤢𞤣𞤤𞤥𞤦𞤧𞤨𞤩𞤪𞤫𞤬𞤭𞤮𞤯𞤰𞤱𞤲𞤳𞤴𞤵𞤶𞤷𞤸𞤹𞤺𞤻𞤼𞤽𞤾𞤿"), "𞤠𞤡𞤀𞤁𞤂𞤃𞤄𞤅𞤆𞤇𞤈𞤉𞤊𞤋𞤌𞤍𞤎𞤏𞤐𞤑𞤒𞤓𞤔𞤕𞤖𞤗𞤘𞤙𞤚𞤛𞤜𞤝"
  assert_eq strings.equal_fold(strings.to_upper("𞤠𞤡𞤢𞤣𞤤𞤥𞤦𞤧𞤨𞤩𞤪𞤫𞤬𞤭𞤮𞤯𞤰𞤱𞤲𞤳𞤴𞤵𞤶𞤷𞤸𞤹𞤺𞤻𞤼𞤽𞤾𞤿"), strings.to_lower("𞤠𞤡𞤢𞤣𞤤𞤥𞤦𞤧𞤨𞤩𞤪𞤫𞤬𞤭𞤮𞤯𞤰𞤱𞤲𞤳𞤴𞤵𞤶𞤷𞤸𞤹𞤺𞤻𞤼𞤽𞤾𞤿")), true
  assert_eq strings.to_upper("𞥀𞥁𞥂𞥃𞥊𞥄𞥅𞥆𞥇𞥈𞥉𞥋\U0001E94C\U0001E94D\U0001E94E\U0001E94F𞥐𞥑𞥒𞥓𞥔𞥕𞥖𞥗𞥘𞥙\U0001E95A\U0001E95B\U0001E95C\U0001E95D𞥞𞥟"), "𞤞𞤟𞤠𞤡𞥊𞥄𞥅𞥆𞥇𞥈𞥉𞥋\U0001E94C\U0001E94D\U0001E94E\U0001E94F𞥐𞥑𞥒𞥓𞥔𞥕𞥖𞥗𞥘𞥙\U0001E95A\U0001E95B\U0001E95C\U0001E95D𞥞𞥟"
  assert_eq strings.to_lower("𞥀𞥁𞥂𞥃𞥊𞥄𞥅𞥆𞥇𞥈𞥉𞥋\U0001E94C\U0001E94D\U0001E94E\U0001E94F𞥐𞥑𞥒𞥓𞥔𞥕𞥖𞥗𞥘𞥙\U0001E95A\U0001E95B\U0001E95C\U0001E95D𞥞𞥟"), "𞥀𞥁𞥂𞥃𞥊𞥄𞥅𞥆𞥇𞥈𞥉𞥋\U0001E94C\U0001E94D\U0001E94E\U0001E94F𞥐𞥑𞥒𞥓𞥔𞥕𞥖𞥗𞥘𞥙\U0001E95A\U0001E95B\U0001E95C\U0001E95D𞥞𞥟"
  assert_eq strings.to_title("𞥀𞥁𞥂𞥃𞥊𞥄𞥅𞥆𞥇𞥈𞥉𞥋\U0001E94C\U0001E94D\U0001E94E\U0001E94F𞥐𞥑𞥒𞥓𞥔𞥕𞥖𞥗𞥘𞥙\U0001E95A\U0001E95B\U0001E95C\U0001E95D𞥞𞥟"), "𞤞𞤟𞤠𞤡𞥊𞥄𞥅𞥆𞥇𞥈𞥉𞥋\U0001E94C\U0001E94D\U0001E94E\U0001E94F𞥐𞥑𞥒𞥓𞥔𞥕𞥖𞥗𞥘𞥙\U0001E95A\U0001E95B\U0001E95C\U0001E95D𞥞𞥟"
  assert_eq strings.equal_fold(strings.to_upper("𞥀𞥁𞥂𞥃𞥊𞥄𞥅𞥆𞥇𞥈𞥉𞥋\U0001E94C\U0001E94D\U0001E94E\U0001E94F𞥐𞥑𞥒𞥓𞥔𞥕𞥖𞥗𞥘𞥙\U0001E95A\U0001E95B\U0001E95C\U0001E95D𞥞𞥟"), strings.to_lower("𞥀𞥁𞥂𞥃𞥊𞥄𞥅𞥆𞥇𞥈𞥉𞥋\U0001E94C\U0001E94D\U0001E94E\U0001E94F𞥐𞥑𞥒𞥓𞥔𞥕𞥖𞥗𞥘𞥙\U0001E95A\U0001E95B\U0001E95C\U0001E95D𞥞𞥟")), true
}

test "replacer" {
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace(""), ""
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace(" "), " "
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("a"), "1"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("A"), "A"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("abc"), "12c"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("a,b,c"), "1,2,c"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace(",a,,b,"), ",1,,2,"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("aaaa"), "1111"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("abcabcabc"), "12c12c12c"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("Hello, World"), "Hello, World"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("  lots   of\tspace \n"), "  lots   of\tsp1ce \n"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("héllo wörld"), "héllo wörld"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("ÀÉÎÕÜ àéîõü"), "ÀÉÎÕÜ àéîõü"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("ǅǆǄ ǈǉ"), "ǅǆǄ ǈǉ"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("straße STRASSE"), "str1ße STRASSE"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("İstanbul ıi"), "İst1n2ul ıi"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("Kelvin K k K"), "Kelvin K k K"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("ſ S s"), "ſ S s"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("αβγ ΣΣ ς"), "αβγ ΣΣ ς"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("привет МИР"), "привет МИР"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("日本語 テキスト"), "日本語 テキスト"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("😀 smile 😀"), "😀 smile 😀"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("𐐨𐐀"), "𐐨𐐀"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("a" + bs([0xff]) + "b"), "1" + bs([0xff]) + "2"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace(bs([0xff, 0xfe])), bs([0xff, 0xfe])
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace(bs([0xe2, 0x98])), bs([0xe2, 0x98])
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("x" + bs([0xc0, 0xaf]) + "y"), "x" + bs([0xc0, 0xaf]) + "y"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace(bs([0xed, 0xa0, 0x80]) + "z"), bs([0xed, 0xa0, 0x80]) + "z"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace(bs([0xf4, 0x90, 0x80, 0x80])), bs([0xf4, 0x90, 0x80, 0x80])
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("a\x00b"), "1\x002"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("�" + bs([0xff]) + "�"), "�" + bs([0xff]) + "�"
  assert_eq strings.new_replacer(["a", "1", "b", "2"]).replace("line1\nline2\r\nline3"), "line1\nline2\r\nline3"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace(""), ""
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace(" "), " "
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("a"), "<a>"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("A"), "A"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("abc"), "<a>bc"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("a,b,c"), "<a>,b,c"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace(",a,,b,"), ",<a>,,b,"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("aaaa"), "<a><a><a><a>"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("abcabcabc"), "<a>bc<a>bc<a>bc"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("Hello, World"), "Hello, World"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("  lots   of\tspace \n"), "  lots   of\tsp<a>ce \n"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("héllo wörld"), "hEllo wörld"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("ÀÉÎÕÜ àéîõü"), "ÀÉÎÕÜ àEîõü"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("ǅǆǄ ǈǉ"), "ǅǆǄ ǈǉ"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("straße STRASSE"), "str<a>ße STRASSE"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("İstanbul ıi"), "İst<a>nbul ıi"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("Kelvin K k K"), "Kelvin K k K"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("ſ S s"), "ſ S s"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("αβγ ΣΣ ς"), "αβγ ΣΣ ς"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("привет МИР"), "привет МИР"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("日本語 テキスト"), "日本語 テキスト"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("😀 smile 😀"), "😀 smile 😀"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("𐐨𐐀"), "𐐨𐐀"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("a" + bs([0xff]) + "b"), "<a>[ff]b"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace(bs([0xff, 0xfe])), "[ff]" + bs([0xfe])
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace(bs([0xe2, 0x98])), bs([0xe2, 0x98])
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("x" + bs([0xc0, 0xaf]) + "y"), "x" + bs([0xc0, 0xaf]) + "y"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace(bs([0xed, 0xa0, 0x80]) + "z"), bs([0xed, 0xa0, 0x80]) + "z"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace(bs([0xf4, 0x90, 0x80, 0x80])), bs([0xf4, 0x90, 0x80, 0x80])
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("a\x00b"), "<a>\x00b"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("�" + bs([0xff]) + "�"), "�[ff]�"
  assert_eq strings.new_replacer(["a", "<a>", bs([0xff]), "[ff]", "é", "E"]).replace("line1\nline2\r\nline3"), "line1\nline2\r\nline3"
  assert_eq strings.new_replacer(["ab", "X"]).replace(""), ""
  assert_eq strings.new_replacer(["ab", "X"]).replace(" "), " "
  assert_eq strings.new_replacer(["ab", "X"]).replace("a"), "a"
  assert_eq strings.new_replacer(["ab", "X"]).replace("A"), "A"
  assert_eq strings.new_replacer(["ab", "X"]).replace("abc"), "Xc"
  assert_eq strings.new_replacer(["ab", "X"]).replace("a,b,c"), "a,b,c"
  assert_eq strings.new_replacer(["ab", "X"]).replace(",a,,b,"), ",a,,b,"
  assert_eq strings.new_replacer(["ab", "X"]).replace("aaaa"), "aaaa"
  assert_eq strings.new_replacer(["ab", "X"]).replace("abcabcabc"), "XcXcXc"
  assert_eq strings.new_replacer(["ab", "X"]).replace("Hello, World"), "Hello, World"
  assert_eq strings.new_replacer(["ab", "X"]).replace("  lots   of\tspace \n"), "  lots   of\tspace \n"
  assert_eq strings.new_replacer(["ab", "X"]).replace("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"
  assert_eq strings.new_replacer(["ab", "X"]).replace("héllo wörld"), "héllo wörld"
  assert_eq strings.new_replacer(["ab", "X"]).replace("ÀÉÎÕÜ àéîõü"), "ÀÉÎÕÜ àéîõü"
  assert_eq strings.new_replacer(["ab", "X"]).replace("ǅǆǄ ǈǉ"), "ǅǆǄ ǈǉ"
  assert_eq strings.new_replacer(["ab", "X"]).replace("straße STRASSE"), "straße STRASSE"
  assert_eq strings.new_replacer(["ab", "X"]).replace("İstanbul ıi"), "İstanbul ıi"
  assert_eq strings.new_replacer(["ab", "X"]).replace("Kelvin K k K"), "Kelvin K k K"
  assert_eq strings.new_replacer(["ab", "X"]).replace("ſ S s"), "ſ S s"
  assert_eq strings.new_replacer(["ab", "X"]).replace("αβγ ΣΣ ς"), "αβγ ΣΣ ς"
  assert_eq strings.new_replacer(["ab", "X"]).replace("привет МИР"), "привет МИР"
  assert_eq strings.new_replacer(["ab", "X"]).replace("日本語 テキスト"), "日本語 テキスト"
  assert_eq strings.new_replacer(["ab", "X"]).replace("😀 smile 😀"), "😀 smile 😀"
  assert_eq strings.new_replacer(["ab", "X"]).replace("𐐨𐐀"), "𐐨𐐀"
  assert_eq strings.new_replacer(["ab", "X"]).replace("a" + bs([0xff]) + "b"), "a" + bs([0xff]) + "b"
  assert_eq strings.new_replacer(["ab", "X"]).replace(bs([0xff, 0xfe])), bs([0xff, 0xfe])
  assert_eq strings.new_replacer(["ab", "X"]).replace(bs([0xe2, 0x98])), bs([0xe2, 0x98])
  assert_eq strings.new_replacer(["ab", "X"]).replace("x" + bs([0xc0, 0xaf]) + "y"), "x" + bs([0xc0, 0xaf]) + "y"
  assert_eq strings.new_replacer(["ab", "X"]).replace(bs([0xed, 0xa0, 0x80]) + "z"), bs([0xed, 0xa0, 0x80]) + "z"
  assert_eq strings.new_replacer(["ab", "X"]).replace(bs([0xf4, 0x90, 0x80, 0x80])), bs([0xf4, 0x90, 0x80, 0x80])
  assert_eq strings.new_replacer(["ab", "X"]).replace("a\x00b"), "a\x00b"
  assert_eq strings.new_replacer(["ab", "X"]).replace("�" + bs([0xff]) + "�"), "�" + bs([0xff]) + "�"
  assert_eq strings.new_replacer(["ab", "X"]).replace("line1\nline2\r\nline3"), "line1\nline2\r\nline3"
  assert_eq strings.new_replacer(["", "-"]).replace(""), "-"
}

test "replacer (2)" {
  assert_eq strings.new_replacer(["", "-"]).replace(" "), "- -"
  assert_eq strings.new_replacer(["", "-"]).replace("a"), "-a-"
  assert_eq strings.new_replacer(["", "-"]).replace("A"), "-A-"
  assert_eq strings.new_replacer(["", "-"]).replace("abc"), "-a-b-c-"
  assert_eq strings.new_replacer(["", "-"]).replace("a,b,c"), "-a-,-b-,-c-"
  assert_eq strings.new_replacer(["", "-"]).replace(",a,,b,"), "-,-a-,-,-b-,-"
  assert_eq strings.new_replacer(["", "-"]).replace("aaaa"), "-a-a-a-a-"
  assert_eq strings.new_replacer(["", "-"]).replace("abcabcabc"), "-a-b-c-a-b-c-a-b-c-"
  assert_eq strings.new_replacer(["", "-"]).replace("Hello, World"), "-H-e-l-l-o-,- -W-o-r-l-d-"
  assert_eq strings.new_replacer(["", "-"]).replace("  lots   of\tspace \n"), "- - -l-o-t-s- - - -o-f-\t-s-p-a-c-e- -\n-"
  assert_eq strings.new_replacer(["", "-"]).replace("\t\x0b\r\x0c\n\u0085\u00A0\u2000\u3000x\u3000"), "-\t-\x0b-\r-\x0c-\n-" + bs([0xc2]) + "-" + bs([0x85]) + "-" + bs([0xc2]) + "-" + bs([0xa0]) + "-" + bs([0xe2]) + "-" + bs([0x80]) + "-" + bs([0x80]) + "-" + bs([0xe3]) + "-" + bs([0x80]) + "-" + bs([0x80]) + "-x-" + bs([0xe3]) + "-" + bs([0x80]) + "-" + bs([0x80]) + "-"
  assert_eq strings.new_replacer(["", "-"]).replace("héllo wörld"), "-h-" + bs([0xc3]) + "-" + bs([0xa9]) + "-l-l-o- -w-" + bs([0xc3]) + "-" + bs([0xb6]) + "-r-l-d-"
  assert_eq strings.new_replacer(["", "-"]).replace("ÀÉÎÕÜ àéîõü"), "-" + bs([0xc3]) + "-" + bs([0x80]) + "-" + bs([0xc3]) + "-" + bs([0x89]) + "-" + bs([0xc3]) + "-" + bs([0x8e]) + "-" + bs([0xc3]) + "-" + bs([0x95]) + "-" + bs([0xc3]) + "-" + bs([0x9c]) + "- -" + bs([0xc3]) + "-" + bs([0xa0]) + "-" + bs([0xc3]) + "-" + bs([0xa9]) + "-" + bs([0xc3]) + "-" + bs([0xae]) + "-" + bs([0xc3]) + "-" + bs([0xb5]) + "-" + bs([0xc3]) + "-" + bs([0xbc]) + "-"
  assert_eq strings.new_replacer(["", "-"]).replace("ǅǆǄ ǈǉ"), "-" + bs([0xc7]) + "-" + bs([0x85]) + "-" + bs([0xc7]) + "-" + bs([0x86]) + "-" + bs([0xc7]) + "-" + bs([0x84]) + "- -" + bs([0xc7]) + "-" + bs([0x88]) + "-" + bs([0xc7]) + "-" + bs([0x89]) + "-"
