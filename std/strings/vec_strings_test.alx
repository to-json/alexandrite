  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("𐐨𐐀"), "𐐨𐐀"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("a" + bs([0xff]) + "b"), "a!b"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace(bs([0xff, 0xfe])), "!" + bs([0xfe])
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace(bs([0xe2, 0x98])), bs([0xe2, 0x98])
