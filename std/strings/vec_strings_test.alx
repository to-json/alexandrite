  assert_eq strings.count("日本語 テキスト", ""), 9
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "日本語 テキスト"), "日本語 テキスト"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "日本語 テキスト"), "旦札誟!デギズド"
  assert_eq strings.index_func("日本語 テキスト", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("日本語 テキスト", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 19
  assert_eq strings.trim_func("日本語 テキスト", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "日本語 テキスト"
  assert_eq strings.index_rune("日本語 テキスト", 97), -1
  assert_eq strings.index_rune("日本語 テキスト", 65533), -1
  assert_eq strings.index_rune("日本語 テキスト", 233), -1
  assert_eq strings.index_rune("日本語 テキスト", 128512), -1
  assert_eq strings.index_rune("日本語 テキスト", -1), -1
  assert_eq strings.index_rune("日本語 テキスト", 55296), -1
  assert_eq strings.index_rune("日本語 テキスト", 1114112), -1
  assert_eq strings.equal_fold("日本語 テキスト", "日本語 テキスト"), true
  assert_eq strings.equal_fold("日本語 テキスト", "日本語 テキスト"), true
  assert_eq strings.equal_fold("日本語 テキスト", "日本語 テキスト"), true
  assert_eq strings.equal_fold("日本語 テキスト", "日本語 テキスト"), true
  assert_eq strings.to_upper("😀 smile 😀"), "😀 SMILE 😀"
  assert_eq strings.to_lower("😀 smile 😀"), "😀 smile 😀"
  assert_eq strings.to_title("😀 smile 😀"), "😀 SMILE 😀"
  assert_eq strings.title("😀 smile 😀"), "😀 Smile 😀"
  assert_eq strings.trim_space("😀 smile 😀"), "😀 smile 😀"
  assert_eq strings.fields("😀 smile 😀"), ["😀", "smile", "😀"]
  assert_eq strings.lines("😀 smile 😀"), ["😀 smile 😀"]
  assert_eq strings.to_valid_utf8("😀 smile 😀", "?"), "😀 smile 😀"
  assert_eq strings.count("😀 smile 😀", ""), 10
  assert_eq strings.map(->(r: Rune) -> Rune { r }, "😀 smile 😀"), "😀 smile 😀"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, "😀 smile 😀"), "😁!tnjmf!😁"
  assert_eq strings.index_func("😀 smile 😀", ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func("😀 smile 😀", ->(r: Rune) -> Bool { unicode.is_letter(r) }), 9
  assert_eq strings.trim_func("😀 smile 😀", ->(r: Rune) -> Bool { !unicode.is_letter(r) }), "smile"
