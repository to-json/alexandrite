  assert_eq strings.count(bs([0xe2, 0x98]), ""), 3
  assert_eq strings.map(->(r: Rune) -> Rune { r }, bs([0xe2, 0x98])), "��"
  assert_eq strings.map(->(r: Rune) -> Rune { r == 97 ? -1 : r + 1 }, bs([0xe2, 0x98])), "\uFFFE\uFFFE"
  assert_eq strings.index_func(bs([0xe2, 0x98]), ->(r: Rune) -> Bool { unicode.is_upper(r) }), -1
  assert_eq strings.last_index_func(bs([0xe2, 0x98]), ->(r: Rune) -> Bool { unicode.is_letter(r) }), -1
  assert_eq strings.trim_func(bs([0xe2, 0x98]), ->(r: Rune) -> Bool { !unicode.is_letter(r) }), ""
