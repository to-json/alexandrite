  assert_eq strings.index_rune("x" + bs([0xc0, 0xaf]) + "y", 97), -1
  assert_eq strings.index_rune("x" + bs([0xc0, 0xaf]) + "y", 65533), 1
  assert_eq strings.index_rune("x" + bs([0xc0, 0xaf]) + "y", 233), -1
  assert_eq strings.index_rune("x" + bs([0xc0, 0xaf]) + "y", 128512), -1
  assert_eq strings.index_rune("x" + bs([0xc0, 0xaf]) + "y", -1), -1
  assert_eq strings.index_rune("x" + bs([0xc0, 0xaf]) + "y", 55296), -1
  assert_eq strings.index_rune("x" + bs([0xc0, 0xaf]) + "y", 1114112), -1
  assert_eq strings.equal_fold("x" + bs([0xc0, 0xaf]) + "y", "aaaa"), false
  assert_eq strings.equal_fold("x" + bs([0xc0, 0xaf]) + "y", "x" + bs([0xc0, 0xaf]) + "y"), true
  assert_eq strings.equal_fold("x" + bs([0xc0, 0xaf]) + "y", bs([0xed, 0xa0, 0x80]) + "z"), false
  assert_eq strings.equal_fold("x" + bs([0xc0, 0xaf]) + "y", bs([0xf4, 0x90, 0x80, 0x80])), false
  assert_eq strings.equal_fold("x" + bs([0xc0, 0xaf]) + "y", "X��Y"), true
