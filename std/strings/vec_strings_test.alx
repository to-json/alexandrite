  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("ǅǆǄ ǈǉ"), "ǅǆǄ ǈǉ"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("straße STRASSE"), "straße STRASSE"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("İstanbul ıi"), "İstanbul ıi"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("Kelvin K k K"), "Kelvin K k K"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("ſ S s"), "ſ S s"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("αβγ ΣΣ ς"), "αβγ ΣΣ ς"
  assert_eq strings.new_replacer(["�", "?", bs([0xff]), "!"]).replace("привет МИР"), "привет МИР"
