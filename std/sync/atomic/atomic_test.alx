test "store bool" {
  x = new_bool(false)
  x.store(true)
  assert x.load
  x.store(false)
  assert !x.load
}

# -------------------------------------------------------------------- Hammers

# Go's TestHammer32 / TestHammer64: p tasks add 1 n times each, by add and by
# a compare-and-swap loop; swaps keep the halves of the value consistent.
test "hammer 32" {
  p = 4
  n = 2000
  a = new_int32(0)
  b = new_uint32(0)
  c = new_int32(0)
  d = new_uint32(0)
  done = Chan[Bool].new
  (0...p).each { |_|
    spawn {
      (0...n).each { |_|
        a.add(1)
        b.add(1)
        loop {
          v = c.load
          break if c.compare_and_swap(v, v + 1)
        }
        loop {
          v = d.load
          break if d.compare_and_swap(v, v + 1)
        }
      }
      done << true
    }
  }
  (0...p).each { |_| done.recv }
  assert_eq a.load, (n * p).to_i32
  assert_eq b.load, (n * p).to_u32
  assert_eq c.load, (n * p).to_i32
  assert_eq d.load, (n * p).to_u32
}

test "hammer 64" {
  p = 4
  n = 2000
  a = new_int64(0)
  b = new_uint64(0)
  c = new_int64(0)
  done = Chan[Bool].new
  (0...p).each { |_|
    spawn {
      (0...n).each { |_|
        a.add(1)
        b.add(1)
        loop {
          v = c.load
          break if c.compare_and_swap(v, v + 1)
        }
      }
      done << true
    }
  }
  (0...p).each { |_| done.recv }
  assert_eq a.load, n * p
  assert_eq b.load, (n * p).to_u64
  assert_eq c.load, n * p
}

test "hammer swap 32" {
  x = new_uint32(0)
  done = Chan[Bool].new
  (0...4).each { |t|
    spawn {
      (0...2000).each { |i|
        h: U32 = ((t * 7919 + i) & 0xffff).to_u32
        new = (h << 16) | h
        old = x.swap(new)
        assert old >> 16 == old & 0xffff, "SwapUint32 is not atomic: #{old}"
      }
      done << true
    }
  }
  (0...4).each { |_| done.recv }
}

# Go's TestHammerStoreLoad: the two halves of the value always agree.
test "hammer store load" {
  v32 = new_int32(0)
  v64 = new_uint64(0)
  done = Chan[Bool].new
  procs = 8
  (0...procs).each { |_|
    spawn {
      (0...1000).each { |_|
        v = v32.load
        vlo = v & ((1 << 16) - 1)
        vhi = v >> 16
        assert vlo == vhi, "Int32: #{vlo} != #{vhi}"
        new = v + 1 + (1 << 16)
        new = 0 if vlo == 10000
        v32.store(new)

        w = v64.load
        wlo = w & 0xffffffff
        whi = w >> 32
        assert wlo == whi, "Uint64: #{wlo} != #{whi}"
        w2 = w + 1 + (1 << 32)
        w2 = 0 if wlo == 1000000000
        v64.store(w2)
      }
      done << true
    }
  }
  (0...procs).each { |_| done.recv }
}

# Go's TestStoreLoadSeqCst32: Dekker-style handshake between two tasks.
test "store load seq cst" {
  n = 200
  c = Chan[Bool].new(2)
  x0 = new_int32(0)
  x1 = new_int32(0)
  a = [new_int32(-1), new_int32(-1), new_int32(-1), new_int32(-1), new_int32(-1), new_int32(-1)]
  ok = new_bool(true)
  (0...2).each { |me|
    x = [x0, x1]
    ack = [[a[0], a[1], a[2]], [a[3], a[4], a[5]]]
    spawn {
      he = 1 - me
      i: I32 = 1
      while i < n.to_i32 {
        x[me].store(i)
        my = x[he].load
        ack[me][(i % 3).to_i].store(my)
        while ack[he][(i % 3).to_i].load == -1 {
          t = spawn { 0 }
          t.wait
        }
        his = ack[he][(i % 3).to_i].load
        if (my != i && my != i - 1) || (his != i && his != i - 1) {
          ok.store(false)
          break
        }
        if my != i && his != i {
          ok.store(false)
          break
        }
        ack[me][((i - 1) % 3).to_i].store(-1)
        i += 1
      }
      c << true
    }
  }
  c.recv
  c.recv
  assert ok.load, "store/load are not sequentially consistent"
}

# ---------------------------------------------------------------------- Value

test "value" {
  v: Value[Int] = new_value
  assert_eq v.load, none
  v.store(42)
  assert_eq v.load, 42
  v.store(84)
  assert_eq v.load, 84
}

test "value large" {
  v: Value[Str] = new_value
  v.store("foo")
  assert_eq v.load, "foo"
  v.store("barbaz")
  assert_eq v.load, "barbaz"
}

test "value concurrent" {
  tests: [[U64]] = [[0, 18446744073709551615, 1 + (2 << 32), 3 + (4 << 32)], [0, 65535, 1 + (2 << 8), 3 + (4 << 8)]]
  tests.each { |vals|
    v: Value[U64] = new_value
    done = Chan[Bool].new(8)
    (0...8).each { |p|
      xs = vals.dup
      spawn {
        seed = p + 1
        expected = true
        (0...500).each { |_|
          seed = (seed * 1103515245 + 12345) % 2147483648
          x = xs[seed % xs.size]
          v.store(x)
          got = v.load || 7
          expected = false if !xs.include?(got)
        }
        done << expected
      }
    }
    (0...8).each { |_| assert done.recv || false }
  }
}

# Go's TestValue_Swap (the cases without nil or mixed types, which can't be
# written in alx).
test "value swap" {
  v: Value[Bool] = new_value
  assert_eq v.swap(true), none
  assert_eq v.load, true
  w: Value[Bool] = new_value
  w.store(true)
  assert_eq w.swap(false), true
  assert_eq w.load, false
}

test "value swap concurrent" {
  v: Value[Int] = new_value
  count = new_int64(0)
  m = 50
  n = 200
  done = Chan[Bool].new
  (0...m).each { |k|
    i = k * n
    spawn {
      c = 0
      (i...i + n).each { |new|
        if old = v.swap(new) {
          c += old
        }
      }
      count.add(c)
      done << true
    }
  }
  (0...m).each { |_| done.recv }
  assert_eq count.load + (v.load || 0), (m * n - 1) * (m * n) / 2
}

# Go's TestValue_CompareAndSwap (the cases alx can write).
test "value compare and swap" {
  a: Value[Bool] = new_value
  assert !a.compare_and_swap(true, true)
  b: Value[Bool] = new_value
  b.store(true)
  assert !b.compare_and_swap(false, true)
  assert b.compare_and_swap(true, true)
  # Equal values, not the same object (Go's heapA / heapB).
  c: Value[(Int, Int)] = new_value
  c.store((0, 0))
  assert c.compare_and_swap((0, 0), (1, 0))
  assert_eq c.load, (1, 0)
}

test "value compare and swap concurrent" {
  v: Value[Int] = new_value
  v.store(0)
  m = 8
  n = 50
  done = Chan[Bool].new
  (0...m).each { |i|
    spawn {
      j = i
      while j < m * n {
        if v.compare_and_swap(j, j + 1) {
          j += m
        } else {
          t = spawn { 0 }
          t.wait
        }
      }
      done << true
    }
  }
  (0...m).each { |_| done.recv }
  assert_eq v.load, m * n
}

example "value read mostly" {
  m: Value[Map[Str, Str]] = new_value
  empty: Map[Str, Str] = {}
  m.store(empty)
  writers = Mutex.new(0)
  # Copy-on-write insert: writers serialize on their own lock.
  insert = ->(key: Str, val: Str) {
    writers.lock { |_|
      m2: Map[Str, Str] = {}
      (m.load || {}).each { |k, v| m2[k] = v }
      m2[key] = val
      m.store(m2)
    }
  }
  insert("a", "1")
  insert("b", "2")
  puts (m.load || {})["b"] || "?"
} outputs "2\n"
