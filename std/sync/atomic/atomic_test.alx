# Go's sync/atomic tests (atomic_test.go's method tests, the hammers,
# value_test.go), translated. Go's function forms on addresses (SwapInt32(&x,
# ..)) and the Uintptr / Pointer variants have no alx counterpart; their
# method twins are below. The `magic32` guards around each field test Go's
# memory layout and are dropped.

# ---------------------------------------------------------------------- Swap

test "swap int32" {
  x = new_int32(0)
  j: I32 = 0
  delta: I32 = 1
  while delta +% delta > delta {
    k = x.swap(delta)
    assert x.load == delta && k == j, "delta=#{delta} i=#{x.load} j=#{j} k=#{k}"
    j = delta
    delta = delta +% delta
  }
}

test "swap uint32" {
  x = new_uint32(0)
  j: U32 = 0
  delta: U32 = 1
  while delta +% delta > delta {
    k = x.swap(delta)
    assert x.load == delta && k == j, "delta=#{delta}"
    j = delta
    delta = delta +% delta
  }
}

test "swap int64" {
  x = new_int64(0)
  j = 0
  delta = 1
  while delta +% delta > delta {
    k = x.swap(delta)
    assert x.load == delta && k == j, "delta=#{delta}"
    j = delta
    delta = delta +% delta
  }
}

test "swap uint64" {
  x = new_uint64(0)
  j: U64 = 0
  delta: U64 = 1
  while delta +% delta > delta {
    k = x.swap(delta)
    assert x.load == delta && k == j, "delta=#{delta}"
    j = delta
    delta = delta +% delta
  }
}

test "swap bool" {
  x = new_bool(false)
  assert !x.swap(true)
  assert x.load
  assert x.swap(true)
  assert x.swap(false)
  assert !x.load
}

# ----------------------------------------------------------------------- Add

test "add int32" {
  x = new_int32(0)
  j: I32 = 0
  delta: I32 = 1
  while delta +% delta > delta {
    k = x.add(delta)
    j = j +% delta
    assert x.load == j && k == j, "delta=#{delta} i=#{x.load} j=#{j} k=#{k}"
    delta = delta +% delta
  }
  # Wraps as Go's.
  y = new_int32(2147483647)
  assert_eq y.add(1), -2147483648
  assert_eq y.add(-1), 2147483647
}

test "add uint32" {
  x = new_uint32(0)
  j: U32 = 0
  delta: U32 = 1
  while delta +% delta > delta {
    k = x.add(delta)
    j = j +% delta
    assert x.load == j && k == j, "delta=#{delta}"
    delta = delta +% delta
  }
  # Subtracting c is adding ^(c - 1).
  y = new_uint32(10)
  c: U32 = 3
  assert_eq y.add(^(c - 1)), 7
  e: U32 = 8
  assert_eq y.add(^(e - 1)), 4294967295
}

test "add int64" {
  x = new_int64(0)
  j = 0
  delta = 1
  while delta +% delta > delta {
    k = x.add(delta)
    j = j +% delta
    assert x.load == j && k == j, "delta=#{delta}"
    delta = delta +% delta
  }
  y = new_int64(9223372036854775807)
  assert_eq y.add(1), -9223372036854775808
}

test "add uint64" {
  x = new_uint64(0)
  j: U64 = 0
  delta: U64 = 1
  while delta +% delta > delta {
    k = x.add(delta)
    j = j +% delta
    assert x.load == j && k == j, "delta=#{delta}"
    delta = delta +% delta
  }
  y = new_uint64(18446744073709551615)
  assert_eq y.add(1), 0
  c: U64 = 1
  assert_eq y.add(^(c - 1)), 18446744073709551615
}

# ----------------------------------------------------------------------- And

test "and int32" {
  x = new_int32(-1)
  j = x.load
  mask: I32 = 1
  while mask != 0 {
    old = x.load
    k = x.and(^mask)
    j = j & ^mask
    assert x.load == j && k == old, "mask=#{mask}"
    mask = mask << 1
  }
}

test "and uint32" {
  x = new_uint32(4294967295)
  j = x.load
  mask: U32 = 1
  while mask != 0 {
    old = x.load
    k = x.and(^mask)
    j = j & ^mask
    assert x.load == j && k == old, "mask=#{mask}"
    mask = mask << 1
  }
}

