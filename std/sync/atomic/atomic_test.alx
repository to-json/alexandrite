# ------------------------------------------------------------ CompareAndSwap

test "compare and swap int32" {
  x = new_int32(0)
  val: I32 = 1
  while val +% val > val {
    x.store(val)
    assert x.compare_and_swap(val, val + 1), "should have swapped #{val}"
    assert_eq x.load, val + 1
    x.store(val + 1)
    assert !x.compare_and_swap(val, val + 2), "should not have swapped #{val}"
    assert_eq x.load, val + 1
    val = val +% val
  }
}

test "compare and swap uint32" {
  x = new_uint32(0)
  val: U32 = 1
  while val +% val > val {
    x.store(val)
    assert x.compare_and_swap(val, val + 1)
    assert_eq x.load, val + 1
    x.store(val + 1)
    assert !x.compare_and_swap(val, val + 2)
    assert_eq x.load, val + 1
    val = val +% val
  }
}

test "compare and swap int64" {
  x = new_int64(0)
  val = 1
  while val +% val > val {
    x.store(val)
    assert x.compare_and_swap(val, val + 1)
    assert_eq x.load, val + 1
    x.store(val + 1)
    assert !x.compare_and_swap(val, val + 2)
    assert_eq x.load, val + 1
    val = val +% val
  }
}

test "compare and swap uint64" {
  x = new_uint64(0)
  val: U64 = 1
  while val +% val > val {
    x.store(val)
    assert x.compare_and_swap(val, val + 1)
    assert_eq x.load, val + 1
    x.store(val + 1)
    assert !x.compare_and_swap(val, val + 2)
    assert_eq x.load, val + 1
    val = val +% val
  }
}

test "compare and swap bool" {
  x = new_bool(false)
  assert !x.compare_and_swap(true, false)
  assert x.compare_and_swap(false, true)
  assert x.load
  assert x.compare_and_swap(true, true)
  assert x.load
}

# ----------------------------------------------------------------- Load/Store

test "load int32" {
  x = new_int32(0)
  want: I32 = 0
  delta: I32 = 1
  while delta +% delta > delta {
    k = x.load
    assert_eq k, want
    x.store(k +% delta)
    want = k +% delta
    delta = delta +% delta
  }
}

test "load uint32" {
  x = new_uint32(0)
  want: U32 = 0
  delta: U32 = 1
  while delta +% delta > delta {
    k = x.load
    assert_eq k, want
    x.store(k +% delta)
    want = k +% delta
    delta = delta +% delta
  }
}

test "load int64" {
  x = new_int64(0)
