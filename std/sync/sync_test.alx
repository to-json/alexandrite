test "wait group" {
  wg = new_wait_group
  hits = Atomic.new(0)
  (1..20).each { |i|
    wg.add(1)
    spawn {
      hits.add(i)
      wg.done
    }
  }
  wg.wait
  assert_eq hits.load, 210
  # Reusable once the count is back to 0.
  wg.add(1)
  spawn { wg.done }
  wg.wait
  wg.wait
}

test "once" {
  o = new_once
  count = Atomic.new(0)
  ts = (1..10).map { |_| spawn { o.do { count.add(1) } } }.to_a
  ts.each { it.wait }
  assert_eq count.load, 1
  assert o.done?
}

test "lock" {
  m = new_lock
  total = Atomic.new(0)
  ts = (1..8).map { |_| spawn { (1..100).each { |_| m.with { total.add(1) } } } }.to_a
  ts.each { it.wait }
  assert_eq total.load, 800
}
