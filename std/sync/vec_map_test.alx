  assert_eq vec_range(m), "1:1,3:0,4:3,5:1,7:4"
  assert_eq vec_range(m), "1:1,3:0,4:3,5:1,7:4"
  assert_eq vec_opt(m.load(0)), "none"
  assert_eq vec_opt(m.load(0)), "none"
  assert_eq m.load_or_store(0, 0), (0, false)
  m.delete(7)
  m.store(6, 0)
  assert_eq vec_range(m), "0:0,1:1,3:0,4:3,5:1,6:0"
  assert_eq vec_range(m), "0:0,1:1,3:0,4:3,5:1,6:0"
  assert_eq vec_range(m), "0:0,1:1,3:0,4:3,5:1,6:0"
  assert_eq m.compare_and_delete(7, 3), false
