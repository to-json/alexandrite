  assert_eq m.compare_and_delete(2, 2), false
  m.store(3, 3)
  assert_eq vec_range(m), "3:3,6:4"
  m.store(3, 2)
  m.delete(7)
  assert_eq vec_range(m), "3:2,6:4"
  assert_eq vec_range(m), "3:2,6:4"
  assert_eq vec_opt(m.load_and_delete(4)), "none"
  assert_eq m.compare_and_swap(4, 4, 5), false
  assert_eq vec_opt(m.load_and_delete(3)), "2"
  m.delete(5)
  assert_eq m.load_or_store(7, 1), (1, false)
  m.store(4, 3)
  assert_eq vec_opt(m.load(2)), "none"
  assert_eq vec_opt(m.swap(6, 3)), "4"
  m.store(1, 3)
  assert_eq m.compare_and_delete(4, 1), false
  assert_eq m.compare_and_swap(3, 0, 1), false
  assert_eq m.compare_and_swap(4, 2, 3), false
  assert_eq m.compare_and_swap(5, 3, 4), false
  assert_eq m.compare_and_swap(2, 2, 3), false
  assert_eq m.load_or_store(1, 3), (3, true)
  assert_eq m.compare_and_delete(2, 4), false
  assert_eq vec_opt(m.load_and_delete(7)), "1"
  assert_eq m.compare_and_delete(3, 1), false
  assert_eq m.compare_and_delete(3, 3), false
  assert_eq vec_opt(m.load_and_delete(7)), "none"
  assert_eq m.load_or_store(5, 1), (1, false)
