  assert_eq vec_opt(m.load_and_delete(0)), "4"
  assert_eq vec_range(m), "1:1,4:2,5:1"
  assert_eq m.load_or_store(1, 4), (1, true)
  assert_eq vec_range(m), "1:1,4:2,5:1"
  assert_eq vec_opt(m.swap(3, 2)), "none"
  assert_eq m.compare_and_delete(2, 2), false
  m.store(2, 2)
  assert_eq m.compare_and_delete(4, 0), false
  assert_eq m.compare_and_swap(6, 1, 2), false
  assert_eq m.compare_and_swap(3, 0, 1), false
  assert_eq vec_opt(m.load_and_delete(2)), "2"
  assert_eq m.compare_and_delete(2, 1), false
  assert_eq m.load_or_store(3, 1), (2, true)
  assert_eq m.load_or_store(0, 1), (1, false)
  assert_eq m.load_or_store(7, 2), (2, false)
  assert_eq vec_range(m), "0:1,1:1,3:2,4:2,5:1,7:2"
  assert_eq m.load_or_store(1, 3), (1, true)
  assert_eq m.compare_and_swap(1, 1, 2), true
  assert_eq vec_range(m), "0:1,1:2,3:2,4:2,5:1,7:2"
  assert_eq m.compare_and_swap(0, 4, 5), false
  assert_eq vec_range(m), "0:1,1:2,3:2,4:2,5:1,7:2"
  assert_eq m.compare_and_swap(3, 0, 1), false
  assert_eq vec_range(m), "0:1,1:2,3:2,4:2,5:1,7:2"
  assert_eq vec_range(m), "0:1,1:2,3:2,4:2,5:1,7:2"
}

