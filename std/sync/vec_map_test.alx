}

test "sync.Map ops 2" {
  m: SharedMap[Int, Int] = new_shared_map
  assert_eq vec_range(m), ""
  assert_eq vec_opt(m.load(0)), "none"
  assert_eq m.compare_and_swap(6, 2, 3), false
  assert_eq vec_range(m), ""
  assert_eq vec_opt(m.swap(6, 4)), "none"
  m.store(0, 4)
  assert_eq vec_range(m), "0:4,6:4"
  m.store(5, 3)
  m.delete(3)
  assert_eq m.compare_and_delete(4, 1), false
  assert_eq m.load_or_store(7, 1), (1, false)
  assert_eq m.compare_and_delete(3, 2), false
  assert_eq m.compare_and_delete(0, 1), false
  assert_eq vec_range(m), "0:4,5:3,6:4,7:1"
  m.delete(5)
  assert_eq vec_range(m), "0:4,6:4,7:1"
  assert_eq vec_opt(m.load(5)), "none"
  assert_eq vec_opt(m.swap(5, 2)), "none"
  m.store(1, 1)
  assert_eq m.compare_and_delete(6, 4), true
  assert_eq vec_range(m), "0:4,1:1,5:2,7:1"
  assert_eq m.compare_and_swap(0, 1, 2), false
  m.clear
  m.store(3, 3)
  assert_eq vec_opt(m.load(7)), "none"
  assert_eq m.load_or_store(1, 1), (1, false)
  assert_eq vec_opt(m.swap(7, 0)), "none"
  assert_eq m.compare_and_delete(3, 3), true
  assert_eq m.compare_and_delete(0, 1), false
  assert_eq vec_opt(m.load_and_delete(3)), "none"
  assert_eq m.compare_and_swap(5, 0, 1), false
  assert_eq vec_range(m), "1:1,7:0"
  assert_eq m.load_or_store(3, 2), (2, false)
  assert_eq vec_range(m), "1:1,3:2,7:0"
  assert_eq vec_range(m), "1:1,3:2,7:0"
  m.store(6, 4)
  assert_eq vec_opt(m.load(5)), "none"
  m.delete(0)
  m.delete(7)
  assert_eq vec_range(m), "1:1,3:2,6:4"
  assert_eq m.compare_and_delete(0, 4), false
  assert_eq m.compare_and_delete(6, 1), false
  assert_eq vec_range(m), "1:1,3:2,6:4"
  assert_eq vec_opt(m.swap(4, 3)), "none"
  assert_eq vec_opt(m.swap(6, 0)), "4"
  assert_eq vec_range(m), "1:1,3:2,4:3,6:0"
  assert_eq vec_opt(m.swap(1, 4)), "1"
  assert_eq vec_opt(m.swap(4, 3)), "3"
  m.delete(7)
  assert_eq vec_opt(m.load(5)), "none"
  assert_eq vec_opt(m.swap(4, 0)), "3"
  assert_eq vec_opt(m.load_and_delete(1)), "4"
  assert_eq m.compare_and_delete(2, 3), false
  assert_eq vec_range(m), "3:2,4:0,6:0"
  assert_eq m.compare_and_delete(6, 0), true
  m.store(3, 0)
  assert_eq m.compare_and_swap(4, 4, 5), false
  assert_eq vec_opt(m.load_and_delete(0)), "none"
  assert_eq vec_opt(m.load(2)), "none"
  assert_eq vec_range(m), "3:0,4:0"
  assert_eq vec_opt(m.load(3)), "0"
  assert_eq vec_range(m), "3:0,4:0"
  m.store(1, 3)
  assert_eq vec_range(m), "1:3,3:0,4:0"
  assert_eq vec_opt(m.load(1)), "3"
  assert_eq vec_range(m), "1:3,3:0,4:0"
  assert_eq vec_opt(m.load_and_delete(4)), "0"
  m.store(4, 0)
  assert_eq vec_opt(m.load_and_delete(3)), "0"
  assert_eq m.load_or_store(7, 3), (3, false)
  assert_eq vec_opt(m.swap(5, 3)), "none"
  assert_eq vec_opt(m.swap(1, 2)), "3"
  assert_eq vec_range(m), "1:2,4:0,5:3,7:3"
  assert_eq vec_opt(m.swap(1, 1)), "2"
  assert_eq vec_range(m), "1:1,4:0,5:3,7:3"
  assert_eq m.compare_and_swap(2, 0, 1), false
  assert_eq m.compare_and_swap(6, 4, 5), false
  m.delete(1)
  assert_eq vec_range(m), "4:0,5:3,7:3"
  m.store(6, 2)
  assert_eq vec_opt(m.load_and_delete(6)), "2"
  assert_eq vec_range(m), "4:0,5:3,7:3"
  m.store(2, 4)
  m.clear
  m.delete(3)
  assert_eq m.compare_and_delete(2, 1), false
  assert_eq vec_range(m), ""
  assert_eq vec_opt(m.load_and_delete(6)), "none"
  assert_eq vec_range(m), ""
  assert_eq vec_opt(m.load(4)), "none"
  assert_eq vec_range(m), ""
}

test "sync.Map ops 3" {
  m: SharedMap[Int, Int] = new_shared_map
  m.delete(4)
  assert_eq vec_range(m), ""
  assert_eq m.compare_and_swap(5, 1, 2), false
  assert_eq vec_range(m), ""
  assert_eq m.compare_and_delete(7, 2), false
  m.store(2, 2)
  assert_eq vec_range(m), "2:2"
  assert_eq vec_opt(m.load_and_delete(3)), "none"
  m.clear
  assert_eq vec_opt(m.swap(0, 0)), "none"
  m.delete(7)
  m.delete(3)
  m.delete(2)
  m.store(2, 1)
  assert_eq m.compare_and_swap(1, 4, 5), false
  assert_eq m.load_or_store(7, 4), (4, false)
  m.delete(1)
  m.delete(1)
  assert_eq vec_opt(m.swap(6, 4)), "none"
  assert_eq vec_range(m), "0:0,2:1,6:4,7:4"
  assert_eq vec_range(m), "0:0,2:1,6:4,7:4"
  assert_eq m.compare_and_swap(1, 3, 4), false
  assert_eq m.compare_and_delete(5, 1), false
  assert_eq m.compare_and_swap(6, 0, 1), false
  assert_eq vec_range(m), "0:0,2:1,6:4,7:4"
  assert_eq vec_opt(m.swap(3, 4)), "none"
  assert_eq vec_range(m), "0:0,2:1,3:4,6:4,7:4"
  assert_eq vec_range(m), "0:0,2:1,3:4,6:4,7:4"
  m.store(7, 2)
  m.delete(3)
  m.delete(1)
  assert_eq m.compare_and_swap(7, 1, 2), false
  assert_eq vec_opt(m.load_and_delete(1)), "none"
  assert_eq vec_opt(m.load_and_delete(1)), "none"
  assert_eq m.compare_and_delete(2, 4), false
  assert_eq vec_range(m), "0:0,2:1,6:4,7:2"
  assert_eq vec_range(m), "0:0,2:1,6:4,7:2"
  assert_eq vec_opt(m.swap(4, 2)), "none"
  assert_eq m.compare_and_delete(6, 0), false
  assert_eq vec_opt(m.swap(0, 2)), "0"
  assert_eq vec_opt(m.swap(4, 1)), "2"
  assert_eq m.compare_and_delete(6, 3), false
  assert_eq vec_range(m), "0:2,2:1,4:1,6:4,7:2"
  assert_eq m.load_or_store(6, 4), (4, true)
  assert_eq m.load_or_store(0, 2), (2, true)
  assert_eq vec_opt(m.load_and_delete(1)), "none"
  m.store(6, 0)
  assert_eq vec_opt(m.load(4)), "1"
  assert_eq m.load_or_store(6, 1), (0, true)
  assert_eq vec_opt(m.swap(6, 3)), "0"
  assert_eq vec_opt(m.load(5)), "none"
  assert_eq vec_opt(m.load_and_delete(4)), "1"
  assert_eq m.compare_and_delete(5, 1), false
  assert_eq m.load_or_store(6, 2), (3, true)
  assert_eq vec_range(m), "0:2,2:1,6:3,7:2"
  m.store(6, 1)
  assert_eq vec_opt(m.load(6)), "1"
  assert_eq vec_range(m), "0:2,2:1,6:1,7:2"
  assert_eq vec_opt(m.load(7)), "2"
  assert_eq m.compare_and_delete(7, 1), false
  assert_eq m.compare_and_swap(7, 2, 3), true
  m.store(3, 1)
  assert_eq vec_range(m), "0:2,2:1,3:1,6:1,7:3"
  assert_eq m.compare_and_delete(4, 1), false
  m.delete(5)
  m.delete(4)
  assert_eq vec_opt(m.swap(7, 0)), "3"
  m.store(1, 2)
  assert_eq vec_opt(m.load_and_delete(3)), "1"
  assert_eq m.compare_and_swap(3, 2, 3), false
  assert_eq vec_range(m), "0:2,1:2,2:1,6:1,7:0"
  assert_eq vec_range(m), "0:2,1:2,2:1,6:1,7:0"
  assert_eq vec_range(m), "0:2,1:2,2:1,6:1,7:0"
  m.delete(1)
  assert_eq vec_opt(m.load_and_delete(3)), "none"
  assert_eq vec_opt(m.load(4)), "none"
  assert_eq vec_opt(m.load_and_delete(7)), "0"
  assert_eq vec_opt(m.load(2)), "1"
  assert_eq m.compare_and_swap(7, 2, 3), false
  assert_eq m.compare_and_delete(0, 0), false
  assert_eq m.compare_and_swap(0, 2, 3), true
  assert_eq vec_opt(m.swap(1, 0)), "none"
  m.store(5, 2)
  assert_eq m.compare_and_swap(4, 1, 2), false
  assert_eq vec_opt(m.load(0)), "3"
  m.delete(5)
  assert_eq vec_range(m), "0:3,1:0,2:1,6:1"
  m.delete(7)
  assert_eq vec_range(m), "0:3,1:0,2:1,6:1"
  assert_eq vec_range(m), "0:3,1:0,2:1,6:1"
  assert_eq vec_range(m), "0:3,1:0,2:1,6:1"
}

test "sync.Map ops 4" {
  m: SharedMap[Int, Int] = new_shared_map
  assert_eq vec_opt(m.load_and_delete(3)), "none"
  assert_eq vec_opt(m.load(0)), "none"
  m.store(4, 3)
  assert_eq vec_range(m), "4:3"
  assert_eq m.compare_and_swap(1, 1, 2), false
  assert_eq vec_opt(m.swap(4, 1)), "3"
  m.delete(3)
  assert_eq m.load_or_store(3, 2), (2, false)
  assert_eq vec_range(m), "3:2,4:1"
  assert_eq m.compare_and_swap(7, 0, 1), false
  assert_eq vec_range(m), "3:2,4:1"
  assert_eq m.compare_and_swap(0, 4, 5), false
  m.store(5, 4)
  m.store(5, 0)
  assert_eq vec_opt(m.load(5)), "0"
  assert_eq vec_opt(m.load_and_delete(6)), "none"
  assert_eq vec_range(m), "3:2,4:1,5:0"
  m.delete(4)
  assert_eq vec_opt(m.load(4)), "none"
  m.delete(4)
  assert_eq vec_opt(m.load(2)), "none"
  assert_eq m.compare_and_swap(4, 3, 4), false
  assert_eq m.compare_and_swap(6, 1, 2), false
  assert_eq vec_opt(m.load(1)), "none"
  assert_eq m.compare_and_swap(3, 3, 4), false
  assert_eq m.compare_and_swap(4, 2, 3), false
  assert_eq m.load_or_store(4, 3), (3, false)
  assert_eq m.load_or_store(0, 0), (0, false)
  m.delete(5)
  assert_eq vec_range(m), "0:0,3:2,4:3"
  assert_eq vec_opt(m.load(3)), "2"
  assert_eq vec_range(m), "0:0,3:2,4:3"
  assert_eq vec_opt(m.load_and_delete(7)), "none"
  assert_eq vec_opt(m.swap(2, 3)), "none"
  assert_eq vec_opt(m.load_and_delete(6)), "none"
  assert_eq vec_range(m), "0:0,2:3,3:2,4:3"
  assert_eq vec_range(m), "0:0,2:3,3:2,4:3"
  m.store(6, 2)
  assert_eq m.load_or_store(6, 4), (2, true)
  m.delete(2)
  assert_eq vec_opt(m.load(5)), "none"
  assert_eq vec_opt(m.load_and_delete(1)), "none"
  assert_eq m.compare_and_delete(3, 1), false
  assert_eq vec_opt(m.swap(6, 2)), "2"
  assert_eq vec_range(m), "0:0,3:2,4:3,6:2"
  assert_eq vec_opt(m.swap(0, 1)), "0"
  assert_eq vec_opt(m.load(4)), "3"
  assert_eq vec_opt(m.load_and_delete(3)), "2"
  assert_eq m.compare_and_delete(4, 4), false
  assert_eq vec_opt(m.load(6)), "2"
  assert_eq vec_opt(m.swap(7, 0)), "none"
  assert_eq vec_opt(m.swap(7, 0)), "0"
  assert_eq m.load_or_store(0, 2), (1, true)
  assert_eq vec_opt(m.load_and_delete(2)), "none"
  assert_eq m.load_or_store(3, 1), (1, false)
  assert_eq m.compare_and_swap(7, 3, 4), false
  m.store(5, 2)
  assert_eq vec_opt(m.load_and_delete(6)), "2"
  assert_eq vec_range(m), "0:1,3:1,4:3,5:2,7:0"
  assert_eq vec_range(m), "0:1,3:1,4:3,5:2,7:0"
  assert_eq m.compare_and_swap(3, 4, 5), false
  assert_eq m.compare_and_swap(3, 1, 2), true
  assert_eq m.compare_and_swap(5, 0, 1), false
  assert_eq vec_opt(m.load_and_delete(3)), "2"
  assert_eq m.load_or_store(4, 4), (3, true)
  m.delete(6)
  assert_eq m.compare_and_delete(3, 1), false
  assert_eq m.compare_and_swap(4, 3, 4), true
  assert_eq vec_range(m), "0:1,4:4,5:2,7:0"
  m.store(7, 0)
  m.clear
  assert_eq vec_opt(m.swap(2, 1)), "none"
  m.clear
  assert_eq vec_opt(m.swap(0, 0)), "none"
  assert_eq m.compare_and_delete(1, 2), false
  assert_eq vec_opt(m.load_and_delete(1)), "none"
  assert_eq m.compare_and_delete(4, 1), false
  assert_eq m.load_or_store(4, 3), (3, false)
  m.delete(3)
  assert_eq vec_range(m), "0:0,4:3"
  assert_eq vec_opt(m.swap(4, 1)), "3"
  assert_eq vec_opt(m.load(7)), "none"
  assert_eq m.compare_and_delete(0, 3), false
  assert_eq vec_opt(m.swap(2, 4)), "none"
  assert_eq m.load_or_store(6, 1), (1, false)
  m.store(3, 2)
  assert_eq vec_opt(m.load_and_delete(2)), "4"
  assert_eq vec_opt(m.load(2)), "none"
  assert_eq m.compare_and_delete(0, 0), true
  assert_eq vec_opt(m.swap(6, 4)), "1"
  assert_eq vec_range(m), "3:2,4:1,6:4"
}

