# Generated from Go's sync (random operation sequences on a sync.Map;
# .scratch/genmap); do not edit by hand.

import "strings"

def vec_range(m: SharedMap[Int, Int]) -> Str {
  parts: [Str] = []
  m.range { |k, v|
    parts << "#{k}:#{v}"
    true
  }
  strings.join(parts.sort, ",")
}

def vec_opt(v: Int?) -> Str {
  if x = v {
    return "#{x}"
  }
  "none"
}

test "sync.Map ops 0" {
