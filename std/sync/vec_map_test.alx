  assert_eq vec_opt(m.load_and_delete(1)), "1"
  m.clear
  assert_eq vec_opt(m.swap(4, 1)), "none"
  m.clear
  assert_eq m.load_or_store(7, 4), (4, false)
  assert_eq m.compare_and_swap(0, 4, 5), false
  assert_eq vec_opt(m.swap(3, 2)), "none"
  m.store(4, 2)
  assert_eq m.compare_and_delete(0, 1), false
  assert_eq vec_opt(m.swap(7, 4)), "4"
  assert_eq vec_range(m), "3:2,4:2,7:4"
  assert_eq vec_opt(m.load(2)), "none"
  assert_eq vec_range(m), "3:2,4:2,7:4"
  assert_eq vec_opt(m.swap(0, 1)), "none"
  assert_eq m.compare_and_delete(3, 1), false
  assert_eq m.load_or_store(5, 3), (3, false)
  assert_eq m.compare_and_swap(1, 0, 1), false
  assert_eq vec_opt(m.load(5)), "3"
  m.store(5, 3)
  m.clear
  assert_eq vec_opt(m.load_and_delete(5)), "none"
  assert_eq m.load_or_store(4, 2), (2, false)
  assert_eq vec_range(m), "4:2"
  m.delete(0)
  assert_eq m.load_or_store(4, 4), (2, true)
  assert_eq vec_range(m), "4:2"
  m.delete(4)
  assert_eq vec_opt(m.swap(1, 1)), "none"
  m.store(3, 3)
  m.store(2, 3)
  assert_eq m.compare_and_delete(4, 3), false
  assert_eq vec_opt(m.load_and_delete(5)), "none"
  assert_eq m.load_or_store(2, 4), (3, true)
  assert_eq m.compare_and_swap(3, 4, 5), false
  assert_eq vec_opt(m.swap(7, 1)), "none"
  assert_eq m.compare_and_swap(6, 2, 3), false
  assert_eq vec_range(m), "1:1,2:3,3:3,7:1"
  assert_eq vec_opt(m.load_and_delete(2)), "3"
  m.delete(6)
  assert_eq vec_opt(m.swap(6, 1)), "none"
  assert_eq m.compare_and_delete(5, 4), false
  assert_eq m.compare_and_swap(6, 0, 1), false
  m.store(1, 1)
  assert_eq vec_range(m), "1:1,3:3,6:1,7:1"
  assert_eq m.compare_and_swap(0, 2, 3), false
  assert_eq vec_opt(m.load(2)), "none"
  assert_eq vec_opt(m.load_and_delete(6)), "1"
  assert_eq vec_range(m), "1:1,3:3,7:1"
}

