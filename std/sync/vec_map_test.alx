test "sync.Map ops 15" {
  m: SharedMap[Int, Int] = new_shared_map
  m.delete(6)
  assert_eq m.compare_and_delete(4, 2), false
  m.delete(2)
  m.store(7, 2)
  m.delete(6)
  assert_eq vec_opt(m.load_and_delete(6)), "none"
  assert_eq vec_opt(m.load_and_delete(6)), "none"
  m.delete(2)
  assert_eq vec_range(m), "7:2"
  m.delete(0)
  assert_eq vec_opt(m.load(0)), "none"
  assert_eq vec_opt(m.load_and_delete(7)), "2"
  assert_eq m.compare_and_swap(6, 1, 2), false
  assert_eq m.compare_and_swap(3, 3, 4), false
  assert_eq vec_range(m), ""
  assert_eq m.load_or_store(4, 0), (0, false)
  m.delete(0)
  m.store(5, 0)
  assert_eq vec_opt(m.load(0)), "none"
  assert_eq vec_opt(m.load(5)), "0"
  m.clear
  assert_eq m.compare_and_swap(7, 2, 3), false
  assert_eq vec_opt(m.swap(7, 4)), "none"
  assert_eq vec_range(m), "7:4"
  assert_eq vec_range(m), "7:4"
  assert_eq vec_range(m), "7:4"
  assert_eq vec_opt(m.load(7)), "4"
  assert_eq vec_opt(m.swap(3, 1)), "none"
  m.store(0, 1)
  assert_eq vec_range(m), "0:1,3:1,7:4"
  assert_eq vec_opt(m.swap(7, 4)), "4"
  assert_eq vec_opt(m.load_and_delete(0)), "1"
  assert_eq vec_opt(m.load(6)), "none"
  assert_eq vec_range(m), "3:1,7:4"
  assert_eq vec_opt(m.swap(0, 2)), "none"
  assert_eq m.compare_and_swap(6, 3, 4), false
  assert_eq vec_range(m), "0:2,3:1,7:4"
  assert_eq m.compare_and_delete(5, 1), false
  m.clear
  assert_eq m.load_or_store(5, 0), (0, false)
  assert_eq m.compare_and_swap(7, 0, 1), false
  assert_eq m.load_or_store(2, 1), (1, false)
  m.delete(5)
  assert_eq vec_range(m), "2:1"
  assert_eq vec_range(m), "2:1"
  assert_eq vec_opt(m.load_and_delete(0)), "none"
  m.store(5, 0)
  m.store(3, 2)
  assert_eq vec_range(m), "2:1,3:2,5:0"
  assert_eq vec_opt(m.load(1)), "none"
  m.delete(3)
  assert_eq vec_opt(m.load_and_delete(6)), "none"
  assert_eq vec_range(m), "2:1,5:0"
  assert_eq vec_opt(m.load(3)), "none"
  assert_eq vec_range(m), "2:1,5:0"
  assert_eq vec_range(m), "2:1,5:0"
  assert_eq m.compare_and_swap(1, 4, 5), false
  assert_eq m.compare_and_swap(0, 2, 3), false
  assert_eq m.load_or_store(1, 1), (1, false)
  assert_eq vec_opt(m.load_and_delete(6)), "none"
  assert_eq vec_range(m), "1:1,2:1,5:0"
  assert_eq vec_opt(m.load_and_delete(3)), "none"
  assert_eq vec_opt(m.swap(5, 3)), "0"
  m.store(2, 3)
  m.store(7, 3)
  m.store(2, 4)
  assert_eq m.compare_and_swap(7, 2, 3), false
  assert_eq vec_opt(m.load_and_delete(0)), "none"
  m.store(7, 4)
  assert_eq m.load_or_store(4, 4), (4, false)
  assert_eq vec_range(m), "1:1,2:4,4:4,5:3,7:4"
  assert_eq vec_opt(m.swap(4, 1)), "4"
  assert_eq vec_opt(m.load(0)), "none"
  assert_eq m.compare_and_swap(6, 3, 4), false
  assert_eq m.compare_and_swap(7, 3, 4), false
  m.delete(2)
  assert_eq vec_opt(m.load_and_delete(2)), "none"
  assert_eq m.load_or_store(6, 0), (0, false)
  assert_eq m.compare_and_delete(3, 4), false
  assert_eq m.compare_and_swap(1, 1, 2), true
  assert_eq m.load_or_store(2, 3), (3, false)
  assert_eq vec_range(m), "1:2,2:3,4:1,5:3,6:0,7:4"
  assert_eq m.load_or_store(2, 4), (3, true)
  assert_eq vec_range(m), "1:2,2:3,4:1,5:3,6:0,7:4"
  assert_eq vec_range(m), "1:2,2:3,4:1,5:3,6:0,7:4"
  assert_eq vec_opt(m.load_and_delete(1)), "2"
  m.store(2, 1)
  assert_eq m.compare_and_swap(6, 3, 4), false
  assert_eq vec_range(m), "2:1,4:1,5:3,6:0,7:4"
  assert_eq vec_opt(m.load_and_delete(1)), "none"
  assert_eq vec_range(m), "2:1,4:1,5:3,6:0,7:4"
}

test "sync.Map ops 16" {
  m: SharedMap[Int, Int] = new_shared_map
  assert_eq m.compare_and_swap(0, 4, 5), false
  m.store(5, 0)
  assert_eq m.compare_and_delete(1, 0), false
  m.store(7, 2)
  assert_eq vec_opt(m.load(7)), "2"
  m.delete(0)
  assert_eq vec_opt(m.load(6)), "none"
  assert_eq vec_opt(m.load_and_delete(0)), "none"
  assert_eq m.compare_and_delete(4, 0), false
  assert_eq m.compare_and_delete(5, 3), false
  assert_eq m.compare_and_delete(1, 3), false
  assert_eq m.compare_and_delete(3, 2), false
  m.clear
  assert_eq vec_range(m), ""
  assert_eq vec_opt(m.load_and_delete(7)), "none"
  m.delete(0)
  assert_eq vec_opt(m.load(2)), "none"
  assert_eq vec_opt(m.swap(5, 0)), "none"
  m.store(1, 1)
  assert_eq m.compare_and_swap(7, 0, 1), false
  assert_eq m.load_or_store(2, 0), (0, false)
  assert_eq m.compare_and_delete(1, 1), true
  assert_eq vec_range(m), "2:0,5:0"
  assert_eq m.compare_and_swap(4, 3, 4), false
  assert_eq vec_opt(m.load(0)), "none"
  assert_eq vec_range(m), "2:0,5:0"
  assert_eq vec_opt(m.load(5)), "0"
  assert_eq vec_opt(m.swap(1, 0)), "none"
  m.delete(6)
  assert_eq vec_range(m), "1:0,2:0,5:0"
  assert_eq m.compare_and_swap(6, 2, 3), false
  m.store(4, 2)
  assert_eq vec_range(m), "1:0,2:0,4:2,5:0"
  assert_eq m.compare_and_delete(4, 4), false
  assert_eq vec_opt(m.load(6)), "none"
  assert_eq vec_opt(m.load(5)), "0"
  m.store(3, 2)
  assert_eq m.compare_and_swap(7, 2, 3), false
  assert_eq vec_opt(m.load(3)), "2"
  m.store(4, 3)
  assert_eq m.load_or_store(6, 0), (0, false)
  assert_eq vec_opt(m.load(1)), "0"
  assert_eq m.load_or_store(4, 1), (3, true)
  assert_eq m.compare_and_swap(6, 1, 2), false
  m.store(2, 0)
  m.store(1, 0)
  m.delete(7)
  m.delete(6)
  assert_eq m.compare_and_swap(0, 0, 1), false
  m.delete(4)
  m.delete(7)
  assert_eq m.load_or_store(0, 1), (1, false)
  assert_eq vec_range(m), "0:1,1:0,2:0,3:2,5:0"
  assert_eq m.load_or_store(0, 3), (1, true)
  assert_eq vec_opt(m.load(5)), "0"
  assert_eq m.compare_and_delete(1, 1), false
  assert_eq vec_opt(m.swap(0, 2)), "1"
  assert_eq vec_opt(m.swap(6, 1)), "none"
  assert_eq vec_opt(m.swap(0, 0)), "2"
  assert_eq m.load_or_store(3, 3), (2, true)
  assert_eq m.compare_and_swap(3, 3, 4), false
  m.delete(5)
  assert_eq vec_range(m), "0:0,1:0,2:0,3:2,6:1"
  assert_eq m.compare_and_swap(4, 0, 1), false
  assert_eq m.compare_and_delete(1, 3), false
  assert_eq m.load_or_store(1, 2), (0, true)
  assert_eq vec_opt(m.load_and_delete(5)), "none"
  assert_eq vec_range(m), "0:0,1:0,2:0,3:2,6:1"
  assert_eq vec_opt(m.load_and_delete(0)), "0"
  assert_eq vec_opt(m.swap(3, 4)), "2"
  assert_eq m.load_or_store(0, 0), (0, false)
  assert_eq vec_opt(m.swap(2, 4)), "0"
  assert_eq vec_opt(m.load(1)), "0"
  assert_eq vec_opt(m.load_and_delete(2)), "4"
  assert_eq vec_range(m), "0:0,1:0,3:4,6:1"
  assert_eq vec_range(m), "0:0,1:0,3:4,6:1"
  assert_eq m.load_or_store(4, 2), (2, false)
  assert_eq m.compare_and_delete(7, 4), false
  assert_eq m.compare_and_delete(2, 2), false
  assert_eq m.compare_and_swap(1, 2, 3), false
  assert_eq m.load_or_store(3, 1), (4, true)
  m.store(1, 1)
  assert_eq vec_range(m), "0:0,1:1,3:4,4:2,6:1"
  assert_eq m.compare_and_delete(3, 0), false
  assert_eq vec_range(m), "0:0,1:1,3:4,4:2,6:1"
  assert_eq m.compare_and_delete(0, 0), true
  assert_eq vec_range(m), "1:1,3:4,4:2,6:1"
  assert_eq vec_range(m), "1:1,3:4,4:2,6:1"
  assert_eq vec_opt(m.load(4)), "2"
  assert_eq vec_opt(m.load_and_delete(1)), "1"
  assert_eq vec_range(m), "3:4,4:2,6:1"
}

test "sync.Map ops 17" {
  m: SharedMap[Int, Int] = new_shared_map
  m.clear
  assert_eq vec_opt(m.swap(1, 4)), "none"
  assert_eq vec_opt(m.load(2)), "none"
  assert_eq m.compare_and_delete(2, 2), false
  assert_eq vec_range(m), "1:4"
  m.delete(5)
  assert_eq vec_opt(m.load(1)), "4"
  assert_eq vec_opt(m.swap(0, 0)), "none"
  assert_eq m.compare_and_swap(6, 1, 2), false
  m.store(3, 0)
  assert_eq vec_range(m), "0:0,1:4,3:0"
  m.delete(0)
  assert_eq m.compare_and_swap(5, 4, 5), false
  assert_eq m.compare_and_delete(7, 0), false
  m.delete(6)
  assert_eq m.compare_and_delete(3, 0), true
  assert_eq vec_opt(m.swap(4, 1)), "none"
  assert_eq m.compare_and_delete(6, 4), false
  m.store(5, 1)
  assert_eq m.load_or_store(4, 3), (1, true)
  assert_eq m.compare_and_delete(2, 4), false
  assert_eq vec_opt(m.swap(1, 4)), "4"
  assert_eq vec_opt(m.swap(2, 0)), "none"
  assert_eq vec_range(m), "1:4,2:0,4:1,5:1"
  assert_eq vec_opt(m.load_and_delete(4)), "1"
  assert_eq vec_range(m), "1:4,2:0,5:1"
  assert_eq m.load_or_store(0, 3), (3, false)
  assert_eq m.compare_and_swap(3, 2, 3), false
  m.store(7, 0)
  assert_eq vec_opt(m.load_and_delete(4)), "none"
  m.store(3, 4)
  assert_eq vec_opt(m.load(1)), "4"
  assert_eq vec_range(m), "0:3,1:4,2:0,3:4,5:1,7:0"
  assert_eq vec_opt(m.load(0)), "3"
  m.delete(6)
  assert_eq vec_range(m), "0:3,1:4,2:0,3:4,5:1,7:0"
  assert_eq vec_range(m), "0:3,1:4,2:0,3:4,5:1,7:0"
  m.clear
  assert_eq vec_opt(m.load(0)), "none"
  m.delete(4)
  assert_eq vec_range(m), ""
  assert_eq m.compare_and_delete(0, 1), false
  m.store(6, 4)
  assert_eq m.compare_and_swap(3, 4, 5), false
  assert_eq vec_range(m), "6:4"
  assert_eq vec_range(m), "6:4"
  assert_eq vec_opt(m.load_and_delete(3)), "none"
  assert_eq m.load_or_store(2, 4), (4, false)
  assert_eq vec_range(m), "2:4,6:4"
  assert_eq m.compare_and_swap(0, 0, 1), false
  assert_eq m.compare_and_swap(3, 0, 1), false
  assert_eq vec_range(m), "2:4,6:4"
  assert_eq vec_range(m), "2:4,6:4"
  assert_eq vec_range(m), "2:4,6:4"
  assert_eq m.compare_and_delete(2, 0), false
  assert_eq vec_opt(m.load(5)), "none"
  m.store(6, 1)
  assert_eq vec_range(m), "2:4,6:1"
  assert_eq vec_range(m), "2:4,6:1"
  assert_eq vec_opt(m.swap(5, 0)), "none"
  assert_eq m.compare_and_delete(1, 2), false
  m.store(0, 1)
  m.clear
  m.store(2, 0)
  assert_eq m.compare_and_swap(2, 0, 1), true
  m.delete(7)
  assert_eq m.compare_and_delete(7, 3), false
  assert_eq m.compare_and_delete(3, 4), false
  assert_eq m.compare_and_delete(1, 2), false
  assert_eq m.load_or_store(6, 3), (3, false)
  m.store(6, 3)
  m.store(6, 1)
  assert_eq m.load_or_store(1, 0), (0, false)
  assert_eq vec_opt(m.load_and_delete(3)), "none"
  assert_eq vec_opt(m.load_and_delete(3)), "none"
  assert_eq m.compare_and_swap(1, 3, 4), false
  assert_eq m.compare_and_swap(2, 3, 4), false
  assert_eq vec_opt(m.swap(0, 2)), "none"
  assert_eq vec_range(m), "0:2,1:0,2:1,6:1"
  assert_eq m.compare_and_delete(6, 4), false
  assert_eq m.compare_and_delete(5, 3), false
  assert_eq vec_opt(m.load(7)), "none"
  m.store(0, 4)
  assert_eq vec_opt(m.swap(4, 4)), "none"
  assert_eq m.compare_and_swap(4, 4, 5), true
  m.delete(0)
  assert_eq vec_opt(m.load_and_delete(7)), "none"
  m.store(7, 1)
  assert_eq vec_range(m), "1:0,2:1,4:5,6:1,7:1"
  assert_eq vec_opt(m.load_and_delete(4)), "5"
  assert_eq vec_range(m), "1:0,2:1,6:1,7:1"
}

