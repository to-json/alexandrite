  assert_eq m.compare_and_swap(3, 0, 1), false
  assert_eq vec_range(m), "3:3"
  m.clear
  m.delete(6)
  assert_eq m.load_or_store(0, 3), (3, false)
  assert_eq vec_range(m), "0:3"
  assert_eq vec_range(m), "0:3"
  assert_eq m.load_or_store(0, 2), (3, true)
  assert_eq vec_opt(m.load_and_delete(4)), "none"
  assert_eq m.compare_and_swap(5, 2, 3), false
  assert_eq vec_opt(m.load_and_delete(4)), "none"
  m.store(5, 0)
  m.delete(2)
  assert_eq m.load_or_store(0, 0), (3, true)
