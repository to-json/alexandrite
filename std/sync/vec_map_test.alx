  assert_eq m.compare_and_swap(5, 0, 1), false
  assert_eq m.compare_and_swap(7, 0, 1), false
  assert_eq m.compare_and_delete(4, 2), false
  assert_eq m.compare_and_delete(7, 4), false
  m.delete(0)
