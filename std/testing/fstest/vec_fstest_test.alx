  assert_eq vec_read_file(4, "x//y"), "err:open x//y: file does not exist"
  assert_eq vec_read_link(4, "x//y"), "err:readlink x//y: file does not exist"
  assert_eq vec_sub_walk(4, "x//y"), "err:sub x//y: invalid argument"
  assert_eq vec_glob(4, "*"), ""
  assert_eq vec_glob(4, "*/*"), ""
  assert_eq vec_glob(4, "x/*.go"), ""
  assert_eq vec_glob(4, "x/[ab].go"), ""
  assert_eq vec_glob(4, "*/k"), ""
  assert_eq vec_glob(4, "fortune/*/*"), ""
  assert_eq vec_glob(4, "nope/*"), ""
  assert_eq vec_glob(4, "x/?"), ""
  assert_eq vec_glob(4, "*.txt"), ""
  assert_eq vec_glob(4, "dirlink/*"), ""
}
