}

def vec_errs[T](r: ~T) -> Str { "err:" + r.err.unwrap.message }

def vec_info(r: ~fs.FileInfo) -> Str {
  return vec_errs(r) if r.err?
  fi = r.unwrap
  "#{fi.name} #{fi.mode.to_s} #{fi.size} #{fi.is_dir}"
}

def vec_stat(i: Int, name: Str) -> Str { vec_info(fs.stat(vec_system(i), name)) }

def vec_lstat(i: Int, name: Str) -> Str { vec_info(fs.lstat(vec_system(i), name)) }

def vec_read_dir(i: Int, name: Str) -> Str {
  r = fs.read_dir(vec_system(i), name)
  return vec_errs(r) if r.err?
  s = ""
  for d in r.unwrap {
    s += "," if s.size > 0
    s += d.name + ":" + d.type.to_s
  }
  s
}

def vec_read_file(i: Int, name: Str) -> Str {
  r = fs.read_file(vec_system(i), name)
  return vec_errs(r) if r.err?
  Str.from_bytes(r.unwrap)
}

def vec_read_link(i: Int, name: Str) -> Str {
  r = fs.read_link(vec_system(i), name)
  return vec_errs(r) if r.err?
  r.unwrap
}

def vec_sub_walk(i: Int, name: Str) -> Str {
  r = fs.sub(vec_system(i), name)
  return vec_errs(r) if r.err?
  s = ""
  w = fs.walk_dir(r.unwrap, ".") { |p, d, err|
    s += "," if s.size > 0
    if e = err {
      s += "!" + e.message
    } else {
      s += p
    }
  }
  if e = w.err {
    s += "," if s.size > 0
    s += "!" + e.message
  }
  s
}

def vec_glob(i: Int, pat: Str) -> Str {
  r = fs.glob(vec_system(i), pat)
  return vec_errs(r) if r.err?
  s = ""
  for m in r.unwrap.sort {
    s += "," if s.size > 0
    s += m
  }
  s
}

