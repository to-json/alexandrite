      files["linklink"] = MapFile.new(data: "dirlink".bytes.to_a, mode: fs.mode(134217728), mod_time: map_file([]).mod_time)
      files["ken.txt"] = MapFile.new(data: "dirlink/ken.txt".bytes.to_a, mode: fs.mode(134217728), mod_time: map_file([]).mod_time)
      files["bad"] = MapFile.new(data: "nowhere".bytes.to_a, mode: fs.mode(134217728), mod_time: map_file([]).mod_time)
    }
    3 => {
      files["x/y/z"] = MapFile.new(data: "zz".bytes.to_a, mode: fs.mode(384), mod_time: map_file([]).mod_time)
      files["x/w"] = MapFile.new(data: "".bytes.to_a, mode: fs.mode(2147484096), mod_time: map_file([]).mod_time)
      files["x/a.go"] = MapFile.new(data: "package a".bytes.to_a, mode: fs.mode(420), mod_time: map_file([]).mod_time)
      files["x/b.go"] = MapFile.new(data: "package b".bytes.to_a, mode: fs.mode(420), mod_time: map_file([]).mod_time)
      files["top.txt"] = MapFile.new(data: "t".bytes.to_a, mode: fs.mode(416), mod_time: map_file([]).mod_time)
    }
