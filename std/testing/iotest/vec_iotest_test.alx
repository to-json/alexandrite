# Generated from Go's testing/iotest (go1.27, .scratch/iotvec/main.go); do not edit by hand.
# Read sizes until the end (Go's io.EOF is a 0 read here).

def vec_buf(s: Str) -> bytes.Buffer { bytes.new_buffer_string(s) }

def vec_reads[R](r: R, k: Int) -> Str {
  src = r
  s = ""
  got: [Byte] = []
  buf: [Byte] = [0; k]
  loop {
    n = src.read!(buf).unwrap
    break if n == 0
    s += "," if s.size > 0
    s += "#{n}"
    for b in buf[0...n] { got << b }
  }
  s + "|" + Str.from_bytes(got)
}

def vec_truncate(input: Str, n: Int, chunk: Int) -> Str {
  buf = bytes.new_buffer_string("")
  tw = truncate_writer(buf, n)
  s = ""
  b = input.bytes.to_a
  while b.size > 0 {
    c = chunk < b.size ? chunk : b.size
    m = tw.write!(b[0...c]).unwrap
    s += "," if s.size > 0
    s += "#{m}"
    b = b[c...b.size]
  }
  s + "|" + buf.to_s
}

