#![test(external)]
# Go's testing/quick tests (quick_test.go), translated. Go's per-type
# identity functions become generators: alx picks the values' type from
# the generator, not by reflection. Go's reflection over the test types is
# `#[derive(Arbitrary)]`, which imports testing/quick: these are external
# tests (S11), using the package as a user does.

import "math/rand"
import "testing/quick"

#[derive(Arbitrary)]
struct TestStruct {
  a: Int
  b: Str
}

def report_error(t: testing.T, property: Str, r: ~Unit) {
  if e = r.err {
    t.error("#{property}: #{e.message}")
  }
}

def id[T](x: T) -> T { x }

test "CheckEqual" { |t|
  report_error(t, "fArray", quick.check_equal(quick.array_of(quick.u8, 4), none, ->(a: [U8]) -> [U8] { id(a) }, ->(a: [U8]) -> [U8] { id(a) }))
  report_error(t, "fBool", quick.check_equal(quick.bool, none, ->(a: Bool) -> Bool { a }, ->(a: Bool) -> Bool { a }))
  report_error(t, "fFloat64", quick.check_equal(quick.float, none, ->(a: Float) -> Float { a }, ->(a: Float) -> Float { a }))
  report_error(t, "fComplex128", quick.check_equal(quick.complex, none, ->(a: Complex) -> Complex { a }, ->(a: Complex) -> Complex { a }))
  report_error(t, "fInt16", quick.check_equal(quick.i16, none, ->(a: I16) -> I16 { a }, ->(a: I16) -> I16 { a }))
  report_error(t, "fInt32", quick.check_equal(quick.i32, none, ->(a: I32) -> I32 { a }, ->(a: I32) -> I32 { a }))
  report_error(t, "fInt64", quick.check_equal(quick.i64, none, ->(a: I64) -> I64 { a }, ->(a: I64) -> I64 { a }))
  report_error(t, "fInt8", quick.check_equal(quick.i8, none, ->(a: I8) -> I8 { a }, ->(a: I8) -> I8 { a }))
  report_error(t, "fInt", quick.check_equal(quick.int, none, ->(a: Int) -> Int { a }, ->(a: Int) -> Int { a }))
  report_error(t, "fMap", quick.check_equal(quick.map_of(quick.int, quick.int), none, ->(a: Map[Int, Int]) -> Map[Int, Int] { a }, ->(a: Map[Int, Int]) -> Map[Int, Int] { a }))
  report_error(t, "fPtr", quick.check_equal(quick.opt_of(quick.int), none, ->(a: Int?) -> Int? { a }, ->(a: Int?) -> Int? { a }))
  report_error(t, "fSlice", quick.check_equal(quick.slice_of(quick.u8), none, ->(a: [U8]) -> [U8] { a }, ->(a: [U8]) -> [U8] { a }))
  report_error(t, "fString", quick.check_equal(quick.str, none, ->(a: Str) -> Str { a }, ->(a: Str) -> Str { a }))
  report_error(t, "fStruct", quick.check_equal(quick.Arb[TestStruct].gen, none, ->(a: TestStruct) -> TestStruct { a }, ->(a: TestStruct) -> TestStruct { a }))
  report_error(t, "fUint16", quick.check_equal(quick.u16, none, ->(a: U16) -> U16 { a }, ->(a: U16) -> U16 { a }))
  report_error(t, "fUint32", quick.check_equal(quick.u32, none, ->(a: U32) -> U32 { a }, ->(a: U32) -> U32 { a }))
  report_error(t, "fUint64", quick.check_equal(quick.u64, none, ->(a: U64) -> U64 { a }, ->(a: U64) -> U64 { a }))
  report_error(t, "fUint8", quick.check_equal(quick.u8, none, ->(a: U8) -> U8 { a }, ->(a: U8) -> U8 { a }))
  report_error(t, "fRune", quick.check_equal(quick.rune, none, ->(a: Rune) -> Rune { a }, ->(a: Rune) -> Rune { a }))
}

# Go's myStruct, whose Generate always makes x: 42.
struct MyStruct {
  x: Int

  def self.arbitrary(_r: rand.Rand, _size: Int) -> MyStruct { MyStruct.new(x: 42) }
}

test "CheckProperty" { |t|
  report_error(t, "myStructProperty", quick.check(quick.Arb[MyStruct].gen, none) { |s| s.x == 42 })
}

test "Failure" { |t|
  r = quick.check(quick.int, none) { |_x| false }
  if e = r.err {
    case e {
      quick.QuickError.Check(count, input) => {
        assert_eq count, 1
        assert_eq input.size, 1
      }
      _ => t.error("Error was not a CheckError: #{e.message}")
    }
  } else {
    t.error("Check didn't return an error")
  }
  # Go's other Failure cases (functions of different types or arities)
  # are compile errors in alx.
  r2 = quick.check_equal(quick.int, none, ->(x: Int) -> Int { x }, ->(x: Int) -> Int { x + 1 })
  if e = r2.err {
    case e {
      quick.QuickError.CheckEqual(count, _in, out1, out2) => {
        assert_eq count, 1
        assert out1 != out2
      }
      _ => t.error("Error was not a CheckEqualError: #{e.message}")
    }
  } else {
    t.error("CheckEqual didn't return an error")
  }
}

# Recursive data structures didn't terminate (Go's issues 8818 and 11148).
# Go's pointers become optionals. Go's MapR (map[*R]*R) has no counterpart:
# alx map keys are integers, Str or Bool.
struct R {
  ptr: R?
  slice_p: [R?]
  slice: [R]
  map: Map[Int, R]
  map_p: Map[Int, R?]
  slice_map: [Map[Int, R]]

  def self.arbitrary(r: rand.Rand, size: Int) -> R {
    s = quick.field_size(size, 6)
    R.new(
      ptr: quick.opt_of(quick.Arb[R].gen).generate(r, s),
      slice_p: quick.slice_of(quick.opt_of(quick.Arb[R].gen)).generate(r, s),
      slice: quick.slice_of(quick.Arb[R].gen).generate(r, s),
      map: quick.map_of(quick.int, quick.Arb[R].gen).generate(r, s),
      map_p: quick.map_of(quick.int, quick.opt_of(quick.Arb[R].gen)).generate(r, s),
      slice_map: quick.slice_of(quick.map_of(quick.int, quick.Arb[R].gen)).generate(r, s),
    )
  }
}

def larger(a: Int, b: Int) -> Int { a > b ? a : b }

# How deep an R goes.
def depth(x: R) -> Int {
  d = 0
  if p = x.ptr { d = larger(d, depth(p)) }
  for e in x.slice_p {
    if p = e { d = larger(d, depth(p)) }
  }
  for e in x.slice { d = larger(d, depth(e)) }
  for _k, v in x.map { d = larger(d, depth(v)) }
  for _k, v in x.map_p {
    if p = v { d = larger(d, depth(p)) }
  }
  for m in x.slice_map {
    for _k, v in m { d = larger(d, depth(v)) }
  }
  d + 1
}

test "Recursive" {
  ~quick.check(quick.Arb[R].gen, none) { |_r| true }
}

# The generated values do nest (size shrinks per level, so not deeply), and
# compare and copy like any value.
test "Recursive values" {
  deepest = Atomic.new(0)
  ~quick.check(quick.Arb[R].gen, quick.Config.new(max_count: 300)) { |x|
    deepest.store(depth(x)) if depth(x) > deepest.load
    x == x.dup
  }
  assert deepest.load >= 2
  assert deepest.load < 10
}

struct A {
  b: B?

  def self.arbitrary(r: rand.Rand, size: Int) -> A {
    A.new(b: quick.opt_of(quick.Arb[B].gen).generate(r, quick.field_size(size, 1)))
  }
}

struct B {
  a: A?

  def self.arbitrary(r: rand.Rand, size: Int) -> B {
    B.new(a: quick.opt_of(quick.Arb[A].gen).generate(r, quick.field_size(size, 1)))
  }
}

test "MutuallyRecursive" {
  ~quick.check(quick.Arb[A].gen, none) { |_a| true }
}

#[derive(Arbitrary)]
struct Empty {
}

test "EmptyStruct" {
  ~quick.check(quick.Arb[Empty].gen, none) { |_e| true }
}

#[derive(Arbitrary)]
struct Q {
  m: Map[Int, Int]
  s: [Int]
}

# alx slices and maps are never nil; the sizes stay below Go's bounds.
test "NonZeroSliceAndMap" {
  ~quick.check(quick.Arb[Q].gen, none) { |q| q.m.size < 25 && q.s.size < 25 }
}

test "Int64" { |t|
  lo = Atomic.new(0)
  hi = Atomic.new(0)
  cfg = quick.Config.new(max_count: 10000)
  ~quick.check(quick.i64, cfg) { |x|
    lo.store(x) if x < lo.load
    hi.store(x) if x > hi.load
    true
  }
  if lo.load.as_u64 >> 62 == 0 || hi.load.as_u64 >> 62 == 0 {
    t.error("int64 returned range #{lo.load}, #{hi.load}; does not look like full range")
  }
}

# --------------------------------------------------------- beyond Go's tests

#[derive(Arbitrary)]
enum Shape {
  Circle(Float)
  Rect(w: Int, h: Int)
  Empty
}

test "derived enum" {
  seen = Atomic.new(0)
  ~quick.check(quick.Arb[Shape].gen, quick.Config.new(max_count: 300)) { |s|
    bit = case s {
      Circle(_) => 1
      Rect(_, _) => 2
      Empty => 4
    }
    seen.store(seen.load | bit)
    true
  }
  assert_eq seen.load, 7
}

test "check2 and check3" {
  ~quick.check2(quick.int, quick.int, none) { |a, b| a +% b == b +% a }
  ~quick.check3(quick.u8, quick.u8, quick.u8, none) { |a, b, c| (a +% b) +% c == a +% (b +% c) }
  ~quick.check_equal2(quick.str, quick.str, none, ->(a: Str, b: Str) -> Int { (a + b).size }, ->(a: Str, b: Str) -> Int { a.size + b.size })
  ~quick.check_equal3(quick.bool, quick.bool, quick.bool, none, ->(a: Bool, b: Bool, c: Bool) -> Bool { a && (b || c) }, ->(a: Bool, b: Bool, c: Bool) -> Bool { a && b || a && c })
}

test "seeded checks repeat" {
  seen1: [Int] = []
  seen2: [Int] = []
  m1 = Mutex.new(seen1)
  m2 = Mutex.new(seen2)
  ~quick.check(quick.int, quick.Config.new(max_count: 5, rand: rand.new(rand.new_source(7)))) { |x|
    m1.lock { |s| s << x }
    true
  }
  ~quick.check(quick.int, quick.Config.new(max_count: 5, rand: rand.new(rand.new_source(7)))) { |x|
    m2.lock { |s| s << x }
    true
  }
  a = m1.lock { |s| s.dup }
  b = m2.lock { |s| s.dup }
  assert_eq a, b
  assert_eq a.size, 5
}

test "max count" { |t|
  assert_eq quick.Config.new.get_max_count, 100
  assert_eq quick.Config.new(max_count_scale: 2.5).get_max_count, 250
  assert_eq quick.Config.new(max_count: 3, max_count_scale: 2.5).get_max_count, 3
  t.setenv("ALX_QUICKCHECKS", "7")
  assert_eq quick.Config.new.get_max_count, 7
  n = Atomic.new(0)
  ~quick.check(quick.bool, none) { |_b|
    n.add(1)
    true
  }
  assert_eq n.load, 7
}

test "messages" {
  r = quick.check(quick.just(5), quick.Config.new(max_count: 3)) { |x| x < 5 }
  assert_eq r.err.unwrap.message, "#1: failed on input 5"
  r2 = quick.check_equal(quick.just("ab"), none, ->(s: Str) -> Int { s.size }, ->(_s: Str) -> Int { 0 })
  assert_eq r2.err.unwrap.message, "#1: failed on input ab. Output 1: 2. Output 2: 0"
}

example "Check" {
  # A property: reversing twice gives back the slice.
  r = quick.check(quick.slice_of(quick.int), none) { |xs| xs.reverse.reverse == xs }
  puts r.ok?
} outputs "true"
