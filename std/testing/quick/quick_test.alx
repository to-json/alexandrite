# Go's testing/quick tests (quick_test.go), translated. Go's per-type
# identity functions become generators: alx picks the values' type from
# the generator, not by reflection. The types here write `self.arbitrary`
# as `#[derive(Arbitrary)]` would (a derive in testing/quick's own tests
# would import a second copy of the package; the derive itself is tested by
# the acceptance case quickderive).

import "math/rand"

struct TestStruct {
  a: Int
  b: Str

  def self.arbitrary(r: rand.Rand, size: Int) -> TestStruct {
    s = field_size(size, 2)
    TestStruct.new(a: int.generate(r, s), b: str.generate(r, s))
  }
}

def report_error(t: testing.T, property: Str, r: ~Unit) {
  if e = r.err {
    t.error("#{property}: #{e.message}")
  }
}

def id[T](x: T) -> T { x }

test "CheckEqual" { |t|
  report_error(t, "fArray", check_equal(array_of(u8, 4), none, ->(a: [U8]) -> [U8] { id(a) }, ->(a: [U8]) -> [U8] { id(a) }))
  report_error(t, "fBool", check_equal(bool, none, ->(a: Bool) -> Bool { a }, ->(a: Bool) -> Bool { a }))
  report_error(t, "fFloat64", check_equal(float, none, ->(a: Float) -> Float { a }, ->(a: Float) -> Float { a }))
  report_error(t, "fComplex128", check_equal(complex, none, ->(a: Complex) -> Complex { a }, ->(a: Complex) -> Complex { a }))
  report_error(t, "fInt16", check_equal(i16, none, ->(a: I16) -> I16 { a }, ->(a: I16) -> I16 { a }))
  report_error(t, "fInt32", check_equal(i32, none, ->(a: I32) -> I32 { a }, ->(a: I32) -> I32 { a }))
  report_error(t, "fInt64", check_equal(i64, none, ->(a: I64) -> I64 { a }, ->(a: I64) -> I64 { a }))
  report_error(t, "fInt8", check_equal(i8, none, ->(a: I8) -> I8 { a }, ->(a: I8) -> I8 { a }))
  report_error(t, "fInt", check_equal(int, none, ->(a: Int) -> Int { a }, ->(a: Int) -> Int { a }))
  report_error(t, "fMap", check_equal(map_of(int, int), none, ->(a: Map[Int, Int]) -> Map[Int, Int] { a }, ->(a: Map[Int, Int]) -> Map[Int, Int] { a }))
  report_error(t, "fPtr", check_equal(opt_of(int), none, ->(a: Int?) -> Int? { a }, ->(a: Int?) -> Int? { a }))
  report_error(t, "fSlice", check_equal(slice_of(u8), none, ->(a: [U8]) -> [U8] { a }, ->(a: [U8]) -> [U8] { a }))
  report_error(t, "fString", check_equal(str, none, ->(a: Str) -> Str { a }, ->(a: Str) -> Str { a }))
  report_error(t, "fStruct", check_equal(Arb[TestStruct].gen, none, ->(a: TestStruct) -> TestStruct { a }, ->(a: TestStruct) -> TestStruct { a }))
  report_error(t, "fUint16", check_equal(u16, none, ->(a: U16) -> U16 { a }, ->(a: U16) -> U16 { a }))
  report_error(t, "fUint32", check_equal(u32, none, ->(a: U32) -> U32 { a }, ->(a: U32) -> U32 { a }))
  report_error(t, "fUint64", check_equal(u64, none, ->(a: U64) -> U64 { a }, ->(a: U64) -> U64 { a }))
  report_error(t, "fUint8", check_equal(u8, none, ->(a: U8) -> U8 { a }, ->(a: U8) -> U8 { a }))
  report_error(t, "fRune", check_equal(rune, none, ->(a: Rune) -> Rune { a }, ->(a: Rune) -> Rune { a }))
}

# Go's myStruct, whose Generate always makes x: 42.
struct MyStruct {
  x: Int

  def self.arbitrary(_r: rand.Rand, _size: Int) -> MyStruct { MyStruct.new(x: 42) }
}

test "CheckProperty" { |t|
  report_error(t, "myStructProperty", check(Arb[MyStruct].gen, none) { |s| s.x == 42 })
}

test "Failure" { |t|
  r = check(int, none) { |_x| false }
  if e = r.err {
    case e {
      QuickError.Check(count, input) => {
        assert_eq count, 1
        assert_eq input.size, 1
      }
      _ => t.error("Error was not a CheckError: #{e.message}")
    }
  } else {
    t.error("Check didn't return an error")
  }
  # Go's other Failure cases (functions of different types or arities)
  # are compile errors in alx.
  r2 = check_equal(int, none, ->(x: Int) -> Int { x }, ->(x: Int) -> Int { x + 1 })
  if e = r2.err {
    case e {
      QuickError.CheckEqual(count, _in, out1, out2) => {
        assert_eq count, 1
        assert out1 != out2
      }
      _ => t.error("Error was not a CheckEqualError: #{e.message}")
    }
  } else {
    t.error("CheckEqual didn't return an error")
  }
}

# Go's TestRecursive and TestMutuallyRecursive build types holding
# themselves through pointers; alx values can't contain themselves (not
# even through slices), so there's nothing to check.

struct Empty {
  def self.arbitrary(_r: rand.Rand, _size: Int) -> Empty { Empty.new }
}

test "EmptyStruct" {
  ~check(Arb[Empty].gen, none) { |_e| true }
}

struct Q {
  m: Map[Int, Int]
  s: [Int]

  def self.arbitrary(r: rand.Rand, size: Int) -> Q {
    s = field_size(size, 2)
    Q.new(m: map_of(int, int).generate(r, s), s: slice_of(int).generate(r, s))
  }
}

# alx slices and maps are never nil; the sizes stay below Go's bounds.
test "NonZeroSliceAndMap" {
  ~check(Arb[Q].gen, none) { |q| q.m.size < 25 && q.s.size < 25 }
}

test "Int64" { |t|
  lo = Atomic.new(0)
  hi = Atomic.new(0)
  cfg = Config.new(max_count: 10000)
  ~check(i64, cfg) { |x|
    lo.store(x) if x < lo.load
    hi.store(x) if x > hi.load
    true
  }
  if lo.load.as_u64 >> 62 == 0 || hi.load.as_u64 >> 62 == 0 {
    t.error("int64 returned range #{lo.load}, #{hi.load}; does not look like full range")
  }
}

# --------------------------------------------------------- beyond Go's tests

enum Shape {
  Circle(Float)
  Rect(w: Int, h: Int)
  Empty

  def self.arbitrary(r: rand.Rand, size: Int) -> Shape {
    rr = r
    k = rr.intn!(3)
    case k {
      0 => Shape.Circle(float.generate(r, field_size(size, 1)))
      1 => {
        s = field_size(size, 2)
        Shape.Rect(w: int.generate(r, s), h: int.generate(r, s))
      }
      _ => Shape.Empty
    }
  }
}

test "derived enum" {
  seen = Atomic.new(0)
  ~check(Arb[Shape].gen, Config.new(max_count: 300)) { |s|
    bit = case s {
      Circle(_) => 1
      Rect(_, _) => 2
      Empty => 4
    }
    seen.store(seen.load | bit)
    true
  }
  assert_eq seen.load, 7
}

test "check2 and check3" {
  ~check2(int, int, none) { |a, b| a +% b == b +% a }
  ~check3(u8, u8, u8, none) { |a, b, c| (a +% b) +% c == a +% (b +% c) }
  ~check_equal2(str, str, none, ->(a: Str, b: Str) -> Int { (a + b).size }, ->(a: Str, b: Str) -> Int { a.size + b.size })
  ~check_equal3(bool, bool, bool, none, ->(a: Bool, b: Bool, c: Bool) -> Bool { a && (b || c) }, ->(a: Bool, b: Bool, c: Bool) -> Bool { a && b || a && c })
}

test "seeded checks repeat" {
  seen1: [Int] = []
  seen2: [Int] = []
  m1 = Mutex.new(seen1)
  m2 = Mutex.new(seen2)
  ~check(int, Config.new(max_count: 5, rand: rand.new(rand.new_source(7)))) { |x|
    m1.lock { |s| s << x }
    true
  }
  ~check(int, Config.new(max_count: 5, rand: rand.new(rand.new_source(7)))) { |x|
    m2.lock { |s| s << x }
    true
  }
  a = m1.lock { |s| s.dup }
  b = m2.lock { |s| s.dup }
  assert_eq a, b
  assert_eq a.size, 5
}

test "max count" { |t|
  assert_eq Config.new.get_max_count, 100
  assert_eq Config.new(max_count_scale: 2.5).get_max_count, 250
  assert_eq Config.new(max_count: 3, max_count_scale: 2.5).get_max_count, 3
  t.setenv("ALX_QUICKCHECKS", "7")
  assert_eq Config.new.get_max_count, 7
  n = Atomic.new(0)
  ~check(bool, none) { |_b|
    n.add(1)
    true
  }
  assert_eq n.load, 7
}

test "messages" {
  r = check(just(5), Config.new(max_count: 3)) { |x| x < 5 }
  assert_eq r.err.unwrap.message, "#1: failed on input 5"
  r2 = check_equal(just("ab"), none, ->(s: Str) -> Int { s.size }, ->(_s: Str) -> Int { 0 })
  assert_eq r2.err.unwrap.message, "#1: failed on input ab. Output 1: 2. Output 2: 0"
}

example "Check" {
  # A property: reversing twice gives back the slice.
  r = check(slice_of(int), none) { |xs| xs.reverse.reverse == xs }
  puts r.ok?
} outputs "true"
