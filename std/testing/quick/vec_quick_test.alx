test "Value [4]byte" {
  r = seeded(1)
  assert_eq value(array_of(u8, 4), r), u8s([82, 79, 29, 3])
  assert_eq value(array_of(u8, 4), r), u8s([209, 216, 30, 148])
  assert_eq value(array_of(u8, 4), r), u8s([160, 153, 4, 39])
  assert_eq value(array_of(u8, 4), r), u8s([54, 212, 11, 217])
  r = seeded(2)
  assert_eq value(array_of(u8, 4), r), u8s([47, 111, 86, 128])
  assert_eq value(array_of(u8, 4), r), u8s([202, 220, 112, 16])
  assert_eq value(array_of(u8, 4), r), u8s([254, 184, 251, 55])
  assert_eq value(array_of(u8, 4), r), u8s([94, 203, 98, 221])
  r = seeded(3)
  assert_eq value(array_of(u8, 4), r), u8s([133, 144, 141, 253])
  assert_eq value(array_of(u8, 4), r), u8s([67, 223, 82, 168])
  assert_eq value(array_of(u8, 4), r), u8s([220, 247, 147, 119])
  assert_eq value(array_of(u8, 4), r), u8s([138, 233, 149, 177])
  r = seeded(4)
  assert_eq value(array_of(u8, 4), r), u8s([226, 175, 194, 154])
  assert_eq value(array_of(u8, 4), r), u8s([45, 195, 165, 44])
  assert_eq value(array_of(u8, 4), r), u8s([58, 95, 138, 135])
  assert_eq value(array_of(u8, 4), r), u8s([187, 220, 251, 149])
  r = seeded(5)
  assert_eq value(array_of(u8, 4), r), u8s([192, 207, 250, 24])
  assert_eq value(array_of(u8, 4), r), u8s([167, 199, 72, 132])
  assert_eq value(array_of(u8, 4), r), u8s([184, 126, 98, 215])
  assert_eq value(array_of(u8, 4), r), u8s([227, 234, 146, 137])
  r = seeded(6)
  assert_eq value(array_of(u8, 4), r), u8s([21, 240, 34, 150])
  assert_eq value(array_of(u8, 4), r), u8s([160, 205, 226, 0])
  assert_eq value(array_of(u8, 4), r), u8s([117, 189, 153, 23])
  assert_eq value(array_of(u8, 4), r), u8s([15, 225, 5, 109])
}

test "Value *int" {
  r = seeded(1)
  assert_eq value(opt_of(int), r), 8674665223082153551
  assert_eq value(opt_of(int), r), -5186171242619765757
  assert_eq value(opt_of(int), r), 6334824724549167320
  assert_eq value(opt_of(int), r), -7779736719522999660
  r = seeded(2)
  assert_eq value(opt_of(int), r), 2444694468985893231
  assert_eq value(opt_of(int), r), -8125999127789868416
  assert_eq value(opt_of(int), r), -667265230072700708
  assert_eq value(opt_of(int), r), 1901437705397112592
  r = seeded(3)
  assert_eq value(opt_of(int), r), -3203915339919981424
  assert_eq value(opt_of(int), r), 7084814199037155581
  assert_eq value(opt_of(int), r), -7202792732509006625
  assert_eq value(opt_of(int), r), -4540794605557144664
  r = seeded(4)
  assert_eq value(opt_of(int), r), -8281558051093610321
  assert_eq value(opt_of(int), r), -481953193382193254
  assert_eq value(opt_of(int), r), 4307986189735425219
  assert_eq value(opt_of(int), r), 5146173177555719724
  r = seeded(5)
  assert_eq value(opt_of(int), r), -4430730402169269297
  assert_eq value(opt_of(int), r), -3719335021772421864
