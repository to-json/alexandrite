# Generated from Go's testing/quick (Value with seeded math/rand sources); do not edit by hand.

import "math/rand"

def seeded(s: Int) -> rand.Rand { rand.new(rand.new_source(s)) }

def fb(x: U64) -> Float { x.__from_bits }

def bs(xs: [Int]) -> Str { Str.from_bytes(xs.map { |x| x.as_u8 }.to_a) }

def u8s(xs: [Int]) -> [U8] { xs.map { |x| x.as_u8 }.to_a }

def ints(xs: [Int]) -> [Int] { xs }

def sorted_entries(m: Map[Int, Int]) -> [(Int, Int)] { m.keys.sort.map { |k| (k, m[k] || 0) }.to_a }

