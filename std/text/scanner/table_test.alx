# Go's tables from text/scanner's scanner_test.go (segmentList, tokenList and
# TestNumbers's), translated by a Go program (scratchpad/genscan); do not
# edit by hand. The tests using them are in scanner_test.alx.

def segment_list -> [[Str]] {
  t: [[Str]] = []
  t << []
  t << [""]
  t << ["日", "本語"]
  t << ["日", "本", "語"]
  t << ["日", " ", "本", "語"]
  t << [raw([230]), raw([151, 165, 230]), raw([156, 172, 232, 170, 158])]
  t << ["Hello", ", ", "World", "!"]
  t << ["Hello", ", ", "", "World", "!"]
  t
}

def token_list -> [(Rune, Str)] {
  t: [(Rune, Str)] = []
  t << (COMMENT, "// line comments")
  t << (COMMENT, "//")
  t << (COMMENT, "////")
  t << (COMMENT, "// comment")
  t << (COMMENT, "// /* comment */")
  t << (COMMENT, "// // comment //")
  t << (COMMENT, "//" + f100)
  t << (COMMENT, "// general comments")
  t << (COMMENT, "/**/")
  t << (COMMENT, "/***/")
  t << (COMMENT, "/* comment */")
  t << (COMMENT, "/* // comment */")
  t << (COMMENT, "/* /* comment */")
  t << (COMMENT, "/*\n comment\n*/")
  t << (COMMENT, "/*" + f100 + "*/")
  t << (COMMENT, "// identifiers")
  t << (IDENT, "a")
  t << (IDENT, "a0")
  t << (IDENT, "foobar")
  t << (IDENT, "abc123")
  t << (IDENT, "LGTM")
  t << (IDENT, "_")
  t << (IDENT, "_abc123")
  t << (IDENT, "abc123_")
  t << (IDENT, "_abc_123_")
  t << (IDENT, "_äöü")
  t << (IDENT, "_本")
  t << (IDENT, "äöü")
  t << (IDENT, "本")
  t << (IDENT, "a۰۱۸")
  t << (IDENT, "foo६४")
  t << (IDENT, "bar９８７６")
  t << (IDENT, f100)
  t << (COMMENT, "// decimal ints")
  t << (INT, "0")
  t << (INT, "1")
  t << (INT, "9")
  t << (INT, "42")
  t << (INT, "1234567890")
  t << (COMMENT, "// octal ints")
  t << (INT, "00")
  t << (INT, "01")
  t << (INT, "07")
  t << (INT, "042")
  t << (INT, "01234567")
  t << (COMMENT, "// hexadecimal ints")
  t << (INT, "0x0")
  t << (INT, "0x1")
  t << (INT, "0xf")
  t << (INT, "0x42")
  t << (INT, "0x123456789abcDEF")
  t << (INT, "0x" + f100)
  t << (INT, "0X0")
  t << (INT, "0X1")
  t << (INT, "0XF")
  t << (INT, "0X42")
  t << (INT, "0X123456789abcDEF")
  t << (INT, "0X" + f100)
  t << (COMMENT, "// floats")
  t << (FLOAT, "0.")
  t << (FLOAT, "1.")
  t << (FLOAT, "42.")
  t << (FLOAT, "01234567890.")
  t << (FLOAT, ".0")
  t << (FLOAT, ".1")
  t << (FLOAT, ".42")
  t << (FLOAT, ".0123456789")
  t << (FLOAT, "0.0")
  t << (FLOAT, "1.0")
  t << (FLOAT, "42.0")
  t << (FLOAT, "01234567890.0")
  t << (FLOAT, "0e0")
  t << (FLOAT, "1e0")
  t << (FLOAT, "42e0")
  t << (FLOAT, "01234567890e0")
  t << (FLOAT, "0E0")
  t << (FLOAT, "1E0")
  t << (FLOAT, "42E0")
  t << (FLOAT, "01234567890E0")
  t << (FLOAT, "0e+10")
  t << (FLOAT, "1e-10")
  t << (FLOAT, "42e+10")
  t << (FLOAT, "01234567890e-10")
  t << (FLOAT, "0E+10")
  t << (FLOAT, "1E-10")
  t << (FLOAT, "42E+10")
  t << (FLOAT, "01234567890E-10")
  t << (COMMENT, "// chars")
  t << (CHAR, "' '")
  t << (CHAR, "'a'")
  t << (CHAR, "'本'")
  t << (CHAR, "'\\a'")
  t << (CHAR, "'\\b'")
  t << (CHAR, "'\\f'")
  t << (CHAR, "'\\n'")
  t << (CHAR, "'\\r'")
  t << (CHAR, "'\\t'")
  t << (CHAR, "'\\v'")
  t << (CHAR, "'\\''")
  t << (CHAR, "'\\000'")
  t << (CHAR, "'\\777'")
  t << (CHAR, "'\\x00'")
  t << (CHAR, "'\\xff'")
  t << (CHAR, "'\\u0000'")
  t << (CHAR, "'\\ufA16'")
  t << (CHAR, "'\\U00000000'")
  t << (CHAR, "'\\U0000ffAB'")
  t << (COMMENT, "// strings")
  t << (STRING, "\" \"")
  t << (STRING, "\"a\"")
  t << (STRING, "\"本\"")
  t << (STRING, "\"\\a\"")
  t << (STRING, "\"\\b\"")
  t << (STRING, "\"\\f\"")
  t << (STRING, "\"\\n\"")
  t << (STRING, "\"\\r\"")
  t << (STRING, "\"\\t\"")
  t << (STRING, "\"\\v\"")
  t << (STRING, "\"\\\"\"")
  t << (STRING, "\"\\000\"")
  t << (STRING, "\"\\777\"")
  t << (STRING, "\"\\x00\"")
  t << (STRING, "\"\\xff\"")
  t << (STRING, "\"\\u0000\"")
  t << (STRING, "\"\\ufA16\"")
  t << (STRING, "\"\\U00000000\"")
  t << (STRING, "\"\\U0000ffAB\"")
  t << (STRING, "\"" + f100 + "\"")
  t << (COMMENT, "// raw strings")
  t << (RAW_STRING, "``")
  t << (RAW_STRING, "`\\`")
  t << (RAW_STRING, "`\n\n/* foobar */\n\n`")
  t << (RAW_STRING, "`" + f100 + "`")
  t << (COMMENT, "// individual characters")
  t << (1, "\x01")
  t << (31, "\x1f")
  t << (43, "+")
  t << (47, "/")
  t << (46, ".")
  t << (126, "~")
  t << (40, "(")
  t
}

def number_tests -> [(Rune, Str, Str, Str)] {
  t: [(Rune, Str, Str, Str)] = []
  t << (INT, "0b0", "0b0", "")
  t << (INT, "0b1010", "0b1010", "")
  t << (INT, "0B1110", "0B1110", "")
  t << (INT, "0b", "0b", "binary literal has no digits")
  t << (INT, "0b0190", "0b0190", "invalid digit '9' in binary literal")
  t << (INT, "0b01a0", "0b01 a0", "")
  t << (FLOAT, "0b.", "0b.", "invalid radix point in binary literal")
  t << (FLOAT, "0b.1", "0b.1", "invalid radix point in binary literal")
  t << (FLOAT, "0b1.0", "0b1.0", "invalid radix point in binary literal")
  t << (FLOAT, "0b1e10", "0b1e10", "'e' exponent requires decimal mantissa")
  t << (FLOAT, "0b1P-1", "0b1P-1", "'P' exponent requires hexadecimal mantissa")
  t << (INT, "0o0", "0o0", "")
  t << (INT, "0o1234", "0o1234", "")
  t << (INT, "0O1234", "0O1234", "")
  t << (INT, "0o", "0o", "octal literal has no digits")
  t << (INT, "0o8123", "0o8123", "invalid digit '8' in octal literal")
  t << (INT, "0o1293", "0o1293", "invalid digit '9' in octal literal")
  t << (INT, "0o12a3", "0o12 a3", "")
  t << (FLOAT, "0o.", "0o.", "invalid radix point in octal literal")
  t << (FLOAT, "0o.2", "0o.2", "invalid radix point in octal literal")
  t << (FLOAT, "0o1.2", "0o1.2", "invalid radix point in octal literal")
  t << (FLOAT, "0o1E+2", "0o1E+2", "'E' exponent requires decimal mantissa")
  t << (FLOAT, "0o1p10", "0o1p10", "'p' exponent requires hexadecimal mantissa")
  t << (INT, "0", "0", "")
  t << (INT, "0123", "0123", "")
  t << (INT, "08123", "08123", "invalid digit '8' in octal literal")
  t << (INT, "01293", "01293", "invalid digit '9' in octal literal")
  t << (INT, "0F.", "0 F .", "")
  t << (INT, "0123F.", "0123 F .", "")
  t << (INT, "0123456x", "0123456 x", "")
  t << (INT, "1", "1", "")
  t << (INT, "1234", "1234", "")
  t << (INT, "1f", "1 f", "")
  t << (FLOAT, "0.", "0.", "")
  t << (FLOAT, "123.", "123.", "")
  t << (FLOAT, "0123.", "0123.", "")
  t << (FLOAT, ".0", ".0", "")
  t << (FLOAT, ".123", ".123", "")
  t << (FLOAT, ".0123", ".0123", "")
  t << (FLOAT, "0.0", "0.0", "")
  t << (FLOAT, "123.123", "123.123", "")
  t << (FLOAT, "0123.0123", "0123.0123", "")
  t << (FLOAT, "0e0", "0e0", "")
  t << (FLOAT, "123e+0", "123e+0", "")
  t << (FLOAT, "0123E-1", "0123E-1", "")
  t << (FLOAT, "0.e+1", "0.e+1", "")
  t << (FLOAT, "123.E-10", "123.E-10", "")
  t << (FLOAT, "0123.e123", "0123.e123", "")
  t << (FLOAT, ".0e-1", ".0e-1", "")
  t << (FLOAT, ".123E+10", ".123E+10", "")
  t << (FLOAT, ".0123E123", ".0123E123", "")
  t << (FLOAT, "0.0e1", "0.0e1", "")
  t << (FLOAT, "123.123E-10", "123.123E-10", "")
  t << (FLOAT, "0123.0123e+456", "0123.0123e+456", "")
  t << (FLOAT, "0e", "0e", "exponent has no digits")
  t << (FLOAT, "0E+", "0E+", "exponent has no digits")
  t << (FLOAT, "1e+f", "1e+ f", "exponent has no digits")
  t << (FLOAT, "0p0", "0p0", "'p' exponent requires hexadecimal mantissa")
  t << (FLOAT, "1.0P-1", "1.0P-1", "'P' exponent requires hexadecimal mantissa")
  t << (INT, "0x0", "0x0", "")
  t << (INT, "0x1234", "0x1234", "")
  t << (INT, "0xcafef00d", "0xcafef00d", "")
  t << (INT, "0XCAFEF00D", "0XCAFEF00D", "")
  t << (INT, "0x", "0x", "hexadecimal literal has no digits")
  t << (INT, "0x1g", "0x1 g", "")
  t << (FLOAT, "0x0p0", "0x0p0", "")
  t << (FLOAT, "0x12efp-123", "0x12efp-123", "")
  t << (FLOAT, "0xABCD.p+0", "0xABCD.p+0", "")
  t << (FLOAT, "0x.0189P-0", "0x.0189P-0", "")
  t << (FLOAT, "0x1.ffffp+1023", "0x1.ffffp+1023", "")
  t << (FLOAT, "0x.", "0x.", "hexadecimal literal has no digits")
  t << (FLOAT, "0x0.", "0x0.", "hexadecimal mantissa requires a 'p' exponent")
  t << (FLOAT, "0x.0", "0x.0", "hexadecimal mantissa requires a 'p' exponent")
  t << (FLOAT, "0x1.1", "0x1.1", "hexadecimal mantissa requires a 'p' exponent")
  t << (FLOAT, "0x1.1e0", "0x1.1e0", "hexadecimal mantissa requires a 'p' exponent")
  t << (FLOAT, "0x1.2gp1a", "0x1.2 gp1a", "hexadecimal mantissa requires a 'p' exponent")
  t << (FLOAT, "0x0p", "0x0p", "exponent has no digits")
  t << (FLOAT, "0xeP-", "0xeP-", "exponent has no digits")
  t << (FLOAT, "0x1234PAB", "0x1234P AB", "exponent has no digits")
  t << (FLOAT, "0x1.2p1a", "0x1.2p1 a", "")
  t << (INT, "0b_1000_0001", "0b_1000_0001", "")
  t << (INT, "0o_600", "0o_600", "")
  t << (INT, "0_466", "0_466", "")
  t << (INT, "1_000", "1_000", "")
  t << (FLOAT, "1_000.000_1", "1_000.000_1", "")
  t << (INT, "0x_f00d", "0x_f00d", "")
  t << (FLOAT, "0x_f00d.0p1_2", "0x_f00d.0p1_2", "")
  t << (INT, "0b__1000", "0b__1000", "'_' must separate successive digits")
  t << (INT, "0o60___0", "0o60___0", "'_' must separate successive digits")
  t << (INT, "0466_", "0466_", "'_' must separate successive digits")
  t << (FLOAT, "1_.", "1_.", "'_' must separate successive digits")
  t << (FLOAT, "0._1", "0._1", "'_' must separate successive digits")
  t << (FLOAT, "2.7_e0", "2.7_e0", "'_' must separate successive digits")
  t << (INT, "0x___0", "0x___0", "'_' must separate successive digits")
  t << (FLOAT, "0x1.0_p0", "0x1.0_p0", "'_' must separate successive digits")
  t
}
