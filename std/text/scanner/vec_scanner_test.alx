  assert_eq trace("*/\\u12\\u12\"s\"1.5e\n\r 1_000.", 1012, 4294968320), "\"*\" \"*\" 0:1:1|1:1:2; \"/\" \"/\" 1:1:2|2:1:3; \"\\\\\" \"\\\\\" 2:1:3|3:1:4; Ident \"u12\" 3:1:4|6:1:7; \"\\\\\" \"\\\\\" 6:1:7|7:1:8; Ident \"u12\" 7:1:8|10:1:11; String \"\\\"s\\\"\" 10:1:11|13:1:14; E(exponent has no digits @<input>:1:18 17 text=\"1.5e\") Float \"1.5e\" 13:1:14|17:1:18; \"\\r\" \"\\r\" 18:2:1|19:2:2; Float \"1_000.\" 20:2:3|26:2:9; EOF \"\" 26:2:9|26:2:9; errors=1"
}
