# Go's tabwriter_test.go table, translated by a Go program
# (scratchpad/gentab); do not edit by hand. ff(s) turns U+E000 into the
# byte 0xFF (Go's "\xff", which an alx string literal can't hold).

def tests -> [TabTest] {
  t: [TabTest] = []
  t << TabTest.new(name: "1a", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "", expected: "")
  t << TabTest.new(name: "1a debug", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: DEBUG, src: "", expected: "")
  t << TabTest.new(name: "1b esc stripped", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: STRIP_ESCAPE, src: ff("\ue000\ue000"), expected: "")
  t << TabTest.new(name: "1b esc", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: ff("\ue000\ue000"), expected: ff("\ue000\ue000"))
  t << TabTest.new(name: "1c esc stripped", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: STRIP_ESCAPE, src: ff("\ue000\t\ue000"), expected: "\t")
  t << TabTest.new(name: "1c esc", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: ff("\ue000\t\ue000"), expected: ff("\ue000\t\ue000"))
  t << TabTest.new(name: "1d esc stripped", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: STRIP_ESCAPE, src: ff("\ue000\"foo\t\n\tbar\"\ue000"), expected: "\"foo\t\n\tbar\"")
  t << TabTest.new(name: "1d esc", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: ff("\ue000\"foo\t\n\tbar\"\ue000"), expected: ff("\ue000\"foo\t\n\tbar\"\ue000"))
  t << TabTest.new(name: "1e esc stripped", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: STRIP_ESCAPE, src: ff("abc\ue000\tdef"), expected: "abc\tdef")
  t << TabTest.new(name: "1e esc", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: ff("abc\ue000\tdef"), expected: ff("abc\ue000\tdef"))
  t << TabTest.new(name: "2", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "\n\n\n", expected: "\n\n\n")
  t << TabTest.new(name: "3", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "a\nb\nc", expected: "a\nb\nc")
  t << TabTest.new(name: "4a", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "\t", expected: "")
  t << TabTest.new(name: "4b", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: ALIGN_RIGHT, src: "\t", expected: "")
  t << TabTest.new(name: "5", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "*\t*", expected: "*.......*")
  t << TabTest.new(name: "5b", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "*\t*\n", expected: "*.......*\n")
  t << TabTest.new(name: "5c", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "*\t*\t", expected: "*.......*")
  t << TabTest.new(name: "5c debug", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: DEBUG, src: "*\t*\t", expected: "*.......|*")
  t << TabTest.new(name: "5d", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: ALIGN_RIGHT, src: "*\t*\t", expected: ".......**")
  t << TabTest.new(name: "6", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "\t\n", expected: "........\n")
  t << TabTest.new(name: "7a", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "a) foo", expected: "a) foo")
  t << TabTest.new(name: "7b", minwidth: 8, tabwidth: 0, padding: 1, padchar: 32, flags: 0, src: "b) foo\tbar", expected: "b) foo  bar")
  t << TabTest.new(name: "7c", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "c) foo\tbar\t", expected: "c) foo..bar")
  t << TabTest.new(name: "7d", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "d) foo\tbar\n", expected: "d) foo..bar\n")
  t << TabTest.new(name: "7e", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "e) foo\tbar\t\n", expected: "e) foo..bar.....\n")
  t << TabTest.new(name: "7f", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: FILTER_HTML, src: "f) f&lt;o\t<b>bar</b>\t\n", expected: "f) f&lt;o..<b>bar</b>.....\n")
  t << TabTest.new(name: "7g", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: FILTER_HTML, src: "g) f&lt;o\t<b>bar</b>\t non-terminated entity &amp", expected: "g) f&lt;o..<b>bar</b>..... non-terminated entity &amp")
  t << TabTest.new(name: "7g debug", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: FILTER_HTML | DEBUG, src: "g) f&lt;o\t<b>bar</b>\t non-terminated entity &amp", expected: "g) f&lt;o..|<b>bar</b>.....| non-terminated entity &amp")
  t << TabTest.new(name: "8", minwidth: 8, tabwidth: 0, padding: 1, padchar: 42, flags: 0, src: "Hello, world!\n", expected: "Hello, world!\n")
  t << TabTest.new(name: "9a", minwidth: 1, tabwidth: 0, padding: 0, padchar: 46, flags: 0, src: "1\t2\t3\t4\n11\t222\t3333\t44444\n", expected: "1.2..3...4\n11222333344444\n")
  t << TabTest.new(name: "9b", minwidth: 1, tabwidth: 0, padding: 0, padchar: 46, flags: FILTER_HTML, src: "1\t2<!---\f--->\t3\t4\n11\t222\t3333\t44444\n", expected: "1.2<!---\f--->..3...4\n11222333344444\n")
  t << TabTest.new(name: "9c", minwidth: 1, tabwidth: 0, padding: 0, padchar: 46, flags: 0, src: "1\t2\t3\t4\f11\t222\t3333\t44444\n", expected: "1234\n11222333344444\n")
  t << TabTest.new(name: "9c debug", minwidth: 1, tabwidth: 0, padding: 0, padchar: 46, flags: DEBUG, src: "1\t2\t3\t4\f11\t222\t3333\t44444\n", expected: "1|2|3|4\n---\n11|222|3333|44444\n")
  t << TabTest.new(name: "10a", minwidth: 5, tabwidth: 0, padding: 0, padchar: 46, flags: 0, src: "1\t2\t3\t4\n", expected: "1....2....3....4\n")
  t << TabTest.new(name: "10b", minwidth: 5, tabwidth: 0, padding: 0, padchar: 46, flags: 0, src: "1\t2\t3\t4\t\n", expected: "1....2....3....4....\n")
  t << TabTest.new(name: "11", minwidth: 8, tabwidth: 0, padding: 1, padchar: 46, flags: 0, src: "本\tb\tc\naa\t本本本\tcccc\tddddd\naaa\tbbbb\n", expected: "本.......b.......c\naa......本本本.....cccc....ddddd\naaa.....bbbb\n")
  t << TabTest.new(name: "12a", minwidth: 8, tabwidth: 0, padding: 1, padchar: 32, flags: ALIGN_RIGHT, src: "a\tè\tc\t\naa\tèèè\tcccc\tddddd\t\naaa\tèèèè\t\n", expected: "       a       è       c\n      aa     èèè    cccc   ddddd\n     aaa    èèèè\n")
  t << TabTest.new(name: "12b", minwidth: 2, tabwidth: 0, padding: 0, padchar: 32, flags: 0, src: "a\tb\tc\naa\tbbb\tcccc\naaa\tbbbb\n", expected: "a  b  c\naa bbbcccc\naaabbbb\n")
  t << TabTest.new(name: "12c", minwidth: 8, tabwidth: 0, padding: 1, padchar: 95, flags: 0, src: "a\tb\tc\naa\tbbb\tcccc\naaa\tbbbb\n", expected: "a_______b_______c\naa______bbb_____cccc\naaa_____bbbb\n")
  t << TabTest.new(name: "13a", minwidth: 4, tabwidth: 0, padding: 1, padchar: 45, flags: 0, src: "4444\t日本語\t22\t1\t333\n999999999\t22\n7\t22\n\t\t\t88888888\n\n666666\t666666\t666666\t4444\n1\t1\t999999999\t0000000000\n", expected: "4444------日本語-22--1---333\n999999999-22\n7---------22\n------------------88888888\n\n666666-666666-666666----4444\n1------1------999999999-0000000000\n")
  t << TabTest.new(name: "13b", minwidth: 4, tabwidth: 0, padding: 3, padchar: 46, flags: 0, src: "4444\t333\t22\t1\t333\n999999999\t22\n7\t22\n\t\t\t88888888\n\n666666\t666666\t666666\t4444\n1\t1\t999999999\t0000000000\n", expected: "4444........333...22...1...333\n999999999...22\n7...........22\n....................88888888\n\n666666...666666...666666......4444\n1........1........999999999...0000000000\n")
  t << TabTest.new(name: "13c", minwidth: 8, tabwidth: 8, padding: 1, padchar: 9, flags: FILTER_HTML, src: "4444\t333\t22\t1\t333\n999999999\t22\n7\t22\n\t\t\t88888888\n\n666666\t666666\t666666\t4444\n1\t1\t<font color=red attr=日本語>999999999</font>\t0000000000\n", expected: "4444\t\t333\t22\t1\t333\n999999999\t22\n7\t\t22\n\t\t\t\t88888888\n\n666666\t666666\t666666\t\t4444\n1\t1\t<font color=red attr=日本語>999999999</font>\t0000000000\n")
  t << TabTest.new(name: "14", minwidth: 1, tabwidth: 0, padding: 2, padchar: 32, flags: ALIGN_RIGHT, src: ".0\t.3\t2.4\t-5.1\t\n23.0\t12345678.9\t2.4\t-989.4\t\n5.1\t12.0\t2.4\t-7.0\t\n.0\t0.0\t332.0\t8908.0\t\n.0\t-.3\t456.4\t22.1\t\n.0\t1.2\t44.4\t-13.3\t\t", expected: "    .0          .3    2.4    -5.1\n  23.0  12345678.9    2.4  -989.4\n   5.1        12.0    2.4    -7.0\n    .0         0.0  332.0  8908.0\n    .0         -.3  456.4    22.1\n    .0         1.2   44.4   -13.3")
  t << TabTest.new(name: "14 debug", minwidth: 1, tabwidth: 0, padding: 2, padchar: 32, flags: ALIGN_RIGHT | DEBUG, src: ".0\t.3\t2.4\t-5.1\t\n23.0\t12345678.9\t2.4\t-989.4\t\n5.1\t12.0\t2.4\t-7.0\t\n.0\t0.0\t332.0\t8908.0\t\n.0\t-.3\t456.4\t22.1\t\n.0\t1.2\t44.4\t-13.3\t\t", expected: "    .0|          .3|    2.4|    -5.1|\n  23.0|  12345678.9|    2.4|  -989.4|\n   5.1|        12.0|    2.4|    -7.0|\n    .0|         0.0|  332.0|  8908.0|\n    .0|         -.3|  456.4|    22.1|\n    .0|         1.2|   44.4|   -13.3|")
  t << TabTest.new(name: "15a", minwidth: 4, tabwidth: 0, padding: 0, padchar: 46, flags: 0, src: "a\t\tb", expected: "a.......b")
  t << TabTest.new(name: "15b", minwidth: 4, tabwidth: 0, padding: 0, padchar: 46, flags: DISCARD_EMPTY_COLUMNS, src: "a\t\tb", expected: "a.......b")
  t << TabTest.new(name: "15c", minwidth: 4, tabwidth: 0, padding: 0, padchar: 46, flags: DISCARD_EMPTY_COLUMNS, src: "a\v\vb", expected: "a...b")
  t << TabTest.new(name: "15d", minwidth: 4, tabwidth: 0, padding: 0, padchar: 46, flags: ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS, src: "a\v\vb", expected: "...ab")
  t << TabTest.new(name: "16a", minwidth: 100, tabwidth: 100, padding: 0, padchar: 9, flags: 0, src: "a\tb\t\td\na\tb\t\td\te\na\na\tb\tc\td\na\tb\tc\td\te\n", expected: "a\tb\t\td\na\tb\t\td\te\na\na\tb\tc\td\na\tb\tc\td\te\n")
  t << TabTest.new(name: "16b", minwidth: 100, tabwidth: 100, padding: 0, padchar: 9, flags: DISCARD_EMPTY_COLUMNS, src: "a\vb\v\vd\na\vb\v\vd\ve\na\na\vb\vc\vd\na\vb\vc\vd\ve\n", expected: "a\tb\td\na\tb\td\te\na\na\tb\tc\td\na\tb\tc\td\te\n")
  t << TabTest.new(name: "16b debug", minwidth: 100, tabwidth: 100, padding: 0, padchar: 9, flags: DISCARD_EMPTY_COLUMNS | DEBUG, src: "a\vb\v\vd\na\vb\v\vd\ve\na\na\vb\vc\vd\na\vb\vc\vd\ve\n", expected: "a\t|b\t||d\na\t|b\t||d\t|e\na\na\t|b\t|c\t|d\na\t|b\t|c\t|d\t|e\n")
  t << TabTest.new(name: "16c", minwidth: 100, tabwidth: 100, padding: 0, padchar: 9, flags: DISCARD_EMPTY_COLUMNS, src: "a\tb\t\td\na\tb\t\td\te\na\na\tb\tc\td\na\tb\tc\td\te\n", expected: "a\tb\t\td\na\tb\t\td\te\na\na\tb\tc\td\na\tb\tc\td\te\n")
  t << TabTest.new(name: "16c debug", minwidth: 100, tabwidth: 100, padding: 0, padchar: 9, flags: DISCARD_EMPTY_COLUMNS | DEBUG, src: "a\tb\t\td\na\tb\t\td\te\na\na\tb\tc\td\na\tb\tc\td\te\n", expected: "a\t|b\t|\t|d\na\t|b\t|\t|d\t|e\na\na\t|b\t|c\t|d\na\t|b\t|c\t|d\t|e\n")
  t
}
