import "bytes"
import "io"
import "strconv"
import "strings"

struct TabTest {
  name: Str
  minwidth: Int
  tabwidth: Int
  padding: Int
  padchar: Byte
  flags: Int
  src: Str
  expected: Str
}

# s with each U+E000 replaced by the byte 0xFF.
def ff(s: Str) -> Str {
  out: [Byte] = []
  i = 0
  while i < s.size {
    if i + 2 < s.size && s[i] == 0xEE && s[i + 1] == 0x80 && s[i + 2] == 0x80 {
      out << 0xFF
      i += 3
    } else {
      out << s[i]
      i += 1
    }
  }
  Str.from_bytes(out)
}

def write(name: Str, w: Writer[bytes.Buffer], src: Str) {
  written = io.write_string(w, src)
  assert !written.err?, "--- test: #{name}\n--- src:\n#{strconv.quote(src)}\n--- write error"
  assert written.unwrap == src.size, "--- test: #{name}: written = #{written.unwrap}, len(src) = #{src.size}"
}

def verify(name: Str, w: Writer[bytes.Buffer], b: bytes.Buffer, src: Str, expected: Str) {
  ww = w
  err = ww.flush!
  assert !err.err?, "--- test: #{name}\n--- src:\n#{strconv.quote(src)}\n--- flush error"
  res = b.string
  assert res == expected, "--- test: #{name}\n--- src:\n#{strconv.quote(src)}\n--- found:\n#{strconv.quote(res)}\n--- expected:\n#{strconv.quote(expected)}"
}

def check(name: Str, minwidth: Int, tabwidth: Int, padding: Int, padchar: Byte, flags: Int, src: Str, expected: Str) {
  b = bytes.new_buffer_string("")
  w = Writer[bytes.Buffer].new(st: [])
  w.init!(b, minwidth, tabwidth, padding, padchar, flags)

  # All at once.
  title = name + " (written all at once)"
  b.reset!
  write(title, w, src)
  verify(title, w, b, src, expected)

  # Byte by byte.
  title = name + " (written byte-by-byte)"
  b.reset!
  i = 0
  while i < src.size {
    write(title, w, src[i...i + 1])
    i += 1
  }
  verify(title, w, b, src, expected)

  # In slices of Fibonacci sizes.
  title = name + " (written in fibonacci slices)"
  b.reset!
  i = 0
  d = 0
  while i < src.size {
    write(title, w, src[i...i + d])
    i, d = (i + d, d + 1)
    d = src.size - i if i + d > src.size
  }
  verify(title, w, b, src, expected)
}

test "table" {
  for e in tests {
    check(e.name, e.minwidth, e.tabwidth, e.padding, e.padchar, e.flags, e.src, e.expected)
  }
}

# A writer failing every write (Go's panicWriter panics; here the failure is
# an error, which comes back from write! / flush!).
struct FailWriter {
  def write!(p: [Byte]) -> ~Int {
    fail "cannot write"
  }
}

test "error during flush" {
  w = new_writer(FailWriter.new, 0, 0, 5, 0x20, 0)
  io.write_string(w, "a").unwrap
  r = w.flush!
  assert r.err?, "failed to fail during flush"
  assert_eq r.err.unwrap.message, "cannot write"
}

# Fails its first write, then records what it gets.
struct Flaky {
  st: [[Byte]] # st[0]: what was written; st[1]: [1] once it has failed

  def write!(p: [Byte]) -> ~Int {
    if st[1].size == 0 {
      self.st[1] << 1
      fail "flaky"
    }
    for c in p {
      self.st[0] << c
    }
    p.size
  }
}

test "a failed flush resets the writer" {
  f = Flaky.new(st: [[], []])
  w = new_writer(f, 0, 8, 1, 0x20, 0)
  w.write_string!("x	y").unwrap
  assert w.flush!.err?, "the first flush should fail"
  w.write_string!("z").unwrap
  w.flush!.unwrap
  assert_eq Str.from_bytes(f.st[0]), "z"
}

test "error during write" {
  w = new_writer(FailWriter.new, 0, 0, 5, 0x20, 0)
  # The second \n makes the Writer write.
  r = io.write_string(w, "a\n\n")
  assert r.err?, "failed to fail during write"
  assert_eq r.err.unwrap.message, "cannot write"
}

test "a copy writes to the same buffer" {
  b = bytes.new_buffer_string("")
  w = new_writer(b, 0, 8, 1, 0x20, 0)
  c = w
  c.write_string!("a\tb\n").unwrap
  w.write_string!("aaa\tb\n").unwrap
  w.flush!.unwrap
  assert_eq b.string, "a   b\naaa b\n"
}

# The generated vectors' helper: src written at once and flushed.
def tab(src: Str, minwidth: Int, tabwidth: Int, padding: Int, padchar: Byte, flags: Int) -> Str {
  b = bytes.new_buffer_string("")
  w = new_writer(b, minwidth, tabwidth, padding, padchar, flags)
  w.write_string!(src).unwrap
  w.flush!.unwrap
  b.string
}

example "writer init" {
  b = bytes.new_buffer_string("")
  w = Writer[bytes.Buffer].new(st: [])
  # Tab-separated columns with a tab stop of 8.
  w.init!(b, 0, 8, 0, 0x09, 0)
  w.write_string!("a\tb\tc\td\t.\n").unwrap
  w.write_string!("123\t12345\t1234567\t123456789\t.\n").unwrap
  w.write_string!("\n").unwrap
  w.flush!.unwrap
  # Right-aligned in space-separated columns of minimal width 5 and at least
  # one blank of padding.
  w.init!(b, 5, 0, 1, 0x20, ALIGN_RIGHT)
  w.write_string!("a\tb\tc\td\t.\n").unwrap
  w.write_string!("123\t12345\t1234567\t123456789\t.\n").unwrap
  w.write_string!("\n").unwrap
  w.flush!.unwrap
  print b.string
} outputs "a\tb\tc\td\t\t.\n123\t12345\t1234567\t123456789\t.\n\n    a     b       c         d.\n  123 12345 1234567 123456789.\n\n"

example "elastic" {
  # The b's and the d's, though in the second cell of each line, belong to
  # different columns.
  b = bytes.new_buffer_string("")
  w = new_writer(b, 0, 0, 1, 0x2E, ALIGN_RIGHT | DEBUG)
  w.write_string!("a\tb\tc\n").unwrap
  w.write_string!("aa\tbb\tcc\n").unwrap
  w.write_string!("aaa\t\n").unwrap
  w.write_string!("aaaa\tdddd\teeee\n").unwrap
  w.flush!.unwrap
  print b.string
} outputs "....a|..b|c\n...aa|.bb|cc\n..aaa|\n.aaaa|.dddd|eeee\n"

example "trailing tab" {
  # The third line has no trailing tab, so its last cell is not part of an
  # aligned column.
  b = bytes.new_buffer_string("")
  w = new_writer(b, 0, 0, 3, 0x2D, ALIGN_RIGHT | DEBUG)
  w.write_string!("a\tb\taligned\t\n").unwrap
  w.write_string!("aa\tbb\taligned\t\n").unwrap
  w.write_string!("aaa\tbbb\tunaligned\n").unwrap
  w.write_string!("aaaa\tbbbb\taligned\t\n").unwrap
  w.flush!.unwrap
  print b.string
} outputs "------a|------b|---aligned|\n-----aa|-----bb|---aligned|\n----aaa|----bbb|unaligned\n---aaaa|---bbbb|---aligned|\n"

def bench_lines(cells: Int, h: Int) {
  line = strings.repeat("a\t", cells) + "\n"
  w = new_writer(io.Discard.new, 4, 4, 1, 0x20, 0)
  j = 0
  while j < h {
    w.write_string!(line).unwrap
    j += 1
  }
  w.flush!.unwrap
}

bench "table 1x10" { bench_lines(1, 10) }
bench "table 1x1000" { bench_lines(1, 1000) }
bench "table 10x10" { bench_lines(10, 10) }
bench "table 10x1000" { bench_lines(10, 1000) }
bench "table 100x10" { bench_lines(100, 10) }
bench "table 100x1000" { bench_lines(100, 1000) }

bench "pyramid 100" {
  line = strings.repeat("a\t", 100)
  w = new_writer(io.Discard.new, 4, 4, 1, 0x20, 0)
  j = 0
  while j < 100 {
    w.write_string!(line[0...j * 2]).unwrap
    w.write_string!("\n").unwrap
    j += 1
  }
  w.flush!.unwrap
}

bench "ragged 100" {
  widths = [6, 2, 9, 5, 5, 7, 3, 8]
  w = new_writer(io.Discard.new, 4, 4, 1, 0x20, 0)
  j = 0
  while j < 100 {
    w.write_string!(strings.repeat("a\t", widths[j % widths.size])).unwrap
    w.write_string!("\n").unwrap
    j += 1
  }
  w.flush!.unwrap
}

bench "code" {
  w = new_writer(io.Discard.new, 4, 4, 1, 0x20, 0)
  w.write_string!("\nsome command\n\nfoo\t# aligned\nbarbaz\t# comments\n\nbut\nmostly\nsingle\ncell\nlines\n").unwrap
  w.flush!.unwrap
}
