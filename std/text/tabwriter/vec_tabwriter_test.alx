  assert_eq tab(".>cc\t\n&<b>\t<>\v<b>xb.\t\t\n&amp;\t日本ddd\t\t\tcc&amp;> ", 2, 3, 2, 42, FILTER_HTML | DEBUG), ".>cc**|\n&<b>\t<>\v<b>xb.\t\t\n&amp;*****|日本ddd**|**|**|cc&amp;> "
