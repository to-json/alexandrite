  assert_eq tab(ff("<b>\ue000\t\ue000\n\t&ddd\ue000"), 2, 8, 2, 42, STRIP_ESCAPE | ALIGN_RIGHT), "<b>\t\n**&ddd"
  assert_eq tab("日本;;日本\v;a \n \t .日本\t\tcc\t\t", 1, 3, 0, 45, FILTER_HTML | STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | DEBUG), "日本;;日本|;a \n -----| .日本|-|cc|"
  assert_eq tab(ff("a&amp;\tx<\t\t\t&\ue000\t\ue000acc ax<b>"), 5, 7, 3, 46, STRIP_ESCAPE | TAB_INDENT), "a&amp;...x<.............&\tacc ax<b>"
  assert_eq tab("é&amp;a\t&ddd\n&amp;\fx;日本\t\t&", 4, 3, 2, 45, FILTER_HTML | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS), "--é&amp;a&ddd\n&amp;\n--x;日本----&"
  assert_eq tab(ff("\t;ab<\n&amp;ccx<b>dddéé<b>bb\ue000 \fx<x\t\n日本x<b>\v "), 2, 3, 1, 46, FILTER_HTML | STRIP_ESCAPE | DEBUG), "..|;ab<\n&amp;ccx<b>dddéé<b>bb \fx<x\t\n日本x<b>\v "
  assert_eq tab(ff("édddéb>. 日本\n&\nx\f<;\f&amp;\ue000\t\ue000\n .\t\t\ue000\t\ue000 .\t"), 6, 6, 1, 32, FILTER_HTML | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT), ff("édddéb>. 日本\n&\nx\f<;\n&amp;\ue000\t\ue000\n     .      \ue000\t\ue000 .")
  assert_eq tab(ff(";<b>é\n>\f &amp;<b>\t\téé\t\t&amp;é日本 \ue000&&"), 6, 0, 1, 42, FILTER_HTML | STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), ";<b>é\n>\n---\n &amp;<b>****|******|éé****|******|&amp;é日本 &&"
}

test "go vectors 38" {
  assert_eq tab(ff("é\ue000\t\ue000\t\t.<"), 5, 0, 1, 9, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | DEBUG), "é\t||.<"
  assert_eq tab(ff(">b\n&&amp;\n\ue000\t\ue000. 日本&&\t<b> <<b>\t&amp;&amp;\n\t\t"), 6, 2, 1, 46, FILTER_HTML | DISCARD_EMPTY_COLUMNS), ff(">b\n&&amp;\n\ue000\t\ue000. 日本&&\t<b> <<b>\t&amp;&amp;\n......")
  assert_eq tab(ff("b\t\t\t\ta<b\v日本<&x日本\t\f\n&amp; \t\ue000\t\ue000b &amp;\tab"), 1, 0, 2, 32, 0), ff("b        a<b  日本<&x日本  \n\n&amp;   \ue000\t\ue000b &amp;  ab")
  assert_eq tab("cc\tx\f\té", 8, 4, 0, 9, STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | DEBUG), "cc\t\t|x\n---\n\t\t|é"
  assert_eq tab(ff("\t\t\tx日本x\tb\ue000\vddd&amp;<<b>.\t\n<\ue000 \t\t<b>"), 9, 2, 2, 45, FILTER_HTML | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT), ff("\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t-----x日本x--b\ue000\vddd&amp;<<b>.\t\n<\ue000 ---------<b>")
  assert_eq tab(ff("\fé\n\t;\v \té<\ue000\n\v\t\t日本\t\ue000\t<b>\f;"), 2, 8, 2, 46, FILTER_HTML | STRIP_ESCAPE), ff("\né\n..;.. ..é<\ue000\n\v\t\t日本\t\ue000\t<b>\n;")
  assert_eq tab("", 4, 2, 2, 46, FILTER_HTML | ALIGN_RIGHT | TAB_INDENT), ""
  assert_eq tab(ff("\t\t&amp;<<\ue000<b>\n"), 1, 5, 0, 9, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | DEBUG), ff("\t|\t|&amp;<<\ue000<b>\n")
  assert_eq tab(ff("<>\t\t\t\na \ue000\t\ue000\t&amp;b<&\n"), 8, 1, 2, 45, FILTER_HTML | STRIP_ESCAPE | TAB_INDENT), "<>------------------------\na \t-----&amp;b<&\n"
  assert_eq tab("\vé", 1, 1, 2, 45, DEBUG), "--|é"
  assert_eq tab(ff("<b>.\ue000\t\ue000\t\tcc\v\ue000\t\ue000\t"), 8, 5, 0, 45, ALIGN_RIGHT), ff("---<b>.\ue000\t\ue000--------------cc\ue000\t\ue000")
  assert_eq tab("\t\t<\n\ncc<b>\t\n日本\t\t\n\véb\t\t&aa<b>. ", 9, 6, 1, 45, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT | DEBUG), "\t\t|\t\t|---------<\n\ncc<b>|\n-------日本|---------|\n\t\t|-------éb|---------|&aa<b>. "
  assert_eq tab(ff("a.<b>\n<&;\ue000\t\ue000\n\f;\tcc\tb\t"), 8, 3, 0, 32, ALIGN_RIGHT), ff("a.<b>\n<&;\ue000\t\ue000\n\n       ;      ccb")
  assert_eq tab("&a ", 5, 3, 2, 32, FILTER_HTML | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), "&a "
  assert_eq tab("\n日本é", 8, 2, 2, 42, STRIP_ESCAPE | DEBUG), "\n日本é"
  assert_eq tab(ff("\ue000\t\ue000\t\t \ue000\f\n"), 7, 5, 2, 45, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), ff("------\ue000\t\ue000|-------| \ue000\f\n")
  assert_eq tab(ff("\n&amp;\v\t;\ue000\t\ue000\n 日本&amp;\n.>\t\t\tb\t\t."), 5, 7, 2, 45, STRIP_ESCAPE | TAB_INDENT | DEBUG), "\n&amp;--|-----|;\t\n 日本&amp;\n.>---|-----|-----|b----|-----|."
  assert_eq tab("<>b.\ta\t\t\v&<b><\n\t<b>cc.ddd<\f>a\tx", 5, 2, 1, 46, FILTER_HTML | DISCARD_EMPTY_COLUMNS | TAB_INDENT), "<>b....a.........&<b><\n\t<b>cc.ddd<\f>a\tx"
  assert_eq tab(ff("\v\t\t\ue000\ue000;日本  .b\t日本\t\t\ue000<b\ta\t\t&amp;&amp;;<bb&ddd\t"), 3, 7, 2, 45, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), ff("|\t|\t|--\ue000\ue000;日本  .b|--日本|---|\ue000<b\ta\t\t&amp;&amp;;<bb&ddd\t")
  assert_eq tab(ff("\v\t\tddd日本a\t\t>\ue000&b\n\ue000\n日本. \nb\n&\t\t日本éddd\t;ddd&"), 7, 1, 3, 42, DEBUG), ff("*******|*******|*******|ddd日本a***|*******|>\ue000&b\n\ue000\n日本. \nb\n&******|*******|日本éddd***|;ddd&")
  assert_eq tab("\n<b>\t\té", 5, 6, 1, 45, FILTER_HTML | STRIP_ESCAPE | DEBUG), "\n<b>-----|-----|é"
  assert_eq tab(ff("\ue000\t\ue000x\t<.&><b>&&\ue000\ue000é>\fa\t"), 7, 1, 3, 46, STRIP_ESCAPE | DEBUG), "\tx.....|<.&><b>&&é>\n---\na"
  assert_eq tab(ff("\tx\ue000\t\ue000é\t\n;éxb\t\ue000\t\ue000cc\t\v\t\t\t"), 5, 2, 3, 45, FILTER_HTML | STRIP_ESCAPE | DEBUG), "-------|x\té---|\n;éxb---|\tcc---|-----|-----|-----|"
  assert_eq tab(ff("\ue000\ue000ccé<b>&amp;"), 5, 4, 3, 32, FILTER_HTML | DISCARD_EMPTY_COLUMNS | TAB_INDENT), ff("\ue000\ue000ccé<b>&amp;")
  assert_eq tab(ff("bé\t\t\v日本b\f\t\t \ue000\t\ue000\f  \v"), 2, 3, 1, 45, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT | DEBUG), "-bé|--|--|日本b\n---\n\t|\t| \t\n---\n  "
}

test "go vectors 39" {
  assert_eq tab(ff("\t&é<cc\ue000x;&x;\n<b>cc\ue000&\ue000"), 9, 6, 1, 46, ALIGN_RIGHT | TAB_INDENT | DEBUG), ff("\t\t|&é<cc\ue000x;&x;\n<b>cc\ue000&\ue000")
  assert_eq tab(ff("b\va;&\ue000b\va日本bddd日本\n.\t<b>é\n"), 4, 6, 2, 42, 0), ff("b***a;&\ue000b\va日本bddd日本\n.\t<b>é\n")
  assert_eq tab(ff("b\tcc<b>\néddd&amp;.\f;ba\n\t;&<b>b\ue000"), 3, 7, 1, 45, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS), ff("--bcc<b>\néddd&amp;.\n;ba\n---;&<b>b\ue000")
  assert_eq tab("&amp;éb\t;", 3, 5, 0, 9, DISCARD_EMPTY_COLUMNS | DEBUG), "&amp;éb\t|;"
  assert_eq tab(ff("\n\t&b\ue000&\n<&\v\né\n"), 8, 6, 3, 45, FILTER_HTML | DISCARD_EMPTY_COLUMNS | DEBUG), ff("\n--------|&b\ue000&\n<&\v\né\n")
  assert_eq tab(ff(".é>b&amp;\t\t&amp;\t日本\n\t\t\t;\ue000&\f.<;日本\v ddd"), 5, 7, 0, 46, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT), ".é>b&amp;.........&amp;日本\n\t\t\t;&\f.<;日本\v ddd"
  assert_eq tab(ff("\t\t<b><b>\v<\n\t\taé\vb日本\t\t>ba;\n;ax\ue000ddddddx&<\t"), 3, 4, 1, 45, FILTER_HTML | DISCARD_EMPTY_COLUMNS), ff("------<b><b><\n\t\taé\vb日本\t\t>ba;\n;ax\ue000ddddddx&<\t")
  assert_eq tab("&dddx;&\v\n.cc&amp; &<b> \t\t\f", 6, 2, 0, 32, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT), "&dddx;&\v\n.cc&amp; &<b> \t\t\f"
  assert_eq tab(ff(" <b\t>\v.\t&cc\t\t\tx\ue000\t\ue000\t>"), 6, 7, 1, 42, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT), ff("*** <b*****>*****.***&cc****************x\ue000\t\ue000>")
  assert_eq tab("b.<\v\n\f\n&\va\tddd\f日本&amp;ddd\n", 9, 4, 3, 32, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), "b.<      |\n\n---\n\n&        |a        |ddd\n---\n日本&amp;ddd\n"
  assert_eq tab(ff("\ue000\t\ue000b \t\ta>\t\v\vx<b>\v\ue000a日本<b>\f\f\v\v"), 7, 0, 3, 46, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT | DEBUG), "....\tb |.......|.....a>|.......|.......|......x<b>|a日本<b>\f\f\v\v"
  assert_eq tab(ff("éxx\t\tb\t\n\t\ue000\t\ue000ddd\nx"), 4, 7, 1, 9, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), ff("éxx\t|\t|b\t|\n\t|\ue000\t\ue000ddd\nx")
  assert_eq tab("\té\v&amp;xcc; a&amp;\t日本cc", 2, 5, 3, 46, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | DEBUG), "...|é...|&amp;xcc; a&amp;...|日本cc"
  assert_eq tab(ff("\n\f\ue000\t\ue000&amp;\tcca& x\t"), 6, 0, 1, 42, FILTER_HTML | STRIP_ESCAPE), "\n\n\t&amp;****cca& x\t"
  assert_eq tab(ff("\t<b>\ue000\v\ue000\n\ue000&amp;&>>&;x&amp;<b>ccdddddd\t"), 2, 0, 2, 42, STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT), "<b>\v\n&amp;&>>&;x&amp;<b>ccdddddd\t"
  assert_eq tab(ff("&amp;&amp;> cc\ue000\vbb\t\t\téa<<x\ue000\t\ue000\f\tbddd\ue000\t\ue000b\ue000\t\ue000;>."), 5, 8, 0, 32, FILTER_HTML | ALIGN_RIGHT | TAB_INDENT), ff("&amp;&amp;> cc\ue000\vbb\t\t\téa<<x\ue000\ue000\f\tbddd\ue000    \ue000b\ue000\ue000;>.")
  assert_eq tab("\nax\n\fcc>ab", 0, 3, 2, 32, FILTER_HTML | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), "\nax\n\n---\ncc>ab"
  assert_eq tab(ff("\t.cc\fx\v\ue000;<b>\n& ddd\f\ndddax<b>&amp;&amp;"), 9, 7, 0, 46, STRIP_ESCAPE | ALIGN_RIGHT), "..........cc\n........x;<b>\n& ddd\f\ndddax<b>&amp;&amp;"
  assert_eq tab(ff("\v\ue000\t\ue000\t\t;&amp;"), 5, 3, 2, 45, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS), ff("----\ue000\t\ue000-----;&amp;")
  assert_eq tab(ff(".\n\t\té日本éa\t.xcc\ue000\t\ue000< \t\t\ue000\fcc;\n"), 1, 7, 0, 32, FILTER_HTML | TAB_INDENT | DEBUG), ff(".\n\t|\t|é日本éa|.xcc\ue000\t\ue000< \t\t\ue000\fcc;\n")
  assert_eq tab(ff("\tb日本\n\t\t\f \v\néxx\t\ue000\t\ue000b;x<dddddd\t cc<\tx\t"), 5, 7, 3, 9, DEBUG), ff("\t|b日本\n\t|\t|\n---\n \t|\néxx\t|\ue000\t\ue000b;x<dddddd\t| cc<\t|x")
  assert_eq tab(ff(">\tb\t\fxb ;baa;\ue000x b\nx. \ue000\t\ue000\t\t&amp;\f.<b>cc"), 7, 0, 2, 9, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT), ">b\nxb ;baa;x b\nx. \t\t&amp;\f.<b>cc"
  assert_eq tab(ff("<\t\t\n\néa>\n>\f\f\t\v.b\ue000\ue000\t\ue000>\t<\ue000\t\ue000\n\t"), 9, 7, 3, 45, FILTER_HTML | DEBUG), ff("<\t\t\n\néa>\n>\n---\n\n---\n---------|---------|.b\ue000\ue000-------|\ue000>\t<\ue000------|\ue000\n\t")
  assert_eq tab(ff("xaddd日本\tddd\ue000\t\ue000ddd"), 3, 7, 0, 32, DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), ff("xaddd日本|ddd\ue000\t\ue000ddd")
  assert_eq tab(" <b>;>a;é", 0, 5, 2, 9, ALIGN_RIGHT | TAB_INDENT), " <b>;>a;é"
}
