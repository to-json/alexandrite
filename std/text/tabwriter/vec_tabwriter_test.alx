  assert_eq tab(ff("\t>x<b>\f>ccéaé\ue000\na\n.\ue000\t\ue000\n\t><b>\ue000>.\t\t>&amp; x"), 6, 5, 0, 45, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | TAB_INDENT), "\t\t>x<b>\n>ccéaé\na\n.\n\t><b>>.------>&amp; x"
  assert_eq tab(". .日本<b>\t<b>dddddd", 9, 0, 1, 46, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | TAB_INDENT), ". .日本<b>.<b>dddddd"
  assert_eq tab(ff("cc日本;\ue000\v\vb<<b>\t\tcc\t\f"), 7, 8, 3, 45, STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT), "cc日本;\v\vb<<b>\t\tcc\t\f"
