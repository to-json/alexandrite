  assert_eq tab(ff(" \ue000&amp;\n\vax\t<b><b>&amp;\ue000\t\ue000\ue000\t\ue000<\t.\t"), 3, 1, 0, 42, FILTER_HTML | STRIP_ESCAPE | TAB_INDENT | DEBUG), " &amp;\n\vax\t<b><b>&amp;|***|<\t.\t"
  assert_eq tab(ff("<a.&b\v&dddé\n\t\t\t\na\ue000\t\ue000<éb<ddd..\t>\t\t;"), 6, 1, 1, 46, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), "<a.&b.......|&dddé\n\t\t\t\t\t\t\t\t\t\t\t\t|\t\t\t\t\t\t|\t\t\t\t\t\t|\na\t<éb<ddd...|>.....|......|;"
  assert_eq tab("ddd\n\t\v \nccé", 5, 6, 0, 32, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | DEBUG), "ddd\n     |     | \nccé"
  assert_eq tab(".\n\v\t\t\t\t\té\v", 1, 7, 0, 46, 0), ".\n......é"
