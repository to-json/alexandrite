  assert_eq tab("\t<<;日本x<b>&>", 7, 2, 3, 9, FILTER_HTML | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), "\t\t\t\t|<<;日本x<b>&>"
  assert_eq tab("\f<b>日本cc<a  bé\fé&>", 7, 4, 3, 46, FILTER_HTML | DEBUG), "\n---\n<b>日本cc<a  bé\fé&>"
  assert_eq tab(ff("\ue000\t\ue000\na\t日本\f日本ccé &&amp;\t\n\t\t&\f>\nx\f. \n\t\t>< "), 6, 0, 1, 9, FILTER_HTML | STRIP_ESCAPE), "\t\na日本\n日本ccé &&amp;\n&\f>\nx\f. \n\t\t>< "
  assert_eq tab(ff("\n<b><b>\t\t\ue000ddd\t;\t&amp;>\f\t\t\v.bddd\t\v\f;cc\n\t"), 6, 1, 1, 46, DEBUG), ff("\n<b><b>.|......|\ue000ddd\t;\t&amp;>\f\t\t\v.bddd\t\v\f;cc\n\t")
  assert_eq tab(ff("&amp;<\t\t\ue000\v\ue000\t\ue000\n;&\ue000\t\ue000cc;\f\t\té&amp;b\f"), 8, 1, 3, 32, STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT), "   &amp;<               \v     \n;&cc;\f\t\té&amp;b\f"
