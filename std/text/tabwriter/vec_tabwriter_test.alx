  assert_eq tab(ff(">\ue000ddd\n日本< ;cc日本\n\ue000&xcc \t\tbé\ue000\t\ue000><b>\n\ncc<b>&amp;\t"), 4, 6, 2, 46, FILTER_HTML | DISCARD_EMPTY_COLUMNS), ff(">\ue000ddd\n日本< ;cc日本\n\ue000&xcc \t\tbé\ue000\t\ue000><b>\n\ncc<b>&amp;")
