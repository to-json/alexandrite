  assert_eq tab("<a<b><b>\f", 6, 6, 1, 46, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT), "<a<b><b>\n"
  assert_eq tab(" ", 9, 6, 1, 42, FILTER_HTML | DISCARD_EMPTY_COLUMNS), " "
  assert_eq tab(ff("ba&\ue000\t\ue000addd>éb\t\n.\n>&\n\t\t<b> \tcc\t\v\ue000\t\ue000>"), 3, 4, 1, 9, FILTER_HTML | STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS), ff("ba&\ue000\t\ue000addd>éb\t\n.\n>&\n\t\t<b> \tcc\t\v\ue000\t\ue000>")
  assert_eq tab(ff("b\ue000\t\ue000\v\ue000\t\ue000\nddda\vé"), 3, 8, 1, 32, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS), ff("   b\ue000\t\ue000\ue000\t\ue000\n dddaé")
