  assert_eq tab(ff("xx&amp;.\t\tb日本ddd\ue000\t\ue000;é><cc>é.ddd\v\f\t\t\n.\t\n"), 2, 1, 2, 46, DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), ff("xx&amp;...|..|b日本ddd\ue000\t\ue000;é><cc>é.ddd..|\n---\n\t\t\t|\t\t|\n...|\n")
