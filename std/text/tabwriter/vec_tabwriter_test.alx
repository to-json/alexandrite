  assert_eq tab("日本>", 6, 1, 0, 32, DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), "日本>"
  assert_eq tab(ff("\ue000b\n&\t\t\t\t\ue000\t\ue000ddd\ue000\t\ue000\f\ue000\ue000\t\ue000;\n\fcc<b>>\ue000é<b>\v\t\n\n&amp;\t"), 1, 7, 2, 42, DEBUG), ff("\ue000b\n&\t\t\t\t\ue000**|\ue000ddd\ue000**|\ue000\f\ue000\ue000\t\ue000;\n\n---\ncc<b>>\ue000é<b>\v\t\n\n&amp;\t")
  assert_eq tab("x\vx;日本ddd< b&amp;&b>.\n&amp;\f\vb\n\t", 9, 4, 2, 32, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), "        x|x;日本ddd< b&amp;&b>.\n&amp;\n---\n|b\n"
  assert_eq tab("<x\f", 3, 6, 3, 45, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | TAB_INDENT), "<x\n"
