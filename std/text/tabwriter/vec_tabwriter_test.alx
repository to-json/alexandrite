  assert_eq tab(ff("\f \ue000日本x\t\ta&\fddd ddd;x"), 5, 3, 2, 42, TAB_INDENT), ff("\n \ue000日本x\t\ta&\fddd ddd;x")
  assert_eq tab("\t&amp;é", 1, 6, 1, 42, FILTER_HTML | DISCARD_EMPTY_COLUMNS | DEBUG), "*|&amp;é"
