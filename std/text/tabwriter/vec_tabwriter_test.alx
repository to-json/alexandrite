  assert_eq tab(ff("\n<<b>\v\t>>\t\t\ue000a"), 3, 6, 2, 9, FILTER_HTML | STRIP_ESCAPE | TAB_INDENT | DEBUG), "\n<<b>\t|\t|>>\t|\t|a"
  assert_eq tab("><日本", 1, 6, 3, 46, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | DEBUG), "><日本"
  assert_eq tab(ff(" \ue000\t\ue000\f\n\nddd\ue000日本\t<b>;"), 4, 0, 0, 46, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT), " \t\n\n\nddd日本\t<b>;"
  assert_eq tab(ff("\v\t\n<\f\ue000cc"), 8, 1, 3, 46, DISCARD_EMPTY_COLUMNS | TAB_INDENT), ff("\t\t\t\t\t\t\t\t\n<\n\ue000cc")
  assert_eq tab(ff("\t\t\t>;x.&amp;é><b>x\t\ue000\t\ue000&\nb&&a\ue000\t\ue000&amp;\t.<\té\t<x"), 0, 8, 2, 9, ALIGN_RIGHT | TAB_INDENT | DEBUG), ff("\t\t|\t|\t|>;x.&amp;é><b>x\t\t|\ue000\t\ue000&\nb&&a\ue000\t\ue000&amp;\t|.<\t|é\t|<x")
