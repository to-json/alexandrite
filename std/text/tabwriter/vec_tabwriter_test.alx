  assert_eq tab(ff("\t\t\t\t\ue000 \t\t\v\t\tcc\v&amp;\t\n日本ddd\té\n<b>b"), 9, 0, 3, 42, FILTER_HTML | STRIP_ESCAPE), "************************************ \t\t\v\t\tcc\v&amp;\t\n日本ddd\té\n<b>b"
  assert_eq tab(ff("\ue000éb"), 8, 1, 0, 46, STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT), "éb"
