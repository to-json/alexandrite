  assert_eq tab(ff("b.\t\f\t\t\t\ue000\t\n\f\t\t\t<b>\v\t\v.;\ta<\n;\n"), 3, 6, 3, 42, FILTER_HTML | DEBUG), ff("b.***|\n---\n***|***|***|\ue000\t\n\f\t\t\t<b>\v\t\v.;\ta<\n;\n")
