  assert_eq tab(ff("\f\f>\ue000\t\ue000.& ;a;\v\ue000bb<b>\v"), 9, 0, 0, 9, FILTER_HTML | STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS), "\n\n>\t.& ;a;bb<b>\v"
