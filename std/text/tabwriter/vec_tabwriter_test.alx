  assert_eq tab(ff("\ue000\t\fb ddd\n ; ;\t\faé\t\v\tcc\t\ue000\t\ue000<b>éx\vé ;"), 6, 5, 2, 42, FILTER_HTML | TAB_INDENT | DEBUG), ff("\ue000\t\fb ddd\n ; ;\t\faé\t\v\tcc\t\ue000**|\ue000<b>éx\vé ;")
