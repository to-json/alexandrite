  assert_eq tab("cc.é\v aaccdddcc\né\txé<\n;\f\na b", 8, 2, 1, 32, ALIGN_RIGHT), "    cc.é aaccdddcc\n       éxé<\n;\n\na b"
  assert_eq tab(ff("日本;>;\f<ddd.b>\v<b>xéddda\ue000\ue000\t\ue000\t\f"), 2, 3, 3, 45, FILTER_HTML | STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | TAB_INDENT), "日本;>;\n<ddd.b><b>xéddda---\t\f"
