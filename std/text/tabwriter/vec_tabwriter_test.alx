  assert_eq tab("\t>ddd\f\n", 6, 7, 1, 45, ALIGN_RIGHT | DEBUG), "------|>ddd\n---\n\n"
  assert_eq tab(ff("\t\t<b>x\f\v \n\ue000\t\ue000\t\téx\v<b \t\tx\n<ddd"), 7, 4, 3, 9, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS), "\t\t\t\t<b>x\n\t\t \n\t\t\t\t\téx\t\t<b \t\tx\n<ddd"
  assert_eq tab(ff("é\ue000\f\t\t;&amp;;\t\v;\fé\t\t>é\t"), 1, 4, 3, 45, STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | DEBUG), "é\f\t\t;&amp;;\t\v;\fé\t\t>é\t"
