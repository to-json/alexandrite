  assert_eq tab(ff("\ue000\ue000\t\ue000.<b>\t> &amp;cc\t\t;ccx"), 3, 7, 3, 32, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), ff("   \ue000\ue000|\ue000.<b>\t> &amp;cc\t\t;ccx")
}

test "go vectors 6" {
