  assert_eq tab(ff("\t\t.\ue000\t\ue000\n\té\ue000\t\ue000ddd\ue000\ue000\t\ue000<bx\t\t\t\t"), 6, 8, 3, 32, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS), "              .\t\n      é\tddd   <bx\t\t\t\t"
