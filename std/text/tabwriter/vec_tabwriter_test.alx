  assert_eq tab(">\t\n \n日本&\n\t>&amp;日本&amp;日本>\t>.<b>\vb.<b>&&\t\t\n", 7, 7, 1, 46, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS), ">......\n \n日本&\n.......>&amp;日本&amp;日本>.>.<b>..b.<b>&&........\n"
