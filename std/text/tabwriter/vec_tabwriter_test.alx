  assert_eq tab(ff("&amp;&\ue000"), 9, 2, 2, 42, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), "&amp;&"
  assert_eq tab("aa&\t&\v", 7, 3, 3, 42, STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | DEBUG), "****aa&|&"
  assert_eq tab(ff("<\t\t&\t\f日本\t\v<b>>\v<.<b>\t&amp;\t\té日本\ue000\t\ue000"), 5, 7, 1, 32, FILTER_HTML | DISCARD_EMPTY_COLUMNS), ff("<\t\t&\t\f日本\t\v<b>>    <.<b>     &amp;         é日本\ue000\t\ue000")
  assert_eq tab(ff("<b>\ue000\t\ue000"), 8, 6, 3, 42, STRIP_ESCAPE), "<b>\t"
  assert_eq tab("\v&.>\t<b> 日本\n", 2, 8, 2, 46, STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT), "\t..&.><b> 日本\n"
  assert_eq tab(".\v\t日本\té\t<b> ", 7, 4, 1, 46, FILTER_HTML | TAB_INDENT), "..............日本.....é......<b> "
  assert_eq tab("<b>x>x<b>;>a\n a>>b\v<b<b>>é ", 0, 0, 2, 46, STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT), "<b>x>x<b>;>a\n.. a>>b<b<b>>é "
  assert_eq tab(ff("& \f日本x&amp;ddd;ddd<éx&amp;\n\f>&\v\ue000& \v"), 7, 4, 0, 45, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | DEBUG), ff("& \n---\n日本x&amp;ddd;ddd<éx&amp;\n\n---\n----->&|\ue000& \v")
  assert_eq tab(ff("b\tccx\f\ue000é&amp;&b<b>&&>&amp;> "), 6, 5, 1, 32, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT), "     bccx\né&amp;&b<b>&&>&amp;> "
  assert_eq tab(ff("\t\t\t.\ue000cc"), 8, 8, 2, 32, FILTER_HTML | STRIP_ESCAPE), "                        .cc"
  assert_eq tab(ff("\ue000\t\tddd\v\t\t\t日本\tddd<b>\n&\n&\n"), 3, 2, 3, 9, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), ff("\ue000\t\tddd\v\t\t\t日本\tddd<b>\n&\n&\n")
  assert_eq tab("日本>cc日本\v\t\n;", 8, 1, 0, 42, FILTER_HTML | DISCARD_EMPTY_COLUMNS | DEBUG), "日本>cc日本*|********|\n;"
  assert_eq tab(">a\nbxcc \vb日本\t", 6, 5, 2, 45, DISCARD_EMPTY_COLUMNS | TAB_INDENT), ">a\nbxcc --b日本"
