  assert_eq tab("<b>\téb", 5, 3, 3, 9, FILTER_HTML | TAB_INDENT | DEBUG), "<b>\t\t|éb"
  assert_eq tab("\vcc>\t\vé>\v&", 0, 4, 2, 32, FILTER_HTML | STRIP_ESCAPE | TAB_INDENT), "\tcc>    é>  &"
}

