test "go vectors 15" {
  assert_eq tab(ff("\ue000\t\ue000x\ue000\t\ue000\t; x\na<b>\t\tba\t;<b>ccaaa>\v\t &x.\t\t\n"), 9, 5, 2, 45, STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT | DEBUG), "------\tx\t|; x\n-----a<b>|---------|-------ba|--;<b>ccaaa>|---------|----- &x.|---------|\n"
  assert_eq tab(ff("\t&amp;\tbé\t\ue000\t\ue000>cc\t\ue000日本<\t&\ue000\t\ue000\t\t\f\tx\t\t\fxa<b>xx\t\t"), 5, 3, 2, 42, STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), "\t\t|**&amp;|***bé|**\t>cc|**日本<\t&|\t\t\f\tx\t\t\fxa<b>xx\t\t"
