  assert_eq tab(ff("x日本\t\ue000é\t&\t\t\fbddd\t\t\f日本\ue000\t\ue000 cc\n\f\t\t\ue000\t\ue000ddd.&\fb"), 6, 1, 2, 45, FILTER_HTML | ALIGN_RIGHT | TAB_INDENT | DEBUG), ff("---x日本|--\ue000é\t&\t\t\fbddd\t\t\f日本\ue000|--\ue000 cc\n\f\t\t\ue000|\ue000ddd.&\fb")
  assert_eq tab(ff("\ue000\t\ue000\nddd;日本\ue000\t\ue000\f>\f\taddda\ue000\t\ue000"), 2, 5, 0, 45, STRIP_ESCAPE | ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT), "\t\nddd;日本\t\n>\n\taddda\t"
  assert_eq tab(ff("<<&amp;\ue000\t\ue000é \t\t\vb>xé.a <b>\ue000\v &amp;>x\f\v\f&<b>\n;"), 9, 5, 2, 9, FILTER_HTML | STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), ff("<<&amp;\ue000\t\ue000é \t\t\vb>xé.a <b>\v &amp;>x\f\v\f&<b>\n;")
  assert_eq tab(ff("日本&amp;\tdddx.\ue000\ue000日本\vxx \t;\f\t"), 6, 5, 3, 45, ALIGN_RIGHT | DISCARD_EMPTY_COLUMNS | TAB_INDENT), ff("---日本&amp;---dddx.\ue000\ue000日本---xx ;\n")
