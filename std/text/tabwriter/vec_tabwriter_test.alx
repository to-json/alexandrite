  assert_eq tab(ff("ccé<cc\fddd<.>\ue000\ue000>\t\tx\t\ue000\t\ue000b\v\n\na\ue000&amp;&amp;<b>"), 0, 5, 0, 46, FILTER_HTML | STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT), "ccé<cc\fddd<.>>x\tb\n\na&amp;&amp;<b>"
