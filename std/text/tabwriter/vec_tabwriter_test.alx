  assert_eq tab("&\n\nx\fddda écc.\n\n<b>. ddd;\t\t\t\t\t<", 2, 8, 2, 42, ALIGN_RIGHT | TAB_INDENT | DEBUG), "&\n\nx\n---\nddda écc.\n\n**<b>. ddd;|**|**|**|**|<"
  assert_eq tab(ff("\ue000\t\ue000xcc><b>;ddd\f"), 5, 0, 0, 42, STRIP_ESCAPE | DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), "\txcc><b>;ddd\n---\n"
  assert_eq tab("\nab\n&amp; dddcc", 0, 6, 1, 45, STRIP_ESCAPE | ALIGN_RIGHT | TAB_INDENT | DEBUG), "\nab\n&amp; dddcc"
  assert_eq tab(ff("adddddd\f\ue000\t\ue000 aé\n\n;.\tddd\v\n&<b>"), 0, 8, 3, 9, 0), ff("adddddd\n\ue000\t\ue000 aé\n\n;.\tddd\t\n&<b>")
  assert_eq tab(ff(" bdddb\ue000\t\ue000\n\t\ta>\t\n<b\t\t\nb\t\v\n\v\f\v\ue000\t\ue000x\t<b>"), 3, 7, 3, 9, DISCARD_EMPTY_COLUMNS | TAB_INDENT | DEBUG), ff(" bdddb\ue000\t\ue000\n\t|\t|a>\t|\n<b\t|\t|\nb\t|\t|\n\t|\n---\n|\ue000\t\ue000x\t|<b>")
