import "text/template"

#[derive(Template)]
struct Item {
  name: Str
  price: Float
  tags: [Str]
}

#[derive(Template)]
#[template("main.Page")]
struct Page {
  #[template("Title")] title: Str
  items: [Item]
  counts: Map[Str, Int]
  owner: Str?
  n: U16

  pub def greet(who: Str, times: Int) -> Str { "hi #{who} x#{times} from #{title}" }

  pub def total -> Float {
    t = 0.0
    for i in items { t += i.price }
    t
  }

  pub def fails(b: Bool) -> ~Bool {
    fail Failure.Msg("my error") if b
    false
  }

  pub def to_s -> Str { "Page(#{title})" }
}

# A struct with nested derived types, a map, an optional, a sized int, and
# methods (one fallible, and to_s, which fmt prints).
test "derive struct" {
  p = Page.new(title: "T", items: [Item.new(name: "a", price: 1.5, tags: ["x", "y"]), Item.new(name: "b", price: 2.0)], counts: {"k" => 3}, n: 7)
  t = template.new("p").~parse("{{.Title}}|{{range .items}}{{.name}}:{{.price}}{{.tags}};{{end}}|{{.counts.k}}|{{.owner}}|{{.greet \"bob\" 2}}|{{.total}}|{{printf \"%T %v %d\" . . .n}}|{{.fails false}}")
  assert_eq t.~execute_str(p), "T|a:1.5[x y];b:2[];|3|<nil>|hi bob x2 from T|3.5|main.Page Page(T) 7|false"
  r = template.new("q").~parse("{{.fails true}}").execute_str(p)
  assert_eq r.err?.message || "", "template: q:1:2: executing \"q\" at <.fails>: error calling fails: my error"
}
