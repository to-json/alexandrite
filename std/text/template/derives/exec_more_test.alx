# Go's exec_test.go and multi_test.go tests that use tVal or derived types.

import "dyn"
import "bytes"
import "io/fs"
import "strings"
import "text/template"

# Check that an error from a method flows back to the top.
test "execute error" {
  tmpl = template.new("error").~parse("{{.MyError true}}")
  r = tmpl.execute_str(tval())
  assert r.err?, "expected error; got none"
  assert strings.contains(r.err?.message || "", "my error"), r.err?.message || ""
}

# golang.org/issue/14916: .String found on an indexed or ranged element.
test "addr of index" {
  texts = ["{{range .}}{{.String}}{{end}}", "{{with index . 0}}{{.String}}{{end}}"]
  for text in texts {
    tmpl = template.must(template.new("tmpl").parse(text))
    data = dyn.Value.list_of([V.new(j: 1).to_data], "[]template.V")
    # (V's String is to_s in alx: the method `.String` is its derived name
    # `to_s`, so the template asks for .to_s.)
    tmpl2 = template.must(template.new("tmpl").parse(strings.replace_all(text, ".String", ".to_s")))
    assert_eq tmpl2.~execute_str(data), "<1>"
    assert tmpl.execute_str(data).err?, "alx's method is to_s"
  }
}

test "function check during call" {
  cases = [
    ("call nothing", "{{call}}", tval(), "wrong number of args for call: want at least 1 got 0"),
    ("call non-function", "{{call .True}}", tval(), "error calling call: non-function .True of type bool"),
    ("call func with wrong argument", "{{call .BinaryFunc 1}}", tval(), "error calling call: wrong number of args for .BinaryFunc: got 1 want 2"),
    ("call variadic func with wrong argument", "{{call .VariadicFuncInt}}", tval(), "error calling call: wrong number of args for .VariadicFuncInt: got 0 want at least 1"),
    ("call too few return number func", "{{call .TooFewReturnCountFunc}}", tval(), "error calling call: function .TooFewReturnCountFunc has 0 return values; should be 1 or 2"),
    ("call too many return number func", "{{call .TooManyReturnCountFunc}}", tval(), "error calling call: function .TooManyReturnCountFunc has 3 return values; should be 1 or 2"),
    ("call invalid return type func", "{{call .InvalidReturnTypeFunc}}", tval(), "error calling call: invalid function signature for .InvalidReturnTypeFunc: second return value should be error; is bool"),
    ("call pipeline", "{{call (len \"test\")}}", dyn.Value.invalid, "error calling call: non-function len \"test\" of type int"),
  ]
  for c in cases {
    tmpl = template.new("t").~parse(c[1])
    r = tmpl.execute_str(c[2])
    assert r.err?, "#{c[0]}: expected error; got none"
    assert strings.contains(r.err?.message || "", c[3]), "#{c[0]}: got #{r.err?.message || ""}"
  }
  # Go's "func field call panics" (a panic is an error in alx).
  r = template.new("t").~parse("{{call .PanicFunc}}").execute_str(tval())
  assert strings.contains(r.err?.message || "", "template: t:1:2: executing \"t\" at <call .PanicFunc>: error calling call: test panic"), r.err?.message || ""
}

# TestParseFiles, TestParseGlob, TestParseFS: multiExecTests on templates
# read from files.
def run_multi(tmpl: template.Template) {
  cases = [
    ("empty", "", "", dyn.Value.invalid),
    ("text", "some text", "some text", dyn.Value.invalid),
    ("invoke x", "{{template \"x\" .SI}}", "TEXT", tval()),
    ("invoke x no args", "{{template \"x\"}}", "TEXT", tval()),
    ("invoke dot int", "{{template \"dot\" .I}}", "17", tval()),
    ("invoke dot []int", "{{template \"dot\" .SI}}", "[3 4 5]", tval()),
    ("invoke dotV", "{{template \"dotV\" .U}}", "v", tval()),
    ("invoke nested int", "{{template \"nested\" .I}}", "17", tval()),
    ("variable declared by template", "{{template \"nested\" $x:=.SI}},{{index $x 1}}", "[3 4 5],4", tval()),
    ("testFunc literal", "{{oneArg \"joe\"}}", "oneArg=joe", tval()),
    ("testFunc .", "{{oneArg .}}", "oneArg=joe", dyn.Value.str("joe")),
  ]
  for c in cases {
    run_exec(tmpl.new(c[0]), c[0], c[1], c[2], c[3], true)
  }
}

test "parse files" {
  assert template.parse_files(["DOES NOT EXIST"]).err?, "expected error for non-existent file; got none"
  tmpl = template.new("root").~parse_files(["../testdata/file1.tmpl", "../testdata/file2.tmpl"])
  run_multi(tmpl)
}

test "parse glob" {
  assert template.parse_glob("DOES NOT EXIST").err?, "expected error for non-existent file; got none"
  assert template.new("error").parse_glob("[x").err?, "expected error for bad pattern; got none"
  tmpl = template.new("root").~parse_glob("../testdata/file*.tmpl")
  run_multi(tmpl)
}

test "parse fs" {
  fsys = fs.dir_fs("../testdata")
  assert template.parse_fs(fsys, ["DOES NOT EXIST"]).err?, "expected error for non-existent file; got none"
  t1 = template.new("root").~parse_fs(fsys, ["file1.tmpl", "file2.tmpl"])
  run_multi(t1)
  t2 = template.new("root").~parse_fs(fsys, ["file*.tmpl"])
  run_multi(t2)
}

# Data through the derive: every field type, renames, skips, methods,
# FuncMaps from methods.
#[derive(Data)]
struct Sized {
  a: I8
  b: I16
  c: I32
  d: I64
  e: U8
  f: U16
  g: U32
  h: U64
  r: Rune
  y: Byte
  x: Float
  z: Complex
  ok: Bool
  #[data(skip)] hidden: Str
  arr: [Int; 3]
  opt: Int?
  none_: Str?
  err: Error
}

test "derive types" {
  s = Sized.new(a: -1, b: -2, c: -3, d: -4, e: 5, f: 6, g: 7, h: 8, r: 120, y: 9, x: 1.5, z: Complex.new(1.0, 2.0), ok: true, hidden: "h", arr: [1, 2, 3], opt: 4, err: Failure.Msg("bad"))
  t = template.new("t").~parse("{{range $i, $n := .}}{{if $i}},{{end}}{{end}}{{printf \"%T %T %T %T %T %T %T %T %T %T %T %T %T\" .a .b .c .d .e .f .g .h .r .y .x .z .ok}}|{{.}}|{{.arr}} {{printf \"%T\" .arr}}|{{.opt}} {{printf \"%T\" .opt}}|{{.none_}}|{{.err}}")
  r = t.execute_str(s)
  assert r.err?, "range over a struct is an error"
  t2 = template.new("t").~parse("{{printf \"%T %T %T %T %T %T %T %T %T %T %T %T %T\" .a .b .c .d .e .f .g .h .r .y .x .z .ok}}|{{.}}|{{.arr}} {{printf \"%T\" .arr}}|{{.opt}} {{printf \"%T\" .opt}}|{{.none_}}|{{.err}}")
  assert_eq t2.~execute_str(s), "int8 int16 int32 int64 uint8 uint16 uint32 uint64 int32 uint8 float64 complex128 bool|{-1 -2 -3 -4 5 6 7 8 120 9 1.5 (1+2i) true [1 2 3] 0xc000010000 <nil> bad}|[1 2 3] [3]int|4 *int|<nil>|bad"
  assert template.new("t").~parse("{{.hidden}}").execute_str(s).err?, "skipped field"
}

#[derive(Data)]
enum Shape {
  Dot
  Circle(r: Float)
  #[data("Box")] Rect(w: Int, h: Int)
}

test "derive enum" {
  shapes = [Shape.Dot, Shape.Circle(r: 1.5), Shape.Rect(w: 2, h: 3)]
  data = dyn.Value.list(shapes.map { it.to_data })
  t = template.new("t").~parse("{{range .}}[{{.}}]{{end}} {{(index . 1).r}} {{(index . 2).variant}} {{(index . 2).w}}")
  assert_eq t.~execute_str(data), "[Dot][{Circle 1.5}][{Box 2 3}] 1.5 Box 2"
}

# Functions from a derived type's methods (Go's FuncMap of typed funcs).
#[derive(Data)]
struct Helpers {
  prefix: Str

  pub def greet(name: Str) -> Str { "#{prefix}#{name}" }

  pub def add(a: Int, b: Int) -> Int { a + b }

  pub def sum(xs: [Int]) -> Int {
    t = 0
    for x in xs { t += x }
    t
  }

  pub def check(n: Int) -> ~Int {
    fail Failure.Msg("negative") if n < 0
    n
  }
}

test "derive funcs" {
  h = Helpers.new(prefix: "hi ")
  t = template.new("t").funcs(h.data_funcs).~parse("{{greet \"bob\"}} {{add 1 2}} {{add .A 3}} {{sum .L}} {{check 4}}")
  data = dyn.Value.map({"A" => dyn.Value.int(10), "L" => dyn.Value.list_of([dyn.Value.int(1), dyn.Value.int(2)], "[]int")})
  assert_eq t.~execute_str(data), "hi bob 3 13 3 4"
  # Arguments are checked against the method's Go signature.
  r = template.new("t").funcs(h.data_funcs).~parse("{{add 1 \"x\"}}").execute_str(data)
  assert_eq r.err?.message || "", "template: t:1:8: executing \"t\" at <\"x\">: expected integer; found \"x\""
  r2 = template.new("t").funcs(h.data_funcs).~parse("{{check -1}}").execute_str(data)
  assert_eq r2.err?.message || "", "template: t:1:2: executing \"t\" at <check -1>: error calling check: negative"
}

# A field holding a function, and a nested derived struct.
#[derive(Data)]
struct Outer {
  name: Str
  inner: Inner
  items: [Inner]
  lookup: Map[Int, Str]
  f: (Str, Int) -> Str
  g: (Int) -> ~Int
}

#[derive(Data)]
struct Inner {
  n: Int

  pub def double -> Int { n * 2 }
}

test "derive nested and funcs" {
  o = Outer.new(name: "o", inner: Inner.new(n: 2), items: [Inner.new(n: 3), Inner.new(n: 4)], lookup: {1 => "one", 2 => "two"}, f: ->(s: Str, k: Int) -> Str { s * k }, g: ->(k: Int) -> ~Int {
    fail Failure.Msg("odd") if k % 2 == 1
    k / 2
  })
  t = template.new("t").~parse("{{.inner.double}} {{range .items}}{{.double}},{{end}} {{index .lookup 2}} {{call .f \"ab\" 3}} {{call .g 4}} {{printf \"%T\" .f}}")
  assert_eq t.~execute_str(o), "4 6,8, two ababab 2 func(string, int) string"
  r = template.new("t").~parse("{{call .g 3}}").execute_str(o)
  assert_eq r.err?.message || "", "template: t:1:2: executing \"t\" at <call .g 3>: error calling call: odd"
}
