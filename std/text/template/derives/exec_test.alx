import "dyn"
import "text/template"

# Go's exec_test.go execTests table, translated by a generator (.scratch/gotmpl/gen_test.go).
# Data: tval() is Go's tVal; other data is built with Value's constructors.

test "exec 0" {
  check_exec("empty", "", "", dyn.Value.invalid, true)
  check_exec("text", "some text", "some text", dyn.Value.invalid, true)
  check_exec("nil action", "{{nil}}", "", dyn.Value.invalid, false)
  check_exec("ideal int", "{{typeOf 3}}", "int", dyn.Value.int(0), true)
  check_exec("ideal float", "{{typeOf 1.0}}", "float64", dyn.Value.int(0), true)
  check_exec("ideal exp float", "{{typeOf 1e1}}", "float64", dyn.Value.int(0), true)
  check_exec("ideal complex", "{{typeOf 1i}}", "complex128", dyn.Value.int(0), true)
  check_exec("ideal int", "{{typeOf 0x7fffffffffffffff}}", "int", dyn.Value.int(0), true)
  check_exec("ideal too big", "{{typeOf 0x8000000000000000}}", "", dyn.Value.int(0), false)
  check_exec("ideal nil without type", "{{nil}}", "", dyn.Value.int(0), false)
  check_exec(".X", "-{{.X}}-", "-x-", tval(), true)
  check_exec(".U.V", "-{{.U.V}}-", "-v-", tval(), true)
  check_exec(".unexported", "{{.unexported}}", "", tval(), false)
  check_exec("map .one", "{{.MSI.one}}", "1", tval(), true)
  check_exec("map .two", "{{.MSI.two}}", "2", tval(), true)
  check_exec("map .NO", "{{.MSI.NO}}", "<no value>", tval(), true)
  check_exec("map .one interface", "{{.MXI.one}}", "1", tval(), true)
  check_exec("map .WRONG args", "{{.MSI.one 1}}", "", tval(), false)
  check_exec("map .WRONG type", "{{.MII.one}}", "", tval(), false)
  check_exec("dot int", "<{{.}}>", "<13>", dyn.Value.int(13), true)
  check_exec("dot uint", "<{{.}}>", "<14>", dyn.Value.uint_of(14, "uint"), true)
  check_exec("dot float", "<{{.}}>", "<15.1>", dyn.Value.float(15.1), true)
  check_exec("dot bool", "<{{.}}>", "<true>", dyn.Value.bool(true), true)
  check_exec("dot complex", "<{{.}}>", "<(16.2-17i)>", dyn.Value.complex_of(Complex.new(16.2, -17.0), "complex128"), true)
  check_exec("dot string", "<{{.}}>", "<hello>", dyn.Value.str("hello"), true)
  check_exec("dot slice", "<{{.}}>", "<[-1 -2 -3]>", dyn.Value.list_of([dyn.Value.int(-1), dyn.Value.int(-2), dyn.Value.int(-3)], "[]int"), true)
  check_exec("dot map", "<{{.}}>", "<map[two:22]>", dyn.Value.map_of([dyn.Value.str("two")], [dyn.Value.int(22)], "map[string]int"), true)
  check_exec("dot struct", "<{{.}}>", "<{7 seven}>", dyn.Value.struct_of("struct { a int; b string }", ["a", "b"], [dyn.Value.int(7), dyn.Value.str("seven")]), true)
  check_exec("$ int", "{{$}}", "123", dyn.Value.int(123), true)
  check_exec("$.I", "{{$.I}}", "17", tval(), true)
  check_exec("$.U.V", "{{$.U.V}}", "v", tval(), true)
  check_exec("declare in action", "{{$x := $.U.V}}{{$x}}", "v", tval(), true)
  check_exec("simple assignment", "{{$x := 2}}{{$x = 3}}{{$x}}", "3", tval(), true)
  check_exec("nested assignment", "{{$x := 2}}{{if true}}{{$x = 3}}{{end}}{{$x}}", "3", tval(), true)
  check_exec("nested assignment changes the last declaration", "{{$x := 1}}{{if true}}{{$x := 2}}{{if true}}{{$x = 3}}{{end}}{{end}}{{$x}}", "1", tval(), true)
  check_exec("V{6666}.String()", "-{{.V0}}-", "-<6666>-", tval(), true)
  check_exec("&V{7777}.String()", "-{{.V1}}-", "-<7777>-", tval(), true)
  check_exec("W{888}.Error()", "-{{.W0}}-", "-[888]-", tval(), true)
  check_exec("&W{999}.Error()", "-{{.W1}}-", "-[999]-", tval(), true)
  check_exec("*int", "{{.PI}}", "23", tval(), true)
}

test "exec 1" {
  check_exec("*string", "{{.PS}}", "a string", tval(), true)
  check_exec("*[]int", "{{.PSI}}", "[21 22 23]", tval(), true)
  check_exec("*[]int[1]", "{{index .PSI 1}}", "22", tval(), true)
  check_exec("NIL", "{{.NIL}}", "<nil>", tval(), true)
  check_exec("empty nil", "{{.Empty0}}", "<no value>", tval(), true)
  check_exec("empty with int", "{{.Empty1}}", "3", tval(), true)
  check_exec("empty with string", "{{.Empty2}}", "empty2", tval(), true)
  check_exec("empty with slice", "{{.Empty3}}", "[7 8]", tval(), true)
  check_exec("empty with struct", "{{.Empty4}}", "{UinEmpty}", tval(), true)
  check_exec("empty with struct, field", "{{.Empty4.V}}", "UinEmpty", tval(), true)
  check_exec("field on interface", "{{.foo}}", "<no value>", dyn.Value.invalid, true)
  check_exec("field on parenthesized interface", "{{(.).foo}}", "<no value>", dyn.Value.invalid, true)
  check_exec("unparenthesized non-function", "{{1 2}}", "", dyn.Value.invalid, false)
  check_exec("parenthesized non-function", "{{(1) 2}}", "", dyn.Value.invalid, false)
  check_exec("parenthesized non-function with no args", "{{(1)}}", "1", dyn.Value.invalid, true)
  check_exec(".Method0", "-{{.Method0}}-", "-M0-", tval(), true)
  check_exec(".Method1(1234)", "-{{.Method1 1234}}-", "-1234-", tval(), true)
  check_exec(".Method1(.I)", "-{{.Method1 .I}}-", "-17-", tval(), true)
  check_exec(".Method2(3, .X)", "-{{.Method2 3 .X}}-", "-Method2: 3 x-", tval(), true)
  check_exec(".Method2(.U16, `str`)", "-{{.Method2 .U16 `str`}}-", "-Method2: 16 str-", tval(), true)
  check_exec(".Method2(.U16, $x)", "{{if $x := .X}}-{{.Method2 .U16 $x}}{{end}}-", "-Method2: 16 x-", tval(), true)
  check_exec(".Method3(nil constant)", "-{{.Method3 nil}}-", "-Method3: <nil>-", tval(), true)
  check_exec(".Method3(nil value)", "-{{.Method3 .MXI.unset}}-", "-Method3: <nil>-", tval(), true)
  check_exec("method on var", "{{if $x := .}}-{{$x.Method2 .U16 $x.X}}{{end}}-", "-Method2: 16 x-", tval(), true)
  check_exec("method on chained var", "{{range .MSIone}}{{if $.U.TrueFalse $.True}}{{$.U.TrueFalse $.True}}{{else}}WRONG{{end}}{{end}}", "true", tval(), true)
  check_exec("chained method", "{{range .MSIone}}{{if $.GetU.TrueFalse $.True}}{{$.U.TrueFalse $.True}}{{else}}WRONG{{end}}{{end}}", "true", tval(), true)
  check_exec("chained method on variable", "{{with $x := .}}{{with .SI}}{{$.GetU.TrueFalse $.True}}{{end}}{{end}}", "true", tval(), true)
  check_exec(".NilOKFunc not nil", "{{call .NilOKFunc .PI}}", "false", tval(), true)
  check_exec(".NilOKFunc nil", "{{call .NilOKFunc nil}}", "true", tval(), true)
  check_exec(".BinaryFunc", "{{call .BinaryFunc `1` `2`}}", "[1=2]", tval(), true)
  check_exec(".VariadicFunc0", "{{call .VariadicFunc}}", "<>", tval(), true)
  check_exec(".VariadicFunc2", "{{call .VariadicFunc `he` `llo`}}", "<he+llo>", tval(), true)
  check_exec(".VariadicFuncInt", "{{call .VariadicFuncInt 33 `he` `llo`}}", "33=<he+llo>", tval(), true)
  check_exec("if .BinaryFunc call", "{{ if .BinaryFunc}}{{call .BinaryFunc `1` `2`}}{{end}}", "[1=2]", tval(), true)
  check_exec("if not .BinaryFunc call", "{{ if not .BinaryFunc}}{{call .BinaryFunc `1` `2`}}{{else}}No{{end}}", "No", tval(), true)
  check_exec("Interface Call", "{{stringer .S}}", "foozle", stringer_map(), true)
  check_exec(".ErrFunc", "{{call .ErrFunc}}", "bla", tval(), true)
  check_exec("call nil", "{{call nil}}", "", tval(), false)
  check_exec("empty call", "{{call}}", "", tval(), false)
  check_exec("empty call after pipe valid", "{{.ErrFunc | call}}", "bla", tval(), true)
}

test "exec 2" {
  check_exec("empty call after pipe invalid", "{{1 | call}}", "", tval(), false)
  check_exec(".BinaryFuncTooFew", "{{call .BinaryFunc `1`}}", "", tval(), false)
  check_exec(".BinaryFuncTooMany", "{{call .BinaryFunc `1` `2` `3`}}", "", tval(), false)
  check_exec(".BinaryFuncBad0", "{{call .BinaryFunc 1 3}}", "", tval(), false)
  check_exec(".BinaryFuncBad1", "{{call .BinaryFunc `1` 3}}", "", tval(), false)
  check_exec(".VariadicFuncBad0", "{{call .VariadicFunc 3}}", "", tval(), false)
  check_exec(".VariadicFuncIntBad0", "{{call .VariadicFuncInt}}", "", tval(), false)
  check_exec(".VariadicFuncIntBad`", "{{call .VariadicFuncInt `x`}}", "", tval(), false)
  check_exec(".VariadicFuncNilBad", "{{call .VariadicFunc nil}}", "", tval(), false)
  check_exec("pipeline", "-{{.Method0 | .Method2 .U16}}-", "-Method2: 16 M0-", tval(), true)
  check_exec("pipeline func", "-{{call .VariadicFunc `llo` | call .VariadicFunc `he` }}-", "-<he+<llo>>-", tval(), true)
  check_exec("nil pipeline", "{{ .Empty0 | call .NilOKFunc }}", "true", tval(), true)
  check_exec("nil call arg", "{{ call .NilOKFunc .Empty0 }}", "true", tval(), true)
  check_exec("bad nil pipeline", "{{ .Empty0 | .VariadicFunc }}", "", tval(), false)
  check_exec("parens in pipeline", "{{printf `%d %d %d` (1) (2 | add 3) (add 4 (add 5 6))}}", "1 5 15", tval(), true)
  check_exec("parens: $ in paren", "{{($).X}}", "x", tval(), true)
  check_exec("parens: $.GetU in paren", "{{($.GetU).V}}", "v", tval(), true)
  check_exec("parens: $ in paren in pipe", "{{($ | echo).X}}", "x", tval(), true)
  check_exec("parens: spaces and args", "{{(makemap \"up\" \"down\" \"left\" \"right\").left}}", "right", tval(), true)
  check_exec("if true", "{{if true}}TRUE{{end}}", "TRUE", tval(), true)
  check_exec("if false", "{{if false}}TRUE{{else}}FALSE{{end}}", "FALSE", tval(), true)
  check_exec("if nil", "{{if nil}}TRUE{{end}}", "", tval(), false)
  check_exec("if on typed nil interface value", "{{if .NonEmptyInterfaceTypedNil}}TRUE{{ end }}", "", tval(), true)
  check_exec("if 1", "{{if 1}}NON-ZERO{{else}}ZERO{{end}}", "NON-ZERO", tval(), true)
  check_exec("if 0", "{{if 0}}NON-ZERO{{else}}ZERO{{end}}", "ZERO", tval(), true)
  check_exec("if 1.5", "{{if 1.5}}NON-ZERO{{else}}ZERO{{end}}", "NON-ZERO", tval(), true)
  check_exec("if 0.0", "{{if .FloatZero}}NON-ZERO{{else}}ZERO{{end}}", "ZERO", tval(), true)
  check_exec("if 1.5i", "{{if 1.5i}}NON-ZERO{{else}}ZERO{{end}}", "NON-ZERO", tval(), true)
  check_exec("if 0.0i", "{{if .ComplexZero}}NON-ZERO{{else}}ZERO{{end}}", "ZERO", tval(), true)
  check_exec("if nonNilPointer", "{{if .PI}}NON-ZERO{{else}}ZERO{{end}}", "NON-ZERO", tval(), true)
  check_exec("if nilPointer", "{{if .NIL}}NON-ZERO{{else}}ZERO{{end}}", "ZERO", tval(), true)
  check_exec("if emptystring", "{{if ``}}NON-EMPTY{{else}}EMPTY{{end}}", "EMPTY", tval(), true)
  check_exec("if string", "{{if `notempty`}}NON-EMPTY{{else}}EMPTY{{end}}", "NON-EMPTY", tval(), true)
  check_exec("if emptyslice", "{{if .SIEmpty}}NON-EMPTY{{else}}EMPTY{{end}}", "EMPTY", tval(), true)
  check_exec("if slice", "{{if .SI}}NON-EMPTY{{else}}EMPTY{{end}}", "NON-EMPTY", tval(), true)
  check_exec("if emptymap", "{{if .MSIEmpty}}NON-EMPTY{{else}}EMPTY{{end}}", "EMPTY", tval(), true)
  check_exec("if map", "{{if .MSI}}NON-EMPTY{{else}}EMPTY{{end}}", "NON-EMPTY", tval(), true)
  check_exec("if map unset", "{{if .MXI.none}}NON-ZERO{{else}}ZERO{{end}}", "ZERO", tval(), true)
  check_exec("if map not unset", "{{if not .MXI.none}}ZERO{{else}}NON-ZERO{{end}}", "ZERO", tval(), true)
  check_exec("if $x with $y int", "{{if $x := true}}{{with $y := .I}}{{$x}},{{$y}}{{end}}{{end}}", "true,17", tval(), true)
}

test "exec 3" {
  check_exec("if $x with $x int", "{{if $x := true}}{{with $x := .I}}{{$x}},{{end}}{{$x}}{{end}}", "17,true", tval(), true)
  check_exec("if else if", "{{if false}}FALSE{{else if true}}TRUE{{end}}", "TRUE", tval(), true)
  check_exec("if else chain", "{{if eq 1 3}}1{{else if eq 2 3}}2{{else if eq 3 3}}3{{end}}", "3", tval(), true)
  check_exec("print", "{{print \"hello, print\"}}", "hello, print", tval(), true)
  check_exec("print 123", "{{print 1 2 3}}", "1 2 3", tval(), true)
  check_exec("print nil", "{{print nil}}", "<nil>", tval(), true)
  check_exec("println", "{{println 1 2 3}}", "1 2 3\n", tval(), true)
  check_exec("printf int", "{{printf \"%04x\" 127}}", "007f", tval(), true)
  check_exec("printf float", "{{printf \"%g\" 3.5}}", "3.5", tval(), true)
  check_exec("printf complex", "{{printf \"%g\" 1+7i}}", "(1+7i)", tval(), true)
  check_exec("printf string", "{{printf \"%s\" \"hello\"}}", "hello", tval(), true)
  check_exec("printf function", "{{printf \"%\#q\" zeroArgs}}", "`zeroArgs`", tval(), true)
  check_exec("printf field", "{{printf \"%s\" .U.V}}", "v", tval(), true)
  check_exec("printf method", "{{printf \"%s\" .Method0}}", "M0", tval(), true)
  check_exec("printf dot", "{{with .I}}{{printf \"%d\" .}}{{end}}", "17", tval(), true)
  check_exec("printf var", "{{with $x := .I}}{{printf \"%d\" $x}}{{end}}", "17", tval(), true)
  check_exec("printf lots", "{{printf \"%d %s %g %s\" 127 \"hello\" 7-3i .Method0}}", "127 hello (7-3i) M0", tval(), true)
  check_exec("html", "{{html \"<script>alert(\\\"XSS\\\");</script>\"}}", "&lt;script&gt;alert(&\#34;XSS&\#34;);&lt;/script&gt;", dyn.Value.invalid, true)
  check_exec("html pipeline", "{{printf \"<script>alert(\\\"XSS\\\");</script>\" | html}}", "&lt;script&gt;alert(&\#34;XSS&\#34;);&lt;/script&gt;", dyn.Value.invalid, true)
  check_exec("html", "{{html .PS}}", "a string", tval(), true)
  check_exec("html typed nil", "{{html .NIL}}", "&lt;nil&gt;", tval(), true)
  check_exec("html untyped nil", "{{html .Empty0}}", "&lt;no value&gt;", tval(), true)
  check_exec("js", "{{js .}}", "It\\'d be nice.", dyn.Value.str("It'd be nice."), true)
  check_exec("urlquery", "{{\"http://www.example.org/\"|urlquery}}", "http%3A%2F%2Fwww.example.org%2F", dyn.Value.invalid, true)
  check_exec("not", "{{not true}} {{not false}}", "false true", dyn.Value.invalid, true)
  check_exec("and", "{{and false 0}} {{and 1 0}} {{and 0 true}} {{and 1 1}}", "false 0 0 1", dyn.Value.invalid, true)
  check_exec("or", "{{or 0 0}} {{or 1 0}} {{or 0 true}} {{or 1 1}}", "0 1 true 1", dyn.Value.invalid, true)
  check_exec("or short-circuit", "{{or 0 1 (die)}}", "1", dyn.Value.invalid, true)
  check_exec("and short-circuit", "{{and 1 0 (die)}}", "0", dyn.Value.invalid, true)
  check_exec("or short-circuit2", "{{or 0 0 (die)}}", "", dyn.Value.invalid, false)
  check_exec("and short-circuit2", "{{and 1 1 (die)}}", "", dyn.Value.invalid, false)
  check_exec("and pipe-true", "{{1 | and 1}}", "1", dyn.Value.invalid, true)
  check_exec("and pipe-false", "{{0 | and 1}}", "0", dyn.Value.invalid, true)
  check_exec("or pipe-true", "{{1 | or 0}}", "1", dyn.Value.invalid, true)
  check_exec("or pipe-false", "{{0 | or 0}}", "0", dyn.Value.invalid, true)
  check_exec("and undef", "{{and 1 .Unknown}}", "<no value>", dyn.Value.invalid, true)
  check_exec("or undef", "{{or 0 .Unknown}}", "<no value>", dyn.Value.invalid, true)
  check_exec("boolean if", "{{if and true 1 `hi`}}TRUE{{else}}FALSE{{end}}", "TRUE", tval(), true)
  check_exec("boolean if not", "{{if and true 1 `hi` | not}}TRUE{{else}}FALSE{{end}}", "FALSE", dyn.Value.invalid, true)
  check_exec("boolean if pipe", "{{if true | not | and 1}}TRUE{{else}}FALSE{{end}}", "FALSE", dyn.Value.invalid, true)
}

test "exec 4" {
  check_exec("slice[0]", "{{index .SI 0}}", "3", tval(), true)
  check_exec("slice[1]", "{{index .SI 1}}", "4", tval(), true)
  check_exec("slice[HUGE]", "{{index .SI 10}}", "", tval(), false)
  check_exec("slice[WRONG]", "{{index .SI `hello`}}", "", tval(), false)
  check_exec("slice[nil]", "{{index .SI nil}}", "", tval(), false)
  check_exec("map[one]", "{{index .MSI `one`}}", "1", tval(), true)
  check_exec("map[two]", "{{index .MSI `two`}}", "2", tval(), true)
  check_exec("map[NO]", "{{index .MSI `XXX`}}", "0", tval(), true)
  check_exec("map[nil]", "{{index .MSI nil}}", "", tval(), false)
  check_exec("map[``]", "{{index .MSI ``}}", "0", tval(), true)
  check_exec("map[WRONG]", "{{index .MSI 10}}", "", tval(), false)
  check_exec("double index", "{{index .SMSI 1 `eleven`}}", "11", tval(), true)
  check_exec("nil[1]", "{{index nil 1}}", "", tval(), false)
  check_exec("map MI64S", "{{index .MI64S 2}}", "i642", tval(), true)
  check_exec("map MI32S", "{{index .MI32S 2}}", "two", tval(), true)
  check_exec("map MUI64S", "{{index .MUI64S 3}}", "ui643", tval(), true)
  check_exec("map MI8S", "{{index .MI8S 3}}", "i83", tval(), true)
  check_exec("map MUI8S", "{{index .MUI8S 2}}", "u82", tval(), true)
  check_exec("index of an interface field", "{{index .Empty3 0}}", "7", tval(), true)
  check_exec("slice[:]", "{{slice .SI}}", "[3 4 5]", tval(), true)
  check_exec("slice[1:]", "{{slice .SI 1}}", "[4 5]", tval(), true)
  check_exec("slice[1:2]", "{{slice .SI 1 2}}", "[4]", tval(), true)
  check_exec("slice[-1:]", "{{slice .SI -1}}", "", tval(), false)
  check_exec("slice[1:-2]", "{{slice .SI 1 -2}}", "", tval(), false)
  check_exec("slice[1:2:-1]", "{{slice .SI 1 2 -1}}", "", tval(), false)
  check_exec("slice[2:1]", "{{slice .SI 2 1}}", "", tval(), false)
  check_exec("slice[2:2:1]", "{{slice .SI 2 2 1}}", "", tval(), false)
  check_exec("out of range", "{{slice .SI 4 5}}", "", tval(), false)
  check_exec("out of range", "{{slice .SI 2 2 5}}", "", tval(), false)
  check_exec("len(s) < indexes < cap(s)", "{{slice .SICap 6 10}}", "[0 0 0 0]", tval(), true)
  check_exec("len(s) < indexes < cap(s)", "{{slice .SICap 6 10 10}}", "[0 0 0 0]", tval(), true)
  check_exec("indexes > cap(s)", "{{slice .SICap 10 11}}", "", tval(), false)
  check_exec("indexes > cap(s)", "{{slice .SICap 6 10 11}}", "", tval(), false)
  check_exec("array[:]", "{{slice .AI}}", "[3 4 5]", tval(), true)
  check_exec("array[1:]", "{{slice .AI 1}}", "[4 5]", tval(), true)
  check_exec("array[1:2]", "{{slice .AI 1 2}}", "[4]", tval(), true)
  check_exec("pointer to array[:]", "{{slice .PAI}}", "[3 4 5]", tval(), true)
  check_exec("pointer to array[1:]", "{{slice .PAI 1}}", "[4 5]", tval(), true)
  check_exec("pointer to array[1:2]", "{{slice .PAI 1 2}}", "[4]", tval(), true)
  check_exec("string[:]", "{{slice .S}}", "xyz", tval(), true)
}

test "exec 5" {
  check_exec("string[0:1]", "{{slice .S 0 1}}", "x", tval(), true)
  check_exec("string[1:]", "{{slice .S 1}}", "yz", tval(), true)
  check_exec("string[1:2]", "{{slice .S 1 2}}", "y", tval(), true)
  check_exec("out of range", "{{slice .S 1 5}}", "", tval(), false)
  check_exec("3-index slice of string", "{{slice .S 1 2 2}}", "", tval(), false)
  check_exec("slice of an interface field", "{{slice .Empty3 0 1}}", "[7]", tval(), true)
  check_exec("slice", "{{len .SI}}", "3", tval(), true)
  check_exec("map", "{{len .MSI }}", "3", tval(), true)
  check_exec("len of int", "{{len 3}}", "", tval(), false)
  check_exec("len of nothing", "{{len .Empty0}}", "", tval(), false)
  check_exec("len of an interface field", "{{len .Empty3}}", "2", tval(), true)
  check_exec("with true", "{{with true}}{{.}}{{end}}", "true", tval(), true)
  check_exec("with false", "{{with false}}{{.}}{{else}}FALSE{{end}}", "FALSE", tval(), true)
  check_exec("with 1", "{{with 1}}{{.}}{{else}}ZERO{{end}}", "1", tval(), true)
  check_exec("with 0", "{{with 0}}{{.}}{{else}}ZERO{{end}}", "ZERO", tval(), true)
  check_exec("with 1.5", "{{with 1.5}}{{.}}{{else}}ZERO{{end}}", "1.5", tval(), true)
  check_exec("with 0.0", "{{with .FloatZero}}{{.}}{{else}}ZERO{{end}}", "ZERO", tval(), true)
  check_exec("with 1.5i", "{{with 1.5i}}{{.}}{{else}}ZERO{{end}}", "(0+1.5i)", tval(), true)
  check_exec("with 0.0i", "{{with .ComplexZero}}{{.}}{{else}}ZERO{{end}}", "ZERO", tval(), true)
  check_exec("with emptystring", "{{with ``}}{{.}}{{else}}EMPTY{{end}}", "EMPTY", tval(), true)
  check_exec("with string", "{{with `notempty`}}{{.}}{{else}}EMPTY{{end}}", "notempty", tval(), true)
  check_exec("with emptyslice", "{{with .SIEmpty}}{{.}}{{else}}EMPTY{{end}}", "EMPTY", tval(), true)
  check_exec("with slice", "{{with .SI}}{{.}}{{else}}EMPTY{{end}}", "[3 4 5]", tval(), true)
  check_exec("with emptymap", "{{with .MSIEmpty}}{{.}}{{else}}EMPTY{{end}}", "EMPTY", tval(), true)
  check_exec("with map", "{{with .MSIone}}{{.}}{{else}}EMPTY{{end}}", "map[one:1]", tval(), true)
  check_exec("with empty interface, struct field", "{{with .Empty4}}{{.V}}{{end}}", "UinEmpty", tval(), true)
  check_exec("with $x int", "{{with $x := .I}}{{$x}}{{end}}", "17", tval(), true)
  check_exec("with $x struct.U.V", "{{with $x := $}}{{$x.U.V}}{{end}}", "v", tval(), true)
  check_exec("with variable and action", "{{with $x := $}}{{$y := $.U.V}}{{$y}}{{end}}", "v", tval(), true)
  check_exec("with on typed nil interface value", "{{with .NonEmptyInterfaceTypedNil}}TRUE{{ end }}", "", tval(), true)
  check_exec("with else with", "{{with 0}}{{.}}{{else with true}}{{.}}{{end}}", "true", tval(), true)
  check_exec("with else with chain", "{{with 0}}{{.}}{{else with false}}{{.}}{{else with `notempty`}}{{.}}{{end}}", "notempty", tval(), true)
  check_exec("range []int", "{{range .SI}}-{{.}}-{{end}}", "-3--4--5-", tval(), true)
  check_exec("range empty no else", "{{range .SIEmpty}}-{{.}}-{{end}}", "", tval(), true)
  check_exec("range []int else", "{{range .SI}}-{{.}}-{{else}}EMPTY{{end}}", "-3--4--5-", tval(), true)
  check_exec("range empty else", "{{range .SIEmpty}}-{{.}}-{{else}}EMPTY{{end}}", "EMPTY", tval(), true)
  check_exec("range []int break else", "{{range .SI}}-{{.}}-{{break}}NOTREACHED{{else}}EMPTY{{end}}", "-3-", tval(), true)
  check_exec("range []int continue else", "{{range .SI}}-{{.}}-{{continue}}NOTREACHED{{else}}EMPTY{{end}}", "-3--4--5-", tval(), true)
  check_exec("range []bool", "{{range .SB}}-{{.}}-{{end}}", "-true--false-", tval(), true)
  check_exec("range []int method", "{{range .SI | .MAdd .I}}-{{.}}-{{end}}", "-20--21--22-", tval(), true)
}

test "exec 6" {
  check_exec("range map", "{{range .MSI}}-{{.}}-{{end}}", "-1--3--2-", tval(), true)
  check_exec("range empty map no else", "{{range .MSIEmpty}}-{{.}}-{{end}}", "", tval(), true)
  check_exec("range map else", "{{range .MSI}}-{{.}}-{{else}}EMPTY{{end}}", "-1--3--2-", tval(), true)
  check_exec("range empty map else", "{{range .MSIEmpty}}-{{.}}-{{else}}EMPTY{{end}}", "EMPTY", tval(), true)
  check_exec("range empty interface", "{{range .Empty3}}-{{.}}-{{else}}EMPTY{{end}}", "-7--8-", tval(), true)
  check_exec("range empty nil", "{{range .Empty0}}-{{.}}-{{end}}", "", tval(), true)
  check_exec("range $x SI", "{{range $x := .SI}}<{{$x}}>{{end}}", "<3><4><5>", tval(), true)
  check_exec("range $x $y SI", "{{range $x, $y := .SI}}<{{$x}}={{$y}}>{{end}}", "<0=3><1=4><2=5>", tval(), true)
  check_exec("range $x MSIone", "{{range $x := .MSIone}}<{{$x}}>{{end}}", "<1>", tval(), true)
  check_exec("range $x $y MSIone", "{{range $x, $y := .MSIone}}<{{$x}}={{$y}}>{{end}}", "<one=1>", tval(), true)
  check_exec("range $x PSI", "{{range $x := .PSI}}<{{$x}}>{{end}}", "<21><22><23>", tval(), true)
  check_exec("declare in range", "{{range $x := .PSI}}<{{$foo:=$x}}{{$x}}>{{end}}", "<21><22><23>", tval(), true)
  check_exec("range int8", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "int80int81int82int83int84", dyn.Value.int_of(5, "int8"), true)
  check_exec("range int16", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "int160int161int162int163int164", dyn.Value.int_of(5, "int16"), true)
  check_exec("range int32", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "int320int321int322int323int324", dyn.Value.int_of(5, "int32"), true)
  check_exec("range int64", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "int640int641int642int643int644", dyn.Value.int_of(5, "int64"), true)
  check_exec("range int", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "int0int1int2int3int4", dyn.Value.int(5), true)
  check_exec("range uint8", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "uint80uint81uint82uint83uint84", dyn.Value.uint_of(5, "uint8"), true)
  check_exec("range uint16", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "uint160uint161uint162uint163uint164", dyn.Value.uint_of(5, "uint16"), true)
  check_exec("range uint32", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "uint320uint321uint322uint323uint324", dyn.Value.uint_of(5, "uint32"), true)
  check_exec("range uint64", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "uint640uint641uint642uint643uint644", dyn.Value.uint_of(5, "uint64"), true)
  check_exec("range uint", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "uint0uint1uint2uint3uint4", dyn.Value.uint_of(5, "uint"), true)
  check_exec("range uintptr", "{{range $v := .}}{{printf \"%T%d\" $v $v}}{{end}}", "uintptr0uintptr1uintptr2uintptr3uintptr4", dyn.Value.uint_of(5, "uintptr"), true)
  check_exec("range uintptr(0)", "{{range $v := .}}{{print $v}}{{else}}empty{{end}}", "empty", dyn.Value.uint_of(0, "uintptr"), true)
  check_exec("range 5", "{{range $v := 5}}{{printf \"%T%d\" $v $v}}{{end}}", "int0int1int2int3int4", dyn.Value.invalid, true)
  check_exec("or as if true", "{{or .SI \"slice is empty\"}}", "[3 4 5]", tval(), true)
  check_exec("or as if false", "{{or .SIEmpty \"slice is empty\"}}", "slice is empty", tval(), true)
  check_exec("error method, error", "{{.MyError true}}", "", tval(), false)
  check_exec("error method, no error", "{{.MyError false}}", "false", tval(), true)
  check_exec("decimal", "{{print 1234}}", "1234", tval(), true)
  check_exec("decimal _", "{{print 12_34}}", "1234", tval(), true)
  check_exec("binary", "{{print 0b101}}", "5", tval(), true)
  check_exec("binary _", "{{print 0b_1_0_1}}", "5", tval(), true)
  check_exec("BINARY", "{{print 0B101}}", "5", tval(), true)
  check_exec("octal0", "{{print 0377}}", "255", tval(), true)
  check_exec("octal", "{{print 0o377}}", "255", tval(), true)
  check_exec("octal _", "{{print 0o_3_7_7}}", "255", tval(), true)
  check_exec("OCTAL", "{{print 0O377}}", "255", tval(), true)
  check_exec("hex", "{{print 0x123}}", "291", tval(), true)
  check_exec("hex _", "{{print 0x1_23}}", "291", tval(), true)
}

test "exec 7" {
  check_exec("HEX", "{{print 0X123ABC}}", "1194684", tval(), true)
  check_exec("float", "{{print 123.4}}", "123.4", tval(), true)
  check_exec("float _", "{{print 0_0_1_2_3.4}}", "123.4", tval(), true)
  check_exec("hex float", "{{print +0x1.ep+2}}", "7.5", tval(), true)
  check_exec("hex float _", "{{print +0x_1.e_0p+0_2}}", "7.5", tval(), true)
  check_exec("HEX float", "{{print +0X1.EP+2}}", "7.5", tval(), true)
  check_exec("print multi", "{{print 1_2_3_4 7.5_00_00_00}}", "1234 7.5", tval(), true)
  check_exec("print multi2", "{{print 1234 0x0_1.e_0p+02}}", "1234 7.5", tval(), true)
  check_exec("bug0", "{{range .MSIone}}{{if $.Method1 .}}X{{end}}{{end}}", "X", tval(), true)
  check_exec("bug1", "{{.Method0}}", "M0", tval(), true)
  check_exec("bug2", "{{$.NonEmptyInterface.Method0}}", "M0", tval(), true)
  check_exec("bug3", "{{with $}}{{.Method0}}{{end}}", "M0", tval(), true)
  check_exec("bug4", "{{if .Empty0}}non-nil{{else}}nil{{end}}", "nil", tval(), true)
  check_exec("bug5", "{{.Str}}", "foozle", tval(), true)
  check_exec("bug5a", "{{.Err}}", "erroozle", tval(), true)
  check_exec("bug6a", "{{vfunc .V0 .V1}}", "vfunc", tval(), true)
  check_exec("bug6b", "{{vfunc .V0 .V0}}", "vfunc", tval(), true)
  check_exec("bug6c", "{{vfunc .V1 .V0}}", "vfunc", tval(), true)
  check_exec("bug6d", "{{vfunc .V1 .V1}}", "vfunc", tval(), true)
  check_exec("bug7a", "{{3 2}}", "", tval(), false)
  check_exec("bug7b", "{{$x := 1}}{{$x 2}}", "", tval(), false)
  check_exec("bug7c", "{{$x := 1}}{{3 | $x}}", "", tval(), false)
  check_exec("bug8a", "{{3|oneArg}}", "", tval(), false)
  check_exec("bug8b", "{{4|dddArg 3}}", "", tval(), false)
  check_exec("bug9", "{{.cause}}", "neglect", dyn.Value.map_of([dyn.Value.str("cause")], [dyn.Value.str("neglect")], "map[string]string"), true)
  check_exec("bug10", "{{mapOfThree.three}}-{{(mapOfThree).three}}", "3-3", dyn.Value.int(0), true)
  check_exec("bug11", "{{valueString .PS}}", "", tzero(), false)
  check_exec("bug12xe", "{{printf `%T` 0xef}}", "int", tzero(), true)
  check_exec("bug12xE", "{{printf `%T` 0xEE}}", "int", tzero(), true)
  check_exec("bug12Xe", "{{printf `%T` 0Xef}}", "int", tzero(), true)
  check_exec("bug12XE", "{{printf `%T` 0XEE}}", "int", tzero(), true)
  check_exec("bug13", "{{print (.Copy).I}}", "17", tval(), true)
  check_exec("bug14a", "{{(nil).True}}", "", tval(), false)
  check_exec("bug14b", "{{$x := nil}}{{$x.anything}}", "", tval(), false)
  check_exec("bug14c", "{{$x := (1.0)}}{{$y := (\"hello\")}}{{$x.anything}}{{$y.true}}", "", tval(), false)
  check_exec("bug15", "{{valueString returnInt}}", "", tval(), false)
  check_exec("bug16a", "{{true|printf}}", "", tval(), false)
  check_exec("bug16b", "{{1|printf}}", "", tval(), false)
  check_exec("bug16c", "{{1.1|printf}}", "", tval(), false)
  check_exec("bug16d", "{{'x'|printf}}", "", tval(), false)
}

test "exec 8" {
  check_exec("bug16e", "{{0i|printf}}", "", tval(), false)
  check_exec("bug16f", "{{true|twoArgs \"xxx\"}}", "", tval(), false)
  check_exec("bug16g", "{{\"aaa\" |twoArgs \"bbb\"}}", "twoArgs=bbbaaa", tval(), true)
  check_exec("bug16h", "{{1|oneArg}}", "", tval(), false)
  check_exec("bug16i", "{{\"aaa\"|oneArg}}", "oneArg=aaa", tval(), true)
  check_exec("bug16j", "{{1+2i|printf \"%v\"}}", "(1+2i)", tval(), true)
  check_exec("bug16k", "{{\"aaa\"|printf }}", "aaa", tval(), true)
  check_exec("bug17a", "{{.NonEmptyInterface.X}}", "x", tval(), true)
  check_exec("bug17b", "-{{.NonEmptyInterface.Method1 1234}}-", "-1234-", tval(), true)
  check_exec("bug17c", "{{len .NonEmptyInterfacePtS}}", "2", tval(), true)
  check_exec("bug17d", "{{index .NonEmptyInterfacePtS 0}}", "a", tval(), true)
  check_exec("bug17e", "{{range .NonEmptyInterfacePtS}}-{{.}}-{{end}}", "-a--b-", tval(), true)
  check_exec("bug18a", "{{eq . '.'}}", "true", dyn.Value.int_of(46, "int32"), true)
  check_exec("bug18b", "{{eq . 'e'}}", "true", dyn.Value.int_of(101, "int32"), true)
  check_exec("bug18c", "{{eq . 'P'}}", "true", dyn.Value.int_of(80, "int32"), true)
  check_exec("issue56490", "{{$i := 0}}{{$x := 0}}{{range $i = .AI}}{{end}}{{$i}}", "5", tval(), true)
  check_exec("issue60801", "{{$k := 0}}{{$v := 0}}{{range $k, $v = .AI}}{{$k}}={{$v}} {{end}}", "0=3 1=4 2=5 ", tval(), true)
}

test "multi exec 0" {
  check_multi_exec("empty", "", "", dyn.Value.invalid, true)
  check_multi_exec("text", "some text", "some text", dyn.Value.invalid, true)
  check_multi_exec("invoke x", "{{template \"x\" .SI}}", "TEXT", tval(), true)
  check_multi_exec("invoke x no args", "{{template \"x\"}}", "TEXT", tval(), true)
  check_multi_exec("invoke dot int", "{{template \"dot\" .I}}", "17", tval(), true)
  check_multi_exec("invoke dot []int", "{{template \"dot\" .SI}}", "[3 4 5]", tval(), true)
  check_multi_exec("invoke dotV", "{{template \"dotV\" .U}}", "v", tval(), true)
  check_multi_exec("invoke nested int", "{{template \"nested\" .I}}", "17", tval(), true)
  check_multi_exec("variable declared by template", "{{template \"nested\" $x:=.SI}},{{index $x 1}}", "[3 4 5],4", tval(), true)
  check_multi_exec("testFunc literal", "{{oneArg \"joe\"}}", "oneArg=joe", tval(), true)
  check_multi_exec("testFunc .", "{{oneArg .}}", "oneArg=joe", dyn.Value.str("joe"), true)
}

test "comparison" {
  check_cmp("eq true true", "true", true)
  check_cmp("eq true false", "false", true)
  check_cmp("eq 1+2i 1+2i", "true", true)
  check_cmp("eq 1+2i 1+3i", "false", true)
  check_cmp("eq 1.5 1.5", "true", true)
  check_cmp("eq 1.5 2.5", "false", true)
  check_cmp("eq 1 1", "true", true)
  check_cmp("eq 1 2", "false", true)
  check_cmp("eq `xy` `xy`", "true", true)
  check_cmp("eq `xy` `xyz`", "false", true)
  check_cmp("eq .Uthree .Uthree", "true", true)
  check_cmp("eq .Uthree .Ufour", "false", true)
  check_cmp("eq 3 4 5 6 3", "true", true)
  check_cmp("eq 3 4 5 6 7", "false", true)
  check_cmp("ne true true", "false", true)
  check_cmp("ne true false", "true", true)
  check_cmp("ne 1+2i 1+2i", "false", true)
  check_cmp("ne 1+2i 1+3i", "true", true)
  check_cmp("ne 1.5 1.5", "false", true)
  check_cmp("ne 1.5 2.5", "true", true)
  check_cmp("ne 1 1", "false", true)
  check_cmp("ne 1 2", "true", true)
  check_cmp("ne `xy` `xy`", "false", true)
  check_cmp("ne `xy` `xyz`", "true", true)
  check_cmp("ne .Uthree .Uthree", "false", true)
  check_cmp("ne .Uthree .Ufour", "true", true)
  check_cmp("lt 1.5 1.5", "false", true)
  check_cmp("lt 1.5 2.5", "true", true)
  check_cmp("lt 1 1", "false", true)
  check_cmp("lt 1 2", "true", true)
  check_cmp("lt `xy` `xy`", "false", true)
  check_cmp("lt `xy` `xyz`", "true", true)
  check_cmp("lt .Uthree .Uthree", "false", true)
  check_cmp("lt .Uthree .Ufour", "true", true)
  check_cmp("le 1.5 1.5", "true", true)
  check_cmp("le 1.5 2.5", "true", true)
  check_cmp("le 2.5 1.5", "false", true)
  check_cmp("le 1 1", "true", true)
  check_cmp("le 1 2", "true", true)
  check_cmp("le 2 1", "false", true)
  check_cmp("le `xy` `xy`", "true", true)
  check_cmp("le `xy` `xyz`", "true", true)
  check_cmp("le `xyz` `xy`", "false", true)
  check_cmp("le .Uthree .Uthree", "true", true)
  check_cmp("le .Uthree .Ufour", "true", true)
  check_cmp("le .Ufour .Uthree", "false", true)
  check_cmp("gt 1.5 1.5", "false", true)
  check_cmp("gt 1.5 2.5", "false", true)
  check_cmp("gt 1 1", "false", true)
  check_cmp("gt 2 1", "true", true)
  check_cmp("gt 1 2", "false", true)
  check_cmp("gt `xy` `xy`", "false", true)
  check_cmp("gt `xy` `xyz`", "false", true)
  check_cmp("gt .Uthree .Uthree", "false", true)
  check_cmp("gt .Uthree .Ufour", "false", true)
  check_cmp("gt .Ufour .Uthree", "true", true)
  check_cmp("ge 1.5 1.5", "true", true)
  check_cmp("ge 1.5 2.5", "false", true)
  check_cmp("ge 2.5 1.5", "true", true)
  check_cmp("ge 1 1", "true", true)
  check_cmp("ge 1 2", "false", true)
  check_cmp("ge 2 1", "true", true)
  check_cmp("ge `xy` `xy`", "true", true)
  check_cmp("ge `xy` `xyz`", "false", true)
  check_cmp("ge `xyz` `xy`", "true", true)
  check_cmp("ge .Uthree .Uthree", "true", true)
  check_cmp("ge .Uthree .Ufour", "false", true)
  check_cmp("ge .Ufour .Uthree", "true", true)
  check_cmp("eq .Uthree .Three", "true", true)
  check_cmp("eq .Three .Uthree", "true", true)
  check_cmp("le .Uthree .Three", "true", true)
  check_cmp("le .Three .Uthree", "true", true)
  check_cmp("ge .Uthree .Three", "true", true)
  check_cmp("ge .Three .Uthree", "true", true)
  check_cmp("lt .Uthree .Three", "false", true)
  check_cmp("lt .Three .Uthree", "false", true)
  check_cmp("gt .Uthree .Three", "false", true)
  check_cmp("gt .Three .Uthree", "false", true)
  check_cmp("eq .Ufour .Three", "false", true)
  check_cmp("lt .Ufour .Three", "false", true)
  check_cmp("gt .Ufour .Three", "true", true)
  check_cmp("eq .NegOne .Uthree", "false", true)
  check_cmp("eq .Uthree .NegOne", "false", true)
  check_cmp("ne .NegOne .Uthree", "true", true)
  check_cmp("ne .Uthree .NegOne", "true", true)
  check_cmp("lt .NegOne .Uthree", "true", true)
  check_cmp("lt .Uthree .NegOne", "false", true)
  check_cmp("le .NegOne .Uthree", "true", true)
  check_cmp("le .Uthree .NegOne", "false", true)
  check_cmp("gt .NegOne .Uthree", "false", true)
  check_cmp("gt .Uthree .NegOne", "true", true)
  check_cmp("ge .NegOne .Uthree", "false", true)
  check_cmp("ge .Uthree .NegOne", "true", true)
  check_cmp("eq (index `x` 0) 'x'", "true", true)
  check_cmp("eq (index `x` 0) 'y'", "false", true)
  check_cmp("eq .V1 .V2", "true", true)
  check_cmp("eq .Ptr .Ptr", "true", true)
  check_cmp("eq .Ptr .NilPtr", "false", true)
  check_cmp("eq .NilPtr .NilPtr", "true", true)
  check_cmp("eq .Iface1 .Iface1", "true", true)
  check_cmp("eq .Iface1 .NilIface", "false", true)
  check_cmp("eq .NilIface .NilIface", "true", true)
  check_cmp("eq .NilIface .Iface1", "false", true)
  check_cmp("eq .NilIface 0", "false", true)
  check_cmp("eq 0 .NilIface", "false", true)
  check_cmp("eq .Map .Map", "true", true)
  check_cmp("eq .Map nil", "true", true)
  check_cmp("eq nil .Map", "true", true)
  check_cmp("eq .Map .NonNilMap", "false", true)
  check_cmp("eq `xy` 1", "", false)
  check_cmp("eq 2 2.0", "", false)
  check_cmp("lt true true", "", false)
  check_cmp("lt 1+0i 1+0i", "", false)
  check_cmp("eq .Ptr 1", "", false)
  check_cmp("eq .Ptr .NegOne", "", false)
  check_cmp("eq .Map .V1", "", false)
  check_cmp("eq .NonNilMap .NonNilMap", "", false)
}
