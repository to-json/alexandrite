# Go's lex_test.go. The tables (lexTests, lexDelimTests, lexPosTests) were
# translated by a generator: each case lexes its input and compares the
# (type, value) or (type, pos, value, line) items with Go's. The item type
# numbers are the ITEM_* constants (they are Go's itemType values).

# Gathers the emitted items into a list (Go's collect).
def collect(input: Str, left: Str, right: Str) -> [Item] {
  l = lex("test", input, left, right)
  l.emit_comment = true
  l.break_ok = true
  l.continue_ok = true
  items: [Item] = []
  loop {
    it = l.next_item!
    items << it
    break if it.typ == ITEM_EOF || it.typ == ITEM_ERROR
  }
  items
}

def lex_items(input: Str, left: Str, right: Str) -> [(Int, Str)] {
  collect(input, left, right).map { (it.typ, it.val) }
}

def lex_pos_items(input: Str) -> [(Int, Int, Str, Int)] {
  collect(input, "", "").map { (it.typ, it.pos, it.val, it.line) }
}

test "delims alphanumeric" {
  want = [(ITEM_LEFT_DELIM, "{{hub"), (ITEM_SPACE, " "), (ITEM_FIELD, ".host"), (ITEM_SPACE, " "), (ITEM_RIGHT_DELIM, "hub}}"), (ITEM_EOF, "")]
  assert_eq lex_items("{{hub .host hub}}", "{{hub", "hub}}"), want
}

test "delims and markers" {
  want = [(ITEM_LEFT_DELIM, "{{- "), (ITEM_FIELD, ".x"), (ITEM_RIGHT_DELIM, " -}}"), (ITEM_LEFT_DELIM, "{{- "), (ITEM_FIELD, ".x"), (ITEM_RIGHT_DELIM, " -}}"), (ITEM_EOF, "")]
  assert_eq lex_items("{{- .x -}} {{- - .x - -}}", "{{- ", " -}}"), want
}

test "item string" {
  assert_eq Item.new(typ: ITEM_EOF, val: "").to_s, "EOF"
  assert_eq Item.new(typ: ITEM_ERROR, val: "bad").to_s, "bad"
  assert_eq Item.new(typ: ITEM_RANGE, val: "range").to_s, "<range>"
  assert_eq Item.new(typ: ITEM_TEXT, val: "hello").to_s, "\"hello\""
  assert_eq Item.new(typ: ITEM_TEXT, val: "hello, world!").to_s, "\"hello, wor\"..."
}

test "lex" {
  assert_eq lex_items("", "", ""), [(8, "")]                                                                                                                                                                                                                                                                                                                                                                                                                                  # empty
  assert_eq lex_items(" \t\n", "", ""), [(20, " \t\n"), (8, "")]                                                                                                                                                                                                                                                                                                                                                                                                              # spaces
  assert_eq lex_items("now is the time", "", ""), [(20, "now is the time"), (8, "")]                                                                                                                                                                                                                                                                                                                                                                                          # text
  assert_eq lex_items("hello-{{/* this is a comment */}}-world", "", ""), [(20, "hello-"), (4, "/* this is a comment */"), (20, "-world"), (8, "")]                                                                                                                                                                                                                                                                                                                           # text with comment
  assert_eq lex_items("{{,@% }}", "", ""), [(11, "{{"), (2, ","), (2, "@"), (2, "%"), (18, " "), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                         # punctuation
  assert_eq lex_items("{{((3))}}", "", ""), [(11, "{{"), (12, "("), (12, "("), (13, "3"), (17, ")"), (17, ")"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                          # parens
  assert_eq lex_items("{{}}", "", ""), [(11, "{{"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                                                                      # empty action
  assert_eq lex_items("{{for}}", "", ""), [(11, "{{"), (10, "for"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                                                      # for
  assert_eq lex_items("{{block \"foo\" .}}", "", ""), [(11, "{{"), (23, "block"), (18, " "), (19, "\"foo\""), (18, " "), (26, "."), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                      # block
  assert_eq lex_items("{{\"abc \\n\\t\\\" \"}}", "", ""), [(11, "{{"), (19, "\"abc \\n\\t\\\" \""), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                      # quote
  assert_eq lex_items("{{`abc\\n\\t\\\" `}}", "", ""), [(11, "{{"), (15, "`abc\\n\\t\\\" `"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                            # raw quote
  assert_eq lex_items("{{`now is{{\n}}the time`}}", "", ""), [(11, "{{"), (15, "`now is{{\n}}the time`"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                # raw quote with newline
  assert_eq lex_items("{{1 02 0x14 0X14 -7.2i 1e3 1E3 +1.2e-4 4.2i 1+2i 1_2 0x1.e_fp4 0X1.E_FP4}}", "", ""), [(11, "{{"), (13, "1"), (18, " "), (13, "02"), (18, " "), (13, "0x14"), (18, " "), (13, "0X14"), (18, " "), (13, "-7.2i"), (18, " "), (13, "1e3"), (18, " "), (13, "1E3"), (18, " "), (13, "+1.2e-4"), (18, " "), (13, "4.2i"), (18, " "), (5, "1+2i"), (18, " "), (13, "1_2"), (18, " "), (13, "0x1.e_fp4"), (18, " "), (13, "0X1.E_FP4"), (16, "}}"), (8, "")] # numbers
  assert_eq lex_items("{{'a' '\\n' '\\'' '\\\\' '\\u00FF' '\\xFF' '本'}}", "", ""), [(11, "{{"), (3, "'a'"), (18, " "), (3, "'\\n'"), (18, " "), (3, "'\\''"), (18, " "), (3, "'\\\\'"), (18, " "), (3, "'\\u00FF'"), (18, " "), (3, "'\\xFF'"), (18, " "), (3, "'本'"), (16, "}}"), (8, "")]                                                                                                                                                                                   # characters
  assert_eq lex_items("{{true false}}", "", ""), [(11, "{{"), (1, "true"), (18, " "), (1, "false"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                      # bools
  assert_eq lex_items("{{.}}", "", ""), [(11, "{{"), (26, "."), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                                                          # dot
  assert_eq lex_items("{{nil}}", "", ""), [(11, "{{"), (31, "nil"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                                                      # nil
  assert_eq lex_items("{{.x . .2 .x.y.z}}", "", ""), [(11, "{{"), (9, ".x"), (18, " "), (26, "."), (18, " "), (13, ".2"), (18, " "), (9, ".x"), (9, ".y"), (9, ".z"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                    # dots
  assert_eq lex_items("{{range if else end with}}", "", ""), [(11, "{{"), (32, "range"), (18, " "), (30, "if"), (18, " "), (28, "else"), (18, " "), (29, "end"), (18, " "), (34, "with"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                # keywords
  assert_eq lex_items("{{$c := printf $ $hello $23 $ $var.Field .Method}}", "", ""), [(11, "{{"), (21, "$c"), (18, " "), (7, ":="), (18, " "), (10, "printf"), (18, " "), (21, "$"), (18, " "), (21, "$hello"), (18, " "), (21, "$23"), (18, " "), (21, "$"), (18, " "), (21, "$var"), (9, ".Field"), (18, " "), (9, ".Method"), (16, "}}"), (8, "")]                                                                                                                         # variables
  assert_eq lex_items("{{$x 23}}", "", ""), [(11, "{{"), (21, "$x"), (18, " "), (13, "23"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                              # variable invocation
  assert_eq lex_items("intro {{echo hi 1.2 |noargs|args 1 \"hi\"}} outro", "", ""), [(20, "intro "), (11, "{{"), (10, "echo"), (18, " "), (10, "hi"), (18, " "), (13, "1.2"), (18, " "), (14, "|"), (10, "noargs"), (14, "|"), (10, "args"), (18, " "), (13, "1"), (18, " "), (19, "\"hi\""), (16, "}}"), (20, " outro"), (8, "")]                                                                                                                                            # pipeline
  assert_eq lex_items("{{$v := 3}}", "", ""), [(11, "{{"), (21, "$v"), (18, " "), (7, ":="), (18, " "), (13, "3"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                       # declaration
  assert_eq lex_items("{{$v , $w := 3}}", "", ""), [(11, "{{"), (21, "$v"), (18, " "), (2, ","), (18, " "), (21, "$w"), (18, " "), (7, ":="), (18, " "), (13, "3"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                      # 2 declarations
  assert_eq lex_items("{{(.X).Y}}", "", ""), [(11, "{{"), (12, "("), (9, ".X"), (17, ")"), (9, ".Y"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                                    # field of parenthesized expression
  assert_eq lex_items("hello- {{- 3 -}} -world", "", ""), [(20, "hello-"), (11, "{{"), (13, "3"), (16, "}}"), (20, "-world"), (8, "")]                                                                                                                                                                                                                                                                                                                                        # trimming spaces before and after
  assert_eq lex_items("hello- {{- /* hello */ -}} -world", "", ""), [(20, "hello-"), (4, "/* hello */"), (20, "-world"), (8, "")]                                                                                                                                                                                                                                                                                                                                             # trimming spaces before and after comment
  assert_eq lex_items("\#{{\x01}}", "", ""), [(20, "\#"), (11, "{{"), (0, "unrecognized character in action: U+0001")]                                                                                                                                                                                                                                                                                                                                                        # badchar
  assert_eq lex_items("{{", "", ""), [(11, "{{"), (0, "unclosed action")]                                                                                                                                                                                                                                                                                                                                                                                                     # unclosed action
  assert_eq lex_items("{{range", "", ""), [(11, "{{"), (32, "range"), (0, "unclosed action")]                                                                                                                                                                                                                                                                                                                                                                                 # EOF in action
  assert_eq lex_items("{{\"\n\"}}", "", ""), [(11, "{{"), (0, "unterminated quoted string")]                                                                                                                                                                                                                                                                                                                                                                                  # unclosed quote
  assert_eq lex_items("{{`xx}}", "", ""), [(11, "{{"), (0, "unterminated raw quoted string")]                                                                                                                                                                                                                                                                                                                                                                                 # unclosed raw quote
  assert_eq lex_items("{{'\n}}", "", ""), [(11, "{{"), (0, "unterminated character constant")]                                                                                                                                                                                                                                                                                                                                                                                # unclosed char constant
  assert_eq lex_items("{{3k}}", "", ""), [(11, "{{"), (0, "bad number syntax: \"3k\"")]                                                                                                                                                                                                                                                                                                                                                                                       # bad number
  assert_eq lex_items("{{(3}}", "", ""), [(11, "{{"), (12, "("), (13, "3"), (0, "unclosed left paren")]                                                                                                                                                                                                                                                                                                                                                                       # unclosed paren
  assert_eq lex_items("{{3)}}", "", ""), [(11, "{{"), (13, "3"), (0, "unexpected right paren")]                                                                                                                                                                                                                                                                                                                                                                               # extra right paren
  assert_eq lex_items("{{|||||}}", "", ""), [(11, "{{"), (14, "|"), (14, "|"), (14, "|"), (14, "|"), (14, "|"), (16, "}}"), (8, "")]                                                                                                                                                                                                                                                                                                                                          # long pipeline deadlock
  assert_eq lex_items("hello-{{/*/}}-world", "", ""), [(20, "hello-"), (0, "unclosed comment")]                                                                                                                                                                                                                                                                                                                                                                               # text with bad comment
  assert_eq lex_items("hello-{{/* */ }}-world", "", ""), [(20, "hello-"), (0, "comment ends before closing delimiter")]                                                                                                                                                                                                                                                                                                                                                       # text with comment close separated from delim
  assert_eq lex_items("hello-{.}}-world", "", ""), [(20, "hello-{.}}-world"), (8, "")]                                                                                                                                                                                                                                                                                                                                                                                        # unmatched right delimiter
}

test "lex delims" {
  assert_eq lex_items("$$,@%{{}}@@", "$$", "@@"), [(11, "$$"), (2, ","), (2, "@"), (2, "%"), (2, "{"), (2, "{"), (2, "}"), (2, "}"), (16, "@@"), (8, "")] # punctuation
  assert_eq lex_items("$$@@", "$$", "@@"), [(11, "$$"), (16, "@@"), (8, "")]                                                                              # empty action
  assert_eq lex_items("$$for@@", "$$", "@@"), [(11, "$$"), (10, "for"), (16, "@@"), (8, "")]                                                              # for
  assert_eq lex_items("$$\"abc \\n\\t\\\" \"@@", "$$", "@@"), [(11, "$$"), (19, "\"abc \\n\\t\\\" \""), (16, "@@"), (8, "")]                              # quote
  assert_eq lex_items("$$`abc\\n\\t\\\" `@@", "$$", "@@"), [(11, "$$"), (15, "`abc\\n\\t\\\" `"), (16, "@@"), (8, "")]                                    # raw quote
}

test "lex pos" {
  assert_eq lex_pos_items(""), [(8, 0, "", 1)]                                                                                                                                                                                                      # empty
  assert_eq lex_pos_items("{{,@%\#}}"), [(11, 0, "{{", 1), (2, 2, ",", 1), (2, 3, "@", 1), (2, 4, "%", 1), (2, 5, "\#", 1), (16, 6, "}}", 1), (8, 8, "", 1)]                                                                                        # punctuation
  assert_eq lex_pos_items("0123{{hello}}xyz"), [(20, 0, "0123", 1), (11, 4, "{{", 1), (10, 6, "hello", 1), (16, 11, "}}", 1), (20, 13, "xyz", 1), (8, 16, "", 1)]                                                                                   # sample
  assert_eq lex_pos_items("{{x -}}\n{{y}}"), [(11, 0, "{{", 1), (10, 2, "x", 1), (16, 5, "}}", 1), (11, 8, "{{", 2), (10, 10, "y", 2), (16, 11, "}}", 2), (8, 13, "", 2)]                                                                           # trimafter
  assert_eq lex_pos_items("{{x}}\n{{- y}}"), [(11, 0, "{{", 1), (10, 2, "x", 1), (16, 3, "}}", 1), (11, 6, "{{", 2), (10, 10, "y", 2), (16, 11, "}}", 2), (8, 13, "", 2)]                                                                           # trimbefore
  assert_eq lex_pos_items("{{/*\n*/}}\n{{undefinedFunction \"test\"}}"), [(4, 2, "/*\n*/", 1), (20, 9, "\n", 2), (11, 10, "{{", 3), (10, 12, "undefinedFunction", 3), (18, 29, " ", 3), (19, 30, "\"test\"", 3), (16, 36, "}}", 3), (8, 38, "", 3)] # longcomment
}
