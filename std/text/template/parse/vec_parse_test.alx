  vec("{{- \nrange $i, $e := (($z := not index len) |print `a\nb`) |len printf}}{{  continue\n -}}{{\nend }}{{\ttemplate \"a\" .\n}}{{  nil }}{{\n$z := '\\x41' $ 1i|print|.Field1.Field2  }}", 0, "v={{range $i, $e := (($z := not index len) | print `a\nb`) | len printf}}{{continue}}{{end}}{{template \"a\" .}}{{nil}}{{$z := '\\x41' $ 1i | print | .Field1.Field2}}")
