  vec("{{$x := 1}}{{-   range $i, $e := 'ab' 1+2i| not false (\"ü\" .Field1.Field2 @)| $x eq\t}}{{  $i}}{{  end\n}}{{\ntrue \"str\"| len `a\nb` 1i| printf 1.5 (printf `%d` 1) }}{{- range $i, $e := \"a\\tb\" ('本' 'a' 017 |$x |$x 'a' `raw`) .X\n}}{{ $e\t -}}{{end }}", 0, "ERR:template: v:1: malformed character constant: 'ab'")
  vec("{{$x := 1}}{{  nil}}", 0, "v={{$x := 1}}{{nil}}")
