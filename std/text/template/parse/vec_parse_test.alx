  vec("{{$x := 1}}hello {{- /* cü */ -}}{ {{{define \"b\"\n}}{{\t0o17 \"q\\\"q\"| .X| len (len .).Z 1.5\t}}{{`raw`   -}}<b>{{\t1_000 \"q\\\"q\" $.A | eq \"q\\\"q\" (eq |true |not) | html (.X).Y -2\t}}{{\nend}}", 0, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{$x := 1}}{{- /* c  \n\t */}}{{ range html | .X undefinedFn | $x 2.5i 0b101\n}}{{- \t$z := -2.5e3| print (len .).Z| .X (.X) and}}{{  '\\x41'  }}{{ template \"b\" $  }}{{\nfalse\n}}{{\tend}}<b>", 1, "ERR:template: v:2: function \"undefinedFn\" not defined")
  vec("{{$x := 1}}{{  block \"a\" -2 ($x := not true (.X)| len -2.5e3) (.X).Y\t}}{{  template \"b\"\n}}{{end\n}}{{- /* c */}}", 2, "a={{template \"b\"}}\nv={{$x := 1}}{{template \"a\" -2 ($x := not true (.X) | len -2.5e3) (.X).Y}}")
  vec("{{- \tdefine \"c\"  }}{{\t+3 eq false |(-2 (index not |print or)| printf html ($z := \"a\\tb\"| not 017 len)) |printf  }}{{- \n'a' 1.5 '\\n'}}}{{\tblock \"blk\" $x.B.C not +3  }}}  \n\t{{-  end }}{{\tend\t}}{<b>", 0, "ERR:template: v:2: undefined variable \"$x\"")
  vec("{{- /* c{ */}}", 0, "v=")
