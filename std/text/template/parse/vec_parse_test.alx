  vec("{{$x := 1}}{{ (.X)|printf 1+2i\t}}{{. |html 0x1F (.Field1.Field2 |len ($z := 0x1p-2 | html +3 . | .X .X.Y) , |len .) |$ '\\u00e9' index\t}}", 0, "ERR:template: v:1: unexpected \",\" in operand")
  vec("{{$x := 1}}{{(.X).Y false|.X 2.5i +3  -}}{{- \n$x := (\"a\\tb\"| .X '\\u00e9') | printf := (((2))) | .X }}{{/* cline1\nline2 */}}", 0, "ERR:template: v:2: unexpected \":=\" in operand")
  vec("{{$x := 1}}{{\ndefine \"c\" }}{{ if (($x = `raw` |printf 1e9 |.X 2.5i) 2.5i ($x = 0x1F -1-2i|or) |len |html 1_000 index)| .X (not ((.X) -1-2i | print .X.Y $.A | printf index) 0b101 |print |html) 1e9 -}}{{\t-1-2i}}{{\n'ab'\n}}{{\t'本' (printf `%d` 1) | printf -2 | len '\\n' = }}{{\t((1))   -}}{{\nelse if (printf `%d` 1) ($x = (.X)) | not | len .Field1.Field2 .X.Y\t}}{{\t$z := '\\x41' 1 .Field1.Field2\n -}}{{- \tend\t}}line1\nline2a{{  end\n}}{{range $i, $e := $x := \"q\\\"q\" 1+2i or | $x not\n}}{{- \nbreak  }}{{- \tend\t}}", 1, "ERR:template: v:3: malformed character constant: 'ab'")
