  vec("{{  range nil $x.B.C | $x (len .).Z .Field1.Field2 | printf\t}}{{{- /* c<b> */}}{{\telse  }}{{- \ttemplate \"a\" $  }}{{\n(printf `%d` 1) }}{{  end }}{{\nwith \"q\\\"q\" \"str\" 1+2i  }}{{ '\\x41' }}{{-   with $x := 0x1F \"q\\\"q\" | len | not ((false nil not) 'a') (1+2i .X.Y)\n}}{{\n(.X).Y\n}}{{end\n -}}{{with (1.5 (len .).Z (((2))) | not (index|len $x|html))}}\naü{{ else   -}}{{-   $x = and not  }}\n{{-  eq |.X not (017 -2.5e3 | html 1e9 1_000 | len (\"str\" (.X).Y | html | print -1-2i)) }}{{- /* chello  */ -}}{{ end\t}}{{\n\"a\\tb\" }}{{- else with and |.X 1+2i |html\n}}{{ $.A\n -}}{{\trange $i, $e := $x.B.C (len .).Z 0o17| '\\u00e9' \"str\" }}{{ continue\t}}{{\tend\n}}{{-  end }}{{ $x := `raw` (((2))) 0o17 | $x | .X false (html .)}}", 0, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{$x := 1}}{{-1-2i  }}ahello {{\tblock \"a\" (((2)))  }}{{\n(.Field1.Field2 ((1)) 'a') 1+2i 1i|printf index|not \"ü\" 1+2i\t}}{{\n'\\u00e9'   -}}{{\nwith 'a' .X | print 0o17 1.5  -}}{{ `raw`}}{{  else   -}}{{- /* c{ */ -}}{{end }}{{\n017 index $x|and 0b101|print (nil 2.5i | html ($x := 1|-2.5e3|'本' '\\u00e9'))  }}{{end\n}}", 0, "ERR:template: v:5: undefined variable \"$x\"")
  vec("{{-   (len .).Z}}{{  block \"a\" (printf 1_000) 0x1p-2\n}}{{ or}}{{false }}{{  block \"a\" html 1+2i |print }}{{/* c  \n\t */ -}}{{\ttemplate \"x y\" .\t -}}{{ 'a' \"q\\\"q\" $x.B.C| not true (((2)))\n}}{{-  end }}{{-  end\n -}}{{- 1.5 }}line1\nline2", 0, "ERR:template: v:3: undefined variable \"$x\"")
