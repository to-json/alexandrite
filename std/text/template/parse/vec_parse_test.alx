test "parse vectors 1" {
  vec("{{$x := 1}}{{ 0x1p-2 (\"q\\\"q\"|not 'a'|$x 1.5 (.Field1.Field2 1.5| html| not ((1)))) '\\u00e9'| printf eq or| printf not }}{{\nrange $i, $e := -1-2i -2 ($x := len '\\x41' | len -1-2i | $x)|print|$.A or\t}}{{\ncontinue\n}}{{- \nend  }}", 0, "v={{$x := 1}}{{0x1p-2 (\"q\\\"q\" | not 'a' | $x 1.5 (.Field1.Field2 1.5 | html | not ((1)))) '\\u00e9' | printf eq or | printf not}}{{range $i, $e := -1-2i -2 ($x := len '\\x41' | len -1-2i | $x) | print | $.A or}}{{continue}}{{end}}")
