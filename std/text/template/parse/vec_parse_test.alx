  vec("{{$x := 1}}{{(.X)| 1+2i| printf \# \"str\"  }}{{-   define \"c\" }}{{\t$x\t}}{{- \tblock \"a\" (.X) (len .).Z}}{{- /* c  \n\t */}}{{\tnot (: (((2))) |len '\\n' $ |not) or |html `a\nb` |.X }}{{ (\"q\\\"q\" (len .).Z |1_000 - |$x) \"a\\tb\"|'a' $.A|eq (`a\nb` $.A) +3\t}}{{  end  -}}{{\nrange 1e9 1+2i index| html -2.5e3| .X '本'}}{{ `raw`  }}{{ else\t}}{{- \neq }}{{{end }}{{\tend   -}}{{-   .Field1.Field2 -}}", 1, "ERR:template: v:1: unexpected \"\#\" in operand")
  vec("{{$x := 1}}{{- /* c x  */}}{{\tlen or |len ($x := printf)}}", 0, "v={{$x := 1}}{{len or | len ($x := printf)}}")
