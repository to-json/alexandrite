  vec("{{$x := 1}}{{ $z := 1.5 $.A ((((2))) |html `raw` (((2))) |$x .) |len }}", 0, "v={{$x := 1}}{{$z := 1.5 $.A ((((2))) | html `raw` (((2))) | $x .) | len}}")
  vec("{{$x := 1}}{{2.5i   -}}{{  0b101}}{{- /* c{ */}} x ", 0, "v={{$x := 1}}{{2.5i}}{{0b101}} x ")
  vec("{{  range $i, $e := 1+2i $x.B.C and|$x or .X|len printf 0b101\n}}{{ $e\t}}{{ end  }}{{\nend\t}}{{\nrange $i, $e := $x = .Field1.Field2 eq 0b101}}{{-  $i}}{{end }}", 2, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{$x := 1}}a{{{  block \"blk\" $z := .Field1.Field2 | $x 0x1F | len}}{{\trange $i, $e := 0b101| . $x.B.C }}{{\n$i}}{{-  end }}{{-  template \"a\"\t -}}{{\trange $i, $e := 1e9 (+3 (.X).Y |printf eq)| 1 \"ü\" ((1))| .Field1.Field2 (($x := 1+2i 0x1F) .. '\\u00e9'|printf `raw`)  }}{{\t$e\n}}{{\tend\t}}{{\tlen | print .X -2.5e3\t}}{{end\n}}", 0, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{$x := 1}}{{  $x = 1e9 (.X) 0x1p-2\t}}", 0, "v={{$x := 1}}{{$x = 1e9 (.X) 0x1p-2}}")
  vec("{{$x := 1}}{{\t1 false|not '\\x41'  }}{{\"q\\\"q\"   -}}{{  $x = or 1i index| $x 0b101| print (((2))) ((1)) }}", 0, "v={{$x := 1}}{{1 false | not '\\x41'}}{{\"q\\\"q\"}}{{$x = or 1i index | $x 0b101 | print (((2))) ((1))}}")
  vec("{{$x := 1}}{{  continue  }}{{\nblock \"blk\" (.X) $.A 1i |len (len .).Z .Field1.Field2 |\"q\\\"q\" }}{{block \"blk\" true index (.Field1.Field2 1|len .X) | not | .X index !}}ü{{  $.A -}}-{{end   -}}{{\n$x = not \"str\" .X.Y |printf\t -}}{{  $.A -1-2i |$x}}{{  (.X)  -}}{{\tend }}", 1, "ERR:template: v:1: {{continue}} outside {{range}}")
  vec("{{$x := 1}}{{\ttemplate \"a\" .\t}}  \n\t{{ nil }}", 0, "v={{$x := 1}}{{template \"a\" .}}  \n\t{{nil}}")
  vec("{{-   if $x := 0o17 0o17| not (printf `%d` 1)  }}a{{- \tif true\t}}{{\n\"q\\\"q\"}}<b><b>}{{-  end}}{{- \nelse\t}}{{  (.X) +3  -}}{{end}}{{\nblock \"a\" 1.5 1+2i 2.5i|not}}{{len 1|.X|html (len .).Z\t -}}line1\nline2{{\tend\t}}{{\nblock \"a\" not| len (1 2.5i |printf 1 (((2)))) 0x1p-2\t -}}{{template \"x y\" $\t}}{{\ttemplate \"b\" $\t}}{{\tif 1i }}{{\"str\"}}{{- \n$x  }} x {{- end  }}{{- /* c\n */}}", 0, "ERR:template: v:7: undefined variable \"$x\"")
  vec("{{-   range $x = (((1)) -2.5e3) | html ($x = 1.5 eq|html (\"a\\tb\" true $ | len | print $.A) \"a\\tb\")\t}}line1\nline2}  \n\t}{{\telse  }}{{\n'}}  \n\tline1\nline2{{  template \"b\" .\t}}{{ (((1)) $.A and) eq | html (.X)  -}}{{\neq}}{{- define \"a\"\t}}{{+3 -}}{{\ttemplate \"b\"   -}}{{  '\\n' -}}{{  $x = -2.5e3 |len \"str\" printf\n}}{{ end}}", 0, "ERR:template: v:4: unterminated character constant in action started at v:3")
  vec("{{\n0b101\n}}{{ (((2))) -}}", 0, "v={{0b101}}{{(((2)))}}")
  vec("-{{  'a'  }}{{\n((.X)|not|printf .Field1.Field2 (printf `%d` 1))|-2.5e3|.X 1 true }}{{\n$x = 'a' '\\x41' .Field1.Field2 | html '\\x41' | print }}", 0, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{ if $x = 1+2i $y | not 2.5i | len .Field1.Field2 \"ü\"\n}}ü{{  end\n}}{{- \t$x = nil $.A printf| '\\u00e9' -1-2i| len `raw` ((1)) }}{{  `a\nb` 1e9 ((1))}}", 0, "ERR:template: v:1: undefined variable \"$y\"")
  vec("{{$x := 1}}{{  1i and|.X 0o17 \"str\"\n}}{{  (((1)) +3|$x 2.5i) ($z := 1| len) html | $x $.A 1 | printf}}", 3, "v={{$x := 1}}{{1i and | .X 0o17 \"str\"}}{{(((1)) +3 | $x 2.5i) ($z := 1 | len) html | $x $.A 1 | printf}}")
  vec("{{$x := 1}}{{$| (0x1p-2 |printf '\\x41' |printf -2.5e3 .X.Y)| len -2.5e3 -1-2i  }}{{\ttemplate \"a\" $\t -}}{{template \"a\"\t -}}{{ html .X.Y 0xz -}}", 0, "ERR:template: v:1: bad number syntax: \"0xz\"")
  vec("\n{{-  define \"c\"}}{{ template \"x y\" .X\t -}}{{\n1e9 }}{{- /* c<b> */ -}}{{\nend  }}{{/* cline1\nline2 */ -}}{{\t$x := '\\n' | 1_000 | .X 1_000\t}}", 0, "ERR:template: v:5: non executable command in pipeline stage 2")
  vec("{{$x := 1}}line1\nline2hello {{ true\n}}{{\n$x := '\\n' $ -}}", 0, "v={{$x := 1}}line1\nline2hello {{true}}{{$x := '\\n' $}}")
