test "parse vectors 14" {
  vec("{{$x := 1}}{{ 1  }}{{\nrange $i, $e := 2.5i |len\n}}{{ break\n}}{{ end\t}}{{-  '本' index \"str\"  }}{{ and -}}", 0, "v={{$x := 1}}{{1}}{{range $i, $e := 2.5i | len}}{{break}}{{end}}{{'本' index \"str\"}}{{and}}")
