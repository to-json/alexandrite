  vec("{{  $x := (\"ü\" 0x1p-2 .X.Y | not '\\n' | .X) 017| print 0x1F +3| print false ((1)) }}{{- \n'本' }}{{-   .Field1.Field2 }}", 0, "v={{$x := (\"ü\" 0x1p-2 .X.Y | not '\\n' | .X) 017 | print 0x1F +3 | print false ((1))}}{{'本'}}{{.Field1.Field2}}")
  vec("{{$x := 1}}{{\trange $i, $e := and 1\t -}}{{$i\n}}{{  end\t}}{{  template \"x y\" .   -}}", 0, "v={{$x := 1}}{{range $i, $e := and 1}}{{$i}}{{end}}{{template \"x y\" .}}")
  vec("{{$x := 1}} x { {{{\nblock \"blk\" +3 ((1))  -}}{{  false\t}}-a{{  end\t}}", 1, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{$x := 1}}{{ block \"a\" @ \"ü\" | $x  -}} x {{\tend  }}{{  (printf `%d` 1)\t -}}{{- (\"q\\\"q\" 'a')| printf ((1)) 0x1F| $x true\t}}{{\nrange $i, $e := 0b101 true 1e9 | $x (1e9 |len $.A \"str\") \"ü\" | not (printf .X 0x1F)\t}}{{  break }}{{-  end\n}}", 0, "ERR:template: v:1: unexpected \"@\" in block clause")
  vec("{{$x := 1}}{{\nnot -1-2i or| .X len \"q\\\"q\"| html\n}}", 0, "v={{$x := 1}}{{not -1-2i or | .X len \"q\\\"q\" | html}}")
  vec("{{$x := 1}}{{-  template \"b\" .\t}}{{0x1F }}{{\tblock \"blk\" -2.5e3| $x 0b101| $x not\n}}{{- \tblock \"blk\" $ ((1)) | not | len\n}}\nü{{ 1.5\n}}{{\nend  -}}{{- `raw` }}{{range -2|.X 0o17 printf|-2  }}{{\ttrue\t}}  \n\t{{\nend }}{{- \t$x := (.X).Y (.X.Y 1+2i) (2.5i 0x1p-2)| printf 0o17 nil| html false  }}{{\nend\n -}}}", 0, "ERR:template: v:6: non executable command in pipeline stage 3")
  vec("{{$x := 1}}{{\nblock \"a\" 017 eq and | true }}{{  0x1p-2 '\\n' | (((2))) | not '\\n'\n -}}{{- end }}{{-   template \"a\" .X  }}{{- /* cü */}}{{-   block \"a\" false eq 'a' | printf | html ()) .Field1.Field2 -}}hello {{-   range $i, $e := (+3 $x.B.C)}}{{  $e  }}{{\tend\t}}{{\tend\t}}", 2, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{\t$.A (1+2i 1e9 ((1))|$x.B.C -2 (.X)) (len .).Z|html !\t}}{ {ü{{range $i, $e := .X $x |print |.X $x `a\nb`  }}{{\n$i -}}{{end\t}}", 0, "ERR:template: v:1: unexpected \"!\" in operand")
  vec("{{$x := 1}}{{/* c  \n\t */}}", 0, "v={{$x := 1}}")
