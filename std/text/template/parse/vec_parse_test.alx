  vec("{{$x := 1}}{{  if (\"ü\" \"q\\\"q\"| len| | (len .).Z (\"ü\" | \"ü\" '\\u00e9'))|false not|printf `a\nb` +3  }}{{-   range $i, $e := \"ü\" '\\u00e9' '\\x41'| not 1.5| .X +3  }}{{\tbreak\t}}{{\nend }}{{- '本'}}{{\nelse if $x .Field1.Field2 0x1p-2|not -2 (printf `%d` 1)|printf .X  }}{{  range -2| $x (1_000 not '\\n' |len 1_000 |eq 1+2i (- 1 (((2)))|print $x|html html))\t}}{{\nnot\n}}{{ template \"b\" . }}{{\t($x = and \"a\\tb\") ((((2))) and | len \"q\\\"q\") 0o17 |2.5i\n}}{{\nelse  }}{{(((2)))}}{{0x1p-2 }}{{ .Field1.Field2\t}}{{\nend\n -}}{{range $i, $e := $x = index false 1+2i| .X -2.5e3 $x.B.C| (.X.Y |$)\n}}{{\n$e\t -}}{{ end\t}}{{\n'\\x41' | ((1)) 'a' -1-2i  }}{{with (3k (.X)) not|($x = .X) 0o17 +3|print or}}{{ nil\t}}{{ template \"b\" }}}{{-   end\n}}{{\tend }}{{1_000 }}{{\t$z := $.A .X |html (printf `%d` 1) .X}}", 0, "ERR:template: v:1: unexpected \"|\" in parenthesized pipeline")
  vec("{{$x := 1}}line1\nline2{{\tblock \"blk\" $x = 1.5 |print ($z := $| . len 0x1p-2| .X) -1-2i\t}}-{{- $z := \"str\"|html 1e9|printf eq\n}}{{\nend }}", 0, "ERR:template: v:2: non executable command in pipeline stage 2")
