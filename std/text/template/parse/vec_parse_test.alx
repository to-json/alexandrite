  vec("{{$x := 1}}{{- /* c  \n\t */ -}}{{- \ndefine \"c\"\t}}{{\n$z := $ (len .).Z -}}{{\tend\t}}{{ range $i, $e := `a\nb` index|printf\n}}{{$i }}{{\nend\t}}{{-   template \"x y\"}}", 0, "c={{$z := $ (len .).Z}}\nv={{$x := 1}}{{range $i, $e := `a\nb` index | printf}}{{$i}}{{end}}{{template \"x y\"}}")
