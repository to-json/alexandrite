  vec("{{$x := 1}}{{\nrange $i, $e := (((2))) (or |0o17 (((2))) ($ | (printf `%d` 1) | 1+2i) |printf (or 1|print 1.5))}}{{\tcontinue -}}{{ end}}{{\trange $i, $e := $z := 1+2i $ |.X (0b101 $ (printf `%d` 1)|len|$x 0o17) 'a' |.X printf index\t}}{{- break}}{{\nend\t -}}", 0, "ERR:template: v:2: non executable command in pipeline stage 3")
  vec("{{$x := 1}}{{\t$x = .Field1.Field2 (.X).Y}}{{\ndefine \"b\"\n}}{{  0o17 }}{{\tend   -}}", 0, "b={{0o17}}\nv={{$x := 1}}{{$x = .Field1.Field2 (.X).Y}}")
  vec("{{$x := 1}}{{\nor $x.B.C |not $ |nil \"a\\tb\" }}", 1, "ERR:template: v:2: non executable command in pipeline stage 3")
