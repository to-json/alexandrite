test "parse vectors 21" {
  vec("{{$x := 1}}{{  range $i, $e := index \"q\\\"q\" .X.Y\n}}{{\t$e -}}{{-  end\t}}", 0, "v={{$x := 1}}{{range $i, $e := index \"q\\\"q\" .X.Y}}{{$e}}{{end}}")
