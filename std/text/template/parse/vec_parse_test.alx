  vec("{{$x := 1}}{{  '\\u00e9'\n -}}", 0, "v={{$x := 1}}{{'\\u00e9'}}")
  vec("{{$x := 1}}{{- \n(((2))) -2.5e3 1  -}}-{{  `raw`\n -}}{{- /* c{ { */}}", 0, "v={{$x := 1}}{{(((2))) -2.5e3 1}}-{{`raw`}}")
