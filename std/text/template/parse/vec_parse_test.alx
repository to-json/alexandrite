  vec("{{$x := 1}}{{ 2.5i ($x := true and)|printf +3|'\\u00e9' ('\\n' index ($x = nil| print html \"a\\tb\"| print (.X) 017) | $x (1+2i) | len $x.B.C)\n}}{{\tblock \"a\" $z := ((1))| len len| html ($x 0x1F true| print nil| $x (((2)))) $  }}{{false  }}{{ 'a'| html| html\t}}{{\nend\n}}", 0, "ERR:template: v:2: non executable command in pipeline stage 3")
