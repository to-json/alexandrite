  vec("{{$x := 1}}{{nil}}{{/* c} */ -}}{-", 0, "v={{$x := 1}}{{nil}}{-")
  vec("{{$x := 1}}{{ define \"c\"\n}}{{  range $i, $e := len |eq |printf and\t}}{{\nbreak}}{{  end\n}}{{- /* cline1\nline2 */}}{{\tend}}{{\tdefine \"c\"\n}}{{-  html |1e9 |print '本' 1.5\n}}{{- end  -}}{{\n`raw` | html $y false | printf printf\n}}{{ ,\t}}", 0, "ERR:template: v:7: non executable command in pipeline stage 2")
