  vec("{{$x := 1}}{{\nhtml\t}}{{.Field1.Field2 }}ü{{  range $i, $e := 3k 'a' -1-2i |nil $x |($x = $x 017| .X| 1 $x.B.C) 0x1F 1  }}{{\n$e}}{{\tend -}}", 2, "ERR:template: v:2: bad number syntax: \"3k\"")
  vec("{{$x := 1}}{{  block \"a\" -2.5e3 index| html '\\n'| html   -}}{{- \nrange $i, $e := $z := (printf 1_000 $.A | html len) $.A | len (($x = 0x1F \"q\\\"q\" \"str\") len \"a\\tb\" |.X len |$x 0x1F -1-2i) }}{{continue }}{{\nend }}line1\nline2ü{{\tend  }}", 1, "ERR:template: v:2: undefined variable \"$z\"")
  vec("{{\n(len .).Z   -}}{{  block \"a\" \"ü\" index |.}}{{\ttemplate \"a\" .\n}}{{ with 1.5 .X.Y ' }}{{\n\"a\\tb\" 1e9 (((1)) printf '\\n'| len| .X) | 1_000 printf\n}}{{/* c\n */ -}}<b>{{\nelse with $x := 1i 1i and\t}}  \n\t{{end\n}}-{{range $i, $e := '\\x41' .X .Field1.Field2}}{{- \t$i }}{{  end\n}}{{\nend }}{{ range $i, $e := '\\n' or (len .).Z\n -}}{{\t$i\t}}{{-   end }}", 0, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{ continue\n}}{{\nrange $i, $e := (0x1p-2 1+2i) (len .).Z| $x| $x index\t -}}{{-  $e }}{{end  }}line1\nline2{{- \n$x = true nil}}", 0, "ERR:template: v:2: {{continue}} outside {{range}}")
  vec("{{ range $i, $e := . 1+2i $x.B.C |$.A  }}{{$i}}{{ end}}", 0, "ERR:template: v:1: undefined variable \"$x\"")
