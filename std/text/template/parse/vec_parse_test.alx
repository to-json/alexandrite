  vec("{{$x := 1}}{{- /* ca */}}{{\ttemplate \"x y\" .X}} x ", 1, "v={{$x := 1}}{{/* ca */}}{{template \"x y\" .X}} x ")
  vec("{{$x := 1}}a", 0, "v={{$x := 1}}a")
  vec("{{$x := 1}}{{ range $i, $e := and 1+2i| printf}}{{\ncontinue  }}{{  end }}{{\t(.X).Y }}{{eq or printf\t}}", 2, "v={{$x := 1}}{{range $i, $e := and 1+2i | printf}}{{continue}}{{end}}{{(.X).Y}}{{eq or printf}}")
  vec("{ {{{\trange $i, $e := $z := (.X).Y -2.5e3 .X.Y |.X or (.X) |.X `raw`  }}{{-  break\n -}}{{\tend  }}", 0, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{ \"q\\\"q\"  }}{{- /* c- */}}{{- range $i, $e := printf|$x }}{{\n$e\n}}{{  end -}}{{\nrange $i, $e := 1+2i}}{{\n$e }}{{end  }}", 0, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{$x := 1}}{{  $.A  }}{{- /* c} */ -}}{{  range $i, $e := 0b101|html undefinedFn}}{{ $e\t}}{{- \tend  }}a", 0, "ERR:template: v:1: function \"undefinedFn\" not defined")
  vec("{{- /* c{ { */}}{{ $z := (printf `%d` 1) .| html| .X (.X)\t}}{{\trange $i, $e := $x eq| len : $x.B.C| printf\n}}{{  break\t -}}{{\tend\t}}{{  else -}}", 0, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{$x := 1}}{{\tblock \"a\" false|html (.X)\n}}{{- \t`raw` \"a\\tb\"|not len|html\t}}{{\t(printf `%d` 1)\n}}{{-  end   -}}{{- \t(((2))) true  }}", 1, "a={{`raw` \"a\\tb\" | not len | html}}{{(printf `%d` 1)}}\nv={{$x := 1}}{{template \"a\" false | html (.X)}}{{(((2))) true}}")
  vec("{{$x := 1}}  \n\t{{define \"c\"\n}}{{$x := .X.Y ((1)) |printf false  }}{{- \tend}}<b>", 0, "c={{$x := .X.Y ((1)) | printf false}}\nv={{$x := 1}}  \n\t<b>")
