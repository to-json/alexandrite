  vec("{{$x := 1}}{{ $z := '本'| printf| printf  }}a{{ (printf `%d` 1)}}{{$x := ($x := true|html ($x = (.X) or .Field1.Field2) (printf `%d` 1))| not| not\n -}}", 1, "v={{$x := 1}}{{$z := '本' | printf | printf}}a{{(printf `%d` 1)}}{{$x := ($x := true | html ($x = (.X) or .Field1.Field2) (printf `%d` 1)) | not | not}}")
