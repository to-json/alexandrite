  vec("<b>", 0, "v=<b>")
  vec("{{$x := 1}} x {{-  nil 1i 'a' |print |len\t}}{{- $.A| ($z := \"ü\" (len .).Z (len .).Z|not) ($x := (1e9 $x) ($z := -1-2i | html not | print) false|printf .X.Y|len ($.A not | printf) '\\x41')| html (.X) 0x1p-2  }}{{template \"b\" $}}", 1, "v={{$x := 1}} x{{nil 1i 'a' | print | len}}{{$.A | ($z := \"ü\" (len .).Z (len .).Z | not) ($x := (1e9 $x) ($z := -1-2i | html not | print) false | printf .X.Y | len ($.A not | printf) '\\x41') | html (.X) 0x1p-2}}{{template \"b\" $}}")
  vec("{{$x := 1}}-{{\tdefine \"c\" }}{{- template \"x y\" $\n}}{{  end }}", 0, "c={{template \"x y\" $}}\nv={{$x := 1}}-")
  vec("{{$x := 1}}{{((len .).Z printf) $.A\t -}}{{\ntemplate \"a\" .}}{{\nblock \"a\" (printf `%d` 1) or len  }}{{template \"x y\" $}}-{{\trange $i, $e := $x \"ü\"|not index}}{{\n$e }}{{-  end }}{{-  false| printf| not 2.5i '\\u00e9'\t}}{{\nend  }}", 0, "ERR:template: v:3: undefined variable \"$x\"")
  vec("{{$x := 1}}}{{  or}}{{-  and}}", 0, "v={{$x := 1}}}{{or}}{{and}}")
  vec("{{$x := 1}}{{- if ($z := 0o17 (len .).Z) index 1.5\t}}{{/* c- */ -}}{{else  }} x {{\t-2 }}{{-  template \"b\" .X}}{{- \tend }}{{  $.A `a\nb` len  }}", 2, "v={{$x := 1}}{{if ($z := 0o17 (len .).Z) index 1.5}}{{else}} x {{-2}}{{template \"b\" .X}}{{end}}{{$.A `a\nb` len}}")
  vec("{{$x := 1}}{{  (len .).Z |.X (.X) 1.5\n -}}{{\tend\t}}{{template \"a\" .X  -}}{{\n$.A .X (.X) |not and |not ($x = \"q\\\"q\" (eq) (eq (len .).Z))\n -}}", 0, "ERR:template: v:2: unexpected {{end}}")
  vec("{{$x := 1}}{{\tif $ (. .X |len 0x1F |print (.Field1.Field2) .)}}{{-  -1-2i}}{{\t0b101}}{{\nelse if .X 1e9 or|printf 1i|len .Field1.Field2}}{{  '本' .Field1.Field2 0x1p-2 | len | print ((.X 0b101) ($x = ! and|.X index) (-2 (.X).Y |not 017 'a' |not `a\nb`)| print 1e9 (.X).Y) +3\n}}\n{{$x = html index 2.5i| len ($z := (-1-2i .X not) \"str\") 1+2i| not printf (and false) }}{{range $i, $e := 1e9|.X\t}}{{ $i  }}{{ end }}{{end\t}}", 0, "ERR:template: v:2: unexpected \"!\" in parenthesized pipeline")
  vec("{{$x := 1}}{{\tdefine \"b\" }}{{ true\n -}}}{{- .Field1.Field2 1+2i| len 0x1p-2 (len .).Z| (false) 2.5i}}  \n\t{{ end  }} x {{\nrange \"a\\tb\" '\\n'  }}{{range 1e9 0x1F :=}}{{  2.5i\n}}{{\n.X  }}{{index\n}}{{\t1e9\t}}{{\telse\n}}{{\nend\n -}}{{- $  }}}-{{  else   -}}{{- /* c{ { */ -}}{{ $x = $.A 1_000 (.Field1.Field2 $x.B.C nil |.X 0b101 |print)|html|$x\t -}}{{$ \"q\\\"q\" |html 3k len}}{{range $i, $e := $z := '\\u00e9' $.A }}{{  continue  }}{{\tend }}{{- end\t}}", 1, "ERR:template: v:4: unexpected \":=\" in operand")
  vec("{{$x := 1}}{{ -1-2i}}", 0, "v={{$x := 1}}{{-1-2i}}")
  vec("{{  define \"c\"}}  \n\t{{template \"x y\" $\t}}{{\nend  }}{{  \t}}{{- \nif +3 1e9 +3 }}{{\nwith 1e9 true \"q\\\"q\" | $x  }}{{ 0b101  }}line1\nline2{{ else with 1.5 and \"q\\\"q\" }}{{\n$x.B.C | len (len .).Z | len (printf `%d` 1) \"a\\tb\"  }} x {{  1.5 ((1)) and |not '\\n' |$x\n}}{{  '\\n'  }}{{\nend  }}{{  017\t -}}{{len|print '\\x41'  }}{{  $x.B.C\t}}{{  else\t}}{{-  eq (or or $x.B.C | len true nil | html $x.B.C) false\t}}{{- \twith .X 1+2i '\\x41'|printf|printf true (-2 '\\n')\n -}}{{\n0o17| not\n}}{{\nelse with ($x := \"str\" ((1)))\t}}{{-   -2\t}}{{-  `raw` -}}{{  end\n -}}{{-  end }}{{\nrange $i, $e := .X | or }}{{\n$e   -}}{{- \tend -}}", 0, "ERR:template: v:3: missing value for command")
  vec("{{$x := 1}}{{\nrange $x = false $x |print\t}}{{- /* chello  */ -}}{{- /* c x  */ -}}{{-  block \"a\" '\\x41' false| print (.X.Y -1-2i (printf `%d` 1)| true (eq | print -2.5e3 | len '\\n' $)| html '\\x41')| html 1+2i\t -}}{{\t0x1F '本'| print .\t}}{{- else\t}}{{- \tend\t}}{{\nend}}", 0, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{\n\"str\"\n}}", 0, "v={{\"str\"}}")
