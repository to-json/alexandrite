  vec("{{$x := 1}}}{{- \ntemplate \"a\" . }}{{/* ca */ -}}{{ 017|print html\n}}", 1, "v={{$x := 1}}}{{template \"a\" .}}{{/* ca */}}{{017 | print html}}")
  vec("{{- end\n}}{{/* c */}}{{  range $i, $e := (.X)|(len .).Z|print\t}}{{\n$i }}{{\nend\n}}{{\n((1)) len 0x1F  }}", 0, "ERR:template: v:2: unexpected {{end}}")
  vec("{{$x := 1}}ü{{ $x = 1_000}}{{\n'本'| print (.X.Y (and | .X 1_000 | html true '本') html)\n}}", 0, "v={{$x := 1}}ü{{$x = 1_000}}{{'本' | print (.X.Y (and | .X 1_000 | html true '本') html)}}")
  vec("{{$x := 1}}{{- \ttemplate \"x y\" .X\t -}}", 0, "v={{$x := 1}}{{template \"x y\" .X}}")
  vec("{{ with .X. |printf not }}{{- /* c  \n\t */ -}}{{- /* cü */ -}}{{- \trange $i, $e := $z := $x }}{{ $e  -}}{{\nend  }}{{\nhtml .| printf (printf false|.X nil)| (((2)))}}{{\tend  -}} x {{- \n0x1p-2 eq| 017 (.X) }}", 0, "ERR:template: v:1: unexpected <.> in operand")
  vec("{{$x := 1}}{{- \t$x := 0b101 len (printf `%d` 1)| not $x.B.C `unterm\t}}", 2, "ERR:template: v:1: unterminated raw quoted string")
  vec("{{$x := 1}}{{\neq ($z := -2 . (1+2i |len 1e9 '\\x41' |not 1_000)) |html $ |\"q\\\"q\" .Field1.Field2 'a'  }}{{ block \"blk\" -2 |not '本' 0o17 |len\t -}}{{ if .}}{{template \"x y\" .  }} x {{  \"a\\tb\" }}{{\nend  }}\n{{\n1_000 | printf '\\n'}}{{- \nend\t}}{{or\t}}{{ $x := $x.B.C 1+2i |. |.X -1-2i '\\n' -}}", 0, "ERR:template: v:2: non executable command in pipeline stage 3")
  vec("{{$x := 1}}{{define \"b\" }}ü{{- \t'\\n'}}{{-   index| ( 'a' }}{{\nend }}{{-   template \"x y\" .X   -}}", 1, "ERR:template: v:1: unclosed left paren")
  vec("{{$x := 1}}}{{template \"x y\" }}", 0, "v={{$x := 1}}}{{template \"x y\"}}")
  vec("{{$x := 1}}{{\nrange $i, $e := -1-2i  }}{{-   $e  }}{{end}}line1\nline2", 0, "v={{$x := 1}}{{range $i, $e := -1-2i}}{{$e}}{{end}}line1\nline2")
  vec("{{$x := 1}}  \n\t", 0, "v={{$x := 1}}  \n\t")
  vec("{{-   html (\"q\\\"q\" 017 2.5i| $x) 0x1p|print  }}{{  template \"x y\" .\t}}", 0, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{$x := 1}}{{- \tdefine \"c\"  }}{{-   block \"blk\" ($x = . '\\n'|.X '\\u00e9') | printf \# len   -}}{{\ttemplate \"a\"\n}}{{\nend }}{{end  }}{{ template \"x y\" $  }}{{1+2i\n}}", 0, "ERR:template: v:1: unexpected \"\#\" in operand")
  vec("{{$x := 1}}{{\t(.Field1.Field2 (printf `%d` 1) $ |.X)| $x 1i| -2 }}{{  template \"b\" $}}{{range $i, $e := ((.X).Y |len (len .).Z) |print $.A |$x index }}{{ continue }}{{- \nend\t -}}{{ .Field1.Field2 '本' |print |$x\n}}", 0, "ERR:template: v:1: non executable command in pipeline stage 3")
  vec("{{$x := 1}}{{\"str\"\t -}}{{\n0b101 |.X ((0x1F (.X) '\\n' |print -1-2i (((2)))))  }}{{\nrange +3 0x1p-2 |len\t -}}\n{{\nprintf  }}{{-   end -}}", 1, "v={{$x := 1}}{{\"str\"}}{{0b101 | .X ((0x1F (.X) '\\n' | print -1-2i (((2)))))}}{{range +3 0x1p-2 | len}}{{printf}}{{end}}")
  vec("{{$x := 1}}a", 0, "v={{$x := 1}}a")
  vec("{{$x := 1}}{{ range \"ü\" | not\n}}{{\nrange $i, $e := $x|((1)) \"ü\" nil  }}{{-  $i\t -}}{{end  }}{{  if $x = 0o17 \"ü\"\t}}  \n\t{{ true}}{{\t$x = 1 not| false| '\\n' 1i  }}{{ (.X).Y\t}}{{-   else if and eq  }}{{ $x| print $ true| 1+2i -}}{{'a'\t}}{{  end\t}}{{\nelse\n}}{{- \t(printf `%d` 1) }}-{{{ end  }}", 2, "ERR:template: v:4: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{block \"a\" 1| $x| $x index 017\t}}{{\ttemplate \"x y\" .X   -}}{{- /* ca */}} x {{\nend\n}}{{ $y and| 1+2i \"ü\" index| .X }}", 0, "ERR:template: v:3: undefined variable \"$y\"")
  vec("{{$x := 1}}{{  define \"b\"   -}}{{\n\"ü\" 1_000 1_000   -}}{{\nend\n}}{{ with (((2))) 2.5i '\\u00e9' | not and | html false\n}}{{\thtml  }}{{/* cline1\nline2 */ -}}{{  end}}", 0, "b={{\"ü\" 1_000 1_000}}\nv={{$x := 1}}{{with (((2))) 2.5i '\\u00e9' | not and | html false}}{{html}}{{end}}")
  vec("{{- \trange $i, $e := $x = 0x1F (printf `%d` 1) \"ü\"| $x or\t}}{{  $e }}{{- \tend\t}}{{\t$.A not \"str\"| $x 'a' 0b101\n}}{{\nrange $i, $e := .X.|not $ ($z := 017 0o17 \"q\\\"q\")|.X   -}}{{\n$i\n}}{{ end\t -}}", 0, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{- /* c  \n\t */}}{{\twith -1-2i| 1_000 1| not \"ü\"   -}}{{  template \"a\" .X\t -}}{{ $x := $.A `a\nb`|not|print and 1+2i}}{{ else with ((printf `%d` 1) index|not 0x1p-2)\n}}{{\thtml  }}{{/* chello  */ -}}{{-  template \"x y\" .}}{{ $x := printf not -2.5e3\n}}{{  end }}", 0, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{true\t}}", 1, "v={{$x := 1}}{{true}}")
  vec("{{ if 1.5  }}{{- /* c  \n\t */}}{ {{{- \tbreak -}}{{ with $x := 1 1_000 1+2i | $x\t}}{{/* c<b> */ -}}{{ \"str\"}}{{ $x.B.C  }}{{ end  }}{{- \nelse if $z := (\"str\" 0b101 `a\nb`) len\n}}{{- 'a'  -}}{ {{{- $ printf  }}{{- \nend }}{{  (. (((2))) (-1-2i|html))\t}}{{range $i, $e := and true   -}}{{\n$i  }}{{\nend }}", 0, "ERR:template: v:2: unexpected \"{\" in command")
  vec("{{$x := 1}}", 0, "v={{$x := 1}}")
  vec("{{$x := 1}}-{{/* c  \n\t */ -}}{{\n'本'\t}}{{ nil }}", 0, "v={{$x := 1}}-{{'本'}}{{nil}}")
  vec("{{$x := 1}}{{- with (0b101 .) 2.5i |printf (printf `%d` 1)\t}}{{- \n.X\n}}{{\n-2\t}}{{  template \"x y\" $\t}}{{\tend }}{{  ! printf |.X |$x 1.5 ((1))   -}}ü{{define \"a\"  -}}{{\ttemplate \"b\" .X  }}{{\n(.X) -}}{{- \nend\n}}", 0, "ERR:template: v:4: unexpected \"!\" in command")
}

test "parse vectors 4" {
  vec("{{$x := 1}}{ {", 0, "v={{$x := 1}}{ {")
