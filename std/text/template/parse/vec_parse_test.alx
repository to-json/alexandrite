}

test "parse vectors 9" {
  vec("{{$x := 1}}{{$ }}{{\n+3}}{{- block \"a\" $x := `a\nb` eq | 1.5 2.5i $x  }}{{{'a'   -}}{{\t((1)) }}}{{\tend   -}}{{ block \"a\" 1.5 , |$x |not 1e9  }}{{\nwith (($x = \"q\\\"q\" 0o17 '\\x41' |.X 017 |html)) (+3 ($x.B.C 'a'| $.A .X| printf \"unterminated) 0b101)\n}}{{- '本'  }}line1\nline2{{- \n-1-2i }}{{- /* c x  */}}{{\nend  -}}", 0, "ERR:template: v:3: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{ {hello {{\ntemplate \"b\" .X -}}{{-  (1i $ (.X).Y| not| printf) true|html `a\nb` 0o17|($x := true $ false |.X) html '\\x41'\t}}", 0, "v={{$x := 1}}{ {hello {{template \"b\" .X}}{{(1i $ (.X).Y | not | printf) true | html `a\nb` 0o17 | ($x := true $ false | .X) html '\\x41'}}")
  vec("{{range $i, $e := \"str\" 1+2i\t}}{{ break}}{{\nend\n}}", 0, "v={{range $i, $e := \"str\" 1+2i}}{{break}}{{end}}")
