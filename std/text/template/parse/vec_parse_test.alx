  vec("{{$x := 1}}{{\n0b101\n}}{{- \t'\\x41' }}{{-   if \"a\\tb\" |print \"ü\" := |html\n}}{{- `a\nb`}}{{ else if 0x1F '\\u00e9'}}{ {{{\ttemplate \"a\" $\t}}{{\nend\t -}}", 1, "ERR:template: v:3: unexpected \":=\" in operand")
  vec("{{\tfalse\t}}\n{{ $z := html|print ($z := 017 |.X |.X '\\x41') '本'\t}}{{  -\n}}", 0, "ERR:template: v:2: illegal number syntax: \"-\"")
  vec("{{$x := 1}}{{-  template \"b\" .X   -}}{{\trange $i, $e := index | html and | not  -}}{{  continue\t -}}{{end }}{{((printf \"q\\\"q\"| .X '\\x41' \"str\"))}}", 0, "v={{$x := 1}}{{template \"b\" .X}}{{range $i, $e := index | html and | not}}{{continue}}{{end}}{{((printf \"q\\\"q\" | .X '\\x41' \"str\"))}}")
  vec("{{\tdefine \"c\" }}{{\n.X}}{{  $x := html | not | (printf `%d` 1)  }}{{- \n(1.5 1_000| html ('\\n' | not))  }}{{ end  }}{{- \ntemplate \"x y\"   -}}", 0, "c={{.X}}{{$x := html | not | (printf `%d` 1)}}{{(1.5 1_000 | html ('\\n' | not))}}\nv={{template \"x y\"}}")
  vec("{{\nrange $i, $e := ((1)) (.X ($x = '本' \"unterminated false| \"ü\" \"q\\\"q\"| $x .X) or) 2.5i|printf|print }}{{\nbreak}}{{end\n}}{{{ 0o17}}{{- /* ca */}}", 0, "ERR:template: v:2: bad character U+0022 '\"' in action started at v:1")
