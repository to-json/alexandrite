  vec("{{$x := 1}}{{range $i, $e := printf and (((2))) |not nil\t -}}{{ break   -}}{{end\t}}", 0, "v={{$x := 1}}{{range $i, $e := printf and (((2))) | not nil}}{{break}}{{end}}")
  vec("{{$x := 1}}{{-   .X false false| $x $.A  }}{{-  range $i, $e := -1-2i 0b101 (printf `%d` 1)\n}}{{\t$e }}{{ end  }}{{\n(len .).Z \"ü\"|.X true len}}", 0, "v={{$x := 1}}{{.X false false | $x $.A}}{{range $i, $e := -1-2i 0b101 (printf `%d` 1)}}{{$e}}{{end}}{{(len .).Z \"ü\" | .X true len}}")
