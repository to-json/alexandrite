  vec("{{$x := 1}}{{\tif +3 (.X).Y |1+2i |$x}}{{\nrange $i, $e := and }}{{- $i}}{{ end  }}{ {hello {{with $z := (false '\\n') +3}}{{\t1e9 }}{{-   else with .Field1.Field2 html 2.5i\t}}{ {{{  'a'  }}{{0o17\t}}{{- \tend}}{{  else }}{{- /* c<b> */ -}}{{  $x = 1 -2 -}}}{ {{{end  }}", 0, "ERR:template: v:1: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{/* c x  */ -}}{{\tblock \"a\" 1.5 1_000 nil |not ((printf `%d` 1) index| html) ($x = (.X) 1.5| printf) |.X\t}}{{  1.5 ($x := +3 -2.5e3) 1e9|html $ \"ü\"\t}}{{end\t}}{{\neq -}}{{-   printf\n}}", 0, "a={{1.5 ($x := +3 -2.5e3) 1e9 | html $ \"ü\"}}\nv={{$x := 1}}{{template \"a\" 1.5 1_000 nil | not ((printf `%d` 1) index | html) ($x = (.X) 1.5 | printf) | .X}}{{eq}}{{printf}}")
  vec("{{$x := 1}}ü{{- /* chello  */}}{{ '\\u00e9' \"q\\\"q\" |.X 017 (eq false (1_000|printf '\\n') | html | .X 'a') |not .X.Y `a\nb`}}", 0, "v={{$x := 1}}ü{{'\\u00e9' \"q\\\"q\" | .X 017 (eq false (1_000 | printf '\\n') | html | .X 'a') | not .X.Y `a\nb`}}")
  vec("{{$x := 1}}{{$x.B.C |'\\n' 017 1_000 }}{{- \"ü\"  }}{{  + | len eq and | printf   -}} x ", 0, "ERR:template: v:1: non executable command in pipeline stage 2")
  vec("ü{{\ttemplate \"a\" }}{{\n(.X).Y  }}", 0, "v=ü{{template \"a\"}}{{(.X).Y}}")
