  vec("{{$x := 1}}{{ block \"blk\" '\\u00e9' '\\x41' $x |print or .X.Y\n}}ü{{range $i, $e := (.X 1.5 and|html (printf `%d` 1)) \"a\\tb\" (printf `%d` 1)  }}{{ $i }}{{\tend }}{{- \nwith 1_000 eq\t}}{{/* cline1\nline2 */ -}}{{\nelse with \"ü\" }}{{\tand\t}}{{  template \"b\"   -}}{{- \t.X.Y }}{{\tor\t}}{{end\n}}line1\nline2", 0, "ERR:template: v:7: unexpected EOF")
  vec("{{$x := 1}}hello {{\t\"q\\\"q\" | print | printf}}{{$x = '\\u00e9'| len '本' `raw`| (-2.5e3 `a\nb`) (printf `%d` 1) and}}{{and\t}}", 1, "v={{$x := 1}}hello {{\"q\\\"q\" | print | printf}}{{$x = '\\u00e9' | len '本' `raw` | (-2.5e3 `a\nb`) (printf `%d` 1) and}}{{and}}")
  vec("{{ .\n}}{{- /* cline1\nline2 */}}{{- \t$.A | printf -1-2i | printf\t}}{{-   \"a\\tb\"\t}}", 0, "v={{.}}{{$.A | printf -1-2i | printf}}{{\"a\\tb\"}}")
  vec("{{  template \"a\" .X  }}{{- block \"blk\" \"q\\\"q\" 0b101 |printf 'a' |'\\n' .X  }}{{  +3\n -}}{{- template \"a\"   -}}-  \n\t{{end }}{{0x1F  -}}", 0, "ERR:template: v:1: non executable command in pipeline stage 3")
  vec("{{- \t$x = (.X) 0o17 $x| html 0b101\n}}{{  with \"a\\tb\"| not| \"str\" \"a\\tb\"\n -}}{{\ntemplate \"x y\" .   -}}{{- \nblock \"blk\" $x.B.C 1e9 $x| printf (1+2i ($x := `raw` $ `a\nb`|print) 1e9)| .X  }}{{  (.X)\n}}{{\nindex}}{{\nend\t}}{{\nrange '\\n'| not .X. 2.5i\n}}{{  (printf `%d` 1)\t}}<b>{{\telse }}a{{- /* c<b> */}}{{\n-2 1e9 | not 0o17 (html len | printf | html '\\u00e9' .X.Y)\n}}{{\ntemplate \"a\" .X  }}{{end\n -}}{{ end }}{{  range $i, $e := $x = `raw` }}{{ continue }}{{\nend\n}}{{with $z := true 1  }}{{\t@\t}}{{\t$x.B.C}}{{  $x.B.C\t}}{{end\t}}", 0, "ERR:template: v:3: non executable command in pipeline stage 3")
  vec("{{$x := 1}}{{\n-2 not|1i|$ (`raw` |not)  }}", 2, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{\n.Field1.Field2 $ |html 0o17 .X.Y\t}}", 0, "v={{.Field1.Field2 $ | html 0o17 .X.Y}}")
