  vec("{{$x := 1}}{{\nrange $i, $e := . nil| printf  }}{{$e  }}{{-   end }}{{-   range $i, $e := (.X) (.X)| $x ((1)) ($x)| printf 017 \"unterminated\t}}{{\nbreak  }}{{  end  }}{{\ndefine \"a\" -}}{{-   0x1F\t}}{{ end\n -}}{{ 1.5  }}", 0, "ERR:template: v:2: unterminated quoted string")
  vec("{{$x := 1}}}{{/* c\n */ -}}{{\teq |print (.X (printf `%d` 1)) |print or  }}", 0, "v={{$x := 1}}}{{eq | print (.X (printf `%d` 1)) | print or}}")
  vec("{{\ttemplate \"b\"  }}  \n\t{{-   with false |printf @ false }}{{\ttemplate \"a\" .X}}{{\nrange $i, $e := $x := '\\n' \"ü\" '\\x41'|0x1F  }}{{\tcontinue\n}}{{end }}{{- /* cline1\nline2 */}}", 2, "ERR:template: v:2: unexpected \"@\" in operand")
  vec("{{range $i, $e := $z := (.X).Y | true  }}{{\nbreak\t}}{{- \nend\n}}{{  define \"b\"\t}}{{- /* c  \n\t */ -}}{{\t2.5i\n}}{{with . .X '\\u00e9'  -}}{{  1 }}{{ false\t -}}{{\nend  }}{{\nrange $i, $e := (-2| print \"q\\\"q\" '本') }}{{\ncontinue}}{{  end}}{{end  }}", 0, "ERR:template: v:1: undefined variable \"$z\"")
  vec("}{{\t0o17| print (not (printf `%d` 1)) `a\nb`\n}}", 0, "v=}{{0o17 | print (not (printf `%d` 1)) `a\nb`}}")
  vec("{{$x := 1}}  \n\t{{ template \"a\" .X  }}{{$x.B.C}}", 0, "v={{$x := 1}}  \n\t{{template \"a\" .X}}{{$x.B.C}}")
  vec("{{$x := 1}}{{-   .X}}{{/* cü */ -}}{{\tblock \"blk\" ($z := ($z := $x.B.C |print $x '\\x41' |len 0o17 index) 1|html true|.X `raw`) '\\n'|not\n}}{{-   'a'|len|len\t}}{{- /* c */ -}}{{\nend\n}}", 1, "blk={{'a' | len | len}}{{/* c */}}\nv={{$x := 1}}{{.X}}{{/* cü */}}{{template \"blk\" ($z := ($z := $x.B.C | print $x '\\x41' | len 0o17 index) 1 | html true | .X `raw`) '\\n' | not}}")
