  vec("ü", 0, "v=ü")
  vec("{{$x := 1}}{{\tblock \"a\" .Field1.Field2 |.X  }}{{\nblock \"a\" 0x1F\t}}{{- \n0b101}}{{- /* c{ */ -}}{{ template \"b\"  -}}a{{\nend   -}}{{  template \"b\" $\t}}{{/* c x  */}}{{- end}}{{- /* c- */}}{{- /* c- */}}{{\nif .X '\\n'| printf| printf . `a\nb`\n}}{{\t$x := '\\x41' . | len '\\x41' }}{{- '\\x41' \"ü\" }}  \n\t{{{end\n}}", 0, "ERR:template: v:4: template: multiple definition of template \"a\"")
  vec("{{  break -}}\n", 0, "ERR:template: v:1: {{break}} outside {{range}}")
