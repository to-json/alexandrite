  vec("{{$x := 1}}{{\t(.X) and | printf ($x = printf -2| .X) $ | (\"q\\\"q\" 0b101 .|$x -2.5e3)\t -}}-{{  template \"x y\" .\n}}{{\n\t}}", 0, "ERR:template: v:3: missing value for command")
