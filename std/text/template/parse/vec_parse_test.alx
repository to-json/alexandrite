  vec("ü{{ define \"b\"  -}}{{-2 1 '\\x41'\n -}}{{\tif $x = (.X).Y len| not \"ü\"| printf\t}}{{\t(len .).Z \"q\\\"q\"}}{{else}}hello {{ ((1)) }}{{\tend   -}}{{end\n}}{{0o17 (.X)\t -}}{{\t'本'\n}}", 0, "b={{-2 1 '\\x41'}}{{if $x = (.X).Y len | not \"ü\" | printf}}{{(len .).Z \"q\\\"q\"}}{{else}}hello {{((1))}}{{end}}\nv=ü{{0o17 (.X)}}{{'本'}}")
