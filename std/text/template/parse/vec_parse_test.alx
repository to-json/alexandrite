  vec("{{$x := 1}}{{ block \"a\" nil | printf len\t}}{{- /* c\n */}}{{  $x.B.C\t}}{{  false\t}}{{- \tend\t -}}hello {{- /* chello  */ -}}{{\teq| print (.X).Y ((1))}}", 0, "ERR:template: v:2: undefined variable \"$x\"")
  vec("{{$x := 1}}line1\nline2{{\nnil\n -}}{{\nrange $i, $e := -2.5e3  }}{{- \tbreak\t -}}{{ end  }}{{\nrange $i, $e := \"str\"  -}}{{break }}{{  end\t}}", 0, "v={{$x := 1}}line1\nline2{{nil}}{{range $i, $e := -2.5e3}}{{break}}{{end}}{{range $i, $e := \"str\"}}{{break}}{{end}}")
  vec("{{- \n($x and)|printf\n}}{{\trange '\\n'\t}}{{  1 |'\\x41'}}{{- /* c} */}}-{{- \t.Field1.Field2  -}}{{ else  }}{{\trange $i, $e := 0x1F 2.5i (($x := (printf `%d` 1)|print \"ü\" (len .).Z) '\\u00e9' | print `raw`) -}}{{\n$e }}{{-   end }}{{- \ttemplate \"a\"\n}}{{\tend\t}}{{- /* c{ */}}", 0, "ERR:template: v:2: undefined variable \"$x\"")
  vec("{{- /* c  \n\t */}}{{\n(-1-2i -2.5e3 '\\n' | html) }}", 0, "v={{(-1-2i -2.5e3 '\\n' | html)}}")
  vec("-{{  range $i, $e := -2.5e3 |printf (((1)) -1-2i) (printf `%d` 1)}}{{$i  }}{{-  end }}  \n\t{{ .Field1.Field2 (len .).Z| '\\n' 0o17 +3  }}", 1, "ERR:template: v:2: non executable command in pipeline stage 2")
