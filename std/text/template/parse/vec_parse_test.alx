  vec("{{$x := 1}}{{- `a\nb` }}{{  define \"c\"  -}}line1\nline2{{/* c{ { */ -}}{{- /* c{ { */ -}}{{$x := '\\n' nil -| print and\n}}{{\tend}}{{\nrange (.X (((1)) (((2)))|not) 1i | printf nil len | printf +3 ($x := 0x1F |len)) (.X) .Field1.Field2 | html 1+2i\t -}}{{\ntemplate \"b\"\t}}{{-  eq\n}}{{\tend\n}}", 0, "ERR:template: v:3: illegal number syntax: \"-\"")
