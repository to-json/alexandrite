test "parse vectors 2" {
  vec("<b>{{-   block \"a\" $|print ($x.B.C 0o17 (`raw` `a\nb`|true) | ($x = html and 0x1F) \"ü\" -2 | html `a\nb` \"str\")|printf  }}} x {{  end\n}}{{  template \"a\"}}", 0, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{$x := 1}}{{/* c} */}}{{\t. |.X |\"ü\"}}{", 0, "ERR:template: v:1: non executable command in pipeline stage 3")
  vec("{{$x := 1}}{{  block \"blk\" .Field1.Field2 $.A $x.B.C |not  -}}{{index | $x 1.5 $\t}}{{- or |.X '\\u00e9' (((2))) |html +3 1+2i }}{{- \nend}}{{  define \"b\"\t}}<b>{{ \"unterminated  -}}  \n\t{{-   end }}", 0, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{$x := 1}}{{\trange 1e 0x1F .| len| html $y eq -}}{{\t`a\nb`\t}}{{-   block \"blk\" (printf `%d` 1) 1i\n}}{{\n$ }}{{\n(.X)  }}{{{  $x = 1e9  }}{{-   end}}{{-  len\n -}}{{\t\"str\"}}{{\nend\t}}{{\t$x.B.C\n}}line1\nline2{{  template \"a\" $\n -}}", 2, "ERR:template: v:1: illegal number syntax: \"1e\"")
  vec("{{$x := 1}}{{ block \"a\" $x := .X.Y}}\n{{ block \"a\" $x = .X \"ü\" 1| .X 0x1F\n}}{{- \n1_000\n}}{{\nend\n}}{{  . and\n}}{{\nrange $i, $e := '\\x41' (\"str\" +3 true |.X 2.5i '\\n' |not $x.B.C nil)}}{{\t$i\t}}{{end}}{{- end\t}}{{\n((1)) 1e\t}}{", 0, "ERR:template: v:9: template: multiple definition of template \"a\"")
  vec("{{$x := 1}}{{  '\\n'\t}}{{if and .Field1.Field2 -2.5e3 |$x or eq\n}}{{- \n-2  }}{{  ((.X)|(`raw`) 1_000 \"a\\tb\"|'\\u00e9' '本') + |$x (((2))) (. ( ('\\x41') |'\\n' 1_000 `raw`) |printf $x.B.C \"str\"\t}}{{\t$x 1 }}{{  else if $x = 2.5i -2.5e3 (((2)))   -}}{{ range $i, $e := $x.B.C 1 | printf 1_000 -2.5e3\t}}{{break  }}{{ end }}line1\nline2{{end }}{{\ttemplate \"b\" .X\n}}", 0, "ERR:template: v:3: non executable command in pipeline stage 3")
  vec("{{\ttemplate \"x y\"\t -}}{{\n-2.5e3}}{{ $z := $y (len 2.5i|$x true|.X)\n}}ü", 1, "ERR:template: v:2: undefined variable \"$y\"")
  vec("  \n\t\n<b>{{\nrange $i, $e := -2.5e3|len ((not) -2|printf 0x1p-2 017|$x) -2}}{{- \nbreak\t -}}{{ end\t}}", 0, "ERR:template: v:4: undefined variable \"$x\"")
  vec("{{$x := 1}}{{-  0x1p-2}}", 0, "v={{$x := 1}}{{0x1p-2}}")
  vec("{{\n$x = -2| .X}}{{-  '\\x41' -2 (printf `%d` 1)}}", 0, "v={{$x = -2 | .X}}{{'\\x41' -2 (printf `%d` 1)}}")
  vec("{{ $x\n}}{{range $i, $e := $x = \"str\" ' \"q\\\"q\"| print len .X\n}}{{ $e\n}}{{\tend}}", 0, "ERR:template: v:2: undefined variable \"$x\"")
  vec("{{$x := 1}}{{\t$|html|printf 1.5  }}{{\tdefine \"c\"   -}}{{  block \"blk\" 1.5 -}}{{  '本'}}{{\n1_000\n}}{{  $x.B.C 2.5i\t -}}{{- \t1_000 \"q\\\"q\" \"ü\" | .X $x.B.C $.A | .X ( -}}{{ end  }}{{\nwith (1e9 \"q\\\"q\"| len nil index) | printf | print }}{{1_000  }}{{3k  -}}{{- \n017  }}{{else\t -}}{{\n'\\x41'  }}{{end\t}}-{{- /* c x  */}}{{ end}}{ {", 0, "ERR:template: v:3: undefined variable \"$x\"")
  vec("{{$x := 1}}{{- /* c<b> */ -}}{{  template \"x y\" }}{{\t$x  -}}{{ block \"a\" ( (.X).Y\t}}{{\n$.A $x $x.B.C }}{{range $i, $e := not |print $.A |html\t}}{{\t$i  -}}{{end -}}\n{{  end }}", 0, "ERR:template: v:1: unclosed left paren")
  vec("{{$x := 1}}{{/* c- */ -}}{{\n`a\nb`\n}}{{  0x1p-2 }}{{- 1i 0o17|$x eq .X.Y   -}}", 1, "v={{$x := 1}}{{/* c- */}}{{`a\nb`}}{{0x1p-2}}{{1i 0o17 | $x eq .X.Y}}")
  vec("{{$x := 1}}{{/* c{ */ -}}{{  template \"x y\" $\t}}", 2, "v={{$x := 1}}{{template \"x y\" $}}")
  vec("{{$x := 1}}{{/* c */}}{{continue\t}}", 0, "ERR:template: v:1: {{continue}} outside {{range}}")
  vec("{{$x := 1}}{{$x = ((1)) '本' |.X 0b101 }}", 0, "v={{$x := 1}}{{$x = ((1)) '本' | .X 0b101}}")
