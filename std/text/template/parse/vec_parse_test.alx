  vec("{{$x := 1}}{{(.X)}}{{ block \"blk\" 0x1p-2 . | print 1_000 | print\n}}{{- \ttemplate \"b\" $ -}}{{\nend\t}}{{ range $i, $e := $x = 1+2i \"ü\"\n}}{{\t$i   -}}{{  end}}{{1 . (0b101 \"a\\tb\") |print $ (\"ü\" |((1)) \"str\" index |html printf) |not  -}}", 2, "ERR:template: v:3: unexpected \"=\" in operand")
