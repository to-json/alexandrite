}

test "parse vectors 12" {
  vec("  \n\t{{.X}}{{define \"a\"\t -}}{{\n1_000  }}{{\tblock \"a\" $z := '\\n' .X.Y ((((3)))) | printf ((1)) }}{{- \tnil |len not 1+2i }}{{\t$\t}}{{  'a' 1_000| printf| printf 1.5}}{{\nend\t}}{{\nend }}", 1, "ERR:template: v:5: template: multiple definition of template \"a\"")
  vec("{{ .X printf |$x.B.C not (1_000 $.A '本') |.X\t}}", 0, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{\nrange $i, $e := $z := (`raw`) $x.B.C true | printf -2 (\"q\\\"q\" 1i)\t}}{{\ncontinue\t}}{{-  end\t}}{{define \"b\"  -}}{{- range $i, $e := 0x1F or |.X. ((1)) }}{{  continue }}{{end\t}}{{ with \"a\\tb\" html 1_000|printf undefinedFn (html 0b101 0x1p-2|print eq 0b101)|not\t}}{{ nil  -}}{{\t$x := 1+2i or or}}{{- \tnil }}  \n\t{{end }}{{ and \"q\\\"q\" \"ü\"\t -}}{{end}}{ {", 0, "ERR:template: v:2: undefined variable \"$z\"")
  vec("{{$x := 1}}{{-   range $i, $e := '\\n' \"str\"\n}}{{\t$i\n}}{{\nend }}", 0, "v={{$x := 1}}{{range $i, $e := '\\n' \"str\"}}{{$i}}{{end}}")
  vec("{{$x := 1}}hello {{- /* chello  */}}", 2, "v={{$x := 1}}hello")
  vec("-{{-   block \"a\" 0x1F 2.5i not| .X (.X.Y nil |len) ($z := $x $.A)}}{{  $z := $x.B.C ((:=) \"ü\" +3 | print (((2))))}}{{  $z := $x | not | 1i }}{{- \n(index | not ($x .X |.X -1-2i |not 1_000)) +3 html\n}}{{- \nend  }}{{\ttemplate \"b\" .X  }}", 0, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{$x := 1}}{{- template \"x y\" .X\t}}{{  017  }}{{\tif 017 }}line1\nline2{{  else if true }}{{  if nil false\t}}{{\t.X\n}}{{\t$x  }}{{.Field1.Field2 -}}{{- -2.5e3| .Field1.Field2 $ not}}{{end }}\n{{- \t((nil) $x.B.C $.A|$x 2.5i len|len \"a\\tb\" (printf `%d` 1))| not ((1)) 0b101\n}}{{\nend}}", 0, "v={{$x := 1}}{{template \"x y\" .X}}{{017}}{{if 017}}line1\nline2{{else}}{{if true}}{{if nil false}}{{.X}}{{$x}}{{.Field1.Field2}}{{-2.5e3 | .Field1.Field2 $ not}}{{end}}{{((nil) $x.B.C $.A | $x 2.5i len | len \"a\\tb\" (printf `%d` 1)) | not ((1)) 0b101}}{{end}}{{end}}")
  vec("{{$x := 1}}}{{\tcontinue }}{{\twith 1_000 | eq ($z := printf -1-2i) '\\u00e9' | $x (.X).Y  }}{{- /* chello  */}}{{\trange $i, $e := -2.5e3 | print 1+2i (.X)  }}{{  $i  }}{{ end\n}}{{  block \"blk\" $x = (len .).Z 2.5i }}{ {{{\nor}}{{end\t}}{{\n((((2))) 1e9|.X index index|.X) $ true\t}}{{ else  }}{{   }}}{{  range $i, $e := (.X) |html 0x1F\n}}{{\n$i\n}}{{  end\t}}{{\ttemplate \"a\" $  }}{{ end }}", 1, "ERR:template: v:1: {{continue}} outside {{range}}")
  vec("{{  len}}{{  1.5 -2.5e3\t}}{{ $x := `a\nb` (.X)| ((1+2i 1e9 '\\x41') 1e9 .Field1.Field2)| not and '\\u00e9'  }}", 0, "v={{len}}{{1.5 -2.5e3}}{{$x := `a\nb` (.X) | ((1+2i 1e9 '\\x41') 1e9 .Field1.Field2) | not and '\\u00e9'}}")
  vec("{{$x := 1}}{{ range 0b101 1+2i }}{{{ .Field1.Field2 1i |'本' printf , }}\n{{\nrange $i, $e := - -2.5e3\n}}{{- \tbreak\n}}{{ end\n}}{{\tend}}{", 0, "ERR:template: v:1: unexpected \"{\" in command")
  vec("a{{  0b101}}{{\t((! .X.Y '\\u00e9' |len \"ü\") 017 |print 0x1F) (.X).Y \"q\\\"q\"| not \"unterminated (index $ 0o17)| (.X).Y 0x1p-2\t}}{{\ntemplate \"a\" $\t}}", 0, "ERR:template: v:1: unexpected \"!\" in parenthesized pipeline")
