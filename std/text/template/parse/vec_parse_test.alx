  vec("{{$x := 1}}{{\tdefine \"c\"  }}a{{/* c x  */}}<b>{{ end\n}}  \n\t{{\n\"ü\"\t}}", 0, "c=a<b>\nv={{$x := 1}}  \n\t{{\"ü\"}}")
  vec("{{$x := 1}}{{\ttemplate \"a\" .X  }}-{{- \tblock \"a\" false\t}}{{\n+3 true ($x ((1)) (printf `%d` 1)) | print   -}}{{\tend}}{{\twith .X 0o17 -2  }}{{\nblock \"a\" \"ü\"|len|print .  }}{{  $z := (((2))) | -2.5e3 .X   -}}hello {{- \tend }}  \n\t{{\t((.X.Y 0x1F) |len \"q\\\"q\" |-2.5e3 '本' (.X '\\n'|html|len `raw`)) +3}}{{  template \"a\" -}}{{  end}}", 0, "ERR:template: v:2: undefined variable \"$x\"")
  vec("{{.X 017 (len .).Z}}", 1, "v={{.X 017 (len .).Z}}")
  vec("{{$x := 1}}{{-  1i\n -}}{{\ttemplate \"x y\"  }}{{define \"a\"}}  \n\t{{  if ((1))  }}{{-   0x1F\t}}{{ -2.5e3 }}{{\n1i}}ü{{\telse if `a\nb` |.X len }}{-{{\nend\t}}{{  end }}", 0, "a=  \n\t{{if ((1))}}{{0x1F}}{{-2.5e3}}{{1i}}ü{{else}}{{if `a\nb` | .X len}}{-{{end}}{{end}}\nv={{$x := 1}}{{1i}}{{template \"x y\"}}")
  vec("\n", 0, "v=\n")
  vec("{{$x := 1}}{{  range $i, $e := or 017 ($z := $.A)| printf\t}}{{  break\t}}{{\tend\n}}", 2, "v={{$x := 1}}{{range $i, $e := or 017 ($z := $.A) | printf}}{{break}}{{end}}")
  vec("{{  ((1)) }}ü<b>{{\n1e9 \"a\\tb\" =|index \"q\\\"q\"|len }}", 0, "ERR:template: v:2: unexpected \"=\" in operand")
}

test "parse vectors 18" {
  vec("hello {{ define \"b\"\t}}{{\nrange $i, $e := '\\x41' '\\x41' 1|print 'a'\n}}{{\nbreak}}{{ end  -}}{{\tend\n}}{{-  0x1F }}", 0, "b={{range $i, $e := '\\x41' '\\x41' 1 | print 'a'}}{{break}}{{end}}\nv=hello {{0x1F}}")
  vec("{{$x := 1}}{{/* c{ { */ -}}a{{\t(.X).Y\t}}", 0, "v={{$x := 1}}a{{(.X).Y}}")
  vec("{{$x := 1}}a{{  `a\nb` (printf `%d` 1) '\\u00e9' }}", 1, "v={{$x := 1}}a{{`a\nb` (printf `%d` 1) '\\u00e9'}}")
  vec("{{  nil '\\x41' 1.5 -}}{{\tblock \"a\" $x := ($ |$x)| \"unterminated\t}}{{ $x = $ | not '\\u00e9'}} x {{if eq (((2)))|\"q\\\"q\"|print (printf printf $|2.5i len|.X) nil  }}{{ -2 }}{{\n`raw` }}{{  template \"x y\" $  }}{{else }}{{-  end\n}}{{  end }}{{\trange $i, $e := 1i len 0x1F}}{{- $i  }}{{\nend\n}}{{  not ($z := ($z := (len .).Z | true)|.X) }}", 0, "ERR:template: v:1: bad character U+005C '\\'")
  vec("{{$x := 1}}{{/* c<b> */}}{{- \t$x := (printf `%d` 1)|print|$ index 1\t}}{{$x = 0b101 true\n -}}", 0, "v={{$x := 1}}{{$x := (printf `%d` 1) | print | $ index 1}}{{$x = 0b101 true}}")
  vec("{{$x := 1}}{{define \"a\"\n}}{{\n-2 |printf nil 1+2i |not +3 \"a\\tb\"\t}}{{ end\n}}{{ ..|printf 1i   -}}", 0, "ERR:template: v:4: unexpected <.> in operand")
  vec("{{$x := 1}}{{-  range $i, $e := 017 0b101 1.5| printf \"str\" .X.Y| printf '本'\t}}{{\ncontinue -}}{{ end\t}}{{\n0x1p-2  }}{{\ttrue -}}{{  template \"b\" $   -}}", 0, "v={{$x := 1}}{{range $i, $e := 017 0b101 1.5 | printf \"str\" .X.Y | printf '本'}}{{continue}}{{end}}{{0x1p-2}}{{true}}{{template \"b\" $}}")
  vec("a{{\nprintf|$x\n}}{{\n$x := .X.Y | $x (eq 1_000 1) .   -}}", 0, "ERR:template: v:2: undefined variable \"$x\"")
  vec("{{$x := 1}}{{- `raw` |len 'a'}}}", 0, "v={{$x := 1}}{{`raw` | len 'a'}}}")
  vec("{{$x := 1}}\n{{/* c x  */}}<b>{{ $z := \"ü\"\n}}", 3, "v={{$x := 1}}\n{{/* c x  */}}<b>{{$z := \"ü\"}}")
  vec("{{$x := 1}}{{  block \"a\" \"ü\" true| .X printf \"ü\"| not  }}{{  `a\nb` (html)|len|print}}{{- /* c{ { */ -}}-{{\nend\t}}{{\n.Field1.Field2 ('本' nil) | html\n}}{{ block \"blk\" 1e9 and $}}{{ . ((1)) | $x '\\u00e9' `a\nb` | len .X.Y (nil (0x1p-2 |$x \"a\\tb\" -2 |.)|017)   -}}{{-  1+2i (((2))) (.X) |len 1_000}}{{/* c} */}}{{\tend\t}}{{ ((1))|printf\t}}", 0, "ERR:template: v:5: undefined variable \"$x\"")
  vec("{{$x := 1}}{{range $i, $e := $  }}{{  continue\t}}{{-  end}}-{{- /* c- */}}{{\t0o17}}", 0, "v={{$x := 1}}{{range $i, $e := $}}{{continue}}{{end}}-{{0o17}}")
  vec("{{$x := 1}}{{$y| ($x = . 0o17 | print) len \"a\\tb\"| $x 0x1F index  }}{{- \t017|html 1e9 +3|printf\t}}{{\ttemplate \"b\"\n}}  \n\t", 0, "ERR:template: v:1: undefined variable \"$y\"")
  vec("{{$x := 1}}{{- \t$x := `a\nb`| .X| html\t}}hello {{template \"a\"}}", 0, "v={{$x := 1}}{{$x := `a\nb` | .X | html}}hello {{template \"a\"}}")
  vec("{{\n(len .).Z}}{{\n(((2)))  -}}{{ range $i, $e := \"a\\tb\" (((2))) $  }}{{\n$i\t}}{{\nend\t}}{{\ndefine \"c\"}}{{ with printf '\\x41' | len $.A (.X 2.5i | print -2 0b101 | $x .X. ($x := false | len 1+2i \"str\" | len))\t}}{{'a'\t -}}{{else with len 1_000 (.X)\t -}}<b>{{- \n-1-2i}}{{\tnil }}{{-  end}}{{\nend  }}", 0, "ERR:template: v:6: undefined variable \"$x\"")
  vec("{{$x := 1}}{{- template \"a\" .\n}}{{$z := , }}", 0, "ERR:template: v:2: unexpected \",\" in command")
  vec("{{$x := 1}}{{\tfalse -}}{{ `raw` \"a\\tb\" ($x = (printf `%d` 1) (((2)))|printf|len \"a\\tb\")}}", 1, "v={{$x := 1}}{{false}}{{`raw` \"a\\tb\" ($x = (printf `%d` 1) (((2))) | printf | len \"a\\tb\")}}")
  vec("{{$x := 1}}{{\nrange $i, $e := $x = 1 ! (printf '\\n') |html .  }}{{\n$e}}{{\tend }}line1\nline2{{\n0x1F\n}}{{  if $.A '本' =|$x|print  }}{{nil $ }}{{\n$x := \"str\"|html not html\n}}}{{ end}}", 0, "ERR:template: v:2: unexpected \"=\" in operand")
  vec("{{$x := 1}}{{\t(((2))) len .Field1.Field2| 2.5i| .X  }}", 0, "ERR:template: v:1: non executable command in pipeline stage 2")
  vec("{{- define \"a\"}}{{ range $i, $e := (.X)| len 0x1p-2\t}}{{\tbreak }}{{\nend\n}}{{  end  }}", 0, "a={{range $i, $e := (.X) | len 0x1p-2}}{{break}}{{end}}\nv=")
  vec("{{$x := 1}}{{0o17  }}", 2, "v={{$x := 1}}{{0o17}}")
  vec("{{$x := 1}}{", 0, "v={{$x := 1}}{")
  vec("{{$x := 1}}{{  range $i, $e := html | printf (2.5i (printf `%d` 1) |not $x) \"q\\\"q\" | printf \"ü\" false  }}{{continue  -}}{{\tend   -}}", 0, "v={{$x := 1}}{{range $i, $e := html | printf (2.5i (printf `%d` 1) | not $x) \"q\\\"q\" | printf \"ü\" false}}{{continue}}{{end}}")
  vec("{{\tblock \"a\" 1.5| html index ($x = (((2))) 1_000|not .Field1.Field2 false)   -}}{{\telse}}-ü{{\trange $i, $e := ((.X) | .X) |print\n}}{{continue\t}}{{ end}}{{\tend}}a{{ block \"a\" $x = 'a' +3 $x.B.C  }}{{ with .X.Y not | .X .Field1.Field2 | printf   -}}{ {{{- /* ca */}}{{ $x (len .).Z |not |$x or  -}}{{ else with not ((0x1F false -2.5e3 | `a\nb` | printf 1.5 2.5i) | print) \"ü\"|len\n}}{{((1))  -}}{{ eq\t}}{{ end}}{{ block \"blk\" ((len .).Z '\\x41' $x.B.C) (printf `%d` 1) .X | len -1-2i\t}}{{  template \"a\" .X}}{{  1e9\n}}{{\nend\t}}ü{{ end }}{{- \"ü\"\n}}", 1, "ERR:template: v:1: unexpected {{else}} in block clause")
