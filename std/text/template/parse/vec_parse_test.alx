  vec("{{$x := 1}}{ {{{1_000 (len |($x = 1+2i) $ (0o17) |html ((1))) \"a\\tb\" |not $.A |(((2))) -2 (0x1p-2 $x.B.C \"a\\tb\")\t}}line1\nline2", 2, "ERR:template: v:1: unexpected \"{\" in command")
