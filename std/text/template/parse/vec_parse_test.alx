  vec("{{$x := 1}}{{0x1F 0o17| 017 -2.5e3 .Field1.Field2| printf }}<b>", 1, "ERR:template: v:1: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{  range 'a' |$x (index |.X) (\"q\\\"q\" false (((2))))\n}}{{$z := 0x1F | ($x.B.C .X.Y) | print (printf html | len $x.B.C (+3 printf -2.5e3| not '\\n' false| printf undefinedFn '\\x41')) ((1.5 index|not not)|.X not 'a'|printf)  -}}", 2, "ERR:template: v:2: unexpected EOF")
  vec("{{define \"a\" -}}{{{  0x1p}}{{\n`a\nb`\n}}{{- \nend\n -}}{{{  (-1-2i| (.X).Y| .X ($x = -2 0x1p-2 len | printf $x.B.C '\\u00e9' | printf '\\x41' 1+2i)) '\\n' | $x 1  }}", 0, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{$x := 1}}{{/* c\n */}}", 0, "v={{$x := 1}}")
  vec("{{$x := 1}}{{\nblock \"a\" 0b101 -1-2i |len index `raw` |not printf '\\x41'  }}{{- \t'\\u00e9'\n}}\n{{\nrange $i, $e := 'a'|+3 printf eq}}{{- \n$e\t}}{{end\t}}{{1 |not 1i (. $ '本'| .X '\\n'| not (.X and|print)) |$x 017\t -}}{{\tend\t}}", 0, "ERR:template: v:5: non executable command in pipeline stage 2")
  vec("{{$x := 1}}  \n\t", 0, "v={{$x := 1}}  \n\t")
  vec("{{$x := 1}}{{  html '\\x41' }}{{/* c x  */}}{{\nrange $i, $e := $x = $x 1 | print $.A (.X) | \"unterminated $.A }}{{continue  }}{{  end  }}", 0, "ERR:template: v:2: unexpected \"=\" in operand")
  vec("{{$x := 1}}{{  '本'\n}}{{- \trange $i, $e := (((2))) . +3|printf}}{{\n$e -}}{{ end}}", 1, "v={{$x := 1}}{{'本'}}{{range $i, $e := (((2))) . +3 | printf}}{{$e}}{{end}}")
  vec("{{  (1e9) (.X) -2.5e3 | \"q\\\"q\" false (((2)))\n -}}", 0, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{  define \"b\"}}{{ 2.5i\n}}{{end\t}}", 0, "b={{2.5i}}\nv=")
  vec("{{$x := 1}}{{\ntrue 0x1p-2 `raw`\n -}}", 0, "v={{$x := 1}}{{true 0x1p-2 `raw`}}")
  vec("{{$x := 1}}{{- \trange (((2))) eq ($x = not (printf `%d` 1)| not 1i| .X .X.Y)\t}}<b>{{/* c  \n\t */ -}}{{  with true\t}}{{\n,\t}}{{  end\n}}{{\telse -}}{{\n1_000 }}{{ range (. $x \"q\\\"q\"|-2 -2) 'a' not }}{{/* c  \n\t */ -}}{{- \tend}}{{- define \"c\"\n}}{{  if .X printf html| print `a\nb` (\"q\\\"q\" 1+2i | $x eq | print)| '\\n'\n}}-{{\t0b101 -}}{{ index }}{{\nelse if $x := 0x1p-2| ($x = or) (((2)))\n}}  \n\t{{- \n$z := (`raw` .X.Y| $x| printf and '\\n') eq| \"unterminated 017| $x .X (len $ $x.B.C|len|printf)}}}{{\t'\\n'}}{{ end}}{{  end }}{{\t$x := and 0x1p-2 not\t -}}{{/* ca */}}", 0, "ERR:template: v:3: unexpected \",\" in command")
  vec("{{$x := 1}}{{ `raw`\t -}}-{{\tblock \"a\" 1\n -}}}{{- /* c{ { */}}{{- /* cü */ -}}{{\nend }}{{define \"c\"\t}}{{\t-2  }}{{\nend}}", 2, "a=}\nc={{-2}}\nv={{$x := 1}}{{`raw`}}-{{template \"a\" 1}}")
  vec("{{$x := 1}}{{with (.X).Y | .X +3 $.A\n}}{{ -2   -}}{{/* c{ */}}{{\nelse with $z := and `a\nb` `a\nb`\t}}{{ block \"blk\" $z := (.X).Y 0b101 | $x $  }}-{{\t'\\x41' }} x {{end }}{{ end  }}a", 0, "blk=-{{'\\x41'}} x \nv={{$x := 1}}{{with (.X).Y | .X +3 $.A}}{{-2}}{{else}}{{with $z := and `a\nb` `a\nb`}}{{template \"blk\" $z := (.X).Y 0b101 | $x $}}{{end}}{{end}}a")
  vec("{{$x := 1}}{{\ndefine \"b\" }}{{- \n$x := 1e9| printf  }}{{  break  -}}{{end}}{{\ntemplate \"x y\" $\t}}", 1, "ERR:template: v:3: {{break}} outside {{range}}")
  vec("{{$x := 1}}{{ define \"a\" }}a{{\tend }}{{- /* cline1\nline2 */ -}}{{'a'  }}", 0, "a=a\nv={{$x := 1}}{{'a'}}")
  vec("{{$x := 1}}{{{- /* c{ */ -}}", 0, "ERR:template: v:1: unexpected \"{\" in command")
}

