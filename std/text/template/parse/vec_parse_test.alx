  vec("{{$x := 1}}{{  \"str\"}}{{\n(.X)|`raw` 1|.X (.X)  }}{{- $.A\t}}", 0, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{- /* c */}}{{{false }}{", 1, "ERR:template: v:1: unexpected \"{\" in command")
}
