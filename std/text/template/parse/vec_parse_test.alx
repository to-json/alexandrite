test "parse vectors 25" {
  vec("{{$x := 1}}}{{block \"a\" 0o17 |printf ($x := $x.B.C 0x1F 1i| print 0x1p-2) |(len .).Z -2.5e3 1+2i\n}}{{-  template \"a\"  -}}{{-   template \"a\"}}{{- \nend\n}}{{- nil}}", 0, "a={{template \"a\"}}{{template \"a\"}}\nv={{$x := 1}}}{{template \"a\" 0o17 | printf ($x := $x.B.C 0x1F 1i | print 0x1p-2) | (len .).Z -2.5e3 1+2i}}{{nil}}")
