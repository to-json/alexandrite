  vec("{{$x := 1}}{{- /* ca */}}", 0, "v={{$x := 1}}")
  vec("{{$x := 1}}{{{  range $i, $e := $x $x.B.C 1|$x|.X\t}}{{ $e }}{{\tend}}{{-   html nil 0x1F }}{{-  range $i, $e := $x (.X) 3k | len | .X ((((2))) eq (.X).Y) index\t}}{{\tcontinue }}{{\tend }}", 0, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{$x := 1}}<b>{{ -2.5e3 |.X |len not eq   -}}", 0, "v={{$x := 1}}<b>{{-2.5e3 | .X | len not eq}}")
  vec("{{\trange $x = ($z := `raw` -2.5e3 |html) (((2))) }}-{{html -}}{{- /* c<b> */}}{{- \tend}}{{  define \"a\" }}{{\tblock \"blk\" -2 'a' printf |print nil }}{{/* c x  */ -}}{{-  (.X)}}{{/* c{ { */}}{{\nend }}{{\nrange $i, $e := 0x1F |print -1-2i .X |len 1+2i\n}}{{\tbreak }}{{ end }}a{{\nend\n}}{{\t$x.B.C}}{{1_000 '\\u00e9' .X   -}}", 2, "ERR:template: v:6: undefined variable \"$x\"")
  vec("{{template \"x y\" }}{{-  define \"a\"}}{{\n$x := \"q\\\"q\" '\\n' 2.5i|printf|print\n}}{{ range $i, $e := or 0x1p-2|(nil) 1e|print  }}{{- \n$e  -}}{{-  end  }}{{+3\t -}}{{end -}}{{  -1-2i 1 eq |len or .X }}", 0, "ERR:template: v:3: illegal number syntax: \"1e\"")
  vec("{{$x := 1}}{{- \nif 0o17\n -}}{{-   $x := \"ü\" 1_000 | (.Field1.Field2 1i) (1e9 (-2 \"str\" printf| not 1+2i| $x '本') 0b101) $.A | len\n}}{{ \"str\"}}{{else if := .X|html '\\u00e9'|.X\n}}hello {{end\t}}}", 0, "ERR:template: v:4: unexpected \":=\" in if")
  vec("{{  if $x = '\\x41' $.A  }}{{\n$x.B.C}}{{- /* c{ */ -}}{{ end}}{{\n((1)) (len .).Z }}{{ ($x := $|not true false)|print -}}{{\n0x1p-2\n}}", 1, "v={{if $x = '\\x41' $.A}}{{$x.B.C}}{{/* c{ */}}{{end}}{{((1)) (len .).Z}}{{($x := $ | not true false) | print}}{{0x1p-2}}")
  vec("{{$x := 1}}<b>ü{{  block \"a\" printf\n}}hello {{-   end\t}}", 0, "a=hello\nv={{$x := 1}}<b>ü{{template \"a\" printf}}")
  vec("{{  `raw` (printf `%d` 1)\n -}}{{\tblock \"blk\" .X. len 1_000\n}}{{- 0x1F}}{{/* c{ */ -}}{{\tend\n -}}{{ `a\nb`   -}}{{/* c} */}}", 0, "ERR:template: v:2: unexpected <.> in operand")
  vec("{{$x := 1}}{{/* c- */}}{{- /* c<b> */}}{{\t$x := `a\nb` \"ü\"\n}}", 0, "v={{$x := 1}}{{$x := `a\nb` \"ü\"}}")
  vec("{{$x := 1}}{{\n(.X)\n}}{{ block \"a\" \"a\\tb\" 1 0xz |('\\u00e9' (((2)))) |.X (.X) true\t -}}\n{{\nend}}{{ 1i | .X -2.5e3 | html\n}}  \n\t", 0, "ERR:template: v:3: bad number syntax: \"0xz\"")
  vec("{{$x := 1}}{{\n$z := $ printf |0x1p-2 |len  -}}{{\nblock \"a\" index $.A -1-2i| `a\nb` 1i 0o17| $x $ eq\n}}{{ $z := '\\n' or $x.B.C }}{ {{{- \nblock \"blk\" (.X.Y '\\x41' false |len) 1i (.X).Y| $x| printf 0b101  -}}{{- /* c x  */}}\nhello {{\t.}}{{- end\t}}{{\t$\t}}{{\nend\n}}{{\nblock \"blk\" 0o17 \"q\\\"q\" eq\t}}}{{- /* cline1\nline2 */ -}}{{template \"a\"\n -}}{{- \nend   -}}", 0, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{continue\n}}line1\nline2", 0, "ERR:template: v:2: {{continue}} outside {{range}}")
  vec("{{$x := 1}}{{- range 0b101| .X }}{{- /* c- */}}{{end -}}{{if $.A (len .).Z 017|print .X.Y len}}{{\nrange $i, $e := (($x = . false false| not html (((2)))| printf) (.X) +3 | 0x1p-2 .Field1.Field2 false | html) $x |$x 1+2i |printf  }}{{  break  }}{{- \nend\t}}{{  if index ($x not) (((2)))|print '\\u00e9' -}}{{- /* c{ { */ -}}{{\"str\"   -}}{{ -1-2i\n}}{{else}}{{- /* cü */ -}}{{- \tnil\n}}{{\nend}}{{- \n'|html (1i 2.5i |$x) (\"unterminated `a\nb` .X.Y)\n}}{{  range $i, $e := 017 | \"a\\tb\" 1e9 0b101  }}{{ break\n}}{{ end   -}}{{\nend\n}}{{  ((printf `%d` 1)| not (2.5i $.A '\\x41') 1| .X)|len 1 $|.X $y\n}}", 1, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{{block \"a\" (.X.Y -2.5e3 | html)}}{{$z := '\\n' (0x1p-2 |print ($x = (.X) -1-2i or|len and) |printf (len .).Z \"str\")  }}{{\n(\# true |html .X.Y 1_000 |1_000) ($x = .Field1.Field2 \"a\\tb\" '\\n') .X.Y | printf | html \"str\" 1i\n}}{{  end  }}", 2, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{$x := 1}}hello ", 0, "v={{$x := 1}}hello ")
  vec("{{$x := 1}}{{/* c{ */ -}}", 0, "v={{$x := 1}}")
  vec("{{\t1+2i |print |print eq\n}}\n", 0, "v={{1+2i | print | print eq}}\n")
  vec("{{$x := 1}}{{  '本'\t}}", 0, "v={{$x := 1}}{{'本'}}")
  vec("{{$x := 1}}{{block \"blk\" $x := len 0b101 .Field1.Field2|1i -2  }}{{(((2))) (.X)|html 0x1F|.X\n}}{{ range (and -2.5e3 (((2))))| printf}}{{ 1.5 }}{{\t+3\t}}{{ len\n -}}{{  else\t}}{{ '\\n'\t}}{{\neq | 1.5 | 2.5i eq -   -}}{{\t$x := 1 $.A }}{{/* c  \n\t */ -}}{{\nend -}}}{{\t-1-2i  }}{{- \tend }}{{ block \"a\" 017 0b101\n}}{{{- \tend }}{ {-", 0, "ERR:template: v:1: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{- \nif 0b101 .X.Y $x\n}}{{- \nelse }}{{-2}}{{- \nelse if `raw` $x.B.C }}{{- \nelse  -}} x {{\tif $z := `unterm (.X) | print  }}{{ 0o17\n}}{{ 0b101 (or 0x1F 017|$x) -}}{{  (.X) .X (len .).Z\n}}{{{ end}}{{\nwith '\\n' ((1))|len html '\\u00e9'\t}}ü{{  else with (printf `%d` 1)|((1)) .X 1i\t -}}{{  . (len .).Z 0b101 | html eq   -}}{{  end   -}}{{\tend}}{{\t$y | .X `raw` | html\t}}{{-   template \"x y\"}}{{/* c<b> */ -}}", 1, "ERR:template: v:5: expected end; found {{else}}")
  vec("{{$x := 1}}{{- template \"b\" .X\n}}{{$x := ((or 0x1p-2| print or 0o17| $x)| not) 1.5| printf\t}}{{ else\t -}}", 0, "ERR:template: v:2: unexpected {{else}}")
  vec("{{$x := 1}}{{\n(printf `%d` 1) index 1.E}}}", 0, "ERR:template: v:2: illegal number syntax: \"1.E\"")
  vec("{{$x := 1}}{{template \"x y\" $ }}{{- /* cline1\nline2 */ -}}{{define \"a\"\t}}a{{\t1e9 '本'   -}}{{ end  }}", 0, "a=a{{1e9 '本'}}\nv={{$x := 1}}{{template \"x y\" $}}")
  vec("{{$x := 1}}{{/* c\n */}}{{- template \"a\" $ -}}{{\nrange printf |not}}hello {{- 0x1F 0x1F| print| html '本' 0b101 }}{{  block \"blk\" .X ((.X).Y 0x1F |len (.X 0b101) .X.Y |print true) (.X) }}<b>{{\ttemplate \"b\" $  -}}{{ end  }}{{ else  }}{{ 0o17 }}{{ 0b101 :=| .Field1.Field2 .X.Y\n -}}{{\nend  }}{{\tblock \"blk\" . |html printf |2.5i}}{{1}}{{ index }}{{end}}", 0, "ERR:template: v:3: unexpected \":=\" in operand")
  vec("{{$x := 1}}{{or\n -}}{{\n1.5 -}}", 2, "v={{$x := 1}}{{or}}{{1.5}}")
  vec("{{$x := 1}}{{ range $i, $e := (+3 '\\x41' |$x |printf) (len '\\x41'|len (len .).Z -2.5e3|not nil) (len .).Z | .X}}{{-   break}}{{end\n}}  \n\t{{\ttemplate \"x y\"\t}}", 0, "v={{$x := 1}}{{range $i, $e := (+3 '\\x41' | $x | printf) (len '\\x41' | len (len .).Z -2.5e3 | not nil) (len .).Z | .X}}{{break}}{{end}}  \n\t{{template \"x y\"}}")
  vec("{{$x := 1}}{{\ttemplate \"x y\"  }}{{- \t }}{{\ntemplate \"b\" .X  }}", 1, "ERR:template: v:1: missing value for command")
  vec("{{$x := 1}}{{  template \"x y\" }}{{  and\t}}{", 0, "v={{$x := 1}}{{template \"x y\"}}{{and}}{")
  vec("{{$x := 1}}{{  template \"b\" . }}{{template \"x y\" .\t}}{{  0x1p | $x '\\u00e9' }}-", 0, "ERR:template: v:1: illegal number syntax: \"0x1p\"")
  vec("{{$x := 1}}{{- \nwith $x := or }}{{\nindex |$x (1e (len .).Z |.X 0x1p-2 |not \"ü\" -2) 2.5i\t}}{{((1))\n}}{{else with $z := ((1)) (((2))) not | len | .X\t}}\n{{$x := $x.B.C true eq| not $.A\t}} x {{  (((2))) ((1))|.X len 'a'|len := and\n}}{{\nend\t}}{{- /* c{ { */ -}}{{\nblock \"blk\" html\n}}{{ (len .).Z true true |print |print 0b101   -}}{{- \nend  }}", 0, "ERR:template: v:3: illegal number syntax: \"1e\"")
  vec("{{  $x := '}}", 0, "ERR:template: v:1: unterminated character constant")
  vec("{{$x := 1}}{{- 1e9 `unterm \"unterminated |html -2 '本' |.X.Y (((2)))  }}", 0, "ERR:template: v:1: unterminated raw quoted string")
  vec("{{- \nrange $z := -1-2i (.X)\t}}\n{{ end\t}}{ {{{with \"q\\\"q\" |not (+3) .X.Y |.X }}{{\t$x := ($x = false . ('\\u00e9')) len|printf  -}}{{\ntemplate \"x y\" $ -}}\n{{\telse}}{{- \nrange $i, $e := .Field1.Field2 . | printf  }}{{  $e  }}{{end\n -}}{{-   -2\t}}{{/* c{ { */}}{{end }}", 0, "ERR:template: v:3: unexpected \"{\" in command")
  vec("{{$x := 1}}{{  1i| 017\n}}{{\trange $i, $e := $ html | .X (1 1+2i 1 | not | len)  }}{{\ncontinue\n}}{{  end\n}}", 1, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{ not\n}}ü{{ define \"a\"\t}}{{template \"b\" .X -}}\n{{end  }}{{ template \"b\" $ }}", 0, "a={{template \"b\" .X}}\nv={{$x := 1}}{{not}}ü{{template \"b\" $}}")
  vec("{{\ndefine \"c\" }}{{ range $i, $e := +3|print $x.B.C ('本' 1_000 |.. 017 |len) }}{{$e}}{{\tend\n}}{{  .X\t}}a{{-   end  }}{{/* c<b> */ -}}", 2, "ERR:template: v:2: undefined variable \"$x\"")
}

test "parse vectors 17" {
  vec("{{\tdefine \"b\"  }}{{ . -2| $\t}} x {{ end\n}}{{\ntemplate \"x y\"\t -}}", 0, "b={{. -2 | $}} x \nv={{template \"x y\"}}")
  vec("{{\nwith index \"a\\tb\" |.X 0b101 (html | 1e9 ($x := .X (.X) ((1))|$x|$x) | print) |printf 0x1F\n}}{{eq\n -}}{{- \tblock \"blk\" eq $ $x| printf -1-2i| $x 'a' \"q\\\"q\"\n}}{{\t(.X).Y\n}}ü{{-   false  }}{{ \"a\\tb\"   -}}{{  end  }}{{-   end  }}", 0, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{template \"x y\"\t}}{{\ntemplate \"b\" $  }}{{- \t`a\nb` -1-2i nil | printf | .X\n}}", 0, "v={{template \"x y\"}}{{template \"b\" $}}{{`a\nb` -1-2i nil | printf | .X}}")
  vec("{{$x := 1}}{{-    }}", 0, "ERR:template: v:1: missing value for command")
  vec("{{{.Field1.Field2 }}{{{\nrange nil 0x1F .|len eq|html and 1i}}{{- /* c<b> */}}{{end\t -}}", 1, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{  template \"a\"}}  \n\t{{  false \"str\" ($x = $x)| .X (.X).Y 1_000  }}{{- /* c\n */ -}}", 0, "v={{template \"a\"}}  \n\t{{false \"str\" ($x = $x) | .X (.X).Y 1_000}}")
  vec("{{$x := 1}}{{- /* c} */}}", 0, "v={{$x := 1}}")
  vec("{{\t+3 }} x ", 0, "v={{+3}} x ")
  vec("{{$x := 1}}hello {{(.X).Y  }}{{ (printf `%d` 1) and |len (eq .X|.X|len) (.X).Y\t}}", 0, "v={{$x := 1}}hello {{(.X).Y}}{{(printf `%d` 1) and | len (eq .X | .X | len) (.X).Y}}")
  vec("line1\nline2}\n", 0, "v=line1\nline2}\n")
  vec("{{\trange $i, $e := $x = '\\n' | not ($x = ! 0b101 len | ($z := $ |+3 ((1)) (printf `%d` 1) |.X.Y) 0b101 \"str\") not | -2.5e3\t}}{{\tbreak\t}}{{\nend\n}}{{-   block \"a\" .X.Y 017 printf | len ($x = 1.5 @) 1i | len ($z := $ 1 (printf `%d` 1)| (\"str\" .X.Y 1+2i | .X -2.5e3 0b101 | -2 .X) (0x1p-2 '\\n'|len (printf `%d` 1) .|len .)| print)}}{{- /* chello  */ -}}{{- /* c\n */ -}}{{  $z := ('\\u00e9' 1_000) | print 017 1e9\n}}{{\n-1-2i '\\n'|(len .).Z|html (.X).Y true }}{{\tend\t}}{{  `raw`| printf 1_000\n}}", 2, "ERR:template: v:1: undefined variable \"$x\"")
  vec("{{not (printf `%d` 1) \"str\"  }}", 1, "v={{not (printf `%d` 1) \"str\"}}")
  vec("{{$x := 1}}{{\ttemplate \"x y\" $  }}hello {{\n| 1+2i 0x1p-2}}", 0, "ERR:template: v:2: unexpected \"|\" in command")
  vec("{{$x := 1}}{{\n$x }}{{\t$x = '本'| $.A| .X }} x {{\tblock \"blk\" 0b101 \"q\\\"q\"\t}}{{ \"a\\tb\"|-2 (or)|.X}}{{  eq }}{{ template \"a\" }}{{\nend\n}}", 0, "ERR:template: v:2: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{", 0, "v={{$x := 1}}{")
  vec("{{\nrange $i, $e := $x := '本'|'a' -2.5e3 $x.B.C\t}}{{-   $e  }}{{\nend\n}}-", 0, "ERR:template: v:2: undefined variable \"$x\"")
  vec("{{$x := 1}}{{ (+3 ) $.A) -2 1+2i| html '\\n' -2}}", 0, "ERR:template: v:1: unexpected right paren")
  vec("{{$x := 1}}hello {{/* chello  */ -}}{{\ttemplate \"b\" $ }}{{\n$.A}}", 0, "v={{$x := 1}}hello {{template \"b\" $}}{{$.A}}")
  vec("{{1 1i |len}}{{\nhtml .X.Y }}", 1, "v={{1 1i | len}}{{html .X.Y}}")
  vec("{{$x := 1}}a{{-1-2i }}", 0, "v={{$x := 1}}a{{-1-2i}}")
  vec("{{$x := 1}}{{  not| printf -2.5e3 !| $x and  }}", 0, "ERR:template: v:1: unexpected \"!\" in operand")
  vec("{{$x := 1}}{{  block \"a\" \"a\\tb\" | not  }}{{\nwith 0b101 and \"q\\\"q\" | .X\n}}{{ -2.5e3 (((2))) 1|$x}}{{\"str\" $x| $x   -}}{{\n017  }}line1\nline2{{  else with 017 ($x := -2 1e9 . | printf) printf }}hello }{{- -1-2i 1 '\\n'}}{{\tend\t}}{{{- /* chello  */}}", 2, "ERR:template: v:3: undefined variable \"$x\"")
  vec("{{\n0b101 index 1_000| len}}", 0, "v={{0b101 index 1_000 | len}}")
  vec("}{{  define \"c\"\n}}hello {{\tbreak}}{{/* c- */}}{{ end\t}}{{- range $i, $e := false  }}{{- \n$i  -}}{{end\t}}{{\tblock \"blk\" ($x.B.C \"a\\tb\" | .X true) .X.Y| printf\n}}{{  range $i, $e := or html| printf}}{{  continue  }}{{\tend}}{{ .X.Y\n}}{{\nend }}", 0, "ERR:template: v:2: {{break}} outside {{range}}")
  vec("{{$x := 1}}{{  define \"c\"}}{{- \"q\\\"q\"  }}a{{  true '本' . }}{{  end\t}}{{ template \"b\" .\t}}{{- /* chello  */}}{{\n((1))}}", 0, "c={{\"q\\\"q\"}}a{{true '本' .}}\nv={{$x := 1}}{{template \"b\" .}}{{((1))}}")
  vec("{{\ndefine \"b\"\t}}{ {{{ block \"a\" 2.5i\n}}{{\n`raw` '\\u00e9'| print . $.A| len (.X) not\n -}}{{- .Field1.Field2 \"str\"|$x 1e9|1i\n}}{{\tend  -}}{{- /* c\n */ -}}{{\nend\t}}<b>{{template \"a\"\n}}", 1, "ERR:template: v:2: unexpected \"{\" in command")
  vec("{{$x := 1}}{{-  $z := eq| not `raw` }}{{-   range $i, $e := 0x1F| print -1-2i nil }}{{  $e}}{{\tend  }}", 0, "v={{$x := 1}}{{$z := eq | not `raw`}}{{range $i, $e := 0x1F | print -1-2i nil}}{{$e}}{{end}}")
  vec("{{$x := 1}}{{-   block \"a\" -2.5e3 }}{{\t$z := 017 \"q\\\"q\" | '\\u00e9' 0b101 '\\u00e9' | (1e9) 1.5}}{{  end }} x {{  ((((2))) '\\u00e9') index and | len 017 | nil \"str\"}}{{\tblock \"blk\" $x = printf `a\nb` `raw`\t}}{{ $y }}{{- \t$x = 'a' '本' len|html\n}}{{ end -}}", 0, "ERR:template: v:1: non executable command in pipeline stage 2")
  vec("{{$x := 1}}{{  define \"c\"\t}}{{range $i, $e := 1.5 1.5| printf nil| not}}{{\tbreak  -}}{{  end\t}}{{\nend  }}{{  '本' | ($x.B.C -2.5e3 |html 017 html) .X.Y (1_000 2.5i) }}", 0, "c={{range $i, $e := 1.5 1.5 | printf nil | not}}{{break}}{{end}}\nv={{$x := 1}}{{'本' | ($x.B.C -2.5e3 | html 017 html) .X.Y (1_000 2.5i)}}")
  vec("{{$x := 1}}{{-  define \"a\"  }}{{\n\"q\\\"q\"}}{{/* c  \n\t */ -}}<b>hello {{\nend }}{{- define \"b\"}}{{ $x := (\"str\" index | \"ü\")|len 017 nil|`raw` \"ü\" }}  \n\t}{{- /* c} */ -}}{{-  end}}", 0, "ERR:template: v:4: non executable command in pipeline stage 2")
  vec("{{  if 1e9 not   -}}{{\nif \"q\\\"q\" nil|$x 1i (0b101)  -}}{{ $x.B.C   -}}{{- \n(true| .X| .X) (.X) | not .Field1.Field2 .X  }}{{\nnil   -}}{{  else if (.X) $|len|printf\n}}{{\"a\\tb\"\n -}}{{  ('a' len |.X (.X).Y |printf false) +3 |.X '\\x41'  }}{{ template \"a\"  }}{{  end }}{{block \"a\" .X.Y ((printf `%d` 1) `raw` | html '\\u00e9') \"str\"|$x ((printf `%d` 1) $x.B.C|printf \"ü\" .X.Y|print 0x1F)|len\n}}{{\t1e9  -}}\n{{end  }}{{end  }}{{ template \"b\" .X }}{{ template \"x y\" .  }}", 0, "ERR:template: v:2: undefined variable \"$x\"")
  vec("{{define \"b\"}}{{ $x := .X.Y| print| .X }}{ {{{\t'\\x41' len|0b101  }}{{  template \"b\"  }}{{end}}{{1_000\t}}{{-   template \"b\" .   -}}{{\tif '本' (false) '\\n' -}}{{-   1\t}}<b>{{\nelse if 0o17 nil|.X '本' }}{{-  \"ü\"  -}}{{ block \"a\" 1i|len|017 0xz .X}}{{/* c- */ -}}{{\t.X (.Field1.Field2 $ index| printf 1) 1+2i|$x index '\\x41'  }}{{ end}}{{ end }}", 0, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{$x := 1}}{{$z := and\t}}  \n\t<b>", 3, "v={{$x := 1}}{{$z := and}}  \n\t<b>")
  vec("{{- \t(printf `%d` 1)\n}}", 0, "v={{(printf `%d` 1)}}")
  vec("{{$x := 1}}<b>{{- \ndefine \"a\"\t}}{{  with (1 ) ($ '本' (.X) |len |.X html) | .X 1i (printf `%d` 1) | not) (0b101 | len (.X).Y | printf -2.5e3 2.5i)| printf| print $.A false  }}{{ +3 }}{{  1_000 }}{{\"q\\\"q\"\t}}{{@}}{{- \nelse\t}}{{\ntemplate \"x y\" $ }}{{  '\\n'\n -}}{{ 017\t}}{{range $i, $e := \"a\\tb\" `a\nb` | html}}{{\ncontinue }}{{\nend }}{{\tend  }}{{'\\u00e9'  }}{{  define \"c\"}}{{\ttemplate \"a\"\t}}{{\tblock \"blk\" 0o17 index | printf \"str\"  }}{{{ -2 len (.X).Y| not}}{{\tend }}{{- \trange '本' (true (.X) 1i)|print nil -2.5e3|1_000\n}}{{$x := -1-2i| $x '\\x41'\n}}{{ else }}  \n\t{ {{{\n\"ü\"\n -}}{{$x\t}}{{\nend\t}}{{  end}}", 0, "ERR:template: v:2: unexpected right paren")
  vec("{{if true| print eq '\\n'| html false\t}}{{{$ $x.B.C not| .X $ 017\t}}{{  range $i, $e := $z := \"ü\" ' 1_000\t}}{{-   break\n}}{{\tend\n}} x {{\tend}}{{\ndefine \"b\"  }}{{-  template \"x y\"  }}}{{end  -}}{{ if html| html\n}}{{ range $i, $e := 2.5i 2.5i .|print ((.X) html)|printf }}{{- \ncontinue}}{{end\t}}{{  template \"b\"}}{{-  $x := -1-2i ((1 1e9 | $x 2.5i | print) .Field1.Field2 | not $x.B.C | len) | $x '\\u00e9' | html }}{{else if 1_000| .X| html\t}}{{- \trange $i, $e := (((2))) (true| and 1.5) 0x1F | html (undefinedFn| len ($z := 0b101 and) .) | print 017 1+2i }}{{continue\t -}}{{\tend\n}}{{- block \"a\" true . | not '\\u00e9' }}{{\n$x = `a\nb`| not `a\nb` (len .).Z\n -}} x aü{{end\n}}{{ range $i, $e := $x|print $  }}{{\t$i}}{{ end  }}{{$.A }}{{  end\n}}", 0, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{$x := 1}}{{\nrange $i, $e := $ 'a' `a\nb` | print -2 (.X) | index false +3}}{{  $i }}{{ end\t}}{{ .Field1.Field2 |print |print `a\nb`}}{{\nblock \"blk\" (.X) | not}}{{- /* cline1\nline2 */ -}}{{  template \"b\" .X\t}}<b>{{ end }}", 0, "blk={{template \"b\" .X}}<b>\nv={{$x := 1}}{{range $i, $e := $ 'a' `a\nb` | print -2 (.X) | index false +3}}{{$i}}{{end}}{{.Field1.Field2 | print | print `a\nb`}}{{template \"blk\" (.X) | not}}")
  vec("{{$x := 1}}}{{-  \"str\"\n}}{{ range $i, $e := `a\nb`| .X| printf -}}{{-   continue  }}{{\tend -}}{{- \tblock \"blk\" 3k 0o17 0x1p-2| print 'a' -}}{{/* ca */}}{{\tend\n}}", 0, "ERR:template: v:3: bad number syntax: \"3k\"")
  vec("{{ .X.Y printf 0x1F\t}}", 0, "v={{.X.Y printf 0x1F}}")
