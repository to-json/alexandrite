  vec("{{-  1_000\t}}{{\n1_000 1e9 (.X).Y| (.X)}}{ {{{-  template \"b\" -}}", 0, "ERR:template: v:2: unexpected \"{\" in command")
  vec("{{ template \"b\" .X}}{{-  nil}}{{\n\"str\"\n}}", 0, "v={{template \"b\" .X}}{{nil}}{{\"str\"}}")
