}

test "parse vectors 15" {
  vec("{{range $i, $e := ($x = (len .).Z|html) \"q\\\"q\" |not .X 0o17 |.X}}{{- $e}}{{\tend  }}", 0, "v={{range $i, $e := ($x = (len .).Z | html) \"q\\\"q\" | not .X 0o17 | .X}}{{$e}}{{end}}")
  vec("{{  template \"x y\" }}{{  .X \"ü\"\t -}}}", 3, "v={{template \"x y\"}}{{.X \"ü\"}}}")
  vec("{{$x := 1}}-", 0, "v={{$x := 1}}-")
  vec("{{$x := 1}}{{'a'}}{{  range (len .).Z 1+2i}}{{ 0x1p-2 -}}{{block \"a\" -1-2i| print . .Field1.Field2\t}}{{\ntemplate \"b\" .   -}}{{  (len .).Z\t}}{{ end\t -}}{{  range `unterm\t}}<b>{{ template \"b\" }}{{  end  -}}hello {{end\n}}", 0, "ERR:template: v:2: unterminated raw quoted string")
  vec("{{$x := 1}} x {{-  false -}}{{  (len .).Z 1_000| html\t}}", 0, "v={{$x := 1}} x{{false}}{{(len .).Z 1_000 | html}}")
  vec("{{$x := 1}}{{  define \"c\"}}  \n\t{{\t$x := ($z := 0b101 -2.5e3 \"ü\" | print .X.Y 'a' | html 0b101 1_000) |print \"ü\" + |$x $y and }}ü{{- end\t}}{{block \"a\" (html 2.5i (.X).Y |-1-2i $x) not eq | len 0x1p-2 $.A }}{{ .X index .X.Y|.X or\t}}{{template \"a\" .X}}{{  .Field1.Field2 }}{{ end\n -}}{{  define \"a\"\t}}{{- \t. 1| -1-2i ((1))| $x '\\u00e9'  -}}{{{  template \"x y\"}}{ {{{end\n}}", 0, "ERR:template: v:2: illegal number syntax: \"+\"")
