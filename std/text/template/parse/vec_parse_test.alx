  vec("{{\nwith 1_000 not| len 1i}}{{\n-2.5e3\n}}{{\ntemplate \"b\" $\n}}{{\tend\t}} x {{template \"x y\" .X\t -}}", 0, "v={{with 1_000 not | len 1i}}{{-2.5e3}}{{template \"b\" $}}{{end}} x {{template \"x y\" .X}}")
