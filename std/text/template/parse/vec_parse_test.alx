  vec("{{\trange $i, $e := '\\n' false }}{{\n$e\n}}{{ end }}", 0, "v={{range $i, $e := '\\n' false}}{{$e}}{{end}}")
  vec("{{$x := 1}}{{  if 0o17 | (.X) (0x1p-2 'a' 017)\t}}-{{ template \"x y\" .X\t}}{{\nelse if $z := $.A | \"q\\\"q\"\n}}{{\nblock \"a\" $z := -2 ((-2.5e3 \"q\\\"q\" not | .X $.A | $x .X 0b101) |html or html |html (or \"a\\tb\" |'\\n' |html \"a\\tb\"))| 1.5| not}}{{ 0x1F }}{ {{{\n\"ü\"  }}{{\tend }}{{ -2 }}{{\t$x -}}{{ template \"b\" .X\n}}{{ end }}{{- '\\x41' $.A|($x := (len .).Z) . .}}{{\n1+2i }}", 0, "ERR:template: v:3: non executable command in pipeline stage 2")
  vec("{{$x := 1}}<b>{{/* cü */ -}}", 0, "v={{$x := 1}}<b>")
  vec("{{$x := 1}}{{define \"c\"\t}}{{  0o17\t}}{{  len}}{{\tend }}{{\ntemplate \"a\" .X }}{{ template \"b\" $\t}}", 0, "c={{0o17}}{{len}}\nv={{$x := 1}}{{template \"a\" .X}}{{template \"b\" $}}")
  vec("{{$x := 1}}{{ .X|(len .).Z ($x.B.C (.X))|print and\n}}{{ -2.5e3\n}}{{- range .X.Y\n}}{{if (false ((1)) | . 0x1p-2 | $x (1+2i false| len (.X).Y| print \"a\\tb\" 2.5i) 1e) \"a\\tb\" 1+2i |eq $x (.X).Y |html}} x {{- template \"a\"  }}{{/* cline1\nline2 */ -}}{{\t($z := `a\nb` \"ü\"| print| printf) 0x1p-2 | $x}}{{ end  }}{{ end\t}}", 1, "ERR:template: v:4: illegal number syntax: \"1e\"")
  vec("{{  range $i, $e := .X.Y `raw` `raw`|len\t}}{{- break}}{{- \nend}}{", 0, "v={{range $i, $e := .X.Y `raw` `raw` | len}}{{break}}{{end}}{")
