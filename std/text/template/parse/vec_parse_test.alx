  vec("{{{ ((((2))) -2.5e3 2.5i) (((2))) | $x (true .X.Y $x.B.C |$x |len) not | .X $.A  }}{{-   define \"c\"\t -}}{{\tlen\t}}ü{{\n$x   -}}{{\tend\n}}", 0, "ERR:template: v:1: unexpected \"{\" in command")
  vec("{{$x := 1}}hello ", 0, "v={{$x := 1}}hello ")
  vec("{{  .Field1.Field2 = |.X .Field1.Field2 $}}", 0, "ERR:template: v:1: unexpected \"=\" in operand")
  vec("line1\nline2{{  continue}}{{\ndefine \"b\"\t -}} x {{  end  }}", 0, "ERR:template: v:2: {{continue}} outside {{range}}")
