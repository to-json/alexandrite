# Issue 10910, 10926
test "template look up" {
  t1 = new("foo")
  assert t1.lookup("foo") == none, "Lookup returned non-nil value for undefined template foo"
  t1.new("bar")
  assert t1.lookup("bar") == none, "Lookup returned non-nil value for undefined template bar"
  _u11 = t1.parse("{{define \"foo\"}}test{{end}}")
  assert t1.lookup("foo") != none, "Lookup returned nil value for defined template"
}

test "new" {
  # template with same name already exists
  t1 = new("test").~parse("{{define \"test\"}}foo{{end}}")
  t2 = t1.new("test")
  assert t1.tree != none, "defined template got nil Tree"
  assert t2.tree == none, "undefined template got non-nil Tree"
  contains_t1 = false
  for tmpl in t1.templates {
    assert !tmpl.same?(t2), "Templates included undefined template"
    contains_t1 = true if tmpl.same?(t1)
  }
  assert contains_t1, "Templates didn't include defined template"
}

test "parse" {
  # In multiple calls to Parse with the same receiver template, only one
  # call can contain text other than space, comments, and template
  # definitions
  t1 = new("test")
  _u12 = t1.~parse("{{define \"test\"}}{{end}}")
  _u13 = t1.~parse("{{define \"test\"}}{{/* this is a comment */}}{{end}}")
  _u14 = t1.~parse("{{define \"test\"}}foo{{end}}")
}

test "empty template" {
  cases = [
    (["x", "y"], "", "y"),
    ([""], "once", ""),
    (["", ""], "twice", ""),
    (["{{.}}", "{{.}}"], "twice", "twice"),
    (["{{/* a comment */}}", "{{/* a comment */}}"], "comment", ""),
    (["{{.}}", ""], "twice", ""),
  ]
  for c in cases {
    root = new("root")
    m = root
    for d in c[0] {
      m = root.new(c[1]).~parse(d)
    }
    assert_eq m.~execute_str(sv(c[1])), c[2]
  }
}

# Issue 19249 was a regression in 1.8 caused by the handling of empty
# templates added in that release, which got different answers depending
# on the order templates appeared in the internal map.
test "issue 19294" {
  inlined: Map[Str, Str] = {
    "stylesheet" => "{{define \"stylesheet\"}}stylesheet{{end}}",
    "xhtml" => "{{block \"stylesheet\" .}}{{end}}",
  }
  all = ["stylesheet", "xhtml"]
  i = 0
  while i < 100 {
    res = new("title.xhtml").~parse("{{template \"xhtml\" .}}")
    for name in all {
      _u15 = res.new(name).~parse(inlined[name].unwrap)
    }
    assert_eq res.~execute_str(iv(0)), "stylesheet"
    i += 1
  }
}

# Issue 48436 (the zero Template can't be changed in place in alx: adding a
# tree to it gives a new template set holding the tree).
test "add to zero template" {
  tree = ~parse.parse("c", CLONE_TEXT3, "", "", [builtin_names()])
  tmpl = Template.new
  t = tmpl.~add_parse_tree("x", tree["c"].unwrap)
  assert_eq t.~execute_str(iv(0)), "root"
}

# Values read through interface {} (range elements and map entries of JSON
# data) are reported as "interface {}", as Go's reflect.Value of Kind
# Interface is; a pipeline's result is the value inside. (Outputs from Go.)
test "interface typed errors" {
  d = Value.from_json(json.parse("{\"obj\":{\"x\":1,\"z\":[1,{\"k\":\"v\"}]},\"m\":{\"a\":{\"b\":2}}}").unwrap)
  cases = [
    ("{{.obj.x.y}}", "", "template: t:1:6: executing \"t\" at <.obj.x.y>: can't evaluate field y in type interface {}"),
    ("{{range .obj.z}}{{.k}}{{end}}", "", "template: t:1:18: executing \"t\" at <.k>: can't evaluate field k in type interface {}"),
    ("{{range $i, $e := .obj.z}}{{$e.k}}{{end}}", "", "template: t:1:30: executing \"t\" at <$e.k>: can't evaluate field k in type interface {}"),
    ("{{with .obj.x}}{{.y}}{{end}}", "", "template: t:1:17: executing \"t\" at <.y>: can't evaluate field y in type float64"),
    ("{{$v := .obj.x}}{{$v.y}}", "", "template: t:1:20: executing \"t\" at <$v.y>: can't evaluate field y in type float64"),
    ("{{.m.a.b}}{{.m.a.c}}", "2<no value>", ""),
    ("{{range .m}}{{.b}}{{.q.r}}{{end}}", "2<no value>", ""),
  ]
  for c in cases {
    b = bytes.new_buffer([])
    r = must(new("t").parse(c[0])).execute(b, d)
    assert_eq b.string, c[1]
    assert_eq r.err?.message || "", c[2]
  }
}
