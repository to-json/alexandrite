  vec(dt, "{{printf \"%x %[2]v %[1]v %10s| \" 'c' .f32 'c'}}{{not .i8}}{{printf \"%*d % x %z \" .nest.m.k .msi.two .msi.four}}", "63 0.1 99 %!s(float32=       0.1)| false%!(BADWIDTH)2 %!x(<nil>) %!z(MISSING) ")
  vec(dj, "{{urlquery (len .tags) $}}{{gt (index .nums 0) 1e3}}{{$v := .}}[{{$v}}]", "3+map%5Bage%3A30+big%3A1e%2B21+empty%3A%5B%5D+flag%3Atrue+name%3AAnn+names%3Amap%5Ba%3AA+b%3AB+c%3A%5D+neg%3A-2+no%3Afalse+nul%3A%3Cnil%3E+nums%3A%5B3+1+2%5D+obj%3Amap%5Bw%3Awide+x%3A1+y%3A%3Cnil%3E+z%3A%5B1+2+map%5Bk%3Av%5D%5D%5D+pi%3A3.14159+s%3A%3Cb%3E%26%27%22x%22%3C%2Fb%3E+%3D+tags%3A%5Ba+b+c%5D+tiny%3A1.5e-07+uni%3Ah%C3%A9llo%2C+%E4%B8%96%E7%95%8C+zero%3A0%5Dfalse[map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]]")
