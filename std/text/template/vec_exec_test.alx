  vec(dt, "{{index .si .r}}", "|ERR|template: v:1:2: executing \"v\" at <index .si .r>: error calling index: index out of range: 120")
  vec(dj, "{{or .no (index .tags 1)}}", "b")
  vec(dt, "{{len .st}}{{.i | printf \"%q\"}}", "|ERR|template: v:1:2: executing \"v\" at <len .st>: error calling len: len of type template.vecSt")
  vec(dj, "{{not (printf \"%03d\" 7)}} - ", "false - ")
  vec(dt, "{{html 0 nil}}", "0&lt;no value&gt;")
