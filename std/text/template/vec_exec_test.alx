  vec(dt, "{{ne 1i .ss}}{{.np}}", "|ERR|template: v:1:2: executing \"v\" at <ne 1i .ss>: error calling ne: incompatible types for comparison: complex128 and []string")
  vec(dj, "{{/* c */}}", "")
  vec(dt, "{{range $i, $e := (index .si 1)}}{{$i}}={{continue}};{{else}}none{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" -3}}", "|ERR|template: v:1:29: executing \"v\" at <1>: can't use 10 to iterate over more than one variable")
  vec(dj, "{{index .flag}}{{index \"str\" (.obj.z)}}{{gt .tiny \"\"}}", "true|ERR|template: v:1:17: executing \"v\" at <index \"str\" (.obj.z)>: error calling index: cannot index slice/array with type []interface {}")
}

test "exec vectors 20" {
  dj = vec_json()
  dt = vec_typed()
  vec(dt, "{{ne .st.C nil}}{{range $i, $e := 0x1F}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{true}}", "true|ERR|template: v:1:34: executing \"v\" at <0x1F>: can't use 31 to iterate over more than one variable")
  vec(dj, "{{.obj.x | len}}{{if .age}}T{{.no}}{{else}}F{{end}}", "|ERR|template: v:1:11: executing \"v\" at <len>: error calling len: len of type float64")
