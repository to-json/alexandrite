  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .s}}{{printf \"%g % %*d \" (index .obj.z 2) .obj.missing .pi}}{{index .obj.x}}", "<<b>&'\"x\"</b> =>map[%!g(string=k):%!g(string=v)] %*d %!(EXTRA <nil>, float64=3.14159)1")
  vec(dt, "{{printf \"%.*f %-5d| \" .nest false}}", "%!(BADPREC)%!f(bool=false) %!d(MISSING)| ")
