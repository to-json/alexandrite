  vec(dt, "{{printf \"%g %p %\#o \" 0x1F (index .msi \"one\") .si}}{{.nest.list}}{{le .s .i}}", "%!g(int=31) %!p(int=1) [05 012 017] [1 two 3 <nil> true]|ERR|template: v:1:67: executing \"v\" at <le .s .i>: error calling le: incompatible types for comparison: string and int")
  vec(dj, "text {{lt 1i .nul}}", "text |ERR|template: v:1:7: executing \"v\" at <lt 1i .nul>: error calling lt: invalid type for comparison")
  vec(dt, "{{$v := .msi.four}}[{{$v}}]{{ge .mfb .sts}}", "[<no value>]|ERR|template: v:1:29: executing \"v\" at <ge .mfb .sts>: error calling ge: invalid type for comparison")
}

test "exec vectors 1" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{lt (len .tags) .no}}", "|ERR|template: v:1:2: executing \"v\" at <lt (len .tags) .no>: error calling lt: incompatible types for comparison: int and bool")
  vec(dt, "{{with (slice .si 1 2)}}<{{index (index .sts 0)}}>{{else}}E{{end}}", "<|ERR|template: v:1:40: executing \"v\" at <.sts>: can't evaluate field sts in type []int")
  vec(dj, "{{$v := .age}}[{{$v}}]", "[30]")
  vec(dt, "{{.missing}}{{.nm | len}}", "<no value>0")
  vec(dj, "{{printf \"%x %5.2f %v \" 1i .obj.missing .zero}}", "(0x0p+00+0x1p+00i) %!f(<nil>) 0 ")
  vec(dt, "{{'c' | len}}", "|ERR|template: v:1:8: executing \"v\" at <len>: error calling len: len of type int")
  vec(dj, "{{printf \"%O % d % \" (index .obj.z 2) .obj.y 1}}{{not .tags}}{{slice 2.5 1}}", "map[%!O(string=k):%!O(string=v)] %!d(<nil>) %!(NOVERB)%!(EXTRA int=1)false|ERR|template: v:1:63: executing \"v\" at <slice 2.5 1>: error calling slice: can't slice item of type float64")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"str\"}}{{range $i, $e := .i8}}{{$i}}={{continue}};{{else}}none{{end}}{{(slice .si 1 2)}}", "<str>|ERR|template: v:1:70: executing \"v\" at <.i8>: can't use -7 to iterate over more than one variable")
  vec(dj, "{{printf \"% \" 1i}}", "%!(NOVERB)%!(EXTRA complex128=(0+1i))")
  vec(dt, "{{0 | not}}", "true")
  vec(dj, "{{printf \"%\#q %*d \" nil .nul}}", "%!q(<nil>) %!(BADWIDTH)%!d(MISSING) ")
  vec(dt, "{{urlquery .f 'c'}}", "2.5+99")
  vec(dj, "{{with .nums}}<{{not 0x1F}}>{{else}}E{{end}}{{range $i, $e := .obj}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "<false>w=+")
  vec(dt, "{{le (index .mis 2) 1i}}", "|ERR|template: v:1:2: executing \"v\" at <le (index .mis 2) 1i>: error calling le: incompatible types for comparison: string and complex128")
  vec(dj, "{{with (index .obj.z 2)}}<{{range $i, $e := .big}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}>{{else}}E{{end}}{{with \"\"}}<{{not 1i}}>{{else}}E{{end}}{{if .obj}}T{{printf \"% d \" 1}}{{else}}F{{end}}", "<none>ET 1 ")
  vec(dt, "{{printf \"%q \" .st}}{{not 0}}{{or .u16 .nest}}", "{'\\x01' \"bee\" ['\\x04']} true65535")
  vec(dj, "{{.s}}{{1}}", "<b>&'\"x\"</b> =1")
  vec(dt, "{{js .neg false}}", "-17 false")
  vec(dj, "{{printf \"%! %\#U \" $ true}}{{eq nil nil}}", "map[%!!(string=age):%!!(float64=30) %!!(string=big):%!!(float64=1e+21) %!!(string=empty):[] %!!(string=flag):%!!(bool=true) %!!(string=name):%!!(string=Ann) %!!(string=names):map[%!!(string=a):%!!(string=A) %!!(string=b):%!!(string=B) %!!(string=c):%!!(string=)] %!!(string=neg):%!!(float64=-2) %!!(string=no):%!!(bool=false) %!!(string=nul):<nil> %!!(string=nums):[%!!(float64=3) %!!(float64=1) %!!(float64=2)] %!!(string=obj):map[%!!(string=w):%!!(string=wide) %!!(string=x):%!!(float64=1) %!!(string=y):<nil> %!!(string=z):[%!!(float64=1) %!!(float64=2) map[%!!(string=k):%!!(string=v)]]] %!!(string=pi):%!!(float64=3.14159) %!!(string=s):%!!(string=<b>&'\"x\"</b> =) %!!(string=tags):[%!!(string=a) %!!(string=b) %!!(string=c)] %!!(string=tiny):%!!(float64=1.5e-07) %!!(string=uni):%!!(string=héllo, 世界) %!!(string=zero):%!!(float64=0)] %!U(bool=true) true")
  vec(dt, "{{(len .si)}}", "3")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (printf \"%03d\" 7)}}{{if (index .tags 1)}}T{{if (index .nums 0)}}T{{printf \"%f \" (.obj.z)}}{{else}}F{{end}}{{else}}F{{end}}{{with .names}}<{{with \"str\"}}<{{print .nums (printf \"%03d\" 7)}}>{{else}}E{{end}}>{{else}}E{{end}}", "<007>TT[1.000000 2.000000 map[%!f(string=k):%!f(string=v)]] <<|ERR|template: v:1:206: executing \"v\" at <.nums>: can't evaluate field nums in type string")
  vec(dt, "{{print (slice .si 1 2) .st}}{{with .u64}}<{{.si | not}}>{{else}}E{{end}}", "[10] {1 bee [4]}<|ERR|template: v:1:45: executing \"v\" at <.si>: can't evaluate field si in type uint64")
  vec(dj, "{{and 0x1F .tiny}}{{gt nil (len .tags)}}", "1.5e-07|ERR|template: v:1:20: executing \"v\" at <gt nil (len .tags)>: error calling gt: invalid type for comparison")
  vec(dt, "{{with .sts}}<{{not true}}>{{else}}E{{end}}{{not .si}}", "<false>false")
  vec(dj, "{{/* c */}}", "")
  vec(dt, "{{(index .sts 0) | printf \"%q\"}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" -3}}", "{'\\x02' \"\" []}<-3>")
  vec(dj, "{{or .zero .tiny}}{{range $i, $e := 'c'}}{{$i}}={{.}};{{else}}none{{end}}", "1.5e-07|ERR|template: v:1:36: executing \"v\" at <'c'>: can't use 99 to iterate over more than one variable")
  vec(dt, "{{ge .si 1}}{{$v := 2.5}}[{{$v}}]{{not .i8}}", "|ERR|template: v:1:2: executing \"v\" at <ge .si 1>: error calling ge: invalid type for comparison")
  vec(dj, "{{(printf \"%03d\" 7)}}{{and .names.a 1}}{{urlquery 'c' .missing}}", "007199%3Cno+value%3E")
  vec(dt, "{{print .i8 .sts}}{{range $i, $e := 1i}}{{$i}}={{$e}};{{else}}none{{end}}", "-7 [{2  []} {0 b []}]|ERR|template: v:1:36: executing \"v\" at <1i>: range can't iterate over (0+1i)")
  vec(dj, "{{printf \"%c %q \" .obj.w .flag}}{{slice .nul 0}}", "%!c(string=wide) %!q(bool=true) |ERR|template: v:1:34: executing \"v\" at <slice .nul 0>: error calling slice: slice of untyped nil")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .i}}{{not .si}}", "<42>false")
  vec(dj, "{{not false}}", "true")
  vec(dt, "{{if .e}}T{{ne .mfb .st.A}}{{else}}F{{end}}{{or .missing .nest.m.k}}", "F[7 8]")
  vec(dj, "{{printf \"%! \" .pi}}text {{print (slice .tags 1) .obj.x}}", "%!!(float64=3.14159) text [b c] 1")
  vec(dt, "{{not .t}}{{with .nest.m.k}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .mfb}}>{{else}}E{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dj, "{{if 0}}T{{printf \"%-5d| %\#q \" . 1e3}}{{else}}F{{end}}{{not \"\"}}{{html .obj.x .obj}}", "Ftrue1 map[w:wide x:1 y:&lt;nil&gt; z:[1 2 map[k:v]]]")
  vec(dt, "{{ge nil (slice .s 1 4)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .f32}}", "|ERR|template: v:1:2: executing \"v\" at <ge nil (slice .s 1 4)>: error calling ge: invalid type for comparison")
  vec(dj, "{{and .obj.w 1}}{{if \"\"}}T{{gt (len .tags) .obj.y}}{{else}}F{{end}}{{with (index .obj.z 2)}}<{{.no}}>{{else}}E{{end}}", "1F<<no value>>")
  vec(dt, "{{.nest.list}}", "[1 two 3 <nil> true]")
  vec(dj, " - ", " - ")
  vec(dt, "{{printf \"%d %F %x \" 0x1F (index .mis 2) .msi}}", "31 %!F(string=b) map[6f6e65:1 7468726565:3 74776f:2] ")
  vec(dj, "{{slice (printf \"%03d\" 7) 0}}{{if .obj.missing}}T{{. | len}}{{else}}F{{end}}{{with .missing}}<{{printf \"%\#q %8.3e \" 0 .empty}}>{{else}}E{{end}}", "007FE")
  vec(dt, "{{$v := .st.B}}[{{$v}}]", "[bee]")
  vec(dj, "{{.names.a}}{{printf \"% \" .tiny}}", "A%!(NOVERB)%!(EXTRA float64=1.5e-07)")
  vec(dt, "{{printf \"%d \" (index .mis 2)}}{{printf \"%t %d \" .f32 (index .mis 2)}}", "%!d(string=b) %!t(float32=0.1) %!d(string=b) ")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 'c'}}{{eq .names.a .obj.missing .zero}}{{print $ .neg}}", "<99>|ERR|template: v:1:52: executing \"v\" at <eq .names.a .obj.missing .zero>: error calling eq: incompatible types for comparison: string and float64")
  vec(dt, "{{ge (slice .s 1 4) .msi.four}}{{$v := \"str\"}}[{{$v}}]{{ge .f .}}", "|ERR|template: v:1:2: executing \"v\" at <ge (slice .s 1 4) .msi.four>: error calling ge: invalid type for comparison")
  vec(dj, "{{printf \"%8.3e %X %G \" .obj.missing .pi .nums}}", "%!e(<nil>) 0X1.921F9F01B866EP+01 [3 1 2] ")
