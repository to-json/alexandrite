  vec(dt, "{{not .u64}}{{range $i, $e := .nest.m.k}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{range $i, $e := nil}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "false0=|ERR|template: v:1:112: executing \"v\" at <nil>: nil is not a command")
  vec(dj, "{{/* c */}}{{not (printf \"%03d\" 7)}}{{printf \"%-10q| %\#o \" .obj.w .no}}", "false\"wide\"    | %!o(bool=false) ")
  vec(dt, "{{- \" trim \" -}}{{$v := 2.5}}[{{$v}}]{{- \" trim \" -}}", " trim [2.5] trim ")
  vec(dj, "{{printf \"%O %U %f \" .neg .obj.y (index .nums 0)}}", "%!O(float64=-2) %!U(<nil>) 3.000000 ")
  vec(dt, "{{if .nm}}T{{if .mis}}T{{(index .mis 2)}}{{else}}F{{end}}{{else}}F{{end}}", "F")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 1e3}}{{js .obj 1e3}}{{printf \"%v %! \" (index .nums 0) (index .nums 0)}}", "<1000>map[w:wide x:1 y:\\u003Cnil\\u003E z:[1 2 map[k:v]]] 10003 %!!(float64=3) ")
  vec(dt, "{{$v := .np}}[{{$v}}]{{ne .c (len .si)}}", "[<nil>]|ERR|template: v:1:23: executing \"v\" at <ne .c (len .si)>: error calling ne: incompatible types for comparison: complex128 and int")
  vec(dj, "{{$v := (slice .tags 1)}}[{{$v}}]{{$v := 1i}}[{{$v}}]{{.uni}}", "[[b c]][(0+1i)]héllo, 世界")
  vec(dt, " - ", " - ")
  vec(dj, "{{print \"\" (index .obj.z 2)}}{{not -3}}", "map[k:v]false")
  vec(dt, "{{.ss | not}}{{urlquery (index .sts 0) 2.5}}{{.neg | html}}", "false%7B2++%5B%5D%7D+2.5-17")
  vec(dj, "{{not .tags}}", "false")
  vec(dt, "{{range $i, $e := 0}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <0>: can't use 0 to iterate over more than one variable")
  vec(dj, "{{if -3}}T{{slice (slice .tags 1) 2}}{{else}}F{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 1i}}{{or (index .nums 0) \"\"}}", "T[]<(0+1i)>3")
  vec(dt, "{{print (index .msi \"one\") nil}}{{.u64}}", "1 <nil>18446744073709551615")
  vec(dj, "{{printf \"%6.2g %6.2g %d \" 2.5 .nums true}}{{le 'c' (index .obj.z 2)}}", "   2.5 [     3      1      2] %!d(bool=true) |ERR|template: v:1:45: executing \"v\" at <le 'c' (index .obj.z 2)>: error calling le: invalid type for comparison")
  vec(dt, "{{.st.C}}{{ge .ss .bs}}", "[4]|ERR|template: v:1:11: executing \"v\" at <ge .ss .bs>: error calling ge: invalid type for comparison")
  vec(dj, "{{.obj | eq 1}}", "|ERR|template: v:1:9: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and map[string]interface {}")
  vec(dt, "{{index 'c'}}", "99")
  vec(dj, "{{eq $ (index .tags 1)}}", "|ERR|template: v:1:2: executing \"v\" at <eq $ (index .tags 1)>: error calling eq: incompatible types for comparison: map[string]interface {} and string")
  vec(dt, "{{printf \"%\#o %E %t \" 0x1F .i8 .nest}}{{eq .f (index .msi \"one\")}}", "037 %!E(int8=-7) map[%!t(string=list):[%!t(int=1) %!t(string=two) %!t(float64=3) <nil> true] %!t(string=m):map[%!t(string=k):[%!t(int=7) %!t(int=8)]]] |ERR|template: v:1:40: executing \"v\" at <eq .f (index .msi \"one\")>: error calling eq: incompatible types for comparison: float64 and int")
  vec(dj, "{{index 0 .flag}}{{gt .obj.x (len .tags)}}{{(slice .tags 1)}}", "|ERR|template: v:1:2: executing \"v\" at <index 0 .flag>: error calling index: can't index item of type int")
  vec(dt, "{{(slice .s 1 4) | printf \"%q\"}}{{. | not}}", "\"o &\"false")
}

test "exec vectors 26" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "text {{eq .obj.w .nul}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .nul}}", "text false<<no value>>")
  vec(dt, "{{.t}}{{range $i, $e := (index .nest.list 1)}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "true|ERR|template: v:1:42: executing \"v\" at <1>: range can't iterate over two")
  vec(dj, "{{js 'c' .big}}", "99 1e+21")
  vec(dt, "{{$v := .st.C}}[{{$v}}]{{ne .st.C .ns}}", "[[4]]true")
  vec(dj, "{{range $i, $e := .names.a}}{{$i}}={{.}};{{else}}none{{end}}", "|ERR|template: v:1:24: executing \"v\" at <.names.a>: range can't iterate over A")
  vec(dt, "{{index .msi.four false}}", "|ERR|template: v:1:2: executing \"v\" at <index .msi.four false>: error calling index: index of untyped nil")
  vec(dj, "{{and .pi true}}{{.uni}}{{or .empty .pi}}", "truehéllo, 世界3.14159")
