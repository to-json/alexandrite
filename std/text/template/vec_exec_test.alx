  vec(dj, "{{(printf \"%03d\" 7)}}{{printf \"%x \" $}}", "007map[616765:0x1.ep+04 626967:0x1.b1ae4d6e2ef5p+69 656d707479:[] 666c6167:%!x(bool=true) 6e616d65:416e6e 6e616d6573:map[61:41 62:42 63:] 6e6567:-0x1p+01 6e6f:%!x(bool=false) 6e756c:<nil> 6e756d73:[0x1.8p+01 0x1p+00 0x1p+01] 6f626a:map[77:77696465 78:0x1p+00 79:<nil> 7a:[0x1p+00 0x1p+01 map[6b:76]]] 7069:0x1.921f9f01b866ep+01 73:3c623e26272278223c2f623e203d 74616773:[61 62 63] 74696e79:0x1.421f5f40d8376p-23 756e69:68c3a96c6c6f2c20e4b896e7958c 7a65726f:0x0p+00] ")
  vec(dt, "{{lt . (index .si 1)}}{{if (index .nest.list 1)}}T{{.bs}}{{else}}F{{end}}", "|ERR|template: v:1:2: executing \"v\" at <lt . (index .si 1)>: error calling lt: invalid type for comparison")
  vec(dj, "{{printf \"%o %z %T \" \"str\" (len .tags) 'c'}}{{(slice .tags 1)}}{{if .pi}}T{{js .pi .obj.x}}{{else}}F{{end}}", "%!o(string=str) %!z(int=3) int [b c]T3.14159 1")
  vec(dt, "{{range $i, $e := (index .mis 2)}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{printf \"%! %e \" (slice .s 1 4) 0}}{{printf \"%.2s %X \" .mfb (index .nest.list 1)}}", "|ERR|template: v:1:30: executing \"v\" at <2>: range can't iterate over b")
