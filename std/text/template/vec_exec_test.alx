  vec(dj, "{{not .age}}{{eq .obj.y .zero}}{{.obj.y | len}}", "falsefalse|ERR|template: v:1:42: executing \"v\" at <len>: error calling len: reflect: call of reflect.Value.Type on zero Value")
  vec(dt, "x{{.nest.list}}{{printf \"%[2]v %[1]v %\#x % x \" (slice .s 1 4) .i nil}}", "x[1 two 3 <nil> true]42 o & 0x2a %!x(<nil>) ")
  vec(dj, "{{.obj.y}}{{printf \"%8.3e %s \" 1 .nums}}{{len false}}", "<no value>%!e(int=     001) [%!s(float64=3) %!s(float64=1) %!s(float64=2)] |ERR|template: v:1:42: executing \"v\" at <len false>: error calling len: len of type bool")
  vec(dt, "{{not .nm}}{{.ns | not}}{{.si}}", "truetrue[5 10 15]")
  vec(dj, "{{printf \"%\#q %q %t \" (printf \"%03d\" 7) (len .tags) .missing}}{{.obj.missing}}", "`007` '\\x03' %!t(<nil>) <no value>")
