  vec(dt, "{{printf \"%F %05d \" . .ss}}", "map[%!F(string=bs):[%!F(uint8=104) %!F(uint8=105)] %!F(string=c):(1.500000-2.000000i) %!F(string=e):%!F(string=) %!F(string=f):2.500000 %!F(string=f32):0.100000 %!F(string=i):%!F(int=42) %!F(string=i8):%!F(int8=-7) %!F(string=mfb):map[-1.000000:%!F(bool=false) 2.500000:%!F(bool=true)] %!F(string=mis):map[%!F(int=1):%!F(string=a) %!F(int=2):%!F(string=b) %!F(int=3):%!F(string=c)] %!F(string=msi):map[%!F(string=one):%!F(int=1) %!F(string=three):%!F(int=3) %!F(string=two):%!F(int=2)] %!F(string=neg):%!F(int=-17) %!F(string=nest):map[%!F(string=list):[%!F(int=1) %!F(string=two) 3.000000 <nil> %!F(bool=true)] %!F(string=m):map[%!F(string=k):[%!F(int=7) %!F(int=8)]]] %!F(string=nm):map[] %!F(string=np):%!F(*int=<nil>) %!F(string=ns):[] %!F(string=r):%!F(int32=120) %!F(string=s):%!F(string=go & <alx>) %!F(string=si):[%!F(int=5) %!F(int=10) %!F(int=15)] %!F(string=ss):[%!F(string=x) %!F(string=y)] %!F(string=st):{%!F(int=1) %!F(string=bee) [%!F(int=4)]} %!F(string=sts):[{%!F(int=2) %!F(string=) []} {%!F(int=0) %!F(string=b) []}] %!F(string=t):%!F(bool=true) %!F(string=u16):%!F(uint16=65535) %!F(string=u64):%!F(uint64=18446744073709551615)] [%!d(string=0000x) %!d(string=0000y)] ")
  vec(dj, "{{not (len .tags)}}{{lt .zero .obj.w}}", "false|ERR|template: v:1:21: executing \"v\" at <lt .zero .obj.w>: error calling lt: incompatible types for comparison: float64 and string")
