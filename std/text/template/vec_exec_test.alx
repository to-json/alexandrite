  vec(dj, "{{1e3}}", "1000")
  vec(dt, "{{if (slice .si 1 2)}}T{{printf \"%b %o \" -3 .s}}{{else}}F{{end}}{{printf \"%\#o %-10q| %c \" .sts .sts .mis}}", "T-11 %!o(string=go & <alx>) [{02 %!o(string=) []} {0 %!o(string=b) []}] [{'\\x02'     \"\"         []} {'\\x00'     \"b\"        []}]| map[\x01:%!c(string=a) \x02:%!c(string=b) \x03:%!c(string=c)] ")
  vec(dj, "{{if 'c'}}T{{1e3}}{{else}}F{{end}}", "T1000")
  vec(dt, "{{.s}}{{js .st 2.5}}{{printf \"%\#x %\#x %\#U \" nil .missing .ss}}", "go & <alx>{1 bee [4]} 2.5%!x(<nil>) %!x(<nil>) [%!U(string=x) %!U(string=y)] ")
