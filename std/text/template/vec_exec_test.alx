  vec(dj, "{{range $i, $e := .obj}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{or $ \"str\"}}", "w=+map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]")
  vec(dt, "{{index .st.A .nm}}", "|ERR|template: v:1:2: executing \"v\" at <index .st.A .nm>: error calling index: can't index item of type int")
  vec(dj, "{{print .nul 'c'}}", "<nil> 99")
