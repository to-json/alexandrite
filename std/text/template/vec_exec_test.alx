  vec(dt, "{{if 1i}}T{{range $i, $e := .f32}}{{$i}}={{.}};{{else}}none{{end}}{{else}}F{{end}}{{html (index .mis 2) nil}}", "T|ERR|template: v:1:28: executing \"v\" at <.f32>: range can't iterate over 0.1")
