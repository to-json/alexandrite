test "exec vectors 4" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{if .names.a}}T{{ne (index .obj.z 2) (slice .tags 1)}}{{else}}F{{end}}", "T|ERR|template: v:1:18: executing \"v\" at <ne (index .obj.z 2) (slice .tags 1)>: error calling ne: non-comparable types map[k:v]: map[string]interface {}, []interface {}: [b c]")
