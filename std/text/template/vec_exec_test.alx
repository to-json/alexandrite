  vec(dt, "{{(index .si 1)}}{{printf \"% x %o %O \" (slice .s 1 4) .sts .st.C}}", "106f 20 26 [{2 %!o(string=) []} {0 %!o(string=b) []}] [0o4] ")
  vec(dj, "{{slice (index .obj.z 2) 0}}{{printf \"%t %-5d| %-10q| \" .age (slice .tags 1) 0}}{{if .pi}}T{{index .obj.y .empty}}{{else}}F{{end}}", "|ERR|template: v:1:2: executing \"v\" at <slice (index .obj.z 2) 0>: error calling slice: can't slice item of type map[string]interface {}")
  vec(dt, "{{lt 'c' .st.C}}{{with (slice .si 1 2)}}<{{printf \"%05d %*d %\#v \" .st .f .nest.m.k}}>{{else}}E{{end}}", "|ERR|template: v:1:2: executing \"v\" at <lt 'c' .st.C>: error calling lt: invalid type for comparison")
  vec(dj, "{{not (index .obj.z 2)}}{{$v := (index .tags 1)}}[{{$v}}]", "false[b]")
  vec(dt, "{{printf \"% x \" (len .si)}}{{or .f32 0x1F}}", " 3 0.1")
  vec(dj, "{{range $i, $e := 0}}{{$i}}={{.}};{{else}}none{{end}}{{or 1i .no}}", "|ERR|template: v:1:18: executing \"v\" at <0>: can't use 0 to iterate over more than one variable")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .f}}", "<2.5>")
  vec(dj, "{{ne -3 .}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0}}{{urlquery .name .big}}", "|ERR|template: v:1:2: executing \"v\" at <ne -3 .>: error calling ne: incompatible types for comparison: int and map[string]interface {}")
  vec(dt, "{{ne 'c' .nm}}", "|ERR|template: v:1:2: executing \"v\" at <ne 'c' .nm>: error calling ne: incompatible types for comparison: int and map[string]int")
  vec(dj, "{{println (.obj.z) .pi}}{{(index .obj.z 2) | not}}{{lt .names (index .obj.z 2)}}", "[1 2 map[k:v]] 3.14159\nfalse|ERR|template: v:1:52: executing \"v\" at <lt .names (index .obj.z 2)>: error calling lt: invalid type for comparison")
  vec(dt, "{{printf \"%o \" (slice .s 1 4)}}{{with (slice .si 1 2)}}<{{$v := .f}}[{{$v}}]>{{else}}E{{end}}", "%!o(string=o &) <|ERR|template: v:1:64: executing \"v\" at <.f>: can't evaluate field f in type []int")
  vec(dj, "{{if 1e3}}T{{range $i, $e := -3}}{{$i}}={{continue}};{{else}}none{{end}}{{else}}F{{end}}{{with .obj}}<{{.names}}>{{else}}E{{end}}", "T|ERR|template: v:1:29: executing \"v\" at <-3>: can't use -3 to iterate over more than one variable")
  vec(dt, "{{if .st.A}}T{{.si | len}}{{else}}F{{end}}{{not .u64}}{{.nest}}", "T3falsemap[list:[1 two 3 <nil> true] m:map[k:[7 8]]]")
  vec(dj, "{{and .s 1e3}}{{printf \"%F \" nil}}{{le (printf \"%03d\" 7) .names.a}}", "1000%!F(<nil>) true")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .neg}}{{.f32}}{{printf \"%6.2g %05d \" .nm .st.B}}", "<-17>0.1map[] %!d(string=00bee) ")
  vec(dj, "{{js (index .tags 1) 2.5}}", "b2.5")
  vec(dt, "{{range $i, $e := .f}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <.f>: range can't iterate over 2.5")
  vec(dj, "{{range $i, $e := (index .tags 1)}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" false}}", "|ERR|template: v:1:31: executing \"v\" at <1>: range can't iterate over b")
  vec(dt, "{{html (index .msi \"one\") .nest.m.k}}{{/* c */}}{{le nil .st.C}}", "1 [7 8]|ERR|template: v:1:50: executing \"v\" at <le nil .st.C>: error calling le: invalid type for comparison")
}

test "exec vectors 7" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{index 'c' 'c'}}{{and (index .nums 0) \"\"}}{{eq .flag .name}}", "|ERR|template: v:1:2: executing \"v\" at <index 'c' 'c'>: error calling index: can't index item of type int")
  vec(dt, "{{not (index .sts 0)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"str\"}}{{2.5}}", "false<str>2.5")
  vec(dj, "{{range $i, $e := .obj.x}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{with .obj.x}}<{{len .pi}}>{{else}}E{{end}}{{.obj.z}}", "|ERR|template: v:1:22: executing \"v\" at <.obj.x>: range can't iterate over 1")
  vec(dt, " - {{or (index .sts 0) .i8}}", " - {2  []}")
  vec(dj, "{{printf \"%.*f \" false}}{{(index .nums 0)}}", "%!(BADPREC)%!f(MISSING) 3")
  vec(dt, "{{not .msi}}{{println -3 (index .si 1)}}{{/* c */}}", "false-3 10\n")
  vec(dj, "{{printf \"%.2s \" .no}}{{$v := .obj.missing}}[{{$v}}]{{printf \"%x \" nil}}", "%!s(bool=false) [<no value>]%!x(<nil>) ")
  vec(dt, "{{with .nest.list}}<{{or 'c' true}}>{{else}}E{{end}}{{not .f}}", "<99>false")
  vec(dj, "{{or true .obj.x}}{{.tiny | print}}", "true1.5e-07")
  vec(dt, "{{ne .e .missing}}{{.msi}}{{le .s (index .sts 0)}}", "truemap[one:1 three:3 two:2]|ERR|template: v:1:28: executing \"v\" at <le .s (index .sts 0)>: error calling le: invalid type for comparison")
  vec(dj, "{{eq .nul (index .nums 0)}}{{range $i, $e := .big}}{{$i}}={{$e}};{{else}}none{{end}}", "false|ERR|template: v:1:45: executing \"v\" at <.big>: range can't iterate over 1e+21")
  vec(dt, "x{{index .sts .ss}}{{index (index .sts 0)}}", "x|ERR|template: v:1:3: executing \"v\" at <index .sts .ss>: error calling index: cannot index slice/array with type []string")
  vec(dj, "{{$v := .zero}}[{{$v}}]", "[0]")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 'c'}}{{.neg | len}}", "<99>|ERR|template: v:1:59: executing \"v\" at <len>: error calling len: len of type int")
  vec(dj, "{{$v := \"str\"}}[{{$v}}]{{$v := .no}}[{{$v}}]", "[str][false]")
  vec(dt, "{{not .st}}", "false")
  vec(dj, "{{printf \"% \" .obj.z}}{{not (slice .tags 1)}}{{index .s}}", "%!(NOVERB)%!(EXTRA []interface {}=[1 2 map[k:v]])false<b>&'\"x\"</b> =")
  vec(dt, "{{le (index .msi \"one\") .t}}", "|ERR|template: v:1:2: executing \"v\" at <le (index .msi \"one\") .t>: error calling le: incompatible types for comparison: int and bool")
  vec(dj, "{{with .big}}<{{range $i, $e := 1}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}>{{else}}E{{end}}", "<|ERR|template: v:1:32: executing \"v\" at <1>: can't use 1 to iterate over more than one variable")
  vec(dt, "{{if .st}}T{{range $i, $e := .np}}{{$i}}={{.}};{{else}}none{{end}}{{else}}F{{end}}{{(slice .si 1 2)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .ss}}", "T|ERR|template: v:1:29: executing \"v\" at <.np>: range can't iterate over <nil>")
  vec(dj, "{{.name}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .names}}", "Ann<map[a:A b:B c:]>")
  vec(dt, "{{index .np}}{{printf \"%+d %05d \" .msi.four 0x1F}}x", "<nil>%!d(<nil>) 00031 x")
  vec(dj, "{{not nil}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .neg}}{{len (.obj.z)}}", "true<-2>3")
  vec(dt, "{{.f}}{{println -3 (index .si 1)}}{{range $i, $e := 'c'}}{{$i}}={{.}};{{else}}none{{end}}", "2.5-3 10\n|ERR|template: v:1:52: executing \"v\" at <'c'>: can't use 99 to iterate over more than one variable")
  vec(dj, "{{or .obj.missing .pi}}", "3.14159")
  vec(dt, "{{if (index .sts 0)}}T{{(len .si)}}{{else}}F{{end}}x{{with .nm}}<{{if (index .mis 2)}}T{{printf \"%-5d| % %\#v \" 1i .i8 false}}{{else}}F{{end}}>{{else}}E{{end}}", "T3xE")
  vec(dj, "{{slice .tags 2}}text ", "[c]text ")
  vec(dt, "{{urlquery (len .si) .r}}{{printf \"%\#o \" .s}}{{not .i}}", "3+120%!o(string=go & <alx>) false")
  vec(dj, "{{urlquery .pi .age}}", "3.14159+30")
  vec(dt, "{{or .neg .neg}}{{1}}{{.st.B | print}}", "-171bee")
  vec(dj, "{{.neg | printf \"%v\"}}{{.uni}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .nums 0)}}", "-2héllo, 世界<3>")
  vec(dt, "{{.nm | not}}", "true")
  vec(dj, "{{/* c */}}{{(.obj.z)}}{{or .name .obj.w}}", "[1 2 map[k:v]]Ann")
  vec(dt, "{{printf \"%T \" .i}}{{.ss}}", "int [x y]")
  vec(dj, "{{with .neg}}<{{$v := 1}}[{{$v}}]>{{else}}E{{end}}{{range $i, $e := (slice .tags 1)}}{{$i}}={{continue}};{{else}}none{{end}}{{index .pi (slice .tags 1)}}", "<[1]>0=1=|ERR|template: v:1:126: executing \"v\" at <index .pi (slice .tags 1)>: error calling index: can't index item of type float64")
  vec(dt, "{{index .st.B}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .mis 2)}}", "PARSE:template: v:1: template: multiple definition of template \"t1\"")
  vec(dj, " - ", " - ")
  vec(dt, "{{printf \"%*d \" .nm}}{{true}}", "%!(BADWIDTH)%!d(MISSING) true")
  vec(dj, "{{not $}}{{.tags | len}}", "false3")
  vec(dt, "{{slice .msi.four 2}}{{.e}}{{not (index .sts 0)}}", "|ERR|template: v:1:2: executing \"v\" at <slice .msi.four 2>: error calling slice: slice of untyped nil")
  vec(dj, "{{.big}}{{eq (len .tags) .nul .}}{{range $i, $e := -3}}{{$i}}={{continue}};{{else}}none{{end}}", "1e+21|ERR|template: v:1:10: executing \"v\" at <eq (len .tags) .nul .>: error calling eq: incompatible types for comparison: int and map[string]interface {}")
  vec(dt, "{{printf \"%[2]v %[1]v %8.3e \" .e (slice .si 1 2)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .e}}", "[10]  [%!e(int=     010)] <>")
  vec(dj, "{{.obj.x}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .tags 1)}}{{ge .age .nums}}", "1<b>|ERR|template: v:1:74: executing \"v\" at <ge .age .nums>: error calling ge: invalid type for comparison")
  vec(dt, "{{not .neg}}", "false")
  vec(dj, "{{$v := true}}[{{$v}}]{{$v := (.obj.z)}}[{{$v}}]{{printf \"%t %E \" 'c' .names}}", "[true][[1 2 map[k:v]]]%!t(int=99) map[%!E(string=a):%!E(string=A) %!E(string=b):%!E(string=B) %!E(string=c):%!E(string=)] ")
  vec(dt, "{{with .mis}}<{{with .np}}<{{.u16}}>{{else}}E{{end}}>{{else}}E{{end}}{{index 1i}}{{ge .f .np}}", "<|ERR|template: v:1:21: executing \"v\" at <.np>: can't evaluate field np in type map[int]string")
  vec(dj, "{{.nul}}{{$v := .flag}}[{{$v}}]{{ge 0x1F (.obj.z)}}", "<no value>[true]|ERR|template: v:1:33: executing \"v\" at <ge 0x1F (.obj.z)>: error calling ge: invalid type for comparison")
  vec(dt, "{{not false}}", "true")
  vec(dj, "{{-3}}{{index -3 .missing}}{{$}}", "-3|ERR|template: v:1:8: executing \"v\" at <index -3 .missing>: error calling index: can't index item of type int")
  vec(dt, "{{with .nest.list}}<{{printf \"%*d \" (len .si)}}>{{else}}E{{end}}", "<|ERR|template: v:1:41: executing \"v\" at <.si>: can't evaluate field si in type []interface {}")
  vec(dj, "{{if (index .obj.z 2)}}T{{true | printf \"%v\"}}{{else}}F{{end}}{{printf \"%\#o %g %o \" .obj.z .obj.x .obj.z}}", "Ttrue[%!o(float64=1.00000) %!o(float64=2.00000) map[%!o(string=k):%!o(string=v)]] 1 [%!o(float64=1) %!o(float64=2) map[%!o(string=k):%!o(string=v)]] ")
  vec(dt, "{{/* c */}}{{$v := .st.C}}[{{$v}}]", "[[4]]")
  vec(dj, "{{with nil}}<{{if .flag}}T{{.obj.missing}}{{else}}F{{end}}>{{else}}E{{end}}{{and (index .obj.z 2) nil}}{{with 0x1F}}<{{print .obj \"\"}}>{{else}}E{{end}}", "|ERR|template: v:1:7: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "{{/* c */}}", "")
  vec(dj, "{{not .name}}{{le 0 (slice .tags 1)}}{{if (index .obj.z 2)}}T{{printf \"%.2s \" true}}{{else}}F{{end}}", "false|ERR|template: v:1:15: executing \"v\" at <le 0 (slice .tags 1)>: error calling le: invalid type for comparison")
  vec(dt, "{{printf \"%\#v %v \" 0x1F -3}}{{. | printf \"%v\"}}", "31 -3 map[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 <nil> true] m:map[k:[7 8]]] nm:map[] np:<nil> ns:[] r:120 s:go & <alx> si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615]")
  vec(dj, "{{eq .obj 2.5 (len .tags)}}{{and .names 1e3}}", "|ERR|template: v:1:2: executing \"v\" at <eq .obj 2.5 (len .tags)>: error calling eq: incompatible types for comparison: map[string]interface {} and float64")
  vec(dt, "{{(slice .s 1 4)}}{{1i | len}}{{if .np}}T{{printf \"%5.2f %\#v \" .msi.four .msi.two}}{{else}}F{{end}}", "o &|ERR|template: v:1:25: executing \"v\" at <len>: error calling len: len of type complex128")
  vec(dj, "{{lt . \"\"}}", "|ERR|template: v:1:2: executing \"v\" at <lt . \"\">: error calling lt: invalid type for comparison")
  vec(dt, "{{$v := .msi.two}}[{{$v}}]{{with 'c'}}<{{len .f}}>{{else}}E{{end}}{{or .missing .u64}}", "[2]<|ERR|template: v:1:45: executing \"v\" at <.f>: can't evaluate field f in type int")
  vec(dj, "text {{printf \"%05d %5.2f %\#q \" (len .tags) .names.a -3}}", "text 00003 %!f(string=    A) '�' ")
  vec(dt, "{{or .neg .np}}{{-3 | printf \"%q\"}}", "-17'�'")
  vec(dj, "{{printf \"%-5d| %q \" (.obj.z) 1i}}", "[%!d(float64=1    ) %!d(float64=2    ) map[%!d(string=k    ):%!d(string=v    )]]| %!q(complex128=(0+1i)) ")
  vec(dt, "text {{.u16 | printf \"%v\"}}", "text 65535")
  vec(dj, "{{le 'c' .nums}}", "|ERR|template: v:1:2: executing \"v\" at <le 'c' .nums>: error calling le: invalid type for comparison")
  vec(dt, "{{$v := .ns}}[{{$v}}]{{range $i, $e := .np}}{{$i}}={{$e}};{{else}}none{{end}}", "[[]]|ERR|template: v:1:39: executing \"v\" at <.np>: range can't iterate over <nil>")
  vec(dj, "{{range $i, $e := .name}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{not .nul}}", "|ERR|template: v:1:18: executing \"v\" at <.name>: range can't iterate over Ann")
  vec(dt, "{{and .mfb .e}}", "")
  vec(dj, "{{printf \"%.0f %t \" .names 0}}{{lt nil .no}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .name}}", "map[%!f(string=):%!f(string=) %!f(string=):%!f(string=) %!f(string=):%!f(string=)] %!t(int=0) |ERR|template: v:1:32: executing \"v\" at <lt nil .no>: error calling lt: invalid type for comparison")
  vec(dt, "{{printf \"%b %10s| \" .i8 .st}}", "-111 {%!s(int=         1)        bee [%!s(int=         4)]}| ")
  vec(dj, "{{len .tags}}{{eq .obj.w (index .tags 1)}}{{slice 1e3 0}}", "3false|ERR|template: v:1:44: executing \"v\" at <slice 1e3 0>: error calling slice: can't slice item of type float64")
  vec(dt, "{{html (slice .si 1 2) .c}}{{0x1F}}{{or (index .sts 0) .bs}}", "[10] (1.5-2i)31{2  []}")
  vec(dj, "text {{not .zero}}{{println \"str\" 'c'}}", "text truestr 99\n")
  vec(dt, "{{printf \"% \" .t}}", "%!(NOVERB)%!(EXTRA bool=true)")
  vec(dj, "{{or .nums 0x1F}}", "[3 1 2]")
  vec(dt, "{{if .bs}}T{{printf \"% %.*f %g \" .st.C .missing 1}}{{else}}F{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .st.A}}{{.e}}", "T%.*f [%!g(int=4)] %!(EXTRA <nil>, int=1)<1>")
  vec(dj, "{{ne $ .name}}{{eq .missing .name}}", "|ERR|template: v:1:2: executing \"v\" at <ne $ .name>: error calling ne: incompatible types for comparison: map[string]interface {} and string")
  vec(dt, "{{lt \"str\" (index .mis 2)}}{{len (slice .si 1 2)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .i}}", "false1<42>")
  vec(dj, "{{.zero | printf \"%v\"}}{{.big}}{{printf \"%b %.*f %b \" .zero .tags (printf \"%03d\" 7)}}", "01e+210p-1074 %!(BADPREC)%!f(string=007) %!b(MISSING) ")
  vec(dt, "{{not .st.C}}{{not .np}}", "falsetrue")
  vec(dj, "{{urlquery nil .pi}}x", "%3Cno+value%3E3.14159x")
  vec(dt, "{{lt .u16 .u64}}", "true")
  vec(dj, "{{if .big}}T{{(slice .tags 1)}}{{else}}F{{end}}", "T[b c]")
  vec(dt, "{{printf \"%\#v \" (index .si 1)}}{{$v := .ns}}[{{$v}}]", "10 [[]]")
  vec(dj, "{{or (slice .tags 1) false}}", "[b c]")
  vec(dt, "{{lt .t .mfb}} - {{not 0}}", "|ERR|template: v:1:2: executing \"v\" at <lt .t .mfb>: error calling lt: invalid type for comparison")
  vec(dj, "{{ne true .nums}}", "|ERR|template: v:1:2: executing \"v\" at <ne true .nums>: error calling ne: incompatible types for comparison: bool and []interface {}")
  vec(dt, "{{.f}}{{range $i, $e := 0x1F}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "2.5|ERR|template: v:1:24: executing \"v\" at <0x1F>: can't use 31 to iterate over more than one variable")
  vec(dj, "{{if .s}}T{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" -3}}{{else}}F{{end}}{{range $i, $e := .missing}}{{$i}}={{continue}};{{else}}none{{end}}{{printf \"% \" 0}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "{{$v := .mis}}[{{$v}}]{{(len .si)}}", "[map[1:a 2:b 3:c]]3")
  vec(dj, "{{if .obj}}T{{.big | print}}{{else}}F{{end}}{{urlquery .missing (index .tags 1)}}", "T1e+21%3Cno+value%3Eb")
  vec(dt, "{{le . .np}}{{eq .msi.four .u16}}", "|ERR|template: v:1:2: executing \"v\" at <le . .np>: error calling le: invalid type for comparison")
  vec(dj, "{{ne (len .tags) .obj.w}}", "|ERR|template: v:1:2: executing \"v\" at <ne (len .tags) .obj.w>: error calling ne: incompatible types for comparison: int and string")
  vec(dt, "{{(len .si) | not}}", "false")
  vec(dj, "{{printf \"%s \" .zero}}", "%!s(float64=0) ")
  vec(dt, "{{range $i, $e := 2.5}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{gt 0 .st.B}}", "|ERR|template: v:1:18: executing \"v\" at <2.5>: range can't iterate over 2.5")
  vec(dj, "{{index (printf \"%03d\" 7)}}text ", "007text ")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (slice .s 1 4)}}{{with (index .si 1)}}<{{not (index .sts 0)}}>{{else}}E{{end}}", "<o &><|ERR|template: v:1:97: executing \"v\" at <.sts>: can't evaluate field sts in type int")
  vec(dj, "{{printf \"%G %b \" .big 1i}}", "1E+21 (0p-1074+4503599627370496p-52i) ")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 'c'}}{{.e}}", "<99>")
}

test "exec vectors 8" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{printf \"% x %+d \" (index .tags 1) .neg}}{{not 0}}", "62 %!d(float64=-2) true")
  vec(dt, "{{lt .i8 .e}}{{printf \"%p \" .st.C}}{{1i}}", "|ERR|template: v:1:2: executing \"v\" at <lt .i8 .e>: error calling lt: incompatible types for comparison: int8 and string")
  vec(dj, "{{.pi}}{{range $i, $e := .nul}}{{$i}}={{.}};{{else}}none{{end}}{{printf \"%G %x %q \" (slice .tags 1) .obj 'c'}}", "3.14159none[%!G(string=b) %!G(string=c)] map[77:77696465 78:0x1p+00 79:<nil> 7a:[0x1p+00 0x1p+01 map[6b:76]]] 'c' ")
  vec(dt, "{{/* c */}}{{ne (index .sts 0) .t}}", "|ERR|template: v:1:13: executing \"v\" at <ne (index .sts 0) .t>: error calling ne: incompatible types for comparison: template.vecSt and bool")
  vec(dj, "{{printf \"%.2s %x \" 1 false}}{{printf \"%.2s %X \" (len .tags) .big}}", "%!s(int=01) %!x(bool=false) %!s(int=03) 0X1.B1AE4D6E2EF5P+69 ")
  vec(dt, "{{index 2.5}}{{ne (index .sts 0) .i8}}", "2.5|ERR|template: v:1:15: executing \"v\" at <ne (index .sts 0) .i8>: error calling ne: incompatible types for comparison: template.vecSt and int8")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj.w}}{{lt 'c' .missing}}{{with \"str\"}}<{{or (len .tags) .nums}}>{{else}}E{{end}}", "<wide>|ERR|template: v:1:55: executing \"v\" at <lt 'c' .missing>: error calling lt: invalid type for comparison")
  vec(dt, "{{lt .np (slice .si 1 2)}}{{gt .st.B .si}}{{ge (slice .s 1 4) .st.B}}", "|ERR|template: v:1:2: executing \"v\" at <lt .np (slice .si 1 2)>: error calling lt: invalid type for comparison")
  vec(dj, "{{$v := 1}}[{{$v}}]{{index .obj .missing}}{{println -3 0x1F}}", "[1]|ERR|template: v:1:21: executing \"v\" at <index .obj .missing>: error calling index: value is nil; should be of type string")
  vec(dt, "{{with 1i}}<{{1 | printf \"%v\"}}>{{else}}E{{end}}{{printf \"%U \" .i}}{{- \" trim \" -}}", "<1>U+002A  trim ")
