  vec(dt, "{{\"str\" | eq 1}}{{2.5}}", "|ERR|template: v:1:10: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and string")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" -3}}{{ge .nums .nums}}{{.pi}}", "<-3>|ERR|template: v:1:51: executing \"v\" at <ge .nums .nums>: error calling ge: invalid type for comparison")
  vec(dt, "{{range $i, $e := 1i}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <1i>: range can't iterate over (0+1i)")
  vec(dj, "{{not (printf \"%03d\" 7)}}{{lt $ .obj.y}}", "false|ERR|template: v:1:27: executing \"v\" at <lt $ .obj.y>: error calling lt: invalid type for comparison")
  vec(dt, "{{ne 0x1F .np}}{{.sts}}", "|ERR|template: v:1:2: executing \"v\" at <ne 0x1F .np>: error calling ne: incompatible types for comparison: int and *int")
  vec(dj, "{{ge .no -3}}{{print .nul .}}", "|ERR|template: v:1:2: executing \"v\" at <ge .no -3>: error calling ge: incompatible types for comparison: bool and int")
  vec(dt, " - {{or .i8 .f32}}", " - -7")
  vec(dj, "{{with (slice .tags 1)}}<{{.names}}>{{else}}E{{end}}{{not .big}}", "<|ERR|template: v:1:27: executing \"v\" at <.names>: can't evaluate field names in type []interface {}")
  vec(dt, "{{slice (len .si) 0}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .f}}{{printf \"%v %\#q %[2]v %[1]v \" (slice .s 1 4) .nest.list 0x1F}}", "|ERR|template: v:1:2: executing \"v\" at <slice (len .si) 0>: error calling slice: can't slice item of type int")
  vec(dj, "{{eq .empty (slice .tags 1)}}{{with $}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .names.a}}>{{else}}E{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "{{range $i, $e := .st.C}}{{$i}}={{continue}};{{else}}none{{end}}", "0=")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .nums}}", "<[3 1 2]>")
  vec(dt, "{{$v := (index .msi \"one\")}}[{{$v}}]{{le .ns (index .si 1)}}", "[1]|ERR|template: v:1:38: executing \"v\" at <le .ns (index .si 1)>: error calling le: invalid type for comparison")
  vec(dj, "{{eq . (index .tags 1)}}", "|ERR|template: v:1:2: executing \"v\" at <eq . (index .tags 1)>: error calling eq: incompatible types for comparison: map[string]interface {} and string")
  vec(dt, "{{0}}{{range $i, $e := .msi.two}}{{$i}}={{.}};{{else}}none{{end}}{{not .st.C}}", "0|ERR|template: v:1:27: executing \"v\" at <.msi.two>: can't use 2 to iterate over more than one variable")
  vec(dj, "{{or \"\" \"\"}}{{(index .tags 1) | printf \"%q\"}}{{if .neg}}Ttext {{else}}F{{end}}", "\"b\"Ttext ")
  vec(dt, "{{gt .e .mfb}}{{and (index .msi \"one\") 2.5}}{{.msi}}", "|ERR|template: v:1:2: executing \"v\" at <gt .e .mfb>: error calling gt: invalid type for comparison")
  vec(dj, "{{printf \"%5.2f \" 1e3}}", "1000.00 ")
  vec(dt, "{{eq .bs .msi}}{{/* c */}}", "|ERR|template: v:1:2: executing \"v\" at <eq .bs .msi>: error calling eq: non-comparable types hi: []uint8, map[string]int: map[one:1 three:3 two:2]")
  vec(dj, "{{printf \"%*d %\#q \" .obj 1e3}}{{with 1i}}<{{range $i, $e := 0x1F}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}>{{else}}E{{end}}{{urlquery -3 (index .tags 1)}}", "%!(BADWIDTH)%!d(float64=1000) %!q(MISSING) <|ERR|template: v:1:60: executing \"v\" at <0x1F>: can't use 31 to iterate over more than one variable")
  vec(dt, "{{.t}}{{len .msi.four}}", "true|ERR|template: v:1:8: executing \"v\" at <len .msi.four>: error calling len: reflect: call of reflect.Value.Type on zero Value")
  vec(dj, "{{with .flag}}<{{printf \"%*d %+d %x \" .zero (printf \"%03d\" 7) 0x1F}}>{{else}}E{{end}}", "<|ERR|template: v:1:38: executing \"v\" at <.zero>: can't evaluate field zero in type bool")
  vec(dt, "{{gt .i .nm}}", "|ERR|template: v:1:2: executing \"v\" at <gt .i .nm>: error calling gt: invalid type for comparison")
  vec(dj, "{{.neg}}{{false | len}}", "-2|ERR|template: v:1:18: executing \"v\" at <len>: error calling len: len of type bool")
  vec(dt, "{{gt .nest.list .missing}}{{.bs | printf \"%q\"}}", "|ERR|template: v:1:2: executing \"v\" at <gt .nest.list .missing>: error calling gt: invalid type for comparison")
  vec(dj, "{{printf \"%d \" nil}}", "%!d(<nil>) ")
  vec(dt, "{{range $i, $e := 'c'}}{{$i}}={{$e}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <'c'>: can't use 99 to iterate over more than one variable")
  vec(dj, "{{.obj.y | html}}{{if 2.5}}T{{.zero}}{{else}}F{{end}}{{index 1i}}", "&lt;no value&gt;T0(0+1i)")
  vec(dt, "{{.missing}}{{with .nest}}<{{print .st.B .}}>{{else}}E{{end}}{{index . 0}}", "<no value><<nil> map[list:[1 two 3 <nil> true] m:map[k:[7 8]]]>|ERR|template: v:1:63: executing \"v\" at <index . 0>: error calling index: value has type int; should be string")
  vec(dj, "{{and .obj.missing false}}", "<no value>")
  vec(dt, "{{range $i, $e := .r}}{{$i}}={{.}};{{else}}none{{end}}{{printf \"%G %+v \" . nil}}", "|ERR|template: v:1:18: executing \"v\" at <.r>: can't use 120 to iterate over more than one variable")
  vec(dj, "{{index (len .tags)}}{{print true nil}}", "3true <nil>")
  vec(dt, "{{ge 0 .}}{{not (index .sts 0)}}", "|ERR|template: v:1:2: executing \"v\" at <ge 0 .>: error calling ge: invalid type for comparison")
  vec(dj, "{{printf \"%E %U \" 1 .names.a}}", "%!E(int=1) %!U(string=A) ")
  vec(dt, "{{js .i8 (index .mis 2)}}", "-7b")
  vec(dj, "{{le .no true}}{{not .obj.missing}}{{.nul}}", "|ERR|template: v:1:2: executing \"v\" at <le .no true>: error calling le: invalid type for comparison")
  vec(dt, "{{gt .nm .f}}{{with (index .sts 0)}}<{{slice .i8 1}}>{{else}}E{{end}}{{lt (index .si 1) .r}}", "|ERR|template: v:1:2: executing \"v\" at <gt .nm .f>: error calling gt: invalid type for comparison")
  vec(dj, "{{or 1 \"str\"}}{{range $i, $e := .missing}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "1none")
}

test "exec vectors 21" {
  dj = vec_json()
  dt = vec_typed()
  vec(dt, "{{slice .e 2}}", "|ERR|template: v:1:2: executing \"v\" at <slice .e 2>: error calling slice: index out of range: 2")
  vec(dj, "{{range $i, $e := 1}}{{$i}}={{$e}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <1>: can't use 1 to iterate over more than one variable")
  vec(dt, "{{with .u16}}<{{printf \"%v %e \" .nest .mfb}}>{{else}}E{{end}}text {{$v := .st}}[{{$v}}]", "<|ERR|template: v:1:32: executing \"v\" at <.nest>: can't evaluate field nest in type uint16")
  vec(dj, "{{.neg}}{{len .obj}}", "-24")
  vec(dt, "{{not .ss}}{{not 1i}}", "falsefalse")
  vec(dj, "{{ge .tiny .missing}}{{.nums | eq 1}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .age}}", "|ERR|template: v:1:2: executing \"v\" at <ge .tiny .missing>: error calling ge: invalid type for comparison")
  vec(dt, "{{.msi.two | eq 1}}{{.st.C | html}}{{with .msi.two}}<{{1}}>{{else}}E{{end}}", "false[4]<1>")
  vec(dj, "{{range $i, $e := .obj.y}}{{$i}}={{$e}};{{else}}none{{end}}{{.obj.w | html}}", "nonewide")
  vec(dt, "{{(index .sts 0)}}", "{2  []}")
  vec(dj, "{{js .names .name}}{{range $i, $e := .obj}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{.no | eq 1}}", "map[a:A b:B c:]Annw=wide;x=1;y=<nil>;z=[1 2 map[k:v]];|ERR|template: v:1:96: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and bool")
  vec(dt, "{{$v := .si}}[{{$v}}]{{.i8}}{{printf \"%5.2f %z \" .u16 .mis}}", "[[5 10 15]]-7%!f(uint16=65535) map[%!z(int=1):%!z(string=a) %!z(int=2):%!z(string=b) %!z(int=3):%!z(string=c)] ")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0}}{{.nul}}{{printf \"%F %t \" 0x1F .no}}", "<0><no value>%!F(int=31) false ")
  vec(dt, "{{not .}}{{index .mis .sts}}{{index .ns}}", "false|ERR|template: v:1:11: executing \"v\" at <index .mis .sts>: error calling index: value has type []template.vecSt; should be int")
  vec(dj, "{{and \"str\" .names}}", "map[a:A b:B c:]")
  vec(dt, "{{with .st.A}}<{{not .nest.m.k}}>{{else}}E{{end}}{{\"str\" | html}}{{index 'c' .f}}", "<|ERR|template: v:1:26: executing \"v\" at <.nest.m.k>: can't evaluate field nest in type int")
  vec(dj, "{{$v := .empty}}[{{$v}}]{{and .obj.x nil}}", "[[]]<no value>")
  vec(dt, "{{1i}}text ", "(0+1i)text ")
  vec(dj, "{{.no}}", "false")
  vec(dt, "{{and .st.C .u64}}{{printf \"%\#x %*d %f \" .c .u64 .st.A}}", "18446744073709551615(0x1.8000p+00-0x1.0000p+01i) %!(BADWIDTH)1 %!f(MISSING) ")
  vec(dj, "{{or 0x1F \"str\"}}", "31")
  vec(dt, "{{if (index .si 1)}}T{{ne .sts .ss}}{{else}}F{{end}}", "T|ERR|template: v:1:23: executing \"v\" at <ne .sts .ss>: error calling ne: non-comparable type [x y]: []string")
  vec(dj, "{{not .uni}}", "false")
  vec(dt, "{{not .mis}}{{false | html}}", "falsefalse")
  vec(dj, "{{printf \"%s \" .obj.w}}", "wide ")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"str\"}}", "<str>")
  vec(dj, "{{ge 0x1F 'c'}}{{le .nums \"str\"}}", "false|ERR|template: v:1:17: executing \"v\" at <le .nums \"str\">: error calling le: invalid type for comparison")
  vec(dt, "{{.u16}}{{.sts}}", "65535[{2  []} {0 b []}]")
  vec(dj, "text {{index (index .nums 0)}}", "text 3")
  vec(dt, "{{not 'c'}}{{$v := \"str\"}}[{{$v}}]{{not true}}", "false[str]false")
  vec(dj, "{{eq .flag .tags 0x1F}}", "|ERR|template: v:1:2: executing \"v\" at <eq .flag .tags 0x1F>: error calling eq: incompatible types for comparison: bool and []interface {}")
  vec(dt, "{{printf \"%s \" 1}}{{html .ns .bs}}", "%!s(int=1) [] [104 105]")
  vec(dj, "{{printf \"%[2]v %[1]v %x \" .names .nul}}", "<nil> map[a:A b:B c:] %!x(<nil>) ")
  vec(dt, "text {{printf \"%p %E % x \" 1 .i8 .i}}{{$v := .mfb}}[{{$v}}]", "text %!p(int=1) %!E(int8=-7)  2a [map[-1:false 2.5:true]]")
  vec(dj, "{{.no | print}}", "false")
  vec(dt, "{{$v := .neg}}[{{$v}}]{{urlquery (index .si 1) .ns}}{{with .st}}<{{ge false 2.5}}>{{else}}E{{end}}", "[-17]10+%5B%5D<|ERR|template: v:1:67: executing \"v\" at <ge false 2.5>: error calling ge: incompatible types for comparison: bool and float64")
  vec(dj, "{{printf \"%\#v \" .tags}}{{\"\"}}{{with .obj.y}}<text >{{else}}E{{end}}", "[]interface {}{\"a\", \"b\", \"c\"} E")
  vec(dt, "{{with false}}<{{(slice .si 1 2)}}>{{else}}E{{end}}", "E")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" -3}}{{1}}", "<-3>1")
  vec(dt, "{{'c'}}{{println .f .mis}} - ", "992.5 map[1:a 2:b 3:c]\n - ")
  vec(dj, "{{slice 0x1F 0}}{{and .obj .s}}", "|ERR|template: v:1:2: executing \"v\" at <slice 0x1F 0>: error calling slice: can't slice item of type int")
  vec(dt, "{{println .st .st.B}}", "{1 bee [4]} bee\n")
  vec(dj, "{{not .nul}}{{(.obj.z) | printf \"%q\"}}", "true[%!q(float64=1) %!q(float64=2) map[\"k\":\"v\"]]")
  vec(dt, "{{lt .bs .i}}{{if .nest.m.k}}T{{not false}}{{else}}F{{end}}{{range $i, $e := .f32}}{{$i}}={{.}};{{else}}none{{end}}", "|ERR|template: v:1:2: executing \"v\" at <lt .bs .i>: error calling lt: invalid type for comparison")
  vec(dj, "{{$v := 1e3}}[{{$v}}]", "[1000]")
  vec(dt, "{{if 0x1F}}T{{ne .nest .missing}}{{else}}F{{end}}{{1i | not}}", "Ttruefalse")
  vec(dj, "{{\"str\"}}", "str")
  vec(dt, "{{ge false (index .nest.list 1)}}{{range $i, $e := .neg}}{{$i}}={{continue}};{{else}}none{{end}}", "|ERR|template: v:1:2: executing \"v\" at <ge false (index .nest.list 1)>: error calling ge: incompatible types for comparison: bool and string")
  vec(dj, "{{if 1}}T{{slice 0x1F 1}}{{else}}F{{end}}", "T|ERR|template: v:1:11: executing \"v\" at <slice 0x1F 1>: error calling slice: can't slice item of type int")
  vec(dt, "{{.i | printf \"%v\"}}{{or .bs (index .si 1)}}", "42[104 105]")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .s}}{{range $i, $e := .zero}}{{$i}}={{.}};{{else}}none{{end}}", "<<b>&'\"x\"</b> =>|ERR|template: v:1:67: executing \"v\" at <.zero>: range can't iterate over 0")
  vec(dt, "{{.e}}{{slice .sts 2}}", "[]")
  vec(dj, "text {{range $i, $e := \"\"}}{{$i}}={{$e}};{{else}}none{{end}} - ", "text |ERR|template: v:1:23: executing \"v\" at <\"\">: range can't iterate over ")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .st.B}}{{$v := .msi.two}}[{{$v}}]{{printf \"%+d %6.2g \" (index .mis 2) .st.A}}", "<bee>[2]%!d(string=b) %!g(int=    01) ")
  vec(dj, "{{or .flag 0}}{{with .name}}<{{range $i, $e := 1i}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}>{{else}}E{{end}}{{slice 0x1F 2}}", "true<|ERR|template: v:1:47: executing \"v\" at <1i>: range can't iterate over (0+1i)")
  vec(dt, "{{print .i8 .t}}{{index .st}}{{if .r}}T{{(index .si 1) | html}}{{else}}F{{end}}", "-7 true{1 bee [4]}T10")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" false}}{{.no}}", "<false>false")
  vec(dt, "{{println .f .bs}}", "2.5 [104 105]\n")
  vec(dj, "{{nil}}", "|ERR|template: v:1:2: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "{{.st.C | eq 1}}", "|ERR|template: v:1:10: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and []int")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj.missing}}", "<<no value>>")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .mis}}", "<map[1:a 2:b 3:c]>")
  vec(dj, "{{with (printf \"%03d\" 7)}}<{{index .obj.x .tiny}}>{{else}}E{{end}}{{range $i, $e := .obj}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "<|ERR|template: v:1:39: executing \"v\" at <.obj.x>: can't evaluate field obj in type string")
  vec(dt, "{{(slice .s 1 4) | not}}{{slice .nest.list 2}}{{ge (index .mis 2) (index .si 1)}}", "false[3 <nil> true]|ERR|template: v:1:48: executing \"v\" at <ge (index .mis 2) (index .si 1)>: error calling ge: incompatible types for comparison: string and int")
  vec(dj, "{{index 0}}{{range $i, $e := .zero}}{{$i}}={{$e}};{{else}}none{{end}}", "0|ERR|template: v:1:29: executing \"v\" at <.zero>: range can't iterate over 0")
  vec(dt, "{{.np}}{{gt .msi.two true}}", "<nil>|ERR|template: v:1:9: executing \"v\" at <gt .msi.two true>: error calling gt: incompatible types for comparison: int and bool")
  vec(dj, "{{.nul | eq 1}}", "false")
  vec(dt, "{{range $i, $e := .st.A}}{{$i}}={{.}};{{else}}none{{end}}{{.msi.two}}{{index .msi.four .i8}}", "|ERR|template: v:1:21: executing \"v\" at <.st.A>: can't use 1 to iterate over more than one variable")
  vec(dj, "{{printf \"%8.3e %.2s % x \" .tiny .big .obj.w}}", "1.500e-07 %!s(float64=1e+21) 77 69 64 65 ")
  vec(dt, "{{js 'c' .f}}", "99 2.5")
  vec(dj, "{{.tiny}}{{2.5 | len}}", "1.5e-07|ERR|template: v:1:17: executing \"v\" at <len>: error calling len: len of type float64")
  vec(dt, "{{printf \"%p %5.2f %F \" .neg (index .mis 2) nil}}", "%!p(int=-17) %!f(string=    b) %!F(<nil>) ")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (printf \"%03d\" 7)}}{{gt .uni (index .nums 0)}} - ", "<007>|ERR|template: v:1:66: executing \"v\" at <gt .uni (index .nums 0)>: error calling gt: incompatible types for comparison: string and float64")
  vec(dt, "{{range $i, $e := .st.C}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{if .st.C}}T{{range $i, $e := .e}}{{$i}}={{continue}};{{else}}none{{end}}{{else}}F{{end}}", "0=T|ERR|template: v:1:109: executing \"v\" at <.e>: range can't iterate over ")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .nums 0)}}", "<3>")
  vec(dt, "{{if .u64}}T{{and .mfb .si}}{{else}}F{{end}}{{$v := (slice .s 1 4)}}[{{$v}}]{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .st}}", "T[5 10 15][o &]<{1 bee [4]}>")
  vec(dj, "{{nil | printf \"%v\"}}", "|ERR|template: v:1:2: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "{{and .mis (index .msi \"one\")}}", "1")
  vec(dj, "{{with 2.5}}<{{if .obj}}T{{.missing}}{{else}}F{{end}}>{{else}}E{{end}}{{printf \"%\#v %! \" .obj (slice .tags 1)}}", "<|ERR|template: v:1:18: executing \"v\" at <.obj>: can't evaluate field obj in type float64")
  vec(dt, "{{gt .nest.list .nm}}{{$v := .}}[{{$v}}]", "|ERR|template: v:1:2: executing \"v\" at <gt .nest.list .nm>: error calling gt: invalid type for comparison")
  vec(dj, "{{printf \"%O \" .neg}}", "%!O(float64=-2) ")
  vec(dt, "{{.mis}}{{.sts | print}}", "map[1:a 2:b 3:c][{2  []} {0 b []}]")
  vec(dj, "{{.names}}{{printf \"%z \" .uni}}{{with 1i}}<{{$v := true}}[{{$v}}]>{{else}}E{{end}}", "map[a:A b:B c:]%!z(string=héllo, 世界) <[true]>")
  vec(dt, "{{with .e}}<{{lt .ss nil}}>{{else}}E{{end}}{{and (index .nest.list 1) .sts}}{{not .e}}", "E[{2  []} {0 b []}]true")
  vec(dj, "{{$v := .obj.w}}[{{$v}}]{{html .missing .zero}}{{range $i, $e := \"\"}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "[wide]&lt;no value&gt;0|ERR|template: v:1:65: executing \"v\" at <\"\">: range can't iterate over ")
  vec(dt, "{{ne .i .msi}}", "|ERR|template: v:1:2: executing \"v\" at <ne .i .msi>: error calling ne: incompatible types for comparison: int and map[string]int")
  vec(dj, "{{.pi | printf \"%q\"}}{{/* c */}}{{range $i, $e := -3}}{{$i}}={{continue}};{{else}}none{{end}}", "%!q(float64=3.14159)|ERR|template: v:1:50: executing \"v\" at <-3>: can't use -3 to iterate over more than one variable")
  vec(dt, "{{range $i, $e := .ss}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{range $i, $e := .s}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "0=|ERR|template: v:1:94: executing \"v\" at <.s>: range can't iterate over go & <alx>")
  vec(dj, "{{js .flag .age}}", "true 30")
  vec(dt, "{{with 1i}}<{{$v := nil}}[{{$v}}]>{{else}}E{{end}}{{$v := .msi.two}}[{{$v}}]", "<|ERR|template: v:1:20: executing \"v\" at <nil>: nil is not a command")
  vec(dj, "{{or .neg .uni}}", "-2")
  vec(dt, "text ", "text ")
  vec(dj, "{{le \"str\" -3}}{{println .obj.x .neg}}", "|ERR|template: v:1:2: executing \"v\" at <le \"str\" -3>: error calling le: incompatible types for comparison: string and int")
  vec(dt, "{{or (len .si) .t}}{{index .nest.m.k}}{{/* c */}}", "3[7 8]")
  vec(dj, "{{lt .zero .obj.w}}{{ne 1e3 .obj.w}}{{with true}}<{{.obj.missing}}>{{else}}E{{end}}", "|ERR|template: v:1:2: executing \"v\" at <lt .zero .obj.w>: error calling lt: incompatible types for comparison: float64 and string")
  vec(dt, "{{if nil}}T{{range $i, $e := .f}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{else}}F{{end}}{{urlquery .st.C nil}}{{print (index .si 1) .ss}}", "|ERR|template: v:1:5: executing \"v\" at <nil>: nil is not a command")
  vec(dj, "{{len .age}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0}}{{(printf \"%03d\" 7) | not}}", "|ERR|template: v:1:2: executing \"v\" at <len .age>: error calling len: len of type float64")
  vec(dt, "{{$v := .ns}}[{{$v}}]{{$v := .mis}}[{{$v}}]", "[[]][map[1:a 2:b 3:c]]")
  vec(dj, "{{range $i, $e := .uni}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{ne (index .nums 0) .names}}", "|ERR|template: v:1:18: executing \"v\" at <.uni>: range can't iterate over héllo, 世界")
  vec(dt, "{{and 0x1F .st.B}}{{if .msi}}T{{html . .i}}{{else}}F{{end}}{{if .msi}}T{{if .f32}}T{{nil}}{{else}}F{{end}}{{else}}F{{end}}", "beeTmap[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 &lt;nil&gt; true] m:map[k:[7 8]]] nm:map[] np:&lt;nil&gt; ns:[] r:120 s:go &amp; &lt;alx&gt; si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615] 42TT|ERR|template: v:1:85: executing \"v\" at <nil>: nil is not a command")
  vec(dj, "{{ge 1 \"str\"}}", "|ERR|template: v:1:2: executing \"v\" at <ge 1 \"str\">: error calling ge: incompatible types for comparison: int and string")
}

test "exec vectors 22" {
  dj = vec_json()
  dt = vec_typed()
  vec(dt, "{{gt .msi.four 2.5}}x", "|ERR|template: v:1:2: executing \"v\" at <gt .msi.four 2.5>: error calling gt: invalid type for comparison")
  vec(dj, "{{printf \"%05d %\#v %5.2f \" (len .tags) .pi .tiny}}{{len .flag}}{{printf \"% % d \" .zero 0x1F}}", "00003 3.14159  0.00 |ERR|template: v:1:52: executing \"v\" at <len .flag>: error calling len: len of type bool")
  vec(dt, "{{with .st.A}}<{{2.5}}>{{else}}E{{end}}{{lt .sts .nest.m.k}}", "<2.5>|ERR|template: v:1:41: executing \"v\" at <lt .sts .nest.m.k>: error calling lt: invalid type for comparison")
  vec(dj, "{{printf \"%+v %F %F \" .tiny $ .nums}}{{len (index .nums 0)}}{{with (len .tags)}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .nul}}>{{else}}E{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "{{le (slice .s 1 4) .ns}}", "|ERR|template: v:1:2: executing \"v\" at <le (slice .s 1 4) .ns>: error calling le: invalid type for comparison")
  vec(dj, "{{range $i, $e := .obj.y}}{{$i}}={{$e}};{{else}}none{{end}}", "none")
  vec(dt, "{{eq (index .nest.list 1) (index .msi \"one\")}}{{html 2.5 .st.B}}", "|ERR|template: v:1:2: executing \"v\" at <eq (index .nest.list 1) (index .msi \"one\")>: error calling eq: incompatible types for comparison: string and int")
  vec(dj, "{{lt .s .zero}}", "|ERR|template: v:1:2: executing \"v\" at <lt .s .zero>: error calling lt: incompatible types for comparison: string and float64")
  vec(dt, "{{$v := .f}}[{{$v}}]{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .ss}}{{or .neg .msi}}", "[2.5]<[x y]>-17")
  vec(dj, "{{println .uni false}}{{if .obj.z}}T{{printf \"%! \" $}}{{else}}F{{end}}", "héllo, 世界 false\nTmap[%!!(string=age):%!!(float64=30) %!!(string=big):%!!(float64=1e+21) %!!(string=empty):[] %!!(string=flag):%!!(bool=true) %!!(string=name):%!!(string=Ann) %!!(string=names):map[%!!(string=a):%!!(string=A) %!!(string=b):%!!(string=B) %!!(string=c):%!!(string=)] %!!(string=neg):%!!(float64=-2) %!!(string=no):%!!(bool=false) %!!(string=nul):<nil> %!!(string=nums):[%!!(float64=3) %!!(float64=1) %!!(float64=2)] %!!(string=obj):map[%!!(string=w):%!!(string=wide) %!!(string=x):%!!(float64=1) %!!(string=y):<nil> %!!(string=z):[%!!(float64=1) %!!(float64=2) map[%!!(string=k):%!!(string=v)]]] %!!(string=pi):%!!(float64=3.14159) %!!(string=s):%!!(string=<b>&'\"x\"</b> =) %!!(string=tags):[%!!(string=a) %!!(string=b) %!!(string=c)] %!!(string=tiny):%!!(float64=1.5e-07) %!!(string=uni):%!!(string=héllo, 世界) %!!(string=zero):%!!(float64=0)] ")
  vec(dt, "{{.nm | eq 1}}{{and .st.A .mis}}{{printf \"%q %.2s \" .neg .nest}}", "|ERR|template: v:1:8: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and map[string]int")
  vec(dj, "{{.uni}}{{printf \"% %05d \" (slice .tags 1) (slice .tags 1)}}", "héllo, 世界%05d %!(EXTRA []interface {}=[b c], []interface {}=[b c])")
  vec(dt, "{{printf \"%.2s \" 1i}}{{range $i, $e := .ns}}{{$i}}={{$e}};{{else}}none{{end}}{{range $i, $e := .t}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "%!s(complex128=(0+1i)) none|ERR|template: v:1:95: executing \"v\" at <.t>: range can't iterate over true")
  vec(dj, "{{printf \"%E \" nil}}{{or .names .obj.z}}", "%!E(<nil>) map[a:A b:B c:]")
  vec(dt, "{{if .mfb}}T{{with .mfb}}<{{$v := .e}}[{{$v}}]>{{else}}E{{end}}{{else}}F{{end}}{{printf \"%E %.0f \" .c (index .sts 0)}}", "T<|ERR|template: v:1:34: executing \"v\" at <.e>: can't evaluate field e in type map[float64]bool")
  vec(dj, "{{/* c */}}{{or 'c' .obj.z}}", "99")
  vec(dt, "{{range $i, $e := .i}}{{$i}}={{.}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <.i>: can't use 42 to iterate over more than one variable")
  vec(dj, "{{range $i, $e := false}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{0x1F}}", "|ERR|template: v:1:18: executing \"v\" at <false>: range can't iterate over false")
  vec(dt, "{{with nil}}<{{le .neg .bs}}>{{else}}E{{end}}{{len (index .mis 2)}}{{if .st.C}}T{{.nm | eq 1}}{{else}}F{{end}}", "|ERR|template: v:1:7: executing \"v\" at <nil>: nil is not a command")
  vec(dj, "{{and -3 .obj.w}}{{gt .obj.w .no}}{{if .big}}T{{gt false \"str\"}}{{else}}F{{end}}", "wide|ERR|template: v:1:19: executing \"v\" at <gt .obj.w .no>: error calling gt: incompatible types for comparison: string and bool")
  vec(dt, "{{not -3}}{{or .ns (index .si 1)}}{{- \" trim \" -}}", "false10 trim ")
  vec(dj, "{{.tiny | eq 1}}{{0}}{{$v := -3}}[{{$v}}]", "|ERR|template: v:1:10: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and float64")
  vec(dt, "{{print .mfb (len .si)}}", "map[-1:false 2.5:true] 3")
  vec(dj, "{{(index .tags 1)}}", "b")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"str\"}}", "<str>")
  vec(dj, "{{not .obj}}", "false")
  vec(dt, "{{range $i, $e := .e}}{{$i}}={{continue}};{{else}}none{{end}}{{if .}}T{{if .i}}T{{not .st.A}}{{else}}F{{end}}{{else}}F{{end}}{{nil}}", "|ERR|template: v:1:18: executing \"v\" at <.e>: range can't iterate over ")
  vec(dj, "{{if 1e3}}T{{.names | html}}{{else}}F{{end}}{{.obj.y}}", "Tmap[a:A b:B c:]<no value>")
  vec(dt, "{{- \" trim \" -}}", " trim ")
  vec(dj, "{{or .missing .age}}text {{range $i, $e := -3}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "30text |ERR|template: v:1:43: executing \"v\" at <-3>: can't use -3 to iterate over more than one variable")
  vec(dt, "{{. | not}}{{.bs | html}}{{not -3}}", "false[104 105]false")
  vec(dj, "{{with .tiny}}<{{$v := \"str\"}}[{{$v}}]>{{else}}E{{end}}{{slice .no 0}}{{if $}}T{{.nums}}{{else}}F{{end}}", "<[str]>|ERR|template: v:1:57: executing \"v\" at <slice .no 0>: error calling slice: can't slice item of type bool")
  vec(dt, "{{range $i, $e := .nm}}{{$i}}={{$e}};{{else}}none{{end}}", "none")
  vec(dj, "{{urlquery 'c' .pi}}{{if .zero}}T{{.tiny}}{{else}}F{{end}}", "99+3.14159F")
  vec(dt, "{{1i}}{{range $i, $e := 2.5}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{.st.A | print}}", "(0+1i)|ERR|template: v:1:24: executing \"v\" at <2.5>: range can't iterate over 2.5")
  vec(dj, "{{not 'c'}}{{js .s (index .nums 0)}}{{printf \"%d %[2]v %[1]v \" . false}}", "false\\u003Cb\\u003E\\u0026\\'\\\"x\\\"\\u003C/b\\u003E \\u003D3map[%!d(string=age):%!d(float64=30) %!d(string=big):%!d(float64=1e+21) %!d(string=empty):[] %!d(string=flag):%!d(bool=true) %!d(string=name):%!d(string=Ann) %!d(string=names):map[%!d(string=a):%!d(string=A) %!d(string=b):%!d(string=B) %!d(string=c):%!d(string=)] %!d(string=neg):%!d(float64=-2) %!d(string=no):%!d(bool=false) %!d(string=nul):<nil> %!d(string=nums):[%!d(float64=3) %!d(float64=1) %!d(float64=2)] %!d(string=obj):map[%!d(string=w):%!d(string=wide) %!d(string=x):%!d(float64=1) %!d(string=y):<nil> %!d(string=z):[%!d(float64=1) %!d(float64=2) map[%!d(string=k):%!d(string=v)]]] %!d(string=pi):%!d(float64=3.14159) %!d(string=s):%!d(string=<b>&'\"x\"</b> =) %!d(string=tags):[%!d(string=a) %!d(string=b) %!d(string=c)] %!d(string=tiny):%!d(float64=1.5e-07) %!d(string=uni):%!d(string=héllo, 世界) %!d(string=zero):%!d(float64=0)] false map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0] ")
  vec(dt, "{{printf \"%q \" .bs}}{{printf \"%x %v %\#U \" .st.C 0x1F .mfb}}{{0x1F | eq 1}}", "\"hi\" [4] 31 map[%!U(float64=-1.00000):%!U(bool=false) %!U(float64=2.50000):%!U(bool=true)] false")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .name}}{{printf \"%T %U \" (index .tags 1) $}}", "<Ann>string map[%!U(string=age):%!U(float64=30) %!U(string=big):%!U(float64=1e+21) %!U(string=empty):[] %!U(string=flag):%!U(bool=true) %!U(string=name):%!U(string=Ann) %!U(string=names):map[%!U(string=a):%!U(string=A) %!U(string=b):%!U(string=B) %!U(string=c):%!U(string=)] %!U(string=neg):%!U(float64=-2) %!U(string=no):%!U(bool=false) %!U(string=nul):<nil> %!U(string=nums):[%!U(float64=3) %!U(float64=1) %!U(float64=2)] %!U(string=obj):map[%!U(string=w):%!U(string=wide) %!U(string=x):%!U(float64=1) %!U(string=y):<nil> %!U(string=z):[%!U(float64=1) %!U(float64=2) map[%!U(string=k):%!U(string=v)]]] %!U(string=pi):%!U(float64=3.14159) %!U(string=s):%!U(string=<b>&'\"x\"</b> =) %!U(string=tags):[%!U(string=a) %!U(string=b) %!U(string=c)] %!U(string=tiny):%!U(float64=1.5e-07) %!U(string=uni):%!U(string=héllo, 世界) %!U(string=zero):%!U(float64=0)] ")
