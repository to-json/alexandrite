  vec(dt, "{{range $i, $e := 0}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <0>: can't use 0 to iterate over more than one variable")
