  vec(dj, " - {{index .obj.missing .no}}{{printf \"%\#v %o %8.3e \" .big .names.a .uni}}", " - |ERR|template: v:1:5: executing \"v\" at <index .obj.missing .no>: error calling index: index of untyped nil")
