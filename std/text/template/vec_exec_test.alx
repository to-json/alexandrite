  vec(dt, "{{printf \"%z %z %-10q| \" nil .nm .nest.m.k}}{{lt .f32 (index .msi \"one\")}}{{gt .missing (index .mis 2)}}", "%!z(<nil>) map[] ['\\a'       '\\b'      ]| |ERR|template: v:1:46: executing \"v\" at <lt .f32 (index .msi \"one\")>: error calling lt: incompatible types for comparison: float32 and int")
