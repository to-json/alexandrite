  vec(dj, "{{(.obj.z)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj.z}}{{.tiny}}", "[1 2 map[k:v]]<[1 2 map[k:v]]>1.5e-07")
