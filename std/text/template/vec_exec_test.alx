  vec(dt, "{{- \" trim \" -}}{{gt .t 1i}}{{$v := .}}[{{$v}}]", " trim |ERR|template: v:1:18: executing \"v\" at <gt .t 1i>: error calling gt: incompatible types for comparison: bool and complex128")
  vec(dj, "{{.flag}}", "true")
  vec(dt, "{{range $i, $e := .r}}{{$i}}={{$e}};{{else}}none{{end}}{{range $i, $e := .missing}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{or .st.B .nest.list}}", "|ERR|template: v:1:18: executing \"v\" at <.r>: can't use 120 to iterate over more than one variable")
  vec(dj, "{{not .obj.missing}}", "true")
  vec(dt, "{{.}}{{printf \"%x %05d %U \" .nest .missing .e}}{{with .msi.four}}<{{gt 1 nil}}>{{else}}E{{end}}", "map[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 <nil> true] m:map[k:[7 8]]] nm:map[] np:<nil> ns:[] r:120 s:go & <alx> si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615]map[6c697374:[1 74776f 0x1.8p+01 <nil> %!x(bool=true)] 6d:map[6b:[7 8]]] %!d(<nil>) %!U(string=) E")
  vec(dj, "{{urlquery .s .nul}}{{and false .names.a}}", "%3Cb%3E%26%27%22x%22%3C%2Fb%3E+%3D%3Cno+value%3Efalse")
  vec(dt, "{{printf \"%+d %c %b \" .si true 'c'}}{{- \" trim \" -}}", "[+5 +10 +15] %!c(bool=true) 1100011  trim ")
  vec(dj, "{{print .obj.y (index .tags 1)}}", "<nil>b")
  vec(dt, "{{.f32}}{{$v := .st.A}}[{{$v}}]{{printf \"%b %e \" true (index .mis 2)}}", "0.1[1]%!b(bool=true) %!e(string=b) ")
  vec(dj, "{{range $i, $e := (len .tags)}}{{$i}}={{$e}};{{else}}none{{end}}{{with .obj.x}}<{{range $i, $e := .name}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}>{{else}}E{{end}}", "|ERR|template: v:1:23: executing \"v\" at <.tags>: can't use 3 to iterate over more than one variable")
  vec(dt, "{{.msi}}{{len (len .si)}}", "map[one:1 three:3 two:2]|ERR|template: v:1:10: executing \"v\" at <len (len .si)>: error calling len: len of type int")
