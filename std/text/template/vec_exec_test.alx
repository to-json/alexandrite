test "exec vectors 29" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{.tiny}}{{.name | not}}", "1.5e-07false")
  vec(dt, "{{if .u64}}T{{len .e}}{{else}}F{{end}}{{eq .ss (index .sts 0)}}", "T0|ERR|template: v:1:40: executing \"v\" at <eq .ss (index .sts 0)>: error calling eq: non-comparable types [x y]: []string, template.vecSt: {2  []}")
  vec(dj, "{{lt .neg false}}{{ne .pi .names}}{{range $i, $e := -3}}{{$i}}={{continue}};{{else}}none{{end}}", "|ERR|template: v:1:2: executing \"v\" at <lt .neg false>: error calling lt: incompatible types for comparison: float64 and bool")
  vec(dt, "{{with .nest.m.k}}<{{index .bs .t}}>{{else}}E{{end}}{{eq -3 'c' .i8}}", "<|ERR|template: v:1:27: executing \"v\" at <.bs>: can't evaluate field bs in type []int")
  vec(dj, "{{range $i, $e := 1e3}}{{$i}}={{$e}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <1e3>: range can't iterate over 1000")
  vec(dt, "{{if .st.B}}T{{index .c .st}}{{else}}F{{end}}", "T|ERR|template: v:1:15: executing \"v\" at <index .c .st>: error calling index: can't index item of type complex128")
  vec(dj, "{{println $ (printf \"%03d\" 7)}}", "map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0] 007\n")
  vec(dt, "{{$v := .st.B}}[{{$v}}]{{len .mis}}{{- \" trim \" -}}", "[bee]3 trim ")
  vec(dj, "{{.nums}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .big}}{{printf \"%.*f %x %g \" .tags 2.5 .obj.y}}", "[3 1 2]<1e+21>%!(BADPREC)2.500000 %!x(<nil>) %!g(MISSING) ")
  vec(dt, "{{printf \"%T \" (index .msi \"one\")}}", "int ")
  vec(dj, "{{printf \"%b %[2]v %[1]v \" .nums .name}}{{$}}", "[6755399441055744p-51 4503599627370496p-52 4503599627370496p-51] Ann [3 1 2] map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]")
  vec(dt, "{{and . (slice .s 1 4)}}", "o &")
  vec(dj, "{{(index .nums 0)}}{{printf \"%\#q %-10q| \" . .name}}", "3map[`age`:%!q(float64=30.0000) `big`:%!q(float64=1.00000e+21) `empty`:[] `flag`:%!q(bool=true) `name`:`Ann` `names`:map[`a`:`A` `b`:`B` `c`:``] `neg`:%!q(float64=-2.00000) `no`:%!q(bool=false) `nul`:<nil> `nums`:[%!q(float64=3.00000) %!q(float64=1.00000) %!q(float64=2.00000)] `obj`:map[`w`:`wide` `x`:%!q(float64=1.00000) `y`:<nil> `z`:[%!q(float64=1.00000) %!q(float64=2.00000) map[`k`:`v`]]] `pi`:%!q(float64=3.14159) `s`:`<b>&'\"x\"</b> =` `tags`:[`a` `b` `c`] `tiny`:%!q(float64=1.50000e-07) `uni`:`héllo, 世界` `zero`:%!q(float64=0.00000)] \"Ann\"     | ")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .msi.two}}{{index .ns}}{{index .c 2.5}}", "<2>[]|ERR|template: v:1:70: executing \"v\" at <index .c 2.5>: error calling index: can't index item of type complex128")
  vec(dj, "{{or (index .tags 1) .age}}", "b")
  vec(dt, "{{eq .nm (index .mis 2)}}", "|ERR|template: v:1:2: executing \"v\" at <eq .nm (index .mis 2)>: error calling eq: incompatible types for comparison: map[string]int and string")
  vec(dj, "{{.obj.y | not}}{{ne 1i true}}", "true|ERR|template: v:1:18: executing \"v\" at <ne 1i true>: error calling ne: incompatible types for comparison: complex128 and bool")
  vec(dt, "{{len .e}}{{printf \"%-5d| \" 'c'}}", "099   | ")
