  vec(dt, "{{.f32}}", "0.1")
  vec(dj, "{{html (index .nums 0) 1e3}}", "3 1000")
  vec(dt, "{{printf \"%z %O \" .missing .u16}}", "%!z(<nil>) 0o177777 ")
  vec(dj, "{{eq (slice .tags 1) \"str\"}}{{$v := .obj.w}}[{{$v}}]{{if true}}T{{printf \"% x %p \" .names.a .empty}}{{else}}F{{end}}", "|ERR|template: v:1:2: executing \"v\" at <eq (slice .tags 1) \"str\">: error calling eq: incompatible types for comparison: []interface {} and string")
  vec(dt, "{{le .mfb 2.5}}{{index .nest}}", "|ERR|template: v:1:2: executing \"v\" at <le .mfb 2.5>: error calling le: invalid type for comparison")
  vec(dj, "{{.names | len}}{{.tiny}}{{not .obj}}", "31.5e-07false")
  vec(dt, "{{le \"str\" .st.C}}{{println true .msi.four}}{{$v := .ss}}[{{$v}}]", "|ERR|template: v:1:2: executing \"v\" at <le \"str\" .st.C>: error calling le: invalid type for comparison")
  vec(dj, "{{and 0 $}}{{if (index .obj.z 2)}}T{{printf \"%b \" .name}}{{else}}F{{end}}", "0T%!b(string=Ann) ")
  vec(dt, "{{1}}", "1")
  vec(dj, "{{if 1e3}}T{{slice 1i 1}}{{else}}F{{end}}{{.obj.y}}{{printf \"%f %d \" \"\" .}}", "T|ERR|template: v:1:13: executing \"v\" at <slice 1i 1>: error calling slice: can't slice item of type complex128")
  vec(dt, "{{with .neg}}<{{ne .mfb .neg}}>{{else}}E{{end}}{{.st | not}}", "<|ERR|template: v:1:19: executing \"v\" at <.mfb>: can't evaluate field mfb in type int")
  vec(dj, "{{range $i, $e := .zero}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{js (printf \"%03d\" 7) .obj.w}}", "|ERR|template: v:1:18: executing \"v\" at <.zero>: range can't iterate over 0")
