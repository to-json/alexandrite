  vec(dt, "{{.e | printf \"%v\"}}", "")
  vec(dj, "{{or .flag .}}{{$v := .obj.z}}[{{$v}}]", "true[[1 2 map[k:v]]]")
}

test "exec vectors 6" {
  dj = vec_json()
  dt = vec_typed()
  vec(dt, "{{.st}}{{urlquery .i \"str\"}}{{or 2.5 .st.B}}", "{1 bee [4]}42str2.5")
  vec(dj, "{{if (printf \"%03d\" 7)}}T{{range $i, $e := .uni}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{else}}F{{end}}{{$v := (len .tags)}}[{{$v}}]{{index 1i .obj.y}}", "T|ERR|template: v:1:43: executing \"v\" at <.uni>: range can't iterate over héllo, 世界")
