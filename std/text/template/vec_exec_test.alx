  vec(dj, "{{or .empty (slice .tags 1)}}{{$v := .no}}[{{$v}}]{{$v := .big}}[{{$v}}]", "[b c][false][1e+21]")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .nest.list}}{{and .nest.list .e}}{{not .u64}}", "<[1 two 3 <nil> true]>false")
  vec(dj, "{{printf \"%X \" (.obj.z)}} - ", "[0X1P+00 0X1P+01 map[6B:76]]  - ")
  vec(dt, "{{- \" trim \" -}}", " trim ")
  vec(dj, "{{.obj.x | printf \"%v\"}}{{$v := $}}[{{$v}}]{{0x1F}}", "1[map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]]31")
  vec(dt, "{{or .c .i8}}{{printf \"%G %o \" .st.A .msi.four}}", "(1.5-2i)%!G(int=1) %!o(<nil>) ")
  vec(dj, "{{(index .tags 1) | printf \"%q\"}}{{(.obj.z) | print}}", "\"b\"[1 2 map[k:v]]")
  vec(dt, "{{printf \"%x %p %[2]v %[1]v \" 'c' .st -3}}", "63 %!p(template.vecSt={1 bee [4]}) {1 bee [4]} 99 ")
  vec(dj, "{{range $i, $e := (index .nums 0)}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{len true}}{{len 'c'}}", "|ERR|template: v:1:31: executing \"v\" at <0>: range can't iterate over 3")
  vec(dt, "text {{with .i8}}<{{le .mfb 'c'}}>{{else}}E{{end}}{{0x1F | printf \"%q\"}}", "text <|ERR|template: v:1:23: executing \"v\" at <.mfb>: can't evaluate field mfb in type int8")
  vec(dj, "{{if \"str\"}}T{{eq .flag (len .tags) (index .tags 1)}}{{else}}F{{end}}{{- \" trim \" -}}", "T|ERR|template: v:1:15: executing \"v\" at <eq .flag (len .tags) (index .tags 1)>: error calling eq: incompatible types for comparison: bool and int")
  vec(dt, "{{eq .c .s}}{{.mis}}", "|ERR|template: v:1:2: executing \"v\" at <eq .c .s>: error calling eq: incompatible types for comparison: complex128 and string")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj}}{{printf \"%f \" (.obj.z)}}{{gt .uni (index .nums 0)}}", "<map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]]>[1.000000 2.000000 map[%!f(string=k):%!f(string=v)]] |ERR|template: v:1:78: executing \"v\" at <gt .uni (index .nums 0)>: error calling gt: incompatible types for comparison: string and float64")
  vec(dt, "{{printf \"%T %t \" .nest .si}}", "map[string]interface {} [%!t(int=5) %!t(int=10) %!t(int=15)] ")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .no}}", "<false>")
  vec(dt, "{{1 | not}}{{/* c */}}", "false")
  vec(dj, "{{print .obj.missing .nul}}{{2.5}}", "<nil> <nil>2.5")
  vec(dt, "{{.st.B}}", "bee")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (.obj.z)}}{{$v := 1i}}[{{$v}}]{{ge false nil}}", "<[1 2 map[k:v]]>[(0+1i)]|ERR|template: v:1:77: executing \"v\" at <ge false nil>: error calling ge: invalid type for comparison")
  vec(dt, "x", "x")
  vec(dj, "{{if (slice .tags 1)}}T{{range $i, $e := .age}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{else}}F{{end}}{{.neg | len}}", "T|ERR|template: v:1:41: executing \"v\" at <.age>: range can't iterate over 30")
  vec(dt, "{{printf \"%p %\#q %5.2f \" 2.5 (index .sts 0) .f32}}", "%!p(float64=2.5) {'\\x02' `` []}  0.10 ")
}

test "exec vectors 14" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{range $i, $e := .names.a}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{with $}}<{{.missing | printf \"%q\"}}>{{else}}E{{end}}", "|ERR|template: v:1:24: executing \"v\" at <.names.a>: range can't iterate over A")
  vec(dt, "text {{range $i, $e := .sts}}{{$i}}={{continue}};{{else}}none{{end}}{{with -3}}<{{printf \"%.*f \" (slice .si 1 2)}}>{{else}}E{{end}}", "text 0=1=<|ERR|template: v:1:104: executing \"v\" at <.si>: can't evaluate field si in type int")
  vec(dj, "{{html .names nil}}{{html .obj.missing \"str\"}}", "map[a:A b:B c:]&lt;no value&gt;&lt;no value&gt;str")
  vec(dt, "{{$v := .nest}}[{{$v}}]{{$v := .u64}}[{{$v}}]", "[map[list:[1 two 3 <nil> true] m:map[k:[7 8]]]][18446744073709551615]")
  vec(dj, "{{nil}}{{.tiny}}{{if \"str\"}}T - {{else}}F{{end}}", "|ERR|template: v:1:2: executing \"v\" at <nil>: nil is not a command")
