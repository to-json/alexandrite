  vec(dt, "{{.c}}", "(1.5-2i)")
  vec(dj, "{{printf \"%10s| \" .names.a}}", "         A| ")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .}}{{if (index .mis 2)}}T - {{else}}F{{end}}{{not .t}}", "<map[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 <nil> true] m:map[k:[7 8]]] nm:map[] np:<nil> ns:[] r:120 s:go & <alx> si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615]>T - false")
  vec(dj, "{{index .no 0x1F}}{{gt .obj.x .obj.w}}{{len .name}}", "|ERR|template: v:1:2: executing \"v\" at <index .no 0x1F>: error calling index: can't index item of type bool")
  vec(dt, "{{if .nm}}T{{urlquery (index .si 1) .t}}{{else}}F{{end}}", "F")
  vec(dj, "{{gt .pi .neg}}{{and .missing .zero}}{{index .name}}", "true<no value>Ann")
  vec(dt, "{{js .c (slice .s 1 4)}}{{.s}}", "(1.5-2i)o \\u0026go & <alx>")
}

test "exec vectors 15" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{with -3}}<{{printf \"%E \" 1e3}}>{{else}}E{{end}}{{.obj.x}}{{printf \"%x %t %.*f \" \"str\" .obj.missing (slice .tags 1)}}", "<1.000000E+03 >1737472 %!t(<nil>) %!(BADPREC)%!f(MISSING) ")
  vec(dt, "{{println \"str\" .st.A}}", "str 1\n")
  vec(dj, "{{gt .neg 2.5}}{{not .name}}", "falsefalse")
  vec(dt, "{{.f32}}{{lt true \"str\"}}{{with .msi.two}}<{{$v := .f}}[{{$v}}]>{{else}}E{{end}}", "0.1|ERR|template: v:1:10: executing \"v\" at <lt true \"str\">: error calling lt: incompatible types for comparison: bool and string")
  vec(dj, "{{and \"str\" 'c'}}{{.big}}", "991e+21")
  vec(dt, "{{range $i, $e := -3}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{printf \"%X %6.2g \" .si .st.C}}", "|ERR|template: v:1:18: executing \"v\" at <-3>: can't use -3 to iterate over more than one variable")
  vec(dj, "{{not (printf \"%03d\" 7)}}{{with .nul}}<{{if .flag}}T{{gt (index .tags 1) .empty}}{{else}}F{{end}}>{{else}}E{{end}}{{.names.a}}", "falseEA")
  vec(dt, "{{and true .e}}", "")
  vec(dj, "{{and .zero .zero}}", "0")
  vec(dt, "text ", "text ")
  vec(dj, "{{.obj.missing}}{{lt \"\" .}}", "<no value>|ERR|template: v:1:18: executing \"v\" at <lt \"\" .>: error calling lt: invalid type for comparison")
  vec(dt, "{{if .st.C}}T{{ne .ss .u64}}{{else}}F{{end}}", "T|ERR|template: v:1:15: executing \"v\" at <ne .ss .u64>: error calling ne: incompatible types for comparison: []string and uint64")
  vec(dj, "{{range $i, $e := $}}{{$i}}={{continue}};{{else}}none{{end}}text {{js .obj.y 2.5}}", "age=big=empty=flag=name=names=neg=no=nul=nums=obj=pi=s=tags=tiny=uni=zero=text \\u003Cno value\\u003E2.5")
  vec(dt, "{{with .u16}}<{{with (index .si 1)}}<{{(index .si 1)}}>{{else}}E{{end}}>{{else}}E{{end}}", "<|ERR|template: v:1:28: executing \"v\" at <.si>: can't evaluate field si in type uint16")
  vec(dj, "{{$v := (slice .tags 1)}}[{{$v}}]", "[[b c]]")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" -3}}{{index .u16 .si}}", "<-3>|ERR|template: v:1:51: executing \"v\" at <index .u16 .si>: error calling index: can't index item of type uint16")
  vec(dj, "{{ne 0x1F 1}}{{.uni | printf \"%v\"}}", "truehéllo, 世界")
  vec(dt, "{{$v := .bs}}[{{$v}}]{{.si}}{{or (len .si) 'c'}}", "[[104 105]][5 10 15]3")
  vec(dj, "{{0x1F}}{{.nums}}{{.obj.y | print}}", "31[3 1 2]<nil>")
  vec(dt, "{{ge 'c' .nest}}", "|ERR|template: v:1:2: executing \"v\" at <ge 'c' .nest>: error calling ge: invalid type for comparison")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .tags 1)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .age}}{{js .age .names}}", "PARSE:template: v:1: template: multiple definition of template \"t1\"")
  vec(dt, "{{slice .ss 2}}", "[]")
  vec(dj, "{{printf \"%*d \" .name}}{{$v := .names.a}}[{{$v}}]", "%!(BADWIDTH)%!d(MISSING) [A]")
  vec(dt, "{{printf \"% x \" .ns}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .si}}{{$v := 0}}[{{$v}}]", "[] <[5 10 15]>[0]")
  vec(dj, "{{printf \"%q %8.3e %f \" .missing .tiny .neg}}{{not .flag}}{{$v := .names}}[{{$v}}]", "%!q(<nil>) 1.500e-07 -2.000000 false[map[a:A b:B c:]]")
  vec(dt, "{{and .s .st}}{{(index .mis 2) | printf \"%v\"}}{{urlquery .f .msi}}", "{1 bee [4]}b2.5+map%5Bone%3A1+three%3A3+two%3A2%5D")
  vec(dj, "{{printf \"%G \" .uni}}", "%!G(string=héllo, 世界) ")
  vec(dt, "{{(index .mis 2) | not}}{{printf \"%8.3e \" false}}{{ge .missing .i}}", "false%!e(bool=   false) |ERR|template: v:1:51: executing \"v\" at <ge .missing .i>: error calling ge: invalid type for comparison")
  vec(dj, "{{ne .obj.x 2.5}}{{and .names \"\"}}{{not (index .tags 1)}}", "truefalse")
  vec(dt, "{{range $i, $e := .nest.m.k}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "0=7;1=8;")
  vec(dj, "{{.tags}}{{html (.obj.z) 1i}}", "[a b c][1 2 map[k:v]] (0+1i)")
  vec(dt, "{{range $i, $e := .s}}{{$i}}={{$e}};{{else}}none{{end}}{{and 0x1F 1}}x", "|ERR|template: v:1:18: executing \"v\" at <.s>: range can't iterate over go & <alx>")
  vec(dj, "{{$v := (printf \"%03d\" 7)}}[{{$v}}] - {{printf \"%T %\#x %6.2g \" .neg .tiny .pi}}", "[007] - float64 0x1.421f5f40d8376p-23    3.1 ")
  vec(dt, "{{.msi.four}}{{js .u64 .}}", "<no value>18446744073709551615 map[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 \\u003Cnil\\u003E true] m:map[k:[7 8]]] nm:map[] np:\\u003Cnil\\u003E ns:[] r:120 s:go \\u0026 \\u003Calx\\u003E si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615]")
  vec(dj, "{{gt .obj .tags}}{{- \" trim \" -}}{{.age | not}}", "|ERR|template: v:1:2: executing \"v\" at <gt .obj .tags>: error calling gt: invalid type for comparison")
  vec(dt, "{{not .si}}{{printf \"%O \" .si}}{{html (index .msi \"one\") true}}", "false[0o5 0o12 0o17] 1 true")
  vec(dj, "{{ge .name -3}}{{ne (index .nums 0) (printf \"%03d\" 7)}}{{or nil .obj.missing}}", "|ERR|template: v:1:2: executing \"v\" at <ge .name -3>: error calling ge: incompatible types for comparison: string and int")
  vec(dt, "{{ne .u64 .ss}}{{ge .st.C .nest.list}}{{len (index .mis 2)}}", "|ERR|template: v:1:2: executing \"v\" at <ne .u64 .ss>: error calling ne: incompatible types for comparison: uint64 and []string")
  vec(dj, "{{printf \"%05d %O %O \" .obj.w (len .tags) .uni}}", "%!d(string=0wide) 0o3 %!O(string=héllo, 世界) ")
  vec(dt, "{{if 2.5}}T{{eq .r .s}}{{else}}F{{end}}{{.i8 | len}}{{and .st.C .e}}", "T|ERR|template: v:1:13: executing \"v\" at <eq .r .s>: error calling eq: incompatible types for comparison: int32 and string")
  vec(dj, "{{.obj}}{{lt .big .obj.y}}{{html .obj.x 0x1F}}", "map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]]|ERR|template: v:1:10: executing \"v\" at <lt .big .obj.y>: error calling lt: invalid type for comparison")
  vec(dt, "{{gt 2.5 2.5}}", "false")
  vec(dj, "{{or .tiny .obj.z}}{{printf \"%05d \" .pi}}", "1.5e-07%!d(float64=3.14159) ")
  vec(dt, "{{ne (index .mis 2) .nm}}", "|ERR|template: v:1:2: executing \"v\" at <ne (index .mis 2) .nm>: error calling ne: incompatible types for comparison: string and map[string]int")
  vec(dj, "{{lt (.obj.z) .nums}}{{le .neg 1}}{{printf \"%q %-5d| \" \"\" 0}}", "|ERR|template: v:1:2: executing \"v\" at <lt (.obj.z) .nums>: error calling lt: invalid type for comparison")
  vec(dt, "{{len .ns}}{{range $i, $e := .np}}{{$i}}={{.}};{{else}}none{{end}}", "0|ERR|template: v:1:29: executing \"v\" at <.np>: range can't iterate over <nil>")
  vec(dj, "{{.empty | printf \"%v\"}}{{printf \"%x %c \" \"\" \"str\"}}", "[] %!c(string=str) ")
  vec(dt, "{{not .np}}", "true")
  vec(dj, " - ", " - ")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .np}}{{or .msi .c}}", "<<nil>>map[one:1 three:3 two:2]")
  vec(dj, "{{.flag}}{{with .age}}<{{gt -3 1}}>{{else}}E{{end}}{{not .uni}}", "true<false>false")
  vec(dt, "{{index 0 .c}}{{.u64}}", "|ERR|template: v:1:2: executing \"v\" at <index 0 .c>: error calling index: can't index item of type int")
  vec(dj, " - x", " - x")
