  vec(dj, "{{if .obj.z}}T - {{else}}F{{end}}{{and .empty $}}", "T - []")
  vec(dt, "{{(slice .s 1 4) | eq 1}}", "|ERR|template: v:1:19: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and string")
  vec(dj, "{{/* c */}}", "")
  vec(dt, "{{(index .msi \"one\")}}", "1")
  vec(dj, "{{len true}}", "|ERR|template: v:1:2: executing \"v\" at <len true>: error calling len: len of type bool")
  vec(dt, "{{\"str\" | len}}{{$v := .i8}}[{{$v}}]{{with .st.B}}<{{printf \"%G %s \" .e (index .mis 2)}}>{{else}}E{{end}}", "3[-7]<|ERR|template: v:1:69: executing \"v\" at <.e>: can't evaluate field e in type string")
  vec(dj, "{{if 0}}T{{false}}{{else}}F{{end}}{{- \" trim \" -}}{{printf \"%v %O %f \" .names.a .pi .obj.w}}", "F trim A %!O(float64=3.14159) %!f(string=wide) ")
  vec(dt, "{{js .i (index .si 1)}}", "42 10")
  vec(dj, "{{true}}{{printf \"%x %x %s \" 1i 1e3 1}}", "true(0x0p+00+0x1p+00i) 0x1.f4p+09 %!s(int=1) ")
  vec(dt, "{{js 'c' 0x1F}}{{not .u16}}", "99 31false")
  vec(dj, "{{printf \"%10s| %05d %U \" $ .zero .s}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .names}}", "map[       age:%!s(float64=        30)        big:%!s(float64=     1e+21)      empty:[]       flag:%!s(bool=      true)       name:       Ann      names:map[         a:         A          b:         B          c:          ]        neg:%!s(float64=        -2)         no:%!s(bool=     false)        nul:<nil>       nums:[%!s(float64=         3) %!s(float64=         1) %!s(float64=         2)]        obj:map[         w:      wide          x:%!s(float64=         1)          y:<nil>          z:[%!s(float64=         1) %!s(float64=         2) map[         k:         v]]]         pi:%!s(float64=   3.14159)          s:<b>&'\"x\"</b> =       tags:[         a          b          c]       tiny:%!s(float64=   1.5e-07)        uni: héllo, 世界       zero:%!s(float64=         0)]| %!d(float64=00000) %!U(string=<b>&'\"x\"</b> =) <map[a:A b:B c:]>")
  vec(dt, "{{$v := (index .msi \"one\")}}[{{$v}}]", "[1]")
  vec(dj, "{{if 'c'}}T{{if .obj.z}}T{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .big}}{{else}}F{{end}}{{else}}F{{end}}{{lt .obj.y .empty}}{{range $i, $e := .obj.missing}}{{$i}}={{.}};{{else}}none{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "text ", "text ")
  vec(dj, "{{printf \"%\#q \" .uni}}{{gt -3 (index .obj.z 2)}}", "`héllo, 世界` |ERR|template: v:1:24: executing \"v\" at <gt -3 (index .obj.z 2)>: error calling gt: invalid type for comparison")
  vec(dt, "{{le .st.A .si}}{{true}}{{.missing | printf \"%v\"}}", "|ERR|template: v:1:2: executing \"v\" at <le .st.A .si>: error calling le: invalid type for comparison")
