  vec(dt, "{{.nm | html}}", "map[]")
  vec(dj, "{{not .obj.x}}{{not true}}", "falsefalse")
  vec(dt, "{{len .i}}", "|ERR|template: v:1:2: executing \"v\" at <len .i>: error calling len: len of type int")
  vec(dj, " - text x", " - text x")
  vec(dt, "{{.t | printf \"%v\"}}{{printf \"% x \" .st.C}}", "true[ 4] ")
  vec(dj, "{{range $i, $e := .tags}}{{$i}}={{.}};{{else}}none{{end}}{{if .nums}}T{{printf \"%b %G %o \" .names.a .uni .tiny}}{{else}}F{{end}}", "0=a;1=b;2=c;T%!b(string=A) %!G(string=héllo, 世界) %!o(float64=1.5e-07) ")
  vec(dt, "{{or .f .t}}{{not .nest}}", "2.5false")
  vec(dj, "{{if \"\"}}T{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .pi}}{{else}}F{{end}}{{or .obj.y \"\"}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "{{not .np}}", "true")
  vec(dj, "{{2.5}}{{.flag}}{{eq .tiny .obj.w}}", "2.5true|ERR|template: v:1:18: executing \"v\" at <eq .tiny .obj.w>: error calling eq: incompatible types for comparison: float64 and string")
  vec(dt, "{{.st}}{{printf \"%t \" .ss}}{{$v := (index .si 1)}}[{{$v}}]", "{1 bee [4]}[%!t(string=x) %!t(string=y)] [10]")
  vec(dj, "{{- \" trim \" -}}", " trim ")
  vec(dt, "{{1i}}{{range $i, $e := 0}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .st.A}}", "(0+1i)|ERR|template: v:1:24: executing \"v\" at <0>: can't use 0 to iterate over more than one variable")
  vec(dj, "{{(index .tags 1) | print}}", "b")
  vec(dt, "{{urlquery .msi .mfb}}{{ne 0x1F .sts}}", "map%5Bone%3A1+three%3A3+two%3A2%5D+map%5B-1%3Afalse+2.5%3Atrue%5D|ERR|template: v:1:24: executing \"v\" at <ne 0x1F .sts>: error calling ne: incompatible types for comparison: int and []template.vecSt")
  vec(dj, "{{eq .obj 0 .obj.w}}", "|ERR|template: v:1:2: executing \"v\" at <eq .obj 0 .obj.w>: error calling eq: incompatible types for comparison: map[string]interface {} and int")
  vec(dt, "{{.msi.two | len}}", "|ERR|template: v:1:13: executing \"v\" at <len>: error calling len: len of type int")
  vec(dj, "{{ge .obj.x .}}", "|ERR|template: v:1:2: executing \"v\" at <ge .obj.x .>: error calling ge: invalid type for comparison")
  vec(dt, "{{with 0x1F}}<{{if .u16}}T{{(len .si)}}{{else}}F{{end}}>{{else}}E{{end}}{{- \" trim \" -}}", "<|ERR|template: v:1:19: executing \"v\" at <.u16>: can't evaluate field u16 in type int")
  vec(dj, "{{ne (.obj.z) .name}}{{printf \"%G %\#v \" .nums .nul}}{{with true}}<{{ge 0x1F 1}}>{{else}}E{{end}}", "|ERR|template: v:1:2: executing \"v\" at <ne (.obj.z) .name>: error calling ne: incompatible types for comparison: []interface {} and string")
  vec(dt, "{{or .msi.two 1i}}", "2")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .empty}}", "<[]>")
  vec(dt, "{{\"str\"}}{{printf \"%F \" 2.5}}{{.sts}}", "str2.500000 [{2  []} {0 b []}]")
  vec(dj, "{{lt .flag \"\"}}{{not .nul}}", "|ERR|template: v:1:2: executing \"v\" at <lt .flag \"\">: error calling lt: incompatible types for comparison: bool and string")
  vec(dt, "text {{printf \"%\#o \" .neg}}", "text -021 ")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (len .tags)}}{{\"str\" | eq 1}}{{$v := (len .tags)}}[{{$v}}]", "<3>|ERR|template: v:1:68: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and string")
  vec(dt, "{{.c}}{{$v := .e}}[{{$v}}]{{not (slice .s 1 4)}}", "(1.5-2i)[]false")
  vec(dj, "{{(len .tags)}}", "3")
  vec(dt, "{{println .r .msi.two}}", "120 2\n")
  vec(dj, "{{ge .tiny \"\"}}", "|ERR|template: v:1:2: executing \"v\" at <ge .tiny \"\">: error calling ge: incompatible types for comparison: float64 and string")
  vec(dt, "{{printf \"%x %t \" .st.A .st.C}}", "1 [%!t(int=4)] ")
}

test "exec vectors 13" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{if .nums}}T{{printf \"%\#q %O %\#v \" .obj.z .obj.z .name}}{{else}}F{{end}}{{$v := -3}}[{{$v}}]{{if 1e3}}T{{$v := 1}}[{{$v}}]{{else}}F{{end}}", "T[%!q(float64=1.00000) %!q(float64=2.00000) map[`k`:`v`]] [%!O(float64=1) %!O(float64=2) map[%!O(string=k):%!O(string=v)]] \"Ann\" [-3]T[1]")
  vec(dt, "{{.msi.four}}text {{$v := (index .sts 0)}}[{{$v}}]", "<no value>text [{2  []}]")
  vec(dj, "{{printf \"%! %t \" 2.5 .no}}", "%!!(float64=2.5) false ")
  vec(dt, "{{index .nm 0x1F}}{{not .si}}{{not nil}}", "|ERR|template: v:1:2: executing \"v\" at <index .nm 0x1F>: error calling index: value has type int; should be string")
  vec(dj, "{{printf \"%\#v %\#q %F \" (slice .tags 1) .age true}}{{not .age}}", "[]interface {}{\"b\", \"c\"} %!q(float64=30.0000) %!F(bool=true) false")
  vec(dt, "{{with .bs}}<{{print (index .msi \"one\") .u64}}>{{else}}E{{end}}{{.nm | eq 1}}{{js (len .si) .nm}}", "<|ERR|template: v:1:28: executing \"v\" at <.msi>: can't evaluate field msi in type []uint8")
  vec(dj, "{{false}}{{lt .tags .names.a}}", "false|ERR|template: v:1:11: executing \"v\" at <lt .tags .names.a>: error calling lt: invalid type for comparison")
  vec(dt, "{{1i}}{{with (index .msi \"one\")}}<{{slice .c 1}}>{{else}}E{{end}}", "(0+1i)<|ERR|template: v:1:42: executing \"v\" at <.c>: can't evaluate field c in type int")
  vec(dj, "{{with .zero}}<{{.nul}}>{{else}}E{{end}}{{.obj.y}} - ", "E<no value> - ")
  vec(dt, " - {{ne 1 .nm}}{{printf \"%q %d %x \" .nm -3 .np}}", " - |ERR|template: v:1:5: executing \"v\" at <ne 1 .nm>: error calling ne: incompatible types for comparison: int and map[string]int")
  vec(dj, "{{\"str\"}}", "str")
  vec(dt, "{{.nest.list}}{{len \"str\"}}", "[1 two 3 <nil> true]3")
  vec(dj, "{{range $i, $e := -3}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{.age}}{{lt $ -3}}", "|ERR|template: v:1:18: executing \"v\" at <-3>: can't use -3 to iterate over more than one variable")
  vec(dt, "{{print .neg .ss}}{{or true 'c'}}", "-17 [x y]true")
  vec(dj, "{{printf \"%.*f %+v %.0f \" (len .tags) .names.a .obj.missing}}{{with .names}}<{{ge .s .names.a}}>{{else}}E{{end}}", "%!f(string=A) <nil> %!f(MISSING) <|ERR|template: v:1:79: executing \"v\" at <ge .s .names.a>: error calling ge: invalid type for comparison")
  vec(dt, "{{le (index .mis 2) 1i}}{{gt \"str\" .nm}}", "|ERR|template: v:1:2: executing \"v\" at <le (index .mis 2) 1i>: error calling le: incompatible types for comparison: string and complex128")
  vec(dj, "{{printf \"%E %8.3e %g \" .obj.w 1i .obj}}{{js \"str\" .names}}", "%!E(string=wide) (0.000e+00+1.000e+00i) map[%!g(string=w):%!g(string=wide) %!g(string=x):1 %!g(string=y):<nil> %!g(string=z):[1 2 map[%!g(string=k):%!g(string=v)]]] strmap[a:A b:B c:]")
  vec(dt, "{{if .f32}}T{{and \"str\" .msi.four}}{{else}}F{{end}}{{or .msi.four .nm}}", "T<no value>map[]")
  vec(dj, "{{eq .pi .neg}}", "false")
  vec(dt, "{{not -3}}{{printf \"% x %.0f %\#U \" (slice .s 1 4) (slice .s 1 4) .s}}{{not .st.A}}", "false6f 20 26 %!f(string=) %!U(string=go & <alx>) false")
  vec(dj, "{{0x1F}}{{index .big}}", "311e+21")
  vec(dt, "{{.nest | printf \"%q\"}}{{if (index .msi \"one\")}}T{{not .nm}}{{else}}F{{end}}{{printf \"%X %10s| \" .bs .np}}", "map[\"list\":['\\x01' \"two\" %!q(float64=3) <nil> %!q(bool=true)] \"m\":map[\"k\":['\\a' '\\b']]]Ttrue6869 %!s(*int=     <nil>)| ")
  vec(dj, "{{index .empty .flag}}", "|ERR|template: v:1:2: executing \"v\" at <index .empty .flag>: error calling index: cannot index slice/array with type bool")
  vec(dt, "{{.}}{{with .i8}}<{{gt .t .msi.two}}>{{else}}E{{end}}", "map[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 <nil> true] m:map[k:[7 8]]] nm:map[] np:<nil> ns:[] r:120 s:go & <alx> si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615]<|ERR|template: v:1:23: executing \"v\" at <.t>: can't evaluate field t in type int8")
  vec(dj, "{{(printf \"%03d\" 7)}}", "007")
  vec(dt, "{{not .ns}}{{lt .f32 \"str\"}}", "true|ERR|template: v:1:13: executing \"v\" at <lt .f32 \"str\">: error calling lt: incompatible types for comparison: float32 and string")
  vec(dj, "{{printf \"%\#v %.2s \" .s 'c'}}{{range $i, $e := .flag}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{$v := .age}}[{{$v}}]", "\"<b>&'\\\"x\\\"</b> =\" %!s(int=99) |ERR|template: v:1:47: executing \"v\" at <.flag>: range can't iterate over true")
  vec(dt, "text {{- \" trim \" -}}{{ge .e (index .msi \"one\")}}", "text trim |ERR|template: v:1:23: executing \"v\" at <ge .e (index .msi \"one\")>: error calling ge: incompatible types for comparison: string and int")
  vec(dj, "{{\"\"}}", "")
  vec(dt, "{{$v := .msi}}[{{$v}}]text {{js .msi.two .si}}", "[map[one:1 three:3 two:2]]text 2 [5 10 15]")
  vec(dj, "{{range $i, $e := .tags}}{{$i}}={{continue}};{{else}}none{{end}}", "0=1=2=")
  vec(dt, "{{$v := .u16}}[{{$v}}]{{\"str\"}}", "[65535]str")
  vec(dj, "{{ge .obj.w .names.a}}{{.obj.z | html}}", "true[1 2 map[k:v]]")
  vec(dt, "{{.msi}}{{not (len .si)}}{{index .st}}", "map[one:1 three:3 two:2]false{1 bee [4]}")
  vec(dj, "{{slice (index .tags 1) 0}}{{ne .age (index .obj.z 2)}}", "b|ERR|template: v:1:29: executing \"v\" at <ne .age (index .obj.z 2)>: error calling ne: incompatible types for comparison: float64 and map[string]interface {}")
  vec(dt, "{{not (index .si 1)}}{{js 1 nil}}", "false1\\u003Cno value\\u003E")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj.x}}{{printf \"%\#q \" .names}}{{not .obj.z}}", "<1>map[`a`:`A` `b`:`B` `c`:``] false")
  vec(dt, "{{printf \"%05d %! \" 1 0x1F}}{{if (index .sts 0)}}T{{1}}{{else}}F{{end}}", "00001 %!!(int=31) T1")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" false}}{{0 | len}}{{print true .obj.z}}", "<false>|ERR|template: v:1:58: executing \"v\" at <len>: error calling len: len of type int")
  vec(dt, "{{lt nil .st.A}}{{urlquery .u64 \"str\"}}", "|ERR|template: v:1:2: executing \"v\" at <lt nil .st.A>: error calling lt: invalid type for comparison")
  vec(dj, "{{(index .tags 1) | eq 1}}", "|ERR|template: v:1:20: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and string")
  vec(dt, "{{and (slice .s 1 4) .msi.four}}", "<no value>")
  vec(dj, "{{.tiny}}{{ge . .missing}}", "1.5e-07|ERR|template: v:1:11: executing \"v\" at <ge . .missing>: error calling ge: invalid type for comparison")
  vec(dt, "{{len .r}}{{lt .s .st.C}}{{with (index .sts 0)}}<{{range $i, $e := .neg}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}>{{else}}E{{end}}", "|ERR|template: v:1:2: executing \"v\" at <len .r>: error calling len: len of type int32")
  vec(dj, "{{- \" trim \" -}}{{.empty}}{{range $i, $e := .obj.x}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", " trim []|ERR|template: v:1:48: executing \"v\" at <.obj.x>: range can't iterate over 1")
  vec(dt, "{{with .nest.m.k}}<{{ne .e true}}>{{else}}E{{end}}", "<|ERR|template: v:1:24: executing \"v\" at <.e>: can't evaluate field e in type []int")
  vec(dj, "{{eq .obj.missing .nul .neg}}{{printf \"%\#v %.0f \" $ (.obj.z)}}{{range $i, $e := \"str\"}}{{$i}}={{.}};{{else}}none{{end}}", "truemap[string]interface {}{\"age\":30, \"big\":1e+21, \"empty\":[]interface {}{}, \"flag\":true, \"name\":\"Ann\", \"names\":map[string]interface {}{\"a\":\"A\", \"b\":\"B\", \"c\":\"\"}, \"neg\":-2, \"no\":false, \"nul\":interface {}(nil), \"nums\":[]interface {}{3, 1, 2}, \"obj\":map[string]interface {}{\"w\":\"wide\", \"x\":1, \"y\":interface {}(nil), \"z\":[]interface {}{1, 2, map[string]interface {}{\"k\":\"v\"}}}, \"pi\":3.14159, \"s\":\"<b>&'\\\"x\\\"</b> =\", \"tags\":[]interface {}{\"a\", \"b\", \"c\"}, \"tiny\":1.5e-07, \"uni\":\"héllo, 世界\", \"zero\":0} [1 2 map[%!f(string=):%!f(string=)]] |ERR|template: v:1:80: executing \"v\" at <\"str\">: range can't iterate over str")
  vec(dt, "{{.nest.m.k | html}}{{printf \"%g %.0f \" (slice .s 1 4) .r}}", "[7 8]%!g(string=o &) %!f(int32=120) ")
