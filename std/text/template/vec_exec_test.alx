  vec(dt, "text {{index .nm .msi.two}}", "text |ERR|template: v:1:7: executing \"v\" at <index .nm .msi.two>: error calling index: value has type int; should be string")
  vec(dj, "{{\"str\"}}{{$v := .name}}[{{$v}}]", "str[Ann]")
