  vec(dt, "{{lt (slice .s 1 4) \"str\"}}{{ne .mis .r}}{{.u64}}", "true|ERR|template: v:1:29: executing \"v\" at <ne .mis .r>: error calling ne: incompatible types for comparison: map[int]string and int32")
  vec(dj, "{{/* c */}}{{$v := false}}[{{$v}}]{{- \" trim \" -}}", "[false] trim ")
