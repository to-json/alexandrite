  vec(dj, "{{$v := .tags}}[{{$v}}]{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .obj.z 2)}}{{range $i, $e := .pi}}{{$i}}={{.}};{{else}}none{{end}}", "[[a b c]]<map[k:v]>|ERR|template: v:1:104: executing \"v\" at <.pi>: range can't iterate over 3.14159")
  vec(dt, "{{not .np}}{{index .mfb (index .sts 0)}}", "true|ERR|template: v:1:13: executing \"v\" at <index .mfb (index .sts 0)>: error calling index: value has type template.vecSt; should be float64")
  vec(dj, "{{true}}{{. | printf \"%q\"}}{{\"\"}}", "truemap[\"age\":%!q(float64=30) \"big\":%!q(float64=1e+21) \"empty\":[] \"flag\":%!q(bool=true) \"name\":\"Ann\" \"names\":map[\"a\":\"A\" \"b\":\"B\" \"c\":\"\"] \"neg\":%!q(float64=-2) \"no\":%!q(bool=false) \"nul\":<nil> \"nums\":[%!q(float64=3) %!q(float64=1) %!q(float64=2)] \"obj\":map[\"w\":\"wide\" \"x\":%!q(float64=1) \"y\":<nil> \"z\":[%!q(float64=1) %!q(float64=2) map[\"k\":\"v\"]]] \"pi\":%!q(float64=3.14159) \"s\":\"<b>&'\\\"x\\\"</b> =\" \"tags\":[\"a\" \"b\" \"c\"] \"tiny\":%!q(float64=1.5e-07) \"uni\":\"héllo, 世界\" \"zero\":%!q(float64=0)]")
  vec(dt, "x{{urlquery .msi.two .mis}}", "x2+map%5B1%3Aa+2%3Ab+3%3Ac%5D")
  vec(dj, "{{and 0x1F -3}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .nums}}{{printf \"%T % d \" .empty .s}}", "-3<[3 1 2]>[]interface {} %!d(string=<b>&'\"x\"</b> =) ")
  vec(dt, "{{with \"str\"}}<{{.missing}}>{{else}}E{{end}}", "<|ERR|template: v:1:17: executing \"v\" at <.missing>: can't evaluate field missing in type string")
  vec(dj, "{{index .obj.x .tiny}}", "|ERR|template: v:1:2: executing \"v\" at <index .obj.x .tiny>: error calling index: can't index item of type float64")
  vec(dt, "{{not .st.A}}{{$v := .}}[{{$v}}]{{2.5 | not}}", "false[map[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 <nil> true] m:map[k:[7 8]]] nm:map[] np:<nil> ns:[] r:120 s:go & <alx> si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615]]false")
  vec(dj, "{{not $}}{{slice .age 0}}", "false|ERR|template: v:1:11: executing \"v\" at <slice .age 0>: error calling slice: can't slice item of type float64")
  vec(dt, "{{and 1 .s}}{{print .u16 .nm}}{{if (len .si)}}T{{with 1i}}<{{(index .si 1)}}>{{else}}E{{end}}{{else}}F{{end}}", "go & <alx>65535 map[]T<|ERR|template: v:1:68: executing \"v\" at <.si>: can't evaluate field si in type complex128")
  vec(dj, "{{range $i, $e := .s}}{{$i}}={{.}};{{else}}none{{end}}{{le true (.obj.z)}}", "|ERR|template: v:1:18: executing \"v\" at <.s>: range can't iterate over <b>&'\"x\"</b> =")
  vec(dt, "{{.missing}}{{$v := .msi.four}}[{{$v}}] - ", "<no value>[<no value>] - ")
  vec(dj, "{{or 2.5 .obj.y}}{{ne \"str\" .nums}}{{printf \"%d \" .missing}}", "2.5|ERR|template: v:1:19: executing \"v\" at <ne \"str\" .nums>: error calling ne: incompatible types for comparison: string and []interface {}")
  vec(dt, "{{len .st.C}}{{with .nest}}<{{(index .sts 0) | html}}>{{else}}E{{end}}{{$v := .nest.list}}[{{$v}}]", "1<|ERR|template: v:1:31: executing \"v\" at <index .sts 0>: error calling index: index of untyped nil")
  vec(dj, "{{.tags}}{{true}}{{.tiny}}", "[a b c]true1.5e-07")
  vec(dt, "{{gt 0x1F .ns}}{{'c'}}{{.mis | html}}", "|ERR|template: v:1:2: executing \"v\" at <gt 0x1F .ns>: error calling gt: invalid type for comparison")
  vec(dj, "{{printf \"%8.3e %[2]v %[1]v %10s| \" .obj.x .nums .nul}}", "1.000e+00 [3 1 2] 1 [%!s(float64=         3) %!s(float64=         1) %!s(float64=         2)]| ")
  vec(dt, "{{range $i, $e := .u64}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}text {{eq (index .mis 2) (index .sts 0)}}", "|ERR|template: v:1:18: executing \"v\" at <.u64>: can't use 18446744073709551615 to iterate over more than one variable")
  vec(dj, "{{ne $ .obj.w}}{{not .age}}", "|ERR|template: v:1:2: executing \"v\" at <ne $ .obj.w>: error calling ne: incompatible types for comparison: map[string]interface {} and string")
  vec(dt, "{{slice . 2}}{{1i}}", "|ERR|template: v:1:2: executing \"v\" at <slice . 2>: error calling slice: can't slice item of type map[string]interface {}")
  vec(dj, "{{or .obj.missing .obj.y}}", "<no value>")
  vec(dt, "{{/* c */}}{{gt (slice .si 1 2) false}}{{1}}", "|ERR|template: v:1:13: executing \"v\" at <gt (slice .si 1 2) false>: error calling gt: invalid type for comparison")
  vec(dj, "{{.uni | html}}", "héllo, 世界")
  vec(dt, "{{$v := .}}[{{$v}}]", "[map[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 <nil> true] m:map[k:[7 8]]] nm:map[] np:<nil> ns:[] r:120 s:go & <alx> si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615]]")
  vec(dj, "{{(index .tags 1) | len}}{{ne 0 (index .obj.z 2)}}", "1|ERR|template: v:1:27: executing \"v\" at <ne 0 (index .obj.z 2)>: error calling ne: incompatible types for comparison: int and map[string]interface {}")
  vec(dt, "{{index .t}}", "true")
  vec(dj, "{{with (.obj.z)}}<{{.obj.missing | eq 1}}>{{else}}E{{end}}", "<|ERR|template: v:1:24: executing \"v\" at <.obj.missing>: can't evaluate field obj in type []interface {}")
  vec(dt, "{{range $i, $e := 1}}{{$i}}={{$e}};{{else}}none{{end}}{{nil}}", "|ERR|template: v:1:18: executing \"v\" at <1>: can't use 1 to iterate over more than one variable")
  vec(dj, "x{{println nil .name}}", "x<nil> Ann\n")
  vec(dt, "{{range $i, $e := 2.5}}{{$i}}={{continue}};{{else}}none{{end}}{{if 1}}T{{gt .sts .u16}}{{else}}F{{end}}{{and 0x1F -3}}", "|ERR|template: v:1:18: executing \"v\" at <2.5>: range can't iterate over 2.5")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .names}}{{$v := (len .tags)}}[{{$v}}]", "<map[a:A b:B c:]>[3]")
  vec(dt, "{{.nest}}{{2.5 | not}}", "map[list:[1 two 3 <nil> true] m:map[k:[7 8]]]false")
  vec(dj, "{{.obj.z}}", "[1 2 map[k:v]]")
  vec(dt, "{{printf \"%b %*d \" -3 (index .mis 2)}}text {{with .mis}}<{{with .mis}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .r}}>{{else}}E{{end}}>{{else}}E{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dj, "{{$v := .nums}}[{{$v}}]", "[[3 1 2]]")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .mis 2)}}{{or .msi .i8}}", "<b>map[one:1 three:3 two:2]")
  vec(dj, "{{with .s}}<x>{{else}}E{{end}}{{(slice .tags 1)}}", "<x>[b c]")
  vec(dt, "{{$v := .t}}[{{$v}}]{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .si 1)}}{{.f}}", "[true]<10>2.5")
  vec(dj, "{{.obj.y | printf \"%v\"}}{{range $i, $e := .}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{ne 'c' 1}}", "<nil>age=30;big=1e+21;empty=[];flag=true;name=Ann;names=map[a:A b:B c:];neg=-2;no=false;nul=<nil>;nums=[3 1 2];obj=map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]];pi=3.14159;s=<b>&'\"x\"</b> =;tags=[a b c];tiny=1.5e-07;uni=héllo, 世界;zero=0;true")
  vec(dt, "{{$v := 0x1F}}[{{$v}}]", "[31]")
}

test "exec vectors 17" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{2.5}}{{printf \"%o %t \" \"str\" (slice .tags 1)}}", "2.5%!o(string=str) [%!t(string=b) %!t(string=c)] ")
  vec(dt, "{{$v := 1i}}[{{$v}}]", "[(0+1i)]")
  vec(dj, "{{.nums}}{{(.obj.z)}}", "[3 1 2][1 2 map[k:v]]")
  vec(dt, "{{.neg}}", "-17")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .tags 1)}}", "<b>")
  vec(dt, "{{with .ns}}<{{not (index .mis 2)}}>{{else}}E{{end}}{{slice .st 2}}", "E|ERR|template: v:1:54: executing \"v\" at <slice .st 2>: error calling slice: can't slice item of type template.vecSt")
  vec(dj, "{{or .zero (slice .tags 1)}}{{with .age}}<{{$v := 1e3}}[{{$v}}]>{{else}}E{{end}}", "[b c]<[1000]>")
  vec(dt, "{{if 1}}T{{0x1F}}{{else}}F{{end}}", "T31")
  vec(dj, "{{.obj.z}}{{(slice .tags 1) | printf \"%v\"}} - ", "[1 2 map[k:v]][b c] - ")
  vec(dt, "{{not .nest.list}}", "false")
  vec(dj, "{{printf \"%F %[2]v %[1]v % x \" .nums 0 .obj.x}}", "[3.000000 1.000000 2.000000] 0 [3 1 2]  0 ")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .u16}}{{eq (index .sts 0) .s .mfb}}{{and (len .si) .st}}", "<65535>|ERR|template: v:1:53: executing \"v\" at <eq (index .sts 0) .s .mfb>: error calling eq: incompatible types for comparison: template.vecSt and string")
  vec(dj, "{{printf \"%\#U %-5d| %f \" -3 .tags .flag}}", "U+FFFFFFFFFFFFFFFD [%!d(string=a    ) %!d(string=b    ) %!d(string=c    )]| %!f(bool=true) ")
  vec(dt, "{{not -3}}{{$v := .st.C}}[{{$v}}]{{index 0x1F}}", "false[[4]]31")
  vec(dj, "{{not .s}}{{range $i, $e := (index .obj.z 2)}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{.neg}}", "falsek=+-2")
  vec(dt, "{{range $i, $e := 'c'}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{printf \"%+v %d %.*f \" .s .u16 .mfb}}", "|ERR|template: v:1:18: executing \"v\" at <'c'>: can't use 99 to iterate over more than one variable")
  vec(dj, "{{not false}}", "true")
  vec(dt, "{{slice .st.A 1}}{{with .nest}}<{{le (slice .s 1 4) (slice .s 1 4)}}>{{else}}E{{end}}{{(index .sts 0)}}", "|ERR|template: v:1:2: executing \"v\" at <slice .st.A 1>: error calling slice: can't slice item of type int")
  vec(dj, "{{and -3 .flag}}", "true")
  vec(dt, "text ", "text ")
  vec(dj, "{{.obj}}{{printf \"%U %d \" true 'c'}}{{$v := .big}}[{{$v}}]", "map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]]%!U(bool=true) 99 [1e+21]")
  vec(dt, "{{.st}}{{ne (index .msi \"one\") .nest.list}}", "{1 bee [4]}|ERR|template: v:1:9: executing \"v\" at <ne (index .msi \"one\") .nest.list>: error calling ne: incompatible types for comparison: int and []interface {}")
  vec(dj, "text {{false}}", "text false")
  vec(dt, "{{printf \"% %e \" .ns .t}}{{printf \"%.0f %b \" -3 (index .msi \"one\")}}{{le (slice .s 1 4) .c}}", "%e %!(EXTRA []int=[], bool=true)%!f(int=-3) 1 |ERR|template: v:1:70: executing \"v\" at <le (slice .s 1 4) .c>: error calling le: incompatible types for comparison: string and complex128")
  vec(dj, "{{with .obj.x}}<{{ne .uni 0x1F}}>{{else}}E{{end}}", "<|ERR|template: v:1:21: executing \"v\" at <.uni>: can't evaluate field uni in type float64")
  vec(dt, "{{if .e}}T{{.ns}}{{else}}F{{end}}{{range $i, $e := 2.5}}{{$i}}={{continue}};{{else}}none{{end}}{{printf \"%F %*d \" .st (slice .si 1 2)}}", "F|ERR|template: v:1:51: executing \"v\" at <2.5>: range can't iterate over 2.5")
  vec(dj, "{{eq (len .tags) true}}{{with (index .tags 1)}}<{{or -3 (index .nums 0)}}>{{else}}E{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (printf \"%03d\" 7)}}", "|ERR|template: v:1:2: executing \"v\" at <eq (len .tags) true>: error calling eq: incompatible types for comparison: int and bool")
  vec(dt, "{{.c | html}}", "(1.5-2i)")
