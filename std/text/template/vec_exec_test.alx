  vec(dj, "{{(index .tags 1)}}{{print (slice .tags 1) .flag}}", "b[b c] true")
  vec(dt, "{{.si}}", "[5 10 15]")
  vec(dj, "{{range $i, $e := .tags}}{{$i}}={{continue}};{{else}}none{{end}}", "0=1=2=")
  vec(dt, "{{and . .sts}}{{not 1i}}{{lt (index .si 1) true}}", "[{2  []} {0 b []}]false|ERR|template: v:1:26: executing \"v\" at <lt (index .si 1) true>: error calling lt: incompatible types for comparison: int and bool")
  vec(dj, "{{and .name 2.5}}", "2.5")
  vec(dt, "text {{with .mfb}}<{{range $i, $e := (index .mis 2)}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}>{{else}}E{{end}}{{le .e .neg}}", "text <|ERR|template: v:1:44: executing \"v\" at <.mis>: can't evaluate field mis in type map[float64]bool")
  vec(dj, "{{range $i, $e := -3}}{{$i}}={{$e}};{{else}}none{{end}}{{with (slice .tags 1)}}<{{printf \"%.0f % \" -3 (index .tags 1)}}>{{else}}E{{end}}", "|ERR|template: v:1:18: executing \"v\" at <-3>: can't use -3 to iterate over more than one variable")
  vec(dt, "{{lt .c 2.5}}{{printf \"%e \" (index .nest.list 1)}}", "|ERR|template: v:1:2: executing \"v\" at <lt .c 2.5>: error calling lt: incompatible types for comparison: complex128 and float64")
  vec(dj, "{{.name}}", "Ann")
  vec(dt, "{{urlquery (index .sts 0) .mis}}x", "%7B2++%5B%5D%7D+map%5B1%3Aa+2%3Ab+3%3Ac%5Dx")
  vec(dj, "{{slice $ 1}}{{with .names.a}}<{{$v := .no}}[{{$v}}]>{{else}}E{{end}}{{printf \"%x \" .}}", "|ERR|template: v:1:2: executing \"v\" at <slice $ 1>: error calling slice: can't slice item of type map[string]interface {}")
  vec(dt, "{{$v := .neg}}[{{$v}}]", "[-17]")
  vec(dj, "{{and .nul (index .obj.z 2)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .pi}}", "<no value><3.14159>")
  vec(dt, "{{lt (len .si) .s}}{{urlquery (len .si) .si}}{{/* c */}}", "|ERR|template: v:1:2: executing \"v\" at <lt (len .si) .s>: error calling lt: incompatible types for comparison: int and string")
  vec(dj, "{{ne .obj.w .}}{{or \"\" (slice .tags 1)}}", "|ERR|template: v:1:2: executing \"v\" at <ne .obj.w .>: error calling ne: incompatible types for comparison: string and map[string]interface {}")
  vec(dt, "{{with true}}<{{or \"str\" .missing}}>{{else}}E{{end}}{{.c}}", "<str>(1.5-2i)")
  vec(dj, "{{range $i, $e := .no}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{with (.obj.z)}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"str\"}}>{{else}}E{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "{{slice (index .nest.list 1) 0}}", "two")
  vec(dj, "{{le .big .tags}}", "|ERR|template: v:1:2: executing \"v\" at <le .big .tags>: error calling le: invalid type for comparison")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .ss}}{{.nest.m.k}}", "<[x y]>[7 8]")
