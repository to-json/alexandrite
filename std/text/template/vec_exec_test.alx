  vec(dj, "{{false}}{{slice .big 1}}{{ne .no .big}}", "false|ERR|template: v:1:11: executing \"v\" at <slice .big 1>: error calling slice: can't slice item of type float64")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (slice .s 1 4)}}{{printf \"%\#v %\#v %e \" .u64 .np .f}}{{ne (index .si 1) .st.C}}", "<o &>0xffffffffffffffff (*int)(nil) 2.500000e+00 |ERR|template: v:1:99: executing \"v\" at <ne (index .si 1) .st.C>: error calling ne: incompatible types for comparison: int and []int")
  vec(dj, "{{.nul}}{{slice 2.5 2}}{{.obj}}", "<no value>|ERR|template: v:1:10: executing \"v\" at <slice 2.5 2>: error calling slice: can't slice item of type float64")
  vec(dt, "{{gt (slice .si 1 2) .st}}", "|ERR|template: v:1:2: executing \"v\" at <gt (slice .si 1 2) .st>: error calling gt: invalid type for comparison")
  vec(dj, "{{if .tags}}T{{$v := nil}}[{{$v}}]{{else}}F{{end}}{{if .tags}}T{{range $i, $e := .obj.y}}{{$i}}={{.}};{{else}}none{{end}}{{else}}F{{end}}{{with .no}}<{{println (slice .tags 1) .obj.missing}}>{{else}}E{{end}}", "T|ERR|template: v:1:21: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "{{.np}}", "<nil>")
  vec(dj, "{{printf \"%x %10s| %+v \" .obj.x .missing \"\"}}{{.nums | printf \"%q\"}}{{ge (slice .tags 1) .names.a}}", "0x1p+00 %!s(<nil>)|  [%!q(float64=3) %!q(float64=1) %!q(float64=2)]|ERR|template: v:1:70: executing \"v\" at <ge (slice .tags 1) .names.a>: error calling ge: invalid type for comparison")
  vec(dt, "{{printf \"%x %6.2g %05d \" .i (index .msi \"one\") (slice .si 1 2)}}{{.msi.four}}", "2a %!g(int=    01) [00010] <no value>")
  vec(dj, "{{if .obj.x}}T{{println .obj .}}{{else}}F{{end}}", "Tmap[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]\n")
  vec(dt, "{{with 'c'}}<{{$v := 0}}[{{$v}}]>{{else}}E{{end}}", "<[0]>")
  vec(dj, "{{and .obj.y 2.5}}{{not .name}}{{with .obj}}<{{$v := .obj.x}}[{{$v}}]>{{else}}E{{end}}", "<no value>false<[<no value>]>")
  vec(dt, "{{/* c */}}{{.sts}}{{if .st.B}}T{{with (slice .s 1 4)}}<text >{{else}}E{{end}}{{else}}F{{end}}", "[{2  []} {0 b []}]T<text >")
  vec(dj, " - {{printf \"%x %U \" .obj.w 1i}}{{printf \"%b \" .pi}}", " - 77696465 %!U(complex128=(0+1i)) 7074231776675438p-51 ")
  vec(dt, "{{le .st.C .u64}}{{and .sts .f}}{{with .st.C}}<x>{{else}}E{{end}}", "|ERR|template: v:1:2: executing \"v\" at <le .st.C .u64>: error calling le: invalid type for comparison")
  vec(dj, "{{lt false 0x1F}}{{ne 1e3 \"\"}}", "|ERR|template: v:1:2: executing \"v\" at <lt false 0x1F>: error calling lt: incompatible types for comparison: bool and int")
  vec(dt, "{{$v := .mfb}}[{{$v}}]", "[map[-1:false 2.5:true]]")
  vec(dj, "{{with 1}}<{{range $i, $e := .obj.missing}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}>{{else}}E{{end}}", "<|ERR|template: v:1:33: executing \"v\" at <.obj.missing>: can't evaluate field obj in type int")
  vec(dt, " - ", " - ")
  vec(dj, "{{.}}", "map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]")
  vec(dt, "{{printf \"%G %v \" nil .st.A}}{{.f | print}}", "%!G(<nil>) 1 2.5")
  vec(dj, "{{.obj | print}}{{.obj.x}}{{range $i, $e := .no}}{{$i}}={{.}};{{else}}none{{end}}", "map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]]1|ERR|template: v:1:44: executing \"v\" at <.no>: range can't iterate over false")
  vec(dt, "{{index .nest.m.k \"str\"}}{{if 1}}T{{slice .mis 0}}{{else}}F{{end}}", "|ERR|template: v:1:2: executing \"v\" at <index .nest.m.k \"str\">: error calling index: cannot index slice/array with type string")
  vec(dj, "{{.age | not}}", "false")
  vec(dt, "{{printf \"% %6.2g %E \" .ss .r true}}", "%6.2g [%!E(string=x) %!E(string=y)] %!(EXTRA int32=120, bool=true)")
  vec(dj, "{{with 2.5}}<{{printf \"%c %U \" 2.5 (slice .tags 1)}}>{{else}}E{{end}}{{ne true 0}}", "<|ERR|template: v:1:42: executing \"v\" at <.tags>: can't evaluate field tags in type float64")
  vec(dt, "{{ge (index .si 1) .bs}}", "|ERR|template: v:1:2: executing \"v\" at <ge (index .si 1) .bs>: error calling ge: invalid type for comparison")
  vec(dj, "{{if .tags}}T{{(index .obj.z 2)}}{{else}}F{{end}}", "Tmap[k:v]")
  vec(dt, "{{ne false (len .si)}}{{$v := -3}}[{{$v}}]", "|ERR|template: v:1:2: executing \"v\" at <ne false (len .si)>: error calling ne: incompatible types for comparison: bool and int")
  vec(dj, "{{if 0}}T{{lt .name .names.a}}{{else}}F{{end}}{{not .nul}}{{$v := .nul}}[{{$v}}]", "Ftrue[<no value>]")
  vec(dt, "{{1 | not}}{{.nest}}{{.msi}}", "falsemap[list:[1 two 3 <nil> true] m:map[k:[7 8]]]map[one:1 three:3 two:2]")
  vec(dj, "{{and .obj.w 1e3}}{{if (len .tags)}}T{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj.z}}{{else}}F{{end}}{{printf \"%E %o %b \" true 1 -3}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (slice .s 1 4)}}{{$v := (index .si 1)}}[{{$v}}]", "<o &>[10]")
  vec(dj, "{{or (.obj.z) .s}}{{len .tags}}", "[1 2 map[k:v]]3")
  vec(dt, "{{printf \"%X %t \" .si (len .si)}}{{printf \"%s %8.3e \" .nest .neg}}", "[5 A F] %!t(int=3) map[list:[%!s(int=1) two %!s(float64=3) <nil> %!s(bool=true)] m:map[k:[%!s(int=7) %!s(int=8)]]] %!e(int=    -017) ")
  vec(dj, "{{ne .tiny .obj}}{{range $i, $e := .s}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "|ERR|template: v:1:2: executing \"v\" at <ne .tiny .obj>: error calling ne: incompatible types for comparison: float64 and map[string]interface {}")
  vec(dt, "{{print .nest .nest.list}}{{printf \"%c \" true}}{{1i | print}}", "map[list:[1 two 3 <nil> true] m:map[k:[7 8]]] [1 two 3 <nil> true]%!c(bool=true) (0+1i)")
  vec(dj, "{{and .missing .nul}}{{not (slice .tags 1)}}{{lt .pi .names.a}}", "<no value>false|ERR|template: v:1:46: executing \"v\" at <lt .pi .names.a>: error calling lt: incompatible types for comparison: float64 and string")
  vec(dt, "{{.missing}}x{{printf \"%x %q \" -3 (index .sts 0)}}", "<no value>x-3 {'\\x02' \"\" []} ")
  vec(dj, "{{(len .tags) | len}}{{urlquery 1 \"\"}}{{printf \"%G \" .obj.y}}", "|ERR|template: v:1:16: executing \"v\" at <len>: error calling len: len of type int")
  vec(dt, "{{if -3}}T{{.nm | printf \"%q\"}}{{else}}F{{end}}", "Tmap[]")
  vec(dj, "{{$v := \"\"}}[{{$v}}]", "[]")
  vec(dt, "{{$v := .i}}[{{$v}}]", "[42]")
  vec(dj, "{{.obj.w | len}}{{printf \"%o %g \" .obj (index .tags 1)}}", "4map[%!o(string=w):%!o(string=wide) %!o(string=x):%!o(float64=1) %!o(string=y):<nil> %!o(string=z):[%!o(float64=1) %!o(float64=2) map[%!o(string=k):%!o(string=v)]]] %!g(string=b) ")
  vec(dt, "{{ge .sts (index .sts 0)}}{{or 0 -3}}{{or (index .si 1) .sts}}", "|ERR|template: v:1:2: executing \"v\" at <ge .sts (index .sts 0)>: error calling ge: invalid type for comparison")
  vec(dj, "{{range $i, $e := .pi}}{{$i}}={{$e}};{{else}}none{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"str\"}}", "|ERR|template: v:1:18: executing \"v\" at <.pi>: range can't iterate over 3.14159")
  vec(dt, "{{js .neg (index .nest.list 1)}}{{/* c */}}", "-17two")
}

test "exec vectors 2" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{.age}}{{with .nul}}<{{slice 1e3 2}}>{{else}}E{{end}}", "30E")
  vec(dt, "{{range $i, $e := true}}{{$i}}={{continue}};{{else}}none{{end}}{{not .msi.two}}", "|ERR|template: v:1:18: executing \"v\" at <true>: range can't iterate over true")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .missing}}{{printf \"%+v % %.2s \" .flag .name .name}}{{nil}}", "<<no value>>true %.2s %!(EXTRA string=Ann, string=Ann)|ERR|template: v:1:99: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "{{and .st.B .mfb}}", "map[-1:false 2.5:true]")
  vec(dj, "{{$v := .names.a}}[{{$v}}]{{printf \"%U \" .tiny}}", "[A]%!U(float64=1.5e-07) ")
  vec(dt, "{{$v := .f32}}[{{$v}}]", "[0.1]")
  vec(dj, "{{printf \"%x %e \" .flag .age}}{{with .age}}<{{le .obj.x .obj.x}}>{{else}}E{{end}}{{ge .tags .}}", "%!x(bool=true) 3.000000e+01 <|ERR|template: v:1:53: executing \"v\" at <.obj.x>: can't evaluate field obj in type float64")
  vec(dt, "{{or .bs (index .nest.list 1)}}", "[104 105]")
  vec(dj, "{{not (slice .tags 1)}}{{printf \"%*d %+d %-10q| \" 0 0 .names.a}}{{printf \"%d %q %+d \" .names.a .name 'c'}}", "false0 %!d(string=A) %!q(MISSING)| %!d(string=A) \"Ann\" +99 ")
  vec(dt, "{{.sts | eq 1}}{{or .missing .u64}}{{$v := .}}[{{$v}}]", "|ERR|template: v:1:9: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and []template.vecSt")
  vec(dj, "{{lt \"str\" false}}{{slice .nul 2}}", "|ERR|template: v:1:2: executing \"v\" at <lt \"str\" false>: error calling lt: incompatible types for comparison: string and bool")
  vec(dt, "{{or .st.C .e}}", "[4]")
  vec(dj, "{{- \" trim \" -}}", " trim ")
  vec(dt, "{{or .ns (index .mis 2)}}{{/* c */}}{{and .nest.list \"str\"}}", "bstr")
  vec(dj, "{{or (index .tags 1) (len .tags)}}{{$v := .nul}}[{{$v}}]{{len 2.5}}", "b[<no value>]|ERR|template: v:1:58: executing \"v\" at <len 2.5>: error calling len: len of type float64")
  vec(dt, "{{index 2.5}}{{.r}}{{if 0}}T{{(slice .s 1 4)}}{{else}}F{{end}}", "2.5120F")
  vec(dj, "{{print (index .obj.z 2) 'c'}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj.w}}{{js .names .names.a}}", "map[k:v] 99<wide>map[a:A b:B c:]A")
  vec(dt, "{{or .msi.two .nest.list}}", "2")
  vec(dj, "text ", "text ")
  vec(dt, "{{printf \"%\#o \" .f}}{{not .c}}{{.st.B}}", "%!o(float64=2.50000) falsebee")
  vec(dj, "{{printf \"%5.2f \" 1i}}{{$v := .obj.z}}[{{$v}}]{{printf \"%d %.0f \" . .neg}}", "( 0.00+1.00i) [[1 2 map[k:v]]]map[%!d(string=age):%!d(float64=30) %!d(string=big):%!d(float64=1e+21) %!d(string=empty):[] %!d(string=flag):%!d(bool=true) %!d(string=name):%!d(string=Ann) %!d(string=names):map[%!d(string=a):%!d(string=A) %!d(string=b):%!d(string=B) %!d(string=c):%!d(string=)] %!d(string=neg):%!d(float64=-2) %!d(string=no):%!d(bool=false) %!d(string=nul):<nil> %!d(string=nums):[%!d(float64=3) %!d(float64=1) %!d(float64=2)] %!d(string=obj):map[%!d(string=w):%!d(string=wide) %!d(string=x):%!d(float64=1) %!d(string=y):<nil> %!d(string=z):[%!d(float64=1) %!d(float64=2) map[%!d(string=k):%!d(string=v)]]] %!d(string=pi):%!d(float64=3.14159) %!d(string=s):%!d(string=<b>&'\"x\"</b> =) %!d(string=tags):[%!d(string=a) %!d(string=b) %!d(string=c)] %!d(string=tiny):%!d(float64=1.5e-07) %!d(string=uni):%!d(string=héllo, 世界) %!d(string=zero):%!d(float64=0)] -2 ")
  vec(dt, "{{if .t}}T{{/* c */}}{{else}}F{{end}}{{printf \"%x %.2s %x \" .msi .mis .f}}", "Tmap[6f6e65:1 7468726565:3 74776f:2] map[%!s(int=01):a %!s(int=02):b %!s(int=03):c] 0x1.4p+01 ")
  vec(dj, "{{(index .obj.z 2) | printf \"%q\"}}{{/* c */}}{{with $}}<{{with .names.a}}<{{$v := .tags}}[{{$v}}]>{{else}}E{{end}}>{{else}}E{{end}}", "map[\"k\":\"v\"]<<|ERR|template: v:1:82: executing \"v\" at <.tags>: can't evaluate field tags in type string")
  vec(dt, "{{range $i, $e := .msi.two}}{{$i}}={{.}};{{else}}none{{end}}{{index true}}{{.st.B | eq 1}}", "|ERR|template: v:1:22: executing \"v\" at <.msi.two>: can't use 2 to iterate over more than one variable")
  vec(dj, "{{index 2.5 .no}}", "|ERR|template: v:1:2: executing \"v\" at <index 2.5 .no>: error calling index: can't index item of type float64")
  vec(dt, "{{gt (slice .si 1 2) (slice .si 1 2)}}{{if \"str\"}}T{{.msi}}{{else}}F{{end}}", "|ERR|template: v:1:2: executing \"v\" at <gt (slice .si 1 2) (slice .si 1 2)>: error calling gt: invalid type for comparison")
  vec(dj, "{{(.obj.z)}}", "[1 2 map[k:v]]")
  vec(dt, "{{with .si}}<{{.bs}}>{{else}}E{{end}} - ", "<|ERR|template: v:1:15: executing \"v\" at <.bs>: can't evaluate field bs in type []int")
  vec(dj, "{{or .nums \"str\"}}", "[3 1 2]")
  vec(dt, "{{html 1 .nest.m.k}}{{html (index .msi \"one\") .sts}}{{printf \"%! \" .nm}}", "1 [7 8]1 [{2  []} {0 b []}]map[] ")
  vec(dj, "{{printf \"%+d %E %v \" 1 .obj.missing .tags}}", "+1 %!E(<nil>) [a b c] ")
  vec(dt, "{{le .msi.two .t}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 2.5}}{{(index .nest.list 1)}}", "|ERR|template: v:1:2: executing \"v\" at <le .msi.two .t>: error calling le: incompatible types for comparison: int and bool")
  vec(dj, "{{printf \"%E \" 0}}{{printf \"%.0f %d %.2s \" 0x1F 1 (len .tags)}}", "%!E(int=0) %!f(int=31) 1 %!s(int=03) ")
  vec(dt, "{{range $i, $e := .nest.list}}{{$i}}={{$e}};{{else}}none{{end}}", "0=1;1=two;2=3;3=<no value>;4=true;")
  vec(dj, "{{(index .tags 1)}}", "b")
  vec(dt, "{{not 'c'}}{{if 0x1F}}T{{or .f .st.B}}{{else}}F{{end}}{{lt .ns .r}}", "falseT2.5|ERR|template: v:1:56: executing \"v\" at <lt .ns .r>: error calling lt: invalid type for comparison")
  vec(dj, "{{le false .no}}{{ge .no \"str\"}}", "|ERR|template: v:1:2: executing \"v\" at <le false .no>: error calling le: invalid type for comparison")
  vec(dt, "{{with 0x1F}}<{{$v := .missing}}[{{$v}}]>{{else}}E{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .mis 2)}}{{with .st.C}}<{{printf \"%c %-10q| %\#q \" 0 1i .f32}}>{{else}}E{{end}}", "<|ERR|template: v:1:22: executing \"v\" at <.missing>: can't evaluate field missing in type int")
  vec(dj, "{{(printf \"%03d\" 7)}}", "007")
