  vec(dt, "{{$v := .msi.two}}[{{$v}}]", "[2]")
  vec(dj, "{{$ | html}}{{gt .obj .nul}}{{gt .obj.y 'c'}}", "map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:&lt;nil&gt; nums:[3 1 2] obj:map[w:wide x:1 y:&lt;nil&gt; z:[1 2 map[k:v]]] pi:3.14159 s:&lt;b&gt;&amp;&\#39;&\#34;x&\#34;&lt;/b&gt; = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]|ERR|template: v:1:14: executing \"v\" at <gt .obj .nul>: error calling gt: invalid type for comparison")
  vec(dt, "{{range $i, $e := .ss}}{{$i}}={{.}};{{else}}none{{end}}", "0=x;1=y;")
