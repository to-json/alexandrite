  vec(dj, "{{.name}}{{(slice .tags 1) | printf \"%v\"}}{{printf \"%q %d %X \" .name .names (index .tags 1)}}", "Ann[b c]\"Ann\" map[%!d(string=a):%!d(string=A) %!d(string=b):%!d(string=B) %!d(string=c):%!d(string=)] 62 ")
  vec(dt, "{{index .st.A}}{{ne .r .ss}}{{range $i, $e := false}}{{$i}}={{.}};{{else}}none{{end}}", "1|ERR|template: v:1:17: executing \"v\" at <ne .r .ss>: error calling ne: incompatible types for comparison: int32 and []string")
  vec(dj, "{{.obj}}", "map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]]")
  vec(dt, "{{or 'c' .f32}}", "99")
  vec(dj, "{{js (slice .tags 1) .name}}{{index 0 .names}}", "[b c]Ann|ERR|template: v:1:30: executing \"v\" at <index 0 .names>: error calling index: can't index item of type int")
  vec(dt, "{{if .mis}}T{{with .msi}}<{{.sts | len}}>{{else}}E{{end}}{{else}}F{{end}}{{if .neg}}T{{printf \"%\#U %v %-10q| \" .e .mfb (index .msi \"one\")}}{{else}}F{{end}}", "T<|ERR|template: v:1:35: executing \"v\" at <len>: error calling len: reflect: call of reflect.Value.Type on zero Value")
  vec(dj, "{{if .flag}}Ttext {{else}}F{{end}}{{with .neg}}<{{lt .zero 1i}}>{{else}}E{{end}}", "Ttext <|ERR|template: v:1:53: executing \"v\" at <.zero>: can't evaluate field zero in type float64")
  vec(dt, "{{not \"str\"}}{{print 0x1F (index .mis 2)}}", "false31b")
  vec(dj, "{{$v := .s}}[{{$v}}]{{not .obj.y}}", "[<b>&'\"x\"</b> =]true")
  vec(dt, "{{lt .ns .}}", "|ERR|template: v:1:2: executing \"v\" at <lt .ns .>: error calling lt: invalid type for comparison")
  vec(dj, "{{.uni | printf \"%v\"}}", "héllo, 世界")
  vec(dt, "{{- \" trim \" -}}{{.nm}}{{true}}", " trim map[]true")
  vec(dj, "{{printf \"%*d %\#U %-10q| \" 1 .pi .neg}}{{printf \"%U \" .neg}}", "%!d(float64=3.14159) %!U(float64=-2.00000) %!q(MISSING)| %!U(float64=-2) ")
  vec(dt, "{{index .t .st.B}}", "|ERR|template: v:1:2: executing \"v\" at <index .t .st.B>: error calling index: can't index item of type bool")
  vec(dj, "{{if .missing}}Tx{{else}}F{{end}}{{ne .neg .obj.x}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .big}}", "Ftrue<1e+21>")
  vec(dt, "{{slice .ss 1}}{{.ns}}", "[y][]")
  vec(dj, "{{len .neg}}{{print (len .tags) .name}}{{and .obj.x .name}}", "|ERR|template: v:1:2: executing \"v\" at <len .neg>: error calling len: len of type float64")
  vec(dt, "{{len 1i}}{{with (index .msi \"one\")}}<{{ne .f32 (index .sts 0)}}>{{else}}E{{end}}{{if nil}}T{{and 1 'c'}}{{else}}F{{end}}", "|ERR|template: v:1:2: executing \"v\" at <len 1i>: error calling len: len of type complex128")
  vec(dj, "{{not 2.5}}{{.s | html}}", "false&lt;b&gt;&amp;&\#39;&\#34;x&\#34;&lt;/b&gt; =")
  vec(dt, "{{$v := .mfb}}[{{$v}}]", "[map[-1:false 2.5:true]]")
  vec(dj, "{{println (index .nums 0) nil}}{{printf \"%+d %d %q \" .obj.w .zero $}}", "3 <nil>\n%!d(string=wide) %!d(float64=0) map[\"age\":%!q(float64=30) \"big\":%!q(float64=1e+21) \"empty\":[] \"flag\":%!q(bool=true) \"name\":\"Ann\" \"names\":map[\"a\":\"A\" \"b\":\"B\" \"c\":\"\"] \"neg\":%!q(float64=-2) \"no\":%!q(bool=false) \"nul\":<nil> \"nums\":[%!q(float64=3) %!q(float64=1) %!q(float64=2)] \"obj\":map[\"w\":\"wide\" \"x\":%!q(float64=1) \"y\":<nil> \"z\":[%!q(float64=1) %!q(float64=2) map[\"k\":\"v\"]]] \"pi\":%!q(float64=3.14159) \"s\":\"<b>&'\\\"x\\\"</b> =\" \"tags\":[\"a\" \"b\" \"c\"] \"tiny\":%!q(float64=1.5e-07) \"uni\":\"héllo, 世界\" \"zero\":%!q(float64=0)] ")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"str\"}}", "<str>")
