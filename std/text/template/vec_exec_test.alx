test "exec vectors 5" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{or (index .nums 0) (slice .tags 1)}}{{range $i, $e := .tiny}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "3|ERR|template: v:1:56: executing \"v\" at <.tiny>: range can't iterate over 1.5e-07")
  vec(dt, "{{eq .np 2.5}}{{printf \"%\#v %05d %! \" (index .si 1) .np true}}", "|ERR|template: v:1:2: executing \"v\" at <eq .np 2.5>: error calling eq: incompatible types for comparison: *int and float64")
  vec(dj, "{{.nums}}", "[3 1 2]")
  vec(dt, " - ", " - ")
  vec(dj, "{{not .zero}}{{index .nul (index .obj.z 2)}}{{(index .tags 1)}}", "true|ERR|template: v:1:15: executing \"v\" at <index .nul (index .obj.z 2)>: error calling index: index of untyped nil")
  vec(dt, "x", "x")
  vec(dj, "{{printf \"%[2]v %[1]v \" .names}}", "%!v(BADINDEX) map[a:A b:B c:] ")
  vec(dt, "{{.mis}}{{html .sts .i8}}text ", "map[1:a 2:b 3:c][{2  []} {0 b []}] -7text ")
  vec(dj, "{{(printf \"%03d\" 7) | not}}{{urlquery nil .obj.w}}{{slice 2.5 0}}", "false%3Cno+value%3Ewide|ERR|template: v:1:52: executing \"v\" at <slice 2.5 0>: error calling slice: can't slice item of type float64")
  vec(dt, "{{/* c */}}{{index .nest.m.k}}{{or 0 .nest.m.k}}", "[7 8][7 8]")
  vec(dj, "{{(len .tags) | html}}{{range $i, $e := $}}{{$i}}={{$e}};{{else}}none{{end}}", "3age=30;big=1e+21;empty=[];flag=true;name=Ann;names=map[a:A b:B c:];neg=-2;no=false;nul=<no value>;nums=[3 1 2];obj=map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]];pi=3.14159;s=<b>&'\"x\"</b> =;tags=[a b c];tiny=1.5e-07;uni=héllo, 世界;zero=0;")
  vec(dt, "{{lt nil .u64}}{{index .bs .st.A}}", "|ERR|template: v:1:2: executing \"v\" at <lt nil .u64>: error calling lt: invalid type for comparison")
  vec(dj, "{{not true}}{{len .empty}}{{range $i, $e := .obj.x}}{{$i}}={{continue}};{{else}}none{{end}}", "false0|ERR|template: v:1:48: executing \"v\" at <.obj.x>: range can't iterate over 1")
  vec(dt, "{{/* c */}}", "")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .uni}}{{printf \"%[2]v %[1]v %5.2f \" .tags .nul}}{{html .obj.x false}}", "<héllo, 世界><nil> [a b c] %!f(<nil>) 1 false")
  vec(dt, "{{not .nest.m.k}}{{false}}{{slice .ns 2}}", "falsefalse|ERR|template: v:1:28: executing \"v\" at <slice .ns 2>: error calling slice: index out of range: 2")
  vec(dj, "{{print .obj .missing}}{{$v := .obj.missing}}[{{$v}}]{{$}}", "map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] <nil>[<no value>]map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]")
  vec(dt, "{{- \" trim \" -}}{{if (len .si)}}T{{true | not}}{{else}}F{{end}}{{with .t}}<{{with .si}}<text >{{else}}E{{end}}>{{else}}E{{end}}", " trim Tfalse<|ERR|template: v:1:82: executing \"v\" at <.si>: can't evaluate field si in type bool")
  vec(dj, "{{le .names .missing}}{{printf \"%\#v %*d %-5d| \" .nums .no .zero}}", "|ERR|template: v:1:2: executing \"v\" at <le .names .missing>: error calling le: invalid type for comparison")
  vec(dt, "{{with .msi.two}}<{{nil | not}}>{{else}}E{{end}}", "<|ERR|template: v:1:20: executing \"v\" at <nil>: nil is not a command")
  vec(dj, "{{ge .s .age}}{{lt $ $}}{{$v := .names.a}}[{{$v}}]", "|ERR|template: v:1:2: executing \"v\" at <ge .s .age>: error calling ge: incompatible types for comparison: string and float64")
  vec(dt, "{{len .}}", "24")
  vec(dj, "{{printf \"%*d % d %-10q| \" false nil (printf \"%03d\" 7)}}", "%!(BADWIDTH)%!d(<nil>) %!d(string=007) %!q(MISSING)| ")
  vec(dt, "{{$v := .st.C}}[{{$v}}]{{and .st.C .f}}", "[[4]]2.5")
  vec(dj, "{{nil}}", "|ERR|template: v:1:2: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "{{with .st.C}}<{{printf \"%\#q %5.2f \" true .sts}}>{{else}}E{{end}}", "<|ERR|template: v:1:42: executing \"v\" at <.sts>: can't evaluate field sts in type []int")
  vec(dj, "{{ne .empty \"str\"}}{{lt .zero .}}", "|ERR|template: v:1:2: executing \"v\" at <ne .empty \"str\">: error calling ne: incompatible types for comparison: []interface {} and string")
  vec(dt, "{{.c | print}}{{and .i8 (index .mis 2)}}{{printf \"%.*f %5.2f \" .si .nest}}", "(1.5-2i)b%!(BADPREC)map[%!f(string=list):[%!f(int=1) %!f(string=two) 3.000000 <nil> %!f(bool=true)] %!f(string=m):map[%!f(string=k):[%!f(int=7) %!f(int=8)]]] %!f(MISSING) ")
  vec(dj, "{{/* c */}}", "")
