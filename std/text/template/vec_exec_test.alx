}

test "exec vectors 19" {
  dj = vec_json()
  dt = vec_typed()
  vec(dt, "{{printf \"%q \" false}}{{/* c */}}{{not .s}}", "%!q(bool=false) false")
  vec(dj, "{{(.obj.z)}}", "[1 2 map[k:v]]")
  vec(dt, "{{not .s}}{{printf \"%E %b %10s| \" 1 .mis .si}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .nm}}", "false%!E(int=1) map[1:%!b(string=a) 10:%!b(string=b) 11:%!b(string=c)] [%!s(int=         5) %!s(int=        10) %!s(int=        15)]| <map[]>")
  vec(dj, "{{.flag}}{{println .nul (index .nums 0)}}{{eq .neg .names}}", "true<nil> 3\n|ERR|template: v:1:43: executing \"v\" at <eq .neg .names>: error calling eq: incompatible types for comparison: float64 and map[string]interface {}")
  vec(dt, "{{not .st}}", "false")
  vec(dj, "{{not .zero}}{{println (index .obj.z 2) .obj.w}}{{len .obj.x}}", "truemap[k:v] wide\n|ERR|template: v:1:50: executing \"v\" at <len .obj.x>: error calling len: len of type float64")
  vec(dt, "{{slice .s 0}}{{with .st}}<{{js .np .nest}}>{{else}}E{{end}}", "go & <alx><|ERR|template: v:1:32: executing \"v\" at <.np>: can't evaluate field np in type template.vecSt")
  vec(dj, "{{and -3 .no}}{{not .}}", "falsefalse")
  vec(dt, "{{.msi.two}}{{printf \"%10s| %8.3e %o \" (index .nest.list 1) (index .si 1) .missing}}", "2       two| %!e(int=     010) %!o(<nil>) ")
  vec(dj, "{{lt 1i .neg}}{{le .pi 1e3}}{{range $i, $e := .zero}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "|ERR|template: v:1:2: executing \"v\" at <lt 1i .neg>: error calling lt: incompatible types for comparison: complex128 and float64")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .msi \"one\")}}{{print 1i 0x1F}}{{.nm | not}}", "<1>(0+1i) 31true")
  vec(dj, "{{.missing | print}}", "<nil>")
