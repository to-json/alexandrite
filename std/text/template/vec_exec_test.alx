  vec(dj, "{{and .obj.w .obj.x}}", "1")
  vec(dt, "{{.}}{{len -3}}", "map[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 <nil> true] m:map[k:[7 8]]] nm:map[] np:<nil> ns:[] r:120 s:go & <alx> si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615]|ERR|template: v:1:7: executing \"v\" at <len -3>: error calling len: len of type int")
  vec(dj, "{{len .missing}}", "|ERR|template: v:1:2: executing \"v\" at <len .missing>: error calling len: reflect: call of reflect.Value.Type on zero Value")
  vec(dt, "{{gt .st.A 0}}{{.st.C}}{{'c' | print}}", "true[4]99")
  vec(dj, "{{printf \"%6.2g \" $}}{{js 2.5 .names.a}}", "map[%!g(string=    ag):    30 %!g(string=    bi): 1e+21 %!g(string=    em):[] %!g(string=    fl):%!g(bool=  true) %!g(string=    na):%!g(string=    An) %!g(string=    na):map[%!g(string=     a):%!g(string=     A) %!g(string=     b):%!g(string=     B) %!g(string=     c):%!g(string=      )] %!g(string=    ne):    -2 %!g(string=    no):%!g(bool= false) %!g(string=    nu):<nil> %!g(string=    nu):[     3      1      2] %!g(string=    ob):map[%!g(string=     w):%!g(string=    wi) %!g(string=     x):     1 %!g(string=     y):<nil> %!g(string=     z):[     1      2 map[%!g(string=     k):%!g(string=     v)]]] %!g(string=    pi):   3.1 %!g(string=     s):%!g(string=    <b) %!g(string=    ta):[%!g(string=     a) %!g(string=     b) %!g(string=     c)] %!g(string=    ti):1.5e-07 %!g(string=    un):%!g(string=    hé) %!g(string=    ze):     0] 2.5A")
  vec(dt, "{{not .sts}}{{printf \"%05d %\#x %E \" \"str\" nil .si}}", "false%!d(string=00str) %!x(<nil>) [%!E(int=5) %!E(int=10) %!E(int=15)] ")
  vec(dj, "text ", "text ")
  vec(dt, "{{len .st.A}}{{index .i8}}", "|ERR|template: v:1:2: executing \"v\" at <len .st.A>: error calling len: len of type int")
  vec(dj, "{{.empty | not}}", "true")
