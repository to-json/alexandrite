  vec(dj, "{{.uni}}{{js -3 .}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .age}}", "héllo, 世界-3 map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:\\u003Cnil\\u003E nums:[3 1 2] obj:map[w:wide x:1 y:\\u003Cnil\\u003E z:[1 2 map[k:v]]] pi:3.14159 s:\\u003Cb\\u003E\\u0026\\'\\\"x\\\"\\u003C/b\\u003E \\u003D tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]<30>")
  vec(dt, "{{slice .s 2}}{{printf \"%8.3e %z %-5d| \" .np .u64 (len .si)}}", " & <alx>%!e(*int=   <nil>) %!z(uint64=18446744073709551615) 3    | ")
  vec(dj, "{{1e3}}{{\"str\"}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .nul}}", "1000str<<no value>>")
  vec(dt, "{{- \" trim \" -}}{{println .nm .i}}", " trim map[] 42\n")
  vec(dj, "{{if (slice .tags 1)}}T{{printf \"%+d \" $}}{{else}}F{{end}}{{.obj.missing}}{{len (index .nums 0)}}", "Tmap[%!d(string=age):%!d(float64=+30) %!d(string=big):%!d(float64=+1e+21) %!d(string=empty):[] %!d(string=flag):%!d(bool=true) %!d(string=name):%!d(string=Ann) %!d(string=names):map[%!d(string=a):%!d(string=A) %!d(string=b):%!d(string=B) %!d(string=c):%!d(string=)] %!d(string=neg):%!d(float64=-2) %!d(string=no):%!d(bool=false) %!d(string=nul):<nil> %!d(string=nums):[%!d(float64=+3) %!d(float64=+1) %!d(float64=+2)] %!d(string=obj):map[%!d(string=w):%!d(string=wide) %!d(string=x):%!d(float64=+1) %!d(string=y):<nil> %!d(string=z):[%!d(float64=+1) %!d(float64=+2) map[%!d(string=k):%!d(string=v)]]] %!d(string=pi):%!d(float64=+3.14159) %!d(string=s):%!d(string=<b>&'\"x\"</b> =) %!d(string=tags):[%!d(string=a) %!d(string=b) %!d(string=c)] %!d(string=tiny):%!d(float64=+1.5e-07) %!d(string=uni):%!d(string=héllo, 世界) %!d(string=zero):%!d(float64=+0)] <no value>|ERR|template: v:1:76: executing \"v\" at <len (index .nums 0)>: error calling len: len of type float64")
  vec(dt, " - ", " - ")
  vec(dj, "{{printf \"%\#v %! %*d \" (len .tags) .zero (printf \"%03d\" 7)}}{{printf \"%O \" .obj.missing}}", "3 %!!(float64=0) %!(BADWIDTH)%!d(MISSING) %!O(<nil>) ")
  vec(dt, "{{index 0x1F}}{{with nil}}<{{printf \"%s \" .f32}}>{{else}}E{{end}}", "31|ERR|template: v:1:21: executing \"v\" at <nil>: nil is not a command")
  vec(dj, "{{range $i, $e := $}}{{$i}}={{$e}};{{else}}none{{end}}", "age=30;big=1e+21;empty=[];flag=true;name=Ann;names=map[a:A b:B c:];neg=-2;no=false;nul=<no value>;nums=[3 1 2];obj=map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]];pi=3.14159;s=<b>&'\"x\"</b> =;tags=[a b c];tiny=1.5e-07;uni=héllo, 世界;zero=0;")
  vec(dt, "{{println .nm .f}}{{.np}}", "map[] 2.5\n<nil>")
  vec(dj, "{{1i | not}}{{lt .obj.w .age}}{{.s | html}}", "false|ERR|template: v:1:14: executing \"v\" at <lt .obj.w .age>: error calling lt: incompatible types for comparison: string and float64")
  vec(dt, "{{.ns}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 'c'}}", "[]<99>")
  vec(dj, "{{with .flag}}<{{slice .obj.x 2}}>{{else}}E{{end}}{{not .no}}", "<|ERR|template: v:1:27: executing \"v\" at <.obj.x>: can't evaluate field obj in type bool")
  vec(dt, "{{slice .si 2}}", "[15]")
  vec(dj, "{{with 1}}<{{urlquery .obj.z 1e3}}>{{else}}E{{end}}{{if .s}}T{{printf \"%g %f %X \" .obj.missing .obj.missing \"str\"}}{{else}}F{{end}}", "<|ERR|template: v:1:26: executing \"v\" at <.obj.z>: can't evaluate field obj in type int")
  vec(dt, "{{printf \"%5.2f %.0f \" (index .sts 0) .nest}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .f}}{{printf \"%T %.2s \" .msi .msi.four}}", "{%!f(int=   02) %!f(string=     ) []} map[%!f(string=):[%!f(int=1) %!f(string=) 3 <nil> %!f(bool=true)] %!f(string=):map[%!f(string=):[%!f(int=7) %!f(int=8)]]] <2.5>map[string]int %!s(<nil>) ")
  vec(dj, "{{not (index .obj.z 2)}}{{$v := .age}}[{{$v}}]{{print \"\" .obj}}", "false[30]map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]]")
  vec(dt, "{{.u64}}", "18446744073709551615")
  vec(dj, "{{slice (len .tags) 2}}{{printf \"%6.2g % \" .nul 0x1F}}", "|ERR|template: v:1:2: executing \"v\" at <slice (len .tags) 2>: error calling slice: can't slice item of type int")
  vec(dt, "{{not 'c'}}{{printf \"%g \" (index .nest.list 1)}}", "false%!g(string=two) ")
  vec(dj, "{{println (index .tags 1) .flag}}", "b true\n")
  vec(dt, "{{or (index .mis 2) .ss}}", "b")
  vec(dj, "{{index .big .empty}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .obj.z 2)}}", "|ERR|template: v:1:2: executing \"v\" at <index .big .empty>: error calling index: can't index item of type float64")
  vec(dt, "{{(len .si)}}{{printf \"% x \" (index .si 1)}}{{or .r .f}}", "3 a 120")
  vec(dj, "{{or .obj.x 1i}}", "1")
  vec(dt, "{{.nest | len}}", "2")
  vec(dj, "{{or .obj.w (index .tags 1)}}{{printf \"%p \" -3}}", "wide%!p(int=-3) ")
  vec(dt, "{{printf \"%10s| %\#o %G \" .ns 'c' (index .mis 2)}}{{gt .msi.two (index .sts 0)}}", "[]| 0143 %!G(string=b) |ERR|template: v:1:51: executing \"v\" at <gt .msi.two (index .sts 0)>: error calling gt: invalid type for comparison")
  vec(dj, "{{.flag}}{{range $i, $e := .pi}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{nil | print}}", "true|ERR|template: v:1:27: executing \"v\" at <.pi>: range can't iterate over 3.14159")
  vec(dt, "{{$v := false}}[{{$v}}]{{- \" trim \" -}}{{(slice .s 1 4) | printf \"%v\"}}", "[false] trim o &")
  vec(dj, "{{.name}}{{not 0}}", "Anntrue")
  vec(dt, "{{ge .e (slice .si 1 2)}}{{if .msi.two}}T{{gt .st.A \"str\"}}{{else}}F{{end}}", "|ERR|template: v:1:2: executing \"v\" at <ge .e (slice .si 1 2)>: error calling ge: invalid type for comparison")
  vec(dj, "{{.missing | print}} - ", "<nil> - ")
  vec(dt, "{{ne .ss 2.5}}{{not .i8}}{{ge (index .si 1) .u16}}", "|ERR|template: v:1:2: executing \"v\" at <ne .ss 2.5>: error calling ne: incompatible types for comparison: []string and float64")
  vec(dj, "{{.tags}}{{and .tiny .zero}}", "[a b c]0")
  vec(dt, "{{le .np .mis}}", "|ERR|template: v:1:2: executing \"v\" at <le .np .mis>: error calling le: invalid type for comparison")
  vec(dj, "{{$v := .pi}}[{{$v}}]{{(index .obj.z 2) | printf \"%v\"}}", "[3.14159]map[k:v]")
  vec(dt, "{{$v := .sts}}[{{$v}}]", "[[{2  []} {0 b []}]]")
  vec(dj, "{{le .names .obj.x}}", "|ERR|template: v:1:2: executing \"v\" at <le .names .obj.x>: error calling le: invalid type for comparison")
  vec(dt, "{{printf \"%d %5.2f %10s| \" .st.C .mfb .sts}}{{0 | eq 1}}", "[4] map[-1.00:%!f(bool=false)  2.50:%!f(bool= true)] [{%!s(int=         2)            []} {%!s(int=         0)          b []}]| false")
  vec(dj, "{{index .flag .neg}}{{.tags}}{{or true .obj.y}}", "|ERR|template: v:1:2: executing \"v\" at <index .flag .neg>: error calling index: can't index item of type bool")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .i8}}", "<-7>")
  vec(dj, "{{.name | len}}{{if 2.5}}T{{range $i, $e := .age}}{{$i}}={{.}};{{else}}none{{end}}{{else}}F{{end}}", "3T|ERR|template: v:1:44: executing \"v\" at <.age>: range can't iterate over 30")
  vec(dt, "{{with .neg}}<{{and .i .u64}}>{{else}}E{{end}} - {{print .st .st}}", "<|ERR|template: v:1:20: executing \"v\" at <.i>: can't evaluate field i in type int")
}

test "exec vectors 16" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{printf \"% %o \" 1 nil}}{{$v := .flag}}[{{$v}}]", "%o %!(EXTRA int=1, <nil>)[true]")
  vec(dt, "{{println .st .si}}", "{1 bee [4]} [5 10 15]\n")
  vec(dj, "{{with .s}}<{{printf \"%T %o \" .nums .nul}}>{{else}}E{{end}}", "<|ERR|template: v:1:30: executing \"v\" at <.nums>: can't evaluate field nums in type string")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .u16}}", "<65535>")
  vec(dj, "{{true}}{{- \" trim \" -}}", "true trim ")
  vec(dt, "{{print .msi .}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .si 1)}}", "map[one:1 three:3 two:2] map[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 <nil> true] m:map[k:[7 8]]] nm:map[] np:<nil> ns:[] r:120 s:go & <alx> si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615]<10>")
  vec(dj, "{{.name}}", "Ann")
  vec(dt, "{{printf \"%+d %z \" .r 0x1F}}{{not .nest}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .msi \"one\")}}", "+120 %!z(int=31) false<1>")
  vec(dj, "{{not 'c'}}{{1}}", "false1")
  vec(dt, "{{len .}}{{.r}}", "24120")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .tags 1)}}{{slice .names 2}}", "<b>|ERR|template: v:1:64: executing \"v\" at <slice .names 2>: error calling slice: can't slice item of type map[string]interface {}")
  vec(dt, "{{not .s}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0x1F}}{{not .u64}}", "false<31>false")
  vec(dj, "{{eq -3 .name 1}}{{with .tags}}<{{and .zero .tags}}>{{else}}E{{end}}{{.zero}}", "|ERR|template: v:1:2: executing \"v\" at <eq -3 .name 1>: error calling eq: incompatible types for comparison: int and string")
  vec(dt, "{{range $i, $e := .mis}}{{$i}}={{.}};{{else}}none{{end}}", "1=a;2=b;3=c;")
  vec(dj, "{{with .empty}}<{{with .s}}<{{.nums | eq 1}}>{{else}}E{{end}}>{{else}}E{{end}}{{index .s .uni}}{{ne .names.a .s}}", "E|ERR|template: v:1:80: executing \"v\" at <index .s .uni>: error calling index: cannot index slice/array with type string")
  vec(dt, "{{eq .t .neg .}}{{or .s 1}}{{printf \"%G %\#o %E \" false (slice .si 1 2) (index .nest.list 1)}}", "|ERR|template: v:1:2: executing \"v\" at <eq .t .neg .>: error calling eq: incompatible types for comparison: bool and int")
  vec(dj, "{{.names | printf \"%v\"}}{{printf \"%E %-5d| %p \" \"\" (slice .tags 1) 1}}", "map[a:A b:B c:]%!E(string=) [%!d(string=b    ) %!d(string=c    )]| %!p(int=1) ")
  vec(dt, "{{eq .nest.m.k .ss}}{{and (index .si 1) .nest}}{{and .i8 0}}", "|ERR|template: v:1:2: executing \"v\" at <eq .nest.m.k .ss>: error calling eq: non-comparable type [x y]: []string")
  vec(dj, "{{$v := \"\"}}[{{$v}}]{{$v := .tags}}[{{$v}}]", "[][[a b c]]")
  vec(dt, "{{range $i, $e := .bs}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{printf \"%.2s % x %U \" 2.5 .e .ns}}", "0=%!s(float64=2.5)  [] ")
  vec(dj, "{{'c' | printf \"%v\"}}", "99")
  vec(dt, "{{$v := .f32}}[{{$v}}]", "[0.1]")
  vec(dj, "{{$ | eq 1}}", "|ERR|template: v:1:6: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and map[string]interface {}")
  vec(dt, "{{len .s}}{{not (index .si 1)}}", "10false")
  vec(dj, "{{.flag}}{{.obj.y}}{{false | printf \"%q\"}}", "true<no value>%!q(bool=false)")
  vec(dt, "{{range $i, $e := .np}}{{$i}}={{.}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <.np>: range can't iterate over <nil>")
  vec(dj, "{{printf \"%q % %p \" 1i (index .obj.z 2) .s}}{{and .nul 0}}", "%!q(complex128=(0+1i)) %p %!(EXTRA map[string]interface {}=map[k:v], string=<b>&'\"x\"</b> =)<no value>")
  vec(dt, "{{urlquery 'c' (index .msi \"one\")}}", "99+1")
  vec(dj, "{{range $i, $e := false}}{{$i}}={{.}};{{else}}none{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .uni}}", "|ERR|template: v:1:18: executing \"v\" at <false>: range can't iterate over false")
  vec(dt, "{{slice .neg 0}}{{$v := .si}}[{{$v}}]", "|ERR|template: v:1:2: executing \"v\" at <slice .neg 0>: error calling slice: can't slice item of type int")
  vec(dj, "{{and .obj.x .uni}}{{range $i, $e := .neg}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "héllo, 世界|ERR|template: v:1:37: executing \"v\" at <.neg>: range can't iterate over -2")
  vec(dt, "{{$v := .nest.m.k}}[{{$v}}]{{with -3}}<{{$v := .e}}[{{$v}}]>{{else}}E{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 2.5}}", "[[7 8]]<|ERR|template: v:1:47: executing \"v\" at <.e>: can't evaluate field e in type int")
  vec(dj, "{{$v := .nul}}[{{$v}}]{{le .obj.z 0x1F}}", "[<no value>]|ERR|template: v:1:24: executing \"v\" at <le .obj.z 0x1F>: error calling le: invalid type for comparison")
  vec(dt, "{{printf \"%b \" .st.A}}", "1 ")
  vec(dj, "{{printf \"%s %\#v %s \" \"str\" 2.5 .}}{{len .name}}", "str 2.5 map[age:%!s(float64=30) big:%!s(float64=1e+21) empty:[] flag:%!s(bool=true) name:Ann names:map[a:A b:B c:] neg:%!s(float64=-2) no:%!s(bool=false) nul:<nil> nums:[%!s(float64=3) %!s(float64=1) %!s(float64=2)] obj:map[w:wide x:%!s(float64=1) y:<nil> z:[%!s(float64=1) %!s(float64=2) map[k:v]]] pi:%!s(float64=3.14159) s:<b>&'\"x\"</b> = tags:[a b c] tiny:%!s(float64=1.5e-07) uni:héllo, 世界 zero:%!s(float64=0)] 3")
  vec(dt, "{{with .ss}}<{{.st}}>{{else}}E{{end}}{{println (slice .s 1 4) .msi}}", "<|ERR|template: v:1:15: executing \"v\" at <.st>: can't evaluate field st in type []string")
  vec(dj, "{{and .uni .}}", "map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]")
  vec(dt, "{{le .r .s}}", "|ERR|template: v:1:2: executing \"v\" at <le .r .s>: error calling le: incompatible types for comparison: int32 and string")
  vec(dj, "{{slice true 0}}", "|ERR|template: v:1:2: executing \"v\" at <slice true 0>: error calling slice: can't slice item of type bool")
  vec(dt, "{{$v := .mis}}[{{$v}}]x", "[map[1:a 2:b 3:c]]x")
  vec(dj, "{{urlquery .nums true}}{{printf \"% x %8.3e %\#q \" .tags .big (len .tags)}}", "%5B3+1+2%5D+true[61 62 63] 1.000e+21 '\\x03' ")
  vec(dt, "{{.u16}}", "65535")
  vec(dj, "{{printf \"%o \" .obj.z}}", "[%!o(float64=1) %!o(float64=2) map[%!o(string=k):%!o(string=v)]] ")
  vec(dt, "{{if .nest.m.k}}T{{or .ns 1i}}{{else}}F{{end}}", "T(0+1i)")
  vec(dj, "{{with .uni}}<{{or .uni .nums}}>{{else}}E{{end}}text ", "<|ERR|template: v:1:19: executing \"v\" at <.uni>: can't evaluate field uni in type string")
  vec(dt, "{{.st}}{{println (len .si) .nm}}{{.si}}", "{1 bee [4]}3 map[]\n[5 10 15]")
  vec(dj, "{{if .tiny}}T{{if .obj.y}}T{{slice .obj.missing 0}}{{else}}F{{end}}{{else}}F{{end}}{{with .}}<{{printf \"%G %\#U \" (len .tags) true}}>{{else}}E{{end}}{{$v := .name}}[{{$v}}]", "TF<%!G(int=3) %!U(bool=true) >[Ann]")
  vec(dt, "{{if .msi.two}}T{{printf \"%E %v %x \" .msi.four .c .ns}}{{else}}F{{end}}{{ge 1 .missing}}", "T%!E(<nil>) (1.5-2i) [] |ERR|template: v:1:73: executing \"v\" at <ge 1 .missing>: error calling ge: invalid type for comparison")
  vec(dj, "{{lt 2.5 -3}}{{with (index .obj.z 2)}}<{{printf \"%*d \" (index .obj.z 2)}}>{{else}}E{{end}}{{not (slice .tags 1)}}", "|ERR|template: v:1:2: executing \"v\" at <lt 2.5 -3>: error calling lt: incompatible types for comparison: float64 and int")
  vec(dt, "{{if \"str\"}}T{{$v := (index .si 1)}}[{{$v}}]{{else}}F{{end}}{{not \"str\"}}{{ge .msi .r}}", "T[10]false|ERR|template: v:1:75: executing \"v\" at <ge .msi .r>: error calling ge: invalid type for comparison")
