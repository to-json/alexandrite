  vec(dt, "{{len .ns}}{{/* c */}}{{index .f32 \"str\"}}", "0|ERR|template: v:1:24: executing \"v\" at <index .f32 \"str\">: error calling index: can't index item of type float32")
  vec(dj, "{{gt (slice .tags 1) .names}}", "|ERR|template: v:1:2: executing \"v\" at <gt (slice .tags 1) .names>: error calling gt: invalid type for comparison")
