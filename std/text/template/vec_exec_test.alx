  vec(dt, "{{with .st.A}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .e}}>{{else}}E{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dj, "{{ne $ 0x1F}}{{.tiny}}", "|ERR|template: v:1:2: executing \"v\" at <ne $ 0x1F>: error calling ne: incompatible types for comparison: map[string]interface {} and int")
  vec(dt, "{{js .mfb 2.5}}", "map[-1:false 2.5:true] 2.5")
  vec(dj, "{{ne nil false}}{{.names}}{{1e3}}", "truemap[a:A b:B c:]1000")
  vec(dt, "{{printf \"%10s| %\#v \" .bs false}}", "        hi| false ")
