test "exec vectors 23" {
  dj = vec_json()
  dt = vec_typed()
  vec(dt, "{{true}}{{.missing}}{{gt .nest.list .}}", "true<no value>|ERR|template: v:1:22: executing \"v\" at <gt .nest.list .>: error calling gt: invalid type for comparison")
  vec(dj, "{{not .empty}}", "true")
