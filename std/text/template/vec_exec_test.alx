  vec(dj, "{{printf \"%\#o %e \" .obj.z .obj.y}}", "[%!o(float64=1.00000) %!o(float64=2.00000) map[%!o(string=k):%!o(string=v)]] %!e(<nil>) ")
  vec(dt, "{{with (index .nest.list 1)}}<{{not 1i}}>{{else}}E{{end}}", "<false>")
