  vec(dt, "{{len .np}}{{not (index .sts 0)}}{{.s}}", "|ERR|template: v:1:2: executing \"v\" at <len .np>: error calling len: len of nil pointer")
  vec(dj, "{{if .obj}}T{{if 0}}T{{.empty}}{{else}}F{{end}}{{else}}F{{end}}{{not (.obj.z)}}{{printf \"% %\#x %b \" .name false .tags}}", "TFfalse%\#x %!b(string=Ann) %!(EXTRA bool=false, []interface {}=[a b c])")
