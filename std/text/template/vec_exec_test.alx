  vec(dt, "{{- \" trim \" -}}{{and .nest.m.k false}}{{with .st}}<{{if .neg}}T{{ge nil 1}}{{else}}F{{end}}>{{else}}E{{end}}", " trim false<|ERR|template: v:1:57: executing \"v\" at <.neg>: can't evaluate field neg in type template.vecSt")
