test "exec vectors 12" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{.obj.z | printf \"%v\"}}{{le (printf \"%03d\" 7) (len .tags)}}", "[1 2 map[k:v]]|ERR|template: v:1:26: executing \"v\" at <le (printf \"%03d\" 7) (len .tags)>: error calling le: incompatible types for comparison: string and int")
  vec(dt, "{{printf \"%.2s %10s| \" .missing 1i}}", "%!s(<nil>) %!s(complex128=(         0        +1i))| ")
  vec(dj, "{{or (index .nums 0) .neg}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 2.5}}{{eq .nul .pi}}", "3<2.5>false")
  vec(dt, "{{if .sts}}T{{gt .mis (slice .s 1 4)}}{{else}}F{{end}}{{$v := .u16}}[{{$v}}]{{printf \"%-5d| %+d %.0f \" 1 .s (index .si 1)}}", "T|ERR|template: v:1:14: executing \"v\" at <gt .mis (slice .s 1 4)>: error calling gt: invalid type for comparison")
  vec(dj, "x{{html $ .tiny}}{{with .nul}}<{{printf \"%\#q %\#o \" .zero .names.a}}>{{else}}E{{end}}", "xmap[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:&lt;nil&gt; nums:[3 1 2] obj:map[w:wide x:1 y:&lt;nil&gt; z:[1 2 map[k:v]]] pi:3.14159 s:&lt;b&gt;&amp;&\#39;&\#34;x&\#34;&lt;/b&gt; = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0] 1.5e-07E")
  vec(dt, "{{(index .nest.list 1)}}", "two")
  vec(dj, "{{-3 | eq 1}}{{printf \"%05d \" .empty}}{{range $i, $e := 1i}}{{$i}}={{.}};{{else}}none{{end}}", "false[] |ERR|template: v:1:56: executing \"v\" at <1i>: range can't iterate over (0+1i)")
  vec(dt, "{{with .msi.four}}<{{printf \"%10s| %.*f \" (index .msi \"one\") .u64}}>{{else}}E{{end}}", "E")
  vec(dj, "{{printf \"%v \" (len .tags)}}", "3 ")
  vec(dt, "{{$v := .u64}}[{{$v}}]{{range $i, $e := .msi}}{{$i}}={{continue}};{{else}}none{{end}}{{if (slice .s 1 4)}}T{{printf \"%s % d %G \" (index .nest.list 1) .st.A \"str\"}}{{else}}F{{end}}", "[18446744073709551615]one=three=two=Ttwo  1 %!G(string=str) ")
