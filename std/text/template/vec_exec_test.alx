  vec(dj, "{{and .uni (index .nums 0)}}", "3")
  vec(dt, "{{not (index .mis 2)}}", "false")
  vec(dj, "{{printf \"%U %T \" .obj.z 1i}}{{- \" trim \" -}}{{.obj}}", "[%!U(float64=1) %!U(float64=2) map[%!U(string=k):%!U(string=v)]] complex128  trim map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]]")
  vec(dt, "{{if .sts}}T{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .nm}}{{else}}F{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dj, "{{eq (.obj.z) nil}}text ", "falsetext ")
  vec(dt, "{{printf \"%*d %+d \" true 0}}{{ge . true}}", "%!(BADWIDTH)0 %!d(MISSING) |ERR|template: v:1:30: executing \"v\" at <ge . true>: error calling ge: invalid type for comparison")
  vec(dj, "{{$v := .obj.z}}[{{$v}}]", "[[1 2 map[k:v]]]")
  vec(dt, "{{println .u16 1}}{{html .st.C .e}}{{printf \"%6.2g %z %b \" .msi (index .nest.list 1) .msi}}", "65535 1\n[4]map[%!g(string=    on):%!g(int=    01) %!g(string=    th):%!g(int=    03) %!g(string=    tw):%!g(int=    02)] %!z(string=two) map[%!b(string=one):1 %!b(string=three):11 %!b(string=two):10] ")
  vec(dj, "{{printf \"%z \" .nul}}x", "%!z(<nil>) x")
  vec(dt, "text ", "text ")
  vec(dj, "{{$v := .neg}}[{{$v}}]", "[-2]")
