  vec(dt, "{{.mis | html}}{{ne .mfb .i}}{{slice .mfb 0}}", "map[1:a 2:b 3:c]|ERR|template: v:1:17: executing \"v\" at <ne .mfb .i>: error calling ne: incompatible types for comparison: map[float64]bool and int")
  vec(dj, "{{(index .obj.z 2)}}{{printf \"%.2s %.0f %e \" .neg (index .obj.z 2) .uni}}{{printf \"%E %\#q \" (index .nums 0) \"\"}}", "map[k:v]%!s(float64=-2) map[%!f(string=):%!f(string=)] %!e(string=héllo, 世界) 3.000000E+00 `` ")
  vec(dt, "{{lt .sts (len .si)}}{{true}}", "|ERR|template: v:1:2: executing \"v\" at <lt .sts (len .si)>: error calling lt: invalid type for comparison")
  vec(dj, "{{with .age}}<{{$v := (printf \"%03d\" 7)}}[{{$v}}]>{{else}}E{{end}}", "<[007]>")
  vec(dt, "{{$v := .msi}}[{{$v}}]{{with .c}}<{{printf \"%x \" 0}}>{{else}}E{{end}}", "[map[one:1 three:3 two:2]]<0 >")
  vec(dj, "{{$v := .big}}[{{$v}}]{{not (index .nums 0)}}", "[1e+21]false")
  vec(dt, "{{.r}}", "120")
  vec(dj, "{{/* c */}}{{println 1e3 .no}}", "1000 false\n")
  vec(dt, "{{len .st.B}}{{and .si .i}}{{range $i, $e := (index .msi \"one\")}}{{$i}}={{continue}};{{else}}none{{end}}", "342|ERR|template: v:1:57: executing \"v\" at <\"one\">: can't use 1 to iterate over more than one variable")
  vec(dj, "{{with 2.5}}<{{if .pi}}T{{\"\"}}{{else}}F{{end}}>{{else}}E{{end}}{{range $i, $e := .no}}{{$i}}={{continue}};{{else}}none{{end}}{{printf \"%f % %d \" -3 .big .}}", "<|ERR|template: v:1:18: executing \"v\" at <.pi>: can't evaluate field pi in type float64")
  vec(dt, "{{.f32}}", "0.1")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0x1F}}{{not .big}}{{.tags | len}}", "<31>false3")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0}}{{and .neg .i}}", "<0>42")
  vec(dj, "{{printf \"% d %U %f \" .obj -3 .obj}}", "map[%!d(string=w):%!d(string=wide) %!d(string=x):%!d(float64= 1) %!d(string=y):<nil> %!d(string=z):[%!d(float64= 1) %!d(float64= 2) map[%!d(string=k):%!d(string=v)]]] U+FFFFFFFFFFFFFFFD map[%!f(string=w):%!f(string=wide) %!f(string=x):1.000000 %!f(string=y):<nil> %!f(string=z):[1.000000 2.000000 map[%!f(string=k):%!f(string=v)]]] ")
  vec(dt, "{{not (slice .si 1 2)}}{{ge 0 .msi}}{{ge 0x1F \"str\"}}", "false|ERR|template: v:1:25: executing \"v\" at <ge 0 .msi>: error calling ge: invalid type for comparison")
  vec(dj, "{{$v := .s}}[{{$v}}]{{len .neg}}{{not .empty}}", "[<b>&'\"x\"</b> =]|ERR|template: v:1:22: executing \"v\" at <len .neg>: error calling len: len of type float64")
  vec(dt, "x{{ne . .s}}{{ne \"str\" .st.C}}", "x|ERR|template: v:1:3: executing \"v\" at <ne . .s>: error calling ne: incompatible types for comparison: map[string]interface {} and string")
  vec(dj, "{{(len .tags) | printf \"%v\"}}{{nil}}", "3|ERR|template: v:1:31: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "{{.nest.list | len}}{{(index .nest.list 1)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"str\"}}", "5two<str>")
  vec(dj, "{{print .zero .zero}}", "0 0")
  vec(dt, "{{.si | html}}", "[5 10 15]")
  vec(dj, "{{or .uni .zero}}{{len .tags}}", "héllo, 世界3")
  vec(dt, "{{(index .si 1) | printf \"%q\"}}", "'\\n'")
  vec(dj, "{{println 0x1F 1e3}}", "31 1000\n")
  vec(dt, "{{or .msi.four -3}}", "-3")
  vec(dj, "{{js .zero false}}", "0 false")
  vec(dt, "{{.mfb | html}}{{if .st}}T{{$v := .f32}}[{{$v}}]{{else}}F{{end}}text ", "map[-1:false 2.5:true]T[0.1]text ")
  vec(dj, "{{if (index .nums 0)}}T{{le .zero \"str\"}}{{else}}F{{end}}", "T|ERR|template: v:1:25: executing \"v\" at <le .zero \"str\">: error calling le: incompatible types for comparison: float64 and string")
  vec(dt, "{{not .neg}}", "false")
}

test "exec vectors 27" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{true | html}}{{ne true \"\"}}", "true|ERR|template: v:1:17: executing \"v\" at <ne true \"\">: error calling ne: incompatible types for comparison: bool and string")
  vec(dt, "{{false}}{{if .si}}T{{le .nest.m.k .msi.two}}{{else}}F{{end}}{{printf \"%F %[2]v %[1]v \" .st .nest.list}}", "falseT|ERR|template: v:1:22: executing \"v\" at <le .nest.m.k .msi.two>: error calling le: invalid type for comparison")
  vec(dj, "{{with .obj}}<{{js .name .empty}}>{{else}}E{{end}}", "<\\u003Cno value\\u003E\\u003Cno value\\u003E>")
  vec(dt, "{{range $i, $e := .s}}{{$i}}={{$e}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <.s>: range can't iterate over go & <alx>")
  vec(dj, "{{printf \"%+d %x \" .pi .obj.w}}", "%!d(float64=+3.14159) 77696465 ")
  vec(dt, "{{(index .sts 0)}}{{or .f32 .msi.four}}", "{2  []}0.1")
  vec(dj, "{{range $i, $e := true}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{printf \"%+v %p %d \" .uni nil (index .obj.z 2)}}", "|ERR|template: v:1:18: executing \"v\" at <true>: range can't iterate over true")
  vec(dt, "{{and .msi.four .r}}{{.bs | printf \"%q\"}}{{range $i, $e := .msi}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "<no value>\"hi\"one=1;three=3;two=2;")
  vec(dj, "{{with 'c'}}<{{if .big}}T{{$v := $}}[{{$v}}]{{else}}F{{end}}>{{else}}E{{end}}", "<|ERR|template: v:1:18: executing \"v\" at <.big>: can't evaluate field big in type int")
  vec(dt, "{{\"str\"}}", "str")
  vec(dj, "{{printf \"%f %F \" .obj.z (index .nums 0)}}{{and 1i .obj.x}}", "[1.000000 2.000000 map[%!f(string=k):%!f(string=v)]] 3.000000 1")
  vec(dt, "{{eq .mis .neg}}{{not nil}}", "|ERR|template: v:1:2: executing \"v\" at <eq .mis .neg>: error calling eq: incompatible types for comparison: map[int]string and int")
  vec(dj, "text ", "text ")
