  vec(dj, "{{if .obj.x}}Tx{{else}}F{{end}}{{ne .nums (printf \"%03d\" 7)}}{{- \" trim \" -}}", "Tx|ERR|template: v:1:33: executing \"v\" at <ne .nums (printf \"%03d\" 7)>: error calling ne: incompatible types for comparison: []interface {} and string")
