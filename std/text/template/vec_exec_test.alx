  vec(dj, "{{ne .obj.x \"\"}}{{printf \"%U % x %v \" .nums .flag .names.a}}{{lt 0 'c'}}", "|ERR|template: v:1:2: executing \"v\" at <ne .obj.x \"\">: error calling ne: incompatible types for comparison: float64 and string")
