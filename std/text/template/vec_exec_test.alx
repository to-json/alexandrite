  vec(dj, "{{if .big}}T{{.flag | printf \"%v\"}}{{else}}F{{end}}{{printf \"%x % \" .tiny (index .tags 1)}}{{if 1e3}}T{{printf \"%v %*d %g \" .neg 1i 'c'}}{{else}}F{{end}}", "Ttrue0x1.421f5f40d8376p-23 %!(NOVERB)%!(EXTRA string=b)T-2 %!(BADWIDTH)99 %!g(MISSING) ")
  vec(dt, "{{with .st}}<{{printf \"%-10q| %o %O \" (slice .si 1 2) .mfb .nest.m.k}}>{{else}}E{{end}}{{with .ns}}<{{if .st.B}}T{{nil}}{{else}}F{{end}}>{{else}}E{{end}}{{and . .ss}}", "<|ERR|template: v:1:45: executing \"v\" at <.si>: can't evaluate field si in type template.vecSt")
  vec(dj, "{{html .tags .s}}{{not 'c'}}", "[a b c]&lt;b&gt;&amp;&\#39;&\#34;x&\#34;&lt;/b&gt; =false")
  vec(dt, "{{index .mis .missing}}{{.u16}}", "|ERR|template: v:1:2: executing \"v\" at <index .mis .missing>: error calling index: value is nil; should be of type int")
  vec(dj, "{{nil}}", "|ERR|template: v:1:2: executing \"v\" at <nil>: nil is not a command")
