  vec(dj, "{{$v := .s}}[{{$v}}]{{if \"str\"}}T{{.}}{{else}}F{{end}}{{not 0}}", "[<b>&'\"x\"</b> =]Tmap[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]true")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .neg}}{{printf \"%b %10s| %o \" .r .e \"str\"}}", "<-17>1111000           | %!o(string=str) ")
  vec(dj, "{{and .tags nil}}", "<no value>")
