  vec(dj, "{{range $i, $e := (index .tags 1)}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{printf \"%U %-10q| \" (index .tags 1) \"str\"}}{{range $i, $e := .missing}}{{$i}}={{continue}};{{else}}none{{end}}", "|ERR|template: v:1:31: executing \"v\" at <1>: range can't iterate over b")
