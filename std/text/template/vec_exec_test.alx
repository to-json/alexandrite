  vec(dt, "{{with .bs}}<{{if (slice .s 1 4)}}T{{(slice .s 1 4)}}{{else}}F{{end}}>{{else}}E{{end}}{{or .st.C .st.B}}", "<|ERR|template: v:1:25: executing \"v\" at <.s>: can't evaluate field s in type []uint8")
  vec(dj, "{{$}}", "map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]")
