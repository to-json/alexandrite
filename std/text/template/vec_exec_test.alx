  vec(dj, "{{not .missing}}{{.neg}}", "true-2")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .st.A}}", "<1>")
  vec(dj, "{{not $}}", "false")
  vec(dt, "{{if .}}T{{/* c */}}{{else}}F{{end}}{{with .i8}}<{{printf \"%6.2g \" .mfb}}>{{else}}E{{end}}{{not (slice .s 1 4)}}", "T<|ERR|template: v:1:67: executing \"v\" at <.mfb>: can't evaluate field mfb in type int8")
  vec(dj, "{{slice .flag 2}}{{range $i, $e := .names.a}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .obj.z 2)}}", "|ERR|template: v:1:2: executing \"v\" at <slice .flag 2>: error calling slice: can't slice item of type bool")
  vec(dt, "{{ge .nest.list .nm}}", "|ERR|template: v:1:2: executing \"v\" at <ge .nest.list .nm>: error calling ge: invalid type for comparison")
  vec(dj, "{{if (printf \"%03d\" 7)}}T{{$v := .zero}}[{{$v}}]{{else}}F{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" false}}{{.obj.y}}", "T[0]<false><no value>")
  vec(dt, "{{ge .nest.m.k .}}{{ne 1i .f32}}{{.msi.two}}", "|ERR|template: v:1:2: executing \"v\" at <ge .nest.m.k .>: error calling ge: invalid type for comparison")
  vec(dj, "{{range $i, $e := 1}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <1>: can't use 1 to iterate over more than one variable")
