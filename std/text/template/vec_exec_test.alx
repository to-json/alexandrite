  vec(dt, "{{- \" trim \" -}}", " trim ")
  vec(dj, "{{if (len .tags)}}T{{index -3}}{{else}}F{{end}}{{$v := .names.a}}[{{$v}}]{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (.obj.z)}}", "T-3[A]<[1 2 map[k:v]]>")
  vec(dt, "{{$v := .neg}}[{{$v}}]{{printf \"%X %+v \" .s 1}}", "[-17]676F2026203C616C783E 1 ")
