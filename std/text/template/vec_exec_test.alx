  vec(dt, "{{printf \"%.0f \" .u16}}{{and .st.B .}}", "%!f(uint16=65535) map[bs:[104 105] c:(1.5-2i) e: f:2.5 f32:0.1 i:42 i8:-7 mfb:map[-1:false 2.5:true] mis:map[1:a 2:b 3:c] msi:map[one:1 three:3 two:2] neg:-17 nest:map[list:[1 two 3 <nil> true] m:map[k:[7 8]]] nm:map[] np:<nil> ns:[] r:120 s:go & <alx> si:[5 10 15] ss:[x y] st:{1 bee [4]} sts:[{2  []} {0 b []}] t:true u16:65535 u64:18446744073709551615]")
