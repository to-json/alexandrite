  vec(dt, "{{range $i, $e := .ns}}{{$i}}={{continue}};{{else}}none{{end}} - ", "none - ")
  vec(dj, "{{false | html}}", "false")
  vec(dt, "{{$v := .st}}[{{$v}}]", "[{1 bee [4]}]")
  vec(dj, "{{printf \"%x \" .no}}{{and .obj.z 2.5}}", "%!x(bool=false) 2.5")
  vec(dt, "{{if 'c'}}T{{printf \"%5.2f \" .nest.m.k}}{{else}}F{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .u64}}", "T[%!f(int=   07) %!f(int=   08)] <18446744073709551615>")
