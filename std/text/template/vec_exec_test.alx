  vec(dt, "{{if true}}T{{range $i, $e := .nest.m.k}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{else}}F{{end}}{{1i | not}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 2.5}}", "T0=7;1=8;false<2.5>")
  vec(dj, "{{gt .name true}}{{slice $ 2}}{{.neg}}", "|ERR|template: v:1:2: executing \"v\" at <gt .name true>: error calling gt: incompatible types for comparison: string and bool")
