  vec(dt, "{{- \" trim \" -}}{{len .e}}{{range $i, $e := .i}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", " trim 0|ERR|template: v:1:44: executing \"v\" at <.i>: can't use 42 to iterate over more than one variable")
