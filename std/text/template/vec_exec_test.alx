  vec(dj, "{{printf \"%+d %\#q \" (index .obj.z 2) .}}", "map[%!d(string=k):%!d(string=v)] map[`age`:%!q(float64=30.0000) `big`:%!q(float64=1.00000e+21) `empty`:[] `flag`:%!q(bool=true) `name`:`Ann` `names`:map[`a`:`A` `b`:`B` `c`:``] `neg`:%!q(float64=-2.00000) `no`:%!q(bool=false) `nul`:<nil> `nums`:[%!q(float64=3.00000) %!q(float64=1.00000) %!q(float64=2.00000)] `obj`:map[`w`:`wide` `x`:%!q(float64=1.00000) `y`:<nil> `z`:[%!q(float64=1.00000) %!q(float64=2.00000) map[`k`:`v`]]] `pi`:%!q(float64=3.14159) `s`:`<b>&'\"x\"</b> =` `tags`:[`a` `b` `c`] `tiny`:%!q(float64=1.50000e-07) `uni`:`héllo, 世界` `zero`:%!q(float64=0.00000)] ")
  vec(dt, "{{urlquery 1i (index .sts 0)}}", "%280%2B1i%29+%7B2++%5B%5D%7D")
  vec(dj, "{{$v := .}}[{{$v}}]{{not (index .tags 1)}}", "[map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]]false")
  vec(dt, "{{(index .nest.list 1)}}", "two")
