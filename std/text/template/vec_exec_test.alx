  vec(dj, " - {{if (len .tags)}}T{{slice (len .tags) 1}}{{else}}F{{end}}", " - T|ERR|template: v:1:24: executing \"v\" at <slice (len .tags) 1>: error calling slice: can't slice item of type int")
