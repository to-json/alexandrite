  vec(dt, "{{not .st.C}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .u64}}{{.ns | printf \"%q\"}}", "false<18446744073709551615>[]")
  vec(dj, "{{if .}}T{{.uni}}{{else}}F{{end}}", "Théllo, 世界")
  vec(dt, "{{.s | print}}{{printf \"%b %5.2f %\#v \" -3 .i .ns}}{{range $i, $e := -3}}{{$i}}={{.}};{{else}}none{{end}}", "go & <alx>-11 %!f(int=   42) []int(nil) |ERR|template: v:1:68: executing \"v\" at <-3>: can't use -3 to iterate over more than one variable")
