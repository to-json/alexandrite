  vec(dt, "{{not (index .nest.list 1)}}", "false")
  vec(dj, "{{.age}}", "30")
  vec(dt, "{{or .t .t}}{{not .nest.m.k}}{{printf \"%\#v %G %\#q \" .t . .mis}}", "truefalsetrue map[%!G(string=bs):[%!G(uint8=104) %!G(uint8=105)] %!G(string=c):(1.5-2i) %!G(string=e):%!G(string=) %!G(string=f):2.5 %!G(string=f32):0.1 %!G(string=i):%!G(int=42) %!G(string=i8):%!G(int8=-7) %!G(string=mfb):map[-1:%!G(bool=false) 2.5:%!G(bool=true)] %!G(string=mis):map[%!G(int=1):%!G(string=a) %!G(int=2):%!G(string=b) %!G(int=3):%!G(string=c)] %!G(string=msi):map[%!G(string=one):%!G(int=1) %!G(string=three):%!G(int=3) %!G(string=two):%!G(int=2)] %!G(string=neg):%!G(int=-17) %!G(string=nest):map[%!G(string=list):[%!G(int=1) %!G(string=two) 3 <nil> %!G(bool=true)] %!G(string=m):map[%!G(string=k):[%!G(int=7) %!G(int=8)]]] %!G(string=nm):map[] %!G(string=np):%!G(*int=<nil>) %!G(string=ns):[] %!G(string=r):%!G(int32=120) %!G(string=s):%!G(string=go & <alx>) %!G(string=si):[%!G(int=5) %!G(int=10) %!G(int=15)] %!G(string=ss):[%!G(string=x) %!G(string=y)] %!G(string=st):{%!G(int=1) %!G(string=bee) [%!G(int=4)]} %!G(string=sts):[{%!G(int=2) %!G(string=) []} {%!G(int=0) %!G(string=b) []}] %!G(string=t):%!G(bool=true) %!G(string=u16):%!G(uint16=65535) %!G(string=u64):%!G(uint64=18446744073709551615)] map['\\x01':`a` '\\x02':`b` '\\x03':`c`] ")
  vec(dj, "{{with $}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" nil}}>{{else}}E{{end}}{{and .pi .obj.x}}{{slice 0 0}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "{{(index .sts 0)}}{{$v := 2.5}}[{{$v}}]", "{2  []}[2.5]")
  vec(dj, "{{.tags}}", "[a b c]")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .t}}", "<true>")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"\"}}", "<>")
  vec(dt, "{{range $i, $e := .i8}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <.i8>: can't use -7 to iterate over more than one variable")
  vec(dj, "{{.obj.x}}{{html \"\" .obj.z}}", "1[1 2 map[k:v]]")
  vec(dt, "{{.f}}{{printf \"%+d %5.2f %v \" .st.C .bs .sts}}{{len .c}}", "2.5[+4] [%!f(uint8=  104) %!f(uint8=  105)] [{2  []} {0 b []}] |ERR|template: v:1:49: executing \"v\" at <len .c>: error calling len: len of type complex128")
  vec(dj, " - {{$v := .missing}}[{{$v}}]", " - [<no value>]")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .msi.two}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" nil}}", "PARSE:template: v:1: template: multiple definition of template \"t1\"")
  vec(dj, "{{.pi}}{{if .obj.x}}T{{printf \"%T \" (printf \"%03d\" 7)}}{{else}}F{{end}}{{printf \"%c \" \"str\"}}", "3.14159Tstring %!c(string=str) ")
  vec(dt, "{{le .st .si}}{{println .s .u64}}{{0}}", "|ERR|template: v:1:2: executing \"v\" at <le .st .si>: error calling le: invalid type for comparison")
  vec(dj, "{{with 0}}<{{- \" trim \" -}}>{{else}}E{{end}}{{\"str\"}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" false}}", "Estr<false>")
  vec(dt, "{{range $i, $e := .neg}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <.neg>: can't use -17 to iterate over more than one variable")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .age}}", "<30>")
  vec(dt, "{{and .sts .u64}}{{lt .neg .u64}}", "18446744073709551615true")
  vec(dj, "{{and 1i $}}{{slice .obj.missing 2}}", "map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]|ERR|template: v:1:14: executing \"v\" at <slice .obj.missing 2>: error calling slice: slice of untyped nil")
  vec(dt, "{{not 0x1F}}", "false")
  vec(dj, "{{le .name .obj.w}}{{le .uni .nums}}", "true|ERR|template: v:1:21: executing \"v\" at <le .uni .nums>: error calling le: invalid type for comparison")
  vec(dt, "{{html 'c' .missing}}", "99&lt;no value&gt;")
  vec(dj, "{{printf \"%5.2f %\#x \" .zero .names}}{{not .}}", " 0.00 map[0x61:0x41 0x62:0x42 0x63:] false")
  vec(dt, "{{if .msi.two}}T{{range $i, $e := .bs}}{{$i}}={{continue}};{{else}}none{{end}}{{else}}F{{end}}", "T0=1=")
  vec(dj, "{{lt .nul 0}}{{if .obj.x}}T{{.obj.x}}{{else}}F{{end}}", "|ERR|template: v:1:2: executing \"v\" at <lt .nul 0>: error calling lt: invalid type for comparison")
  vec(dt, "{{ge .i .nest.list}}{{.si}}{{not (slice .si 1 2)}}", "|ERR|template: v:1:2: executing \"v\" at <ge .i .nest.list>: error calling ge: invalid type for comparison")
  vec(dj, "{{range $i, $e := 1}}{{$i}}={{.}};{{else}}none{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .s}}", "|ERR|template: v:1:18: executing \"v\" at <1>: can't use 1 to iterate over more than one variable")
  vec(dt, "{{js .ns .st}}{{.r}}", "[] {1 bee [4]}120")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .big}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .nums}}{{or .pi .obj.w}}", "PARSE:template: v:1: template: multiple definition of template \"t1\"")
  vec(dt, "{{le nil .si}}", "|ERR|template: v:1:2: executing \"v\" at <le nil .si>: error calling le: invalid type for comparison")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj.y}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" $}}", "PARSE:template: v:1: template: multiple definition of template \"t1\"")
  vec(dt, "{{(slice .s 1 4)}}{{printf \"%s \" 2.5}}", "o &%!s(float64=2.5) ")
  vec(dj, "{{and -3 2.5}}{{println 1e3 .no}}{{printf \"%\#o %z \" .empty (len .tags)}}", "2.51000 false\n[] %!z(int=3) ")
  vec(dt, "{{gt .nm .st}}", "|ERR|template: v:1:2: executing \"v\" at <gt .nm .st>: error calling gt: invalid type for comparison")
  vec(dj, "{{not .age}}", "false")
  vec(dt, "{{$v := true}}[{{$v}}]{{lt .bs .st.C}}{{.ns}}", "[true]|ERR|template: v:1:24: executing \"v\" at <lt .bs .st.C>: error calling lt: invalid type for comparison")
  vec(dj, "{{printf \"%p %! \" (index .tags 1) false}}{{range $i, $e := (slice .tags 1)}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "%!p(string=b) %!!(bool=false) 0=")
  vec(dt, "{{lt .si .si}}", "|ERR|template: v:1:2: executing \"v\" at <lt .si .si>: error calling lt: invalid type for comparison")
  vec(dj, "{{if .big}}T{{not 0}}{{else}}F{{end}}{{index (index .nums 0)}}{{ge .big false}}", "Ttrue3|ERR|template: v:1:64: executing \"v\" at <ge .big false>: error calling ge: incompatible types for comparison: float64 and bool")
  vec(dt, "{{printf \"% x %.2s %x \" .mis 0x1F .c}}{{index .s nil}}{{.st.C}}", "map[ 1:61  2:62  3:63] %!s(int=31) (0x1.8p+00-0x1p+01i) |ERR|template: v:1:40: executing \"v\" at <index .s nil>: error calling index: cannot index slice/array with nil")
  vec(dj, "{{with .nums}}<{{index \"\"}}>{{else}}E{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (.obj.z)}}", "<><[1 2 map[k:v]]>")
  vec(dt, "{{printf \"%6.2g %s \" nil .mis}}", "%!g(<nil>) map[%!s(int=1):a %!s(int=2):b %!s(int=3):c] ")
  vec(dj, "{{eq .missing .uni}}", "false")
  vec(dt, "{{printf \"%\#o % d \" .f .r}} - {{with (slice .s 1 4)}}<{{with 1}}<{{eq .neg .msi.two}}>{{else}}E{{end}}>{{else}}E{{end}}", "%!o(float64=2.50000)  120  - <<|ERR|template: v:1:70: executing \"v\" at <.neg>: can't evaluate field neg in type int")
  vec(dj, "{{(slice .tags 1)}}{{eq .no $}}", "[b c]|ERR|template: v:1:21: executing \"v\" at <eq .no $>: error calling eq: incompatible types for comparison: bool and map[string]interface {}")
  vec(dt, "{{.r}}{{$v := (index .msi \"one\")}}[{{$v}}]", "120[1]")
}

test "exec vectors 10" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{ne \"str\" (printf \"%03d\" 7)}}{{with true}}<{{html (.obj.z) \"\"}}>{{else}}E{{end}}", "true<|ERR|template: v:1:56: executing \"v\" at <.obj.z>: can't evaluate field obj in type bool")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .np}}{{not .st}}", "<<nil>>false")
  vec(dj, "{{.obj.y}}{{.names | printf \"%q\"}}", "<no value>map[\"a\":\"A\" \"b\":\"B\" \"c\":\"\"]")
  vec(dt, "{{range $i, $e := .msi.two}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "|ERR|template: v:1:22: executing \"v\" at <.msi.two>: can't use 2 to iterate over more than one variable")
  vec(dj, "{{.tags}}text ", "[a b c]text ")
  vec(dt, "{{$v := .ns}}[{{$v}}]", "[[]]")
  vec(dj, "{{len .zero}}", "|ERR|template: v:1:2: executing \"v\" at <len .zero>: error calling len: len of type float64")
  vec(dt, "{{printf \"%F %[2]v %[1]v \" (index .nest.list 1) .msi.four}}{{lt .ns (slice .si 1 2)}}", "%!F(string=two) <nil> two |ERR|template: v:1:61: executing \"v\" at <lt .ns (slice .si 1 2)>: error calling lt: invalid type for comparison")
  vec(dj, "{{with 2.5}}<{{len .nul}}>{{else}}E{{end}}{{\"\"}}{{index .zero .name}}", "<|ERR|template: v:1:19: executing \"v\" at <.nul>: can't evaluate field nul in type float64")
  vec(dt, "{{len .sts}}{{html .s .r}}", "2go &amp; &lt;alx&gt;120")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (slice .tags 1)}}", "<[b c]>")
  vec(dt, "{{ge (slice .s 1 4) .bs}}{{index .msi}}{{with .mis}}<{{1}}>{{else}}E{{end}}", "|ERR|template: v:1:2: executing \"v\" at <ge (slice .s 1 4) .bs>: error calling ge: invalid type for comparison")
  vec(dj, "{{len .obj.y}}", "|ERR|template: v:1:2: executing \"v\" at <len .obj.y>: error calling len: len of nil pointer")
  vec(dt, "{{$v := .t}}[{{$v}}]", "[true]")
  vec(dj, "{{.age}}{{.nums}}", "30[3 1 2]")
  vec(dt, "{{ge .st.C (len .si)}}", "|ERR|template: v:1:2: executing \"v\" at <ge .st.C (len .si)>: error calling ge: invalid type for comparison")
  vec(dj, "{{.tags}}{{printf \"%+d %c %z \" (len .tags) .s .obj.y}}", "[a b c]+3 %!c(string=<b>&'\"x\"</b> =) %!z(<nil>) ")
  vec(dt, "{{not (len .si)}}", "false")
  vec(dj, "{{range $i, $e := .obj.w}}{{$i}}={{.}};{{else}}none{{end}}{{or 0x1F .obj.w}}{{slice 1e3 0}}", "|ERR|template: v:1:22: executing \"v\" at <.obj.w>: range can't iterate over wide")
  vec(dt, "x{{.e}}{{.s | not}}", "xfalse")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 'c'}}", "<99>")
  vec(dt, "{{with 1}}<{{printf \"%5.2f %x %c \" \"str\" (len .si) .sts}}>{{else}}E{{end}}{{not .e}}", "<|ERR|template: v:1:46: executing \"v\" at <.si>: can't evaluate field si in type int")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .names.a}}{{index .empty}}", "<A>[]")
  vec(dt, "{{le (index .sts 0) true}}", "|ERR|template: v:1:2: executing \"v\" at <le (index .sts 0) true>: error calling le: invalid type for comparison")
  vec(dj, "{{if 'c'}}T{{printf \"%\#U %\#v \" .uni .big}}{{else}}F{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .big}}{{lt 'c' 0}}", "T%!U(string=héllo, 世界) 1e+21 <1e+21>false")
  vec(dt, "{{printf \"%! %E \" .ss .u16}}", "[%!!(string=x) %!!(string=y)] %!E(uint16=65535) ")
  vec(dj, "{{0x1F | not}}{{println (printf \"%03d\" 7) .big}}{{range $i, $e := false}}{{$i}}={{.}};{{else}}none{{end}}", "false007 1e+21\n|ERR|template: v:1:66: executing \"v\" at <false>: range can't iterate over false")
  vec(dt, "{{or false (index .nest.list 1)}}", "two")
  vec(dj, "{{index $}}", "map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]")
  vec(dt, "{{slice 'c' 2}}{{nil}}", "|ERR|template: v:1:2: executing \"v\" at <slice 'c' 2>: error calling slice: can't slice item of type int")
  vec(dj, "{{$v := -3}}[{{$v}}]{{html (.obj.z) .}}{{len (len .tags)}}", "[-3][1 2 map[k:v]] map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:&lt;nil&gt; nums:[3 1 2] obj:map[w:wide x:1 y:&lt;nil&gt; z:[1 2 map[k:v]]] pi:3.14159 s:&lt;b&gt;&amp;&\#39;&\#34;x&\#34;&lt;/b&gt; = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]|ERR|template: v:1:41: executing \"v\" at <len (len .tags)>: error calling len: len of type int")
  vec(dt, "{{println .t 0}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0x1F}}{{.r | printf \"%q\"}}", "true 0\n<31>'x'")
  vec(dj, "{{index 1i}}{{$v := 0}}[{{$v}}]", "(0+1i)[0]")
  vec(dt, "{{index .msi.two}}{{if .f}}T{{if .nm}}T{{.missing}}{{else}}F{{end}}{{else}}F{{end}}", "2TF")
  vec(dj, "{{range $i, $e := 'c'}}{{$i}}={{.}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <'c'>: can't use 99 to iterate over more than one variable")
  vec(dt, "{{.t}}{{printf \"%o %05d %f \" 0 true .c}}", "true0 %!d(bool=0true) (1.500000-2.000000i) ")
  vec(dj, "{{js .zero .s}}", "0\\u003Cb\\u003E\\u0026\\'\\\"x\\\"\\u003C/b\\u003E \\u003D")
  vec(dt, "{{printf \"% \" .u16}}{{with -3}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .bs}}>{{else}}E{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dj, "{{js .obj.y 1e3}}{{false}}{{le -3 (index .nums 0)}}", "\\u003Cno value\\u003E1000false|ERR|template: v:1:28: executing \"v\" at <le -3 (index .nums 0)>: error calling le: incompatible types for comparison: int and float64")
  vec(dt, "{{eq .nest.list .f}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 1i}}", "|ERR|template: v:1:2: executing \"v\" at <eq .nest.list .f>: error calling eq: incompatible types for comparison: []interface {} and float64")
  vec(dj, "{{with .no}}<{{range $i, $e := .empty}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}>{{else}}E{{end}}{{le 0 .age}}{{not nil}}", "E|ERR|template: v:1:111: executing \"v\" at <le 0 .age>: error calling le: incompatible types for comparison: int and float64")
  vec(dt, "{{html .st .st}}{{range $i, $e := .s}}{{$i}}={{.}};{{else}}none{{end}}", "{1 bee [4]} {1 bee [4]}|ERR|template: v:1:34: executing \"v\" at <.s>: range can't iterate over go & <alx>")
  vec(dj, "{{not .}}", "false")
  vec(dt, "{{and 1 .u64}}{{len nil}}", "18446744073709551615|ERR|template: v:1:16: executing \"v\" at <len nil>: error calling len: reflect: call of reflect.Value.Type on zero Value")
  vec(dj, "{{$ | print}}", "map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]")
  vec(dt, "{{not .bs}}{{gt .nest (slice .si 1 2)}}{{le 1 .msi.four}}", "false|ERR|template: v:1:13: executing \"v\" at <gt .nest (slice .si 1 2)>: error calling gt: invalid type for comparison")
