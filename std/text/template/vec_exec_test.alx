  vec(dt, "{{$v := nil}}[{{$v}}]{{printf \"%o %t %\#q \" (index .nest.list 1) \"str\" .bs}}{{printf \"% \" true}}", "|ERR|template: v:1:8: executing \"v\" at <nil>: nil is not a command")
