}

test "exec vectors 9" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{true | eq 1}}{{.name}}{{if $}}T{{printf \"% %[2]v %[1]v %E \" 'c' -3 $}}{{else}}F{{end}}", "|ERR|template: v:1:9: executing \"v\" at <eq 1>: error calling eq: incompatible types for comparison: int and bool")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 2.5}}{{range $i, $e := .f}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{with .i}}<x>{{else}}E{{end}}", "<2.5>|ERR|template: v:1:68: executing \"v\" at <.f>: range can't iterate over 2.5")
  vec(dj, "{{gt (index .tags 1) .obj.x}}{{ge (slice .tags 1) false}}{{and .nums .pi}}", "|ERR|template: v:1:2: executing \"v\" at <gt (index .tags 1) .obj.x>: error calling gt: incompatible types for comparison: string and float64")
  vec(dt, "{{$v := (len .si)}}[{{$v}}]", "[3]")
  vec(dj, "{{range $i, $e := .obj.missing}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{println .nums 1}}{{ne \"\" 2.5}}", "none[3 1 2] 1\n|ERR|template: v:1:106: executing \"v\" at <ne \"\" 2.5>: error calling ne: incompatible types for comparison: string and float64")
  vec(dt, "{{urlquery (index .sts 0) (slice .si 1 2)}}{{not (index .sts 0)}}", "%7B2++%5B%5D%7D+%5B10%5Dfalse")
  vec(dj, "{{false}}{{0x1F | len}}{{lt 1i -3}}", "false|ERR|template: v:1:18: executing \"v\" at <len>: error calling len: len of type int")
  vec(dt, "{{ne 1 .}}", "|ERR|template: v:1:2: executing \"v\" at <ne 1 .>: error calling ne: incompatible types for comparison: int and map[string]interface {}")
  vec(dj, "{{lt 1e3 2.5}}{{slice .age 0}}", "false|ERR|template: v:1:16: executing \"v\" at <slice .age 0>: error calling slice: can't slice item of type float64")
  vec(dt, "{{$v := 'c'}}[{{$v}}]{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0x1F}}", "[99]<31>")
  vec(dj, "{{or .s .obj.missing}}{{$v := 1i}}[{{$v}}]", "<b>&'\"x\"</b> =[(0+1i)]")
  vec(dt, "{{println .mfb .f}}", "map[-1:false 2.5:true] 2.5\n")
  vec(dj, "{{eq .age .obj.missing}}{{html .obj.x .no}}{{with 'c'}}<{{printf \"%o %c %5.2f \" \"\" (index .nums 0) .obj.w}}>{{else}}E{{end}}", "false1 false<|ERR|template: v:1:90: executing \"v\" at <.nums>: can't evaluate field nums in type int")
  vec(dt, "x", "x")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .names}}{{if .flag}}T{{or .missing .obj.x}}{{else}}F{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj.x}}", "PARSE:template: v:1: template: multiple definition of template \"t1\"")
  vec(dt, "{{index nil}}{{$v := .}}[{{$v}}]", "|ERR|template: v:1:2: executing \"v\" at <index nil>: error calling index: index of untyped nil")
  vec(dj, "{{eq 'c' .neg .obj.w}}{{println . .empty}}{{/* c */}}", "|ERR|template: v:1:2: executing \"v\" at <eq 'c' .neg .obj.w>: error calling eq: incompatible types for comparison: int and float64")
  vec(dt, "{{printf \"%s %c %05d \" 'c' .missing .missing}}{{println .bs .i}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .si 1)}}", "%!s(int=99) %!c(<nil>) %!d(<nil>) [104 105] 42\n<10>")
  vec(dj, "{{printf \"% %*d %x \" -3 .obj.x .flag}}", "%*d -3 %!(EXTRA float64=1, bool=true)")
  vec(dt, "{{ge .st.C .}}", "|ERR|template: v:1:2: executing \"v\" at <ge .st.C .>: error calling ge: invalid type for comparison")
  vec(dj, "{{range $i, $e := (.obj.z)}}{{$i}}={{continue}};{{else}}none{{end}}{{le .tiny .obj.missing}}", "0=1=2=|ERR|template: v:1:69: executing \"v\" at <le .tiny .obj.missing>: error calling le: invalid type for comparison")
  vec(dt, "{{not 1}}{{-3}}{{eq (index .mis 2) (index .nest.list 1)}}", "false-3false")
  vec(dj, " - {{or .big 'c'}}", " - 1e+21")
  vec(dt, "{{range $i, $e := (len .si)}}{{$i}}={{continue}};{{else}}none{{end}}{{$v := .st}}[{{$v}}]", "|ERR|template: v:1:23: executing \"v\" at <.si>: can't use 3 to iterate over more than one variable")
  vec(dj, "{{with .obj.w}}<{{and .names (len .tags)}}>{{else}}E{{end}}", "<|ERR|template: v:1:22: executing \"v\" at <.names>: can't evaluate field names in type string")
  vec(dt, "{{not .msi.four}}{{or .i .st.A}}{{.t}}", "true42true")
  vec(dj, "{{printf \"%! %x \" .no $}}{{.neg}}", "%!!(bool=false) map[616765:0x1.ep+04 626967:0x1.b1ae4d6e2ef5p+69 656d707479:[] 666c6167:%!x(bool=true) 6e616d65:416e6e 6e616d6573:map[61:41 62:42 63:] 6e6567:-0x1p+01 6e6f:%!x(bool=false) 6e756c:<nil> 6e756d73:[0x1.8p+01 0x1p+00 0x1p+01] 6f626a:map[77:77696465 78:0x1p+00 79:<nil> 7a:[0x1p+00 0x1p+01 map[6b:76]]] 7069:0x1.921f9f01b866ep+01 73:3c623e26272278223c2f623e203d 74616773:[61 62 63] 74696e79:0x1.421f5f40d8376p-23 756e69:68c3a96c6c6f2c20e4b896e7958c 7a65726f:0x0p+00] -2")
  vec(dt, "{{not 0x1F}}x{{.bs | printf \"%q\"}}", "falsex\"hi\"")
  vec(dj, "{{printf \"%f %c %.0f \" true 0x1F (index .obj.z 2)}}", "%!f(bool=true) \x1f map[%!f(string=):%!f(string=)] ")
  vec(dt, "{{printf \"%O %.0f \" .nest .nest.m.k}}{{printf \"%e %*d %E \" false 0x1F -3}}{{$v := \"str\"}}[{{$v}}]", "map[%!O(string=list):[0o1 %!O(string=two) %!O(float64=3) <nil> %!O(bool=true)] %!O(string=m):map[%!O(string=k):[0o7 0o10]]] [%!f(int=7) %!f(int=8)] %!e(bool=false)                              -3 %!E(MISSING) [str]")
  vec(dj, "{{.obj}}{{eq \"\" (index .tags 1) .nul}}{{with .no}}<x>{{else}}E{{end}}", "map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]]falseE")
  vec(dt, "{{with .i8}}<text >{{else}}E{{end}}", "<text >")
  vec(dj, "{{if 2.5}}T{{not .missing}}{{else}}F{{end}}{{.uni}}{{ne (len .tags) 1i}}", "Ttruehéllo, 世界|ERR|template: v:1:53: executing \"v\" at <ne (len .tags) 1i>: error calling ne: incompatible types for comparison: int and complex128")
  vec(dt, "{{(slice .si 1 2) | len}}{{$v := .st.C}}[{{$v}}]", "1[[4]]")
  vec(dj, "{{.big}}{{$}}{{len .big}}", "1e+21map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]|ERR|template: v:1:15: executing \"v\" at <len .big>: error calling len: len of type float64")
  vec(dt, "{{le (index .nest.list 1) .u64}}{{$v := .neg}}[{{$v}}]", "|ERR|template: v:1:2: executing \"v\" at <le (index .nest.list 1) .u64>: error calling le: incompatible types for comparison: string and uint64")
  vec(dj, "{{html $ 1i}}{{html .tags .age}}", "map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:&lt;nil&gt; nums:[3 1 2] obj:map[w:wide x:1 y:&lt;nil&gt; z:[1 2 map[k:v]]] pi:3.14159 s:&lt;b&gt;&amp;&\#39;&\#34;x&\#34;&lt;/b&gt; = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0] (0+1i)[a b c] 30")
  vec(dt, "{{printf \"%-5d| \" (index .nest.list 1)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .r}}", "%!d(string=two  )| <120>")
  vec(dj, "{{if .}}T{{not false}}{{else}}F{{end}}", "Ttrue")
  vec(dt, "{{.ns}}", "[]")
  vec(dj, "{{slice .neg 1}}{{index .empty}}{{2.5 | html}}", "|ERR|template: v:1:2: executing \"v\" at <slice .neg 1>: error calling slice: can't slice item of type float64")
  vec(dt, "{{lt .msi.four .nest.list}}{{.ss}}{{if .si}}T{{printf \"% %E \" nil .np}}{{else}}F{{end}}", "|ERR|template: v:1:2: executing \"v\" at <lt .msi.four .nest.list>: error calling lt: invalid type for comparison")
  vec(dj, "{{range $i, $e := (len .tags)}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "|ERR|template: v:1:23: executing \"v\" at <.tags>: can't use 3 to iterate over more than one variable")
  vec(dt, "{{range $i, $e := .u16}}{{$i}}={{$e}};{{else}}none{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0}}", "|ERR|template: v:1:18: executing \"v\" at <.u16>: can't use 65535 to iterate over more than one variable")
  vec(dj, "{{print .obj .name}}{{print .nums .no}}", "map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]]Ann[3 1 2] false")
  vec(dt, "{{gt .c .mfb}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .i8}}", "|ERR|template: v:1:2: executing \"v\" at <gt .c .mfb>: error calling gt: invalid type for comparison")
  vec(dj, "{{with .obj.w}}<{{printf \"%\#q \" false}}>{{else}}E{{end}}{{index .empty .flag}}{{js .obj.w .big}}", "<%!q(bool=false) >|ERR|template: v:1:58: executing \"v\" at <index .empty .flag>: error calling index: cannot index slice/array with type bool")
  vec(dt, "{{printf \"%o %.0f % d \" .mis true .nm}}{{if .ns}}T{{and -3 .si}}{{else}}F{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .f}}", "map[1:%!o(string=a) 2:%!o(string=b) 3:%!o(string=c)] %!f(bool=true) map[] F<2.5>")
  vec(dj, "{{and 1i -3}}{{if .obj.missing}}T{{printf \"%.2s \" 1}}{{else}}F{{end}}", "-3F")
