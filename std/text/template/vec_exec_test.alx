test "exec vectors 25" {
  dj = vec_json()
  dt = vec_typed()
  vec(dt, "{{$v := .bs}}[{{$v}}]", "[[104 105]]")
  vec(dj, "{{.obj.y}}{{$v := .big}}[{{$v}}]{{range $i, $e := (index .nums 0)}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "<no value>[1e+21]|ERR|template: v:1:63: executing \"v\" at <0>: range can't iterate over 3")
  vec(dt, "{{.ss}}{{- \" trim \" -}}{{eq .nest.list .nest.m.k .ss}}", "[x y] trim |ERR|template: v:1:25: executing \"v\" at <eq .nest.list .nest.m.k .ss>: error calling eq: non-comparable type [%!s(int=7) %!s(int=8)]: []int")
  vec(dj, "{{not 1i}}{{0}}", "false0")
  vec(dt, "{{println .st.B (index .mis 2)}}{{printf \"%U \" 1i}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .e}}", "bee b\n%!U(complex128=(0+1i)) <>")
  vec(dj, "{{$v := .name}}[{{$v}}]", "[Ann]")
  vec(dt, "{{range $i, $e := 0}}{{$i}}={{$e}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <0>: can't use 0 to iterate over more than one variable")
  vec(dj, "x{{printf \"%*d \" 0}}", "x%!d(MISSING) ")
  vec(dt, "{{.nest.m.k}}{{- \" trim \" -}}", "[7 8] trim ")
  vec(dj, "{{print $ -3}}", "map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0] -3")
  vec(dt, "{{le .msi.two \"str\"}}{{or .ss nil}}{{index .st.C .st.A}}", "|ERR|template: v:1:2: executing \"v\" at <le .msi.two \"str\">: error calling le: incompatible types for comparison: int and string")
