  vec(dt, "{{index .i8 .i8}}{{printf \"%05d %.0f \" -3 .f32}}", "|ERR|template: v:1:2: executing \"v\" at <index .i8 .i8>: error calling index: can't index item of type int8")
  vec(dj, "{{ne 0x1F .uni}}{{printf \"%o %.0f \" .names (printf \"%03d\" 7)}}", "|ERR|template: v:1:2: executing \"v\" at <ne 0x1F .uni>: error calling ne: incompatible types for comparison: int and string")
