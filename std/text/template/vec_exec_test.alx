  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" nil}}", "|ERR|template: v:1:45: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "{{0x1F | not}}", "false")
  vec(dj, "{{index .flag}}{{printf \"%\#o %x %\#v \" .tags .tiny .pi}}", "true[%!o(string=a) %!o(string=b) %!o(string=c)] 0x1.421f5f40d8376p-23 3.14159 ")
  vec(dt, "{{range $i, $e := .neg}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{eq .nest.list .s}}{{printf \"%+v \" .mis}}", "|ERR|template: v:1:18: executing \"v\" at <.neg>: can't use -17 to iterate over more than one variable")
