  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (slice .tags 1)}}", "<[b c]>")
  vec(dt, "{{printf \"%s % x \" 0x1F .nest}}{{printf \"%10s| %e %\#v \" 1 .ns \"str\"}}{{slice .nest.m.k 2}}", "%!s(int=31) map[6c 69 73 74:[ 1 74 77 6f  0x1.8p+01 <nil> %!x(bool=true)] 6d:map[6b:[ 7  8]]] %!s(int=         1)| [] \"str\" []")
  vec(dj, " - {{with .obj}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 1}}>{{else}}E{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "{{/* c */}}{{if .nest.m.k}}T{{$v := (len .si)}}[{{$v}}]{{else}}F{{end}}", "T[3]")
  vec(dj, "{{.pi}}{{(index .nums 0)}}{{with $}}<{{or .age (index .tags 1)}}>{{else}}E{{end}}", "3.141593<30>")
  vec(dt, "{{index .si .neg}}{{$v := .f}}[{{$v}}]", "|ERR|template: v:1:2: executing \"v\" at <index .si .neg>: error calling index: index out of range: -17")
  vec(dj, "{{with $}}< - >{{else}}E{{end}}{{slice (len .tags) 2}}{{not \"\"}}", "< - >|ERR|template: v:1:33: executing \"v\" at <slice (len .tags) 2>: error calling slice: can't slice item of type int")
  vec(dt, "{{range $i, $e := .c}}{{$i}}={{.}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <.c>: range can't iterate over (1.5-2i)")
  vec(dj, "{{slice .names 1}}{{printf \"%t \" (index .tags 1)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj.missing}}", "|ERR|template: v:1:2: executing \"v\" at <slice .names 1>: error calling slice: can't slice item of type map[string]interface {}")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .i8}}", "<-7>")
  vec(dj, "{{if nil}}T{{.empty}}{{else}}F{{end}}", "|ERR|template: v:1:5: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "{{range $i, $e := .s}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{not .u16}}", "|ERR|template: v:1:18: executing \"v\" at <.s>: range can't iterate over go & <alx>")
  vec(dj, "{{gt .zero (slice .tags 1)}}", "|ERR|template: v:1:2: executing \"v\" at <gt .zero (slice .tags 1)>: error calling gt: invalid type for comparison")
  vec(dt, "{{$v := .si}}[{{$v}}]{{$v := (index .sts 0)}}[{{$v}}]text ", "[[5 10 15]][{2  []}]text ")
  vec(dj, "{{le .names.a .names}}{{with .big}}<{{printf \"%5.2f %O \" 1i .}}>{{else}}E{{end}}{{0x1F | eq 1}}", "|ERR|template: v:1:2: executing \"v\" at <le .names.a .names>: error calling le: invalid type for comparison")
  vec(dt, "{{printf \"%-10q| \" .ns}}{{$v := .np}}[{{$v}}]{{eq nil .ss}}", "[]| [<nil>]false")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"str\"}}{{len .name}}", "<str>3")
  vec(dt, "{{1i}}{{if .mfb}}T{{or .nest.m.k .u16}}{{else}}F{{end}}{{.e | html}}", "(0+1i)T[7 8]")
  vec(dj, "{{/* c */}}", "")
  vec(dt, "{{range $i, $e := .nm}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}{{printf \"%\#U % d %U \" .missing 1 .st.A}}", "none%!U(<nil>)  1 U+0001 ")
  vec(dj, "{{(len .tags) | printf \"%q\"}}{{false}}", "'\\x03'false")
  vec(dt, "{{not .st}}{{$v := \"str\"}}[{{$v}}]{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .f}}", "false[str]<2.5>")
  vec(dj, "{{and .empty .name}}{{range $i, $e := .nums}}{{$i}}={{continue}};{{else}}none{{end}}", "[]0=1=2=")
  vec(dt, "{{true}}{{(index .sts 0)}}{{range $i, $e := nil}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "true{2  []}|ERR|template: v:1:44: executing \"v\" at <nil>: nil is not a command")
  vec(dj, "{{printf \"%o %\#o \" .names .obj.z}}{{printf \"%\#o %v %t \" .flag .tags $}}{{range $i, $e := .names.a}}{{$i}}={{continue}};{{else}}none{{end}}", "map[%!o(string=a):%!o(string=A) %!o(string=b):%!o(string=B) %!o(string=c):%!o(string=)] [%!o(float64=1.00000) %!o(float64=2.00000) map[%!o(string=k):%!o(string=v)]] %!o(bool=true) [a b c] map[%!t(string=age):%!t(float64=30) %!t(string=big):%!t(float64=1e+21) %!t(string=empty):[] %!t(string=flag):true %!t(string=name):%!t(string=Ann) %!t(string=names):map[%!t(string=a):%!t(string=A) %!t(string=b):%!t(string=B) %!t(string=c):%!t(string=)] %!t(string=neg):%!t(float64=-2) %!t(string=no):false %!t(string=nul):<nil> %!t(string=nums):[%!t(float64=3) %!t(float64=1) %!t(float64=2)] %!t(string=obj):map[%!t(string=w):%!t(string=wide) %!t(string=x):%!t(float64=1) %!t(string=y):<nil> %!t(string=z):[%!t(float64=1) %!t(float64=2) map[%!t(string=k):%!t(string=v)]]] %!t(string=pi):%!t(float64=3.14159) %!t(string=s):%!t(string=<b>&'\"x\"</b> =) %!t(string=tags):[%!t(string=a) %!t(string=b) %!t(string=c)] %!t(string=tiny):%!t(float64=1.5e-07) %!t(string=uni):%!t(string=héllo, 世界) %!t(string=zero):%!t(float64=0)] |ERR|template: v:1:95: executing \"v\" at <.names.a>: range can't iterate over A")
  vec(dt, "{{/* c */}}", "")
  vec(dj, "{{printf \"%+d %c \" \"\" 1}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (slice .tags 1)}}", "%!d(string=) \x01 <[b c]>")
  vec(dt, "{{println .msi.two 0x1F}}{{1i}}", "2 31\n(0+1i)")
  vec(dj, "{{eq 'c' $}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (.obj.z)}}", "|ERR|template: v:1:2: executing \"v\" at <eq 'c' $>: error calling eq: incompatible types for comparison: int and map[string]interface {}")
  vec(dt, "{{printf \"%T %-5d| %z \" .np .f (index .msi \"one\")}}", "*int %!d(float64=2.5  )| %!z(int=1) ")
  vec(dj, "{{range $i, $e := .names}}{{$i}}={{continue}};{{else}}none{{end}}{{.obj.x}}", "a=b=c=1")
  vec(dt, "{{.i | eq 1}}{{print 0 .r}}{{- \" trim \" -}}", "false0 120 trim ")
  vec(dj, "{{(index .tags 1)}}{{$v := 'c'}}[{{$v}}]{{range $i, $e := .nums}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "b[99]0=")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 1}}{{$v := .ns}}[{{$v}}]{{not nil}}", "<1>[[]]true")
  vec(dj, "{{nil | print}}{{with .nul}}<{{range $i, $e := .missing}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}>{{else}}E{{end}}{{and \"\" .s}}", "|ERR|template: v:1:2: executing \"v\" at <nil>: nil is not a command")
  vec(dt, "{{if 0}}T{{printf \"%10s| %p %! \" .ns .i true}}{{else}}F{{end}}{{(slice .s 1 4)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .missing}}", "Fo &<<no value>>")
  vec(dj, "{{lt .obj.y 'c'}}", "|ERR|template: v:1:2: executing \"v\" at <lt .obj.y 'c'>: error calling lt: invalid type for comparison")
  vec(dt, "{{.s}}", "go & <alx>")
  vec(dj, "{{range $i, $e := .neg}}{{$i}}={{.}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <.neg>: range can't iterate over -2")
  vec(dt, "{{and .r .nest.list}}{{.nest.m.k}}{{ne (len .si) .msi.four}}", "[1 two 3 <nil> true][7 8]true")
  vec(dj, "{{with .obj.z}}<{{ge .obj.w .}}>{{else}}E{{end}}", "<|ERR|template: v:1:25: executing \"v\" at <.obj.w>: can't evaluate field obj in type []interface {}")
  vec(dt, "{{range $i, $e := .ss}}{{$i}}={{continue}};{{else}}none{{end}}", "0=1=")
  vec(dj, "{{printf \"%t %f \" (len .tags) .empty}}", "%!t(int=3) [] ")
  vec(dt, "{{slice .nm 1}}{{js . .r}}{{.st.A | not}}", "|ERR|template: v:1:2: executing \"v\" at <slice .nm 1>: error calling slice: can't slice item of type map[string]int")
}

test "exec vectors 3" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (printf \"%03d\" 7)}}{{with .obj.x}}<{{printf \"%q %+d \" 1i 1e3}}>{{else}}E{{end}}", "<007><%!q(complex128=(0+1i)) %!d(float64=+1000) >")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .st.B}}", "<bee>")
  vec(dj, "{{not (index .tags 1)}}{{index .obj.w}}", "falsewide")
  vec(dt, "{{print .e .missing}}{{le 1i .u64}}", "<nil>|ERR|template: v:1:23: executing \"v\" at <le 1i .u64>: error calling le: incompatible types for comparison: complex128 and uint64")
  vec(dj, "{{with (len .tags)}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" nil}}>{{else}}E{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "{{with .f}}<{{println true .bs}}>{{else}}E{{end}}", "<|ERR|template: v:1:27: executing \"v\" at <.bs>: can't evaluate field bs in type float64")
  vec(dj, "{{with .obj.x}}<text >{{else}}E{{end}}", "<text >")
  vec(dt, "{{range $i, $e := .bs}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}", "0=")
  vec(dj, "{{$v := 1}}[{{$v}}]{{0}}", "[1]0")
  vec(dt, "{{and .nest.m.k (index .mis 2)}}{{true}}", "btrue")
  vec(dj, "{{$v := (.obj.z)}}[{{$v}}]", "[[1 2 map[k:v]]]")
  vec(dt, "{{0x1F}}", "31")
  vec(dj, "{{or 2.5 .s}}{{$v := -3}}[{{$v}}]{{not $}}", "2.5[-3]false")
  vec(dt, "{{and (index .mis 2) .ss}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0}}{{printf \"%s \" .mis}}", "[x y]<0>map[%!s(int=1):a %!s(int=2):b %!s(int=3):c] ")
  vec(dj, "{{if .empty}}T{{slice nil 1}}{{else}}F{{end}}", "F")
  vec(dt, "{{gt .sts (len .si)}}{{printf \"%t %10s| %g \" .st.A \"str\" .}}{{- \" trim \" -}}", "|ERR|template: v:1:2: executing \"v\" at <gt .sts (len .si)>: error calling gt: invalid type for comparison")
  vec(dj, "{{not 1i}}{{slice .pi 2}}", "false|ERR|template: v:1:12: executing \"v\" at <slice .pi 2>: error calling slice: can't slice item of type float64")
  vec(dt, "{{ge .c 1i}}", "|ERR|template: v:1:2: executing \"v\" at <ge .c 1i>: error calling ge: invalid type for comparison")
  vec(dj, " - {{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .missing}}", " - <<no value>>")
  vec(dt, "{{ne .u16 (index .msi \"one\")}}{{html .nest (slice .s 1 4)}}", "truemap[list:[1 two 3 &lt;nil&gt; true] m:map[k:[7 8]]]o &amp;")
  vec(dj, "{{ge 0 .names.a}}", "|ERR|template: v:1:2: executing \"v\" at <ge 0 .names.a>: error calling ge: incompatible types for comparison: int and string")
  vec(dt, "{{false}}{{(index .mis 2)}}{{-3 | not}}", "falsebfalse")
  vec(dj, "{{$v := .s}}[{{$v}}]text {{ne .obj.w 1}}", "[<b>&'\"x\"</b> =]text |ERR|template: v:1:27: executing \"v\" at <ne .obj.w 1>: error calling ne: incompatible types for comparison: string and int")
  vec(dt, "{{html .mfb (index .msi \"one\")}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" 0}}", "map[-1:false 2.5:true] 1<0>")
  vec(dj, "{{if (index .nums 0)}}Ttext {{else}}F{{end}}", "Ttext ")
  vec(dt, "{{printf \"%+v %G \" (slice .si 1 2) (slice .si 1 2)}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (index .sts 0)}}", "[10] [%!G(int=10)] <{2  []}>")
  vec(dj, "{{len .obj}}{{$v := $}}[{{$v}}]", "4[map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0]]")
  vec(dt, "{{.nest.m.k | printf \"%q\"}}", "['\\a' '\\b']")
  vec(dj, "{{js .obj.y 1}}{{html .empty .flag}}", "\\u003Cno value\\u003E1[] true")
  vec(dt, "x", "x")
  vec(dj, " - {{$v := .age}}[{{$v}}]", " - [30]")
  vec(dt, "{{.nest.m.k}}", "[7 8]")
  vec(dj, "{{len 1i}}{{printf \"%E % \" .obj.x .big}}", "|ERR|template: v:1:2: executing \"v\" at <len 1i>: error calling len: len of type complex128")
  vec(dt, "{{.nest}}{{eq .f32 .mis}}{{ge .u64 2.5}}", "map[list:[1 two 3 <nil> true] m:map[k:[7 8]]]|ERR|template: v:1:11: executing \"v\" at <eq .f32 .mis>: error calling eq: incompatible types for comparison: float32 and map[int]string")
  vec(dj, "{{$v := .obj.w}}[{{$v}}]{{$v := .tags}}[{{$v}}]", "[wide][[a b c]]")
  vec(dt, "{{$v := (slice .s 1 4)}}[{{$v}}]", "[o &]")
  vec(dj, "{{index .flag}}", "true")
  vec(dt, "{{print .ns .si}}", "[] [5 10 15]")
  vec(dj, "{{len .obj.z}}{{.big | print}}", "31e+21")
  vec(dt, "{{printf \"%f %z \" .r .c}}{{println \"str\" .c}}{{$v := .msi.four}}[{{$v}}]", "%!f(int32=120) %!z(complex128=(1.5-2i)) str (1.5-2i)\n[<no value>]")
  vec(dj, "{{with .obj.x}}<{{range $i, $e := .obj.z}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}>{{else}}E{{end}}{{$v := (slice .tags 1)}}[{{$v}}]", "<|ERR|template: v:1:38: executing \"v\" at <.obj.z>: can't evaluate field obj in type float64")
