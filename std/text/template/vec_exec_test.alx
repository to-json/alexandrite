test "exec vectors 28" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{lt (index .tags 1) .obj}}", "|ERR|template: v:1:2: executing \"v\" at <lt (index .tags 1) .obj>: error calling lt: invalid type for comparison")
  vec(dt, "{{.neg}}{{.np | printf \"%v\"}}", "-17<nil>")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .age}}{{.nul}}", "<30><no value>")
  vec(dt, "{{printf \"%\#v %O \" \"str\" true}}{{if 1}}T{{2.5}}{{else}}F{{end}}", "\"str\" %!O(bool=true) T2.5")
  vec(dj, "{{- \" trim \" -}}{{.obj}}{{not .neg}}", " trim map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]]false")
  vec(dt, "{{$v := \"str\"}}[{{$v}}]{{len .nest.m.k}}{{if 1}}T{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .u16}}{{else}}F{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dj, "{{slice 'c' 0}}{{printf \"%q %.2s \" .uni .s}}{{printf \"%G %c \" . $}}", "|ERR|template: v:1:2: executing \"v\" at <slice 'c' 0>: error calling slice: can't slice item of type int")
  vec(dt, "{{printf \"%E %g \" (index .msi \"one\") .si}}{{range $i, $e := -3}}{{$i}}={{.}};{{else}}none{{end}}{{not .msi.four}}", "%!E(int=1) [%!g(int=5) %!g(int=10) %!g(int=15)] |ERR|template: v:1:60: executing \"v\" at <-3>: can't use -3 to iterate over more than one variable")
  vec(dj, "x{{printf \"% d %p \" .s 0x1F}}", "x%!d(string=<b>&'\"x\"</b> =) %!p(int=31) ")
  vec(dt, "{{$v := (index .sts 0)}}[{{$v}}]{{$v := .f}}[{{$v}}]", "[{2  []}][2.5]")
  vec(dj, "{{lt .names.a (index .tags 1)}}", "true")
  vec(dt, "{{not true}}", "false")
  vec(dj, "{{.pi}}{{printf \"%x % %q \" .no true .obj.missing}}{{(len .tags) | len}}", "3.14159%!x(bool=false) %q %!(EXTRA bool=true, <nil>)|ERR|template: v:1:66: executing \"v\" at <len>: error calling len: len of type int")
  vec(dt, "{{printf \"%\#q %x %T \" (slice .s 1 4) .sts .st}}{{$v := .missing}}[{{$v}}]{{index 1i 0x1F}}", "`o &` [{2  []} {0 62 []}] template.vecSt [<no value>]|ERR|template: v:1:75: executing \"v\" at <index 1i 0x1F>: error calling index: can't index item of type complex128")
  vec(dj, "{{printf \"%e %v \" .names.a .neg}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .zero}}{{urlquery .empty .nul}}", "%!e(string=A) -2 <0>%5B%5D%3Cno+value%3E")
  vec(dt, "{{print .msi.two .s}}", "2go & <alx>")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj.x}}", "<1>")
  vec(dt, "{{.msi.two}}", "2")
  vec(dj, "{{$v := .obj.x}}[{{$v}}]{{if .pi}}T{{printf \"%x \" .s}}{{else}}F{{end}}", "[1]T3c623e26272278223c2f623e203d ")
  vec(dt, "{{if (index .nest.list 1)}}T{{le 'c' (index .msi \"one\")}}{{else}}F{{end}}{{printf \"% d \" .nest}}", "Tfalsemap[%!d(string=list):[ 1 %!d(string=two) %!d(float64= 3) <nil> %!d(bool=true)] %!d(string=m):map[%!d(string=k):[ 7  8]]] ")
  vec(dj, "{{$}}{{with .}}<{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .obj}}>{{else}}E{{end}}", "PARSE:template: v:1: unexpected <define> in command")
  vec(dt, "{{slice 1 1}}{{urlquery .i (len .si)}}", "|ERR|template: v:1:2: executing \"v\" at <slice 1 1>: error calling slice: can't slice item of type int")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" -3}}", "<-3>")
  vec(dt, "{{not .u16}}{{printf \"%05d %g \" .f32 -3}}{{println .msi.two .mfb}}", "false%!d(float32=000.1) %!g(int=-3) 2 map[-1:false 2.5:true]\n")
  vec(dj, "{{not (slice .tags 1)}}{{js 1 .tiny}}", "false1 1.5e-07")
  vec(dt, "{{lt .mfb \"str\"}}{{html .sts .msi.four}}", "|ERR|template: v:1:2: executing \"v\" at <lt .mfb \"str\">: error calling lt: invalid type for comparison")
  vec(dj, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .names}}{{not false}}", "<map[a:A b:B c:]>true")
  vec(dt, "{{range $i, $e := (index .sts 0)}}{{$i}}={{continue}};{{else}}none{{end}}", "|ERR|template: v:1:30: executing \"v\" at <0>: range can't iterate over {2  []}")
  vec(dj, "{{.zero}}", "0")
  vec(dt, "{{.bs}}{{js .np -3}}", "[104 105]\\u003Cnil\\u003E -3")
  vec(dj, "{{printf \"%c \" .obj.z}}{{if .name}}T{{.names}}{{else}}F{{end}}{{printf \"%x \" -3}}", "[%!c(float64=1) %!c(float64=2) map[%!c(string=k):%!c(string=v)]] Tmap[a:A b:B c:]-3 ")
  vec(dt, "{{printf \"%x %d %.0f \" (index .mis 2) .np (len .si)}}{{(index .mis 2) | len}}{{ge true .neg}}", "62 0 %!f(int=3) 1|ERR|template: v:1:79: executing \"v\" at <ge true .neg>: error calling ge: incompatible types for comparison: bool and int")
