  vec(dt, "{{$v := .s}}[{{$v}}]", "[go & <alx>]")
  vec(dj, "{{range $i, $e := .name}}{{$i}}={{continue}};{{else}}none{{end}}", "|ERR|template: v:1:18: executing \"v\" at <.name>: range can't iterate over Ann")
  vec(dt, "{{printf \"%! % x %\#o \" .st.C .t .st.C}}{{eq .neg -3}}", "[%!!(int=4)] %!x(bool=true) [04] false")
  vec(dj, "{{.empty}}{{range $i, $e := 0}}{{$i}}={{if $i}}+{{end}}{{break}};{{else}}none{{end}}{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" \"\"}}", "[]|ERR|template: v:1:28: executing \"v\" at <0>: can't use 0 to iterate over more than one variable")
  vec(dt, "{{le .nest.list .st}}{{index .msi}}{{not .u16}}", "|ERR|template: v:1:2: executing \"v\" at <le .nest.list .st>: error calling le: invalid type for comparison")
  vec(dj, "{{printf \"%\#x %\#v \" .age .names}}{{not (index .nums 0)}}{{.zero | printf \"%v\"}}", "0x1.e000p+04 map[string]interface {}{\"a\":\"A\", \"b\":\"B\", \"c\":\"\"} false0")
  vec(dt, "{{.c}}", "(1.5-2i)")
  vec(dj, "{{js 1 .big}}", "1 1e+21")
