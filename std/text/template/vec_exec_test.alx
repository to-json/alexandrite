  vec(dt, "{{if (index .nest.list 1)}}T{{and .t .nest.list}}{{else}}F{{end}}{{with .si}}<{{and .missing .np}}>{{else}}E{{end}}{{printf \"%05d %6.2g %t \" .f .st.B 2.5}}", "T[1 two 3 <nil> true]<|ERR|template: v:1:84: executing \"v\" at <.missing>: can't evaluate field missing in type []int")
