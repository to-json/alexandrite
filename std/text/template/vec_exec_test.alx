}

test "exec vectors 18" {
  dj = vec_json()
  dt = vec_typed()
  vec(dj, "{{printf \"%p \" (index .tags 1)}}{{if 0x1F}}T{{eq .s \"\"}}{{else}}F{{end}}{{if .obj.z}}T{{index (index .tags 1) (index .tags 1)}}{{else}}F{{end}}", "%!p(string=b) TfalseT|ERR|template: v:1:88: executing \"v\" at <index (index .tags 1) (index .tags 1)>: error calling index: cannot index slice/array with type string")
  vec(dt, "{{$v := .c}}[{{$v}}]", "[(1.5-2i)]")
  vec(dj, "{{or .big 0x1F}}{{printf \"% d % %.2s \" .flag .obj.x .}}{{if .s}}T{{lt .age false}}{{else}}F{{end}}", "1e+21%!d(bool=true) %.2s %!(EXTRA float64=1, map[string]interface {}=map[age:30 big:1e+21 empty:[] flag:true name:Ann names:map[a:A b:B c:] neg:-2 no:false nul:<nil> nums:[3 1 2] obj:map[w:wide x:1 y:<nil> z:[1 2 map[k:v]]] pi:3.14159 s:<b>&'\"x\"</b> = tags:[a b c] tiny:1.5e-07 uni:héllo, 世界 zero:0])T|ERR|template: v:1:67: executing \"v\" at <lt .age false>: error calling lt: incompatible types for comparison: float64 and bool")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .neg}}", "<-17>")
  vec(dj, "{{.zero}}{{-3}}", "0-3")
  vec(dt, "{{print .msi.two .st}}", "2 {1 bee [4]}")
  vec(dj, "{{$v := 'c'}}[{{$v}}]x{{range $i, $e := .tags}}{{$i}}={{printf \"%v\" $e}};{{else}}none{{end}}", "[99]x0=a;1=b;2=c;")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" (slice .si 1 2)}}{{/* c */}}{{$v := (slice .si 1 2)}}[{{$v}}]", "<[10]>[[10]]")
  vec(dj, "{{. | not}}{{.names | print}}{{$v := .obj.missing}}[{{$v}}]", "falsemap[a:A b:B c:][<no value>]")
  vec(dt, "{{printf \"%-10q| \" .e}}{{with .f}}<{{.st.C}}>{{else}}E{{end}}", "\"\"        | <|ERR|template: v:1:40: executing \"v\" at <.st.C>: can't evaluate field st in type float64")
  vec(dj, "{{not .}}{{gt .uni (.obj.z)}}{{not .nul}}", "false|ERR|template: v:1:11: executing \"v\" at <gt .uni (.obj.z)>: error calling gt: invalid type for comparison")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .st.A}}x", "<1>x")
  vec(dj, "{{urlquery . .obj.y}}{{$v := (slice .tags 1)}}[{{$v}}]", "map%5Bage%3A30+big%3A1e%2B21+empty%3A%5B%5D+flag%3Atrue+name%3AAnn+names%3Amap%5Ba%3AA+b%3AB+c%3A%5D+neg%3A-2+no%3Afalse+nul%3A%3Cnil%3E+nums%3A%5B3+1+2%5D+obj%3Amap%5Bw%3Awide+x%3A1+y%3A%3Cnil%3E+z%3A%5B1+2+map%5Bk%3Av%5D%5D%5D+pi%3A3.14159+s%3A%3Cb%3E%26%27%22x%22%3C%2Fb%3E+%3D+tags%3A%5Ba+b+c%5D+tiny%3A1.5e-07+uni%3Ah%C3%A9llo%2C+%E4%B8%96%E7%95%8C+zero%3A0%5D%3Cno+value%3E[[b c]]")
  vec(dt, "{{true}}{{not -3}}", "truefalse")
  vec(dj, "{{printf \"%\#U \" .empty}}{{ge .tiny .obj.missing}}{{ne .neg -3}}", "[] |ERR|template: v:1:26: executing \"v\" at <ge .tiny .obj.missing>: error calling ge: invalid type for comparison")
  vec(dt, "{{define \"t1\"}}<{{.}}>{{end}}{{template \"t1\" .mfb}}{{not .i}}", "<map[-1:false 2.5:true]>false")
