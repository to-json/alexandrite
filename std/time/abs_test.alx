# Go's abs_test.go (InternalTests, run by TestInternal): the calendar arithmetic,
# against a day-by-day walk. Go's absDays/absYday split tests check the internal
# representation of its March-based absolute calendar; the calendar here is
# days_from_civil / civil_from_days (also March-based), checked the same way:
# a million consecutive days from 0000-03-01 give consecutive dates, and the
# year day of each.

def leap?(y: Int) -> Bool { y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) }

test "TestInternal/AbsDate (civil_from_days, year_day)" {
  ends = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  want_year = 0
  want_month = 3
  want_mday = 1
  want_yday = 31 + 29 + 1
  bad = 0
  day0 = days_from_civil(0, 3, 1)
  for k in 0...1000000 {
    days = day0 + k
    year, month, mday = civil_from_days(days)
    if year != want_year || month != want_month || mday != want_mday {
      assert false, "civil_from_days(#{days}) = #{year}-#{month}-#{mday}, want #{want_year}-#{want_month}-#{want_mday}"
      bad += 1
      break if bad >= 20
    }
    if k % 997 == 0 {
      t = Time.new(sec: (days + DAYS_UNIX_TO_YEAR1) * SEC_PER_DAY, loc: utc_loc(), zone: "UTC")
      assert_eq t.year_day, want_yday
    }
    want_mday += 1
    if want_mday == ends[want_month - 1] + 1 || (want_month == 2 && want_mday == 29 && !leap?(year)) {
      want_month += 1
      want_mday = 1
    }
    want_yday += 1
    if want_month == 13 {
      want_year += 1
      want_month = 1
      want_mday = 1
      want_yday = 1
    }
  }
}

test "TestInternal/DateToAbsDays (days_from_civil)" {
  want = days_from_civil(1, 1, 1)
  for year in 1...10000 {
    assert_eq days_from_civil(year, 1, 1), want
    want += leap?(year) ? 366 : 365
  }
}

test "TestInternal/DaysIn" {
  want = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  for year in 0..1600 {
    for m in 1..12 {
      w = want[m]
      w += 1 if m == 2 && leap?(year)
      assert_eq days_in_month(year - 800, m), w
    }
  }
}

test "TestInternal/DaysBefore" {
  i = 0
  for want in [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334, 365] {
    assert_eq days_before(i + 1), want
    i += 1
  }
}
