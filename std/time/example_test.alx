#![test(external)]
# Go's example_test.go. The local zone is US Pacific, as in Go's tests. Go's
# examples without an Output comment (they are compiled, not run: Duration,
# Since, After, Sleep, Tick, Month, NewTicker) run here with an output that
# doesn't depend on the clock, and shorter waits.
import "time"
import _ "time/tzdata"
import "strconv"
import "math"

example "ExampleDuration" {
  t0 = time.now()
  t1 = time.now()
  puts t1.sub(t0) >= time.duration(0)
} outputs "true\n"

def round_list -> [time.Duration] {
  [time.nanosecond, time.microsecond, time.millisecond, time.second, time.second * 2, time.minute, time.minute * 10, time.hour]
}

example "ExampleDuration_Round" {
  d = time.parse_duration("1h15m30.918273645s").unwrap
  for r in round_list() {
    puts sprintf("d.Round(%6s) = %s", r.to_s, d.round(r).to_s)
  }
} outputs <<~EOS
  d.Round(   1ns) = 1h15m30.918273645s
  d.Round(   1µs) = 1h15m30.918274s
  d.Round(   1ms) = 1h15m30.918s
  d.Round(    1s) = 1h15m31s
  d.Round(    2s) = 1h15m30s
  d.Round(  1m0s) = 1h16m0s
  d.Round( 10m0s) = 1h20m0s
  d.Round(1h0m0s) = 1h0m0s
EOS

example "ExampleDuration_String" {
  puts time.hour + time.minute * 2 + time.millisecond * 300
  puts time.millisecond * 300
} outputs "1h2m0.3s\n300ms\n"

example "ExampleDuration_Truncate" {
  d = time.parse_duration("1h15m30.918273645s").unwrap
  for t in round_list() {
    puts sprintf("d.Truncate(%6s) = %s", t.to_s, d.truncate(t).to_s)
  }
} outputs <<~EOS
  d.Truncate(   1ns) = 1h15m30.918273645s
  d.Truncate(   1µs) = 1h15m30.918273s
  d.Truncate(   1ms) = 1h15m30.918s
  d.Truncate(    1s) = 1h15m30s
  d.Truncate(    2s) = 1h15m30s
  d.Truncate(  1m0s) = 1h15m0s
  d.Truncate( 10m0s) = 1h10m0s
  d.Truncate(1h0m0s) = 1h0m0s
EOS

example "ExampleParseDuration" {
  hours = time.parse_duration("10h").unwrap
  complex = time.parse_duration("1h10m10s").unwrap
  micro = time.parse_duration("1µs").unwrap
  micro2 = time.parse_duration("1us").unwrap
  puts hours
  puts complex
  puts sprintf("There are %.0f seconds in %s.", complex.seconds, complex.to_s)
  puts "There are #{micro.nanoseconds} nanoseconds in #{micro}."
  puts sprintf("There are %6.2e seconds in %s.", micro2.seconds, micro2.to_s)
} outputs <<~EOS
  10h0m0s
  1h10m10s
  There are 4210 seconds in 1h10m10s.
  There are 1000 nanoseconds in 1µs.
  There are 1.00e-06 seconds in 1µs.
EOS

example "ExampleSince" {
  start = time.now()
  elapsed = time.since(start)
  puts elapsed < time.second
} outputs "true\n"

example "ExampleUntil" {
  future = time.now().add(time.second * 5)
  d = time.until(future)
  puts sprintf("Duration until future time: %.0f seconds", math.ceil(d.seconds))
} outputs "Duration until future time: 5 seconds\n"

example "ExampleDuration_Abs" {
  pos = time.second * 5
  neg = time.second * -3
  min = time.duration(-9223372036854775808)
  puts "Absolute value of positive duration: #{pos.abs}"
  puts "Absolute value of negative duration: #{neg.abs}"
  puts "Absolute value of MinInt64 equal to MaxInt64: #{min.abs == time.duration(9223372036854775807)}"
} outputs <<~EOS
  Absolute value of positive duration: 5s
  Absolute value of negative duration: 3s
  Absolute value of MinInt64 equal to MaxInt64: true
EOS

example "ExampleDuration_Hours" {
  h = time.parse_duration("4h30m").unwrap
  print sprintf("I've got %.1f hours of work left.", h.hours)
} outputs "I've got 4.5 hours of work left."

example "ExampleDuration_Microseconds" {
  u = time.parse_duration("1s").unwrap
  puts "One second is #{u.microseconds} microseconds."
} outputs "One second is 1000000 microseconds.\n"

example "ExampleDuration_Milliseconds" {
  u = time.parse_duration("1s").unwrap
  puts "One second is #{u.milliseconds} milliseconds."
} outputs "One second is 1000 milliseconds.\n"

example "ExampleDuration_Minutes" {
  m = time.parse_duration("1h30m").unwrap
  print sprintf("The movie is %.0f minutes long.", m.minutes)
} outputs "The movie is 90 minutes long."

example "ExampleDuration_Nanoseconds" {
  u = time.parse_duration("1µs").unwrap
  puts "One microsecond is #{u.nanoseconds} nanoseconds."
} outputs "One microsecond is 1000 nanoseconds.\n"

example "ExampleDuration_Seconds" {
  m = time.parse_duration("1m30s").unwrap
  print sprintf("Take off in t-%.0f seconds.", m.seconds)
} outputs "Take off in t-90 seconds."

example "ExampleAfter" {
  c = Chan[Int].new(0)
  select {
    when m = c.recv => puts m
    when _t = time.after(time.millisecond * 10).recv => puts "timed out"
  }
} outputs "timed out\n"

example "ExampleSleep" {
  time.sleep(time.millisecond * 100)
  puts "slept"
} outputs "slept\n"

example "ExampleTick" {
  c = time.tick(time.millisecond * 5)
  for _i in 0...3 {
    next_t = c.recv.unwrap
    puts next_t.year > 2000
  }
} outputs "true\ntrue\ntrue\n"

example "ExampleMonth" {
  _, month, day = time.date(2009, 11, 10, 0, 0, 0, 0, time.utc()).date
  puts "Happy Go day!" if month == time.NOVEMBER && day == 10
} outputs "Happy Go day!\n"

example "ExampleDate" {
  time.force_us_pacific_for_testing()
  t = time.date(2009, time.NOVEMBER, 10, 23, 0, 0, 0, time.utc())
  puts "Go launched at #{t.local}"
} outputs "Go launched at 2009-11-10 15:00:00 -0800 PST\n"

example "ExampleNewTicker" {
  ticker = time.new_ticker(time.millisecond * 10)
  done = Chan[Bool].new(0)
  d2 = done
  spawn {
    time.sleep(time.millisecond * 55)
    d2 << true
  }
  ticks = 0
  loop {
    stop = false
    select {
      when _d = done.recv => stop = true
      when _t = ticker.c.recv => ticks += 1
    }
    break if stop
  }
  ticker.stop
  puts "Done!"
  puts ticks >= 1
} outputs "Done!\ntrue\n"

# Go's `do` helper of the Format examples.
def show(t: time.Time, name: Str, layout: Str, want: Str) {
  got = t.format(layout)
  if want != got {
    puts "error: for #{strconv.quote(layout)} got #{strconv.quote(got)}; expected #{strconv.quote(want)}"
    return
  }
  puts sprintf("%-16s %s gives %s", name, strconv.quote(layout), strconv.quote(got))
}

example "ExampleTime_Format" {
  time.force_us_pacific_for_testing()
  t = time.parse(time.UNIX_DATE, "Wed Feb 25 11:06:39 PST 2015").unwrap
  tz = time.load_location("Asia/Shanghai").unwrap
  puts "default format: #{t}"
  puts "Unix format: #{t.format(time.UNIX_DATE)}"
  puts "Same, in UTC: #{t.utc.format(time.UNIX_DATE)}"
  puts "in Shanghai with seconds: #{t.in_zone(tz).format("2006-01-02T15:04:05 -070000")}"
  puts "in Shanghai with colon seconds: #{t.in_zone(tz).format("2006-01-02T15:04:05 -07:00:00")}"
  print "\nFormats:\n\n"
  show(t, "Basic full date", "Mon Jan 2 15:04:05 MST 2006", "Wed Feb 25 11:06:39 PST 2015")
  show(t, "Basic short date", "2006/01/02", "2015/02/25")
  show(t, "AM/PM", "3PM==3pm==15h", "11AM==11am==11h")
  t = time.parse(time.UNIX_DATE, "Wed Feb 25 11:06:39.1234 PST 2015").unwrap
  show(t, "No fraction", time.UNIX_DATE, "Wed Feb 25 11:06:39 PST 2015")
  show(t, "0s for fraction", "15:04:05.00000", "11:06:39.12340")
  show(t, "9s for fraction", "15:04:05.99999999", "11:06:39.1234")
} outputs <<~EOS
  default format: 2015-02-25 11:06:39 -0800 PST
  Unix format: Wed Feb 25 11:06:39 PST 2015
  Same, in UTC: Wed Feb 25 19:06:39 UTC 2015
  in Shanghai with seconds: 2015-02-26T03:06:39 +080000
  in Shanghai with colon seconds: 2015-02-26T03:06:39 +08:00:00

  Formats:

  Basic full date  "Mon Jan 2 15:04:05 MST 2006" gives "Wed Feb 25 11:06:39 PST 2015"
  Basic short date "2006/01/02" gives "2015/02/25"
  AM/PM            "3PM==3pm==15h" gives "11AM==11am==11h"
  No fraction      "Mon Jan _2 15:04:05 MST 2006" gives "Wed Feb 25 11:06:39 PST 2015"
  0s for fraction  "15:04:05.00000" gives "11:06:39.12340"
  9s for fraction  "15:04:05.99999999" gives "11:06:39.1234"
EOS

example "ExampleTime_Format_pad" {
  time.force_us_pacific_for_testing()
  t = time.parse(time.UNIX_DATE, "Sat Mar 7 11:06:39 PST 2015").unwrap
  show(t, "Unix", time.UNIX_DATE, "Sat Mar  7 11:06:39 PST 2015")
  show(t, "No pad", "<2>", "<7>")
  show(t, "Spaces", "<_2>", "< 7>")
  show(t, "Zeros", "<02>", "<07>")
  show(t, "Suppressed pad", "04:05", "06:39")
} outputs <<~EOS
  Unix             "Mon Jan _2 15:04:05 MST 2006" gives "Sat Mar  7 11:06:39 PST 2015"
  No pad           "<2>" gives "<7>"
  Spaces           "<_2>" gives "< 7>"
  Zeros            "<02>" gives "<07>"
  Suppressed pad   "04:05" gives "06:39"
EOS

example "ExampleTime_GoString" {
  t = time.date(2009, time.NOVEMBER, 10, 23, 0, 0, 0, time.utc())
  puts t.go_string
  t = t.add(time.minute)
  puts t.go_string
  t = t.add_date(0, 1, 0)
  puts t.go_string
  t = time.parse("Jan 2, 2006 at 3:04pm (MST)", "Feb 3, 2013 at 7:54pm (UTC)").unwrap
  puts t.go_string
} outputs <<~EOS
  time.date(2009, time.NOVEMBER, 10, 23, 0, 0, 0, time.utc())
  time.date(2009, time.NOVEMBER, 10, 23, 1, 0, 0, time.utc())
  time.date(2009, time.DECEMBER, 10, 23, 1, 0, 0, time.utc())
  time.date(2013, time.FEBRUARY, 3, 19, 54, 0, 0, time.utc())
EOS

example "ExampleParse" {
  time.force_us_pacific_for_testing()
  long_form = "Jan 2, 2006 at 3:04pm (MST)"
  puts time.parse(long_form, "Feb 3, 2013 at 7:54pm (PST)").unwrap
  puts time.parse("2006-Jan-02", "2013-Feb-03").unwrap
  puts time.parse(time.RFC3339, "2006-01-02T15:04:05Z").unwrap
  puts time.parse(time.RFC3339, "2006-01-02T15:04:05+07:00").unwrap
  r = time.parse(time.RFC3339, time.RFC3339)
  puts "error #{r.err.unwrap.message}"
} outputs <<~EOS
  2013-02-03 19:54:00 -0800 PST
  2013-02-03 00:00:00 +0000 UTC
  2006-01-02 15:04:05 +0000 UTC
  2006-01-02 15:04:05 +0700 +0700
  error parsing time "2006-01-02T15:04:05Z07:00": extra text: "07:00"
EOS

example "ExampleParseInLocation" {
  loc = time.load_location("Europe/Berlin").unwrap
  puts time.parse_in_location("Jan 2, 2006 at 3:04pm (MST)", "Jul 9, 2012 at 5:02am (CEST)", loc).unwrap
  puts time.parse_in_location("2006-Jan-02", "2012-Jul-09", loc).unwrap
} outputs "2012-07-09 05:02:00 +0200 CEST\n2012-07-09 00:00:00 +0200 CEST\n"

example "ExampleUnix" {
  unix_time = time.date(2009, time.NOVEMBER, 10, 23, 0, 0, 0, time.utc())
  puts unix_time.unix
  puts time.unix(unix_time.unix, 0).utc
} outputs "1257894000\n2009-11-10 23:00:00 +0000 UTC\n"

example "ExampleUnixMicro" {
  umt = time.date(2009, time.NOVEMBER, 10, 23, 0, 0, 0, time.utc())
  puts umt.unix_micro
  puts time.unix_micro(umt.unix_micro).utc
} outputs "1257894000000000\n2009-11-10 23:00:00 +0000 UTC\n"

example "ExampleUnixMilli" {
  umt = time.date(2009, time.NOVEMBER, 10, 23, 0, 0, 0, time.utc())
  puts umt.unix_milli
  puts time.unix_milli(umt.unix_milli).utc
} outputs "1257894000000\n2009-11-10 23:00:00 +0000 UTC\n"

example "ExampleTime_Unix" {
  puts time.unix(1000000000, 0).utc
  puts time.unix(0, 1000000000000000000).utc
  puts time.unix(2000000000, -1000000000000000000).utc
  t = time.date(2001, time.SEPTEMBER, 9, 1, 46, 40, 0, time.utc())
  puts t.unix
  puts t.unix_nano
} outputs <<~EOS
  2001-09-09 01:46:40 +0000 UTC
  2001-09-09 01:46:40 +0000 UTC
  2001-09-09 01:46:40 +0000 UTC
  1000000000
  1000000000000000000
EOS

example "ExampleTime_Round" {
  t = time.date(0, 0, 0, 12, 15, 30, 918273645, time.utc())
  for d in round_list() {
    puts sprintf("t.Round(%6s) = %s", d.to_s, t.round(d).format("15:04:05.999999999"))
  }
} outputs <<~EOS
  t.Round(   1ns) = 12:15:30.918273645
  t.Round(   1µs) = 12:15:30.918274
  t.Round(   1ms) = 12:15:30.918
  t.Round(    1s) = 12:15:31
  t.Round(    2s) = 12:15:30
  t.Round(  1m0s) = 12:16:00
  t.Round( 10m0s) = 12:20:00
  t.Round(1h0m0s) = 12:00:00
EOS

example "ExampleTime_Truncate" {
  t = time.parse("2006 Jan 02 15:04:05", "2012 Dec 07 12:15:30.918273645").unwrap
  for d in round_list()[0...7] {
    puts sprintf("t.Truncate(%5s) = %s", d.to_s, t.truncate(d).format("15:04:05.999999999"))
  }
} outputs <<~EOS
  t.Truncate(  1ns) = 12:15:30.918273645
  t.Truncate(  1µs) = 12:15:30.918273
  t.Truncate(  1ms) = 12:15:30.918
  t.Truncate(   1s) = 12:15:30
  t.Truncate(   2s) = 12:15:30
  t.Truncate( 1m0s) = 12:15:00
  t.Truncate(10m0s) = 12:10:00
EOS

example "ExampleLoadLocation" {
  location = time.load_location("America/Los_Angeles").unwrap
  puts time.date(2018, 8, 30, 12, 0, 0, 0, time.utc()).in_zone(location)
} outputs "2018-08-30 05:00:00 -0700 PDT\n"

example "ExampleLocation" {
  beijing = time.fixed_zone("Beijing Time", (time.hour * 8).seconds.to_i)
  utc_t = time.date(2009, 1, 1, 12, 0, 0, 0, time.utc())
  bj_t = time.date(2009, 1, 1, 20, 0, 0, 0, beijing)
  puts utc_t.equal(bj_t)
} outputs "true\n"

example "ExampleTime_Add" {
  start = time.date(2009, 1, 1, 12, 0, 0, 0, time.utc())
  puts "start = #{start}"
  puts "start.Add(time.Second * 10) = #{start.add(time.second * 10)}"
  puts "start.Add(time.Minute * 10) = #{start.add(time.minute * 10)}"
  puts "start.Add(time.Hour * 10) = #{start.add(time.hour * 10)}"
  puts "start.Add(time.Hour * 24 * 10) = #{start.add(time.hour * 24 * 10)}"
} outputs <<~EOS
  start = 2009-01-01 12:00:00 +0000 UTC
  start.Add(time.Second * 10) = 2009-01-01 12:00:10 +0000 UTC
  start.Add(time.Minute * 10) = 2009-01-01 12:10:00 +0000 UTC
  start.Add(time.Hour * 10) = 2009-01-01 22:00:00 +0000 UTC
  start.Add(time.Hour * 24 * 10) = 2009-01-11 12:00:00 +0000 UTC
EOS

example "ExampleTime_AddDate" {
  start = time.date(2023, 3, 25, 12, 0, 0, 0, time.utc())
  one_day_later = start.add_date(0, 0, 1)
  day_duration = one_day_later.sub(start)
  zurich = time.load_location("Europe/Zurich").unwrap
  start_zurich = time.date(2023, 3, 25, 12, 0, 0, 0, zurich)
  one_day_later_zurich = start_zurich.add_date(0, 0, 1)
  puts "oneDayLater: start.AddDate(0, 0, 1) = #{one_day_later}"
  puts "oneMonthLater: start.AddDate(0, 1, 0) = #{start.add_date(0, 1, 0)}"
  puts "oneYearLater: start.AddDate(1, 0, 0) = #{start.add_date(1, 0, 0)}"
  puts "oneDayLaterZurich: startZurich.AddDate(0, 0, 1) = #{one_day_later_zurich}"
  puts "Day duration in UTC: #{day_duration} | Day duration in Zürich: #{one_day_later_zurich.sub(start_zurich)}"
} outputs <<~EOS
  oneDayLater: start.AddDate(0, 0, 1) = 2023-03-26 12:00:00 +0000 UTC
  oneMonthLater: start.AddDate(0, 1, 0) = 2023-04-25 12:00:00 +0000 UTC
  oneYearLater: start.AddDate(1, 0, 0) = 2024-03-25 12:00:00 +0000 UTC
  oneDayLaterZurich: startZurich.AddDate(0, 0, 1) = 2023-03-26 12:00:00 +0200 CEST
  Day duration in UTC: 24h0m0s | Day duration in Zürich: 23h0m0s
EOS

example "ExampleTime_After" {
  y2000 = time.date(2000, 1, 1, 0, 0, 0, 0, time.utc())
  y3000 = time.date(3000, 1, 1, 0, 0, 0, 0, time.utc())
  puts "year3000.After(year2000) = #{y3000.after(y2000)}"
  puts "year2000.After(year3000) = #{y2000.after(y3000)}"
} outputs "year3000.After(year2000) = true\nyear2000.After(year3000) = false\n"

example "ExampleTime_Before" {
  y2000 = time.date(2000, 1, 1, 0, 0, 0, 0, time.utc())
  y3000 = time.date(3000, 1, 1, 0, 0, 0, 0, time.utc())
  puts "year2000.Before(year3000) = #{y2000.before(y3000)}"
  puts "year3000.Before(year2000) = #{y3000.before(y2000)}"
} outputs "year2000.Before(year3000) = true\nyear3000.Before(year2000) = false\n"

example "ExampleTime_Date" {
  year, month, day = time.date(2000, 2, 1, 12, 30, 0, 0, time.utc()).date
  puts "year = #{year}"
  puts "month = #{time.month_name(month)}"
  puts "day = #{day}"
} outputs "year = 2000\nmonth = February\nday = 1\n"

example "ExampleTime_Day" {
  puts "day = #{time.date(2000, 2, 1, 12, 30, 0, 0, time.utc()).day}"
} outputs "day = 1\n"

# Go's == compares the fields (and is false here); alx's == on Times is Equal.
example "ExampleTime_Equal" {
  beijing = time.fixed_zone("Beijing Time", (time.hour * 8).seconds.to_i)
  d1 = time.date(2000, 2, 1, 12, 30, 0, 0, time.utc())
  d2 = time.date(2000, 2, 1, 20, 30, 0, 0, beijing)
  puts "datesEqualUsingFields = #{d1.zone_info == d2.zone_info && d1.equal(d2)}"
  puts "datesEqualUsingFunction = #{d1.equal(d2)}"
} outputs "datesEqualUsingFields = false\ndatesEqualUsingFunction = true\n"

example "ExampleTime_String" {
  puts "withNanoseconds = #{time.date(2000, 2, 1, 12, 13, 14, 15, time.utc()).to_s}"
  puts "withoutNanoseconds = #{time.date(2000, 2, 1, 12, 13, 14, 0, time.utc()).to_s}"
} outputs "withNanoseconds = 2000-02-01 12:13:14.000000015 +0000 UTC\nwithoutNanoseconds = 2000-02-01 12:13:14 +0000 UTC\n"

example "ExampleTime_Sub" {
  start = time.date(2000, 1, 1, 0, 0, 0, 0, time.utc())
  finish = time.date(2000, 1, 1, 12, 0, 0, 0, time.utc())
  puts "difference = #{finish.sub(start)}"
} outputs "difference = 12h0m0s\n"

example "ExampleTime_AppendBinary" {
  t = time.date(2025, 4, 1, 15, 30, 45, 123456789, time.utc())
  buffer: [Byte] = []
  buffer = t.append_binary(buffer).unwrap
  parse_time = time.Time.new()
  parse_time.unmarshal_binary!(buffer).unwrap
  puts "t: #{t}"
  puts "parseTime: #{parse_time}"
  puts "equal: #{parse_time.equal(t)}"
} outputs <<~EOS
  t: 2025-04-01 15:30:45.123456789 +0000 UTC
  parseTime: 2025-04-01 15:30:45.123456789 +0000 UTC
  equal: true
EOS

example "ExampleTime_AppendFormat" {
  t = time.date(2017, time.NOVEMBER, 4, 11, 0, 0, 0, time.utc())
  text = t.append_format("Time: ".bytes, time.KITCHEN)
  puts Str.from_bytes(text)
} outputs "Time: 11:00AM\n"

example "ExampleTime_AppendText" {
  t = time.date(2025, 4, 1, 15, 30, 45, 123456789, time.utc())
  buffer = t.append_text("t: ".bytes).unwrap
  puts Str.from_bytes(buffer)
} outputs "t: 2025-04-01T15:30:45.123456789Z\n"

example "ExampleFixedZone" {
  loc = time.fixed_zone("UTC-8", -8 * 60 * 60)
  t = time.date(2009, time.NOVEMBER, 10, 23, 0, 0, 0, loc)
  puts "The time is: #{t.format(time.RFC822)}"
} outputs "The time is: 10 Nov 09 23:00 UTC-8\n"
