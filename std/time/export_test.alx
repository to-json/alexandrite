# Go's export_test.go and internal_test.go: hooks into the package's internals
# for the external tests (format_test.alx, time_test.alx, ...).

# Go's ForceUSPacificForTesting: the local zone becomes America/Los_Angeles,
# named "Local" (the external tests import time/tzdata, so it loads without a
# system database).
pub def force_us_pacific_for_testing {
  set_local(rename(load_location("America/Los_Angeles").unwrap, "Local"))
}

# Go's DisablePlatformSources: until the returned undo is called, load_location
# reads only $ZONEINFO and the embedded database.
pub def disable_platform_sources -> () -> Unit {
  PLATFORM_SOURCES_OFF.store(true)
  ->() { PLATFORM_SOURCES_OFF.store(false) }
}

# Go's ResetZoneinfoForTesting / ZoneinfoForTesting.
pub def reset_zoneinfo_for_testing { ZONEINFO_ENV.lock { |z| z = none } }
pub def zoneinfo_for_testing -> Str? { ZONEINFO_ENV.lock { |z| z } }

# Go's ErrLocation (errLocation's message).
pub def err_location_message -> Str { LocationError.BadName.message }

# Go's LoadFromEmbeddedTZData: the registered loader's file as a string.
pub def load_from_embedded_tzdata(zone: Str) -> ~Str {
  fail "no embedded tzdata registered" if !EMBEDDED_SET.load
  f = EMBEDDED_TZDATA.load
  r = f.call(zone)
  if e = r.err { fail e }
  Str.from_bytes(r.unwrap)
}

# Go's NextStdChunk: (prefix, std, suffix).
pub def next_std_chunk(layout: Str) -> (Str, Int, Str) {
  p, std, e = next_chunk(layout, 0)
  return layout[0...p], std, layout[e...layout.size]
}

# Go's StdChunkNames: the layout element of a next_std_chunk code.
pub def std_chunk_name(std: Int) -> Str {
  code = std & 255
  n = (std >> 8) & 255
  sep = (std >> 16) == 1 ? "," : "."
  case code {
    0 => ""
    C_LONG_MONTH => "January"
    C_MONTH => "Jan"
    C_NUM_MONTH => "1"
    C_ZERO_MONTH => "01"
    C_LONG_WEEKDAY => "Monday"
    C_WEEKDAY => "Mon"
    C_DAY => "2"
    C_UNDER_DAY => "_2"
    C_ZERO_DAY => "02"
    C_UNDER_YEARDAY => "__2"
    C_ZERO_YEARDAY => "002"
    C_HOUR => "15"
    C_HOUR12 => "3"
    C_ZERO_HOUR12 => "03"
    C_MINUTE => "4"
    C_ZERO_MINUTE => "04"
    C_SECOND => "5"
    C_ZERO_SECOND => "05"
    C_LONG_YEAR => "2006"
    C_YEAR => "06"
    C_PM => "PM"
    C_LOWER_PM => "pm"
    C_TZ => "MST"
    C_ISO_TZ => "Z0700"
    C_ISO_SECONDS_TZ => "Z070000"
    C_ISO_SHORT_TZ => "Z07"
    C_ISO_COLON_TZ => "Z07:00"
    C_ISO_COLON_SECONDS_TZ => "Z07:00:00"
    C_NUM_TZ => "-0700"
    C_NUM_SECONDS_TZ => "-070000"
    C_NUM_SHORT_TZ => "-07"
    C_NUM_COLON_TZ => "-07:00"
    C_NUM_COLON_SECONDS_TZ => "-07:00:00"
    C_FRAC0 => sep + "0" * n
    C_FRAC9 => sep + "9" * n
    _ => "?"
  }
}

# Go's ParseTimeZone: the length of the zone name at the start of v, and ok.
pub def parse_time_zone(v: Str) -> (Int, Bool) {
  n = parse_zone_name(v)
  return n, n > 0
}

# Go's AppendInt (appendInt): x in decimal, zero-padded to width digits.
pub def append_int(b: [Byte], x: Int, width: Int) -> [Byte] {
  out = b
  for c in zpad(x, width).bytes { out << c }
  out
}

# Go's Quote, DaysIn.
pub def quote_for_testing(s: Str) -> Str { quote(s) }
pub def days_in(month: Int, year: Int) -> Int { days_in_month(year, month) }

# Go's GetMono / SetMono: the monotonic reading (0 if none).
pub def get_mono(t: Time) -> Int { t.has_mono ? t.mono : 0 }
pub def set_mono(t: Time, m: Int) -> Time {
  return t if !t.has_mono && (t.sec < MIN_WALL || t.sec > MAX_WALL)
  Time.new(sec: t.sec, nsec: t.nsec, mono: m, has_mono: true, off: t.off, zone: t.zone, loc: t.loc)
}

# Go's MinMonoTime, MaxMonoTime (UTC times with the extreme monotonic readings)
# and NotMonoNegativeTime (50 seconds after the earliest internal second).
pub def min_mono_time -> Time { Time.new(sec: MIN_WALL, mono: MIN_INT, has_mono: true, loc: utc_loc(), zone: "UTC") }
pub def max_mono_time -> Time { Time.new(sec: MIN_WALL, mono: MAX_INT, has_mono: true, loc: utc_loc(), zone: "UTC") }
pub def not_mono_negative_time -> Time { Time.new(sec: MIN_INT + 50, loc: utc_loc(), zone: "UTC") }

# Go's ReadFile (the zoneinfo reader's): the error message, or "ok".
pub def read_file_error(name: Str) -> Str {
  r = read_file(name)
  if e = r.err { return e.message }
  "ok"
}

# Go's UnixToInternal.
pub def unix_to_internal -> Int { UNIX_TO_YEAR1 }
