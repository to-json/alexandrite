#![test(external)]
# Go's format_test.go (package time_test). The local zone is US Pacific, as in
# Go's tests (force_us_pacific_for_testing, from export_test.alx); importing
# time/tzdata makes that and the zones below load without a system database.
#
# Not translated:
#   - FuzzFormatRFC3339, FuzzParseRFC3339: they compare Go's RFC 3339 fast paths
#     (appendFormatRFC3339, parseRFC3339) with the general Format/Parse; alx has
#     only the general ones. Their seed corpora run through format/parse in
#     "rfc3339 seeds" below.
#   - TestStd0xParseError's `err.(*ParseError)` type assertion: parse's error set
#     is ParseError by its signature; the fields are its methods.
import "time"
import _ "time/tzdata"
import "strings"

def pacific { time.force_us_pacific_for_testing() }

# A deterministic stand-in for testing/quick's random int64s (an LCG).
def mix(x: Int) -> Int { x *% 6364136223846793005 +% 1442695040888963407 }

def unmark(s: Str) -> Str { strings.replace_all(strings.replace_all(s, "(", ""), ")", "") }

def mark_chunks(format: Str) -> Str {
  out = ""
  s = format
  while s != "" {
    prefix, std, suffix = time.next_std_chunk(s)
    out += prefix
    out += "(" + time.std_chunk_name(std) + ")" if std > 0
    s = suffix
  }
  out
}

test "TestNextStdChunk" {
  marked = [
    "(2006)-(01)-(02)T(15):(04):(05)(Z07:00)",
    "(2006)-(01)-(02) (002) (15):(04):(05)",
    "(2006)-(01) (002) (15):(04):(05)",
    "(2006)-(002) (15):(04):(05)",
    "(2006)(002)(01) (15):(04):(05)",
    "(2006)(002)(04) (15):(04):(05)",
  ]
  for m in marked {
    assert_eq mark_chunks(unmark(m)), m
  }
}

test "TestRFC3339Conversion" {
  assert_eq time.date(2008, 9, 17, 20, 4, 26, 0, time.utc()).format(time.RFC3339), "2008-09-17T20:04:26Z"
  assert_eq time.date(1994, 9, 17, 20, 4, 26, 0, time.fixed_zone("EST", -18000)).format(time.RFC3339), "1994-09-17T20:04:26-05:00"
  assert_eq time.date(2000, 12, 26, 1, 15, 6, 0, time.fixed_zone("OTO", 15600)).format(time.RFC3339), "2000-12-26T01:15:06+04:20"
}

test "TestAppendInt" {
  tests = [
    (0, 0, "0"), (0, 1, "0"), (0, 2, "00"), (0, 3, "000"),
    (1, 0, "1"), (1, 1, "1"), (1, 2, "01"), (1, 3, "001"),
    (-1, 0, "-1"), (-1, 1, "-1"), (-1, 2, "-01"), (-1, 3, "-001"),
    (99, 2, "99"), (100, 2, "100"),
    (1, 4, "0001"), (12, 4, "0012"), (123, 4, "0123"), (1234, 4, "1234"), (12345, 4, "12345"),
    (1, 5, "00001"), (12, 5, "00012"), (123, 5, "00123"), (1234, 5, "01234"), (12345, 5, "12345"), (123456, 5, "123456"),
    (0, 9, "000000000"), (123, 9, "000000123"), (123456, 9, "000123456"), (123456789, 9, "123456789"),
  ]
  got: [Byte] = []
  for tt in tests {
    got = time.append_int(got[0...0], tt[0], tt[1])
    assert_eq Str.from_bytes(got), tt[2]
  }
}

def format_tests -> [(Str, Str, Str)] {
  [
    ("ANSIC", time.ANSIC, "Wed Feb  4 21:00:57 2009"),
    ("UnixDate", time.UNIX_DATE, "Wed Feb  4 21:00:57 PST 2009"),
    ("RubyDate", time.RUBY_DATE, "Wed Feb 04 21:00:57 -0800 2009"),
    ("RFC822", time.RFC822, "04 Feb 09 21:00 PST"),
    ("RFC850", time.RFC850, "Wednesday, 04-Feb-09 21:00:57 PST"),
    ("RFC1123", time.RFC1123, "Wed, 04 Feb 2009 21:00:57 PST"),
    ("RFC1123Z", time.RFC1123Z, "Wed, 04 Feb 2009 21:00:57 -0800"),
    ("RFC3339", time.RFC3339, "2009-02-04T21:00:57-08:00"),
    ("RFC3339Nano", time.RFC3339_NANO, "2009-02-04T21:00:57.0123456-08:00"),
    ("Kitchen", time.KITCHEN, "9:00PM"),
    ("am/pm", "3pm", "9pm"),
    ("AM/PM", "3PM", "9PM"),
    ("two-digit year", "06 01 02", "09 02 04"),
    ("Janet", "Hi Janet, the Month is January", "Hi Janet, the Month is February"),
    ("Stamp", time.STAMP, "Feb  4 21:00:57"),
    ("StampMilli", time.STAMP_MILLI, "Feb  4 21:00:57.012"),
    ("StampMicro", time.STAMP_MICRO, "Feb  4 21:00:57.012345"),
    ("StampNano", time.STAMP_NANO, "Feb  4 21:00:57.012345600"),
    ("DateTime", time.DATE_TIME, "2009-02-04 21:00:57"),
    ("DateOnly", time.DATE_ONLY, "2009-02-04"),
    ("TimeOnly", time.TIME_ONLY, "21:00:57"),
    ("YearDay", "Jan  2 002 __2 2", "Feb  4 035  35 4"),
    ("Year", "2006 6 06 _6 __6 ___6", "2009 6 09 _6 __6 ___6"),
    ("Month", "Jan January 1 01 _1", "Feb February 2 02 _2"),
    ("DayOfMonth", "2 02 _2 __2", "4 04  4  35"),
    ("DayOfWeek", "Mon Monday", "Wed Wednesday"),
    ("Hour", "15 3 03 _3", "21 9 09 _9"),
    ("Minute", "4 04 _4", "0 00 _0"),
    ("Second", "5 05 _5", "57 57 _57"),
  ]
}

test "TestFormat" {
  pacific()
  t = time.unix(0, 1233810057012345600)
  for tt in format_tests() {
    assert_eq t.format(tt[1]), tt[2]
  }
}

test "TestGoString" {
  pacific()
  assert_eq time.date(2009, 2, 5, 5, 0, 57, 12345600, time.utc()).go_string, "time.date(2009, time.FEBRUARY, 5, 5, 0, 57, 12345600, time.utc())"
  assert_eq time.date(2009, 2, 5, 5, 0, 57, 12345600, time.local()).go_string, "time.date(2009, time.FEBRUARY, 5, 5, 0, 57, 12345600, time.local())"
  assert_eq time.date(2009, 2, 5, 5, 0, 57, 12345600, time.fixed_zone("Europe/Berlin", 3 * 60 * 60)).go_string, "time.date(2009, time.FEBRUARY, 5, 5, 0, 57, 12345600, time.Location(\"Europe/Berlin\"))"
  assert_eq time.date(2009, 2, 5, 5, 0, 57, 12345600, time.fixed_zone("Non-ASCII character ⏰", 3 * 60 * 60)).go_string, "time.date(2009, time.FEBRUARY, 5, 5, 0, 57, 12345600, time.Location(\"Non-ASCII character \\xe2\\x8f\\xb0\"))"
}

test "TestFormatSingleDigits" {
  assert_eq time.date(2001, 2, 3, 4, 5, 6, 700000000, time.utc()).format("3:4:5"), "4:5:6"
}

def pad4(n: Int) -> Str { sprintf("%04d", n) }

test "TestFormatShortYear" {
  years = [
    -100001, -100000, -99999, -10001, -10000, -9999, -1001, -1000, -999, -101, -100, -99,
    -11, -10, -9, -1, 0, 1, 9, 10, 11, 99, 100, 101, 999, 1000, 1001, 9999, 10000, 10001,
    99999, 100000, 100001,
  ]
  for y in years {
    result = time.date(y, 1, 1, 0, 0, 0, 0, time.utc()).format("2006.01.02")
    want = y < 0 ? "-" + pad4(0 - y) + ".01.01" : pad4(y) + ".01.01"
    assert_eq result, want
  }
}

