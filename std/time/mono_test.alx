#![test(external)]
# Go's mono_test.go (package time_test): monotonic clock readings. get_mono and
# set_mono are export_test.alx's (Go's GetMono, SetMono).
import "time"

#[track_caller]
def yes(what: Str, t: time.Time) { assert time.get_mono(t) != 0, "#{what}: missing monotonic clock reading" }

#[track_caller]
def no(what: Str, t: time.Time) { assert time.get_mono(t) == 0, "#{what}: unexpected monotonic clock reading" }

test "TestHasMonotonicClock" {
  yes("after(1)", time.after(time.duration(1)).recv.unwrap)
  ticker = time.new_ticker(time.duration(1))
  yes("ticker", ticker.c.recv.unwrap)
  ticker.stop
  no("date", time.date(2009, 11, 23, 0, 0, 0, 0, time.utc()))
  tp = time.parse(time.UNIX_DATE, "Sat Mar  7 11:06:39 PST 2015").unwrap
  no("parse", tp)
  no("unix", time.unix(1486057371, 0))
  yes("now", time.now())
  tu = time.unix(1486057371, 0)
  tm = time.set_mono(tu, 123456)
  no("tu", tu)
  yes("tm", tm)
  one = time.duration(1)
  two = time.duration(2)
  no("tu.add(1)", tu.add(one))
  no("tu.in_zone(utc)", tu.in_zone(time.utc()))
  no("tu.add_date(1, 1, 1)", tu.add_date(1, 1, 1))
  no("tu.add_date(0, 0, 0)", tu.add_date(0, 0, 0))
  no("tu.local", tu.local)
  no("tu.utc", tu.utc)
  no("tu.round(2)", tu.round(two))
  no("tu.truncate(2)", tu.truncate(two))
  yes("tm.add(1)", tm.add(one))
  no("tm.add_date(1, 1, 1)", tm.add_date(1, 1, 1))
  no("tm.add_date(0, 0, 0)", tm.add_date(0, 0, 0))
  no("tm.in_zone(utc)", tm.in_zone(time.utc()))
  no("tm.local", tm.local)
  no("tm.utc", tm.utc)
  no("tm.round(2)", tm.round(two))
  no("tm.truncate(2)", tm.truncate(two))
}

test "TestMonotonicAdd" {
  tm = time.set_mono(time.unix(1486057371, 123456), 123456789012345)
  t2 = tm.add(time.duration(100000000))
  assert_eq t2.nanosecond, 100123456
  assert_eq time.get_mono(t2), 123456889012345
  t3 = tm.add(time.duration(-9000000000000000000))
  assert_eq t3.nanosecond, 123456
  assert_eq time.get_mono(t3), 0
  t4 = tm.add(time.duration(9000000000000000000))
  assert_eq t4.nanosecond, 123456
  assert_eq time.get_mono(t4), 0
  tn = time.now()
  tn1 = tn.add(time.hour)
  time.sleep(time.millisecond * 100)
  d = time.until(tn1)
  assert d >= time.minute * 59, "until(now + 1h) = #{d}"
  now = time.now()
  assert !now.after(tn1)
  assert tn1.after(now)
  assert !tn1.before(now)
  assert now.before(tn1)
  assert_eq now.compare(tn1), -1
  assert_eq tn1.compare(now), 1
}

test "TestMonotonicSub" {
  t1 = time.set_mono(time.unix(1483228799, 995000000), 123456789012345)
  t2 = time.set_mono(time.unix(1483228799, 5000000), 123456789012345 + 10000000)
  t3 = time.set_mono(time.unix(1483228799, 995000000), 123456789012345 + 1000000000)
  t1w = t1.add_date(0, 0, 0)
  t2w = t2.add_date(0, 0, 0)
  t3w = t3.add_date(0, 0, 0)
  assert_eq time.get_mono(t1w), 0
  assert_eq time.get_mono(t2w), 0
  assert_eq time.get_mono(t3w), 0
  ms = 1000000
  ts = [t1, t2, t3]
  tws = [t1w, t2w, t3w]
  # (x, y, d, dw) in milliseconds, and (x, y, c, cw), as Go's tables
  subs = [
    [0, 0, 0, 0], [0, 1, -10, 990], [0, 2, -1000, 0],
    [1, 0, 10, -990], [1, 1, 0, 0], [1, 2, -990, -990],
    [2, 0, 1000, 0], [2, 1, 990, 990], [2, 2, 0, 0],
  ]
  for s in subs {
    tx = ts[s[0]]
    txw = tws[s[0]]
    ty = ts[s[1]]
    tyw = tws[s[1]]
    assert_eq tx.sub(ty).nanoseconds, s[2] * ms
    assert_eq txw.sub(ty).nanoseconds, s[3] * ms
    assert_eq tx.sub(tyw).nanoseconds, s[3] * ms
    assert_eq txw.sub(tyw).nanoseconds, s[3] * ms
  }
  cmps = [
    [0, 0, 0, 0], [0, 1, -1, 1], [0, 2, -1, 0],
    [1, 0, 1, -1], [1, 1, 0, 0], [1, 2, -1, -1],
    [2, 0, 1, 0], [2, 1, 1, 1], [2, 2, 0, 0],
  ]
  for c in cmps {
    tx = ts[c[0]]
    txw = tws[c[0]]
    ty = ts[c[1]]
    tyw = tws[c[1]]
    cc = c[2]
    cw = c[3]
    assert_eq [tx.after(ty), txw.after(ty), tx.after(tyw), txw.after(tyw)], [cc > 0, cw > 0, cw > 0, cw > 0]
    assert_eq [tx.before(ty), txw.before(ty), tx.before(tyw), txw.before(tyw)], [cc < 0, cw < 0, cw < 0, cw < 0]
    assert_eq [tx.equal(ty), txw.equal(ty), tx.equal(tyw), txw.equal(tyw)], [cc == 0, cw == 0, cw == 0, cw == 0]
    assert_eq [tx.compare(ty), txw.compare(ty), tx.compare(tyw), txw.compare(tyw)], [cc, cw, cw, cw]
  }
}

test "TestMonotonicOverflow" {
  t1 = time.now().add(time.second * -30)
  d = time.until(t1)
  assert d >= time.second * -35 && d <= time.second * -30, "until(now - 30s) = #{d}"
  t1 = time.now().add(time.second * 30)
  d = time.until(t1)
  assert d >= time.second * 25 && d <= time.second * 30, "until(now + 30s) = #{d}"
  t0 = time.now()
  t1 = t0.add(time.duration(9223372036854775807))
  assert_eq time.get_mono(t1), 0
  t2 = t1.add(time.duration(-9223372036854775807))
  d = time.since(t2)
  assert d >= time.second * -10 && d <= time.second * 10, "since(now + max - max) = #{d}"
  t0 = time.now()
  t1 = t0.add(time.hour)
  time.sleep(time.millisecond * 100)
  t2 = time.now().add(time.second * -5)
  assert t1.after(t2)
  assert !t2.after(t1)
  assert !t1.before(t2)
  assert t2.before(t1)
  assert_eq t1.compare(t2), 1
  assert_eq t2.compare(t1), -1
}

test "TestMonotonicString" {
  tests = [
    (0, "m=+0.000000000"),
    (123456789, "m=+0.123456789"),
    (-123456789, "m=-0.123456789"),
    (123456789000, "m=+123.456789000"),
    (-123456789000, "m=-123.456789000"),
    (9000000000000000000, "m=+9000000000.000000000"),
    (-9000000000000000000, "m=-9000000000.000000000"),
    (-9223372036854775808, "m=-9223372036.854775808"),
  ]
  for tt in tests {
    s = time.set_mono(time.now(), tt[0]).to_s
    parts = s.split(" ")
    assert_eq parts[parts.size - 1], tt[1]
  }
}
