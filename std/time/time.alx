# Package time: Go's time, with alx idioms (S2). Milestone L2.
#
#   Go                                  alx
#   time.Duration (int64 ns)            Duration { ns: Int } with operators and methods
#   time.Second, 5 * time.Second        second(), second() * 5   (see below)
#   time.Duration(n)                    duration(n)
#   d.Seconds() / d.Milliseconds()      d.seconds -> Float / d.milliseconds -> Int (and the others)
#   d.Abs / d.Round / d.Truncate        d.abs / d.round(m) / d.truncate(m)
#   d.String(), ParseDuration(s)        d.to_s ("1h2m3.5s"), parse_duration(s) -> ~Duration<DurationError>
#   time.Time                           Time (a value; immutable, every method returns a new one)
#   time.Now(), time.Unix(s, ns)        now(), unix(sec, nsec), unix_milli(ms), unix_micro(us)
#   time.Date(y, m, d, h, mi, s, ns, loc)  date(y, m, d, h, mi, s, ns, loc)   (month is an Int 1..12)
#   t.Add / t.Sub / t.AddDate           t.add(d) / t.sub(u) -> Duration / t.add_date(y, m, d)
#   t.Equal / Before / After / Compare  t.equal(u) (also ==) / before / after / compare (also <=>)
#   t.Date / Clock / YearDay / ISOWeek  t.date -> (y, m, d) / t.clock / t.year_day / t.iso_week -> (y, w)
#   t.Format(layout) / time.Parse       t.format(layout) / parse(layout, value) -> ~Time<ParseError>
#   time.ParseInLocation               parse_in_location(layout, value, loc)
#   t.AppendFormat(b, layout)           t.append_format(b, layout) -> [Byte]
#   *ParseError (Layout, Value, ...)    ParseError, an error enum; e.layout, e.value, e.layout_elem, e.value_elem
#   t.MarshalText / UnmarshalText       t.marshal_text -> ~[Byte] / t.unmarshal_text!(b) -> ~Unit
#   t.MarshalJSON / UnmarshalJSON       t.marshal_json / t.unmarshal_json!(b)
#   t.MarshalBinary / UnmarshalBinary   t.marshal_binary / t.unmarshal_binary!(b)
#   t.GobEncode / GobDecode             t.gob_encode / t.gob_decode!(b)
#   t.AppendText / AppendBinary         t.append_text(b) / t.append_binary(b) -> ~[Byte]
#   t.String() / t.GoString()           t.to_s / t.go_string (in alx's spelling, see below)
#   time.Sleep / After / Tick           sleep(d) / after(d) -> Chan[Time] / tick(d) -> Chan[Time]
#   time.NewTimer / AfterFunc           new_timer(d) / after_func(d, ->() { ... }) -> Timer
#   timer.C / Stop / Reset              timer.c / timer.stop -> Bool / timer.reset(d) -> Bool
#   time.NewTicker, ticker.Stop/Reset   new_ticker(d) -> Ticker; ticker.c / stop / reset(d)
#   time.UTC / time.Local               utc() / local()
#   time.Local = loc                    set_local(loc)  (R11 package state)
#   time.FixedZone(name, off)           fixed_zone(name, off)
#   time.LoadLocation(name)             load_location(name) -> ~Location<LocationError>
#   time.LoadLocationFromTZData(n, b)   load_location_from_tzdata(name, data) -> ~Location<LocationError>
#   loc.String()                        loc.to_s / loc.string
#   t.In(loc) / t.Location()            t.in_zone(loc) / t.location
#   t.Zone() / t.IsDST() / t.ZoneBounds()  t.zone_info -> (Str, Int) / t.is_dst / t.zone_bounds -> (Time, Time)
#   Month.String / Weekday.String       month_name(m) / weekday_name(d), t.month_name / t.weekday_name
#   import _ "time/tzdata"              import _ "time/tzdata" (or tzdata.load_location(name))
#
# Differences from Go, and things worth knowing:
#   - Duration is a struct (not an integer), so constants cannot be Durations:
#     the units are zero-argument functions, `time.second * 5`, `time.minute * 2`.
#     `+ - * /` (the last two take an Int), `< <= > >=` and `==` work on Durations.
#   - Months are Ints 1..12 (JANUARY..DECEMBER are constants), weekdays are Ints
#     0..6 with Sunday 0 (SUNDAY..SATURDAY); month_name / weekday_name give the names
#     ("%!Month(13)" out of range, as Go's String).
#   - A Time is the instant (seconds since 0001-01-01 UTC and nanoseconds) plus an
#     optional monotonic reading plus a zone (offset and abbreviation). `==` on Times
#     is Go's Equal (Go's == compares the struct: the same instant in two zones is
#     not ==); `<`, `>` order them. With a monotonic reading on both sides, sub,
#     equal, before, after and compare use the readings, and utc, local, in_zone,
#     add_date, round and truncate strip it, as Go's do. The calendar fields come
#     from Go's absolute seconds (unsigned, from March 1 of -292277022399), so the
#     extremes of Int wrap exactly as Go's do. The zero Time is 0001-01-01 00:00:00 UTC.
#   - go_string prints alx: "time.date(2009, time.NOVEMBER, 10, 23, 0, 0, 0, time.utc())"
#     (time.local() for the local zone; other zones keep Go's time.Location("name")).
#     Error messages name alx's methods (S10): "Time.marshal_text: year outside of
#     range [0,9999]", "Time.unmarshal_binary: no data", "Time.marshal_json: ...".
#   - ParseError's elements (layout_elem, value_elem) are kept for "cannot parse"
#     errors; a range or "extra text" error keeps the layout and value and its text.
#     Messages quote as Go's time does (non-ASCII and control bytes as \xNN).
#   - Time has no reflection: encoding/json and encoding/gob don't find marshal_json
#     / gob_encode by themselves; call them (the bytes are Go's).
#   - Package state (R11): set_local is Go's assignable time.Local (until it is
#     called, the local zone is the C library's for the process, see below);
#     importing time/tzdata registers the embedded database as load_location's last
#     source, as Go's does (`import _ "time/tzdata"`).
#   - Locations (zoneinfo.alx): UTC, the local zone, fixed zones, and zones of the IANA
#     database. load_location is Go's: "" and "UTC" are UTC, "Local" the local zone,
#     names with ".." or a leading slash are refused, and other names are read from the
#     directory or uncompressed zip named by $ZONEINFO, then from the system's database
#     (/usr/share/zoneinfo, /usr/share/lib/zoneinfo, /usr/lib/locale/TZ, /etc/zoneinfo),
#     then from the embedded one when time/tzdata is imported. The TZif reader
#     (versions 1-3), the lookup of a zone (binary search over the transitions, Go's
#     rule for instants before the first one, the TZ-string rule after the last one)
#     and date()'s choice in gaps and overlaps are Go's, and give Go's results
#     (thousands of generated vectors in std/time/tzdata, every zone of the database).
#   - Go reads $ZONEINFO once; here every load_location reads it (setting it takes
#     effect), and a Location is an immutable value without Go's one-zone cache
#     (lookups are a binary search). Go's $GOROOT/lib/time/zoneinfo.zip fallback
#     doesn't exist (there is no GOROOT); the embedded database is time/tzdata.
#   - `local()` (without set_local) is the C library's zone for the process ($TZ),
#     asked per instant for the offset and abbreviation (Go reads $TZ or
#     /etc/localtime itself; the two agree on the zones). Its name is always "Local"
#     (Go names it after $TZ when TZ is set). What the C library doesn't give, the DST
#     flag and zone bounds (is_dst, zone_bounds) and the zone list Parse matches
#     abbreviations against, comes from loading the zone as Go's initLocal does ($TZ,
#     else /etc/localtime) on each call; Parse against Local matches an abbreviation
#     against the zones in effect within half a year of the time (Go also knows the
#     zone's historical abbreviations).
#   - Parsing a zone abbreviation (MST) that the location doesn't have, with no offset
#     in the layout, gives a fixed zone with that name and offset 0 (as Go does), except
#     that "UTC" and "GMT+n" forms are understood.
#   - The browser backend has no files: load_location, and is_dst / zone_bounds (which
#     can read the local zone's file), are refused there; conversions, formatting,
#     parsing, and zones made with load_location_from_tzdata (from tzdata.tzinfo) work.
#   - Timers: each arming of a Timer (new_timer, after_func, reset) or Ticker is a task
#     that sleeps until it is due; a stop or reset makes the sleeping task stale (it
#     ends when it wakes, without firing), so a timer reset to an hour keeps a sleeping
#     task for that hour. The channel semantics are Go 1.23's: stop and reset take a
#     value that was sent and not received (and then report the timer as pending), so
#     nothing stale is received after them; the channel has a one-value buffer (Go's
#     reports cap 0). after_func's function runs in a task of its own; the Timer's `c`
#     is unused. A Ticker drops ticks the receiver is too slow to take. tick(d) never
#     stops (use a Ticker); tick(d <= 0) is a channel that never receives (Go's nil).
#     A nil or zero Timer, whose Stop and Reset panic in Go, can't be made.
#     A Timer's shared state is Atomic[Int]s and channels (with a spin lock for the
#     few steps that move values in and out of the channel), not a Mutex, which
#     must not outlive the task that made it (port-issues #202).
#   - Time layouts are Go's reference time (Mon Jan 2 15:04:05 MST 2006), unchanged.
#
# Tests: Go's time_test.go, format_test.go, mono_test.go, sleep_test.go, tick_test.go,
# example_test.go and zoneinfo*_test.go are translated (time_test.alx, format_test.alx,
# ...; the external ones with `#![test(external)]` and the hooks of export_test.alx);
# each file lists what it leaves out and why. Generated vectors: vec_*_test.alx.

import "strings"

extern def alx_wall_ns -> Int
extern def alx_mono_ns -> Int
extern def alx_sleep_ns(ns: Int)
extern def alx_local_offset(unix_sec: Int) -> Int
extern def alx_local_zone(unix_sec: Int) -> Ptr

# ---------------------------------------------------------------- constants

NS_PER_SEC = 1000000000
SEC_PER_DAY = 86400
# Seconds from 0001-01-01 to 1970-01-01 (Go's unixToInternal).
UNIX_TO_YEAR1 = 62135596800
# Days from 0001-01-01 to 1970-01-01.
DAYS_UNIX_TO_YEAR1 = 719162
MAX_INT = 9223372036854775807
# Go's internalToAbsolute (seconds from year 1 to its absolute epoch, March 1 of
# -292277022399) and the days from that epoch to 1970-01-01.
INTERNAL_TO_ABS = 9223371966606163200
ABS_DAYS_TO_UNIX = 106751991073400
# The wall seconds a Time with a monotonic reading may have (Go's minWall,
# maxWall: 1885-01-01 and 2^33 - 1 seconds later).
MIN_WALL = 59453308800
MAX_WALL = 59453308800 + 8589934591
MIN_INT = -9223372036854775808

pub JANUARY = 1
pub FEBRUARY = 2
pub MARCH = 3
pub APRIL = 4
pub MAY = 5
pub JUNE = 6
pub JULY = 7
pub AUGUST = 8
pub SEPTEMBER = 9
pub OCTOBER = 10
pub NOVEMBER = 11
pub DECEMBER = 12

pub SUNDAY = 0
pub MONDAY = 1
pub TUESDAY = 2
pub WEDNESDAY = 3
pub THURSDAY = 4
pub FRIDAY = 5
pub SATURDAY = 6

# The layouts of Go's package time.
pub ANSIC = "Mon Jan _2 15:04:05 2006"
pub UNIX_DATE = "Mon Jan _2 15:04:05 MST 2006"
pub RUBY_DATE = "Mon Jan 02 15:04:05 -0700 2006"
pub RFC822 = "02 Jan 06 15:04 MST"
pub RFC822Z = "02 Jan 06 15:04 -0700"
pub RFC850 = "Monday, 02-Jan-06 15:04:05 MST"
pub RFC1123 = "Mon, 02 Jan 2006 15:04:05 MST"
pub RFC1123Z = "Mon, 02 Jan 2006 15:04:05 -0700"
pub RFC3339 = "2006-01-02T15:04:05Z07:00"
pub RFC3339_NANO = "2006-01-02T15:04:05.999999999Z07:00"
pub KITCHEN = "3:04PM"
pub STAMP = "Jan _2 15:04:05"
pub STAMP_MILLI = "Jan _2 15:04:05.000"
pub STAMP_MICRO = "Jan _2 15:04:05.000000"
pub STAMP_NANO = "Jan _2 15:04:05.000000000"
pub DATE_TIME = "2006-01-02 15:04:05"
pub DATE_ONLY = "2006-01-02"
pub TIME_ONLY = "15:04:05"

# ------------------------------------------------------------ small helpers

# Floor division and modulus (the sign of the result follows the divisor).
def fdiv(a: Int, b: Int) -> Int {
  q = a / b
  q -= 1 if (a % b != 0) && ((a < 0) != (b < 0))
  q
}

def fmod(a: Int, b: Int) -> Int {
  r = a % b
  r += b if r != 0 && ((r < 0) != (b < 0))
  r
}

# Go's time.quote, for error messages: s in double quotes, with `"` and `\`
# escaped and every byte that isn't printable ASCII as \xNN.
def quote(s: Str) -> Str {
  hex = "0123456789abcdef"
  out: [Byte] = [34]
  for c in s.bytes {
    if c >= 128 || c < 32 {
      out << 92
      out << 120
      out << hex[(c >> 4).to_i]
      out << hex[(c & 15).to_i]
    } else {
      out << 92 if c == 34 || c == 92
      out << c
    }
  }
  out << 34
  Str.from_bytes(out)
}

def zpad(n: Int, width: Int) -> Str {
  neg = n < 0
  s = (if neg { 0 - n } else { n }).to_s
  while s.size < width { s = "0" + s }
  neg ? "-" + s : s
}

# (a + b) mod m for 0 <= a, b < m, without overflow.
def addmod(a: Int, b: Int, m: Int) -> Int {
  return a - (m - b) if a >= m - b
  a + b
}

# (a * b) mod m for 0 <= a, b < m, without overflow.
def mulmod(a: Int, b: Int, m: Int) -> Int {
  r = 0
  x = a
  y = b
  while y > 0 {
    r = addmod(r, x, m) if (y & 1) == 1
    x = addmod(x, x, m)
    y = y >> 1
  }
  r
}

def is_leap(y: Int) -> Bool { (y % 4 == 0) && (y % 100 != 0 || y % 400 == 0) }

def days_in_month(y: Int, m: Int) -> Int {
  return 29 if m == 2 && is_leap(y)
  case m {
    2 => 28
    4 => 30
    6 => 30
    9 => 30
    11 => 30
    _ => 31
  }
}

# Days since 1970-01-01 of the civil date (y, m, d); m in 1..12, d any Int
# (it just adds days). Howard Hinnant's days_from_civil.
def days_from_civil(y0: Int, m: Int, d: Int) -> Int {
  y = y0
  y -= 1 if m <= 2
  era = fdiv(y, 400)
  yoe = y - era * 400
  mp = m > 2 ? m - 3 : m + 9
  doy = (153 * mp + 2) / 5
  doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468 + (d - 1)
}

# The civil date (year, month, day) of a day count since 1970-01-01.
def civil_from_days(z0: Int) -> (Int, Int, Int) {
  z = z0 + 719468
  era = fdiv(z, 146097)
  doe = z - era * 146097
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  y = yoe + era * 400
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  mp = (5 * doy + 2) / 153
  d = doy - (153 * mp + 2) / 5 + 1
  m = mp < 10 ? mp + 3 : mp - 9
  y += 1 if m <= 2
  return y, m, d
}

pub def month_name(m: Int) -> Str { month_str(m) }

def month_str(m: Int) -> Str {
  case m {
    1 => "January"
    2 => "February"
    3 => "March"
    4 => "April"
    5 => "May"
    6 => "June"
    7 => "July"
    8 => "August"
    9 => "September"
    10 => "October"
    11 => "November"
    12 => "December"
    _ => "%!Month(#{m})"
  }
}

pub def weekday_name(d: Int) -> Str { weekday_str(d) }

def weekday_str(d: Int) -> Str {
  case d {
    0 => "Sunday"
    1 => "Monday"
    2 => "Tuesday"
    3 => "Wednesday"
    4 => "Thursday"
    5 => "Friday"
    6 => "Saturday"
    _ => "%!Weekday(#{d})"
  }
}

# ----------------------------------------------------------------- Duration

# Why a duration string didn't parse (Go's messages).
pub error DurationError {
  Invalid(input: Str)
  MissingUnit(input: Str)
  UnknownUnit(unit: Str, input: Str)

  def message -> Str {
    case self {
      Invalid(s) => "time: invalid duration #{quote(s)}"
      MissingUnit(s) => "time: missing unit in duration #{quote(s)}"
      UnknownUnit(u, s) => "time: unknown unit #{quote(u)} in duration #{quote(s)}"
    }
  }
}

# "1.5" style: ip / 10^prec with the fractional digits, trailing zeros dropped.
def frac_str(v: Int, prec: Int) -> Str {
  p = 1
  (1..prec).each { p *= 10 }
  ip = v / p
  fr = v % p
  return ip.to_s if fr == 0
  digits = zpad(fr, prec)
  n = digits.size
  while n > 0 && digits[n - 1].to_i == 48 { n -= 1 }
  "#{ip}.#{digits[0...n]}"
}

# A length of time in nanoseconds (Go's time.Duration). The longest is about
# 292 years either way. Sums and products panic on overflow.
pub struct Duration {
  ns: Int

  pub def +(o: Duration) -> Duration { Duration.new(ns + o.ns) }
  pub def -(o: Duration) -> Duration { Duration.new(ns - o.ns) }
  pub def *(k: Int) -> Duration { Duration.new(ns * k) }
  pub def /(k: Int) -> Duration { Duration.new(ns / k) }
  pub def <=>(o: Duration) -> Int {
    return -1 if ns < o.ns
    return 1 if ns > o.ns
    0
  }

  pub def nanoseconds -> Int { ns }
  pub def microseconds -> Int { ns / 1000 }
  pub def milliseconds -> Int { ns / 1000000 }
  # Float seconds, minutes and hours (whole units plus the exact fraction).
  pub def seconds -> Float { (ns / NS_PER_SEC).to_f + (ns % NS_PER_SEC).to_f / 1e9 }
  pub def minutes -> Float { (ns / 60000000000).to_f + (ns % 60000000000).to_f / 6e10 }
  pub def hours -> Float { (ns / 3600000000000).to_f + (ns % 3600000000000).to_f / 3.6e12 }

  pub def abs -> Duration {
    return Duration.new(MAX_INT) if ns == MIN_INT
    ns < 0 ? Duration.new(0 - ns) : self
  }

  # Rounds toward zero to a multiple of m (d unchanged if m <= 0).
  pub def truncate(m: Duration) -> Duration {
    return self if m.ns <= 0
    Duration.new(ns - ns % m.ns)
  }

  # Rounds to the nearest multiple of m, halves away from zero; on overflow
  # the result saturates at the largest or smallest Duration (Go's Round).
  pub def round(m: Duration) -> Duration {
    return self if m.ns <= 0
    r = ns % m.ns
    if ns < 0 {
      r = 0 - r
      return Duration.new(ns + r) if r < m.ns - r
      gap = m.ns - r
      return Duration.new(MIN_INT) if ns < MIN_INT + gap
      return Duration.new(ns - gap)
    }
    return Duration.new(ns - r) if r < m.ns - r
    gap = m.ns - r
    return Duration.new(MAX_INT) if ns > MAX_INT - gap
    Duration.new(ns + gap)
  }

  # Go's format: "0s", "1.5ms", "72h3m0.5s", "-2m0s".
  pub def to_s -> Str {
    return "0s" if ns == 0
    return "-2562047h47m16.854775808s" if ns == MIN_INT
    neg = ns < 0
    u = neg ? 0 - ns : ns
    out = ""
    if u < NS_PER_SEC {
      if u < 1000 {
        out = "#{u}ns"
      } else if u < 1000000 {
        out = frac_str(u, 3) + "µs"
      } else {
        out = frac_str(u, 6) + "ms"
      }
    } else {
      secs = u / NS_PER_SEC
      sec_part = (secs % 60) * NS_PER_SEC + u % NS_PER_SEC
      out = frac_str(sec_part, 9) + "s"
      mins = secs / 60
      if mins > 0 {
        out = "#{mins % 60}m" + out
        hours = mins / 60
        out = "#{hours}h" + out if hours > 0
      }
    }
    neg ? "-" + out : out
  }
  pub def string -> Str { self.to_s }
}

pub def nanosecond -> Duration { Duration.new(1) }
pub def microsecond -> Duration { Duration.new(1000) }
pub def millisecond -> Duration { Duration.new(1000000) }
pub def second -> Duration { Duration.new(1000000000) }
pub def minute -> Duration { Duration.new(60000000000) }
pub def hour -> Duration { Duration.new(3600000000000) }

# A Duration of n nanoseconds.
pub def duration(ns: Int) -> Duration { Duration.new(ns) }

def digit?(s: Str, i: Int) -> Bool { i < s.size && s[i].to_i >= 48 && s[i].to_i <= 57 }

def unit_ns(u: Str) -> Int {
  case u {
    "ns" => 1
    "us" => 1000
    "µs" => 1000 # U+00B5
    "μs" => 1000 # U+03BC
    "ms" => 1000000
    "s" => 1000000000
    "m" => 60000000000
    "h" => 3600000000000
    _ => 0
  }
}

# Go's leadingInt: the digits at s[i...] as a U64 (none if past 1<<63) and
# where they end.
def leading_int(s: Str, i0: Int) -> (U64, Int)? {
  x: U64 = 0
  i = i0
  lim: U64 = 9223372036854775808
  while digit?(s, i) {
    return none if x > lim / 10
    x = x * 10 + (s[i].to_u64 - 48)
    return none if x > lim
    i += 1
  }
  (x, i)
}

# Go's leadingFraction: the digits at s[i...] (those that fit), the scale
# (10^digits kept) and where they end.
def leading_fraction(s: Str, i0: Int) -> (U64, Float, Int) {
  x: U64 = 0
  scale = 1.0
  i = i0
  overflow = false
  lim: U64 = 9223372036854775808
  while digit?(s, i) {
    if !overflow {
      if x > (lim - 1) / 10 {
        overflow = true
      } else {
        y = x * 10 + (s[i].to_u64 - 48)
        if y > lim {
          overflow = true
        } else {
          x = y
          scale *= 10.0
        }
      }
    }
    i += 1
  }
  (x, scale, i)
}

# Go's ParseDuration: a signed sequence of decimal numbers, each with a unit
# suffix: "300ms", "-1.5h", "2h45m". Units: ns us (or µs) ms s m h.
pub def parse_duration(orig: Str) -> ~Duration<DurationError> {
  s = orig
  d: U64 = 0
  neg = false
  lim: U64 = 9223372036854775808
  if s != "" && (s[0] == 45 || s[0] == 43) {
    neg = s[0] == 45
    s = s[1...s.size]
  }
  return Duration.new(0) if s == "0"
  fail DurationError.Invalid(orig) if s == ""
  while s != "" {
    fail DurationError.Invalid(orig) if !(s[0] == 46 || digit?(s, 0))
    v, i = leading_int(s, 0) || fail DurationError.Invalid(orig)
    pre = i != 0
    s = s[i...s.size]
    f: U64 = 0
    scale = 1.0
    post = false
    if s != "" && s[0] == 46 {
      f, scale, k = leading_fraction(s, 1)
      post = k != 1
      s = s[k...s.size]
    }
    fail DurationError.Invalid(orig) if !pre && !post
    n = 0
    while n < s.size && s[n] != 46 && !digit?(s, n) { n += 1 }
    fail DurationError.MissingUnit(orig) if n == 0
    u = s[0...n]
    s = s[n...s.size]
    un = unit_ns(u)
    fail DurationError.UnknownUnit(u, orig) if un == 0
    unit = un.to_u64
    fail DurationError.Invalid(orig) if v > lim / unit
    v *= unit
    if f > 0 {
      v += (f.to_f * (unit.to_f / scale)).to_u64
      fail DurationError.Invalid(orig) if v > lim
    }
    d += v
    fail DurationError.Invalid(orig) if d > lim
  }
  return Duration.new(0 -% d.as_i64.to_i) if neg
  fail DurationError.Invalid(orig) if d > lim - 1
  Duration.new(d.to_i)
}

# -------------------------------------------------------------- Locations
# (Location, load_location and the tz database are in zoneinfo.alx.)

pub def utc -> Location { utc_loc() }
pub def local -> Location { local_loc() }
def utc_loc -> Location { Location.new(name: "UTC", offset: 0, kind: 0) }
def system_local -> Location { Location.new(name: "Local", offset: 0, kind: 1) }

# Go's assignable `time.Local` (R11): set_local(l) makes l the zone of now(),
# unix(), t.local and Parse's local zone; set_local(saved local()) undoes it.
LOCAL_SET = Atomic.new(false)
LOCAL_LOC: Atomic[Location] = Atomic.new(system_local())

def local_loc -> Location {
  return LOCAL_LOC.load if LOCAL_SET.load
  system_local()
}

# Makes l the local zone (Go's `time.Local = l`). Until a set_local, local()
# is the process's zone ($TZ, as the C library reads it).
pub def set_local(l: Location) {
  if l.kind == 1 {
    LOCAL_SET.store(false)
  } else {
    LOCAL_LOC.store(l)
    LOCAL_SET.store(true)
  }
}

# A zone with a fixed offset (seconds east of UTC). An empty name prints the
# offset ("-0700") where Go would print the abbreviation.
pub def fixed_zone(name: Str, offset: Int) -> Location {
  Location.new(name: name, offset: offset, kind: 2)
}

# ---------------------------------------------------------------------- Time

# An instant with a zone. `sec` counts seconds since 0001-01-01 00:00:00 UTC,
# `nsec` is 0..999999999; `mono` (when `has_mono`) is a monotonic clock reading
# in nanoseconds, kept so that differences of two now() values ignore wall clock
# jumps; `off` and `zone` are the offset and abbreviation in effect;
# `loc` is the Location (its kind: 0 UTC, 1 Local, 2 fixed, 3 tz database).
pub struct Time {
  sec: Int
  nsec: Int
  mono: Int
  has_mono: Bool
  off: Int
  zone: Str
  loc: Location

  # seconds since the epoch in the zone's wall clock
  # Go's absolute seconds of the wall clock: since March 1 of the year
  # -292277022399, as a U64, so that the extremes of Int wrap as Go's do.
  def abs_sec -> U64 { (sec +% off +% INTERNAL_TO_ABS).as_u64 }
  # The wall clock's day (since 1970-01-01) and second of the day.
  def unix_days -> Int {
    spd: U64 = 86400
    (self.abs_sec / spd).to_i - ABS_DAYS_TO_UNIX
  }
  def sod -> Int {
    spd: U64 = 86400
    (self.abs_sec % spd).to_i
  }

  # (year, month, day) of the wall clock
  def civil -> (Int, Int, Int) {
    civil_from_days(self.unix_days)
  }

  pub def unix -> Int { sec -% UNIX_TO_YEAR1 }
  pub def unix_milli -> Int { (sec - UNIX_TO_YEAR1) * 1000 + nsec / 1000000 }
  pub def unix_micro -> Int { (sec - UNIX_TO_YEAR1) * 1000000 + nsec / 1000 }
  pub def unix_nano -> Int { (sec - UNIX_TO_YEAR1) * NS_PER_SEC + nsec }

  pub def year -> Int {
    y, _, _ = self.civil
    y
  }
  # 1..12
  pub def month -> Int {
    _, m, _ = self.civil
    m
  }
  pub def day -> Int {
    _, _, d = self.civil
    d
  }
  pub def date -> (Int, Int, Int) { self.civil }
  pub def hour -> Int { self.sod / 3600 }
  pub def minute -> Int { self.sod % 3600 / 60 }
  pub def second -> Int { self.sod % 60 }
  pub def clock -> (Int, Int, Int) { return self.hour, self.minute, self.second }
  pub def nanosecond -> Int { nsec }
  pub def month_name -> Str { month_str(self.month) }
  pub def weekday_name -> Str { weekday_str(self.weekday) }

  # 0 = Sunday .. 6 = Saturday.
  pub def weekday -> Int { fmod(self.unix_days + 4, 7) }

  # 1..366
  pub def year_day -> Int {
    y, _, _ = self.civil
    self.unix_days - days_from_civil(y, 1, 1) + 1
  }

  # ISO 8601 (year, week): the week containing the year's first Thursday is week 1.
  pub def iso_week -> (Int, Int) {
    days = self.unix_days
    wd = fmod(days + 3, 7) # Monday = 0
    thu = days - wd + 3
    y, _, _ = civil_from_days(thu)
    week = (thu - days_from_civil(y, 1, 1)) / 7 + 1
    return y, week
  }

  # Lays the time out as the Go reference-time `layout` ("2006-01-02 15:04", RFC3339...).
  pub def format(layout: Str) -> Str { format_time(self, layout) }

  # b with the time laid out as `layout` appended (Go's AppendFormat).
  pub def append_format(b: [Byte], layout: Str) -> [Byte] {
    out = b
    for c in format_time(self, layout).bytes { out << c }
    out
  }

  # RFC 3339 with the nanoseconds that aren't zero, or why it can't be:
  # the year must be in [0, 9999] and the zone's hours in [0, 23]
  # (Go's appendStrictRFC3339).
  def strict_rfc3339 -> Str? {
    s = self.format(RFC3339_NANO)
    return none if s.size < 5 || s[4] != 45 # the year must be 4 digits wide
    if s[s.size - 1] != 90 { # Z
      c = s[s.size - 6]
      h = (s[s.size - 5].to_i - 48) * 10 + (s[s.size - 4].to_i - 48)
      return none if (c >= 48 && c <= 57) || h >= 24
    }
    s
  }

  def strict_rfc3339_error -> Str {
    s = self.format(RFC3339_NANO)
    return "year outside of range [0,9999]" if s.size < 5 || s[4] != 45
    "timezone hour outside of range [0,23]"
  }

  # Go's MarshalText (encoding.TextMarshaler): RFC 3339 with the
  # nanoseconds that aren't zero; the year must be in [0, 9999].
  pub def marshal_text -> ~[Byte] {
    s = self.strict_rfc3339 || fail "Time.marshal_text: " + self.strict_rfc3339_error
    s.bytes
  }

  # b with marshal_text's bytes appended (Go's AppendText).
  pub def append_text(b: [Byte]) -> ~[Byte] {
    s = self.strict_rfc3339 || fail "Time.append_text: " + self.strict_rfc3339_error
    out = b
    for c in s.bytes { out << c }
    out
  }

  # Go's MarshalJSON: marshal_text's string in quotes.
  pub def marshal_json -> ~[Byte] {
    s = self.strict_rfc3339 || fail "Time.marshal_json: " + self.strict_rfc3339_error
    "\"#{s}\"".bytes
  }

  # Go's UnmarshalText (encoding.TextUnmarshaler): an RFC 3339 time.
  pub def unmarshal_text!(data: [Byte]) -> ~Unit {
    t = ~parse_strict_rfc3339(Str.from_bytes(data))
    self = t
    nil
  }

  # Go's UnmarshalJSON: an RFC 3339 time in quotes; `null` leaves the time as it is.
  pub def unmarshal_json!(data: [Byte]) -> ~Unit {
    s = Str.from_bytes(data)
    return nil if s == "null"
    if s.size < 2 || s[0] != 34 || s[s.size - 1] != 34 {
      fail "Time.unmarshal_json: input is not a JSON string"
    }
    t = ~parse_strict_rfc3339(s[1...s.size - 1])
    self = t
    nil
  }

  # Go's MarshalBinary: version 1 (2 if the offset has seconds), the seconds
  # since year 1 (8 bytes), the nanoseconds (4), the offset in minutes (2,
  # -1 for UTC), and in version 2 the offset's seconds (1), big-endian.
  pub def marshal_binary -> ~[Byte] {
    b: [Byte] = []
    ~self.append_binary(b)
  }

  # b with marshal_binary's bytes appended (Go's AppendBinary).
  pub def append_binary(b: [Byte]) -> ~[Byte] {
    offset_min = 0
    offset_sec = 0
    version = 1
    if loc.kind == 0 {
      offset_min = -1
    } else {
      offset = off
      if offset % 60 != 0 {
        version = 2
        offset_sec = offset % 60
      }
      offset /= 60
      fail "Time.marshal_binary: unexpected zone offset" if offset < -32768 || offset == -1 || offset > 32767
      offset_min = offset
    }
    out = b
    out << version.as_u8
    for k in 0...8 { out << (sec >> (56 - 8 * k)).as_u8 }
    for k in 0...4 { out << (nsec >> (24 - 8 * k)).as_u8 }
    out << (offset_min >> 8).as_u8
    out << offset_min.as_u8
    out << offset_sec.as_u8 if version == 2
    out
  }

  # Go's UnmarshalBinary: marshal_binary's bytes back. The zone is UTC, the
  # local zone if it has that offset then, or a nameless fixed zone.
  pub def unmarshal_binary!(data: [Byte]) -> ~Unit {
    fail "Time.unmarshal_binary: no data" if data.size == 0
    version = data[0].to_i
    fail "Time.unmarshal_binary: unsupported version" if version != 1 && version != 2
    want = version == 2 ? 16 : 15
    fail "Time.unmarshal_binary: invalid length" if data.size != want
    s = 0
    for k in 1...9 { s = (s << 8) | data[k].to_i }
    ns = 0
    for k in 9...13 { ns = (ns << 8) | data[k].to_i }
    ns = ns.as_i32.to_i
    offset = ((data[13].to_i << 8) | data[14].to_i).as_i16.to_i * 60
    offset += data[15].as_i8.to_i if version == 2
    t = Time.new(sec: s, nsec: ns, loc: utc_loc(), zone: "UTC")
    if offset != -60 {
      ll = local_loc()
      _, loff, _, _, _ = ll.lookup(s -% UNIX_TO_YEAR1)
      t = loff == offset ? t.in_zone(ll) : t.in_zone(fixed_zone("", offset))
    }
    self = t
    nil
  }

  # Go's GobEncode / GobDecode: marshal_binary / unmarshal_binary!.
  pub def gob_encode -> ~[Byte] { ~self.marshal_binary }
  pub def gob_decode!(data: [Byte]) -> ~Unit {
    ~self.unmarshal_binary!(data)
    nil
  }

  # Go's GoString, in alx's spelling: "time.date(2009, time.FEBRUARY, 5, 5, 0,
  # 57, 12345600, time.utc())"; time.local(), or time.Location("name") (Go's
  # text, quoted as Go's time does) for other zones.
  pub def go_string -> Str {
    y, mo, d = self.civil
    h, mi, s = self.clock
    out = "time.date(#{y}, time.#{strings.to_upper(month_str(mo))}, #{d}, #{h}, #{mi}, #{s}, #{nsec}, "
    l = self.location
    if l.kind == 0 {
      out += "time.utc()"
    } else if l.kind == 1 || (LOCAL_SET.load && l == LOCAL_LOC.load) {
      out += "time.local()"
    } else {
      out += "time.Location(#{quote(l.name)})"
    }
    out + ")"
  }

  pub def is_zero -> Bool { sec == 0 && nsec == 0 }

  # The same instant; the monotonic reading is kept.
  # The same instant in UTC, the local zone or loc (Go's UTC, Local, In); as
  # Go's, they strip the monotonic reading.
  pub def utc -> Time {
    Time.new(sec: sec, nsec: nsec, off: 0, zone: "UTC", loc: utc_loc())
  }
  pub def local -> Time { self.in_zone(local_loc()) }
  pub def in_zone(l: Location) -> Time { at_loc(sec, nsec, 0, false, l) }
  pub def location -> Location {
    return utc_loc() if loc.kind == 0
    loc
  }
  # The zone's abbreviation and offset in seconds east of UTC (Go's Zone).
  pub def zone_info -> (Str, Int) {
    return self.zone_name, off
  }
  def zone_name -> Str { loc.kind == 0 ? "UTC" : zone }

  # Whether daylight saving time is in effect (Go's IsDST).
  pub def is_dst -> Bool {
    _, _, _, _, d = loc.lookup_full(sec -% UNIX_TO_YEAR1)
    d
  }

  # The start and end of the zone in effect at t (Go's ZoneBounds): t is in
  # [start, end). A zone that began at the beginning of time has a zero start;
  # one that goes on forever a zero end. Both are in t's Location.
  pub def zone_bounds -> (Time, Time) {
    _, _, s, e, _ = loc.lookup_full(sec -% UNIX_TO_YEAR1)
    start = Time.new()
    finish = Time.new()
    start = at_loc(s +% UNIX_TO_YEAR1, 0, 0, false, loc) if s != MIN_INT
    finish = at_loc(e +% UNIX_TO_YEAR1, 0, 0, false, loc) if e != MAX_INT
    return start, finish
  }

  # Strips the monotonic reading (Go's t.Round(0)).
  pub def strip_mono -> Time {
    Time.new(sec: sec, nsec: nsec, mono: 0, has_mono: false, off: off, zone: zone, loc: loc)
  }

  pub def add(d: Duration) -> Time {
    ds = d.ns / NS_PER_SEC
    dn = nsec + d.ns % NS_PER_SEC
    if dn >= NS_PER_SEC {
      ds += 1
      dn -= NS_PER_SEC
    } else if dn < 0 {
      ds -= 1
      dn += NS_PER_SEC
    }
    # Go's addSec: the seconds saturate rather than overflow
    s = sec +% ds
    if (s > sec) != (ds > 0) {
      s = ds > 0 ? MAX_INT : 0 - MAX_INT
    }
    m = mono
    hm = has_mono
    # Go keeps a monotonic reading only with wall seconds in [1885, 2157]
    if hm && (s < MIN_WALL || s > MAX_WALL) {
      hm = false
      m = 0
    }
    if hm {
      if (d.ns > 0 && mono > MAX_INT - d.ns) || (d.ns < 0 && mono < MIN_INT - d.ns) {
        hm = false
        m = 0
      } else {
        m = mono + d.ns
      }
    }
    # the offset of the local zone and of tz database zones depends on the instant
    return at_loc(s, dn, m, hm, loc) if loc.kind == 1 || loc.kind == 3
    Time.new(sec: s, nsec: dn, mono: m, has_mono: hm, off: off, zone: zone, loc: loc)
  }

  # self - u, saturating at the longest Durations. With a monotonic reading on
  # both sides it is the monotonic difference.
  pub def sub(u: Time) -> Duration {
    if has_mono && u.has_mono {
      d = mono -% u.mono
      return Duration.new(MAX_INT) if d < 0 && mono > u.mono
      return Duration.new(MIN_INT) if d > 0 && mono < u.mono
      return Duration.new(d)
    }
    # Go's: the wrapped difference, unless adding it back to u misses t
    dd = Duration.new((sec -% u.sec) *% NS_PER_SEC +% (nsec - u.nsec))
    return dd if u.add(dd).equal(self)
    return Duration.new(MIN_INT) if self.before(u)
    Duration.new(MAX_INT)
  }

  pub def since -> Duration { now().sub(self) }
  pub def until -> Duration { self.sub(now()) }

  # Comparisons of the instants; with a monotonic reading on both sides, of
  # the readings (Go's).
  pub def before(u: Time) -> Bool {
    return mono < u.mono if has_mono && u.has_mono
    sec < u.sec || (sec == u.sec && nsec < u.nsec)
  }
  pub def after(u: Time) -> Bool {
    return mono > u.mono if has_mono && u.has_mono
    sec > u.sec || (sec == u.sec && nsec > u.nsec)
  }
  pub def equal(u: Time) -> Bool {
    return mono == u.mono if has_mono && u.has_mono
    sec == u.sec && nsec == u.nsec
  }
  # -1, 0 or 1 comparing the instants.
  pub def compare(u: Time) -> Int {
    return -1 if self.before(u)
    return 1 if self.after(u)
    0
  }
  pub def ==(u: Time) -> Bool { self.equal(u) }
  pub def <=>(u: Time) -> Int { self.compare(u) }

  # Adds years, months and days to the wall-clock date, normalizing the result
  # (Jan 31 + 1 month is Mar 3 or 2) as Go does.
  pub def add_date(years: Int, months: Int, days: Int) -> Time {
    y, mo, d = self.civil
    h, mi, s = self.clock
    make_date(y + years, mo + months, d + days, h, mi, s, nsec, self.location)
  }

  # The part of t since the zero Time that doesn't divide evenly by d (d > 0).
  def rem(d: Duration) -> Int {
    dn = d.ns
    if dn % NS_PER_SEC == 0 {
      return fmod(sec, dn / NS_PER_SEC) * NS_PER_SEC + nsec
    }
    if NS_PER_SEC % dn == 0 {
      return nsec % dn
    }
    addmod(mulmod(fmod(sec, dn), NS_PER_SEC % dn, dn), nsec % dn, dn)
  }

  # Rounds down to a multiple of d since the zero Time. The monotonic reading
  # is stripped. d <= 0 only strips it.
  pub def truncate(d: Duration) -> Time {
    return self.strip_mono if d.ns <= 0
    self.strip_mono.add(Duration.new(0 - self.rem(d)))
  }

  # Rounds to the nearest multiple of d since the zero Time, halves up.
  pub def round(d: Duration) -> Time {
    return self.strip_mono if d.ns <= 0
    r = self.rem(d)
    if r < d.ns - r {
      return self.strip_mono.add(Duration.new(0 - r))
    }
    self.strip_mono.add(Duration.new(d.ns - r))
  }

  # Go's String(): "2006-01-02 15:04:05.999999999 -0700 MST", plus the
  # monotonic reading " m=+0.000123456" when there is one.
  pub def to_s -> Str {
    s = self.format("2006-01-02 15:04:05.999999999 -0700 MST")
    if has_mono {
      m = mono.as_u64
      sign = "+"
      if mono < 0 {
        sign = "-"
        m = 0 -% m
      }
      ns: U64 = 1000000000
      s += " m=#{sign}#{m / ns}.#{zpad((m % ns).to_i, 9)}"
    }
    s
  }
  pub def string -> Str { self.to_s }
}

# This instant in the process's local zone.
def in_local(sec: Int, nsec: Int, mono: Int, has_mono: Bool) -> Time {
  return at_loc(sec, nsec, mono, has_mono, LOCAL_LOC.load) if LOCAL_SET.load
  u = sec -% UNIX_TO_YEAR1
  off = alx_local_offset(u)
  name = Str.from_cstr(alx_local_zone(u))
  Time.new(sec: sec, nsec: nsec, mono: mono, has_mono: has_mono, off: off, zone: name, loc: system_local())
}

# This instant in loc.
def at_loc(sec: Int, nsec: Int, mono: Int, has_mono: Bool, loc: Location) -> Time {
  if loc.kind == 0 {
    return Time.new(sec: sec, nsec: nsec, mono: mono, has_mono: has_mono, off: 0, zone: "UTC", loc: utc_loc())
  }
  return in_local(sec, nsec, mono, has_mono) if loc.kind == 1
  if loc.kind == 2 {
    return Time.new(sec: sec, nsec: nsec, mono: mono, has_mono: has_mono, off: loc.offset, zone: loc.name, loc: loc)
  }
  name, off, _, _, _ = loc.lookup(sec -% UNIX_TO_YEAR1)
  Time.new(sec: sec, nsec: nsec, mono: mono, has_mono: has_mono, off: off, zone: name, loc: loc)
}

# The Time `sec` seconds and `nsec` nanoseconds after the Unix epoch (nsec
# outside 0..999999999 carries into sec), in the local zone.
pub def unix(sec: Int, nsec: Int) -> Time {
  # Wrapping, as Go's: the extremes of Int round-trip through t.unix.
  s = sec +% fdiv(nsec, NS_PER_SEC)
  n = fmod(nsec, NS_PER_SEC)
  in_local(s +% UNIX_TO_YEAR1, n, 0, false)
}

pub def unix_milli(ms: Int) -> Time { unix(fdiv(ms, 1000), fmod(ms, 1000) * 1000000) }
pub def unix_micro(us: Int) -> Time { unix(fdiv(us, 1000000), fmod(us, 1000000) * 1000) }

# The current time, local zone, with a monotonic reading.
pub def now -> Time {
  w = alx_wall_ns()
  m = alx_mono_ns()
  s = fdiv(w, NS_PER_SEC)
  t = in_local(s + UNIX_TO_YEAR1, w - s * NS_PER_SEC, m, true)
  t
}

# Go's time.Since / time.Until.
pub def since(t: Time) -> Duration { now().sub(t) }
pub def until(t: Time) -> Duration { t.sub(now()) }

# The Time for a calendar date and wall clock in loc. Out-of-range fields
# normalize (month 13 is January of the next year, day 0 the last day of the
# previous month, ...) as in Go. In the local zone, a time skipped by a
# daylight saving jump resolves to one side of it.
pub def date(year: Int, month: Int, day: Int, hour: Int, min: Int, sec: Int, nsec: Int, loc: Location) -> Time {
  make_date(year, month, day, hour, min, sec, nsec, loc)
}

def make_date(year: Int, month: Int, day: Int, hour: Int, min: Int, sec: Int, nsec: Int, loc: Location) -> Time {
  m0 = month - 1
  y = year + fdiv(m0, 12)
  m = fmod(m0, 12) + 1
  # carry nanoseconds into seconds
  s = sec + fdiv(nsec, NS_PER_SEC)
  n = fmod(nsec, NS_PER_SEC)
  days = days_from_civil(y, m, day)
  wall = days * SEC_PER_DAY + hour * 3600 + min * 60 + s # as if UTC
  if loc.kind == 0 {
    return Time.new(sec: wall + UNIX_TO_YEAR1, nsec: n, mono: 0, has_mono: false, off: 0, zone: "UTC", loc: utc_loc())
  }
  if loc.kind == 1 {
    off = alx_local_offset(wall)
    u = wall - off
    off2 = alx_local_offset(u)
    u = wall - off2 if off2 != off
    return in_local(u + UNIX_TO_YEAR1, n, 0, false)
  }
  # Go's Date: the offset at `wall` read as UTC, unless the instant that gives
  # falls outside that zone's span (near a transition): then the offset there.
  unix = wall
  _, offset, start, finish, _ = loc.lookup(unix)
  if offset != 0 {
    u = unix - offset
    if u < start || u >= finish {
      _, offset2, _, _, _ = loc.lookup(u)
      offset = offset2
    }
    unix -= offset
  }
  at_loc(unix + UNIX_TO_YEAR1, n, 0, false, loc)
}

# ------------------------------------------------------- sleeping and timers

# Pauses the calling task for at least d (a sleeping task does not hold up
# the others). A d <= 0 returns at once.
pub def sleep(d: Duration) {
  alx_sleep_ns(d.ns) if d.ns > 0
}

# A channel that receives the current time once, after d.
pub def after(d: Duration) -> Chan[Time] {
  ch = Chan[Time].new(1)
  spawn {
    sleep(d)
    ch << now()
  }
  ch
}

# A channel that receives the time every d, forever. The ticking task is never
# reclaimed: use a Ticker (new_ticker) when you need to stop it. For d <= 0,
# Go's nil channel: one that never receives.
pub def tick(d: Duration) -> Chan[Time] {
  return Chan[Time].new(0) if d.ns <= 0
  new_ticker(d).c
}

# The state a Timer's or Ticker's copies and tasks share is in Atomic[Int]s and
# channels, which outlive the task that made them (a Mutex's storage belongs to
# the region of the task that made it: port-issues #202): `st` is the arming
# (`gen`, bumped by every reset) times 4 plus whether it is pending (0), fired (1)
# or stopped (2); `lk` is a spin lock (0 free, 1 taken) around the state changes
# that also move values in and out of the channel, which never block.
def lock_spin(lk: Atomic[Int]) {
  while !lk.compare_and_swap(0, 1) {}
}

# Takes a value left in the channel, so that nothing sent before a stop or reset
# is received after it (Go 1.23's timers). True if there was one. Only the
# timer's task sends, holding lk as the callers of drain do: a value seen in
# the buffer is still there to take.
def drain(ch: Chan[Time]) -> Bool {
  return false if ch.size == 0
  ch.recv
  true
}

# A one-shot timer: `c` receives the time once d has elapsed, unless stopped
# (Go's Timer; after_func's runs a function instead).
pub struct Timer {
  c: Chan[Time]
  st: Atomic[Int]
  lk: Atomic[Int]
  # after_func's function, in a channel so that the Timer is shareable
  fc: Chan[() -> Unit]
  is_func: Bool

  # Prevents the timer from firing. True if this stopped it, false if it had
  # already fired or been stopped. A value it sent and nobody took is dropped,
  # and counts as not fired (Go 1.23: the channel is synchronous).
  pub def stop -> Bool {
    lock_spin(lk)
    s = st.load
    was = s % 4 == 0
    st.store(s - s % 4 + 2)
    was = drain(c) || was if !is_func
    lk.store(0)
    was
  }

  # Changes the timer to fire after d (again, if it had fired or been stopped).
  # True if it had been pending. A value it sent and nobody took is dropped.
  pub def reset(d: Duration) -> Bool {
    lock_spin(lk)
    s = st.load
    was = s % 4 == 0
    g = s / 4 + 1
    st.store(g * 4)
    was = drain(c) || was if !is_func
    lk.store(0)
    self.arm(d, g)
    was
  }

  # Starts the task that fires arming `g` after d.
  def arm(d: Duration, g: Int) {
    ch = c
    state = st
    lock = lk
    funcs = fc
    is_fn = is_func
    spawn {
      sleep(d)
      fired_at = now()
      lock_spin(lock)
      fire = state.load == g * 4
      if fire {
        state.store(g * 4 + 1)
        # the channel is empty: stop and reset drain it holding the lock
        ch << fired_at if !is_fn
      }
      lock.store(0)
      if fire && is_fn {
        f = funcs.recv.unwrap
        funcs << f.dup
        f.call()
      }
    }
  }
}

def new_timer_of(d: Duration, f: () -> Unit, is_func: Bool) -> Timer {
  fc = Chan[() -> Unit].new(1)
  fc << f.dup
  t = Timer.new(c: Chan[Time].new(1), st: Atomic.new(0), lk: Atomic.new(0), fc: fc, is_func: is_func)
  t.arm(d, 0)
  t
}

# A Timer whose channel receives the time after d (Go's NewTimer).
pub def new_timer(d: Duration) -> Timer { new_timer_of(d, ->() {}, false) }

# Calls f in its own task after d (Go's AfterFunc). The Timer's stop cancels the
# call; reset schedules another. Its channel `c` is unused.
pub def after_func(d: Duration, f: () -> Unit) -> Timer { new_timer_of(d, f, true) }

# A repeating timer: `c` receives the time every d until stopped. Ticks are
# dropped when the receiver falls behind.
pub struct Ticker {
  c: Chan[Time]
  st: Atomic[Int]
  lk: Atomic[Int]

  # Turns the ticker off; no tick is received after it.
  pub def stop {
    lock_spin(lk)
    s = st.load
    st.store(s - s % 4 + 2)
    drain(c)
    lk.store(0)
  }

  # Stops the ticker and restarts it with period d: the next tick comes d
  # from now. Panics if d <= 0.
  pub def reset(d: Duration) {
    assert d.ns > 0, "non-positive interval for Ticker.reset"
    lock_spin(lk)
    g = st.load / 4 + 1
    st.store(g * 4)
    drain(c)
    lk.store(0)
    self.run(d, g)
  }

  # The task that ticks for arming `g`.
  def run(d: Duration, g: Int) {
    ch = c
    state = st
    lock = lk
    spawn {
      next_at = alx_mono_ns() + d.ns
      loop {
        wait = next_at - alx_mono_ns()
        alx_sleep_ns(wait) if wait > 0
        tick_at = now()
        lock_spin(lock)
        live = state.load == g * 4
        # a full buffer: the receiver is behind, drop the tick
        ch << tick_at.dup if live && ch.size == 0
        lock.store(0)
        break if !live
        next_at += d.ns
        # fell far behind (a long pause): resynchronize rather than burst
        now_m = alx_mono_ns()
        next_at = now_m + d.ns if next_at < now_m - d.ns
      }
    }
  }
}

# A Ticker whose channel receives the time every d (Go's NewTicker). Panics if
# d <= 0.
pub def new_ticker(d: Duration) -> Ticker {
  assert d.ns > 0, "non-positive interval for new_ticker"
  t = Ticker.new(c: Chan[Time].new(1), st: Atomic.new(0), lk: Atomic.new(0))
  t.run(d, 0)
  t
}
