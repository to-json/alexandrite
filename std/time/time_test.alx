  pacific()
  x = 17
  for _i in 0...10000 {
    x = mix(x)
    assert_eq time.unix_micro(x).unix_micro, x
  }
}

# Go's unixToZero: seconds from year 1 to 1970 by Go's arithmetic.
UNIX_TO_ZERO = -978307200 + 63113904000

# t - d * floor(t / d) for t = sec * 1e9 + nsec nanoseconds since year 1 (math/big).
def big_rem(sec: Int, nsec: Int, d: Int) -> Int {
  bt = big.new_int(0)
  bt.mul!(big.new_int(sec), big.new_int(1000000000))
  bt.add!(bt, big.new_int(nsec))
  bq = big.new_int(0)
  _, br = bq.div_mod!(bt, big.new_int(d))
  br.int64
}

# Go's testOne in TestTruncateRound.
def truncate_round_one(ti: Int, tns: Int, di: Int) -> Bool {
  t0 = time.unix(ti, tns).utc
  d = di
  d = 0 - d if d < 0 && d != -9223372036854775808
  d = 1 if d <= 0
  r = big_rem(t0.unix + UNIX_TO_ZERO, t0.nanosecond, d)
  t1 = t0.add(time.duration(0 - r))
  trunc = t0.truncate(time.duration(d))
  if trunc != t1 {
    assert false, "#{t0.format(time.RFC3339_NANO)}.truncate(#{d}) = #{trunc.format(time.RFC3339_NANO)}, want #{t1.format(time.RFC3339_NANO)}"
    return false
  }
  t1 = t1.add(time.duration(d)) if r > d / 2 || r + r == d
  rnd = t0.round(time.duration(d))
  if rnd != t1 {
    assert false, "#{t0.format(time.RFC3339_NANO)}.round(#{d}) = #{rnd.format(time.RFC3339_NANO)}, want #{t1.format(time.RFC3339_NANO)}"
    return false
  }
  true
}

test "TestTruncateRound" {
  manual = [
    (time.date(-1, 1, 1, 12, 15, 30, 500000000, time.utc()), 3),
    (time.date(-1, 1, 1, 12, 15, 31, 500000000, time.utc()), 3),
    (time.date(2012, 1, 1, 12, 15, 30, 500000000, time.utc()), 1000000000),
    (time.date(2012, 1, 1, 12, 15, 31, 500000000, time.utc()), 1000000000),
    (time.unix(-19012425939, 649146258), 7435029458905025217),
  ]
  for tt in manual {
    truncate_round_one(tt[0].unix, tt[0].nanosecond, tt[1])
  }
  # exhaustive near 0
  for i in 0...100 {
    for j in 1...100 {
      return if !truncate_round_one(UNIX_TO_ZERO, i, j)
      return if !truncate_round_one(UNIX_TO_ZERO, 0 - i, j)
    }
  }
  # random cases (Go's four quick.Checks, 2000 each)
  x = 19
  for _i in 0...2000 {
    # divisors of a second
    x = mix(x)
    ti = x >> 1
    x = mix(x)
    tns = x >> 32
    logdi = (x >> 8) & 2147483647
    d = 1 << (logdi % 9)
    for _k in 0...((logdi >> 16) % 9) { d *= 5 }
    return if !truncate_round_one(ti, tns, d)
    # multiples of a second
    x = mix(x)
    di = (x >> 32) * 1000000000
    return if !truncate_round_one(ti, tns, di < 0 ? 0 - di : di)
    # halfway cases
    x = mix(x)
    hns = x
    x = mix(x)
    hdi = x & 4294967294
    hdi = 2 if hdi == 0
    hns -= hns % hdi
    hns = hns < 0 ? hns + hdi / 2 : hns - hdi / 2
    return if !truncate_round_one(0, hns, hdi)
    # full generality
    x = mix(x)
    return if !truncate_round_one(ti, tns, x)
  }
}

test "TestISOWeek" {
  for wt in iso_week_tests() {
    y, w = time.date(wt[0], wt[1], wt[2], 0, 0, 0, 0, time.utc()).iso_week
    assert_eq [y, w], [wt[3], wt[4]]
  }
  # the only real invariant: Jan 04 is in week 1
  for year in 1950...2100 {
    y, w = time.date(year, 1, 4, 0, 0, 0, 0, time.utc()).iso_week
    assert_eq [y, w], [year, 1]
  }
}

test "TestYearDay" {
  locs = [
    time.fixed_zone("UTC-8", -8 * 60 * 60), time.fixed_zone("UTC-4", -4 * 60 * 60), time.utc(),
    time.fixed_zone("UTC+4", 4 * 60 * 60), time.fixed_zone("UTC+8", 8 * 60 * 60),
  ]
  i = 0
  for loc in locs {
    for ydt in year_day_tests() {
      dt = time.date(ydt[0], ydt[1], ydt[2], 0, 0, 0, 0, loc)
      assert_eq dt.year_day, ydt[3]
      if ydt[0] >= 0 && ydt[0] <= 9999 {
        off = (i - 2) * 4
        f = sprintf("%04d-%02d-%02d %03d %+.2d00", ydt[0], ydt[1], ydt[2], ydt[3], off)
        dt1 = ~time.parse("2006-01-02 002 -0700", f)
        assert dt1.equal(dt), "parse #{f}"
      }
    }
    i += 1
  }
}

test "TestDurationString" {
  for tt in duration_tests() {
    d = time.duration(tt[1])
    assert_eq d.to_s, tt[0]
    assert_eq time.duration(0 - tt[1]).to_s, "-" + tt[0] if tt[1] > 0
  }
}

test "TestDate" {
  pacific()
  for tt in date_tests() {
    t = time.date(tt[0], tt[1], tt[2], tt[3], tt[4], tt[5], tt[6], time.local())
    want = time.unix(tt[7], 0)
    assert t.equal(want), "date(#{tt}) = #{t}, want #{want}"
  }
}

test "TestAddDate" {
  t0 = time.date(2011, 11, 18, 7, 56, 35, 0, time.utc())
  t1 = time.date(2016, 3, 19, 7, 56, 35, 0, time.utc())
  for at in add_date_tests() {
    assert t0.add_date(at[0], at[1], at[2]).equal(t1), "add_date(#{at})"
  }
  t2 = time.date(1899, 12, 31, 0, 0, 0, 0, time.utc())
  days = t2.unix / (24 * 60 * 60)
  t3 = time.unix(0, 0).add_date(0, 0, days)
  assert t2.equal(t3), "add_date(0, 0, #{days}) = #{t3}"
}

test "TestDaysIn" {
  for tt in [[2011, 1, 31], [2011, 2, 28], [2012, 2, 29], [2011, 6, 30], [2011, 12, 31]] {
    assert_eq time.days_in(tt[1], tt[0]), tt[2]
  }
}

test "TestAddToExactSecond" {
  t1 = time.now()
  t2 = t1.add(time.second - time.duration(t1.nanosecond))
  assert_eq t2.second, (t1.second + 1) % 60
  assert_eq t2.nanosecond, 0
}

#[track_caller]
def equal_time_and_zone(a: time.Time, b: time.Time) -> Bool {
  a.equal(b) && a.zone_info == b.zone_info
}

def gob_tests -> [time.Time] {
  [
    time.date(0, 1, 2, 3, 4, 5, 6, time.utc()),
    time.date(7, 8, 9, 10, 11, 12, 13, time.fixed_zone("", 0)),
    time.unix(81985467080890095, 0x76543210),
    time.Time.new(),
    time.date(1, 2, 3, 4, 5, 6, 7, time.fixed_zone("", 32767 * 60)),
    time.date(1, 2, 3, 4, 5, 6, 7, time.fixed_zone("", -32768 * 60)),
  ]
}

test "TestTimeGob" {
  pacific()
  for tt in gob_tests() {
    b = ~tt.gob_encode
    got = time.Time.new()
    ~got.gob_decode!(b)
    assert equal_time_and_zone(got, tt), "#{got} want #{tt}"
  }
}

test "TestInvalidTimeGob" {
  tests = [
    ([], "Time.unmarshal_binary: no data"),
    ([0, 2, 3], "Time.unmarshal_binary: unsupported version"),
    ([1, 2, 3], "Time.unmarshal_binary: invalid length"),
  ]
  for tt in tests {
    b: [Byte] = tt[0].map { it.as_u8 }
    ignored = time.Time.new()
    r = ignored.gob_decode!(b)
    assert_eq r.err?.message, tt[1]
    r2 = ignored.unmarshal_binary!(b)
    assert_eq r2.err?.message, tt[1]
  }
}

test "TestNotGobEncodableTime" {
  for off in [-1 * 60, -32769 * 60, 32768 * 60] {
    t = time.date(0, 1, 2, 3, 4, 5, 6, time.fixed_zone("", off))
    assert_eq t.gob_encode.err?.message, "Time.marshal_binary: unexpected zone offset"
    assert_eq t.marshal_binary.err?.message, "Time.marshal_binary: unexpected zone offset"
  }
}

test "TestTimeJSON" {
  pacific()
  tests = [
    (time.date(9999, 4, 12, 23, 20, 50, 520 * 1000000, time.utc()), "\"9999-04-12T23:20:50.52Z\""),
    (time.date(1996, 12, 19, 16, 39, 57, 0, time.local()), "\"1996-12-19T16:39:57-08:00\""),
    (time.date(0, 1, 1, 0, 0, 0, 1, time.fixed_zone("", 1 * 60)), "\"0000-01-01T00:00:00.000000001+00:01\""),
    (time.date(2020, 1, 1, 0, 0, 0, 0, time.fixed_zone("", 23 * 60 * 60 + 59 * 60)), "\"2020-01-01T00:00:00+23:59\""),
  ]
  for tt in tests {
    b = ~tt[0].marshal_json
    assert_eq Str.from_bytes(b), tt[1]
    got = time.Time.new()
    ~got.unmarshal_json!(b)
    assert equal_time_and_zone(got, tt[0]), "#{got} want #{tt[0]}"
  }
}

test "TestUnmarshalInvalidTimes" {
  pacific()
  tests = [
    ("{}", "Time.unmarshal_json: input is not a JSON string"),
    ("[]", "Time.unmarshal_json: input is not a JSON string"),
    ("\"2000-01-01T1:12:34Z\"", "<nil>"),
    ("\"2000-01-01T00:00:00,000Z\"", "<nil>"),
    ("\"2000-01-01T00:00:00+24:00\"", "<nil>"),
    ("\"2000-01-01T00:00:00+00:60\"", "<nil>"),
    ("\"2000-01-01T00:00:00+123:45\"", "parsing time \"2000-01-01T00:00:00+123:45\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"+123:45\" as \"Z07:00\""),
  ]
  for tt in tests {
    ts = time.Time.new()
    r = ts.unmarshal_json!(tt[0].bytes)
    assert_eq r.err?.message || "<nil>", tt[1]
    if tt[0].start_with?("\"") && tt[0].end_with?("\"") {
      r2 = ts.unmarshal_text!(strings.trim(tt[0], "\"").bytes)
      assert_eq r2.err?.message || "<nil>", tt[1]
    }
  }
}

test "TestMarshalInvalidTimes" {
  tests = [
    (time.date(10000, 1, 1, 0, 0, 0, 0, time.utc()), "Time.marshal_json: year outside of range [0,9999]"),
    (time.date(-998, 1, 1, 0, 0, 0, 0, time.utc()).add(time.duration(-1000000000)), "Time.marshal_json: year outside of range [0,9999]"),
    (time.date(0, 1, 1, 0, 0, 0, 0, time.utc()).add(time.duration(-1)), "Time.marshal_json: year outside of range [0,9999]"),
    (time.date(2020, 1, 1, 0, 0, 0, 0, time.fixed_zone("", 24 * 60 * 60)), "Time.marshal_json: timezone hour outside of range [0,23]"),
    (time.date(2020, 1, 1, 0, 0, 0, 0, time.fixed_zone("", 123 * 60 * 60)), "Time.marshal_json: timezone hour outside of range [0,23]"),
  ]
  for tt in tests {
    assert_eq tt[0].marshal_json.err?.message, tt[1]
    assert_eq tt[0].marshal_text.err?.message, strings.replace_all(tt[1], "json", "text")
    buf: [Byte] = []
    assert_eq tt[0].append_text(buf).err?.message, strings.replace_all(tt[1], "marshal_json", "append_text")
  }
}

test "TestParseDuration" {
  for tc in parse_duration_tests() {
    r = time.parse_duration(tc[0])
    assert r.ok?, "parse_duration(#{tc[0]}): #{r.err?.message}"
    assert_eq r.unwrap.nanoseconds, tc[1] if r.ok?
  }
}

test "TestParseDurationErrors" {
  for tc in parse_duration_error_tests() {
    r = time.parse_duration(tc[0])
    if e = r.err {
      assert strings.contains(e.message, tc[1]), "parse_duration(#{tc[1]}) = #{e.message}"
    } else {
      assert false, "parse_duration(#{tc[1]}) didn't fail"
    }
  }
}

test "TestParseDurationRoundTrip" {
  max0 = time.duration(9223372036854775807)
  assert time.~parse_duration(max0.to_s) == max0
  min0 = time.duration(-9223372036854775808)
  assert time.~parse_duration(min0.to_s) == min0
  x = 23
  for _i in 0...100 {
    x = mix(x)
    d0 = time.millisecond * ((x >> 33) & 2147483647)
    d1 = time.~parse_duration(d0.to_s)
    assert d0 == d1, "round trip #{d0.nanoseconds} => #{d0} => #{d1.nanoseconds}"
  }
}

test "TestLoadFixed" {
  loc = ~time.load_location("Etc/GMT+1")
  name, offset = time.now().in_zone(loc).zone_info
  assert name == "GMT+1" || name == "-01", name
  assert_eq offset, -1 * 60 * 60
}

test "TestSub" {
  min = time.duration(-9223372036854775808)
  max = time.duration(9223372036854775807)
  hr = time.hour
  zero = time.Time.new()
  u = time.utc()
  tests = [
    (zero, zero, time.duration(0)),
    (time.date(2009, 11, 23, 0, 0, 0, 1, u), time.date(2009, 11, 23, 0, 0, 0, 0, u), time.duration(1)),
    (time.date(2009, 11, 23, 0, 0, 0, 0, u), time.date(2009, 11, 24, 0, 0, 0, 0, u), hr * -24),
    (time.date(2009, 11, 24, 0, 0, 0, 0, u), time.date(2009, 11, 23, 0, 0, 0, 0, u), hr * 24),
    (time.date(-2009, 11, 24, 0, 0, 0, 0, u), time.date(-2009, 11, 23, 0, 0, 0, 0, u), hr * 24),
    (zero, time.date(2109, 11, 23, 0, 0, 0, 0, u), min),
    (time.date(2109, 11, 23, 0, 0, 0, 0, u), zero, max),
    (zero, time.date(-2109, 11, 23, 0, 0, 0, 0, u), max),
    (time.date(-2109, 11, 23, 0, 0, 0, 0, u), zero, min),
    (time.date(2290, 1, 1, 0, 0, 0, 0, u), time.date(2000, 1, 1, 0, 0, 0, 0, u), hr * (290 * 365 * 24) + hr * (71 * 24)),
    (time.date(2300, 1, 1, 0, 0, 0, 0, u), time.date(2000, 1, 1, 0, 0, 0, 0, u), max),
    (time.date(2000, 1, 1, 0, 0, 0, 0, u), time.date(2290, 1, 1, 0, 0, 0, 0, u), hr * (-290 * 365 * 24) - hr * (71 * 24)),
    (time.date(2000, 1, 1, 0, 0, 0, 0, u), time.date(2300, 1, 1, 0, 0, 0, 0, u), min),
    (time.date(2311, 11, 26, 2, 16, 47, 63535996, u), time.date(2019, 8, 16, 2, 29, 30, 268436582, u), time.duration(9223372036795099414)),
    (time.min_mono_time(), time.max_mono_time(), min),
    (time.max_mono_time(), time.min_mono_time(), max),
  ]
  i = 0
  for st in tests {
    assert_eq st[0].sub(st[1]).nanoseconds, st[2].nanoseconds
    i += 1
  }
}

test "TestDurationNanoseconds" {
  for tt in [[-1000, -1000], [-1, -1], [1, 1], [1000, 1000]] {
    assert_eq time.duration(tt[0]).nanoseconds, tt[1]
  }
}

