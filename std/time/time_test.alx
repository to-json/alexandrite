#![test(external)]
# Go's time_test.go (package time_test). The local zone is US Pacific, as in Go's
# tests (force_us_pacific_for_testing); importing time/tzdata makes the zones load
# without a system database (Go's tests read $GOROOT/lib/time/zoneinfo.zip).
# The tables at the end were extracted from Go's file by a scratch Go program.
#
# Not translated, and why:
#   - TestTimeGob / TestTimeJSON go through encoding/gob and encoding/json, which
#     take Time by reflection in Go; here they test gob_encode / gob_decode! and
#     marshal_json / unmarshal_json! directly (the same bytes).
#   - TestCountMallocs, TestUnmarshalTextAllocations: allocation counting
#     (testing.AllocsPerRun) doesn't exist.
#   - TestLocationRace: resets Go's sync.Once for the local zone; the local zone
#     isn't loaded lazily here (it is set_local's or the C library's).
#   - TestDefaultLoc's "== Time{}" row: Go compares struct fields (loc nil vs
#     &utcLoc); alx's == on Times compares instants, so it is Equal's row.
#   - Benchmarks are translated as `bench` blocks for the common paths only.
import "time"
import _ "time/tzdata"
import "math/big"
import "strings"

test "TestZeroTime" {
  zero = time.Time.new()
  year, month, day = zero.date
  hour, min, sec = zero.clock
  assert_eq [year, month, day, hour, min, sec], [1, time.JANUARY, 1, 0, 0, 0]
  assert_eq zero.nanosecond, 0
  assert_eq zero.year_day, 1
  assert_eq zero.weekday, time.MONDAY
}

test "TestZoneData" {
  pacific()
  _, off = time.now().zone_info
  assert off == -8 * 60 * 60 || off == -7 * 60 * 60, "US Pacific: offset #{off}"
}

# (seconds, year, month, day, hour, minute, second, nanosecond, weekday, offset, zone)
def utctests -> [(Int, [Int], Str)] {
  [
    (0, [1970, 1, 1, 0, 0, 0, 0, 4, 0], "UTC"),
    (1221681866, [2008, 9, 17, 20, 4, 26, 0, 3, 0], "UTC"),
    (-1221681866, [1931, 4, 16, 3, 55, 34, 0, 4, 0], "UTC"),
    (-11644473600, [1601, 1, 1, 0, 0, 0, 0, 1, 0], "UTC"),
    (599529660, [1988, 12, 31, 0, 1, 0, 0, 6, 0], "UTC"),
    (978220860, [2000, 12, 31, 0, 1, 0, 0, 0, 0], "UTC"),
  ]
}

def nanoutctests -> [(Int, [Int], Str)] {
  [
    (0, [1970, 1, 1, 0, 0, 0, 100000000, 4, 0], "UTC"),
    (1221681866, [2008, 9, 17, 20, 4, 26, 200000000, 3, 0], "UTC"),
  ]
}

def localtests -> [(Int, [Int], Str)] {
  [
    (0, [1969, 12, 31, 16, 0, 0, 0, 3, -8 * 60 * 60], "PST"),
    (1221681866, [2008, 9, 17, 13, 4, 26, 0, 3, -7 * 60 * 60], "PDT"),
    (2159200800, [2038, 6, 3, 11, 0, 0, 0, 4, -7 * 60 * 60], "PDT"),
    (2152173599, [2038, 3, 14, 1, 59, 59, 0, 0, -8 * 60 * 60], "PST"),
    (2152173600, [2038, 3, 14, 3, 0, 0, 0, 0, -7 * 60 * 60], "PDT"),
    (2152173601, [2038, 3, 14, 3, 0, 1, 0, 0, -7 * 60 * 60], "PDT"),
    (2172733199, [2038, 11, 7, 1, 59, 59, 0, 0, -7 * 60 * 60], "PDT"),
    (2172733200, [2038, 11, 7, 1, 0, 0, 0, 0, -8 * 60 * 60], "PST"),
    (2172733201, [2038, 11, 7, 1, 0, 1, 0, 0, -8 * 60 * 60], "PST"),
  ]
}

def nanolocaltests -> [(Int, [Int], Str)] {
  [
    (0, [1969, 12, 31, 16, 0, 0, 100000000, 3, -8 * 60 * 60], "PST"),
    (1221681866, [2008, 9, 17, 13, 4, 26, 300000000, 3, -7 * 60 * 60], "PDT"),
  ]
}

# Go's same(): the aggregates and the single fields agree with the golden ones.
#[track_caller]
def same(t: time.Time, g: [Int], zone: Str) {
  year, month, day = t.date
  hour, min, sec = t.clock
  name, offset = t.zone_info
  assert_eq [year, month, day, hour, min, sec, offset], [g[0], g[1], g[2], g[3], g[4], g[5], g[8]]
  assert_eq name, zone
  assert_eq [t.year, t.month, t.day, t.hour, t.minute, t.second, t.nanosecond, t.weekday], [g[0], g[1], g[2], g[3], g[4], g[5], g[6], g[7]]
}

test "TestUnixUTC" {
  for tt in utctests() {
    tm = time.unix(tt[0], 0).utc
    assert_eq tm.unix, tt[0]
    same(tm, tt[1], tt[2])
  }
}

test "TestUnixNanoUTC" {
  for tt in nanoutctests() {
    nsec = tt[0] * 1000000000 + tt[1][6]
    tm = time.unix(0, nsec).utc
    assert_eq tm.unix * 1000000000 + tm.nanosecond, nsec
    same(tm, tt[1], tt[2])
  }
}

test "TestUnix" {
  pacific()
  for tt in localtests() {
    tm = time.unix(tt[0], 0)
    assert_eq tm.unix, tt[0]
    same(tm, tt[1], tt[2])
  }
}

test "TestUnixNano" {
  pacific()
  for tt in nanolocaltests() {
    nsec = tt[0] * 1000000000 + tt[1][6]
    tm = time.unix(0, nsec)
    assert_eq tm.unix * 1000000000 + tm.nanosecond, nsec
    same(tm, tt[1], tt[2])
  }
}

test "TestUnixUTCAndBack" {
  x = 7
  for i in 0...20000 {
    x = mix(x)
    sec = i < 10000 ? x >> 32 : x
    assert_eq time.unix(sec, 0).utc.unix, sec
  }
}

test "TestUnixNanoUTCAndBack" {
  x = 11
  for i in 0...20000 {
    x = mix(x)
    nsec = i < 10000 ? x >> 32 : x
    t = time.unix(0, nsec).utc
    assert_eq t.unix *% 1000000000 +% t.nanosecond, nsec
  }
}

test "TestUnixMilli" {
  pacific()
  x = 13
  for _i in 0...10000 {
    x = mix(x)
    assert_eq time.unix_milli(x).unix_milli, x
  }
}

