test "TestDefaultLoc" {
  pacific()
  t1 = time.Time.new()
  t2 = time.Time.new().utc
  assert_eq t1.after(t2), t2.after(t1)
  assert_eq t1.before(t2), t2.before(t1)
  assert_eq t1.equal(t2), t2.equal(t1)
  assert_eq t1.compare(t2), t2.compare(t1)
  assert_eq t1.is_zero, t2.is_zero
  assert_eq t1.date, t2.date
  assert_eq t1.year, t2.year
  assert_eq t1.month, t2.month
  assert_eq t1.day, t2.day
  assert_eq t1.weekday, t2.weekday
  assert_eq t1.iso_week, t2.iso_week
  assert_eq t1.clock, t2.clock
  assert_eq t1.hour, t2.hour
  assert_eq t1.minute, t2.minute
  assert_eq t1.second, t2.second
  assert_eq t1.nanosecond, t2.nanosecond
  assert_eq t1.year_day, t2.year_day
  assert t1.add(time.hour).equal(t2.add(time.hour))
  assert t1.sub(t2) == t2.sub(t1)
  assert t1.add_date(1991, 9, 3) == t2.add_date(1991, 9, 3)
  assert_eq t1.add_date(1991, 9, 3).zone_info, t2.add_date(1991, 9, 3).zone_info
  assert t1.utc == t2.utc
  assert t1.local == t2.local
  assert_eq t1.local.zone_info, t2.local.zone_info
  assert t1.in_zone(time.utc()) == t2.in_zone(time.utc())
  assert_eq t1.zone_info, t2.zone_info
  assert_eq t1.unix, t2.unix
  assert_eq t1.unix_milli, t2.unix_milli
  assert_eq t1.unix_micro, t2.unix_micro
  b1: [Byte] = [0, 0, 0, 0]
  b2: [Byte] = [0, 0, 0, 0]
  assert_eq ~t1.append_binary(b1), ~t2.append_binary(b2)
  assert_eq ~t1.marshal_binary, ~t2.marshal_binary
  assert_eq ~t1.gob_encode, ~t2.gob_encode
  assert_eq ~t1.marshal_json, ~t2.marshal_json
  assert_eq ~t1.append_text(b1), ~t2.append_text(b2)
  assert_eq ~t1.marshal_text, ~t2.marshal_text
  assert t1.truncate(time.hour).equal(t2.truncate(time.hour))
  assert t1.round(time.hour).equal(t2.round(time.hour))
}

bench "BenchmarkNow" { time.now() }
bench "BenchmarkNowUnixNano" { time.now().unix_nano }
bench "BenchmarkFormat" { time.unix(1265346057, 0).format("Mon Jan  2 15:04:05 2006") }
bench "BenchmarkFormatRFC3339Nano" { time.unix(1265346057, 0).format("2006-01-02T15:04:05.999999999Z07:00") }
bench "BenchmarkParse" { time.parse(time.ANSIC, "Mon Jan  2 15:04:05 2006") }
bench "BenchmarkParseRFC3339TZ" { time.parse(time.RFC3339, "2020-08-22T11:27:43.123456789-02:00") }
bench "BenchmarkParseDuration" { time.parse_duration("9007199254.740993ms") }
bench "BenchmarkDateFunc" { time.date(2020, 8, 22, 11, 27, 43, 123456789, time.utc()) }

test "TestMarshalBinaryZeroTime" {
  t0 = time.Time.new()
  enc = ~t0.marshal_binary
  t1 = time.now()
  ~t1.unmarshal_binary!(enc)
  assert t1 == t0
  assert_eq t1.zone_info, t0.zone_info
  assert_eq t1.location.string, "UTC"
}

test "TestMarshalBinaryVersion2" {
  t0 = ~time.parse(time.RFC3339, "1880-01-01T00:00:00Z")
  loc = ~time.load_location("US/Eastern")
  t1 = t0.in_zone(loc)
  b = ~t1.marshal_binary
  t2 = time.Time.new()
  ~t2.unmarshal_binary!(b)
  assert t0.equal(t1) && t1.equal(t2)
}

test "TestMarshalBinaryVersion2Bugfix" {
  offset_sec = -5 * 3600 - 30 * 60 - 45
  t1 = time.date(2024, 6, 15, 12, 0, 0, 0, time.fixed_zone("LMT", offset_sec))
  b = ~t1.marshal_binary
  t2 = time.Time.new()
  ~t2.unmarshal_binary!(b)
  _, o1 = t1.zone_info
  _, o2 = t2.zone_info
  assert_eq o2, o1
}

test "TestZeroMonthString" {
  assert_eq time.month_name(0), "%!Month(0)"
}

test "TestWeekdayString" {
  assert_eq time.weekday_name(time.TUESDAY), "Tuesday"
  assert_eq time.weekday_name(14), "%!Weekday(14)"
}

test "TestReadFileLimit" {
  msg = time.read_file_error("/dev/zero")
  assert strings.contains(msg, "is too large"), msg
}

test "TestConcurrentTimerReset" {
  timer = time.new_timer(time.hour)
  tasks = (0...8).map { |i|
    tm = timer
    spawn {
      for j in 0...1000 { tm.reset(time.hour + time.duration(i * j)) }
    }
  }
  for t in tasks { t.wait }
  timer.stop
}

test "TestConcurrentTimerResetStop" {
  timer = time.new_timer(time.hour)
  tasks = (0...8).map { |i|
    tm = timer
    spawn {
      for j in 0...1000 { tm.reset(time.hour + time.duration(i * j)) }
    }
  }
  stops = (0...8).map { |_i|
    tm = timer
    spawn { tm.stop }
  }
  for t in tasks { t.wait }
  for t in stops { t.wait }
  timer.stop
}

test "TestTimeIsDST" {
  undo = time.disable_platform_sources()
  defer { undo.call() }
  with_dst = ~time.load_location("Australia/Sydney")
  without_dst = ~time.load_location("Australia/Brisbane")
  fixed = time.fixed_zone("FIXED_TIME", 12345)
  u = time.utc()
  tests = [
    (time.date(2009, 1, 1, 12, 0, 0, 0, u), false),
    (time.date(2009, 6, 1, 12, 0, 0, 0, u), false),
    (time.date(2009, 1, 1, 12, 0, 0, 0, with_dst), true),
    (time.date(2009, 6, 1, 12, 0, 0, 0, with_dst), false),
    (time.date(2009, 1, 1, 12, 0, 0, 0, without_dst), false),
    (time.date(2009, 6, 1, 12, 0, 0, 0, without_dst), false),
    (time.date(2009, 1, 1, 12, 0, 0, 0, fixed), false),
    (time.date(2009, 6, 1, 12, 0, 0, 0, fixed), false),
  ]
  for tt in tests {
    assert_eq tt[0].is_dst, tt[1]
  }
}

test "TestTimeAddSecOverflow" {
  max = 9223372036854775807
  ext = max - time.unix_to_internal() - 50
  t = time.unix(ext, 0)
  for i in 0...100 {
    sec = t.unix
    t = t.add(time.duration(i * 1000000000))
    ns = t.unix
    assert ns == sec + i || ns +% time.unix_to_internal() == max, "overflow at #{ns}"
  }
  t = time.not_mono_negative_time()
  for k in 0...100 {
    i = 0 - k
    sec = t.unix
    t = t.add(time.duration(i * 1000000000))
    ns = t.unix
    assert ns == sec +% i || ns +% time.unix_to_internal() == 0 - max, "overflow at #{ns}"
  }
}

test "TestTimeWithZoneTransition" {
  undo = time.disable_platform_sources()
  defer { undo.call() }
  loc = ~time.load_location("Asia/Shanghai")
  u = time.utc()
  tests = [
    (time.date(1991, 4, 13, 17, 50, 0, 0, loc), time.date(1991, 4, 13, 9, 50, 0, 0, u)),
    (time.date(1991, 4, 13, 18, 0, 0, 0, loc), time.date(1991, 4, 13, 10, 0, 0, 0, u)),
    (time.date(1991, 4, 14, 1, 50, 0, 0, loc), time.date(1991, 4, 13, 17, 50, 0, 0, u)),
    (time.date(1991, 4, 14, 3, 0, 0, 0, loc), time.date(1991, 4, 13, 18, 0, 0, 0, u)),
    (time.date(1991, 9, 14, 16, 50, 0, 0, loc), time.date(1991, 9, 14, 7, 50, 0, 0, u)),
    (time.date(1991, 9, 14, 17, 0, 0, 0, loc), time.date(1991, 9, 14, 8, 0, 0, 0, u)),
    (time.date(1991, 9, 15, 0, 50, 0, 0, loc), time.date(1991, 9, 14, 15, 50, 0, 0, u)),
    (time.date(1991, 9, 15, 2, 0, 0, 0, loc), time.date(1991, 9, 14, 18, 0, 0, 0, u)),
  ]
  for tt in tests {
    assert tt[0].equal(tt[1]), "#{tt[0].format(time.RFC3339)} != #{tt[1].format(time.RFC3339)}"
  }
}

test "TestZoneBounds" {
  pacific()
  undo = time.disable_platform_sources()
  defer { undo.call() }
  loc = ~time.load_location("Asia/Shanghai")
  for tt in utctests() {
    s, e = time.unix(tt[0], 0).utc.zone_bounds
    assert s.is_zero && e.is_zero
  }
  s, e = time.date(-2147483648, 1, 1, 0, 0, 0, 0, loc).zone_bounds
  assert s.is_zero && !e.is_zero
  s, e = time.date(2147483647, 1, 1, 0, 0, 0, 0, loc).zone_bounds
  assert !s.is_zero && e.is_zero
  b1 = time.date(1990, 9, 16, 1, 0, 0, 0, loc)
  b2 = time.date(1991, 4, 14, 3, 0, 0, 0, loc)
  b3 = time.date(1991, 9, 15, 1, 0, 0, 0, loc)
  z = time.Time.new()
  lt = ->(sec: Int) -> time.Time { time.unix(sec, 0) }
  tests = [
    (time.date(1991, 4, 13, 17, 50, 0, 0, loc), b1, b2),
    (time.date(1991, 4, 13, 18, 0, 0, 0, loc), b1, b2),
    (time.date(1991, 4, 14, 1, 50, 0, 0, loc), b1, b2),
    (b2, b2, b3),
    (time.date(1991, 9, 14, 16, 50, 0, 0, loc), b2, b3),
    (time.date(1991, 9, 14, 17, 0, 0, 0, loc), b2, b3),
    (time.date(1991, 9, 15, 0, 50, 0, 0, loc), b2, b3),
    (b3, b3, z),
    (time.date(1991, 12, 15, 1, 50, 0, 0, loc), b3, z),
    (time.date(1992, 4, 13, 17, 50, 0, 0, loc), b3, z),
    (time.date(1992, 4, 13, 18, 0, 0, 0, loc), b3, z),
    (time.date(1992, 4, 14, 1, 50, 0, 0, loc), b3, z),
    (time.date(1992, 9, 14, 16, 50, 0, 0, loc), b3, z),
    (time.date(1992, 9, 14, 17, 0, 0, 0, loc), b3, z),
    (time.date(1992, 9, 15, 0, 50, 0, 0, loc), b3, z),
    (lt.call(0), lt.call(-5756400), lt.call(9972000)),
    (lt.call(1221681866), lt.call(1205056800), lt.call(1225616400)),
    (lt.call(2152173599), lt.call(2145916800), lt.call(2152173600)),
    (lt.call(2152173600), lt.call(2152173600), lt.call(2172733200)),
    (lt.call(2152173601), lt.call(2152173600), lt.call(2172733200)),
    (lt.call(2159200800), lt.call(2152173600), lt.call(2172733200)),
    (lt.call(2172733199), lt.call(2152173600), lt.call(2172733200)),
    (lt.call(2172733200), lt.call(2172733200), lt.call(2177452800)),
  ]
  i = 0
  for tt in tests {
    s2, e2 = tt[0].zone_bounds
    assert s2.equal(tt[1]) && e2.equal(tt[2]), "##{i}: zone_bounds of #{tt[0]}: #{s2}, #{e2}, want #{tt[1]}, #{tt[2]}"
    i += 1
  }
}

