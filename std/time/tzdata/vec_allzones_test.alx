test "every zone 17" {
  loc = zone("Etc/Universal")
  assert_eq zs(loc, -2000000000), "1906-08-16 20:26:40 +00:00:00 UTC|false|0001-01-01 00:00:00 +00:00:00 UTC|0001-01-01 00:00:00 +00:00:00 UTC"
  assert_eq zs(loc, 1000000000), "2001-09-09 01:46:40 +00:00:00 UTC|false|0001-01-01 00:00:00 +00:00:00 UTC|0001-01-01 00:00:00 +00:00:00 UTC"
  assert_eq zs(loc, 1751300000), "2025-06-30 16:13:20 +00:00:00 UTC|false|0001-01-01 00:00:00 +00:00:00 UTC|0001-01-01 00:00:00 +00:00:00 UTC"
  loc = zone("Etc/Zulu")
  assert_eq zs(loc, -2000000000), "1906-08-16 20:26:40 +00:00:00 UTC|false|0001-01-01 00:00:00 +00:00:00 UTC|0001-01-01 00:00:00 +00:00:00 UTC"
  assert_eq zs(loc, 1000000000), "2001-09-09 01:46:40 +00:00:00 UTC|false|0001-01-01 00:00:00 +00:00:00 UTC|0001-01-01 00:00:00 +00:00:00 UTC"
  assert_eq zs(loc, 1751300000), "2025-06-30 16:13:20 +00:00:00 UTC|false|0001-01-01 00:00:00 +00:00:00 UTC|0001-01-01 00:00:00 +00:00:00 UTC"
  loc = zone("Europe/Amsterdam")
  assert_eq zs(loc, -2000000000), "1906-08-16 20:46:12 +00:19:32 AMT|false|1835-01-01 00:00:00 +00:19:32 AMT|1916-05-01 01:00:00 +01:19:32 NST"
  assert_eq zs(loc, 1000000000), "2001-09-09 03:46:40 +02:00:00 CEST|true|2001-03-25 03:00:00 +02:00:00 CEST|2001-10-28 02:00:00 +01:00:00 CET"
  assert_eq zs(loc, 1751300000), "2025-06-30 18:13:20 +02:00:00 CEST|true|2025-03-30 03:00:00 +02:00:00 CEST|2025-10-26 02:00:00 +01:00:00 CET"
  loc = zone("Europe/Andorra")
  assert_eq zs(loc, -2000000000), "1906-08-16 20:26:40 +00:00:00 WET|false|1900-12-31 23:53:56 +00:00:00 WET|1946-09-30 01:00:00 +01:00:00 CET"
  assert_eq zs(loc, 1000000000), "2001-09-09 03:46:40 +02:00:00 CEST|true|2001-03-25 03:00:00 +02:00:00 CEST|2001-10-28 02:00:00 +01:00:00 CET"
  assert_eq zs(loc, 1751300000), "2025-06-30 18:13:20 +02:00:00 CEST|true|2025-03-30 03:00:00 +02:00:00 CEST|2025-10-26 02:00:00 +01:00:00 CET"
  loc = zone("Europe/Astrakhan")
  assert_eq zs(loc, -2000000000), "1906-08-16 23:38:52 +03:12:12 LMT|false|0001-01-01 00:00:00 +00:00:00 UTC|1924-04-30 23:47:48 +03:00:00 +03"
  assert_eq zs(loc, 1000000000), "2001-09-09 05:46:40 +04:00:00 +04|true|2001-03-25 03:00:00 +04:00:00 +04|2001-10-28 02:00:00 +03:00:00 +03"
  assert_eq zs(loc, 1751300000), "2025-06-30 20:13:20 +04:00:00 +04|false|2016-03-27 03:00:00 +04:00:00 +04|0001-01-01 00:00:00 +00:00:00 UTC"
  loc = zone("Europe/Athens")
