# Generated from Go's time package (go1.27.1, ZONEINFO=lib/time/zoneinfo.zip; a scratch generator); do not edit by hand.

test "date America/New_York 0" {
  loc = zone("America/New_York")
  assert_eq dz(loc, 2000, 1, 1, 0, 0, 0), "2000-01-01 00:00:00 -05:00:00 EST 946702800"
  assert_eq dz(loc, 1918, 3, 31, 1, 29, 59), "1918-03-31 01:29:59 -05:00:00 EST -1633282201"
  assert_eq dz(loc, 1918, 3, 31, 1, 59, 59), "1918-03-31 01:59:59 -05:00:00 EST -1633280401"
  assert_eq dz(loc, 1918, 3, 31, 1, 89, 59), "1918-03-31 01:29:59 -05:00:00 EST -1633282201"
  assert_eq dz(loc, 1918, 3, 31, 1, 119, 59), "1918-03-31 01:59:59 -05:00:00 EST -1633280401"
  assert_eq dz(loc, 1918, 3, 31, 3, -30, 0), "1918-03-31 01:30:00 -05:00:00 EST -1633282200"
  assert_eq dz(loc, 1918, 3, 31, 3, 0, 0), "1918-03-31 03:00:00 -04:00:00 EDT -1633280400"
  assert_eq dz(loc, 1918, 3, 31, 3, 30, 0), "1918-03-31 03:30:00 -04:00:00 EDT -1633278600"
  assert_eq dz(loc, 1918, 3, 31, 3, 60, 0), "1918-03-31 04:00:00 -04:00:00 EDT -1633276800"
  assert_eq time.unix(-1633366800, 0).in_zone(loc).add_date(0, 0, 1).format(L), "1918-03-31 01:00:00 -05:00:00 EST"
  assert_eq time.unix(-1633366800, 0).in_zone(loc).add_date(0, 1, -1).format(L), "1918-04-29 02:00:00 -04:00:00 EDT"
  assert_eq time.unix(-1633287600, 0).in_zone(loc).add(time.hour * 3).format(L), "1918-03-31 04:00:00 -04:00:00 EDT"
  assert_eq time.unix(-1633280400, 0).in_zone(loc).truncate(time.hour * 24).format(L), "1918-03-30 19:00:00 -05:00:00 EST"
