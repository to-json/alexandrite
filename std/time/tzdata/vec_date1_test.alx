test "date America/Phoenix 2" {
  loc = zone("America/Phoenix")
  assert_eq dz(loc, 2000, 1, 1, 0, 0, 0), "2000-01-01 00:00:00 -07:00:00 MST 946710000"
  assert_eq dz(loc, 1918, 3, 31, 1, 29, 59), "1918-03-31 01:29:59 -07:00:00 MST -1633275001"
