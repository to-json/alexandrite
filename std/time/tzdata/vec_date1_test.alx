  assert_eq dz(loc, 1918, 3, 31, 3, -30, 0), "1918-03-31 01:30:00 -07:00:00 MST -1633275000"
  assert_eq dz(loc, 1918, 3, 31, 3, 0, 0), "1918-03-31 03:00:00 -06:00:00 MDT -1633273200"
  assert_eq dz(loc, 1918, 3, 31, 3, 30, 0), "1918-03-31 03:30:00 -06:00:00 MDT -1633271400"
  assert_eq dz(loc, 1918, 3, 31, 3, 60, 0), "1918-03-31 04:00:00 -06:00:00 MDT -1633269600"
