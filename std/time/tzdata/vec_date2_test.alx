test "date America/Los_Angeles 0" {
  loc = zone("America/Los_Angeles")
  assert_eq dz(loc, 2000, 1, 1, 0, 0, 0), "2000-01-01 00:00:00 -08:00:00 PST 946713600"
  assert_eq dz(loc, 1918, 3, 31, 1, 29, 59), "1918-03-31 01:29:59 -08:00:00 PST -1633271401"
  assert_eq dz(loc, 1918, 3, 31, 1, 59, 59), "1918-03-31 01:59:59 -08:00:00 PST -1633269601"
  assert_eq dz(loc, 1918, 3, 31, 1, 89, 59), "1918-03-31 01:29:59 -08:00:00 PST -1633271401"
  assert_eq dz(loc, 1918, 3, 31, 1, 119, 59), "1918-03-31 01:59:59 -08:00:00 PST -1633269601"
  assert_eq dz(loc, 1918, 3, 31, 3, -30, 0), "1918-03-31 01:30:00 -08:00:00 PST -1633271400"
  assert_eq dz(loc, 1918, 3, 31, 3, 0, 0), "1918-03-31 03:00:00 -07:00:00 PDT -1633269600"
