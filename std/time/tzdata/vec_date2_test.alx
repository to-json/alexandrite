test "date America/Sao_Paulo 2" {
  loc = zone("America/Sao_Paulo")
  assert_eq dz(loc, 2000, 1, 1, 0, 0, 0), "2000-01-01 00:00:00 -02:00:00 -02 946692000"
  assert_eq dz(loc, 1913, 12, 31, 23, 29, 59), "1913-12-31 23:29:59 -03:06:28 LMT -1767216213"
  assert_eq dz(loc, 1913, 12, 31, 23, 59, 59), "1913-12-31 23:59:59 -03:06:28 LMT -1767214413"
  assert_eq dz(loc, 1913, 12, 31, 23, 89, 59), "1914-01-01 00:29:59 -03:00:00 -03 -1767213001"
  assert_eq dz(loc, 1913, 12, 31, 23, 119, 59), "1914-01-01 00:59:59 -03:00:00 -03 -1767211201"
  assert_eq dz(loc, 1914, 1, 1, 0, -24, 28), "1913-12-31 23:36:28 -03:06:28 LMT -1767215824"
  assert_eq dz(loc, 1914, 1, 1, 0, 6, 28), "1914-01-01 00:06:28 -03:00:00 -03 -1767214412"
  assert_eq dz(loc, 1914, 1, 1, 0, 36, 28), "1914-01-01 00:36:28 -03:00:00 -03 -1767212612"
  assert_eq dz(loc, 1914, 1, 1, 0, 66, 28), "1914-01-01 01:06:28 -03:00:00 -03 -1767210812"
