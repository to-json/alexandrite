  assert_eq dz(loc, 2225, 3, 27, 1, 119, 59), "2225-03-27 03:59:59 +02:00:00 CEST 8054387999"
  assert_eq dz(loc, 2225, 3, 27, 3, -30, 0), "2225-03-27 03:30:00 +02:00:00 CEST 8054386200"
  assert_eq dz(loc, 2225, 3, 27, 3, 0, 0), "2225-03-27 03:00:00 +02:00:00 CEST 8054384400"
  assert_eq dz(loc, 2225, 3, 27, 3, 30, 0), "2225-03-27 03:30:00 +02:00:00 CEST 8054386200"
  assert_eq dz(loc, 2225, 3, 27, 3, 60, 0), "2225-03-27 04:00:00 +02:00:00 CEST 8054388000"
  assert_eq time.unix(8054298000, 0).in_zone(loc).add_date(0, 0, 1).format(L), "2225-03-27 03:00:00 +02:00:00 CEST"
  assert_eq time.unix(8054298000, 0).in_zone(loc).add_date(0, 1, -1).format(L), "2225-04-25 02:00:00 +02:00:00 CEST"
  assert_eq time.unix(8054377200, 0).in_zone(loc).add(time.hour * 3).format(L), "2225-03-27 04:00:00 +02:00:00 CEST"
  assert_eq time.unix(8054384400, 0).in_zone(loc).truncate(time.hour * 24).format(L), "2225-03-27 01:00:00 +01:00:00 CET"
  assert_eq dz(loc, 2312, 10, 27, 2, 29, 59), "2312-10-27 02:29:59 +01:00:00 CET 10818322199"
  assert_eq dz(loc, 2312, 10, 27, 2, 59, 59), "2312-10-27 02:59:59 +01:00:00 CET 10818323999"
  assert_eq dz(loc, 2312, 10, 27, 2, 89, 59), "2312-10-27 03:29:59 +01:00:00 CET 10818325799"
  assert_eq dz(loc, 2312, 10, 27, 2, 119, 59), "2312-10-27 03:59:59 +01:00:00 CET 10818327599"
  assert_eq dz(loc, 2312, 10, 27, 2, -30, 0), "2312-10-27 01:30:00 +02:00:00 CEST 10818315000"
  assert_eq dz(loc, 2312, 10, 27, 2, 0, 0), "2312-10-27 02:00:00 +01:00:00 CET 10818320400"
  assert_eq dz(loc, 2312, 10, 27, 2, 30, 0), "2312-10-27 02:30:00 +01:00:00 CET 10818322200"
  assert_eq dz(loc, 2312, 10, 27, 2, 60, 0), "2312-10-27 03:00:00 +01:00:00 CET 10818324000"
  assert_eq time.unix(10818234000, 0).in_zone(loc).add_date(0, 0, 1).format(L), "2312-10-27 03:00:00 +01:00:00 CET"
  assert_eq time.unix(10818234000, 0).in_zone(loc).add_date(0, 1, -1).format(L), "2312-11-25 03:00:00 +01:00:00 CET"
  assert_eq time.unix(10818313200, 0).in_zone(loc).add(time.hour * 3).format(L), "2312-10-27 03:00:00 +01:00:00 CET"
  assert_eq time.unix(10818320400, 0).in_zone(loc).truncate(time.hour * 24).format(L), "2312-10-27 02:00:00 +02:00:00 CEST"
  assert_eq dz(loc, 2400, 1, 1, 0, 29, 59), "2400-01-01 00:29:59 +01:00:00 CET 13569463799"
  assert_eq dz(loc, 2400, 1, 1, 0, 59, 59), "2400-01-01 00:59:59 +01:00:00 CET 13569465599"
  assert_eq dz(loc, 2400, 1, 1, 0, 89, 59), "2400-01-01 01:29:59 +01:00:00 CET 13569467399"
  assert_eq dz(loc, 2400, 1, 1, 0, 119, 59), "2400-01-01 01:59:59 +01:00:00 CET 13569469199"
  assert_eq dz(loc, 2400, 1, 1, 1, -30, 0), "2400-01-01 00:30:00 +01:00:00 CET 13569463800"
  assert_eq dz(loc, 2400, 1, 1, 1, 0, 0), "2400-01-01 01:00:00 +01:00:00 CET 13569465600"
  assert_eq dz(loc, 2400, 1, 1, 1, 30, 0), "2400-01-01 01:30:00 +01:00:00 CET 13569467400"
  assert_eq dz(loc, 2400, 1, 1, 1, 60, 0), "2400-01-01 02:00:00 +01:00:00 CET 13569469200"
  assert_eq time.unix(13569379200, 0).in_zone(loc).add_date(0, 0, 1).format(L), "2400-01-01 01:00:00 +01:00:00 CET"
  assert_eq time.unix(13569379200, 0).in_zone(loc).add_date(0, 1, -1).format(L), "2400-01-30 01:00:00 +01:00:00 CET"
  assert_eq time.unix(13569458400, 0).in_zone(loc).add(time.hour * 3).format(L), "2400-01-01 02:00:00 +01:00:00 CET"
  assert_eq time.unix(13569465600, 0).in_zone(loc).truncate(time.hour * 24).format(L), "2400-01-01 01:00:00 +01:00:00 CET"
