  assert_eq dz(loc, 1905, 6, 30, 23, 76, 25), "1905-07-01 00:16:25 +00:00:00 GMT -2035583015"
  assert_eq dz(loc, 1905, 6, 30, 23, 106, 25), "1905-07-01 00:46:25 +00:00:00 GMT -2035581215"
