  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Z07"), "+05"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("-07"), "+05"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("-07:00:00"), "+05:45:00"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Z07:00:00"), "+05:45:00"
