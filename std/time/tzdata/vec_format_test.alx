  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2023-11-14T23:13:20+01:00"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Tue, 14 Nov 2023 23:13:20 CET"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Tue, 14 Nov 2023 23:13:20 +0100"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "14 Nov 23 23:13 CET"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Tuesday, 14-Nov-23 23:13:20 CET"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Tue Nov 14 23:13:20 CET 2023"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Tue Nov 14 23:13:20 +0100 2023"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("3:04PM MST"), "11:13PM CET"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2023-11-14T23:13:20.123+0100"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Z07"), "+01"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("-07"), "+01"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("-07:00:00"), "+01:00:00"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Z07:00:00"), "+01:00:00"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("-070000"), "+010000"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Z070000"), "+010000"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("MST"), "CET"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2036-07-18T15:20:00+02:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 18 Jul 2036 15:20:00 CEST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 18 Jul 2036 15:20:00 +0200"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "18 Jul 36 15:20 CEST"
}

test "format Europe/Paris 19" {
  loc = zone("Europe/Paris")
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 18-Jul-36 15:20:00 CEST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jul 18 15:20:00 CEST 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jul 18 15:20:00 +0200 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("3:04PM MST"), "3:20PM CEST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2036-07-18T15:20:00.123+0200"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07"), "+02"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07"), "+02"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07:00:00"), "+02:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07:00:00"), "+02:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-070000"), "+020000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z070000"), "+020000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("MST"), "CEST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2128-06-11T10:53:20+02:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 11 Jun 2128 10:53:20 CEST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 11 Jun 2128 10:53:20 +0200"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "11 Jun 28 10:53 CEST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 11-Jun-28 10:53:20 CEST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jun 11 10:53:20 CEST 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jun 11 10:53:20 +0200 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("3:04PM MST"), "10:53AM CEST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2128-06-11T10:53:20.123+0200"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07"), "+02"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07"), "+02"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07:00:00"), "+02:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+02:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-070000"), "+020000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z070000"), "+020000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("MST"), "CEST"
}

test "format Africa/Monrovia 20" {
  loc = zone("Africa/Monrovia")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-16T19:43:32-00:43"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 16 Aug 1906 19:43:32 MMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 16 Aug 1906 19:43:32 -0043"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "16 Aug 06 19:43 MMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Thursday, 16-Aug-06 19:43:32 MMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Aug 16 19:43:32 MMT 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Aug 16 19:43:32 -0043 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("3:04PM MST"), "7:43PM MMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1906-08-16T19:43:32.123-0043"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07"), "-00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07"), "-00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07:00:00"), "-00:43:08"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07:00:00"), "-00:43:08"
