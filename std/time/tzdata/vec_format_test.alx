test "format America/St_Johns 23" {
  loc = zone("America/St_Johns")
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 18-Jul-36 10:50:00 NDT"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jul 18 10:50:00 NDT 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jul 18 10:50:00 -0230 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("3:04PM MST"), "10:50AM NDT"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2036-07-18T10:50:00.123-0230"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07"), "-02"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07"), "-02"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07:00:00"), "-02:30:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07:00:00"), "-02:30:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-070000"), "-023000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z070000"), "-023000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("MST"), "NDT"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2128-06-11T06:23:20-02:30"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 11 Jun 2128 06:23:20 NDT"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 11 Jun 2128 06:23:20 -0230"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "11 Jun 28 06:23 NDT"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 11-Jun-28 06:23:20 NDT"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jun 11 06:23:20 NDT 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jun 11 06:23:20 -0230 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("3:04PM MST"), "6:23AM NDT"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2128-06-11T06:23:20.123-0230"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07"), "-02"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07"), "-02"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07:00:00"), "-02:30:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07:00:00"), "-02:30:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-070000"), "-023000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z070000"), "-023000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("MST"), "NDT"
}

test "format Asia/Shanghai 24" {
  loc = zone("Asia/Shanghai")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-17T04:26:40+08:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 17 Aug 1906 04:26:40 CST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 17 Aug 1906 04:26:40 +0800"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "17 Aug 06 04:26 CST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 17-Aug-06 04:26:40 CST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Aug 17 04:26:40 CST 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Aug 17 04:26:40 +0800 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("3:04PM MST"), "4:26AM CST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1906-08-17T04:26:40.123+0800"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07"), "+08"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07"), "+08"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07:00:00"), "+08:00:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+08:00:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-070000"), "+080000"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z070000"), "+080000"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("MST"), "CST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1938-04-25T06:13:20+08:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Mon, 25 Apr 1938 06:13:20 CST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Mon, 25 Apr 1938 06:13:20 +0800"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "25 Apr 38 06:13 CST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Monday, 25-Apr-38 06:13:20 CST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Mon Apr 25 06:13:20 CST 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Mon Apr 25 06:13:20 +0800 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("3:04PM MST"), "6:13AM CST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1938-04-25T06:13:20.123+0800"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07"), "+08"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-07"), "+08"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-07:00:00"), "+08:00:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+08:00:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-070000"), "+080000"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z070000"), "+080000"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("MST"), "CST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1970-01-01T08:00:00+08:00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 01 Jan 1970 08:00:00 CST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 01 Jan 1970 08:00:00 +0800"
