}

test "format Africa/Casablanca 12" {
  loc = zone("Africa/Casablanca")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-16T19:56:20-00:30"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 16 Aug 1906 19:56:20 LMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 16 Aug 1906 19:56:20 -0030"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "16 Aug 06 19:56 LMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Thursday, 16-Aug-06 19:56:20 LMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Aug 16 19:56:20 LMT 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Aug 16 19:56:20 -0030 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("3:04PM MST"), "7:56PM LMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1906-08-16T19:56:20.123-0030"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07"), "-00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07"), "-00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07:00:00"), "-00:30:20"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07:00:00"), "-00:30:20"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-070000"), "-003020"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z070000"), "-003020"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("MST"), "LMT"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1938-04-24T22:13:20Z"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Sun, 24 Apr 1938 22:13:20 +00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Sun, 24 Apr 1938 22:13:20 +0000"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "24 Apr 38 22:13 +00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Sunday, 24-Apr-38 22:13:20 +00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Sun Apr 24 22:13:20 +00 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Sun Apr 24 22:13:20 +0000 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("3:04PM MST"), "10:13PM +00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1938-04-24T22:13:20.123Z"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07"), "Z"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-07"), "+00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-07:00:00"), "+00:00:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07:00:00"), "Z"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-070000"), "+000000"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z070000"), "Z"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("MST"), "+00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1970-01-01T00:00:00Z"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 01 Jan 1970 00:00:00 +00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 01 Jan 1970 00:00:00 +0000"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "01 Jan 70 00:00 +00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Thursday, 01-Jan-70 00:00:00 +00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Jan  1 00:00:00 +00 1970"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Jan 01 00:00:00 +0000 1970"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("3:04PM MST"), "12:00AM +00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1970-01-01T00:00:00.123Z"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Z07"), "Z"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("-07"), "+00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("-07:00:00"), "+00:00:00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Z07:00:00"), "Z"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("-070000"), "+000000"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Z070000"), "Z"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("MST"), "+00"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1992-03-07T20:26:40Z"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Sat, 07 Mar 1992 20:26:40 +00"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Sat, 07 Mar 1992 20:26:40 +0000"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "07 Mar 92 20:26 +00"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Saturday, 07-Mar-92 20:26:40 +00"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Sat Mar  7 20:26:40 +00 1992"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Sat Mar 07 20:26:40 +0000 1992"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("3:04PM MST"), "8:26PM +00"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1992-03-07T20:26:40.123Z"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Z07"), "Z"
