  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("MST"), "+1030"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2128-06-11T19:23:20+10:30"
