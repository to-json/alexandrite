  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 11 Jun 2128 08:53:20 +00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 11 Jun 2128 08:53:20 +0000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "11 Jun 28 08:53 +00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 11-Jun-28 08:53:20 +00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jun 11 08:53:20 +00 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jun 11 08:53:20 +0000 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("3:04PM MST"), "8:53AM +00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2128-06-11T08:53:20.123Z"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07"), "Z"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07"), "+00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07:00:00"), "+00:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07:00:00"), "Z"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-070000"), "+000000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z070000"), "Z"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("MST"), "+00"
}

test "format Asia/Kathmandu 14" {
  loc = zone("Asia/Kathmandu")
