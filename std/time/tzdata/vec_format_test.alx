  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2036-07-18T23:20:00+10:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 18 Jul 2036 23:20:00 AEST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 18 Jul 2036 23:20:00 +1000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "18 Jul 36 23:20 AEST"
}

test "format Australia/Sydney 27" {
  loc = zone("Australia/Sydney")
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 18-Jul-36 23:20:00 AEST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jul 18 23:20:00 AEST 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jul 18 23:20:00 +1000 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("3:04PM MST"), "11:20PM AEST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2036-07-18T23:20:00.123+1000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07"), "+10"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07"), "+10"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07:00:00"), "+10:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07:00:00"), "+10:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-070000"), "+100000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z070000"), "+100000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("MST"), "AEST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2128-06-11T18:53:20+10:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 11 Jun 2128 18:53:20 AEST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 11 Jun 2128 18:53:20 +1000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "11 Jun 28 18:53 AEST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 11-Jun-28 18:53:20 AEST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jun 11 18:53:20 AEST 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jun 11 18:53:20 +1000 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("3:04PM MST"), "6:53PM AEST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2128-06-11T18:53:20.123+1000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07"), "+10"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07"), "+10"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07:00:00"), "+10:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+10:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-070000"), "+100000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z070000"), "+100000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("MST"), "AEST"
}
