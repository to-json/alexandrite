  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Z070000"), "Z"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("MST"), "+00"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2011-03-13T07:06:40Z"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Sun, 13 Mar 2011 07:06:40 +00"
