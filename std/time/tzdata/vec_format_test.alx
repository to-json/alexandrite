  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("MST"), "+01"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2036-07-18T13:20:00Z"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 18 Jul 2036 13:20:00 +00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 18 Jul 2036 13:20:00 +0000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "18 Jul 36 13:20 +00"
}

