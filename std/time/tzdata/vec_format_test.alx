# Generated from Go's time package (go1.27.1, ZONEINFO=lib/time/zoneinfo.zip; a scratch generator); do not edit by hand.

test "format America/New_York 0" {
  loc = zone("America/New_York")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-16T15:26:40-05:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 16 Aug 1906 15:26:40 EST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 16 Aug 1906 15:26:40 -0500"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "16 Aug 06 15:26 EST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Thursday, 16-Aug-06 15:26:40 EST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Aug 16 15:26:40 EST 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Aug 16 15:26:40 -0500 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("3:04PM MST"), "3:26PM EST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1906-08-16T15:26:40.123-0500"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07"), "-05"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07"), "-05"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07:00:00"), "-05:00:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07:00:00"), "-05:00:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-070000"), "-050000"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z070000"), "-050000"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("MST"), "EST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1938-04-24T18:13:20-04:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Sun, 24 Apr 1938 18:13:20 EDT"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Sun, 24 Apr 1938 18:13:20 -0400"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "24 Apr 38 18:13 EDT"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Sunday, 24-Apr-38 18:13:20 EDT"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Sun Apr 24 18:13:20 EDT 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Sun Apr 24 18:13:20 -0400 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("3:04PM MST"), "6:13PM EDT"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1938-04-24T18:13:20.123-0400"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07"), "-04"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-07"), "-04"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-07:00:00"), "-04:00:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07:00:00"), "-04:00:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-070000"), "-040000"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z070000"), "-040000"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("MST"), "EDT"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1969-12-31T19:00:00-05:00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Wed, 31 Dec 1969 19:00:00 EST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Wed, 31 Dec 1969 19:00:00 -0500"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "31 Dec 69 19:00 EST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Wednesday, 31-Dec-69 19:00:00 EST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Wed Dec 31 19:00:00 EST 1969"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Wed Dec 31 19:00:00 -0500 1969"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("3:04PM MST"), "7:00PM EST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1969-12-31T19:00:00.123-0500"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Z07"), "-05"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("-07"), "-05"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("-07:00:00"), "-05:00:00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Z07:00:00"), "-05:00:00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("-070000"), "-050000"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Z070000"), "-050000"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("MST"), "EST"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1992-03-07T15:26:40-05:00"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Sat, 07 Mar 1992 15:26:40 EST"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Sat, 07 Mar 1992 15:26:40 -0500"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "07 Mar 92 15:26 EST"
