  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Jan  1 08:00:00 CST 1970"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Jan 01 08:00:00 +0800 1970"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("3:04PM MST"), "8:00AM CST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1970-01-01T08:00:00.123+0800"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Z07"), "+08"
