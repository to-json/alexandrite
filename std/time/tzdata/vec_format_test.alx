  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 18 Jul 2036 23:50:00 +1030"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 18 Jul 2036 23:50:00 +1030"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "18 Jul 36 23:50 +1030"
}

test "format Australia/Lord_Howe 5" {
  loc = zone("Australia/Lord_Howe")
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 18-Jul-36 23:50:00 +1030"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jul 18 23:50:00 +1030 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jul 18 23:50:00 +1030 2036"
