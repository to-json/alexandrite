  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Mon Apr 25 03:43:20 IST 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Mon Apr 25 03:43:20 +0530 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("3:04PM MST"), "3:43AM IST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1938-04-25T03:43:20.123+0530"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07"), "+05"
