  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Z07"), "-03"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("-07"), "-03"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("-07:00:00"), "-03:00:00"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Z07:00:00"), "-03:00:00"
