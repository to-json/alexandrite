test "format Pacific/Apia 8" {
  loc = zone("Pacific/Apia")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-16T08:59:44-11:26"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 16 Aug 1906 08:59:44 LMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 16 Aug 1906 08:59:44 -1126"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "16 Aug 06 08:59 LMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Thursday, 16-Aug-06 08:59:44 LMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Aug 16 08:59:44 LMT 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Aug 16 08:59:44 -1126 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("3:04PM MST"), "8:59AM LMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1906-08-16T08:59:44.123-1126"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07"), "-11"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07"), "-11"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07:00:00"), "-11:26:56"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07:00:00"), "-11:26:56"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-070000"), "-112656"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z070000"), "-112656"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("MST"), "LMT"
