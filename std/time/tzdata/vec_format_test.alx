test "format Pacific/Chatham 16" {
  loc = zone("Pacific/Chatham")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-17T08:41:40+12:15"
