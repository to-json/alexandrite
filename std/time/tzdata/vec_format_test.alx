  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Tue, 14 Nov 2023 23:13:20 +01"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Tue, 14 Nov 2023 23:13:20 +0100"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "14 Nov 23 23:13 +01"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Tuesday, 14-Nov-23 23:13:20 +01"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Tue Nov 14 23:13:20 +01 2023"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Tue Nov 14 23:13:20 +0100 2023"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("3:04PM MST"), "11:13PM +01"
