test "format Asia/Shanghai 25" {
  loc = zone("Asia/Shanghai")
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 18-Jul-36 21:20:00 CST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jul 18 21:20:00 CST 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jul 18 21:20:00 +0800 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("3:04PM MST"), "9:20PM CST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2036-07-18T21:20:00.123+0800"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07"), "+08"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07"), "+08"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07:00:00"), "+08:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07:00:00"), "+08:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-070000"), "+080000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z070000"), "+080000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("MST"), "CST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2128-06-11T16:53:20+08:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 11 Jun 2128 16:53:20 CST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 11 Jun 2128 16:53:20 +0800"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "11 Jun 28 16:53 CST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 11-Jun-28 16:53:20 CST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jun 11 16:53:20 CST 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jun 11 16:53:20 +0800 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("3:04PM MST"), "4:53PM CST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2128-06-11T16:53:20.123+0800"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07"), "+08"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07"), "+08"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07:00:00"), "+08:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+08:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-070000"), "+080000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z070000"), "+080000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("MST"), "CST"
}

test "format Australia/Sydney 26" {
  loc = zone("Australia/Sydney")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-17T06:26:40+10:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 17 Aug 1906 06:26:40 AEST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 17 Aug 1906 06:26:40 +1000"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "17 Aug 06 06:26 AEST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 17-Aug-06 06:26:40 AEST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Aug 17 06:26:40 AEST 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Aug 17 06:26:40 +1000 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("3:04PM MST"), "6:26AM AEST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1906-08-17T06:26:40.123+1000"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07"), "+10"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07"), "+10"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07:00:00"), "+10:00:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+10:00:00"
