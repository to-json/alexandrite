  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Tue Nov 14 19:13:20 -03 2023"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Tue Nov 14 19:13:20 -0300 2023"
