test "format America/New_York 1" {
  loc = zone("America/New_York")
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 18-Jul-36 09:20:00 EDT"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jul 18 09:20:00 EDT 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jul 18 09:20:00 -0400 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("3:04PM MST"), "9:20AM EDT"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2036-07-18T09:20:00.123-0400"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07"), "-04"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07"), "-04"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07:00:00"), "-04:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07:00:00"), "-04:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-070000"), "-040000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z070000"), "-040000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("MST"), "EDT"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2128-06-11T04:53:20-04:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 11 Jun 2128 04:53:20 EDT"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 11 Jun 2128 04:53:20 -0400"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "11 Jun 28 04:53 EDT"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 11-Jun-28 04:53:20 EDT"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jun 11 04:53:20 EDT 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jun 11 04:53:20 -0400 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("3:04PM MST"), "4:53AM EDT"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2128-06-11T04:53:20.123-0400"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07"), "-04"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07"), "-04"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07:00:00"), "-04:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07:00:00"), "-04:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-070000"), "-040000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z070000"), "-040000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("MST"), "EDT"
}

test "format Europe/Dublin 2" {
  loc = zone("Europe/Dublin")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-16T20:01:19-00:25"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 16 Aug 1906 20:01:19 DMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 16 Aug 1906 20:01:19 -0025"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "16 Aug 06 20:01 DMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Thursday, 16-Aug-06 20:01:19 DMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Aug 16 20:01:19 DMT 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Aug 16 20:01:19 -0025 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("3:04PM MST"), "8:01PM DMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1906-08-16T20:01:19.123-0025"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07"), "-00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07"), "-00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07:00:00"), "-00:25:21"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07:00:00"), "-00:25:21"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-070000"), "-002521"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z070000"), "-002521"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("MST"), "DMT"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1938-04-24T23:13:20+01:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Sun, 24 Apr 1938 23:13:20 IST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Sun, 24 Apr 1938 23:13:20 +0100"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "24 Apr 38 23:13 IST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Sunday, 24-Apr-38 23:13:20 IST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Sun Apr 24 23:13:20 IST 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Sun Apr 24 23:13:20 +0100 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("3:04PM MST"), "11:13PM IST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1938-04-24T23:13:20.123+0100"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07"), "+01"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-07"), "+01"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-07:00:00"), "+01:00:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+01:00:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-070000"), "+010000"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z070000"), "+010000"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("MST"), "IST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1970-01-01T01:00:00+01:00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 01 Jan 1970 01:00:00 IST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 01 Jan 1970 01:00:00 +0100"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "01 Jan 70 01:00 IST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Thursday, 01-Jan-70 01:00:00 IST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Jan  1 01:00:00 IST 1970"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Jan 01 01:00:00 +0100 1970"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("3:04PM MST"), "1:00AM IST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1970-01-01T01:00:00.123+0100"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Z07"), "+01"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("-07"), "+01"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("-07:00:00"), "+01:00:00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Z07:00:00"), "+01:00:00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("-070000"), "+010000"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Z070000"), "+010000"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("MST"), "IST"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1992-03-07T20:26:40Z"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Sat, 07 Mar 1992 20:26:40 GMT"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Sat, 07 Mar 1992 20:26:40 +0000"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "07 Mar 92 20:26 GMT"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Saturday, 07-Mar-92 20:26:40 GMT"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Sat Mar  7 20:26:40 GMT 1992"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Sat Mar 07 20:26:40 +0000 1992"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("3:04PM MST"), "8:26PM GMT"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1992-03-07T20:26:40.123Z"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Z07"), "Z"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("-07"), "+00"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("-07:00:00"), "+00:00:00"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Z07:00:00"), "Z"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("-070000"), "+000000"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("Z070000"), "Z"
  assert_eq time.unix(700000000, 123456789).in_zone(loc).format("MST"), "GMT"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2011-03-13T07:06:40Z"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Sun, 13 Mar 2011 07:06:40 GMT"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Sun, 13 Mar 2011 07:06:40 +0000"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "13 Mar 11 07:06 GMT"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Sunday, 13-Mar-11 07:06:40 GMT"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Sun Mar 13 07:06:40 GMT 2011"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Sun Mar 13 07:06:40 +0000 2011"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("3:04PM MST"), "7:06AM GMT"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2011-03-13T07:06:40.123Z"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("Z07"), "Z"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("-07"), "+00"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("-07:00:00"), "+00:00:00"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("Z07:00:00"), "Z"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("-070000"), "+000000"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("Z070000"), "Z"
  assert_eq time.unix(1300000000, 123456789).in_zone(loc).format("MST"), "GMT"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2023-11-14T22:13:20Z"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Tue, 14 Nov 2023 22:13:20 GMT"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Tue, 14 Nov 2023 22:13:20 +0000"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "14 Nov 23 22:13 GMT"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Tuesday, 14-Nov-23 22:13:20 GMT"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Tue Nov 14 22:13:20 GMT 2023"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Tue Nov 14 22:13:20 +0000 2023"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("3:04PM MST"), "10:13PM GMT"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2023-11-14T22:13:20.123Z"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Z07"), "Z"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("-07"), "+00"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("-07:00:00"), "+00:00:00"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Z07:00:00"), "Z"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("-070000"), "+000000"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("Z070000"), "Z"
  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("MST"), "GMT"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2036-07-18T14:20:00+01:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 18 Jul 2036 14:20:00 IST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 18 Jul 2036 14:20:00 +0100"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "18 Jul 36 14:20 IST"
}

test "format Europe/Dublin 3" {
  loc = zone("Europe/Dublin")
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 18-Jul-36 14:20:00 IST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jul 18 14:20:00 IST 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jul 18 14:20:00 +0100 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("3:04PM MST"), "2:20PM IST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2036-07-18T14:20:00.123+0100"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07"), "+01"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07"), "+01"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07:00:00"), "+01:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07:00:00"), "+01:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-070000"), "+010000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z070000"), "+010000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("MST"), "IST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2128-06-11T09:53:20+01:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 11 Jun 2128 09:53:20 IST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 11 Jun 2128 09:53:20 +0100"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "11 Jun 28 09:53 IST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 11-Jun-28 09:53:20 IST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jun 11 09:53:20 IST 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jun 11 09:53:20 +0100 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("3:04PM MST"), "9:53AM IST"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2128-06-11T09:53:20.123+0100"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07"), "+01"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07"), "+01"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07:00:00"), "+01:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+01:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-070000"), "+010000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z070000"), "+010000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("MST"), "IST"
}

test "format Australia/Lord_Howe 4" {
  loc = zone("Australia/Lord_Howe")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-17T06:26:40+10:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 17 Aug 1906 06:26:40 AEST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 17 Aug 1906 06:26:40 +1000"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "17 Aug 06 06:26 AEST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 17-Aug-06 06:26:40 AEST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Aug 17 06:26:40 AEST 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Aug 17 06:26:40 +1000 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("3:04PM MST"), "6:26AM AEST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1906-08-17T06:26:40.123+1000"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07"), "+10"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07"), "+10"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07:00:00"), "+10:00:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+10:00:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-070000"), "+100000"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z070000"), "+100000"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("MST"), "AEST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1938-04-25T08:13:20+10:00"
