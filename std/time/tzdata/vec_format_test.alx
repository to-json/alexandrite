}

test "format Pacific/Chatham 17" {
  loc = zone("Pacific/Chatham")
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Saturday, 19-Jul-36 02:05:00 +1245"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Sat Jul 19 02:05:00 +1245 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Sat Jul 19 02:05:00 +1245 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("3:04PM MST"), "2:05AM +1245"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2036-07-19T02:05:00.123+1245"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07"), "+12"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07"), "+12"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07:00:00"), "+12:45:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07:00:00"), "+12:45:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-070000"), "+124500"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z070000"), "+124500"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("MST"), "+1245"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2128-06-11T21:38:20+12:45"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 11 Jun 2128 21:38:20 +1245"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 11 Jun 2128 21:38:20 +1245"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "11 Jun 28 21:38 +1245"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 11-Jun-28 21:38:20 +1245"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jun 11 21:38:20 +1245 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jun 11 21:38:20 +1245 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("3:04PM MST"), "9:38PM +1245"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2128-06-11T21:38:20.123+1245"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07"), "+12"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07"), "+12"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07:00:00"), "+12:45:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+12:45:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-070000"), "+124500"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z070000"), "+124500"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("MST"), "+1245"
}

test "format Europe/Paris 18" {
  loc = zone("Europe/Paris")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-16T20:36:01+00:09"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 16 Aug 1906 20:36:01 PMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 16 Aug 1906 20:36:01 +0009"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "16 Aug 06 20:36 PMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Thursday, 16-Aug-06 20:36:01 PMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Aug 16 20:36:01 PMT 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Aug 16 20:36:01 +0009 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("3:04PM MST"), "8:36PM PMT"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1906-08-16T20:36:01.123+0009"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07"), "+00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07"), "+00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07:00:00"), "+00:09:21"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+00:09:21"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-070000"), "+000921"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z070000"), "+000921"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("MST"), "PMT"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1938-04-24T23:13:20+01:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Sun, 24 Apr 1938 23:13:20 WEST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Sun, 24 Apr 1938 23:13:20 +0100"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "24 Apr 38 23:13 WEST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Sunday, 24-Apr-38 23:13:20 WEST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Sun Apr 24 23:13:20 WEST 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Sun Apr 24 23:13:20 +0100 1938"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("3:04PM MST"), "11:13PM WEST"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1938-04-24T23:13:20.123+0100"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07"), "+01"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-07"), "+01"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-07:00:00"), "+01:00:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+01:00:00"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("-070000"), "+010000"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("Z070000"), "+010000"
  assert_eq time.unix(-1000000000, 123456789).in_zone(loc).format("MST"), "WEST"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1970-01-01T01:00:00+01:00"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 01 Jan 1970 01:00:00 CET"
  assert_eq time.unix(0, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 01 Jan 1970 01:00:00 +0100"
