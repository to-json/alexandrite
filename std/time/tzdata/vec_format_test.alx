  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 11 Jun 2128 19:23:20 +1030"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "11 Jun 28 19:23 +1030"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 11-Jun-28 19:23:20 +1030"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jun 11 19:23:20 +1030 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jun 11 19:23:20 +1030 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("3:04PM MST"), "7:23PM +1030"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2128-06-11T19:23:20.123+1030"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07"), "+10"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07"), "+10"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07:00:00"), "+10:30:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+10:30:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-070000"), "+103000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z070000"), "+103000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("MST"), "+1030"
}

test "format Asia/Kolkata 6" {
  loc = zone("Asia/Kolkata")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-17T01:56:40+05:30"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 17 Aug 1906 01:56:40 IST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 17 Aug 1906 01:56:40 +0530"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "17 Aug 06 01:56 IST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 17-Aug-06 01:56:40 IST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Aug 17 01:56:40 IST 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Aug 17 01:56:40 +0530 1906"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("3:04PM MST"), "1:56AM IST"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "1906-08-17T01:56:40.123+0530"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07"), "+05"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07"), "+05"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-07:00:00"), "+05:30:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+05:30:00"
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("-070000"), "+053000"
