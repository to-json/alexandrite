test "format Pacific/Apia 9" {
  loc = zone("Pacific/Apia")
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Saturday, 19-Jul-36 02:20:00 +13"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Sat Jul 19 02:20:00 +13 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Sat Jul 19 02:20:00 +1300 2036"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("3:04PM MST"), "2:20AM +13"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2036-07-19T02:20:00.123+1300"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07"), "+13"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07"), "+13"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-07:00:00"), "+13:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z07:00:00"), "+13:00:00"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("-070000"), "+130000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("Z070000"), "+130000"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("MST"), "+13"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2128-06-11T21:53:20+13:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 11 Jun 2128 21:53:20 +13"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 11 Jun 2128 21:53:20 +1300"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("02 Jan 06 15:04 MST"), "11 Jun 28 21:53 +13"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 11-Jun-28 21:53:20 +13"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jun 11 21:53:20 +13 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jun 11 21:53:20 +1300 2128"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("3:04PM MST"), "9:53PM +13"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05.000Z0700"), "2128-06-11T21:53:20.123+1300"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07"), "+13"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07"), "+13"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-07:00:00"), "+13:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z07:00:00"), "+13:00:00"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("-070000"), "+130000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("Z070000"), "+130000"
  assert_eq time.unix(5000000000, 123456789).in_zone(loc).format("MST"), "+13"
}

test "format America/Sao_Paulo 10" {
  loc = zone("America/Sao_Paulo")
  assert_eq time.unix(-2000000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "1906-08-16T17:20:12-03:06"
