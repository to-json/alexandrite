  assert_eq time.unix(1700000000, 123456789).in_zone(loc).format("MST"), "IST"
  assert_eq time.unix(2100000000, 123456789).in_zone(loc).format("2006-01-02T15:04:05Z07:00"), "2036-07-18T18:50:00+05:30"
