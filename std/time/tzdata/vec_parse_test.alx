# Generated from Go's time package (go1.27.1, ZONEINFO=lib/time/zoneinfo.zip; a scratch generator); do not edit by hand.

test "parse in America/New_York 0" {
  loc = zone("America/New_York")
  assert_eq pz("2006-01-02 15:04:05 MST", "1918-03-31 01:59:59 EST", loc), "-1633280401 1918-03-31 01:59:59 -05:00:00 EST -18000 America/New_York"
  assert_eq pz("2006-01-02T15:04:05Z07:00", "1918-03-31T01:59:59-05:00", loc), "-1633280401 1918-03-31 01:59:59 -05:00:00 EST -18000 America/New_York"
