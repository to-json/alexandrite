# Generated from Go's time package (go1.27.1, ZONEINFO=lib/time/zoneinfo.zip; a scratch generator); do not edit by hand.

test "zones America/New_York 0" {
  loc = zone("America/New_York")
  assert_eq zs(loc, -100000000000), "-1199-02-15 09:17:18 -04:56:02 LMT|false|0001-01-01 00:00:00 +00:00:00 UTC|1883-11-18 12:00:00 -05:00:00 EST"
  assert_eq zs(loc, -8520336000), "1699-12-31 19:03:58 -04:56:02 LMT|false|0001-01-01 00:00:00 +00:00:00 UTC|1883-11-18 12:00:00 -05:00:00 EST"
