test "zones Australia/Sydney 31" {
  loc = zone("Australia/Sydney")
  assert_eq zs(loc, -100000000000), "-1199-02-16 00:18:12 +10:04:52 LMT|false|0001-01-01 00:00:00 +00:00:00 UTC|1895-01-31 23:55:08 +10:00:00 AEST"
  assert_eq zs(loc, -8520336000), "1700-01-01 10:04:52 +10:04:52 LMT|false|0001-01-01 00:00:00 +00:00:00 UTC|1895-01-31 23:55:08 +10:00:00 AEST"
