# Generated from Go's time package (go run of scratchpad/gen/main.go); do not edit by hand.

test "go duration vectors" {
  assert_eq duration(0).to_s, "0s"
  assert_eq duration(1).to_s, "1ns"
  assert_eq duration(999).to_s, "999ns"
  assert_eq duration(1000).to_s, "1µs"
  assert_eq duration(1500).to_s, "1.5µs"
  assert_eq duration(999999).to_s, "999.999µs"
  assert_eq duration(1000000).to_s, "1ms"
  assert_eq duration(1234567).to_s, "1.234567ms"
  assert_eq duration(999999999).to_s, "999.999999ms"
  assert_eq duration(1000000000).to_s, "1s"
  assert_eq duration(1500000000).to_s, "1.5s"
  assert_eq duration(59000000000).to_s, "59s"
  assert_eq duration(60000000000).to_s, "1m0s"
  assert_eq duration(61000000000).to_s, "1m1s"
  assert_eq duration(90000000000).to_s, "1m30s"
  assert_eq duration(3600000000000).to_s, "1h0m0s"
  assert_eq duration(3660000000000).to_s, "1h1m0s"
  assert_eq duration(7384500000000).to_s, "2h3m4.5s"
  assert_eq duration(360000000000000).to_s, "100h0m0s"
  assert_eq duration(259380500000000).to_s, "72h3m0.5s"
  assert_eq duration(-1).to_s, "-1ns"
  assert_eq duration(-1500).to_s, "-1.5µs"
  assert_eq duration(-1500000).to_s, "-1.5ms"
  assert_eq duration(-1000000000).to_s, "-1s"
  assert_eq duration(-90000000000).to_s, "-1m30s"
  assert_eq duration(-18000000000006).to_s, "-5h0m0.000000006s"
  assert_eq duration(9223372036854775807).to_s, "2562047h47m16.854775807s"
  assert_eq duration(-9223372036854775808).to_s, "-2562047h47m16.854775808s"
  assert_eq duration(1000000000001).to_s, "16m40.000000001s"
  assert_eq duration(3600000000001).to_s, "1h0m0.000000001s"
  assert_eq duration(100000).to_s, "100µs"
  assert_eq duration(10010000).to_s, "10.01ms"
  assert_eq pdur("0"), 0
  assert_eq pdur("1ns"), 1
  assert_eq pdur("1us"), 1000
  assert_eq pdur("1µs"), 1000
  assert_eq pdur("1μs"), 1000
  assert_eq pdur("1ms"), 1000000
  assert_eq pdur("1s"), 1000000000
  assert_eq pdur("1m"), 60000000000
  assert_eq pdur("1h"), 3600000000000
  assert_eq pdur("1.5s"), 1500000000
  assert_eq pdur("-1.5s"), -1500000000
  assert_eq pdur("+2h45m"), 9900000000000
  assert_eq pdur("2h45m30.5s"), 9930500000000
  assert_eq pdur("1h1m1s1ms1us1ns"), 3661001001001
  assert_eq pdur(".5s"), 500000000
  assert_eq pdur("5.s"), 5000000000
  assert_eq pdur("1.s"), 1000000000
  assert_eq pdur("0.000000001s"), 1
  assert_eq pdur("100000h"), 360000000000000000
  assert_eq pdur("-0"), 0
  assert_eq pdur("+0"), 0
  assert_eq pdur("0s"), 0
  assert_eq pdur("9223372036854775807ns"), 9223372036854775807
  assert_eq perr_dur("9223372036854775808ns"), "time: invalid duration \"9223372036854775808ns\""
  assert_eq pdur("2562047h47m16.854775807s"), 9223372036854775807
  assert_eq perr_dur("2562047h47m16.854775808s"), "time: invalid duration \"2562047h47m16.854775808s\""
  assert_eq perr_dur(""), "time: invalid duration \"\""
  assert_eq perr_dur("-"), "time: invalid duration \"-\""
  assert_eq perr_dur("+"), "time: invalid duration \"+\""
  assert_eq perr_dur("s"), "time: invalid duration \"s\""
  assert_eq perr_dur("."), "time: invalid duration \".\""
  assert_eq perr_dur("1"), "time: missing unit in duration \"1\""
  assert_eq perr_dur("1x"), "time: unknown unit \"x\" in duration \"1x\""
  assert_eq perr_dur("1.5"), "time: missing unit in duration \"1.5\""
  assert_eq perr_dur("1h 2m"), "time: unknown unit \"h \" in duration \"1h 2m\""
  assert_eq perr_dur("1h-2m"), "time: unknown unit \"h-\" in duration \"1h-2m\""
  assert_eq perr_dur("--1s"), "time: invalid duration \"--1s\""
  assert_eq perr_dur("1 s"), "time: unknown unit \" s\" in duration \"1 s\""
  assert_eq perr_dur("1s1"), "time: missing unit in duration \"1s1\""
  assert_eq perr_dur("3000000h"), "time: invalid duration \"3000000h\""
  assert_eq pdur("2.5us"), 2500
  assert_eq perr_dur("1e3s"), "time: unknown unit \"e\" in duration \"1e3s\""
  assert_eq perr_dur("1.2.3s"), "time: missing unit in duration \"1.2.3s\""
  assert_eq pdur("0.5h"), 1800000000000
  assert_eq pdur("15m0.3333s"), 900333300000
  assert_eq pdur("1ns1ns"), 2
  assert_eq pdur("1.0000000000000000000000001s"), 1000000000
  assert_eq perr_dur("922337203685.4775807s"), "time: invalid duration \"922337203685.4775807s\""
  assert_eq perr_dur("922337203685.4775808s"), "time: invalid duration \"922337203685.4775808s\""
}

