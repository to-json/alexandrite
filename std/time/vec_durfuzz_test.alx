# Generated from Go's time package (go1.27.1; a scratch generator); do not edit by hand.
# Duration to_s / round / truncate / accessors over random values, and parse_duration of
# well- and ill-formed strings (pd: the nanoseconds or Go's error text).

test "go duration fuzz vectors 0" {
  assert_eq duration(0).to_s, "0s"
  assert_eq pd("0s"), "0"
  assert_eq duration(0).round(duration(1)).ns, 0
  assert_eq duration(0).truncate(duration(1)).ns, 0
  assert_eq duration(0).abs.ns, 0
  assert_eq duration(0).microseconds, 0
  assert_eq duration(0).milliseconds, 0
  assert_eq duration(0).seconds, 0.0
  assert_eq duration(0).minutes, 0.0
  assert_eq duration(0).hours, 0.0
  assert_eq duration(1).to_s, "1ns"
  assert_eq pd("1ns"), "1"
  assert_eq duration(1).round(duration(3)).ns, 0
  assert_eq duration(1).truncate(duration(3)).ns, 0
  assert_eq duration(1).abs.ns, 1
  assert_eq duration(1).microseconds, 0
  assert_eq duration(1).milliseconds, 0
  assert_eq duration(1).seconds, 1e-09
  assert_eq duration(1).minutes, 1.6666666666666667e-11
  assert_eq duration(1).hours, 2.777777777777778e-13
  assert_eq duration(-1).to_s, "-1ns"
  assert_eq pd("-1ns"), "-1"
  assert_eq duration(-1).round(duration(7)).ns, 0
  assert_eq duration(-1).truncate(duration(7)).ns, 0
  assert_eq duration(-1).abs.ns, 1
  assert_eq duration(-1).microseconds, 0
  assert_eq duration(-1).milliseconds, 0
  assert_eq duration(-1).seconds, -1e-09
  assert_eq duration(-1).minutes, -1.6666666666666667e-11
  assert_eq duration(-1).hours, -2.777777777777778e-13
  assert_eq duration(999).to_s, "999ns"
  assert_eq pd("999ns"), "999"
  assert_eq duration(999).round(duration(1000)).ns, 1000
  assert_eq duration(999).truncate(duration(1000)).ns, 0
  assert_eq duration(999).abs.ns, 999
  assert_eq duration(999).microseconds, 0
  assert_eq duration(999).milliseconds, 0
  assert_eq duration(999).seconds, 9.99e-07
  assert_eq duration(999).minutes, 1.665e-08
  assert_eq duration(999).hours, 2.775e-10
  assert_eq duration(1000).to_s, "1µs"
  assert_eq pd("1µs"), "1000"
  assert_eq duration(1000).round(duration(1500000)).ns, 0
  assert_eq duration(1000).truncate(duration(1500000)).ns, 0
  assert_eq duration(1000).abs.ns, 1000
  assert_eq duration(1000).microseconds, 1
  assert_eq duration(1000).milliseconds, 0
  assert_eq duration(1000).seconds, 1e-06
  assert_eq duration(1000).minutes, 1.6666666666666667e-08
  assert_eq duration(1000).hours, 2.7777777777777777e-10
  assert_eq duration(1001).to_s, "1.001µs"
  assert_eq pd("1.001µs"), "1001"
  assert_eq duration(1001).round(duration(1000000000)).ns, 0
  assert_eq duration(1001).truncate(duration(1000000000)).ns, 0
  assert_eq duration(1001).abs.ns, 1001
  assert_eq duration(1001).microseconds, 1
  assert_eq duration(1001).milliseconds, 0
  assert_eq duration(1001).seconds, 1.001e-06
  assert_eq duration(1001).minutes, 1.6683333333333334e-08
  assert_eq duration(1001).hours, 2.7805555555555556e-10
  assert_eq duration(999999).to_s, "999.999µs"
  assert_eq pd("999.999µs"), "999999"
  assert_eq duration(999999).round(duration(60000000000)).ns, 0
  assert_eq duration(999999).truncate(duration(60000000000)).ns, 0
  assert_eq duration(999999).abs.ns, 999999
  assert_eq duration(999999).microseconds, 999
