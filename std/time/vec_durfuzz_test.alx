  assert_eq duration(999999).hours, 2.777775e-07
  assert_eq duration(1000000).to_s, "1ms"
  assert_eq pd("1ms"), "1000000"
  assert_eq duration(1000000).round(duration(3600000000000)).ns, 0
  assert_eq duration(1000000).truncate(duration(3600000000000)).ns, 0
  assert_eq duration(1000000).abs.ns, 1000000
  assert_eq duration(1000000).microseconds, 1000
  assert_eq duration(1000000).milliseconds, 1
  assert_eq duration(1000000).seconds, 0.001
  assert_eq duration(1000000).minutes, 1.6666666666666667e-05
  assert_eq duration(1000000).hours, 2.7777777777777776e-07
  assert_eq duration(9223372036854775807).to_s, "2562047h47m16.854775807s"
  assert_eq pd("2562047h47m16.854775807s"), "9223372036854775807"
