  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21:00:57-0"), "error: parsing time \"2010-02-04T21:00:57-0\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"-0\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21:00:57-08:0"), "error: parsing time \"2010-02-04T21:00:57-08:0\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"-08:0\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2:10-02-04T21:00:57-08:00"), "error: parsing time \"2:10-02-04T21:00:57-08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"2:10-02-04T21:00:57-08:00\" as \"2006\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21900:57-08:00"), "error: parsing time \"2010-02-04T21900:57-08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"900:57-08:00\" as \":\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21+00:57-08:00"), "error: parsing time \"2010-02-04T21+00:57-08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"+00:57-08:00\" as \":\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "200-02-04T21:00:57-08:00"), "error: parsing time \"200-02-04T21:00:57-08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"200-02-04T21:00:57-08:00\" as \"2006\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21:0a:57-08:00"), "error: parsing time \"2010-02-04T21:0a:57-08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"0a:57-08:00\" as \"04\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21:00:57-08Z00"), "error: parsing time \"2010-02-04T21:00:57-08Z00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"-08Z00\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010 02-04T21:00:57-08:00"), "error: parsing time \"2010 02-04T21:00:57-08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \" 02-04T21:00:57-08:00\" as \"-\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21:00:57-08:90"), "error: parsing time \"2010-02-04T21:00:57-08:90\": time zone offset minute out of range"
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21:00:57a08:00"), "error: parsing time \"2010-02-04T21:00:57a08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"a08:00\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-0.T21:00:57-08:00"), "error: parsing time \"2010-02-0.T21:00:57-08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"0.T21:00:57-08:00\" as \"02\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T01:00:57-08:00"), "1265274057 0 -28800"
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2 10-02-04T21:00:57-08:00"), "error: parsing time \"2 10-02-04T21:00:57-08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"2 10-02-04T21:00:57-08:00\" as \"2006\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-0Z-04T21:00:57-08:00"), "error: parsing time \"2010-0Z-04T21:00:57-08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"0Z-04T21:00:57-08:00\" as \"01\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02--4T21:00:57-08:00"), "error: parsing time \"2010-02--4T21:00:57-08:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"-4T21:00:57-08:00\" as \"02\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21:00:57-08:00 extra"), "error: parsing time \"2010-02-04T21:00:57-08:00 extra\": extra text: \" extra\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21:00:57-08:000"), "error: parsing time \"2010-02-04T21:00:57-08:000\": extra text: \"0\""
  assert_eq pok("2006-01-02T15:04:05Z07:00", "1999-12-31T09:05:07+05:30"), "946611307 0 19800"
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2024-02-29T12:00:00Z"), "1709208000 0 0"
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.012345678-08:00"), "1265346057 12345678 -28800"
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", ""), "error: parsing time \"\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"\" as \"2006\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "201"), "error: parsing time \"201\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"201\" as \"2006\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-0"), "error: parsing time \"2010-0\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"0\" as \"01\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-0"), "error: parsing time \"2010-02-0\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"0\" as \"02\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T2"), "error: parsing time \"2010-02-04T2\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"\" as \":\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:0"), "error: parsing time \"2010-02-04T21:0\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"0\" as \"04\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:5"), "error: parsing time \"2010-02-04T21:00:5\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"5\" as \"05\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.0"), "error: parsing time \"2010-02-04T21:00:57.0\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.0123"), "error: parsing time \"2010-02-04T21:00:57.0123\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.0123456"), "error: parsing time \"2010-02-04T21:00:57.0123456\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.012345678-"), "error: parsing time \"2010-02-04T21:00:57.012345678-\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"-\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.012345678-08:"), "error: parsing time \"2010-02-04T21:00:57.012345678-08:\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"-08:\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.012345670-08:00"), "1265346057 12345670 -28800"
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.01234567+-08:00"), "error: parsing time \"2010-02-04T21:00:57.01234567+-08:00\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"+-08:00\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:90:57.012345678-08:00"), "error: parsing time \"2010-02-04T21:90:57.012345678-08:00\": minute out of range"
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010x02-04T21:00:57.012345678-08:00"), "error: parsing time \"2010x02-04T21:00:57.012345678-08:00\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"x02-04T21:00:57.012345678-08:00\" as \"-\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.0123456:8-08:00"), "error: parsing time \"2010-02-04T21:00:57.0123456:8-08:00\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \":8-08:00\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-+2-04T21:00:57.012345678-08:00"), "error: parsing time \"2010-+2-04T21:00:57.012345678-08:00\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"+2-04T21:00:57.012345678-08:00\" as \"01\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.012345678-Z8:00"), "error: parsing time \"2010-02-04T21:00:57.012345678-Z8:00\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"-Z8:00\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.012345678-08:-0"), "error: parsing time \"2010-02-04T21:00:57.012345678-08:-0\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"-08:-0\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.912345678-08:00"), "1265346057 912345678 -28800"
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21+00:57.012345678-08:00"), "error: parsing time \"2010-02-04T21+00:57.012345678-08:00\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"+00:57.012345678-08:00\" as \":\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.01234.678-08:00"), "error: parsing time \"2010-02-04T21:00:57.01234.678-08:00\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \".678-08:00\" as \"Z07:00\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:.7.012345678-08:00"), "error: parsing time \"2010-02-04T21:00:.7.012345678-08:00\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \".7.012345678-08:00\" as \"05\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "20:0-02-04T21:00:57.012345678-08:00"), "error: parsing time \"20:0-02-04T21:00:57.012345678-08:00\" as \"2006-01-02T15:04:05.999999999Z07:00\": cannot parse \"20:0-02-04T21:00:57.012345678-08:00\" as \"2006\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.012345678-08:00 extra"), "error: parsing time \"2010-02-04T21:00:57.012345678-08:00 extra\": extra text: \" extra\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2010-02-04T21:00:57.012345678-08:000"), "error: parsing time \"2010-02-04T21:00:57.012345678-08:000\": extra text: \"0\""
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "1999-12-31T09:05:07+05:30"), "946611307 0 19800"
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2024-02-29T12:00:00.999Z"), "1709208000 999000000 0"
  assert_eq pok("3:04PM", "9:00PM"), "-62167143600 0 0"
  assert_eq pok("3:04PM", ""), "error: parsing time \"\" as \"3:04PM\": cannot parse \"\" as \"3\""
  assert_eq pok("3:04PM", "9:0"), "error: parsing time \"9:0\" as \"3:04PM\": cannot parse \"0\" as \"04\""
  assert_eq pok("3:04PM", "9:00aM"), "error: parsing time \"9:00aM\" as \"3:04PM\": cannot parse \"aM\" as \"PM\""
  assert_eq pok("3:04PM", "9:00ZM"), "error: parsing time \"9:00ZM\" as \"3:04PM\": cannot parse \"ZM\" as \"PM\""
  assert_eq pok("3:04PM", "x:00PM"), "error: parsing time \"x:00PM\" as \"3:04PM\": cannot parse \"x:00PM\" as \"3\""
  assert_eq pok("3:04PM", "9: 0PM"), "error: parsing time \"9: 0PM\" as \"3:04PM\": cannot parse \" 0PM\" as \"04\""
  assert_eq pok("3:04PM", "9:09PM"), "-62167143060 0 0"
  assert_eq pok("3:04PM", ".:00PM"), "error: parsing time \".:00PM\" as \"3:04PM\": cannot parse \".:00PM\" as \"3\""
  assert_eq pok("3:04PM", "9:00P."), "error: parsing time \"9:00P.\" as \"3:04PM\": cannot parse \"P.\" as \"PM\""
  assert_eq pok("3:04PM", "9:00P-"), "error: parsing time \"9:00P-\" as \"3:04PM\": cannot parse \"P-\" as \"PM\""
  assert_eq pok("3:04PM", "9:-0PM"), "error: parsing time \"9:-0PM\" as \"3:04PM\": cannot parse \"-0PM\" as \"04\""
  assert_eq pok("3:04PM", "9:00P"), "error: parsing time \"9:00P\" as \"3:04PM\": cannot parse \"P\" as \"PM\""
  assert_eq pok("3:04PM", "9:009M"), "error: parsing time \"9:009M\" as \"3:04PM\": cannot parse \"9M\" as \"PM\""
  assert_eq pok("3:04PM", "9Z00PM"), "error: parsing time \"9Z00PM\" as \"3:04PM\": cannot parse \"Z00PM\" as \":\""
  assert_eq pok("3:04PM", "9:90PM"), "error: parsing time \"9:90PM\": minute out of range"
  assert_eq pok("3:04PM", " :00PM"), "error: parsing time \" :00PM\" as \"3:04PM\": cannot parse \" :00PM\" as \"3\""
  assert_eq pok("3:04PM", "9:00PM extra"), "error: parsing time \"9:00PM extra\": extra text: \" extra\""
  assert_eq pok("3:04PM", "9:00PM0"), "error: parsing time \"9:00PM0\": extra text: \"0\""
  assert_eq pok("3:04PM", "9:05AM"), "-62167186500 0 0"
  assert_eq pok("3:04PM", "12:00PM"), "-62167176000 0 0"
  assert_eq pok("Jan _2 15:04:05", "Feb  4 21:00:57"), "-62164205943 0 0"
  assert_eq pok("Jan _2 15:04:05", ""), "error: parsing time \"\" as \"Jan _2 15:04:05\": cannot parse \"\" as \"Jan\""
  assert_eq pok("Jan _2 15:04:05", "Feb"), "error: parsing time \"Feb\" as \"Jan _2 15:04:05\": cannot parse \"\" as \"_2\""
  assert_eq pok("Jan _2 15:04:05", "Feb  4"), "error: parsing time \"Feb  4\" as \"Jan _2 15:04:05\": cannot parse \"\" as \"15\""
}

test "go parse error vectors 3" {
  assert_eq pok("Jan _2 15:04:05", "Feb  4 21"), "error: parsing time \"Feb  4 21\" as \"Jan _2 15:04:05\": cannot parse \"\" as \":\""
  assert_eq pok("Jan _2 15:04:05", "Feb  4 21:00"), "error: parsing time \"Feb  4 21:00\" as \"Jan _2 15:04:05\": cannot parse \"\" as \":\""
  assert_eq pok("Jan _2 15:04:05", "-eb  4 21:00:57"), "error: parsing time \"-eb  4 21:00:57\" as \"Jan _2 15:04:05\": cannot parse \"-eb  4 21:00:57\" as \"Jan\""
  assert_eq pok("Jan _2 15:04:05", "Feb  4 21:0057"), "error: parsing time \"Feb  4 21:0057\" as \"Jan _2 15:04:05\": cannot parse \"57\" as \":\""
  assert_eq pok("Jan _2 15:04:05", ":eb  4 21:00:57"), "error: parsing time \":eb  4 21:00:57\" as \"Jan _2 15:04:05\": cannot parse \":eb  4 21:00:57\" as \"Jan\""
  assert_eq pok("Jan _2 15:04:05", "F+b  4 21:00:57"), "error: parsing time \"F+b  4 21:00:57\" as \"Jan _2 15:04:05\": cannot parse \"F+b  4 21:00:57\" as \"Jan\""
  assert_eq pok("Jan _2 15:04:05", "FZb  4 21:00:57"), "error: parsing time \"FZb  4 21:00:57\" as \"Jan _2 15:04:05\": cannot parse \"FZb  4 21:00:57\" as \"Jan\""
  assert_eq pok("Jan _2 15:04:05", "Feb  4 01:00:57"), "-62164277943 0 0"
  assert_eq pok("Jan _2 15:04:05", "Fex  4 21:00:57"), "error: parsing time \"Fex  4 21:00:57\" as \"Jan _2 15:04:05\": cannot parse \"Fex  4 21:00:57\" as \"Jan\""
  assert_eq pok("Jan _2 15:04:05", "Feb  4 21:+0:57"), "error: parsing time \"Feb  4 21:+0:57\" as \"Jan _2 15:04:05\": cannot parse \"+0:57\" as \"04\""
  assert_eq pok("Jan _2 15:04:05", "Feb  4 21 00:57"), "error: parsing time \"Feb  4 21 00:57\" as \"Jan _2 15:04:05\": cannot parse \" 00:57\" as \":\""
  assert_eq pok("Jan _2 15:04:05", "Fab  4 21:00:57"), "error: parsing time \"Fab  4 21:00:57\" as \"Jan _2 15:04:05\": cannot parse \"Fab  4 21:00:57\" as \"Jan\""
  assert_eq pok("Jan _2 15:04:05", "Feb  4921:00:57"), "error: parsing time \"Feb  4921:00:57\" as \"Jan _2 15:04:05\": cannot parse \"21:00:57\" as \" \""
  assert_eq pok("Jan _2 15:04:05", "Feb  + 21:00:57"), "error: parsing time \"Feb  + 21:00:57\" as \"Jan _2 15:04:05\": cannot parse \"+ 21:00:57\" as \"_2\""
  assert_eq pok("Jan _2 15:04:05", "Feb  4 1:00:57"), "-62164277943 0 0"
  assert_eq pok("Jan _2 15:04:05", "Feb  4 21:00:57 extra"), "error: parsing time \"Feb  4 21:00:57 extra\": extra text: \" extra\""
  assert_eq pok("Jan _2 15:04:05", "Feb  4 21:00:570"), "error: parsing time \"Feb  4 21:00:570\": extra text: \"0\""
  assert_eq pok("Jan _2 15:04:05", "Dec 31 09:05:07"), "-62135650493 0 0"
  assert_eq pok("Jan _2 15:04:05", "Feb 29 12:00:00"), "-62162078400 0 0"
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:57.012"), "-62164205943 12000000 0"
  assert_eq pok("Jan _2 15:04:05.000", ""), "error: parsing time \"\" as \"Jan _2 15:04:05.000\": cannot parse \"\" as \"Jan\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb"), "error: parsing time \"Feb\" as \"Jan _2 15:04:05.000\": cannot parse \"\" as \"_2\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4"), "error: parsing time \"Feb  4\" as \"Jan _2 15:04:05.000\": cannot parse \"\" as \"15\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21"), "error: parsing time \"Feb  4 21\" as \"Jan _2 15:04:05.000\": cannot parse \"\" as \":\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00"), "error: parsing time \"Feb  4 21:00\" as \"Jan _2 15:04:05.000\": cannot parse \"\" as \":\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:57"), "error: parsing time \"Feb  4 21:00:57\" as \"Jan _2 15:04:05.000\": cannot parse \"\" as \".000\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:57.01"), "error: parsing time \"Feb  4 21:00:57.01\" as \"Jan _2 15:04:05.000\": cannot parse \".01\" as \".000\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:5..012"), "error: parsing time \"Feb  4 21:00:5..012\" as \"Jan _2 15:04:05.000\": cannot parse \"5..012\" as \"05\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4021:00:57.012"), "error: parsing time \"Feb  4021:00:57.012\" as \"Jan _2 15:04:05.000\": cannot parse \"21:00:57.012\" as \" \""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:59.012"), "-62164205941 12000000 0"
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:57.0:2"), "error: parsing time \"Feb  4 21:00:57.0:2\" as \"Jan _2 15:04:05.000\": cannot parse \".0:2\" as \".000\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:57.019"), "-62164205943 19000000 0"
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 2-:00:57.012"), "error: parsing time \"Feb  4 2-:00:57.012\" as \"Jan _2 15:04:05.000\": cannot parse \"-:00:57.012\" as \":\""
  assert_eq pok("Jan _2 15:04:05.000", "-eb  4 21:00:57.012"), "error: parsing time \"-eb  4 21:00:57.012\" as \"Jan _2 15:04:05.000\": cannot parse \"-eb  4 21:00:57.012\" as \"Jan\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:5-.012"), "error: parsing time \"Feb  4 21:00:5-.012\" as \"Jan _2 15:04:05.000\": cannot parse \"5-.012\" as \"05\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:5 .012"), "error: parsing time \"Feb  4 21:00:5 .012\" as \"Jan _2 15:04:05.000\": cannot parse \"5 .012\" as \"05\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:57.0+2"), "error: parsing time \"Feb  4 21:00:57.0+2\" as \"Jan _2 15:04:05.000\": cannot parse \".0+2\" as \".000\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:57.-12"), "error: parsing time \"Feb  4 21:00:57.-12\": fractional second out of range"
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:+7.012"), "error: parsing time \"Feb  4 21:00:+7.012\" as \"Jan _2 15:04:05.000\": cannot parse \"+7.012\" as \"05\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21::0:57.012"), "error: parsing time \"Feb  4 21::0:57.012\" as \"Jan _2 15:04:05.000\": cannot parse \":0:57.012\" as \"04\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:57.012 extra"), "error: parsing time \"Feb  4 21:00:57.012 extra\": extra text: \" extra\""
  assert_eq pok("Jan _2 15:04:05.000", "Feb  4 21:00:57.0120"), "error: parsing time \"Feb  4 21:00:57.0120\": extra text: \"0\""
  assert_eq pok("Jan _2 15:04:05.000", "Dec 31 09:05:07.000"), "-62135650493 0 0"
  assert_eq pok("Jan _2 15:04:05.000", "Feb 29 12:00:00.999"), "-62162078400 999000000 0"
  assert_eq pok("Jan _2 15:04:05.000000", "Feb  4 21:00:57.012345"), "-62164205943 12345000 0"
  assert_eq pok("Jan _2 15:04:05.000000", ""), "error: parsing time \"\" as \"Jan _2 15:04:05.000000\": cannot parse \"\" as \"Jan\""
