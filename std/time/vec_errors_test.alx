  assert_eq pok("Mon, 02 Jan 2006 15:04:05 MST", "Thu, 04 Feb 2010 21:00:57 PST0"), "error: parsing time \"Thu, 04 Feb 2010 21:00:57 PST0\": extra text: \"0\""
