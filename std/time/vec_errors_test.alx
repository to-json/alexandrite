  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Thu Feb  4 21:00:57 PST 201"), "error: parsing time \"Thu Feb  4 21:00:57 PST 201\" as \"Mon Jan _2 15:04:05 MST 2006\": cannot parse \"201\" as \"2006\""
