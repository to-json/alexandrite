  assert_eq pok("Jan _2 15:04:05.000000000", "Feb  4 21:00:57.012345078"), "-62164205943 12345078 0"
  assert_eq pok("Jan _2 15:04:05.000000000", "Feb  4 21:00:50.012345678"), "-62164205950 12345678 0"
