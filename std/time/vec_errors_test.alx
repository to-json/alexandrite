test "go parse error vectors 1" {
  assert_eq pok("02 Jan 06 15:04 MST", "04 Feb 1. 21:00 PST"), "error: parsing time \"04 Feb 1. 21:00 PST\" as \"02 Jan 06 15:04 MST\": cannot parse \"1. 21:00 PST\" as \"06\""
  assert_eq pok("02 Jan 06 15:04 MST", "04 Feb 10 21:00 -ST"), "error: parsing time \"04 Feb 10 21:00 -ST\" as \"02 Jan 06 15:04 MST\": cannot parse \"-ST\" as \"MST\""
  assert_eq pok("02 Jan 06 15:04 MST", "04 Feb 10 21:00 PST extra"), "error: parsing time \"04 Feb 10 21:00 PST extra\": extra text: \" extra\""
  assert_eq pok("02 Jan 06 15:04 MST", "04 Feb 10 21:00 PST0"), "error: parsing time \"04 Feb 10 21:00 PST0\": extra text: \"0\""
  assert_eq pok("02 Jan 06 15:04 MST", "31 Dec 99 09:05 +0530"), "error: parsing time \"31 Dec 99 09:05 +0530\" as \"02 Jan 06 15:04 MST\": cannot parse \"+0530\" as \"MST\""
  assert_eq pok("02 Jan 06 15:04 MST", "29 Feb 24 12:00 UTC"), "1709208000 0 0"
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb 10 21:00 -0800"), "1265346000 0 -28800"
  assert_eq pok("02 Jan 06 15:04 -0700", ""), "error: parsing time \"\" as \"02 Jan 06 15:04 -0700\": cannot parse \"\" as \"02\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 "), "error: parsing time \"04 \" as \"02 Jan 06 15:04 -0700\": cannot parse \"\" as \"Jan\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb"), "error: parsing time \"04 Feb\" as \"02 Jan 06 15:04 -0700\": cannot parse \"\" as \"06\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb 10"), "error: parsing time \"04 Feb 10\" as \"02 Jan 06 15:04 -0700\": cannot parse \"\" as \"15\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb 10 21"), "error: parsing time \"04 Feb 10 21\" as \"02 Jan 06 15:04 -0700\": cannot parse \"\" as \":\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb 10 21:00"), "error: parsing time \"04 Feb 10 21:00\" as \"02 Jan 06 15:04 -0700\": cannot parse \"\" as \"-0700\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb 10 21:00 -0"), "error: parsing time \"04 Feb 10 21:00 -0\" as \"02 Jan 06 15:04 -0700\": cannot parse \"-0\" as \"-0700\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb 10 21:00--0800"), "error: parsing time \"04 Feb 10 21:00--0800\" as \"02 Jan 06 15:04 -0700\": cannot parse \"--0800\" as \" \""
  assert_eq pok("02 Jan 06 15:04 -0700", "0: Feb 10 21:00 -0800"), "error: parsing time \"0: Feb 10 21:00 -0800\" as \"02 Jan 06 15:04 -0700\": cannot parse \"0: Feb 10 21:00 -0800\" as \"02\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb 10 21:00 -0809"), "1265346540 0 -29340"
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb 10 2+:00 -0800"), "error: parsing time \"04 Feb 10 2+:00 -0800\" as \"02 Jan 06 15:04 -0700\": cannot parse \"+:00 -0800\" as \":\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb 10 21:00 -+800"), "error: parsing time \"04 Feb 10 21:00 -+800\" as \"02 Jan 06 15:04 -0700\": cannot parse \"-+800\" as \"-0700\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Zeb 10 21:00 -0800"), "error: parsing time \"04 Zeb 10 21:00 -0800\" as \"02 Jan 06 15:04 -0700\": cannot parse \"Zeb 10 21:00 -0800\" as \"Jan\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb a0 21:00 -0800"), "error: parsing time \"04 Feb a0 21:00 -0800\" as \"02 Jan 06 15:04 -0700\": cannot parse \"a0 21:00 -0800\" as \"06\""
  assert_eq pok("02 Jan 06 15:04 -0700", "04 Feb x0 21:00 -0800"), "error: parsing time \"04 Feb x0 21:00 -0800\" as \"02 Jan 06 15:04 -0700\": cannot parse \"x0 21:00 -0800\" as \"06\""
