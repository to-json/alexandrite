  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02-04 21:00:+7.012 -08:00:00"), "error: parsing time \"2010-02-04 21:00:+7.012 -08:00:00\" as \"2006-01-02 15:04:05.000 -07:00:00\": cannot parse \"+7.012 -08:00:00\" as \"05\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02-04 21:00:57.0Z2 -08:00:00"), "error: parsing time \"2010-02-04 21:00:57.0Z2 -08:00:00\" as \"2006-01-02 15:04:05.000 -07:00:00\": cannot parse \".0Z2 -08:00:00\" as \".000\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02-04 21:0+:57.012 -08:00:00"), "error: parsing time \"2010-02-04 21:0+:57.012 -08:00:00\" as \"2006-01-02 15:04:05.000 -07:00:00\": cannot parse \"0+:57.012 -08:00:00\" as \"04\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02-04 21:00:57.012 -08:00:.0"), "error: parsing time \"2010-02-04 21:00:57.012 -08:00:.0\" as \"2006-01-02 15:04:05.000 -07:00:00\": cannot parse \"-08:00:.0\" as \"-07:00:00\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02-04 21:00:57.012 -08:00a00"), "error: parsing time \"2010-02-04 21:00:57.012 -08:00a00\" as \"2006-01-02 15:04:05.000 -07:00:00\": cannot parse \"-08:00a00\" as \"-07:00:00\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-0Z-04 21:00:57.012 -08:00:00"), "error: parsing time \"2010-0Z-04 21:00:57.012 -08:00:00\" as \"2006-01-02 15:04:05.000 -07:00:00\": cannot parse \"0Z-04 21:00:57.012 -08:00:00\" as \"01\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02-04 21:00:57.012 -08:0:00"), "error: parsing time \"2010-02-04 21:00:57.012 -08:0:00\" as \"2006-01-02 15:04:05.000 -07:00:00\": cannot parse \"-08:0:00\" as \"-07:00:00\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02904 21:00:57.012 -08:00:00"), "error: parsing time \"2010-02904 21:00:57.012 -08:00:00\" as \"2006-01-02 15:04:05.000 -07:00:00\": cannot parse \"904 21:00:57.012 -08:00:00\" as \"-\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02-04 2::00:57.012 -08:00:00"), "error: parsing time \"2010-02-04 2::00:57.012 -08:00:00\" as \"2006-01-02 15:04:05.000 -07:00:00\": cannot parse \":00:57.012 -08:00:00\" as \"04\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02-04 21:00:57.012 -08:00Z00"), "error: parsing time \"2010-02-04 21:00:57.012 -08:00Z00\" as \"2006-01-02 15:04:05.000 -07:00:00\": cannot parse \"-08:00Z00\" as \"-07:00:00\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02-04 21:00:57.012 -08:00:00 extra"), "error: parsing time \"2010-02-04 21:00:57.012 -08:00:00 extra\": extra text: \" extra\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2010-02-04 21:00:57.012 -08:00:000"), "error: parsing time \"2010-02-04 21:00:57.012 -08:00:000\": extra text: \"0\""
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "1999-12-31 09:05:07.000 +05:30:00"), "946611307 0 19800"
  assert_eq pok("2006-01-02 15:04:05.000 -07:00:00", "2024-02-29 12:00:00.999 +00:00:00"), "1709208000 999000000 0"
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.012pm -0800"), "1265346057 12000000 -28800"
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", ""), "error: parsing time \"\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"\" as \"Jan\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb"), "error: parsing time \"Feb\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"\" as \"_2\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4"), "error: parsing time \"Feb  4\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"\" as \"002\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 03"), "error: parsing time \"Feb  4 03\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"03\" as \"002\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2"), "error: parsing time \"Feb  4 035 2\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"2\" as \"2006\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010"), "error: parsing time \"Feb  4 035 2010\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"\" as \"3\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:"), "error: parsing time \"Feb  4 035 2010 9:\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"\" as \"04\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:"), "error: parsing time \"Feb  4 035 2010 9:00:\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"\" as \"05\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57."), "error: parsing time \"Feb  4 035 2010 9:00:57.\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \".\" as \"pm\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.012"), "error: parsing time \"Feb  4 035 2010 9:00:57.012\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"\" as \"pm\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.012pm "), "error: parsing time \"Feb  4 035 2010 9:00:57.012pm \" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"\" as \"Z0700\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.012pm -08"), "error: parsing time \"Feb  4 035 2010 9:00:57.012pm -08\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"-08\" as \"Z0700\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.Z12pm -0800"), "error: parsing time \"Feb  4 035 2010 9:00:57.Z12pm -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \".Z12pm -0800\" as \"pm\""
}

test "go parse error vectors 5" {
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.012pm -a800"), "error: parsing time \"Feb  4 035 2010 9:00:57.012pm -a800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"-a800\" as \"Z0700\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Fea  4 035 2010 9:00:57.012pm -0800"), "error: parsing time \"Fea  4 035 2010 9:00:57.012pm -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"Fea  4 035 2010 9:00:57.012pm -0800\" as \"Jan\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "F0b  4 035 2010 9:00:57.012pm -0800"), "error: parsing time \"F0b  4 035 2010 9:00:57.012pm -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"F0b  4 035 2010 9:00:57.012pm -0800\" as \"Jan\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.012pZ -0800"), "error: parsing time \"Feb  4 035 2010 9:00:57.012pZ -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"pZ -0800\" as \"pm\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4.035 2010 9:00:57.012pm -0800"), "error: parsing time \"Feb  4.035 2010 9:00:57.012pm -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \".035 2010 9:00:57.012pm -0800\" as \" \""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.012pm -0000"), "1265317257 12000000 0"
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.012 m -0800"), "error: parsing time \"Feb  4 035 2010 9:00:57.012 m -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \" m -0800\" as \"pm\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 20a0 9:00:57.012pm -0800"), "error: parsing time \"Feb  4 035 20a0 9:00:57.012pm -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"20a0 9:00:57.012pm -0800\" as \"2006\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00Z57.012pm -0800"), "error: parsing time \"Feb  4 035 2010 9:00Z57.012pm -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"Z57.012pm -0800\" as \":\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2-10 9:00:57.012pm -0800"), "error: parsing time \"Feb  4 035 2-10 9:00:57.012pm -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"2-10 9:00:57.012pm -0800\" as \"2006\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 201a 9:00:57.012pm -0800"), "error: parsing time \"Feb  4 035 201a 9:00:57.012pm -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \"201a 9:00:57.012pm -0800\" as \"2006\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb. 4 035 2010 9:00:57.012pm -0800"), "error: parsing time \"Feb. 4 035 2010 9:00:57.012pm -0800\" as \"Jan _2 002 2006 3:04:05.999pm Z0700\": cannot parse \". 4 035 2010 9:00:57.012pm -0800\" as \" \""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.012pm -0800 extra"), "error: parsing time \"Feb  4 035 2010 9:00:57.012pm -0800 extra\": extra text: \" extra\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb  4 035 2010 9:00:57.012pm -08000"), "error: parsing time \"Feb  4 035 2010 9:00:57.012pm -08000\": extra text: \"0\""
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Dec 31 365 1999 9:05:07am +0530"), "946611307 0 19800"
  assert_eq pok("Jan _2 002 2006 3:04:05.999pm Z0700", "Feb 29 060 2024 12:00:00.999pm Z"), "1709208000 999000000 0"
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:0:57 PM -08"), "1265346057 0 -28800"
  assert_eq pok("06/1/2 _3:4:5 PM -07", ""), "error: parsing time \"\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"\" as \"06\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/"), "error: parsing time \"10/\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"\" as \"1\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4"), "error: parsing time \"10/2/4\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"\" as \" _\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9"), "error: parsing time \"10/2/4 _9\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"\" as \":\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:0:"), "error: parsing time \"10/2/4 _9:0:\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"\" as \"5\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:0:57 "), "error: parsing time \"10/2/4 _9:0:57 \" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"\" as \"PM\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:0:57 PM "), "error: parsing time \"10/2/4 _9:0:57 PM \" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"\" as \"-07\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/- _9:0:57 PM -08"), "error: parsing time \"10/2/- _9:0:57 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"- _9:0:57 PM -08\" as \"2\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9: :57 PM -08"), "error: parsing time \"10/2/4 _9: :57 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \" :57 PM -08\" as \"4\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:057 PM -08"), "error: parsing time \"10/2/4 _9:057 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"7 PM -08\" as \":\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "1x/2/4 _9:0:57 PM -08"), "error: parsing time \"1x/2/4 _9:0:57 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"1x/2/4 _9:0:57 PM -08\" as \"06\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:0:57 PM 08"), "error: parsing time \"10/2/4 _9:0:57 PM 08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"08\" as \"-07\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _+:0:57 PM -08"), "error: parsing time \"10/2/4 _+:0:57 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"+:0:57 PM -08\" as \"3\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "Z0/2/4 _9:0:57 PM -08"), "error: parsing time \"Z0/2/4 _9:0:57 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"Z0/2/4 _9:0:57 PM -08\" as \"06\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:0:-7 PM -08"), "error: parsing time \"10/2/4 _9:0:-7 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"-7 PM -08\" as \"5\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "1./2/4 _9:0:57 PM -08"), "error: parsing time \"1./2/4 _9:0:57 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"1./2/4 _9:0:57 PM -08\" as \"06\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "a0/2/4 _9:0:57 PM -08"), "error: parsing time \"a0/2/4 _9:0:57 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"a0/2/4 _9:0:57 PM -08\" as \"06\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:0.57 PM -08"), "error: parsing time \"10/2/4 _9:0.57 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \".57 PM -08\" as \":\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9::57 PM -08"), "error: parsing time \"10/2/4 _9::57 PM -08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \":57 PM -08\" as \"4\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:0:57 PMa-08"), "error: parsing time \"10/2/4 _9:0:57 PMa-08\" as \"06/1/2 _3:4:5 PM -07\": cannot parse \"a-08\" as \" \""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:0:57 PM -08 extra"), "error: parsing time \"10/2/4 _9:0:57 PM -08 extra\": extra text: \" extra\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "10/2/4 _9:0:57 PM -080"), "error: parsing time \"10/2/4 _9:0:57 PM -080\": extra text: \"0\""
  assert_eq pok("06/1/2 _3:4:5 PM -07", "99/12/31 _9:5:7 AM +05"), "946613107 0 18000"
  assert_eq pok("06/1/2 _3:4:5 PM -07", "24/2/29 _12:0:0 PM +00"), "1709208000 0 0"
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h00m57s -08"), "1265346057 0 -28800"
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", ""), "error: parsing time \"\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"\" as \"Monday\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thu"), "error: parsing time \"Thu\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"Thu\" as \"Monday\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursd"), "error: parsing time \"Thursd\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"Thursd\" as \"Monday\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday,"), "error: parsing time \"Thursday,\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"\" as \"January\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, Fe"), "error: parsing time \"Thursday, Fe\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"Fe\" as \"January\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, Febru"), "error: parsing time \"Thursday, Febru\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"Febru\" as \"January\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February"), "error: parsing time \"Thursday, February\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"\" as \"2\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4,"), "error: parsing time \"Thursday, February 4,\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"\" as \"2006\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 20"), "error: parsing time \"Thursday, February 4, 20\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"20\" as \"2006\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 "), "error: parsing time \"Thursday, February 4, 2010 \" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"\" as \"15\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h"), "error: parsing time \"Thursday, February 4, 2010 21h\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"\" as \"04\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h00m"), "error: parsing time \"Thursday, February 4, 2010 21h00m\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"\" as \"05\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h00m57s"), "error: parsing time \"Thursday, February 4, 2010 21h00m57s\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"\" as \"Z07\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h00m57s -0"), "error: parsing time \"Thursday, February 4, 2010 21h00m57s -0\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"-0\" as \"Z07\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "T.ursday, February 4, 2010 21h00m57s -08"), "error: parsing time \"T.ursday, February 4, 2010 21h00m57s -08\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"T.ursday, February 4, 2010 21h00m57s -08\" as \"Monday\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 9010 21h00m57s -08"), "222163966857 0 -28800"
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h00m57. -08"), "error: parsing time \"Thursday, February 4, 2010 21h00m57. -08\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \". -08\" as \"s \""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h00m57s:-08"), "error: parsing time \"Thursday, February 4, 2010 21h00m57s:-08\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \":-08\" as \"s \""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thuxsday, February 4, 2010 21h00m57s -08"), "error: parsing time \"Thuxsday, February 4, 2010 21h00m57s -08\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"Thuxsday, February 4, 2010 21h00m57s -08\" as \"Monday\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 :1h00m57s -08"), "error: parsing time \"Thursday, February 4, 2010 :1h00m57s -08\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \":1h00m57s -08\" as \"15\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h0am57s -08"), "error: parsing time \"Thursday, February 4, 2010 21h0am57s -08\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"0am57s -08\" as \"04\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thuraday, February 4, 2010 21h00m57s -08"), "error: parsing time \"Thuraday, February 4, 2010 21h00m57s -08\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"Thuraday, February 4, 2010 21h00m57s -08\" as \"Monday\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, Febauary 4, 2010 21h00m57s -08"), "error: parsing time \"Thursday, Febauary 4, 2010 21h00m57s -08\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"Febauary 4, 2010 21h00m57s -08\" as \"January\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2019 21h00m57s -08"), "1549342857 0 -28800"
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h00m57s -0a"), "error: parsing time \"Thursday, February 4, 2010 21h00m57s -0a\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"-0a\" as \"Z07\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h00m57s -+8"), "error: parsing time \"Thursday, February 4, 2010 21h00m57s -+8\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"-+8\" as \"Z07\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4,:2010 21h00m57s -08"), "error: parsing time \"Thursday, February 4,:2010 21h00m57s -08\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \":2010 21h00m57s -08\" as \", \""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursda9, February 4, 2010 21h00m57s -08"), "error: parsing time \"Thursda9, February 4, 2010 21h00m57s -08\" as \"Monday, January 2, 2006 15h04m05s Z07\": cannot parse \"Thursda9, February 4, 2010 21h00m57s -08\" as \"Monday\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h00m57s -08 extra"), "error: parsing time \"Thursday, February 4, 2010 21h00m57s -08 extra\": extra text: \" extra\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 4, 2010 21h00m57s -080"), "error: parsing time \"Thursday, February 4, 2010 21h00m57s -080\": extra text: \"0\""
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Friday, December 31, 1999 09h05m07s +05"), "946613107 0 18000"
  assert_eq pok("Monday, January 2, 2006 15h04m05s Z07", "Thursday, February 29, 2024 12h00m00s Z"), "1709208000 0 0"
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057,012345-080000"), "1265346057 12345000 -28800"
  assert_eq pok("2006-002T150405,000000Z070000", ""), "error: parsing time \"\" as \"2006-002T150405,000000Z070000\": cannot parse \"\" as \"2006\""
  assert_eq pok("2006-002T150405,000000Z070000", "201"), "error: parsing time \"201\" as \"2006-002T150405,000000Z070000\": cannot parse \"201\" as \"2006\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-0"), "error: parsing time \"2010-0\" as \"2006-002T150405,000000Z070000\": cannot parse \"0\" as \"002\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T"), "error: parsing time \"2010-035T\" as \"2006-002T150405,000000Z070000\": cannot parse \"\" as \"15\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210"), "error: parsing time \"2010-035T210\" as \"2006-002T150405,000000Z070000\": cannot parse \"0\" as \"04\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057"), "error: parsing time \"2010-035T210057\" as \"2006-002T150405,000000Z070000\": cannot parse \"\" as \",000000\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057,01"), "error: parsing time \"2010-035T210057,01\" as \"2006-002T150405,000000Z070000\": cannot parse \",01\" as \",000000\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057,01234"), "error: parsing time \"2010-035T210057,01234\" as \"2006-002T150405,000000Z070000\": cannot parse \",01234\" as \",000000\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057,012345-0"), "error: parsing time \"2010-035T210057,012345-0\" as \"2006-002T150405,000000Z070000\": cannot parse \"-0\" as \"Z070000\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057,012345-0800"), "error: parsing time \"2010-035T210057,012345-0800\" as \"2006-002T150405,000000Z070000\": cannot parse \"-0800\" as \"Z070000\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057-012345-080000"), "error: parsing time \"2010-035T210057-012345-080000\" as \"2006-002T150405,000000Z070000\": cannot parse \"-012345-080000\" as \",000000\""
  assert_eq pok("2006-002T150405,000000Z070000", "20x0-035T210057,012345-080000"), "error: parsing time \"20x0-035T210057,012345-080000\" as \"2006-002T150405,000000Z070000\": cannot parse \"20x0-035T210057,012345-080000\" as \"2006\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T910057,012345-080000"), "error: parsing time \"2010-035T910057,012345-080000\": hour out of range"
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057,0:2345-080000"), "error: parsing time \"2010-035T210057,0:2345-080000\" as \"2006-002T150405,000000Z070000\": cannot parse \",0:2345-080000\" as \",000000\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T200057,012345-080000"), "1265342457 12345000 -28800"
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057, 12345-080000"), "error: parsing time \"2010-035T210057, 12345-080000\" as \"2006-002T150405,000000Z070000\": cannot parse \", 12345-080000\" as \",000000\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057,012345-08000"), "error: parsing time \"2010-035T210057,012345-08000\" as \"2006-002T150405,000000Z070000\": cannot parse \"-08000\" as \"Z070000\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057,0.2345-080000"), "error: parsing time \"2010-035T210057,0.2345-080000\" as \"2006-002T150405,000000Z070000\": cannot parse \",0.2345-080000\" as \",000000\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T21005-,012345-080000"), "error: parsing time \"2010-035T21005-,012345-080000\" as \"2006-002T150405,000000Z070000\": cannot parse \"5-,012345-080000\" as \"05\""
  assert_eq pok("2006-002T150405,000000Z070000", "x010-035T210057,012345-080000"), "error: parsing time \"x010-035T210057,012345-080000\" as \"2006-002T150405,000000Z070000\": cannot parse \"x010-035T210057,012345-080000\" as \"2006\""
  assert_eq pok("2006-002T150405,000000Z070000", "2910-035T210057,012345-080000"), "29666581257 12345000 -28800"
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057,012345-080000 extra"), "error: parsing time \"2010-035T210057,012345-080000 extra\": extra text: \" extra\""
  assert_eq pok("2006-002T150405,000000Z070000", "2010-035T210057,012345-0800000"), "error: parsing time \"2010-035T210057,012345-0800000\": extra text: \"0\""
  assert_eq pok("2006-002T150405,000000Z070000", "1999-365T090507,000000+053000"), "946611307 0 19800"
  assert_eq pok("2006-002T150405,000000Z070000", "2024-060T120000,999000Z"), "1709208000 999000000 0"
}

test "go parse error vectors 6" {
  assert_eq pok("__2 2006 MST", " 35 2010 PST"), "1265241600 0 0"
  assert_eq pok("__2 2006 MST", ""), "error: parsing time \"\" as \"__2 2006 MST\": cannot parse \"\" as \"__2\""
  assert_eq pok("__2 2006 MST", " 35"), "error: parsing time \" 35\" as \"__2 2006 MST\": cannot parse \"\" as \"2006\""
  assert_eq pok("__2 2006 MST", " 35 20"), "error: parsing time \" 35 20\" as \"__2 2006 MST\": cannot parse \"20\" as \"2006\""
  assert_eq pok("__2 2006 MST", " 35 2010 "), "error: parsing time \" 35 2010 \" as \"__2 2006 MST\": cannot parse \"\" as \"MST\""
  assert_eq pok("__2 2006 MST", "x35 2010 PST"), "error: parsing time \"x35 2010 PST\" as \"__2 2006 MST\": cannot parse \"x35 2010 PST\" as \"__2\""
  assert_eq pok("__2 2006 MST", " 35 2010 0ST"), "error: parsing time \" 35 2010 0ST\" as \"__2 2006 MST\": cannot parse \"0ST\" as \"MST\""
  assert_eq pok("__2 2006 MST", " 35 20 0 PST"), "error: parsing time \" 35 20 0 PST\" as \"__2 2006 MST\": cannot parse \"20 0 PST\" as \"2006\""
  assert_eq pok("__2 2006 MST", " +5 2010 PST"), "error: parsing time \" +5 2010 PST\" as \"__2 2006 MST\": cannot parse \" +5 2010 PST\" as \"__2\""
  assert_eq pok("__2 2006 MST", " 35 20Z0 PST"), "error: parsing time \" 35 20Z0 PST\" as \"__2 2006 MST\": cannot parse \"20Z0 PST\" as \"2006\""
  assert_eq pok("__2 2006 MST", " 35 9010 PST"), "222163862400 0 0"
  assert_eq pok("__2 2006 MST", " 3. 2010 PST"), "error: parsing time \" 3. 2010 PST\" as \"__2 2006 MST\": cannot parse \". 2010 PST\" as \" \""
  assert_eq pok("__2 2006 MST", " 35 2010xPST"), "error: parsing time \" 35 2010xPST\" as \"__2 2006 MST\": cannot parse \"xPST\" as \" \""
  assert_eq pok("__2 2006 MST", " .5 2010 PST"), "error: parsing time \" .5 2010 PST\" as \"__2 2006 MST\": cannot parse \" .5 2010 PST\" as \"__2\""
  assert_eq pok("__2 2006 MST", ":35 2010 PST"), "error: parsing time \":35 2010 PST\" as \"__2 2006 MST\": cannot parse \":35 2010 PST\" as \"__2\""
  assert_eq pok("__2 2006 MST", " 3- 2010 PST"), "error: parsing time \" 3- 2010 PST\" as \"__2 2006 MST\": cannot parse \"- 2010 PST\" as \" \""
  assert_eq pok("__2 2006 MST", " 35Z2010 PST"), "error: parsing time \" 35Z2010 PST\" as \"__2 2006 MST\": cannot parse \"Z2010 PST\" as \" \""
  assert_eq pok("__2 2006 MST", " 35 2010 PS "), "error: parsing time \" 35 2010 PS \" as \"__2 2006 MST\": cannot parse \"PS \" as \"MST\""
  assert_eq pok("__2 2006 MST", " 35 2010 PST extra"), "error: parsing time \" 35 2010 PST extra\": extra text: \" extra\""
  assert_eq pok("__2 2006 MST", " 35 2010 PST0"), "error: parsing time \" 35 2010 PST0\": extra text: \"0\""
  assert_eq pok("__2 2006 MST", "365 1999 +0530"), "error: parsing time \"365 1999 +0530\" as \"__2 2006 MST\": cannot parse \"+0530\" as \"MST\""
  assert_eq pok("__2 2006 MST", " 60 2024 UTC"), "1709164800 0 0"
  assert_eq pok("2006-01-02", "2023-02-29"), "error: parsing time \"2023-02-29\": day out of range"
  assert_eq pok("2006-01-02", "2024-02-30"), "error: parsing time \"2024-02-30\": day out of range"
  assert_eq pok("2006-01-02", "2023-13-01"), "error: parsing time \"2023-13-01\": month out of range"
  assert_eq pok("2006-01-02", "2023-00-10"), "error: parsing time \"2023-00-10\": month out of range"
  assert_eq pok("2006-01-02", "2023-04-31"), "error: parsing time \"2023-04-31\": day out of range"
  assert_eq pok("2006-01-02", "0000-01-01"), "-62167219200 0 0"
  assert_eq pok("2006-01-02", "9999-12-31"), "253402214400 0 0"
  assert_eq pok("2006-01-02", "2023-1-01"), "error: parsing time \"2023-1-01\" as \"2006-01-02\": cannot parse \"1-01\" as \"01\""
  assert_eq pok("2006-01-02", "20230-01-01"), "error: parsing time \"20230-01-01\" as \"2006-01-02\": cannot parse \"0-01-01\" as \"-\""
  assert_eq pok("15:04:05", "24:00:00"), "error: parsing time \"24:00:00\": hour out of range"
  assert_eq pok("15:04:05", "23:60:00"), "error: parsing time \"23:60:00\": minute out of range"
  assert_eq pok("15:04:05", "23:59:60"), "error: parsing time \"23:59:60\": second out of range"
  assert_eq pok("15:04:05", "-1:00:00"), "error: parsing time \"-1:00:00\" as \"15:04:05\": cannot parse \"-1:00:00\" as \"15\""
  assert_eq pok("15:04:05", "1:2:3"), "error: parsing time \"1:2:3\" as \"15:04:05\": cannot parse \"2:3\" as \"04\""
  assert_eq pok("15:04:05", "01:02:03."), "error: parsing time \"01:02:03.\": extra text: \".\""
  assert_eq pok("15:04:05", "01:02:03.5"), "-62167215477 500000000 0"
  assert_eq pok("15:04:05", "01:02:03,123456789123"), "-62167215477 123456789 0"
}
