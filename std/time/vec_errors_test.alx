  assert_eq pok("Jan _2 15:04:05.000000000", "Feb 29 12:00:00.999000000"), "-62162078400 999000000 0"
  assert_eq pok("2006-01-02 15:04:05", "2010-02-04 21:00:57"), "1265317257 0 0"
  assert_eq pok("2006-01-02 15:04:05", ""), "error: parsing time \"\" as \"2006-01-02 15:04:05\": cannot parse \"\" as \"2006\""
  assert_eq pok("2006-01-02 15:04:05", "201"), "error: parsing time \"201\" as \"2006-01-02 15:04:05\": cannot parse \"201\" as \"2006\""
  assert_eq pok("2006-01-02 15:04:05", "2010-0"), "error: parsing time \"2010-0\" as \"2006-01-02 15:04:05\": cannot parse \"0\" as \"01\""
  assert_eq pok("2006-01-02 15:04:05", "2010-02-0"), "error: parsing time \"2010-02-0\" as \"2006-01-02 15:04:05\": cannot parse \"0\" as \"02\""
  assert_eq pok("2006-01-02 15:04:05", "2010-02-04 2"), "error: parsing time \"2010-02-04 2\" as \"2006-01-02 15:04:05\": cannot parse \"\" as \":\""
}

test "go parse error vectors 4" {
  assert_eq pok("2006-01-02 15:04:05", "2010-02-04 21:0"), "error: parsing time \"2010-02-04 21:0\" as \"2006-01-02 15:04:05\": cannot parse \"0\" as \"04\""
  assert_eq pok("2006-01-02 15:04:05", "2010-02-04 21:00:5"), "error: parsing time \"2010-02-04 21:00:5\" as \"2006-01-02 15:04:05\": cannot parse \"5\" as \"05\""
  assert_eq pok("2006-01-02 15:04:05", "2010-02-04 21:0::57"), "error: parsing time \"2010-02-04 21:0::57\" as \"2006-01-02 15:04:05\": cannot parse \"0::57\" as \"04\""
  assert_eq pok("2006-01-02 15:04:05", "2010-02+04 21:00:57"), "error: parsing time \"2010-02+04 21:00:57\" as \"2006-01-02 15:04:05\": cannot parse \"+04 21:00:57\" as \"-\""
  assert_eq pok("2006-01-02 15:04:05", "2:10-02-04 21:00:57"), "error: parsing time \"2:10-02-04 21:00:57\" as \"2006-01-02 15:04:05\": cannot parse \"2:10-02-04 21:00:57\" as \"2006\""
