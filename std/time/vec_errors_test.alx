# Generated from Go's time package (go1.27.1; a scratch generator); do not edit by hand.
# parse_in_location(layout, value, utc()) of mutated values: the time or Go's error text.

test "go parse error vectors 0" {
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 21:00:57 2010"), "1265317257 0 0"
  assert_eq pok("Mon Jan _2 15:04:05 2006", ""), "error: parsing time \"\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"\" as \"Mon\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu"), "error: parsing time \"Thu\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"\" as \"Jan\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Fe"), "error: parsing time \"Thu Fe\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"Fe\" as \"Jan\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  "), "error: parsing time \"Thu Feb  \" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"\" as \"_2\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 2"), "error: parsing time \"Thu Feb  4 2\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"\" as \":\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 21:0"), "error: parsing time \"Thu Feb  4 21:0\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"0\" as \"04\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 21:00:5"), "error: parsing time \"Thu Feb  4 21:00:5\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"5\" as \"05\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 21:00:57 2"), "error: parsing time \"Thu Feb  4 21:00:57 2\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"2\" as \"2006\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 01:00:57 2010"), "1265245257 0 0"
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 21:00:57 2x10"), "error: parsing time \"Thu Feb  4 21:00:57 2x10\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"2x10\" as \"2006\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu F.b  4 21:00:57 2010"), "error: parsing time \"Thu F.b  4 21:00:57 2010\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"F.b  4 21:00:57 2010\" as \"Jan\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Zeb  4 21:00:57 2010"), "error: parsing time \"Thu Zeb  4 21:00:57 2010\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"Zeb  4 21:00:57 2010\" as \"Jan\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 21:00:57 2+10"), "error: parsing time \"Thu Feb  4 21:00:57 2+10\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"2+10\" as \"2006\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu 0eb  4 21:00:57 2010"), "error: parsing time \"Thu 0eb  4 21:00:57 2010\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"0eb  4 21:00:57 2010\" as \"Jan\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Tha Feb  4 21:00:57 2010"), "error: parsing time \"Tha Feb  4 21:00:57 2010\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"Tha Feb  4 21:00:57 2010\" as \"Mon\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Th Feb  4 21:00:57 2010"), "error: parsing time \"Th Feb  4 21:00:57 2010\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"Th Feb  4 21:00:57 2010\" as \"Mon\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Fex  4 21:00:57 2010"), "error: parsing time \"Thu Fex  4 21:00:57 2010\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"Fex  4 21:00:57 2010\" as \"Jan\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 21:00:5+ 2010"), "error: parsing time \"Thu Feb  4 21:00:5+ 2010\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"5+ 2010\" as \"05\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu aeb  4 21:00:57 2010"), "error: parsing time \"Thu aeb  4 21:00:57 2010\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \"aeb  4 21:00:57 2010\" as \"Jan\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 2 :00:57 2010"), "error: parsing time \"Thu Feb  4 2 :00:57 2010\" as \"Mon Jan _2 15:04:05 2006\": cannot parse \" :00:57 2010\" as \":\""
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Thu Feb  4 91:00:57 2010"), "error: parsing time \"Thu Feb  4 91:00:57 2010\": hour out of range"
