  assert_eq pok("Jan _2 15:04:05.000000000", "Fea  4 21:00:57.012345678"), "error: parsing time \"Fea  4 21:00:57.012345678\" as \"Jan _2 15:04:05.000000000\": cannot parse \"Fea  4 21:00:57.012345678\" as \"Jan\""
  assert_eq pok("Jan _2 15:04:05.000000000", "F:b  4 21:00:57.012345678"), "error: parsing time \"F:b  4 21:00:57.012345678\" as \"Jan _2 15:04:05.000000000\": cannot parse \"F:b  4 21:00:57.012345678\" as \"Jan\""
