  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Thu Feb  4 21:00:57:PST 2010"), "error: parsing time \"Thu Feb  4 21:00:57:PST 2010\" as \"Mon Jan _2 15:04:05 MST 2006\": cannot parse \":PST 2010\" as \" \""
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "9hu Feb  4 21:00:57 PST 2010"), "error: parsing time \"9hu Feb  4 21:00:57 PST 2010\" as \"Mon Jan _2 15:04:05 MST 2006\": cannot parse \"9hu Feb  4 21:00:57 PST 2010\" as \"Mon\""
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Thu Feb  4 21:00:57 ZST 2010"), "1265317257 0 0"
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Thu Feb  4921:00:57 PST 2010"), "error: parsing time \"Thu Feb  4921:00:57 PST 2010\" as \"Mon Jan _2 15:04:05 MST 2006\": cannot parse \"21:00:57 PST 2010\" as \" \""
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Thu Feb 4 21:00:57 PST 2010"), "1265317257 0 0"
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Thu Feb  4 21:00:5: PST 2010"), "error: parsing time \"Thu Feb  4 21:00:5: PST 2010\" as \"Mon Jan _2 15:04:05 MST 2006\": cannot parse \"5: PST 2010\" as \"05\""
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Thu Fe9  4 21:00:57 PST 2010"), "error: parsing time \"Thu Fe9  4 21:00:57 PST 2010\" as \"Mon Jan _2 15:04:05 MST 2006\": cannot parse \"Fe9  4 21:00:57 PST 2010\" as \"Jan\""
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Thu Feb  4+21:00:57 PST 2010"), "error: parsing time \"Thu Feb  4+21:00:57 PST 2010\" as \"Mon Jan _2 15:04:05 MST 2006\": cannot parse \"+21:00:57 PST 2010\" as \" \""
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "T+u Feb  4 21:00:57 PST 2010"), "error: parsing time \"T+u Feb  4 21:00:57 PST 2010\" as \"Mon Jan _2 15:04:05 MST 2006\": cannot parse \"T+u Feb  4 21:00:57 PST 2010\" as \"Mon\""
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Thu Feb  4 21:00:57 PST a010"), "error: parsing time \"Thu Feb  4 21:00:57 PST a010\" as \"Mon Jan _2 15:04:05 MST 2006\": cannot parse \"a010\" as \"2006\""
