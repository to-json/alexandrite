  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 21:00:5"), "error: parsing time \"Thu, 04 Feb 2010 21:00:5\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"5\" as \"05\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 21:00:57 -"), "error: parsing time \"Thu, 04 Feb 2010 21:00:57 -\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"-\" as \"-0700\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 21:00:57 -080"), "error: parsing time \"Thu, 04 Feb 2010 21:00:57 -080\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"-080\" as \"-0700\""
}

test "go parse error vectors 2" {
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Fe9 2010 21:00:57 -0800"), "error: parsing time \"Thu, 04 Fe9 2010 21:00:57 -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"Fe9 2010 21:00:57 -0800\" as \"Jan\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010921:00:57 -0800"), "error: parsing time \"Thu, 04 Feb 2010921:00:57 -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"921:00:57 -0800\" as \" \""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu,Z04 Feb 2010 21:00:57 -0800"), "error: parsing time \"Thu,Z04 Feb 2010 21:00:57 -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"Z04 Feb 2010 21:00:57 -0800\" as \", \""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 201: 21:00:57 -0800"), "error: parsing time \"Thu, 04 Feb 201: 21:00:57 -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"201: 21:00:57 -0800\" as \"2006\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2Z10 21:00:57 -0800"), "error: parsing time \"Thu, 04 Feb 2Z10 21:00:57 -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"2Z10 21:00:57 -0800\" as \"2006\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 21:00:5. -0800"), "error: parsing time \"Thu, 04 Feb 2010 21:00:5. -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"5. -0800\" as \"05\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thua 04 Feb 2010 21:00:57 -0800"), "error: parsing time \"Thua 04 Feb 2010 21:00:57 -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"a 04 Feb 2010 21:00:57 -0800\" as \", \""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 21:00:5 -0800"), "error: parsing time \"Thu, 04 Feb 2010 21:00:5 -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"5 -0800\" as \"05\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 210 21:00:57 -0800"), "error: parsing time \"Thu, 04 Feb 210 21:00:57 -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"210 21:00:57 -0800\" as \"2006\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 21:0Z:57 -0800"), "error: parsing time \"Thu, 04 Feb 2010 21:0Z:57 -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"0Z:57 -0800\" as \"04\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 201. 21:00:57 -0800"), "error: parsing time \"Thu, 04 Feb 201. 21:00:57 -0800\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"201. 21:00:57 -0800\" as \"2006\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 21:00:57 -08 0"), "error: parsing time \"Thu, 04 Feb 2010 21:00:57 -08 0\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"-08 0\" as \"-0700\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 21:00:57 -0-00"), "error: parsing time \"Thu, 04 Feb 2010 21:00:57 -0-00\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"-0-00\" as \"-0700\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 21:00:57 -0800 extra"), "error: parsing time \"Thu, 04 Feb 2010 21:00:57 -0800 extra\": extra text: \" extra\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 21:00:57 -08000"), "error: parsing time \"Thu, 04 Feb 2010 21:00:57 -08000\": extra text: \"0\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Fri, 31 Dec 1999 09:05:07 +0530"), "946611307 0 19800"
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 29 Feb 2024 12:00:00 +0000"), "1709208000 0 0"
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2010-02-04T21:00:57-08:00"), "1265346057 0 -28800"
  assert_eq pok("2006-01-02T15:04:05Z07:00", ""), "error: parsing time \"\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"\" as \"2006\""
