  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 0"), "error: parsing time \"Thu, 0\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"0\" as \"02\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 F"), "error: parsing time \"Thu, 04 F\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"F\" as \"Jan\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb "), "error: parsing time \"Thu, 04 Feb \" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"\" as \"2006\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 201"), "error: parsing time \"Thu, 04 Feb 201\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"201\" as \"2006\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Thu, 04 Feb 2010 2"), "error: parsing time \"Thu, 04 Feb 2010 2\" as \"Mon, 02 Jan 2006 15:04:05 -0700\": cannot parse \"\" as \":\""
