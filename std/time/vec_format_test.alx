  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format("January 02 06 Jan Mon Monday"), "February 29 24 Feb Thu Thursday"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format("Janx Monx Jan1 Mon1 Janu"), "Janx Monx Feb2 Thu2 Janu"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format("5.0 5.9 5,99"), "59.1 59.1 59,12"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format("05.000000 05.9"), "59.123456 59.1"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format("no elements"), "no elements"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format(""), ""
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format("2006 plain 1 text"), "2024 plain 2 text"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format(".9 .99 ,9"), ".1 .12 ,1"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format("15.04"), "23.59"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format("3PM 3pm"), "11PM 11pm"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).format("0 00 000 0002"), "0 00 000 0060"
}

test "go format vectors 1" {
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Mon Jan _2 15:04:05 2006"), "Fri Dec 31 12:00:00 1999"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Dec 31 12:00:00 IST 1999"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Dec 31 12:00:00 +0530 1999"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("02 Jan 06 15:04 MST"), "31 Dec 99 12:00 IST"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("02 Jan 06 15:04 -0700"), "31 Dec 99 12:00 +0530"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 31-Dec-99 12:00:00 IST"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 31 Dec 1999 12:00:00 IST"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 31 Dec 1999 12:00:00 +0530"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("2006-01-02T15:04:05Z07:00"), "1999-12-31T12:00:00+05:30"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("2006-01-02T15:04:05.999999999Z07:00"), "1999-12-31T12:00:00.12+05:30"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("3:04PM"), "12:00PM"
