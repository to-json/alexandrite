  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format("-07:00:00 Z07:00:00 -070000 Z070000 Z07 Z0700"), "-03:30:00 -03:30:00 -033000 -033000 -03 -0330"
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format("January 02 06 Jan Mon Monday"), "July 04 23 Jul Tue Tuesday"
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format("Janx Monx Jan1 Mon1 Janu"), "Janx Monx Jul7 Tue7 Janu"
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format("5.0 5.9 5,99"), "7.0 7 7,07"
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format("05.000000 05.9"), "07.070000 07"
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format("no elements"), "no elements"
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format(""), ""
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format("2006 plain 1 text"), "2023 plain 7 text"
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format(".9 .99 ,9"), " .07 "
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format("15.04"), "09.05"
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format("3PM 3pm"), "9AM 9am"
  assert_eq date(2023, 7, 4, 9, 5, 7, 70000000, fixed_zone("", -12600)).format("0 00 000 0002"), "0 00 000 0185"
}

test "go format vectors 4" {
  assert_eq date(2023, 11, 5, 0, 30, 0, 0, fixed_zone("ACDT", 37803)).format("Mon Jan _2 15:04:05 2006"), "Sun Nov  5 00:30:00 2023"
  assert_eq date(2023, 11, 5, 0, 30, 0, 0, fixed_zone("ACDT", 37803)).format("Mon Jan _2 15:04:05 MST 2006"), "Sun Nov  5 00:30:00 ACDT 2023"
  assert_eq date(2023, 11, 5, 0, 30, 0, 0, fixed_zone("ACDT", 37803)).format("Mon Jan 02 15:04:05 -0700 2006"), "Sun Nov 05 00:30:00 +1030 2023"
  assert_eq date(2023, 11, 5, 0, 30, 0, 0, fixed_zone("ACDT", 37803)).format("02 Jan 06 15:04 MST"), "05 Nov 23 00:30 ACDT"
