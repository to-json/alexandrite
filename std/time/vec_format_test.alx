  assert_eq date(2023, 11, 5, 0, 30, 0, 0, fixed_zone("ACDT", 37803)).format("Monday, 02-Jan-06 15:04:05 MST"), "Sunday, 05-Nov-23 00:30:00 ACDT"
  assert_eq date(2023, 11, 5, 0, 30, 0, 0, fixed_zone("ACDT", 37803)).format("Mon, 02 Jan 2006 15:04:05 MST"), "Sun, 05 Nov 2023 00:30:00 ACDT"
  assert_eq date(2023, 11, 5, 0, 30, 0, 0, fixed_zone("ACDT", 37803)).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Sun, 05 Nov 2023 00:30:00 +1030"
  assert_eq date(2023, 11, 5, 0, 30, 0, 0, fixed_zone("ACDT", 37803)).format("2006-01-02T15:04:05Z07:00"), "2023-11-05T00:30:00+10:30"
  assert_eq date(2023, 11, 5, 0, 30, 0, 0, fixed_zone("ACDT", 37803)).format("2006-01-02T15:04:05.999999999Z07:00"), "2023-11-05T00:30:00+10:30"
