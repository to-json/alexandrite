  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("02/01/06 15h04m05s .000 ,999"), "07/06/45 08h09m10s .000 "
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("Jan 2, 2006 at 3:04pm (MST)"), "Jun 7, 12345 at 8:09am (UTC)"
