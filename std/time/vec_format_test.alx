  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("Jan 2, 2006 at 3:04pm (MST)"), "Dec 31, 1969 at 11:59pm (UTC)"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("2006-01-02T15:04:05.00Z07:00"), "1969-12-31T23:59:59.99Z"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("15:04:05,000000"), "23:59:59,999999"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("2006-01-02 15:04:05 -07"), "1969-12-31 23:59:59 +00"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("-07:00:00 Z07:00:00 -070000 Z070000 Z07 Z0700"), "+00:00:00 Z +000000 Z Z Z"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("January 02 06 Jan Mon Monday"), "December 31 69 Dec Wed Wednesday"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("Janx Monx Jan1 Mon1 Janu"), "Janx Monx Dec12 Wed12 Janu"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("5.0 5.9 5,99"), "59.9 59.9 59,99"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("05.000000 05.9"), "59.999999 59.9"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("no elements"), "no elements"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format(""), ""
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("2006 plain 1 text"), "1969 plain 12 text"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format(".9 .99 ,9"), ".9 .99 ,9"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("15.04"), "23.59"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("3PM 3pm"), "11PM 11pm"
  assert_eq date(1969, 12, 31, 23, 59, 59, 999999999, utc()).format("0 00 000 0002"), "0 00 000 0365"
}

test "go format vectors 2" {
  assert_eq date(1, 1, 1, 0, 0, 0, 0, utc()).format("Mon Jan _2 15:04:05 2006"), "Mon Jan  1 00:00:00 0001"
  assert_eq date(1, 1, 1, 0, 0, 0, 0, utc()).format("Mon Jan _2 15:04:05 MST 2006"), "Mon Jan  1 00:00:00 UTC 0001"
  assert_eq date(1, 1, 1, 0, 0, 0, 0, utc()).format("Mon Jan 02 15:04:05 -0700 2006"), "Mon Jan 01 00:00:00 +0000 0001"
