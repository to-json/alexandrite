  assert_eq date(1, 1, 1, 0, 0, 0, 0, utc()).format("Mon, 02 Jan 2006 15:04:05 MST"), "Mon, 01 Jan 0001 00:00:00 UTC"
  assert_eq date(1, 1, 1, 0, 0, 0, 0, utc()).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Mon, 01 Jan 0001 00:00:00 +0000"
  assert_eq date(1, 1, 1, 0, 0, 0, 0, utc()).format("2006-01-02T15:04:05Z07:00"), "0001-01-01T00:00:00Z"
