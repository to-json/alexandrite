  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).format("5.0 5.9 5,99"), "59.9 59.9 59,99"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).format("05.000000 05.9"), "59.999999 59.9"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).format("no elements"), "no elements"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).format(""), ""
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).format("2006 plain 1 text"), "9999 plain 12 text"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).format(".9 .99 ,9"), ".9 .99 ,9"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).format("15.04"), "23.59"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).format("3PM 3pm"), "11PM 11pm"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).format("0 00 000 0002"), "0 00 000 0365"
}

test "go format vectors 3" {
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("Mon Jan _2 15:04:05 2006"), "Thu Jun  7 08:09:10 12345"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Jun  7 08:09:10 UTC 12345"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Jun 07 08:09:10 +0000 12345"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("02 Jan 06 15:04 MST"), "07 Jun 45 08:09 UTC"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("02 Jan 06 15:04 -0700"), "07 Jun 45 08:09 +0000"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("Monday, 02-Jan-06 15:04:05 MST"), "Thursday, 07-Jun-45 08:09:10 UTC"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 07 Jun 12345 08:09:10 UTC"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 07 Jun 12345 08:09:10 +0000"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("2006-01-02T15:04:05Z07:00"), "12345-06-07T08:09:10Z"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("2006-01-02T15:04:05.999999999Z07:00"), "12345-06-07T08:09:10Z"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("3:04PM"), "8:09AM"
  assert_eq date(12345, 6, 7, 8, 9, 10, 0, utc()).format("Jan _2 15:04:05"), "Jun  7 08:09:10"
