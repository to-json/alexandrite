  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("Monday January 2 2006"), "Sunday January 3 2010"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("Mon Jan _2 3:4:5 pm"), "Sun Jan  3 12:0:0 am"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("06/1/2 03PM 04 05"), "10/1/3 12AM 00 00"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("2006-002"), "2010-003"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("__2 2006"), "  3 2010"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("_2006 _2"), "_2010  3"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("02/01/06 15h04m05s .000 ,999"), "03/01/10 00h00m00s .000 "
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("Jan 2, 2006 at 3:04pm (MST)"), "Jan 3, 2010 at 12:00am (UTC)"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("2006-01-02T15:04:05.00Z07:00"), "2010-01-03T00:00:00.00Z"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("15:04:05,000000"), "00:00:00,000000"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("2006-01-02 15:04:05 -07"), "2010-01-03 00:00:00 +00"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("-07:00:00 Z07:00:00 -070000 Z070000 Z07 Z0700"), "+00:00:00 Z +000000 Z Z Z"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("January 02 06 Jan Mon Monday"), "January 03 10 Jan Sun Sunday"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("Janx Monx Jan1 Mon1 Janu"), "Janx Monx Jan1 Sun1 Janu"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("5.0 5.9 5,99"), "0.0 0 0"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("05.000000 05.9"), "00.000000 00"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("no elements"), "no elements"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format(""), ""
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("2006 plain 1 text"), "2010 plain 1 text"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format(".9 .99 ,9"), "  "
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("15.04"), "00.00"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("3PM 3pm"), "12AM 12am"
  assert_eq date(2010, 1, 3, 0, 0, 0, 0, utc()).format("0 00 000 0002"), "0 00 000 0003"
}

test "go format vectors 5" {
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Mon Jan _2 15:04:05 2006"), "Thu Dec 31 00:00:00 2015"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Mon Jan _2 15:04:05 MST 2006"), "Thu Dec 31 00:00:00 UTC 2015"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Mon Jan 02 15:04:05 -0700 2006"), "Thu Dec 31 00:00:00 +0000 2015"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("02 Jan 06 15:04 MST"), "31 Dec 15 00:00 UTC"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("02 Jan 06 15:04 -0700"), "31 Dec 15 00:00 +0000"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Monday, 02-Jan-06 15:04:05 MST"), "Thursday, 31-Dec-15 00:00:00 UTC"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Mon, 02 Jan 2006 15:04:05 MST"), "Thu, 31 Dec 2015 00:00:00 UTC"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Thu, 31 Dec 2015 00:00:00 +0000"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("2006-01-02T15:04:05Z07:00"), "2015-12-31T00:00:00Z"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("2006-01-02T15:04:05.999999999Z07:00"), "2015-12-31T00:00:00Z"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("3:04PM"), "12:00AM"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Jan _2 15:04:05"), "Dec 31 00:00:00"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Jan _2 15:04:05.000"), "Dec 31 00:00:00.000"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Jan _2 15:04:05.000000"), "Dec 31 00:00:00.000000"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Jan _2 15:04:05.000000000"), "Dec 31 00:00:00.000000000"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("2006-01-02 15:04:05"), "2015-12-31 00:00:00"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("2006-01-02"), "2015-12-31"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("15:04:05"), "00:00:00"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Monday January 2 2006"), "Thursday December 31 2015"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Mon Jan _2 3:4:5 pm"), "Thu Dec 31 12:0:0 am"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("06/1/2 03PM 04 05"), "15/12/31 12AM 00 00"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("2006-002"), "2015-365"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("__2 2006"), "365 2015"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("_2006 _2"), "_2015 31"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("02/01/06 15h04m05s .000 ,999"), "31/12/15 00h00m00s .000 "
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Jan 2, 2006 at 3:04pm (MST)"), "Dec 31, 2015 at 12:00am (UTC)"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("2006-01-02T15:04:05.00Z07:00"), "2015-12-31T00:00:00.00Z"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("15:04:05,000000"), "00:00:00,000000"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("2006-01-02 15:04:05 -07"), "2015-12-31 00:00:00 +00"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("-07:00:00 Z07:00:00 -070000 Z070000 Z07 Z0700"), "+00:00:00 Z +000000 Z Z Z"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("January 02 06 Jan Mon Monday"), "December 31 15 Dec Thu Thursday"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("Janx Monx Jan1 Mon1 Janu"), "Janx Monx Dec12 Thu12 Janu"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("5.0 5.9 5,99"), "0.0 0 0"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("05.000000 05.9"), "00.000000 00"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("no elements"), "no elements"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format(""), ""
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("2006 plain 1 text"), "2015 plain 12 text"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format(".9 .99 ,9"), "  "
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("15.04"), "00.00"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("3PM 3pm"), "12AM 12am"
  assert_eq date(2015, 12, 31, 0, 0, 0, 0, utc()).format("0 00 000 0002"), "0 00 000 0365"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Mon Jan _2 15:04:05 2006"), "Fri Jan  1 13:00:00 2016"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Mon Jan _2 15:04:05 MST 2006"), "Fri Jan  1 13:00:00 UTC 2016"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Mon Jan 02 15:04:05 -0700 2006"), "Fri Jan 01 13:00:00 +0000 2016"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("02 Jan 06 15:04 MST"), "01 Jan 16 13:00 UTC"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("02 Jan 06 15:04 -0700"), "01 Jan 16 13:00 +0000"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Monday, 02-Jan-06 15:04:05 MST"), "Friday, 01-Jan-16 13:00:00 UTC"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Mon, 02 Jan 2006 15:04:05 MST"), "Fri, 01 Jan 2016 13:00:00 UTC"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Mon, 02 Jan 2006 15:04:05 -0700"), "Fri, 01 Jan 2016 13:00:00 +0000"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("2006-01-02T15:04:05Z07:00"), "2016-01-01T13:00:00Z"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("2006-01-02T15:04:05.999999999Z07:00"), "2016-01-01T13:00:00Z"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("3:04PM"), "1:00PM"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Jan _2 15:04:05"), "Jan  1 13:00:00"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Jan _2 15:04:05.000"), "Jan  1 13:00:00.000"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Jan _2 15:04:05.000000"), "Jan  1 13:00:00.000000"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Jan _2 15:04:05.000000000"), "Jan  1 13:00:00.000000000"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("2006-01-02 15:04:05"), "2016-01-01 13:00:00"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("2006-01-02"), "2016-01-01"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("15:04:05"), "13:00:00"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Monday January 2 2006"), "Friday January 1 2016"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Mon Jan _2 3:4:5 pm"), "Fri Jan  1 1:0:0 pm"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("06/1/2 03PM 04 05"), "16/1/1 01PM 00 00"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("2006-002"), "2016-001"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("__2 2006"), "  1 2016"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("_2006 _2"), "_2016  1"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("02/01/06 15h04m05s .000 ,999"), "01/01/16 13h00m00s .000 "
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Jan 2, 2006 at 3:04pm (MST)"), "Jan 1, 2016 at 1:00pm (UTC)"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("2006-01-02T15:04:05.00Z07:00"), "2016-01-01T13:00:00.00Z"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("15:04:05,000000"), "13:00:00,000000"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("2006-01-02 15:04:05 -07"), "2016-01-01 13:00:00 +00"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("-07:00:00 Z07:00:00 -070000 Z070000 Z07 Z0700"), "+00:00:00 Z +000000 Z Z Z"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("January 02 06 Jan Mon Monday"), "January 01 16 Jan Fri Friday"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("Janx Monx Jan1 Mon1 Janu"), "Janx Monx Jan1 Fri1 Janu"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("5.0 5.9 5,99"), "0.0 0 0"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("05.000000 05.9"), "00.000000 00"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("no elements"), "no elements"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format(""), ""
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("2006 plain 1 text"), "2016 plain 1 text"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format(".9 .99 ,9"), "  "
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("15.04"), "13.00"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("3PM 3pm"), "1PM 1pm"
  assert_eq date(2016, 1, 1, 13, 0, 0, 0, utc()).format("0 00 000 0002"), "0 00 000 0001"
}
