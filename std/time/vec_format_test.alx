  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Jan _2 15:04:05.000000"), "Dec 31 12:00:00.120000"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Jan _2 15:04:05.000000000"), "Dec 31 12:00:00.120000000"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("2006-01-02 15:04:05"), "1999-12-31 12:00:00"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("2006-01-02"), "1999-12-31"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("15:04:05"), "12:00:00"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Monday January 2 2006"), "Friday December 31 1999"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Mon Jan _2 3:4:5 pm"), "Fri Dec 31 12:0:0 pm"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("06/1/2 03PM 04 05"), "99/12/31 12PM 00 00"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("2006-002"), "1999-365"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("__2 2006"), "365 1999"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("_2006 _2"), "_1999 31"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("02/01/06 15h04m05s .000 ,999"), "31/12/99 12h00m00s .120 ,12"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("Jan 2, 2006 at 3:04pm (MST)"), "Dec 31, 1999 at 12:00pm (IST)"
  assert_eq date(1999, 12, 31, 12, 0, 0, 120000000, fixed_zone("IST", 19800)).format("2006-01-02T15:04:05.00Z07:00"), "1999-12-31T12:00:00.12+05:30"
