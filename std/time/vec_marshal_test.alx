# Generated from Go's time package (go1.27.1; a scratch generator); do not edit by hand.
# marshal_binary (hex), marshal_text / marshal_json (or Go's error, in alx's names),
# go_string (in alx's spelling) and to_s, over random instants and the extremes.

test "go marshal vectors 0" {
  assert_eq mb(tf(-9223372036854775808, -9223372036854775808, 1)), "018000000c51d079fb08a7f200ffff"
