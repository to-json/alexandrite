test "go date math vectors 1" {
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).round(duration(999999999999)).format(RFC3339_NANO), "2024-02-29T23:53:19.936155156+01:00"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).truncate(duration(86400000000001)).format(RFC3339_NANO), "2024-02-29T01:00:00.000738944+01:00"
  assert_eq date(2024, 2, 29, 23, 59, 59, 123456789, fixed_zone("CET", 3600)).round(duration(86400000000001)).format(RFC3339_NANO), "2024-03-01T01:00:00.000738945+01:00"
