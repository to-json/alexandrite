test "go date math vectors 2" {
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).round(duration(11820000000000)).format(RFC3339_NANO), "10000-01-01T01:18:00Z"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).truncate(duration(1)).format(RFC3339_NANO), "9999-12-31T23:59:59.999999999Z"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).round(duration(1)).format(RFC3339_NANO), "9999-12-31T23:59:59.999999999Z"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).truncate(duration(0)).format(RFC3339_NANO), "9999-12-31T23:59:59.999999999Z"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).round(duration(0)).format(RFC3339_NANO), "9999-12-31T23:59:59.999999999Z"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).truncate(duration(-5)).format(RFC3339_NANO), "9999-12-31T23:59:59.999999999Z"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).round(duration(-5)).format(RFC3339_NANO), "9999-12-31T23:59:59.999999999Z"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).truncate(duration(999999999999)).format(RFC3339_NANO), "9999-12-31T23:49:59.684462103Z"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).round(duration(999999999999)).format(RFC3339_NANO), "10000-01-01T00:06:39.684462102Z"
  assert_eq date(9999, 12, 31, 23, 59, 59, 999999999, utc()).truncate(duration(86400000000001)).format(RFC3339_NANO), "9999-12-31T00:00:00.003652058Z"
