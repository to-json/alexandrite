# Generated from Go's time package (go run of scratchpad/gen/main.go); do not edit by hand.

test "go parse vectors 0" {
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05Z"), "1136214245 0 0"
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05+07:00"), "1136189045 0 25200"
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05-03:30"), "1136226845 0 -12600"
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05.123456789+01:00"), "1136210645 123456789 3600"
  assert_eq pok("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05.5Z"), "1136214245 500000000 0"
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2006-01-02T15:04:05.999999999Z"), "1136214245 999999999 0"
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2006-01-02T15:04:05Z"), "1136214245 0 0"
  assert_eq pok("2006-01-02T15:04:05.999999999Z07:00", "2024-02-29T23:59:59.1-12:00"), "1709294399 100000000 -43200"
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05"), "parsing time \"2006-01-02T15:04:05\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"\" as \"Z07:00\""
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05Zjunk"), "parsing time \"2006-01-02T15:04:05Zjunk\": extra text: \"junk\""
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-13-02T15:04:05Z"), "parsing time \"2006-13-02T15:04:05Z\": month out of range"
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-02-30T15:04:05Z"), "parsing time \"2006-02-30T15:04:05Z\": day out of range"
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2023-02-29T15:04:05Z"), "parsing time \"2023-02-29T15:04:05Z\": day out of range"
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-01-02T25:04:05Z"), "parsing time \"2006-01-02T25:04:05Z\": hour out of range"
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-01-02T15:64:05Z"), "parsing time \"2006-01-02T15:64:05Z\": minute out of range"
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:61Z"), "parsing time \"2006-01-02T15:04:61Z\": second out of range"
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-1-02T15:04:05Z"), "parsing time \"2006-1-02T15:04:05Z\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"1-02T15:04:05Z\" as \"01\""
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-01-02 15:04:05Z"), "parsing time \"2006-01-02 15:04:05Z\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \" 15:04:05Z\" as \"T\""
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05+25:00"), "parsing time \"2006-01-02T15:04:05+25:00\": time zone offset hour out of range"
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05+07:61"), "parsing time \"2006-01-02T15:04:05+07:61\": time zone offset minute out of range"
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05*07:00"), "parsing time \"2006-01-02T15:04:05*07:00\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"*07:00\" as \"Z07:00\""
  assert_eq perr("2006-01-02T15:04:05Z07:00", "2006-01-02T15:04:05+0700"), "parsing time \"2006-01-02T15:04:05+0700\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"+0700\" as \"Z07:00\""
  assert_eq perr("2006-01-02T15:04:05Z07:00", ""), "parsing time \"\" as \"2006-01-02T15:04:05Z07:00\": cannot parse \"\" as \"2006\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 MST", "Mon, 02 Jan 2006 15:04:05 UTC"), "1136214245 0 0"
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 MST", "Mon, 02 Jan 2006 15:04:05 GMT"), "1136214245 0 0"
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 MST", "Mon, 02 Jan 2006 15:04:05 PST"), "1136214245 0 0"
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 MST", "Mon, 02 Jan 2006 15:04:05 GMT+5"), "1136214245 0 18000"
  assert_eq perr("Mon, 02 Jan 2006 15:04:05 MST", "Mon, 02 Jan 2006 15:04:05 +0530"), "parsing time \"Mon, 02 Jan 2006 15:04:05 +0530\" as \"Mon, 02 Jan 2006 15:04:05 MST\": cannot parse \"+0530\" as \"MST\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 MST", "mon, 02 jan 2006 15:04:05 UTC"), "1136214245 0 0"
  assert_eq perr("Mon, 02 Jan 2006 15:04:05 MST", "Mon, 2 Jan 2006 15:04:05 UTC"), "parsing time \"Mon, 2 Jan 2006 15:04:05 UTC\" as \"Mon, 02 Jan 2006 15:04:05 MST\": cannot parse \"2 Jan 2006 15:04:05 UTC\" as \"02\""
  assert_eq perr("Mon, 02 Jan 2006 15:04:05 MST", "Foo, 02 Jan 2006 15:04:05 UTC"), "parsing time \"Foo, 02 Jan 2006 15:04:05 UTC\" as \"Mon, 02 Jan 2006 15:04:05 MST\": cannot parse \"Foo, 02 Jan 2006 15:04:05 UTC\" as \"Mon\""
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Tue, 12 Mar 2024 08:09:10 -0700"), "1710256150 0 -25200"
  assert_eq pok("Mon, 02 Jan 2006 15:04:05 -0700", "Tue, 12 Mar 2024 08:09:10 +1400"), "1710180550 0 50400"
  assert_eq pok("Monday, 02-Jan-06 15:04:05 MST", "Monday, 02-Jan-06 15:04:05 UTC"), "1136214245 0 0"
  assert_eq pok("Monday, 02-Jan-06 15:04:05 MST", "Sunday, 31-Dec-68 15:04:05 UTC"), "3124191845 0 0"
  assert_eq pok("Monday, 02-Jan-06 15:04:05 MST", "Sunday, 31-Dec-69 15:04:05 UTC"), "-32155 0 0"
  assert_eq pok("02 Jan 06 15:04 MST", "02 Jan 06 15:04 UTC"), "1136214240 0 0"
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Mon Jan  2 15:04:05 2006"), "1136214245 0 0"
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Mon Jan 12 15:04:05 2006"), "1137078245 0 0"
  assert_eq pok("Mon Jan _2 15:04:05 2006", "Mon Jan 2 15:04:05 2006"), "1136214245 0 0"
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Mon Jan  2 15:04:05 UTC 2006"), "1136214245 0 0"
  assert_eq pok("Mon Jan _2 15:04:05 MST 2006", "Mon Jan  2 15:04:05 EST 2006"), "1136214245 0 0"
  assert_eq pok("Mon Jan 02 15:04:05 -0700 2006", "Mon Jan 02 15:04:05 +0000 2006"), "1136214245 0 0"
  assert_eq pok("3:04PM", "3:04PM"), "-62167164960 0 0"
  assert_eq pok("3:04PM", "12:00AM"), "-62167219200 0 0"
  assert_eq pok("3:04PM", "12:30PM"), "-62167174200 0 0"
  assert_eq pok("3:04PM", "11:59PM"), "-62167132860 0 0"
  assert_eq perr("3:04PM", "13:04PM"), "parsing time \"13:04PM\": hour out of range"
  assert_eq perr("3:04PM", "3:04XM"), "parsing time \"3:04XM\" as \"3:04PM\": cannot parse \"XM\" as \"PM\""
  assert_eq perr("3:04PM", "3:04pm"), "parsing time \"3:04pm\" as \"3:04PM\": cannot parse \"pm\" as \"PM\""
  assert_eq pok("3:04pm", "3:04pm"), "-62167164960 0 0"
  assert_eq pok("3:04pm", "12:04am"), "-62167218960 0 0"
  assert_eq pok("Jan _2 15:04:05", "Jan  2 15:04:05"), "-62167078555 0 0"
  assert_eq pok("Jan _2 15:04:05.000", "Jan  2 15:04:05.123"), "-62167078555 123000000 0"
  assert_eq perr("Jan _2 15:04:05.000", "Jan  2 15:04:05.12"), "parsing time \"Jan  2 15:04:05.12\" as \"Jan _2 15:04:05.000\": cannot parse \".12\" as \".000\""
  assert_eq pok("Jan _2 15:04:05.000000", "Jan  2 15:04:05.123456"), "-62167078555 123456000 0"
  assert_eq pok("Jan _2 15:04:05.000000000", "Jan  2 15:04:05.123456789"), "-62167078555 123456789 0"
  assert_eq pok("2006-01-02 15:04:05", "2024-12-31 23:59:59"), "1735689599 0 0"
  assert_eq pok("2006-01-02 15:04:05", "2024-12-31 23:59:59.25"), "1735689599 250000000 0"
  assert_eq pok("2006-01-02 15:04:05", "2024-12-31 23:59:59,25"), "1735689599 250000000 0"
}

test "go parse vectors 1" {
  assert_eq pok("2006-01-02 15:04:05", "2024-12-31  23:59:59"), "1735689599 0 0"
  assert_eq pok("2006-01-02", "2024-12-31"), "1735603200 0 0"
  assert_eq pok("2006-01-02", "0001-01-01"), "-62135596800 0 0"
  assert_eq perr("2006-01-02", "-001-01-01"), "parsing time \"-001-01-01\" as \"2006-01-02\": cannot parse \"-001-01-01\" as \"2006\""
  assert_eq pok("2006-01-02", "0000-12-31"), "-62135683200 0 0"
  assert_eq pok("2006-01-02", "9999-12-31"), "253402214400 0 0"
  assert_eq pok("2006-01-02", "1600-02-29"), "-11670998400 0 0"
  assert_eq perr("2006-01-02", "1700-02-29"), "parsing time \"1700-02-29\": day out of range"
  assert_eq pok("15:04:05", "07:08:09"), "-62167193511 0 0"
  assert_eq perr("15:04:05", "24:00:00"), "parsing time \"24:00:00\": hour out of range"
  assert_eq pok("2006-002", "2024-366"), "1735603200 0 0"
  assert_eq perr("2006-002", "2023-366"), "parsing time \"2023-366\": day-of-year out of range"
  assert_eq pok("2006-002", "2023-060"), "1677628800 0 0"
  assert_eq pok("2006-002", "2024-060"), "1709164800 0 0"
  assert_eq perr("2006-002", "2024-000"), "parsing time \"2024-000\": day-of-year out of range"
  assert_eq perr("2006-002", "2024-60"), "parsing time \"2024-60\" as \"2006-002\": cannot parse \"60\" as \"002\""
  assert_eq pok("2006 __2", "2024  60"), "1709164800 0 0"
  assert_eq pok("2006 __2", "2024 060"), "1709164800 0 0"
  assert_eq pok("2006 __2", "2024 366"), "1735603200 0 0"
  assert_eq pok("2006-01-02 002", "2024-02-29 060"), "1709164800 0 0"
  assert_eq perr("2006-01-02 002", "2024-03-29 060"), "parsing time \"2024-03-29 060\": day-of-year does not match month"
  assert_eq perr("2006-01-02 002", "2024-02-28 060"), "parsing time \"2024-02-28 060\": day-of-year does not match day"
  assert_eq pok("January 2, 2006", "March 5, 2021"), "1614902400 0 0"
  assert_eq pok("January 2, 2006", "march 5, 2021"), "1614902400 0 0"
  assert_eq perr("January 2, 2006", "Marchx 5, 2021"), "parsing time \"Marchx 5, 2021\" as \"January 2, 2006\": cannot parse \"x 5, 2021\" as \" \""
  assert_eq perr("Jan 2 2006", "Sept 5 2021"), "parsing time \"Sept 5 2021\" as \"Jan 2 2006\": cannot parse \"t 5 2021\" as \" \""
  assert_eq pok("Jan 2 2006", "Sep 5 2021"), "1630800000 0 0"
  assert_eq pok("Jan 2 2006", "May 31 2021"), "1622419200 0 0"
  assert_eq perr("Jan 2 2006", "Apr 31 2021"), "parsing time \"Apr 31 2021\": day out of range"
  assert_eq pok("Jan 2 2006", "Feb 29 2020"), "1582934400 0 0"
  assert_eq perr("Jan 2 2006", "Feb 29 2021"), "parsing time \"Feb 29 2021\": day out of range"
  assert_eq perr("Jan 2 2006", "Jan 0 2021"), "parsing time \"Jan 0 2021\": day out of range"
  assert_eq perr("Jan 2 2006", "Jan 32 2021"), "parsing time \"Jan 32 2021\": day out of range"
  assert_eq pok("Monday January 2 2006", "Friday July 4 1976"), "205286400 0 0"
  assert_eq perr("Monday January 2 2006", "Fri July 4 1976"), "parsing time \"Fri July 4 1976\" as \"Monday January 2 2006\": cannot parse \"Fri July 4 1976\" as \"Monday\""
  assert_eq pok("Mon Jan 2", "Wed Jun 9"), "-62153395200 0 0"
  assert_eq pok("15:04:05.000", "01:02:03.456"), "-62167215477 456000000 0"
  assert_eq perr("15:04:05.000", "01:02:03.45"), "parsing time \"01:02:03.45\" as \"15:04:05.000\": cannot parse \".45\" as \".000\""
  assert_eq perr("15:04:05.000", "01:02:03"), "parsing time \"01:02:03\" as \"15:04:05.000\": cannot parse \"\" as \".000\""
  assert_eq pok("15:04:05.999", "01:02:03.456789"), "-62167215477 456789000 0"
  assert_eq pok("15:04:05.999", "01:02:03"), "-62167215477 0 0"
  assert_eq pok("15:04:05.999", "01:02:03.4"), "-62167215477 400000000 0"
  assert_eq pok("15:04:05", "01:02:03.456"), "-62167215477 456000000 0"
  assert_eq pok("15:04:05", "01:02:03.4567890123456"), "-62167215477 456789012 0"
  assert_eq pok("15:04:05", "01:02:03,5"), "-62167215477 500000000 0"
  assert_eq perr("15:04:05", "01:02:03.x"), "parsing time \"01:02:03.x\": extra text: \".x\""
  assert_eq pok("15:04:05,000", "01:02:03,456"), "-62167215477 456000000 0"
  assert_eq pok("15:04:05,000", "01:02:03.456"), "-62167215477 456000000 0"
  assert_eq pok("15:04:05.000", "01:02:03,456"), "-62167215477 456000000 0"
  assert_eq pok("06-1-2", "99-12-25"), "946080000 0 0"
  assert_eq pok("06-1-2", "69-1-1"), "-31536000 0 0"
  assert_eq pok("06-1-2", "68-1-1"), "3092601600 0 0"
  assert_eq perr("06-1-2", "5-1-1"), "parsing time \"5-1-1\" as \"06-1-2\": cannot parse \"5-1-1\" as \"06\""
  assert_eq perr("2006", "12345"), "parsing time \"12345\": extra text: \"5\""
  assert_eq perr("2006", "99"), "parsing time \"99\" as \"2006\": cannot parse \"99\" as \"2006\""
  assert_eq perr("2006", "abcd"), "parsing time \"abcd\" as \"2006\": cannot parse \"abcd\" as \"2006\""
  assert_eq pok("2 1 2006", "3 4 2021"), "1617408000 0 0"
  assert_eq perr("02 01 2006", "3 4 2021"), "parsing time \"3 4 2021\" as \"02 01 2006\": cannot parse \"3 4 2021\" as \"02\""
  assert_eq pok("02 01 2006", "03 04 2021"), "1617408000 0 0"
  assert_eq pok("15", "7"), "-62167194000 0 0"
}

test "go parse vectors 2" {
  assert_eq pok("15", "07"), "-62167194000 0 0"
  assert_eq perr("3", "13"), "parsing time \"13\": hour out of range"
  assert_eq perr("03", "7"), "parsing time \"7\" as \"03\": cannot parse \"7\" as \"03\""
  assert_eq pok("4 5", "7 8"), "-62167218772 0 0"
  assert_eq perr("04 05", "7 8"), "parsing time \"7 8\" as \"04 05\": cannot parse \"7 8\" as \"04\""
  assert_eq pok("a b  c", "a b  c"), "-62167219200 0 0"
  assert_eq pok("a b  c", "a   b c"), "-62167219200 0 0"
  assert_eq perr("a b  c", "a bc"), "parsing time \"a bc\" as \"a b  c\": cannot parse \"c\" as \"a b  c\""
  assert_eq pok("a b", "a  b"), "-62167219200 0 0"
  assert_eq pok("a  b", "a b"), "-62167219200 0 0"
  assert_eq perr("x", "y"), "parsing time \"y\" as \"x\": cannot parse \"y\" as \"x\""
  assert_eq perr("x", "xy"), "parsing time \"xy\": extra text: \"y\""
  assert_eq pok("2006-01-02 MST", "2024-05-06 UTC"), "1714953600 0 0"
  assert_eq pok("2006-01-02 MST", "2024-05-06 CEST"), "1714953600 0 0"
  assert_eq pok("2006-01-02 MST", "2024-05-06 AEDT"), "1714953600 0 0"
  assert_eq pok("2006-01-02 MST", "2024-05-06 ChST"), "1714953600 0 0"
  assert_eq perr("2006-01-02 MST", "2024-05-06 ab"), "parsing time \"2024-05-06 ab\" as \"2006-01-02 MST\": cannot parse \"ab\" as \"MST\""
  assert_eq pok("2006-01-02 MST", "2024-05-06 -07"), "1714953600 0 0"
  assert_eq perr("2006-01-02 MST", "2024-05-06 +0530"), "parsing time \"2024-05-06 +0530\" as \"2006-01-02 MST\": cannot parse \"+0530\" as \"MST\""
  assert_eq pok("2006-01-02 MST", "2024-05-06 GMT-3"), "1714953600 0 -10800"
  assert_eq pok("2006-01-02 MST", "2024-05-06 GMT+14"), "1714953600 0 50400"
  assert_eq perr("2006-01-02 MST", "2024-05-06 GMT+24"), "parsing time \"2024-05-06 GMT+24\": extra text: \"+24\""
  assert_eq pok("2006-01-02 -07", "2024-05-06 +05"), "1714935600 0 18000"
  assert_eq pok("2006-01-02 -07", "2024-05-06 -12"), "1714996800 0 -43200"
  assert_eq pok("2006-01-02 -0700", "2024-05-06 +0530"), "1714933800 0 19800"
  assert_eq pok("2006-01-02 -07:00", "2024-05-06 +05:30"), "1714933800 0 19800"
  assert_eq perr("2006-01-02 -07:00", "2024-05-06 +0530"), "parsing time \"2024-05-06 +0530\" as \"2006-01-02 -07:00\": cannot parse \"+0530\" as \"-07:00\""
  assert_eq pok("2006-01-02 -07:00:00", "2024-05-06 +05:30:15"), "1714933785 0 19815"
  assert_eq pok("2006-01-02 -070000", "2024-05-06 -053015"), "1714973415 0 -19815"
  assert_eq pok("2006-01-02 Z07:00:00", "2024-05-06 Z"), "1714953600 0 0"
  assert_eq pok("2006-01-02 Z070000", "2024-05-06 +010203"), "1714949877 0 3723"
  assert_eq pok("2006-01-02 Z07", "2024-05-06 Z"), "1714953600 0 0"
  assert_eq pok("2006-01-02 Z07", "2024-05-06 -02"), "1714960800 0 -7200"
  assert_eq pok("2006-01-02 Z0700", "2024-05-06 Z"), "1714953600 0 0"
  assert_eq pok("2006-01-02 Z0700", "2024-05-06 -0200"), "1714960800 0 -7200"
  assert_eq perr("2006-01-02 -07", "2024-05-06 Z"), "parsing time \"2024-05-06 Z\" as \"2006-01-02 -07\": cannot parse \"Z\" as \"-07\""
  assert_eq perr("2006-01-02 -07", "2024-05-06 +"), "parsing time \"2024-05-06 +\" as \"2006-01-02 -07\": cannot parse \"+\" as \"-07\""
  assert_eq perr("2006-01-02 -07:00", "2024-05-06 +05-30"), "parsing time \"2024-05-06 +05-30\" as \"2006-01-02 -07:00\": cannot parse \"+05-30\" as \"-07:00\""
  assert_eq pok("2006-01-02 -0700 MST", "2024-05-06 +0100 CET"), "1714950000 0 3600"
  assert_eq pok("2006-01-02 -0700 MST", "2024-05-06 +0000 UTC"), "1714953600 0 0"
  assert_eq pok("2006-01-02 15:04:05 -0700", "2024-05-06 07:08:09 +0000"), "1714979289 0 0"
  assert_eq pok("January", "March"), "-62162035200 0 0"
  assert_eq pok("Jan", "Mar"), "-62162035200 0 0"
  assert_eq perr("Jan", "Xxx"), "parsing time \"Xxx\" as \"Jan\": cannot parse \"Xxx\" as \"Jan\""
  assert_eq pok("Monday", "Friday"), "-62167219200 0 0"
  assert_eq pok("1/2/2006", "2/29/2024"), "1709164800 0 0"
  assert_eq perr("1/2/2006", "2/29/2023"), "parsing time \"2/29/2023\": day out of range"
  assert_eq pok("_2/1/06", " 5/3/21"), "1614902400 0 0"
  assert_eq pok("_2/1/06", "15/3/21"), "1615766400 0 0"
  assert_eq pok("_2/1/06", "5/3/21"), "1614902400 0 0"
  assert_eq pok("Jan _2", "Mar  7"), "-62161516800 0 0"
  assert_eq pok("Jan _2", "Mar 17"), "-62160652800 0 0"
  assert_eq pok("3:04:05 PM", "11:59:59 PM"), "-62167132801 0 0"
  assert_eq pok("3:04:05 pm", "12:00:00 am"), "-62167219200 0 0"
  assert_eq pok("3:04:05 PM", "0:00:00 PM"), "-62167176000 0 0"
  assert_eq perr("3:04:05 PM", "13:00:00 PM"), "parsing time \"13:00:00 PM\": hour out of range"
  assert_eq pok("2006-01-02T15:04:05.000000000Z", "2024-05-06T07:08:09.123456789Z"), "1714979289 123456789 0"
  assert_eq pok("2006-01-02T15:04:05.9Z", "2024-05-06T07:08:09.123456789Z"), "1714979289 123456789 0"
  assert_eq pok("2006-01-02T15:04:05Z", "2024-05-06T07:08:09.123456789Z"), "1714979289 123456789 0"
  assert_eq perr("2006-01-02T15:04:05Z", "2024-05-06T07:08:09.Z"), "parsing time \"2024-05-06T07:08:09.Z\" as \"2006-01-02T15:04:05Z\": cannot parse \".Z\" as \"Z\""
}

test "go parse vectors 3" {
  assert_eq perr("2006-01-02", "2024-05-06 "), "parsing time \"2024-05-06 \": extra text: \" \""
  assert_eq perr("2006-01-02", " 2024-05-06"), "parsing time \" 2024-05-06\" as \"2006-01-02\": cannot parse \" 2024-05-06\" as \"2006\""
}
