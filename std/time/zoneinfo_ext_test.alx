#![test(external)]
# Go's zoneinfo_test.go and tzdata_test.go tests that need a known database
# (DisablePlatformSources, then the embedded one that importing time/tzdata
# registers, where Go reads $GOROOT/lib/time/zoneinfo.zip). The rest of
# zoneinfo_test.go (the tzset family, names, malformed data) is in the in-package
# zoneinfo_test.alx.
import "time"
import _ "time/tzdata"
import "os"

test "TestEnvVarUsage" {
  time.reset_zoneinfo_for_testing()
  old = os.getenv("ZONEINFO")
  ~os.setenv("ZONEINFO", "foo.zip")
  time.load_location("Asia/Jerusalem")
  assert_eq time.zoneinfo_for_testing(), "foo.zip"
  if v = old {
    ~os.setenv("ZONEINFO", v)
  } else {
    ~os.unsetenv("ZONEINFO")
  }
  time.reset_zoneinfo_for_testing()
}

test "TestVersion3" {
  undo = time.disable_platform_sources()
  defer { undo.call() }
  r = time.load_location("Asia/Jerusalem")
  assert r.ok?, r.err?.message || ""
}

test "TestFirstZone" {
  undo = time.disable_platform_sources()
  defer { undo.call() }
  format = "Mon, 02 Jan 2006 15:04:05 -0700 (MST)"
  tests = [
    ("PST8PDT", -1633269601, "Sun, 31 Mar 1918 01:59:59 -0800 (PST)", "Sun, 31 Mar 1918 03:00:00 -0700 (PDT)"),
    ("Pacific/Fakaofo", 1325242799, "Thu, 29 Dec 2011 23:59:59 -1100 (-11)", "Sat, 31 Dec 2011 00:00:00 +1300 (+13)"),
  ]
  for tt in tests {
    z = ~time.load_location(tt[0])
    assert_eq time.unix(tt[1], 0).in_zone(z).format(format), tt[2]
    assert_eq time.unix(tt[1] + 1, 0).in_zone(z).format(format), tt[3]
  }
}

test "TestLoadLocationFromTZData" {
  undo = time.disable_platform_sources()
  defer { undo.call() }
  name = "Asia/Jerusalem"
  reference = ~time.load_location(name)
  data = ~time.load_from_embedded_tzdata(name)
  sample = ~time.load_location_from_tzdata(name, data.bytes)
  assert reference == sample
}

test "TestEarlyLocation" {
  undo = time.disable_platform_sources()
  defer { undo.call() }
  loc = ~time.load_location("America/New_York")
  name, off = time.date(1900, time.JANUARY, 1, 0, 0, 0, 0, loc).zone_info
  assert_eq name, "EST"
  assert_eq off, -18000
}

# tzdata_test.go
test "TestEmbeddedTZData" {
  undo = time.disable_platform_sources()
  defer { undo.call() }
  for zone in ["Asia/Jerusalem", "America/Los_Angeles"] {
    reference = ~time.load_location(zone)
    embedded = ~time.load_from_embedded_tzdata(zone)
    sample = ~time.load_location_from_tzdata(zone, embedded.bytes)
    assert_eq reference.string, sample.string
    assert reference == sample, zone
  }
}

# Without the platform's database or $ZONEINFO, a zone that isn't embedded is
# unknown, and an embedded one loads (the registration works).
test "the embedded database is load_location's last source" {
  undo = time.disable_platform_sources()
  defer { undo.call() }
  assert_eq time.load_location("Asia/SomethingNotExist").err?.message, "unknown time zone Asia/SomethingNotExist"
  assert_eq time.~load_location("Australia/Lord_Howe").string, "Australia/Lord_Howe"
}
