test "Categories" {
  not_tested: Map[Str, Bool] = {}
  for k in unicode.category_names {
    not_tested[k] = true
  }
  for t in in_category_test {
    table = unicode.category(t[1]) || fail "#{t[1]} not a known category"
    assert unicode.is(table, t[0]), "IsCategory(#{t[0]}, #{t[1]}) = false, want true"
    not_tested.delete(t[1])
  }
  assert_eq not_tested.keys, []
}

test "Properties" {
  not_tested: Map[Str, Bool] = {}
  for k in unicode.property_names {
    not_tested[k] = true
  }
  for t in in_prop_test {
    table = unicode.property(t[1]) || fail "#{t[1]} not a known prop"
    assert unicode.is(table, t[0]), "IsCategory(#{t[0]}, #{t[1]}) = false, want true"
    not_tested.delete(t[1])
  }
  assert_eq not_tested.keys, []
}

# example_test.go

# Functions starting with "is" can be used to inspect which table of range a
# rune belongs to. Note that runes may fit into more than one range.
example "is" {
  # constant with mixed type runes
  mixed = "\b5Ὂg̀9! ℃ᾭG"
  for c in mixed.runes {
    fmt.printf("For %q:\n", c)
    puts "\tis control rune" if unicode.is_control(c)
    puts "\tis digit rune" if unicode.is_digit(c)
    puts "\tis graphic rune" if unicode.is_graphic(c)
    puts "\tis letter rune" if unicode.is_letter(c)
    puts "\tis lower case rune" if unicode.is_lower(c)
    puts "\tis mark rune" if unicode.is_mark(c)
    puts "\tis number rune" if unicode.is_number(c)
    puts "\tis printable rune" if unicode.is_print(c)
    puts "\tis not printable rune" if !unicode.is_print(c)
    puts "\tis punct rune" if unicode.is_punct(c)
    puts "\tis space rune" if unicode.is_space(c)
    puts "\tis symbol rune" if unicode.is_symbol(c)
    puts "\tis title case rune" if unicode.is_title(c)
    puts "\tis upper case rune" if unicode.is_upper(c)
  }
} outputs "For '\\b':\n\tis control rune\n\tis not printable rune\nFor '5':\n\tis digit rune\n\tis graphic rune\n\tis number rune\n\tis printable rune\nFor 'Ὂ':\n\tis graphic rune\n\tis letter rune\n\tis printable rune\n\tis upper case rune\nFor 'g':\n\tis graphic rune\n\tis letter rune\n\tis lower case rune\n\tis printable rune\nFor '̀':\n\tis graphic rune\n\tis mark rune\n\tis printable rune\nFor '9':\n\tis digit rune\n\tis graphic rune\n\tis number rune\n\tis printable rune\nFor '!':\n\tis graphic rune\n\tis printable rune\n\tis punct rune\nFor ' ':\n\tis graphic rune\n\tis printable rune\n\tis space rune\nFor '℃':\n\tis graphic rune\n\tis printable rune\n\tis symbol rune\nFor 'ᾭ':\n\tis graphic rune\n\tis letter rune\n\tis printable rune\n\tis title case rune\nFor 'G':\n\tis graphic rune\n\tis letter rune\n\tis printable rune\n\tis upper case rune\n"

example "SimpleFold" {
  fmt.printf("%#U\n", unicode.simple_fold(0x41))   # 'a'
  fmt.printf("%#U\n", unicode.simple_fold(0x61))   # 'A'
  fmt.printf("%#U\n", unicode.simple_fold(0x4B))   # 'k'
  fmt.printf("%#U\n", unicode.simple_fold(0x6B))   # '\u212A' (Kelvin symbol, K)
  fmt.printf("%#U\n", unicode.simple_fold(0x212A)) # 'K'
  fmt.printf("%#U\n", unicode.simple_fold(0x31))   # '1'
} outputs "U+0061 'a'\nU+0041 'A'\nU+006B 'k'\nU+212A '\u212A'\nU+004B 'K'\nU+0031 '1'\n"

example "To" {
  lc_g: Rune = 0x67 # 'g'
  fmt.printf("%#U\n", unicode.to(unicode.UPPER_CASE, lc_g))
  fmt.printf("%#U\n", unicode.to(unicode.LOWER_CASE, lc_g))
  fmt.printf("%#U\n", unicode.to(unicode.TITLE_CASE, lc_g))

  uc_g: Rune = 0x47 # 'G'
  fmt.printf("%#U\n", unicode.to(unicode.UPPER_CASE, uc_g))
  fmt.printf("%#U\n", unicode.to(unicode.LOWER_CASE, uc_g))
  fmt.printf("%#U\n", unicode.to(unicode.TITLE_CASE, uc_g))
} outputs "U+0047 'G'\nU+0067 'g'\nU+0047 'G'\nU+0047 'G'\nU+0067 'g'\nU+0047 'G'\n"

example "ToLower" {
  fmt.printf("%#U\n", unicode.to_lower(0x47))
} outputs "U+0067 'g'\n"

example "ToTitle" {
  fmt.printf("%#U\n", unicode.to_title(0x67))
} outputs "U+0047 'G'\n"

example "ToUpper" {
  fmt.printf("%#U\n", unicode.to_upper(0x67))
} outputs "U+0047 'G'\n"

example "SpecialCase" {
  t = unicode.turkish_case

  lci: Rune = 0x69 # 'i'
  fmt.printf("%#U\n", t.to_lower(lci))
  fmt.printf("%#U\n", t.to_title(lci))
  fmt.printf("%#U\n", t.to_upper(lci))

  uci: Rune = 0x130 # 'İ'
  fmt.printf("%#U\n", t.to_lower(uci))
  fmt.printf("%#U\n", t.to_title(uci))
  fmt.printf("%#U\n", t.to_upper(uci))
} outputs "U+0069 'i'\nU+0130 'İ'\nU+0130 'İ'\nU+0069 'i'\nU+0130 'İ'\nU+0130 'İ'\n"

example "IsDigit" {
  fmt.printf("%t\n", unicode.is_digit(0x9E9)) # '৩'
  fmt.printf("%t\n", unicode.is_digit(0x41))
} outputs "true\nfalse\n"

example "IsNumber" {
  fmt.printf("%t\n", unicode.is_number(0x2167)) # 'Ⅷ'
  fmt.printf("%t\n", unicode.is_number(0x41))
} outputs "true\nfalse\n"

example "IsLetter" {
  fmt.printf("%t\n", unicode.is_letter(0x41))
  fmt.printf("%t\n", unicode.is_letter(0x37))
} outputs "true\nfalse\n"

example "IsLower" {
  fmt.printf("%t\n", unicode.is_lower(0x61))
  fmt.printf("%t\n", unicode.is_lower(0x41))
} outputs "true\nfalse\n"

example "IsUpper" {
  fmt.printf("%t\n", unicode.is_upper(0x41))
  fmt.printf("%t\n", unicode.is_upper(0x61))
} outputs "true\nfalse\n"

example "IsTitle" {
  fmt.printf("%t\n", unicode.is_title(0x1C5)) # 'ǅ'
  fmt.printf("%t\n", unicode.is_title(0x61))
} outputs "true\nfalse\n"

example "IsSpace" {
  fmt.printf("%t\n", unicode.is_space(0x20))
  fmt.printf("%t\n", unicode.is_space(0x0A))
  fmt.printf("%t\n", unicode.is_space(0x09))
  fmt.printf("%t\n", unicode.is_space(0x61))
} outputs "true\ntrue\ntrue\nfalse\n"
