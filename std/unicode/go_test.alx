def test_letter -> [Rune] {
  [
    0x0041, 0x0061, 0x00AA, 0x00BA, 0x00C8, 0x00DB, 0x00F9, 0x02EC,
    0x0535, 0x06E6, 0x093D, 0x0A15, 0x0B99, 0x0DC0, 0x0EDD, 0x1000,
    0x1200, 0x1312, 0x1401, 0x1885, 0x2C00, 0xA800, 0xF900, 0xFA30,
    0xFFDA, 0xFFDC, 0x10000, 0x10300, 0x10400, 0x20000, 0x2F800, 0x2FA1D,
  ]
}

struct CaseT {
  cas: Int
  input: Rune
  out: Rune
}

def ct(cas: Int, input: Int, out: Int) -> CaseT { CaseT.new(cas: cas, input: input.to_i32, out: out.to_i32) }

def case_test -> [CaseT] {
  up = unicode.UPPER_CASE
  lo = unicode.LOWER_CASE
  ti = unicode.TITLE_CASE
  [
    # errors
    ct(-1, 0x0A, 0xFFFD),
    ct(up, -1, -1),
    ct(up, 1 << 30, 1 << 30),

    # ASCII (special-cased so test carefully)
    ct(up, 0x0A, 0x0A),
    ct(up, 0x61, 0x41),
    ct(up, 0x41, 0x41),
    ct(up, 0x37, 0x37),
    ct(lo, 0x0A, 0x0A),
    ct(lo, 0x61, 0x61),
    ct(lo, 0x41, 0x61),
    ct(lo, 0x37, 0x37),
    ct(ti, 0x0A, 0x0A),
    ct(ti, 0x61, 0x41),
    ct(ti, 0x41, 0x41),
    ct(ti, 0x37, 0x37),

    # Latin-1: easy to read the tests!
    ct(up, 0x80, 0x80),
    ct(up, 0xC5, 0xC5), # 'Å'
    ct(up, 0xE5, 0xC5), # 'å'
    ct(lo, 0x80, 0x80),
    ct(lo, 0xC5, 0xE5),
    ct(lo, 0xE5, 0xE5),
    ct(ti, 0x80, 0x80),
    ct(ti, 0xC5, 0xC5),
    ct(ti, 0xE5, 0xC5),

    # 0131;LATIN SMALL LETTER DOTLESS I;Ll;0;L;;;;;N;;;0049;;0049
    ct(up, 0x0131, 0x49),
    ct(lo, 0x0131, 0x0131),
    ct(ti, 0x0131, 0x49),

    # 0133;LATIN SMALL LIGATURE IJ;Ll;0;L;<compat> 0069 006A;;;;N;LATIN SMALL LETTER I J;;0132;;0132
    ct(up, 0x0133, 0x0132),
    ct(lo, 0x0133, 0x0133),
    ct(ti, 0x0133, 0x0132),

    # 212A;KELVIN SIGN;Lu;0;L;004B;;;;N;DEGREES KELVIN;;;006B;
    ct(up, 0x212A, 0x212A),
    ct(lo, 0x212A, 0x6B),
    ct(ti, 0x212A, 0x212A),

    # From an UpperLower sequence
    # A640;CYRILLIC CAPITAL LETTER ZEMLYA;Lu;0;L;;;;;N;;;;A641;
    ct(up, 0xA640, 0xA640),
    ct(lo, 0xA640, 0xA641),
    ct(ti, 0xA640, 0xA640),
    # A641;CYRILLIC SMALL LETTER ZEMLYA;Ll;0;L;;;;;N;;;A640;;A640
    ct(up, 0xA641, 0xA640),
    ct(lo, 0xA641, 0xA641),
    ct(ti, 0xA641, 0xA640),
    # A64E;CYRILLIC CAPITAL LETTER NEUTRAL YER;Lu;0;L;;;;;N;;;;A64F;
    ct(up, 0xA64E, 0xA64E),
    ct(lo, 0xA64E, 0xA64F),
    ct(ti, 0xA64E, 0xA64E),
    # A65F;CYRILLIC SMALL LETTER YN;Ll;0;L;;;;;N;;;A65E;;A65E
    ct(up, 0xA65F, 0xA65E),
    ct(lo, 0xA65F, 0xA65F),
    ct(ti, 0xA65F, 0xA65E),

    # From another UpperLower sequence
    # 0139;LATIN CAPITAL LETTER L WITH ACUTE;Lu;0;L;004C 0301;;;;N;LATIN CAPITAL LETTER L ACUTE;;;013A;
    ct(up, 0x0139, 0x0139),
    ct(lo, 0x0139, 0x013A),
    ct(ti, 0x0139, 0x0139),
    # 013F;LATIN CAPITAL LETTER L WITH MIDDLE DOT;Lu;0;L;<compat> 004C 00B7;;;;N;;;;0140;
    ct(up, 0x013f, 0x013f),
    ct(lo, 0x013f, 0x0140),
    ct(ti, 0x013f, 0x013f),
    # 0148;LATIN SMALL LETTER N WITH CARON;Ll;0;L;006E 030C;;;;N;LATIN SMALL LETTER N HACEK;;0147;;0147
    ct(up, 0x0148, 0x0147),
    ct(lo, 0x0148, 0x0148),
    ct(ti, 0x0148, 0x0147),

    # Lowercase lower than uppercase.
    # AB78;CHEROKEE SMALL LETTER GE;Ll;0;L;;;;;N;;;13A8;;13A8
    ct(up, 0xab78, 0x13a8),
    ct(lo, 0xab78, 0xab78),
    ct(ti, 0xab78, 0x13a8),
    ct(up, 0x13a8, 0x13a8),
    ct(lo, 0x13a8, 0xab78),
    ct(ti, 0x13a8, 0x13a8),

    # Last block in the 5.1.0 table
    # 10400;DESERET CAPITAL LETTER LONG I;Lu;0;L;;;;;N;;;;10428;
    ct(up, 0x10400, 0x10400),
    ct(lo, 0x10400, 0x10428),
    ct(ti, 0x10400, 0x10400),
    # 10427;DESERET CAPITAL LETTER EW;Lu;0;L;;;;;N;;;;1044F;
    ct(up, 0x10427, 0x10427),
    ct(lo, 0x10427, 0x1044F),
    ct(ti, 0x10427, 0x10427),
    # 10428;DESERET SMALL LETTER LONG I;Ll;0;L;;;;;N;;;10400;;10400
    ct(up, 0x10428, 0x10400),
    ct(lo, 0x10428, 0x10428),
    ct(ti, 0x10428, 0x10400),
    # 1044F;DESERET SMALL LETTER EW;Ll;0;L;;;;;N;;;10427;;10427
    ct(up, 0x1044F, 0x10427),
    ct(lo, 0x1044F, 0x1044F),
    ct(ti, 0x1044F, 0x10427),

    # First one not in the 5.1.0 table
    # 10450;SHAVIAN LETTER PEEP;Lo;0;L;;;;;N;;;;;
    ct(up, 0x10450, 0x10450),
    ct(lo, 0x10450, 0x10450),
    ct(ti, 0x10450, 0x10450),

    # Non-letters with case.
    ct(lo, 0x2161, 0x2171),
    ct(up, 0x0345, 0x0399),
  ]
}

test "IsLetter" {
  for r in upper_test {
    assert unicode.is_letter(r), "is_letter(#{r}) = false, want true"
  }
  for r in letter_test {
    assert unicode.is_letter(r), "is_letter(#{r}) = false, want true"
  }
  for r in notletter_test {
    assert !unicode.is_letter(r), "is_letter(#{r}) = true, want false"
  }
}

test "IsUpper" {
  for r in upper_test {
    assert unicode.is_upper(r), "is_upper(#{r}) = false, want true"
  }
  for r in notupper_test {
    assert !unicode.is_upper(r), "is_upper(#{r}) = true, want false"
  }
  for r in notletter_test {
    assert !unicode.is_upper(r), "is_upper(#{r}) = true, want false"
  }
}

test "To" {
  for c in case_test {
    assert_eq unicode.to(c.cas, c.input), c.out
  }
}

test "ToUpperCase" {
  for c in case_test {
    next if c.cas != unicode.UPPER_CASE
    assert_eq unicode.to_upper(c.input), c.out
  }
}

test "ToLowerCase" {
  for c in case_test {
    next if c.cas != unicode.LOWER_CASE
    assert_eq unicode.to_lower(c.input), c.out
  }
}

test "ToTitleCase" {
  for c in case_test {
    next if c.cas != unicode.TITLE_CASE
    assert_eq unicode.to_title(c.input), c.out
  }
}

test "IsSpace" {
  for c in space_test {
    assert unicode.is_space(c), "is_space(#{c}) = false, want true"
  }
  for c in letter_test {
    assert !unicode.is_space(c), "is_space(#{c}) = true, want false"
  }
}

# Check that the optimizations for is_letter etc. agree with the tables.
# We only need to check the Latin-1 range.
test "LetterOptimizations" {
  letter = tab("L")
  upper = tab("Lu")
  lower = tab("Ll")
  title = tab("Lt")
  white_space = tab("White_Space")
  for k in 0..unicode.MAX_LATIN1.to_i {
    i = k.to_i32
    assert_eq unicode.is(letter, i), unicode.is_letter(i)
    assert_eq unicode.is(upper, i), unicode.is_upper(i)
    assert_eq unicode.is(lower, i), unicode.is_lower(i)
    assert_eq unicode.is(title, i), unicode.is_title(i)
    assert_eq unicode.is(white_space, i), unicode.is_space(i)
    assert_eq unicode.to(unicode.UPPER_CASE, i), unicode.to_upper(i)
    assert_eq unicode.to(unicode.LOWER_CASE, i), unicode.to_lower(i)
    assert_eq unicode.to(unicode.TITLE_CASE, i), unicode.to_title(i)
  }
}

test "TurkishCase" {
  lower = "abcçdefgğhıijklmnoöprsştuüvyz".runes
  upper = "ABCÇDEFGĞHIİJKLMNOÖPRSŞTUÜVYZ".runes
  t = unicode.turkish_case
  for i in 0...lower.size {
    l = lower[i]
    u = upper[i]
    assert_eq t.to_lower(l), l
    assert_eq t.to_upper(u), u
    assert_eq t.to_upper(l), u
    assert_eq t.to_lower(u), l
    assert_eq t.to_title(u), u
    assert_eq t.to_title(l), u
  }
}

test "SimpleFold" {
  simple_fold_tests = [
    # SimpleFold(x) returns the next equivalent rune > x or wraps
    # around to smaller values.

    # Easy cases.
    "Aa",
    "δΔ",

    # ASCII special cases.
    "Kk\u212A",
    "Ssſ",

    # Non-ASCII special cases.
    "ρϱΡ",
    "\u0345\u0399\u03B9\u1FBE",

    # Extra special cases: has lower/upper but no case fold.
    "İ",
    "ı",

    # Upper comes before lower (Cherokee).
    "\u13b0\uab80",
  ]
  for tt in simple_fold_tests {
    cycle = tt.runes
    r = cycle[cycle.size - 1]
    for out in cycle {
      assert_eq unicode.simple_fold(r), out
      r = out
    }
  }
  assert_eq unicode.simple_fold(-42), -42
}

test "SpecialCaseNoMapping" {
  # Issue 25636
  # no change for rune 'A', zero delta, under upper/lower/title case change.
  d: [Rune; 3] = [0, 0, 0]
  no_change_for_capital_a = unicode.CaseRange.new(lo: 0x41, hi: 0x41, delta: d)
  special = unicode.SpecialCase.new(ranges: [no_change_for_capital_a])
  got = "ABC".runes.map { special.to_lower(it) }
  assert_eq got, "Abc".runes
}

test "NegativeRune" {
  # Issue 43254
  # These tests cover negative rune handling by testing values which,
  # when cast to uint8 or uint16, look like a particular valid rune.
  # This package has Latin-1-specific optimizations, so we test all of
  # Latin-1 and representative non-Latin-1 values in the character
  # categories covered by IsGraphic, etc.
  non_latin1 = [
    0x0100, # Lu: LATIN CAPITAL LETTER A WITH MACRON
    0x0101, # Ll: LATIN SMALL LETTER A WITH MACRON
    0x01C5, # Lt: LATIN CAPITAL LETTER D WITH SMALL LETTER Z WITH CARON
    0x0300, # M: COMBINING GRAVE ACCENT
    0x0660, # Nd: ARABIC-INDIC DIGIT ZERO
    0x037E, # P: GREEK QUESTION MARK
    0x02C2, # S: MODIFIER LETTER LEFT ARROWHEAD
    0x1680, # Z: OGHAM SPACE MARK
  ]
  letter = tab("L")
  max_latin1 = unicode.MAX_LATIN1.to_i
  for i in 0...max_latin1 + non_latin1.size {
    base = i
    base = non_latin1[i - max_latin1] if i >= max_latin1
    # Note r is negative, but r.as_u8 == base.as_u8 and r.as_u16 == base.as_u16.
    r = (base - (1 << 31)).to_i32
    assert !unicode.is(letter, r), "is(Letter, #{base} - 1<<31) = true, want false"
    assert !unicode.is_control(r), "is_control(#{base} - 1<<31) = true, want false"
    assert !unicode.is_digit(r), "is_digit(#{base} - 1<<31) = true, want false"
    assert !unicode.is_graphic(r), "is_graphic(#{base} - 1<<31) = true, want false"
    assert !unicode.is_letter(r), "is_letter(#{base} - 1<<31) = true, want false"
    assert !unicode.is_lower(r), "is_lower(#{base} - 1<<31) = true, want false"
    assert !unicode.is_mark(r), "is_mark(#{base} - 1<<31) = true, want false"
    assert !unicode.is_number(r), "is_number(#{base} - 1<<31) = true, want false"
    assert !unicode.is_print(r), "is_print(#{base} - 1<<31) = true, want false"
    assert !unicode.is_punct(r), "is_punct(#{base} - 1<<31) = true, want false"
    assert !unicode.is_space(r), "is_space(#{base} - 1<<31) = true, want false"
    assert !unicode.is_symbol(r), "is_symbol(#{base} - 1<<31) = true, want false"
    assert !unicode.is_title(r), "is_title(#{base} - 1<<31) = true, want false"
    assert !unicode.is_upper(r), "is_upper(#{base} - 1<<31) = true, want false"
  }
}

bench "ToUpper" { unicode.to_upper(0x3B4) }
bench "ToLower" { unicode.to_lower(0x394) }
bench "SimpleFold Fold" { unicode.simple_fold(0x212A) }

# digit_test.go

test "Digit" {
  for r in test_digit {
    assert unicode.is_digit(r), "is_digit(#{r}) = false, want true"
  }
  for r in test_letter {
    assert !unicode.is_digit(r), "is_digit(#{r}) = true, want false"
  }
}

# Test that the special case in is_digit agrees with the table
test "DigitOptimization" {
  digit = tab("Nd")
  for k in 0..unicode.MAX_LATIN1.to_i {
    i = k.to_i32
    assert_eq unicode.is(digit, i), unicode.is_digit(i)
  }
}

# graphic_test.go: independently check that the special "is" functions work
# in the Latin-1 range through the property table.

test "IsControlLatin1" {
  for k in 0..unicode.MAX_LATIN1.to_i {
    i = k.to_i32
    want = (0x00 <= i && i <= 0x1F) || (0x7F <= i && i <= 0x9F)
    assert_eq unicode.is_control(i), want
  }
}

#[track_caller]
def check_latin1(name: Str, f: (Rune) -> Bool) {
  t = tab(name)
  for k in 0..unicode.MAX_LATIN1.to_i {
    i = k.to_i32
    assert f.call(i) == unicode.is(t, i), "#{name}: U+#{i} incorrect"
  }
}

test "IsLetterLatin1" { check_latin1("L", ->(r: Rune) -> Bool { unicode.is_letter(r) }) }
test "IsUpperLatin1" { check_latin1("Lu", ->(r: Rune) -> Bool { unicode.is_upper(r) }) }
test "IsLowerLatin1" { check_latin1("Ll", ->(r: Rune) -> Bool { unicode.is_lower(r) }) }
test "NumberLatin1" { check_latin1("N", ->(r: Rune) -> Bool { unicode.is_number(r) }) }
test "IsPunctLatin1" { check_latin1("P", ->(r: Rune) -> Bool { unicode.is_punct(r) }) }
test "IsSpaceLatin1" { check_latin1("White_Space", ->(r: Rune) -> Bool { unicode.is_space(r) }) }
test "IsSymbolLatin1" { check_latin1("S", ->(r: Rune) -> Bool { unicode.is_symbol(r) }) }

test "IsPrintLatin1" {
  ranges = unicode.print_ranges
  for k in 0..unicode.MAX_LATIN1.to_i {
    i = k.to_i32
    want = unicode.is_in(i, ranges) || i == 0x20
    assert_eq unicode.is_print(i), want
  }
}

test "IsGraphicLatin1" {
  ranges = unicode.graphic_ranges
  for k in 0..unicode.MAX_LATIN1.to_i {
    i = k.to_i32
    assert_eq unicode.is_graphic(i), unicode.is_in(i, ranges)
  }
}

