#![test(external)]
# Go's letter_test.go, digit_test.go, graphic_test.go, script_test.go and
# example_test.go (package unicode_test), translated. Go's package variables
# (unicode.Letter, unicode.White_Space, ...) are lookups by name here:
# category("L"), property("White_Space").
#
# Not translated: TestCalibrate (a benchmark of Go's linear vs binary search
# cut-off, off unless -calibrate), TestLatinOffset (checks RangeTable's
# LatinOffset field; alx's RangeTable has no R16/R32 split or LatinOffset).
# TestSpecialCaseNoMapping goes through SpecialCase.to_lower rune by rune
# (Go's goes through strings.ToLowerSpecial).

import "fmt"
import "unicode"

def tab(name: Str) -> unicode.RangeTable {
  unicode.category(name) || unicode.property(name) || unicode.script(name).unwrap
}

def upper_test -> [Rune] {
  [
    0x41, 0xc0, 0xd8, 0x100, 0x139, 0x14a, 0x178, 0x181,
    0x376, 0x3cf, 0x13bd, 0x1f2a, 0x2102, 0x2c00, 0x2c10, 0x2c20,
    0xa650, 0xa722, 0xff3a, 0x10400, 0x1d400, 0x1d7ca,
  ]
}

def notupper_test -> [Rune] {
  [
    0x40, 0x5b, 0x61, 0x185, 0x1b0, 0x377, 0x387, 0x2150,
    0xab7d, 0xffff, 0x10000,
  ]
}

def letter_test -> [Rune] {
  [
    0x41, 0x61, 0xaa, 0xba, 0xc8, 0xdb, 0xf9, 0x2ec,
    0x535, 0x620, 0x6e6, 0x93d, 0xa15, 0xb99, 0xdc0, 0xedd,
    0x1000, 0x1200, 0x1312, 0x1401, 0x2c00, 0xa800, 0xf900, 0xfa30,
    0xffda, 0xffdc, 0x10000, 0x10300, 0x10400, 0x20000, 0x2f800, 0x2fa1d,
  ]
}

def notletter_test -> [Rune] {
  [
    0x20, 0x35, 0x375, 0x619, 0x700, 0x1885, 0xfffe, 0x1ffff,
    0x10ffff,
  ]
}

def space_test -> [Rune] {
  [
    0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x20, 0x85, 0xA0,
    0x2000, 0x3000,
  ]
}

