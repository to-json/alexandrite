# Named range tables: Go's unicode.RangeTable and the maps Categories,
# Scripts, FoldCategory, FoldScript and CategoryAliases.
#
#   Go                                  alx
#   unicode.RangeTable{R16, R32}        RangeTable { ranges: [Range] } (R16 and R32 in one list)
#   unicode.Is(tab, r)                  is(tab, r) / tab.contains?(r)
#   unicode.In(r, tabs...)              is_in(r, tabs)
#   unicode.Categories["Lu"]            category("Lu") -> RangeTable?
#   unicode.Scripts["Greek"]            script("Greek") -> RangeTable?
#   unicode.FoldCategory["L"]           fold_category("L") -> RangeTable?
#   unicode.FoldScript["Greek"]         fold_script("Greek") -> RangeTable?
#   unicode.CategoryAliases["Letter"]   category_alias("Letter") -> Str?
#   range over the map keys             category_names, script_names, fold_category_names,
#                                       fold_script_names, category_alias_names (sorted)
#
# The tables are decoded from range_tables.alx (generated from Go's package) on
# each lookup; keep the RangeTable you get if you use it often. Properties
# (unicode.Properties, White_Space, ...) are not included.

# A range of code points lo..hi (inclusive) taking every `stride`-th one.
pub struct Range {
  lo: Rune
  hi: Rune
  stride: Rune
}

# A set of code points as sorted, non-overlapping ranges (Go's RangeTable).
pub struct RangeTable {
  ranges: [Range]

  # Whether `r` is in the table.
  pub def contains?(r: Rune) -> Bool { is(self, r) }
}

# Decodes a table from its generated encoding.
def decode_table(t: Str) -> RangeTable {
  out: [Range] = []
  i = 0
  while i < t.size {
    out << Range.new(lo: d4(t, i).to_i32, hi: d4(t, i + 4).to_i32, stride: d4(t, i + 8).to_i32)
    i += 12
  }
  RangeTable.new(ranges: out)
}

# Whether `r` is in the table `t` (Go's unicode.Is).
pub def is(t: RangeTable, r: Rune) -> Bool {
  rs = t.ranges
  lo = 0
  hi = rs.size
  while lo < hi {
    m = (lo + hi) / 2
    g = rs[m]
    if r < g.lo {
      hi = m
    } else if r > g.hi {
      lo = m + 1
    } else {
      return g.stride == 1 || (r - g.lo) % g.stride == 0
    }
  }
  false
}

# Whether `r` is in any of the tables (Go's unicode.In).
pub def is_in(r: Rune, tabs: [RangeTable]) -> Bool {
  for t in tabs {
    return true if is(t, r)
  }
  false
}

# The general category table named `name` ("L", "Lu", "Nd", "Cn", "LC", ...),
# Go's unicode.Categories[name].
pub def category(name: Str) -> RangeTable? {
  if t = category_data(name) {
    return decode_table(t)
  }
  none
}

# The script table named `name` ("Latin", "Greek", "Han", ...), Go's
# unicode.Scripts[name].
pub def script(name: Str) -> RangeTable? {
  if t = script_data(name) {
    return decode_table(t)
  }
  none
}

# The code points outside category `name` that are equivalent to a code point
# in it under simple case folding (Go's unicode.FoldCategory[name]).
pub def fold_category(name: Str) -> RangeTable? {
  if t = fold_category_data(name) {
    return decode_table(t)
  }
  none
}

# The code points outside script `name` that are equivalent to a code point in
# it under simple case folding (Go's unicode.FoldScript[name]).
pub def fold_script(name: Str) -> RangeTable? {
  if t = fold_script_data(name) {
    return decode_table(t)
  }
  none
}

# The category a long or alternative name stands for ("Letter" -> "L"), Go's
# unicode.CategoryAliases[name].
pub def category_alias(name: Str) -> Str? { category_alias_data(name) }

# The keys of Go's unicode.CategoryAliases, sorted.
pub def category_alias_names -> [Str] { category_alias_names_data }
