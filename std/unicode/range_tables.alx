# The encoded table named `name` in Go's unicode.FoldCategory, or none.
def fold_category_data(name: Str) -> Str? {
  case name {
    "L" => RT_FCAT_L
    "Ll" => RT_FCAT_LL
    "Lt" => RT_FCAT_LT
    "Lu" => RT_FCAT_LU
    "M" => RT_FCAT_M
    "Mn" => RT_FCAT_MN
    _ => none
  }
}

# The names in Go's unicode.FoldCategory, sorted.
pub def fold_category_names -> [Str] {
  ["L", "Ll", "Lt", "Lu", "M", "Mn"]
}

# The encoded table named `name` in Go's unicode.FoldScript, or none.
def fold_script_data(name: Str) -> Str? {
  case name {
    "Common" => RT_FSCRIPT_COMMON
    "Greek" => RT_FSCRIPT_GREEK
    "Inherited" => RT_FSCRIPT_INHERITED
    _ => none
  }
}

# The names in Go's unicode.FoldScript, sorted.
pub def fold_script_names -> [Str] {
  ["Common", "Greek", "Inherited"]
}

