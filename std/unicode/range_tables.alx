# The encoded table named `name` in Go's unicode.Categories, or none.
def category_data(name: Str) -> Str? {
  case name {
    "C" => RT_CAT_C
    "Cc" => RT_CAT_CC
    "Cf" => RT_CAT_CF
    "Cn" => RT_CAT_CN
    "Co" => RT_CAT_CO
    "Cs" => RT_CAT_CS
    "L" => RT_CAT_L
    "LC" => RT_CAT_LC
    "Ll" => RT_CAT_LL
    "Lm" => RT_CAT_LM
    "Lo" => RT_CAT_LO
    "Lt" => RT_CAT_LT
    "Lu" => RT_CAT_LU
    "M" => RT_CAT_M
    "Mc" => RT_CAT_MC
    "Me" => RT_CAT_ME
    "Mn" => RT_CAT_MN
    "N" => RT_CAT_N
    "Nd" => RT_CAT_ND
    "Nl" => RT_CAT_NL
    "No" => RT_CAT_NO
    "P" => RT_CAT_P
    "Pc" => RT_CAT_PC
    "Pd" => RT_CAT_PD
    "Pe" => RT_CAT_PE
    "Pf" => RT_CAT_PF
    "Pi" => RT_CAT_PI
    "Po" => RT_CAT_PO
    "Ps" => RT_CAT_PS
    "S" => RT_CAT_S
    "Sc" => RT_CAT_SC
    "Sk" => RT_CAT_SK
    "Sm" => RT_CAT_SM
    "So" => RT_CAT_SO
    "Z" => RT_CAT_Z
    "Zl" => RT_CAT_ZL
    "Zp" => RT_CAT_ZP
    "Zs" => RT_CAT_ZS
    _ => none
  }
}

# The names in Go's unicode.Categories, sorted.
pub def category_names -> [Str] {
  ["C", "Cc", "Cf", "Cn", "Co", "Cs", "L", "LC", "Ll", "Lm", "Lo", "Lt", "Lu", "M", "Mc", "Me", "Mn", "N", "Nd", "Nl", "No", "P", "Pc", "Pd", "Pe", "Pf", "Pi", "Po", "Ps", "S", "Sc", "Sk", "Sm", "So", "Z", "Zl", "Zp", "Zs"]
}

