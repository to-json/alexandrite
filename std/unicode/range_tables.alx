    "Modifier_Symbol" => "Sk"
    "Nonspacing_Mark" => "Mn"
    "Number" => "N"
    "Open_Punctuation" => "Ps"
    "Other" => "C"
    "Other_Letter" => "Lo"
    "Other_Number" => "No"
    "Other_Punctuation" => "Po"
    "Other_Symbol" => "So"
    "Paragraph_Separator" => "Zp"
