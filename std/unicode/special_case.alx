# Case ranges and special casing: Go's unicode.To, CaseRange, CaseRanges,
# SpecialCase, TurkishCase and AzeriCase (letter.go, casetables.go).

pub UPPER_CASE = 0
pub LOWER_CASE = 1
pub TITLE_CASE = 2
pub MAX_CASE = 3

# In a CaseRange's delta, UPPER_LOWER means the range alternates upper and
# lower case (even offsets from `lo` upper, odd ones lower), Go's UpperLower.
pub UPPER_LOWER: Rune = 0x110000

# A range of code points lo..hi (inclusive) whose upper, lower and title case
# forms are each `r + delta[case]` (Go's CaseRange).
pub struct CaseRange {
  lo: U32
  hi: U32
  delta: [Rune; 3]
}

# The case mapping `r` to case `c` (UPPER_CASE, LOWER_CASE or TITLE_CASE)
# through `ranges`, and whether a range covered `r` (Go's unexported `to`).
def to_through(c: Int, r: Rune, ranges: [CaseRange]) -> (Rune, Bool) {
  return (REPLACEMENT_CHAR, false) if c < 0 || c >= MAX_CASE
  lo = 0
  hi = ranges.size
  while lo < hi {
    m = (lo + hi) / 2
    cr = ranges[m]
    first = cr.lo.to_i
    if first <= r.to_i && r.to_i <= cr.hi.to_i {
      delta = cr.delta[c]
      if delta > MAX_RUNE {
        # An Upper-Lower sequence: even offsets are upper case, odd lower.
        return ((first + (((r.to_i - first) & ^1) | (c & 1))).to_i32, true)
      }
      return (r + delta, true)
    }
    if r.to_i < first {
      hi = m
    } else {
      lo = m + 1
    }
  }
  (r, false)
}

# Maps `r` to case `c`: UPPER_CASE, LOWER_CASE or TITLE_CASE (Go's To). An
# unknown case gives REPLACEMENT_CHAR.
pub def to(c: Int, r: Rune) -> Rune {
  return REPLACEMENT_CHAR if c < 0 || c >= MAX_CASE
  if c == UPPER_CASE {
    to_upper(r)
  } else if c == LOWER_CASE {
    to_lower(r)
  } else {
    to_title(r)
  }
}

# Go's unicode.CaseRanges: the table to_upper, to_lower and to_title use.
pub def case_ranges -> [CaseRange] {
  t = CASE_RANGES
  out: [CaseRange] = []
  i = 0
  while i < t.size {
    d: [Rune; 3] = [0; 3]
    for k in 0...3 {
      v = d4(t, i + 8 + k * 4)
      d[k] = v == CASE_ALT ? UPPER_LOWER : (v - CASE_BIAS).to_i32
    }
    out << CaseRange.new(lo: d4(t, i).to_u32, hi: d4(t, i + 4).to_u32, delta: d)
    i += 20
  }
  out
}

# Language-specific case mappings, consulted before the default ones (Go's
# SpecialCase). The ranges must be sorted by `lo`.
pub struct SpecialCase {
  ranges: [CaseRange]

  # The upper case form of `r`, giving priority to the special mappings.
  pub def to_upper(r: Rune) -> Rune {
    r1, had = to_through(UPPER_CASE, r, ranges)
    return unicode_to_upper(r) if r1 == r && !had
    r1
  }

  # The title case form of `r`, giving priority to the special mappings.
  pub def to_title(r: Rune) -> Rune {
    r1, had = to_through(TITLE_CASE, r, ranges)
    return unicode_to_title(r) if r1 == r && !had
    r1
  }

  # The lower case form of `r`, giving priority to the special mappings.
  pub def to_lower(r: Rune) -> Rune {
    r1, had = to_through(LOWER_CASE, r, ranges)
    return unicode_to_lower(r) if r1 == r && !had
    r1
  }
}

# The package-level mappings, under names the SpecialCase methods don't shadow.
def unicode_to_upper(r: Rune) -> Rune { to_upper(r) }
def unicode_to_lower(r: Rune) -> Rune { to_lower(r) }
def unicode_to_title(r: Rune) -> Rune { to_title(r) }

def cr(lo: Int, hi: Int, u: Int, l: Int, t: Int) -> CaseRange {
  d: [Rune; 3] = [u.to_i32, l.to_i32, t.to_i32]
  CaseRange.new(lo: lo.to_u32, hi: hi.to_u32, delta: d)
}

# Turkish and Azeri casing: dotted and dotless I (Go's TurkishCase).
pub def turkish_case -> SpecialCase {
  SpecialCase.new(ranges: [
    cr(0x0049, 0x0049, 0, 0x131 - 0x49, 0),
    cr(0x0069, 0x0069, 0x130 - 0x69, 0, 0x130 - 0x69),
    cr(0x0130, 0x0130, 0, 0x69 - 0x130, 0),
    cr(0x0131, 0x0131, 0x49 - 0x131, 0, 0x49 - 0x131),
  ])
}

# Go's AzeriCase: the same mappings as turkish_case.
pub def azeri_case -> SpecialCase { turkish_case }
