test "exhaustive is_print and is_graphic" {
  n = 0
  sum = 0
  gn = 0
  gsum = 0
  i = 0
  while i <= 0x10FFFF {
    if is_print(rn(i)) {
      n += 1
      sum += i % 1000003 + 1
    }
    if is_graphic(rn(i)) {
      gn += 1
      gsum += i % 1000003 + 1
    }
    i += 1
  }
  assert_eq n, 159613
  assert_eq sum, 17258723442
  assert_eq gn, 159629
  assert_eq gsum, 17258848359
}

test "exhaustive to_upper" {
  diff = 0
  sum = 0
  i = 0
  while i <= 0x10FFFF {
    v = to_upper(rn(i)).to_i
    diff += 1 if v != i
    sum += v % 1000003
    i += 1
  }
  assert_eq diff, 1505
  assert_eq sum, 506510212401
}

test "exhaustive to_lower" {
  diff = 0
  sum = 0
  i = 0
  while i <= 0x10FFFF {
    v = to_lower(rn(i)).to_i
