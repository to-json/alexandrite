# The expected counts and checksums below come from running Go's package
# unicode over every code point 0..0x10FFFF (Go 1.27, Unicode 17.0.0): the
# number of members and the sum of (r % 1000003 + 1) over them; for the
# mappings, the number of runes that change and the sum of (f(r) % 1000003).

def rn(i: Int) -> Rune { i.to_i32 }

test "exhaustive is_letter" {
  n = 0
  sum = 0
  i = 0
  while i <= 0x10FFFF {
    if is_letter(rn(i)) {
      n += 1
      sum += i % 1000003 + 1
    }
    i += 1
  }
  assert_eq n, 145672
  assert_eq sum, 16169150918
}

test "exhaustive is_digit" {
  n = 0
  sum = 0
  i = 0
  while i <= 0x10FFFF {
    if is_digit(rn(i)) {
      n += 1
      sum += i % 1000003 + 1
    }
    i += 1
  }
  assert_eq n, 770
  assert_eq sum, 40624105
}

