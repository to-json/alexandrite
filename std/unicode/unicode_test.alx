    v = simple_fold(rn(i)).to_i
    diff += 1 if v != i
    sum += v % 1000003
    i += 1
  }
  assert_eq diff, 2994
  assert_eq sum, 506512874889
}

test "out of range runes" {
  assert !is_letter(-1)
  assert !is_digit(-1)
  assert !is_space(-1)
  assert !is_upper(-1)
  assert !is_punct(0x110000)
  assert !is_letter(0x110000)
  assert !is_control(-1)
  assert_eq to_upper(-1), -1
  assert_eq to_lower(0x110000), 0x110000
  assert_eq simple_fold(0x110000), 0x110000
  assert_eq simple_fold(-5), -5
}

test "ASCII" {
  assert is_letter(0x41)
  assert is_letter(0x7A)
  assert !is_letter(0x40)
  assert !is_letter(0x5B)
  assert is_digit(0x30)
  assert is_digit(0x39)
  assert !is_digit(0x2F)
  assert is_number(0x35)
  assert is_space(0x20)
  assert is_space(0x09)
  assert is_space(0x0A)
  assert is_space(0x0D)
  assert !is_space(0x00)
  assert is_upper(0x5A)
  assert !is_upper(0x61)
  assert is_lower(0x61)
  assert !is_lower(0x41)
  assert is_punct(0x21)
  assert is_punct(0x5F)
  assert !is_punct(0x24)
  assert is_symbol(0x24)
  assert is_symbol(0x2B)
  assert is_control(0)
  assert is_control(0x7F)
  assert !is_control(0x20)
  assert is_print(0x20)
  assert is_print(0x7E)
  assert !is_print(0x7F)
  assert !is_print(0x0A)
  assert_eq to_upper(0x61), 0x41
  assert_eq to_lower(0x5A), 0x7A
  assert_eq to_title(0x7A), 0x5A
  assert_eq to_upper(0x31), 0x31
}

test "Latin-1" {
  assert is_letter(0xE9)
  assert is_lower(0xE9)
  assert is_upper(0xC9)
  assert is_space(0x85)
  assert is_space(0xA0)
  assert !is_print(0xA0)
  assert is_graphic(0xA0)
  assert !is_print(0xAD)
  assert is_number(0xB2)
  assert !is_digit(0xB2)
  assert is_punct(0xA1)
  assert is_symbol(0xA9)
  assert_eq to_upper(0xE9), 0xC9
  assert_eq to_lower(0xC9), 0xE9
  assert_eq to_upper(0xFF), 0x178
  assert_eq to_upper(0xB5), 0x39C
  assert_eq to_upper(0xDF), 0xDF
  assert is_control(0x85)
}

test "wider ranges" {
  assert is_letter(0x3B1)   # greek alpha
  assert is_letter(0x416)   # cyrillic zhe
  assert is_letter(0x4E2D)  # CJK ideograph
  assert is_letter(0x3042)  # hiragana
  assert is_letter(0x10400) # deseret
  assert is_space(0x3000)
  assert is_space(0x2003)
  assert is_space(0x2028)
  assert !is_space(0x200B)
  assert is_digit(0x661)   # arabic-indic one
  assert is_number(0x2160) # roman numeral one
  assert !is_digit(0x2160)
  assert is_mark(0x301)
  assert is_title(0x1C5)
  assert_eq to_upper(0x3B1), 0x391
  assert_eq to_lower(0x416), 0x436
  assert_eq to_lower(0x130), 0x69
  assert_eq to_upper(0x131), 0x49
  assert_eq to_upper(0x101), 0x100
  assert_eq to_lower(0x100), 0x101
  assert_eq to_upper(0x17F), 0x53
  assert_eq to_title(0x1C4), 0x1C5
  assert_eq to_title(0x1C6), 0x1C5
  assert_eq to_upper(0x1C5), 0x1C4
  assert_eq to_lower(0x1C5), 0x1C6
  assert_eq to_lower(0x3A3), 0x3C3
  assert_eq to_upper(0x3C2), 0x3A3
  assert_eq to_upper(0x10428), 0x10400
}

test "simple_fold orbits" {
  assert_eq simple_fold(0x41), 0x61
  assert_eq simple_fold(0x61), 0x41
  assert_eq simple_fold(0x4B), 0x6B
  assert_eq simple_fold(0x6B), 0x212A
  assert_eq simple_fold(0x212A), 0x4B
  assert_eq simple_fold(0x53), 0x73
  assert_eq simple_fold(0x73), 0x17F
  assert_eq simple_fold(0x17F), 0x53
  assert_eq simple_fold(0x31), 0x31
  assert_eq simple_fold(0x3A3), 0x3C2
  assert_eq simple_fold(0x3C2), 0x3C3
  assert_eq simple_fold(0x3C3), 0x3A3
}

test "constants" {
  assert_eq MAX_RUNE, 0x10FFFF
  assert_eq REPLACEMENT_CHAR, 0xFFFD
  assert_eq MAX_ASCII, 0x7F
  assert_eq MAX_LATIN1, 0xFF
  assert_eq VERSION, "17.0.0"
}
