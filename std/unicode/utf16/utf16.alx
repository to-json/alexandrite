# Package utf16: Go's unicode/utf16 — encoding and decoding of UTF-16
# sequences.
#
# API: IsSurrogate → is_surrogate, DecodeRune → decode_rune, EncodeRune →
# encode_rune (a tuple), RuneLen → rune_len, Encode → encode, AppendRune →
# append_rune, Decode → decode. UTF-16 code units are `U16`.
#
# Differences from Go:
#  - append_rune appends to its slice (`a << u`) and returns it; alx slices
#    share storage like Go's, so `a = append_rune(a, r)` works as in Go.
#  - The constants Go's export_test.go exposes (MaxRune, ReplacementChar) are
#    public here as REPLACEMENT_CHAR and MAX_RUNE; the surrogate bounds stay
#    private.

pub REPLACEMENT_CHAR: Rune = 0xFFFD # the Unicode replacement character
pub MAX_RUNE: Rune = 0x10FFFF       # the largest valid code point

# 0xd800-0xdc00 encodes the high 10 bits of a pair, 0xdc00-0xe000 the low 10
# bits; the value is those 20 bits plus 0x10000.
SURR1: Rune = 0xD800
SURR2: Rune = 0xDC00
SURR3: Rune = 0xE000
SURR_SELF: Rune = 0x10000

# Whether r can appear in a surrogate pair.
pub def is_surrogate(r: Rune) -> Bool {
  SURR1 <= r && r < SURR3
}

# The code point of the surrogate pair (r1, r2); U+FFFD if it isn't a valid
# pair.
pub def decode_rune(r1: Rune, r2: Rune) -> Rune {
  if SURR1 <= r1 && r1 < SURR2 && SURR2 <= r2 && r2 < SURR3 {
    return ((r1 - SURR1) << 10 | (r2 - SURR2)) + SURR_SELF
  }
  REPLACEMENT_CHAR
}

# The surrogate pair for r; (U+FFFD, U+FFFD) if r is not a valid code point
# or needs no pair.
pub def encode_rune(r: Rune) -> (Rune, Rune) {
  return (REPLACEMENT_CHAR, REPLACEMENT_CHAR) if r < SURR_SELF || r > MAX_RUNE
  v = r - SURR_SELF
  (SURR1 + ((v >> 10) & 0x3FF), SURR2 + (v & 0x3FF))
}

# The number of 16-bit words in the UTF-16 encoding of r; -1 if r can't be
# encoded.
pub def rune_len(r: Rune) -> Int {
  if (0 <= r && r < SURR1) || (SURR3 <= r && r < SURR_SELF) {
    1
  } else if SURR_SELF <= r && r <= MAX_RUNE {
    2
  } else {
    -1
  }
}

# The UTF-16 encoding of the code points s.
pub def encode(s: [Rune]) -> [U16] {
  a: [U16] = []
  for v in s {
    a = append_rune(a, v)
  }
  a
}

# Appends the UTF-16 encoding of r to a (U+FFFD's if r is not a valid code
# point); returns a.
pub def append_rune(a: [U16], r: Rune) -> [U16] {
  out = a
  if (0 <= r && r < SURR1) || (SURR3 <= r && r < SURR_SELF) {
    out << r.as_u16
  } else if SURR_SELF <= r && r <= MAX_RUNE {
    r1, r2 = encode_rune(r)
    out << r1.as_u16
    out << r2.as_u16
  } else {
    out << REPLACEMENT_CHAR.as_u16
  }
  out
}

# The code points the UTF-16 encoding s represents; an unpaired surrogate
# decodes as U+FFFD.
pub def decode(s: [U16]) -> [Rune] {
  buf: [Rune] = []
  i = 0
  while i < s.size {
    r = s[i].as_i32
    if r < SURR1 || SURR3 <= r {
      buf << r
    } else if r < SURR2 && i + 1 < s.size && SURR2 <= s[i + 1].as_i32 && s[i + 1].as_i32 < SURR3 {
      buf << decode_rune(r, s[i + 1].as_i32)
      i += 1
    } else {
      buf << REPLACEMENT_CHAR
    }
    i += 1
  }
  buf
}
