import "unicode"

test "constants" {
  assert_eq MAX_RUNE, unicode.MAX_RUNE
  assert_eq REPLACEMENT_CHAR, unicode.REPLACEMENT_CHAR
}

test "rune_len" {
  cases: [(Rune, Int)] = [(0, 1), (SURR1 - 1, 1), (SURR3, 1), (SURR_SELF - 1, 1), (SURR_SELF, 2), (MAX_RUNE, 2), (MAX_RUNE + 1, -1), (-1, -1)]
  for c in cases {
    assert_eq rune_len(c[0]), c[1]
  }
}

def encode_tests -> [([Rune], [U16])] {
  t: [([Rune], [U16])] = [
    ([1, 2, 3, 4], [1, 2, 3, 4]),
    ([0xffff, 0x10000, 0x10001, 0x12345, 0x10ffff], [0xffff, 0xd800, 0xdc00, 0xd800, 0xdc01, 0xd808, 0xdf45, 0xdbff, 0xdfff]),
    ([0x61, 0x62, 0xd7ff, 0xd800, 0xdfff, 0xe000, 0x110000, -1], [0x61, 0x62, 0xd7ff, 0xfffd, 0xfffd, 0xe000, 0xfffd, 0xfffd]),
  ]
  t
}

test "encode" {
  for tt in encode_tests {
    assert_eq encode(tt[0]), tt[1]
  }
}

test "append_rune" {
  for tt in encode_tests {
    out: [U16] = []
    for u in tt[0] {
      out = append_rune(out, u)
    }
    assert_eq out, tt[1]
  }
}

test "encode_rune" {
  for tt in encode_tests {
    j = 0
    for r in tt[0] {
      r1, r2 = encode_rune(r)
      if r < 0x10000 || r > unicode.MAX_RUNE {
        assert j < tt[1].size, "ran out of tt.out"
        assert_eq r1, unicode.REPLACEMENT_CHAR
        assert_eq r2, unicode.REPLACEMENT_CHAR
        j += 1
      } else {
        assert j + 1 < tt[1].size, "ran out of tt.out"
        assert_eq r1, tt[1][j].as_i32
        assert_eq r2, tt[1][j + 1].as_i32
        j += 2
        assert_eq decode_rune(r1, r2), r
      }
    }
    assert_eq j, tt[1].size
  }
}

test "decode" {
  cases: [([U16], [Rune])] = [
    ([1, 2, 3, 4], [1, 2, 3, 4]),
    ([0xffff, 0xd800, 0xdc00, 0xd800, 0xdc01, 0xd808, 0xdf45, 0xdbff, 0xdfff], [0xffff, 0x10000, 0x10001, 0x12345, 0x10ffff]),
    ([0xd800, 0x61], [0xfffd, 0x61]),
    ([0xdfff], [0xfffd]),
  ]
  for tt in cases {
    assert_eq decode(tt[0]), tt[1]
  }
}

test "decode_rune" {
  cases: [(Rune, Rune, Rune)] = [(0xd800, 0xdc00, 0x10000), (0xd800, 0xdc01, 0x10001), (0xd808, 0xdf45, 0x12345), (0xdbff, 0xdfff, 0x10ffff), (0xd800, 0x61, 0xfffd)]
  for tt in cases {
    assert_eq decode_rune(tt[0], tt[1]), tt[2]
  }
}

test "is_surrogate" {
  cases: [(Rune, Bool)] = [(0x7A, false), (0x6C34, false), (0xFEFF, false), (0x10000, false), (0x1D11E, false), (0x10FFFD, false), (0xd7ff, false), (0xd800, true), (0xdc00, true), (0xe000, false), (0xdfff, true)]
  for tt in cases {
    assert_eq is_surrogate(tt[0]), tt[1]
  }
}

bench "decode valid ascii" {
  data: [U16] = [104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100]
  decode(data)
}

bench "decode valid japanese" {
  data: [U16] = [26085, 26412, 35486, 26085, 26412, 35486, 26085, 26412, 35486]
  decode(data)
}

bench "decode_rune" {
  rs: [Rune] = [0; 10]
  i = 0
  for u in "𝓐𝓑𝓒𝓓𝓔".runes {
    a, b = encode_rune(u)
    rs[2 * i] = a
    rs[2 * i + 1] = b
    i += 1
  }
  j = 0
  while j < 5 {
    decode_rune(rs[2 * j], rs[2 * j + 1])
    j += 1
  }
}

bench "encode valid ascii" {
  encode("hello".runes)
}

bench "encode valid japanese" {
  encode("日本語".runes)
}

bench "append_rune valid ascii" {
  a: [U16] = []
  for u in "hello".runes {
    a = append_rune(a, u)
  }
}

bench "encode_rune" {
  for u in "𝓐𝓑𝓒𝓓𝓔".runes {
    encode_rune(u)
  }
}
