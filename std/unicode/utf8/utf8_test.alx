def bs(xs: [U8]) -> Str { Str.from_bytes(xs) }

# slices have no == yet
def eqb(a: [U8], b: [U8]) -> Bool { Str.from_bytes(a) == Str.from_bytes(b) }

test "rune_len" {
  assert_eq rune_len(0x41), 1
  assert_eq rune_len(0x7F), 1
  assert_eq rune_len(0x80), 2
  assert_eq rune_len(0x7FF), 2
  assert_eq rune_len(0x800), 3
  assert_eq rune_len(0xD7FF), 3
  assert_eq rune_len(0xD800), -1
  assert_eq rune_len(0xDFFF), -1
  assert_eq rune_len(0xE000), 3
  assert_eq rune_len(0xFFFF), 3
  assert_eq rune_len(0x10000), 4
  assert_eq rune_len(0x10FFFF), 4
  assert_eq rune_len(0x110000), -1
  assert_eq rune_len(-1), -1
}

test "constants" {
  assert_eq RUNE_ERROR, 0xFFFD
  assert_eq MAX_RUNE, 0x10FFFF
  assert_eq UTF_MAX, 4
  assert_eq RUNE_SELF, 0x80
}

test "valid_rune" {
  assert valid_rune(0)
  assert valid_rune(0x41)
  assert valid_rune(0xD7FF)
  assert !valid_rune(0xD800)
  assert !valid_rune(0xDFFF)
  assert valid_rune(0xE000)
  assert valid_rune(0x10FFFF)
  assert !valid_rune(0x110000)
  assert !valid_rune(-1)
}

test "rune_start" {
  assert rune_start(0x41)
  assert rune_start(0xC3)
  assert !rune_start(0x80)
  assert !rune_start(0xBF)
  assert rune_start(0xC0)
}

test "decode_rune_in_string valid" {
  r, n = decode_rune_in_string("a")
  assert_eq r, 0x61
  assert_eq n, 1
  r, n = decode_rune_in_string("é")
  assert_eq r, 0xE9
  assert_eq n, 2
  r, n = decode_rune_in_string("€x")
  assert_eq r, 0x20AC
  assert_eq n, 3
  r, n = decode_rune_in_string("😀")
  assert_eq r, 0x1F600
  assert_eq n, 4
  r, n = decode_rune_in_string(bs([0xF4, 0x8F, 0xBF, 0xBF]))
  assert_eq r, 0x10FFFF
  assert_eq n, 4
  r, n = decode_rune_in_string(bs([0xED, 0x9F, 0xBF]))
  assert_eq r, 0xD7FF
  assert_eq n, 3
  r, n = decode_rune_in_string(bs([0xEE, 0x80, 0x80]))
  assert_eq r, 0xE000
  assert_eq n, 3
  r, n = decode_rune_in_string(bs([0xC2, 0x80]))
  assert_eq r, 0x80
  assert_eq n, 2
}

test "decode_rune_in_string empty and invalid" {
  r, n = decode_rune_in_string("")
  assert_eq r, RUNE_ERROR
  assert_eq n, 0
  bad: [[U8]] = [
    [0x80], [0xBF], [0xC0, 0x80], [0xC1, 0xBF], [0xC3], [0xC3, 0x41],
    [0xE0, 0x80, 0x80], [0xE0, 0x9F, 0xBF], [0xED, 0xA0, 0x80], [0xED, 0xBF, 0xBF],
    [0xE2, 0x82], [0xE2, 0x82, 0x41], [0xE2, 0x41, 0xAC],
    [0xF0, 0x80, 0x80, 0x80], [0xF0, 0x8F, 0xBF, 0xBF], [0xF4, 0x90, 0x80, 0x80],
    [0xF5, 0x80, 0x80, 0x80], [0xF8, 0x88, 0x80, 0x80, 0x80], [0xFE], [0xFF],
    [0xF0, 0x90, 0x80], [0xF0, 0x90, 0x80, 0x41],
  ]
  for b in bad {
    r, n = decode_rune_in_string(bs(b))
    assert_eq r, RUNE_ERROR
    assert_eq n, 1
  }
}

test "decode_rune_at" {
  s = "a€😀"
  r, n = decode_rune_at(s, 0)
  assert_eq r, 0x61
  r, n = decode_rune_at(s, 1)
  assert_eq r, 0x20AC
  assert_eq n, 3
  r, n = decode_rune_at(s, 4)
  assert_eq r, 0x1F600
  assert_eq n, 4
  r, n = decode_rune_at(s, 5)
  assert_eq r, RUNE_ERROR
  assert_eq n, 1
  r, n = decode_rune_at(s, 8)
  assert_eq n, 0
  r, n = decode_rune_at(s, 99)
  assert_eq n, 0
}

test "decode_last_rune_in_string" {
  r, n = decode_last_rune_in_string("")
  assert_eq r, RUNE_ERROR
  assert_eq n, 0
  r, n = decode_last_rune_in_string("abc")
  assert_eq r, 0x63
  assert_eq n, 1
  r, n = decode_last_rune_in_string("aé")
  assert_eq r, 0xE9
  assert_eq n, 2
  r, n = decode_last_rune_in_string("a€")
  assert_eq r, 0x20AC
  assert_eq n, 3
  r, n = decode_last_rune_in_string("a😀")
  assert_eq r, 0x1F600
  assert_eq n, 4
  r, n = decode_last_rune_in_string(bs([0x41, 0x80]))
  assert_eq r, RUNE_ERROR
  assert_eq n, 1
  r, n = decode_last_rune_in_string(bs([0xE2, 0x82]))
  assert_eq r, RUNE_ERROR
  assert_eq n, 1
  r, n = decode_last_rune_in_string(bs([0xE2, 0x82, 0xAC, 0xAC]))
  assert_eq r, RUNE_ERROR
  assert_eq n, 1
  r, n = decode_last_rune_in_string(bs([0x80, 0x80, 0x80, 0x80, 0x80]))
  assert_eq r, RUNE_ERROR
  assert_eq n, 1
}

test "encode_rune and append_rune" {
  assert eqb(encode_rune(0x41), [0x41])
  assert eqb(encode_rune(0xE9), [0xC3, 0xA9])
  assert eqb(encode_rune(0x20AC), [0xE2, 0x82, 0xAC])
  assert eqb(encode_rune(0x1F600), [0xF0, 0x9F, 0x98, 0x80])
  assert eqb(encode_rune(0x10FFFF), [0xF4, 0x8F, 0xBF, 0xBF])
  assert eqb(encode_rune(0xD800), [0xEF, 0xBF, 0xBD])
  assert eqb(encode_rune(0x110000), [0xEF, 0xBF, 0xBD])
  assert eqb(encode_rune(-5), [0xEF, 0xBF, 0xBD])
  buf = append_rune(append_rune([0x68], 0x20AC), 0x69)
  assert eqb(buf, [0x68, 0xE2, 0x82, 0xAC, 0x69])
}

test "encode/decode round trip" {
  for r in [0, 1, 0x7F, 0x80, 0x7FF, 0x800, 0xD7FF, 0xE000, 0xFFFD, 0xFFFF, 0x10000, 0x10FFFF] {
    rr = r.to_i32
    b = encode_rune(rr)
    assert_eq b.size, rune_len(rr)
    got, n = decode_rune_in_string(Str.from_bytes(b))
    assert_eq got, rr
    assert_eq n, b.size
    got, n = decode_last_rune_in_string(Str.from_bytes(b))
    assert_eq got, rr
    assert_eq n, b.size
  }
}

test "rune_count_in_string" {
  assert_eq rune_count_in_string(""), 0
  assert_eq rune_count_in_string("abc"), 3
  assert_eq rune_count_in_string("héllo"), 5
  assert_eq rune_count_in_string("日本語"), 3
  assert_eq rune_count_in_string("a😀b"), 3
  assert_eq rune_count_in_string(bs([0x61, 0xFF, 0x62])), 3
  assert_eq rune_count_in_string(bs([0xE2, 0x82])), 2
  assert_eq rune_count_in_string(bs([0xED, 0xA0, 0x80])), 3
}

test "valid_string" {
  assert valid_string("")
  assert valid_string("hello, 世界 😀")
  assert !valid_string(bs([0xFF]))
  assert !valid_string(bs([0x61, 0xC3]))
  assert !valid_string(bs([0xED, 0xA0, 0x80]))
  assert !valid_string(bs([0xF4, 0x90, 0x80, 0x80]))
  assert !valid_string(bs([0xC0, 0xAF]))
  assert valid_string(bs([0xEF, 0xBF, 0xBD]))
  assert !valid_string(bs([0x80]))
}

test "full_rune_in_string" {
  assert !full_rune_in_string("")
  assert full_rune_in_string("a")
  assert full_rune_in_string("é")
  assert !full_rune_in_string(bs([0xC3]))
  assert !full_rune_in_string(bs([0xE2]))
  assert !full_rune_in_string(bs([0xE2, 0x82]))
  assert full_rune_in_string("€")
  assert !full_rune_in_string(bs([0xF0, 0x9F, 0x98]))
  assert full_rune_in_string("😀")
  assert full_rune_in_string(bs([0x80]))
  assert full_rune_in_string(bs([0xFF]))
  assert full_rune_in_string(bs([0xE0, 0x80]))
  assert full_rune_in_string(bs([0xED, 0xA0]))
  assert full_rune_in_string(bs([0xF4, 0x90]))
  assert full_rune_in_string(bs([0xE2, 0x41]))
  assert full_rune_in_string(bs([0xF0, 0x9F, 0x41]))
}

test "byte slice variants" {
  assert valid([0x68, 0xC3, 0xA9])
  assert !valid([0xC3])
  assert_eq rune_count([0x68, 0xC3, 0xA9]), 2
  r, n = decode_rune([0xE2, 0x82, 0xAC])
  assert_eq r, 0x20AC
  assert_eq n, 3
  r, n = decode_last_rune([0x61, 0xC3, 0xA9])
  assert_eq r, 0xE9
  assert_eq n, 2
  assert full_rune([0xC3, 0xA9])
  assert !full_rune([0xC3])
}
