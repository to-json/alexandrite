# Generated from Go's unicode/utf8 (go1.27.1) by a throwaway Go program; do not edit by hand.
# vchk(bytes, decode_rune (r, n), decode_last_rune (r, n), full_rune, rune_count, valid, runes)
# checks the Str and [U8] forms of each function and Str.runes;
# vrune(r, rune_len, valid_rune, encoding) checks rune_len, valid_rune, encode_rune,
# encode_rune_into and append_rune.

def vb(xs: [Int]) -> [U8] { xs.map { it.as_u8 } }

#[track_caller]
def vchk(b: [Int], r1: Int, n1: Int, r2: Int, n2: Int, full: Bool, count: Int, ok: Bool, runes: [Int]) {
  bytes = vb(b)
  s = Str.from_bytes(bytes)
  assert_eq decode_rune_in_string(s), (r1.to_i32, n1)
  assert_eq decode_rune(bytes), (r1.to_i32, n1)
  assert_eq decode_last_rune_in_string(s), (r2.to_i32, n2)
  assert_eq decode_last_rune(bytes), (r2.to_i32, n2)
  assert_eq full_rune_in_string(s), full
  assert_eq full_rune(bytes), full
  assert_eq rune_count_in_string(s), count
  assert_eq rune_count(bytes), count
  assert_eq valid_string(s), ok
  assert_eq valid(bytes), ok
  assert_eq s.runes, runes.map { it.to_i32 }
}

#[track_caller]
def vrune(r: Int, n: Int, ok: Bool, enc: [Int]) {
  c = r.to_i32
  assert_eq rune_len(c), n
  assert_eq valid_rune(c), ok
  assert_eq encode_rune(c), vb(enc)
  buf: [U8] = [0; 4]
  k = encode_rune_into(buf, c)
  assert_eq buf[0...k], vb(enc)
  pre: [U8] = [0x61]
  assert_eq append_rune(pre, c), vb([0x61] + enc)
}

