  assert_eq category_alias("Mark") || "", "M"
  assert_eq category_alias("Math_Symbol") || "", "Sm"
  assert_eq category_alias("Modifier_Letter") || "", "Lm"
  assert_eq category_alias("Modifier_Symbol") || "", "Sk"
  assert_eq category_alias("Nonspacing_Mark") || "", "Mn"
  assert_eq category_alias("Number") || "", "N"
  assert_eq category_alias("Open_Punctuation") || "", "Ps"
  assert_eq category_alias("Other") || "", "C"
  assert_eq category_alias("Other_Letter") || "", "Lo"
  assert_eq category_alias("Other_Number") || "", "No"
  assert_eq category_alias("Other_Punctuation") || "", "Po"
  assert_eq category_alias("Other_Symbol") || "", "So"
  assert_eq category_alias("Paragraph_Separator") || "", "Zp"
