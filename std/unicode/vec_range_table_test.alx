  assert_eq t.ranges.size, 2
  assert_eq [71840, 71935, 71922, 71935].select { |r| t.contains?(r.to_i32) }.size, 4
  assert_eq [71839, 71923, 137631, 88199, 187145, 47292].select { |r| t.contains?(r.to_i32) }.size, 0
  t = script("Yezidi").unwrap
  assert_eq t.ranges.size, 3
  assert_eq [69296, 69297, 69248].select { |r| t.contains?(r.to_i32) }.size, 3
  assert_eq [69298, 69290, 69290, 20262, 146280, 156986, 135735].select { |r| t.contains?(r.to_i32) }.size, 0
  t = script("Yi").unwrap
  assert_eq t.ranges.size, 2
  assert_eq [40960, 42128, 42124, 42182].select { |r| t.contains?(r.to_i32) }.size, 4
  assert_eq [40959, 42127, 191032, 157598, 133974, 118199].select { |r| t.contains?(r.to_i32) }.size, 0
  t = script("Zanabazar_Square").unwrap
  assert_eq t.ranges.size, 1
  assert_eq [72263, 72192].select { |r| t.contains?(r.to_i32) }.size, 2
  assert_eq [72191, 72264, 194167, 190545, 102608, 187173].select { |r| t.contains?(r.to_i32) }.size, 0
}

test "fold_category tables 0" {
  t = fold_category("L").unwrap
  assert_eq t.ranges.size, 1
  assert_eq [837, 837].select { |r| t.contains?(r.to_i32) }.size, 2
  assert_eq [836, 838, 23033, 190994, 70499, 21870].select { |r| t.contains?(r.to_i32) }.size, 0
  t = fold_category("Ll").unwrap
  assert_eq t.ranges.size, 121
  assert_eq [452, 66964, 42948].select { |r| t.contains?(r.to_i32) }.size, 3
  assert_eq [7952, 42605, 436, 77246, 193693, 193176, 134054].select { |r| t.contains?(r.to_i32) }.size, 0
  t = fold_category("Lt").unwrap
  assert_eq t.ranges.size, 9
  assert_eq [497, 458, 8179, 8071, 8064, 457].select { |r| t.contains?(r.to_i32) }.size, 6
  assert_eq [96787, 100787, 92536, 159134].select { |r| t.contains?(r.to_i32) }.size, 0
  t = fold_category("Lu").unwrap
  assert_eq t.ranges.size, 120
  assert_eq [637, 246, 181, 7984, 608].select { |r| t.contains?(r.to_i32) }.size, 5
  assert_eq [975, 101292, 112678, 149680, 24925].select { |r| t.contains?(r.to_i32) }.size, 0
  t = fold_category("M").unwrap
  assert_eq t.ranges.size, 2
  assert_eq [8126, 8126, 953].select { |r| t.contains?(r.to_i32) }.size, 3
  assert_eq [920, 954, 8125, 183636, 100974, 45064, 118468].select { |r| t.contains?(r.to_i32) }.size, 0
  t = fold_category("Mn").unwrap
  assert_eq t.ranges.size, 2
  assert_eq [953, 921].select { |r| t.contains?(r.to_i32) }.size, 2
  assert_eq [954, 8127, 8125, 920, 123560, 22280, 173008, 10710].select { |r| t.contains?(r.to_i32) }.size, 0
}

test "fold_script tables 0" {
  t = fold_script("Common").unwrap
  assert_eq t.ranges.size, 1
  assert_eq [924, 956].select { |r| t.contains?(r.to_i32) }.size, 2
  assert_eq [923, 957, 32931, 129936, 126307, 15237].select { |r| t.contains?(r.to_i32) }.size, 0
  t = fold_script("Greek").unwrap
  assert_eq t.ranges.size, 1
  assert_eq [837, 181].select { |r| t.contains?(r.to_i32) }.size, 2
  assert_eq [838, 180, 114121, 146575, 186092, 9467].select { |r| t.contains?(r.to_i32) }.size, 0
  t = fold_script("Inherited").unwrap
  assert_eq t.ranges.size, 2
  assert_eq [8126, 953].select { |r| t.contains?(r.to_i32) }.size, 2
  assert_eq [920, 8127, 954, 8125, 155655, 172730, 6948, 29706].select { |r| t.contains?(r.to_i32) }.size, 0
}

test "category aliases" {
  assert_eq category_alias("Cased_Letter") || "", "LC"
  assert_eq category_alias("Close_Punctuation") || "", "Pe"
  assert_eq category_alias("Combining_Mark") || "", "M"
