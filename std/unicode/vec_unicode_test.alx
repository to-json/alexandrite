# Generated from Go's unicode (go1.27.1, Unicode 17.0.0) by a throwaway Go program; do not edit by hand.
# vu(r, flags, upper, lower, title, fold, turkish upper, turkish lower) checks
# the is_* predicates (flags bit i: control, digit, graphic, letter, lower,
# mark, number, print, punct, space, symbol, title, upper), to_upper, to_lower,
# to_title, to(case, r) for the three cases and an invalid one, simple_fold and
# turkish_case. vprop(name, members, non-members) checks a Properties table.

#[track_caller]
def vu(r: Int, flags: Int, up: Int, lo: Int, ti: Int, fold: Int, tu: Int, tl: Int) {
  c = r.to_i32
  got = 0
  preds = [is_control(c), is_digit(c), is_graphic(c), is_letter(c), is_lower(c),
    is_mark(c), is_number(c), is_print(c), is_punct(c), is_space(c),
    is_symbol(c), is_title(c), is_upper(c)]
  for i in 0...preds.size {
    got |= 1 << i if preds[i]
  }
  assert_eq got, flags
  assert_eq to_upper(c), up.to_i32
  assert_eq to_lower(c), lo.to_i32
  assert_eq to_title(c), ti.to_i32
  assert_eq to(UPPER_CASE, c), up.to_i32
  assert_eq to(LOWER_CASE, c), lo.to_i32
  assert_eq to(TITLE_CASE, c), ti.to_i32
  assert_eq to(MAX_CASE, c), REPLACEMENT_CHAR
  assert_eq simple_fold(c), fold.to_i32
  t = turkish_case
  assert_eq t.to_upper(c), tu.to_i32
  assert_eq t.to_lower(c), tl.to_i32
}

#[track_caller]
def vcr(crs: [CaseRange], i: Int, lo: Int, hi: Int, u: Int, l: Int, t: Int) {
  assert_eq crs[i].lo, lo.to_u32
  assert_eq crs[i].hi, hi.to_u32
  assert_eq crs[i].delta.to_a, [u.to_i32, l.to_i32, t.to_i32]
}

#[track_caller]
def vprop(name: Str, yes: [Int], no: [Int]) {
  t = property(name).unwrap
  for r in yes {
    assert t.contains?(r.to_i32), "#{name} should contain #{r}"
  }
  for r in no {
    assert !t.contains?(r.to_i32), "#{name} should not contain #{r}"
  }
}

