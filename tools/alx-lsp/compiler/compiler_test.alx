import "strings"

RULES = "[{\"contains\":\"BROKEN\",\"result\":{\"unit\":\"script\",\"root\":\"/w\",\"diagnostics\":[{\"file\":\"$FILE\",\"phase\":\"parse\",\"severity\":\"error\",\"lo\":4,\"hi\":6,\"line\":0,\"col\":4,\"end_line\":0,\"end_col\":6,\"message\":\"bad\",\"notes\":[]}]}},{\"contains\":\"GARBAGE\",\"raw\":\"panic: x\\nmore\",\"stderr\":\"trace\"}]"

def fake -> ~FakeClient {
  new_fake(~json_rules(RULES))
}

test "overlays json" {
  m: Map[Str, Str] = {"/a" => "x\"y", "/b" => "z\n"}
  assert_eq overlays_json(m), "{\"/a\":\"x\\\"y\",\"/b\":\"z\\n\"}"
  e: Map[Str, Str] = {}
  assert_eq overlays_json(e), "{}"
}

test "fake matches rules, else answers clean" {
  f = ~fake
  m: Map[Str, Str] = {"/w/a.alx" => "x = BROKEN"}
  o = f.check!(Request.new(file: "/w/a.alx", overlays: m, unit: "", std_dir: ""))
  r = o.report.unwrap
  assert_eq r.diagnostics.size, 1
  assert_eq r.diagnostics[0].file, "/w/a.alx"
  assert r.diagnostics[0].syntax?
  m2: Map[Str, Str] = {"/w/a.alx" => "x = 1"}
  o2 = f.check!(Request.new(file: "/w/a.alx", overlays: m2, unit: "", std_dir: ""))
  assert_eq o2.report.unwrap.diagnostics.size, 0
  assert_eq f.calls[0], 2
  m3: Map[Str, Str] = {"/w/a.alx" => "GARBAGE"}
  o3 = f.check!(Request.new(file: "/w/a.alx", overlays: m3, unit: "", std_dir: ""))
  assert o3.report == none
  assert strings.contains(o3.failure, "panic: x")
  assert_eq o3.stderr, "trace"
}

test "report decodes the compiler schema" {
  s = "{\"unit\":\"package\",\"root\":\"/d\",\"diagnostics\":[{\"file\":\"/d/a.alx\",\"phase\":\"check\",\"severity\":\"warning\",\"lo\":1,\"hi\":2,\"line\":0,\"col\":1,\"end_line\":0,\"end_col\":2,\"message\":\"m\",\"notes\":[\"n\"]}]}"
  r = ~Report.from_json(s)
  assert_eq r.diagnostics[0].notes, ["n"]
  assert !r.diagnostics[0].syntax?
}

test "find_repo and find_alx" {
  assert_eq find_alx("/x/alx", "/y/srv"), "/x/alx"
  assert_eq find_repo("/"), ""
}
