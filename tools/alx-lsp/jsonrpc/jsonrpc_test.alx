import "bufio"
import "strings"

def reader(s: Str) -> bufio.Reader {
  bufio.new_reader(strings.new_reader(s))
}

test "frame round trip" {
  b = "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"initialize\",\"params\":{}}"
  r = reader(frame(b) + frame("{\"method\":\"exit\"}"))
  got = ~read_frame(r) || ""
  assert_eq got, b
  m = ~parse(got)
  assert m.request?
  assert_eq m.id, "7"
  assert_eq m.method, "initialize"
  assert_eq m.params, "{}"
  got2 = ~read_frame(r) || ""
  m2 = ~parse(got2)
  assert m2.notification?
  assert_eq m2.params, ""
  assert_eq read_frame(r).unwrap, none
}

test "string ids and unicode body sizes" {
  b = "{\"id\":\"a-1\",\"method\":\"x\",\"params\":\"héllo\"}"
  r = reader(frame(b))
  m = ~parse(~read_frame(r) || "")
  assert_eq m.id, "\"a-1\""
}

test "header case and extra headers" {
  r = reader("content-length: 2\r\nContent-Type: x\r\n\r\n{}")
  assert_eq ~read_frame(r) || "", "{}"
}

test "bad framing" {
  r = reader("X: 1\r\n\r\n")
  assert read_frame(r).err != none
  r2 = reader("Content-Length: zz\r\n\r\n")
  assert read_frame(r2).err != none
}

test "responses" {
  assert_eq response("1", "null"), "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}"
  e = error_response("\"x\"", METHOD_NOT_FOUND, "no \"m\"")
  assert strings.contains(e, "\"code\":-32601")
  assert strings.contains(e, "no \\\"m\\\"")
  assert_eq notification("a/b", "{}"), "{\"jsonrpc\":\"2.0\",\"method\":\"a/b\",\"params\":{}}"
}

test "scan: paths, escapes, elements" {
  s = "{\"a\":{\"b\":[1,{\"t\":\"x\\ny\\u00e9\\ud83d\\ude00\\\"q\"}, \"z\"],\"n\": 42 },\"t\":\"top\"}"
  assert_eq string_at(s, ["t"]), "top"
  assert_eq int_at(s, ["a", "n"]), 42
  els = elements(raw(s, ["a", "b"]) || "")
  assert_eq els.size, 3
  assert_eq string_at(els[1], ["t"]), "x\nyé😀\"q"
  assert_eq raw(s, ["a", "zz"]), none
  assert_eq raw(s, ["t", "x"]), none
  assert_eq unquote(quote("a\"b\\c\n\x01é")), "a\"b\\c\n\x01é"
}
