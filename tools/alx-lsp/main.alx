# alx-lsp: a language server for alexandrite (diagnostics; M2: symbols,
# definition, completion).
#
#   alx-lsp                  serve LSP on stdin/stdout
#   ALX_LSP_FAKE=rules.json  answer from canned compiler results (tests)
#
# See docs/editors/neovim.md and docs/notes/lsp-plan.md.

import "alx.dev/lsp/compiler"
import "alx.dev/lsp/server"
import "bufio"
import "os"

def run -> ~Int {
  r = bufio.new_reader(os.stdin)
  w = bufio.new_writer(os.stdout)
  tmp = os.mkdir_temp("", "alx-lsp")
  dir = tmp.ok? ? tmp.unwrap : ""
  code = 0
  if f = os.getenv("ALX_LSP_FAKE") {
    fc = ~compiler.load_fake(f)
    code = ~server.serve(r, w, fc, os.args[0], dir, false, true)
  } else {
    code = ~server.serve(r, w, compiler.ExecClient.new(unused: 0), os.args[0], dir, true, true)
  }
  os.remove_all(dir) if dir != ""
  code
}

code = run
os.exit(code.ok? ? code.unwrap : 2)
