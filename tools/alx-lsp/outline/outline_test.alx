# One line per symbol: "line kind owner.name" (owner left out when empty).
def show(src: Str) -> [Str] {
  outline(src).map { |s| "#{s.line} #{s.kind} #{s.owner == "" ? "" : s.owner + "."}#{s.name}" }
}

test "top-level declarations" {
  src = <<~'EOS'
    import "strings"
    import fp "path/filepath"
    pub MAX = 10
    LIMIT: Int = 3
    pub def f(x: Int) -> Int { x }
    def g? -> Bool { true }
    fn pure(a: Int) -> Int { a }
    extern def c_getpid() -> I32 = "getpid"
    pub struct Point {
      x: Int
      def sum -> Int { x }
      def move!(dx: Int) { self.x += dx }
      def self.origin -> Point { Point.new() }
      def +(o: Point) -> Point { o }
      def [](i: Int) -> Int { i }
    }
    enum Color { Red; Green }
    pub error ParseErr {
      Bad(pos: Int)
      def message -> Str { "bad" }
    }
    interface Shape { def area -> Float }
    refine Words for Str {
      def words -> [Str] { [] }
    }
    test "adds" { assert_eq 1, 1 }
    bench "fast" { }
    example "hi" { puts "hi" } outputs "hi\n"
    puts f(1)
  EOS
  assert_eq show(src), [
    "0 import strings", "1 import fp.path/filepath", "2 const MAX", "3 const LIMIT",
    "4 def f", "5 def g?", "6 def pure", "7 extern c_getpid",
    "8 struct Point", "10 method Point.sum", "11 method Point.move!", "12 method Point.origin",
    "13 method Point.+", "14 method Point.[]",
    "16 enum Color", "17 error ParseErr", "19 method ParseErr.message",
    "21 interface Shape", "21 method Shape.area",
    "22 refine Words", "23 method Words.words",
    "25 test adds", "26 bench fast", "27 example hi",
  ]
}

test "spans" {
  src = "def f {\n  1\n}\nX = 1\nstruct S {\n  def m { }\n}\n"
  ss = outline(src)
  assert_eq ss.size, 4
  assert_eq src[ss[0].lo...ss[0].lo + 1], "f"
  assert_eq src[ss[0].lo...ss[0].hi], "f {\n  1\n}"
  assert_eq src[ss[1].lo...ss[1].hi], "X = 1"
  assert_eq src[ss[2].lo...ss[2].hi], "S {\n  def m { }\n}"
  assert_eq src[ss[3].lo...ss[3].hi], "m { }"
}

test "braces in literals and comments don't count" {
  src = <<~'EOS'
    def a {
      s = "}}} #{ {"x" => "}"}["x"] } {"
      t = '}'
      u = `echo "}" #{"}"}`
      # a comment with } and {
      v = "\"}"
    }
    def b { }
  EOS
  assert_eq show(src), ["0 def a", "7 def b"]
}

test "heredoc bodies are skipped" {
  src = <<~'EOS'
    def a {
      s = <<~EOT + <<~'RAW'
        def not_me {
        }
      EOT
        } struct Nope {
      RAW
    }
    def b { }
  EOS
  assert_eq show(src), ["0 def a", "8 def b"]
}

test "attributes" {
  src = <<~'EOS'
    #![overflow(wrap)]
    #[derive(Json)]
    struct A {
      #[json("a]b")]
      x: Int
      #[json("{")] y: Int
    }
    #[track_caller] def f { }
    #[link("c")] extern def g() -> Int
    #[embed("x.txt")]
    pub DATA: Str
  EOS
  assert_eq show(src), ["2 struct A", "7 def f", "8 extern g", "10 const DATA"]
}

test "statements and nested defs are not declarations" {
  src = <<~'EOS'
    x = 1
    X == 1
    def outer {
      def inner { }
      Y = 2
    }
    foo(
      Z = 3
    )
    struct S { kids: [S]; def m { }; def n { } }
    struct T { w: Int, def m { } }
  EOS
  assert_eq show(src), ["2 def outer", "9 struct S", "9 method S.m", "9 method S.n", "10 struct T", "10 method T.m"]
}

test "broken files" {
  src = <<~'EOS'
    def a {
      if x {
        y = (
    def b -> Int { 2 }
    struct S {
      x: Int
      def m(a: Int {
    }
    pub def c { "unterminated }
    def d { }
  EOS
  assert_eq show(src), ["0 def a", "3 def b", "4 struct S", "6 method S.m", "8 def c", "9 def d"]
  # the broken `a` ends where `b` starts
  ss = outline(src)
  assert_eq src[ss[0].lo...ss[0].hi], "a {\n  if x {\n    y = ("
}

test "never fails" {
  for src in ["", "{", "}", "\"", "#[", "<<~", "<<~EOS\n", "def", "def ", "struct", "import \"", "test \"x\"", '`#{', '"#{"', "ƒ"] {
    _ss = outline(src)
  }
}
