test "line_col" {
  ix = index("ab\ncd\n\nef")
  assert_eq ix.line_count, 4
  assert_eq ix.line_col(0), (0, 0)
  assert_eq ix.line_col(2), (0, 2)
  assert_eq ix.line_col(3), (1, 0)
  assert_eq ix.line_col(6), (2, 0)
  assert_eq ix.line_col(9), (3, 2)
  assert_eq ix.line_col(99), (3, 2)
}

test "utf16 columns" {
  # "é" 2 bytes 1 unit; "😀" 4 bytes 2 units; "漢" 3 bytes 1 unit
  ix = index("aé😀漢z\nq")
  assert_eq ix.to_client(0, 0, UTF16), 0
  assert_eq ix.to_client(0, 1, UTF16), 1
  assert_eq ix.to_client(0, 3, UTF16), 2
  assert_eq ix.to_client(0, 7, UTF16), 4
  assert_eq ix.to_client(0, 10, UTF16), 5
  assert_eq ix.to_client(0, 10, UTF8), 10
  assert_eq ix.from_client(0, 4, UTF16), 7
  assert_eq ix.from_client(0, 5, UTF16), 10
  assert_eq ix.from_client(0, 99, UTF16), 11
  assert_eq ix.from_client(1, 1, UTF8), 1
  assert_eq ix.position(7, UTF16), (0, 4)
}

test "crlf" {
  ix = index("ab\r\ncd")
  assert_eq ix.from_client(0, 99, UTF8), 2
  assert_eq ix.line_col(4), (1, 0)
}

test "diff and shift" {
  e = diff("hello world", "hello brave world")
  assert_eq e.p, 6
  assert_eq e.old_end, 6
  assert_eq e.new_end, 12
  assert_eq e.shift(0), 0
  assert_eq e.shift(6), 6
  assert_eq e.shift(7), 13
  e2 = diff("abcdef", "abXef")
  assert_eq e2.p, 2
  assert_eq e2.old_end, 4
  assert_eq e2.new_end, 3
  assert_eq e2.shift(3), 2
  assert_eq e2.shift(5), 4
  assert diff("same", "same").none?
  e3 = diff("aaa", "aa")
  assert_eq e3.new_end - e3.p, 0 - 0 + (e3.new_end - e3.p)
  assert_eq e3.shift(3), 2
}
