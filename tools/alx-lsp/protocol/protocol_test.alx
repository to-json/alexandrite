import "encoding/json"

test "uri round trip" {
  assert_eq uri_to_path("file:///a/b%20c.alx"), "/a/b c.alx"
  assert_eq path_to_uri("/a/b c é.alx"), "file:///a/b%20c%20%C3%A9.alx"
  assert_eq uri_to_path(path_to_uri("/x/y z/é#1.alx")), "/x/y z/é#1.alx"
  assert_eq uri_to_path("untitled:Untitled-1"), ""
  assert_eq uri_to_path("file://localhost/a"), "/a"
}

test "didOpen decodes, ignoring unknown fields" {
  s = "{\"textDocument\":{\"uri\":\"file:///a.alx\",\"languageId\":\"alexandrite\",\"version\":3,\"text\":\"x = 1\\n\"},\"extra\":[1]}"
  p = ~DidOpenParams.from_json(s)
  assert_eq p.textDocument.uri, "file:///a.alx"
  assert_eq p.textDocument.version, 3
  assert_eq p.textDocument.text, "x = 1\n"
}

test "initialize with and without optional parts" {
  p = ~InitializeParams.from_json("{\"processId\":1,\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-8\",\"utf-16\"]}},\"initializationOptions\":{\"alx\":{\"path\":\"/x\"}}}")
  assert_eq p.capabilities.unwrap.general.unwrap.positionEncodings, ["utf-8", "utf-16"]
  assert p.initializationOptions != none
  assert_eq p.rootUri, none
  q = ~InitializeParams.from_json("{}")
  assert_eq q.capabilities, none
}

test "diagnostics encode" {
  d = Diagnostic.new(range: Range.new(start: Position.new(line: 1, character: 2), end: Position.new(line: 1, character: 5)), severity: 1, source: "alx", message: "bad \"x\"")
  s = PublishDiagnosticsParams.new(uri: "file:///a.alx", diagnostics: [d]).~to_json
  assert_eq s, "{\"uri\":\"file:///a.alx\",\"diagnostics\":[{\"range\":{\"start\":{\"line\":1,\"character\":2},\"end\":{\"line\":1,\"character\":5}},\"severity\":1,\"source\":\"alx\",\"message\":\"bad \\\"x\\\"\"}]}"
}
