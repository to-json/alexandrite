# Package server: the LSP message loop, document store, scheduler and
# publishing logic (M1: diagnostics).
#
# One task, no Chan, no spawn (docs/notes/lsp-plan.md 0.1): `serve` reads a
# message, handles it, and when nothing more is queued (`input_ready`) and a
# document changed, runs the compiler synchronously and publishes. Messages
# that arrive during a run wait in the pipe and are handled next. Because
# nothing else runs during a check, the document versions a result was
# computed for are always still current when it is published; an edit that
# arrives meanwhile is handled next and marks its documents dirty again.
#
# The store (texts, versions, last results) is local to `serve`: texts are
# stored by the loop function itself, never through a method of a passed-in
# value, so they live in its region and are freed when replaced.

import "alx.dev/lsp/compiler"
import "alx.dev/lsp/jsonrpc"
import "alx.dev/lsp/position"
import "alx.dev/lsp/protocol"
import "bufio"
import "encoding/json"
import "os"
import "path"

pub NAME = "alx-lsp"
pub VERSION = "0.1.0"
DEBOUNCE_MS = 150

def send(w: bufio.Writer, body: Str) -> ~Unit {
  ~jsonrpc.write_frame(w, body)
}

def log(w: bufio.Writer, kind: Int, msg: Str) -> ~Unit {
  ~send(w, jsonrpc.notification("window/logMessage", protocol.log_json(kind, msg)))
}

# What `initialize` settles.
struct Session {
  enc: Int
  opts: Opts
  workspace: Str
  alx: Str
  version: Str # the compiler's `alx --version`, for the log
}

# Answers requests until `initialize` arrives (none: the client left first).
# A separate function, not part of the loop: values the loop assigns to
# variables outside itself keep its whole iteration alive (see the loop).
def handshake(r: bufio.Reader, w: bufio.Writer, self_path: Str, real: Bool) -> ~Session? {
  loop {
    body = ~jsonrpc.read_frame(r) || return none
    m = jsonrpc.parse(body)
    if m.err != none {
      ~send(w, jsonrpc.error_response("null", jsonrpc.PARSE_ERROR, "parse error"))
      next
    }
    msg = m.unwrap
    return none if msg.method == "exit"
    next unless msg.request?
    id = msg.id.unwrap
    if msg.method != "initialize" {
      ~send(w, jsonrpc.error_response(id, jsonrpc.SERVER_NOT_INITIALIZED, "server not initialized"))
      next
    }
    ip = protocol.InitializeParams.from_json(msg.params == "" ? "{}" : msg.params)
    params = ip.ok? ? ip.unwrap : protocol.InitializeParams.new(rootUri: none, capabilities: none, initializationOptions: none)
    enc = pick_encoding(params)
    opts = parse_opts(params.initializationOptions)
    alx = compiler.find_alx(opts.path, self_path)
    res = protocol.InitializeResult.new(
      capabilities: protocol.ServerCaps.new(positionEncoding: encoding_name(enc), textDocumentSync: protocol.SyncOptions.new(openClose: true, change: 1, save: false)),
      serverInfo: protocol.ServerInfo.new(name: NAME, version: VERSION))
    ~send(w, jsonrpc.response(id, res.~to_json))
    return Session.new(enc: enc, opts: opts, workspace: protocol.uri_to_path(params.rootUri || ""), alx: alx, version: real ? compiler.version(alx) : "fake compiler")
  }
  none
}

# Serves one client until `exit` or end of input; returns the process exit
# code (0 after a `shutdown`, 1 otherwise). `fake` replaces the compiler (tests).
pub def serve[C: compiler.Client](r: bufio.Reader, w: bufio.Writer, client0: C, self_path: Str, tmp_dir: Str, real: Bool, poll: Bool) -> ~Int {
  docs: Map[Str, Str] = {}
  vers: Map[Str, Int] = {}
  results: Map[Str, Entry] = {}
  sent: Map[Str, Str] = {} # uri -> the diagnostics JSON last published
  dirty: [Str] = []
  ctx: Map[Str, Str] = {} # per-session scalars kept in a container: see handshake
  sess = ~handshake(r, w, self_path, real) || return 1
  enc = sess.enc
  opts = sess.opts
  ws_std = sess.workspace == "" ? "" : repo_std(sess.workspace)
  client = client0
  state = 1 # 1 initialized, 2 shut down
  loop {
    if dirty.size > 0 && (ctx.has_key?("shutdown") || !input_ready(r, DEBOUNCE_MS, poll)) {
      todo = plan(open_uris(docs), results, dirty)
      dirty = []
      for focus in todo {
        fpath = protocol.uri_to_path(focus)
        if fpath == "" {
          next
        }
        overlays = overlays_of(docs)
        req = compiler.Request.new(alx: sess.alx, file: fpath, overlay_file: tmp_dir + "/overlays.json", unit: opts.unit, std_dir: std_dir_for(opts.std_dir, ws_std, fpath))
        wr = os.write_file(tmp_dir + "/overlays.json", compiler.overlays_json(overlays).bytes.to_a, 0o600)
        out = compiler.Outcome.new(report: none, failure: "cannot write overlays: #{tmp_dir}", stderr: "")
        if wr.ok? {
          out = client.check!(req)
        }
        prev = results[focus]
        prev_diags: [compiler.Diag] = []
        if p = prev {
          prev_diags = p.diags
        }
        e = Entry.new(root: "", files: [], diags: [])
        if rep = out.report {
          e = entry_of(fpath, rep.root, merge(prev_diags, rep.diagnostics, fpath))
        } else {
          ~log(w, protocol.MSG_ERROR, out.failure + "\n" + out.stderr)
          e = entry_of(fpath, "", merge(prev_diags, [failure_diag(fpath, out.failure)], fpath))
        }
        if out.report != none && out.stderr != "" {
          ~log(w, protocol.MSG_LOG, out.stderr)
        }
        results[focus] = e
        affected: [Str] = e.files
        if p = prev {
          for f in p.files {
            affected << f unless has(affected, f)
          }
        }
        ~publish(w, affected, snapshot(docs, affected), vers, results, sent, enc)
      }
    }
    if sid = ctx["shutdown"] {
      # `shutdown` was held back until the pending check above had run
      ~send(w, jsonrpc.response(sid, "null"))
      ctx.delete("shutdown")
      state = 2
    }
    body = ~jsonrpc.read_frame(r) || break
    m = jsonrpc.parse(body)
    if m.err != none {
      ~send(w, jsonrpc.error_response("null", jsonrpc.PARSE_ERROR, "parse error"))
      next
    }
    msg = m.unwrap
    method = msg.method
    if msg.method == "" {
      next # a response from the client: M1 sends no requests
    }
    if method == "exit" {
      return state == 2 ? 0 : 1
    }
    if msg.request? {
      id = msg.id.unwrap
      if method == "shutdown" && state == 1 {
        ctx["shutdown"] = fresh(id)
      } else if state == 2 {
        ~send(w, jsonrpc.error_response(id, jsonrpc.INVALID_REQUEST, "server is shutting down"))
      } else if method == "initialize" {
        ~send(w, jsonrpc.error_response(id, jsonrpc.INVALID_REQUEST, "already initialized"))
      } else {
        ~send(w, jsonrpc.error_response(id, jsonrpc.METHOD_NOT_FOUND, "method not found: #{method}"))
      }
      next
    }
    next unless state == 1
    case method {
      "initialized" => {
        v = sess.version
        ~log(w, protocol.MSG_INFO, "#{NAME} #{VERSION}; compiler: #{v}; positions: #{encoding_name(enc)}")
      }
      "textDocument/didOpen" => {
        # no named locals tie the document map's keys or texts to the loop:
        # then its storage is compacted each iteration (see regions.rs `owners`)
        if uri_of(msg.params) != "" && jsonrpc.string_at(msg.params, ["textDocument", "text"]) != none {
          docs[uri_of(msg.params)] = jsonrpc.string_at(msg.params, ["textDocument", "text"]) || ""
          vers[uri_of(msg.params)] = jsonrpc.int_at(msg.params, ["textDocument", "version"]) || 0
          dirty << uri_of(msg.params) unless has(dirty, uri_of(msg.params))
        }
      }
      "textDocument/didChange" => {
        cs = jsonrpc.elements(jsonrpc.raw(msg.params, ["contentChanges"]) || "[]")
        if cs.size > 0 && docs.has_key?(uri_of(msg.params)) {
          e = diff_in(docs, uri_of(msg.params), jsonrpc.string_at(cs[cs.size - 1], ["text"]) || "")
          fp = protocol.uri_to_path(uri_of(msg.params))
          for k in results.keys {
            en = results[k] || next
            results[k] = Entry.new(root: en.root, files: en.files, diags: shift_diags(en.diags, fp, e))
          }
          docs[uri_of(msg.params)] = jsonrpc.string_at(cs[cs.size - 1], ["text"]) || ""
          vers[uri_of(msg.params)] = jsonrpc.int_at(msg.params, ["textDocument", "version"]) || 0
          dirty << uri_of(msg.params) unless has(dirty, uri_of(msg.params))
        }
      }
      "textDocument/didSave" => {
        dirty << uri_of(msg.params) unless uri_of(msg.params) == "" || has(dirty, uri_of(msg.params))
      }
      "textDocument/didClose" => {
        if uri_of(msg.params) != "" {
          docs.delete(uri_of(msg.params))
          vers.delete(uri_of(msg.params))
          gone = results[uri_of(msg.params)]
          results.delete(uri_of(msg.params))
          dirty = dirty.select { it != uri_of(msg.params) }
          if g = gone {
            ~publish(w, g.files, snapshot(docs, g.files), vers, results, sent, enc)
          }
          # the buffer's text no longer shadows disk: recheck its dependents
          dirty << uri_of(msg.params)
        }
      }
      _ => {}
    }
  }
  state == 2 ? 0 : 1
}

# Publishes, for each of `uris` (file paths), the union over all results of
# the diagnostics in that file; skips a file whose list did not change.
def publish(w: bufio.Writer, files: [Str], snap: [Doc], vers: Map[Str, Int], results: Map[Str, Entry], sent: Map[Str, Str], enc: Int) -> ~Unit {
  for f in files {
    u = protocol.path_to_uri(f)
    all: [compiler.Diag] = []
    for k in results.keys {
      en = results[k] || next
      all = all + en.diags.select { it.file == f }
    }
    ds = lsp_diags(all, f, text_in(snap, u), enc)
    ver: Int? = vers[u]
    js = protocol.diagnostics_json(u, ver, ds)
    old = sent[u]
    next if old == js || (old == none && ds.size == 0)
    sent[u] = fresh(js)
    ~send(w, jsonrpc.notification("textDocument/publishDiagnostics", js))
  }
}

# An open buffer's text, copied for publishing. (Handing the document map
# itself to other functions would stop its region from being compacted.)
struct Doc {
  uri: Str
  text: Str
}

def snapshot(docs: Map[Str, Str], files: [Str]) -> [Doc] {
  out: [Doc] = []
  for f in files {
    u = protocol.path_to_uri(f)
    t = docs[u] || next
    out << Doc.new(uri: u, text: fresh(t))
  }
  out
}

def text_in(snap: [Doc], uri: Str) -> Str? {
  for d in snap {
    return d.text if d.uri == uri
  }
  none
}

def uri_of(params: Str) -> Str {
  jsonrpc.string_at(params, ["textDocument", "uri"]) || ""
}

def overlays_of(docs: Map[Str, Str]) -> Map[Str, Str] {
  out: Map[Str, Str] = {}
  for u in docs.keys {
    p = protocol.uri_to_path(u)
    out[p] = docs[u] || "" if p != ""
  }
  out
}

def diff_in(docs: Map[Str, Str], uri: Str, nt: Str) -> position.Edit {
  position.diff(docs[uri] || "", nt)
}

def open_uris(docs: Map[Str, Str]) -> [Str] {
  out: [Str] = []
  for u in docs.keys {
    out << fresh(u)
  }
  out
}
