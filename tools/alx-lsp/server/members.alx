# Member completion after `.` on a value (M2.6). The receiver's type comes
# from the compiler (`alx check --json --types`, run when such a completion
# is asked for); its members from the same output.
#
# The output is scanned, not decoded (port-issues #176): `type_table` keeps
# the `types` entries as small structs and the `members` object as text,
# where `member_items` looks up one key. A table is kept per buffer while it
# came from a check without errors (the last good one), its spans moved
# through edits like diagnostics, for when the buffer doesn't check.

import "alx.dev/lsp/jsonrpc"
import "alx.dev/lsp/outline"
import "alx.dev/lsp/position"
import "strings"

# One entry of `types`: kind is local, param, self, it or recv.
pub struct TypeEnt {
  lo: Int
  hi: Int
  name: Str
  type: Str
  kind: Str
}

pub struct TypeTab {
  ents: [TypeEnt]
  members: Str # the `members` object, as JSON text
  good: Bool   # the check reported no error
}

pub def empty_tab -> TypeTab { TypeTab.new(ents: [], members: "{}", good: false) }

# The table in the stdout of `alx check --json --types` (empty if it isn't
# one).
pub def type_table(out: Str) -> TypeTab {
  ents: [TypeEnt] = []
  for el in jsonrpc.elements(jsonrpc.raw(out, ["types"]) || "[]") {
    ents << TypeEnt.new(lo: jsonrpc.int_at(el, ["lo"]) || 0, hi: jsonrpc.int_at(el, ["hi"]) || 0, name: jsonrpc.string_at(el, ["name"]) || "", type: jsonrpc.string_at(el, ["type"]) || "", kind: jsonrpc.string_at(el, ["kind"]) || "")
  }
  errors = false
  for d in jsonrpc.elements(jsonrpc.raw(out, ["diagnostics"]) || "[]") {
    errors = true if jsonrpc.string_at(d, ["severity"]) == "error"
  }
  members = jsonrpc.copy_of(jsonrpc.raw(out, ["members"]) || "{}")
  TypeTab.new(ents: ents, members: members, good: !errors && ents.size > 0)
}

# A table moved through an edit of its buffer.
pub def shift_tab(t: TypeTab, e: position.Edit) -> TypeTab {
  ents = t.ents.map { TypeEnt.new(lo: e.shift(it.lo), hi: e.shift(it.hi), name: it.name, type: it.type, kind: it.kind) }
  TypeTab.new(ents: ents, members: t.members, good: t.good)
}

# A copy sharing nothing with `t` (see `answer`).
pub def copy_tab(t: TypeTab) -> TypeTab {
  ents = t.ents.map { TypeEnt.new(lo: it.lo, hi: it.hi, name: fresh(it.name), type: fresh(it.type), kind: fresh(it.kind)) }
  TypeTab.new(ents: ents, members: fresh(t.members), good: t.good)
}

# The expression before the `.` at `dot`: `ident` when it is a plain
# identifier (nothing chained before it), else "" (a call, an index, a
# chain); `end` is where it ends (before a `?` of `?.`), -1 when there is no
# expression there.
pub struct Recv {
  ident: Str
  end: Int
  opt: Bool
}

pub def receiver_at(text: Str, dot: Int) -> Recv {
  end = dot
  opt = false
  if end > 0 && text[end - 1] == 63 {
    end -= 1
    opt = true
  }
  return Recv.new(ident: "", end: -1, opt: opt) if end <= 0
  c = text[end - 1]
  if word?(c) || c == 33 {
    s = c == 33 ? end - 1 : end
    while s > 0 && word?(text[s - 1]) {
      s -= 1
    }
    return Recv.new(ident: "", end: -1, opt: opt) if s == end || (text[s] >= 48 && text[s] <= 57)
    chained = s > 0 && text[s - 1] == 46
    return Recv.new(ident: chained ? "" : fresh(text[s...end]), end: end, opt: opt)
  }
  return Recv.new(ident: "", end: end, opt: opt) if c == 41 || c == 93
  Recv.new(ident: "", end: -1, opt: opt)
}

# The `.` a completion at `off` follows, when it asks for the members of a
# value: -1 after `Type.` or `pkg.` (the outline answers those), after `..`,
# or when no `.` is there.
pub def member_dot(text: Str, syms: [outline.Sym], off: Int) -> Int {
  w = word_at(text, off, true)
  dot = w.lo - 1
  return -1 if dot < 1 || text[dot] != 46 || text[dot - 1] == 46
  r = receiver_at(text, dot)
  return -1 if r.end < 0
  return -1 if r.ident != "" && (upper?(r.ident) || import_named(syms, r.ident) != none)
  dot
}

# The cursor of a completion request (a byte offset) and the member `.`
# before it (-1 if none: see member_dot).
pub def member_at(text: Str, syms: [outline.Sym], params: Str, enc: Int) -> (Int, Int) {
  ix = position.index(text)
  off = ix.offset(jsonrpc.int_at(params, ["position", "line"]) || 0, jsonrpc.int_at(params, ["position", "character"]) || 0, enc)
  (member_dot(text, syms, off), off)
}

# The text with the `.` at `dot` and the word typed after it (to `off`)
# blanked out, so that it parses and the receiver's binding gets a type.
pub def blank_member(text: Str, dot: Int, off: Int) -> Str {
  e = off < dot ? dot : off
  e = text.size if e > text.size
  text[0...dot] + strings.repeat(" ", e - dot) + text[e...text.size]
}

# The receiver's type in a table ("" if it isn't there): an exact `recv`
# entry ending at the dot, else for a plain identifier its nearest binding
# before the dot inside the enclosing def (`self` and `it`: the entry whose
# span holds the dot).
def receiver_type(r: Recv, dot: Int, bound: Int, t: TypeTab) -> Str {
  best = ""
  best_lo = -1
  for en in t.ents {
    if en.kind == "recv" && en.hi == r.end && (best_lo < 0 || en.lo < best_lo) {
      best = en.type
      best_lo = en.lo
    }
  }
  return best if best != ""
  return "" if r.ident == ""
  best_lo = -1
  for en in t.ents {
    hit = false
    if r.ident == "self" || r.ident == "it" {
      hit = en.kind == r.ident && en.lo <= dot && dot < en.hi
    } else {
      hit = (en.kind == "local" || en.kind == "param") && en.name == r.ident && en.lo >= bound && en.lo < dot
    }
    if hit && en.lo > best_lo {
      best = en.type
      best_lo = en.lo
    }
  }
  best
}

# Where the def holding `off` starts (its name), 0 outside every def.
def enclosing(syms: [outline.Sym], off: Int) -> Int {
  b = 0
  for s in syms {
    k = s.kind
    next unless k == "def" || k == "method" || k == "test" || k == "bench" || k == "example"
    b = s.lo if s.lo <= off && off < s.hi && s.lo > b
  }
  b
}

# Completion items for the members of the receiver before the `.` at
# `dot`, from the first table that knows its type (the fresh check, then
# the last good one). Methods carry their signature, fields their type.
pub def member_items(text: Str, syms: [outline.Sym], dot: Int, tabs: [TypeTab]) -> [Str] {
  r = receiver_at(text, dot)
  return [] if r.end < 0
  bound = enclosing(syms, dot)
  for t in tabs {
    ty = receiver_type(r, dot, bound, t)
    next if ty == ""
    ty = ty[0...ty.size - 1] if r.opt && ty.end_with?("?")
    arr = jsonrpc.raw(t.members, [ty]) || next
    out: [Str] = []
    seen: Map[Str, Bool] = {}
    for el in jsonrpc.elements(arr) {
      name = jsonrpc.string_at(el, ["name"]) || next
      next if seen.has_key?(name)
      seen[name] = true
      if jsonrpc.string_at(el, ["kind"]) == "field" {
        out << item_json(name, 5, jsonrpc.string_at(el, ["type"]) || "")
      } else {
        out << item_json(name, 2, jsonrpc.string_at(el, ["sig"]) || "")
      }
    }
    return out
  }
  []
}

# Does the table already know the receiver before the `.` at `dot`? Then
# the server answers from it without running the compiler (every run of a
# child process costs ~80 KB that is never freed: port-issues #273).
# Copies first, as `answer` does (#272).
pub def resolves(text: Str, syms: [outline.Sym], dot: Int, t: TypeTab) -> Bool {
  member_items(fresh(text), copy_syms(syms), dot, [copy_tab(t)]).size > 0
}
