# The server's pure helpers: settings, diagnostic bookkeeping, conversion to
# LSP diagnostics. State itself lives in `serve` (loop.alx), not here: texts
# are stored by the loop function so they live in its region (docs/notes/
# lsp-plan.md 0.1, R3), and everything here takes values and returns values.

import "alx.dev/lsp/compiler"
import "alx.dev/lsp/position"
import "alx.dev/lsp/protocol"
import "bufio"
import "encoding/json"
import "os"
import "path"
import "strings"
import "time"

pub struct Opts {
  path: Str    # alx.path: the compiler binary
  std_dir: Str # alx.stdDir: ALX_STD_DIR for the child
  unit: Str    # alx.unit: "", "script" or "package"
}

# What the last check of one focused file found.
pub struct Entry {
  root: Str    # the unit's root directory
  files: [Str] # files that carry diagnostics, plus the focused one
  diags: [compiler.Diag]
}

# Settings from initializationOptions: {"alx": {"path": ..}} or the same keys
# at the top level.
pub def parse_opts(v: json.Value?) -> Opts {
  o = Opts.new(path: "", std_dir: "", unit: "")
  return o unless v != none
  top = v.unwrap
  s = top
  if inner = top.get("alx") {
    s = inner
  }
  o.path = (s.get("path") || json.Value.json_zero).as_str || ""
  o.std_dir = (s.get("stdDir") || json.Value.json_zero).as_str || ""
  o.unit = (s.get("unit") || json.Value.json_zero).as_str || ""
  o.unit = "" unless o.unit == "script" || o.unit == "package"
  o
}

pub def pick_encoding(p: protocol.InitializeParams) -> Int {
  if caps = p.capabilities {
    if g = caps.general {
      return position.UTF8 if has(g.positionEncodings, "utf-8")
    }
  }
  position.UTF16
}

pub def encoding_name(enc: Int) -> Str {
  enc == position.UTF8 ? "utf-8" : "utf-16"
}

# True when more input is ready: bytes already buffered, else whether stdin
# becomes readable (data, EOF or error) within `ms`.
pub def input_ready(r: bufio.Reader, ms: Int, poll: Bool) -> Bool {
  return true if r.buffered > 0
  return false unless poll # tests read from memory, not from stdin
  w = os.stdin.wait_readable(time.Duration.new(ms * 1000000))
  w.ok? ? w.unwrap : true
}

# ---- diagnostics bookkeeping

# Moves the offsets of diagnostics in `file` through an edit of that file.
pub def shift_diags(ds: [compiler.Diag], file: Str, e: position.Edit) -> [compiler.Diag] {
  return ds if e.none?
  ds.map { |d|
    if d.file == file {
      lo = e.shift(d.lo)
      hi = e.shift(d.hi)
      hi = lo if hi < lo
      compiler.Diag.new(file: d.file, phase: d.phase, severity: d.severity, lo: lo, hi: hi, line: d.line, col: d.col, end_line: d.end_line, end_col: d.end_col, message: d.message, notes: d.notes)
    } else {
      d
    }
  }
}

def semantic?(d: compiler.Diag) -> Bool {
  d.phase == "check" || d.phase == "prove" || d.phase == "warning"
}

# The diagnostics to keep after a check of `focus`: the fresh ones, unless the
# focused file has a syntax error, in which case the previous semantic ones
# (already shifted through the edits) stay beside the fresh syntax errors.
pub def merge(prev: [compiler.Diag], fresh: [compiler.Diag], focus: Str) -> [compiler.Diag] {
  broken = false
  for d in fresh {
    broken = true if d.file == focus && d.syntax?
  }
  return fresh unless broken
  kept = prev.select { semantic?(it) }
  fresh.select { it.syntax? || !semantic?(it) } + kept
}

# A synthetic diagnostic at the top of a file.
pub def failure_diag(file: Str, msg: Str) -> compiler.Diag {
  compiler.Diag.new(file: file, phase: "internal", severity: "error", lo: 0, hi: 0, line: 0, col: 0, end_line: 0, end_col: 0, message: msg, notes: [])
}

pub def entry_of(focus: Str, root: Str, diags: [compiler.Diag]) -> Entry {
  files = [fresh(focus)]
  for d in diags {
    files << fresh(d.file) unless has(files, d.file)
  }
  Entry.new(root: root, files: files, diags: diags)
}

# LSP diagnostics of `file` among `ds`. `text` is the buffer when the file is
# open (offsets are authoritative then, they were shifted through edits).
pub def lsp_diags(ds: [compiler.Diag], file: Str, text: Str?, enc: Int) -> [protocol.Diagnostic] {
  mine = ds.select { it.file == file }
  return [] if mine.size == 0
  open = text != none
  body = ""
  if open {
    body = text.unwrap
  } else if enc == position.UTF16 {
    r = os.read_file_string(file)
    body = r.unwrap_or("")
  }
  ix = position.index(body)
  out: [protocol.Diagnostic] = []
  seen: [Str] = []
  for d in mine {
    sl = d.line
    sc = d.col
    el = d.end_line
    ec = d.end_col
    if open {
      sl, sc = ix.line_col(d.lo)
      el, ec = ix.line_col(d.hi)
    }
    if open || enc == position.UTF16 {
      sc = ix.to_client(sl, sc, enc)
      ec = ix.to_client(el, ec, enc)
    }
    msg = d.message
    msg = msg + "\n" + d.notes.join("\n") if d.notes.size > 0
    sev = case d.severity { "error" => 1; "warning" => 2; _ => 3 }
    key = "#{sl}:#{sc}:#{el}:#{ec}:#{msg}"
    next if has(seen, key)
    seen << key
    rng = protocol.Range.new(start: protocol.Position.new(line: sl, character: sc), end: protocol.Position.new(line: el, character: ec))
    out << protocol.Diagnostic.new(range: rng, severity: sev, source: "alx", message: msg)
  }
  out
}

# Open buffers to recheck after `changed` (uris) changed: the buffers
# themselves, and every other open buffer whose last check was of the same
# unit root or listed one of them.
pub def plan(open: [Str], results: Map[Str, Entry], changed: [Str]) -> [Str] {
  out: [Str] = []
  for u in changed {
    out << fresh(u) if has(open, u) && !has(out, u)
  }
  for u in changed {
    p = protocol.uri_to_path(u)
    for o, e in results {
      next if has(out, o) || !has(open, o)
      out << fresh(o) if e.root == path.dir(p) || has(e.files, p)
    }
  }
  out
}

# The std directory of the alexandrite repo containing `p` ("" if none).
pub def repo_std(p: Str) -> Str {
  r = compiler.find_repo(p)
  r == "" ? "" : fresh(r + "/std")
}

# The ALX_STD_DIR for a check of `file`: the setting, else the workspace's
# std (`ws_std`, computed once) when the workspace is the alexandrite repo,
# else <repo>/std when `file` is a std buffer; "" otherwise.
pub def std_dir_for(setting: Str, ws_std: Str, file: Str) -> Str {
  return setting if setting != ""
  return ws_std if ws_std != ""
  return "" unless strings.contains(file, "/std/")
  s = repo_std(file)
  s != "" && file.start_with?(s + "/") ? s : ""
}

pub def has(xs: [Str], x: Str) -> Bool {
  for y in xs {
    return true if y == x
  }
  false
}

# A copy that shares nothing with the original: a result built from a
# container's keys must not point into the container (region placement).
def fresh(s: Str) -> Str {
  out: [Byte] = []
  for c in s.bytes {
    out << c
  }
  Str.from_bytes(out)
}
