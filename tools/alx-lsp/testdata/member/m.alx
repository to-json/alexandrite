# The file of the scripted session session_member (real compiler): the
# session edits it in the editor buffer only.
import "strings"

struct Pt {
  x: Int
  def sum -> Int { x }
}

def run(n: Int) -> Str {
  b = strings.Builder.new()
  p = Pt.new(x: n)
  b.write_string!("a")
  "#{p.sum}#{b.string.size}"
}

puts run(1)
