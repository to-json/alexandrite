# The outline of each file named on the command line, in the format of
# `alx parse --decls` (the oracle the LSP acceptance group compares against):
# `== FILE`, then `kind<TAB>name<TAB>owner<TAB>line<TAB>offset`, lines from 1.

import "alx.dev/lsp/outline"
import "os"

for f in os.args[1...os.args.size] {
  puts "== #{f}"
  data = os.read_file(f)
  next unless data.ok?
  for s in outline.outline(Str.from_bytes(data.unwrap)) {
    puts "#{s.kind}\t#{s.name}\t#{s.owner}\t#{s.line + 1}\t#{s.lo}"
  }
}
