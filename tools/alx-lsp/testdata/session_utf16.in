# utf-16 client: columns are converted; garbage compiler output becomes a diagnostic plus a log line
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"rootUri":"file:///w","capabilities":{}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///w/u.alx","languageId":"alexandrite","version":4,"text":"x = é BROKEN\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///w/g.alx","languageId":"alexandrite","version":1,"text":"GARBAGE\n"}}}
{"jsonrpc":"2.0","id":2,"method":"shutdown"}
{"jsonrpc":"2.0","method":"exit"}
