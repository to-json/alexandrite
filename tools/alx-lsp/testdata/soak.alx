# Soak test: N didChange messages of a SIZE-byte document through a pipe into
# a built alx-lsp (fake compiler), asserting the server's peak RSS stays low.
#
#   soak run SERVER FAKE_RULES N SIZE MAX_MB [ALX [REQS [DOTS [EVERY]]]]
#       ALX: use the real exec client with this stand-in compiler
#       REQS: after the edits, REQS completion and REQS documentSymbol requests
#       DOTS: then DOTS completions after `b.` (each runs ALX --types)
#       EVERY: 1 sends a completion after `b.` right after each edit; with
#         a stand-in whose table never knows `b` (fakealx_unknown.sh), each
#         edit then runs the compiler (port-issues #273: every run of a
#         child process leaked 20-85 KB)
#   soak feed N SIZE [ALX [REQS [DOTS [EVERY]]]] (the client side: framed messages)
#
# The document is `x = 1` lines with a declaration (a def, or a struct with a
# method) every ~5 KB, so the symbol index has something in it.
#
# `run` starts this same binary in `feed` mode and pipes it into the server;
# os/exec reports each stage's peak RSS (ProcessState.max_rss).

import "alx.dev/lsp/jsonrpc"
import "bufio"
import "os"
import "os/exec"
import "strconv"
import "strings"

def num(s: Str) -> ~Int {
  strconv.atoi(s).unwrap
}

def feed(n: Int, size: Int, alx: Str, reqs: Int, dots: Int, every: Bool) -> ~Unit {
  w = bufio.new_writer(os.stdout)
  uri = "file:///w/soak.alx"
  ~jsonrpc.write_frame(w, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootUri\":\"file:///w\",\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-8\"]}},\"initializationOptions\":{\"alx\":{\"path\":#{jsonrpc.json_string(alx)}}}}}")
  parts: [Str] = ["b.\n"]
  k = 0
  while k * 5000 < size {
    n_lines = (k + 1) * 5000 > size ? (size - k * 5000) / 6 : 830
    parts << strings.repeat("x = 1\n", n_lines)
    parts << (k % 2 == 0 ? "def f#{k} -> Int { #{k} }\n" : "struct S#{k} {\n  def m -> Int { 1 }\n}\n")
    k += 1
  }
  body = parts.join("")
  ~jsonrpc.write_frame(w, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"languageId\":\"alexandrite\",\"version\":0,\"text\":#{jsonrpc.json_string(body)}}}}")
  for i in 1...(n + 1) {
    t = "# #{i}\n" + body + (i % 100 == 0 ? "BROKEN\n" : "")
    ~jsonrpc.write_frame(w, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\",\"version\":#{i}},\"contentChanges\":[{\"text\":#{jsonrpc.json_string(t)}}]}}")
    if every {
      ~jsonrpc.write_frame(w, "{\"jsonrpc\":\"2.0\",\"id\":#{1000000 + i},\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":1,\"character\":2}}}")
    }
  }
  for j in 0...reqs {
    ~jsonrpc.write_frame(w, "{\"jsonrpc\":\"2.0\",\"id\":#{10 + 2 * j},\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":#{j % 1000},\"character\":2}}}")
    ~jsonrpc.write_frame(w, "{\"jsonrpc\":\"2.0\",\"id\":#{11 + 2 * j},\"method\":\"textDocument/documentSymbol\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"}}}")
  }
  for j in 0...dots {
    ~jsonrpc.write_frame(w, "{\"jsonrpc\":\"2.0\",\"id\":#{10 + 2 * reqs + j},\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":\"#{uri}\"},\"position\":{\"line\":1,\"character\":2}}}")
  }
  ~jsonrpc.write_frame(w, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}")
  ~jsonrpc.write_frame(w, "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")
}

def soak -> ~Unit {
  mode = os.args[1]
  if mode == "feed" {
    ~feed(~num(os.args[2]), ~num(os.args[3]), os.args.size > 4 ? os.args[4] : "", os.args.size > 5 ? ~num(os.args[5]) : 0, os.args.size > 6 ? ~num(os.args[6]) : 0, os.args.size > 7 && os.args[7] == "1")
    return
  }
  server = os.args[2]
  os.setenv("ALX_LSP_FAKE", os.args[3]) unless os.args.size > 7
  n = ~num(os.args[4])
  size = ~num(os.args[5])
  max_mb = ~num(os.args[6])
  alx = os.args.size > 7 ? os.args[7] : "" # a stand-in compiler: the real exec client is used
  reqs = os.args.size > 8 ? os.args[8] : "0"
  dots = os.args.size > 9 ? os.args[9] : "0"
  every = os.args.size > 10 ? os.args[10] : "0"
  me = exec.command(os.args[0], ["feed", os.args[4], os.args[5], alx, reqs, dots, every])
  cap = me.pipe(exec.command(server, [])).~capture
  rss = cap.states[1].max_rss / 1048576
  puts "soak: #{n} changes of #{size} bytes#{every == "1" ? ", each followed by a member completion" : ""}, #{reqs} completion + #{reqs} documentSymbol + #{dots} member completion requests: server exit #{cap.states[1].exit_code}, peak RSS #{rss} MB (limit #{max_mb})"
  if rss > max_mb || cap.states[1].exit_code != 0 {
    puts "SOAK FAIL"
    os.exit(1)
  }
  puts "SOAK OK"
}

r = soak
if r.err != none {
  puts "soak failed: #{r.err.unwrap.message}"
  os.exit(2)
}
