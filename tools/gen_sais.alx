# Generates std/index/suffixarray/sais2.alx from sais.alx: Go's
# index/suffixarray/gen.go, for alx source.
#
#   - A def whose name ends in _32 is copied with "32" replaced by "64".
#   - A def whose name ends in _8_32 is also copied with the lines holding
#     "byte-only" or "256" removed and "_8_32" -> "_32", "Byte" -> "I32",
#     and that copy again with "32" -> "64".
#
# Every top-level def in sais.alx ends with a "}" line of its own.
#
# Run from the repository: alx run tools/gen_sais.alx

import "sh"
import "strings"

def fix32(s: Str) -> Str { strings.replace_all(s, "32", "64") }

def fix8_32(s: Str) -> Str { strings.replace_all(strings.replace_all(s, "_8_32", "_32"), "Byte", "I32") }

def strip_byte_only(s: Str) -> Str {
  out = ""
  for line in strings.split_after(s, "\n") {
    if !strings.contains(line, "256") && !strings.contains(line, "byte-only") {
      out += line
    }
  }
  out
}

here = "std/index/suffixarray"
sh.abort("run from the repository root") if !sh.exists?("#{here}/sais.alx")
data = sh.~read("#{here}/sais.alx")

buf = "# GENERATED by tools/gen_sais.alx from std/index/suffixarray/sais.alx; do not edit.\n"
buf += "# The _8_64, _32 and _64 variants of the SAIS functions (Go's sais2.go).\n"
loop {
  x = strings.index(data, "\ndef ")
  break if x < 0
  data = data[x...data.size]
  p = strings.index(data, "(")
  p = data.size if p < 0
  name = data["\ndef ".size...p]

  x = strings.index(data, "\n}\n")
  sh.abort("cannot find end of def #{name}") if x < 0
  body = data[0...x + "\n}\n".size]
  data = data[x + "\n}".size...data.size]

  if strings.has_suffix(name, "_32") {
    buf += fix32(body)
  }
  if strings.has_suffix(name, "_8_32") {
    # x_8_32 -> x_8_64 done above
    body = fix8_32(strip_byte_only(body))
    buf += body
    buf += fix32(body)
  }
}
sh.~write("#{here}/sais2.alx", buf)
