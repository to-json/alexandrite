# Instantiates sort.tmpl (the sorting kernels) as alexandrite source.
#
#   slices/sort_kernels.alx   ordered (`<`) and cmp-function (`_func`) variants
#   sort/sort_kernels.alx     less-function (`_less`) variant, for sort.slice
#
# Run from the repository: alx run tools/gen_sort.alx

import "path"
import "sh"
import "strings"

struct Variant {
  s: Str    # name suffix
  p: Str    # extra parameter
  a: Str    # extra argument
  kind: Int # how LT(a, b) reads: 0 `<`, 1 cmp, 2 less
}

def lt(v: Variant, a: Str, b: Str) -> Str {
  case v.kind {
    0 => "(#{a} < #{b})"
    1 => "(cmp(#{a}, #{b}) < 0)"
    _ => "less(#{a}, #{b})"
  }
}

def variant(name: Str) -> Variant {
  case name {
    "ord" => Variant.new(s: "", p: "", a: "", kind: 0)
    "func" => Variant.new(s: "_func", p: ", cmp: (T, T) -> Int", a: ", cmp", kind: 1)
    _ => Variant.new(s: "_less", p: ", less: (T, T) -> Bool", a: ", less", kind: 2)
  }
}

# Every LT(a, b) expanded (arguments may hold [...] indexing, no commas).
def expand_lt(s: Str, v: Variant) -> Str {
  out = ""
  i = 0
  loop {
    j = strings.index(s[i...s.size], "LT(")
    if j < 0 {
      out += s[i...s.size]
      break
    }
    j += i
    out += s[i...j]
    k = j + 3
    depth = 0
    comma = -1
    while k < s.size {
      c = s[k]
      if c == 40 || c == 91 {
        depth += 1
      } else if c == 93 || (c == 41 && depth > 0) {
        depth -= 1
      } else if c == 41 {
        break
      } else if c == 44 && depth == 0 {
        comma = k
      }
      k += 1
    }
    out += lt(v, strings.trim_space(s[j + 3...comma]), strings.trim_space(s[comma + 1...k]))
    i = k + 1
  }
  out
}

def inst(tmpl: Str, v: Variant) -> Str {
  # drop the template's own header comment
  s = tmpl[strings.index(tmpl, "\n\n") + 2...tmpl.size]
  s = expand_lt(s, v)
  s = strings.replace_all(s, "{S}", v.s)
  s = strings.replace_all(s, "{P}", v.p)
  s = strings.replace_all(s, "{A}", v.a)
  s
}

def emit(here: Str, tmpl: Str, file: Str, names: [Str], note: Str) -> ~Unit {
  body = ""
  for n in names { body += inst(tmpl, variant(n)) + "\n" }
  hdr = "# GENERATED by tools/gen_sort.alx from std/slices/sort.tmpl; do not edit.\n# #{note}\n\n"
  sh.~write(path.join([here, "..", file]), hdr + strings.trim_right(body, "\n") + "\n")
}

here = "std/slices"
sh.abort("run from the repository root") if !sh.exists?("#{here}/sort.tmpl")
tmpl = sh.~read("#{here}/sort.tmpl")
~emit(here, tmpl, "slices/sort_kernels.alx", ["ord", "func"], "Sorting kernels: ordered and cmp-function variants.")
~emit(here, tmpl, "sort/sort_kernels.alx", ["less"], "Sorting kernels: less-function variant.")
