# Writes STDLIB.md: every Go std package and where alx stands on it.
#
#   alx run tools/stdlib_status.alx      (from the repository root; needs `go`)
#
# A package is "ported" when std/<path> has alx sources and tests, "no tests"
# when it has sources only, "excluded" when it's on the list below (each with
# its alx answer), else "to do".
import "sh"
import "strings"

def excluded_reason(p: Str) -> Str? {
  return "no runtime type information: compile-time derives instead (S3, #[derive(Json)])" if p == "reflect"
  return "no unchecked memory access; the C FFI (`extern def`, `Ptr`) covers interop" if p == "unsafe"
  return "no garbage collector: regions free memory deterministically (R1-R3)" if p == "weak" || p == "unique" || p == "runtime/debug" || p == "runtime/metrics"
  return "struct layout markers have no meaning without reflection" if p == "structs"
  return "Go's runtime and toolchain internals" if strings.has_prefix(p, "runtime")
  return "dynamic loading of Go plugins; alx links statically" if p == "plugin"
  return "raw system calls: `extern def` over libc (as std/os does)" if p == "syscall"
  return "Go's own toolchain (parser, type checker, formatter): alx has its own" if strings.has_prefix(p, "go/")
  return "Go binary formats and debug info" if strings.has_prefix(p, "debug/")
  return "range-over-func iterators: alx has generators (`Enumerator.new`) and Enumerable" if p == "iter"
  return "testing helpers for Go's testing package internals" if p == "testing/synctest" || p == "testing/slogtest" || p == "testing/cryptotest" || p == "crypto/mlkem/mlkemtest"
  none
}

pkgs = `go list std`.~output.lines.select { !strings.contains(it, "internal") && !strings.contains(it, "vendor") && !strings.has_prefix(it, "cmd") }.to_a
rows: [Str] = []
counts = [0, 0, 0, 0]
for p in pkgs {
  dir = "std/#{p}"
  srcs = sh.dir?(dir) ? sh.~glob("#{dir}/*.alx") : []
  tests = srcs.select { strings.has_suffix(it, "_test.alx") }.to_a
  status = ""
  note = ""
  if why = excluded_reason(p) {
    status = "excluded"
    note = why
    counts[2] += 1
  } else if srcs.size > tests.size && tests.size > 0 {
    status = "ported"
    note = "#{srcs.size - tests.size} source, #{tests.size} test files"
    counts[0] += 1
  } else if srcs.size > 0 {
    status = "no tests"
    counts[1] += 1
  } else {
    status = "to do"
    counts[3] += 1
  }
  rows << "| `#{p}` | #{status} | #{note} |"
}
out = "# Go standard library in alx\n\nGenerated by `alx run tools/stdlib_status.alx`; the porting rules are in docs/notes/porting-std.md.\n\n"
out += "**#{counts[0]} ported, #{counts[1]} without tests, #{counts[2]} excluded, #{counts[3]} to do** (of #{pkgs.size}).\n\n"
out += "| package | status | notes |\n|---|---|---|\n" + rows.join("\n") + "\n"
sh.~write("STDLIB.md", out)
puts "STDLIB.md: #{counts[0]} ported, #{counts[1]} without tests, #{counts[2]} excluded, #{counts[3]} to do"
