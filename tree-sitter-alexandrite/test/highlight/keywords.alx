import "strings"
# <- keyword.import

pub def f(t: T, n: Int = 0) -> ~Int {
  # <- keyword.modifier
  #   ^ keyword.function
  #                  ^ type.builtin
  #            ^ type
  defer { t.close }
  # ^ keyword
  #           ^ variable.member
  x = t.fail
  #       ^ variable.member
  v = find(n) || fail Bad.new(pos: 1)
  #                ^ keyword.return
  #                             ^ variable.parameter
  w = spawn { work() }
  #     ^ keyword.coroutine
  y = opt || return
  #            ^ keyword.return
  next if T is like Int
  # ^ keyword.repeat
  #      ^ keyword.conditional
  #           ^ keyword.operator
  #              ^ keyword.operator
  select(a, b, 1)
  # ^ function.call
  loop { break }
  # ^ keyword.repeat
  #        ^ keyword.repeat
  case e { Bad(p) => p }
  # ^ keyword.conditional
  #          ^ constant
  t.log(n)
  #   ^ function.method.call
  puts n
  # ^ function.builtin
  n
}
