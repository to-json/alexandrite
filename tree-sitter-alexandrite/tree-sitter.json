{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "alexandrite",
      "camelcase": "Alexandrite",
      "scope": "source.alx",
      "path": ".",
      "file-types": [
        "alx"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0 WITH LLVM-exception",
    "description": "Tree-sitter grammar for the Alexandrite programming language",
    "authors": [
      {
        "name": "Alexandrite Authors"
      }
    ],
    "links": {
      "repository": "https://github.com/alexandrite-lang/tree-sitter-alexandrite"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  }
}
