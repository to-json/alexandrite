# What `os` and the OS's randomness do in the browser (web/src/os.rs).
import crand "crypto/rand"
import "hash/maphash"
import "math/rand/v2"
import "os"

puts os.args
puts os.getenv("HOME") || "(unset)"
os.~setenv("GREETING", "hi")
puts os.getenv("GREETING") || "(unset)"
puts os.environ
os.~unsetenv("GREETING")
puts os.environ.size
puts os.hostname.unwrap
puts os.getpid
puts os.stdout.is_terminal

# stdout and stderr are the run's output.
out = os.stdout
out.~write_string!("through os.stdout\n")
err = os.stderr
err.~write_string!("through os.stderr\n")
inp = os.stdin
buf: [Byte] = [0; 8]
puts inp.read!(buf).unwrap

# No file system: every file operation fails with ENOSYS.
puts os.open("x.txt").err.unwrap.message
puts os.read_file("x.txt").err.unwrap.message
puts os.mkdir("d", 0o755).err.unwrap.message
puts os.stat("x.txt").err.unwrap.message
puts os.read_dir(".").err.unwrap.message
puts os.getwd.err.unwrap.message
puts os.is_not_exist(os.open("x.txt").err.unwrap)

# Randomness from crypto.getRandomValues.
b: [Byte] = [0; 300]
puts crand.read(b) == 300 && b.any? { it != 0 }
x = rand.int_n(1000)
puts x >= 0 && x < 1000
s1 = maphash.make_seed
s2 = maphash.make_seed
puts maphash.string(s1, "a") != maphash.string(s2, "a")

defer { puts "deferred calls don't run" }
os.exit(0)
puts "not reached"
